// `axiom test --overflow=trap`: tests run in the build's overflow mode, so
// overflow traps (T0002) there; it wraps by default (issue 0047).
// test-result: overflow traps | pass
// test-result: unexpected overflow | fail | T0002 | 17
// test-result: wrapping operators | pass
// flags: --overflow=trap

test "overflow traps" expect trap(T0002) {
    let mut x: u8 = 255;
    x += 1;
}

test "unexpected overflow" {
    let mut y: i32 = @max_value(i32);
    y -= 1;
    @expect(y == 2147483646);
    y = y * 2;
}

test "wrapping operators" {
    let mut x: u8 = 255;
    x +%= 1;
    @expect(x == 0);
}
