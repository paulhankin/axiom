// Self-test of `axiom test --sanitize=address`: a passing test that does not
// free what it allocated fails with "leak"; memory kept on purpose
// (mem.leaks_ignored) and tests that fail for another reason are not
// reported as leaks.
// test-result: frees everything | pass
// test-result: leaks | fail | leak
// test-result: keeps on purpose | pass
// test-result: traps while holding memory | pass
// test-result: error while holding memory | fail | error
// flags: --sanitize=address
import "std/mem" as mem;

error { Bad }

test "frees everything" {
    let xs = mem.alloc.[u64](10)!;
    xs[9] = 1;
    mem.free(xs);
}

test "leaks" {
    let xs = mem.alloc.[u64](10)!;
    xs[9] = 1;
}

test "keeps on purpose" {
    mem.leaks_ignored(true);
    let xs = mem.alloc.[u64](10)!;
    mem.leaks_ignored(false);
    xs[9] = 1;
}

test "traps while holding memory" expect trap(T0001) {
    let xs = mem.alloc.[u64](10)!;
    let i: usize = 10;
    xs[i] = 1;
}

fn fails() !void {
    return error.Bad;
}

test "error while holding memory" {
    let xs = mem.alloc.[u64](10)!;
    xs[0] = 1;
    fails()!;
}
