// tests/lib/io.ax - output helpers for the test suite (host functions are
// provided by tests/run.mjs for wasm and tests/native_rt.c for native).

import host "env" {
    fn print_i64(x: i64) void;
    fn print_u64(x: u64) void;
    fn print_f64(x: f64) void;
    fn print_str(p: *u8, n: usize) void;
    fn print_bool(b: bool) void;
}

pub fn int(x: i64) void {
    print_i64(x);
}

pub fn uint(x: u64) void {
    print_u64(x);
}

pub fn float(x: f64) void {
    print_f64(x);
}

pub fn str(s: []u8) void {
    print_str(s.ptr, s.len);
}

pub fn boolean(b: bool) void {
    print_bool(b);
}
