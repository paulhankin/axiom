// A loop of table loads under a condition (a Zobrist hash)
// stays scalar loads on the processors whose gathers run in microcode
// (Skylake-SP to Tiger Lake: issue 0091), where LLVM 18 would make it
// masked vpgatherdq / vpgatherqq.
//
// lower: --target=native --cpu=icelake-server -O2 | \bvp?gather\w+ | 0

let TABLE: [800]u64 = [0x9E3779B97F4A7C15; 800];

export fn hash(raw: *[2][25]u8) u64 {
    let mut h: u64 = 0;
    for side in @as(usize, 0)..2 {
        for pt in @as(usize, 0)..25 {
            let c = @as(usize, raw[side][pt]);
            if (c > 0) and (c <= 15) {
                h ^= TABLE[(side * 25 + pt) * 16 + c];
            }
        }
    }
    return h;
}
