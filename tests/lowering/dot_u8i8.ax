// @dot of u8 by i8 lanes is one vpdpbusd per register where the CPU has VNNI (AVX-512 VNNI:
// zmm; AVX-VNNI: ymm), and widened multiplies elsewhere: no vpdpbusd without it.
//
// lower: --target=native --cpu=icelake-server -O2 | \bvpdpbusd\b[^\n]*zmm | 4
// lower: --target=native --cpu=alderlake -O2 | \bvpdpbusd\b[^\n]*ymm | 8
// lower: --target=native --cpu=x86-64-v3 -O2 | \bvpdpbusd\b | 0

export fn sums(p: *u8, w: *i8, q: *mut i32) void {
    let a = @slice_from_ptr(p, 256);
    let b = @slice_from_ptr(w, 256);
    let out = @slice_from_ptr(q, 64);
    for k in @as(usize, 0)..4 {
        @store(out[(k * 16)..((k + 1) * 16)], @dot(@load(u8x64, a[(k * 64)..((k + 1) * 64)]), @load(i8x64, b[(k * 64)..((k + 1) * 64)])));
    }
}
