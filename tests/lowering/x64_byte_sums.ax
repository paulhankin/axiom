// Sums of neighbouring bytes as psadbw (slp.ax): the benchmark's checker counts,
// two interleaved sums of 24 bytes each, wrapping at 8 bits, and a sum of 25
// bytes into 32 bits. Sixteen bytes and then the rest (in a masked load with
// AVX-512, else 8 bytes in a plain load and the 25th byte added alone).
//
// lower-selfhost: --target=native --cpu=x86-64-v4 -O2 | \bvpsadbw\b | 6
// lower-selfhost: --target=native --cpu=x86-64 -O2 | \bpsadbw\b | 6

struct Board {
    raw: [2][25]u8,
}

export fn counts(b: *Board, out: *mut [2]u8) void {
    let raw = &b.raw;
    let mut t0: u8 = 0;
    let mut t1: u8 = 0;
    for i in @as(usize, 0)..24 {
        t0 += raw[0][i];
        t1 += raw[1][i];
    }
    out[0] = t0;
    out[1] = t1;
}

export fn sum25(b: *Board) u32 {
    let mut s: u32 = 0;
    for i in @as(usize, 0)..25 {
        s +%= @as(u32, b.raw[0][i]);
    }
    return s;
}
