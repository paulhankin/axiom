// Stores of neighbouring elements whose values are the same operation lane
// by lane are one vector store (issue 0096): the benchmark's race inputs, a
// broadcast of the count, one compare into a mask register (the lanes'
// predicates differ: an unsigned compare of each lane's interval) and a
// zero-masked move per vector; no scalar float store, no branch.
//
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvpcmp\w*\s | 4

fn sel(c: bool, a: f32) f32 {
    let mut r: f32 = 0.0;
    if c {
        r = a;
    }
    return r;
}

export fn point(nc: u8, out: *mut [4]f32) void {
    out[0] = sel(nc == 1, 1.0);
    out[1] = sel(nc == 2, 1.0);
    out[2] = sel(nc >= 3, 1.0);
    out[3] = sel(nc > 3, @float_from_int(f32, nc - 3) / 2.0);
}

export fn flags(men_off: u8, out: *mut [100]f32) void {
    for k in @as(usize, 0)..14 {
        out[k] = sel(@as(usize, men_off) == (k + 1), 1.0);
    }
}
