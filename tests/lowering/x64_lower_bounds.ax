// Blocks read from a slice after a test of its length (the benchmark's dim128
// thresholds, `@expect(ht.len >= 128)` then `@load(f32x16, ht[16 * k..])`):
// the length is at least 128, so each slice's start (k <= len) and the
// load's 16 elements (len - k >= 16) are known to fit, and only the one
// test of the length stays (issue 0096; the lower bounds of a value and of
// it less a constant).
//
// lower: --target=native --cpu=x86-64-v4 -O2 | \bcmp[lq]?\s+\$(0x80|0x7f|128|127),\s*%rsi | 1
// lower: --target=native --cpu=x86-64-v4 -O2 | \$(0x80|0x7f|128|127),\s*%rsi\n[^\n]*\bjbe?\b[^\n]*\n(?:(?![^\n]*\b(cmp|test|j[a-z]+)\s)[^\n]*\n){16}[^\n]*\b(vzeroupper|ret)\b | 1

export fn thresholds(p: *f32, n: usize, out: *mut [8]f32x16) void {
    let ht = @slice_from_ptr(p, n);
    @expect(ht.len >= 128);
    out[0] = @load(f32x16, ht[0..]);
    out[1] = @load(f32x16, ht[16..]);
    out[2] = @load(f32x16, ht[32..]);
    out[3] = @load(f32x16, ht[48..]);
    out[4] = @load(f32x16, ht[64..]);
    out[5] = @load(f32x16, ht[80..]);
    out[6] = @load(f32x16, ht[96..]);
    out[7] = @load(f32x16, ht[112..]);
}
