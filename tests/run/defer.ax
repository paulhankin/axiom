// defer ordering: reverse, per block, on return / break / error.
import "../lib/io.ax" as io;

error { Fail }

fn a() void {
    defer io.str("a1");
    defer io.str("a2");
    {
        defer io.str("inner");
        io.str("body");
    }
    io.str("end");
}

fn b(fail: bool) !u32 {
    defer io.str("b-cleanup");
    if fail {
        return error.Fail;
    }
    return 5;
}

fn c() void {
    for i in @as(u32, 0)..3 {
        defer io.int(@as(i64, i));
        if i == 1 {
            continue;
        }
        if i == 2 {
            break;
        }
        io.str("iter");
    }
}

fn d() u32 {
    let mut x: u32 = 1;
    defer x = 100;
    return x;
}

fn e2() !u32 {
    defer io.str("e2-defer");
    let v = b(true)!;
    return v;
}

// a deferred loop also emitted after a loop that never ends: dead code, which
// must go without taking the loop's bound with it
fn f(n: u32) u32 {
    let mut k: u32 = 0;
    defer {
        for i in @as(u32, 0)..k {
            io.int(@as(i64, i));
        }
    }
    loop {
        k += 1;
        if k >= n {
            return k;
        }
    }
}

export fn run() void {
    a();
    // expect: body
    // expect: inner
    // expect: end
    // expect: a2
    // expect: a1
    _ = b(false) catch 0;
    // expect: b-cleanup
    c();
    // expect: iter
    // expect: 0
    // expect: 1
    // expect: 2
    io.int(@as(i64, d()));  // expect: 1
    _ = e2() catch 0;
    // expect: b-cleanup
    // expect: e2-defer
    io.int(@as(i64, f(2)));
    // expect: 0
    // expect: 1
    // expect: 2
}
