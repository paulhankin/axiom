// `let mut x: T = undefined;` (spec §8.1): the variable's bytes are unspecified until
// written, as memory from the allocator; what is written is read back.
import "../lib/io.ax" as io;

struct Pair {
    a: u32,
    b: u64,
}

// (a big array: its bytes left as they are, not zeroed)
fn sum_squares(n: usize) u64 {
    let mut buf: [512]u64 = undefined;
    for i in 0..n {
        buf[i] = @as(u64, i) * @as(u64, i);
    }
    let mut s: u64 = 0;
    for i in 0..n {
        s += buf[i];
    }
    return s;
}

// (only the entries written are read: a list filled from the front)
fn evens(xs: []u32, out: *mut [64]u32) usize {
    let mut n: usize = 0;
    for x in xs {
        if (x % 2) == 0 {
            out[n] = x;
            n += 1;
        }
    }
    return n;
}

export fn run() void {
    io.uint(sum_squares(10));   // expect: 285
    io.uint(sum_squares(500));  // expect: 41541750
    let mut small: u32 = undefined;
    small = 7;
    io.uint(@as(u64, small));  // expect: 7
    let mut p: Pair = undefined;
    p.a = 3;
    p.b = 40;
    io.uint(@as(u64, p.a) + p.b);  // expect: 43
    let mut list: [64]u32 = undefined;
    let xs: [6]u32 = [1, 2, 3, 4, 5, 6];
    let n = evens(xs[..], &mut list);
    io.uint(@as(u64, n));  // expect: 3
    io.uint(@as(u64, list[0] + list[1] + list[2]));  // expect: 12
}
