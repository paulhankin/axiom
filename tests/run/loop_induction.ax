// Bounds of loop counters proved by induction (issue 0105): a counter
// counting up from 1 is at least 1, so i - 1 is below a length i is below;
// one counting down from below a length stays below it, and one that leaves
// the loop at 1 is at least 2 where it has not. Insertion sort's checks go;
// the results are the same.
import "../lib/io.ax" as io;

struct Pair {
    idx: u32,
    score: f32,
}

fn key(x: f32) i32 {
    let b = @bit_cast(i32, x);
    return b ^ @bit_cast(i32, @bit_cast(u32, b >> 31) >> 1);
}

fn sort_pairs(v: []mut Pair) void {
    let len = v.len;
    let mut i: usize = 1;
    while i < len {
        if key(v[i - 1].score) < key(v[i].score) {
            let tmp = v[i];
            let mut j = i;
            loop {
                v[j] = v[j - 1];
                j -= 1;
                if j == 0 {
                    break;
                }
                if not (key(v[j - 1].score) < key(tmp.score)) {
                    break;
                }
            }
            v[j] = tmp;
        }
        i += 1;
    }
}

// j counts down from i (1 <= i < len) and leaves at 1: j - 1 and j - 2 are
// in range where they are read
fn down_sum(s: []u32, i: usize) u64 {
    let mut t: u64 = 0;
    let mut j = i;
    loop {
        t += @as(u64, s[j]) + @as(u64, s[j - 1]);
        if j == 1 {
            break;
        }
        t += @as(u64, s[j - 2]) * 3;
        j -= 1;
    }
    return t;
}

fn pair_sums(s: []u32) u64 {
    let mut t: u64 = 0;
    for i in @as(usize, 1)..s.len {
        t = (t * 7) + (@as(u64, s[i - 1]) ^ @as(u64, s[i]));
        t += down_sum(s, i);
    }
    return t;
}

export fn run() void {
    let mut v: [40]Pair = [Pair.{ idx: 0, score: 0.0 }; 40];
    let mut r: u32 = 17;
    for k in @as(usize, 0)..40 {
        r = (r *% 1103515245) +% 12345;
        let x = @float_from_int(f32, (r >> 16) & 255) - 128.0;
        v[k] = Pair.{ idx: @truncate(u32, k), score: x * 0.25 };
    }
    v[7].score = -0.0;
    v[9].score = 0.0;
    sort_pairs(v[..]);
    let mut h: u64 = 0;
    for k in @as(usize, 0)..40 {
        h = (h * 31) + @as(u64, v[k].idx);
    }
    io.uint(h);  // expect: 13032873243119454534
    let mut ok: u64 = 1;
    for k in @as(usize, 1)..40 {
        if key(v[k - 1].score) < key(v[k].score) {
            ok = 0;
        }
    }
    io.uint(ok);  // expect: 1
    let mut s: [12]u32 = [0; 12];
    for k in @as(usize, 0)..12 {
        s[k] = @truncate(u32, (k * 37) + 5);
    }
    io.uint(pair_sums(s[..]));  // expect: 42547205861
}
