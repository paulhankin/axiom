// Code generation of issue 0105, checked against LLVM's results: a test of
// a bit reversal against zero (the bits that survive the shift tested
// instead), x ^ (1 << k) and x | (1 << k) (btc, bts on x86-64), 31 - y as
// 31 ^ y where y <= 31, and a switch on a value each predecessor knows
// (threaded); and x | (1 << k) where x is a 1 << j as well, computed for
// another use (the bit must be the one computed only for the or).
import "../lib/io.ax" as io;

inline fn reverse24(mask: u32) u32 {
    let mut x = mask;
    x = ((x >> 1) & 0x55555555) | ((x & 0x55555555) << 1);
    x = ((x >> 2) & 0x33333333) | ((x & 0x33333333) << 2);
    x = ((x >> 4) & 0x0F0F0F0F) | ((x & 0x0F0F0F0F) << 4);
    x = ((x >> 8) & 0x00FF00FF) | ((x & 0x00FF00FF) << 8);
    x = (x >> 16) | (x << 16);
    return x >> 8;
}

fn rev_test(m: u32) u64 {
    let r = reverse24(m);
    if r != 0 {
        return @as(u64, r);
    }
    return 7;
}

// the set bits from the top, toggled off one at a time (btc), and their
// indices or-ed into another mask (bts)
fn walk(m0: u32) u64 {
    let mut m = m0;
    let mut seen: u32 = 0;
    let mut s: u64 = 0;
    while m != 0 {
        let i = 31 - @clz(m);
        m ^= @as(u32, 1) << @truncate(u32, i);
        seen |= @as(u32, 1) << @truncate(u32, i & 15);
        s = (s * 33) + @as(u64, i);
    }
    return s + @as(u64, seen);
}

fn walk64(m0: u64) u64 {
    let mut m = m0;
    let mut s: u64 = 0;
    while m != 0 {
        let i = 63 - @clz(m);
        m ^= @as(u64, 1) << @truncate(u32, i);
        s = (s * 7) + i;
    }
    return s;
}

// x | (1 << k) as bts with both operands shifts of 1, the first used again:
// the second (computed only for the or) must be the bit, not the register
fn two_bits(m: u64, k: u32, j: u32) u64 {
    let a = @as(u64, 1) << k;
    let rest = m & ~a;
    let b = @as(u64, 1) << j;
    return (a | b) ^ (rest << 1);
}

enum Bucket {
    FIRST,
    SECOND,
    REST,
}

fn class_of(k: u32) Bucket {
    if k == 10 {
        return Bucket.FIRST;
    }
    if k == 9 {
        return Bucket.SECOND;
    }
    return Bucket.REST;
}

fn pick(k: u32, a: u64, b: u64, c: u64) u64 {
    let mut r: u64 = 0;
    match class_of(k) {
        .FIRST  => { r = a; }
        .SECOND => { r = b; }
        .REST   => { r = c; }
    }
    return r;
}

export fn run() void {
    io.uint(rev_test(0));                 // expect: 7
    io.uint(rev_test(1));                 // expect: 8388608
    io.uint(rev_test(0x1000000));         // expect: 7
    io.uint(rev_test(0x800005));          // expect: 10485761
    io.uint(walk(0));                     // expect: 0
    io.uint(walk(0x80010025));            // expect: 37376859
    io.uint(walk(0xFFFFFFFF));            // expect: 5881567056547723247
    io.uint(walk64(0x8000000100000001));  // expect: 3311
    let mut t: u64 = 0;
    for k in @as(u32, 0)..12 {
        t = (t * 3) + pick(k, 1, 2, 5);
    }
    io.uint(t);                        // expect: 1328561
    io.uint(two_bits(0xF0, 4, 9));     // expect: 976
    io.uint(two_bits(0xFFFF, 0, 63));  // expect: 9223372036854906877
    let mut u: u64 = 0;
    for k in @as(u32, 0)..64 {
        for j in @as(u32, 0)..64 {
            u = (u *% 31) +% two_bits(0xF0F0F0F0F0F0F0F0 ^ @as(u64, k * j), k, j);
        }
    }
    io.uint(u);  // expect: 8071709270261614711
}
