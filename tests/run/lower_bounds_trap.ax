// A lower bound of a length decides only the blocks it covers: after
// `s.len >= 100`, a 16-float block at 96 is still checked, and traps.
// expect-trap
// expect: 1
import "../lib/io.ax" as io;

fn last_block(s: []f32) f32 {
    @expect(s.len >= 100);
    let a = @load(f32x16, s[80..]);
    io.uint(1);
    let b = @load(f32x16, s[96..]);
    return @extract_lane(a, 0) + @extract_lane(b, 15);
}

let mut N: usize = 100;

export fn run() void {
    let xs: [112]f32 = [1.0; 112];
    io.uint(@as(u64, @int_from_float(u32, last_block(xs[0..@atomic_load(&N)]))));
}
