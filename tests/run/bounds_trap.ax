// Slice indexing is bounds-checked.
// expect-trap
// expect: 3
import "../lib/io.ax" as io;

export fn run() void {
    let arr: [3]u32 = [1, 2, 3];
    let s = arr[..];
    let mut i: usize = 0;
    while i <= s.len {
        if i == s.len {
            io.uint(@as(u64, s.len));
        }
        let v = s[i];
        i += 1;
        _ = v;
    }
}
