// @dot of i8 lanes (four neighbouring products summed into each i32 lane; on
// AArch64 sdot, fused into the add it feeds) against the scalar sums, at the
// extreme values, for 128- and 512-bit vectors, alone and accumulated.
import "../lib/io.ax" as io;

let mut xs: [64]i8 = [0; 64];
let mut ys: [64]i8 = [0; 64];
let mut acc: [16]i32 = [0; 16];

fn fill() void {
    let edges: [8]i8 = [-128, 127, -1, 0, 1, -127, 64, -64];
    for i in @as(usize, 0)..64 {
        xs[i] = edges[i % 8];
        ys[i] = edges[((i / 8) + (i * 3)) % 8];
    }
    for i in @as(usize, 0)..16 {
        acc[i] = @truncate(i32, @bit_cast(i64, @as(u64, i)) *% 0x0123_4567);
    }
}

fn want(i: usize) i32 {
    let mut s: i32 = 0;
    for j in @as(usize, 0)..4 {
        s += @as(i32, xs[(4 * i) + j]) * @as(i32, ys[(4 * i) + j]);
    }
    return s;
}

fn check() u64 {
    fill();
    let mut bad: i32 = 0;
    let x = @load(i8x16, xs[0..16]);
    let y = @load(i8x16, ys[0..16]);
    let a = @load(i32x4, acc[0..4]);
    let mut r: [3]i32x4 = [@splat(0); 3];
    r[0] = @dot(x, y);
    r[1] = a + @dot(x, y);
    r[2] = @dot(x, y) + (a + @dot(y, x));
    let mut got: [12]i32 = [0; 12];
    for k in @as(usize, 0)..3 {
        @store(got[(k * 4)..], r[k]);
    }
    for i in @as(usize, 0)..4 {
        bad += @as(i32, got[i] != want(i));
        bad += @as(i32, got[4 + i] != (acc[i] + want(i)));
        bad += @as(i32, got[8 + i] != ((acc[i] + want(i)) + want(i)));
    }
    let x4 = @load(i8x64, xs[0..64]);
    let y4 = @load(i8x64, ys[0..64]);
    let a4 = @load(i32x16, acc[0..16]);
    let mut g4: [16]i32 = [0; 16];
    @store(g4[0..16], a4 + @dot(x4, y4));
    for i in @as(usize, 0)..16 {
        bad += @as(i32, g4[i] != (acc[i] + want(i)));
    }
    return @as(u64, @bit_cast(u32, bad));
}

export fn run() void {
    io.uint(check());  // expect: 0
}
