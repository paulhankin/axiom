// Calls of a function itself in tail position become a loop
// (cmd/axiom/src/tailrec.ax): plain ones, ones combined with another value
// by +, *, &, | or ^ (an accumulator), ones that keep their calls (a stack
// slot, a float, a non-associative operation), and deep ones that would
// overflow the stack as calls.
// flags: -O2
import "../lib/io.ax" as io;

fn gcd(a: u64, b: u64) u64 {
    if b == 0 {
        return a;
    }
    return gcd(b, a % b);
}

// the benchmark's endgame-table index: an accumulated sum
fn position_f(f_bits: u64, n: u32, r: u32) u32 {
    if n == r {
        return 0;
    }
    if (f_bits & (@as(u64, 1) << (n - 1))) != 0 {
        return (n *% 7 +% r) +% position_f(f_bits, n - 1, r - 1);
    }
    return position_f(f_bits, n - 1, r);
}

fn fact(n: u64) u64 {
    if n <= 1 {
        return 1;
    }
    return n *% fact(n - 1);
}

fn sum_to(n: u64) u64 {
    if n == 0 {
        return 0;
    }
    return sum_to(n - 1) +% n;  // (the call on the left)
}

fn xor_down(n: u32, salt: u32) u32 {
    if n == 0 {
        return salt;  // (a return that is not 0 combines with the accumulator)
    }
    if (n & 3) == 0 {
        return xor_down(n - 1, salt +% 1);
    }
    return (n *% 2654435761) ^ xor_down(n - 1, salt);
}

fn and_bits(n: u32, x: u64) u64 {
    if n == 0 {
        return ~@as(u64, 0);
    }
    return (x | (@as(u64, 1) << (n & 63))) & and_bits(n - 1, x >> 1);
}

fn or_bits(n: u32) u64 {
    if n == 0 {
        return 0;
    }
    return (@as(u64, 1) << (@as(u64, n) % 64)) | or_bits(n - 3 * @as(u32, @int_cast(u32, @min(n, 1))));
}

let mut COUNT: u64 = 0;

fn count_down(n: u64) void {
    if n == 0 {
        return;
    }
    COUNT +%= n;
    count_down(n - 1);
}

// subtraction does not reassociate: stays a call
fn alt(n: i64) i64 {
    if n == 0 {
        return 0;
    }
    return n - alt(n - 1);
}

// floats do not either
fn fsum(n: u32, x: f64) f64 {
    if n == 0 {
        return 0.5;
    }
    return x + fsum(n - 1, x * 0.5);
}

// a stack slot whose address goes down
fn slots(n: u32, p: *[4]u32) u32 {
    let mut a: [4]u32 = p.*;
    a[@int_cast(usize, n & 3)] +%= n;
    if n == 0 {
        return a[0] +% a[1] +% a[2] +% a[3];
    }
    return slots(n - 1, &a);
}

export fn run() void {
    io.uint(gcd(1071, 462));       // expect: 21
    io.uint(gcd(12345678910, 0));  // expect: 12345678910
    io.uint(@as(u64, position_f(0b1011_0110_1101, 12, 4)));  // expect: 368
    io.uint(@as(u64, position_f(0, 9, 9)));                  // expect: 0
    io.uint(fact(20));                        // expect: 2432902008176640000
    io.uint(fact(25));                        // expect: 7034535277573963776
    io.uint(sum_to(2_000));                   // expect: 2001000
    io.uint(@as(u64, xor_down(1000, 7)));     // expect: 266632133
    io.uint(and_bits(40, 0xFFFF_0000_FFFF));  // expect: 0
    io.uint(and_bits(5, ~@as(u64, 0)));       // expect: 1152921504606846975
    io.uint(or_bits(30));                     // expect: 1227133512
    count_down(2_000);
    io.uint(COUNT);   // expect: 2001000
    io.int(alt(10));  // expect: 5
    io.int(@as(i64, @int_from_float(i64, fsum(10, 3.0) * 1000.0)));  // expect: 6494
    let init: [4]u32 = [1, 2, 3, 4];
    io.uint(@as(u64, slots(9, &init)));  // expect: 55
}
