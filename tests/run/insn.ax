// The processor-instruction builtins (spec §13.5) against values from a
// model of AES, carry-less multiplication and CRC (written by
// tests/internal/tools/gen_insn_tests.py). Each architecture checks its own in a function
// compiled for the extensions, run where the processor has them.
import "../lib/io.ax" as io;

fn same(a: u8x16, b: u8x16) bool {
    return @all_true(@lanes_eq(a, b));
}

fn same64(a: u64x2, b: u64x2) bool {
    return @all_true(@lanes_eq(a, b));
}

fn x86(s: u8x16, k: u8x16) bool @features("aes,pclmul,sse4.2") {
    if @target_arch("x86_64") {
        let mut ok = true;
        ok = ok and
             same(@x86_aesenc(s, k), @vec(u8x16, 153, 178, 140, 111, 106, 192, 245, 45, 213, 12, 145, 147, 119, 47, 96,
                                          110));
        ok = ok and
             same(@x86_aesenclast(s, k), @vec(u8x16, 223, 26, 78, 67, 32, 182, 56, 220, 43, 98, 224, 114, 191, 223, 119,
                                              65));
        ok = ok and
             same(@x86_aesdec(s, k), @vec(u8x16, 162, 130, 58, 23, 66, 72, 245, 123, 118, 120, 134, 241, 124, 186, 24,
                                          104));
        ok = ok and
             same(@x86_aesdeclast(s, k), @vec(u8x16, 240, 44, 125, 172, 221, 174, 26, 237, 164, 76, 132, 21, 3, 190, 99,
                                              104));
        ok = ok and
             same(@x86_aesimc(s), @vec(u8x16, 56, 230, 35, 199, 29, 213, 254, 133, 14, 244, 76, 58, 114, 112, 132, 38));
        ok = ok and
             same(@x86_aeskeygenassist(s, 0x1b), @vec(u8x16, 63, 4, 234, 164, 31, 234, 164, 63, 246, 38, 33, 49, 61, 33,
                                                      49, 246));
        let a = @vec(u64x2, 0x94e3bf911a61dbe2, 0xa38fd547923a7369);
        let b = @vec(u64x2, 0x5f557203301850c5, 0x8c38fb2918f135d2);
        ok = ok and same64(@x86_clmul(a, b, 0x0), @vec(u64x2, 0x3cd621d7b10b1dea, 0x2b11eda4b64312d4));
        ok = ok and same64(@x86_clmul(a, b, 0x1), @vec(u64x2, 0x16bf034d6f42000d, 0x248d18d1e5d7a61e));
        ok = ok and same64(@x86_clmul(a, b, 0x10), @vec(u64x2, 0x1fc7a86eda310a64, 0x4c9a480c513f1e04));
        ok = ok and same64(@x86_clmul(a, b, 0x11), @vec(u64x2, 0x4bb6c9bf308ac382, 0x564e9da18ae022fe));
        let text = "123456789";
        let mut c: u32 = 0xffff_ffff;
        for x in text {
            c = @x86_crc32c(c, x);
        }
        ok = ok and (~c == 0xe3069283);
        // the wider forms, eight bytes at a time
        c = @x86_crc32c(0xffff_ffff, @as(u64, 0x3837_3635_3433_3231));
        c = @x86_crc32c(c, @as(u8, 0x39));
        ok = ok and (~c == 0xe3069283);
        return ok;
    }
    return false;
}

fn arm(s: u8x16, k: u8x16) bool @features("aes,sha2,sha3,crc") {
    if @target_arch("aarch64") {
        let mut ok = true;
        ok = ok and
             same(@arm_aese(s, k), @vec(u8x16, 16, 15, 108, 64, 128, 91, 142, 2, 218, 192, 230, 80, 219, 237, 58, 48));
        ok = ok and
             same(@arm_aesd(s, k), @vec(u8x16, 1, 203, 154, 184, 162, 80, 245, 191, 189, 99, 119, 30, 110, 218, 26,
                                        88));
        ok = ok and
             same(@arm_aesmc(s), @vec(u8x16, 84, 98, 79, 67, 188, 142, 95, 222, 29, 225, 95, 47, 135, 51, 113, 101));
        ok = ok and
             same(@arm_aesimc(s), @vec(u8x16, 56, 230, 35, 199, 29, 213, 254, 133, 14, 244, 76, 58, 114, 112, 132, 38));
        let a = @vec(u64x2, 0x94e3bf911a61dbe2, 0xa38fd547923a7369);
        let b = @vec(u64x2, 0x5f557203301850c5, 0x8c38fb2918f135d2);
        ok = ok and same64(@arm_pmull(a, b), @vec(u64x2, 0x3cd621d7b10b1dea, 0x2b11eda4b64312d4));
        ok = ok and same64(@arm_pmull2(a, b), @vec(u64x2, 0x4bb6c9bf308ac382, 0x564e9da18ae022fe));
        let c = @vec(u64x2, 0x1012f037b64ce422, 0xf4205b4907a70c3);
        ok = ok and same64(@arm_eor3(a, b, c), @vec(u64x2, 0xdba43da59c356f05, 0x20f52bda1ab13678));
        ok = ok and same64(@arm_bcax(a, b, c), @vec(u64x2, 0xdba6bd911a71cb27, 0x23b72f4e9abb7679));
        ok = ok and same64(@arm_rax1(a, b), @vec(u64x2, 0x2a495b977a517a68, 0xbbfe2315a3d818cc));
        ok = ok and same64(@arm_xar(a, b, 13), @vec(u64x2, 0x593e5db66c9153cc, 0x35d97db97374565a));
        ok = ok and (@arm_sha1h(0x1234_5678) == 0x48d159e);
        let text = "123456789";
        let mut x: u32 = 0xffff_ffff;
        let mut y: u32 = 0xffff_ffff;
        for ch in text {
            x = @arm_crc32(x, ch);
            y = @arm_crc32c(y, ch);
        }
        ok = ok and (~x == 0xcbf43926) and (~y == 0xe3069283);
        x = @arm_crc32(0xffff_ffff, @as(u64, 0x3837_3635_3433_3231));
        x = @arm_crc32(x, @as(u8, 0x39));
        ok = ok and (~x == 0xcbf43926);
        return ok;
    }
    return false;
}

export fn run() void {
    let s = @vec(u8x16, 165, 77, 202, 24, 37, 48, 187, 29, 109, 19, 44, 222, 214, 35, 123, 46);
    let k = @vec(u8x16, 217, 30, 63, 114, 31, 203, 25, 113, 23, 68, 148, 214, 73, 60, 157, 92);
    let mut ok = true;
    if @cpu_has("aes") and @cpu_has("pclmul") and @cpu_has("sse4.2") {
        ok = x86(s, k);
    }
    if @cpu_has("aes") and @cpu_has("sha2") and @cpu_has("sha3") and @cpu_has("crc") {
        ok = arm(s, k);
    }
    io.boolean(ok);  // expect: true
}
