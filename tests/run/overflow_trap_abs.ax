// In the trap overflow mode, @abs(MIN) traps (T0002); the default wraps.
// flags: --overflow=trap
// expect-trap
import "../lib/io.ax" as io;

fn abs(a: i16) i16 {
    return @abs(a);
}

export fn run() void {
    io.int(@as(i64, abs(-5)));  // expect: 5
    io.str("before");           // expect: before
    io.int(@as(i64, abs(@min_value(i16))));
}
