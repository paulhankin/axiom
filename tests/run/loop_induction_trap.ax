// A counter counting down that is tested for 1 only after reading s[j - 2]
// (issue #21): at j == 1, j - 2 wraps, and the bounds check stays.
// expect-trap
// expect: 3
// expect: 2
// expect: 1
import "../lib/io.ax" as io;

fn down(s: []u32, i: usize) u64 {
    let mut t: u64 = 0;
    let mut j = i;
    loop {
        t += @as(u64, s[j - 1]);
        io.uint(@int_cast(u64, j));
        t += @as(u64, s[j - 2]);
        if j == 1 {
            break;
        }
        j -= 1;
    }
    return t;
}

export fn run() void {
    let s: [8]u32 = [1; 8];
    for i in @as(usize, 1)..8 {
        if i == 3 {
            io.uint(down(s[..], i));
        }
    }
}
