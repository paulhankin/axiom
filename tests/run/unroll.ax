// Loops with a small constant trip count, which -O2 unrolls fully (issue
// 0055), the one-hot stores and tests of one value against several
// constants they leave (issue 0063): the results must be those of the loops.
import "../lib/io.ax" as io;

let mut BOARD: [2][25]u8 = [[0; 25]; 2];
let mut TABLE: [64]u32 = [0; 64];

// running minimum of table entries picked by shifting a mask by 9 - c
fn containment(mask: u32, back: i32) u32 {
    let mut upto: [11]u32 = [36; 11];
    let mut m: u32 = 36;
    for c in @as(u32, 0)..10 {
        let af = @as(usize, (mask >> (9 - c)) & 0x3F);
        m = @min(m, TABLE[af]);
        upto[@as(usize, c) + 1] = m;
    }
    let k = @int_cast(usize, @min(@max(9 - back, 0), 10));
    return (upto[k] * 100) + upto[9];
}

fn race(side: *[25]u8, out: *mut [32]f32) u32 {
    @mem_set(out[..], 0.0);
    let mut off: u8 = 15;
    let mut ones: u32 = 0;
    for i in @as(usize, 0)..6 {
        let nc = side[i];
        off -= @min(nc, off);
        if nc == 1 {
            ones += 1;
        }
        if nc == 2 {
            ones += 10;
        }
        if nc >= 3 {
            ones += 100;
        }
        if nc > 3 {
            ones += 1000 * (@as(u32, nc) - 3);
        }
    }
    // one-hot
    for k in @as(usize, 0)..14 {
        if @as(usize, off) == (k + 1) {
            out[k + 2] = 1.0;
        }
    }
    // nested, the inner start depending on the outer variable
    let mut cross: u32 = 0;
    for k in @as(usize, 1)..4 {
        for i in (6 * k)..((6 * k) + 6) {
            cross += @as(u32, side[i]) * @truncate(u32, k);
        }
    }
    out[31] = @float_from_int(f32, cross);
    return ones;
}

fn onehot_sum(out: *[32]f32) f32 {
    let mut s: f32 = 0.0;
    for i in @as(usize, 0)..32 {
        s += out[i] * @float_from_int(f32, i + 1);
    }
    return s;
}

// a loop left early, whose value is used after it
fn first_zero(xs: *[9]u8) usize {
    let mut q: usize = 0;
    while (q < 9) and (xs[q] != 0) {
        q += 1;
    }
    return q;
}

// counting down, by twos, over u8 values near the top, zero times
fn odd_loops(x: u32) u64 {
    let mut a: u64 = 0;
    let mut i: i32 = 7;
    while i >= -3 {
        a = (a * 3) + @as(u64, @bit_cast(u32, i)) + @as(u64, x);
        i -= 2;
    }
    for j in @as(u8, 250)..255 {
        a = (a *% 31) +% @as(u64, j);
    }
    for j in @as(u32, 5)..5 {
        a += @as(u64, j) + 1000;
    }
    return a;
}

// one-hot stores that must not merge: a gap in the constants, different values
fn not_onehot(x: u32, out: *mut [8]u32) void {
    if x == 1 {
        out[1] = 7;
    } else if x == 2 {
        out[2] = 7;
    } else if x == 4 {
        out[4] = 7;
    }
    if x == 1 {
        out[5] = 1;
    } else if x == 2 {
        out[6] = 2;
    } else if x == 3 {
        out[7] = 3;
    }
}

// signed tests of one value
fn classify(v: i32) u32 {
    let mut r: u32 = 0;
    if v < -5 {
        r += 1;
    }
    if v == -7 {
        r += 10;
    }
    if v >= 0 {
        r += 100;
    }
    if v > 100 {
        r += 1000;
    }
    if v == 3 {
        r += 10000;
    }
    return r;
}

// a loop of one block (its test at its end)
fn self_loop(x: u32) u32 {
    let mut i: u32 = 0;
    let mut a = x;
    loop {
        a = (a *% 3) +% i;
        i += 1;
        if i >= 7 {
            break;
        }
    }
    return a +% i;
}

// conversions of the constants unrolling leaves, rounded once
fn conversions() f64 {
    let a: u64 = 0xFFFF_FFFF_FFFF_FFFF;
    let b: i64 = -0x7FFF_FFFF_FFFF_FFFF;
    let c: u64 = 0x20_0000_0000_0001;
    let d: u32 = 0x100_0001;
    let e: i8 = -128;
    let mut s: f64 = @float_from_int(f64, a) + @float_from_int(f64, b);
    s += @as(f64, @float_from_int(f32, a)) - @as(f64, @float_from_int(f32, b));
    s += @float_from_int(f64, c) - @as(f64, @float_from_int(f32, c));
    s += @as(f64, @float_from_int(f32, d)) + @float_from_int(f64, e);
    return s;
}

export fn run() void {
    for i in @as(usize, 0)..64 {
        TABLE[i] = @truncate(u32, ((i * 37) + 11) % 41);
    }
    io.uint(@as(u64, containment(0x2B5, 2)));   // expect: 303
    io.uint(@as(u64, containment(0x1FF, -1)));  // expect: 505
    let vals: [25]u8 = [1, 2, 3, 4, 0, 1, 2, 5, 7, 0, 1, 1, 3, 2, 0, 0, 9, 1, 4, 2, 2, 0, 1, 0, 3];
    for i in @as(usize, 0)..25 {
        BOARD[0][i] = vals[i];
        BOARD[1][i] = @truncate(u8, i % 2);
    }
    let mut out: [32]f32 = [0.0; 32];
    io.uint(@as(u64, race(&BOARD[0], &mut out)));  // expect: 1212
    io.float(@as(f64, onehot_sum(&out)));          // expect: 2342
    io.uint(@as(u64, race(&BOARD[1], &mut out)));  // expect: 3
    io.float(@as(f64, onehot_sum(&out)));          // expect: 590
    BOARD[1][0] = 15;
    io.uint(@as(u64, race(&BOARD[1], &mut out)));  // expect: 12103
    io.float(@as(f64, onehot_sum(&out)));          // expect: 576
    let zs: [9]u8 = [3, 1, 4, 1, 5, 0, 2, 6, 5];
    io.uint(@as(u64, first_zero(&zs)));  // expect: 5
    let nz: [9]u8 = [1; 9];
    io.uint(@as(u64, first_zero(&nz)));         // expect: 9
    io.uint(odd_loops(@as(u32, BOARD[0][3])));  // expect: 491845173649475390
    let mut o8: [8]u32 = [0; 8];
    for x in @as(u32, 0)..6 {
        not_onehot(x, &mut o8);
    }
    let mut s: u32 = 0;
    for i in @as(usize, 0)..8 {
        s = (s * 10) + o8[i];
    }
    io.uint(@as(u64, s));  // expect: 7707123
    let mut c: u64 = 0;
    for v in @as(i32, -9)..105 {
        c += @as(u64, classify(v)) * @as(u64, @bit_cast(u32, v + 10));
    }
    io.uint(c);  // expect: 1231040
    io.uint(@as(u64, self_loop(@as(u32, BOARD[0][2]))));  // expect: 7111
    io.uint(@bit_cast(u64, conversions()));               // expect: 4899916394579101696
}
