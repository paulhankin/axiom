// Large arrays and structs as values: zero and constant initializers,
// copies, self-assignment, and passing by value (LLVM cannot select
// instructions for such aggregates whole; they are moved as memory).
import "../lib/io.ax" as io;

struct Big {
    n: u32,
    data: [20000]u8,
}

fn fill(b: *mut Big, v: u8) void {
    for i in @as(usize, 0)..b.data.len {
        b.data[i] = v +% @truncate(u8, i);
    }
}

fn sum(b: Big) u64 {
    let mut s: u64 = @as(u64, b.n);
    for x in b.data {
        s += @as(u64, x);
    }
    return s;
}

export fn run() void {
    let mut a: [50000]u8 = [0; 50000];
    a[49999] = 9;
    let mut c = a;
    c = c;
    io.uint(@as(u64, c[49999]));
    // expect: 9
    let mut r: [5000]u32 = [7; 5000];
    r[4999] = 1;
    io.uint(@as(u64, r[0] + r[4999]));
    // expect: 8
    let mut b = Big.{ n: 1, data: [0; 20000] };
    io.uint(sum(b));
    // expect: 1
    fill(&mut b, 3);
    let b2 = b;
    io.boolean(sum(b2) == sum(b));
    io.uint(@as(u64, b2.data[19999]));
    // expect: true
    // expect: 34
}
