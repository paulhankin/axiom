// Chains of tests of one value against constants that go to one place,
// which -O2 tests at once (a range, or a bit of a mask): every value must
// take the way it took test by test.
import "../lib/io.ax" as io;

fn gaps(x: i32) i32 {
    if (x == 3) or (x == 5) or (x == 9) or (x == 40) {
        return 1;
    }
    return 0;
}

fn run_of(x: u32) i32 {
    if (x == 7) or (x == 8) or (x == 9) or (x == 10) {
        return 2;
    }
    return 0;
}

fn negs(x: i64) i64 {
    if (x == -2) or (x == -1) or (x == 1) or (x == 3) {
        return x * 10;
    }
    return x;
}

fn bytes(c: u8) bool {
    return (c == ' ') or (c == '\t') or (c == '\n') or (c == '\r');
}

fn far(x: u64) u64 {
    // more than 64 apart: tested one by one
    if (x == 1) or (x == 100) or (x == 7) {
        return 5;
    }
    return 6;
}

fn top(x: u64) u64 {
    if (x == 0xFFFF_FFFF_FFFF_FFFF) or (x == 0xFFFF_FFFF_FFFF_FFFE) or (x == 0xFFFF_FFFF_FFFF_FFF0) {
        return 1;
    }
    return 0;
}

fn mixed(x: u32) u32 {
    // a range (from the and of two tests) among the equalities
    let mut r: u32 = 0;
    if (x == 2) or ((x >= 10) and (x < 14)) or (x == 20) {
        r = x + 100;
    } else {
        r = x;
    }
    return r;
}

export fn run() void {
    let mut s: i64 = 0;
    for x in @as(i32, -5)..70 {
        s = (s * 3) + @as(i64, gaps(x));
        s = s % 1000000007;
    }
    io.int(s);  // expect: 1766573
    let mut t: u64 = 0;
    for x in @as(u32, 0)..40 {
        t = (t * 5) +% @as(u64, @bit_cast(u32, run_of(x)));
    }
    io.uint(t);  // expect: 7284823820771784600
    let mut z: i64 = 0;
    for x in @as(i64, -6)..8 {
        z = (z * 7) + negs(x);
    }
    io.int(z);  // expect: -660160667516
    let mut nb: u32 = 0;
    for c in @as(u32, 0)..256 {
        if bytes(@truncate(u8, c)) {
            nb = (nb * 3) + c;
        }
    }
    io.uint(@as(u64, nb));  // expect: 404
    io.uint(far(1) + far(100) + far(7) + far(50));  // expect: 21
    io.uint(top(0xFFFF_FFFF_FFFF_FFFF) + top(0xFFFF_FFFF_FFFF_FFF1) + top(0xFFFF_FFFF_FFFF_FFF0) + top(0));  // expect: 2
    let mut mm: u32 = 0;
    for x in @as(u32, 0)..30 {
        mm = (mm *% 31) +% mixed(x);
    }
    io.uint(@as(u64, mm));  // expect: 4083068487
}
