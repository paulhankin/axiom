// A function compiled for extensions the processor lacks traps (T0013)
// when called: these name both architectures', so no processor has them.
// expect-trap
import "../lib/io.ax" as io;

fn impossible(x: u32) u32 @features("avx2,sve") {
    return x + 1;
}

export fn run() void {
    io.uint(@as(u64, impossible(1)));
}
