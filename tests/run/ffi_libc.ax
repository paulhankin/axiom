// Calling the C library (native only: freestanding wasm has no libc).
// native-only
import "../lib/io.ax" as io;
import "std/c" as c;

extern "C" {
    fn strlen(s: *u8) usize;
    fn snprintf(buf: *mut u8, n: usize, fmt: *u8, ...) i32;
    fn qsort(base: *mut void, n: usize, size: usize, cmp: fn(*void, *void) i32) void;
    fn getenv(name: *u8) *u8;
}

extern "C" "m" {
    fn cos(x: f64) f64;
}

fn cmp_i32(a: *void, b: *void) i32 {
    let x = @ptr_cast(*i32, a).*;
    let y = @ptr_cast(*i32, b).*;
    if x < y {
        return -1;
    }
    if x > y {
        return 1;
    }
    return 0;
}

export fn run() void {
    let s = c.to_cstr("axiom") catch return;
    io.uint(@as(u64, strlen(s)));  // expect: 8
    c.free_cstr(s);
    let mut buf: [64]u8 = [0; 64];
    let n = snprintf(&mut buf[0], buf.len, "%d-%s-%.2f".ptr, 42, "x".ptr, 0.5);
    io.str(buf[..@int_cast(usize, n)]);  // expect: 42-x-0.50
    let mut xs: [5]i32 = [5, -1, 3, 9, 0];
    qsort(@ptr_cast(*mut void, &mut xs), xs.len, @size_of(i32), cmp_i32);
    for x in xs {
        io.int(@as(i64, x));
    }
    // expect: -1
    // expect: 0
    // expect: 3
    // expect: 5
    // expect: 9
    io.float(cos(0.0));  // expect: 1
    io.boolean(c.is_null(getenv("AXIOM_SURELY_UNSET_VARIABLE".ptr)));  // expect: true
}
