// A freed allocation is used: the access traps, and the report says where
// the memory was allocated and freed.
// status: trap
// stderr: heap-use-after-free: 4-byte access
// stderr: 4 bytes inside a 16-byte allocation
// stderr: freed:
// stderr: use_after_free.ax:20:5)
// stderr: allocated:
// stderr: use_after_free.ax:13:14)
import "../../std/mem.ax" as mem;

fn make() ![]mut u32 {
    let xs = mem.alloc.[u32](4)!;
    xs[1] = 7;
    return xs;
}

export fn main() i32 {
    let xs = make() catch return 1;
    mem.free(xs);
    return @bit_cast(i32, xs[1]);
}
