// A slice into a String kept across a push that grows (and so moves) it.
// status: trap
// stderr: heap-use-after-free
import "../../std/str.ax" as strs;

export fn main() i32 {
    let mut s = strs.String.init();
    s.push_str("hello") catch return 1;
    let view = s.bytes();
    s.push_str(", a much longer string that needs more room") catch return 1;
    let c = view[0];
    s.deinit();
    return @as(i32, c);
}
