// Direct3D 12 (std/graphics/d3d12), drawn offscreen and read back pixel by
// pixel: textures from images, compute shaders, vertices a compute shader
// made, and Direct2D on top (D3D11On12). Windows only:
// axiom test tests/windows/d3d12.ax --target=x86_64-windows

import "std/graphics/d2d" as d2d;
import "std/graphics/d3d12" as d3d;
import "std/graphics/hlsl" as hlsl;
import "std/graphics/image" as image;

let mut src_buf: [8192]u8 = [0; 8192];

// The lines of a shader, joined.
fn src(lines: [][]u8) []u8 {
    let mut n: usize = 0;
    for l in lines {
        @mem_copy(src_buf[n..n + l.len], l);
        src_buf[n + l.len] = '\n';
        n += l.len + 1;
    }
    return src_buf[0..n];
}

fn px(img: *image.Image, x: usize, y: usize) u32 {
    let at = ((y * img.width) + x) * 4;
    return ((@as(u32, img.data[at]) << 24) | (@as(u32, img.data[at + 1]) << 16)) | (
        (@as(u32, img.data[at + 2]) << 8) | @as(u32, img.data[at + 3]));
}

// A triangle over the whole target from SV_VertexID, showing t0 one texel a
// pixel; or the vertices at POSITION, in a colour.
let SHADER: [14][]u8 = ["Texture2D tex : register(t0);", "SamplerState lin : register(s0);",
                        "struct VSOut { float4 pos : SV_Position; float2 uv : TEXCOORD; };",
                        "VSOut full(uint id : SV_VertexID) {", "    VSOut o;",
                        "    float2 p = float2(id == 2 ? 3.0 : -1.0, id == 1 ? 3.0 : -1.0);",
                        "    o.pos = float4(p, 0.5, 1.0);", "    o.uv = float2(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);",
                        "    return o;", "}", "float4 textured(VSOut i) : SV_Target { return tex.Sample(lin, i.uv); }",
                        "float4 at(float4 p : POSITION) : SV_Position { return p; }",
                        "float4 yellow(float4 p : SV_Position) : SV_Target { return float4(1, 1, 0, 1); }", ""];

test "a texture from an image" {
    let mut gpu = d3d.Device.init()!;
    defer gpu.deinit();
    let s = src(SHADER[..]);
    let mut vc = hlsl.compile(s, "full", "vs_5_0")!;
    defer vc.release();
    let mut pc = hlsl.compile(s, "textured", "ps_5_0")!;
    defer pc.release();
    let mut rs = gpu.root_signature_with(0, 0, 1)!;
    defer rs.release();
    let attrs = [d3d.Attribute.{ semantic: "POSITION", index: 0, format: d3d.R32_FLOAT, offset: 0 }];
    let mut p = gpu.pipeline(&rs, &vc, &pc, attrs[0..0], d3d.TRIANGLE_LIST, false)!;
    defer p.release();
    // 4 × 4 gray and alpha (converted to RGBA on the way): one texel a
    // pixel, so linear filtering changes nothing
    let mut img = image.Image.init(4, 4, 2, image.Depth.U8)!;
    defer img.deinit();
    for i in @as(usize, 0)..16 {
        img.data[i * 2] = @truncate(u8, i * 16);
        img.data[(i * 2) + 1] = 255;
    }
    let mut tex = gpu.texture(&img)!;
    defer tex.release();
    let mut t = gpu.target(4, 4)!;
    defer t.release();
    gpu.begin(&mut t)!;
    gpu.clear(&t, 0.0, 0.0, 0.0, 1.0);
    gpu.set_pipeline(&p);
    gpu.set_image(0, &tex);
    gpu.draw(3, 0);
    gpu.finish()!;
    let mut out = gpu.read_pixels(&mut t)!;
    defer out.deinit();
    for i in @as(usize, 0)..16 {
        let g = @as(u32, @truncate(u8, i * 16));
        @expect_eq(px(&out, i % 4, i / 4), (((g << 24) | (g << 16)) | (g << 8)) | 255);
    }
}

let CS: [7][]u8 = ["cbuffer K : register(b0) { uint add; };", "RWStructuredBuffer<uint> buf : register(u0);",
                   "RWStructuredBuffer<float4> tri : register(u1);", "[numthreads(64, 1, 1)]",
                   "void main(uint3 id : SV_DispatchThreadID) {", "    buf[id.x] = buf[id.x] * buf[id.x] + add;",
                   "    if (id.x < 3) { tri[id.x] = float4(id.x == 2 ? 0.5 : -0.5, id.x == 1 ? 0.5 : -0.5, 0.5, 1); } }"];

test "a compute shader, and drawing what it made" {
    let mut gpu = d3d.Device.init()!;
    defer gpu.deinit();
    let mut code = hlsl.compile(src(CS[..]), "main", "cs_5_0")!;
    defer code.release();
    let mut rs = gpu.compute_signature(1, 2)!;
    defer rs.release();
    let mut cp = gpu.compute_pipeline(&rs, &code)!;
    defer cp.release();
    let n: usize = 256;
    let mut data: [256]u32 = [0; 256];
    for i in 0..n {
        data[i] = @truncate(u32, i);
    }
    let mut b = gpu.storage_buffer(@slice_from_ptr(@ptr_cast(*u8, &data[0]), n * 4))!;
    defer b.release();
    let zero: [48]u8 = [0; 48];
    let mut tri = gpu.storage_buffer(zero[..])!;
    defer tri.release();
    gpu.set_compute_pipeline(&cp)!;
    let k: [1]u32 = [7];
    gpu.set_compute_constants(k[..]);
    gpu.set_storage(0, &mut b);
    gpu.set_storage(1, &mut tri);
    gpu.dispatch(@truncate(u32, n / 64), 1, 1);
    gpu.dispatch(@truncate(u32, n / 64), 1, 1);  // twice: (i² + 7)² + 7
    gpu.finish()!;
    let mut out: [256]u32 = [0; 256];
    gpu.read_buffer(&mut b, @slice_from_ptr(@ptr_cast(*mut u8, &mut out[0]), n * 4))!;
    for i in 0..n {
        let x = @truncate(u32, i);
        let once = (x * x) + 7;
        @expect_eq(out[i], (once *% once) +% 7);
    }
    // the triangle the shader wrote: (-0.5, -0.5), (-0.5, 0.5), (0.5, -0.5)
    let s = src(SHADER[..]);
    let mut vc = hlsl.compile(s, "at", "vs_5_0")!;
    defer vc.release();
    let mut pc = hlsl.compile(s, "yellow", "ps_5_0")!;
    defer pc.release();
    let mut gs = gpu.root_signature(0)!;
    defer gs.release();
    let attrs = [d3d.Attribute.{ semantic: "POSITION", index: 0, format: d3d.R32G32B32A32_FLOAT, offset: 0 }];
    let mut p = gpu.pipeline(&gs, &vc, &pc, attrs[..], d3d.TRIANGLE_LIST, false)!;
    defer p.release();
    let mut t = gpu.target(8, 8)!;
    defer t.release();
    gpu.begin(&mut t)!;
    gpu.clear(&t, 0.0, 0.0, 0.0, 1.0);
    gpu.set_pipeline(&p);
    gpu.set_storage_vertices(&mut tri, 16);
    gpu.draw(3, 0);
    gpu.finish()!;
    let mut img = gpu.read_pixels(&mut t)!;
    defer img.deinit();
    @expect_eq(px(&img, 2, 5), 0xffff00ff);  // inside, near the right angle
    @expect_eq(px(&img, 5, 2), 0x000000ff);  // across the hypotenuse
    @expect_eq(px(&img, 0, 0), 0x000000ff);
}

test "Direct2D over Direct3D 12" {
    let mut gpu = d3d.Device.init()!;
    defer gpu.deinit();
    let mut ov = gpu.overlay()!;
    defer ov.release();
    let mut t = gpu.target(32, 32)!;
    defer t.release();
    let mut c = d2d.Canvas.for_texture(gpu.overlay_texture(&mut ov, &t)!, 32, 32)!;
    defer c.deinit();
    for frame in @as(u32, 0)..3 {
        gpu.begin(&mut t)!;
        gpu.clear(&t, 0.0, 0.0, 1.0, 1.0);
        gpu.begin_overlay(&mut ov, &mut t)!;
        c.begin();
        c.fill_rect(8.0 + @float_from_int(f32, frame), 8.0, 8.0, 8.0, d2d.rgb(1.0, 1.0, 1.0));
        c.end()!;
        gpu.end_overlay(&mut ov, &mut t);
        gpu.finish()!;
    }
    let mut img = gpu.read_pixels(&mut t)!;
    defer img.deinit();
    @expect_eq(px(&img, 14, 12), 0xffffffff);  // the last frame's square: 10..18
    @expect_eq(px(&img, 9, 12), 0x0000ffff);
    @expect_eq(px(&img, 2, 2), 0x0000ffff);
}

fn fails_with_message(s: []u8, target: []u8) bool {
    let mut c = hlsl.compile(s, "main", target) catch |e| {
        return (e == error.CompileError) and (hlsl.message().len > 0);
    };
    c.release();
    return false;
}

test "DXIL (shader model 6)" {
    let mut code = hlsl.compile(src(CS[..]), "main", "cs_6_0") catch |e| {
        if e == error.Unsupported {
            return;  // no DirectX Shader Compiler here
        }
        return e;
    };
    defer code.release();
    let b = code.bytes();
    @expect(b.len > 4 and b[0] == 'D' and b[1] == 'X' and b[2] == 'B' and b[3] == 'C');  // (the container)
    @expect(fails_with_message("[numthreads(1,1,1)] void main() { undefined(); }", "cs_6_0"));
    let mut gpu = d3d.Device.init()!;
    defer gpu.deinit();
    let mut rs = gpu.compute_signature(1, 2)!;
    defer rs.release();
    let mut cp = gpu.compute_pipeline(&rs, &code)!;
    defer cp.release();
    let mut data: [64]u32 = [0; 64];
    for i in @as(usize, 0)..64 {
        data[i] = @truncate(u32, i);
    }
    let mut b0 = gpu.storage_buffer(@slice_from_ptr(@ptr_cast(*u8, &data[0]), 256))!;
    defer b0.release();
    let zero: [48]u8 = [0; 48];
    let mut tri = gpu.storage_buffer(zero[..])!;
    defer tri.release();
    gpu.set_compute_pipeline(&cp)!;
    let k: [1]u32 = [3];
    gpu.set_compute_constants(k[..]);
    gpu.set_storage(0, &mut b0);
    gpu.set_storage(1, &mut tri);
    gpu.dispatch(1, 1, 1);
    gpu.finish()!;
    let mut out: [64]u32 = [0; 64];
    gpu.read_buffer(&mut b0, @slice_from_ptr(@ptr_cast(*mut u8, &mut out[0]), 256))!;
    for i in @as(usize, 0)..64 {
        @expect_eq(out[i], @truncate(u32, (i * i) + 3));
    }
}
