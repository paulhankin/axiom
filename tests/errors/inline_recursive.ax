// expect-error: E0314
inline fn fact(n: u64) u64 {
    if n == 0 {
        return 1;
    }
    return n * fact(n - 1);
}

inline fn ping(n: u32) u32 {
    if n == 0 {
        return 0;
    }
    return pong(n - 1);
}

inline fn pong(n: u32) u32 {
    return ping(n) + 1;
}

// recursion through a function that is not inline is allowed
inline fn even(n: u32) bool {
    if n == 0 {
        return true;
    }
    return odd(n - 1);
}

fn odd(n: u32) bool {
    if n == 0 {
        return false;
    }
    return even(n - 1);
}
