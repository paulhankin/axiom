// tests/native_rt.ax - the host functions of tests/lib/io.ax and the entry
// point, in Axiom: tests/native_rt.c's job on native targets that link no C
// code (macOS, Windows). tests/run.mjs passes it with --link.
import "std/fmt" as fmt;
import "std/io" as io;

extern "C" {
    fn run() void;
}

fn line(s: []u8) void {
    io.stdout().println(s) catch return;
}

export fn print_i64(x: i64) void {
    io.stdout().print_i64(x) catch return;
    line("");
}

export fn print_u64(x: u64) void {
    let mut buf: [24]u8 = [0; 24];
    line(fmt.format_uint(buf[..], x, 10, false));
}

export fn print_bool(b: bool) void {
    if b {
        line("true");
    } else {
        line("false");
    }
}

export fn print_str(p: *u8, n: usize) void {
    line(@slice_from_ptr(p, n));
}

// As JavaScript's Number#toString.
export fn print_f64(x: f64) void {
    if x != x {
        line("NaN");
        return;
    }
    if x == 0.0 {
        line("0");
        return;
    }
    let mut buf: [64]u8 = [0; 64];
    let s = fmt.format_float(buf[..], x) catch return;
    if (s.len > 0) and ((s[s.len - 1] == 'f') or (s[s.len - 1] == 'F')) {
        if x > 0.0 {
            line("Infinity");
        } else {
            line("-Infinity");
        }
        return;
    }
    line(s);
}

export fn main() i32 {
    run();
    return 0;
}
