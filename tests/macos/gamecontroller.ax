// Game controllers (std/os/gamecontroller): what a pad that is not there
// reads as (whether one is attached depends on the machine). macOS only:
// axiom test tests/macos/gamecontroller.ax --target=aarch64-macos

import "std/os/gamecontroller" as gc;

test "no pad is a disconnected pad" {
    // (whether one is attached depends on the machine: only check the shape)
    let p = gc.state(gc.MAX_PADS);
    @expect(not p.connected and (p.buttons == 0));
    @expect(not gc.vibrate(gc.MAX_PADS, 1.0, 1.0));
    @expect(gc.battery(gc.MAX_PADS).kind == gc.BatteryKind.DISCONNECTED);
    let mut t = gc.Tracker.init();
    _ = t.update();
    @expect(not t.pressed(0, gc.A));
    let s = gc.state(0);
    if not s.connected {
        @expect(gc.name(0).len == 0);
    }
}
