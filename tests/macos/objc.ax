// The Objective-C runtime from Axiom (std/os/objc): classes, messages,
// strings, NSValues read by key-value coding, and a class made at run time
// whose method is an Axiom function. macOS only:
// axiom test tests/macos/objc.ax --target=aarch64-macos (tests/run.mjs runs
// it on a Mac).

import "std/os/objc" as objc;

test "classes, messages and strings" {
    let pool = objc.pool_push();
    defer objc.pool_pop(pool);
    let info = objc.call(objc.class("NSProcessInfo"), "processInfo");
    @expect(info != 0);
    @expect(objc.call(info, "activeProcessorCount") >= 1);
    @expect(objc.class("NoSuchClassAtAll") == 0);
    let s = objc.string("héllo, wörld");
    @expect(objc.call(s, "length") == 12);
    let back = objc.string_of(s);
    @expect(back.len == 14);
    @expect(back[1] == 0xc3);
    @expect(objc.sel_name(objc.sel("initWithFrame:")).len == 14);
    @expect(objc.number_f64(objc.number(2.5)) == 2.5);
    @expect(objc.number_f64(objc.number_int(-7)) == -7.0);
}

fn twice(self: usize, cmd: usize, x: usize) usize {
    _ = cmd;
    return (x * 2) + objc.get_ivar(self, "base");
}

test "a class made at run time, and struct values" {
    let pool = objc.pool_push();
    defer objc.pool_pop(pool);
    let mut cls = objc.class("AxiomObjcTestDoubler");
    if cls == 0 {
        cls = objc.define_class("AxiomObjcTestDoubler", "NSObject");
        @expect(cls != 0);
        @expect(objc.add_ivar(cls, "base"));
        @expect(objc.add_method(cls, "twice:", @bit_cast(usize, twice), "Q@:Q"));
        objc.register_class(cls);
    }
    let obj = objc.new("AxiomObjcTestDoubler");
    defer objc.release(obj);
    objc.set_ivar(obj, "base", 100);
    @expect(objc.responds(obj, objc.sel("twice:")));
    @expect(objc.call1(obj, "twice:", 21) == 142);
    // an NSValue holding an NSRect, read through key-value coding
    let v = objc.send_dddd(objc.class("NSValue"), objc.sel("valueWithRect:"), 1.0, 2.0, 30.0, 40.0);
    let r = objc.get_f64x4(v, "rectValue");
    @expect((r[0] == 1.0) and (r[1] == 2.0) and (r[2] == 30.0) and (r[3] == 40.0));
    let sv = objc.send_dd(objc.class("NSValue"), objc.sel("valueWithSize:"), 30.0, 40.0);
    let sz = objc.get_f64x2(sv, "sizeValue");
    @expect((sz[0] == 30.0) and (sz[1] == 40.0));
}
