// =============================================================================
// File: v3.ax
// Three-vectors of f32, for the physics and the meshes.
// =============================================================================

import "std/math" as math;

pub struct V3 {
    x: f32,
    y: f32,
    z: f32,

    pub fn add(self: V3, o: V3) V3 {
        return V3.{ x: self.x + o.x, y: self.y + o.y, z: self.z + o.z };
    }

    pub fn sub(self: V3, o: V3) V3 {
        return V3.{ x: self.x - o.x, y: self.y - o.y, z: self.z - o.z };
    }

    pub fn scale(self: V3, k: f32) V3 {
        return V3.{ x: self.x * k, y: self.y * k, z: self.z * k };
    }

    pub fn dot(self: V3, o: V3) f32 {
        return (self.x * o.x) + (self.y * o.y) + (self.z * o.z);
    }

    pub fn cross(self: V3, o: V3) V3 {
        return V3.{ x: (self.y * o.z) - (self.z * o.y), y: (self.z * o.x) - (self.x * o.z),
                    z: (self.x * o.y) - (self.y * o.x) };
    }

    pub fn len(self: V3) f32 {
        return @sqrt(self.dot(self));
    }

    pub fn norm(self: V3) V3 {
        let l = self.len();
        if l < 1.0e-12 {
            return self;
        }
        return self.scale(1.0 / l);
    }

    /// The vector's part in the plane (z dropped).
    pub fn flat(self: V3) V3 {
        return V3.{ x: self.x, y: self.y, z: 0.0 };
    }

    pub fn lerp(self: V3, o: V3, t: f32) V3 {
        return self.add(o.sub(self).scale(t));
    }
}

pub fn v(x: f32, y: f32, z: f32) V3 {
    return V3.{ x: x, y: y, z: z };
}

pub fn zero() V3 {
    return V3.{ x: 0.0, y: 0.0, z: 0.0 };
}

/// The z of the 2D cross product of a and b's plane parts.
pub fn cross2(a: V3, b: V3) f32 {
    return (a.x * b.y) - (a.y * b.x);
}

/// A unit vector in the plane at angle a (radians from +x).
pub fn dir(a: f32) V3 {
    return V3.{ x: math.cosf(a), y: math.sinf(a), z: 0.0 };
}

pub fn clampf(x: f32, lo: f32, hi: f32) f32 {
    return @min(@max(x, lo), hi);
}

/// The point of segment a..b nearest p.
pub fn nearest_on_segment(p: V3, a: V3, b: V3) V3 {
    let ab = b.sub(a);
    let l2 = ab.dot(ab);
    if l2 < 1.0e-12 {
        return a;
    }
    return a.add(ab.scale(clampf(p.sub(a).dot(ab) / l2, 0.0, 1.0)));
}

/// The point of triangle a b c nearest p (Ericson, Real-Time Collision
/// Detection, 5.1.5).
pub fn nearest_on_triangle(p: V3, a: V3, b: V3, c: V3) V3 {
    let ab = b.sub(a);
    let ac = c.sub(a);
    let ap = p.sub(a);
    let d1 = ab.dot(ap);
    let d2 = ac.dot(ap);
    if (d1 <= 0.0) and (d2 <= 0.0) {
        return a;
    }
    let bp = p.sub(b);
    let d3 = ab.dot(bp);
    let d4 = ac.dot(bp);
    if (d3 >= 0.0) and (d4 <= d3) {
        return b;
    }
    let vc = (d1 * d4) - (d3 * d2);
    if (vc <= 0.0) and (d1 >= 0.0) and (d3 <= 0.0) {
        return a.add(ab.scale(d1 / (d1 - d3)));
    }
    let cp = p.sub(c);
    let d5 = ab.dot(cp);
    let d6 = ac.dot(cp);
    if (d6 >= 0.0) and (d5 <= d6) {
        return c;
    }
    let vb = (d5 * d2) - (d1 * d6);
    if (vb <= 0.0) and (d2 >= 0.0) and (d6 <= 0.0) {
        return a.add(ac.scale(d2 / (d2 - d6)));
    }
    let va = (d3 * d6) - (d5 * d4);
    if (va <= 0.0) and ((d4 - d3) >= 0.0) and ((d5 - d6) >= 0.0) {
        return b.add(c.sub(b).scale((d4 - d3) / ((d4 - d3) + (d5 - d6))));
    }
    let denom = 1.0 / (va + vb + vc);
    return a.add(ab.scale(vb * denom)).add(ac.scale(vc * denom));
}
