// =============================================================================
// File: shaders.ax
// The shaders, from shaders.metal (written by tools/embed.py: edit that,
// then run it).
// =============================================================================

pub let MSL: [564][]u8 = [
    "// The table's shaders (Metal). tools/embed.py turns this file into",
    "// src/shaders.ax, which the program compiles at run time.",
    "//",
    "// Coordinates are the table's, in metres: x across, y up the table, z up",
    "// from the playfield. Light is linear and goes into a half-float target;",
    "// a bright pass and blurs make the bloom; the last pass tone-maps.",
    "#include <metal_stdlib>",
    "using namespace metal;",
    "",
    "// Per draw (buffer 0): the model's rows, a tint, and extras",
    "struct Draw {",
    "    float4 m0;",
    "    float4 m1;",
    "    float4 m2;",
    "    float4 tint;   // rgb times the vertex colour; a: opacity",
    "    float4 extra;  // x: a lamp (-1 none), y: its glow, z: material (-1: the vertex's), w: roughness (-1: the vertex's)",
    "};",
    "",
    "// Per frame (buffer 1)",
    "struct Frame {",
    "    float4x4 viewproj;",
    "    float4x4 shadowvp;",
    "    float4 eye;     // w: time",
    "    float4 key;     // the key light's direction (travelling); w: a shadow texel",
    "    float4 keycol;  // w: ambient",
    "    float4 balls[6];   // xyz; w: radius (0: none)",
    "    float4 lamps[8];   // 32 lamps' brightness",
    "    float4 ins_a[24];  // inserts: x, y, size, angle",
    "    float4 ins_b[24];  // colour, shape",
    "    float4 lpos[24];   // point lights: xyz, radius",
    "    float4 lcol[24];   // colour",
    "    float4 counts;     // x: point lights; y: general illumination; z: exposure; w: flash",
    "    float4 screen;     // x, y: pixels; z: bloom; w: aspect",
    "    float4 table;      // the art's mapping: x0, y0, width, height",
    "};",
    "",
    "struct VIn {",
    "    float3 pos [[attribute(0)]];",
    "    float3 nrm [[attribute(1)]];",
    "    float4 col [[attribute(2)]];  // a: material",
    "    float2 uv [[attribute(3)]];",
    "};",
    "",
    "struct VOut {",
    "    float4 pos [[position]];",
    "    float3 w;",
    "    float3 n;",
    "    float4 col;",
    "    float2 uv;",
    "};",
    "",
    "constexpr sampler aniso(filter::linear, mip_filter::linear, max_anisotropy(16), address::clamp_to_edge);",
    "constexpr sampler lin(filter::linear, address::clamp_to_edge);",
    "",
    "constant float PI = 3.14159265;",
    "",
    "float3 world(constant Draw& d, float3 p) {",
    "    float4 q = float4(p, 1.0);",
    "    return float3(dot(d.m0, q), dot(d.m1, q), dot(d.m2, q));",
    "}",
    "",
    "float3 turn(constant Draw& d, float3 n) {",
    "    return float3(dot(d.m0.xyz, n), dot(d.m1.xyz, n), dot(d.m2.xyz, n));",
    "}",
    "",
    "vertex VOut vs(VIn i [[stage_in]], constant Draw& d [[buffer(0)]], constant Frame& f [[buffer(1)]]) {",
    "    VOut o;",
    "    o.w = world(d, i.pos);",
    "    o.n = turn(d, i.nrm);",
    "    o.pos = f.viewproj * float4(o.w, 1.0);",
    "    o.col = float4(i.col.rgb * d.tint.rgb, d.extra.z >= 0.0 ? d.extra.z : i.col.a);",
    "    o.uv = i.uv;",
    "    return o;",
    "}",
    "",
    "struct SOut {",
    "    float4 pos [[position]];",
    "};",
    "",
    "vertex SOut vs_shadow(VIn i [[stage_in]], constant Draw& d [[buffer(0)]], constant Frame& f [[buffer(1)]]) {",
    "    SOut o;",
    "    o.pos = f.shadowvp * float4(world(d, i.pos), 1.0);",
    "    return o;",
    "}",
    "",
    "float lamp(constant Frame& f, int k) {",
    "    if (k < 0 || k > 31) {",
    "        return 0.0;",
    "    }",
    "    return f.lamps[k >> 2][k & 3];",
    "}",
    "",
    "float hash(float2 p) {",
    "    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);",
    "}",
    "",
    "float noise(float2 p) {",
    "    float2 c = floor(p);",
    "    float2 u = fract(p);",
    "    u = u * u * (3.0 - 2.0 * u);",
    "    float a = mix(hash(c), hash(c + float2(1.0, 0.0)), u.x);",
    "    float b = mix(hash(c + float2(0.0, 1.0)), hash(c + float2(1.0, 1.0)), u.x);",
    "    return mix(a, b, u.y);",
    "}",
    "",
    "// --- lighting ------------------------------------------------------------",
    "",
    "float ggx(float nh, float a) {",
    "    float a2 = a * a;",
    "    float d = nh * nh * (a2 - 1.0) + 1.0;",
    "    return a2 / (PI * d * d);",
    "}",
    "",
    "float smith(float nv, float nl, float a) {",
    "    float k = a * 0.5;",
    "    return (nv / (nv * (1.0 - k) + k)) * (nl / (nl * (1.0 - k) + k));",
    "}",
    "",
    "float3 fresnel(float3 f0, float vh) {",
    "    return f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);",
    "}",
    "",
    "// Light arriving from direction l (to the light) with radiance c.",
    "float3 brdf(float3 albedo, float3 f0, float rough, float3 n, float3 v, float3 l, float3 c) {",
    "    float nl = saturate(dot(n, l));",
    "    if (nl <= 0.0) {",
    "        return float3(0.0);",
    "    }",
    "    float3 h = normalize(l + v);",
    "    float nv = max(dot(n, v), 0.001);",
    "    float a = max(rough * rough, 0.002);",
    "    float3 F = fresnel(f0, saturate(dot(v, h)));",
    "    float3 spec = F * ggx(saturate(dot(n, h)), a) * smith(nv, nl, a) / (4.0 * nv * nl + 0.0001);",
    "    float3 diff = (1.0 - F) * albedo / PI;",
    "    return (diff + spec) * c * nl;",
    "}",
    "",
    "// The room as reflected: dark, with the backbox's lights over the far end",
    "// and a soft light over the player.",
    "float3 env(float3 r, float rough) {",
    "    float up = r.z;",
    "    float3 c = mix(float3(0.006, 0.006, 0.008), float3(0.025, 0.022, 0.026), saturate(up * 0.5 + 0.5));",
    "    float w = 0.03 + rough * 0.5;",
    "    float box = smoothstep(1.0 - w - 0.04, 1.0 - w * 0.4, dot(r, normalize(float3(0.0, 0.62, 0.78))));",
    "    c += float3(1.0, 0.88, 0.7) * box * (0.9 - rough * 0.6);",
    "    float strip = smoothstep(0.96 - rough * 0.5, 0.998 - rough * 0.3, dot(r, normalize(float3(0.0, -0.25, 1.0))));",
    "    c += float3(0.7, 0.8, 1.0) * strip * (0.3 - rough * 0.2);",
    "    float side = smoothstep(0.9 - rough, 1.0 - rough * 0.4, abs(r.x)) * saturate(r.z * 2.0 + 0.3);",
    "    c += float3(0.35, 0.3, 0.6) * side * 0.15;",
    "    return c;",
    "}",
    "",
    "// The split-sum's scale and bias for reflections (Karis' fit).",
    "float3 env_brdf(float3 f0, float rough, float nv) {",
    "    float4 c0 = float4(-1.0, -0.0275, -0.572, 0.022);",
    "    float4 c1 = float4(1.0, 0.0425, 1.04, -0.04);",
    "    float4 r = rough * c0 + c1;",
    "    float a004 = min(r.x * r.x, exp2(-9.28 * nv)) * r.x + r.y;",
    "    float2 ab = float2(-1.04, 1.04) * a004 + r.zw;",
    "    return f0 * ab.x + ab.y;",
    "}",
    "",
    "float shadow(constant Frame& f, depth2d<float> map, sampler cmp, float3 w, float3 n) {",
    "    float4 p = f.shadowvp * float4(w + n * 0.0015, 1.0);",
    "    float2 uv = float2(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);",
    "    if (uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0 || p.z > 1.0) {",
    "        return 1.0;",
    "    }",
    "    float t = f.key.w;",
    "    float s = 0.0;",
    "    const float2 taps[8] = { float2(-0.94, -0.4), float2(0.95, -0.77), float2(-0.09, -0.93), float2(0.34, 0.29),",
    "                             float2(-0.92, 0.46), float2(0.54, 0.86), float2(-0.27, 0.95), float2(0.79, 0.02) };",
    "    for (int k = 0; k < 8; k++) {",
    "        s += map.sample_compare(cmp, uv + taps[k] * t * 1.6, p.z);",
    "    }",
    "    return s / 8.0;",
    "}",
    "",
    "// How much of the sky the balls hide from a point (contact shadows).",
    "float ball_ao(constant Frame& f, float3 w, float3 n) {",
    "    float ao = 1.0;",
    "    for (int k = 0; k < 6; k++) {",
    "        float r = f.balls[k].w;",
    "        if (r <= 0.0) {",
    "            continue;",
    "        }",
    "        float3 d = f.balls[k].xyz - w;",
    "        float l = length(d);",
    "        if (l < r * 0.5) {",
    "            continue;",
    "        }",
    "        float c = saturate(dot(n, d / l) * 0.8 + 0.2);",
    "        ao *= 1.0 - saturate(c * (r * r) / (l * l)) * 0.92;",
    "    }",
    "    return ao;",
    "}",
    "",
    "// Point lights, the key light and the room: what a surface sends to the eye.",
    "float3 lighting(constant Frame& f, depth2d<float> map, sampler cmp, float3 w, float3 n, float3 v, float3 albedo,",
    "                float3 f0, float rough, float ao, bool shadowed) {",
    "    float3 l = -f.key.xyz;",
    "    float sh = shadowed ? shadow(f, map, cmp, w, n) : 1.0;",
    "    float3 c = brdf(albedo, f0, rough, n, v, l, f.keycol.rgb * sh);",
    "    int count = int(f.counts.x);",
    "    for (int k = 0; k < count; k++) {",
    "        float3 d = f.lpos[k].xyz - w;",
    "        float dist = length(d);",
    "        float rad = f.lpos[k].w;",
    "        float win = saturate(1.0 - pow(dist / rad, 4.0));",
    "        // (the bulbs are a few centimetres across: softened close up)",
    "        float att = win * win / (dist * dist + 0.0016);",
    "        c += brdf(albedo, f0, max(rough, 0.2), n, v, d / dist, f.lcol[k].rgb * att);",
    "    }",
    "    float nv = saturate(dot(n, v));",
    "    float3 amb = albedo * f.keycol.w * (0.55 + 0.45 * saturate(n.z)) * f.counts.y;",
    "    float3 refl = env(reflect(-v, n), rough) * env_brdf(f0, rough, nv) * f.counts.y * (1.0 - 0.6 * saturate(rough * 2.0 - 0.3));",
    "    return (c * ao + (amb + refl) * ao * ao);",
    "}",
    "",
    "// --- the playfield's inserts ----------------------------------------------",
    "",
    "float sd_triangle(float2 p, float s) {",
    "    // an arrow pointing +x, s long",
    "    float2 a = float2(s, 0.0);",
    "    float2 b = float2(-s * 0.7, s * 0.62);",
    "    float2 c = float2(-s * 0.7, -s * 0.62);",
    "    float2 e0 = b - a, e1 = c - b, e2 = a - c;",
    "    float2 v0 = p - a, v1 = p - b, v2 = p - c;",
    "    float2 pq0 = v0 - e0 * saturate(dot(v0, e0) / dot(e0, e0));",
    "    float2 pq1 = v1 - e1 * saturate(dot(v1, e1) / dot(e1, e1));",
    "    float2 pq2 = v2 - e2 * saturate(dot(v2, e2) / dot(e2, e2));",
    "    float s2 = sign(e0.x * e2.y - e0.y * e2.x);",
    "    float2 d = min(min(float2(dot(pq0, pq0), s2 * (v0.x * e0.y - v0.y * e0.x)),",
    "                       float2(dot(pq1, pq1), s2 * (v1.x * e1.y - v1.y * e1.x))),",
    "                   float2(dot(pq2, pq2), s2 * (v2.x * e2.y - v2.y * e2.x)));",
    "    return -sqrt(d.x) * sign(d.y);",
    "}",
    "",
    "float insert_sd(constant Frame& f, int k, float2 p) {",
    "    float4 a = f.ins_a[k];",
    "    float2 d = p - a.xy;",
    "    float c = cos(a.w), s = sin(a.w);",
    "    d = float2(d.x * c + d.y * s, -d.x * s + d.y * c);",
    "    float shape = f.ins_b[k].w;",
    "    if (shape < 0.5) {",
    "        return length(d) - a.z;",
    "    }",
    "    if (shape < 1.5) {",
    "        return sd_triangle(d, a.z) - 0.0015;",
    "    }",
    "    float2 q = abs(d) - float2(a.z, a.z * 0.38);",
    "    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - 0.002;",
    "}",
    "",
    "// The inserts' light at p: emitted (inside), and how much p is an insert.",
    "float3 inserts(constant Frame& f, float2 p, thread float& inside) {",
    "    float3 e = float3(0.0);",
    "    inside = 0.0;",
    "    for (int k = 0; k < 24; k++) {",
    "        float4 a = f.ins_a[k];",
    "        if (a.z <= 0.0 || abs(p.x - a.x) > a.z * 4.0 || abs(p.y - a.y) > a.z * 4.0) {",
    "            continue;",
    "        }",
    "        float d = insert_sd(f, k, p);",
    "        float in = smoothstep(0.0006, -0.0006, d);",
    "        float on = lamp(f, k);",
    "        float3 col = f.ins_b[k].rgb;",
    "        // brightest at the bulb, under the middle",
    "        float core = saturate(-d / a.z);",
    "        e += col * on * in * (1.2 + 3.5 * core * core);",
    "        // light leaking round the edge into the paint",
    "        e += col * on * (1.0 - in) * 0.35 * exp(-max(d, 0.0) / 0.004);",
    "        inside = max(inside, in);",
    "    }",
    "    return e;",
    "}",
    "",
    "float2 art_uv(constant Frame& f, float2 p) {",
    "    return float2((p.x - f.table.x) / f.table.z, 1.0 - (p.y - f.table.y) / f.table.w);",
    "}",
    "",
    "// --- the solid things ------------------------------------------------------",
    "",
    "fragment float4 ps(VOut i [[stage_in]], constant Draw& d [[buffer(0)]], constant Frame& f [[buffer(1)]],",
    "                   depth2d<float> map [[texture(0)]], texture2d<float> art [[texture(1)]],",
    "                   sampler cmp [[sampler(1)]]) {",
    "    float3 n = normalize(i.n);",
    "    float3 v = normalize(f.eye.xyz - i.w);",
    "    if (dot(n, v) < 0.0) {",
    "        n = -n;  // (two-sided)",
    "    }",
    "    int mat = int(i.col.a + 0.5);",
    "    float rough = d.extra.w >= 0.0 ? d.extra.w : (i.uv.y > 0.0 ? i.uv.y : 0.4);",
    "    float3 albedo = i.col.rgb;",
    "    float3 f0 = float3(0.04);",
    "    float3 glow = float3(0.0);",
    "    float ao = ball_ao(f, i.w, n);",
    "    float on = lamp(f, int(d.extra.x));",
    "    if (mat == 1) {",
    "        // the playfield: painted wood under clear lacquer, and the inserts",
    "        float2 uv = art_uv(f, i.w.xy);",
    "        albedo = art.sample(aniso, uv).rgb;",
    "        float inside;",
    "        glow = inserts(f, i.w.xy, inside);",
    "        albedo = mix(albedo, albedo * 0.6, inside);",
    "        rough = mix(0.22, 0.1, inside);",
    "        // a faint grain and wear where balls roll",
    "        float wear = noise(i.w.xy * float2(900.0, 300.0)) * 0.06;",
    "        rough += wear;",
    "        f0 = float3(0.045);",
    "    } else if (mat == 2) {",
    "        // polished metal",
    "        f0 = albedo;",
    "        albedo = float3(0.0);",
    "        rough = d.extra.w >= 0.0 ? d.extra.w : 0.18;",
    "    } else if (mat == 3) {",
    "        rough = 0.62;",
    "        f0 = float3(0.03);",
    "    } else if (mat == 5) {",
    "        // wood: grain along y, varnished",
    "        float g = noise(float2(i.w.x * 40.0 + i.w.z * 40.0, i.w.y * 2.0));",
    "        float rings = 0.5 + 0.5 * sin((i.w.x + i.w.z) * 600.0 + g * 6.0);",
    "        albedo *= 0.7 + 0.3 * rings * (0.7 + 0.3 * g);",
    "        rough = 0.35;",
    "    } else if (mat == 6) {",
    "        // a lamp's bulb or lens",
    "        float3 e = albedo * (0.05 + on * d.extra.y);",
    "        return float4(e, 1.0);",
    "    } else if (mat == 7) {",
    "        // coloured plastic, lit from inside when its lamp is",
    "        glow = albedo * on * d.extra.y;",
    "        rough = 0.12;",
    "        f0 = float3(0.05);",
    "    }",
    "    float3 c = lighting(f, map, cmp, i.w, n, v, albedo, f0, rough, ao, true);",
    "    c += glow;",
    "    return float4(c, 1.0);",
    "}",
    "",
    "// Clear plastic (the ramp), over everything solid.",
    "fragment float4 ps_clear(VOut i [[stage_in]], constant Draw& d [[buffer(0)]], constant Frame& f [[buffer(1)]],",
    "                         depth2d<float> map [[texture(0)]], sampler cmp [[sampler(1)]]) {",
    "    float3 n = normalize(i.n);",
    "    float3 v = normalize(f.eye.xyz - i.w);",
    "    if (dot(n, v) < 0.0) {",
    "        n = -n;",
    "    }",
    "    float nv = saturate(dot(n, v));",
    "    float fr = 0.04 + 0.96 * pow(1.0 - nv, 5.0);",
    "    float3 refl = env(reflect(-v, n), 0.05) * fr * f.counts.y;",
    "    float3 l = -f.key.xyz;",
    "    float3 h = normalize(l + v);",
    "    float spec = ggx(saturate(dot(n, h)), 0.01) * 0.02 * shadow(f, map, cmp, i.w, n);",
    "    float3 c = refl + f.keycol.rgb * spec * saturate(dot(n, l));",
    "    int count = int(f.counts.x);",
    "    for (int k = 0; k < count; k++) {",
    "        float3 dd = f.lpos[k].xyz - i.w;",
    "        float dist = length(dd);",
    "        float win = saturate(1.0 - dist / f.lpos[k].w);",
    "        float3 hh = normalize(dd / dist + v);",
    "        c += f.lcol[k].rgb * win * win * ggx(saturate(dot(n, hh)), 0.02) * 0.0004 / (dist * dist + 0.0004);",
    "    }",
    "    float a = saturate(d.tint.a * (0.12 + 0.88 * fr) + length(c) * 0.3);",
    "    return float4(c + i.col.rgb * 0.02 * f.counts.y, a);",
    "}",
    "",
    "// --- the ball ------------------------------------------------------------------",
    "",
    "// What the ball sees of the playfield at p (lit roughly as the playfield is).",
    "float3 playfield_seen(constant Frame& f, texture2d<float> art, float2 p) {",
    "    if (abs(p.x) > 0.272 || p.y < -0.02 || p.y > 1.06) {",
    "        return float3(0.012, 0.01, 0.01);",
    "    }",
    "    float inside;",
    "    float3 glow = inserts(f, p, inside);",
    "    float3 albedo = art.sample(aniso, art_uv(f, p), level(2.0)).rgb;",
    "    float3 lit = albedo * (f.keycol.rgb * saturate(-f.key.z) * 0.6 + f.keycol.w * f.counts.y);",
    "    for (int k = 0; k < int(f.counts.x); k++) {",
    "        float3 d = f.lpos[k].xyz - float3(p, 0.0);",
    "        float dist = length(d);",
    "        float win = saturate(1.0 - dist / f.lpos[k].w);",
    "        lit += albedo * f.lcol[k].rgb * win * win * saturate(d.z / dist) * 0.5 / (dist * dist + 0.0004);",
    "    }",
    "    return lit + glow;",
    "}",
    "",
    "fragment float4 ps_ball(VOut i [[stage_in]], constant Draw& d [[buffer(0)]], constant Frame& f [[buffer(1)]],",
    "                        depth2d<float> map [[texture(0)]], texture2d<float> art [[texture(1)]],",
    "                        sampler cmp [[sampler(1)]]) {",
    "    float3 n = normalize(i.n);",
    "    float3 v = normalize(f.eye.xyz - i.w);",
    "    float3 r = reflect(-v, n);",
    "    float3 seen;",
    "    if (r.z < 0.0) {",
    "        // the playfield, reflected: where the ray from here meets it",
    "        float t = -i.w.z / r.z;",
    "        float3 p = i.w + r * t;",
    "        seen = playfield_seen(f, art, p.xy) * 1.4;",
    "        // softened toward the horizon",
    "        seen = mix(env(r, 0.2) * 0.5, seen, smoothstep(0.0, 0.25, -r.z));",
    "    } else {",
    "        seen = env(r, 0.02) * f.counts.y * 3.0;",
    "    }",
    "    // other balls hide what is behind them",
    "    for (int k = 0; k < 6; k++) {",
    "        float rad = f.balls[k].w;",
    "        float3 oc = i.w - f.balls[k].xyz;",
    "        if (rad <= 0.0 || dot(oc, oc) < rad * rad * 1.5) {",
    "            continue;",
    "        }",
    "        float b = dot(oc, r);",
    "        float c = dot(oc, oc) - rad * rad;",
    "        if (b < 0.0 && b * b - c > 0.0) {",
    "            seen *= 0.25;",
    "        }",
    "    }",
    "    float nv = saturate(dot(n, v));",
    "    float3 f0 = float3(0.78, 0.78, 0.8);",
    "    float3 fr = f0 + (1.0 - f0) * pow(1.0 - nv, 5.0);",
    "    float3 c = seen * fr;",
    "    // highlights: the key light and the lamps, nearly mirror-sharp",
    "    float sh = shadow(f, map, cmp, i.w, n);",
    "    c += brdf(float3(0.0), f0, 0.08, n, v, -f.key.xyz, f.keycol.rgb * sh);",
    "    for (int k = 0; k < int(f.counts.x); k++) {",
    "        float3 dd = f.lpos[k].xyz - i.w;",
    "        float dist = length(dd);",
    "        float win = saturate(1.0 - pow(dist / f.lpos[k].w, 4.0));",
    "        c += brdf(float3(0.0), f0, 0.1, n, v, dd / dist, f.lcol[k].rgb * win * win / (dist * dist + 0.0004));",
    "    }",
    "    // a little dirt and scuffing, turning with the ball (uv: its own surface)",
    "    float scuff = noise(i.uv * 60.0) * noise(i.uv * 7.0);",
    "    c *= 0.93 + 0.07 * scuff;",
    "    return float4(c, 1.0);",
    "}",
    "",
    "// --- glows ---------------------------------------------------------------------",
    "",
    "struct GOut {",
    "    float4 pos [[position]];",
    "    float2 uv;",
    "};",
    "",
    "// A camera-facing quad about m0.xyz, m0.w across; tint is its light.",
    "vertex GOut vs_glow(VIn i [[stage_in]], constant Draw& d [[buffer(0)]], constant Frame& f [[buffer(1)]]) {",
    "    float3 c = d.m0.xyz;",
    "    float3 fwd = normalize(c - f.eye.xyz);",
    "    float3 right = normalize(cross(fwd, float3(0.0, 0.0, 1.0)));",
    "    float3 up = cross(right, fwd);",
    "    float3 w = c + (right * i.pos.x + up * i.pos.y) * d.m0.w;",
    "    GOut o;",
    "    o.pos = f.viewproj * float4(w, 1.0);",
    "    // pulled toward the eye, so that it is not cut by what it sits on",
    "    o.pos.z -= 0.002 * o.pos.w;",
    "    o.uv = i.pos.xy;",
    "    return o;",
    "}",
    "",
    "fragment float4 ps_glow(GOut i [[stage_in]], constant Draw& d [[buffer(0)]]) {",
    "    float r = length(i.uv);",
    "    float k = saturate(1.0 - r);",
    "    float g = k * k * 0.6 + pow(k, 12.0) * 2.0;",
    "    return float4(d.tint.rgb * g * d.tint.a, 1.0);",
    "}",
    "",
    "// --- post-processing -------------------------------------------------------------",
    "",
    "struct FOut {",
    "    float4 pos [[position]];",
    "    float2 uv;",
    "};",
    "",
    "vertex FOut vs_full(uint id [[vertex_id]]) {",
    "    float2 p = float2((id << 1) & 2, id & 2);",
    "    FOut o;",
    "    o.pos = float4(p * 2.0 - 1.0, 0.0, 1.0);",
    "    o.uv = float2(p.x, 1.0 - p.y);",
    "    return o;",
    "}",
    "",
    "// The bright parts, at half size.",
    "fragment float4 ps_bright(FOut i [[stage_in]], constant Draw& d [[buffer(0)]], texture2d<float> src [[texture(0)]]) {",
    "    float2 t = d.extra.xy;",
    "    float3 c = src.sample(lin, i.uv + float2(-t.x, -t.y)).rgb + src.sample(lin, i.uv + float2(t.x, -t.y)).rgb +",
    "               src.sample(lin, i.uv + float2(-t.x, t.y)).rgb + src.sample(lin, i.uv + float2(t.x, t.y)).rgb;",
    "    c *= 0.25;",
    "    // (pinpoint highlights clamped, so that they do not bloom into blobs)",
    "    float peak = max(c.r, max(c.g, c.b));",
    "    c *= min(1.0, 5.0 / max(peak, 0.0001));",
    "    float b = max(c.r, max(c.g, c.b));",
    "    float k = saturate((b - d.tint.x) / max(b, 0.0001));",
    "    return float4(c * k, 1.0);",
    "}",
    "",
    "// A Gaussian blur along extra.xy (texels).",
    "fragment float4 ps_blur(FOut i [[stage_in]], constant Draw& d [[buffer(0)]], texture2d<float> src [[texture(0)]]) {",
    "    const float w[5] = { 0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216 };",
    "    float2 s = d.extra.xy;",
    "    float3 c = src.sample(lin, i.uv).rgb * w[0];",
    "    for (int k = 1; k < 5; k++) {",
    "        c += src.sample(lin, i.uv + s * float(k) * 1.4).rgb * w[k];",
    "        c += src.sample(lin, i.uv - s * float(k) * 1.4).rgb * w[k];",
    "    }",
    "    return float4(c, 1.0);",
    "}",
    "",
    "float3 aces(float3 x) {",
    "    return saturate((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14));",
    "}",
    "",
    "// The scene and its blooms, exposed and tone-mapped, into the window.",
    "fragment float4 ps_final(FOut i [[stage_in]], constant Draw& d [[buffer(0)]], constant Frame& f [[buffer(1)]],",
    "                         texture2d<float> hdr [[texture(0)]], texture2d<float> b1 [[texture(1)]],",
    "                         texture2d<float> b2 [[texture(2)]]) {",
    "    float3 c = hdr.sample(lin, i.uv).rgb;",
    "    float3 bloom = b1.sample(lin, i.uv).rgb * 0.7 + b2.sample(lin, i.uv).rgb * 0.5;",
    "    c += bloom * f.screen.z;",
    "    c *= f.counts.z;",
    "    c += f.counts.w * float3(1.0, 0.95, 0.85) * 0.25;  // a flash",
    "    c = aces(c);",
    "    float2 q = i.uv - 0.5;",
    "    c *= 1.0 - dot(q, q) * 0.55;  // vignette",
    "    c = pow(c, float3(1.0 / 2.2));",
    "    c += (hash(i.uv * f.screen.xy + f.eye.w) - 0.5) / 255.0;  // dither",
    "    return float4(c, 1.0);",
    "}",
    "",
    "// --- the dot-matrix display ---------------------------------------------------------",
    "",
    "struct DOut {",
    "    float4 pos [[position]];",
    "    float2 uv;",
    "};",
    "",
    "// A quad on the screen: extra.xy its top left, extra.zw its size (clip space).",
    "vertex DOut vs_dmd(uint id [[vertex_id]], constant Draw& d [[buffer(0)]]) {",
    "    float2 p = float2(id == 1 || id == 2 || id == 4 ? 1.0 : 0.0, id == 2 || id == 4 || id == 5 ? 1.0 : 0.0);",
    "    DOut o;",
    "    o.pos = float4(d.extra.x + p.x * d.extra.z, d.extra.y - p.y * d.extra.w, 0.0, 1.0);",
    "    o.uv = p;",
    "    return o;",
    "}",
    "",
    "// 128 x 32 dots of 16 levels, eight to a word (buffer 2).",
    "fragment float4 ps_dmd(DOut i [[stage_in]], constant Draw& d [[buffer(0)]], constant uint* dots [[buffer(2)]]) {",
    "    float2 frame = float2(0.03, 0.1);",
    "    float2 uv = (i.uv - frame * 0.5) / (1.0 - frame);",
    "    if (uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0) {",
    "        // the bezel",
    "        float e = min(min(i.uv.x, 1.0 - i.uv.x) * 30.0, min(i.uv.y, 1.0 - i.uv.y) * 8.0);",
    "        return float4(float3(0.03, 0.03, 0.035) + 0.04 * saturate(1.0 - e), 0.96);",
    "    }",
    "    float2 g = uv * float2(128.0, 32.0);",
    "    int2 cell = int2(g);",
    "    int k = cell.y * 128 + cell.x;",
    "    uint word = dots[k >> 3];",
    "    float level = float((word >> ((k & 7) * 4)) & 15u) / 15.0;",
    "    float2 f = fract(g) - 0.5;",
    "    float dot_ = smoothstep(0.42, 0.28, length(f));",
    "    float3 orange = float3(1.0, 0.42, 0.08);",
    "    float3 c = orange * (0.035 + level * 1.4) * dot_;",
    "    // the glass's glow round lit dots",
    "    c += orange * level * 0.12;",
    "    return float4(c * d.tint.rgb + float3(0.012, 0.01, 0.01), 0.98);",
    "}"
];
