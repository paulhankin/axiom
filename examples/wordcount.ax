// =============================================================================
// File: wordcount.ax
// Counts word frequencies on stdin and prints the most common words.
//
//   axiom build examples/wordcount.ax -O2 -o wc.wasm
//   node std/internal/runtime/host.mjs wc.wasm < some.txt   (or --target=native)
// =============================================================================

import "std/collections/map" as map;
import "std/collections/vec" as vec;
import "std/hash" as hash;
import "std/io" as io;
import "std/mem" as mem;

struct Entry {
    word: []u8,
    count: u32,
}

fn more_frequent(a: Entry, b: Entry) bool {
    // (ties in word order: the map's order changes from run to run)
    if a.count != b.count {
        return a.count > b.count;
    }
    let n = @min(a.word.len, b.word.len);
    for i in 0..n {
        if a.word[i] != b.word[i] {
            return a.word[i] < b.word[i];
        }
    }
    return a.word.len < b.word.len;
}

fn is_letter(c: u8) bool {
    return ((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z'));
}

fn lower(c: u8) u8 {
    if (c >= 'A') and (c <= 'Z') {
        return c + 32;
    }
    return c;
}

fn count_words() !void {
    let text = io.stdin().read_all()!;
    defer mem.free(text);
    for i in 0..text.len {
        text[i] = lower(text[i]);
    }

    let mut counts = map.Map.[[]u8, u32].init(hash.hash_bytes, hash.eq_bytes);
    defer counts.deinit();
    let mut start: usize = 0;
    for i in 0..text.len + 1 {
        let boundary = (i == text.len) or not is_letter(text[i]);
        if boundary {
            if i > start {
                let w = text[start..i];
                let c = counts.get(w) catch 0;
                counts.put(w, c + 1)!;
            }
            start = i + 1;
        }
    }

    let mut entries = vec.Vec.[Entry].init();
    defer entries.deinit();
    let mut it = counts.iter();
    let mut w: []u8 = "";
    let mut c: u32 = 0;
    while it.next(&mut w, &mut c) {
        entries.push(Entry.{ word: w, count: c })!;
    }
    entries.sort(more_frequent);

    let mut out = io.BufWriter.init(io.stdout());
    let o = out.writer();
    let shown = @min(entries.len, 10);
    for i in 0..shown {
        let e = entries.get(i);
        o.print_u64(@as(u64, e.count))!;
        o.print(" ")!;
        o.println(e.word)!;
    }
    o.print_u64(@as(u64, counts.len()))!;
    o.println(" distinct words")!;
    out.flush()!;
}

export fn main() i32 {
    count_words() catch |e| {
        io.stderr().println(@error_name(e)) catch {};
        return 1;
    };
    return 0;
}
