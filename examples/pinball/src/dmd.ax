// =============================================================================
// File: dmd.ax
// The dot-matrix display: 128 x 32 dots of 16 levels, written with a 5 x 7
// font (and the same doubled, for scores), then packed eight dots to a
// word for the shader.
// =============================================================================

pub const W: usize = 128;
pub const H: usize = 32;

// The font: 5 x 7, a row to a byte (bit 4 the left column), for ' ' to 'Z'.
let FONT: [59][7]u8 = [
    [0, 0, 0, 0, 0, 0, 0],         // ' '
    [4, 4, 4, 4, 4, 0, 4],         // !
    [10, 10, 0, 0, 0, 0, 0],       // "
    [10, 31, 10, 10, 10, 31, 10],  // #
    [4, 15, 20, 14, 5, 30, 4],     // $
    [24, 25, 2, 4, 8, 19, 3],      // %
    [8, 20, 20, 8, 21, 18, 13],    // &
    [4, 4, 0, 0, 0, 0, 0],         // '
    [2, 4, 8, 8, 8, 4, 2],         // (
    [8, 4, 2, 2, 2, 4, 8],         // )
    [0, 4, 21, 14, 21, 4, 0],      // *
    [0, 4, 4, 31, 4, 4, 0],        // +
    [0, 0, 0, 0, 0, 4, 8],         // ,
    [0, 0, 0, 31, 0, 0, 0],        // -
    [0, 0, 0, 0, 0, 0, 4],         // .
    [1, 1, 2, 4, 8, 16, 16],       // /
    [14, 17, 19, 21, 25, 17, 14],  // 0
    [4, 12, 4, 4, 4, 4, 14],       // 1
    [14, 17, 1, 2, 4, 8, 31],      // 2
    [31, 2, 4, 2, 1, 17, 14],      // 3
    [2, 6, 10, 18, 31, 2, 2],      // 4
    [31, 16, 30, 1, 1, 17, 14],    // 5
    [6, 8, 16, 30, 17, 17, 14],    // 6
    [31, 1, 2, 4, 8, 8, 8],        // 7
    [14, 17, 17, 14, 17, 17, 14],  // 8
    [14, 17, 17, 15, 1, 2, 12],    // 9
    [0, 0, 4, 0, 0, 4, 0],         // :
    [0, 0, 4, 0, 0, 4, 8],         // ;
    [2, 4, 8, 16, 8, 4, 2],        // <
    [0, 0, 31, 0, 31, 0, 0],       // =
    [8, 4, 2, 1, 2, 4, 8],         // >
    [14, 17, 1, 2, 4, 0, 4],       // ?
    [14, 17, 1, 13, 21, 21, 14],   // @
    [14, 17, 17, 31, 17, 17, 17],  // A
    [30, 17, 17, 30, 17, 17, 30],  // B
    [14, 17, 16, 16, 16, 17, 14],  // C
    [28, 18, 17, 17, 17, 18, 28],  // D
    [31, 16, 16, 30, 16, 16, 31],  // E
    [31, 16, 16, 30, 16, 16, 16],  // F
    [14, 17, 16, 23, 17, 17, 15],  // G
    [17, 17, 17, 31, 17, 17, 17],  // H
    [14, 4, 4, 4, 4, 4, 14],       // I
    [7, 2, 2, 2, 2, 18, 12],       // J
    [17, 18, 20, 24, 20, 18, 17],  // K
    [16, 16, 16, 16, 16, 16, 31],  // L
    [17, 27, 21, 21, 17, 17, 17],  // M
    [17, 17, 25, 21, 19, 17, 17],  // N
    [14, 17, 17, 17, 17, 17, 14],  // O
    [30, 17, 17, 30, 16, 16, 16],  // P
    [14, 17, 17, 17, 21, 18, 13],  // Q
    [30, 17, 17, 30, 20, 18, 17],  // R
    [15, 16, 16, 14, 1, 1, 30],    // S
    [31, 4, 4, 4, 4, 4, 4],        // T
    [17, 17, 17, 17, 17, 17, 14],  // U
    [17, 17, 17, 17, 17, 10, 4],   // V
    [17, 17, 17, 21, 21, 21, 10],  // W
    [17, 17, 10, 4, 10, 17, 17],   // X
    [17, 17, 10, 4, 4, 4, 4],      // Y
    [31, 1, 2, 4, 8, 16, 31],      // Z
];

pub struct Dots {
    px: [4096]u8,

    pub fn init() Dots {
        return Dots.{ px: [0; 4096] };
    }

    pub fn clear(self: *mut Dots) void {
        @mem_set(self.px[..], 0);
    }

    pub fn set(self: *mut Dots, x: i32, y: i32, level: u8) void {
        if (x < 0) or (y < 0) or (x >= 128) or (y >= 32) {
            return;
        }
        let i = (@int_cast(usize, y) * W) + @int_cast(usize, x);
        if level > self.px[i] {
            self.px[i] = level;
        }
    }

    pub fn rect(self: *mut Dots, x: i32, y: i32, w: i32, h: i32, level: u8) void {
        for yy in y..(y + h) {
            for xx in x..(x + w) {
                self.set(xx, yy, level);
            }
        }
    }

    /// Text at (x, y), each dot of the font sx x sy dots.
    pub fn text(self: *mut Dots, s: []u8, x: i32, y: i32, sx: i32, sy: i32, level: u8) void {
        let mut cx = x;
        for ch in s {
            let mut c = ch;
            if (c >= 'a') and (c <= 'z') {
                c -= 32;
            }
            if (c < ' ') or (c > 'Z') {
                c = '?';
            }
            let g = FONT[@as(usize, c - ' ')];
            for row in @as(usize, 0)..7 {
                for col in @as(usize, 0)..5 {
                    if ((g[row] >> @truncate(u8, 4 - col)) & 1) != 0 {
                        self.rect(cx + (@int_cast(i32, col) * sx), y + (@int_cast(i32, row) * sy), sx, sy, level);
                    }
                }
            }
            cx += 6 * sx;
        }
    }

    /// Text centred across the display.
    pub fn centre(self: *mut Dots, s: []u8, y: i32, sx: i32, sy: i32, level: u8) void {
        let w = ((@int_cast(i32, s.len) * 6) - 1) * sx;
        self.text(s, (128 - w) / 2, y, sx, sy, level);
    }

    /// Packed for the shader: eight dots to a word, four bits each.
    pub fn pack(self: *Dots, out: *mut [512]u32) void {
        for k in @as(usize, 0)..512 {
            let mut word: u32 = 0;
            for j in @as(usize, 0)..8 {
                word = word | (@as(u32, self.px[(k * 8) + j] & 15) << @truncate(u32, j * 4));
            }
            out[k] = word;
        }
    }
}

/// n with commas: 1,234,567.
pub fn commas(n: u64, buf: []mut u8) []u8 {
    let mut digits: [24]u8 = [0; 24];
    let mut k: usize = 0;
    let mut x = n;
    loop {
        digits[k] = @truncate(u8, x % 10) + '0';
        k += 1;
        x /= 10;
        if x == 0 {
            break;
        }
    }
    let mut j: usize = 0;
    while k > 0 {
        k -= 1;
        buf[j] = digits[k];
        j += 1;
        if (k > 0) and ((k % 3) == 0) {
            buf[j] = ',';
            j += 1;
        }
    }
    return buf[..j];
}
