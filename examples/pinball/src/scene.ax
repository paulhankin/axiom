// =============================================================================
// File: scene.ax
// The table as meshes: one that never moves (the playfield, the cabinet,
// walls and guides, posts with their rubber rings, the slingshots, the
// habitrail's wires and brackets, the bumpers' bodies, lane guides, the
// apron), the clear ramp (drawn after the rest, see-through), the bulbs of
// the general illumination, and the parts that move or light up, each
// drawn with its own transform: flippers, the bumpers' caps, drop and
// standup targets, the gate, the spinner, the plunger, the flashers' domes
// and the ball.
// =============================================================================

import "mesh.ax" as mesh;
import "physics.ax" as ph;
import "std/math" as math;
import "table.ax" as tb;
import "v3.ax" as vm;

/// A range of a mesh's indexes.
pub struct Part {
    first: u32,
    count: u32,
}

pub const P_FLIPPER: usize = 0;
pub const P_CAP: usize = 1;
pub const P_DROP: usize = 2;
pub const P_STANDUP: usize = 3;
pub const P_GATE: usize = 4;
pub const P_SPINNER: usize = 5;
pub const P_PLUNGER: usize = 6;
pub const P_BALL: usize = 7;
pub const P_FLASHER: usize = 8;
pub const P_SKIRT: usize = 9;
pub const PARTS: usize = 10;

/// Where the general illumination's bulbs are (also its lights).
pub const GI_N: usize = 14;
pub let GI: [14]vm.V3 = [vm.V3.{ x: -0.256, y: 0.56, z: 0.016 }, vm.V3.{ x: -0.256, y: 0.72, z: 0.016 },
                         vm.V3.{ x: -0.256, y: 0.88, z: 0.016 }, vm.V3.{ x: -0.205, y: 1.0, z: 0.016 },
                         vm.V3.{ x: -0.06, y: 1.035, z: 0.016 }, vm.V3.{ x: 0.08, y: 1.035, z: 0.016 },
                         vm.V3.{ x: 0.215, y: 0.99, z: 0.016 }, vm.V3.{ x: 0.218, y: 0.70, z: 0.016 },
                         vm.V3.{ x: -0.222, y: 0.42, z: 0.016 }, vm.V3.{ x: 0.222, y: 0.42, z: 0.016 },
                         vm.V3.{ x: -0.170, y: 0.37, z: 0.016 }, vm.V3.{ x: 0.170, y: 0.37, z: 0.016 },
                         vm.V3.{ x: -0.128, y: 0.205, z: 0.016 }, vm.V3.{ x: 0.128, y: 0.205, z: 0.016 }];

fn look(r: f32, g: f32, b: f32, mat: f32, rough: f32) mesh.Look {
    return mesh.look(r, g, b, mat, rough);
}

let BLACK: mesh.Look = mesh.Look.{ col: vm.V3.{ x: 0.025, y: 0.025, z: 0.03 }, mat: 0.0, rough: 0.35 };
let STEEL: mesh.Look = mesh.Look.{ col: vm.V3.{ x: 0.72, y: 0.73, z: 0.76 }, mat: 2.0, rough: 0.22 };
let CHROME: mesh.Look = mesh.Look.{ col: vm.V3.{ x: 0.93, y: 0.93, z: 0.95 }, mat: 2.0, rough: 0.07 };
let WHITE_RUBBER: mesh.Look = mesh.Look.{ col: vm.V3.{ x: 0.82, y: 0.82, z: 0.78 }, mat: 3.0, rough: 0.6 };
let BLACK_RUBBER: mesh.Look = mesh.Look.{ col: vm.V3.{ x: 0.035, y: 0.035, z: 0.035 }, mat: 3.0, rough: 0.6 };
let RAIL: mesh.Look = mesh.Look.{ col: vm.V3.{ x: 0.55, y: 0.56, z: 0.6 }, mat: 2.0, rough: 0.32 };
let CABINET: mesh.Look = mesh.Look.{ col: vm.V3.{ x: 0.30, y: 0.13, z: 0.05 }, mat: 5.0, rough: 0.35 };

/// Fills `m` with what never moves.
pub fn build_static(m: *mut mesh.Mesh, w: *ph.World, t: *tb.Table) !void {
    // the playfield
    let pf = look(1.0, 1.0, 1.0, mesh.PLAYFIELD, 0.2);
    m.quad(vm.v(-0.272, -0.03, 0.0), vm.v(0.272, -0.03, 0.0), vm.v(0.272, 1.062, 0.0), vm.v(-0.272, 1.062, 0.0), pf)!;
    cabinet(m)!;
    for f in w.fences.items() {
        fence(m, f)!;
    }
    slingshots(m)!;
    rail(m, t)!;
    ramp_parts(m, t)!;
    // the bumpers' bodies: a black base and a white column
    for b in t.bumpers {
        m.cylinder(b, b.add(vm.v(0.0, 0.0, 0.006)), 0.036, 32, true, BLACK)!;
        m.cylinder(b.add(vm.v(0.0, 0.0, 0.006)), b.add(vm.v(0.0, 0.0, 0.03)), 0.022, 32, false,
                   look(0.9, 0.9, 0.88, mesh.PAINT, 0.3))!;
    }
    // the saucer's rim
    m.torus(vm.v(tb.SAUCER.x, tb.SAUCER.y, 0.0), 0.0175, 0.0018, 32, 8, CHROME)!;
    // the plunger's housing and the shooter lane's floor guide
    m.box(vm.v(0.2405, -0.06, 0.0), vm.v(0.270, ph.PLUNGER_REST - ph.PLUNGER_PULL - 0.01, 0.022), 0.0, STEEL)!;
    // the apron, over the bottom of the playfield
    m.box(vm.v(-0.2375, -0.035, 0.0), vm.v(0.2375, 0.068, 0.014), 0.0, look(0.06, 0.06, 0.08, mesh.PAINT, 0.3))!;
    m.box(vm.v(-0.2375, 0.064, 0.0), vm.v(0.2375, 0.072, 0.02), 0.0, STEEL)!;
    // the bulbs' sockets
    for p in GI {
        m.cylinder(vm.v(p.x, p.y, 0.0), vm.v(p.x, p.y, 0.008), 0.004, 10, false, BLACK)!;
    }
}

fn cabinet(m: *mut mesh.Mesh) !void {
    // side walls (wood outside, black inside), the top, the front
    m.box(vm.v(-0.31, -0.07, -0.2), vm.v(-0.274, 1.12, 0.10), 0.0, CABINET)!;
    m.box(vm.v(0.274, -0.07, -0.2), vm.v(0.31, 1.12, 0.10), 0.0, CABINET)!;
    m.box(vm.v(-0.31, 1.062, -0.2), vm.v(0.31, 1.12, 0.10), 0.0, CABINET)!;
    m.box(vm.v(-0.31, -0.07, -0.2), vm.v(0.31, -0.03, 0.06), 0.0, CABINET)!;
    // the side rails and the lockdown bar
    m.box(vm.v(-0.316, -0.075, 0.10), vm.v(-0.268, 1.125, 0.112), 0.0, RAIL)!;
    m.box(vm.v(0.268, -0.075, 0.10), vm.v(0.316, 1.125, 0.112), 0.0, RAIL)!;
    m.box(vm.v(-0.316, 1.06, 0.10), vm.v(0.316, 1.125, 0.112), 0.0, RAIL)!;
    m.box(vm.v(-0.316, -0.09, 0.06), vm.v(0.316, -0.035, 0.085), 0.0, BLACK)!;
    // the backbox, standing behind the far end
    m.box(vm.v(-0.33, 1.12, -0.2), vm.v(0.33, 1.2, 0.75), 0.0, look(0.02, 0.02, 0.025, mesh.PAINT, 0.4))!;
    // a floor, far below
    m.quad(vm.v(-3.0, -3.0, -0.75), vm.v(3.0, -3.0, -0.75), vm.v(3.0, 3.0, -0.75), vm.v(-3.0, 3.0, -0.75),
           look(0.04, 0.035, 0.03, mesh.LAMP, 0.9))!;
}

fn fence(m: *mut mesh.Mesh, f: ph.Fence) !void {
    let s = f.style;
    if s == ph.S_WALL {
        m.slab(f.a, f.b, f.r, 0.0, f.z1, BLACK)!;
    } else if (s == ph.S_GUIDE) or (s == ph.S_LANE) {
        m.slab(f.a, f.b, f.r, 0.0, f.z1, STEEL)!;
    } else if s == ph.S_PLASTIC {
        m.slab(f.a, f.b, f.r, 0.0, f.z1, BLACK)!;
        mesh.tapered_slab(
            m, f.a, f.b, f.r + 0.004, f.r + 0.004, f.z1, f.z1 + 0.003, look(0.15, 0.55, 1.0, mesh.LIT, 0.12))!;
    } else if s == ph.S_POST {
        // a chrome post, its rubber ring, a star-shaped cap
        let base = f.a;
        m.cylinder(base, base.add(vm.v(0.0, 0.0, f.z1 + 0.006)), 0.0032, 12, true, CHROME)!;
        m.torus(base.add(vm.v(0.0, 0.0, 0.012)), f.r - 0.0026, 0.0026, 24, 8, WHITE_RUBBER)!;
        m.cone(base.add(vm.v(0.0, 0.0, f.z1)), base.add(vm.v(0.0, 0.0, f.z1 + 0.005)), 0.0065, 0.004, 5, true,
               look(1.0, 0.2, 0.3, mesh.PAINT, 0.15))!;
    } else if (s == ph.S_RUBBER) or (s == ph.S_SLING) {
        m.slab(f.a, f.b, 0.0028, 0.006, 0.019, WHITE_RUBBER)!;
    } else if s == ph.S_GATE {
        // its bracket: a wire across the lane
        m.cylinder(f.a.add(vm.v(0.0, 0.0, 0.03)), f.b.add(vm.v(0.0, 0.0, 0.03)), 0.0012, 8, false, CHROME)!;
    }
}

fn slingshots(m: *mut mesh.Mesh) !void {
    let sides: [2]f32 = [-1.0, 1.0];
    let colors: [2]vm.V3 = [vm.v(1.0, 0.25, 0.15), vm.v(0.15, 0.55, 1.0)];
    for k in @as(usize, 0)..2 {
        let s = sides[k];
        // the plastic over the slingshot: its triangle, grown a little
        let tri: [3]vm.V3 = [vm.v(s * 0.152, 0.345, 0.0), vm.v(s * 0.152, 0.255, 0.0), vm.v(s * 0.100, 0.215, 0.0)];
        let mid = tri[0].add(tri[1]).add(tri[2]).scale(1.0 / 3.0);
        let mut grown: [3]vm.V3 = [vm.zero(); 3];
        for i in @as(usize, 0)..3 {
            grown[i] = mid.add(tri[i].sub(mid).scale(1.28));
        }
        if s > 0.0 {
            // (anticlockwise)
            let tmp = grown[1];
            grown[1] = grown[2];
            grown[2] = tmp;
        }
        let c = colors[k];
        m.extrude(grown[..], 0.036, 0.039, false, true, look(c.x, c.y, c.z, mesh.LIT, 0.1))!;
        // the slingshot's kicker arm, under the plastic
        let a = vm.v(s * 0.141, 0.30, 0.0);
        let b = vm.v(s * 0.118, 0.255, 0.0);
        m.slab(a, b, 0.003, 0.004, 0.012, STEEL)!;
    }
}

fn rail(m: *mut mesh.Mesh, t: *tb.Table) !void {
    let lat = tb.RAIL_LAT;
    let rise = tb.RAIL_RISE;
    let mut prev: [6]vm.V3 = [vm.zero(); 6];
    for i in 0..tb.RAIL_N {
        let c = t.rail[i];
        let side = tb.across(t.rail[..], i);
        let mut cur: [6]vm.V3 = [vm.zero(); 6];
        for k in @as(usize, 0)..6 {
            cur[k] = c.add(side.scale(lat[k] * tb.wire_flare(k, i))).add(vm.v(0.0, 0.0, rise[k] * tb.wire_lift(k, i)));
        }
        if i > 0 {
            for k in @as(usize, 0)..6 {
                if (k >= 2) and (i <= 12) {
                    continue;
                }
                m.cylinder(prev[k], cur[k], 0.0012, 6, false, CHROME)!;
            }
        }
        // a bracket round the wires now and then, and a post down to the
        // playfield from some
        if (i > 12) and ((i % 14) == 6) and (i < (tb.RAIL_N - 2)) {
            let order: [6]usize = [0, 2, 4, 5, 3, 1];
            for k in @as(usize, 0)..6 {
                let a = cur[order[k]];
                let b = cur[order[(k + 1) % 6]];
                m.cylinder(a, b, 0.0011, 4, false, STEEL)!;
            }
            if (i % 28) == 6 {
                let foot = vm.v(cur[0].x, cur[0].y, 0.0);
                m.cylinder(foot, cur[0], 0.0018, 8, false, STEEL)!;
                m.cylinder(foot, foot.add(vm.v(0.0, 0.0, 0.004)), 0.004, 10, true, STEEL)!;
            }
        }
        prev = cur;
    }
}

fn ramp_parts(m: *mut mesh.Mesh, t: *tb.Table) !void {
    // the ramp's rims (along the tops of its walls), its flap, its legs
    let up = vm.v(0.0, 0.0, tb.RAMP_WALL);
    for i in 1..tb.RAMP_N {
        let a = t.ramp[i - 1];
        let b = t.ramp[i];
        let sa = tb.across(t.ramp[..], i - 1).scale(tb.ramp_half(i - 1));
        let sb = tb.across(t.ramp[..], i).scale(tb.ramp_half(i));
        m.cylinder(a.sub(sa).add(up), b.sub(sb).add(up), 0.0016, 6, false, look(1.0, 0.6, 0.1, mesh.PAINT, 0.2))!;
        m.cylinder(a.add(sa).add(up), b.add(sb).add(up), 0.0016, 6, false, look(1.0, 0.6, 0.1, mesh.PAINT, 0.2))!;
    }
    let a = t.ramp[0];
    let s0 = tb.across(t.ramp[..], 0).scale(tb.ramp_half(0));
    let b = t.ramp[3];
    let s3 = tb.across(t.ramp[..], 3).scale(tb.ramp_half(3));
    m.quad(a.sub(s0).add(vm.v(0.0, 0.0, 0.0005)), a.add(s0).add(vm.v(0.0, 0.0, 0.0005)),
           b.add(s3).add(vm.v(0.0, 0.0, 0.0005)), b.sub(s3).add(vm.v(0.0, 0.0, 0.0005)),
           look(0.12, 0.12, 0.14, mesh.PAINT, 0.5))!;
    let legs: [3]usize = [22, 34, 46];
    for i in legs {
        let p = t.ramp[i];
        let s = tb.across(t.ramp[..], i).scale(tb.ramp_half(i) + 0.003);
        let signs: [2]f32 = [-1.0, 1.0];
        for sign in signs {
            let q = p.add(s.scale(sign));
            m.cylinder(vm.v(q.x, q.y, 0.0), q, 0.0022, 8, false, STEEL)!;
        }
    }
}

/// The clear ramp: its floor and walls.
pub fn build_ramp(m: *mut mesh.Mesh, t: *tb.Table) !void {
    let clear = look(0.7, 0.85, 1.0, mesh.CLEAR, 0.05);
    let up = vm.v(0.0, 0.0, tb.RAMP_WALL);
    for i in 1..tb.RAMP_N {
        let a = t.ramp[i - 1];
        let b = t.ramp[i];
        let sa = tb.across(t.ramp[..], i - 1).scale(tb.ramp_half(i - 1));
        let sb = tb.across(t.ramp[..], i).scale(tb.ramp_half(i));
        m.quad(a.sub(sa), a.add(sa), b.add(sb), b.sub(sb), clear)!;
        m.quad(a.sub(sa), b.sub(sb), b.sub(sb).add(up), a.sub(sa).add(up), clear)!;
        m.quad(a.add(sa), a.add(sa).add(up), b.add(sb).add(up), b.add(sb), clear)!;
    }
}

/// The general illumination's bulbs (lit by its lamp).
pub fn build_bulbs(m: *mut mesh.Mesh) !void {
    for p in GI {
        m.sphere(p, 0.0042, 8, 12, look(1.0, 0.82, 0.55, mesh.LAMP, 0.0))!;
    }
}

/// The moving parts, each about its own origin; their ranges into parts.
pub fn build_parts(m: *mut mesh.Mesh, parts: *mut [10]Part) !void {
    let mut start = m.indexes();
    // the flipper: along +x from its pivot, white with a red rubber
    let len: f32 = 0.071;
    mesh.tapered_slab(m, vm.zero(), vm.v(len, 0.0, 0.0), 0.0112 - 0.0022, 0.0056 - 0.0022, 0.003, 0.026,
                      look(0.92, 0.92, 0.9, mesh.PAINT, 0.25))!;
    mesh.tapered_slab(
        m, vm.zero(), vm.v(len, 0.0, 0.0), 0.0115, 0.0059, 0.008, 0.02, look(0.75, 0.05, 0.05, mesh.RUBBER, 0.6))!;
    m.cylinder(vm.v(0.0, 0.0, 0.026), vm.v(0.0, 0.0, 0.029), 0.005, 16, true, CHROME)!;
    parts[P_FLIPPER] = Part.{ first: start, count: m.indexes() - start };
    // a bumper's cap: a lit dome over a white ring
    start = m.indexes();
    m.cylinder(vm.v(0.0, 0.0, 0.03), vm.v(0.0, 0.0, 0.036), 0.034, 32, false, look(0.9, 0.9, 0.9, mesh.LIT, 0.2))!;
    m.dome(vm.v(0.0, 0.0, 0.036), 0.034, 0.016, 8, 32, look(0.95, 0.95, 0.95, mesh.LIT, 0.08))!;
    parts[P_CAP] = Part.{ first: start, count: m.indexes() - start };
    // a drop target: a block across x, its face toward -y
    start = m.indexes();
    m.box(vm.v(-0.0135, -0.003, 0.0), vm.v(0.0135, 0.003, 0.032), 0.0, look(1.0, 0.3, 0.12, mesh.PAINT, 0.25))!;
    m.box(vm.v(-0.009, -0.0034, 0.012), vm.v(0.009, -0.0029, 0.026), 0.0, look(1.0, 0.9, 0.3, mesh.PAINT, 0.2))!;
    parts[P_DROP] = Part.{ first: start, count: m.indexes() - start };
    // a standup target on its post
    start = m.indexes();
    m.box(vm.v(-0.013, -0.0025, 0.008), vm.v(0.013, 0.0025, 0.032), 0.0, look(0.2, 0.95, 0.4, mesh.PAINT, 0.2))!;
    m.cylinder(vm.v(0.0, 0.004, 0.0), vm.v(0.0, 0.004, 0.02), 0.002, 8, false, STEEL)!;
    parts[P_STANDUP] = Part.{ first: start, count: m.indexes() - start };
    // the gate: a flap hanging from its axis (along x, at the origin)
    start = m.indexes();
    m.box(vm.v(-0.0145, -0.0006, -0.024), vm.v(0.0145, 0.0006, 0.0), 0.0, STEEL)!;
    parts[P_GATE] = Part.{ first: start, count: m.indexes() - start };
    // the spinner: a plate about its axis (x), a stripe on it
    start = m.indexes();
    m.box(vm.v(-0.0165, -0.0007, -0.012), vm.v(0.0165, 0.0007, 0.012), 0.0, CHROME)!;
    m.box(vm.v(-0.012, -0.0009, -0.004), vm.v(0.012, 0.0009, 0.004), 0.0, look(0.1, 0.8, 1.0, mesh.PAINT, 0.2))!;
    parts[P_SPINNER] = Part.{ first: start, count: m.indexes() - start };
    // the plunger: its rod down the lane from the tip (at the origin), a
    // spring, the knob
    start = m.indexes();
    m.cylinder(vm.v(0.0, -0.004, 0.011), vm.v(0.0, 0.0, 0.011), 0.0075, 16, true, BLACK_RUBBER)!;
    m.cylinder(vm.v(0.0, -0.16, 0.011), vm.v(0.0, -0.004, 0.011), 0.003, 12, false, CHROME)!;
    for k in @as(usize, 0)..9 {
        let y = -0.012 - (0.006 * @float_from_int(f32, k));
        m.cylinder(vm.v(0.0, y, 0.011), vm.v(0.0, y - 0.0015, 0.011), 0.0065, 12, false, STEEL)!;
    }
    parts[P_PLUNGER] = Part.{ first: start, count: m.indexes() - start };
    // the ball
    start = m.indexes();
    m.sphere(vm.zero(), ph.R, 32, 48, CHROME)!;
    parts[P_BALL] = Part.{ first: start, count: m.indexes() - start };
    // a flasher: a post and a coloured dome
    start = m.indexes();
    m.cylinder(vm.v(0.0, 0.0, -0.07), vm.v(0.0, 0.0, 0.0), 0.004, 10, false, STEEL)!;
    m.dome(vm.zero(), 0.013, 0.02, 8, 24, look(1.0, 1.0, 1.0, mesh.LIT, 0.08))!;
    parts[P_FLASHER] = Part.{ first: start, count: m.indexes() - start };
    // a bumper's skirt: a chrome ring
    start = m.indexes();
    m.cone(vm.v(0.0, 0.0, 0.016), vm.v(0.0, 0.0, 0.021), 0.031, 0.026, 32, true, CHROME)!;
    parts[P_SKIRT] = Part.{ first: start, count: m.indexes() - start };
}

/// The flipper's transform: rows of a 3x4 matrix.
pub fn flipper_rows(f: ph.Flipper) [12]f32 {
    let c = math.cosf(f.angle);
    let s = math.sinf(f.angle);
    if f.side > 0.0 {
        return [c, -s, 0.0, f.pivot.x, s, c, 0.0, f.pivot.y, 0.0, 0.0, 1.0, 0.0];
    }
    return [-c, s, 0.0, f.pivot.x, s, c, 0.0, f.pivot.y, 0.0, 0.0, 1.0, 0.0];
}
