// =============================================================================
// File: physics.ax
// The ball's physics, at 2400 steps a second. Coordinates are the table's,
// in metres: x across (right +), y up the table (away from the player), z
// up from the playfield. The playfield is tilted 6.5 degrees, so gravity
// has a part down the table as well as into it.
//
// The ball is a solid steel sphere (27 mm, 80 g) with a velocity and a
// spin. A contact pushes it out of what it touches and applies an impulse
// at the contact point: along the normal, with the materials' restitution
// (none for slow contacts, so that it can rest and roll), and across it,
// friction up to Coulomb's limit, which turns sliding into rolling and
// spin into curve. Rolling loses a little to rolling resistance.
//
// What the ball meets:
//   - the playfield (z = 0) and the glass above it;
//   - fences: segments in the plane, of some thickness, standing from z0 to
//     z1 (walls, guides, posts, rubbers, slingshots, bumpers, targets,
//     one-way gates), which can kick (bumpers and slingshots) and report
//     hits (switches);
//   - wires: segments in space (the habitrails);
//   - triangles (the ramps' floors and walls);
//   - the flippers: tapered bats turned by a solenoid against a spring,
//     with their own moment of inertia, so a ball slows a flipper as it is
//     hit;
//   - the plunger, a spring that the player pulls and lets go;
//   - other balls.
// Triggers (rollover switches, the spinner, the ramp's switch) report the
// ball crossing them. A grid over the table finds what is near a ball.
// =============================================================================

import "std/collections/vec" as vec;
import "std/math" as math;
import "std/mem" as mem;
import "v3.ax" as vm;

pub const R: f32 = 0.0135;  // the ball's radius
pub const MASS: f32 = 0.08;
pub const DT: f32 = 1.0 / 2400.0;
pub const GLASS: f32 = 0.15;    // the glass's height over the playfield
pub const SLOPE: f32 = 0.1134;  // 6.5 degrees
pub const MAX_BALLS: usize = 6;
const INERTIA: f32 = 0.4 * MASS * R * R;
const G: f32 = 9.81;

// Materials: restitution and friction
pub const WOOD: u8 = 0;
pub const RUBBER: u8 = 1;
pub const METAL: u8 = 2;
pub const PLASTIC: u8 = 3;
pub const FLIPPER: u8 = 4;
pub const TARGET: u8 = 5;
pub const FLOOR: u8 = 6;
let RESTITUTION: [7]f32 = [0.5, 0.82, 0.42, 0.45, 0.6, 0.3, 0.32];
let FRICTION: [7]f32 = [0.12, 0.45, 0.07, 0.12, 0.55, 0.2, 0.18];

// How a fence looks (the renderer reads it)
pub const S_HIDDEN: u8 = 0;
pub const S_WALL: u8 = 1;    // a wooden wall, the cabinet's
pub const S_GUIDE: u8 = 2;   // a metal guide
pub const S_POST: u8 = 3;    // a post with a rubber ring
pub const S_RUBBER: u8 = 4;  // a rubber band between posts
pub const S_SLING: u8 = 5;   // a slingshot's kicking rubber
pub const S_BUMPER: u8 = 6;
pub const S_DROP: u8 = 7;
pub const S_STANDUP: u8 = 8;
pub const S_GATE: u8 = 9;
pub const S_LANE: u8 = 10;     // a lane guide (metal, low)
pub const S_PLASTIC: u8 = 11;  // a wall with a plastic over it

pub struct Fence {
    a: vm.V3,
    b: vm.V3,
    r: f32,
    z0: f32,
    z1: f32,
    mat: u8,
    style: u8,
    id: i32,      // the switch it closes (-1: none)
    kick: f32,    // what it adds to the ball's speed when hit (m/s)
    on: bool,     // (drop targets go down)
    pass: vm.V3,  // a one-way gate lets balls through this way (zero: solid)
    last: f32,    // when it last reported a hit
}

pub struct Wire {
    a: vm.V3,
    b: vm.V3,
    r: f32,
}

pub struct Tri {
    a: vm.V3,
    b: vm.V3,
    c: vm.V3,
    mat: u8,
}

pub struct Trigger {
    a: vm.V3,
    b: vm.V3,
    z0: f32,
    z1: f32,
    id: i32,
}

pub struct Flipper {
    pivot: vm.V3,
    side: f32,  // 1 the left flipper, -1 the right (mirrored)
    len: f32,
    r1: f32,    // at the pivot
    r2: f32,    // at the tip
    h: f32,     // its height
    rest: f32,  // angles: down, and up (the bat points at (side cos a, sin a))
    up: f32,
    angle: f32,
    speed: f32,  // rad/s, toward up
    held: bool,
}

pub struct Ball {
    p: vm.V3,
    v: vm.V3,
    w: vm.V3,  // spin, rad/s
    prev: vm.V3,
    live: bool,
    held: bool,    // still (in the saucer, or locked)
    floor: bool,   // touching the playfield
    wire: bool,    // on a habitrail
    roll: vm.V3,   // its orientation, as rolled (for drawing): an axis-angle
    spin: [4]f32,  // a quaternion x y z w
}

pub const E_HIT: u8 = 0;      // a fence's switch: speed is the impact's
pub const E_TRIGGER: u8 = 1;  // a trigger crossed: speed is +-, the way
pub const E_DRAIN: u8 = 2;
pub const E_FLIPPER: u8 = 3;  // a ball hit a flipper (sound)
pub const E_KNOCK: u8 = 4;    // any other hard contact (sound)
pub const E_BALLS: u8 = 5;    // balls hit each other

pub struct Event {
    kind: u8,
    id: i32,
    speed: f32,
    ball: usize,
    p: vm.V3,
}

pub struct Plunger {
    y: f32,  // the tip's
    v: f32,
    pulling: bool,
    rest: f32,
}

pub const PLUNGER_X0: f32 = 0.2405;
pub const PLUNGER_X1: f32 = 0.2700;
pub const PLUNGER_REST: f32 = 0.115;
pub const PLUNGER_PULL: f32 = 0.05;

// The grid
const GX0: f32 = -0.30;
const GY0: f32 = -0.05;
const CELL: f32 = 0.04;
const NX: usize = 16;
const NY: usize = 30;

const K_FENCE: usize = 0;
const K_WIRE: usize = 1;
const K_TRI: usize = 2;

pub struct World {
    fences: vec.Vec.[Fence],
    wires: vec.Vec.[Wire],
    tris: vec.Vec.[Tri],
    triggers: vec.Vec.[Trigger],
    flippers: [2]Flipper,
    balls: [6]Ball,
    plunger: Plunger,
    cell_start: []mut u32,  // NX * NY + 1
    refs: []mut u32,        // kind << 24 | index
    events: [128]Event,
    nevents: usize,
    time: f32,
    nudge: vm.V3,  // a velocity the table gives every ball this step
    flipper_inertia: f32,
}

fn dead_ball() Ball {
    return Ball.{ p: vm.zero(), v: vm.zero(), w: vm.zero(), prev: vm.zero(), live: false, held: false, floor: false,
                  wire: false, roll: vm.zero(), spin: [0.0, 0.0, 0.0, 1.0] };
}

fn flipper(pivot: vm.V3, side: f32) Flipper {
    return Flipper.{ pivot: pivot, side: side, len: 0.071, r1: 0.0115, r2: 0.0058, h: 0.026, rest: -0.54, up: 0.47,
                     angle: -0.54, speed: 0.0, held: false };
}

pub fn new_world() World {
    return World.{ fences: vec.Vec.[Fence].init(), wires: vec.Vec.[Wire].init(), tris: vec.Vec.[Tri].init(),
                   triggers: vec.Vec.[Trigger].init(), flippers: [flipper(vm.v(-0.0815, 0.135, 0.0), 1.0),
                                                                  flipper(vm.v(0.0815, 0.135, 0.0), -1.0)],
                   balls: [dead_ball(); 6], plunger: Plunger.{ y: PLUNGER_REST, v: 0.0, pulling: false,
                                                               rest: PLUNGER_REST },
                   cell_start: mem.alloc.[u32](0) catch @trap(), refs: mem.alloc.[u32](0) catch @trap(),
                   events: [Event.{ kind: 0, id: 0, speed: 0.0, ball: 0, p: vm.zero() }; 128], nevents: 0, time: 0.0,
                   nudge: vm.zero(), flipper_inertia: 9.0e-4 };
}

pub fn deinit(w: *mut World) void {
    w.fences.deinit();
    w.wires.deinit();
    w.tris.deinit();
    w.triggers.deinit();
    mem.free(w.cell_start);
    mem.free(w.refs);
}

// -----------------------------------------------------------------------------
// Building
// -----------------------------------------------------------------------------
/// A fence from a to b (in the plane), r thick, standing from z0 to z1.
pub fn fence(w: *mut World, a: vm.V3, b: vm.V3, r: f32, z1: f32, mat: u8, style: u8) !usize {
    w.fences.push(Fence.{ a: a.flat(), b: b.flat(), r: r, z0: 0.0, z1: z1, mat: mat, style: style, id: -1, kick: 0.0,
                          on: true, pass: vm.zero(), last: -1.0 })!;
    return w.fences.items().len - 1;
}

/// Fences along a polyline (pts: x, y pairs).
pub fn fences(w: *mut World, pts: []f32, r: f32, z1: f32, mat: u8, style: u8) !void {
    let mut i: usize = 0;
    while (i + 3) < pts.len {
        _ = fence(w, vm.v(pts[i], pts[i + 1], 0.0), vm.v(pts[i + 2], pts[i + 3], 0.0), r, z1, mat, style)!;
        i += 2;
    }
}

/// A fence along an arc about c, radius rad, from angle a0 to a1, in n parts.
pub fn arc(w: *mut World, c: vm.V3, rad: f32, a0: f32, a1: f32, n: usize, r: f32, z1: f32, mat: u8, style: u8) !void {
    for k in 0..n {
        let t0 = a0 + (((a1 - a0) * @float_from_int(f32, k)) / @float_from_int(f32, n));
        let t1 = a0 + (((a1 - a0) * @float_from_int(f32, k + 1)) / @float_from_int(f32, n));
        _ = fence(w, c.add(vm.dir(t0).scale(rad)), c.add(vm.dir(t1).scale(rad)), r, z1, mat, style)!;
    }
}

pub fn wire(w: *mut World, a: vm.V3, b: vm.V3, r: f32) !void {
    w.wires.push(Wire.{ a: a, b: b, r: r })!;
}

pub fn tri(w: *mut World, a: vm.V3, b: vm.V3, c: vm.V3, mat: u8) !void {
    w.tris.push(Tri.{ a: a, b: b, c: c, mat: mat })!;
}

pub fn trigger(w: *mut World, a: vm.V3, b: vm.V3, z0: f32, z1: f32, id: i32) !void {
    w.triggers.push(Trigger.{ a: a.flat(), b: b.flat(), z0: z0, z1: z1, id: id })!;
}

fn cell_range(lo: f32, hi: f32, origin: f32, n: usize) [2]usize {
    let a = @int_from_float(i64, @floor((lo - origin) / CELL));
    let b = @int_from_float(i64, @floor((hi - origin) / CELL));
    let top = @as(i64, @truncate(i32, n)) - 1;
    return [@int_cast(usize, @min(@max(a, 0), top)), @int_cast(usize, @min(@max(b, 0), top))];
}

// The cells a box (in the plane) covers, grown by the ball.
fn cells_of(lo: vm.V3, hi: vm.V3) [4]usize {
    let m = R + 0.006;
    let xs = cell_range(lo.x - m, hi.x + m, GX0, NX);
    let ys = cell_range(lo.y - m, hi.y + m, GY0, NY);
    return [xs[0], xs[1], ys[0], ys[1]];
}

fn box_of(w: *World, kind: usize, i: usize) [2]vm.V3 {
    if kind == K_FENCE {
        let f = w.fences.get(i);
        let g = vm.v(f.r, f.r, 0.0);
        return [vm.v(@min(f.a.x, f.b.x), @min(f.a.y, f.b.y), 0.0).sub(g),
                vm.v(@max(f.a.x, f.b.x), @max(f.a.y, f.b.y), 0.0).add(g)];
    }
    if kind == K_WIRE {
        let x = w.wires.get(i);
        let g = vm.v(x.r, x.r, 0.0);
        return [vm.v(@min(x.a.x, x.b.x), @min(x.a.y, x.b.y), 0.0).sub(g),
                vm.v(@max(x.a.x, x.b.x), @max(x.a.y, x.b.y), 0.0).add(g)];
    }
    let t = w.tris.get(i);
    return [vm.v(@min(@min(t.a.x, t.b.x), t.c.x), @min(@min(t.a.y, t.b.y), t.c.y), 0.0),
            vm.v(@max(@max(t.a.x, t.b.x), t.c.x), @max(@max(t.a.y, t.b.y), t.c.y), 0.0)];
}

/// Files everything in the grid (after building, before stepping).
pub fn finish(w: *mut World) !void {
    let counts = [w.fences.items().len, w.wires.items().len, w.tris.items().len];
    let mut n: [480]u32 = [0; 480];
    for pass in @as(u32, 0)..2 {
        for kind in @as(usize, 0)..3 {
            for i in 0..counts[kind] {
                let bx = box_of(w, kind, i);
                let c = cells_of(bx[0], bx[1]);
                for cy in c[2]..(c[3] + 1) {
                    for cx in c[0]..(c[1] + 1) {
                        let cell = (cy * NX) + cx;
                        if pass == 0 {
                            n[cell] += 1;
                        } else {
                            w.refs[@as(usize, w.cell_start[cell] + n[cell])] = (
                                @truncate(u32, kind) << 24) | @truncate(u32, i);
                            n[cell] += 1;
                        }
                    }
                }
            }
        }
        if pass == 0 {
            mem.free(w.cell_start);
            mem.free(w.refs);
            w.cell_start = mem.alloc.[u32]((NX * NY) + 1)!;
            let mut total: u32 = 0;
            for cell in 0..(NX * NY) {
                w.cell_start[cell] = total;
                total += n[cell];
                n[cell] = 0;
            }
            w.cell_start[NX * NY] = total;
            w.refs = mem.alloc.[u32](@as(usize, total))!;
        }
    }
}

// -----------------------------------------------------------------------------
// Balls
// -----------------------------------------------------------------------------
/// Puts a ball at p, still: its number, or MAX_BALLS if all are in play.
pub fn add_ball(w: *mut World, p: vm.V3) usize {
    for i in 0..MAX_BALLS {
        if not w.balls[i].live {
            w.balls[i] = dead_ball();
            w.balls[i].p = p;
            w.balls[i].prev = p;
            w.balls[i].live = true;
            return i;
        }
    }
    return MAX_BALLS;
}

pub fn live_balls(w: *World) usize {
    let mut n: usize = 0;
    for b in w.balls {
        if b.live {
            n += 1;
        }
    }
    return n;
}

fn event(w: *mut World, kind: u8, id: i32, speed: f32, ball: usize, p: vm.V3) void {
    if w.nevents < w.events.len {
        w.events[w.nevents] = Event.{ kind: kind, id: id, speed: speed, ball: ball, p: p };
        w.nevents += 1;
    }
}

/// The ball at contact with a surface: n out of the surface toward the
/// ball, pen how far it is in, vs the surface's velocity at the contact,
/// extra the surface's own inverse mass along n there (0: immovable). The
/// impulse is returned (along n and across), and the speed of the impact.
fn contact(b: *mut Ball, n: vm.V3, pen: f32, vs: vm.V3, mat: u8, extra: f32, out: *mut vm.V3) f32 {
    b.p = b.p.add(n.scale(pen));
    let r = n.scale(-R);
    let vc = b.v.add(b.w.cross(r)).sub(vs);
    let vn = vc.dot(n);
    if vn >= 0.0 {
        out.* = vm.zero();
        return 0.0;
    }
    let mut e = RESTITUTION[@as(usize, mat)];
    if -vn < 0.12 {
        e = 0.0;  // resting: no bounce
    } else if -vn < 0.4 {
        e *= (-vn - 0.12) / 0.28;
    }
    let inv = (1.0 / MASS) + extra;
    let jn = (-(1.0 + e) * vn) / inv;
    let mut j = n.scale(jn);
    let vt = vc.sub(n.scale(vn));
    let vtl = vt.len();
    if vtl > 1.0e-7 {
        // sliding stops when the contact point's speed is gone: for a solid
        // sphere that takes 2/7 of the slip in momentum
        let jt = @min((vtl * MASS) / 3.5, FRICTION[@as(usize, mat)] * jn);
        j = j.sub(vt.scale(jt / vtl));
    }
    b.v = b.v.add(j.scale(1.0 / MASS));
    b.w = b.w.add(r.cross(j).scale(1.0 / INERTIA));
    out.* = j;
    return -vn;
}

fn hit_fence(w: *mut World, bi: usize, fi: usize) void {
    let f = w.fences.get(fi);
    if not f.on {
        return;
    }
    let b = &mut w.balls[bi];
    let c = vm.nearest_on_segment(b.p.flat(), f.a, f.b);
    let q = vm.v(c.x, c.y, vm.clampf(b.p.z, f.z0, f.z1));
    let d = b.p.sub(q);
    let dist = d.len();
    let reach = R + f.r;
    if (dist >= reach) or (dist < 1.0e-9) {
        return;
    }
    let n = d.scale(1.0 / dist);
    if f.pass.dot(f.pass) > 0.0 {
        // one-way: a ball going the gate's way, or not yet past it, goes on
        if (b.v.dot(f.pass) > 0.0) or (b.p.sub(f.a).dot(f.pass) < 0.0) {
            return;
        }
    }
    let mut j = vm.zero();
    let speed = contact(b, n, reach - dist, vm.zero(), f.mat, 0.0, &mut j);
    if speed <= 0.0 {
        return;
    }
    let mut reported = false;
    if (f.kick > 0.0) and (speed > 0.06) and (b.p.z < 0.045) {
        // bumpers and slingshots: a solenoid throws the ball off
        let k = n.flat().norm();
        b.v = b.v.add(k.scale(f.kick));
        reported = true;
    }
    if (f.id >= 0) and ((speed > 0.1) or reported) and ((w.time - f.last) > 0.08) {
        w.fences.get_ptr(fi).last = w.time;
        event(w, E_HIT, f.id, speed, bi, q);
    } else if speed > 0.35 {
        event(w, E_KNOCK, @as(i32, f.mat), speed, bi, q);
    }
}

fn hit_wire(w: *mut World, bi: usize, i: usize) void {
    let x = w.wires.get(i);
    let b = &mut w.balls[bi];
    let q = vm.nearest_on_segment(b.p, x.a, x.b);
    let d = b.p.sub(q);
    let dist = d.len();
    let reach = R + x.r;
    if (dist >= reach) or (dist < 1.0e-9) {
        return;
    }
    let mut j = vm.zero();
    let speed = contact(b, d.scale(1.0 / dist), reach - dist, vm.zero(), METAL, 0.0, &mut j);
    b.wire = true;
    if speed > 0.4 {
        event(w, E_KNOCK, @as(i32, METAL), speed, bi, q);
    }
}

fn hit_tri(w: *mut World, bi: usize, i: usize) void {
    let t = w.tris.get(i);
    let b = &mut w.balls[bi];
    let q = vm.nearest_on_triangle(b.p, t.a, t.b, t.c);
    let d = b.p.sub(q);
    let dist = d.len();
    if (dist >= R) or (dist < 1.0e-9) {
        return;
    }
    let mut j = vm.zero();
    let speed = contact(b, d.scale(1.0 / dist), R - dist, vm.zero(), t.mat, 0.0, &mut j);
    if d.z > (dist * 0.7) {
        b.floor = true;  // (rolling on a ramp)
    }
    if speed > 0.4 {
        event(w, E_KNOCK, @as(i32, t.mat), speed, bi, q);
    }
}

// The bat's outline: the distance from a point (lateral, along; lateral
// already made positive) to an uneven capsule along +along, radius r1 at 0
// and r2 at len, and the outline's outward normal there (Quilez).
fn bat(lat: f32, along: f32, r1: f32, r2: f32, len: f32, n: *mut [2]f32) f32 {
    let s = (r1 - r2) / len;
    let c = @sqrt(1.0 - (s * s));
    let k = (lat * -s) + (along * c);
    if k < 0.0 {
        let l = @sqrt((lat * lat) + (along * along));
        n.* = [lat / @max(l, 1.0e-9), along / @max(l, 1.0e-9)];
        return l - r1;
    }
    if k > (c * len) {
        let qa = along - len;
        let l = @sqrt((lat * lat) + (qa * qa));
        n.* = [lat / @max(l, 1.0e-9), qa / @max(l, 1.0e-9)];
        return l - r2;
    }
    n.* = [c, s];
    return ((lat * c) + (along * s)) - r1;
}

fn hit_flipper(w: *mut World, bi: usize, fi: usize) void {
    let f = w.flippers[fi];
    let b = &mut w.balls[bi];
    let d = b.p.sub(f.pivot).flat();
    if d.dot(d) > ((f.len + 0.03) * (f.len + 0.03)) {
        return;
    }
    let u = vm.v(f.side * math.cosf(f.angle), math.sinf(f.angle), 0.0);
    let perp = vm.v(-u.y, u.x, 0.0);
    let along = d.dot(u);
    let lat = d.dot(perp);
    let mut ln: [2]f32 = [0.0, 0.0];
    let dist = bat(@abs(lat), along, f.r1, f.r2, f.len, &mut ln);
    if dist >= R {
        return;
    }
    let mut sgn: f32 = 1.0;
    if lat < 0.0 {
        sgn = -1.0;
    }
    let n2 = perp.scale(ln[0] * sgn).add(u.scale(ln[1]));
    // the nearest point of its side, and the ball's height against it
    let edge = b.p.flat().sub(n2.scale(dist));
    let q = vm.v(edge.x, edge.y, vm.clampf(b.p.z, 0.0, f.h));
    let dd = b.p.sub(q);
    let l = dd.len();
    if (l >= R) or (l < 1.0e-9) {
        if dist < 0.0 {
            // (inside: pushed straight out)
            b.p = b.p.add(n2.scale(R - dist));
        }
        return;
    }
    let n = dd.scale(1.0 / l);
    let rp = q.sub(f.pivot).flat();
    let wz = f.side * f.speed;
    let vs = vm.v(-wz * rp.y, wz * rp.x, 0.0);
    let arm = vm.cross2(rp, n);
    let extra = (arm * arm) / w.flipper_inertia;
    let mut j = vm.zero();
    let speed = contact(b, n, R - l, vs, FLIPPER, extra, &mut j);
    if speed > 0.0 {
        // the flipper takes the opposite impulse
        w.flippers[fi].speed -= (f.side * vm.cross2(rp, j)) / w.flipper_inertia;
        if speed > 0.3 {
            event(w, E_FLIPPER, @int_cast(i32, fi), speed, bi, q);
        }
    }
}

fn hit_plunger(w: *mut World, bi: usize) void {
    let pl = w.plunger;
    let b = &mut w.balls[bi];
    if (b.p.x < (PLUNGER_X0 - R)) or (b.p.x > (PLUNGER_X1 + R)) {
        return;
    }
    let reach = R + 0.004;
    let d = b.p.y - pl.y;
    if (d >= reach) or (d < -0.02) or (b.p.z > 0.04) {
        return;
    }
    let mut j = vm.zero();
    _ = contact(b, vm.v(0.0, 1.0, 0.0), reach - d, vm.v(0.0, pl.v, 0.0), METAL, 0.0, &mut j);
}

fn balls_meet(w: *mut World, i: usize, k: usize) void {
    let d = w.balls[i].p.sub(w.balls[k].p);
    let dist = d.len();
    if (dist >= (2.0 * R)) or (dist < 1.0e-9) {
        return;
    }
    let n = d.scale(1.0 / dist);
    let pen = ((2.0 * R) - dist) * 0.5;
    w.balls[i].p = w.balls[i].p.add(n.scale(pen));
    w.balls[k].p = w.balls[k].p.sub(n.scale(pen));
    let vn = w.balls[i].v.sub(w.balls[k].v).dot(n);
    if vn >= 0.0 {
        return;
    }
    let j = n.scale((-(1.0 + 0.92) * vn) * 0.5);
    w.balls[i].v = w.balls[i].v.add(j);
    w.balls[k].v = w.balls[k].v.sub(j);
    if -vn > 0.2 {
        event(w, E_BALLS, 0, -vn, i, w.balls[i].p);
    }
}

fn move_flipper(f: *mut Flipper) void {
    // the solenoid pulls hard; a spring brings it back
    if f.held {
        f.speed += 2900.0 * DT;
    } else {
        f.speed -= 700.0 * DT;
    }
    f.speed *= 0.9995;
    f.angle += f.speed * DT;
    if f.angle >= f.up {
        f.angle = f.up;
        if f.speed > 0.0 {
            f.speed = -f.speed * 0.12;
        }
    }
    if f.angle <= f.rest {
        f.angle = f.rest;
        if f.speed < 0.0 {
            f.speed = -f.speed * 0.12;
        }
    }
}

fn move_plunger(p: *mut Plunger) void {
    if p.pulling {
        p.v = 0.0;
        p.y = @max(p.y - (0.09 * DT), p.rest - PLUNGER_PULL);
        return;
    }
    if p.y < p.rest {
        // the spring: some 2.7 m/s at full pull
        p.v += (3000.0 * (p.rest - p.y)) * DT;
        p.y += p.v * DT;
        if p.y >= p.rest {
            p.y = p.rest;
            p.v = 0.0;
        }
    } else {
        p.v = 0.0;
    }
}

// Turns the ball's drawn orientation by its spin.
fn turn(b: *mut Ball) void {
    let wx = b.w.x * DT * 0.5;
    let wy = b.w.y * DT * 0.5;
    let wz = b.w.z * DT * 0.5;
    let q = b.spin;
    let mut r: [4]f32 = [q[0] + ((wx * q[3]) + (wy * q[2])) - (wz * q[1]),
                         q[1] + ((wy * q[3]) + (wz * q[0])) - (wx * q[2]),
                         q[2] + ((wz * q[3]) + (wx * q[1])) - (wy * q[0]),
                         q[3] - ((wx * q[0]) + (wy * q[1]) + (wz * q[2]))];
    let l = @sqrt((r[0] * r[0]) + (r[1] * r[1]) + (r[2] * r[2]) + (r[3] * r[3]));
    for k in @as(usize, 0)..4 {
        r[k] /= l;
    }
    b.spin = r;
}

fn crossed(w: *mut World, bi: usize) void {
    let b = w.balls[bi];
    for i in 0..w.triggers.items().len {
        let t = w.triggers.get(i);
        if (b.p.z < t.z0) or (b.p.z > t.z1) {
            continue;
        }
        let ab = t.b.sub(t.a);
        let s0 = vm.cross2(ab, b.prev.sub(t.a));
        let s1 = vm.cross2(ab, b.p.sub(t.a));
        if ((s0 < 0.0) == (s1 < 0.0)) or (s0 == s1) {
            continue;
        }
        // where it crossed the line: within the segment?
        let k = s0 / (s0 - s1);
        let x = b.prev.lerp(b.p, k);
        let u = x.sub(t.a).flat().dot(ab) / ab.dot(ab);
        if (u < 0.0) or (u > 1.0) {
            continue;
        }
        let mut way = b.v.flat().len();
        if s1 < 0.0 {
            way = -way;
        }
        event(w, E_TRIGGER, t.id, way, bi, x);
    }
}

/// One step (DT) of everything.
pub fn step(w: *mut World) void {
    w.time += DT;
    move_flipper(&mut w.flippers[0]);
    move_flipper(&mut w.flippers[1]);
    move_plunger(&mut w.plunger);
    let g = vm.v(0.0, -G * math.sinf(SLOPE), -G * math.cosf(SLOPE));
    for bi in 0..MAX_BALLS {
        if not w.balls[bi].live or w.balls[bi].held {
            continue;
        }
        let b = &mut w.balls[bi];
        b.prev = b.p;
        b.v = b.v.add(g.scale(DT)).add(w.nudge);
        b.p = b.p.add(b.v.scale(DT));
        b.floor = false;
        b.wire = false;
        // the playfield and the glass
        if b.p.z < R {
            let mut j = vm.zero();
            let speed = contact(b, vm.v(0.0, 0.0, 1.0), R - b.p.z, vm.zero(), FLOOR, 0.0, &mut j);
            b.floor = true;
            if speed > 0.5 {
                event(w, E_KNOCK, @as(i32, FLOOR), speed, bi, b.p);
            }
        }
        if b.p.z > (GLASS - R) {
            let mut j = vm.zero();
            _ = contact(b, vm.v(0.0, 0.0, -1.0), b.p.z - (GLASS - R), vm.zero(), PLASTIC, 0.0, &mut j);
        }
        // what is near
        let cx = @int_from_float(i64, @floor((b.p.x - GX0) / CELL));
        let cy = @int_from_float(i64, @floor((b.p.y - GY0) / CELL));
        if (cx >= 0) and (cy >= 0) and (cx < @int_cast(i64, NX)) and (cy < @int_cast(i64, NY)) {
            let cell = (@int_cast(usize, cy) * NX) + @int_cast(usize, cx);
            for k in @as(usize, w.cell_start[cell])..@as(usize, w.cell_start[cell + 1]) {
                let r = w.refs[k];
                let kind = @as(usize, r >> 24);
                let i = @as(usize, r & 0xff_ffff);
                if kind == K_FENCE {
                    hit_fence(w, bi, i);
                } else if kind == K_WIRE {
                    hit_wire(w, bi, i);
                } else {
                    hit_tri(w, bi, i);
                }
            }
        }
        hit_flipper(w, bi, 0);
        hit_flipper(w, bi, 1);
        hit_plunger(w, bi);
        let bb = &mut w.balls[bi];
        if bb.floor or bb.wire {
            // rolling resistance, and a little loss of spin about the normal
            let s = bb.v.len();
            if s > 1.0e-5 {
                let k = @max(1.0 - ((0.012 * G * DT) / s), 0.0);
                bb.v = bb.v.scale(k);
            }
            bb.w = vm.v(bb.w.x, bb.w.y, bb.w.z * (1.0 - (3.0 * DT)));
        }
        turn(bb);
        crossed(w, bi);
        let p = w.balls[bi].p;
        if (p.y < 0.04) or (p.y > 1.2) or (@abs(p.x) > 0.3) or (p.z < -0.05) {
            w.balls[bi].live = false;
            event(w, E_DRAIN, 0, 0.0, bi, p);
        }
    }
    for i in 0..MAX_BALLS {
        for k in (i + 1)..MAX_BALLS {
            if w.balls[i].live and w.balls[k].live and not w.balls[i].held and not w.balls[k].held {
                balls_meet(w, i, k);
            }
        }
    }
    w.nudge = vm.zero();
}
