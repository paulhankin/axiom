// =============================================================================
// File: md2pdf.ax
// Typesets a Markdown file as an A4 PDF with std/text/markdown/pdf: headings
// in the outline, lists, tables, code, quotes, links, TeX math and images.
//
//   axiom build examples/md2pdf.ax --target=native -O2 -o md2pdf
//   ./md2pdf README.md readme.pdf
//   ./md2pdf notes.md notes.pdf --letter --justify --size 10
//   ./md2pdf paper.md paper.pdf --math latinmodern-math.otf
//
// Images are read from the Markdown file's directory. The text is set in
// Liberation Sans, DejaVu Sans or Arial, whichever the system has; math in
// --math, or an installed math font (STIX Two Math, Latin Modern Math,
// Cambria Math), or else the STIX Two Math subset in std/text/math/testdata
// (found when md2pdf runs from the repository's root).
// =============================================================================

import "std/collections/vec" as vec;
import "std/compress/xz" as xz;
import "std/fmt" as fmt;
import "std/graphics/pdf" as pdf;
import "std/io" as io;
import "std/mem" as mem;
import "std/os" as os;
import "std/os/cli" as cli;
import "std/os/fs" as fs;
import "std/str" as strs;
import "std/text/markdown/pdf" as mdpdf;

let BUNDLED_MATH: []u8 = "std/text/math/testdata/STIXTwoMath-subset.ttf.xz";

/// The bytes of a font file, decompressed if it ends in .xz.
fn font_bytes(path: []u8) ![]mut u8 {
    let data = fs.read_file(path)!;
    if not strs.ends_with(path, ".xz") {
        return data;
    }
    defer mem.free(data);
    return xz.decompress(data, 64000000);
}

/// The directory part of a path ("." if none).
fn dir_of(path: []u8) []u8 {
    let mut i = path.len;
    while i > 0 {
        i -= 1;
        if path[i] == '/' {
            if i == 0 {
                return "/";
            }
            return path[..i];
        }
    }
    return ".";
}

fn run() !i32 {
    let mut p = cli.Parser.init("md2pdf", "Typeset a Markdown file as a PDF.");
    defer p.deinit();
    p.flag("letter", 'l', "US Letter pages (default A4)")!;
    p.flag("justify", 'j', "justify paragraphs")!;
    p.option("size", 's', "PT", "the body text size in points (default 11)")!;
    p.option("math", 'm', "FILE", "the math font (.otf, .ttf, .ttc, or .xz of one), with a MATH table")!;
    p.positional("IN", "the Markdown file", cli.Arity.REQUIRED)!;
    p.positional("OUT", "the PDF to write", cli.Arity.REQUIRED)!;
    let mut args = os.args()!;
    defer args.deinit();
    let mut argv = vec.Vec.[[]u8].init();
    defer argv.deinit();
    for a in args.items.items()[1..] {
        argv.push(a)!;
    }
    let m = p.parse(argv.items()) catch |e| {
        if e == error.HelpRequested {
            p.help(io.stdout())!;
            return 0;
        }
        fmt.eprint("md2pdf: {}\n", [fmt.str(p.message())])!;
        return 2;
    };
    let input = m.get("IN", "");
    let output = m.get("OUT", "");
    let text = fs.read_file(input)!;
    defer mem.free(text);
    let mut fonts = mdpdf.FontSet.find() catch {
        io.stderr().println("md2pdf: no font found (DejaVu Sans, Liberation Sans or Arial)")!;
        return 1;
    };
    defer fonts.deinit();
    // the math font: --math, else an installed one, else the bundled subset
    let mut math_path = m.get("math", "");
    if (math_path.len == 0) and not fonts.has_math() and fs.exists(BUNDLED_MATH) {
        math_path = BUNDLED_MATH;
    }
    if math_path.len > 0 {
        let mf = mdpdf.math_face(font_bytes(math_path)!) catch {
            fmt.eprint("md2pdf: {} is not a math font (no MATH table)\n", [fmt.str(math_path)])!;
            return 1;
        };
        fonts.set_math(mf)!;
    }
    if not fonts.has_math() {
        io.stderr().println("md2pdf: no math font: math is set in the text font (see --math)")!;
    }
    let mut o = mdpdf.Options.init(fonts.fonts());
    o.image_dir = dir_of(input);
    o.justify = m.has("justify");
    if m.has("letter") {
        o.page_width = pdf.LETTER_WIDTH;
        o.page_height = pdf.LETTER_HEIGHT;
    }
    let size = m.int("size", 11)!;
    if (size < 6) or (size > 24) {
        io.stderr().println("md2pdf: --size must be from 6 to 24")!;
        return 2;
    }
    o.size = @float_from_int(f64, size);
    mdpdf.save(text, output, o)!;
    return 0;
}

export fn main() i32 {
    return run() catch |e| {
        fmt.eprint("md2pdf: {}\n", [fmt.str(@error_name(e))]) catch {};
        return 1;
    };
}
