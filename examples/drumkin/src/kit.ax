// =============================================================================
// File: kit.ax
// The kit the drum machine starts with: two settings of each drum (A after
// the analogue machines of the early 1980s, B something harder and more
// metallic, mostly from FM) and a pattern to play them.
// =============================================================================

import "synth.ax" as synth;

// A setting in the parameters' own units (Hz, semitones, seconds, ...),
// in the order of synth's parameters:
//
//   tune  bend  bend-decay  ratio  fm  fm-decay  tone  noise
//   cutoff  reso  mode  filter-env  fenv-decay
//   attack  decay  sustain  release  drive  pan  level
fn setting(v: [20]f32) [20]f32 {
    let mut x: [20]f32 = [0.0; 20];
    for k in @as(usize, 0)..synth.PARAMS {
        x[k] = synth.norm(k, v[k]);
    }
    return x;
}

let KICK_A: [20]f32 = [48.0, 30.0, 0.035, 1.0, 0.4, 0.02, 1.0, 0.03, 5000.0, 0.0, 0.0, 0.0, 0.05, 0.0005, 1.2, 0.0, 0.7,
                       1.6, 0.0, 0.95];
let KICK_B: [20]f32 = [56.0, 42.0, 0.018, 1.5, 3.5, 0.012, 1.0, 0.25, 2200.0, 0.35, 0.0, 2.0, 0.03, 0.0005, 0.35, 0.0,
                       0.2, 6.0, 0.0, 0.8];
let SNARE_A: [20]f32 = [185.0, 7.0, 0.03, 1.5, 0.6, 0.05, 0.55, 0.75, 4200.0, 0.1, 0.75, 1.0, 0.08, 0.0005, 0.28, 0.0,
                        0.22, 1.6, 0.0, 0.7];
let SNARE_B: [20]f32 = [240.0, 12.0, 0.015, 2.3, 4.0, 0.04, 0.45, 0.95, 2500.0, 0.55, 0.5, 2.0, 0.05, 0.0005, 0.2, 0.0,
                        0.25, 4.5, 0.0, 0.62];
let LOW_TOM_A: [20]f32 = [95.0, 5.0, 0.15, 1.0, 0.2, 0.05, 1.0, 0.04, 3000.0, 0.0, 0.0, 0.0, 0.05, 0.0005, 0.6, 0.0,
                          0.45, 1.3, -0.35, 0.75];
let LOW_TOM_B: [20]f32 = [110.0, 24.0, 0.25, 0.5, 2.5, 0.2, 1.0, 0.1, 5000.0, 0.3, 0.0, -1.0, 0.3, 0.0005, 0.7, 0.0,
                          0.5, 2.2, -0.35, 0.65];
let HIGH_TOM_A: [20]f32 = [150.0, 5.0, 0.12, 1.0, 0.2, 0.05, 1.0, 0.04, 3500.0, 0.0, 0.0, 0.0, 0.05, 0.0005, 0.5, 0.0,
                           0.4, 1.3, 0.35, 0.7];
let HIGH_TOM_B: [20]f32 = [190.0, 24.0, 0.2, 0.5, 2.5, 0.18, 1.0, 0.1, 6000.0, 0.3, 0.0, -1.0, 0.25, 0.0005, 0.6, 0.0,
                           0.45, 2.2, 0.35, 0.6];
let RIM_A: [20]f32 = [480.0, 0.0, 0.01, 3.55, 1.5, 0.01, 1.0, 0.1, 1200.0, 0.2, 1.0, 0.0, 0.05, 0.0005, 0.035, 0.0,
                      0.03, 2.0, 0.2, 0.55];
let RIM_B: [20]f32 = [900.0, 12.0, 0.01, 1.0, 0.3, 0.01, 1.0, 0.25, 2000.0, 0.6, 0.5, 0.0, 0.05, 0.0005, 0.06, 0.0,
                      0.05, 1.5, 0.2, 0.55];
let BELL_A: [20]f32 = [540.0, 0.0, 0.01, 1.48, 1.2, 0.3, 1.0, 0.0, 2600.0, 0.4, 0.5, 0.0, 0.05, 0.0005, 0.35, 0.0, 0.25,
                       2.5, -0.2, 0.5];
let BELL_B: [20]f32 = [700.0, 0.0, 0.01, 3.5, 5.0, 0.8, 1.0, 0.0, 12000.0, 0.0, 0.0, 0.0, 0.05, 0.0005, 1.5, 0.0, 1.2,
                       1.0, -0.2, 0.4];
let CLOSED_A: [20]f32 = [3000.0, 0.0, 0.01, 1.41, 6.0, 1.0, 0.4, 0.8, 7000.0, 0.2, 1.0, 0.0, 0.05, 0.0005, 0.05, 0.0,
                         0.04, 1.2, 0.25, 0.5];
let CLOSED_B: [20]f32 = [4800.0, 0.0, 0.01, 2.7, 3.0, 1.0, 0.15, 1.0, 9000.0, 0.4, 1.0, 0.0, 0.05, 0.0005, 0.03, 0.0,
                         0.03, 2.0, 0.25, 0.5];
let OPEN_A: [20]f32 = [3000.0, 0.0, 0.01, 1.41, 6.0, 1.0, 0.4, 0.8, 7000.0, 0.2, 1.0, 0.0, 0.05, 0.0005, 0.5, 0.0, 0.45,
                       1.2, 0.3, 0.42];
let OPEN_B: [20]f32 = [4500.0, 0.0, 0.01, 1.73, 8.0, 1.0, 0.5, 0.7, 6000.0, 0.5, 0.8, 1.0, 0.3, 0.0005, 0.8, 0.0, 0.7,
                       1.5, 0.3, 0.38];

// A pattern for each drum: '.' rest, 'x' hit, 'X' accented hit.
let PATTERN: [8][]u8 = ["X..x....X.x.....", "....X.......X..x", "..............x.", ".............x..",
                        "..x....x...x....", "......x.........", "x.X.x.X.x.X.x.Xx", "...x.......x...."];

/// The model at the start: the kit, the pattern, 120 bpm, stopped.
pub fn initial() synth.Model {
    let mut m = synth.Model.{ lock: 0, a: [[0.0; 20]; 8], b: [[0.0; 20]; 8], blend: [0.0; 8], mute: [false; 8],
                              pattern: [[0; 16]; 8], bpm: 120.0, swing: 0.15, volume: 0.7, playing: false, step: -1,
                              hits: [0; 8], audition: [0; 8], scope: [0.0; 256], peak: 0.0 };
    let a: [8][20]f32 = [KICK_A, SNARE_A, LOW_TOM_A, HIGH_TOM_A, RIM_A, BELL_A, CLOSED_A, OPEN_A];
    let b: [8][20]f32 = [KICK_B, SNARE_B, LOW_TOM_B, HIGH_TOM_B, RIM_B, BELL_B, CLOSED_B, OPEN_B];
    for d in @as(usize, 0)..synth.VOICES {
        m.a[d] = setting(a[d]);
        m.b[d] = setting(b[d]);
        for s in @as(usize, 0)..synth.STEPS {
            let c = PATTERN[d][s];
            if c == 'x' {
                m.pattern[d][s] = 1;
            } else if c == 'X' {
                m.pattern[d][s] = 2;
            }
        }
    }
    m.blend[0] = 0.25;
    m.blend[1] = 0.3;
    m.blend[6] = 0.2;
    return m;
}
