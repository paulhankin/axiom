// =============================================================================
// runtime/trap_format.ax - trap records, shadow stacks and their formatting,
// shared by the native runtime modules (native.ax, test_main.ax,
// profile.ax). The records are written by the code generator (codegen:
// site_record, trap_info, the shadow stack).
// =============================================================================

// A site record: a trap site, a call site (code 255) or an error return
// (code 254). `fn_` is the enclosing function, `callee` the called one.
pub struct Site {
    code: u32,
    file_id: u32,
    start: u32,
    end: u32,
    line: u32,
    col: u32,
    file: *u8,
    text: *u8,
    fn_: *u8,
    callee: *u8,
}

pub const SS_CAP: u32 = 256;
pub const ET_CAP: u32 = 32;

// A thread's shadow stack (spec §16.4).
pub struct ShadowStack {
    depth: u32,
    errors: u32,
    calls: [256]*Site,
    error_returns: [32]*Site,
}

pub struct TrapInfo {
    site: u64,
    kind: u64,
    a: u64,
    b: u64,
    alen: u64,
    blen: u64,
}

pub fn is_null(p: *void) bool {
    return @int_from_ptr(p) == 0;
}

pub fn cstr(p: *u8) []u8 {
    if @int_from_ptr(p) == 0 {
        return "";
    }
    let mut n: usize = 0;
    while @ptr_from_int(*u8, @int_from_ptr(p) + n).* != 0 {
        n += 1;
    }
    return @slice_from_ptr(p, n);
}

// The exact decimal digits (values 0-9) of a finite, nonzero double with
// biased exponent ex and fraction frac; *dexp is the decimal exponent of the
// first digit. Big numbers in base 10^9 limbs, least significant first.
fn exact_digits(frac: u64, ex: i32, out: []mut u8, dexp: *mut i32) usize {
    let mut m = frac;
    let mut e: i32 = ex - 1075;
    if ex == 0 {
        e = -1074;
    } else {
        m = m | (@as(u64, 1) << 52);
    }
    let mut limbs: [100]u64 = [0; 100];
    limbs[0] = m % 1_000_000_000;
    limbs[1] = (m / 1_000_000_000) % 1_000_000_000;
    limbs[2] = m / 1_000_000_000_000_000_000;
    let mut n: usize = 3;
    // value = m * 2^e: for e >= 0 multiply by 2^e; else by 5^-e and divide
    // by 10^-e (a shift of the decimal point)
    let mut mul: u64 = 2;
    let mut times = e;
    let mut shift: i32 = 0;
    if e < 0 {
        mul = 5;
        times = -e;
        shift = e;
    }
    while times > 0 {
        // multiply by mul^k with mul^k < 2^32
        let mut k: i32 = 0;
        let mut f: u64 = 1;
        while (k < times) and (f < 100_000_000) {
            f *= mul;
            k += 1;
        }
        times -= k;
        let mut carry: u64 = 0;
        for i in 0..n {
            let v = (limbs[i] * f) + carry;
            limbs[i] = v % 1_000_000_000;
            carry = v / 1_000_000_000;
        }
        while carry > 0 {
            limbs[n] = carry % 1_000_000_000;
            carry = carry / 1_000_000_000;
            n += 1;
        }
    }
    while (n > 1) and (limbs[n - 1] == 0) {
        n -= 1;
    }
    // the digits, most significant first
    let mut nd: usize = 0;
    let mut i = n;
    while i > 0 {
        i -= 1;
        let v = limbs[i];
        let mut d: [9]u8 = [0; 9];
        let mut t = v;
        for k in @as(usize, 0)..9 {
            d[8 - k] = @truncate(u8, t % 10);
            t = t / 10;
        }
        let mut k0: usize = 0;
        if i == (n - 1) {
            while (k0 < 8) and (d[k0] == 0) {
                k0 += 1;
            }
        }
        for k in k0..9 {
            if nd < out.len {
                out[nd] = d[k];
                nd += 1;
            }
        }
    }
    dexp.* = (@int_cast(i32, nd) - 1) + shift;
    // (trailing zeros make no difference)
    return nd;
}

pub fn call_at(ss: *ShadowStack, i: u32) *Site {
    return ss.calls[@as(usize, i & (SS_CAP - 1))];
}

pub fn trap_name(code: u32) []u8 {
    let names = ["trap", "index out of bounds", "integer overflow", "division by zero", "int_cast out of range",
                 "memory access out of bounds", "length precondition failed", "invalid union tag or enum value",
                 "stack exhausted", "invalid function pointer", "misaligned atomic access", "expectation failed",
                 "memory error", "processor lacks a required extension"];
    if code < @int_cast(u32, names.len) {
        return names[@as(usize, code)];
    }
    return "trap";
}

// A fixed-capacity text buffer (no allocation: usable in signal handlers).
pub struct Fmt {
    p: *mut u8,
    cap: usize,
    n: usize,

    pub fn s(self: *mut Fmt, x: []u8) void {
        let d = @slice_from_ptr(self.p, self.cap);
        for c in x {
            if (self.n + 1) >= self.cap {
                return;
            }
            d[self.n] = c;
            self.n += 1;
        }
        d[self.n] = 0;
    }

    pub fn c(self: *mut Fmt, x: u8) void {
        let one: [1]u8 = [x];
        self.s(one[..]);
    }

    pub fn u(self: *mut Fmt, x: u64) void {
        let mut tmp: [24]u8 = [0; 24];
        let mut k: usize = 24;
        let mut v = x;
        loop {
            k -= 1;
            tmp[k] = @truncate(u8, v % 10) + '0';
            v = v / 10;
            if v == 0 {
                break;
            }
        }
        self.s(tmp[k..]);
    }

    pub fn i(self: *mut Fmt, x: i64) void {
        if x < 0 {
            self.c('-');
            self.u(0 -% @bit_cast(u64, x));
            return;
        }
        self.u(@bit_cast(u64, x));
    }

    pub fn hex(self: *mut Fmt, x: u64) void {
        let digits = "0123456789abcdef";
        let mut tmp: [16]u8 = [0; 16];
        let mut k: usize = 16;
        let mut v = x;
        loop {
            k -= 1;
            tmp[k] = digits[@truncate(usize, v & 15)];
            v = v >> 4;
            if v == 0 {
                break;
            }
        }
        self.s(tmp[k..]);
    }

    // x as C's printf("%.17g") writes it (17 significant digits, exact).
    pub fn g17(self: *mut Fmt, x: f64) void {
        let bits = @bit_cast(u64, x);
        let neg = (bits >> 63) != 0;
        let ex = @truncate(i32, (bits >> 52) & 0x7ff);
        let frac = bits & 0xF_FFFF_FFFF_FFFF;
        if neg {
            self.c('-');
        }
        if ex == 0x7ff {
            if frac == 0 {
                self.s("inf");
            } else {
                self.s("nan");
            }
            return;
        }
        if (ex == 0) and (frac == 0) {
            self.c('0');
            return;
        }
        let mut dig: [800]u8 = [0; 800];
        let mut dexp: i32 = 0;
        let nd = exact_digits(frac, ex, dig[..], &mut dexp);
        // round to 17 significant digits (half to even); dexp: the decimal
        // exponent of the first digit
        let mut d17: [18]u8 = [0; 18];
        for i in @as(usize, 0)..17 {
            if i < nd {
                d17[i] = dig[i];
            }
        }
        if nd > 17 {
            let mut up = dig[17] > 5;
            if dig[17] == 5 {
                up = (d17[16] & 1) == 1;
                for i in 18..nd {
                    if dig[i] != 0 {
                        up = true;
                    }
                }
            }
            if up {
                let mut k: usize = 17;
                loop {
                    if k == 0 {
                        // 99...9 became 100...0
                        d17[0] = 1;
                        dexp += 1;
                        break;
                    }
                    k -= 1;
                    if d17[k] == 9 {
                        d17[k] = 0;
                    } else {
                        d17[k] += 1;
                        break;
                    }
                }
            }
        }
        let mut last: usize = 16;  // the last nonzero digit
        while (last > 0) and (d17[last] == 0) {
            last -= 1;
        }
        if (dexp < -4) or (dexp >= 17) {
            // d.ddde+XX
            self.c('0' + d17[0]);
            if last > 0 {
                self.c('.');
                for i in 1..last + 1 {
                    self.c('0' + d17[i]);
                }
            }
            self.c('e');
            let mut e = dexp;
            if e < 0 {
                self.c('-');
                e = -e;
            } else {
                self.c('+');
            }
            if e < 10 {
                self.c('0');
            }
            self.u(@as(u64, @bit_cast(u32, e)));
            return;
        }
        if dexp < 0 {
            self.s("0.");
            for i in 0..@as(usize, @bit_cast(u32, -dexp - 1)) {
                _ = i;
                self.c('0');
            }
            for i in 0..last + 1 {
                self.c('0' + d17[i]);
            }
            return;
        }
        let int_digits = @as(usize, @bit_cast(u32, dexp)) + 1;
        for i in 0..int_digits {
            self.c('0' + d17[i]);
        }
        if last >= int_digits {
            self.c('.');
            for i in int_digits..last + 1 {
                self.c('0' + d17[i]);
            }
        }
    }

    // "T0003"
    pub fn code(self: *mut Fmt, c: u32) void {
        self.c('T');
        if c < 1000 {
            self.c('0');
        }
        if c < 100 {
            self.c('0');
        }
        if c < 10 {
            self.c('0');
        }
        self.u(@as(u64, c));
    }

    pub fn text(self: *Fmt) []u8 {
        return @slice_from_ptr(self.p, self.n);
    }
}

pub fn fmt(buf: []mut u8) Fmt {
    if buf.len > 0 {
        buf[0] = 0;
    }
    return Fmt.{ p: buf.ptr, cap: buf.len, n: 0 };
}

pub fn format_value(o: *mut Fmt, kind: u64, v: u64, len: u64) void {
    if kind == 1 {
        o.i(@bit_cast(i64, v));
    } else if kind == 2 {
        o.u(v);
    } else if kind == 3 {
        o.g17(@bit_cast(f64, v));
    } else if kind == 4 {
        if v != 0 {
            o.s("true");
        } else {
            o.s("false");
        }
    } else if kind == 5 {
        let mut n = len;
        if n > 200 {
            n = 200;
        }
        o.c('"');
        if v != 0 {
            o.s(@slice_from_ptr(@ptr_from_int(*u8, @truncate(usize, v)), @truncate(usize, n)));
        }
        o.c('"');
    } else if kind == 6 {
        o.s("error #");
        o.u(v);
    } else {
        o.s("0x");
        o.hex(v);
    }
}

// "trap T0001 (index out of bounds): <text>" or
// "expected equal values, left: 3, right: 4: <text>"
pub fn format_trap(o: *mut Fmt, s: *Site, info: *TrapInfo) void {
    if not is_null(@ptr_cast(*void, info)) and (info.kind != 0) {
        o.s("expected equal values, left: ");
        format_value(o, info.kind, info.a, info.alen);
        o.s(", right: ");
        format_value(o, info.kind, info.b, info.blen);
        o.s(": ");
        o.s(cstr(s.text));
    } else if s.code == 11 {
        o.s("expectation failed: ");
        o.s(cstr(s.text));
    } else {
        o.s("trap ");
        o.code(s.code);
        o.s(" (");
        o.s(trap_name(s.code));
        o.s("): ");
        o.s(cstr(s.text));
    }
}

fn frame_line(o: *mut Fmt, c: *Site) void {
    o.s("  at ");
    o.s(cstr(c.fn_));
    o.s(" (");
    o.s(cstr(c.file));
    o.c(':');
    o.u(@as(u64, c.line));
    o.c(':');
    o.u(@as(u64, c.col));
    o.s(")\n");
}

// "stack trace" lines for a trap at `top` (0: location unknown).
pub fn format_stack(o: *mut Fmt, top: *Site, ss: *ShadowStack) void {
    let has_ss = not is_null(@ptr_cast(*void, ss));
    let mut depth: u32 = 0;
    if has_ss {
        depth = ss.depth;
    }
    let has_top = not is_null(@ptr_cast(*void, top));
    if not has_top and (depth == 0) {
        return;
    }
    o.s("stack trace (innermost first):\n");
    if has_top {
        frame_line(o, top);
    } else {
        let c = call_at(ss, depth - 1);
        o.s("  at ");
        if not is_null(@ptr_cast(*void, c)) and (cstr(c.callee).len > 0) {
            o.s(cstr(c.callee));
        } else {
            o.s("<indirect call>");
        }
        o.s("\n");
    }
    let mut shown: u32 = 0;
    let mut i = @as(i64, depth) - 1;
    while (i >= 0) and (i >= (@as(i64, depth) - @as(i64, SS_CAP))) {
        let c = call_at(ss, @truncate(u32, @bit_cast(u64, i)));
        if is_null(@ptr_cast(*void, c)) {
            i -= 1;
            continue;
        }
        if shown >= 40 {
            o.s("  ... ");
            o.u(@bit_cast(u64, i + 1));
            o.s(" more frames\n");
            return;
        }
        let mut j = i;
        while ((j - 1) >= 0) and ((j - 1) >= (@as(i64, depth) - @as(i64, SS_CAP))) and
              (call_at(ss, @truncate(u32, @bit_cast(u64, j - 1))) == c) {
            j -= 1;
        }
        frame_line(o, c);
        shown += 1;
        if j < i {
            o.s("  ... the frame above repeats ");
            o.u(@bit_cast(u64, i - j));
            if (i - j) == 1 {
                o.s(" more time\n");
            } else {
                o.s(" more times\n");
            }
            i = j;
        }
        i -= 1;
    }
    if depth > SS_CAP {
        o.s("  ... ");
        o.u(@as(u64, depth - SS_CAP));
        o.s(" more frames\n");
    }
}

pub fn format_error_trace(o: *mut Fmt, ss: *ShadowStack) void {
    if is_null(@ptr_cast(*void, ss)) or (ss.errors == 0) {
        return;
    }
    o.s("error return trace (oldest first):\n");
    let mut first: u32 = 0;
    if ss.errors > ET_CAP {
        first = ss.errors - ET_CAP;
    }
    for i in first..ss.errors {
        let e = ss.error_returns[@as(usize, i & (ET_CAP - 1))];
        if is_null(@ptr_cast(*void, e)) {
            continue;
        }
        o.s("  ");
        o.s(cstr(e.file));
        o.c(':');
        o.u(@as(u64, e.line));
        o.c(':');
        o.u(@as(u64, e.col));
        o.s(" in ");
        o.s(cstr(e.fn_));
        o.s(": ");
        o.s(cstr(e.text));
        o.s("\n");
    }
}

// -----------------------------------------------------------------------------
// Stack traces from frame pointers (issue 0053). Natively, calls do not
// record themselves on the shadow stack: code keeps frame pointers, and the
// frame table (selfhost/src/ftab.ax; axiom_frame_table() gives its bounds)
// maps each call's return address to its call-site records, innermost first
// (its own, then those of the calls inlined around it). A trap or a crash
// walks the frame-pointer chain and fills the thread's shadow stack (calls
// and depth) as the calls would have, so reports are made as before.
// -----------------------------------------------------------------------------
const RET_FRAMELESS: u32 = 1;  // in a function without a frame
const RET_MARKER: u32 = 2;     // not a call: the start or end of such a function

fn rd_usize(a: usize) usize {
    return @ptr_from_int(*usize, a).*;
}

fn rd_i32(a: usize) i32 {
    return @ptr_from_int(*i32, a).*;
}

fn ent_ret(e: usize) usize {
    return e +% @bit_cast(usize, @as(isize, rd_i32(e)));
}

fn ent_flags(e: usize) u32 {
    return @bit_cast(u32, rd_i32(e + 4)) & 3;
}

fn ent_chain(e: usize) usize {
    return (e + 4) +% @bit_cast(usize, @as(isize, rd_i32(e + 4) & ~@as(i32, 3)));
}

// 0: not yet checked, 1: sorted, 2: not (then searched linearly)
let mut rets_order: u32 = 0;

fn rets_sorted(a: usize, n: usize) bool {
    if rets_order == 0 {
        let mut ok = true;
        for i in 1..n {
            if ent_ret(a + (8 * i)) < ent_ret(a + (8 * (i - 1))) {
                ok = false;
                break;
            }
        }
        rets_order = 2;
        if ok {
            rets_order = 1;
        }
    }
    return rets_order == 1;
}

// The first entry whose label is at or after x (or n).
fn rets_lower(a: usize, n: usize, x: usize) usize {
    let mut lo: usize = 0;
    let mut hi = n;
    while lo < hi {
        let m = lo + ((hi - lo) / 2);
        if ent_ret(a + (8 * m)) < x {
            lo = m + 1;
        } else {
            hi = m;
        }
    }
    return lo;
}

// The entry of the call returning to ra, or 0.
fn rets_find(a: usize, n: usize, ra: usize) usize {
    if rets_sorted(a, n) {
        let mut i = rets_lower(a, n, ra);
        while (i < n) and (ent_ret(a + (8 * i)) == ra) {
            if (ent_flags(a + (8 * i)) & RET_MARKER) == 0 {
                return a + (8 * i);
            }
            i += 1;
        }
        return 0;
    }
    for i in 0..n {
        let e = a + (8 * i);
        if (ent_ret(e) == ra) and ((ent_flags(e) & RET_MARKER) == 0) {
            return e;
        }
    }
    return 0;
}

// Is pc in a function without a frame (its return address is then at the
// stack pointer, or in the link register)? The first entry after pc says.
fn rets_frameless(a: usize, n: usize, pc: usize) bool {
    let mut best: usize = 0;
    if rets_sorted(a, n) {
        let i = rets_lower(a, n, pc + 1);
        if i < n {
            best = a + (8 * i);
        }
    } else {
        for i in 0..n {
            let e = a + (8 * i);
            if (ent_ret(e) > pc) and ((best == 0) or (ent_ret(e) < ent_ret(best))) {
                best = e;
            }
        }
    }
    return (best != 0) and ((ent_flags(best) & RET_FRAMELESS) != 0);
}

// The frame table: its first entry and their number (0: there is none).
fn rets_table(tab: *usize, n: *mut usize) usize {
    n.* = 0;
    if is_null(@ptr_cast(*void, tab)) {
        return 0;
    }
    let a = rd_usize(@int_from_ptr(tab));
    let b = rd_usize(@int_from_ptr(tab) + 8);
    if (a == 0) or (b <= a) {
        return 0;
    }
    n.* = (b - a) / 8;
    return a;
}

// A walk: counts the records (innermost first) and, when `ss` is set,
// stores the innermost SS_CAP of the `total` there.
struct Walk {
    a: usize,
    n: usize,
    k: u64,
    total: u64,
    ss: *mut ShadowStack,
}

fn walk_add(w: *mut Walk, ra: usize) usize {
    let e = rets_find(w.a, w.n, ra);
    if e == 0 {
        return 0;
    }
    let mut c = ent_chain(e);
    while rd_usize(c) != 0 {
        if not is_null(@ptr_cast(*void, w.ss)) and (w.k < @as(u64, SS_CAP)) {
            w.ss.calls[@truncate(usize, (w.total - 1 - w.k) & @as(u64, SS_CAP - 1))] = @ptr_from_int(
                *Site, rd_usize(c));
        }
        w.k += 1;
        c += 8;
    }
    return e;
}

fn walk_once(w: *mut Walk, fp: usize, sp: usize, top: usize, leaf_ra: usize, x64: bool) void {
    if leaf_ra != 0 {
        _ = walk_add(w, leaf_ra);
    }
    let mut f = fp;
    while (f >= sp) and ((f + 32) <= top) and ((f & 7) == 0) {
        let e = walk_add(w, rd_usize(f + 8));
        if x64 and (e != 0) and ((ent_flags(e) & RET_FRAMELESS) != 0) {
            _ = walk_add(w, rd_usize(f + 24));
        }
        let next = rd_usize(f);
        if next <= f {
            break;
        }
        f = next;
    }
}

// Is pc in a function without a frame? (Then a crash there finds that
// function's return address at the stack pointer (x86-64) or in the link
// register (AArch64), and walk_frames is given it as leaf_ra.)
pub fn frameless_at(tab: *usize, pc: usize) bool {
    let mut n: usize = 0;
    let a = rets_table(tab, &mut n);
    return (n != 0) and rets_frameless(a, n, pc);
}

// Fills `ss` from the frames, starting at the frame record `fp` ({the
// caller's frame pointer, the return address}), after `leaf_ra` (when not
// 0: the return address of a function without a frame that the walk starts
// in). The walk reads frames between `sp` and `hi`, the top of the stack's
// Axiom frames (0: not known, then up to 1 GiB). On x86-64 (`x64`) a
// function without a frame calls only functions that do not return, after
// aligning the stack: its own return address is 16 bytes above theirs.
pub fn walk_frames(tab: *usize, ss: *mut ShadowStack, fp: usize, sp: usize, hi: usize, leaf_ra: usize, x64: bool) void {
    let mut n: usize = 0;
    let a = rets_table(tab, &mut n);
    if (n == 0) or is_null(@ptr_cast(*void, ss)) {
        return;
    }
    let mut top = sp +% (@as(usize, 1) << 30);
    if hi > sp {
        top = hi;
    }
    // count, then store (no buffer: this runs on whatever stack is left)
    let mut w = Walk.{ a: a, n: n, k: 0, total: 0, ss: @ptr_from_int(*mut ShadowStack, 0) };
    walk_once(&mut w, fp, sp, top, leaf_ra, x64);
    w.total = w.k;
    w.k = 0;
    w.ss = ss;
    walk_once(&mut w, fp, sp, top, leaf_ra, x64);
    let mut d = w.total;
    if d > 0xFFFF_FFFF {
        d = 0xFFFF_FFFF;
    }
    ss.depth = @truncate(u32, d);
}
