// =============================================================================
// runtime/profile_windows.ax - the sampling profiler (spec §16.6) on
// Windows, in place of runtime/profile.ax. `axiom profile` builds it in and
// runs the program with AXIOM_PROFILE=<raw output file> and
// AXIOM_PROFILE_HZ=<rate>; the output is the same raw format.
//
// Windows has no CPU-time signals, so a sampler thread does what SIGPROF does
// on Linux. Each Axiom thread registers itself (runtime/windows.ax calls
// thread_hook as threads start and end). At every tick the sampler reads each
// thread's cycle count (QueryThreadCycleTime) and credits it the CPU time it
// used since the last tick; a thread with a period's worth of credit is
// suspended, its shadow stack (§16.4) copied, and resumed, with the sample
// weighted by the periods it stands for. (Where there is no cycle count,
// under Wine, the thread's CPU times stand in: coarser, since the system
// updates them at its clock ticks, but the totals are right.) So, as on
// Linux, the counts measure CPU time, and a thread that waits is not
// sampled.
//
// The sampler is the only writer of the sample buffer, and it holds
// reg_lock through each tick; the threads take it only to register. It never
// allocates while a thread is suspended (that thread may hold the heap's
// lock).
// =============================================================================
import "trap_format.ax" as tf;
import "windows.ax" as rt;

extern "C" {
    fn GetCurrentThread() usize;
    fn GetCurrentThreadId() u32;
    fn SuspendThread(h: usize) u32;
    fn ResumeThread(h: usize) u32;
    fn GetThreadContext(h: usize, ctx: *mut u8) i32;
    fn QueryThreadCycleTime(h: usize, cycles: *mut u64) i32;
    fn GetThreadTimes(h: usize, created: *mut u64, exited: *mut u64, kernel: *mut u64, user: *mut u64) i32;
    fn CreateWaitableTimerExW(sa: *void, name: *u16, flags: u32, access: u32) usize;
    fn SetWaitableTimer(h: usize, due: *i64, period: i32, f: *void, arg: *void, resume: i32) i32;
    fn SetThreadPriority(h: usize, priority: i32) i32;
    fn ax_getenv(name: *u8, len: usize, buf: *mut u8, cap: usize) isize;
    fn ax_sleep_ns(ns: u64) void;
}

struct Entry {
    at: usize,  // offset of the sample in buf
    count: u64,
}

// A registered thread.
struct Slot {
    tid: u32,
    h: usize,  // a real handle (not the pseudo-handle) with suspend access
    ss: *tf.ShadowStack,
    last: u64,    // its cycle count at the last tick
    credit: i64,  // cycles used and not yet sampled
    main: bool,
}

const BUF_WORDS: usize = 32 << 20;  // 256 MiB of address space, committed as used
const COMMIT: usize = 1 << 20;      // bytes committed at a time
const THREAD_BIT: u64 = 1 << 63;
const NSLOTS: usize = 1024;
const MEM_COMMIT: u32 = 0x1000;
const MEM_RESERVE: u32 = 0x2000;
const PAGE_READWRITE: u32 = 4;

let mut buf: *mut u64 = @ptr_from_int(*mut u64, 0);
let mut buf_pos: usize = 0;
let mut committed: usize = 0;  // bytes of buf committed
let mut dropped: u64 = 0;
let mut hz: i32 = 999;
let mut period: i64 = 0;          // cycles per sampling period
let mut use_times: bool = false;  // CPU times (100 ns units) in place of cycles
let mut out_path: [1024]u16 = [0; 1024];
let mut written: bool = false;
let mut stopped: bool = false;
let mut reg_lock: usize = 0;
let mut slots: [1024]Slot = [Slot.{ tid: 0, h: 0, ss: @ptr_from_int(*tf.ShadowStack, 0), last: 0, credit: 0,
                                    main: false }; 1024];
let mut nslots: usize = 0;
let mut ctx: usize = 0;  // a CONTEXT (16-byte aligned) for GetThreadContext

fn words() []mut u64 {
    return @slice_from_ptr(buf, BUF_WORDS);
}

fn cycles(h: usize) u64 {
    let mut c: u64 = 0;
    if use_times {
        let mut t: [4]u64 = [0; 4];
        _ = GetThreadTimes(h, &mut t[0], &mut t[1], &mut t[2], &mut t[3]);
        return t[2] + t[3];
    }
    _ = QueryThreadCycleTime(h, &mut c);
    return c;
}

fn qpc() i64 {
    let mut c: i64 = 0;
    _ = rt.QueryPerformanceCounter(&mut c);
    return c;
}

// The rate of the cycle counter (the processor's time-stamp counter), in
// cycles per second: this thread spins for 2 ms a few times. Being preempted
// only lowers a measurement, so the largest is kept.
fn cycle_rate() i64 {
    let mut f: i64 = 0;
    _ = rt.QueryPerformanceFrequency(&mut f);
    let me = GetCurrentThread();
    let mut best: i64 = 0;
    for trial in @as(u32, 0)..5 {
        _ = trial;
        let q0 = qpc();
        let c0 = cycles(me);
        let mut q1 = qpc();
        while (q1 - q0) < (f / 500) {
            q1 = qpc();
        }
        let c1 = cycles(me);
        let r = (@bit_cast(i64, c1 - c0) * f) / (q1 - q0);
        if r > best {
            best = r;
        }
    }
    return best;
}

// Adds the calling thread to the threads sampled (or, start false, removes it).
fn register(start: bool) void {
    let tid = GetCurrentThreadId();
    rt.AcquireSRWLockExclusive(&mut reg_lock);
    if start {
        let mut h: usize = 0;
        // THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_LIMITED_INFORMATION
        if (nslots < NSLOTS) and
           (rt.DuplicateHandle(rt.GetCurrentProcess(), GetCurrentThread(), rt.GetCurrentProcess(), &mut h, 0x0802, 0,
                               0) != 0) {
            slots[nslots] = Slot.{ tid: tid, h: h, ss: rt.axiom_shadow_stack(), last: cycles(h), credit: 0,
                                   main: nslots == 0 };
            nslots += 1;
        }
    } else {
        for i in 0..nslots {
            if slots[i].tid == tid {
                _ = rt.CloseHandle(slots[i].h);
                nslots -= 1;
                slots[i] = slots[nslots];
                break;
            }
        }
    }
    rt.ReleaseSRWLockExclusive(&mut reg_lock);
}

// Room for n more words of samples; false when the buffer is full.
fn reserve(n: usize) bool {
    let end = buf_pos + n;
    if end > BUF_WORDS {
        return false;
    }
    while (end * 8) > committed {
        if rt.VirtualAlloc(@int_from_ptr(buf) + committed, COMMIT, MEM_COMMIT, PAGE_READWRITE) == 0 {
            return false;
        }
        committed += COMMIT;
    }
    return true;
}

// Each sample: [depth (top bit: not the main thread), weight, frames...].
fn sample(s: *mut Slot, weight: u64) void {
    if SuspendThread(s.h) == 0xffff_ffff {
        return;
    }
    // Suspension is asynchronous; asking for the thread's registers waits
    // until it has stopped.
    _ = GetThreadContext(s.h, @ptr_from_int(*mut u8, ctx));
    let ss = s.ss;
    let depth = ss.depth;
    let mut n = depth;
    if n > tf.SS_CAP {
        n = tf.SS_CAP;
    }
    if reserve(@as(usize, n) + 2) {
        let w = words();
        let at = buf_pos;
        w[at] = @as(u64, depth);
        if not s.main {
            w[at] = w[at] | THREAD_BIT;
        }
        w[at + 1] = weight;
        for i in 0..n {
            w[at + 2 + @as(usize, i)] = @as(u64, @int_from_ptr(tf.call_at(ss, (depth - 1) - i)));
        }
        buf_pos = at + @as(usize, n) + 2;
    } else {
        dropped += 1;
    }
    _ = ResumeThread(s.h);
}

fn tick() bool {
    rt.AcquireSRWLockExclusive(&mut reg_lock);
    if stopped {
        rt.ReleaseSRWLockExclusive(&mut reg_lock);
        return false;
    }
    for i in 0..nslots {
        let s = &mut slots[i];
        let c = cycles(s.h);
        s.credit += @bit_cast(i64, c - s.last);
        s.last = c;
        if (s.credit * 2) < period {
            continue;
        }
        let weight = (s.credit + (period / 2)) / period;
        s.credit -= weight * period;
        if not tf.is_null(@ptr_cast(*void, s.ss)) {
            sample(s, @bit_cast(u64, weight));
        }
    }
    rt.ReleaseSRWLockExclusive(&mut reg_lock);
    return true;
}

fn sampler(arg: *mut void) u32 {
    _ = arg;
    // a high-resolution timer where there is one (Windows 10 1803 and later)
    let mut timer = CreateWaitableTimerExW(@ptr_from_int(*void, 0), @ptr_from_int(*u16, 0), 2, 0x1f_0003);
    if timer == 0 {
        timer = CreateWaitableTimerExW(@ptr_from_int(*void, 0), @ptr_from_int(*u16, 0), 0, 0x1f_0003);
    }
    let due = -@as(i64, 10_000_000 / hz);  // 100 ns units, relative
    loop {
        if (timer == 0) or
           (SetWaitableTimer(timer, &due, 0, @ptr_from_int(*void, 0), @ptr_from_int(*void, 0), 0) == 0) {
            ax_sleep_ns(@as(u64, 1_000_000_000 / @as(u64, @bit_cast(u32, hz))));
        } else {
            _ = rt.WaitForSingleObject(timer, 0xffff_ffff);
        }
        if not tick() {
            return 0;
        }
    }
}

fn thread_event(start: bool) void {
    register(start);
}

fn hash_words(s: []u64) u64 {
    let mut h: u64 = 1469598103934665603;
    for x in s {
        h = (h ^ x) *% 1099511628211;
    }
    return h;
}

fn sample_len(at: usize) usize {
    let d = words()[at] & ~THREAD_BIT;
    if d < @as(u64, tf.SS_CAP) {
        return 2 + @truncate(usize, d);
    }
    return 2 + @as(usize, tf.SS_CAP);
}

// Buffered output to a file.
struct Out {
    h: usize,
    n: usize,
    b: [8192]u8,
}

fn out_flush(o: *mut Out) void {
    let mut off: usize = 0;
    while off < o.n {
        let mut put: u32 = 0;
        if rt.WriteFile(o.h, &o.b[off], @truncate(u32, o.n - off), &mut put, @ptr_from_int(*mut void, 0)) == 0 {
            break;
        }
        off += @as(usize, put);
    }
    o.n = 0;
}

fn out_s(o: *mut Out, s: []u8) void {
    for c in s {
        if o.n == 8192 {
            out_flush(o);
        }
        o.b[o.n] = c;
        o.n += 1;
    }
}

fn out_u(o: *mut Out, v: u64) void {
    let mut tmp: [24]u8 = [0; 24];
    let mut f = tf.fmt(tmp[..]);
    f.u(v);
    out_s(o, f.text());
}

fn put_site(o: *mut Out, s: *tf.Site) void {
    out_s(o, "\t");
    out_u(o, @as(u64, s.file_id));
    out_s(o, "\x1f");
    out_u(o, @as(u64, s.start));
    out_s(o, "\x1f");
    out_u(o, @as(u64, s.end));
    out_s(o, "\x1f");
    out_s(o, tf.cstr(s.fn_));
}

fn same_sample(a: usize, b: usize, n: usize) bool {
    let w = words();
    if (sample_len(a) != n) or (w[a] != w[b]) {
        return false;
    }
    for k in 2..n {
        if w[a + k] != w[b + k] {
            return false;
        }
    }
    return true;
}

fn alloc(n: usize) usize {
    return rt.VirtualAlloc(0, n, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
}

fn write_profile() void {
    if written or (@int_from_ptr(buf) == 0) {
        return;
    }
    written = true;
    rt.has_thread_hook = false;
    // stop the sampler (it may be in the middle of a tick)
    rt.AcquireSRWLockExclusive(&mut reg_lock);
    stopped = true;
    rt.ReleaseSRWLockExclusive(&mut reg_lock);
    let end = buf_pos;
    // GENERIC_WRITE, CREATE_ALWAYS
    let h = rt.CreateFileW(&out_path[0], 0x4000_0000, 7, @ptr_from_int(*void, 0), 2, 0x80, 0);
    if h == ~@as(usize, 0) {
        return;
    }
    let o = @ptr_from_int(*mut Out, alloc(@size_of(Out)));
    if @int_from_ptr(o) == 0 {
        _ = rt.CloseHandle(h);
        return;
    }
    o.h = h;
    o.n = 0;
    out_s(o, "# axiom-profile-raw 1\nhz ");
    out_u(o, @as(u64, @bit_cast(u32, hz)));
    out_s(o, "\nclock cpu\n");
    if dropped != 0 {
        out_s(o, "dropped ");
        out_u(o, dropped);
        out_s(o, "\n");
    }
    let mut cap: usize = 1024;
    while cap < (end / 4) {
        cap = cap << 1;
    }
    let tp = @ptr_from_int(*mut Entry, alloc(cap * @size_of(Entry)));  // (zeroed)
    if @int_from_ptr(tp) == 0 {
        out_flush(o);
        _ = rt.CloseHandle(h);
        return;
    }
    let tab = @slice_from_ptr(tp, cap);
    let w = words();
    let mut at: usize = 0;
    while at < end {
        let n = sample_len(at);
        if (at + n) > end {
            break;
        }
        let wt = w[at + 1];
        let mut k = @truncate(usize, hash_words(w[at..at + 1]) ^ hash_words(w[at + 2..at + n])) & (cap - 1);
        loop {
            if tab[k].count == 0 {
                tab[k].at = at;
                tab[k].count = wt;
                break;
            }
            if same_sample(tab[k].at, at, n) {
                tab[k].count += wt;
                break;
            }
            k = (k + 1) & (cap - 1);
        }
        at += n;
    }
    for i in 0..cap {
        if tab[i].count == 0 {
            continue;
        }
        let s = tab[i].at;
        let n = sample_len(s) - 2;
        let mut leaf: []u8 = "main";
        if n > 0 {
            let inner = @ptr_from_int(*tf.Site, @truncate(usize, w[s + 2]));
            leaf = tf.cstr(inner.callee);
            if leaf.len == 0 {
                leaf = "<indirect call>";
            }
        } else if (w[s] & THREAD_BIT) != 0 {
            leaf = "<thread entry>";
        }
        out_s(o, "S\t");
        out_u(o, tab[i].count);
        out_s(o, "\t");
        out_u(o, w[s] & ~THREAD_BIT);
        out_s(o, "\t");
        out_s(o, leaf);
        for j in 0..n {
            put_site(o, @ptr_from_int(*tf.Site, @truncate(usize, w[s + 2 + j])));
        }
        out_s(o, "\n");
    }
    out_flush(o);
    _ = rt.CloseHandle(h);
}

export fn ax_profile_start() void {
    let name: [14]u16 = ['A', 'X', 'I', 'O', 'M', '_', 'P', 'R', 'O', 'F', 'I', 'L', 'E', 0];
    let n = rt.GetEnvironmentVariableW(&name[0], &mut out_path[0], 1024);
    if (n == 0) or (n >= 1024) {
        return;
    }
    let mut r: [16]u8 = [0; 16];
    let rn = ax_getenv("AXIOM_PROFILE_HZ".ptr, 16, &mut r[0], 16);
    let mut v: i32 = 0;
    if rn > 0 {
        for c in r[0..@min(@bit_cast(usize, rn), r.len)] {
            if (c < '0') or (c > '9') or (v > 1_000_000) {
                break;
            }
            v = (v * 10) + @as(i32, c - '0');
        }
    }
    if v > 0 {
        hz = v;
    }
    let mut rate = cycle_rate();
    if rate <= 0 {
        use_times = true;
        rate = 10_000_000;
    }
    period = rate / @as(i64, hz);
    if period <= 0 {
        return;
    }
    let p = rt.VirtualAlloc(0, BUF_WORDS * 8, MEM_RESERVE, PAGE_READWRITE);
    ctx = alloc(4096);
    if (p == 0) or (ctx == 0) {
        return;
    }
    @ptr_from_int(*mut u32, ctx + 0x30).* = 0x10_0001;  // ContextFlags: CONTEXT_AMD64 | CONTEXT_CONTROL
    buf = @ptr_from_int(*mut u64, p);
    register(true);  // the main thread
    rt.thread_hook = thread_event;
    rt.has_thread_hook = true;
    // written when main returns (ax_rt_fini), at exit, or at a trap or crash
    rt.profile_flush = write_profile;
    rt.has_profile = true;
    let t = rt.CreateThread(@ptr_from_int(*void, 0), 1 << 20, sampler, @ptr_from_int(*mut void, 0), 0x1_0000,
                            @ptr_from_int(*mut u32, 0));
    if t != 0 {
        _ = SetThreadPriority(t, 2);  // above the program's threads, so ticks are on time
        _ = rt.CloseHandle(t);
    }
}
