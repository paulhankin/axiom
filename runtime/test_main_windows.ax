// =============================================================================
// runtime/test_main_windows.ax - runs the tests of a native Axiom test
// binary on Windows. Windows cannot fork, so each test runs in a new process
// of the same program (--axiom-test-child=<i>), with its output on one pipe
// and its record (runtime/test_report.ax) on another, whose handle it is
// given (--axiom-result=<handle>). A test that runs too long is ended.
// =============================================================================
import "test_report.ax" as rep;
import "trap_format.ax" as tf;
import "windows.ax" as rt;

extern "C" {
    fn axiom_test_count() u32;
    fn axiom_test_name(i: u32) *u8;
    fn axiom_test_expect(i: u32) i32;
    fn axiom_test_run(i: u32) u32;
    fn axiom_test_leaks() u32;
    fn GetModuleFileNameW(module: usize, buf: *mut u16, n: u32) u32;
    fn ax_argc() i32;
    fn ax_arg(i: i32, buf: *mut u8, cap: usize) isize;
    fn ax_clock_ns(clock: u32) i64;
}

let mut result_h: usize = 0;
let mut rec: [32768]u8 = [0; 32768];

fn write_h(h: usize, s: []u8) void {
    let mut off: usize = 0;
    while off < s.len {
        let mut put: u32 = 0;
        if rt.WriteFile(h, &s[off], @truncate(u32, s.len - off), &mut put, @ptr_from_int(*mut void, 0)) == 0 {
            return;
        }
        off += @as(usize, put);
    }
}

fn emit(o: *tf.Fmt) void {
    if result_h != 0 {
        write_h(result_h, o.text());
    }
}

fn on_trap(site: *tf.Site, info: *tf.TrapInfo, ss: *tf.ShadowStack) void {
    let mut o = tf.fmt(rec[..]);
    rep.trap_record(&mut o, site, info, ss);
    emit(&o);
}

fn on_crash(code: u64) void {
    let mut o = tf.fmt(rec[..]);
    rep.crash_record(&mut o, code, rt.axiom_shadow_stack());
    emit(&o);
}

fn heap(n: usize) usize {
    return @int_from_ptr(rt.malloc(n));
}

fn unheap(p: usize, n: usize) void {
    _ = n;
    rt.free(@ptr_from_int(*mut void, p));
}

fn new_buf() rep.Buf {
    return rep.buf(heap, unheap);
}

// The child: runs test i, then writes how it ended.
fn run_child(i: u32) void {
    rt.trap_hook = on_trap;
    rt.has_trap_hook = true;
    rt.crash_hook = on_crash;
    rt.has_crash_hook = true;
    let code = axiom_test_run(i);
    let mut o = tf.fmt(rec[..]);
    rep.done_record(&mut o, code, rt.axiom_shadow_stack(), axiom_test_leaks());
    emit(&o);
    rt.ExitProcess(0);
}

// Reads h to its end into b.
fn read_all(h: usize, b: *mut rep.Buf) void {
    let mut chunk: [4096]u8 = [0; 4096];
    loop {
        let mut got: u32 = 0;
        if (rt.ReadFile(h, &mut chunk[0], 4096, &mut got, @ptr_from_int(*mut void, 0)) == 0) or (got == 0) {
            return;
        }
        rep.buf_add(b, chunk[0..@as(usize, got)]);
    }
}

struct Drain {
    h: usize,
    b: rep.Buf,
}

fn drain_main(p: *mut void) u32 {
    let d = @ptr_cast(*mut Drain, p);
    read_all(d.h, &mut d.b);
    return 0;
}

fn arg(i: i32, buf: []mut u8) []u8 {
    let n = ax_arg(i, &mut buf[0], buf.len);
    if (n < 0) or (@bit_cast(usize, n) > buf.len) {
        return "";
    }
    return buf[0..@bit_cast(usize, n)];
}

fn wput_dec(w: []mut u16, at: *mut usize, x: u64) void {
    let mut d: [20]u8 = [0; 20];
    let mut n: usize = 0;
    let mut v = x;
    loop {
        d[n] = '0' + @truncate(u8, v % 10);
        n += 1;
        v /= 10;
        if v == 0 {
            break;
        }
    }
    while n > 0 {
        n -= 1;
        w[at.*] = @as(u16, d[n]);
        at.* += 1;
    }
}

fn wput(w: []mut u16, at: *mut usize, s: []u8) void {
    for c in s {
        w[at.*] = @as(u16, c);
        at.* += 1;
    }
}

export fn ax_test_main(argc: i32, argv: *mut *mut u8) i32 {
    _ = argc;
    _ = argv;
    let mut filter: []u8 = "";
    let mut timeout_ms: i64 = 10000;
    let mut child: i64 = -1;
    let mut abuf: [8][1024]u8 = [[0; 1024]; 8];
    let na = @min(ax_argc(), 8);
    for k in 1..na {
        let a = arg(k, abuf[@as(usize, @bit_cast(u32, k))][..]);
        if rep.starts(a, "--filter=") {
            filter = a[9..];
        } else if rep.starts(a, "--timeout=") {
            let mut at: usize = 10;
            timeout_ms = @bit_cast(i64, rep.num(a, &mut at));
        } else if rep.starts(a, "--axiom-test-child=") {
            let mut at: usize = 19;
            child = @bit_cast(i64, rep.num(a, &mut at));
        } else if rep.starts(a, "--axiom-result=") {
            let mut at: usize = 15;
            result_h = @truncate(usize, rep.num(a, &mut at));
        }
    }
    if child >= 0 {
        run_child(@truncate(u32, @bit_cast(u64, child)));
    }
    let mut exe: [4096]u16 = [0; 4096];
    let el = @as(usize, GetModuleFileNameW(0, &mut exe[0], 4000));
    if (el == 0) or (el >= 4000) {
        return 2;
    }
    let n = axiom_test_count();
    for i in 0..n {
        if (filter.len > 0) and not rep.contains(tf.cstr(axiom_test_name(i)), filter) {
            continue;
        }
        let expect = axiom_test_expect(i);
        // the pipes: the child writes to inheritable ends
        let sa: [3]u64 = [24, 0, 1];
        let mut res_r: usize = 0;
        let mut res_w: usize = 0;
        let mut out_r: usize = 0;
        let mut out_w: usize = 0;
        if (rt.CreatePipe(&mut res_r, &mut res_w, @ptr_cast(*void, &sa[0]), 65536) == 0) or
           (rt.CreatePipe(&mut out_r, &mut out_w, @ptr_cast(*void, &sa[0]), 0) == 0) {
            return 2;
        }
        _ = rt.SetHandleInformation(res_r, 1, 0);
        _ = rt.SetHandleInformation(out_r, 1, 0);
        let mut cmd: [4200]u16 = [0; 4200];
        let mut at: usize = 0;
        cmd[0] = '"';
        @mem_copy(cmd[1..el + 1], exe[0..el]);
        at = el + 1;
        wput(cmd[..], &mut at, "\" --axiom-test-child=");
        wput_dec(cmd[..], &mut at, @as(u64, i));
        wput(cmd[..], &mut at, " --axiom-result=");
        wput_dec(cmd[..], &mut at, @as(u64, res_w));
        cmd[at] = 0;
        let mut si: [104]u8 = [0; 104];
        si[0] = 104;
        si[61] = 1;  // dwFlags: STARTF_USESTDHANDLES (0x100)
        let ow = @as(u64, out_w);
        for k in @as(usize, 0)..8 {
            si[88 + k] = @truncate(u8, ow >> @as(u64, k * 8));
            si[96 + k] = @truncate(u8, ow >> @as(u64, k * 8));
        }
        let mut pi: [24]u8 = [0; 24];
        let t0 = ax_clock_ns(1);
        let ok = rt.CreateProcessW(&exe[0], &mut cmd[0], @ptr_from_int(*void, 0), @ptr_from_int(*void, 0), 1, 0,
                                   @ptr_from_int(*void, 0), @ptr_from_int(*u16, 0), &si[0], &mut pi[0]);
        _ = rt.CloseHandle(res_w);
        _ = rt.CloseHandle(out_w);
        if ok == 0 {
            _ = rt.CloseHandle(res_r);
            _ = rt.CloseHandle(out_r);
            return 2;
        }
        let mut ph: usize = 0;
        let mut th: usize = 0;
        for k in @as(usize, 0)..8 {
            ph = ph | (@as(usize, pi[k]) << @as(usize, k * 8));
            th = th | (@as(usize, pi[8 + k]) << @as(usize, k * 8));
        }
        _ = rt.CloseHandle(th);
        // the output, drained while the test runs (a full pipe would stop it)
        let mut d = Drain.{ h: out_r, b: new_buf() };
        let dt = rt.CreateThread(@ptr_from_int(*void, 0), 65536, drain_main, @ptr_cast(*mut void, &mut d), 0,
                                 @ptr_from_int(*mut u32, 0));
        let mut how = rep.ENDED;
        if rt.WaitForSingleObject(ph, @truncate(u32, @bit_cast(u64, timeout_ms))) != 0 {
            _ = rt.TerminateProcess(ph, 1);
            _ = rt.WaitForSingleObject(ph, 0xffff_ffff);
            how = rep.TIMEOUT;
        }
        let ms = @float_from_int(f64, ax_clock_ns(1) - t0) / 1e6;
        let mut code: u32 = 0;
        _ = rt.GetExitCodeProcess(ph, &mut code);
        _ = rt.CloseHandle(ph);
        // (a process the test started may hold the output open: wait a while)
        if dt != 0 {
            _ = rt.WaitForSingleObject(dt, 5000);
            _ = rt.CloseHandle(dt);
        }
        let mut resb = new_buf();
        read_all(res_r, &mut resb);
        _ = rt.CloseHandle(res_r);
        _ = rt.CloseHandle(out_r);
        let mut status = @bit_cast(i32, code);
        if how == rep.ENDED {
            let sig = rt.exception_sig(code);
            if sig != 0 {
                how = rep.SIGNALED;
                status = sig;
            }
        }
        let mut line = new_buf();
        rep.report(&mut line, i, expect, rep.buf_text(&resb), rep.buf_text(&d.b), how, status, ms, timeout_ms);
        write_h(rt.GetStdHandle(0xffff_fff5), rep.buf_text(&line));
        rep.buf_free(&mut line);
        rep.buf_free(&mut d.b);
        rep.buf_free(&mut resb);
    }
    return 0;
}
