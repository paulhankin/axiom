    Builtin.{ name: "arm_sha512su0", sig: "ee" },
    Builtin.{ name: "arm_sha512su1", sig: "eee" },
    Builtin.{ name: "arm_eor3", sig: "eee" },
    Builtin.{ name: "arm_bcax", sig: "eee" },
    Builtin.{ name: "arm_rax1", sig: "ee" },
    Builtin.{ name: "arm_xar", sig: "eee" },
    Builtin.{ name: "arm_crc32", sig: "ee" },
    Builtin.{ name: "arm_crc32c", sig: "ee" },
    Builtin.{ name: "load_partial", sig: "te" },
    Builtin.{ name: "store_partial", sig: "ee" },
    Builtin.{ name: "swizzle2", sig: "eee" },
    Builtin.{ name: "widen_low", sig: "e" },
    Builtin.{ name: "widen_high", sig: "e" },
    Builtin.{ name: "narrow", sig: "tee" },
    Builtin.{ name: "ptr_add", sig: "ee" },
    Builtin.{ name: "ptr_sub", sig: "ee" },
    Builtin.{ name: "prefetch", sig: "e" },
    Builtin.{ name: "prefetch_write", sig: "e" },
];

pub fn builtin_name(i: i32) []u8 {
    return builtins[@int_cast(usize, i)].name;
}

pub fn builtin_sig(i: i32) []u8 {
    return builtins[@int_cast(usize, i)].sig;
}

pub fn builtin_lookup(name: []u8) i32 {
    for i in 0..BI_COUNT {
        if u.str_eq(builtin_name(i), name) {
            return i;
        }
    }
    return -1;
}

// ---------------------------------------------------------------------------
// Type expressions (syntax of types)
// ---------------------------------------------------------------------------
pub struct Field {
    name: []u8,
    te: *mut TypeExpr,
    span: u.Span,
    ty: *mut Type,
}

pub struct TypeExpr {
    span: u.Span,
    shape: TypeShape,
}

// A type expression, as written.
pub union TypeShape {
    Prim: i32,  // a lexer PRIM_ code
    Named: NamedType,
    Ptr: PtrType,
    Slice: PtrType,
    Array: ArrayType,
    Fn: FnType,
    AnonStruct: u.List.[Field],
    ErrUnion: *mut TypeExpr,  // !T
    Error,
    SelfType,     // Self
    IntLit: u64,  // a generic argument or array length
}

// [mod.]Name, with generic arguments if has_args.
pub struct NamedType {
    qual: []u8,  // module qualifier, or no string
    name: []u8,
    name_span: u.Span,
    args: u.List.[*mut TypeExpr],
    has_args: bool,
}

// *T, *mut T, []T or []mut T.
pub struct PtrType {
    elem: *mut TypeExpr,
    is_mut: bool,
}

pub struct ArrayType {
    elem: *mut TypeExpr,
    len: *mut TypeExpr,  // IntLit or Named
}

pub struct FnType {
    params: u.List.[*mut TypeExpr],
    ret: *mut TypeExpr,
}

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------
pub struct FieldInit {
    name: []u8,
    span: u.Span,
    value: *mut Expr,
}

pub struct BuiltinArg {
    e: *mut Expr,
    t: *mut TypeExpr,
}

pub struct Expr {
    kind: ExprKind,
    span: u.Span,
    parens: bool,
    // payload
    name: []u8,
    name_span: u.Span,
    ival: u64,
    fval: f64,
    float_text: []u8,
    str: []u8,
    bval: bool,
    op: i32,  // E_UNARY, E_BINARY: the operator's token kind
    conv: Conv,
    call_kind: CallKind,
    field_kind: FieldKind,
    index_kind: IndexKind,
    a: *mut Expr,
    b: *mut Expr,
    c: *mut Expr,
    args: u.List.[*mut Expr],
    inits: u.List.[FieldInit],
    bargs: u.List.[BuiltinArg],
    targs: u.List.[*mut TypeExpr],
    // catch
    capture: []u8,
    capture_span: u.Span,
    handler: Handler,
    capture_local: *mut Local,

    // ---- sema annotations ----
    ty: *mut Type,
    cat: Cat,
    local: *mut Local,  // ident -> local
    decl: *mut Decl,    // ident/field -> global/const/fn/type decl; call -> callee fn
    module: *mut Module,
    gargs: []mut *mut Type,  // CAT_FUNC / call: generic args (owner args ++ own args)
    self_mode: SelfMode,
    index: i32,       // field index / variant index
    builtin: i32,     // E_BUILTIN: BI_*, or -1 if unknown
    tval: *mut Type,  // CAT_TYPE: the type; E_BUILTIN: type argument
    cval: u.I128,     // folded integer constant (untyped / const refs)
    is_const: bool,   // cval / fval valid
}

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------
// A match arm's pattern, as written.
pub union Pattern {
    Variant: VariantPattern,  // .NAME or .Name(bind)
    Error: []u8,              // error.Name
    Int: u.I128,              // an integer or character literal
    Bool: bool,
    Else,
}

pub struct VariantPattern {
    name: []u8,
    bind: []u8,  // or no string
    bind_span: u.Span,
}

pub struct MatchArm {
    pat: Pattern,
    span: u.Span,
    body: *mut Stmt,
    // sema
    bind_local: *mut Local,
    variant: i32,     // Variant: the variant's or member's index
    value: u.I128,    // Variant of an enum: the member's value
    error_code: u32,  // Error

    pub fn is_else(self: *MatchArm) bool {
        match self.pat {
            .Else => { return true; }
            else  => { return false; }
        }
    }
}

pub struct Stmt {
    kind: StmtKind,
    span: u.Span,
    name: []u8,  // let / for variable
    name_span: u.Span,
    is_mut: bool,
    undef: bool,  // let ... = undefined (§8.1): `e` is that identifier, its bytes left unspecified
    te: *mut TypeExpr,
    e: *mut Expr,
    e2: *mut Expr,
    e3: *mut Expr,
    op: i32,  // assign op TokKind
    body: *mut Stmt,
    els: *mut Stmt,
    stmts: u.List.[*mut Stmt],
    arms: u.List.[MatchArm],
    // sema
    local: *mut Local,
    diverges: bool,
}

// ---------------------------------------------------------------------------
// Declarations
// ---------------------------------------------------------------------------
pub struct GenericParam {
    name: []u8,
    span: u.Span,
    constraint: []u8,  // nil if unconstrained
    constraint_span: u.Span,
    is_const: bool,
    const_te: *mut TypeExpr,
    ty: *mut Type,  // TY_PARAM
}

pub struct Param {
    name: []u8,
    span: u.Span,
    te: *mut TypeExpr,
    local: *mut Local,
}

pub struct Variant {
    name: []u8,
    span: u.Span,
    te: *mut TypeExpr,  // nil: no payload
    ty: *mut Type,
    // enum members
    has_value: bool,  // `= value` given
    value: u.I128,    // after sema: the member's value
    value_span: u.Span,
}

pub struct Local {
    name: []u8,
    span: u.Span,
    ty: *mut Type,
    is_mut: bool,
    is_param: bool,
    addr_taken: bool,
    index: i32,  // within its function
}

pub struct Decl {
    kind: DeclKind,
    span: u.Span,
    name: []u8,
    name_span: u.Span,
    is_pub: bool,
    is_export: bool,
    module: *mut Module,
    gparams: u.List.[GenericParam],
    fields: u.List.[Field],
    variants: u.List.[Variant],
    methods: u.List.[*mut Decl],
    method_map: u.SymMap.[*mut Decl],
    owner: *mut Decl,  // method -> struct/union/enum decl
    params: u.List.[Param],
    ret_te: *mut TypeExpr,
    body: *mut Stmt,
    te: *mut TypeExpr,  // const / global type; enum representation type (nil: default)
    init: *mut Expr,
    is_mut: bool,
    is_tls: bool,  // D_GLOBAL: threadlocal (one per thread)
    import_path: []u8,
    import_path_span: u.Span,
    imported: *mut Module,
    host_module: []u8,  // D_HOST_FN from `import host "mod"`; nil for extern "C"
    extern_c: bool,     // declared in an extern "C" block
    variadic: bool,     // C varargs: `...` after the fixed parameters
    link_lib: []u8,     // extern "C" "lib": library to link
    abi: []u8,
    is_inline: bool,  // `inline fn`: always inlined (spec §9.5)
    inline_span: u.Span,
    inline_callees: u.List.[*mut Decl],  // inline functions this one calls directly (sema)
    inline_call_spans: u.List.[u.Span],
    inline_mark: i32,  // sema: visited by the cycle check
    is_test: bool,     // `test "name" { }` (a D_FN returning !void)
    test_name: []u8,
    test_trap: i32,  // -1: must not trap; -2: must trap; n >= 0: must trap with Tn
    abi_span: u.Span,
    error_names: u.List.[[]u8],
    error_spans: u.List.[u.Span],
    // fn attribute: @features("a,b") or @multiversion("a,b", "c") after the return type
    attr: Attr,  // ATTR_*
    attr_span: u.Span,
    attr_args: u.List.[[]u8],
    attr_arg_spans: u.List.[u.Span],

    // ---- sema ----
    state: i32,     // 0 = unresolved, 1 = resolving, 2 = done
    ty: *mut Type,  // fn: TY_FN signature; const/global: value type; struct/union: Self type
    ret_type: *mut Type,
    param_types: []mut *mut Type,
    locals: u.List.[*mut Local],
    all_gparams: []mut *mut Type,  // TY_PARAM types, owner's first
    self_kind: SelfMode,           // for methods: SELF_VALUE (Self), SELF_ADDR (*Self), SELF_PASS (*mut Self); NONE if not a method
    checked: bool,
    layout_done: bool,
    anon: bool,
    cexpr: *mut Expr,      // const: checked init expression
    feat_sets: []mut u64,  // fn with an attribute: the extensions each version adds (closed under implication)
}

pub struct Module {
    file: *mut u.SourceFile,
    path: []u8,
    decls: u.List.[*mut Decl],
    names: u.SymMap.[*mut Decl],    // top-level names (items, not imports)
    imports: u.SymMap.[*mut Decl],  // alias -> Decl(D_IMPORT)
    pkg: *mut pkg.Package,          // the package this module belongs to, or nil
    checked: bool,
}

// ---------------------------------------------------------------------------
// Semantic types. Types are hash-consed: equal types are the same pointer.
// ---------------------------------------------------------------------------
pub struct Type {
    kind: TyKind,
    id: i32,
    bits: i32,                // INT / FLOAT; VEC: lane bits
    is_signed: bool,          // INT; VEC with int lanes
    is_size: bool,            // usize / isize
    lanes: i32,               // VEC
    elem: *mut Type,          // PTR, SLICE, ARRAY, ERRUNION, VEC (lane type)
    is_mut: bool,             // PTR, SLICE
    len: i64,                 // ARRAY
    len_param: *mut Type,     // ARRAY whose length is a const generic parameter
    params: []mut *mut Type,  // FN
    ret: *mut Type,
    decl: *mut Decl,  // STRUCT, UNION
    args: []mut *mut Type,
    // PARAM
    owner: *mut Decl,
    pindex: i32,
    constraint: i32,
    is_const: bool,
    const_type: *mut Type,
    name: []u8,
    cval: i64,         // CONSTINT
    has_params: bool,  // mentions a TY_PARAM somewhere
    // layout cache
    size: i64,
    align: i64,
    layout_done: bool,
    backend: *mut void,  // codegen type cache
}

pub struct Target {
    ptr_bits: i32,  // 32 or 64
    is_wasm: bool,
    triple: []u8,
}

// A catch's handler value (catch <value>, catch return <value>) or block;
// nil if it has none.
pub fn handler_expr(e: *Expr) *mut Expr {
    match e.handler {
        .Value(h)  => { return h; }
        .Return(h) => { return h; }
        else       => { return u.nil.[Expr](); }
    }
}

pub fn handler_block(e: *Expr) *mut Stmt {
    match e.handler {
        .Block(blk) => { return blk; }
        else        => { return u.nil.[Stmt](); }
    }
}

// Constructors for zeroed nodes.
pub fn new_te(sh: TypeShape, sp: u.Span) *mut TypeExpr {
    let t = u.new.[TypeExpr]();
    t.shape = sh;
    t.span = sp;
    return t;
}

pub fn new_expr(k: ExprKind, sp: u.Span) *mut Expr {
    let e = u.new.[Expr]();
    e.kind = k;
    e.span = sp;
    return e;
}

pub fn new_stmt(k: StmtKind, sp: u.Span) *mut Stmt {
    let s = u.new.[Stmt]();
    s.kind = k;
    s.span = sp;
    return s;
}
