// =============================================================================
// ast.ax - the abstract syntax tree and semantic types. Sema annotates the
// tree in place. (Types live here too because types and declarations refer
// to each other, and modules cannot import each other cyclically.)
// =============================================================================
import "package.ax" as pkg;
import "util.ax" as u;

// What an Expr is (Expr.kind).
pub enum ExprKind {
    IDENT,
    SELF,
    INT,
    FLOAT,
    STRING,
    BOOL,
    STRUCT_LIT,
    ARRAY_LIT,
    ARRAY_REPEAT,
    ERROR_VAL,
    BUILTIN,
    UNARY = 12,
    BINARY,
    CATCH,
    FIELD,
    DEREF,
    CALL,
    INDEX,
    SLICE,
    TRY,
    APPLY,
    CONV,
}

pub const E_IDENT: ExprKind = ExprKind.IDENT;
pub const E_SELF: ExprKind = ExprKind.SELF;
pub const E_INT: ExprKind = ExprKind.INT;
pub const E_FLOAT: ExprKind = ExprKind.FLOAT;
pub const E_STRING: ExprKind = ExprKind.STRING;
pub const E_BOOL: ExprKind = ExprKind.BOOL;
pub const E_STRUCT_LIT: ExprKind = ExprKind.STRUCT_LIT;
pub const E_ARRAY_LIT: ExprKind = ExprKind.ARRAY_LIT;
pub const E_ARRAY_REPEAT: ExprKind = ExprKind.ARRAY_REPEAT;
pub const E_ERROR_VAL: ExprKind = ExprKind.ERROR_VAL;
pub const E_BUILTIN: ExprKind = ExprKind.BUILTIN;
pub const E_UNARY: ExprKind = ExprKind.UNARY;
pub const E_BINARY: ExprKind = ExprKind.BINARY;
pub const E_CATCH: ExprKind = ExprKind.CATCH;
pub const E_FIELD: ExprKind = ExprKind.FIELD;
pub const E_DEREF: ExprKind = ExprKind.DEREF;
pub const E_CALL: ExprKind = ExprKind.CALL;
pub const E_INDEX: ExprKind = ExprKind.INDEX;
pub const E_SLICE: ExprKind = ExprKind.SLICE;
pub const E_TRY: ExprKind = ExprKind.TRY;
pub const E_APPLY: ExprKind = ExprKind.APPLY;
pub const E_CONV: ExprKind = ExprKind.CONV;

// What an E_CONV conversion does (Expr.conv).
pub enum Conv {
    NOOP,
    WRAP_OK,
    WRAP_ERR,
}

pub const CONV_NOOP: Conv = Conv.NOOP;
pub const CONV_WRAP_OK: Conv = Conv.WRAP_OK;
pub const CONV_WRAP_ERR: Conv = Conv.WRAP_ERR;

// What an E_CALL calls (Expr.call_kind).
pub enum CallKind {
    DIRECT,
    INDIRECT,
    VARIANT,
}

pub const CALLK_DIRECT: CallKind = CallKind.DIRECT;
pub const CALLK_INDIRECT: CallKind = CallKind.INDIRECT;
pub const CALLK_VARIANT: CallKind = CallKind.VARIANT;

// What an E_FIELD selects (Expr.field_kind).
pub enum FieldKind {
    STRUCT,
    SLICE_LEN,
    SLICE_PTR,
    ARRAY_LEN,
    VARIANT_UNIT,
    CONST,
    DECL,
}

pub const FK_STRUCT: FieldKind = FieldKind.STRUCT;
pub const FK_SLICE_LEN: FieldKind = FieldKind.SLICE_LEN;
pub const FK_SLICE_PTR: FieldKind = FieldKind.SLICE_PTR;
pub const FK_ARRAY_LEN: FieldKind = FieldKind.ARRAY_LEN;
pub const FK_VARIANT_UNIT: FieldKind = FieldKind.VARIANT_UNIT;
pub const FK_CONST: FieldKind = FieldKind.CONST;
pub const FK_DECL: FieldKind = FieldKind.DECL;

// What an expression denotes (Expr.cat).
pub enum Cat {
    VALUE,
    TYPE,
    MODULE,
    FUNC,
    METHOD,
    VARIANT,
    GENERIC,
}

pub const CAT_VALUE: Cat = Cat.VALUE;
pub const CAT_TYPE: Cat = Cat.TYPE;
pub const CAT_MODULE: Cat = Cat.MODULE;
pub const CAT_FUNC: Cat = Cat.FUNC;
pub const CAT_METHOD: Cat = Cat.METHOD;
pub const CAT_VARIANT: Cat = Cat.VARIANT;
pub const CAT_GENERIC: Cat = Cat.GENERIC;

// What a catch handler does (Expr.handler).
pub union Handler {
    Value: *mut Expr,   // catch <value>
    Return: *mut Expr,  // catch return [value] (nil without one)
    Break,
    Continue,
    Block: *mut Stmt,  // catch { ... }
}

// How a method takes its receiver (Decl.self_kind, Expr.self_mode).
pub enum SelfMode {
    NONE,
    VALUE,
    ADDR,
    PASS,
    DEREF,
}

pub const SELF_NONE: SelfMode = SelfMode.NONE;
pub const SELF_VALUE: SelfMode = SelfMode.VALUE;
pub const SELF_ADDR: SelfMode = SelfMode.ADDR;
pub const SELF_PASS: SelfMode = SelfMode.PASS;
pub const SELF_DEREF: SelfMode = SelfMode.DEREF;

// What a Stmt is (Stmt.kind).
pub enum StmtKind {
    LET,
    EXPR,
    ASSIGN,
    DISCARD,
    IF,
    WHILE,
    LOOP,
    FOR,
    MATCH,
    RETURN,
    BREAK,
    CONTINUE,
    DEFER,
    BLOCK = 14,
}

pub const S_LET: StmtKind = StmtKind.LET;
pub const S_EXPR: StmtKind = StmtKind.EXPR;
pub const S_ASSIGN: StmtKind = StmtKind.ASSIGN;
pub const S_DISCARD: StmtKind = StmtKind.DISCARD;
pub const S_IF: StmtKind = StmtKind.IF;
pub const S_WHILE: StmtKind = StmtKind.WHILE;
pub const S_LOOP: StmtKind = StmtKind.LOOP;
pub const S_FOR: StmtKind = StmtKind.FOR;
pub const S_MATCH: StmtKind = StmtKind.MATCH;
pub const S_RETURN: StmtKind = StmtKind.RETURN;
pub const S_BREAK: StmtKind = StmtKind.BREAK;
pub const S_CONTINUE: StmtKind = StmtKind.CONTINUE;
pub const S_DEFER: StmtKind = StmtKind.DEFER;
pub const S_BLOCK: StmtKind = StmtKind.BLOCK;

// What a Decl is (Decl.kind).
pub enum DeclKind {
    IMPORT,
    HOST_FN,
    ERROR,
    STRUCT,
    UNION,
    FN,
    CONST,
    GLOBAL,
    ENUM,
}

pub const D_IMPORT: DeclKind = DeclKind.IMPORT;
pub const D_HOST_FN: DeclKind = DeclKind.HOST_FN;
pub const D_ERROR: DeclKind = DeclKind.ERROR;
pub const D_STRUCT: DeclKind = DeclKind.STRUCT;
pub const D_UNION: DeclKind = DeclKind.UNION;
pub const D_FN: DeclKind = DeclKind.FN;
pub const D_CONST: DeclKind = DeclKind.CONST;
pub const D_GLOBAL: DeclKind = DeclKind.GLOBAL;
pub const D_ENUM: DeclKind = DeclKind.ENUM;

// What an E_INDEX or E_SLICE indexes (Expr.index_kind).
pub enum IndexKind {
    ARRAY,
    SLICE,
    PTR_ARRAY,
}

pub const IDX_ARRAY: IndexKind = IndexKind.ARRAY;
pub const IDX_SLICE: IndexKind = IndexKind.SLICE;
pub const IDX_PTR_ARRAY: IndexKind = IndexKind.PTR_ARRAY;

// What a Type is (Type.kind).
pub enum TyKind {
    INVALID,
    VOID,
    BOOL,
    INT,
    FLOAT,
    VEC,
    V128,
    PTR,
    SLICE,
    ARRAY,
    FN,
    STRUCT,
    UNION,
    ERRUNION,
    ERROR,
    PARAM,
    CONSTINT,
    UNTYPED_INT,
    UNTYPED_FLOAT,
    NEVER,
    ENUM,
}

pub const TY_INVALID: TyKind = TyKind.INVALID;
pub const TY_VOID: TyKind = TyKind.VOID;
pub const TY_BOOL: TyKind = TyKind.BOOL;
pub const TY_INT: TyKind = TyKind.INT;
pub const TY_FLOAT: TyKind = TyKind.FLOAT;
pub const TY_VEC: TyKind = TyKind.VEC;
pub const TY_V128: TyKind = TyKind.V128;
pub const TY_PTR: TyKind = TyKind.PTR;
pub const TY_SLICE: TyKind = TyKind.SLICE;
pub const TY_ARRAY: TyKind = TyKind.ARRAY;
pub const TY_FN: TyKind = TyKind.FN;
pub const TY_STRUCT: TyKind = TyKind.STRUCT;
pub const TY_UNION: TyKind = TyKind.UNION;
pub const TY_ERRUNION: TyKind = TyKind.ERRUNION;
pub const TY_ERROR: TyKind = TyKind.ERROR;
pub const TY_PARAM: TyKind = TyKind.PARAM;
pub const TY_CONSTINT: TyKind = TyKind.CONSTINT;
pub const TY_UNTYPED_INT: TyKind = TyKind.UNTYPED_INT;
pub const TY_UNTYPED_FLOAT: TyKind = TyKind.UNTYPED_FLOAT;
pub const TY_NEVER: TyKind = TyKind.NEVER;
pub const TY_ENUM: TyKind = TyKind.ENUM;  // elem: the representation (an integer type)

// A function's attribute (Decl.attr).
pub enum Attr {
    NONE,
    FEATURES,
    MULTIVERSION,
}

pub const ATTR_NONE: Attr = Attr.NONE;
pub const ATTR_FEATURES: Attr = Attr.FEATURES;          // @features: compiled with more extensions; traps (T0013) without them
pub const ATTR_MULTIVERSION: Attr = Attr.MULTIVERSION;  // @multiversion: one version per set, chosen at run time

