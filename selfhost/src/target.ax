// =============================================================================
// target.ax - target architectures, CPUs and processor extensions.
//
//   --target=wasm32 | wasm64 | x86_64 | aarch64 | aarch64-macos | native
//   --cpu=<name>          a preset set of extensions (see cpu_features)
//   --features=+a,-b      add or remove individual extensions
//
// The backends consult has() to choose instructions; without an extension
// they fall back to baseline sequences with the same results.
// =============================================================================
import "ir.ax" as ir;
import "std/os/cpu" as cpu;
import "util.ax" as u;

pub const ARCH_WASM32: i32 = 1;
pub const ARCH_WASM64: i32 = 2;
pub const ARCH_X64: i32 = 3;
pub const ARCH_A64: i32 = 4;

// The extensions and their bits are std/os/cpu.ax's (programs see the same
// names through @target_has and @cpu_has, and cpu.features()).
// x86-64 (SSE2 is always available)
pub const X_SSE3: u64 = cpu.X_SSE3;
pub const X_SSSE3: u64 = cpu.X_SSSE3;
pub const X_SSE41: u64 = cpu.X_SSE41;
pub const X_SSE42: u64 = cpu.X_SSE42;
pub const X_POPCNT: u64 = cpu.X_POPCNT;
pub const X_LZCNT: u64 = cpu.X_LZCNT;
pub const X_BMI1: u64 = cpu.X_BMI1;
pub const X_BMI2: u64 = cpu.X_BMI2;
pub const X_AVX: u64 = cpu.X_AVX;
pub const X_AVX2: u64 = cpu.X_AVX2;
pub const X_FMA: u64 = cpu.X_FMA;
pub const X_CMPXCHG16B: u64 = cpu.X_CMPXCHG16B;
pub const X_AES: u64 = cpu.X_AES;
pub const X_PCLMUL: u64 = cpu.X_PCLMUL;
pub const X_SHA: u64 = cpu.X_SHA;
pub const X_F16C: u64 = cpu.X_F16C;
pub const X_MOVBE: u64 = cpu.X_MOVBE;
pub const X_ADX: u64 = cpu.X_ADX;
pub const X_AVX512F: u64 = cpu.X_AVX512F;
pub const X_AVX512CD: u64 = cpu.X_AVX512CD;
pub const X_AVX512BW: u64 = cpu.X_AVX512BW;
pub const X_AVX512DQ: u64 = cpu.X_AVX512DQ;
pub const X_AVX512VL: u64 = cpu.X_AVX512VL;
pub const X_AVX512IFMA: u64 = cpu.X_AVX512IFMA;
pub const X_AVX512VBMI: u64 = cpu.X_AVX512VBMI;
pub const X_AVX512VBMI2: u64 = cpu.X_AVX512VBMI2;
pub const X_AVX512VNNI: u64 = cpu.X_AVX512VNNI;
pub const X_AVX512BITALG: u64 = cpu.X_AVX512BITALG;
pub const X_AVX512VPOPCNTDQ: u64 = cpu.X_AVX512VPOPCNTDQ;
pub const X_AVX512BF16: u64 = cpu.X_AVX512BF16;
pub const X_AVX512FP16: u64 = cpu.X_AVX512FP16;
pub const X_GFNI: u64 = cpu.X_GFNI;
pub const X_VAES: u64 = cpu.X_VAES;
pub const X_VPCLMULQDQ: u64 = cpu.X_VPCLMULQDQ;
pub const X_AVXVNNI: u64 = cpu.X_AVXVNNI;
pub const X_SHA512: u64 = cpu.X_SHA512;
pub const X_SM3: u64 = cpu.X_SM3;
pub const X_SM4: u64 = cpu.X_SM4;
pub const X_AVX10_1: u64 = cpu.X_AVX10_1;
pub const X_PRFCHW: u64 = cpu.X_PRFCHW;

// AArch64 (FP and Advanced SIMD are always available)
pub const A_LSE: u64 = cpu.A_LSE;
pub const A_RCPC: u64 = cpu.A_RCPC;
pub const A_DOTPROD: u64 = cpu.A_DOTPROD;
pub const A_CSSC: u64 = cpu.A_CSSC;
pub const A_AES: u64 = cpu.A_AES;
pub const A_SHA2: u64 = cpu.A_SHA2;
pub const A_SHA3: u64 = cpu.A_SHA3;
pub const A_SHA512: u64 = cpu.A_SHA512;
pub const A_SM4: u64 = cpu.A_SM4;
pub const A_CRC: u64 = cpu.A_CRC;
pub const A_RDM: u64 = cpu.A_RDM;
pub const A_FP16: u64 = cpu.A_FP16;
pub const A_FHM: u64 = cpu.A_FHM;
pub const A_BF16: u64 = cpu.A_BF16;
pub const A_I8MM: u64 = cpu.A_I8MM;
pub const A_SVE: u64 = cpu.A_SVE;
pub const A_SVE2: u64 = cpu.A_SVE2;
pub const A_DIT: u64 = cpu.A_DIT;
pub const A_SME: u64 = cpu.A_SME;

// WebAssembly
pub const W_SIMD128: u64 = cpu.W_SIMD128;
pub const W_BULK_MEMORY: u64 = cpu.W_BULK_MEMORY;
pub const W_NONTRAPPING_FPTOINT: u64 = cpu.W_NONTRAPPING_FPTOINT;
pub const W_SIGN_EXT: u64 = cpu.W_SIGN_EXT;
pub const W_MUTABLE_GLOBALS: u64 = cpu.W_MUTABLE_GLOBALS;
pub const W_ATOMICS: u64 = cpu.W_ATOMICS;
pub const W_MULTIVALUE: u64 = cpu.W_MULTIVALUE;
pub const W_RELAXED_SIMD: u64 = cpu.W_RELAXED_SIMD;
pub const W_TAIL_CALL: u64 = cpu.W_TAIL_CALL;

// Operating systems of native targets
pub const OS_LINUX: i32 = 0;
pub const OS_DARWIN: i32 = 1;   // macOS on Apple silicon (aarch64-apple-darwin)
pub const OS_WINDOWS: i32 = 2;  // Windows on x86-64 (x86_64-pc-windows-msvc)

pub let mut g_arch: i32 = 1;
pub let mut g_os: i32 = 0;
pub let mut g_features: u64 = 0;
pub let mut g_cpu: []u8 = "";

pub fn has(f: u64) bool {
    return (g_features & f) == f;
}

// Fused multiply-add in hardware (otherwise @fma calls runtime/rt.ax).
pub fn has_fma() bool {
    if g_arch == ARCH_A64 {
        return true;
    }
    if g_arch == ARCH_X64 {
        return has(X_FMA);
    }
    return false;
}

pub fn is_darwin() bool {
    return g_os == OS_DARWIN;
}

pub fn is_windows() bool {
    return g_os == OS_WINDOWS;
}

pub fn is_wasm() bool {
    return (g_arch == ARCH_WASM32) or (g_arch == ARCH_WASM64);
}

fn same_family(a: i32, b: i32) bool {
    if (a == ARCH_WASM32) or (a == ARCH_WASM64) {
        return (b == ARCH_WASM32) or (b == ARCH_WASM64);
    }
    return a == b;
}

// Extension names for the current architecture (for messages).
pub fn feature_names() []u8 {
    let mut b = u.Buf.init();
    for f in cpu.table() {
        if same_family(f.arch, g_arch) {
            if b.len() > 0 {
                b.s(", ");
            }
            b.s(f.name);
        }
    }
    return b.done();
}

pub fn feature_bit(name: []u8) u64 {
    return cpu.bit_of(g_arch, name);
}

// Whether `name` is an extension of some architecture (@target_has and
// @cpu_has accept any of them; another architecture's are simply absent).
pub fn feature_known(name: []u8) bool {
    return cpu.known(name);
}

// The names of the extensions in `bits` as "+a,+b".
pub fn features_string(bits: u64) []u8 {
    let mut b = u.Buf.init();
    for f in cpu.table() {
        if same_family(f.arch, g_arch) and ((bits & f.bit) != 0) {
            if b.len() > 0 {
                b.s(",");
            }
            b.s("+");
            b.s(f.name);
        }
    }
    return b.done();
}

// The enabled extensions as "+a,+b".
pub fn feature_string() []u8 {
    return features_string(g_features);
}

// Parses an extension list "a,b" (or "+a,+b"; @features and @multiversion
// write them so) into bits with everything they imply. Returns the first
// unknown name in `bad`, or nil.
pub struct ParsedFeatures {
    bits: u64,
    bad: []u8,
}

pub fn parse_features(spec: []u8) ParsedFeatures {
    let mut r = ParsedFeatures.{ bits: 0, bad: u.nosym() };
    let mut i: usize = 0;
    while i < spec.len {
        let mut j = i;
        while (j < spec.len) and (spec[j] != ',') {
            j += 1;
        }
        let mut name = spec[i..j];
        i = j + 1;
        while (name.len > 0) and (name[0] == ' ') {
            name = name[1..];
        }
        if (name.len > 0) and (name[0] == '+') {
            name = name[1..];
        }
        if name.len == 0 {
            continue;
        }
        let bit = feature_bit(name);
        if bit == 0 {
            if u.isnos(r.bad) {
                r.bad = u.dup(name);
            }
            continue;
        }
        r.bits = r.bits | bit;
    }
    r.bits = cpu.closure(g_arch, r.bits);
    return r;
}

// The extensions f's code may use.
pub fn fn_features(f: *ir.Func) u64 {
    if f.has_features {
        return f.features;
    }
    return g_features;
}

// Makes the extensions of f the ones has() reports, while a backend
// compiles it; returns the previous set, for end_fn.
pub fn begin_fn(f: *ir.Func) u64 {
    let old = g_features;
    g_features = fn_features(f);
    return old;
}

pub fn end_fn(old: u64) void {
    g_features = old;
}

// The extensions a function is compiled with: the target's, the ones its
// @features or @multiversion clone adds, or (`baseline`) none at all (the
// start-up check of std/os/cpu.ax, which must run on any processor).
pub fn func_features(extra: u64, baseline: bool) u64 {
    if baseline {
        return 0;
    }
    return g_features | extra;
}

// The architecture this compiler runs on (from its own ELF header).
let mut host_arch_: i32 = 0;
let mut host_os_: i32 = 0;

// (From the compiler's own executable: an ELF machine, Mach-O, which means
// macOS on Apple silicon, or PE, which means Windows.)
pub fn host_arch() i32 {
    if host_arch_ == 0 {
        host_arch_ = ARCH_X64;
        let me = u.self_path();
        let mut exe = u.nosym();
        if not u.isnos(me) {
            exe = u.read_file(me);
        }
        if not u.isnos(exe) and (exe.len > 20) and (exe[18] == 183) and (exe[0] == 0x7f) {
            host_arch_ = ARCH_A64;
        } else if not u.isnos(exe) and (exe.len > 4) and (exe[0] == 0xcf) and (exe[1] == 0xfa) and (exe[2] == 0xed) and
                  (exe[3] == 0xfe) {
            host_arch_ = ARCH_A64;
            host_os_ = OS_DARWIN;
        } else if not u.isnos(exe) and (exe.len > 64) and (exe[0] == 'M') and (exe[1] == 'Z') {
            host_os_ = OS_WINDOWS;
        }
    }
    return host_arch_;
}

pub fn host_os() i32 {
    _ = host_arch();
    return host_os_;
}

pub fn host_triple() []u8 {
    return triple_of(host_arch());
}

pub fn triple_of(a: i32) []u8 {
    if a == ARCH_WASM32 {
        return "wasm32-unknown-unknown";
    }
    if a == ARCH_WASM64 {
        return "wasm64-unknown-unknown";
    }
    if a == ARCH_A64 {
        if g_os == OS_DARWIN {
            return "aarch64-apple-darwin";
        }
        return "aarch64-unknown-linux-gnu";
    }
    if g_os == OS_WINDOWS {
        return "x86_64-pc-windows-msvc";
    }
    return "x86_64-unknown-linux-gnu";
}

// The name of a native target for messages.
pub fn os_target_name() []u8 {
    if g_os == OS_DARWIN {
        return "aarch64-macos";
    }
    if g_os == OS_WINDOWS {
        return "x86_64-windows";
    }
    return triple_of(g_arch);
}

// Extensions of the machine we run on: std/os/cpu.ax asks the processor
// (cpuid) or the system, for the architecture this compiler runs on.
fn host_features(a: i32) u64 {
    if a != host_arch() {
        return 0;
    }
    return cpu.features();
}

// The extensions of a CPU preset; `ok` is false for an unknown name.
pub struct CpuResult {
    features: u64,
    ok: bool,
}

pub fn cpu_features(a: i32, name: []u8) CpuResult {
    let mut r = preset(a, name);
    if r.ok and (r.features != 0) {
        r.features = cpu.closure(a, r.features);
    }
    return r;
}

fn preset(a: i32, name: []u8) CpuResult {
    let mut r = CpuResult.{ features: 0, ok: true };
    if (a == ARCH_WASM32) or (a == ARCH_WASM64) {
        let generic = W_SIMD128 | W_BULK_MEMORY | W_NONTRAPPING_FPTOINT | W_SIGN_EXT | W_MUTABLE_GLOBALS | W_ATOMICS |
                      W_MULTIVALUE;
        if u.str_eq(name, "mvp") {
            r.features = W_MUTABLE_GLOBALS;
        } else if u.str_eq(name, "generic") or (name.len == 0) {
            r.features = generic;
        } else if u.str_eq(name, "bleeding-edge") {
            r.features = generic | W_RELAXED_SIMD | W_TAIL_CALL;
        } else {
            r.ok = false;
        }
        return r;
    }
    if a == ARCH_X64 {
        let v2 = X_SSE3 | X_SSSE3 | X_SSE41 | X_SSE42 | X_POPCNT | X_CMPXCHG16B;
        let v3 = v2 | X_AVX | X_AVX2 | X_BMI1 | X_BMI2 | X_FMA | X_LZCNT | X_F16C | X_MOVBE;
        let v4 = v3 | X_AVX512F | X_AVX512CD | X_AVX512BW | X_AVX512DQ | X_AVX512VL;
        let haswell = v3 | X_AES | X_PCLMUL;
        let skylake = haswell | X_ADX | X_PRFCHW;  // (Broadwell added adx and prfchw)
        let icelake = skylake | v4 | X_SHA | X_AVX512IFMA | X_AVX512VBMI | X_AVX512VBMI2 | X_AVX512VNNI |
                      X_AVX512BITALG | X_AVX512VPOPCNTDQ | X_GFNI | X_VAES | X_VPCLMULQDQ;
        let spr = icelake | X_AVX512BF16 | X_AVX512FP16 | X_AVXVNNI | X_AVX10_1;
        let alderlake = skylake | X_SHA | X_GFNI | X_VAES | X_VPCLMULQDQ | X_AVXVNNI;
        let znver3 = skylake | X_SHA | X_VAES | X_VPCLMULQDQ;
        let znver4 = znver3 | v4 | X_AVX512IFMA | X_AVX512VBMI | X_AVX512VBMI2 | X_AVX512VNNI | X_AVX512BITALG |
                     X_AVX512VPOPCNTDQ | X_AVX512BF16 | X_GFNI;
        if u.str_eq(name, "x86-64") or u.str_eq(name, "generic") {
            r.features = 0;
        } else if u.str_eq(name, "x86-64-v2") {
            r.features = v2;
        } else if u.str_eq(name, "x86-64-v3") {
            r.features = v3;
        } else if u.str_eq(name, "x86-64-v4") {
            r.features = v4;
        } else if u.str_eq(name, "haswell") {
            r.features = haswell;
        } else if u.str_eq(name, "skylake") {
            r.features = skylake;
        } else if u.str_eq(name, "icelake-server") or u.str_eq(name, "icelake-client") {
            r.features = icelake;
        } else if u.str_eq(name, "sapphirerapids") or u.str_eq(name, "emeraldrapids") {
            r.features = spr;
        } else if u.str_eq(name, "graniterapids") {
            r.features = spr;
        } else if u.str_eq(name, "alderlake") or u.str_eq(name, "raptorlake") or u.str_eq(name, "meteorlake") {
            r.features = alderlake;
        } else if u.str_eq(name, "arrowlake") or u.str_eq(name, "lunarlake") {
            r.features = alderlake | X_SHA512 | X_SM3 | X_SM4;
        } else if u.str_eq(name, "znver3") {
            r.features = znver3;
        } else if u.str_eq(name, "znver4") {
            r.features = znver4;
        } else if u.str_eq(name, "znver5") {
            r.features = znver4 | X_AVXVNNI;
        } else if u.str_eq(name, "native") or (name.len == 0) {
            r.features = host_features(a);
        } else {
            r.ok = false;
        }
        return r;
    }
    let v81 = A_LSE | A_RDM | A_CRC;
    let n1 = v81 | A_DOTPROD | A_RCPC | A_AES | A_SHA2 | A_FP16;
    let m1 = n1 | A_SHA3 | A_SHA512 | A_FHM | A_DIT;
    let v1 = m1 | A_SVE | A_BF16 | A_I8MM;
    let n2 = n1 | A_SVE | A_SVE2 | A_BF16 | A_I8MM | A_DIT | A_FHM | A_SHA3;
    if u.str_eq(name, "generic") or u.str_eq(name, "armv8-a") {
        r.features = 0;
    } else if u.str_eq(name, "armv8.1-a") {
        r.features = v81;
    } else if u.str_eq(name, "armv8.2-a") {
        r.features = v81 | A_DOTPROD;
    } else if u.str_eq(name, "armv8.3-a") {
        r.features = (v81 | A_DOTPROD) | A_RCPC;
    } else if u.str_eq(name, "neoverse-n1") {
        r.features = n1;
    } else if u.str_eq(name, "apple-m1") {
        r.features = m1;
    } else if u.str_eq(name, "apple-m2") or u.str_eq(name, "apple-m3") {
        r.features = m1 | A_BF16 | A_I8MM;
    } else if u.str_eq(name, "apple-m4") {
        r.features = m1 | A_BF16 | A_I8MM | A_SME;
    } else if u.str_eq(name, "neoverse-v1") {
        r.features = v1;
    } else if u.str_eq(name, "neoverse-n2") {
        r.features = n2;
    } else if u.str_eq(name, "neoverse-v2") or u.str_eq(name, "grace") {
        r.features = n2 | A_SHA512 | A_SM4;
    } else if u.str_eq(name, "native") or (name.len == 0) {
        r.features = host_features(a);
    } else {
        r.ok = false;
    }
    return r;
}

// Applies "+a,-b,..." to g_features: adding an extension adds what it
// implies, and removing one removes what needs it. Returns the first
// unknown name, or nil.
pub fn apply_features(spec: []u8) []u8 {
    let mut i: usize = 0;
    while i < spec.len {
        let mut j = i;
        while (j < spec.len) and (spec[j] != ',') {
            j += 1;
        }
        let item = spec[i..j];
        i = j + 1;
        if item.len == 0 {
            continue;
        }
        let mut on = true;
        let mut name = item;
        if (item[0] == '+') or (item[0] == '-') {
            on = item[0] == '+';
            name = item[1..];
        }
        let bit = feature_bit(name);
        if bit == 0 {
            return u.dup(name);
        }
        if on {
            g_features = cpu.closure(g_arch, g_features | bit);
        } else {
            g_features = g_features & ~cpu.dependents(g_arch, bit);
        }
    }
    return u.nosym();
}
