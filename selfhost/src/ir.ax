// Intrinsics
pub const IN_CTLZ: i32 = 1;
pub const IN_CTTZ: i32 = 2;
pub const IN_CTPOP: i32 = 3;
pub const IN_ROTL: i32 = 4;
pub const IN_ROTR: i32 = 5;
