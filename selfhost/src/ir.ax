pub const IN_FMAX: i32 = 15;
pub const IN_FABS: i32 = 16;
pub const IN_SQRT: i32 = 17;
pub const IN_FLOOR: i32 = 18;
pub const IN_CEIL: i32 = 19;
pub const IN_FTRUNC: i32 = 20;
pub const IN_NEAREST: i32 = 21;  // round to nearest, ties to even
pub const IN_FMA: i32 = 22;
pub const IN_COPYSIGN: i32 = 23;
pub const IN_ABS: i32 = 24;  // wrapping integer abs
pub const IN_TRAP: i32 = 25;
pub const IN_MEMSIZE: i32 = 26;  // wasm memory.size (pages)
pub const IN_MEMGROW: i32 = 27;  // wasm memory.grow
pub const IN_WAIT32: i32 = 28;   // wasm memory.atomic.wait32
pub const IN_NOTIFY: i32 = 29;   // wasm memory.atomic.notify
pub const IN_SET_SP: i32 = 30;   // set the stack pointer (thread entry on wasm)
pub const IN_ANYTRUE: i32 = 31;  // i1: any bit of the vector set
pub const IN_ALLTRUE: i32 = 32;  // i1: every lane nonzero
pub const IN_BITMASK: i32 = 33;  // i32: top bit of each lane
pub const IN_SWIZZLE: i32 = 34;  // i8x16 swizzle (out-of-range index: 0)
pub const IN_DOT_I16: i32 = 35;  // i32x4 dot product of i16x8 lanes
pub const IN_UMUL_OV: i32 = 36;  // i1: the unsigned product of the two operands overflows
pub const IN_SMUL_OV: i32 = 37;  // i1: the signed product overflows (64-bit operands)
pub const IN_GET_SP: i32 = 38;   // the stack pointer, after this function's frame (wasm)
pub const IN_CPUID: i32 = 39;    // x86-64 cpuid (leaf, subleaf) -> <4 x i32> eax, ebx, ecx, edx
pub const IN_XGETBV: i32 = 40;   // x86-64 xgetbv (register) -> i64

// Argument and parameter marks (CALL ext, Func.param_ext) besides 1 (zext)
// and 2 (sext), set by lowering for the address of an aggregate:
pub const EXT_BYVAL: u8 = 3;  // passed by value: the callee only reads it
pub const EXT_SRET: u8 = 4;   // the result's memory: the call writes it (a parameter: the
                              // caller's fresh slot, which nothing else uses)

// Load/store flags
pub const F_VOLATILE: u32 = 1;
pub const F_ATOMIC: u32 = 2;  // sequentially consistent

pub struct Value {
    // the fields every walk over the IR reads come first (two cache lines)
    kind: i32,
    op: i32,
    ty: *mut Ty,
    a: *mut Value,
    b: *mut Value,
    c: *mut Value,
    xs: u.List.[*mut Value],
    next: *mut Value,
    prev: *mut Value,
    blk: *mut Block,
    fwd: *mut Value,   // replacement (passes forward uses through resolve())
    user: *mut Value,  // the only user (when uses == 1)
    uses: i32,
    flags: u32,
    cv: u64,
    id: i32,
    align: u32,
    bs: u.List.[*mut Block],
    t1: *mut Block,
    t2: *mut Block,
    fv: f64,
    aty: *mut Ty,     // ALLOCA: allocated type
    fty: *mut Ty,     // CALL: signature
    mask: []mut i32,  // SHUFFLE
    ext: []mut u8,    // CALL: argument extension (0 none, 1 zext, 2 sext)
    gv: *mut Global,
    fnp: *mut Func,
    name: []u8,
    aux: i64,  // pass / backend scratch
    aux2: i64,
    auxp: *mut void,
    // backend scratch
    pos: i32,  // position in its block
    loc: i32,  // local / virtual register
    flag: i32,
    grave: u32,  // 1 + its index in the graveyard (0: not there)
    src: u32,    // where in the source it comes from (src_loc), 0: not known
}

pub struct Block {
    fnp: *mut Func,
    first: *mut Value,
    last: *mut Value,
    prev: *mut Block,
    next: *mut Block,
    name: []u8,
    id: i32,
    preds: u.List.[*mut Block],
    idom: *mut Block,
    dom_kids: u.List.[*mut Block],
    rpo: i32,
    depth: i32,  // dominator tree depth
    grave: u32,  // 1 + its index in the graveyard (0: not there)
    loop_depth: i32,
    aux: i64,
    auxp: *mut void,
    mark: i64,    // pass scratch that survives CFG analyses
    split: bool,  // a loop header whose range was split (gvn.split_loops)
}

pub const LINK_EXTERNAL: i32 = 0;
pub const LINK_INTERNAL: i32 = 1;
pub const LINK_LINKONCE: i32 = 2;  // a definition any unit may repeat; one is kept
pub const LINK_EXTWEAK: i32 = 3;   // a weak reference: 0 when not defined
pub const LINK_WEAK: i32 = 4;

pub struct Func {
    name: []u8,
    ty: *mut Ty,
    linkage: i32,
    params: []mut *mut Value,
    first: *mut Block,
    last: *mut Block,
    val: *mut Value,
    noreturn: bool,
    cold: bool,
    noinline: bool,
    ret_ext: u8,  // 0 none, 1 zext, 2 sext
    param_ext: []mut u8,
    export_name: []u8,    // wasm export
    import_module: []u8,  // wasm import
    import_name: []u8,
    sret: bool,                  // set by lowering: params[0] is the result address
    split: u.List.[*mut Value],  // lowering: aggregate parameters passed as their leaves
    nvals: i32,
    nblocks: i32,
    id: i32,
    src: u32,  // its declaration's source location (src_loc)
    aux: i64,
    auxp: *mut void,
    fwd_seen: u64,       // fwd_epoch when apply_forwarding last rewrote f
    features: u64,       // the processor extensions its code may use (set when has_features)
    has_features: bool,  // otherwise: the target's (--cpu, --features)
}

pub struct Global {
    name: []u8,
    ty: *mut Ty,
    init: *mut Value,  // nil: declaration
    linkage: i32,
    align: u64,
    is_const: bool,
    tls: bool,
    wasm_global: bool,  // a wasm global (per instance) instead of memory
    noalias: bool,      // compiler-managed: only accessed by name, never through
                        // a pointer the program computes (the shadow stack)
    val: *mut Value,
    id: i32,
    aux: i64,
}

pub struct Module {
    name: []u8,
    funcs: u.List.[*mut Func],
    globals: u.List.[*mut Global],
    fmap: u.SymMap.[*mut Func],
    gmap: u.SymMap.[*mut Global],
}

pub fn vnil() *mut Value {
    return u.nil.[Value]();
}

pub fn bnil() *mut Block {
    return u.nil.[Block]();
}

fn new_val(k: i32, t: *mut Ty) *mut Value {
    let mut v = vnil();
    if free_vals.len > 0 {
        v = free_vals.pop();
        @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, v), @size_of(Value)), 0);
    } else {
        v = u.new.[Value]();
    }
    v.kind = k;
    v.ty = t;
    return v;
}

// -----------------------------------------------------------------------------
// Recycling. Instructions and blocks taken out of a function go to a
// graveyard with their function: they may be put back (moved) or be dead.
// recycle(f), called where no pass is at work on f, takes the dead ones
// (still out, with the instructions of dead blocks) for new values and
// blocks to reuse, and frees their lists. Passes delete most of what they
// make, so without this the IR of a build is mostly garbage. With
// AXIOM_POISON, dead values and blocks are filled with 0xA5 instead and
// never reused.
// -----------------------------------------------------------------------------
let mut grave_v: u.List.[*mut Value] = u.List.[*mut Value].{ data: @ptr_from_int(*mut *mut Value, 0), len: 0, cap: 0 };
let mut grave_vf: u.List.[*mut Func] = u.List.[*mut Func].{ data: @ptr_from_int(*mut *mut Func, 0), len: 0, cap: 0 };
let mut grave_b: u.List.[*mut Block] = u.List.[*mut Block].{ data: @ptr_from_int(*mut *mut Block, 0), len: 0, cap: 0 };
let mut free_vals: u.List.[*mut Value] = u.List.[*mut Value].{ data: @ptr_from_int(*mut *mut Value, 0), len: 0,
                                                               cap: 0 };
let mut free_blocks: u.List.[*mut Block] = u.List.[*mut Block].{ data: @ptr_from_int(*mut *mut Block, 0), len: 0,
                                                                 cap: 0 };

fn bury_value(v: *mut Value) void {
    if v.grave != 0 {
        // (an instruction of a dead block that had been moved before)
        let k = @as(usize, v.grave - 1);
        let last = grave_v.get(grave_v.len - 1);
        grave_v.set(k, last);
        grave_vf.set(k, grave_vf.get(grave_vf.len - 1));
        last.grave = v.grave;
        grave_v.len -= 1;
        grave_vf.len -= 1;
        v.grave = 0;
    }
    u.free(@ptr_cast(*mut void, v.xs.data));
    u.free(@ptr_cast(*mut void, v.bs.data));
    if u.poisoning() {
        @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, v), @size_of(Value)), 0xA5);
        return;
    }
    free_vals.push(v);
}

fn bury_block(b: *mut Block) void {
    let mut i = b.first;
    while u.notnil(i) {
        let next = i.next;
        bury_value(i);
        i = next;
    }
    u.free(@ptr_cast(*mut void, b.preds.data));
    u.free(@ptr_cast(*mut void, b.dom_kids.data));
    if u.poisoning() {
        @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, b), @size_of(Block)), 0xA5);
        return;
    }
    free_blocks.push(b);
}

// Each value or block is in the graveyard once, under the function it was
// last taken out of (a value may move between functions, and in and out
// of blocks, before it dies).
fn to_grave(v: *mut Value, f: *mut Func) void {
    if v.grave != 0 {
        grave_vf.set(@as(usize, v.grave - 1), f);
        return;
    }
    grave_v.push(v);
    grave_vf.push(f);
    v.grave = @truncate(u32, grave_v.len);
}

fn block_to_grave(b: *mut Block) void {
    if b.grave != 0 {
        return;
    }
    grave_b.push(b);
    b.grave = @truncate(u32, grave_b.len);
}

pub fn recycle(f: *mut Func) void {
    // (operands still reaching a dead value through its fwd go straight on)
    apply_forwarding(f);
    let mut k: usize = 0;
    while k < grave_v.len {
        let v = grave_v.get(k);
        if grave_vf.get(k) != f {
            k += 1;
            continue;
        }
        // take the entry out (the last one moves into its place)
        let last = grave_v.get(grave_v.len - 1);
        grave_v.set(k, last);
        grave_vf.set(k, grave_vf.get(grave_vf.len - 1));
        last.grave = @truncate(u32, k + 1);
        grave_v.len -= 1;
        grave_vf.len -= 1;
        v.grave = 0;
        if u.isnil(v.blk) {
            bury_value(v);
        }
    }
    k = 0;
    while k < grave_b.len {
        let b = grave_b.get(k);
        if b.fnp != f {
            k += 1;
            continue;
        }
        let last = grave_b.get(grave_b.len - 1);
        grave_b.set(k, last);
        last.grave = @truncate(u32, k + 1);
        grave_b.len -= 1;
        b.grave = 0;
        if u.isnil(b.prev) and u.isnil(b.next) and (f.first != b) {
            bury_block(b);
        }
    }
}

// -----------------------------------------------------------------------------
// Constants
// -----------------------------------------------------------------------------
pub fn mask_bits(bits: i32) u64 {
    if bits >= 64 {
        return 0xFFFF_FFFF_FFFF_FFFF;
    }
    return (@as(u64, 1) << @int_cast(u32, bits)) - 1;
}

// The constant's value sign-extended from its width.
pub fn sval(v: *Value) i64 {
    let bits = v.ty.bits;
    if bits >= 64 {
        return @bit_cast(i64, v.cv);
    }
    let sh = @int_cast(u32, 64 - bits);
    return @bit_cast(i64, v.cv << sh) >> sh;
}

// Integer constants are shared: one Value per type and value, in permanent
// memory. Nothing changes a constant once made (passes and backends write
// their scratch fields on instructions only), and folding makes them by the
// million.
struct CintTable {
    tys: *mut usize,
    vals: *mut u64,
    cs: *mut *mut Value,
    cap: usize,
    len: usize,
}

let mut CINTS: CintTable = CintTable.{ tys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u64, 0),
                                       cs: @ptr_from_int(*mut *mut Value, 0), cap: 0, len: 0 };

fn cint_slot(tys: []usize, vals: []u64, t: usize, v: u64) usize {
    let mask = tys.len - 1;
    let mut j = @truncate(usize, ((@as(u64, t) *% 0x9E3779B97F4A7C15) ^ (v *% 0xC2B2AE3D27D4EB4F)) >> 17) & mask;
    while (tys[j] != 0) and not ((tys[j] == t) and (vals[j] == v)) {
        j = (j + 1) & mask;
    }
    return j;
}

fn cint_grow() void {
    let mut n: usize = 4096;
    if CINTS.cap != 0 {
        n = CINTS.cap * 2;
    }
    let tys = u.calloc_slice.[usize](n);
    let vals = u.calloc_slice.[u64](n);
    let cs = u.calloc_slice.[*mut Value](n);
    let ot = @slice_from_ptr(CINTS.tys, CINTS.cap);
    let ov = @slice_from_ptr(CINTS.vals, CINTS.cap);
    let oc = @slice_from_ptr(CINTS.cs, CINTS.cap);
    for k in 0..CINTS.cap {
        if ot[k] != 0 {
            let j = cint_slot(tys, vals, ot[k], ov[k]);
            tys[j] = ot[k];
            vals[j] = ov[k];
            cs[j] = oc[k];
        }
    }
    u.free_slice.[usize](ot);
    u.free_slice.[u64](ov);
    u.free_slice.[*mut Value](oc);
    CINTS.tys = tys.ptr;
    CINTS.vals = vals.ptr;
    CINTS.cs = cs.ptr;
    CINTS.cap = n;
}

pub fn cint(t: *mut Ty, v: u64) *mut Value {
    let x = v & mask_bits(t.bits);
    if (CINTS.len + 1) * 2 > CINTS.cap {
        cint_grow();
    }
    let tys = @slice_from_ptr(CINTS.tys, CINTS.cap);
    let vals = @slice_from_ptr(CINTS.vals, CINTS.cap);
    let cs = @slice_from_ptr(CINTS.cs, CINTS.cap);
    let key = @int_from_ptr(t);
    let j = cint_slot(tys, vals, key, x);
    if tys[j] != 0 {
        return cs[j];
    }
    // (shared by every function: outside any scratch scope)
    let c = u.perm_new.[Value]();
    c.kind = V_CINT;
    c.ty = t;
    c.cv = x;
    tys[j] = key;
    vals[j] = x;
    cs[j] = c;
    CINTS.len += 1;
    return c;
}

// Debugging (AXIOM_CHECK_CINTS): that no constant was changed.
pub fn check_cints() void {
    let tys = @slice_from_ptr(CINTS.tys, CINTS.cap);
    let vals = @slice_from_ptr(CINTS.vals, CINTS.cap);
    let cs = @slice_from_ptr(CINTS.cs, CINTS.cap);
    let mut bad: usize = 0;
    for k in 0..CINTS.cap {
        if tys[k] == 0 {
            continue;
        }
        let c = cs[k];
        if (c.kind != V_CINT) or (@int_from_ptr(c.ty) != tys[k]) or (c.cv != vals[k]) or u.notnil(c.fwd) or
           u.notnil(c.a) or (c.xs.len != 0) or u.notnil(c.blk) or u.notnil(c.next) {
            bad += 1;
        }
    }
    u.eprint(u.f2("cints: %s, changed: %s\n", u.zdec(CINTS.len), u.zdec(bad)));
}

pub fn ci32(v: u64) *mut Value {
    return cint(t_int(32), v);
}

pub fn cfp(t: *mut Ty, x: f64) *mut Value {
    let c = new_val(V_CFP, t);
    if t.bits == 32 {
        c.fv = @float_cast(f64, @float_cast(f32, x));
    } else {
        c.fv = x;
    }
    return c;
}

pub fn czero(t: *mut Ty) *mut Value {
    if t.kind == T_INT {
        return cint(t, 0);
    }
    return new_val(V_ZERO, t);
}

pub fn cones(t: *mut Ty) *mut Value {
    if t.kind == T_VEC {
        let n = @int_cast(usize, t.lanes);
        let xs = u.newn.[*mut Value](n);
        for i in 0..n {
            xs[i] = cint(t.elem, 0xFFFF_FFFF_FFFF_FFFF);
        }
        return cagg(t, xs);
    }
    return cint(t, 0xFFFF_FFFF_FFFF_FFFF);
}

// One undef per type, shared as integer constants are.
pub fn undef(t: *mut Ty) *mut Value {
    if u.isnil(t.undef_v) {
        let v = u.perm_new.[Value]();
        v.kind = V_UNDEF;
        v.ty = t;
        t.undef_v = v;
    }
    return t.undef_v;
}

pub fn cagg(t: *mut Ty, xs: []mut *mut Value) *mut Value {
    let c = new_val(V_CAGG, t);
    for x in xs {
        c.xs.push(x);
    }
    return c;
}

pub fn cstruct(xs: []mut *mut Value) *mut Value {
    let ts = u.newn.[*mut Ty](xs.len + 1);
    for i in 0..xs.len {
        ts[i] = xs[i].ty;
    }
    return cagg(t_struct(ts[0..xs.len]), xs);
}

pub fn carray(el: *mut Ty, xs: []mut *mut Value) *mut Value {
    return cagg(t_array(el, @as(u64, xs.len)), xs);
}

// The bytes of `s` followed by a NUL, as an [n+1 x i8] constant.
pub fn cstring(s: []u8) *mut Value {
    let t8 = t_int(8);
    let xs = u.newn.[*mut Value](s.len + 1);
    for i in 0..s.len {
        xs[i] = cint(t8, @as(u64, s[i]));
    }
    xs[s.len] = cint(t8, 0);
    return cagg(t_array(t8, @as(u64, s.len) + 1), xs);
}

pub fn cinttoptr(v: *mut Value) *mut Value {
    if (v.kind == V_CINT) and (v.cv == 0) {
        return czero(t_ptr());
    }
    return cint(t_ptr(), v.cv);
}

pub fn is_const(v: *Value) bool {
    return (v.kind != V_INST) and (v.kind != V_PARAM);
}

pub fn is_cint(v: *Value) bool {
    return (v.kind == V_CINT) or ((v.kind == V_ZERO) and ((v.ty.kind == T_INT) or (v.ty.kind == T_PTR)));
}

pub fn cint_val(v: *Value) u64 {
    if v.kind == V_CINT {
        return v.cv;
    }
    return 0;
}

pub fn is_zero(v: *Value) bool {
    if v.kind == V_ZERO {
        return true;
    }
    if v.kind == V_CINT {
        return v.cv == 0;
    }
    if v.kind == V_CFP {
        return (v.fv == 0.0) and (@bit_cast(u64, v.fv) == 0);
    }
    if v.kind == V_CAGG {
        for i in 0..v.xs.len {
            if not is_zero(v.xs.get(i)) {
                return false;
            }
        }
        return true;
    }
    return false;
}

// -----------------------------------------------------------------------------
// Module, functions, globals
// -----------------------------------------------------------------------------
pub fn new_module(name: []u8) *mut Module {
    let m = u.new.[Module]();
    m.name = u.dup(name);
    return m;
}

pub fn add_function(m: *mut Module, name: []u8, fty: *mut Ty) *mut Func {
    let f = u.new.[Func]();
    f.name = u.intern(name);
    f.ty = fty;
    f.id = @int_cast(i32, m.funcs.len);
    let n = fty.params.len;
    f.params = u.newn.[*mut Value](n + 1)[0..n];
    for i in 0..n {
        let p = new_val(V_PARAM, fty.params[i]);
        p.cv = @as(u64, i);
        p.fnp = f;
        f.params[i] = p;
    }
    f.param_ext = u.newn.[u8](n + 1)[0..n];
    let fv = new_val(V_FUNC, t_ptr());
    fv.fnp = f;
    f.val = fv;
    m.funcs.push(f);
    if not m.fmap.has(f.name) {
        m.fmap.put(f.name, f);
    }
    return f;
}

pub fn new_param(f: *mut Func, t: *mut Ty, idx: usize) *mut Value {
    let p = new_val(V_PARAM, t);
    p.cv = @as(u64, idx);
    p.fnp = f;
    return p;
}

// The value `v` stands for after replacements.
pub fn resolve(v: *mut Value) *mut Value {
    let mut x = v;
    while u.notnil(x) and u.notnil(x.fwd) {
        x = x.fwd;
    }
    return x;
}

// Bumped whenever a value is forwarded: a function that apply_forwarding
// has rewritten since then has no operand to rewrite.
let mut fwd_epoch: u64 = 1;

// Forwards v's uses to r (or, with r nil, stops forwarding them).
pub fn forward(v: *mut Value, r: *mut Value) void {
    v.fwd = r;
    fwd_epoch += 1;
}

// Rewrites every operand of f's instructions through resolve().
pub fn apply_forwarding(f: *mut Func) void {
    if f.fwd_seen == fwd_epoch {
        return;
    }
    f.fwd_seen = fwd_epoch;
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if u.notnil(i.a) {
                i.a = resolve(i.a);
            }
            if u.notnil(i.b) {
                i.b = resolve(i.b);
            }
            if u.notnil(i.c) {
                i.c = resolve(i.c);
            }
            for k in 0..i.xs.len {
                i.xs.set(k, resolve(i.xs.get(k)));
            }
            i = i.next;
        }
        b = b.next;
    }
}

pub fn get_function(m: *mut Module, name: []u8) *mut Func {
    return m.fmap.get(u.intern(name));
}

pub fn add_global(m: *mut Module, t: *mut Ty, name: []u8) *mut Global {
    let g = u.new.[Global]();
    g.name = u.intern(name);
    g.ty = t;
    g.align = t.align;
    g.id = @int_cast(i32, m.globals.len);
    let gv = new_val(V_GLOBAL, t_ptr());
    gv.gv = g;
    g.val = gv;
    m.globals.push(g);
    if not m.gmap.has(g.name) {
        m.gmap.put(g.name, g);
    }
    return g;
}

pub fn get_global(m: *mut Module, name: []u8) *mut Global {
    return m.gmap.get(u.intern(name));
}

pub fn is_decl(f: *Func) bool {
    return u.isnil(f.first);
}

fn new_block() *mut Block {
    if free_blocks.len > 0 {
        let b = free_blocks.pop();
        @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, b), @size_of(Block)), 0);
        return b;
    }
    return u.new.[Block]();
}

pub fn append_block(f: *mut Func, name: []u8) *mut Block {
    let b = new_block();
    b.fnp = f;
    b.name = name;
    b.id = f.nblocks;
    f.nblocks += 1;
    if u.isnil(f.last) {
        f.first = b;
    } else {
        f.last.next = b;
        b.prev = f.last;
    }
    f.last = b;
    return b;
}

pub fn remove_block(b: *mut Block) void {
    let f = b.fnp;
    block_to_grave(b);
    if u.notnil(b.prev) {
        b.prev.next = b.next;
    } else {
        f.first = b.next;
    }
    if u.notnil(b.next) {
        b.next.prev = b.prev;
    } else {
        f.last = b.prev;
    }
    b.prev = bnil();
    b.next = bnil();
}

// Moves `b` to directly after `after`.
pub fn move_block_after(b: *mut Block, after: *mut Block) void {
    if b == after {
        return;
    }
    remove_block(b);
    let f = after.fnp;
    b.prev = after;
    b.next = after.next;
    if u.notnil(after.next) {
        after.next.prev = b;
    } else {
        f.last = b;
    }
    after.next = b;
}

pub fn terminator(b: *Block) *mut Value {
    let l = b.last;
    if u.notnil(l) and is_term(l.op) {
        return l;
    }
    return vnil();
}

pub fn is_term(op: i32) bool {
    return (op >= OP_BR) and (op <= OP_UNREACHABLE);
}

// Successor blocks of a terminator.
pub fn succ_count(t: *Value) usize {
    if u.isnil(t) {
        return 0;
    }
    let op = t.op;
    if op == OP_BR {
        return 1;
    }
    if op == OP_CONDBR {
        return 2;
    }
    if op == OP_SWITCH {
        return 1 + t.bs.len;
    }
    return 0;
}

pub fn succ(t: *Value, i: usize) *mut Block {
    if i == 0 {
        return t.t1;
    }
    if t.op == OP_CONDBR {
        return t.t2;
    }
    return t.bs.get(i - 1);
}

pub fn set_succ(t: *mut Value, i: usize, b: *mut Block) void {
    if i == 0 {
        t.t1 = b;
    } else if t.op == OP_CONDBR {
        t.t2 = b;
    } else {
        t.bs.set(i - 1, b);
    }
}

// Instruction list editing.
pub fn insert_before(pos: *mut Value, v: *mut Value) void {
    let b = pos.blk;
    v.blk = b;
    v.next = pos;
    v.prev = pos.prev;
    if u.notnil(pos.prev) {
        pos.prev.next = v;
    } else {
        b.first = v;
    }
    pos.prev = v;
}

pub fn append_inst(b: *mut Block, v: *mut Value) void {
    v.blk = b;
    v.prev = b.last;
    v.next = vnil();
    if u.notnil(b.last) {
        b.last.next = v;
    } else {
        b.first = v;
    }
    b.last = v;
}

pub fn remove_inst(v: *mut Value) void {
    let b = v.blk;
    to_grave(v, b.fnp);
    if u.notnil(v.prev) {
        v.prev.next = v.next;
    } else {
        b.first = v.next;
    }
    if u.notnil(v.next) {
        v.next.prev = v.prev;
    } else {
        b.last = v.prev;
    }
    v.prev = vnil();
    v.next = vnil();
    v.blk = bnil();
}

// Operands of an instruction, in order: a, b, c, then xs.
pub fn nops(v: *Value) usize {
    let mut n: usize = 0;
    if u.notnil(v.a) {
        n = 1;
    }
    if u.notnil(v.b) {
        n = 2;
    }
    if u.notnil(v.c) {
        n = 3;
    }
    return n;
}

// Replaces every use of `old` by `new` in function f (operands only).
pub fn replace_uses(f: *mut Func, old: *mut Value, new: *mut Value) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            replace_in(i, old, new);
            i = i.next;
        }
        b = b.next;
    }
}

pub fn replace_in(i: *mut Value, old: *mut Value, new: *mut Value) void {
    if i.a == old {
        i.a = new;
    }
    if i.b == old {
        i.b = new;
    }
    if i.c == old {
        i.c = new;
    }
    for k in 0..i.xs.len {
        if i.xs.get(k) == old {
            i.xs.set(k, new);
        }
    }
}

// -----------------------------------------------------------------------------
// Builder
// -----------------------------------------------------------------------------
pub struct Builder {
    blk: *mut Block,
    before: *mut Value,  // insert before this instruction; nil: at the end
}

pub fn new_builder() *mut Builder {
    return u.new.[Builder]();
}

pub fn at_end(bd: *mut Builder, b: *mut Block) void {
    bd.blk = b;
    bd.before = vnil();
}

pub fn at_before(bd: *mut Builder, v: *mut Value) void {
    bd.blk = v.blk;
    bd.before = v;
}

pub fn insert_block(bd: *Builder) *mut Block {
    return bd.blk;
}

// Source locations (debug information): a file and a line in a u32, for
// every instruction. Code generation sets cur_src as it goes; instructions
// passes insert before another take that one's.
pub let mut cur_src: u32 = 0;

pub fn src_loc(file: i32, line: i32) u32 {
    if (file < 0) or (file >= 4095) or (line <= 0) or (line >= 0x10_0000) {
        return 0;
    }
    return (@bit_cast(u32, file + 1) << 20) | @bit_cast(u32, line);
}

pub fn src_file(s: u32) i32 {
    return @bit_cast(i32, s >> 20) - 1;
}

pub fn src_line(s: u32) u32 {
    return s & 0xf_ffff;
}

fn emit(bd: *mut Builder, op: i32, t: *mut Ty) *mut Value {
    let v = new_val(V_INST, t);
    v.op = op;
    v.src = cur_src;
    if (v.src == 0) and u.notnil(bd.before) {
        v.src = bd.before.src;
    }
    let f = bd.blk.fnp;
    v.id = f.nvals;
    f.nvals += 1;
    if u.notnil(bd.before) {
        insert_before(bd.before, v);
    } else {
        append_inst(bd.blk, v);
    }
    return v;
}

// A new instruction that is not in any block (for passes).
pub fn new_inst(f: *mut Func, op: i32, t: *mut Ty) *mut Value {
    let v = new_val(V_INST, t);
    v.op = op;
    v.id = f.nvals;
    f.nvals += 1;
    return v;
}

pub fn fold_int_bin(op: i32, t: *mut Ty, x: *Value, y: *Value) *mut Value {
    let a = cint_val(x);
    let b = cint_val(y);
    let bits = t.bits;
    let mut r: u64 = 0;
    if op == OP_ADD {
        r = a +% b;
    } else if op == OP_SUB {
        r = a -% b;
    } else if op == OP_MUL {
        r = a *% b;
    } else if op == OP_AND {
        r = a & b;
    } else if op == OP_OR {
        r = a | b;
    } else if op == OP_XOR {
        r = a ^ b;
    } else if op == OP_SHL {
        if b >= @int_cast(u64, bits) {
            return vnil();
        }
        r = a << @truncate(u32, b);
    } else if op == OP_LSHR {
        if b >= @int_cast(u64, bits) {
            return vnil();
        }
        r = a >> @truncate(u32, b);
    } else if op == OP_ASHR {
        if b >= @int_cast(u64, bits) {
            return vnil();
        }
        r = @bit_cast(u64, sval(x) >> @truncate(u32, b));
    } else if op == OP_UDIV {
        if b == 0 {
            return vnil();
        }
        r = a / b;
    } else if op == OP_UREM {
        if b == 0 {
            return vnil();
        }
        r = a % b;
    } else if (op == OP_SDIV) or (op == OP_SREM) {
        let sa = sval(x);
        let sb = sval(y);
        if (sb == 0) or ((sb == -1) and (a == (@as(u64, 1) << @int_cast(u32, bits - 1)))) {
            return vnil();
        }
        if op == OP_SDIV {
            r = @bit_cast(u64, sa / sb);
        } else {
            r = @bit_cast(u64, sa % sb);
        }
    } else {
        return vnil();
    }
    return cint(t, r);
}

pub fn binop(bd: *mut Builder, op: i32, x: *mut Value, y: *mut Value) *mut Value {
    let t = x.ty;
    if (t.kind == T_INT) and is_cint(x) and is_cint(y) and (t.bits <= 64) {
        let r = fold_int_bin(op, t, x, y);
        if u.notnil(r) {
            return r;
        }
    }
    let v = emit(bd, op, t);
    v.a = x;
    v.b = y;
    return v;
}

pub fn add(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_ADD, x, y);
}

pub fn sub(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_SUB, x, y);
}

pub fn mul(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_MUL, x, y);
}

pub fn and_(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_AND, x, y);
}

pub fn or_(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_OR, x, y);
}

pub fn xor(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_XOR, x, y);
}

pub fn not_(bd: *mut Builder, x: *mut Value) *mut Value {
    return binop(bd, OP_XOR, x, cones(x.ty));
}

pub fn neg(bd: *mut Builder, x: *mut Value) *mut Value {
    return binop(bd, OP_SUB, czero(x.ty), x);
}

pub fn fneg(bd: *mut Builder, x: *mut Value) *mut Value {
    if x.kind == V_CFP {
        return cfp(x.ty, -x.fv);
    }
    let v = emit(bd, OP_FNEG, x.ty);
    v.a = x;
    return v;
}

fn cmp_fold(p: i32, x: *Value, y: *Value) i32 {
    let a = cint_val(x);
    let b = cint_val(y);
    let sa = sval(x);
    let sb = sval(y);
    let mut r = false;
    if p == IntEQ {
        r = a == b;
    } else if p == IntNE {
        r = a != b;
    } else if p == IntUGT {
        r = a > b;
    } else if p == IntUGE {
        r = a >= b;
    } else if p == IntULT {
        r = a < b;
    } else if p == IntULE {
        r = a <= b;
    } else if p == IntSGT {
        r = sa > sb;
    } else if p == IntSGE {
        r = sa >= sb;
    } else if p == IntSLT {
        r = sa < sb;
    } else if p == IntSLE {
        r = sa <= sb;
    }
    if r {
        return 1;
    }
    return 0;
}

// Comparisons: i1, or for vectors a lane mask (all ones / zeros) of the
// operands' shape with integer lanes.
fn cmp_ty(t: *mut Ty) *mut Ty {
    if t.kind == T_VEC {
        if t.elem.kind == T_FLOAT {
            return t_vec(t_int(t.elem.bits), @int_cast(u32, t.lanes));
        }
        return t;
    }
    return t_int(1);
}

pub fn icmp(bd: *mut Builder, p: i32, x: *mut Value, y: *mut Value) *mut Value {
    if (x.ty.kind != T_VEC) and is_cint(x) and is_cint(y) and (x.ty.bits <= 64) {
        return cint(t_int(1), @as(u64, @bit_cast(u32, cmp_fold(p, x, y))));
    }
    let v = emit(bd, OP_ICMP, cmp_ty(x.ty));
    v.cv = @as(u64, @bit_cast(u32, p));
    v.a = x;
    v.b = y;
    return v;
}

pub fn fcmp(bd: *mut Builder, p: i32, x: *mut Value, y: *mut Value) *mut Value {
    let v = emit(bd, OP_FCMP, cmp_ty(x.ty));
    v.cv = @as(u64, @bit_cast(u32, p));
    v.a = x;
    v.b = y;
    return v;
}

pub fn is_null(bd: *mut Builder, p: *mut Value) *mut Value {
    return icmp(bd, IntEQ, p, czero(p.ty));
}

pub fn select(bd: *mut Builder, c: *mut Value, x: *mut Value, y: *mut Value) *mut Value {
    if c.kind == V_CINT {
        if c.cv != 0 {
            return x;
        }
        return y;
    }
    if x == y {
        return x;
    }
    let v = emit(bd, OP_SELECT, x.ty);
    v.a = c;
    v.b = x;
    v.c = y;
    return v;
}

pub fn cast(bd: *mut Builder, op: i32, x: *mut Value, t: *mut Ty) *mut Value {
    if x.ty == t {
        if (op == OP_ZEXT) or (op == OP_SEXT) or (op == OP_TRUNC) or (op == OP_BITCAST) {
            return x;
        }
    }
    if (x.kind == V_CINT) or ((x.kind == V_ZERO) and (x.ty.kind == T_INT)) {
        if (op == OP_ZEXT) or (op == OP_TRUNC) {
            return cint(t, cint_val(x));
        }
        if op == OP_SEXT {
            return cint(t, @bit_cast(u64, sval(x)));
        }
        if op == OP_INTTOPTR {
            return cinttoptr(x);
        }
    }
    if (x.kind == V_ZERO) and (op == OP_PTRTOINT) {
        return cint(t, 0);
    }
    if (x.kind == V_UNDEF) and (op != OP_FPTOSI_SAT) and (op != OP_FPTOUI_SAT) {
        return undef(t);
    }
    let v = emit(bd, op, t);
    v.a = x;
    return v;
}

pub fn zext(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    return cast(bd, OP_ZEXT, x, t);
}

pub fn sext(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    return cast(bd, OP_SEXT, x, t);
}

pub fn trunc(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    return cast(bd, OP_TRUNC, x, t);
}

pub fn bitcast(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    return cast(bd, OP_BITCAST, x, t);
}

pub fn ptrtoint(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    let v = cast(bd, OP_PTRTOINT, x, t_int(@int_cast(i32, ptr_bytes * 8)));
    if t.bits == @int_cast(i32, ptr_bytes * 8) {
        return v;
    }
    if t.bits < @int_cast(i32, ptr_bytes * 8) {
        return trunc(bd, v, t);
    }
    return zext(bd, v, t);
}

pub fn inttoptr(bd: *mut Builder, x: *mut Value) *mut Value {
    let pt = t_int(@int_cast(i32, ptr_bytes * 8));
    let mut y = x;
    if x.ty.bits < pt.bits {
        y = zext(bd, x, pt);
    } else if x.ty.bits > pt.bits {
        y = trunc(bd, x, pt);
    }
    return cast(bd, OP_INTTOPTR, y, t_ptr());
}

pub fn alloca(bd: *mut Builder, t: *mut Ty, name: []u8) *mut Value {
    let v = emit(bd, OP_ALLOCA, t_ptr());
    v.aty = t;
    v.align = @int_cast(u32, t.align);
    v.name = name;
    return v;
}

pub fn load(bd: *mut Builder, t: *mut Ty, p: *mut Value) *mut Value {
    let v = emit(bd, OP_LOAD, t);
    v.a = p;
    v.align = @int_cast(u32, t.align);
    return v;
}

pub fn store(bd: *mut Builder, x: *mut Value, p: *mut Value) *mut Value {
    let v = emit(bd, OP_STORE, t_void());
    v.a = x;
    v.b = p;
    v.align = @int_cast(u32, x.ty.align);
    return v;
}

pub fn isz() *mut Ty {
    return t_int(@int_cast(i32, ptr_bytes * 8));
}

// p + off bytes (off: a pointer-sized integer)
pub fn ptradd(bd: *mut Builder, p: *mut Value, off: *mut Value) *mut Value {
    if is_cint(off) and (cint_val(off) == 0) {
        return p;
    }
    if (p.kind == V_INST) and (p.op == OP_PTRADD) and is_cint(p.b) and is_cint(off) {
        return ptradd(bd, p.a, cint(isz(), cint_val(p.b) +% cint_val(off)));
    }
    let v = emit(bd, OP_PTRADD, t_ptr());
    v.a = p;
    v.b = off;
    return v;
}

fn index_isz(bd: *mut Builder, i: *mut Value) *mut Value {
    let t = isz();
    if i.ty.bits < t.bits {
        return sext(bd, i, t);
    }
    if i.ty.bits > t.bits {
        return trunc(bd, i, t);
    }
    return i;
}

fn scaled(bd: *mut Builder, i: *mut Value, size: u64) *mut Value {
    let x = index_isz(bd, i);
    if size == 1 {
        return x;
    }
    return mul(bd, x, cint(isz(), size));
}

// LLVM-style GEP: the first index steps over whole `t`s; the rest index
// into struct fields (constant) or array elements.
pub fn gep(bd: *mut Builder, t: *mut Ty, p: *mut Value, idx: []mut *mut Value) *mut Value {
    let mut off = scaled(bd, idx[0], t.size);
    let mut cur = t;
    for k in 1..idx.len {
        let i = idx[k];
        if cur.kind == T_STRUCT {
            let fi = @truncate(usize, cint_val(i));
            off = add(bd, off, cint(isz(), cur.offs[fi]));
            cur = cur.fields[fi];
        } else {
            off = add(bd, off, scaled(bd, i, cur.elem.size));
            cur = cur.elem;
        }
    }
    return ptradd(bd, p, off);
}

pub fn gep1(bd: *mut Builder, t: *mut Ty, p: *mut Value, i: *mut Value) *mut Value {
    return ptradd(bd, p, scaled(bd, i, t.size));
}

pub fn struct_gep(bd: *mut Builder, t: *mut Ty, p: *mut Value, i: u32) *mut Value {
    return ptradd(bd, p, cint(isz(), field_off(t, @as(usize, i))));
}

pub fn memop(bd: *mut Builder, op: i32, d: *mut Value, s: *mut Value, n: *mut Value) *mut Value {
    let v = emit(bd, op, t_void());
    v.a = d;
    v.b = s;
    v.c = index_isz(bd, n);
    return v;
}

pub fn rmw(bd: *mut Builder, op: i32, p: *mut Value, x: *mut Value) *mut Value {
    let v = emit(bd, OP_RMW, x.ty);
    v.cv = @as(u64, @bit_cast(u32, op));
    v.a = p;
    v.b = x;
    v.align = @int_cast(u32, x.ty.size);
    v.flags = F_ATOMIC;
    return v;
}

pub fn cmpxchg(bd: *mut Builder, p: *mut Value, e: *mut Value, n: *mut Value) *mut Value {
    let v = emit(bd, OP_CMPXCHG, e.ty);
    v.a = p;
    v.b = e;
    v.c = n;
    v.align = @int_cast(u32, e.ty.size);
    v.flags = F_ATOMIC;
    return v;
}

pub fn fence(bd: *mut Builder) void {
    _ = emit(bd, OP_FENCE, t_void());
}

pub fn extract(bd: *mut Builder, agg: *mut Value, i: u32) *mut Value {
    let ft = field_ty(agg.ty, @as(usize, i));
    if agg.kind == V_CAGG {
        return agg.xs.get(@as(usize, i));
    }
    if agg.kind == V_ZERO {
        return czero(ft);
    }
    if agg.kind == V_UNDEF {
        return undef(ft);
    }
    // extract(insert(x, v, i), i) = v
    if (agg.kind == V_INST) and (agg.op == OP_INSERTVALUE) and (agg.cv == @as(u64, i)) {
        return agg.b;
    }
    let v = emit(bd, OP_EXTRACTVALUE, ft);
    v.a = agg;
    v.cv = @as(u64, i);
    return v;
}

pub fn insert(bd: *mut Builder, agg: *mut Value, x: *mut Value, i: u32) *mut Value {
    // constants fold (a literal of constants is a constant, and lowering
    // turns a large one into read-only data instead of stores)
    let ak = agg.kind;
    if is_const(x) and ((ak == V_CAGG) or (ak == V_UNDEF) or (ak == V_ZERO)) and (agg.ty.kind != T_VEC) and
       (field_count(agg.ty) <= 256) {
        let n = field_count(agg.ty);
        let xs = u.newn.[*mut Value](n + 1);
        for k in 0..n {
            if k == @as(usize, i) {
                xs[k] = x;
            } else if ak == V_CAGG {
                xs[k] = agg.xs.get(k);
            } else if ak == V_ZERO {
                xs[k] = czero(field_ty(agg.ty, k));
            } else {
                xs[k] = undef(field_ty(agg.ty, k));
            }
        }
        return cagg(agg.ty, xs[0..n]);
    }
    let v = emit(bd, OP_INSERTVALUE, agg.ty);
    v.a = agg;
    v.b = x;
    v.cv = @as(u64, i);
    return v;
}

pub fn extract_elem(bd: *mut Builder, vec: *mut Value, i: u64) *mut Value {
    let v = emit(bd, OP_EXTRACTELEM, vec.ty.elem);
    v.a = vec;
    v.cv = i;
    return v;
}

pub fn insert_elem(bd: *mut Builder, vec: *mut Value, x: *mut Value, i: u64) *mut Value {
    let v = emit(bd, OP_INSERTELEM, vec.ty);
    v.a = vec;
    v.b = x;
    v.cv = i;
    return v;
}

pub fn splat(bd: *mut Builder, vt: *mut Ty, x: *mut Value) *mut Value {
    let v = emit(bd, OP_SPLAT, vt);
    v.a = x;
    return v;
}

// Result lanes pick from the concatenation of x and y (indices into 2n lanes).
pub fn shuffle(bd: *mut Builder, x: *mut Value, y: *mut Value, mask: []i32) *mut Value {
    let n = mask.len;
    let v = emit(bd, OP_SHUFFLE, t_vec(x.ty.elem, @int_cast(u32, n)));
    v.a = x;
    v.b = y;
    v.mask = u.newn.[i32](n + 1)[0..n];
    for i in 0..n {
        v.mask[i] = mask[i];
    }
    return v;
}

pub fn call(bd: *mut Builder, fty: *mut Ty, callee: *mut Value, args: []mut *mut Value) *mut Value {
    let v = emit(bd, OP_CALL, fty.ret);
    v.fty = fty;
    v.a = callee;
    for x in args {
        v.xs.push(x);
    }
    v.ext = u.newn.[u8](args.len + 1)[0..args.len + 1];
    return v;
}

pub fn intr(bd: *mut Builder, id: i32, t: *mut Ty, args: []mut *mut Value) *mut Value {
    let v = emit(bd, OP_INTR, t);
    v.cv = @as(u64, @bit_cast(u32, id));
    for x in args {
        v.xs.push(x);
    }
    return v;
}

pub fn intr1(bd: *mut Builder, id: i32, x: *mut Value) *mut Value {
    let mut a: [1]*mut Value = [x];
    return intr(bd, id, x.ty, a[..]);
}

pub fn intr2(bd: *mut Builder, id: i32, x: *mut Value, y: *mut Value) *mut Value {
    let mut a: [2]*mut Value = [x, y];
    return intr(bd, id, x.ty, a[..]);
}

pub fn phi(bd: *mut Builder, t: *mut Ty) *mut Value {
    return emit(bd, OP_PHI, t);
}

pub fn add_incoming(p: *mut Value, x: *mut Value, b: *mut Block) void {
    p.xs.push(x);
    p.bs.push(b);
}

pub fn br(bd: *mut Builder, b: *mut Block) void {
    let v = emit(bd, OP_BR, t_void());
    v.t1 = b;
}

pub fn condbr(bd: *mut Builder, c: *mut Value, t: *mut Block, e: *mut Block) void {
    if c.kind == V_CINT {
        if c.cv != 0 {
            br(bd, t);
        } else {
            br(bd, e);
        }
        return;
    }
    let v = emit(bd, OP_CONDBR, t_void());
    v.a = c;
    v.t1 = t;
    v.t2 = e;
}

pub fn switch_(bd: *mut Builder, x: *mut Value, dflt: *mut Block) *mut Value {
    let v = emit(bd, OP_SWITCH, t_void());
    v.a = x;
    v.t1 = dflt;
    return v;
}

pub fn add_case(sw: *mut Value, c: *mut Value, b: *mut Block) void {
    sw.xs.push(c);
    sw.bs.push(b);
}

pub fn ret(bd: *mut Builder, x: *mut Value) void {
    let v = emit(bd, OP_RET, t_void());
    v.a = x;
}

pub fn ret_void(bd: *mut Builder) void {
    _ = emit(bd, OP_RET, t_void());
}

pub fn unreachable(bd: *mut Builder) void {
    _ = emit(bd, OP_UNREACHABLE, t_void());
}

// -----------------------------------------------------------------------------
// Printing (for --emit=ir and debugging)
// -----------------------------------------------------------------------------
fn op_name(op: i32) []u8 {
    let names = ["?", "add", "sub", "mul", "udiv", "sdiv", "urem", "srem", "and", "or", "xor", "shl", "lshr", "ashr",
                 "fadd", "fsub", "fmul", "fdiv", "frem", "fneg", "icmp", "fcmp", "select", "zext", "sext", "trunc",
                 "bitcast", "ptrtoint", "inttoptr", "fpext", "fptrunc", "sitofp", "uitofp", "fptosi.sat", "fptoui.sat",
                 "alloca", "load", "store", "ptradd", "memcpy", "memmove", "memset", "atomicrmw", "cmpxchg", "fence",
                 "extractvalue", "insertvalue", "extractelement", "insertelement", "shuffle", "splat", "call", "intr",
                 "phi", "br", "condbr", "switch", "ret", "unreachable", "copy"];
    if (op < 0) or (@int_cast(usize, op) >= names.len) {
        return "?";
    }
    return names[@int_cast(usize, op)];
}

pub fn val_str(v: *Value) []u8 {
    let k = v.kind;
    if k == V_INST {
        return u.cat2("%", u.idec(v.id));
    }
    if k == V_PARAM {
        return u.cat2("%arg", u.udec(v.cv));
    }
    if k == V_CINT {
        if v.ty.bits == 1 {
            return u.pick(v.cv != 0, "true", "false");
        }
        return u.dec(sval(v));
    }
    if k == V_CFP {
        return u.ffmt("%g", v.fv);
    }
    if k == V_ZERO {
        return "zero";
    }
    if k == V_UNDEF {
        return "undef";
    }
    if k == V_GLOBAL {
        return u.cat2("@", v.gv.name);
    }
    if k == V_FUNC {
        return u.cat2("@", v.fnp.name);
    }
    let mut b = u.Buf.init();
    b.s("{");
    for i in 0..v.xs.len {
        if i != 0 {
            b.s(", ");
        }
        b.s(val_str(v.xs.get(i)));
    }
    b.s("}");
    return b.done();
}

fn blk_str(b: *Block) []u8 {
    return u.f2("%%%s.%s", b.name, u.idec(b.id));
}

pub fn inst_str(v: *Value) []u8 {
    let mut b = u.Buf.init();
    if v.ty.kind != T_VOID {
        b.s(val_str(v));
        b.s(" = ");
    }
    b.s(op_name(v.op));
    if (v.op == OP_ICMP) or (v.op == OP_FCMP) or (v.op == OP_RMW) or (v.op == OP_INTR) or (v.op == OP_EXTRACTVALUE) or
       (v.op == OP_INSERTVALUE) or (v.op == OP_EXTRACTELEM) or (v.op == OP_INSERTELEM) {
        b.s(".");
        b.s(u.udec(v.cv));
    }
    if (v.flags & F_ATOMIC) != 0 {
        b.s(" atomic");
    }
    if (v.flags & F_VOLATILE) != 0 {
        b.s(" volatile");
    }
    b.s(" ");
    b.s(ty_str(v.ty));
    if v.op == OP_ALLOCA {
        b.s(" ");
        b.s(ty_str(v.aty));
    }
    let ops: [3]*mut Value = [v.a, v.b, v.c];
    for o in ops {
        if u.notnil(o) {
            b.s(" ");
            b.s(val_str(o));
        }
    }
    for i in 0..v.xs.len {
        b.s(", ");
        b.s(val_str(v.xs.get(i)));
        if (v.op == OP_CALL) and ((i + 1) < v.ext.len) {
            if v.ext[i + 1] == EXT_BYVAL {
                b.s(" byval");
            } else if v.ext[i + 1] == EXT_SRET {
                b.s(" sret");
            }
        }
        if i < v.bs.len {
            b.s(" ");
            b.s(blk_str(v.bs.get(i)));
        }
    }
    if u.notnil(v.t1) {
        b.s(" -> ");
        b.s(blk_str(v.t1));
    }
    if u.notnil(v.t2) {
        b.s(", ");
        b.s(blk_str(v.t2));
    }
    if v.mask.len > 0 {
        b.s(" [");
        for i in 0..v.mask.len {
            if i != 0 {
                b.s(",");
            }
            b.s(u.idec(v.mask[i]));
        }
        b.s("]");
    }
    if v.align != 0 {
        b.s(", align ");
        b.s(u.udec(@as(u64, v.align)));
    }
    return b.done();
}

pub fn func_str(f: *mut Func) []u8 {
    let mut b = u.Buf.init();
    b.s(u.pick(is_decl(f), "declare ", "define "));
    b.s(ty_str(f.ty.ret));
    b.s(" @");
    b.s(f.name);
    b.s("(");
    for i in 0..f.params.len {
        if i != 0 {
            b.s(", ");
        }
        b.s(ty_str(f.params[i].ty));
    }
    b.s(")");
    if is_decl(f) {
        b.s("\n");
        return b.done();
    }
    b.s(" {\n");
    let mut bb = f.first;
    while u.notnil(bb) {
        b.s(blk_str(bb));
        b.s(":\n");
        let mut i = bb.first;
        while u.notnil(i) {
            b.s("    ");
            b.s(inst_str(i));
            b.s("\n");
            i = i.next;
        }
        bb = bb.next;
    }
    b.s("}\n");
    return b.done();
}

pub fn module_str(m: *mut Module) []u8 {
    let mut b = u.Buf.init();
    for i in 0..m.globals.len {
        let g = m.globals.get(i);
        b.s("@");
        b.s(g.name);
        b.s(" = ");
        b.s(u.pick(g.is_const, "constant ", "global "));
        b.s(ty_str(g.ty));
        if u.notnil(g.init) {
            b.s(" ");
            b.s(val_str(g.init));
        }
        b.s("\n");
    }
    for i in 0..m.funcs.len {
        b.s("\n");
        b.s(func_str(m.funcs.get(i)));
    }
    return b.done();
}

// -----------------------------------------------------------------------------
// CFG utilities
// -----------------------------------------------------------------------------
// Deletes the blocks not reachable from the entry, and the phi inputs that
// came from them.
pub fn remove_unreachable(f: *mut Func) void {
    if u.isnil(f.first) {
        return;
    }
    let mut b = f.first;
    while u.notnil(b) {
        b.aux = 0;
        b = b.next;
    }
    let mut work = u.List.[*mut Block].{ data: u.nil.[*mut Block](), len: 0, cap: 0 };
    f.first.aux = 1;
    work.push(f.first);
    while work.len > 0 {
        let x = work.pop();
        let t = terminator(x);
        for i in 0..succ_count(t) {
            let s = succ(t, i);
            if s.aux == 0 {
                s.aux = 1;
                work.push(s);
            }
        }
    }
    u.free(@ptr_cast(*mut void, work.data));
    b = f.first;
    let mut any = false;
    while u.notnil(b) {
        let next = b.next;
        if b.aux == 0 {
            remove_block(b);
            any = true;
        }
        b = next;
    }
    if not any {
        return;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) and (i.op == OP_PHI) {
            let mut k: usize = 0;
            while k < i.bs.len {
                if i.bs.get(k).aux == 0 {
                    i.bs.set(k, i.bs.get(i.bs.len - 1));
                    i.xs.set(k, i.xs.get(i.xs.len - 1));
                    i.bs.len -= 1;
                    i.xs.len -= 1;
                } else {
                    k += 1;
                }
            }
            i = i.next;
        }
        b = b.next;
    }
}

fn resolve_const(c: *mut Value) void {
    if c.kind != V_CAGG {
        return;
    }
    for k in 0..c.xs.len {
        let x = resolve(c.xs.get(k));
        c.xs.set(k, x);
        resolve_const(x);
    }
}

// Declarations of a function the module also defines (an extern "C" block
// naming a runtime export, say) refer to the definition. Same for globals.
pub fn merge_same_named(m: *mut Module) void {
    let mut defs = u.SymMap.[*mut Func].{ keys: u.nil.[usize](), vals: u.nil.[*mut Func](), cap: 0, len: 0 };
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if not is_decl(f) and (f.linkage != LINK_INTERNAL) {
            defs.put(f.name, f);
        }
    }
    let mut any = false;
    let mut kept = u.List.[*mut Func].{ data: u.nil.[*mut Func](), len: 0, cap: 0 };
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if is_decl(f) {
            let d = defs.get(f.name);
            if u.notnil(d) {
                forward(f.val, d.val);
                any = true;
                continue;
            }
        }
        f.id = @int_cast(i32, kept.len);
        kept.push(f);
    }
    if not any {
        return;
    }
    m.funcs = kept;
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        m.fmap.put(f.name, f);
        apply_forwarding(f);
    }
    for i in 0..m.globals.len {
        let g = m.globals.get(i);
        if u.notnil(g.init) {
            g.init = resolve(g.init);
            resolve_const(g.init);
        }
    }
}
