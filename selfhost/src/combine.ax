// =============================================================================
// combine.ax - instruction combining: algebraic identities, canonical forms
// (constants on the right, `sub x, c` as `add x, -c`), folding chains of
// constant operations, strength reduction (multiplication and division by
// powers of two), comparison simplification (including the forms the
// overflow checks take) and boolean logic.
//
// simplify(i) returns the value i can be replaced by, or nil; it may insert
// new instructions before i. Floating point is left alone (no rewrite may
// change a result, spec §7.7) but for division by a power of two, which is
// multiplication by its exact reciprocal; vectors and 128-bit integers are
// left alone too.
// =============================================================================
import "ir.ax" as ir;
import "util.ax" as u;

fn vnil() *mut ir.Value {
    return u.nil.[ir.Value]();
}

// An integer (or null pointer) constant.
pub fn is_k(v: *ir.Value) bool {
    return (v.kind == ir.V_CINT) or ((v.kind == ir.V_ZERO) and ((v.ty.kind == ir.T_INT) or (v.ty.kind == ir.T_PTR)));
}

pub fn is_kv1(v: *ir.Value) bool {
    return is_kv(v, 1);
}

fn kval(v: *ir.Value) u64 {
    return ir.cint_val(v);
}

fn is_kv(v: *ir.Value, x: u64) bool {
    return is_k(v) and (kval(v) == (x & ir.mask_bits(v.ty.bits)));
}

fn is_op(v: *ir.Value, op: i32) bool {
    return (v.kind == ir.V_INST) and (v.op == op);
}

// A scalar integer of at most 64 bits.
fn small_int(t: *ir.Ty) bool {
    return (t.kind == ir.T_INT) and (t.bits <= 64);
}

// log2 of x when x is a power of two, else -1.
pub fn log2(x: u64) i32 {
    if (x == 0) or ((x & (x -% 1)) != 0) {
        return -1;
    }
    let mut n: i32 = 0;
    let mut y = x;
    while y > 1 {
        y = y >> 1;
        n += 1;
    }
    return n;
}

fn commutative(op: i32) bool {
    return (op == ir.OP_ADD) or (op == ir.OP_MUL) or (op == ir.OP_AND) or (op == ir.OP_OR) or (op == ir.OP_XOR);
}

// The predicate with its operands swapped: a p b == b swap(p) a.
pub fn swap_pred(p: i32) i32 {
    if p == ir.IntUGT {
        return ir.IntULT;
    }
    if p == ir.IntULT {
        return ir.IntUGT;
    }
    if p == ir.IntUGE {
        return ir.IntULE;
    }
    if p == ir.IntULE {
        return ir.IntUGE;
    }
    if p == ir.IntSGT {
        return ir.IntSLT;
    }
    if p == ir.IntSLT {
        return ir.IntSGT;
    }
    if p == ir.IntSGE {
        return ir.IntSLE;
    }
    if p == ir.IntSLE {
        return ir.IntSGE;
    }
    return p;
}

// The negated predicate: not (a p b) == a inv(p) b.
pub fn inv_pred(p: i32) i32 {
    if p == ir.IntEQ {
        return ir.IntNE;
    }
    if p == ir.IntNE {
        return ir.IntEQ;
    }
    if p == ir.IntUGT {
        return ir.IntULE;
    }
    if p == ir.IntULE {
        return ir.IntUGT;
    }
    if p == ir.IntUGE {
        return ir.IntULT;
    }
    if p == ir.IntULT {
        return ir.IntUGE;
    }
    if p == ir.IntSGT {
        return ir.IntSLE;
    }
    if p == ir.IntSLE {
        return ir.IntSGT;
    }
    if p == ir.IntSGE {
        return ir.IntSLT;
    }
    return ir.IntSGE;  // SLT
}

pub fn pred_of(v: *ir.Value) i32 {
    return @truncate(i32, @bit_cast(i64, v.cv));
}

fn is_signed_pred(p: i32) bool {
    return (p >= ir.IntSGT) and (p <= ir.IntSLE);
}

fn smax(bits: i32) u64 {
    return ir.mask_bits(bits) >> 1;
}

fn smin(bits: i32) u64 {
    return (ir.mask_bits(bits) >> 1) +% 1;
}

fn kt(t: *mut ir.Ty, x: u64) *mut ir.Value {
    return ir.cint(t, x);
}

fn ktrue() *mut ir.Value {
    return ir.cint(ir.t_int(1), 1);
}

fn kfalse() *mut ir.Value {
    return ir.cint(ir.t_int(1), 0);
}

fn kbool(b: bool) *mut ir.Value {
    if b {
        return ktrue();
    }
    return kfalse();
}

// A new comparison before i.
fn mk_icmp(B: *mut ir.Builder, p: i32, a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    return ir.icmp(B, p, a, b);
}

// The value `not x` for an i1 x, when it exists without a new instruction
// or x is a comparison (which is inverted).
fn negate_bool(B: *mut ir.Builder, x: *mut ir.Value) *mut ir.Value {
    if x.kind == ir.V_CINT {
        return kbool(x.cv == 0);
    }
    if is_op(x, ir.OP_XOR) and is_kv(x.b, 1) {
        return x.a;
    }
    if is_op(x, ir.OP_ICMP) and (x.ty.kind == ir.T_INT) {
        return mk_icmp(B, inv_pred(pred_of(x)), x.a, x.b);
    }
    return vnil();
}

// Is the comparison `x p k` (k a constant of x's width) always true or false?
// 1: true, 0: false, -1: unknown.
fn cmp_const_range(p: i32, bits: i32, k: u64) i32 {
    let max = ir.mask_bits(bits);
    let sk = k;
    if (p == ir.IntULT) and (k == 0) {
        return 0;
    }
    if (p == ir.IntUGE) and (k == 0) {
        return 1;
    }
    if (p == ir.IntUGT) and (k == max) {
        return 0;
    }
    if (p == ir.IntULE) and (k == max) {
        return 1;
    }
    if (p == ir.IntSLT) and (sk == smin(bits)) {
        return 0;
    }
    if (p == ir.IntSGE) and (sk == smin(bits)) {
        return 1;
    }
    if (p == ir.IntSGT) and (sk == smax(bits)) {
        return 0;
    }
    if (p == ir.IntSLE) and (sk == smax(bits)) {
        return 1;
    }
    return -1;
}

// The float 1.0, or a vector of them.
fn fone(v: *ir.Value) bool {
    if v.kind == ir.V_CFP {
        return v.fv == 1.0;
    }
    if is_op(v, ir.OP_SPLAT) {
        return fone(v.a);
    }
    if (v.kind == ir.V_CAGG) and (v.ty.kind == ir.T_VEC) {
        for k in 0..v.xs.len {
            if not fone(v.xs.get(k)) {
                return false;
            }
        }
        return v.xs.len > 0;
    }
    return false;
}

// A vector of zeros (a constant, or a splat of zero).
fn vzero(v: *ir.Value) bool {
    return ir.is_zero(v) or (is_op(v, ir.OP_SPLAT) and ir.is_zero(v.a));
}

fn pick_pred(c: bool, a: i32, b: i32) i32 {
    if c {
        return a;
    }
    return b;
}

fn simplify_icmp(B: *mut ir.Builder, i: *mut ir.Value) *mut ir.Value {
    let mut p = pred_of(i);
    let mut a = i.a;
    let mut b = i.b;
    let at = a.ty;
    if (at.kind == ir.T_VEC) and (at.elem.kind == ir.T_INT) {
        // lanes >u 0 -> lanes != 0, lanes <=u 0 -> lanes == 0 (and with the
        // zero on the left)
        if vzero(a) and not vzero(b) {
            i.a = b;
            i.b = a;
            i.cv = @as(u64, @bit_cast(u32, swap_pred(p)));
            p = pred_of(i);
        }
        if vzero(i.b) and ((p == ir.IntUGT) or (p == ir.IntULE)) {
            i.cv = @as(u64, @bit_cast(u32, pick_pred(p == ir.IntUGT, ir.IntNE, ir.IntEQ)));
        }
        return vnil();
    }
    if (at.kind != ir.T_INT) and (at.kind != ir.T_PTR) {
        return vnil();
    }
    if at.bits > 64 {
        return vnil();
    }
    if is_k(a) and is_k(b) {
        return ir.icmp(B, p, a, b);
    }
    // constants on the right
    if is_k(a) and not is_k(b) {
        i.a = b;
        i.b = a;
        i.cv = @as(u64, @bit_cast(u32, swap_pred(p)));
        p = pred_of(i);
        a = i.a;
        b = i.b;
    }
    if a == b {
        return kbool((p == ir.IntEQ) or (p == ir.IntUGE) or (p == ir.IntULE) or (p == ir.IntSGE) or (p == ir.IntSLE));
    }
    let bits = at.bits;
    if is_k(b) and (at.kind == ir.T_INT) {
        let k = kval(b);
        let r = cmp_const_range(p, bits, k);
        if r >= 0 {
            return kbool(r == 1);
        }
        // x <u 1 -> x == 0; x >u 0 -> x != 0 and friends
        if (p == ir.IntULT) and (k == 1) {
            return mk_icmp(B, ir.IntEQ, a, kt(at, 0));
        }
        if (p == ir.IntUGE) and (k == 1) {
            return mk_icmp(B, ir.IntNE, a, kt(at, 0));
        }
        if (p == ir.IntUGT) and (k == 0) {
            return mk_icmp(B, ir.IntNE, a, b);
        }
        if (p == ir.IntULE) and (k == 0) {
            return mk_icmp(B, ir.IntEQ, a, b);
        }
        // i1 comparisons against constants
        if bits == 1 {
            if ((p == ir.IntNE) and (k == 0)) or ((p == ir.IntEQ) and (k == 1)) {
                return a;
            }
            if ((p == ir.IntEQ) and (k == 0)) or ((p == ir.IntNE) and (k == 1)) {
                let n = negate_bool(B, a);
                if u.notnil(n) {
                    return n;
                }
            }
        }
        // (zext x) == k  ->  x == trunc k (or a constant when k does not fit)
        if (is_op(a, ir.OP_ZEXT) or is_op(a, ir.OP_SEXT)) and (a.a.ty.kind == ir.T_INT) {
            let x = a.a;
            let xb = x.ty.bits;
            let xm = ir.mask_bits(xb);
            let mut fits = false;
            if a.op == ir.OP_ZEXT {
                fits = (k & ~xm) == 0;
            } else {
                // k is the sign extension of its low xb bits
                let low = k & xm;
                let sext_low = @bit_cast(u64, ir.sval(ir.cint(x.ty, low)));
                fits = (sext_low & ir.mask_bits(bits)) == k;
            }
            if (p == ir.IntEQ) or (p == ir.IntNE) {
                if not fits {
                    return kbool(p == ir.IntNE);
                }
                return mk_icmp(B, p, x, kt(x.ty, k & xm));
            }
            // unsigned comparisons of a zero extension with a fitting constant,
            // signed ones of a sign extension
            if fits and
               (((a.op == ir.OP_ZEXT) and not is_signed_pred(p)) or ((a.op == ir.OP_SEXT) and is_signed_pred(p))) {
                return mk_icmp(B, p, x, kt(x.ty, k & xm));
            }
        }
        // (x + c) == k  ->  x == k - c
        if ((p == ir.IntEQ) or (p == ir.IntNE)) and is_op(a, ir.OP_ADD) and is_k(a.b) {
            return mk_icmp(B, p, a.a, kt(at, k -% kval(a.b)));
        }
        // (x ^ c) == k  ->  x == k ^ c
        if ((p == ir.IntEQ) or (p == ir.IntNE)) and is_op(a, ir.OP_XOR) and is_k(a.b) {
            return mk_icmp(B, p, a.a, kt(at, k ^ kval(a.b)));
        }
        // (x - y) == 0  ->  x == y ; (x ^ y) == 0 -> x == y
        if ((p == ir.IntEQ) or (p == ir.IntNE)) and (k == 0) and (is_op(a, ir.OP_SUB) or is_op(a, ir.OP_XOR)) {
            return mk_icmp(B, p, a.a, a.b);
        }
        // ptrtoint p == 0  ->  p == null
        if ((p == ir.IntEQ) or (p == ir.IntNE)) and (k == 0) and is_op(a, ir.OP_PTRTOINT) and
           (bits == @int_cast(i32, ir.ptr_bytes * 8)) {
            return mk_icmp(B, p, a.a, ir.czero(ir.t_ptr()));
        }
    }
    // Widening multiplication overflow (narrow types): ext(trunc p) != p for
    // p = mul (ext x) c is a range check on x.
    if ((p == ir.IntEQ) or (p == ir.IntNE)) and (at.kind == ir.T_INT) and (bits <= 64) {
        let mut prod = b;
        let mut back = a;
        if not is_op(prod, ir.OP_MUL) {
            prod = a;
            back = b;
        }
        // (the truncated product may already be the narrow product x * c)
        let mut narrow_ok = false;
        if is_op(prod, ir.OP_MUL) and is_k(prod.b) and (is_op(back, ir.OP_ZEXT) or is_op(back, ir.OP_SEXT)) and
           (back.op == prod.a.op) and (prod.a.a.ty == back.a.ty) {
            let nb = back.a;
            if is_op(nb, ir.OP_TRUNC) and (nb.a == prod) {
                narrow_ok = true;
            } else if is_op(nb, ir.OP_MUL) and (nb.a == prod.a.a) and is_k(nb.b) and
                      (kval(nb.b) == (kval(prod.b) & ir.mask_bits(nb.ty.bits))) {
                narrow_ok = true;
            }
        }
        if narrow_ok {
            let x = prod.a.a;
            let w = x.ty.bits;
            if (w < bits) and (w <= 32) and (w >= 8) {
                let r = narrow_mul_overflow(B, x, prod.a.op == ir.OP_SEXT, ir.sval(prod.b), kval(prod.b));
                if u.notnil(r) {
                    if p == ir.IntNE {
                        return r;
                    }
                    return negate_bool(B, r);
                }
            }
        }
    }
    // Overflow checks: (x + c) <u x and (x + c) <=u x are x >u MAX - c (for
    // c != 0); (x + c) >=u x and (x + c) >u x are x <=u MAX - c.
    if at.kind == ir.T_INT {
        let mut sum = vnil();
        let mut q = p;
        if is_op(a, ir.OP_ADD) and (a.a == b) and is_k(a.b) {
            sum = a;
        } else if is_op(b, ir.OP_ADD) and (b.a == a) and is_k(b.b) {
            sum = b;
            q = swap_pred(p);
        }
        if u.notnil(sum) and ((q == ir.IntULT) or (q == ir.IntUGE) or (q == ir.IntUGT) or (q == ir.IntULE)) {
            // (x + c) wraps exactly when x >u MAX - c
            let c = kval(sum.b);
            if c == 0 {
                return kbool((q == ir.IntUGE) or (q == ir.IntULE));
            }
            let lim = kt(at, ir.mask_bits(bits) -% c);
            if (q == ir.IntULT) or (q == ir.IntULE) {
                return mk_icmp(B, ir.IntUGT, sum.a, lim);
            }
            return mk_icmp(B, ir.IntULE, sum.a, lim);
        }
        // (x + c) <u c: the addition wrapped, x >u MAX - c; (x + c) >=u c: it did not
        if is_op(a, ir.OP_ADD) and is_k(a.b) and is_k(b) and (kval(a.b) == kval(b)) and (kval(b) != 0) {
            let lim = kt(at, ir.mask_bits(bits) -% kval(b));
            if p == ir.IntULT {
                return mk_icmp(B, ir.IntUGT, a.a, lim);
            }
            if p == ir.IntUGE {
                return mk_icmp(B, ir.IntULE, a.a, lim);
            }
        }
        // (x - y) >u x  ->  y >u x  (x - y wraps below 0 exactly when y > x)
        if is_op(a, ir.OP_SUB) and (a.a == b) and (p == ir.IntUGT) {
            return mk_icmp(B, ir.IntUGT, a.b, b);
        }
        if is_op(a, ir.OP_SUB) and (a.a == b) and (p == ir.IntULE) {
            return mk_icmp(B, ir.IntULE, a.b, b);
        }
    }
    return vnil();
}

// The unsigned values of x where the comparison c (x p k, k a constant) is
// true, when they are one interval [lo, hi]; nil x if not.
fn unsigned_range(c: *mut ir.Value, lo: *mut u64, hi: *mut u64) *mut ir.Value {
    let x = c.a;
    if (x.ty.kind != ir.T_INT) or (x.ty.bits > 64) or not is_k(c.b) or is_k(x) {
        return vnil();
    }
    let k = kval(c.b);
    let max = ir.mask_bits(x.ty.bits);
    let p = pred_of(c);
    lo.* = 0;
    hi.* = max;
    if p == ir.IntEQ {
        lo.* = k;
        hi.* = k;
    } else if (p == ir.IntNE) and (k == 0) {
        lo.* = 1;
    } else if (p == ir.IntNE) and (k == max) {
        hi.* = max - 1;
    } else if (p == ir.IntULT) and (k > 0) {
        hi.* = k - 1;
    } else if p == ir.IntULE {
        hi.* = k;
    } else if (p == ir.IntUGT) and (k < max) {
        lo.* = k + 1;
    } else if p == ir.IntUGE {
        lo.* = k;
    } else {
        return vnil();
    }
    return x;
}

// (x in [a, b]) and (x in [c, d]): one comparison, of x - lo against the
// length of the intersection (or nil).
fn and_ranges(B: *mut ir.Builder, c1: *mut ir.Value, c2: *mut ir.Value) *mut ir.Value {
    let mut lo1: u64 = 0;
    let mut hi1: u64 = 0;
    let mut lo2: u64 = 0;
    let mut hi2: u64 = 0;
    let x = unsigned_range(c1, &mut lo1, &mut hi1);
    if u.isnil(x) or (unsigned_range(c2, &mut lo2, &mut hi2) != x) {
        return vnil();
    }
    let t = x.ty;
    let lo = @max(lo1, lo2);
    let hi = @min(hi1, hi2);
    if lo > hi {
        return kfalse();
    }
    if lo == hi {
        return mk_icmp(B, ir.IntEQ, x, kt(t, lo));
    }
    if lo == 0 {
        return mk_icmp(B, ir.IntULE, x, kt(t, hi));
    }
    if hi == ir.mask_bits(t.bits) {
        return mk_icmp(B, ir.IntUGE, x, kt(t, lo));
    }
    return mk_icmp(B, ir.IntULT, ir.sub(B, x, kt(t, lo)), kt(t, (hi - lo) + 1));
}

// a | b as rotl(x, c) when one is x << c and the other x >> (bits - c)
// (logical; 32 or 64 bits), else nil.
fn rotation(B: *mut ir.Builder, a: *mut ir.Value, b: *mut ir.Value, t: *mut ir.Ty) *mut ir.Value {
    if (t.kind != ir.T_INT) or ((t.bits != 32) and (t.bits != 64)) {
        return vnil();
    }
    let mut l = a;
    let mut r = b;
    if is_op(b, ir.OP_SHL) {
        l = b;
        r = a;
    }
    if not is_op(l, ir.OP_SHL) or not is_op(r, ir.OP_LSHR) or (l.a != r.a) or not is_k(l.b) or not is_k(r.b) {
        return vnil();
    }
    let c = kval(l.b);
    let bits = @int_cast(u64, t.bits);
    if (c == 0) or (c >= bits) or ((c + kval(r.b)) != bits) {
        return vnil();
    }
    let mut args: [2]*mut ir.Value = [l.a, l.b];
    return ir.intr(B, ir.IN_ROTL, t, args[..]);
}

fn simplify_bin(B: *mut ir.Builder, i: *mut ir.Value) *mut ir.Value {
    let op = i.op;
    let t = i.ty;
    if is_k(i.a) and is_k(i.b) {
        return ir.fold_int_bin(op, t, i.a, i.b);
    }
    if commutative(op) and is_k(i.a) {
        let x = i.a;
        i.a = i.b;
        i.b = x;
    }
    let a = i.a;
    let b = i.b;
    let bits = t.bits;
    let all = ir.mask_bits(bits);
    let bk = is_k(b);
    let k = kval(b);
    if op == ir.OP_ADD {
        if bk and (k == 0) {
            return a;
        }
        // (x + c1) + c2
        if bk and is_op(a, ir.OP_ADD) and is_k(a.b) {
            i.a = a.a;
            i.b = kt(t, k +% kval(a.b));
            return simplify_bin(B, i);
        }
        // (c1 - x) + c2 = (c1 + c2) - x
        if bk and is_op(a, ir.OP_SUB) and is_k(a.a) {
            return ir.sub(B, kt(t, kval(a.a) +% k), a.b);
        }
        // p*c + q*c = (p + q)*c, and (x + p*c) + q*c = x + (p + q)*c: a
        // weighted sum's terms of one weight added first (one use each)
        if is_op(b, ir.OP_MUL) and is_k(b.b) and (uses_of(b) <= 1) {
            if is_op(a, ir.OP_MUL) and is_k(a.b) and (kval(a.b) == kval(b.b)) and (uses_of(a) <= 1) {
                return ir.mul(B, ir.add(B, a.a, b.a), b.b);
            }
            if is_op(a, ir.OP_ADD) and (uses_of(a) <= 1) and is_op(a.b, ir.OP_MUL) and is_k(a.b.b) and
               (kval(a.b.b) == kval(b.b)) and (uses_of(a.b) <= 1) {
                return ir.add(B, a.a, ir.mul(B, ir.add(B, a.b.a, b.a), b.b));
            }
        }
        // (x + c) + y = (x + y) + c: constants outermost (an address's
        // displacement)
        if is_op(a, ir.OP_ADD) and is_k(a.b) and not bk and (uses_of(a) <= 1) and (t.kind == ir.T_INT) {
            return ir.add(B, ir.add(B, a.a, b), a.b);
        }
        if is_op(b, ir.OP_ADD) and is_k(b.b) and not is_k(a) and (uses_of(b) <= 1) and (t.kind == ir.T_INT) {
            return ir.add(B, ir.add(B, a, b.a), b.b);
        }
        // (x - y) + y
        if is_op(a, ir.OP_SUB) and (a.b == b) {
            return a.a;
        }
        if is_op(b, ir.OP_SUB) and (b.b == a) {
            return b.a;
        }
        return vnil();
    }
    if op == ir.OP_SUB {
        if a == b {
            return kt(t, 0);
        }
        if is_k(a) {
            // c1 - (x + c2) = (c1 - c2) - x; c1 - (c2 - x) = x + (c1 - c2)
            if is_op(b, ir.OP_ADD) and is_k(b.b) {
                return ir.sub(B, kt(t, kval(a) -% kval(b.b)), b.a);
            }
            if is_op(b, ir.OP_SUB) and is_k(b.a) {
                return ir.add(B, b.b, kt(t, kval(a) -% kval(b.a)));
            }
        }
        if bk {
            // canonical: x + (-c)
            if k == 0 {
                return a;
            }
            return ir.add(B, a, kt(t, 0 -% k));
        }
        // (x + y) - y ; (x + y) - x
        if is_op(a, ir.OP_ADD) and (a.b == b) {
            return a.a;
        }
        if is_op(a, ir.OP_ADD) and (a.a == b) {
            return a.b;
        }
        // (x + c) - x  = c ; x - (x - y) = y
        if is_op(b, ir.OP_SUB) and (b.a == a) {
            return b.b;
        }
        // x*c1 - x*c2 = x*(c1 - c2), and with x for x*1: the length of
        // s[k*n..(k + 1)*n] is n
        let am = is_op(a, ir.OP_MUL) and is_k(a.b);
        let bm = is_op(b, ir.OP_MUL) and is_k(b.b);
        if am or bm {
            let mut xa = a;
            let mut ca: u64 = 1;
            if am {
                xa = a.a;
                ca = kval(a.b);
            }
            let mut xb = b;
            let mut cb: u64 = 1;
            if bm {
                xb = b.a;
                cb = kval(b.b);
            }
            if xa == xb {
                let c = (ca -% cb) & all;
                if c == 1 {
                    return xa;
                }
                return ir.mul(B, xa, kt(t, c));
            }
        }
        return vnil();
    }
    if op == ir.OP_MUL {
        if bk {
            if k == 0 {
                return b;
            }
            if k == 1 {
                return a;
            }
            // (x * c1) * c2
            if is_op(a, ir.OP_MUL) and is_k(a.b) {
                i.a = a.a;
                i.b = kt(t, k *% kval(a.b));
                return simplify_bin(B, i);
            }
            // (x + c1) * c2 = x * c2 + c1 * c2: the constant outermost, where
            // an address takes it as its displacement ((row + 3) * 64)
            if is_op(a, ir.OP_ADD) and is_k(a.b) and (t.kind == ir.T_INT) and
               ((uses_of(a) <= 1) or ((k & (k -% 1)) == 0)) {
                return ir.add(B, ir.mul(B, a.a, b), kt(t, kval(a.b) *% k));
            }
            // (multiplication by a power of two stays: the backends fold it
            // into scaled addressing and select shifts themselves)
        }
        return vnil();
    }
    if op == ir.OP_UDIV {
        if bk {
            if k == 1 {
                return a;
            }
            let l = log2(k);
            if l > 0 {
                return ir.binop(B, ir.OP_LSHR, a, kt(t, @as(u64, @bit_cast(u32, l))));
            }
        }
        return vnil();
    }
    if op == ir.OP_UREM {
        if bk {
            if k == 1 {
                return kt(t, 0);
            }
            if log2(k) > 0 {
                return ir.and_(B, a, kt(t, k - 1));
            }
        }
        return vnil();
    }
    if op == ir.OP_SDIV {
        if bk and (k == 1) {
            return a;
        }
        return vnil();
    }
    if op == ir.OP_SREM {
        if bk and ((k == 1) or (k == all)) {
            return kt(t, 0);
        }
        return vnil();
    }
    if op == ir.OP_AND {
        if (t.bits == 1) and is_op(a, ir.OP_ICMP) and is_op(b, ir.OP_ICMP) {
            let r = and_ranges(B, a, b);
            if u.notnil(r) {
                return r;
            }
        }
        if bk {
            if k == 0 {
                return b;
            }
            if k == all {
                return a;
            }
            if is_op(a, ir.OP_AND) and is_k(a.b) {
                i.a = a.a;
                i.b = kt(t, k & kval(a.b));
                return simplify_bin(B, i);
            }
            // (zext x) & mask covering x's bits
            if is_op(a, ir.OP_ZEXT) and (a.a.ty.kind == ir.T_INT) and ((ir.mask_bits(a.a.ty.bits) & ~k) == 0) {
                return a;
            }
        }
        if a == b {
            return a;
        }
        return vnil();
    }
    if op == ir.OP_OR {
        if bk {
            if k == 0 {
                return a;
            }
            if k == all {
                return b;
            }
            if is_op(a, ir.OP_OR) and is_k(a.b) {
                i.a = a.a;
                i.b = kt(t, k | kval(a.b));
                return simplify_bin(B, i);
            }
        }
        if a == b {
            return a;
        }
        // (x << c) | (x >> (bits - c)): a rotation
        let r = rotation(B, a, b, t);
        if u.notnil(r) {
            return r;
        }
        return vnil();
    }
    if op == ir.OP_XOR {
        if a == b {
            return kt(t, 0);
        }
        if bk {
            if k == 0 {
                return a;
            }
            if is_op(a, ir.OP_XOR) and is_k(a.b) {
                i.a = a.a;
                i.b = kt(t, k ^ kval(a.b));
                return simplify_bin(B, i);
            }
            // not of a comparison: the inverted comparison
            if (bits == 1) and is_op(a, ir.OP_ICMP) and (uses_of(a) <= 1) {
                return negate_bool(B, a);
            }
        }
        return vnil();
    }
    if (op == ir.OP_SHL) or (op == ir.OP_LSHR) or (op == ir.OP_ASHR) {
        if bk and (k == 0) {
            return a;
        }
        if is_kv(a, 0) {
            return a;
        }
        // (x << c1) << c2 while the total stays below the width
        if bk and is_op(a, op) and is_k(a.b) and (k < @as(u64, @bit_cast(u32, bits))) {
            let tot = k + kval(a.b);
            if tot < @as(u64, @bit_cast(u32, bits)) {
                i.a = a.a;
                i.b = kt(i.b.ty, tot);
                return vnil();
            }
        }
        return vnil();
    }
    return vnil();
}

fn simplify_select(B: *mut ir.Builder, i: *mut ir.Value) *mut ir.Value {
    let c = i.a;
    if c.kind == ir.V_CINT {
        if c.cv != 0 {
            return i.b;
        }
        return i.c;
    }
    if i.b == i.c {
        return i.b;
    }
    if c.ty.kind != ir.T_INT {
        return vnil();  // vector masks
    }
    // select (not c), x, y  ->  select c, y, x
    if is_op(c, ir.OP_XOR) and is_kv(c.b, 1) {
        i.a = c.a;
        let x = i.b;
        i.b = i.c;
        i.c = x;
        return simplify_select(B, i);
    }
    let t = i.ty;
    if (t.kind == ir.T_INT) and (t.bits == 1) {
        if is_kv(i.b, 1) and is_kv(i.c, 0) {
            return c;
        }
        if is_kv(i.b, 0) and is_kv(i.c, 1) {
            return ir.xor(B, c, ktrue());
        }
        // c ? true : y  ->  c | y ; c ? x : false  ->  c & x
        if is_kv(i.b, 1) {
            return ir.or_(B, c, i.c);
        }
        if is_kv(i.c, 0) {
            return ir.and_(B, c, i.b);
        }
    } else if small_int(t) {
        if is_kv(i.b, 1) and is_kv(i.c, 0) {
            return ir.zext(B, c, t);
        }
    }
    return vnil();
}

// v as a value of the narrower type t, when that is free: an extension from
// t, or a constant.
fn narrowed(v: *mut ir.Value, t: *mut ir.Ty) *mut ir.Value {
    if (is_op(v, ir.OP_ZEXT) or is_op(v, ir.OP_SEXT)) and (v.a.ty == t) {
        return v.a;
    }
    if (v.kind == ir.V_CINT) and (v.ty.bits <= 64) {
        return kt(t, kval(v));
    }
    return vnil();
}

fn simplify_cast(B: *mut ir.Builder, i: *mut ir.Value) *mut ir.Value {
    let op = i.op;
    let a = i.a;
    let t = i.ty;
    if (op == ir.OP_ZEXT) or (op == ir.OP_SEXT) or (op == ir.OP_TRUNC) {
        if (t.kind != ir.T_INT) or (a.ty.kind != ir.T_INT) or (t.bits > 64) or (a.ty.bits > 64) {
            return vnil();
        }
        if a.ty == t {
            return a;
        }
        if is_k(a) {
            return ir.cast(B, op, a, t);
        }
        if (op == ir.OP_ZEXT) and is_op(a, ir.OP_ZEXT) {
            i.a = a.a;
            return vnil();
        }
        if (op == ir.OP_SEXT) and (is_op(a, ir.OP_SEXT) or is_op(a, ir.OP_ZEXT)) {
            // sext (zext x) = zext x: the top bit is 0
            if a.op == ir.OP_ZEXT {
                return ir.zext(B, a.a, t);
            }
            i.a = a.a;
            return vnil();
        }
        if op == ir.OP_TRUNC {
            if is_op(a, ir.OP_TRUNC) {
                i.a = a.a;
                return vnil();
            }
            // the low bits of +, -, *, &, |, ^ depend only on the operands' low
            // bits: compute in the narrow type
            let ao = a.op;
            if (a.kind == ir.V_INST) and
               ((ao == ir.OP_ADD) or (ao == ir.OP_SUB) or (ao == ir.OP_MUL) or (ao == ir.OP_AND) or (ao == ir.OP_OR) or
                (ao == ir.OP_XOR)) {
                let x = narrowed(a.a, t);
                let y = narrowed(a.b, t);
                if u.notnil(x) and u.notnil(y) {
                    return ir.binop(B, ao, x, y);
                }
            }
            if is_op(a, ir.OP_ZEXT) or is_op(a, ir.OP_SEXT) {
                let x = a.a;
                if x.ty == t {
                    return x;
                }
                if x.ty.bits < t.bits {
                    return ir.cast(B, a.op, x, t);
                }
                return ir.trunc(B, x, t);
            }
        }
        return vnil();
    }
    if op == ir.OP_PTRTOINT {
        if is_op(a, ir.OP_INTTOPTR) and (a.a.ty == t) {
            return a.a;
        }
        return vnil();
    }
    if op == ir.OP_INTTOPTR {
        if is_op(a, ir.OP_PTRTOINT) and (a.ty.bits == @int_cast(i32, ir.ptr_bytes * 8)) {
            return a.a;
        }
        // an address computed in integers: as pointer arithmetic, which
        // the backends fold into addressing modes
        if is_op(a, ir.OP_ADD) and (a.ty.bits == @int_cast(i32, ir.ptr_bytes * 8)) {
            return ir.ptradd(B, ir.inttoptr(B, a.a), a.b);
        }
        return vnil();
    }
    if op == ir.OP_BITCAST {
        if a.ty == t {
            return a;
        }
        if is_op(a, ir.OP_BITCAST) {
            if a.a.ty == t {
                return a.a;
            }
            i.a = a.a;
        }
        return vnil();
    }
    return vnil();
}

fn simplify_ptradd(B: *mut ir.Builder, i: *mut ir.Value) *mut ir.Value {
    let off = i.b;
    if is_kv(off, 0) {
        return i.a;
    }
    let a = i.a;
    if is_k(off) and is_op(a, ir.OP_PTRADD) and is_k(a.b) {
        i.a = a.a;
        i.b = ir.cint(off.ty, kval(off) +% kval(a.b));
        return simplify_ptradd(B, i);
    }
    return vnil();
}

// Does x * c overflow x's (narrow, w <= 32 bits) type? A comparison, or nil.
fn narrow_mul_overflow(B: *mut ir.Builder, x: *mut ir.Value, signed: bool, sc: i64, uc: u64) *mut ir.Value {
    let w = x.ty.bits;
    let t = x.ty;
    if not signed {
        if uc <= 1 {
            return kfalse();
        }
        let max = ir.mask_bits(w);
        return mk_icmp(B, ir.IntUGT, x, kt(t, max / uc));
    }
    let max: i64 = @bit_cast(i64, ir.mask_bits(w) >> 1);
    let min: i64 = -max - 1;
    if (sc == 0) or (sc == 1) {
        return kfalse();
    }
    if sc == -1 {
        return mk_icmp(B, ir.IntEQ, x, kt(t, @bit_cast(u64, min)));
    }
    if (sc > 0x7fff_ffff) or (sc < -0x7fff_ffff) {
        return vnil();
    }
    let hi = max / sc;
    let lo = min / sc;
    if sc > 1 {
        return ir.or_(B, mk_icmp(B, ir.IntSGT, x, kt(t, @bit_cast(u64, hi))),
                      mk_icmp(B, ir.IntSLT, x, kt(t, @bit_cast(u64, lo))));
    }
    return ir.or_(
        B, mk_icmp(B, ir.IntSLT, x, kt(t, @bit_cast(u64, hi))), mk_icmp(B, ir.IntSGT, x, kt(t, @bit_cast(u64, lo))));
}

// Multiplication overflow with a constant factor is a range check.
fn simplify_mul_ov(B: *mut ir.Builder, i: *mut ir.Value, signed: bool) *mut ir.Value {
    if is_k(i.xs.get(0)) and not is_k(i.xs.get(1)) {
        let x = i.xs.get(0);
        i.xs.set(0, i.xs.get(1));
        i.xs.set(1, x);
    }
    let x = i.xs.get(0);
    let kc = i.xs.get(1);
    let t = x.ty;
    if not is_k(kc) or (t.kind != ir.T_INT) or (t.bits != 64) {
        return vnil();
    }
    if not signed {
        let c = kval(kc);
        if c <= 1 {
            return kfalse();
        }
        let lim = kt(t, 0xFFFF_FFFF_FFFF_FFFF / c);
        if is_k(x) {
            return kbool(kval(x) > kval(lim));
        }
        return mk_icmp(B, ir.IntUGT, x, lim);
    }
    let c = ir.sval(kc);
    let max: i64 = 0x7FFF_FFFF_FFFF_FFFF;
    let min: i64 = -max - 1;
    if (c == 0) or (c == 1) {
        return kfalse();
    }
    if c == -1 {
        return mk_icmp(B, ir.IntEQ, x, kt(t, @bit_cast(u64, min)));
    }
    let hi = max / c;  // truncating
    let lo = min / c;
    if c > 1 {
        return ir.or_(B, mk_icmp(B, ir.IntSGT, x, kt(t, @bit_cast(u64, hi))),
                      mk_icmp(B, ir.IntSLT, x, kt(t, @bit_cast(u64, lo))));
    }
    return ir.or_(
        B, mk_icmp(B, ir.IntSLT, x, kt(t, @bit_cast(u64, hi))), mk_icmp(B, ir.IntSGT, x, kt(t, @bit_cast(u64, lo))));
}

// The scalar of type t at byte offset off in constant c, or nil.
fn const_at(c: *mut ir.Value, off: u64, t: *mut ir.Ty) *mut ir.Value {
    let ct = c.ty;
    if (c.kind == ir.V_CAGG) and ir.is_agg(ct) {
        for k in 0..c.xs.len {
            let fo = ir.field_off(ct, k);
            let ft = ir.field_ty(ct, k);
            if (off >= fo) and (off < (fo + ft.size)) {
                return const_at(c.xs.get(k), off - fo, t);
            }
        }
        return vnil();
    }
    if (c.kind == ir.V_ZERO) or (c.kind == ir.V_UNDEF) {
        if (off + t.size) > ct.size {
            return vnil();
        }
        if (t.kind == ir.T_INT) or (t.kind == ir.T_FLOAT) or (t.kind == ir.T_PTR) {
            if c.kind == ir.V_ZERO {
                return ir.czero(t);
            }
            return ir.undef(t);
        }
        return vnil();
    }
    if off != 0 {
        return vnil();
    }
    if ct == t {
        if (c.kind == ir.V_CINT) or (c.kind == ir.V_CFP) or (c.kind == ir.V_GLOBAL) or (c.kind == ir.V_FUNC) {
            return c;
        }
    }
    return vnil();
}

// A load from read-only data at a constant offset: the constant.
fn simplify_load(i: *mut ir.Value) *mut ir.Value {
    if i.flags != 0 {
        return vnil();
    }
    let mut p = i.a;
    let mut off: u64 = 0;
    while is_op(p, ir.OP_PTRADD) and is_k(p.b) {
        off = off +% kval(p.b);
        p = p.a;
    }
    if (p.kind != ir.V_GLOBAL) or not p.gv.is_const or u.isnil(p.gv.init) or p.gv.tls or
       (p.gv.linkage == ir.LINK_WEAK) or (p.gv.linkage == ir.LINK_EXTWEAK) {
        return vnil();
    }
    if (off >= p.gv.ty.size) or (i.ty.kind == ir.T_VEC) {
        return vnil();
    }
    return const_at(p.gv.init, off, i.ty);
}

// The value i can be replaced by, or nil (i may have been rewritten in place).
pub fn simplify(B: *mut ir.Builder, i: *mut ir.Value) *mut ir.Value {
    let op = i.op;
    ir.at_before(B, i);
    if (op >= ir.OP_ADD) and (op <= ir.OP_ASHR) {
        if small_int(i.ty) {
            return simplify_bin(B, i);
        }
        if (i.ty.kind == ir.T_VEC) and (i.ty.elem.kind == ir.T_INT) {
            // lanes plus, minus, or, xor zero; and zero
            if ((op == ir.OP_ADD) or (op == ir.OP_OR) or (op == ir.OP_XOR)) and vzero(i.a) {
                return i.b;
            }
            if ((((op == ir.OP_ADD) or (op == ir.OP_SUB)) or (op == ir.OP_OR)) or (op == ir.OP_XOR)) and vzero(i.b) {
                return i.a;
            }
            if (op == ir.OP_AND) and (vzero(i.a) or vzero(i.b)) {
                return ir.czero(i.ty);
            }
        }
        return vnil();
    }
    if (op == ir.OP_SHUFFLE) and (i.ty.kind == ir.T_VEC) {
        // every lane from a vector of zeros
        let n = @as(i32, @bit_cast(i32, i.a.ty.lanes));
        let mut z = true;
        for k in 0..i.mask.len {
            let x = i.mask[k];
            if ((x >= 0) and (x < n) and not vzero(i.a)) or ((x >= n) and not vzero(i.b)) {
                z = false;
            }
        }
        if z and (vzero(i.a) or vzero(i.b)) {
            return ir.czero(i.ty);
        }
        return vnil();
    }
    if op == ir.OP_ICMP {
        if (i.ty.kind == ir.T_INT) or (i.ty.kind == ir.T_VEC) {
            return simplify_icmp(B, i);
        }
        return vnil();
    }
    if op == ir.OP_SELECT {
        return simplify_select(B, i);
    }
    if (op >= ir.OP_ZEXT) and (op <= ir.OP_INTTOPTR) {
        return simplify_cast(B, i);
    }
    if op == ir.OP_PTRADD {
        return simplify_ptradd(B, i);
    }
    if op == ir.OP_LOAD {
        return simplify_load(i);
    }
    if op == ir.OP_INTR {
        let id = pred_of(i);
        if (id == ir.IN_UMUL_OV) or (id == ir.IN_SMUL_OV) {
            return simplify_mul_ov(B, i, id == ir.IN_SMUL_OV);
        }
        if (id == ir.IN_FMA) and (i.xs.len == 3) {
            // fma(1, x, y) = x + y exactly (1 * x is x, then one rounding)
            if fone(i.xs.get(0)) {
                return ir.binop(B, ir.OP_FADD, i.xs.get(1), i.xs.get(2));
            }
            if fone(i.xs.get(1)) {
                return ir.binop(B, ir.OP_FADD, i.xs.get(0), i.xs.get(2));
            }
        }
        return vnil();
    }
    if op == ir.OP_FDIV {
        let r = exact_recip(i.b);
        if u.notnil(r) {
            return ir.binop(B, ir.OP_FMUL, i.a, r);
        }
        return vnil();
    }
    if op == ir.OP_FNEG {
        if is_op(i.a, ir.OP_FNEG) {
            return i.a.a;
        }
        return vnil();
    }
    return vnil();
}

// 1 / c when c is a floating point constant (or a vector of them) whose
// reciprocal is exact: a power of two, positive or negative, with both it
// and its reciprocal normal numbers of its type. Then x / c and x * (1 / c)
// are the same real number, rounded the same way, for every x (NaNs and
// infinities included). Else nil.
fn exact_recip(c: *mut ir.Value) *mut ir.Value {
    if c.kind == ir.V_CFP {
        let bits = @bit_cast(u64, c.fv);
        if (bits & 0xfffffffffffff) != 0 {
            return vnil();
        }
        let e = @as(i64, @bit_cast(i64, (bits >> 52) & 0x7ff)) - 1023;  // c = ±2^e
        let mut lim: i64 = 1022;  // f64: normal exponents -1022..1023
        if c.ty.bits == 32 {
            lim = 126;  // f32: -126..127
        }
        if (e < -lim) or (e > lim) {
            return vnil();
        }
        return ir.cfp(c.ty, 1.0 / c.fv);
    }
    if (c.kind == ir.V_CAGG) and (c.ty.kind == ir.T_VEC) {
        let xs = u.newn.[*mut ir.Value](c.xs.len + 1);
        for k in 0..c.xs.len {
            let r = exact_recip(c.xs.get(k));
            if u.isnil(r) {
                return vnil();
            }
            xs[k] = r;
        }
        return ir.cagg(c.ty, xs[0..c.xs.len]);
    }
    return vnil();
}

// condbr (not c), x, y  ->  condbr c, y, x. True if changed.
pub fn simplify_branch(t: *mut ir.Value) bool {
    if t.op != ir.OP_CONDBR {
        return false;
    }
    let c = t.a;
    if is_op(c, ir.OP_XOR) and is_kv(c.b, 1) {
        t.a = c.a;
        let x = t.t1;
        t.t1 = t.t2;
        t.t2 = x;
        return true;
    }
    return false;
}

// Use counts, for the one rewrite that asks for them: counted over the
// function when first asked for after fold_combine marks them stale (at
// the start of each of its rounds).
pub let mut uses_stale: bool = true;

fn uses_of(v: *mut ir.Value) i32 {
    if uses_stale {
        count_uses(v.blk.fnp);
        uses_stale = false;
    }
    return v.uses;
}

// Number of uses of each instruction (uses; user: the last user).
fn count_uses(f: *mut ir.Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.uses = 0;
            i = i.next;
        }
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            use1(i.a, i);
            use1(i.b, i);
            use1(i.c, i);
            for k in 0..i.xs.len {
                use1(i.xs.get(k), i);
            }
            i = i.next;
        }
        b = b.next;
    }
}

fn use1(o: *mut ir.Value, i: *mut ir.Value) void {
    if u.notnil(o) and (o.kind == ir.V_INST) {
        o.uses += 1;
        o.user = i;
    }
}

// -----------------------------------------------------------------------------
// Boolean phis: a `bool` local lives in a byte, so after mem2reg it is a phi
// of i8 whose inputs are `zext` of comparisons and the constants 0 and 1,
// tested with `!= 0`. Such phis (and the phis of them, around loops) become
// phis of i1; their other uses read a `zext` of the new phi. Then a branch
// on the phi branches on the i1 itself, which jump threading can follow
// into the predecessors.
// -----------------------------------------------------------------------------

// v as an i1 when it is 0/1-valued (a constant, undef, or a zext of an i1),
// else nil; phis are handled by the caller.
fn bool_input(v: *mut ir.Value) *mut ir.Value {
    if is_k(v) {
        let k = kval(v);
        if k <= 1 {
            return kt(ir.t_int(1), k);
        }
        return vnil();
    }
    if v.kind == ir.V_UNDEF {
        return kfalse();
    }
    if is_op(v, ir.OP_ZEXT) and (v.a.ty.kind == ir.T_INT) and (v.a.ty.bits == 1) {
        return v.a;
    }
    return vnil();
}

fn bool_phi_candidate(v: *ir.Value) bool {
    return (v.kind == ir.V_INST) and (v.op == ir.OP_PHI) and (v.ty.kind == ir.T_INT) and (v.ty.bits > 1) and
           (v.ty.bits <= 64);
}

// True if f changed. (Uses the phis' aux2 and auxp as scratch.)
pub fn narrow_bool_phis(f: *mut ir.Func) bool {
    let mut any = false;
    let mut web = u.List.[*mut ir.Value].{ data: u.nil.[*mut ir.Value](), len: 0, cap: 0 };
    // aux2: 0 not seen, 1 in the web being built, 2 done (not convertible or converted)
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) and (i.op == ir.OP_PHI) {
            i.aux2 = 0;
            i = i.next;
        }
        b = b.next;
    }
    let B = ir.new_builder();
    b = f.first;
    while u.notnil(b) {
        let mut p0 = b.first;
        while u.notnil(p0) and (p0.op == ir.OP_PHI) {
            let next0 = p0.next;
            if not bool_phi_candidate(p0) or (p0.aux2 != 0) {
                p0 = next0;
                continue;
            }
            // the web of phis of the same type that feed each other
            web.clear();
            web.push(p0);
            p0.aux2 = 1;
            let mut ok = true;
            let mut k: usize = 0;
            while ok and (k < web.len) {
                let p = web.get(k);
                k += 1;
                for j in 0..p.xs.len {
                    let x = ir.resolve(p.xs.get(j));
                    if (x.kind == ir.V_INST) and (x.op == ir.OP_PHI) {
                        if x.ty != p0.ty {
                            ok = false;
                        } else if x.aux2 == 0 {
                            x.aux2 = 1;
                            web.push(x);
                        } else if x.aux2 == 2 {
                            ok = false;
                        }
                    } else if u.isnil(bool_input(x)) {
                        ok = false;
                    }
                }
            }
            if ok {
                // the i1 phis first (they may refer to each other)
                for w in 0..web.len {
                    let p = web.get(w);
                    ir.at_before(B, p);
                    let q = ir.phi(B, ir.t_int(1));
                    p.auxp = @ptr_cast(*mut void, q);
                }
                for w in 0..web.len {
                    let p = web.get(w);
                    let q = @ptr_cast(*mut ir.Value, p.auxp);
                    for j in 0..p.xs.len {
                        let x = ir.resolve(p.xs.get(j));
                        let mut y = vnil();
                        if (x.kind == ir.V_INST) and (x.op == ir.OP_PHI) {
                            y = @ptr_cast(*mut ir.Value, x.auxp);
                        } else {
                            y = bool_input(x);
                        }
                        ir.add_incoming(q, y, p.bs.get(j));
                    }
                }
                for w in 0..web.len {
                    let p = web.get(w);
                    let q = @ptr_cast(*mut ir.Value, p.auxp);
                    let mut at = p.blk.first;
                    while u.notnil(at) and (at.op == ir.OP_PHI) {
                        at = at.next;
                    }
                    if u.notnil(at) {
                        ir.at_before(B, at);
                    } else {
                        ir.at_end(B, p.blk);
                    }
                    let z = ir.zext(B, q, p.ty);
                    p.aux2 = 2;
                    ir.forward(p, z);
                }
                for w in 0..web.len {
                    ir.remove_inst(web.get(w));
                }
                any = true;
                p0 = b.first;  // (next0 may have gone with them)
            } else {
                for w in 0..web.len {
                    web.get(w).aux2 = 2;
                }
                p0 = next0;
            }
        }
        b = b.next;
    }
    u.free(@ptr_cast(*mut void, web.data));
    return any;
}
