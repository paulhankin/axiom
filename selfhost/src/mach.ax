// =============================================================================
// mach.ax - machine IR shared by the native backends (x64.ax, a64.ax), and
// register allocation.
//
// A machine instruction has target-defined opcode and operands; each
// register operand says whether it is read, written or both. Registers
// below VREG0 are physical (target numbering), the rest virtual.
//
// Register allocation works on live intervals (one interval per virtual
// register: the positions where it is live, with holes; positions are 2i for
// instruction i's reads and 2i+1 for its writes), after copies between them
// are coalesced. Physical registers used explicitly (argument and result
// registers, division, shifts) and registers clobbered by calls are fixed
// ranges an interval must avoid. Intervals are assigned greedily, largest
// first; one that finds no free register takes one from intervals of lower
// spill weight (uses, weighted by the estimated frequency of their blocks,
// per position covered), which are queued again, or else it is spilled: it
// is split (see split): it goes to a stack slot across
// the calls it is live over and along loop boundaries, and each stretch in
// between becomes a new vreg; pieces that lose again are split at every block
// boundary, and those are finally spilled everywhere, their uses and
// definitions rewritten through short-lived registers (which never spill).
// Allocation runs again after each rewrite.
// =============================================================================
import "util.ax" as u;

pub const VREG0: i32 = 64;

// operand kinds
pub const K_NONE: u8 = 0;
pub const K_REG: u8 = 1;
pub const K_IMM: u8 = 2;
pub const K_MEM: u8 = 3;    // [base + index*scale + disp], or [slot + disp], or [sym + disp] (pc-relative)
pub const K_SYM: u8 = 4;    // a symbol (call target, address)
pub const K_LABEL: u8 = 5;  // block / local label

// roles of register operands
pub const RU: u8 = 1;  // read
pub const RD: u8 = 2;  // written
pub const RUD: u8 = 3;
pub const RE: u8 = 4;  // written before all reads are done (early clobber)

pub struct MOp {
    kind: u8,
    role: u8,
    reg: i32,
    base: i32,
    index: i32,
    scale: u8,
    disp: i64,
    sym: i32,
    slot: i32,
    label: i32,
}

pub struct MInst {
    op: i32,
    sz: u8,
    cc: i32,
    ops: []mut MOp,
    clobber: u64,   // physical registers clobbered (calls)
    is_move: bool,  // register copy (for coalescing hints)
    next: *mut MInst,
    prev: *mut MInst,
    pos: i32,
    aux: i64,
    spill: i32,  // 1: a reload, 2: a spill store (of `sreg`, slot `sslot`)
    sreg: i32,
    sslot: i32,
    src: u32,  // the source location of the IR it was made for (ir.src_loc), 0: not known
}

// The source location new instructions get: instruction selection sets it
// to each IR instruction's.
pub let mut cur_src: u32 = 0;

pub struct MBlock {
    id: i32,
    first: *mut MInst,
    last: *mut MInst,
    succs: u.List.[i32],
    preds: u.List.[i32],
    loop_depth: i32,
    cold: bool,  // ends in a trap (set by the target)
    freq: f64,   // estimated runs per call (block_freqs)
    live_in: []mut u64,
    live_out: []mut u64,
    start: i32,
    end: i32,
    offset: u64,  // encoder: code offset
}

pub struct Slot {
    size: u64,
    align: u64,
    offset: i64,  // assigned by the target's frame layout
}

pub struct Target {
    nclasses: i32,
    alloc_order: [4][]i32,  // allocatable registers per class, in preference order (classes that
                            // share registers, as x86-64's 128-, 256- and 512-bit vectors do, may
                            // list the same ones)
    caller_saved: u64,
    // spill code: load/store of register r (class c) from/to a slot
    spill_load: fn(*mut MFunc, i32, i32, i32) *mut MInst,
    spill_store: fn(*mut MFunc, i32, i32, i32) *mut MInst,
    // a copy of register s to d (class c), marked is_move
    spill_move: fn(*mut MFunc, i32, i32, i32) *mut MInst,
    // a label within a block (the target of jumps from within the block)
    is_label: fn(*MInst) bool,
    // a rematerialized value read from memory instead (see set_remat):
    // makes instruction i read vreg r's value straight from where its
    // definition `def` loads it, if it can
    fold_remat: fn(*mut MFunc, *mut MInst, i32, *MInst) bool,
}

pub struct MFunc {
    blocks: u.List.[*mut MBlock],
    vclass: u.List.[u8],  // class of each virtual register (index: vreg - VREG0)
    nospill: u.List.[bool],
    remat: u.List.[*mut MInst],  // the definition of a vreg rematerialized when spilled (nil: none)
    hint: u.List.[i32],
    slots: u.List.[Slot],
    assign: []mut i32,  // after allocation: vreg - VREG0 -> physical register
    used_regs: u64,     // physical registers used (for callee-saved saves)
    ninst: i32,
    has_calls: bool,
    level: u.List.[u8],   // how far each vreg has been split (see split)
    vslot: u.List.[i32],  // its spill slot, shared by the pieces of a split vreg (-1: none yet)
}

pub fn new_func() *mut MFunc {
    return u.new.[MFunc]();
}

pub fn new_vreg(f: *mut MFunc, class: u8) i32 {
    f.vclass.push(class);
    f.nospill.push(false);
    f.remat.push(u.nil.[MInst]());
    f.hint.push(-1);
    f.level.push(0);
    f.vslot.push(-1);
    return VREG0 + @int_cast(i32, f.vclass.len - 1);
}

// Vreg r is defined once, by instruction def, which reads no register
// (a constant from memory, or one computed from nothing). When r would be
// spilled, the definition is repeated (or folded) at each use instead:
// no stack slot, no stores.
pub fn set_remat(f: *mut MFunc, r: i32, def: *mut MInst) void {
    f.remat.set(@int_cast(usize, r - VREG0), def);
}

pub fn remat_def(f: *MFunc, r: i32) *mut MInst {
    if not is_vreg(r) {
        return u.nil.[MInst]();
    }
    return f.remat.get(@int_cast(usize, r - VREG0));
}

// A copy of definition `def` writing nr instead of r.
pub fn clone_def(def: *MInst, r: i32, nr: i32) *mut MInst {
    let c = new_inst(def.op, def.sz, def.ops);
    c.cc = def.cc;
    c.aux = def.aux;
    c.src = def.src;
    for k in 0..c.ops.len {
        if (c.ops[k].kind == K_REG) and (c.ops[k].reg == r) {
            c.ops[k].reg = nr;
        }
    }
    return c;
}

pub fn nvregs(f: *MFunc) usize {
    return f.vclass.len;
}

pub fn new_slot(f: *mut MFunc, size: u64, align: u64) i32 {
    f.slots.push(Slot.{ size: size, align: align, offset: 0 });
    return @int_cast(i32, f.slots.len - 1);
}

pub fn new_block(f: *mut MFunc) *mut MBlock {
    let b = u.new.[MBlock]();
    b.id = @int_cast(i32, f.blocks.len);
    f.blocks.push(b);
    return b;
}

pub fn is_vreg(r: i32) bool {
    return r >= VREG0;
}

// Operand constructors
pub fn reg(r: i32, role: u8) MOp {
    return MOp.{ kind: K_REG, role: role, reg: r, base: -1, index: -1, scale: 0, disp: 0, sym: -1, slot: -1,
                 label: -1 };
}

pub fn imm(x: i64) MOp {
    return MOp.{ kind: K_IMM, role: 0, reg: -1, base: -1, index: -1, scale: 0, disp: x, sym: -1, slot: -1, label: -1 };
}

pub fn mem(base: i32, index: i32, scale: u8, disp: i64) MOp {
    return MOp.{ kind: K_MEM, role: 0, reg: -1, base: base, index: index, scale: scale, disp: disp, sym: -1, slot: -1,
                 label: -1 };
}

pub fn mem_slot(slot: i32, disp: i64) MOp {
    return MOp.{ kind: K_MEM, role: 0, reg: -1, base: -1, index: -1, scale: 0, disp: disp, sym: -1, slot: slot,
                 label: -1 };
}

pub fn mem_sym(sym: i32, disp: i64) MOp {
    return MOp.{ kind: K_MEM, role: 0, reg: -1, base: -1, index: -1, scale: 0, disp: disp, sym: sym, slot: -1,
                 label: -1 };
}

pub fn symop(sym: i32, disp: i64) MOp {
    return MOp.{ kind: K_SYM, role: 0, reg: -1, base: -1, index: -1, scale: 0, disp: disp, sym: sym, slot: -1,
                 label: -1 };
}

pub fn label(l: i32) MOp {
    return MOp.{ kind: K_LABEL, role: 0, reg: -1, base: -1, index: -1, scale: 0, disp: 0, sym: -1, slot: -1, label: l };
}

pub fn none() MOp {
    return MOp.{ kind: K_NONE, role: 0, reg: -1, base: -1, index: -1, scale: 0, disp: 0, sym: -1, slot: -1, label: -1 };
}

pub fn new_inst(op: i32, sz: u8, ops: []MOp) *mut MInst {
    let i = u.new.[MInst]();
    i.op = op;
    i.sz = sz;
    i.src = cur_src;
    let o = u.newn.[MOp](ops.len + 1);
    for k in 0..ops.len {
        o[k] = ops[k];
    }
    i.ops = o[0..ops.len];
    return i;
}

pub fn append(b: *mut MBlock, i: *mut MInst) void {
    i.prev = b.last;
    i.next = u.nil.[MInst]();
    if u.notnil(b.last) {
        b.last.next = i;
    } else {
        b.first = i;
    }
    b.last = i;
}

pub fn insert_before(b: *mut MBlock, pos: *mut MInst, i: *mut MInst) void {
    i.next = pos;
    i.prev = pos.prev;
    if u.notnil(pos.prev) {
        pos.prev.next = i;
    } else {
        b.first = i;
    }
    pos.prev = i;
}

pub fn insert_after(b: *mut MBlock, pos: *mut MInst, i: *mut MInst) void {
    i.prev = pos;
    i.next = pos.next;
    if u.notnil(pos.next) {
        pos.next.prev = i;
    } else {
        b.last = i;
    }
    pos.next = i;
}

pub fn remove(b: *mut MBlock, i: *mut MInst) void {
    if u.notnil(i.prev) {
        i.prev.next = i.next;
    } else {
        b.first = i.next;
    }
    if u.notnil(i.next) {
        i.next.prev = i.prev;
    } else {
        b.last = i.prev;
    }
}

// -----------------------------------------------------------------------------
// Liveness
// -----------------------------------------------------------------------------
fn words(n: usize) usize {
    return (n + 63) / 64;
}

fn bset(s: []mut u64, i: usize) void {
    s[i / 64] = s[i / 64] | (@as(u64, 1) << @int_cast(u32, i % 64));
}

fn bclr(s: []mut u64, i: usize) void {
    s[i / 64] = s[i / 64] & ~(@as(u64, 1) << @int_cast(u32, i % 64));
}

fn bget(s: []u64, i: usize) bool {
    return (s[i / 64] & (@as(u64, 1) << @int_cast(u32, i % 64))) != 0;
}

// Calls fn(reg, role) for every register operand of i (memory bases and
// indexes are reads).
fn each_reg_use(i: *MInst, v: i32) bool {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and (o.reg == v) and ((o.role & RU) != 0) {
            return true;
        }
        if (o.kind == K_MEM) and ((o.base == v) or (o.index == v)) {
            return true;
        }
    }
    return false;
}

fn number(f: *mut MFunc) void {
    let mut n: i32 = 0;
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        b.start = 2 * n;
        let mut i = b.first;
        while u.notnil(i) {
            i.pos = n;
            n += 1;
            i = i.next;
        }
        b.end = (2 * n) - 1;
        if b.end < b.start {
            b.end = b.start;
        }
    }
    f.ninst = n;
}

fn liveness(f: *mut MFunc) void {
    let nv = nvregs(f);
    let w = words(nv);
    let nb = f.blocks.len;
    let use_s = u.newn.[[]mut u64](nb + 1);
    let def_s = u.newn.[[]mut u64](nb + 1);
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        use_s[bi] = u.newn.[u64](w + 1);
        def_s[bi] = u.newn.[u64](w + 1);
        b.live_in = u.newn.[u64](w + 1);
        b.live_out = u.newn.[u64](w + 1);
        let mut i = b.first;
        while u.notnil(i) {
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if o.kind == K_REG {
                    if is_vreg(o.reg) and ((o.role & RU) != 0) {
                        let x = @int_cast(usize, o.reg - VREG0);
                        if not bget(def_s[bi], x) {
                            bset(use_s[bi], x);
                        }
                    }
                } else if o.kind == K_MEM {
                    if is_vreg(o.base) {
                        let x = @int_cast(usize, o.base - VREG0);
                        if not bget(def_s[bi], x) {
                            bset(use_s[bi], x);
                        }
                    }
                    if is_vreg(o.index) {
                        let x = @int_cast(usize, o.index - VREG0);
                        if not bget(def_s[bi], x) {
                            bset(use_s[bi], x);
                        }
                    }
                }
            }
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RD) != 0) {
                    bset(def_s[bi], @int_cast(usize, o.reg - VREG0));
                }
            }
            i = i.next;
        }
    }
    let mut changed = true;
    while changed {
        changed = false;
        let mut bi = nb;
        while bi > 0 {
            bi -= 1;
            let b = f.blocks.get(bi);
            // out = union of successors' in
            for k in 0..b.succs.len {
                let s = f.blocks.get(@int_cast(usize, b.succs.get(k)));
                for j in 0..w {
                    b.live_out[j] = b.live_out[j] | s.live_in[j];
                }
            }
            for j in 0..w {
                let nin = use_s[bi][j] | (b.live_out[j] & ~def_s[bi][j]);
                if nin != b.live_in[j] {
                    b.live_in[j] = nin;
                    changed = true;
                }
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Block frequencies (estimated statically: how often each block runs per call
// of the function). Branches split evenly, except that blocks leading only to
// a trap (cold) are rarely taken and loops are rarely left; a loop runs its
// body LOOP_SCALE times per entry. Loops are found on the machine CFG (back
// edges of a depth-first search, natural loop bodies) and handled innermost
// first: each one's iteration (header 1) is computed with the loops inside it
// collapsed to their headers, whose exits it reaches in proportion.
// -----------------------------------------------------------------------------
const LOOP_SCALE: f64 = 10.0;
const COLD_WEIGHT: f64 = 0.001;
const EXIT_WEIGHT: f64 = 0.125;

struct Loop {
    head: i32,
    blocks: []mut u64,  // bitset
    size: i32,
    parent: i32,
    fin: f64,  // entries per call of the function
}

fn in_loop(l: *Loop, b: i32) bool {
    return bget(l.blocks, @int_cast(usize, b));
}

// The probability of each edge out of b (in b.succs order) into pr.
fn edge_probs(f: *MFunc, cold: []bool, inner: []i32, loops: *u.List.[Loop], b: usize, pr: *mut u.List.[f64]) void {
    pr.clear();
    let blk = f.blocks.get(b);
    let mut tot: f64 = 0.0;
    let li = inner[b];
    for k in 0..blk.succs.len {
        let s = @int_cast(usize, blk.succs.get(k));
        let mut w: f64 = 1.0;
        if cold[s] and not cold[b] {
            w = COLD_WEIGHT;
        } else if (li >= 0) and not in_loop(loops.at(@int_cast(usize, li)), @int_cast(i32, s)) {
            w = EXIT_WEIGHT;
        }
        pr.push(w);
        tot += w;
    }
    for k in 0..pr.len {
        pr.set(k, pr.get(k) / tot);
    }
}

fn block_freqs(f: *mut MFunc) void {
    let nb = f.blocks.len;
    if nb == 0 {
        return;
    }
    let w = words(nb);
    // depth-first search: reverse postorder, back edges
    let color = u.newn.[u8](nb + 1);
    let cold = u.newn.[bool](nb + 1);
    let inner = u.newn.[i32](nb + 1);
    let mass = u.newn.[f64](nb + 1);
    for bi in 0..nb {
        color[bi] = 0;
        cold[bi] = f.blocks.get(bi).cold;
        inner[bi] = -1;
        mass[bi] = 0.0;
        f.blocks.get(bi).freq = COLD_WEIGHT;  // (unreachable)
    }
    let mut post = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };
    let mut stk = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };
    let mut sidx = u.List.[usize].{ data: u.nil.[usize](), len: 0, cap: 0 };
    let mut heads = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };  // back edges: header, source
    let mut srcs = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };
    stk.push(0);
    sidx.push(0);
    color[0] = 1;
    while stk.len > 0 {
        let b = @int_cast(usize, stk.get(stk.len - 1));
        let k = sidx.get(sidx.len - 1);
        let blk = f.blocks.get(b);
        if k < blk.succs.len {
            sidx.set(sidx.len - 1, k + 1);
            let s = @int_cast(usize, blk.succs.get(k));
            if color[s] == 0 {
                color[s] = 1;
                stk.push(@int_cast(i32, s));
                sidx.push(0);
            } else if color[s] == 1 {
                heads.push(@int_cast(i32, s));
                srcs.push(@int_cast(i32, b));
            }
        } else {
            color[b] = 2;
            post.push(@int_cast(i32, b));
            stk.len -= 1;
            sidx.len -= 1;
        }
    }
    // cold: marked, or every way on leads to a cold block
    let mut changed = true;
    while changed {
        changed = false;
        for k in 0..post.len {
            let b = @int_cast(usize, post.get(k));
            let blk = f.blocks.get(b);
            if cold[b] or (blk.succs.len == 0) {
                continue;
            }
            let mut all = true;
            for j in 0..blk.succs.len {
                if not cold[@int_cast(usize, blk.succs.get(j))] {
                    all = false;
                }
            }
            if all {
                cold[b] = true;
                changed = true;
            }
        }
    }
    // predecessors
    let preds = u.newn.[u.List.[i32]](nb + 1);
    for bi in 0..nb {
        preds[bi] = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };
    }
    for bi in 0..nb {
        let blk = f.blocks.get(bi);
        for k in 0..blk.succs.len {
            preds[@int_cast(usize, blk.succs.get(k))].push(@int_cast(i32, bi));
        }
    }
    // natural loops, one per header
    let mut loops = u.List.[Loop].{ data: u.nil.[Loop](), len: 0, cap: 0 };
    let mut work = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };
    for e in 0..heads.len {
        let h = heads.get(e);
        let mut li: usize = loops.len;
        for j in 0..loops.len {
            if loops.get(j).head == h {
                li = j;
            }
        }
        if li == loops.len {
            let bs = u.newn.[u64](w + 1);
            for j in 0..w {
                bs[j] = 0;
            }
            bset(bs, @int_cast(usize, h));
            loops.push(Loop.{ head: h, blocks: bs, size: 1, parent: -1, fin: 0.0 });
        }
        let l = loops.at(li);
        work.clear();
        work.push(srcs.get(e));
        while work.len > 0 {
            let x = work.pop();
            if in_loop(l, x) or (color[@int_cast(usize, x)] == 0) {
                continue;
            }
            bset(l.blocks, @int_cast(usize, x));
            l.size += 1;
            let ps = &preds[@int_cast(usize, x)];
            for j in 0..ps.len {
                work.push(ps.get(j));
            }
        }
    }
    // nesting: the smallest loop containing a block, or another loop's header
    let nl = loops.len;
    for bi in 0..nb {
        let mut best: i32 = -1;
        for j in 0..nl {
            let l = loops.at(j);
            if in_loop(l, @int_cast(i32, bi)) and ((best < 0) or (l.size < loops.at(@int_cast(usize, best)).size)) {
                best = @int_cast(i32, j);
            }
        }
        inner[bi] = best;
    }
    for j in 0..nl {
        let l = loops.at(j);
        let mut best: i32 = -1;
        for q in 0..nl {
            let m = loops.at(q);
            if (q != j) and in_loop(m, l.head) and (m.size > l.size) and
               ((best < 0) or (m.size < loops.at(@int_cast(usize, best)).size)) {
                best = @int_cast(i32, q);
            }
        }
        l.parent = best;
    }
    // innermost loops first (by size); the function body (-1) last
    let mut order = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };
    for j in 0..nl {
        order.push(@int_cast(i32, j));
    }
    for a in 0..nl {
        for b2 in (a + 1)..nl {
            if loops.at(@int_cast(usize, order.get(b2))).size < loops.at(@int_cast(usize, order.get(a))).size {
                let t = order.get(a);
                order.set(a, order.get(b2));
                order.set(b2, t);
            }
        }
    }
    order.push(-1);
    // per loop: the mass of each of its blocks per iteration, and where it exits
    let rel = u.newn.[f64](nb + 1);  // within the innermost loop (for headers: within the parent)
    let exits = u.newn.[u.List.[i32]](nl + 1);
    let exitp = u.newn.[u.List.[f64]](nl + 1);
    for j in 0..nl {
        exits[j] = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };
        exitp[j] = u.List.[f64].{ data: u.nil.[f64](), len: 0, cap: 0 };
    }
    let mut pr = u.List.[f64].{ data: u.nil.[f64](), len: 0, cap: 0 };
    for oi in 0..order.len {
        let li = order.get(oi);
        let mut head: i32 = 0;
        if li >= 0 {
            head = loops.at(@int_cast(usize, li)).head;
        }
        for bi in 0..nb {
            mass[bi] = 0.0;
        }
        mass[@int_cast(usize, head)] = 1.0;
        let mut k = post.len;
        while k > 0 {
            k -= 1;
            let b = @int_cast(usize, post.get(k));
            // a block of this loop, or the header of a loop directly inside it
            let mut child: i32 = -1;
            if inner[b] != li {
                let c = inner[b];
                if (c < 0) or (loops.at(@int_cast(usize, c)).head != @int_cast(i32, b)) or
                   (loops.at(@int_cast(usize, c)).parent != li) {
                    continue;
                }
                child = c;
            }
            let m = mass[b];
            if m == 0.0 {
                continue;
            }
            if child >= 0 {
                let ex = &exits[@int_cast(usize, child)];
                let ep = &exitp[@int_cast(usize, child)];
                for j in 0..ex.len {
                    route(&loops, inner[0..nb], li, head, ex.get(j), m * ep.get(j), mass, exits[0..nl], exitp[0..nl]);
                }
            } else {
                edge_probs(f, cold[0..nb], inner[0..nb], &loops, b, &mut pr);
                let blk = f.blocks.get(b);
                for j in 0..blk.succs.len {
                    route(&loops, inner[0..nb], li, head, blk.succs.get(j), m * pr.get(j), mass, exits[0..nl],
                          exitp[0..nl]);
                }
            }
        }
        for bi in 0..nb {
            if (inner[bi] == li) or
               ((inner[bi] >= 0) and (loops.at(@int_cast(usize, inner[bi])).head == @int_cast(i32, bi)) and
                (loops.at(@int_cast(usize, inner[bi])).parent == li)) {
                rel[bi] = mass[bi];
            }
        }
        if li >= 0 {
            // exits in proportion
            let ep = &mut exitp[@int_cast(usize, li)];
            let mut tot: f64 = 0.0;
            for j in 0..ep.len {
                tot += ep.get(j);
            }
            if tot > 0.0 {
                for j in 0..ep.len {
                    ep.set(j, ep.get(j) / tot);
                }
            }
        }
    }
    // entries of each loop, outermost first
    let mut oi = order.len;
    while oi > 0 {
        oi -= 1;
        let li = order.get(oi);
        if li < 0 {
            continue;
        }
        let l = loops.at(@int_cast(usize, li));
        let h = @int_cast(usize, l.head);
        if l.parent < 0 {
            l.fin = rel[h];
        } else {
            l.fin = loops.at(@int_cast(usize, l.parent)).fin * LOOP_SCALE * rel[h];
        }
    }
    for bi in 0..nb {
        if color[bi] == 0 {
            continue;
        }
        let li = inner[bi];
        let mut fq = rel[bi];
        if li >= 0 {
            let l = loops.at(@int_cast(usize, li));
            if l.head == @int_cast(i32, bi) {
                fq = l.fin * LOOP_SCALE;
            } else {
                fq = l.fin * LOOP_SCALE * rel[bi];
            }
        }
        if fq < 1.0e-6 {
            fq = 1.0e-6;
        }
        if fq > 1.0e6 {
            fq = 1.0e6;
        }
        f.blocks.get(bi).freq = fq;
    }
    for bi in 0..nb {
        u.free(@ptr_cast(*mut void, preds[bi].data));
    }
    for j in 0..nl {
        u.free(@ptr_cast(*mut void, exits[j].data));
        u.free(@ptr_cast(*mut void, exitp[j].data));
    }
    u.free(@ptr_cast(*mut void, post.data));
    u.free(@ptr_cast(*mut void, stk.data));
    u.free(@ptr_cast(*mut void, sidx.data));
    u.free(@ptr_cast(*mut void, heads.data));
    u.free(@ptr_cast(*mut void, srcs.data));
    u.free(@ptr_cast(*mut void, loops.data));
    u.free(@ptr_cast(*mut void, work.data));
    u.free(@ptr_cast(*mut void, order.data));
    u.free(@ptr_cast(*mut void, pr.data));
}

// Mass m reaches block x from inside loop li (-1: the function body): back to
// the header (dropped: the loop scale stands for it), into a block of the
// loop (for one inside a nested loop, that loop's header), or out (an exit).
fn route(loops: *u.List.[Loop], inner: []i32, li: i32, head: i32, x: i32, m: f64, mass: []mut f64,
         exits: []mut u.List.[i32], exitp: []mut u.List.[f64]) void {
    if x == head {
        return;
    }
    let xi = @int_cast(usize, x);
    if (li < 0) or in_loop(loops.at(@int_cast(usize, li)), x) {
        // the outermost loop inside li containing x
        let mut c = inner[xi];
        let mut node = x;
        while (c >= 0) and (c != li) {
            node = loops.at(@int_cast(usize, c)).head;
            c = loops.at(@int_cast(usize, c)).parent;
        }
        mass[@int_cast(usize, node)] += m;
        return;
    }
    let ex = &mut exits[@int_cast(usize, li)];
    let ep = &mut exitp[@int_cast(usize, li)];
    for j in 0..ex.len {
        if ex.get(j) == x {
            ep.set(j, ep.get(j) + m);
            return;
        }
    }
    ex.push(x);
    ep.push(m);
}

// -----------------------------------------------------------------------------
// Intervals and fixed ranges
// -----------------------------------------------------------------------------
struct Range {
    s: i32,
    e: i32,
}

let mut fixed: [64]u.List.[Range] = [u.List.[Range].{ data: @ptr_from_int(*mut Range, 0), len: 0, cap: 0 }; 64];
// after build_fixed: each register's ranges sorted by start, and the
// largest end among the first k+1 of them
let mut fixed_maxe: [64]u.List.[i32] = [u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 }; 64];

fn add_fixed(r: i32, s: i32, e: i32) void {
    fixed[@int_cast(usize, r)].push(Range.{ s: s, e: e });
}

fn range_before(a: Range, b: Range) i32 {
    if a.s < b.s {
        return -1;
    }
    if a.s > b.s {
        return 1;
    }
    return 0;
}

fn sort_fixed() void {
    for r in @as(usize, 0)..64 {
        let l = &mut fixed[r];
        u.sort.[Range](l.items(), range_before);
        let m = &mut fixed_maxe[r];
        m.clear();
        let mut mx: i32 = -1;
        for k in 0..l.len {
            let x = l.get(k);
            if x.e > mx {
                mx = x.e;
            }
            m.push(mx);
        }
    }
}

// Does a fixed range of r overlap [s, e]?
fn fixed_conflict(r: i32, s: i32, e: i32) bool {
    let l = &fixed[@int_cast(usize, r)];
    // the ranges starting at or before e: a prefix
    let mut lo: usize = 0;
    let mut hi = l.len;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if l.get(mid).s <= e {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo == 0 {
        return false;
    }
    return fixed_maxe[@int_cast(usize, r)].get(lo - 1) >= s;
}

fn build_fixed(f: *mut MFunc) void {
    for r in @as(usize, 0)..64 {
        fixed[r].clear();
    }
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        // per physical register: the position of the next read (scanning backwards)
        let mut next_use: [64]i32 = [-1; 64];
        let mut i = b.last;
        while u.notnil(i) {
            let p = i.pos;
            if i.clobber != 0 {
                for r in @as(u32, 0)..64 {
                    if (i.clobber & (@as(u64, 1) << r)) != 0 {
                        add_fixed(@as(i32, @bit_cast(i32, r)), (2 * p) + 1, (2 * p) + 1);
                    }
                }
            }
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and not is_vreg(o.reg) and (o.reg >= 0) and ((o.role & RD) != 0) {
                    let ri = @int_cast(usize, o.reg);
                    let mut s = (2 * p) + 1;
                    if (o.role & RE) != 0 {
                        s = 2 * p;
                    }
                    let mut e = next_use[ri];
                    if e < 0 {
                        e = s;
                    }
                    add_fixed(o.reg, s, e);
                    next_use[ri] = -1;
                }
            }
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and not is_vreg(o.reg) and (o.reg >= 0) and ((o.role & RU) != 0) {
                    let ri = @int_cast(usize, o.reg);
                    if next_use[ri] < 0 {
                        next_use[ri] = 2 * p;
                    }
                }
                if o.kind == K_MEM {
                    if (o.base >= 0) and not is_vreg(o.base) {
                        let ri = @int_cast(usize, o.base);
                        if next_use[ri] < 0 {
                            next_use[ri] = 2 * p;
                        }
                    }
                    if (o.index >= 0) and not is_vreg(o.index) {
                        let ri = @int_cast(usize, o.index);
                        if next_use[ri] < 0 {
                            next_use[ri] = 2 * p;
                        }
                    }
                }
            }
            i = i.prev;
        }
        // registers read before any write in the block: live from its start
        for r in @as(usize, 0)..64 {
            if next_use[r] >= 0 {
                add_fixed(@int_cast(i32, r), b.start, next_use[r]);
            }
        }
    }
    sort_fixed();
}

struct Interval {
    v: i32,  // vreg index (vreg - VREG0)
    s: i32,  // first position
    e: i32,  // last position
    reg: i32,
    spilled: bool,
    uses: f64,               // uses and definitions, weighted by 10^loop depth
    ranges: u.List.[Range],  // the positions it is live at: sorted, disjoint, inclusive
    size: i32,               // positions covered
}

const WEIGHT_PAD: i32 = 50;

// The cost of spilling an interval: its (weighted) uses per position covered.
fn weight(f: *MFunc, x: *Interval) f64 {
    if f.nospill.get(@int_cast(usize, x.v)) {
        return 1.0e300;
    }
    let w = x.uses / @float_from_int(f64, x.size + WEIGHT_PAD);
    if u.notnil(f.remat.get(@int_cast(usize, x.v))) {
        return w * 0.5;  // (rebuilt where it is used: no stores, no slot)
    }
    return w;
}

// Ranges are built backwards (blocks in reverse order, instructions last to
// first), so they are appended in decreasing order and reversed at the end;
// the last one is the current block's.
fn add_range(x: *mut Interval, s: i32, e: i32) void {
    if x.ranges.len > 0 {
        let l = x.ranges.at(x.ranges.len - 1);
        if l.s <= (e + 1) {
            if s < l.s {
                l.s = s;
            }
            if e > l.e {
                l.e = e;
            }
            return;
        }
    }
    x.ranges.push(Range.{ s: s, e: e });
}

// A definition at p: the value is live from p (not from the block's start).
fn def_at(x: *mut Interval, p: i32, live: bool) void {
    if live and (x.ranges.len > 0) {
        let l = x.ranges.at(x.ranges.len - 1);
        if p <= l.e {
            l.s = p;
            return;
        }
    }
    x.ranges.push(Range.{ s: p, e: p });  // dead definition
}

fn build_intervals(f: *mut MFunc) []mut Interval {
    let nv = nvregs(f);
    let iv = u.newn.[Interval](nv + 1);
    for k in 0..nv {
        iv[k] = Interval.{ v: @int_cast(i32, k), s: 0x7fff_ffff, e: -1, reg: -1, spilled: false, uses: 0.0,
                           ranges: u.List.[Range].{ data: u.nil.[Range](), len: 0, cap: 0 }, size: 0 };
    }
    let w = words(nv);
    let live = u.newn.[u64](w + 1);
    let mut bi = f.blocks.len;
    while bi > 0 {
        bi -= 1;
        let b = f.blocks.get(bi);
        let dw = b.freq;
        for j in 0..w {
            live[j] = b.live_out[j];
            let lo = b.live_out[j];
            if lo == 0 {
                continue;
            }
            for bit in @as(usize, 0)..64 {
                if (lo & (@as(u64, 1) << @int_cast(u32, bit))) != 0 {
                    add_range(&mut iv[(j * 64) + bit], b.start, b.end);
                }
            }
        }
        let mut i = b.last;
        while u.notnil(i) {
            let p = i.pos;
            // definitions end the value's life above them
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RD) != 0) {
                    let x = @int_cast(usize, o.reg - VREG0);
                    let mut dp = (2 * p) + 1;
                    if (o.role & RE) != 0 {
                        dp = 2 * p;
                    }
                    def_at(&mut iv[x], dp, bget(live, x));
                    bclr(live, x);
                    iv[x].uses += dw;
                }
            }
            // uses make it live from the block's start (until a definition)
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RU) != 0) {
                    let x = @int_cast(usize, o.reg - VREG0);
                    add_range(&mut iv[x], b.start, 2 * p);
                    bset(live, x);
                    iv[x].uses += dw;
                } else if o.kind == K_MEM {
                    let regs: [2]i32 = [o.base, o.index];
                    for r in regs {
                        if is_vreg(r) {
                            let x = @int_cast(usize, r - VREG0);
                            add_range(&mut iv[x], b.start, 2 * p);
                            bset(live, x);
                            iv[x].uses += dw;
                        }
                    }
                }
            }
            i = i.prev;
        }
    }
    for k in 0..nv {
        let x = &mut iv[k];
        let n = x.ranges.len;
        if n == 0 {
            continue;
        }
        // increasing order
        let rs = x.ranges.items();
        for j in 0..(n / 2) {
            let t = rs[j];
            rs[j] = rs[(n - 1) - j];
            rs[(n - 1) - j] = t;
        }
        x.s = rs[0].s;
        x.e = rs[n - 1].e;
        for j in 0..n {
            x.size += (rs[j].e - rs[j].s) + 1;
        }
    }
    return iv[0..nv];
}

// Does a fixed range of r overlap x?
fn fixed_hits(r: i32, x: *Interval) bool {
    for k in 0..x.ranges.len {
        let y = x.ranges.get(k);
        if fixed_conflict(r, y.s, y.e) {
            return true;
        }
    }
    return false;
}

// -----------------------------------------------------------------------------
// One allocation round, greedily: intervals in order of size (largest
// first: the hardest to place), each into a free register (its hint's
// first), else into the register whose interfering intervals cost least
// to spill, when all of them cost less than it (they are taken out and
// queued again), else spilled. Unlike a linear scan, an interval is weighed
// against everything it overlaps, not only what is live where it starts.
// Each physical register keeps the segments assigned to it (disjoint, in
// order). Returns the number of intervals spilled.
// -----------------------------------------------------------------------------
struct Seg {
    s: i32,
    e: i32,
    x: i32,  // interval index
}

// the first segment ending at or after p
fn seg_first(l: *u.List.[Seg], p: i32) usize {
    let mut lo: usize = 0;
    let mut hi = l.len;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if l.get(mid).e < p {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn seg_insert(l: *mut u.List.[Seg], sg: Seg) void {
    let k = seg_first(l, sg.s);
    l.push(sg);
    let mut j = l.len - 1;
    while j > k {
        l.set(j, l.get(j - 1));
        j -= 1;
    }
    l.set(k, sg);
}

fn seg_remove(l: *mut u.List.[Seg], s: i32) void {
    let k = seg_first(l, s);
    for j in k..(l.len - 1) {
        l.set(j, l.get(j + 1));
    }
    l.len -= 1;
}

fn reg_free(l: *u.List.[Seg], x: *Interval) bool {
    for j in 0..x.ranges.len {
        let rg = x.ranges.get(j);
        let k = seg_first(l, rg.s);
        if (k < l.len) and (l.get(k).s <= rg.e) {
            return false;
        }
    }
    return true;
}

// max-heap of interval indexes by key
fn heap_push(h: *mut u.List.[i32], key: []f64, x: i32) void {
    h.push(x);
    let mut k = h.len - 1;
    while k > 0 {
        let p = (k - 1) / 2;
        let a = h.get(p);
        if (key[@int_cast(usize, a)] > key[@int_cast(usize, x)]) or
           ((key[@int_cast(usize, a)] == key[@int_cast(usize, x)]) and (a < x)) {
            break;
        }
        h.set(k, a);
        k = p;
    }
    h.set(k, x);
}

fn heap_pop(h: *mut u.List.[i32], key: []f64) i32 {
    let top = h.get(0);
    let x = h.get(h.len - 1);
    h.len -= 1;
    let n = h.len;
    if n == 0 {
        return top;
    }
    let mut k: usize = 0;
    loop {
        let mut c = (2 * k) + 1;
        if c >= n {
            break;
        }
        let r = c + 1;
        if r < n {
            let a = h.get(c);
            let b = h.get(r);
            if (key[@int_cast(usize, b)] > key[@int_cast(usize, a)]) or
               ((key[@int_cast(usize, b)] == key[@int_cast(usize, a)]) and (b < a)) {
                c = r;
            }
        }
        let y = h.get(c);
        if (key[@int_cast(usize, x)] > key[@int_cast(usize, y)]) or
           ((key[@int_cast(usize, x)] == key[@int_cast(usize, y)]) and (x < y)) {
            break;
        }
        h.set(k, y);
        k = c;
    }
    h.set(k, x);
    return top;
}

pub let mut debug_ra: bool = false;

fn assign_reg(segs: []mut u.List.[Seg], x: *mut Interval, xi: i32, r: i32) void {
    if debug_ra {
        u.eprint(u.f2("  v%s -> r%s\n", u.idec(xi), u.idec(r)));
    }
    x.reg = r;
    for j in 0..x.ranges.len {
        let rg = x.ranges.get(j);
        seg_insert(&mut segs[@int_cast(usize, r)], Seg.{ s: rg.s, e: rg.e, x: xi });
    }
}

fn unassign_reg(segs: []mut u.List.[Seg], x: *mut Interval) void {
    let r = x.reg;
    for j in 0..x.ranges.len {
        seg_remove(&mut segs[@int_cast(usize, r)], x.ranges.get(j).s);
    }
    x.reg = -1;
}

fn greedy(f: *mut MFunc, t: *Target, iv: []mut Interval) usize {
    let n = iv.len;
    let key = u.newn.[f64](n + 1);
    let wt = u.newn.[f64](n + 1);
    let mut heap = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };
    for k in 0..n {
        wt[k] = weight(f, &iv[k]);
        key[k] = @float_from_int(f64, iv[k].size);
        if f.nospill.get(@int_cast(usize, iv[k].v)) {
            key[k] = 1.0e300;
        }
        if iv[k].e >= 0 {
            heap_push(&mut heap, key[0..n], @int_cast(i32, k));
        }
    }
    let segs = u.newn.[u.List.[Seg]](64);
    for r in @as(usize, 0)..64 {
        segs[r] = u.List.[Seg].{ data: u.nil.[Seg](), len: 0, cap: 0 };
    }
    let mut vict = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };
    let mut nspill: usize = 0;
    let mut evictions: usize = 0;
    while heap.len > 0 {
        let ci = heap_pop(&mut heap, key[0..n]);
        let cur = &mut iv[@int_cast(usize, ci)];
        let class = f.vclass.get(@int_cast(usize, cur.v));
        let order = t.alloc_order[@as(usize, class)];
        let mut pick: i32 = -1;
        // the hint first
        let h = f.hint.get(@int_cast(usize, cur.v));
        let mut hr: i32 = -1;
        if (h >= 0) and not is_vreg(h) {
            hr = h;
        } else if is_vreg(h) and (iv[@int_cast(usize, h - VREG0)].reg >= 0) {
            hr = iv[@int_cast(usize, h - VREG0)].reg;
        }
        if (hr >= 0) and in_order(order, hr) and reg_free(&segs[@int_cast(usize, hr)], cur) and
           not fixed_hits(hr, cur) {
            pick = hr;
        }
        if pick < 0 {
            for r in order {
                if reg_free(&segs[@int_cast(usize, r)], cur) and not fixed_hits(r, cur) {
                    pick = r;
                    break;
                }
            }
        }
        if pick >= 0 {
            assign_reg(segs, cur, ci, pick);
            continue;
        }
        // evict: the register whose interfering intervals cost least (the
        // dearest of them, then all together), if less than cur
        let must = f.nospill.get(@int_cast(usize, cur.v));
        let wc = wt[@int_cast(usize, ci)];
        let mut best: i32 = -1;
        let mut bmax: f64 = 0.0;
        let mut bsum: f64 = 0.0;
        if evictions <= ((8 * n) + 100) {
            for r in order {
                if fixed_hits(r, cur) {
                    continue;
                }
                let l = &segs[@int_cast(usize, r)];
                let mut mx: f64 = 0.0;
                let mut sum: f64 = 0.0;
                let mut last: i32 = -1;
                let mut ok = true;
                for j in 0..cur.ranges.len {
                    let rg = cur.ranges.get(j);
                    let mut k = seg_first(l, rg.s);
                    while ok and (k < l.len) and (l.get(k).s <= rg.e) {
                        let x = l.get(k).x;
                        if x != last {
                            let w = wt[@int_cast(usize, x)];
                            if f.nospill.get(@int_cast(usize, iv[@int_cast(usize, x)].v)) or not (must or (w < wc)) {
                                ok = false;
                            }
                            if w > mx {
                                mx = w;
                            }
                            sum += w;  // (an interval met twice counts twice: a rough sum)
                            last = x;
                        }
                        k += 1;
                    }
                }
                if ok and ((best < 0) or (mx < bmax) or ((mx == bmax) and (sum < bsum))) {
                    best = r;
                    bmax = mx;
                    bsum = sum;
                }
            }
        }
        if best < 0 {
            if debug_ra {
                u.eprint(u.f1("  v%s spilled\n", u.idec(ci)));
            }
            if must {
                u.die("internal compiler error: register allocation failed (no register for a reload)");
            }
            cur.spilled = true;
            nspill += 1;
            continue;
        }
        let l = &segs[@int_cast(usize, best)];
        vict.clear();
        for j in 0..cur.ranges.len {
            let rg = cur.ranges.get(j);
            let mut k = seg_first(l, rg.s);
            while (k < l.len) and (l.get(k).s <= rg.e) {
                let x = l.get(k).x;
                let mut seen = false;
                for q in 0..vict.len {
                    if vict.get(q) == x {
                        seen = true;
                    }
                }
                if not seen {
                    vict.push(x);
                }
                k += 1;
            }
        }
        for q in 0..vict.len {
            let x = vict.get(q);
            if debug_ra {
                u.eprint(u.f2("  v%s evicts v%s\n", u.idec(ci), u.idec(x)));
            }
            unassign_reg(segs, &mut iv[@int_cast(usize, x)]);
            heap_push(&mut heap, key[0..n], x);
            evictions += 1;
        }
        assign_reg(segs, cur, ci, best);
    }
    for r in @as(usize, 0)..64 {
        u.free(@ptr_cast(*mut void, segs[r].data));
    }
    u.free(@ptr_cast(*mut void, heap.data));
    u.free(@ptr_cast(*mut void, vict.data));
    for k in 0..n {
        u.free(@ptr_cast(*mut void, iv[k].ranges.data));
    }
    return nspill;
}

fn in_order(order: []i32, r: i32) bool {
    for x in order {
        if x == r {
            return true;
        }
    }
    return false;
}

// -----------------------------------------------------------------------------
// Spilling and live-range splitting
//
// A spilled vreg gets a stack slot, which its pieces share. It is first split
// into pieces rather than spilled everywhere: where it is live across a call,
// or along the edges into and out of loops, it is in its slot, and in between
// each connected stretch (a region) becomes a new vreg, which takes part in the
// next round like any other: in a register inside a loop or between calls,
// say, while it stays in memory across them. A region is reloaded where it
// is entered from memory (after a call, at a loop's entry), or copied from the
// region before it along an edge (a copy the allocator can coalesce, and which
// becomes a reload or a store if either side is spilled in turn). The slot
// holds the value wherever it is in memory: a region that defines it stores
// it after each definition, or where it leaves the region, whichever is
// cheaper (by loop depth).
//
// level 0 vregs are split around calls and at loop boundaries; their pieces
// (level 1) at every block boundary; and those pieces (level 2) are spilled
// everywhere, each use and definition through a short-lived register.
// -----------------------------------------------------------------------------
fn writes_reg(i: *MInst, v: i32) bool {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and (o.reg == v) and ((o.role & RD) != 0) {
            return true;
        }
    }
    return false;
}

fn mentions(i: *MInst, v: i32) bool {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and (o.reg == v) {
            return true;
        }
        if (o.kind == K_MEM) and ((o.base == v) or (o.index == v)) {
            return true;
        }
    }
    return false;
}

fn replace_reg(i: *mut MInst, v: i32, w: i32) void {
    if (i.spill != 0) and (i.sreg == v) {
        i.sreg = w;
    }
    for k in 0..i.ops.len {
        let o = &mut i.ops[k];
        if (o.kind == K_REG) and (o.reg == v) {
            o.reg = w;
        }
        if o.kind == K_MEM {
            if o.base == v {
                o.base = w;
            }
            if o.index == v {
                o.index = w;
            }
        }
    }
}

// The destination and source registers of a copy (is_move).
fn move_dst(i: *MInst) i32 {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and ((o.role & RD) != 0) {
            return o.reg;
        }
    }
    return -1;
}

fn move_src(i: *MInst) i32 {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and ((o.role & RD) == 0) and ((o.role & RU) != 0) {
            return o.reg;
        }
    }
    return -1;
}

fn is_jump(i: *MInst) bool {
    for k in 0..i.ops.len {
        if i.ops[k].kind == K_LABEL {
            return true;
        }
    }
    return false;
}

// Inserts i at the end of b, before the jumps that end it (spill code changes
// no flags).
fn insert_end(b: *mut MBlock, i: *mut MInst) void {
    let mut j = b.last;
    let mut pos = u.nil.[MInst]();
    while u.notnil(j) and is_jump(j) {
        pos = j;
        j = j.prev;
    }
    if u.notnil(pos) {
        insert_before(b, pos, i);
    } else {
        append(b, i);
    }
}

fn insert_start(b: *mut MBlock, i: *mut MInst) void {
    if u.notnil(b.first) {
        insert_before(b, b.first, i);
    } else {
        append(b, i);
    }
}

fn slot_of(f: *mut MFunc, x: usize) i32 {
    let mut s = f.vslot.get(x);
    if s < 0 {
        let c = f.vclass.get(x);
        let mut sz: u64 = 8;
        if c >= 1 {
            sz = @as(u64, 16) << @truncate(u32, @as(u64, c) - 1);  // (16, 32 or 64 bytes)
        }
        s = new_slot(f, sz, sz);
        f.vslot.set(x, s);
    }
    return s;
}

fn reload(f: *mut MFunc, t: *Target, r: i32, c: u8, slot: i32) *mut MInst {
    let i = t.spill_load(f, r, @as(i32, c), slot);
    i.spill = 1;
    i.sreg = r;
    i.sslot = slot;
    return i;
}

fn store(f: *mut MFunc, t: *Target, r: i32, c: u8, slot: i32) *mut MInst {
    let i = t.spill_store(f, r, @as(i32, c), slot);
    i.spill = 2;
    i.sreg = r;
    i.sslot = slot;
    return i;
}

// A call clobbering most of class c's registers: values live across it are
// split there.
fn call_cut(t: *Target, c: u8, i: *MInst) bool {
    if i.clobber == 0 {
        return false;
    }
    let order = t.alloc_order[@as(usize, c)];
    let mut n: usize = 0;
    for r in order {
        if (i.clobber & (@as(u64, 1) << @int_cast(u32, r))) != 0 {
            n += 1;
        }
    }
    return (2 * n) > order.len;
}

struct Cfg {
    npred: []mut i32,
    nsucc: []mut i32,
    simple: []mut bool,  // the block's jumps all come at its end (spill code can go before them)
    endok: []mut bool,   // every predecessor is simple and has the block as its only successor
}

fn find(p: *mut u.List.[i32], x: i32) i32 {
    let mut r = x;
    while p.get(@int_cast(usize, r)) != r {
        r = p.get(@int_cast(usize, r));
    }
    let mut y = x;
    while p.get(@int_cast(usize, y)) != r {
        let n = p.get(@int_cast(usize, y));
        p.set(@int_cast(usize, y), r);
        y = n;
    }
    return r;
}

fn depth_of(f: *MFunc, bi: usize) i32 {
    return f.blocks.get(bi).loop_depth;
}

// Spill code between v and its slot, or a copy between v and another piece of
// the same vreg (made where it was split, where the slot holds the value too):
// i sets v to what the slot holds (in) or passes it on (out).
fn same_slot(f: *MFunc, r: i32, sl: i32) bool {
    return is_vreg(r) and (f.vslot.get(@int_cast(usize, r - VREG0)) == sl);
}

fn transfer_in(f: *MFunc, i: *MInst, v: i32) bool {
    let sl = f.vslot.get(@int_cast(usize, v - VREG0));
    if sl < 0 {
        return false;
    }
    if (i.spill == 1) and (i.sreg == v) and (i.sslot == sl) {
        return true;
    }
    return i.is_move and (move_dst(i) == v) and same_slot(f, move_src(i), sl);
}

fn transfer_out(f: *MFunc, i: *MInst, v: i32) bool {
    let sl = f.vslot.get(@int_cast(usize, v - VREG0));
    if sl < 0 {
        return false;
    }
    if (i.spill == 2) and (i.sreg == v) and (i.sslot == sl) {
        return true;
    }
    return i.is_move and (move_src(i) == v) and same_slot(f, move_dst(i), sl);
}

// A use or definition of v other than its spill code.
fn real_use(f: *MFunc, i: *MInst, v: i32) bool {
    return mentions(i, v) and not transfer_in(f, i, v) and not transfer_out(f, i, v);
}

// Is the edge from block p to block s (where the vreg is live) a split point?
// Spill code goes at the start of s if p is its only predecessor or every
// edge into s is a split point, else at the end of p if s is its only
// successor.
fn edge_cut(f: *MFunc, g: *Cfg, allin: []bool, memtail: []bool, all_edges: bool, p: usize, s: usize) bool {
    if not all_edges and not memtail[p] and (depth_of(f, p) == depth_of(f, s)) {
        return false;
    }
    return allin[s] or (g.npred[s] == 1) or ((g.nsucc[p] == 1) and g.simple[p]);
}

// Splits vreg x into regions (see above), at calls and loop boundaries, or at
// every block boundary (all_edges). Returns false, changing nothing, if there
// is nothing to split.
fn split(f: *mut MFunc, t: *Target, g: *Cfg, x: usize, all_edges: bool, level: u8) bool {
    let v = VREG0 + @int_cast(i32, x);
    let c = f.vclass.get(x);
    let nb = f.blocks.len;
    let head = u.newn.[i32](nb + 1);
    let tail = u.newn.[i32](nb + 1);
    let allin = u.newn.[bool](nb + 1);
    let mut par = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };                 // union-find over segments
    let mut occ = u.List.[bool].{ data: u.nil.[bool](), len: 0, cap: 0 };               // the vreg is read or written there
    let mut rel = u.List.[bool].{ data: u.nil.[bool](), len: 0, cap: 0 };               // ... or live
    let mut defc = u.List.[f64].{ data: u.nil.[f64](), len: 0, cap: 0 };                // definitions, by loop depth
    let mut cuts = u.List.[*mut MInst].{ data: u.nil.[*mut MInst](), len: 0, cap: 0 };  // calls it is live across
    let mut cut_seg = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };             // the segment before each
    let mut cut_fq = u.List.[f64].{ data: u.nil.[f64](), len: 0, cap: 0 };
    let mut arr = u.List.[*mut MInst].{ data: u.nil.[*mut MInst](), len: 0, cap: 0 };
    let mut la = u.List.[bool].{ data: u.nil.[bool](), len: 0, cap: 0 };
    // segments: the stretches of each block between the calls it is live across
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        let fq = b.freq;
        arr.clear();
        la.clear();
        let mut i = b.first;
        while u.notnil(i) {
            arr.push(i);
            la.push(false);
            i = i.next;
        }
        let mut live = bget(b.live_out, x);
        let mut k = arr.len;
        while k > 0 {
            k -= 1;
            let j = arr.get(k);
            la.set(k, live);
            if writes_reg(j, v) {
                live = false;
            }
            if each_reg_use(j, v) {
                live = true;
            }
        }
        let mut seg = @int_cast(i32, par.len);
        par.push(seg);
        occ.push(false);
        rel.push(bget(b.live_in, x));
        defc.push(0.0);
        head[bi] = seg;
        for k2 in 0..arr.len {
            let j = arr.get(k2);
            let s = @int_cast(usize, seg);
            let w = writes_reg(j, v);
            if mentions(j, v) {
                rel.set(s, true);
            }
            if real_use(f, j, v) {
                occ.set(s, true);
                if w {
                    defc.set(s, defc.get(s) + fq);
                }
            }
            if g.simple[bi] and not w and la.get(k2) and call_cut(t, c, j) {
                cuts.push(j);
                cut_seg.push(seg);
                cut_fq.push(fq);
                rel.set(s, true);
                seg = @int_cast(i32, par.len);
                par.push(seg);
                occ.push(false);
                rel.push(true);
                defc.push(0.0);
            }
        }
        if bget(b.live_out, x) {
            rel.set(@int_cast(usize, seg), true);
        }
        tail[bi] = seg;
    }
    // edges: joined, or split points (always after a call it is not used after
    // in the block: reloaded where it is used next)
    let memtail = u.newn.[bool](nb + 1);
    for bi in 0..nb {
        let tl = @int_cast(usize, tail[bi]);
        memtail[bi] = (tail[bi] != head[bi]) and not occ.get(tl);
    }
    // blocks that neither use it nor call, entered only from where it is in
    // memory (after a call it is not used after, or another such block),
    // leave it there: reloaded where it is used next, past joins of such
    // paths, not where it was last in memory
    let memthru = u.newn.[bool](nb + 1);
    for bi in 0..nb {
        memthru[bi] = (bi > 0) and (tail[bi] == head[bi]) and not occ.get(@int_cast(usize, head[bi])) and
                      bget(f.blocks.get(bi).live_in, x);
    }
    let mut mchanged = true;
    while mchanged {
        mchanged = false;
        for pi in 0..nb {
            if memtail[pi] or memthru[pi] {
                continue;
            }
            let pb = f.blocks.get(pi);
            for k in 0..pb.succs.len {
                let si = @int_cast(usize, pb.succs.get(k));
                if memthru[si] {
                    memthru[si] = false;
                    mchanged = true;
                }
            }
        }
    }
    for bi in 0..nb {
        if memthru[bi] {
            memtail[bi] = true;
        }
    }
    for si in 0..nb {
        allin[si] = true;
    }
    for pi in 0..nb {
        let pb = f.blocks.get(pi);
        for k in 0..pb.succs.len {
            let si = @int_cast(usize, pb.succs.get(k));
            if not all_edges and not memtail[pi] and (depth_of(f, pi) == depth_of(f, si)) {
                allin[si] = false;
            }
        }
    }
    let mut nedge: usize = 0;
    for pi in 0..nb {
        let pb = f.blocks.get(pi);
        for k in 0..pb.succs.len {
            let si = @int_cast(usize, pb.succs.get(k));
            if not bget(f.blocks.get(si).live_in, x) {
                continue;
            }
            if edge_cut(f, g, allin[0..nb], memtail[0..nb], all_edges, pi, si) {
                nedge += 1;
            } else {
                let a = find(&mut par, tail[pi]);
                let b2 = find(&mut par, head[si]);
                par.set(@int_cast(usize, a), b2);
            }
        }
    }
    let ns = par.len;
    // nothing to split: one region, live across no call
    let mut progress = cuts.len > 0;
    if not progress {
        let mut root: i32 = -1;
        for s in 0..ns {
            if rel.get(s) {
                let r = find(&mut par, @int_cast(i32, s));
                if (root >= 0) and (r != root) {
                    progress = true;
                }
                root = r;
            }
        }
    }
    _ = nedge;
    if not progress {
        u.free(@ptr_cast(*mut void, par.data));
        u.free(@ptr_cast(*mut void, occ.data));
        u.free(@ptr_cast(*mut void, rel.data));
        u.free(@ptr_cast(*mut void, defc.data));
        u.free(@ptr_cast(*mut void, cuts.data));
        u.free(@ptr_cast(*mut void, cut_seg.data));
        u.free(@ptr_cast(*mut void, cut_fq.data));
        u.free(@ptr_cast(*mut void, arr.data));
        u.free(@ptr_cast(*mut void, la.data));
        return false;
    }
    // regions: whether they use it (else it stays in memory there), their
    // definitions and exits
    let rocc = u.newn.[bool](ns + 1);
    let rdef = u.newn.[f64](ns + 1);
    let rexit = u.newn.[f64](ns + 1);
    let wreg = u.newn.[i32](ns + 1);
    for s in 0..ns {
        rocc[s] = false;
        rdef[s] = 0.0;
        rexit[s] = 0.0;
        wreg[s] = -1;
    }
    for s in 0..ns {
        let r = @int_cast(usize, find(&mut par, @int_cast(i32, s)));
        if occ.get(s) {
            rocc[r] = true;
        }
        rdef[r] += defc.get(s);
    }
    for k in 0..cuts.len {
        rexit[@int_cast(usize, find(&mut par, cut_seg.get(k)))] += cut_fq.get(k);
    }
    for pi in 0..nb {
        let pb = f.blocks.get(pi);
        let mut any = false;
        for k in 0..pb.succs.len {
            let si = @int_cast(usize, pb.succs.get(k));
            if bget(f.blocks.get(si).live_in, x) and edge_cut(f, g, allin[0..nb], memtail[0..nb], all_edges, pi, si) {
                any = true;
            }
        }
        if any {
            let r = @int_cast(usize, find(&mut par, tail[pi]));
            if g.simple[pi] {
                rexit[r] += pb.freq;
            } else {
                rexit[r] = 1.0e300;  // (no place for a store there: after each definition)
            }
        }
    }
    let slot = slot_of(f, x);
    for s in 0..ns {
        if (find(&mut par, @int_cast(i32, s)) == @int_cast(i32, s)) and rocc[s] {
            let w = new_vreg(f, c);
            let wx = @int_cast(usize, w - VREG0);
            f.level.set(wx, level);
            f.vslot.set(wx, slot);
            wreg[s] = w;
        }
    }
    // stores where it leaves a region (if cheaper than after each definition)
    let at_exit = u.newn.[bool](ns + 1);
    for s in 0..ns {
        at_exit[s] = (rdef[s] > 0.0) and (rexit[s] <= rdef[s]);
    }
    // blocks reloading it themselves (every edge in is a split point): before
    // its first use there
    let sload = u.newn.[i32](nb + 1);
    for si in 0..nb {
        sload[si] = -1;
        if allin[si] and (g.npred[si] > 1) and not g.endok[si] and bget(f.blocks.get(si).live_in, x) {
            let r2 = @int_cast(usize, find(&mut par, head[si]));
            if rocc[r2] {
                sload[si] = @int_cast(i32, r2);
            }
        }
    }
    // rewrite
    let mut ck: usize = 0;
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        let mut seg = head[bi];
        let mut lbl = false;
        let mut i = b.first;
        while u.notnil(i) {
            if t.is_label(i) {
                lbl = true;
            }
            i = i.next;
        }
        let mut pend: i32 = sload[bi];  // a region to reload before the next use
        if (pend >= 0) and not g.simple[bi] {
            insert_start(b, reload(f, t, wreg[@int_cast(usize, pend)], c, slot));
            pend = -1;
        }
        i = b.first;
        while u.notnil(i) {
            let next = i.next;
            let r = @int_cast(usize, find(&mut par, seg));
            if (pend >= 0) and is_jump(i) and not mentions(i, v) {
                insert_before(b, i, reload(f, t, wreg[@int_cast(usize, pend)], c, slot));
                pend = -1;
            }
            if mentions(i, v) and not rocc[r] {
                // spill code of a region left in memory
                if transfer_out(f, i, v) and i.is_move {
                    let d = move_dst(i);
                    insert_before(b, i, reload(f, t, d, c, slot));
                }
                remove(b, i);
                i = next;
                continue;
            }
            if mentions(i, v) {
                let w = wreg[r];
                let wx = @int_cast(usize, w - VREG0);
                if pend >= 0 {
                    if not transfer_in(f, i, v) {
                        insert_before(b, i, reload(f, t, w, c, slot));
                    }
                    pend = -1;
                }
                if i.is_move {
                    let mut o = move_dst(i);
                    if o == v {
                        o = move_src(i);
                    }
                    if (o >= 0) and (o != v) {
                        if f.hint.get(wx) < 0 {
                            f.hint.set(wx, o);
                        }
                        if is_vreg(o) and (f.hint.get(@int_cast(usize, o - VREG0)) == v) {
                            f.hint.set(@int_cast(usize, o - VREG0), w);
                        }
                    }
                }
                let fresh = writes_reg(i, v) and real_use(f, i, v);
                replace_reg(i, v, w);
                if fresh and not at_exit[r] {
                    insert_after(b, i, store(f, t, w, c, slot));
                }
            }
            if (ck < cuts.len) and (cuts.get(ck) == i) {
                if pend >= 0 {
                    insert_before(b, i, reload(f, t, wreg[@int_cast(usize, pend)], c, slot));  // (not used before the next call)
                    pend = -1;
                }
                if at_exit[r] {
                    insert_before(b, i, store(f, t, wreg[r], c, slot));
                }
                seg = cut_seg.get(ck) + 1;
                ck += 1;
                let r2 = @int_cast(usize, find(&mut par, seg));
                if rocc[r2] {
                    if lbl {
                        insert_after(b, i, reload(f, t, wreg[r2], c, slot));
                    } else {
                        pend = @int_cast(i32, r2);
                    }
                }
            }
            i = next;
        }
        if pend >= 0 {
            insert_end(b, reload(f, t, wreg[@int_cast(usize, pend)], c, slot));
        }
    }
    // along the edges that are split points
    for pi in 0..nb {
        let pb = f.blocks.get(pi);
        let r = @int_cast(usize, find(&mut par, tail[pi]));
        let mut stored = false;
        for k in 0..pb.succs.len {
            let si = @int_cast(usize, pb.succs.get(k));
            let sb = f.blocks.get(si);
            if not bget(sb.live_in, x) or not edge_cut(f, g, allin[0..nb], memtail[0..nb], all_edges, pi, si) {
                continue;
            }
            if at_exit[r] and not stored {
                insert_end(pb, store(f, t, wreg[r], c, slot));  // (pb is simple: see rexit)
                stored = true;
            }
            let r2 = @int_cast(usize, find(&mut par, head[si]));
            if not rocc[r2] or (r2 == r) {
                continue;
            }
            let w2 = wreg[r2];
            if allin[si] and (g.npred[si] > 1) and not g.endok[si] {
                continue;  // (sload)
            }
            let mut ins = u.nil.[MInst]();
            if rocc[r] {
                ins = t.spill_move(f, w2, wreg[r], @as(i32, c));
                f.hint.set(@int_cast(usize, w2 - VREG0), wreg[r]);
            } else {
                ins = reload(f, t, w2, c, slot);
            }
            if g.npred[si] == 1 {
                insert_start(sb, ins);
            } else {
                insert_end(pb, ins);
            }
        }
    }
    // pieces without a hint of their own take the vreg's
    for s in 0..ns {
        if wreg[s] >= 0 {
            let wx = @int_cast(usize, wreg[s] - VREG0);
            if f.hint.get(wx) < 0 {
                f.hint.set(wx, f.hint.get(x));
            }
        }
    }
    u.free(@ptr_cast(*mut void, par.data));
    u.free(@ptr_cast(*mut void, occ.data));
    u.free(@ptr_cast(*mut void, rel.data));
    u.free(@ptr_cast(*mut void, defc.data));
    u.free(@ptr_cast(*mut void, cuts.data));
    u.free(@ptr_cast(*mut void, cut_seg.data));
    u.free(@ptr_cast(*mut void, cut_fq.data));
    u.free(@ptr_cast(*mut void, arr.data));
    u.free(@ptr_cast(*mut void, la.data));
    return true;
}

// Is r a vreg (of this round) spilled everywhere?
fn spilled_ev(sp: []bool, r: i32) bool {
    if not is_vreg(r) {
        return false;
    }
    let x = @int_cast(usize, r - VREG0);
    return (x < sp.len) and sp[x];
}

// Spills the vregs sp marks everywhere: each instruction reading one gets a
// load into a fresh (unspillable) vreg before it; each writing one, a store
// after it. A copy from one becomes a load into the copy's destination, a
// copy to one a store of the copy's source, and its own spill code goes.
fn spill_everywhere(f: *mut MFunc, t: *Target, sp: []bool) void {
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            if (i.spill != 0) and spilled_ev(sp, i.sreg) and (i.sslot == slot_of(f, @int_cast(usize, i.sreg - VREG0))) {
                remove(b, i);  // (it lives in that slot now)
                i = next;
                continue;
            }
            if i.is_move {
                let d = move_dst(i);
                let s = move_src(i);
                let ds = spilled_ev(sp, d);
                let ss = spilled_ev(sp, s);
                if ds and ss and (slot_of(f, @int_cast(usize, d - VREG0)) == slot_of(f, @int_cast(usize, s - VREG0))) {
                    remove(b, i);
                    i = next;
                    continue;
                }
                if ss and not ds and (d >= 0) {
                    let x = @int_cast(usize, s - VREG0);
                    insert_before(b, i, reload(f, t, d, f.vclass.get(x), slot_of(f, x)));
                    remove(b, i);
                    i = next;
                    continue;
                }
                if ds and not ss and (s >= 0) {
                    let x = @int_cast(usize, d - VREG0);
                    insert_before(b, i, store(f, t, s, f.vclass.get(x), slot_of(f, x)));
                    remove(b, i);
                    i = next;
                    continue;
                }
            }
            // distinct spilled vregs of this instruction
            let mut done: [8]i32 = [-1; 8];
            let mut nd: usize = 0;
            for k in 0..i.ops.len {
                let o = i.ops[k];
                let cands: [3]i32 = [o.reg, o.base, o.index];
                for ci in @as(usize, 0)..3 {
                    let r = cands[ci];
                    if (ci == 0) and (o.kind != K_REG) {
                        continue;
                    }
                    if (ci > 0) and (o.kind != K_MEM) {
                        continue;
                    }
                    if not spilled_ev(sp, r) {
                        continue;
                    }
                    let mut seen = false;
                    for j in 0..nd {
                        if done[j] == r {
                            seen = true;
                        }
                    }
                    if not seen and (nd < 8) {
                        done[nd] = r;
                        nd += 1;
                    }
                }
            }
            for j in 0..nd {
                let r = done[j];
                let x = @int_cast(usize, r - VREG0);
                let c = f.vclass.get(x);
                let slot = slot_of(f, x);
                let nr = new_vreg(f, c);
                f.nospill.set(@int_cast(usize, nr - VREG0), true);
                let mut reads = false;
                let mut writes = false;
                if (i.spill != 0) and (i.sreg == r) {
                    i.sreg = nr;
                }
                for k in 0..i.ops.len {
                    let o = &mut i.ops[k];
                    if (o.kind == K_REG) and (o.reg == r) {
                        o.reg = nr;
                        if (o.role & RU) != 0 {
                            reads = true;
                        }
                        if (o.role & RD) != 0 {
                            writes = true;
                        }
                    }
                    if o.kind == K_MEM {
                        if o.base == r {
                            o.base = nr;
                            reads = true;
                        }
                        if o.index == r {
                            o.index = nr;
                            reads = true;
                        }
                    }
                }
                if reads {
                    insert_before(b, i, reload(f, t, nr, c, slot));
                }
                if writes {
                    insert_after(b, i, store(f, t, nr, c, slot));
                }
            }
            i = next;
        }
    }
}

// Which spilled rematerialized values (slot -2) are read only in the block
// that defines them.
fn remat_locality(f: *MFunc, slot: []i32, local: []mut bool) void {
    let nv = local.len;
    let db = u.newn.[i32](nv + 1);
    for k in 0..nv {
        local[k] = slot[k] == -2;
        db[k] = -1;
    }
    for bi in 0..f.blocks.len {
        let mut i = f.blocks.get(bi).first;
        while u.notnil(i) {
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and (@int_cast(usize, o.reg - VREG0) < nv) and
                   local[@int_cast(usize, o.reg - VREG0)] and (f.remat.get(@int_cast(usize, o.reg - VREG0)) == i) {
                    db[@int_cast(usize, o.reg - VREG0)] = @int_cast(i32, bi);
                }
            }
            i = i.next;
        }
    }
    for bi in 0..f.blocks.len {
        let mut i = f.blocks.get(bi).first;
        while u.notnil(i) {
            for k in 0..i.ops.len {
                let o = i.ops[k];
                let cands: [3]i32 = [o.reg, o.base, o.index];
                for ci in @as(usize, 0)..3 {
                    let r = cands[ci];
                    if (ci == 0) and ((o.kind != K_REG) or ((o.role & RU) == 0)) {
                        continue;
                    }
                    if (ci > 0) and (o.kind != K_MEM) {
                        continue;
                    }
                    if not is_vreg(r) or (@int_cast(usize, r - VREG0) >= nv) {
                        continue;
                    }
                    let x = @int_cast(usize, r - VREG0);
                    if (slot[x] == -2) and (db[x] != @int_cast(i32, bi)) {
                        local[x] = false;
                    }
                }
            }
            i = i.next;
        }
    }
}

// Rewrites the spilled rematerialized vregs rm marks (see set_remat): no
// stack slot. One read only in the block defining it is built again at each
// use (or folded into it); one read elsewhere is built once in each block
// that reads it, as a value of its own (which may be rematerialized in turn).
fn spill_remat(f: *mut MFunc, t: *Target, rm: []bool) void {
    let nv = rm.len;
    let slot = u.newn.[i32](nv + 1);
    for k in 0..nv {
        slot[k] = -1;
        if rm[k] {
            slot[k] = -2;
        }
    }
    let local = u.newn.[bool](nv + 1);
    let bv = u.newn.[i32](nv + 1);  // the value's copy in block bb[x]
    let bb = u.newn.[i32](nv + 1);
    remat_locality(f, slot[0..nv], local[0..nv]);
    for k in 0..nv {
        bb[k] = -1;
    }
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            let mut done: [8]i32 = [-1; 8];
            let mut nd: usize = 0;
            for k in 0..i.ops.len {
                let o = i.ops[k];
                let cands: [3]i32 = [o.reg, o.base, o.index];
                for ci in @as(usize, 0)..3 {
                    let r = cands[ci];
                    if ((ci == 0) and (o.kind != K_REG)) or ((ci > 0) and (o.kind != K_MEM)) {
                        continue;
                    }
                    if not is_vreg(r) or (@int_cast(usize, r - VREG0) >= nv) or not rm[@int_cast(usize, r - VREG0)] {
                        continue;
                    }
                    let mut seen = false;
                    for j in 0..nd {
                        if done[j] == r {
                            seen = true;
                        }
                    }
                    if not seen and (nd < 8) {
                        done[nd] = r;
                        nd += 1;
                    }
                }
            }
            for j in 0..nd {
                let r = done[j];
                let x = @int_cast(usize, r - VREG0);
                let c = f.vclass.get(x);
                let def = f.remat.get(x);
                if i == def {
                    remove(b, i);
                    break;
                }
                if not local[x] {
                    let mut nr = bv[x];
                    if bb[x] != @int_cast(i32, bi) {
                        nr = new_vreg(f, c);
                        let cd = clone_def(def, r, nr);
                        insert_before(b, i, cd);
                        set_remat(f, nr, cd);
                        bv[x] = nr;
                        bb[x] = @int_cast(i32, bi);
                    }
                    replace_reg(i, r, nr);
                    continue;
                }
                if t.fold_remat(f, i, r, def) {
                    continue;
                }
                let nr = new_vreg(f, c);
                f.nospill.set(@int_cast(usize, nr - VREG0), true);
                replace_reg(i, r, nr);
                let ld = clone_def(def, r, nr);
                ld.spill = 1;
                ld.sreg = nr;
                ld.sslot = -2 - @int_cast(i32, x);  // (a slot of its own: drop_reloads drops repeats)
                insert_before(b, i, ld);
            }
            i = next;
        }
    }
}

// Rewrites the spilled vregs: split (see above), spilled everywhere, or
// rematerialized.
fn rewrite_spills(f: *mut MFunc, t: *Target, iv: []mut Interval) void {
    let nv = iv.len;
    let nb = f.blocks.len;
    let g = Cfg.{ npred: u.newn.[i32](nb + 1), nsucc: u.newn.[i32](nb + 1), simple: u.newn.[bool](nb + 1),
                  endok: u.newn.[bool](nb + 1) };
    for bi in 0..nb {
        g.npred[bi] = 0;
        // simple: no labels, and nothing but jumps after the first jump
        let b = f.blocks.get(bi);
        let mut ok = true;
        let mut jumped = false;
        let mut i = b.first;
        while u.notnil(i) {
            if t.is_label(i) {
                ok = false;
            }
            if is_jump(i) {
                jumped = true;
            } else if jumped {
                ok = false;
            }
            i = i.next;
        }
        g.simple[bi] = ok;
    }
    for bi in 0..nb {
        g.endok[bi] = true;
    }
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        for k in 0..b.succs.len {
            if (b.succs.len != 1) or not g.simple[bi] {
                g.endok[@int_cast(usize, b.succs.get(k))] = false;
            }
        }
    }
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        g.nsucc[bi] = @int_cast(i32, b.succs.len);
        for k in 0..b.succs.len {
            g.npred[@int_cast(usize, b.succs.get(k))] += 1;
        }
    }
    let every = u.newn.[bool](nv + 1);
    let rm = u.newn.[bool](nv + 1);
    for k in 0..nv {
        every[k] = false;
        rm[k] = false;
        if not iv[k].spilled {
            continue;
        }
        if u.notnil(f.remat.get(k)) {
            rm[k] = true;
            continue;
        }
        let lv = f.level.get(k);
        let mut done = false;
        if lv == 0 {
            done = split(f, t, &g, k, false, 1);
        }
        if not done and (lv <= 1) {
            done = split(f, t, &g, k, true, 2);
        }
        every[k] = not done;
    }
    spill_everywhere(f, t, every[0..nv]);
    spill_remat(f, t, rm[0..nv]);
}

// Reloads of values nothing reads (splitting leaves them behind) are
// deleted. (They read no vreg, so liveness stays as it is.)
fn drop_dead_reloads(f: *mut MFunc) void {
    let nv = nvregs(f);
    let w = words(nv);
    let live = u.newn.[u64](w + 1);
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        for j in 0..w {
            live[j] = b.live_out[j];
        }
        let mut i = b.last;
        while u.notnil(i) {
            let prev = i.prev;
            if (i.spill == 1) and is_vreg(i.sreg) and not bget(live, @int_cast(usize, i.sreg - VREG0)) {
                remove(b, i);
                i = prev;
                continue;
            }
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RD) != 0) and ((o.role & RU) == 0) {
                    bclr(live, @int_cast(usize, o.reg - VREG0));
                }
            }
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RU) != 0) {
                    bset(live, @int_cast(usize, o.reg - VREG0));
                }
                if o.kind == K_MEM {
                    if is_vreg(o.base) {
                        bset(live, @int_cast(usize, o.base - VREG0));
                    }
                    if is_vreg(o.index) {
                        bset(live, @int_cast(usize, o.index - VREG0));
                    }
                }
            }
            i = prev;
        }
    }
}

// -----------------------------------------------------------------------------
// Coalescing (before allocation): the two sides of a copy between virtual
// registers of a class become one register, and the copy goes, where their
// lives do not overlap, or where they are the same value (the copy is the
// destination's only definition, the source has one, and the destination
// is not live where the source is defined). Hottest copies first. Linear
// scan's hints alone depend on the order intervals start in; pieces split
// apart later are copies again.
// -----------------------------------------------------------------------------
struct CopyAt {
    i: *mut MInst,
    fq: f64,
}

fn hotter(a: CopyAt, b: CopyAt) i32 {
    if a.fq > b.fq {
        return -1;
    }
    if a.fq < b.fq {
        return 1;
    }
    return 0;
}

fn ranges_meet(a: *u.List.[Range], b: *u.List.[Range]) bool {
    let mut i: usize = 0;
    let mut j: usize = 0;
    while (i < a.len) and (j < b.len) {
        let x = a.get(i);
        let y = b.get(j);
        if x.e < y.s {
            i += 1;
        } else if y.e < x.s {
            j += 1;
        } else {
            return true;
        }
    }
    return false;
}

fn ranges_cover(a: *u.List.[Range], p: i32) bool {
    for k in 0..a.len {
        let x = a.get(k);
        if (x.s <= p) and (p <= x.e) {
            return true;
        }
    }
    return false;
}

// a's ranges and b's, merged (sorted, adjacent and overlapping ones joined)
fn ranges_union(a: *u.List.[Range], b: *u.List.[Range]) u.List.[Range] {
    let mut out = u.List.[Range].{ data: u.nil.[Range](), len: 0, cap: 0 };
    let mut i: usize = 0;
    let mut j: usize = 0;
    while (i < a.len) or (j < b.len) {
        let mut r = Range.{ s: 0, e: 0 };
        if (j >= b.len) or ((i < a.len) and (a.get(i).s <= b.get(j).s)) {
            r = a.get(i);
            i += 1;
        } else {
            r = b.get(j);
            j += 1;
        }
        if (out.len > 0) and (r.s <= (out.get(out.len - 1).e + 1)) {
            let l = out.at(out.len - 1);
            if r.e > l.e {
                l.e = r.e;
            }
        } else {
            out.push(r);
        }
    }
    return out;
}

fn rep_of(rep: []mut i32, x: i32) i32 {
    let mut r = x;
    while rep[@int_cast(usize, r)] != r {
        r = rep[@int_cast(usize, r)];
    }
    let mut y = x;
    while rep[@int_cast(usize, y)] != r {
        let n = rep[@int_cast(usize, y)];
        rep[@int_cast(usize, y)] = r;
        y = n;
    }
    return r;
}

fn coalesce(f: *mut MFunc) void {
    liveness(f);
    number(f);
    let iv = build_intervals(f);
    let nv = iv.len;
    let rep = u.newn.[i32](nv + 1);
    let ndef = u.newn.[i32](nv + 1);
    let dpos = u.newn.[i32](nv + 1);  // (a definition's position)
    // every definition's position, of the registers defined more than once
    let defs = u.newn.[u.List.[i32]](nv + 1);
    for k in 0..nv {
        rep[k] = @int_cast(i32, k);
        ndef[k] = 0;
        dpos[k] = -1;
        defs[k] = u.List.[i32].{ data: u.nil.[i32](), len: 0, cap: 0 };
    }
    let mut copies = u.List.[CopyAt].{ data: u.nil.[CopyAt](), len: 0, cap: 0 };
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        let mut i = b.first;
        while u.notnil(i) {
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RD) != 0) {
                    let x = @int_cast(usize, o.reg - VREG0);
                    if dpos[x] != i.pos {
                        ndef[x] += 1;
                        defs[x].push(i.pos);
                    }
                    dpos[x] = i.pos;
                }
            }
            if i.is_move {
                let d = move_dst(i);
                let sr = move_src(i);
                if is_vreg(d) and is_vreg(sr) and (d != sr) and
                   (f.vclass.get(@int_cast(usize, d - VREG0)) == f.vclass.get(@int_cast(usize, sr - VREG0))) {
                    copies.push(CopyAt.{ i: i, fq: b.freq });
                }
            }
            i = i.next;
        }
    }
    u.sort(copies.items(), hotter);
    let mut merged = false;
    for ci in 0..copies.len {
        let i = copies.get(ci).i;
        let a = rep_of(rep, move_src(i) - VREG0);
        let b = rep_of(rep, move_dst(i) - VREG0);
        if a == b {
            continue;
        }
        let ax = @int_cast(usize, a);
        let bx = @int_cast(usize, b);
        if f.nospill.get(ax) or f.nospill.get(bx) {
            continue;
        }
        let mut ok = not ranges_meet(&iv[ax].ranges, &iv[bx].ranges);
        if not ok and (ndef[bx] == 1) and (dpos[bx] == i.pos) {
            // the same value while b lives: no definition of a (one, or
            // several: a phi's) where b is live
            ok = true;
            for k in 0..defs[ax].len {
                if ranges_cover(&iv[bx].ranges, (2 * defs[ax].get(k)) + 1) {
                    ok = false;
                }
            }
        }
        if not ok {
            continue;
        }
        // b joins a; the copy defined b
        if debug_ra {
            u.eprint(u.f4("merge v%s v%s (%s %s)\n", u.idec(a), u.idec(b), u.idec(iv[ax].size), u.idec(iv[bx].size)));
        }
        let un = ranges_union(&iv[ax].ranges, &iv[bx].ranges);
        u.free(@ptr_cast(*mut void, iv[ax].ranges.data));
        u.free(@ptr_cast(*mut void, iv[bx].ranges.data));
        iv[ax].ranges = un;
        iv[bx].ranges = u.List.[Range].{ data: u.nil.[Range](), len: 0, cap: 0 };
        let nd = (ndef[ax] + ndef[bx]) - 1;
        let mut rm = u.nil.[MInst]();
        if (nd == 1) and (ndef[ax] == 1) {
            rm = f.remat.get(ax);
        } else if (nd == 1) and (ndef[bx] == 2) {
            rm = f.remat.get(bx);  // (the other definition)
            dpos[ax] = -1;
            if u.notnil(rm) {
                dpos[ax] = rm.pos;
            }
        }
        f.remat.set(ax, rm);
        ndef[ax] = nd;
        for k in 0..defs[bx].len {
            if defs[bx].get(k) != i.pos {
                defs[ax].push(defs[bx].get(k));
            }
        }
        if (f.hint.get(ax) < 0) or (is_vreg(f.hint.get(ax)) and not is_vreg(f.hint.get(bx)) and (f.hint.get(bx) >= 0)) {
            f.hint.set(ax, f.hint.get(bx));
        }
        rep[bx] = a;
        merged = true;
    }
    if merged {
        for bi in 0..f.blocks.len {
            let b = f.blocks.get(bi);
            let mut i = b.first;
            while u.notnil(i) {
                let next = i.next;
                for k in 0..i.ops.len {
                    let o = &mut i.ops[k];
                    if (o.kind == K_REG) and is_vreg(o.reg) {
                        o.reg = VREG0 + rep_of(rep, o.reg - VREG0);
                    }
                    if o.kind == K_MEM {
                        if is_vreg(o.base) {
                            o.base = VREG0 + rep_of(rep, o.base - VREG0);
                        }
                        if is_vreg(o.index) {
                            o.index = VREG0 + rep_of(rep, o.index - VREG0);
                        }
                    }
                }
                if i.is_move and (move_dst(i) == move_src(i)) {
                    remove(b, i);
                }
                i = next;
            }
        }
        // hints naming a merged register name its representative
        for k in 0..nv {
            let h = f.hint.get(k);
            if is_vreg(h) and (@int_cast(usize, h - VREG0) < nv) {
                let r = VREG0 + rep_of(rep, h - VREG0);
                if r == (VREG0 + @int_cast(i32, k)) {
                    f.hint.set(k, -1);
                } else {
                    f.hint.set(k, r);
                }
            }
        }
    }
    for k in 0..nv {
        u.free(@ptr_cast(*mut void, iv[k].ranges.data));
        u.free(@ptr_cast(*mut void, defs[k].data));
    }
    u.free(@ptr_cast(*mut void, copies.data));
}

// Allocates registers; afterwards f.assign maps every vreg to a physical
// register.
pub fn allocate(f: *mut MFunc, t: *Target) void {
    let mut rounds: i32 = 0;
    block_freqs(f);
    coalesce(f);
    loop {
        liveness(f);
        drop_dead_reloads(f);
        number(f);
        build_fixed(f);
        let iv = build_intervals(f);
        if debug_ra {
            for k in 0..iv.len {
                let x = &iv[k];
                if x.e >= 0 {
                    u.eprint(u.f6("v%s c%s l%s s%s w%s [%s", u.zdec(k), u.idec(@as(i32, f.vclass.get(k))),
                                  u.idec(@as(i32, f.level.get(k))), u.idec(x.size),
                                  u.dec(@int_from_float(i64, weight(f, x) * 1000000.0)), u.idec(x.s)));
                    u.eprint(u.f2(",%s] h%s\n", u.idec(x.e), u.idec(f.hint.get(k))));
                }
            }
        }
        let ns = greedy(f, t, iv);
        if debug_ra {
            u.eprint(u.f1("round %s\n", u.idec(rounds)));
        }
        rounds += 1;
        if ns == 0 {
            let nv = iv.len;
            f.assign = u.newn.[i32](nv + 1);
            f.used_regs = 0;
            for k in 0..nv {
                f.assign[k] = iv[k].reg;
                if iv[k].reg >= 0 {
                    f.used_regs = f.used_regs | (@as(u64, 1) << @int_cast(u32, iv[k].reg));
                }
            }
            return;
        }
        if rounds > 40 {
            u.die("internal compiler error: register allocation did not converge");
        }
        rewrite_spills(f, t, iv);
    }
}

// The physical register for r (a vreg after allocation, or physical).
pub fn phys(f: *MFunc, r: i32) i32 {
    if is_vreg(r) {
        return f.assign[@int_cast(usize, r - VREG0)];
    }
    return r;
}

// -----------------------------------------------------------------------------
// Dead instructions: `pure` instructions (no effect but their register
// results, no flags anything reads) whose virtual register results are never
// read are deleted, repeatedly (address arithmetic folded into memory
// operands leaves such chains behind).
// -----------------------------------------------------------------------------
fn reads_of(i: *MInst, v: i32) i32 {
    let mut n: i32 = 0;
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and (o.reg == v) and ((o.role & RU) != 0) {
            n += 1;
        }
        if o.kind == K_MEM {
            if o.base == v {
                n += 1;
            }
            if o.index == v {
                n += 1;
            }
        }
    }
    return n;
}

fn count_reads(i: *MInst, cnt: []mut i32, delta: i32) void {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RU) != 0) {
            cnt[@int_cast(usize, o.reg - VREG0)] += delta;
        }
        if o.kind == K_MEM {
            if is_vreg(o.base) {
                cnt[@int_cast(usize, o.base - VREG0)] += delta;
            }
            if is_vreg(o.index) {
                cnt[@int_cast(usize, o.index - VREG0)] += delta;
            }
        }
    }
}

fn dead(i: *MInst, cnt: []mut i32) bool {
    let mut defs: i32 = 0;
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and ((o.role & RD) != 0) {
            if not is_vreg(o.reg) {
                return false;  // a physical register (an argument, say)
            }
            if (cnt[@int_cast(usize, o.reg - VREG0)] - reads_of(i, o.reg)) != 0 {
                return false;
            }
            defs += 1;
        }
    }
    return defs > 0;
}

pub fn dce(f: *mut MFunc, pure: fn(*MInst) bool) void {
    let cnt = u.newn.[i32](nvregs(f) + 1);
    for bi in 0..f.blocks.len {
        let mut i = f.blocks.get(bi).first;
        while u.notnil(i) {
            count_reads(i, cnt, 1);
            i = i.next;
        }
    }
    let mut changed = true;
    while changed {
        changed = false;
        for bi in 0..f.blocks.len {
            let b = f.blocks.get(bi);
            let mut i = b.last;
            while u.notnil(i) {
                let prev = i.prev;
                if pure(i) and dead(i, cnt) {
                    count_reads(i, cnt, -1);
                    remove(b, i);
                    changed = true;
                }
                i = prev;
            }
        }
    }
}

// -----------------------------------------------------------------------------
// After allocation: a reload into a register that already holds the slot's
// value (stored or reloaded earlier in the block, the register unchanged
// since) is dropped, and so is a store of a value the slot already holds.
// Spill slots are private to the spill code, so only register writes (and
// calls' clobbers) end what a register holds.
// -----------------------------------------------------------------------------
pub fn drop_reloads(f: *mut MFunc, is_label: fn(*MInst) bool) void {
    let holds = u.newn.[i32](64);  // physical register -> spill slot (when its bit is in `live`)
    let mut pend = u.List.[*mut MInst].{ data: u.nil.[*mut MInst](), len: 0, cap: 0 };  // stores not read yet
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        let mut live: u64 = 0;
        pend.clear();
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            if is_label(i) {
                live = 0;  // (reached by jumps too: nothing known)
                i = next;
                continue;
            }
            if i.spill != 0 {
                let r = phys(f, i.sreg);
                let bit = @as(u64, 1) << @int_cast(u32, r);
                if ((live & bit) != 0) and (holds[@int_cast(usize, r)] == i.sslot) {
                    remove(b, i);  // the register (or the slot) has it already
                    i = next;
                    continue;
                }
                if i.spill == 2 {
                    let mut m = live;
                    while m != 0 {
                        let q = @int_cast(usize, @ctz(m));
                        m = m & (m - 1);
                        if holds[q] == i.sslot {
                            live = live & ~(@as(u64, 1) << @int_cast(u32, q));
                        }
                    }
                    // an earlier store to the slot nothing read is dead
                    let mut k: usize = 0;
                    while k < pend.len {
                        if pend.get(k).sslot == i.sslot {
                            remove(b, pend.get(k));
                            pend.set(k, pend.get(pend.len - 1));
                            pend.len -= 1;
                        } else {
                            k += 1;
                        }
                    }
                    pend.push(i);
                } else {
                    let mut k: usize = 0;
                    while k < pend.len {
                        if pend.get(k).sslot == i.sslot {
                            pend.set(k, pend.get(pend.len - 1));
                            pend.len -= 1;
                        } else {
                            k += 1;
                        }
                    }
                }
                holds[@int_cast(usize, r)] = i.sslot;
                live = live | bit;
                i = next;
                continue;
            }
            live = live & ~i.clobber;
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and ((o.role & (RD | RE)) != 0) {
                    let p = phys(f, o.reg);
                    if (p >= 0) and (p < 64) {
                        live = live & ~(@as(u64, 1) << @int_cast(u32, p));
                    }
                }
                if o.kind == K_LABEL {
                    pend.clear();  // (a jump: the slot may be read there)
                }
            }
            i = next;
        }
    }
    u.free(@ptr_cast(*mut void, pend.data));
}
