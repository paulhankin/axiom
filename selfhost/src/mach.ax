// =============================================================================
// mach.ax - machine IR shared by the native backends (x64.ax, a64.ax), and
// register allocation.
//
// A machine instruction has target-defined opcode and operands; each
// register operand says whether it is read, written or both. Registers
// below VREG0 are physical (target numbering), the rest virtual.
//
// Register allocation works on live intervals (one interval per virtual
// register: the positions where it is live, with holes; positions are 2i for
// instruction i's reads and 2i+1 for its writes), after copies between them
// are coalesced. Physical registers used explicitly (argument and result
// registers, division, shifts) and registers clobbered by calls are fixed
// ranges an interval must avoid. Intervals are assigned greedily, largest
// first; one that finds no free register takes one from intervals of lower
// spill weight (uses, weighted by the estimated frequency of their blocks,
// per position covered), which are queued again, or else it is spilled: it
// is split (see split): it goes to a stack slot across
// the calls it is live over and along loop boundaries, and each stretch in
// between becomes a new vreg; pieces that lose again are split between the
// stretches of code that use them (where uses are far apart), then at every
// block boundary, and those are finally spilled everywhere, their uses and
// definitions rewritten through short-lived registers (which never spill).
// A value that is rebuilt rather than stored (set_remat: a stack argument,
// a constant) is split the same way, its pieces built again where they are
// entered, and at last built again where it is read (or read from memory
// there). Allocation runs again after each rewrite.
// =============================================================================
import "util.ax" as u;

pub const VREG0: i32 = 64;

// operand kinds
pub const K_NONE: u8 = 0;
pub const K_REG: u8 = 1;
pub const K_IMM: u8 = 2;
pub const K_MEM: u8 = 3;    // [base + index*scale + disp], or [slot + disp], or [sym + disp] (pc-relative)
pub const K_SYM: u8 = 4;    // a symbol (call target, address)
pub const K_LABEL: u8 = 5;  // block / local label

// roles of register operands
pub const RU: u8 = 1;  // read
pub const RD: u8 = 2;  // written
pub const RUD: u8 = 3;
pub const RE: u8 = 4;  // written before all reads are done (early clobber)

pub struct MOp {
    kind: u8,
    role: u8,
    reg: i32,
    base: i32,
    index: i32,
    scale: u8,
    disp: i64,
    sym: i32,
    slot: i32,
    label: i32,
}

pub struct MInst {
    op: i32,
    sz: u8,
    cc: i32,
    ops: []mut MOp,
    clobber: u64,   // physical registers clobbered (calls)
    is_move: bool,  // register copy (for coalescing hints)
    next: *mut MInst,
    prev: *mut MInst,
    pos: i32,
    aux: i64,
    spill: i32,  // 1: a reload, 2: a spill store (of `sreg`, slot `sslot`)
    sreg: i32,
    sslot: i32,
    src: u32,    // the source location of the IR it was made for (ir.src_loc), 0: not known
    keep: bool,  // a copy coalescing leaves (see shrink_wrap)
}

// The source location new instructions get: instruction selection sets it
// to each IR instruction's.
pub let mut cur_src: u32 = 0;

pub struct MBlock {
    id: i32,
    first: *mut MInst,
    last: *mut MInst,
    succs: u.List.[i32],
    preds: u.List.[i32],
    loop_depth: i32,
    cold: bool,     // ends in a trap (set by the target)
    freq: f64,      // estimated runs per call (block_freqs)
    unlikely: i32,  // 1 + the successor predicted not taken (opt.unlikely_succ), 0: none
    live_in: []mut u64,
    live_out: []mut u64,
    start: i32,
    end: i32,
    offset: u64,    // encoder: code offset
    noframe: bool,  // runs before the frame is set up (see shrink_wrap)
}

pub struct Slot {
    size: u64,
    align: u64,
    offset: i64,  // assigned by the target's frame layout
}

pub struct Target {
    nclasses: i32,
    alloc_order: [4][]i32,  // allocatable registers per class, in preference order (classes that
                            // share registers, as x86-64's 128-, 256- and 512-bit vectors do, may
                            // list the same ones)
    caller_saved: u64,
    // spill code: load/store of register r (class c) from/to a slot
    spill_load: fn(*mut MFunc, i32, i32, i32) *mut MInst,
    spill_store: fn(*mut MFunc, i32, i32, i32) *mut MInst,
    // a copy of register s to d (class c), marked is_move
    spill_move: fn(*mut MFunc, i32, i32, i32) *mut MInst,
    // a label within a block (the target of jumps from within the block)
    is_label: fn(*MInst) bool,
    // a rematerialized value read from memory instead (see set_remat):
    // makes instruction i read vreg r's value straight from where its
    // definition `def` loads it, if it can
    fold_remat: fn(*mut MFunc, *mut MInst, i32, *MInst) bool,
}

pub struct MFunc {
    blocks: u.List.[*mut MBlock],
    vclass: u.List.[u8],  // class of each virtual register (index: vreg - VREG0)
    nospill: u.List.[bool],
    remat: u.List.[*mut MInst],  // the definition of a vreg rematerialized when spilled (nil: none)
    hint: u.List.[i32],
    slots: u.List.[Slot],
    assign: []mut i32,  // after allocation: vreg - VREG0 -> physical register
    used_regs: u64,     // physical registers used (for callee-saved saves)
    ninst: i32,
    has_calls: bool,
    level: u.List.[u8],   // how far each vreg has been split (see split)
    vslot: u.List.[i32],  // its spill slot, shared by the pieces of a split vreg (-1: none yet)
    noframe_regs: u64,    // registers the noframe blocks must not use (shrink_wrap)
}

pub fn new_func() *mut MFunc {
    return u.new.[MFunc]();
}

pub fn new_vreg(f: *mut MFunc, class: u8) i32 {
    f.vclass.push(class);
    f.nospill.push(false);
    f.remat.push(u.nil.[MInst]());
    f.hint.push(-1);
    f.level.push(0);
    f.vslot.push(-1);
    return VREG0 + @int_cast(i32, f.vclass.len - 1);
}

// Register r is a good choice for vreg v (the first hint stands).
pub fn hint(f: *mut MFunc, v: i32, r: i32) void {
    if is_vreg(v) {
        let k = @int_cast(usize, v - VREG0);
        if f.hint.get(k) < 0 {
            f.hint.set(k, r);
        }
    }
}

// Vreg r is defined once, by instruction def, which reads no register
// (a constant from memory, or one computed from nothing). When r would be
// spilled, the definition is repeated (or folded) at each use instead:
// no stack slot, no stores.
pub fn set_remat(f: *mut MFunc, r: i32, def: *mut MInst) void {
    f.remat.set(@int_cast(usize, r - VREG0), def);
}

pub fn remat_def(f: *MFunc, r: i32) *mut MInst {
    if not is_vreg(r) {
        return u.nil.[MInst]();
    }
    return f.remat.get(@int_cast(usize, r - VREG0));
}

// A copy of definition `def` writing nr instead of r.
pub fn clone_def(def: *MInst, r: i32, nr: i32) *mut MInst {
    let c = new_inst(def.op, def.sz, def.ops);
    c.cc = def.cc;
    c.aux = def.aux;
    c.src = def.src;
    for k in 0..c.ops.len {
        if (c.ops[k].kind == K_REG) and (c.ops[k].reg == r) {
            c.ops[k].reg = nr;
        }
    }
    return c;
}

pub fn nvregs(f: *MFunc) usize {
    return f.vclass.len;
}

pub fn new_slot(f: *mut MFunc, size: u64, align: u64) i32 {
    f.slots.push(Slot.{ size: size, align: align, offset: 0 });
    return @int_cast(i32, f.slots.len - 1);
}

pub fn new_block(f: *mut MFunc) *mut MBlock {
    let b = u.new.[MBlock]();
    b.id = @int_cast(i32, f.blocks.len);
    f.blocks.push(b);
    return b;
}

pub fn is_vreg(r: i32) bool {
    return r >= VREG0;
}

// Operand constructors
pub fn reg(r: i32, role: u8) MOp {
    return MOp.{ kind: K_REG, role: role, reg: r, base: -1, index: -1, scale: 0, disp: 0, sym: -1, slot: -1,
                 label: -1 };
}

pub fn imm(x: i64) MOp {
    return MOp.{ kind: K_IMM, role: 0, reg: -1, base: -1, index: -1, scale: 0, disp: x, sym: -1, slot: -1, label: -1 };
}

pub fn mem(base: i32, index: i32, scale: u8, disp: i64) MOp {
    return MOp.{ kind: K_MEM, role: 0, reg: -1, base: base, index: index, scale: scale, disp: disp, sym: -1, slot: -1,
                 label: -1 };
}

pub fn mem_slot(slot: i32, disp: i64) MOp {
    return MOp.{ kind: K_MEM, role: 0, reg: -1, base: -1, index: -1, scale: 0, disp: disp, sym: -1, slot: slot,
                 label: -1 };
}

pub fn mem_sym(sym: i32, disp: i64) MOp {
    return MOp.{ kind: K_MEM, role: 0, reg: -1, base: -1, index: -1, scale: 0, disp: disp, sym: sym, slot: -1,
                 label: -1 };
}

pub fn symop(sym: i32, disp: i64) MOp {
    return MOp.{ kind: K_SYM, role: 0, reg: -1, base: -1, index: -1, scale: 0, disp: disp, sym: sym, slot: -1,
                 label: -1 };
}

pub fn label(l: i32) MOp {
    return MOp.{ kind: K_LABEL, role: 0, reg: -1, base: -1, index: -1, scale: 0, disp: 0, sym: -1, slot: -1, label: l };
}

pub fn none() MOp {
    return MOp.{ kind: K_NONE, role: 0, reg: -1, base: -1, index: -1, scale: 0, disp: 0, sym: -1, slot: -1, label: -1 };
}

pub fn new_inst(op: i32, sz: u8, ops: []MOp) *mut MInst {
    let i = u.new.[MInst]();
    i.op = op;
    i.sz = sz;
    i.src = cur_src;
    let o = u.newn.[MOp](ops.len + 1);
    for k in 0..ops.len {
        o[k] = ops[k];
    }
    i.ops = o[0..ops.len];
    return i;
}

pub fn append(b: *mut MBlock, i: *mut MInst) void {
    i.prev = b.last;
    i.next = u.nil.[MInst]();
    if u.notnil(b.last) {
        b.last.next = i;
    } else {
        b.first = i;
    }
    b.last = i;
}

pub fn insert_before(b: *mut MBlock, pos: *mut MInst, i: *mut MInst) void {
    i.next = pos;
    i.prev = pos.prev;
    if u.notnil(pos.prev) {
        pos.prev.next = i;
    } else {
        b.first = i;
    }
    pos.prev = i;
}

pub fn insert_after(b: *mut MBlock, pos: *mut MInst, i: *mut MInst) void {
    i.prev = pos;
    i.next = pos.next;
    if u.notnil(pos.next) {
        pos.next.prev = i;
    } else {
        b.last = i;
    }
    pos.next = i;
}

pub fn remove(b: *mut MBlock, i: *mut MInst) void {
    if u.notnil(i.prev) {
        i.prev.next = i.next;
    } else {
        b.first = i.next;
    }
    if u.notnil(i.next) {
        i.next.prev = i.prev;
    } else {
        b.last = i.prev;
    }
}

// -----------------------------------------------------------------------------
// Liveness
// -----------------------------------------------------------------------------
fn words(n: usize) usize {
    return (n + 63) / 64;
}

fn bset(s: []mut u64, i: usize) void {
    s[i / 64] = s[i / 64] | (@as(u64, 1) << @int_cast(u32, i % 64));
}

fn bclr(s: []mut u64, i: usize) void {
    s[i / 64] = s[i / 64] & ~(@as(u64, 1) << @int_cast(u32, i % 64));
}

fn bget(s: []u64, i: usize) bool {
    return (s[i / 64] & (@as(u64, 1) << @int_cast(u32, i % 64))) != 0;
}

// Calls fn(reg, role) for every register operand of i (memory bases and
// indexes are reads).
fn each_reg_use(i: *MInst, v: i32) bool {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and (o.reg == v) and ((o.role & RU) != 0) {
            return true;
        }
        if (o.kind == K_MEM) and ((o.base == v) or (o.index == v)) {
            return true;
        }
    }
    return false;
}

fn number(f: *mut MFunc) void {
    let mut n: i32 = 0;
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        b.start = 2 * n;
        let mut i = b.first;
        while u.notnil(i) {
            i.pos = n;
            n += 1;
            i = i.next;
        }
        b.end = (2 * n) - 1;
        if b.end < b.start {
            b.end = b.start;
        }
    }
    f.ninst = n;
}

fn liveness(f: *mut MFunc) void {
    let nv = nvregs(f);
    let w = words(nv);
    let nb = f.blocks.len;
    let use_s = u.newn.[[]mut u64](nb + 1);
    let def_s = u.newn.[[]mut u64](nb + 1);
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        use_s[bi] = u.newn.[u64](w + 1);
        def_s[bi] = u.newn.[u64](w + 1);
        b.live_in = u.newn.[u64](w + 1);
        b.live_out = u.newn.[u64](w + 1);
        let mut i = b.first;
        while u.notnil(i) {
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if o.kind == K_REG {
                    if is_vreg(o.reg) and ((o.role & RU) != 0) {
                        let x = @int_cast(usize, o.reg - VREG0);
                        if not bget(def_s[bi], x) {
                            bset(use_s[bi], x);
                        }
                    }
                } else if o.kind == K_MEM {
                    if is_vreg(o.base) {
                        let x = @int_cast(usize, o.base - VREG0);
                        if not bget(def_s[bi], x) {
                            bset(use_s[bi], x);
                        }
                    }
                    if is_vreg(o.index) {
                        let x = @int_cast(usize, o.index - VREG0);
                        if not bget(def_s[bi], x) {
                            bset(use_s[bi], x);
                        }
                    }
                }
            }
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RD) != 0) {
                    bset(def_s[bi], @int_cast(usize, o.reg - VREG0));
                }
            }
            i = i.next;
        }
    }
    // to the fixed point (the least, whatever the order): a block again
    // when what a successor needs grew
    let npred = u.newn.[i32](nb + 1);
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        for k in 0..b.succs.len {
            npred[@int_cast(usize, b.succs.get(k))] += 1;
        }
    }
    let pstart = u.newn.[i32](nb + 2);
    for bi in 0..nb {
        pstart[bi + 1] = pstart[bi] + npred[bi];
    }
    let preds = u.newn.[i32](@int_cast(usize, pstart[nb]) + 1);
    let pfill = u.newn.[i32](nb + 1);
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        for k in 0..b.succs.len {
            let si = @int_cast(usize, b.succs.get(k));
            preds[@int_cast(usize, pstart[si] + pfill[si])] = @int_cast(i32, bi);
            pfill[si] += 1;
        }
    }
    let queued = u.newn.[bool](nb + 1);
    let mut work = u.List.[i32].empty();
    for bi in 0..nb {
        work.push(@int_cast(i32, bi));  // (the last block first)
        queued[bi] = true;
    }
    while work.len > 0 {
        let bi = @int_cast(usize, work.pop());
        queued[bi] = false;
        let b = f.blocks.get(bi);
        // out = union of successors' in
        let lo = b.live_out;
        for k in 0..b.succs.len {
            let si = f.blocks.get(@int_cast(usize, b.succs.get(k))).live_in;
            for j in 0..w {
                lo[j] = lo[j] | si[j];
            }
        }
        let li = b.live_in;
        let us = use_s[bi];
        let ds = def_s[bi];
        let mut changed = false;
        for j in 0..w {
            let nin = us[j] | (lo[j] & ~ds[j]);
            if nin != li[j] {
                li[j] = nin;
                changed = true;
            }
        }
        if changed {
            for k in @int_cast(usize, pstart[bi])..@int_cast(usize, pstart[bi + 1]) {
                let pi = @int_cast(usize, preds[k]);
                if not queued[pi] {
                    queued[pi] = true;
                    work.push(@int_cast(i32, pi));
                }
            }
        }
    }
    work.deinit();
}

// -----------------------------------------------------------------------------
// Block frequencies (estimated statically: how often each block runs per call
// of the function). Branches split evenly, except that blocks leading only to
// a trap (cold) are rarely taken, loops are rarely left, and a successor the
// layout predicts not taken (MBlock.unlikely) is taken a third of the time;
// a loop runs its body LOOP_SCALE times per entry. Loops are found on the machine CFG (back
// edges of a depth-first search, natural loop bodies) and handled innermost
// first: each one's iteration (header 1) is computed with the loops inside it
// collapsed to their headers, whose exits it reaches in proportion.
// -----------------------------------------------------------------------------
pub const LOOP_SCALE: f64 = 10.0;
const COLD_WEIGHT: f64 = 0.001;
const EXIT_WEIGHT: f64 = 0.125;
pub const UNLIKELY_WEIGHT: f64 = 0.5;

struct Loop {
    head: i32,
    blocks: []mut u64,  // bitset
    size: i32,
    parent: i32,
    fin: f64,  // entries per call of the function
}

fn in_loop(l: *Loop, b: i32) bool {
    return bget(l.blocks, @int_cast(usize, b));
}

// The probability of each edge out of b (in b.succs order) into pr.
fn edge_probs(f: *MFunc, cold: []bool, inner: []i32, loops: *u.List.[Loop], b: usize, pr: *mut u.List.[f64]) void {
    pr.clear();
    let blk = f.blocks.get(b);
    let mut tot: f64 = 0.0;
    let li = inner[b];
    for k in 0..blk.succs.len {
        let s = @int_cast(usize, blk.succs.get(k));
        let mut w: f64 = 1.0;
        if cold[s] and not cold[b] {
            w = COLD_WEIGHT;
        } else if (li >= 0) and not in_loop(loops.at(@int_cast(usize, li)), @int_cast(i32, s)) {
            w = EXIT_WEIGHT;
        } else if blk.unlikely == @int_cast(i32, s) + 1 {
            w = UNLIKELY_WEIGHT;
        }
        pr.push(w);
        tot += w;
    }
    for k in 0..pr.len {
        pr.set(k, pr.get(k) / tot);
    }
}

pub fn block_freqs(f: *mut MFunc) void {
    let nb = f.blocks.len;
    if nb == 0 {
        return;
    }
    let w = words(nb);
    // depth-first search: reverse postorder, back edges
    let color = u.newn.[u8](nb + 1);
    let cold = u.newn.[bool](nb + 1);
    let inner = u.newn.[i32](nb + 1);
    let mass = u.newn.[f64](nb + 1);
    for bi in 0..nb {
        color[bi] = 0;
        cold[bi] = f.blocks.get(bi).cold;
        inner[bi] = -1;
        mass[bi] = 0.0;
        f.blocks.get(bi).freq = COLD_WEIGHT;  // (unreachable)
    }
    let mut post = u.List.[i32].empty();
    let mut stk = u.List.[i32].empty();
    let mut sidx = u.List.[usize].empty();
    let mut heads = u.List.[i32].empty();  // back edges: header, source
    let mut srcs = u.List.[i32].empty();
    stk.push(0);
    sidx.push(0);
    color[0] = 1;
    while stk.len > 0 {
        let b = @int_cast(usize, stk.get(stk.len - 1));
        let k = sidx.get(sidx.len - 1);
        let blk = f.blocks.get(b);
        if k < blk.succs.len {
            sidx.set(sidx.len - 1, k + 1);
            let s = @int_cast(usize, blk.succs.get(k));
            if color[s] == 0 {
                color[s] = 1;
                stk.push(@int_cast(i32, s));
                sidx.push(0);
            } else if color[s] == 1 {
                heads.push(@int_cast(i32, s));
                srcs.push(@int_cast(i32, b));
            }
        } else {
            color[b] = 2;
            post.push(@int_cast(i32, b));
            stk.len -= 1;
            sidx.len -= 1;
        }
    }
    // cold: marked, or every way on leads to a cold block
    let mut changed = true;
    while changed {
        changed = false;
        for k in 0..post.len {
            let b = @int_cast(usize, post.get(k));
            let blk = f.blocks.get(b);
            if cold[b] or (blk.succs.len == 0) {
                continue;
            }
            let mut all = true;
            for j in 0..blk.succs.len {
                if not cold[@int_cast(usize, blk.succs.get(j))] {
                    all = false;
                }
            }
            if all {
                cold[b] = true;
                changed = true;
            }
        }
    }
    // predecessors
    let preds = u.newn.[u.List.[i32]](nb + 1);
    for bi in 0..nb {
        preds[bi] = u.List.[i32].empty();
    }
    for bi in 0..nb {
        let blk = f.blocks.get(bi);
        for k in 0..blk.succs.len {
            preds[@int_cast(usize, blk.succs.get(k))].push(@int_cast(i32, bi));
        }
    }
    // natural loops, one per header
    let mut loops = u.List.[Loop].empty();
    let mut work = u.List.[i32].empty();
    for e in 0..heads.len {
        let h = heads.get(e);
        let mut li: usize = loops.len;
        for j in 0..loops.len {
            if loops.get(j).head == h {
                li = j;
            }
        }
        if li == loops.len {
            let bs = u.newn.[u64](w + 1);
            for j in 0..w {
                bs[j] = 0;
            }
            bset(bs, @int_cast(usize, h));
            loops.push(Loop.{ head: h, blocks: bs, size: 1, parent: -1, fin: 0.0 });
        }
        let l = loops.at(li);
        work.clear();
        work.push(srcs.get(e));
        while work.len > 0 {
            let x = work.pop();
            if in_loop(l, x) or (color[@int_cast(usize, x)] == 0) {
                continue;
            }
            bset(l.blocks, @int_cast(usize, x));
            l.size += 1;
            let ps = &preds[@int_cast(usize, x)];
            for j in 0..ps.len {
                work.push(ps.get(j));
            }
        }
    }
    // nesting: the smallest loop containing a block, or another loop's header
    let nl = loops.len;
    for bi in 0..nb {
        let mut best: i32 = -1;
        for j in 0..nl {
            let l = loops.at(j);
            if in_loop(l, @int_cast(i32, bi)) and ((best < 0) or (l.size < loops.at(@int_cast(usize, best)).size)) {
                best = @int_cast(i32, j);
            }
        }
        inner[bi] = best;
    }
    for j in 0..nl {
        let l = loops.at(j);
        let mut best: i32 = -1;
        for q in 0..nl {
            let m = loops.at(q);
            if (q != j) and in_loop(m, l.head) and (m.size > l.size) and
               ((best < 0) or (m.size < loops.at(@int_cast(usize, best)).size)) {
                best = @int_cast(i32, q);
            }
        }
        l.parent = best;
    }
    // innermost loops first (by size); the function body (-1) last
    let mut order = u.List.[i32].empty();
    for j in 0..nl {
        order.push(@int_cast(i32, j));
    }
    for a in 0..nl {
        for b2 in (a + 1)..nl {
            if loops.at(@int_cast(usize, order.get(b2))).size < loops.at(@int_cast(usize, order.get(a))).size {
                let t = order.get(a);
                order.set(a, order.get(b2));
                order.set(b2, t);
            }
        }
    }
    order.push(-1);
    // per loop: the mass of each of its blocks per iteration, and where it exits
    let rel = u.newn.[f64](nb + 1);  // within the innermost loop (for headers: within the parent)
    let exits = u.newn.[u.List.[i32]](nl + 1);
    let exitp = u.newn.[u.List.[f64]](nl + 1);
    for j in 0..nl {
        exits[j] = u.List.[i32].empty();
        exitp[j] = u.List.[f64].empty();
    }
    let mut pr = u.List.[f64].empty();
    for oi in 0..order.len {
        let li = order.get(oi);
        let mut head: i32 = 0;
        if li >= 0 {
            head = loops.at(@int_cast(usize, li)).head;
        }
        for bi in 0..nb {
            mass[bi] = 0.0;
        }
        mass[@int_cast(usize, head)] = 1.0;
        let mut k = post.len;
        while k > 0 {
            k -= 1;
            let b = @int_cast(usize, post.get(k));
            // a block of this loop, or the header of a loop directly inside it
            let mut child: i32 = -1;
            if inner[b] != li {
                let c = inner[b];
                if (c < 0) or (loops.at(@int_cast(usize, c)).head != @int_cast(i32, b)) or
                   (loops.at(@int_cast(usize, c)).parent != li) {
                    continue;
                }
                child = c;
            }
            let m = mass[b];
            if m == 0.0 {
                continue;
            }
            if child >= 0 {
                let ex = &exits[@int_cast(usize, child)];
                let ep = &exitp[@int_cast(usize, child)];
                for j in 0..ex.len {
                    route(&loops, inner[0..nb], li, head, ex.get(j), m * ep.get(j), mass, exits[0..nl], exitp[0..nl]);
                }
            } else {
                edge_probs(f, cold[0..nb], inner[0..nb], &loops, b, &mut pr);
                let blk = f.blocks.get(b);
                for j in 0..blk.succs.len {
                    route(&loops, inner[0..nb], li, head, blk.succs.get(j), m * pr.get(j), mass, exits[0..nl],
                          exitp[0..nl]);
                }
            }
        }
        for bi in 0..nb {
            if (inner[bi] == li) or
               ((inner[bi] >= 0) and (loops.at(@int_cast(usize, inner[bi])).head == @int_cast(i32, bi)) and
                (loops.at(@int_cast(usize, inner[bi])).parent == li)) {
                rel[bi] = mass[bi];
            }
        }
        if li >= 0 {
            // exits in proportion
            let ep = &mut exitp[@int_cast(usize, li)];
            let mut tot: f64 = 0.0;
            for j in 0..ep.len {
                tot += ep.get(j);
            }
            if tot > 0.0 {
                for j in 0..ep.len {
                    ep.set(j, ep.get(j) / tot);
                }
            }
        }
    }
    // entries of each loop, outermost first
    let mut oi = order.len;
    while oi > 0 {
        oi -= 1;
        let li = order.get(oi);
        if li < 0 {
            continue;
        }
        let l = loops.at(@int_cast(usize, li));
        let h = @int_cast(usize, l.head);
        if l.parent < 0 {
            l.fin = rel[h];
        } else {
            l.fin = loops.at(@int_cast(usize, l.parent)).fin * LOOP_SCALE * rel[h];
        }
    }
    for bi in 0..nb {
        if color[bi] == 0 {
            continue;
        }
        let li = inner[bi];
        let mut fq = rel[bi];
        if li >= 0 {
            let l = loops.at(@int_cast(usize, li));
            if l.head == @int_cast(i32, bi) {
                fq = l.fin * LOOP_SCALE;
            } else {
                fq = l.fin * LOOP_SCALE * rel[bi];
            }
        }
        if fq < 1.0e-6 {
            fq = 1.0e-6;
        }
        if fq > 1.0e6 {
            fq = 1.0e6;
        }
        f.blocks.get(bi).freq = fq;
    }
    for bi in 0..nb {
        u.free(@ptr_cast(*mut void, preds[bi].data));
    }
    for j in 0..nl {
        u.free(@ptr_cast(*mut void, exits[j].data));
        u.free(@ptr_cast(*mut void, exitp[j].data));
    }
    post.deinit();
    stk.deinit();
    sidx.deinit();
    heads.deinit();
    srcs.deinit();
    loops.deinit();
    work.deinit();
    order.deinit();
    pr.deinit();
}

// Mass m reaches block x from inside loop li (-1: the function body): back to
// the header (dropped: the loop scale stands for it), into a block of the
// loop (for one inside a nested loop, that loop's header), or out (an exit).
fn route(loops: *u.List.[Loop], inner: []i32, li: i32, head: i32, x: i32, m: f64, mass: []mut f64,
         exits: []mut u.List.[i32], exitp: []mut u.List.[f64]) void {
    if x == head {
        return;
    }
    let xi = @int_cast(usize, x);
    if (li < 0) or in_loop(loops.at(@int_cast(usize, li)), x) {
        // the outermost loop inside li containing x
        let mut c = inner[xi];
        let mut node = x;
        while (c >= 0) and (c != li) {
            node = loops.at(@int_cast(usize, c)).head;
            c = loops.at(@int_cast(usize, c)).parent;
        }
        mass[@int_cast(usize, node)] += m;
        return;
    }
    let ex = &mut exits[@int_cast(usize, li)];
    let ep = &mut exitp[@int_cast(usize, li)];
    for j in 0..ex.len {
        if ex.get(j) == x {
            ep.set(j, ep.get(j) + m);
            return;
        }
    }
    ex.push(x);
    ep.push(m);
}

// -----------------------------------------------------------------------------
// Intervals and fixed ranges
// -----------------------------------------------------------------------------
struct Range {
    s: i32,
    e: i32,
}

let mut fixed: [64]u.List.[Range] = [u.List.[Range].{ data: @ptr_from_int(*mut Range, 0), len: 0, cap: 0 }; 64];
// after build_fixed: each register's ranges sorted by start, and the
// largest end among the first k+1 of them
let mut fixed_maxe: [64]u.List.[i32] = [u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 }; 64];

fn add_fixed(r: i32, s: i32, e: i32) void {
    fixed[@int_cast(usize, r)].push(Range.{ s: s, e: e });
}

fn range_before(a: Range, b: Range) i32 {
    if a.s < b.s {
        return -1;
    }
    if a.s > b.s {
        return 1;
    }
    return 0;
}

fn sort_fixed() void {
    for r in @as(usize, 0)..64 {
        let l = &mut fixed[r];
        u.sort.[Range](l.items(), range_before);
        let m = &mut fixed_maxe[r];
        m.clear();
        let mut mx: i32 = -1;
        for k in 0..l.len {
            let x = l.get(k);
            if x.e > mx {
                mx = x.e;
            }
            m.push(mx);
        }
    }
}

// Does a fixed range of r overlap [s, e]?
fn fixed_conflict(r: i32, s: i32, e: i32) bool {
    let l = &fixed[@int_cast(usize, r)];
    // the ranges starting at or before e: a prefix
    let mut lo: usize = 0;
    let mut hi = l.len;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if l.get(mid).s <= e {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo == 0 {
        return false;
    }
    return fixed_maxe[@int_cast(usize, r)].get(lo - 1) >= s;
}

fn build_fixed(f: *mut MFunc) void {
    for r in @as(usize, 0)..64 {
        fixed[r].clear();
    }
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        // per physical register: the position of the next read (scanning backwards)
        let mut next_use: [64]i32 = [-1; 64];
        let mut i = b.last;
        while u.notnil(i) {
            let p = i.pos;
            if i.clobber != 0 {
                for r in @as(u32, 0)..64 {
                    if (i.clobber & (@as(u64, 1) << r)) != 0 {
                        add_fixed(@as(i32, @bit_cast(i32, r)), (2 * p) + 1, (2 * p) + 1);
                    }
                }
            }
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and not is_vreg(o.reg) and (o.reg >= 0) and ((o.role & RD) != 0) {
                    let ri = @int_cast(usize, o.reg);
                    let mut s = (2 * p) + 1;
                    if (o.role & RE) != 0 {
                        s = 2 * p;
                    }
                    let mut e = next_use[ri];
                    if e < 0 {
                        e = s;
                    }
                    add_fixed(o.reg, s, e);
                    next_use[ri] = -1;
                }
            }
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and not is_vreg(o.reg) and (o.reg >= 0) and ((o.role & RU) != 0) {
                    let ri = @int_cast(usize, o.reg);
                    if next_use[ri] < 0 {
                        next_use[ri] = 2 * p;
                    }
                }
                if o.kind == K_MEM {
                    if (o.base >= 0) and not is_vreg(o.base) {
                        let ri = @int_cast(usize, o.base);
                        if next_use[ri] < 0 {
                            next_use[ri] = 2 * p;
                        }
                    }
                    if (o.index >= 0) and not is_vreg(o.index) {
                        let ri = @int_cast(usize, o.index);
                        if next_use[ri] < 0 {
                            next_use[ri] = 2 * p;
                        }
                    }
                }
            }
            i = i.prev;
        }
        // registers read before any write in the block: live from its start
        for r in @as(usize, 0)..64 {
            if next_use[r] >= 0 {
                add_fixed(@int_cast(i32, r), b.start, next_use[r]);
            }
        }
        if b.noframe {
            for r in @as(u32, 0)..64 {
                if (f.noframe_regs & (@as(u64, 1) << r)) != 0 {
                    add_fixed(@as(i32, @bit_cast(i32, r)), b.start, b.end);
                }
            }
        }
    }
    sort_fixed();
}

struct Interval {
    v: i32,  // vreg index (vreg - VREG0)
    s: i32,  // first position
    e: i32,  // last position
    reg: i32,
    spilled: bool,
    uses: f64,               // uses and definitions, weighted by 10^loop depth
    ranges: u.List.[Range],  // the positions it is live at: sorted, disjoint, inclusive
    size: i32,               // positions covered
}

const WEIGHT_PAD: i32 = 50;

// The cost of spilling an interval: its (weighted) uses per position covered.
fn weight(f: *MFunc, x: *Interval) f64 {
    if f.nospill.get(@int_cast(usize, x.v)) {
        return 1.0e300;
    }
    let w = x.uses / @float_from_int(f64, x.size + WEIGHT_PAD);
    if u.notnil(f.remat.get(@int_cast(usize, x.v))) {
        return w * 0.5;  // (rebuilt where it is used: no stores, no slot)
    }
    return w;
}

// Ranges are built backwards (blocks in reverse order, instructions last to
// first), so they are appended in decreasing order and reversed at the end;
// the last one is the current block's.
fn add_range(x: *mut Interval, s: i32, e: i32) void {
    if x.ranges.len > 0 {
        let l = x.ranges.at(x.ranges.len - 1);
        if l.s <= (e + 1) {
            if s < l.s {
                l.s = s;
            }
            if e > l.e {
                l.e = e;
            }
            return;
        }
    }
    x.ranges.push(Range.{ s: s, e: e });
}

// A definition at p: the value is live from p (not from the block's start).
fn def_at(x: *mut Interval, p: i32, live: bool) void {
    if live and (x.ranges.len > 0) {
        let l = x.ranges.at(x.ranges.len - 1);
        if p <= l.e {
            l.s = p;
            return;
        }
    }
    x.ranges.push(Range.{ s: p, e: p });  // dead definition
}

fn build_intervals(f: *mut MFunc) []mut Interval {
    let nv = nvregs(f);
    let iv = u.newn.[Interval](nv + 1);
    for k in 0..nv {
        iv[k] = Interval.{ v: @int_cast(i32, k), s: 0x7fff_ffff, e: -1, reg: -1, spilled: false, uses: 0.0,
                           ranges: u.List.[Range].empty(), size: 0 };
    }
    let w = words(nv);
    let live = u.newn.[u64](w + 1);
    let mut bi = f.blocks.len;
    while bi > 0 {
        bi -= 1;
        let b = f.blocks.get(bi);
        let dw = b.freq;
        for j in 0..w {
            live[j] = b.live_out[j];
            let lo = b.live_out[j];
            if lo == 0 {
                continue;
            }
            for bit in @as(usize, 0)..64 {
                if (lo & (@as(u64, 1) << @int_cast(u32, bit))) != 0 {
                    add_range(&mut iv[(j * 64) + bit], b.start, b.end);
                }
            }
        }
        let mut i = b.last;
        while u.notnil(i) {
            let p = i.pos;
            // definitions end the value's life above them
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RD) != 0) {
                    let x = @int_cast(usize, o.reg - VREG0);
                    let mut dp = (2 * p) + 1;
                    if (o.role & RE) != 0 {
                        dp = 2 * p;
                    }
                    def_at(&mut iv[x], dp, bget(live, x));
                    bclr(live, x);
                    iv[x].uses += dw;
                }
            }
            // uses make it live from the block's start (until a definition)
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RU) != 0) {
                    let x = @int_cast(usize, o.reg - VREG0);
                    add_range(&mut iv[x], b.start, 2 * p);
                    bset(live, x);
                    iv[x].uses += dw;
                } else if o.kind == K_MEM {
                    let regs: [2]i32 = [o.base, o.index];
                    for r in regs {
                        if is_vreg(r) {
                            let x = @int_cast(usize, r - VREG0);
                            add_range(&mut iv[x], b.start, 2 * p);
                            bset(live, x);
                            iv[x].uses += dw;
                        }
                    }
                }
            }
            i = i.prev;
        }
    }
    for k in 0..nv {
        let x = &mut iv[k];
        let n = x.ranges.len;
        if n == 0 {
            continue;
        }
        // increasing order
        let rs = x.ranges.items();
        for j in 0..(n / 2) {
            let t = rs[j];
            rs[j] = rs[(n - 1) - j];
            rs[(n - 1) - j] = t;
        }
        x.s = rs[0].s;
        x.e = rs[n - 1].e;
        for j in 0..n {
            x.size += (rs[j].e - rs[j].s) + 1;
        }
    }
    return iv[0..nv];
}

// Does a fixed range of r overlap x?
fn fixed_hits(r: i32, x: *Interval) bool {
    for k in 0..x.ranges.len {
        let y = x.ranges.get(k);
        if fixed_conflict(r, y.s, y.e) {
            return true;
        }
    }
    return false;
}

// -----------------------------------------------------------------------------
// One allocation round, greedily: intervals in order of size (largest
// first: the hardest to place), each into a free register (its hint's
// first), else into the register whose interfering intervals cost least
// to spill, when all of them cost less than it (they are taken out and
// queued again), else spilled. Unlike a linear scan, an interval is weighed
// against everything it overlaps, not only what is live where it starts.
// Each physical register keeps the segments assigned to it (disjoint, in
// order). Returns the number of intervals spilled.
// -----------------------------------------------------------------------------
struct Seg {
    s: i32,
    e: i32,
    x: i32,  // interval index
}

// the first segment ending at or after p
fn seg_first(l: *u.List.[Seg], p: i32) usize {
    let mut lo: usize = 0;
    let mut hi = l.len;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if l.get(mid).e < p {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn seg_insert(l: *mut u.List.[Seg], sg: Seg) void {
    let k = seg_first(l, sg.s);
    l.push(sg);
    let mut j = l.len - 1;
    while j > k {
        l.set(j, l.get(j - 1));
        j -= 1;
    }
    l.set(k, sg);
}

fn seg_remove(l: *mut u.List.[Seg], s: i32) void {
    let k = seg_first(l, s);
    for j in k..(l.len - 1) {
        l.set(j, l.get(j + 1));
    }
    l.len -= 1;
}

fn reg_free(l: *u.List.[Seg], x: *Interval) bool {
    for j in 0..x.ranges.len {
        let rg = x.ranges.get(j);
        let k = seg_first(l, rg.s);
        if (k < l.len) and (l.get(k).s <= rg.e) {
            return false;
        }
    }
    return true;
}

// max-heap of interval indexes by key
fn heap_push(h: *mut u.List.[i32], key: []f64, x: i32) void {
    h.push(x);
    let mut k = h.len - 1;
    while k > 0 {
        let p = (k - 1) / 2;
        let a = h.get(p);
        if (key[@int_cast(usize, a)] > key[@int_cast(usize, x)]) or
           ((key[@int_cast(usize, a)] == key[@int_cast(usize, x)]) and (a < x)) {
            break;
        }
        h.set(k, a);
        k = p;
    }
    h.set(k, x);
}

fn heap_pop(h: *mut u.List.[i32], key: []f64) i32 {
    let top = h.get(0);
    let x = h.get(h.len - 1);
    h.len -= 1;
    let n = h.len;
    if n == 0 {
        return top;
    }
    let mut k: usize = 0;
    loop {
        let mut c = (2 * k) + 1;
        if c >= n {
            break;
        }
        let r = c + 1;
        if r < n {
            let a = h.get(c);
            let b = h.get(r);
            if (key[@int_cast(usize, b)] > key[@int_cast(usize, a)]) or
               ((key[@int_cast(usize, b)] == key[@int_cast(usize, a)]) and (b < a)) {
                c = r;
            }
        }
        let y = h.get(c);
        if (key[@int_cast(usize, x)] > key[@int_cast(usize, y)]) or
           ((key[@int_cast(usize, x)] == key[@int_cast(usize, y)]) and (x < y)) {
            break;
        }
        h.set(k, y);
        k = c;
    }
    h.set(k, x);
    return top;
}

pub let mut debug_ra: bool = false;

fn assign_reg(segs: []mut u.List.[Seg], x: *mut Interval, xi: i32, r: i32) void {
    if debug_ra {
        u.eprint(u.f2("  v%s -> r%s\n", u.idec(xi), u.idec(r)));
    }
    x.reg = r;
    for j in 0..x.ranges.len {
        let rg = x.ranges.get(j);
        seg_insert(&mut segs[@int_cast(usize, r)], Seg.{ s: rg.s, e: rg.e, x: xi });
    }
}

fn unassign_reg(segs: []mut u.List.[Seg], x: *mut Interval) void {
    let r = x.reg;
    for j in 0..x.ranges.len {
        seg_remove(&mut segs[@int_cast(usize, r)], x.ranges.get(j).s);
    }
    x.reg = -1;
}

fn greedy(f: *mut MFunc, t: *Target, iv: []mut Interval) usize {
    let n = iv.len;
    let key = u.newn.[f64](n + 1);
    let wt = u.newn.[f64](n + 1);
    let mut heap = u.List.[i32].empty();
    for k in 0..n {
        wt[k] = weight(f, &iv[k]);
        key[k] = @float_from_int(f64, iv[k].size);
        if f.nospill.get(@int_cast(usize, iv[k].v)) {
            key[k] = 1.0e300;
        }
        if iv[k].e >= 0 {
            heap_push(&mut heap, key[0..n], @int_cast(i32, k));
        }
    }
    let segs = u.newn.[u.List.[Seg]](64);
    for r in @as(usize, 0)..64 {
        segs[r] = u.List.[Seg].empty();
    }
    let mut vict = u.List.[i32].empty();
    let mut nspill: usize = 0;
    let mut evictions: usize = 0;
    while heap.len > 0 {
        let ci = heap_pop(&mut heap, key[0..n]);
        let cur = &mut iv[@int_cast(usize, ci)];
        let class = f.vclass.get(@int_cast(usize, cur.v));
        let order = t.alloc_order[@as(usize, class)];
        let mut pick: i32 = -1;
        // the hint first
        let h = f.hint.get(@int_cast(usize, cur.v));
        let mut hr: i32 = -1;
        if (h >= 0) and not is_vreg(h) {
            hr = h;
        } else if is_vreg(h) and (iv[@int_cast(usize, h - VREG0)].reg >= 0) {
            hr = iv[@int_cast(usize, h - VREG0)].reg;
        }
        if (hr >= 0) and in_order(order, hr) and reg_free(&segs[@int_cast(usize, hr)], cur) and
           not fixed_hits(hr, cur) {
            pick = hr;
        }
        if pick < 0 {
            for r in order {
                if reg_free(&segs[@int_cast(usize, r)], cur) and not fixed_hits(r, cur) {
                    pick = r;
                    break;
                }
            }
        }
        if pick >= 0 {
            assign_reg(segs, cur, ci, pick);
            continue;
        }
        // evict: the register whose interfering intervals cost least (the
        // dearest of them, then all together), if less than cur
        let must = f.nospill.get(@int_cast(usize, cur.v));
        let wc = wt[@int_cast(usize, ci)];
        let mut best: i32 = -1;
        let mut bmax: f64 = 0.0;
        let mut bsum: f64 = 0.0;
        if evictions <= ((8 * n) + 100) {
            for r in order {
                if fixed_hits(r, cur) {
                    continue;
                }
                let l = &segs[@int_cast(usize, r)];
                let mut mx: f64 = 0.0;
                let mut sum: f64 = 0.0;
                let mut last: i32 = -1;
                let mut ok = true;
                for j in 0..cur.ranges.len {
                    let rg = cur.ranges.get(j);
                    let mut k = seg_first(l, rg.s);
                    while ok and (k < l.len) and (l.get(k).s <= rg.e) {
                        let x = l.get(k).x;
                        if x != last {
                            let w = wt[@int_cast(usize, x)];
                            if f.nospill.get(@int_cast(usize, iv[@int_cast(usize, x)].v)) or not (must or (w < wc)) {
                                ok = false;
                            }
                            if w > mx {
                                mx = w;
                            }
                            sum += w;  // (an interval met twice counts twice: a rough sum)
                            last = x;
                        }
                        k += 1;
                    }
                }
                if ok and ((best < 0) or (mx < bmax) or ((mx == bmax) and (sum < bsum))) {
                    best = r;
                    bmax = mx;
                    bsum = sum;
                }
            }
        }
        if best < 0 {
            if debug_ra {
                u.eprint(u.f1("  v%s spilled\n", u.idec(ci)));
            }
            if must {
                u.die("internal compiler error: register allocation failed (no register for a reload)");
            }
            cur.spilled = true;
            nspill += 1;
            continue;
        }
        let l = &segs[@int_cast(usize, best)];
        vict.clear();
        for j in 0..cur.ranges.len {
            let rg = cur.ranges.get(j);
            let mut k = seg_first(l, rg.s);
            while (k < l.len) and (l.get(k).s <= rg.e) {
                let x = l.get(k).x;
                let mut seen = false;
                for q in 0..vict.len {
                    if vict.get(q) == x {
                        seen = true;
                    }
                }
                if not seen {
                    vict.push(x);
                }
                k += 1;
            }
        }
        for q in 0..vict.len {
            let x = vict.get(q);
            if debug_ra {
                u.eprint(u.f2("  v%s evicts v%s\n", u.idec(ci), u.idec(x)));
            }
            unassign_reg(segs, &mut iv[@int_cast(usize, x)]);
            heap_push(&mut heap, key[0..n], x);
            evictions += 1;
        }
        assign_reg(segs, cur, ci, best);
    }
    for r in @as(usize, 0)..64 {
        u.free(@ptr_cast(*mut void, segs[r].data));
    }
    heap.deinit();
    vict.deinit();
    for k in 0..n {
        u.free(@ptr_cast(*mut void, iv[k].ranges.data));
    }
    return nspill;
}

fn in_order(order: []i32, r: i32) bool {
    for x in order {
        if x == r {
            return true;
        }
    }
    return false;
}

// -----------------------------------------------------------------------------
// Spilling and live-range splitting
//
// A spilled vreg gets a stack slot, which its pieces share. It is first split
// into pieces rather than spilled everywhere: where it is live across a call,
// or along the edges into and out of loops, it is in its slot, and in between
// each connected stretch (a region) becomes a new vreg, which takes part in the
// next round like any other: in a register inside a loop or between calls,
// say, while it stays in memory across them. A region is reloaded where it
// is entered from memory (after a call, at a loop's entry), or copied from the
// region before it along an edge (a copy the allocator can coalesce, and which
// becomes a reload or a store if either side is spilled in turn). The slot
// holds the value wherever it is in memory: a region that defines it stores
// it after each definition, or where it leaves the region, whichever is
// cheaper (by loop depth).
//
// level 0 vregs are split around calls and at loop boundaries; their pieces
// (level 1) at every block boundary; and those pieces (level 2) are spilled
// everywhere, each use and definition through a short-lived register.
// -----------------------------------------------------------------------------
// Does i write register v?
pub fn writes_reg(i: *MInst, v: i32) bool {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and (o.reg == v) and ((o.role & RD) != 0) {
            return true;
        }
    }
    return false;
}

// Does i name register v (an operand, or in a memory operand)?
pub fn mentions(i: *MInst, v: i32) bool {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and (o.reg == v) {
            return true;
        }
        if (o.kind == K_MEM) and ((o.base == v) or (o.index == v)) {
            return true;
        }
    }
    return false;
}

fn replace_reg(i: *mut MInst, v: i32, w: i32) void {
    if (i.spill != 0) and (i.sreg == v) {
        i.sreg = w;
    }
    for k in 0..i.ops.len {
        let o = &mut i.ops[k];
        if (o.kind == K_REG) and (o.reg == v) {
            o.reg = w;
        }
        if o.kind == K_MEM {
            if o.base == v {
                o.base = w;
            }
            if o.index == v {
                o.index = w;
            }
        }
    }
}

// The destination and source registers of a copy (is_move).
fn move_dst(i: *MInst) i32 {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and ((o.role & RD) != 0) {
            return o.reg;
        }
    }
    return -1;
}

fn move_src(i: *MInst) i32 {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and ((o.role & RD) == 0) and ((o.role & RU) != 0) {
            return o.reg;
        }
    }
    return -1;
}

fn is_jump(i: *MInst) bool {
    for k in 0..i.ops.len {
        if i.ops[k].kind == K_LABEL {
            return true;
        }
    }
    return false;
}

// Inserts i at the end of b, before the jumps that end it (spill code changes
// no flags).
fn insert_end(b: *mut MBlock, i: *mut MInst) void {
    let mut j = b.last;
    let mut pos = u.nil.[MInst]();
    while u.notnil(j) and is_jump(j) {
        pos = j;
        j = j.prev;
    }
    if u.notnil(pos) {
        insert_before(b, pos, i);
    } else {
        append(b, i);
    }
}

fn insert_start(b: *mut MBlock, i: *mut MInst) void {
    if u.notnil(b.first) {
        insert_before(b, b.first, i);
    } else {
        append(b, i);
    }
}

fn slot_of(f: *mut MFunc, x: usize) i32 {
    let mut s = f.vslot.get(x);
    if s < 0 {
        let c = f.vclass.get(x);
        let mut sz: u64 = 8;
        if c >= 1 {
            sz = @as(u64, 16) << @truncate(u32, @as(u64, c) - 1);  // (16, 32 or 64 bytes)
        }
        s = new_slot(f, sz, sz);
        f.vslot.set(x, s);
    }
    return s;
}

// A reload in split: of a rematerialized value (rd, the definition of v;
// slot: below -1), its definition again.
fn sreload(f: *mut MFunc, t: *Target, rd: *MInst, v: i32, r: i32, c: u8, slot: i32) *mut MInst {
    if slot >= 0 {
        return reload(f, t, r, c, slot);
    }
    let i = clone_def(rd, v, r);
    i.spill = 1;
    i.sreg = r;
    i.sslot = slot;
    return i;
}

fn reload(f: *mut MFunc, t: *Target, r: i32, c: u8, slot: i32) *mut MInst {
    let i = t.spill_load(f, r, @as(i32, c), slot);
    i.spill = 1;
    i.sreg = r;
    i.sslot = slot;
    return i;
}

fn store(f: *mut MFunc, t: *Target, r: i32, c: u8, slot: i32) *mut MInst {
    let i = t.spill_store(f, r, @as(i32, c), slot);
    i.spill = 2;
    i.sreg = r;
    i.sslot = slot;
    return i;
}

// A call clobbering most of class c's registers: values live across it are
// split there.
fn call_cut(t: *Target, c: u8, i: *MInst) bool {
    if i.clobber == 0 {
        return false;
    }
    let order = t.alloc_order[@as(usize, c)];
    let mut n: usize = 0;
    for r in order {
        if (i.clobber & (@as(u64, 1) << @int_cast(u32, r))) != 0 {
            n += 1;
        }
    }
    return (2 * n) > order.len;
}

struct Cfg {
    npred: []mut i32,
    nsucc: []mut i32,
    simple: []mut bool,             // the block's jumps all come at its end (spill code can go before them)
    endok: []mut bool,              // every predecessor is simple and has the block as its only successor
    label: []mut bool,              // the block has a label
    near: []mut bool,               // the block is in the nl of the vreg being split
    cidx: []mut i32,                // ... at this index
    ev: []mut u.List.[*mut MInst],  // the block's calls (clobbering registers) and jumps, in order
}

fn find(p: *mut u.List.[i32], x: i32) i32 {
    let mut r = x;
    while p.get(@int_cast(usize, r)) != r {
        r = p.get(@int_cast(usize, r));
    }
    let mut y = x;
    while p.get(@int_cast(usize, y)) != r {
        let n = p.get(@int_cast(usize, y));
        p.set(@int_cast(usize, y), r);
        y = n;
    }
    return r;
}

fn depth_of(f: *MFunc, bi: usize) i32 {
    return f.blocks.get(bi).loop_depth;
}

// Spill code between v and its slot, or a copy between v and another piece of
// the same vreg (made where it was split, where the slot holds the value too):
// i sets v to what the slot holds (in) or passes it on (out).
fn same_slot(f: *MFunc, r: i32, sl: i32) bool {
    return is_vreg(r) and (f.vslot.get(@int_cast(usize, r - VREG0)) == sl);
}

fn transfer_in(f: *MFunc, i: *MInst, v: i32) bool {
    let sl = f.vslot.get(@int_cast(usize, v - VREG0));
    if sl == -1 {
        return false;
    }
    if (i.spill == 1) and (i.sreg == v) and (i.sslot == sl) {
        return true;
    }
    return i.is_move and (move_dst(i) == v) and same_slot(f, move_src(i), sl);
}

fn transfer_out(f: *MFunc, i: *MInst, v: i32) bool {
    let sl = f.vslot.get(@int_cast(usize, v - VREG0));
    if sl == -1 {
        return false;
    }
    if (i.spill == 2) and (i.sreg == v) and (i.sslot == sl) {
        return true;
    }
    return i.is_move and (move_src(i) == v) and same_slot(f, move_dst(i), sl);
}

// A use or definition of v other than its spill code.
fn real_use(f: *MFunc, i: *MInst, v: i32) bool {
    return mentions(i, v) and not transfer_in(f, i, v) and not transfer_out(f, i, v);
}

// Where split cuts a vreg: at calls and loop boundaries, also between the
// stretches of code that use it (clusters), or at every block boundary.
const SPLIT_LOOPS: i32 = 0;
const SPLIT_GAPS: i32 = 1;
const SPLIT_ALL: i32 = 2;

// Uses further apart than this many instructions are in different clusters.
const SPLIT_GAP: i32 = 16;

// What split decided about the vreg's blocks (by their index in its nl).
struct Split {
    memtail: []bool,
    cl: []i32,
    allin: []bool,
    mode: i32,
}

// Should the edge from block p to block s (both in nl) be a split point (if
// there is a place for the spill code)?
fn wants_cut(f: *MFunc, g: *Cfg, ms: *Split, p: usize, s: usize) bool {
    let pj = @int_cast(usize, g.cidx[p]);
    if (ms.mode == SPLIT_ALL) or ms.memtail[pj] or (depth_of(f, p) != depth_of(f, s)) {
        return true;
    }
    return (ms.mode == SPLIT_GAPS) and (ms.cl[pj] != ms.cl[@int_cast(usize, g.cidx[s])]);
}

// Is the edge from block p to block s (where the vreg is live) a split point?
// Spill code goes at the start of s if p is its only predecessor or every
// edge into s is a split point, else at the end of p if s is its only
// successor.
fn edge_cut(f: *MFunc, g: *Cfg, ms: *Split, p: usize, s: usize) bool {
    if not wants_cut(f, g, ms, p, s) {
        return false;
    }
    return ms.allin[@int_cast(usize, g.cidx[s])] or (g.npred[s] == 1) or ((g.nsucc[p] == 1) and g.simple[p]);
}

// The clusters of vreg v's uses (see SPLIT_GAPS): uses in blocks laid out
// in order, at most SPLIT_GAP instructions apart, are one cluster, which the
// blocks between them also belong to; the other blocks belong to none (-1).
fn use_clusters(f: *MFunc, v: i32, nl: []i32, nm: []bool, cl: []mut i32) void {
    let mut n: i32 = -1;
    let mut prev_last: i32 = -1;  // the last use in the last block with one (-1: none yet)
    let mut prev: usize = 0;
    for bj in 0..nl.len {
        cl[bj] = -1;
        if not nm[bj] {
            continue;
        }
        let mut first: i32 = -1;
        let mut last: i32 = -1;
        let mut i = f.blocks.get(@int_cast(usize, nl[bj])).first;
        while u.notnil(i) {
            if real_use(f, i, v) {
                if first < 0 {
                    first = i.pos;
                }
                last = i.pos;
            }
            i = i.next;
        }
        if first < 0 {
            continue;
        }
        if (prev_last >= 0) and ((first - prev_last) <= SPLIT_GAP) {
            for q in (prev + 1)..bj {
                cl[q] = n;
            }
        } else {
            n += 1;
        }
        cl[bj] = n;
        prev = bj;
        prev_last = last;
    }
}

// Splits vreg x into regions (see above), where mode says (SPLIT_LOOPS,
// SPLIT_GAPS, SPLIT_ALL). Returns false, changing nothing, if there is
// nothing to split.
// (nm: whether each block of nl names the vreg; where it does not, the vreg
// is live through it, and only its calls and jumps matter)
fn split(f: *mut MFunc, t: *Target, g: *Cfg, x: usize, mode: i32, level: u8, nl: []i32, nm: []bool) bool {
    let v = VREG0 + @int_cast(i32, x);
    let c = f.vclass.get(x);
    let mut rd = f.remat.get(x);
    let isrm = u.notnil(rd);
    if isrm {
        rd = clone_def(rd, v, v);  // (the definition itself is rewritten below)
    }
    // (blocks by their index in nl, where the vreg is live or named: g.cidx)
    let m = nl.len;
    let cl = u.newn.[i32](m + 1);
    if mode == SPLIT_GAPS {
        use_clusters(f, v, nl, nm, cl[0..m]);
    }
    let head = u.newn.[i32](m + 1);
    let tail = u.newn.[i32](m + 1);
    let allin = u.newn.[bool](m + 1);
    let mut par = u.List.[i32].empty();          // union-find over segments
    let mut occ = u.List.[bool].empty();         // the vreg is read or written there
    let mut rel = u.List.[bool].empty();         // ... or live
    let mut defc = u.List.[f64].empty();         // definitions, by loop depth
    let mut cuts = u.List.[*mut MInst].empty();  // calls it is live across
    let mut cut_seg = u.List.[i32].empty();      // the segment before each
    let mut cut_fq = u.List.[f64].empty();
    let mut arr = u.List.[*mut MInst].empty();
    let mut la = u.List.[bool].empty();
    let mut nrd = u.List.[i32].empty();    // instructions reading it
    let mut deep = u.List.[bool].empty();  // ... in a loop
    // segments: the stretches of each block between the calls it is live across
    for bj in 0..m {
        let bi = @int_cast(usize, nl[bj]);
        let b = f.blocks.get(bi);
        let fq = b.freq;
        if not nm[bj] {
            // (live through it: segments between the calls it is live across)
            let mut seg = @int_cast(i32, par.len);
            par.push(seg);
            occ.push(false);
            rel.push(bget(b.live_in, x));
            defc.push(0.0);
            nrd.push(0);
            deep.push(false);
            head[bj] = seg;
            if g.simple[bi] and bget(b.live_out, x) {
                for j in g.ev[bi].items() {
                    if call_cut(t, c, j) {
                        cuts.push(j);
                        cut_seg.push(seg);
                        cut_fq.push(fq);
                        rel.set(@int_cast(usize, seg), true);
                        seg = @int_cast(i32, par.len);
                        par.push(seg);
                        occ.push(false);
                        rel.push(true);
                        defc.push(0.0);
                        nrd.push(0);
                        deep.push(false);
                    }
                }
            }
            if bget(b.live_out, x) {
                rel.set(@int_cast(usize, seg), true);
            }
            tail[bj] = seg;
            continue;
        }
        arr.clear();
        la.clear();
        let mut i = b.first;
        while u.notnil(i) {
            arr.push(i);
            la.push(false);
            i = i.next;
        }
        let mut live = bget(b.live_out, x);
        let mut k = arr.len;
        while k > 0 {
            k -= 1;
            let j = arr.get(k);
            la.set(k, live);
            if writes_reg(j, v) {
                live = false;
            }
            if each_reg_use(j, v) {
                live = true;
            }
        }
        let mut seg = @int_cast(i32, par.len);
        par.push(seg);
        occ.push(false);
        rel.push(bget(b.live_in, x));
        defc.push(0.0);
        nrd.push(0);
        deep.push(false);
        head[bj] = seg;
        for k2 in 0..arr.len {
            let j = arr.get(k2);
            let s = @int_cast(usize, seg);
            let w = writes_reg(j, v);
            if mentions(j, v) {
                rel.set(s, true);
            }
            if real_use(f, j, v) {
                occ.set(s, true);
                if w {
                    defc.set(s, defc.get(s) + fq);
                } else {
                    nrd.set(s, nrd.get(s) + 1);
                    if b.loop_depth > 0 {
                        deep.set(s, true);
                    }
                }
            }
            if g.simple[bi] and not w and la.get(k2) and call_cut(t, c, j) {
                cuts.push(j);
                cut_seg.push(seg);
                cut_fq.push(fq);
                rel.set(s, true);
                seg = @int_cast(i32, par.len);
                par.push(seg);
                occ.push(false);
                rel.push(true);
                defc.push(0.0);
                nrd.push(0);
                deep.push(false);
            }
        }
        if bget(b.live_out, x) {
            rel.set(@int_cast(usize, seg), true);
        }
        tail[bj] = seg;
    }
    // edges: joined, or split points (always after a call it is not used after
    // in the block: reloaded where it is used next)
    let memtail = u.newn.[bool](m + 1);
    for bj in 0..m {
        let tl = @int_cast(usize, tail[bj]);
        memtail[bj] = (tail[bj] != head[bj]) and not occ.get(tl);
    }
    // blocks that neither use it nor call, entered only from where it is in
    // memory (after a call it is not used after, or another such block),
    // leave it there: reloaded where it is used next, past joins of such
    // paths, not where it was last in memory
    // (where the vreg is live into a block, it is live out of every
    // predecessor: edges that matter join blocks of nl)
    let memthru = u.newn.[bool](m + 1);
    for bj in 0..m {
        let bi = @int_cast(usize, nl[bj]);
        memthru[bj] = (bi > 0) and (tail[bj] == head[bj]) and not occ.get(@int_cast(usize, head[bj])) and
                      bget(f.blocks.get(bi).live_in, x);
    }
    let mut mchanged = true;
    while mchanged {
        mchanged = false;
        for pj in 0..m {
            if memtail[pj] or memthru[pj] {
                continue;
            }
            let pb = f.blocks.get(@int_cast(usize, nl[pj]));
            for k in 0..pb.succs.len {
                let si = @int_cast(usize, pb.succs.get(k));
                if g.near[si] and memthru[@int_cast(usize, g.cidx[si])] {
                    memthru[@int_cast(usize, g.cidx[si])] = false;
                    mchanged = true;
                }
            }
        }
    }
    for bj in 0..m {
        if memthru[bj] {
            memtail[bj] = true;
        }
    }
    let ms = Split.{ memtail: memtail[0..m], cl: cl[0..m], allin: allin[0..m], mode: mode };
    for sj in 0..m {
        allin[sj] = true;
    }
    for pj in 0..m {
        let pi = @int_cast(usize, nl[pj]);
        let pb = f.blocks.get(pi);
        for k in 0..pb.succs.len {
            let si = @int_cast(usize, pb.succs.get(k));
            if g.near[si] and not wants_cut(f, g, &ms, pi, si) {
                allin[@int_cast(usize, g.cidx[si])] = false;
            }
        }
    }
    let mut nedge: usize = 0;
    for pj in 0..m {
        let pi = @int_cast(usize, nl[pj]);
        let pb = f.blocks.get(pi);
        for k in 0..pb.succs.len {
            let si = @int_cast(usize, pb.succs.get(k));
            if not bget(f.blocks.get(si).live_in, x) {
                continue;
            }
            if edge_cut(f, g, &ms, pi, si) {
                nedge += 1;
            } else {
                let a = find(&mut par, tail[pj]);
                let b2 = find(&mut par, head[@int_cast(usize, g.cidx[si])]);
                par.set(@int_cast(usize, a), b2);
            }
        }
    }
    let ns = par.len;
    // nothing to split: one region, live across no call
    let mut progress = cuts.len > 0;
    if not progress {
        let mut root: i32 = -1;
        for s in 0..ns {
            if rel.get(s) {
                let r = find(&mut par, @int_cast(i32, s));
                if (root >= 0) and (r != root) {
                    progress = true;
                }
                root = r;
            }
        }
    }
    _ = nedge;
    if not progress {
        par.deinit();
        occ.deinit();
        rel.deinit();
        defc.deinit();
        cuts.deinit();
        cut_seg.deinit();
        cut_fq.deinit();
        arr.deinit();
        la.deinit();
        nrd.deinit();
        deep.deinit();
        return false;
    }
    // regions: whether they use it (else it stays in memory there), their
    // definitions and exits
    let rocc = u.newn.[bool](ns + 1);
    let rdef = u.newn.[f64](ns + 1);
    let rexit = u.newn.[f64](ns + 1);
    let wreg = u.newn.[i32](ns + 1);
    for s in 0..ns {
        rocc[s] = false;
        rdef[s] = 0.0;
        rexit[s] = 0.0;
        wreg[s] = -1;
    }
    let rnrd = u.newn.[i32](ns + 1);
    let rdeep = u.newn.[bool](ns + 1);
    let fold1 = u.newn.[bool](ns + 1);
    for s in 0..ns {
        rnrd[s] = 0;
        rdeep[s] = false;
        fold1[s] = false;
    }
    for s in 0..ns {
        let r = @int_cast(usize, find(&mut par, @int_cast(i32, s)));
        if occ.get(s) {
            rocc[r] = true;
        }
        rdef[r] += defc.get(s);
        rnrd[r] += nrd.get(s);
        if deep.get(s) {
            rdeep[r] = true;
        }
    }
    // a rematerialized value read once in a region (not one around a loop)
    // is built again where it is read, or read from memory there: a register
    // for it would cost an instruction more
    if isrm {
        for s in 0..ns {
            if rocc[s] and (rnrd[s] == 1) and (rdef[s] == 0.0) and ((mode != SPLIT_LOOPS) or not rdeep[s]) {
                fold1[s] = true;
                rocc[s] = false;
            }
        }
    }
    for k in 0..cuts.len {
        rexit[@int_cast(usize, find(&mut par, cut_seg.get(k)))] += cut_fq.get(k);
    }
    for pj in 0..m {
        let pi = @int_cast(usize, nl[pj]);
        let pb = f.blocks.get(pi);
        let mut any = false;
        for k in 0..pb.succs.len {
            let si = @int_cast(usize, pb.succs.get(k));
            if bget(f.blocks.get(si).live_in, x) and edge_cut(f, g, &ms, pi, si) {
                any = true;
            }
        }
        if any {
            let r = @int_cast(usize, find(&mut par, tail[pj]));
            if g.simple[pi] {
                rexit[r] += pb.freq;
            } else {
                rexit[r] = 1.0e300;  // (no place for a store there: after each definition)
            }
        }
    }
    // (a rematerialized value is rebuilt where a piece is entered from
    // "memory", and never stored: its pieces are rematerialized in turn)
    let mut slot = f.vslot.get(x);
    if not isrm {
        slot = slot_of(f, x);
    } else if slot == -1 {
        slot = -2 - @int_cast(i32, x);
    }
    for s in 0..ns {
        if (find(&mut par, @int_cast(i32, s)) == @int_cast(i32, s)) and rocc[s] {
            let w = new_vreg(f, c);
            let wx = @int_cast(usize, w - VREG0);
            f.level.set(wx, level);
            f.vslot.set(wx, slot);
            if isrm {
                set_remat(f, w, clone_def(rd, v, w));
            }
            wreg[s] = w;
        }
    }
    // stores where it leaves a region (if cheaper than after each
    // definition), but for a region that only defines it: there a store
    // after the definition ends its life at once, where one at the exit
    // would hold a register for it to the end of the region, for nothing
    // (twelve masks defined in a row and stored at the end of the block take
    // twelve registers, which evict the values used all over the function)
    let at_exit = u.newn.[bool](ns + 1);
    for s in 0..ns {
        at_exit[s] = (rdef[s] > 0.0) and (rexit[s] <= rdef[s]) and (rnrd[s] > 0) and not isrm;
        if debug_ra and rocc[s] {
            u.eprint(
                u.f4(
                    "  region %s rdef %s rexit %s at_exit %s\n", u.zdec(s),
                    u.dec(@int_from_float(i64, rdef[s] * 1000.0)),
                    u.dec(@int_from_float(i64, @min(rexit[s], 1.0e12) * 1000.0)), u.pick(at_exit[s], "y", "n")));
        }
    }
    // blocks reloading it themselves (every edge in is a split point): before
    // its first use there. Where every predecessor has room for spill code at
    // its end, moves from the pieces holding it in registers go there instead,
    // but if none does, each would reload it: then the block does, once. (A
    // reload at the end of each predecessor keeps it in a register at the
    // join, where it was already: thirty fields of a struct loaded before a
    // join and stored after it, split one at a time, each again live across
    // the join, take a round each to evict the next.)
    let selfld = u.newn.[bool](m + 1);
    for sj in 0..m {
        selfld[sj] = true;
    }
    for pj in 0..m {
        let pb = f.blocks.get(@int_cast(usize, nl[pj]));
        if rocc[@int_cast(usize, find(&mut par, tail[pj]))] {
            for k in 0..pb.succs.len {
                let si = @int_cast(usize, pb.succs.get(k));
                if g.near[si] {
                    selfld[@int_cast(usize, g.cidx[si])] = false;
                }
            }
        }
    }
    for sj in 0..m {
        let si = @int_cast(usize, nl[sj]);
        selfld[sj] = allin[sj] and (g.npred[si] > 1) and (selfld[sj] or not g.endok[si]);
    }
    let sload = u.newn.[i32](m + 1);
    for sj in 0..m {
        sload[sj] = -1;
        if selfld[sj] and bget(f.blocks.get(@int_cast(usize, nl[sj])).live_in, x) {
            let r2 = @int_cast(usize, find(&mut par, head[sj]));
            if rocc[r2] {
                sload[sj] = @int_cast(i32, r2);
            }
        }
    }
    if debug_ra {
        u.eprint(u.f2("split v%s mode %s\n", u.zdec(x), u.idec(mode)));
        for bj in 0..m {
            let bi = @int_cast(usize, nl[bj]);
            let hr = find(&mut par, head[bj]);
            let tr = find(&mut par, tail[bj]);
            u.eprint(u.f6("  b%s head %s(w%s) tail %s(w%s) sload %s\n", u.zdec(bi), u.idec(hr),
                          u.idec(wreg[@int_cast(usize, hr)]), u.idec(tr), u.idec(wreg[@int_cast(usize, tr)]),
                          u.idec(sload[bj])));
        }
    }
    // rewrite
    let mut ck: usize = 0;
    for bj in 0..m {
        let bi = @int_cast(usize, nl[bj]);
        let b = f.blocks.get(bi);
        let mut seg = head[bj];
        let lbl = g.label[bi];
        let mut i = b.first;
        let mut pend: i32 = sload[bj];  // a region to reload before the next use
        if (pend >= 0) and not g.simple[bi] {
            insert_start(b, sreload(f, t, rd, v, wreg[@int_cast(usize, pend)], c, slot));
            pend = -1;
        }
        // (where it is not named, only the calls and jumps)
        let evs = g.ev[bi].items();
        let mut ek: usize = 0;
        i = b.first;
        if not nm[bj] {
            i = u.nil.[MInst]();
            if evs.len > 0 {
                i = evs[0];
            }
        }
        while u.notnil(i) {
            let mut next = i.next;
            if not nm[bj] {
                ek += 1;
                next = u.nil.[MInst]();
                if ek < evs.len {
                    next = evs[ek];
                }
            }
            let r = @int_cast(usize, find(&mut par, seg));
            if (pend >= 0) and is_jump(i) and not mentions(i, v) {
                insert_before(b, i, sreload(f, t, rd, v, wreg[@int_cast(usize, pend)], c, slot));
                pend = -1;
            }
            if fold1[r] and real_use(f, i, v) {
                if not t.fold_remat(f, i, v, rd) {
                    let nr = new_vreg(f, c);
                    f.nospill.set(@int_cast(usize, nr - VREG0), true);
                    replace_reg(i, v, nr);
                    insert_before(b, i, sreload(f, t, rd, v, nr, c, slot));
                }
                i = next;
                continue;
            }
            if mentions(i, v) and not rocc[r] {
                // spill code of a region left in memory
                if transfer_out(f, i, v) and i.is_move {
                    let d = move_dst(i);
                    insert_before(b, i, sreload(f, t, rd, v, d, c, slot));
                }
                remove(b, i);
                i = next;
                continue;
            }
            if mentions(i, v) {
                let w = wreg[r];
                let wx = @int_cast(usize, w - VREG0);
                if pend >= 0 {
                    if not transfer_in(f, i, v) {
                        insert_before(b, i, sreload(f, t, rd, v, w, c, slot));
                    }
                    pend = -1;
                }
                if i.is_move {
                    let mut o = move_dst(i);
                    if o == v {
                        o = move_src(i);
                    }
                    if (o >= 0) and (o != v) {
                        if f.hint.get(wx) < 0 {
                            f.hint.set(wx, o);
                        }
                        if is_vreg(o) and (f.hint.get(@int_cast(usize, o - VREG0)) == v) {
                            f.hint.set(@int_cast(usize, o - VREG0), w);
                        }
                    }
                }
                let fresh = writes_reg(i, v) and real_use(f, i, v);
                replace_reg(i, v, w);
                if fresh and not at_exit[r] and not isrm {
                    insert_after(b, i, store(f, t, w, c, slot));
                }
            }
            if (ck < cuts.len) and (cuts.get(ck) == i) {
                if pend >= 0 {
                    insert_before(b, i, sreload(f, t, rd, v, wreg[@int_cast(usize, pend)], c, slot));  // (not used before the next call)
                    pend = -1;
                }
                if at_exit[r] {
                    insert_before(b, i, store(f, t, wreg[r], c, slot));
                }
                seg = cut_seg.get(ck) + 1;
                ck += 1;
                let r2 = @int_cast(usize, find(&mut par, seg));
                if rocc[r2] {
                    if lbl {
                        insert_after(b, i, sreload(f, t, rd, v, wreg[r2], c, slot));
                    } else {
                        pend = @int_cast(i32, r2);
                    }
                }
            }
            i = next;
        }
        if pend >= 0 {
            insert_end(b, sreload(f, t, rd, v, wreg[@int_cast(usize, pend)], c, slot));
        }
    }
    // along the edges that are split points
    for pj in 0..m {
        let pi = @int_cast(usize, nl[pj]);
        let pb = f.blocks.get(pi);
        let r = @int_cast(usize, find(&mut par, tail[pj]));
        let mut stored = false;
        for k in 0..pb.succs.len {
            let si = @int_cast(usize, pb.succs.get(k));
            let sb = f.blocks.get(si);
            if not bget(sb.live_in, x) or not edge_cut(f, g, &ms, pi, si) {
                continue;
            }
            let sj = @int_cast(usize, g.cidx[si]);
            if at_exit[r] and not stored {
                insert_end(pb, store(f, t, wreg[r], c, slot));  // (pb is simple: see rexit)
                stored = true;
            }
            let r2 = @int_cast(usize, find(&mut par, head[sj]));
            if not rocc[r2] or (r2 == r) {
                continue;
            }
            let w2 = wreg[r2];
            if selfld[sj] {
                continue;  // (sload)
            }
            let mut ins = u.nil.[MInst]();
            if rocc[r] {
                ins = t.spill_move(f, w2, wreg[r], @as(i32, c));
                f.hint.set(@int_cast(usize, w2 - VREG0), wreg[r]);
            } else {
                ins = sreload(f, t, rd, v, w2, c, slot);
            }
            if g.npred[si] == 1 {
                insert_start(sb, ins);
            } else {
                insert_end(pb, ins);
            }
        }
    }
    // pieces without a hint of their own take the vreg's
    for s in 0..ns {
        if wreg[s] >= 0 {
            let wx = @int_cast(usize, wreg[s] - VREG0);
            if f.hint.get(wx) < 0 {
                f.hint.set(wx, f.hint.get(x));
            }
        }
    }
    par.deinit();
    occ.deinit();
    rel.deinit();
    defc.deinit();
    cuts.deinit();
    cut_seg.deinit();
    cut_fq.deinit();
    arr.deinit();
    la.deinit();
    nrd.deinit();
    deep.deinit();
    return true;
}

// Notes block bi in r's nl (and that bi names it), if r is a spilled vreg
// of this round.
fn note_near(iv: []Interval, near: []mut u.List.[i32], named: []mut u.List.[bool], r: i32, bi: usize,
             names: bool) void {
    if not is_vreg(r) {
        return;
    }
    let x = @int_cast(usize, r - VREG0);
    if (x >= iv.len) or not iv[x].spilled {
        return;
    }
    let l = &mut near[x];
    if (l.len == 0) or (l.get(l.len - 1) != @int_cast(i32, bi)) {
        l.push(@int_cast(i32, bi));
        named[x].push(names);
    } else if names {
        named[x].set(named[x].len - 1, true);
    }
}

// Is r a vreg (of this round) spilled everywhere?
fn spilled_ev(sp: []bool, r: i32) bool {
    if not is_vreg(r) {
        return false;
    }
    let x = @int_cast(usize, r - VREG0);
    return (x < sp.len) and sp[x];
}

// Spills the vregs sp marks everywhere: each instruction reading one gets a
// load into a fresh (unspillable) vreg before it; each writing one, a store
// after it. A copy from one becomes a load into the copy's destination, a
// copy to one a store of the copy's source, and its own spill code goes.
fn spill_everywhere(f: *mut MFunc, t: *Target, sp: []bool) void {
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            if (i.spill != 0) and spilled_ev(sp, i.sreg) and (i.sslot == slot_of(f, @int_cast(usize, i.sreg - VREG0))) {
                remove(b, i);  // (it lives in that slot now)
                i = next;
                continue;
            }
            if i.is_move {
                let d = move_dst(i);
                let s = move_src(i);
                let ds = spilled_ev(sp, d);
                let ss = spilled_ev(sp, s);
                if ds and ss and (slot_of(f, @int_cast(usize, d - VREG0)) == slot_of(f, @int_cast(usize, s - VREG0))) {
                    remove(b, i);
                    i = next;
                    continue;
                }
                if ss and not ds and (d >= 0) {
                    let x = @int_cast(usize, s - VREG0);
                    insert_before(b, i, reload(f, t, d, f.vclass.get(x), slot_of(f, x)));
                    remove(b, i);
                    i = next;
                    continue;
                }
                if ds and not ss and (s >= 0) {
                    let x = @int_cast(usize, d - VREG0);
                    insert_before(b, i, store(f, t, s, f.vclass.get(x), slot_of(f, x)));
                    remove(b, i);
                    i = next;
                    continue;
                }
            }
            // distinct spilled vregs of this instruction
            let mut done: [8]i32 = [-1; 8];
            let mut nd: usize = 0;
            for k in 0..i.ops.len {
                let o = i.ops[k];
                let cands: [3]i32 = [o.reg, o.base, o.index];
                for ci in @as(usize, 0)..3 {
                    let r = cands[ci];
                    if (ci == 0) and (o.kind != K_REG) {
                        continue;
                    }
                    if (ci > 0) and (o.kind != K_MEM) {
                        continue;
                    }
                    if not spilled_ev(sp, r) {
                        continue;
                    }
                    let mut seen = false;
                    for j in 0..nd {
                        if done[j] == r {
                            seen = true;
                        }
                    }
                    if not seen and (nd < 8) {
                        done[nd] = r;
                        nd += 1;
                    }
                }
            }
            for j in 0..nd {
                let r = done[j];
                let x = @int_cast(usize, r - VREG0);
                let c = f.vclass.get(x);
                let slot = slot_of(f, x);
                let nr = new_vreg(f, c);
                f.nospill.set(@int_cast(usize, nr - VREG0), true);
                let mut reads = false;
                let mut writes = false;
                if (i.spill != 0) and (i.sreg == r) {
                    i.sreg = nr;
                }
                for k in 0..i.ops.len {
                    let o = &mut i.ops[k];
                    if (o.kind == K_REG) and (o.reg == r) {
                        o.reg = nr;
                        if (o.role & RU) != 0 {
                            reads = true;
                        }
                        if (o.role & RD) != 0 {
                            writes = true;
                        }
                    }
                    if o.kind == K_MEM {
                        if o.base == r {
                            o.base = nr;
                            reads = true;
                        }
                        if o.index == r {
                            o.index = nr;
                            reads = true;
                        }
                    }
                }
                if reads {
                    insert_before(b, i, reload(f, t, nr, c, slot));
                }
                if writes {
                    insert_after(b, i, store(f, t, nr, c, slot));
                }
            }
            i = next;
        }
    }
}

// Are a and b the same instruction (b's own vreg written as a's)?
fn same_inst(a: *MInst, b: *MInst) bool {
    if (a.op != b.op) or (a.sz != b.sz) or (a.cc != b.cc) or (a.aux != b.aux) or (a.ops.len != b.ops.len) {
        return false;
    }
    for k in 0..a.ops.len {
        let x = a.ops[k];
        let y = b.ops[k];
        if (x.kind != y.kind) or (x.role != y.role) or (x.reg != y.reg) or (x.base != y.base) or (x.index != y.index) or
           (x.scale != y.scale) or (x.disp != y.disp) or (x.sym != y.sym) or (x.slot != y.slot) or
           (x.label != y.label) {
            return false;
        }
    }
    return true;
}

// Does i define rematerialized vreg r: its definition, or (for the pieces
// of a split one, see split) a copy of it made where a piece is entered, or a
// copy from another piece? (A piece's recorded definition is a copy of the
// value's, made for building it again; the piece is defined in the code by
// the value's definition itself, its vreg renamed: the same instruction.)
fn remat_defines(f: *MFunc, i: *MInst, r: i32) bool {
    let rd = f.remat.get(@int_cast(usize, r - VREG0));
    if @ptr_cast(*MInst, rd) == @ptr_cast(*MInst, i) {
        return true;
    }
    if u.notnil(rd) and same_inst(i, rd) {
        return true;
    }
    if (i.spill == 1) and (i.sreg == r) {
        return true;
    }
    return i.is_move and (move_dst(i) == r);
}

// Which spilled rematerialized values (slot -2) are defined and read in one
// block only.
fn remat_locality(f: *MFunc, slot: []i32, local: []mut bool) void {
    let nv = local.len;
    let db = u.newn.[i32](nv + 1);
    for k in 0..nv {
        local[k] = slot[k] == -2;
        db[k] = -1;
    }
    for bi in 0..f.blocks.len {
        let mut i = f.blocks.get(bi).first;
        while u.notnil(i) {
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RD) != 0) and
                   (@int_cast(usize, o.reg - VREG0) < nv) and local[@int_cast(usize, o.reg - VREG0)] and
                   remat_defines(f, i, o.reg) {
                    let x = @int_cast(usize, o.reg - VREG0);
                    if (db[x] >= 0) and (db[x] != @int_cast(i32, bi)) {
                        local[x] = false;
                    }
                    db[x] = @int_cast(i32, bi);
                }
            }
            i = i.next;
        }
    }
    for bi in 0..f.blocks.len {
        let mut i = f.blocks.get(bi).first;
        while u.notnil(i) {
            for k in 0..i.ops.len {
                let o = i.ops[k];
                let cands: [3]i32 = [o.reg, o.base, o.index];
                for ci in @as(usize, 0)..3 {
                    let r = cands[ci];
                    if (ci == 0) and ((o.kind != K_REG) or ((o.role & RU) == 0)) {
                        continue;
                    }
                    if (ci > 0) and (o.kind != K_MEM) {
                        continue;
                    }
                    if not is_vreg(r) or (@int_cast(usize, r - VREG0) >= nv) {
                        continue;
                    }
                    let x = @int_cast(usize, r - VREG0);
                    if (slot[x] == -2) and (db[x] != @int_cast(i32, bi)) {
                        local[x] = false;
                    }
                }
            }
            i = i.next;
        }
    }
}

// Rewrites the spilled rematerialized vregs rm marks (see set_remat): no
// stack slot, its definitions go. One read only in the block defining it is
// built again at each use (or folded into it); one read elsewhere is built
// once in each block that reads it, as a value of its own (which may be
// rematerialized in turn).
fn spill_remat(f: *mut MFunc, t: *Target, rm: []bool) void {
    let nv = rm.len;
    let slot = u.newn.[i32](nv + 1);
    for k in 0..nv {
        slot[k] = -1;
        if rm[k] {
            slot[k] = -2;
        }
    }
    let local = u.newn.[bool](nv + 1);
    let bv = u.newn.[i32](nv + 1);  // the value's copy in block bb[x]
    let bb = u.newn.[i32](nv + 1);
    remat_locality(f, slot[0..nv], local[0..nv]);
    for k in 0..nv {
        bb[k] = -1;
    }
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            let mut done: [8]i32 = [-1; 8];
            let mut nd: usize = 0;
            let mut gone = false;
            for k in 0..i.ops.len {
                let o = i.ops[k];
                let cands: [3]i32 = [o.reg, o.base, o.index];
                for ci in @as(usize, 0)..3 {
                    let r = cands[ci];
                    if ((ci == 0) and (o.kind != K_REG)) or ((ci > 0) and (o.kind != K_MEM)) {
                        continue;
                    }
                    if not is_vreg(r) or (@int_cast(usize, r - VREG0) >= nv) or not rm[@int_cast(usize, r - VREG0)] {
                        continue;
                    }
                    if (ci == 0) and ((o.role & RD) != 0) and remat_defines(f, i, r) {
                        gone = true;
                    }
                    let mut seen = false;
                    for j in 0..nd {
                        if done[j] == r {
                            seen = true;
                        }
                    }
                    if not seen and (nd < 8) {
                        done[nd] = r;
                        nd += 1;
                    }
                }
            }
            if gone {
                remove(b, i);
                i = next;
                continue;
            }
            for j in 0..nd {
                let r = done[j];
                let x = @int_cast(usize, r - VREG0);
                let c = f.vclass.get(x);
                let def = f.remat.get(x);
                if not local[x] {
                    let mut nr = bv[x];
                    if bb[x] != @int_cast(i32, bi) {
                        nr = new_vreg(f, c);
                        let cd = clone_def(def, r, nr);
                        insert_before(b, i, cd);
                        set_remat(f, nr, cd);
                        bv[x] = nr;
                        bb[x] = @int_cast(i32, bi);
                    }
                    replace_reg(i, r, nr);
                    continue;
                }
                if t.fold_remat(f, i, r, def) {
                    continue;
                }
                let nr = new_vreg(f, c);
                f.nospill.set(@int_cast(usize, nr - VREG0), true);
                replace_reg(i, r, nr);
                let ld = clone_def(def, r, nr);
                ld.spill = 1;
                ld.sreg = nr;
                ld.sslot = f.vslot.get(x);  // (the value's own pseudo slot (see split): drop_reloads drops repeats)
                if ld.sslot >= -1 {
                    ld.sslot = -2 - @int_cast(i32, x);
                }
                insert_before(b, i, ld);
            }
            i = next;
        }
    }
}

// Rewrites the spilled vregs: split (see above), spilled everywhere, or
// rematerialized.
fn rewrite_spills(f: *mut MFunc, t: *Target, iv: []mut Interval) void {
    let nv = iv.len;
    let nb = f.blocks.len;
    let g = Cfg.{ npred: u.newn.[i32](nb + 1), nsucc: u.newn.[i32](nb + 1), simple: u.newn.[bool](nb + 1),
                  endok: u.newn.[bool](nb + 1), label: u.newn.[bool](nb + 1), near: u.newn.[bool](nb + 1),
                  cidx: u.newn.[i32](nb + 1), ev: u.newn.[u.List.[*mut MInst]](nb + 1) };
    for bi in 0..nb {
        g.npred[bi] = 0;
        g.label[bi] = false;
        g.ev[bi] = u.List.[*mut MInst].empty();
        // simple: no labels, and nothing but jumps after the first jump
        let b = f.blocks.get(bi);
        let mut ok = true;
        let mut jumped = false;
        let mut i = b.first;
        while u.notnil(i) {
            if t.is_label(i) {
                ok = false;
                g.label[bi] = true;
            }
            if is_jump(i) {
                jumped = true;
            } else if jumped {
                ok = false;
            }
            if jumped or (i.clobber != 0) {
                g.ev[bi].push(i);
            }
            i = i.next;
        }
        g.simple[bi] = ok;
    }
    for bi in 0..nb {
        g.endok[bi] = true;
    }
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        for k in 0..b.succs.len {
            if (b.succs.len != 1) or not g.simple[bi] {
                g.endok[@int_cast(usize, b.succs.get(k))] = false;
            }
        }
    }
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        g.nsucc[bi] = @int_cast(i32, b.succs.len);
        for k in 0..b.succs.len {
            g.npred[@int_cast(usize, b.succs.get(k))] += 1;
        }
    }
    // the blocks each spilled vreg is live into or out of, or named in, in
    // order (splitting one adds no mention of another: its spill code names
    // only its own pieces): split looks at no other block
    let near = u.newn.[u.List.[i32]](nv + 1);
    let named = u.newn.[u.List.[bool]](nv + 1);  // ... whether it names it
    for k in 0..nv {
        near[k] = u.List.[i32].empty();
        named[k] = u.List.[bool].empty();
    }
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        let nw = @min(words(nv), @min(b.live_in.len, b.live_out.len));
        for w in 0..nw {
            let mut bits = b.live_in[w] | b.live_out[w];
            while bits != 0 {
                let x = (w * 64) + @int_cast(usize, @ctz(bits));
                bits = bits & (bits - 1);
                note_near(iv, near, named, VREG0 + @int_cast(i32, x), bi, false);
            }
        }
        let mut i = b.first;
        while u.notnil(i) {
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if o.kind == K_REG {
                    note_near(iv, near, named, o.reg, bi, true);
                } else if o.kind == K_MEM {
                    note_near(iv, near, named, o.base, bi, true);
                    note_near(iv, near, named, o.index, bi, true);
                }
            }
            i = i.next;
        }
    }
    for bi in 0..nb {
        g.near[bi] = false;
    }
    let every = u.newn.[bool](nv + 1);
    let rm = u.newn.[bool](nv + 1);
    for k in 0..nv {
        every[k] = false;
        rm[k] = false;
        if not iv[k].spilled {
            continue;
        }
        let nl = near[k].items();
        let nm = named[k].items();
        for j in 0..nl.len {
            g.near[@int_cast(usize, nl[j])] = true;
            g.cidx[@int_cast(usize, nl[j])] = @int_cast(i32, j);
        }
        let lv = f.level.get(k);
        if u.notnil(f.remat.get(k)) {
            // split around calls and loops, then between the stretches of
            // code that use it; then built again in each block reading it
            let mut sp = false;
            if lv == 0 {
                sp = split(f, t, &g, k, SPLIT_LOOPS, 1, nl, nm);
            }
            if not sp and (lv <= 1) {
                sp = split(f, t, &g, k, SPLIT_GAPS, 2, nl, nm);
            }
            rm[k] = not sp;
            for j in 0..nl.len {
                g.near[@int_cast(usize, nl[j])] = false;
            }
            continue;
        }
        let mut done = false;
        if lv == 0 {
            done = split(f, t, &g, k, SPLIT_LOOPS, 1, nl, nm);
        }
        if not done and (lv <= 1) {
            done = split(f, t, &g, k, SPLIT_GAPS, 2, nl, nm);
        }
        if not done and (lv <= 2) {
            done = split(f, t, &g, k, SPLIT_ALL, 3, nl, nm);
        }
        every[k] = not done;
        for j in 0..nl.len {
            g.near[@int_cast(usize, nl[j])] = false;
        }
    }
    spill_everywhere(f, t, every[0..nv]);
    spill_remat(f, t, rm[0..nv]);
}

// Reloads of values nothing reads (splitting leaves them behind) are
// deleted. (They read no vreg, so liveness stays as it is.)
fn drop_dead_reloads(f: *mut MFunc) void {
    let nv = nvregs(f);
    let w = words(nv);
    let live = u.newn.[u64](w + 1);
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        for j in 0..w {
            live[j] = b.live_out[j];
        }
        let mut i = b.last;
        while u.notnil(i) {
            let prev = i.prev;
            if (i.spill == 1) and is_vreg(i.sreg) and not bget(live, @int_cast(usize, i.sreg - VREG0)) {
                remove(b, i);
                i = prev;
                continue;
            }
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RD) != 0) and ((o.role & RU) == 0) {
                    bclr(live, @int_cast(usize, o.reg - VREG0));
                }
            }
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RU) != 0) {
                    bset(live, @int_cast(usize, o.reg - VREG0));
                }
                if o.kind == K_MEM {
                    if is_vreg(o.base) {
                        bset(live, @int_cast(usize, o.base - VREG0));
                    }
                    if is_vreg(o.index) {
                        bset(live, @int_cast(usize, o.index - VREG0));
                    }
                }
            }
            i = prev;
        }
    }
}

// -----------------------------------------------------------------------------
// Coalescing (before allocation): the two sides of a copy between virtual
// registers of a class become one register, and the copy goes, where their
// lives do not overlap, or where they are the same value (the copy is the
// destination's only definition, the source has one, and the destination
// is not live where the source is defined). Hottest copies first. Linear
// scan's hints alone depend on the order intervals start in; pieces split
// apart later are copies again.
// -----------------------------------------------------------------------------
struct CopyAt {
    i: *mut MInst,
    fq: f64,
}

fn hotter(a: CopyAt, b: CopyAt) i32 {
    if a.fq > b.fq {
        return -1;
    }
    if a.fq < b.fq {
        return 1;
    }
    return 0;
}

fn ranges_meet(a: *u.List.[Range], b: *u.List.[Range]) bool {
    let mut i: usize = 0;
    let mut j: usize = 0;
    while (i < a.len) and (j < b.len) {
        let x = a.get(i);
        let y = b.get(j);
        if x.e < y.s {
            i += 1;
        } else if y.e < x.s {
            j += 1;
        } else {
            return true;
        }
    }
    return false;
}

fn ranges_cover(a: *u.List.[Range], p: i32) bool {
    for k in 0..a.len {
        let x = a.get(k);
        if (x.s <= p) and (p <= x.e) {
            return true;
        }
    }
    return false;
}

// a's ranges and b's, merged (sorted, adjacent and overlapping ones joined)
fn ranges_union(a: *u.List.[Range], b: *u.List.[Range]) u.List.[Range] {
    let mut out = u.List.[Range].empty();
    let mut i: usize = 0;
    let mut j: usize = 0;
    while (i < a.len) or (j < b.len) {
        let mut r = Range.{ s: 0, e: 0 };
        if (j >= b.len) or ((i < a.len) and (a.get(i).s <= b.get(j).s)) {
            r = a.get(i);
            i += 1;
        } else {
            r = b.get(j);
            j += 1;
        }
        if (out.len > 0) and (r.s <= (out.get(out.len - 1).e + 1)) {
            let l = out.at(out.len - 1);
            if r.e > l.e {
                l.e = r.e;
            }
        } else {
            out.push(r);
        }
    }
    return out;
}

fn rep_of(rep: []mut i32, x: i32) i32 {
    let mut r = x;
    while rep[@int_cast(usize, r)] != r {
        r = rep[@int_cast(usize, r)];
    }
    let mut y = x;
    while rep[@int_cast(usize, y)] != r {
        let n = rep[@int_cast(usize, y)];
        rep[@int_cast(usize, y)] = r;
        y = n;
    }
    return r;
}

fn coalesce(f: *mut MFunc) void {
    liveness(f);
    number(f);
    let iv = build_intervals(f);
    let nv = iv.len;
    let rep = u.newn.[i32](nv + 1);
    let ndef = u.newn.[i32](nv + 1);
    let dpos = u.newn.[i32](nv + 1);  // (a definition's position)
    // every definition's position, of the registers defined more than once
    let defs = u.newn.[u.List.[i32]](nv + 1);
    for k in 0..nv {
        rep[k] = @int_cast(i32, k);
        ndef[k] = 0;
        dpos[k] = -1;
        defs[k] = u.List.[i32].empty();
    }
    let mut copies = u.List.[CopyAt].empty();
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        // a copy in a block of nothing but copies and jumps (a split edge)
        // goes first among equally hot ones: that block can then go too,
        // with the jump around the other copy's block
        let mut fq = b.freq;
        let mut only = true;
        let mut j = b.first;
        while u.notnil(j) {
            if not j.is_move and not is_jump(j) {
                only = false;
            }
            j = j.next;
        }
        if only {
            fq = fq * 1.0001;
        }
        let mut i = b.first;
        while u.notnil(i) {
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RD) != 0) {
                    let x = @int_cast(usize, o.reg - VREG0);
                    if dpos[x] != i.pos {
                        ndef[x] += 1;
                        defs[x].push(i.pos);
                    }
                    dpos[x] = i.pos;
                }
            }
            if i.is_move and not i.keep {
                let d = move_dst(i);
                let sr = move_src(i);
                if is_vreg(d) and is_vreg(sr) and (d != sr) and
                   (f.vclass.get(@int_cast(usize, d - VREG0)) == f.vclass.get(@int_cast(usize, sr - VREG0))) {
                    copies.push(CopyAt.{ i: i, fq: fq });
                }
            }
            i = i.next;
        }
    }
    u.sort(copies.items(), hotter);
    let mut merged = false;
    for ci in 0..copies.len {
        let i = copies.get(ci).i;
        let a = rep_of(rep, move_src(i) - VREG0);
        let b = rep_of(rep, move_dst(i) - VREG0);
        if a == b {
            continue;
        }
        let ax = @int_cast(usize, a);
        let bx = @int_cast(usize, b);
        if f.nospill.get(ax) or f.nospill.get(bx) {
            continue;
        }
        let mut ok = not ranges_meet(&iv[ax].ranges, &iv[bx].ranges);
        if not ok and (ndef[bx] == 1) and (dpos[bx] == i.pos) {
            // the same value while b lives: no definition of a (one, or
            // several: a phi's) where b is live
            ok = true;
            for k in 0..defs[ax].len {
                if ranges_cover(&iv[bx].ranges, (2 * defs[ax].get(k)) + 1) {
                    ok = false;
                }
            }
        }
        if not ok {
            if debug_ra {
                u.eprint(u.f4("keep v%s v%s at %s (defs %s)\n", u.idec(a), u.idec(b), u.idec(i.pos), u.idec(ndef[bx])));
            }
            continue;
        }
        // a constant that is rebuilt where it is needed (remat) stays so:
        // joined to a register defined again (the destination of a
        // two-address instruction), it would be kept in a register for its
        // whole life
        if (ndef[ax] + ndef[bx] > 2) and (u.notnil(f.remat.get(ax)) or u.notnil(f.remat.get(bx))) {
            continue;
        }
        // b joins a; the copy defined b
        if debug_ra {
            u.eprint(u.f4("merge v%s v%s (%s %s)\n", u.idec(a), u.idec(b), u.idec(iv[ax].size), u.idec(iv[bx].size)));
        }
        let un = ranges_union(&iv[ax].ranges, &iv[bx].ranges);
        u.free(@ptr_cast(*mut void, iv[ax].ranges.data));
        u.free(@ptr_cast(*mut void, iv[bx].ranges.data));
        iv[ax].ranges = un;
        iv[bx].ranges = u.List.[Range].empty();
        let nd = (ndef[ax] + ndef[bx]) - 1;
        let mut rm = u.nil.[MInst]();
        if (nd == 1) and (ndef[ax] == 1) {
            rm = f.remat.get(ax);
        } else if (nd == 1) and (ndef[bx] == 2) {
            rm = f.remat.get(bx);  // (the other definition)
            dpos[ax] = -1;
            if u.notnil(rm) {
                dpos[ax] = rm.pos;
            }
        }
        f.remat.set(ax, rm);
        ndef[ax] = nd;
        for k in 0..defs[bx].len {
            if defs[bx].get(k) != i.pos {
                defs[ax].push(defs[bx].get(k));
            }
        }
        if (f.hint.get(ax) < 0) or (is_vreg(f.hint.get(ax)) and not is_vreg(f.hint.get(bx)) and (f.hint.get(bx) >= 0)) {
            f.hint.set(ax, f.hint.get(bx));
        }
        rep[bx] = a;
        merged = true;
    }
    if merged {
        for bi in 0..f.blocks.len {
            let b = f.blocks.get(bi);
            let mut i = b.first;
            while u.notnil(i) {
                let next = i.next;
                for k in 0..i.ops.len {
                    let o = &mut i.ops[k];
                    if (o.kind == K_REG) and is_vreg(o.reg) {
                        o.reg = VREG0 + rep_of(rep, o.reg - VREG0);
                    }
                    if o.kind == K_MEM {
                        if is_vreg(o.base) {
                            o.base = VREG0 + rep_of(rep, o.base - VREG0);
                        }
                        if is_vreg(o.index) {
                            o.index = VREG0 + rep_of(rep, o.index - VREG0);
                        }
                    }
                }
                if i.is_move and (move_dst(i) == move_src(i)) {
                    remove(b, i);
                }
                i = next;
            }
        }
        // hints naming a merged register name its representative
        for k in 0..nv {
            let h = f.hint.get(k);
            if is_vreg(h) and (@int_cast(usize, h - VREG0) < nv) {
                let r = VREG0 + rep_of(rep, h - VREG0);
                if r == (VREG0 + @int_cast(i32, k)) {
                    f.hint.set(k, -1);
                } else {
                    f.hint.set(k, r);
                }
            }
        }
    }
    for k in 0..nv {
        u.free(@ptr_cast(*mut void, iv[k].ranges.data));
        u.free(@ptr_cast(*mut void, defs[k].data));
    }
    copies.deinit();
}

// Allocates registers; afterwards f.assign maps every vreg to a physical
// register.
// The uses of rematerialized values, counted by what keeping them in a
// register saves: nothing at their definition (it goes) or where they are
// copied (built straight into the copy's register instead), little where
// an instruction can read them from memory (only outside loops: there the
// read repeats), else an instruction.
fn remat_uses(f: *mut MFunc, t: *Target, iv: []mut Interval) void {
    let nv = iv.len;
    let mut any = false;
    for k in 0..nv {
        if u.notnil(f.remat.get(k)) and (iv[k].e >= 0) {
            iv[k].uses = 0.0;
            any = true;
        }
    }
    if not any {
        return;
    }
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        let fq = b.freq;
        let mut i = b.first;
        while u.notnil(i) {
            let mut done: [8]i32 = [-1; 8];
            let mut nd: usize = 0;
            for k in 0..i.ops.len {
                let o = i.ops[k];
                let cands: [3]i32 = [o.reg, o.base, o.index];
                for ci in @as(usize, 0)..3 {
                    let r = cands[ci];
                    if ((ci == 0) and ((o.kind != K_REG) or ((o.role & RU) == 0))) or ((ci > 0) and (o.kind != K_MEM)) {
                        continue;
                    }
                    if not is_vreg(r) or (@int_cast(usize, r - VREG0) >= nv) or
                       u.isnil(f.remat.get(@int_cast(usize, r - VREG0))) {
                        continue;
                    }
                    let mut seen = false;
                    for j in 0..nd {
                        if done[j] == r {
                            seen = true;
                        }
                    }
                    if not seen and (nd < 8) {
                        done[nd] = r;
                        nd += 1;
                    }
                }
            }
            for j in 0..nd {
                let r = done[j];
                let x = @int_cast(usize, r - VREG0);
                let def = f.remat.get(x);
                if def == i {
                    continue;  // ((reading itself: a zeroing idiom))
                }
                let mut cost: f64 = 1.0;
                if i.is_move and (move_src(i) == r) {
                    cost = 0.0;
                } else {
                    let tr = clone_def(i, -1, -1);
                    if t.fold_remat(f, tr, r, def) {
                        cost = 0.5;
                        if b.loop_depth == 0 {
                            cost = 0.0;
                        }
                    }
                }
                iv[x].uses += cost * fq;
            }
            i = i.next;
        }
    }
}

pub fn allocate(f: *mut MFunc, t: *Target) void {
    let mut rounds: i32 = 0;
    block_freqs(f);
    if debug_ra {
        dump(f, "before allocation");
    }
    coalesce(f);
    loop {
        liveness(f);
        drop_dead_reloads(f);
        number(f);
        build_fixed(f);
        let iv = build_intervals(f);
        remat_uses(f, t, iv);
        if debug_ra {
            for k in 0..iv.len {
                let x = &iv[k];
                if x.e >= 0 {
                    u.eprint(u.f6("v%s c%s l%s s%s w%s [%s", u.zdec(k), u.idec(@as(i32, f.vclass.get(k))),
                                  u.idec(@as(i32, f.level.get(k))), u.idec(x.size),
                                  u.dec(@int_from_float(i64, weight(f, x) * 1000000.0)), u.idec(x.s)));
                    u.eprint(u.f2(",%s] h%s\n", u.idec(x.e), u.idec(f.hint.get(k))));
                }
            }
        }
        let ns = greedy(f, t, iv);
        if debug_ra {
            u.eprint(u.f1("round %s\n", u.idec(rounds)));
        }
        rounds += 1;
        if ns == 0 {
            let nv = iv.len;
            f.assign = u.newn.[i32](nv + 1);
            f.used_regs = 0;
            for k in 0..nv {
                f.assign[k] = iv[k].reg;
                if iv[k].reg >= 0 {
                    f.used_regs = f.used_regs | (@as(u64, 1) << @int_cast(u32, iv[k].reg));
                }
            }
            if debug_ra {
                dump(f, "allocated");
            }
            return;
        }
        if rounds > 40 {
            u.die("internal compiler error: register allocation did not converge");
        }
        rewrite_spills(f, t, iv);
        if debug_ra {
            dump(f, "rewritten");
        }
    }
}

// -----------------------------------------------------------------------------
// Shrink-wrapping: a function that can return early, before it needs its
// frame (a recursion's base case, a guard), sets the frame up only past that.
// The blocks reachable from the entry without passing block k (the
// frameless ones, MBlock.noframe) reach only each other, returns and block k,
// which only they reach; they make no calls and use no stack and none of
// `regs` (the callee-saved registers, which block k saves). The values live
// into block k continue there as new vregs (copies the coalescing keeps, or
// a constant built again), so that the ones a call clobbers can live in the
// frameless blocks in registers it does not save. Of the blocks k that
// qualify, the one whose frameless blocks return most often is taken.
// Returns k, or -1 when there is none (or no early return). `frame_free` says
// an instruction needs no frame, `movable` that it is a rematerialized
// definition (a stack argument's load) that can be made in block k instead,
// when only later blocks read its value. The target checks again after
// allocation (a spill in those blocks needs the frame after all).
// -----------------------------------------------------------------------------
fn movable_def(f: *MFunc, i: *MInst, movable: fn(*MInst) bool) bool {
    if not movable(i) {
        return false;
    }
    let d = move_dst(i);
    return is_vreg(d) and (@ptr_cast(*MInst, f.remat.get(@int_cast(usize, d - VREG0))) == i);
}

// The blocks reachable from `from` without entering one `stop` marks: mark[b] = tag.
fn reach(f: *MFunc, from: usize, stop: []i32, stop_tag: i32, mark: []mut i32, tag: i32, stk: *mut u.List.[i32]) void {
    stk.clear();
    mark[from] = tag;
    stk.push(@int_cast(i32, from));
    while stk.len > 0 {
        let b = f.blocks.get(@int_cast(usize, stk.pop()));
        for j in 0..b.succs.len {
            let s = @int_cast(usize, b.succs.get(j));
            if (mark[s] != tag) and (stop[s] != stop_tag) {
                mark[s] = tag;
                stk.push(@int_cast(i32, s));
            }
        }
    }
}

pub fn shrink_wrap(f: *mut MFunc, t: *Target, regs: u64, frame_free: fn(*MInst) bool, movable: fn(*MInst) bool,
                   is_ret: fn(*MInst) bool) i32 {
    let nb = f.blocks.len;
    if (nb < 3) or (nb > 1000) {
        return -1;
    }
    let ff = u.newn.[bool](nb + 1);   // needs no frame
    let ret = u.newn.[bool](nb + 1);  // returns
    let mut any = false;
    for bi in 0..nb {
        ff[bi] = true;
        ret[bi] = false;
        let mut i = f.blocks.get(bi).first;
        while u.notnil(i) {
            if not frame_free(i) and not movable_def(f, i, movable) {
                ff[bi] = false;
            }
            if is_ret(i) {
                ret[bi] = true;
            }
            i = i.next;
        }
        if ff[bi] and ret[bi] and (bi > 0) {
            any = true;
        }
    }
    if not ff[0] or not any {
        return -1;
    }
    block_freqs(f);
    let body = u.newn.[i32](nb + 1);  // body[b] == k: reachable from block k
    let pre = u.newn.[i32](nb + 1);   // pre[b] == k: reachable from the entry before block k
    for bi in 0..nb {
        body[bi] = -1;
        pre[bi] = -1;
    }
    let mut stk = u.List.[i32].empty();
    let mut best: i32 = -1;
    let mut best_fq: f64 = 0.0;
    for k in @as(usize, 1)..nb {
        let tag = @int_cast(i32, k);
        reach(f, k, body[0..nb], -2, body[0..nb], tag, &mut stk);
        if body[0] == tag {
            continue;  // (block k reaches the entry: a loop around the whole function)
        }
        reach(f, 0, body[0..nb], tag, pre[0..nb], tag, &mut stk);
        let mut ok = true;
        let mut fq: f64 = 0.0;
        for bi in 0..nb {
            if pre[bi] != tag {
                continue;
            }
            let b = f.blocks.get(bi);
            if not ff[bi] {
                ok = false;
                break;
            }
            if ret[bi] {
                fq += b.freq;
            }
            for j in 0..b.succs.len {
                let s = @int_cast(usize, b.succs.get(j));
                if (pre[s] != tag) and (s != k) {
                    ok = false;  // (into the body past block k)
                }
            }
        }
        // block k is entered only from the frameless blocks
        for bi in 0..nb {
            let b = f.blocks.get(bi);
            for j in 0..b.succs.len {
                if (@int_cast(usize, b.succs.get(j)) == k) and (pre[bi] != tag) {
                    ok = false;
                }
            }
        }
        if ok and (fq > best_fq) {
            best = tag;
            best_fq = fq;
        }
    }
    stk.deinit();
    if best < 0 {
        return -1;
    }
    let k = @int_cast(usize, best);
    // the frameless blocks again
    reach(f, k, body[0..nb], -2, body[0..nb], -3, &mut stk);
    reach(f, 0, body[0..nb], -3, pre[0..nb], -3, &mut stk);
    liveness(f);
    let tb = f.blocks.get(k);
    let nv = nvregs(f);
    let mut ren = u.List.[i32].empty();  // (old, new) pairs
    for x in 0..nv {
        if bget(tb.live_in, x) {
            ren.push(VREG0 + @int_cast(i32, x));
            ren.push(new_vreg(f, f.vclass.get(x)));
        }
    }
    // block k and those after it name the new vregs, which block k sets first
    for bi in 0..nb {
        if body[bi] != -3 {
            continue;
        }
        let mut i = f.blocks.get(bi).first;
        while u.notnil(i) {
            let mut j: usize = 0;
            while j < ren.len {
                if mentions(i, ren.get(j)) {
                    replace_reg(i, ren.get(j), ren.get(j + 1));
                }
                j += 2;
            }
            i = i.next;
        }
    }
    let first = tb.first;
    let mut j: usize = 0;
    while j < ren.len {
        let v = ren.get(j);
        let w = ren.get(j + 1);
        let x = @int_cast(usize, v - VREG0);
        let c = f.vclass.get(x);
        let def = f.remat.get(x);
        let mut ins = u.nil.[MInst]();
        if u.notnil(def) {
            ins = clone_def(def, v, w);
            set_remat(f, w, ins);
        } else {
            ins = t.spill_move(f, w, v, @as(i32, c));
            ins.keep = true;
            f.hint.set(@int_cast(usize, w - VREG0), v);
        }
        if u.notnil(first) {
            insert_before(tb, first, ins);
        } else {
            append(tb, ins);
        }
        j += 2;
    }
    // definitions left without a reader in the frameless blocks
    for bi in 0..nb {
        if pre[bi] != -3 {
            continue;
        }
        let b = f.blocks.get(bi);
        b.noframe = true;
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            if movable_def(f, i, movable) {
                let d = move_dst(i);
                let mut read = false;
                for bj in 0..nb {
                    if pre[bj] != -3 {
                        continue;
                    }
                    let mut q = f.blocks.get(bj).first;
                    while u.notnil(q) {
                        if (q != i) and mentions(q, d) {
                            read = true;
                        }
                        q = q.next;
                    }
                }
                if not read {
                    remove(b, i);
                    f.remat.set(@int_cast(usize, d - VREG0), u.nil.[MInst]());
                }
            }
            i = next;
        }
    }
    f.noframe_regs = regs;
    ren.deinit();
    return best;
}

// The physical register for r (a vreg after allocation, or physical).
pub fn phys(f: *MFunc, r: i32) i32 {
    if is_vreg(r) {
        return f.assign[@int_cast(usize, r - VREG0)];
    }
    return r;
}

// -----------------------------------------------------------------------------
// Dead instructions: `pure` instructions (no effect but their register
// results, no flags anything reads) whose virtual register results are never
// read are deleted, repeatedly (address arithmetic folded into memory
// operands leaves such chains behind).
// -----------------------------------------------------------------------------
fn reads_of(i: *MInst, v: i32) i32 {
    let mut n: i32 = 0;
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and (o.reg == v) and ((o.role & RU) != 0) {
            n += 1;
        }
        if o.kind == K_MEM {
            if o.base == v {
                n += 1;
            }
            if o.index == v {
                n += 1;
            }
        }
    }
    return n;
}

fn count_reads(i: *MInst, cnt: []mut i32, delta: i32) void {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and is_vreg(o.reg) and ((o.role & RU) != 0) {
            cnt[@int_cast(usize, o.reg - VREG0)] += delta;
        }
        if o.kind == K_MEM {
            if is_vreg(o.base) {
                cnt[@int_cast(usize, o.base - VREG0)] += delta;
            }
            if is_vreg(o.index) {
                cnt[@int_cast(usize, o.index - VREG0)] += delta;
            }
        }
    }
}

fn dead(i: *MInst, cnt: []mut i32) bool {
    let mut defs: i32 = 0;
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and ((o.role & RD) != 0) {
            if not is_vreg(o.reg) {
                return false;  // a physical register (an argument, say)
            }
            if (cnt[@int_cast(usize, o.reg - VREG0)] - reads_of(i, o.reg)) != 0 {
                return false;
            }
            defs += 1;
        }
    }
    return defs > 0;
}

pub fn dce(f: *mut MFunc, pure: fn(*MInst) bool) void {
    let cnt = u.newn.[i32](nvregs(f) + 1);
    for bi in 0..f.blocks.len {
        let mut i = f.blocks.get(bi).first;
        while u.notnil(i) {
            count_reads(i, cnt, 1);
            i = i.next;
        }
    }
    let mut changed = true;
    while changed {
        changed = false;
        for bi in 0..f.blocks.len {
            let b = f.blocks.get(bi);
            let mut i = b.last;
            while u.notnil(i) {
                let prev = i.prev;
                if pure(i) and dead(i, cnt) {
                    count_reads(i, cnt, -1);
                    remove(b, i);
                    changed = true;
                }
                i = prev;
            }
        }
    }
}

// -----------------------------------------------------------------------------
// After allocation: a reload into a register that already holds the slot's
// value (stored or reloaded earlier in the block, the register unchanged
// since) is dropped, and so is a store of a value the slot already holds.
// Spill slots are private to the spill code, so only register writes (and
// calls' clobbers) end what a register holds.
// -----------------------------------------------------------------------------
// What register r holds at a block's start (drop_reloads): a spill slot
// (or rematerialized value), HOLDS_NONE, or HOLDS_ANY (not known yet: no
// predecessor done).
const HOLDS_NONE: i32 = -1000000000;
const HOLDS_ANY: i32 = -1000000001;
const HOLDS_COPY: i32 = -500000000;  // minus the position of a copy: the value it copied

// The holdings of registers after instruction i (a reload, a spill store, or
// anything writing registers); false at a local label (reached by jumps
// too: nothing known).
fn holds_step(f: *MFunc, i: *MInst, holds: []mut i32, is_label: fn(*MInst) bool, full_copy: fn(*MInst) bool) void {
    if is_label(i) {
        for q in @as(usize, 0)..64 {
            holds[q] = HOLDS_NONE;
        }
        return;
    }
    if (i.spill == 0) and full_copy(i) {
        // a copy: the destination holds what the source does (a value
        // named by this copy, if nothing else)
        let d = @int_cast(usize, phys(f, move_dst(i)));
        let sr = @int_cast(usize, phys(f, move_src(i)));
        if holds[sr] == HOLDS_NONE {
            holds[sr] = HOLDS_COPY - i.pos;
        }
        holds[d] = holds[sr];
        return;
    }
    if i.spill != 0 {
        let r = phys(f, i.sreg);
        if i.spill == 2 {
            for q in @as(usize, 0)..64 {
                if holds[q] == i.sslot {
                    holds[q] = HOLDS_NONE;
                }
            }
        }
        holds[@int_cast(usize, r)] = i.sslot;
        return;
    }
    if i.clobber != 0 {
        for q in @as(usize, 0)..64 {
            if (i.clobber & (@as(u64, 1) << @int_cast(u32, q))) != 0 {
                holds[q] = HOLDS_NONE;
            }
        }
    }
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == K_REG) and ((o.role & (RD | RE)) != 0) {
            let p = phys(f, o.reg);
            if (p >= 0) and (p < 64) {
                holds[@int_cast(usize, p)] = HOLDS_NONE;
            }
        }
    }
}

// Reloads of a value a register still holds (from a reload or spill store
// before, in this block or on every path into it: a value kept in its
// register around a loop that does not touch it) are deleted, and so are
// spill stores nothing reads before the slot is stored again.
pub fn drop_reloads(f: *mut MFunc, is_label: fn(*MInst) bool, full_copy: fn(*MInst) bool) void {
    let nb = f.blocks.len;
    let ins = u.newn.[i32]((nb * 64) + 1);  // per block: what each register holds at its start
    let outs = u.newn.[i32]((nb * 64) + 1);
    for k in 0..(nb * 64) {
        ins[k] = HOLDS_ANY;
        outs[k] = HOLDS_ANY;
    }
    // predecessors (from the successors liveness uses)
    let npred = u.newn.[i32](nb + 1);
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        for k in 0..b.succs.len {
            npred[@int_cast(usize, b.succs.get(k))] += 1;
        }
    }
    let pstart = u.newn.[i32](nb + 2);
    for bi in 0..nb {
        pstart[bi + 1] = pstart[bi] + npred[bi];
    }
    let preds = u.newn.[i32](@int_cast(usize, pstart[nb]) + 1);
    let pfill = u.newn.[i32](nb + 1);
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        for k in 0..b.succs.len {
            let si = @int_cast(usize, b.succs.get(k));
            preds[@int_cast(usize, pstart[si] + pfill[si])] = @int_cast(i32, bi);
            pfill[si] += 1;
        }
    }
    let cur = u.newn.[i32](64);
    // (a block whose predecessors' outs are as when it was last done would
    // come out the same: it is skipped)
    let stale = u.newn.[bool](nb + 1);
    for bi in 0..nb {
        stale[bi] = true;
    }
    let mut changed = true;
    let mut rounds: i32 = 0;
    while changed and (rounds < 20) {
        changed = false;
        rounds += 1;
        for bi in 0..nb {
            if not stale[bi] {
                continue;
            }
            stale[bi] = false;
            let b = f.blocks.get(bi);
            // meet over the predecessors (none: the entry, or unreachable)
            for q in @as(usize, 0)..64 {
                cur[q] = HOLDS_ANY;
            }
            if (bi == 0) or (npred[bi] == 0) {
                for q in @as(usize, 0)..64 {
                    cur[q] = HOLDS_NONE;
                }
            }
            for k in @int_cast(usize, pstart[bi])..@int_cast(usize, pstart[bi + 1]) {
                let pi = @int_cast(usize, preds[k]);
                for q in @as(usize, 0)..64 {
                    let v = outs[(pi * 64) + q];
                    if v == HOLDS_ANY {
                        continue;
                    }
                    if cur[q] == HOLDS_ANY {
                        cur[q] = v;
                    } else if cur[q] != v {
                        cur[q] = HOLDS_NONE;
                    }
                }
            }
            for q in @as(usize, 0)..64 {
                ins[(bi * 64) + q] = cur[q];
            }
            let mut i = b.first;
            while u.notnil(i) {
                holds_step(f, i, cur, is_label, full_copy);
                i = i.next;
            }
            let mut grew = false;
            for q in @as(usize, 0)..64 {
                if outs[(bi * 64) + q] != cur[q] {
                    outs[(bi * 64) + q] = cur[q];
                    grew = true;
                }
            }
            if grew {
                changed = true;
                for k in 0..b.succs.len {
                    stale[@int_cast(usize, b.succs.get(k))] = true;
                }
            }
        }
    }
    if changed {
        // (no fixed point: only what each block knows itself)
        for k in 0..(nb * 64) {
            ins[k] = HOLDS_NONE;
        }
    }
    let mut pend = u.List.[*mut MInst].empty();  // stores not read yet
    for bi in 0..nb {
        let b = f.blocks.get(bi);
        for q in @as(usize, 0)..64 {
            cur[q] = ins[(bi * 64) + q];
            if cur[q] == HOLDS_ANY {
                cur[q] = HOLDS_NONE;
            }
        }
        pend.clear();
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            if (i.spill == 0) and full_copy(i) and (cur[@int_cast(usize, phys(f, move_dst(i)))] != HOLDS_NONE) and
               (cur[@int_cast(usize, phys(f, move_dst(i)))] == cur[@int_cast(usize, phys(f, move_src(i)))]) {
                remove(b, i);  // a copy of a register to one holding the same already
                i = next;
                continue;
            }
            if (i.spill != 0) and not is_label(i) {
                let r = phys(f, i.sreg);
                if cur[@int_cast(usize, r)] == i.sslot {
                    remove(b, i);  // the register (or the slot) has it already
                    i = next;
                    continue;
                }
                if i.spill == 2 {
                    // an earlier store to the slot nothing read is dead
                    let mut k: usize = 0;
                    while k < pend.len {
                        if pend.get(k).sslot == i.sslot {
                            remove(b, pend.get(k));
                            pend.set(k, pend.get(pend.len - 1));
                            pend.len -= 1;
                        } else {
                            k += 1;
                        }
                    }
                    pend.push(i);
                } else {
                    let mut k: usize = 0;
                    while k < pend.len {
                        if pend.get(k).sslot == i.sslot {
                            pend.set(k, pend.get(pend.len - 1));
                            pend.len -= 1;
                        } else {
                            k += 1;
                        }
                    }
                }
            } else {
                for k in 0..i.ops.len {
                    if i.ops[k].kind == K_LABEL {
                        pend.clear();  // (a jump: the slot may be read there)
                    }
                }
            }
            holds_step(f, i, cur, is_label, full_copy);
            i = next;
        }
    }
    pend.deinit();
}

// Debugging (AXIOM_DEBUG_RA): the function's machine code, with virtual
// registers (v), physical ones (r) and target opcodes as numbers.
fn dump_reg(r: i32) []u8 {
    if is_vreg(r) {
        return u.f1("v%s", u.idec(r - VREG0));
    }
    return u.f1("r%s", u.idec(r));
}

pub fn dump(f: *MFunc, tag: []u8) void {
    u.eprint(u.f1("== %s\n", tag));
    for bi in 0..f.blocks.len {
        let b = f.blocks.get(bi);
        let mut s = u.f2("b%s freq %s preds", u.zdec(bi), u.dec(@int_from_float(i64, b.freq * 100.0)));
        for k in 0..b.preds.len {
            s = u.f2("%s %s", s, u.idec(b.preds.get(k)));
        }
        s = u.f1("%s succs", s);
        for k in 0..b.succs.len {
            s = u.f2("%s %s", s, u.idec(b.succs.get(k)));
        }
        u.eprint(u.f1("%s\n", s));
        let mut i = b.first;
        while u.notnil(i) {
            let mut l = u.f3("  %s: op%s.%s", u.idec(i.pos), u.idec(i.op), u.idec(i.cc));
            l = u.f2("%s sz%s", l, u.idec(@as(i32, i.sz)));
            for k in 0..i.ops.len {
                let o = i.ops[k];
                let mut t: []u8 = "_";
                if o.kind == K_REG {
                    t = dump_reg(o.reg);
                    if (o.role & RD) != 0 {
                        t = u.f1("%s=", t);
                    }
                } else if o.kind == K_IMM {
                    t = u.f1("#%s", u.dec(o.disp));
                } else if o.kind == K_MEM {
                    t = "[";
                    if o.slot >= 0 {
                        t = u.f2("%sslot%s", t, u.idec(o.slot));
                    } else if o.sym >= 0 {
                        t = u.f2("%ssym%s", t, u.idec(o.sym));
                    }
                    if o.base >= 0 {
                        t = u.f2("%s %s", t, dump_reg(o.base));
                    }
                    if o.index >= 0 {
                        t = u.f3("%s+%s*%s", t, dump_reg(o.index), u.idec(@as(i32, o.scale)));
                    }
                    t = u.f2("%s+%s]", t, u.dec(o.disp));
                } else if o.kind == K_SYM {
                    t = u.f1("sym%s", u.idec(o.sym));
                } else if o.kind == K_LABEL {
                    t = u.f1("L%s", u.idec(o.label));
                }
                l = u.f2("%s %s", l, t);
            }
            if i.spill != 0 {
                l = u.f3("%s  ; spill%s slot%s", l, u.idec(i.spill), u.idec(i.sslot));
            }
            if i.is_move {
                l = u.f1("%s  ; move", l);
            }
            u.eprint(u.f1("%s\n", l));
            i = i.next;
        }
    }
}
