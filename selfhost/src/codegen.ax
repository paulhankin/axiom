// =============================================================================
// codegen.ax - lowering of the checked AST to LLVM IR via the LLVM C API.
//
// Generic functions are monomorphized here: each (decl, type arguments)
// pair becomes one LLVM function, generated from the shared, already
// type-checked body by substituting the type arguments.
// =============================================================================
import "ast.ax" as ast;
import "backend.ax" as be;
import "diag.ax" as dg;
import "ir.ax" as ir;
import "lexer.ax" as lx;
import "sema.ax" as sema;
import "target.ax" as tg;
import "types.ax" as ty;
import "util.ax" as u;
import "x64.ax" as x64;

// What one codegen run produces (spec §16.8):
//   CG_WHOLE   the whole program in one object (-O2 and above by default)
//   CG_MODULE  one module's non-generic functions, plus the generic instances
//              it uses (link-once); everything else is referenced by name
//   CG_LINK    the per-program pieces: globals, error codes and names,
//              runtime state, test and host exports
pub const CG_WHOLE: i32 = 0;
pub const CG_MODULE: i32 = 1;
pub const CG_LINK: i32 = 2;

pub const EMIT_OBJ: i32 = 0;
pub const EMIT_IR: i32 = 1;
pub const EMIT_ASM: i32 = 2;

// Integer overflow of + - * unary - and MIN / -1 (spec §7.6): wraps (the
// default), traps with T0002, or saturates.
pub const OVF_WRAP: i32 = 0;
pub const OVF_TRAP: i32 = 1;
pub const OVF_SATURATE: i32 = 2;

pub struct CgOptions {
    opt_level: i32,  // 0..3
    overflow: i32,   // --overflow=wrap|trap|saturate: OVF_WRAP (default), OVF_TRAP, OVF_SATURATE
    cpu: []u8,       // nil = generic
    emit: i32,
    out_path: []u8,          // file to write
    stack_traces: bool,      // shadow stack for traces and profiles (--stack-traces=on, default)
    profile: bool,           // axiom profile: the shadow stack is sampled concurrently
    sanitize_address: bool,  // --sanitize=address: heap accesses are checked (spec §16.8)
    unit: i32,
    module: *mut ast.Module,  // CG_MODULE
}

// Names of exported functions (for the linker).
pub let mut g_export_names: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
// Libraries named by extern "C" "lib" blocks (for the linker).
pub let mut g_link_libs: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
// Build a test binary (axiom test): tests become roots and are exported.
pub let mut g_test_mode: bool = false;
// Set before codegen: the program spawns threads (wasm: shared memory and a
// thread entry export).
pub let mut g_threads: bool = false;
// Set by codegen: the output calls into runtime/native_host.c.
pub let mut g_needs_native_runtime: bool = false;

let mut O: *mut CgOptions = @ptr_from_int(*mut CgOptions, 0);
let mut M: *mut ir.Module = @ptr_from_int(*mut ir.Module, 0);
let mut B: *mut ir.Builder = @ptr_from_int(*mut ir.Builder, 0);
let mut T_i1: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut T_i8: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut T_i16: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut T_i32: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut T_i64: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut T_isz: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut T_ptr: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut T_void: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut T_f32: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut T_f64: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut T_v128: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);

// ---------------------------------------------------------------------------
// Function instances
// ---------------------------------------------------------------------------
struct FnInst {
    decl: *mut ast.Decl,
    gargs: []mut *mut ast.Type,
    fnty: *mut ast.Type,  // concrete TY_FN
    fnv: *mut ir.Value,
    llty: *mut ir.Ty,
    sret: bool,
    display: []u8,  // user-facing name, for stack traces and profiles
    next: *mut FnInst,
    feats: u64,      // the processor extensions its code may use
    dispatch: bool,  // @features / @multiversion: chooses a version (vers) and calls it
    vers: []mut *mut FnInst,
    key: []u8,
}

let mut inst_map: u.SymMap.[*mut FnInst] = u.SymMap.[*mut FnInst].{ keys: @ptr_from_int(*mut usize, 0),
                                                                    vals: @ptr_from_int(*mut *mut FnInst, 0), cap: 0,
                                                                    len: 0 };
let mut g_build_features: u64 = 0;  // the build's extensions (--cpu, --features)
let mut pending_head: *mut FnInst = @ptr_from_int(*mut FnInst, 0);
let mut pending_tail: *mut FnInst = @ptr_from_int(*mut FnInst, 0);

struct LoopCtx {
    brk: *mut ir.Block,
    cont: *mut ir.Block,
    defer_height: usize,
}

struct FnState {
    no_trace: bool,  // runtime code: not on the shadow stack
    inst: *mut FnInst,
    decl: *mut ast.Decl,
    from: []mut *mut ast.Type,
    to: []mut *mut ast.Type,
    fnv: *mut ir.Value,
    locals: []mut *mut ir.Value,
    sret_ptr: *mut ir.Value,
    ret: *mut ast.Type,  // concrete
    defers: u.List.[*mut ast.Stmt],
    loops: u.List.[LoopCtx],
    entry: *mut ir.Block,
    // The shadow stack record and its depth, read once at the function's
    // entry: every call restores the depth, so it is the same at every call.
    ss_rec: *mut ir.Value,
    ss_depth: *mut ir.Value,
    ss_slot: *mut ir.Value,  // where this function's calls record their site
    ss_next: *mut ir.Value,  // the depth during its calls
}

let mut F: *mut FnState = @ptr_from_int(*mut FnState, 0);

// ---------------------------------------------------------------------------
// Small wrappers (unnamed instructions)
// ---------------------------------------------------------------------------
fn vnil() *mut ir.Value {
    return u.nil.[ir.Value]();
}

fn tnil() *mut ast.Type {
    return u.nil.[ast.Type]();
}

fn bbnil() *mut ir.Block {
    return u.nil.[ir.Block]();
}

fn NN() *u8 {
    return "".ptr;
}

fn ci(t: *mut ir.Ty, v: u64) *mut ir.Value {
    return ir.cint(t, v);
}

fn ci32(v: u64) *mut ir.Value {
    return ir.cint(T_i32, v);
}

fn b_add(a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    return ir.add(B, a, b);
}

fn b_sub(a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    return ir.sub(B, a, b);
}

fn b_mul(a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    return ir.mul(B, a, b);
}

fn b_and(a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    return ir.and_(B, a, b);
}

fn b_or(a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    return ir.or_(B, a, b);
}

fn b_xor(a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    return ir.xor(B, a, b);
}

fn b_not(a: *mut ir.Value) *mut ir.Value {
    return ir.not_(B, a);
}

fn icmp(p: i32, a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    return ir.icmp(B, p, a, b);
}

fn fcmp(p: i32, a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    return ir.fcmp(B, p, a, b);
}

fn sel(c: *mut ir.Value, a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    return ir.select(B, c, a, b);
}

fn zext(v: *mut ir.Value, t: *mut ir.Ty) *mut ir.Value {
    return ir.zext(B, v, t);
}

fn sext(v: *mut ir.Value, t: *mut ir.Ty) *mut ir.Value {
    return ir.sext(B, v, t);
}

fn trunc(v: *mut ir.Value, t: *mut ir.Ty) *mut ir.Value {
    return ir.trunc(B, v, t);
}

fn bitcast(v: *mut ir.Value, t: *mut ir.Ty) *mut ir.Value {
    return ir.bitcast(B, v, t);
}

fn ptrtoint(v: *mut ir.Value, t: *mut ir.Ty) *mut ir.Value {
    return ir.ptrtoint(B, v, t);
}

fn inttoptr(v: *mut ir.Value, t: *mut ir.Ty) *mut ir.Value {
    return ir.inttoptr(B, v);
}

fn extract(v: *mut ir.Value, i: u32) *mut ir.Value {
    return ir.extract(B, v, i);
}

fn insert(agg: *mut ir.Value, v: *mut ir.Value, i: u32) *mut ir.Value {
    return ir.insert(B, agg, v, i);
}

fn ld(t: *mut ir.Ty, p: *mut ir.Value) *mut ir.Value {
    return ir.load(B, t, p);
}

fn st(v: *mut ir.Value, p: *mut ir.Value) *mut ir.Value {
    return ir.store(B, v, p);
}

fn br(bb: *mut ir.Block) void {
    ir.br(B, bb);
}

fn condbr(c: *mut ir.Value, t: *mut ir.Block, e: *mut ir.Block) void {
    ir.condbr(B, c, t, e);
}

fn at_end(bb: *mut ir.Block) void {
    ir.at_end(B, bb);
}

fn gep1(t: *mut ir.Ty, p: *mut ir.Value, i: *mut ir.Value) *mut ir.Value {
    return ir.gep1(B, t, p, i);
}

fn gep2(t: *mut ir.Ty, p: *mut ir.Value, i: *mut ir.Value, j: *mut ir.Value) *mut ir.Value {
    let mut ix: [2]*mut ir.Value = [i, j];
    return ir.gep(B, t, p, ix[..]);
}

fn sgep(t: *mut ir.Ty, p: *mut ir.Value, i: u32) *mut ir.Value {
    return ir.struct_gep(B, t, p, i);
}

fn tint(bits: i32) *mut ir.Ty {
    return ir.t_int(bits);
}

fn struct_ty(els: []mut *mut ir.Ty) *mut ir.Ty {
    return ir.t_struct(els);
}

fn const_struct(vals: []mut *mut ir.Value) *mut ir.Value {
    return ir.cstruct(vals);
}

fn fn_type(ret: *mut ir.Ty, ps: []mut *mut ir.Ty, vararg: bool) *mut ir.Ty {
    return ir.t_fn(ret, ps, vararg);
}

fn call(fty: *mut ir.Ty, f: *mut ir.Value, args: []mut *mut ir.Value) *mut ir.Value {
    return ir.call(B, fty, f, args);
}

fn is_const_int(v: *mut ir.Value) bool {
    return v.kind == ir.V_CINT;
}

// The concrete type of t in the function being generated. An enum is its
// representation from here on: code generation never needs to tell them apart.
// A variable left `undefined` (§8.1) no larger than this (bytes) is zeroed: SROA may split
// slots up to this size and promote their parts to SSA values (sroa.MAX_SIZE).
const UNDEF_ZEROED: u64 = 256;

fn ct(t: *mut ast.Type) *mut ast.Type {
    if u.notnil(t) and (t.kind == ast.TY_ENUM) {
        return t.elem;
    }
    if u.isnil(t) or u.isnil(F) or not t.has_params {
        return t;
    }
    return ty.subst(t, F.from, F.to);
}

fn internal_error(msg: []u8) void {
    u.eprint(u.f1("axiom: internal compiler error: %s\n", msg));
    u.quit(2);
}

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------
fn align_unit(a: i64) *mut ir.Ty {
    if a == 1 {
        return T_i8;
    }
    if a == 2 {
        return T_i16;
    }
    if a == 4 {
        return T_i32;
    }
    if a == 8 {
        return T_i64;
    }
    if a >= 32 {
        return ir.t_vec(T_i32, @int_cast(u32, a / 4));
    }
    return T_v128;
}

fn lty(t: *mut ast.Type) *mut ir.Ty {
    if t.has_params {
        internal_error(u.f1("unsubstituted generic type %s", ty.type_str(t)));
    }
    if not u.isvnil(t.backend) {
        return @ptr_cast(*mut ir.Ty, t.backend);
    }
    let mut r = u.nil.[ir.Ty]();
    let k = t.kind;
    if k == ast.TY_VOID {
        r = T_void;
    } else if k == ast.TY_BOOL {
        r = T_i8;
    } else if k == ast.TY_INT {
        r = tint(t.bits);
    } else if k == ast.TY_ENUM {
        r = lty(t.elem);
    } else if k == ast.TY_FLOAT {
        r = T_f64;
        if t.bits == 32 {
            r = T_f32;
        }
    } else if k == ast.TY_VEC {
        let mut lane = tint(t.elem.bits);
        if t.elem.kind == ast.TY_FLOAT {
            lane = T_f64;
            if t.elem.bits == 32 {
                lane = T_f32;
            }
        }
        r = ir.t_vec(lane, @int_cast(u32, t.lanes));
    } else if k == ast.TY_V128 {
        r = ir.t_vec(T_i32, @int_cast(u32, t.bits / 32));
    } else if (k == ast.TY_PTR) or (k == ast.TY_FN) {
        r = T_ptr;
    } else if k == ast.TY_ERROR {
        r = T_i16;
    } else if k == ast.TY_SLICE {
        let mut el: [2]*mut ir.Ty = [T_ptr, T_isz];
        r = struct_ty(el[..]);
    } else if k == ast.TY_ARRAY {
        r = ir.t_array(lty(t.elem), @bit_cast(u64, t.len));
    } else if k == ast.TY_ERRUNION {
        if t.elem.kind == ast.TY_VOID {
            let mut el: [1]*mut ir.Ty = [T_i16];
            r = struct_ty(el[..]);
        } else {
            let mut el: [2]*mut ir.Ty = [T_i16, lty(t.elem)];
            r = struct_ty(el[..]);
        }
    } else if k == ast.TY_STRUCT {
        r = ir.t_named_struct(ty.type_str(t));
        t.backend = @ptr_cast(*mut void, r);
        let n = t.decl.fields.len;
        let el = u.newn.[*mut ir.Ty](n + 1);
        for i in 0..n {
            el[i] = lty(ty.type_field(t, i));
        }
        ir.struct_set_body(r, el[0..n]);
    } else if k == ast.TY_UNION {
        r = ir.t_named_struct(ty.type_str(t));
        t.backend = @ptr_cast(*mut void, r);
        let tag = lty(ty.union_tag_type(t));
        let psize = ty.union_payload_size(t);
        let palign = ty.union_payload_align(t);
        if psize == 0 {
            let mut el: [1]*mut ir.Ty = [tag];
            ir.struct_set_body(r, el[..]);
        } else {
            let arr = ir.t_array(align_unit(palign), @bit_cast(u64, ((psize + palign) - 1) / palign));
            let mut el: [2]*mut ir.Ty = [tag, arr];
            ir.struct_set_body(r, el[..]);
        }
    } else {
        internal_error(u.f1("no LLVM type for %s", ty.type_str(t)));
    }
    t.backend = @ptr_cast(*mut void, r);
    return r;
}

// SSA representation: bool is i1; everything else as in memory.
fn vty(t: *mut ast.Type) *mut ir.Ty {
    if t.kind == ast.TY_BOOL {
        return T_i1;
    }
    return lty(t);
}

// Passed by pointer to a copy the callee only reads (results: through a
// pointer to the caller's memory): aggregates larger than 32 bytes, and
// 256- and 512-bit vectors, so that functions compiled for different
// processor extensions (spec §13.4) agree on how they arrive.
fn by_ptr(t: *mut ast.Type) bool {
    if ty.is_simd(t) {
        return ty.type_size(t) > 16;
    }
    return ty.is_aggregate(t) and (ty.type_size(t) > 32);
}

struct FnLty {
    t: *mut ir.Ty,
    sret: bool,
}

fn fn_lty(fnty: *mut ast.Type) FnLty {
    let ret = fnty.ret;
    let sret = by_ptr(ret);
    let mut n = fnty.params.len;
    if sret {
        n += 1;
    }
    let ps = u.newn.[*mut ir.Ty](n + 1);
    let mut k: usize = 0;
    if sret {
        ps[k] = T_ptr;
        k += 1;
    }
    for i in 0..fnty.params.len {
        if by_ptr(fnty.params[i]) {
            ps[k] = T_ptr;
        } else {
            ps[k] = vty(fnty.params[i]);
        }
        k += 1;
    }
    let mut rt = T_void;
    if not sret and (ret.kind != ast.TY_VOID) {
        rt = vty(ret);
    }
    return FnLty.{ t: fn_type(rt, ps[0..n], false), sret: sret };
}

// ---------------------------------------------------------------------------
// Small IR helpers
// ---------------------------------------------------------------------------
fn cint(t: *mut ir.Ty, v: u.I128) *mut ir.Value {
    return ir.cint(t, v.lo);
}

fn usz(v: i64) *mut ir.Value {
    return ir.cint(T_isz, @bit_cast(u64, v));
}

// The elements of `size` bytes that a slice needs to hold `bytes` (@load and
// @store: s.len * size >= bytes, as a count of elements, which cannot wrap).
fn elems_for(bytes: i64, size: i64) i64 {
    if size <= 0 {
        return bytes;
    }
    return (bytes + (size - 1)) / size;
}

fn terminated() bool {
    let bb = ir.insert_block(B);
    return u.notnil(ir.terminator(bb));
}

fn new_bb(name: *u8) *mut ir.Block {
    return ir.append_block(F.fnv.fnp, u.from_c(name));
}

// After a diverging instruction: continue in a fresh (unreachable) block.
fn dead_block() void {
    at_end(new_bb("dead".ptr));
}

// The LLVM intrinsics codegen uses, as IR intrinsics (IN_*) or instructions.
fn intrinsic(name: []u8, tys: []mut *mut ir.Ty, args: []mut *mut ir.Value) *mut ir.Value {
    if u.str_eq(name, "llvm.fptosi.sat") {
        return ir.cast(B, ir.OP_FPTOSI_SAT, args[0], tys[0]);
    }
    if u.str_eq(name, "llvm.fptoui.sat") {
        return ir.cast(B, ir.OP_FPTOUI_SAT, args[0], tys[0]);
    }
    if u.str_eq(name, "llvm.trap") {
        return ir.intr(B, ir.IN_TRAP, T_void, no_vals());
    }
    if u.str_eq(name, "llvm.wasm.memory.size") {
        return ir.intr(B, ir.IN_MEMSIZE, T_isz, no_vals());
    }
    if u.str_eq(name, "llvm.wasm.memory.grow") {
        return ir.intr(B, ir.IN_MEMGROW, T_isz, args[1..2]);
    }
    if u.str_eq(name, "llvm.wasm.memory.atomic.wait32") {
        return ir.intr(B, ir.IN_WAIT32, T_i32, args);
    }
    if u.str_eq(name, "llvm.wasm.memory.atomic.notify") {
        return ir.intr(B, ir.IN_NOTIFY, T_i32, args);
    }
    if u.str_eq(name, "llvm.stackrestore") {
        return ir.intr(B, ir.IN_SET_SP, T_void, args);
    }
    let names = ["llvm.ctlz", "llvm.cttz", "llvm.ctpop", "llvm.fshl", "llvm.fshr", "llvm.sadd.sat", "llvm.uadd.sat",
                 "llvm.ssub.sat", "llvm.usub.sat", "llvm.smin", "llvm.smax", "llvm.umin", "llvm.umax", "llvm.minimum",
                 "llvm.maximum", "llvm.fabs", "llvm.sqrt", "llvm.floor", "llvm.ceil", "llvm.trunc", "llvm.roundeven",
                 "llvm.fma", "llvm.copysign", "llvm.abs"];
    let ids = [ir.IN_CTLZ, ir.IN_CTTZ, ir.IN_CTPOP, ir.IN_ROTL, ir.IN_ROTR, ir.IN_SADD_SAT, ir.IN_UADD_SAT,
               ir.IN_SSUB_SAT, ir.IN_USUB_SAT, ir.IN_SMIN, ir.IN_SMAX, ir.IN_UMIN, ir.IN_UMAX, ir.IN_FMIN, ir.IN_FMAX,
               ir.IN_FABS, ir.IN_SQRT, ir.IN_FLOOR, ir.IN_CEIL, ir.IN_FTRUNC, ir.IN_NEAREST, ir.IN_FMA, ir.IN_COPYSIGN,
               ir.IN_ABS];
    for i in 0..names.len {
        if u.str_eq(name, names[i]) {
            let id = ids[i];
            let mut n = args.len;
            if (id == ir.IN_CTLZ) or (id == ir.IN_CTTZ) or (id == ir.IN_ABS) {
                n = 1;  // drop LLVM's is_zero_poison flag
            }
            if (id == ir.IN_ROTL) or (id == ir.IN_ROTR) {
                let mut rargs: [2]*mut ir.Value = [args[0], args[2]];
                return ir.intr(B, id, args[0].ty, rargs[..]);
            }
            return ir.intr(B, id, args[0].ty, args[0..n]);
        }
    }
    internal_error(u.f1("unknown intrinsic %s", name));
    return vnil();
}

fn no_tys() []mut *mut ir.Ty {
    return @slice_from_ptr(u.nil.[*mut ir.Ty](), 0);
}

fn no_vals() []mut *mut ir.Value {
    return @slice_from_ptr(u.nil.[*mut ir.Value](), 0);
}

fn intr1(name: []u8, a: *mut ir.Value) *mut ir.Value {
    let mut t: [1]*mut ir.Ty = [a.ty];
    let mut args: [1]*mut ir.Value = [a];
    return intrinsic(name, t[..], args[..]);
}

fn intr2(name: []u8, a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    let mut t: [1]*mut ir.Ty = [a.ty];
    let mut args: [2]*mut ir.Value = [a, b];
    return intrinsic(name, t[..], args[..]);
}

// ---------------------------------------------------------------------------
// Traps (spec Appendix B).
//
// Every trap site has a constant record {code, file id, span, line, column,
// file name, source text}. Before trapping, the helper stores the record's
// address (and, for @expect_eq, the compared values) in axiom.trap_info,
// which hosts read after the trap (wasm export axiom_trap_info; native
// weak hook ax_on_trap). Going through one cold helper also keeps LLVM's fast
// instruction selector usable at -O0; -O1+ inlines it.
// ---------------------------------------------------------------------------
const T_TRAP: i32 = 0;
const T_BOUNDS: i32 = 1;
const T_OVERFLOW: i32 = 2;
const T_DIVZERO: i32 = 3;
const T_INTCAST: i32 = 4;
const T_LENGTH: i32 = 6;
const T_UNIONTAG: i32 = 7;
const T_STACK: i32 = 8;
const T_ATOMIC_ALIGN: i32 = 10;
const T_EXPECT: i32 = 11;
const T_MEMORY: i32 = 12;
const T_CPU: i32 = 13;
const SITE_ERR_RETURN: i32 = 254;
const SITE_CALL: i32 = 255;  // not traps: shadow stack records

let mut g_cur_span: u.Span = u.Span.{ file: 0, start: 0, end: 0 };

// The span of the code being generated: trap sites name it, and the
// instructions made for it carry its line (ir.cur_src, debug information).
fn set_span(sp: u.Span) void {
    g_cur_span = sp;
    let mut src: u32 = 0;
    if (sp.file >= 0) and (@int_cast(usize, sp.file) < u.g_files.len) {
        src = ir.src_loc(sp.file, u.span_linecol(sp).sl);
    }
    ir.cur_src = src;
}
let mut trap_fn: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);
let mut trap_info: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);
let mut trap_hook: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);
let mut trap_fnty: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut site_ty: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut site_map: u.SymMap.[*mut ir.Value] = u.SymMap.[*mut ir.Value].{ keys: @ptr_from_int(*mut usize, 0),
                                                                        vals: @ptr_from_int(*mut *mut ir.Value, 0),
                                                                        cap: 0, len: 0 };

// axiom.trap_info: {site, kind, a, b, alen, blen}, all 64-bit.
fn trap_info_global() *mut ir.Value {
    if u.isnil(trap_info) {
        let t = ir.t_array(T_i64, 6);
        trap_info = shared_global(t, "axiom.trap_info", ir.czero(t), 0);
        set_align(trap_info, 8);
    }
    return trap_info;
}

fn trap_info_slot(i: u64) *mut ir.Value {
    return gep2(ir.t_array(T_i64, 6), trap_info_global(), ci32(0), ci32(i));
}

// Stable identity of a source file in site records (hash of its display path).
pub fn file_key(file_id: i32) u32 {
    if (file_id < 0) or (@int_cast(usize, file_id) >= u.g_files.len) {
        return 0xFFFF_FFFF;
    }
    let mut h: u32 = 2166136261;
    for c in u.file_of(file_id).display {
        h = (h ^ @as(u32, c)) *% 16777619;
    }
    if h == 0xFFFF_FFFF {
        return 0;
    }
    return h;
}

// Exported symbol names of the whole program (for the linker), and libraries
// named by extern "C" blocks: computed from the checked program.
pub fn collect_link_names(o: *CgOptions) void {
    g_sanitize_main = o.sanitize_address;
    let mut seen = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    let P = sema.g_prog;
    for i in 0..P.fns.len {
        let d = P.fns.get(i);
        if not d.is_export {
            continue;
        }
        let s = u.intern(export_symbol(d));
        if seen.get(s) == 0 {
            g_export_names.push(s);
        }
        seen.put(s, 1);
    }
    for i in 0..P.host_fns.len {
        let d = P.host_fns.get(i);
        if not d.extern_c or u.isnos(d.link_lib) {
            continue;
        }
        let s = u.intern(d.link_lib);
        if seen.get(s) == 0 {
            g_link_libs.push(s);
        }
        seen.put(s, 1);
    }
}

fn cur_fn_display() []u8 {
    if u.notnil(F) and u.notnil(F.inst) {
        return F.inst.display;
    }
    return "";
}

// A constant site record {code, file id, start, end, line, col, file, text,
// fn, callee}. `fn` is the enclosing function; `callee` is set for call sites.
// Codes: a trap code, SITE_CALL for a call, SITE_ERR_RETURN for an error return.
fn site_record_ex(code: i32, sp: u.Span, callee0: []u8) *mut ir.Value {
    let fname = cur_fn_display();
    let mut callee = callee0;
    if u.isnos(callee) {
        callee = "";
    }
    let key = u.intern(u.f6("%s:%s:%s:%s:%s:%s", u.idec(code), u.idec(sp.file), u.udec(@as(u64, sp.start)),
                            u.udec(@as(u64, sp.end)), fname, callee));
    let found = site_map.get(key);
    if u.notnil(found) {
        return found;
    }
    if u.isnil(site_ty) {
        let mut el: [10]*mut ir.Ty = [T_i32, T_i32, T_i32, T_i32, T_i32, T_i32, T_ptr, T_ptr, T_ptr, T_ptr];
        site_ty = struct_ty(el[..]);
    }
    let mut lc = u.LineCol.{ sl: 0, sc: 0, el: 0, ec: 0 };
    let mut file: []u8 = "";
    let mut text: []u8 = "";
    if (sp.file >= 0) and (@int_cast(usize, sp.file) < u.g_files.len) and (sp.end >= sp.start) {
        lc = u.span_linecol(sp);
        let f = u.file_of(sp.file);
        file = f.display;
        let mut n = sp.end - sp.start;
        let mut max: u32 = 200;
        if code >= SITE_ERR_RETURN {
            max = 80;
        }
        if n > max {
            n = max;
        }
        // one line of text only
        for i in 0..n {
            if f.text[@as(usize, sp.start + i)] == '\n' {
                n = i;
                break;
            }
        }
        text = u.dup(f.text[@as(usize, sp.start)..@as(usize, sp.start + n)]);
    }
    let mut vals: [10]*mut ir.Value = [
        ci32(@as(u64, @bit_cast(u32, code))),
        ci32(@as(u64, file_key(sp.file))),
        ci32(@as(u64, sp.start)),
        ci32(@as(u64, sp.end)),
        ci32(@as(u64, @bit_cast(u32, lc.sl))),
        ci32(@as(u64, @bit_cast(u32, lc.sc))),
        string_ptr(cstr_prefix(file)),
        string_ptr(cstr_prefix(text)),
        string_ptr(cstr_prefix(fname)),
        string_ptr(cstr_prefix(callee)),
    ];
    let g = ir.add_global(M, site_ty, ".site").val;
    set_init(g, const_struct(vals[..]));
    set_linkage(g, ir.LINK_INTERNAL);
    g.gv.is_const = true;
    set_align(g, 8);
    site_map.put(key, g);
    return g;
}

// The bytes up to the first NUL (C strings in the C implementation).
fn cstr_prefix(s: []u8) []u8 {
    let z = u.find(s, 0);
    if z >= 0 {
        return s[0..@int_cast(usize, z)];
    }
    return s;
}

fn site_record(code: i32, sp: u.Span) *mut ir.Value {
    return site_record_ex(code, sp, u.nosym());
}

// ---------------------------------------------------------------------------
// Shadow stack (spec §16.4): each thread has
//     {u32 depth, u32 errors, [SS_CAP]*Site calls, [ET_CAP]*Site error_returns}
// Every call stores its call-site record at calls[depth % SS_CAP] and bumps
// depth for the duration of the call, so after a trap or crash the host can
// print the innermost SS_CAP frames with exact source locations. Error
// returns are appended to a ring the same way; `catch` clears it. On wasm the
// record's address lives in a per-instance (so per-thread) wasm global; on
// native targets the record is thread-local.
// ---------------------------------------------------------------------------
const SS_CAP: u64 = 256;
const ET_CAP: u64 = 32;
let mut ss_ty: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut ss_global: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);
let mut ss_main: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);

fn stack_traces_on() bool {
    return u.notnil(O) and O.stack_traces and not (u.notnil(F) and F.no_trace);
}

// Stack traces in the program (shared helpers, globals and exports).
fn program_traces() bool {
    return u.notnil(O) and O.stack_traces;
}

// Native code keeps stack traces without the shadow stack's call records
// (issue 0053, as the C compiler's issue 0037): every function that makes a
// call keeps a frame pointer, and each call is followed by an entry in the
// object's frame table (section axiom_rets, written by the backend) that
// maps its return address to its chain of call-site records: its own and
// those of the calls inlined around it (ir.Chain; inline.ax extends the
// chains of the code it inlines). A trap or crash walks the frames and
// fills the thread's shadow stack as the stores would have (runtime:
// trap_format.ax, walk_frames). Profile builds, which sample the stack while
// the program runs, and --sanitize=address, which records allocation sites,
// keep the shadow stack, as does WebAssembly, whose stack cannot be walked.
// Error-return traces use the shadow stack's ring in every mode.
fn frame_tables() bool {
    return program_traces() and not ty.g_target.is_wasm and not O.profile and not O.sanitize_address;
}

// The native runtime (runtime/*.ax) reports stack traces; it is not part of
// them.
fn is_runtime_module(m: *ast.Module) bool {
    if u.isnil(m) {
        return false;
    }
    let names = ["/runtime/native.ax", "/runtime/darwin.ax", "/runtime/windows.ax", "/runtime/trap_format.ax",
                 "/runtime/test_main.ax", "/runtime/test_main_darwin.ax", "/runtime/test_main_windows.ax",
                 "/runtime/test_report.ax", "/runtime/profile.ax", "/runtime/profile_darwin.ax",
                 "/runtime/profile_windows.ax", "/runtime/rt.ax"];
    for n in names {
        if u.ends(m.path, n) {
            return true;
        }
    }
    return false;
}

fn ss_type() *mut ir.Ty {
    if u.isnil(ss_ty) {
        let mut el: [4]*mut ir.Ty = [T_i32, T_i32, ir.t_array(T_ptr, SS_CAP), ir.t_array(T_ptr, ET_CAP)];
        ss_ty = struct_ty(el[..]);
    }
    return ss_ty;
}

// WebAssembly stacks live in linear memory, where running past the end goes
// unnoticed: each function with a frame there checks it against this
// per-thread limit (a wasm global) first. The main thread's stack is the
// first MiB of memory; its lowest KiB stays unused.
const WASM_MAIN_STACK_LIMIT: u64 = 1024;
let mut stack_limit_global: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);

fn stack_limit() *mut ir.Value {
    if u.isnil(stack_limit_global) {
        stack_limit_global = shared_global(T_isz, "axiom.stack_limit", ci(T_isz, WASM_MAIN_STACK_LIMIT), 1);
    }
    return stack_limit_global;
}

// The end of a wasm function's entry block (where its allocas are): trap
// with T0008 if its frame, now reserved, reaches below the thread's limit
// (or below address 0).
fn check_stack(d: *mut ast.Decl, entry: *mut ir.Block, start: *mut ir.Block) void {
    let mut has_frame = false;
    let mut i = entry.first;
    while u.notnil(i) {
        if i.op == ir.OP_ALLOCA {
            has_frame = true;
        }
        i = i.next;
    }
    if not has_frame {
        br(start);
        return;
    }
    let mut none: [1]*mut ir.Value = [vnil()];
    let sp = ir.intr(B, ir.IN_GET_SP, T_ptr, none[0..0]);
    let spi = ir.cast(B, ir.OP_PTRTOINT, sp, T_isz);
    let saved = g_cur_span;
    set_span(d.name_span);
    // signed: a frame reserved below address 0 wraps around
    let room = ir.binop(B, ir.OP_SUB, spi, ld(T_isz, stack_limit()));
    condbr(icmp(ir.IntSLT, room, ci(T_isz, 0)), trap_block(T_STACK), start);
    set_span(saved);
}

fn ss_globals() void {
    let t = ss_type();
    if u.isnil(ss_global) {
        if ty.g_target.is_wasm {
            ss_main = shared_global(t, "axiom.ss.main", ir.czero(t), 0);
            set_align(ss_main, 8);
            ss_main.gv.noalias = true;
            // null means the main thread's record (wasm-ld does not relocate
            // wasm global initializers); thread starts set their own.
            ss_global = shared_global(T_ptr, "axiom.ss", ir.czero(T_ptr), 1);
        } else {
            ss_global = shared_global(t, "axiom.ss", ir.czero(t), 0);
            ss_global.gv.tls = true;
            set_align(ss_global, 8);
        }
        ss_global.gv.noalias = true;
    }
}

fn ss_ptr() *mut ir.Value {
    ss_globals();
    if ty.g_target.is_wasm {
        let p = ld(T_ptr, ss_global);
        return ir.select(B, ir.is_null(B, p), ss_main, p);
    }
    return ss_global;
}

fn ss_field(ss: *mut ir.Value, i: u32) *mut ir.Value {
    return sgep(ss_type(), ss, i);
}

fn ss_slot(ss: *mut ir.Value, field: u64, idx: *mut ir.Value) *mut ir.Value {
    let mut ix: [3]*mut ir.Value = [ci32(0), ci32(field), idx];
    return ir.gep(B, ss_type(), ss, ix[..]);
}

struct SsFrame {
    ss: *mut ir.Value,
    depth: *mut ir.Value,
    site: *mut ir.Value,  // frame tables: the call's record (its chain)
}

// In profiling builds another thread (or a signal handler) reads the stack at
// any moment, so the stores must happen even where nothing in this thread
// reads them (after inlining, an increment followed by the restore is
// otherwise a dead store).
fn ss_store(v: *mut ir.Value, p: *mut ir.Value) void {
    let s = st(v, p);
    if O.profile {
        s.flags = s.flags | ir.F_VOLATILE;
    }
}

fn ss_push(callee: []u8) SsFrame {
    let mut f = SsFrame.{ ss: vnil(), depth: vnil(), site: vnil() };
    if not stack_traces_on() or u.isnil(F) {
        return f;
    }
    if frame_tables() {
        f.site = site_record_ex(SITE_CALL, g_cur_span, callee);
        return f;
    }
    if u.isnil(F.ss_depth) {
        let cur = ir.insert_block(B);
        let first = F.entry.first;
        if u.notnil(first) {
            ir.at_before(B, first);
        } else {
            at_end(F.entry);
        }
        F.ss_rec = ss_ptr();
        F.ss_depth = ir.load(B, T_i32, ss_field(F.ss_rec, 0));
        F.ss_slot = ss_slot(F.ss_rec, 2, b_and(F.ss_depth, ci32(SS_CAP - 1)));
        F.ss_next = b_add(F.ss_depth, ci32(1));
        at_end(cur);
    }
    f.ss = F.ss_rec;
    f.depth = F.ss_depth;
    ss_store(site_record_ex(SITE_CALL, g_cur_span, callee), F.ss_slot);
    ss_store(F.ss_next, ss_field(f.ss, 0));
    return f;
}

// After the call `c`.
fn ss_pop(f: SsFrame, c: *mut ir.Value) void {
    if u.notnil(f.site) {
        c.chain = ir.chain1(f.site);
    }
    if u.notnil(f.ss) {
        ss_store(f.depth, ss_field(f.ss, 0));
    }
}

// Appends an error-return record when `code` (an error code, i16) is nonzero.
fn etrace_push(code: *mut ir.Value) void {
    if not stack_traces_on() or u.isnil(F) {
        return;
    }
    if is_const_int(code) and (code.cv == 0) {
        return;
    }
    let mut cont = bbnil();
    if not is_const_int(code) {
        let rec = new_bb("etrace".ptr);
        cont = new_bb("etrace.done".ptr);
        condbr(icmp(ir.IntNE, code, ir.czero(code.ty)), rec, cont);
        at_end(rec);
    }
    let ss = ss_ptr();
    let np = ss_field(ss, 1);
    let n = ld(T_i32, np);
    let idx = b_and(n, ci32(ET_CAP - 1));
    _ = st(site_record(SITE_ERR_RETURN, g_cur_span), ss_slot(ss, 3, idx));
    _ = st(b_add(n, ci32(1)), np);
    if u.notnil(cont) {
        br(cont);
        at_end(cont);
    }
}

fn etrace_clear() void {
    if not stack_traces_on() or u.isnil(F) {
        return;
    }
    _ = st(ci32(0), ss_field(ss_ptr(), 1));
}

fn add_fn_attr(f: *mut ir.Value, name: []u8) void {
    if u.str_eq(name, "noreturn") {
        f.fnp.noreturn = true;
    } else if u.str_eq(name, "cold") {
        f.fnp.cold = true;
    } else if u.str_eq(name, "noinline") {
        f.fnp.noinline = true;
    }
}

fn add_str_attr(f: *mut ir.Value, k: []u8, v: []u8) void {
    if u.str_eq(k, "wasm-export-name") {
        f.fnp.export_name = v;
    } else if u.str_eq(k, "wasm-import-module") {
        f.fnp.import_module = v;
    } else if u.str_eq(k, "wasm-import-name") {
        f.fnp.import_name = v;
    }
}

// Global and function attributes
fn set_align(v: *mut ir.Value, a: u32) void {
    if v.kind == ir.V_GLOBAL {
        v.gv.align = @as(u64, a);
    } else {
        v.align = a;
    }
}

fn set_linkage(v: *mut ir.Value, l: i32) void {
    if v.kind == ir.V_GLOBAL {
        v.gv.linkage = l;
    } else {
        v.fnp.linkage = l;
    }
}

fn set_init(g: *mut ir.Value, c: *mut ir.Value) void {
    g.gv.init = c;
}

fn named_fn(name: []u8) *mut ir.Value {
    let f = ir.get_function(M, name);
    if u.isnil(f) {
        return vnil();
    }
    return f.val;
}

fn named_global(name: []u8) *mut ir.Value {
    let g = ir.get_global(M, name);
    if u.isnil(g) {
        return vnil();
    }
    return g.val;
}

fn param(f: *mut ir.Value, k: u32) *mut ir.Value {
    return f.fnp.params[@as(usize, k)];
}

fn ext_elem(v: *mut ir.Value, idx: *mut ir.Value) *mut ir.Value {
    return ir.extract_elem(B, v, idx.cv);
}

fn ins_elem(v: *mut ir.Value, x: *mut ir.Value, idx: *mut ir.Value) *mut ir.Value {
    return ir.insert_elem(B, v, x, idx.cv);
}

fn call_trap_site(site: *mut ir.Value) void {
    if u.isnil(trap_fn) {
        let mut ps: [1]*mut ir.Ty = [T_ptr];
        trap_fnty = fn_type(T_void, ps[..], false);
        trap_fn = ir.add_function(M, "axiom.trap", trap_fnty).val;
        set_linkage(trap_fn, ir.LINK_INTERNAL);
        add_fn_attr(trap_fn, "noreturn");
        add_fn_attr(trap_fn, "cold");
        add_fn_attr(trap_fn, "nounwind");
        add_fn_attr(trap_fn, "noinline");
        let cur = ir.insert_block(B);
        let f = trap_fn;
        at_end(ir.append_block(f.fnp, "entry"));
        let sp = param(f, 0);
        _ = st(zext(ptrtoint(sp, T_isz), T_i64), trap_info_slot(0));
        if not ty.g_target.is_wasm {
            // Optional host hook (runtime/native_host.c, runtime/test_main.c).
            let mut hps: [3]*mut ir.Ty = [T_ptr, T_ptr, T_ptr];
            let hty = fn_type(T_void, hps[..], false);
            trap_hook = ir.add_function(M, "ax_on_trap", hty).val;
            set_linkage(trap_hook, ir.LINK_EXTWEAK);
            let call_bb = ir.append_block(f.fnp, "hook");
            let done_bb = ir.append_block(f.fnp, "trap");
            let has = icmp(ir.IntNE, trap_hook, ir.czero(T_ptr));
            condbr(has, call_bb, done_bb);
            at_end(call_bb);
            let mut ssv = ir.czero(T_ptr);
            if program_traces() {
                ssv = ss_ptr();
            }
            if frame_tables() {
                // the frames, from this function's own (its return address
                // is the trap's): runtime/trap_format.ax
                let mut wps: [1]*mut ir.Ty = [T_ptr];
                let wty = fn_type(T_void, wps[..], false);
                let walk = ir.add_function(M, "ax_stack_walk", wty).val;
                set_linkage(walk, ir.LINK_EXTWEAK);
                let walk_bb = ir.append_block(f.fnp, "walk");
                let hook_bb = ir.append_block(f.fnp, "hook.call");
                condbr(icmp(ir.IntNE, walk, ir.czero(T_ptr)), walk_bb, hook_bb);
                at_end(walk_bb);
                let mut none: [1]*mut ir.Value = [vnil()];
                let mut wargs: [1]*mut ir.Value = [ir.intr(B, ir.IN_FRAME_ADDR, T_ptr, none[0..0])];
                _ = call(wty, walk, wargs[..]);
                br(hook_bb);
                at_end(hook_bb);
            }
            let mut args: [3]*mut ir.Value = [sp, trap_info_global(), ssv];
            _ = call(hty, trap_hook, args[..]);
            br(done_bb);
            at_end(done_bb);
        }
        _ = intrinsic("llvm.trap", no_tys(), no_vals());
        ir.unreachable(B);
        at_end(cur);
    }
    let mut a: [1]*mut ir.Value = [site];
    _ = call(trap_fnty, trap_fn, a[..]);
}

// A block that traps with `code` at the current source span.
fn trap_block(code: i32) *mut ir.Block {
    let cur = ir.insert_block(B);
    let bb = new_bb("trap".ptr);
    at_end(bb);
    call_trap_site(site_record(code, g_cur_span));
    ir.unreachable(B);
    at_end(cur);
    return bb;
}

// Continue only if `ok` holds; otherwise trap with `code`.
fn check_or_trap(ok: *mut ir.Value, code: i32) void {
    if is_const_int(ok) and (ok.cv == 1) {
        return;
    }
    let cont = new_bb("ok".ptr);
    condbr(ok, cont, trap_block(code));
    at_end(cont);
}

fn emit_trap(code: i32) void {
    call_trap_site(site_record(code, g_cur_span));
    ir.unreachable(B);
    dead_block();
}

fn alloca_in_entry(t: *mut ir.Ty, name: *u8) *mut ir.Value {
    let cur = ir.insert_block(B);
    let term = ir.terminator(F.entry);
    if u.notnil(term) {
        ir.at_before(B, term);
    } else {
        at_end(F.entry);
    }
    let a = ir.alloca(B, t, u.from_c(name));
    at_end(cur);
    return a;
}

fn temp_alloca(t: *mut ast.Type) *mut ir.Value {
    let a = alloca_in_entry(lty(t), "tmp".ptr);
    set_align(a, @int_cast(u32, ty.type_align(t)));
    return a;
}

fn to_mem(t: *mut ast.Type, v: *mut ir.Value) *mut ir.Value {
    if t.kind == ast.TY_BOOL {
        return zext(v, T_i8);
    }
    return v;
}

fn from_mem(t: *mut ast.Type, v: *mut ir.Value) *mut ir.Value {
    if t.kind == ast.TY_BOOL {
        return icmp(ir.IntNE, v, ci(T_i8, 0));
    }
    return v;
}

// unaligned: the storage may be misaligned (reached through pointers)
fn load(t: *mut ast.Type, p: *mut ir.Value, unaligned: bool) *mut ir.Value {
    let v = ld(lty(t), p);
    if unaligned {
        set_align(v, 1);
    }
    return from_mem(t, v);
}

fn store(t: *mut ast.Type, v: *mut ir.Value, p: *mut ir.Value, unaligned: bool) void {
    let s = st(to_mem(t, v), p);
    if unaligned {
        set_align(s, 1);
    }
}

fn spill(t: *mut ast.Type, v: *mut ir.Value) *mut ir.Value {
    let a = temp_alloca(t);
    store(t, v, a, false);
    return a;
}

fn local_ptr(l: *mut ast.Local) *mut ir.Value {
    let i = @int_cast(usize, l.index);
    if u.isnil(F.locals[i]) {
        let t = ct(l.ty);
        let a = alloca_in_entry(lty(t), u.cz(l.name));
        set_align(a, @int_cast(u32, ty.type_align(t)));
        F.locals[i] = a;
    }
    return F.locals[i];
}

// ---------------------------------------------------------------------------
// Strings and globals
// ---------------------------------------------------------------------------
fn dll_import(fname: []u8, lib: []u8) void {
    let gname = u.cat2("axiom.import.", fname);
    if u.notnil(named_global(gname)) {
        return;
    }
    let g = ir.add_global(M, ir.t_array(T_i8, @as(u64, lib.len) + 1), gname).val;
    set_init(g, ir.cstring(lib));
    set_linkage(g, ir.LINK_LINKONCE);
    g.gv.is_const = true;
    set_align(g, 1);
}

let mut string_globals: u.SymMap.[*mut ir.Value] = u.SymMap.[*mut ir.Value].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut *mut ir.Value, 0), cap: 0, len: 0 };

fn string_ptr(bytes: []u8) *mut ir.Value {
    let key = u.intern(bytes);
    let mut g = string_globals.get(key);
    if u.isnil(g) {
        // A NUL follows every literal (not part of the slice), so that
        // "text".ptr is a valid C string (spec §2.5).
        let init = ir.cstring(bytes);
        g = ir.add_global(M, ir.t_array(T_i8, @as(u64, bytes.len) + 1), ".str").val;
        set_init(g, init);
        set_linkage(g, ir.LINK_INTERNAL);
        g.gv.is_const = true;
        set_align(g, 1);
        string_globals.put(key, g);
    }
    return g;
}

fn const_slice(ptr: *mut ir.Value, len: i64) *mut ir.Value {
    let mut el: [2]*mut ir.Value = [ptr, usz(len)];
    return const_struct(el[..]);
}

let mut global_vals: u.SymMap.[*mut ir.Value] = u.SymMap.[*mut ir.Value].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut *mut ir.Value, 0), cap: 0, len: 0 };

fn const_struct2(a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    let mut el: [2]*mut ir.Value = [a, b];
    return const_struct(el[..]);
}

fn const_struct1(a: *mut ir.Value) *mut ir.Value {
    let mut el: [1]*mut ir.Value = [a];
    return const_struct(el[..]);
}

// Constant for a global initializer (spec: constant expressions only).
fn gen_const(e: *mut ast.Expr, t0: *mut ast.Type) *mut ir.Value {
    let t = ct(t0);
    if e.kind == ast.E_CONV {
        if e.op == ast.CONV_NOOP {
            return gen_const(e.a, t);
        }
        if e.op == ast.CONV_WRAP_OK {
            if t.elem.kind == ast.TY_VOID {
                return const_struct1(ci(T_i16, 0));
            }
            return const_struct2(ci(T_i16, 0), gen_const(e.a, t.elem));
        }
        if e.op == ast.CONV_WRAP_ERR {
            let code = gen_const(e.a, ty.t_error);
            if t.elem.kind == ast.TY_VOID {
                return const_struct1(code);
            }
            return const_struct2(code, ir.czero(lty(t.elem)));
        }
    }
    if e.is_const and (t.kind == ast.TY_INT) {
        return cint(lty(t), e.cval);
    }
    if e.is_const and (t.kind == ast.TY_FLOAT) {
        return ir.cfp(lty(t), e.fval);
    }
    if (t.kind == ast.TY_BOOL) and ((e.kind == ast.E_BOOL) or e.is_const) {
        let mut bv: u64 = 0;
        if e.bval {
            bv = 1;
        }
        return ci(T_i8, bv);
    }
    let k = e.kind;
    if k == ast.E_FLOAT {
        return ir.cfp(lty(t), e.fval);
    }
    if k == ast.E_STRING {
        return const_slice(string_ptr(e.str), @int_cast(i64, e.str.len));
    }
    if k == ast.E_ERROR_VAL {
        return ci(T_i16, e.cval.lo);
    }
    if k == ast.E_ARRAY_LIT {
        let n = e.args.len;
        let vs = u.newn.[*mut ir.Value](n + 1);
        for i in 0..n {
            vs[i] = gen_const(e.args.get(i), t.elem);
        }
        return ir.carray(lty(t.elem), vs[0..n]);
    }
    if k == ast.E_ARRAY_REPEAT {
        let v = gen_const(e.a, t.elem);
        if ir.is_zero(v) {
            return ir.czero(lty(t));
        }
        let n = @int_cast(usize, t.len);
        let vs = u.newn.[*mut ir.Value](n + 1);
        for i in 0..n {
            vs[i] = v;
        }
        return ir.carray(lty(t.elem), vs[0..n]);
    }
    if k == ast.E_STRUCT_LIT {
        let n = t.decl.fields.len;
        let vs = u.newn.[*mut ir.Value](n + 1);
        for i in 0..n {
            vs[i] = gen_const(e.inits.at(i).value, ty.type_field(t, i));
        }
        return ir.cagg(lty(t), vs[0..n]);
    }
    if k == ast.E_FIELD {
        if e.op == ast.FK_VARIANT_UNIT {
            let ut = lty(t);
            let tag = ci(lty(ty.union_tag_type(t)), @int_cast(u64, e.index));
            if ir.field_count(ut) == 1 {
                let mut one: [1]*mut ir.Value = [tag];
                return ir.cagg(ut, one[..]);
            }
            let mut el: [2]*mut ir.Value = [tag, ir.czero(ut.fields[1])];
            return ir.cagg(ut, el[..]);
        }
        if (e.op == ast.FK_DECL) and u.notnil(e.decl) and (e.decl.kind == ast.D_FN) {
            return get_inst(e.decl, ty.no_types()).fnv;
        }
    } else if k == ast.E_IDENT {
        if u.notnil(e.decl) and ((e.decl.kind == ast.D_FN) or (e.decl.kind == ast.D_HOST_FN)) {
            return get_inst(e.decl, ty.no_types()).fnv;
        }
    } else if k == ast.E_BUILTIN {
        if e.index == ast.BI_PTR_FROM_INT {
            return ir.cinttoptr(gen_const(e.bargs.at(1).e, ty.t_usize));
        }
    } else if k == ast.E_UNARY {
        if (e.op == lx.TK_MINUS) and (t.kind == ast.TY_FLOAT) {
            return ir.cfp(lty(t), -e.a.fval);
        }
    } else if k == ast.E_CALL {
        if e.op == ast.CALLK_VARIANT {
            _ = dg.err(e.span, "E0353", "union constants with a payload are not supported by this compiler yet");
            return ir.czero(lty(t));
        }
    }
    _ = dg.err(e.span, "E0350", "global initializer must be a constant expression");
    return ir.czero(lty(t));
}

// Symbols are prefixed with the module's path (without .ax), which is unique
// within a build, so modules compiled separately never clash.
fn mangle_prefix(d: *mut ast.Decl) []u8 {
    let mut base: []u8 = "";
    if u.notnil(d.module) {
        base = u.file_of(d.module.file.id).display;
    }
    if (base.len > 3) and u.ends(base, ".ax") {
        return u.dup(base[0..base.len - 3]);
    }
    return u.dup(base);
}

// A type in a symbol name: like type_str, but struct and union names are
// qualified by their module, so instances are named the same in every unit.
fn mangle_type_into(b: *mut u.Buf, t: *mut ast.Type) void {
    let k = t.kind;
    if (k == ast.TY_STRUCT) or (k == ast.TY_UNION) {
        if t.decl.anon {  // anonymous structs are the same type everywhere
            b.s("struct{");
            for i in 0..t.decl.fields.len {
                if i != 0 {
                    b.s(",");
                }
                b.s(t.decl.fields.at(i).name);
                b.s(":");
                mangle_type_into(b, ty.type_field(t, i));
            }
            b.s("}");
            return;
        }
        b.s(mangle_prefix(t.decl));
        b.s(".");
        b.s(t.decl.name);
        if t.args.len != 0 {
            b.s("[");
            for i in 0..t.args.len {
                if i != 0 {
                    b.s(",");
                }
                mangle_type_into(b, t.args[i]);
            }
            b.s("]");
        }
    } else if k == ast.TY_PTR {
        b.s(u.pick(t.is_mut, "*mut ", "*"));
        mangle_type_into(b, t.elem);
    } else if k == ast.TY_SLICE {
        b.s(u.pick(t.is_mut, "[]mut ", "[]"));
        mangle_type_into(b, t.elem);
    } else if k == ast.TY_ARRAY {
        b.s("[");
        b.s(u.dec(t.len));
        b.s("]");
        mangle_type_into(b, t.elem);
    } else if k == ast.TY_ERRUNION {
        b.s("!");
        mangle_type_into(b, t.elem);
    } else if k == ast.TY_FN {
        b.s("fn(");
        for i in 0..t.params.len {
            if i != 0 {
                b.s(",");
            }
            mangle_type_into(b, t.params[i]);
        }
        b.s(")");
        mangle_type_into(b, t.ret);
    } else {
        b.s(ty.type_str(t));
    }
}

fn mangle_type(t: *mut ast.Type) []u8 {
    let mut b = u.Buf.init();
    mangle_type_into(&mut b, t);
    return b.done();
}

// Owner.[A].name.[B], or test "name".
fn fn_display(d: *mut ast.Decl, gargs: []mut *mut ast.Type) []u8 {
    if d.is_test {
        return u.f1("test \"%s\"", d.test_name);
    }
    let n = gargs.len;
    let mut b = u.Buf.init();
    let mut nowner: usize = 0;
    if u.notnil(d.owner) {
        nowner = d.owner.gparams.len;
        b.s(d.owner.name);
        if nowner != 0 {
            b.s(".[");
            for i in 0..nowner {
                if i >= n {
                    break;
                }
                if i != 0 {
                    b.s(", ");
                }
                b.s(ty.type_str(gargs[i]));
            }
            b.s("]");
        }
        b.s(".");
    }
    b.s(d.name);
    let mut nown = d.gparams.len;
    if d.kind == ast.D_HOST_FN {
        nown = 0;
    }
    if nown != 0 {
        b.s(".[");
        for i in n - nown..n {
            if i > (n - nown) {
                b.s(", ");
            }
            b.s(ty.type_str(gargs[i]));
        }
        b.s("]");
    }
    return b.done();
}

// The symbol of an exported function. On wasm (and in test binaries, which
// have their own main) `main` is renamed; the export name is an attribute.
fn export_symbol(d: *mut ast.Decl) []u8 {
    if d.is_export and u.str_eq(d.name, "main") {
        if g_sanitize_main and not g_test_mode {
            return "axiom.asan.main";  // wrapped: see emit_asan_main
        }
        return "axiom.export.main";
    }
    return d.name;
}

// --sanitize=address: main is wrapped (emit_asan_main)
let mut g_sanitize_main: bool = false;

// Globals live in the link unit when units are compiled separately (their
// initializers may contain error codes, which only the link unit knows).
fn global_ref(d: *mut ast.Decl) *mut ir.Value {
    let k = u.addr_key(@int_from_ptr(d));
    let found = global_vals.get(k);
    if u.notnil(found) {
        return found;
    }
    let t = d.ty;
    let g = ir.add_global(M, lty(t), u.f2("%s.%s", mangle_prefix(d), d.name)).val;
    set_align(g, @int_cast(u32, ty.type_align(t)));
    global_vals.put(k, g);
    // (on wasm a thread-local lives in the thread's block instead: tls_addr)
    g.gv.tls = d.is_tls;
    if O.unit == CG_MODULE {
        return g;  // defined by the link unit
    }
    if O.unit == CG_WHOLE {
        set_linkage(g, ir.LINK_INTERNAL);
    }
    set_init(g, gen_const(d.init, t));
    if not d.is_mut {
        g.gv.is_const = true;
    }
    return g;
}

// A global's address in the function being generated.
fn global_addr(d: *mut ast.Decl) *mut ir.Value {
    if d.is_tls and ty.g_target.is_wasm {
        return tls_addr(d);
    }
    return global_ref(d);
}

// Thread-locals on wasm, which has no TLS: the program's thread-locals,
// in declaration order (the same in every unit, since all units come from
// one checked program), make one block. The main thread's is the global
// axiom.tls.main; every other thread copies the initial values
// (axiom.tls.init) to the top of its stack when it starts and keeps the
// address in axiom.tls, a wasm global, so per instance (per thread), null
// in the main thread.
let mut tls_ty: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
let mut tls_main: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);
let mut tls_init: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);
let mut tls_ptr: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);
let mut tls_decls: u.List.[*mut ast.Decl] = u.List.[*mut ast.Decl].{ data: @ptr_from_int(*mut *mut ast.Decl, 0), len: 0,
                                                                     cap: 0 };

// Whether the program has thread-locals; on wasm, makes their block's globals.
fn tls_globals() bool {
    if u.notnil(tls_ty) {
        return true;
    }
    let P = sema.g_prog;
    tls_decls.clear();
    for i in 0..P.globals.len {
        let d = P.globals.get(i);
        if d.is_tls {
            tls_decls.push(d);
        }
    }
    if tls_decls.len == 0 {
        return false;
    }
    let n = tls_decls.len;
    let fs = u.newn.[*mut ir.Ty](n + 1);
    for k in 0..n {
        fs[k] = lty(tls_decls.get(k).ty);
    }
    tls_ty = struct_ty(fs[0..n]);
    let mut init = vnil();
    if O.unit != CG_MODULE {
        let vs = u.newn.[*mut ir.Value](n + 1);
        for k in 0..n {
            let d = tls_decls.get(k);
            vs[k] = gen_const(d.init, d.ty);
        }
        init = const_struct(vs[0..n]);
    }
    tls_main = shared_global(tls_ty, "axiom.tls.main", init, 0);
    set_align(tls_main, @int_cast(u32, @max(tls_ty.align, 8)));
    tls_init = shared_global(tls_ty, "axiom.tls.init", init, 0);
    set_align(tls_init, @int_cast(u32, @max(tls_ty.align, 8)));
    tls_init.gv.is_const = true;
    tls_ptr = shared_global(T_ptr, "axiom.tls", ir.czero(T_ptr), 1);
    return true;
}

fn tls_addr(d: *mut ast.Decl) *mut ir.Value {
    _ = tls_globals();
    let mut field: u32 = 0;
    for k in 0..tls_decls.len {
        if tls_decls.get(k) == d {
            field = @truncate(u32, k);
        }
    }
    let p = ld(T_ptr, tls_ptr);
    let base = ir.select(B, ir.is_null(B, p), tls_main, p);
    return sgep(tls_ty, base, field);
}

// Program-wide state shared by all units: defined (internal) in a whole
// program, declared by module units, defined (external) by the link unit.
fn shared_global(t: *mut ir.Ty, name: []u8, init: *mut ir.Value, addrspace: u32) *mut ir.Value {
    let mut g = vnil();
    if addrspace != 0 {
        g = ir.add_global(M, t, name).val;
        g.gv.wasm_global = true;
    } else {
        g = ir.add_global(M, t, name).val;
    }
    if O.unit == CG_MODULE {
        return g;
    }
    set_init(g, init);
    if O.unit == CG_WHOLE {
        set_linkage(g, ir.LINK_INTERNAL);
    }
    return g;
}

// An error code: a constant, except in module units, where the codes are
// only known at link time (spec §11.1) and are loaded from the link unit.
fn errcode_value(code: u32) *mut ir.Value {
    if (O.unit != CG_MODULE) or (code == 0) or (@as(usize, code) > sema.g_prog.error_names.len) {
        return ci(T_i16, @as(u64, code));
    }
    let name = u.cz(u.f1("axiom.errcode.%s", sema.g_prog.error_names.get(@as(usize, code) - 1)));
    let mut g = named_global(u.from_c(name));
    if u.isnil(g) {
        g = ir.add_global(M, T_i16, u.from_c(name)).val;
        g.gv.is_const = true;
    }
    return ld(T_i16, g);
}

fn type_mentions_error(t: *mut ast.Type) bool {
    let k = t.kind;
    if (k == ast.TY_ERROR) or (k == ast.TY_ERRUNION) {
        return true;
    }
    if k == ast.TY_ARRAY {
        return type_mentions_error(t.elem);
    }
    if k == ast.TY_STRUCT {
        for i in 0..t.decl.fields.len {
            if type_mentions_error(ty.type_field(t, i)) {
                return true;
            }
        }
        return false;
    }
    if k == ast.TY_UNION {
        return true;  // conservatively
    }
    return false;
}

// ---------------------------------------------------------------------------
// Function instances
// ---------------------------------------------------------------------------
// The extensions a function's code may use, without an attribute: the
// build's (not tg.g_features, which is the current function's while a body
// is generated).
fn base_features(d: *mut ast.Decl) u64 {
    if sema.baseline_fn(d) {
        return 0;
    }
    return g_build_features;
}

fn get_inst(d: *mut ast.Decl, gargs: []mut *mut ast.Type) *mut FnInst {
    return get_inst_feats(d, gargs, base_features(d));
}

// The callee of a direct call from the current function. An inline function
// is compiled with its caller's extensions (spec §9.5): one instance per set
// of extensions it is called with, so that @target_has, and lowering that
// depends on extensions, answer for the caller (a version of an @features or
// @multiversion function) into which it is inlined.
fn get_callee(d: *mut ast.Decl, gargs: []mut *mut ast.Type) *mut FnInst {
    if (d.kind == ast.D_FN) and d.is_inline {
        return get_inst_feats(d, gargs, tg.g_features);
    }
    return get_inst(d, gargs);
}

fn get_inst_feats(d: *mut ast.Decl, gargs: []mut *mut ast.Type, feats: u64) *mut FnInst {
    let n = gargs.len;
    let mut kb = u.Buf.init();
    kb.s(u.udec(@as(u64, @int_from_ptr(d))));
    for i in 0..n {
        kb.s(",");
        kb.s(u.idec(gargs[i].id));
    }
    // (an inline function compiled for its caller's extensions)
    let own_feats = feats != base_features(d);
    if own_feats {
        kb.s("#f");
        kb.s(u.udec(feats));
    }
    let k = u.intern(kb.done());
    let found = inst_map.get(k);
    if u.notnil(found) {
        return found;
    }
    let fi = u.new.[FnInst]();
    fi.decl = d;
    fi.gargs = gargs;
    fi.key = k;
    fi.feats = feats;
    fi.dispatch = (d.kind == ast.D_FN) and (d.attr != ast.ATTR_NONE);
    for i in 0..n {
        if gargs[i].has_params {
            internal_error("generic instance with unsubstituted arguments");
        }
    }
    fi.fnty = d.ty;
    if n != 0 {
        fi.fnty = ty.subst(d.ty, d.all_gparams, gargs);
    }
    let fl = fn_lty(fi.fnty);
    fi.llty = fl.t;
    fi.sret = fl.sret;
    fi.display = fn_display(d, gargs);
    let mut name = d.name;
    if d.kind == ast.D_HOST_FN {
        name = d.name;
    } else if d.is_export {
        // On wasm the symbol gets a private name and the export name comes
        // from the wasm-export-name attribute: LLVM treats a symbol called
        // `main` specially on wasm (it would add a second `main` export).
        // Test binaries bring their own `main` (the test driver).
        name = export_symbol(d);
    } else {
        let mut nb = u.Buf.init();
        nb.s(mangle_prefix(d));
        nb.s(".");
        if u.notnil(d.owner) {
            nb.s(d.owner.name);
            nb.s(".");
        }
        nb.s(d.name);
        let nown = d.gparams.len;
        if nown != 0 {
            nb.s(".[");
            for i in n - nown..n {
                if i > (n - nown) {
                    nb.s(", ");
                }
                nb.s(mangle_type(gargs[i]));
            }
            nb.s("]");
        }
        if u.notnil(d.owner) and (d.owner.gparams.len != 0) {
            nb.s("@[");
            for i in 0..d.owner.gparams.len {
                if i != 0 {
                    nb.s(",");
                }
                nb.s(mangle_type(gargs[i]));
            }
            nb.s("]");
        }
        if own_feats {
            let sfx = tg.features_string(feats & ~g_build_features);
            nb.s(".");
            if sfx.len == 0 {
                nb.s("base");
            } else {
                nb.s(sfx);
            }
        }
        name = nb.done();
    }
    if d.variadic {
        fi.llty = fn_type(fi.llty.ret, fi.llty.params, true);
    }
    let mut existing = vnil();
    if d.kind == ast.D_HOST_FN {
        existing = named_fn(name);
    }
    if u.notnil(existing) {
        fi.fnv = existing;
    } else {
        fi.fnv = ir.add_function(M, name, fi.llty).val;
    }
    fi.fnv.fnp.features = fi.feats;
    fi.fnv.fnp.has_features = true;
    fi.fnv.fnp.always_inline = (d.kind == ast.D_FN) and d.is_inline;
    add_ext_attrs(fi.fnv, fi.fnty, fi.sret, false);
    if d.kind == ast.D_HOST_FN {
        if d.extern_c {
            // libraries: see collect_link_names; on Windows the library is
            // the function's DLL, and on macOS its dylib or framework, which
            // the linker reads from a constant axiom.import.<name> holding
            // its name (selfhost/src/plink.ax, selfhost/src/mlink.ax)
            if (tg.is_windows() or tg.is_darwin()) and not u.isnos(d.link_lib) {
                dll_import(name, d.link_lib);
            }
        } else if ty.g_target.is_wasm {
            add_str_attr(fi.fnv, "wasm-import-module", d.host_module);
            add_str_attr(fi.fnv, "wasm-import-name", d.name);
        }
    } else {
        // Whole program: everything but exports is internal. Separate units:
        // a non-generic function is defined (externally visible) by its own
        // module's unit and only declared elsewhere; generic instances are
        // defined link-once by every unit that uses them.
        let mut define = true;
        if O.unit == CG_LINK {
            define = false;
        } else if (O.unit == CG_MODULE) and (n == 0) {
            define = (d.module == O.module) or own_feats;
        }
        if ((O.unit == CG_WHOLE) and not d.is_export) or own_feats {
            set_linkage(fi.fnv, ir.LINK_INTERNAL);
        } else if define and (n > 0) {
            set_linkage(fi.fnv, ir.LINK_LINKONCE);
        }
        let asan_main = g_sanitize_main and not g_test_mode and u.str_eq(d.name, "main");
        if define and d.is_export and ty.g_target.is_wasm and not asan_main {
            add_str_attr(fi.fnv, "wasm-export-name", d.name);
        }
        if define {
            if u.notnil(pending_tail) {
                pending_tail.next = fi;
            } else {
                pending_head = fi;
            }
            pending_tail = fi;
        }
    }
    inst_map.put(k, fi);
    return fi;
}

// Version k of a function with @features or @multiversion: its body
// compiled with extensions `feats`, under the name of the dispatcher (fi)
// with a suffix, and shown under the function's own name in traces.
fn get_version(fi: *mut FnInst, k: usize, feats: u64) *mut FnInst {
    let key = u.intern(u.f2("%s#v%s", fi.key, u.zdec(k)));
    let found = inst_map.get(key);
    if u.notnil(found) {
        return found;
    }
    let v = u.new.[FnInst]();
    v.decl = fi.decl;
    v.gargs = fi.gargs;
    v.key = key;
    v.fnty = fi.fnty;
    v.llty = fi.llty;
    v.sret = fi.sret;
    v.display = fi.display;
    v.feats = feats;
    let mut suffix = tg.features_string(feats & ~g_build_features);
    if suffix.len == 0 {
        suffix = "base";
    }
    v.fnv = ir.add_function(M, u.f2("%s.%s", fi.fnv.fnp.name, suffix), v.llty).val;
    v.fnv.fnp.features = feats;
    v.fnv.fnp.has_features = true;
    set_linkage(v.fnv, ir.LINK_INTERNAL);
    add_ext_attrs(v.fnv, v.fnty, v.sret, false);
    if u.notnil(pending_tail) {
        pending_tail.next = v;
    } else {
        pending_head = v;
    }
    pending_tail = v;
    inst_map.put(key, v);
    return v;
}

// The body of a function with @features or @multiversion: the first
// version whose extensions the running processor has (the build's own
// count as present), else the @multiversion fallback (the target's
// extensions only), or trap T0013 for @features.
fn gen_dispatch(fi: *mut FnInst) void {
    let d = fi.decl;
    let f = fi.fnv;
    at_end(ir.append_block(f.fnp, "entry"));
    set_span(d.attr_span);
    let nparams = f.fnp.params.len;
    let args = u.newn.[*mut ir.Value](nparams + 1);
    for i in 0..nparams {
        args[i] = param(f, @int_cast(u32, i));
    }
    let base = fi.feats;
    let mut k: usize = 0;
    let mut done = false;
    for set in d.feat_sets {
        k += 1;
        if (set == sema.NO_VERSION) or done {
            continue;
        }
        let want = base | set;
        let v = get_version(fi, k, want);
        let missing = want & ~tg.g_features;
        if missing == 0 {
            dispatch_call(fi, v, args[0..nparams]);
            done = true;
            continue;
        }
        let yes = ir.append_block(f.fnp, "version");
        let no = ir.append_block(f.fnp, "next");
        condbr(cpu_has_bits(missing), yes, no);
        at_end(yes);
        dispatch_call(fi, v, args[0..nparams]);
        at_end(no);
    }
    if done {
        return;
    }
    if d.attr == ast.ATTR_MULTIVERSION {
        dispatch_call(fi, get_version(fi, 0, base), args[0..nparams]);
    } else {
        call_trap_site(site_record(T_CPU, d.attr_span));
        ir.unreachable(B);
    }
}

fn dispatch_call(fi: *mut FnInst, v: *mut FnInst, args: []mut *mut ir.Value) void {
    let r = call(fi.llty, v.fnv, args);
    add_ext_attrs(r, fi.fnty, fi.sret, true);
    if fi.llty.ret.kind == ir.T_VOID {
        ir.ret_void(B);
    } else {
        ir.ret(B, r);
    }
}

// std/os/cpu.ax, which every build includes (the start-up check, @cpu_has).
fn cpu_fn(name: []u8) *mut FnInst {
    let P = sema.g_prog;
    for i in 0..P.fns.len {
        let d = P.fns.get(i);
        if u.str_eq(d.name, name) and u.notnil(d.module) and
           u.ends(u.file_of(d.module.file.id).display, "std/os/cpu.ax") {
            return get_inst(d, ty.no_types());
        }
    }
    internal_error(u.f1("std/os/cpu.ax has no %s (is --std right?)", name));
    return u.nil.[FnInst]();
}

// Does the running processor have every extension in `bits`? (i1)
fn cpu_has_bits(bits: u64) *mut ir.Value {
    let fi = cpu_fn("features");
    let have = call(fi.llty, fi.fnv, no_vals());
    let m = ci(T_i64, bits);
    return icmp(ir.IntEQ, b_and(have, m), m);
}

// C ABI detail: integers narrower than 32 bits and bool are passed and
// returned sign- or zero-extended. Marking every function (and indirect call)
// this way makes any Axiom function with a scalar signature callable from
// C, and C function pointers callable from Axiom (spec §14.5).
fn ext_attr(v: *mut ir.Value, idx: u32, t0: *mut ast.Type, is_call: bool) void {
    let t = ct(t0);
    let mut kind = u.nosym();
    if t.kind == ast.TY_BOOL {
        kind = "zeroext";
    } else if (t.kind == ast.TY_INT) and (t.bits < 32) {
        kind = u.pick(t.is_signed, "signext", "zeroext");
    }
    if u.isnos(kind) {
        return;
    }
    let mut e: u8 = 1;
    if u.str_eq(kind, "signext") {
        e = 2;
    }
    if is_call {
        v.ext[@as(usize, idx)] = e;
    } else if idx == 0 {
        v.fnp.ret_ext = e;
    } else {
        v.fnp.param_ext[@as(usize, idx - 1)] = e;
    }
}

fn add_ext_attrs(v: *mut ir.Value, fnty: *mut ast.Type, sret: bool, is_call: bool) void {
    if not sret and (fnty.ret.kind != ast.TY_VOID) {
        ext_attr(v, 0, fnty.ret, is_call);
    }
    let mut first: u32 = 1;
    if sret {
        first = 2;
        if is_call {
            v.ext[1] = ir.EXT_SRET;  // (the result's memory: the call writes it)
        } else {
            v.fnp.param_ext[0] = ir.EXT_SRET;
        }
    }
    for i in 0..fnty.params.len {
        if not by_ptr(fnty.params[i]) {
            ext_attr(v, first + @int_cast(u32, i), fnty.params[i], is_call);
        } else if is_call {
            // an aggregate passed by value, by address: the callee only reads it
            v.ext[@as(usize, first) + i] = ir.EXT_BYVAL;
        } else {
            v.fnp.param_ext[@as(usize, first) + i - 1] = ir.EXT_BYVAL;
        }
    }
}

fn subst_gargs(g: []mut *mut ast.Type) []mut *mut ast.Type {
    if g.len == 0 {
        return ty.no_types();
    }
    let r = u.newn.[*mut ast.Type](g.len);
    for i in 0..g.len {
        r[i] = ct(g[i]);
    }
    return r;
}

// ---------------------------------------------------------------------------
// Defers and control flow
// ---------------------------------------------------------------------------
fn emit_defers(down_to: usize) void {
    let mut i = F.defers.len;
    while i > down_to {
        i -= 1;
        if terminated() {
            return;
        }
        let s = F.defers.get(i);
        let saved = F.defers.len;
        F.defers.len = i;  // a deferred statement runs with only the outer defers pending
        gen_stmt(s);
        F.defers.len = saved;
    }
}

fn emit_ret(v: *mut ir.Value) void {
    if u.notnil(F.sret_ptr) {
        store(F.ret, v, F.sret_ptr, false);
        ir.ret_void(B);
    } else if F.ret.kind == ast.TY_VOID {
        ir.ret_void(B);
    } else {
        ir.ret(B, v);
    }
}

fn errunion_value(eu: *mut ast.Type, code: *mut ir.Value, payload: *mut ir.Value) *mut ir.Value {
    let t = lty(eu);
    let mut v = ir.undef(t);
    v = insert(v, code, 0);
    if eu.elem.kind != ast.TY_VOID {
        if u.notnil(payload) {
            v = insert(v, to_mem(eu.elem, payload), 1);
        } else {
            v = insert(v, ir.czero(lty(eu.elem)), 1);
        }
    }
    return v;
}

fn gen_return(e: *mut ast.Expr) void {
    let mut v = vnil();
    if u.notnil(e) {
        v = gen(e);
        if terminated() {
            return;
        }
        if F.ret.kind == ast.TY_ERRUNION {
            etrace_push(extract(v, 0));
        }
    } else if F.ret.kind == ast.TY_ERRUNION {
        v = errunion_value(F.ret, ci(T_i16, 0), vnil());
    }
    emit_defers(0);
    if terminated() {
        return;
    }
    emit_ret(v);
    dead_block();
}

fn gen_break(is_break: bool) void {
    if F.loops.len == 0 {
        return;
    }
    let lc = F.loops.last();
    emit_defers(lc.defer_height);
    if is_break {
        br(lc.brk);
    } else {
        br(lc.cont);
    }
    dead_block();
}

// ---------------------------------------------------------------------------
// Arithmetic
// ---------------------------------------------------------------------------
fn int_min(t: *mut ir.Ty) *mut ir.Value {
    let bits = ir.int_width(t);
    return cint(t, u.I128.pow2(bits - 1).neg());
}

fn int_max(t: *mut ir.Ty, is_signed: bool) *mut ir.Value {
    let bits = ir.int_width(t);
    if is_signed {
        return cint(t, u.I128.pow2(bits - 1).sub(u.I128.of(1)));
    }
    return cint(t, u.I128.pow2(bits).sub(u.I128.of(1)));
}

struct Ovf {
    val: *mut ir.Value,
    ovf: *mut ir.Value,
}

// Overflow-checked arithmetic, expressed with plain instructions only.
// (The llvm.*.with.overflow intrinsics would force LLVM's slow SelectionDAG
// path at -O0 on wasm; at -O1+ LLVM re-forms the intrinsics from these
// patterns anyway.)
fn mul_wide_overflow(is_signed: bool, l: *mut ir.Value, r: *mut ir.Value) Ovf {
    let t = l.ty;
    let bits = ir.int_width(t);
    let w = ir.t_int(@int_cast(i32, bits * 2));
    let mut lw = vnil();
    let mut rw = vnil();
    if is_signed {
        lw = sext(l, w);
        rw = sext(r, w);
    } else {
        lw = zext(l, w);
        rw = zext(r, w);
    }
    let p = b_mul(lw, rw);
    let val = trunc(p, t);
    let mut back = vnil();
    if is_signed {
        back = sext(val, w);
    } else {
        back = zext(val, w);
    }
    return Ovf.{ val: val, ovf: icmp(ir.IntNE, back, p) };
}

// 64-bit multiply: the overflow is an intrinsic the native backends compute
// from the machine's multiply (and wasm by dividing back, lower.ax). Wider
// types: no 128-bit multiply needed (freestanding wasm has no compiler-rt);
// overflow is detected by dividing back.
fn mul64_overflow(is_signed: bool, l: *mut ir.Value, r: *mut ir.Value) Ovf {
    let t = l.ty;
    if ir.int_width(t) == 64 {
        let prod = b_mul(l, r);
        let mut xs: [2]*mut ir.Value = [l, r];
        let mut id = ir.IN_UMUL_OV;
        if is_signed {
            id = ir.IN_SMUL_OV;
        }
        return Ovf.{ val: prod, ovf: ir.intr(B, id, T_i1, xs[..]) };
    }
    let zero = ir.czero(t);
    let one = ci(t, 1);
    let prod = b_mul(l, r);
    let lz = icmp(ir.IntEQ, l, zero);
    if not is_signed {
        let div = sel(lz, one, l);
        let back = ir.binop(B, ir.OP_UDIV, prod, div);
        let ne = icmp(ir.IntNE, back, r);  // (right to left, as in the C implementation)
        let ovf = b_and(b_not(lz), ne);
        return Ovf.{ val: prod, ovf: ovf };
    }
    let lm1 = icmp(ir.IntEQ, l, ir.cones(t));
    let safe = b_or(lz, lm1);
    let div = sel(safe, one, l);
    let back = ir.binop(B, ir.OP_SDIV, prod, div);
    let ne = icmp(ir.IntNE, back, r);  // (right to left, as in the C implementation)
    let general = b_and(b_not(safe), ne);
    let m1case = b_and(lm1, icmp(ir.IntEQ, r, int_min(t)));
    return Ovf.{ val: prod, ovf: b_or(general, m1case) };
}

// base: 0 add, 1 sub, 2 mul
fn op_with_overflow(base: i32, is_signed: bool, l: *mut ir.Value, r: *mut ir.Value) Ovf {
    let t = l.ty;
    let zero = ir.czero(t);
    if base == 0 {
        let val = b_add(l, r);
        if is_signed {
            let xr = b_xor(r, val);  // (right to left, as in the C implementation)
            let x = b_and(b_xor(l, val), xr);
            return Ovf.{ val: val, ovf: icmp(ir.IntSLT, x, zero) };
        }
        return Ovf.{ val: val, ovf: icmp(ir.IntULT, val, l) };
    }
    if base == 1 {
        let val = b_sub(l, r);
        if is_signed {
            let xv = b_xor(l, val);  // (right to left, as in the C implementation)
            let x = b_and(b_xor(l, r), xv);
            return Ovf.{ val: val, ovf: icmp(ir.IntSLT, x, zero) };
        }
        return Ovf.{ val: val, ovf: icmp(ir.IntULT, l, r) };
    }
    if ir.int_width(t) <= 32 {
        return mul_wide_overflow(is_signed, l, r);
    }
    return mul64_overflow(is_signed, l, r);
}

fn saturated(t: *mut ir.Ty, neg_direction: *mut ir.Value) *mut ir.Value {
    return sel(neg_direction, int_min(t), int_max(t, true));
}

fn overflow_op(base: i32, is_signed: bool, l: *mut ir.Value, r: *mut ir.Value) *mut ir.Value {
    if O.overflow == OVF_WRAP {
        if base == 0 {
            return b_add(l, r);
        }
        if base == 1 {
            return b_sub(l, r);
        }
        return b_mul(l, r);
    }
    let t = l.ty;
    let o = op_with_overflow(base, is_signed, l, r);
    if O.overflow == OVF_TRAP {
        check_or_trap(b_not(o.ovf), T_OVERFLOW);
        return o.val;
    }
    let zero = ir.czero(t);
    let mut s = vnil();
    if base == 2 {
        if is_signed {
            s = saturated(t, icmp(ir.IntSLT, b_xor(l, r), zero));
        } else {
            s = int_max(t, false);
        }
    } else if base == 0 {
        if is_signed {
            s = saturated(t, icmp(ir.IntSLT, l, zero));
        } else {
            s = int_max(t, false);
        }
    } else {
        if is_signed {
            s = saturated(t, icmp(ir.IntSLT, l, zero));
        } else {
            s = zero;
        }
    }
    return sel(o.ovf, s, o.val);
}

// Shift with mathematical semantics for every count (spec §7.6).
fn gen_shift(op: i32, t: *mut ast.Type, x: *mut ir.Value, k: *mut ir.Value) *mut ir.Value {
    let mut lane = t;
    if t.kind == ast.TY_VEC {
        lane = t.elem;
    }
    if (k.ty.kind == ir.T_VEC) and on_x64() and (k.ty.elem.bits == x.ty.elem.bits) {
        // a count per lane, where x86-64 shifts each lane by its own (and
        // counts beyond the lane give 0, or the sign, as here)
        let mut sid = ir.IN_SHLV;
        if op != lx.TK_SHL {
            sid = ir.IN_LSHRV;
            if lane.is_signed {
                sid = ir.IN_ASHRV;
            }
        }
        if x64.shiftv_ok(sid, x.ty.elem.bits, x.ty.lanes) {
            let mut sargs: [2]*mut ir.Value = [x, k];
            return ir.intr(B, sid, x.ty, sargs[..]);
        }
    }
    if k.ty.kind == ir.T_VEC {
        // a count per lane: lane by lane
        let mut r = ir.undef(x.ty);
        for i in @as(u64, 0)..@as(u64, @bit_cast(u32, t.lanes)) {
            let y = gen_shift(op, lane, ir.extract_elem(B, x, i), ir.extract_elem(B, k, i));
            r = ir.insert_elem(B, r, y, i);
        }
        return r;
    }
    let n = @int_cast(u32, lane.bits);
    let kty = k.ty;
    let ge = icmp(ir.IntUGE, k, ci(kty, @as(u64, n)));
    let lane_ty = ir.t_int(@int_cast(i32, n));
    let arith = (op == lx.TK_SHR) and lane.is_signed;
    let mut fill: u64 = 0;
    if arith {
        fill = @as(u64, n - 1);
    }
    // Only an arithmetic shift needs its count clamped (to fill with the
    // sign); a shift left or a logical shift right by an out-of-range count
    // computes some value (each backend masks the count) that the select
    // below replaces with 0. The optimizer removes the selects when the
    // count's range is below the width.
    let mut kc = k;
    if arith or ir.is_cint(k) {
        kc = sel(ge, ci(kty, fill), k);
    }
    let kb = ir.int_width(kty);
    if kb > n {
        kc = trunc(kc, lane_ty);
    } else if kb < n {
        kc = zext(kc, lane_ty);
    }
    if t.kind == ast.TY_VEC {
        let vt = x.ty;
        kc = ir.splat(B, vt, kc);
    }
    let mut r = vnil();
    if op == lx.TK_SHL {
        r = ir.binop(B, ir.OP_SHL, x, kc);
    } else if arith {
        return ir.binop(B, ir.OP_ASHR, x, kc);
    } else {
        r = ir.binop(B, ir.OP_LSHR, x, kc);
    }
    return sel(ge, ir.czero(x.ty), r);
}

fn gen_binop(op: i32, t: *mut ast.Type, l: *mut ir.Value, r: *mut ir.Value) *mut ir.Value {
    let is_float = (t.kind == ast.TY_FLOAT) or ty.is_vec_float(t);
    let mut sgn = false;
    if t.kind == ast.TY_INT {
        sgn = t.is_signed;
    } else if t.kind == ast.TY_VEC {
        sgn = t.elem.is_signed;
    }
    let is_vec = t.kind == ast.TY_VEC;  // integer vectors wrap in every mode
    if op == lx.TK_PLUS {
        if is_float {
            return ir.binop(B, ir.OP_FADD, l, r);
        }
        if is_vec {
            return b_add(l, r);
        }
        return overflow_op(0, sgn, l, r);
    }
    if op == lx.TK_MINUS {
        if is_float {
            return ir.binop(B, ir.OP_FSUB, l, r);
        }
        if is_vec {
            return b_sub(l, r);
        }
        return overflow_op(1, sgn, l, r);
    }
    if op == lx.TK_STAR {
        if is_float {
            return ir.binop(B, ir.OP_FMUL, l, r);
        }
        if is_vec {
            return b_mul(l, r);
        }
        return overflow_op(2, sgn, l, r);
    }
    if op == lx.TK_SLASH {
        if is_float {
            return ir.binop(B, ir.OP_FDIV, l, r);
        }
        let tt = l.ty;
        check_or_trap(icmp(ir.IntNE, r, ir.czero(tt)), T_DIVZERO);
        if not sgn {
            return ir.binop(B, ir.OP_UDIV, l, r);
        }
        if O.overflow == OVF_WRAP {
            // MIN / -1 wraps to MIN: a divisor of -1 negates (as `%` gives 0)
            let m1 = icmp(ir.IntEQ, r, ir.cones(tt));
            let q = ir.binop(B, ir.OP_SDIV, l, sel(m1, ci(tt, 1), r));
            return sel(m1, ir.neg(B, l), q);
        }
        let rm1 = icmp(ir.IntEQ, r, ir.cones(tt));  // (right to left, as in the C implementation)
        let ovf = b_and(icmp(ir.IntEQ, l, int_min(tt)), rm1);
        if O.overflow == OVF_TRAP {
            check_or_trap(b_not(ovf), T_OVERFLOW);
            return ir.binop(B, ir.OP_SDIV, l, r);
        }
        let r2 = sel(ovf, ci(tt, 1), r);
        let q = ir.binop(B, ir.OP_SDIV, l, r2);
        return sel(ovf, int_max(tt, true), q);
    }
    if op == lx.TK_PERCENT {
        let tt = l.ty;
        check_or_trap(icmp(ir.IntNE, r, ir.czero(tt)), T_DIVZERO);
        if not sgn {
            return ir.binop(B, ir.OP_UREM, l, r);
        }
        let m1 = icmp(ir.IntEQ, r, ir.cones(tt));
        let r2 = sel(m1, ci(tt, 1), r);
        return ir.binop(B, ir.OP_SREM, l, r2);
    }
    if op == lx.TK_PLUS_PCT {
        return b_add(l, r);
    }
    if op == lx.TK_MINUS_PCT {
        return b_sub(l, r);
    }
    if op == lx.TK_STAR_PCT {
        return b_mul(l, r);
    }
    if op == lx.TK_AMP {
        return b_and(l, r);
    }
    if op == lx.TK_PIPE {
        return b_or(l, r);
    }
    if op == lx.TK_CARET {
        return b_xor(l, r);
    }
    if (op == lx.TK_SHL) or (op == lx.TK_SHR) {
        return gen_shift(op, t, l, r);
    }
    // comparisons
    if is_float {
        let mut p = ir.RealOGE;
        if op == lx.TK_EQEQ {
            p = ir.RealOEQ;
        } else if op == lx.TK_NE {
            p = ir.RealUNE;
        } else if op == lx.TK_LT {
            p = ir.RealOLT;
        } else if op == lx.TK_LE {
            p = ir.RealOLE;
        } else if op == lx.TK_GT {
            p = ir.RealOGT;
        }
        return fcmp(p, l, r);
    }
    let mut p = ir.IntUGE;
    if sgn {
        p = ir.IntSGE;
    }
    if op == lx.TK_EQEQ {
        p = ir.IntEQ;
    } else if op == lx.TK_NE {
        p = ir.IntNE;
    } else if op == lx.TK_LT {
        p = ir.IntULT;
        if sgn {
            p = ir.IntSLT;
        }
    } else if op == lx.TK_LE {
        p = ir.IntULE;
        if sgn {
            p = ir.IntSLE;
        }
    } else if op == lx.TK_GT {
        p = ir.IntUGT;
        if sgn {
            p = ir.IntSGT;
        }
    }
    return icmp(p, l, r);
}

// ---------------------------------------------------------------------------
// Places
// ---------------------------------------------------------------------------
fn addr_or_spill(e: *mut ast.Expr) *mut ir.Value {
    if sema.is_place(e) {
        return gen_addr(e);
    }
    let t = ct(e.ty);
    return spill(t, gen(e));
}

// Is e a place whose storage may be misaligned (reached through a pointer)?
fn via_pointer(e: *mut ast.Expr) bool {
    let k = e.kind;
    if k == ast.E_DEREF {
        return true;
    }
    if k == ast.E_FIELD {
        return (e.self_mode == ast.SELF_DEREF) or ((e.op == ast.FK_STRUCT) and via_pointer(e.a));
    }
    if k == ast.E_INDEX {
        return (e.op != ast.IDX_ARRAY) or via_pointer(e.a);
    }
    return false;
}

fn array_len_value(arr: *mut ast.Type) *mut ir.Value {
    return usz(arr.len);
}

fn gen_addr_inner(e: *mut ast.Expr) *mut ir.Value {
    let k = e.kind;
    if k == ast.E_IDENT {
        if u.notnil(e.local) {
            return local_ptr(e.local);
        }
        if u.notnil(e.decl) and (e.decl.kind == ast.D_GLOBAL) {
            return global_addr(e.decl);
        }
    } else if k == ast.E_DEREF {
        return gen(e.a);
    } else if k == ast.E_FIELD {
        if (e.op == ast.FK_DECL) and u.notnil(e.decl) and (e.decl.kind == ast.D_GLOBAL) {
            return global_addr(e.decl);
        }
        let at = ct(e.a.ty);
        let mut base = vnil();
        let mut stt = at;
        if e.self_mode == ast.SELF_DEREF {
            base = gen(e.a);
            stt = at.elem;
        } else {
            base = addr_or_spill(e.a);
        }
        return sgep(lty(stt), base, @int_cast(u32, e.index));
    } else if k == ast.E_INDEX {
        let at = ct(e.a.ty);
        if e.op == ast.IDX_SLICE {
            let s = gen(e.a);
            let idx = gen(e.b);
            let ptr = extract(s, 0);
            let len = extract(s, 1);
            check_or_trap(icmp(ir.IntULT, idx, len), T_BOUNDS);
            return gep1(lty(at.elem), ptr, idx);
        }
        let mut arr = at;
        let mut base = vnil();
        if e.op == ast.IDX_PTR_ARRAY {
            arr = at.elem;
            base = gen(e.a);
        } else {
            base = addr_or_spill(e.a);
        }
        let idx = gen(e.b);
        check_or_trap(icmp(ir.IntULT, idx, array_len_value(arr)), T_BOUNDS);
        return gep2(lty(arr), base, usz(0), idx);
    }
    // not a place: materialize
    let t = ct(e.ty);
    return spill(t, gen(e));
}

// ---------------------------------------------------------------------------
// Calls
// ---------------------------------------------------------------------------
fn emit_call(fty: *mut ir.Ty, fnv: *mut ir.Value, fnty: *mut ast.Type, sret: bool, argv: []mut *mut ir.Value,
             argt: []mut *mut ast.Type, callee: []u8) *mut ir.Value {
    let argc = argv.len;
    let mut n = argc;
    if sret {
        n += 1;
    }
    let av = u.newn.[*mut ir.Value](n + 1);
    let mut k: usize = 0;
    let mut ret_tmp = vnil();
    if sret {
        ret_tmp = temp_alloca(fnty.ret);
        av[k] = ret_tmp;
        k += 1;
    }
    for i in 0..argc {
        if by_ptr(argt[i]) {
            av[k] = spill(argt[i], argv[i]);
        } else {
            av[k] = argv[i];
        }
        k += 1;
    }
    let sf = ss_push(callee);
    let r = call(fty, fnv, av[0..n]);
    ss_pop(sf, r);
    add_ext_attrs(r, fnty, sret, true);
    if sret {
        return load(fnty.ret, ret_tmp, false);
    }
    if fnty.ret.kind == ast.TY_VOID {
        return vnil();
    }
    return r;
}

fn gen_call(e: *mut ast.Expr) *mut ir.Value {
    if e.op == ast.CALLK_VARIANT {
        let ut = ct(e.tval);
        let tmp = temp_alloca(ut);
        let tagp = sgep(lty(ut), tmp, 0);
        let payload = gen(e.args.get(0));
        _ = st(ci(lty(ty.union_tag_type(ut)), @int_cast(u64, e.index)), tagp);
        let pt = ty.type_variant(ut, @int_cast(usize, e.index));
        let pp = sgep(lty(ut), tmp, 1);
        store(pt, payload, pp, true);
        return load(ut, tmp, false);
    }
    if e.op == ast.CALLK_INDIRECT {
        let ft = ct(e.a.ty);
        let fp = gen(e.a);
        let n = e.args.len;
        let av = u.newn.[*mut ir.Value](n + 1);
        for i in 0..n {
            av[i] = gen(e.args.get(i));
        }
        let fl = fn_lty(ft);
        return emit_call(fl.t, fp, ft, fl.sret, av[0..n], ft.params, u.nosym());
    }
    let d = e.decl;
    let fi = get_callee(d, subst_gargs(e.gargs));
    let has_recv = u.notnil(e.b);
    let mut n = e.args.len;
    if has_recv {
        n += 1;
    }
    let av = u.newn.[*mut ir.Value](n + 1);
    let mut k: usize = 0;
    if has_recv {
        let recv = e.b;
        let sm = e.self_mode;
        if sm == ast.SELF_DEREF {
            let pt = ct(recv.ty);
            av[k] = load(pt.elem, gen(recv), true);
        } else if sm == ast.SELF_ADDR {
            av[k] = gen_addr(recv);
        } else {
            av[k] = gen(recv);
        }
        k += 1;
    }
    for i in 0..e.args.len {
        av[k] = gen(e.args.get(i));
        k += 1;
    }
    let mut argt = fi.fnty.params;
    if d.variadic {  // types of the extra (promoted) arguments
        argt = u.newn.[*mut ast.Type](n + 1);
        let mut off: usize = 0;
        if has_recv {
            off = 1;
        }
        for i in 0..n {
            if i < fi.fnty.params.len {
                argt[i] = fi.fnty.params[i];
            } else {
                argt[i] = ct(e.args.get(i - off).ty);
            }
        }
    }
    return emit_call(fi.llty, fi.fnv, fi.fnty, fi.sret, av[0..n], argt, fi.display);
}

// ---------------------------------------------------------------------------
// catch / try
// ---------------------------------------------------------------------------
fn gen_try(e: *mut ast.Expr) *mut ir.Value {
    let eu = ct(e.a.ty);
    let v = gen(e.a);
    let code = extract(v, 0);
    let is_err = icmp(ir.IntNE, code, ci(T_i16, 0));
    let err_bb = new_bb("try.err".ptr);
    let ok_bb = new_bb("try.ok".ptr);
    condbr(is_err, err_bb, ok_bb);
    at_end(err_bb);
    etrace_push(code);
    let rv = errunion_value(F.ret, code, vnil());
    emit_defers(0);
    if not terminated() {
        emit_ret(rv);
    }
    at_end(ok_bb);
    if eu.elem.kind == ast.TY_VOID {
        return vnil();
    }
    return from_mem(eu.elem, extract(v, 1));
}

fn gen_catch(e: *mut ast.Expr) *mut ir.Value {
    let eu = ct(e.a.ty);
    let vt = eu.elem;
    let v = gen(e.a);
    let code = extract(v, 0);
    let is_err = icmp(ir.IntNE, code, ci(T_i16, 0));
    let err_bb = new_bb("catch.err".ptr);
    let ok_bb = new_bb("catch.ok".ptr);
    let merge = new_bb("catch.end".ptr);
    condbr(is_err, err_bb, ok_bb);
    at_end(err_bb);
    etrace_clear();
    if u.notnil(e.capture_local) {
        store(ty.t_error, code, local_ptr(e.capture_local), false);
    }
    let mut hv = vnil();
    let mut hbb = bbnil();
    let hk = e.hkind;
    if hk == ast.H_VALUE {
        hv = gen(e.hexpr);
        if not terminated() {
            hbb = ir.insert_block(B);
            br(merge);
        }
    } else if hk == ast.H_RETURN {
        gen_return(e.hexpr);
    } else if hk == ast.H_BREAK {
        gen_break(true);
    } else if hk == ast.H_CONTINUE {
        gen_break(false);
    } else if hk == ast.H_BLOCK {
        gen_block(e.hblock);
        if not terminated() {
            br(merge);  // only possible for !void
        }
    }
    if not terminated() {
        ir.unreachable(B);
    }
    at_end(ok_bb);
    let mut ov = vnil();
    if vt.kind != ast.TY_VOID {
        ov = from_mem(vt, extract(v, 1));
    }
    let obb = ir.insert_block(B);
    br(merge);
    at_end(merge);
    if vt.kind == ast.TY_VOID {
        return vnil();
    }
    if u.isnil(hbb) or u.isnil(hv) {
        return ov;
    }
    let phi = ir.phi(B, vty(vt));
    let mut vals: [2]*mut ir.Value = [ov, hv];
    let mut bbs: [2]*mut ir.Block = [obb, hbb];
    ir.add_incoming(phi, vals[0], bbs[0]);
    ir.add_incoming(phi, vals[1], bbs[1]);
    return phi;
}

// ---------------------------------------------------------------------------
// Builtins
// ---------------------------------------------------------------------------
fn splat(vt: *mut ir.Ty, x: *mut ir.Value, lanes: u32) *mut ir.Value {
    return ir.splat(B, vt, x);
}

// The lanes summed by folding the halves (spec §13.2): lane i plus lane
// i + n/2, until one lane is left. Vectors while the halves are 128 bits or
// more, then lane by lane.
fn reduce_add(vt: *mut ast.Type, v0: *mut ir.Value) *mut ir.Value {
    let is_float = vt.elem.kind == ast.TY_FLOAT;
    let mut v = v0;
    let mut n = @int_cast(usize, vt.lanes);
    let lb = @int_cast(usize, vt.bits);
    while (n > 1) and (((n / 2) * lb) >= 128) {
        let h = n / 2;
        let lo = u.newn.[i32](h);
        let hi = u.newn.[i32](h);
        for i in 0..h {
            lo[i] = @truncate(i32, @bit_cast(isize, i));
            hi[i] = @truncate(i32, @bit_cast(isize, i + h));
        }
        let a = ir.shuffle(B, v, v, lo);
        let b = ir.shuffle(B, v, v, hi);
        if is_float {
            v = ir.binop(B, ir.OP_FADD, a, b);
        } else {
            v = b_add(a, b);
        }
        n = h;
    }
    if (n > 1) and ((n * lb) == 128) {
        // within the 128-bit vector: its upper half's lanes shuffled down and
        // added, the lanes above them ignored
        let l = n;
        while n > 1 {
            let h = n / 2;
            let m = u.newn.[i32](l);
            for i in 0..l {
                m[i] = @truncate(i32, @bit_cast(isize, (i % h) + h));
            }
            let b = ir.shuffle(B, v, v, m);
            if is_float {
                v = ir.binop(B, ir.OP_FADD, v, b);
            } else {
                v = b_add(v, b);
            }
            n = h;
        }
        return ext_elem(v, ci32(0));
    }
    let xs = u.newn.[*mut ir.Value](n);
    for i in 0..n {
        xs[i] = ext_elem(v, ci32(@as(u64, i)));
    }
    while n > 1 {
        let h = n / 2;
        for i in 0..h {
            if is_float {
                xs[i] = ir.binop(B, ir.OP_FADD, xs[i], xs[i + h]);
            } else {
                xs[i] = b_add(xs[i], xs[i + h]);
            }
        }
        n = h;
    }
    return xs[0];
}

fn ext_int(v: *mut ir.Value, to: *mut ir.Ty, is_signed: bool) *mut ir.Value {
    let a = ir.int_width(v.ty);
    let b = ir.int_width(to);
    if a == b {
        return v;
    }
    if a > b {
        return trunc(v, to);
    }
    if is_signed {
        return sext(v, to);
    }
    return zext(v, to);
}

// x86-64 code generation, which selects some vector builtins whole (where
// the function's extensions have them: x64.perm_ok and the like).
fn on_x64() bool {
    return tg.g_arch == tg.ARCH_X64;
}

fn on_a64() bool {
    return tg.g_arch == tg.ARCH_A64;
}

// The mask (i64) of the first k lanes, k <= 64: (1 << k) - 1 in two shifts,
// each below 64.
fn lane_mask(k: *mut ir.Value) *mut ir.Value {
    let h = ir.binop(B, ir.OP_LSHR, k, usz(1));
    let one = ci(T_i64, 1);
    let m = ir.binop(B, ir.OP_SHL, ir.binop(B, ir.OP_SHL, one, h), b_sub(k, h));
    return b_sub(m, one);
}

// A lane-wise builtin on a vector (spec §13.2) that the backends have for
// scalars only: lane by lane. `src_signed`: the operand's lanes, for
// @float_from_int.
fn lanewise(id: i32, rt: *mut ast.Type, v: *mut ir.Value, src_signed: bool) *mut ir.Value {
    let n = @as(u64, @bit_cast(u32, rt.lanes));
    let lt = lty(rt.elem);
    let mut r = ir.undef(lty(rt));
    for k in @as(u64, 0)..n {
        let x = ir.extract_elem(B, v, k);
        let mut y = x;
        if (id == ast.BI_CLZ) or (id == ast.BI_CTZ) {
            let mut t: [1]*mut ir.Ty = [x.ty];
            let mut args: [2]*mut ir.Value = [x, ci(T_i1, 0)];
            y = intrinsic(u.pick(id == ast.BI_CLZ, "llvm.ctlz", "llvm.cttz"), t[..], args[..]);
        } else if id == ast.BI_POPCOUNT {
            y = intr1("llvm.ctpop", x);
        } else if id == ast.BI_INT_FROM_FLOAT {
            let mut tys: [2]*mut ir.Ty = [lt, x.ty];
            let mut args: [1]*mut ir.Value = [x];
            y = intrinsic(u.pick(rt.is_signed, "llvm.fptosi.sat", "llvm.fptoui.sat"), tys[..], args[..]);
        } else if src_signed {
            y = ir.cast(B, ir.OP_SITOFP, x, lt);
        } else {
            y = ir.cast(B, ir.OP_UITOFP, x, lt);
        }
        r = ir.insert_elem(B, r, y, k);
    }
    return r;
}

// A vector of n lanes of type lt, each v.
fn const_lanes(lt: *mut ir.Ty, n: usize, v: u64) *mut ir.Value {
    let xs = u.newn.[*mut ir.Value](n);
    for i in 0..n {
        xs[i] = ci(lt, v);
    }
    return ir.cagg(ir.t_vec(lt, @truncate(u32, n)), xs);
}

// @swizzle (spec §13.2): lane i of the result is lane idx[i] of the table, or
// 0 when idx[i] (unsigned) is not a lane. Wider lanes become byte indices,
// min(idx, n) * lanebytes + k for byte k of a lane (at most 64 + 7).
fn swizzle_lanes(t: *mut ast.Type, x: *mut ir.Value, idx: *mut ir.Value) *mut ir.Value {
    let n = @int_cast(usize, t.lanes);
    let lb = @int_cast(usize, t.bits) / 8;
    if lb == 1 {
        let mut sargs: [2]*mut ir.Value = [x, idx];
        return ir.intr(B, ir.IN_SWIZZLE, x.ty, sargs[..]);
    }
    let nb = n * lb;
    let bt = ir.t_vec(T_i8, @truncate(u32, nb));
    let it = idx.ty;
    let cn = const_lanes(it.elem, n, @as(u64, n));
    let m = sext(icmp(ir.IntULT, idx, cn), it);
    let mut cl = b_or(b_and(idx, m), b_and(cn, b_not(m)));
    let mut k: usize = 1;
    while k < lb {
        cl = b_add(cl, cl);
        k *= 2;
    }
    let bytes = bitcast(cl, bt);
    let rep = u.newn.[i32](nb);
    let kk = u.newn.[*mut ir.Value](nb);
    for i in 0..nb {
        rep[i] = @truncate(i32, @bit_cast(isize, (i / lb) * lb));
        kk[i] = ci(T_i8, @as(u64, i % lb));
    }
    let bi = b_add(ir.shuffle(B, bytes, bytes, rep), ir.cagg(bt, kk));
    let mut sargs: [2]*mut ir.Value = [bitcast(x, bt), bi];
    return bitcast(ir.intr(B, ir.IN_SWIZZLE, bt, sargs[..]), x.ty);
}

fn barg(e: *mut ast.Expr, i: usize) *mut ast.Expr {
    return e.bargs.at(i).e;
}

fn gen_builtin(e: *mut ast.Expr) *mut ir.Value {
    let rt = ct(e.ty);
    let id = e.index;
    if id == ast.BI_SIZE_OF {
        return usz(ty.type_size(ct(e.tval)));
    }
    if id == ast.BI_ALIGN_OF {
        return usz(ty.type_align(ct(e.tval)));
    }
    if id == ast.BI_OFFSET_OF {
        return usz(ty.type_field_offset(ct(e.tval), @int_cast(usize, barg(e, 1).index)));
    }
    if (id == ast.BI_MIN_VALUE) or (id == ast.BI_MAX_VALUE) {
        let r = ty.int_range(rt);
        if id == ast.BI_MIN_VALUE {
            return cint(lty(rt), r.lo);
        }
        return cint(lty(rt), r.hi);
    }
    if id == ast.BI_AS {
        let s = ct(barg(e, 1).ty);
        let v = gen(barg(e, 1));
        if s == rt {
            return v;
        }
        if s.kind == ast.TY_BOOL {
            return zext(v, lty(rt));
        }
        if (s.kind == ast.TY_INT) and (rt.kind == ast.TY_INT) {
            return ext_int(v, lty(rt), s.is_signed);
        }
        if (s.kind == ast.TY_FLOAT) and (rt.kind == ast.TY_FLOAT) {
            return ir.cast(B, ir.OP_FPEXT, v, lty(rt));
        }
        if (s.kind == ast.TY_INT) and (rt.kind == ast.TY_FLOAT) {
            if s.is_signed {
                return ir.cast(B, ir.OP_SITOFP, v, lty(rt));
            }
            return ir.cast(B, ir.OP_UITOFP, v, lty(rt));
        }
        return v;
    }
    if id == ast.BI_INT_FROM_ENUM {
        return gen(barg(e, 0));
    }
    if id == ast.BI_ENUM_FROM_INT {
        // Trap unless the value is one of the enum's members.
        let d = e.tval.decl;
        let s = ct(barg(e, 1).ty);
        let v = gen(barg(e, 1));
        let ok = new_bb("enum.ok".ptr);
        let sw = ir.switch_(B, v, trap_block(T_UNIONTAG));
        let r = ty.int_range(s);
        for i in 0..d.variants.len {
            let x = d.variants.at(i).value;
            if x.ge(r.lo) and x.le(r.hi) {
                ir.add_case(sw, cint(v.ty, x), ok);
            }
        }
        at_end(ok);
        return ext_int(v, lty(rt), s.is_signed);
    }
    if id == ast.BI_INT_CAST {
        let s = ct(barg(e, 1).ty);
        let v = gen(barg(e, 1));
        if s == rt {
            return v;
        }
        // Range check in the source type's width (no 128-bit arithmetic).
        let stt = v.ty;
        let sb = @int_cast(u32, s.bits);
        let tb = @int_cast(u32, rt.bits);
        let mut ok = ci(T_i1, 1);
        if s.is_signed {
            if not rt.is_signed {
                ok = icmp(ir.IntSGE, v, ir.czero(stt));
            } else if tb < sb {
                ok = icmp(ir.IntSGE, v, cint(stt, u.I128.pow2(tb - 1).neg()));
            }
        }
        let mut tmax_bits = tb;  // T.max = 2^tmax_bits - 1
        if rt.is_signed {
            tmax_bits = tb - 1;
        }
        let mut smax_bits = sb;
        if s.is_signed {
            smax_bits = sb - 1;
        }
        if tmax_bits < smax_bits {
            let hi = cint(stt, u.I128.pow2(tmax_bits).sub(u.I128.of(1)));
            let mut p = ir.IntULE;
            if s.is_signed {
                p = ir.IntSLE;
            }
            ok = b_and(ok, icmp(p, v, hi));
        }
        check_or_trap(ok, T_INTCAST);
        return ext_int(v, lty(rt), s.is_signed);
    }
    if id == ast.BI_TRUNCATE {
        let s = ct(barg(e, 1).ty);
        return ext_int(gen(barg(e, 1)), lty(rt), s.is_signed);
    }
    if ((id == ast.BI_INT_FROM_FLOAT) or (id == ast.BI_FLOAT_FROM_INT)) and (rt.kind == ast.TY_VEC) {
        let srct = ct(barg(e, 1).ty);
        let v = gen(barg(e, 1));
        if (on_x64() or on_a64()) and (srct.elem.bits == rt.elem.bits) {
            // whole vectors (x64.ax and a64.ax convert them, or the lanes one by one)
            let mut op = ir.OP_UITOFP;
            if id == ast.BI_INT_FROM_FLOAT {
                op = ir.OP_FPTOUI_SAT;
                if rt.is_signed {
                    op = ir.OP_FPTOSI_SAT;
                }
            } else if srct.is_signed {
                op = ir.OP_SITOFP;
            }
            return ir.cast(B, op, v, lty(rt));
        }
        return lanewise(id, rt, v, srct.is_signed);
    }
    if ((id == ast.BI_CLZ) or (id == ast.BI_CTZ) or (id == ast.BI_POPCOUNT)) and (rt.kind == ast.TY_VEC) {
        let v = gen(barg(e, 0));
        if on_x64() and (v.ty.elem.bits == lty(rt).elem.bits) {
            // whole vectors (x64.ax counts them, or the lanes one by one)
            let mut iid = ir.IN_CTPOP;
            if id == ast.BI_CLZ {
                iid = ir.IN_CTLZ;
            } else if id == ast.BI_CTZ {
                iid = ir.IN_CTTZ;
            }
            let mut args: [1]*mut ir.Value = [v];
            return ir.intr(B, iid, lty(rt), args[..]);
        }
        return lanewise(id, rt, v, false);
    }
    if id == ast.BI_INT_FROM_FLOAT {
        let v = gen(barg(e, 1));
        let mut tys: [2]*mut ir.Ty = [lty(rt), v.ty];
        let mut args: [1]*mut ir.Value = [v];
        return intrinsic(u.pick(rt.is_signed, "llvm.fptosi.sat", "llvm.fptoui.sat"), tys[..], args[..]);
    }
    if id == ast.BI_FLOAT_FROM_INT {
        let s = ct(barg(e, 1).ty);
        let v = gen(barg(e, 1));
        if s.is_signed {
            return ir.cast(B, ir.OP_SITOFP, v, lty(rt));
        }
        return ir.cast(B, ir.OP_UITOFP, v, lty(rt));
    }
    if id == ast.BI_FLOAT_CAST {
        let s = ct(barg(e, 1).ty);
        let v = gen(barg(e, 1));
        if s.bits == rt.bits {
            return v;
        }
        if s.bits > rt.bits {
            return ir.cast(B, ir.OP_FPTRUNC, v, lty(rt));
        }
        return ir.cast(B, ir.OP_FPEXT, v, lty(rt));
    }
    if id == ast.BI_BIT_CAST {
        let s = ct(barg(e, 1).ty);
        let v = gen(barg(e, 1));
        if s == rt {
            return v;
        }
        if (s.kind == ast.TY_PTR) and (rt.kind != ast.TY_PTR) {
            return ptrtoint(v, lty(rt));
        }
        if (rt.kind == ast.TY_PTR) and (s.kind != ast.TY_PTR) {
            return inttoptr(v, T_ptr);
        }
        if rt.kind == ast.TY_PTR {
            return v;
        }
        return bitcast(v, lty(rt));
    }
    if id == ast.BI_INT_FROM_PTR {
        return ptrtoint(gen(barg(e, 0)), T_isz);
    }
    if id == ast.BI_PTR_FROM_INT {
        return inttoptr(gen(barg(e, 1)), T_ptr);
    }
    if id == ast.BI_PTR_CAST {
        return gen(barg(e, 1));
    }
    if (id == ast.BI_PTR_ADD) or (id == ast.BI_PTR_SUB) {
        let p = gen(barg(e, 0));
        let mut off = b_mul(gen(barg(e, 1)), usz(ty.type_size(rt.elem)));
        if id == ast.BI_PTR_SUB {
            off = ir.neg(B, off);
        }
        return ir.ptradd(B, p, off);
    }
    if id == ast.BI_SLICE_FROM_PTR {
        let p = gen(barg(e, 0));
        let n = gen(barg(e, 1));
        let s = insert(ir.undef(lty(rt)), p, 0);
        return insert(s, n, 1);
    }
    if id == ast.BI_CAST_SLICE {
        let stt = ct(barg(e, 1).ty);
        let s = gen(barg(e, 1));
        let from = ty.type_size(stt.elem);
        let to = ty.type_size(rt.elem);
        let len = extract(s, 1);
        let bytes = b_mul(len, usz(from));
        let mut nlen = vnil();
        if to == 0 {
            nlen = usz(0);
        } else {
            check_or_trap(icmp(ir.IntEQ, ir.binop(B, ir.OP_UREM, bytes, usz(to)), usz(0)), T_LENGTH);
            nlen = ir.binop(B, ir.OP_UDIV, bytes, usz(to));
        }
        return insert(s, nlen, 1);
    }
    if id == ast.BI_MEM_COPY {
        let dt = ct(barg(e, 0).ty);
        let d = gen(barg(e, 0));
        let s = gen(barg(e, 1));
        let dl = extract(d, 1);
        let sl = extract(s, 1);
        check_or_trap(icmp(ir.IntEQ, dl, sl), T_LENGTH);
        let bytes = b_mul(dl, usz(ty.type_size(dt.elem)));
        asan_check_slice(d, dt.elem);
        asan_check_slice(s, dt.elem);
        let sp0 = extract(s, 0);  // (right to left, as in the C implementation)
        _ = ir.memop(B, ir.OP_MEMMOVE, extract(d, 0), sp0, bytes);
        return vnil();
    }
    if id == ast.BI_MEM_SET {
        let dt = ct(barg(e, 0).ty);
        let d = gen(barg(e, 0));
        let v = gen(barg(e, 1));
        let ptr = extract(d, 0);
        let len = extract(d, 1);
        asan_check_slice(d, dt.elem);
        if (dt.elem.kind == ast.TY_INT) and (dt.elem.bits == 8) {
            _ = ir.memop(B, ir.OP_MEMSET, ptr, v, len);
            return vnil();
        }
        // generic loop
        let iv = alloca_in_entry(T_isz, "i".ptr);
        _ = st(usz(0), iv);
        let cond = new_bb("memset.cond".ptr);
        let body = new_bb("memset.body".ptr);
        let end = new_bb("memset.end".ptr);
        br(cond);
        at_end(cond);
        let i = ld(T_isz, iv);
        condbr(icmp(ir.IntULT, i, len), body, end);
        at_end(body);
        store(dt.elem, v, gep1(lty(dt.elem), ptr, i), true);
        _ = st(b_add(i, usz(1)), iv);
        br(cond);
        at_end(end);
        return vnil();
    }
    if id == ast.BI_MEM_EQ {
        let stt = ct(barg(e, 0).ty);
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        let xl = extract(x, 1);
        let yl = extract(y, 1);
        let xp = extract(x, 0);
        let yp = extract(y, 0);
        let bytes = b_mul(xl, usz(ty.type_size(stt.elem)));
        asan_check_slice(x, stt.elem);
        asan_check_slice(y, ct(barg(e, 1).ty).elem);
        let res = alloca_in_entry(T_i1, "eq".ptr);
        let iv = alloca_in_entry(T_isz, "i".ptr);
        _ = st(icmp(ir.IntEQ, xl, yl), res);
        _ = st(usz(0), iv);
        let cond = new_bb("memeq.cond".ptr);
        let body = new_bb("memeq.body".ptr);
        let neq = new_bb("memeq.ne".ptr);
        let end = new_bb("memeq.end".ptr);
        br(cond);
        at_end(cond);
        let i = ld(T_isz, iv);
        let lt = icmp(ir.IntULT, i, bytes);  // (right to left, as in the C implementation)
        let more = b_and(ld(T_i1, res), lt);
        condbr(more, body, end);
        at_end(body);
        let bx = ld(T_i8, gep1(T_i8, xp, i));
        let by = ld(T_i8, gep1(T_i8, yp, i));
        _ = st(b_add(i, usz(1)), iv);
        condbr(icmp(ir.IntEQ, bx, by), cond, neq);
        at_end(neq);
        _ = st(ci(T_i1, 0), res);
        br(end);
        at_end(end);
        return ld(T_i1, res);
    }
    if id == ast.BI_MEMORY_SIZE {
        return mem_size();
    }
    if id == ast.BI_MEMORY_GROW {
        let prev = mem_grow(gen(barg(e, 0)));
        let failed = icmp(ir.IntEQ, prev, ir.cones(T_isz));
        let code = sel(failed, errcode_value(sema.error_code_of(u.intern("OutOfMemory"))), ci(T_i16, 0));
        return errunion_value(rt, code, prev);
    }
    if (id == ast.BI_CLZ) or (id == ast.BI_CTZ) {
        let v = gen(barg(e, 0));
        let mut t: [1]*mut ir.Ty = [v.ty];
        let mut args: [2]*mut ir.Value = [v, ci(T_i1, 0)];
        return intrinsic(u.pick(id == ast.BI_CLZ, "llvm.ctlz", "llvm.cttz"), t[..], args[..]);
    }
    if id == ast.BI_POPCOUNT {
        return intr1("llvm.ctpop", gen(barg(e, 0)));
    }
    if (id == ast.BI_ROTL) or (id == ast.BI_ROTR) {
        let v = gen(barg(e, 0));
        let mut k = gen(barg(e, 1));
        k = ext_int(k, v.ty, false);
        let mut t: [1]*mut ir.Ty = [v.ty];
        let mut args: [3]*mut ir.Value = [v, v, k];
        return intrinsic(u.pick(id == ast.BI_ROTL, "llvm.fshl", "llvm.fshr"), t[..], args[..]);
    }
    if (id == ast.BI_ADD_SAT) or (id == ast.BI_SUB_SAT) {
        let mut sg = false;
        if rt.kind == ast.TY_INT {
            sg = rt.is_signed;
        } else {
            sg = rt.elem.is_signed;
        }
        let nm = u.f2("llvm.%s%s.sat", u.pick(sg, "s", "u"), u.pick(id == ast.BI_ADD_SAT, "add", "sub"));
        let a1 = gen(barg(e, 1));  // (right to left, as in the C implementation)
        let a0 = gen(barg(e, 0));
        return intr2(nm, a0, a1);
    }
    if id == ast.BI_MUL_SAT {
        let l = gen(barg(e, 0));
        let r = gen(barg(e, 1));
        let saved = O.overflow;
        O.overflow = OVF_SATURATE;
        let v = overflow_op(2, rt.is_signed, l, r);
        O.overflow = saved;
        return v;
    }
    if (id == ast.BI_ADD_CHECKED) or (id == ast.BI_SUB_CHECKED) or (id == ast.BI_MUL_CHECKED) {
        let t = rt.elem;
        let l = gen(barg(e, 0));
        let r = gen(barg(e, 1));
        let mut base: i32 = 2;
        if id == ast.BI_ADD_CHECKED {
            base = 0;
        } else if id == ast.BI_SUB_CHECKED {
            base = 1;
        }
        let o = op_with_overflow(base, t.is_signed, l, r);
        let code = sel(o.ovf, errcode_value(sema.error_code_of(u.intern("Overflow"))), ci(T_i16, 0));
        return errunion_value(rt, code, o.val);
    }
    if (id == ast.BI_MIN) or (id == ast.BI_MAX) {
        let l = gen(barg(e, 0));
        let r = gen(barg(e, 1));
        let mn = id == ast.BI_MIN;
        if (rt.kind == ast.TY_FLOAT) or ty.is_vec_float(rt) {
            return intr2(u.pick(mn, "llvm.minimum", "llvm.maximum"), l, r);
        }
        let mut sg = false;
        if rt.kind == ast.TY_INT {
            sg = rt.is_signed;
        } else {
            sg = rt.elem.is_signed;
        }
        return intr2(u.f2("llvm.%s%s", u.pick(sg, "s", "u"), u.pick(mn, "min", "max")), l, r);
    }
    if id == ast.BI_ABS {
        let v = gen(barg(e, 0));
        if (rt.kind == ast.TY_FLOAT) or ty.is_vec_float(rt) {
            return intr1("llvm.fabs", v);
        }
        let t = v.ty;
        let mut tys: [1]*mut ir.Ty = [t];
        if rt.kind == ast.TY_INT {
            let mut is_min = vnil();
            if O.overflow != OVF_WRAP {
                is_min = icmp(ir.IntEQ, v, int_min(t));
            }
            if O.overflow == OVF_TRAP {
                check_or_trap(b_not(is_min), T_OVERFLOW);
            }
            let mut args: [2]*mut ir.Value = [v, ci(T_i1, 0)];
            let mut r = intrinsic("llvm.abs", tys[..], args[..]);  // @abs(MIN) wraps to MIN
            if O.overflow == OVF_SATURATE {
                r = sel(is_min, int_max(t, true), r);
            }
            return r;
        }
        let mut args: [2]*mut ir.Value = [v, ci(T_i1, 0)];
        return intrinsic("llvm.abs", tys[..], args[..]);  // vectors wrap, as in WASM
    }
    if id == ast.BI_SQRT {
        return intr1("llvm.sqrt", gen(barg(e, 0)));
    }
    if id == ast.BI_FLOOR {
        return intr1("llvm.floor", gen(barg(e, 0)));
    }
    if id == ast.BI_CEIL {
        return intr1("llvm.ceil", gen(barg(e, 0)));
    }
    if id == ast.BI_TRUNC {
        return intr1("llvm.trunc", gen(barg(e, 0)));
    }
    if id == ast.BI_NEAREST {
        return intr1("llvm.roundeven", gen(barg(e, 0)));
    }
    if id == ast.BI_FMA {
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        let z = gen(barg(e, 2));
        let mut args: [3]*mut ir.Value = [x, y, z];
        if not tg.has_fma() {
            return rt_call_lanes(u.pick(x.ty.bits == 32, "fma32", "fma64"), args[..]);
        }
        return ir.intr(B, ir.IN_FMA, x.ty, args[..]);
    }
    if id == ast.BI_REM {
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        let mut args: [2]*mut ir.Value = [x, y];
        return rt_call_lanes(u.pick(x.ty.bits == 32, "fmod32", "fmod64"), args[..]);
    }
    if id == ast.BI_COPYSIGN {
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        return intr2("llvm.copysign", x, y);
    }
    if id == ast.BI_SPLAT {
        return splat(lty(rt), gen(barg(e, 0)), @int_cast(u32, rt.lanes));
    }
    if id == ast.BI_VEC {
        let mut v = ir.undef(lty(rt));
        for i in 1..e.bargs.len {
            v = ins_elem(v, gen(barg(e, i)), ci32(@as(u64, i - 1)));
        }
        return v;
    }
    if id == ast.BI_EXTRACT_LANE {
        let v = gen(barg(e, 0));
        return ext_elem(v, ci32(barg(e, 1).cval.lo));
    }
    if id == ast.BI_REPLACE_LANE {
        let v = gen(barg(e, 0));
        let x = gen(barg(e, 2));
        return ins_elem(v, x, ci32(barg(e, 1).cval.lo));
    }
    if id == ast.BI_LOAD {
        let stt = ct(barg(e, 1).ty);
        let s = gen(barg(e, 1));
        let len = extract(s, 1);
        let vb = ty.type_size(rt);
        check_or_trap(icmp(ir.IntUGE, len, usz(elems_for(vb, ty.type_size(stt.elem)))), T_LENGTH);
        asan_check(extract(s, 0), usz(vb));
        return load(rt, extract(s, 0), true);
    }
    if id == ast.BI_STORE {
        let stt = ct(barg(e, 0).ty);
        let vt = ct(barg(e, 1).ty);
        let s = gen(barg(e, 0));
        let v = gen(barg(e, 1));
        let len = extract(s, 1);
        let vb = ty.type_size(vt);
        check_or_trap(icmp(ir.IntUGE, len, usz(elems_for(vb, ty.type_size(stt.elem)))), T_LENGTH);
        asan_check(extract(s, 0), usz(vb));
        store(vt, v, extract(s, 0), true);
        return vnil();
    }
    if id == ast.BI_SHUFFLE {
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        let idx = barg(e, 2);
        let m = u.newn.[i32](idx.args.len + 1);
        for i in 0..idx.args.len {
            m[i] = @truncate(i32, idx.args.get(i).cval.lo);
        }
        return ir.shuffle(B, x, y, m[0..idx.args.len]);
    }
    if id == ast.BI_SWIZZLE {
        let x = gen(barg(e, 0));
        let idx = gen(barg(e, 1));
        if on_x64() and (idx.ty.elem.bits == x.ty.elem.bits) and x64.perm_ok(x.ty.elem.bits, x.ty.lanes, false) {
            let mut pargs: [2]*mut ir.Value = [x, idx];
            return ir.intr(B, ir.IN_PERM, x.ty, pargs[..]);
        }
        return swizzle_lanes(rt, x, idx);
    }
    if id == ast.BI_SWIZZLE2 {
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        let idx = gen(barg(e, 2));
        if on_x64() and (idx.ty.elem.bits == x.ty.elem.bits) and x64.perm_ok(x.ty.elem.bits, x.ty.lanes, true) {
            let mut pargs: [3]*mut ir.Value = [x, y, idx];
            return ir.intr(B, ir.IN_PERM2, x.ty, pargs[..]);
        }
        // indices below n pick from x (in y they wrap to beyond its lanes),
        // the others from y
        let lo = swizzle_lanes(rt, x, idx);
        let cn = const_lanes(idx.ty.elem, @int_cast(usize, rt.lanes), @as(u64, @bit_cast(u32, rt.lanes)));
        let hi = swizzle_lanes(rt, y, b_sub(idx, cn));
        return bitcast(b_or(bitcast(lo, idx.ty), bitcast(hi, idx.ty)), x.ty);
    }
    if id == ast.BI_LOAD_PARTIAL {
        // the first min(len, n) lanes copied to a zeroed vector
        let s = gen(barg(e, 1));
        let p = extract(s, 0);
        let len = extract(s, 1);
        let n = usz(@as(i64, rt.lanes));
        let k = sel(icmp(ir.IntULT, len, n), len, n);
        if on_x64() and x64.partial_ok(@int_cast(i32, rt.elem.bits), @int_cast(i32, rt.lanes)) {
            let mut pargs: [2]*mut ir.Value = [p, lane_mask(k)];
            return ir.intr(B, ir.IN_LOAD_PARTIAL, lty(rt), pargs[..]);
        }
        let tmp = alloca_in_entry(lty(rt), "partial".ptr);
        _ = ir.memop(B, ir.OP_MEMSET, tmp, ci(T_i8, 0), usz(ty.type_size(rt)));
        _ = ir.memop(B, ir.OP_MEMMOVE, tmp, p, b_mul(k, usz(ty.type_size(rt.elem))));
        return load(rt, tmp, true);
    }
    if id == ast.BI_STORE_PARTIAL {
        let vt = ct(barg(e, 1).ty);
        let s = gen(barg(e, 0));
        let v = gen(barg(e, 1));
        let p = extract(s, 0);
        let len = extract(s, 1);
        let n = usz(@as(i64, vt.lanes));
        let k = sel(icmp(ir.IntULT, len, n), len, n);
        if on_x64() and x64.partial_ok(@int_cast(i32, vt.elem.bits), @int_cast(i32, vt.lanes)) {
            let mut pargs: [3]*mut ir.Value = [v, p, lane_mask(k)];
            _ = ir.intr(B, ir.IN_STORE_PARTIAL, T_void, pargs[..]);
            return vnil();
        }
        let tmp = alloca_in_entry(lty(vt), "partial".ptr);
        store(vt, v, tmp, true);
        _ = ir.memop(B, ir.OP_MEMMOVE, p, tmp, b_mul(k, usz(ty.type_size(vt.elem))));
        return vnil();
    }
    if (id >= ast.BI_LANES_EQ) and (id <= ast.BI_LANES_GE) {
        let vt = ct(barg(e, 0).ty);
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        let ops = [lx.TK_EQEQ, lx.TK_NE, lx.TK_LT, lx.TK_LE, lx.TK_GT, lx.TK_GE];
        let c = gen_binop(ops[@int_cast(usize, id - ast.BI_LANES_EQ)], vt, x, y);
        return sext(c, lty(rt));
    }
    if id == ast.BI_SELECT {
        let m = gen(barg(e, 0));
        let x = gen(barg(e, 1));
        let y = gen(barg(e, 2));
        let mt = m.ty;
        let xm = bitcast(x, mt);
        let ym = bitcast(y, mt);
        let ynm = b_and(ym, b_not(m));  // (right to left, as in the C implementation)
        let r = b_or(b_and(xm, m), ynm);
        return bitcast(r, lty(rt));
    }
    if id == ast.BI_ANY_TRUE {
        let v = gen(barg(e, 0));
        let mut aargs: [1]*mut ir.Value = [v];
        return ir.intr(B, ir.IN_ANYTRUE, T_i1, aargs[..]);
    }
    if id == ast.BI_ALL_TRUE {
        let v = gen(barg(e, 0));
        let vt = ct(barg(e, 0).ty);
        let mut iv = v;
        if vt.elem.kind == ast.TY_FLOAT {
            iv = bitcast(v, ir.t_vec(tint(vt.elem.bits), @int_cast(u32, vt.lanes)));
        }
        let mut aargs: [1]*mut ir.Value = [iv];
        return ir.intr(B, ir.IN_ALLTRUE, T_i1, aargs[..]);
    }
    if id == ast.BI_BITMASK {
        let v = gen(barg(e, 0));
        let mut bargs: [1]*mut ir.Value = [v];
        return ir.intr(B, ir.IN_BITMASK, lty(rt), bargs[..]);  // (u64 for 64 lanes)
    }
    if id == ast.BI_REDUCE_ADD {
        return reduce_add(ct(barg(e, 0).ty), gen(barg(e, 0)));
    }
    if id == ast.BI_DOT {
        let vt = ct(barg(e, 0).ty);
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        if vt.elem.kind == ast.TY_FLOAT {
            return reduce_add(vt, ir.binop(B, ir.OP_FMUL, x, y));
        }
        let mut dargs: [2]*mut ir.Value = [x, y];
        return ir.intr(B, ir.IN_DOT_I16, lty(rt), dargs[..]);
    }
    if (id == ast.BI_WIDEN_LOW) or (id == ast.BI_WIDEN_HIGH) {
        // lane by lane: WebAssembly's extend_low/extend_high
        let vt = ct(barg(e, 0).ty);
        let v = gen(barg(e, 0));
        let n = @as(u64, @bit_cast(u32, rt.lanes));
        let mut base: u64 = 0;
        if id == ast.BI_WIDEN_HIGH {
            base = n;
        }
        let lt = lty(rt.elem);
        let mut r = ir.czero(lty(rt));
        for i in @as(u64, 0)..n {
            let x = ext_int(ext_elem(v, ci32(base + i)), lt, vt.elem.is_signed);
            r = ins_elem(r, x, ci32(i));
        }
        return r;
    }
    if id == ast.BI_NARROW {
        // lane by lane, each saturated to the result's range: WebAssembly's
        // narrow_*_sat, by the operand and result lane types
        let vt = ct(barg(e, 1).ty);
        let x = gen(barg(e, 1));
        let y = gen(barg(e, 2));
        let n = @as(u64, @bit_cast(u32, vt.lanes));
        let wt = lty(vt.elem);
        let lt = lty(rt.elem);
        let bits = @as(u64, @bit_cast(u32, rt.elem.bits));
        let mut hi: u64 = (@as(u64, 1) << bits) - 1;
        let mut lo: u64 = 0;
        if rt.elem.is_signed {
            hi = (@as(u64, 1) << (bits - 1)) - 1;
            lo = 0 -% (@as(u64, 1) << (bits - 1));
        }
        let mut r = ir.czero(lty(rt));
        for i in @as(u64, 0)..(2 * n) {
            let mut src = x;
            let mut k = i;
            if i >= n {
                src = y;
                k = i - n;
            }
            let mut l = ext_elem(src, ci32(k));
            if vt.elem.is_signed {
                l = sel(icmp(ir.IntSLT, l, ci(wt, lo)), ci(wt, lo), l);
                l = sel(icmp(ir.IntSGT, l, ci(wt, hi)), ci(wt, hi), l);
            } else {
                l = sel(icmp(ir.IntUGT, l, ci(wt, hi)), ci(wt, hi), l);
            }
            r = ins_elem(r, trunc(l, lt), ci32(i));
        }
        return r;
    }
    if id == ast.BI_TRAP {
        emit_trap(T_TRAP);
        return vnil();
    }
    if id == ast.BI_MEMORY_ERROR {
        emit_trap(T_MEMORY);
        return vnil();
    }
    if id == ast.BI_SANITIZE_ADDRESS {
        if O.sanitize_address {
            return ci(T_i1, 1);
        }
        return ci(T_i1, 0);
    }
    if (id == ast.BI_TARGET_HAS) or (id == ast.BI_TARGET_ARCH) or (id == ast.BI_TARGET_OS) or (id == ast.BI_CPU_HAS) {
        let tc = sema.target_cond(e, tg.g_features);
        if tc >= 0 {
            return ci(T_i1, @as(u64, @bit_cast(u32, tc)));
        }
        // @cpu_has of an extension the build does not assume
        let b = tg.feature_bit(barg(e, 0).str);
        if (b == 0) or ty.g_target.is_wasm {
            return ci(T_i1, 0);
        }
        return cpu_has_bits(b);
    }
    if id == ast.BI_X86_CPUID {
        let mut cargs: [2]*mut ir.Value = [gen(barg(e, 0)), gen(barg(e, 1))];
        return ir.intr(B, ir.IN_CPUID, lty(rt), cargs[..]);
    }
    if id == ast.BI_X86_XGETBV {
        let mut xargs: [1]*mut ir.Value = [gen(barg(e, 0))];
        return ir.intr(B, ir.IN_XGETBV, T_i64, xargs[..]);
    }
    if (id >= ast.BI_X86_AESENC) and (id <= ast.BI_ARM_CRC32C) {
        let n = e.bargs.len;
        let args = u.newn.[*mut ir.Value](n + 1);
        for k in 0..n {
            args[k] = gen(barg(e, k));
        }
        return ir.intr(B, ir.IN_AESENC + (id - ast.BI_X86_AESENC), lty(rt), args[0..n]);
    }
    if id == ast.BI_EXPECT {
        check_or_trap(gen(barg(e, 0)), T_EXPECT);
        return vnil();
    }
    if id == ast.BI_EXPECT_EQ {
        gen_expect_eq(e);
        return vnil();
    }
    if id == ast.BI_FENCE {
        ir.fence(B);
        return vnil();
    }
    if (id == ast.BI_PREFETCH) or (id == ast.BI_PREFETCH_WRITE) {
        // a hint (spec §5.7): the pointer is evaluated; WebAssembly has no
        // prefetch
        let p = gen(barg(e, 0));
        if not ty.g_target.is_wasm {
            let mut args: [1]*mut ir.Value = [p];
            let mut k = ir.IN_PREFETCH;
            if id == ast.BI_PREFETCH_WRITE {
                k = ir.IN_PREFETCHW;
            }
            _ = ir.intr(B, k, T_void, args[..]);
        }
        return vnil();
    }
    if (id >= ast.BI_ATOMIC_LOAD) and (id <= ast.BI_ATOMIC_NOTIFY) {
        return gen_atomic(e);
    }
    if id == ast.BI_MEMORY_DISCARD {
        // WebAssembly memory cannot give pages back: nothing to do there
        let addr = gen(barg(e, 0));
        let len = gen(barg(e, 1));
        if not ty.g_target.is_wasm {
            let mut ps: [2]*mut ir.Ty = [T_isz, T_isz];
            let fty = fn_type(T_void, ps[..], false);
            let mut args: [2]*mut ir.Value = [addr, len];
            _ = call(fty, native_rt_fn("ax_memory_discard", fty), args[..]);
        }
        return vnil();
    }
    if id == ast.BI_ERROR_NAME {
        let code = gen(barg(e, 0));
        let f = error_name_fn();
        let mut args: [1]*mut ir.Value = [code];
        return call(error_name_fty(), f, args[..]);
    }
    internal_error(u.f1("builtin @%s not implemented", e.name));
    return vnil();
}

// A function of runtime/rt.ax (loaded with every program that is built).
fn rt_fn(name: []u8) *mut FnInst {
    let P = sema.g_prog;
    for i in 0..P.fns.len {
        let d = P.fns.get(i);
        if u.str_eq(d.name, name) and u.notnil(d.module) and
           u.ends(u.file_of(d.module.file.id).display, "runtime/rt.ax") {
            return get_inst(d, ty.no_types());
        }
    }
    internal_error(u.f1("runtime function %s not found (is runtime/rt.ax missing?)", name));
    return u.nil.[FnInst]();
}

// --sanitize=address (spec §16.8): an access of `size` bytes at `addr` is
// checked against std/mem.ax's shadow memory (mem.asan_check), trapping with
// T0012 when it touches memory that is not allocated. The allocator itself
// and the runtime are not checked.
fn asan_on() bool {
    if not O.sanitize_address or u.isnil(F) or u.isnil(F.decl) or u.isnil(F.decl.module) {
        return false;
    }
    let f = u.file_of(F.decl.module.file.id).display;
    return not u.str_eq(f, "std/mem.ax") and not u.starts(f, "runtime/");
}

fn mem_fn(name: []u8) *mut FnInst {
    let P = sema.g_prog;
    for i in 0..P.fns.len {
        let d = P.fns.get(i);
        if u.str_eq(d.name, name) and u.notnil(d.module) and
           u.str_eq(u.file_of(d.module.file.id).display, "std/mem.ax") {
            return get_inst(d, ty.no_types());
        }
    }
    internal_error(u.f1("std/mem.ax has no %s (is --std right?)", name));
    return u.nil.[FnInst]();
}

fn mem_global(name: []u8) *mut ir.Value {
    let P = sema.g_prog;
    for i in 0..P.globals.len {
        let d = P.globals.get(i);
        if u.str_eq(d.name, name) and u.notnil(d.module) and
           u.str_eq(u.file_of(d.module.file.id).display, "std/mem.ax") {
            return global_addr(d);
        }
    }
    internal_error(u.f1("std/mem.ax has no %s (is --std right?)", name));
    return u.nil.[ir.Value]();
}

// The check is inline for the common cases: an access of at most 8 bytes
// within one granule of tracked (heap) memory whose shadow byte is 0, or an
// access within one 64 KiB page that the sanitizer does not track (stack,
// globals). It walks std/mem.ax's shadow tables (as_base, as_l1, then the
// page's table and its shadow bytes) and calls mem.asan_check, which
// reports, only when that fails.
fn asan_check(addr: *mut ir.Value, size: *mut ir.Value) void {
    if not asan_on() {
        return;
    }
    let a = ptrtoint(addr, T_isz);
    let l1_bb = new_bb("asan.l1".ptr);
    let l2_bb = new_bb("asan.l2".ptr);
    let sh_bb = new_bb("asan.shadow".ptr);
    let untracked = new_bb("asan.untracked".ptr);
    let slow = new_bb("asan.slow".ptr);
    let done = new_bb("asan.ok".ptr);
    let base = ld(T_isz, mem_global("as_base"));
    let rel = b_sub(ir.binop(B, ir.OP_LSHR, a, usz(16)), base);
    condbr(icmp(ir.IntULT, rel, usz(1 << 24)), l1_bb, untracked);
    // the page's table
    at_end(l1_bb);
    let entry = gep1(T_isz, mem_global("as_l1"), ir.binop(B, ir.OP_LSHR, rel, usz(12)));
    let l2 = ld(T_isz, entry);
    condbr(icmp(ir.IntNE, l2, usz(0)), l2_bb, untracked);
    // the page's shadow
    at_end(l2_bb);
    let slot = b_add(l2, b_mul(b_and(rel, usz(4095)), usz(8)));
    let sp64 = ld(T_i64, inttoptr(slot, T_ptr));
    let mut sp = sp64;
    if T_isz != T_i64 {
        sp = trunc(sp64, T_isz);
    }
    condbr(icmp(ir.IntNE, sp, usz(0)), sh_bb, untracked);
    // the granule: all 8 bytes usable, and the access within it
    at_end(sh_bb);
    let sa = b_add(sp, ir.binop(B, ir.OP_LSHR, b_and(a, usz(0xffff)), usz(3)));
    let sb = ld(T_i8, inttoptr(sa, T_ptr));
    let in_granule = b_and(icmp(ir.IntULE, size, usz(8)), icmp(ir.IntULE, b_add(b_and(a, usz(7)), size), usz(8)));
    condbr(b_and(icmp(ir.IntEQ, sb, ir.czero(T_i8)), in_granule), done, slow);
    // memory the sanitizer does not track: fine within one page
    at_end(untracked);
    let in_page = b_and(icmp(ir.IntULE, size, usz(0x10000)), icmp(ir.IntULE, b_add(b_and(a, usz(0xffff)), size),
                                                                  usz(0x10000)));
    condbr(in_page, done, slow);
    // everything else: the full check, which reports
    at_end(slow);
    let fi = mem_fn("asan_check");
    let mut args: [2]*mut ir.Value = [a, size];
    let ok = call(fi.llty, fi.fnv, args[..]);
    check_or_trap(icmp(ir.IntNE, ok, ir.czero(ok.ty)), T_MEMORY);
    br(done);
    at_end(done);
}

// Checks the memory of a slice value (all of its elements).
fn asan_check_slice(s: *mut ir.Value, elem: *mut ast.Type) void {
    if not asan_on() {
        return;
    }
    asan_check(extract(s, 0), b_mul(extract(s, 1), usz(ty.type_size(elem))));
}

// A place reached through a pointer or slice is checked where it is loaded
// or stored (the whole value; not the aggregates on the way to it).
fn asan_place(e: *mut ast.Expr, addr: *mut ir.Value) *mut ir.Value {
    if asan_on() and via_pointer(e) {
        asan_check(addr, usz(ty.type_size(ct(e.ty))));
    }
    return addr;
}

// --sanitize=address: the user's main followed by the leak check
// (mem.asan_exit), which decides the exit status. On wasm this is the
// exported main; natively the entry point calls it.
fn asan_call_main(user_main: *mut ast.Decl, args: []mut *mut ir.Value) *mut ir.Value {
    let fi = get_inst(user_main, ty.no_types());
    let fty = fi.llty;
    let r = call(fty, fi.fnv, args[0..fty.params.len]);
    let mut code = ci32(0);
    if fty.ret.kind != ir.T_VOID {
        if fty.ret.bits < 32 {
            code = zext(r, T_i32);
        } else {
            code = r;
        }
    }
    let ex = mem_fn("asan_exit");
    let mut cargs: [1]*mut ir.Value = [code];
    return call(ex.llty, ex.fnv, cargs[..]);
}

fn emit_asan_main_wasm() void {
    let mut user_main = u.nil.[ast.Decl]();
    for i in 0..sema.g_prog.fns.len {
        let d = sema.g_prog.fns.get(i);
        if d.is_export and u.str_eq(d.name, "main") {
            user_main = d;
        }
    }
    if u.isnil(user_main) {
        return;
    }
    let mut pi: [2]*mut ir.Ty = [T_i32, T_ptr];
    let fty = fn_type(T_i32, pi[..], false);
    let f = ir.add_function(M, "axiom.export.main", fty).val;
    add_str_attr(f, "wasm-export-name", "main");
    g_export_names.push(u.intern("axiom.export.main"));
    at_end(ir.append_block(f.fnp, "entry"));
    let mut args: [2]*mut ir.Value = [param(f, 0), param(f, 1)];
    ir.ret(B, asan_call_main(user_main, args[..]));
}

// Calls rt function `name` on scalar arguments, or lane by lane on vectors.
fn rt_call_lanes(name: []u8, args: []mut *mut ir.Value) *mut ir.Value {
    let fi = rt_fn(name);
    let t = args[0].ty;
    if t.kind != ir.T_VEC {
        return call(fi.llty, fi.fnv, args);
    }
    let mut r = ir.undef(t);
    for lane in 0..@int_cast(u64, t.lanes) {
        let ls = u.newn.[*mut ir.Value](args.len + 1);
        for k in 0..args.len {
            ls[k] = ir.extract_elem(B, args[k], lane);
        }
        r = ir.insert_elem(B, r, call(fi.llty, fi.fnv, ls[0..args.len]), lane);
    }
    return r;
}

// Atomics (spec §12.8): all sequentially consistent, naturally aligned.
// A misaligned atomic access traps (as WebAssembly requires); on native
// targets the check is explicit so behavior matches.
fn native_rt_fn(name: []u8, fty: *mut ir.Ty) *mut ir.Value {
    let mut f = named_fn(name);
    if u.isnil(f) {
        f = ir.add_function(M, name, fty).val;
    }
    g_needs_native_runtime = true;
    return f;
}

// @expect_eq(a, b): on failure, record both values (and how to show them) in
// axiom.trap_info before trapping. kind: 1 signed, 2 unsigned, 3 float,
// 4 bool, 5 bytes ([]u8), 6 error, 7 address.
fn store_info(slot: u64, v: *mut ir.Value) void {
    _ = st(v, trap_info_slot(slot));
}

fn gen_expect_eq(e: *mut ast.Expr) void {
    let xa = barg(e, 0);
    let xb = barg(e, 1);
    let t = ct(xa.ty);
    let a = gen(xa);
    let b = gen(xb);
    let mut eq = vnil();
    let mut kind: u64 = 0;
    let mut ia = vnil();
    let mut ib = vnil();
    let mut la = vnil();
    let mut lb = vnil();
    if t.kind == ast.TY_FLOAT {
        eq = fcmp(ir.RealOEQ, a, b);
        kind = 3;
        if t.bits == 32 {
            ia = bitcast(ir.cast(B, ir.OP_FPEXT, a, T_f64), T_i64);
            ib = bitcast(ir.cast(B, ir.OP_FPEXT, b, T_f64), T_i64);
        } else {
            ia = bitcast(a, T_i64);
            ib = bitcast(b, T_i64);
        }
    } else if t.kind == ast.TY_SLICE {
        let pa = extract(a, 0);
        let pb = extract(b, 0);
        la = extract(a, 1);
        lb = extract(b, 1);
        // equal lengths and bytes
        let res = alloca_in_entry(T_i1, "eq".ptr);
        let iv = alloca_in_entry(T_isz, "i".ptr);
        _ = st(icmp(ir.IntEQ, la, lb), res);
        _ = st(usz(0), iv);
        let cond = new_bb("eq.cond".ptr);
        let body = new_bb("eq.body".ptr);
        let neq = new_bb("eq.ne".ptr);
        let end = new_bb("eq.end".ptr);
        br(cond);
        at_end(cond);
        let i = ld(T_isz, iv);
        let lt = icmp(ir.IntULT, i, la);  // (right to left, as in the C implementation)
        let more = b_and(ld(T_i1, res), lt);
        condbr(more, body, end);
        at_end(body);
        let bx = ld(T_i8, gep1(T_i8, pa, i));
        let by = ld(T_i8, gep1(T_i8, pb, i));
        _ = st(b_add(i, usz(1)), iv);
        condbr(icmp(ir.IntEQ, bx, by), cond, neq);
        at_end(neq);
        _ = st(ci(T_i1, 0), res);
        br(end);
        at_end(end);
        eq = ld(T_i1, res);
        kind = 5;
        ia = zext(ptrtoint(pa, T_isz), T_i64);
        ib = zext(ptrtoint(pb, T_isz), T_i64);
        la = zext(la, T_i64);
        lb = zext(lb, T_i64);
    } else if (t.kind == ast.TY_PTR) or (t.kind == ast.TY_FN) {
        eq = icmp(ir.IntEQ, a, b);
        kind = 7;
        ia = zext(ptrtoint(a, T_isz), T_i64);
        ib = zext(ptrtoint(b, T_isz), T_i64);
    } else {  // integers, bool, error
        eq = icmp(ir.IntEQ, a, b);
        let sg = (t.kind == ast.TY_INT) and t.is_signed;
        if t.kind == ast.TY_BOOL {
            kind = 4;
        } else if t.kind == ast.TY_ERROR {
            kind = 6;
        } else if sg {
            kind = 1;
        } else {
            kind = 2;
        }
        if ir.int_width(a.ty) == 64 {
            ia = a;
        } else if sg {
            ia = sext(a, T_i64);
        } else {
            ia = zext(a, T_i64);
        }
        if ir.int_width(b.ty) == 64 {
            ib = b;
        } else if sg {
            ib = sext(b, T_i64);
        } else {
            ib = zext(b, T_i64);
        }
    }
    let ok = new_bb("expect.ok".ptr);
    let fail = new_bb("expect.fail".ptr);
    condbr(eq, ok, fail);
    at_end(fail);
    store_info(1, ci(T_i64, kind));
    store_info(2, ia);
    store_info(3, ib);
    if u.notnil(la) {
        store_info(4, la);
    } else {
        store_info(4, ci(T_i64, 0));
    }
    if u.notnil(lb) {
        store_info(5, lb);
    } else {
        store_info(5, ci(T_i64, 0));
    }
    call_trap_site(site_record(T_EXPECT, e.span));
    ir.unreachable(B);
    at_end(ok);
}

fn gen_atomic(e: *mut ast.Expr) *mut ir.Value {
    let id = e.index;
    let pt = ct(barg(e, 0).ty);
    let t = pt.elem;
    let p = gen(barg(e, 0));
    let size = ty.type_size(t);
    let asz = @int_cast(u32, size);
    if size > 1 {
        let addr = ptrtoint(p, T_isz);
        check_or_trap(icmp(ir.IntEQ, b_and(addr, usz(size - 1)), usz(0)), T_ATOMIC_ALIGN);
    }
    asan_check(p, usz(size));
    if id == ast.BI_ATOMIC_LOAD {
        let v = ld(lty(t), p);
        v.flags = ir.F_ATOMIC;
        set_align(v, asz);
        return v;
    }
    if id == ast.BI_ATOMIC_STORE {
        let v = gen(barg(e, 1));
        let s = st(v, p);
        s.flags = ir.F_ATOMIC;
        set_align(s, asz);
        return vnil();
    }
    if id == ast.BI_ATOMIC_CAS {
        let expv = gen(barg(e, 1));
        let newv = gen(barg(e, 2));
        let r = ir.cmpxchg(B, p, expv, newv);
        set_align(r, asz);
        return r;
    }
    if id == ast.BI_ATOMIC_WAIT {
        let expv = gen(barg(e, 1));
        let timeout = gen(barg(e, 2));
        let mut args: [3]*mut ir.Value = [p, expv, timeout];
        if ty.g_target.is_wasm {
            return intrinsic("llvm.wasm.memory.atomic.wait32", no_tys(), args[..]);
        }
        let mut ps: [3]*mut ir.Ty = [T_ptr, T_i32, T_i64];
        let fty = fn_type(T_i32, ps[..], false);
        let f = native_rt_fn("ax_wait32", fty);
        return call(fty, f, args[..]);
    }
    if id == ast.BI_ATOMIC_NOTIFY {
        let count = gen(barg(e, 1));
        let mut args: [2]*mut ir.Value = [p, count];
        if ty.g_target.is_wasm {
            return intrinsic("llvm.wasm.memory.atomic.notify", no_tys(), args[..]);
        }
        let mut ps: [2]*mut ir.Ty = [T_ptr, T_i32];
        let fty = fn_type(T_i32, ps[..], false);
        let f = native_rt_fn("ax_notify32", fty);
        return call(fty, f, args[..]);
    }
    let sg = t.is_signed;
    let mut op = ir.RMW_MAX;
    if not sg {
        op = ir.RMW_UMAX;
    }
    if id == ast.BI_ATOMIC_ADD {
        op = ir.RMW_ADD;
    } else if id == ast.BI_ATOMIC_SUB {
        op = ir.RMW_SUB;
    } else if id == ast.BI_ATOMIC_AND {
        op = ir.RMW_AND;
    } else if id == ast.BI_ATOMIC_OR {
        op = ir.RMW_OR;
    } else if id == ast.BI_ATOMIC_XOR {
        op = ir.RMW_XOR;
    } else if id == ast.BI_ATOMIC_XCHG {
        op = ir.RMW_XCHG;
    } else if id == ast.BI_ATOMIC_MIN {
        op = ir.RMW_MIN;
        if not sg {
            op = ir.RMW_UMIN;
        }
    }
    let v = gen(barg(e, 1));
    let r = ir.rmw(B, op, p, v);
    set_align(r, asz);
    return r;
}

// Entry point for threads on wasm: a new thread is a new instance sharing
// the memory; the host calls this export with the thread function, its
// argument and the top of a stack allocated for the thread. The function is
// frameless, so it touches no stack memory before switching stacks.
fn emit_thread_start() void {
    let mut ps: [3]*mut ir.Ty = [T_ptr, T_ptr, T_ptr];
    let fty = fn_type(T_void, ps[..], false);
    let f = ir.add_function(M, "axiom_thread_start", fty).val;
    add_str_attr(f, "wasm-export-name", "axiom_thread_start");
    g_export_names.push(u.intern("axiom_thread_start"));
    let bb = ir.append_block(f.fnp, "entry");
    let saved = ir.insert_block(B);
    at_end(bb);
    let mut top = param(f, 2);
    // std/thread stores the stack's lowest address at its top
    _ = st(ld(T_isz, top), stack_limit());
    if tls_globals() {
        // the thread's own copy of the thread-locals, at the top of its stack
        let size = (tls_ty.size + 15) & ~@as(u64, 15);
        let neg = ir.cint(T_isz, 0 -% size);
        let base = gep1(T_i8, top, neg);
        _ = ir.memop(B, ir.OP_MEMCPY, base, tls_init, usz(@bit_cast(i64, tls_ty.size)));
        _ = st(base, tls_ptr);
        top = base;
    }
    if program_traces() {
        // The thread's shadow stack sits at the top of its stack.
        let t = ss_type();
        let size = (t.size + 15) & ~@as(u64, 15);
        let neg = ir.cint(T_isz, 0 -% size);
        let base = gep1(T_i8, top, neg);
        _ = ir.memop(B, ir.OP_MEMSET, base, ci(T_i8, 0), usz(@bit_cast(i64, size)));
        ss_globals();
        _ = st(base, ss_global);
        top = base;
    }
    let mut tys: [1]*mut ir.Ty = [T_ptr];
    let mut targs: [1]*mut ir.Value = [top];
    _ = intrinsic("llvm.stackrestore", tys[..], targs[..]);
    let mut eps: [1]*mut ir.Ty = [T_ptr];
    let ety = fn_type(T_void, eps[..], false);
    let mut args: [1]*mut ir.Value = [param(f, 1)];
    _ = call(ety, param(f, 0), args[..]);
    ir.ret_void(B);
    if u.notnil(saved) {
        at_end(saved);
    }
}

let mut g_errtab: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);

fn error_name_table() *mut ir.Value {
    if u.notnil(g_errtab) {
        return g_errtab;
    }
    let names = sema.g_prog.error_names;
    let n = names.len;
    let vs = u.newn.[*mut ir.Value](n + 1);
    vs[0] = const_slice(string_ptr("<unknown>"), 9);
    for i in 0..n {
        let s = names.get(i);
        vs[i + 1] = const_slice(string_ptr(s), @int_cast(i64, s.len));
    }
    let stt = lty(ty.type_slice(ty.t_u8, false));
    g_errtab = ir.add_global(M, ir.t_array(stt, @as(u64, n) + 1), "axiom.error_names").val;
    set_init(g_errtab, ir.carray(stt, vs[0..n + 1]));
    set_linkage(g_errtab, ir.LINK_INTERNAL);
    g_errtab.gv.is_const = true;
    return g_errtab;
}

fn error_name_fty() *mut ir.Ty {
    let stt = lty(ty.type_slice(ty.t_u8, false));
    let mut ps: [1]*mut ir.Ty = [T_i16];
    return fn_type(stt, ps[..], false);
}

// axiom.error_name(code) []u8: the name table lives with the error codes
// (in the link unit when units are compiled separately).
fn error_name_fn() *mut ir.Value {
    let stt = lty(ty.type_slice(ty.t_u8, false));
    let fty = error_name_fty();
    let existing = named_fn("axiom.error_name");
    if u.notnil(existing) {
        return existing;
    }
    let f = ir.add_function(M, "axiom.error_name", fty).val;
    if O.unit == CG_MODULE {
        return f;
    }
    if O.unit == CG_WHOLE {
        set_linkage(f, ir.LINK_INTERNAL);
    }
    let saved = ir.insert_block(B);
    at_end(ir.append_block(f.fnp, "entry"));
    let tab = error_name_table();
    let n = sema.g_prog.error_names.len;
    let mut c = zext(param(f, 0), T_isz);
    c = sel(icmp(ir.IntULE, c, usz(@int_cast(i64, n))), c, usz(0));
    ir.ret(B, ld(stt, gep2(ir.t_array(stt, @as(u64, n) + 1), tab, usz(0), c)));
    if u.notnil(saved) {
        at_end(saved);
    }
    return f;
}

// Linear memory growth. On wasm these are the real instructions; on native
// targets the runtime (ax_memory_size, ax_memory_grow) commits 64 KiB pages of
// one large reserved region, so linear memory is contiguous there too.
fn mem_size() *mut ir.Value {
    if ty.g_target.is_wasm {
        let mut t: [1]*mut ir.Ty = [T_isz];
        let mut args: [1]*mut ir.Value = [ci32(0)];
        return intrinsic("llvm.wasm.memory.size", t[..], args[..]);
    }
    let fty = fn_type(T_isz, no_tys(), false);
    return call(fty, native_rt_fn("ax_memory_size", fty), no_vals());
}

fn mem_grow(pages: *mut ir.Value) *mut ir.Value {
    if ty.g_target.is_wasm {
        let mut t: [1]*mut ir.Ty = [T_isz];
        let mut args: [2]*mut ir.Value = [ci32(0), pages];
        return intrinsic("llvm.wasm.memory.grow", t[..], args[..]);
    }
    let mut ps: [1]*mut ir.Ty = [T_isz];
    let fty = fn_type(T_isz, ps[..], false);
    let mut args: [1]*mut ir.Value = [pages];
    return call(fty, native_rt_fn("ax_memory_grow", fty), args[..]);
}

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------
fn gen_struct_lit(e: *mut ast.Expr) *mut ir.Value {
    let t = ct(e.ty);
    let mut v = ir.undef(lty(t));
    for i in 0..e.inits.len {
        let ft = ty.type_field(t, i);
        let fv = gen(e.inits.at(i).value);
        v = insert(v, to_mem(ft, fv), @int_cast(u32, i));
    }
    return v;
}

fn gen_array_lit(e: *mut ast.Expr) *mut ir.Value {
    let t = ct(e.ty);
    if e.kind == ast.E_ARRAY_LIT {
        let mut v = ir.undef(lty(t));
        for i in 0..e.args.len {
            v = insert(v, to_mem(t.elem, gen(e.args.get(i))), @int_cast(u32, i));
        }
        return v;
    }
    let x = gen(e.a);
    if (ir.is_const(x)) and (ir.is_zero(x)) {
        return ir.czero(lty(t));
    }
    if t.len <= 16 {
        let mut v = ir.undef(lty(t));
        for i in 0..@int_cast(u32, t.len) {
            v = insert(v, to_mem(t.elem, x), i);
        }
        return v;
    }
    let tmp = temp_alloca(t);
    let iv = alloca_in_entry(T_isz, "i".ptr);
    _ = st(usz(0), iv);
    let cond = new_bb("fill.cond".ptr);
    let body = new_bb("fill.body".ptr);
    let end = new_bb("fill.end".ptr);
    br(cond);
    at_end(cond);
    let i = ld(T_isz, iv);
    condbr(icmp(ir.IntULT, i, usz(t.len)), body, end);
    at_end(body);
    store(t.elem, x, gep2(lty(t), tmp, usz(0), i), false);
    _ = st(b_add(i, usz(1)), iv);
    br(cond);
    at_end(end);
    return load(t, tmp, false);
}

fn gen_unary(e: *mut ast.Expr) *mut ir.Value {
    let t = ct(e.ty);
    let op = e.op;
    if (op == lx.KW_NOT) or (op == lx.TK_TILDE) {
        return b_not(gen(e.a));
    }
    if op == lx.TK_AMP {
        return gen_addr(e.a);
    }
    if op == lx.TK_MINUS_PCT {
        return ir.neg(B, gen(e.a));
    }
    if op == lx.TK_MINUS {
        let v = gen(e.a);
        if (t.kind == ast.TY_FLOAT) or ty.is_vec_float(t) {
            return ir.fneg(B, v);
        }
        if t.kind == ast.TY_VEC {
            return ir.neg(B, v);  // integer vectors wrap in every mode
        }
        return overflow_op(1, true, ir.czero(v.ty), v);
    }
    internal_error("bad unary");
    return vnil();
}

fn gen_binary(e: *mut ast.Expr) *mut ir.Value {
    if (e.op == lx.KW_AND) or (e.op == lx.KW_OR) {
        let is_and = e.op == lx.KW_AND;
        let l = gen(e.a);
        if l.kind == ir.V_CINT {
            // a constant left operand (a target condition): the builder
            // would fold the branch, and the right operand runs or not
            if (l.cv != 0) == is_and {
                return gen(e.b);
            }
            return l;
        }
        let lbb = ir.insert_block(B);
        let rhs = new_bb(u.pick(is_and, "and.rhs", "or.rhs").ptr);
        let end = new_bb(u.pick(is_and, "and.end", "or.end").ptr);
        if is_and {
            condbr(l, rhs, end);
        } else {
            condbr(l, end, rhs);
        }
        at_end(rhs);
        let r = gen(e.b);
        let rbb = ir.insert_block(B);
        br(end);
        at_end(end);
        let phi = ir.phi(B, T_i1);
        let mut sc: u64 = 1;
        if is_and {
            sc = 0;
        }
        let mut vals: [2]*mut ir.Value = [ci(T_i1, sc), r];
        let mut bbs: [2]*mut ir.Block = [lbb, rbb];
        ir.add_incoming(phi, vals[0], bbs[0]);
        ir.add_incoming(phi, vals[1], bbs[1]);
        return phi;
    }
    let lt = ct(e.a.ty);
    let l = gen(e.a);
    let r = gen(e.b);
    return gen_binop(e.op, lt, l, r);
}

fn gen_slice(e: *mut ast.Expr) *mut ir.Value {
    let at = ct(e.a.ty);
    let rt = ct(e.ty);
    let mut ptr = vnil();
    let mut len = vnil();
    if e.op == ast.IDX_SLICE {
        let s = gen(e.a);
        ptr = extract(s, 0);
        len = extract(s, 1);
    } else {
        let mut arr = at;
        if e.op == ast.IDX_PTR_ARRAY {
            arr = at.elem;
            ptr = gen(e.a);
        } else {
            ptr = gen_addr(e.a);
        }
        len = array_len_value(arr);
    }
    let mut lo = usz(0);
    if u.notnil(e.b) {
        lo = gen(e.b);
    }
    let mut hi = len;
    if u.notnil(e.c) {
        hi = gen(e.c);
    }
    let hl = icmp(ir.IntULE, hi, len);  // (right to left, as in the C implementation)
    let ok = b_and(icmp(ir.IntULE, lo, hi), hl);
    check_or_trap(ok, T_BOUNDS);
    let np = gep1(lty(rt.elem), ptr, lo);
    let s = insert(ir.undef(lty(rt)), np, 0);
    return insert(s, b_sub(hi, lo), 1);
}

fn gen_inner(e: *mut ast.Expr) *mut ir.Value {
    let t = ct(e.ty);
    if u.notnil(t) and (t.kind == ast.TY_NEVER) {
        // The expression diverges; generate it and hand back a placeholder.
        if e.kind == ast.E_BUILTIN {
            _ = gen_builtin(e);
        }
        let mut want = tnil();
        if u.notnil(e.tval) {
            want = ct(e.tval);
        }
        if u.notnil(want) and (want.kind != ast.TY_VOID) and (want.kind != ast.TY_NEVER) {
            return ir.undef(vty(want));
        }
        return vnil();
    }
    if e.is_const and u.notnil(t) {
        if t.kind == ast.TY_INT {
            return cint(lty(t), e.cval);
        }
        if t.kind == ast.TY_FLOAT {
            return ir.cfp(lty(t), e.fval);
        }
        if t.kind == ast.TY_BOOL {
            let mut bv: u64 = 0;
            if e.bval {
                bv = 1;
            }
            return ci(T_i1, bv);
        }
    }
    let k = e.kind;
    if k == ast.E_IDENT {
        if u.notnil(e.local) {
            return load(t, local_ptr(e.local), false);
        }
        if u.notnil(e.tval) and (e.tval.kind == ast.TY_PARAM) and e.tval.is_const {
            let c = ct(e.tval);
            return cint(lty(t), u.I128.of(c.cval));
        }
        if u.notnil(e.decl) {
            let dk = e.decl.kind;
            if dk == ast.D_GLOBAL {
                return load(t, global_addr(e.decl), false);
            }
            if (dk == ast.D_FN) or (dk == ast.D_HOST_FN) {
                return get_inst(e.decl, subst_gargs(e.gargs)).fnv;
            }
            if dk == ast.D_CONST {
                if (O.unit == CG_MODULE) and type_mentions_error(t) {
                    return gen(e.decl.cexpr);
                }
                return gen_const(e.decl.cexpr, t);
            }
        }
    } else if k == ast.E_STRING {
        return const_slice(string_ptr(e.str), @int_cast(i64, e.str.len));
    } else if k == ast.E_BOOL {
        let mut bv: u64 = 0;
        if e.bval {
            bv = 1;
        }
        return ci(T_i1, bv);
    } else if k == ast.E_INT {
        return cint(lty(t), u.I128.ofu(e.ival));
    } else if k == ast.E_FLOAT {
        return ir.cfp(lty(t), e.fval);
    } else if k == ast.E_STRUCT_LIT {
        return gen_struct_lit(e);
    } else if (k == ast.E_ARRAY_LIT) or (k == ast.E_ARRAY_REPEAT) {
        return gen_array_lit(e);
    } else if k == ast.E_ERROR_VAL {
        return errcode_value(@truncate(u32, e.cval.lo));
    } else if k == ast.E_BUILTIN {
        return gen_builtin(e);
    } else if k == ast.E_UNARY {
        return gen_unary(e);
    } else if k == ast.E_BINARY {
        return gen_binary(e);
    } else if k == ast.E_CATCH {
        return gen_catch(e);
    } else if k == ast.E_TRY {
        return gen_try(e);
    } else if k == ast.E_CALL {
        return gen_call(e);
    } else if k == ast.E_FIELD {
        let fk = e.op;
        if fk == ast.FK_STRUCT {
            if sema.is_place(e) {
                return load(t, asan_place(e, gen_addr(e)), via_pointer(e));
            }
            if e.self_mode == ast.SELF_DEREF {
                return load(t, asan_place(e, gen_addr(e)), true);
            }
            return from_mem(t, extract(gen(e.a), @int_cast(u32, e.index)));
        }
        if fk == ast.FK_SLICE_LEN {
            return extract(gen(e.a), 1);
        }
        if fk == ast.FK_SLICE_PTR {
            return extract(gen(e.a), 0);
        }
        if fk == ast.FK_ARRAY_LEN {
            return usz(ct(e.a.ty).len);
        }
        if fk == ast.FK_VARIANT_UNIT {
            let tmp = temp_alloca(t);
            _ = st(ci(lty(ty.union_tag_type(t)), @int_cast(u64, e.index)), sgep(lty(t), tmp, 0));
            return load(t, tmp, false);
        }
        if fk == ast.FK_CONST {
            return gen_const(e.decl.cexpr, t);
        }
        if fk == ast.FK_DECL {
            if e.decl.kind == ast.D_GLOBAL {
                return load(t, global_addr(e.decl), false);
            }
            return get_inst(e.decl, subst_gargs(e.gargs)).fnv;
        }
    } else if k == ast.E_DEREF {
        return load(t, asan_place(e, gen_addr(e)), true);
    } else if k == ast.E_INDEX {
        return load(t, asan_place(e, gen_addr(e)), via_pointer(e) or (e.op != ast.IDX_ARRAY));
    } else if k == ast.E_SLICE {
        return gen_slice(e);
    } else if k == ast.E_APPLY {
        return get_inst(e.decl, subst_gargs(e.gargs)).fnv;
    } else if k == ast.E_CONV {
        if e.op == ast.CONV_NOOP {
            return gen(e.a);
        }
        if e.op == ast.CONV_WRAP_OK {
            let mut v = vnil();
            if t.elem.kind != ast.TY_VOID {
                v = gen(e.a);
            }
            return errunion_value(t, ci(T_i16, 0), v);
        }
        if e.op == ast.CONV_WRAP_ERR {
            return errunion_value(t, gen(e.a), vnil());
        }
    }
    internal_error(u.f1("cannot generate expression kind %s", u.idec(e.kind)));
    return vnil();
}

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------
fn gen_block(b: *mut ast.Stmt) void {
    let height = F.defers.len;
    for i in 0..b.stmts.len {
        if terminated() {
            break;
        }
        gen_stmt(b.stmts.get(i));
    }
    if not terminated() {
        emit_defers(height);
    }
    F.defers.len = height;
}

fn gen_if(s: *mut ast.Stmt) void {
    // A target condition (spec §13.4): only the branch it selects is compiled.
    let tc = sema.target_cond(s.e, tg.g_features);
    if tc == 1 {
        gen_block(s.body);
        return;
    }
    if tc == 0 {
        if u.notnil(s.els) {
            if s.els.kind == ast.S_IF {
                gen_if(s.els);
            } else {
                gen_block(s.els);
            }
        }
        return;
    }
    let c = gen(s.e);
    let then_bb = new_bb("if.then".ptr);
    let end = new_bb("if.end".ptr);
    let mut else_bb = end;
    if u.notnil(s.els) {
        else_bb = new_bb("if.else".ptr);
    }
    condbr(c, then_bb, else_bb);
    at_end(then_bb);
    gen_block(s.body);
    if not terminated() {
        br(end);
    }
    if u.notnil(s.els) {
        at_end(else_bb);
        if s.els.kind == ast.S_IF {
            gen_if(s.els);
        } else {
            gen_block(s.els);
        }
        if not terminated() {
            br(end);
        }
    }
    at_end(end);
}

fn push_loop(brk: *mut ir.Block, cont: *mut ir.Block) void {
    F.loops.push(LoopCtx.{ brk: brk, cont: cont, defer_height: F.defers.len });
}

fn gen_for(s: *mut ast.Stmt) void {
    let vt = ct(s.local.ty);
    let var = local_ptr(s.local);
    let cond = new_bb("for.cond".ptr);
    let body = new_bb("for.body".ptr);
    let step = new_bb("for.step".ptr);
    let end = new_bb("for.end".ptr);
    if u.notnil(s.e2) {
        let lo = gen(s.e);
        let hi = gen(s.e2);
        let iv = alloca_in_entry(lty(vt), "for.i".ptr);
        _ = st(lo, iv);
        br(cond);
        at_end(cond);
        let i = ld(lty(vt), iv);
        let mut p = ir.IntULT;
        if vt.is_signed {
            p = ir.IntSLT;
        }
        condbr(icmp(p, i, hi), body, end);
        at_end(body);
        _ = st(i, var);
        push_loop(end, step);
        gen_block(s.body);
        F.loops.len -= 1;
        if not terminated() {
            br(step);
        }
        at_end(step);
        let i2 = ld(lty(vt), iv);
        _ = st(b_add(i2, ci(lty(vt), 1)), iv);
        br(cond);
        at_end(end);
        return;
    }
    let ctt = ct(s.e.ty);
    let mut ptr = vnil();
    let mut len = vnil();
    if ctt.kind == ast.TY_SLICE {
        let sv = gen(s.e);
        ptr = extract(sv, 0);
        len = extract(sv, 1);
    } else {
        ptr = addr_or_spill(s.e);
        len = usz(ctt.len);
    }
    let iv = alloca_in_entry(T_isz, "for.idx".ptr);
    _ = st(usz(0), iv);
    br(cond);
    at_end(cond);
    let i = ld(T_isz, iv);
    condbr(icmp(ir.IntULT, i, len), body, end);
    at_end(body);
    let ep = gep1(lty(vt), ptr, i);
    if ctt.kind == ast.TY_SLICE {
        asan_check(ep, usz(ty.type_size(vt)));
    }
    store(vt, load(vt, ep, ctt.kind == ast.TY_SLICE), var, false);
    push_loop(end, step);
    gen_block(s.body);
    F.loops.len -= 1;
    if not terminated() {
        br(step);
    }
    at_end(step);
    let i2 = ld(T_isz, iv);
    _ = st(b_add(i2, usz(1)), iv);
    br(cond);
    at_end(end);
}

fn gen_match(s: *mut ast.Stmt) void {
    let t = ct(s.e.ty);
    let end = new_bb("match.end".ptr);
    let n = s.arms.len;
    let bbs = u.newn.[*mut ir.Block](n + 1);
    let mut else_idx: i64 = -1;
    for i in 0..n {
        bbs[i] = new_bb("match.arm".ptr);
        if (s.arms.at(i).kind == ast.P_ELSE) and (else_idx < 0) {
            else_idx = @int_cast(i64, i);
        }
    }
    let mut payload_ptr = vnil();
    if t.kind == ast.TY_UNION {
        let up = addr_or_spill(s.e);
        let tag = ld(lty(ty.union_tag_type(t)), sgep(lty(t), up, 0));
        if ir.field_count(lty(t)) > 1 {
            payload_ptr = sgep(lty(t), up, 1);
        }
        let nv = t.decl.variants.len;
        let sw = ir.switch_(B, tag, trap_block(T_UNIONTAG));
        let covered = u.newn.[bool](nv + 1);
        for i in 0..n {
            let a = s.arms.at(i);
            if (a.kind == ast.P_VARIANT) and not covered[@int_cast(usize, a.variant)] {
                covered[@int_cast(usize, a.variant)] = true;
                ir.add_case(sw, ci(lty(ty.union_tag_type(t)), @int_cast(u64, a.variant)), bbs[i]);
            }
        }
        if else_idx >= 0 {
            for v in 0..nv {
                if not covered[v] {
                    ir.add_case(sw, ci(lty(ty.union_tag_type(t)), @as(u64, v)), bbs[@int_cast(usize, else_idx)]);
                }
            }
        }
    } else if (O.unit == CG_MODULE) and (n > 0) and (ct(s.e.ty).kind == ast.TY_ERROR) {
        // Error codes are link-time values here: compare in arm order.
        let v = gen(s.e);
        for i in 0..n {
            let a = s.arms.at(i);
            if a.kind != ast.P_ERROR {
                continue;
            }
            let next = new_bb("match.next".ptr);
            condbr(icmp(ir.IntEQ, v, errcode_value(a.error_code)), bbs[i], next);
            at_end(next);
        }
        if else_idx >= 0 {
            br(bbs[@int_cast(usize, else_idx)]);
        } else {
            br(trap_block(T_TRAP));
        }
    } else {
        // integers, bool, error, enum (an enum match without 'else' covers every member)
        let v = gen(s.e);
        let mut dflt = bbnil();
        if else_idx >= 0 {
            dflt = bbs[@int_cast(usize, else_idx)];
        } else if s.e.ty.kind == ast.TY_ENUM {
            dflt = trap_block(T_UNIONTAG);
        } else {
            dflt = trap_block(T_TRAP);
        }
        let sw = ir.switch_(B, v, dflt);
        let vt_ = v.ty;
        let mut seen = u.List.[u.I128].{ data: u.nil.[u.I128](), len: 0, cap: 0 };
        for i in 0..n {
            let a = s.arms.at(i);
            let mut key = u.I128.zero();
            if a.kind == ast.P_INT {
                key = a.ival;
            } else if a.kind == ast.P_BOOL {
                if a.bval {
                    key = u.I128.of(1);
                }
            } else if a.kind == ast.P_ERROR {
                key = u.I128.ofu(@as(u64, a.error_code));
            } else if a.kind == ast.P_VARIANT {
                key = a.ival;
            } else {
                continue;
            }
            let mut dup = false;
            for kk in 0..seen.len {
                if seen.get(kk).eq(key) {
                    dup = true;
                }
            }
            if dup {
                continue;
            }
            seen.push(key);
            ir.add_case(sw, cint(vt_, key), bbs[i]);
        }
        u.free(@ptr_cast(*mut void, seen.data));
    }
    for i in 0..n {
        let a = s.arms.at(i);
        at_end(bbs[i]);
        if u.notnil(a.bind_local) and u.notnil(payload_ptr) {
            let pt = ty.type_variant(t, @int_cast(usize, a.variant));
            store(pt, load(pt, payload_ptr, true), local_ptr(a.bind_local), false);
        }
        gen_block(a.body);
        if not terminated() {
            br(end);
        }
    }
    at_end(end);
}

fn gen_stmt_inner(s: *mut ast.Stmt) void {
    let k = s.kind;
    if (k == ast.S_LET) and s.undef {
        // left unspecified (§8.1): a small variable, which the optimizer could keep in
        // registers, is zeroed (as good a value as any, and free); a larger one's bytes are
        // left as they are in its slot, which is never promoted
        let t = ct(s.local.ty);
        let lt = lty(t);
        if lt.size <= UNDEF_ZEROED {
            store(t, ir.czero(lt), local_ptr(s.local), false);
        } else {
            _ = local_ptr(s.local);
        }
    } else if k == ast.S_LET {
        let v = gen(s.e);
        if terminated() or u.isnil(v) {
            return;
        }
        store(ct(s.local.ty), v, local_ptr(s.local), false);
    } else if (k == ast.S_EXPR) or (k == ast.S_DISCARD) {
        _ = gen(s.e);
    } else if k == ast.S_ASSIGN {
        let t = ct(s.e.ty);
        let addr = gen_addr(s.e);
        let un = via_pointer(s.e);
        if s.op == lx.TK_EQ {
            let v = gen(s.e2);
            if u.isnil(v) {
                return;
            }
            store(t, v, asan_place(s.e, addr), un);
            return;
        }
        _ = asan_place(s.e, addr);
        let old = load(t, addr, un);
        let r = gen(s.e2);
        let nv = gen_binop(s.e3.op, t, old, r);
        store(t, nv, addr, un);
    } else if k == ast.S_IF {
        gen_if(s);
    } else if k == ast.S_WHILE {
        let cond = new_bb("while.cond".ptr);
        let body = new_bb("while.body".ptr);
        let end = new_bb("while.end".ptr);
        br(cond);
        at_end(cond);
        let c = gen(s.e);
        condbr(c, body, end);
        at_end(body);
        push_loop(end, cond);
        gen_block(s.body);
        F.loops.len -= 1;
        if not terminated() {
            br(cond);
        }
        at_end(end);
    } else if k == ast.S_LOOP {
        let body = new_bb("loop.body".ptr);
        let end = new_bb("loop.end".ptr);
        br(body);
        at_end(body);
        push_loop(end, body);
        gen_block(s.body);
        F.loops.len -= 1;
        if not terminated() {
            br(body);
        }
        at_end(end);
    } else if k == ast.S_FOR {
        gen_for(s);
    } else if k == ast.S_MATCH {
        gen_match(s);
    } else if k == ast.S_RETURN {
        gen_return(s.e);
    } else if k == ast.S_BREAK {
        gen_break(true);
    } else if k == ast.S_CONTINUE {
        gen_break(false);
    } else if k == ast.S_DEFER {
        F.defers.push(s.body);
    } else if k == ast.S_BLOCK {
        gen_block(s);
    }
}

// Wrappers that track the source span of the code being generated, for
// trap sites.
fn gen(e: *mut ast.Expr) *mut ir.Value {
    let saved = g_cur_span;
    set_span(e.span);
    let v = gen_inner(e);
    set_span(saved);
    return v;
}

fn gen_addr(e: *mut ast.Expr) *mut ir.Value {
    let saved = g_cur_span;
    set_span(e.span);
    let v = gen_addr_inner(e);
    set_span(saved);
    return v;
}

fn gen_stmt(s: *mut ast.Stmt) void {
    let saved = g_cur_span;
    set_span(s.span);
    gen_stmt_inner(s);
    set_span(saved);
}

// ---------------------------------------------------------------------------
// Function bodies
// ---------------------------------------------------------------------------
fn gen_fn_body(fi: *mut FnInst) void {
    let saved_feats = tg.g_features;
    tg.g_features = fi.feats;  // (@target_has, and lowering that depends on extensions)
    if fi.dispatch {
        let saved_f = F;
        let stt = u.new.[FnState]();
        stt.inst = fi;
        stt.decl = fi.decl;
        stt.fnv = fi.fnv;
        stt.no_trace = true;
        F = stt;
        gen_dispatch(fi);
        F = saved_f;
    } else {
        gen_fn_body_of(fi);
    }
    tg.g_features = saved_feats;
}

fn gen_fn_body_of(fi: *mut FnInst) void {
    let d = fi.decl;
    let stt = u.new.[FnState]();
    stt.inst = fi;
    stt.decl = d;
    stt.from = d.all_gparams;
    stt.to = fi.gargs;
    stt.fnv = fi.fnv;
    // the function's line: its name in the declaration (also the line of the
    // code before its body's first statement)
    set_span(d.name_span);
    fi.fnv.fnp.src = ir.cur_src;
    stt.no_trace = is_runtime_module(d.module);
    stt.locals = u.newn.[*mut ir.Value](d.locals.len + 1);
    let saved = F;
    F = stt;
    stt.ret = fi.fnty.ret;
    stt.entry = ir.append_block(fi.fnv.fnp, "entry");
    let start = ir.append_block(fi.fnv.fnp, "start");
    at_end(start);
    let mut k: u32 = 0;
    if fi.sret {
        stt.sret_ptr = param(fi.fnv, k);
        k += 1;
    }
    for i in 0..d.params.len {
        let l = d.params.at(i).local;
        let pt = fi.fnty.params[i];
        let p = param(fi.fnv, k);
        k += 1;
        if by_ptr(pt) {
            stt.locals[@int_cast(usize, l.index)] = p;  // params are immutable: use the caller's copy directly
        } else {
            store(pt, p, local_ptr(l), false);
        }
    }
    gen_block(d.body);
    if not terminated() {
        if stt.ret.kind == ast.TY_VOID {
            ir.ret_void(B);
        } else if (stt.ret.kind == ast.TY_ERRUNION) and (stt.ret.elem.kind == ast.TY_VOID) {
            emit_ret(errunion_value(stt.ret, ci(T_i16, 0), vnil()));
        } else {
            ir.unreachable(B);
        }
    }
    at_end(stt.entry);
    if ty.g_target.is_wasm {
        check_stack(d, stt.entry, start);
    } else {
        br(start);
    }
    // Delete blocks with no predecessors (continuations after return/break/trap).
    ir.remove_unreachable(stt.fnv.fnp);
    u.free(@ptr_cast(*mut void, stt.defers.data));
    u.free(@ptr_cast(*mut void, stt.loops.data));
    F = saved;
}

// ---------------------------------------------------------------------------
// Driver
// ---------------------------------------------------------------------------
// A small exported function whose body the caller builds.
fn add_export(name: []u8, ret: *mut ir.Ty, ps: []mut *mut ir.Ty) *mut ir.Value {
    let fty = fn_type(ret, ps, false);
    let f = ir.add_function(M, name, fty).val;
    if ty.g_target.is_wasm {
        add_str_attr(f, "wasm-export-name", name);
    }
    g_export_names.push(u.intern(name));
    at_end(ir.append_block(f.fnp, "entry"));
    return f;
}

// axiom_shadow_stack(): the calling thread's shadow stack record (see
// ss_ptr), or null when built with --stack-traces=off.
fn emit_shadow_stack_export() void {
    _ = add_export("axiom_shadow_stack", T_ptr, no_tys());
    if program_traces() {
        ir.ret(B, ss_ptr());
    } else {
        ir.ret(B, ir.czero(T_ptr));
    }
}

// axiom_frame_table(): the frame table's bounds {start, end}: the
// linked program's axiom_rets sections (the linkers place them together
// and define these symbols, as the system's linker does), or null when calls
// record themselves on the shadow stack (see frame_tables).
fn emit_frame_table_export() void {
    let mut g = ir.czero(T_ptr);
    if frame_tables() {
        let start = ir.add_global(M, T_i8, "__start_axiom_rets").val;
        let stop = ir.add_global(M, T_i8, "__stop_axiom_rets").val;
        set_linkage(start, ir.LINK_EXTWEAK);
        set_linkage(stop, ir.LINK_EXTWEAK);
        g = ir.add_global(M, ir.t_array(T_ptr, 2), "axiom.rets").val;
        let mut el: [2]*mut ir.Value = [start, stop];
        set_init(g, ir.carray(T_ptr, el[..]));
        set_linkage(g, ir.LINK_INTERNAL);
        g.gv.is_const = true;
        set_align(g, 8);
    }
    _ = add_export("axiom_frame_table", T_ptr, no_tys());
    ir.ret(B, g);
    // axiom_frame_address(): its own frame record, whose first word is the
    // caller's frame address (for the runtime's walks from its own frames)
    let f = add_export("axiom_frame_address", T_ptr, no_tys());
    f.fnp.noinline = true;
    let mut none: [1]*mut ir.Value = [vnil()];
    ir.ret(B, ir.intr(B, ir.IN_FRAME_ADDR, T_ptr, none[0..0]));
}

// axiom_trap_info(): address of {site, kind, a, b, alen, blen} (64-bit
// fields); `site` points at {code, file_id, start, end, line, col, file, text}.
fn emit_trap_info_export() void {
    _ = add_export("axiom_trap_info", T_ptr, no_tys());
    ir.ret(B, trap_info_global());
}

// Test binaries (spec §17): tests are listed and run through exports.
//   axiom_test_count() u32
//   axiom_test_name(i) *u8        NUL-terminated
//   axiom_test_expect(i) i32      -1 must not trap, -2 any trap, n: trap Tn
//   axiom_test_run(i) u32         0, or the error code the test returned
//   axiom_error_name(code) *u8    NUL-terminated
//   axiom_test_leaks() u32        after a test passed: the allocations it
//                                 never freed, reported on stderr
//                                 (--sanitize=address; otherwise 0)
fn emit_test_exports() void {
    let tests = sema.g_prog.tests;
    let n = tests.len;
    _ = add_export("axiom_test_count", T_i32, no_tys());
    ir.ret(B, ci32(@as(u64, n)));

    let names = u.newn.[*mut ir.Value](n + 1);
    let expects = u.newn.[*mut ir.Value](n + 1);
    for i in 0..n {
        let d = tests.get(i);
        names[i] = string_ptr(cstr_prefix(d.test_name));
        expects[i] = ir.cint(T_i32, @bit_cast(u64, @as(i64, d.test_trap)));
    }
    let ntab = ir.add_global(M, ir.t_array(T_ptr, @as(u64, n) + 1), "axiom.test_names").val;
    names[n] = ir.czero(T_ptr);
    set_init(ntab, ir.carray(T_ptr, names[0..n + 1]));
    set_linkage(ntab, ir.LINK_INTERNAL);
    let etab = ir.add_global(M, ir.t_array(T_i32, @as(u64, n) + 1), "axiom.test_expect").val;
    expects[n] = ci32(0);
    set_init(etab, ir.carray(T_i32, expects[0..n + 1]));
    set_linkage(etab, ir.LINK_INTERNAL);

    let mut pi: [1]*mut ir.Ty = [T_i32];
    let mut f = add_export("axiom_test_name", T_ptr, pi[..]);
    ir.ret(B, ld(T_ptr, gep2(ir.t_array(T_ptr, @as(u64, n) + 1), ntab, ci32(0), param(f, 0))));
    f = add_export("axiom_test_expect", T_i32, pi[..]);
    ir.ret(B, ld(T_i32, gep2(ir.t_array(T_i32, @as(u64, n) + 1), etab, ci32(0), param(f, 0))));

    // axiom_test_run: a switch over the test functions.
    let run = add_export("axiom_test_run", T_i32, pi[..]);
    let dflt = ir.append_block(run.fnp, "none");
    let sw = ir.switch_(B, param(run, 0), dflt);
    for i in 0..n {
        let fi = get_inst(tests.get(i), ty.no_types());
        let bb = ir.append_block(run.fnp, "test");
        ir.add_case(sw, ci32(@as(u64, i)), bb);
        at_end(bb);
        let r = call(fi.llty, fi.fnv, no_vals());
        ir.ret(B, zext(extract(r, 0), T_i32));
    }
    at_end(dflt);
    ir.ret(B, ci32(0xFFFF));

    let en = add_export("axiom_error_name", T_ptr, pi[..]);
    let tab = error_name_table();
    let ne = sema.g_prog.error_names.len;
    let mut code = zext(param(en, 0), T_isz);
    code = sel(icmp(ir.IntULE, code, usz(@int_cast(i64, ne))), code, usz(0));
    let stt = lty(ty.type_slice(ty.t_u8, false));
    let sl = ld(stt, gep2(ir.t_array(stt, @as(u64, ne) + 1), tab, usz(0), code));
    ir.ret(B, extract(sl, 0));

    _ = add_export("axiom_test_leaks", T_i32, no_tys());
    if O.sanitize_address {
        let lk = mem_fn("asan_test_leaks");
        ir.ret(B, call(lk.llty, lk.fnv, no_vals()));
    } else {
        ir.ret(B, ci32(0));
    }
}

fn call_runtime(name: []u8) void {
    let fty = fn_type(T_void, no_tys(), false);
    _ = call(fty, ir.add_function(M, name, fty).val, no_vals());
}

// Native programs: axiom_target_arch() for the runtime (runtime/native.ax)
// and the C entry point, which initializes the runtime (and the profiler)
// before running the program's main, or the tests.
fn emit_native_entry() void {
    _ = add_export("axiom_target_arch", T_i32, no_tys());
    let mut arch: u64 = 1;
    if tg.g_arch == tg.ARCH_A64 {
        arch = 2;
    }
    ir.ret(B, ci32(arch));

    let mut user_main = u.nil.[ast.Decl]();
    for i in 0..sema.g_prog.fns.len {
        let d = sema.g_prog.fns.get(i);
        if d.is_export and u.str_eq(d.name, "main") {
            user_main = d;
        }
    }
    if u.isnil(user_main) and not g_test_mode {
        return;  // a library, or C code has the entry point
    }
    let mut pi: [2]*mut ir.Ty = [T_i32, T_ptr];
    let f = add_export("main", T_i32, pi[..]);
    // Built for more than the architecture's baseline: check the processor
    // first (std/os/cpu.ax; it and this entry are compiled for the baseline).
    f.fnp.features = 0;
    f.fnp.has_features = true;
    let aty = fn_type(T_void, pi[..], false);
    let mut aargs: [2]*mut ir.Value = [param(f, 0), param(f, 1)];
    // On macOS the check comes after ax_rt_args, which makes the thread-local
    // block: before it, std/os/cpu's shadow stack would be written through
    // TSD slot 0, into the thread's own structure. (Every Mac has apple-m1's
    // extensions, what the runtime is built for.)
    if tg.is_darwin() {
        _ = call(aty, ir.add_function(M, "ax_rt_args", aty).val, aargs[..]);
    }
    if tg.g_features != 0 {
        let req = cpu_fn("require");
        let mut rargs: [2]*mut ir.Value = [
            ci(T_i64, tg.g_features), const_slice(string_ptr(tg.g_cpu), @int_cast(i64, tg.g_cpu.len))];
        _ = call(req.llty, req.fnv, rargs[..]);
    }
    if not tg.is_darwin() {
        _ = call(aty, ir.add_function(M, "ax_rt_args", aty).val, aargs[..]);
    }
    call_runtime("ax_rt_init");
    if O.profile {
        call_runtime("ax_profile_start");
    }
    if g_test_mode {
        let tty = fn_type(T_i32, pi[..], false);
        let mut args: [2]*mut ir.Value = [param(f, 0), param(f, 1)];
        ir.ret(B, call(tty, ir.add_function(M, "ax_test_main", tty).val, args[..]));
        return;
    }
    if O.sanitize_address {
        let mut sargs: [2]*mut ir.Value = [param(f, 0), param(f, 1)];
        let code = asan_call_main(user_main, sargs[..]);
        call_runtime("ax_rt_fini");
        ir.ret(B, code);
        return;
    }
    let fi = get_inst(user_main, ty.no_types());
    let fty = fi.llty;
    let mut args: [2]*mut ir.Value = [param(f, 0), param(f, 1)];
    let r = call(fty, fi.fnv, args[0..fty.params.len]);
    call_runtime("ax_rt_fini");
    if fty.ret.kind == ir.T_VOID {
        ir.ret(B, ci32(0));
    } else if fty.ret.bits < 32 {
        ir.ret(B, zext(r, T_i32));
    } else {
        ir.ret(B, r);
    }
}

pub fn default_triple() []u8 {
    return tg.host_triple();
}

// Generates code for the checked program. False on failure (errors reported
// through diag or printed to stderr).
pub fn codegen_program(o: *mut CgOptions) bool {
    O = o;
    g_build_features = tg.g_features;
    let P = sema.g_prog;
    ir.init_types(@int_cast(u64, ty.g_target.ptr_bits / 8));
    M = ir.new_module(u.file_of(P.root.file.id).display);
    M.frame_tables = frame_tables();
    B = ir.new_builder();
    T_i1 = ir.t_int(1);
    T_i8 = ir.t_int(8);
    T_i16 = ir.t_int(16);
    T_i32 = ir.t_int(32);
    T_i64 = ir.t_int(64);
    T_isz = tint(ty.g_target.ptr_bits);
    T_ptr = ir.t_ptr();
    T_void = ir.t_void();
    T_f32 = ir.t_float(32);
    T_f64 = ir.t_float(64);
    T_v128 = ir.t_vec(T_i32, 4);

    let program_parts = O.unit != CG_MODULE;
    if program_parts and ty.g_target.is_wasm and g_threads {
        emit_thread_start();
    }

    if O.unit == CG_WHOLE {
        // Roots: exported functions. Everything else (functions, generic
        // instances, globals) is generated on first reference, so
        // unreachable code costs nothing in the backend.
        for i in 0..P.fns.len {
            let d = P.fns.get(i);
            if d.is_export {
                _ = get_inst(d, ty.no_types());
            }
        }
    } else if O.unit == CG_MODULE {
        // Every non-generic function of the module (other units may call
        // any of them, directly or from a generic instance).
        for i in 0..P.fns.len {
            let d = P.fns.get(i);
            if (d.module == O.module) and (d.gparams.len == 0) and
               not (u.notnil(d.owner) and (d.owner.gparams.len != 0)) {
                _ = get_inst(d, ty.no_types());
            }
        }
        if g_test_mode {
            for i in 0..P.tests.len {
                if P.tests.get(i).module == O.module {
                    _ = get_inst(P.tests.get(i), ty.no_types());
                }
            }
        }
    } else {
        // The link unit: globals, error codes and names.
        for i in 0..P.globals.len {
            let d = P.globals.get(i);
            if d.is_tls and ty.g_target.is_wasm {
                _ = tls_globals();  // (the block, not one global each)
            } else {
                _ = global_ref(d);
            }
        }
        for i in 0..P.error_names.len {
            let g = ir.add_global(M, T_i16, u.f1("axiom.errcode.%s", P.error_names.get(i))).val;
            set_init(g, ci(T_i16, @as(u64, i) + 1));
            g.gv.is_const = true;
        }
        _ = error_name_fn();
        if program_traces() {
            ss_globals();
        }
        if ty.g_target.is_wasm {
            _ = stack_limit();
        }
        _ = trap_info_global();
    }
    if program_parts {
        if g_test_mode {
            emit_test_exports();
        }
        if ty.g_target.is_wasm {
            emit_trap_info_export();
            if ty.g_target.ptr_bits == 64 {
                // tells hosts that pointers in memory are 64-bit
                _ = add_export("axiom_wasm64", T_i32, no_tys());
                ir.ret(B, ci32(1));
            }
        }
        emit_shadow_stack_export();
        if not ty.g_target.is_wasm {
            emit_frame_table_export();
            emit_native_entry();
        } else if O.sanitize_address and not g_test_mode {
            emit_asan_main_wasm();
        }
    }
    while u.notnil(pending_head) {
        let fi = pending_head;
        pending_head = fi.next;
        if u.isnil(pending_head) {
            pending_tail = u.nil.[FnInst]();
        }
        gen_fn_body(fi);
    }
    if dg.error_count() != 0 {
        return false;
    }

    return be.emit_module(M, O.opt_level, O.emit, O.out_path);
}
