// =============================================================================
// util.ax - the system (host ABI), arena allocation, growable lists, interned
// strings, hash maps, 128-bit integers, formatting, sorting and source files.
//
// Everything the compiler allocates lives in one arena and is never freed.
// Pointers that C would make NULL are 0 here: use nil() and isnil().
// =============================================================================

import "std/fmt" as sfmt;
import "std/mem" as smem;
import "std/os/process" as sproc;

// The system, through the host interface std uses (spec §15): the same
// source runs natively and on WebAssembly.
import host "axiom" {
    fn ax_write(fd: i32, p: *u8, n: usize) isize;
    fn ax_read(fd: i32, p: *mut u8, n: usize) isize;
    fn ax_open(path: *u8, len: usize, flags: u32) i32;
    fn ax_close(fd: i32) void;
    fn ax_seek(fd: i32, off: i64, whence: u32) i64;
    fn ax_stat(path: *u8, len: usize, follow: u32, out: *mut i64) i32;
    fn ax_mkdir(path: *u8, len: usize, mode: u32) i32;
    fn ax_remove(path: *u8, len: usize, dir: u32) i32;
    fn ax_rename(from: *u8, flen: usize, to: *u8, tlen: usize) i32;
    fn ax_readdir(path: *u8, len: usize, buf: *mut u8, cap: usize) isize;
    fn ax_getcwd(buf: *mut u8, cap: usize) isize;
    fn ax_chmod(path: *u8, len: usize, mode: u32) i32;
    fn ax_readlink(path: *u8, len: usize, buf: *mut u8, cap: usize) isize;
    fn ax_getenv(name: *u8, len: usize, buf: *mut u8, cap: usize) isize;
    fn ax_argc() i32;
    fn ax_arg(i: i32, buf: *mut u8, cap: usize) isize;
    fn ax_getpid() i32;
    fn ax_exit(code: i32) void;
    fn ax_fork() i32;
    fn ax_proc_wait(h: i32, block: u32, status: *mut i32) i32;
    fn ax_clock_ns(clock: u32) i64;
    fn ax_cpu_count() u32;
    fn ax_os() i32;
}

// -----------------------------------------------------------------------------
// Memory, with the C library's interface over std/mem (which wants sizes
// back): each block starts with a 16-byte header that holds its size.
// -----------------------------------------------------------------------------
fn out_of_memory() void {
    eprint("axiom: out of memory\n");
    ax_exit(70);
}

pub fn malloc(n: usize) *mut void {
    let b = smem.alloc_bytes(n + 16);
    if b == 0 {
        out_of_memory();
    }
    @ptr_from_int(*mut usize, b).* = n;
    return @ptr_from_int(*mut void, b + 16);
}

pub fn calloc(n: usize, size: usize) *mut void {
    let t = n * size;
    let p = malloc(t);
    @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, p), t), 0);
    return p;
}

pub fn realloc(p: *mut void, n: usize) *mut void {
    if isvnil(p) {
        return malloc(n);
    }
    let b = @int_from_ptr(p) - 16;
    let old = @ptr_from_int(*mut usize, b).*;
    let nb = smem.realloc_bytes(b, old + 16, n + 16);
    if nb == 0 {
        out_of_memory();
    }
    @ptr_from_int(*mut usize, nb).* = n;
    return @ptr_from_int(*mut void, nb + 16);
}

pub fn free(p: *mut void) void {
    if isvnil(p) {
        return;
    }
    let b = @int_from_ptr(p) - 16;
    smem.free_bytes(b, @ptr_from_int(*mut usize, b).* + 16);
}

pub fn strlen(s: *u8) usize {
    let mut n: usize = 0;
    while @ptr_from_int(*u8, @int_from_ptr(s) + n).* != 0 {
        n += 1;
    }
    return n;
}

// -----------------------------------------------------------------------------
// System calls, C style (paths are NUL-terminated; negative results fail)
// -----------------------------------------------------------------------------
pub fn write(fd: i32, p: *u8, n: usize) isize {
    return ax_write(fd, p, n);
}

pub fn read(fd: i32, p: *mut u8, n: usize) isize {
    return ax_read(fd, p, n);
}

// flags: 0 read, 1 write (create or truncate)
pub fn open(path: *u8, flags: u32) i32 {
    return ax_open(path, strlen(path), flags);
}

pub fn close(fd: i32) i32 {
    ax_close(fd);
    return 0;
}

pub fn unlink(path: *u8) i32 {
    return ax_remove(path, strlen(path), 0);
}

pub fn rename(from: *u8, to: *u8) i32 {
    return ax_rename(from, strlen(from), to, strlen(to));
}

pub fn chmod(path: *u8, mode: u32) i32 {
    return ax_chmod(path, strlen(path), mode);
}

pub fn getpid() i32 {
    return ax_getpid();
}

pub fn exit(code: i32) void {
    ax_exit(code);
}

// Ends a process made with fork().
pub fn _exit(code: i32) void {
    ax_exit(code);
}

// A copy of this process (spec §15): 0 in the copy, its handle in this
// process, or negative where the host cannot (WebAssembly).
pub fn fork() i32 {
    return ax_fork();
}

// Waits for a child made with fork() or spawned; its exit status (128 +
// the signal if a signal ended it), or -1.
pub fn wait_child(h: i32) i32 {
    let mut st: i32 = 0;
    let r = ax_proc_wait(h, 1, &mut st);
    if r == 1 {
        return st;
    }
    if r == 2 {
        return 128 + st;
    }
    return -1;
}

pub fn cpu_count() usize {
    return @as(usize, ax_cpu_count());
}

// Nanoseconds on a monotonic clock.
pub fn now_ns() i64 {
    return ax_clock_ns(1);
}

// The compiler's own file: argument 0 if it names one (as the WebAssembly
// host passes the module's path), else /proc/self/exe (Linux), else
// argument 0 found in PATH (macOS); nil if none.
pub fn self_path() []u8 {
    let args = program_args();
    if (args.len > 0) and is_file(args[0]) {
        return real_path(args[0]);
    }
    let r = readlink("/proc/self/exe");
    if not isnos(r) {
        return r;
    }
    if (args.len > 0) and (find(args[0], '/') < 0) {
        let path = env("PATH");
        if not isnos(path) {
            let mut p: usize = 0;
            while p <= path.len {
                let mut e = p;
                while (e < path.len) and (path[e] != ':') {
                    e += 1;
                }
                let cand = cat3(path[p..e], "/", args[0]);
                if (e > p) and is_executable(cand) {
                    return real_path(cand);
                }
                p = e + 1;
            }
        }
    }
    return nosym();
}

pub fn no_strs() [][]u8 {
    return @slice_from_ptr(@ptr_from_int(*[]u8, 8), 0);
}

// The program's arguments.
pub fn program_args() []mut []u8 {
    let n = @int_cast(usize, ax_argc());
    let args = newn.[[]u8](n);
    for i in 0..n {
        let len = ax_arg(@int_cast(i32, i), nil.[u8](), 0);
        let buf = alloc(@int_cast(usize, @max(len, 0)) + 1);
        if len > 0 {
            _ = ax_arg(@int_cast(i32, i), buf, @int_cast(usize, len));
        }
        args[i] = @slice_from_ptr(buf, @int_cast(usize, @max(len, 0)));
    }
    return args;
}

// -----------------------------------------------------------------------------
// Pointers
// -----------------------------------------------------------------------------
pub fn nil[T]() *mut T {
    return @ptr_from_int(*mut T, 0);
}

pub fn isnil[T](p: *T) bool {
    return @int_from_ptr(p) == 0;
}

pub fn notnil[T](p: *T) bool {
    return @int_from_ptr(p) != 0;
}

pub fn vnil() *mut void {
    return @ptr_from_int(*mut void, 0);
}

pub fn isvnil(p: *void) bool {
    return @int_from_ptr(p) == 0;
}

pub fn die(msg: []u8) void {
    eprint("axiom: ");
    eprint(msg);
    eprint("\n");
    quit(2);
}

// -----------------------------------------------------------------------------
// Arenas: memory zeroed and 16-byte aligned. Allocations live for the whole
// run, except inside a scratch scope (scratch_begin .. scratch_end), where
// they come from a second arena that the end of the scope takes back: the
// backends compile each function in one, since their per-function data
// (machine code, live ranges, ...) is dead once its bytes are out. What must
// outlive a scope (interned strings, shared constants, types) comes from
// perm_alloc. With AXIOM_POISON set, released memory is filled with 0xA5
// and never reused, so anything still pointing into it shows.
// -----------------------------------------------------------------------------
struct Arena {
    cur: usize,
    end: usize,
    chunks: *mut usize,  // (base, size, used) per chunk
    nchunks: usize,
    cap: usize,
    at: usize,  // the chunk in use
}

let mut main_arena: Arena = Arena.{ cur: 0, end: 0, chunks: @ptr_from_int(*mut usize, 0), nchunks: 0, cap: 0, at: 0 };
let mut scratch_arena: Arena = Arena.{ cur: 0, end: 0, chunks: @ptr_from_int(*mut usize, 0), nchunks: 0, cap: 0,
                                       at: 0 };
let mut scratch_depth: i32 = 0;
let mut poison: i32 = -1;  // unknown, no, yes

const CHUNK: usize = 1048576;

fn chunk_slice(a: *mut Arena) []mut usize {
    return @slice_from_ptr(a.chunks, a.cap * 3);
}

// Moves to the next chunk with room for `size` (keeping the old ones of
// the scratch arena to reuse), or a new one.
fn next_chunk(a: *mut Arena, size: usize, keep: bool) void {
    if keep and (a.nchunks != 0) {
        let cs = chunk_slice(a);
        cs[(a.at * 3) + 2] = a.cur - cs[a.at * 3];
        let mut k = a.at + 1;
        while k < a.nchunks {
            if cs[(k * 3) + 1] >= size {
                a.at = k;
                a.cur = cs[k * 3];
                a.end = a.cur + cs[(k * 3) + 1];
                return;
            }
            k += 1;
        }
    }
    let mut bs = CHUNK;
    if size > bs {
        bs = size;
    }
    let p = calloc(1, bs);
    if isvnil(p) {
        die("out of memory");
    }
    if a.nchunks == a.cap {
        let mut nc: usize = 64;
        if a.cap != 0 {
            nc = a.cap * 2;
        }
        let q = realloc(@ptr_cast(*mut void, a.chunks), nc * 3 * @size_of(usize));
        if isvnil(q) {
            die("out of memory");
        }
        a.chunks = @ptr_cast(*mut usize, q);
        a.cap = nc;
    }
    let cs = chunk_slice(a);
    // (a new chunk goes last; the scratch arena's are reused in order)
    if keep and (a.nchunks != 0) {
        cs[(a.at * 3) + 2] = a.cur - cs[a.at * 3];
    }
    cs[a.nchunks * 3] = @int_from_ptr(p);
    cs[(a.nchunks * 3) + 1] = bs;
    cs[(a.nchunks * 3) + 2] = 0;
    a.at = a.nchunks;
    a.nchunks += 1;
    a.cur = @int_from_ptr(p);
    a.end = a.cur + bs;
}

fn arena_alloc(a: *mut Arena, size0: usize, keep: bool) *mut u8 {
    let size = (size0 + 15) & ~15;
    if (a.end - a.cur) < size {
        next_chunk(a, size, keep);
    }
    let r = a.cur;
    a.cur += size;
    return @ptr_from_int(*mut u8, r);
}

pub fn alloc(size0: usize) *mut u8 {
    if scratch_depth > 0 {
        return arena_alloc(&mut scratch_arena, size0, true);
    }
    return arena_alloc(&mut main_arena, size0, false);
}

// Memory that outlives any scratch scope.
pub fn perm_alloc(size0: usize) *mut u8 {
    return arena_alloc(&mut main_arena, size0, false);
}

pub fn perm_new[T]() *mut T {
    return @ptr_cast(*mut T, perm_alloc(@size_of(T)));
}

pub fn perm_newn[T](n: usize) []mut T {
    let p = perm_alloc(n * @size_of(T) + 1);
    return @slice_from_ptr(@ptr_cast(*mut T, p), n);
}

// Debugging (AXIOM_POISON): memory given back is filled with 0xA5 and
// never reused.
pub fn poisoning() bool {
    if poison < 0 {
        poison = 0;
        if not isnos(env("AXIOM_POISON")) {
            poison = 1;
        }
    }
    return poison == 1;
}

pub fn scratch_begin() void {
    scratch_depth += 1;
}

// Ends a scratch scope; the outermost one releases everything allocated
// in it.
pub fn scratch_end() void {
    scratch_depth -= 1;
    if scratch_depth > 0 {
        return;
    }
    let a = &mut scratch_arena;
    if a.nchunks == 0 {
        return;
    }
    let cs = chunk_slice(a);
    cs[(a.at * 3) + 2] = a.cur - cs[a.at * 3];
    if poisoning() {
        // never reused: a stale pointer reads 0xA5s
        for k in 0..a.nchunks {
            let used = cs[(k * 3) + 2];
            if used != 0 {
                @mem_set(@slice_from_ptr(@ptr_from_int(*mut u8, cs[k * 3]), used), 0xA5);
            }
        }
        a.nchunks = 0;
        a.cur = 0;
        a.end = 0;
        a.at = 0;
        return;
    }
    // zero what was used and start again at the first chunk; chunks bigger
    // than the standard size go back to the system
    let mut kept: usize = 0;
    for k in 0..a.nchunks {
        let base = cs[k * 3];
        let size = cs[(k * 3) + 1];
        let used = cs[(k * 3) + 2];
        if size > CHUNK {
            free(@ptr_from_int(*mut void, base));
            continue;
        }
        if used != 0 {
            @mem_set(@slice_from_ptr(@ptr_from_int(*mut u8, base), used), 0);
        }
        cs[kept * 3] = base;
        cs[(kept * 3) + 1] = size;
        cs[(kept * 3) + 2] = 0;
        kept += 1;
    }
    a.nchunks = kept;
    a.at = 0;
    if kept == 0 {
        a.cur = 0;
        a.end = 0;
    } else {
        a.cur = cs[0];
        a.end = cs[0] + cs[1];
    }
}

pub fn new[T]() *mut T {
    return @ptr_cast(*mut T, alloc(@size_of(T)));
}

pub fn newn[T](n: usize) []mut T {
    let p = alloc(n * @size_of(T) + 1);
    return @slice_from_ptr(@ptr_cast(*mut T, p), n);
}

// -----------------------------------------------------------------------------
// Heap slices (malloc'd, freed with free_slice) for tables that grow and
// shrink, unlike the arena's.
// -----------------------------------------------------------------------------
pub fn nil_slice[T]() []mut T {
    return @slice_from_ptr(nil.[T](), 0);
}

pub fn calloc_slice[T](n: usize) []mut T {
    let p = calloc(@max(n, 1), @size_of(T));
    if isvnil(p) {
        die("out of memory");
    }
    return @slice_from_ptr(@ptr_cast(*mut T, p), n);
}

pub fn free_slice[T](s: []mut T) void {
    if s.len != 0 {
        free(@ptr_cast(*mut void, s.ptr));
    }
}

// A permanent copy of `s` (see perm_alloc), followed by a NUL.
pub fn perm_dup(s: []u8) []u8 {
    let p = perm_alloc(s.len + 1);
    let d = @slice_from_ptr(p, s.len);
    @mem_copy(d, s);
    return d;
}

// A copy of `s` in the arena, followed by a NUL (so `.ptr` is a C string).
pub fn dup(s: []u8) []u8 {
    let p = alloc(s.len + 1);
    let d = @slice_from_ptr(p, s.len);
    @mem_copy(d, s);
    return d;
}

pub fn nosym() []u8 {
    return @slice_from_ptr(@ptr_from_int(*u8, 0), 0);
}

pub fn isnos(s: []u8) bool {
    return @int_from_ptr(s.ptr) == 0;
}

// A C string for `s`: a NUL-terminated arena copy.
pub fn cz(s: []u8) *u8 {
    return dup(s).ptr;
}

pub fn from_c(p: *u8) []u8 {
    return @slice_from_ptr(p, strlen(p));
}

// -----------------------------------------------------------------------------
// Growable lists (heap-backed; a zeroed List is empty and valid).
// -----------------------------------------------------------------------------
pub struct List[T] {
    data: *mut T,
    len: usize,
    cap: usize,

    pub fn push(self: *mut Self, x: T) void {
        if self.len == self.cap {
            let mut ncap: usize = 8;
            if self.cap != 0 {
                ncap = self.cap * 2;
            }
            let p = realloc(@ptr_cast(*mut void, self.data), ncap * @size_of(T));
            if isvnil(p) {
                die("out of memory");
            }
            self.data = @ptr_cast(*mut T, p);
            self.cap = ncap;
        }
        let s = @slice_from_ptr(self.data, self.len + 1);
        s[self.len] = x;
        self.len += 1;
    }

    pub fn items(self: *Self) []mut T {
        return @slice_from_ptr(self.data, self.len);
    }

    pub fn at(self: *Self, i: usize) *mut T {
        let s = @slice_from_ptr(self.data, self.len);
        return &mut s[i];
    }

    pub fn get(self: *Self, i: usize) T {
        let s = @slice_from_ptr(self.data, self.len);
        return s[i];
    }

    pub fn set(self: *Self, i: usize, x: T) void {
        let s = @slice_from_ptr(self.data, self.len);
        s[i] = x;
    }

    pub fn last(self: *Self) T {
        return self.get(self.len - 1);
    }

    pub fn pop(self: *mut Self) T {
        self.len -= 1;
        let s = @slice_from_ptr(self.data, self.len + 1);
        return s[self.len];
    }

    pub fn clear(self: *mut Self) void {
        self.len = 0;
    }
}

// -----------------------------------------------------------------------------
// String building
// -----------------------------------------------------------------------------
pub struct Buf {
    b: List.[u8],

    pub fn init() Buf {
        return Buf.{ b: List.[u8].{ data: nil.[u8](), len: 0, cap: 0 } };
    }

    pub fn s(self: *mut Buf, x: []u8) void {
        for c in x {
            self.b.push(c);
        }
    }

    pub fn c(self: *mut Buf, x: u8) void {
        self.b.push(x);
    }

    pub fn len(self: *Buf) usize {
        return self.b.len;
    }

    pub fn view(self: *Buf) []u8 {
        return self.b.items();
    }

    // An arena copy (NUL-terminated); the buffer is released.
    pub fn done(self: *mut Buf) []u8 {
        let r = dup(self.b.items());
        free(@ptr_cast(*mut void, self.b.data));
        self.b.data = nil.[u8]();
        self.b.len = 0;
        self.b.cap = 0;
        return r;
    }
}

pub fn cat2(a: []u8, b: []u8) []u8 {
    let p = alloc(a.len + b.len + 1);
    let d = @slice_from_ptr(p, a.len + b.len);
    @mem_copy(d[0..a.len], a);
    @mem_copy(d[a.len..], b);
    return d;
}

pub fn cat3(a: []u8, b: []u8, c: []u8) []u8 {
    return cat2(cat2(a, b), c);
}

pub fn cat4(a: []u8, b: []u8, c: []u8, d: []u8) []u8 {
    return cat2(cat2(a, b), cat2(c, d));
}

// Formatting: every `%s` takes the next argument, `%%` is a percent sign.
pub fn fmtv(f: []u8, args: [][]u8) []u8 {
    let mut b = Buf.init();
    let mut k: usize = 0;
    let mut i: usize = 0;
    while i < f.len {
        let ch = f[i];
        if (ch == '%') and ((i + 1) < f.len) {
            let n = f[i + 1];
            if n == 's' {
                b.s(args[k]);
                k += 1;
                i += 2;
                continue;
            }
            if n == '%' {
                b.c('%');
                i += 2;
                continue;
            }
        }
        b.c(ch);
        i += 1;
    }
    return b.done();
}

pub fn f1(f: []u8, a: []u8) []u8 {
    let v = [a];
    return fmtv(f, v[..]);
}

pub fn f2(f: []u8, a: []u8, b: []u8) []u8 {
    let v = [a, b];
    return fmtv(f, v[..]);
}

pub fn f3(f: []u8, a: []u8, b: []u8, c: []u8) []u8 {
    let v = [a, b, c];
    return fmtv(f, v[..]);
}

pub fn f4(f: []u8, a: []u8, b: []u8, c: []u8, d: []u8) []u8 {
    let v = [a, b, c, d];
    return fmtv(f, v[..]);
}

pub fn f5(f: []u8, a: []u8, b: []u8, c: []u8, d: []u8, e: []u8) []u8 {
    let v = [a, b, c, d, e];
    return fmtv(f, v[..]);
}

pub fn f6(f: []u8, a: []u8, b: []u8, c: []u8, d: []u8, e: []u8, g: []u8) []u8 {
    let v = [a, b, c, d, e, g];
    return fmtv(f, v[..]);
}

pub fn udec(v0: u64) []u8 {
    let mut buf: [24]u8 = [0; 24];
    let mut n: usize = 24;
    let mut v = v0;
    loop {
        n -= 1;
        buf[n] = '0' + @truncate(u8, v % 10);
        v = v / 10;
        if v == 0 {
            break;
        }
    }
    return dup(buf[n..]);
}

pub fn dec(v: i64) []u8 {
    if v < 0 {
        return cat2("-", udec(0 -% @bit_cast(u64, v)));
    }
    return udec(@bit_cast(u64, v));
}

pub fn idec(v: i32) []u8 {
    return dec(@as(i64, v));
}

pub fn zdec(v: usize) []u8 {
    return udec(@as(u64, v));
}

pub fn hex16(v: u64) []u8 {
    let digits = "0123456789abcdef";
    let mut buf: [16]u8 = [0; 16];
    for i in @as(usize, 0)..16 {
        buf[15 - i] = digits[@truncate(usize, (v >> @truncate(u32, i * 4)) & 15)];
    }
    return dup(buf[..]);
}

// Formats one float with a printf conversion: "%.1f", "%7.1f" (fixed, with
// a width and a precision) or "%g".
pub fn ffmt(f: []u8, v: f64) []u8 {
    if str_eq(f, "%g") {
        return gfmt(v);
    }
    // %[width][.precision]f
    let mut i: usize = 1;
    let mut width: usize = 0;
    while (i < f.len) and (f[i] >= '0') and (f[i] <= '9') {
        width = (width * 10) + @as(usize, f[i] - '0');
        i += 1;
    }
    let mut prec: usize = 6;
    if (i < f.len) and (f[i] == '.') {
        prec = 0;
        i += 1;
        while (i < f.len) and (f[i] >= '0') and (f[i] <= '9') {
            prec = (prec * 10) + @as(usize, f[i] - '0');
            i += 1;
        }
    }
    let s = fixed(v, prec);
    if s.len >= width {
        return s;
    }
    let mut b = Buf.init();
    for _k in s.len..width {
        b.c(' ');
    }
    b.s(s);
    return b.done();
}

// v with prec digits after the point, correctly rounded (ties to even).
fn fixed(v: f64, prec: usize) []u8 {
    let mut buf: [400]u8 = [0; 400];
    let spec = cat3("{:.", zdec(prec), "f}");
    let r = sfmt.bufprint(buf[..], spec, [sfmt.float(v)]) catch return "?";
    return dup(r);
}

// C's %g: 6 significant digits, in fixed or exponent notation (exponent of
// at least two digits), without trailing zeros.
fn gfmt(v: f64) []u8 {
    if v != v {
        return "nan";
    }
    if (v > 1.7976931348623157e308) or (v < -1.7976931348623157e308) {
        return pick(v > 0.0, "inf", "-inf");
    }
    if v == 0.0 {
        return pick(@bit_cast(u64, v) == 0, "0", "-0");
    }
    // the exponent after rounding to 6 digits
    let mut buf: [400]u8 = [0; 400];
    let es = sfmt.bufprint(buf[..], "{:.5e}", [sfmt.float(v)]) catch return "?";
    let e = find(es, 'e');
    let mut x: i64 = 0;
    let mut k = @int_cast(usize, e) + 1;
    let mut neg = false;
    if (es[k] == '+') or (es[k] == '-') {
        neg = es[k] == '-';
        k += 1;
    }
    while k < es.len {
        x = (x * 10) + @as(i64, es[k] - '0');
        k += 1;
    }
    if neg {
        x = -x;
    }
    if (x < -4) or (x >= 6) {
        let m = strip_zeros(es[0..@int_cast(usize, e)]);
        let mut b = Buf.init();
        b.s(m);
        b.s(pick(x < 0, "e-", "e+"));
        let ax = @abs(x);
        if ax < 10 {
            b.c('0');
        }
        b.s(dec(ax));
        return b.done();
    }
    return strip_zeros(fixed(v, @int_cast(usize, 5 - x)));
}

fn strip_zeros(s: []u8) []u8 {
    if find(s, '.') < 0 {
        return dup(s);
    }
    let mut n = s.len;
    while s[n - 1] == '0' {
        n -= 1;
    }
    if s[n - 1] == '.' {
        n -= 1;
    }
    return dup(s[0..n]);
}

pub fn pick(c: bool, a: []u8, b: []u8) []u8 {
    if c {
        return a;
    }
    return b;
}

pub fn str_eq(a: []u8, b: []u8) bool {
    return @mem_eq(a, b);
}

// strcmp on the bytes (as unsigned), treating the slice end as NUL.
pub fn str_cmp(a: []u8, b: []u8) i32 {
    let mut i: usize = 0;
    loop {
        let mut ca: u8 = 0;
        let mut cb: u8 = 0;
        if i < a.len {
            ca = a[i];
        }
        if i < b.len {
            cb = b[i];
        }
        if ca != cb {
            return @as(i32, ca) - @as(i32, cb);
        }
        if ca == 0 {
            return 0;
        }
        i += 1;
    }
}

pub fn starts(s: []u8, p: []u8) bool {
    return (s.len >= p.len) and @mem_eq(s[0..p.len], p);
}

pub fn ends(s: []u8, p: []u8) bool {
    return (s.len >= p.len) and @mem_eq(s[s.len - p.len..], p);
}

// Index of the last `c` in `s`, or -1.
pub fn rfind(s: []u8, c: u8) i64 {
    let mut i = s.len;
    while i > 0 {
        i -= 1;
        if s[i] == c {
            return @int_cast(i64, i);
        }
    }
    return -1;
}

pub fn find(s: []u8, c: u8) i64 {
    for i in 0..s.len {
        if s[i] == c {
            return @int_cast(i64, i);
        }
    }
    return -1;
}

pub fn is_digit(c: u8) bool {
    return (c >= '0') and (c <= '9');
}

pub fn is_alnum(c: u8) bool {
    return ((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z')) or is_digit(c);
}

// atoi / atol: optional sign, decimal digits; stops at the first non-digit.
pub fn atol(s: []u8) i64 {
    let mut i: usize = 0;
    let mut neg = false;
    if (i < s.len) and ((s[i] == '-') or (s[i] == '+')) {
        neg = s[i] == '-';
        i += 1;
    }
    let mut v: i64 = 0;
    while (i < s.len) and is_digit(s[i]) {
        v = (v *% 10) +% @as(i64, s[i] - '0');
        i += 1;
    }
    if neg {
        return 0 -% v;
    }
    return v;
}

// C's strtoll / strtoull with base 0 (0x hex, leading-0 octal, decimal).
pub struct CInt {
    value: u64,  // magnitude, clamped to u64 max
    neg: bool,
    end: usize,  // bytes consumed (0: no conversion)
    big: bool,   // magnitude exceeded u64
}

fn digit_val(c: u8) u32 {
    if is_digit(c) {
        return @as(u32, c - '0');
    }
    if (c >= 'a') and (c <= 'f') {
        return @as(u32, c - 'a') + 10;
    }
    if (c >= 'A') and (c <= 'F') {
        return @as(u32, c - 'A') + 10;
    }
    return 99;
}

pub fn c_parse_int(s: []u8) CInt {
    let mut r = CInt.{ value: 0, neg: false, end: 0, big: false };
    let mut i: usize = 0;
    while (i < s.len) and ((s[i] == ' ') or (s[i] == '\t') or (s[i] == '\n')) {
        i += 1;
    }
    if (i < s.len) and ((s[i] == '-') or (s[i] == '+')) {
        r.neg = s[i] == '-';
        i += 1;
    }
    let mut base: u32 = 10;
    if (i < s.len) and (s[i] == '0') {
        if ((i + 2) < s.len) and ((s[i + 1] == 'x') or (s[i + 1] == 'X')) and (digit_val(s[i + 2]) < 16) {
            base = 16;
            i += 2;
        } else {
            base = 8;
        }
    }
    let start = i;
    while (i < s.len) and (digit_val(s[i]) < base) {
        let d = @as(u64, digit_val(s[i]));
        if r.value > ((0xFFFF_FFFF_FFFF_FFFF - d) / @as(u64, base)) {
            r.big = true;
        } else {
            r.value = (r.value * @as(u64, base)) + d;
        }
        i += 1;
    }
    if r.big {
        r.value = 0xFFFF_FFFF_FFFF_FFFF;
    }
    if i == start {
        r.end = 0;
        r.value = 0;
        r.neg = false;
    } else {
        r.end = i;
    }
    return r;
}

// strtoll(s, &end, 0): the value (clamped); `ovf` reports ERANGE.
pub fn c_strtoll(s: []u8) CStrtoll {
    let p = c_parse_int(s);
    let mut r = CStrtoll.{ v: 0, end: p.end, ovf: false };
    if p.neg {
        if p.big or (p.value > 0x8000_0000_0000_0000) {
            r.v = -9223372036854775807 - 1;
            r.ovf = true;
        } else {
            r.v = 0 -% @bit_cast(i64, p.value);
        }
    } else {
        if p.big or (p.value > 0x7FFF_FFFF_FFFF_FFFF) {
            r.v = 9223372036854775807;
            r.ovf = true;
        } else {
            r.v = @bit_cast(i64, p.value);
        }
    }
    return r;
}

pub struct CStrtoll {
    v: i64,
    end: usize,
    ovf: bool,
}

// strtoull(s, &end, 0) as a signed 64-bit pattern.
pub fn c_strtoull(s: []u8) CStrtoll {
    let p = c_parse_int(s);
    let mut r = CStrtoll.{ v: 0, end: p.end, ovf: p.big };
    let mut u = p.value;
    if p.neg and not p.big {
        u = 0 -% u;
    }
    r.v = @bit_cast(i64, u);
    return r;
}

// A decimal float literal's value, correctly rounded (0 if malformed).
pub fn parse_f64(s: []u8) f64 {
    return sfmt.parse_float(s) catch 0.0;
}

// -----------------------------------------------------------------------------
// Interned strings: equal contents => the same pointer. A Sym is a []u8 whose
// bytes are followed by a NUL; the absent Sym (C's NULL) has a 0 pointer.
// -----------------------------------------------------------------------------
struct InternEntry {
    s: []u8,
    hash: u64,
}

let mut itab: *mut InternEntry = @ptr_from_int(*mut InternEntry, 0);
let mut itab_cap: usize = 0;
let mut itab_len: usize = 0;

pub fn hash_fnv(s: []u8) u64 {
    let mut h: u64 = 1469598103934665603;
    for c in s {
        h = (h ^ @as(u64, c)) *% 1099511628211;
    }
    return h;
}

pub fn intern(s: []u8) []u8 {
    if (itab_len * 2) >= itab_cap {
        let mut ncap: usize = 4096;
        if itab_cap != 0 {
            ncap = itab_cap * 2;
        }
        let nt = @slice_from_ptr(@ptr_cast(*mut InternEntry, calloc(ncap, @size_of(InternEntry))), ncap);
        let old = @slice_from_ptr(itab, itab_cap);
        for i in 0..itab_cap {
            if isnos(old[i].s) {
                continue;
            }
            let mut j = @truncate(usize, old[i].hash) & (ncap - 1);
            while not isnos(nt[j].s) {
                j = (j + 1) & (ncap - 1);
            }
            nt[j] = old[i];
        }
        free(@ptr_cast(*mut void, itab));
        itab = nt.ptr;
        itab_cap = ncap;
    }
    let t = @slice_from_ptr(itab, itab_cap);
    let h = hash_fnv(s);
    let mut j = @truncate(usize, h) & (itab_cap - 1);
    while not isnos(t[j].s) {
        if (t[j].hash == h) and @mem_eq(t[j].s, s) {
            return t[j].s;
        }
        j = (j + 1) & (itab_cap - 1);
    }
    t[j] = InternEntry.{ s: perm_dup(s), hash: h };
    itab_len += 1;
    return t[j].s;
}

// Interned strings compare by pointer.
pub fn same(a: []u8, b: []u8) bool {
    return a.ptr == b.ptr;
}

// -----------------------------------------------------------------------------
// SymMap: interned-string -> V hash map. A missing key reads as a zeroed V.
// -----------------------------------------------------------------------------
fn ptr_hash(p: usize) usize {
    let mut x = @as(u64, p);
    x = x ^ (x >> 33);
    x = x *% 0xff51afd7ed558ccd;
    x = x ^ (x >> 33);
    return @truncate(usize, x);
}

pub struct SymMap[V] {
    keys: *mut usize,
    vals: *mut V,
    cap: usize,
    len: usize,

    fn grow(self: *mut Self) void {
        let mut ncap: usize = 16;
        if self.cap != 0 {
            ncap = self.cap * 2;
        }
        let nk = @slice_from_ptr(@ptr_cast(*mut usize, calloc(ncap, @size_of(usize))), ncap);
        let nv = @slice_from_ptr(@ptr_cast(*mut V, calloc(ncap, @size_of(V))), ncap);
        let ok = @slice_from_ptr(self.keys, self.cap);
        let ov = @slice_from_ptr(self.vals, self.cap);
        for i in 0..self.cap {
            if ok[i] == 0 {
                continue;
            }
            let mut j = ptr_hash(ok[i]) & (ncap - 1);
            while nk[j] != 0 {
                j = (j + 1) & (ncap - 1);
            }
            nk[j] = ok[i];
            nv[j] = ov[i];
        }
        free(@ptr_cast(*mut void, self.keys));
        free(@ptr_cast(*mut void, self.vals));
        self.keys = nk.ptr;
        self.vals = nv.ptr;
        self.cap = ncap;
    }

    fn slot(self: *mut Self, k: []u8) usize {
        if self.cap == 0 {
            self.grow();
        }
        let key = @int_from_ptr(k.ptr);
        let ks = @slice_from_ptr(self.keys, self.cap);
        let mut j = ptr_hash(key) & (self.cap - 1);
        while (ks[j] != 0) and (ks[j] != key) {
            j = (j + 1) & (self.cap - 1);
        }
        return j;
    }

    pub fn get(self: *mut Self, k: []u8) V {
        let j = self.slot(k);
        let vs = @slice_from_ptr(self.vals, self.cap);
        return vs[j];
    }

    pub fn has(self: *mut Self, k: []u8) bool {
        let j = self.slot(k);
        let ks = @slice_from_ptr(self.keys, self.cap);
        return ks[j] != 0;
    }

    pub fn put(self: *mut Self, k: []u8, v: V) void {
        if ((self.len + 1) * 2) >= self.cap {
            self.grow();
        }
        let j = self.slot(k);
        let ks = @slice_from_ptr(self.keys, self.cap);
        let vs = @slice_from_ptr(self.vals, self.cap);
        if ks[j] == 0 {
            ks[j] = @int_from_ptr(k.ptr);
            self.len += 1;
        }
        vs[j] = v;
    }
}

// A map key for an object's identity.
pub fn addr_key(p: usize) []u8 {
    return intern(udec(@as(u64, p)));
}

// -----------------------------------------------------------------------------
// Sorting: a stable merge sort. `cmp` returns <0, 0 or >0 like qsort's.
// -----------------------------------------------------------------------------
pub fn sort[T](xs: []mut T, cmp: fn(T, T) i32) void {
    if xs.len < 2 {
        return;
    }
    let tmp = @slice_from_ptr(@ptr_cast(*mut T, malloc(xs.len * @size_of(T))), xs.len);
    merge_sort(xs, tmp, cmp);
    free(@ptr_cast(*mut void, tmp.ptr));
}

fn merge_sort[T](xs: []mut T, tmp: []mut T, cmp: fn(T, T) i32) void {
    let n = xs.len;
    if n < 2 {
        return;
    }
    let h = n / 2;
    merge_sort(xs[0..h], tmp[0..h], cmp);
    merge_sort(xs[h..n], tmp[h..n], cmp);
    let mut i: usize = 0;
    let mut j = h;
    let mut k: usize = 0;
    while (i < h) and (j < n) {
        if cmp(xs[j], xs[i]) < 0 {
            tmp[k] = xs[j];
            j += 1;
        } else {
            tmp[k] = xs[i];
            i += 1;
        }
        k += 1;
    }
    while i < h {
        tmp[k] = xs[i];
        i += 1;
        k += 1;
    }
    while j < n {
        tmp[k] = xs[j];
        j += 1;
        k += 1;
    }
    @mem_copy(xs, tmp[0..n]);
}

// -----------------------------------------------------------------------------
// 128-bit two's complement integers (constant folding needs them).
// -----------------------------------------------------------------------------
pub struct I128 {
    lo: u64,
    hi: u64,

    pub fn of(v: i64) I128 {
        let mut hi: u64 = 0;
        if v < 0 {
            hi = 0xFFFF_FFFF_FFFF_FFFF;
        }
        return I128.{ lo: @bit_cast(u64, v), hi: hi };
    }

    pub fn ofu(v: u64) I128 {
        return I128.{ lo: v, hi: 0 };
    }

    pub fn zero() I128 {
        return I128.{ lo: 0, hi: 0 };
    }

    // 2^k (k < 127)
    pub fn pow2(k: u32) I128 {
        return I128.ofu(1).shl(k);
    }

    pub fn is_neg(self: I128) bool {
        return (self.hi >> 63) != 0;
    }

    pub fn is_zero(self: I128) bool {
        return (self.lo == 0) and (self.hi == 0);
    }

    pub fn add(self: I128, b: I128) I128 {
        let lo = self.lo +% b.lo;
        let mut carry: u64 = 0;
        if lo < self.lo {
            carry = 1;
        }
        return I128.{ lo: lo, hi: (self.hi +% b.hi) +% carry };
    }

    pub fn not_(self: I128) I128 {
        return I128.{ lo: ~self.lo, hi: ~self.hi };
    }

    pub fn neg(self: I128) I128 {
        return self.not_().add(I128.ofu(1));
    }

    pub fn sub(self: I128, b: I128) I128 {
        return self.add(b.neg());
    }

    pub fn and_(self: I128, b: I128) I128 {
        return I128.{ lo: self.lo & b.lo, hi: self.hi & b.hi };
    }

    pub fn or_(self: I128, b: I128) I128 {
        return I128.{ lo: self.lo | b.lo, hi: self.hi | b.hi };
    }

    pub fn xor(self: I128, b: I128) I128 {
        return I128.{ lo: self.lo ^ b.lo, hi: self.hi ^ b.hi };
    }

    pub fn mul(self: I128, b: I128) I128 {
        let p = mul_full(self.lo, b.lo);
        let hi = (p.hi +% (self.lo *% b.hi)) +% (self.hi *% b.lo);
        return I128.{ lo: p.lo, hi: hi };
    }

    pub fn shl(self: I128, k: u32) I128 {
        if k == 0 {
            return self;
        }
        if k >= 128 {
            return I128.zero();
        }
        if k >= 64 {
            return I128.{ lo: 0, hi: self.lo << (k - 64) };
        }
        return I128.{ lo: self.lo << k, hi: (self.hi << k) | (self.lo >> (64 - k)) };
    }

    // arithmetic shift right (floor)
    pub fn sar(self: I128, k: u32) I128 {
        if k == 0 {
            return self;
        }
        let shi = @bit_cast(i64, self.hi);
        if k >= 128 {
            return I128.of(shi >> 63);
        }
        if k >= 64 {
            return I128.{ lo: @bit_cast(u64, shi >> (k - 64)), hi: @bit_cast(u64, shi >> 63) };
        }
        return I128.{ lo: (self.lo >> k) | (self.hi << (64 - k)), hi: @bit_cast(u64, shi >> k) };
    }

    pub fn eq(self: I128, b: I128) bool {
        return (self.lo == b.lo) and (self.hi == b.hi);
    }

    pub fn lt(self: I128, b: I128) bool {
        let a1 = @bit_cast(i64, self.hi);
        let b1 = @bit_cast(i64, b.hi);
        if a1 != b1 {
            return a1 < b1;
        }
        return self.lo < b.lo;
    }

    pub fn le(self: I128, b: I128) bool {
        return not b.lt(self);
    }

    pub fn gt(self: I128, b: I128) bool {
        return b.lt(self);
    }

    pub fn ge(self: I128, b: I128) bool {
        return not self.lt(b);
    }

    pub fn lti(self: I128, b: i64) bool {
        return self.lt(I128.of(b));
    }

    pub fn gti(self: I128, b: i64) bool {
        return self.gt(I128.of(b));
    }

    pub fn eqi(self: I128, b: i64) bool {
        return self.eq(I128.of(b));
    }

    // The low 64 bits, as C's (int64_t) / (uint64_t) casts.
    pub fn i64v(self: I128) i64 {
        return @bit_cast(i64, self.lo);
    }

    pub fn u64v(self: I128) u64 {
        return self.lo;
    }

    pub fn abs_u(self: I128) I128 {
        if self.is_neg() {
            return self.neg();
        }
        return self;
    }

    // Truncating signed division and remainder (C semantics).
    pub fn div(self: I128, b: I128) I128 {
        let q = udivmod(self.abs_u(), b.abs_u()).q;
        if self.is_neg() != b.is_neg() {
            return q.neg();
        }
        return q;
    }

    pub fn rem(self: I128, b: I128) I128 {
        let r = udivmod(self.abs_u(), b.abs_u()).r;
        if self.is_neg() {
            return r.neg();
        }
        return r;
    }

    // (double)v, rounded to nearest, ties to even.
    pub fn to_f64(self: I128) f64 {
        let neg = self.is_neg();
        let m = self.abs_u();
        let mut r: f64 = 0.0;
        if m.hi == 0 {
            r = @float_from_int(f64, m.lo);
        } else {
            // top bit position p >= 64: keep 53 bits, round to nearest even.
            let p = 127 - @truncate(u32, @clz(m.hi));
            let s = p - 52;
            let mant = m.sar(s).lo;
            let rem_mask = I128.ofu(1).shl(s).sub(I128.ofu(1));
            let rest = m.and_(rem_mask);
            let half = I128.ofu(1).shl(s - 1);
            let mut mm = mant;
            if rest.gt(half) or (rest.eq(half) and ((mant & 1) == 1)) {
                mm += 1;
            }
            r = @float_from_int(f64, mm);
            let mut k: u32 = 0;
            while k < s {
                r = r * 2.0;
                k += 1;
            }
        }
        if neg {
            return -r;
        }
        return r;
    }

    pub fn str(self: I128) []u8 {
        let neg = self.is_neg();
        let mut m = self.abs_u();
        let mut buf: [48]u8 = [0; 48];
        let mut n: usize = 48;
        let ten = I128.ofu(10);
        loop {
            let d = udivmod(m, ten);
            n -= 1;
            buf[n] = '0' + @truncate(u8, d.r.lo);
            m = d.q;
            if m.is_zero() {
                break;
            }
        }
        if neg {
            n -= 1;
            buf[n] = '-';
        }
        return dup(buf[n..]);
    }
}

struct U128Pair {
    lo: u64,
    hi: u64,
}

fn mul_full(a: u64, b: u64) U128Pair {
    let m32: u64 = 0xFFFF_FFFF;
    let a0 = a & m32;
    let a1 = a >> 32;
    let b0 = b & m32;
    let b1 = b >> 32;
    let p00 = a0 * b0;
    let p01 = a0 * b1;
    let p10 = a1 * b0;
    let p11 = a1 * b1;
    let mid = ((p00 >> 32) + (p01 & m32)) + (p10 & m32);
    let hi = ((p11 + (p01 >> 32)) + (p10 >> 32)) + (mid >> 32);
    let lo = (p00 & m32) | (mid << 32);
    return U128Pair.{ lo: lo, hi: hi };
}

struct DivMod {
    q: I128,
    r: I128,
}

fn ult(a: I128, b: I128) bool {
    if a.hi != b.hi {
        return a.hi < b.hi;
    }
    return a.lo < b.lo;
}

// Unsigned 128-bit division (b != 0).
fn udivmod(a: I128, b: I128) DivMod {
    let mut q = I128.zero();
    let mut r = I128.zero();
    let mut i: u32 = 128;
    while i > 0 {
        i -= 1;
        r = r.shl(1);
        let mut w: u64 = 0;
        if i >= 64 {
            w = a.hi >> (i - 64);
        } else {
            w = a.lo >> i;
        }
        r.lo = r.lo | (w & 1);
        if not ult(r, b) {
            r = r.sub(b);
            if i >= 64 {
                q.hi = q.hi | (@as(u64, 1) << (i - 64));
            } else {
                q.lo = q.lo | (@as(u64, 1) << i);
            }
        }
    }
    return DivMod.{ q: q, r: r };
}

// -----------------------------------------------------------------------------
// Output. stdout is buffered (flushed by flush_out and quit); stderr is not.
// -----------------------------------------------------------------------------
let mut out_buf: List.[u8] = List.[u8].{ data: @ptr_from_int(*mut u8, 0), len: 0, cap: 0 };

pub fn print(s: []u8) void {
    for c in s {
        out_buf.push(c);
    }
    if out_buf.len > 65536 {
        flush_out();
    }
}

pub fn flush_out() void {
    write_all(1, out_buf.items());
    out_buf.len = 0;
}

pub fn eprint(s: []u8) void {
    write_all(2, s);
}

pub fn write_all(fd: i32, s: []u8) void {
    let mut off: usize = 0;
    while off < s.len {
        let n = write(fd, &s[off], s.len - off);
        if n <= 0 {
            return;
        }
        off += @int_cast(usize, n);
    }
}

pub fn quit(code: i32) void {
    flush_out();
    ax_exit(code);
}

// -----------------------------------------------------------------------------
// Files
// -----------------------------------------------------------------------------
// The file's bytes (followed by a NUL), or a nil slice if it can't be read.
// (Read to the end: /proc files have no size.)
pub fn read_file(path: []u8) []u8 {
    let fd = ax_open(path.ptr, path.len, 0);
    if fd < 0 {
        return nosym();
    }
    let mut cap: usize = 4096;
    let size = ax_seek(fd, 0, 2);
    if size > 0 {
        cap = @int_cast(usize, size) + 1;
    }
    _ = ax_seek(fd, 0, 0);
    let mut buf = @ptr_cast(*mut u8, malloc(cap + 1));
    let mut len: usize = 0;
    loop {
        if len == cap {
            cap = cap * 2;
            buf = @ptr_cast(*mut u8, realloc(@ptr_cast(*mut void, buf), cap + 1));
        }
        let n = ax_read(fd, @ptr_from_int(*mut u8, @int_from_ptr(buf) + len), cap - len);
        if n < 0 {
            ax_close(fd);
            free(@ptr_cast(*mut void, buf));
            return nosym();
        }
        if n == 0 {
            break;
        }
        len += @int_cast(usize, n);
    }
    ax_close(fd);
    let out = alloc(len + 1);
    @mem_copy(@slice_from_ptr(out, len), @slice_from_ptr(buf, len));
    free(@ptr_cast(*mut void, buf));
    return @slice_from_ptr(out, len);
}

pub fn write_file(path: []u8, data: []u8) bool {
    let fd = ax_open(path.ptr, path.len, 1);
    if fd < 0 {
        return false;
    }
    let mut off: usize = 0;
    while off < data.len {
        let n = ax_write(fd, &data[off], data.len - off);
        if n <= 0 {
            ax_close(fd);
            return false;
        }
        off += @int_cast(usize, n);
    }
    ax_close(fd);
    return true;
}

// stat: [kind (1 file, 2 directory, 3 link), size, mtime, mode], or a
// negative kind if there is nothing at p.
fn stat(p: []u8) [4]i64 {
    let mut out: [4]i64 = [0; 4];
    if ax_stat(p.ptr, p.len, 1, &mut out[0]) < 0 {
        out[0] = -1;
    }
    return out;
}

pub fn file_exists(p: []u8) bool {
    return stat(p)[0] >= 0;
}

pub fn is_dir(p: []u8) bool {
    return stat(p)[0] == 2;
}

pub fn is_file(p: []u8) bool {
    let k = stat(p)[0];
    return (k >= 0) and (k != 2);
}

// Is p a file someone may run?
pub fn is_executable(p: []u8) bool {
    let st = stat(p);
    return (st[0] >= 0) and (st[0] != 2) and ((st[3] & 0o111) != 0);
}

pub fn file_size(p: []u8) i64 {
    let st = stat(p);
    if st[0] < 0 {
        return -1;
    }
    return st[1];
}

pub fn readlink(p: []u8) []u8 {
    let mut buf: [4096]u8 = [0; 4096];
    let n = ax_readlink(p.ptr, p.len, &mut buf[0], 4096);
    if (n <= 0) or (n > 4096) {
        return nosym();
    }
    return dup(buf[0..@int_cast(usize, n)]);
}

// The length of p's Windows drive ("C:" before a separator), or 0.
fn drive_len(p: []u8) usize {
    if (p.len < 3) or not on_windows() {
        return 0;
    }
    let l = p[0] | 0x20;
    if (l >= 'a') and (l <= 'z') and (p[1] == ':') and ((p[2] == '/') or (p[2] == '\\')) {
        return 2;
    }
    return 0;
}

// Is a byte a path separator ('/', and on Windows also '\\')?
fn is_sep(c: u8) bool {
    return (c == '/') or ((c == '\\') and on_windows());
}

pub fn on_windows() bool {
    return ax_os() == 3;
}

// realpath(3): absolute, without "." or ".." or symbolic links; a nil slice
// if p does not exist. (A Windows path keeps its drive: "C:/a/b".)
pub fn real_path(p: []u8) []u8 {
    if not file_exists(p) {
        return nosym();
    }
    let mut todo = List.[[]u8].{ data: nil.[[]u8](), len: 0, cap: 0 };  // components, last first
    let mut root: []u8 = "";
    let mut d = drive_len(p);
    push_parts(&mut todo, p[d..]);
    if d > 0 {
        root = p[0..d];
    } else if (p.len == 0) or not is_sep(p[0]) {
        let c = cwd();
        d = drive_len(c);
        root = c[0..d];
        push_parts(&mut todo, c[d..]);
    }
    let mut out = List.[[]u8].{ data: nil.[[]u8](), len: 0, cap: 0 };
    let mut links: i32 = 0;
    while todo.len > 0 {
        let c = todo.pop();
        if (c.len == 0) or str_eq(c, ".") {
            continue;
        }
        if str_eq(c, "..") {
            if out.len > 0 {
                _ = out.pop();
            }
            continue;
        }
        out.push(c);
        let here = join_parts(root, &out);
        let mut lst: [4]i64 = [0; 4];
        if ax_stat(here.ptr, here.len, 0, &mut lst[0]) < 0 {
            return nosym();
        }
        if lst[0] == 3 {
            links += 1;
            if links > 40 {
                return nosym();
            }
            let t = readlink(here);
            if isnos(t) {
                return nosym();
            }
            _ = out.pop();
            let td = drive_len(t);
            if td > 0 {
                root = t[0..td];
            }
            if (td > 0) or ((t.len > 0) and is_sep(t[0])) {
                out.clear();
            }
            push_parts(&mut todo, t[td..]);
        }
    }
    let r = join_parts(root, &out);
    free(@ptr_cast(*mut void, todo.data));
    free(@ptr_cast(*mut void, out.data));
    return r;
}

// Pushes p's components on a stack, so that the first is popped first.
fn push_parts(todo: *mut List.[[]u8], p: []u8) void {
    let mut end = p.len;
    let mut i = p.len;
    while i > 0 {
        if is_sep(p[i - 1]) {
            if end > i {
                todo.push(p[i..end]);
            }
            end = i - 1;
        }
        i -= 1;
    }
    if end > 0 {
        todo.push(p[0..end]);
    }
}

fn join_parts(root: []u8, parts: *List.[[]u8]) []u8 {
    let mut b = Buf.init();
    b.s(root);
    if parts.len == 0 {
        b.c('/');
        return b.done();
    }
    for i in 0..parts.len {
        b.c('/');
        b.s(parts.get(i));
    }
    return b.done();
}

pub fn cwd() []u8 {
    let mut buf: [4096]u8 = [0; 4096];
    let n = ax_getcwd(&mut buf[0], 4096);
    if (n <= 0) or (n > 4096) {
        return "";
    }
    return dup(buf[0..@int_cast(usize, n)]);
}

pub fn env(name: []u8) []u8 {
    let n = ax_getenv(name.ptr, name.len, nil.[u8](), 0);
    if n < 0 {
        return nosym();
    }
    let buf = alloc(@int_cast(usize, n) + 1);
    _ = ax_getenv(name.ptr, name.len, buf, @int_cast(usize, n));
    return @slice_from_ptr(buf, @int_cast(usize, n));
}

pub fn mkdirs(path: []u8) void {
    for i in 1..path.len {
        if path[i] == '/' {
            _ = ax_mkdir(path.ptr, i, 493);
        }
    }
    _ = ax_mkdir(path.ptr, path.len, 493);
}

// Directory entries (names, without "." and ".."), sorted.
pub fn list_dir(path: []u8, out: *mut List.[[]u8]) bool {
    let mut cap: usize = 4096;
    loop {
        let buf = @slice_from_ptr(alloc(cap), cap);
        let n = ax_readdir(path.ptr, path.len, buf.ptr, cap);
        if n < 0 {
            return false;
        }
        let need = @int_cast(usize, n);
        if need > cap {
            cap = need + 1024;
            continue;
        }
        let first = out.len;
        let mut i: usize = 0;
        while i < need {
            // a kind byte, then the name and a NUL
            let mut e = i + 1;
            while (e < need) and (buf[e] != 0) {
                e += 1;
            }
            let name = buf[i + 1..e];
            if not str_eq(name, ".") and not str_eq(name, "..") {
                out.push(dup(name));
            }
            i = e + 1;
        }
        sort.[[]u8](out.items()[first..], str_cmp);
        return true;
    }
}

// -----------------------------------------------------------------------------
// Processes
// -----------------------------------------------------------------------------
// What becomes of a child's standard output (run_process).
pub const OUT_INHERIT: i32 = 0;
pub const OUT_CAPTURE: i32 = 1;  // into Ran.out
pub const OUT_STDERR: i32 = 2;   // copied to our standard error
pub const OUT_NULL: i32 = 3;     // standard output and error to /dev/null

pub struct Ran {
    status: i32,  // the exit status; 128 + the signal; 127 if it could not run
    out: []u8,
}

// Runs args (a program without a "/" is looked for in PATH), with env_sets
// ("NAME=value") added to the environment, and waits for it.
pub fn run_process(args: [][]u8, env_sets: [][]u8, out_mode: i32) Ran {
    flush_out();
    let mut r = Ran.{ status: 127, out: "" };
    let mut cmd = sproc.Command.init(args[0]);
    defer cmd.deinit();
    cmd.args(args[1..]) catch return r;
    for kv in env_sets {
        let k = find(kv, '=');
        if k > 0 {
            cmd.set_env(kv[0..@int_cast(usize, k)], kv[@int_cast(usize, k) + 1..]) catch return r;
        }
    }
    if (out_mode == OUT_CAPTURE) or (out_mode == OUT_STDERR) {
        cmd.stdout(sproc.Stdio.PIPE);
    } else if out_mode == OUT_NULL {
        cmd.stdout(sproc.Stdio.NULL);
        cmd.stderr(sproc.Stdio.NULL);
    }
    let mut child = cmd.spawn() catch return r;
    if (out_mode == OUT_CAPTURE) or (out_mode == OUT_STDERR) {
        let mut b = Buf.init();
        let mut chunk: [8192]u8 = [0; 8192];
        loop {
            let n = child.stdout.read(chunk[..]) catch 0;
            if n == 0 {
                break;
            }
            if out_mode == OUT_STDERR {
                write_all(2, chunk[0..n]);
            } else {
                b.s(chunk[0..n]);
            }
        }
        r.out = b.done();
    }
    let st = child.wait() catch {
        r.status = -1;
        return r;
    };
    r.status = st.code;
    if st.signal != 0 {
        r.status = 128 + st.signal;
    }
    return r;
}

// -----------------------------------------------------------------------------
// Source files and spans
// -----------------------------------------------------------------------------
pub struct SourceFile {
    path: []u8,
    display: []u8,
    text: []u8,
    id: i32,
    line_starts: List.[u32],
    nlines: usize,
}

pub struct Span {
    file: i32,
    start: u32,
    end: u32,
}

pub struct LineCol {
    sl: i32,
    sc: i32,
    el: i32,
    ec: i32,
}

pub let mut g_files: List.[*mut SourceFile] = List.[*mut SourceFile].{
    data: @ptr_from_int(*mut *mut SourceFile, 0),
    len: 0,
    cap: 0,
};

pub fn file_of(id: i32) *mut SourceFile {
    return g_files.get(@int_cast(usize, id));
}

pub fn mkspan(file: i32, a: u32, b: u32) Span {
    return Span.{ file: file, start: a, end: b };
}

pub fn load_file(path: []u8, display: []u8) *mut SourceFile {
    let text = read_file(path);
    if isnos(text) {
        return nil.[SourceFile]();
    }
    let sf = new.[SourceFile]();
    sf.path = dup(path);
    if isnos(display) {
        sf.display = sf.path;
    } else {
        sf.display = display;
    }
    sf.text = text;
    sf.id = @int_cast(i32, g_files.len);
    g_files.push(sf);
    return sf;
}

struct LC {
    line: i32,
    col: i32,
}

fn offset_linecol(f: *mut SourceFile, off0: u32) LC {
    if f.line_starts.len == 0 {
        f.line_starts.push(0);
        for i in 0..f.text.len {
            if f.text[i] == '\n' {
                f.line_starts.push(@int_cast(u32, i) + 1);
            }
        }
        f.nlines = f.line_starts.len;
    }
    let mut off = off0;
    if @as(usize, off) > f.text.len {
        off = @int_cast(u32, f.text.len);
    }
    let ls = f.line_starts.items();
    let mut lo: usize = 0;
    let mut hi = f.nlines - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if ls[mid] <= off {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    let mut c: i32 = 1;
    let mut i = ls[lo];
    while i < off {
        if (f.text[@as(usize, i)] & 0xC0) != 0x80 {
            c += 1;
        }
        i += 1;
    }
    return LC.{ line: @int_cast(i32, lo) + 1, col: c };
}

pub fn span_linecol(s: Span) LineCol {
    let f = file_of(s.file);
    let a = offset_linecol(f, s.start);
    let b = offset_linecol(f, s.end);
    return LineCol.{ sl: a.line, sc: a.col, el: b.line, ec: b.col };
}

pub fn span_join(a: Span, b: Span) Span {
    let mut r = a;
    if b.file == a.file {
        if b.start < r.start {
            r.start = b.start;
        }
        if b.end > r.end {
            r.end = b.end;
        }
    }
    return r;
}

// The source text of a span.
pub fn span_text(sp: Span) []u8 {
    let f = file_of(sp.file);
    return dup(f.text[@as(usize, sp.start)..@as(usize, sp.end)]);
}

// -----------------------------------------------------------------------------
// Tests (axiom test selfhost/src/util.ax --target=native)
// -----------------------------------------------------------------------------
fn neg_cmp(a: i64, b: i64) i32 {
    if a < b {
        return -1;
    }
    if a > b {
        return 1;
    }
    return 0;
}

test "i128" {
    let a = I128.of(-7);
    @expect_eq(a.str(), "-7");
    @expect_eq(a.div(I128.of(2)).str(), "-3");
    @expect_eq(a.rem(I128.of(2)).str(), "-1");
    @expect_eq(a.sar(1).str(), "-4");
    let big = I128.pow2(100);
    @expect_eq(big.str(), "1267650600228229401496703205376");
    @expect_eq(big.mul(I128.of(-3)).div(I128.of(3)).str(), "-1267650600228229401496703205376");
    @expect(big.to_f64() == 1267650600228229401496703205376.0);
    @expect_eq(I128.ofu(0xFFFF_FFFF_FFFF_FFFF).add(I128.ofu(1)).str(), "18446744073709551616");
    @expect(I128.of(-1).lt(I128.of(0)));
    @expect_eq(I128.of(5).sub(I128.of(9)).i64v(), -4);
}

test "format and parse" {
    @expect_eq(f2("a %s b %s%%", "x", dec(-42)), "a x b -42%");
    @expect_eq(hex16(255), "00000000000000ff");
    @expect_eq(c_strtoll("0x1F").v, 31);
    @expect_eq(c_strtoll("010").v, 8);
    @expect_eq(c_strtoll("-5").v, -5);
    @expect(c_strtoll("99999999999999999999").ovf);
    @expect_eq(c_strtoull("18446744073709551615").v, -1);
    @expect_eq(ffmt("%.1f", 2.25), "2.2");
    let mut xs: [5]i64 = [3, 1, 2, 5, 4];
    sort(xs[..], neg_cmp);
    @expect_eq(xs[0], 1);
    @expect_eq(xs[4], 5);
    @expect(same(intern("abc"), intern(dup("abc"))));
    let mut m = SymMap.[i32].{ keys: nil.[usize](), vals: nil.[i32](), cap: 0, len: 0 };
    m.put(intern("k"), 7);
    @expect_eq(m.get(intern("k")), 7);
    @expect_eq(m.get(intern("q")), 0);
}
