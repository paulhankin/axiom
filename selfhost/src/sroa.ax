// =============================================================================
// sroa.ax - scalar replacement of aggregates.
//
// Lowering puts every aggregate value in a stack slot and moves it with
// memcpy. A slot whose address does not escape (it is only loaded from,
// stored to, copied to or from, and offset by constants) is split into one
// slot per scalar field ("leaf"); copies become field loads and stores. The
// new slots hold scalars, so mem2reg then promotes them to SSA values.
//
// Slots that are written but never read are deleted with their stores.
// =============================================================================
import "ir.ax" as ir;
import "opt.ax" as opt;
import "util.ax" as u;

const MAX_LEAVES: usize = 32;
const MAX_SIZE: u64 = 256;

struct Leaf {
    off: u64,
    ty: *mut ir.Ty,
    slot: *mut ir.Value,
}

struct Part {
    a: *mut ir.Value,
    escaped: bool,   // the address may be seen by anything but this pass's uses
    split_ok: bool,  // every access matches the leaves
    reads: bool,
    skip: bool,  // a copy partner changed this round: next round
    nwrites: i32,
    write: *mut ir.Value,  // the last write seen
    uses: u.List.[*mut ir.Value],
    leaves: u.List.[Leaf],
}

fn vnil() *mut ir.Value {
    return u.nil.[ir.Value]();
}

let mut B: *mut ir.Builder = @ptr_from_int(*mut ir.Builder, 0);
let mut parts: u.List.[*mut Part] = u.List.[*mut Part].{ data: @ptr_from_int(*mut *mut Part, 0), len: 0, cap: 0 };

// The part a pointer is derived from (the alloca plus a constant offset), or nil.
fn part_of(v: *ir.Value) *mut Part {
    if u.notnil(v) and (v.kind == ir.V_INST) and (v.aux > 0) and ((v.op == ir.OP_ALLOCA) or (v.op == ir.OP_PTRADD)) {
        return parts.get(@int_cast(usize, v.aux - 1));
    }
    return u.nil.[Part]();
}

fn is_scalar(t: *ir.Ty) bool {
    return (t.kind == ir.T_INT) or (t.kind == ir.T_FLOAT) or (t.kind == ir.T_PTR) or (t.kind == ir.T_VEC);
}

// The scalar leaves of t at offset base; false if there are too many.
fn flatten(t: *mut ir.Ty, base: u64, out: *mut u.List.[Leaf]) bool {
    if t.kind == ir.T_STRUCT {
        for i in 0..t.fields.len {
            if not flatten(t.fields[i], base + t.offs[i], out) {
                return false;
            }
        }
        return true;
    }
    if t.kind == ir.T_ARRAY {
        if t.count > @as(u64, MAX_LEAVES) {
            return false;
        }
        for i in 0..@truncate(usize, t.count) {
            if not flatten(t.elem, base + t.elem.size * @as(u64, i), out) {
                return false;
            }
        }
        return true;
    }
    if not is_scalar(t) or (t.size == 0) {
        return false;
    }
    if out.len >= MAX_LEAVES {
        return false;
    }
    out.push(Leaf.{ off: base, ty: t, slot: vnil() });
    return true;
}

// Leaves that tile the slot (gaps become integer leaves), or false.
fn make_leaves(p: *mut Part) bool {
    let t = p.a.aty;
    if t.size > MAX_SIZE {
        return false;
    }
    let mut raw = u.List.[Leaf].empty();
    if not flatten(t, 0, &mut raw) {
        raw.deinit();
        return false;
    }
    let mut pos: u64 = 0;
    let mut ok = true;
    for k in 0..(raw.len + 1) {
        let mut end = t.size;
        if k < raw.len {
            end = raw.get(k).off;
        }
        if end < pos {
            ok = false;  // overlapping leaves (cannot happen for well-formed types)
            break;
        }
        while pos < end {
            let mut n: u64 = 8;
            while (n > (end - pos)) or ((pos % n) != 0) {
                n = n / 2;
            }
            p.leaves.push(Leaf.{ off: pos, ty: ir.t_int(@int_cast(i32, n * 8)), slot: vnil() });
            pos += n;
        }
        if k < raw.len {
            let l = raw.get(k);
            p.leaves.push(l);
            pos = l.off + l.ty.size;
        }
    }
    raw.deinit();
    return ok and (p.leaves.len <= MAX_LEAVES * 2);
}

// The offset of a pointer derived with a variable offset.
const VAR_OFF: i64 = -0x7fff_ffff_ffff_ffff;

fn leaf_at(p: *mut Part, off: i64) i64 {
    if off < 0 {
        return -1;
    }
    for k in 0..p.leaves.len {
        if p.leaves.get(k).off == @bit_cast(u64, off) {
            return @int_cast(i64, k);
        }
    }
    return -1;
}

// Is [off, off + n) a whole number of leaves?
fn range_ok(p: *mut Part, off: i64, n: u64) bool {
    if (off < 0) or (n == 0) {
        return n == 0;
    }
    if leaf_at(p, off) < 0 {
        return false;
    }
    let end = @bit_cast(u64, off) + n;
    if end == p.a.aty.size {
        return true;
    }
    return leaf_at(p, @bit_cast(i64, end)) >= 0;
}

fn convertible(from: *ir.Ty, to: *ir.Ty) bool {
    if from == to {
        return true;
    }
    if from.size != to.size {
        return false;
    }
    let fi = (from.kind == ir.T_INT) or (from.kind == ir.T_PTR);
    let ti = (to.kind == ir.T_INT) or (to.kind == ir.T_PTR);
    if fi and ti {
        if (from.kind == ir.T_PTR) or (to.kind == ir.T_PTR) {
            return (from.bits == to.bits) and (from.bits == @int_cast(i32, ir.ptr_bytes * 8));
        }
        return true;  // i1 / i8
    }
    if ((from.kind == ir.T_FLOAT) and (to.kind == ir.T_INT)) or ((from.kind == ir.T_INT) and (to.kind == ir.T_FLOAT)) {
        return from.bits == to.bits;
    }
    return false;
}

fn convert(v: *mut ir.Value, to: *mut ir.Ty) *mut ir.Value {
    let from = v.ty;
    if from == to {
        return v;
    }
    if (from.kind == ir.T_PTR) and (to.kind == ir.T_INT) {
        return ir.cast(B, ir.OP_PTRTOINT, v, to);
    }
    if (from.kind == ir.T_INT) and (to.kind == ir.T_PTR) {
        return ir.cast(B, ir.OP_INTTOPTR, v, to);
    }
    if (from.kind == ir.T_INT) and (to.kind == ir.T_INT) {
        if from.bits < to.bits {
            return ir.zext(B, v, to);
        }
        return ir.trunc(B, v, to);
    }
    return ir.bitcast(B, v, to);
}

fn access_ok(p: *mut Part, off: i64, t: *ir.Ty) bool {
    let k = leaf_at(p, off);
    if k < 0 {
        return false;
    }
    let l = p.leaves.get(@int_cast(usize, k));
    return l.ty.size == t.size and convertible(t, l.ty);
}

fn leaf_slot(f: *mut ir.Func, p: *mut Part, k: usize) *mut ir.Value {
    let l = p.leaves.at(k);
    if u.isnil(l.slot) {
        let saved_blk = B.blk;
        let saved_before = B.before;
        ir.at_before(B, p.a);
        l.slot = ir.alloca(B, l.ty, "sroa");
        B.blk = saved_blk;
        B.before = saved_before;
    }
    return l.slot;
}

fn off_of(v: *ir.Value) i64 {
    return v.aux2;
}

fn escape(o: *mut ir.Value) void {
    let p = part_of(o);
    if u.notnil(p) {
        p.escaped = true;
    }
}

// Records a use of a derived pointer and checks it.
fn classify(i: *mut ir.Value) void {
    let op = i.op;
    if op == ir.OP_PTRADD {
        let p = part_of(i.a);
        if u.notnil(p) and (part_of(i) != p) {
            p.escaped = true;  // not derived (an unreachable definition)
        }
        escape(i.b);
        return;
    }
    if op == ir.OP_LOAD {
        let p = part_of(i.a);
        if u.notnil(p) {
            p.reads = true;
            p.uses.push(i);
            if (i.flags != 0) or not access_ok(p, off_of(i.a), i.ty) {
                p.split_ok = false;
            }
        }
        return;
    }
    if op == ir.OP_STORE {
        escape(i.a);
        let p = part_of(i.b);
        if u.notnil(p) {
            p.uses.push(i);
            p.nwrites += 1;
            p.write = i;
            if (i.flags != 0) or not access_ok(p, off_of(i.b), i.a.ty) {
                p.split_ok = false;
            }
        }
        return;
    }
    if (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE) {
        let pd = part_of(i.a);
        let ps = part_of(i.b);
        escape(i.c);
        if u.notnil(pd) and (pd == ps) {
            pd.escaped = true;
            return;
        }
        if u.notnil(pd) {
            pd.uses.push(i);
            pd.nwrites += 1;
            pd.write = i;
            if not ir.is_cint(i.c) or not range_ok(pd, off_of(i.a), ir.cint_val(i.c)) {
                pd.split_ok = false;
            }
        }
        if u.notnil(ps) {
            ps.reads = true;
            ps.uses.push(i);
            if not ir.is_cint(i.c) or not range_ok(ps, off_of(i.b), ir.cint_val(i.c)) {
                ps.split_ok = false;
            }
        }
        return;
    }
    if op == ir.OP_MEMSET {
        escape(i.b);
        escape(i.c);
        let p = part_of(i.a);
        if u.notnil(p) {
            p.uses.push(i);
            p.nwrites += 1;
            p.write = i;
            if not ir.is_cint(i.c) or not ir.is_cint(i.b) or not range_ok(p, off_of(i.a), ir.cint_val(i.c)) {
                p.split_ok = false;
            } else {
                // a non-zero byte only fills integer leaves
                if ir.cint_val(i.b) != 0 {
                    let o = off_of(i.a);
                    for k in 0..p.leaves.len {
                        let l = p.leaves.get(k);
                        if (@bit_cast(i64, l.off) >= o) and (l.off < (@bit_cast(u64, o) + ir.cint_val(i.c))) and
                           (l.ty.kind != ir.T_INT) {
                            p.split_ok = false;
                        }
                    }
                }
            }
        }
        return;
    }
    // any other use lets the address escape
    escape(i.a);
    escape(i.b);
    escape(i.c);
    for k in 0..i.xs.len {
        escape(i.xs.get(k));
    }
}

fn memset_value(t: *mut ir.Ty, byte: u64) *mut ir.Value {
    if byte == 0 {
        return ir.czero(t);
    }
    let mut x: u64 = 0;
    for _k in 0..@truncate(usize, t.size) {
        x = (x << 8) | byte;
    }
    return ir.cint(t, x);
}

fn rewrite(f: *mut ir.Func, p: *mut Part) void {
    for ui in 0..p.uses.len {
        let i = p.uses.get(ui);
        let op = i.op;
        ir.at_before(B, i);
        if op == ir.OP_LOAD {
            let k = @int_cast(usize, leaf_at(p, off_of(i.a)));
            let l = p.leaves.get(k);
            let s = leaf_slot(f, p, k);
            if l.ty == i.ty {
                i.a = s;
            } else {
                let x = ir.load(B, l.ty, s);
                ir.forward(i, convert(x, i.ty));
                ir.remove_inst(i);
            }
        } else if op == ir.OP_STORE {
            let k = @int_cast(usize, leaf_at(p, off_of(i.b)));
            let l = p.leaves.get(k);
            i.a = convert(i.a, l.ty);
            i.b = leaf_slot(f, p, k);
            i.align = @int_cast(u32, l.ty.align);
        } else if op == ir.OP_MEMSET {
            let o = off_of(i.a);
            let n = ir.cint_val(i.c);
            for k in 0..p.leaves.len {
                let l = p.leaves.get(k);
                if (@bit_cast(i64, l.off) >= o) and (l.off < (@bit_cast(u64, o) + n)) {
                    _ = ir.store(B, memset_value(l.ty, ir.cint_val(i.b) & 0xff), leaf_slot(f, p, k));
                }
            }
            ir.remove_inst(i);
        } else {
            // memcpy / memmove between this slot and other memory
            let n = ir.cint_val(i.c);
            let into = part_of(i.a) == p;
            let mut o: i64 = 0;
            let mut other = i.a;
            if into {
                o = off_of(i.a);
                other = i.b;
            } else {
                o = off_of(i.b);
            }
            for k in 0..p.leaves.len {
                let l = p.leaves.get(k);
                if (@bit_cast(i64, l.off) < o) or (l.off >= (@bit_cast(u64, o) + n)) {
                    continue;
                }
                let rel = l.off - @bit_cast(u64, o);
                let q = ir.ptradd(B, other, ir.cint(ir.isz(), rel));
                if into {
                    let x = ir.load(B, l.ty, q);
                    x.align = 1;
                    _ = ir.store(B, x, leaf_slot(f, p, k));
                } else {
                    let x = ir.load(B, l.ty, leaf_slot(f, p, k));
                    let s = ir.store(B, x, q);
                    s.align = 1;
                }
            }
            ir.remove_inst(i);
        }
    }
}

// Copies between p and another slot are rewritten or deleted with p; the
// other slot waits for the next round.
fn defer_partners(p: *mut Part) void {
    for ui in 0..p.uses.len {
        let i = p.uses.get(ui);
        if (i.op == ir.OP_MEMCPY) or (i.op == ir.OP_MEMMOVE) {
            let d = part_of(i.a);
            let s = part_of(i.b);
            if u.notnil(d) and (d != p) {
                d.skip = true;
            }
            if u.notnil(s) and (s != p) {
                s.skip = true;
            }
        }
    }
}

// Deletes a slot nothing reads, with every write to it.
fn delete_writes(p: *mut Part) void {
    for ui in 0..p.uses.len {
        let i = p.uses.get(ui);
        if u.notnil(i.blk) {
            ir.remove_inst(i);
        }
    }
}

// Is the slot written exactly once, by a copy of a whole constant global?
fn const_copy(p: *mut Part) bool {
    if p.nwrites != 1 {
        return false;
    }
    let w = p.write;
    if (w.op != ir.OP_MEMCPY) or (w.a != p.a) or not ir.is_cint(w.c) or (ir.cint_val(w.c) != p.a.aty.size) {
        return false;
    }
    let g = w.b;
    return (g.kind == ir.V_GLOBAL) and g.gv.is_const and u.notnil(g.gv.init) and (g.gv.ty.size >= p.a.aty.size);
}

// Is every use of the slot a copy or fill of all of it? Then nothing reads
// its fields, and it is split into integers as wide as fit (8 bytes) rather
// than into its fields: a `{u32, f32}` element copied from one place to
// another through it is one load and one store, not two of each.
fn whole_copies_only(p: *mut Part) bool {
    let n = p.a.aty.size;
    for ui in 0..p.uses.len {
        let i = p.uses.get(ui);
        if (i.op == ir.OP_MEMCPY) or (i.op == ir.OP_MEMMOVE) or (i.op == ir.OP_MEMSET) {
            if not ir.is_cint(i.c) or (ir.cint_val(i.c) != n) {
                return false;
            }
            if (part_of(i.a) == p) and (off_of(i.a) != 0) {
                return false;
            }
            if (i.op != ir.OP_MEMSET) and (part_of(i.b) == p) and (off_of(i.b) != 0) {
                return false;
            }
        } else {
            return false;
        }
    }
    return true;
}

// Does the slot hold a vector? Its pieces then stay vectors: as integers they
// would be moved between register files at every use.
fn vector_leaves(p: *mut Part) bool {
    for k in 0..p.leaves.len {
        if p.leaves.get(k).ty.kind == ir.T_VEC {
            return true;
        }
    }
    return false;
}

fn int_leaves(p: *mut Part) void {
    p.leaves.clear();
    let size = p.a.aty.size;
    let mut pos: u64 = 0;
    while pos < size {
        let mut n: u64 = 8;
        while n > (size - pos) {
            n = n / 2;
        }
        p.leaves.push(Leaf.{ off: pos, ty: ir.t_int(@int_cast(i32, n * 8)), slot: vnil() });
        pos += n;
    }
}

// True if anything changed.
pub fn sroa(f: *mut ir.Func) bool {
    if u.isnil(B) {
        B = ir.new_builder();
    }
    parts.clear();
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.aux = 0;
            i.aux2 = 0;
            i = i.next;
        }
        b = b.next;
    }
    opt.compute_preds(f);
    let order = opt.rpo(f);
    // derived pointers, in an order where definitions come first
    for bi in 0..order.len {
        let mut i = order.get(bi).first;
        while u.notnil(i) {
            if i.op == ir.OP_ALLOCA {
                let p = u.new.[Part]();
                p.a = i;
                p.split_ok = make_leaves(p);
                parts.push(p);
                i.aux = @int_cast(i64, parts.len);
                i.aux2 = 0;
            } else if i.op == ir.OP_PTRADD {
                let p = part_of(i.a);
                if u.notnil(p) {
                    i.aux = i.a.aux;
                    if ir.is_cint(i.b) and (i.a.aux2 != VAR_OFF) {
                        i.aux2 = i.a.aux2 + ir.sval(i.b);
                    } else {
                        i.aux2 = VAR_OFF;
                    }
                }
            }
            i = i.next;
        }
    }
    order.deinit();
    if parts.len == 0 {
        return false;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            classify(i);
            i = i.next;
        }
        b = b.next;
    }
    let mut any = false;
    for k in 0..parts.len {
        let p = parts.get(k);
        if p.escaped or p.skip {
            continue;
        }
        if not p.reads {
            defer_partners(p);
            delete_writes(p);
            ir.remove_inst(p.a);
            any = true;
        } else if const_copy(p) {
            // only ever a copy of constant memory: read the constant
            ir.remove_inst(p.write);
            ir.forward(p.a, p.write.b);
            ir.remove_inst(p.a);
            any = true;
        } else if p.split_ok {
            // a scalar slot accessed only with its own type is mem2reg's
            let mut trivial = (p.leaves.len == 1) and (p.leaves.get(0).ty == p.a.aty);
            for ui in 0..p.uses.len {
                let i = p.uses.get(ui);
                if (i.op != ir.OP_LOAD) and (i.op != ir.OP_STORE) {
                    trivial = false;
                } else if (i.op == ir.OP_LOAD) and ((i.ty != p.a.aty) or (i.a != p.a)) {
                    trivial = false;
                } else if (i.op == ir.OP_STORE) and ((i.a.ty != p.a.aty) or (i.b != p.a)) {
                    trivial = false;
                }
            }
            if not trivial {
                if whole_copies_only(p) and not vector_leaves(p) {
                    int_leaves(p);
                }
                defer_partners(p);
                rewrite(f, p);
                ir.remove_inst(p.a);
                any = true;
            }
        }
    }
    for k in 0..parts.len {
        let p = parts.get(k);
        p.uses.deinit();
        p.leaves.deinit();
    }
    if any {
        ir.apply_forwarding(f);
    }
    return any;
}
