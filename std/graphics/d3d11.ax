// =============================================================================
// std/graphics/d3d11.ax - Direct3D 11: a GPU device, HLSL shaders compiled at
// run time, buffers, render targets (a window's swap chain, or a texture
// whose pixels can be read back), textures from images, depth buffers,
// drawing, and compute shaders.
//
//     let mut gpu = d3d11.Device.init_window(w.handle(), 800, 600)!;  // or Device.init() offscreen
//     defer gpu.deinit();
//     let vs_code = hlsl.compile(src, "vs", "vs_4_0")!;   // std/graphics/hlsl
//     let vs = gpu.vertex_shader(&vs_code)!;
//     ...
//     gpu.clear(gpu.screen(), 0.1, 0.1, 0.2, 1.0);
//     gpu.set_target(gpu.screen());
//     gpu.set_shaders(vs, ps);
//     gpu.draw(3, 0);
//     gpu.present(true)!;
//
// Textures from images are read by shaders at t0, t1, ... through two
// samplers: s0 linear and wrapping, s1 point and clamped. In 3D, a depth
// buffer the size of the target hides what is behind:
//
//     let mut tex = gpu.texture(&img)!;                 // (any image.Image)
//     let mut z = gpu.depth_buffer(800, 600)!;
//     gpu.set_target_depth(gpu.screen(), &z);
//     gpu.clear_depth(&z);
//     gpu.set_cull(d3d11.CULL_BACK)!;                   // front faces counter-clockwise
//     gpu.set_texture(0, &tex)!;
//
// Compute shaders work on storage buffers (RWStructuredBuffer<T> at u0, u1,
// ...; StructuredBuffer<T> at t0, ... to only read one), which can be read
// back, or read by a vertex shader (set_vertex_storage):
//
//     let cs = gpu.compute_shader(&cs_code)!;          // hlsl.compile(src, "main", "cs_5_0")
//     let mut b = gpu.storage_buffer(data, 16)!;        // elements of 16 bytes
//     gpu.set_compute(cs);
//     gpu.set_storage(0, &b);
//     gpu.dispatch(n / 64, 1, 1);
//     gpu.read_buffer(&b, out)!;
//
// Windows only (--target=x86_64-windows): d3d11.dll and dxgi exist nowhere
// else. Objects are COM interfaces; each
// wrapper's deinit() lets it go, and Device.deinit releases the device.
// One device is used from one thread at a time (the immediate context).
// Without a GPU (or under Wine without one) the device is WARP's, in
// software.
// =============================================================================

import "hlsl.ax" as hlsl;
import "image.ax" as image;

error { Unsupported, Failed, OutOfMemory }

extern "C" "d3d11" {
    fn D3D11CreateDevice(adapter: usize, driver: u32, software: usize, flags: u32, levels: *u32, nlevels: u32, sdk: u32,
                         dev: *mut usize, level: *mut u32, ctx: *mut usize) i32;
    fn D3D11CreateDeviceAndSwapChain(adapter: usize, driver: u32, software: usize, flags: u32, levels: *u32,
                                     nlevels: u32, sdk: u32, desc: *u8, swap: *mut usize, dev: *mut usize,
                                     level: *mut u32, ctx: *mut usize) i32;
}

// DXGI formats
pub const R8G8B8A8_UNORM: u32 = 28;
pub const B8G8R8A8_UNORM: u32 = 87;
pub const R32_FLOAT: u32 = 41;
pub const R32G32_FLOAT: u32 = 16;
pub const R32G32B32_FLOAT: u32 = 6;
pub const R32G32B32A32_FLOAT: u32 = 2;
pub const R16_UINT: u32 = 57;
pub const R32_UINT: u32 = 42;

// Primitive topologies
pub const POINT_LIST: u32 = 1;
pub const LINE_LIST: u32 = 2;
pub const LINE_STRIP: u32 = 3;
pub const TRIANGLE_LIST: u32 = 4;
pub const TRIANGLE_STRIP: u32 = 5;

// Buffer kinds (D3D11_BIND_*)
pub const VERTEX: u32 = 0x1;
pub const INDEX: u32 = 0x2;
pub const CONSTANT: u32 = 0x4;
const BIND_SHADER_RESOURCE: u32 = 0x8;
const BIND_RENDER_TARGET: u32 = 0x20;
const BIND_DEPTH_STENCIL: u32 = 0x40;
const BIND_UNORDERED_ACCESS: u32 = 0x80;
const D32_FLOAT: u32 = 40;

// Depth testing (set_depth), with a depth buffer bound (set_target_depth)
pub const DEPTH_OFF: u32 = 0;    // not tested or written
pub const DEPTH_TEST: u32 = 1;   // tested (nearer passes), not written: transparent things
pub const DEPTH_WRITE: u32 = 2;  // tested and written: solid things (the default)

// Culling (set_cull); front faces are counter-clockwise as seen
pub const CULL_NONE: u32 = 1;
pub const CULL_FRONT: u32 = 2;
pub const CULL_BACK: u32 = 3;

// Blending (set_blend)
pub const BLEND_NONE: u32 = 0;
pub const BLEND_ALPHA: u32 = 1;  // over what is there, by the source's alpha
pub const BLEND_ADD: u32 = 2;    // added to what is there, scaled by the source's alpha (glows)

const SDK_VERSION: u32 = 7;
const DRIVER_HARDWARE: u32 = 1;
const DRIVER_WARP: u32 = 5;
const BGRA_SUPPORT: u32 = 0x20;  // D3D11_CREATE_DEVICE_BGRA_SUPPORT, for Direct2D (std/graphics/d2d)

// -----------------------------------------------------------------------------
// COM: an interface pointer's first word is its table of methods
// -----------------------------------------------------------------------------
fn method(obj: usize, i: usize) usize {
    let vt = @ptr_from_int(*usize, obj).*;
    return @ptr_from_int(*usize, vt + (i * 8)).*;
}

fn release_com(obj: usize) void {
    if obj != 0 {
        let f = @bit_cast(fn(usize) u32, method(obj, 2));  // IUnknown::Release
        _ = f(obj);
    }
}

fn put(b: []mut u8, at: usize, x: u64, n: usize) void {
    for k in 0..n {
        b[at + k] = @truncate(u8, x >> @as(u64, k * 8));
    }
}

fn get32(p: usize) u32 {
    return @ptr_from_int(*u32, p).*;
}

// -----------------------------------------------------------------------------
// Resources
// -----------------------------------------------------------------------------
pub struct VertexShader {
    p: usize,

    pub fn deinit(self: *mut VertexShader) void {
        release_com(self.p);
        self.p = 0;
    }
}

pub struct PixelShader {
    p: usize,

    pub fn deinit(self: *mut PixelShader) void {
        release_com(self.p);
        self.p = 0;
    }
}

/// An attribute of a vertex: its HLSL semantic name and index, its format,
/// its byte offset in the vertex.
pub struct Attribute {
    semantic: []u8,
    index: u32,
    format: u32,
    offset: u32,
}

pub struct InputLayout {
    p: usize,

    pub fn deinit(self: *mut InputLayout) void {
        release_com(self.p);
        self.p = 0;
    }
}

pub struct Buffer {
    p: usize,
    size: u32,

    pub fn deinit(self: *mut Buffer) void {
        release_com(self.p);
        self.p = 0;
    }
}

/// An image on the GPU, for shaders to read (set_texture).
pub struct Texture {
    tex: usize,  // ID3D11Texture2D
    srv: usize,  // ID3D11ShaderResourceView
    width: u32,
    height: u32,

    pub fn deinit(self: *mut Texture) void {
        release_com(self.srv);
        release_com(self.tex);
        self.srv = 0;
        self.tex = 0;
    }
}

/// A depth buffer (32-bit float), drawn into with a target of its size.
pub struct DepthBuffer {
    tex: usize,
    dsv: usize,  // ID3D11DepthStencilView
    width: u32,
    height: u32,

    pub fn deinit(self: *mut DepthBuffer) void {
        release_com(self.dsv);
        release_com(self.tex);
        self.dsv = 0;
        self.tex = 0;
    }
}

pub struct ComputeShader {
    p: usize,

    pub fn deinit(self: *mut ComputeShader) void {
        release_com(self.p);
        self.p = 0;
    }
}

/// A structured buffer of elements of `stride` bytes, which compute
/// shaders write (u0, u1, ...) and shaders read (t0, ...).
pub struct StorageBuffer {
    p: usize,
    srv: usize,
    uav: usize,  // ID3D11UnorderedAccessView
    size: u32,
    stride: u32,

    pub fn deinit(self: *mut StorageBuffer) void {
        release_com(self.uav);
        release_com(self.srv);
        release_com(self.p);
        self.uav = 0;
        self.srv = 0;
        self.p = 0;
    }
}

/// Something to draw into: a window's back buffer or a texture.
pub struct Target {
    tex: usize,  // ID3D11Texture2D
    rtv: usize,  // ID3D11RenderTargetView
    width: u32,
    height: u32,

    pub fn deinit(self: *mut Target) void {
        release_com(self.rtv);
        release_com(self.tex);
        self.rtv = 0;
        self.tex = 0;
    }
}

// IID_ID3D11Texture2D {6f15aaf2-d208-4e89-9ab4-489535d34f9c}
let IID_TEXTURE2D: [16]u8 = [0xf2, 0xaa, 0x15, 0x6f, 0x08, 0xd2, 0x89, 0x4e, 0x9a, 0xb4, 0x48, 0x95, 0x35, 0xd3, 0x4f,
                             0x9c];

let LEVELS: [3]u32 = [0xb000, 0xa100, 0xa000];  // 11_0, 10_1, 10_0

pub struct Device {
    dev: usize,   // ID3D11Device
    ctx: usize,   // ID3D11DeviceContext (immediate)
    swap: usize,  // IDXGISwapChain, 0 without a window
    back: Target,
    level: u32,  // the feature level: 0xb000 for 11_0, ...
    // states, made when first used
    samplers: [2]usize,  // s0 linear and wrapping, s1 point and clamped
    depth_states: [3]usize,
    cull_states: [3]usize,
    blend_states: [3]usize,

    /// A device for drawing offscreen (into textures).
    pub fn init() !Device {
        let mut d = Device.{ dev: 0, ctx: 0, swap: 0, back: Target.{ tex: 0, rtv: 0, width: 0, height: 0 }, level: 0,
                             samplers: [0; 2], depth_states: [0; 3], cull_states: [0; 3], blend_states: [0; 3] };
        let mut hr = D3D11CreateDevice(0, DRIVER_HARDWARE, 0, BGRA_SUPPORT, &LEVELS[0], 3, SDK_VERSION, &mut d.dev,
                                       &mut d.level, &mut d.ctx);
        if hr < 0 {
            hr = D3D11CreateDevice(0, DRIVER_WARP, 0, BGRA_SUPPORT, &LEVELS[0], 3, SDK_VERSION, &mut d.dev,
                                   &mut d.level, &mut d.ctx);
        }
        if hr < 0 {
            return error.Unsupported;
        }
        return d;
    }

    /// A device drawing into a window (its HWND: win32.Window.handle()) of
    /// width × height pixels, through a swap chain of two buffers.
    pub fn init_window(hwnd: usize, width: u32, height: u32) !Device {
        // DXGI_SWAP_CHAIN_DESC (72 bytes): the mode (width, height, refresh
        // rate, format...), samples at 28, usage at 36, buffer count at 40,
        // the window at 48, windowed at 56, swap effect at 60
        let mut sd: [72]u8 = [0; 72];
        put(sd[..], 0, @as(u64, width), 4);
        put(sd[..], 4, @as(u64, height), 4);
        put(sd[..], 16, @as(u64, R8G8B8A8_UNORM), 4);
        put(sd[..], 28, 1, 4);
        put(sd[..], 36, 0x20, 4);  // DXGI_USAGE_RENDER_TARGET_OUTPUT
        put(sd[..], 40, 2, 4);
        put(sd[..], 48, @as(u64, hwnd), 8);
        put(sd[..], 56, 1, 4);
        put(sd[..], 60, 4, 4);  // DXGI_SWAP_EFFECT_FLIP_DISCARD
        let mut d = Device.{ dev: 0, ctx: 0, swap: 0, back: Target.{ tex: 0, rtv: 0, width: width, height: height },
                             level: 0, samplers: [0; 2], depth_states: [0; 3], cull_states: [0; 3],
                             blend_states: [0; 3] };
        let mut hr: i32 = -1;
        for effect in [@as(u64, 4), 0] {  // flip-discard; discard on older systems
            put(sd[..], 60, effect, 4);
            put(sd[..], 40, u64_pick(effect == 4, 2, 1), 4);
            for driver in [DRIVER_HARDWARE, DRIVER_WARP] {
                hr = D3D11CreateDeviceAndSwapChain(0, driver, 0, BGRA_SUPPORT, &LEVELS[0], 3, SDK_VERSION, &sd[0],
                                                   &mut d.swap, &mut d.dev, &mut d.level, &mut d.ctx);
                if hr >= 0 {
                    break;
                }
            }
            if hr >= 0 {
                break;
            }
        }
        if hr < 0 {
            return error.Unsupported;
        }
        d.back_buffer()!;
        return d;
    }

    fn back_buffer(self: *mut Device) !void {
        let mut tex: usize = 0;
        let gb = @bit_cast(fn(usize, u32, *u8, *mut usize) i32, method(self.swap, 9));  // GetBuffer
        if gb(self.swap, 0, &IID_TEXTURE2D[0], &mut tex) < 0 {
            return error.Failed;
        }
        self.back.tex = tex;
        self.back.rtv = self.view(tex)!;
    }

    fn view(self: *mut Device, tex: usize) !usize {
        let mut rtv: usize = 0;
        let f = @bit_cast(fn(usize, usize, *void, *mut usize) i32, method(self.dev, 9));  // CreateRenderTargetView
        if f(self.dev, tex, @ptr_from_int(*void, 0), &mut rtv) < 0 {
            return error.Failed;
        }
        return rtv;
    }

    pub fn deinit(self: *mut Device) void {
        if self.ctx != 0 {
            @bit_cast(fn(usize) void, method(self.ctx, 110))(self.ctx);  // ClearState
        }
        self.back.deinit();
        for k in @as(usize, 0)..3 {
            release_com(self.depth_states[k]);
            release_com(self.cull_states[k]);
            release_com(self.blend_states[k]);
        }
        release_com(self.samplers[0]);
        release_com(self.samplers[1]);
        self.depth_states = [0; 3];
        self.cull_states = [0; 3];
        self.blend_states = [0; 3];
        self.samplers = [0; 2];
        release_com(self.swap);
        release_com(self.ctx);
        release_com(self.dev);
        self.swap = 0;
        self.ctx = 0;
        self.dev = 0;
    }

    /// The window's back buffer (Device.init_window).
    pub fn screen(self: *Device) *Target {
        return &self.back;
    }

    /// After the window's client area changed size.
    pub fn resize(self: *mut Device, width: u32, height: u32) !void {
        if (self.swap == 0) or (width == 0) or (height == 0) {
            return;
        }
        @bit_cast(fn(usize, u32, *usize, usize) void, method(self.ctx, 33))(self.ctx, 0, @ptr_from_int(*usize, 0), 0);
        self.back.deinit();
        // ResizeBuffers(count 0: keep, width, height, format 0: keep, flags)
        let f = @bit_cast(fn(usize, u32, u32, u32, u32, u32) i32, method(self.swap, 13));
        if f(self.swap, 0, width, height, 0, 0) < 0 {
            return error.Failed;
        }
        self.back.width = width;
        self.back.height = height;
        self.back_buffer()!;
    }

    /// Shows the frame drawn into screen(); with vsync, at the display's
    /// next refresh.
    pub fn present(self: *mut Device, vsync: bool) !void {
        let mut sync: u32 = 0;
        if vsync {
            sync = 1;
        }
        if @bit_cast(fn(usize, u32, u32) i32, method(self.swap, 8))(self.swap, sync, 0) < 0 {
            return error.Failed;
        }
    }

    /// A texture of width × height RGBA pixels to draw into offscreen.
    pub fn target(self: *mut Device, width: u32, height: u32) !Target {
        let tex = self.texture2d(width, height, R8G8B8A8_UNORM, 0, BIND_RENDER_TARGET, 0, @ptr_from_int(*u64, 0))!;
        let rtv = self.view(tex) catch |e| {
            release_com(tex);
            return e;
        };
        return Target.{ tex: tex, rtv: rtv, width: width, height: height };
    }

    // usage: DEFAULT 0 or STAGING 3; init: a D3D11_SUBRESOURCE_DATA, or null
    fn texture2d(self: *mut Device, width: u32, height: u32, format: u32, usage: u32, bind: u32, cpu: u32,
                 init: *u64) !usize {
        // D3D11_TEXTURE2D_DESC: width, height, mips, array size, format,
        // samples (count, quality), usage, bind flags, CPU access, misc
        let desc: [11]u32 = [width, height, 1, 1, format, 1, 0, usage, bind, cpu, 0];
        let mut tex: usize = 0;
        let f = @bit_cast(fn(usize, *u32, *u64, *mut usize) i32, method(self.dev, 5));  // CreateTexture2D
        if f(self.dev, &desc[0], init, &mut tex) < 0 {
            return error.Failed;
        }
        return tex;
    }

    /// The pixels of a target, as an RGBA image (free it with deinit).
    pub fn read_pixels(self: *mut Device, t: *Target) !image.Image {
        let st = self.texture2d(t.width, t.height, R8G8B8A8_UNORM, 3, 0, 0x2_0000,  // STAGING, CPU_ACCESS_READ
                                @ptr_from_int(*u64, 0))!;
        defer release_com(st);
        @bit_cast(fn(usize, usize, usize) void, method(self.ctx, 47))(self.ctx, st, t.tex);  // CopyResource
        // D3D11_MAPPED_SUBRESOURCE: data, row pitch, depth pitch
        let mut m: [2]u64 = [0, 0];
        let map = @bit_cast(fn(usize, usize, u32, u32, u32, *mut u64) i32, method(self.ctx, 14));
        if map(self.ctx, st, 0, 1, 0, &mut m[0]) < 0 {  // D3D11_MAP_READ
            return error.Failed;
        }
        let w = @as(usize, t.width);
        let h = @as(usize, t.height);
        let mut img = image.Image.init(w, h, 4, image.Depth.U8) catch |e| {
            @bit_cast(fn(usize, usize, u32) void, method(self.ctx, 15))(self.ctx, st, 0);
            return e;
        };
        let pitch = @truncate(usize, m[1] & 0xffff_ffff);
        for y in 0..h {
            let row = @slice_from_ptr(@ptr_from_int(*u8, @truncate(usize, m[0]) + (y * pitch)), w * 4);
            @mem_copy(img.data[y * w * 4..(y + 1) * w * 4], row);
        }
        @bit_cast(fn(usize, usize, u32) void, method(self.ctx, 15))(self.ctx, st, 0);  // Unmap
        return img;
    }

    pub fn vertex_shader(self: *mut Device, code: *hlsl.Code) !VertexShader {
        let b = code.bytes();
        let mut p: usize = 0;
        let f = @bit_cast(fn(usize, *u8, usize, usize, *mut usize) i32, method(self.dev, 12));
        if f(self.dev, b.ptr, b.len, 0, &mut p) < 0 {
            return error.Failed;
        }
        return VertexShader.{ p: p };
    }

    pub fn pixel_shader(self: *mut Device, code: *hlsl.Code) !PixelShader {
        let b = code.bytes();
        let mut p: usize = 0;
        let f = @bit_cast(fn(usize, *u8, usize, usize, *mut usize) i32, method(self.dev, 15));
        if f(self.dev, b.ptr, b.len, 0, &mut p) < 0 {
            return error.Failed;
        }
        return PixelShader.{ p: p };
    }

    /// The vertex layout a vertex shader (its code) reads (at most 16 attributes).
    pub fn input_layout(self: *mut Device, attrs: []Attribute, vs_code: *hlsl.Code) !InputLayout {
        if attrs.len > 16 {
            return error.Failed;
        }
        // D3D11_INPUT_ELEMENT_DESC (32 bytes): name, index, format, slot,
        // offset, per-vertex, step rate; the names NUL-terminated here
        let mut descs: [512]u8 = [0; 512];
        let mut names: [16][64]u8 = [[0; 64]; 16];
        for k in 0..attrs.len {
            let a = attrs[k];
            if not cz(a.semantic, names[k][..]) {
                return error.Failed;
            }
            put(descs[..], k * 32, @as(u64, @int_from_ptr(&names[k][0])), 8);
            put(descs[..], (k * 32) + 8, @as(u64, a.index), 4);
            put(descs[..], (k * 32) + 12, @as(u64, a.format), 4);
            put(descs[..], (k * 32) + 20, @as(u64, a.offset), 4);
        }
        let b = vs_code.bytes();
        let mut p: usize = 0;
        let f = @bit_cast(fn(usize, *u8, u32, *u8, usize, *mut usize) i32, method(self.dev, 11));
        if f(self.dev, &descs[0], @truncate(u32, attrs.len), b.ptr, b.len, &mut p) < 0 {
            return error.Failed;
        }
        return InputLayout.{ p: p };
    }

    /// A buffer of `kind` (VERTEX, INDEX or CONSTANT) holding data. A
    /// constant buffer's size must be a multiple of 16; update it with
    /// update().
    pub fn buffer(self: *mut Device, kind: u32, data: []u8) !Buffer {
        // D3D11_BUFFER_DESC: size, usage (DEFAULT), bind, CPU access, misc, stride
        let desc: [6]u32 = [@truncate(u32, data.len), 0, kind, 0, 0, 0];
        // D3D11_SUBRESOURCE_DATA: the bytes, pitches
        let init: [2]u64 = [@as(u64, @int_from_ptr(data.ptr)), 0];
        let mut p: usize = 0;
        let f = @bit_cast(fn(usize, *u32, *u64, *mut usize) i32, method(self.dev, 3));  // CreateBuffer
        if f(self.dev, &desc[0], &init[0], &mut p) < 0 {
            return error.Failed;
        }
        return Buffer.{ p: p, size: @truncate(u32, data.len) };
    }

    /// Replaces a buffer's contents (all of it).
    pub fn update(self: *mut Device, b: *Buffer, data: []u8) void {
        let f = @bit_cast(fn(usize, usize, u32, *void, *u8, u32, u32) void, method(self.ctx, 48));
        f(self.ctx, b.p, 0, @ptr_from_int(*void, 0), data.ptr, 0, 0);  // UpdateSubresource
    }

    /// A texture holding img (converted to 8-bit RGBA), for shaders to read.
    pub fn texture(self: *mut Device, img: *image.Image) !Texture {
        if (img.channels == 4) and (img.depth == image.Depth.U8) {
            return self.texture_rgba(img);
        }
        let mut conv = img.convert(4, image.Depth.U8)!;
        defer conv.deinit();
        return self.texture_rgba(&conv);
    }

    fn texture_rgba(self: *mut Device, img: *image.Image) !Texture {
        let w = @truncate(u32, img.width);
        let h = @truncate(u32, img.height);
        // D3D11_SUBRESOURCE_DATA: the pixels, the row pitch
        let init: [2]u64 = [@as(u64, @int_from_ptr(img.data.ptr)), @as(u64, w) * 4];
        let tex = self.texture2d(w, h, R8G8B8A8_UNORM, 0, BIND_SHADER_RESOURCE, 0, &init[0])!;
        let srv = self.resource_view(tex) catch |e| {
            release_com(tex);
            return e;
        };
        return Texture.{ tex: tex, srv: srv, width: w, height: h };
    }

    fn resource_view(self: *mut Device, res: usize) !usize {
        let mut v: usize = 0;
        let f = @bit_cast(fn(usize, usize, *void, *mut usize) i32, method(self.dev, 7));  // CreateShaderResourceView
        if f(self.dev, res, @ptr_from_int(*void, 0), &mut v) < 0 {
            return error.Failed;
        }
        return v;
    }

    /// A depth buffer of width × height, for a target of that size.
    pub fn depth_buffer(self: *mut Device, width: u32, height: u32) !DepthBuffer {
        let tex = self.texture2d(width, height, D32_FLOAT, 0, BIND_DEPTH_STENCIL, 0, @ptr_from_int(*u64, 0))!;
        let mut dsv: usize = 0;
        let f = @bit_cast(fn(usize, usize, *void, *mut usize) i32, method(self.dev, 10));  // CreateDepthStencilView
        if f(self.dev, tex, @ptr_from_int(*void, 0), &mut dsv) < 0 {
            release_com(tex);
            return error.Failed;
        }
        return DepthBuffer.{ tex: tex, dsv: dsv, width: width, height: height };
    }

    /// Makes d width × height (after the window's size changed).
    pub fn resize_depth(self: *mut Device, d: *mut DepthBuffer, width: u32, height: u32) !void {
        if (width == 0) or (height == 0) or ((width == d.width) and (height == d.height)) {
            return;
        }
        @bit_cast(fn(usize, u32, *usize, usize) void, method(self.ctx, 33))(self.ctx, 0, @ptr_from_int(*usize, 0), 0);
        d.deinit();
        d.* = self.depth_buffer(width, height)!;
    }

    pub fn compute_shader(self: *mut Device, code: *hlsl.Code) !ComputeShader {
        let b = code.bytes();
        let mut p: usize = 0;
        let f = @bit_cast(fn(usize, *u8, usize, usize, *mut usize) i32, method(self.dev, 18));
        if f(self.dev, b.ptr, b.len, 0, &mut p) < 0 {
            return error.Failed;
        }
        return ComputeShader.{ p: p };
    }

    /// A storage buffer of elements of `stride` bytes (a multiple of 4)
    /// holding data (its length a multiple of stride).
    pub fn storage_buffer(self: *mut Device, data: []u8, stride: u32) !StorageBuffer {
        if (stride == 0) or ((stride % 4) != 0) or (data.len == 0) or ((data.len % @as(usize, stride)) != 0) {
            return error.Failed;
        }
        // D3D11_BUFFER_DESC: size, usage, bind, CPU access, misc (STRUCTURED), stride
        let desc: [6]u32 = [@truncate(u32, data.len), 0, BIND_SHADER_RESOURCE | BIND_UNORDERED_ACCESS, 0, 0x40, stride];
        let init: [2]u64 = [@as(u64, @int_from_ptr(data.ptr)), 0];
        let mut b = StorageBuffer.{ p: 0, srv: 0, uav: 0, size: @truncate(u32, data.len), stride: stride };
        let f = @bit_cast(fn(usize, *u32, *u64, *mut usize) i32, method(self.dev, 3));  // CreateBuffer
        if f(self.dev, &desc[0], &init[0], &mut b.p) < 0 {
            return error.Failed;
        }
        let uv = @bit_cast(fn(usize, usize, *void, *mut usize) i32, method(self.dev, 8));  // CreateUnorderedAccessView
        if uv(self.dev, b.p, @ptr_from_int(*void, 0), &mut b.uav) < 0 {
            b.deinit();
            return error.Failed;
        }
        b.srv = self.resource_view(b.p) catch |e| {
            b.deinit();
            return e;
        };
        return b;
    }

    /// Replaces a storage buffer's contents (all of it).
    pub fn write_buffer(self: *mut Device, b: *StorageBuffer, data: []u8) !void {
        if data.len != @as(usize, b.size) {
            return error.Failed;
        }
        let f = @bit_cast(fn(usize, usize, u32, *void, *u8, u32, u32) void, method(self.ctx, 48));
        f(self.ctx, b.p, 0, @ptr_from_int(*void, 0), data.ptr, 0, 0);  // UpdateSubresource
    }

    /// Copies a storage buffer's contents into out (as much as fits), when
    /// the GPU has finished writing them.
    pub fn read_buffer(self: *mut Device, b: *StorageBuffer, out: []mut u8) !void {
        self.unbind_storage();
        let desc: [6]u32 = [b.size, 3, 0, 0x2_0000, 0, 0];  // STAGING, CPU_ACCESS_READ
        let mut st: usize = 0;
        let f = @bit_cast(fn(usize, *u32, *void, *mut usize) i32, method(self.dev, 3));
        if f(self.dev, &desc[0], @ptr_from_int(*void, 0), &mut st) < 0 {
            return error.Failed;
        }
        defer release_com(st);
        @bit_cast(fn(usize, usize, usize) void, method(self.ctx, 47))(self.ctx, st, b.p);  // CopyResource
        let mut m: [2]u64 = [0, 0];
        let map = @bit_cast(fn(usize, usize, u32, u32, u32, *mut u64) i32, method(self.ctx, 14));
        if map(self.ctx, st, 0, 1, 0, &mut m[0]) < 0 {  // D3D11_MAP_READ
            return error.Failed;
        }
        let n = @min(out.len, @as(usize, b.size));
        @mem_copy(out[0..n], @slice_from_ptr(@ptr_from_int(*u8, @truncate(usize, m[0])), n));
        @bit_cast(fn(usize, usize, u32) void, method(self.ctx, 15))(self.ctx, st, 0);  // Unmap
    }

    // --- computing ---

    pub fn set_compute(self: *mut Device, cs: ComputeShader) void {
        @bit_cast(fn(usize, usize, usize, u32) void, method(self.ctx, 69))(self.ctx, cs.p, 0, 0);
    }

    /// Storage buffer u<slot> of compute shaders, to read and write.
    pub fn set_storage(self: *mut Device, slot: u32, b: *StorageBuffer) void {
        let views: [1]usize = [b.uav];
        let f = @bit_cast(fn(usize, u32, u32, *usize, *u32) void, method(self.ctx, 68));  // CSSetUnorderedAccessViews
        f(self.ctx, slot, 1, &views[0], @ptr_from_int(*u32, 0));
    }

    /// Storage buffer t<slot> of compute shaders, only read.
    pub fn set_compute_input(self: *mut Device, slot: u32, b: *StorageBuffer) void {
        let views: [1]usize = [b.srv];
        @bit_cast(fn(usize, u32, u32, *usize) void, method(self.ctx, 67))(self.ctx, slot, 1, &views[0]);
    }

    /// A constant buffer for compute shaders, at register b<slot>.
    pub fn set_compute_constants(self: *mut Device, slot: u32, b: *Buffer) void {
        let bufs: [1]usize = [b.p];
        @bit_cast(fn(usize, u32, u32, *usize) void, method(self.ctx, 71))(self.ctx, slot, 1, &bufs[0]);
    }

    /// Runs the compute shader on x × y × z groups of threads.
    pub fn dispatch(self: *mut Device, x: u32, y: u32, z: u32) void {
        @bit_cast(fn(usize, u32, u32, u32) void, method(self.ctx, 41))(self.ctx, x, y, z);
    }

    // Storage buffers stay bound to compute shaders after a dispatch, and
    // one bound for writing cannot be read elsewhere.
    fn unbind_storage(self: *mut Device) void {
        let none: [8]usize = [0; 8];
        let f = @bit_cast(fn(usize, u32, u32, *usize, *u32) void, method(self.ctx, 68));
        f(self.ctx, 0, 8, &none[0], @ptr_from_int(*u32, 0));
    }

    // --- drawing ---

    pub fn clear(self: *mut Device, t: *Target, r: f32, g: f32, b: f32, a: f32) void {
        let c: [4]f32 = [r, g, b, a];
        @bit_cast(fn(usize, usize, *f32) void, method(self.ctx, 50))(self.ctx, t.rtv, &c[0]);
    }

    /// Draws into t from now on, over all of it.
    pub fn set_target(self: *mut Device, t: *Target) void {
        self.bind_target(t, 0);
    }

    /// Draws into t from now on, testing depth against d (of t's size).
    pub fn set_target_depth(self: *mut Device, t: *Target, d: *DepthBuffer) void {
        self.bind_target(t, d.dsv);
    }

    fn bind_target(self: *mut Device, t: *Target, dsv: usize) void {
        let views: [1]usize = [t.rtv];
        @bit_cast(fn(usize, u32, *usize, usize) void, method(self.ctx, 33))(self.ctx, 1, &views[0], dsv);
        // D3D11_VIEWPORT: x, y, width, height, min depth, max depth
        let vp: [6]f32 = [0.0, 0.0, @float_from_int(f32, t.width), @float_from_int(f32, t.height), 0.0, 1.0];
        @bit_cast(fn(usize, u32, *f32) void, method(self.ctx, 44))(self.ctx, 1, &vp[0]);
    }

    /// Clears d to the far plane (depth 1).
    pub fn clear_depth(self: *mut Device, d: *DepthBuffer) void {
        @bit_cast(fn(usize, usize, u32, f32, u8) void, method(self.ctx, 53))(self.ctx, d.dsv, 1, 1.0, 0);
    }

    /// How depth is tested: DEPTH_OFF, DEPTH_TEST or DEPTH_WRITE (the default).
    pub fn set_depth(self: *mut Device, mode: u32) !void {
        let k = @as(usize, @min(mode, DEPTH_WRITE));
        if self.depth_states[k] == 0 {
            // D3D11_DEPTH_STENCIL_DESC: depth enable, write mask, function,
            // stencil enable, read and write masks, front and back faces' ops
            let mut d: [52]u8 = [0; 52];
            put(d[..], 0, u64_pick(mode != DEPTH_OFF, 1, 0), 4);
            put(d[..], 4, u64_pick(mode == DEPTH_WRITE, 1, 0), 4);
            put(d[..], 8, 2, 4);  // LESS
            d[16] = 0xff;
            d[17] = 0xff;
            for f in @as(usize, 0)..2 {
                let at = 20 + (f * 16);
                put(d[..], at, 1, 4);  // KEEP
                put(d[..], at + 4, 1, 4);
                put(d[..], at + 8, 1, 4);
                put(d[..], at + 12, 8, 4);  // ALWAYS
            }
            let f = @bit_cast(fn(usize, *u8, *mut usize) i32, method(self.dev, 21));  // CreateDepthStencilState
            if f(self.dev, &d[0], &mut self.depth_states[k]) < 0 {
                return error.Failed;
            }
        }
        @bit_cast(fn(usize, usize, u32) void, method(self.ctx, 36))(self.ctx, self.depth_states[k], 0);
    }

    /// Which faces are not drawn: CULL_NONE, CULL_FRONT or CULL_BACK. Front
    /// faces are counter-clockwise as seen, as in std/graphics/d3d12 (until
    /// set_cull, Direct3D's default culls back faces that are clockwise).
    pub fn set_cull(self: *mut Device, mode: u32) !void {
        if (mode < CULL_NONE) or (mode > CULL_BACK) {
            return error.Failed;
        }
        let k = @as(usize, mode - 1);
        if self.cull_states[k] == 0 {
            // D3D11_RASTERIZER_DESC: fill (solid), cull, front counter-clockwise,
            // depth bias, bias clamp, slope bias, depth clip, scissor, ...
            let d: [10]u32 = [3, mode, 1, 0, 0, 0, 1, 0, 0, 0];
            let f = @bit_cast(fn(usize, *u32, *mut usize) i32, method(self.dev, 22));  // CreateRasterizerState
            if f(self.dev, &d[0], &mut self.cull_states[k]) < 0 {
                return error.Failed;
            }
        }
        @bit_cast(fn(usize, usize) void, method(self.ctx, 43))(self.ctx, self.cull_states[k]);  // RSSetState
    }

    /// How what is drawn combines with what is there: BLEND_NONE (the
    /// default), BLEND_ALPHA or BLEND_ADD.
    pub fn set_blend(self: *mut Device, mode: u32) !void {
        let k = @as(usize, @min(mode, BLEND_ADD));
        if self.blend_states[k] == 0 {
            // D3D11_BLEND_DESC: alpha to coverage, independent blend, then
            // the first target's: enable, source, destination, operation,
            // (alpha: source, destination, operation), write mask
            let mut d: [264]u8 = [0; 264];
            let at: usize = 8;
            put(d[..], at, u64_pick(mode != BLEND_NONE, 1, 0), 4);
            put(d[..], at + 4, u64_pick(mode == BLEND_NONE, 2, 5), 4);  // ONE, or SRC_ALPHA
            put(d[..], at + 8, 1, 4);  // ZERO
            if mode == BLEND_ALPHA {
                put(d[..], at + 8, 6, 4);  // INV_SRC_ALPHA
            } else if mode == BLEND_ADD {
                put(d[..], at + 8, 2, 4);  // ONE
            }
            put(d[..], at + 12, 1, 4);  // ADD
            put(d[..], at + 16, 2, 4);  // alpha: ONE, ZERO
            put(d[..], at + 20, 1, 4);
            if mode == BLEND_ALPHA {
                put(d[..], at + 20, 6, 4);  // INV_SRC_ALPHA: opaque stays opaque
            } else if mode == BLEND_ADD {
                put(d[..], at + 16, 1, 4);  // ZERO, ONE: unchanged
                put(d[..], at + 20, 2, 4);
            }
            put(d[..], at + 24, 1, 4);  // ADD
            d[at + 28] = 0xf;
            let f = @bit_cast(fn(usize, *u8, *mut usize) i32, method(self.dev, 20));  // CreateBlendState
            if f(self.dev, &d[0], &mut self.blend_states[k]) < 0 {
                return error.Failed;
            }
        }
        let f = @bit_cast(fn(usize, usize, *f32, u32) void, method(self.ctx, 35));  // OMSetBlendState
        f(self.ctx, self.blend_states[k], @ptr_from_int(*f32, 0), 0xffff_ffff);
    }

    /// Texture t<slot> of both shaders, read through samplers s0 and s1.
    pub fn set_texture(self: *mut Device, slot: u32, t: *Texture) !void {
        self.set_view(slot, t.srv)!;
    }

    /// Storage buffer t<slot> of both shaders (a StructuredBuffer<T>): what a
    /// compute shader wrote, read by a vertex shader, say.
    pub fn set_vertex_storage(self: *mut Device, slot: u32, b: *StorageBuffer) !void {
        self.unbind_storage();
        self.set_view(slot, b.srv)!;
    }

    fn set_view(self: *mut Device, slot: u32, srv: usize) !void {
        if self.samplers[0] == 0 {
            // D3D11_SAMPLER_DESC: filter, address u, v, w, mip bias, anisotropy,
            // comparison, border colour, min and max LOD
            let mut d: [13]u32 = [0x15, 1, 1, 1, 0, 1, 1, 0, 0, 0, 0, 0, @bit_cast(u32, @as(f32, 3.4e38))];
            let f = @bit_cast(fn(usize, *u32, *mut usize) i32, method(self.dev, 23));  // CreateSamplerState
            if f(self.dev, &d[0], &mut self.samplers[0]) < 0 {
                return error.Failed;
            }
            d[0] = 0;  // MIN_MAG_MIP_POINT
            d[1] = 3;  // CLAMP
            d[2] = 3;
            d[3] = 3;
            if f(self.dev, &d[0], &mut self.samplers[1]) < 0 {
                return error.Failed;
            }
        }
        let views: [1]usize = [srv];
        let set = @bit_cast(fn(usize, u32, u32, *usize) void, method(self.ctx, 8));      // PSSetShaderResources
        let set_vs = @bit_cast(fn(usize, u32, u32, *usize) void, method(self.ctx, 25));  // VSSetShaderResources
        set(self.ctx, slot, 1, &views[0]);
        set_vs(self.ctx, slot, 1, &views[0]);
        @bit_cast(fn(usize, u32, u32, *usize) void, method(self.ctx, 10))(self.ctx, 0, 2, &self.samplers[0]);  // PSSetSamplers
        @bit_cast(fn(usize, u32, u32, *usize) void, method(self.ctx, 26))(self.ctx, 0, 2, &self.samplers[0]);  // VSSetSamplers
    }

    pub fn set_shaders(self: *mut Device, vs: VertexShader, ps: PixelShader) void {
        @bit_cast(fn(usize, usize, usize, u32) void, method(self.ctx, 11))(self.ctx, vs.p, 0, 0);
        @bit_cast(fn(usize, usize, usize, u32) void, method(self.ctx, 9))(self.ctx, ps.p, 0, 0);
    }

    /// The vertex layout (none: vertices are made in the shader from SV_VertexID).
    pub fn set_layout(self: *mut Device, l: InputLayout) void {
        @bit_cast(fn(usize, usize) void, method(self.ctx, 17))(self.ctx, l.p);
    }

    pub fn set_topology(self: *mut Device, t: u32) void {
        @bit_cast(fn(usize, u32) void, method(self.ctx, 24))(self.ctx, t);
    }

    /// The vertex buffer (slot 0), each vertex `stride` bytes.
    pub fn set_vertices(self: *mut Device, b: *Buffer, stride: u32) void {
        let bufs: [1]usize = [b.p];
        let strides: [1]u32 = [stride];
        let offsets: [1]u32 = [0];
        let f = @bit_cast(fn(usize, u32, u32, *usize, *u32, *u32) void, method(self.ctx, 18));
        f(self.ctx, 0, 1, &bufs[0], &strides[0], &offsets[0]);
    }

    /// The index buffer, of R16_UINT or R32_UINT indexes.
    pub fn set_indices(self: *mut Device, b: *Buffer, format: u32) void {
        @bit_cast(fn(usize, usize, u32, u32) void, method(self.ctx, 19))(self.ctx, b.p, format, 0);
    }

    /// A constant buffer for both shaders, at register b<slot>.
    pub fn set_constants(self: *mut Device, slot: u32, b: *Buffer) void {
        let bufs: [1]usize = [b.p];
        @bit_cast(fn(usize, u32, u32, *usize) void, method(self.ctx, 7))(self.ctx, slot, 1, &bufs[0]);
        @bit_cast(fn(usize, u32, u32, *usize) void, method(self.ctx, 16))(self.ctx, slot, 1, &bufs[0]);
    }

    pub fn draw(self: *mut Device, count: u32, first: u32) void {
        @bit_cast(fn(usize, u32, u32) void, method(self.ctx, 13))(self.ctx, count, first);
    }

    pub fn draw_indexed(self: *mut Device, count: u32, first: u32, base: i32) void {
        @bit_cast(fn(usize, u32, u32, i32) void, method(self.ctx, 12))(self.ctx, count, first, base);
    }
}

fn cz(s: []u8, out: []mut u8) bool {
    if (s.len + 1) > out.len {
        return false;
    }
    @mem_copy(out[0..s.len], s);
    out[s.len] = 0;
    return true;
}

fn u64_pick(c: bool, a: u64, b: u64) u64 {
    if c {
        return a;
    }
    return b;
}
