// =============================================================================
// std/graphics/d3d12.ax - Direct3D 12: a GPU device with one direct command
// queue, recorded frames, pipelines built from HLSL (std/graphics/hlsl), root
// signatures with 32-bit constants, buffers, render targets (a window's swap
// chain, or textures whose pixels can be read back), depth buffers.
//
//     let mut gpu = d3d12.Device.init_window(w.handle(), 800, 600)!;  // or Device.init() offscreen
//     defer gpu.deinit();
//     let rs = gpu.root_signature(4)!;                 // four constants at b0
//     let p = gpu.pipeline(&rs, &vs_code, &ps_code, attrs[..], d3d12.TRIANGLE_LIST, false)!;
//     loop {
//         let t = gpu.screen();
//         gpu.begin(t)!;
//         gpu.clear(t, 0.1, 0.1, 0.2, 1.0);
//         gpu.set_pipeline(&p);
//         gpu.set_constants(consts[..]);
//         gpu.set_vertices(&vb, 20);
//         gpu.draw(3, 0);
//         gpu.present(true)!;   // (Device.finish() for a texture)
//     }
//
// In 3D, a depth buffer the size of the target hides what is behind:
//
//     let mut z = gpu.depth_buffer(800, 600)!;          // gpu.resize_depth(&mut z, w, h) after a resize
//     let mut o = d3d12.PipelineOptions.defaults();
//     o.depth = d3d12.DEPTH_WRITE;
//     o.cull = d3d12.CULL_BACK;
//     let p = gpu.pipeline_with(&rs, &vs_code, &ps_code, attrs[..], o)!;
//     gpu.begin_depth(t, &mut z)!;
//     gpu.clear(t, 0.0, 0.0, 0.0, 1.0);
//     gpu.clear_depth(&z);
//
// Shadows: draw the scene from the light into a shadow map with a depth_only
// pipeline, then read it in the pixel shader (a Texture2D<float> at t0 with
// the comparison sampler s1). Larger per-frame data (lights, the light's
// matrix) goes in constant buffers:
//
//     let rs = gpu.root_signature_with(52, 1, 1)!;        // constants, b1, t0
//     let mut sm = gpu.shadow_map(4096)!;
//     let mut cb = gpu.constant_buffer(1024)!;
//     cb.write(bytes)!;
//     gpu.begin_shadow(&mut sm)!;
//     gpu.clear_depth(&sm);
//     gpu.set_pipeline(&shadow_pipeline);                 // depth_only, with depth bias
//     gpu.set_buffer(0, &cb);
//     ... draw ...
//     gpu.begin_depth(t, &mut z)!;
//     gpu.set_pipeline(&lit_pipeline);
//     gpu.set_buffer(0, &cb);
//     gpu.set_texture(0, &mut sm);
//     ... draw ...
//
// Images become textures that shaders read like a shadow map, through s0
// (linear, wrapping), with set_image; texture_mipmapped gives them mipmaps
// (made on the CPU, box-filtered), read trilinearly. Textures and storage
// buffers are made between frames (each upload is submitted and waited
// for).
//
//     let mut tex = gpu.texture(&img)!;
//     gpu.set_image(0, &tex);                              // t0
//
// Offscreen targets can hold other formats (TARGET_*: half floats for
// linear light beyond 1, HDR) and be drawn multisampled (target_with, with
// a depth buffer of as many samples, depth_buffer_with, and pipelines that
// say so, PipelineOptions.format and samples). A multisampled target is
// resolved when its pass ends (the next begin, begin_depth or begin_shadow,
// finish, present). Later passes read targets with set_target_texture,
// through s2 (linear, clamped): a scene drawn into an HDR target, then
// tone-mapped into the window.
//
//     let mut hdr = gpu.target_with(w, h, d3d12.TARGET_RGBA16F, 4)!;
//     let mut z = gpu.depth_buffer_with(w, h, 4)!;
//     gpu.begin_depth(&mut hdr, &mut z)!;                  // pipelines: format RGBA16F, 4 samples
//     ... draw ...
//     gpu.begin(gpu.screen())!;                            // (hdr is resolved)
//     gpu.set_target_texture(0, &mut hdr);                 // t0
//     gpu.draw(3, 0);
//
// Compute shaders work on storage buffers (RWStructuredBuffer<T> at u0, u1,
// ...), which can be read back or drawn as vertices, in a frame of their
// own or before the drawing in one:
//
//     let rs = gpu.compute_signature(1, 1)!;               // a constant at b0; u0
//     let cp = gpu.compute_pipeline(&rs, &cs_code)!;       // hlsl.compile(src, "main", "cs_5_0")
//     let mut b = gpu.storage_buffer(data)!;
//     gpu.set_compute_pipeline(&cp)!;
//     gpu.set_compute_constants(consts[..]);
//     gpu.set_storage(0, &mut b);
//     gpu.dispatch(n / 64, 1, 1);
//     gpu.finish()!;                                       // or begin(t), then set_storage_vertices(&mut b, 16) ...
//     gpu.read_buffer(&mut b, out)!;
//
// Front faces are counter-clockwise as seen, as in OpenGL: a mesh wound
// counter-clockwise seen from outside, in a right-handed world (std/math/
// geometry's look_at and perspective_zo), shows its outsides with CULL_BACK.
//
// Simplest correct use of the API, not the fastest: a frame is submitted
// and waited for before the next is recorded (one allocator, one list).
// Windows 10 or later only (--target=x86_64-windows). Without a GPU that can
// run Direct3D 12 the device is WARP's, in software.
// =============================================================================

import "../mem.ax" as mem;
import "../os/com.ax" as com;
import "color.ax" as color;
import "hlsl.ax" as hlsl;
import "image.ax" as image;

error { Unsupported, Failed, OutOfMemory }

extern "C" "d3d12" {
    fn D3D12CreateDevice(adapter: usize, level: u32, riid: *u8, dev: *mut usize) i32;
    fn D3D12SerializeRootSignature(desc: *u8, version: u32, blob: *mut usize, errors: *mut usize) i32;
}

extern "C" "d3d11" {
    fn D3D11On12CreateDevice(dev: usize, flags: u32, levels: *u32, nlevels: u32, queues: *usize, nqueues: u32,
                             node: u32, dev11: *mut usize, ctx: *mut usize, level: *mut u32) i32;
}

extern "C" "dxgi" {
    fn CreateDXGIFactory1(riid: *u8, factory: *mut usize) i32;
}

extern "C" "kernel32" {
    fn CreateEventW(sa: *void, manual: i32, initial: i32, name: *u16) usize;
    fn WaitForSingleObject(h: usize, ms: u32) u32;
    fn CloseHandle(h: usize) i32;
}

// DXGI formats
pub const R8G8B8A8_UNORM: u32 = 28;
pub const R32_FLOAT: u32 = 41;
pub const R32G32_FLOAT: u32 = 16;
pub const R32G32B32_FLOAT: u32 = 6;
pub const R32G32B32A32_FLOAT: u32 = 2;
pub const R16_UINT: u32 = 57;
pub const R32_UINT: u32 = 42;
const D32_FLOAT: u32 = 40;
const R32_TYPELESS: u32 = 39;
const R16G16B16A16_FLOAT: u32 = 10;
const R16G16_FLOAT: u32 = 34;
const R8G8B8A8_UNORM_SRGB: u32 = 29;

// What offscreen targets hold (target_with), as std/graphics/metal names them
pub const TARGET_BGRA8: u32 = 0;    // 8-bit colour, what a window shows (here RGBA)
pub const TARGET_RGBA16F: u32 = 1;  // half floats: linear light beyond 1 (HDR), for later passes to read
pub const TARGET_RG16F: u32 = 2;    // two half floats (velocities, moments)
pub const TARGET_R32F: u32 = 3;     // one float (depths, distances)

fn target_format(format: u32) u32 {
    if format == TARGET_RGBA16F {
        return R16G16B16A16_FLOAT;
    }
    if format == TARGET_RG16F {
        return R16G16_FLOAT;
    }
    if format == TARGET_R32F {
        return R32_FLOAT;
    }
    return R8G8B8A8_UNORM;
}

// Primitive topologies
pub const POINT_LIST: u32 = 1;
pub const LINE_LIST: u32 = 2;
pub const LINE_STRIP: u32 = 3;
pub const TRIANGLE_LIST: u32 = 4;
pub const TRIANGLE_STRIP: u32 = 5;

// Pipeline blending (PipelineOptions.blend)
pub const BLEND_NONE: u32 = 0;
pub const BLEND_ALPHA: u32 = 1;  // over what is there, by the source's alpha
pub const BLEND_ADD: u32 = 2;    // added to what is there, scaled by the source's alpha (glows)

// Pipeline depth (PipelineOptions.depth)
pub const DEPTH_NONE: u32 = 0;   // drawn without a depth buffer (begin)
pub const DEPTH_OFF: u32 = 1;    // with one bound (begin_depth), not tested or written
pub const DEPTH_TEST: u32 = 2;   // tested (nearer passes), not written: transparent things
pub const DEPTH_WRITE: u32 = 3;  // tested and written: solid things

// Pipeline culling (PipelineOptions.cull)
pub const CULL_NONE: u32 = 1;
pub const CULL_FRONT: u32 = 2;
pub const CULL_BACK: u32 = 3;

// Resource states
const PRESENT: u32 = 0;
const VERTEX_AND_CONSTANT_BUFFER: u32 = 0x1;
const RENDER_TARGET: u32 = 0x4;
const UNORDERED_ACCESS: u32 = 0x8;
const SHADER_RESOURCE: u32 = 0xc0;  // pixel and non-pixel shaders
const DEPTH_WRITE_STATE: u32 = 0x10;
const PIXEL_SHADER_RESOURCE: u32 = 0x80;
const COPY_DEST: u32 = 0x400;
const COPY_SOURCE: u32 = 0x800;
const RESOLVE_DEST: u32 = 0x1000;
const RESOLVE_SOURCE: u32 = 0x2000;
const GENERIC_READ: u32 = 0xac3;

const MAX_TARGETS: usize = 2048;  // render target views in the device's heap (2 the window's)
const MAX_DEPTHS: usize = 64;     // depth stencil views in the device's heap
const MAX_VIEWS: usize = 4096;    // shader resource views in the device's heap
const MAX_ROOT_BUFFERS: u32 = 4;
const MAX_ROOT_TEXTURES: u32 = 4;
const NO_SLOT: u32 = 0xffff_ffff;

// Which places in the device's heaps of views are taken. Things made by the
// device keep a pointer to it, and give their places back when released.
struct Slots {
    rtv: [MAX_TARGETS]u8,
    dsv: [MAX_DEPTHS]u8,
    srv: [MAX_VIEWS]u8,
}

// The first free place in `used`, now taken (NO_SLOT: none is free).
fn take(used: []mut u8) u32 {
    for k in 0..used.len {
        if used[k] == 0 {
            used[k] = 1;
            return @truncate(u32, k);
        }
    }
    return NO_SLOT;
}

fn give_back(used: []mut u8, slot: *mut u32) void {
    if (slot.* != NO_SLOT) and (@as(usize, slot.*) < used.len) {
        used[@as(usize, slot.*)] = 0;
    }
    slot.* = NO_SLOT;
}

fn no_slots() *mut Slots {
    return @ptr_from_int(*mut Slots, 0);
}

