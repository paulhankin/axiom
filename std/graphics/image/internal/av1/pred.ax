// =============================================================================
// std/graphics/image/internal/av1/pred.ax - AV1 intra prediction: edge preparation, DC, smooth,
// Paeth, directional (with edge filtering and upsampling), recursive filter,
// chroma-from-luma and palettes. Ported from dav1d (via rav1d); pixels are
// u16 at every bit depth.
// =============================================================================

import "tables.ax" as t;

// modes, as dav1d numbers them (the last few are only used internally)
pub const DC_PRED: u32 = 0;
pub const VERT_PRED: u32 = 1;
pub const HOR_PRED: u32 = 2;
pub const DIAG_DOWN_LEFT_PRED: u32 = 3;
pub const DIAG_DOWN_RIGHT_PRED: u32 = 4;
pub const VERT_RIGHT_PRED: u32 = 5;
pub const HOR_DOWN_PRED: u32 = 6;
pub const HOR_UP_PRED: u32 = 7;
pub const VERT_LEFT_PRED: u32 = 8;
pub const SMOOTH_PRED: u32 = 9;
pub const SMOOTH_V_PRED: u32 = 10;
pub const SMOOTH_H_PRED: u32 = 11;
pub const PAETH_PRED: u32 = 12;
pub const CFL_PRED: u32 = 13;
pub const FILTER_PRED: u32 = 13;
pub const LEFT_DC_PRED: u32 = 3;
pub const TOP_DC_PRED: u32 = 4;
pub const DC_128_PRED: u32 = 5;
pub const Z1_PRED: u32 = 6;
pub const Z2_PRED: u32 = 7;
pub const Z3_PRED: u32 = 8;

/// Edge availability flags
pub const TOP_HAS_RIGHT: u32 = 1;
pub const LEFT_HAS_BOTTOM: u32 = 8;

const NEED_LEFT: u32 = 1;
const NEED_TOP: u32 = 2;
const NEED_TOP_LEFT: u32 = 4;
const NEED_TOP_RIGHT: u32 = 8;
const NEED_BOTTOM_LEFT: u32 = 16;

// what each implemented mode reads
fn needs(mode: u32) u32 {
    if (mode == DC_PRED) or (mode == SMOOTH_PRED) or (mode == SMOOTH_V_PRED) or (mode == SMOOTH_H_PRED) {
        return NEED_TOP | NEED_LEFT;
    }
    if (mode == VERT_PRED) or (mode == TOP_DC_PRED) {
        return NEED_TOP;
    }
    if (mode == HOR_PRED) or (mode == LEFT_DC_PRED) {
        return NEED_LEFT;
    }
    if mode == DC_128_PRED {
        return 0;
    }
    if mode == Z1_PRED {
        return (NEED_TOP | NEED_TOP_RIGHT) | NEED_TOP_LEFT;
    }
    if mode == Z2_PRED {
        return (NEED_LEFT | NEED_TOP) | NEED_TOP_LEFT;
    }
    if mode == Z3_PRED {
        return (NEED_LEFT | NEED_BOTTOM_LEFT) | NEED_TOP_LEFT;
    }
    return (NEED_LEFT | NEED_TOP) | NEED_TOP_LEFT;  // Paeth, filter
}

let MODE_TO_ANGLE: [8]i32 = [90, 180, 45, 135, 113, 157, 203, 67];

/// The edge buffer: the top-left sample at EDGE_OFF, the left column below it
/// going down to lower indices, the top row after it.
pub const EDGE_LEN: usize = 257;
pub const EDGE_OFF: usize = 128;

/// A picture plane.
pub struct Plane {
    data: []mut u16,
    stride: usize,
}

/// Fills edge[] for a block at (x, y) in 4x4 units, in a tile (or area) that
/// ends at (w, h); returns the mode to predict with (and updates angle).
pub fn prepare_edges(p: *Plane, x: i32, have_left: bool, y: i32, have_top: bool, w: i32, h: i32, edge_flags: u32,
                     mode0: u32, angle: *mut i32, tw: i32, th: i32, edge_filter: bool, edge: []mut u16,
                     bitdepth: u32) u32 {
    let mut mode = mode0;
    let stride = p.stride;
    let dst = (@as(usize, @bit_cast(u32, y)) * 4 * stride) + (@as(usize, @bit_cast(u32, x)) * 4);
    let d = p.data;
    if (mode >= VERT_PRED) and (mode <= VERT_LEFT_PRED) {
        angle.* = MODE_TO_ANGLE[@as(usize, mode - VERT_PRED)] + (3 * angle.*);
        if angle.* <= 90 {
            mode = VERT_PRED;
            if (angle.* < 90) and have_top {
                mode = Z1_PRED;
            }
        } else if angle.* < 180 {
            mode = Z2_PRED;
        } else {
            mode = HOR_PRED;
            if (angle.* > 180) and have_left {
                mode = Z3_PRED;
            }
        }
    } else if (mode == DC_PRED) or (mode == PAETH_PRED) {
        if not have_left {
            if not have_top {
                mode = DC_128_PRED;
            } else if mode == DC_PRED {
                mode = TOP_DC_PRED;
            } else {
                mode = VERT_PRED;
            }
        } else if not have_top {
            if mode == DC_PRED {
                mode = LEFT_DC_PRED;
            } else {
                mode = HOR_PRED;
            }
        }
    }
    let nd = needs(mode);
    // the row above (from x - 1 when there is a left)
    let mut top_start: usize = 0;
    let use_top = have_top and
                  (((nd & NEED_TOP) != 0) or ((nd & NEED_TOP_LEFT) != 0) or
                   (((nd & NEED_LEFT) != 0) and not have_left));
    if use_top {
        top_start = dst - stride;
        if have_left {
            top_start -= 1;
        }
    }
    let mut hl: usize = 0;
    if have_left {
        hl = 1;
    }
    let mid = @as(u16, @truncate(u16, (@as(u32, 1) << bitdepth) >> 1));
    if (nd & NEED_LEFT) != 0 {
        let sz = 4 * @as(usize, @bit_cast(u32, th));
        let base = EDGE_OFF - sz;
        if have_left {
            let px_have = @min(sz, @as(usize, @bit_cast(u32, (h - y) << 2)));
            for i in @as(usize, 0)..px_have {
                edge[base + (sz - 1) - i] = d[(dst + (i * stride)) - 1];
            }
            if px_have < sz {
                let v = edge[base + (sz - px_have)];
                for i in @as(usize, 0)..(sz - px_have) {
                    edge[base + i] = v;
                }
            }
        } else {
            let mut v = mid + 1;
            if have_top {
                v = d[top_start];
            }
            for i in @as(usize, 0)..sz {
                edge[base + i] = v;
            }
        }
        if (nd & NEED_BOTTOM_LEFT) != 0 {
            let bl = EDGE_OFF - (2 * sz);
            let have_bl = have_left and ((y + th) < h) and ((edge_flags & LEFT_HAS_BOTTOM) != 0);
            if have_bl {
                let px_have = @min(sz, @as(usize, @bit_cast(u32, ((h - y) - th) << 2)));
                for i in @as(usize, 0)..px_have {
                    edge[bl + (sz - 1) - i] = d[(dst + ((sz + i) * stride)) - 1];
                }
                if px_have < sz {
                    let v = edge[bl + (sz - px_have)];
                    for i in @as(usize, 0)..(sz - px_have) {
                        edge[bl + i] = v;
                    }
                }
            } else {
                let v = edge[bl + sz];
                for i in @as(usize, 0)..sz {
                    edge[bl + i] = v;
                }
            }
        }
    }
    if (nd & NEED_TOP) != 0 {
        let sz = 4 * @as(usize, @bit_cast(u32, tw));
        let top = EDGE_OFF + 1;
        if have_top {
            let px_have = @min(sz, @as(usize, @bit_cast(u32, (w - x) << 2)));
            for i in @as(usize, 0)..px_have {
                edge[top + i] = d[top_start + hl + i];
            }
            if px_have < sz {
                let v = edge[(top + px_have) - 1];
                for i in px_have..sz {
                    edge[top + i] = v;
                }
            }
        } else {
            let mut v = mid - 1;
            if have_left {
                v = d[dst - 1];
            }
            for i in @as(usize, 0)..sz {
                edge[top + i] = v;
            }
        }
        if (nd & NEED_TOP_RIGHT) != 0 {
            let have_tr = have_top and ((x + tw) < w) and ((edge_flags & TOP_HAS_RIGHT) != 0);
            if have_tr {
                let px_have = @min(sz, @as(usize, @bit_cast(u32, ((w - x) - tw) << 2)));
                for i in @as(usize, 0)..px_have {
                    edge[top + sz + i] = d[top_start + sz + hl + i];
                }
                if px_have < sz {
                    let v = edge[((top + sz) + px_have) - 1];
                    for i in px_have..sz {
                        edge[top + sz + i] = v;
                    }
                }
            } else {
                let v = edge[(top + sz) - 1];
                for i in @as(usize, 0)..sz {
                    edge[top + sz + i] = v;
                }
            }
        }
    }
    if (nd & NEED_TOP_LEFT) != 0 {
        if have_top {
            edge[EDGE_OFF] = d[top_start];
        } else if have_left {
            edge[EDGE_OFF] = d[dst - 1];
        } else {
            edge[EDGE_OFF] = mid;
        }
        if (mode == Z2_PRED) and ((tw + th) >= 6) and edge_filter {
            let v = (
                ((@as(i32, edge[EDGE_OFF - 1]) + @as(i32, edge[EDGE_OFF + 1])) * 5) + (
                    @as(i32, edge[EDGE_OFF]) * 6)) + 8;
            edge[EDGE_OFF] = @truncate(u16, @bit_cast(u32, v >> 4));
        }
    }
    return mode;
}

fn ctz(v: u32) u32 {
    return @ctz(v);
}

fn dc_value(edge: []u16, mode: u32, w: u32, h: u32, bitdepth: u32) u32 {
    if mode == DC_128_PRED {
        return @as(u32, 1) << (bitdepth - 1);
    }
    if mode == TOP_DC_PRED {
        let mut dc = w >> 1;
        for i in @as(usize, 0)..@as(usize, w) {
            dc += @as(u32, edge[EDGE_OFF + 1 + i]);
        }
        return dc >> ctz(w);
    }
    if mode == LEFT_DC_PRED {
        let mut dc = h >> 1;
        for i in @as(usize, 0)..@as(usize, h) {
            dc += @as(u32, edge[EDGE_OFF - (1 + i)]);
        }
        return dc >> ctz(h);
    }
    let mut dc = (w + h) >> 1;
    for i in @as(usize, 0)..@as(usize, w) {
        dc += @as(u32, edge[EDGE_OFF + 1 + i]);
    }
    for i in @as(usize, 0)..@as(usize, h) {
        dc += @as(u32, edge[EDGE_OFF - (1 + i)]);
    }
    dc >>= ctz(w + h);
    if w != h {
        let four = (w > (h * 2)) or (h > (w * 2));
        if bitdepth == 8 {
            if four {
                dc *= 0x3334;
            } else {
                dc *= 0x5556;
            }
            dc >>= 16;
        } else {
            if four {
                dc = @truncate(u32, (@as(u64, dc) * 0x6667) >> 17);
            } else {
                dc = @truncate(u32, (@as(u64, dc) * 0xaaab) >> 17);
            }
        }
    }
    return dc;
}

fn clip_px(v: i32, max: i32) u16 {
    if v < 0 {
        return 0;
    }
    if v > max {
        return @truncate(u16, @bit_cast(u32, max));
    }
    return @truncate(u16, @bit_cast(u32, v));
}

/// Predicts a w x h block at data[dst..] with a (converted) mode.
pub fn predict(p: *Plane, dst: usize, edge: []mut u16, mode: u32, w: u32, h: u32, angle_flags: i32, max_w: i32,
               max_h: i32, bitdepth: u32) void {
    let d = p.data;
    let stride = p.stride;
    let wu = @as(usize, w);
    let hu = @as(usize, h);
    let maxv = @bit_cast(i32, (@as(u32, 1) << bitdepth) - 1);
    if (mode == DC_PRED) or (mode == TOP_DC_PRED) or (mode == LEFT_DC_PRED) or (mode == DC_128_PRED) {
        let dc = @truncate(u16, dc_value(edge, mode, w, h, bitdepth));
        for y in @as(usize, 0)..hu {
            for x in @as(usize, 0)..wu {
                d[dst + (y * stride) + x] = dc;
            }
        }
    } else if mode == VERT_PRED {
        for y in @as(usize, 0)..hu {
            for x in @as(usize, 0)..wu {
                d[dst + (y * stride) + x] = edge[EDGE_OFF + 1 + x];
            }
        }
    } else if mode == HOR_PRED {
        for y in @as(usize, 0)..hu {
            let v = edge[EDGE_OFF - (1 + y)];
            for x in @as(usize, 0)..wu {
                d[dst + (y * stride) + x] = v;
            }
        }
    } else if mode == PAETH_PRED {
        let tl = @as(i32, edge[EDGE_OFF]);
        for y in @as(usize, 0)..hu {
            let left = @as(i32, edge[EDGE_OFF - (y + 1)]);
            for x in @as(usize, 0)..wu {
                let top = @as(i32, edge[EDGE_OFF + 1 + x]);
                let base = (left + top) - tl;
                let ld = @abs(left - base);
                let td = @abs(top - base);
                let tld = @abs(tl - base);
                let mut v = tl;
                if (ld <= td) and (ld <= tld) {
                    v = left;
                } else if td <= tld {
                    v = top;
                }
                d[dst + (y * stride) + x] = @truncate(u16, @bit_cast(u32, v));
            }
        }
    } else if (mode == SMOOTH_PRED) or (mode == SMOOTH_V_PRED) or (mode == SMOOTH_H_PRED) {
        let right = @as(i32, edge[EDGE_OFF + wu]);
        let bottom = @as(i32, edge[EDGE_OFF - hu]);
        for y in @as(usize, 0)..hu {
            let wv = @as(i32, t.SM_WEIGHTS[hu + y]);
            let left = @as(i32, edge[EDGE_OFF - (1 + y)]);
            for x in @as(usize, 0)..wu {
                let wh = @as(i32, t.SM_WEIGHTS[wu + x]);
                let top = @as(i32, edge[EDGE_OFF + 1 + x]);
                let mut v: i32 = 0;
                if mode == SMOOTH_PRED {
                    v = (((((wv * top) + ((256 - wv) * bottom)) + (wh * left)) + ((256 - wh) * right)) + 256) >> 9;
                } else if mode == SMOOTH_V_PRED {
                    v = (((wv * top) + ((256 - wv) * bottom)) + 128) >> 8;
                } else {
                    v = (((wh * left) + ((256 - wh) * right)) + 128) >> 8;
                }
                d[dst + (y * stride) + x] = @truncate(u16, @bit_cast(u32, v));
            }
        }
    } else if mode == Z1_PRED {
        z1(d, dst, stride, edge, @bit_cast(i32, w), @bit_cast(i32, h), angle_flags, maxv);
    } else if mode == Z2_PRED {
        z2(d, dst, stride, edge, @bit_cast(i32, w), @bit_cast(i32, h), angle_flags, max_w, max_h, maxv);
    } else if mode == Z3_PRED {
        z3(d, dst, stride, edge, @bit_cast(i32, w), @bit_cast(i32, h), angle_flags, maxv);
    } else {
        filter_pred(d, dst, stride, edge, wu, hu, @bit_cast(u32, angle_flags) & 511, maxv);
    }
}

fn filter_strength(wh: i32, angle: i32, is_sm: bool) i32 {
    if is_sm {
        if wh <= 8 {
            if angle >= 64 {
                return 2;
            }
            if angle >= 40 {
                return 1;
            }
            return 0;
        }
        if wh <= 16 {
            if angle >= 48 {
                return 2;
            }
            if angle >= 20 {
                return 1;
            }
            return 0;
        }
        if wh <= 24 {
            if angle >= 4 {
                return 3;
            }
            return 0;
        }
        return 3;
    }
    if wh <= 8 {
        if angle >= 56 {
            return 1;
        }
        return 0;
    }
    if wh <= 16 {
        if angle >= 40 {
            return 1;
        }
        return 0;
    }
    if wh <= 24 {
        if angle >= 32 {
            return 3;
        }
        if angle >= 16 {
            return 2;
        }
        if angle >= 8 {
            return 1;
        }
        return 0;
    }
    if wh <= 32 {
        if angle >= 32 {
            return 3;
        }
        if angle >= 4 {
            return 2;
        }
        return 1;
    }
    return 3;
}

fn iclip(v: i32, lo: i32, hi: i32) i32 {
    if v < lo {
        return lo;
    }
    if v > hi {
        return hi;
    }
    return v;
}

let KERNEL: [15]i32 = [0, 4, 8, 4, 0, 0, 5, 6, 5, 0, 2, 4, 4, 4, 2];

// in[] read at in_off + i for i clipped to [from, to - 1] (i may be negative)
fn at(e: []u16, in_off: usize, i: i32) i32 {
    if i < 0 {
        return @as(i32, e[in_off - @as(usize, @bit_cast(u32, -i))]);
    }
    return @as(i32, e[in_off + @as(usize, @bit_cast(u32, i))]);
}

fn filter_edge(out: []mut u16, sz: i32, lim_from: i32, lim_to: i32, e: []u16, in_off: usize, from: i32, to: i32,
               strength: i32) void {
    let mut i: i32 = 0;
    while i < @min(sz, lim_from) {
        out[@as(usize, @bit_cast(u32, i))] = @truncate(u16, @bit_cast(u32, at(e, in_off, iclip(i, from, to - 1))));
        i += 1;
    }
    while i < @min(lim_to, sz) {
        let mut s: i32 = 0;
        for j in @as(i32, 0)..5 {
            s += at(e, in_off, iclip((i - 2) + j, from, to - 1)) * KERNEL[
                (@as(usize, @bit_cast(u32, strength - 1)) * 5) + @as(usize, @bit_cast(u32, j))];
        }
        out[@as(usize, @bit_cast(u32, i))] = @truncate(u16, @bit_cast(u32, (s + 8) >> 4));
        i += 1;
    }
    while i < sz {
        out[@as(usize, @bit_cast(u32, i))] = @truncate(u16, @bit_cast(u32, at(e, in_off, iclip(i, from, to - 1))));
        i += 1;
    }
}

fn get_upsample(wh: i32, angle: i32, is_sm: bool) bool {
    let mut lim: i32 = 16;
    if is_sm {
        lim = 8;
    }
    return (angle < 40) and (wh <= lim);
}

fn upsample_edge(out: []mut u16, hsz: i32, e: []u16, in_off: usize, from: i32, to: i32, maxv: i32) void {
    let kernel: [4]i32 = [-1, 9, 9, -1];
    let mut i: i32 = 0;
    while i < (hsz - 1) {
        out[@as(usize, @bit_cast(u32, i * 2))] = @truncate(u16, @bit_cast(u32, at(e, in_off, iclip(i, from, to - 1))));
        let mut s: i32 = 0;
        for j in @as(i32, 0)..4 {
            s += at(e, in_off, iclip((i + j) - 1, from, to - 1)) * kernel[@as(usize, @bit_cast(u32, j))];
        }
        out[@as(usize, @bit_cast(u32, (i * 2) + 1))] = @truncate(u16, @bit_cast(u32, iclip((s + 8) >> 4, 0, maxv)));
        i += 1;
    }
    out[@as(usize, @bit_cast(u32, i * 2))] = @truncate(u16, @bit_cast(u32, at(e, in_off, iclip(i, from, to - 1))));
}

fn z1(d: []mut u16, dst: usize, stride: usize, e: []u16, width: i32, height: i32, angle0: i32, maxv: i32) void {
    let is_sm = ((angle0 >> 9) & 1) != 0;
    let filt = (angle0 >> 10) != 0;
    let angle = angle0 & 511;
    let mut dx = @as(i32, t.DR_INTRA_DERIVATIVE[@as(usize, @bit_cast(u32, angle >> 1))]);
    let mut top_out: [128]u16 = [0; 128];
    let mut upsample = false;
    if filt {
        upsample = get_upsample(width + height, 90 - angle, is_sm);
    }
    let mut use_out = false;
    let mut max_base_x: i32 = 0;
    if upsample {
        upsample_edge(top_out[..], width + height, e, EDGE_OFF + 1, -1, width + @min(width, height), maxv);
        dx <<= 1;
        use_out = true;
        max_base_x = (2 * (width + height)) - 2;
    } else {
        let mut strength: i32 = 0;
        if filt {
            strength = filter_strength(width + height, 90 - angle, is_sm);
        }
        if strength != 0 {
            filter_edge(top_out[..], width + height, 0, width + height, e, EDGE_OFF + 1, -1,
                        width + @min(width, height), strength);
            use_out = true;
            max_base_x = (width + height) - 1;
        } else {
            max_base_x = (width + @min(width, height)) - 1;
        }
    }
    let mut base_inc: i32 = 1;
    if upsample {
        base_inc = 2;
    }
    for y in @as(i32, 0)..height {
        let xpos = (y + 1) * dx;
        let frac = xpos & 0x3e;
        let row = dst + (@as(usize, @bit_cast(u32, y)) * stride);
        let mut x: i32 = 0;
        while x < width {
            let base = (xpos >> 6) + (base_inc * x);
            if base < max_base_x {
                let mut a: i32 = 0;
                let mut b: i32 = 0;
                if use_out {
                    a = @as(i32, top_out[@as(usize, @bit_cast(u32, base))]);
                    b = @as(i32, top_out[@as(usize, @bit_cast(u32, base + 1))]);
                } else {
                    a = @as(i32, e[EDGE_OFF + 1 + @as(usize, @bit_cast(u32, base))]);
                    b = @as(i32, e[EDGE_OFF + 2 + @as(usize, @bit_cast(u32, base))]);
                }
                d[row + @as(usize, @bit_cast(u32, x))] = @truncate(
                    u16, @bit_cast(u32, (((a * (64 - frac)) + (b * frac)) + 32) >> 6));
                x += 1;
            } else {
                let mut v: u16 = 0;
                if use_out {
                    v = top_out[@as(usize, @bit_cast(u32, max_base_x))];
                } else {
                    v = e[EDGE_OFF + 1 + @as(usize, @bit_cast(u32, max_base_x))];
                }
                while x < width {
                    d[row + @as(usize, @bit_cast(u32, x))] = v;
                    x += 1;
                }
            }
        }
    }
}

fn z2(d: []mut u16, dst: usize, stride: usize, e: []u16, width: i32, height: i32, angle0: i32, max_width: i32,
      max_height: i32, maxv: i32) void {
    let is_sm = ((angle0 >> 9) & 1) != 0;
    let filt = (angle0 >> 10) != 0;
    let angle = angle0 & 511;
    let mut dy = @as(i32, t.DR_INTRA_DERIVATIVE[@as(usize, @bit_cast(u32, (angle - 90) >> 1))]);
    let mut dx = @as(i32, t.DR_INTRA_DERIVATIVE[@as(usize, @bit_cast(u32, (180 - angle) >> 1))]);
    let mut up_left = false;
    let mut up_above = false;
    if filt {
        up_left = get_upsample(width + height, 180 - angle, is_sm);
        up_above = get_upsample(width + height, angle - 90, is_sm);
    }
    let mut edge: [129]u16 = [0; 129];
    let tl: usize = 64;
    let wu = @as(usize, @bit_cast(u32, width));
    let hu = @as(usize, @bit_cast(u32, height));
    if up_above {
        upsample_edge(edge[tl..], width + 1, e, EDGE_OFF, 0, width + 1, maxv);
        dx <<= 1;
    } else {
        let mut strength: i32 = 0;
        if filt {
            strength = filter_strength(width + height, angle - 90, is_sm);
        }
        if strength != 0 {
            filter_edge(edge[tl + 1..], width, 0, max_width, e, EDGE_OFF + 1, -1, width, strength);
        } else {
            for i in @as(usize, 0)..wu {
                edge[tl + 1 + i] = e[EDGE_OFF + 1 + i];
            }
        }
    }
    if up_left {
        upsample_edge(edge[tl - (hu * 2)..], height + 1, e, EDGE_OFF - hu, 0, height + 1, maxv);
        dy <<= 1;
    } else {
        let mut strength: i32 = 0;
        if filt {
            strength = filter_strength(width + height, 180 - angle, is_sm);
        }
        if strength != 0 {
            filter_edge(edge[tl - hu..], height, height - max_height, height, e, EDGE_OFF - hu, 0, height + 1,
                        strength);
        } else {
            for i in @as(usize, 0)..hu {
                edge[(tl - hu) + i] = e[(EDGE_OFF - hu) + i];
            }
        }
    }
    edge[tl] = e[EDGE_OFF];
    let mut base_inc_x: i32 = 1;
    if up_above {
        base_inc_x = 2;
    }
    let mut ul: i32 = 0;
    if up_left {
        ul = 1;
    }
    let mut ua: i32 = 0;
    if up_above {
        ua = 1;
    }
    let left = @bit_cast(i32, @truncate(u32, tl)) - (1 + ul);
    for y in @as(i32, 0)..height {
        let xpos = ((1 + ua) << 6) - (dx * (y + 1));
        let bx = xpos >> 6;
        let frac_x = xpos & 0x3e;
        let row = dst + (@as(usize, @bit_cast(u32, y)) * stride);
        for x in @as(i32, 0)..width {
            let ypos = (y << @bit_cast(u32, 6 + ul)) - (dy * (x + 1));
            let base_x = bx + (base_inc_x * x);
            let mut v: i32 = 0;
            if base_x >= 0 {
                let i = tl + @as(usize, @bit_cast(u32, base_x));
                v = (@as(i32, edge[i]) * (64 - frac_x)) + (@as(i32, edge[i + 1]) * frac_x);
            } else {
                let base_y = ypos >> 6;
                let frac_y = ypos & 0x3e;
                let i0 = @as(usize, @bit_cast(u32, left - base_y));
                let i1 = @as(usize, @bit_cast(u32, left - (base_y + 1)));
                v = (@as(i32, edge[i0]) * (64 - frac_y)) + (@as(i32, edge[i1]) * frac_y);
            }
            d[row + @as(usize, @bit_cast(u32, x))] = @truncate(u16, @bit_cast(u32, (v + 32) >> 6));
        }
    }
}

fn z3(d: []mut u16, dst: usize, stride: usize, e: []u16, width: i32, height: i32, angle0: i32, maxv: i32) void {
    let is_sm = ((angle0 >> 9) & 1) != 0;
    let filt = (angle0 >> 10) != 0;
    let angle = angle0 & 511;
    let mut dy = @as(i32, t.DR_INTRA_DERIVATIVE[@as(usize, @bit_cast(u32, (270 - angle) >> 1))]);
    let mut left_out: [128]u16 = [0; 128];
    let mut upsample = false;
    if filt {
        upsample = get_upsample(width + height, angle - 180, is_sm);
    }
    let wh = @as(usize, @bit_cast(u32, width + height));
    // the left edge, read at left_off - k
    let mut use_out = false;
    let mut left_off: usize = 0;
    let mut max_base_y: i32 = 0;
    if upsample {
        upsample_edge(left_out[..], width + height, e, EDGE_OFF - wh, @max(width - height, 0), width + height + 1,
                      maxv);
        use_out = true;
        left_off = (2 * wh) - 2;
        max_base_y = (2 * (width + height)) - 2;
        dy <<= 1;
    } else {
        let mut strength: i32 = 0;
        if filt {
            strength = filter_strength(width + height, angle - 180, is_sm);
        }
        if strength != 0 {
            filter_edge(left_out[..], width + height, 0, width + height, e, EDGE_OFF - wh, @max(width - height, 0),
                        width + height + 1, strength);
            use_out = true;
            left_off = wh - 1;
            max_base_y = (width + height) - 1;
        } else {
            left_off = EDGE_OFF - 1;
            max_base_y = (height + @min(width, height)) - 1;
        }
    }
    let mut base_inc: i32 = 1;
    if upsample {
        base_inc = 2;
    }
    for x in @as(i32, 0)..width {
        let ypos = dy * (x + 1);
        let frac = ypos & 0x3e;
        let mut y: i32 = 0;
        while y < height {
            let base = (ypos >> 6) + (base_inc * y);
            let pos = dst + (@as(usize, @bit_cast(u32, y)) * stride) + @as(usize, @bit_cast(u32, x));
            if base < max_base_y {
                let bu = @as(usize, @bit_cast(u32, base));
                let mut a: i32 = 0;
                let mut b: i32 = 0;
                if use_out {
                    a = @as(i32, left_out[left_off - bu]);
                    b = @as(i32, left_out[left_off - (bu + 1)]);
                } else {
                    a = @as(i32, e[left_off - bu]);
                    b = @as(i32, e[left_off - (bu + 1)]);
                }
                d[pos] = @truncate(u16, @bit_cast(u32, (((a * (64 - frac)) + (b * frac)) + 32) >> 6));
                y += 1;
            } else {
                let mb = @as(usize, @bit_cast(u32, max_base_y));
                let mut v: u16 = 0;
                if use_out {
                    v = left_out[left_off - mb];
                } else {
                    v = e[left_off - mb];
                }
                while y < height {
                    d[dst + (@as(usize, @bit_cast(u32, y)) * stride) + @as(usize, @bit_cast(u32, x))] = v;
                    y += 1;
                }
            }
        }
    }
}

// the recursive filter: 4x2 blocks, each from its 7 neighbours
fn filter_pred(d: []mut u16, dst: usize, stride: usize, e: []u16, width: usize, height: usize, filt: u32,
               maxv: i32) void {
    let taps = @as(usize, filt) * 56;
    let mut y: usize = 0;
    while y < height {
        let row = dst + (y * stride);
        let mut topleft = @as(i32, e[EDGE_OFF - y]);
        let mut x: usize = 0;
        while x < width {
            let mut p: [7]i32 = [0; 7];
            p[0] = topleft;
            for k in @as(usize, 0)..4 {
                if y == 0 {
                    p[1 + k] = @as(i32, e[EDGE_OFF + 1 + x + k]);
                } else {
                    p[1 + k] = @as(i32, d[((row - stride) + x) + k]);
                }
            }
            if x == 0 {
                p[5] = @as(i32, e[EDGE_OFF - (y + 1)]);
                p[6] = @as(i32, e[EDGE_OFF - (y + 2)]);
            } else {
                p[5] = @as(i32, d[(row + x) - 1]);
                p[6] = @as(i32, d[((row + stride) + x) - 1]);
            }
            for yy in @as(usize, 0)..2 {
                for xx in @as(usize, 0)..4 {
                    let o = taps + (((yy * 4) + xx) * 7);
                    let mut acc: i32 = 0;
                    for i in @as(usize, 0)..7 {
                        acc += t.FILTER_INTRA_TAPS[o + i] * p[i];
                    }
                    d[row + (yy * stride) + x + xx] = clip_px((acc + 8) >> 4, maxv);
                }
            }
            topleft = p[4];
            x += 4;
        }
        y += 2;
    }
}

/// Chroma from luma: dc (from the mode) plus alpha times the luma AC.
pub fn cfl_pred(p: *Plane, dst: usize, edge: []u16, mode: u32, w: u32, h: u32, ac: []i32, alpha: i32,
                bitdepth: u32) void {
    let dc = @bit_cast(i32, dc_value(edge, mode, w, h, bitdepth));
    let maxv = @bit_cast(i32, (@as(u32, 1) << bitdepth) - 1);
    let wu = @as(usize, w);
    for y in @as(usize, 0)..@as(usize, h) {
        for x in @as(usize, 0)..wu {
            let diff = alpha * ac[(y * wu) + x];
            let mut m = (@abs(diff) + 32) >> 6;
            if diff < 0 {
                m = -m;
            }
            p.data[dst + (y * p.stride) + x] = clip_px(dc + m, maxv);
        }
    }
}

/// The luma AC for chroma from luma: subsampled, padded, mean removed.
pub fn cfl_ac(ac: []mut i32, luma: *Plane, src: usize, w_pad: u32, h_pad: u32, width: usize, height: usize,
              ss_hor: bool, ss_ver: bool) void {
    let wp = @as(usize, w_pad) * 4;
    let hp = @as(usize, h_pad) * 4;
    let ls = luma.stride;
    let d = luma.data;
    let mut shift: u32 = 1;
    if not ss_ver {
        shift += 1;
    }
    if not ss_hor {
        shift += 1;
    }
    for y in @as(usize, 0)..(height - hp) {
        let mut sy = y;
        if ss_ver {
            sy = y << 1;
        }
        let row = src + (sy * ls);
        for x in @as(usize, 0)..(width - wp) {
            let mut sx = x;
            if ss_hor {
                sx = x << 1;
            }
            let mut s = @as(i32, d[row + sx]);
            if ss_hor {
                s += @as(i32, d[row + sx + 1]);
            }
            if ss_ver {
                s += @as(i32, d[row + ls + sx]);
                if ss_hor {
                    s += @as(i32, d[row + ls + sx + 1]);
                }
            }
            ac[(y * width) + x] = s << shift;
        }
        for x in (width - wp)..width {
            ac[(y * width) + x] = ac[((y * width) + x) - 1];
        }
    }
    for y in (height - hp)..height {
        for x in @as(usize, 0)..width {
            ac[(y * width) + x] = ac[((y - 1) * width) + x];
        }
    }
    let log2sz = ctz(@truncate(u32, width)) + ctz(@truncate(u32, height));
    let mut sum = @bit_cast(i32, (@as(u32, 1) << log2sz) >> 1);
    for i in @as(usize, 0)..(width * height) {
        sum += ac[i];
    }
    let mean = sum >> log2sz;
    for i in @as(usize, 0)..(width * height) {
        ac[i] -= mean;
    }
}
