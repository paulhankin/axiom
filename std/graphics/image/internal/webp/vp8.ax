// =============================================================================
// std/graphics/image/internal/webp/vp8.ax - VP8 key frames (RFC 6386): WebP's lossy images.
//
// decode() turns a "VP8 " chunk into RGBA rows the way libwebp does:
// macroblocks of intra-predicted, dequantized DCT/WHT residuals, the normal
// or simple loop filter, then "fancy" chroma upsampling and libwebp's
// fixed-point YUV to RGB conversion (so the pixels match libwebp's).
// =============================================================================

import "../../../../mem.ax" as mem;
import "tables.ax" as t;

error { Corrupt, Unsupported, OutOfMemory }

pub struct Header {
    width: usize,
    height: usize,
}

/// The frame size, from the start of a VP8 key frame.
pub fn header(data: []u8) !Header {
    if (data.len < 10) or ((data[0] & 1) != 0) or (data[3] != 0x9d) or (data[4] != 0x01) or (data[5] != 0x2a) {
        return error.Corrupt;
    }
    let w = (@as(usize, data[7] & 0x3f) << 8) | @as(usize, data[6]);
    let h = (@as(usize, data[9] & 0x3f) << 8) | @as(usize, data[8]);
    if (w == 0) or (h == 0) {
        return error.Corrupt;
    }
    return Header.{ width: w, height: h };
}

// -----------------------------------------------------------------------------
// The boolean decoder (past the end, it reads zeros)
// -----------------------------------------------------------------------------

struct Bool {
    buf: []u8,
    pos: usize,
    value: u32,
    range: u32,
    count: u32,

    fn init(buf: []u8) Bool {
        let mut b = Bool.{ buf: buf, pos: 0, value: 0, range: 255, count: 0 };
        b.value = (@as(u32, b.byte()) << 8) | @as(u32, b.byte());
        return b;
    }

    fn byte(self: *mut Bool) u8 {
        if self.pos >= self.buf.len {
            self.pos += 1;
            return 0;
        }
        let v = self.buf[self.pos];
        self.pos += 1;
        return v;
    }

    fn read(self: *mut Bool, prob: u32) bool {
        let split = 1 + (((self.range - 1) * prob) >> 8);
        let big = split << 8;
        let mut bit = false;
        if self.value >= big {
            bit = true;
            self.range -= split;
            self.value -= big;
        } else {
            self.range = split;
        }
        while self.range < 128 {
            self.value <<= 1;
            self.range <<= 1;
            self.count += 1;
            if self.count == 8 {
                self.count = 0;
                self.value |= @as(u32, self.byte());
            }
        }
        return bit;
    }

    fn bit(self: *mut Bool, prob: u32) i32 {
        if self.read(prob) {
            return 1;
        }
        return 0;
    }

    fn literal(self: *mut Bool, n: u32) i32 {
        let mut v: i32 = 0;
        for _q in @as(u32, 0)..n {
            v = (v << 1) | self.bit(128);
        }
        return v;
    }

    // an optional signed value of n bits
    fn signed(self: *mut Bool, n: u32) i32 {
        if not self.read(128) {
            return 0;
        }
        let v = self.literal(n);
        if self.read(128) {
            return -v;
        }
        return v;
    }
}

// -----------------------------------------------------------------------------
// The decoder
// -----------------------------------------------------------------------------

// intra modes (the 4x4 ones in the order of the bitstream's tree)
const DC: u8 = 0;
const TM: u8 = 1;
const VE: u8 = 2;
const HE: u8 = 3;
const RD: u8 = 4;
const VR: u8 = 5;
const LD: u8 = 6;
const VL: u8 = 7;
const HD: u8 = 8;
const HU: u8 = 9;
const DC_NO_TOP: u8 = 10;
const DC_NO_LEFT: u8 = 11;
const DC_NONE: u8 = 12;

let BANDS: [17]u8 = [0, 1, 2, 3, 6, 4, 5, 6, 6, 6, 6, 6, 6, 6, 6, 7, 0];
let ZIGZAG: [16]u8 = [0, 1, 4, 8, 5, 2, 3, 6, 9, 12, 13, 10, 7, 11, 14, 15];
let CAT3: [3]u32 = [173, 148, 140];
let CAT4: [4]u32 = [176, 155, 140, 135];
let CAT5: [5]u32 = [180, 157, 141, 134, 130];
let CAT6: [11]u32 = [254, 254, 243, 230, 196, 177, 153, 140, 133, 130, 129];

// the work area: a macroblock with its borders (as libwebp and x/image do):
// Y at rows 1-16, columns 8-23; U at rows 18-25, columns 8-15; V at rows
// 18-25, columns 24-31
const YBR_W: usize = 32;
const Y_ROW: usize = 1;
const Y_COL: usize = 8;
const C_ROW: usize = 18;
const U_COL: usize = 8;
const V_COL: usize = 24;

struct Dec {
    fp: Bool,
    parts: [8]Bool,
    nparts: usize,
    mbw: usize,
    mbh: usize,
    use_segment: bool,
    update_map: bool,
    relative: bool,
    seg_quant: [4]i32,
    seg_filter: [4]i32,
    seg_prob: [3]u32,
    simple: bool,
    level: i32,
    sharpness: i32,
    use_lf_delta: bool,
    ref_delta: [4]i32,
    mode_delta: [4]i32,
    quant: [24]i32,   // per segment: y1 dc, y1 ac, y2 dc, y2 ac, uv dc, uv ac
    fparams: [32]u8,  // per segment and i4x4: limit, ilevel, hev threshold, inner
    probs: [1056]u8,
    use_skip: bool,
    skip_prob: u32,
    segment: usize,
    left_pred: [4]u8,
    left_nz: u8,
    left_nz_dc: u8,
    is16: bool,
    y16_mode: u8,
    c8_mode: u8,
    y4: [16]u8,
    nz_dc: u32,
    nz_ac: u32,
    coeff: [400]i32,
    ybr: [832]u8,  // 26 rows of 32
}

fn clip8(v: i32) u8 {
    if v < 0 {
        return 0;
    }
    if v > 255 {
        return 255;
    }
    return @truncate(u8, @bit_cast(u32, v));
}

fn clampi(v: i32, lo: i32, hi: i32) i32 {
    return @max(lo, @min(v, hi));
}

/// Decodes a VP8 key frame into rgba (w * h * 4 bytes, alpha set to 255).
pub fn decode(data: []u8, rgba: []mut u8) !void {
    let hd = header(data)!;
    let d = mem.new_zeroed.[Dec]()!;
    defer mem.destroy(d);
    let first_len = (@as(usize, data[0]) >> 5) | (@as(usize, data[1]) << 3) | (@as(usize, data[2]) << 11);
    if first_len > (data.len - 10) {
        return error.Corrupt;
    }
    d.mbw = (hd.width + 15) / 16;
    d.mbh = (hd.height + 15) / 16;
    d.fp = Bool.init(data[10..10 + first_len]);
    d.seg_prob = [255, 255, 255];
    @mem_copy(d.probs[..], t.COEFF_PROBS[..]);
    // the frame header
    _ = d.fp.bit(128);  // colour space
    _ = d.fp.bit(128);  // clamping
    d.use_segment = d.fp.read(128);
    if d.use_segment {
        d.update_map = d.fp.read(128);
        if d.fp.read(128) {
            d.relative = not d.fp.read(128);
            for i in @as(usize, 0)..4 {
                d.seg_quant[i] = d.fp.signed(7);
            }
            for i in @as(usize, 0)..4 {
                d.seg_filter[i] = d.fp.signed(6);
            }
        }
        if d.update_map {
            for i in @as(usize, 0)..3 {
                d.seg_prob[i] = 255;
                if d.fp.read(128) {
                    d.seg_prob[i] = @bit_cast(u32, d.fp.literal(8));
                }
            }
        }
    }
    d.simple = d.fp.read(128);
    d.level = d.fp.literal(6);
    d.sharpness = d.fp.literal(3);
    d.use_lf_delta = d.fp.read(128);
    if d.use_lf_delta and d.fp.read(128) {
        for i in @as(usize, 0)..4 {
            d.ref_delta[i] = d.fp.signed(6);
        }
        for i in @as(usize, 0)..4 {
            d.mode_delta[i] = d.fp.signed(6);
        }
    }
    // the partitions of tokens
    d.nparts = @as(usize, 1) << @bit_cast(u32, d.fp.literal(2));
    let mut at = 10 + first_len;
    let sizes = 3 * (d.nparts - 1);
    if (data.len - at) < sizes {
        return error.Corrupt;
    }
    let mut p = at + sizes;
    for i in @as(usize, 0)..d.nparts {
        let mut n = data.len - p;
        if (i + 1) < d.nparts {
            let s = at + (3 * i);
            n = (@as(usize, data[s]) | (@as(usize, data[s + 1]) << 8)) | (@as(usize, data[s + 2]) << 16);
            if n > (data.len - p) {
                return error.Corrupt;
            }
        }
        d.parts[i] = Bool.init(data[p..p + n]);
        p += n;
    }
    at = p;
    read_quant(d);
    _ = d.fp.bit(128);  // refresh entropy probabilities
    for i in @as(usize, 0)..1056 {
        if d.fp.read(@as(u32, t.COEFF_UPDATE_PROBS[i])) {
            d.probs[i] = @truncate(u8, @bit_cast(u32, d.fp.literal(8)));
        }
    }
    d.use_skip = d.fp.read(128);
    if d.use_skip {
        d.skip_prob = @bit_cast(u32, d.fp.literal(8));
    }
    filter_params(d);
    // the planes, whole macroblocks
    let yw = d.mbw * 16;
    let cw = d.mbw * 8;
    let ypl = mem.alloc.[u8](yw * (d.mbh * 16))!;
    defer mem.free(ypl);
    let upl = mem.alloc.[u8](cw * (d.mbh * 8))!;
    defer mem.free(upl);
    let vpl = mem.alloc.[u8](cw * (d.mbh * 8))!;
    defer mem.free(vpl);
    let up_pred = mem.alloc_zeroed.[u8](d.mbw * 4)!;
    defer mem.free(up_pred);
    let up_nz = mem.alloc_zeroed.[u8](d.mbw)!;
    defer mem.free(up_nz);
    let up_nz_dc = mem.alloc_zeroed.[u8](d.mbw)!;
    defer mem.free(up_nz_dc);
    let mbf = mem.alloc_zeroed.[u8](d.mbw * d.mbh * 4)!;
    defer mem.free(mbf);
    for mby in @as(usize, 0)..d.mbh {
        d.left_pred = [0; 4];
        d.left_nz = 0;
        d.left_nz_dc = 0;
        for mbx in @as(usize, 0)..d.mbw {
            let skip = macroblock(d, mbx, mby, up_pred, up_nz, up_nz_dc, ypl, upl, vpl);
            // past the end of the data, as libwebp refuses it (this reader
            // looks two bytes further ahead than libwebp's)
            let pr = &d.parts[mby & (d.nparts - 1)];
            if (d.fp.pos > (d.fp.buf.len + 2)) or (pr.pos > (pr.buf.len + 2)) {
                return error.Corrupt;
            }
            let mut j: usize = 0;
            if not d.is16 {
                j = 1;
            }
            let fo = ((d.segment * 2) + j) * 4;
            let o = ((mby * d.mbw) + mbx) * 4;
            mbf[o] = d.fparams[fo];
            mbf[o + 1] = d.fparams[fo + 1];
            mbf[o + 2] = d.fparams[fo + 2];
            mbf[o + 3] = d.fparams[fo + 3];
            if not skip {
                mbf[o + 3] = 1;
            }
        }
    }
    if d.level != 0 {
        loop_filter(d, mbf, ypl, upl, vpl);
    }
    upsample(ypl, upl, vpl, yw, cw, hd.width, hd.height, rgba);
}

fn ix(v: i32) usize {
    return @as(usize, @bit_cast(u32, v));
}

fn read_quant(d: *mut Dec) void {
    let base = d.fp.literal(7);
    let dy1dc = d.fp.signed(4);
    let dy2dc = d.fp.signed(4);
    let dy2ac = d.fp.signed(4);
    let duvdc = d.fp.signed(4);
    let duvac = d.fp.signed(4);
    for s in @as(usize, 0)..4 {
        let mut q = base;
        if d.use_segment {
            if d.relative {
                q += d.seg_quant[s];
            } else {
                q = d.seg_quant[s];
            }
        }
        let o = s * 6;
        d.quant[o] = @as(i32, t.DC_TABLE[ix(clampi(q + dy1dc, 0, 127))]);
        d.quant[o + 1] = @as(i32, t.AC_TABLE[ix(clampi(q, 0, 127))]);
        d.quant[o + 2] = @as(i32, t.DC_TABLE[ix(clampi(q + dy2dc, 0, 127))]) * 2;
        d.quant[o + 3] = @max((@as(i32, t.AC_TABLE[ix(clampi(q + dy2ac, 0, 127))]) * 155) / 100, 8);
        d.quant[o + 4] = @as(i32, t.DC_TABLE[ix(clampi(q + duvdc, 0, 117))]);
        d.quant[o + 5] = @as(i32, t.AC_TABLE[ix(clampi(q + duvac, 0, 127))]);
    }
}

// the loop filter's strengths for each segment, 16x16 or 4x4 prediction:
// edge limit, interior limit, high edge variance threshold, inner edges
fn filter_params(d: *mut Dec) void {
    for s in @as(usize, 0)..4 {
        let mut base = d.level;
        if d.use_segment {
            base = d.seg_filter[s];
            if d.relative {
                base += d.level;
            }
        }
        for j in @as(usize, 0)..2 {
            let o = ((s * 2) + j) * 4;
            let mut level = base;
            if d.use_lf_delta {
                level += d.ref_delta[0];
                if j == 1 {
                    level += d.mode_delta[0];
                }
            }
            level = clampi(level, 0, 63);
            d.fparams[o + 3] = @truncate(u8, j);
            if level == 0 {
                d.fparams[o] = 0;
                continue;
            }
            let mut il = level;
            if d.sharpness > 0 {
                if d.sharpness > 4 {
                    il >>= 2;
                } else {
                    il >>= 1;
                }
                il = @min(il, 9 - d.sharpness);
            }
            il = @max(il, 1);
            d.fparams[o] = clip8((2 * level) + il);
            d.fparams[o + 1] = clip8(il);
            d.fparams[o + 2] = 0;
            if level >= 40 {
                d.fparams[o + 2] = 2;
            } else if level >= 15 {
                d.fparams[o + 2] = 1;
            }
        }
    }
}

fn macroblock(d: *mut Dec, mbx: usize, mby: usize, up_pred: []mut u8, up_nz: []mut u8, up_nz_dc: []mut u8,
              ypl: []mut u8, upl: []mut u8, vpl: []mut u8) bool {
    if d.update_map {
        if not d.fp.read(d.seg_prob[0]) {
            d.segment = ix(d.fp.bit(d.seg_prob[1]));
        } else {
            d.segment = 2 + ix(d.fp.bit(d.seg_prob[2]));
        }
    }
    let mut skip = false;
    if d.use_skip {
        skip = d.fp.read(d.skip_prob);
    }
    @mem_set(@cast_slice(u8, d.coeff[..]), 0);
    prepare(d, mbx, mby, ypl, upl, vpl);
    d.is16 = d.fp.read(145);
    if d.is16 {
        let mut m = TM;
        if not d.fp.read(156) {
            m = DC;
            if d.fp.read(163) {
                m = VE;
            }
        } else if not d.fp.read(128) {
            m = HE;
        }
        for i in @as(usize, 0)..4 {
            up_pred[(mbx * 4) + i] = m;
            d.left_pred[i] = m;
        }
        d.y16_mode = m;
    } else {
        for j in @as(usize, 0)..4 {
            let mut p = d.left_pred[j];
            for i in @as(usize, 0)..4 {
                let a = up_pred[(mbx * 4) + i];
                let pb = ((@as(usize, a) * 10) + @as(usize, p)) * 9;
                let pr = t.BMODE_PROBS[pb..pb + 9];
                if not d.fp.read(@as(u32, pr[0])) {
                    p = DC;
                } else if not d.fp.read(@as(u32, pr[1])) {
                    p = TM;
                } else if not d.fp.read(@as(u32, pr[2])) {
                    p = VE;
                } else if not d.fp.read(@as(u32, pr[3])) {
                    if not d.fp.read(@as(u32, pr[4])) {
                        p = HE;
                    } else if not d.fp.read(@as(u32, pr[5])) {
                        p = RD;
                    } else {
                        p = VR;
                    }
                } else if not d.fp.read(@as(u32, pr[6])) {
                    p = LD;
                } else if not d.fp.read(@as(u32, pr[7])) {
                    p = VL;
                } else if not d.fp.read(@as(u32, pr[8])) {
                    p = HD;
                } else {
                    p = HU;
                }
                d.y4[(j * 4) + i] = p;
                up_pred[(mbx * 4) + i] = p;
            }
            d.left_pred[j] = p;
        }
    }
    d.c8_mode = TM;
    if not d.fp.read(142) {
        d.c8_mode = DC;
    } else if not d.fp.read(114) {
        d.c8_mode = VE;
    } else if not d.fp.read(183) {
        d.c8_mode = HE;
    }
    if not skip {
        skip = residuals_mb(d, mbx, mby, up_nz, up_nz_dc);
    } else {
        if d.is16 {
            d.left_nz_dc = 0;
            up_nz_dc[mbx] = 0;
        }
        d.left_nz = 0;
        up_nz[mbx] = 0;
        d.nz_dc = 0;
        d.nz_ac = 0;
    }
    reconstruct(d, mbx, mby);
    let yw = d.mbw * 16;
    let cw = d.mbw * 8;
    for y in @as(usize, 0)..16 {
        let o = (((mby * 16) + y) * yw) + (mbx * 16);
        let r = ((Y_ROW + y) * YBR_W) + Y_COL;
        @mem_copy(ypl[o..o + 16], d.ybr[r..r + 16]);
    }
    for y in @as(usize, 0)..8 {
        let o = (((mby * 8) + y) * cw) + (mbx * 8);
        let r = (C_ROW + y) * YBR_W;
        @mem_copy(upl[o..o + 8], d.ybr[r + U_COL..r + U_COL + 8]);
        @mem_copy(vpl[o..o + 8], d.ybr[r + V_COL..r + V_COL + 8]);
    }
    return skip;
}

// the borders of the work area: the macroblocks above and to the left, or
// 127 above the image and 129 left of it
fn prepare(d: *mut Dec, mbx: usize, mby: usize, ypl: []u8, upl: []u8, vpl: []u8) void {
    let b = d.ybr[..];
    if mbx == 0 {
        for y in @as(usize, 0)..17 {
            b[(y * 32) + 7] = 0x81;
        }
        for y in @as(usize, 17)..26 {
            b[(y * 32) + 7] = 0x81;
            b[(y * 32) + 23] = 0x81;
        }
    } else {
        for y in @as(usize, 0)..17 {
            b[(y * 32) + 7] = b[(y * 32) + 23];
        }
        for y in @as(usize, 17)..26 {
            b[(y * 32) + 7] = b[(y * 32) + 15];
            b[(y * 32) + 23] = b[(y * 32) + 31];
        }
    }
    if mby == 0 {
        for x in @as(usize, 7)..28 {
            b[x] = 0x7f;
        }
        for x in @as(usize, 7)..16 {
            b[(17 * 32) + x] = 0x7f;
        }
        for x in @as(usize, 23)..32 {
            b[(17 * 32) + x] = 0x7f;
        }
    } else {
        let yw = d.mbw * 16;
        let cw = d.mbw * 8;
        let yo = (((16 * mby) - 1) * yw) + (16 * mbx);
        for i in @as(usize, 0)..16 {
            b[8 + i] = ypl[yo + i];
        }
        let co = (((8 * mby) - 1) * cw) + (8 * mbx);
        for i in @as(usize, 0)..8 {
            b[(17 * 32) + 8 + i] = upl[co + i];
            b[(17 * 32) + 24 + i] = vpl[co + i];
        }
        for i in @as(usize, 16)..20 {
            if mbx == (d.mbw - 1) {
                b[8 + i] = ypl[yo + 15];
            } else {
                b[8 + i] = ypl[yo + i];
            }
        }
    }
    // the top right of the macroblock serves the 4x4 blocks down its right
    for y in [@as(usize, 4), 8, 12] {
        for i in @as(usize, 24)..28 {
            b[(y * 32) + i] = b[i];
        }
    }
}

fn pack4(v: [4]u8) u8 {
    return ((v[0] | (v[1] << 1)) | (v[2] << 2)) | (v[3] << 3);
}

fn residuals_mb(d: *mut Dec, mbx: usize, mby: usize, up_nz: []mut u8, up_nz_dc: []mut u8) bool {
    let pi = mby & (d.nparts - 1);
    let qo = d.segment * 6;
    let mut plane: usize = 3;
    if d.is16 {
        let nz = residuals(d, pi, 1, @as(usize, d.left_nz_dc + up_nz_dc[mbx]), d.quant[qo + 2], d.quant[qo + 3], false,
                           384);
        d.left_nz_dc = nz;
        up_nz_dc[mbx] = nz;
        inverse_wht(d);
        plane = 0;
    }
    let mut nz_dc: u32 = 0;
    let mut nz_ac: u32 = 0;
    let mut lnz: [4]u8 = [0; 4];
    let mut unz: [4]u8 = [0; 4];
    for i in @as(usize, 0)..4 {
        lnz[i] = (d.left_nz >> @truncate(u8, i)) & 1;
        unz[i] = (up_nz[mbx] >> @truncate(u8, i)) & 1;
    }
    let mut base: usize = 0;
    for y in @as(usize, 0)..4 {
        let mut nz = lnz[y];
        for x in @as(usize, 0)..4 {
            nz = residuals(d, pi, plane, @as(usize, nz + unz[x]), d.quant[qo], d.quant[qo + 1], d.is16, base);
            unz[x] = nz;
            let bit = @as(u32, 1) << @truncate(u32, (y * 4) + x);
            if nz != 0 {
                nz_ac |= bit;
            }
            if d.coeff[base] != 0 {
                nz_dc |= bit;
            }
            base += 16;
        }
        lnz[y] = nz;
    }
    let mut lmask = pack4(lnz);
    let mut umask = pack4(unz);
    for i in @as(usize, 0)..4 {
        lnz[i] = (d.left_nz >> @truncate(u8, i + 4)) & 1;
        unz[i] = (up_nz[mbx] >> @truncate(u8, i + 4)) & 1;
    }
    for c in [@as(usize, 0), 2] {
        for y in @as(usize, 0)..2 {
            let mut nz = lnz[y + c];
            for x in @as(usize, 0)..2 {
                nz = residuals(d, pi, 2, @as(usize, nz + unz[x + c]), d.quant[qo + 4], d.quant[qo + 5], false, base);
                unz[x + c] = nz;
                let bit = @as(u32, 1) << @truncate(u32, (16 + (c * 2)) + ((y * 2) + x));
                if nz != 0 {
                    nz_ac |= bit;
                }
                if d.coeff[base] != 0 {
                    nz_dc |= bit;
                }
                base += 16;
            }
            lnz[y + c] = nz;
        }
    }
    lmask |= pack4(lnz) << 4;
    umask |= pack4(unz) << 4;
    d.left_nz = lmask;
    up_nz[mbx] = umask;
    d.nz_dc = nz_dc;
    d.nz_ac = nz_ac;
    return (nz_dc == 0) and (nz_ac == 0);
}

fn prob_at(plane: usize, band: u8, ctx: usize) usize {
    return (((plane * 8) + @as(usize, band)) * 3 + ctx) * 11;
}

// the tokens of one 4x4 block into coeff[base..]; 1 unless the block ends at
// once
fn residuals(d: *mut Dec, pi: usize, plane: usize, ctx: usize, dcq: i32, acq: i32, skip_first: bool, base: usize) u8 {
    let r = &mut d.parts[pi];
    let pr = d.probs[..];
    let mut n: usize = 0;
    if skip_first {
        n = 1;
    }
    let mut p = prob_at(plane, BANDS[n], ctx);
    if not r.read(@as(u32, pr[p])) {
        return 0;
    }
    while n != 16 {
        n += 1;
        if not r.read(@as(u32, pr[p + 1])) {
            p = prob_at(plane, BANDS[n], 0);
            continue;
        }
        let mut v: i32 = 1;
        if not r.read(@as(u32, pr[p + 2])) {
            p = prob_at(plane, BANDS[n], 1);
        } else {
            if not r.read(@as(u32, pr[p + 3])) {
                if not r.read(@as(u32, pr[p + 4])) {
                    v = 2;
                } else {
                    v = 3 + r.bit(@as(u32, pr[p + 5]));
                }
            } else if not r.read(@as(u32, pr[p + 6])) {
                if not r.read(@as(u32, pr[p + 7])) {
                    v = 5 + r.bit(159);
                } else {
                    v = 7 + (2 * r.bit(165));
                    v += r.bit(145);
                }
            } else {
                let b1 = r.bit(@as(u32, pr[p + 8]));
                let b0 = r.bit(@as(u32, pr[(p + 9) + ix(b1)]));
                let cat = (2 * b1) + b0;
                v = 0;
                if cat == 0 {
                    for k in @as(usize, 0)..3 {
                        v = (2 * v) + r.bit(CAT3[k]);
                    }
                } else if cat == 1 {
                    for k in @as(usize, 0)..4 {
                        v = (2 * v) + r.bit(CAT4[k]);
                    }
                } else if cat == 2 {
                    for k in @as(usize, 0)..5 {
                        v = (2 * v) + r.bit(CAT5[k]);
                    }
                } else {
                    for k in @as(usize, 0)..11 {
                        v = (2 * v) + r.bit(CAT6[k]);
                    }
                }
                v += 3 + (@as(i32, 8) << @bit_cast(u32, cat));
            }
            p = prob_at(plane, BANDS[n], 2);
        }
        let z = @as(usize, ZIGZAG[n - 1]);
        let mut c = v * acq;
        if z == 0 {
            c = v * dcq;
        }
        if r.read(128) {
            c = -c;
        }
        d.coeff[base + z] = c;
        if (n == 16) or not r.read(@as(u32, pr[p])) {
            return 1;
        }
    }
    return 1;
}

fn inverse_wht(d: *mut Dec) void {
    let c = d.coeff[..];
    let mut m: [16]i32 = [0; 16];
    for i in @as(usize, 0)..4 {
        let a0 = c[384 + i] + c[396 + i];
        let a1 = c[388 + i] + c[392 + i];
        let a2 = c[388 + i] - c[392 + i];
        let a3 = c[384 + i] - c[396 + i];
        m[i] = a0 + a1;
        m[8 + i] = a0 - a1;
        m[4 + i] = a3 + a2;
        m[12 + i] = a3 - a2;
    }
    let mut out: usize = 0;
    for i in @as(usize, 0)..4 {
        let dc = m[i * 4] + 3;
        let a0 = dc + m[(i * 4) + 3];
        let a1 = m[(i * 4) + 1] + m[(i * 4) + 2];
        let a2 = m[(i * 4) + 1] - m[(i * 4) + 2];
        let a3 = dc - m[(i * 4) + 3];
        c[out] = (a0 + a1) >> 3;
        c[out + 16] = (a3 + a2) >> 3;
        c[out + 32] = (a0 - a1) >> 3;
        c[out + 48] = (a3 - a2) >> 3;
        out += 64;
    }
}

fn mul1(a: i32) i32 {
    return ((a * 20091) >> 16) + a;
}

fn mul2(a: i32) i32 {
    return (a * 35468) >> 16;
}

fn idct4(d: *mut Dec, y: usize, x: usize, base: usize) void {
    let c = d.coeff[base..base + 16];
    let mut m: [16]i32 = [0; 16];
    for i in @as(usize, 0)..4 {
        let a = c[i] + c[8 + i];
        let b = c[i] - c[8 + i];
        let cc = mul2(c[4 + i]) - mul1(c[12 + i]);
        let dd = mul1(c[4 + i]) + mul2(c[12 + i]);
        m[(i * 4)] = a + dd;
        m[(i * 4) + 1] = b + cc;
        m[(i * 4) + 2] = b - cc;
        m[(i * 4) + 3] = a - dd;
    }
    for j in @as(usize, 0)..4 {
        let dc = m[j] + 4;
        let a = dc + m[8 + j];
        let b = dc - m[8 + j];
        let cc = mul2(m[4 + j]) - mul1(m[12 + j]);
        let dd = mul1(m[4 + j]) + mul2(m[12 + j]);
        let o = ((y + j) * 32) + x;
        d.ybr[o] = clip8(@as(i32, d.ybr[o]) + ((a + dd) >> 3));
        d.ybr[o + 1] = clip8(@as(i32, d.ybr[o + 1]) + ((b + cc) >> 3));
        d.ybr[o + 2] = clip8(@as(i32, d.ybr[o + 2]) + ((b - cc) >> 3));
        d.ybr[o + 3] = clip8(@as(i32, d.ybr[o + 3]) + ((a - dd) >> 3));
    }
}

fn idct_dc(d: *mut Dec, y: usize, x: usize, base: usize) void {
    let dc = (d.coeff[base] + 4) >> 3;
    for j in @as(usize, 0)..4 {
        for i in @as(usize, 0)..4 {
            let o = ((y + j) * 32) + x + i;
            d.ybr[o] = clip8(@as(i32, d.ybr[o]) + dc);
        }
    }
}

fn check_mode(mbx: usize, mby: usize, m: u8) u8 {
    if m != DC {
        return m;
    }
    if mbx == 0 {
        if mby == 0 {
            return DC_NONE;
        }
        return DC_NO_LEFT;
    }
    if mby == 0 {
        return DC_NO_TOP;
    }
    return DC;
}

fn reconstruct(d: *mut Dec, mbx: usize, mby: usize) void {
    if d.is16 {
        pred_n(d.ybr[..], check_mode(mbx, mby, d.y16_mode), Y_ROW, Y_COL, 16);
    }
    for n in @as(usize, 0)..16 {
        let y = Y_ROW + (4 * (n / 4));
        let x = Y_COL + (4 * (n % 4));
        if not d.is16 {
            pred4(d.ybr[..], d.y4[n], y, x);
        }
        let bit = @as(u32, 1) << @truncate(u32, n);
        if (d.nz_ac & bit) != 0 {
            idct4(d, y, x, 16 * n);
        } else if (d.nz_dc & bit) != 0 {
            idct_dc(d, y, x, 16 * n);
        }
    }
    let m = check_mode(mbx, mby, d.c8_mode);
    pred_n(d.ybr[..], m, C_ROW, U_COL, 8);
    pred_n(d.ybr[..], m, C_ROW, V_COL, 8);
    for k in @as(usize, 0)..8 {
        let bit = @as(u32, 1) << @truncate(u32, 16 + k);
        let mut col = U_COL;
        if k >= 4 {
            col = V_COL;
        }
        let y = C_ROW + (4 * ((k % 4) / 2));
        let x = col + (4 * (k % 2));
        let base = 256 + (16 * k);
        if (d.nz_ac & bit) != 0 {
            idct4(d, y, x, base);
        } else if (d.nz_dc & bit) != 0 {
            idct_dc(d, y, x, base);
        }
    }
}

// 16x16 luma or 8x8 chroma prediction
fn pred_n(b: []mut u8, mode: u8, y: usize, x: usize, n: usize) void {
    let top = (y - 1) * 32;
    let mut shift: u32 = 3;
    if n == 16 {
        shift = 4;
    }
    if (mode == DC) or (mode == DC_NO_TOP) or (mode == DC_NO_LEFT) or (mode == DC_NONE) {
        let mut sum: u32 = 0;
        let mut v: u32 = 0x80;
        if mode == DC {
            for i in @as(usize, 0)..n {
                sum += @as(u32, b[top + x + i]) + @as(u32, b[((y + i) * 32) + x - 1]);
            }
            v = (sum + @truncate(u32, n)) >> (shift + 1);
        } else if mode == DC_NO_TOP {
            for i in @as(usize, 0)..n {
                sum += @as(u32, b[((y + i) * 32) + x - 1]);
            }
            v = (sum + @truncate(u32, n / 2)) >> shift;
        } else if mode == DC_NO_LEFT {
            for i in @as(usize, 0)..n {
                sum += @as(u32, b[top + x + i]);
            }
            v = (sum + @truncate(u32, n / 2)) >> shift;
        }
        for j in @as(usize, 0)..n {
            @mem_set(b[((y + j) * 32) + x..((y + j) * 32) + x + n], @truncate(u8, v));
        }
        return;
    }
    for j in @as(usize, 0)..n {
        let row = (y + j) * 32;
        for i in @as(usize, 0)..n {
            if mode == VE {
                b[row + x + i] = b[top + x + i];
            } else if mode == HE {
                b[row + x + i] = b[row + x - 1];
            } else {
                b[row + x + i] = clip8(
                    (@as(i32, b[row + x - 1]) + @as(i32, b[top + x + i])) - @as(i32, b[top + x - 1]));
            }
        }
    }
}

fn avg3(a: u32, b: u32, c: u32) u8 {
    return @truncate(u8, ((a + (2 * b)) + c + 2) >> 2);
}

fn avg2(a: u32, b: u32) u8 {
    return @truncate(u8, (a + b + 1) >> 1);
}

// 4x4 luma prediction
fn pred4(b: []mut u8, mode: u8, y: usize, x: usize) void {
    let top = (y - 1) * 32;
    let tl = @as(u32, b[top + x - 1]);
    let mut tp: [8]u32 = [0; 8];
    for i in @as(usize, 0)..8 {
        tp[i] = @as(u32, b[top + x + i]);
    }
    let mut lf: [4]u32 = [0; 4];
    for j in @as(usize, 0)..4 {
        lf[j] = @as(u32, b[((y + j) * 32) + x - 1]);
    }
    let mut o: [16]u8 = [0; 16];  // row-major
    if mode == DC {
        let mut s: u32 = 4;
        for i in @as(usize, 0)..4 {
            s += tp[i] + lf[i];
        }
        @mem_set(o[..], @truncate(u8, s >> 3));
    } else if mode == TM {
        for j in @as(usize, 0)..4 {
            for i in @as(usize, 0)..4 {
                o[(j * 4) + i] = clip8((@bit_cast(i32, lf[j]) + @bit_cast(i32, tp[i])) - @bit_cast(i32, tl));
            }
        }
    } else if mode == VE {
        for i in @as(usize, 0)..4 {
            let mut prev = tl;
            if i > 0 {
                prev = tp[i - 1];
            }
            let v = avg3(prev, tp[i], tp[i + 1]);
            for j in @as(usize, 0)..4 {
                o[(j * 4) + i] = v;
            }
        }
    } else if mode == HE {
        let r0 = avg3(tl, lf[0], lf[1]);
        let r1 = avg3(lf[0], lf[1], lf[2]);
        let r2 = avg3(lf[1], lf[2], lf[3]);
        let r3 = avg3(lf[2], lf[3], lf[3]);
        @mem_set(o[0..4], r0);
        @mem_set(o[4..8], r1);
        @mem_set(o[8..12], r2);
        @mem_set(o[12..16], r3);
    } else if (mode == RD) or (mode == VR) or (mode == HD) {
        // the edge from bottom left to top right: L3 L2 L1 L0 TL T0 T1 T2 T3
        let mut e: [9]u32 = [0; 9];
        e[0] = lf[3];
        e[1] = lf[2];
        e[2] = lf[1];
        e[3] = lf[0];
        e[4] = tl;
        for i in @as(usize, 0)..4 {
            e[5 + i] = tp[i];
        }
        if mode == RD {
            for j in @as(usize, 0)..4 {
                for i in @as(usize, 0)..4 {
                    let k = (4 + i) - j;  // centre on the edge
                    o[(j * 4) + i] = avg3(e[k - 1], e[k], e[k + 1]);
                }
            }
        } else if mode == VR {
            let ab = avg2(e[4], e[5]);
            let bc = avg2(e[5], e[6]);
            let cd = avg2(e[6], e[7]);
            let de = avg2(e[7], e[8]);
            let rqp = avg3(e[1], e[2], e[3]);
            let qpa = avg3(e[2], e[3], e[4]);
            let pab = avg3(e[3], e[4], e[5]);
            let abc = avg3(e[4], e[5], e[6]);
            let bcd = avg3(e[5], e[6], e[7]);
            let cde = avg3(e[6], e[7], e[8]);
            let v: [16]u8 = [ab, bc, cd, de, pab, abc, bcd, cde, qpa, ab, bc, cd, rqp, pab, abc, bcd];
            o = v;
        } else {
            let sr = avg2(e[0], e[1]);
            let rq = avg2(e[1], e[2]);
            let qp = avg2(e[2], e[3]);
            let pa = avg2(e[3], e[4]);
            let srq = avg3(e[0], e[1], e[2]);
            let rqp = avg3(e[1], e[2], e[3]);
            let qpa = avg3(e[2], e[3], e[4]);
            let pab = avg3(e[3], e[4], e[5]);
            let abc = avg3(e[4], e[5], e[6]);
            let bcd = avg3(e[5], e[6], e[7]);
            let v: [16]u8 = [pa, pab, abc, bcd, qp, qpa, pa, pab, rq, rqp, qp, qpa, sr, srq, rq, rqp];
            o = v;
        }
    } else if mode == LD {
        for j in @as(usize, 0)..4 {
            for i in @as(usize, 0)..4 {
                let k = i + j;
                if k == 6 {
                    o[(j * 4) + i] = avg3(tp[6], tp[7], tp[7]);
                } else {
                    o[(j * 4) + i] = avg3(tp[k], tp[k + 1], tp[k + 2]);
                }
            }
        }
    } else if mode == VL {
        let ab = avg2(tp[0], tp[1]);
        let bc = avg2(tp[1], tp[2]);
        let cd = avg2(tp[2], tp[3]);
        let de = avg2(tp[3], tp[4]);
        let abc = avg3(tp[0], tp[1], tp[2]);
        let bcd = avg3(tp[1], tp[2], tp[3]);
        let cde = avg3(tp[2], tp[3], tp[4]);
        let def = avg3(tp[3], tp[4], tp[5]);
        let efg = avg3(tp[4], tp[5], tp[6]);
        let fgh = avg3(tp[5], tp[6], tp[7]);
        let v: [16]u8 = [ab, bc, cd, de, abc, bcd, cde, def, bc, cd, de, efg, bcd, cde, def, fgh];
        o = v;
    } else {
        // HU
        let pq = avg2(lf[0], lf[1]);
        let qr = avg2(lf[1], lf[2]);
        let rs = avg2(lf[2], lf[3]);
        let pqr = avg3(lf[0], lf[1], lf[2]);
        let qrs = avg3(lf[1], lf[2], lf[3]);
        let rss = avg3(lf[2], lf[3], lf[3]);
        let sss = @truncate(u8, lf[3]);
        let v: [16]u8 = [pq, pqr, qr, qrs, qr, qrs, rs, rss, rs, rss, sss, sss, sss, sss, sss, sss];
        o = v;
    }
    for j in @as(usize, 0)..4 {
        @mem_copy(b[((y + j) * 32) + x..((y + j) * 32) + x + 4], o[j * 4..(j * 4) + 4]);
    }
}

// -----------------------------------------------------------------------------
// The loop filter
// -----------------------------------------------------------------------------

fn absi(v: i32) i32 {
    if v < 0 {
        return -v;
    }
    return v;
}

fn clamp15(v: i32) i32 {
    return clampi(v, -16, 15);
}

fn clamp127(v: i32) i32 {
    return clampi(v, -128, 127);
}

// the simple filter on n pixels along an edge: index moves by istep along it,
// jstep across it
fn filter2(px: []mut u8, level: i32, start: usize, istep: usize, jstep: usize) void {
    let mut idx = start;
    for _q in @as(usize, 0)..16 {
        let p1 = @as(i32, px[idx - (2 * jstep)]);
        let p0 = @as(i32, px[idx - jstep]);
        let q0 = @as(i32, px[idx]);
        let q1 = @as(i32, px[idx + jstep]);
        if ((absi(p0 - q0) << 1) + (absi(p1 - q1) >> 1)) <= level {
            let a = (3 * (q0 - p0)) + clamp127(p1 - q1);
            let a1 = clamp15((a + 4) >> 3);
            let a2 = clamp15((a + 3) >> 3);
            px[idx - jstep] = clip8(p0 + a2);
            px[idx] = clip8(q0 - a1);
        }
        idx += istep;
    }
}

fn filter246(px: []mut u8, n: usize, level: i32, ilevel: i32, hlevel: i32, start: usize, istep: usize, jstep: usize,
             four: bool) void {
    let mut idx = start;
    for _q in @as(usize, 0)..n {
        let p3 = @as(i32, px[idx - (4 * jstep)]);
        let p2 = @as(i32, px[idx - (3 * jstep)]);
        let p1 = @as(i32, px[idx - (2 * jstep)]);
        let p0 = @as(i32, px[idx - jstep]);
        let q0 = @as(i32, px[idx]);
        let q1 = @as(i32, px[idx + jstep]);
        let q2 = @as(i32, px[idx + (2 * jstep)]);
        let q3 = @as(i32, px[idx + (3 * jstep)]);
        let go = (((absi(p0 - q0) << 1) + (absi(p1 - q1) >> 1)) <= level) and (absi(p3 - p2) <= ilevel) and
                 (absi(p2 - p1) <= ilevel) and (absi(p1 - p0) <= ilevel) and (absi(q1 - q0) <= ilevel) and
                 (absi(q2 - q1) <= ilevel) and (absi(q3 - q2) <= ilevel);
        if go {
            if (absi(p1 - p0) > hlevel) or (absi(q1 - q0) > hlevel) {
                let a = (3 * (q0 - p0)) + clamp127(p1 - q1);
                let a1 = clamp15((a + 4) >> 3);
                let a2 = clamp15((a + 3) >> 3);
                px[idx - jstep] = clip8(p0 + a2);
                px[idx] = clip8(q0 - a1);
            } else if four {
                let a = 3 * (q0 - p0);
                let a1 = clamp15((a + 4) >> 3);
                let a2 = clamp15((a + 3) >> 3);
                let a3 = (a1 + 1) >> 1;
                px[idx - (2 * jstep)] = clip8(p1 + a3);
                px[idx - jstep] = clip8(p0 + a2);
                px[idx] = clip8(q0 - a1);
                px[idx + jstep] = clip8(q1 - a3);
            } else {
                let a = clamp127((3 * (q0 - p0)) + clamp127(p1 - q1));
                let a1 = ((27 * a) + 63) >> 7;
                let a2 = ((18 * a) + 63) >> 7;
                let a3 = ((9 * a) + 63) >> 7;
                px[idx - (3 * jstep)] = clip8(p2 + a3);
                px[idx - (2 * jstep)] = clip8(p1 + a2);
                px[idx - jstep] = clip8(p0 + a1);
                px[idx] = clip8(q0 - a1);
                px[idx + jstep] = clip8(q1 - a2);
                px[idx + (2 * jstep)] = clip8(q2 - a3);
            }
        }
        idx += istep;
    }
}

fn loop_filter(d: *mut Dec, mbf: []u8, ypl: []mut u8, upl: []mut u8, vpl: []mut u8) void {
    let ys = d.mbw * 16;
    let cs = d.mbw * 8;
    for mby in @as(usize, 0)..d.mbh {
        for mbx in @as(usize, 0)..d.mbw {
            let o = ((mby * d.mbw) + mbx) * 4;
            let l = @as(i32, mbf[o]);
            if l == 0 {
                continue;
            }
            let il = @as(i32, mbf[o + 1]);
            let hl = @as(i32, mbf[o + 2]);
            let inner = mbf[o + 3] != 0;
            let yi = ((mby * ys) + mbx) * 16;
            let ci = ((mby * cs) + mbx) * 8;
            if d.simple {
                if mbx > 0 {
                    filter2(ypl, l + 4, yi, ys, 1);
                }
                if inner {
                    filter2(ypl, l, yi + 4, ys, 1);
                    filter2(ypl, l, yi + 8, ys, 1);
                    filter2(ypl, l, yi + 12, ys, 1);
                }
                if mby > 0 {
                    filter2(ypl, l + 4, yi, 1, ys);
                }
                if inner {
                    filter2(ypl, l, yi + (ys * 4), 1, ys);
                    filter2(ypl, l, yi + (ys * 8), 1, ys);
                    filter2(ypl, l, yi + (ys * 12), 1, ys);
                }
                continue;
            }
            if mbx > 0 {
                filter246(ypl, 16, l + 4, il, hl, yi, ys, 1, false);
                filter246(upl, 8, l + 4, il, hl, ci, cs, 1, false);
                filter246(vpl, 8, l + 4, il, hl, ci, cs, 1, false);
            }
            if inner {
                filter246(ypl, 16, l, il, hl, yi + 4, ys, 1, true);
                filter246(ypl, 16, l, il, hl, yi + 8, ys, 1, true);
                filter246(ypl, 16, l, il, hl, yi + 12, ys, 1, true);
                filter246(upl, 8, l, il, hl, ci + 4, cs, 1, true);
                filter246(vpl, 8, l, il, hl, ci + 4, cs, 1, true);
            }
            if mby > 0 {
                filter246(ypl, 16, l + 4, il, hl, yi, 1, ys, false);
                filter246(upl, 8, l + 4, il, hl, ci, 1, cs, false);
                filter246(vpl, 8, l + 4, il, hl, ci, 1, cs, false);
            }
            if inner {
                filter246(ypl, 16, l, il, hl, yi + (ys * 4), 1, ys, true);
                filter246(ypl, 16, l, il, hl, yi + (ys * 8), 1, ys, true);
                filter246(ypl, 16, l, il, hl, yi + (ys * 12), 1, ys, true);
                filter246(upl, 8, l, il, hl, ci + (cs * 4), 1, cs, true);
                filter246(vpl, 8, l, il, hl, ci + (cs * 4), 1, cs, true);
            }
        }
    }
}

// -----------------------------------------------------------------------------
// YUV 4:2:0 to RGB, as libwebp does it
// -----------------------------------------------------------------------------

fn mult_hi(v: i32, c: i32) i32 {
    return (v * c) >> 8;
}

fn clip_yuv(v: i32) u8 {
    if (v & ~@as(i32, 16383)) == 0 {
        return @truncate(u8, @bit_cast(u32, v >> 6));
    }
    if v < 0 {
        return 0;
    }
    return 255;
}

fn put_rgb(out: []mut u8, o: usize, y: u32, u: u32, v: u32) void {
    let yy = mult_hi(@bit_cast(i32, y), 19077);
    let uu = @bit_cast(i32, u);
    let vv = @bit_cast(i32, v);
    out[o] = clip_yuv((yy + mult_hi(vv, 26149)) - 14234);
    out[o + 1] = clip_yuv(((yy - mult_hi(uu, 6419)) - mult_hi(vv, 13320)) + 8708);
    out[o + 2] = clip_yuv((yy + mult_hi(uu, 33050)) - 17685);
    out[o + 3] = 255;
}

// "fancy upsampling": two rows of luma with the chroma rows nearest them,
// each chroma sample weighted 9-3-3-1 (libwebp's UpsampleRgbaLinePair)
fn line_pair(ty: []u8, by: []u8, has_bottom: bool, tu: []u8, tv: []u8, cu: []u8, cv: []u8, tdst: []mut u8,
             bdst: []mut u8, len: usize) void {
    let last = (len - 1) >> 1;
    let mut tl_uv = @as(u32, tu[0]) | (@as(u32, tv[0]) << 16);
    let mut l_uv = @as(u32, cu[0]) | (@as(u32, cv[0]) << 16);
    let uv0 = (((3 * tl_uv) + l_uv) + 0x00020002) >> 2;
    put_rgb(tdst, 0, @as(u32, ty[0]), uv0 & 0xff, uv0 >> 16);
    if has_bottom {
        let uv1 = (((3 * l_uv) + tl_uv) + 0x00020002) >> 2;
        put_rgb(bdst, 0, @as(u32, by[0]), uv1 & 0xff, uv1 >> 16);
    }
    for x in @as(usize, 1)..last + 1 {
        let t_uv = @as(u32, tu[x]) | (@as(u32, tv[x]) << 16);
        let uv = @as(u32, cu[x]) | (@as(u32, cv[x]) << 16);
        let avg = ((tl_uv + t_uv) + (l_uv + uv)) + 0x00080008;
        let diag_12 = (avg + (2 * (t_uv + l_uv))) >> 3;
        let diag_03 = (avg + (2 * (tl_uv + uv))) >> 3;
        let a = (diag_12 + tl_uv) >> 1;
        let b = (diag_03 + t_uv) >> 1;
        put_rgb(tdst, ((2 * x) - 1) * 4, @as(u32, ty[(2 * x) - 1]), a & 0xff, (a >> 16) & 0xff);
        put_rgb(tdst, (2 * x) * 4, @as(u32, ty[2 * x]), b & 0xff, (b >> 16) & 0xff);
        if has_bottom {
            let c = (diag_03 + l_uv) >> 1;
            let e = (diag_12 + uv) >> 1;
            put_rgb(bdst, ((2 * x) - 1) * 4, @as(u32, by[(2 * x) - 1]), c & 0xff, (c >> 16) & 0xff);
            put_rgb(bdst, (2 * x) * 4, @as(u32, by[2 * x]), e & 0xff, (e >> 16) & 0xff);
        }
        tl_uv = t_uv;
        l_uv = uv;
    }
    if (len & 1) == 0 {
        let uv2 = (((3 * tl_uv) + l_uv) + 0x00020002) >> 2;
        put_rgb(tdst, (len - 1) * 4, @as(u32, ty[len - 1]), uv2 & 0xff, uv2 >> 16);
        if has_bottom {
            let uv3 = (((3 * l_uv) + tl_uv) + 0x00020002) >> 2;
            put_rgb(bdst, (len - 1) * 4, @as(u32, by[len - 1]), uv3 & 0xff, uv3 >> 16);
        }
    }
}

fn upsample(ypl: []u8, upl: []u8, vpl: []u8, ys: usize, cs: usize, w: usize, h: usize, rgba: []mut u8) void {
    let rs = w * 4;
    line_pair(ypl[..w], ypl[..w], false, upl[..cs], vpl[..cs], upl[..cs], vpl[..cs], rgba[..rs], rgba[..rs], w);
    let mut k: usize = 1;
    while ((2 * k) - 1) < h {
        let top = (2 * k) - 1;
        let bottom = 2 * k;
        let tc = (k - 1) * cs;
        let mut cc = tc;
        let has_bottom = bottom < h;
        let mut bo = top;
        if has_bottom {
            cc = k * cs;
            bo = bottom;
        }
        line_pair(ypl[top * ys..], ypl[bo * ys..], has_bottom, upl[tc..], vpl[tc..], upl[cc..], vpl[cc..],
                  rgba[top * rs..(top + 1) * rs], rgba[bo * rs..(bo + 1) * rs], w);
        k += 1;
    }
}
