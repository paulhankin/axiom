// =============================================================================
// std/graphics/image/internal/imagetest.ax - helpers for the image codecs'
// tests.
// =============================================================================

import "../../../io.ax" as io;
import "../../../mem.ax" as mem;
import "../../../str.ax" as strs;
import "../../image.ax" as image;

/// Checks that an encoder's encode_to writes what its encode returns, and
/// passes on the writer's error when it runs out of room.
pub fn check_encode_to(
    img: *image.Image, encode: fn(*image.Image) ![]mut u8, encode_to: fn(io.Writer, *image.Image) !void) !void {
    let enc = encode(img)!;
    defer mem.free(enc);
    let mut s = strs.String.init();
    defer s.deinit();
    encode_to(s.writer(), img)!;
    @expect_eq(s.bytes(), enc[..]);
    let mut small: [100]u8 = [0; 100];
    let mut bw = io.BufferWriter.init(small[..]);
    encode_to(bw.writer(), img) catch |e| {
        @expect_eq(e, error.NoSpaceLeft);
        return;
    };
    @trap();
}
