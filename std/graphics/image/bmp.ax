// =============================================================================
// std/graphics/image/bmp.ax - Windows BMP (DIB) decoding and encoding.
//
//     let img = bmp.decode(bytes)!;
//     let out = bmp.encode(&img)!;    // mem.free it
//     bmp.encode_to(w, &img)!;        // or to an io.Writer
//
// Decoding handles 1, 4 and 8 bits with a palette (and RLE4/RLE8
// compression), 16 and 32 bits with or without bit fields, 24 bits,
// bottom-up and top-down rows, and every header version. Images come out as
// U8 RGB, or RGBA when the file has an alpha mask.
//
// Encoding writes gray images as 8 bits with a gray palette, RGB as 24
// bits, and anything with alpha as 32 bits with a BITMAPV4HEADER.
// =============================================================================

import "../../encoding/binary.ax" as binary;
import "../../io.ax" as io;
import "../../mem.ax" as mem;
import "../../str.ax" as strs;
import "../image.ax" as image;

error { Corrupt, Unsupported, OutOfMemory }

pub fn is_bmp(data: []u8) bool {
    return (data.len >= 26) and (data[0] == 'B') and (data[1] == 'M');
}

/// A bit field: where a channel is in a pixel, and how to widen it to 8 bits.
struct Field {
    mask: u32,
    shift: u32,
    bits: u32,

    fn of(mask: u32) Field {
        if mask == 0 {
            return Field.{ mask: 0, shift: 0, bits: 0 };
        }
        let shift = @ctz(mask);
        let bits = @popcount(mask >> shift);
        return Field.{ mask: mask, shift: shift, bits: @min(bits, 16) };
    }

    fn get(self: *Field, px: u32) u8 {
        if self.bits == 0 {
            return 0;
        }
        let v = (px & self.mask) >> self.shift;
        let max = (@as(u32, 1) << self.bits) - 1;
        return @truncate(u8, (((v & max) * 255) + (max / 2)) / max);
    }
}

pub fn decode(data: []u8) !image.Image {
    if not is_bmp(data) {
        return error.Corrupt;
    }
    let off = @as(usize, binary.u32_le(data[10..]));
    let hsize = @as(usize, binary.u32_le(data[14..]));
    if (hsize < 12) or ((14 + hsize) > data.len) {
        return error.Corrupt;
    }
    let mut width: i64 = 0;
    let mut height: i64 = 0;
    let mut bpp: u32 = 0;
    let mut compression: u32 = 0;
    let mut colors: usize = 0;
    let mut pal_entry: usize = 4;
    if hsize == 12 {
        width = @as(i64, @as(u32, binary.u16_le(data[18..])));
        height = @as(i64, @as(u32, binary.u16_le(data[20..])));
        bpp = @as(u32, binary.u16_le(data[24..]));
        pal_entry = 3;
    } else {
        if hsize < 40 {
            return error.Corrupt;
        }
        width = @as(i64, @bit_cast(i32, binary.u32_le(data[18..])));
        height = @as(i64, @bit_cast(i32, binary.u32_le(data[22..])));
        bpp = @as(u32, binary.u16_le(data[28..]));
        compression = binary.u32_le(data[30..]);
        colors = @as(usize, binary.u32_le(data[46..]));
    }
    let top_down = height < 0;
    let w = @truncate(usize, @bit_cast(u64, width));
    let h = @truncate(usize, @bit_cast(u64, @abs(height)));
    if (width <= 0) or (h == 0) or (width > 0x7fffffff) {
        return error.Corrupt;
    }
    if (@mul_checked(w, h) catch return error.Corrupt) > image.MAX_PIXELS {
        return error.Corrupt;
    }
    // channel masks
    let mut masks: [4]u32 = [0, 0, 0, 0];
    if (compression == 3) or (compression == 6) {
        if hsize >= 52 {
            masks = [binary.u32_le(data[54..]), binary.u32_le(data[58..]), binary.u32_le(data[62..]), 0];
            if hsize >= 56 {
                masks[3] = binary.u32_le(data[66..]);
            }
        } else {
            let n: usize = 3 + @as(usize, @truncate(u8, compression / 6));
            if (14 + hsize + (4 * n)) > data.len {
                return error.Corrupt;
            }
            for i in @as(usize, 0)..n {
                masks[i] = binary.u32_le(data[14 + hsize + (4 * i)..]);
            }
        }
    } else if compression == 0 {
        if bpp == 16 {
            masks = [0x7c00, 0x03e0, 0x001f, 0];
        } else if bpp == 32 {
            masks = [0x00ff0000, 0x0000ff00, 0x000000ff, 0];
        }
    } else if ((compression == 1) and (bpp != 8)) or ((compression == 2) and (bpp != 4)) or (compression > 3) {
        if compression != 6 {
            return error.Unsupported;  // JPEG or PNG inside, or an unknown kind
        }
    }
    let fields: [4]Field = [Field.of(masks[0]), Field.of(masks[1]), Field.of(masks[2]), Field.of(masks[3])];
    let has_alpha = (masks[3] != 0) and ((bpp == 16) or (bpp == 32));
    // palette
    let mut palette: [256]u32 = [0; 256];
    if bpp <= 8 {
        if (bpp != 1) and (bpp != 2) and (bpp != 4) and (bpp != 8) {
            return error.Corrupt;
        }
        let maxc = @as(usize, 1) << @truncate(u32, bpp);
        if (colors == 0) or (colors > maxc) {
            colors = maxc;
        }
        let mut pal_at = 14 + hsize;
        if compression == 3 {
            pal_at += 12;
        }
        for i in @as(usize, 0)..colors {
            let p = pal_at + (i * pal_entry);
            if (p + 3) > data.len {
                break;
            }
            palette[i] = ((@as(u32, data[p + 2]) << 16) | (@as(u32, data[p + 1]) << 8)) | @as(u32, data[p]);
        }
    } else if (bpp != 16) and (bpp != 24) and (bpp != 32) {
        return error.Corrupt;
    }
    let mut chans: usize = 3;
    if has_alpha {
        chans = 4;
    }
    let mut img = image.Image.init(w, h, chans, image.Depth.U8)!;
    let out = img.samples8();
    if off > data.len {
        img.deinit();
        return error.Corrupt;
    }
    let pixels = data[off..];
    if (compression == 1) or (compression == 2) {
        let idx = mem.alloc_zeroed.[u8](w * h) catch |e| {
            img.deinit();
            return e;
        };
        defer mem.free(idx);
        rle(pixels, idx, w, h, compression == 2);
        for y in @as(usize, 0)..h {
            let ry = rowmap(y, h, top_down);
            for x in @as(usize, 0)..w {
                put_rgb(out, ((ry * w) + x) * chans, palette[@as(usize, idx[(y * w) + x])]);
            }
        }
        return img;
    }
    let stride = ((((w * @as(usize, bpp)) + 31) / 32) * 4);
    for y in @as(usize, 0)..h {
        let row_at = y * stride;
        if (row_at + (((w * @as(usize, bpp)) + 7) / 8)) > pixels.len {
            break;  // truncated: the rest stays black
        }
        let row = pixels[row_at..];
        let ry = rowmap(y, h, top_down);
        for x in @as(usize, 0)..w {
            let o = ((ry * w) + x) * chans;
            if bpp <= 8 {
                let bit = x * @as(usize, bpp);
                let b = row[bit / 8];
                let v = (@as(u32, b) >> @truncate(u32, 8 - @as(usize, bpp) - (bit % 8))) & ((@as(u32, 1) << bpp) - 1);
                put_rgb(out, o, palette[@as(usize, v)]);
            } else if bpp == 24 {
                out[o] = row[(x * 3) + 2];
                out[o + 1] = row[(x * 3) + 1];
                out[o + 2] = row[x * 3];
            } else {
                let mut px: u32 = 0;
                if bpp == 16 {
                    px = @as(u32, binary.u16_le(row[x * 2..]));
                } else {
                    px = binary.u32_le(row[x * 4..]);
                }
                out[o] = fields[0].get(px);
                out[o + 1] = fields[1].get(px);
                out[o + 2] = fields[2].get(px);
                if has_alpha {
                    out[o + 3] = fields[3].get(px);
                }
            }
        }
    }
    return img;
}

fn rowmap(y: usize, h: usize, top_down: bool) usize {
    if top_down {
        return y;
    }
    return h - 1 - y;
}

fn put_rgb(out: []mut u8, o: usize, rgb: u32) void {
    out[o] = @truncate(u8, rgb >> 16);
    out[o + 1] = @truncate(u8, rgb >> 8);
    out[o + 2] = @truncate(u8, rgb);
}

/// Decodes RLE8 or RLE4 data into palette indices (rows in file order).
fn rle(src: []u8, idx: []mut u8, w: usize, h: usize, four: bool) void {
    let mut i: usize = 0;
    let mut x: usize = 0;
    let mut y: usize = 0;
    while ((i + 1) < src.len) and (y < h) {
        let n = @as(usize, src[i]);
        let v = src[i + 1];
        i += 2;
        if n > 0 {
            for k in @as(usize, 0)..n {
                let mut p = v;
                if four {
                    if (k % 2) == 0 {
                        p = v >> 4;
                    } else {
                        p = v & 15;
                    }
                }
                if x < w {
                    idx[(y * w) + x] = p;
                }
                x += 1;
            }
        } else if v == 0 {
            x = 0;  // end of line
            y += 1;
        } else if v == 1 {
            return;  // end of bitmap
        } else if v == 2 {
            if (i + 1) >= src.len {
                return;
            }
            x += @as(usize, src[i]);
            y += @as(usize, src[i + 1]);
            i += 2;
        } else {
            // an absolute run of v pixels, padded to 16 bits
            let count = @as(usize, v);
            let mut nbytes = count;
            if four {
                nbytes = (count + 1) / 2;
            }
            for k in @as(usize, 0)..count {
                let mut p: u8 = 0;
                if four {
                    let b = i + (k / 2);
                    if b < src.len {
                        p = src[b] >> 4;
                        if (k % 2) == 1 {
                            p = src[b] & 15;
                        }
                    }
                } else if (i + k) < src.len {
                    p = src[i + k];
                }
                if (x < w) and (y < h) {
                    idx[(y * w) + x] = p;
                }
                x += 1;
            }
            i += nbytes + (nbytes % 2);
        }
    }
}

// -----------------------------------------------------------------------------
// Encoding
// -----------------------------------------------------------------------------

fn put16(o: *mut strs.String, v: u32) !void {
    o.push(@truncate(u8, v))!;
    o.push(@truncate(u8, v >> 8))!;
}

fn put32(o: *mut strs.String, v: u32) !void {
    put16(o, v & 0xffff)!;
    put16(o, v >> 16)!;
}

/// Encodes an image as BMP (free the result with mem.free).
pub fn encode(img: *image.Image) ![]mut u8 {
    let mut s = strs.String.init();
    encode_to(s.writer(), img) catch |e| {
        s.deinit();
        return e;
    };
    return s.take();
}

/// Encodes an image as BMP to w, some rows at a time.
pub fn encode_to(wr: io.Writer, img: *image.Image) !void {
    if img.depth != image.Depth.U8 {
        let mut c = img.convert(img.channels, image.Depth.U8)!;
        defer c.deinit();
        return encode_to(wr, &c);
    }
    let w = img.width;
    let h = img.height;
    let gray = img.channels == 1;
    let alpha = img.has_alpha();
    let mut bpp: usize = 24;
    let mut hsize: usize = 40;
    let mut pal: usize = 0;
    if gray {
        bpp = 8;
        pal = 1024;
    } else if alpha {
        bpp = 32;
        hsize = 108;
    }
    let stride = (((w * bpp) + 31) / 32) * 4;
    let off = (14 + hsize) + pal;
    let size = off + (stride * h);
    if size > 0xffffffff {
        return error.Unsupported;
    }
    let mut buf = strs.String.init();
    defer buf.deinit();
    write_file(wr, &mut buf, img, size, off, hsize, bpp, stride)!;
}

// (o gathers the output, written to wr a few KiB at a time)
fn write_file(wr: io.Writer, o: *mut strs.String, img: *image.Image, size: usize, off: usize, hsize: usize, bpp: usize,
              stride: usize) !void {
    let w = img.width;
    let h = img.height;
    let gray = img.channels == 1;
    let alpha = img.has_alpha();
    o.reserve(@min(size, FLUSH_AT + stride))!;
    o.push_str("BM")!;
    put32(o, @truncate(u32, size))!;
    put32(o, 0)!;
    put32(o, @truncate(u32, off))!;
    put32(o, @truncate(u32, hsize))!;
    put32(o, @truncate(u32, w))!;
    put32(o, @truncate(u32, h))!;  // bottom-up
    put16(o, 1)!;
    put16(o, @truncate(u32, bpp))!;
    let mut compression: u32 = 0;
    if alpha and not gray {
        compression = 3;
    }
    put32(o, compression)!;
    put32(o, @truncate(u32, stride * h))!;
    put32(o, 2835)!;  // 72 dpi
    put32(o, 2835)!;
    let mut used: u32 = 0;
    if gray {
        used = 256;
    }
    put32(o, used)!;
    put32(o, 0)!;
    if hsize == 108 {
        put32(o, 0x00ff0000)!;
        put32(o, 0x0000ff00)!;
        put32(o, 0x000000ff)!;
        put32(o, 0xff000000)!;
        put32(o, 0x73524742)!;  // 'sRGB'
        for i in @as(usize, 0)..12 {
            put32(o, 0)!;  // endpoints and gamma (unused for sRGB)
        }
    }
    if gray {
        for i in @as(u32, 0)..256 {
            put32(o, (i * 0x010101))!;
        }
    }
    let px = img.samples8();
    let ch = img.channels;
    for yy in @as(usize, 0)..h {
        if o.len >= FLUSH_AT {
            wr.write_all(o.bytes())!;
            o.clear();
        }
        let y = h - 1 - yy;
        let start = o.len;
        for x in @as(usize, 0)..w {
            let i = ((y * w) + x) * ch;
            if gray {
                o.push(px[i])!;
            } else if ch == 2 {
                // gray with alpha: as BGRA
                o.push(px[i])!;
                o.push(px[i])!;
                o.push(px[i])!;
                o.push(px[i + 1])!;
            } else {
                o.push(px[i + 2])!;
                o.push(px[i + 1])!;
                o.push(px[i])!;
                if alpha {
                    o.push(px[i + 3])!;
                }
            }
        }
        while (o.len - start) < stride {
            o.push(0)!;
        }
    }
    wr.write_all(o.bytes())!;
}

const FLUSH_AT: usize = 16384;  // write out what is gathered at this size

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

test "round trips" {
    let kinds: [4]usize = [1, 2, 3, 4];
    for ch in kinds {
        let mut img = image.Image.init(13, 7, ch, image.Depth.U8)!;
        defer img.deinit();
        let px = img.samples8();
        for i in @as(usize, 0)..px.len {
            px[i] = @truncate(u8, (i * 37) + 11);
        }
        let enc = encode(&img)!;
        defer mem.free(enc);
        let mut back = decode(enc)!;
        defer back.deinit();
        @expect_eq(back.width, 13);
        @expect_eq(back.height, 7);
        for y in @as(usize, 0)..7 {
            for x in @as(usize, 0)..13 {
                @expect_eq(back.get(x, y).to_rgba8().to_u32(), img.get(x, y).to_rgba8().to_u32());
            }
        }
    }
}

test "rle8" {
    // 4x2, bottom-up: a run of 3 twos and an absolute run [5, 6, 7], end of line, then 1 0
    let mut f: [256]u8 = [0; 256];
    let hdr =
        "BM\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x28\x00\x00\x00\x04\x00\x00\x00\x02\x00\x00\x00\x01\x00\x08\x00\x01\x00\x00\x00";
    @mem_copy(f[..hdr.len], hdr);
    let off: usize = 14 + 40 + (4 * 8);
    f[10] = @truncate(u8, off);
    f[46] = 8;  // colours used
    for i in @as(usize, 0)..8 {
        f[54 + (4 * i)] = @truncate(u8, i * 30);  // blue = 30 i
    }
    let body = "\x03\x02\x00\x00\x00\x03\x05\x06\x07\x00\x00\x01";
    @mem_copy(f[off..off + body.len], body);
    let mut img = decode(f[..off + body.len])!;
    defer img.deinit();
    // bottom row (y = 1) is 2 2 2 0; the top row is 5 6 7 0
    @expect_eq(img.get(0, 1).to_rgba8().b, 60);
    @expect_eq(img.get(3, 1).to_rgba8().b, 0);
    @expect_eq(img.get(0, 0).to_rgba8().b, 150);
    @expect_eq(img.get(2, 0).to_rgba8().b, 210);
}

test "encode_to" {
    let mut img = image.Image.init(300, 40, 4, image.Depth.U8)!;
    defer img.deinit();
    for i in @as(usize, 0)..img.data.len {
        img.data[i] = @truncate(u8, (i * 31) ^ (i / 7));
    }
    let enc = encode(&img)!;
    defer mem.free(enc);
    let mut s = strs.String.init();
    defer s.deinit();
    encode_to(s.writer(), &img)!;
    @expect_eq(s.bytes(), enc[..]);
    let mut small: [100]u8 = [0; 100];
    let mut bw = io.BufferWriter.init(small[..]);
    encode_to(bw.writer(), &img) catch |e| {
        @expect_eq(e, error.NoSpaceLeft);
        return;
    };
    @trap();
}
