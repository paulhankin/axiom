/// A quantization table for quality 1-100, libjpeg's way (natural order).
fn scaled_table(base: *[64]u8, quality: u32) [64]u16 {
    let q = @min(@max(quality, 1), 100);
    let mut scale: u32 = 200 - (2 * q);
    if q < 50 {
        scale = 5000 / q;
    }
    let mut t: [64]u16 = [0; 64];
    for i in @as(usize, 0)..64 {
        let v = ((@as(u32, base[i]) * scale) + 50) / 100;
        t[i] = @truncate(u16, @min(@max(v, 1), 255));
    }
    return t;
}

/// Forward DCT (float, separable) of an 8x8 block of samples - 128, then
/// quantization; the result is in zigzag order.
fn fdct_quantize(block: *[64]f32, q: *[64]u16, out: []mut i16) void {
    _ = dct_table();
    let ct = &DCT_COS_T;
    let cos = &DCT_COS;
    // rows: tmp[y][u] = sum over x of block[y][x] cos[u][x], four u at a time
    let mut tmp: [64]f32 = [0.0; 64];
    for y in @as(usize, 0)..8 {
        let mut a0: f32x4 = @splat(@as(f32, 0.0));
        let mut a1: f32x4 = @splat(@as(f32, 0.0));
        for x in @as(usize, 0)..8 {
            let b: f32x4 = @splat(block[(y * 8) + x]);
            a0 = a0 + (b * @load(f32x4, ct[x * 8..(x * 8) + 4]));
            a1 = a1 + (b * @load(f32x4, ct[(x * 8) + 4..(x * 8) + 8]));
        }
        @store(tmp[y * 8..(y * 8) + 4], a0);
        @store(tmp[(y * 8) + 4..(y * 8) + 8], a1);
    }
    // columns: sum over y of tmp[y][u] cos[v][y]
    let mut res: [64]f32 = [0.0; 64];
    for v in @as(usize, 0)..8 {
        let mut a0: f32x4 = @splat(@as(f32, 0.0));
        let mut a1: f32x4 = @splat(@as(f32, 0.0));
        for y in @as(usize, 0)..8 {
            let c: f32x4 = @splat(cos[(v * 8) + y]);
            a0 = a0 + (@load(f32x4, tmp[y * 8..(y * 8) + 4]) * c);
            a1 = a1 + (@load(f32x4, tmp[(y * 8) + 4..(y * 8) + 8]) * c);
        }
        @store(res[v * 8..(v * 8) + 4], a0);
        @store(res[(v * 8) + 4..(v * 8) + 8], a1);
    }
    for n in @as(usize, 0)..64 {
        out[@as(usize, ZIGZAG_OF[n])] = @truncate(
            i16, @int_from_float(i32, @nearest(res[n] / @float_from_int(f32, q[n]))));
    }
}

// the zigzag position of each natural index
let ZIGZAG_OF: [64]u8 = [
    0,
    1,
    5,
    6,
    14,
    15,
    27,
    28,
    2,
    4,
    7,
    13,
    16,
    26,
    29,
    42,
    3,
    8,
    12,
    17,
    25,
    30,
    41,
    43,
    9,
    11,
    18,
    24,
    31,
    40,
    44,
    53,
    10,
    19,
    23,
    32,
    39,
    45,
    52,
    54,
    20,
    22,
    33,
    38,
    46,
    51,
    55,
    60,
    21,
    34,
    37,
    47,
    50,
    56,
    59,
    61,
    35,
    36,
    48,
    49,
    57,
    58,
    62,
    63,
];

let mut DCT_COS: [64]f32 = [0.0; 64];    // c(u) cos((2x + 1) u pi / 16) / 2
let mut DCT_COS_T: [64]f32 = [0.0; 64];  // transposed
let mut DCT_ONCE: sync.Once = sync.Once.{ state: 0 };

fn build_dct(_u: u8) void {
    for u in @as(usize, 0)..8 {
        let mut cu: f64 = 0.5;
        if u == 0 {
            cu = 0.35355339059327373;  // 1 / (2 sqrt 2)
        }
        for x in @as(usize, 0)..8 {
            let a = (@float_from_int(f64, (2 * x) + 1) * @float_from_int(f64, u)) * (3.14159265358979323846 / 16.0);
            DCT_COS[(u * 8) + x] = @float_cast(f32, cu * math.cos(a));
            DCT_COS_T[(x * 8) + u] = DCT_COS[(u * 8) + x];
        }
    }
}

fn dct_table() *[64]f32 {
    DCT_ONCE.call(build_dct, @as(u8, 0));
    return &DCT_COS;
}

/// Encodes as baseline JPEG (free the result with mem.free).
/// Encodes an image as baseline JPEG (free the result with mem.free).
pub fn encode(img: *image.Image, quality: u32, subsample: Subsample) ![]mut u8 {
    let mut s = strs.String.init();
    encode_to(s.writer(), img, quality, subsample) catch |e| {
        s.deinit();
        return e;
    };
    return s.take()!;
}

/// Encodes an image as baseline JPEG to wr. The image is transformed
/// first (the Huffman tables come from the coefficients), then the headers
/// and entropy-coded data are written a few KiB at a time.
pub fn encode_to(wr: io.Writer, img: *image.Image, quality: u32, subsample: Subsample) !void {
    if img.depth != image.Depth.U8 {
        let mut ch: usize = 3;
        if img.channels <= 2 {
            ch = 1;
        }
        let mut c = img.convert(ch, image.Depth.U8)!;
        defer c.deinit();
        return encode_to(wr, &c, quality, subsample);
    }
    let w = img.width;
    let h = img.height;
    if (w > 65535) or (h > 65535) or (w == 0) or (h == 0) {
        return error.Unsupported;
    }
    let gray = img.channels <= 2;  // alpha is dropped
    let mut ncomp: usize = 3;
    if gray {
        ncomp = 1;
    }
    let mut hs: usize = 1;  // luma sampling factors (chroma is 1x1)
    let mut vs: usize = 1;
    if not gray {
        if subsample == Subsample.S420 {
            hs = 2;
            vs = 2;
        } else if subsample == Subsample.S422 {
            hs = 2;
        }
    }
    let qt: [2][64]u16 = [scaled_table(&STD_LUMA, quality), scaled_table(&STD_CHROMA, quality)];
    let mcux = (w + (8 * hs) - 1) / (8 * hs);
    let mcuy = (h + (8 * vs) - 1) / (8 * vs);
    let blocks_per_mcu = (hs * vs) + (2 * (ncomp - 1));
    let nblocks = (mcux * mcuy) * blocks_per_mcu;
    let coefs = mem.alloc.[i16](nblocks * 64)!;
    defer mem.free(coefs);
    // the components at full resolution, padded to whole MCUs by
    // repeating the last column and row
    let pw = mcux * 8 * hs;
    let ph = mcuy * 8 * vs;
    let full = mem.alloc.[f32]((pw * ph) * ncomp)!;
    defer mem.free(full);
    let px = img.samples8();
    let sc = img.channels;
    for y in @as(usize, 0)..h {
        for x in @as(usize, 0)..w {
            let i = ((y * w) + x) * sc;
            let o = (y * pw) + x;
            if gray {
                full[o] = @float_from_int(f32, px[i]);
            } else {
                let r = @float_from_int(f32, px[i]);
                let g = @float_from_int(f32, px[i + 1]);
                let b = @float_from_int(f32, px[i + 2]);
                full[o] = ((0.299 * r) + (0.587 * g)) + (0.114 * b);
                full[(pw * ph) + o] = ((128.0 - (0.168736 * r)) - (0.331264 * g)) + (0.5 * b);
                full[(2 * (pw * ph)) + o] = ((128.0 + (0.5 * r)) - (0.418688 * g)) - (0.081312 * b);
            }
        }
    }
    for c in @as(usize, 0)..ncomp {
        let pl = full[(c * pw) * ph..((c + 1) * pw) * ph];
        for y in @as(usize, 0)..h {
            let last = pl[(y * pw) + w - 1];
            for x in w..pw {
                pl[(y * pw) + x] = last;
            }
        }
        for y in h..ph {
            @mem_copy(pl[y * pw..(y + 1) * pw], pl[(h - 1) * pw..h * pw]);
        }
    }
    // chroma: the average of the hs x vs pixels each sample covers
    let cw = mcux * 8;
    let chh = mcuy * 8;
    let mut nd: usize = 0;
    if not gray {
        nd = (cw * chh) * 2;
    }
    let down = mem.alloc.[f32](nd)!;
    defer mem.free(down);
    if not gray {
        for c in @as(usize, 1)..3 {
            let pl = full[(c * pw) * ph..((c + 1) * pw) * ph];
            let dp = down[((c - 1) * cw) * chh..(c * cw) * chh];
            for y in @as(usize, 0)..chh {
                if (hs == 2) and (vs == 2) {
                    let r0 = pl[(2 * y) * pw..((2 * y) + 1) * pw];
                    let r1 = pl[((2 * y) + 1) * pw..((2 * y) + 2) * pw];
                    let d = dp[y * cw..(y + 1) * cw];
                    for x in @as(usize, 0)..cw {
                        d[x] = (((r0[2 * x] + r0[(2 * x) + 1]) + r1[2 * x]) + r1[(2 * x) + 1]) / 4.0;
                    }
                    continue;
                }
                for x in @as(usize, 0)..cw {
                    let mut sum: f32 = 0.0;
                    for sy in @as(usize, 0)..vs {
                        for sx in @as(usize, 0)..hs {
                            sum += pl[(((y * vs) + sy) * pw) + (x * hs) + sx];
                        }
                    }
                    dp[(y * cw) + x] = sum / @float_from_int(f32, hs * vs);
                }
            }
        }
    }
    // transform every block, in MCU order
    let mut blk: usize = 0;
    let mut samples: [64]f32 = [0.0; 64];
    for my in @as(usize, 0)..mcuy {
        for mx in @as(usize, 0)..mcux {
            for c in @as(usize, 0)..ncomp {
                let mut bh: usize = 1;
                let mut bv: usize = 1;
                let mut pl = full[..pw * ph];
                let mut stride = pw;
                if c == 0 {
                    bh = hs;
                    bv = vs;
                } else {
                    pl = down[((c - 1) * cw) * chh..(c * cw) * chh];
                    stride = cw;
                }
                for by in @as(usize, 0)..bv {
                    for bx in @as(usize, 0)..bh {
                        let x0 = ((mx * bh) + bx) * 8;
                        let y0 = ((my * bv) + by) * 8;
                        for yy in @as(usize, 0)..8 {
                            let row = pl[((y0 + yy) * stride) + x0..((y0 + yy) * stride) + x0 + 8];
                            for xx in @as(usize, 0)..8 {
                                samples[(yy * 8) + xx] = row[xx] - 128.0;
                            }
                        }
                        let mut t: usize = 0;
                        if c > 0 {
                            t = 1;
                        }
                        fdct_quantize(&samples, &qt[t], coefs[blk * 64..(blk + 1) * 64]);
                        blk += 1;
                    }
                }
            }
        }
    }
    // Huffman tables from the symbol frequencies
    let mut freq: [4][257]u32 = [[0; 257]; 4];  // DC luma, AC luma, DC chroma, AC chroma
    let mut tables: [4]HuffTable = [HuffTable.{ bits: [0; 16], vals: [0; 256], nvals: 0, code: [0; 256],
                                                len: [0; 256] }; 4];
    walk(coefs, mcux * mcuy, hs * vs, ncomp, &mut freq, @ptr_from_int(*mut BitWriter, 8), false, &tables)!;
    for t in @as(usize, 0)..4 {
        if (t < 2) or not gray {
            build_huff(&freq[t], &mut tables[t]);
        }
    }
    // the file
    let mut hdrs = strs.String.init();
    defer hdrs.deinit();
    write_headers(&mut hdrs, w, h, ncomp, hs, vs, &qt, &tables)!;
    wr.write_all(hdrs.bytes())!;
    let mut bw = BitWriter.{ out: wr, buf: [0; 4096], len: 0, acc: 0, nbits: 0 };
    walk(coefs, mcux * mcuy, hs * vs, ncomp, &mut freq, &mut bw, true, &tables)!;
    // pad the last byte with ones
    bw.put(0x7f, 7)!;
    bw.buf[bw.len] = 0xff;
    bw.buf[bw.len + 1] = 0xd9;
    bw.len += 2;
    wr.write_all(bw.buf[..bw.len])!;
}

struct HuffTable {
    bits: [16]u8,
    vals: [256]u8,
    nvals: usize,
    code: [256]u16,  // by symbol
    len: [256]u8,
}

// Bits, most significant first, into buf, written to out when it fills.
struct BitWriter {
    out: io.Writer,
    buf: [4096]u8,
    len: usize,
    acc: u32,
    nbits: u32,

    fn put(self: *mut BitWriter, v: u32, n: u32) !void {
        self.acc = (self.acc << n) | (v & ((@as(u32, 1) << n) - 1));
        self.nbits += n;
        if self.len > (self.buf.len - 8) {
            self.out.write_all(self.buf[..self.len])!;
            self.len = 0;
        }
        while self.nbits >= 8 {
            let b = @truncate(u8, self.acc >> (self.nbits - 8));
            self.buf[self.len] = b;
            self.len += 1;
            if b == 0xff {
                self.buf[self.len] = 0;  // byte stuffing
                self.len += 1;
            }
            self.nbits -= 8;
        }
        self.acc = self.acc & ((@as(u32, 1) << self.nbits) - 1);
    }
}

fn bit_size(v: i32) u32 {
    let mut a = @abs(v);
    let mut n: u32 = 0;
    while a > 0 {
        n += 1;
        a = a >> 1;
    }
    return n;
}

/// Goes over the blocks' symbols: counting them, or writing them.
fn walk(coefs: []i16, nmcu: usize, luma_blocks: usize, ncomp: usize, freq: *mut [4][257]u32, bw: *mut BitWriter,
        emit: bool, tables: *[4]HuffTable) !void {
    let mut pred: [3]i32 = [0, 0, 0];
    let mut blk: usize = 0;
    for m in @as(usize, 0)..nmcu {
        for c in @as(usize, 0)..ncomp {
            let mut nb: usize = 1;
            if c == 0 {
                nb = luma_blocks;
            }
            let mut t: usize = 0;
            if c > 0 {
                t = 2;
            }
            for b in @as(usize, 0)..nb {
                let z = coefs[blk * 64..(blk + 1) * 64];
                blk += 1;
                let dc = @as(i32, z[0]);
                let diff = dc - pred[c];
                pred[c] = dc;
                let s = bit_size(diff);
                symbol(freq, bw, emit, tables, t, s, diff)!;
                let mut run: u32 = 0;
                for k in @as(usize, 1)..64 {
                    let v = @as(i32, z[k]);
                    if v == 0 {
                        run += 1;
                        continue;
                    }
                    while run >= 16 {
                        symbol(freq, bw, emit, tables, t + 1, 0xf0, 0)!;
                        run -= 16;
                    }
                    let sz = bit_size(v);
                    symbol(freq, bw, emit, tables, t + 1, (run << 4) | sz, v)!;
                    run = 0;
                }
                if run > 0 {
                    symbol(freq, bw, emit, tables, t + 1, 0, 0)!;  // end of block
                }
            }
        }
    }
}

/// Counts or writes one Huffman symbol and its extra bits (the low bits
/// of v, for a symbol whose size is sym & 15).
fn symbol(freq: *mut [4][257]u32, bw: *mut BitWriter, emit: bool, tables: *[4]HuffTable, t: usize, sym: u32,
          v: i32) !void {
    if not emit {
        freq[t][@as(usize, sym)] += 1;
        return;
    }
    let tb = &tables[t];
    let s = @as(usize, sym);
    bw.put(@as(u32, tb.code[s]), @as(u32, tb.len[s]))!;
    let n = sym & 15;
    if n > 0 {
        let mut e = v;
        if v < 0 {
            e = v - 1;  // ones' complement of the magnitude
        }
        bw.put(@bit_cast(u32, e), n)!;
    }
}

/// A length-limited (16 bits) Huffman code for the frequencies, as JPEG
/// requires (Annex K.2), with a reserved symbol so that no code is all ones.
fn build_huff(freq: *[257]u32, t: *mut HuffTable) void {
    let mut f: [257]u32 = [0; 257];
    @mem_copy(f[..], freq[..]);
    f[256] = 1;  // the reserved code point
    let mut codesize: [257]u32 = [0; 257];
    let mut others: [257]i32 = [-1; 257];
    loop {
        // the two least frequent (v1 the smaller, ties to the larger index)
        let mut v1: i32 = -1;
        let mut v2: i32 = -1;
        let mut f1: u32 = 0xffffffff;
        let mut f2: u32 = 0xffffffff;
        for i in @as(usize, 0)..257 {
            if f[i] != 0 {
                if f[i] <= f1 {
                    f2 = f1;
                    v2 = v1;
                    f1 = f[i];
                    v1 = @bit_cast(i32, @truncate(u32, i));
                } else if f[i] <= f2 {
                    f2 = f[i];
                    v2 = @bit_cast(i32, @truncate(u32, i));
                }
            }
        }
        if v2 < 0 {
            break;
        }
        let a = @as(usize, @bit_cast(u32, v1));
        let b = @as(usize, @bit_cast(u32, v2));
        f[a] += f[b];
        f[b] = 0;
        // lengthen every code in both trees
        let mut x = a;
        loop {
            codesize[x] += 1;
            if others[x] < 0 {
                break;
            }
            x = @as(usize, @bit_cast(u32, others[x]));
        }
        others[x] = v2;
        x = b;
        loop {
            codesize[x] += 1;
            if others[x] < 0 {
                break;
            }
            x = @as(usize, @bit_cast(u32, others[x]));
        }
    }
    let mut bits: [33]u32 = [0; 33];
    for i in @as(usize, 0)..257 {
        if codesize[i] > 0 {
            bits[@as(usize, codesize[i])] += 1;
        }
    }
    // limit lengths to 16 (K.3)
    let mut i: usize = 32;
    while i > 16 {
        while bits[i] > 0 {
            let mut j = i - 2;
            while bits[j] == 0 {
                j -= 1;
            }
            bits[i] -= 2;
            bits[i - 1] += 1;
            bits[j + 1] += 2;
            bits[j] -= 1;
        }
        i -= 1;
    }
    // drop the reserved code (the longest)
    i = 16;
    while bits[i] == 0 {
        i -= 1;
    }
    bits[i] -= 1;
    for k in @as(usize, 0)..16 {
        t.bits[k] = @truncate(u8, bits[k + 1]);
    }
    // symbols by code length, then value
    let mut n: usize = 0;
    for len in @as(u32, 1)..33 {
        for s in @as(usize, 0)..256 {
            if codesize[s] == len {
                t.vals[n] = @truncate(u8, s);
                n += 1;
            }
        }
    }
    t.nvals = n;
    // canonical codes
    let mut code: u32 = 0;
    let mut k: usize = 0;
    for len in @as(usize, 1)..17 {
        for c in @as(usize, 0)..@as(usize, t.bits[len - 1]) {
            let s = @as(usize, t.vals[k]);
            t.code[s] = @truncate(u16, code);
            t.len[s] = @truncate(u8, len);
            code += 1;
            k += 1;
        }
        code = code << 1;
    }
    t.nvals = k;
}

fn write_headers(o: *mut strs.String, w: usize, h: usize, ncomp: usize, hs: usize, vs: usize, qt: *[2][64]u16,
                 tables: *[4]HuffTable) JpegError!void {
    let soi_app0: [20]u8 = [
        0xff,
        0xd8,
        0xff,
        0xe0,
        0,
        16,
        'J',
        'F',
        'I',
        'F',
        0,
        1,
        1,
        0,
        0,
        1,
        0,
        1,
        0,
        0,
    ];
    o.push_str(soi_app0[..])!;
    let nq: usize = @min(ncomp, 2);
    for t in @as(usize, 0)..nq {
        let hdr: [5]u8 = [0xff, 0xdb, 0, 67, @truncate(u8, t)];
        o.push_str(hdr[..])!;
        for k in @as(usize, 0)..64 {
            o.push(@truncate(u8, qt[t][@as(usize, DEZIGZAG[k])]))!;
        }
    }
    let sof: [10]u8 = [
        0xff,
        0xc0,
        0,
        @truncate(u8, 8 + (3 * ncomp)),
        8,
        @truncate(u8, h >> 8),
        @truncate(u8, h),
        @truncate(u8, w >> 8),
        @truncate(u8, w),
        @truncate(u8, ncomp),
    ];
    o.push_str(sof[..])!;
    for c in @as(usize, 0)..ncomp {
        let mut samp: u8 = 0x11;
        let mut q: u8 = 1;
        if c == 0 {
            samp = @truncate(u8, (hs << 4) | vs);
            q = 0;
        }
        let comp: [3]u8 = [@truncate(u8, c + 1), samp, q];
        o.push_str(comp[..])!;
    }
    for t in @as(usize, 0)..4 {
        if (t >= 2) and (ncomp == 1) {
            continue;
        }
        let tb = &tables[t];
        let len = 2 + 17 + tb.nvals;
        let class = @truncate(u8, ((t % 2) << 4) | (t / 2));
        let hdr: [5]u8 = [0xff, 0xc4, @truncate(u8, len >> 8), @truncate(u8, len), class];
        o.push_str(hdr[..])!;
        o.push_str(tb.bits[..])!;
        o.push_str(tb.vals[..tb.nvals])!;
    }
    let sos_len = 6 + (2 * ncomp);
    let hdr: [5]u8 = [0xff, 0xda, 0, @truncate(u8, sos_len), @truncate(u8, ncomp)];
    o.push_str(hdr[..])!;
    for c in @as(usize, 0)..ncomp {
        let mut tabs: u8 = 0x00;
        if c > 0 {
            tabs = 0x11;
        }
        let comp: [2]u8 = [@truncate(u8, c + 1), tabs];
        o.push_str(comp[..])!;
    }
    let tail: [3]u8 = [0, 63, 0];
    o.push_str(tail[..])!;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

test "round trips" {
    let modes: [3]Subsample = [Subsample.S444, Subsample.S422, Subsample.S420];
    let chans: [2]usize = [1, 3];
    for ch in chans {
        for mode in modes {
            let mut img = image.Image.init(45, 29, ch, image.Depth.U8)!;
            defer img.deinit();
            let px = img.samples8();
            for i in @as(usize, 0)..px.len {
                px[i] = @truncate(u8, ((((i / ch) % 45) * 3) + ((i / (ch * 45)) * 2)) + ((i % ch) * 20));
            }
            let enc = encode(&img, 95, mode)!;
            defer mem.free(enc);
            @expect(is_jpeg(enc));
            let mut back = decode(enc)!;
            defer back.deinit();
            @expect_eq(back.width, 45);
            @expect_eq(back.height, 29);
            @expect_eq(back.channels, ch);
            // lossy, but close
            let mut worst: i32 = 0;
            for i in @as(usize, 0)..px.len {
                worst = @max(worst, @abs(@as(i32, px[i]) - @as(i32, back.data[i])));
            }
            @expect(worst <= 8);
        }
    }
}

test "rejects" {
    let bad: [3][]u8 = ["\xff\xd8\xff\xd9", "\xff\xd8\xff\xc3\x00\x02", "\xff\xd8\xff\xdb\x00\x05\x07"];
    for b in bad {
        _ = decode(b) catch continue;
        @trap();
    }
}

test "encode_to" {
    let mut img = image.Image.init(200, 120, 3, image.Depth.U8)!;
    defer img.deinit();
    for i in @as(usize, 0)..img.data.len {
        img.data[i] = @truncate(u8, (i * 31) ^ (i / 7));
    }
    let enc = encode(&img, 90, Subsample.S420)!;
    defer mem.free(enc);
    let mut s = strs.String.init();
    defer s.deinit();
    encode_to(s.writer(), &img, 90, Subsample.S420)!;
    @expect_eq(s.bytes(), enc[..]);
    let mut small: [1000]u8 = [0; 1000];
    let mut bw = io.BufferWriter.init(small[..]);
    encode_to(bw.writer(), &img, 90, Subsample.S420) catch |e| {
        @expect_eq(e, error.NoSpaceLeft);
        return;
    };
    @trap();
}
