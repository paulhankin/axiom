// =============================================================================
// std/graphics/image/jpeg.ax - JPEG (ITU T.81, JFIF) decoding and encoding.
//
//     let img = jpeg.decode(bytes)!;                 // U8 gray or RGB
//     let out = jpeg.encode(&img, 90, jpeg.Subsample.S420)!;  // mem.free it
//     jpeg.encode_to(w, &img, 90, jpeg.Subsample.S420)!;     // or to an io.Writer
//
// Decoding handles baseline, extended sequential and progressive Huffman-
// coded JPEGs with 8-bit samples: any sampling factors, restart intervals,
// grayscale, YCbCr, RGB and Adobe CMYK/YCCK. The IDCT, chroma upsampling and
// colour conversion are libjpeg's, so results match libjpeg's (and so most
// software's) exactly for common files. Arithmetic coding, 12-bit samples,
// lossless and hierarchical JPEG are not supported (Unsupported).
//
// Encoding writes baseline JFIF with the standard quantization tables
// scaled by quality (1-100, as libjpeg), 4:2:0, 4:2:2 or 4:4:4 chroma, and
// Huffman tables optimized for the image. Alpha is dropped; U16 and F32
// images are converted to 8 bits.
// =============================================================================

import "../../io.ax" as io;
import "../../math.ax" as math;
import "../../mem.ax" as mem;
import "../../str.ax" as strs;
import "../../sync.ax" as sync;
import "../image.ax" as image;

pub error JpegError { Corrupt, Unsupported, OutOfMemory, NotFound, IoError, TooLarge, Done, InvalidUtf8 }

/// The chroma resolution an encoded image keeps.
pub enum Subsample: u8 {
    S444,  // full-resolution chroma
    S422,  // half horizontally
    S420,  // half both ways (the usual)
}

/// Whether data starts like a JPEG file.
pub fn is_jpeg(data: []u8) bool {
    return (data.len >= 3) and (data[0] == 0xff) and (data[1] == 0xd8) and (data[2] == 0xff);
}

// the natural (row-major) index of each zigzag position, with padding so
// that a corrupt run past 63 stays in bounds
let DEZIGZAG: [80]u8 = [
    0,
    1,
    8,
    16,
    9,
    2,
    3,
    10,
    17,
    24,
    32,
    25,
    18,
    11,
    4,
    5,
    12,
    19,
    26,
    33,
    40,
    48,
    41,
    34,
    27,
    20,
    13,
    6,
    7,
    14,
    21,
    28,
    35,
    42,
    49,
    56,
    57,
    50,
    43,
    36,
    29,
    22,
    15,
    23,
    30,
    37,
    44,
    51,
    58,
    59,
    52,
    45,
    38,
    31,
    39,
    46,
    53,
    60,
    61,
    54,
    47,
    55,
    62,
    63,
    63,
    63,
    63,
    63,
    63,
    63,
    63,
    63,
    63,
    63,
    63,
    63,
    63,
    63,
    63,
    63,
];

// -----------------------------------------------------------------------------
// Huffman decoding
// -----------------------------------------------------------------------------

const FAST_BITS: u32 = 9;

/// More scans than this is not a real image (progressive files use a dozen or so).
const MAX_SCANS: usize = 256;

struct Huffman {
    fast: [512]u8,  // by the next 9 bits: the code's index, or 255
    code: [256]u16,
    values: [256]u8,
    size: [257]u8,
    maxcode: [18]u32,
    delta: [17]i32,  // code to index
    defined: bool,

    fn build(self: *mut Huffman, counts: []u8, values: []u8) JpegError!void {
        let mut k: usize = 0;
        for i in @as(usize, 0)..16 {
            for j in @as(usize, 0)..@as(usize, counts[i]) {
                if k >= 256 {
                    return error.Corrupt;
                }
                self.size[k] = @truncate(u8, i + 1);
                k += 1;
            }
        }
        self.size[k] = 0;
        let mut code: u32 = 0;
        k = 0;
        for j in @as(usize, 1)..17 {
            self.delta[j] = @bit_cast(i32, @truncate(u32, k)) - @bit_cast(i32, code);
            if @as(usize, self.size[k]) == j {
                while @as(usize, self.size[k]) == j {
                    self.code[k] = @truncate(u16, code);
                    code += 1;
                    k += 1;
                }
                if (code - 1) >= (@as(u32, 1) << @truncate(u32, j)) {
                    return error.Corrupt;  // bad code lengths
                }
            }
            self.maxcode[j] = code << @truncate(u32, 16 - j);
            code = code << 1;
        }
        self.maxcode[17] = 0xffffffff;
        for i in @as(usize, 0)..512 {
            self.fast[i] = 255;
        }
        for i in @as(usize, 0)..k {
            let s = @as(u32, self.size[i]);
            if s <= FAST_BITS {
                let c = @as(usize, self.code[i]) << @truncate(u32, FAST_BITS - s);
                let m = @as(usize, 1) << @truncate(u32, FAST_BITS - s);
                for j in @as(usize, 0)..m {
                    self.fast[c + j] = @truncate(u8, i);
                }
            }
        }
        @mem_copy(self.values[..values.len], values);
        self.defined = true;
    }
}

struct Component {
    id: u8,
    h: usize,
    v: usize,
    tq: usize,  // quantization table
    td: usize,  // DC table (in the current scan)
    ta: usize,  // AC table
    x: usize,   // samples across and down (before upsampling)
    y: usize,
    bw: usize,  // blocks across and down, padded to whole MCUs
    bh: usize,
    coeffs: []mut i16,  // 64 per block, zigzag-free (natural order), not dequantized
    pixels: []mut u8,   // bw * 8 by bh * 8
    dc_pred: i32,
}

struct Decoder {
    data: []u8,
    pos: usize,
    // the bit reader
    code_buffer: u32,
    code_bits: u32,
    marker: u8,  // a marker met inside entropy-coded data, or 0
    nomore: bool,
    fake: usize,  // zero bytes supplied past the end of the scan's data
    scans: usize,
    // frame
    width: usize,
    height: usize,
    progressive: bool,
    ncomp: usize,
    comp: [4]Component,
    hmax: usize,
    vmax: usize,
    mcux: usize,
    mcuy: usize,
    quant: [4][64]u16,  // natural order
    dc: [4]Huffman,
    ac: [4]Huffman,
    restart_interval: usize,
    adobe_transform: i32,  // -1 if no Adobe marker
    jfif: bool,
    // the current scan
    scan_comp: [4]usize,
    scan_n: usize,
    spec_start: usize,
    spec_end: usize,
    succ_high: u32,
    succ_low: u32,
    eob_run: i32,
    todo: usize,
    got_frame: bool,

    fn get8(self: *mut Decoder) u8 {
        if self.pos >= self.data.len {
            return 0;
        }
        let b = self.data[self.pos];
        self.pos += 1;
        return b;
    }

    fn get16(self: *mut Decoder) usize {
        let hi = @as(usize, self.get8());
        return (hi << 8) | @as(usize, self.get8());
    }

    fn grow_buffer(self: *mut Decoder) void {
        while self.code_bits <= 24 {
            let mut b: u32 = 0;
            if self.nomore {
                self.fake += 1;
            } else {
                b = @as(u32, self.get8());
                if b == 0xff {
                    let mut c = self.get8();
                    while c == 0xff {
                        c = self.get8();  // fill bytes
                    }
                    if c != 0 {
                        self.marker = c;
                        self.nomore = true;
                        return;
                    }
                }
            }
            self.code_buffer = self.code_buffer | (b << (24 - self.code_bits));
            self.code_bits += 8;
        }
    }

    fn decode(self: *mut Decoder, h: *Huffman) JpegError!u32 {
        if self.code_bits < 16 {
            self.grow_buffer();
        }
        let c = @as(usize, (self.code_buffer >> (32 - FAST_BITS)) & 511);
        let k = h.fast[c];
        if k < 255 {
            let s = @as(u32, h.size[@as(usize, k)]);
            if s > self.code_bits {
                return error.Corrupt;
            }
            self.code_buffer = self.code_buffer << s;
            self.code_bits -= s;
            return @as(u32, h.values[@as(usize, k)]);
        }
        let temp = self.code_buffer >> 16;
        let mut n: usize = @as(usize, FAST_BITS) + 1;
        while temp >= h.maxcode[n] {
            n += 1;
        }
        if (n == 17) or (@as(u32, @truncate(u8, n)) > self.code_bits) {
            return error.Corrupt;
        }
        let nn = @truncate(u32, n);
        let idx = @bit_cast(i32, (self.code_buffer >> (32 - nn)) & ((@as(u32, 1) << nn) - 1)) + h.delta[n];
        self.code_bits -= nn;
        self.code_buffer = self.code_buffer << nn;
        if (idx < 0) or (idx > 255) {
            return error.Corrupt;
        }
        return @as(u32, h.values[@as(usize, @bit_cast(u32, idx))]);
    }

    fn get_bits(self: *mut Decoder, n: u32) u32 {
        if n == 0 {
            return 0;
        }
        if self.code_bits < n {
            self.grow_buffer();
        }
        let v = self.code_buffer >> (32 - n);
        self.code_buffer = self.code_buffer << n;
        self.code_bits -= @min(n, self.code_bits);
        return v;
    }

    fn get_bit(self: *mut Decoder) bool {
        return self.get_bits(1) != 0;
    }

    /// n bits as a signed value (JPEG's EXTEND).
    fn receive_extend(self: *mut Decoder, n: u32) i32 {
        if n == 0 {
            return 0;
        }
        let v = @bit_cast(i32, self.get_bits(n));
        if v < (@as(i32, 1) << (n - 1)) {
            return (v - (@as(i32, 1) << n)) + 1;
        }
        return v;
    }

    fn reset(self: *mut Decoder) void {
        self.code_bits = 0;
        self.code_buffer = 0;
        self.nomore = false;
        self.fake = 0;
        for i in @as(usize, 0)..self.ncomp {
            self.comp[i].dc_pred = 0;
        }
        self.marker = 0;
        self.eob_run = 0;
        self.todo = self.restart_interval;
        if self.todo == 0 {
            self.todo = 0x7fffffff;
        }
    }

    // --- blocks --------------------------------------------------------------

    fn block_baseline(self: *mut Decoder, c: usize, data: []mut i16) JpegError!void {
        let t = self.decode(&self.dc[self.comp[c].td])!;
        if t > 15 {
            return error.Corrupt;
        }
        let dc = self.comp[c].dc_pred +% self.receive_extend(t);
        self.comp[c].dc_pred = dc;
        data[0] = sat16(dc);
        let h = &self.ac[self.comp[c].ta];
        let mut k: usize = 1;
        while k < 64 {
            let rs = self.decode(h)!;
            let s = rs & 15;
            let r = @as(usize, rs >> 4);
            if s == 0 {
                if rs != 0xf0 {
                    break;
                }
                k += 16;
            } else {
                k += r;
                if k > 63 {
                    return error.Corrupt;
                }
                data[@as(usize, DEZIGZAG[k])] = sat16(self.receive_extend(s));
                k += 1;
            }
        }
    }

    fn block_prog_dc(self: *mut Decoder, c: usize, data: []mut i16) JpegError!void {
        if self.spec_end != 0 {
            return error.Corrupt;
        }
        if self.succ_high == 0 {
            let t = self.decode(&self.dc[self.comp[c].td])!;
            if t > 15 {
                return error.Corrupt;
            }
            let dc = self.comp[c].dc_pred +% self.receive_extend(t);
            self.comp[c].dc_pred = dc;
            data[0] = sat16(dc *% (@as(i32, 1) << self.succ_low));
        } else if self.get_bit() {
            data[0] = data[0] | @truncate(i16, @as(i32, 1) << self.succ_low);
        }
    }

    fn block_prog_ac(self: *mut Decoder, c: usize, data: []mut i16) JpegError!void {
        if self.spec_start == 0 {
            return error.Corrupt;
        }
        let h = &self.ac[self.comp[c].ta];
        if self.succ_high == 0 {
            if self.eob_run > 0 {
                self.eob_run -= 1;
                return;
            }
            let mut k = self.spec_start;
            while k <= self.spec_end {
                let rs = self.decode(h)!;
                let s = rs & 15;
                let r = rs >> 4;
                if s == 0 {
                    if r < 15 {
                        self.eob_run = @as(i32, 1) << r;
                        if r > 0 {
                            self.eob_run += @bit_cast(i32, self.get_bits(r));
                        }
                        self.eob_run -= 1;
                        break;
                    }
                    k += 16;
                } else {
                    k += @as(usize, r);
                    if k > 63 {
                        return error.Corrupt;
                    }
                    data[@as(usize, DEZIGZAG[k])] = sat16(self.receive_extend(s) *% (@as(i32, 1) << self.succ_low));
                    k += 1;
                }
            }
            return;
        }
        // refinement
        let bit = @truncate(i16, @as(i32, 1) << self.succ_low);
        if self.eob_run > 0 {
            self.eob_run -= 1;
            for k in self.spec_start..self.spec_end + 1 {
                let z = @as(usize, DEZIGZAG[k]);
                if data[z] != 0 {
                    refine(self, data, z, bit);
                }
            }
            return;
        }
        let mut k = self.spec_start;
        while k <= self.spec_end {
            let rs = self.decode(h)!;
            let mut s: i16 = 0;
            let mut r = @as(i32, @bit_cast(i32, rs >> 4));
            let sz = rs & 15;
            if sz == 0 {
                if r < 15 {
                    self.eob_run = (@as(i32, 1) << @bit_cast(u32, r)) - 1;
                    if r > 0 {
                        self.eob_run += @bit_cast(i32, self.get_bits(@bit_cast(u32, r)));
                    }
                    r = 64;  // the rest of the band is zero history
                }
                // r = 15: a run of 16 zeros
            } else {
                if sz != 1 {
                    return error.Corrupt;
                }
                if self.get_bit() {
                    s = bit;
                } else {
                    s = -bit;
                }
            }
            while k <= self.spec_end {
                let z = @as(usize, DEZIGZAG[k]);
                k += 1;
                if data[z] != 0 {
                    refine(self, data, z, bit);
                } else {
                    if r == 0 {
                        data[z] = s;
                        break;
                    }
                    r -= 1;
                }
            }
        }
    }

    // --- scans ---------------------------------------------------------------

    fn decode_scan(self: *mut Decoder) JpegError!void {
        self.reset();
        if self.scan_n == 1 {
            // not interleaved: the component's own blocks, in raster order
            let c = self.scan_comp[0];
            let w = (self.comp[c].x + 7) / 8;
            let h = (self.comp[c].y + 7) / 8;
            for j in @as(usize, 0)..h {
                for i in @as(usize, 0)..w {
                    let at = ((j * self.comp[c].bw) + i) * 64;
                    self.block(c, self.comp[c].coeffs[at..at + 64])!;
                    if not self.after_mcu()! {
                        return;
                    }
                }
            }
            return;
        }
        for j in @as(usize, 0)..self.mcuy {
            for i in @as(usize, 0)..self.mcux {
                for k in @as(usize, 0)..self.scan_n {
                    let c = self.scan_comp[k];
                    for y in @as(usize, 0)..self.comp[c].v {
                        for x in @as(usize, 0)..self.comp[c].h {
                            let bx = (i * self.comp[c].h) + x;
                            let by = (j * self.comp[c].v) + y;
                            let at = ((by * self.comp[c].bw) + bx) * 64;
                            self.block(c, self.comp[c].coeffs[at..at + 64])!;
                        }
                    }
                }
                if not self.after_mcu()! {
                    return;
                }
            }
        }
    }

    fn block(self: *mut Decoder, c: usize, data: []mut i16) JpegError!void {
        if not self.progressive {
            return self.block_baseline(c, data);
        }
        if self.spec_start == 0 {
            return self.block_prog_dc(c, data);
        }
        return self.block_prog_ac(c, data);
    }

    /// Counts down the restart interval; false once the scan has ended.
    fn after_mcu(self: *mut Decoder) JpegError!bool {
        // a scan whose data ran out long ago is over (a truncated or
        // hostile file must not cost a full decode per scan)
        if self.fake > 1024 {
            return false;
        }
        self.todo -= 1;
        if self.todo == 0 {
            if self.code_bits < 24 {
                self.grow_buffer();
            }
            if (self.marker < 0xd0) or (self.marker > 0xd7) {
                return false;  // no restart marker: the data ends here
            }
            self.reset();
        }
        return true;
    }

    // --- markers -------------------------------------------------------------

    /// The next marker (after entropy-coded data, skipping to it).
    fn next_marker(self: *mut Decoder) u8 {
        if self.marker != 0 {
            let m = self.marker;
            self.marker = 0;
            return m;
        }
        while self.pos < self.data.len {
            if self.get8() == 0xff {
                let mut c = self.get8();
                while c == 0xff {
                    c = self.get8();
                }
                if c != 0 {
                    return c;
                }
            }
        }
        return 0xd9;  // treat the end of the data as EOI
    }

    fn segment(self: *mut Decoder) JpegError![]u8 {
        let len = self.get16();
        if (len < 2) or ((self.pos + len - 2) > self.data.len) {
            return error.Corrupt;
        }
        let s = self.data[self.pos..self.pos + len - 2];
        self.pos += len - 2;
        return s;
    }

    fn read_dqt(self: *mut Decoder, s: []u8) JpegError!void {
        let mut i: usize = 0;
        while i < s.len {
            let pq = s[i] >> 4;
            let tq = @as(usize, s[i] & 15);
            i += 1;
            if (tq > 3) or (pq > 1) {
                return error.Corrupt;
            }
            let n = 64 * (@as(usize, pq) + 1);
            if (i + n) > s.len {
                return error.Corrupt;
            }
            for k in @as(usize, 0)..64 {
                let mut v = @as(u16, s[i + k]);
                if pq == 1 {
                    v = (@as(u16, s[i + (2 * k)]) << 8) | @as(u16, s[i + (2 * k) + 1]);
                }
                self.quant[tq][@as(usize, DEZIGZAG[k])] = v;
            }
            i += n;
        }
    }

    fn read_dht(self: *mut Decoder, s: []u8) JpegError!void {
        let mut i: usize = 0;
        while i < s.len {
            if (i + 17) > s.len {
                return error.Corrupt;
            }
            let tc = s[i] >> 4;
            let th = @as(usize, s[i] & 15);
            if (tc > 1) or (th > 3) {
                return error.Corrupt;
            }
            let counts = s[i + 1..i + 17];
            let mut n: usize = 0;
            for c in counts {
                n += @as(usize, c);
            }
            i += 17;
            if ((i + n) > s.len) or (n > 256) {
                return error.Corrupt;
            }
            if tc == 0 {
                self.dc[th].build(counts, s[i..i + n])!;
            } else {
                self.ac[th].build(counts, s[i..i + n])!;
            }
            i += n;
        }
    }

    fn read_sof(self: *mut Decoder, s: []u8) JpegError!void {
        if self.got_frame {
            return error.Corrupt;
        }
        if (s.len < 6) or (s[0] != 8) {
            return error.Unsupported;  // 12-bit samples
        }
        self.height = (@as(usize, s[1]) << 8) | @as(usize, s[2]);
        self.width = (@as(usize, s[3]) << 8) | @as(usize, s[4]);
        self.ncomp = @as(usize, s[5]);
        if (self.width == 0) or (self.height == 0) {
            return error.Unsupported;  // height from a DNL marker
        }
        if (self.ncomp != 1) and (self.ncomp != 3) and (self.ncomp != 4) {
            return error.Unsupported;
        }
        if s.len < (6 + (3 * self.ncomp)) {
            return error.Corrupt;
        }
        if (self.width * self.height) > image.MAX_PIXELS {
            return error.Corrupt;
        }
        self.hmax = 1;
        self.vmax = 1;
        for i in @as(usize, 0)..self.ncomp {
            let b = s[6 + (3 * i)..9 + (3 * i)];
            let h = @as(usize, b[1] >> 4);
            let v = @as(usize, b[1] & 15);
            if (h < 1) or (h > 4) or (v < 1) or (v > 4) or (b[2] > 3) {
                return error.Corrupt;
            }
            self.comp[i] = Component.{
                id: b[0],
                h: h,
                v: v,
                tq: @as(usize, b[2]),
                td: 0,
                ta: 0,
                x: 0,
                y: 0,
                bw: 0,
                bh: 0,
                coeffs: self.comp[i].coeffs,
                pixels: self.comp[i].pixels,
                dc_pred: 0,
            };
            self.hmax = @max(self.hmax, h);
            self.vmax = @max(self.vmax, v);
        }
        // every block costs at least a bit (its DC code in the first scan), so
        // a file too small for the frame it declares is broken: stop before
        // allocating and decoding gigabytes for it
        let px = @mul_checked(self.width, self.height) catch return error.Corrupt;
        if (px / 512) > self.data.len {
            return error.Corrupt;
        }
        // (as libjpeg: fractional sampling ratios are not supported)
        for i in @as(usize, 0)..self.ncomp {
            if ((self.hmax % self.comp[i].h) != 0) or ((self.vmax % self.comp[i].v) != 0) {
                return error.Unsupported;
            }
        }
        self.mcux = (self.width + (8 * self.hmax) - 1) / (8 * self.hmax);
        self.mcuy = (self.height + (8 * self.vmax) - 1) / (8 * self.vmax);
        for i in @as(usize, 0)..self.ncomp {
            let c = &mut self.comp[i];
            c.x = ((self.width * c.h) + self.hmax - 1) / self.hmax;
            c.y = ((self.height * c.v) + self.vmax - 1) / self.vmax;
            c.bw = self.mcux * c.h;
            c.bh = self.mcuy * c.v;
            c.coeffs = mem.alloc_zeroed.[i16]((c.bw * c.bh) * 64)!;
            c.pixels = mem.alloc.[u8]((c.bw * c.bh) * 64)!;
        }
        self.got_frame = true;
    }

    fn read_sos(self: *mut Decoder, s: []u8) JpegError!void {
        if not self.got_frame or (s.len < 1) {
            return error.Corrupt;
        }
        let n = @as(usize, s[0]);
        if (n < 1) or (n > self.ncomp) or (s.len != (4 + (2 * n))) {
            return error.Corrupt;
        }
        for i in @as(usize, 0)..n {
            let id = s[1 + (2 * i)];
            let t = s[2 + (2 * i)];
            let mut found = false;
            for c in @as(usize, 0)..self.ncomp {
                if self.comp[c].id == id {
                    self.scan_comp[i] = c;
                    self.comp[c].td = @as(usize, t >> 4);
                    self.comp[c].ta = @as(usize, t & 15);
                    found = true;
                }
            }
            if not found or ((t >> 4) > 3) or ((t & 15) > 3) {
                return error.Corrupt;
            }
        }
        self.scan_n = n;
        let b = s[1 + (2 * n)..];
        self.spec_start = @as(usize, b[0]);
        self.spec_end = @as(usize, b[1]);
        self.succ_high = @as(u32, b[2] >> 4);
        self.succ_low = @as(u32, b[2] & 15);
        if self.progressive {
            if (self.spec_start > 63) or (self.spec_end > 63) or (self.spec_start > self.spec_end) or
               (self.succ_high > 13) or (self.succ_low > 13) {
                return error.Corrupt;
            }
            if (self.spec_start > 0) and (n != 1) {
                return error.Corrupt;  // AC scans hold one component
            }
        } else {
            self.spec_start = 0;
            self.spec_end = 63;
            self.succ_high = 0;
            self.succ_low = 0;
        }
        // the tables the scan needs
        for i in @as(usize, 0)..n {
            let c = &self.comp[self.scan_comp[i]];
            if (self.spec_start == 0) and (self.succ_high == 0) and not self.dc[c.td].defined {
                return error.Corrupt;
            }
            if (self.spec_end > 0) and not self.ac[c.ta].defined {
                return error.Corrupt;
            }
        }
    }

    fn free(self: *mut Decoder) void {
        for i in @as(usize, 0)..4 {
            if self.comp[i].coeffs.len > 0 {
                mem.free(self.comp[i].coeffs);
                mem.free(self.comp[i].pixels);
            }
        }
    }
}

fn refine(d: *mut Decoder, data: []mut i16, z: usize, bit: i16) void {
    if d.get_bit() and ((data[z] & bit) == 0) {
        if data[z] >= 0 {
            data[z] = data[z] +% bit;
        } else {
            data[z] = data[z] -% bit;
        }
    }
}

fn sat16(v: i32) i16 {
    return @truncate(i16, @min(@max(v, -32768), 32767));
}

// -----------------------------------------------------------------------------
// IDCT: libjpeg's jidctint ("islow"). Valid 8-bit data fits in 32 bits (as
// in libjpeg's 32-bit builds); wrapping arithmetic keeps hostile
// coefficients from trapping (they only produce garbage pixels).
// -----------------------------------------------------------------------------

const CONST_BITS: u32 = 13;
const PASS1_BITS: u32 = 2;
const F0298: i32 = 2446;
const F0390: i32 = 3196;
const F0541: i32 = 4433;
const F0765: i32 = 6270;
const F0899: i32 = 7373;
const F1175: i32 = 9633;
const F1501: i32 = 12299;
const F1847: i32 = 15137;
const F1961: i32 = 16069;
const F2053: i32 = 16819;
const F2562: i32 = 20995;
const F3072: i32 = 25172;

fn clamp8(v: i32) u8 {
    return @truncate(u8, @bit_cast(u32, @min(@max(v, 0), 255)));
}

/// Dequantizes and inverse-transforms a block into out (row stride given).
fn idct_block(coef: []i16, q: *[64]u16, out: []mut u8, stride: usize) void {
    let mut ws: [64]i32 = [0; 64];
    for col in @as(usize, 0)..8 {
        if (((coef[8 + col] | coef[16 + col]) | (coef[24 + col] | coef[32 + col])) |
            ((coef[40 + col] | coef[48 + col]) | coef[56 + col])) == 0 {
            let dc = (@as(i32, coef[col]) *% @as(i32, q[col])) << PASS1_BITS;
            for r in @as(usize, 0)..8 {
                ws[(r * 8) + col] = dc;
            }
            continue;
        }
        idct_1d(ws[..], col, 8, coef, q, @as(i32, 1) << (CONST_BITS - PASS1_BITS - 1), CONST_BITS - PASS1_BITS);
    }
    let mut row_out: [8]i32 = [0; 8];
    for row in @as(usize, 0)..8 {
        // the range centre (128) and the rounding are added before the descale
        let round = (@as(i32, 1) << ((CONST_BITS + PASS1_BITS) + 2)) + (
            @as(i32, 128) << ((CONST_BITS + PASS1_BITS) + 3));
        idct_row(ws[row * 8..(row * 8) + 8], row_out[..], round, (CONST_BITS + PASS1_BITS) + 3);
        let o = out[row * stride..(row * stride) + 8];
        for c in @as(usize, 0)..8 {
            o[c] = clamp8(row_out[c]);
        }
    }
}

/// Pass 1: column col of the (dequantized) coefficients into the workspace.
fn idct_1d(ws: []mut i32, col: usize, step: usize, coef: []i16, q: *[64]u16, round: i32, shift: u32) void {
    let v0 = @as(i32, coef[col]) *% @as(i32, q[col]);
    let v1 = @as(i32, coef[col + 8]) *% @as(i32, q[col + 8]);
    let v2 = @as(i32, coef[col + 16]) *% @as(i32, q[col + 16]);
    let v3 = @as(i32, coef[col + 24]) *% @as(i32, q[col + 24]);
    let v4 = @as(i32, coef[col + 32]) *% @as(i32, q[col + 32]);
    let v5 = @as(i32, coef[col + 40]) *% @as(i32, q[col + 40]);
    let v6 = @as(i32, coef[col + 48]) *% @as(i32, q[col + 48]);
    let v7 = @as(i32, coef[col + 56]) *% @as(i32, q[col + 56]);
    let r = butterfly(v0, v1, v2, v3, v4, v5, v6, v7, round, shift);
    for k in @as(usize, 0)..8 {
        ws[(k * step) + col] = r[k];
    }
}

/// Pass 2: one row of the workspace.
fn idct_row(v: []i32, out: []mut i32, round: i32, shift: u32) void {
    let r = butterfly(v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], round, shift);
    for k in @as(usize, 0)..8 {
        out[k] = r[k];
    }
}

/// The 8-point IDCT; outputs (x + round) >> shift.
fn butterfly(v0: i32, v1: i32, v2: i32, v3: i32, v4: i32, v5: i32, v6: i32, v7: i32, round: i32, shift: u32) [8]i32 {
    // even part
    let z1 = (v2 +% v6) *% F0541;
    let tmp2 = z1 +% (v6 *% -F1847);
    let tmp3 = z1 +% (v2 *% F0765);
    let t0 = ((v0 +% v4) << CONST_BITS) +% round;
    let t1 = ((v0 -% v4) << CONST_BITS) +% round;
    let tmp10 = t0 +% tmp3;
    let tmp13 = t0 -% tmp3;
    let tmp11 = t1 +% tmp2;
    let tmp12 = t1 -% tmp2;
    // odd part
    let za = v7 +% v1;
    let zb = v5 +% v3;
    let zc = v7 +% v3;
    let zd = v5 +% v1;
    let z5 = (zc +% zd) *% F1175;
    let a1 = za *% -F0899;
    let b2 = zb *% -F2562;
    let c3 = (zc *% -F1961) +% z5;
    let d4 = (zd *% -F0390) +% z5;
    let o0 = ((v7 *% F0298) +% a1) +% c3;
    let o1 = ((v5 *% F2053) +% b2) +% d4;
    let o2 = ((v3 *% F3072) +% b2) +% c3;
    let o3 = ((v1 *% F1501) +% a1) +% d4;
    return [
        (tmp10 +% o3) >> shift,
        (tmp11 +% o2) >> shift,
        (tmp12 +% o1) >> shift,
        (tmp13 +% o0) >> shift,
        (tmp13 -% o0) >> shift,
        (tmp12 -% o1) >> shift,
        (tmp11 -% o2) >> shift,
        (tmp10 -% o3) >> shift,
    ];
}

// -----------------------------------------------------------------------------
// Decoding
// -----------------------------------------------------------------------------

pub fn decode(data: []u8) JpegError!image.Image {
    if not is_jpeg(data) {
        return error.Corrupt;
    }
    let d = mem.new_zeroed.[Decoder]()!;
    defer mem.destroy(d);
    for i in @as(usize, 0)..4 {
        d.comp[i].coeffs = @slice_from_ptr(@ptr_from_int(*mut i16, 2), 0);
        d.comp[i].pixels = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
    }
    defer d.free();
    d.data = data;
    d.pos = 2;
    d.adobe_transform = -1;
    loop {
        let m = d.next_marker();
        if m == 0xd9 {
            break;  // EOI
        }
        if (m == 0xc0) or (m == 0xc1) or (m == 0xc2) {
            d.progressive = m == 0xc2;
            d.read_sof(d.segment()!)!;
        } else if ((m >= 0xc3) and (m <= 0xcf)) and (m != 0xc4) and (m != 0xc8) and (m != 0xcc) {
            return error.Unsupported;  // lossless, hierarchical or arithmetic
        } else if m == 0xc4 {
            d.read_dht(d.segment()!)!;
        } else if m == 0xdb {
            d.read_dqt(d.segment()!)!;
        } else if m == 0xdd {
            let s = d.segment()!;
            if s.len != 2 {
                return error.Corrupt;
            }
            d.restart_interval = (@as(usize, s[0]) << 8) | @as(usize, s[1]);
        } else if m == 0xda {
            d.scans += 1;
            if d.scans > MAX_SCANS {
                return error.Corrupt;
            }
            d.read_sos(d.segment()!)!;
            d.decode_scan()!;
        } else if m == 0xee {
            let s = d.segment()!;
            if (s.len >= 12) and @mem_eq(s[..5], "Adobe") {
                d.adobe_transform = @as(i32, s[11]);
            }
        } else if m == 0xe0 {
            let s = d.segment()!;
            if (s.len >= 5) and @mem_eq(s[..5], "JFIF\x00") {
                d.jfif = true;
            }
        } else if (m >= 0xd0) and (m <= 0xd7) {
            // a stray restart marker: nothing to skip
        } else {
            _ = d.segment()!;
        }
    }
    if not d.got_frame {
        return error.Corrupt;
    }
    // inverse transforms
    for c in @as(usize, 0)..d.ncomp {
        let comp = &d.comp[c];
        let q = &d.quant[comp.tq];
        let stride = comp.bw * 8;
        for by in @as(usize, 0)..comp.bh {
            for bx in @as(usize, 0)..comp.bw {
                let at = ((by * comp.bw) + bx) * 64;
                let o = ((by * 8) * stride) + (bx * 8);
                idct_block(comp.coeffs[at..at + 64], q, comp.pixels[o..], stride);
            }
        }
    }
    return output(d);
}

/// Upsamples and colour-converts the component planes into an image.
fn output(d: *mut Decoder) JpegError!image.Image {
    let w = d.width;
    let h = d.height;
    let mut chans: usize = 3;
    if d.ncomp == 1 {
        chans = 1;
    }
    let mut img = image.Image.init(w, h, chans, image.Depth.U8)!;
    let out = img.samples8();
    if d.ncomp == 1 {
        let c = &d.comp[0];
        for y in @as(usize, 0)..h {
            @mem_copy(out[y * w..(y + 1) * w], c.pixels[y * (c.bw * 8)..(y * (c.bw * 8)) + w]);
        }
        return img;
    }
    // full-resolution rows of each component
    let rows = mem.alloc.[u8](d.ncomp * w) catch |e| {
        img.deinit();
        return e;
    };
    defer mem.free(rows);
    // the transform: YCbCr unless an Adobe marker says otherwise, or the
    // components are named R, G, B
    let mut ycc = true;
    if d.ncomp == 3 {
        if d.adobe_transform == 0 {
            ycc = false;
        } else if (d.adobe_transform < 0) and not d.jfif and (d.comp[0].id == 'R') and (d.comp[1].id == 'G') and
                  (d.comp[2].id == 'B') {
            ycc = false;
        }
    } else {
        ycc = d.adobe_transform == 2;  // YCCK; otherwise CMYK
    }
    for y in @as(usize, 0)..h {
        for c in @as(usize, 0)..d.ncomp {
            upsample_row(d, c, y, rows[c * w..(c + 1) * w]);
        }
        let o = out[(y * w) * 3..((y + 1) * w) * 3];
        if d.ncomp == 3 {
            if ycc {
                ycc_to_rgb(rows[..w], rows[w..2 * w], rows[2 * w..3 * w], o);
            } else {
                for x in @as(usize, 0)..w {
                    o[x * 3] = rows[x];
                    o[(x * 3) + 1] = rows[w + x];
                    o[(x * 3) + 2] = rows[(2 * w) + x];
                }
            }
        } else {
            // Adobe CMYK is stored inverted; YCCK is YCbCr for inverted CMY
            if ycc {
                ycc_to_rgb(rows[..w], rows[w..2 * w], rows[2 * w..3 * w], o);
                for x in @as(usize, 0)..w {
                    let k = @as(u32, rows[(3 * w) + x]);
                    for i in @as(usize, 0)..3 {
                        o[(x * 3) + i] = blinn(255 - o[(x * 3) + i], k);
                    }
                }
            } else {
                for x in @as(usize, 0)..w {
                    let k = @as(u32, rows[(3 * w) + x]);
                    for i in @as(usize, 0)..3 {
                        o[(x * 3) + i] = blinn(rows[(i * w) + x], k);
                    }
                }
            }
        }
    }
    return img;
}

fn blinn(x: u8, y: u32) u8 {
    let t = (@as(u32, x) * y) + 128;
    return @truncate(u8, (t + (t >> 8)) >> 8);
}

/// Row y of component c at full resolution, with libjpeg's "fancy"
/// (triangle-filter) upsampling for 2x factors and replication otherwise.
fn upsample_row(d: *Decoder, ci: usize, y: usize, out: []mut u8) void {
    let c = &d.comp[ci];
    let w = d.width;
    let stride = c.bw * 8;
    let hs = d.hmax / c.h;
    let vs = d.vmax / c.v;
    // (as libjpeg-turbo: horizontal fancy upsampling needs 3 columns)
    let fancy_h = (hs == 2) and ((d.hmax % c.h) == 0) and (c.x > 2);
    let fancy_v = (vs == 2) and ((d.vmax % c.v) == 0);
    let sy = y / vs;
    let row = c.pixels[sy * stride..(sy * stride) + c.x];
    if (hs == 1) and (vs == 1) {
        @mem_copy(out, row[..w]);
        return;
    }
    if fancy_v and ((hs == 1) or fancy_h) {
        // the nearer neighbouring row: above for even output rows, below for odd
        let mut ny = sy;
        let even = (y % 2) == 0;
        if even {
            if sy > 0 {
                ny = sy - 1;
            }
        } else if (sy + 1) < c.y {
            ny = sy + 1;
        }
        let nrow = c.pixels[ny * stride..(ny * stride) + c.x];
        if hs == 1 {
            let mut bias: u32 = 2;
            if even {
                bias = 1;
            }
            for x in @as(usize, 0)..w {
                out[x] = @truncate(u8, (((@as(u32, row[x]) *% 3) +% @as(u32, nrow[x])) +% bias) >> 2);
            }
            return;
        }
        // h2v2
        let n = c.x;
        let mut this = (@as(u32, row[0]) * 3) + @as(u32, nrow[0]);
        let mut next = (@as(u32, row[1]) * 3) + @as(u32, nrow[1]);
        put(out, 0, ((this * 4) + 8) >> 4);
        put(out, 1, (((this * 3) + next) + 7) >> 4);
        let mut last = this;
        this = next;
        // (inside the loop, 2i + 1 <= 2n - 3 < w: always in out)
        for i in @as(usize, 1)..n - 1 {
            next = (@as(u32, row[i + 1]) *% 3) +% @as(u32, nrow[i + 1]);
            out[2 * i] = @truncate(u8, (((this *% 3) +% last) +% 8) >> 4);
            out[(2 * i) + 1] = @truncate(u8, (((this *% 3) +% next) +% 7) >> 4);
            last = this;
            this = next;
        }
        put(out, 2 * (n - 1), (((this * 3) + last) + 8) >> 4);
        put(out, (2 * (n - 1)) + 1, ((this * 4) + 7) >> 4);
        return;
    }
    if fancy_h and (vs == 1) {
        let n = c.x;
        put(out, 0, @as(u32, row[0]));
        put(out, 1, (((@as(u32, row[0]) * 3) + @as(u32, row[1])) + 2) >> 2);
        for i in @as(usize, 1)..n - 1 {
            let v = @as(u32, row[i]) *% 3;
            out[2 * i] = @truncate(u8, ((v +% @as(u32, row[i - 1])) +% 1) >> 2);
            out[(2 * i) + 1] = @truncate(u8, ((v +% @as(u32, row[i + 1])) +% 2) >> 2);
        }
        put(out, 2 * (n - 1), (((@as(u32, row[n - 1]) * 3) + @as(u32, row[n - 2])) + 1) >> 2);
        put(out, (2 * (n - 1)) + 1, @as(u32, row[n - 1]));
        return;
    }
    for x in @as(usize, 0)..w {
        out[x] = row[@min(x / hs, c.x - 1)];
    }
}

/// out[i] = v if i is inside out (the last upsampled column may be past the
/// image's edge).
fn put(out: []mut u8, i: usize, v: u32) void {
    if i < out.len {
        out[i] = @truncate(u8, v);
    }
}

// libjpeg's fixed-point YCbCr to RGB
const SCALEBITS: u32 = 16;
const ONE_HALF: i32 = 32768;
const FIX_1_40200: i32 = 91881;
const FIX_1_77200: i32 = 116130;
const FIX_0_71414: i32 = 46802;
const FIX_0_34414: i32 = 22554;

fn ycc_to_rgb(ys: []u8, cbs: []u8, crs: []u8, out_all: []mut u8) void {
    let out = out_all[..ys.len * 3];
    for x in @as(usize, 0)..ys.len {
        let y = @as(i32, ys[x]);
        let cb = @as(i32, cbs[x]) - 128;
        let cr = @as(i32, crs[x]) - 128;
        // (no overflow: the products fit in 25 bits)
        let r = y +% (((FIX_1_40200 *% cr) +% ONE_HALF) >> SCALEBITS);
        let g = y +% ((((-FIX_0_34414) *% cb) +% (((-FIX_0_71414) *% cr) +% ONE_HALF)) >> SCALEBITS);
        let b = y +% (((FIX_1_77200 *% cb) +% ONE_HALF) >> SCALEBITS);
        out[x * 3] = clamp8(r);
        out[(x * 3) + 1] = clamp8(g);
        out[(x * 3) + 2] = clamp8(b);
    }
}

