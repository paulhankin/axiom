// =============================================================================
// std/graphics/image/avif.ax - AVIF images (AV1 in the HEIF container): reading.
//
//     let mut img = avif.decode(bytes)!;   // RGB(A) or gray (+ alpha); U8, or
//     defer img.deinit();                  // U16 above 8 bits per sample
//
// Still images: a primary item of AV1 (every profile: 8, 10 and 12 bits,
// 4:0:0, 4:2:0, 4:2:2 and 4:4:4, every coding tool of key and intra frames),
// or a grid of AV1 tiles; an alpha auxiliary image; the colour description
// (nclx) and the clean aperture, rotation and mirroring properties. The AV1
// decoder (av1/) follows dav1d and its output matches dav1d's exactly;
// decode_yuv gives those planes. Image sequences are read by their primary
// image; film grain is not synthesized.
// =============================================================================

import "../../collections/vec.ax" as vec;
import "../../mem.ax" as mem;
import "../image.ax" as image;
import "internal/av1/decode.ax" as av1;
import "internal/av1/obu.ax" as obu;

pub error AvifError { Corrupt, Unsupported, OutOfMemory, ChecksumMismatch, NotFound, TooLarge, Empty, IoError,
                      PermissionDenied, Truncated, Exists, Done, NotADirectory, InvalidUtf8, IsDirectory, EndOfStream,
                      NotEmpty, NoSpaceLeft, BadPattern, InvalidArgument, Failed }

/// Whether data looks like an AVIF file (an ISOBMFF file of the avif or avis
/// brands).
pub fn is_avif(data: []u8) bool {
    if (data.len < 16) or not @mem_eq(data[4..8], "ftyp") {
        return false;
    }
    let size = @as(usize, binary.u32_be(data[0..]));
    let end = @min(@max(size, 16), data.len);
    let mut o: usize = 8;
    while (o + 4) <= end {
        if (o != 12) and (@mem_eq(data[o..o + 4], "avif") or @mem_eq(data[o..o + 4], "avis")) {
            return true;
        }
        o += 4;
    }
    return false;
}

fn ben(d: []u8, o: usize, n: usize) u64 {
    let mut v: u64 = 0;
    for i in @as(usize, 0)..n {
        v = (v << 8) | @as(u64, d[o + i]);
    }
    return v;
}

// -----------------------------------------------------------------------------
// Boxes
// -----------------------------------------------------------------------------

struct Box {
    typ: [4]u8,
    body: []u8,  // after the header
    next: usize,
}

// the box at data[o..end]
fn read_box(d: []u8, o: usize, end: usize) AvifError!Box {
    if (o + 8) > end {
        return error.Corrupt;
    }
    let mut size = @as(u64, binary.u32_be(d[o..]));
    let mut hdr: usize = 8;
    if size == 1 {
        if (o + 16) > end {
            return error.Corrupt;
        }
        size = ben(d, o + 8, 8);
        hdr = 16;
    } else if size == 0 {
        size = @as(u64, end - o);
    }
    if (size < @as(u64, hdr)) or (size > @as(u64, end - o)) {
        return error.Corrupt;
    }
    let n = @truncate(usize, size);
    let mut b = Box.{ typ: [0; 4], body: d[o + hdr..o + n], next: o + n };
    @mem_copy(b.typ[..], d[o + 4..o + 8]);
    return b;
}

fn is(b: *Box, t: []u8) bool {
    return @mem_eq(b.typ[..], t);
}

struct Extent {
    offset: u64,
    length: u64,
}

const MAX_PROPS: usize = 32;

struct Item {
    id: u32,
    typ: [4]u8,
    method: u32,  // construction method: 0 file offsets, 1 idat
    base: u64,
    ext_start: usize,
    ext_count: usize,
    props: [32]u16,  // property indices (1-based)
    n_props: usize,
    aux_for: u32,  // the item this is an auxiliary image of (auxl)
    alpha: bool,
}

struct Prop {
    typ: [4]u8,
    body: []u8,
}

struct File {
    data: []u8,
    primary: u32,
    items: vec.Vec.[Item],
    extents: vec.Vec.[Extent],
    props: vec.Vec.[Prop],
    dimg_from: vec.Vec.[u32],  // grid references: (from, to) pairs in order
    dimg_to: vec.Vec.[u32],
    idat: []u8,
    index: vec.Vec.[u64],  // (id << 32) | the item's index, sorted
    budget: u64,           // what item_data may still read

    fn deinit(self: *mut File) void {
        self.index.deinit();
        self.items.deinit();
        self.extents.deinit();
        self.props.deinit();
        self.dimg_from.deinit();
        self.dimg_to.deinit();
    }

    // the first item with an id
    fn find(self: *File, id: u32) AvifError!usize {
        let keys = self.index.items();
        let k = vec.lower_bound(keys, @as(u64, id) << 32, less_u64);
        if (k < keys.len) and ((keys[k] >> 32) == @as(u64, id)) {
            return @as(usize, @truncate(u32, keys[k]));
        }
        return error.Corrupt;
    }

    fn prop(self: *File, it: *Item, t: []u8) AvifError![]u8 {
        let ps = self.props.items();
        for k in @as(usize, 0)..it.n_props {
            let idx = @as(usize, it.props[k]);
            if (idx >= 1) and (idx <= ps.len) and @mem_eq(ps[idx - 1].typ[..], t) {
                return ps[idx - 1].body;
            }
        }
        return error.Corrupt;
    }
}

fn parse(data: []u8) AvifError!File {
    let mut f = File.{ data: data, primary: 0, items: vec.Vec.[Item].init(), extents: vec.Vec.[Extent].init(),
                       props: vec.Vec.[Prop].init(), dimg_from: vec.Vec.[u32].init(), dimg_to: vec.Vec.[u32].init(),
                       idat: data[..0], index: vec.Vec.[u64].init(), budget: @as(u64, data.len) * 2 };
    parse_boxes(&mut f, data) catch |e| {
        f.deinit();
        return e;
    };
    return f;
}

fn parse_boxes(f: *mut File, data: []u8) AvifError!void {
    let mut o: usize = 0;
    let mut have_meta = false;
    while o < data.len {
        let b = read_box(data, o, data.len)!;
        o = b.next;
        if is(&b, "meta") {
            parse_meta(f, b.body)!;
            have_meta = true;
        }
    }
    if not have_meta {
        return error.Unsupported;  // a sequence without items
    }
}

fn parse_meta(f: *mut File, m: []u8) AvifError!void {
    if m.len < 4 {
        return error.Corrupt;
    }
    let mut o: usize = 4;
    // the item boxes first (iinf), then the others
    let mut pass: u32 = 0;
    while pass < 2 {
        o = 4;
        while o < m.len {
            let b = read_box(m, o, m.len)!;
            o = b.next;
            if pass == 0 {
                if is(&b, "iinf") {
                    parse_iinf(f, b.body)!;
                }
                continue;
            }
            if is(&b, "pitm") {
                if b.body.len < 6 {
                    return error.Corrupt;
                }
                if b.body[0] == 0 {
                    f.primary = @as(u32, binary.u16_be(b.body[4..]));
                } else {
                    if b.body.len < 8 {
                        return error.Corrupt;
                    }
                    f.primary = binary.u32_be(b.body[4..]);
                }
            } else if is(&b, "iloc") {
                parse_iloc(f, b.body)!;
            } else if is(&b, "iprp") {
                parse_iprp(f, b.body)!;
            } else if is(&b, "iref") {
                parse_iref(f, b.body)!;
            } else if is(&b, "idat") {
                f.idat = b.body;
            }
        }
        if pass == 0 {
            index_items(f)!;
        }
        pass += 1;
    }
}

fn less_u64(a: u64, b: u64) bool {
    return a < b;
}

// indexes the items by id, for find
fn index_items(f: *mut File) AvifError!void {
    f.index.clear();
    let its = f.items.items();
    for i in @as(usize, 0)..its.len {
        f.index.push((@as(u64, its[i].id) << 32) | @as(u64, i))!;
    }
    vec.sort(f.index.items(), less_u64);
}

fn parse_iinf(f: *mut File, b: []u8) AvifError!void {
    if b.len < 6 {
        return error.Corrupt;
    }
    let mut o: usize = 6;
    if b[0] != 0 {
        o = 8;
    }
    while o < b.len {
        let e = read_box(b, o, b.len)!;
        o = e.next;
        if not is(&e, "infe") {
            continue;
        }
        let x = e.body;
        if (x.len < 4) or (x[0] < 2) {
            continue;
        }
        let mut it = obu.zeroed.[Item]()!;
        if x[0] == 2 {
            if x.len < 12 {
                return error.Corrupt;
            }
            it.id = @as(u32, binary.u16_be(x[4..]));
            @mem_copy(it.typ[..], x[8..12]);
        } else {
            if x.len < 14 {
                return error.Corrupt;
            }
            it.id = binary.u32_be(x[4..]);
            @mem_copy(it.typ[..], x[10..14]);
        }
        f.items.push(it)!;
    }
}

fn parse_iloc(f: *mut File, b: []u8) AvifError!void {
    if b.len < 8 {
        return error.Corrupt;
    }
    let ver = b[0];
    let off_sz = @as(usize, b[4] >> 4);
    let len_sz = @as(usize, b[4] & 15);
    let base_sz = @as(usize, b[5] >> 4);
    let mut idx_sz: usize = 0;
    if (ver == 1) or (ver == 2) {
        idx_sz = @as(usize, b[5] & 15);
    }
    let mut o: usize = 6;
    let mut n: usize = 0;
    if ver < 2 {
        n = @as(usize, @as(u32, binary.u16_be(b[o..])));
        o += 2;
    } else {
        if b.len < 10 {
            return error.Corrupt;
        }
        n = @as(usize, binary.u32_be(b[o..]));
        o += 4;
    }
    for _q in @as(usize, 0)..n {
        let mut id: u32 = 0;
        if ver < 2 {
            if (o + 2) > b.len {
                return error.Corrupt;
            }
            id = @as(u32, binary.u16_be(b[o..]));
            o += 2;
        } else {
            if (o + 4) > b.len {
                return error.Corrupt;
            }
            id = binary.u32_be(b[o..]);
            o += 4;
        }
        let mut method: u32 = 0;
        if (ver == 1) or (ver == 2) {
            if (o + 2) > b.len {
                return error.Corrupt;
            }
            method = @as(u32, binary.u16_be(b[o..])) & 15;
            o += 2;
        }
        if (o + 2 + base_sz + 2) > b.len {
            return error.Corrupt;
        }
        o += 2;  // data reference index
        let base = ben(b, o, base_sz);
        o += base_sz;
        let ne = @as(usize, @as(u32, binary.u16_be(b[o..])));
        o += 2;
        let start = f.extents.items().len;
        for _e in @as(usize, 0)..ne {
            if (o + idx_sz + off_sz + len_sz) > b.len {
                return error.Corrupt;
            }
            o += idx_sz;
            let eo = ben(b, o, off_sz);
            o += off_sz;
            let el = ben(b, o, len_sz);
            o += len_sz;
            f.extents.push(Extent.{ offset: eo, length: el })!;
        }
        let i = f.find(id) catch continue;
        let it = f.items.get_ptr(i);
        it.method = method;
        it.base = base;
        it.ext_start = start;
        it.ext_count = ne;
    }
}

fn parse_iprp(f: *mut File, b: []u8) AvifError!void {
    let mut o: usize = 0;
    while o < b.len {
        let x = read_box(b, o, b.len)!;
        o = x.next;
        if is(&x, "ipco") {
            let mut p: usize = 0;
            while p < x.body.len {
                let pb = read_box(x.body, p, x.body.len)!;
                p = pb.next;
                f.props.push(Prop.{ typ: pb.typ, body: pb.body })!;
            }
        } else if is(&x, "ipma") {
            let m = x.body;
            if m.len < 8 {
                return error.Corrupt;
            }
            let ver = m[0];
            let wide = (m[3] & 1) != 0;
            let n = @as(usize, binary.u32_be(m[4..]));
            let mut q: usize = 8;
            for _q in @as(usize, 0)..n {
                let mut id: u32 = 0;
                if ver < 1 {
                    if (q + 3) > m.len {
                        return error.Corrupt;
                    }
                    id = @as(u32, binary.u16_be(m[q..]));
                    q += 2;
                } else {
                    if (q + 5) > m.len {
                        return error.Corrupt;
                    }
                    id = binary.u32_be(m[q..]);
                    q += 4;
                }
                let na = @as(usize, m[q]);
                q += 1;
                let i = f.find(id) catch 0xffffffff;
                for _a in @as(usize, 0)..na {
                    let mut idx: u16 = 0;
                    if wide {
                        if (q + 2) > m.len {
                            return error.Corrupt;
                        }
                        idx = @truncate(u16, @as(u32, binary.u16_be(m[q..])) & 0x7fff);
                        q += 2;
                    } else {
                        if q >= m.len {
                            return error.Corrupt;
                        }
                        idx = @as(u16, m[q] & 0x7f);
                        q += 1;
                    }
                    if i != 0xffffffff {
                        let it = f.items.get_ptr(i);
                        if it.n_props < MAX_PROPS {
                            it.props[it.n_props] = idx;
                            it.n_props += 1;
                        }
                    }
                }
            }
        }
    }
}

fn parse_iref(f: *mut File, b: []u8) AvifError!void {
    if b.len < 4 {
        return error.Corrupt;
    }
    let wide = b[0] != 0;
    let mut o: usize = 4;
    while o < b.len {
        let r = read_box(b, o, b.len)!;
        o = r.next;
        let x = r.body;
        let mut q: usize = 0;
        let mut from: u32 = 0;
        let mut w: usize = 2;
        if wide {
            w = 4;
        }
        if (q + w + 2) > x.len {
            return error.Corrupt;
        }
        from = @truncate(u32, ben(x, q, w));
        q += w;
        let n = @as(usize, @as(u32, binary.u16_be(x[q..])));
        q += 2;
        for _k in @as(usize, 0)..n {
            if (q + w) > x.len {
                return error.Corrupt;
            }
            let to = @truncate(u32, ben(x, q, w));
            q += w;
            if is(&r, "auxl") {
                let i = f.find(from) catch continue;
                f.items.get_ptr(i).aux_for = to;
            } else if is(&r, "dimg") {
                f.dimg_from.push(from)!;
                f.dimg_to.push(to)!;
            }
        }
    }
}

// an item's data (freed by the caller). What it reads is charged to the
// file's budget, twice its size, so items that share their data cannot have
// it copied over and over.
fn item_data(f: *mut File, it: *Item, prefix: []u8) AvifError![]mut u8 {
    let ex = f.extents.items();
    let mut src = f.data;
    if it.method == 1 {
        src = f.idat;
    } else if it.method != 0 {
        return error.Unsupported;
    }
    let n = @as(u64, src.len);
    let mut total: u64 = 0;
    for k in it.ext_start..(it.ext_start + it.ext_count) {
        let e = ex[k];
        let start = @add_checked(it.base, e.offset) catch return error.Corrupt;
        let mut len = e.length;
        if (len == 0) and (it.ext_count == 1) {
            if start > n {
                return error.Corrupt;
            }
            len = n - start;
        }
        if (start > n) or (len > (n - start)) {
            return error.Corrupt;
        }
        // (extents overlapping each other cannot add up to more than src)
        total += len;
        if total > n {
            return error.Corrupt;
        }
    }
    if total > f.budget {
        return error.Corrupt;
    }
    f.budget -= total;
    let out = mem.alloc.[u8](prefix.len + @truncate(usize, total))!;
    @mem_copy(out[..prefix.len], prefix);
    let mut p = prefix.len;
    for k in it.ext_start..(it.ext_start + it.ext_count) {
        let e = ex[k];
        let start = @truncate(usize, it.base + e.offset);
        let mut len = @truncate(usize, e.length);
        if (len == 0) and (it.ext_count == 1) {
            len = src.len - start;
        }
        @mem_copy(out[p..p + len], src[start..start + len]);
        p += len;
    }
    return out;
}

// the AV1 planes of an av01 item
fn decode_item(f: *mut File, it: *Item) AvifError!av1.Frame {
    if not @mem_eq(it.typ[..], "av01") {
        return error.Unsupported;
    }
    // the configuration OBUs (a sequence header) go first, in case the
    // item's data lacks them
    let mut cfg = f.data[..0];
    let c = f.prop(it, "av1C") catch f.data[..0];
    if c.len > 4 {
        cfg = c[4..];
    }
    let data = item_data(f, it, cfg)!;
    defer mem.free(data);
    return av1.decode(data);
}

// -----------------------------------------------------------------------------
// Colour
// -----------------------------------------------------------------------------

struct Colour {
    matrix: u32,
    full: bool,
}

fn colour_of(f: *File, it: *Item, p: *av1.Frame) Colour {
    let mut c = Colour.{ matrix: p.matrix, full: p.full_range };
    let ps = f.props.items();
    for k in @as(usize, 0)..it.n_props {
        let idx = @as(usize, it.props[k]);
        if (idx < 1) or (idx > ps.len) or not @mem_eq(ps[idx - 1].typ[..], "colr") {
            continue;
        }
        let b = ps[idx - 1].body;
        if (b.len >= 11) and @mem_eq(b[..4], "nclx") {
            c.matrix = @as(u32, binary.u16_be(b[8..]));
            c.full = (b[10] & 0x80) != 0;
        }
    }
    return c;
}

// the (normalized) value of a sample of a plane, bilinearly upsampled for
// chroma
fn chroma_at(p: *av1.Frame, pl: usize, x: usize, y: usize) f32 {
    let ssh = p.pw[pl] < p.pw[0];
    let ssv = p.ph[pl] < p.ph[0];
    let d = p.planes[pl].data;
    let st = p.planes[pl].stride;
    let w = p.pw[pl];
    let h = p.ph[pl];
    if (not ssh) and not ssv {
        return @float_from_int(f32, d[(y * st) + x]);
    }
    // bilinear, between the chroma samples centred between the luma ones
    // (the last column of an odd width takes the last chroma sample, as
    // libyuv does)
    let mut x0 = x;
    let mut x1 = x;
    let mut wx0: f32 = 1.0;
    if ssh {
        x0 = x >> 1;
        x1 = x0;
        if (x & 1) == 0 {
            if (x0 > 0) and ((x + 1) < p.pw[0]) {
                x1 = x0 - 1;
            }
        } else if (x0 + 1) < w {
            x1 = x0 + 1;
        }
        wx0 = 0.75;
    }
    let mut y0 = y;
    let mut y1 = y;
    let mut wy0: f32 = 1.0;
    if ssv {
        y0 = y >> 1;
        y1 = y0;
        if (y & 1) == 0 {
            if y0 > 0 {
                y1 = y0 - 1;
            }
        } else if (y0 + 1) < h {
            y1 = y0 + 1;
        }
        wy0 = 0.75;
    }
    let a = @float_from_int(f32, d[(y0 * st) + x0]);
    let b = @float_from_int(f32, d[(y0 * st) + x1]);
    let c = @float_from_int(f32, d[(y1 * st) + x0]);
    let e = @float_from_int(f32, d[(y1 * st) + x1]);
    return (((a * wx0) + (b * (1.0 - wx0))) * wy0) + (((c * wx0) + (e * (1.0 - wx0))) * (1.0 - wy0));
}

fn kr_kb(m: u32, kr: *mut f32, kb: *mut f32) void {
    if m == 1 {
        kr.* = 0.2126;
        kb.* = 0.0722;
    } else if m == 4 {
        kr.* = 0.30;
        kb.* = 0.11;
    } else if m == 7 {
        kr.* = 0.212;
        kb.* = 0.087;
    } else if (m == 9) or (m == 10) {
        kr.* = 0.2627;
        kb.* = 0.0593;
    } else {
        kr.* = 0.299;  // BT.601 (and unspecified)
        kb.* = 0.114;
    }
}

fn store(img: *mut image.Image, i: usize, v: f32) void {
    if img.depth == image.Depth.U8 {
        img.data[i] = @truncate(u8, @bit_cast(u32, @int_from_float(i32, (color.clamp01(v) * 255.0) + 0.5)));
    } else {
        img.samples16()[i] = @truncate(u16, @bit_cast(u32, @int_from_float(i32, (color.clamp01(v) * 65535.0) + 0.5)));
    }
}

// writes the planes (as colour, or as alpha) into img at (ox, oy); colour
// leaves the pixels opaque
fn put_planes(img: *mut image.Image, p: *av1.Frame, col: Colour, ox: usize, oy: usize, alpha: bool) void {
    let maxv = @float_from_int(f32, (@as(u32, 1) << p.bitdepth) - 1);
    let scale = @float_from_int(f32, @as(u32, 1) << (p.bitdepth - 8));
    let w = @min(p.width, img.width - @min(ox, img.width));
    let h = @min(p.height, img.height - @min(oy, img.height));
    let ch = img.channels;
    let mut kr: f32 = 0.0;
    let mut kb: f32 = 0.0;
    kr_kb(col.matrix, &mut kr, &mut kb);
    let kg = (1.0 - kr) - kb;
    let mono = p.layout == obu.I400;
    for y in @as(usize, 0)..h {
        for x in @as(usize, 0)..w {
            let yv = @float_from_int(f32, p.planes[0].data[(y * p.planes[0].stride) + x]);
            let mut yn = yv / maxv;
            if not col.full {
                yn = (yv - (16.0 * scale)) / (219.0 * scale);
            }
            let o = (((oy + y) * img.width) + ox + x) * ch;
            if alpha {
                store(img, o + (ch - 1), yn);
                continue;
            }
            if (ch & 1) == 0 {
                store(img, o + (ch - 1), 1.0);  // opaque until the alpha is drawn
            }
            if mono or (ch <= 2) {
                store(img, o, yn);
                continue;
            }
            let u = chroma_at(p, 1, x, y);
            let v = chroma_at(p, 2, x, y);
            let mut un = (u / maxv) - (0.5 * ((maxv + 1.0) / maxv));
            let mut vn = (v / maxv) - (0.5 * ((maxv + 1.0) / maxv));
            if not col.full {
                un = (u - (128.0 * scale)) / (224.0 * scale);
                vn = (v - (128.0 * scale)) / (224.0 * scale);
            }
            let mut r: f32 = 0.0;
            let mut g: f32 = 0.0;
            let mut b: f32 = 0.0;
            if col.matrix == 0 {
                // identity (GBR)
                g = yn;
                b = u / maxv;
                r = v / maxv;
                if not col.full {
                    b = (u - (16.0 * scale)) / (219.0 * scale);
                    r = (v - (16.0 * scale)) / (219.0 * scale);
                }
            } else if col.matrix == 8 {
                // YCgCo
                let tt = yn - un;
                g = yn + un;
                b = tt - vn;
                r = tt + vn;
            } else {
                r = yn + ((2.0 - (2.0 * kr)) * vn);
                b = yn + ((2.0 - (2.0 * kb)) * un);
                g = (yn - (((2.0 * kb) * (1.0 - kb)) / kg) * un) - ((((2.0 * kr) * (1.0 - kr)) / kg) * vn);
            }
            store(img, o, r);
            store(img, o + 1, g);
            store(img, o + 2, b);
        }
    }
}

// -----------------------------------------------------------------------------
// Decoding
// -----------------------------------------------------------------------------

struct Grid {
    rows: usize,
    cols: usize,
    width: usize,
    height: usize,
}

fn read_grid(f: *mut File, it: *Item) AvifError!Grid {
    let d = item_data(f, it, f.data[..0])!;
    defer mem.free(d);
    if d.len < 8 {
        return error.Corrupt;
    }
    let mut g = Grid.{ rows: @as(usize, d[2]) + 1, cols: @as(usize, d[3]) + 1, width: 0, height: 0 };
    if (d[1] & 1) == 0 {
        g.width = @as(usize, @as(u32, binary.u16_be(d[4..])));
        g.height = @as(usize, @as(u32, binary.u16_be(d[6..])));
    } else {
        if d.len < 12 {
            return error.Corrupt;
        }
        g.width = @as(usize, binary.u32_be(d[4..]));
        g.height = @as(usize, binary.u32_be(d[8..]));
    }
    return g;
}

// the ids of a grid's tiles
fn tiles(f: *File, id: u32, out: *mut vec.Vec.[u32]) AvifError!void {
    let fr = f.dimg_from.items();
    let to = f.dimg_to.items();
    for k in @as(usize, 0)..fr.len {
        if fr[k] == id {
            out.push(to[k])!;
        }
    }
}

// an item's planes and colour description
struct Pic {
    frame: av1.Frame,
    col: Colour,
}

// decodes an item: an image, or a grid of tiles put together
fn picture(f: *mut File, it: *Item) AvifError!Pic {
    if not @mem_eq(it.typ[..], "grid") {
        let p = decode_item(f, it)!;
        return Pic.{ frame: p, col: colour_of(f, it, &p) };
    }
    let g = read_grid(f, it)!;
    if (@mul_checked(g.width, g.height) catch return error.Unsupported) > image.MAX_PIXELS {
        return error.Unsupported;
    }
    let mut ids = vec.Vec.[u32].init();
    defer ids.deinit();
    tiles(f, it.id, &mut ids)!;
    if ids.items().len != (g.rows * g.cols) {
        return error.Corrupt;
    }
    // each tile is decoded once: a grid that repeats one is refused
    let mut sorted = vec.Vec.[u64].init();
    defer sorted.deinit();
    for id in ids.items() {
        sorted.push(@as(u64, id))!;
    }
    vec.sort(sorted.items(), less_u64);
    for k in @as(usize, 1)..sorted.items().len {
        if sorted.get(k) == sorted.get(k - 1) {
            return error.Corrupt;
        }
    }
    let mut pic = Pic.{ frame: obu.zeroed.[av1.Frame]()!, col: Colour.{ matrix: 0, full: true } };
    put_tiles(f, &g, ids.items(), &mut pic) catch |e| {
        pic.frame.deinit();
        return e;
    };
    return pic;
}

// puts a grid's tiles together in pic
fn put_tiles(f: *mut File, g: *Grid, ids: []u32, pic: *mut Pic) AvifError!void {
    let all = &mut pic.frame;
    let mut tw: usize = 0;
    let mut th: usize = 0;
    for r in @as(usize, 0)..g.rows {
        for c in @as(usize, 0)..g.cols {
            let t = f.items.get(f.find(ids[(r * g.cols) + c])!);
            let mut p = decode_item(f, &t)!;
            defer p.deinit();
            if (r == 0) and (c == 0) {
                // the tiles' size: the columns and rows just cover the grid
                tw = p.width;
                th = p.height;
                if ((tw * (g.cols - 1)) >= g.width) or ((tw * g.cols) < g.width) or ((th * (g.rows - 1)) >= g.height) or
                   ((th * g.rows) < g.height) {
                    return error.Corrupt;
                }
                // the whole: the tiles' format, the grid's size
                all.width = g.width;
                all.height = g.height;
                all.bitdepth = p.bitdepth;
                all.layout = p.layout;
                all.full_range = p.full_range;
                all.matrix = p.matrix;
                pic.col = colour_of(f, &t, &p);
                for pl in @as(usize, 0)..3 {
                    if p.pw[pl] == 0 {
                        continue;
                    }
                    let mut sx: usize = 1;
                    let mut sy: usize = 1;
                    if (pl > 0) and (p.layout != obu.I444) {
                        sx = 2;
                    }
                    if (pl > 0) and (p.layout == obu.I420) {
                        sy = 2;
                    }
                    all.pw[pl] = (g.width + sx - 1) / sx;
                    all.ph[pl] = (g.height + sy - 1) / sy;
                    all.planes[pl].stride = all.pw[pl];
                    all.planes[pl].data = mem.alloc_zeroed.[u16](all.pw[pl] * all.ph[pl])!;
                }
            }
            if (p.width != tw) or (p.height != th) or (p.bitdepth != all.bitdepth) or (p.layout != all.layout) {
                return error.Corrupt;
            }
            for pl in @as(usize, 0)..3 {
                let x0 = c * p.pw[pl];
                let y0 = r * p.ph[pl];
                let w = @min(p.pw[pl], all.pw[pl] - @min(x0, all.pw[pl]));
                let h = @min(p.ph[pl], all.ph[pl] - @min(y0, all.ph[pl]));
                if w == 0 {
                    continue;  // (x0 may be past the plane's end)
                }
                for y in @as(usize, 0)..h {
                    let d = ((y0 + y) * all.planes[pl].stride) + x0;
                    let s = y * p.planes[pl].stride;
                    @mem_copy(all.planes[pl].data[d..d + w], p.planes[pl].data[s..s + w]);
                }
            }
        }
    }
}

struct Info {
    width: usize,
    height: usize,
    bitdepth: u32,
    mono: bool,
}

fn info_of(f: *mut File, it: *Item) AvifError!Info {
    let mut tile = it.*;
    let mut gw: usize = 0;
    let mut gh: usize = 0;
    if @mem_eq(it.typ[..], "grid") {
        let g = read_grid(f, it)!;
        gw = g.width;
        gh = g.height;
        let mut ids = vec.Vec.[u32].init();
        defer ids.deinit();
        tiles(f, it.id, &mut ids)!;
        if ids.items().len == 0 {
            return error.Corrupt;
        }
        tile = f.items.get(f.find(ids.get(0))!);
    }
    // the sequence header, from av1C
    let c = f.prop(&tile, "av1C")!;
    if c.len < 4 {
        return error.Corrupt;
    }
    let mut info = Info.{ width: gw, height: gh, bitdepth: 8, mono: (c[2] & 0x10) != 0 };
    let hbd = (c[2] & 0x40) != 0;
    let twelve = (c[2] & 0x20) != 0;
    if hbd {
        info.bitdepth = 10;
        if twelve {
            info.bitdepth = 12;
        }
    }
    if gw == 0 {
        let s = f.prop(it, "ispe")!;
        if s.len < 12 {
            return error.Corrupt;
        }
        info.width = @as(usize, binary.u32_be(s[4..]));
        info.height = @as(usize, binary.u32_be(s[8..]));
    }
    if (info.width == 0) or (info.height == 0) {
        return error.Corrupt;
    }
    return info;
}

/// Decodes an AVIF file's primary image: gray, gray + alpha, RGB or RGBA; U8
/// for 8-bit images, else U16.
pub fn decode(data: []u8) AvifError!image.Image {
    let mut f = parse(data)!;
    defer f.deinit();
    let pi = f.find(f.primary)!;
    let prim = f.items.get(pi);
    let info = info_of(&mut f, &prim)!;
    // an alpha auxiliary image
    let mut alpha_i: usize = 0xffffffff;
    let its = f.items.items();
    for i in @as(usize, 0)..its.len {
        if its[i].aux_for != prim.id {
            continue;
        }
        let a = f.prop(&its[i], "auxC") catch continue;
        if a.len < 4 {
            continue;
        }
        let urn = a[4..];
        if (urn.len >= 43) and
           (@mem_eq(urn[..43], "urn:mpeg:mpegB:cicp:systems:auxiliary:alpha") or
            @mem_eq(urn[..min_len(urn.len, 36)], "urn:mpeg:hevc:2015:auxid:1")) {
            alpha_i = i;
        } else if (urn.len >= 27) and @mem_eq(urn[..27], "urn:mpeg:hevc:2015:auxid:1") {
            alpha_i = i;
        }
    }
    let mut ch: usize = 3;
    if info.mono {
        ch = 1;
    }
    if alpha_i != 0xffffffff {
        ch += 1;
    }
    let mut depth = image.Depth.U8;
    if info.bitdepth > 8 {
        depth = image.Depth.U16;
    }
    // the image is allocated once its colour planes are decoded (it is no
    // bigger than they are)
    let mut pic = picture(&mut f, &prim)!;
    if (pic.frame.width < info.width) or (pic.frame.height < info.height) {
        pic.frame.deinit();
        return error.Corrupt;
    }
    let mut img = image.Image.init(info.width, info.height, ch, depth) catch |e| {
        pic.frame.deinit();
        if e == error.OutOfMemory {
            return error.OutOfMemory;
        }
        return error.Unsupported;
    };
    put_planes(&mut img, &pic.frame, pic.col, 0, 0, false);
    pic.frame.deinit();
    if alpha_i != 0xffffffff {
        let a = f.items.get(alpha_i);
        let mut ap = picture(&mut f, &a) catch |e| {
            img.deinit();
            return e;
        };
        put_planes(&mut img, &ap.frame, ap.col, 0, 0, true);
        ap.frame.deinit();
    }
    return transform(&f, &prim, img);
}

fn min_len(a: usize, b: usize) usize {
    return @min(a, b);
}

// applies the clean aperture, rotation and mirroring properties in order
// (the first of each: an item has one at most)
fn transform(f: *File, it: *Item, img0: image.Image) AvifError!image.Image {
    let mut img = img0;
    let ps = f.props.items();
    let mut seen: [3]bool = [false, false, false];
    for k in @as(usize, 0)..it.n_props {
        let idx = @as(usize, it.props[k]);
        if (idx < 1) or (idx > ps.len) {
            continue;
        }
        let p = ps[idx - 1];
        let mut kind: usize = 3;
        if @mem_eq(p.typ[..], "irot") {
            kind = 0;
        } else if @mem_eq(p.typ[..], "imir") {
            kind = 1;
        } else if @mem_eq(p.typ[..], "clap") {
            kind = 2;
        }
        if kind == 3 {
            continue;
        }
        if seen[kind] {
            continue;
        }
        seen[kind] = true;
        if @mem_eq(p.typ[..], "irot") and (p.body.len >= 1) {
            let n = p.body[0] & 3;
            for _r in @as(u8, 0)..n {
                let r = rotate_ccw(&img)!;
                img.deinit();
                img = r;
            }
        } else if @mem_eq(p.typ[..], "imir") and (p.body.len >= 1) {
            // axis 0 exchanges top and bottom, 1 left and right
            // (ISO/IEC 23008-12:2022)
            mirror(&mut img, (p.body[0] & 1) == 0);
        } else if @mem_eq(p.typ[..], "clap") and (p.body.len >= 32) {
            let r = clap(&img, p.body) catch continue;
            img.deinit();
            img = r;
        }
    }
    return img;
}

fn rotate_ccw(img: *image.Image) AvifError!image.Image {
    let mut out = image.Image.init(img.height, img.width, img.channels, img.depth)!;
    let bps = image.bytes_per_sample(img.depth) * img.channels;
    for y in @as(usize, 0)..img.height {
        for x in @as(usize, 0)..img.width {
            // (x, y) goes to (y, w - 1 - x)
            let src = ((y * img.width) + x) * bps;
            let dst = ((((img.width - 1) - x) * out.width) + y) * bps;
            @mem_copy(out.data[dst..dst + bps], img.data[src..src + bps]);
        }
    }
    return out;
}

fn mirror(img: *mut image.Image, vertical_flip: bool) void {
    let bps = image.bytes_per_sample(img.depth) * img.channels;
    let mut tmp: [16]u8 = [0; 16];
    if vertical_flip {
        img.flip_vertical();
        return;
    }
    for y in @as(usize, 0)..img.height {
        for x in @as(usize, 0)..(img.width / 2) {
            let a = ((y * img.width) + x) * bps;
            let b = ((y * img.width) + ((img.width - 1) - x)) * bps;
            @mem_copy(tmp[..bps], img.data[a..a + bps]);
            @mem_copy(img.data[a..a + bps], img.data[b..b + bps]);
            @mem_copy(img.data[b..b + bps], tmp[..bps]);
        }
    }
}

fn sdiv(n: u32, d: u32) AvifError!i64 {
    if d == 0 {
        return error.Corrupt;
    }
    return @as(i64, @bit_cast(i32, n)) / @as(i64, d);
}

fn clap(img: *image.Image, b: []u8) AvifError!image.Image {
    let cw = sdiv(binary.u32_be(b[0..]), binary.u32_be(b[4..]))!;
    let chh = sdiv(binary.u32_be(b[8..]), binary.u32_be(b[12..]))!;
    // the offsets of the centre, as fractions (n / d)
    let hn = @as(i64, @bit_cast(i32, binary.u32_be(b[16..])));
    let hd = @as(i64, binary.u32_be(b[20..]));
    let vn = @as(i64, @bit_cast(i32, binary.u32_be(b[24..])));
    let vd = @as(i64, binary.u32_be(b[28..]));
    if (hd == 0) or (vd == 0) or (cw <= 0) or (chh <= 0) {
        return error.Corrupt;
    }
    let iw = @as(i64, @truncate(u32, img.width));
    let ih = @as(i64, @truncate(u32, img.height));
    // left = hoff + (iw - cw) / 2
    let left = ((2 * hn) + ((iw - cw) * hd)) / (2 * hd);
    let top = ((2 * vn) + ((ih - chh) * vd)) / (2 * vd);
    if (left < 0) or (top < 0) or ((left + cw) > iw) or ((top + chh) > ih) {
        return error.Corrupt;
    }
    return img.crop(@truncate(usize, @bit_cast(u64, left)), @truncate(usize, @bit_cast(u64, top)),
                    @truncate(usize, @bit_cast(u64, cw)), @truncate(usize, @bit_cast(u64, chh)));
}

/// Decodes the primary image's AV1 planes exactly (not for grids): Y, U and
/// V (8-bit samples stored in u16s), with their sizes and colour description.
pub fn decode_yuv(data: []u8) AvifError!av1.Frame {
    let mut f = parse(data)!;
    defer f.deinit();
    let pi = f.find(f.primary)!;
    let prim = f.items.get(pi);
    return decode_item(&mut f, &prim);
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

import "../../encoding/binary.ax" as binary;
import "../../os/fs.ax" as fs;
import "../../str.ax" as strs;
import "../color.ax" as color;
import "png.ax" as png;

fn field(line: []u8, n: usize) []u8 {
    let mut k: usize = 0;
    let mut s: usize = 0;
    for i in @as(usize, 0)..(line.len + 1) {
        if (i == line.len) or (line[i] == ' ') {
            if k == n {
                return line[s..i];
            }
            k += 1;
            s = i + 1;
        }
    }
    return line[..0];
}

test "decodes the test files exactly (YUV) and closely (RGB)" {
    let list = fs.read_file("std/graphics/image/testdata/avif/cases.txt") catch return;
    defer mem.free(list);
    let mut start: usize = 0;
    let mut n: usize = 0;
    for i in @as(usize, 0)..list.len {
        if list[i] != '\n' {
            continue;
        }
        let line = list[start..i];
        start = i + 1;
        let name = field(line, 0);
        let mut path = strs.String.init();
        defer path.deinit();
        path.push_str("std/graphics/image/testdata/avif/")!;
        path.push_str(name)!;
        path.push_str(".avif")!;
        let data = fs.read_file(path.bytes())!;
        defer mem.free(data);
        @expect(is_avif(data));
        // the planes, against dav1d's
        let mut p = decode_yuv(data)!;
        defer p.deinit();
        path.truncate(path.bytes().len - 4);
        path.push_str("yuv")!;
        let want = fs.read_file(path.bytes())!;
        defer mem.free(want);
        let mut o: usize = 0;
        for pl in @as(usize, 0)..3 {
            for y in @as(usize, 0)..p.ph[pl] {
                for x in @as(usize, 0)..p.pw[pl] {
                    let mut w = @as(u32, want[o]);
                    o += 1;
                    if p.bitdepth > 8 {
                        w |= @as(u32, want[o]) << 8;
                        o += 1;
                    }
                    @expect_eq(@as(u32, p.planes[pl].data[(y * p.planes[pl].stride) + x]), w);
                }
            }
        }
        @expect_eq(o, want.len);
        // the image, against libavif's (conversions round differently)
        let mut img = decode(data)!;
        defer img.deinit();
        @expect_eq(img.width, p.width);
        @expect_eq(img.height, p.height);
        if @mem_eq(field(line, 5), "-") {
            n += 1;
            continue;
        }
        path.truncate(path.bytes().len - 3);
        path.push_str("png")!;
        expect_close(&img, path.bytes())!;
        n += 1;
    }
    @expect_eq(n, 24);
}

// compares an image with a PNG of libavif's decoding (whose conversion to RGB
// rounds differently)
fn expect_close(img: *image.Image, png_path: []u8) !void {
    let pd = fs.read_file(png_path)!;
    defer mem.free(pd);
    let mut ref = png.decode(pd)!;
    defer ref.deinit();
    @expect_eq(ref.width, img.width);
    @expect_eq(ref.height, img.height);
    @expect_eq(ref.channels, img.channels);
    let a = img.samples8();
    let b = ref.samples8();
    let mut sum: u64 = 0;
    let mut worst: u32 = 0;
    for k in @as(usize, 0)..a.len {
        let dd = @as(u32, @max(a[k], b[k]) - @min(a[k], b[k]));
        sum += @as(u64, dd);
        worst = @max(worst, dd);
    }
    @expect(worst <= 3);
    @expect((sum * 2) <= @as(u64, a.len));
}

test "grids (in idat), rotation and mirroring" {
    let names: [2][]u8 = ["grid", "rotmir"];
    for k in @as(usize, 0)..2 {
        let mut path = strs.String.init();
        defer path.deinit();
        path.push_str("std/graphics/image/testdata/avif/")!;
        path.push_str(names[k])!;
        path.push_str(".avif")!;
        let data = fs.read_file(path.bytes()) catch return;
        defer mem.free(data);
        let mut img = decode(data)!;
        defer img.deinit();
        path.truncate(path.bytes().len - 4);
        path.push_str("png")!;
        expect_close(&img, path.bytes())!;
    }
}

fn fails(data: []u8) bool {
    let mut img = decode(data) catch return true;
    img.deinit();
    return false;
}

test "rejects damaged files" {
    let data = fs.read_file("std/graphics/image/testdata/avif/alpha.avif") catch return;
    defer mem.free(data);
    let copy = strs.dup(data)!;
    defer mem.free(copy);
    // truncations and flipped bytes: errors (or pictures), never crashes
    let mut k: usize = 0;
    while k < data.len {
        _ = fails(data[..k]);
        k += 1 + (k / 16);
    }
    for i in @as(usize, 0)..copy.len {
        let old = copy[i];
        copy[i] = old ^ @truncate(u8, (i * 37) | 1);
        _ = fails(copy);
        copy[i] = old;
    }
}

// --- Files made here ---------------------------------------------------------

// an item of a file made by make_file: its properties' indices (from 1)
// and its extents, (offset in mdat, length) pairs
struct TItem {
    id: u16,
    typ: []u8,
    props: []u8,
    ext: []u32,
}

fn put_be(o: *mut strs.String, v: u64, n: usize) !void {
    for i in @as(usize, 0)..n {
        o.push(@truncate(u8, v >> @truncate(u64, ((n - 1) - i) * 8)))!;
    }
}

fn put_box(o: *mut strs.String, typ: []u8, body: []u8) !void {
    put_be(o, @as(u64, body.len + 8), 4)!;
    o.push_str(typ)!;
    o.push_str(body)!;
}

// an AVIF file whose primary item is the first: ipco holds the property
// boxes, iref the reference boxes
fn make_file(items: []TItem, ipco: []u8, iref: []u8, mdat: []u8) ![]mut u8 {
    let mut base: usize = 0;
    let mut o = strs.String.init();
    for pass in @as(usize, 0)..2 {
        o.clear();
        put_box(&mut o, "ftyp", "avif\x00\x00\x00\x00avifmif1miaf")!;
        let mut iinf = strs.String.init();
        defer iinf.deinit();
        let mut iloc = strs.String.init();
        defer iloc.deinit();
        let mut ipma = strs.String.init();
        defer ipma.deinit();
        put_be(&mut iinf, 0, 4)!;
        put_be(&mut iinf, @as(u64, items.len), 2)!;
        put_be(&mut iloc, 0x4400, 6)!;
        put_be(&mut iloc, @as(u64, items.len), 2)!;
        put_be(&mut ipma, 0, 4)!;
        put_be(&mut ipma, @as(u64, items.len), 4)!;
        for it in items {
            let mut e = strs.String.init();
            defer e.deinit();
            put_be(&mut e, 0x02000000, 4)!;
            put_be(&mut e, @as(u64, it.id), 2)!;
            put_be(&mut e, 0, 2)!;
            e.push_str(it.typ)!;
            e.push(0)!;
            put_box(&mut iinf, "infe", e.bytes())!;
            put_be(&mut iloc, @as(u64, it.id), 2)!;
            put_be(&mut iloc, 0, 2)!;
            put_be(&mut iloc, @as(u64, it.ext.len / 2), 2)!;
            for k in @as(usize, 0)..(it.ext.len / 2) {
                put_be(&mut iloc, @as(u64, it.ext[k * 2]) + @as(u64, base), 4)!;
                put_be(&mut iloc, @as(u64, it.ext[(k * 2) + 1]), 4)!;
            }
            put_be(&mut ipma, @as(u64, it.id), 2)!;
            ipma.push(@truncate(u8, it.props.len))!;
            ipma.push_str(it.props)!;
        }
        let mut meta = strs.String.init();
        defer meta.deinit();
        put_be(&mut meta, 0, 4)!;
        put_box(&mut meta, "hdlr",
                "\x00\x00\x00\x00\x00\x00\x00\x00pict\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")!;
        let pitm: [6]u8 = [0, 0, 0, 0, @truncate(u8, items[0].id >> 8), @truncate(u8, items[0].id)];
        put_box(&mut meta, "pitm", pitm[..])!;
        put_box(&mut meta, "iinf", iinf.bytes())!;
        put_box(&mut meta, "iloc", iloc.bytes())!;
        let mut iprp = strs.String.init();
        defer iprp.deinit();
        put_box(&mut iprp, "ipco", ipco)!;
        put_box(&mut iprp, "ipma", ipma.bytes())!;
        put_box(&mut meta, "iprp", iprp.bytes())!;
        if iref.len > 0 {
            let mut r = strs.String.init();
            defer r.deinit();
            put_be(&mut r, 0, 4)!;
            r.push_str(iref)!;
            put_box(&mut meta, "iref", r.bytes())!;
        }
        put_box(&mut o, "meta", meta.bytes())!;
        if pass == 0 {
            base = o.bytes().len + 8;
        }
    }
    put_box(&mut o, "mdat", mdat)!;
    return o.take();
}

// the av1C property box and the data of a test file's primary item
fn tile_of(name: []u8, ipco: *mut strs.String, mdat: *mut strs.String) !void {
    let mut path = strs.String.init();
    defer path.deinit();
    path.push_str("std/graphics/image/testdata/avif/")!;
    path.push_str(name)!;
    let data = fs.read_file(path.bytes())!;
    defer mem.free(data);
    let mut f = parse(data)!;
    defer f.deinit();
    let prim = f.items.get(f.find(f.primary)!);
    put_box(ipco, "av1C", f.prop(&prim, "av1C")!)!;
    let d = item_data(&mut f, &prim, data[..0])!;
    defer mem.free(d);
    mdat.push_str(d)!;
}

fn ispe_box(o: *mut strs.String, w: u32, h: u32) !void {
    let mut b = strs.String.init();
    defer b.deinit();
    put_be(&mut b, 0, 4)!;
    put_be(&mut b, @as(u64, w), 4)!;
    put_be(&mut b, @as(u64, h), 4)!;
    put_box(o, "ispe", b.bytes())!;
}

test "small files claiming big images, extents and items" {
    let mut ipco = strs.String.init();
    defer ipco.deinit();
    let mut mdat = strs.String.init();
    defer mdat.deinit();
    tile_of("alpha.avif", &mut ipco, &mut mdat) catch return;
    let n = @truncate(u32, mdat.bytes().len);
    ispe_box(&mut ipco, 64, 48)!;        // 2
    ispe_box(&mut ipco, 16384, 16384)!;  // 3
    let props: [2]u8 = [1, 2];
    let whole: [2]u32 = [0, n];
    // the file itself
    let one: [1]TItem = [TItem.{ id: 1, typ: "av01", props: props[..], ext: whole[..] }];
    let ok = make_file(one[..], ipco.bytes(), "", mdat.bytes())!;
    defer mem.free(ok);
    let mut img = decode(ok)!;
    @expect_eq(img.width, 64);
    @expect_eq(img.height, 48);
    img.deinit();
    // a huge ispe: the frame is decoded first, and is too small
    let big_props: [2]u8 = [1, 3];
    let big: [1]TItem = [TItem.{ id: 1, typ: "av01", props: big_props[..], ext: whole[..] }];
    let f1 = make_file(big[..], ipco.bytes(), "", mdat.bytes())!;
    defer mem.free(f1);
    @expect(fails(f1));
    // extents that each cover the whole of mdat
    let mut ext = vec.Vec.[u32].init();
    defer ext.deinit();
    for _k in @as(usize, 0)..1000 {
        ext.push(0)!;
        ext.push(n)!;
    }
    let many: [1]TItem = [TItem.{ id: 1, typ: "av01", props: props[..], ext: ext.items() }];
    let f2 = make_file(many[..], ipco.bytes(), "", mdat.bytes())!;
    defer mem.free(f2);
    @expect(fails(f2));
    // many items (found by id in log time)
    let mut its = vec.Vec.[TItem].init();
    defer its.deinit();
    its.push(one[0])!;
    for k in @as(usize, 2)..30000 {
        its.push(TItem.{ id: @truncate(u16, k), typ: "xxxx", props: props[..1], ext: whole[..0] })!;
    }
    let f3 = make_file(its.items(), ipco.bytes(), "", mdat.bytes())!;
    defer mem.free(f3);
    let mut img3 = decode(f3)!;
    @expect_eq(img3.width, 64);
    img3.deinit();
    // a frame of 65536 x 65536 in 22 bytes, refused before it is allocated
    let huge: [22]u8 = [0x0a, 0x09, 0x18, 0x3f, 0xff, 0xff, 0xff, 0xff, 0xda, 0x00, 0x80, 0x32, 0x09, 0x18, 0x00, 0x00,
                        0x00, 0x50, 0x00, 0x00, 0x09, 0xac];
    let hext: [2]u32 = [0, 22];
    let hi: [1]TItem = [TItem.{ id: 1, typ: "av01", props: props[..], ext: hext[..] }];
    let f4 = make_file(hi[..], ipco.bytes(), "", huge[..])!;
    defer mem.free(f4);
    let mut img4 = decode(f4) catch |e| {
        @expect_eq(e, error.Unsupported);
        return;
    };
    img4.deinit();
    @expect(false);
}

// a grid item (1) of rows x cols tiles, the items 2, 3, ... in ids
fn grid_file(ipco: []u8, tile: []u8, rows: u8, cols: u8, w: u32, h: u32, ids: []u16) ![]mut u8 {
    let mut mdat = strs.String.init();
    defer mdat.deinit();
    mdat.push_str(tile)!;
    let g: [4]u8 = [0, 1, rows - 1, cols - 1];
    mdat.push_str(g[..])!;
    put_be(&mut mdat, @as(u64, w), 4)!;
    put_be(&mut mdat, @as(u64, h), 4)!;
    let mut pc = strs.String.init();
    defer pc.deinit();
    pc.push_str(ipco)!;
    ispe_box(&mut pc, w, h)!;  // 3
    let gprops: [1]u8 = [3];
    let tprops: [2]u8 = [1, 2];
    let gext: [2]u32 = [@truncate(u32, tile.len), 12];
    let text: [2]u32 = [0, @truncate(u32, tile.len)];
    let mut its = vec.Vec.[TItem].init();
    defer its.deinit();
    its.push(TItem.{ id: 1, typ: "grid", props: gprops[..], ext: gext[..] })!;
    let mut refs = strs.String.init();
    defer refs.deinit();
    put_be(&mut refs, 1, 2)!;
    put_be(&mut refs, @as(u64, ids.len), 2)!;
    for id in ids {
        put_be(&mut refs, @as(u64, id), 2)!;
        if @as(usize, id) > its.items().len {
            its.push(TItem.{ id: id, typ: "av01", props: tprops[..], ext: text[..] })!;
        }
    }
    let mut iref = strs.String.init();
    defer iref.deinit();
    put_box(&mut iref, "dimg", refs.bytes())!;
    return make_file(its.items(), pc.bytes(), iref.bytes(), mdat.bytes());
}

test "grids: tiles that cover the grid, each once" {
    let mut ipco = strs.String.init();
    defer ipco.deinit();
    let mut tile = strs.String.init();
    defer tile.deinit();
    tile_of("alpha.avif", &mut ipco, &mut tile) catch return;
    ispe_box(&mut ipco, 64, 48)!;  // 2
    let two: [2]u16 = [2, 3];
    let f1 = grid_file(ipco.bytes(), tile.bytes(), 1, 2, 120, 48, two[..])!;
    defer mem.free(f1);
    let mut img = decode(f1)!;
    defer img.deinit();
    @expect_eq(img.width, 120);
    @expect_eq(img.height, 48);
    // the tiles are the same picture (but for the chroma filtered at their
    // edges)
    for x in @as(usize, 2)..48 {
        let a = ((10 * 120) + x) * 3;
        let b = a + (64 * 3);
        @expect_eq(img.data[a..a + 3], img.data[b..b + 3]);
    }
    // a column too few or too many
    let f2 = grid_file(ipco.bytes(), tile.bytes(), 1, 2, 130, 48, two[..])!;
    defer mem.free(f2);
    @expect(fails(f2));
    let f3 = grid_file(ipco.bytes(), tile.bytes(), 1, 2, 64, 48, two[..])!;
    defer mem.free(f3);
    @expect(fails(f3));
    // a tile used twice
    let same: [2]u16 = [2, 2];
    let f4 = grid_file(ipco.bytes(), tile.bytes(), 1, 2, 120, 48, same[..])!;
    defer mem.free(f4);
    @expect(fails(f4));
    // many tiles sharing their data
    let mut ids = vec.Vec.[u16].init();
    defer ids.deinit();
    for k in @as(usize, 0)..256 {
        ids.push(@truncate(u16, k + 2))!;
    }
    let f5 = grid_file(ipco.bytes(), tile.bytes(), 16, 16, 1024, 768, ids.items())!;
    defer mem.free(f5);
    @expect(fails(f5));
}
