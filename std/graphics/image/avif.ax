// =============================================================================
// std/graphics/image/avif.ax - AVIF images (AV1 in the HEIF container): reading.
//
//     let mut img = avif.decode(bytes)!;   // RGB(A) or gray (+ alpha); U8, or
//     defer img.deinit();                  // U16 above 8 bits per sample
//
// Still images: a primary item of AV1 (every profile: 8, 10 and 12 bits,
// 4:0:0, 4:2:0, 4:2:2 and 4:4:4, every coding tool of key and intra frames),
// or a grid of AV1 tiles; an alpha auxiliary image; the colour description
// (nclx) and the clean aperture, rotation and mirroring properties. The AV1
// decoder (av1/) follows dav1d and its output matches dav1d's exactly;
// decode_yuv gives those planes. Image sequences are read by their primary
// image; film grain is not synthesized.
// =============================================================================

import "../../collections/vec.ax" as vec;
import "../../mem.ax" as mem;
import "../image.ax" as image;
import "av1/decode.ax" as av1;
import "av1/obu.ax" as obu;

error { InvalidImage, Unsupported, OutOfMemory }

/// Whether data looks like an AVIF file (an ISOBMFF file of the avif or avis
/// brands).
pub fn is_avif(data: []u8) bool {
    if (data.len < 16) or not @mem_eq(data[4..8], "ftyp") {
        return false;
    }
    let size = @as(usize, be32(data, 0));
    let end = @min(@max(size, 16), data.len);
    let mut o: usize = 8;
    while (o + 4) <= end {
        if (o != 12) and (@mem_eq(data[o..o + 4], "avif") or @mem_eq(data[o..o + 4], "avis")) {
            return true;
        }
        o += 4;
    }
    return false;
}

fn be16(d: []u8, o: usize) u32 {
    return (@as(u32, d[o]) << 8) | @as(u32, d[o + 1]);
}

fn be32(d: []u8, o: usize) u32 {
    return (((@as(u32, d[o]) << 24) | (@as(u32, d[o + 1]) << 16)) | (@as(u32, d[o + 2]) << 8)) | @as(u32, d[o + 3]);
}

fn ben(d: []u8, o: usize, n: usize) u64 {
    let mut v: u64 = 0;
    for i in @as(usize, 0)..n {
        v = (v << 8) | @as(u64, d[o + i]);
    }
    return v;
}

// -----------------------------------------------------------------------------
// Boxes
// -----------------------------------------------------------------------------

struct Box {
    typ: [4]u8,
    body: []u8,  // after the header
    next: usize,
}

// the box at data[o..end]
fn read_box(d: []u8, o: usize, end: usize) !Box {
    if (o + 8) > end {
        return error.InvalidImage;
    }
    let mut size = @as(u64, be32(d, o));
    let mut hdr: usize = 8;
    if size == 1 {
        if (o + 16) > end {
            return error.InvalidImage;
        }
        size = ben(d, o + 8, 8);
        hdr = 16;
    } else if size == 0 {
        size = @as(u64, end - o);
    }
    if (size < @as(u64, hdr)) or (size > @as(u64, end - o)) {
        return error.InvalidImage;
    }
    let n = @truncate(usize, size);
    let mut b = Box.{ typ: [0; 4], body: d[o + hdr..o + n], next: o + n };
    @mem_copy(b.typ[..], d[o + 4..o + 8]);
    return b;
}

fn is(b: *Box, t: []u8) bool {
    return @mem_eq(b.typ[..], t);
}

struct Extent {
    offset: u64,
    length: u64,
}

const MAX_PROPS: usize = 32;

struct Item {
    id: u32,
    typ: [4]u8,
    method: u32,  // construction method: 0 file offsets, 1 idat
    base: u64,
    ext_start: usize,
    ext_count: usize,
    props: [32]u16,  // property indices (1-based)
    n_props: usize,
    aux_for: u32,  // the item this is an auxiliary image of (auxl)
    alpha: bool,
}

struct Prop {
    typ: [4]u8,
    body: []u8,
}

struct File {
    data: []u8,
    primary: u32,
    items: vec.Vec.[Item],
    extents: vec.Vec.[Extent],
    props: vec.Vec.[Prop],
    dimg_from: vec.Vec.[u32],  // grid references: (from, to) pairs in order
    dimg_to: vec.Vec.[u32],
    idat: []u8,

    fn deinit(self: *mut File) void {
        self.items.deinit();
        self.extents.deinit();
        self.props.deinit();
        self.dimg_from.deinit();
        self.dimg_to.deinit();
    }

    fn find(self: *File, id: u32) !usize {
        let its = self.items.items();
        for i in @as(usize, 0)..its.len {
            if its[i].id == id {
                return i;
            }
        }
        return error.InvalidImage;
    }

    fn prop(self: *File, it: *Item, t: []u8) ![]u8 {
        let ps = self.props.items();
        for k in @as(usize, 0)..it.n_props {
            let idx = @as(usize, it.props[k]);
            if (idx >= 1) and (idx <= ps.len) and @mem_eq(ps[idx - 1].typ[..], t) {
                return ps[idx - 1].body;
            }
        }
        return error.InvalidImage;
    }
}

fn parse(data: []u8) !File {
    let mut f = File.{ data: data, primary: 0, items: vec.Vec.[Item].init(), extents: vec.Vec.[Extent].init(),
                       props: vec.Vec.[Prop].init(), dimg_from: vec.Vec.[u32].init(), dimg_to: vec.Vec.[u32].init(),
                       idat: data[..0] };
    parse_boxes(&mut f, data) catch |e| {
        f.deinit();
        return e;
    };
    return f;
}

fn parse_boxes(f: *mut File, data: []u8) !void {
    let mut o: usize = 0;
    let mut have_meta = false;
    while o < data.len {
        let b = read_box(data, o, data.len)!;
        o = b.next;
        if is(&b, "meta") {
            parse_meta(f, b.body)!;
            have_meta = true;
        }
    }
    if not have_meta {
        return error.Unsupported;  // a sequence without items
    }
}

fn parse_meta(f: *mut File, m: []u8) !void {
    if m.len < 4 {
        return error.InvalidImage;
    }
    let mut o: usize = 4;
    // the item boxes first (iinf), then the others
    let mut pass: u32 = 0;
    while pass < 2 {
        o = 4;
        while o < m.len {
            let b = read_box(m, o, m.len)!;
            o = b.next;
            if pass == 0 {
                if is(&b, "iinf") {
                    parse_iinf(f, b.body)!;
                }
                continue;
            }
            if is(&b, "pitm") {
                if b.body.len < 6 {
                    return error.InvalidImage;
                }
                if b.body[0] == 0 {
                    f.primary = be16(b.body, 4);
                } else {
                    if b.body.len < 8 {
                        return error.InvalidImage;
                    }
                    f.primary = be32(b.body, 4);
                }
            } else if is(&b, "iloc") {
                parse_iloc(f, b.body)!;
            } else if is(&b, "iprp") {
                parse_iprp(f, b.body)!;
            } else if is(&b, "iref") {
                parse_iref(f, b.body)!;
            } else if is(&b, "idat") {
                f.idat = b.body;
            }
        }
        pass += 1;
    }
}

fn parse_iinf(f: *mut File, b: []u8) !void {
    if b.len < 6 {
        return error.InvalidImage;
    }
    let mut o: usize = 6;
    if b[0] != 0 {
        o = 8;
    }
    while o < b.len {
        let e = read_box(b, o, b.len)!;
        o = e.next;
        if not is(&e, "infe") {
            continue;
        }
        let x = e.body;
        if (x.len < 4) or (x[0] < 2) {
            continue;
        }
        let mut it = obu.zeroed.[Item]()!;
        if x[0] == 2 {
            if x.len < 12 {
                return error.InvalidImage;
            }
            it.id = be16(x, 4);
            @mem_copy(it.typ[..], x[8..12]);
        } else {
            if x.len < 14 {
                return error.InvalidImage;
            }
            it.id = be32(x, 4);
            @mem_copy(it.typ[..], x[10..14]);
        }
        f.items.push(it)!;
    }
}

fn parse_iloc(f: *mut File, b: []u8) !void {
    if b.len < 8 {
        return error.InvalidImage;
    }
    let ver = b[0];
    let off_sz = @as(usize, b[4] >> 4);
    let len_sz = @as(usize, b[4] & 15);
    let base_sz = @as(usize, b[5] >> 4);
    let mut idx_sz: usize = 0;
    if (ver == 1) or (ver == 2) {
        idx_sz = @as(usize, b[5] & 15);
    }
    let mut o: usize = 6;
    let mut n: usize = 0;
    if ver < 2 {
        n = @as(usize, be16(b, o));
        o += 2;
    } else {
        if b.len < 10 {
            return error.InvalidImage;
        }
        n = @as(usize, be32(b, o));
        o += 4;
    }
    for _q in @as(usize, 0)..n {
        let mut id: u32 = 0;
        if ver < 2 {
            if (o + 2) > b.len {
                return error.InvalidImage;
            }
            id = be16(b, o);
            o += 2;
        } else {
            if (o + 4) > b.len {
                return error.InvalidImage;
            }
            id = be32(b, o);
            o += 4;
        }
        let mut method: u32 = 0;
        if (ver == 1) or (ver == 2) {
            if (o + 2) > b.len {
                return error.InvalidImage;
            }
            method = be16(b, o) & 15;
            o += 2;
        }
        if (o + 2 + base_sz + 2) > b.len {
            return error.InvalidImage;
        }
        o += 2;  // data reference index
        let base = ben(b, o, base_sz);
        o += base_sz;
        let ne = @as(usize, be16(b, o));
        o += 2;
        let start = f.extents.items().len;
        for _e in @as(usize, 0)..ne {
            if (o + idx_sz + off_sz + len_sz) > b.len {
                return error.InvalidImage;
            }
            o += idx_sz;
            let eo = ben(b, o, off_sz);
            o += off_sz;
            let el = ben(b, o, len_sz);
            o += len_sz;
            f.extents.push(Extent.{ offset: eo, length: el })!;
        }
        let i = f.find(id) catch continue;
        let it = f.items.get_ptr(i);
        it.method = method;
        it.base = base;
        it.ext_start = start;
        it.ext_count = ne;
    }
}

fn parse_iprp(f: *mut File, b: []u8) !void {
    let mut o: usize = 0;
    while o < b.len {
        let x = read_box(b, o, b.len)!;
        o = x.next;
        if is(&x, "ipco") {
            let mut p: usize = 0;
            while p < x.body.len {
                let pb = read_box(x.body, p, x.body.len)!;
                p = pb.next;
                f.props.push(Prop.{ typ: pb.typ, body: pb.body })!;
            }
        } else if is(&x, "ipma") {
            let m = x.body;
            if m.len < 8 {
                return error.InvalidImage;
            }
            let ver = m[0];
            let wide = (m[3] & 1) != 0;
            let n = @as(usize, be32(m, 4));
            let mut q: usize = 8;
            for _q in @as(usize, 0)..n {
                let mut id: u32 = 0;
                if ver < 1 {
                    if (q + 3) > m.len {
                        return error.InvalidImage;
                    }
                    id = be16(m, q);
                    q += 2;
                } else {
                    if (q + 5) > m.len {
                        return error.InvalidImage;
                    }
                    id = be32(m, q);
                    q += 4;
                }
                let na = @as(usize, m[q]);
                q += 1;
                let i = f.find(id) catch 0xffffffff;
                for _a in @as(usize, 0)..na {
                    let mut idx: u16 = 0;
                    if wide {
                        if (q + 2) > m.len {
                            return error.InvalidImage;
                        }
                        idx = @truncate(u16, be16(m, q) & 0x7fff);
                        q += 2;
                    } else {
                        if q >= m.len {
                            return error.InvalidImage;
                        }
                        idx = @as(u16, m[q] & 0x7f);
                        q += 1;
                    }
                    if i != 0xffffffff {
                        let it = f.items.get_ptr(i);
                        if it.n_props < MAX_PROPS {
                            it.props[it.n_props] = idx;
                            it.n_props += 1;
                        }
                    }
                }
            }
        }
    }
}

fn parse_iref(f: *mut File, b: []u8) !void {
    if b.len < 4 {
        return error.InvalidImage;
    }
    let wide = b[0] != 0;
    let mut o: usize = 4;
    while o < b.len {
        let r = read_box(b, o, b.len)!;
        o = r.next;
        let x = r.body;
        let mut q: usize = 0;
        let mut from: u32 = 0;
        let mut w: usize = 2;
        if wide {
            w = 4;
        }
        if (q + w + 2) > x.len {
            return error.InvalidImage;
        }
        from = @truncate(u32, ben(x, q, w));
        q += w;
        let n = @as(usize, be16(x, q));
        q += 2;
        for _k in @as(usize, 0)..n {
            if (q + w) > x.len {
                return error.InvalidImage;
            }
            let to = @truncate(u32, ben(x, q, w));
            q += w;
            if is(&r, "auxl") {
                let i = f.find(from) catch continue;
                f.items.get_ptr(i).aux_for = to;
            } else if is(&r, "dimg") {
                f.dimg_from.push(from)!;
                f.dimg_to.push(to)!;
            }
        }
    }
}

// an item's data (freed by the caller)
fn item_data(f: *File, it: *Item, prefix: []u8) ![]mut u8 {
    let ex = f.extents.items();
    let mut total = prefix.len;
    let mut src = f.data;
    if it.method == 1 {
        src = f.idat;
    } else if it.method != 0 {
        return error.Unsupported;
    }
    for k in it.ext_start..(it.ext_start + it.ext_count) {
        let e = ex[k];
        let start = it.base +% e.offset;
        let mut len = e.length;
        if (len == 0) and (it.ext_count == 1) {
            if start > @as(u64, src.len) {
                return error.InvalidImage;
            }
            len = @as(u64, src.len) - start;
        }
        if (start > @as(u64, src.len)) or (len > (@as(u64, src.len) - start)) {
            return error.InvalidImage;
        }
        total += @truncate(usize, len);
    }
    let out = mem.alloc.[u8](@max(total, 1))!;
    @mem_copy(out[..prefix.len], prefix);
    let mut p = prefix.len;
    for k in it.ext_start..(it.ext_start + it.ext_count) {
        let e = ex[k];
        let start = @truncate(usize, it.base +% e.offset);
        let mut len = @truncate(usize, e.length);
        if (len == 0) and (it.ext_count == 1) {
            len = src.len - start;
        }
        @mem_copy(out[p..p + len], src[start..start + len]);
        p += len;
    }
    return out[..total];
}

// the AV1 planes of an av01 item
fn decode_item(f: *File, it: *Item) !av1.Frame {
    if not @mem_eq(it.typ[..], "av01") {
        return error.Unsupported;
    }
    // the configuration OBUs (a sequence header) go first, in case the
    // item's data lacks them
    let mut cfg = f.data[..0];
    let c = f.prop(it, "av1C") catch f.data[..0];
    if c.len > 4 {
        cfg = c[4..];
    }
    let data = item_data(f, it, cfg)!;
    defer mem.free(data);
    return av1.decode(data);
}

// -----------------------------------------------------------------------------
// Colour
// -----------------------------------------------------------------------------

struct Colour {
    matrix: u32,
    full: bool,
}

fn colour_of(f: *File, it: *Item, p: *av1.Frame) Colour {
    let mut c = Colour.{ matrix: p.matrix, full: p.full_range };
    let ps = f.props.items();
    for k in @as(usize, 0)..it.n_props {
        let idx = @as(usize, it.props[k]);
        if (idx < 1) or (idx > ps.len) or not @mem_eq(ps[idx - 1].typ[..], "colr") {
            continue;
        }
        let b = ps[idx - 1].body;
        if (b.len >= 11) and @mem_eq(b[..4], "nclx") {
            c.matrix = be16(b, 8);
            c.full = (b[10] & 0x80) != 0;
        }
    }
    return c;
}

// the (normalized) value of a sample of a plane, bilinearly upsampled for
// chroma
fn chroma_at(p: *av1.Frame, pl: usize, x: usize, y: usize) f32 {
    let ssh = p.pw[pl] < p.pw[0];
    let ssv = p.ph[pl] < p.ph[0];
    let d = p.planes[pl].data;
    let st = p.planes[pl].stride;
    let w = p.pw[pl];
    let h = p.ph[pl];
    if (not ssh) and not ssv {
        return @float_from_int(f32, d[(y * st) + x]);
    }
    // bilinear, between the chroma samples centred between the luma ones
    // (the last column of an odd width takes the last chroma sample, as
    // libyuv does)
    let mut x0 = x;
    let mut x1 = x;
    let mut wx0: f32 = 1.0;
    if ssh {
        x0 = x >> 1;
        x1 = x0;
        if (x & 1) == 0 {
            if (x0 > 0) and ((x + 1) < p.pw[0]) {
                x1 = x0 - 1;
            }
        } else if (x0 + 1) < w {
            x1 = x0 + 1;
        }
        wx0 = 0.75;
    }
    let mut y0 = y;
    let mut y1 = y;
    let mut wy0: f32 = 1.0;
    if ssv {
        y0 = y >> 1;
        y1 = y0;
        if (y & 1) == 0 {
            if y0 > 0 {
                y1 = y0 - 1;
            }
        } else if (y0 + 1) < h {
            y1 = y0 + 1;
        }
        wy0 = 0.75;
    }
    let a = @float_from_int(f32, d[(y0 * st) + x0]);
    let b = @float_from_int(f32, d[(y0 * st) + x1]);
    let c = @float_from_int(f32, d[(y1 * st) + x0]);
    let e = @float_from_int(f32, d[(y1 * st) + x1]);
    return (((a * wx0) + (b * (1.0 - wx0))) * wy0) + (((c * wx0) + (e * (1.0 - wx0))) * (1.0 - wy0));
}

fn kr_kb(m: u32, kr: *mut f32, kb: *mut f32) void {
    if m == 1 {
        kr.* = 0.2126;
        kb.* = 0.0722;
    } else if m == 4 {
        kr.* = 0.30;
        kb.* = 0.11;
    } else if m == 7 {
        kr.* = 0.212;
        kb.* = 0.087;
    } else if (m == 9) or (m == 10) {
        kr.* = 0.2627;
        kb.* = 0.0593;
    } else {
        kr.* = 0.299;  // BT.601 (and unspecified)
        kb.* = 0.114;
    }
}

fn clamp01(v: f32) f32 {
    if v < 0.0 {
        return 0.0;
    }
    if v > 1.0 {
        return 1.0;
    }
    return v;
}

fn store(img: *mut image.Image, i: usize, v: f32) void {
    if img.depth == image.Depth.U8 {
        img.data[i] = @truncate(u8, @bit_cast(u32, @int_from_float(i32, (clamp01(v) * 255.0) + 0.5)));
    } else {
        img.samples16()[i] = @truncate(u16, @bit_cast(u32, @int_from_float(i32, (clamp01(v) * 65535.0) + 0.5)));
    }
}

// writes the planes (as colour, or as alpha) into img at (ox, oy)
fn put_planes(img: *mut image.Image, p: *av1.Frame, col: Colour, ox: usize, oy: usize, alpha: bool) void {
    let maxv = @float_from_int(f32, (@as(u32, 1) << p.bitdepth) - 1);
    let scale = @float_from_int(f32, @as(u32, 1) << (p.bitdepth - 8));
    let w = @min(p.width, img.width - @min(ox, img.width));
    let h = @min(p.height, img.height - @min(oy, img.height));
    let ch = img.channels;
    let mut kr: f32 = 0.0;
    let mut kb: f32 = 0.0;
    kr_kb(col.matrix, &mut kr, &mut kb);
    let kg = (1.0 - kr) - kb;
    let mono = p.layout == obu.I400;
    for y in @as(usize, 0)..h {
        for x in @as(usize, 0)..w {
            let yv = @float_from_int(f32, p.planes[0].data[(y * p.planes[0].stride) + x]);
            let mut yn = yv / maxv;
            if not col.full {
                yn = (yv - (16.0 * scale)) / (219.0 * scale);
            }
            let o = (((oy + y) * img.width) + ox + x) * ch;
            if alpha {
                store(img, o + (ch - 1), yn);
                continue;
            }
            if mono or (ch <= 2) {
                store(img, o, yn);
                continue;
            }
            let u = chroma_at(p, 1, x, y);
            let v = chroma_at(p, 2, x, y);
            let mut un = (u / maxv) - (0.5 * ((maxv + 1.0) / maxv));
            let mut vn = (v / maxv) - (0.5 * ((maxv + 1.0) / maxv));
            if not col.full {
                un = (u - (128.0 * scale)) / (224.0 * scale);
                vn = (v - (128.0 * scale)) / (224.0 * scale);
            }
            let mut r: f32 = 0.0;
            let mut g: f32 = 0.0;
            let mut b: f32 = 0.0;
            if col.matrix == 0 {
                // identity (GBR)
                g = yn;
                b = u / maxv;
                r = v / maxv;
                if not col.full {
                    b = (u - (16.0 * scale)) / (219.0 * scale);
                    r = (v - (16.0 * scale)) / (219.0 * scale);
                }
            } else if col.matrix == 8 {
                // YCgCo
                let tt = yn - un;
                g = yn + un;
                b = tt - vn;
                r = tt + vn;
            } else {
                r = yn + ((2.0 - (2.0 * kr)) * vn);
                b = yn + ((2.0 - (2.0 * kb)) * un);
                g = (yn - (((2.0 * kb) * (1.0 - kb)) / kg) * un) - ((((2.0 * kr) * (1.0 - kr)) / kg) * vn);
            }
            store(img, o, r);
            store(img, o + 1, g);
            store(img, o + 2, b);
        }
    }
}

// -----------------------------------------------------------------------------
// Decoding
// -----------------------------------------------------------------------------

struct Grid {
    rows: usize,
    cols: usize,
    width: usize,
    height: usize,
}

fn read_grid(f: *File, it: *Item) !Grid {
    let d = item_data(f, it, f.data[..0])!;
    defer mem.free(d);
    if d.len < 8 {
        return error.InvalidImage;
    }
    let mut g = Grid.{ rows: @as(usize, d[2]) + 1, cols: @as(usize, d[3]) + 1, width: 0, height: 0 };
    if (d[1] & 1) == 0 {
        g.width = @as(usize, be16(d, 4));
        g.height = @as(usize, be16(d, 6));
    } else {
        if d.len < 12 {
            return error.InvalidImage;
        }
        g.width = @as(usize, be32(d, 4));
        g.height = @as(usize, be32(d, 8));
    }
    return g;
}

// the ids of a grid's tiles
fn tiles(f: *File, id: u32, out: *mut vec.Vec.[u32]) !void {
    let fr = f.dimg_from.items();
    let to = f.dimg_to.items();
    for k in @as(usize, 0)..fr.len {
        if fr[k] == id {
            out.push(to[k])!;
        }
    }
}

// draws an item (a grid of tiles, which are put together first, or an
// image) as the colour or the alpha of img
fn draw_item(f: *File, it: *Item, img: *mut image.Image, alpha: bool) !void {
    if not @mem_eq(it.typ[..], "grid") {
        let mut p = decode_item(f, it)!;
        defer p.deinit();
        put_planes(img, &p, colour_of(f, it, &p), 0, 0, alpha);
        return;
    }
    let g = read_grid(f, it)!;
    let mut ids = vec.Vec.[u32].init();
    defer ids.deinit();
    tiles(f, it.id, &mut ids)!;
    if ids.items().len != (g.rows * g.cols) {
        return error.InvalidImage;
    }
    let mut all = obu.zeroed.[av1.Frame]()!;
    defer all.deinit();
    let mut col = Colour.{ matrix: 0, full: true };
    for r in @as(usize, 0)..g.rows {
        for c in @as(usize, 0)..g.cols {
            let t = f.items.get(f.find(ids.get((r * g.cols) + c))!);
            let mut p = decode_item(f, &t)!;
            defer p.deinit();
            if (r == 0) and (c == 0) {
                // the whole: the tiles' format, the grid's size
                if ((p.width * g.cols) < g.width) or ((p.height * g.rows) < g.height) {
                    return error.InvalidImage;
                }
                all.width = g.width;
                all.height = g.height;
                all.bitdepth = p.bitdepth;
                all.layout = p.layout;
                all.full_range = p.full_range;
                all.matrix = p.matrix;
                col = colour_of(f, &t, &p);
                for pl in @as(usize, 0)..3 {
                    if p.pw[pl] == 0 {
                        continue;
                    }
                    let mut sx: usize = 1;
                    let mut sy: usize = 1;
                    if (pl > 0) and (p.layout != obu.I444) {
                        sx = 2;
                    }
                    if (pl > 0) and (p.layout == obu.I420) {
                        sy = 2;
                    }
                    all.pw[pl] = (g.width + sx - 1) / sx;
                    all.ph[pl] = (g.height + sy - 1) / sy;
                    all.planes[pl].stride = p.pw[pl] * g.cols;
                    all.planes[pl].data = mem.alloc_zeroed.[u16](all.planes[pl].stride * p.ph[pl] * g.rows)!;
                }
            }
            if (p.bitdepth != all.bitdepth) or (p.layout != all.layout) {
                return error.InvalidImage;
            }
            for pl in @as(usize, 0)..3 {
                let tw = p.pw[pl];
                let th = p.ph[pl];
                if tw == 0 {
                    continue;
                }
                if ((c + 1) * tw) > all.planes[pl].stride {
                    return error.InvalidImage;
                }
                for y in @as(usize, 0)..th {
                    let d = (((r * th) + y) * all.planes[pl].stride) + (c * tw);
                    if (d + tw) > all.planes[pl].data.len {
                        return error.InvalidImage;
                    }
                    let s = y * p.planes[pl].stride;
                    @mem_copy(all.planes[pl].data[d..d + tw], p.planes[pl].data[s..s + tw]);
                }
            }
        }
    }
    put_planes(img, &all, col, 0, 0, alpha);
}

struct Info {
    width: usize,
    height: usize,
    bitdepth: u32,
    mono: bool,
}

fn info_of(f: *File, it: *Item) !Info {
    let mut tile = it.*;
    let mut gw: usize = 0;
    let mut gh: usize = 0;
    if @mem_eq(it.typ[..], "grid") {
        let g = read_grid(f, it)!;
        gw = g.width;
        gh = g.height;
        let mut ids = vec.Vec.[u32].init();
        defer ids.deinit();
        tiles(f, it.id, &mut ids)!;
        if ids.items().len == 0 {
            return error.InvalidImage;
        }
        tile = f.items.get(f.find(ids.get(0))!);
    }
    // the sequence header, from av1C
    let c = f.prop(&tile, "av1C")!;
    if c.len < 4 {
        return error.InvalidImage;
    }
    let mut info = Info.{ width: gw, height: gh, bitdepth: 8, mono: (c[2] & 0x10) != 0 };
    let hbd = (c[2] & 0x40) != 0;
    let twelve = (c[2] & 0x20) != 0;
    if hbd {
        info.bitdepth = 10;
        if twelve {
            info.bitdepth = 12;
        }
    }
    if gw == 0 {
        let s = f.prop(it, "ispe")!;
        if s.len < 12 {
            return error.InvalidImage;
        }
        info.width = @as(usize, be32(s, 4));
        info.height = @as(usize, be32(s, 8));
    }
    if (info.width == 0) or (info.height == 0) {
        return error.InvalidImage;
    }
    return info;
}

/// Decodes an AVIF file's primary image: gray, gray + alpha, RGB or RGBA; U8
/// for 8-bit images, else U16.
pub fn decode(data: []u8) !image.Image {
    let mut f = parse(data)!;
    defer f.deinit();
    let pi = f.find(f.primary)!;
    let prim = f.items.get(pi);
    let info = info_of(&f, &prim)!;
    // an alpha auxiliary image
    let mut alpha_i: usize = 0xffffffff;
    let its = f.items.items();
    for i in @as(usize, 0)..its.len {
        if its[i].aux_for != prim.id {
            continue;
        }
        let a = f.prop(&its[i], "auxC") catch continue;
        if a.len < 4 {
            continue;
        }
        let urn = a[4..];
        if (urn.len >= 43) and
           (@mem_eq(urn[..43], "urn:mpeg:mpegB:cicp:systems:auxiliary:alpha") or
            @mem_eq(urn[..min_len(urn.len, 36)], "urn:mpeg:hevc:2015:auxid:1")) {
            alpha_i = i;
        } else if (urn.len >= 27) and @mem_eq(urn[..27], "urn:mpeg:hevc:2015:auxid:1") {
            alpha_i = i;
        }
    }
    let mut ch: usize = 3;
    if info.mono {
        ch = 1;
    }
    if alpha_i != 0xffffffff {
        ch += 1;
    }
    let mut depth = image.Depth.U8;
    if info.bitdepth > 8 {
        depth = image.Depth.U16;
    }
    let mut img = image.Image.init(info.width, info.height, ch, depth) catch |e| {
        if e == error.OutOfMemory {
            return error.OutOfMemory;
        }
        return error.Unsupported;
    };
    draw(&f, &prim, alpha_i, &mut img) catch |e| {
        img.deinit();
        return e;
    };
    return transform(&f, &prim, img);
}

fn draw(f: *File, prim: *Item, alpha_i: usize, img: *mut image.Image) !void {
    let ch = img.channels;
    if alpha_i != 0xffffffff {
        // opaque until drawn
        for i in @as(usize, 0)..(img.width * img.height) {
            store(img, (i * ch) + (ch - 1), 1.0);
        }
    }
    draw_item(f, prim, img, false)!;
    if alpha_i != 0xffffffff {
        let a = f.items.get(alpha_i);
        draw_item(f, &a, img, true)!;
    }
}

fn min_len(a: usize, b: usize) usize {
    return @min(a, b);
}

// applies the clean aperture, rotation and mirroring properties in order
fn transform(f: *File, it: *Item, img0: image.Image) !image.Image {
    let mut img = img0;
    let ps = f.props.items();
    for k in @as(usize, 0)..it.n_props {
        let idx = @as(usize, it.props[k]);
        if (idx < 1) or (idx > ps.len) {
            continue;
        }
        let p = ps[idx - 1];
        if @mem_eq(p.typ[..], "irot") and (p.body.len >= 1) {
            let n = p.body[0] & 3;
            for _r in @as(u8, 0)..n {
                let r = rotate_ccw(&img)!;
                img.deinit();
                img = r;
            }
        } else if @mem_eq(p.typ[..], "imir") and (p.body.len >= 1) {
            // axis 0 exchanges top and bottom, 1 left and right
            // (ISO/IEC 23008-12:2022)
            mirror(&mut img, (p.body[0] & 1) == 0);
        } else if @mem_eq(p.typ[..], "clap") and (p.body.len >= 32) {
            let r = clap(&img, p.body) catch continue;
            img.deinit();
            img = r;
        }
    }
    return img;
}

fn rotate_ccw(img: *image.Image) !image.Image {
    let mut out = image.Image.init(img.height, img.width, img.channels, img.depth)!;
    let bps = image.bytes_per_sample(img.depth) * img.channels;
    for y in @as(usize, 0)..img.height {
        for x in @as(usize, 0)..img.width {
            // (x, y) goes to (y, w - 1 - x)
            let src = ((y * img.width) + x) * bps;
            let dst = ((((img.width - 1) - x) * out.width) + y) * bps;
            @mem_copy(out.data[dst..dst + bps], img.data[src..src + bps]);
        }
    }
    return out;
}

fn mirror(img: *mut image.Image, vertical_flip: bool) void {
    let bps = image.bytes_per_sample(img.depth) * img.channels;
    let mut tmp: [16]u8 = [0; 16];
    if vertical_flip {
        img.flip_vertical();
        return;
    }
    for y in @as(usize, 0)..img.height {
        for x in @as(usize, 0)..(img.width / 2) {
            let a = ((y * img.width) + x) * bps;
            let b = ((y * img.width) + ((img.width - 1) - x)) * bps;
            @mem_copy(tmp[..bps], img.data[a..a + bps]);
            @mem_copy(img.data[a..a + bps], img.data[b..b + bps]);
            @mem_copy(img.data[b..b + bps], tmp[..bps]);
        }
    }
}

fn sdiv(n: u32, d: u32) !i64 {
    if d == 0 {
        return error.InvalidImage;
    }
    return @as(i64, @bit_cast(i32, n)) / @as(i64, d);
}

fn clap(img: *image.Image, b: []u8) !image.Image {
    let cw = sdiv(be32(b, 0), be32(b, 4))!;
    let chh = sdiv(be32(b, 8), be32(b, 12))!;
    // the offsets of the centre, as fractions (n / d)
    let hn = @as(i64, @bit_cast(i32, be32(b, 16)));
    let hd = @as(i64, be32(b, 20));
    let vn = @as(i64, @bit_cast(i32, be32(b, 24)));
    let vd = @as(i64, be32(b, 28));
    if (hd == 0) or (vd == 0) or (cw <= 0) or (chh <= 0) {
        return error.InvalidImage;
    }
    let iw = @as(i64, @truncate(u32, img.width));
    let ih = @as(i64, @truncate(u32, img.height));
    // left = hoff + (iw - cw) / 2
    let left = ((2 * hn) + ((iw - cw) * hd)) / (2 * hd);
    let top = ((2 * vn) + ((ih - chh) * vd)) / (2 * vd);
    if (left < 0) or (top < 0) or ((left + cw) > iw) or ((top + chh) > ih) {
        return error.InvalidImage;
    }
    return img.crop(
        @truncate(usize, @bit_cast(u64, left)), @truncate(usize, @bit_cast(u64, top)), @truncate(
            usize, @bit_cast(u64, cw)), @truncate(usize, @bit_cast(u64, chh)));
}

/// Decodes the primary image's AV1 planes exactly (not for grids): Y, U and
/// V (8-bit samples stored in u16s), with their sizes and colour description.
pub fn decode_yuv(data: []u8) !av1.Frame {
    let mut f = parse(data)!;
    defer f.deinit();
    let pi = f.find(f.primary)!;
    let prim = f.items.get(pi);
    return decode_item(&f, &prim);
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

import "../../os/fs.ax" as fs;
import "../../str.ax" as strs;
import "png.ax" as png;

fn field(line: []u8, n: usize) []u8 {
    let mut k: usize = 0;
    let mut s: usize = 0;
    for i in @as(usize, 0)..(line.len + 1) {
        if (i == line.len) or (line[i] == ' ') {
            if k == n {
                return line[s..i];
            }
            k += 1;
            s = i + 1;
        }
    }
    return line[..0];
}

test "decodes the test files exactly (YUV) and closely (RGB)" {
    let list = fs.read_file("std/graphics/image/testdata/avif/cases.txt") catch return;
    defer mem.free(list);
    let mut start: usize = 0;
    let mut n: usize = 0;
    for i in @as(usize, 0)..list.len {
        if list[i] != '\n' {
            continue;
        }
        let line = list[start..i];
        start = i + 1;
        let name = field(line, 0);
        let mut path = strs.String.init();
        defer path.deinit();
        path.push_str("std/graphics/image/testdata/avif/")!;
        path.push_str(name)!;
        path.push_str(".avif")!;
        let data = fs.read_file(path.bytes())!;
        defer mem.free(data);
        @expect(is_avif(data));
        // the planes, against dav1d's
        let mut p = decode_yuv(data)!;
        defer p.deinit();
        path.truncate(path.bytes().len - 4);
        path.push_str("yuv")!;
        let want = fs.read_file(path.bytes())!;
        defer mem.free(want);
        let mut o: usize = 0;
        for pl in @as(usize, 0)..3 {
            for y in @as(usize, 0)..p.ph[pl] {
                for x in @as(usize, 0)..p.pw[pl] {
                    let mut w = @as(u32, want[o]);
                    o += 1;
                    if p.bitdepth > 8 {
                        w |= @as(u32, want[o]) << 8;
                        o += 1;
                    }
                    @expect_eq(@as(u32, p.planes[pl].data[(y * p.planes[pl].stride) + x]), w);
                }
            }
        }
        @expect_eq(o, want.len);
        // the image, against libavif's (conversions round differently)
        let mut img = decode(data)!;
        defer img.deinit();
        @expect_eq(img.width, p.width);
        @expect_eq(img.height, p.height);
        if @mem_eq(field(line, 5), "-") {
            n += 1;
            continue;
        }
        path.truncate(path.bytes().len - 3);
        path.push_str("png")!;
        expect_close(&img, path.bytes())!;
        n += 1;
    }
    @expect_eq(n, 24);
}

// compares an image with a PNG of libavif's decoding (whose conversion to RGB
// rounds differently)
fn expect_close(img: *image.Image, png_path: []u8) !void {
    let pd = fs.read_file(png_path)!;
    defer mem.free(pd);
    let mut ref = png.decode(pd)!;
    defer ref.deinit();
    @expect_eq(ref.width, img.width);
    @expect_eq(ref.height, img.height);
    @expect_eq(ref.channels, img.channels);
    let a = img.samples8();
    let b = ref.samples8();
    let mut sum: u64 = 0;
    let mut worst: u32 = 0;
    for k in @as(usize, 0)..a.len {
        let dd = @as(u32, @max(a[k], b[k]) - @min(a[k], b[k]));
        sum += @as(u64, dd);
        worst = @max(worst, dd);
    }
    @expect(worst <= 3);
    @expect((sum * 2) <= @as(u64, a.len));
}

test "grids (in idat), rotation and mirroring" {
    let names: [2][]u8 = ["grid", "rotmir"];
    for k in @as(usize, 0)..2 {
        let mut path = strs.String.init();
        defer path.deinit();
        path.push_str("std/graphics/image/testdata/avif/")!;
        path.push_str(names[k])!;
        path.push_str(".avif")!;
        let data = fs.read_file(path.bytes()) catch return;
        defer mem.free(data);
        let mut img = decode(data)!;
        defer img.deinit();
        path.truncate(path.bytes().len - 4);
        path.push_str("png")!;
        expect_close(&img, path.bytes())!;
    }
}

fn fails(data: []u8) bool {
    let mut img = decode(data) catch return true;
    img.deinit();
    return false;
}

test "rejects damaged files" {
    let data = fs.read_file("std/graphics/image/testdata/avif/alpha.avif") catch return;
    defer mem.free(data);
    let copy = strs.dup(data)!;
    defer mem.free(copy);
    // truncations and flipped bytes: errors (or pictures), never crashes
    let mut k: usize = 0;
    while k < data.len {
        _ = fails(data[..k]);
        k += 1 + (k / 16);
    }
    for i in @as(usize, 0)..copy.len {
        let old = copy[i];
        copy[i] = old ^ @truncate(u8, (i * 37) | 1);
        _ = fails(copy);
        copy[i] = old;
    }
}
