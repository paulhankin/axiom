// =============================================================================
// std/graphics/image/exr.ax - OpenEXR: floating-point HDR images.
//
//     let img = exr.decode(bytes)!;                       // F32, linear
//     let out = exr.encode(&img, exr.Options.default())!;  // mem.free it
//     exr.encode_to(w, &img, exr.Options.default())!;     // or to an io.Writer
//
// Decoding reads single-part scanline and tiled images (the full-resolution
// level of mipmaps) with NONE, RLE, ZIPS, ZIP, PIZ and PXR24 compression and
// HALF, FLOAT and UINT channels. The channels R, G, B and A (or Y and A)
// become an F32 image of 1 to 4 channels; any other single channel becomes
// gray. B44 and DWA compression, deep and multi-part files, and subsampled
// channels are Unsupported.
//
// Encoding writes scanline images, HALF (the default) or FLOAT, compressed
// with ZIP (the default), ZIPS, RLE or NONE.
// =============================================================================

import "../../compress/deflate.ax" as deflate;
import "../../encoding/binary.ax" as binary;
import "../../io.ax" as io;
import "../../mem.ax" as mem;
import "../../str.ax" as strs;
import "../image.ax" as image;

pub error ExrError { Corrupt, Unsupported, OutOfMemory, IoError, NotFound, ChecksumMismatch, TooLarge, Done, Truncated,
                     EndOfStream, InvalidUtf8, NoSpaceLeft }

/// A compression method (its value as stored in the file).
pub enum Compression: u8 {
    NONE,
    RLE,
    ZIPS,
    ZIP,
    PIZ,
    PXR24,
}

/// The type of a channel's samples (its value as stored in the file).
pub enum PixelType: u8 {
    UINT,
    HALF,
    FLOAT,
}

pub struct Options {
    compression: Compression,  // NONE, RLE, ZIPS or ZIP
    pixel_type: PixelType,     // HALF or FLOAT

    pub fn default() Options {
        return Options.{ compression: Compression.ZIP, pixel_type: PixelType.HALF };
    }
}

pub fn is_exr(data: []u8) bool {
    return (data.len >= 8) and (data[0] == 0x76) and (data[1] == 0x2f) and (data[2] == 0x31) and (data[3] == 0x01);
}

fn type_size(t: PixelType) usize {
    if t == PixelType.HALF {
        return 2;
    }
    return 4;
}

struct Channel {
    name: []u8,
    kind: PixelType,
    target: i32,  // output channel, or -1 if unused
}

struct Header {
    channels: [16]Channel,
    nch: usize,
    compression: Compression,
    xmin: i32,
    ymin: i32,
    width: usize,
    height: usize,
    tiled: bool,
    tile_w: usize,
    tile_h: usize,
    decreasing: bool,
}

/// Scanlines per block for each compression.
fn block_lines(c: Compression) usize {
    if (c == Compression.ZIP) or (c == Compression.PXR24) {
        return 16;
    }
    if c == Compression.PIZ {
        return 32;
    }
    return 1;
}

// -----------------------------------------------------------------------------
// Decoding
// -----------------------------------------------------------------------------

fn cstr(data: []u8, pos: *mut usize) ExrError![]u8 {
    let rest = data[pos.*..];
    let n = strs.index_of_byte(rest, 0) catch return error.Corrupt;
    pos.* += n + 1;
    return rest[..n];
}

fn parse_header(data: []u8, pos: *mut usize) ExrError!Header {
    let mut h = Header.{
        channels: [Channel.{ name: "", kind: PixelType.HALF, target: -1 }; 16],
        nch: 0,
        compression: Compression.NONE,
        xmin: 0,
        ymin: 0,
        width: 0,
        height: 0,
        tiled: false,
        tile_w: 0,
        tile_h: 0,
        decreasing: false,
    };
    let mut have_window = false;
    let mut compression: u32 = 256;  // none seen
    loop {
        let name = cstr(data, pos)!;
        if name.len == 0 {
            break;
        }
        let ty = cstr(data, pos)!;
        if (pos.* + 4) > data.len {
            return error.Corrupt;
        }
        let size = @as(usize, binary.u32_le(data[pos.*..]));
        pos.* += 4;
        if size > (data.len - pos.*) {
            return error.Corrupt;
        }
        let v = data[pos.*..pos.* + size];
        pos.* += size;
        if @mem_eq(name, "channels") and @mem_eq(ty, "chlist") {
            let mut p: usize = 0;
            loop {
                let cn = cstr(v, &mut p)!;
                if cn.len == 0 {
                    break;
                }
                if ((p + 16) > v.len) or (h.nch == 16) {
                    return error.Corrupt;
                }
                let kind = binary.u32_le(v[p..]);
                let xs = binary.u32_le(v[p + 8..]);
                let ys = binary.u32_le(v[p + 12..]);
                p += 16;
                if kind > @as(u32, @int_from_enum(PixelType.FLOAT)) {
                    return error.Corrupt;
                }
                if (xs != 1) or (ys != 1) {
                    return error.Unsupported;
                }
                h.channels[h.nch] = Channel.{ name: cn, kind: @enum_from_int(PixelType, kind), target: -1 };
                h.nch += 1;
            }
        } else if @mem_eq(name, "compression") and (size == 1) {
            compression = @as(u32, v[0]);
        } else if @mem_eq(name, "dataWindow") and (size == 16) {
            let xmin = @bit_cast(i32, binary.u32_le(v[0..]));
            let ymin = @bit_cast(i32, binary.u32_le(v[4..]));
            let xmax = @bit_cast(i32, binary.u32_le(v[8..]));
            let ymax = @bit_cast(i32, binary.u32_le(v[12..]));
            if (xmax < xmin) or (ymax < ymin) {
                return error.Corrupt;
            }
            h.xmin = xmin;
            h.ymin = ymin;
            // (in 64 bits: a window can span 2^32 pixels, more than a 32-bit usize holds)
            let w64 = @as(u64, @bit_cast(u32, xmax -% xmin)) + 1;
            let h64 = @as(u64, @bit_cast(u32, ymax -% ymin)) + 1;
            if (w64 > @as(u64, image.MAX_PIXELS)) or (h64 > @as(u64, image.MAX_PIXELS)) {
                return error.Corrupt;
            }
            h.width = @truncate(usize, w64);
            h.height = @truncate(usize, h64);
            have_window = true;
        } else if @mem_eq(name, "lineOrder") and (size == 1) {
            h.decreasing = v[0] == 1;
        } else if @mem_eq(name, "tiles") and (size == 9) {
            h.tile_w = @as(usize, binary.u32_le(v[0..]));
            h.tile_h = @as(usize, binary.u32_le(v[4..]));
        } else if @mem_eq(name, "type") and not (@mem_eq(v, "scanlineimage") or @mem_eq(v, "tiledimage")) {
            return error.Unsupported;  // deep data
        }
    }
    if not have_window or (h.nch == 0) or (compression == 256) {
        return error.Corrupt;
    }
    let px = @mul_checked(h.width, h.height) catch return error.Corrupt;
    if px > image.MAX_PIXELS {
        return error.Corrupt;
    }
    if compression > @as(u32, @int_from_enum(Compression.PXR24)) {
        return error.Unsupported;  // B44, B44A, DWAA, DWAB
    }
    h.compression = @enum_from_int(Compression, compression);
    return h;
}

pub fn decode(data: []u8) ExrError!image.Image {
    if not is_exr(data) {
        return error.Corrupt;
    }
    let flags = binary.u32_le(data[4..]);
    if ((flags & 0xff) != 2) or ((flags & 0x1800) != 0) {
        return error.Unsupported;  // other versions, deep or multi-part
    }
    let mut pos: usize = 8;
    let mut h = parse_header(data, &mut pos)!;
    h.tiled = (flags & 0x200) != 0;
    if h.tiled and ((h.tile_w == 0) or (h.tile_h == 0)) {
        return error.Corrupt;
    }
    // map the channels (sorted by name in the file) to the output
    let mut chans: usize = 0;
    let r = find(&h, "R");
    let g = find(&h, "G");
    let b = find(&h, "B");
    let a = find(&h, "A");
    let y = find(&h, "Y");
    if (r >= 0) or (g >= 0) or (b >= 0) {
        chans = 3;
        set_target(&mut h, r, 0);
        set_target(&mut h, g, 1);
        set_target(&mut h, b, 2);
        if a >= 0 {
            chans = 4;
            set_target(&mut h, a, 3);
        }
    } else if y >= 0 {
        chans = 1;
        set_target(&mut h, y, 0);
        if a >= 0 {
            chans = 2;
            set_target(&mut h, a, 1);
        }
    } else {
        chans = 1;
        h.channels[0].target = 0;
    }
    // no compression method expands data more than about 2000 times (the
    // best case, PIZ's run codes, is ~450): a file too small for the image
    // it declares is broken, and must not cost gigabytes to find out
    let mut bpp: usize = 0;
    for i in @as(usize, 0)..h.nch {
        bpp += type_size(h.channels[i].kind);
    }
    let raw = @mul_checked(h.width * h.height, bpp) catch return error.Corrupt;
    if (raw / 2048) > data.len {
        return error.Corrupt;
    }
    let mut img = image.Image.init(h.width, h.height, chans, image.Depth.F32)!;
    // gray from R alone etc.: channels not present stay 0; alpha defaults to 1
    if (chans == 4) or (chans == 2) {
        let px = img.samples32();
        let mut i = chans - 1;
        while i < px.len {
            px[i] = 1.0;
            i += chans;
        }
    }
    read_chunks(data, pos, &h, &mut img) catch |e| {
        img.deinit();
        return e;
    };
    return img;
}

fn find(h: *Header, name: []u8) i32 {
    for i in @as(usize, 0)..h.nch {
        if @mem_eq(h.channels[i].name, name) {
            return @bit_cast(i32, @truncate(u32, i));
        }
    }
    return -1;
}

fn set_target(h: *mut Header, ch: i32, t: i32) void {
    if ch >= 0 {
        h.channels[@as(usize, @bit_cast(u32, ch))].target = t;
    }
}

fn read_chunks(data: []u8, start: usize, h: *Header, img: *mut image.Image) ExrError!void {
    let mut nblocks: usize = 0;
    let lines = block_lines(h.compression);
    if h.tiled {
        nblocks = ((h.width + h.tile_w - 1) / h.tile_w) * ((h.height + h.tile_h - 1) / h.tile_h);
    } else {
        nblocks = (h.height + lines - 1) / lines;
    }
    if (start + (nblocks * 8)) > data.len {
        return error.Corrupt;
    }
    let mut bpp: usize = 0;  // bytes per pixel, all channels
    for i in @as(usize, 0)..h.nch {
        bpp += type_size(h.channels[i].kind);
    }
    // a block is never bigger than the image
    let mut max_w = h.width;
    let mut max_h = @min(lines, h.height);
    if h.tiled {
        max_w = @min(h.tile_w, h.width);
        max_h = @min(h.tile_h, h.height);
    }
    let rawn = @mul_checked(@mul_checked(max_w, max_h) catch return error.Corrupt, bpp) catch return error.Corrupt;
    let raw = mem.alloc.[u8](rawn)!;
    defer mem.free(raw);
    // each block is decoded once at most (the offsets could all point at one)
    let seen = mem.alloc_zeroed.[u8](nblocks)!;
    defer mem.free(seen);
    let tiles_x = (h.width + h.tile_w - 1) / @max(h.tile_w, 1);
    let mut piz = PizScratch.init(h.compression == Compression.PIZ)!;
    defer piz.deinit();
    for bi in @as(usize, 0)..nblocks {
        let off = binary.u64_le(data[start + (bi * 8)..]);
        if off > @as(u64, data.len) {
            return error.Corrupt;
        }
        let mut p = @truncate(usize, off);
        let mut x0: usize = 0;
        let mut y0: usize = 0;
        let mut bw = h.width;
        let mut bh: usize = 0;
        if h.tiled {
            if (p + 20) > data.len {
                return error.Corrupt;
            }
            let tx = @as(usize, binary.u32_le(data[p..]));
            let ty = @as(usize, binary.u32_le(data[p + 4..]));
            if (binary.u32_le(data[p + 8..]) != 0) or (binary.u32_le(data[p + 12..]) != 0) {
                continue;  // a smaller level
            }
            if (tx >= tiles_x) or (ty * tiles_x + tx >= nblocks) {
                return error.Corrupt;
            }
            let block = (ty * tiles_x) + tx;
            if seen[block] != 0 {
                return error.Corrupt;
            }
            seen[block] = 1;
            x0 = tx * h.tile_w;
            y0 = ty * h.tile_h;
            if (x0 >= h.width) or (y0 >= h.height) {
                return error.Corrupt;
            }
            bw = @min(h.tile_w, h.width - x0);
            bh = @min(h.tile_h, h.height - y0);
            p += 16;
        } else {
            if (p + 8) > data.len {
                return error.Corrupt;
            }
            let yy = @as(i64, @bit_cast(i32, binary.u32_le(data[p..]))) - @as(i64, h.ymin);
            if (yy < 0) or (yy >= @as(i64, @truncate(u32, h.height))) {
                return error.Corrupt;
            }
            y0 = @truncate(usize, @bit_cast(u64, yy));
            if (y0 % lines) != 0 {
                return error.Corrupt;
            }
            if seen[y0 / lines] != 0 {
                return error.Corrupt;
            }
            seen[y0 / lines] = 1;
            bh = @min(lines, h.height - y0);
            p += 4;
        }
        let size = @as(usize, binary.u32_le(data[p..]));
        p += 4;
        if size > (data.len - p) {
            return error.Corrupt;
        }
        let packed = data[p..p + size];
        let n = (bw * bh) * bpp;
        let out = raw[..n];
        if (h.compression == Compression.NONE) or ((size == n) and (h.compression != Compression.PIZ)) {
            // stored raw (also when compression would not have helped)
            if size != n {
                return error.Corrupt;
            }
            @mem_copy(out, packed);
        } else if h.compression == Compression.RLE {
            rle_decode(packed, out)!;
            unpredict(out)!;
        } else if (h.compression == Compression.ZIPS) or (h.compression == Compression.ZIP) {
            let z = deflate.decompress(packed, deflate.Format.ZLIB, n) catch return error.Corrupt;
            defer mem.free(z);
            if z.len != n {
                return error.Corrupt;
            }
            @mem_copy(out, z);
            unpredict(out)!;
        } else if h.compression == Compression.PXR24 {
            pxr24_decode(packed, out, h, bw, bh)!;
        } else if h.compression == Compression.PIZ {
            if size == n {
                @mem_copy(out, packed);
            } else {
                piz_decode(packed, out, h, bw, bh, &mut piz)!;
            }
        }
        store(out, h, img, x0, y0, bw, bh);
    }
}

/// Undoes ZIP's and RLE's preprocessing: a byte delta, then splitting
/// even and odd bytes.
fn unpredict(buf: []mut u8) ExrError!void {
    let n = buf.len;
    for i in @as(usize, 1)..@max(n, 1) {
        buf[i] = (buf[i - 1] +% buf[i]) -% 128;
    }
    let t = mem.dup(buf)!;
    defer mem.free(t);
    let half = (n + 1) / 2;
    for i in @as(usize, 0)..n {
        if (i % 2) == 0 {
            buf[i] = t[i / 2];
        } else {
            buf[i] = t[half + (i / 2)];
        }
    }
}

fn rle_decode(src: []u8, out: []mut u8) ExrError!void {
    let mut i: usize = 0;
    let mut o: usize = 0;
    while i < src.len {
        let c = @bit_cast(i8, src[i]);
        i += 1;
        if c < 0 {
            let n = @as(usize, @bit_cast(u8, -c));
            if ((i + n) > src.len) or ((o + n) > out.len) {
                return error.Corrupt;
            }
            @mem_copy(out[o..o + n], src[i..i + n]);
            i += n;
            o += n;
        } else {
            let n = @as(usize, @bit_cast(u8, c)) + 1;
            if (i >= src.len) or ((o + n) > out.len) {
                return error.Corrupt;
            }
            @mem_set(out[o..o + n], src[i]);
            i += 1;
            o += n;
        }
    }
    if o != out.len {
        return error.Corrupt;
    }
}

fn pxr24_decode(src: []u8, out: []mut u8, h: *Header, bw: usize, bh: usize) ExrError!void {
    let n = out.len;
    let z = deflate.decompress(src, deflate.Format.ZLIB, n) catch return error.Corrupt;
    defer mem.free(z);
    let mut t: usize = 0;
    let mut o: usize = 0;
    for yy in @as(usize, 0)..bh {
        for c in @as(usize, 0)..h.nch {
            let kind = h.channels[c].kind;
            let mut planes: usize = 3;
            if kind == PixelType.HALF {
                planes = 2;
            } else if kind == PixelType.UINT {
                planes = 4;
            }
            if (t + (planes * bw)) > z.len {
                return error.Corrupt;
            }
            let mut pixel: u32 = 0;
            for j in @as(usize, 0)..bw {
                let mut diff: u32 = 0;
                if kind == PixelType.UINT {
                    diff = (
                        ((@as(u32, z[t + j]) << 24) | (@as(u32, z[t + bw + j]) << 16)) | (
                            @as(u32, z[t + (2 * bw) + j]) << 8)) | @as(u32, z[t + (3 * bw) + j]);
                } else if kind == PixelType.HALF {
                    diff = (@as(u32, z[t + j]) << 8) | @as(u32, z[t + bw + j]);
                } else {
                    diff = ((@as(u32, z[t + j]) << 24) | (@as(u32, z[t + bw + j]) << 16)) | (
                        @as(u32, z[t + (2 * bw) + j]) << 8);
                }
                pixel = pixel +% diff;
                if kind == PixelType.HALF {
                    out[o] = @truncate(u8, pixel);
                    out[o + 1] = @truncate(u8, pixel >> 8);
                    o += 2;
                } else {
                    for k in @as(usize, 0)..4 {
                        out[o + k] = @truncate(u8, pixel >> @truncate(u32, 8 * k));
                    }
                    o += 4;
                }
            }
            t += planes * bw;
        }
    }
}

/// Moves a decoded block (lines of channel-planar samples) into the image.
fn store(raw: []u8, h: *Header, img: *mut image.Image, x0: usize, y0: usize, bw: usize, bh: usize) void {
    let px = img.samples32();
    let ch = img.channels;
    let mut o: usize = 0;
    for yy in @as(usize, 0)..bh {
        for c in @as(usize, 0)..h.nch {
            let kind = h.channels[c].kind;
            let target = h.channels[c].target;
            let sz = type_size(kind);
            if target >= 0 {
                let t = @as(usize, @bit_cast(u32, target));
                for x in @as(usize, 0)..bw {
                    let at = o + (x * sz);
                    let mut v: f32 = 0.0;
                    if kind == PixelType.HALF {
                        v = image.half_to_f32(@truncate(u16, @as(u32, raw[at]) | (@as(u32, raw[at + 1]) << 8)));
                    } else if kind == PixelType.FLOAT {
                        v = @bit_cast(f32, binary.u32_le(raw[at..]));
                    } else {
                        v = @float_from_int(f32, binary.u32_le(raw[at..]));
                    }
                    px[((((y0 + yy) * img.width) + x0 + x) * ch) + t] = v;
                }
            }
            o += bw * sz;
        }
    }
}

// --- PIZ -------------------------------------------------------------------

const USHORT_RANGE: usize = 65536;
const BITMAP_SIZE: usize = 8192;

/// PIZ's tables, allocated once per image (they are large, and a file can
/// have many small blocks).
struct PizScratch {
    bitmap: []mut u8,
    lut: []mut u16,
    hcode: []mut u64,
    dec: []mut HufDec,

    fn init(needed: bool) ExrError!PizScratch {
        let mut p = PizScratch.{
            bitmap: mem.alloc.[u8](0)!,
            lut: mem.alloc.[u16](0)!,
            hcode: mem.alloc.[u64](0)!,
            dec: mem.alloc.[HufDec](0)!,
        };
        if not needed {
            return p;
        }
        p.deinit();
        p.bitmap = mem.alloc.[u8](BITMAP_SIZE)!;
        p.lut = mem.alloc.[u16](USHORT_RANGE) catch |e| {
            mem.free(p.bitmap);
            return e;
        };
        p.hcode = mem.alloc.[u64](HUF_ENCSIZE) catch |e| {
            mem.free(p.bitmap);
            mem.free(p.lut);
            return e;
        };
        p.dec = mem.alloc.[HufDec](HUF_DECSIZE) catch |e| {
            mem.free(p.bitmap);
            mem.free(p.lut);
            mem.free(p.hcode);
            return e;
        };
        return p;
    }

    fn deinit(self: *mut PizScratch) void {
        mem.free(self.bitmap);
        mem.free(self.lut);
        mem.free(self.hcode);
        mem.free(self.dec);
    }
}

fn piz_decode(src: []u8, out: []mut u8, h: *Header, bw: usize, bh: usize, sc: *mut PizScratch) ExrError!void {
    if src.len < 4 {
        return error.Corrupt;
    }
    let min_nz = @as(usize, src[0]) | (@as(usize, src[1]) << 8);
    let max_nz = @as(usize, src[2]) | (@as(usize, src[3]) << 8);
    let mut p: usize = 4;
    let bitmap = sc.bitmap;
    @mem_set(bitmap, 0);
    if max_nz >= BITMAP_SIZE {
        return error.Corrupt;
    }
    if min_nz <= max_nz {
        let n = (max_nz - min_nz) + 1;
        if (p + n) > src.len {
            return error.Corrupt;
        }
        @mem_copy(bitmap[min_nz..max_nz + 1], src[p..p + n]);
        p += n;
    }
    // the reverse lookup table
    let lut = sc.lut;
    lut[0] = 0;
    let mut k: usize = 1;
    if min_nz <= max_nz {
        // (bits outside the bitmap's range are all clear)
        for i in @max(min_nz * 8, 1)..(max_nz + 1) * 8 {
            if (bitmap[i >> 3] & (@as(u8, 1) << @truncate(u8, i & 7))) != 0 {
                lut[k] = @truncate(u16, i);
                k += 1;
            }
        }
    }
    let max_value = @truncate(u16, k - 1);
    if (p + 4) > src.len {
        return error.Corrupt;
    }
    let length = @as(usize, binary.u32_le(src[p..]));
    p += 4;
    if length > (src.len - p) {
        return error.Corrupt;
    }
    let nshorts = out.len / 2;
    let tmp = mem.alloc.[u16](nshorts)!;
    defer mem.free(tmp);
    huf_uncompress(src[p..p + length], tmp, sc)!;
    // wavelet decoding, channel by channel (planar in tmp)
    let mut at: usize = 0;
    for c in @as(usize, 0)..h.nch {
        let size = type_size(h.channels[c].kind) / 2;  // in 16-bit words
        for j in @as(usize, 0)..size {
            wav2_decode(tmp, at + j, bw, size, bh, bw * size, max_value);
        }
        at += (bw * bh) * size;
    }
    for i in @as(usize, 0)..nshorts {
        tmp[i] = lut[@as(usize, tmp[i])];
    }
    // planar channels to lines of interleaved channels
    let mut o: usize = 0;
    let mut starts: [16]usize = [0; 16];
    at = 0;
    for c in @as(usize, 0)..h.nch {
        starts[c] = at;
        at += (bw * bh) * (type_size(h.channels[c].kind) / 2);
    }
    for yy in @as(usize, 0)..bh {
        for c in @as(usize, 0)..h.nch {
            let n = bw * (type_size(h.channels[c].kind) / 2);
            for i in @as(usize, 0)..n {
                let v = tmp[starts[c] + i];
                out[o] = @truncate(u8, v);
                out[o + 1] = @truncate(u8, v >> 8);
                o += 2;
            }
            starts[c] += n;
        }
    }
}

fn wdec14(l: u16, h: u16) [2]u16 {
    let ls = @as(i32, @bit_cast(i16, l));
    let hi = @as(i32, @bit_cast(i16, h));
    let ai = (ls + (hi & 1)) + (hi >> 1);
    let a = @truncate(u16, @bit_cast(u32, ai));
    let b = @truncate(u16, @bit_cast(u32, ai - hi));
    return [a, b];
}

fn wdec16(l: u16, h: u16) [2]u16 {
    let m = @as(i32, l);
    let d = @as(i32, h);
    let bb = (m - (d >> 1)) & 0xffff;
    let aa = ((d + bb) - 32768) & 0xffff;
    return [@truncate(u16, @bit_cast(u32, aa)), @truncate(u16, @bit_cast(u32, bb))];
}

fn wdec(w14: bool, l: u16, h: u16) [2]u16 {
    if w14 {
        return wdec14(l, h);
    }
    return wdec16(l, h);
}

fn wav2_decode(buf: []mut u16, base: usize, nx: usize, ox: usize, ny: usize, oy: usize, mx: u16) void {
    let w14 = mx < (1 << 14);
    let n = @min(nx, ny);
    let mut p: usize = 1;
    while p <= n {
        p = p << 1;
    }
    p = p >> 1;
    let mut p2 = p;
    p = p >> 1;
    while p >= 1 {
        let oy1 = oy * p;
        let oy2 = oy * p2;
        let ox1 = ox * p;
        let ox2 = ox * p2;
        let ey = base + (oy * (ny - p2));
        let mut py = base;
        while py <= ey {
            let ex = py + (ox * (nx - p2));
            let mut px = py;
            while px <= ex {
                let p01 = px + ox1;
                let p10 = px + oy1;
                let p11 = p10 + ox1;
                let a = wdec(w14, buf[px], buf[p10]);
                let b = wdec(w14, buf[p01], buf[p11]);
                let c = wdec(w14, a[0], b[0]);
                let d = wdec(w14, a[1], b[1]);
                buf[px] = c[0];
                buf[p01] = c[1];
                buf[p10] = d[0];
                buf[p11] = d[1];
                px += ox2;
            }
            if (nx & p) != 0 {
                let p10 = px + oy1;
                let a = wdec(w14, buf[px], buf[p10]);
                buf[px] = a[0];
                buf[p10] = a[1];
            }
            py += oy2;
        }
        if (ny & p) != 0 {
            let ex = py + (ox * (nx - p2));
            let mut px = py;
            while px <= ex {
                let p01 = px + ox1;
                let a = wdec(w14, buf[px], buf[p01]);
                buf[px] = a[0];
                buf[p01] = a[1];
                px += ox2;
            }
        }
        p2 = p;
        p = p >> 1;
    }
}

// OpenEXR's Huffman coding (ImfHuf): code lengths up to 58 bits, a
// run-length symbol, and a decoding table of 14-bit prefixes.
const HUF_ENCSIZE: usize = 65537;
const HUF_DECBITS: u32 = 14;
const HUF_DECSIZE: usize = 16384;
const SHORT_ZEROCODE_RUN: u64 = 59;
const LONG_ZEROCODE_RUN: u64 = 63;
const SHORTEST_LONG_RUN: usize = 6;

struct HufDec {
    len: u32,    // a short code's length, or 0
    lit: u32,    // its symbol, or the number of long codes
    first: u32,  // long codes: index of the first in the long list
}

struct BitIn {
    d: []u8,
    pos: usize,
    c: u64,
    lc: u32,

    fn get_char(self: *mut BitIn) void {
        self.c = (self.c << 8) | @as(u64, self.d[self.pos]);
        self.pos += 1;
        self.lc += 8;
    }

    fn get_bits(self: *mut BitIn, n: u32) ExrError!u64 {
        while self.lc < n {
            if self.pos >= self.d.len {
                return error.Corrupt;
            }
            self.get_char();
        }
        self.lc -= n;
        return (self.c >> self.lc) & ((@as(u64, 1) << n) - 1);
    }
}

fn huf_uncompress(src: []u8, out: []mut u16, sc: *mut PizScratch) ExrError!void {
    if src.len == 0 {
        if out.len != 0 {
            return error.Corrupt;
        }
        return;
    }
    if src.len < 20 {
        return error.Corrupt;
    }
    let im = @as(usize, binary.u32_le(src[0..]));
    let i_m = @as(usize, binary.u32_le(src[4..]));
    let nbits = @as(usize, binary.u32_le(src[12..]));
    if (im >= HUF_ENCSIZE) or (i_m >= HUF_ENCSIZE) or (im > i_m) {
        return error.Corrupt;
    }
    // (only [im, i_m] is used: every entry there is written below)
    let hcode = sc.hcode;
    // the code lengths
    let mut bi = BitIn.{ d: src, pos: 20, c: 0, lc: 0 };
    let mut s = im;
    while s <= i_m {
        let l = bi.get_bits(6)!;
        hcode[s] = l;
        if l == LONG_ZEROCODE_RUN {
            let zerun = @as(usize, @truncate(u32, bi.get_bits(8)!)) + SHORTEST_LONG_RUN;
            if (s + zerun) > (i_m + 1) {
                return error.Corrupt;
            }
            for k in @as(usize, 0)..zerun {
                hcode[s + k] = 0;
            }
            s += zerun;
        } else if l >= SHORT_ZEROCODE_RUN {
            let zerun = @truncate(usize, l - SHORT_ZEROCODE_RUN) + 2;
            if (s + zerun) > (i_m + 1) {
                return error.Corrupt;
            }
            for k in @as(usize, 0)..zerun {
                hcode[s + k] = 0;
            }
            s += zerun;
        } else {
            s += 1;
        }
    }
    let table_end = bi.pos;
    // canonical codes: the longest codes are numerically lowest
    let mut count: [59]u64 = [0; 59];
    for i in im..i_m + 1 {
        count[@truncate(usize, hcode[i])] += 1;
    }
    let mut c: u64 = 0;
    let mut i: usize = 58;
    while i > 0 {
        let nc = (c + count[i]) >> 1;
        count[i] = c;
        c = nc;
        i -= 1;
    }
    for j in im..i_m + 1 {
        let l = hcode[j];
        if l > 0 {
            hcode[j] = l | (count[@truncate(usize, l)] << 6);
            count[@truncate(usize, l)] += 1;
        }
    }
    // the decoding table
    let dec = sc.dec;
    @mem_set(@cast_slice(u8, dec), 0);
    // first pass: count long codes per prefix
    for sym in im..i_m + 1 {
        let code = hcode[sym] >> 6;
        let l = @truncate(u32, hcode[sym] & 63);
        if (code >> l) != 0 {
            return error.Corrupt;
        }
        if l > HUF_DECBITS {
            let e = &mut dec[@truncate(usize, code >> (l - HUF_DECBITS))];
            if e.len != 0 {
                return error.Corrupt;
            }
            e.lit += 1;
        } else if l > 0 {
            let first = @truncate(usize, code << (HUF_DECBITS - l));
            for k in @as(usize, 0)..(@as(usize, 1) << @truncate(u32, HUF_DECBITS - l)) {
                let e = &mut dec[first + k];
                if (e.len != 0) or (e.lit != 0) {
                    return error.Corrupt;
                }
                e.len = l;
                e.lit = @truncate(u32, sym);
            }
        }
    }
    // second pass: lay out the long code lists
    let mut total: u32 = 0;
    for k in @as(usize, 0)..HUF_DECSIZE {
        if (dec[k].len == 0) and (dec[k].lit > 0) {
            dec[k].first = total;
            total += dec[k].lit;
            dec[k].lit = 0;  // refilled below
        }
    }
    let longs = mem.alloc.[u32](@max(@as(usize, total), 1))!;
    defer mem.free(longs);
    for sym in im..i_m + 1 {
        let code = hcode[sym] >> 6;
        let l = @truncate(u32, hcode[sym] & 63);
        if l > HUF_DECBITS {
            let e = &mut dec[@truncate(usize, code >> (l - HUF_DECBITS))];
            longs[@as(usize, e.first + e.lit)] = @truncate(u32, sym);
            e.lit += 1;
        }
    }
    // decode
    let rlc = @truncate(u32, i_m);
    let data = src[table_end..];
    let nbytes = (nbits + 7) / 8;
    if nbytes > data.len {
        return error.Corrupt;
    }
    let mut inb = BitIn.{ d: data[..nbytes], pos: 0, c: 0, lc: 0 };
    let mut o: usize = 0;
    while inb.pos < nbytes {
        inb.get_char();
        while inb.lc >= HUF_DECBITS {
            let e = dec[@truncate(usize, (inb.c >> (inb.lc - HUF_DECBITS)) & @as(u64, HUF_DECSIZE - 1))];
            if e.len > 0 {
                inb.lc -= e.len;
                o = get_code(e.lit, rlc, &mut inb, out, o)!;
            } else {
                if e.lit == 0 {
                    return error.Corrupt;
                }
                let mut found = false;
                for j in @as(usize, 0)..@as(usize, e.lit) {
                    let sym = @as(usize, longs[@as(usize, e.first) + j]);
                    let l = @truncate(u32, hcode[sym] & 63);
                    while (inb.lc < l) and (inb.pos < nbytes) {
                        inb.get_char();
                    }
                    if inb.lc >= l {
                        if (hcode[sym] >> 6) == ((inb.c >> (inb.lc - l)) & ((@as(u64, 1) << l) - 1)) {
                            inb.lc -= l;
                            o = get_code(@truncate(u32, sym), rlc, &mut inb, out, o)!;
                            found = true;
                            break;
                        }
                    }
                }
                if not found {
                    return error.Corrupt;
                }
            }
        }
    }
    // the remaining (short) codes
    let skip = @truncate(u32, (8 - (nbits % 8)) % 8);
    inb.c = inb.c >> skip;
    if inb.lc < skip {
        return error.Corrupt;
    }
    inb.lc -= skip;
    while inb.lc > 0 {
        let e = dec[@truncate(usize, (inb.c << (HUF_DECBITS - inb.lc)) & @as(u64, HUF_DECSIZE - 1))];
        if (e.len == 0) or (e.len > inb.lc) {
            return error.Corrupt;
        }
        inb.lc -= e.len;
        o = get_code(e.lit, rlc, &mut inb, out, o)!;
    }
    if o != out.len {
        return error.Corrupt;
    }
}

fn get_code(sym: u32, rlc: u32, inb: *mut BitIn, out: []mut u16, o: usize) ExrError!usize {
    if sym == rlc {
        if inb.lc < 8 {
            if inb.pos >= inb.d.len {
                return error.Corrupt;
            }
            inb.get_char();
        }
        inb.lc -= 8;
        let cs = @as(usize, @truncate(u8, inb.c >> inb.lc));
        if ((o + cs) > out.len) or (o == 0) {
            return error.Corrupt;
        }
        let v = out[o - 1];
        for k in @as(usize, 0)..cs {
            out[o + k] = v;
        }
        return o + cs;
    }
    if o >= out.len {
        return error.Corrupt;
    }
    out[o] = @truncate(u16, sym);
    return o + 1;
}

// -----------------------------------------------------------------------------
// Encoding
// -----------------------------------------------------------------------------

fn put32(o: *mut strs.String, v: u32) ExrError!void {
    let b: [4]u8 = [@truncate(u8, v), @truncate(u8, v >> 8), @truncate(u8, v >> 16), @truncate(u8, v >> 24)];
    o.push_str(b[..])!;
}

fn attr(o: *mut strs.String, name: []u8, ty: []u8, value: []u8) ExrError!void {
    o.push_str(name)!;
    o.push(0)!;
    o.push_str(ty)!;
    o.push(0)!;
    put32(o, @truncate(u32, value.len))!;
    o.push_str(value)!;
}

/// Encodes an image as OpenEXR (free the result with mem.free).
pub fn encode(img: *image.Image, opts: Options) ![]mut u8 {
    let mut s = strs.String.init();
    write(s.writer(), img, opts, true) catch |e| {
        s.deinit();
        return e;
    };
    return s.take();
}

/// Encodes an image as OpenEXR to w, a block of scanlines at a time. The
/// offset table at the start needs every block's size, so compressed blocks
/// are compressed twice: once to measure them, once to write them (encode
/// compresses once).
pub fn encode_to(w: io.Writer, img: *image.Image, opts: Options) !void {
    write(w, img, opts, false)!;
}

// keep: hold on to the packed blocks from measuring them, to write them
// without packing again (the output is going to memory anyway)
fn write(w: io.Writer, img: *image.Image, opts: Options, keep: bool) !void {
    if img.depth != image.Depth.F32 {
        let mut c = img.convert(img.channels, image.Depth.F32)!;
        defer c.deinit();
        return write(w, &c, opts, keep);
    }
    let mut o = strs.String.init();
    defer o.deinit();
    write_file(w, &mut o, img, opts, keep)!;
}

fn free_all(xs: []mut []mut u8) void {
    for x in xs {
        if x.len > 0 {
            mem.free(x);
        }
    }
    mem.free(xs);
}

const FLUSH_AT: usize = 16384;  // write out what is gathered at this size

// The blocks' data: lines of channels of samples, and the packed form.
struct Blocks {
    img: *image.Image,
    opts: Options,
    src: [4]usize,  // where each channel comes from in the image
    nch: usize,
    lines: usize,
    raw: []mut u8,
    packed: strs.String,

    // Block b's data, packed if that makes it smaller.
    fn get(self: *mut Blocks, b: usize) ![]u8 {
        let w = self.img.width;
        let h = self.img.height;
        let y0 = b * self.lines;
        let bh = @min(self.lines, h - y0);
        let sz = type_size(self.opts.pixel_type);
        let raw = self.raw;
        let px = self.img.samples32();
        let mut at: usize = 0;
        for yy in @as(usize, 0)..bh {
            for c in @as(usize, 0)..self.nch {
                for x in @as(usize, 0)..w {
                    let v = px[((((y0 + yy) * w) + x) * self.img.channels) + self.src[c]];
                    if sz == 2 {
                        let hv = image.f32_to_half(v);
                        raw[at] = @truncate(u8, hv);
                        raw[at + 1] = @truncate(u8, hv >> 8);
                    } else {
                        let bits = @bit_cast(u32, v);
                        for k in @as(usize, 0)..4 {
                            raw[at + k] = @truncate(u8, bits >> @truncate(u32, 8 * k));
                        }
                    }
                    at += sz;
                }
            }
        }
        let block = raw[..at];
        if self.opts.compression == Compression.NONE {
            return block;
        }
        let pre = mem.dup(block)!;
        defer mem.free(pre);
        predict(pre);
        self.packed.clear();
        if self.opts.compression == Compression.RLE {
            let r = rle_encode(pre)!;
            defer mem.free(r);
            self.packed.push_str(r)!;
        } else {
            let z = deflate.Compressor.init(self.packed.writer(), deflate.Format.ZLIB, 6)!;
            defer z.deinit();
            z.write_all(pre)!;
            z.finish()!;
        }
        if self.packed.len < block.len {
            return self.packed.bytes();
        }
        return block;  // stored raw when compression doesn't help
    }
}

// (o gathers the output, written to out a few KiB at a time)
fn write_file(out: io.Writer, o: *mut strs.String, img: *image.Image, opts: Options, keep: bool) !void {
    let w = img.width;
    let h = img.height;
    if (w == 0) or (h == 0) or (w > 0x7fffffff) or (h > 0x7fffffff) {
        return error.Unsupported;
    }
    if (opts.compression == Compression.PIZ) or (opts.compression == Compression.PXR24) or
       (opts.pixel_type == PixelType.UINT) {
        return error.Unsupported;
    }
    // channels, in name order, and where each comes from in the image
    let mut names: [4][]u8 = ["", "", "", ""];
    let mut src: [4]usize = [0, 0, 0, 0];
    let mut nch: usize = 0;
    if img.channels == 1 {
        names[0] = "Y";
        nch = 1;
    } else if img.channels == 2 {
        names = ["A", "Y", "", ""];
        src = [1, 0, 0, 0];
        nch = 2;
    } else if img.channels == 3 {
        names = ["B", "G", "R", ""];
        src = [2, 1, 0, 0];
        nch = 3;
    } else {
        names = ["A", "B", "G", "R"];
        src = [3, 2, 1, 0];
        nch = 4;
    }
    let magic: [8]u8 = [0x76, 0x2f, 0x31, 0x01, 2, 0, 0, 0];
    o.push_str(magic[..])!;
    let mut chl = strs.String.init();
    defer chl.deinit();
    for c in @as(usize, 0)..nch {
        chl.push_str(names[c])!;
        chl.push(0)!;
        put32(&mut chl, @as(u32, @int_from_enum(opts.pixel_type)))!;
        put32(&mut chl, 0)!;  // pLinear and reserved
        put32(&mut chl, 1)!;  // x sampling
        put32(&mut chl, 1)!;  // y sampling
    }
    chl.push(0)!;
    attr(o, "channels", "chlist", chl.bytes())!;
    let comp: [1]u8 = [@int_from_enum(opts.compression)];
    attr(o, "compression", "compression", comp[..])!;
    let mut win: [16]u8 = [0; 16];
    let xm = @truncate(u32, w - 1);
    let ym = @truncate(u32, h - 1);
    for k in @as(usize, 0)..4 {
        win[8 + k] = @truncate(u8, xm >> @truncate(u32, 8 * k));
        win[12 + k] = @truncate(u8, ym >> @truncate(u32, 8 * k));
    }
    attr(o, "dataWindow", "box2i", win[..])!;
    attr(o, "displayWindow", "box2i", win[..])!;
    let zero: [1]u8 = [0];
    attr(o, "lineOrder", "lineOrder", zero[..])!;
    attr(o, "pixelAspectRatio", "float", "\x00\x00\x80\x3f")!;
    attr(o, "screenWindowCenter", "v2f", "\x00\x00\x00\x00\x00\x00\x00\x00")!;
    attr(o, "screenWindowWidth", "float", "\x00\x00\x80\x3f")!;
    o.push(0)!;
    let lines = block_lines(opts.compression);
    let nblocks = (h + lines - 1) / lines;
    let sz = type_size(opts.pixel_type);
    let raw = mem.alloc.[u8](((w * lines) * nch) * sz)!;
    defer mem.free(raw);
    let mut bl = Blocks.{ img: img, opts: opts, src: src, nch: nch, lines: lines, raw: raw,
                          packed: strs.String.init() };
    defer bl.packed.deinit();
    let mut nkept: usize = 0;
    if keep and (opts.compression != Compression.NONE) {
        nkept = nblocks;
    }
    let kept = mem.alloc.[[]mut u8](nkept)!;
    for b in @as(usize, 0)..nkept {
        kept[b] = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
    }
    defer free_all(kept);
    // the offset table: each block is its line, its size and its data
    let mut off = @as(u64, o.len) + (@as(u64, nblocks) * 8);
    for b in @as(usize, 0)..nblocks {
        if o.len >= FLUSH_AT {
            out.write_all(o.bytes())!;
            o.clear();
        }
        let mut n: u64 = 0;
        if opts.compression == Compression.NONE {
            n = @as(u64, ((@min(lines, h - (b * lines)) * w) * nch) * sz);
        } else {
            let data = bl.get(b)!;  // (measured: packed again below, unless kept)
            n = @as(u64, data.len);
            if nkept > 0 {
                kept[b] = mem.dup(data)!;
            }
        }
        let mut ob: [8]u8 = [0; 8];
        for k in @as(usize, 0)..8 {
            ob[k] = @truncate(u8, off >> @truncate(u32, 8 * k));
        }
        o.push_str(ob[..])!;
        off += 8 + n;
    }
    for b in @as(usize, 0)..nblocks {
        let mut data: []u8 = "";
        if nkept > 0 {
            data = kept[b];
        } else {
            data = bl.get(b)!;
        }
        put32(o, @truncate(u32, b * lines))!;
        put32(o, @truncate(u32, data.len))!;
        if data.len >= FLUSH_AT {
            out.write_all(o.bytes())!;
            o.clear();
            out.write_all(data)!;
        } else {
            o.push_str(data)!;
            if o.len >= FLUSH_AT {
                out.write_all(o.bytes())!;
                o.clear();
            }
        }
        if nkept > 0 {
            mem.free(kept[b]);  // (written: let it go)
            kept[b] = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
        }
    }
    out.write_all(o.bytes())!;
}

/// ZIP's and RLE's preprocessing: even bytes then odd bytes, then deltas.
fn predict(buf: []mut u8) void {
    let n = buf.len;
    let t = mem.dup(buf) catch return;
    defer mem.free(t);
    let half = (n + 1) / 2;
    for i in @as(usize, 0)..n {
        if (i % 2) == 0 {
            buf[i / 2] = t[i];
        } else {
            buf[half + (i / 2)] = t[i];
        }
    }
    let mut i = n;
    while i > 1 {
        i -= 1;
        buf[i] = (buf[i] -% buf[i - 1]) +% 128;
    }
}

fn rle_encode(src: []u8) ExrError![]mut u8 {
    let out = mem.alloc.[u8](((src.len * 3) / 2) + 2)!;
    let mut o: usize = 0;
    let n = src.len;
    let mut rs: usize = 0;
    let mut re: usize = 1;
    while rs < n {
        while (re < n) and (src[rs] == src[re]) and ((re - rs - 1) < 127) {
            re += 1;
        }
        if (re - rs) >= 3 {
            out[o] = @truncate(u8, (re - rs) - 1);
            out[o + 1] = src[rs];
            o += 2;
            rs = re;
        } else {
            while (re < n) and
                  ((((re + 1) >= n) or (src[re] != src[re + 1])) or
                   (((re + 2) >= n) or (src[re + 1] != src[re + 2]))) and ((re - rs) < 127) {
                re += 1;
            }
            out[o] = @truncate(u8, @bit_cast(u64, @as(i64, @truncate(u32, rs)) - @as(i64, @truncate(u32, re))));
            o += 1;
            while rs < re {
                out[o] = src[rs];
                o += 1;
                rs += 1;
            }
        }
        re += 1;
    }
    return mem.realloc(out, o) catch |e| {
        mem.free(out);
        return e;
    };
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

test "round trips" {
    let comps: [4]Compression = [Compression.NONE, Compression.RLE, Compression.ZIPS, Compression.ZIP];
    let types: [2]PixelType = [PixelType.HALF, PixelType.FLOAT];
    let chans: [4]usize = [1, 2, 3, 4];
    for comp in comps {
        for t in types {
            for ch in chans {
                let mut img = image.Image.init(19, 23, ch, image.Depth.F32)!;
                defer img.deinit();
                let px = img.samples32();
                for i in @as(usize, 0)..px.len {
                    px[i] = @float_from_int(f32, (i * 7) % 50) * 0.125;  // exact in half
                }
                let enc = encode(&img, Options.{ compression: comp, pixel_type: t })!;
                defer mem.free(enc);
                let mut back = decode(enc)!;
                defer back.deinit();
                @expect_eq(back.channels, ch);
                @expect_eq(back.data[..], img.data[..]);
            }
        }
    }
}

test "encode_to" {
    let comps: [4]Compression = [Compression.NONE, Compression.RLE, Compression.ZIPS, Compression.ZIP];
    let mut img = image.Image.init(70, 40, 4, image.Depth.F32)!;
    defer img.deinit();
    let px = img.samples32();
    for i in @as(usize, 0)..px.len {
        px[i] = @float_from_int(f32, ((i * 7) + (i / 300)) % 50) * 0.125;
    }
    for comp in comps {
        let opts = Options.{ compression: comp, pixel_type: PixelType.HALF };
        let enc = encode(&img, opts)!;
        defer mem.free(enc);
        let mut s = strs.String.init();
        defer s.deinit();
        encode_to(s.writer(), &img, opts)!;
        @expect_eq(s.bytes(), enc[..]);
        let mut small: [100]u8 = [0; 100];
        let mut bw = io.BufferWriter.init(small[..]);
        encode_to(bw.writer(), &img, opts) catch |e| {
            @expect_eq(e, error.NoSpaceLeft);
            continue;
        };
        @trap();
    }
}
