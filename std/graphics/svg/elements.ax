// =============================================================================
// std/graphics/svg/elements.ax - Basic shapes, <image> data URIs, and
// <text>/<tspan> runs, part of std/graphics/svg.
// =============================================================================

import "../../collections/vec.ax" as vec;
import "../../encoding/base64.ax" as base64;
import "../../encoding/xml.ax" as xml;
import "../../math.ax" as math;
import "../../mem.ax" as mem;
import "../../str.ax" as strs;
import "../draw.ax" as draw;
import "../image.ax" as image;
import "../image/jpeg.ax" as jpeg;
import "../image/png.ax" as png;
import "path.ax" as pathdata;

// -----------------------------------------------------------------------------
// Shapes, images, and text
// -----------------------------------------------------------------------------

/// The numbers of a points attribute (x, y pairs).
fn parse_points(v: []u8, out: *mut vec.Vec.[f64]) SvgError!void {
    let mut sc = pathdata.Scanner.init(v);
    while not sc.at_end() {
        let x = sc.number() catch return;
        out.push(x)!;
    }
}

/// The outline of a basic shape or path element; false if it has none.
fn shape_path(b: *mut Builder, e: *xml.Element, s: *Style, p: *mut draw.Path) SvgError!bool {
    let name = e.local;
    let fs = s.font_size;
    if strs.eq(name, "path") {
        let d = e.attr("d") catch return false;
        pathdata.parse(d, p) catch |er| {
            if er == error.OutOfMemory {
                return er;
            }
        };
        return p.verbs.len() > 0;
    }
    if strs.eq(name, "rect") {
        let x = b.attr_length(e, "x", 'x', fs, 0.0);
        let y = b.attr_length(e, "y", 'y', fs, 0.0);
        let w = b.attr_length(e, "width", 'x', fs, 0.0);
        let h = b.attr_length(e, "height", 'y', fs, 0.0);
        if not (w > 0.0) or not (h > 0.0) {
            return false;
        }
        let mut rx = b.attr_length(e, "rx", 'x', fs, -1.0);
        let mut ry = b.attr_length(e, "ry", 'y', fs, -1.0);
        if (rx < 0.0) and (ry < 0.0) {
            rx = 0.0;
            ry = 0.0;
        } else if rx < 0.0 {
            rx = ry;
        } else if ry < 0.0 {
            ry = rx;
        }
        rx = @min(rx, w / 2.0);
        ry = @min(ry, h / 2.0);
        if (rx <= 0.0) or (ry <= 0.0) {
            p.rect(x, y, w, h)!;
            return true;
        }
        let hp = math.PI / 2.0;
        p.move_to(x + rx, y)!;
        p.line_to((x + w) - rx, y)!;
        p.elliptic_arc((x + w) - rx, y + ry, rx, ry, -hp, 0.0, false)!;
        p.line_to(x + w, (y + h) - ry)!;
        p.elliptic_arc((x + w) - rx, (y + h) - ry, rx, ry, 0.0, hp, false)!;
        p.line_to(x + rx, y + h)!;
        p.elliptic_arc(x + rx, (y + h) - ry, rx, ry, hp, math.PI, false)!;
        p.line_to(x, y + ry)!;
        p.elliptic_arc(x + rx, y + ry, rx, ry, math.PI, math.PI + hp, false)!;
        p.close()!;
        return true;
    }
    if strs.eq(name, "circle") {
        let cx = b.attr_length(e, "cx", 'x', fs, 0.0);
        let cy = b.attr_length(e, "cy", 'y', fs, 0.0);
        let r = b.attr_length(e, "r", 'o', fs, 0.0);
        if not (r > 0.0) {
            return false;
        }
        p.circle(cx, cy, r)!;
        return true;
    }
    if strs.eq(name, "ellipse") {
        let cx = b.attr_length(e, "cx", 'x', fs, 0.0);
        let cy = b.attr_length(e, "cy", 'y', fs, 0.0);
        let mut rx = b.attr_length(e, "rx", 'x', fs, -1.0);
        let mut ry = b.attr_length(e, "ry", 'y', fs, -1.0);
        if rx < 0.0 {
            rx = ry;  // SVG 2's auto
        }
        if ry < 0.0 {
            ry = rx;
        }
        if not (rx > 0.0) or not (ry > 0.0) {
            return false;
        }
        p.ellipse(cx, cy, rx, ry)!;
        return true;
    }
    if strs.eq(name, "line") {
        p.move_to(b.attr_length(e, "x1", 'x', fs, 0.0), b.attr_length(e, "y1", 'y', fs, 0.0))!;
        p.line_to(b.attr_length(e, "x2", 'x', fs, 0.0), b.attr_length(e, "y2", 'y', fs, 0.0))!;
        return true;
    }
    if strs.eq(name, "polyline") or strs.eq(name, "polygon") {
        let mut v = vec.Vec.[f64].init();
        defer v.deinit();
        parse_points(e.attr("points") catch "", &mut v)!;
        let xs = v.items();
        let n = xs.len / 2;
        if n == 0 {
            return false;
        }
        p.move_to(xs[0], xs[1])!;
        for i in @as(usize, 1)..n {
            p.line_to(xs[2 * i], xs[(2 * i) + 1])!;
        }
        if strs.eq(name, "polygon") {
            p.close()!;
        }
        return true;
    }
    return false;
}

/// The outline of a basic shape or path element as one of the document's
/// paths (in its user space), or NO_PATH if it has none. Path data and
/// points depend on nothing else, so each element's are parsed once; the
/// other shapes (whose lengths can depend on the font size and the
/// viewport) share the path made last time if it comes out the same.
fn element_path(b: *mut Builder, e: *xml.Element, s: *Style) SvgError!usize {
    let key = @int_from_ptr(e);
    let once = strs.eq(e.local, "path") or strs.eq(e.local, "polyline") or strs.eq(e.local, "polygon");
    let last = b.shape_paths.get(key) ?? NO_PATH;
    if once and b.shape_paths.contains(key) {
        return last;
    }
    let mut p = draw.Path.init();
    let ok = shape_path(b, e, s, &mut p) catch |er| {
        p.deinit();
        return er;
    };
    if not ok {
        p.deinit();
        if once {
            b.shape_paths.put(key, NO_PATH)!;
        }
        return NO_PATH;
    }
    if (last != NO_PATH) and same_path(&b.doc.paths.items()[last], &p) {
        p.deinit();
        return last;
    }
    let idx = b.store_path(&mut p)!;
    b.shape_paths.put(key, idx)!;
    return idx;
}

fn stroke_of(s: *Style) draw.Stroke {
    let mut st = draw.Stroke.width(s.stroke_width);
    st.cap = s.cap;
    st.join = s.join;
    st.miter_limit = s.miter;
    st.dash = s.dash;
    st.dash_offset = s.dash_offset;
    return st;
}

fn shape(b: *mut Builder, e: *xml.Element, s: *Style, t: draw.Affine) SvgError!void {
    if not s.visible and (s.clip_path.len == 0) {
        // (nothing to draw; but children of a hidden group may show, which
        // shapes do not have)
        return;
    }
    if not s.visible {
        return;
    }
    let pi = element_path(b, e, s)!;
    if pi == NO_PATH {
        return;
    }
    let bbox = b.bounds.get(pi);
    let mut it = blank_item(ItemKind.SHAPE, t);
    let both = (s.fill.kind != PaintKind.NONE) and (s.stroke.kind != PaintKind.NONE) and (s.stroke_width > 0.0);
    // an opacity on one paint can go into it; on two, it needs a group
    let mut fold: f32 = 1.0;
    let mut gs = s.*;
    if not both {
        fold = s.opacity;
        gs.opacity = 1.0;
    }
    it.has_fill = make_paint(b, s.fill, s, s.fill_opacity * fold, bbox, &mut it.fill)!;
    it.fill_rule = s.fill_rule;
    if s.stroke_width > 0.0 {
        it.has_stroke = make_paint(b, s.stroke, s, s.stroke_opacity * fold, bbox, &mut it.stroke)!;
    }
    it.style = stroke_of(s);
    if not it.has_fill and not it.has_stroke {
        return;
    }
    it.path = pi;
    let mut wrapped = begin_group(b, &gs, t, bbox)!;
    b.push_item(it)!;
    end_group(b, &mut wrapped, 0)!;
}

/// The image of a data URI, if it has at most room pixels (else TooLarge).
fn data_uri_image(v: []u8, room: usize) SvgError!image.Image {
    let t = strs.trim(v);
    if not strs.starts_with(t, "data:") {
        return error.Unsupported;
    }
    let comma = strs.index_of_byte(t, ',') ?? return error.SyntaxError;
    let head = t[5..comma];
    if not strs.ends_with(head, ";base64") {
        return error.Unsupported;
    }
    // base64 with the white space taken out
    let body = t[comma + 1..];
    let clean = mem.alloc.[u8](body.len)!;
    defer mem.free(clean);
    let mut n: usize = 0;
    for c in body {
        if not pathdata.is_space(c) {
            clean[n] = c;
            n += 1;
        }
    }
    let data = base64.decode_alloc(clean[..n], base64.STANDARD) catch return error.SyntaxError;
    defer mem.free(data);
    let is_png = (data.len >= 8) and (data[0] == 0x89) and (data[1] == 'P') and (data[2] == 'N') and (data[3] == 'G');
    if not is_png and not ((data.len >= 3) and (data[0] == 0xff) and (data[1] == 0xd8)) {
        return error.Unsupported;
    }
    // (the decoders refuse a size past room before allocating for it)
    let opts = image.DecodeOptions.{ max_pixels: room };
    if is_png {
        return png.decode_with(data, opts);
    }
    return jpeg.decode_with(data, opts);
}

/// The index in Document.images of an image element's image (decoded the
/// first time), or NO_PATH if it has none.
fn element_image(b: *mut Builder, e: *xml.Element) SvgError!usize {
    let key = @int_from_ptr(e);
    if let .some(cached) = b.image_index.get(key) {
        return cached;
    }
    let mut idx = NO_PATH;
    let href = href_value(e) catch "";
    let mut im = data_uri_image(href, MAX_IMAGE_PIXELS - b.pixels) catch |er| {
        if er == error.OutOfMemory {
            return er;
        }
        b.image_index.put(key, NO_PATH)!;
        return NO_PATH;  // unreadable, external or too big: nothing
    };
    if (im.width > 0) and (im.height > 0) {
        b.doc.images.push(image.Image.{ width: 0, height: 0, channels: 4, depth: image.Depth.U8,
                                        data: [] }) catch |er| {
            im.deinit();
            return er;
        };
        b.pixels += im.width * im.height;
        idx = b.doc.images.len() - 1;
        @swap(b.doc.images.get_ptr(idx), &mut im);
    } else {
        im.deinit();
    }
    b.image_index.put(key, idx)!;
    return idx;
}

fn image_element(b: *mut Builder, e: *xml.Element, s: *Style, t: draw.Affine) SvgError!void {
    if not s.visible {
        return;
    }
    let index = element_image(b, e)!;
    if index == NO_PATH {
        return;
    }
    let img = &b.doc.images.items()[index];
    let iw = @float_from_int(f64, img.width);
    let ih = @float_from_int(f64, img.height);
    let fs = s.font_size;
    let x = b.attr_length(e, "x", 'x', fs, 0.0);
    let y = b.attr_length(e, "y", 'y', fs, 0.0);
    let w = b.attr_length(e, "width", 'x', fs, iw);
    let h = b.attr_length(e, "height", 'y', fs, ih);
    if not (w > 0.0) or not (h > 0.0) {
        return;
    }
    let fit = parse_fit(e.attr("preserveAspectRatio") catch "");
    let place = viewbox_transform([0.0, 0.0, iw, ih], fit, w, h).then(draw.Affine.translation(x, y));
    if fit.slice {
        let mut rp = rect_path(x, y, w, h)!;
        let mut dp = draw.Path.init();
        pathdata.append_transformed(&mut dp, &rp, t) catch |er| {
            rp.deinit();
            dp.deinit();
            return er;
        };
        rp.deinit();
        let mut it = blank_item(ItemKind.BEGIN_GROUP, t);
        it.path = b.store_path(&mut dp)!;
        b.push_item(it)!;
    }
    let mut g = begin_group(b, s, t, pathdata.Box.{ x0: x, y0: y, x1: x + w, y1: y + h })!;
    let mut it = blank_item(ItemKind.IMAGE, place.then(t));
    it.image = index;
    it.width = iw;
    it.height = ih;
    b.push_item(it)!;
    end_group(b, &mut g, 0)!;
    if fit.slice {
        close_group(b)!;
    }
}

// --- text ---

struct TextState {
    has_x: bool,  // a position for the next run
    has_y: bool,
    x: f64,
    y: f64,
    dx: f64,
    dy: f64,
    space: bool,  // the text so far ends with a space (or is empty)
    last: usize,  // the last run's item (NO_PATH: none)
}

/// Reads x, y, dx and dy of a text or tspan element into the state.
fn text_position(b: *Builder, e: *xml.Element, s: *Style, st: *mut TextState) void {
    let fs = s.font_size;
    let xa = e.attr("x") catch "";
    if xa.len > 0 {
        st.x = b.first_length(e, "x", 'x', fs) catch st.x;
        st.has_x = true;
    }
    let ya = e.attr("y") catch "";
    if ya.len > 0 {
        st.y = b.first_length(e, "y", 'y', fs) catch st.y;
        st.has_y = true;
    }
    st.dx += b.first_length(e, "dx", 'x', fs) catch 0.0;
    st.dy += b.first_length(e, "dy", 'y', fs) catch 0.0;
}

fn text_element(b: *mut Builder, e: *xml.Element, s: *Style, t: draw.Affine, depth: usize) SvgError!void {
    let mut wrapped = begin_group(b, s, t, pathdata.Box.empty())!;
    let mut st = TextState.{ has_x: true, has_y: true, x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, space: true, last: NO_PATH };
    text_position(b, e, s, &mut st);
    text_runs(b, e, s, t, &mut st, depth)!;
    // no trailing space
    if st.last != NO_PATH {
        let it = &mut b.doc.items.items_mut()[st.last];
        if strs.ends_with(it.text, " ") {
            it.text = it.text[..it.text.len - 1];
        }
    }
    end_group(b, &mut wrapped, depth)!;
}

fn text_runs(b: *mut Builder, e: *xml.Element, s: *Style, t: draw.Affine, st: *mut TextState,
             depth: usize) SvgError!void {
    if depth > MAX_NESTING {
        return error.TooComplex;
    }
    for c in e.children {
        match c {
            .Text(raw) => {
                // white space: newlines go, tabs become spaces, runs of spaces one
                b.charge_data(raw.len)!;
                let buf = b.doc.arena.bytes(raw.len)!;
                let mut n: usize = 0;
                for ch in raw {
                    if (ch == '\n') or (ch == '\r') {
                        continue;
                    }
                    let mut k = ch;
                    if k == '\t' {
                        k = ' ';
                    }
                    if (k == ' ') and st.space {
                        continue;
                    }
                    buf[n] = k;
                    n += 1;
                    st.space = k == ' ';
                }
                if (n == 0) or not s.visible {
                    continue;
                }
                let mut it = blank_item(ItemKind.TEXT, t);
                it.text = buf[..n];
                it.x = st.x;
                it.y = st.y;
                it.has_x = st.has_x;
                it.has_y = st.has_y;
                it.dx = st.dx;
                it.dy = st.dy;
                it.size = s.font_size;
                it.anchor = s.anchor;
                // (a rough box for gradients in bounding box units)
                let bx = pathdata.Box.{ x0: st.x, y0: st.y - s.font_size,
                                        x1: st.x + ((@float_from_int(f64, n) * s.font_size) * 0.5), y1: st.y };
                it.has_fill = make_paint(b, s.fill, s, s.fill_opacity, bx, &mut it.fill)!;
                it.fill_rule = s.fill_rule;
                if s.stroke_width > 0.0 {
                    it.has_stroke = make_paint(b, s.stroke, s, s.stroke_opacity, bx, &mut it.stroke)!;
                }
                it.style = stroke_of(s);
                st.has_x = false;
                st.has_y = false;
                st.dx = 0.0;
                st.dy = 0.0;
                b.push_item(it)!;
                st.last = b.doc.items.len() - 1;
            }
            .Element(x) => {
                if is_svg(x) and strs.eq(x.local, "tspan") {
                    b.enter(x)!;
                    let ts = b.compute_style(x, s);
                    let r = ts!;
                    if r.display {
                        text_position(b, x, &r, st);
                        text_runs(b, x, &r, t, st, depth + 1) catch |er| {
                            b.leave();
                            return er;
                        };
                    }
                    b.leave();
                }
            }
            else => {}
        }
    }
}
