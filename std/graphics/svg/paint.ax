// =============================================================================
// std/graphics/svg/paint.ax - Computed styles, paint specs, and gradient paint
// server resolution, part of std/graphics/svg.
// =============================================================================

import "../../collections/vec.ax" as vec;
import "../../encoding/xml.ax" as xml;
import "../../str.ax" as strs;
import "../color.ax" as color;
import "../draw.ax" as draw;
import "css.ax" as css;
import "path.ax" as pathdata;

// -----------------------------------------------------------------------------
// Styles
// -----------------------------------------------------------------------------

enum PaintKind: u8 {
    NONE,
    COLOR,
    CURRENT,  // currentColor
    URL,      // a paint server, with a fallback
}

struct PaintSpec {
    kind: PaintKind,
    color: color.Color,
    url: []u8,
    fallback: PaintKind,
    fallback_color: color.Color,
}

/// The computed properties of an element.
struct Style {
    fill: PaintSpec,
    stroke: PaintSpec,
    fill_opacity: f32,
    stroke_opacity: f32,
    opacity: f32,
    fill_rule: draw.FillRule,
    clip_rule: draw.FillRule,
    stroke_width: f64,
    cap: draw.Cap,
    join: draw.Join,
    miter: f64,
    dash: []f64,
    dash_offset: f64,
    color: color.Color,
    visible: bool,
    display: bool,
    font_size: f64,
    anchor: u8,
    stop_color: color.Color,
    stop_opacity: f32,
    clip_path: []u8,
    mask: []u8,
}

fn black() color.Color {
    return color.Color.rgb(0.0, 0.0, 0.0);
}

fn initial_style() Style {
    let none = PaintSpec.{ kind: PaintKind.NONE, color: black(), url: "", fallback: PaintKind.NONE,
                           fallback_color: black() };
    let mut fill = none;
    fill.kind = PaintKind.COLOR;
    return Style.{
        fill: fill,
        stroke: none,
        fill_opacity: 1.0,
        stroke_opacity: 1.0,
        opacity: 1.0,
        fill_rule: draw.FillRule.NONZERO,
        clip_rule: draw.FillRule.NONZERO,
        stroke_width: 1.0,
        cap: draw.Cap.BUTT,
        join: draw.Join.MITER,
        miter: 4.0,
        dash: [],
        dash_offset: 0.0,
        color: black(),
        visible: true,
        display: true,
        font_size: 16.0,
        anchor: 0,
        stop_color: black(),
        stop_opacity: 1.0,
        clip_path: "",
        mask: "",
    };
}

/// A child's starting style: the inherited properties of its parent's.
fn inherit(parent: *Style) Style {
    let mut s = parent.*;
    let init = initial_style();
    s.opacity = 1.0;
    s.display = true;
    s.stop_color = init.stop_color;
    s.stop_opacity = 1.0;
    s.clip_path = "";
    s.mask = "";
    return s;
}

fn number_or_percent(v: []u8) SvgError!f64 {
    let t = strs.trim(v);
    let mut sc = pathdata.Scanner.init(t);
    let x = sc.raw_number() catch return error.SyntaxError;
    let rest = strs.trim(t[sc.i..]);
    if strs.eq(rest, "%") {
        return x / 100.0;
    }
    if rest.len != 0 {
        return error.SyntaxError;
    }
    return x;
}

fn unit_value(v: []u8) SvgError!f32 {
    let x = number_or_percent(v)!;
    return @float_cast(f32, @min(@max(x, 0.0), 1.0));
}

/// Parses a paint: none, currentColor, a colour, or url(#id) with an
/// optional fallback.
fn parse_paint(v: []u8, out: *mut PaintSpec) SvgError!void {
    let t = strs.trim(v);
    if strs.eq(t, "none") {
        out.kind = PaintKind.NONE;
        return;
    }
    if strs.eq_ignore_case(t, "currentColor") {
        out.kind = PaintKind.CURRENT;
        return;
    }
    if strs.starts_with(t, "url(") {
        let close = strs.index_of_byte(t, ')') ?? return error.SyntaxError;
        let id = url_id(t[..close + 1]) catch return error.SyntaxError;
        let rest = strs.trim(t[close + 1..]);
        let mut fb = PaintKind.NONE;
        let mut fc = black();
        if rest.len > 0 {
            if strs.eq(rest, "none") {
                fb = PaintKind.NONE;
            } else if strs.eq_ignore_case(rest, "currentColor") {
                fb = PaintKind.CURRENT;
            } else {
                fc = css.parse_color(rest) catch return error.SyntaxError;
                fb = PaintKind.COLOR;
            }
        }
        out.kind = PaintKind.URL;
        out.url = id;
        out.fallback = fb;
        out.fallback_color = fc;
        return;
    }
    let c = css.parse_color(t) catch return error.SyntaxError;
    out.kind = PaintKind.COLOR;
    out.color = c;
}

/// The id in "url(#id)" (quotes allowed).
fn url_id(v: []u8) SvgError![]u8 {
    let t = strs.trim(v);
    if not strs.starts_with(t, "url(") or not strs.ends_with(t, ")") {
        return error.SyntaxError;
    }
    let mut inner = strs.trim(t[4..t.len - 1]);
    if (inner.len >= 2) and ((inner[0] == '"') or (inner[0] == '\'')) and (inner[inner.len - 1] == inner[0]) {
        inner = strs.trim(inner[1..inner.len - 1]);
    }
    if (inner.len < 2) or (inner[0] != '#') {
        return error.SyntaxError;
    }
    return inner[1..];
}

fn is_property(name: []u8) bool {
    let props: [25][]u8 = [
        "fill",
        "stroke",
        "fill-opacity",
        "stroke-opacity",
        "opacity",
        "fill-rule",
        "clip-rule",
        "stroke-width",
        "stroke-linecap",
        "stroke-linejoin",
        "stroke-miterlimit",
        "stroke-dasharray",
        "stroke-dashoffset",
        "color",
        "display",
        "visibility",
        "font-size",
        "text-anchor",
        "stop-color",
        "stop-opacity",
        "clip-path",
        "font",
        "font-family",
        "font-weight",
        "mask",
    ];
    for p in props {
        if strs.eq(p, name) {
            return true;
        }
    }
    return false;
}

// -----------------------------------------------------------------------------
// Paints and gradients
// -----------------------------------------------------------------------------

/// The draw.Paint for a paint spec at an alpha, for a shape whose box is
/// bbox; false if nothing is painted.
fn make_paint(b: *mut Builder, spec: PaintSpec, s: *Style, alpha: f32, bbox: pathdata.Box,
              out: *mut draw.Paint) SvgError!bool {
    if spec.kind == PaintKind.NONE {
        return false;
    }
    if spec.kind == PaintKind.COLOR {
        out.* = draw.Paint.solid(spec.color.with_alpha(spec.color.a * alpha));
        return true;
    }
    if spec.kind == PaintKind.CURRENT {
        out.* = draw.Paint.solid(s.color.with_alpha(s.color.a * alpha));
        return true;
    }
    let g = b.ids.get(spec.url) ?? {
        let mut fb = spec;
        fb.kind = spec.fallback;
        fb.color = spec.fallback_color;
        return make_paint(b, fb, s, alpha, bbox, out);
    };
    if not is_svg(g) or (not strs.eq(g.local, "linearGradient") and not strs.eq(g.local, "radialGradient")) {
        let mut fb = spec;
        fb.kind = spec.fallback;
        fb.color = spec.fallback_color;
        return make_paint(b, fb, s, alpha, bbox, out);
    }
    return gradient(b, g, s, alpha, bbox, out);
}

/// An attribute of a gradient, or of the gradients it inherits from.
fn gradient_attr(b: *Builder, g: *xml.Element, name: []u8) SvgError![]u8 {
    let mut cur = g;
    for _i in @as(usize, 0)..16 {
        let v = cur.attr(name) catch {
            cur = b.href(cur) catch return error.SyntaxError;
            if not strs.eq(cur.local, "linearGradient") and not strs.eq(cur.local, "radialGradient") {
                return error.SyntaxError;
            }
            continue;
        };
        return v;
    }
    return error.SyntaxError;
}

/// The gradient whose stops g uses (itself or one it inherits from).
fn gradient_stops_owner(b: *Builder, g: *xml.Element) SvgError!*xml.Element {
    let mut cur = g;
    for _i in @as(usize, 0)..16 {
        for c in cur.children {
            match c {
                .Element(x) => {
                    if strs.eq(x.local, "stop") {
                        return cur;
                    }
                }
                else => {}
            }
        }
        cur = b.href(cur) catch return error.SyntaxError;
        if not strs.eq(cur.local, "linearGradient") and not strs.eq(cur.local, "radialGradient") {
            return error.SyntaxError;
        }
    }
    return error.SyntaxError;
}

fn gradient(b: *mut Builder, g: *xml.Element, s: *Style, alpha: f32, bbox: pathdata.Box,
            out: *mut draw.Paint) SvgError!bool {
    // (its attributes are looked up a dozen times, along its href chain)
    let mut attrs: usize = 0;
    let mut cur = g;
    for _i in @as(usize, 0)..16 {
        attrs += cur.attrs.len;
        cur = b.href(cur) catch break;
    }
    b.charge(12 * attrs)!;
    // the stops, with their own styles
    let owner = gradient_stops_owner(b, g) catch return false;
    let mut stops = vec.Vec.[draw.Stop].init();
    defer stops.deinit();
    let base = initial_style();
    let mut last: f64 = 0.0;
    for c in owner.children {
        match c {
            .Element(x) => {
                if strs.eq(x.local, "stop") {
                    b.enter(x)!;
                    let st = b.compute_style(x, &base);
                    b.leave();
                    let ss = st!;
                    let ov = x.attr("offset") catch "0";
                    let mut off = number_or_percent(ov) catch 0.0;
                    off = @min(@max(off, last), 1.0);
                    last = off;
                    let col = ss.stop_color;
                    stops.push(draw.Stop.{ offset: off, color: col.with_alpha((col.a * ss.stop_opacity) * alpha) })!;
                }
            }
            else => {}
        }
    }
    if stops.len() == 0 {
        return false;
    }
    if stops.len() == 1 {
        out.* = draw.Paint.solid(stops.get(0).color);
        return true;
    }
    let user = strs.eq(strs.trim(gradient_attr(b, g, "gradientUnits") catch ""), "userSpaceOnUse");
    let mut gt = draw.Affine.identity();
    let tv = gradient_attr(b, g, "gradientTransform") catch "";
    if tv.len > 0 {
        css.parse_transform(tv, &mut gt) catch {};
    }
    let mut space = gt;
    if not user {
        let bw = bbox.x1 - bbox.x0;
        let bh = bbox.y1 - bbox.y0;
        if bbox.is_empty() or not (bw > 0.0) or not (bh > 0.0) {
            return false;
        }
        space = gt.then(draw.Affine.scaling(bw, bh)).then(draw.Affine.translation(bbox.x0, bbox.y0));
    }
    let sm = strs.trim(gradient_attr(b, g, "spreadMethod") catch "pad");
    let mut spread = draw.Spread.PAD;
    if strs.eq(sm, "repeat") {
        spread = draw.Spread.REPEAT;
    } else if strs.eq(sm, "reflect") {
        spread = draw.Spread.REFLECT;
    }
    let fine = shared_stops(b, owner, stops.items())!;
    if strs.eq(g.local, "linearGradient") {
        let x1 = gradient_length(b, g, "x1", 'x', user, 0.0);
        let y1 = gradient_length(b, g, "y1", 'y', user, 0.0);
        let x2 = gradient_length(b, g, "x2", 'x', user, 1.0);
        let y2 = gradient_length(b, g, "y2", 'y', user, 0.0);
        if (x1 == x2) and (y1 == y2) {
            out.* = draw.Paint.solid(stops.get(stops.len() - 1).color);
            return true;
        }
        out.* = draw.Paint.linear(x1, y1, x2, y2, fine).with_spread(spread).with_transform(space);
        return true;
    }
    let cx = gradient_length(b, g, "cx", 'x', user, 0.5);
    let cy = gradient_length(b, g, "cy", 'y', user, 0.5);
    let r = gradient_length(b, g, "r", 'o', user, 0.5);
    if not (r > 0.0) {
        out.* = draw.Paint.solid(stops.get(stops.len() - 1).color);
        return true;
    }
    // the focal point: (cx, cy) unless fx or fy say otherwise
    let fx = gradient_length(b, g, "fx", 'x', user, cx);
    let fy = gradient_length(b, g, "fy", 'y', user, cy);
    let no_fx = fails_attr(gradient_attr(b, g, "fx"));
    let no_fy = fails_attr(gradient_attr(b, g, "fy"));
    if (no_fx and no_fy) or ((fx == cx) and (fy == cy)) {
        out.* = draw.Paint.radial(cx, cy, r, fine).with_spread(spread).with_transform(space);
        return true;
    }
    let ffx = if_else(no_fx, cx, fx);
    let ffy = if_else(no_fy, cy, fy);
    out.* = draw.Paint.radial_focal(cx, cy, r, ffx, ffy, fine).with_spread(spread).with_transform(space);
    return true;
}

/// A copy of a gradient's stops, kept in the document: the copy made
/// last time, if they are the same.
fn shared_stops(b: *mut Builder, owner: *xml.Element, stops: []draw.Stop) SvgError![]draw.Stop {
    let key = @int_from_ptr(owner);
    let last: []draw.Stop = b.stops.get(key) ?? [];
    b.charge(stops.len)!;
    if last.len == stops.len {
        let mut same = true;
        for i in @as(usize, 0)..stops.len {
            let a = last[i];
            let c = stops[i];
            if (a.offset != c.offset) or (a.color.r != c.color.r) or (a.color.g != c.color.g) or
               (a.color.b != c.color.b) or (a.color.a != c.color.a) {
                same = false;
                break;
            }
        }
        if same {
            return last;
        }
    }
    b.charge_data(stops.len * @size_of(draw.Stop))!;
    let c = b.doc.arena.copy(stops)!;
    b.stops.put(key, c)!;
    return c;
}

/// A gradient coordinate: user units (or a percentage of the viewport),
/// or a fraction of the bounding box (numbers and percentages alike).
fn gradient_length(b: *Builder, g: *xml.Element, name: []u8, axis: u8, user: bool, default: f64) f64 {
    let v = gradient_attr(b, g, name) catch {
        if user {
            // the default percentages, of the viewport
            let mut base = @sqrt(((b.vw * b.vw) + (b.vh * b.vh)) / 2.0);
            if axis == 'x' {
                base = b.vw;
            } else if axis == 'y' {
                base = b.vh;
            }
            return default * base;
        }
        return default;
    };
    if user {
        return b.length(v, axis, 16.0) catch default;
    }
    return number_or_percent(v) catch default;
}

fn fails_attr(r: ![]u8) bool {
    _ = r catch return true;
    return false;
}

fn if_else(c: bool, a: f64, b: f64) f64 {
    if c {
        return a;
    }
    return b;
}

fn rule_less(a: css.Rule, b: css.Rule) bool {
    if a.specificity != b.specificity {
        return a.specificity < b.specificity;
    }
    return a.order < b.order;
}

/// xlink:href, or SVG 2's href.
fn href_value(e: *xml.Element) SvgError![]u8 {
    let v = e.attr_ns(XLINK_NS, "href") catch {
        return e.attr("href");
    };
    return v;
}

fn is_svg(e: *xml.Element) bool {
    return (e.ns.len == 0) or strs.eq(e.ns, SVG_NS);
}
