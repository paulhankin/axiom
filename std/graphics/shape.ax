// =============================================================================
// std/graphics/shape.ax - text shaping: which glyphs a font draws for a piece of text,
// and where. OpenType GSUB substitutions (ligatures, contextual forms,
// Arabic joining forms, Indic conjuncts and reordering) and GPOS positioning
// (kerning, mark attachment, cursive attachment) apply as the font's
// features say, following HarfBuzz (the results match it glyph for glyph
// and unit for unit on the fonts std/graphics/shape's tests use).
//
//     let f = font.Font.load("DejaVuSans.ttf")!;
//     let gs = shape.shape(&f, "office", shape.options())!;   // "o", "ffi", "c", "e"
//     defer mem.free(gs);
//     for g in gs { ... g.id, g.x_advance, g.x_offset ... }   // font units
//
//     let mut o = shape.options();
//     let fs: [2]shape.Feature = [shape.feature("-liga")!, shape.feature("smcp")!];
//     o.features = fs[..];
//
// Text is UTF-8, one run of one script and direction (std/graphics/text splits
// paragraphs into such runs); the script is found from the text unless
// Options sets it, and the direction follows the script. Glyphs come in
// visual order (left to right, so reversed for right-to-left text), each
// with its cluster: the byte offset in the text of the first character it
// came from. Positions are in font units (scale by size / units_per_em).
// A Shaper remembers the work that depends only on the font and settings,
// for shaping many runs; draw_text and measure are for single lines.
//
// Shapers: the default one, Arabic (and Syriac), Hebrew, and Indic (Bengali,
// Devanagari, Gujarati, Gurmukhi, Kannada, Malayalam, Oriya, Tamil,
// Telugu, with fonts using the "dev2"-style tags or the older ones). Fonts
// without Arabic features get forms from Unicode's presentation forms, and
// fonts without mark positioning get marks placed by their combining
// classes, as HarfBuzz does. Scripts HarfBuzz gives to its Universal
// Shaping Engine, Khmer, Myanmar, Thai and Hangul shapers get the default
// one here, as do fonts with "dev3"-style tags. Not implemented: AAT tables
// (morx, kerx), font variations, vertical text, variation-selector cmaps.
// =============================================================================

import "../collections/vec.ax" as vec;
import "../mem.ax" as mem;
import "../unicode.ax" as uni;
import "draw.ax" as draw;
import "font.ax" as font;
import "internal/shape/arabic.ax" as arabic;
import "internal/shape/buffer.ax" as buf;
import "internal/shape/indic.ax" as indic;
import "internal/shape/layout.ax" as layout;
import "internal/shape/normalize.ax" as norm;
import "internal/shape/plan.ax" as plan;

pub error ShapeError { OutOfMemory, InvalidFeature, NotFound, InvalidPath, Corrupt, Empty, Done, Unsupported,
                       InvalidUtf8, IoError, EndOfStream }

/// The direction text is shaped in.
pub enum Direction: u8 {
    AUTO,  // the script's
    LTR,
    RTL,
}

/// Applies to all of the text.
pub const ALL: u32 = 0xffffffff;

/// A feature setting: tag = value for the characters whose byte offsets are
/// in [start, end).
pub struct Feature {
    tag: u32,
    value: u32,
    start: u32,
    end: u32,
}

pub struct Options {
    script: u32,           // ISO 15924 code (tag("Arab")); 0: from the text
    direction: Direction,  // AUTO: the script's
    language: u32,         // OpenType language system tag (tag("TRK ")); 0: the default
    features: []Feature,
}

pub fn options() Options {
    return Options.{
        script: 0,
        direction: Direction.AUTO,
        language: 0,
        features: @slice_from_ptr(@ptr_from_int(*Feature, 4), 0),
    };
}

/// A four-character tag ("liga", "Arab"), padded with spaces.
pub fn tag(s: []u8) u32 {
    return layout.tag_of(s);
}

pub struct Glyph {
    id: u32,
    cluster: u32,
    x_advance: i32,
    y_advance: i32,
    x_offset: i32,
    y_offset: i32,
}

/// Parses a feature setting as HarfBuzz writes them: "kern", "+kern",
/// "-liga", "liga=0", "aalt=2", "kern[3:5]", "smcp[2:]", "kern=1[3:5]".
pub fn feature(s: []u8) ShapeError!Feature {
    let mut f = Feature.{ tag: 0, value: 1, start: 0, end: ALL };
    let mut i: usize = 0;
    if (i < s.len) and ((s[i] == '+') or (s[i] == '-')) {
        if s[i] == '-' {
            f.value = 0;
        }
        i += 1;
    }
    let mut quote: u8 = 0;
    if (i < s.len) and ((s[i] == '"') or (s[i] == '\'')) {
        quote = s[i];
        i += 1;
    }
    let ts = i;
    while (i < s.len) and
          (((s[i] >= 'a') and (s[i] <= 'z')) or ((s[i] >= 'A') and (s[i] <= 'Z')) or
           ((s[i] >= '0') and (s[i] <= '9')) or (s[i] == ' ') or (s[i] == '_')) {
        if (quote == 0) and (s[i] == ' ') {
            break;
        }
        i += 1;
    }
    if ((i - ts) == 0) or ((i - ts) > 4) {
        return error.InvalidFeature;
    }
    f.tag = tag(s[ts..i]);
    if quote != 0 {
        if (i >= s.len) or (s[i] != quote) {
            return error.InvalidFeature;
        }
        i += 1;
    }
    if (i < s.len) and (s[i] == '[') {
        i += 1;
        let a = parse_uint(s, &mut i);
        if a >= 0 {
            f.start = @truncate(u32, @bit_cast(u64, a));
        }
        if (i < s.len) and (s[i] == ':') {
            i += 1;
            let e = parse_uint(s, &mut i);
            if e >= 0 {
                f.end = @truncate(u32, @bit_cast(u64, e));
            }
        } else if a >= 0 {
            f.end = f.start + 1;
        }
        if (i >= s.len) or (s[i] != ']') {
            return error.InvalidFeature;
        }
        i += 1;
    }
    if (i < s.len) and (s[i] == '=') {
        i += 1;
        let v = parse_uint(s, &mut i);
        if v < 0 {
            return error.InvalidFeature;
        }
        f.value = @truncate(u32, @bit_cast(u64, v));
    }
    if i != s.len {
        return error.InvalidFeature;
    }
    return f;
}

fn parse_uint(s: []u8, i: *mut usize) i64 {
    let mut v: i64 = -1;
    while (i.* < s.len) and (s[i.*] >= '0') and (s[i.*] <= '9') {
        if v < 0 {
            v = 0;
        }
        if v < 0x100000000 {
            v = (v * 10) + @as(i64, s[i.*] - '0');
        }
        i.* += 1;
    }
    return v;
}

/// The script of text: that of its first character with a script of its
/// own (not common or inherited), or 0.
pub fn detect_script(text: []u8) u32 {
    let mut i: usize = 0;
    while i < text.len {
        let r = decode(text, i);
        i += @as(usize, r[1]);
        let s = plan.script_of(r[0]);
        if (s != tag("Zyyy")) and (s != tag("Zinh")) and (s != tag("Zzzz")) {
            return s;
        }
    }
    return 0;
}

/// The ISO 15924 script code of a character (tag("Zyyy") for common
/// characters, tag("Zinh") for inherited ones such as combining marks).
pub fn script_of(cp: u32) u32 {
    return plan.script_of(cp);
}

/// Whether a script is written right to left.
pub fn is_rtl(script: u32) bool {
    return plan.script_is_rtl(script);
}

/// [code point, length]; invalid bytes decode as U+FFFD, one at a time.
fn decode(s: []u8, i: usize) [2]u32 {
    let b0 = @as(u32, s[i]);
    if b0 < 0x80 {
        return [b0, 1];
    }
    let mut n: usize = 0;
    let mut cp: u32 = 0;
    let mut min: u32 = 0;
    if (b0 & 0xe0) == 0xc0 {
        n = 1;
        cp = b0 & 0x1f;
        min = 0x80;
    } else if (b0 & 0xf0) == 0xe0 {
        n = 2;
        cp = b0 & 0x0f;
        min = 0x800;
    } else if (b0 & 0xf8) == 0xf0 {
        n = 3;
        cp = b0 & 0x07;
        min = 0x10000;
    } else {
        return [0xfffd, 1];
    }
    if (i + n) >= s.len {
        return [0xfffd, 1];
    }
    for k in @as(usize, 1)..(n + 1) {
        let c = @as(u32, s[i + k]);
        if (c & 0xc0) != 0x80 {
            return [0xfffd, 1];
        }
        cp = (cp << 6) | (c & 0x3f);
    }
    if (cp < min) or (cp > 0x10ffff) or ((cp >= 0xd800) and (cp <= 0xdfff)) {
        return [0xfffd, 1];
    }
    return [cp, @truncate(u32, n + 1)];
}

// -----------------------------------------------------------------------------
// Planning
// -----------------------------------------------------------------------------

fn add(mb: *mut layout.MapBuilder, t: []u8, flags: u32, value: u32) ShapeError!void {
    mb.add_feature(tag(t), flags, value)!;
}

fn enable(mb: *mut layout.MapBuilder, t: []u8, flags: u32) ShapeError!void {
    mb.add_feature(tag(t), flags | layout.F_GLOBAL, 1)!;
}

fn collect_features(mb: *mut layout.MapBuilder, p: *plan.Plan, feats: []Feature) ShapeError!void {
    enable(mb, "rvrn", 0)!;
    mb.add_gsub_pause(plan.PAUSE_NONE)!;
    if not p.rtl {
        enable(mb, "ltra", 0)!;
        enable(mb, "ltrm", 0)!;
    } else {
        enable(mb, "rtla", 0)!;
        add(mb, "rtlm", 0, 1)!;
    }
    add(mb, "frac", 0, 1)!;
    add(mb, "numr", 0, 1)!;
    add(mb, "dnom", 0, 1)!;
    mb.add_feature(tag("rand"), layout.F_GLOBAL | layout.F_RANDOM, 255)!;
    enable(mb, "Harf", 0)!;
    enable(mb, "HARF", 0)!;
    if p.shaper == plan.SHAPER_ARABIC {
        enable(mb, "stch", 0)!;
        mb.add_gsub_pause(plan.PAUSE_ARABIC_STCH)!;
        enable(mb, "ccmp", layout.F_MANUAL_ZWJ)!;
        enable(mb, "locl", layout.F_MANUAL_ZWJ)!;
        mb.add_gsub_pause(plan.PAUSE_NONE)!;
        for f in arabic.FEATURES {
            let syriac = (f[3] == '2') or (f[3] == '3');
            let mut flags = layout.F_MANUAL_ZWJ;
            if (p.script == tag("Arab")) and not syriac {
                flags |= layout.F_HAS_FALLBACK;
            }
            add(mb, f, flags, 1)!;
            mb.add_gsub_pause(plan.PAUSE_NONE)!;
        }
        mb.add_gsub_pause(plan.PAUSE_NONE)!;
        enable(mb, "rlig", layout.F_MANUAL_ZWJ | layout.F_HAS_FALLBACK)!;
        if p.script == tag("Arab") {
            mb.add_gsub_pause(plan.PAUSE_ARABIC_FALLBACK)!;
        }
        enable(mb, "calt", layout.F_MANUAL_ZWJ)!;
        if not mb.has_feature(tag("rclt")) {
            mb.add_gsub_pause(plan.PAUSE_NONE)!;
        }
        enable(mb, "liga", layout.F_MANUAL_ZWJ)!;
        enable(mb, "clig", layout.F_MANUAL_ZWJ)!;
        enable(mb, "mset", layout.F_MANUAL_ZWJ)!;
    } else if p.shaper == plan.SHAPER_INDIC {
        mb.add_gsub_pause(plan.PAUSE_INDIC_SYLLABLES)!;
        enable(mb, "locl", layout.F_PER_SYLLABLE)!;
        enable(mb, "ccmp", layout.F_PER_SYLLABLE)!;
        mb.add_gsub_pause(plan.PAUSE_INDIC_INITIAL)!;
        for i in @as(usize, 0)..plan.INDIC_NUM_FEATURES {
            let mut flags = layout.F_MANUAL_JOINERS | layout.F_PER_SYLLABLE;
            if indic.FEATURE_GLOBAL[i] {
                flags |= layout.F_GLOBAL;
            }
            add(mb, indic.FEATURE_TAGS[i], flags, 1)!;
            if i < plan.INDIC_BASIC_FEATURES {
                mb.add_gsub_pause(plan.PAUSE_NONE)!;
            }
            if i == (plan.INDIC_BASIC_FEATURES - 1) {
                mb.add_gsub_pause(plan.PAUSE_INDIC_FINAL)!;
            }
        }
    }
    enable(mb, "Buzz", 0)!;
    enable(mb, "BUZZ", 0)!;
    enable(mb, "abvm", 0)!;
    enable(mb, "blwm", 0)!;
    enable(mb, "ccmp", 0)!;
    enable(mb, "locl", 0)!;
    enable(mb, "mark", layout.F_MANUAL_JOINERS)!;
    enable(mb, "mkmk", layout.F_MANUAL_JOINERS)!;
    enable(mb, "rlig", 0)!;
    enable(mb, "calt", 0)!;
    enable(mb, "clig", 0)!;
    enable(mb, "curs", 0)!;
    enable(mb, "dist", 0)!;
    enable(mb, "kern", layout.F_HAS_FALLBACK)!;
    enable(mb, "liga", 0)!;
    enable(mb, "rclt", 0)!;
    for f in feats {
        let mut flags: u32 = 0;
        if (f.start == 0) and (f.end == ALL) {
            flags = layout.F_GLOBAL;
        }
        mb.add_feature(f.tag, flags, f.value)!;
    }
    if p.shaper == plan.SHAPER_INDIC {
        add(mb, "liga", layout.F_GLOBAL, 0)!;
        mb.add_gsub_pause(plan.PAUSE_NONE)!;
    }
}

/// The kern table's kind of subtables: [has any, has non-format-0
/// (state machine), has cross-stream].
fn kern_info(d: []u8, k: usize) [3]bool {
    if (k == 0) or (layout.u16at(d, k) != 0) {
        return [false, false, false];
    }
    let n = @as(usize, layout.u16at(d, k + 2));
    let mut machine = false;
    let mut cross = false;
    let mut o = k + 4;
    for _i in @as(usize, 0)..n {
        let len = @as(usize, layout.u16at(d, o + 2));
        let cov = layout.u16at(d, o + 4);
        if (cov >> 8) != 0 {
            machine = true;
        }
        if (cov & 0x04) != 0 {
            cross = true;
        }
        if len < 6 {
            break;
        }
        o += len;
    }
    return [n > 0, machine, cross];
}

fn make_plan(f: *font.Font, script: u32, rtl: bool, language: u32, feats: []Feature) ShapeError!plan.Plan {
    let mut p = plan.Plan.{
        f: f,
        face: layout.face_init(f.data, f.table_offset("GDEF"), f.table_offset("GSUB"), f.table_offset("GPOS")),
        map: layout.empty_map(),
        script: script,
        rtl: rtl,
        shaper: plan.SHAPER_DEFAULT,
        zwm: plan.ZWM_LATE,
        norm: plan.NM_COMPOSED,
        frac_mask: 0,
        numr_mask: 0,
        dnom_mask: 0,
        has_frac: false,
        rtlm_mask: 0,
        kern_mask: 0,
        apply_gpos: false,
        apply_kern: false,
        zero_marks: false,
        has_gpos_mark: false,
        adjust_mark_positioning_when_zeroing: false,
        fallback_mark_positioning: false,
        fallback_glyph_classes: false,
        kern: f.table_offset("kern"),
        arabic_mask: [0; 8],
        arabic_do_fallback: false,
        arabic_has_stch: false,
        indic: plan.indic_config(script),
        indic_old_spec: false,
        indic_mask: [0; 17],
        indic_zero_context: false,
        virama_glyph: -1,
        would: [[0, 0]; 5],
    };
    let mut tags: [3]u32 = [0, 0, 0];
    let nt = plan.script_tags(script, &mut tags);
    let mut mb = layout.MapBuilder.init(&p.face, tags[..nt], language);
    p.shaper = plan.shaper_for(script, mb.chosen_script[0]);
    let mut fallback_position = true;
    let mut gpos_tag: u32 = 0;
    if p.shaper == plan.SHAPER_INDIC {
        p.zwm = plan.ZWM_NONE;
        p.norm = plan.NM_COMPOSED_NO_SHORT_CIRCUIT;
        fallback_position = false;
    } else if p.shaper == plan.SHAPER_HEBREW {
        gpos_tag = tag("hebr");
    }
    collect_features(&mut mb, &p, feats) catch |e| {
        mb.deinit();
        return e;
    };
    p.map = mb.compile() catch |e| {
        mb.deinit();
        return e;
    };
    mb.deinit();
    let m = &p.map;
    p.frac_mask = m.get_1_mask(tag("frac"));
    p.numr_mask = m.get_1_mask(tag("numr"));
    p.dnom_mask = m.get_1_mask(tag("dnom"));
    p.has_frac = (p.frac_mask != 0) or ((p.numr_mask != 0) and (p.dnom_mask != 0));
    p.rtlm_mask = m.get_1_mask(tag("rtlm"));
    p.kern_mask = m.get_mask(tag("kern"));
    let has_gpos_kern = m.feature_index(1, tag("kern")) != layout.NO_INDEX;
    let disable_gpos = (gpos_tag != 0) and (gpos_tag != m.chosen_script[1]);
    p.fallback_glyph_classes = not layout.has_glyph_classes(&p.face);
    let has_gpos = not disable_gpos and (p.face.gpos != 0) and (layout.u32at(f.data, p.face.gpos) != 0);
    p.apply_gpos = has_gpos;
    let ki = kern_info(f.data, p.kern);
    if not has_gpos_kern or not p.apply_gpos {
        if ki[0] {
            p.apply_kern = fallback_position;
        }
    }
    p.zero_marks = (p.zwm != plan.ZWM_NONE) and (not p.apply_kern or not ki[1]);
    p.has_gpos_mark = m.get_1_mask(tag("mark")) != 0;
    p.adjust_mark_positioning_when_zeroing = not p.apply_gpos and (not p.apply_kern or not ki[2]);
    p.fallback_mark_positioning = p.adjust_mark_positioning_when_zeroing and fallback_position;
    if p.shaper == plan.SHAPER_ARABIC {
        p.arabic_do_fallback = script == tag("Arab");
        p.arabic_has_stch = m.get_1_mask(tag("stch")) != 0;
        for i in @as(usize, 0)..7 {
            let ft = tag(arabic.FEATURES[i]);
            p.arabic_mask[i] = m.get_1_mask(ft);
            let syriac = (arabic.FEATURES[i][3] == '2') or (arabic.FEATURES[i][3] == '3');
            p.arabic_do_fallback = p.arabic_do_fallback and (syriac or m.needs_fallback(ft));
        }
    }
    if p.shaper == plan.SHAPER_INDIC {
        p.indic_old_spec = p.indic.has_old_spec and ((m.chosen_script[0] & 0xff) != 0x32);
        p.indic_zero_context = not p.indic_old_spec and (script != tag("Mlym"));
        let wt: [5][]u8 = ["rphf", "pref", "blwf", "pstf", "vatu"];
        for i in @as(usize, 0)..5 {
            p.would[i] = m.stage_lookups(0, m.feature_stage(0, tag(wt[i])));
        }
        for i in @as(usize, 0)..plan.INDIC_NUM_FEATURES {
            if not indic.FEATURE_GLOBAL[i] {
                p.indic_mask[i] = m.get_1_mask(tag(indic.FEATURE_TAGS[i]));
            }
        }
    }
    return p;
}

// -----------------------------------------------------------------------------
// Shaping
// -----------------------------------------------------------------------------

fn is_regional_indicator(u: u32) bool {
    return (u >= 0x1f1e6) and (u <= 0x1f1ff);
}

fn set_unicode_props_all(b: *mut buf.Buffer, global_mask: u32) void {
    let count = b.len;
    let mut i: usize = 0;
    while i < count {
        b.info[i].mask = global_mask;
        plan.set_unicode_props(b, &mut b.info[i]);
        let u = b.info[i].cp;
        if u < 0x80 {
            i += 1;
            continue;
        }
        let gc = layout.gen_cat(&b.info[i]);
        if (gc == plan.GC_LL) or (gc == plan.GC_LU) or (gc == plan.GC_LT) or (gc == plan.GC_LO) or (gc == plan.GC_ZS) {
            i += 1;
            continue;
        }
        if (gc == plan.GC_SK) and (u >= 0x1f3fb) and (u <= 0x1f3ff) {
            plan.set_continuation(b, &mut b.info[i]);
        } else if (i > 0) and is_regional_indicator(u) {
            if is_regional_indicator(b.info[i - 1].cp) and ((b.info[i - 1].uprops & buf.UP_CONTINUATION) == 0) {
                plan.set_continuation(b, &mut b.info[i]);
            }
        } else if layout.is_zwj(&b.info[i]) {
            plan.set_continuation(b, &mut b.info[i]);
            if ((i + 1) < count) and uni.is_extended_pictographic(b.info[i + 1].cp) {
                i += 1;
                b.info[i].mask = global_mask;
                plan.set_unicode_props(b, &mut b.info[i]);
                plan.set_continuation(b, &mut b.info[i]);
            }
        } else if ((u >= 0xff9e) and (u <= 0xff9f)) or ((u >= 0xe0020) and (u <= 0xe007f)) {
            plan.set_continuation(b, &mut b.info[i]);
        } else if u == 0x2044 {
            b.scratch |= buf.SF_HAS_FRACTION_SLASH;
        }
        i += 1;
    }
}

fn insert_dotted_circle(p: *plan.Plan, b: *mut buf.Buffer) void {
    if (b.len == 0) or not layout.is_unicode_mark(&b.info[0]) {
        return;
    }
    if p.glyph(0x25cc) == 0 {
        return;
    }
    let mut dc = buf.zero_info();
    dc.cp = 0x25cc;
    plan.set_unicode_props(b, &mut dc);
    b.clear_output();
    b.idx = 0;
    dc.cluster = b.info[0].cluster;
    dc.mask = b.info[0].mask;
    _ = b.output_info(dc);
    _ = b.sync();
}

fn form_clusters(b: *mut buf.Buffer) void {
    if (b.scratch & buf.SF_HAS_CONTINUATIONS) == 0 {
        return;
    }
    let mut start: usize = 0;
    while start < b.len {
        let mut end = start + 1;
        while (end < b.len) and ((b.info[end].uprops & buf.UP_CONTINUATION) != 0) {
            end += 1;
        }
        b.merge_clusters(start, end);
        start = end;
    }
}

fn ensure_native_direction(p: *mut plan.Plan, b: *mut buf.Buffer) void {
    let mut native_rtl = plan.script_is_rtl(p.script);
    if native_rtl and not b.rtl {
        let mut found_number = false;
        let mut found_letter = false;
        let mut found_ri = false;
        for i in @as(usize, 0)..b.len {
            let gc = layout.gen_cat(&b.info[i]);
            if (gc >= plan.GC_LU) and (gc <= plan.GC_LO) {
                found_letter = true;
                break;
            } else if gc == plan.GC_ND {
                found_number = true;
            } else if is_regional_indicator(b.info[i].cp) {
                found_ri = true;
            }
        }
        if (found_number or found_ri) and not found_letter {
            native_rtl = false;
        }
    }
    let valid = not ((p.script == tag("Hung")) or (p.script == tag("Ital")) or (p.script == tag("Runr")) or
                     (p.script == tag("Tfng")));
    if valid and (b.rtl != native_rtl) {
        b.reverse_graphemes();
        b.rtl = not b.rtl;
    }
}

fn rotate_chars(p: *plan.Plan, b: *mut buf.Buffer, target_rtl: bool) void {
    if not target_rtl {
        return;
    }
    for i in @as(usize, 0)..b.len {
        let u = b.info[i].cp;
        let m = uni.mirror(u);
        if (m != u) and (p.glyph(m) != 0) {
            b.info[i].cp = m;
        } else {
            b.info[i].mask |= p.rtlm_mask;
        }
    }
}

fn setup_masks_fraction(p: *plan.Plan, b: *mut buf.Buffer) void {
    if ((b.scratch & buf.SF_HAS_FRACTION_SLASH) == 0) or not p.has_frac {
        return;
    }
    let mut pre = p.numr_mask | p.frac_mask;
    let mut post = p.frac_mask | p.dnom_mask;
    if b.rtl {
        pre = p.frac_mask | p.dnom_mask;
        post = p.numr_mask | p.frac_mask;
    }
    let count = b.len;
    let mut i: usize = 0;
    while i < count {
        if b.info[i].cp == 0x2044 {
            let mut start = i;
            let mut end = i + 1;
            while (start > 0) and (layout.gen_cat(&b.info[start - 1]) == plan.GC_ND) {
                start -= 1;
            }
            while (end < count) and (layout.gen_cat(&b.info[end]) == plan.GC_ND) {
                end += 1;
            }
            if (start == i) or (end == (i + 1)) {
                i += 1;
                continue;
            }
            for j in start..i {
                b.info[j].mask |= pre;
            }
            b.info[i].mask |= p.frac_mask;
            for j in (i + 1)..end {
                b.info[j].mask |= post;
            }
            i = end;
            continue;
        }
        i += 1;
    }
}

fn setup_masks(p: *plan.Plan, b: *mut buf.Buffer, feats: []Feature) void {
    setup_masks_fraction(p, b);
    if p.shaper == plan.SHAPER_ARABIC {
        arabic.setup_masks(p, b);
    } else if p.shaper == plan.SHAPER_INDIC {
        indic.setup_masks(b);
    }
    for f in feats {
        if not ((f.start == 0) and (f.end == ALL)) {
            let mask = p.map.get_mask(f.tag);
            let shift = p.map.get_shift(f.tag);
            b.set_masks(f.value << shift, mask, f.start, f.end);
        }
    }
}

fn synthesize_glyph_classes(b: *mut buf.Buffer) void {
    for i in @as(usize, 0)..b.len {
        let inf = &mut b.info[i];
        if (layout.gen_cat(inf) != plan.GC_MN) or layout.is_default_ignorable(inf) {
            inf.gprops = buf.GP_BASE_GLYPH;
        } else {
            inf.gprops = buf.GP_MARK;
        }
    }
}

fn run_pause(p: *mut plan.Plan, b: *mut buf.Buffer, pause: u8) void {
    if pause == plan.PAUSE_ARABIC_STCH {
        arabic.record_stch(p, b);
    } else if pause == plan.PAUSE_ARABIC_FALLBACK {
        arabic.fallback_shape(p, b);
    } else if pause == plan.PAUSE_INDIC_SYLLABLES {
        indic.find_syllables(b);
    } else if pause == plan.PAUSE_INDIC_INITIAL {
        indic.initial_reordering(p, b);
    } else if pause == plan.PAUSE_INDIC_FINAL {
        indic.final_reordering(p, b);
    }
}

/// Applies the map's GSUB (table 0) or GPOS (1) lookups, stage by stage.
fn apply_map(p: *mut plan.Plan, b: *mut buf.Buffer, table: usize) void {
    let mut c = layout.ctx_init(&p.face, b, table);
    let lookups = p.map.lookups[table].items();
    let stages = p.map.stages[table].items();
    let mut i: usize = 0;
    for st in stages {
        while i < st.last_lookup {
            let l = lookups[i];
            layout.set_lookup(&mut c, l.mask, l.auto_zwnj, l.auto_zwj, l.random, l.per_syllable);
            layout.apply_string(&mut c, l.index, &l.digest);
            i += 1;
        }
        if st.pause != plan.PAUSE_NONE {
            run_pause(p, b, st.pause);
        }
    }
}

fn zero_mark_widths_by_gdef(b: *mut buf.Buffer, adjust_offsets: bool) void {
    for i in @as(usize, 0)..b.len {
        if layout.is_mark(&b.info[i]) {
            if adjust_offsets {
                b.pos[i].xo = buf.sat_sub(b.pos[i].xo, b.pos[i].xa);
                b.pos[i].yo = buf.sat_sub(b.pos[i].yo, b.pos[i].ya);
            }
            b.pos[i].xa = 0;
            b.pos[i].ya = 0;
        }
    }
}

fn fallback_spaces(p: *plan.Plan, b: *mut buf.Buffer) void {
    let upem = @bit_cast(i32, p.f.units_per_em);
    for i in @as(usize, 0)..b.len {
        let inf = &b.info[i];
        if (layout.gen_cat(inf) != plan.GC_ZS) or layout.ligated(inf) {
            continue;
        }
        let st = @as(u32, inf.uprops >> 8);
        if (st >= plan.SPACE_EM) and (st <= plan.SPACE_EM_16) {
            let n = @bit_cast(i32, st);
            b.pos[i].xa = (upem + (n / 2)) / n;
        } else if st == plan.SPACE_4_EM_18 {
            b.pos[i].xa = @truncate(i32, (@as(i64, upem) * 4) / 18);
        } else if st == plan.SPACE_FIGURE {
            for u in @as(u32, '0')..(@as(u32, '9') + 1) {
                let g = p.glyph(u);
                if g != 0 {
                    b.pos[i].xa = p.f.advance(g);
                    break;
                }
            }
        } else if st == plan.SPACE_PUNCTUATION {
            let mut g = p.glyph(0x2e);
            if g == 0 {
                g = p.glyph(0x2c);
            }
            if g != 0 {
                b.pos[i].xa = p.f.advance(g);
            }
        } else if st == plan.SPACE_NARROW {
            b.pos[i].xa = b.pos[i].xa / 2;
        }
    }
}

/// Kerning from the kern table (format 0 pairs), as HarfBuzz applies it
/// when GPOS has none.
fn kern_table(p: *plan.Plan, b: *mut buf.Buffer) void {
    let d = p.f.data;
    let k = p.kern;
    let n = @as(usize, layout.u16at(d, k + 2));
    let mut o = k + 4;
    for _s in @as(usize, 0)..n {
        let len = @as(usize, layout.u16at(d, o + 2));
        let cov = layout.u16at(d, o + 4);
        if ((cov >> 8) == 0) and ((cov & 0x01) != 0) and ((cov & 0x04) == 0) {
            kern_subtable(p, b, o + 6);
        }
        if len < 6 {
            break;
        }
        o += len;
    }
}

fn kern_pair(d: []u8, st: usize, l: u32, r: u32) i32 {
    let n = @as(usize, layout.u16at(d, st));
    let key = (l << 16) | r;
    let mut lo: usize = 0;
    let mut hi = n;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let e = st + 8 + (6 * mid);
        let v = layout.u32at(d, e);
        if v < key {
            lo = mid + 1;
        } else if v > key {
            hi = mid;
        } else {
            return layout.i16at(d, e + 4);
        }
    }
    return 0;
}

fn kern_subtable(p: *plan.Plan, b: *mut buf.Buffer, st: usize) void {
    let d = p.f.data;
    let mut c = layout.ctx_init(&p.face, b, 1);
    layout.prepare(&mut c, p.kern_mask, 0x08);
    let mut idx: usize = 0;
    while idx < b.len {
        if (b.info[idx].mask & p.kern_mask) == 0 {
            idx += 1;
            continue;
        }
        let r = layout.next_unskipped(&mut c, idx);
        if r[0] == 0 {
            idx = r[1];
            continue;
        }
        let j = r[1];
        let kern = kern_pair(d, st, b.info[idx].cp, b.info[j].cp);
        if kern != 0 {
            let k1 = kern >> 1;
            let k2 = kern - k1;
            b.pos[idx].xa = buf.sat_add(b.pos[idx].xa, k1);
            b.pos[j].xa = buf.sat_add(b.pos[j].xa, k2);
            b.pos[j].xo = buf.sat_add(b.pos[j].xo, k2);
        }
        idx = j;
    }
}

// -----------------------------------------------------------------------------
// Fallback mark positioning, for fonts without GPOS for the script: marks
// go above or below their base by their combining classes and the glyphs'
// boxes (HarfBuzz's hb-ot-shape-fallback)
// -----------------------------------------------------------------------------

const CC_ATTACHED_BELOW_LEFT: u32 = 200;
const CC_ATTACHED_BELOW: u32 = 202;
const CC_ATTACHED_ABOVE: u32 = 214;
const CC_ATTACHED_ABOVE_RIGHT: u32 = 216;
const CC_BELOW_LEFT: u32 = 218;
const CC_BELOW: u32 = 220;
const CC_BELOW_RIGHT: u32 = 222;
const CC_ABOVE_LEFT: u32 = 228;
const CC_ABOVE: u32 = 230;
const CC_ABOVE_RIGHT: u32 = 232;
const CC_DOUBLE_BELOW: u32 = 233;
const CC_DOUBLE_ABOVE: u32 = 234;

fn recategorize_combining_class(u: u32, klass0: u32) u32 {
    let mut klass = klass0;
    if klass >= 200 {
        return klass;
    }
    if (u & ~@as(u32, 0xff)) == 0x0e00 {
        if klass == 0 {
            if (u == 0x0e31) or (u == 0x0e34) or (u == 0x0e35) or (u == 0x0e36) or (u == 0x0e37) or (u == 0x0e47) or
               (u == 0x0e4c) or (u == 0x0e4d) or (u == 0x0e4e) {
                klass = CC_ABOVE_RIGHT;
            } else if (u == 0x0eb1) or (u == 0x0eb4) or (u == 0x0eb5) or (u == 0x0eb6) or (u == 0x0eb7) or
                      (u == 0x0ebb) or (u == 0x0ecc) or (u == 0x0ecd) {
                klass = CC_ABOVE;
            } else if u == 0x0ebc {
                klass = CC_BELOW;
            }
        } else if u == 0x0e3a {
            klass = CC_BELOW_RIGHT;
        }
    }
    // (the classes are HarfBuzz's modified ones)
    if (klass == 22) or (klass == 15) or (klass == 16) or (klass == 17) or (klass == 23) or (klass == 18) or
       (klass == 19) or (klass == 20) or (klass == 21) or (klass == 24) or (klass == 25) {
        return CC_BELOW;
    }
    if klass == 13 {
        return CC_ATTACHED_ABOVE;
    }
    if klass == 10 {
        return CC_ABOVE_RIGHT;
    }
    if (klass == 11) or (klass == 14) {
        return CC_ABOVE_LEFT;
    }
    if klass == 26 {
        return CC_ABOVE;
    }
    if (klass == 28) or (klass == 29) or (klass == 31) or (klass == 32) or (klass == 27) or (klass == 34) or
       (klass == 35) or (klass == 36) {
        return CC_ABOVE;
    }
    if (klass == 30) or (klass == 33) {
        return CC_BELOW;
    }
    if klass == 3 {
        return CC_BELOW_RIGHT;
    }
    if klass == 107 {
        return CC_ABOVE_RIGHT;
    }
    if klass == 118 {
        return CC_BELOW;
    }
    if klass == 122 {
        return CC_ABOVE;
    }
    if klass == 129 {
        return CC_BELOW;
    }
    if klass == 132 {
        return CC_ABOVE;
    }
    if klass == 131 {
        return CC_BELOW;
    }
    return klass;
}

fn recategorize_marks(b: *mut buf.Buffer) void {
    for i in @as(usize, 0)..b.len {
        let inf = &mut b.info[i];
        if layout.gen_cat(inf) == plan.GC_MN {
            layout.set_modified_cc(inf, recategorize_combining_class(inf.cp, layout.modified_cc(inf)));
        }
    }
}

fn clamp32(x: i64) i32 {
    if x > 0x7fffffff {
        return 0x7fffffff;
    }
    if x < -0x80000000 {
        return -0x7fffffff - 1;
    }
    return @truncate(i32, x);
}

/// Extents: [x_bearing, y_bearing, width, height].
fn position_mark(p: *plan.Plan, b: *mut buf.Buffer, base: *mut [4]i32, i: usize, cc: u32) void {
    let me = p.f.glyph_extents(b.info[i].cp) catch {
        return;
    };
    let y_gap = @bit_cast(i32, p.f.units_per_em) / 16;
    let pos = &mut b.pos[i];
    pos.xo = 0;
    pos.yo = 0;
    let bx = @as(i64, base[0]);
    let bw = @as(i64, base[2]);
    let mx = @as(i64, me[0]);
    let mw = @as(i64, me[2]);
    let mut done = false;
    if (cc == CC_DOUBLE_BELOW) or (cc == CC_DOUBLE_ABOVE) {
        if not b.rtl {
            pos.xo = clamp32(((bx + bw) - (mw / 2)) - mx);
        } else {
            pos.xo = clamp32((bx - (mw / 2)) - mx);
        }
        done = true;
    }
    if not done {
        if (cc == CC_ATTACHED_BELOW_LEFT) or (cc == CC_BELOW_LEFT) or (cc == CC_ABOVE_LEFT) {
            pos.xo = buf.sat_sub(base[0], me[0]);
        } else if (cc == CC_ATTACHED_ABOVE_RIGHT) or (cc == CC_BELOW_RIGHT) or (cc == CC_ABOVE_RIGHT) {
            pos.xo = clamp32(((bx + bw) - mw) - mx);
        } else {
            pos.xo = clamp32((bx + ((bw - mw) / 2)) - mx);
        }
    }
    let below = (cc == CC_DOUBLE_BELOW) or (cc == CC_BELOW_LEFT) or (cc == CC_BELOW) or (cc == CC_BELOW_RIGHT);
    let above = (cc == CC_DOUBLE_ABOVE) or (cc == CC_ABOVE_LEFT) or (cc == CC_ABOVE) or (cc == CC_ABOVE_RIGHT);
    if below or (cc == CC_ATTACHED_BELOW_LEFT) or (cc == CC_ATTACHED_BELOW) {
        if below {
            base[3] = buf.sat_sub(base[3], y_gap);
        }
        pos.yo = clamp32((@as(i64, base[1]) + @as(i64, base[3])) - @as(i64, me[1]));
        if (y_gap > 0) == (pos.yo > 0) {
            base[3] = buf.sat_sub(base[3], pos.yo);
            pos.yo = 0;
        }
        base[3] = buf.sat_add(base[3], me[3]);
    } else if above or (cc == CC_ATTACHED_ABOVE) or (cc == CC_ATTACHED_ABOVE_RIGHT) {
        if above {
            base[1] = buf.sat_add(base[1], y_gap);
            base[3] = buf.sat_sub(base[3], y_gap);
        }
        pos.yo = clamp32((@as(i64, base[1]) - @as(i64, me[1])) - @as(i64, me[3]));
        if (y_gap > 0) != (pos.yo > 0) {
            let correction = -(pos.yo / 2);
            base[1] = buf.sat_add(base[1], correction);
            base[3] = buf.sat_sub(base[3], correction);
            pos.yo = buf.sat_add(pos.yo, correction);
        }
        base[1] = buf.sat_sub(base[1], me[3]);
        base[3] = buf.sat_add(base[3], me[3]);
    }
}

fn zero_mark_advances(b: *mut buf.Buffer, start: usize, end: usize, adjust: bool) void {
    for i in start..end {
        if layout.gen_cat(&b.info[i]) == plan.GC_MN {
            if adjust {
                b.pos[i].xo = buf.sat_sub(b.pos[i].xo, b.pos[i].xa);
                b.pos[i].yo = buf.sat_sub(b.pos[i].yo, b.pos[i].ya);
            }
            b.pos[i].xa = 0;
            b.pos[i].ya = 0;
        }
    }
}

fn position_around_base(p: *plan.Plan, b: *mut buf.Buffer, base: usize, end: usize, adjust: bool) void {
    let mut be = p.f.glyph_extents(b.info[base].cp) catch {
        zero_mark_advances(b, base + 1, end, adjust);
        return;
    };
    be[1] = buf.sat_add(be[1], b.pos[base].yo);
    be[0] = 0;
    be[2] = p.f.advance(b.info[base].cp);
    let lig_id = layout.lig_id(&b.info[base]);
    let num_lig_components = @bit_cast(i32, layout.lig_num_comps(&b.info[base]));
    let mut x_offset: i32 = 0;
    let mut y_offset: i32 = 0;
    if not b.rtl {
        x_offset = -@max(b.pos[base].xa, -0x7fffffff);
        y_offset = -@max(b.pos[base].ya, -0x7fffffff);
    }
    let mut component = be;
    let mut last_lig_component: i32 = -1;
    let mut last_cc: u32 = 255;
    let mut cluster = be;
    for i in (base + 1)..end {
        let mcc = layout.modified_cc(&b.info[i]);
        if mcc != 0 {
            if num_lig_components > 1 {
                let this_lig_id = layout.lig_id(&b.info[i]);
                let mut this_comp = @bit_cast(i32, layout.lig_comp(&b.info[i])) - 1;
                if (lig_id == 0) or (lig_id != this_lig_id) or (this_comp >= num_lig_components) {
                    this_comp = num_lig_components - 1;
                }
                if last_lig_component != this_comp {
                    last_lig_component = this_comp;
                    last_cc = 255;
                    component = be;
                    let w = @as(i64, component[2]);
                    let n = @as(i64, num_lig_components);
                    if not p.rtl {
                        component[0] = clamp32(@as(i64, component[0]) + ((@as(i64, this_comp) * w) / n));
                    } else {
                        component[0] = clamp32(
                            @as(i64, component[0]) + ((@as(i64, (num_lig_components - 1) - this_comp) * w) / n));
                    }
                    component[2] = component[2] / num_lig_components;
                }
            }
            if last_cc != mcc {
                last_cc = mcc;
                cluster = component;
            }
            position_mark(p, b, &mut cluster, i, mcc);
            b.pos[i].xa = 0;
            b.pos[i].ya = 0;
            b.pos[i].xo = buf.sat_add(b.pos[i].xo, x_offset);
            b.pos[i].yo = buf.sat_add(b.pos[i].yo, y_offset);
        } else {
            if not b.rtl {
                x_offset = buf.sat_sub(x_offset, b.pos[i].xa);
                y_offset = buf.sat_sub(y_offset, b.pos[i].ya);
            } else {
                x_offset = buf.sat_add(x_offset, b.pos[i].xa);
                y_offset = buf.sat_add(y_offset, b.pos[i].ya);
            }
        }
    }
}

fn position_cluster(p: *plan.Plan, b: *mut buf.Buffer, start: usize, end: usize, adjust: bool) void {
    if (end - start) < 2 {
        return;
    }
    let mut i = start;
    while i < end {
        if not layout.is_unicode_mark(&b.info[i]) {
            let mut j = i + 1;
            while j < end {
                if layout.is_hidden(&b.info[j]) or layout.is_default_ignorable(&b.info[j]) {
                    j += 1;
                    continue;
                }
                if not layout.is_unicode_mark(&b.info[j]) {
                    break;
                }
                j += 1;
            }
            position_around_base(p, b, i, j, adjust);
            i = j;
            continue;
        }
        i += 1;
    }
}

fn fallback_mark_position(p: *plan.Plan, b: *mut buf.Buffer, adjust: bool) void {
    let mut start: usize = 0;
    for i in @as(usize, 1)..b.len {
        let inf = &b.info[i];
        if not layout.is_unicode_mark(inf) and not layout.is_hidden(inf) and not layout.is_default_ignorable(inf) {
            position_cluster(p, b, start, i, adjust);
            start = i;
        }
    }
    position_cluster(p, b, start, b.len, adjust);
}

fn is_ignorable_drop(_c: u8, i: *buf.Info) bool {
    return layout.is_default_ignorable(i);
}

fn position(p: *mut plan.Plan, b: *mut buf.Buffer) void {
    b.clear_positions();
    for i in @as(usize, 0)..b.len {
        b.pos[i].xa = p.f.advance(b.info[i].cp);
    }
    if (b.scratch & buf.SF_HAS_SPACE_FALLBACK) != 0 {
        fallback_spaces(p, b);
    }
    let adjust = p.adjust_mark_positioning_when_zeroing and not b.rtl;
    layout.position_start(b);
    if p.zero_marks and (p.zwm == plan.ZWM_EARLY) {
        zero_mark_widths_by_gdef(b, adjust);
    }
    if p.apply_gpos {
        apply_map(p, b, 1);
    }
    if p.apply_kern {
        kern_table(p, b);
    }
    if p.zero_marks and (p.zwm == plan.ZWM_LATE) {
        zero_mark_widths_by_gdef(b, adjust);
    }
    // default ignorables take no space
    if (b.scratch & buf.SF_HAS_DEFAULT_IGNORABLES) != 0 {
        for i in @as(usize, 0)..b.len {
            if layout.is_default_ignorable(&b.info[i]) {
                b.pos[i].xa = 0;
                b.pos[i].ya = 0;
                b.pos[i].xo = 0;
            }
        }
    }
    layout.position_finish_offsets(b);
    if p.fallback_mark_positioning {
        fallback_mark_position(p, b, adjust);
    }
    if b.rtl {
        b.reverse();
    }
}

fn hide_default_ignorables(p: *plan.Plan, b: *mut buf.Buffer) void {
    if (b.scratch & buf.SF_HAS_DEFAULT_IGNORABLES) == 0 {
        return;
    }
    let space = p.glyph(0x20);
    if space != 0 {
        for i in @as(usize, 0)..b.len {
            if layout.is_default_ignorable(&b.info[i]) {
                b.info[i].cp = space;
            }
        }
    } else {
        b.delete_glyphs_inplace(@as(u8, 0), is_ignorable_drop);
    }
}

fn shape_buffer(p: *mut plan.Plan, b: *mut buf.Buffer, feats: []Feature) void {
    let target_rtl = b.rtl;
    b.enter();
    set_unicode_props_all(b, p.map.global_mask);
    insert_dotted_circle(p, b);
    form_clusters(b);
    ensure_native_direction(p, b);
    if p.shaper == plan.SHAPER_INDIC {
        indic.preprocess_text(p, b);
    }
    // substitute
    rotate_chars(p, b, target_rtl);
    norm.normalize(p, b);
    setup_masks(p, b, feats);
    if p.fallback_mark_positioning {
        recategorize_marks(b);
    }
    for i in @as(usize, 0)..b.len {
        b.info[i].cp = b.info[i].gid;
    }
    for i in @as(usize, 0)..b.len {
        b.info[i].gprops = layout.glyph_props(&p.face, b.info[i].cp);
        b.info[i].lig = 0;
    }
    if p.fallback_glyph_classes {
        synthesize_glyph_classes(b);
    }
    apply_map(p, b, 0);
    position(p, b);
    hide_default_ignorables(p, b);
    if p.shaper == plan.SHAPER_ARABIC {
        arabic.apply_stch(p, b);
    }
    b.rtl = target_rtl;
}

/// The script and direction a run gets: [script, 1 if right to left].
fn run_props(text: []u8, opts: Options) [2]u32 {
    let mut script = opts.script;
    if script == 0 {
        script = detect_script(text);
    }
    let mut rtl = plan.script_is_rtl(script);
    if opts.direction == Direction.LTR {
        rtl = false;
    } else if opts.direction == Direction.RTL {
        rtl = true;
    }
    let mut r: u32 = 0;
    if rtl {
        r = 1;
    }
    return [script, r];
}

fn shape_with(p: *mut plan.Plan, text: []u8, feats: []Feature) ShapeError![]mut Glyph {
    let mut b = buf.Buffer.init();
    defer b.deinit();
    b.rtl = p.rtl;
    let mut i: usize = 0;
    while i < text.len {
        let r = decode(text, i);
        b.add(r[0], @truncate(u32, i));
        i += @as(usize, r[1]);
    }
    if b.oom {
        return error.OutOfMemory;
    }
    shape_buffer(p, &mut b, feats);
    if b.oom {
        return error.OutOfMemory;
    }
    let out = mem.alloc.[Glyph](b.len)!;
    for k in @as(usize, 0)..b.len {
        out[k] = Glyph.{
            id: b.info[k].cp,
            cluster: b.info[k].cluster,
            x_advance: b.pos[k].xa,
            y_advance: b.pos[k].ya,
            x_offset: b.pos[k].xo,
            y_offset: b.pos[k].yo,
        };
    }
    return out;
}

/// Shapes a run of text with a font: the glyphs, in visual order (free
/// them with mem.free). A Shaper is faster for many runs.
pub fn shape(f: *font.Font, text: []u8, opts: Options) ShapeError![]mut Glyph {
    let pr = run_props(text, opts);
    let mut p = make_plan(f, pr[0], pr[1] == 1, opts.language, opts.features)!;
    defer p.deinit();
    return shape_with(&mut p, text, opts.features);
}

struct Cached {
    font: usize,
    data: usize,
    script: u32,
    rtl: bool,
    language: u32,
    features: []mut Feature,
    plan: plan.Plan,
    used: u64,
}

const MAX_PLANS: usize = 16;

/// Shapes many runs, remembering what it works out for each font, script,
/// direction and set of features (the fonts must outlive it).
pub struct Shaper {
    plans: vec.Vec.[Cached],
    clock: u64,

    pub fn init() Shaper {
        return Shaper.{ plans: vec.Vec.[Cached].init(), clock: 0 };
    }

    pub fn deinit(self: *mut Shaper) void {
        let ps = self.plans.items();
        for k in @as(usize, 0)..ps.len {
            ps[k].plan.deinit();
            mem.free(ps[k].features);
        }
        self.plans.deinit();
    }

    /// As shape.
    pub fn shape(self: *mut Shaper, f: *font.Font, text: []u8, opts: Options) ShapeError![]mut Glyph {
        let pr = run_props(text, opts);
        let rtl = pr[1] == 1;
        self.clock += 1;
        let ps = self.plans.items();
        for k in @as(usize, 0)..ps.len {
            let c = &mut ps[k];
            if (c.font == @int_from_ptr(f)) and (c.data == @int_from_ptr(f.data.ptr)) and (c.script == pr[0]) and
               (c.rtl == rtl) and (c.language == opts.language) and same_features(c.features, opts.features) {
                c.used = self.clock;
                return shape_with(&mut c.plan, text, opts.features);
            }
        }
        let mut p = make_plan(f, pr[0], rtl, opts.language, opts.features)!;
        let feats = mem.alloc.[Feature](opts.features.len) catch |e| {
            p.deinit();
            return e;
        };
        @mem_copy(feats, opts.features);
        let entry = Cached.{
            font: @int_from_ptr(f),
            data: @int_from_ptr(f.data.ptr),
            script: pr[0],
            rtl: rtl,
            language: opts.language,
            features: feats,
            plan: p,
            used: self.clock,
        };
        if self.plans.len >= MAX_PLANS {
            // replace the least recently used
            let mut old: usize = 0;
            let items = self.plans.items();
            for k in @as(usize, 1)..items.len {
                if items[k].used < items[old].used {
                    old = k;
                }
            }
            items[old].plan.deinit();
            mem.free(items[old].features);
            items[old] = entry;
            return shape_with(&mut items[old].plan, text, opts.features);
        }
        self.plans.push(entry) catch |e| {
            p.deinit();
            mem.free(feats);
            return e;
        };
        let last = self.plans.len - 1;
        return shape_with(&mut self.plans.items()[last].plan, text, opts.features);
    }
}

fn same_features(a: []Feature, b: []Feature) bool {
    if a.len != b.len {
        return false;
    }
    for i in @as(usize, 0)..a.len {
        if (a[i].tag != b[i].tag) or (a[i].value != b[i].value) or (a[i].start != b[i].start) or
           (a[i].end != b[i].end) {
            return false;
        }
    }
    return true;
}

/// The advance width of a line of text at a size (the em in pixels).
pub fn measure(f: *font.Font, text: []u8, size: f64) ShapeError!f64 {
    let gs = shape(f, text, options())!;
    defer mem.free(gs);
    let mut w: i64 = 0;
    for g in gs {
        w += @as(i64, g.x_advance);
    }
    return @float_from_int(f64, w) * font.scale_for(f, size);
}

/// Draws a line of text, shaped, with its baseline starting at (x, y) (y
/// down). One run: std/graphics/text lays out paragraphs with mixed directions,
/// scripts and fonts.
pub fn draw_text(cv: *mut draw.Canvas, f: *font.Font, text: []u8, x: f64, y: f64, size: f64,
                 paint: draw.Paint) ShapeError!void {
    let gs = shape(f, text, options())!;
    defer mem.free(gs);
    let scale = font.scale_for(f, size);
    let mut path = draw.Path.init();
    defer path.deinit();
    let mut pen = x;
    let mut pen_y = y;
    for g in gs {
        let gx = pen + (@float_from_int(f64, g.x_offset) * scale);
        let gy = pen_y - (@float_from_int(f64, g.y_offset) * scale);
        f.glyph_path(g.id, &mut path, gx, gy, scale)!;
        pen += @float_from_int(f64, g.x_advance) * scale;
        pen_y -= @float_from_int(f64, g.y_advance) * scale;
    }
    cv.fill(&path, paint, draw.FillRule.NONZERO)!;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

import "../fmt.ax" as fmt;
import "../os/fs.ax" as fs;
import "../str.ax" as strs;

fn field(line: []u8, n: usize) []u8 {
    let mut start: usize = 0;
    let mut k: usize = 0;
    for i in @as(usize, 0)..(line.len + 1) {
        if (i == line.len) or (line[i] == '\t') {
            if k == n {
                return line[start..i];
            }
            k += 1;
            start = i + 1;
        }
    }
    return line[..0];
}

fn describe(gs: []Glyph, out: *mut strs.String) ShapeError!void {
    for k in @as(usize, 0)..gs.len {
        let g = gs[k];
        if k > 0 {
            out.push(' ')!;
        }
        let vals: [6]i64 = [@as(i64, g.id), @as(i64, g.cluster), @as(i64, g.x_advance), @as(i64, g.y_advance),
                            @as(i64, g.x_offset), @as(i64, g.y_offset)];
        for v in @as(usize, 0)..6 {
            if v > 0 {
                out.push(':')!;
            }
            let mut b: [24]u8 = [0; 24];
            out.push_str(fmt.format_int(b[..], vals[v]))!;
        }
    }
}

/// Shapes the cases of one font; the number that differ from HarfBuzz.
fn check_font(f: *font.Font, lines: [][]u8) ShapeError!usize {
    let mut bad: usize = 0;
    let mut got = strs.String.init();
    defer got.deinit();
    for line in lines {
        let feats = field(line, 2);
        let mut fl: [8]Feature = [Feature.{ tag: 0, value: 0, start: 0, end: 0 }; 8];
        let mut nf: usize = 0;
        let mut s0: usize = 0;
        while s0 < feats.len {
            let mut e0 = s0;
            while (e0 < feats.len) and (feats[e0] != ',') {
                e0 += 1;
            }
            fl[nf] = feature(feats[s0..e0])!;
            nf += 1;
            s0 = e0 + 1;
        }
        let mut o = options();
        o.features = fl[..nf];
        let gs = shape(f, field(line, 1), o)!;
        defer mem.free(gs);
        got.clear();
        describe(gs, &mut got)!;
        if not strs.eq(got.bytes(), field(line, 3)) {
            if bad < 3 {
                fmt.eprint("mismatch: {}\n  want {}\n  got  {}\n", [fmt.str(field(line, 1)), fmt.str(field(line, 3)),
                                                                    fmt.str(got.bytes())]) catch {};
            }
            bad += 1;
        }
    }
    return bad;
}

test "shapes like HarfBuzz" {
    let data = fs.read_file("std/graphics/shape/testdata/cases.txt") catch return;
    defer mem.free(data);
    let mut lines = vec.Vec.[[]u8].init();
    defer lines.deinit();
    let mut start: usize = 0;
    for i in @as(usize, 0)..data.len {
        if data[i] == '\n' {
            lines.push(data[start..i])!;
            start = i + 1;
        }
    }
    let ls = lines.items();
    let mut bad: usize = 0;
    let mut checked: usize = 0;
    let mut i: usize = 0;
    while i < ls.len {
        let path = field(ls[i], 0);
        let mut j = i + 1;
        while (j < ls.len) and strs.eq(field(ls[j], 0), path) {
            j += 1;
        }
        let mut f = font.Font.load(path) catch {
            i = j;
            continue;
        };
        defer f.deinit();
        bad += check_font(&f, ls[i..j])!;
        checked += j - i;
        i = j;
    }
    @expect_eq(bad, 0);
}

test "features" {
    let f = feature("-liga")!;
    @expect_eq(f.tag, tag("liga"));
    @expect_eq(f.value, 0);
    @expect_eq(f.end, ALL);
    let g = feature("aalt=2")!;
    @expect_eq(g.value, 2);
    let h = feature("kern[3:5]")!;
    @expect_eq(h.start, 3);
    @expect_eq(h.end, 5);
    let k = feature("smcp[2:]")!;
    @expect_eq(k.start, 2);
    @expect_eq(k.end, ALL);
    let l = feature("+kern[7]=0")!;
    @expect_eq(l.start, 7);
    @expect_eq(l.end, 8);
    @expect_eq(l.value, 0);
    @expect_eq(tag("ss1"), tag("ss1 "));
    _ = feature("toolong") catch |e| {
        @expect(e == error.InvalidFeature);
        return;
    };
    @expect(false);
}

test "scripts and directions" {
    @expect_eq(detect_script("123 abc"), tag("Latn"));
    @expect_eq(detect_script("(\u{627}\u{644})"), tag("Arab"));
    @expect_eq(detect_script("\u{915}\u{94d}"), tag("Deva"));
    @expect_eq(detect_script("123 !"), 0);
    @expect(is_rtl(tag("Arab")));
    @expect(is_rtl(tag("Hebr")));
    @expect(not is_rtl(tag("Latn")));
}

test "ligatures, kerning and joining" {
    let mut f = font.Font.load("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf") catch return;
    defer f.deinit();
    // "ffi" is one glyph; its cluster is the first "f"
    let a = shape(&f, "office", options())!;
    defer mem.free(a);
    @expect_eq(a.len, 4);
    @expect_eq(a[1].cluster, 1);
    @expect_eq(a[2].cluster, 4);
    let mut o = options();
    let off: [1]Feature = [feature("-liga")!];
    o.features = off[..];
    let b = shape(&f, "office", o)!;
    defer mem.free(b);
    @expect_eq(b.len, 6);
    // "AV" kerns
    let c = shape(&f, "AV", options())!;
    defer mem.free(c);
    @expect(c[0].x_advance < f.advance(c[0].id));
    // Arabic comes out right to left, joined: "lam alef" is a ligature
    let d = shape(&f, "\u{644}\u{627}", options())!;
    defer mem.free(d);
    @expect_eq(d.len, 1);
    let e = shape(&f, "\u{628}\u{628}", options())!;
    defer mem.free(e);
    @expect_eq(e.len, 2);
    @expect_eq(e[0].cluster, 2);  // visual order: the second beh first
    @expect(e[0].id != e[1].id);  // final and initial forms
}

test "empty and invalid text" {
    let mut f = font.Font.load("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf") catch return;
    defer f.deinit();
    let a = shape(&f, "", options())!;
    defer mem.free(a);
    @expect_eq(a.len, 0);
    let bad: [4]u8 = [0xff, 'a', 0xc3, 0x28];
    let b = shape(&f, bad[..], options())!;
    defer mem.free(b);
    @expect_eq(b.len, 4);
    @expect_eq(b[2].cluster, 2);
}
