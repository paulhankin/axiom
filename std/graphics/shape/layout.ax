// =============================================================================
// std/graphics/shape/layout.ax - OpenType layout: GDEF glyph classes, the GSUB and
// GPOS lookups (all types, with contexts, chaining and extensions) applied to
// a buffer, and the feature map that decides which lookups apply to which
// glyphs, in which order. It follows HarfBuzz's implementation (its matching,
// skipping, ligature-component and attachment rules), so that glyphs and
// positions come out as HarfBuzz's do. Positions are in font units.
// =============================================================================

import "../../collections/vec.ax" as vec;
import "buffer.ax" as buf;

error { OutOfMemory }

// -----------------------------------------------------------------------------
// Reading the font (every read is bounds-checked: out of range reads 0)
// -----------------------------------------------------------------------------

pub fn u16at(d: []u8, i: usize) u32 {
    if (i + 2) > d.len {
        return 0;
    }
    return (@as(u32, d[i]) << 8) | @as(u32, d[i + 1]);
}

pub fn i16at(d: []u8, i: usize) i32 {
    let v = u16at(d, i);
    if v >= 0x8000 {
        return @bit_cast(i32, v) - 0x10000;
    }
    return @bit_cast(i32, v);
}

pub fn u32at(d: []u8, i: usize) u32 {
    if (i + 4) > d.len {
        return 0;
    }
    return (@as(u32, d[i]) << 24) | (@as(u32, d[i + 1]) << 16) | (@as(u32, d[i + 2]) << 8) | @as(u32, d[i + 3]);
}

/// base + the 16-bit offset at p (0 if the offset is 0).
fn off16(d: []u8, base: usize, p: usize) usize {
    let o = u16at(d, p);
    if (o == 0) or (base == 0) {
        return 0;
    }
    return base + @as(usize, o);
}

pub const NOT_COVERED: i64 = -1;

fn us(x: i64) usize {
    return @truncate(usize, @bit_cast(u64, x));
}

fn sz(x: usize) i64 {
    return @bit_cast(i64, @as(u64, x));
}

/// The coverage index of g, or NOT_COVERED.
pub fn coverage(d: []u8, c: usize, g: u32) i64 {
    if c == 0 {
        return NOT_COVERED;
    }
    let fmt = u16at(d, c);
    let n = @as(usize, u16at(d, c + 2));
    if fmt == 1 {
        let mut lo: usize = 0;
        let mut hi = n;
        while lo < hi {
            let mid = (lo + hi) / 2;
            let v = u16at(d, c + 4 + (2 * mid));
            if v < g {
                lo = mid + 1;
            } else if v > g {
                hi = mid;
            } else {
                return sz(mid);
            }
        }
        return NOT_COVERED;
    }
    if fmt == 2 {
        let mut lo: usize = 0;
        let mut hi = n;
        while lo < hi {
            let mid = (lo + hi) / 2;
            let r = c + 4 + (6 * mid);
            if g < u16at(d, r) {
                hi = mid;
            } else if g > u16at(d, r + 2) {
                lo = mid + 1;
            } else {
                return @as(i64, u16at(d, r + 4)) + @as(i64, g - u16at(d, r));
            }
        }
        return NOT_COVERED;
    }
    return NOT_COVERED;
}

/// The class of g (0 if none).
pub fn class_of(d: []u8, c: usize, g: u32) u32 {
    if c == 0 {
        return 0;
    }
    let fmt = u16at(d, c);
    if fmt == 1 {
        let start = u16at(d, c + 2);
        let n = u16at(d, c + 4);
        if (g >= start) and (g < (start + n)) {
            return u16at(d, c + 6 + (2 * @as(usize, g - start)));
        }
        return 0;
    }
    if fmt == 2 {
        let n = @as(usize, u16at(d, c + 2));
        let mut lo: usize = 0;
        let mut hi = n;
        while lo < hi {
            let mid = (lo + hi) / 2;
            let r = c + 4 + (6 * mid);
            if g < u16at(d, r) {
                hi = mid;
            } else if g > u16at(d, r + 2) {
                lo = mid + 1;
            } else {
                return u16at(d, r + 4);
            }
        }
    }
    return 0;
}

// -----------------------------------------------------------------------------
// Glyph digests: which glyphs a lookup may apply to (a small Bloom filter,
// as HarfBuzz keeps), so most glyphs are skipped without reading the font
// -----------------------------------------------------------------------------

pub struct Digest {
    m: [3]u64,
}

let DIGEST_SHIFTS: [3]u64 = [4, 0, 9];

pub fn digest_empty() Digest {
    return Digest.{ m: [0, 0, 0] };
}

pub fn digest_full() Digest {
    return Digest.{ m: [0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff] };
}

pub fn digest_has(dg: *Digest, g: u32) bool {
    let x = @as(u64, g);
    return ((dg.m[0] >> ((x >> 4) & 63)) & (dg.m[1] >> (x & 63)) & (dg.m[2] >> ((x >> 9) & 63)) & 1) != 0;
}

fn digest_add_range(dg: *mut Digest, a: u32, b: u32) void {
    for k in @as(usize, 0)..3 {
        let sh = DIGEST_SHIFTS[k];
        let lo = @as(u64, a) >> sh;
        let hi = @as(u64, b) >> sh;
        if (hi - lo) >= 63 {
            dg.m[k] = 0xffffffffffffffff;
            continue;
        }
        let mut v = lo;
        while v <= hi {
            dg.m[k] |= @as(u64, 1) << (v & 63);
            v += 1;
        }
    }
}

/// Adds the glyphs of a coverage table.
fn digest_add_coverage(dg: *mut Digest, d: []u8, c: usize) void {
    if c == 0 {
        return;
    }
    let fmt = u16at(d, c);
    let n = @as(usize, u16at(d, c + 2));
    if fmt == 1 {
        for i in @as(usize, 0)..n {
            let g = u16at(d, c + 4 + (2 * i));
            digest_add_range(dg, g, g);
        }
    } else if fmt == 2 {
        for i in @as(usize, 0)..n {
            let r = c + 4 + (6 * i);
            let a = u16at(d, r);
            let b = u16at(d, r + 2);
            if a <= b {
                digest_add_range(dg, a, b);
            }
        }
    }
}

/// The digest of the glyphs lookup li of table ti can start at.
pub fn lookup_digest(f: *Face, ti: usize, li: u32) Digest {
    let mut dg = digest_empty();
    let d = f.d;
    let l = lookup_at(f, ti, li);
    if l == 0 {
        return dg;
    }
    let typ = u16at(d, l);
    let n = @as(usize, u16at(d, l + 4));
    for i in @as(usize, 0)..n {
        let r = resolve_in(f, ti, typ, off16(d, l, l + 6 + (2 * i)));
        let st = r[1];
        if st == 0 {
            continue;
        }
        let t = r[0];
        let fmt = u16at(d, st);
        let mut cov = off16(d, st, st + 2);
        if (fmt == 3) and (((ti == 0) and (t == 5)) or ((ti == 1) and (t == 7))) {
            cov = off16(d, st, st + 6);
        } else if (fmt == 3) and (((ti == 0) and (t == 6)) or ((ti == 1) and (t == 8))) {
            let nb = @as(usize, u16at(d, st + 2));
            cov = off16(d, st, st + 4 + (2 * nb) + 2);
        }
        digest_add_coverage(&mut dg, d, cov);
    }
    return dg;
}

// -----------------------------------------------------------------------------
// The face: where the layout tables are
// -----------------------------------------------------------------------------

pub struct Face {
    d: []u8,   // where the GSUB and GPOS tables are
    gd: []u8,  // where GDEF is (the same font data, except for synthesized lookups)
    gdef: usize,
    gsub: usize,
    gpos: usize,
    glyph_class_def: usize,
    mark_attach_class_def: usize,
    mark_sets: usize,
    mark_set_count: u32,
    // per table (0 GSUB, 1 GPOS)
    script_list: [2]usize,
    feature_list: [2]usize,
    lookup_list: [2]usize,
    lookup_count: [2]u32,
}

pub fn face_init(d: []u8, gdef: usize, gsub: usize, gpos: usize) Face {
    let mut f = Face.{
        d: d,
        gd: d,
        gdef: gdef,
        gsub: gsub,
        gpos: gpos,
        glyph_class_def: 0,
        mark_attach_class_def: 0,
        mark_sets: 0,
        mark_set_count: 0,
        script_list: [0, 0],
        feature_list: [0, 0],
        lookup_list: [0, 0],
        lookup_count: [0, 0],
    };
    if gdef != 0 {
        f.glyph_class_def = off16(d, gdef, gdef + 4);
        f.mark_attach_class_def = off16(d, gdef, gdef + 10);
        if (u16at(d, gdef) == 1) and (u16at(d, gdef + 2) >= 2) {
            f.mark_sets = off16(d, gdef, gdef + 12);
            if f.mark_sets != 0 {
                f.mark_set_count = u16at(d, f.mark_sets + 2);
            }
        }
    }
    let ts: [2]usize = [gsub, gpos];
    for t in @as(usize, 0)..2 {
        let o = ts[t];
        if (o != 0) and (u16at(d, o) == 1) {
            f.script_list[t] = off16(d, o, o + 4);
            f.feature_list[t] = off16(d, o, o + 6);
            f.lookup_list[t] = off16(d, o, o + 8);
            if f.lookup_list[t] != 0 {
                f.lookup_count[t] = u16at(d, f.lookup_list[t]);
            }
        }
    }
    return f;
}

pub fn has_glyph_classes(f: *Face) bool {
    return f.glyph_class_def != 0;
}

/// GDEF's glyph properties for g (class flags, and a mark's attachment
/// class in the high byte).
pub fn glyph_props(f: *Face, g: u32) u16 {
    let k = class_of(f.gd, f.glyph_class_def, g);
    if k == 1 {
        return buf.GP_BASE_GLYPH;
    }
    if k == 2 {
        return buf.GP_LIGATURE;
    }
    if k == 3 {
        let a = class_of(f.gd, f.mark_attach_class_def, g);
        return buf.GP_MARK | @truncate(u16, (a & 0xff) << 8);
    }
    return 0;
}

fn mark_set_covers(f: *Face, set: u32, g: u32) bool {
    if (f.mark_sets == 0) or (set >= f.mark_set_count) {
        return false;
    }
    let o = u32at(f.gd, f.mark_sets + 4 + (4 * @as(usize, set)));
    if o == 0 {
        return false;
    }
    return coverage(f.gd, f.mark_sets + @as(usize, o), g) != NOT_COVERED;
}

/// The lookup table at index i of table t (0 if none).
fn lookup_at(f: *Face, t: usize, i: u32) usize {
    if i >= f.lookup_count[t] {
        return 0;
    }
    return off16(f.d, f.lookup_list[t], f.lookup_list[t] + 2 + (2 * @as(usize, i)));
}

/// A lookup's flags, with its mark filtering set in the high 16 bits.
fn lookup_props(f: *Face, l: usize) u32 {
    let flag = u16at(f.d, l + 2);
    let mut props = flag;
    if (flag & LF_USE_MARK_FILTERING_SET) != 0 {
        let n = @as(usize, u16at(f.d, l + 4));
        props |= u16at(f.d, l + 6 + (2 * n)) << 16;
    }
    return props;
}

// Lookup flags
const LF_RIGHT_TO_LEFT: u32 = 0x01;
const LF_IGNORE_FLAGS: u32 = 0x0e;
const LF_IGNORE_MARKS: u32 = 0x08;
const LF_USE_MARK_FILTERING_SET: u32 = 0x10;
const LF_MARK_ATTACHMENT_TYPE: u32 = 0xff00;

pub const MAX_NESTING: u32 = 64;
pub const MAX_CONTEXT: usize = 64;

// -----------------------------------------------------------------------------
// Glyph information helpers (HarfBuzz's _hb_glyph_info_*)
// -----------------------------------------------------------------------------

pub fn gen_cat(i: *buf.Info) u32 {
    return @as(u32, i.uprops & buf.UP_GEN_CAT);
}

pub fn is_unicode_mark(i: *buf.Info) bool {
    let g = gen_cat(i);
    return (g == 6) or (g == 7) or (g == 8);  // Mn, Mc, Me
}

pub fn modified_cc(i: *buf.Info) u32 {
    if is_unicode_mark(i) {
        return @as(u32, i.uprops >> 8);
    }
    return 0;
}

pub fn set_modified_cc(i: *mut buf.Info, cc: u32) void {
    if not is_unicode_mark(i) {
        return;
    }
    i.uprops = @truncate(u16, (cc << 8) | @as(u32, i.uprops & 0xff));
}

pub fn set_gen_cat(i: *mut buf.Info, gc: u32) void {
    i.uprops = @truncate(u16, gc) | (i.uprops & (0xff & ~buf.UP_GEN_CAT)) | (i.uprops & 0xff00);
}

pub fn is_default_ignorable(i: *buf.Info) bool {
    return ((i.uprops & buf.UP_IGNORABLE) != 0) and not substituted(i);
}

pub fn is_zwnj(i: *buf.Info) bool {
    return (gen_cat(i) == 27) and ((i.uprops & buf.UP_ZWNJ) != 0);
}

pub fn is_zwj(i: *buf.Info) bool {
    return (gen_cat(i) == 27) and ((i.uprops & buf.UP_ZWJ) != 0);
}

pub fn is_hidden(i: *buf.Info) bool {
    return (i.uprops & buf.UP_HIDDEN) != 0;
}

pub fn is_mark(i: *buf.Info) bool {
    return (i.gprops & buf.GP_MARK) != 0;
}

pub fn is_base_glyph(i: *buf.Info) bool {
    return (i.gprops & buf.GP_BASE_GLYPH) != 0;
}

pub fn is_ligature(i: *buf.Info) bool {
    return (i.gprops & buf.GP_LIGATURE) != 0;
}

pub fn substituted(i: *buf.Info) bool {
    return (i.gprops & buf.GP_SUBSTITUTED) != 0;
}

pub fn ligated(i: *buf.Info) bool {
    return (i.gprops & buf.GP_LIGATED) != 0;
}

pub fn multiplied(i: *buf.Info) bool {
    return (i.gprops & buf.GP_MULTIPLIED) != 0;
}

pub fn lig_id(i: *buf.Info) u32 {
    return @as(u32, i.lig) >> 5;
}

fn ligated_internal(i: *buf.Info) bool {
    return (i.lig & 0x10) != 0;
}

pub fn lig_comp(i: *buf.Info) u32 {
    if ligated_internal(i) {
        return 0;
    }
    return @as(u32, i.lig & 0x0f);
}

pub fn lig_num_comps(i: *buf.Info) u32 {
    if ((i.gprops & buf.GP_LIGATURE) != 0) and ligated_internal(i) {
        return @as(u32, i.lig & 0x0f);
    }
    return 1;
}

fn lig_num_comps_in_ligation(i: *buf.Info) u32 {
    if multiplied(i) and (lig_comp(i) != 0) {
        return 0;
    }
    return lig_num_comps(i);
}

fn set_lig_props_for_ligature(i: *mut buf.Info, id: u32, n: u32) void {
    i.lig = @truncate(u8, (id << 5) | 0x10 | (n & 0x0f));
}

fn set_lig_props_for_mark(i: *mut buf.Info, id: u32, comp: u32) void {
    i.lig = @truncate(u8, (id << 5) | (comp & 0x0f));
}

fn allocate_lig_id(b: *mut buf.Buffer) u32 {
    let mut id = @as(u32, b.next_serial() & 0x07);
    while id == 0 {
        id = @as(u32, b.next_serial() & 0x07);
    }
    return id;
}

// -----------------------------------------------------------------------------
// The apply context and the skipping iterator
// -----------------------------------------------------------------------------

// Match functions
const MF_NONE: u8 = 0;
const MF_GLYPH: u8 = 1;
const MF_CLASS: u8 = 2;
const MF_COVERAGE: u8 = 3;

const MATCH: u8 = 0;
const NOT_MATCH: u8 = 1;
const SKIP: u8 = 2;

const SKIP_NO: u8 = 0;
const SKIP_YES: u8 = 1;
const SKIP_MAYBE: u8 = 2;

struct Iter {
    idx: usize,
    end: usize,
    lookup_props: u32,
    mask: u32,
    ignore_zwnj: bool,
    ignore_zwj: bool,
    ignore_hidden: bool,
    per_syllable: bool,
    syllable: u8,
    mf: u8,
    mdata: usize,  // class definition, or the base of coverage offsets
    gd: usize,     // the u16 values to match (when has_gd)
    has_gd: bool,
}

pub struct Ctx {
    f: *Face,
    b: *mut buf.Buffer,
    table: usize,  // 0 GSUB, 1 GPOS
    lookup_mask: u32,
    lookup_index: u32,
    lookup_props: u32,
    nesting_left: u32,
    has_glyph_classes: bool,
    auto_zwnj: bool,
    auto_zwj: bool,
    per_syllable: bool,
    random: bool,
    random_state: u32,
    last_base: i64,
    last_base_until: usize,
    rtl: bool,
    iter_input: Iter,
    iter_context: Iter,
}

fn iter_init(c: *Ctx, context_match: bool) Iter {
    let mut it = Iter.{
        idx: 0,
        end: c.b.len,
        lookup_props: c.lookup_props,
        mask: c.lookup_mask,
        ignore_zwnj: (c.table == 1) or (context_match and c.auto_zwnj),
        ignore_zwj: context_match or c.auto_zwj,
        ignore_hidden: c.table == 1,
        per_syllable: (c.table == 0) and c.per_syllable,
        syllable: 0,
        mf: MF_NONE,
        mdata: 0,
        gd: 0,
        has_gd: false,
    };
    if context_match {
        it.mask = 0xffffffff;
    }
    return it;
}

fn init_iters(c: *mut Ctx) void {
    c.iter_input = iter_init(c, false);
    c.iter_context = iter_init(c, true);
}

pub fn ctx_init(f: *Face, b: *mut buf.Buffer, table: usize) Ctx {
    let mut c = Ctx.{
        f: f,
        b: b,
        table: table,
        lookup_mask: 1,
        lookup_index: 0xffffffff,
        lookup_props: 0,
        nesting_left: MAX_NESTING,
        has_glyph_classes: has_glyph_classes(f),
        auto_zwnj: true,
        auto_zwj: true,
        per_syllable: false,
        random: false,
        random_state: 1,
        last_base: -1,
        last_base_until: 0,
        rtl: b.rtl,
        iter_input: Iter.{
            idx: 0,
            end: 0,
            lookup_props: 0,
            mask: 0,
            ignore_zwnj: false,
            ignore_zwj: false,
            ignore_hidden: false,
            per_syllable: false,
            syllable: 0,
            mf: 0,
            mdata: 0,
            gd: 0,
            has_gd: false,
        },
        iter_context: Iter.{
            idx: 0,
            end: 0,
            lookup_props: 0,
            mask: 0,
            ignore_zwnj: false,
            ignore_zwj: false,
            ignore_hidden: false,
            per_syllable: false,
            syllable: 0,
            mf: 0,
            mdata: 0,
            gd: 0,
            has_gd: false,
        },
    };
    init_iters(&mut c);
    return c;
}

fn set_lookup_props(c: *mut Ctx, props0: u32) void {
    let mut props = props0;
    if ((props & LF_USE_MARK_FILTERING_SET) != 0) and ((props >> 16) >= c.f.mark_set_count) {
        props &= ~LF_USE_MARK_FILTERING_SET;
    }
    c.lookup_props = props;
    init_iters(c);
}

fn check_glyph_property(c: *Ctx, i: *buf.Info, match_props: u32) bool {
    let gp = @as(u32, i.gprops);
    if (gp & match_props & LF_IGNORE_FLAGS) != 0 {
        return false;
    }
    if (gp & @as(u32, buf.GP_MARK)) != 0 {
        if (match_props & LF_USE_MARK_FILTERING_SET) != 0 {
            return mark_set_covers(c.f, match_props >> 16, i.cp);
        }
        if (match_props & LF_MARK_ATTACHMENT_TYPE) != 0 {
            return (match_props & LF_MARK_ATTACHMENT_TYPE) == (gp & LF_MARK_ATTACHMENT_TYPE);
        }
    }
    return true;
}

fn may_skip(c: *Ctx, it: *Iter, i: *buf.Info) u8 {
    if not check_glyph_property(c, i, it.lookup_props) {
        return SKIP_YES;
    }
    if is_default_ignorable(i) and (it.ignore_zwnj or not is_zwnj(i)) and (it.ignore_zwj or not is_zwj(i)) and
       (it.ignore_hidden or not is_hidden(i)) {
        return SKIP_MAYBE;
    }
    return SKIP_NO;
}

fn glyph_data(c: *Ctx, it: *Iter) u32 {
    if it.has_gd {
        return u16at(c.f.d, it.gd);
    }
    return 0;
}

/// 0 no, 1 yes, 2 maybe.
fn may_match(c: *Ctx, it: *Iter, i: *buf.Info) u8 {
    if ((i.mask & it.mask) == 0) or (it.per_syllable and (it.syllable != 0) and (it.syllable != i.syl)) {
        return 0;
    }
    if it.mf == MF_NONE {
        return 2;
    }
    let v = glyph_data(c, it);
    let mut ok = false;
    if it.mf == MF_GLYPH {
        ok = i.cp == v;
    } else if it.mf == MF_CLASS {
        ok = class_of(c.f.d, it.mdata, i.cp) == v;
    } else {
        ok = coverage(c.f.d, off_plus(it.mdata, v), i.cp) != NOT_COVERED;
    }
    if ok {
        return 1;
    }
    return 0;
}

fn off_plus(base: usize, o: u32) usize {
    if o == 0 {
        return 0;
    }
    return base + @as(usize, o);
}

fn iter_match(c: *Ctx, it: *Iter, i: *buf.Info) u8 {
    let skip = may_skip(c, it, i);
    if skip == SKIP_YES {
        return SKIP;
    }
    let m = may_match(c, it, i);
    if (m == 1) or ((m == 2) and (skip == SKIP_NO)) {
        return MATCH;
    }
    if skip == SKIP_NO {
        return NOT_MATCH;
    }
    return SKIP;
}

fn iter_reset(c: *Ctx, it: *mut Iter, start: usize) void {
    it.idx = start;
    it.end = c.b.len;
    it.syllable = 0;
    if c.b.idx < c.b.len {
        it.syllable = c.b.info[c.b.idx].syl;
    }
}

fn iter_set(it: *mut Iter, mf: u8, mdata: usize, gd: usize, has_gd: bool) void {
    it.mf = mf;
    it.mdata = mdata;
    it.gd = gd;
    it.has_gd = has_gd;
}

fn iter_next(c: *Ctx, it: *mut Iter) bool {
    let stop = sz(it.end) - 1;
    while sz(it.idx) < stop {
        it.idx += 1;
        let r = iter_match(c, it, &c.b.info[it.idx]);
        if r == MATCH {
            if it.has_gd {
                it.gd += 2;
            }
            return true;
        }
        if r == NOT_MATCH {
            return false;
        }
    }
    return false;
}

fn iter_prev(c: *Ctx, it: *mut Iter) bool {
    let back = c.b.back();
    while it.idx > 0 {
        it.idx -= 1;
        let r = iter_match(c, it, &back[it.idx]);
        if r == MATCH {
            if it.has_gd {
                it.gd += 2;
            }
            return true;
        }
        if r == NOT_MATCH {
            return false;
        }
    }
    return false;
}

// -----------------------------------------------------------------------------
// Setting glyph classes as glyphs change
// -----------------------------------------------------------------------------

fn set_glyph_class(c: *mut Ctx, g: u32, class_guess: u16, ligature: bool, component: bool) void {
    let cur = c.b.cur();
    let mut props = cur.gprops | buf.GP_SUBSTITUTED;
    if ligature {
        props |= buf.GP_LIGATED;
        props &= ~buf.GP_MULTIPLIED;
    }
    if component {
        props |= buf.GP_MULTIPLIED;
    }
    if c.has_glyph_classes {
        cur.gprops = (props & buf.GP_PRESERVE) | glyph_props(c.f, g);
    } else if class_guess != 0 {
        cur.gprops = (props & buf.GP_PRESERVE) | class_guess;
    } else {
        cur.gprops = props;
    }
}

fn replace_glyph(c: *mut Ctx, g: u32) void {
    set_glyph_class(c, g, 0, false, false);
    _ = c.b.replace_glyph(g);
}

fn replace_glyph_inplace(c: *mut Ctx, g: u32) void {
    set_glyph_class(c, g, 0, false, false);
    c.b.cur().cp = g;
}

// -----------------------------------------------------------------------------
// Matching input, backtrack and lookahead sequences
// -----------------------------------------------------------------------------

/// Matches count glyphs (the first is the current one; the others are the
/// count - 1 u16 values at gd) and records their positions in mp.
fn match_input(c: *mut Ctx, count: usize, gd: usize, mf: u8, mdata: usize, mp: *mut [64]u32, end_pos: *mut usize,
               total_comps: *mut u32) bool {
    let b = c.b;
    if count == 1 {
        end_pos.* = b.idx + 1;
        mp[0] = @truncate(u32, b.idx);
        total_comps.* = lig_num_comps(&b.info[b.idx]);
        return true;
    }
    if count > MAX_CONTEXT {
        return false;
    }
    iter_reset(c, &mut c.iter_input, b.idx);
    iter_set(&mut c.iter_input, mf, mdata, gd, true);
    let mut total: u32 = 0;
    let first_lig_id = lig_id(&b.info[b.idx]);
    let first_lig_comp = lig_comp(&b.info[b.idx]);
    let mut ligbase: u8 = 0;  // 0 not checked, 1 may not skip, 2 may skip
    for i in @as(usize, 1)..count {
        if not iter_next(c, &mut c.iter_input) {
            end_pos.* = c.iter_input.idx + 1;
            return false;
        }
        let at = c.iter_input.idx;
        mp[i] = @truncate(u32, at);
        let this_id = lig_id(&b.info[at]);
        let this_comp = lig_comp(&b.info[at]);
        if (first_lig_id != 0) and (first_lig_comp != 0) {
            if (first_lig_id != this_id) or (first_lig_comp != this_comp) {
                if ligbase == 0 {
                    let mut found = false;
                    let out = b.back();
                    let mut j = b.backtrack_len();
                    while (j > 0) and (lig_id(&out[j - 1]) == first_lig_id) {
                        if lig_comp(&out[j - 1]) == 0 {
                            j -= 1;
                            found = true;
                            break;
                        }
                        j -= 1;
                    }
                    if found and (may_skip(c, &c.iter_input, &out[j]) == SKIP_YES) {
                        ligbase = 2;
                    } else {
                        ligbase = 1;
                    }
                }
                if ligbase == 1 {
                    return false;
                }
            }
        } else {
            if (this_id != 0) and (this_comp != 0) and (this_id != first_lig_id) {
                return false;
            }
        }
        total += lig_num_comps_in_ligation(&b.info[at]);
    }
    end_pos.* = c.iter_input.idx + 1;
    total += lig_num_comps(&b.info[b.idx]);
    total_comps.* = total;
    mp[0] = @truncate(u32, b.idx);
    return true;
}

fn ligate_input(c: *mut Ctx, count: usize, mp: *mut [64]u32, match_end: usize, lig_glyph: u32, total_comps: u32) void {
    let b = c.b;
    b.merge_clusters(b.idx, match_end);
    let mut is_base_ligature = is_base_glyph(&b.info[@as(usize, mp[0])]);
    let mut is_mark_ligature = is_mark(&b.info[@as(usize, mp[0])]);
    for i in @as(usize, 1)..count {
        if not is_mark(&b.info[@as(usize, mp[i])]) {
            is_base_ligature = false;
            is_mark_ligature = false;
            break;
        }
    }
    let is_lig = not is_base_ligature and not is_mark_ligature;
    let mut klass: u16 = 0;
    let mut id: u32 = 0;
    if is_lig {
        klass = buf.GP_LIGATURE;
        id = allocate_lig_id(b);
    }
    let mut last_lig_id = lig_id(&b.info[b.idx]);
    let mut last_num_comps = lig_num_comps(&b.info[b.idx]);
    let mut comps_so_far = last_num_comps;
    if is_lig {
        set_lig_props_for_ligature(b.cur(), id, total_comps);
        if gen_cat(&b.info[b.idx]) == 6 {  // Mn
            set_gen_cat(b.cur(), 5);  // Lo
        }
    }
    set_glyph_class(c, lig_glyph, klass, true, false);
    _ = b.replace_glyph(lig_glyph);
    for i in @as(usize, 1)..count {
        while (b.idx < @as(usize, mp[i])) and b.successful {
            if is_lig {
                let mut this_comp = lig_comp(&b.info[b.idx]);
                if this_comp == 0 {
                    this_comp = last_num_comps;
                }
                let new_comp = (comps_so_far - last_num_comps) + @min(this_comp, last_num_comps);
                set_lig_props_for_mark(b.cur(), id, new_comp);
            }
            _ = b.next_glyph();
        }
        if b.idx >= b.len {
            break;
        }
        last_lig_id = lig_id(&b.info[b.idx]);
        last_num_comps = lig_num_comps_in_ligation(&b.info[b.idx]);
        comps_so_far += last_num_comps;
        b.idx += 1;
    }
    if not is_mark_ligature and (last_lig_id != 0) {
        let mut i = b.idx;
        while i < b.len {
            if last_lig_id != lig_id(&b.info[i]) {
                break;
            }
            let this_comp = lig_comp(&b.info[i]);
            if this_comp == 0 {
                break;
            }
            let new_comp = (comps_so_far - last_num_comps) + @min(this_comp, last_num_comps);
            set_lig_props_for_mark(&mut b.info[i], id, new_comp);
            i += 1;
        }
    }
}

fn match_backtrack(c: *mut Ctx, count: usize, gd: usize, mf: u8, mdata: usize) bool {
    if count == 0 {
        return true;
    }
    c.iter_context.idx = c.b.backtrack_len();
    c.iter_context.syllable = 0;
    if c.b.idx < c.b.len {
        c.iter_context.syllable = c.b.info[c.b.idx].syl;
    }
    iter_set(&mut c.iter_context, mf, mdata, gd, true);
    for _i in @as(usize, 0)..count {
        if not iter_prev(c, &mut c.iter_context) {
            return false;
        }
    }
    return true;
}

fn match_lookahead(c: *mut Ctx, count: usize, gd: usize, mf: u8, mdata: usize, start: usize) bool {
    if count == 0 {
        return true;
    }
    iter_reset(c, &mut c.iter_context, start - 1);
    iter_set(&mut c.iter_context, mf, mdata, gd, true);
    for _i in @as(usize, 0)..count {
        if not iter_next(c, &mut c.iter_context) {
            return false;
        }
    }
    return true;
}

/// Applies the nested lookups of a matched context (count glyphs at mp; the
/// lookup records are at recs).
fn apply_lookup(c: *mut Ctx, count0: usize, mp: *mut [64]u32, nrec: usize, recs: usize, match_end: usize) void {
    let b = c.b;
    let d = c.f.d;
    let mut count = count0;
    let mut end: i64 = 0;
    {
        let bl = b.backtrack_len();
        end = sz((bl + match_end)) - sz(b.idx);
        let delta = sz(bl) - sz(b.idx);
        for j in @as(usize, 0)..count {
            mp[j] = @truncate(u32, @bit_cast(u64, @as(i64, mp[j]) + delta));
        }
    }
    for i in @as(usize, 0)..nrec {
        if not b.successful {
            break;
        }
        let idx = @as(usize, u16at(d, recs + (4 * i)));
        if idx >= count {
            continue;
        }
        let orig_len = b.backtrack_len() + b.lookahead_len();
        if @as(usize, mp[idx]) >= orig_len {
            continue;
        }
        if not b.move_to(@as(usize, mp[idx])) {
            break;
        }
        if b.max_ops <= 0 {
            break;
        }
        if not recurse(c, u16at(d, recs + (4 * i) + 2)) {
            continue;
        }
        let new_len = b.backtrack_len() + b.lookahead_len();
        let mut delta = sz(new_len) - sz(orig_len);
        if delta == 0 {
            continue;
        }
        end += delta;
        if end < @as(i64, mp[idx]) {
            delta += @as(i64, mp[idx]) - end;
            end = @as(i64, mp[idx]);
        }
        let mut next = sz(idx + 1);
        let cnt = sz(count);
        if delta > 0 {
            if (delta + cnt) > sz(MAX_CONTEXT) {
                break;
            }
        } else {
            delta = @max(delta, next - cnt);
            next -= delta;
        }
        // move mp[next..count] to mp[next + delta..]
        let n = cnt - next;
        if delta > 0 {
            let mut k = n;
            while k > 0 {
                k -= 1;
                mp[us(next + delta + k)] = mp[us(next + k)];
            }
        } else {
            for k in @as(i64, 0)..n {
                mp[us(next + delta + k)] = mp[us(next + k)];
            }
        }
        next += delta;
        count = us(cnt + delta);
        let mut j = idx + 1;
        while sz(j) < next {
            mp[j] = mp[j - 1] + 1;
            j += 1;
        }
        let mut k = us(next);
        while k < count {
            mp[k] = @truncate(u32, @bit_cast(u64, @as(i64, mp[k]) + delta));
            k += 1;
        }
    }
    if end < 0 {
        end = 0;
    }
    _ = b.move_to(us(end));
}

fn recurse(c: *mut Ctx, lookup_index: u32) bool {
    if c.nesting_left == 0 {
        c.b.successful = false;
        return false;
    }
    c.b.max_ops -= 1;
    if c.b.max_ops < 0 {
        c.b.successful = false;
        return false;
    }
    let l = lookup_at(c.f, c.table, lookup_index);
    if l == 0 {
        return false;
    }
    c.nesting_left -= 1;
    let saved_props = c.lookup_props;
    let saved_index = c.lookup_index;
    c.lookup_index = lookup_index;
    set_lookup_props(c, lookup_props(c.f, l));
    let ret = apply_lookup_subtables(c, l);
    c.lookup_index = saved_index;
    set_lookup_props(c, saved_props);
    c.nesting_left += 1;
    return ret;
}

// -----------------------------------------------------------------------------
// Contexts (GSUB 5, 6; GPOS 7, 8)
// -----------------------------------------------------------------------------

/// A (non-chained) rule at r: glyphCount, seqLookupCount, input, records.
fn context_rule(c: *mut Ctx, r: usize, mf: u8, mdata: usize) bool {
    let d = c.f.d;
    let count = @as(usize, u16at(d, r));
    let nrec = @as(usize, u16at(d, r + 2));
    if (count == 0) or (count > MAX_CONTEXT) {
        return false;
    }
    let mut mp: [64]u32 = [0; 64];
    let mut end: usize = 0;
    let mut tc: u32 = 0;
    if not match_input(c, count, r + 4, mf, mdata, &mut mp, &mut end, &mut tc) {
        return false;
    }
    apply_lookup(c, count, &mut mp, nrec, r + 4 + (2 * (count - 1)), end);
    return true;
}

fn chain_rule(c: *mut Ctx, r: usize, mf: u8, back_data: usize, in_data: usize, ahead_data: usize) bool {
    let d = c.f.d;
    let nb = @as(usize, u16at(d, r));
    let pi = r + 2 + (2 * nb);
    let ni = @as(usize, u16at(d, pi));
    if (ni == 0) or (ni > MAX_CONTEXT) {
        return false;
    }
    let pl = pi + 2 + (2 * (ni - 1));
    let nl = @as(usize, u16at(d, pl));
    let pr = pl + 2 + (2 * nl);
    let nrec = @as(usize, u16at(d, pr));
    let mut mp: [64]u32 = [0; 64];
    let mut end: usize = 0;
    let mut tc: u32 = 0;
    if not match_input(c, ni, pi + 2, mf, in_data, &mut mp, &mut end, &mut tc) {
        return false;
    }
    if not match_lookahead(c, nl, pl + 2, mf, ahead_data, end) {
        return false;
    }
    if not match_backtrack(c, nb, r + 2, mf, back_data) {
        return false;
    }
    apply_lookup(c, ni, &mut mp, nrec, pr + 2, end);
    return true;
}

fn context(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let g = c.b.info[c.b.idx].cp;
    let fmt = u16at(d, s);
    if fmt == 1 {
        let ci = coverage(d, off16(d, s, s + 2), g);
        if ci == NOT_COVERED {
            return false;
        }
        let k = us(ci);
        if k >= @as(usize, u16at(d, s + 4)) {
            return false;
        }
        let rs = off16(d, s, s + 6 + (2 * k));
        if rs == 0 {
            return false;
        }
        for i in @as(usize, 0)..@as(usize, u16at(d, rs)) {
            let r = off16(d, rs, rs + 2 + (2 * i));
            if (r != 0) and context_rule(c, r, MF_GLYPH, 0) {
                return true;
            }
        }
        return false;
    }
    if fmt == 2 {
        if coverage(d, off16(d, s, s + 2), g) == NOT_COVERED {
            return false;
        }
        let cd = off16(d, s, s + 4);
        let k = @as(usize, class_of(d, cd, g));
        if k >= @as(usize, u16at(d, s + 6)) {
            return false;
        }
        let rs = off16(d, s, s + 8 + (2 * k));
        if rs == 0 {
            return false;
        }
        for i in @as(usize, 0)..@as(usize, u16at(d, rs)) {
            let r = off16(d, rs, rs + 2 + (2 * i));
            if (r != 0) and context_rule(c, r, MF_CLASS, cd) {
                return true;
            }
        }
        return false;
    }
    if fmt == 3 {
        let count = @as(usize, u16at(d, s + 2));
        let nrec = @as(usize, u16at(d, s + 4));
        if (count == 0) or (count > MAX_CONTEXT) {
            return false;
        }
        if coverage(d, off16(d, s, s + 6), g) == NOT_COVERED {
            return false;
        }
        let mut mp: [64]u32 = [0; 64];
        let mut end: usize = 0;
        let mut tc: u32 = 0;
        if not match_input(c, count, s + 8, MF_COVERAGE, s, &mut mp, &mut end, &mut tc) {
            return false;
        }
        apply_lookup(c, count, &mut mp, nrec, s + 6 + (2 * count), end);
        return true;
    }
    return false;
}

fn chain_context(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let g = c.b.info[c.b.idx].cp;
    let fmt = u16at(d, s);
    if fmt == 1 {
        let ci = coverage(d, off16(d, s, s + 2), g);
        if ci == NOT_COVERED {
            return false;
        }
        let k = us(ci);
        if k >= @as(usize, u16at(d, s + 4)) {
            return false;
        }
        let rs = off16(d, s, s + 6 + (2 * k));
        if rs == 0 {
            return false;
        }
        for i in @as(usize, 0)..@as(usize, u16at(d, rs)) {
            let r = off16(d, rs, rs + 2 + (2 * i));
            if (r != 0) and chain_rule(c, r, MF_GLYPH, 0, 0, 0) {
                return true;
            }
        }
        return false;
    }
    if fmt == 2 {
        if coverage(d, off16(d, s, s + 2), g) == NOT_COVERED {
            return false;
        }
        let bcd = off16(d, s, s + 4);
        let icd = off16(d, s, s + 6);
        let lcd = off16(d, s, s + 8);
        let k = @as(usize, class_of(d, icd, g));
        if k >= @as(usize, u16at(d, s + 10)) {
            return false;
        }
        let rs = off16(d, s, s + 12 + (2 * k));
        if rs == 0 {
            return false;
        }
        for i in @as(usize, 0)..@as(usize, u16at(d, rs)) {
            let r = off16(d, rs, rs + 2 + (2 * i));
            if (r != 0) and chain_rule(c, r, MF_CLASS, bcd, icd, lcd) {
                return true;
            }
        }
        return false;
    }
    if fmt == 3 {
        let nb = @as(usize, u16at(d, s + 2));
        let pi = s + 4 + (2 * nb);
        let ni = @as(usize, u16at(d, pi));
        if (ni == 0) or (ni > MAX_CONTEXT) {
            return false;
        }
        if coverage(d, off16(d, s, pi + 2), g) == NOT_COVERED {
            return false;
        }
        let pl = pi + 2 + (2 * ni);
        let nl = @as(usize, u16at(d, pl));
        let pr = pl + 2 + (2 * nl);
        let nrec = @as(usize, u16at(d, pr));
        let mut mp: [64]u32 = [0; 64];
        let mut end: usize = 0;
        let mut tc: u32 = 0;
        if not match_input(c, ni, pi + 4, MF_COVERAGE, s, &mut mp, &mut end, &mut tc) {
            return false;
        }
        if not match_lookahead(c, nl, pl + 2, MF_COVERAGE, s, end) {
            return false;
        }
        if not match_backtrack(c, nb, s + 4, MF_COVERAGE, s) {
            return false;
        }
        apply_lookup(c, ni, &mut mp, nrec, pr + 2, end);
        return true;
    }
    return false;
}

// -----------------------------------------------------------------------------
// GSUB
// -----------------------------------------------------------------------------

fn single_subst(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let g = c.b.info[c.b.idx].cp;
    let ci = coverage(d, off16(d, s, s + 2), g);
    if ci == NOT_COVERED {
        return false;
    }
    let fmt = u16at(d, s);
    if fmt == 1 {
        let delta = u16at(d, s + 4);
        replace_glyph(c, (g + delta) & 0xffff);
        return true;
    }
    if fmt == 2 {
        let k = us(ci);
        if k >= @as(usize, u16at(d, s + 4)) {
            return false;
        }
        replace_glyph(c, u16at(d, s + 6 + (2 * k)));
        return true;
    }
    return false;
}

fn multiple_subst(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let b = c.b;
    if u16at(d, s) != 1 {
        return false;
    }
    let ci = coverage(d, off16(d, s, s + 2), b.info[b.idx].cp);
    if ci == NOT_COVERED {
        return false;
    }
    let k = us(ci);
    if k >= @as(usize, u16at(d, s + 4)) {
        return false;
    }
    let q = off16(d, s, s + 6 + (2 * k));
    let count = @as(usize, u16at(d, q));
    if q == 0 {
        return false;
    }
    if count == 1 {
        replace_glyph(c, u16at(d, q + 2));
        return true;
    }
    if count == 0 {
        b.delete_glyph();
        return true;
    }
    let mut klass: u16 = 0;
    if is_ligature(&b.info[b.idx]) {
        klass = buf.GP_BASE_GLYPH;
    }
    let id = lig_id(&b.info[b.idx]);
    for i in @as(usize, 0)..count {
        if id == 0 {
            set_lig_props_for_mark(b.cur(), 0, @truncate(u32, i));
        }
        let g = u16at(d, q + 2 + (2 * i));
        set_glyph_class(c, g, klass, false, true);
        _ = b.output_glyph(g);
    }
    b.skip_glyph();
    return true;
}

fn alternate_subst(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let b = c.b;
    if u16at(d, s) != 1 {
        return false;
    }
    let ci = coverage(d, off16(d, s, s + 2), b.info[b.idx].cp);
    if ci == NOT_COVERED {
        return false;
    }
    let k = us(ci);
    if k >= @as(usize, u16at(d, s + 4)) {
        return false;
    }
    let a = off16(d, s, s + 6 + (2 * k));
    let count = u16at(d, a);
    if (a == 0) or (count == 0) {
        return false;
    }
    let lm = c.lookup_mask;
    let shift = @ctz(lm);
    let mut alt = (lm & b.info[b.idx].mask) >> shift;
    if (alt == 255) and c.random {
        c.random_state = @truncate(u32, (@as(u64, c.random_state) * 48271) % 2147483647);
        alt = (c.random_state % count) + 1;
    }
    if (alt > count) or (alt == 0) {
        return false;
    }
    replace_glyph(c, u16at(d, a + 2 + (2 * @as(usize, alt - 1))));
    return true;
}

fn ligature_subst(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let b = c.b;
    if u16at(d, s) != 1 {
        return false;
    }
    let ci = coverage(d, off16(d, s, s + 2), b.info[b.idx].cp);
    if ci == NOT_COVERED {
        return false;
    }
    let k = us(ci);
    if k >= @as(usize, u16at(d, s + 4)) {
        return false;
    }
    let set = off16(d, s, s + 6 + (2 * k));
    if set == 0 {
        return false;
    }
    for i in @as(usize, 0)..@as(usize, u16at(d, set)) {
        let l = off16(d, set, set + 2 + (2 * i));
        if l == 0 {
            continue;
        }
        let lig_glyph = u16at(d, l);
        let count = @as(usize, u16at(d, l + 2));
        if count == 0 {
            continue;
        }
        if count == 1 {
            replace_glyph(c, lig_glyph);
            return true;
        }
        if count > MAX_CONTEXT {
            continue;
        }
        let mut mp: [64]u32 = [0; 64];
        let mut end: usize = 0;
        let mut total: u32 = 0;
        if not match_input(c, count, l + 4, MF_GLYPH, 0, &mut mp, &mut end, &mut total) {
            continue;
        }
        ligate_input(c, count, &mut mp, end, lig_glyph, total);
        return true;
    }
    return false;
}

fn reverse_chain_subst(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let b = c.b;
    if u16at(d, s) != 1 {
        return false;
    }
    let ci = coverage(d, off16(d, s, s + 2), b.info[b.idx].cp);
    if ci == NOT_COVERED {
        return false;
    }
    if c.nesting_left != MAX_NESTING {
        return false;
    }
    let nb = @as(usize, u16at(d, s + 4));
    let pl = s + 6 + (2 * nb);
    let nl = @as(usize, u16at(d, pl));
    let ps = pl + 2 + (2 * nl);
    let k = us(ci);
    if k >= @as(usize, u16at(d, ps)) {
        return false;
    }
    if match_backtrack(c, nb, s + 6, MF_COVERAGE, s) and match_lookahead(c, nl, pl + 2, MF_COVERAGE, s, b.idx + 1) {
        replace_glyph_inplace(c, u16at(d, ps + 2 + (2 * k)));
        return true;
    }
    return false;
}

// -----------------------------------------------------------------------------
// GPOS
// -----------------------------------------------------------------------------

fn value_len(f: u32) usize {
    return @as(usize, @popcount(f & 0xff));
}

/// Applies the value record v (format f) to p.
fn apply_value(d: []u8, f: u32, v0: usize, p: *mut buf.Pos) void {
    let mut v = v0;
    if (f & 1) != 0 {
        p.xo = buf.sat_add(p.xo, i16at(d, v));
        v += 2;
    }
    if (f & 2) != 0 {
        p.yo = buf.sat_add(p.yo, i16at(d, v));
        v += 2;
    }
    if (f & 4) != 0 {
        p.xa = buf.sat_add(p.xa, i16at(d, v));
    }
}

fn single_pos(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let b = c.b;
    let ci = coverage(d, off16(d, s, s + 2), b.info[b.idx].cp);
    if ci == NOT_COVERED {
        return false;
    }
    let fmt = u16at(d, s);
    let vf = u16at(d, s + 4);
    if fmt == 1 {
        apply_value(d, vf, s + 6, &mut b.pos[b.idx]);
    } else if fmt == 2 {
        let k = us(ci);
        if k >= @as(usize, u16at(d, s + 6)) {
            return false;
        }
        apply_value(d, vf, s + 8 + (k * 2 * value_len(vf)), &mut b.pos[b.idx]);
    } else {
        return false;
    }
    b.idx += 1;
    return true;
}

fn pair_pos(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let b = c.b;
    let fmt = u16at(d, s);
    if (fmt != 1) and (fmt != 2) {
        return false;
    }
    let ci = coverage(d, off16(d, s, s + 2), b.info[b.idx].cp);
    if ci == NOT_COVERED {
        return false;
    }
    c.iter_input.idx = b.idx;
    if not iter_next(c, &mut c.iter_input) {
        return false;
    }
    let second = c.iter_input.idx;
    let vf1 = u16at(d, s + 4);
    let vf2 = u16at(d, s + 6);
    let len1 = value_len(vf1);
    let len2 = value_len(vf2);
    if fmt == 1 {
        let k = us(ci);
        if k >= @as(usize, u16at(d, s + 8)) {
            return false;
        }
        let set = off16(d, s, s + 10 + (2 * k));
        if set == 0 {
            return false;
        }
        let n = @as(usize, u16at(d, set));
        let rec_size = 2 + (2 * (len1 + len2));
        let g2 = b.info[second].cp;
        let mut lo: usize = 0;
        let mut hi = n;
        while lo < hi {
            let mid = (lo + hi) / 2;
            let r = set + 2 + (mid * rec_size);
            let v = u16at(d, r);
            if v < g2 {
                lo = mid + 1;
            } else if v > g2 {
                hi = mid;
            } else {
                if len1 > 0 {
                    apply_value(d, vf1, r + 2, &mut b.pos[b.idx]);
                }
                if len2 > 0 {
                    apply_value(d, vf2, r + 2 + (2 * len1), &mut b.pos[second]);
                }
                let mut p = second;
                if len2 > 0 {
                    p += 1;
                }
                b.idx = p;
                return true;
            }
        }
        return false;
    }
    let cd1 = off16(d, s, s + 8);
    let cd2 = off16(d, s, s + 10);
    let n1 = u16at(d, s + 12);
    let n2 = u16at(d, s + 14);
    let k1 = class_of(d, cd1, b.info[b.idx].cp);
    let k2 = class_of(d, cd2, b.info[second].cp);
    if (k1 >= n1) or (k2 >= n2) {
        return false;
    }
    let rec = s + 16 + (2 * (len1 + len2) * @as(usize, (k1 * n2) + k2));
    if len1 > 0 {
        apply_value(d, vf1, rec, &mut b.pos[b.idx]);
    }
    if len2 > 0 {
        apply_value(d, vf2, rec + (2 * len1), &mut b.pos[second]);
    }
    let mut p = second;
    if len2 > 0 {
        p += 1;
    }
    b.idx = p;
    return true;
}

/// The anchor at a: [x, y] (device and contour-point adjustments do not
/// apply at font-unit scale).
fn anchor(d: []u8, a: usize) [2]i32 {
    let f = u16at(d, a);
    if (f < 1) or (f > 3) {
        return [0, 0];
    }
    return [i16at(d, a + 2), i16at(d, a + 4)];
}

fn reverse_cursive_minor_offset(pos: []mut buf.Pos, len: usize, i: usize, new_parent: usize, level: u32) void {
    if level > MAX_NESTING {
        return;
    }
    let chain = pos[i].chain;
    let typ = pos[i].atype;
    if (chain == 0) or ((typ & buf.ATTACH_CURSIVE) == 0) {
        return;
    }
    pos[i].chain = 0;
    let j64 = sz(i) + @as(i64, chain);
    if (j64 < 0) or (j64 >= sz(len)) {
        return;
    }
    let j = us(j64);
    if j == new_parent {
        return;
    }
    reverse_cursive_minor_offset(pos, len, j, new_parent, level + 1);
    pos[j].yo = -@max(pos[i].yo, -0x7fffffff);
    pos[j].chain = -chain;
    pos[j].atype = typ;
}

fn cursive_pos(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let b = c.b;
    if u16at(d, s) != 1 {
        return false;
    }
    let cov = off16(d, s, s + 2);
    let n = u16at(d, s + 4);
    let ci = coverage(d, cov, b.info[b.idx].cp);
    if (ci == NOT_COVERED) or (ci >= @as(i64, n)) {
        return false;
    }
    let entry = off16(d, s, s + 6 + (4 * us(ci)));
    if entry == 0 {
        return false;
    }
    c.iter_input.idx = b.idx;
    if not iter_prev(c, &mut c.iter_input) {
        return false;
    }
    let i = c.iter_input.idx;
    let pci = coverage(d, cov, b.info[i].cp);
    if (pci == NOT_COVERED) or (pci >= @as(i64, n)) {
        return false;
    }
    let exit = off16(d, s, s + 8 + (4 * us(pci)));
    if exit == 0 {
        return false;
    }
    let j = b.idx;
    let ex = anchor(d, exit);
    let en = anchor(d, entry);
    let pos = b.pos;
    if not c.rtl {
        pos[i].xa = buf.sat_add(ex[0], pos[i].xo);
        let dd = buf.sat_add(en[0], pos[j].xo);
        pos[j].xa = buf.sat_sub(pos[j].xa, dd);
        pos[j].xo = buf.sat_sub(pos[j].xo, dd);
    } else {
        let dd = buf.sat_add(ex[0], pos[i].xo);
        pos[i].xa = buf.sat_sub(pos[i].xa, dd);
        pos[i].xo = buf.sat_sub(pos[i].xo, dd);
        pos[j].xa = buf.sat_add(en[0], pos[j].xo);
    }
    let mut child = i;
    let mut parent = j;
    let mut y_offset = en[1] - ex[1];
    if (c.lookup_props & LF_RIGHT_TO_LEFT) == 0 {
        let k = child;
        child = parent;
        parent = k;
        y_offset = -y_offset;
    }
    reverse_cursive_minor_offset(pos, b.len, child, parent, 0);
    pos[child].chain = @truncate(i32, sz(parent) - sz(child));
    pos[child].atype = buf.ATTACH_CURSIVE;
    b.scratch |= buf.SF_HAS_GPOS_ATTACHMENT;
    pos[child].yo = y_offset;
    if pos[parent].chain == -pos[child].chain {
        pos[parent].chain = 0;
        pos[parent].yo = 0;
    }
    b.idx += 1;
    return true;
}

fn resolve_cross_offset(pos: []buf.Pos, len: usize, gp0: usize) i32 {
    let mut gp = gp0;
    let mut off = pos[gp].yo;
    let mut guard: u32 = 0;
    while (pos[gp].atype & buf.ATTACH_CURSIVE) != 0 {
        let chain = pos[gp].chain;
        if chain == 0 {
            break;
        }
        let p = sz(gp) + @as(i64, chain);
        if (p < 0) or (p >= sz(len)) {
            break;
        }
        gp = us(p);
        off = buf.sat_add(off, pos[gp].yo);
        guard += 1;
        if guard > 1000000 {
            break;
        }
    }
    return off;
}

/// Attaches the current mark (mark_index in the mark array ma) to the glyph
/// at glyph_pos, using row glyph_index of the anchor matrix am.
fn mark_array_apply(c: *mut Ctx, ma: usize, mark_index: usize, glyph_index: usize, am: usize, class_count: usize,
                    glyph_pos: usize) bool {
    let d = c.f.d;
    let b = c.b;
    if mark_index >= @as(usize, u16at(d, ma)) {
        return false;
    }
    let rec = ma + 2 + (4 * mark_index);
    let mark_class = @as(usize, u16at(d, rec));
    let mark_anchor = off16(d, ma, rec + 2);
    let rows = @as(usize, u16at(d, am));
    if (glyph_index >= rows) or (mark_class >= class_count) {
        return false;
    }
    let ga = off16(d, am, am + 2 + (2 * ((glyph_index * class_count) + mark_class)));
    if ga == 0 {
        return false;
    }
    let m = anchor(d, mark_anchor);
    let g = anchor(d, ga);
    let base_offset = resolve_cross_offset(b.pos, b.len, glyph_pos);
    let p = &mut b.pos[b.idx];
    p.chain = @truncate(i32, sz(glyph_pos) - sz(b.idx));
    p.atype = buf.ATTACH_MARK;
    p.xo = g[0] - m[0];
    p.yo = buf.sat_add(g[1] - m[1], base_offset);
    b.scratch |= buf.SF_HAS_GPOS_ATTACHMENT;
    b.idx += 1;
    return true;
}

fn accept_base(b: *buf.Buffer, idx: usize) bool {
    let i = &b.info[idx];
    if not multiplied(i) or (lig_comp(i) == 0) or (idx == 0) {
        return true;
    }
    let p = &b.info[idx - 1];
    return is_mark(p) or not multiplied(p) or (lig_id(i) != lig_id(p)) or (lig_comp(i) != (lig_comp(p) + 1));
}

fn accept_lig(b: *buf.Buffer, idx: usize) bool {
    let i = &b.info[idx];
    return not multiplied(i) or (lig_comp(i) == 0);
}

/// Finds the base for a mark (MarkBase and MarkLig); -1 if none.
fn find_base(c: *mut Ctx, cov: usize, lig: bool) i64 {
    let b = c.b;
    let d = c.f.d;
    c.iter_input.lookup_props = LF_IGNORE_MARKS;
    if c.last_base_until > b.idx {
        c.last_base_until = 0;
        c.last_base = -1;
    }
    let mut j = b.idx;
    while j > c.last_base_until {
        let mut m = iter_match(c, &c.iter_input, &b.info[j - 1]);
        if m == MATCH {
            let acc = if_lig_accept(b, j - 1, lig);
            if not acc and (coverage(d, cov, b.info[j - 1].cp) == NOT_COVERED) {
                m = SKIP;
            }
        }
        if m == MATCH {
            c.last_base = sz(j - 1);
            break;
        }
        j -= 1;
    }
    c.last_base_until = b.idx;
    return c.last_base;
}

fn if_lig_accept(b: *buf.Buffer, idx: usize, lig: bool) bool {
    if lig {
        return accept_lig(b, idx);
    }
    return accept_base(b, idx);
}

fn mark_base_pos(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let b = c.b;
    if u16at(d, s) != 1 {
        return false;
    }
    let mi = coverage(d, off16(d, s, s + 2), b.info[b.idx].cp);
    if mi == NOT_COVERED {
        return false;
    }
    let base_cov = off16(d, s, s + 4);
    let lb = find_base(c, base_cov, false);
    if lb < 0 {
        return false;
    }
    let idx = us(lb);
    let bi = coverage(d, base_cov, b.info[idx].cp);
    if bi == NOT_COVERED {
        return false;
    }
    return mark_array_apply(c, off16(d, s, s + 8), us(mi), us(bi), off16(d, s, s + 10), @as(usize, u16at(d, s + 6)),
                            idx);
}

fn mark_lig_pos(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let b = c.b;
    if u16at(d, s) != 1 {
        return false;
    }
    let mi = coverage(d, off16(d, s, s + 2), b.info[b.idx].cp);
    if mi == NOT_COVERED {
        return false;
    }
    let lig_cov = off16(d, s, s + 4);
    let lb = find_base(c, lig_cov, true);
    if lb < 0 {
        return false;
    }
    let idx = us(lb);
    let li = coverage(d, lig_cov, b.info[idx].cp);
    if li == NOT_COVERED {
        return false;
    }
    let la = off16(d, s, s + 10);
    let lk = us(li);
    if lk >= @as(usize, u16at(d, la)) {
        return false;
    }
    let attach = off16(d, la, la + 2 + (2 * lk));
    if attach == 0 {
        return false;
    }
    let comp_count = u16at(d, attach);
    if comp_count == 0 {
        return false;
    }
    let lid = lig_id(&b.info[idx]);
    let mid = lig_id(&b.info[b.idx]);
    let mcomp = lig_comp(&b.info[b.idx]);
    let mut comp_index = comp_count - 1;
    if (lid != 0) and (lid == mid) and (mcomp > 0) {
        comp_index = @min(comp_count, mcomp) - 1;
    }
    return mark_array_apply(c, off16(d, s, s + 8), us(mi), @as(usize, comp_index), attach, @as(usize, u16at(d, s + 6)),
                            idx);
}

fn mark_mark_pos(c: *mut Ctx, s: usize) bool {
    let d = c.f.d;
    let b = c.b;
    if u16at(d, s) != 1 {
        return false;
    }
    let mi = coverage(d, off16(d, s, s + 2), b.info[b.idx].cp);
    if mi == NOT_COVERED {
        return false;
    }
    c.iter_input.idx = b.idx;
    c.iter_input.lookup_props = c.lookup_props & ~LF_IGNORE_FLAGS;
    if not iter_prev(c, &mut c.iter_input) {
        return false;
    }
    let j = c.iter_input.idx;
    if not is_mark(&b.info[j]) {
        return false;
    }
    let id1 = lig_id(&b.info[b.idx]);
    let id2 = lig_id(&b.info[j]);
    let comp1 = lig_comp(&b.info[b.idx]);
    let comp2 = lig_comp(&b.info[j]);
    let mut good = false;
    if id1 == id2 {
        good = (id1 == 0) or (comp1 == comp2);
    } else {
        good = ((id1 > 0) and (comp1 == 0)) or ((id2 > 0) and (comp2 == 0));
    }
    if not good {
        return false;
    }
    let m2 = coverage(d, off16(d, s, s + 4), b.info[j].cp);
    if m2 == NOT_COVERED {
        return false;
    }
    return mark_array_apply(c, off16(d, s, s + 8), us(mi), us(m2), off16(d, s, s + 10), @as(usize, u16at(d, s + 6)), j);
}

// -----------------------------------------------------------------------------
// Applying lookups
// -----------------------------------------------------------------------------

/// The type and subtable of a lookup subtable, resolving extensions.
fn resolve(c: *Ctx, typ0: u32, s0: usize) [2]usize {
    return resolve_in(c.f, c.table, typ0, s0);
}

fn resolve_in(f: *Face, table: usize, typ0: u32, s0: usize) [2]usize {
    let d = f.d;
    let ext: u32 = if_table(table, 7, 9);
    if typ0 == ext {
        if (s0 == 0) or (u16at(d, s0) != 1) {
            return [0, 0];
        }
        let t = u16at(d, s0 + 2);
        let o = u32at(d, s0 + 4);
        if (t == ext) or (o == 0) {
            return [0, 0];
        }
        return [@as(usize, t), s0 + @as(usize, o)];
    }
    return [@as(usize, typ0), s0];
}

fn if_table(t: usize, gsub: u32, gpos: u32) u32 {
    if t == 0 {
        return gsub;
    }
    return gpos;
}

fn apply_subtable(c: *mut Ctx, typ: usize, s: usize) bool {
    if s == 0 {
        return false;
    }
    if c.table == 0 {
        if typ == 1 {
            return single_subst(c, s);
        }
        if typ == 2 {
            return multiple_subst(c, s);
        }
        if typ == 3 {
            return alternate_subst(c, s);
        }
        if typ == 4 {
            return ligature_subst(c, s);
        }
        if typ == 5 {
            return context(c, s);
        }
        if typ == 6 {
            return chain_context(c, s);
        }
        if typ == 8 {
            return reverse_chain_subst(c, s);
        }
        return false;
    }
    if typ == 1 {
        return single_pos(c, s);
    }
    if typ == 2 {
        return pair_pos(c, s);
    }
    if typ == 3 {
        return cursive_pos(c, s);
    }
    if typ == 4 {
        return mark_base_pos(c, s);
    }
    if typ == 5 {
        return mark_lig_pos(c, s);
    }
    if typ == 6 {
        return mark_mark_pos(c, s);
    }
    if typ == 7 {
        return context(c, s);
    }
    if typ == 8 {
        return chain_context(c, s);
    }
    return false;
}

/// Tries the lookup's subtables at the current glyph; true when one applies.
fn apply_lookup_subtables(c: *mut Ctx, l: usize) bool {
    let d = c.f.d;
    let typ = u16at(d, l);
    let n = @as(usize, u16at(d, l + 4));
    for i in @as(usize, 0)..n {
        let s = off16(d, l, l + 6 + (2 * i));
        let r = resolve(c, typ, s);
        if apply_subtable(c, r[0], r[1]) {
            return true;
        }
    }
    return false;
}

fn is_reverse(c: *Ctx, l: usize) bool {
    let d = c.f.d;
    let typ = u16at(d, l);
    if c.table != 0 {
        return false;
    }
    if typ == 7 {
        let r = resolve(c, typ, off16(d, l, l + 6));
        return r[0] == 8;
    }
    return typ == 8;
}

/// A face for lookups synthesized in memory (a LookupList at offset 2 of
/// data), with the font's glyph classes.
pub fn synthetic_face(f: *Face, data: []u8) Face {
    let mut s = f.*;
    s.d = data;
    s.gsub = 0;
    s.gpos = 0;
    s.script_list = [0, 0];
    s.feature_list = [0, 0];
    s.lookup_list = [2, 0];
    s.lookup_count = [u16at(data, 2), 0];
    return s;
}

/// Applies lookup lookup_index to the whole buffer (HarfBuzz's apply_string).
pub fn apply_string(c: *mut Ctx, lookup_index: u32, dg: *Digest) void {
    let b = c.b;
    if (b.len == 0) or (c.lookup_mask == 0) {
        return;
    }
    let l = lookup_at(c.f, c.table, lookup_index);
    if l == 0 {
        return;
    }
    c.lookup_index = lookup_index;
    set_lookup_props(c, lookup_props(c.f, l));
    if not is_reverse(c, l) {
        if c.table == 0 {
            b.clear_output();
        }
        b.idx = 0;
        while b.successful {
            let mut j = b.idx;
            while (j < b.len) and
                  not (digest_has(dg, b.info[j].cp) and ((b.info[j].mask & c.lookup_mask) != 0) and
                       check_glyph_property(c, &b.info[j], c.lookup_props)) {
                j += 1;
            }
            if (j > b.idx) and not b.next_glyphs(j - b.idx) {
                break;
            }
            if b.idx >= b.len {
                break;
            }
            if not apply_lookup_subtables(c, l) {
                _ = b.next_glyph();
            }
        }
        if c.table == 0 {
            _ = b.sync();
        }
    } else {
        b.idx = b.len - 1;
        loop {
            let cur = &b.info[b.idx];
            if digest_has(dg, cur.cp) and ((cur.mask & c.lookup_mask) != 0) and
               check_glyph_property(c, cur, c.lookup_props) {
                _ = apply_lookup_subtables(c, l);
            }
            if b.idx == 0 {
                break;
            }
            b.idx -= 1;
        }
        b.idx = 0;
    }
}

/// Prepares a context for iterating by hand (kerning from the kern table):
/// glyphs need mask, and the lookup flags props say which to skip.
pub fn prepare(c: *mut Ctx, mask: u32, props: u32) void {
    set_lookup(c, mask, true, true, false, false);
    set_lookup_props(c, props);
}

/// The next glyph after idx that the context does not skip: [1, index], or
/// [0, where to continue] if there is none.
pub fn next_unskipped(c: *mut Ctx, idx: usize) [2]usize {
    c.iter_input.idx = idx;
    c.iter_input.end = c.b.len;
    if iter_next(c, &mut c.iter_input) {
        return [1, c.iter_input.idx];
    }
    return [0, c.iter_input.idx + 1];
}

pub fn set_lookup(c: *mut Ctx, mask: u32, auto_zwnj: bool, auto_zwj: bool, random: bool, per_syllable: bool) void {
    c.lookup_mask = mask;
    c.last_base = -1;
    c.last_base_until = 0;
    c.auto_zwnj = auto_zwnj;
    c.auto_zwj = auto_zwj;
    c.random = random;
    c.per_syllable = per_syllable;
}

// -----------------------------------------------------------------------------
// GPOS finishing: attachment offsets
// -----------------------------------------------------------------------------

fn propagate_attachment_offsets(pos: []mut buf.Pos, len: usize, i: usize, rtl: bool, level: u32) void {
    let chain = pos[i].chain;
    let typ = pos[i].atype;
    pos[i].chain = 0;
    let j64 = sz(i) + @as(i64, chain);
    if (j64 < 0) or (j64 >= sz(len)) {
        return;
    }
    if level == 0 {
        return;
    }
    let j = us(j64);
    if pos[j].chain != 0 {
        propagate_attachment_offsets(pos, len, j, rtl, level - 1);
    }
    if (typ & buf.ATTACH_CURSIVE) != 0 {
        pos[i].yo = buf.sat_add(pos[i].yo, pos[j].yo);
        return;
    }
    pos[i].xo = buf.sat_add(pos[i].xo, pos[j].xo);
    if j < i {
        if not rtl {
            for k in j..i {
                pos[i].xo = buf.sat_sub(pos[i].xo, pos[k].xa);
                pos[i].yo = buf.sat_sub(pos[i].yo, pos[k].ya);
            }
        } else {
            for k in (j + 1)..(i + 1) {
                pos[i].xo = buf.sat_add(pos[i].xo, pos[k].xa);
                pos[i].yo = buf.sat_add(pos[i].yo, pos[k].ya);
            }
        }
    } else {
        if not rtl {
            for k in i..j {
                pos[i].xo = buf.sat_add(pos[i].xo, pos[k].xa);
                pos[i].yo = buf.sat_add(pos[i].yo, pos[k].ya);
            }
        } else {
            for k in (i + 1)..(j + 1) {
                pos[i].xo = buf.sat_sub(pos[i].xo, pos[k].xa);
                pos[i].yo = buf.sat_sub(pos[i].yo, pos[k].ya);
            }
        }
    }
}

pub fn position_start(b: *mut buf.Buffer) void {
    for i in @as(usize, 0)..b.len {
        b.pos[i].chain = 0;
        b.pos[i].atype = 0;
    }
}

pub fn position_finish_offsets(b: *mut buf.Buffer) void {
    if (b.scratch & buf.SF_HAS_GPOS_ATTACHMENT) == 0 {
        return;
    }
    if not b.rtl {
        for i in @as(usize, 0)..b.len {
            if b.pos[i].chain != 0 {
                propagate_attachment_offsets(b.pos, b.len, i, false, MAX_NESTING);
            }
        }
    } else {
        let mut i = b.len;
        while i > 0 {
            i -= 1;
            if b.pos[i].chain != 0 {
                propagate_attachment_offsets(b.pos, b.len, i, true, MAX_NESTING);
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Scripts, languages and features
// -----------------------------------------------------------------------------

pub const NO_INDEX: u32 = 0xffff;

pub fn tag_of(s: []u8) u32 {
    let mut t: u32 = 0;
    for i in @as(usize, 0)..4 {
        let mut ch: u32 = 0x20;
        if i < s.len {
            ch = @as(u32, s[i]);
        }
        t = (t << 8) | ch;
    }
    return t;
}

/// The index of script tag t in table ti's script list, or NO_INDEX.
fn find_script(f: *Face, ti: usize, t: u32) u32 {
    let sl = f.script_list[ti];
    if sl == 0 {
        return NO_INDEX;
    }
    let n = u16at(f.d, sl);
    for i in @as(u32, 0)..n {
        if u32at(f.d, sl + 2 + (6 * @as(usize, i))) == t {
            return i;
        }
    }
    return NO_INDEX;
}

fn script_table(f: *Face, ti: usize, si: u32) usize {
    let sl = f.script_list[ti];
    if (sl == 0) or (si == NO_INDEX) or (si >= u16at(f.d, sl)) {
        return 0;
    }
    return off16(f.d, sl, sl + 2 + (6 * @as(usize, si)) + 4);
}

fn find_lang_sys(f: *Face, s: usize, t: u32) u32 {
    if s == 0 {
        return NO_INDEX;
    }
    let n = u16at(f.d, s + 2);
    for i in @as(u32, 0)..n {
        if u32at(f.d, s + 4 + (6 * @as(usize, i))) == t {
            return i;
        }
    }
    return NO_INDEX;
}

/// The LangSys table (the script's default for NO_INDEX; 0 if none).
fn lang_sys(f: *Face, s: usize, li: u32) usize {
    if s == 0 {
        return 0;
    }
    if (li == NO_INDEX) or (li >= u16at(f.d, s + 2)) {
        return off16(f.d, s, s);
    }
    return off16(f.d, s, s + 4 + (6 * @as(usize, li)) + 4);
}

fn feature_tag(f: *Face, ti: usize, fi: u32) u32 {
    let fl = f.feature_list[ti];
    if (fl == 0) or (fi >= u16at(f.d, fl)) {
        return 0;
    }
    return u32at(f.d, fl + 2 + (6 * @as(usize, fi)));
}

fn feature_table(f: *Face, ti: usize, fi: u32) usize {
    let fl = f.feature_list[ti];
    if (fl == 0) or (fi >= u16at(f.d, fl)) {
        return 0;
    }
    return off16(f.d, fl, fl + 2 + (6 * @as(usize, fi)) + 4);
}

/// The feature index of tag in a LangSys (the first listed), or NO_INDEX.
fn langsys_find_feature(f: *Face, ti: usize, ls: usize, t: u32) u32 {
    if ls == 0 {
        return NO_INDEX;
    }
    let n = @as(usize, u16at(f.d, ls + 4));
    for i in @as(usize, 0)..n {
        let fi = u16at(f.d, ls + 6 + (2 * i));
        if feature_tag(f, ti, fi) == t {
            return fi;
        }
    }
    return NO_INDEX;
}

fn table_find_feature(f: *Face, ti: usize, t: u32) u32 {
    let fl = f.feature_list[ti];
    if fl == 0 {
        return NO_INDEX;
    }
    for i in @as(u32, 0)..u16at(f.d, fl) {
        if feature_tag(f, ti, i) == t {
            return i;
        }
    }
    return NO_INDEX;
}

// Feature flags
pub const F_GLOBAL: u32 = 0x01;
pub const F_HAS_FALLBACK: u32 = 0x02;
pub const F_MANUAL_ZWNJ: u32 = 0x04;
pub const F_MANUAL_ZWJ: u32 = 0x08;
pub const F_MANUAL_JOINERS: u32 = 0x0c;
pub const F_GLOBAL_MANUAL_JOINERS: u32 = 0x0d;
pub const F_GLOBAL_HAS_FALLBACK: u32 = 0x03;
pub const F_GLOBAL_SEARCH: u32 = 0x10;
pub const F_RANDOM: u32 = 0x20;
pub const F_PER_SYLLABLE: u32 = 0x40;

struct FeatureInfo {
    tag: u32,
    seq: u32,
    max_value: u32,
    flags: u32,
    default_value: u32,
    stage: [2]u32,
}

pub struct FeatureMap {
    tag: u32,
    index: [2]u32,
    stage: [2]u32,
    shift: u32,
    mask: u32,
    one_mask: u32,
    auto_zwnj: bool,
    auto_zwj: bool,
    random: bool,
    per_syllable: bool,
    needs_fallback: bool,
}

pub struct LookupMap {
    index: u32,
    mask: u32,
    digest: Digest,
    auto_zwnj: bool,
    auto_zwj: bool,
    random: bool,
    per_syllable: bool,
}

pub struct StageMap {
    last_lookup: usize,
    pause: u8,
}

struct StageInfo {
    index: u32,
    pause: u8,
}

/// Which lookups apply, in which order and to which glyphs.
pub struct Map {
    global_mask: u32,
    features: vec.Vec.[FeatureMap],
    lookups: [2]vec.Vec.[LookupMap],
    stages: [2]vec.Vec.[StageMap],
    chosen_script: [2]u32,
    found_script: [2]bool,

    pub fn deinit(self: *mut Map) void {
        self.features.deinit();
        for t in @as(usize, 0)..2 {
            self.lookups[t].deinit();
            self.stages[t].deinit();
        }
    }

    fn find(self: *Map, tag: u32) i64 {
        let fs = self.features.items();
        for i in @as(usize, 0)..fs.len {
            if fs[i].tag == tag {
                return sz(i);
            }
        }
        return -1;
    }

    pub fn get_mask(self: *Map, tag: u32) u32 {
        let i = self.find(tag);
        if i < 0 {
            return 0;
        }
        return self.features.get(us(i)).mask;
    }

    pub fn get_shift(self: *Map, tag: u32) u32 {
        let i = self.find(tag);
        if i < 0 {
            return 0;
        }
        return self.features.get(us(i)).shift;
    }

    pub fn get_1_mask(self: *Map, tag: u32) u32 {
        let i = self.find(tag);
        if i < 0 {
            return 0;
        }
        return self.features.get(us(i)).one_mask;
    }

    pub fn needs_fallback(self: *Map, tag: u32) bool {
        let i = self.find(tag);
        if i < 0 {
            return false;
        }
        return self.features.get(us(i)).needs_fallback;
    }

    /// The stage a feature's lookups run in (0xffffffff if it has none).
    pub fn feature_stage(self: *Map, ti: usize, tag: u32) u32 {
        let i = self.find(tag);
        if i < 0 {
            return 0xffffffff;
        }
        return self.features.get(us(i)).stage[ti];
    }

    /// The lookups of a stage, as a range [start, end) of lookups[ti].
    pub fn stage_lookups(self: *Map, ti: usize, stage: u32) [2]usize {
        let n = self.stages[ti].len;
        if @as(usize, stage) > n {
            return [0, 0];
        }
        let st = self.stages[ti].items();
        let mut start: usize = 0;
        if stage > 0 {
            start = st[@as(usize, stage) - 1].last_lookup;
        }
        let mut end = self.lookups[ti].len;
        if @as(usize, stage) < n {
            end = st[@as(usize, stage)].last_lookup;
        }
        return [start, end];
    }

    pub fn feature_index(self: *Map, ti: usize, tag: u32) u32 {
        let i = self.find(tag);
        if i < 0 {
            return NO_INDEX;
        }
        return self.features.get(us(i)).index[ti];
    }
}

pub fn empty_map() Map {
    return Map.{
        global_mask: 0,
        features: vec.Vec.[FeatureMap].init(),
        lookups: [vec.Vec.[LookupMap].init(), vec.Vec.[LookupMap].init()],
        stages: [vec.Vec.[StageMap].init(), vec.Vec.[StageMap].init()],
        chosen_script: [0, 0],
        found_script: [false, false],
    };
}

pub struct MapBuilder {
    f: *Face,
    infos: vec.Vec.[FeatureInfo],
    stages: [2]vec.Vec.[StageInfo],
    current_stage: [2]u32,
    script_index: [2]u32,
    language_index: [2]u32,
    chosen_script: [2]u32,
    found_script: [2]bool,

    /// script_tags are tried in order (then DFLT, dflt, latn); language_tag
    /// (0 for none) selects a language system.
    pub fn init(f: *Face, script_tags: []u32, language_tag: u32) MapBuilder {
        let mut m = MapBuilder.{
            f: f,
            infos: vec.Vec.[FeatureInfo].init(),
            stages: [vec.Vec.[StageInfo].init(), vec.Vec.[StageInfo].init()],
            current_stage: [0, 0],
            script_index: [NO_INDEX, NO_INDEX],
            language_index: [NO_INDEX, NO_INDEX],
            chosen_script: [0, 0],
            found_script: [false, false],
        };
        for ti in @as(usize, 0)..2 {
            let mut done = false;
            for t in script_tags {
                let si = find_script(f, ti, t);
                if si != NO_INDEX {
                    m.script_index[ti] = si;
                    m.chosen_script[ti] = t;
                    m.found_script[ti] = true;
                    done = true;
                    break;
                }
            }
            if not done {
                let fallbacks: [3]u32 = [tag_of("DFLT"), tag_of("dflt"), tag_of("latn")];
                for t in fallbacks {
                    let si = find_script(f, ti, t);
                    if si != NO_INDEX {
                        m.script_index[ti] = si;
                        m.chosen_script[ti] = t;
                        break;
                    }
                }
            }
            let s = script_table(f, ti, m.script_index[ti]);
            let mut li = NO_INDEX;
            if language_tag != 0 {
                li = find_lang_sys(f, s, language_tag);
            }
            if li == NO_INDEX {
                li = find_lang_sys(f, s, tag_of("dflt"));
            }
            m.language_index[ti] = li;
        }
        return m;
    }

    pub fn deinit(self: *mut MapBuilder) void {
        self.infos.deinit();
        self.stages[0].deinit();
        self.stages[1].deinit();
    }

    fn lang(self: *MapBuilder, ti: usize) usize {
        return lang_sys(self.f, script_table(self.f, ti, self.script_index[ti]), self.language_index[ti]);
    }

    pub fn add_feature(self: *mut MapBuilder, tag: u32, flags: u32, value: u32) !void {
        if tag == 0 {
            return;
        }
        let mut dv: u32 = 0;
        if (flags & F_GLOBAL) != 0 {
            dv = value;
        }
        self.infos.push(FeatureInfo.{
            tag: tag,
            seq: @truncate(u32, self.infos.len + 1),
            max_value: value,
            flags: flags,
            default_value: dv,
            stage: self.current_stage,
        }) catch {
            return error.OutOfMemory;
        };
    }

    pub fn enable_feature(self: *mut MapBuilder, tag: u32, flags: u32) !void {
        self.add_feature(tag, flags | F_GLOBAL, 1)!;
    }

    pub fn has_feature(self: *MapBuilder, tag: u32) bool {
        for ti in @as(usize, 0)..2 {
            if langsys_find_feature(self.f, ti, self.lang(ti), tag) != NO_INDEX {
                return true;
            }
        }
        return false;
    }

    pub fn add_pause(self: *mut MapBuilder, ti: usize, pause: u8) !void {
        self.stages[ti].push(StageInfo.{ index: self.current_stage[ti], pause: pause }) catch {
            return error.OutOfMemory;
        };
        self.current_stage[ti] += 1;
    }

    pub fn add_gsub_pause(self: *mut MapBuilder, pause: u8) !void {
        self.add_pause(0, pause)!;
    }

    fn add_lookups(self: *MapBuilder, m: *mut Map, ti: usize, fi: u32, mask: u32, auto_zwnj: bool, auto_zwj: bool,
                   random: bool, per_syllable: bool) !void {
        let ft = feature_table(self.f, ti, fi);
        if ft == 0 {
            return;
        }
        let d = self.f.d;
        let n = @as(usize, u16at(d, ft + 2));
        for i in @as(usize, 0)..n {
            let li = u16at(d, ft + 4 + (2 * i));
            if li >= self.f.lookup_count[ti] {
                continue;
            }
            m.lookups[ti].push(LookupMap.{
                index: li,
                mask: mask,
                digest: digest_empty(),
                auto_zwnj: auto_zwnj,
                auto_zwj: auto_zwj,
                random: random,
                per_syllable: per_syllable,
            }) catch {
                return error.OutOfMemory;
            };
        }
    }

    pub fn compile(self: *mut MapBuilder) !Map {
        let mut m = empty_map();
        m.global_mask = 0x80000000;
        m.chosen_script = self.chosen_script;
        m.found_script = self.found_script;
        self.compile_into(&mut m) catch |e| {
            m.deinit();
            return e;
        };
        return m;
    }

    fn compile_into(self: *mut MapBuilder, m: *mut Map) !void {
        let global_shift: u32 = 31;
        let global_bit: u32 = 0x80000000;
        let mut req_index: [2]u32 = [NO_INDEX, NO_INDEX];
        let mut req_tag: [2]u32 = [0, 0];
        let mut req_stage: [2]u32 = [0, 0];
        for ti in @as(usize, 0)..2 {
            let ls = self.lang(ti);
            if ls != 0 {
                req_index[ti] = u16at(self.f.d, ls + 2);
                req_tag[ti] = feature_tag(self.f, ti, req_index[ti]);
            }
        }
        // sort by tag (then order of addition) and merge duplicates
        let fs = self.infos.items();
        vec.sort(fs, info_less);
        let mut j: usize = 0;
        if fs.len > 0 {
            for i in @as(usize, 1)..fs.len {
                if fs[i].tag != fs[j].tag {
                    j += 1;
                    fs[j] = fs[i];
                } else {
                    if (fs[i].flags & F_GLOBAL) != 0 {
                        fs[j].flags |= F_GLOBAL;
                        fs[j].max_value = fs[i].max_value;
                        fs[j].default_value = fs[i].default_value;
                    } else {
                        if (fs[j].flags & F_GLOBAL) != 0 {
                            fs[j].flags ^= F_GLOBAL;
                        }
                        fs[j].max_value = @max(fs[j].max_value, fs[i].max_value);
                    }
                    fs[j].flags |= fs[i].flags & F_HAS_FALLBACK;
                    fs[j].stage[0] = @min(fs[j].stage[0], fs[i].stage[0]);
                    fs[j].stage[1] = @min(fs[j].stage[1], fs[i].stage[1]);
                }
            }
            self.infos.truncate(j + 1);
        }
        let infos = self.infos.items();
        let mut next_bit: u32 = 4;
        for info in infos {
            let mut bits_needed: u32 = 0;
            if not (((info.flags & F_GLOBAL) != 0) and (info.max_value == 1)) {
                bits_needed = @min(8, 32 - @clz(info.max_value));
            }
            if (info.max_value == 0) or ((next_bit + bits_needed) >= global_shift) {
                continue;
            }
            let mut found = false;
            let mut fidx: [2]u32 = [NO_INDEX, NO_INDEX];
            for ti in @as(usize, 0)..2 {
                if req_tag[ti] == info.tag {
                    req_stage[ti] = info.stage[ti];
                }
                fidx[ti] = langsys_find_feature(self.f, ti, self.lang(ti), info.tag);
                if fidx[ti] != NO_INDEX {
                    found = true;
                }
            }
            if not found and ((info.flags & F_GLOBAL_SEARCH) != 0) {
                for ti in @as(usize, 0)..2 {
                    fidx[ti] = table_find_feature(self.f, ti, info.tag);
                    if fidx[ti] != NO_INDEX {
                        found = true;
                    }
                }
            }
            if not found and ((info.flags & F_HAS_FALLBACK) == 0) {
                continue;
            }
            let mut fm = FeatureMap.{
                tag: info.tag,
                index: fidx,
                stage: info.stage,
                shift: 0,
                mask: 0,
                one_mask: 0,
                auto_zwnj: (info.flags & F_MANUAL_ZWNJ) == 0,
                auto_zwj: (info.flags & F_MANUAL_ZWJ) == 0,
                random: (info.flags & F_RANDOM) != 0,
                per_syllable: (info.flags & F_PER_SYLLABLE) != 0,
                needs_fallback: not found,
            };
            if ((info.flags & F_GLOBAL) != 0) and (info.max_value == 1) {
                fm.shift = global_shift;
                fm.mask = global_bit;
            } else {
                fm.shift = next_bit;
                fm.mask = (@as(u32, 1) << (next_bit + bits_needed)) - (@as(u32, 1) << next_bit);
                next_bit += bits_needed;
                m.global_mask |= (info.default_value << fm.shift) & fm.mask;
            }
            fm.one_mask = (@as(u32, 1) << fm.shift) & fm.mask;
            m.features.push(fm) catch {
                return error.OutOfMemory;
            };
        }
        self.add_pause(0, 0)!;
        self.add_pause(1, 0)!;
        for ti in @as(usize, 0)..2 {
            let mut stage_index: usize = 0;
            let mut last_num: usize = 0;
            for stage in @as(u32, 0)..self.current_stage[ti] {
                if (req_index[ti] != NO_INDEX) and (req_stage[ti] == stage) {
                    self.add_lookups(m, ti, req_index[ti], global_bit, true, true, false, false)!;
                }
                let feats = m.features.items();
                for fm in feats {
                    if fm.stage[ti] == stage {
                        self.add_lookups(m, ti, fm.index[ti], fm.mask, fm.auto_zwnj, fm.auto_zwj, fm.random,
                                         fm.per_syllable)!;
                    }
                }
                let ls = m.lookups[ti].items();
                if (last_num + 1) < ls.len {
                    vec.sort(ls[last_num..], lookup_less);
                    let mut k = last_num;
                    for i in (k + 1)..ls.len {
                        if ls[i].index != ls[k].index {
                            k += 1;
                            ls[k] = ls[i];
                        } else {
                            ls[k].mask |= ls[i].mask;
                            ls[k].auto_zwnj = ls[k].auto_zwnj and ls[i].auto_zwnj;
                            ls[k].auto_zwj = ls[k].auto_zwj and ls[i].auto_zwj;
                        }
                    }
                    m.lookups[ti].truncate(k + 1);
                }
                last_num = m.lookups[ti].len;
                let st = self.stages[ti].items();
                if (stage_index < st.len) and (st[stage_index].index == stage) {
                    m.stages[ti].push(StageMap.{ last_lookup: last_num, pause: st[stage_index].pause }) catch {
                        return error.OutOfMemory;
                    };
                    stage_index += 1;
                }
            }
            let lms = m.lookups[ti].items();
            for k in @as(usize, 0)..lms.len {
                lms[k].digest = lookup_digest(self.f, ti, lms[k].index);
            }
        }
    }
}

fn info_less(a: FeatureInfo, b: FeatureInfo) bool {
    if a.tag != b.tag {
        return a.tag < b.tag;
    }
    return a.seq < b.seq;
}

fn lookup_less(a: LookupMap, b: LookupMap) bool {
    return a.index < b.index;
}

// -----------------------------------------------------------------------------
// Would a lookup substitute a glyph sequence? (The Indic shaper asks.)
// -----------------------------------------------------------------------------

/// The coverage table a subtable is keyed on (0 if none).
fn subtable_coverage(d: []u8, typ: usize, s: usize) usize {
    if s == 0 {
        return 0;
    }
    let fmt = u16at(d, s);
    if (typ == 5) and (fmt == 3) {
        return off16(d, s, s + 6);
    }
    if (typ == 6) and (fmt == 3) {
        let nb = @as(usize, u16at(d, s + 2));
        return off16(d, s, s + 4 + (2 * nb) + 2);
    }
    return off16(d, s, s + 2);
}

fn would_match_input(d: []u8, gs: []u32, count: usize, input: usize, mf: u8, mdata: usize) bool {
    if count != gs.len {
        return false;
    }
    for i in @as(usize, 1)..count {
        let v = u16at(d, input + (2 * (i - 1)));
        let mut ok = false;
        if mf == MF_GLYPH {
            ok = gs[i] == v;
        } else if mf == MF_CLASS {
            ok = class_of(d, mdata, gs[i]) == v;
        } else {
            ok = coverage(d, off_plus(mdata, v), gs[i]) != NOT_COVERED;
        }
        if not ok {
            return false;
        }
    }
    return true;
}

fn would_apply_subtable(d: []u8, typ: usize, s: usize, gs: []u32, zero_context: bool) bool {
    if s == 0 {
        return false;
    }
    let fmt = u16at(d, s);
    let g0 = gs[0];
    if (typ == 1) or (typ == 2) or (typ == 3) or (typ == 8) {
        return (gs.len == 1) and (coverage(d, off16(d, s, s + 2), g0) != NOT_COVERED);
    }
    if typ == 4 {
        let ci = coverage(d, off16(d, s, s + 2), g0);
        if (ci == NOT_COVERED) or (fmt != 1) {
            return false;
        }
        let k = us(ci);
        if k >= @as(usize, u16at(d, s + 4)) {
            return false;
        }
        let set = off16(d, s, s + 6 + (2 * k));
        if set == 0 {
            return false;
        }
        for i in @as(usize, 0)..@as(usize, u16at(d, set)) {
            let l = off16(d, set, set + 2 + (2 * i));
            if (l != 0) and would_match_input(d, gs, @as(usize, u16at(d, l + 2)), l + 4, MF_GLYPH, 0) {
                return true;
            }
        }
        return false;
    }
    if typ == 5 {
        if fmt == 3 {
            return would_match_input(d, gs, @as(usize, u16at(d, s + 2)), s + 8, MF_COVERAGE, s);
        }
        let mut rs: usize = 0;
        let mut mf = MF_GLYPH;
        let mut mdata: usize = 0;
        if fmt == 1 {
            let ci = coverage(d, off16(d, s, s + 2), g0);
            if (ci == NOT_COVERED) or (us(ci) >= @as(usize, u16at(d, s + 4))) {
                return false;
            }
            rs = off16(d, s, s + 6 + (2 * us(ci)));
        } else if fmt == 2 {
            mdata = off16(d, s, s + 4);
            mf = MF_CLASS;
            let k = @as(usize, class_of(d, mdata, g0));
            if k >= @as(usize, u16at(d, s + 6)) {
                return false;
            }
            rs = off16(d, s, s + 8 + (2 * k));
        }
        if rs == 0 {
            return false;
        }
        for i in @as(usize, 0)..@as(usize, u16at(d, rs)) {
            let r = off16(d, rs, rs + 2 + (2 * i));
            if (r != 0) and would_match_input(d, gs, @as(usize, u16at(d, r)), r + 4, mf, mdata) {
                return true;
            }
        }
        return false;
    }
    if typ == 6 {
        if fmt == 3 {
            let nb = @as(usize, u16at(d, s + 2));
            let pi = s + 4 + (2 * nb);
            let ni = @as(usize, u16at(d, pi));
            let nl = @as(usize, u16at(d, pi + 2 + (2 * ni)));
            if zero_context and ((nb != 0) or (nl != 0)) {
                return false;
            }
            return would_match_input(d, gs, ni, pi + 4, MF_COVERAGE, s);
        }
        let mut rs: usize = 0;
        let mut mf = MF_GLYPH;
        let mut mdata: usize = 0;
        if fmt == 1 {
            let ci = coverage(d, off16(d, s, s + 2), g0);
            if (ci == NOT_COVERED) or (us(ci) >= @as(usize, u16at(d, s + 4))) {
                return false;
            }
            rs = off16(d, s, s + 6 + (2 * us(ci)));
        } else if fmt == 2 {
            mdata = off16(d, s, s + 6);
            mf = MF_CLASS;
            let k = @as(usize, class_of(d, mdata, g0));
            if k >= @as(usize, u16at(d, s + 10)) {
                return false;
            }
            rs = off16(d, s, s + 12 + (2 * k));
        }
        if rs == 0 {
            return false;
        }
        for i in @as(usize, 0)..@as(usize, u16at(d, rs)) {
            let r = off16(d, rs, rs + 2 + (2 * i));
            if r == 0 {
                continue;
            }
            let nb = @as(usize, u16at(d, r));
            let pi = r + 2 + (2 * nb);
            let ni = @as(usize, u16at(d, pi));
            if ni == 0 {
                continue;
            }
            let nl = @as(usize, u16at(d, pi + 2 + (2 * (ni - 1))));
            if zero_context and ((nb != 0) or (nl != 0)) {
                continue;
            }
            if would_match_input(d, gs, ni, pi + 2, mf, mdata) {
                return true;
            }
        }
        return false;
    }
    return false;
}

/// Whether GSUB lookup li would substitute the glyphs gs (in isolation when
/// zero_context: rules with backtrack or lookahead do not count).
pub fn would_substitute(f: *Face, li: u32, gs: []u32, zero_context: bool) bool {
    if (gs.len == 0) or (li >= f.lookup_count[0]) {
        return false;
    }
    let d = f.d;
    let l = lookup_at(f, 0, li);
    if l == 0 {
        return false;
    }
    let typ = u16at(d, l);
    let n = @as(usize, u16at(d, l + 4));
    let c = Ctx.{
        f: f,
        b: @ptr_from_int(*mut buf.Buffer, 8),
        table: 0,
        lookup_mask: 0,
        lookup_index: 0,
        lookup_props: 0,
        nesting_left: 0,
        has_glyph_classes: false,
        auto_zwnj: false,
        auto_zwj: false,
        per_syllable: false,
        random: false,
        random_state: 0,
        last_base: 0,
        last_base_until: 0,
        rtl: false,
        iter_input: Iter.{
            idx: 0,
            end: 0,
            lookup_props: 0,
            mask: 0,
            ignore_zwnj: false,
            ignore_zwj: false,
            ignore_hidden: false,
            per_syllable: false,
            syllable: 0,
            mf: 0,
            mdata: 0,
            gd: 0,
            has_gd: false,
        },
        iter_context: Iter.{
            idx: 0,
            end: 0,
            lookup_props: 0,
            mask: 0,
            ignore_zwnj: false,
            ignore_zwj: false,
            ignore_hidden: false,
            per_syllable: false,
            syllable: 0,
            mf: 0,
            mdata: 0,
            gd: 0,
            has_gd: false,
        },
    };
    // the first glyph must be in some subtable's coverage (HarfBuzz checks
    // the lookup's glyph digest)
    let mut covered = false;
    for i in @as(usize, 0)..n {
        let r = resolve(&c, typ, off16(d, l, l + 6 + (2 * i)));
        if coverage(d, subtable_coverage(d, r[0], r[1]), gs[0]) != NOT_COVERED {
            covered = true;
            break;
        }
    }
    if not covered {
        return false;
    }
    for i in @as(usize, 0)..n {
        let r = resolve(&c, typ, off16(d, l, l + 6 + (2 * i)));
        if would_apply_subtable(d, r[0], r[1], gs, zero_context) {
            return true;
        }
    }
    return false;
}
