// =============================================================================
// std/graphics/pdf/read/lexer.ax - PDF lexical scanning, string decoding,
// and direct/indirect object syntax parsing, part of std/graphics/pdf/read.
// =============================================================================

import "../../../collections/vec.ax" as vec;
import "../../../mem.ax" as mem;
import "../../../str.ax" as strs;
import "../tables.ax" as tb;

// -----------------------------------------------------------------------------
// Characters and the lexer
// -----------------------------------------------------------------------------

struct Lexer {
    s: []u8,
    pos: usize,
}

fn is_white(c: u8) bool {
    return (c == 0) or (c == 9) or (c == 10) or (c == 12) or (c == 13) or (c == 32);
}

fn is_delim(c: u8) bool {
    return (c == '(') or (c == ')') or (c == '<') or (c == '>') or (c == '[') or (c == ']') or (c == '{') or
           (c == '}') or (c == '/') or (c == '%');
}

fn is_regular(c: u8) bool {
    return not is_white(c) and not is_delim(c);
}

fn hexval(c: u8) i32 {
    if (c >= '0') and (c <= '9') {
        return @as(i32, c - '0');
    }
    if (c >= 'a') and (c <= 'f') {
        return @as(i32, c - 'a') + 10;
    }
    if (c >= 'A') and (c <= 'F') {
        return @as(i32, c - 'A') + 10;
    }
    return -1;
}

fn at(s: []u8, i: usize) u8 {
    if i < s.len {
        return s[i];
    }
    return 0;
}

fn skip_white(s: []u8, p: usize) usize {
    let mut i = p;
    while i < s.len {
        let c = s[i];
        if c == '%' {
            while (i < s.len) and (s[i] != '\n') and (s[i] != '\r') {
                i += 1;
            }
        } else if is_white(c) {
            i += 1;
        } else {
            break;
        }
    }
    return i;
}

/// A number at s[p..]: its value and whether it is an integer; the end, or p if none.
fn scan_number(s: []u8, p: usize, iv: *mut i64, fv: *mut f64, is_int: *mut bool) usize {
    let mut i = p;
    let mut neg = false;
    if (at(s, i) == '+') or (at(s, i) == '-') {
        neg = at(s, i) == '-';
        i += 1;
    }
    let mut v: i64 = 0;
    let mut f: f64 = 0.0;
    let mut digits: usize = 0;
    while (i < s.len) and (s[i] >= '0') and (s[i] <= '9') {
        let d = @as(i64, s[i] - '0');
        if v < 100000000000000000 {
            v = (v * 10) + d;
        }
        f = (f * 10.0) + @float_from_int(f64, d);
        i += 1;
        digits += 1;
    }
    let mut integer = true;
    if at(s, i) == '.' {
        integer = false;
        i += 1;
        let mut scale: f64 = 0.1;
        while (i < s.len) and (s[i] >= '0') and (s[i] <= '9') {
            f += @float_from_int(f64, s[i] - '0') * scale;
            scale *= 0.1;
            i += 1;
            digits += 1;
        }
    }
    if digits == 0 {
        return p;
    }
    if neg {
        v = -v;
        f = -f;
    }
    iv.* = v;
    fv.* = f;
    is_int.* = integer;
    return i;
}

// -----------------------------------------------------------------------------
// String decoding
// -----------------------------------------------------------------------------

/// A literal string's contents from s[pos] (just after the '(').
fn literal_into(s: []u8, pos: *mut usize, out: *mut strs.String) ReadError!void {
    let mut depth: usize = 1;
    let mut i = pos.*;
    while i < s.len {
        let c = s[i];
        i += 1;
        if c == '\\' {
            if i >= s.len {
                break;
            }
            let e = s[i];
            i += 1;
            if e == 'n' {
                out.push('\n')!;
            } else if e == 'r' {
                out.push('\r')!;
            } else if e == 't' {
                out.push('\t')!;
            } else if e == 'b' {
                out.push(8)!;
            } else if e == 'f' {
                out.push(12)!;
            } else if (e >= '0') and (e <= '7') {
                let mut v: u32 = @as(u32, e - '0');
                let mut n: usize = 1;
                while (n < 3) and (i < s.len) and (s[i] >= '0') and (s[i] <= '7') {
                    v = (v * 8) + @as(u32, s[i] - '0');
                    i += 1;
                    n += 1;
                }
                out.push(@truncate(u8, v))!;
            } else if e == '\r' {
                if at(s, i) == '\n' {
                    i += 1;
                }
            } else if e == '\n' {
                // a line continuation
            } else {
                out.push(e)!;
            }
        } else if c == '(' {
            depth += 1;
            out.push(c)!;
        } else if c == ')' {
            depth -= 1;
            if depth == 0 {
                break;
            }
            out.push(c)!;
        } else {
            out.push(c)!;
        }
    }
    pos.* = i;
}

/// A hex string's contents from s[pos] (just after the '<').
fn hex_into(s: []u8, pos: *mut usize, out: *mut strs.String) ReadError!void {
    let mut i = pos.*;
    let mut hi: i32 = -1;
    while i < s.len {
        let c = s[i];
        i += 1;
        if c == '>' {
            break;
        }
        let v = hexval(c);
        if v < 0 {
            continue;
        }
        if hi < 0 {
            hi = v;
        } else {
            out.push(@truncate(u8, @bit_cast(u32, (hi << 4) | v)))!;
            hi = -1;
        }
    }
    if hi >= 0 {
        out.push(@truncate(u8, @bit_cast(u32, hi << 4)))!;
    }
    pos.* = i;
}

/// A text string (UTF-16 with a byte order mark, UTF-8 with one, or
/// PDFDocEncoding) as UTF-8.
pub fn text_string(s: []u8) ReadError![]mut u8 {
    let mut out = strs.String.init();
    let r = text_string_into(s, &mut out);
    r catch |e| {
        out.deinit();
        return e;
    };
    return out.take();
}

fn text_string_into(s: []u8, out: *mut strs.String) ReadError!void {
    if (s.len >= 2) and (((s[0] == 0xfe) and (s[1] == 0xff)) or ((s[0] == 0xff) and (s[1] == 0xfe))) {
        let le = s[0] == 0xff;
        let mut i: usize = 2;
        while i + 1 < s.len {
            let mut u = (@as(u32, s[i]) << 8) | @as(u32, s[i + 1]);
            if le {
                u = (@as(u32, s[i + 1]) << 8) | @as(u32, s[i]);
            }
            i += 2;
            if (u >= 0xd800) and (u < 0xdc00) and (i + 1 < s.len) {
                let mut lo = (@as(u32, s[i]) << 8) | @as(u32, s[i + 1]);
                if le {
                    lo = (@as(u32, s[i + 1]) << 8) | @as(u32, s[i]);
                }
                if (lo >= 0xdc00) and (lo < 0xe000) {
                    u = 0x10000 + ((u - 0xd800) << 10) + (lo - 0xdc00);
                    i += 2;
                }
            }
            if (u >= 0xd800) and (u < 0xe000) {
                u = 0xfffd;
            }
            out.push_rune(u)!;
        }
        return;
    }
    if (s.len >= 3) and (s[0] == 0xef) and (s[1] == 0xbb) and (s[2] == 0xbf) {
        out.push_str(s[3..])!;
        return;
    }
    for c in s {
        let u = @as(u32, tb.PDF_DOC[@as(usize, c)]);
        if u != 0 {
            out.push_rune(u)!;
        }
    }
}

// -----------------------------------------------------------------------------
// Object syntax parsing
// -----------------------------------------------------------------------------

/// "n g obj ... endobj" (with stream data).
fn parse_indirect(r: *mut Reader, lx: *mut Lexer) ReadError!Object {
    let mut iv: i64 = 0;
    let mut fv: f64 = 0.0;
    let mut isint = false;
    lx.pos = skip_white(lx.s, lx.pos);
    let a = scan_number(lx.s, lx.pos, &mut iv, &mut fv, &mut isint);
    if a == lx.pos {
        return error.Corrupt;
    }
    let b0 = skip_white(lx.s, a);
    let b = scan_number(lx.s, b0, &mut iv, &mut fv, &mut isint);
    if b == b0 {
        return error.Corrupt;
    }
    lx.pos = skip_white(lx.s, b);
    if not strs.starts_with(lx.s[lx.pos..], "obj") {
        return error.Corrupt;
    }
    lx.pos += 3;
    let o = parse_obj(r, lx, 0)!;
    // a stream?
    let p = skip_white(lx.s, lx.pos);
    match o {
        .Dict(dict) => {
            if strs.starts_with(lx.s[p..], "stream") {
                let mut s = p + 6;
                if at(lx.s, s) == '\r' {
                    s += 1;
                }
                if at(lx.s, s) == '\n' {
                    s += 1;
                }
                let mut len: i64 = -1;
                let lo = dict.get("Length");
                match lo {
                    .Int(v) => { len = v; }
                    .Ref(rf) => {
                        let lv = r.object(rf.num) catch Object.Null;
                        len = lv.as_int() catch -1;
                    }
                    else => {}
                }
                let d = lx.s;
                let mut ok = (len >= 0) and (@as(u64, @bit_cast(u64, len)) <= @as(u64, d.len - @min(s, d.len)));
                if ok {
                    let e = s + @truncate(usize, @bit_cast(u64, len));
                    let q = skip_white(d, e);
                    ok = strs.starts_with(d[q..], "endstream");
                }
                if not ok {
                    // find endstream instead
                    let e = strs.index_of_from(d, "endstream", s) ?? d.len;
                    let mut t = e;
                    if (t > s) and (d[t - 1] == '\n') {
                        t -= 1;
                    }
                    if (t > s) and (d[t - 1] == '\r') {
                        t -= 1;
                    }
                    len = @as(i64, @bit_cast(i64, @as(u64, t - s)));
                }
                lx.pos = s + @truncate(usize, @bit_cast(u64, len));  // (the work done)
                return Object.Stream(Stream.{ dict: dict, start: s, len: @truncate(usize, @bit_cast(u64, len)) });
            }
        }
        else => {}
    }
    return o;
}

/// One object from the lexer.
fn parse_obj(r: *mut Reader, lx: *mut Lexer, depth: u32) ReadError!Object {
    if depth > MAX_DEPTH {
        return error.Corrupt;
    }
    let s = lx.s;
    lx.pos = skip_white(s, lx.pos);
    if lx.pos >= s.len {
        return error.Corrupt;
    }
    let c = s[lx.pos];
    if c == '/' {
        return Object.Name(parse_name(r, lx)!);
    }
    if c == '(' {
        return Object.Str(parse_literal(r, lx)!);
    }
    if c == '<' {
        if at(s, lx.pos + 1) == '<' {
            lx.pos += 2;
            let mut keys = vec.Vec.[[]u8].init();
            defer keys.deinit();
            let mut vals = vec.Vec.[Object].init();
            defer vals.deinit();
            while true {
                lx.pos = skip_white(s, lx.pos);
                if lx.pos >= s.len {
                    return error.Corrupt;
                }
                if (s[lx.pos] == '>') and (at(s, lx.pos + 1) == '>') {
                    lx.pos += 2;
                    break;
                }
                if s[lx.pos] != '/' {
                    // junk: skip a token
                    _ = parse_obj(r, lx, depth + 1)!;
                    continue;
                }
                let k = parse_name(r, lx)!;
                let p0 = skip_white(s, lx.pos);
                if (at(s, p0) == '>') and (at(s, p0 + 1) == '>') {
                    keys.push(k)!;
                    vals.push(Object.Null)!;
                    continue;
                }
                let v = parse_obj(r, lx, depth + 1)!;
                keys.push(k)!;
                vals.push(v)!;
            }
            return Object.Dict(make_dict(r, keys.items(), vals.items())!);
        }
        return Object.Str(parse_hex_string(r, lx)!);
    }
    if c == '[' {
        lx.pos += 1;
        let mut items = vec.Vec.[Object].init();
        defer items.deinit();
        while true {
            lx.pos = skip_white(s, lx.pos);
            if lx.pos >= s.len {
                return error.Corrupt;
            }
            if s[lx.pos] == ']' {
                lx.pos += 1;
                break;
            }
            items.push(parse_obj(r, lx, depth + 1)!)!;
        }
        let arr = mem.alloc.[Object](items.len())!;
        @mem_copy(arr, items.items());
        r.objects.push(arr) catch |e| {
            mem.free(arr);
            return e;
        };
        return Object.Array(arr);
    }
    if (c == '+') or (c == '-') or (c == '.') or ((c >= '0') and (c <= '9')) {
        let mut iv: i64 = 0;
        let mut fv: f64 = 0.0;
        let mut isint = false;
        let e = scan_number(s, lx.pos, &mut iv, &mut fv, &mut isint);
        if e == lx.pos {
            lx.pos += 1;
            return Object.Null;
        }
        lx.pos = e;
        if not isint {
            return Object.Real(fv);
        }
        // "n g R"?
        let p1 = skip_white(s, e);
        let mut g: i64 = 0;
        let e2 = scan_number(s, p1, &mut g, &mut fv, &mut isint);
        if (e2 != p1) and isint {
            let p2 = skip_white(s, e2);
            if (at(s, p2) == 'R') and not is_regular(at(s, p2 + 1)) and (iv >= 0) and (iv < (1 << 31)) and (g >= 0) and
               (g < 65536) {
                lx.pos = p2 + 1;
                return Object.Ref(
                    Ref.{ num: @truncate(u32, @bit_cast(u64, iv)), gen: @truncate(u32, @bit_cast(u64, g)) });
            }
        }
        return Object.Int(iv);
    }
    // keywords
    let start = lx.pos;
    while (lx.pos < s.len) and is_regular(s[lx.pos]) {
        lx.pos += 1;
    }
    if lx.pos == start {
        lx.pos += 1;  // a stray delimiter
        return Object.Null;
    }
    let w = s[start..lx.pos];
    if strs.eq(w, "true") {
        return Object.Bool(true);
    }
    if strs.eq(w, "false") {
        return Object.Bool(false);
    }
    return Object.Null;
}

fn make_dict(r: *mut Reader, keys: [][]u8, vals: []Object) ReadError!Dict {
    let k = mem.alloc.[[]u8](keys.len)!;
    @mem_copy(k, keys);
    r.names.push(k) catch |e| {
        mem.free(k);
        return e;
    };
    let v = mem.alloc.[Object](vals.len)!;
    @mem_copy(v, vals);
    r.objects.push(v) catch |e| {
        mem.free(v);
        return e;
    };
    return Dict.{ keys: k, vals: v };
}

fn parse_name(r: *mut Reader, lx: *mut Lexer) ReadError![]u8 {
    let s = lx.s;
    lx.pos += 1;
    let start = lx.pos;
    let mut escapes = false;
    while (lx.pos < s.len) and is_regular(s[lx.pos]) {
        if s[lx.pos] == '#' {
            escapes = true;
        }
        lx.pos += 1;
    }
    let raw = s[start..lx.pos];
    if not escapes {
        return raw;
    }
    let mut out = strs.String.init();
    let mut i: usize = 0;
    while i < raw.len {
        if (raw[i] == '#') and (i + 2 < raw.len + 1) and (hexval(at(raw, i + 1)) >= 0) and
           (hexval(at(raw, i + 2)) >= 0) {
            out.push(@truncate(u8, @bit_cast(u32, (hexval(raw[i + 1]) << 4) | hexval(raw[i + 2])))) catch |e| {
                out.deinit();
                return e;
            };
            i += 3;
        } else {
            out.push(raw[i]) catch |e| {
                out.deinit();
                return e;
            };
            i += 1;
        }
    }
    return r.keep(out.take()!);
}

fn parse_literal(r: *mut Reader, lx: *mut Lexer) ReadError![]u8 {
    let s = lx.s;
    lx.pos += 1;
    let mut out = strs.String.init();
    let res = literal_into(s, &mut lx.pos, &mut out);
    res catch |e| {
        out.deinit();
        return e;
    };
    return r.keep(out.take()!);
}

fn parse_hex_string(r: *mut Reader, lx: *mut Lexer) ReadError![]u8 {
    let s = lx.s;
    lx.pos += 1;
    let mut out = strs.String.init();
    let res = hex_into(s, &mut lx.pos, &mut out);
    res catch |e| {
        out.deinit();
        return e;
    };
    return r.keep(out.take()!);
}
