// =============================================================================
// std/graphics/color.ax - colours and colour models.
//
//     let c = color.parse("#ff8000")!;                // a Color (linear light)
//     let lighter = c.to_oklch();                      // perceptual lightness, chroma, hue
//     let px = color.Color.from_oklch(color.Oklch.{ l: lighter.l + 0.1, c: lighter.c, h: lighter.h }, 1.0).to_rgba8();
//     let d = color.delta_e2000(a.to_lab(), b.to_lab());  // how different two colours look
//
// A Color is linear-light RGB with sRGB primaries and D65 white, plus a
// straight (not premultiplied) alpha, as f32: blending, scaling and
// averaging are correct on it, and components above 1 carry HDR values.
// Rgba8 and Rgba16 are sRGB-encoded integers, as images store them.
//
// Models: sRGB encoding, HSV and HSL (on sRGB-encoded values, as usual),
// CIE XYZ, CIE L*a*b* and LCh (D65 white), Oklab and Oklch, YCbCr (BT.601
// full range, as JPEG uses); the Display P3 and Rec. 2020 gamuts; the PQ
// and HLG transfer functions of HDR video; tone mapping of HDR values to
// displayable ones; colour differences (CIE76, CIEDE2000) and WCAG
// contrast; CSS-style parsing and hex formatting.
// =============================================================================

import "../fmt.ax" as fmt;
import "../math.ax" as math;
import "../str.ax" as strs;
import "../sync.ax" as sync;

pub error ColorError { InvalidColor }

// -----------------------------------------------------------------------------
// Types
// -----------------------------------------------------------------------------

/// Linear-light RGB (sRGB primaries, D65 white) with straight alpha.
pub struct Color {
    r: f32,
    g: f32,
    b: f32,
    a: f32,

    pub fn rgb(r: f32, g: f32, b: f32) Color {
        return Color.{ r: r, g: g, b: b, a: 1.0 };
    }

    pub fn rgba(r: f32, g: f32, b: f32, a: f32) Color {
        return Color.{ r: r, g: g, b: b, a: a };
    }

    /// From sRGB-encoded components in [0, 1] (as in CSS rgb() / 255).
    pub fn from_srgb(r: f32, g: f32, b: f32, a: f32) Color {
        return Color.{ r: srgb_decode(r), g: srgb_decode(g), b: srgb_decode(b), a: a };
    }

    /// This colour's sRGB-encoded components (alpha unchanged).
    pub fn to_srgb(self: Color) Color {
        return Color.{ r: srgb_encode(self.r), g: srgb_encode(self.g), b: srgb_encode(self.b), a: self.a };
    }

    pub fn from_rgba8(c: Rgba8) Color {
        let t = decode_table();
        return Color.{
            r: t[@as(usize, c.r)],
            g: t[@as(usize, c.g)],
            b: t[@as(usize, c.b)],
            a: @float_from_int(f32, c.a) / 255.0,
        };
    }

    /// Encoded, clamped to [0, 1] and rounded.
    pub fn to_rgba8(self: Color) Rgba8 {
        return Rgba8.{ r: srgb8(self.r), g: srgb8(self.g), b: srgb8(self.b), a: unit8(self.a) };
    }

    pub fn from_rgba16(c: Rgba16) Color {
        return Color.{
            r: srgb_decode(@float_from_int(f32, c.r) / 65535.0),
            g: srgb_decode(@float_from_int(f32, c.g) / 65535.0),
            b: srgb_decode(@float_from_int(f32, c.b) / 65535.0),
            a: @float_from_int(f32, c.a) / 65535.0,
        };
    }

    pub fn to_rgba16(self: Color) Rgba16 {
        return Rgba16.{
            r: unit16(srgb_encode(self.r)),
            g: unit16(srgb_encode(self.g)),
            b: unit16(srgb_encode(self.b)),
            a: unit16(self.a),
        };
    }

    pub fn with_alpha(self: Color, a: f32) Color {
        return Color.{ r: self.r, g: self.g, b: self.b, a: a };
    }

    /// The colour times k (alpha unchanged): exposure, for HDR values.
    pub fn scale(self: Color, k: f32) Color {
        return Color.{ r: self.r * k, g: self.g * k, b: self.b * k, a: self.a };
    }

    /// Components (alpha too) clamped to [0, 1].
    pub fn clamp(self: Color) Color {
        return Color.{ r: clamp01(self.r), g: clamp01(self.g), b: clamp01(self.b), a: clamp01(self.a) };
    }

    /// With the colour multiplied by alpha, as compositing wants.
    pub fn premultiply(self: Color) Color {
        return Color.{ r: self.r * self.a, g: self.g * self.a, b: self.b * self.a, a: self.a };
    }

    /// The inverse of premultiply (transparent stays black).
    pub fn unpremultiply(self: Color) Color {
        if self.a == 0.0 {
            return Color.{ r: 0.0, g: 0.0, b: 0.0, a: 0.0 };
        }
        return Color.{ r: self.r / self.a, g: self.g / self.a, b: self.b / self.a, a: self.a };
    }

    /// Relative luminance Y (0 black, 1 white).
    pub fn luminance(self: Color) f32 {
        return ((0.2126729 * self.r) + (0.7151522 * self.g)) + (0.0721750 * self.b);
    }

    pub fn to_xyz(self: Color) Xyz {
        let v = mat3(SRGB_TO_XYZ[..], @as(f64, self.r), @as(f64, self.g), @as(f64, self.b));
        return Xyz.{ x: @float_cast(f32, v[0]), y: @float_cast(f32, v[1]), z: @float_cast(f32, v[2]) };
    }

    pub fn from_xyz(c: Xyz, alpha: f32) Color {
        let v = mat3(XYZ_TO_SRGB[..], @as(f64, c.x), @as(f64, c.y), @as(f64, c.z));
        return Color.{ r: @float_cast(f32, v[0]), g: @float_cast(f32, v[1]), b: @float_cast(f32, v[2]), a: alpha };
    }

    pub fn to_lab(self: Color) Lab {
        return xyz_to_lab(self.to_xyz());
    }

    pub fn from_lab(c: Lab, alpha: f32) Color {
        return Color.from_xyz(lab_to_xyz(c), alpha);
    }

    pub fn to_lch(self: Color) Lch {
        let l = self.to_lab();
        let p = polar(l.a, l.b);
        return Lch.{ l: l.l, c: p[0], h: p[1] };
    }

    pub fn from_lch(c: Lch, alpha: f32) Color {
        let ab = cartesian(c.c, c.h);
        return Color.from_lab(Lab.{ l: c.l, a: ab[0], b: ab[1] }, alpha);
    }

    pub fn to_oklab(self: Color) Oklab {
        let r = @as(f64, self.r);
        let g = @as(f64, self.g);
        let b = @as(f64, self.b);
        let l = math.cbrt(((0.4122214708 * r) + (0.5363325363 * g)) + (0.0514459929 * b));
        let m = math.cbrt(((0.2119034982 * r) + (0.6806995451 * g)) + (0.1073969566 * b));
        let s = math.cbrt(((0.0883024619 * r) + (0.2817188376 * g)) + (0.6299787005 * b));
        return Oklab.{
            l: @float_cast(f32, ((0.2104542553 * l) + (0.7936177850 * m)) - (0.0040720468 * s)),
            a: @float_cast(f32, ((1.9779984951 * l) - (2.4285922050 * m)) + (0.4505937099 * s)),
            b: @float_cast(f32, ((0.0259040371 * l) + (0.7827717662 * m)) - (0.8086757660 * s)),
        };
    }

    pub fn from_oklab(c: Oklab, alpha: f32) Color {
        let ll = @as(f64, c.l);
        let aa = @as(f64, c.a);
        let bb = @as(f64, c.b);
        let l1 = (ll + (0.3963377774 * aa)) + (0.2158037573 * bb);
        let m1 = (ll - (0.1055613458 * aa)) - (0.0638541728 * bb);
        let s1 = (ll - (0.0894841775 * aa)) - (1.2914855480 * bb);
        let l = (l1 * l1) * l1;
        let m = (m1 * m1) * m1;
        let s = (s1 * s1) * s1;
        return Color.{
            r: @float_cast(f32, ((4.0767416621 * l) - (3.3077115913 * m)) + (0.2309699292 * s)),
            g: @float_cast(f32, ((-1.2684380046 * l) + (2.6097574011 * m)) - (0.3413193965 * s)),
            b: @float_cast(f32, ((-0.0041960863 * l) - (0.7034186147 * m)) + (1.7076147010 * s)),
            a: alpha,
        };
    }

    pub fn to_oklch(self: Color) Oklch {
        let o = self.to_oklab();
        let p = polar(o.a, o.b);
        return Oklch.{ l: o.l, c: p[0], h: p[1] };
    }

    pub fn from_oklch(c: Oklch, alpha: f32) Color {
        let ab = cartesian(c.c, c.h);
        return Color.from_oklab(Oklab.{ l: c.l, a: ab[0], b: ab[1] }, alpha);
    }

    /// Hue, saturation and value of the sRGB-encoded colour.
    pub fn to_hsv(self: Color) Hsv {
        let e = self.to_srgb();
        let mx = @max(@max(e.r, e.g), e.b);
        let mn = @min(@min(e.r, e.g), e.b);
        let mut s: f32 = 0.0;
        if mx > 0.0 {
            s = (mx - mn) / mx;
        }
        return Hsv.{ h: hue_of(e, mx, mn), s: s, v: mx };
    }

    pub fn from_hsv(c: Hsv, alpha: f32) Color {
        let chroma = c.v * c.s;
        return from_hue(c.h, chroma, c.v - chroma, alpha);
    }

    /// Hue, saturation and lightness of the sRGB-encoded colour.
    pub fn to_hsl(self: Color) Hsl {
        let e = self.to_srgb();
        let mx = @max(@max(e.r, e.g), e.b);
        let mn = @min(@min(e.r, e.g), e.b);
        let l = (mx + mn) / 2.0;
        let mut s: f32 = 0.0;
        if (mx > mn) and (l > 0.0) and (l < 1.0) {
            s = (mx - mn) / (1.0 - @abs((2.0 * l) - 1.0));
        }
        return Hsl.{ h: hue_of(e, mx, mn), s: s, l: l };
    }

    pub fn from_hsl(c: Hsl, alpha: f32) Color {
        let chroma = (1.0 - @abs((2.0 * c.l) - 1.0)) * c.s;
        return from_hue(c.h, chroma, c.l - (chroma / 2.0), alpha);
    }
}

/// sRGB-encoded 8-bit components with straight alpha.
pub struct Rgba8 {
    r: u8,
    g: u8,
    b: u8,
    a: u8,

    /// From 0xRRGGBBAA.
    pub fn from_u32(v: u32) Rgba8 {
        return Rgba8.{
            r: @truncate(u8, v >> 24),
            g: @truncate(u8, v >> 16),
            b: @truncate(u8, v >> 8),
            a: @truncate(u8, v),
        };
    }

    /// As 0xRRGGBBAA.
    pub fn to_u32(self: Rgba8) u32 {
        return (((@as(u32, self.r) << 24) | (@as(u32, self.g) << 16)) | (@as(u32, self.b) << 8)) | @as(u32, self.a);
    }
}

/// sRGB-encoded 16-bit components with straight alpha.
pub struct Rgba16 {
    r: u16,
    g: u16,
    b: u16,
    a: u16,
}

/// A linear RGB triple in some gamut (see srgb_to_p3 and friends).
pub struct Rgb {
    r: f32,
    g: f32,
    b: f32,
}

/// Hue in degrees [0, 360); saturation and value in [0, 1].
pub struct Hsv {
    h: f32,
    s: f32,
    v: f32,
}

pub struct Hsl {
    h: f32,
    s: f32,
    l: f32,
}

/// CIE 1931 XYZ (Y = 1 for white).
pub struct Xyz {
    x: f32,
    y: f32,
    z: f32,
}

/// CIE L*a*b* (L 0 to 100), relative to D65 white.
pub struct Lab {
    l: f32,
    a: f32,
    b: f32,
}

/// L*a*b* in polar form: chroma and hue in degrees.
pub struct Lch {
    l: f32,
    c: f32,
    h: f32,
}

/// Oklab (L 0 to 1).
pub struct Oklab {
    l: f32,
    a: f32,
    b: f32,
}

pub struct Oklch {
    l: f32,
    c: f32,
    h: f32,
}

/// Luma and chroma, 8-bit (BT.601, full range, as JPEG uses).
pub struct YCbCr {
    y: u8,
    cb: u8,
    cr: u8,
}

// -----------------------------------------------------------------------------
// sRGB encoding
// -----------------------------------------------------------------------------

/// The sRGB transfer function, linear to encoded (extended to negative and
/// HDR values).
pub fn srgb_encode(v: f32) f32 {
    let a = @abs(v);
    let mut e: f32 = 0.0;
    if a <= 0.0031308 {
        e = 12.92 * a;
    } else {
        e = (1.055 * math.powf(a, 1.0 / 2.4)) - 0.055;
    }
    return @copysign(e, v);
}

/// Encoded to linear.
pub fn srgb_decode(v: f32) f32 {
    let a = @abs(v);
    let mut l: f32 = 0.0;
    if a <= 0.04045 {
        l = a / 12.92;
    } else {
        l = math.powf((a + 0.055) / 1.055, 2.4);
    }
    return @copysign(l, v);
}

let mut DECODE8: [256]f32 = [0.0; 256];  // encoded byte -> linear
let mut THRESH8: [255]f32 = [0.0; 255];  // linear values where the encoded byte steps up
let mut BUCKET8: [4096]u8 = [0; 4096];   // srgb8(k / 4096): where to start looking
let mut TABLES_ONCE: sync.Once = sync.Once.{ state: 0 };

fn build_tables(_u: u8) void {
    for i in @as(usize, 0)..256 {
        DECODE8[i] = srgb_decode_f64(@float_from_int(f64, i) / 255.0);
    }
    for i in @as(usize, 0)..255 {
        THRESH8[i] = srgb_decode_f64((@float_from_int(f64, i) + 0.5) / 255.0);
    }
    for k in @as(usize, 0)..4096 {
        BUCKET8[k] = search8(@float_from_int(f32, k) / 4096.0);
    }
}

fn decode_table() *[256]f32 {
    TABLES_ONCE.call(build_tables, @as(u8, 0));
    return &DECODE8;
}

fn srgb_decode_f64(v: f64) f32 {
    if v <= 0.04045 {
        return @float_cast(f32, v / 12.92);
    }
    return @float_cast(f32, math.pow((v + 0.055) / 1.055, 2.4));
}

/// The encoded byte for a linear value (clamped): exactly the rounding of
/// 255 * srgb_encode(v), by binary search over the steps.
pub fn srgb8(v: f32) u8 {
    _ = decode_table();
    if not (v > 0.0) {
        return 0;
    }
    if v >= 1.0 {
        return 255;
    }
    // v * 4096 is exact, so v is at least its bucket's start; from there
    // the answer is at most a step or two up
    let mut r = @as(usize, BUCKET8[@int_from_float(usize, v * 4096.0)]);
    while (r < 255) and (THRESH8[r] <= v) {
        r += 1;
    }
    return @truncate(u8, r);
}

fn search8(v: f32) u8 {
    if not (v > 0.0) {
        return 0;
    }
    let mut lo: usize = 0;
    let mut hi: usize = 255;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if THRESH8[mid] <= v {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return @truncate(u8, lo);
}

/// The linear value of an encoded byte.
pub fn linear8(v: u8) f32 {
    return decode_table()[@as(usize, v)];
}

/// v clamped to 0..1 (NaN to 0).
pub fn clamp01(v: f32) f32 {
    if not (v > 0.0) {
        return 0.0;  // NaN too
    }
    return @min(v, 1.0);
}

fn unit8(v: f32) u8 {
    return @truncate(u8, @int_from_float(u32, @nearest(clamp01(v) * 255.0)));
}

fn unit16(v: f32) u16 {
    return @truncate(u16, @int_from_float(u32, @nearest(clamp01(v) * 65535.0)));
}

// -----------------------------------------------------------------------------
// HSV and HSL
// -----------------------------------------------------------------------------

fn hue_of(e: Color, mx: f32, mn: f32) f32 {
    let d = mx - mn;
    if d == 0.0 {
        return 0.0;
    }
    let mut h: f32 = 0.0;
    if mx == e.r {
        h = (e.g - e.b) / d;
    } else if mx == e.g {
        h = ((e.b - e.r) / d) + 2.0;
    } else {
        h = ((e.r - e.g) / d) + 4.0;
    }
    return wrap_degrees(h * 60.0);
}

/// An sRGB-encoded colour from hue, chroma and the amount m added to each
/// component; returned linear.
fn from_hue(h: f32, chroma: f32, m: f32, alpha: f32) Color {
    let hp = wrap_degrees(h) / 60.0;
    let x = chroma * (1.0 - @abs(@rem(hp, 2.0) - 1.0));
    let mut r: f32 = 0.0;
    let mut g: f32 = 0.0;
    let mut b: f32 = 0.0;
    if hp < 1.0 {
        r = chroma;
        g = x;
    } else if hp < 2.0 {
        r = x;
        g = chroma;
    } else if hp < 3.0 {
        g = chroma;
        b = x;
    } else if hp < 4.0 {
        g = x;
        b = chroma;
    } else if hp < 5.0 {
        r = x;
        b = chroma;
    } else {
        r = chroma;
        b = x;
    }
    return Color.from_srgb(r + m, g + m, b + m, alpha);
}

fn wrap_degrees(h: f32) f32 {
    let w = @rem(h, 360.0);
    if w < 0.0 {
        return w + 360.0;
    }
    return w;
}

/// (chroma, hue in degrees) from (a, b).
fn polar(a: f32, b: f32) [2]f32 {
    let c = math.hypotf(a, b);
    if c < 1.0e-7 {
        return [c, 0.0];
    }
    let h = @float_cast(f32, math.atan2(@as(f64, b), @as(f64, a)) * (180.0 / math.PI));
    return [c, wrap_degrees(h)];
}

fn cartesian(c: f32, h: f32) [2]f32 {
    let sc = math.sincos(@as(f64, h) * (math.PI / 180.0));
    return [@float_cast(f32, @as(f64, c) * sc.cos), @float_cast(f32, @as(f64, c) * sc.sin)];
}

// -----------------------------------------------------------------------------
// XYZ, L*a*b*, gamuts
// -----------------------------------------------------------------------------

// Derived exactly from the primaries and D65 (x 0.3127, y 0.3290).
let SRGB_TO_XYZ: [9]f64 = [
    0.41239079926595951,
    0.35758433938387796,
    0.18048078840183429,
    0.21263900587151036,
    0.71516867876775592,
    0.072192315360733714,
    0.019330818715591849,
    0.11919477979462599,
    0.95053215224966059,
];
let XYZ_TO_SRGB: [9]f64 = [
    3.2409699419045213,
    -1.5373831775700935,
    -0.49861076029300327,
    -0.96924363628087984,
    1.8759675015077206,
    0.041555057407175612,
    0.055630079696993608,
    -0.20397695888897657,
    1.0569715142428786,
];
let P3_TO_XYZ: [9]f64 = [
    0.48657094864821626,
    0.26566769316909294,
    0.19821728523436249,
    0.22897456406974884,
    0.69173852183650619,
    0.079286914093744998,
    0.0,
    0.045113381858902575,
    1.0439443689009757,
];
let XYZ_TO_P3: [9]f64 = [
    2.4934969119414245,
    -0.93138361791912361,
    -0.40271078445071684,
    -0.82948896956157503,
    1.7626640603183468,
    0.023624685841943591,
    0.035845830243784335,
    -0.076172389268041707,
    0.95688452400768731,
];
let REC2020_TO_XYZ: [9]f64 = [
    0.63695804830129132,
    0.14461690358620838,
    0.16888097516417205,
    0.26270021201126703,
    0.67799807151887104,
    0.059301716469861945,
    0.0,
    0.028072693049087508,
    1.0609850577107909,
];
let XYZ_TO_REC2020: [9]f64 = [
    1.7166511879712676,
    -0.35567078377639239,
    -0.2533662813736598,
    -0.66668435183248898,
    1.616481236634939,
    0.015768545813911131,
    0.017639857445310915,
    -0.042770613257808655,
    0.94210312123547402,
];

// D65 white in XYZ
const WHITE_X: f64 = 0.9504559270516717;
const WHITE_Z: f64 = 1.0890577507598784;

fn mat3(m: []f64, x: f64, y: f64, z: f64) [3]f64 {
    return [
        ((m[0] * x) + (m[1] * y)) + (m[2] * z),
        ((m[3] * x) + (m[4] * y)) + (m[5] * z),
        ((m[6] * x) + (m[7] * y)) + (m[8] * z),
    ];
}

fn convert(a: []f64, b: []f64, c: Rgb) Rgb {
    let x = mat3(a, @as(f64, c.r), @as(f64, c.g), @as(f64, c.b));
    let v = mat3(b, x[0], x[1], x[2]);
    return Rgb.{ r: @float_cast(f32, v[0]), g: @float_cast(f32, v[1]), b: @float_cast(f32, v[2]) };
}

/// Linear sRGB to linear Display P3 (and back): the same colour in the
/// other gamut's coordinates.
pub fn srgb_to_p3(c: Rgb) Rgb {
    return convert(SRGB_TO_XYZ[..], XYZ_TO_P3[..], c);
}

pub fn p3_to_srgb(c: Rgb) Rgb {
    return convert(P3_TO_XYZ[..], XYZ_TO_SRGB[..], c);
}

/// Linear sRGB to linear Rec. 2020 (BT.2020 / BT.2100) and back.
pub fn srgb_to_rec2020(c: Rgb) Rgb {
    return convert(SRGB_TO_XYZ[..], XYZ_TO_REC2020[..], c);
}

pub fn rec2020_to_srgb(c: Rgb) Rgb {
    return convert(REC2020_TO_XYZ[..], XYZ_TO_SRGB[..], c);
}

fn lab_f(t: f64) f64 {
    let d: f64 = 6.0 / 29.0;
    if t > ((d * d) * d) {
        return math.cbrt(t);
    }
    return (t / ((3.0 * d) * d)) + (4.0 / 29.0);
}

fn lab_finv(t: f64) f64 {
    let d: f64 = 6.0 / 29.0;
    if t > d {
        return (t * t) * t;
    }
    return ((3.0 * d) * d) * (t - (4.0 / 29.0));
}

pub fn xyz_to_lab(c: Xyz) Lab {
    let fx = lab_f(@as(f64, c.x) / WHITE_X);
    let fy = lab_f(@as(f64, c.y));
    let fz = lab_f(@as(f64, c.z) / WHITE_Z);
    return Lab.{
        l: @float_cast(f32, (116.0 * fy) - 16.0),
        a: @float_cast(f32, 500.0 * (fx - fy)),
        b: @float_cast(f32, 200.0 * (fy - fz)),
    };
}

pub fn lab_to_xyz(c: Lab) Xyz {
    let fy = (@as(f64, c.l) + 16.0) / 116.0;
    let fx = fy + (@as(f64, c.a) / 500.0);
    let fz = fy - (@as(f64, c.b) / 200.0);
    return Xyz.{
        x: @float_cast(f32, WHITE_X * lab_finv(fx)),
        y: @float_cast(f32, lab_finv(fy)),
        z: @float_cast(f32, WHITE_Z * lab_finv(fz)),
    };
}

// -----------------------------------------------------------------------------
// Differences and contrast
// -----------------------------------------------------------------------------

/// The CIE76 difference: Euclidean distance in L*a*b*.
pub fn delta_e76(x: Lab, y: Lab) f32 {
    let dl = x.l - y.l;
    let da = x.a - y.a;
    let db = x.b - y.b;
    return @sqrt(((dl * dl) + (da * da)) + (db * db));
}

fn deg(r: f64) f64 {
    return r * (180.0 / math.PI);
}

fn rad(d: f64) f64 {
    return d * (math.PI / 180.0);
}

fn hue_deg(b: f64, a: f64) f64 {
    if (a == 0.0) and (b == 0.0) {
        return 0.0;
    }
    let h = deg(math.atan2(b, a));
    if h < 0.0 {
        return h + 360.0;
    }
    return h;
}

/// The CIEDE2000 difference: about 1 is just noticeable.
pub fn delta_e2000(x: Lab, y: Lab) f32 {
    let l1 = @as(f64, x.l);
    let a1 = @as(f64, x.a);
    let b1 = @as(f64, x.b);
    let l2 = @as(f64, y.l);
    let a2 = @as(f64, y.a);
    let b2 = @as(f64, y.b);
    let p25_7: f64 = 6103515625.0;  // 25^7
    let cbar = (math.hypot(a1, b1) + math.hypot(a2, b2)) / 2.0;
    let cbar7 = math.pow(cbar, 7.0);
    let g = 0.5 * (1.0 - @sqrt(cbar7 / (cbar7 + p25_7)));
    let a1p = (1.0 + g) * a1;
    let a2p = (1.0 + g) * a2;
    let c1p = math.hypot(a1p, b1);
    let c2p = math.hypot(a2p, b2);
    let h1p = hue_deg(b1, a1p);
    let h2p = hue_deg(b2, a2p);
    let dlp = l2 - l1;
    let dcp = c2p - c1p;
    let mut dhp: f64 = 0.0;
    if (c1p * c2p) != 0.0 {
        dhp = h2p - h1p;
        if dhp > 180.0 {
            dhp -= 360.0;
        } else if dhp < -180.0 {
            dhp += 360.0;
        }
    }
    let dhhp = (2.0 * @sqrt(c1p * c2p)) * math.sin(rad(dhp / 2.0));
    let lbp = (l1 + l2) / 2.0;
    let cbp = (c1p + c2p) / 2.0;
    let mut hbp = h1p + h2p;
    if (c1p * c2p) != 0.0 {
        if @abs(h1p - h2p) <= 180.0 {
            hbp = hbp / 2.0;
        } else if hbp < 360.0 {
            hbp = (hbp + 360.0) / 2.0;
        } else {
            hbp = (hbp - 360.0) / 2.0;
        }
    }
    let t =
        (((1.0 - (0.17 * math.cos(rad(hbp - 30.0)))) + (0.24 * math.cos(rad(2.0 * hbp)))) +
         (0.32 * math.cos(rad((3.0 * hbp) + 6.0)))) - (0.20 * math.cos(rad((4.0 * hbp) - 63.0)));
    let q = (hbp - 275.0) / 25.0;
    let dtheta = 30.0 * math.exp(-(q * q));
    let cbp7 = math.pow(cbp, 7.0);
    let rc = 2.0 * @sqrt(cbp7 / (cbp7 + p25_7));
    let l50 = (lbp - 50.0) * (lbp - 50.0);
    let sl = 1.0 + ((0.015 * l50) / @sqrt(20.0 + l50));
    let sc = 1.0 + (0.045 * cbp);
    let sh = 1.0 + ((0.015 * cbp) * t);
    let rt = -math.sin(rad(2.0 * dtheta)) * rc;
    let tl = dlp / sl;
    let tc = dcp / sc;
    let th = dhhp / sh;
    return @float_cast(f32, @sqrt((((tl * tl) + (tc * tc)) + (th * th)) + ((rt * tc) * th)));
}

/// The WCAG contrast ratio, from 1 (none) to 21 (black on white).
pub fn contrast_ratio(x: Color, y: Color) f32 {
    let lx = x.luminance() + 0.05;
    let ly = y.luminance() + 0.05;
    return @max(lx, ly) / @min(lx, ly);
}

// -----------------------------------------------------------------------------
// Blending
// -----------------------------------------------------------------------------

/// x + (y - x) t, componentwise (in linear light, as blending should be).
pub fn mix(x: Color, y: Color, t: f32) Color {
    return Color.{
        r: x.r + ((y.r - x.r) * t),
        g: x.g + ((y.g - x.g) * t),
        b: x.b + ((y.b - x.b) * t),
        a: x.a + ((y.a - x.a) * t),
    };
}

/// src composited over dst (Porter-Duff source-over, straight alpha).
pub fn over(src: Color, dst: Color) Color {
    let a = src.a + (dst.a * (1.0 - src.a));
    if a == 0.0 {
        return Color.{ r: 0.0, g: 0.0, b: 0.0, a: 0.0 };
    }
    let k = dst.a * (1.0 - src.a);
    return Color.{
        r: ((src.r * src.a) + (dst.r * k)) / a,
        g: ((src.g * src.a) + (dst.g * k)) / a,
        b: ((src.b * src.a) + (dst.b * k)) / a,
        a: a,
    };
}

// -----------------------------------------------------------------------------
// YCbCr
// -----------------------------------------------------------------------------

fn byte_of(v: f32) u8 {
    return @truncate(u8, @int_from_float(u32, @nearest(@min(@max(v, 0.0), 255.0))));
}

/// Full-range BT.601 YCbCr from sRGB-encoded bytes (JPEG's JFIF).
pub fn ycbcr_from_rgb8(c: Rgba8) YCbCr {
    let r = @float_from_int(f32, c.r);
    let g = @float_from_int(f32, c.g);
    let b = @float_from_int(f32, c.b);
    return YCbCr.{
        y: byte_of(((0.299 * r) + (0.587 * g)) + (0.114 * b)),
        cb: byte_of(((128.0 - (0.168736 * r)) - (0.331264 * g)) + (0.5 * b)),
        cr: byte_of(((128.0 + (0.5 * r)) - (0.418688 * g)) - (0.081312 * b)),
    };
}

pub fn rgb8_from_ycbcr(c: YCbCr) Rgba8 {
    let y = @float_from_int(f32, c.y);
    let cb = @float_from_int(f32, c.cb) - 128.0;
    let cr = @float_from_int(f32, c.cr) - 128.0;
    return Rgba8.{
        r: byte_of(y + (1.402 * cr)),
        g: byte_of((y - (0.344136 * cb)) - (0.714136 * cr)),
        b: byte_of(y + (1.772 * cb)),
        a: 255,
    };
}

// -----------------------------------------------------------------------------
// HDR
// -----------------------------------------------------------------------------

const PQ_M1: f64 = 0.1593017578125;
const PQ_M2: f64 = 78.84375;
const PQ_C1: f64 = 0.8359375;
const PQ_C2: f64 = 18.8515625;
const PQ_C3: f64 = 18.6875;

/// The PQ (SMPTE ST 2084) inverse EOTF: luminance as a fraction of 10000
/// cd/m^2 to a signal in [0, 1].
pub fn pq_encode(y: f32) f32 {
    let yp = math.pow(@max(@as(f64, y), 0.0), PQ_M1);
    return @float_cast(f32, math.pow((PQ_C1 + (PQ_C2 * yp)) / (1.0 + (PQ_C3 * yp)), PQ_M2));
}

/// The PQ EOTF: signal to luminance as a fraction of 10000 cd/m^2.
pub fn pq_decode(e: f32) f32 {
    let ep = math.pow(@max(@as(f64, e), 0.0), 1.0 / PQ_M2);
    let n = @max(ep - PQ_C1, 0.0);
    return @float_cast(f32, math.pow(n / (PQ_C2 - (PQ_C3 * ep)), 1.0 / PQ_M1));
}

const HLG_A: f64 = 0.17883277;
const HLG_B: f64 = 0.28466892;
const HLG_C: f64 = 0.55991073;

/// The HLG (BT.2100) OETF: scene light in [0, 1] to a signal in [0, 1].
pub fn hlg_encode(e: f32) f32 {
    let x = @max(@as(f64, e), 0.0);
    if x <= (1.0 / 12.0) {
        return @float_cast(f32, @sqrt(3.0 * x));
    }
    return @float_cast(f32, (HLG_A * math.log((12.0 * x) - HLG_B)) + HLG_C);
}

pub fn hlg_decode(s: f32) f32 {
    let x = @max(@as(f64, s), 0.0);
    if x <= 0.5 {
        return @float_cast(f32, (x * x) / 3.0);
    }
    return @float_cast(f32, (math.exp((x - HLG_C) / HLG_A) + HLG_B) / 12.0);
}

/// Reinhard tone mapping of an HDR colour: white (the value that maps to
/// 1) sets the curve; alpha is unchanged.
pub fn tonemap_reinhard(c: Color, white: f32) Color {
    let w2 = white * white;
    return Color.{ r: reinhard(c.r, w2), g: reinhard(c.g, w2), b: reinhard(c.b, w2), a: c.a };
}

fn reinhard(v: f32, w2: f32) f32 {
    let x = @max(v, 0.0);
    return (x * (1.0 + (x / w2))) / (1.0 + x);
}

/// A filmic curve (Narkowicz's fit of ACES), from HDR to [0, 1].
pub fn tonemap_aces(c: Color) Color {
    return Color.{ r: aces(c.r), g: aces(c.g), b: aces(c.b), a: c.a };
}

fn aces(v: f32) f32 {
    let x = @max(v, 0.0);
    return clamp01((x * ((2.51 * x) + 0.03)) / ((x * ((2.43 * x) + 0.59)) + 0.14));
}

// -----------------------------------------------------------------------------
// Parsing and formatting
// -----------------------------------------------------------------------------

struct Named {
    name: []u8,
    rgba: u32,
}

let NAMED: [18]Named = [
    Named.{ name: "black", rgba: 0x000000ff },
    Named.{ name: "silver", rgba: 0xc0c0c0ff },
    Named.{ name: "gray", rgba: 0x808080ff },
    Named.{ name: "grey", rgba: 0x808080ff },
    Named.{ name: "white", rgba: 0xffffffff },
    Named.{ name: "maroon", rgba: 0x800000ff },
    Named.{ name: "red", rgba: 0xff0000ff },
    Named.{ name: "purple", rgba: 0x800080ff },
    Named.{ name: "fuchsia", rgba: 0xff00ffff },
    Named.{ name: "green", rgba: 0x008000ff },
    Named.{ name: "lime", rgba: 0x00ff00ff },
    Named.{ name: "olive", rgba: 0x808000ff },
    Named.{ name: "yellow", rgba: 0xffff00ff },
    Named.{ name: "navy", rgba: 0x000080ff },
    Named.{ name: "blue", rgba: 0x0000ffff },
    Named.{ name: "teal", rgba: 0x008080ff },
    Named.{ name: "aqua", rgba: 0x00ffffff },
    Named.{ name: "orange", rgba: 0xffa500ff },
];

fn hex_digit(c: u8) ColorError!u32 {
    if (c >= '0') and (c <= '9') {
        return @as(u32, c - '0');
    }
    if (c >= 'a') and (c <= 'f') {
        return @as(u32, c - 'a') + 10;
    }
    if (c >= 'A') and (c <= 'F') {
        return @as(u32, c - 'A') + 10;
    }
    return error.InvalidColor;
}

/// Parses "#rgb", "#rgba", "#rrggbb", "#rrggbbaa", "rgb(r, g, b)",
/// "rgba(r, g, b, alpha)" (0-255 components, alpha 0-1), a basic CSS colour
/// name, or "transparent", to 8-bit sRGB.
pub fn parse_rgba8(text: []u8) ColorError!Rgba8 {
    let s = strs.trim(text);
    if (s.len > 0) and (s[0] == '#') {
        let h = s[1..];
        let mut v: u32 = 0;
        if (h.len == 3) or (h.len == 4) {
            for c in h {
                let d = hex_digit(c)!;
                v = (v << 8) | (d * 17);
            }
            if h.len == 3 {
                v = (v << 8) | 0xff;
            }
        } else if (h.len == 6) or (h.len == 8) {
            for c in h {
                v = (v << 4) | hex_digit(c)!;
            }
            if h.len == 6 {
                v = (v << 8) | 0xff;
            }
        } else {
            return error.InvalidColor;
        }
        return Rgba8.from_u32(v);
    }
    let mut lower: [16]u8 = [0; 16];
    if s.len <= lower.len {
        for i in @as(usize, 0)..s.len {
            lower[i] = strs.to_lower_byte(s[i]);
        }
        let name = lower[..s.len];
        if @mem_eq(name, "transparent") {
            return Rgba8.{ r: 0, g: 0, b: 0, a: 0 };
        }
        for n in NAMED {
            if @mem_eq(name, n.name) {
                return Rgba8.from_u32(n.rgba);
            }
        }
    }
    let mut args = s;
    let mut want: usize = 3;
    if strs.starts_with(s, "rgba(") {
        args = s[5..];
        want = 4;
    } else if strs.starts_with(s, "rgb(") {
        args = s[4..];
    } else {
        return error.InvalidColor;
    }
    if (args.len == 0) or (args[args.len - 1] != ')') {
        return error.InvalidColor;
    }
    let mut parts = strs.split(args[..args.len - 1], ",");
    let mut vals: [4]u8 = [0, 0, 0, 255];
    for i in @as(usize, 0)..want {
        let p = strs.trim(parts.next() catch return error.InvalidColor);
        if i < 3 {
            vals[i] = fmt.parse_int.[u8](p) catch return error.InvalidColor;
        } else {
            let a = fmt.parse_float(p) catch return error.InvalidColor;
            vals[3] = unit8(@float_cast(f32, a));
        }
    }
    _ = parts.next() catch return Rgba8.{ r: vals[0], g: vals[1], b: vals[2], a: vals[3] };
    return error.InvalidColor;
}

/// parse_rgba8, as a linear Color.
pub fn parse(text: []u8) ColorError!Color {
    return Color.from_rgba8(parse_rgba8(text)!);
}

/// "#rrggbb", or "#rrggbbaa" if not opaque, into buf (9 bytes suffice).
pub fn format_hex(c: Rgba8, buf: []mut u8) []u8 {
    let digits = "0123456789abcdef";
    let v = c.to_u32();
    let mut n: usize = 8;
    if c.a == 255 {
        n = 6;
    }
    buf[0] = '#';
    for i in @as(usize, 0)..n {
        buf[i + 1] = digits[@as(usize, (v >> @truncate(u32, 28 - (4 * i))) & 15)];
    }
    return buf[..n + 1];
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn near(a: f32, b: f32, tol: f32) bool {
    return @abs(a - b) <= tol;
}

test "srgb" {
    @expect_eq(srgb8(0.0), 0);
    @expect_eq(srgb8(1.0), 255);
    @expect_eq(srgb8(2.0), 255);
    @expect_eq(srgb8(-1.0), 0);
    // every byte survives decoding and encoding
    for i in @as(usize, 0)..256 {
        let b = @truncate(u8, i);
        @expect_eq(srgb8(linear8(b)), b);
        @expect(near(srgb_encode(linear8(b)) * 255.0, @float_from_int(f32, i), 0.001));
    }
    @expect(near(linear8(128), 0.2158605, 1.0e-6));
    let c = Color.from_rgba8(Rgba8.{ r: 255, g: 128, b: 0, a: 128 });
    let back = c.to_rgba8();
    @expect_eq(back.to_u32(), 0xff800080);
    let w = Color.from_rgba16(Rgba16.{ r: 65535, g: 0, b: 32768, a: 65535 }).to_rgba16();
    @expect_eq(w.b, 32768);
}

test "models" {
    let red = Color.rgb(1.0, 0.0, 0.0);
    let lab = red.to_lab();
    @expect(near(lab.l, 53.2371, 0.001));
    @expect(near(lab.a, 80.0901, 0.001));
    @expect(near(lab.b, 67.2033, 0.001));
    let white = Color.rgb(1.0, 1.0, 1.0);
    let wl = white.to_lab();
    @expect(near(wl.l, 100.0, 0.0001) and near(wl.a, 0.0, 0.0001) and near(wl.b, 0.0, 0.0001));
    let ok = white.to_oklab();
    @expect(near(ok.l, 1.0, 0.0001) and near(ok.a, 0.0, 0.0001) and near(ok.b, 0.0, 0.0001));
    let okr = red.to_oklch();
    @expect(near(okr.l, 0.62796, 0.0001));
    @expect(near(okr.c, 0.25768, 0.0001));
    @expect(near(okr.h, 29.2339, 0.01));
    // round trips
    let samples: [4]Color = [
        Color.rgb(0.2, 0.5, 0.9),
        Color.rgb(1.0, 0.0, 0.0),
        Color.rgb(0.01, 0.8, 0.3),
        Color.rgb(0.5, 0.5, 0.5),
    ];
    for c in samples {
        let a = Color.from_lab(c.to_lab(), 1.0);
        let b = Color.from_oklch(c.to_oklch(), 1.0);
        let h = Color.from_hsv(c.to_hsv(), 1.0);
        let l = Color.from_hsl(c.to_hsl(), 1.0);
        let x = Color.from_lch(c.to_lch(), 1.0);
        let all: [5]Color = [a, b, h, l, x];
        for r in all {
            @expect(near(r.r, c.r, 0.0005) and near(r.g, c.g, 0.0005) and near(r.b, c.b, 0.0005));
        }
    }
    let hsv = Color.from_rgba8(Rgba8.from_u32(0x33cc99ff)).to_hsv();
    @expect(near(hsv.h, 160.0, 0.01) and near(hsv.s, 0.75, 0.001) and near(hsv.v, 0.8, 0.001));
    let hsl = Color.from_rgba8(Rgba8.from_u32(0x33cc99ff)).to_hsl();
    @expect(near(hsl.s, 0.6, 0.001) and near(hsl.l, 0.5, 0.001));
    // gamuts: sRGB red is inside P3 and Rec. 2020
    let p3 = srgb_to_p3(Rgb.{ r: 1.0, g: 0.0, b: 0.0 });
    @expect(near(p3.r, 0.8225, 0.0001) and near(p3.g, 0.0332, 0.0001) and near(p3.b, 0.0171, 0.0001));
    let back = rec2020_to_srgb(srgb_to_rec2020(Rgb.{ r: 0.3, g: 0.6, b: 0.1 }));
    @expect(near(back.r, 0.3, 1.0e-6) and near(back.g, 0.6, 1.0e-6) and near(back.b, 0.1, 1.0e-6));
    let ycc = ycbcr_from_rgb8(Rgba8.from_u32(0xff0000ff));
    @expect_eq(ycc.y, 76);
    @expect_eq(ycc.cb, 85);
    @expect_eq(ycc.cr, 255);
    let rgb = rgb8_from_ycbcr(ycc);
    @expect(rgb.r >= 254);
    @expect(rgb.g <= 1);
}

test "differences" {
    // Sharma, Wu and Dalal's CIEDE2000 test data
    let base = Lab.{ l: 50.0, a: 0.0, b: -82.7485 };
    @expect(near(delta_e2000(Lab.{ l: 50.0, a: 2.6772, b: -79.7751 }, base), 2.0425, 0.0001));
    @expect(near(delta_e2000(Lab.{ l: 50.0, a: 3.1571, b: -77.2803 }, base), 2.8615, 0.0001));
    @expect(near(delta_e2000(Lab.{ l: 50.0, a: 2.8361, b: -74.0200 }, base), 3.4412, 0.0001));
    @expect(near(delta_e2000(Lab.{ l: 50.0, a: -1.0, b: 2.0 }, Lab.{ l: 50.0, a: 0.0, b: 0.0 }), 2.3669, 0.0001));
    @expect(near(delta_e76(Lab.{ l: 50.0, a: 3.0, b: 4.0 }, Lab.{ l: 50.0, a: 0.0, b: 0.0 }), 5.0, 1.0e-6));
    @expect(near(contrast_ratio(Color.rgb(0.0, 0.0, 0.0), Color.rgb(1.0, 1.0, 1.0)), 21.0, 0.001));
}

test "blending and hdr" {
    let half = over(Color.rgba(1.0, 0.0, 0.0, 0.5), Color.rgb(0.0, 0.0, 1.0));
    @expect(near(half.r, 0.5, 1.0e-6) and near(half.b, 0.5, 1.0e-6) and near(half.a, 1.0, 1.0e-6));
    let m = mix(Color.rgb(0.0, 0.0, 0.0), Color.rgb(1.0, 1.0, 1.0), 0.25);
    @expect(near(m.g, 0.25, 1.0e-6));
    let p = Color.rgba(0.8, 0.4, 0.2, 0.5).premultiply().unpremultiply();
    @expect(near(p.r, 0.8, 1.0e-6));
    @expect(near(pq_decode(pq_encode(0.01)), 0.01, 1.0e-6));
    @expect(near(pq_encode(1.0), 1.0, 1.0e-6));
    @expect(near(pq_encode(0.01), 0.5080784, 1.0e-5));  // 100 cd/m^2
    @expect(near(hlg_decode(hlg_encode(0.3)), 0.3, 1.0e-6));
    @expect(near(hlg_encode(1.0), 1.0, 1.0e-6));
    @expect(near(tonemap_reinhard(Color.rgb(4.0, 1.0, 0.0), 4.0).r, 1.0, 1.0e-6));
    @expect(tonemap_aces(Color.rgb(100.0, 0.5, 0.0)).r <= 1.0);
}

test "parsing" {
    @expect_eq(parse_rgba8("#f80")!.to_u32(), 0xff8800ff);
    @expect_eq(parse_rgba8("#F808")!.to_u32(), 0xff880088);
    @expect_eq(parse_rgba8("#12345678")!.to_u32(), 0x12345678);
    @expect_eq(parse_rgba8(" Navy ")!.to_u32(), 0x000080ff);
    @expect_eq(parse_rgba8("transparent")!.a, 0);
    @expect_eq(parse_rgba8("rgb(10, 20, 30)")!.to_u32(), 0x0a141eff);
    @expect_eq(parse_rgba8("rgba(10,20,30,0.5)")!.to_u32(), 0x0a141e80);
    let bad: [6][]u8 = ["#12", "#ggg", "rgb(1,2)", "rgb(1,2,3,4)", "rgb(300,0,0)", "chartreuse!"];
    for b in bad {
        _ = parse_rgba8(b) catch continue;
        @trap();
    }
    let mut buf: [9]u8 = [0; 9];
    @expect_eq(format_hex(Rgba8.from_u32(0xff8000ff), buf[..]), "#ff8000");
    @expect_eq(format_hex(Rgba8.from_u32(0x01020304), buf[..]), "#01020304");
    let c = parse("#808080")!;
    @expect(near(c.r, 0.2158605, 1.0e-6));
}

test "srgb8 agrees with the exact search" {
    let mut v: f32 = 0.0;
    while v < 1.001 {
        @expect_eq(srgb8(v), search8(v));
        v = @bit_cast(f32, @bit_cast(u32, v) + 997) + 0.00001;
    }
    for i in @as(usize, 0)..255 {
        let t = THRESH8[i];
        @expect_eq(srgb8(t), search8(t));
        let below = @bit_cast(f32, @bit_cast(u32, t) - 1);
        @expect_eq(srgb8(below), search8(below));
    }
}
