// =============================================================================
// std/text/markdown/block.ax - CommonMark block structure and GFM tables, part of std/text/markdown.
// =============================================================================

import "../../collections/vec.ax" as vec;
import "../../str.ax" as strs;

// -----------------------------------------------------------------------------
// Block structure
// -----------------------------------------------------------------------------

fn document(p: *mut Parser, src: []u8) MarkdownError!void {
    let root = p.append(NONE, Kind.DOCUMENT)!;
    _ = root;
    p.current = 0;
    let mut i: usize = 0;
    while i < src.len {
        let mut e = i;
        while (e < src.len) and (src[e] != '\n') and (src[e] != '\r') {
            e += 1;
        }
        p.line.clear();
        let piece = src[i..e];
        let mut k: usize = 0;
        while k < piece.len {
            let z = strs.index_of_byte(piece[k..], 0) ?? (piece.len - k);
            p.line.push_str(piece[k..k + z])!;
            k += z;
            if k < piece.len {
                p.line.push_str("\xef\xbf\xbd")!;
                k += 1;
            }
        }
        p.line.push('\n')!;
        process_line(p)!;
        i = e;
        if (i < src.len) and (src[i] == '\r') {
            i += 1;
        }
        if (i < src.len) and (src[i] == '\n') {
            i += 1;
        }
    }
    while p.current != 0 {
        p.current = finalize(p, p.current)!;
    }
    _ = finalize(p, 0)!;
    if p.opts.gfm {
        task_items(p);
    }
}

fn process_line(p: *mut Parser) MarkdownError!void {
    p.line_number += 1;
    p.offset = 0;
    p.column = 0;
    p.first_nonspace = 0;
    p.first_nonspace_column = 0;
    p.indent = 0;
    p.blank = false;
    p.partially_consumed_tab = false;
    p.break_kill = 0;

    let mut all_matched = false;
    let last_matched = match_open_blocks(p, &mut all_matched)!;
    if last_matched == NONE {
        return;
    }
    let container = open_new_blocks(p, last_matched, all_matched)!;
    add_rest_of_line(p, container, last_matched)!;
}

// Step 1 of a line: the last open block it continues (with all_matched
// set if that is the last open block of all), or NONE if it was the
// closing fence of a code block.
fn match_open_blocks(p: *mut Parser, all_matched: *mut bool) MarkdownError!u32 {
    let mut container: u32 = 0;
    let mut matched = true;
    while true {
        let last = p.nd(container).last;
        if (last == NONE) or not p.nd(last).open {
            all_matched.* = true;
            break;
        }
        container = last;
        p.find_first_nonspace();
        let k = p.kind(container);
        if k == Kind.BLOCK_QUOTE {
            matched = (p.indent <= 3) and (p.ch(p.first_nonspace) == '>');
            if matched {
                p.advance(p.indent + 1, true);
                if is_space_or_tab(p.ch(p.offset)) {
                    p.advance(1, true);
                }
            }
        } else if k == Kind.ITEM {
            let n = p.nd(container);
            let need = @as(usize, n.marker_offset + n.padding);
            if p.indent >= need {
                p.advance(need, true);
            } else if p.blank and (n.first != NONE) {
                p.advance(p.first_nonspace - p.offset, false);
            } else {
                matched = false;
            }
        } else if k == Kind.CODE_BLOCK {
            let n = p.nd(container);
            if not n.fenced {
                if p.indent >= 4 {
                    p.advance(4, true);
                } else if p.blank {
                    p.advance(p.first_nonspace - p.offset, false);
                } else {
                    matched = false;
                }
            } else {
                let mut close: usize = 0;
                if (p.indent <= 3) and (p.ch(p.first_nonspace) == n.fence_char) {
                    close = scan_close_fence(p.line.bytes(), p.first_nonspace);
                }
                if (close > 0) and (close >= @as(usize, n.fence_len)) {
                    // the closing fence ends the line too
                    p.current = finalize(p, container)!;
                    return NONE;
                }
                let mut i = n.fence_offset;
                while (i > 0) and is_space_or_tab(p.ch(p.offset)) {
                    p.advance(1, true);
                    i -= 1;
                }
            }
        } else if k == Kind.HEADING {
            matched = false;
        } else if k == Kind.HTML_BLOCK {
            let t = p.nd(container).html_type;
            matched = (t <= 5) or not p.blank;
        } else if (k == Kind.PARAGRAPH) or (k == Kind.TABLE) {
            matched = not p.blank;
        }
        if not matched {
            container = p.nd(container).parent;
            break;
        }
    }
    return container;
}

// Step 2 of a line: opens the new blocks it starts inside parent (the
// last open block it continues): returns the innermost.
fn open_new_blocks(p: *mut Parser, parent: u32, all_matched: bool) MarkdownError!u32 {
    let mut container = parent;
    let mut maybe_lazy = p.kind(p.current) == Kind.PARAGRAPH;
    let mut ck = p.kind(container);
    while (ck != Kind.CODE_BLOCK) and (ck != Kind.HTML_BLOCK) {
        p.find_first_nonspace();
        let indented = p.indent >= 4;
        let fc = p.ch(p.first_nonspace);
        let line = p.line.bytes();
        let mut m: usize = 0;
        let mut level: u8 = 0;
        let mut html_type: u8 = 0;
        if not indented and (fc == '>') {
            p.advance(p.first_nonspace + 1 - p.offset, false);
            if is_space_or_tab(p.ch(p.offset)) {
                p.advance(1, true);
            }
            container = p.add_block(container, Kind.BLOCK_QUOTE)!;
        } else if not indented and scan_atx(line, p.first_nonspace, &mut m, &mut level) {
            p.advance(p.first_nonspace + m - p.offset, false);
            container = p.add_block(container, Kind.HEADING)!;
            p.nd(container).level = level;
        } else if not indented and scan_open_fence(line, p.first_nonspace, &mut m) {
            let fo = p.first_nonspace - p.offset;
            container = p.add_block(container, Kind.CODE_BLOCK)!;
            let n = p.nd(container);
            n.fenced = true;
            n.fence_char = fc;
            n.fence_len = @truncate(u32, m);
            n.fence_offset = @truncate(u32, fo);
            p.advance(p.first_nonspace + m - p.offset, false);
        } else if not indented and scan_html_start(line, p.first_nonspace, ck != Kind.PARAGRAPH, &mut html_type) {
            container = p.add_block(container, Kind.HTML_BLOCK)!;
            p.nd(container).html_type = html_type;
        } else if not indented and (ck == Kind.PARAGRAPH) and scan_setext(line, p.first_nonspace, &mut level) {
            if resolve_refs(p, container)! {
                let n = p.nd(container);
                n.kind = Kind.HEADING;
                n.level = level;
                p.advance(p.line.len() - 1 - p.offset, false);
            }
        } else if not indented and not ((ck == Kind.PARAGRAPH) and not all_matched) and
                  (p.break_kill <= p.first_nonspace) and
                  scan_thematic_break(line, p.first_nonspace, &mut p.break_kill) {
            container = p.add_block(container, Kind.THEMATIC_BREAK)!;
            p.advance(p.line.len() - 1 - p.offset, false);
        } else if not indented and list_start(p, &mut container, ck == Kind.PARAGRAPH)! {
            // (container is the new item)
        } else if indented and not maybe_lazy and not p.blank {
            p.advance(4, true);
            container = p.add_block(container, Kind.CODE_BLOCK)!;
        } else if not indented and (ck == Kind.PARAGRAPH) and p.opts.gfm and all_matched and
                  table_start(p, container)! {
            // (the paragraph is now the table's header)
            p.advance(p.line.len() - 1 - p.offset, false);
        } else {
            break;
        }
        ck = p.kind(container);
        if (ck == Kind.PARAGRAPH) or (ck == Kind.HEADING) or (ck == Kind.CODE_BLOCK) or (ck == Kind.TABLE) {
            break;
        }
        maybe_lazy = false;
    }
    return container;
}

// Step 3 of a line: the rest of it goes to innermost, the innermost block
// (last_matched is the last of the blocks that were open that it continues).
fn add_rest_of_line(p: *mut Parser, innermost: u32, last_matched: u32) MarkdownError!void {
    let mut container = innermost;
    p.find_first_nonspace();
    p.epoch += 1;
    if p.blank {
        let last = p.nd(container).last;
        if last != NONE {
            p.nd(last).last_line_blank = true;
        }
    }
    let ck2 = p.kind(container);
    let cn = p.nd(container);
    let llb = p.blank and (ck2 != Kind.BLOCK_QUOTE) and (ck2 != Kind.HEADING) and (ck2 != Kind.THEMATIC_BREAK) and
              not ((ck2 == Kind.CODE_BLOCK) and cn.fenced) and
              not ((ck2 == Kind.ITEM) and (cn.first == NONE) and (cn.line == p.line_number));
    cn.last_line_blank = llb;
    let mut up = cn.parent;
    while up != NONE {
        let u = p.nd(up);
        u.last_line_blank = false;
        up = u.parent;
    }

    if (p.current != last_matched) and (container == last_matched) and not p.blank and
       (p.kind(p.current) == Kind.PARAGRAPH) {
        // lazy continuation of a paragraph
        p.add_line(p.current)!;
        return;
    }
    while p.current != last_matched {
        p.current = finalize(p, p.current)!;
    }
    let k = p.kind(container);
    if k == Kind.CODE_BLOCK {
        p.add_line(container)!;
    } else if k == Kind.HTML_BLOCK {
        p.add_line(container)!;
        let t = p.nd(container).html_type;
        if html_block_ends(t, p.line.bytes(), p.first_nonspace) {
            container = finalize(p, container)!;
        }
    } else if p.blank {
        // nothing
    } else if (k == Kind.TABLE) and table_row(p, container)! {
        // (a row)
    } else if (k == Kind.PARAGRAPH) or (k == Kind.HEADING) {
        if k == Kind.HEADING {
            // (a setext heading's underline leaves the line blank, so this is ATX)
            chop_closing_hashes(p);
        }
        p.advance(p.first_nonspace - p.offset, false);
        p.add_line(container)!;
    } else {
        container = p.add_block(container, Kind.PARAGRAPH)!;
        p.advance(p.first_nonspace - p.offset, false);
        p.add_line(container)!;
    }
    p.current = container;
}

/// Drops an ATX heading's closing sequence (" ##") and trailing space
/// from the line.
fn chop_closing_hashes(p: *mut Parser) void {
    let line = p.line.bytes();
    let mut n = line.len;
    while (n > p.offset) and is_ascii_space(line[n - 1]) {
        n -= 1;
    }
    let orig = n;
    while (n > p.offset) and (line[n - 1] == '#') {
        n -= 1;
    }
    if n != orig {
        if n == p.offset {
            n = p.offset;
        } else if is_space_or_tab(line[n - 1]) {
            // keep n
        } else {
            n = orig;
        }
    }
    while (n > p.offset) and is_space_or_tab(line[n - 1]) {
        n -= 1;
    }
    p.line.truncate(n);
}

fn list_start(pr: *mut Parser, container: *mut u32, interrupts: bool) MarkdownError!bool {
    let line = pr.line.bytes();
    let pos = pr.first_nonspace;
    let c = at(line, pos);
    let mut p = pos;
    let mut ordered = false;
    let mut start: u32 = 0;
    let mut delim: u8 = 0;
    if (c == '*') or (c == '-') or (c == '+') {
        p += 1;
        if not is_ascii_space(at(line, p)) {
            return false;
        }
    } else if strs.is_digit(c) {
        let mut digits: usize = 0;
        while (digits < 9) and strs.is_digit(at(line, p)) {
            start = (start * 10) + @as(u32, line[p] - '0');
            p += 1;
            digits += 1;
        }
        if interrupts and (start != 1) {
            return false;
        }
        let d = at(line, p);
        if (d != '.') and (d != ')') {
            return false;
        }
        p += 1;
        if not is_ascii_space(at(line, p)) {
            return false;
        }
        ordered = true;
        delim = d;
    } else {
        return false;
    }
    if interrupts {
        let mut i = p;
        while is_space_or_tab(at(line, i)) {
            i += 1;
        }
        if is_line_end(at(line, i)) {
            return false;
        }
    }
    let marker = p - pos;
    pr.advance(p - pr.offset, false);
    let save_tab = pr.partially_consumed_tab;
    let save_offset = pr.offset;
    let save_column = pr.column;
    while (pr.column - save_column <= 5) and is_space_or_tab(pr.ch(pr.offset)) {
        pr.advance(1, true);
    }
    let spaces = pr.column - save_column;
    let mut padding = marker + spaces;
    if (spaces >= 5) or (spaces < 1) or is_line_end(pr.ch(pr.offset)) {
        padding = marker + 1;
        pr.offset = save_offset;
        pr.column = save_column;
        pr.partially_consumed_tab = save_tab;
        if spaces > 0 {
            pr.advance(1, true);
        }
    }
    let marker_offset = pr.indent;
    let mut cont = container.*;
    let cn = pr.nd(cont);
    if (cn.kind != Kind.LIST) or (cn.ordered != ordered) or (cn.delim != delim) or (not ordered and (cn.bullet != c)) {
        cont = pr.add_block(cont, Kind.LIST)!;
        let l = pr.nd(cont);
        l.ordered = ordered;
        l.delim = delim;
        if not ordered {
            l.bullet = c;
        }
        l.start = start;
        l.tight = false;
    }
    cont = pr.add_block(cont, Kind.ITEM)!;
    let it = pr.nd(cont);
    it.marker_offset = @truncate(u32, marker_offset);
    it.padding = @truncate(u32, padding);
    it.ordered = ordered;
    container.* = cont;
    return true;
}

// --- closing blocks ---

/// Closes a block; returns its parent.
fn finalize(p: *mut Parser, id: u32) MarkdownError!u32 {
    let n = p.nd(id);
    let parent = n.parent;
    n.open = false;
    let k = n.kind;
    if k == Kind.PARAGRAPH {
        if not resolve_refs(p, id)! {
            p.unlink(id);
        }
    } else if k == Kind.CODE_BLOCK {
        if p.nd(id).fenced {
            // the first line is the info string
            let c = p.content(id);
            let nl = strs.index_of_byte(c, '\n') ?? c.len;
            let info = trim_ascii(c[..nl]);
            let r = p.nd(id).text;
            let info_ref = unescape_into_buf(p, info)!;
            let body = @min(nl + 1, c.len);
            let n2 = p.nd(id);
            n2.info = info_ref;
            n2.text = Ref.{ off: r.off + @truncate(u32, body), len: r.len - @truncate(u32, body), raw: true };
        } else {
            // drop trailing blank lines
            let c = p.content(id);
            let mut e = c.len;
            while e > 0 {
                let mut s = e - 1;
                while (s > 0) and (c[s - 1] != '\n') {
                    s -= 1;
                }
                let mut blank = true;
                for j in s..e - 1 {
                    if not is_space_or_tab(c[j]) {
                        blank = false;
                    }
                }
                if not blank {
                    break;
                }
                e = s;
            }
            p.nd(id).text.len = @truncate(u32, e);
        }
    } else if k == Kind.HEADING {
        let c = p.content(id);
        let t = trim_ascii(c);
        let r = p.nd(id).text;
        let lead = @truncate(u32, @int_from_ptr(t.ptr) - @int_from_ptr(c.ptr));
        let n2 = p.nd(id);
        if c.len > 0 {
            n2.text = Ref.{ off: r.off + lead, len: @truncate(u32, t.len), raw: true };
        }
    } else if k == Kind.LIST {
        p.nd(id).tight = list_is_tight(p, id);
    }
    return parent;
}

/// Whether a block ends with a blank line, looking into the last items
/// of lists (memoized, so deep nesting stays linear).
fn ends_with_blank_line(p: *mut Parser, id: u32) bool {
    let mut cur = id;
    let mut result = false;
    while cur != NONE {
        let n = p.nd(cur);
        if n.eb_epoch == p.epoch {
            result = n.eb_val;
            break;
        }
        if n.last_line_blank {
            result = true;
            break;
        }
        if (n.kind == Kind.LIST) or (n.kind == Kind.ITEM) {
            cur = n.last;
        } else {
            cur = NONE;
        }
    }
    // everything on the way down has the same answer
    let mut k = id;
    while (k != NONE) and (k != cur) {
        let n = p.nd(k);
        n.eb_epoch = p.epoch;
        n.eb_val = result;
        if (n.kind == Kind.LIST) or (n.kind == Kind.ITEM) {
            k = n.last;
        } else {
            k = NONE;
        }
    }
    return result;
}

fn list_is_tight(p: *mut Parser, id: u32) bool {
    let mut item = p.nd(id).first;
    while item != NONE {
        let it = p.nd(item);
        if it.last_line_blank and (it.next != NONE) {
            return false;
        }
        let item_next = it.next;
        let mut sub = it.first;
        while sub != NONE {
            let sn = p.nd(sub).next;
            if ((item_next != NONE) or (sn != NONE)) and ends_with_blank_line(p, sub) {
                return false;
            }
            sub = sn;
        }
        item = item_next;
    }
    return true;
}

/// GFM task list items: an item whose paragraph starts "[ ] " or "[x] ".
fn task_items(p: *mut Parser) void {
    for i in 0..p.doc.nodes.len() {
        let n = p.doc.nodes.get(i);
        if (n.kind != Kind.ITEM) or (n.first == NONE) {
            continue;
        }
        let para = p.doc.nodes.get(@as(usize, n.first));
        if para.kind != Kind.PARAGRAPH {
            continue;
        }
        let c = p.content(n.first);
        if (c.len < 4) or (c[0] != '[') or (c[2] != ']') or not is_ascii_space(c[3]) {
            continue;
        }
        let x = c[1];
        if (x != ' ') and (x != 'x') and (x != 'X') {
            continue;
        }
        let mut skip: usize = 3;
        while (skip < c.len) and is_space_or_tab(c[skip]) {
            skip += 1;
        }
        let item = p.doc.nodes.get_ptr(i);
        item.task = Task.OPEN;
        if x != ' ' {
            item.task = Task.DONE;
        }
        let pp = p.nd(n.first);
        pp.text.off += @truncate(u32, skip);
        pp.text.len -= @truncate(u32, skip);
    }
}

// -----------------------------------------------------------------------------
// GFM tables (block phase)
// -----------------------------------------------------------------------------

struct Cell {
    a: usize,
    b: usize,
}

/// Splits a table row at unescaped pipes (a leading and a trailing pipe are
/// optional); the cells are trimmed.
fn row_cells(s: []u8, out: *mut vec.Vec.[Cell]) MarkdownError!void {
    out.clear();
    let mut i: usize = 0;
    let mut end = s.len;
    while (end > 0) and is_ascii_space(s[end - 1]) {
        end -= 1;
    }
    while (i < end) and is_ascii_space(s[i]) {
        i += 1;
    }
    if (i < end) and (s[i] == '|') {
        i += 1;
    }
    while i < end {
        let start = i;
        while (i < end) and (s[i] != '|') {
            if (s[i] == '\\') and (i + 1 < end) {
                i += 1;
            }
            i += 1;
        }
        let mut a = start;
        let mut b = @min(i, end);
        while (a < b) and is_ascii_space(s[a]) {
            a += 1;
        }
        while (b > a) and is_ascii_space(s[b - 1]) {
            b -= 1;
        }
        out.push(Cell.{ a: a, b: b })!;
        if i < end {
            i += 1;  // the pipe
        }
    }
}

/// A delimiter row under a paragraph whose last line has as many cells
/// makes that line a table header.
fn table_start(p: *mut Parser, para: u32) MarkdownError!bool {
    let line = p.line.bytes();
    let row = line[p.first_nonspace..line.len - 1];
    let mut cells = vec.Vec.[Cell].init();
    defer cells.deinit();
    row_cells(row, &mut cells)!;
    if cells.len() == 0 {
        return false;
    }
    let first_align = p.aligns.len();
    for c in cells.items() {
        let d = row[c.a..c.b];
        if d.len == 0 {
            p.aligns.truncate(first_align);
            return false;
        }
        let mut a: usize = 0;
        let mut b = d.len;
        let left = d[0] == ':';
        let right = d[d.len - 1] == ':';
        if left {
            a = 1;
        }
        if right and (b > a) {
            b -= 1;
        }
        if a >= b {
            p.aligns.truncate(first_align);
            return false;
        }
        for x in d[a..b] {
            if x != '-' {
                p.aligns.truncate(first_align);
                return false;
            }
        }
        let mut al = Align.NONE;
        if left and right {
            al = Align.CENTER;
        } else if left {
            al = Align.LEFT;
        } else if right {
            al = Align.RIGHT;
        }
        p.aligns.push(al)!;
    }
    let ncols = cells.len();
    // the paragraph's last line
    let c = p.content(para);
    let mut ls = c.len - 1;
    while (ls > 0) and (c[ls - 1] != '\n') {
        ls -= 1;
    }
    let header = c[ls..c.len - 1];
    row_cells(header, &mut cells)!;
    if cells.len() != ncols {
        p.aligns.truncate(first_align);
        return false;
    }
    let r = p.nd(para).text;
    if ls > 0 {
        // the lines before stay a paragraph
        let before = p.append(NONE, Kind.PARAGRAPH)!;
        let bn = p.nd(before);
        bn.text = Ref.{ off: r.off, len: @truncate(u32, ls), raw: true };
        bn.line = p.nd(para).line;
        insert_before(p.doc, para, before);
        _ = finalize(p, before)!;
    }
    let t = p.nd(para);
    t.kind = Kind.TABLE;
    t.start = @truncate(u32, ncols);
    t.fence_offset = @truncate(u32, first_align);
    t.text = Ref.{ off: r.off + @truncate(u32, ls), len: r.len - @truncate(u32, ls), raw: true };
    let hoff = r.off + @truncate(u32, ls);
    add_row(p, para, hoff, &mut cells, true)!;
    return true;
}

fn add_row(p: *mut Parser, table: u32, off: u32, cells: *vec.Vec.[Cell], header: bool) MarkdownError!void {
    let t = p.doc.nodes.get(@as(usize, table));
    let row = p.append(table, Kind.TABLE_ROW)!;
    let rn = p.nd(row);
    rn.open = false;
    rn.header = header;
    let ncols = @as(usize, t.start);
    for k in 0..ncols {
        let cell = p.append(row, Kind.TABLE_CELL)!;
        let cn = p.nd(cell);
        cn.open = false;
        cn.align = p.aligns.get(@as(usize, t.fence_offset) + k);
        if k < cells.len() {
            let c = cells.get(k);
            cn.text = Ref.{ off: off + @truncate(u32, c.a), len: @truncate(u32, c.b - c.a), raw: true };
        } else {
            cn.text = Ref.{ off: off, len: 0, raw: true };
        }
    }
}

/// Adds the line to a table as a row, unless padding it would take more
/// empty cells than the budget has left (then the table ends before it).
fn table_row(p: *mut Parser, table: u32) MarkdownError!bool {
    let line = p.line.bytes();
    let row = line[p.first_nonspace..line.len - 1];
    let mut cells = vec.Vec.[Cell].init();
    defer cells.deinit();
    row_cells(row, &mut cells)!;
    let ncols = @as(usize, p.nd(table).start);
    let pad = ncols - @min(ncols, cells.len());
    if pad > p.table_budget {
        return false;
    }
    p.table_budget -= pad;
    let off = p.doc.raw.len();
    p.doc.raw.push_str(row)!;
    add_row(p, table, @truncate(u32, off), &mut cells, false)!;
    return true;
}
