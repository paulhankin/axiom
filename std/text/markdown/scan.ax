// =============================================================================
// std/text/markdown/scan.ax - Block-start, HTML tag, entity, and escape scanners, part of std/text/markdown.
// =============================================================================

import "../../str.ax" as strs;
import "../internal/html/entities.ax" as ent;

// -----------------------------------------------------------------------------
// Block starts
// -----------------------------------------------------------------------------

/// An ATX heading opener: 1-6 '#' then a space, tab or the end of the line.
/// m gets the length of the opener with the spaces after it.
fn scan_atx(s: []u8, p: usize, m: *mut usize, level: *mut u8) bool {
    let mut i = p;
    while (i < s.len) and (s[i] == '#') and (i - p < 7) {
        i += 1;
    }
    let n = i - p;
    if (n == 0) or (n > 6) {
        return false;
    }
    let c = at(s, i);
    if not is_space_or_tab(c) and not is_line_end(c) {
        return false;
    }
    while is_space_or_tab(at(s, i)) {
        i += 1;
    }
    m.* = i - p;
    level.* = @truncate(u8, n);
    return true;
}

fn scan_open_fence(s: []u8, p: usize, m: *mut usize) bool {
    let c = at(s, p);
    if (c != '`') and (c != '~') {
        return false;
    }
    let mut i = p;
    while at(s, i) == c {
        i += 1;
    }
    if i - p < 3 {
        return false;
    }
    if c == '`' {
        let mut j = i;
        while not is_line_end(at(s, j)) {
            if s[j] == '`' {
                return false;
            }
            j += 1;
        }
    }
    m.* = i - p;
    return true;
}

/// A closing fence at s[p..]: its length, or 0.
fn scan_close_fence(s: []u8, p: usize) usize {
    let c = at(s, p);
    let mut i = p;
    while at(s, i) == c {
        i += 1;
    }
    let n = i - p;
    if n < 3 {
        return 0;
    }
    while is_space_or_tab(at(s, i)) {
        i += 1;
    }
    if not is_line_end(at(s, i)) {
        return 0;
    }
    return n;
}

fn scan_setext(s: []u8, p: usize, level: *mut u8) bool {
    let c = at(s, p);
    if (c != '=') and (c != '-') {
        return false;
    }
    let mut i = p;
    while at(s, i) == c {
        i += 1;
    }
    while is_space_or_tab(at(s, i)) {
        i += 1;
    }
    if not is_line_end(at(s, i)) {
        return false;
    }
    level.* = 2;
    if c == '=' {
        level.* = 1;
    }
    return true;
}

fn scan_thematic_break(s: []u8, p: usize, kill: *mut usize) bool {
    let c = at(s, p);
    if (c != '*') and (c != '-') and (c != '_') {
        return false;
    }
    let mut n: usize = 0;
    let mut i = p;
    while not is_line_end(at(s, i)) {
        if s[i] == c {
            n += 1;
        } else if not is_space_or_tab(s[i]) {
            kill.* = i;
            return false;
        }
        i += 1;
    }
    if n < 3 {
        kill.* = i;
    }
    return n >= 3;
}

pub let BLOCK_TAGS: [62][]u8 = [
    "address",
    "article",
    "aside",
    "base",
    "basefont",
    "blockquote",
    "body",
    "caption",
    "center",
    "col",
    "colgroup",
    "dd",
    "details",
    "dialog",
    "dir",
    "div",
    "dl",
    "dt",
    "fieldset",
    "figcaption",
    "figure",
    "footer",
    "form",
    "frame",
    "frameset",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "head",
    "header",
    "hr",
    "html",
    "iframe",
    "legend",
    "li",
    "link",
    "main",
    "menu",
    "menuitem",
    "nav",
    "noframes",
    "ol",
    "optgroup",
    "option",
    "p",
    "param",
    "search",
    "section",
    "summary",
    "table",
    "tbody",
    "td",
    "tfoot",
    "th",
    "thead",
    "title",
    "tr",
    "track",
    "ul",
];

fn tag_in(name: []u8, list: [][]u8) bool {
    if name.len > 16 {
        return false;
    }
    let mut low: [16]u8 = [0; 16];
    for k in 0..name.len {
        low[k] = lower(name[k]);
    }
    for t in list {
        if @mem_eq(low[..name.len], t) {
            return true;
        }
    }
    return false;
}

pub let RAW_TAGS: [4][]u8 = ["pre", "script", "style", "textarea"];

/// The start of an HTML block (kinds 1 to 7 of the specification; 7 only
/// where it may interrupt).
fn scan_html_start(s: []u8, p: usize, allow7: bool, kind: *mut u8) bool {
    if at(s, p) != '<' {
        return false;
    }
    if has_prefix(s, p, "<!--") {
        kind.* = 2;
        return true;
    }
    if has_prefix(s, p, "<?") {
        kind.* = 3;
        return true;
    }
    if has_prefix(s, p, "<![CDATA[") {
        kind.* = 5;
        return true;
    }
    if (at(s, p + 1) == '!') and strs.is_alpha(at(s, p + 2)) {
        kind.* = 4;
        return true;
    }
    let mut i = p + 1;
    let closing = at(s, i) == '/';
    if closing {
        i += 1;
    }
    let ns = i;
    while strs.is_alnum(at(s, i)) {
        i += 1;
    }
    let name = s[ns..i];
    let after = at(s, i);
    if not closing and tag_in(name, RAW_TAGS[..]) and (is_ascii_space(after) or (after == '>') or (after == 0)) {
        kind.* = 1;
        return true;
    }
    if (name.len > 0) and tag_in(name, BLOCK_TAGS[..]) and
       (is_ascii_space(after) or (after == '>') or (after == 0) or ((after == '/') and (at(s, i + 1) == '>'))) {
        kind.* = 6;
        return true;
    }
    if allow7 {
        let n = scan_tag(s, p);
        if n > 0 {
            let mut j = p + n;
            while is_space_or_tab(at(s, j)) or (at(s, j) == 12) {
                j += 1;
            }
            if is_line_end(at(s, j)) {
                kind.* = 7;
                return true;
            }
        }
    }
    return false;
}

fn contains_ci(s: []u8, from: usize, needle: []u8) bool {
    let mut i = from;
    while i + needle.len <= s.len {
        if has_prefix_ci(s, i, needle) {
            return true;
        }
        i += 1;
    }
    return false;
}

fn html_block_ends(kind: u8, s: []u8, p: usize) bool {
    if kind == 1 {
        return contains_ci(s, p, "</script>") or contains_ci(s, p, "</pre>") or contains_ci(s, p, "</style>") or
               contains_ci(s, p, "</textarea>");
    }
    if kind == 2 {
        return contains_ci(s, p, "-->");
    }
    if kind == 3 {
        return contains_ci(s, p, "?>");
    }
    if kind == 4 {
        return contains_ci(s, p, ">");
    }
    if kind == 5 {
        return contains_ci(s, p, "]]>");
    }
    return false;
}

// -----------------------------------------------------------------------------
// HTML tags (for kind 7 blocks and raw inline HTML)
// -----------------------------------------------------------------------------

fn is_tag_space(c: u8) bool {
    return (c == ' ') or (c == '\t') or (c == '\n') or (c == '\r') or (c == 12) or (c == 11);
}

/// An open or closing tag at s[p] ('<'): its length, or 0.
fn scan_tag(s: []u8, p: usize) usize {
    let mut i = p + 1;
    if at(s, i) == '/' {
        i += 1;
        if not strs.is_alpha(at(s, i)) {
            return 0;
        }
        while strs.is_alnum(at(s, i)) or (at(s, i) == '-') {
            i += 1;
        }
        while is_tag_space(at(s, i)) {
            i += 1;
        }
        if at(s, i) != '>' {
            return 0;
        }
        return i + 1 - p;
    }
    if not strs.is_alpha(at(s, i)) {
        return 0;
    }
    while strs.is_alnum(at(s, i)) or (at(s, i) == '-') {
        i += 1;
    }
    // attributes
    while true {
        let ws = i;
        while is_tag_space(at(s, i)) {
            i += 1;
        }
        let c = at(s, i);
        if (i == ws) or not (strs.is_alpha(c) or (c == '_') or (c == ':')) {
            i = ws;
            break;
        }
        i += 1;
        while strs.is_alnum(at(s, i)) or (at(s, i) == '_') or (at(s, i) == '.') or (at(s, i) == ':') or
              (at(s, i) == '-') {
            i += 1;
        }
        // value
        let before = i;
        while is_tag_space(at(s, i)) {
            i += 1;
        }
        if at(s, i) != '=' {
            i = before;
            continue;
        }
        i += 1;
        while is_tag_space(at(s, i)) {
            i += 1;
        }
        let q = at(s, i);
        if (q == '"') or (q == '\'') {
            i += 1;
            while (i < s.len) and (s[i] != q) {
                i += 1;
            }
            if i >= s.len {
                return 0;
            }
            i += 1;
        } else {
            let vs = i;
            while i < s.len {
                let v = s[i];
                if is_tag_space(v) or (v == '"') or (v == '\'') or (v == '=') or (v == '<') or (v == '>') or
                   (v == '`') or (v == 0) {
                    break;
                }
                i += 1;
            }
            if i == vs {
                return 0;
            }
        }
    }
    while is_tag_space(at(s, i)) {
        i += 1;
    }
    if at(s, i) == '/' {
        i += 1;
    }
    if at(s, i) != '>' {
        return 0;
    }
    return i + 1 - p;
}

fn find_from(s: []u8, from: usize, needle: []u8) i64 {
    let i = strs.index_of_from(s, needle, from) ?? return -1;
    return @int_cast(i64, i);
}

/// Raw HTML at s[p] ('<') that is not an open or closing tag: its length or 0.
fn scan_html_other(pr: *mut Parser, p: usize) usize {
    let s = pr.s;
    if has_prefix(s, p, "<!--") {
        if has_prefix(s, p, "<!-->") {
            return 5;
        }
        if has_prefix(s, p, "<!--->") {
            return 6;
        }
        if pr.no_comment_end {
            return 0;
        }
        let e = find_from(s, p + 4, "-->");
        if e < 0 {
            pr.no_comment_end = true;
            return 0;
        }
        return @truncate(usize, @bit_cast(u64, e)) + 3 - p;
    }
    if has_prefix(s, p, "<?") {
        if pr.no_pi_end {
            return 0;
        }
        let e = find_from(s, p + 2, "?>");
        if e < 0 {
            pr.no_pi_end = true;
            return 0;
        }
        return @truncate(usize, @bit_cast(u64, e)) + 2 - p;
    }
    if has_prefix(s, p, "<![CDATA[") {
        if pr.no_cdata_end {
            return 0;
        }
        let e = find_from(s, p + 9, "]]>");
        if e < 0 {
            pr.no_cdata_end = true;
            return 0;
        }
        return @truncate(usize, @bit_cast(u64, e)) + 3 - p;
    }
    if (at(s, p + 1) == '!') and strs.is_alpha(at(s, p + 2)) {
        if pr.no_decl_end {
            return 0;
        }
        let e = find_from(s, p + 2, ">");
        if e < 0 {
            pr.no_decl_end = true;
            return 0;
        }
        return @truncate(usize, @bit_cast(u64, e)) + 1 - p;
    }
    return 0;
}

// -----------------------------------------------------------------------------
// Entities and escapes
// -----------------------------------------------------------------------------

fn entity_lookup(name: []u8) i64 {
    let mut lo: usize = 0;
    let mut hi: usize = ent.COUNT;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let k = ent.NAMES[@as(usize, ent.OFFSET[mid])..@as(usize, ent.OFFSET[mid + 1])];
        let c = strs.compare(k, name);
        if c == 0 {
            return @int_cast(i64, mid);
        }
        if c < 0 {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return -1;
}

/// An entity or numeric character reference at s[i] ('&'): its length (0
/// if there is none) and its code points.
fn scan_entity(s: []u8, i: usize, cp1: *mut u32, cp2: *mut u32) usize {
    let mut j = i + 1;
    cp2.* = 0;
    if at(s, j) == '#' {
        j += 1;
        let mut v: u32 = 0;
        let mut digits: usize = 0;
        if (at(s, j) == 'x') or (at(s, j) == 'X') {
            j += 1;
            while strs.is_hex_digit(at(s, j)) and (digits < 6) {
                let c = at(s, j);
                let mut d = @as(u32, c - '0');
                if c >= 'a' {
                    d = @as(u32, c - 'a') + 10;
                } else if c >= 'A' {
                    d = @as(u32, c - 'A') + 10;
                }
                v = (v * 16) + d;
                j += 1;
                digits += 1;
            }
        } else {
            while strs.is_digit(at(s, j)) and (digits < 7) {
                v = (v * 10) + @as(u32, at(s, j) - '0');
                j += 1;
                digits += 1;
            }
        }
        if (digits == 0) or (at(s, j) != ';') {
            return 0;
        }
        if (v == 0) or (v > 0x10ffff) or ((v >= 0xd800) and (v < 0xe000)) {
            v = 0xfffd;
        }
        cp1.* = v;
        return j + 1 - i;
    }
    while strs.is_alnum(at(s, j)) and (j - i <= 32) {
        j += 1;
    }
    if (j == i + 1) or (at(s, j) != ';') {
        return 0;
    }
    let k = entity_lookup(s[i + 1..j]);
    if k < 0 {
        return 0;
    }
    cp1.* = ent.FIRST[@truncate(usize, @bit_cast(u64, k))];
    cp2.* = ent.SECOND[@truncate(usize, @bit_cast(u64, k))];
    return j + 1 - i;
}

/// Appends s with backslash escapes and entities decoded.
fn unescape_to(out: *mut strs.String, s: []u8) MarkdownError!void {
    let mut i: usize = 0;
    let mut run: usize = 0;
    while i < s.len {
        let c = s[i];
        if (c == '\\') and (i + 1 < s.len) and is_ascii_punct(s[i + 1]) {
            out.push_str(s[run..i])!;
            out.push(s[i + 1])!;
            i += 2;
            run = i;
        } else if c == '&' {
            let mut a: u32 = 0;
            let mut b: u32 = 0;
            let n = scan_entity(s, i, &mut a, &mut b);
            if n > 0 {
                out.push_str(s[run..i])!;
                out.push_rune(a)!;
                if b != 0 {
                    out.push_rune(b)!;
                }
                i += n;
                run = i;
            } else {
                i += 1;
            }
        } else {
            i += 1;
        }
    }
    out.push_str(s[run..])!;
}

/// Appends s with entities (but not backslash escapes) decoded.
fn unescape_entities_to(out: *mut strs.String, s: []u8) MarkdownError!void {
    let mut i: usize = 0;
    let mut run: usize = 0;
    while i < s.len {
        if s[i] == '&' {
            let mut a: u32 = 0;
            let mut b: u32 = 0;
            let n = scan_entity(s, i, &mut a, &mut b);
            if n > 0 {
                out.push_str(s[run..i])!;
                out.push_rune(a)!;
                if b != 0 {
                    out.push_rune(b)!;
                }
                i += n;
                run = i;
                continue;
            }
        }
        i += 1;
    }
    out.push_str(s[run..])!;
}
