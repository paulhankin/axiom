    "viewBox",
    "viewTarget",
    "xChannelSelector",
    "yChannelSelector",
    "zoomAndPan",
];

fn svg_tag_name(name: []u8) []u8 {
    for x in SVG_TAGS {
        if strs.eq_ignore_case(x, name) {
            return x;
        }
    }
    return name;
}

fn svg_attr_name(name: []u8) []u8 {
    for x in SVG_ATTRS {
        if strs.eq_ignore_case(x, name) {
            return x;
        }
    }
    return name;
}

let BREAKOUT: [44]u16 = [
    tags.T_B,
    tags.T_BIG,
    tags.T_BLOCKQUOTE,
    tags.T_BODY,
    tags.T_BR,
    tags.T_CENTER,
    tags.T_CODE,
    tags.T_DD,
    tags.T_DIV,
    tags.T_DL,
    tags.T_DT,
    tags.T_EM,
    tags.T_EMBED,
    tags.T_H1,
    tags.T_H2,
    tags.T_H3,
    tags.T_H4,
    tags.T_H5,
    tags.T_H6,
    tags.T_HEAD,
    tags.T_HR,
    tags.T_I,
    tags.T_IMG,
    tags.T_LI,
    tags.T_LISTING,
    tags.T_MENU,
    tags.T_META,
    tags.T_NOBR,
    tags.T_OL,
    tags.T_P,
    tags.T_PRE,
    tags.T_RUBY,
    tags.T_S,
    tags.T_SMALL,
    tags.T_SPAN,
    tags.T_STRONG,
    tags.T_STRIKE,
    tags.T_SUB,
    tags.T_SUP,
    tags.T_TABLE,
    tags.T_TT,
    tags.T_U,
    tags.T_UL,
    tags.T_VAR,
];

fn foreign(p: *mut Parser, t: *mut Token) HtmlError!bool {
    let k = t.kind;
    if k == TokenKind.CHARS {
        p.sbuf.clear();
        let mut text = false;
        for c in t.data {
            if c == 0 {
                p.sbuf.push_str("\xef\xbf\xbd")!;
            } else {
                p.sbuf.push(c)!;
                if not is_ws(c) {
                    text = true;
                }
            }
        }
        p.insert_text(p.sbuf.bytes())!;
        if text {
            p.frameset_ok = false;
        }
        return false;
    }
    if k == TokenKind.COMMENT {
        p.insert_comment(t, p.place(NONE))!;
        return false;
    }
    if k == TokenKind.DOCTYPE {
        return false;
    }
    let mut breakout = (k == TokenKind.START) and tag_in(t, BREAKOUT[..]);
    if is_start(t, tags.T_FONT) {
        for a in t.attrs {
            if strs.eq(a.name, "color") or strs.eq(a.name, "face") or strs.eq(a.name, "size") {
                breakout = true;
            }
        }
    }
    if is_end(t, tags.T_BR) or is_end(t, tags.T_P) {
        breakout = true;
    }
    if breakout {
        while p.stack.len() > 1 {
            let c = p.cur();
            if p.mathml_text_ip(c) or p.html_ip(c) or (p.nd(c).ns == Namespace.HTML) {
                break;
            }
            p.pop();
        }
        return step(p, p.mode, t);
    }
    if k == TokenKind.START {
        let ns = p.nd(p.adjusted_current()).ns;
        let id = p.insert(t, ns)!;
        if t.self_closing and p.opened(id) {
            p.pop();
        }
        return false;
    }
    if k == TokenKind.END {
        let mut i = p.stack.len() - 1;
        loop {
            if i == 0 {
                return false;
            }
            let id = p.stack.items()[i];
            if strs.eq_ignore_case(p.nd(id).name, t.name) {
                p.pop_until_node(id);
                return false;
            }
            i -= 1;
            if p.nd(p.stack.items()[i]).ns == Namespace.HTML {
                return step(p, p.mode, t);
            }
        }
    }
    return false;
}
