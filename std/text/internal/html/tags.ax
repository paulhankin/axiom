pub const F_SPECIAL: u8 = 1;  // in the "special" category (HTML namespace)
pub const F_FORMATTING: u8 = 2;
pub const F_IMPLIED: u8 = 4;   // closed by "generate implied end tags"
pub const F_THOROUGH: u8 = 8;  // ... and by "generate all implied end tags thoroughly"
pub const F_SCOPE: u8 = 16;    // bounds "in scope" (HTML namespace)
pub const F_VOID: u8 = 32;     // serializes without an end tag
pub const F_RAW: u8 = 64;      // text children serialize unescaped

