/// The T_ constant for a (lowercase) tag name, or 0.
pub fn tag_of(name: []u8) u16 {
    let mut lo: usize = 0;
    let mut hi: usize = TAG_NAMES.len;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let c = strs.compare(TAG_NAMES[mid], name);
        if c == 0 {
            return @truncate(u16, mid + 1);
        }
        if c < 0 {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return 0;
}
