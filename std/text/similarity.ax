// =============================================================================
// std/text/similarity.ax - string distances, similarity ratios and fuzzy
// matching.
//
//     similarity.levenshtein("kitten", "sitting")!          // 3 (bytes)
//     let a = similarity.runes("naïve")!;                   // code points
//     defer mem.free(a);
//     let b = similarity.runes("naive")!;
//     defer mem.free(b);
//     similarity.levenshtein(a, b)!                         // 1 (2 in bytes)
//     similarity.levenshtein_bounded(x, y, 2)!              // 3 means "more than 2"
//     similarity.jaro_winkler("MARTHA", "MARHTA")!          // 0.961...
//     similarity.ratio("abcd", "bcde")!                     // 0.75, as difflib
//     let ms = similarity.fuzzy_find("fb", names[..])!;     // best matches first
//     defer mem.free(ms);
//
// Units. The distances and ratios are generic over the element type: a
// []u8 string is compared byte by byte, and runes() decodes UTF-8 into code
// points ([]u32) to compare characters instead (invalid bytes become
// U+FFFD). Any other slice of comparable values works too (tokens, line
// hashes). The fuzzy finder always works on the code points of UTF-8 text.
//
// Distances (each O(len a x len b) time):
//   levenshtein           insertions, deletions and substitutions; the
//                         _bounded form stops once the distance must exceed
//                         a limit (only a band of the table is computed)
//   osa_distance          also transpositions of adjacent elements, each
//                         substring edited at most once (optimal string
//                         alignment, the "restricted" Damerau-Levenshtein)
//   damerau_levenshtein   transpositions without that restriction
//                         (Lowrance and Wagner); "CA" -> "ABC" is 2, not 3
//   hamming               substitutions only, for equal lengths
// Similarities in [0, 1]: jaro, jaro_winkler (prefix scale 0.1 over at
// most 4 elements, applied above 0.7, as Winkler), levenshtein_similarity
// (1 - distance / longer length), and ratio, Python's
// difflib.SequenceMatcher(None, a, b).ratio() exactly (the same matching
// blocks, the automatic junk heuristic for b of 200 or more elements
// included; matching_blocks gives the blocks).
// Common parts: lcs_length and lcs (Hirschberg's algorithm, linear
// space), longest_common_substring.
//
// Fuzzy finding (fuzzy_score, fuzzy_positions, fuzzy_find) matches a
// query as a subsequence of each candidate, as fzf and editors' file
// pickers do: case-insensitive unless the query has an upper-case letter
// ("smart case"), scored by dynamic programming over all alignments with
// bonuses for matches at word starts (after a space, punctuation or a
// path separator, at a lower-to-upper case change, at the start) and for
// runs of consecutive matches, and penalties for gaps. The scoring
// constants follow fzf's.
//
// Checked against Python: difflib's ratio and matching blocks, and
// reference implementations of the distances (std/text/similarity/testdata,
// from tests/internal/tools/gen_similarity_tests.py); Jaro-Winkler against Winkler's
// published examples.
// =============================================================================

import "../collections/vec.ax" as vec;
import "../fmt.ax" as fmt;
import "../mem.ax" as mem;
import "../os/fs.ax" as fs;
import "../str.ax" as strs;
import "../unicode.ax" as uni;

error { LengthMismatch, NoMatch, OutOfMemory }

/// The code points of UTF-8 text (invalid bytes as U+FFFD); free with mem.free.
pub fn runes(s: []u8) ![]mut u32 {
    let out = mem.alloc.[u32](strs.rune_count(s))!;
    let mut i: usize = 0;
    let mut k: usize = 0;
    while i < s.len {
        let r = strs.decode_rune(s[i..]);
        out[k] = r.value;
        k += 1;
        i += r.len;
    }
    return out[..k];
}

fn min3(a: usize, b: usize, c: usize) usize {
    return @min(@min(a, b), c);
}

// -----------------------------------------------------------------------------
// Edit distances
// -----------------------------------------------------------------------------

/// The Levenshtein distance: the fewest insertions, deletions and
/// substitutions that turn a into b.
pub fn levenshtein[T: Eq](a: []T, b: []T) !usize {
    return levenshtein_bounded(a, b, @max(a.len, b.len))!;
}

/// The Levenshtein distance if it is at most max, else max + 1. Takes
/// O(max x min(len a, len b)) time.
pub fn levenshtein_bounded[T: Eq](a: []T, b: []T, max: usize) !usize {
    // rows run along the shorter sequence
    let mut x = a;
    let mut y = b;
    if b.len > a.len {
        x = b;
        y = a;
    }
    let n = x.len;
    let m = y.len;
    let cap = @add_sat(max, 1);
    if (n - m) > max {
        return cap;
    }
    if m == 0 {
        return n;
    }
    let row = mem.alloc.[usize](m + 1)!;
    defer mem.free(row);
    for j in @as(usize, 0)..m + 1 {
        row[j] = @min(j, cap);
    }
    for i in @as(usize, 1)..n + 1 {
        let mut lo: usize = 1;
        if i > max {
            lo = i - max;
        }
        let hi = @min(m, @add_sat(i, max));
        let mut diag = row[lo - 1];
        if lo == 1 {
            row[0] = @min(i, cap);
        } else {
            row[lo - 1] = cap;  // left of the band
        }
        let mut best = row[lo - 1];
        let xi = x[i - 1];
        for j in lo..hi + 1 {
            let up = row[j];
            let mut v = @min(up, row[j - 1]) + 1;
            if xi == y[j - 1] {
                v = @min(v, diag);
            } else {
                v = @min(v, diag + 1);
            }
            v = @min(v, cap);
            diag = up;
            row[j] = v;
            best = @min(best, v);
        }
        if hi < m {
            row[hi + 1] = cap;  // right of the band: not computed
        }
        if best >= cap {
            return cap;
        }
    }
    return @min(row[m], cap);
}

/// The optimal string alignment distance: Levenshtein's operations plus
/// transposition of two adjacent elements, no substring edited twice.
pub fn osa_distance[T: Eq](a: []T, b: []T) !usize {
    let n = a.len;
    let m = b.len;
    if (n == 0) or (m == 0) {
        return n + m;
    }
    let buf = mem.alloc.[usize](3 * (m + 1))!;
    defer mem.free(buf);
    let mut r0 = buf[0..m + 1];            // row i - 2
    let mut r1 = buf[m + 1..(2 * m) + 2];  // row i - 1
    let mut r2 = buf[(2 * m) + 2..];       // row i
    for j in @as(usize, 0)..m + 1 {
        r1[j] = j;
    }
    for i in @as(usize, 1)..n + 1 {
        r2[0] = i;
        for j in @as(usize, 1)..m + 1 {
            let mut cost: usize = 1;
            if a[i - 1] == b[j - 1] {
                cost = 0;
            }
            let mut v = min3(r1[j] + 1, r2[j - 1] + 1, r1[j - 1] + cost);
            if ((i > 1) and (j > 1)) and ((a[i - 1] == b[j - 2]) and (a[i - 2] == b[j - 1])) {
                v = @min(v, r0[j - 2] + 1);
            }
            r2[j] = v;
        }
        let t = r0;
        r0 = r1;
        r1 = r2;
        r2 = t;
    }
    return r1[m];
}

fn less_than[T: Ord](x: T, y: T) bool {
    return x < y;
}

/// The index of v in sorted (which holds it).
fn find_sorted[T: Ord](sorted: []T, v: T) usize {
    let mut lo: usize = 0;
    let mut hi = sorted.len;
    while lo < hi {
        let mid = lo + ((hi - lo) / 2);
        if sorted[mid] < v {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// The Damerau-Levenshtein distance: insertions, deletions, substitutions
/// and transpositions of adjacent elements, with no restriction on editing
/// a substring again (Lowrance and Wagner's algorithm). O(n m) memory.
pub fn damerau_levenshtein[T: Ord](a: []T, b: []T) !usize {
    let n = a.len;
    let m = b.len;
    if (n == 0) or (m == 0) {
        return n + m;
    }
    // the alphabet, sorted, so elements map to small indices
    let alpha = mem.alloc.[T](n + m)!;
    defer mem.free(alpha);
    @mem_copy(alpha[..n], a);
    @mem_copy(alpha[n..], b);
    vec.sort.[T](alpha, less_than.[T]);
    let mut k: usize = 0;
    for i in @as(usize, 0)..alpha.len {
        if (i == 0) or (alpha[i] != alpha[k - 1]) {
            alpha[k] = alpha[i];
            k += 1;
        }
    }
    let sigma = alpha[..k];
    let da = mem.alloc.[usize](k)!;  // the last row where each element was seen in a
    defer mem.free(da);
    @mem_set(da, 0);
    // d[(i + 1) * w + (j + 1)] is the distance from a[..i] to b[..j]; row and column 0 are "infinity"
    let w = m + 2;
    let size = @mul_checked(n + 2, w) catch return error.OutOfMemory;
    let d = mem.alloc.[usize](size)!;
    defer mem.free(d);
    let inf = n + m;
    d[0] = inf;
    for i in @as(usize, 0)..n + 1 {
        d[(i + 1) * w] = inf;
        d[((i + 1) * w) + 1] = i;
    }
    for j in @as(usize, 0)..m + 1 {
        d[j + 1] = inf;
        d[w + (j + 1)] = j;
    }
    for i in @as(usize, 1)..n + 1 {
        let mut db: usize = 0;
        for j in @as(usize, 1)..m + 1 {
            let i1 = da[find_sorted(sigma, b[j - 1])];
            let j1 = db;
            let mut cost: usize = 1;
            if a[i - 1] == b[j - 1] {
                cost = 0;
                db = j;
            }
            let sub = d[(i * w) + j] + cost;
            let ins = d[((i + 1) * w) + j] + 1;
            let del = d[(i * w) + (j + 1)] + 1;
            let tr = d[(i1 * w) + j1] + (((i - i1) - 1) + 1) + ((j - j1) - 1);
            d[((i + 1) * w) + (j + 1)] = @min(min3(sub, ins, del), tr);
        }
        da[find_sorted(sigma, a[i - 1])] = i;
    }
    return d[((n + 1) * w) + (m + 1)];
}

/// The number of positions where a and b differ; LengthMismatch unless
/// they are equally long.
pub fn hamming[T: Eq](a: []T, b: []T) !usize {
    if a.len != b.len {
        return error.LengthMismatch;
    }
    let mut n: usize = 0;
    for i in @as(usize, 0)..a.len {
        if a[i] != b[i] {
            n += 1;
        }
    }
    return n;
}

/// 1 - levenshtein(a, b) / max(len a, len b); 1 for two empty sequences.
pub fn levenshtein_similarity[T: Eq](a: []T, b: []T) !f64 {
    let n = @max(a.len, b.len);
    if n == 0 {
        return 1.0;
    }
    let d = levenshtein(a, b)!;
    return 1.0 - (@float_from_int(f64, d) / @float_from_int(f64, n));
}

// -----------------------------------------------------------------------------
// Jaro and Jaro-Winkler
// -----------------------------------------------------------------------------

/// The Jaro similarity: 1 for equal sequences, 0 for nothing in common.
pub fn jaro[T: Eq](a: []T, b: []T) !f64 {
    let n = a.len;
    let m = b.len;
    if (n == 0) and (m == 0) {
        return 1.0;
    }
    if (n == 0) or (m == 0) {
        return 0.0;
    }
    let mut window: usize = 0;
    if (@max(n, m) / 2) > 0 {
        window = (@max(n, m) / 2) - 1;
    }
    let flags = mem.alloc.[bool](n + m)!;
    defer mem.free(flags);
    @mem_set(flags, false);
    let fa = flags[..n];
    let fb = flags[n..];
    let mut matches: usize = 0;
    for i in @as(usize, 0)..n {
        let mut lo: usize = 0;
        if i > window {
            lo = i - window;
        }
        let hi = @min(m, (i + window) + 1);
        for j in lo..hi {
            if (not fb[j]) and (a[i] == b[j]) {
                fa[i] = true;
                fb[j] = true;
                matches += 1;
                break;
            }
        }
    }
    if matches == 0 {
        return 0.0;
    }
    // half the matched elements out of order
    let mut t: usize = 0;
    let mut j: usize = 0;
    for i in @as(usize, 0)..n {
        if fa[i] {
            while not fb[j] {
                j += 1;
            }
            if a[i] != b[j] {
                t += 1;
            }
            j += 1;
        }
    }
    let mf = @float_from_int(f64, matches);
    let tf = @float_from_int(f64, t / 2);
    return (((mf / @float_from_int(f64, n)) + (mf / @float_from_int(f64, m))) + ((mf - tf) / mf)) / 3.0;
}

/// The Jaro-Winkler similarity: jaro, raised for a common prefix (up to 4
/// elements, scale 0.1) when it is above 0.7.
pub fn jaro_winkler[T: Eq](a: []T, b: []T) !f64 {
    let j = jaro(a, b)!;
    if j <= 0.7 {
        return j;
    }
    let mut l: usize = 0;
    while ((l < 4) and (l < a.len)) and ((l < b.len) and (a[l] == b[l])) {
        l += 1;
    }
    return j + ((@float_from_int(f64, l) * 0.1) * (1.0 - j));
}

// -----------------------------------------------------------------------------
// Longest common subsequence and substring
// -----------------------------------------------------------------------------

/// The length of a longest common subsequence.
pub fn lcs_length[T: Eq](a: []T, b: []T) !usize {
    let row = mem.alloc.[usize](b.len + 1)!;
    defer mem.free(row);
    lcs_forward(a, b, row);
    return row[b.len];
}

// row[j] = LCS length of a and b[..j]
fn lcs_forward[T: Eq](a: []T, b: []T, row: []mut usize) void {
    @mem_set(row, 0);
    for i in @as(usize, 0)..a.len {
        let mut diag: usize = 0;
        for j in @as(usize, 1)..b.len + 1 {
            let up = row[j];
            if a[i] == b[j - 1] {
                row[j] = diag + 1;
            } else {
                row[j] = @max(up, row[j - 1]);
            }
            diag = up;
        }
    }
}

// row[j] = LCS length of a and b[j..]
fn lcs_backward[T: Eq](a: []T, b: []T, row: []mut usize) void {
    @mem_set(row, 0);
    let m = b.len;
    let mut i = a.len;
    while i > 0 {
        i -= 1;
        let mut diag: usize = 0;
        let mut j = m;
        while j > 0 {
            j -= 1;
            let down = row[j];
            if a[i] == b[j] {
                row[j] = diag + 1;
            } else {
                row[j] = @max(down, row[j + 1]);
            }
            diag = down;
        }
    }
}

/// A longest common subsequence of a and b (Hirschberg's algorithm: O(n m)
/// time, O(n + m) space); free with mem.free.
pub fn lcs[T: Eq](a: []T, b: []T) ![]mut T {
    let n = lcs_length(a, b)!;
    let out = mem.alloc.[T](n)!;
    let rows = mem.alloc.[usize](2 * (b.len + 1)) catch |e| {
        mem.free(out);
        return e;
    };
    defer mem.free(rows);
    let mut at: usize = 0;
    hirschberg(a, b, out, &mut at, rows);
    return out;
}

fn hirschberg[T: Eq](a: []T, b: []T, out: []mut T, at: *mut usize, rows: []mut usize) void {
    if (a.len == 0) or (b.len == 0) {
        return;
    }
    if a.len == 1 {
        for x in b {
            if x == a[0] {
                out[at.*] = a[0];
                at.* += 1;
                return;
            }
        }
        return;
    }
    let mid = a.len / 2;
    let m = b.len;
    let f = rows[..m + 1];
    let g = rows[m + 1..(2 * m) + 2];
    lcs_forward(a[..mid], b, f);
    lcs_backward(a[mid..], b, g);
    let mut k: usize = 0;
    let mut best: usize = 0;
    for j in @as(usize, 0)..m + 1 {
        if (f[j] + g[j]) > best {
            best = f[j] + g[j];
            k = j;
        }
    }
    hirschberg(a[..mid], b[..k], out, at, rows);
    hirschberg(a[mid..], b[k..], out, at, rows);
}

/// Where a longest common substring is: a[a_start..a_start + len] ==
/// b[b_start..b_start + len].
pub struct Substring {
    a_start: usize,
    b_start: usize,
    len: usize,
}

/// A longest common contiguous run (the first in a, then in b); len 0 if
/// none.
pub fn longest_common_substring[T: Eq](a: []T, b: []T) !Substring {
    let m = b.len;
    let buf = mem.alloc.[usize](2 * (m + 1))!;
    defer mem.free(buf);
    @mem_set(buf, 0);
    let mut prev = buf[..m + 1];
    let mut cur = buf[m + 1..];
    let mut best = Substring.{ a_start: 0, b_start: 0, len: 0 };
    for i in @as(usize, 1)..a.len + 1 {
        cur[0] = 0;
        for j in @as(usize, 1)..m + 1 {
            if a[i - 1] == b[j - 1] {
                let v = prev[j - 1] + 1;
                cur[j] = v;
                if v > best.len {
                    best = Substring.{ a_start: i - v, b_start: j - v, len: v };
                }
            } else {
                cur[j] = 0;
            }
        }
        let t = prev;
        prev = cur;
        cur = t;
    }
    return best;
}

// -----------------------------------------------------------------------------
// difflib's SequenceMatcher
// -----------------------------------------------------------------------------

/// a[a..a + size] == b[b..b + size].
pub struct Block {
    a: usize,
    b: usize,
    size: usize,
}

struct Range {
    alo: usize,
    ahi: usize,
    blo: usize,
    bhi: usize,
}

struct Entry[T: Ord] {
    v: T,
    j: usize,
}

fn entry_less[T: Ord](x: Entry.[T], y: Entry.[T]) bool {
    if x.v != y.v {
        return x.v < y.v;
    }
    return x.j < y.j;
}

fn block_less(x: Block, y: Block) bool {
    if x.a != y.a {
        return x.a < y.a;
    }
    return x.b < y.b;
}

struct Matcher[T: Ord] {
    a: []T,
    b: []T,
    b2j: []mut Entry.[T],  // b's elements and positions, sorted
    popular: []mut bool,   // per entry: in a run of an element too common to index
    len: []mut usize,      // two rows of match lengths ending at each j
    stamp: []mut usize,    // the row tick each len entry belongs to
    tick: usize,

    fn init(a: []T, b: []T) !Self {
        let m = b.len;
        let b2j = mem.alloc.[Entry.[T]](m)!;
        let popular = mem.alloc.[bool](m) catch |e| {
            mem.free(b2j);
            return e;
        };
        let len = mem.alloc.[usize](2 * (m + 1)) catch |e| {
            mem.free(b2j);
            mem.free(popular);
            return e;
        };
        let stamp = mem.alloc.[usize](2 * (m + 1)) catch |e| {
            mem.free(b2j);
            mem.free(popular);
            mem.free(len);
            return e;
        };
        @mem_set(stamp, 0);
        @mem_set(popular, false);
        for j in @as(usize, 0)..m {
            b2j[j] = Entry.[T].{ v: b[j], j: j };
        }
        vec.sort.[Entry.[T]](b2j, entry_less.[T]);
        // difflib's autojunk: in a b of 200 or more, elements making up more
        // than 1% (+1) of it are not indexed
        if m >= 200 {
            let ntest = (m / 100) + 1;
            let mut s: usize = 0;
            while s < m {
                let mut e = s + 1;
                while (e < m) and (b2j[e].v == b2j[s].v) {
                    e += 1;
                }
                if (e - s) > ntest {
                    @mem_set(popular[s..e], true);
                }
                s = e;
            }
        }
        return Self.{ a: a, b: b, b2j: b2j, popular: popular, len: len, stamp: stamp, tick: 0 };
    }

    fn deinit(self: *mut Self) void {
        mem.free(self.b2j);
        mem.free(self.popular);
        mem.free(self.len);
        mem.free(self.stamp);
    }

    // The first entry for v, or b2j.len.
    fn lookup(self: *Self, v: T) usize {
        let mut lo: usize = 0;
        let mut hi = self.b2j.len;
        while lo < hi {
            let mid = lo + ((hi - lo) / 2);
            if self.b2j[mid].v < v {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if (lo < self.b2j.len) and (self.b2j[lo].v == v) and not self.popular[lo] {
            return lo;
        }
        return self.b2j.len;
    }

    // difflib's find_longest_match (with no junk function).
    fn longest(self: *mut Self, alo: usize, ahi: usize, blo: usize, bhi: usize) Block {
        let a = self.a;
        let b = self.b;
        let w = b.len + 1;
        let mut besti = alo;
        let mut bestj = blo;
        let mut bestsize: usize = 0;
        let mut prev_tick: usize = 0;  // no previous row in this call
        for i in alo..ahi {
            self.tick += 1;
            let t = self.tick;
            let cur = (t & 1) * w;
            let prev = w - cur;
            let mut e = self.lookup(a[i]);
            while (e < self.b2j.len) and (self.b2j[e].v == a[i]) {
                let j = self.b2j[e].j;
                e += 1;
                if j < blo {
                    continue;
                }
                if j >= bhi {
                    break;
                }
                let mut k: usize = 1;
                if (j > 0) and (prev_tick != 0) and (self.stamp[(prev + j) - 1] == prev_tick) {
                    k = self.len[(prev + j) - 1] + 1;
                }
                self.len[cur + j] = k;
                self.stamp[cur + j] = t;
                if k > bestsize {
                    besti = (i + 1) - k;
                    bestj = (j + 1) - k;
                    bestsize = k;
                }
            }
            prev_tick = t;
        }
        while ((besti > alo) and (bestj > blo)) and (a[besti - 1] == b[bestj - 1]) {
            besti -= 1;
            bestj -= 1;
            bestsize += 1;
        }
        while (((besti + bestsize) < ahi) and ((bestj + bestsize) < bhi)) and
              (a[besti + bestsize] == b[bestj + bestsize]) {
            bestsize += 1;
        }
        return Block.{ a: besti, b: bestj, size: bestsize };
    }
}

/// The matching blocks of difflib's SequenceMatcher(None, a, b), in order,
/// adjacent blocks merged, ending with the empty block (len a, len b, 0);
/// free with mem.free.
pub fn matching_blocks[T: Ord](a: []T, b: []T) ![]mut Block {
    let mut mt = Matcher.[T].init(a, b)!;
    defer mt.deinit();
    let mut found = vec.Vec.[Block].init();
    defer found.deinit();
    let mut todo = vec.Vec.[Range].init();
    defer todo.deinit();
    todo.push(Range.{ alo: 0, ahi: a.len, blo: 0, bhi: b.len })!;
    while todo.len > 0 {
        let r = todo.pop()!;
        let x = mt.longest(r.alo, r.ahi, r.blo, r.bhi);
        if x.size > 0 {
            found.push(x)!;
            if (r.alo < x.a) and (r.blo < x.b) {
                todo.push(Range.{ alo: r.alo, ahi: x.a, blo: r.blo, bhi: x.b })!;
            }
            if ((x.a + x.size) < r.ahi) and ((x.b + x.size) < r.bhi) {
                todo.push(Range.{ alo: x.a + x.size, ahi: r.ahi, blo: x.b + x.size, bhi: r.bhi })!;
            }
        }
    }
    let blocks = found.items();
    vec.sort.[Block](blocks, block_less);
    // merge adjacent blocks
    let out = mem.alloc.[Block](blocks.len + 1)!;
    let mut k: usize = 0;
    for x in blocks {
        if (k > 0) and (((out[k - 1].a + out[k - 1].size) == x.a) and ((out[k - 1].b + out[k - 1].size) == x.b)) {
            out[k - 1].size += x.size;
        } else {
            out[k] = x;
            k += 1;
        }
    }
    out[k] = Block.{ a: a.len, b: b.len, size: 0 };
    return mem.realloc(out, k + 1) catch |e| {
        mem.free(out);
        return e;
    };
}

/// difflib's SequenceMatcher(None, a, b).ratio(): 2 M / (len a + len b)
/// where M is the size of the matching blocks; 1 for two empty sequences.
pub fn ratio[T: Ord](a: []T, b: []T) !f64 {
    let total = a.len + b.len;
    if total == 0 {
        return 1.0;
    }
    let blocks = matching_blocks(a, b)!;
    defer mem.free(blocks);
    let mut m: usize = 0;
    for x in blocks {
        m += x.size;
    }
    return (2.0 * @float_from_int(f64, m)) / @float_from_int(f64, total);
}

// -----------------------------------------------------------------------------
// Fuzzy finding
// -----------------------------------------------------------------------------

const SCORE_MATCH: i64 = 16;
const GAP_START: i64 = -3;
const GAP_EXT: i64 = -1;
const BONUS_BOUNDARY: i64 = 8;
const BONUS_WHITE: i64 = 10;  // a word start after white space (or at the start)
const BONUS_CAMEL: i64 = 7;
const BONUS_CONSECUTIVE: i64 = 4;
const FIRST_CHAR_FACTOR: i64 = 2;
const NONE: i64 = -1000000000;

enum Class: u8 {
    WHITE,
    DELIM,
    NONWORD,
    LOWER,
    UPPER,
    LETTER,
    NUMBER,
}

fn class_of(c: u32) Class {
    if (c == ' ') or (c == '\t') or (c == '\n') or uni.is_space(c) {
        return Class.WHITE;
    }
    if (c == '/') or (c == '\\') or (c == ',') or (c == ':') or (c == ';') or (c == '|') or (c == '_') or (c == '-') or
       (c == '.') {
        return Class.DELIM;
    }
    if uni.is_lower(c) {
        return Class.LOWER;
    }
    if uni.is_upper(c) {
        return Class.UPPER;
    }
    if uni.is_letter(c) {
        return Class.LETTER;
    }
    if uni.is_number(c) {
        return Class.NUMBER;
    }
    return Class.NONWORD;
}

fn is_word(c: Class) bool {
    return (c == Class.LOWER) or (c == Class.UPPER) or (c == Class.LETTER) or (c == Class.NUMBER);
}

// The bonus for matching a character of class cur after one of class prev.
fn bonus(prev: Class, cur: Class) i64 {
    if is_word(cur) {
        if prev == Class.WHITE {
            return BONUS_WHITE;
        }
        if not is_word(prev) {
            return BONUS_BOUNDARY;
        }
        if ((prev == Class.LOWER) and (cur == Class.UPPER)) or ((prev != Class.NUMBER) and (cur == Class.NUMBER)) {
            return BONUS_CAMEL;
        }
        return 0;
    }
    if cur == Class.WHITE {
        return BONUS_WHITE;
    }
    return BONUS_BOUNDARY;
}

fn fold(c: u32) u32 {
    return uni.to_lower(c);
}

/// A candidate's place in fuzzy_find's ranking.
pub struct FuzzyMatch {
    index: usize,  // in the candidates
    score: i64,
}

// The decoded candidate and query and the score table.
struct Fuzzy {
    q: []mut u32,
    c: []mut u32,
    at: []mut usize,  // byte offset of each candidate code point
    bonus: []mut i64,
    h: []mut i64,      // h[i * m + j]: best score with query[i] matched at c[j]
    diag: []mut bool,  // whether h[i * m + j] continues a run from (i-1, j-1)

    fn deinit(self: *mut Fuzzy) void {
        mem.free(self.q);
        mem.free(self.c);
        mem.free(self.at);
        mem.free(self.bonus);
        mem.free(self.h);
        mem.free(self.diag);
    }
}

fn empty_i64() []mut i64 {
    return @slice_from_ptr(@ptr_from_int(*mut i64, 8), 0);
}

fn empty_bool() []mut bool {
    return @slice_from_ptr(@ptr_from_int(*mut bool, 1), 0);
}

fn empty_usize() []mut usize {
    return @slice_from_ptr(@ptr_from_int(*mut usize, 8), 0);
}

fn empty_u32() []mut u32 {
    return @slice_from_ptr(@ptr_from_int(*mut u32, 4), 0);
}

// Scores the alignment; NoMatch if the query is not a subsequence.
fn fuzzy_run(query: []u8, candidate: []u8, f: *mut Fuzzy) !i64 {
    f.q = runes(query)!;
    let n = f.q.len;
    if n == 0 {
        return 0;
    }
    let mut sensitive = false;
    for k in @as(usize, 0)..n {
        if uni.is_upper(f.q[k]) {
            sensitive = true;
        }
    }
    if not sensitive {
        for k in @as(usize, 0)..n {
            f.q[k] = fold(f.q[k]);
        }
    }
    f.c = runes(candidate)!;
    let m = f.c.len;
    f.at = mem.alloc.[usize](m)!;
    f.bonus = mem.alloc.[i64](m)!;
    let mut pos: usize = 0;
    let mut prev = Class.WHITE;
    for j in @as(usize, 0)..m {
        f.at[j] = pos;
        pos += strs.decode_rune(candidate[pos..]).len;
        let cl = class_of(f.c[j]);
        f.bonus[j] = bonus(prev, cl);
        prev = cl;
        if not sensitive {
            f.c[j] = fold(f.c[j]);
        }
    }
    // quick rejection: is the query a subsequence at all?
    let mut qi: usize = 0;
    for j in @as(usize, 0)..m {
        if (qi < n) and (f.c[j] == f.q[qi]) {
            qi += 1;
        }
    }
    if qi < n {
        return error.NoMatch;
    }
    let size = @mul_checked(n, m) catch return error.OutOfMemory;
    f.h = mem.alloc.[i64](size)!;
    f.diag = mem.alloc.[bool](size)!;
    for i in @as(usize, 0)..n {
        // gap: the best of h[i-1][k] + gap penalty for k <= j - 2
        let mut gap = NONE;
        for j in @as(usize, 0)..m {
            if (i > 0) and (j >= 2) {
                let back = f.h[(((i - 1) * m) + j) - 2];
                gap = @max(gap + GAP_EXT, back + GAP_START);
            }
            let at = (i * m) + j;
            f.h[at] = NONE;
            f.diag[at] = false;
            if f.c[j] != f.q[i] {
                continue;
            }
            let b = f.bonus[j];
            if i == 0 {
                f.h[at] = SCORE_MATCH + (b * FIRST_CHAR_FACTOR);
                continue;
            }
            let mut best = NONE;
            if gap > (NONE / 2) {
                best = (gap + SCORE_MATCH) + b;
            }
            if j > 0 {
                let d = f.h[(at - m) - 1];
                if d > (NONE / 2) {
                    let v = (d + SCORE_MATCH) + @max(b, BONUS_CONSECUTIVE);
                    if v >= best {
                        best = v;
                        f.diag[at] = true;
                    }
                }
            }
            f.h[at] = best;
        }
    }
    let mut score = NONE;
    let last = (n - 1) * m;
    for j in @as(usize, 0)..m {
        score = @max(score, f.h[last + j]);
    }
    if score <= (NONE / 2) {
        return error.NoMatch;
    }
    return score;
}

/// How well query matches candidate as a subsequence (higher is better;
/// see the module comment); NoMatch if it does not. An empty query
/// matches everything with score 0.
pub fn fuzzy_score(query: []u8, candidate: []u8) !i64 {
    let mut f = Fuzzy.{ q: empty_u32(), c: empty_u32(), at: empty_usize(), bonus: empty_i64(), h: empty_i64(),
                        diag: empty_bool() };
    defer f.deinit();
    return fuzzy_run(query, candidate, &mut f)!;
}

/// Writes the byte offsets in candidate of the characters the best
/// alignment matches (one per query code point, increasing; out must be
/// long enough) and returns how many; NoMatch if the query does not match.
pub fn fuzzy_positions(query: []u8, candidate: []u8, out: []mut usize) !usize {
    let mut f = Fuzzy.{ q: empty_u32(), c: empty_u32(), at: empty_usize(), bonus: empty_i64(), h: empty_i64(),
                        diag: empty_bool() };
    defer f.deinit();
    let score = fuzzy_run(query, candidate, &mut f)!;
    let n = f.q.len;
    if n == 0 {
        return 0;
    }
    if out.len < n {
        return error.LengthMismatch;
    }
    let m = f.c.len;
    // the last position with the best score, then back through the table
    let mut j: usize = 0;
    for k in @as(usize, 0)..m {
        if f.h[((n - 1) * m) + k] == score {
            j = k;
            break;
        }
    }
    let mut i = n - 1;
    loop {
        out[i] = f.at[j];
        if i == 0 {
            break;
        }
        let at = (i * m) + j;
        let here = f.h[at] - SCORE_MATCH;
        if f.diag[at] {
            j -= 1;
        } else {
            // the k <= j - 2 whose score plus the gap penalty gave this one
            let want = here - f.bonus[j];
            let mut k = j - 2;
            loop {
                let v = f.h[((i - 1) * m) + k];
                if (v > (NONE / 2)) and ((v + (GAP_START + (GAP_EXT * @int_cast(i64, (j - k) - 2)))) == want) {
                    break;
                }
                k -= 1;
            }
            j = k;
        }
        i -= 1;
    }
    return n;
}

/// The candidates the query matches, best first (equal scores: shorter
/// candidates first, then in the given order); free with mem.free.
pub fn fuzzy_find(query: []u8, candidates: [][]u8) ![]mut FuzzyMatch {
    let mut found = vec.Vec.[FuzzyMatch].init();
    defer found.deinit();
    let mut lens = vec.Vec.[usize].init();
    defer lens.deinit();
    for i in @as(usize, 0)..candidates.len {
        let s = fuzzy_score(query, candidates[i]) catch |e| {
            if e == error.NoMatch {
                continue;
            }
            return e;
        };
        found.push(FuzzyMatch.{ index: i, score: s })!;
    }
    // rank: score, then length in code points, then index
    let xs = found.items();
    let keyed = mem.alloc.[Ranked](xs.len)!;
    defer mem.free(keyed);
    for k in @as(usize, 0)..xs.len {
        keyed[k] = Ranked.{ score: xs[k].score, len: strs.rune_count(candidates[xs[k].index]), index: xs[k].index };
    }
    vec.sort.[Ranked](keyed, ranked_less);
    let out = mem.alloc.[FuzzyMatch](xs.len)!;
    for k in @as(usize, 0)..xs.len {
        out[k] = FuzzyMatch.{ index: keyed[k].index, score: keyed[k].score };
    }
    return out;
}

struct Ranked {
    score: i64,
    len: usize,
    index: usize,
}

fn ranked_less(x: Ranked, y: Ranked) bool {
    if x.score != y.score {
        return x.score > y.score;
    }
    if x.len != y.len {
        return x.len < y.len;
    }
    return x.index < y.index;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn near(x: f64, y: f64, tol: f64) bool {
    return @abs(x - y) <= tol;
}

test "edit distances" {
    @expect(levenshtein("kitten", "sitting")! == 3);
    @expect(levenshtein("flaw", "lawn")! == 2);
    @expect(levenshtein("", "abc")! == 3);
    @expect(levenshtein("abc", "")! == 3);
    @expect(levenshtein("same", "same")! == 0);
    @expect(levenshtein_bounded("kitten", "sitting", 3)! == 3);
    @expect(levenshtein_bounded("kitten", "sitting", 2)! == 3);
    @expect(levenshtein_bounded("kitten", "sitting", 0)! == 1);
    @expect(levenshtein_bounded("a", "abcdefgh", 3)! == 4);
    @expect(osa_distance("CA", "ABC")! == 3);
    @expect(damerau_levenshtein("CA", "ABC")! == 2);
    @expect(osa_distance("abcd", "acbd")! == 1);
    @expect(damerau_levenshtein("abcd", "acbd")! == 1);
    @expect(damerau_levenshtein("a cat", "an act")! == 2);
    @expect(hamming("karolin", "kathrin")! == 3);
    @expect(hamming("0000", "1111")! == 4);
    _ = hamming("a", "ab") catch |e| {
        @expect(e == error.LengthMismatch);
        @expect(near(levenshtein_similarity("kitten", "sitting")!, 1.0 - (3.0 / 7.0), 1e-15));
        return;
    };
    @trap();
}

test "code points" {
    let a = runes("naïve café")!;
    defer mem.free(a);
    let b = runes("naive cafe")!;
    defer mem.free(b);
    @expect(a.len == 10);
    @expect(levenshtein(a, b)! == 2);
    @expect(levenshtein("naïve café", "naive cafe")! == 4);
    let c = runes("日本語")!;
    defer mem.free(c);
    let d = runes("日本")!;
    defer mem.free(d);
    @expect(levenshtein(c, d)! == 1);
    @expect(lcs_length(c, d)! == 2);
}

test "Jaro and Jaro-Winkler" {
    // Winkler (1990) and the usual textbook examples
    @expect(near(jaro("MARTHA", "MARHTA")!, 0.944444444444, 1e-9));
    @expect(near(jaro_winkler("MARTHA", "MARHTA")!, 0.961111111111, 1e-9));
    @expect(near(jaro("DWAYNE", "DUANE")!, 0.822222222222, 1e-9));
    @expect(near(jaro_winkler("DWAYNE", "DUANE")!, 0.84, 1e-9));
    @expect(near(jaro("DIXON", "DICKSONX")!, 0.766666666667, 1e-9));
    @expect(near(jaro_winkler("DIXON", "DICKSONX")!, 0.813333333333, 1e-9));
    @expect(jaro("", "")! == 1.0);
    @expect(jaro("abc", "")! == 0.0);
    @expect(jaro("abc", "xyz")! == 0.0);
    @expect(jaro_winkler("same", "same")! == 1.0);
}

test "common subsequences and substrings" {
    @expect(lcs_length("AGGTAB", "GXTXAYB")! == 4);
    let s = lcs("AGGTAB", "GXTXAYB")!;
    defer mem.free(s);
    @expect_eq(s, "GTAB");
    let t = lcs("ABCBDAB", "BDCABA")!;
    defer mem.free(t);
    @expect(t.len == 4);
    let e = lcs("", "abc")!;
    defer mem.free(e);
    @expect(e.len == 0);
    let x = longest_common_substring("xabcdey", "zzabcdf")!;
    @expect((x.a_start == 1) and (x.b_start == 2) and (x.len == 4));
    let y = longest_common_substring("abc", "xyz")!;
    @expect(y.len == 0);
}

test "difflib ratio" {
    @expect(ratio("abcd", "bcde")! == 0.75);
    @expect(ratio("", "")! == 1.0);
    @expect(ratio("abc", "")! == 0.0);
    let bl = matching_blocks("abxcd", "abcd")!;
    defer mem.free(bl);
    @expect(bl.len == 3);
    @expect((bl[0].a == 0) and (bl[0].b == 0) and (bl[0].size == 2));
    @expect((bl[1].a == 3) and (bl[1].b == 2) and (bl[1].size == 2));
    @expect((bl[2].a == 5) and (bl[2].b == 4) and (bl[2].size == 0));
}

test "fuzzy finding" {
    @expect(fuzzy_score("", "anything")! == 0);
    _ = fuzzy_score("xyz", "abc") catch |e| {
        @expect(e == error.NoMatch);
        // word starts beat scattered letters
        @expect(fuzzy_score("fb", "foo_bar")! > fuzzy_score("fb", "fabric")!);
        @expect(fuzzy_score("fb", "FooBar")! > fuzzy_score("fb", "afoobar")!);
        // consecutive beats spread out
        @expect(fuzzy_score("abc", "xabcx")! > fuzzy_score("abc", "xaxbxcx")!);
        // smart case
        _ = fuzzy_score("Ab", "ab") catch |e2| {
            @expect(e2 == error.NoMatch);
            @expect(fuzzy_score("ab", "AB")! > 0);
            let mut at: [3]usize = [0; 3];
            @expect(fuzzy_positions("fbr", "src/foo/bar.rs", at[..])! == 3);
            @expect((at[0] == 4) and (at[1] == 8) and (at[2] == 12));  // "r" after "." beats the nearer one
            @expect(fuzzy_positions("éa", "café bar", at[..])! == 2);
            @expect((at[0] == 3) and (at[1] == 7));
            let names: [5][]u8 = ["main.c", "src/fuzzy_finder.ax", "README", "fuzz.ax", "frobnicate_zap.ax"];
            let ms = fuzzy_find("fz", names[..])!;
            defer mem.free(ms);
            @expect(ms.len == 3);
            @expect(ms[0].index == 3);  // fuzz.ax: both at the start, close together
            @expect(ms[1].index == 4);  // frobnicate_zap.ax: both at word starts
            @expect(ms[2].index == 1);  // src/fuzzy_finder.ax: a word start, mid-word z
            @expect(ms[0].score > ms[1].score);
            return;
        };
        @trap();
    };
    @trap();
}

test "against Python" {
    let data = fs.read_file("std/text/similarity/testdata/cases.txt") catch return;
    defer mem.free(data);
    let mut lines = strs.lines(data);
    let mut count: usize = 0;
    while true {
        let line = lines.next() catch break;
        if (line.len == 0) or (line[0] == '#') {
            continue;
        }
        let mut f = strs.split(line, "\t");
        let op = f.next()!;
        let a = f.next()!;
        let b = f.next()!;
        let want = f.next()!;
        let ra = runes(a)!;
        defer mem.free(ra);
        let rb = runes(b)!;
        defer mem.free(rb);
        let mut ok = true;
        if strs.eq(op, "ratio") {
            ok = ratio(ra, rb)! == fmt.parse_float(want)!;
        } else if strs.eq(op, "blocks") {
            let bl = matching_blocks(ra, rb)!;
            defer mem.free(bl);
            let mut s = strs.String.init();
            defer s.deinit();
            for x in bl {
                let mut buf: [80]u8 = [0; 80];
                s.push_str(fmt.bufprint(buf[..], "{},{},{};", [fmt.int(x.a), fmt.int(x.b), fmt.int(x.size)])!)!;
            }
            ok = strs.eq(s.bytes(), want);
        } else {
            let n = fmt.parse_int.[usize](want)!;
            if strs.eq(op, "lev") {
                ok = levenshtein(ra, rb)! == n;
                ok = ok and (levenshtein_bounded(ra, rb, 3)! == @min(n, 4));
                ok = ok and (levenshtein_bounded(ra, rb, n)! == n);
            } else if strs.eq(op, "osa") {
                ok = osa_distance(ra, rb)! == n;
            } else if strs.eq(op, "dl") {
                ok = damerau_levenshtein(ra, rb)! == n;
            } else if strs.eq(op, "lcs") {
                ok = lcs_length(ra, rb)! == n;
                let s = lcs(ra, rb)!;
                defer mem.free(s);
                // a common subsequence of the right length
                ok = (ok and (s.len == n)) and (is_subsequence(s, ra) and is_subsequence(s, rb));
            } else if strs.eq(op, "substr") {
                ok = longest_common_substring(ra, rb)!.len == n;
            } else {
                ok = false;
            }
        }
        if not ok {
            @expect_eq(line, "");
        }
        count += 1;
    }
    @expect(count >= 500);
}

fn is_subsequence(s: []u32, t: []u32) bool {
    let mut k: usize = 0;
    for x in t {
        if (k < s.len) and (s[k] == x) {
            k += 1;
        }
    }
    return k == s.len;
}
