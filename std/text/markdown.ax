// =============================================================================
// std/text/markdown.ax - Markdown: CommonMark 0.31.2 with the GitHub extensions.
//
//     let html = markdown.to_html(text, markdown.Options.init())!;
//     defer mem.free(html);
//     markdown.to_html_to(w, text, markdown.Options.init())!;   // to an io.Writer
//
// or, to look at the tree:
//
//     let mut doc = markdown.parse(text, markdown.Options.init())!;
//     defer doc.deinit();
//     let mut w = doc.walk();
//     while w.next() {
//         let n = doc.node(w.id);
//         if w.entering and (n.kind == markdown.Kind.HEADING) { ... doc.text(child) ... }
//     }
//
// parse() builds a tree of Nodes (blocks: paragraphs, headings, lists, code,
// block quotes, tables, ...; inlines: text, emphasis, links, images, code
// spans, ...) that the Document owns; nodes are numbered, the root is 0, and
// each has parent, first/last child and next/previous sibling links (NONE when
// absent). The parser follows the CommonMark reference implementation (cmark)
// and passes all 652 examples of the CommonMark 0.31.2 specification. With
// Options.gfm it also reads the GitHub Flavored Markdown extensions: tables,
// strikethrough (~~x~~), autolinks without angle brackets (www.x.com,
// https://..., a@b.com) and task list items ([ ] and [x]). With Options.math
// it reads TeX math, $...$, $`...`$ and $$...$$ (as MATH and DISPLAY_MATH
// nodes) and ```math code blocks, and writes it as MathML (std/text/math), or as SVG
// through Options.math_html and std/text/math/typeset.
//
// Untrusted input: the HTML output is safe by default. Raw HTML in the input
// is replaced by a comment (Options.unsafe_html keeps it), links and images
// to javascript:, vbscript:, file: and data: URLs (other than raw images)
// lose their destinations, and everything else is escaped. With unsafe_html,
// Options.tagfilter (on by default with gfm) still defuses <script>, <style>,
// <iframe> and the like. Every part of the parser takes time linear in the
// input (or close to it) whatever its shape, nesting is not limited but
// nothing recurses, and the HTML that reference links can expand to is
// bounded by the size of the input.
// =============================================================================

import "../collections/map.ax" as maps;
import "../collections/vec.ax" as vec;
import "../hash.ax" as hash;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../os/fs.ax" as fs;
import "../str.ax" as strs;
import "../unicode.ax" as uni;
import "html/entities.ax" as ent;
import "math.ax" as tmath;

error { TooLarge, OutOfMemory }

pub const NONE: u32 = 0xffffffff;

/// The kinds of node: blocks (DOCUMENT to TABLE_CELL), then inlines.
pub enum Kind: u8 {
    // Block nodes
    DOCUMENT,
    BLOCK_QUOTE,
    LIST,
    ITEM,
    CODE_BLOCK,
    HTML_BLOCK,
    PARAGRAPH,
    HEADING,
    THEMATIC_BREAK,
    TABLE,
    TABLE_ROW,
    TABLE_CELL,
    // Inline nodes
    TEXT,
    SOFT_BREAK,
    HARD_BREAK,
    CODE,
    HTML_INLINE,
    EMPH,
    STRONG,
    STRIKETHROUGH,
    LINK,
    IMAGE,
    /// With Options.math: $...$, $`...`$ and $$...$$ (the TeX source is the text).
    MATH,
    DISPLAY_MATH,

    /// The name cmark uses ("block_quote", "softbreak", ...).
    pub fn name(self: Kind) []u8 {
        return KIND_NAMES[@as(usize, @int_from_enum(self))];
    }

    /// Whether this is an inline (TEXT and after) rather than a block.
    pub fn is_inline(self: Kind) bool {
        return @int_from_enum(self) >= @int_from_enum(Kind.TEXT);
    }
}

let KIND_NAMES: [24][]u8 = [
    "document",
    "block_quote",
    "list",
    "item",
    "code_block",
    "html_block",
    "paragraph",
    "heading",
    "thematic_break",
    "table",
    "table_row",
    "table_cell",
    "text",
    "softbreak",
    "linebreak",
    "code",
    "html_inline",
    "emph",
    "strong",
    "strikethrough",
    "link",
    "image",
    "math",
    "display_math",
];

/// Table cell alignment.
pub enum Align: u8 {
    NONE,
    LEFT,
    CENTER,
    RIGHT,
}

/// Task list items: not one, "[ ]" or "[x]".
pub enum Task: u8 {
    NONE,
    OPEN,
    DONE,
}

pub struct Options {
    /// The GitHub extensions: tables, strikethrough, extended autolinks, task lists.
    gfm: bool,
    /// Pass raw HTML and dangerous URLs through to the output.
    unsafe_html: bool,
    /// With unsafe_html: escape the tags GitHub disallows (<script>, <style>,
    /// <iframe>, <textarea>, <title>, <xmp>, <noembed>, <noframes>, <plaintext>).
    tagfilter: bool,
    /// Render soft line breaks as <br />.
    hard_breaks: bool,
    /// TeX math (std/text/math) as MathML: $...$ inline, $$...$$ displayed,
    /// and ```math code blocks. A $ needs a non-space after it to open and
    /// before it to close (and no digit after it), so "$5 and $10" stays
    /// text; \$ is a dollar sign. GitHub's $`...`$ (backticks as in a code
    /// span, the same number on each side) is inline math too, and avoids
    /// those rules. Math that does not parse is left as its source.
    math: bool,
    /// How math is written: MathML (MathHtml.mathml(), the default), or
    /// another renderer such as std/text/math/typeset's SVG.
    math_html: MathHtml,

    /// GitHub Flavored Markdown, safe for untrusted input.
    pub fn init() Options {
        return Options.{ gfm: true, unsafe_html: false, tagfilter: true, hard_breaks: false, math: false,
                         math_html: MathHtml.mathml() };
    }

    /// Plain CommonMark, raw HTML allowed (as the specification's examples expect).
    pub fn commonmark() Options {
        return Options.{ gfm: false, unsafe_html: true, tagfilter: false, hard_breaks: false, math: false,
                         math_html: MathHtml.mathml() };
    }
}

/// A way to write math as HTML: `render(ctx, tex, displayed, out)` appends
/// it to out and returns true, or returns false (having written nothing)
/// to leave it to MathML.
pub struct MathHtml {
    ctx: *mut void,
    render: fn(*mut void, []u8, bool, *mut strs.String) !bool,

    /// MathML (std/text/math).
    pub fn mathml() MathHtml {
        return MathHtml.{ ctx: @ptr_from_int(*mut void, 8), render: no_math_html };
    }
}

fn no_math_html(ctx: *mut void, tex: []u8, displayed: bool, out: *mut strs.String) !bool {
    _ = ctx;
    _ = tex;
    _ = displayed;
    _ = out;
    return false;
}

/// Where a node's string lives: in the block contents (raw) or in the
/// strings made by the inline parser (buf).
struct Ref {
    off: u32,
    len: u32,
    raw: bool,
}

fn no_ref() Ref {
    return Ref.{ off: 0, len: 0, raw: false };
}

pub struct Node {
    kind: Kind,
    parent: u32,
    first: u32,
    last: u32,
    next: u32,
    prev: u32,
    /// The source line the node starts on (1-based; blocks only).
    line: u32,
    /// HEADING: 1 to 6.
    level: u8,
    /// LIST: numbered (with `start` and `delim`, '.' or ')'), or bulleted
    /// with `bullet` ('-', '+' or '*'); tight lists render without <p>.
    ordered: bool,
    tight: bool,
    delim: u8,
    bullet: u8,
    start: u32,
    /// TABLE_CELL: its Align. TABLE_ROW: header row or not.
    align: Align,
    header: bool,
    /// ITEM: its Task.
    task: Task,
    /// CODE_BLOCK: fenced (``` or ~~~) or indented.
    fenced: bool,
    // TEXT, CODE, HTML_*, CODE_BLOCK: the literal; LINK, IMAGE: the destination
    text: Ref,
    // CODE_BLOCK: the info string; LINK, IMAGE: the title
    info: Ref,
    // parser state
    open: bool,
    last_line_blank: bool,
    fence_char: u8,
    fence_len: u32,
    fence_offset: u32,
    marker_offset: u32,
    padding: u32,
    html_type: u8,
    eb_epoch: u32,
    eb_val: bool,
}

fn new_node(kind: Kind, line: u32) Node {
    return Node.{
        kind: kind,
        parent: NONE,
        first: NONE,
        last: NONE,
        next: NONE,
        prev: NONE,
        line: line,
        level: 0,
        ordered: false,
        tight: false,
        delim: 0,
        bullet: 0,
        start: 0,
        align: Align.NONE,
        header: false,
        task: Task.NONE,
        fenced: false,
        text: no_ref(),
        info: no_ref(),
        open: true,
        last_line_blank: false,
        fence_char: 0,
        fence_len: 0,
        fence_offset: 0,
        marker_offset: 0,
        padding: 0,
        html_type: 0,
        eb_epoch: 0,
        eb_val: false,
    };
}

/// Whether a node is an inline (TEXT and after) rather than a block.
pub fn is_inline(kind: Kind) bool {
    return kind.is_inline();
}

pub struct Document {
    nodes: vec.Vec.[Node],
    raw: strs.String,
    buf: strs.String,
    opts: Options,

    pub fn deinit(self: *mut Document) void {
        self.nodes.deinit();
        self.raw.deinit();
        self.buf.deinit();
    }

    /// The root (a DOCUMENT node).
    pub fn root(self: *Document) u32 {
        _ = self;
        return 0;
    }

    pub fn node(self: *Document, id: u32) Node {
        return self.nodes.get(@as(usize, id));
    }

    pub fn len(self: *Document) usize {
        return self.nodes.len;
    }

    fn str(self: *Document, r: Ref) []u8 {
        let o = @as(usize, r.off);
        let e = o + @as(usize, r.len);
        if r.raw {
            return self.raw.bytes()[o..e];
        }
        return self.buf.bytes()[o..e];
    }

    /// The literal text of a TEXT, CODE, HTML_INLINE, HTML_BLOCK or
    /// CODE_BLOCK node (for a code block, its lines, each ending in "\n").
    pub fn text(self: *Document, id: u32) []u8 {
        return self.str(self.nodes.get(@as(usize, id)).text);
    }

    /// A fenced code block's info string (```info), unescaped.
    pub fn info(self: *Document, id: u32) []u8 {
        return self.str(self.nodes.get(@as(usize, id)).info);
    }

    /// A LINK's or IMAGE's destination.
    pub fn url(self: *Document, id: u32) []u8 {
        return self.str(self.nodes.get(@as(usize, id)).text);
    }

    /// A LINK's or IMAGE's title ("" if none).
    pub fn title(self: *Document, id: u32) []u8 {
        return self.str(self.nodes.get(@as(usize, id)).info);
    }

    /// Visits every node depth first: each container twice (entering and
    /// leaving), each leaf once.
    pub fn walk(self: *Document) Walker {
        return Walker.{ doc: self, id: NONE, entering: false, started: false };
    }

    /// The text of a node's inline content, without markup (as for an
    /// image's alt text).
    pub fn plain_text(self: *Document, id: u32) ![]mut u8 {
        let mut out = strs.String.init();
        plain_into(self, id, &mut out) catch |e| {
            out.deinit();
            return e;
        };
        return out.take();
    }

    /// Renders the document as HTML.
    pub fn html(self: *Document) ![]mut u8 {
        let mut out = strs.String.init();
        render_html(self, &mut out, io.discard(), false) catch |e| {
            out.deinit();
            return e;
        };
        return out.take();
    }

    /// Renders the document as HTML to a Writer, about 4 KB at a time.
    pub fn write_html(self: *Document, w: io.Writer) !void {
        let mut out = strs.String.init();
        defer out.deinit();
        render_html(self, &mut out, w, true)!;
        w.write_all(out.bytes())!;
    }
}

/// A depth-first traversal: after next() returns true, `id` is the node and
/// `entering` says whether it is being entered or left (leaves are only
/// entered).
pub struct Walker {
    doc: *Document,
    id: u32,
    entering: bool,
    started: bool,

    pub fn next(self: *mut Walker) bool {
        if not self.started {
            self.started = true;
            self.id = 0;
            self.entering = true;
            return true;
        }
        let n = self.doc.nodes.get(@as(usize, self.id));
        if self.entering and has_exit(n.kind) {
            if n.first != NONE {
                self.id = n.first;
                return true;
            }
            self.entering = false;
            return true;
        }
        if self.id == 0 {
            return false;
        }
        if n.next != NONE {
            self.id = n.next;
            self.entering = true;
            return true;
        }
        self.id = n.parent;
        self.entering = false;
        return true;
    }
}

/// Containers are visited twice by a Walker, leaves once.
pub fn has_exit(kind: Kind) bool {
    return (kind != Kind.THEMATIC_BREAK) and (kind != Kind.CODE_BLOCK) and (kind != Kind.HTML_BLOCK) and
           (kind != Kind.TEXT) and (kind != Kind.SOFT_BREAK) and (kind != Kind.HARD_BREAK) and (kind != Kind.CODE) and
           (kind != Kind.HTML_INLINE) and (kind != Kind.MATH) and (kind != Kind.DISPLAY_MATH);
}

/// Parses Markdown text. The input need not be valid UTF-8 (bad bytes
/// pass through); NUL bytes become U+FFFD.
pub fn parse(src: []u8, opts: Options) !Document {
    if src.len >= 0x40000000 {
        return error.TooLarge;
    }
    let mut doc = Document.{ nodes: vec.Vec.[Node].init(), raw: strs.String.init(), buf: strs.String.init(),
                             opts: opts };
    build(&mut doc, src, opts) catch |e| {
        doc.deinit();
        return e;
    };
    return doc;
}

fn build(doc: *mut Document, src: []u8, opts: Options) !void {
    doc.raw.reserve(src.len + (src.len / 8) + 16)!;
    let mut p = Parser.init(doc, opts, src.len);
    defer p.deinit();
    p.document(src)!;
    inlines_all(&mut p)!;
}

/// Markdown to HTML in one step.
pub fn to_html(src: []u8, opts: Options) ![]mut u8 {
    let mut doc = parse(src, opts)!;
    defer doc.deinit();
    return doc.html();
}

/// Markdown to HTML in one step, written to w as it is rendered (the tree
/// is built first, in memory).
pub fn to_html_to(w: io.Writer, src: []u8, opts: Options) !void {
    let mut doc = parse(src, opts)!;
    defer doc.deinit();
    doc.write_html(w)!;
}

// -----------------------------------------------------------------------------
// Characters
// -----------------------------------------------------------------------------

fn is_space_or_tab(c: u8) bool {
    return (c == ' ') or (c == '\t');
}

fn is_line_end(c: u8) bool {
    return (c == '\n') or (c == '\r') or (c == 0);
}

/// Space, tab, newline, vertical tab, form feed, carriage return.
fn is_ascii_space(c: u8) bool {
    return (c == ' ') or ((c >= 9) and (c <= 13));
}

fn is_ascii_punct(c: u8) bool {
    return ((c >= 33) and (c <= 47)) or ((c >= 58) and (c <= 64)) or ((c >= 91) and (c <= 96)) or
           ((c >= 123) and (c <= 126));
}

fn is_digit(c: u8) bool {
    return (c >= '0') and (c <= '9');
}

fn is_alpha(c: u8) bool {
    return ((c | 0x20) >= 'a') and ((c | 0x20) <= 'z');
}

fn is_alnum(c: u8) bool {
    return is_alpha(c) or is_digit(c);
}

fn lower(c: u8) u8 {
    if (c >= 'A') and (c <= 'Z') {
        return c | 0x20;
    }
    return c;
}

/// Unicode whitespace in CommonMark's sense: Zs, tab, line feed, form feed, carriage return.
fn is_unicode_space(cp: u32) bool {
    if cp < 128 {
        return (cp == ' ') or (cp == '\t') or (cp == '\n') or (cp == 12) or (cp == '\r');
    }
    return uni.category(cp) == uni.Category.ZS;
}

/// Unicode punctuation in CommonMark's sense: the P and S categories.
fn is_unicode_punct(cp: u32) bool {
    if cp < 128 {
        return is_ascii_punct(@truncate(u8, cp));
    }
    return uni.is_punct(cp) or uni.is_symbol(cp);
}

/// Case-insensitive ASCII prefix test at s[i..].
fn has_prefix_ci(s: []u8, i: usize, p: []u8) bool {
    if i + p.len > s.len {
        return false;
    }
    for k in 0..p.len {
        if lower(s[i + k]) != p[k] {
            return false;
        }
    }
    return true;
}

fn has_prefix(s: []u8, i: usize, p: []u8) bool {
    return (i + p.len <= s.len) and @mem_eq(s[i..i + p.len], p);
}

fn at(s: []u8, i: usize) u8 {
    if i < s.len {
        return s[i];
    }
    return 0;
}

// -----------------------------------------------------------------------------
// Block structure
// -----------------------------------------------------------------------------

struct RefDef {
    url: Ref,
    title: Ref,
}

struct Parser {
    doc: *mut Document,
    opts: Options,
    refs: maps.Map.[[]u8, RefDef],
    keys: vec.Vec.[[]mut u8],
    line: strs.String,
    line_number: u32,
    offset: usize,
    column: usize,
    first_nonspace: usize,
    first_nonspace_column: usize,
    indent: usize,
    blank: bool,
    partially_consumed_tab: bool,
    current: u32,
    /// Bytes of destinations and titles that reference links may still expand to.
    ref_budget: usize,
    /// Column alignments (Align values) of the tables (each TABLE's `start` columns from its `fence_offset`).
    aligns: vec.Vec.[Align],
    scratch: strs.String,
    // the inline parser's subject: s is raw[sbase..], inside `block`
    s: []u8,
    sbase: u32,
    pos: usize,
    block: u32,
    delims: vec.Vec.[Delim],
    last_delim: u32,
    brackets: vec.Vec.[Bracket],
    ticks: vec.Vec.[usize],
    ticks_scanned: bool,
    // the next closing $ (or $$) at or after math1_from (math2_from), or
    // NO_CLOSER: closers do not depend on their openers
    math1_from: usize,
    math1: usize,
    math2_from: usize,
    math2: usize,
    no_comment_end: bool,
    no_pi_end: bool,
    no_decl_end: bool,
    no_cdata_end: bool,
    /// Bytes that link destination scans may still look at in this subject.
    scan_budget: usize,
    /// Link openers below this depth of the bracket stack are inactive (no links in links).
    link_barrier: usize,
    /// For list tightness: bumped whenever blank-line flags change.
    epoch: u32,
    /// Where a thematic break scan of this line failed (a later scan
    /// starting before it would fail there too).
    break_kill: usize,

    fn init(doc: *mut Document, opts: Options, size: usize) Parser {
        return Parser.{
            doc: doc,
            opts: opts,
            refs: maps.Map.[[]u8, RefDef].init(hash.hash_bytes, hash.eq_bytes),
            keys: vec.Vec.[[]mut u8].init(),
            line: strs.String.init(),
            line_number: 0,
            offset: 0,
            column: 0,
            first_nonspace: 0,
            first_nonspace_column: 0,
            indent: 0,
            blank: false,
            partially_consumed_tab: false,
            current: 0,
            ref_budget: @max(size * 10, 100000),
            aligns: vec.Vec.[Align].init(),
            scratch: strs.String.init(),
            s: "",
            sbase: 0,
            pos: 0,
            block: 0,
            delims: vec.Vec.[Delim].init(),
            last_delim: NONE,
            brackets: vec.Vec.[Bracket].init(),
            ticks: vec.Vec.[usize].init(),
            ticks_scanned: false,
            math1_from: NO_CLOSER,
            math1: NO_CLOSER,
            math2_from: NO_CLOSER,
            math2: NO_CLOSER,
            no_comment_end: false,
            no_pi_end: false,
            no_decl_end: false,
            no_cdata_end: false,
            scan_budget: 0,
            link_barrier: 0,
            epoch: 1,
            break_kill: 0,
        };
    }

    fn deinit(self: *mut Parser) void {
        for k in self.keys.items() {
            mem.free(k);
        }
        self.keys.deinit();
        self.refs.deinit();
        self.line.deinit();
        self.aligns.deinit();
        self.scratch.deinit();
        self.delims.deinit();
        self.brackets.deinit();
        self.ticks.deinit();
    }

    fn nd(self: *mut Parser, id: u32) *mut Node {
        return self.doc.nodes.get_ptr(@as(usize, id));
    }

    fn kind(self: *mut Parser, id: u32) Kind {
        return self.doc.nodes.get(@as(usize, id)).kind;
    }

    fn ch(self: *mut Parser, i: usize) u8 {
        if i < self.line.len {
            return self.line.buf[i];
        }
        return 0;
    }

    // --- the tree ---

    /// A new node, appended to `parent`'s children.
    fn append(self: *mut Parser, parent: u32, kind: Kind) !u32 {
        let id = @truncate(u32, self.doc.nodes.len);
        let mut n = new_node(kind, self.line_number);
        n.parent = parent;
        if parent != NONE {
            let p = self.nd(parent);
            n.prev = p.last;
            if p.last != NONE {
                self.nd(p.last).next = id;
            } else {
                p.first = id;
            }
            p.last = id;
        }
        self.doc.nodes.push(n)!;
        return id;
    }

    /// Adds a block, first closing the open blocks that cannot hold it.
    fn add_block(self: *mut Parser, parent: u32, kind: Kind) !u32 {
        let mut p = parent;
        while not can_contain(self.kind(p), kind) {
            p = self.finalize(p)!;
        }
        let id = self.append(p, kind)!;
        self.nd(id).text = Ref.{ off: @truncate(u32, self.doc.raw.len), len: 0, raw: true };
        return id;
    }

    fn unlink(self: *mut Parser, id: u32) void {
        unlink_node(self.doc, id);
    }

    /// Appends the rest of the line (from offset) to a leaf's contents.
    fn add_line(self: *mut Parser, id: u32) !void {
        let start = self.doc.raw.len;
        if self.partially_consumed_tab {
            self.offset += 1;
            let to_tab = 4 - (self.column % 4);
            for _k in 0..to_tab {
                self.doc.raw.push(' ')!;
            }
        }
        if self.offset < self.line.len {
            self.doc.raw.push_str(self.line.bytes()[self.offset..])!;
        }
        let n = self.nd(id);
        n.text.len += @truncate(u32, self.doc.raw.len - start);
    }

    fn content(self: *mut Parser, id: u32) []u8 {
        let r = self.doc.nodes.get(@as(usize, id)).text;
        return self.doc.raw.bytes()[@as(usize, r.off)..@as(usize, r.off) + @as(usize, r.len)];
    }

    // --- the line ---

    fn advance(self: *mut Parser, count: usize, columns: bool) void {
        let mut n = count;
        while n > 0 {
            let c = self.ch(self.offset);
            if c == 0 {
                break;
            }
            if c == '\t' {
                let to_tab = 4 - (self.column % 4);
                if columns {
                    self.partially_consumed_tab = to_tab > n;
                    let adv = @min(n, to_tab);
                    self.column += adv;
                    if not self.partially_consumed_tab {
                        self.offset += 1;
                    }
                    n -= adv;
                } else {
                    self.partially_consumed_tab = false;
                    self.column += to_tab;
                    self.offset += 1;
                    n -= 1;
                }
            } else {
                self.partially_consumed_tab = false;
                self.offset += 1;
                self.column += 1;
                n -= 1;
            }
        }
    }

    fn find_first_nonspace(self: *mut Parser) void {
        let mut to_tab = 4 - (self.column % 4);
        if self.first_nonspace <= self.offset {
            self.first_nonspace = self.offset;
            self.first_nonspace_column = self.column;
            while true {
                let c = self.ch(self.first_nonspace);
                if c == ' ' {
                    self.first_nonspace += 1;
                    self.first_nonspace_column += 1;
                    to_tab -= 1;
                    if to_tab == 0 {
                        to_tab = 4;
                    }
                } else if c == '\t' {
                    self.first_nonspace += 1;
                    self.first_nonspace_column += to_tab;
                    to_tab = 4;
                } else {
                    break;
                }
            }
        }
        self.indent = self.first_nonspace_column - self.column;
        self.blank = is_line_end(self.ch(self.first_nonspace));
    }

    // --- the document ---

    fn document(self: *mut Parser, src: []u8) !void {
        let root = self.append(NONE, Kind.DOCUMENT)!;
        _ = root;
        self.current = 0;
        let mut i: usize = 0;
        while i < src.len {
            let mut e = i;
            while (e < src.len) and (src[e] != '\n') and (src[e] != '\r') {
                e += 1;
            }
            self.line.clear();
            let piece = src[i..e];
            let mut k: usize = 0;
            while k < piece.len {
                let z = strs.index_of_byte(piece[k..], 0) catch piece.len - k;
                self.line.push_str(piece[k..k + z])!;
                k += z;
                if k < piece.len {
                    self.line.push_str("\xef\xbf\xbd")!;
                    k += 1;
                }
            }
            self.line.push('\n')!;
            self.process_line()!;
            i = e;
            if (i < src.len) and (src[i] == '\r') {
                i += 1;
            }
            if (i < src.len) and (src[i] == '\n') {
                i += 1;
            }
        }
        while self.current != 0 {
            self.current = self.finalize(self.current)!;
        }
        _ = self.finalize(0)!;
        if self.opts.gfm {
            self.task_items();
        }
    }

    fn process_line(self: *mut Parser) !void {
        self.line_number += 1;
        self.offset = 0;
        self.column = 0;
        self.first_nonspace = 0;
        self.first_nonspace_column = 0;
        self.indent = 0;
        self.blank = false;
        self.partially_consumed_tab = false;
        self.break_kill = 0;

        // 1. which open blocks does the line continue?
        let mut container: u32 = 0;
        let mut all_matched = false;
        let mut matched = true;
        while true {
            let last = self.nd(container).last;
            if (last == NONE) or not self.nd(last).open {
                all_matched = true;
                break;
            }
            container = last;
            self.find_first_nonspace();
            let k = self.kind(container);
            if k == Kind.BLOCK_QUOTE {
                matched = (self.indent <= 3) and (self.ch(self.first_nonspace) == '>');
                if matched {
                    self.advance(self.indent + 1, true);
                    if is_space_or_tab(self.ch(self.offset)) {
                        self.advance(1, true);
                    }
                }
            } else if k == Kind.ITEM {
                let n = self.nd(container);
                let need = @as(usize, n.marker_offset + n.padding);
                if self.indent >= need {
                    self.advance(need, true);
                } else if self.blank and (n.first != NONE) {
                    self.advance(self.first_nonspace - self.offset, false);
                } else {
                    matched = false;
                }
            } else if k == Kind.CODE_BLOCK {
                let n = self.nd(container);
                if not n.fenced {
                    if self.indent >= 4 {
                        self.advance(4, true);
                    } else if self.blank {
                        self.advance(self.first_nonspace - self.offset, false);
                    } else {
                        matched = false;
                    }
                } else {
                    let mut close: usize = 0;
                    if (self.indent <= 3) and (self.ch(self.first_nonspace) == n.fence_char) {
                        close = scan_close_fence(self.line.bytes(), self.first_nonspace);
                    }
                    if (close > 0) and (close >= @as(usize, n.fence_len)) {
                        // the closing fence ends the line too
                        self.current = self.finalize(container)!;
                        return;
                    }
                    let mut i = n.fence_offset;
                    while (i > 0) and is_space_or_tab(self.ch(self.offset)) {
                        self.advance(1, true);
                        i -= 1;
                    }
                }
            } else if k == Kind.HEADING {
                matched = false;
            } else if k == Kind.HTML_BLOCK {
                let t = self.nd(container).html_type;
                matched = (t <= 5) or not self.blank;
            } else if (k == Kind.PARAGRAPH) or (k == Kind.TABLE) {
                matched = not self.blank;
            }
            if not matched {
                container = self.nd(container).parent;
                break;
            }
        }
        let last_matched = container;

        // 2. new blocks
        let mut maybe_lazy = self.kind(self.current) == Kind.PARAGRAPH;
        let mut ck = self.kind(container);
        while (ck != Kind.CODE_BLOCK) and (ck != Kind.HTML_BLOCK) {
            self.find_first_nonspace();
            let indented = self.indent >= 4;
            let fc = self.ch(self.first_nonspace);
            let line = self.line.bytes();
            let mut m: usize = 0;
            let mut level: u8 = 0;
            let mut html_type: u8 = 0;
            if not indented and (fc == '>') {
                self.advance(self.first_nonspace + 1 - self.offset, false);
                if is_space_or_tab(self.ch(self.offset)) {
                    self.advance(1, true);
                }
                container = self.add_block(container, Kind.BLOCK_QUOTE)!;
            } else if not indented and scan_atx(line, self.first_nonspace, &mut m, &mut level) {
                self.advance(self.first_nonspace + m - self.offset, false);
                container = self.add_block(container, Kind.HEADING)!;
                self.nd(container).level = level;
            } else if not indented and scan_open_fence(line, self.first_nonspace, &mut m) {
                let fo = self.first_nonspace - self.offset;
                container = self.add_block(container, Kind.CODE_BLOCK)!;
                let n = self.nd(container);
                n.fenced = true;
                n.fence_char = fc;
                n.fence_len = @truncate(u32, m);
                n.fence_offset = @truncate(u32, fo);
                self.advance(self.first_nonspace + m - self.offset, false);
            } else if not indented and
                      scan_html_start(line, self.first_nonspace, ck != Kind.PARAGRAPH, &mut html_type) {
                container = self.add_block(container, Kind.HTML_BLOCK)!;
                self.nd(container).html_type = html_type;
            } else if not indented and (ck == Kind.PARAGRAPH) and scan_setext(line, self.first_nonspace, &mut level) {
                if resolve_refs(self, container)! {
                    let n = self.nd(container);
                    n.kind = Kind.HEADING;
                    n.level = level;
                    self.advance(self.line.len - 1 - self.offset, false);
                }
            } else if not indented and not ((ck == Kind.PARAGRAPH) and not all_matched) and
                      (self.break_kill <= self.first_nonspace) and
                      scan_thematic_break(line, self.first_nonspace, &mut self.break_kill) {
                container = self.add_block(container, Kind.THEMATIC_BREAK)!;
                self.advance(self.line.len - 1 - self.offset, false);
            } else if not indented and self.list_start(&mut container, ck == Kind.PARAGRAPH)! {
                // (container is the new item)
            } else if indented and not maybe_lazy and not self.blank {
                self.advance(4, true);
                container = self.add_block(container, Kind.CODE_BLOCK)!;
            } else if not indented and (ck == Kind.PARAGRAPH) and self.opts.gfm and all_matched and
                      table_start(self, container)! {
                // (the paragraph is now the table's header)
                self.advance(self.line.len - 1 - self.offset, false);
            } else {
                break;
            }
            ck = self.kind(container);
            if (ck == Kind.PARAGRAPH) or (ck == Kind.HEADING) or (ck == Kind.CODE_BLOCK) or (ck == Kind.TABLE) {
                break;
            }
            maybe_lazy = false;
        }

        // 3. the rest of the line
        self.find_first_nonspace();
        self.epoch += 1;
        if self.blank {
            let last = self.nd(container).last;
            if last != NONE {
                self.nd(last).last_line_blank = true;
            }
        }
        let ck2 = self.kind(container);
        let cn = self.nd(container);
        let llb = self.blank and (ck2 != Kind.BLOCK_QUOTE) and (ck2 != Kind.HEADING) and
                  (ck2 != Kind.THEMATIC_BREAK) and not ((ck2 == Kind.CODE_BLOCK) and cn.fenced) and
                  not ((ck2 == Kind.ITEM) and (cn.first == NONE) and (cn.line == self.line_number));
        cn.last_line_blank = llb;
        let mut up = cn.parent;
        while up != NONE {
            let u = self.nd(up);
            u.last_line_blank = false;
            up = u.parent;
        }

        if (self.current != last_matched) and (container == last_matched) and not self.blank and
           (self.kind(self.current) == Kind.PARAGRAPH) {
            // lazy continuation of a paragraph
            self.add_line(self.current)!;
            return;
        }
        while self.current != last_matched {
            self.current = self.finalize(self.current)!;
        }
        let k = self.kind(container);
        if k == Kind.CODE_BLOCK {
            self.add_line(container)!;
        } else if k == Kind.HTML_BLOCK {
            self.add_line(container)!;
            let t = self.nd(container).html_type;
            if html_block_ends(t, self.line.bytes(), self.first_nonspace) {
                container = self.finalize(container)!;
            }
        } else if self.blank {
            // nothing
        } else if k == Kind.TABLE {
            table_row(self, container)!;
        } else if (k == Kind.PARAGRAPH) or (k == Kind.HEADING) {
            if k == Kind.HEADING {
                // (a setext heading's underline leaves the line blank, so this is ATX)
                self.chop_closing_hashes();
            }
            self.advance(self.first_nonspace - self.offset, false);
            self.add_line(container)!;
        } else {
            container = self.add_block(container, Kind.PARAGRAPH)!;
            self.advance(self.first_nonspace - self.offset, false);
            self.add_line(container)!;
        }
        self.current = container;
    }

    /// Drops an ATX heading's closing sequence (" ##") and trailing space
    /// from the line.
    fn chop_closing_hashes(self: *mut Parser) void {
        let mut n = self.line.len;
        while (n > self.offset) and is_ascii_space(self.line.buf[n - 1]) {
            n -= 1;
        }
        let orig = n;
        while (n > self.offset) and (self.line.buf[n - 1] == '#') {
            n -= 1;
        }
        if n != orig {
            if n == self.offset {
                n = self.offset;
            } else if is_space_or_tab(self.line.buf[n - 1]) {
                // keep n
            } else {
                n = orig;
            }
        }
        while (n > self.offset) and is_space_or_tab(self.line.buf[n - 1]) {
            n -= 1;
        }
        self.line.len = n;
    }

    fn list_start(self: *mut Parser, container: *mut u32, interrupts: bool) !bool {
        let line = self.line.bytes();
        let pos = self.first_nonspace;
        let c = at(line, pos);
        let mut p = pos;
        let mut ordered = false;
        let mut start: u32 = 0;
        let mut delim: u8 = 0;
        if (c == '*') or (c == '-') or (c == '+') {
            p += 1;
            if not is_ascii_space(at(line, p)) {
                return false;
            }
        } else if is_digit(c) {
            let mut digits: usize = 0;
            while (digits < 9) and is_digit(at(line, p)) {
                start = (start * 10) + @as(u32, line[p] - '0');
                p += 1;
                digits += 1;
            }
            if interrupts and (start != 1) {
                return false;
            }
            let d = at(line, p);
            if (d != '.') and (d != ')') {
                return false;
            }
            p += 1;
            if not is_ascii_space(at(line, p)) {
                return false;
            }
            ordered = true;
            delim = d;
        } else {
            return false;
        }
        if interrupts {
            let mut i = p;
            while is_space_or_tab(at(line, i)) {
                i += 1;
            }
            if is_line_end(at(line, i)) {
                return false;
            }
        }
        let marker = p - pos;
        self.advance(p - self.offset, false);
        let save_tab = self.partially_consumed_tab;
        let save_offset = self.offset;
        let save_column = self.column;
        while (self.column - save_column <= 5) and is_space_or_tab(self.ch(self.offset)) {
            self.advance(1, true);
        }
        let spaces = self.column - save_column;
        let mut padding = marker + spaces;
        if (spaces >= 5) or (spaces < 1) or is_line_end(self.ch(self.offset)) {
            padding = marker + 1;
            self.offset = save_offset;
            self.column = save_column;
            self.partially_consumed_tab = save_tab;
            if spaces > 0 {
                self.advance(1, true);
            }
        }
        let marker_offset = self.indent;
        let mut cont = container.*;
        let cn = self.nd(cont);
        if (cn.kind != Kind.LIST) or (cn.ordered != ordered) or (cn.delim != delim) or
           (not ordered and (cn.bullet != c)) {
            cont = self.add_block(cont, Kind.LIST)!;
            let l = self.nd(cont);
            l.ordered = ordered;
            l.delim = delim;
            if not ordered {
                l.bullet = c;
            }
            l.start = start;
            l.tight = false;
        }
        cont = self.add_block(cont, Kind.ITEM)!;
        let it = self.nd(cont);
        it.marker_offset = @truncate(u32, marker_offset);
        it.padding = @truncate(u32, padding);
        it.ordered = ordered;
        container.* = cont;
        return true;
    }

    // --- closing blocks ---

    /// Closes a block; returns its parent.
    fn finalize(self: *mut Parser, id: u32) !u32 {
        let n = self.nd(id);
        let parent = n.parent;
        n.open = false;
        let k = n.kind;
        if k == Kind.PARAGRAPH {
            if not resolve_refs(self, id)! {
                self.unlink(id);
            }
        } else if k == Kind.CODE_BLOCK {
            if self.nd(id).fenced {
                // the first line is the info string
                let c = self.content(id);
                let nl = strs.index_of_byte(c, '\n') catch c.len;
                let info = trim_ascii(c[..nl]);
                let r = self.nd(id).text;
                let info_ref = unescape_into_buf(self, info)!;
                let body = @min(nl + 1, c.len);
                let n2 = self.nd(id);
                n2.info = info_ref;
                n2.text = Ref.{ off: r.off + @truncate(u32, body), len: r.len - @truncate(u32, body), raw: true };
            } else {
                // drop trailing blank lines
                let c = self.content(id);
                let mut e = c.len;
                while e > 0 {
                    let mut s = e - 1;
                    while (s > 0) and (c[s - 1] != '\n') {
                        s -= 1;
                    }
                    let mut blank = true;
                    for j in s..e - 1 {
                        if not is_space_or_tab(c[j]) {
                            blank = false;
                        }
                    }
                    if not blank {
                        break;
                    }
                    e = s;
                }
                self.nd(id).text.len = @truncate(u32, e);
            }
        } else if k == Kind.HEADING {
            let c = self.content(id);
            let t = trim_ascii(c);
            let r = self.nd(id).text;
            let lead = @truncate(u32, @int_from_ptr(t.ptr) - @int_from_ptr(c.ptr));
            let n2 = self.nd(id);
            if c.len > 0 {
                n2.text = Ref.{ off: r.off + lead, len: @truncate(u32, t.len), raw: true };
            }
        } else if k == Kind.LIST {
            self.nd(id).tight = self.list_is_tight(id);
        }
        return parent;
    }

    /// Whether a block ends with a blank line, looking into the last items
    /// of lists (memoized, so deep nesting stays linear).
    fn ends_with_blank_line(self: *mut Parser, id: u32) bool {
        let mut cur = id;
        let mut result = false;
        while cur != NONE {
            let n = self.nd(cur);
            if n.eb_epoch == self.epoch {
                result = n.eb_val;
                break;
            }
            if n.last_line_blank {
                result = true;
                break;
            }
            if (n.kind == Kind.LIST) or (n.kind == Kind.ITEM) {
                cur = n.last;
            } else {
                cur = NONE;
            }
        }
        // everything on the way down has the same answer
        let mut k = id;
        while (k != NONE) and (k != cur) {
            let n = self.nd(k);
            n.eb_epoch = self.epoch;
            n.eb_val = result;
            if (n.kind == Kind.LIST) or (n.kind == Kind.ITEM) {
                k = n.last;
            } else {
                k = NONE;
            }
        }
        return result;
    }

    fn list_is_tight(self: *mut Parser, id: u32) bool {
        let mut item = self.nd(id).first;
        while item != NONE {
            let it = self.nd(item);
            if it.last_line_blank and (it.next != NONE) {
                return false;
            }
            let item_next = it.next;
            let mut sub = it.first;
            while sub != NONE {
                let sn = self.nd(sub).next;
                if ((item_next != NONE) or (sn != NONE)) and self.ends_with_blank_line(sub) {
                    return false;
                }
                sub = sn;
            }
            item = item_next;
        }
        return true;
    }

    /// GFM task list items: an item whose paragraph starts "[ ] " or "[x] ".
    fn task_items(self: *mut Parser) void {
        for i in 0..self.doc.nodes.len {
            let n = self.doc.nodes.get(i);
            if (n.kind != Kind.ITEM) or (n.first == NONE) {
                continue;
            }
            let p = self.doc.nodes.get(@as(usize, n.first));
            if p.kind != Kind.PARAGRAPH {
                continue;
            }
            let c = self.content(n.first);
            if (c.len < 4) or (c[0] != '[') or (c[2] != ']') or not is_ascii_space(c[3]) {
                continue;
            }
            let x = c[1];
            if (x != ' ') and (x != 'x') and (x != 'X') {
                continue;
            }
            let mut skip: usize = 3;
            while (skip < c.len) and is_space_or_tab(c[skip]) {
                skip += 1;
            }
            let item = self.doc.nodes.get_ptr(i);
            item.task = Task.OPEN;
            if x != ' ' {
                item.task = Task.DONE;
            }
            let pp = self.nd(n.first);
            pp.text.off += @truncate(u32, skip);
            pp.text.len -= @truncate(u32, skip);
        }
    }
}

fn can_contain(parent: Kind, child: Kind) bool {
    if (parent == Kind.DOCUMENT) or (parent == Kind.BLOCK_QUOTE) or (parent == Kind.ITEM) {
        return (child != Kind.ITEM) and (child != Kind.TABLE_ROW) and (child != Kind.TABLE_CELL) and
               not is_inline(child);
    }
    if parent == Kind.LIST {
        return child == Kind.ITEM;
    }
    if parent == Kind.TABLE {
        return child == Kind.TABLE_ROW;
    }
    if parent == Kind.TABLE_ROW {
        return child == Kind.TABLE_CELL;
    }
    return false;
}

fn unlink_node(doc: *mut Document, id: u32) void {
    let n = doc.nodes.get(@as(usize, id));
    if n.prev != NONE {
        doc.nodes.get_ptr(@as(usize, n.prev)).next = n.next;
    } else if n.parent != NONE {
        doc.nodes.get_ptr(@as(usize, n.parent)).first = n.next;
    }
    if n.next != NONE {
        doc.nodes.get_ptr(@as(usize, n.next)).prev = n.prev;
    } else if n.parent != NONE {
        doc.nodes.get_ptr(@as(usize, n.parent)).last = n.prev;
    }
    let m = doc.nodes.get_ptr(@as(usize, id));
    m.parent = NONE;
    m.next = NONE;
    m.prev = NONE;
}

fn trim_ascii(s: []u8) []u8 {
    let mut a: usize = 0;
    let mut b = s.len;
    while (a < b) and is_ascii_space(s[a]) {
        a += 1;
    }
    while (b > a) and is_ascii_space(s[b - 1]) {
        b -= 1;
    }
    return s[a..b];
}

// -----------------------------------------------------------------------------
// Block starts
// -----------------------------------------------------------------------------

/// An ATX heading opener: 1-6 '#' then a space, tab or the end of the line.
/// m gets the length of the opener with the spaces after it.
fn scan_atx(s: []u8, p: usize, m: *mut usize, level: *mut u8) bool {
    let mut i = p;
    while (i < s.len) and (s[i] == '#') and (i - p < 7) {
        i += 1;
    }
    let n = i - p;
    if (n == 0) or (n > 6) {
        return false;
    }
    let c = at(s, i);
    if not is_space_or_tab(c) and not is_line_end(c) {
        return false;
    }
    while is_space_or_tab(at(s, i)) {
        i += 1;
    }
    m.* = i - p;
    level.* = @truncate(u8, n);
    return true;
}

fn scan_open_fence(s: []u8, p: usize, m: *mut usize) bool {
    let c = at(s, p);
    if (c != '`') and (c != '~') {
        return false;
    }
    let mut i = p;
    while at(s, i) == c {
        i += 1;
    }
    if i - p < 3 {
        return false;
    }
    if c == '`' {
        let mut j = i;
        while not is_line_end(at(s, j)) {
            if s[j] == '`' {
                return false;
            }
            j += 1;
        }
    }
    m.* = i - p;
    return true;
}

/// A closing fence at s[p..]: its length, or 0.
fn scan_close_fence(s: []u8, p: usize) usize {
    let c = at(s, p);
    let mut i = p;
    while at(s, i) == c {
        i += 1;
    }
    let n = i - p;
    if n < 3 {
        return 0;
    }
    while is_space_or_tab(at(s, i)) {
        i += 1;
    }
    if not is_line_end(at(s, i)) {
        return 0;
    }
    return n;
}

fn scan_setext(s: []u8, p: usize, level: *mut u8) bool {
    let c = at(s, p);
    if (c != '=') and (c != '-') {
        return false;
    }
    let mut i = p;
    while at(s, i) == c {
        i += 1;
    }
    while is_space_or_tab(at(s, i)) {
        i += 1;
    }
    if not is_line_end(at(s, i)) {
        return false;
    }
    level.* = 2;
    if c == '=' {
        level.* = 1;
    }
    return true;
}

fn scan_thematic_break(s: []u8, p: usize, kill: *mut usize) bool {
    let c = at(s, p);
    if (c != '*') and (c != '-') and (c != '_') {
        return false;
    }
    let mut n: usize = 0;
    let mut i = p;
    while not is_line_end(at(s, i)) {
        if s[i] == c {
            n += 1;
        } else if not is_space_or_tab(s[i]) {
            kill.* = i;
            return false;
        }
        i += 1;
    }
    if n < 3 {
        kill.* = i;
    }
    return n >= 3;
}

pub let BLOCK_TAGS: [62][]u8 = [
    "address",
    "article",
    "aside",
    "base",
    "basefont",
    "blockquote",
    "body",
    "caption",
    "center",
    "col",
    "colgroup",
    "dd",
    "details",
    "dialog",
    "dir",
    "div",
    "dl",
    "dt",
    "fieldset",
    "figcaption",
    "figure",
    "footer",
    "form",
    "frame",
    "frameset",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "head",
    "header",
    "hr",
    "html",
    "iframe",
    "legend",
    "li",
    "link",
    "main",
    "menu",
    "menuitem",
    "nav",
    "noframes",
    "ol",
    "optgroup",
    "option",
    "p",
    "param",
    "search",
    "section",
    "summary",
    "table",
    "tbody",
    "td",
    "tfoot",
    "th",
    "thead",
    "title",
    "tr",
    "track",
    "ul",
];

fn tag_in(name: []u8, list: [][]u8) bool {
    if name.len > 16 {
        return false;
    }
    let mut low: [16]u8 = [0; 16];
    for k in 0..name.len {
        low[k] = lower(name[k]);
    }
    for t in list {
        if @mem_eq(low[..name.len], t) {
            return true;
        }
    }
    return false;
}

pub let RAW_TAGS: [4][]u8 = ["pre", "script", "style", "textarea"];

/// The start of an HTML block (kinds 1 to 7 of the specification; 7 only
/// where it may interrupt).
fn scan_html_start(s: []u8, p: usize, allow7: bool, kind: *mut u8) bool {
    if at(s, p) != '<' {
        return false;
    }
    if has_prefix(s, p, "<!--") {
        kind.* = 2;
        return true;
    }
    if has_prefix(s, p, "<?") {
        kind.* = 3;
        return true;
    }
    if has_prefix(s, p, "<![CDATA[") {
        kind.* = 5;
        return true;
    }
    if (at(s, p + 1) == '!') and is_alpha(at(s, p + 2)) {
        kind.* = 4;
        return true;
    }
    let mut i = p + 1;
    let closing = at(s, i) == '/';
    if closing {
        i += 1;
    }
    let ns = i;
    while is_alnum(at(s, i)) {
        i += 1;
    }
    let name = s[ns..i];
    let after = at(s, i);
    if not closing and tag_in(name, RAW_TAGS[..]) and (is_ascii_space(after) or (after == '>') or (after == 0)) {
        kind.* = 1;
        return true;
    }
    if (name.len > 0) and tag_in(name, BLOCK_TAGS[..]) and
       (is_ascii_space(after) or (after == '>') or (after == 0) or ((after == '/') and (at(s, i + 1) == '>'))) {
        kind.* = 6;
        return true;
    }
    if allow7 {
        let n = scan_tag(s, p);
        if n > 0 {
            let mut j = p + n;
            while is_space_or_tab(at(s, j)) or (at(s, j) == 12) {
                j += 1;
            }
            if is_line_end(at(s, j)) {
                kind.* = 7;
                return true;
            }
        }
    }
    return false;
}

fn contains_ci(s: []u8, from: usize, needle: []u8) bool {
    let mut i = from;
    while i + needle.len <= s.len {
        if has_prefix_ci(s, i, needle) {
            return true;
        }
        i += 1;
    }
    return false;
}

fn html_block_ends(kind: u8, s: []u8, p: usize) bool {
    if kind == 1 {
        return contains_ci(s, p, "</script>") or contains_ci(s, p, "</pre>") or contains_ci(s, p, "</style>") or
               contains_ci(s, p, "</textarea>");
    }
    if kind == 2 {
        return contains_ci(s, p, "-->");
    }
    if kind == 3 {
        return contains_ci(s, p, "?>");
    }
    if kind == 4 {
        return contains_ci(s, p, ">");
    }
    if kind == 5 {
        return contains_ci(s, p, "]]>");
    }
    return false;
}

// -----------------------------------------------------------------------------
// HTML tags (for kind 7 blocks and raw inline HTML)
// -----------------------------------------------------------------------------

fn is_tag_space(c: u8) bool {
    return (c == ' ') or (c == '\t') or (c == '\n') or (c == '\r') or (c == 12) or (c == 11);
}

/// An open or closing tag at s[p] ('<'): its length, or 0.
fn scan_tag(s: []u8, p: usize) usize {
    let mut i = p + 1;
    if at(s, i) == '/' {
        i += 1;
        if not is_alpha(at(s, i)) {
            return 0;
        }
        while is_alnum(at(s, i)) or (at(s, i) == '-') {
            i += 1;
        }
        while is_tag_space(at(s, i)) {
            i += 1;
        }
        if at(s, i) != '>' {
            return 0;
        }
        return i + 1 - p;
    }
    if not is_alpha(at(s, i)) {
        return 0;
    }
    while is_alnum(at(s, i)) or (at(s, i) == '-') {
        i += 1;
    }
    // attributes
    while true {
        let ws = i;
        while is_tag_space(at(s, i)) {
            i += 1;
        }
        let c = at(s, i);
        if (i == ws) or not (is_alpha(c) or (c == '_') or (c == ':')) {
            i = ws;
            break;
        }
        i += 1;
        while is_alnum(at(s, i)) or (at(s, i) == '_') or (at(s, i) == '.') or (at(s, i) == ':') or (at(s, i) == '-') {
            i += 1;
        }
        // value
        let before = i;
        while is_tag_space(at(s, i)) {
            i += 1;
        }
        if at(s, i) != '=' {
            i = before;
            continue;
        }
        i += 1;
        while is_tag_space(at(s, i)) {
            i += 1;
        }
        let q = at(s, i);
        if (q == '"') or (q == '\'') {
            i += 1;
            while (i < s.len) and (s[i] != q) {
                i += 1;
            }
            if i >= s.len {
                return 0;
            }
            i += 1;
        } else {
            let vs = i;
            while i < s.len {
                let v = s[i];
                if is_tag_space(v) or (v == '"') or (v == '\'') or (v == '=') or (v == '<') or (v == '>') or
                   (v == '`') or (v == 0) {
                    break;
                }
                i += 1;
            }
            if i == vs {
                return 0;
            }
        }
    }
    while is_tag_space(at(s, i)) {
        i += 1;
    }
    if at(s, i) == '/' {
        i += 1;
    }
    if at(s, i) != '>' {
        return 0;
    }
    return i + 1 - p;
}

// -----------------------------------------------------------------------------
// Entities, escapes, link pieces
// -----------------------------------------------------------------------------

fn entity_lookup(name: []u8) i64 {
    let mut lo: usize = 0;
    let mut hi: usize = ent.COUNT;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let k = ent.NAMES[@as(usize, ent.OFFSET[mid])..@as(usize, ent.OFFSET[mid + 1])];
        let c = strs.compare(k, name);
        if c == 0 {
            return @int_cast(i64, mid);
        }
        if c < 0 {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return -1;
}

/// An entity or numeric character reference at s[i] ('&'): its length (0
/// if there is none) and its code points.
fn scan_entity(s: []u8, i: usize, cp1: *mut u32, cp2: *mut u32) usize {
    let mut j = i + 1;
    cp2.* = 0;
    if at(s, j) == '#' {
        j += 1;
        let mut v: u32 = 0;
        let mut digits: usize = 0;
        if (at(s, j) == 'x') or (at(s, j) == 'X') {
            j += 1;
            while strs.is_hex_digit(at(s, j)) and (digits < 6) {
                let c = at(s, j);
                let mut d = @as(u32, c - '0');
                if c >= 'a' {
                    d = @as(u32, c - 'a') + 10;
                } else if c >= 'A' {
                    d = @as(u32, c - 'A') + 10;
                }
                v = (v * 16) + d;
                j += 1;
                digits += 1;
            }
        } else {
            while is_digit(at(s, j)) and (digits < 7) {
                v = (v * 10) + @as(u32, at(s, j) - '0');
                j += 1;
                digits += 1;
            }
        }
        if (digits == 0) or (at(s, j) != ';') {
            return 0;
        }
        if (v == 0) or (v > 0x10ffff) or ((v >= 0xd800) and (v < 0xe000)) {
            v = 0xfffd;
        }
        cp1.* = v;
        return j + 1 - i;
    }
    while is_alnum(at(s, j)) and (j - i <= 32) {
        j += 1;
    }
    if (j == i + 1) or (at(s, j) != ';') {
        return 0;
    }
    let k = entity_lookup(s[i + 1..j]);
    if k < 0 {
        return 0;
    }
    cp1.* = ent.FIRST[@truncate(usize, @bit_cast(u64, k))];
    cp2.* = ent.SECOND[@truncate(usize, @bit_cast(u64, k))];
    return j + 1 - i;
}

/// Appends s with backslash escapes and entities decoded.
fn unescape_to(out: *mut strs.String, s: []u8) !void {
    let mut i: usize = 0;
    let mut run: usize = 0;
    while i < s.len {
        let c = s[i];
        if (c == '\\') and (i + 1 < s.len) and is_ascii_punct(s[i + 1]) {
            out.push_str(s[run..i])!;
            out.push(s[i + 1])!;
            i += 2;
            run = i;
        } else if c == '&' {
            let mut a: u32 = 0;
            let mut b: u32 = 0;
            let n = scan_entity(s, i, &mut a, &mut b);
            if n > 0 {
                out.push_str(s[run..i])!;
                out.push_rune(a)!;
                if b != 0 {
                    out.push_rune(b)!;
                }
                i += n;
                run = i;
            } else {
                i += 1;
            }
        } else {
            i += 1;
        }
    }
    out.push_str(s[run..])!;
}

/// A link label at s[p] ('['): the index just past ']', with the label's
/// contents in [ls, le); 0 if there is none (unbalanced or over 999 characters).
fn scan_label(s: []u8, p: usize, ls: *mut usize, le: *mut usize) usize {
    if at(s, p) != '[' {
        return 0;
    }
    let mut i = p + 1;
    while i < s.len {
        let c = s[i];
        if (c == '[') or (c == ']') {
            break;
        }
        if c == '\\' {
            i += 1;
            if (i < s.len) and is_ascii_punct(s[i]) {
                i += 1;
            }
        } else {
            i += 1;
        }
        if i - (p + 1) > 999 {
            return 0;
        }
    }
    if at(s, i) != ']' {
        return 0;
    }
    ls.* = p + 1;
    le.* = i;
    return i + 1;
}

/// A link destination at s[p]: its length (the bytes in [ds, de)), or -1.
fn scan_destination(s: []u8, p: usize, ds: *mut usize, de: *mut usize) i64 {
    let mut i = p;
    if at(s, i) == '<' {
        i += 1;
        while i < s.len {
            let c = s[i];
            if c == '>' {
                ds.* = p + 1;
                de.* = i;
                return @int_cast(i64, i + 1 - p);
            }
            if c == '\\' {
                i += 2;
            } else if (c == '\n') or (c == '<') {
                return -1;
            } else {
                i += 1;
            }
        }
        return -1;
    }
    let mut depth: usize = 0;
    while i < s.len {
        let c = s[i];
        if (c == '\\') and (i + 1 < s.len) and is_ascii_punct(s[i + 1]) {
            i += 2;
        } else if c == '(' {
            depth += 1;
            i += 1;
            if depth > 32 {
                return -1;
            }
        } else if c == ')' {
            if depth == 0 {
                break;
            }
            depth -= 1;
            i += 1;
        } else if (c <= 32) or (c == 127) {
            if i == p {
                return -1;
            }
            break;
        } else {
            i += 1;
        }
    }
    if (i >= s.len) or (depth != 0) {
        return -1;
    }
    ds.* = p;
    de.* = i;
    return @int_cast(i64, i - p);
}

/// A link title at s[p]: its length, quotes included, or 0.
fn scan_title(s: []u8, p: usize) usize {
    let open = at(s, p);
    let mut close = open;
    if open == '(' {
        close = ')';
    } else if (open != '"') and (open != '\'') {
        return 0;
    }
    let mut i = p + 1;
    while i < s.len {
        let c = s[i];
        if c == close {
            return i + 1 - p;
        }
        if (open == '(') and (c == '(') {
            return 0;
        }
        if (c == '\\') and (i + 1 < s.len) and is_ascii_punct(s[i + 1]) {
            i += 2;
        } else {
            i += 1;
        }
    }
    return 0;
}

/// Skips spaces and tabs and at most one line ending.
fn skip_spnl(s: []u8, p: usize) usize {
    let mut i = p;
    while is_space_or_tab(at(s, i)) {
        i += 1;
    }
    if at(s, i) == '\r' {
        i += 1;
    }
    if at(s, i) == '\n' {
        i += 1;
    }
    while is_space_or_tab(at(s, i)) {
        i += 1;
    }
    return i;
}

/// A reference label, normalized for matching: case-folded, runs of white
/// space as one space, trimmed. Owned by the caller.
fn normalize_label(label: []u8) ![]mut u8 {
    let folded = uni.case_fold(label)!;
    defer mem.free(folded);
    let mut out = strs.String.init();
    let mut space = false;
    for c in folded {
        if is_ascii_space(c) {
            space = out.len > 0;
            continue;
        }
        if space {
            out.push(' ')!;
            space = false;
        }
        out.push(c)!;
    }
    return out.take();
}

// -----------------------------------------------------------------------------
// Link reference definitions and tables (block phase)
// -----------------------------------------------------------------------------

fn unescape_into_buf(p: *mut Parser, s: []u8) !Ref {
    let off = p.doc.buf.len;
    unescape_to(&mut p.doc.buf, s)!;
    return Ref.{ off: @truncate(u32, off), len: @truncate(u32, p.doc.buf.len - off), raw: false };
}

/// Takes the link reference definitions off the start of a paragraph;
/// whether anything is left.
fn resolve_refs(p: *mut Parser, id: u32) !bool {
    let c = p.content(id);
    let mut pos: usize = 0;
    while (pos < c.len) and (c[pos] == '[') {
        let n = parse_ref(p, c, pos)!;
        if n == 0 {
            break;
        }
        pos = n;
    }
    let r = p.nd(id);
    r.text.off += @truncate(u32, pos);
    r.text.len -= @truncate(u32, pos);
    for b in c[pos..] {
        if not is_ascii_space(b) {
            return true;
        }
    }
    return false;
}

/// A link reference definition at s[pos]: where it ends, or 0.
fn parse_ref(p: *mut Parser, s: []u8, pos: usize) !usize {
    let mut ls: usize = 0;
    let mut le: usize = 0;
    let mut i = scan_label(s, pos, &mut ls, &mut le);
    if i == 0 {
        return 0;
    }
    let label = trim_ascii(s[ls..le]);
    if (label.len == 0) or (at(s, i) != ':') {
        return 0;
    }
    i = skip_spnl(s, i + 1);
    let mut ds: usize = 0;
    let mut de: usize = 0;
    let dl = scan_destination(s, i, &mut ds, &mut de);
    if dl < 0 {
        return 0;
    }
    i += @truncate(usize, @bit_cast(u64, dl));
    let before_title = i;
    let j = skip_spnl(s, i);
    let mut tl: usize = 0;
    if j != before_title {
        tl = scan_title(s, j);
    }
    if tl > 0 {
        i = j + tl;
    }
    let mut k = i;
    while is_space_or_tab(at(s, k)) {
        k += 1;
    }
    if (k < s.len) and (s[k] != '\n') {
        if tl == 0 {
            return 0;
        }
        tl = 0;
        k = before_title;
        while is_space_or_tab(at(s, k)) {
            k += 1;
        }
        if (k < s.len) and (s[k] != '\n') {
            return 0;
        }
    }
    if k < s.len {
        k += 1;
    }
    let key = normalize_label(label)!;
    if (key.len == 0) or p.refs.contains(key) {
        mem.free(key);
        return k;
    }
    p.keys.push(key)!;
    let url = unescape_into_buf(p, s[ds..de])!;
    let mut title = no_ref();
    if tl > 0 {
        title = unescape_into_buf(p, s[j + 1..j + tl - 1])!;
    }
    p.refs.put(key, RefDef.{ url: url, title: title })!;
    return k;
}

struct Cell {
    a: usize,
    b: usize,
}

/// Splits a table row at unescaped pipes (a leading and a trailing pipe are
/// optional); the cells are trimmed.
fn row_cells(s: []u8, out: *mut vec.Vec.[Cell]) !void {
    out.clear();
    let mut i: usize = 0;
    let mut end = s.len;
    while (end > 0) and is_ascii_space(s[end - 1]) {
        end -= 1;
    }
    while (i < end) and is_ascii_space(s[i]) {
        i += 1;
    }
    if (i < end) and (s[i] == '|') {
        i += 1;
    }
    while i < end {
        let start = i;
        while (i < end) and (s[i] != '|') {
            if (s[i] == '\\') and (i + 1 < end) {
                i += 1;
            }
            i += 1;
        }
        let mut a = start;
        let mut b = @min(i, end);
        while (a < b) and is_ascii_space(s[a]) {
            a += 1;
        }
        while (b > a) and is_ascii_space(s[b - 1]) {
            b -= 1;
        }
        out.push(Cell.{ a: a, b: b })!;
        if i < end {
            i += 1;  // the pipe
        }
    }
}

/// A delimiter row under a paragraph whose last line has as many cells
/// makes that line a table header.
fn table_start(p: *mut Parser, para: u32) !bool {
    let line = p.line.bytes();
    let row = line[p.first_nonspace..line.len - 1];
    let mut cells = vec.Vec.[Cell].init();
    defer cells.deinit();
    row_cells(row, &mut cells)!;
    if cells.len == 0 {
        return false;
    }
    let first_align = p.aligns.len;
    for c in cells.items() {
        let d = row[c.a..c.b];
        if d.len == 0 {
            p.aligns.truncate(first_align);
            return false;
        }
        let mut a: usize = 0;
        let mut b = d.len;
        let left = d[0] == ':';
        let right = d[d.len - 1] == ':';
        if left {
            a = 1;
        }
        if right and (b > a) {
            b -= 1;
        }
        if a >= b {
            p.aligns.truncate(first_align);
            return false;
        }
        for x in d[a..b] {
            if x != '-' {
                p.aligns.truncate(first_align);
                return false;
            }
        }
        let mut al = Align.NONE;
        if left and right {
            al = Align.CENTER;
        } else if left {
            al = Align.LEFT;
        } else if right {
            al = Align.RIGHT;
        }
        p.aligns.push(al)!;
    }
    let ncols = cells.len;
    // the paragraph's last line
    let c = p.content(para);
    let mut ls = c.len - 1;
    while (ls > 0) and (c[ls - 1] != '\n') {
        ls -= 1;
    }
    let header = c[ls..c.len - 1];
    row_cells(header, &mut cells)!;
    if cells.len != ncols {
        p.aligns.truncate(first_align);
        return false;
    }
    let r = p.nd(para).text;
    if ls > 0 {
        // the lines before stay a paragraph
        let before = p.append(NONE, Kind.PARAGRAPH)!;
        let bn = p.nd(before);
        bn.text = Ref.{ off: r.off, len: @truncate(u32, ls), raw: true };
        bn.line = p.nd(para).line;
        insert_before(p.doc, para, before);
        _ = p.finalize(before)!;
    }
    let t = p.nd(para);
    t.kind = Kind.TABLE;
    t.start = @truncate(u32, ncols);
    t.fence_offset = @truncate(u32, first_align);
    t.text = Ref.{ off: r.off + @truncate(u32, ls), len: r.len - @truncate(u32, ls), raw: true };
    let hoff = r.off + @truncate(u32, ls);
    add_row(p, para, hoff, &mut cells, true)!;
    return true;
}

fn add_row(p: *mut Parser, table: u32, off: u32, cells: *vec.Vec.[Cell], header: bool) !void {
    let t = p.doc.nodes.get(@as(usize, table));
    let row = p.append(table, Kind.TABLE_ROW)!;
    let rn = p.nd(row);
    rn.open = false;
    rn.header = header;
    let ncols = @as(usize, t.start);
    for k in 0..ncols {
        let cell = p.append(row, Kind.TABLE_CELL)!;
        let cn = p.nd(cell);
        cn.open = false;
        cn.align = p.aligns.get(@as(usize, t.fence_offset) + k);
        if k < cells.len {
            let c = cells.get(k);
            cn.text = Ref.{ off: off + @truncate(u32, c.a), len: @truncate(u32, c.b - c.a), raw: true };
        } else {
            cn.text = Ref.{ off: off, len: 0, raw: true };
        }
    }
}

fn table_row(p: *mut Parser, table: u32) !void {
    let off = p.doc.raw.len;
    let line = p.line.bytes();
    p.doc.raw.push_str(line[p.first_nonspace..line.len - 1])!;
    let mut cells = vec.Vec.[Cell].init();
    defer cells.deinit();
    row_cells(p.doc.raw.bytes()[off..], &mut cells)!;
    add_row(p, table, @truncate(u32, off), &mut cells, false)!;
}

fn insert_before(doc: *mut Document, at_id: u32, id: u32) void {
    let a = doc.nodes.get(@as(usize, at_id));
    let n = doc.nodes.get_ptr(@as(usize, id));
    n.parent = a.parent;
    n.next = at_id;
    n.prev = a.prev;
    if a.prev != NONE {
        doc.nodes.get_ptr(@as(usize, a.prev)).next = id;
    } else if a.parent != NONE {
        doc.nodes.get_ptr(@as(usize, a.parent)).first = id;
    }
    doc.nodes.get_ptr(@as(usize, at_id)).prev = id;
}

fn insert_after(doc: *mut Document, at_id: u32, id: u32) void {
    let a = doc.nodes.get(@as(usize, at_id));
    let n = doc.nodes.get_ptr(@as(usize, id));
    n.parent = a.parent;
    n.prev = at_id;
    n.next = a.next;
    if a.next != NONE {
        doc.nodes.get_ptr(@as(usize, a.next)).prev = id;
    } else if a.parent != NONE {
        doc.nodes.get_ptr(@as(usize, a.parent)).last = id;
    }
    doc.nodes.get_ptr(@as(usize, at_id)).next = id;
}

/// Moves a node to the end of `parent`'s children.
fn append_child(doc: *mut Document, parent: u32, id: u32) void {
    unlink_node(doc, id);
    let p = doc.nodes.get(@as(usize, parent));
    let n = doc.nodes.get_ptr(@as(usize, id));
    n.parent = parent;
    n.prev = p.last;
    if p.last != NONE {
        doc.nodes.get_ptr(@as(usize, p.last)).next = id;
    } else {
        doc.nodes.get_ptr(@as(usize, parent)).first = id;
    }
    doc.nodes.get_ptr(@as(usize, parent)).last = id;
}

// -----------------------------------------------------------------------------
// Inlines
// -----------------------------------------------------------------------------

struct Delim {
    node: u32,
    c: u8,
    len: usize,
    can_open: bool,
    can_close: bool,
    pos: usize,
    prev: u32,
    next: u32,
}

struct Bracket {
    node: u32,
    pos: usize,
    image: bool,
    after: bool,
}

pub const MAX_BACKTICKS: usize = 1000;

fn inlines_all(p: *mut Parser) !void {
    p.ticks.clear();
    for _k in 0..MAX_BACKTICKS + 1 {
        p.ticks.push(0)!;
    }
    let count = p.doc.nodes.len;
    for i in 0..count {
        let n = p.doc.nodes.get(i);
        if n.parent == NONE and (i != 0) {
            continue;  // removed
        }
        if (n.kind != Kind.PARAGRAPH) and (n.kind != Kind.HEADING) and (n.kind != Kind.TABLE_CELL) {
            continue;
        }
        let id = @truncate(u32, i);
        let mut r = n.text;
        if n.kind == Kind.TABLE_CELL {
            // \| stands for a pipe in a cell, even inside code
            let c = p.doc.str(r);
            if strs.contains(c, "\\|") {
                let start = p.doc.raw.len;
                let mut k: usize = 0;
                p.scratch.clear();
                while k < c.len {
                    if (c[k] == '\\') and (k + 1 < c.len) and (c[k + 1] == '|') {
                        k += 1;
                    }
                    p.scratch.push(c[k])!;
                    k += 1;
                }
                p.doc.raw.push_str(p.scratch.bytes())!;
                r = Ref.{ off: @truncate(u32, start), len: @truncate(u32, p.doc.raw.len - start), raw: true };
            }
        }
        let first = @truncate(u32, p.doc.nodes.len);
        parse_inlines(p, id, r)!;
        merge_text(p, id, first)!;
        if p.opts.gfm {
            autolink_block(p, id)!;
        }
    }
}

fn subject_at(p: *mut Parser, i: usize) u8 {
    if i < p.s.len {
        return p.s[i];
    }
    return 0;
}

fn peek(p: *mut Parser) u8 {
    return subject_at(p, p.pos);
}

fn parse_inlines(p: *mut Parser, block: u32, r: Ref) !void {
    let mut s = p.doc.str(r);
    while (s.len > 0) and is_ascii_space(s[s.len - 1]) {
        s = s[..s.len - 1];
    }
    p.s = s;
    p.sbase = r.off;
    p.pos = 0;
    p.block = block;
    p.delims.clear();
    p.last_delim = NONE;
    p.brackets.clear();
    p.link_barrier = 0;
    p.ticks_scanned = false;
    p.math1_from = NO_CLOSER;
    p.math2_from = NO_CLOSER;
    p.no_comment_end = false;
    p.no_pi_end = false;
    p.no_decl_end = false;
    p.no_cdata_end = false;
    p.scan_budget = (s.len * 8) + 4096;
    while p.pos < p.s.len {
        parse_inline(p)!;
    }
    process_emphasis(p, 0)!;
}

fn text_node(p: *mut Parser, a: usize, b: usize) !u32 {
    let id = p.append(p.block, Kind.TEXT)!;
    p.nd(id).text = Ref.{ off: p.sbase + @truncate(u32, a), len: @truncate(u32, b - a), raw: true };
    return id;
}

fn text_node_buf(p: *mut Parser, r: Ref) !u32 {
    let id = p.append(p.block, Kind.TEXT)!;
    p.nd(id).text = r;
    return id;
}

fn buf_ref(p: *mut Parser, s: []u8) !Ref {
    let off = p.doc.buf.len;
    p.doc.buf.push_str(s)!;
    return Ref.{ off: @truncate(u32, off), len: @truncate(u32, s.len), raw: false };
}

fn is_special(c: u8, gfm: bool, math: bool) bool {
    return (c == '\n') or (c == '\r') or (c == '`') or (c == '\\') or (c == '&') or (c == '_') or (c == '*') or
           (c == '[') or (c == ']') or (c == '<') or (c == '!') or (gfm and (c == '~')) or (math and (c == '$'));
}

fn parse_inline(p: *mut Parser) !void {
    let c = peek(p);
    if (c == '\n') or (c == '\r') {
        let nl = p.pos;
        if peek(p) == '\r' {
            p.pos += 1;
        }
        if peek(p) == '\n' {
            p.pos += 1;
        }
        while is_space_or_tab(peek(p)) {
            p.pos += 1;
        }
        if (nl > 1) and (p.s[nl - 1] == ' ') and (p.s[nl - 2] == ' ') {
            _ = p.append(p.block, Kind.HARD_BREAK)!;
        } else {
            _ = p.append(p.block, Kind.SOFT_BREAK)!;
        }
    } else if c == '`' {
        handle_backticks(p)!;
    } else if (c == '$') and p.opts.math {
        handle_dollars(p)!;
    } else if c == '\\' {
        p.pos += 1;
        let d = peek(p);
        if is_ascii_punct(d) {
            p.pos += 1;
            _ = text_node(p, p.pos - 1, p.pos)!;
        } else if (d == '\n') or (d == '\r') {
            if d == '\r' {
                p.pos += 1;
            }
            if peek(p) == '\n' {
                p.pos += 1;
            }
            while is_space_or_tab(peek(p)) {
                p.pos += 1;
            }
            _ = p.append(p.block, Kind.HARD_BREAK)!;
        } else {
            _ = text_node(p, p.pos - 1, p.pos)!;
        }
    } else if c == '&' {
        let mut a: u32 = 0;
        let mut b: u32 = 0;
        let n = scan_entity(p.s, p.pos, &mut a, &mut b);
        if n > 0 {
            let off = p.doc.buf.len;
            p.doc.buf.push_rune(a)!;
            if b != 0 {
                p.doc.buf.push_rune(b)!;
            }
            _ = text_node_buf(p, Ref.{ off: @truncate(u32, off), len: @truncate(u32, p.doc.buf.len - off),
                                       raw: false })!;
            p.pos += n;
        } else {
            p.pos += 1;
            _ = text_node(p, p.pos - 1, p.pos)!;
        }
    } else if c == '<' {
        handle_pointy(p)!;
    } else if (c == '*') or (c == '_') or ((c == '~') and p.opts.gfm) {
        handle_delim(p, c)!;
    } else if c == '[' {
        p.pos += 1;
        let t = text_node(p, p.pos - 1, p.pos)!;
        push_bracket(p, t, false)!;
    } else if c == ']' {
        handle_close_bracket(p)!;
    } else if c == '!' {
        p.pos += 1;
        if peek(p) == '[' {
            p.pos += 1;
            let t = text_node(p, p.pos - 2, p.pos)!;
            push_bracket(p, t, true)!;
        } else {
            _ = text_node(p, p.pos - 1, p.pos)!;
        }
    } else {
        let start = p.pos;
        let gfm = p.opts.gfm;
        let math = p.opts.math;
        let mut e = p.pos;
        while (e < p.s.len) and not is_special(p.s[e], gfm, math) {
            e += 1;
        }
        p.pos = e;
        let mut te = e;
        if (e < p.s.len) and ((p.s[e] == '\n') or (p.s[e] == '\r')) {
            while (te > start) and is_ascii_space(p.s[te - 1]) {
                te -= 1;
            }
        }
        if te > start {
            _ = text_node(p, start, te)!;
        }
        if e == start {
            // (a special character with no handler here)
            p.pos += 1;
            _ = text_node(p, start, p.pos)!;
        }
    }
}

// --- code spans ---

fn handle_backticks(p: *mut Parser) !void {
    let start = p.pos;
    while peek(p) == '`' {
        p.pos += 1;
    }
    let n = p.pos - start;
    let after = p.pos;
    let close = scan_closing_ticks(p, n);
    if close == 0 {
        p.pos = after;
        _ = text_node(p, start, after)!;
        return;
    }
    // contents: line endings become spaces; one space off each end if both have one
    let raw = p.s[after..close - n];
    let off = p.doc.buf.len;
    for b in raw {
        if (b == '\n') or (b == '\r') {
            p.doc.buf.push(' ')!;
        } else {
            p.doc.buf.push(b)!;
        }
    }
    let mut a = off;
    let mut e = p.doc.buf.len;
    let body = p.doc.buf.bytes()[off..e];
    if (body.len >= 2) and (body[0] == ' ') and (body[body.len - 1] == ' ') {
        let mut all = true;
        for b in body {
            if b != ' ' {
                all = false;
                break;
            }
        }
        if not all {
            a += 1;
            e -= 1;
        }
    }
    let id = p.append(p.block, Kind.CODE)!;
    p.nd(id).text = Ref.{ off: @truncate(u32, a), len: @truncate(u32, e - a), raw: false };
}

// --- math ---

const NO_CLOSER: usize = 0xffffffff;  // (inputs are under 1 GB)

fn handle_dollars(p: *mut Parser) !void {
    let start = p.pos;
    while peek(p) == '$' {
        p.pos += 1;
    }
    let n = p.pos - start;
    let after = p.pos;
    if n == 1 {
        let c = peek(p);
        if c == '`' {
            // GitHub's $`...`$: the backticks as in a code span (the same
            // number on each side), then the $ right after them
            while peek(p) == '`' {
                p.pos += 1;
            }
            let k = p.pos - after;
            let close = scan_closing_ticks(p, k);
            if (close != 0) and (at(p.s, close) == '$') {
                let id = p.append(p.block, Kind.MATH)!;
                p.nd(id).text = Ref.{
                    off: p.sbase + @truncate(u32, after + k), len: @truncate(u32, close - k - (after + k)), raw: true };
                p.pos = close + 1;
                return;
            }
        } else if (c != 0) and not is_ascii_space(c) {
            let close = math_closer1(p, after);
            if close != NO_CLOSER {
                let id = p.append(p.block, Kind.MATH)!;
                p.nd(id).text = Ref.{ off: p.sbase + @truncate(u32, after), len: @truncate(u32, close - after),
                                      raw: true };
                p.pos = close + 1;
                return;
            }
        }
    } else if n == 2 {
        let close = math_closer2(p, after);
        if close != NO_CLOSER {
            let mut a = after;
            let mut e = close;
            while (a < e) and is_ascii_space(p.s[a]) {
                a += 1;
            }
            while (e > a) and is_ascii_space(p.s[e - 1]) {
                e -= 1;
            }
            if e > a {
                let id = p.append(p.block, Kind.DISPLAY_MATH)!;
                p.nd(id).text = Ref.{ off: p.sbase + @truncate(u32, a), len: @truncate(u32, e - a), raw: true };
                p.pos = close + 2;
                return;
            }
        }
    }
    p.pos = after;
    _ = text_node(p, start, after)!;
}

/// The next $ at or after `from` that can close inline math: alone (not
/// in $$), not escaped, after a non-space and not before a digit.
fn math_closer1(p: *mut Parser, from: usize) usize {
    if (p.math1_from != NO_CLOSER) and (p.math1_from <= from) and ((p.math1 == NO_CLOSER) or (p.math1 >= from)) {
        return p.math1;
    }
    let s = p.s;
    let mut found = NO_CLOSER;
    let mut i = @max(from, 1);
    while i < s.len {
        if s[i] == '$' {
            let b = s[i - 1];
            let nx = at(s, i + 1);
            if (b != '$') and (b != '\\') and not is_ascii_space(b) and (nx != '$') and not is_digit(nx) {
                found = i;
                break;
            }
        }
        i += 1;
    }
    p.math1_from = from;
    p.math1 = found;
    return found;
}

/// The next unescaped $$ at or after `from`.
fn math_closer2(p: *mut Parser, from: usize) usize {
    if (p.math2_from != NO_CLOSER) and (p.math2_from <= from) and ((p.math2 == NO_CLOSER) or (p.math2 >= from)) {
        return p.math2;
    }
    let s = p.s;
    let mut found = NO_CLOSER;
    let mut i = from;
    while i + 1 < s.len {
        if (s[i] == '$') and (s[i + 1] == '$') and ((i == 0) or (s[i - 1] != '\\')) {
            found = i;
            break;
        }
        i += 1;
    }
    p.math2_from = from;
    p.math2 = found;
    return found;
}

/// Where the run of exactly n backticks closing a code span ends, or 0.
fn scan_closing_ticks(p: *mut Parser, n: usize) usize {
    if n > MAX_BACKTICKS {
        return 0;
    }
    if p.ticks_scanned and (p.ticks.get(n) <= p.pos) {
        return 0;
    }
    if not p.ticks_scanned {
        for k in 0..MAX_BACKTICKS + 1 {
            p.ticks.set(k, 0);
        }
    }
    while true {
        while (p.pos < p.s.len) and (p.s[p.pos] != '`') {
            p.pos += 1;
        }
        if p.pos >= p.s.len {
            break;
        }
        let ts = p.pos;
        while peek(p) == '`' {
            p.pos += 1;
        }
        let m = p.pos - ts;
        if m <= MAX_BACKTICKS {
            p.ticks.set(m, ts);
        }
        if m == n {
            return p.pos;
        }
    }
    p.ticks_scanned = true;
    return 0;
}

// --- < ... >: autolinks and raw HTML ---

fn scan_autolink_uri(s: []u8, p: usize) usize {
    let mut i = p;
    if not is_alpha(at(s, i)) {
        return 0;
    }
    i += 1;
    while is_alnum(at(s, i)) or (at(s, i) == '.') or (at(s, i) == '+') or (at(s, i) == '-') {
        i += 1;
    }
    let n = i - p;
    if (n < 2) or (n > 32) or (at(s, i) != ':') {
        return 0;
    }
    i += 1;
    while i < s.len {
        let c = s[i];
        if c == '>' {
            return i + 1 - p;
        }
        if (c <= 32) or (c == '<') {
            return 0;
        }
        i += 1;
    }
    return 0;
}

fn is_email_local(c: u8) bool {
    return is_alnum(c) or ((c != 0) and (strs.index_of_byte(".!#$%&'*+/=?^_`{|}~-", c) catch 99) != 99);
}

fn scan_autolink_email(s: []u8, p: usize) usize {
    let mut i = p;
    while is_email_local(at(s, i)) {
        i += 1;
    }
    if (i == p) or (at(s, i) != '@') {
        return 0;
    }
    i += 1;
    while true {
        // a label: alphanumerics and hyphens, not starting or ending with a hyphen, at most 63
        let ls = i;
        if not is_alnum(at(s, i)) {
            return 0;
        }
        while is_alnum(at(s, i)) or (at(s, i) == '-') {
            i += 1;
        }
        if (s[i - 1] == '-') or (i - ls > 63) {
            return 0;
        }
        if at(s, i) == '.' {
            i += 1;
            continue;
        }
        if at(s, i) == '>' {
            return i + 1 - p;
        }
        return 0;
    }
    return 0;
}

fn find_from(s: []u8, from: usize, needle: []u8) i64 {
    let i = strs.index_of_from(s, needle, from) catch return -1;
    return @int_cast(i64, i);
}

/// Raw HTML at s[p] ('<') that is not an open or closing tag: its length or 0.
fn scan_html_other(pr: *mut Parser, p: usize) usize {
    let s = pr.s;
    if has_prefix(s, p, "<!--") {
        if has_prefix(s, p, "<!-->") {
            return 5;
        }
        if has_prefix(s, p, "<!--->") {
            return 6;
        }
        if pr.no_comment_end {
            return 0;
        }
        let e = find_from(s, p + 4, "-->");
        if e < 0 {
            pr.no_comment_end = true;
            return 0;
        }
        return @truncate(usize, @bit_cast(u64, e)) + 3 - p;
    }
    if has_prefix(s, p, "<?") {
        if pr.no_pi_end {
            return 0;
        }
        let e = find_from(s, p + 2, "?>");
        if e < 0 {
            pr.no_pi_end = true;
            return 0;
        }
        return @truncate(usize, @bit_cast(u64, e)) + 2 - p;
    }
    if has_prefix(s, p, "<![CDATA[") {
        if pr.no_cdata_end {
            return 0;
        }
        let e = find_from(s, p + 9, "]]>");
        if e < 0 {
            pr.no_cdata_end = true;
            return 0;
        }
        return @truncate(usize, @bit_cast(u64, e)) + 3 - p;
    }
    if (at(s, p + 1) == '!') and is_alpha(at(s, p + 2)) {
        if pr.no_decl_end {
            return 0;
        }
        let e = find_from(s, p + 2, ">");
        if e < 0 {
            pr.no_decl_end = true;
            return 0;
        }
        return @truncate(usize, @bit_cast(u64, e)) + 1 - p;
    }
    return 0;
}

fn handle_pointy(p: *mut Parser) !void {
    let start = p.pos;
    let mut n = scan_autolink_uri(p.s, start + 1);
    let mut email = false;
    if n == 0 {
        n = scan_autolink_email(p.s, start + 1);
        email = n > 0;
    }
    if n > 0 {
        let contents = p.s[start + 1..start + n];
        p.pos = start + 1 + n;
        let link = p.append(p.block, Kind.LINK)!;
        let off = p.doc.buf.len;
        if email {
            p.doc.buf.push_str("mailto:")!;
        }
        unescape_entities_to(&mut p.doc.buf, contents)!;
        p.nd(link).text = Ref.{ off: @truncate(u32, off), len: @truncate(u32, p.doc.buf.len - off), raw: false };
        let toff = p.doc.buf.len;
        unescape_entities_to(&mut p.doc.buf, contents)!;
        let t = p.append(link, Kind.TEXT)!;
        p.nd(t).text = Ref.{ off: @truncate(u32, toff), len: @truncate(u32, p.doc.buf.len - toff), raw: false };
        return;
    }
    let mut h = scan_tag(p.s, start);
    if h == 0 {
        h = scan_html_other(p, start);
    }
    if h > 0 {
        p.pos = start + h;
        let id = p.append(p.block, Kind.HTML_INLINE)!;
        p.nd(id).text = Ref.{ off: p.sbase + @truncate(u32, start), len: @truncate(u32, h), raw: true };
        return;
    }
    p.pos = start + 1;
    _ = text_node(p, start, start + 1)!;
}

/// Appends s with entities (but not backslash escapes) decoded.
fn unescape_entities_to(out: *mut strs.String, s: []u8) !void {
    let mut i: usize = 0;
    let mut run: usize = 0;
    while i < s.len {
        if s[i] == '&' {
            let mut a: u32 = 0;
            let mut b: u32 = 0;
            let n = scan_entity(s, i, &mut a, &mut b);
            if n > 0 {
                out.push_str(s[run..i])!;
                out.push_rune(a)!;
                if b != 0 {
                    out.push_rune(b)!;
                }
                i += n;
                run = i;
                continue;
            }
        }
        i += 1;
    }
    out.push_str(s[run..])!;
}

// --- emphasis ---

fn char_before(s: []u8, i: usize) u32 {
    if i == 0 {
        return '\n';
    }
    let mut k = i - 1;
    while (k > 0) and ((s[k] & 0xc0) == 0x80) and (i - k < 4) {
        k -= 1;
    }
    let r = strs.decode_rune(s[k..i]);
    return r.value;
}

fn char_at(s: []u8, i: usize) u32 {
    if i >= s.len {
        return '\n';
    }
    return strs.decode_rune(s[i..]).value;
}

fn handle_delim(p: *mut Parser, c: u8) !void {
    let start = p.pos;
    while peek(p) == c {
        p.pos += 1;
    }
    let n = p.pos - start;
    let before = char_before(p.s, start);
    let after = char_at(p.s, p.pos);
    let sp_before = is_unicode_space(before);
    let sp_after = is_unicode_space(after);
    let pu_before = is_unicode_punct(before);
    let pu_after = is_unicode_punct(after);
    let left = not sp_after and (not pu_after or sp_before or pu_before);
    let right = not sp_before and (not pu_before or sp_after or pu_after);
    let mut can_open = left;
    let mut can_close = right;
    if c == '_' {
        can_open = left and (not right or pu_before);
        can_close = right and (not left or pu_after);
    }
    let t = text_node(p, start, p.pos)!;
    if c == '~' and (n > 2) {
        return;
    }
    if can_open or can_close {
        let d = Delim.{
            node: t,
            c: c,
            len: n,
            can_open: can_open,
            can_close: can_close,
            pos: p.pos,
            prev: p.last_delim,
            next: NONE,
        };
        let id = @truncate(u32, p.delims.len);
        p.delims.push(d)!;
        if p.last_delim != NONE {
            p.delims.get_ptr(@as(usize, p.last_delim)).next = id;
        }
        p.last_delim = id;
    }
}

fn remove_delim(p: *mut Parser, id: u32) void {
    let d = p.delims.get(@as(usize, id));
    if d.next != NONE {
        p.delims.get_ptr(@as(usize, d.next)).prev = d.prev;
    } else {
        p.last_delim = d.prev;
    }
    if d.prev != NONE {
        p.delims.get_ptr(@as(usize, d.prev)).next = d.next;
    }
}

fn bottom_index(d: Delim) usize {
    if d.c == '~' {
        return 12;
    }
    let mut k = d.len % 3;
    if d.can_open {
        k += 3;
    }
    if d.c == '*' {
        k += 6;
    }
    return k;
}

fn process_emphasis(p: *mut Parser, stack_bottom: usize) !void {
    let mut bottoms: [13]usize = [stack_bottom; 13];
    // the first delimiter above the bottom
    let mut closer = NONE;
    let mut cand = p.last_delim;
    while (cand != NONE) and (p.delims.get(@as(usize, cand)).pos >= stack_bottom) {
        closer = cand;
        cand = p.delims.get(@as(usize, cand)).prev;
    }
    while closer != NONE {
        let cd = p.delims.get(@as(usize, closer));
        if not cd.can_close {
            closer = cd.next;
            continue;
        }
        let bi = bottom_index(cd);
        let mut opener = cd.prev;
        let mut found = false;
        while opener != NONE {
            let od = p.delims.get(@as(usize, opener));
            if od.pos < bottoms[bi] {
                break;
            }
            if od.can_open and (od.c == cd.c) {
                if (not (cd.can_open or od.can_close)) or (cd.len % 3 == 0) or ((od.len + cd.len) % 3 != 0) {
                    found = true;
                    break;
                }
            }
            opener = od.prev;
        }
        let old = closer;
        if found {
            if cd.c == '~' {
                closer = insert_strike(p, opener, closer)!;
            } else {
                closer = insert_emph(p, opener, closer)!;
            }
        } else {
            closer = cd.next;
            bottoms[bi] = cd.pos;
            if not cd.can_open {
                remove_delim(p, old);
            }
        }
    }
    while (p.last_delim != NONE) and (p.delims.get(@as(usize, p.last_delim)).pos >= stack_bottom) {
        remove_delim(p, p.last_delim);
    }
}

fn insert_emph(p: *mut Parser, opener: u32, closer: u32) !u32 {
    let od = p.delims.get(@as(usize, opener));
    let cd = p.delims.get(@as(usize, closer));
    let mut on = @as(usize, p.nd(od.node).text.len);
    let mut cn = @as(usize, p.nd(cd.node).text.len);
    let mut use: usize = 1;
    if (on >= 2) and (cn >= 2) {
        use = 2;
    }
    on -= use;
    cn -= use;
    p.nd(od.node).text.len = @truncate(u32, on);
    p.nd(cd.node).text.len = @truncate(u32, cn);
    // delimiters in between are done
    let mut d = cd.prev;
    while (d != NONE) and (d != opener) {
        let prev = p.delims.get(@as(usize, d)).prev;
        remove_delim(p, d);
        d = prev;
    }
    let mut kind = Kind.EMPH;
    if use == 2 {
        kind = Kind.STRONG;
    }
    let emph = p.append(NONE, kind)!;
    let mut t = p.nd(od.node).next;
    while (t != NONE) and (t != cd.node) {
        let nx = p.nd(t).next;
        append_child(p.doc, emph, t);
        t = nx;
    }
    insert_after(p.doc, od.node, emph);
    if on == 0 {
        unlink_node(p.doc, od.node);
        remove_delim(p, opener);
    }
    if cn == 0 {
        unlink_node(p.doc, cd.node);
        let nx = p.delims.get(@as(usize, closer)).next;
        remove_delim(p, closer);
        return nx;
    }
    return closer;
}

fn insert_strike(p: *mut Parser, opener: u32, closer: u32) !u32 {
    let od = p.delims.get(@as(usize, opener));
    let cd = p.delims.get(@as(usize, closer));
    let res = cd.next;
    if p.nd(od.node).text.len == p.nd(cd.node).text.len {
        let st = p.append(NONE, Kind.STRIKETHROUGH)!;
        let mut t = p.nd(od.node).next;
        while (t != NONE) and (t != cd.node) {
            let nx = p.nd(t).next;
            append_child(p.doc, st, t);
            t = nx;
        }
        insert_after(p.doc, od.node, st);
        unlink_node(p.doc, od.node);
        unlink_node(p.doc, cd.node);
    }
    let mut d = closer;
    while (d != NONE) and (d != opener) {
        let prev = p.delims.get(@as(usize, d)).prev;
        remove_delim(p, d);
        d = prev;
    }
    remove_delim(p, opener);
    return res;
}

// --- links and images ---

fn push_bracket(p: *mut Parser, node: u32, image: bool) !void {
    if p.brackets.len > 0 {
        p.brackets.get_ptr(p.brackets.len - 1).after = true;
    }
    p.brackets.push(Bracket.{ node: node, pos: p.pos, image: image, after: false })!;
}

fn handle_close_bracket(p: *mut Parser) !void {
    p.pos += 1;
    let initial = p.pos;
    if p.brackets.len == 0 {
        _ = text_node(p, p.pos - 1, p.pos)!;
        return;
    }
    let opener = p.brackets.get(p.brackets.len - 1);
    if not opener.image and (p.brackets.len - 1 < p.link_barrier) {
        pop_bracket(p);
        _ = text_node(p, p.pos - 1, p.pos)!;
        return;
    }
    let s = p.s;
    let mut url = no_ref();
    let mut title = no_ref();
    let mut matched = false;
    // an inline link: (destination "title")
    if peek(p) == '(' {
        let sp = skip_spnl(s, p.pos + 1);
        let mut ds: usize = 0;
        let mut de: usize = 0;
        let mut dl: i64 = -1;
        if p.scan_budget > 0 {
            dl = scan_destination(s, sp, &mut ds, &mut de);
            let used = @max(de, sp) - sp + 1;
            p.scan_budget -= @min(p.scan_budget, used);
        }
        if dl >= 0 {
            let end_url = sp + @truncate(usize, @bit_cast(u64, dl));
            let st = skip_spnl(s, end_url);
            let mut et = st;
            if st != end_url {
                et = st + scan_title(s, st);
            }
            let ea = skip_spnl(s, et);
            if at(s, ea) == ')' {
                p.pos = ea + 1;
                url = unescape_into_buf(p, s[ds..de])!;
                if et > st {
                    title = unescape_into_buf(p, s[st + 1..et - 1])!;
                }
                matched = true;
            }
        }
    }
    if not matched {
        // a reference link: [text][label], [text][] or [text]
        p.pos = initial;
        let mut ls: usize = 0;
        let mut le: usize = 0;
        let after = scan_label(s, initial, &mut ls, &mut le);
        let mut label: []u8 = "";
        let mut found = after > 0;
        if found {
            label = trim_ascii(s[ls..le]);
            p.pos = after;
        }
        if ((not found) or (label.len == 0)) and not opener.after {
            label = s[opener.pos..initial - 1];
            found = true;
        }
        if found and (label.len <= 999) {
            let key = normalize_label(label)!;
            defer mem.free(key);
            if p.refs.contains(key) {
                let def = p.refs.get(key)!;
                let cost = @as(usize, def.url.len) + @as(usize, def.title.len);
                if cost <= p.ref_budget {
                    p.ref_budget -= cost;
                    url = def.url;
                    title = def.title;
                    matched = true;
                }
            }
        }
    }
    if not matched {
        pop_bracket(p);
        p.pos = initial;
        _ = text_node(p, initial - 1, initial)!;
        return;
    }
    let mut kind = Kind.LINK;
    if opener.image {
        kind = Kind.IMAGE;
    }
    let link = p.append(NONE, kind)!;
    let ln = p.nd(link);
    ln.text = url;
    ln.info = title;
    insert_before(p.doc, opener.node, link);
    let mut t = p.nd(opener.node).next;
    while t != NONE {
        let nx = p.nd(t).next;
        append_child(p.doc, link, t);
        t = nx;
    }
    unlink_node(p.doc, opener.node);
    process_emphasis(p, opener.pos)!;
    pop_bracket(p);
    // no links in links: the link openers still open are now inactive
    if not opener.image {
        p.link_barrier = p.brackets.len;
    }
}

fn pop_bracket(p: *mut Parser) void {
    p.brackets.truncate(p.brackets.len - 1);
    p.link_barrier = @min(p.link_barrier, p.brackets.len);
}

// --- after the inline parse of a block ---

/// Joins runs of adjacent TEXT nodes (the parser makes many small ones).
fn merge_text(p: *mut Parser, block: u32, first: u32) !void {
    merge_children(p, block)!;
    // the inline containers made for this block
    let mut i = @as(usize, first);
    while i < p.doc.nodes.len {
        let n = p.doc.nodes.get(i);
        if (n.first != NONE) and is_inline(n.kind) {
            merge_children(p, @truncate(u32, i))!;
        }
        i += 1;
    }
}

fn merge_children(p: *mut Parser, parent: u32) !void {
    let mut c = p.nd(parent).first;
    while c != NONE {
        let n = p.doc.nodes.get(@as(usize, c));
        if (n.kind != Kind.TEXT) or (n.next == NONE) or (p.kind(n.next) != Kind.TEXT) {
            c = n.next;
            continue;
        }
        // a run of text nodes from c: contiguous in one buffer?
        let mut contiguous = true;
        let mut end = n.text.off + n.text.len;
        let mut e = n.next;
        while (e != NONE) and (p.kind(e) == Kind.TEXT) {
            let t = p.nd(e).text;
            if (t.raw != n.text.raw) or (t.off != end) {
                contiguous = false;
            }
            end = t.off + t.len;
            e = p.nd(e).next;
        }
        if contiguous {
            p.nd(c).text.len = end - n.text.off;
        } else {
            p.scratch.clear();
            let mut k = c;
            while k != e {
                p.scratch.push_str(p.doc.str(p.nd(k).text))!;
                k = p.nd(k).next;
            }
            let r = buf_ref(p, p.scratch.bytes())!;
            p.nd(c).text = r;
        }
        // drop the rest of the run
        let mut k = p.nd(c).next;
        while k != e {
            let nx = p.nd(k).next;
            unlink_node(p.doc, k);
            k = nx;
        }
        c = e;
    }
}

fn is_host_char(c: u8) bool {
    return is_alnum(c) or (c == '-') or (c >= 0x80);
}

/// A domain at s[0..]: its length, or 0. Underscores are not allowed in
/// the last two labels; without allow_short it needs a dot.
fn check_domain(s: []u8, allow_short: bool) usize {
    let mut np: usize = 0;
    let mut us1: usize = 0;
    let mut us2: usize = 0;
    let mut i: usize = 1;
    while i + 1 < s.len + 1 {
        if i >= s.len {
            break;
        }
        let c = s[i];
        if c == '_' {
            us2 += 1;
        } else if c == '.' {
            us1 = us2;
            us2 = 0;
            np += 1;
        } else if not is_host_char(c) {
            break;
        }
        i += 1;
    }
    if (us1 > 0) or (us2 > 0) {
        if np <= 10 {
            return 0;
        }
    }
    if allow_short or (np > 0) {
        return i;
    }
    return 0;
}

/// Trims trailing punctuation, unbalanced ')' and entity-like "&x;" off
/// the end of an autolink.
fn autolink_delim(s: []u8, end0: usize) usize {
    let mut end = end0;
    let mut opening: usize = 0;
    let mut closing: usize = 0;
    for i in 0..end {
        let c = s[i];
        if c == '<' {
            end = i;
            break;
        }
        if c == '(' {
            opening += 1;
        } else if c == ')' {
            closing += 1;
        }
    }
    while end > 0 {
        let c = s[end - 1];
        if c == ')' {
            if closing <= opening {
                return end;
            }
            closing -= 1;
            end -= 1;
        } else if (c == '?') or (c == '!') or (c == '.') or (c == ',') or (c == ':') or (c == '*') or (c == '_') or
                  (c == '~') or (c == '\'') or (c == '"') {
            end -= 1;
        } else if c == ';' {
            if end < 2 {
                end -= 1;
                continue;
            }
            let mut ne = end - 2;
            while (ne > 0) and is_alpha(s[ne]) {
                ne -= 1;
            }
            if (ne < end - 2) and (s[ne] == '&') {
                end = ne;
            } else {
                end -= 1;
            }
        } else {
            return end;
        }
    }
    return end;
}

/// One extended autolink in s: [a, b) with the URL prefix to add ("",
/// "http://" or "mailto:"); false if there is none.
fn find_autolink(s: []u8, text_start: bool, a: *mut usize, b: *mut usize, prefix: *mut []u8) bool {
    let mut i: usize = 0;
    while i < s.len {
        let c = s[i];
        if (c == 'w') and has_prefix(s, i, "www.") {
            let ok = ((i == 0) and text_start) or
                     ((i > 0) and
                      (is_ascii_space(s[i - 1]) or (s[i - 1] == '*') or (s[i - 1] == '_') or (s[i - 1] == '~') or
                       (s[i - 1] == '(')));
            if ok {
                let d = check_domain(s[i..], false);
                if d > 0 {
                    let mut e = i + d;
                    while (e < s.len) and not is_ascii_space(s[e]) and (s[e] != '<') {
                        e += 1;
                    }
                    let l = autolink_delim(s[i..], e - i);
                    if l > 0 {
                        a.* = i;
                        b.* = i + l;
                        prefix.* = "http://";
                        return true;
                    }
                }
            }
        } else if (c == ':') and has_prefix(s, i + 1, "//") {
            let mut r = i;
            while (r > 0) and is_alpha(s[r - 1]) {
                r -= 1;
            }
            let scheme = s[r..i];
            if (scheme.len > 0) and
               (strs.eq_ignore_case(scheme, "http") or strs.eq_ignore_case(scheme, "https") or
                strs.eq_ignore_case(scheme, "ftp")) {
                let ds = i + 3;
                let d = check_domain(s[ds..], true);
                if (ds < s.len) and (d > 0) {
                    let mut e = ds + d;
                    while (e < s.len) and not is_ascii_space(s[e]) and (s[e] != '<') {
                        e += 1;
                    }
                    let l = autolink_delim(s[r..], e - r);
                    if l > 0 {
                        a.* = r;
                        b.* = r + l;
                        prefix.* = "";
                        return true;
                    }
                }
            }
        } else if c == '@' {
            let mut r = i;
            while (r > 0) and
                  (is_alnum(s[r - 1]) or (s[r - 1] == '.') or (s[r - 1] == '+') or (s[r - 1] == '-') or
                   (s[r - 1] == '_')) {
                r -= 1;
            }
            if r < i {
                let mut e = i + 1;
                let mut np: usize = 0;
                while e < s.len {
                    let d = s[e];
                    if is_alnum(d) {
                        e += 1;
                    } else if (d == '.') and (e + 1 < s.len) and is_alnum(s[e + 1]) {
                        np += 1;
                        e += 1;
                    } else if (d == '-') or (d == '_') {
                        e += 1;
                    } else {
                        break;
                    }
                }
                let last = s[e - 1];
                if (e - i >= 2) and (np > 0) and (is_alpha(last) or (last == '.')) {
                    let l = autolink_delim(s[r..], e - r);
                    if l > i - r {
                        a.* = r;
                        b.* = r + l;
                        prefix.* = "mailto:";
                        return true;
                    }
                }
            }
        }
        i += 1;
    }
    return false;
}

fn autolink_block(p: *mut Parser, block: u32) !void {
    // depth first through the block's inlines, outside links
    let mut id = p.nd(block).first;
    let mut links: usize = 0;
    while id != NONE {
        let n = p.doc.nodes.get(@as(usize, id));
        if (n.kind == Kind.LINK) or (n.kind == Kind.IMAGE) {
            links += 1;
        }
        if (n.kind == Kind.TEXT) and (links == 0) {
            autolink_text(p, id)!;
        }
        // next node: down, else along, else up
        let first_child = p.nd(id).first;
        if (first_child != NONE) and is_inline(p.kind(id)) {
            id = first_child;
            continue;
        }
        if (n.kind == Kind.LINK) or (n.kind == Kind.IMAGE) {
            links -= 1;
        }
        while (id != block) and (p.nd(id).next == NONE) {
            id = p.nd(id).parent;
            if id == block {
                break;
            }
            let k = p.kind(id);
            if (k == Kind.LINK) or (k == Kind.IMAGE) {
                links -= 1;
            }
        }
        if id == block {
            break;
        }
        id = p.nd(id).next;
    }
}

/// Splits a text node around the first extended autolink in it (the
/// traversal then visits the link and the rest).
fn autolink_text(p: *mut Parser, id: u32) !void {
    let n = p.doc.nodes.get(@as(usize, id));
    let start_ok = (n.prev == NONE) or (p.kind(n.prev) != Kind.TEXT);
    let s = p.doc.str(n.text);
    let mut a: usize = 0;
    let mut b: usize = 0;
    let mut prefix: []u8 = "";
    if not find_autolink(s, start_ok, &mut a, &mut b, &mut prefix) {
        return;
    }
    let r = n.text;
    let link = p.append(NONE, Kind.LINK)!;
    let off = p.doc.buf.len;
    p.doc.buf.push_str(prefix)!;
    // (s may point into buf, so copy through scratch)
    p.scratch.clear();
    p.scratch.push_str(s[a..b])!;
    p.doc.buf.push_str(p.scratch.bytes())!;
    p.nd(link).text = Ref.{ off: @truncate(u32, off), len: @truncate(u32, p.doc.buf.len - off), raw: false };
    insert_after(p.doc, id, link);
    let t = p.append(link, Kind.TEXT)!;
    p.nd(t).text = Ref.{ off: r.off + @truncate(u32, a), len: @truncate(u32, b - a), raw: r.raw };
    if b < s.len {
        let rest = p.append(NONE, Kind.TEXT)!;
        p.nd(rest).text = Ref.{ off: r.off + @truncate(u32, b), len: r.len - @truncate(u32, b), raw: r.raw };
        insert_after(p.doc, link, rest);
    }
    p.nd(id).text.len = @truncate(u32, a);
}

// -----------------------------------------------------------------------------
// HTML
// -----------------------------------------------------------------------------

fn escape_html(out: *mut strs.String, s: []u8) !void {
    let mut run: usize = 0;
    for i in 0..s.len {
        let c = s[i];
        if (c == '&') or (c == '<') or (c == '>') or (c == '"') {
            out.push_str(s[run..i])!;
            if c == '&' {
                out.push_str("&amp;")!;
            } else if c == '<' {
                out.push_str("&lt;")!;
            } else if c == '>' {
                out.push_str("&gt;")!;
            } else {
                out.push_str("&quot;")!;
            }
            run = i + 1;
        }
    }
    out.push_str(s[run..])!;
}

fn href_safe(c: u8) bool {
    return is_alnum(c) or ((c != 0) and (strs.index_of_byte("-_.+!*(),%#@?=;:/$~", c) catch 99) != 99);
}

/// A URL for an attribute: percent-encodes what is not allowed, escapes & and '.
fn escape_href(out: *mut strs.String, s: []u8) !void {
    let hex = "0123456789ABCDEF";
    for c in s {
        if href_safe(c) {
            out.push(c)!;
        } else if c == '&' {
            out.push_str("&amp;")!;
        } else if c == '\'' {
            out.push_str("&#x27;")!;
        } else {
            out.push('%')!;
            out.push(hex[@as(usize, c >> 4)])!;
            out.push(hex[@as(usize, c & 15)])!;
        }
    }
}

/// javascript:, vbscript:, file: and data: (except for images).
pub fn is_dangerous_url(url: []u8) bool {
    if has_prefix_ci(url, 0, "data:") {
        return not (has_prefix_ci(url, 5, "image/png") or has_prefix_ci(url, 5, "image/gif") or
                    has_prefix_ci(url, 5, "image/jpeg") or has_prefix_ci(url, 5, "image/webp"));
    }
    return has_prefix_ci(url, 0, "javascript:") or has_prefix_ci(url, 0, "vbscript:") or has_prefix_ci(url, 0, "file:");
}

pub let FILTERED_TAGS: [9][]u8 = ["title", "textarea", "style", "xmp", "iframe", "noembed", "noframes", "script",
                                  "plaintext"];

/// Raw HTML, with the GFM tag filter: "<script" becomes "&lt;script".
fn raw_html(out: *mut strs.String, s: []u8, filter: bool) !void {
    if not filter {
        out.push_str(s)!;
        return;
    }
    let mut run: usize = 0;
    let mut i: usize = 0;
    while i < s.len {
        if s[i] == '<' {
            let mut j = i + 1;
            if at(s, j) == '/' {
                j += 1;
            }
            let ns = j;
            while is_alpha(at(s, j)) {
                j += 1;
            }
            let name = s[ns..j];
            let after = at(s, j);
            if (name.len > 0) and tag_in(name, FILTERED_TAGS[..]) and
               (is_tag_space(after) or (after == '>') or (after == 0) or ((after == '/') and (at(s, j + 1) == '>'))) {
                out.push_str(s[run..i])!;
                out.push_str("&lt;")!;
                run = i + 1;
            }
        }
        i += 1;
    }
    out.push_str(s[run..])!;
}

fn cr(out: *mut strs.String) !void {
    if (out.len > 0) and (out.buf[out.len - 1] != '\n') {
        out.push('\n')!;
    }
}

fn put_uint(out: *mut strs.String, v: u32) !void {
    let mut tmp: [10]u8 = [0; 10];
    let mut n: usize = 0;
    let mut x = v;
    while true {
        tmp[n] = @truncate(u8, x % 10) + '0';
        n += 1;
        x /= 10;
        if x == 0 {
            break;
        }
    }
    while n > 0 {
        n -= 1;
        out.push(tmp[n])!;
    }
}

fn in_tight_list(doc: *Document, id: u32) bool {
    let parent = doc.node(id).parent;
    if parent == NONE {
        return false;
    }
    let gp = doc.node(parent).parent;
    if gp == NONE {
        return false;
    }
    let g = doc.node(gp);
    return (g.kind == Kind.LIST) and g.tight;
}

/// The plain text of a node's descendants (for alt text).
fn plain_into(doc: *Document, id: u32, out: *mut strs.String) !void {
    let mut w = Walker.{ doc: doc, id: id, entering: true, started: true };
    // walk the subtree of id only
    let n0 = doc.node(id);
    if n0.first == NONE {
        return;
    }
    w.id = n0.first;
    w.entering = true;
    while true {
        let n = doc.node(w.id);
        if w.entering {
            if (n.kind == Kind.TEXT) or (n.kind == Kind.CODE) or (n.kind == Kind.HTML_INLINE) or
               (n.kind == Kind.MATH) or (n.kind == Kind.DISPLAY_MATH) {
                out.push_str(doc.text(w.id))!;
            } else if (n.kind == Kind.SOFT_BREAK) or (n.kind == Kind.HARD_BREAK) {
                out.push(' ')!;
            }
        }
        // next, without leaving the subtree
        if w.entering and has_exit(n.kind) and (n.first != NONE) {
            w.id = n.first;
            continue;
        }
        let mut cur = w.id;
        while (cur != id) and (doc.node(cur).next == NONE) {
            cur = doc.node(cur).parent;
        }
        if cur == id {
            return;
        }
        w.id = doc.node(cur).next;
        w.entering = true;
    }
}

// Whether a code block's info string starts with the word "math".
fn is_math_info(info: []u8) bool {
    return strs.starts_with(info, "math") and ((info.len == 4) or is_ascii_space(info[4]));
}

// TeX as MathML onto out; false (and nothing written) if it does not parse.
fn math_html(opts: Options, out: *mut strs.String, tex: []u8, display: tmath.Display) !bool {
    if opts.math_html.render(opts.math_html.ctx, tex, display == tmath.Display.BLOCK, out)! {
        return true;
    }
    let mut f = tmath.parse(tex) catch |e| {
        if e == error.OutOfMemory {
            return e;
        }
        return false;
    };
    defer f.deinit();
    f.write_mathml(out.writer(), display)!;
    return true;
}

// Renders into out; with `stream`, whatever piles up there goes on to sink
// every 4 KB or so (all but the last byte, which cr() looks at).
fn render_html(doc: *Document, out: *mut strs.String, sink: io.Writer, stream: bool) !void {
    let opts = doc.opts;
    let mut w = doc.walk();
    // inside an image: children render as plain text (alt), up to this node
    let mut plain: u32 = NONE;
    while w.next() {
        if stream and (out.len >= 4096) {
            let last = out.buf[out.len - 1];
            sink.write_all(out.bytes()[..out.len - 1])!;
            out.clear();
            out.push(last)!;
        }
        let id = w.id;
        let n = doc.node(id);
        let entering = w.entering;
        if plain != NONE {
            if (id == plain) and not entering {
                plain = NONE;
                // falls through to close the image
            } else {
                if entering {
                    if (n.kind == Kind.TEXT) or (n.kind == Kind.CODE) or (n.kind == Kind.HTML_INLINE) or
                       (n.kind == Kind.MATH) or (n.kind == Kind.DISPLAY_MATH) {
                        escape_html(out, doc.text(id))!;
                    } else if (n.kind == Kind.SOFT_BREAK) or (n.kind == Kind.HARD_BREAK) {
                        out.push(' ')!;
                    }
                }
                continue;
            }
        }
        let k = n.kind;
        if k == Kind.DOCUMENT {
            // nothing
        } else if k == Kind.BLOCK_QUOTE {
            cr(out)!;
            if entering {
                out.push_str("<blockquote>\n")!;
            } else {
                out.push_str("</blockquote>\n")!;
            }
        } else if k == Kind.LIST {
            cr(out)!;
            if entering {
                if n.ordered {
                    if n.start != 1 {
                        out.push_str("<ol start=\"")!;
                        put_uint(out, n.start)!;
                        out.push_str("\">\n")!;
                    } else {
                        out.push_str("<ol>\n")!;
                    }
                } else {
                    out.push_str("<ul>\n")!;
                }
            } else if n.ordered {
                out.push_str("</ol>\n")!;
            } else {
                out.push_str("</ul>\n")!;
            }
        } else if k == Kind.ITEM {
            if entering {
                cr(out)!;
                out.push_str("<li>")!;
                if n.task == Task.OPEN {
                    out.push_str("<input disabled=\"\" type=\"checkbox\"> ")!;
                } else if n.task == Task.DONE {
                    out.push_str("<input checked=\"\" disabled=\"\" type=\"checkbox\"> ")!;
                }
            } else {
                out.push_str("</li>\n")!;
            }
        } else if k == Kind.HEADING {
            if entering {
                cr(out)!;
                out.push_str("<h")!;
                out.push('0' + n.level)!;
                out.push('>')!;
            } else {
                out.push_str("</h")!;
                out.push('0' + n.level)!;
                out.push_str(">\n")!;
            }
        } else if (k == Kind.CODE_BLOCK) and opts.math and is_math_info(doc.info(id)) and
                  math_html(opts, out, strs.trim(doc.text(id)), tmath.Display.BLOCK)! {
            cr(out)!;
        } else if k == Kind.CODE_BLOCK {
            cr(out)!;
            let info = doc.info(id);
            if info.len == 0 {
                out.push_str("<pre><code>")!;
            } else {
                let mut e: usize = 0;
                while (e < info.len) and not is_ascii_space(info[e]) {
                    e += 1;
                }
                out.push_str("<pre><code class=\"language-")!;
                escape_html(out, info[..e])!;
                out.push_str("\">")!;
            }
            escape_html(out, doc.text(id))!;
            out.push_str("</code></pre>\n")!;
        } else if k == Kind.HTML_BLOCK {
            cr(out)!;
            if opts.unsafe_html {
                raw_html(out, doc.text(id), opts.tagfilter)!;
            } else {
                out.push_str("<!-- raw HTML omitted -->")!;
            }
            cr(out)!;
        } else if k == Kind.THEMATIC_BREAK {
            cr(out)!;
            out.push_str("<hr />\n")!;
        } else if k == Kind.PARAGRAPH {
            if not in_tight_list(doc, id) {
                if entering {
                    cr(out)!;
                    out.push_str("<p>")!;
                } else {
                    out.push_str("</p>\n")!;
                }
            }
        } else if k == Kind.TABLE {
            if entering {
                cr(out)!;
                out.push_str("<table>\n")!;
            } else {
                // close the body if there was one
                let last = doc.node(n.last);
                if not last.header {
                    out.push_str("</tbody>\n")!;
                }
                out.push_str("</table>\n")!;
            }
        } else if k == Kind.TABLE_ROW {
            if entering {
                if n.header {
                    out.push_str("<thead>\n")!;
                } else if (n.prev != NONE) and doc.node(n.prev).header {
                    out.push_str("<tbody>\n")!;
                }
                out.push_str("<tr>\n")!;
            } else {
                out.push_str("</tr>\n")!;
                if n.header {
                    out.push_str("</thead>\n")!;
                }
            }
        } else if k == Kind.TABLE_CELL {
            let header = doc.node(n.parent).header;
            if entering {
                if header {
                    out.push_str("<th")!;
                } else {
                    out.push_str("<td")!;
                }
                if n.align == Align.LEFT {
                    out.push_str(" align=\"left\"")!;
                } else if n.align == Align.CENTER {
                    out.push_str(" align=\"center\"")!;
                } else if n.align == Align.RIGHT {
                    out.push_str(" align=\"right\"")!;
                }
                out.push('>')!;
            } else if header {
                out.push_str("</th>\n")!;
            } else {
                out.push_str("</td>\n")!;
            }
        } else if k == Kind.TEXT {
            escape_html(out, doc.text(id))!;
        } else if k == Kind.SOFT_BREAK {
            if opts.hard_breaks {
                out.push_str("<br />\n")!;
            } else {
                out.push('\n')!;
            }
        } else if k == Kind.HARD_BREAK {
            out.push_str("<br />\n")!;
        } else if k == Kind.MATH {
            if not math_html(opts, out, doc.text(id), tmath.Display.INLINE)! {
                out.push('$')!;
                escape_html(out, doc.text(id))!;
                out.push('$')!;
            }
        } else if k == Kind.DISPLAY_MATH {
            if not math_html(opts, out, doc.text(id), tmath.Display.BLOCK)! {
                out.push_str("$$")!;
                escape_html(out, doc.text(id))!;
                out.push_str("$$")!;
            }
        } else if k == Kind.CODE {
            out.push_str("<code>")!;
            escape_html(out, doc.text(id))!;
            out.push_str("</code>")!;
        } else if k == Kind.HTML_INLINE {
            if opts.unsafe_html {
                raw_html(out, doc.text(id), opts.tagfilter)!;
            } else {
                out.push_str("<!-- raw HTML omitted -->")!;
            }
        } else if k == Kind.EMPH {
            if entering {
                out.push_str("<em>")!;
            } else {
                out.push_str("</em>")!;
            }
        } else if k == Kind.STRONG {
            if entering {
                out.push_str("<strong>")!;
            } else {
                out.push_str("</strong>")!;
            }
        } else if k == Kind.STRIKETHROUGH {
            if entering {
                out.push_str("<del>")!;
            } else {
                out.push_str("</del>")!;
            }
        } else if k == Kind.LINK {
            if entering {
                out.push_str("<a href=\"")!;
                let url = doc.url(id);
                if opts.unsafe_html or not is_dangerous_url(url) {
                    escape_href(out, url)!;
                }
                out.push('"')!;
                let t = doc.title(id);
                if t.len > 0 {
                    out.push_str(" title=\"")!;
                    escape_html(out, t)!;
                    out.push('"')!;
                }
                out.push('>')!;
            } else {
                out.push_str("</a>")!;
            }
        } else if k == Kind.IMAGE {
            if entering {
                out.push_str("<img src=\"")!;
                let url = doc.url(id);
                if opts.unsafe_html or not is_dangerous_url(url) {
                    escape_href(out, url)!;
                }
                out.push_str("\" alt=\"")!;
                if n.first != NONE {
                    plain = id;
                    continue;
                }
            }
            if entering or (n.first != NONE) {
                out.push('"')!;
                let t = doc.title(id);
                if t.len > 0 {
                    out.push_str(" title=\"")!;
                    escape_html(out, t)!;
                    out.push('"')!;
                }
                out.push_str(" />")!;
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn expect_html(src: []u8, opts: Options, want: []u8) !void {
    let got = to_html(src, opts)!;
    defer mem.free(got);
    if not strs.eq(got, want) {
        io.stderr().print("markdown: ")!;
        io.stderr().print(src)!;
        io.stderr().print("\n--- want\n")!;
        io.stderr().print(want)!;
        io.stderr().print("--- got\n")!;
        io.stderr().print(got)!;
    }
    @expect(strs.eq(got, want));
}

/// Runs the examples of a specification file (in the commonmark-spec
/// format); `only_ext` keeps those tagged with an extension. Returns
/// [run, failed].
fn run_spec(path: []u8, opts: Options, only_ext: bool) ![2]usize {
    let data = fs.read_file(path)!;
    defer mem.free(data);
    let fence = "````````````````````````````````";
    let mut lines = strs.lines(data);
    let mut run: usize = 0;
    let mut failed: usize = 0;
    let mut src = strs.String.init();
    defer src.deinit();
    let mut want = strs.String.init();
    defer want.deinit();
    while true {
        let line = lines.next() catch break;
        if not strs.starts_with(line, fence) or not has_prefix(line, fence.len, " example") {
            continue;
        }
        let kind = strs.trim(line[fence.len + 8..]);
        src.clear();
        want.clear();
        let mut part = &mut src;
        while true {
            let l = lines.next() catch break;
            if strs.eq(l, fence) {
                break;
            }
            if strs.eq(l, ".") and (part == &mut src) {
                part = &mut want;
                continue;
            }
            // → stands for a tab
            let mut k: usize = 0;
            while k < l.len {
                if has_prefix(l, k, "\xe2\x86\x92") {
                    part.push('\t')!;
                    k += 3;
                } else {
                    part.push(l[k])!;
                    k += 1;
                }
            }
            part.push('\n')!;
        }
        if only_ext and (kind.len == 0) {
            continue;
        }
        let mut o = opts;
        o.tagfilter = strs.eq(kind, "tagfilter");
        run += 1;
        let got = to_html(src.bytes(), o)!;
        defer mem.free(got);
        if not strs.eq(got, want.bytes()) {
            failed += 1;
            io.stderr().print("--- example:\n")!;
            io.stderr().print(src.bytes())!;
            io.stderr().print("--- want\n")!;
            io.stderr().print(want.bytes())!;
            io.stderr().print("--- got\n")!;
            io.stderr().print(got)!;
        }
    }
    return [run, failed];
}

test "CommonMark 0.31.2 specification" {
    let r = run_spec("std/text/markdown/testdata/commonmark-0.31.2.txt", Options.commonmark(), false) catch return;
    @expect_eq(r[0], 652);
    @expect_eq(r[1], 0);
}

test "GFM extensions (tables, strikethrough, autolinks, task lists, tag filter)" {
    let mut o = Options.init();
    o.unsafe_html = true;
    let r = run_spec("std/text/markdown/testdata/gfm-0.29.txt", o, true) catch return;
    @expect_eq(r[0], 24);
    @expect_eq(r[1], 0);
}

test "safe by default" {
    let o = Options.init();
    expect_html("<script>alert(1)</script>\n\nhi <b onclick=\"x\">there</b>", o,
                "<!-- raw HTML omitted -->\n<p>hi <!-- raw HTML omitted -->there<!-- raw HTML omitted --></p>\n")!;
    expect_html("[a](javascript:alert(1)) [b](JAVASCRIPT:x) ![c](data:text/html,x) ![d](data:image/png;base64,AA==)", o,
                "<p><a href=\"\">a</a> <a href=\"\">b</a> <img src=\"\" alt=\"c\" /> <img src=\"data:image/png;base64,AA==\" alt=\"d\" /></p>\n")!;
    expect_html("[x](<\"onmouseover=alert(1)>) <http://a.b/\"'>", o,
                "<p><a href=\"%22onmouseover=alert(1)\">x</a> <a href=\"http://a.b/%22&#x27;\">http://a.b/&quot;'</a></p>\n")!;
    // with raw HTML allowed, the tag filter still defuses scripts
    let mut u = Options.init();
    u.unsafe_html = true;
    expect_html("<div>\n<SCRIPT>x</script>\n</div>", u, "<div>\n&lt;SCRIPT>x&lt;/script>\n</div>\n")!;
}

test "tree" {
    let mut doc = parse("# Title *em*\n\n- [x] done\n- [ ] todo\n\n```go\nfmt.Println()\n```\n", Options.init())!;
    defer doc.deinit();
    let root = doc.node(doc.root());
    @expect(root.kind == Kind.DOCUMENT);
    let h = doc.node(root.first);
    @expect(h.kind == Kind.HEADING);
    @expect_eq(h.level, 1);
    let t = doc.plain_text(root.first)!;
    defer mem.free(t);
    @expect(strs.eq(t, "Title em"));
    let list = doc.node(h.next);
    @expect(list.kind == Kind.LIST);
    @expect(list.tight);
    @expect(doc.node(list.first).task == Task.DONE);
    @expect(doc.node(doc.node(list.first).next).task == Task.OPEN);
    let code = list.next;
    @expect(doc.node(code).kind == Kind.CODE_BLOCK);
    @expect(strs.eq(doc.info(code), "go"));
    @expect(strs.eq(doc.text(code), "fmt.Println()\n"));
    // a walk enters and leaves containers, and enters leaves once
    let mut w = doc.walk();
    let mut enters: usize = 0;
    let mut leaves: usize = 0;
    while w.next() {
        if w.entering {
            enters += 1;
        } else {
            leaves += 1;
        }
    }
    @expect_eq(w.id, 0);
    @expect(enters > leaves);
}

test "tables" {
    let o = Options.init();
    expect_html("a | b\n:-|-:\n1 | 2 \\| 3\nx\n\npara", o,
                "<table>\n<thead>\n<tr>\n<th align=\"left\">a</th>\n<th align=\"right\">b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"left\">1</td>\n<td align=\"right\">2 | 3</td>\n</tr>\n<tr>\n<td align=\"left\">x</td>\n<td align=\"right\"></td>\n</tr>\n</tbody>\n</table>\n<p>para</p>\n")!;
    // not a table: the header has a different number of cells
    expect_html("a | b\n-|-|-\n", o, "<p>a | b\n-|-|-</p>\n")!;
}

test "hostile input stays linear" {
    // deep nesting of every kind, unclosed constructs, reference blow-up
    let n: usize = 20000;
    let mut s = strs.String.init();
    defer s.deinit();
    for _k in 0..n {
        s.push_str("> - [*a **b _")!;
    }
    for _k in 0..n {
        s.push_str("<!-- ![[]() `` [a](<b -\t")!;
    }
    s.push_str("\n\n[r]: /")!;
    for _k in 0..@as(usize, 1000) {
        s.push('x')!;
    }
    s.push_str("\n\n")!;
    for _k in 0..n {
        s.push_str("[r]")!;
    }
    let h = to_html(s.bytes(), Options.init())!;
    defer mem.free(h);
    // references expanded at most ~10x the input's size
    @expect(h.len < s.len * 12);
}

test "to_html_to streams the same HTML" {
    let mut s = strs.String.init();
    defer s.deinit();
    for k in @as(usize, 0)..400 {
        s.push_str("# Head *em*\n\n> quote `code` <b>x</b>\n> - a\n> - b\n\n```\ncode\n```\n")!;
        s.push_str("![alt *x*](/i.png)\n| a | b |\n|-|-|\n| 1 | ~~2~~ |\n")!;
        if (k % 3) == 0 {
            s.push_str("<div>\nraw\n</div>\n")!;
        }
    }
    let mut o = Options.init();
    o.unsafe_html = (s.len % 2) == 0;
    let h = to_html(s.bytes(), o)!;
    defer mem.free(h);
    @expect(h.len > 20000);
    let mut out = strs.String.init();
    defer out.deinit();
    to_html_to(out.writer(), s.bytes(), o)!;
    @expect(strs.eq(out.bytes(), h));
    let mut small: [5000]u8 = [0; 5000];
    let mut bw = io.BufferWriter.init(small[..]);
    to_html_to(bw.writer(), s.bytes(), o) catch |e| {
        @expect(e == error.NoSpaceLeft);
        return;
    };
    @trap();
}

test "math" {
    let mut o = Options.init();
    o.math = true;
    expect_html("Area $x^2$ here.\n", o,
                "<p>Area <math><semantics><msup><mi>x</mi><mn>2</mn></msup><annotation encoding=\"application/x-tex\">x^2</annotation></semantics></math> here.</p>\n")!;
    // dollars as money, escaped, spaced or empty stay text
    expect_html("$5 and $10\n", o, "<p>$5 and $10</p>\n")!;
    expect_html("\\$x$\n", o, "<p>$x$</p>\n")!;
    expect_html("$ x$\n", o, "<p>$ x$</p>\n")!;
    expect_html("$$ $$\n", o, "<p>$$ $$</p>\n")!;
    // no emphasis or escapes inside; displayed math across lines
    expect_html("$a_1 * b_2$\n", o,
                "<p><math><semantics><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>\u{2217}</mo><msub><mi>b</mi><mn>2</mn></msub></mrow><annotation encoding=\"application/x-tex\">a_1 * b_2</annotation></semantics></math></p>\n")!;
    expect_html("$$\n\\frac{1}{2}\n$$\n", o,
                "<p><math display=\"block\"><semantics><mfrac><mn>1</mn><mn>2</mn></mfrac><annotation encoding=\"application/x-tex\">\\frac{1}{2}</annotation></semantics></math></p>\n")!;
    expect_html("```math\nx<y\n```\n", o,
                "<math display=\"block\"><semantics><mrow><mi>x</mi><mo>&lt;</mo><mi>y</mi></mrow><annotation encoding=\"application/x-tex\">x&lt;y</annotation></semantics></math>\n")!;
    // math that does not parse stays as its source
    expect_html("$\\frac{a}$ and $$x^$$\n", o, "<p>$\\frac{a}$ and $$x^$$</p>\n")!;
    expect_html("```math\n\\foo\n```\n", o, "<pre><code class=\"language-math\">\\foo\n</code></pre>\n")!;
    // GitHub's $`...`$: the backticks delimit, so the dollar rules do not apply
    expect_html("Area $`x^2`$ here.\n", o,
                "<p>Area <math><semantics><msup><mi>x</mi><mn>2</mn></msup><annotation encoding=\"application/x-tex\">x^2</annotation></semantics></math> here.</p>\n")!;
    expect_html("$`` a`b ``$5\n", o,
                "<p><math><semantics><mrow><mi>a</mi><mo form=\"prefix\" lspace=\"0\" rspace=\"0\">`</mo><mi>b</mi></mrow><annotation encoding=\"application/x-tex\"> a`b </annotation></semantics></math>5</p>\n")!;
    // without the closing $ (or with mismatched backticks) it is a code span
    expect_html("$`x` y\n", o, "<p>$<code>x</code> y</p>\n")!;
    expect_html("$``x`$\n", o, "<p>$``x`$</p>\n")!;
    // code spans win when they start first; alt text keeps the source
    expect_html("`$x$` and `a $b` c$\n", o, "<p><code>$x$</code> and <code>a $b</code> c$</p>\n")!;
    expect_html("![$x$](i.png)\n", o, "<p><img src=\"i.png\" alt=\"x\" /></p>\n")!;
    // off by default
    expect_html("$x$\n", Options.init(), "<p>$x$</p>\n")!;
    // many unclosed openers stay linear
    let mut s = strs.String.init();
    defer s.deinit();
    for _k in 0..@as(usize, 50000) {
        s.push_str("$a $$b \\$")!;
    }
    let h = to_html(s.bytes(), o)!;
    defer mem.free(h);
    @expect(h.len >= s.len);
}
