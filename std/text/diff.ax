// =============================================================================
// std/text/diff.ax - differences between texts, unified diffs and patching.
//
//     let mut out = str.String.init();
//     diff.unified(old, new, "a/file", "b/file", 3, out.writer())!;
//     let back = diff.apply(old, out.bytes())!;     // == new; mem.free
//
//     let edits = diff.lines(old, new)!;            // mem.free(edits)
//     for e in edits { ... e.op, e.a_start, e.a_end, e.b_start, e.b_end ... }
//
// The differences are found with Myers's O((n + m) d) algorithm in linear
// space (finding the middle snake, as GNU diff does), so they are minimal
// (fewest lines deleted and inserted), except that, again as in GNU diff,
// a search that grows too expensive settles for a good split instead of
// the best: a pathological input costs O((n + m)^1.5), not O((n + m)^2).
//
// Lines end at "\n" and keep it, so a last line without one differs from
// the same text with one; unified output marks it with "\ No newline at
// end of file", as diff does, and apply understands that.
//
// tokens compares any sequences of u32 (such as words or characters mapped
// to numbers).
// =============================================================================

import "../collections/vec.ax" as vec;
import "../fmt.ax" as fmt;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../str.ax" as strs;

pub error DiffError { InvalidPatch, Conflict, OutOfMemory, NotFound, IoError, Empty, Done, InvalidUtf8 }

/// Edit operations.
pub enum Op: u8 {
    EQUAL,
    DELETE,   // a[a_start..a_end] is removed
    INSERT,   // b[b_start..b_end] is added
    REPLACE,  // a[a_start..a_end] becomes b[b_start..b_end]
}

/// A run of one operation: the lines (or tokens) a[a_start..a_end] of the
/// old sequence and b[b_start..b_end] of the new. For Op.EQUAL they are the
/// same; for Op.DELETE the b range is empty (at the place of the deletion),
/// and for Op.INSERT the a range is.
pub struct Edit {
    op: Op,
    a_start: usize,
    a_end: usize,
    b_start: usize,
    b_end: usize,
}

/// The line-by-line differences of two texts, as a list of runs covering
/// both (so the Op.EQUAL, Op.DELETE and Op.REPLACE runs cover a in order, and the
/// Op.EQUAL, Op.INSERT and Op.REPLACE runs cover b). The caller frees the result.
pub fn lines(a: []u8, b: []u8) DiffError![]mut Edit {
    let mut la = split_lines(a)!;
    defer la.deinit();
    let mut lb = split_lines(b)!;
    defer lb.deinit();
    let ta = mem.alloc.[u32](la.len)!;
    defer mem.free(ta);
    let tb = mem.alloc.[u32](lb.len)!;
    defer mem.free(tb);
    intern(la.items(), lb.items(), ta, tb)!;
    return tokens(ta, tb)!;
}

/// The differences of two sequences of tokens (equal tokens are equal
/// numbers), as for lines.
pub fn tokens(a: []u32, b: []u32) DiffError![]mut Edit {
    let ca = mem.alloc.[bool](a.len)!;
    defer mem.free(ca);
    let cb = mem.alloc.[bool](b.len)!;
    defer mem.free(cb);
    @mem_set(ca, false);
    @mem_set(cb, false);
    compare(a, b, ca, cb)!;
    return runs(ca, cb)!;
}

// Line boundaries: each line with its "\n" (the last may lack one).
fn split_lines(s: []u8) DiffError!vec.Vec.[[]u8] {
    let mut v = vec.Vec.[[]u8].init();
    let mut i: usize = 0;
    while i < s.len {
        let mut j = i;
        while (j < s.len) and (s[j] != '\n') {
            j += 1;
        }
        if j < s.len {
            j += 1;
        }
        v.push(s[i..j]) catch |e| {
            v.deinit();
            return e;
        };
        i = j;
    }
    return v;
}

struct Line {
    s: []u8,
    at: usize,  // index into a, or a.len + index into b
}

fn line_less(x: Line, y: Line) bool {
    return strs.less(x.s, y.s);
}

// Numbers the lines, equal lines getting equal numbers.
fn intern(a: [][]u8, b: [][]u8, ta: []mut u32, tb: []mut u32) DiffError!void {
    let n = a.len + b.len;
    let all = mem.alloc.[Line](n)!;
    defer mem.free(all);
    for k in @as(usize, 0)..a.len {
        all[k] = Line.{ s: a[k], at: k };
    }
    for k in @as(usize, 0)..b.len {
        all[a.len + k] = Line.{ s: b[k], at: a.len + k };
    }
    vec.sort.[Line](all, line_less);
    let mut id: u32 = 0;
    for k in @as(usize, 0)..n {
        if (k > 0) and not strs.eq(all[k].s, all[k - 1].s) {
            id += 1;
        }
        let at = all[k].at;
        if at < a.len {
            ta[at] = id;
        } else {
            tb[at - a.len] = id;
        }
    }
}

// The edit runs from the flags of changed elements.
fn runs(ca: []bool, cb: []bool) DiffError![]mut Edit {
    let mut out = vec.Vec.[Edit].init();
    let mut i: usize = 0;
    let mut j: usize = 0;
    while (i < ca.len) or (j < cb.len) {
        let i0 = i;
        let j0 = j;
        while ((i < ca.len) and (j < cb.len)) and (not ca[i] and not cb[j]) {
            i += 1;
            j += 1;
        }
        if i > i0 {
            out.push(Edit.{ op: Op.EQUAL, a_start: i0, a_end: i, b_start: j0, b_end: j }) catch |e| {
                out.deinit();
                return e;
            };
            continue;
        }
        while (i < ca.len) and ca[i] {
            i += 1;
        }
        while (j < cb.len) and cb[j] {
            j += 1;
        }
        let mut op = Op.REPLACE;
        if j == j0 {
            op = Op.DELETE;
        } else if i == i0 {
            op = Op.INSERT;
        }
        out.push(Edit.{ op: op, a_start: i0, a_end: i, b_start: j0, b_end: j }) catch |e| {
            out.deinit();
            return e;
        };
    }
    let r = mem.alloc.[Edit](out.len) catch |e| {
        out.deinit();
        return e;
    };
    @mem_copy(r, out.items());
    out.deinit();
    return r;
}

// -----------------------------------------------------------------------------
// Myers's algorithm, in linear space
// -----------------------------------------------------------------------------

struct Ctx {
    a: []u32,
    b: []u32,
    ca: []mut bool,
    cb: []mut bool,
    fd: []mut i64,  // furthest forward x on each diagonal (offset by off)
    bd: []mut i64,  // furthest backward x
    off: i64,
    too_expensive: i64,
}

struct Range {
    xoff: i64,
    xlim: i64,
    yoff: i64,
    ylim: i64,
}

fn compare(a: []u32, b: []u32, ca: []mut bool, cb: []mut bool) DiffError!void {
    let size = (a.len + b.len) + 3;
    let fd = mem.alloc.[i64](size)!;
    defer mem.free(fd);
    let bd = mem.alloc.[i64](size)!;
    defer mem.free(bd);
    // as in GNU diff: give up on a minimal answer after about sqrt(n + m)
    // rounds, and no fewer than 4096
    let mut te: i64 = 1;
    let mut t = a.len + b.len + 3;
    while t != 0 {
        t >>= 2;
        te <<= 1;
    }
    let mut cx = Ctx.{ a: a, b: b, ca: ca, cb: cb, fd: fd, bd: bd, off: @as(i64, @int_cast(u32, b.len)) + 1,
                       too_expensive: @max(te, 4096) };
    // an explicit stack of subproblems (the order they finish in does not
    // matter: they only set flags)
    let mut stack = vec.Vec.[Range].init();
    defer stack.deinit();
    stack.push(Range.{ xoff: 0, xlim: len64(a.len), yoff: 0, ylim: len64(b.len) })!;
    while stack.len > 0 {
        let mut r = stack.pop()!;
        // skip the common prefix and suffix
        while ((r.xoff < r.xlim) and (r.yoff < r.ylim)) and (a[ux(r.xoff)] == b[ux(r.yoff)]) {
            r.xoff += 1;
            r.yoff += 1;
        }
        while ((r.xoff < r.xlim) and (r.yoff < r.ylim)) and (a[ux(r.xlim - 1)] == b[ux(r.ylim - 1)]) {
            r.xlim -= 1;
            r.ylim -= 1;
        }
        if r.xoff == r.xlim {
            for y in ux(r.yoff)..ux(r.ylim) {
                cb[y] = true;
            }
            continue;
        }
        if r.yoff == r.ylim {
            for x in ux(r.xoff)..ux(r.xlim) {
                ca[x] = true;
            }
            continue;
        }
        let mut xm: i64 = 0;
        let mut ym: i64 = 0;
        middle_snake(&mut cx, r, &mut xm, &mut ym);
        stack.push(Range.{ xoff: r.xoff, xlim: xm, yoff: r.yoff, ylim: ym })!;
        stack.push(Range.{ xoff: xm, xlim: r.xlim, yoff: ym, ylim: r.ylim })!;
    }
}

fn len64(n: usize) i64 {
    return @as(i64, @int_cast(u32, n));
}

// (x is never negative: diagonals are offset, and positions are indices)
fn ux(x: i64) usize {
    return @truncate(usize, @bit_cast(u64, x));
}

// Finds a point (xm, ym) on an optimal (or, past the cost limit, a good)
// path through the range, which splits it into two smaller problems. The
// range has no common prefix or suffix and is non-empty on both sides.
fn middle_snake(cx: *mut Ctx, r: Range, xm: *mut i64, ym: *mut i64) void {
    let a = cx.a;
    let b = cx.b;
    let fd = cx.fd;
    let bd = cx.bd;
    let off = cx.off;
    let dmin = r.xoff - r.ylim;
    let dmax = r.xlim - r.yoff;
    let fmid = r.xoff - r.yoff;
    let bmid = r.xlim - r.ylim;
    let odd = ((fmid - bmid) & 1) != 0;
    let mut fmin = fmid;
    let mut fmax = fmid;
    let mut bmin = bmid;
    let mut bmax = bmid;
    fd[ux(fmid + off)] = r.xoff;
    bd[ux(bmid + off)] = r.xlim;
    let big: i64 = 0x7fffffffffffffff;
    let mut c: i64 = 1;
    while true {
        // extend the forward search by one edit
        if fmin > dmin {
            fmin -= 1;
            fd[ux((fmin - 1) + off)] = -1;
        } else {
            fmin += 1;
        }
        if fmax < dmax {
            fmax += 1;
            fd[ux((fmax + 1) + off)] = -1;
        } else {
            fmax -= 1;
        }
        let mut d = fmax;
        while d >= fmin {
            let tlo = fd[ux((d - 1) + off)];
            let thi = fd[ux((d + 1) + off)];
            let mut x = tlo + 1;
            if tlo < thi {
                x = thi;
            }
            let mut y = x - d;
            while ((x < r.xlim) and (y < r.ylim)) and (a[ux(x)] == b[ux(y)]) {
                x += 1;
                y += 1;
            }
            fd[ux(d + off)] = x;
            if (odd and (bmin <= d)) and ((d <= bmax) and (bd[ux(d + off)] <= x)) {
                xm.* = x;
                ym.* = y;
                return;
            }
            d -= 2;
        }
        // and the backward search
        if bmin > dmin {
            bmin -= 1;
            bd[ux((bmin - 1) + off)] = big;
        } else {
            bmin += 1;
        }
        if bmax < dmax {
            bmax += 1;
            bd[ux((bmax + 1) + off)] = big;
        } else {
            bmax -= 1;
        }
        d = bmax;
        while d >= bmin {
            let tlo = bd[ux((d - 1) + off)];
            let thi = bd[ux((d + 1) + off)];
            let mut x = thi - 1;
            if tlo < thi {
                x = tlo;
            }
            let mut y = x - d;
            while ((x > r.xoff) and (y > r.yoff)) and (a[ux(x - 1)] == b[ux(y - 1)]) {
                x -= 1;
                y -= 1;
            }
            bd[ux(d + off)] = x;
            if (not odd and (fmin <= d)) and ((d <= fmax) and (x <= fd[ux(d + off)])) {
                xm.* = x;
                ym.* = y;
                return;
            }
            d -= 2;
        }
        if c >= cx.too_expensive {
            // settle for the diagonal that got furthest, in either direction
            let mut fxy: i64 = -1;
            let mut fx: i64 = 0;
            d = fmax;
            while d >= fmin {
                let x = @min(fd[ux(d + off)], r.xlim);
                let y = x - d;
                if (y <= r.ylim) and ((x + y) > fxy) {
                    fxy = x + y;
                    fx = x;
                }
                d -= 2;
            }
            let mut bxy = big;
            let mut bx: i64 = 0;
            d = bmax;
            while d >= bmin {
                let x = @max(r.xoff, bd[ux(d + off)]);
                let y = x - d;
                if (y >= r.yoff) and ((x + y) < bxy) {
                    bxy = x + y;
                    bx = x;
                }
                d -= 2;
            }
            if ((r.xlim + r.ylim) - bxy) < (fxy - (r.xoff + r.yoff)) {
                xm.* = fx;
                ym.* = fxy - fx;
            } else {
                xm.* = bx;
                ym.* = bxy - bx;
            }
            return;
        }
        c += 1;
    }
}

// -----------------------------------------------------------------------------
// Unified diffs
// -----------------------------------------------------------------------------

/// Writes the differences of a and b as a unified diff with `context`
/// lines of context, headed by "--- name_a" and "+++ name_b" (nothing at
/// all if they are the same), as `diff -u` does.
pub fn unified(a: []u8, b: []u8, name_a: []u8, name_b: []u8, context: usize, w: io.Writer) !void {
    let mut la = split_lines(a)!;
    defer la.deinit();
    let mut lb = split_lines(b)!;
    defer lb.deinit();
    let edits = lines(a, b)!;
    defer mem.free(edits);
    let al = la.items();
    let bl = lb.items();
    let mut k: usize = 0;
    let mut header = false;
    while k < edits.len {
        if edits[k].op == Op.EQUAL {
            k += 1;
            continue;
        }
        // a hunk: changes separated by at most 2 context lines of equality
        let mut end = k + 1;
        while end < edits.len {
            if edits[end].op != Op.EQUAL {
                end += 1;
                continue;
            }
            let gap = edits[end].a_end - edits[end].a_start;
            if ((end + 1) < edits.len) and (gap <= (2 * context)) {
                end += 1;
                continue;
            }
            break;
        }
        // (edits[k..end] are the changes and the short equal runs between)
        let a0 = edits[k].a_start - @min(context, edits[k].a_start);
        let b0 = edits[k].b_start - @min(context, edits[k].b_start);
        let a1 = @min(edits[end - 1].a_end + context, al.len);
        let b1 = @min(edits[end - 1].b_end + context, bl.len);
        if not header {
            w.write_all("--- ")!;
            w.write_all(name_a)!;
            w.write_all("\n+++ ")!;
            w.write_all(name_b)!;
            w.write_all("\n")!;
            header = true;
        }
        w.write_all("@@ -")!;
        range(w, a0, a1 - a0)!;
        w.write_all(" +")!;
        range(w, b0, b1 - b0)!;
        w.write_all(" @@\n")!;
        for i in a0..edits[k].a_start {
            put_line(w, " ", al[i])!;
        }
        for e in edits[k..end] {
            if e.op == Op.EQUAL {
                for i in e.a_start..e.a_end {
                    put_line(w, " ", al[i])!;
                }
                continue;
            }
            for i in e.a_start..e.a_end {
                put_line(w, "-", al[i])!;
            }
            for j in e.b_start..e.b_end {
                put_line(w, "+", bl[j])!;
            }
        }
        for i in edits[end - 1].a_end..a1 {
            put_line(w, " ", al[i])!;
        }
        k = end;
    }
}

// "start,count", 1-based; a count of 1 is left out, and an empty range
// names the line before it
fn range(w: io.Writer, start: usize, count: usize) !void {
    let mut buf: [24]u8 = [0; 24];
    if count == 0 {
        w.write_all(fmt.format_int(buf[..], start))!;
        w.write_all(",0")!;
        return;
    }
    w.write_all(fmt.format_int(buf[..], start + 1))!;
    if count != 1 {
        w.write_all(",")!;
        w.write_all(fmt.format_int(buf[..], count))!;
    }
}

fn put_line(w: io.Writer, tag: []u8, line: []u8) !void {
    w.write_all(tag)!;
    w.write_all(line)!;
    if (line.len == 0) or (line[line.len - 1] != '\n') {
        w.write_all("\n\\ No newline at end of file\n")!;
    }
}

/// Applies a unified diff (as unified writes, or diff -u) to a, returning
/// the patched text; the caller frees it. The context and removed lines
/// must match a exactly at the places the hunks give (Conflict
/// otherwise): there is no fuzz and no search for moved hunks. Header
/// lines ("---", "+++", "diff ...", "index ...") are skipped; a patch with
/// several files is not supported.
pub fn apply(a: []u8, patch: []u8) DiffError![]mut u8 {
    let mut la = split_lines(a)!;
    defer la.deinit();
    let al = la.items();
    let mut pl = split_lines(patch)!;
    defer pl.deinit();
    let ps = pl.items();
    let mut out = strs.String.init();
    let mut ai: usize = 0;  // lines of a copied or consumed so far
    let mut k: usize = 0;
    while k < ps.len {
        let line = ps[k];
        if not strs.starts_with(line, "@@ -") {
            k += 1;
            continue;
        }
        let mut h = Hunk.{ a_start: 0, a_count: 0, b_start: 0, b_count: 0 };
        parse_hunk_header(line, &mut h) catch |e| {
            out.deinit();
            return e;
        };
        // the hunk's first line of a (0-based)
        let mut first = h.a_start;
        if h.a_count > 0 {
            if first == 0 {
                out.deinit();
                return error.InvalidPatch;  // (lines start at 1)
            }
            first -= 1;
        }
        if (first < ai) or (first > al.len) {
            out.deinit();
            return error.Conflict;
        }
        for i in ai..first {
            out.push_str(al[i]) catch |e| {
                out.deinit();
                return e;
            };
        }
        ai = first;
        k += 1;
        let mut seen_a: usize = 0;
        let mut seen_b: usize = 0;
        while (k < ps.len) and ((seen_a < h.a_count) or (seen_b < h.b_count)) {
            let l = ps[k];
            if l.len == 0 {
                out.deinit();
                return error.InvalidPatch;
            }
            let tag = l[0];
            let mut body = l[1..];
            // "\ No newline at end of file" after this line removes its "\n"
            let no_nl = ((k + 1) < ps.len) and strs.starts_with(ps[k + 1], "\\");
            if no_nl {
                body = strs.strip_suffix(body, "\n") catch body;
            }
            if (tag == ' ') or (tag == '-') {
                if (ai >= al.len) or not strs.eq(al[ai], body) {
                    out.deinit();
                    return error.Conflict;
                }
                ai += 1;
                seen_a += 1;
            }
            if (tag == ' ') or (tag == '+') {
                out.push_str(body) catch |e| {
                    out.deinit();
                    return e;
                };
                seen_b += 1;
            }
            if ((tag != ' ') and (tag != '-')) and (tag != '+') {
                out.deinit();
                return error.InvalidPatch;
            }
            k += 1;
            if no_nl {
                k += 1;
            }
        }
        if (seen_a != h.a_count) or (seen_b != h.b_count) {
            out.deinit();
            return error.InvalidPatch;
        }
    }
    for i in ai..al.len {
        out.push_str(al[i]) catch |e| {
            out.deinit();
            return e;
        };
    }
    return out.take();
}

struct Hunk {
    a_start: usize,
    a_count: usize,
    b_start: usize,
    b_count: usize,
}

// "@@ -l[,s] +l[,s] @@..."
fn parse_hunk_header(line: []u8, h: *mut Hunk) DiffError!void {
    let mut i: usize = 4;
    parse_range(line, &mut i, &mut h.a_start, &mut h.a_count)!;
    if ((i + 1) >= line.len) or (line[i] != ' ') or (line[i + 1] != '+') {
        return error.InvalidPatch;
    }
    i += 2;
    parse_range(line, &mut i, &mut h.b_start, &mut h.b_count)!;
    if not strs.starts_with(line[i..], " @@") {
        return error.InvalidPatch;
    }
}

fn parse_range(s: []u8, i: *mut usize, start: *mut usize, count: *mut usize) DiffError!void {
    start.* = parse_num(s, i)!;
    count.* = 1;
    if (i.* < s.len) and (s[i.*] == ',') {
        i.* += 1;
        count.* = parse_num(s, i)!;
    }
}

fn parse_num(s: []u8, i: *mut usize) DiffError!usize {
    let j0 = i.*;
    let mut v: usize = 0;
    while (i.* < s.len) and strs.is_digit(s[i.*]) {
        if v > 100000000 {
            return error.InvalidPatch;
        }
        v = (v * 10) + @as(usize, s[i.*] - '0');
        i.* += 1;
    }
    if i.* == j0 {
        return error.InvalidPatch;
    }
    return v;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn udiff(a: []u8, b: []u8, ctx: usize) ![]mut u8 {
    let mut s = strs.String.init();
    unified(a, b, "a", "b", ctx, s.writer()) catch |e| {
        s.deinit();
        return e;
    };
    return s.take();
}

test "unified diffs" {
    // outputs of GNU diff -u (with the header's file names and dates cut)
    let a = "one\ntwo\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\n";
    let b = "one\n2\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\neleven\n";
    let d = udiff(a, b, 3)!;
    defer mem.free(d);
    @expect_eq(d,
               "--- a\n+++ b\n@@ -1,5 +1,5 @@\n one\n-two\n+2\n three\n four\n five\n@@ -8,3 +8,4 @@\n eight\n nine\n ten\n+eleven\n");
    let d1 = udiff(a, b, 6)!;
    defer mem.free(d1);
    @expect(strs.starts_with(d1, "--- a\n+++ b\n@@ -1,10 +1,11 @@\n"));
    let d0 = udiff("x\ny\nz\n", "x\nz\n", 0)!;
    defer mem.free(d0);
    @expect_eq(d0, "--- a\n+++ b\n@@ -2 +1,0 @@\n-y\n");
    let dn = udiff("", "new\n", 3)!;
    defer mem.free(dn);
    @expect_eq(dn, "--- a\n+++ b\n@@ -0,0 +1 @@\n+new\n");
    let dnl = udiff("a\nb", "a\nb\n", 3)!;
    defer mem.free(dnl);
    @expect_eq(dnl, "--- a\n+++ b\n@@ -1,2 +1,2 @@\n a\n-b\n\\ No newline at end of file\n+b\n");
    // changes 6 lines apart share a hunk; 7 apart do not (as in GNU diff)
    let g = numbers(0, 0)!;
    defer mem.free(g);
    let h6 = numbers(3, 10)!;
    defer mem.free(h6);
    let u6 = udiff(g, h6, 3)!;
    defer mem.free(u6);
    @expect(strs.starts_with(u6, "--- a\n+++ b\n@@ -1,13 +1,13 @@\n") and (strs.count(u6, "@@ -") == 1));
    let h7 = numbers(3, 11)!;
    defer mem.free(h7);
    let u7 = udiff(g, h7, 3)!;
    defer mem.free(u7);
    @expect(strs.contains(u7, "@@ -1,6 +1,6 @@\n") and strs.contains(u7, "@@ -8,7 +8,7 @@\n"));
    let same = udiff(a, a, 3)!;
    defer mem.free(same);
    @expect(same.len == 0);
}

fn conflicts(r: ![]mut u8) bool {
    let x = r catch |e| return e == error.Conflict;
    mem.free(x);
    return false;
}

fn invalid(r: ![]mut u8) bool {
    let x = r catch |e| return e == error.InvalidPatch;
    mem.free(x);
    return false;
}

// 1..20, one per line, with lines i and j changed
fn numbers(i: usize, j: usize) DiffError![]mut u8 {
    let mut s = strs.String.init();
    let mut buf: [24]u8 = [0; 24];
    for k in @as(usize, 1)..21 {
        if (k == i) or (k == j) {
            s.push_str("X\n")!;
        } else {
            s.push_str(fmt.format_int(buf[..], k))!;
            s.push('\n')!;
        }
    }
    return s.take();
}

// a small generator of related texts
fn text(seed: *mut u32, n: usize, alphabet: u32, out: *mut strs.String) DiffError!void {
    for _k in @as(usize, 0)..n {
        seed.* = (seed.* *% 1103515245) +% 12345;
        let v = (seed.* >> 16) % alphabet;
        out.push(@truncate(u8, 'a' + v))!;
        out.push('\n')!;
    }
}

// the length of the longest common subsequence, by dynamic programming
fn lcs(a: []u32, b: []u32) DiffError!usize {
    let row = mem.alloc.[usize](b.len + 1)!;
    defer mem.free(row);
    @mem_set(row, 0);
    for i in @as(usize, 0)..a.len {
        let mut diag: usize = 0;
        for j in @as(usize, 0)..b.len {
            let up = row[j + 1];
            if a[i] == b[j] {
                row[j + 1] = diag + 1;
            } else {
                row[j + 1] = @max(row[j], up);
            }
            diag = up;
        }
    }
    return row[b.len];
}

test "minimal, and patches apply" {
    let mut seed: u32 = 5;
    for round in @as(usize, 0)..60 {
        let mut a = strs.String.init();
        defer a.deinit();
        let mut b = strs.String.init();
        defer b.deinit();
        let alpha = @as(u32, @truncate(u32, round % 5)) + 2;
        text(&mut seed, round % 37, alpha, &mut a)!;
        text(&mut seed, (round * 7) % 41, alpha, &mut b)!;
        if (round % 3) == 0 {
            b.push_str("tail")!;
        }
        // the edits cover both sides, and equal runs have equal lines
        let mut la = split_lines(a.bytes())!;
        defer la.deinit();
        let mut lb = split_lines(b.bytes())!;
        defer lb.deinit();
        let ta = mem.alloc.[u32](la.len)!;
        defer mem.free(ta);
        let tb = mem.alloc.[u32](lb.len)!;
        defer mem.free(tb);
        intern(la.items(), lb.items(), ta, tb)!;
        let edits = tokens(ta, tb)!;
        defer mem.free(edits);
        let mut ai: usize = 0;
        let mut bi: usize = 0;
        let mut kept: usize = 0;
        for e in edits {
            @expect((e.a_start == ai) and (e.b_start == bi));
            if e.op == Op.EQUAL {
                for k in @as(usize, 0)..(e.a_end - e.a_start) {
                    @expect(ta[e.a_start + k] == tb[e.b_start + k]);
                }
                kept += e.a_end - e.a_start;
            }
            ai = e.a_end;
            bi = e.b_end;
        }
        @expect((ai == ta.len) and (bi == tb.len));
        // minimal: as many lines kept as the longest common subsequence
        @expect(kept == lcs(ta, tb)!);
        for ctx in [@as(usize, 0), 1, 3] {
            let d = udiff(a.bytes(), b.bytes(), ctx)!;
            defer mem.free(d);
            let back = apply(a.bytes(), d)!;
            defer mem.free(back);
            @expect_eq(back, b.bytes());
        }
    }
    // a hunk that does not match
    let p = "@@ -1 +1 @@\n-x\n+y\n";
    @expect(conflicts(apply("z\n", p)));
    // a hunk removing lines from line 0
    @expect(invalid(apply("a\n", "@@ -0,1 +0,1 @@\n-a\n+b\n")));
}

test "large and pathological inputs" {
    // 5000 lines against their reverse: all different but one, which the
    // cost limit keeps fast; the result still transforms a into b
    let mut a = strs.String.init();
    defer a.deinit();
    let mut b = strs.String.init();
    defer b.deinit();
    let n: usize = 5000;
    let mut buf: [24]u8 = [0; 24];
    for k in @as(usize, 0)..n {
        a.push_str(fmt.format_int(buf[..], k))!;
        a.push('\n')!;
        b.push_str(fmt.format_int(buf[..], (n - 1) - k))!;
        b.push('\n')!;
    }
    let d = udiff(a.bytes(), b.bytes(), 3)!;
    defer mem.free(d);
    let back = apply(a.bytes(), d)!;
    defer mem.free(back);
    @expect_eq(back, b.bytes());
}
