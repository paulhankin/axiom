// =============================================================================
// std/text/html.ax - HTML: the WHATWG parsing algorithm, a tree, CSS selectors
// and serialization.
//
//     let mut doc = html.parse(text)!;
//     defer doc.deinit();
//     let links = doc.query_all("article a[href]")!;      // CSS selectors
//     defer mem.free(links);
//     for id in links { let href = doc.attr(id, "href")!; ... }
//     let title = doc.title()!;                           // (the caller frees
//     let text = doc.text_content(doc.body())!;           //  these three)
//     let out = doc.to_html(0)!;                          // serialization
//
//     let mut frag = html.parse_fragment("<td>x", "tr", html.Options.default())!;
//
//     let mut t = html.Tokenizer.init(text)!;             // just the tokens
//     defer t.deinit();
//     loop { let tok = t.next()!; if tok.kind == html.TokenKind.EOF { break; } ... }
//
// parse() implements the HTML Living Standard's parser: the tokenizer with
// every character reference, and tree construction with all its insertion
// modes, the adoption agency algorithm for misnested formatting, foster
// parenting out of tables, templates, the relaxed <select> content model,
// and SVG and MathML (foreign content). Every input yields a document, as
// in browsers; there are no parse errors to fail on. The trees match what
// browsers build: the parser passes all 1,792 tree construction tests of
// html5lib-tests (with scripting both off and on) and all 7,028 of its
// tokenizer tests (std/text/html/testdata, from cmd/axiom/internal/tests/tools/gen_html_tests.py).
// Scripts never run; Options.scripting only changes how <noscript> parses.
// Processing instructions are read as bogus comments, as browsers have
// always done.
//
// Nodes are numbered: node 0 is the document, and each node has parent,
// first/last child and previous/next sibling links (NONE when absent);
// template contents hang off `contents`. Input to parse() is UTF-8
// (invalid bytes become U+FFFD; a byte-order mark is dropped);
// parse_bytes() sniffs UTF-16 byte-order marks and windows-1252.
//
// Untrusted input: nothing recurses, and the work per token is bounded, so
// time grows linearly with the input whatever its shape. That takes two
// departures from the standard, which only very unusual documents notice:
// elements nested more than MAX_DEPTH deep are not opened (later content
// goes to their parent), and at most MAX_ACTIVE_FORMATTING formatting
// elements stay active at once.
// =============================================================================

import "../collections/arena.ax" as arena;
import "../collections/vec.ax" as vec;
import "../fmt.ax" as fmt;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../os/fs.ax" as fs;
import "../str.ax" as strs;
import "internal/html/entities.ax" as ent;
import "internal/html/tags.ax" as tags;

error { OutOfMemory, NotFound, SyntaxError }

pub const NONE: u32 = 0xffffffff;

/// Elements nested deeper than this are not opened: later content goes to
/// their parent.
pub const MAX_DEPTH: usize = 512;

/// Node kinds.
pub enum Kind: u8 {
    DOCUMENT,
    DOCTYPE,
    ELEMENT,
    TEXT,
    COMMENT,
    FRAGMENT,  // template contents; the result of parse_fragment
}

/// Element namespaces.
pub enum Namespace: u8 {
    HTML,
    SVG,
    MATHML,

    /// The namespace's URI (NAMESPACE_URIS).
    pub fn uri(self: Namespace) []u8 {
        return NAMESPACE_URIS[@as(usize, @int_from_enum(self))];
    }
}

/// Attribute namespaces (from SVG and MathML: xlink:href, xml:lang, xmlns).
pub enum AttrNamespace: u8 {
    NONE,
    XLINK,
    XML,
    XMLNS,
}

/// Document modes.
pub enum QuirksMode: u8 {
    NO_QUIRKS,
    QUIRKS,
    LIMITED_QUIRKS,
}

pub let NAMESPACE_URIS: [3][]u8 = ["http://www.w3.org/1999/xhtml", "http://www.w3.org/2000/svg",
                                   "http://www.w3.org/1998/Math/MathML"];

fn is_ws(c: u8) bool {
    return (c == ' ') or (c == '\t') or (c == '\n') or (c == 12) or (c == '\r');
}

fn is_alpha(c: i32) bool {
    return ((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z'));
}

fn is_alnum(c: i32) bool {
    return is_alpha(c) or ((c >= '0') and (c <= '9'));
}

fn lower(c: i32) u8 {
    if (c >= 'A') and (c <= 'Z') {
        return @truncate(u8, c + 32);
    }
    return @truncate(u8, c);
}

// -----------------------------------------------------------------------------
// Input
// -----------------------------------------------------------------------------

/// The input stream: s with CR and CRLF made LF and invalid UTF-8 replaced
/// by U+FFFD. Returns s itself when it needs no change, else a copy (also
/// stored in owned) that the caller frees.
fn preprocess(s: []u8, owned: *mut []mut u8) ![]u8 {
    let mut clean = true;
    let mut i: usize = 0;
    while i < s.len {
        let c = s[i];
        if c == '\r' {
            clean = false;
            break;
        }
        if c < 0x80 {
            i += 1;
            continue;
        }
        let r = strs.decode_rune(s[i..]);
        if (r.value == strs.REPLACEMENT) and (r.len == 1) {
            clean = false;
            break;
        }
        i += r.len;
    }
    if clean {
        return s;
    }
    let mut out = strs.String.init();
    normalize(s, i, &mut out) catch |e| {
        out.deinit();
        return e;
    };
    let b = out.take()!;
    owned.* = b;
    return b;
}

fn normalize(s: []u8, i0: usize, out: *mut strs.String) !void {
    let mut i = i0;
    out.reserve(s.len + 16)!;
    out.push_str(s[..i])!;
    while i < s.len {
        let c = s[i];
        if c == '\r' {
            out.push('\n')!;
            i += 1;
            if (i < s.len) and (s[i] == '\n') {
                i += 1;
            }
            continue;
        }
        if c < 0x80 {
            out.push(c)!;
            i += 1;
            continue;
        }
        let r = strs.decode_rune(s[i..]);
        if (r.value == strs.REPLACEMENT) and (r.len == 1) {
            out.push_str("\xef\xbf\xbd")!;
        } else {
            out.push_str(s[i..i + r.len])!;
        }
        i += r.len;
    }
}

// -----------------------------------------------------------------------------
// Tokenizer
// -----------------------------------------------------------------------------

/// Token kinds.
pub enum TokenKind: u8 {
    NONE,
    DOCTYPE,
    START,
    END,
    COMMENT,
    CHARS,
    EOF,
}

/// Tokenizer states. A tree builder or a caller sets one of the first six
/// (DATA to CDATA); the others are the tokenizer's own.
pub enum State: u8 {
    DATA,
    RCDATA,
    RAWTEXT,
    SCRIPT,
    PLAINTEXT,
    CDATA,
    TAG_OPEN,
    END_TAG_OPEN,
    TAG_NAME,
    RCDATA_LT,
    RCDATA_END_OPEN,
    RCDATA_END_NAME,
    RAWTEXT_LT,
    RAWTEXT_END_OPEN,
    RAWTEXT_END_NAME,
    SCRIPT_LT,
    SCRIPT_END_OPEN,
    SCRIPT_END_NAME,
    SCRIPT_ESC_START,
    SCRIPT_ESC_START_DASH,
    SCRIPT_ESC,
    SCRIPT_ESC_DASH,
    SCRIPT_ESC_DASH_DASH,
    SCRIPT_ESC_LT,
    SCRIPT_ESC_END_OPEN,
    SCRIPT_ESC_END_NAME,
    SCRIPT_DESC_START,
    SCRIPT_DESC,
    SCRIPT_DESC_DASH,
    SCRIPT_DESC_DASH_DASH,
    SCRIPT_DESC_LT,
    SCRIPT_DESC_END,
    BEFORE_ATTR_NAME,
    ATTR_NAME,
    AFTER_ATTR_NAME,
    BEFORE_ATTR_VALUE,
    ATTR_VALUE_DQ,
    ATTR_VALUE_SQ,
    ATTR_VALUE_UNQ,
    AFTER_ATTR_VALUE,
    SELF_CLOSING,
    BOGUS_COMMENT,
    MARKUP_DECL,
    COMMENT_START,
    COMMENT_START_DASH,
    COMMENT,
    COMMENT_LT,
    COMMENT_LT_BANG,
    COMMENT_LT_BANG_DASH,
    COMMENT_LT_BANG_DASH_DASH,
    COMMENT_END_DASH,
    COMMENT_END,
    COMMENT_END_BANG,
    DOCTYPE,
    BEFORE_DOCTYPE_NAME,
    DOCTYPE_NAME,
    AFTER_DOCTYPE_NAME,
    AFTER_DOCTYPE_PUBLIC_KW,
    BEFORE_DOCTYPE_PUBLIC_ID,
    DOCTYPE_PUBLIC_ID_DQ,
    DOCTYPE_PUBLIC_ID_SQ,
    AFTER_DOCTYPE_PUBLIC_ID,
    BETWEEN_DOCTYPE_IDS,
    AFTER_DOCTYPE_SYSTEM_KW,
    BEFORE_DOCTYPE_SYSTEM_ID,
    DOCTYPE_SYSTEM_ID_DQ,
    DOCTYPE_SYSTEM_ID_SQ,
    AFTER_DOCTYPE_SYSTEM_ID,
    BOGUS_DOCTYPE,
    CDATA_BRACKET,
    CDATA_END,
}

pub struct Attr {
    ns: AttrNamespace,  // NONE, or XLINK, XML or XMLNS on foreign elements
    prefix: []u8,       // "xlink" etc. with a namespace, else ""
    name: []u8,         // the local name
    value: []u8,
}

struct Span {
    ns: usize,  // name and value, as offsets into the attribute buffer (the
    ne: usize,  // value runs to the next attribute's name)
    vs: usize,
    dup: bool,  // repeats an earlier name: dropped
}

/// A token: valid until the next call of Tokenizer.next.
pub struct Token {
    kind: TokenKind,
    name: []u8,  // tag name (lowercase) or DOCTYPE name
    tag: u16,    // the tag name's T_ constant, or 0
    attrs: []Attr,
    self_closing: bool,
    data: []u8,  // TokenKind.CHARS and TokenKind.COMMENT
    public_id: []u8,
    system_id: []u8,
    has_name: bool,  // DOCTYPE: whether each part was present
    has_public: bool,
    has_system: bool,
    force_quirks: bool,
}

/// The HTML tokenizer. Characters come as runs (TokenKind.CHARS); a caller building
/// a tree changes `state` after start tags as the tree builder does.
pub struct Tokenizer {
    s: []u8,
    owned: []mut u8,  // s, when preprocessing had to copy it
    i: usize,
    state: State,
    last_start: strs.String,  // the last start tag's name (for appropriate end tags)
    cdata_ok: bool,           // <![CDATA[ opens a section (set in foreign content)
    kind: TokenKind,          // the tag being built: START or END
    self_closing: bool,
    name: strs.String,
    tmp: strs.String,
    comment: strs.String,
    chars: strs.String,
    abuf: strs.String,  // the tag's attribute names and values
    spans: vec.Vec.[Span],
    seen: vec.Vec.[u32],  // a hash index of spans (for tags with many attributes)
    attrs: vec.Vec.[Attr],
    public_id: strs.String,
    system_id: strs.String,
    has_name: bool,
    has_public: bool,
    has_system: bool,
    force_quirks: bool,
    pending: TokenKind,  // a finished token waiting behind characters
    done: bool,
    errors: u32,  // parse errors seen (they are not fatal)

    /// A tokenizer over text (which must outlive it).
    pub fn init(text: []u8) !Tokenizer {
        let mut owned: []mut u8 = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
        let s = preprocess(text, &mut owned)!;
        return Tokenizer.{ s: s, owned: owned, i: 0, state: State.DATA, last_start: strs.String.init(), cdata_ok: false,
                           kind: TokenKind.START, self_closing: false, name: strs.String.init(),
                           tmp: strs.String.init(), comment: strs.String.init(), chars: strs.String.init(),
                           abuf: strs.String.init(), spans: vec.Vec.[Span].init(), seen: vec.Vec.[u32].init(),
                           attrs: vec.Vec.[Attr].init(), public_id: strs.String.init(), system_id: strs.String.init(),
                           has_name: false, has_public: false, has_system: false, force_quirks: false,
                           pending: TokenKind.NONE, done: false, errors: 0 };
    }

    pub fn deinit(self: *mut Tokenizer) void {
        if self.owned.len > 0 {
            mem.free(self.owned);
        }
        self.last_start.deinit();
        self.name.deinit();
        self.tmp.deinit();
        self.comment.deinit();
        self.chars.deinit();
        self.abuf.deinit();
        self.spans.deinit();
        self.seen.deinit();
        self.attrs.deinit();
        self.public_id.deinit();
        self.system_id.deinit();
    }

    /// Sets the name of the last start tag (as a tree builder's context
    /// element would), which decides which end tags close RCDATA and the like.
    pub fn set_last_start_tag(self: *mut Tokenizer, name: []u8) !void {
        self.last_start.clear();
        self.last_start.push_str(name)!;
    }

    /// The next token. After TokenKind.EOF, TokenKind.EOF again.
    pub fn next(self: *mut Tokenizer) !Token {
        if self.pending != TokenKind.NONE {
            let k = self.pending;
            self.pending = TokenKind.NONE;
            return self.make(k);
        }
        self.chars.clear();
        if self.done {
            return self.make(TokenKind.EOF);
        }
        let k = self.run()!;
        if k == TokenKind.EOF {
            self.done = true;
        } else if self.i >= self.s.len {
            self.state = State.DATA;  // (a comment or DOCTYPE cut off by the end: EOF next)
        }
        if self.chars.len > 0 {
            self.pending = k;
            return self.make(TokenKind.CHARS);
        }
        return self.make(k);
    }

    fn make(self: *mut Tokenizer, k: TokenKind) !Token {
        let mut t = Token.{ kind: k, name: "", tag: 0, attrs: self.attrs.items()[..0], self_closing: false, data: "",
                            public_id: "", system_id: "", has_name: false, has_public: false, has_system: false,
                            force_quirks: false };
        if k == TokenKind.CHARS {
            t.data = self.chars.bytes();
        } else if k == TokenKind.COMMENT {
            t.data = self.comment.bytes();
        } else if (k == TokenKind.START) or (k == TokenKind.END) {
            t.name = self.name.bytes();
            t.tag = tags.tag_of(t.name);
            t.self_closing = self.self_closing;
            self.attrs.clear();
            let b = self.abuf.bytes();
            let sp = self.spans.items();
            for k2 in @as(usize, 0)..sp.len {
                let mut ve = b.len;
                if (k2 + 1) < sp.len {
                    ve = sp[k2 + 1].ns;
                }
                if sp[k2].dup {
                    continue;
                }
                self.attrs.push(Attr.{ ns: AttrNamespace.NONE, prefix: "", name: b[sp[k2].ns..sp[k2].ne],
                                       value: b[sp[k2].vs..ve] })!;
            }
            t.attrs = self.attrs.items();
            if k == TokenKind.START {
                self.last_start.clear();
                self.last_start.push_str(t.name)!;
            }
        } else if k == TokenKind.DOCTYPE {
            t.name = self.name.bytes();
            t.public_id = self.public_id.bytes();
            t.system_id = self.system_id.bytes();
            t.has_name = self.has_name;
            t.has_public = self.has_public;
            t.has_system = self.has_system;
            t.force_quirks = self.force_quirks;
        }
        return t;
    }

    fn at(self: *Tokenizer) i32 {
        if self.i < self.s.len {
            return @as(i32, self.s[self.i]);
        }
        return -1;
    }

    fn err(self: *mut Tokenizer) void {
        self.errors +%= 1;
    }

    fn new_tag(self: *mut Tokenizer, k: TokenKind) void {
        self.kind = k;
        self.self_closing = false;
        self.name.clear();
        self.abuf.clear();
        self.spans.clear();
    }

    fn new_doctype(self: *mut Tokenizer) void {
        self.name.clear();
        self.public_id.clear();
        self.system_id.clear();
        self.has_name = false;
        self.has_public = false;
        self.has_system = false;
        self.force_quirks = false;
    }

    // Starts an attribute; its name follows in abuf.
    fn new_attr(self: *mut Tokenizer) !void {
        self.spans.push(Span.{ ns: self.abuf.len, ne: self.abuf.len, vs: self.abuf.len, dup: false })!;
    }

    // The attribute name is complete: mark it if it repeats one.
    fn end_attr_name(self: *mut Tokenizer) !void {
        let n = self.spans.len;
        let b = self.abuf.bytes();
        let sp = self.spans.get_ptr(n - 1);
        sp.ne = b.len;
        sp.vs = b.len;
        let nm = b[sp.ns..sp.ne];
        if n <= 16 {
            for k in @as(usize, 0)..n - 1 {
                let o = self.spans.get(k);
                if not o.dup and strs.eq(b[o.ns..o.ne], nm) {
                    self.err();
                    sp.dup = true;
                    return;
                }
            }
            return;
        }
        // many attributes: an open-addressed table of span indexes
        if (n == 17) or ((n * 2) > self.seen.len) {
            let mut size: usize = 64;
            while size < (n * 4) {
                size *= 2;
            }
            self.seen.clear();
            for _k in @as(usize, 0)..size {
                self.seen.push(NONE)!;
            }
            for k in @as(usize, 0)..n - 1 {
                let o = self.spans.get(k);
                if not o.dup {
                    _ = self.seen_insert(b, @truncate(u32, k));
                }
            }
        }
        if not self.seen_insert(b, @truncate(u32, n - 1)) {
            self.err();
            sp.dup = true;
        }
    }

    // Adds span k to the index: false if its name is there already.
    fn seen_insert(self: *mut Tokenizer, b: []u8, k: u32) bool {
        let sp = self.spans.get(@as(usize, k));
        let nm = b[sp.ns..sp.ne];
        let mut h: u32 = 2166136261;
        for c in nm {
            h = (h ^ @as(u32, c)) *% 16777619;
        }
        let mask = self.seen.len - 1;
        let mut at = @as(usize, h) & mask;
        loop {
            let e = self.seen.get(at);
            if e == NONE {
                self.seen.set(at, k);
                return true;
            }
            let o = self.spans.get(@as(usize, e));
            if strs.eq(b[o.ns..o.ne], nm) {
                return false;
            }
            at = (at + 1) & mask;
        }
    }

    // Finishes the current tag: the kind to return.
    fn emit_tag(self: *mut Tokenizer) TokenKind {
        if self.kind == TokenKind.END {
            if (self.spans.len > 0) or self.self_closing {
                self.err();
            }
        }
        return self.kind;
    }

    // Whether the end tag being read matches the last start tag.
    fn appropriate(self: *Tokenizer) bool {
        return (self.last_start.len > 0) and strs.eq(self.name.bytes(), self.last_start.bytes());
    }

    // "</" and the temporary buffer, as characters.
    fn flush_end_tag(self: *mut Tokenizer) !void {
        self.chars.push_str("</")!;
        self.chars.push_str(self.tmp.bytes())!;
    }

    fn lookahead_ci(self: *Tokenizer, word: []u8) bool {
        if (self.s.len - self.i) < word.len {
            return false;
        }
        return strs.eq_ignore_case(self.s[self.i..self.i + word.len], word);
    }

    fn lookahead(self: *Tokenizer, word: []u8) bool {
        return strs.starts_with(self.s[self.i..], word);
    }

    // Appends a character reference's text to the attribute value or the
    // characters (after the "&" has been consumed).
    fn char_ref(self: *mut Tokenizer, in_attr: bool) !void {
        let mut out = &mut self.chars;
        if in_attr {
            out = &mut self.abuf;
        }
        let s = self.s;
        let i = self.i;
        if (i < s.len) and is_alnum(@as(i32, s[i])) {
            let mut k: usize = 0;
            while ((i + k) < s.len) and is_alnum(@as(i32, s[i + k])) and (k < 40) {
                k += 1;
            }
            // the longest match: with a semicolon (only possible after all k
            // characters), or a legacy name without one
            let mut len: usize = 0;
            let mut idx: usize = 0;
            let mut semi = false;
            if ((i + k) < s.len) and (s[i + k] == ';') {
                let e = entity_index(s[i..i + k]) catch NONE_USIZE;
                if e != NONE_USIZE {
                    len = k + 1;
                    idx = e;
                    semi = true;
                }
            }
            if len == 0 {
                let mut l = @min(k, 8);  // (legacy names are short)
                while l > 0 {
                    let e = legacy_index(s[i..i + l]) catch NONE_USIZE;
                    if e != NONE_USIZE {
                        len = l;
                        idx = e;
                        break;
                    }
                    l -= 1;
                }
            }
            if len == 0 {
                out.push('&')!;  // (the ambiguous ampersand: what follows is text)
                return;
            }
            if in_attr and not semi and ((i + len) < s.len) and
               ((s[i + len] == '=') or is_alnum(@as(i32, s[i + len]))) {
                out.push('&')!;
                out.push_str(s[i..i + len])!;
                self.i = i + len;
                return;
            }
            if not semi {
                self.err();
            }
            out.push_rune(ent.FIRST[idx])!;
            if ent.SECOND[idx] != 0 {
                out.push_rune(ent.SECOND[idx])!;
            }
            self.i = i + len;
            return;
        }
        if (i < s.len) and (s[i] == '#') {
            let mut j = i + 1;
            let mut hex = false;
            if (j < s.len) and ((s[j] == 'x') or (s[j] == 'X')) {
                hex = true;
                j += 1;
            }
            let st = j;
            let mut v: u32 = 0;
            while j < s.len {
                let c = s[j];
                let mut d: u32 = 16;
                if (c >= '0') and (c <= '9') {
                    d = @as(u32, c - '0');
                } else if hex and (c >= 'a') and (c <= 'f') {
                    d = @as(u32, c - 'a') + 10;
                } else if hex and (c >= 'A') and (c <= 'F') {
                    d = @as(u32, c - 'A') + 10;
                }
                if d == 16 {
                    break;
                }
                if hex {
                    v = (v * 16) + d;
                } else {
                    v = (v * 10) + d;
                }
                if v > 0x10ffff {
                    v = 0x110000;
                }
                j += 1;
            }
            if j == st {
                self.err();
                out.push_str(s[i - 1..j])!;  // "&#" or "&#x", as text
                self.i = j;
                return;
            }
            if (j < s.len) and (s[j] == ';') {
                j += 1;
            } else {
                self.err();
            }
            self.i = j;
            if (v == 0) or (v > 0x10ffff) or ((v >= 0xd800) and (v <= 0xdfff)) {
                self.err();
                v = 0xfffd;
            } else if (v >= 0x80) and (v <= 0x9f) {
                self.err();
                let w = C1[@as(usize, v - 0x80)];
                if w != 0 {
                    v = w;
                }
            } else if ((v < 0x20) and (v != '\t') and (v != '\n') and (v != 12)) or (v == 0x7f) {
                self.err();
            }
            out.push_rune(v)!;
            return;
        }
        out.push('&')!;
    }

    // Runs the state machine until a token other than characters is complete
    // (characters collect in self.chars): returns its kind.
    fn run(self: *mut Tokenizer) !TokenKind {
        let s = self.s;
        let n = s.len;
        loop {
            let st = self.state;
            // --- the text states, a run at a time
            if st == State.DATA {
                let b = self.i;
                let mut i = b;
                while (i < n) and (s[i] != '<') and (s[i] != '&') and (s[i] != 0) {
                    i += 1;
                }
                self.chars.push_str(s[b..i])!;
                self.i = i;
                if i >= n {
                    return TokenKind.EOF;
                }
                self.i = i + 1;
                let c = s[i];
                if c == '&' {
                    self.char_ref(false)!;
                } else if c == '<' {
                    self.state = State.TAG_OPEN;
                } else {
                    self.err();
                    self.chars.push(0)!;  // (the tree builder drops it)
                }
                continue;
            }
            if (st == State.RCDATA) or (st == State.RAWTEXT) or (st == State.SCRIPT) or (st == State.PLAINTEXT) {
                let b = self.i;
                let mut i = b;
                while (i < n) and (s[i] != '<') and (s[i] != 0) and ((s[i] != '&') or (st != State.RCDATA)) {
                    i += 1;
                }
                self.chars.push_str(s[b..i])!;
                self.i = i;
                if i >= n {
                    return TokenKind.EOF;
                }
                self.i = i + 1;
                let c = s[i];
                if c == 0 {
                    self.err();
                    self.chars.push_str("\xef\xbf\xbd")!;
                } else if c == '&' {
                    self.char_ref(false)!;
                } else if st == State.PLAINTEXT {
                    self.chars.push('<')!;
                } else if st == State.RCDATA {
                    self.state = State.RCDATA_LT;
                } else if st == State.RAWTEXT {
                    self.state = State.RAWTEXT_LT;
                } else {
                    self.state = State.SCRIPT_LT;
                }
                continue;
            }
            let c = self.at();
            if st == State.TAG_NAME {
                if c < 0 {
                    self.err();
                    return TokenKind.EOF;
                }
                self.i += 1;
                let b = @truncate(u8, c);
                if is_ws(b) {
                    self.state = State.BEFORE_ATTR_NAME;
                } else if b == '/' {
                    self.state = State.SELF_CLOSING;
                } else if b == '>' {
                    self.state = State.DATA;
                    return self.emit_tag();
                } else if b == 0 {
                    self.err();
                    self.name.push_str("\xef\xbf\xbd")!;
                } else {
                    self.name.push(lower(c))!;
                }
                continue;
            }
            if st == State.BEFORE_ATTR_NAME {
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
                    self.i += 1;
                } else if (c == '/') or (c == '>') or (c < 0) {
                    self.state = State.AFTER_ATTR_NAME;
                } else if c == '=' {
                    self.err();
                    self.new_attr()!;
                    self.abuf.push('=')!;
                    self.i += 1;
                    self.state = State.ATTR_NAME;
                } else {
                    self.new_attr()!;
                    self.state = State.ATTR_NAME;
                }
                continue;
            }
            if st == State.ATTR_NAME {
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') or (c == '/') or (c == '>') or (c < 0) {
                    self.end_attr_name()!;
                    self.state = State.AFTER_ATTR_NAME;
                } else if c == '=' {
                    self.end_attr_name()!;
                    self.i += 1;
                    self.state = State.BEFORE_ATTR_VALUE;
                } else {
                    self.i += 1;
                    if c == 0 {
                        self.err();
                        self.abuf.push_str("\xef\xbf\xbd")!;
                    } else {
                        if (c == '"') or (c == '\'') or (c == '<') {
                            self.err();
                        }
                        self.abuf.push(lower(c))!;
                    }
                }
                continue;
            }
            if st == State.AFTER_ATTR_NAME {
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
                    self.i += 1;
                } else if c == '/' {
                    self.i += 1;
                    self.state = State.SELF_CLOSING;
                } else if c == '=' {
                    self.i += 1;
                    self.state = State.BEFORE_ATTR_VALUE;
                } else if c == '>' {
                    self.i += 1;
                    self.state = State.DATA;
                    return self.emit_tag();
                } else if c < 0 {
                    self.err();
                    return TokenKind.EOF;
                } else {
                    self.new_attr()!;
                    self.state = State.ATTR_NAME;
                }
                continue;
            }
            if st == State.BEFORE_ATTR_VALUE {
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
                    self.i += 1;
                } else if c == '"' {
                    self.i += 1;
                    self.state = State.ATTR_VALUE_DQ;
                } else if c == '\'' {
                    self.i += 1;
                    self.state = State.ATTR_VALUE_SQ;
                } else if c == '>' {
                    self.err();
                    self.i += 1;
                    self.state = State.DATA;
                    return self.emit_tag();
                } else {
                    self.state = State.ATTR_VALUE_UNQ;
                }
                continue;
            }
            if (st == State.ATTR_VALUE_DQ) or (st == State.ATTR_VALUE_SQ) {
                let mut qq: u8 = '"';
                if st == State.ATTR_VALUE_SQ {
                    qq = '\'';
                }
                let b = self.i;
                let mut i = b;
                while (i < n) and (s[i] != qq) and (s[i] != '&') and (s[i] != 0) {
                    i += 1;
                }
                self.abuf.push_str(s[b..i])!;
                self.i = i;
                if i >= n {
                    self.err();
                    return TokenKind.EOF;
                }
                self.i = i + 1;
                if s[i] == qq {
                    self.state = State.AFTER_ATTR_VALUE;
                } else if s[i] == '&' {
                    self.char_ref(true)!;
                } else {
                    self.err();
                    self.abuf.push_str("\xef\xbf\xbd")!;
                }
                continue;
            }
            if st == State.ATTR_VALUE_UNQ {
                if c < 0 {
                    self.err();
                    return TokenKind.EOF;
                }
                self.i += 1;
                let b = @truncate(u8, c);
                if (b == '\t') or (b == '\n') or (b == 12) or (b == ' ') {
                    self.state = State.BEFORE_ATTR_NAME;
                } else if b == '&' {
                    self.char_ref(true)!;
                } else if b == '>' {
                    self.state = State.DATA;
                    return self.emit_tag();
                } else if b == 0 {
                    self.err();
                    self.abuf.push_str("\xef\xbf\xbd")!;
                } else {
                    if (b == '"') or (b == '\'') or (b == '<') or (b == '=') or (b == '`') {
                        self.err();
                    }
                    self.abuf.push(b)!;
                }
                continue;
            }
            if st == State.AFTER_ATTR_VALUE {
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
                    self.i += 1;
                    self.state = State.BEFORE_ATTR_NAME;
                } else if c == '/' {
                    self.i += 1;
                    self.state = State.SELF_CLOSING;
                } else if c == '>' {
                    self.i += 1;
                    self.state = State.DATA;
                    return self.emit_tag();
                } else if c < 0 {
                    self.err();
                    return TokenKind.EOF;
                } else {
                    self.err();
                    self.state = State.BEFORE_ATTR_NAME;
                }
                continue;
            }
            if st == State.SELF_CLOSING {
                if c == '>' {
                    self.i += 1;
                    self.self_closing = true;
                    self.state = State.DATA;
                    return self.emit_tag();
                } else if c < 0 {
                    self.err();
                    return TokenKind.EOF;
                } else {
                    self.err();
                    self.state = State.BEFORE_ATTR_NAME;
                }
                continue;
            }
            if st == State.TAG_OPEN {
                if c == '!' {
                    self.i += 1;
                    self.state = State.MARKUP_DECL;
                } else if c == '/' {
                    self.i += 1;
                    self.state = State.END_TAG_OPEN;
                } else if is_alpha(c) {
                    self.new_tag(TokenKind.START);
                    self.state = State.TAG_NAME;
                } else if c == '?' {
                    self.err();
                    self.comment.clear();
                    self.state = State.BOGUS_COMMENT;
                } else if c < 0 {
                    self.err();
                    self.chars.push('<')!;
                    return TokenKind.EOF;
                } else {
                    self.err();
                    self.chars.push('<')!;
                    self.state = State.DATA;
                }
                continue;
            }
            if st == State.END_TAG_OPEN {
                if is_alpha(c) {
                    self.new_tag(TokenKind.END);
                    self.state = State.TAG_NAME;
                } else if c == '>' {
                    self.err();
                    self.i += 1;
                    self.state = State.DATA;
                } else if c < 0 {
                    self.err();
                    self.chars.push_str("</")!;
                    return TokenKind.EOF;
                } else {
                    self.err();
                    self.comment.clear();
                    self.state = State.BOGUS_COMMENT;
                }
                continue;
            }
            // --- RCDATA, RAWTEXT and script data end tags
            if (st == State.RCDATA_LT) or (st == State.RAWTEXT_LT) {
                let mut back = State.RCDATA;
                if st == State.RAWTEXT_LT {
                    back = State.RAWTEXT;
                }
                if c == '/' {
                    self.i += 1;
                    self.tmp.clear();
                    if st == State.RCDATA_LT {
                        self.state = State.RCDATA_END_OPEN;
                    } else {
                        self.state = State.RAWTEXT_END_OPEN;
                    }
                } else {
                    self.chars.push('<')!;
                    self.state = back;
                }
                continue;
            }
            if (st == State.RCDATA_END_OPEN) or (st == State.RAWTEXT_END_OPEN) or (st == State.SCRIPT_END_OPEN) or
               (st == State.SCRIPT_ESC_END_OPEN) {
                if is_alpha(c) {
                    self.new_tag(TokenKind.END);
                    self.state = end_name_state(st);
                } else {
                    self.chars.push_str("</")!;
                    self.state = end_tag_back(st);
                }
                continue;
            }
            if (st == State.RCDATA_END_NAME) or (st == State.RAWTEXT_END_NAME) or (st == State.SCRIPT_END_NAME) or
               (st == State.SCRIPT_ESC_END_NAME) {
                if ((c == '\t') or (c == '\n') or (c == 12) or (c == ' ')) and self.appropriate() {
                    self.i += 1;
                    self.state = State.BEFORE_ATTR_NAME;
                } else if (c == '/') and self.appropriate() {
                    self.i += 1;
                    self.state = State.SELF_CLOSING;
                } else if (c == '>') and self.appropriate() {
                    self.i += 1;
                    self.state = State.DATA;
                    return self.emit_tag();
                } else if is_alpha(c) {
                    self.i += 1;
                    self.name.push(lower(c))!;
                    self.tmp.push(@truncate(u8, c))!;
                } else {
                    self.flush_end_tag()!;
                    self.state = end_tag_back(st);
                }
                continue;
            }
            if st == State.SCRIPT_LT {
                if c == '/' {
                    self.i += 1;
                    self.tmp.clear();
                    self.state = State.SCRIPT_END_OPEN;
                } else if c == '!' {
                    self.i += 1;
                    self.chars.push_str("<!")!;
                    self.state = State.SCRIPT_ESC_START;
                } else {
                    self.chars.push('<')!;
                    self.state = State.SCRIPT;
                }
                continue;
            }
            if (st == State.SCRIPT_ESC_START) or (st == State.SCRIPT_ESC_START_DASH) {
                if c == '-' {
                    self.i += 1;
                    self.chars.push('-')!;
                    if st == State.SCRIPT_ESC_START {
                        self.state = State.SCRIPT_ESC_START_DASH;
                    } else {
                        self.state = State.SCRIPT_ESC_DASH_DASH;
                    }
                } else {
                    self.state = State.SCRIPT;
                }
                continue;
            }
            if (st == State.SCRIPT_ESC) or (st == State.SCRIPT_ESC_DASH) or (st == State.SCRIPT_ESC_DASH_DASH) {
                if c < 0 {
                    self.err();
                    return TokenKind.EOF;
                }
                self.i += 1;
                if c == '-' {
                    self.chars.push('-')!;
                    if st == State.SCRIPT_ESC {
                        self.state = State.SCRIPT_ESC_DASH;
                    } else {
                        self.state = State.SCRIPT_ESC_DASH_DASH;
                    }
                } else if c == '<' {
                    self.state = State.SCRIPT_ESC_LT;
                } else if (c == '>') and (st == State.SCRIPT_ESC_DASH_DASH) {
                    self.chars.push('>')!;
                    self.state = State.SCRIPT;
                } else if c == 0 {
                    self.err();
                    self.chars.push_str("\xef\xbf\xbd")!;
                    self.state = State.SCRIPT_ESC;
                } else {
                    self.chars.push(@truncate(u8, c))!;
                    self.state = State.SCRIPT_ESC;
                }
                continue;
            }
            if st == State.SCRIPT_ESC_LT {
                if c == '/' {
                    self.i += 1;
                    self.tmp.clear();
                    self.state = State.SCRIPT_ESC_END_OPEN;
                } else if is_alpha(c) {
                    self.tmp.clear();
                    self.chars.push('<')!;
                    self.state = State.SCRIPT_DESC_START;
                } else {
                    self.chars.push('<')!;
                    self.state = State.SCRIPT_ESC;
                }
                continue;
            }
            if (st == State.SCRIPT_DESC_START) or (st == State.SCRIPT_DESC_END) {
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') or (c == '/') or (c == '>') {
                    self.i += 1;
                    self.chars.push(@truncate(u8, c))!;
                    let is_script = strs.eq(self.tmp.bytes(), "script");
                    if st == State.SCRIPT_DESC_START {
                        if is_script {
                            self.state = State.SCRIPT_DESC;
                        } else {
                            self.state = State.SCRIPT_ESC;
                        }
                    } else {
                        if is_script {
                            self.state = State.SCRIPT_ESC;
                        } else {
                            self.state = State.SCRIPT_DESC;
                        }
                    }
                } else if is_alpha(c) {
                    self.i += 1;
                    self.tmp.push(lower(c))!;
                    self.chars.push(@truncate(u8, c))!;
                } else {
                    if st == State.SCRIPT_DESC_START {
                        self.state = State.SCRIPT_ESC;
                    } else {
                        self.state = State.SCRIPT_DESC;
                    }
                }
                continue;
            }
            if (st == State.SCRIPT_DESC) or (st == State.SCRIPT_DESC_DASH) or (st == State.SCRIPT_DESC_DASH_DASH) {
                if c < 0 {
                    self.err();
                    return TokenKind.EOF;
                }
                self.i += 1;
                if c == '-' {
                    self.chars.push('-')!;
                    if st == State.SCRIPT_DESC {
                        self.state = State.SCRIPT_DESC_DASH;
                    } else {
                        self.state = State.SCRIPT_DESC_DASH_DASH;
                    }
                } else if c == '<' {
                    self.chars.push('<')!;
                    self.state = State.SCRIPT_DESC_LT;
                } else if (c == '>') and (st == State.SCRIPT_DESC_DASH_DASH) {
                    self.chars.push('>')!;
                    self.state = State.SCRIPT;
                } else if c == 0 {
                    self.err();
                    self.chars.push_str("\xef\xbf\xbd")!;
                    self.state = State.SCRIPT_DESC;
                } else {
                    self.chars.push(@truncate(u8, c))!;
                    self.state = State.SCRIPT_DESC;
                }
                continue;
            }
            if st == State.SCRIPT_DESC_LT {
                if c == '/' {
                    self.i += 1;
                    self.tmp.clear();
                    self.chars.push('/')!;
                    self.state = State.SCRIPT_DESC_END;
                } else {
                    self.state = State.SCRIPT_DESC;
                }
                continue;
            }
            // --- comments
            if st == State.MARKUP_DECL {
                if self.lookahead("--") {
                    self.i += 2;
                    self.comment.clear();
                    self.state = State.COMMENT_START;
                } else if self.lookahead_ci("doctype") {
                    self.i += 7;
                    self.state = State.DOCTYPE;
                } else if self.lookahead("[CDATA[") {
                    self.i += 7;
                    if self.cdata_ok {
                        self.state = State.CDATA;
                    } else {
                        self.err();
                        self.comment.clear();
                        self.comment.push_str("[CDATA[")!;
                        self.state = State.BOGUS_COMMENT;
                    }
                } else {
                    self.err();
                    self.comment.clear();
                    self.state = State.BOGUS_COMMENT;
                }
                continue;
            }
            if st == State.BOGUS_COMMENT {
                let b = self.i;
                let mut i = b;
                while (i < n) and (s[i] != '>') and (s[i] != 0) {
                    i += 1;
                }
                self.comment.push_str(s[b..i])!;
                self.i = i;
                if i >= n {
                    return TokenKind.COMMENT;  // (then EOF)
                }
                self.i = i + 1;
                if s[i] == '>' {
                    self.state = State.DATA;
                    return TokenKind.COMMENT;
                }
                self.err();
                self.comment.push_str("\xef\xbf\xbd")!;
                continue;
            }
            if (st == State.COMMENT_START) or (st == State.COMMENT_START_DASH) {
                if c == '-' {
                    self.i += 1;
                    if st == State.COMMENT_START {
                        self.state = State.COMMENT_START_DASH;
                    } else {
                        self.state = State.COMMENT_END;
                    }
                } else if c == '>' {
                    self.err();
                    self.i += 1;
                    self.state = State.DATA;
                    return TokenKind.COMMENT;
                } else if (c < 0) and (st == State.COMMENT_START_DASH) {
                    self.err();
                    return TokenKind.COMMENT;
                } else {
                    if st == State.COMMENT_START_DASH {
                        self.comment.push('-')!;
                    }
                    self.state = State.COMMENT;
                }
                continue;
            }
            if st == State.COMMENT {
                let b = self.i;
                let mut i = b;
                while (i < n) and (s[i] != '<') and (s[i] != '-') and (s[i] != 0) {
                    i += 1;
                }
                self.comment.push_str(s[b..i])!;
                self.i = i;
                if i >= n {
                    self.err();
                    return TokenKind.COMMENT;
                }
                self.i = i + 1;
                if s[i] == '<' {
                    self.comment.push('<')!;
                    self.state = State.COMMENT_LT;
                } else if s[i] == '-' {
                    self.state = State.COMMENT_END_DASH;
                } else {
                    self.err();
                    self.comment.push_str("\xef\xbf\xbd")!;
                }
                continue;
            }
            if st == State.COMMENT_LT {
                if c == '!' {
                    self.i += 1;
                    self.comment.push('!')!;
                    self.state = State.COMMENT_LT_BANG;
                } else if c == '<' {
                    self.i += 1;
                    self.comment.push('<')!;
                } else {
                    self.state = State.COMMENT;
                }
                continue;
            }
            if st == State.COMMENT_LT_BANG {
                if c == '-' {
                    self.i += 1;
                    self.state = State.COMMENT_LT_BANG_DASH;
                } else {
                    self.state = State.COMMENT;
                }
                continue;
            }
            if st == State.COMMENT_LT_BANG_DASH {
                if c == '-' {
                    self.i += 1;
                    self.state = State.COMMENT_LT_BANG_DASH_DASH;
                } else {
                    self.state = State.COMMENT_END_DASH;
                }
                continue;
            }
            if st == State.COMMENT_LT_BANG_DASH_DASH {
                if (c != '>') and (c >= 0) {
                    self.err();
                }
                self.state = State.COMMENT_END;
                continue;
            }
            if st == State.COMMENT_END_DASH {
                if c == '-' {
                    self.i += 1;
                    self.state = State.COMMENT_END;
                } else if c < 0 {
                    self.err();
                    return TokenKind.COMMENT;
                } else {
                    self.comment.push('-')!;
                    self.state = State.COMMENT;
                }
                continue;
            }
            if st == State.COMMENT_END {
                if c == '>' {
                    self.i += 1;
                    self.state = State.DATA;
                    return TokenKind.COMMENT;
                } else if c == '!' {
                    self.i += 1;
                    self.state = State.COMMENT_END_BANG;
                } else if c == '-' {
                    self.i += 1;
                    self.comment.push('-')!;
                } else if c < 0 {
                    self.err();
                    return TokenKind.COMMENT;
                } else {
                    self.comment.push_str("--")!;
                    self.state = State.COMMENT;
                }
                continue;
            }
            if st == State.COMMENT_END_BANG {
                if c == '-' {
                    self.i += 1;
                    self.comment.push_str("--!")!;
                    self.state = State.COMMENT_END_DASH;
                } else if c == '>' {
                    self.err();
                    self.i += 1;
                    self.state = State.DATA;
                    return TokenKind.COMMENT;
                } else if c < 0 {
                    self.err();
                    return TokenKind.COMMENT;
                } else {
                    self.comment.push_str("--!")!;
                    self.state = State.COMMENT;
                }
                continue;
            }
            // --- CDATA sections (in foreign content)
            if st == State.CDATA {
                let b = self.i;
                let mut i = b;
                while (i < n) and (s[i] != ']') {
                    i += 1;
                }
                self.chars.push_str(s[b..i])!;
                self.i = i;
                if i >= n {
                    self.err();
                    return TokenKind.EOF;
                }
                self.i = i + 1;
                self.state = State.CDATA_BRACKET;
                continue;
            }
            if st == State.CDATA_BRACKET {
                if c == ']' {
                    self.i += 1;
                    self.state = State.CDATA_END;
                } else {
                    self.chars.push(']')!;
                    self.state = State.CDATA;
                }
                continue;
            }
            if st == State.CDATA_END {
                if c == ']' {
                    self.i += 1;
                    self.chars.push(']')!;
                } else if c == '>' {
                    self.i += 1;
                    self.state = State.DATA;
                } else {
                    self.chars.push_str("]]")!;
                    self.state = State.CDATA;
                }
                continue;
            }
            // --- DOCTYPE
            if st == State.DOCTYPE {
                self.new_doctype();
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
                    self.i += 1;
                } else if c < 0 {
                    self.err();
                    self.force_quirks = true;
                    return TokenKind.DOCTYPE;
                } else if c != '>' {
                    self.err();
                }
                self.state = State.BEFORE_DOCTYPE_NAME;
                continue;
            }
            if st == State.BEFORE_DOCTYPE_NAME {
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
                    self.i += 1;
                } else if c == '>' {
                    self.err();
                    self.i += 1;
                    self.force_quirks = true;
                    self.state = State.DATA;
                    return TokenKind.DOCTYPE;
                } else if c < 0 {
                    self.err();
                    self.force_quirks = true;
                    return TokenKind.DOCTYPE;
                } else {
                    self.has_name = true;
                    self.state = State.DOCTYPE_NAME;
                }
                continue;
            }
            if st == State.DOCTYPE_NAME {
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
                    self.i += 1;
                    self.state = State.AFTER_DOCTYPE_NAME;
                } else if c == '>' {
                    self.i += 1;
                    self.state = State.DATA;
                    return TokenKind.DOCTYPE;
                } else if c < 0 {
                    self.err();
                    self.force_quirks = true;
                    return TokenKind.DOCTYPE;
                } else {
                    self.i += 1;
                    if c == 0 {
                        self.err();
                        self.name.push_str("\xef\xbf\xbd")!;
                    } else {
                        self.name.push(lower(c))!;
                    }
                }
                continue;
            }
            if st == State.AFTER_DOCTYPE_NAME {
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
                    self.i += 1;
                } else if c == '>' {
                    self.i += 1;
                    self.state = State.DATA;
                    return TokenKind.DOCTYPE;
                } else if c < 0 {
                    self.err();
                    self.force_quirks = true;
                    return TokenKind.DOCTYPE;
                } else if self.lookahead_ci("public") {
                    self.i += 6;
                    self.state = State.AFTER_DOCTYPE_PUBLIC_KW;
                } else if self.lookahead_ci("system") {
                    self.i += 6;
                    self.state = State.AFTER_DOCTYPE_SYSTEM_KW;
                } else {
                    self.err();
                    self.force_quirks = true;
                    self.state = State.BOGUS_DOCTYPE;
                }
                continue;
            }
            if (st == State.AFTER_DOCTYPE_PUBLIC_KW) or (st == State.BEFORE_DOCTYPE_PUBLIC_ID) or
               (st == State.AFTER_DOCTYPE_SYSTEM_KW) or (st == State.BEFORE_DOCTYPE_SYSTEM_ID) {
                let public = (st == State.AFTER_DOCTYPE_PUBLIC_KW) or (st == State.BEFORE_DOCTYPE_PUBLIC_ID);
                let kw = (st == State.AFTER_DOCTYPE_PUBLIC_KW) or (st == State.AFTER_DOCTYPE_SYSTEM_KW);
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
                    self.i += 1;
                    if kw and public {
                        self.state = State.BEFORE_DOCTYPE_PUBLIC_ID;
                    } else if kw {
                        self.state = State.BEFORE_DOCTYPE_SYSTEM_ID;
                    }
                } else if (c == '"') or (c == '\'') {
                    if kw {
                        self.err();
                    }
                    self.i += 1;
                    if public {
                        self.has_public = true;
                        self.state = State.DOCTYPE_PUBLIC_ID_DQ;
                        if c == '\'' {
                            self.state = State.DOCTYPE_PUBLIC_ID_SQ;
                        }
                    } else {
                        self.has_system = true;
                        self.state = State.DOCTYPE_SYSTEM_ID_DQ;
                        if c == '\'' {
                            self.state = State.DOCTYPE_SYSTEM_ID_SQ;
                        }
                    }
                } else if c == '>' {
                    self.err();
                    self.i += 1;
                    self.force_quirks = true;
                    self.state = State.DATA;
                    return TokenKind.DOCTYPE;
                } else if c < 0 {
                    self.err();
                    self.force_quirks = true;
                    return TokenKind.DOCTYPE;
                } else {
                    self.err();
                    self.force_quirks = true;
                    self.state = State.BOGUS_DOCTYPE;
                }
                continue;
            }
            if (st == State.DOCTYPE_PUBLIC_ID_DQ) or (st == State.DOCTYPE_PUBLIC_ID_SQ) or
               (st == State.DOCTYPE_SYSTEM_ID_DQ) or (st == State.DOCTYPE_SYSTEM_ID_SQ) {
                let mut q: i32 = '"';
                if (st == State.DOCTYPE_PUBLIC_ID_SQ) or (st == State.DOCTYPE_SYSTEM_ID_SQ) {
                    q = '\'';
                }
                let public = (st == State.DOCTYPE_PUBLIC_ID_DQ) or (st == State.DOCTYPE_PUBLIC_ID_SQ);
                if c == q {
                    self.i += 1;
                    if public {
                        self.state = State.AFTER_DOCTYPE_PUBLIC_ID;
                    } else {
                        self.state = State.AFTER_DOCTYPE_SYSTEM_ID;
                    }
                } else if c == '>' {
                    self.err();
                    self.i += 1;
                    self.force_quirks = true;
                    self.state = State.DATA;
                    return TokenKind.DOCTYPE;
                } else if c < 0 {
                    self.err();
                    self.force_quirks = true;
                    return TokenKind.DOCTYPE;
                } else {
                    self.i += 1;
                    let mut out = &mut self.system_id;
                    if public {
                        out = &mut self.public_id;
                    }
                    if c == 0 {
                        self.err();
                        out.push_str("\xef\xbf\xbd")!;
                    } else {
                        out.push(@truncate(u8, c))!;
                    }
                }
                continue;
            }
            if (st == State.AFTER_DOCTYPE_PUBLIC_ID) or (st == State.BETWEEN_DOCTYPE_IDS) {
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
                    self.i += 1;
                    self.state = State.BETWEEN_DOCTYPE_IDS;
                } else if c == '>' {
                    self.i += 1;
                    self.state = State.DATA;
                    return TokenKind.DOCTYPE;
                } else if (c == '"') or (c == '\'') {
                    if st == State.AFTER_DOCTYPE_PUBLIC_ID {
                        self.err();
                    }
                    self.i += 1;
                    self.has_system = true;
                    self.state = State.DOCTYPE_SYSTEM_ID_DQ;
                    if c == '\'' {
                        self.state = State.DOCTYPE_SYSTEM_ID_SQ;
                    }
                } else if c < 0 {
                    self.err();
                    self.force_quirks = true;
                    return TokenKind.DOCTYPE;
                } else {
                    self.err();
                    self.force_quirks = true;
                    self.state = State.BOGUS_DOCTYPE;
                }
                continue;
            }
            if st == State.AFTER_DOCTYPE_SYSTEM_ID {
                if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
                    self.i += 1;
                } else if c == '>' {
                    self.i += 1;
                    self.state = State.DATA;
                    return TokenKind.DOCTYPE;
                } else if c < 0 {
                    self.err();
                    self.force_quirks = true;
                    return TokenKind.DOCTYPE;
                } else {
                    self.err();
                    self.state = State.BOGUS_DOCTYPE;
                }
                continue;
            }
            if st == State.BOGUS_DOCTYPE {
                if c < 0 {
                    return TokenKind.DOCTYPE;
                }
                self.i += 1;
                if c == '>' {
                    self.state = State.DATA;
                    return TokenKind.DOCTYPE;
                }
                continue;
            }
            @trap();
        }
    }
}

const NONE_USIZE: usize = 0xffffffff;

// Where an end tag that turns out not to be one goes back to (from its end
// tag open or end tag name state).
fn end_tag_back(st: State) State {
    match st {
        .RCDATA_END_OPEN  => { return State.RCDATA; }
        .RCDATA_END_NAME  => { return State.RCDATA; }
        .RAWTEXT_END_OPEN => { return State.RAWTEXT; }
        .RAWTEXT_END_NAME => { return State.RAWTEXT; }
        .SCRIPT_END_OPEN  => { return State.SCRIPT; }
        .SCRIPT_END_NAME  => { return State.SCRIPT; }
        else              => { return State.SCRIPT_ESC; }
    }
}

// The end tag name state that follows an end tag open state.
fn end_name_state(open_state: State) State {
    match open_state {
        .RCDATA_END_OPEN  => { return State.RCDATA_END_NAME; }
        .RAWTEXT_END_OPEN => { return State.RAWTEXT_END_NAME; }
        .SCRIPT_END_OPEN  => { return State.SCRIPT_END_NAME; }
        else              => { return State.SCRIPT_ESC_END_NAME; }
    }
}

// Replacements for numeric references to C1 controls (0x80-0x9f), or 0.
let C1: [32]u32 = [
    0x20ac,
    0,
    0x201a,
    0x0192,
    0x201e,
    0x2026,
    0x2020,
    0x2021,
    0x02c6,
    0x2030,
    0x0160,
    0x2039,
    0x0152,
    0,
    0x017d,
    0,
    0,
    0x2018,
    0x2019,
    0x201c,
    0x201d,
    0x2022,
    0x2013,
    0x2014,
    0x02dc,
    0x2122,
    0x0161,
    0x203a,
    0x0153,
    0,
    0x017e,
    0x0178,
];

fn entity_name(i: usize) []u8 {
    return ent.NAMES[@as(usize, ent.OFFSET[i])..@as(usize, ent.OFFSET[i + 1])];
}

fn entity_index(name: []u8) !usize {
    let mut lo: usize = 0;
    let mut hi: usize = ent.COUNT;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let c = strs.compare(entity_name(mid), name);
        if c == 0 {
            return mid;
        }
        if c < 0 {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return error.NotFound;
}

// The index of a name that may appear without a semicolon.
fn legacy_index(name: []u8) !usize {
    let mut lo: usize = 0;
    let mut hi: usize = ent.LEGACY.len;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let k = @as(usize, ent.LEGACY[mid]);
        let c = strs.compare(entity_name(k), name);
        if c == 0 {
            return k;
        }
        if c < 0 {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return error.NotFound;
}

// -----------------------------------------------------------------------------
// The tree
// -----------------------------------------------------------------------------

const FL_OPEN: u8 = 1;  // on the stack of open elements
const FL_AFE: u8 = 2;   // in the list of active formatting elements
const FL_HIP: u8 = 4;   // an HTML integration point (MathML annotation-xml)

pub struct Node {
    kind: Kind,
    ns: Namespace,  // (elements)
    tag: u16,       // (the parser's number for the name)
    name: []u8,     // element local name; DOCTYPE name
    attrs: []Attr,
    text: []u8,       // TEXT and COMMENT data; DOCTYPE public identifier
    system_id: []u8,  // DOCTYPE system identifier
    parent: u32,
    first: u32,
    last: u32,
    prev: u32,
    next: u32,
    contents: u32,  // a template's contents (a FRAGMENT); a FRAGMENT's template
    flags: u8,
    tx: u32,    // while parsing, a TEXT node's data is tbuf[toff..toff + tlen],
    toff: u32,  // or texts[tx] when tx is not NONE
    tlen: u32,
}

/// A parsed document (or fragment): it owns every node and string.
pub struct Document {
    nodes: vec.Vec.[Node],
    arena: arena.Arena,
    mode: QuirksMode,
    tbuf: strs.String,
    texts: vec.Vec.[strs.String],

    fn init() Document {
        return Document.{ nodes: vec.Vec.[Node].init(), arena: arena.Arena.init(), mode: QuirksMode.NO_QUIRKS,
                          tbuf: strs.String.init(), texts: vec.Vec.[strs.String].init() };
    }

    pub fn deinit(self: *mut Document) void {
        self.nodes.deinit();
        self.arena.deinit();
        self.tbuf.deinit();
        for k in @as(usize, 0)..self.texts.len {
            self.texts.get_ptr(k).deinit();
        }
        self.texts.deinit();
    }

    pub fn node(self: *Document, id: u32) *Node {
        return &self.nodes.items()[@as(usize, id)];
    }

    fn nm(self: *mut Document, id: u32) *mut Node {
        return self.nodes.get_ptr(@as(usize, id));
    }

    fn new_node(self: *mut Document, kind: Kind) !u32 {
        let id = @truncate(u32, self.nodes.len);
        self.nodes.push(Node.{ kind: kind, ns: Namespace.HTML, tag: 0, name: "", attrs: no_attrs(), text: "",
                               system_id: "", parent: NONE, first: NONE, last: NONE, prev: NONE, next: NONE,
                               contents: NONE, flags: 0, tx: NONE, toff: 0, tlen: 0 })!;
        return id;
    }

    /// Inserts child (which must have no parent) into parent before ref
    /// (NONE: at the end).
    pub fn insert_before(self: *mut Document, parent: u32, child: u32, ref: u32) void {
        let c = self.nm(child);
        c.parent = parent;
        let p = self.nm(parent);
        if ref == NONE {
            c.prev = p.last;
            c.next = NONE;
            if p.last != NONE {
                self.nm(p.last).next = child;
            } else {
                p.first = child;
            }
            p.last = child;
        } else {
            let r = self.nm(ref);
            c.prev = r.prev;
            c.next = ref;
            if r.prev != NONE {
                self.nm(r.prev).next = child;
            } else {
                p.first = child;
            }
            r.prev = child;
        }
    }

    pub fn append_child(self: *mut Document, parent: u32, child: u32) void {
        self.insert_before(parent, child, NONE);
    }

    /// Takes id out of its parent (it and its subtree stay, detached).
    pub fn remove(self: *mut Document, id: u32) void {
        let c = self.nm(id);
        let p = c.parent;
        if p == NONE {
            return;
        }
        if c.prev != NONE {
            self.nm(c.prev).next = c.next;
        } else {
            self.nm(p).first = c.next;
        }
        if c.next != NONE {
            self.nm(c.next).prev = c.prev;
        } else {
            self.nm(p).last = c.prev;
        }
        c.parent = NONE;
        c.prev = NONE;
        c.next = NONE;
    }

    // The data of a text node while parsing.
    fn tdata(self: *Document, id: u32) []u8 {
        let n = self.node(id);
        if n.tx != NONE {
            return self.texts.items()[@as(usize, n.tx)].bytes();
        }
        return self.tbuf.bytes()[@as(usize, n.toff)..@as(usize, n.toff + n.tlen)];
    }

    fn new_text(self: *mut Document, data: []u8) !u32 {
        let id = self.new_node(Kind.TEXT)!;
        let n = self.nm(id);
        n.toff = @truncate(u32, self.tbuf.len);
        n.tlen = @truncate(u32, data.len);
        self.tbuf.push_str(data)!;
        return id;
    }

    fn append_text(self: *mut Document, id: u32, data: []u8) !void {
        let n = self.nm(id);
        if n.tx == NONE {
            if (@as(usize, n.toff + n.tlen) == self.tbuf.len) {
                self.tbuf.push_str(data)!;
                n.tlen += @truncate(u32, data.len);
                return;
            }
            // not at the end of the shared buffer: give it its own
            let mut s = strs.String.from(self.tdata(id))!;
            s.push_str(data) catch |e| {
                s.deinit();
                return e;
            };
            self.texts.push(s) catch |e| {
                s.deinit();
                return e;
            };
            self.nm(id).tx = @truncate(u32, self.texts.len - 1);
            return;
        }
        self.texts.get_ptr(@as(usize, n.tx)).push_str(data)!;
    }

    // Points text nodes' `text` at their data (after parsing).
    fn finish_text(self: *mut Document) void {
        for k in @as(usize, 0)..self.nodes.len {
            let id = @truncate(u32, k);
            let n = self.nm(id);
            if (n.kind == Kind.TEXT) and (n.text.len == 0) {
                n.text = self.tdata(id);
            }
        }
    }

    // --- reading

    /// The document element (<html>), or NONE.
    pub fn root(self: *Document) u32 {
        let mut c = self.node(0).first;
        while c != NONE {
            if self.node(c).kind == Kind.ELEMENT {
                return c;
            }
            c = self.node(c).next;
        }
        return NONE;
    }

    /// The first child element of the root with this name, or NONE.
    fn root_child(self: *Document, name: []u8) u32 {
        let r = self.root();
        if r == NONE {
            return NONE;
        }
        let mut c = self.node(r).first;
        while c != NONE {
            let n = self.node(c);
            if (n.kind == Kind.ELEMENT) and (n.ns == Namespace.HTML) and strs.eq(n.name, name) {
                return c;
            }
            c = n.next;
        }
        return NONE;
    }

    pub fn head(self: *Document) u32 {
        return self.root_child("head");
    }

    /// The <body> (or <frameset>), or NONE.
    pub fn body(self: *Document) u32 {
        let b = self.root_child("body");
        if b != NONE {
            return b;
        }
        return self.root_child("frameset");
    }

    /// The text of the first <title>, with whitespace collapsed ("" if
    /// none); the caller frees it.
    pub fn title(self: *Document) ![]mut u8 {
        let id = self.find(0, "title");
        let mut s = strs.String.init();
        if id == NONE {
            return s.take();
        }
        let t = self.text_content(id)!;
        defer mem.free(t);
        let mut it = strs.fields(t);
        while true {
            let w = it.next() catch break;
            if s.len > 0 {
                s.push(' ') catch |e| {
                    s.deinit();
                    return e;
                };
            }
            s.push_str(w) catch |e| {
                s.deinit();
                return e;
            };
        }
        return s.take();
    }

    pub fn walk(self: *Document, id: u32) Walker {
        return Walker.{ doc: self, root: id, id: id, entering: true, started: false, templates: true };
    }

    pub fn children(self: *Document, id: u32) Children {
        return Children.{ doc: self, id: self.first_kid(id, true) };
    }

    // The first child, or for a template the first node of its contents.
    fn first_kid(self: *Document, id: u32, templates: bool) u32 {
        let n = self.node(id);
        if templates and (n.kind == Kind.ELEMENT) and (n.contents != NONE) {
            return self.node(n.contents).first;
        }
        return n.first;
    }

    // The parent, or for template contents the template.
    fn up(self: *Document, id: u32) u32 {
        let p = self.node(id).parent;
        if (p != NONE) and (self.node(p).kind == Kind.FRAGMENT) and (self.node(p).contents != NONE) {
            return self.node(p).contents;
        }
        return p;
    }

    /// The parent element (NONE for the root and detached nodes).
    pub fn parent_element(self: *Document, id: u32) u32 {
        let p = self.up(id);
        if (p != NONE) and (self.node(p).kind == Kind.ELEMENT) {
            return p;
        }
        return NONE;
    }

    /// An attribute's value (attributes with a namespace are matched by
    /// "prefix:name").
    pub fn attr(self: *Document, id: u32, name: []u8) ![]u8 {
        for a in self.node(id).attrs {
            if attr_is(a, name) {
                return a.value;
            }
        }
        return error.NotFound;
    }

    pub fn has_attr(self: *Document, id: u32, name: []u8) bool {
        _ = self.attr(id, name) catch return false;
        return true;
    }

    /// The text of the node and its descendants, in order (as the DOM's
    /// textContent); the caller frees it.
    pub fn text_content(self: *Document, id: u32) ![]mut u8 {
        let mut s = strs.String.init();
        let mut w = self.walk(id);
        w.templates = false;
        while w.next() {
            let n = self.node(w.id);
            if w.entering and (n.kind == Kind.TEXT) {
                s.push_str(n.text) catch |e| {
                    s.deinit();
                    return e;
                };
            }
        }
        return s.take();
    }

    /// The first element under id (in document order, id included) with
    /// the local name, or NONE.
    pub fn find(self: *Document, id: u32, name: []u8) u32 {
        let mut w = self.walk(id);
        while w.next() {
            let n = self.node(w.id);
            if w.entering and (n.kind == Kind.ELEMENT) and name_is(n, name) {
                return w.id;
            }
        }
        return NONE;
    }

    // --- changing

    /// A new, detached HTML element.
    pub fn create_element(self: *mut Document, name: []u8) !u32 {
        let id = self.new_node(Kind.ELEMENT)!;
        let lname = self.arena.bytes(name.len)!;
        for k in @as(usize, 0)..name.len {
            lname[k] = strs.to_lower_byte(name[k]);
        }
        let n = self.nm(id);
        n.name = lname;
        n.tag = tags.tag_of(lname);
        if n.tag == tags.T_TEMPLATE {
            let f = self.new_node(Kind.FRAGMENT)!;
            self.nm(f).contents = id;
            self.nm(id).contents = f;
        }
        return id;
    }

    pub fn create_text(self: *mut Document, data: []u8) !u32 {
        let id = self.new_node(Kind.TEXT)!;
        self.nm(id).text = self.arena.dup(data)!;
        return id;
    }

    pub fn create_comment(self: *mut Document, data: []u8) !u32 {
        let id = self.new_node(Kind.COMMENT)!;
        self.nm(id).text = self.arena.dup(data)!;
        return id;
    }

    /// Sets (or adds) an attribute without a namespace.
    pub fn set_attr(self: *mut Document, id: u32, name: []u8, value: []u8) !void {
        let v = self.arena.dup(value)!;
        let old = self.nm(id).attrs;
        let mut all = vec.Vec.[Attr].init();
        defer all.deinit();
        let mut found = false;
        for a in old {
            let mut b = a;
            if (a.ns == AttrNamespace.NONE) and strs.eq(a.name, name) {
                b.value = v;
                found = true;
            }
            all.push(b)!;
        }
        if not found {
            all.push(Attr.{ ns: AttrNamespace.NONE, prefix: "", name: self.arena.dup(name)!, value: v })!;
        }
        self.nm(id).attrs = self.arena.copy.[Attr](all.items())!;
    }

    pub fn remove_attr(self: *mut Document, id: u32, name: []u8) !void {
        let old = self.nm(id).attrs;
        let mut all = vec.Vec.[Attr].init();
        defer all.deinit();
        for a in old {
            if not attr_is(a, name) {
                all.push(a)!;
            }
        }
        if all.len != old.len {
            self.nm(id).attrs = self.arena.copy.[Attr](all.items())!;
        }
    }

    /// A deep copy of a node (detached).
    pub fn clone_tree(self: *mut Document, id: u32) !u32 {
        let top = self.copy_node(id)!;
        let mut work = vec.Vec.[u32].init();  // pairs: source, copy
        defer work.deinit();
        work.push(id)!;
        work.push(top)!;
        while work.len > 0 {
            let dst = work.pop()!;
            let src = work.pop()!;
            let mut from = src;
            let mut to = dst;
            if (self.nm(src).kind == Kind.ELEMENT) and (self.nm(src).contents != NONE) {
                from = self.nm(src).contents;
                to = self.nm(dst).contents;
            }
            let mut c = self.nm(from).first;
            while c != NONE {
                let k = self.copy_node(c)!;
                self.append_child(to, k);
                work.push(c)!;
                work.push(k)!;
                c = self.nm(c).next;
            }
        }
        return top;
    }

    fn copy_node(self: *mut Document, id: u32) !u32 {
        let k = self.new_node(self.nm(id).kind)!;
        let o = self.nm(id);
        let n = self.nm(k);
        n.ns = o.ns;
        n.tag = o.tag;
        n.name = o.name;
        n.attrs = o.attrs;
        n.text = o.text;
        n.system_id = o.system_id;
        if (o.kind == Kind.ELEMENT) and (o.contents != NONE) {
            let f = self.new_node(Kind.FRAGMENT)!;
            self.nm(f).contents = k;
            self.nm(k).contents = f;
        }
        return k;
    }

    // --- serialization

    /// The HTML for a node and its descendants (outerHTML); for node 0,
    /// the whole document. The caller frees it.
    pub fn to_html(self: *Document, id: u32) ![]mut u8 {
        let mut s = strs.String.init();
        self.serialize(s.writer(), id, true) catch |e| {
            s.deinit();
            return e;
        };
        return s.take();
    }

    /// The HTML for a node's children (innerHTML).
    pub fn inner_html(self: *Document, id: u32) ![]mut u8 {
        let mut s = strs.String.init();
        self.serialize(s.writer(), id, false) catch |e| {
            s.deinit();
            return e;
        };
        return s.take();
    }

    /// Writes the HTML serialization of a node (outer: the node itself too).
    pub fn serialize(self: *Document, out: io.Writer, id: u32, outer: bool) !void {
        let mut w = self.walk(id);
        while w.next() {
            let n = self.node(w.id);
            let is_top = w.id == id;
            if is_top and not outer {
                continue;
            }
            if not w.entering {
                if (n.kind == Kind.ELEMENT) and
                   not ((n.ns == Namespace.HTML) and ((tags.TAG_FLAGS[@as(usize, n.tag)] & tags.F_VOID) != 0)) {
                    out.write_all("</")!;
                    out.write_all(n.name)!;
                    out.write_all(">")!;
                }
                continue;
            }
            if n.kind == Kind.ELEMENT {
                out.write_all("<")!;
                out.write_all(n.name)!;
                for a in n.attrs {
                    out.write_all(" ")!;
                    if a.ns == AttrNamespace.XML {
                        out.write_all("xml:")!;
                    } else if a.ns == AttrNamespace.XLINK {
                        out.write_all("xlink:")!;
                    } else if (a.ns == AttrNamespace.XMLNS) and not strs.eq(a.name, "xmlns") {
                        out.write_all("xmlns:")!;
                    }
                    out.write_all(a.name)!;
                    out.write_all("=\"")!;
                    escape(out, a.value, true)!;
                    out.write_all("\"")!;
                }
                out.write_all(">")!;
                if (n.ns == Namespace.HTML) and ((tags.TAG_FLAGS[@as(usize, n.tag)] & tags.F_VOID) != 0) {
                    w.skip();
                }
            } else if n.kind == Kind.TEXT {
                let p = self.parent_element(w.id);
                if (p != NONE) and (self.node(p).ns == Namespace.HTML) and
                   ((tags.TAG_FLAGS[@as(usize, self.node(p).tag)] & tags.F_RAW) != 0) {
                    out.write_all(n.text)!;
                } else {
                    escape(out, n.text, false)!;
                }
            } else if n.kind == Kind.COMMENT {
                out.write_all("<!--")!;
                out.write_all(n.text)!;
                out.write_all("-->")!;
            } else if n.kind == Kind.DOCTYPE {
                out.write_all("<!DOCTYPE ")!;
                out.write_all(n.name)!;
                out.write_all(">")!;
            }
        }
    }

    // --- selectors

    /// The first element under id (id excluded) that matches a CSS
    /// selector, or NONE.
    pub fn query_from(self: *Document, id: u32, selector: []u8) !u32 {
        let mut sel = compile(selector)!;
        defer sel.deinit();
        let mut w = self.walk(id);
        _ = w.next();
        while w.next() {
            if w.entering and (self.node(w.id).kind == Kind.ELEMENT) and sel.matches(self, w.id) {
                return w.id;
            }
        }
        return NONE;
    }

    /// The first element in the document matching a CSS selector, or NONE.
    pub fn query(self: *Document, selector: []u8) !u32 {
        return self.query_from(0, selector);
    }

    /// Every element under id (id excluded) that matches, in document
    /// order; the caller frees the list.
    pub fn query_all_from(self: *Document, id: u32, selector: []u8) ![]mut u32 {
        let mut sel = compile(selector)!;
        defer sel.deinit();
        let mut out = vec.Vec.[u32].init();
        let mut w = self.walk(id);
        _ = w.next();
        while w.next() {
            if w.entering and (self.node(w.id).kind == Kind.ELEMENT) and sel.matches(self, w.id) {
                out.push(w.id) catch |e| {
                    out.deinit();
                    return e;
                };
            }
        }
        return take_vec(&mut out);
    }

    pub fn query_all(self: *Document, selector: []u8) ![]mut u32 {
        return self.query_all_from(0, selector);
    }

    /// Whether an element matches a CSS selector.
    pub fn matches(self: *Document, id: u32, selector: []u8) !bool {
        let mut sel = compile(selector)!;
        defer sel.deinit();
        return sel.matches(self, id);
    }
}

fn no_attrs() []Attr {
    return @slice_from_ptr(@ptr_from_int(*Attr, 8), 0);
}

// Insertion modes
enum Mode: u8 {
    INITIAL,
    BEFORE_HTML,
    BEFORE_HEAD,
    IN_HEAD,
    IN_HEAD_NOSCRIPT,
    AFTER_HEAD,
    IN_BODY,
    TEXT,
    IN_TABLE,
    IN_TABLE_TEXT,
    IN_CAPTION,
    IN_COLUMN_GROUP,
    IN_TABLE_BODY,
    IN_ROW,
    IN_CELL,
    IN_TEMPLATE,
    AFTER_BODY,
    IN_FRAMESET,
    AFTER_FRAMESET,
    AFTER_AFTER_BODY,
    AFTER_AFTER_FRAMESET,
}

// Kinds of scope
enum Scope: u8 {
    DEFAULT,
    LIST,
    BUTTON,
    TABLE,
}

const MARKER: u32 = 0xfffffffe;

/// The most formatting elements that stay active (after the last marker);
/// the spec's limit is three of each kind, which leaves quadratic growth
/// open to hostile input.
const MAX_ACTIVE_FORMATTING: usize = 32;

pub struct Options {
    scripting: bool,  // parse as if scripts ran: <noscript> holds raw text

    pub fn default() Options {
        return Options.{ scripting: false };
    }
}

struct Loc {
    parent: u32,
    before: u32,
}

struct Parser {
    doc: *mut Document,
    tz: *mut Tokenizer,
    stack: vec.Vec.[u32],
    open: [124]u32,  // how many HTML elements of each T_ are on the stack
    afe: vec.Vec.[u32],
    tmodes: vec.Vec.[Mode],
    mode: Mode,
    orig: Mode,
    head: u32,
    form: u32,
    context: u32,
    frameset_ok: bool,
    foster: bool,
    scripting: bool,
    skip_lf: bool,
    text_elem: u32,        // the element "text" mode reads into, if opened
    pend: strs.String,     // pending table character tokens
    pend_text: bool,       // ... some are not whitespace
    sbuf: strs.String,     // scratch for characters
    abuf: vec.Vec.[Attr],  // scratch for attributes

    fn deinit(self: *mut Parser) void {
        self.stack.deinit();
        self.afe.deinit();
        self.tmodes.deinit();
        self.pend.deinit();
        self.sbuf.deinit();
        self.abuf.deinit();
    }

    fn nd(self: *Parser, id: u32) *mut Node {
        return self.doc.nm(id);
    }

    fn cur(self: *Parser) u32 {
        if self.stack.len == 0 {
            return NONE;
        }
        return self.stack.items()[self.stack.len - 1];
    }

    fn adjusted_current(self: *Parser) u32 {
        if (self.context != NONE) and (self.stack.len == 1) {
            return self.context;
        }
        return self.cur();
    }

    // Whether id is an HTML element with tag t.
    fn is(self: *Parser, id: u32, t: u16) bool {
        if id == NONE {
            return false;
        }
        let n = self.nd(id);
        return (n.ns == Namespace.HTML) and (n.tag == t) and (n.kind == Kind.ELEMENT);
    }

    fn cur_is(self: *Parser, t: u16) bool {
        return self.is(self.cur(), t);
    }

    fn special(self: *Parser, id: u32) bool {
        let n = self.nd(id);
        if n.ns == Namespace.HTML {
            return (tags.TAG_FLAGS[@as(usize, n.tag)] & tags.F_SPECIAL) != 0;
        }
        return scope_foreign(n);
    }

    fn mathml_text_ip(self: *Parser, id: u32) bool {
        let n = self.nd(id);
        return (n.ns == Namespace.MATHML) and
               ((n.tag == tags.T_MI) or (n.tag == tags.T_MO) or (n.tag == tags.T_MN) or (n.tag == tags.T_MS) or
                (n.tag == tags.T_MTEXT));
    }

    fn html_ip(self: *Parser, id: u32) bool {
        let n = self.nd(id);
        if n.ns == Namespace.MATHML {
            return (n.flags & FL_HIP) != 0;
        }
        return (n.ns == Namespace.SVG) and
               ((n.tag == tags.T_FOREIGNOBJECT) or (n.tag == tags.T_DESC) or (n.tag == tags.T_TITLE));
    }

    fn has_template(self: *Parser) bool {
        return self.open[@as(usize, tags.T_TEMPLATE)] > 0;
    }

    fn in_template_contents(self: *Parser) bool {
        return self.has_template() or self.is(self.context, tags.T_TEMPLATE);
    }

    // --- the stack of open elements

    fn push(self: *mut Parser, id: u32) !bool {
        if self.stack.len >= MAX_DEPTH {
            return false;
        }
        self.stack.push(id)!;
        self.opened_at(id);
        return true;
    }

    // Bookkeeping for an element put on the stack, or taken off it.
    fn opened_at(self: *mut Parser, id: u32) void {
        let n = self.nd(id);
        n.flags |= FL_OPEN;
        if n.ns == Namespace.HTML {
            self.open[@as(usize, n.tag)] += 1;
        }
    }

    fn closed_at(self: *mut Parser, id: u32) void {
        let n = self.nd(id);
        n.flags &= ~FL_OPEN;
        if n.ns == Namespace.HTML {
            self.open[@as(usize, n.tag)] -= 1;
        }
    }

    // Pops the current node (never the root element).
    fn pop(self: *mut Parser) void {
        if self.stack.len <= 1 {
            return;
        }
        let id = self.stack.items()[self.stack.len - 1];
        self.stack.truncate(self.stack.len - 1);
        self.closed_at(id);
    }

    // Pops up to (not including) index i.
    fn pop_to(self: *mut Parser, i: usize) void {
        let k = @max(i, 1);
        while self.stack.len > k {
            self.pop();
        }
    }

    fn pop_until(self: *mut Parser, t: u16) void {
        while self.stack.len > 1 {
            let id = self.cur();
            self.pop();
            if self.is(id, t) {
                return;
            }
        }
    }

    fn pop_until_node(self: *mut Parser, id: u32) void {
        while self.stack.len > 1 {
            let c = self.cur();
            self.pop();
            if c == id {
                return;
            }
        }
    }

    fn stack_index(self: *Parser, id: u32) usize {
        let items = self.stack.items();
        let mut i = items.len;
        while i > 0 {
            i -= 1;
            if items[i] == id {
                return i;
            }
        }
        return NONE_USIZE;
    }

    fn stack_remove(self: *mut Parser, id: u32) void {
        let i = self.stack_index(id);
        if (i != NONE_USIZE) and (i > 0) {
            _ = self.stack.remove(i);
            self.closed_at(id);
        }
    }

    fn boundary(self: *Parser, id: u32, sc: Scope) bool {
        let n = self.nd(id);
        if sc == Scope.TABLE {
            return (n.ns == Namespace.HTML) and
                   ((n.tag == tags.T_HTML) or (n.tag == tags.T_TABLE) or (n.tag == tags.T_TEMPLATE));
        }
        if n.ns == Namespace.HTML {
            if (tags.TAG_FLAGS[@as(usize, n.tag)] & tags.F_SCOPE) != 0 {
                return true;
            }
            if sc == Scope.LIST {
                return (n.tag == tags.T_OL) or (n.tag == tags.T_UL);
            }
            if sc == Scope.BUTTON {
                return n.tag == tags.T_BUTTON;
            }
            return false;
        }
        return scope_foreign(n);
    }

    fn in_scope(self: *Parser, t: u16, sc: Scope) bool {
        if self.open[@as(usize, t)] == 0 {
            return false;
        }
        let items = self.stack.items();
        let mut i = items.len;
        while i > 0 {
            i -= 1;
            if self.is(items[i], t) {
                return true;
            }
            if self.boundary(items[i], sc) {
                return false;
            }
        }
        return false;
    }

    fn node_in_scope(self: *Parser, id: u32) bool {
        let items = self.stack.items();
        let mut i = items.len;
        while i > 0 {
            i -= 1;
            if items[i] == id {
                return true;
            }
            if self.boundary(items[i], Scope.DEFAULT) {
                return false;
            }
        }
        return false;
    }

    fn heading_in_scope(self: *Parser) bool {
        let items = self.stack.items();
        let mut i = items.len;
        while i > 0 {
            i -= 1;
            let n = self.nd(items[i]);
            if (n.ns == Namespace.HTML) and (n.tag >= tags.T_H1) and (n.tag <= tags.T_H6) {
                return true;
            }
            if self.boundary(items[i], Scope.DEFAULT) {
                return false;
            }
        }
        return false;
    }

    fn gen_implied(self: *mut Parser, except: u16) void {
        loop {
            let c = self.cur();
            let n = self.nd(c);
            if (n.ns != Namespace.HTML) or (n.tag == except) or
               ((tags.TAG_FLAGS[@as(usize, n.tag)] & tags.F_IMPLIED) == 0) {
                return;
            }
            self.pop();
        }
    }

    fn gen_thorough(self: *mut Parser) void {
        loop {
            let n = self.nd(self.cur());
            if (n.ns != Namespace.HTML) or ((tags.TAG_FLAGS[@as(usize, n.tag)] & tags.F_THOROUGH) == 0) {
                return;
            }
            self.pop();
        }
    }

    fn close_p(self: *mut Parser) void {
        self.gen_implied(tags.T_P);
        self.pop_until(tags.T_P);
    }

    fn close_p_in_button_scope(self: *mut Parser) void {
        if self.in_scope(tags.T_P, Scope.BUTTON) {
            self.close_p();
        }
    }

    // Pops until the current node is one of the tags, or html (or template).
    fn clear_to(self: *mut Parser, a: u16, b: u16, c: u16) void {
        loop {
            let id = self.cur();
            if self.is(id, a) or self.is(id, b) or self.is(id, c) or self.is(id, tags.T_TEMPLATE) or
               self.is(id, tags.T_HTML) or (self.stack.len <= 1) {
                return;
            }
            self.pop();
        }
    }

    fn reset_mode(self: *mut Parser) void {
        let items = self.stack.items();
        let mut i = items.len;
        while i > 0 {
            i -= 1;
            let mut id = items[i];
            let last = i == 0;
            if last and (self.context != NONE) {
                id = self.context;
            }
            let n = self.nd(id);
            if n.ns == Namespace.HTML {
                let t = n.tag;
                if ((t == tags.T_TD) or (t == tags.T_TH)) and not last {
                    self.mode = Mode.IN_CELL;
                    return;
                }
                if t == tags.T_TR {
                    self.mode = Mode.IN_ROW;
                    return;
                }
                if (t == tags.T_TBODY) or (t == tags.T_THEAD) or (t == tags.T_TFOOT) {
                    self.mode = Mode.IN_TABLE_BODY;
                    return;
                }
                if t == tags.T_CAPTION {
                    self.mode = Mode.IN_CAPTION;
                    return;
                }
                if t == tags.T_COLGROUP {
                    self.mode = Mode.IN_COLUMN_GROUP;
                    return;
                }
                if t == tags.T_TABLE {
                    self.mode = Mode.IN_TABLE;
                    return;
                }
                if t == tags.T_TEMPLATE {
                    self.mode = self.tmodes.last() catch Mode.IN_BODY;
                    return;
                }
                if (t == tags.T_HEAD) and not last {
                    self.mode = Mode.IN_HEAD;
                    return;
                }
                if t == tags.T_BODY {
                    self.mode = Mode.IN_BODY;
                    return;
                }
                if t == tags.T_FRAMESET {
                    self.mode = Mode.IN_FRAMESET;
                    return;
                }
                if t == tags.T_HTML {
                    if self.head == NONE {
                        self.mode = Mode.BEFORE_HEAD;
                    } else {
                        self.mode = Mode.AFTER_HEAD;
                    }
                    return;
                }
            }
            if last {
                self.mode = Mode.IN_BODY;
                return;
            }
        }
        self.mode = Mode.IN_BODY;
    }

    // --- the list of active formatting elements

    fn afe_index(self: *Parser, id: u32) usize {
        let items = self.afe.items();
        let mut i = items.len;
        while i > 0 {
            i -= 1;
            if items[i] == id {
                return i;
            }
        }
        return NONE_USIZE;
    }

    fn afe_remove_at(self: *mut Parser, i: usize) void {
        let id = self.afe.remove(i);
        if id != MARKER {
            self.nd(id).flags &= ~FL_AFE;
        }
    }

    fn afe_remove(self: *mut Parser, id: u32) void {
        let i = self.afe_index(id);
        if i != NONE_USIZE {
            self.afe_remove_at(i);
        }
    }

    fn afe_push(self: *mut Parser, id: u32) !void {
        if (self.nd(id).flags & FL_OPEN) == 0 {
            return;  // (not opened: past MAX_DEPTH)
        }
        // Noah's Ark: at most three alike after the last marker
        let items = self.afe.items();
        let mut same: usize = 0;
        let mut earliest = NONE_USIZE;
        let mut count: usize = 0;
        let mut first = NONE_USIZE;
        let mut i = items.len;
        while i > 0 {
            i -= 1;
            let e = items[i];
            if e == MARKER {
                break;
            }
            count += 1;
            first = i;
            if self.alike(e, id) {
                same += 1;
                earliest = i;
            }
        }
        if same >= 3 {
            self.afe_remove_at(earliest);
        } else if count >= MAX_ACTIVE_FORMATTING {
            self.afe_remove_at(first);
        }
        self.afe.push(id)!;
        self.nd(id).flags |= FL_AFE;
    }

    fn alike(self: *Parser, a: u32, b: u32) bool {
        let x = self.nd(a);
        let y = self.nd(b);
        if (x.tag != y.tag) or (x.ns != y.ns) or not strs.eq(x.name, y.name) or (x.attrs.len != y.attrs.len) {
            return false;
        }
        for p in x.attrs {
            let mut found = false;
            for q in y.attrs {
                if (p.ns == q.ns) and strs.eq(p.name, q.name) and strs.eq(p.value, q.value) {
                    found = true;
                    break;
                }
            }
            if not found {
                return false;
            }
        }
        return true;
    }

    fn afe_clear_to_marker(self: *mut Parser) void {
        while self.afe.len > 0 {
            let e = self.afe.items()[self.afe.len - 1];
            self.afe_remove_at(self.afe.len - 1);
            if e == MARKER {
                return;
            }
        }
    }

    fn reconstruct(self: *mut Parser) !void {
        let n = self.afe.len;
        if n == 0 {
            return;
        }
        let items = self.afe.items();
        let last = items[n - 1];
        if (last == MARKER) or ((self.nd(last).flags & FL_OPEN) != 0) {
            return;
        }
        let mut i = n - 1;
        while i > 0 {
            let e = self.afe.items()[i - 1];
            if (e == MARKER) or ((self.nd(e).flags & FL_OPEN) != 0) {
                break;
            }
            i -= 1;
        }
        while i < self.afe.len {
            if self.stack.len >= MAX_DEPTH {
                return;
            }
            let old = self.afe.items()[i];
            let e = self.clone_element(old)!;
            self.insert_node(self.place(NONE), e);
            _ = self.push(e)!;
            self.afe.items()[i] = e;
            self.nd(old).flags &= ~FL_AFE;
            self.nd(e).flags |= FL_AFE;
            i += 1;
        }
    }

    // --- creating and inserting nodes

    fn place(self: *Parser, override: u32) Loc {
        let mut target = override;
        if target == NONE {
            target = self.cur();
        }
        let mut before = NONE;
        if self.foster and
           (self.is(target, tags.T_TABLE) or self.is(target, tags.T_TBODY) or self.is(target, tags.T_TFOOT) or
            self.is(target, tags.T_THEAD) or self.is(target, tags.T_TR)) {
            let items = self.stack.items();
            let mut i = items.len;
            let mut found = false;
            while i > 0 {
                i -= 1;
                if self.is(items[i], tags.T_TEMPLATE) or self.is(items[i], tags.T_TABLE) {
                    found = true;
                    break;
                }
            }
            if not found {
                return Loc.{ parent: items[0], before: NONE };
            }
            let lt = items[i];
            if self.is(lt, tags.T_TEMPLATE) {
                target = lt;
            } else if self.nd(lt).parent != NONE {
                return Loc.{ parent: self.nd(lt).parent, before: lt };
            } else {
                target = items[i - 1];
            }
        }
        if self.is(target, tags.T_TEMPLATE) and (self.nd(target).contents != NONE) {
            return Loc.{ parent: self.nd(target).contents, before: NONE };
        }
        return Loc.{ parent: target, before: before };
    }

    fn insert_node(self: *mut Parser, at: Loc, id: u32) void {
        self.doc.insert_before(at.parent, id, at.before);
    }

    fn insert_text(self: *mut Parser, data: []u8) !void {
        if data.len == 0 {
            return;
        }
        let at = self.place(NONE);
        let p = self.nd(at.parent);
        if p.kind == Kind.DOCUMENT {
            return;
        }
        let mut prev = p.last;
        if at.before != NONE {
            prev = self.nd(at.before).prev;
        }
        if (prev != NONE) and (self.nd(prev).kind == Kind.TEXT) {
            self.doc.append_text(prev, data)!;
            return;
        }
        let id = self.doc.new_text(data)!;
        self.insert_node(at, id);
    }

    fn insert_comment(self: *mut Parser, t: *Token, at: Loc) !void {
        let id = self.doc.new_node(Kind.COMMENT)!;
        self.nd(id).text = self.doc.arena.dup(t.data)!;
        self.insert_node(at, id);
    }

    fn create_element(self: *mut Parser, t: *Token, ns: Namespace) !u32 {
        let id = self.doc.new_node(Kind.ELEMENT)!;
        let mut name = t.name;
        if (ns == Namespace.HTML) and (t.tag != 0) {
            name = tags.TAG_NAMES[@as(usize, t.tag) - 1];
        } else if ns == Namespace.SVG {
            name = svg_tag_name(t.name);
        }
        if name.ptr == t.name.ptr {
            name = self.doc.arena.dup(name)!;
        }
        let attrs = self.copy_attrs(t.attrs, ns)!;
        let n = self.nd(id);
        n.ns = ns;
        n.tag = t.tag;
        n.name = name;
        n.attrs = attrs;
        if (ns == Namespace.MATHML) and (t.tag == tags.T_ANNOTATION_XML) {
            for a in attrs {
                if strs.eq(a.name, "encoding") and
                   (strs.eq_ignore_case(a.value, "text/html") or
                    strs.eq_ignore_case(a.value, "application/xhtml+xml")) {
                    n.flags |= FL_HIP;
                }
            }
        }
        if (ns == Namespace.HTML) and (t.tag == tags.T_TEMPLATE) {
            let f = self.doc.new_node(Kind.FRAGMENT)!;
            self.nd(f).contents = id;
            self.nd(id).contents = f;
        }
        return id;
    }

    // The token's attributes in the arena, adjusted for SVG and MathML.
    fn copy_attrs(self: *mut Parser, attrs: []Attr, ns: Namespace) ![]Attr {
        if attrs.len == 0 {
            return no_attrs();
        }
        let mut total: usize = 0;
        for a in attrs {
            total += a.name.len + a.value.len;
        }
        let buf = self.doc.arena.bytes(total)!;
        let mut at: usize = 0;
        self.abuf.clear();
        for a in attrs {
            @mem_copy(buf[at..at + a.name.len], a.name);
            let nm = buf[at..at + a.name.len];
            at += a.name.len;
            @mem_copy(buf[at..at + a.value.len], a.value);
            let v = buf[at..at + a.value.len];
            at += a.value.len;
            let mut b = Attr.{ ns: AttrNamespace.NONE, prefix: "", name: nm, value: v };
            if ns == Namespace.MATHML {
                if strs.eq(nm, "definitionurl") {
                    b.name = "definitionURL";
                }
                foreign_attr(&mut b);
            } else if ns == Namespace.SVG {
                b.name = svg_attr_name(nm);
                foreign_attr(&mut b);
            }
            self.abuf.push(b)!;
        }
        return self.doc.arena.copy.[Attr](self.abuf.items());
    }

    fn clone_element(self: *mut Parser, id: u32) !u32 {
        let e = self.doc.new_node(Kind.ELEMENT)!;
        let o = self.nd(id);
        let n = self.nd(e);
        n.ns = o.ns;
        n.tag = o.tag;
        n.name = o.name;
        n.attrs = o.attrs;
        n.flags = o.flags & FL_HIP;
        return e;
    }

    // Inserts an element for the token and opens it (unless the stack is
    // full).
    fn insert(self: *mut Parser, t: *Token, ns: Namespace) !u32 {
        let at = self.place(NONE);
        let id = self.create_element(t, ns)!;
        self.insert_node(at, id);
        _ = self.push(id)!;
        return id;
    }

    // Inserts an element that is closed at once.
    fn insert_void(self: *mut Parser, t: *Token) !u32 {
        let at = self.place(NONE);
        let id = self.create_element(t, Namespace.HTML)!;
        self.insert_node(at, id);
        return id;
    }

    fn insert_fake(self: *mut Parser, tag: u16) !u32 {
        let mut t = fake_token(tag);
        return self.insert(&mut t, Namespace.HTML);
    }

    fn opened(self: *Parser, id: u32) bool {
        return (self.nd(id).flags & FL_OPEN) != 0;
    }

    fn raw_text(self: *mut Parser, t: *Token, state: State) !void {
        let id = self.insert(t, Namespace.HTML)!;
        self.tz.state = state;
        self.orig = self.mode;
        self.mode = Mode.TEXT;
        self.text_elem = NONE;
        if self.opened(id) {
            self.text_elem = id;
        }
    }

    fn add_missing_attrs(self: *mut Parser, id: u32, t: *Token) !void {
        let n = self.nd(id);
        let mut all = vec.Vec.[Attr].init();
        defer all.deinit();
        all.extend(n.attrs)!;
        let extra = self.copy_attrs(t.attrs, Namespace.HTML)!;
        for a in extra {
            let mut have = false;
            for b in n.attrs {
                if strs.eq(a.name, b.name) and (b.ns == AttrNamespace.NONE) {
                    have = true;
                }
            }
            if not have {
                all.push(a)!;
            }
        }
        if all.len != n.attrs.len {
            self.nd(id).attrs = self.doc.arena.copy.[Attr](all.items())!;
        }
    }
}

fn fake_token(tag: u16) Token {
    return Token.{ kind: TokenKind.START, name: tags.TAG_NAMES[@as(usize, tag) - 1], tag: tag, attrs: no_attrs(),
                   self_closing: false, data: "", public_id: "", system_id: "", has_name: false, has_public: false,
                   has_system: false, force_quirks: false };
}

fn scope_foreign(n: *Node) bool {
    if n.ns == Namespace.MATHML {
        return (n.tag == tags.T_MI) or (n.tag == tags.T_MO) or (n.tag == tags.T_MN) or (n.tag == tags.T_MS) or
               (n.tag == tags.T_MTEXT) or (n.tag == tags.T_ANNOTATION_XML);
    }
    if n.ns == Namespace.SVG {
        return (n.tag == tags.T_FOREIGNOBJECT) or (n.tag == tags.T_DESC) or (n.tag == tags.T_TITLE);
    }
    return false;
}

fn foreign_attr(a: *mut Attr) void {
    let nm = a.name;
    if strs.starts_with(nm, "xlink:") {
        let local = nm[6..];
        for x in ["actuate", "arcrole", "href", "role", "show", "title", "type"] {
            if strs.eq(local, x) {
                a.ns = AttrNamespace.XLINK;
                a.prefix = "xlink";
                a.name = local;
                return;
            }
        }
        return;
    }
    if strs.eq(nm, "xml:lang") or strs.eq(nm, "xml:space") {
        a.ns = AttrNamespace.XML;
        a.prefix = "xml";
        a.name = nm[4..];
        return;
    }
    if strs.eq(nm, "xmlns") {
        a.ns = AttrNamespace.XMLNS;
        return;
    }
    if strs.eq(nm, "xmlns:xlink") {
        a.ns = AttrNamespace.XMLNS;
        a.prefix = "xmlns";
        a.name = nm[6..];
    }
}

