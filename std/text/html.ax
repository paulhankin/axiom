fn svg_tag_name(name: []u8) []u8 {
    for x in SVG_TAGS {
        if strs.eq_ignore_case(x, name) {
            return x;
        }
    }
    return name;
}

fn svg_attr_name(name: []u8) []u8 {
    for x in SVG_ATTRS {
        if strs.eq_ignore_case(x, name) {
            return x;
        }
    }
    return name;
}

fn leading_ws(s: []u8) usize {
    let mut k: usize = 0;
    while (k < s.len) and is_ws(s[k]) {
        k += 1;
    }
    return k;
}

fn all_ws(s: []u8) bool {
    return leading_ws(s) == s.len;
}

// -----------------------------------------------------------------------------
// Tree construction
// -----------------------------------------------------------------------------

fn is_start(t: *Token, tag: u16) bool {
    return (t.kind == TokenKind.START) and (t.tag == tag);
}

fn is_end(t: *Token, tag: u16) bool {
    return (t.kind == TokenKind.END) and (t.tag == tag);
}

fn tag_in(t: *Token, set: []u16) bool {
    if t.tag == 0 {
        return false;
    }
    for x in set {
        if x == t.tag {
            return true;
        }
    }
    return false;
}

// Runs the tree construction dispatcher for one token.
fn dispatch(p: *mut Parser, t0: Token) !void {
    let mut t = t0;
    loop {
        let mut again = false;
        if html_content(p, &t) {
            again = step(p, p.mode, &mut t)!;
        } else {
            again = foreign(p, &mut t)!;
        }
        if not again {
            return;
        }
    }
}

fn html_content(p: *mut Parser, t: *Token) bool {
    if p.stack.len == 0 {
        return true;
    }
    let a = p.adjusted_current();
    let n = p.nd(a);
    if (n.ns == Namespace.HTML) or (t.kind == TokenKind.EOF) {
        return true;
    }
    if p.mathml_text_ip(a) {
        if (t.kind == TokenKind.START) and (t.tag != tags.T_MGLYPH) and (t.tag != tags.T_MALIGNMARK) {
            return true;
        }
        if t.kind == TokenKind.CHARS {
            return true;
        }
    }
    if (n.ns == Namespace.MATHML) and (n.tag == tags.T_ANNOTATION_XML) and is_start(t, tags.T_SVG) {
        return true;
    }
    if p.html_ip(a) and ((t.kind == TokenKind.START) or (t.kind == TokenKind.CHARS)) {
        return true;
    }
    return false;
}

// Processes the token by the rules of an insertion mode: true to reprocess
// it (in p.mode).
fn step(p: *mut Parser, mode: Mode, t: *mut Token) !bool {
    if mode == Mode.IN_BODY {
        return in_body(p, t);
    }
    if mode == Mode.TEXT {
        return in_text(p, t);
    }
    if mode == Mode.IN_TABLE {
        return in_table(p, t);
    }
    if mode == Mode.IN_CELL {
        return in_cell(p, t);
    }
    if mode == Mode.IN_ROW {
        return in_row(p, t);
    }
    if mode == Mode.IN_TABLE_BODY {
        return in_table_body(p, t);
    }
    if mode == Mode.IN_TABLE_TEXT {
        return in_table_text(p, t);
    }
    if mode == Mode.IN_HEAD {
        return in_head(p, t);
    }
    if mode == Mode.INITIAL {
        return initial(p, t);
    }
    if mode == Mode.BEFORE_HTML {
        return before_html(p, t);
    }
    if mode == Mode.BEFORE_HEAD {
        return before_head(p, t);
    }
    if mode == Mode.IN_HEAD_NOSCRIPT {
        return in_head_noscript(p, t);
    }
    if mode == Mode.AFTER_HEAD {
        return after_head(p, t);
    }
    if mode == Mode.IN_CAPTION {
        return in_caption(p, t);
    }
    if mode == Mode.IN_COLUMN_GROUP {
        return in_column_group(p, t);
    }
    if mode == Mode.IN_TEMPLATE {
        return in_template(p, t);
    }
    if mode == Mode.AFTER_BODY {
        return after_body(p, t);
    }
    if mode == Mode.IN_FRAMESET {
        return in_frameset(p, t);
    }
    if mode == Mode.AFTER_FRAMESET {
        return after_frameset(p, t);
    }
    if mode == Mode.AFTER_AFTER_BODY {
        return after_after_body(p, t);
    }
    return after_after_frameset(p, t);
}

// What split_ws does with whitespace at the start of a character token.
enum Whitespace: u8 {
    INSERT,   // insert it
    DROP,     // drop it
    IN_BODY,  // process it as in_body does
}

// Handles whitespace at the start of a character token as `how` says; true
// if characters remain in t.
fn split_ws(p: *mut Parser, t: *mut Token, how: Whitespace) !bool {
    let k = leading_ws(t.data);
    if k > 0 {
        if how == Whitespace.INSERT {
            p.insert_text(t.data[..k])!;
        } else if how == Whitespace.IN_BODY {
            let mut w = t.*;
            w.data = t.data[..k];
            _ = in_body(p, &mut w)!;
        }
    }
    t.data = t.data[k..];
    return t.data.len > 0;
}

fn initial(p: *mut Parser, t: *mut Token) !bool {
    if t.kind == TokenKind.CHARS {
        if not split_ws(p, t, Whitespace.DROP)! {
            return false;
        }
    } else if t.kind == TokenKind.COMMENT {
        p.insert_comment(t, Loc.{ parent: 0, before: NONE })!;
        return false;
    } else if t.kind == TokenKind.DOCTYPE {
        let id = p.doc.new_node(Kind.DOCTYPE)!;
        let n = p.nd(id);
        n.name = p.doc.arena.dup(t.name)!;
        n.text = p.doc.arena.dup(t.public_id)!;
        n.system_id = p.doc.arena.dup(t.system_id)!;
        p.doc.append_child(0, id);
        p.doc.mode = doctype_mode(t);
        p.mode = Mode.BEFORE_HTML;
        return false;
    }
    p.doc.mode = QuirksMode.QUIRKS;
    p.mode = Mode.BEFORE_HTML;
    return true;
}

let QUIRKY_PUBLIC: [55][]u8 = [
    "+//silmaril//dtd html pro v0r11 19970101//",
    "-//as//dtd html 3.0 aswedit + extensions//",
    "-//advasoft ltd//dtd html 3.0 aswedit + extensions//",
    "-//ietf//dtd html 2.0 level 1//",
    "-//ietf//dtd html 2.0 level 2//",
    "-//ietf//dtd html 2.0 strict level 1//",
    "-//ietf//dtd html 2.0 strict level 2//",
    "-//ietf//dtd html 2.0 strict//",
    "-//ietf//dtd html 2.0//",
    "-//ietf//dtd html 2.1e//",
    "-//ietf//dtd html 3.0//",
    "-//ietf//dtd html 3.2 final//",
    "-//ietf//dtd html 3.2//",
    "-//ietf//dtd html 3//",
    "-//ietf//dtd html level 0//",
    "-//ietf//dtd html level 1//",
    "-//ietf//dtd html level 2//",
    "-//ietf//dtd html level 3//",
    "-//ietf//dtd html strict level 0//",
    "-//ietf//dtd html strict level 1//",
    "-//ietf//dtd html strict level 2//",
    "-//ietf//dtd html strict level 3//",
    "-//ietf//dtd html strict//",
    "-//ietf//dtd html//",
    "-//metrius//dtd metrius presentational//",
    "-//microsoft//dtd internet explorer 2.0 html strict//",
    "-//microsoft//dtd internet explorer 2.0 html//",
    "-//microsoft//dtd internet explorer 2.0 tables//",
    "-//microsoft//dtd internet explorer 3.0 html strict//",
    "-//microsoft//dtd internet explorer 3.0 html//",
    "-//microsoft//dtd internet explorer 3.0 tables//",
    "-//netscape comm. corp.//dtd html//",
    "-//netscape comm. corp.//dtd strict html//",
    "-//o'reilly and associates//dtd html 2.0//",
    "-//o'reilly and associates//dtd html extended 1.0//",
    "-//o'reilly and associates//dtd html extended relaxed 1.0//",
    "-//sq//dtd html 2.0 hotmetal + extensions//",
    "-//softquad software//dtd hotmetal pro 6.0::19990601::extensions to html 4.0//",
    "-//softquad//dtd hotmetal pro 4.0::19971010::extensions to html 4.0//",
    "-//spyglass//dtd html 2.0 extended//",
    "-//sun microsystems corp.//dtd hotjava html//",
    "-//sun microsystems corp.//dtd hotjava strict html//",
    "-//w3c//dtd html 3 1995-03-24//",
    "-//w3c//dtd html 3.2 draft//",
    "-//w3c//dtd html 3.2 final//",
    "-//w3c//dtd html 3.2//",
    "-//w3c//dtd html 3.2s draft//",
    "-//w3c//dtd html 4.0 frameset//",
    "-//w3c//dtd html 4.0 transitional//",
    "-//w3c//dtd html experimental 19960712//",
    "-//w3c//dtd html experimental 970421//",
    "-//w3c//dtd w3 html//",
    "-//w3o//dtd w3 html 3.0//",
    "-//webtechs//dtd mozilla html 2.0//",
    "-//webtechs//dtd mozilla html//",
];

fn starts_ci(s: []u8, prefix: []u8) bool {
    return (s.len >= prefix.len) and strs.eq_ignore_case(s[..prefix.len], prefix);
}

fn doctype_mode(t: *Token) QuirksMode {
    let pub_id = t.public_id;
    let sys = t.system_id;
    if t.force_quirks or not strs.eq(t.name, "html") {
        return QuirksMode.QUIRKS;
    }
    if t.has_public {
        if strs.eq_ignore_case(pub_id, "-//W3O//DTD W3 HTML Strict 3.0//EN//") or
           strs.eq_ignore_case(pub_id, "-/W3C/DTD HTML 4.0 Transitional/EN") or strs.eq_ignore_case(pub_id, "HTML") {
            return QuirksMode.QUIRKS;
        }
        for q in QUIRKY_PUBLIC {
            if starts_ci(pub_id, q) {
                return QuirksMode.QUIRKS;
            }
        }
    }
    if t.has_system and strs.eq_ignore_case(sys, "http://www.ibm.com/data/dtd/v11/ibmxhtml1-transitional.dtd") {
        return QuirksMode.QUIRKS;
    }
    let html401 = starts_ci(pub_id, "-//W3C//DTD HTML 4.01 Frameset//") or
                  starts_ci(pub_id, "-//W3C//DTD HTML 4.01 Transitional//");
    if t.has_public and html401 and not t.has_system {
        return QuirksMode.QUIRKS;
    }
    if t.has_public and
       (starts_ci(pub_id, "-//W3C//DTD XHTML 1.0 Frameset//") or
        starts_ci(pub_id, "-//W3C//DTD XHTML 1.0 Transitional//") or (html401 and t.has_system)) {
        return QuirksMode.LIMITED_QUIRKS;
    }
    return QuirksMode.NO_QUIRKS;
}

// An end tag the "before" modes treat as anything else.
fn end_hbhb(t: *Token) bool {
    return (t.kind == TokenKind.END) and
           ((t.tag == tags.T_HEAD) or (t.tag == tags.T_BODY) or (t.tag == tags.T_HTML) or (t.tag == tags.T_BR));
}

fn before_html(p: *mut Parser, t: *mut Token) !bool {
    if t.kind == TokenKind.DOCTYPE {
        return false;
    }
    if t.kind == TokenKind.COMMENT {
        p.insert_comment(t, Loc.{ parent: 0, before: NONE })!;
        return false;
    }
    if t.kind == TokenKind.CHARS {
        if not split_ws(p, t, Whitespace.DROP)! {
            return false;
        }
    }
    if is_start(t, tags.T_HTML) {
        let id = p.create_element(t, Namespace.HTML)!;
        p.doc.append_child(0, id);
        _ = p.push(id)!;
        p.mode = Mode.BEFORE_HEAD;
        return false;
    }
    if (t.kind == TokenKind.END) and not end_hbhb(t) {
        return false;
    }
    let mut h = fake_token(tags.T_HTML);
    let id = p.create_element(&mut h, Namespace.HTML)!;
    p.doc.append_child(0, id);
    _ = p.push(id)!;
    p.mode = Mode.BEFORE_HEAD;
    return true;
}

fn before_head(p: *mut Parser, t: *mut Token) !bool {
    if t.kind == TokenKind.CHARS {
        if not split_ws(p, t, Whitespace.DROP)! {
            return false;
        }
    } else if t.kind == TokenKind.COMMENT {
        p.insert_comment(t, p.place(NONE))!;
        return false;
    } else if t.kind == TokenKind.DOCTYPE {
        return false;
    } else if is_start(t, tags.T_HTML) {
        return in_body(p, t);
    } else if is_start(t, tags.T_HEAD) {
        p.head = p.insert(t, Namespace.HTML)!;
        p.mode = Mode.IN_HEAD;
        return false;
    } else if (t.kind == TokenKind.END) and not end_hbhb(t) {
        return false;
    }
    p.head = p.insert_fake(tags.T_HEAD)!;
    p.mode = Mode.IN_HEAD;
    return true;
}

fn in_head(p: *mut Parser, t: *mut Token) !bool {
    if t.kind == TokenKind.CHARS {
        if not split_ws(p, t, Whitespace.INSERT)! {
            return false;
        }
    } else if t.kind == TokenKind.COMMENT {
        p.insert_comment(t, p.place(NONE))!;
        return false;
    } else if t.kind == TokenKind.DOCTYPE {
        return false;
    } else if t.kind == TokenKind.START {
        let g = t.tag;
        if g == tags.T_HTML {
            return in_body(p, t);
        }
        if (g == tags.T_BASE) or (g == tags.T_BASEFONT) or (g == tags.T_BGSOUND) or (g == tags.T_LINK) or
           (g == tags.T_META) {
            _ = p.insert_void(t)!;
            return false;
        }
        if g == tags.T_TITLE {
            p.raw_text(t, State.RCDATA)!;
            return false;
        }
        if ((g == tags.T_NOSCRIPT) and p.scripting) or (g == tags.T_NOFRAMES) or (g == tags.T_STYLE) {
            p.raw_text(t, State.RAWTEXT)!;
            return false;
        }
        if g == tags.T_NOSCRIPT {
            _ = p.insert(t, Namespace.HTML)!;
            p.mode = Mode.IN_HEAD_NOSCRIPT;
            return false;
        }
        if g == tags.T_SCRIPT {
            p.raw_text(t, State.SCRIPT)!;
            return false;
        }
        if g == tags.T_TEMPLATE {
            let id = p.insert(t, Namespace.HTML)!;
            if not p.opened(id) {
                return false;
            }
            p.afe.push(MARKER)!;
            p.frameset_ok = false;
            p.mode = Mode.IN_TEMPLATE;
            p.tmodes.push(Mode.IN_TEMPLATE)!;
            return false;
        }
        if g == tags.T_HEAD {
            return false;
        }
    } else if t.kind == TokenKind.END {
        let g = t.tag;
        if g == tags.T_HEAD {
            p.pop();
            p.mode = Mode.AFTER_HEAD;
            return false;
        }
        if g == tags.T_TEMPLATE {
            if not p.has_template() {
                return false;
            }
            p.gen_thorough();
            p.pop_until(tags.T_TEMPLATE);
            p.afe_clear_to_marker();
            _ = p.tmodes.pop() catch Mode.IN_BODY;
            p.reset_mode();
            return false;
        }
        if (g != tags.T_BODY) and (g != tags.T_HTML) and (g != tags.T_BR) {
            return false;
        }
    }
    p.pop();
    p.mode = Mode.AFTER_HEAD;
    return true;
}

fn in_head_noscript(p: *mut Parser, t: *mut Token) !bool {
    if t.kind == TokenKind.DOCTYPE {
        return false;
    }
    if is_start(t, tags.T_HTML) {
        return in_body(p, t);
    }
    if is_end(t, tags.T_NOSCRIPT) {
        p.pop();
        p.mode = Mode.IN_HEAD;
        return false;
    }
    if t.kind == TokenKind.CHARS {
        if not split_ws(p, t, Whitespace.INSERT)! {
            return false;
        }
    } else if t.kind == TokenKind.COMMENT {
        return in_head(p, t);
    } else if t.kind == TokenKind.START {
        let g = t.tag;
        if (g == tags.T_BASEFONT) or (g == tags.T_BGSOUND) or (g == tags.T_LINK) or (g == tags.T_META) or
           (g == tags.T_NOFRAMES) or (g == tags.T_STYLE) {
            return in_head(p, t);
        }
        if (g == tags.T_HEAD) or (g == tags.T_NOSCRIPT) {
            return false;
        }
    } else if (t.kind == TokenKind.END) and (t.tag != tags.T_BR) {
        return false;
    }
    p.pop();
    p.mode = Mode.IN_HEAD;
    return true;
}

fn after_head(p: *mut Parser, t: *mut Token) !bool {
    if t.kind == TokenKind.CHARS {
        if not split_ws(p, t, Whitespace.INSERT)! {
            return false;
        }
    } else if t.kind == TokenKind.COMMENT {
        p.insert_comment(t, p.place(NONE))!;
        return false;
    } else if t.kind == TokenKind.DOCTYPE {
        return false;
    } else if t.kind == TokenKind.START {
        let g = t.tag;
        if g == tags.T_HTML {
            return in_body(p, t);
        }
        if g == tags.T_BODY {
            _ = p.insert(t, Namespace.HTML)!;
            p.frameset_ok = false;
            p.mode = Mode.IN_BODY;
            return false;
        }
        if g == tags.T_FRAMESET {
            _ = p.insert(t, Namespace.HTML)!;
            p.mode = Mode.IN_FRAMESET;
            return false;
        }
        if (g == tags.T_BASE) or (g == tags.T_BASEFONT) or (g == tags.T_BGSOUND) or (g == tags.T_LINK) or
           (g == tags.T_META) or (g == tags.T_NOFRAMES) or (g == tags.T_SCRIPT) or (g == tags.T_STYLE) or
           (g == tags.T_TEMPLATE) or (g == tags.T_TITLE) {
            let h = p.head;
            if (h == NONE) or not p.push(h)! {
                return in_head(p, t);
            }
            let r = in_head(p, t)!;
            p.stack_remove(h);
            return r;
        }
        if g == tags.T_HEAD {
            return false;
        }
    } else if t.kind == TokenKind.END {
        if t.tag == tags.T_TEMPLATE {
            return in_head(p, t);
        }
        if (t.tag != tags.T_BODY) and (t.tag != tags.T_HTML) and (t.tag != tags.T_BR) {
            return false;
        }
    }
    _ = p.insert_fake(tags.T_BODY)!;
    p.frameset_ok = true;
    p.mode = Mode.IN_BODY;
    return true;
}

let CLOSES_P: [25]u16 = [
    tags.T_ADDRESS,
    tags.T_ARTICLE,
    tags.T_ASIDE,
    tags.T_BLOCKQUOTE,
    tags.T_CENTER,
    tags.T_DETAILS,
    tags.T_DIALOG,
    tags.T_DIR,
    tags.T_DIV,
    tags.T_DL,
    tags.T_FIELDSET,
    tags.T_FIGCAPTION,
    tags.T_FIGURE,
    tags.T_FOOTER,
    tags.T_HEADER,
    tags.T_HGROUP,
    tags.T_MAIN,
    tags.T_MENU,
    tags.T_NAV,
    tags.T_OL,
    tags.T_P,
    tags.T_SEARCH,
    tags.T_SECTION,
    tags.T_SUMMARY,
    tags.T_UL,
];

let BLOCK_ENDS: [28]u16 = [
    tags.T_ADDRESS,
    tags.T_ARTICLE,
    tags.T_ASIDE,
    tags.T_BLOCKQUOTE,
    tags.T_BUTTON,
    tags.T_CENTER,
    tags.T_DETAILS,
    tags.T_DIALOG,
    tags.T_DIR,
    tags.T_DIV,
    tags.T_DL,
    tags.T_FIELDSET,
    tags.T_FIGCAPTION,
    tags.T_FIGURE,
    tags.T_FOOTER,
    tags.T_HEADER,
    tags.T_HGROUP,
    tags.T_LISTING,
    tags.T_MAIN,
    tags.T_MENU,
    tags.T_NAV,
    tags.T_OL,
    tags.T_PRE,
    tags.T_SEARCH,
    tags.T_SECTION,
    tags.T_SELECT,
    tags.T_SUMMARY,
    tags.T_UL,
];

let FORMATTING: [12]u16 = [tags.T_B, tags.T_BIG, tags.T_CODE, tags.T_EM, tags.T_FONT, tags.T_I, tags.T_S, tags.T_SMALL,
                           tags.T_STRIKE, tags.T_STRONG, tags.T_TT, tags.T_U];

let FORMATTING_ENDS: [14]u16 = [
    tags.T_A,
    tags.T_B,
    tags.T_BIG,
    tags.T_CODE,
    tags.T_EM,
    tags.T_FONT,
    tags.T_I,
    tags.T_NOBR,
    tags.T_S,
    tags.T_SMALL,
    tags.T_STRIKE,
    tags.T_STRONG,
    tags.T_TT,
    tags.T_U,
];

let HEAD_TAGS: [10]u16 = [tags.T_BASE, tags.T_BASEFONT, tags.T_BGSOUND, tags.T_LINK, tags.T_META, tags.T_NOFRAMES,
                          tags.T_SCRIPT, tags.T_STYLE, tags.T_TEMPLATE, tags.T_TITLE];

let TABLE_PARTS: [11]u16 = [tags.T_CAPTION, tags.T_COL, tags.T_COLGROUP, tags.T_FRAME, tags.T_HEAD, tags.T_TBODY,
                            tags.T_TD, tags.T_TFOOT, tags.T_TH, tags.T_THEAD, tags.T_TR];

fn in_body_chars(p: *mut Parser, data: []u8) !void {
    let mut s = data;
    if (strs.index_of_byte(data, 0) catch NONE_USIZE) != NONE_USIZE {
        p.sbuf.clear();
        for c in data {
            if c != 0 {
                p.sbuf.push(c)!;
            }
        }
        s = p.sbuf.bytes();
    }
    if s.len == 0 {
        return;
    }
    p.reconstruct()!;
    p.insert_text(s)!;
    if not all_ws(s) {
        p.frameset_ok = false;
    }
}

fn in_body(p: *mut Parser, t: *mut Token) !bool {
    let k = t.kind;
    if k == TokenKind.CHARS {
        in_body_chars(p, t.data)!;
        return false;
    }
    if k == TokenKind.START {
        return in_body_start(p, t);
    }
    if k == TokenKind.END {
        return in_body_end(p, t);
    }
    if k == TokenKind.COMMENT {
        p.insert_comment(t, p.place(NONE))!;
        return false;
    }
    if k == TokenKind.EOF {
        if p.tmodes.len > 0 {
            return in_template(p, t);
        }
    }
    return false;
}

fn in_body_start(p: *mut Parser, t: *mut Token) !bool {
    let g = t.tag;
    if g == 0 {
        p.reconstruct()!;
        _ = p.insert(t, Namespace.HTML)!;
        return false;
    }
    if tag_in(t, FORMATTING[..]) {
        p.reconstruct()!;
        let id = p.insert(t, Namespace.HTML)!;
        p.afe_push(id)!;
        return false;
    }
    if tag_in(t, CLOSES_P[..]) {
        p.close_p_in_button_scope();
        _ = p.insert(t, Namespace.HTML)!;
        return false;
    }
    if g == tags.T_HTML {
        if not p.has_template() {
            p.add_missing_attrs(p.stack.items()[0], t)!;
        }
        return false;
    }
    if tag_in(t, HEAD_TAGS[..]) {
        return in_head(p, t);
    }
    if g == tags.T_BODY {
        if (p.stack.len == 1) or not p.is(p.stack.items()[1], tags.T_BODY) or p.has_template() {
            return false;
        }
        p.frameset_ok = false;
        p.add_missing_attrs(p.stack.items()[1], t)!;
        return false;
    }
    if g == tags.T_FRAMESET {
        if (p.stack.len == 1) or not p.is(p.stack.items()[1], tags.T_BODY) or not p.frameset_ok {
            return false;
        }
        p.doc.remove(p.stack.items()[1]);
        p.pop_to(1);
        _ = p.insert(t, Namespace.HTML)!;
        p.mode = Mode.IN_FRAMESET;
        return false;
    }
    if (g >= tags.T_H1) and (g <= tags.T_H6) {
        p.close_p_in_button_scope();
        let c = p.nd(p.cur());
        if (c.ns == Namespace.HTML) and (c.tag >= tags.T_H1) and (c.tag <= tags.T_H6) {
            p.pop();
        }
        _ = p.insert(t, Namespace.HTML)!;
        return false;
    }
    if (g == tags.T_PRE) or (g == tags.T_LISTING) {
        p.close_p_in_button_scope();
        _ = p.insert(t, Namespace.HTML)!;
        p.skip_lf = true;
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_FORM {
        let tpl = p.has_template();
        if (p.form != NONE) and not tpl {
            return false;
        }
        p.close_p_in_button_scope();
        let id = p.insert(t, Namespace.HTML)!;
        if not tpl {
            p.form = id;
        }
        return false;
    }
    if (g == tags.T_LI) or (g == tags.T_DD) or (g == tags.T_DT) {
        p.frameset_ok = false;
        let mut i = p.stack.len;
        while i > 0 {
            i -= 1;
            let id = p.stack.items()[i];
            let n = p.nd(id);
            let mut hit: u16 = 0;
            if (g == tags.T_LI) and p.is(id, tags.T_LI) {
                hit = tags.T_LI;
            } else if (g != tags.T_LI) and (p.is(id, tags.T_DD) or p.is(id, tags.T_DT)) {
                hit = n.tag;
            }
            if hit != 0 {
                p.gen_implied(hit);
                p.pop_until(hit);
                break;
            }
            if p.special(id) and not p.is(id, tags.T_ADDRESS) and not p.is(id, tags.T_DIV) and not p.is(id, tags.T_P) {
                break;
            }
        }
        p.close_p_in_button_scope();
        _ = p.insert(t, Namespace.HTML)!;
        return false;
    }
    if g == tags.T_PLAINTEXT {
        p.close_p_in_button_scope();
        _ = p.insert(t, Namespace.HTML)!;
        p.tz.state = State.PLAINTEXT;
        return false;
    }
    if g == tags.T_BUTTON {
        if p.in_scope(tags.T_BUTTON, Scope.DEFAULT) {
            p.gen_implied(0);
            p.pop_until(tags.T_BUTTON);
        }
        p.reconstruct()!;
        _ = p.insert(t, Namespace.HTML)!;
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_A {
        let items = p.afe.items();
        let mut i = items.len;
        let mut old = NONE;
        while i > 0 {
            i -= 1;
            if items[i] == MARKER {
                break;
            }
            if p.is(items[i], tags.T_A) {
                old = items[i];
                break;
            }
        }
        if old != NONE {
            if not adoption(p, t)! {
                any_other_end(p, t);
            }
            p.afe_remove(old);
            p.stack_remove(old);
        }
        p.reconstruct()!;
        let id = p.insert(t, Namespace.HTML)!;
        p.afe_push(id)!;
        return false;
    }
    if g == tags.T_NOBR {
        p.reconstruct()!;
        if p.in_scope(tags.T_NOBR, Scope.DEFAULT) {
            if not adoption(p, t)! {
                any_other_end(p, t);
            }
            p.reconstruct()!;
        }
        let id = p.insert(t, Namespace.HTML)!;
        p.afe_push(id)!;
        return false;
    }
    if (g == tags.T_APPLET) or (g == tags.T_MARQUEE) or (g == tags.T_OBJECT) {
        p.reconstruct()!;
        let id = p.insert(t, Namespace.HTML)!;
        if p.opened(id) {
            p.afe.push(MARKER)!;
        }
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_TABLE {
        if p.doc.mode != QuirksMode.QUIRKS {
            p.close_p_in_button_scope();
        }
        _ = p.insert(t, Namespace.HTML)!;
        p.frameset_ok = false;
        p.mode = Mode.IN_TABLE;
        return false;
    }
    if (g == tags.T_AREA) or (g == tags.T_BR) or (g == tags.T_EMBED) or (g == tags.T_IMG) or (g == tags.T_KEYGEN) or
       (g == tags.T_WBR) {
        p.reconstruct()!;
        _ = p.insert_void(t)!;
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_INPUT {
        if p.is(p.context, tags.T_SELECT) {
            return false;
        }
        if p.in_scope(tags.T_SELECT, Scope.DEFAULT) {
            p.pop_until(tags.T_SELECT);
        }
        p.reconstruct()!;
        _ = p.insert_void(t)!;
        if not is_hidden_input(t) {
            p.frameset_ok = false;
        }
        return false;
    }
    if (g == tags.T_PARAM) or (g == tags.T_SOURCE) or (g == tags.T_TRACK) {
        _ = p.insert_void(t)!;
        return false;
    }
    if g == tags.T_HR {
        p.close_p_in_button_scope();
        if p.in_scope(tags.T_SELECT, Scope.DEFAULT) {
            p.gen_implied(0);
        }
        _ = p.insert_void(t)!;
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_IMAGE {
        t.name = "img";
        t.tag = tags.T_IMG;
        return true;
    }
    if g == tags.T_TEXTAREA {
        p.raw_text(t, State.RCDATA)!;
        p.skip_lf = true;
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_XMP {
        p.close_p_in_button_scope();
        p.reconstruct()!;
        p.frameset_ok = false;
        p.raw_text(t, State.RAWTEXT)!;
        return false;
    }
    if g == tags.T_IFRAME {
        p.frameset_ok = false;
        p.raw_text(t, State.RAWTEXT)!;
        return false;
    }
    if (g == tags.T_NOEMBED) or ((g == tags.T_NOSCRIPT) and p.scripting) {
        p.raw_text(t, State.RAWTEXT)!;
        return false;
    }
    if g == tags.T_SELECT {
        if p.is(p.context, tags.T_SELECT) {
            return false;
        }
        if p.in_scope(tags.T_SELECT, Scope.DEFAULT) {
            p.pop_until(tags.T_SELECT);
            return false;
        }
        p.reconstruct()!;
        _ = p.insert(t, Namespace.HTML)!;
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_OPTION {
        if p.in_scope(tags.T_SELECT, Scope.DEFAULT) {
            p.gen_implied(tags.T_OPTGROUP);
        } else if p.cur_is(tags.T_OPTION) {
            p.pop();
        }
        p.reconstruct()!;
        _ = p.insert(t, Namespace.HTML)!;
        return false;
    }
    if g == tags.T_OPTGROUP {
        if p.in_scope(tags.T_SELECT, Scope.DEFAULT) {
            p.gen_implied(0);
        } else if p.cur_is(tags.T_OPTION) {
            p.pop();
        }
        p.reconstruct()!;
        _ = p.insert(t, Namespace.HTML)!;
        return false;
    }
    if (g == tags.T_RB) or (g == tags.T_RTC) {
        if p.in_scope(tags.T_RUBY, Scope.DEFAULT) {
            p.gen_implied(0);
        }
        _ = p.insert(t, Namespace.HTML)!;
        return false;
    }
    if (g == tags.T_RP) or (g == tags.T_RT) {
        if p.in_scope(tags.T_RUBY, Scope.DEFAULT) {
            p.gen_implied(tags.T_RTC);
        }
        _ = p.insert(t, Namespace.HTML)!;
        return false;
    }
    if (g == tags.T_MATH) or (g == tags.T_SVG) {
        p.reconstruct()!;
        let mut ns = Namespace.MATHML;
        if g == tags.T_SVG {
            ns = Namespace.SVG;
        }
        let id = p.insert(t, ns)!;
        if t.self_closing and p.opened(id) {
            p.pop();
        }
        return false;
    }
    if tag_in(t, TABLE_PARTS[..]) {
        return false;
    }
    p.reconstruct()!;
    _ = p.insert(t, Namespace.HTML)!;
    return false;
}

fn is_hidden_input(t: *Token) bool {
    for a in t.attrs {
        if strs.eq(a.name, "type") {
            return strs.eq_ignore_case(a.value, "hidden");
        }
    }
    return false;
}

fn in_body_end(p: *mut Parser, t: *mut Token) !bool {
    let g = t.tag;
    if g == 0 {
        any_other_end(p, t);
        return false;
    }
    if tag_in(t, FORMATTING_ENDS[..]) {
        if not adoption(p, t)! {
            any_other_end(p, t);
        }
        return false;
    }
    if tag_in(t, BLOCK_ENDS[..]) {
        if not p.in_scope(g, Scope.DEFAULT) {
            return false;
        }
        p.gen_implied(0);
        p.pop_until(g);
        return false;
    }
    if g == tags.T_TEMPLATE {
        return in_head(p, t);
    }
    if (g == tags.T_BODY) or (g == tags.T_HTML) {
        if not p.in_scope(tags.T_BODY, Scope.DEFAULT) {
            return false;
        }
        p.mode = Mode.AFTER_BODY;
        return g == tags.T_HTML;
    }
    if g == tags.T_FORM {
        if not p.has_template() {
            let node = p.form;
            p.form = NONE;
            if (node == NONE) or not p.node_in_scope(node) {
                return false;
            }
            p.gen_implied(0);
            p.stack_remove(node);
        } else {
            if not p.in_scope(tags.T_FORM, Scope.DEFAULT) {
                return false;
            }
            p.gen_implied(0);
            p.pop_until(tags.T_FORM);
        }
        return false;
    }
    if g == tags.T_P {
        if not p.in_scope(tags.T_P, Scope.BUTTON) {
            _ = p.insert_fake(tags.T_P)!;
        }
        p.close_p();
        return false;
    }
    if g == tags.T_LI {
        if not p.in_scope(tags.T_LI, Scope.LIST) {
            return false;
        }
        p.gen_implied(tags.T_LI);
        p.pop_until(tags.T_LI);
        return false;
    }
    if (g == tags.T_DD) or (g == tags.T_DT) {
        if not p.in_scope(g, Scope.DEFAULT) {
            return false;
        }
        p.gen_implied(g);
        p.pop_until(g);
        return false;
    }
    if (g >= tags.T_H1) and (g <= tags.T_H6) {
        if not p.heading_in_scope() {
            return false;
        }
        p.gen_implied(0);
        while p.stack.len > 1 {
            let n = p.nd(p.cur());
            let h = (n.ns == Namespace.HTML) and (n.tag >= tags.T_H1) and (n.tag <= tags.T_H6);
            p.pop();
            if h {
                break;
            }
        }
        return false;
    }
    if (g == tags.T_APPLET) or (g == tags.T_MARQUEE) or (g == tags.T_OBJECT) {
        if not p.in_scope(g, Scope.DEFAULT) {
            return false;
        }
        p.gen_implied(0);
        p.pop_until(g);
        p.afe_clear_to_marker();
        return false;
    }
    if g == tags.T_BR {
        let mut b = fake_token(tags.T_BR);
        p.reconstruct()!;
        _ = p.insert_void(&mut b)!;
        p.frameset_ok = false;
        return false;
    }
    any_other_end(p, t);
    return false;
}

fn same_name(n: *Node, t: *Token) bool {
    return (n.kind == Kind.ELEMENT) and (n.ns == Namespace.HTML) and (n.tag == t.tag) and
           ((t.tag != 0) or strs.eq(n.name, t.name));
}

fn any_other_end(p: *mut Parser, t: *Token) void {
    let mut i = p.stack.len;
    while i > 1 {
        i -= 1;
        let id = p.stack.items()[i];
        if same_name(p.nd(id), t) {
            p.gen_implied(t.tag);
            p.pop_until_node(id);
            return;
        }
        if p.special(id) {
            return;
        }
    }
}

// The adoption agency algorithm: false when the caller should act as for
// "any other end tag".
fn adoption(p: *mut Parser, t: *Token) !bool {
    let subject = t.tag;
    let c = p.cur();
    if p.is(c, subject) and ((p.nd(c).flags & FL_AFE) == 0) {
        p.pop();
        return true;
    }
    let mut outer: u32 = 0;
    while outer < 8 {
        outer += 1;
        // the formatting element
        let mut fi = p.afe.len;
        let mut fe = NONE;
        while fi > 0 {
            fi -= 1;
            let e = p.afe.items()[fi];
            if e == MARKER {
                break;
            }
            if p.is(e, subject) {
                fe = e;
                break;
            }
        }
        if fe == NONE {
            return false;
        }
        if not p.opened(fe) {
            p.afe_remove_at(fi);
            return true;
        }
        if not p.node_in_scope(fe) {
            return true;
        }
        // the furthest block
        let si = p.stack_index(fe);
        let mut fb = NONE;
        let mut fbi = si + 1;
        while fbi < p.stack.len {
            if p.special(p.stack.items()[fbi]) {
                fb = p.stack.items()[fbi];
                break;
            }
            fbi += 1;
        }
        if fb == NONE {
            p.pop_to(si);
            p.afe_remove(fe);
            return true;
        }
        let ca = p.stack.items()[si - 1];
        let mut bookmark = fi;
        let mut ni = fbi;
        let mut last = fb;
        let mut inner: u32 = 0;
        loop {
            inner += 1;
            ni -= 1;
            let node = p.stack.items()[ni];
            if node == fe {
                break;
            }
            let mut ai = p.afe_index(node);
            if (inner > 3) and (ai != NONE_USIZE) {
                p.afe_remove_at(ai);
                if ai < bookmark {
                    bookmark -= 1;
                }
                ai = NONE_USIZE;
            }
            if ai == NONE_USIZE {
                _ = p.stack.remove(ni);
                p.closed_at(node);
                continue;
            }
            let e = p.clone_element(node)!;
            p.afe.items()[ai] = e;
            p.stack.items()[ni] = e;
            p.closed_at(node);
            p.nd(node).flags &= ~FL_AFE;
            p.opened_at(e);
            p.nd(e).flags |= FL_AFE;
            if last == fb {
                bookmark = ai + 1;
            }
            p.doc.remove(last);
            p.doc.append_child(e, last);
            last = e;
        }
        p.doc.remove(last);
        p.insert_node(p.place(ca), last);
        let e = p.clone_element(fe)!;
        // the furthest block's children move into the new element
        loop {
            let ch = p.nd(fb).first;
            if ch == NONE {
                break;
            }
            p.doc.remove(ch);
            p.doc.append_child(e, ch);
        }
        p.doc.append_child(fb, e);
        let fi2 = p.afe_index(fe);
        p.afe_remove_at(fi2);
        if fi2 < bookmark {
            bookmark -= 1;
        }
        p.afe.insert(@min(bookmark, p.afe.len), e)!;
        p.nd(e).flags |= FL_AFE;
        p.stack_remove(fe);
        let at = p.stack_index(fb);
        p.stack.insert(at + 1, e)!;
        p.opened_at(e);
    }
    return true;
}

fn in_text(p: *mut Parser, t: *mut Token) !bool {
    if t.kind == TokenKind.CHARS {
        p.insert_text(t.data)!;
        return false;
    }
    if (t.kind == TokenKind.EOF) or (t.kind == TokenKind.END) {
        if (p.text_elem != NONE) and (p.cur() == p.text_elem) {
            p.pop();
        }
        p.text_elem = NONE;
        p.mode = p.orig;
        return t.kind == TokenKind.EOF;
    }
    return false;
}

fn cur_is_table_ish(p: *mut Parser) bool {
    let c = p.cur();
    return p.is(c, tags.T_TABLE) or p.is(c, tags.T_TBODY) or p.is(c, tags.T_TEMPLATE) or p.is(c, tags.T_TFOOT) or
           p.is(c, tags.T_THEAD) or p.is(c, tags.T_TR);
}

fn in_table(p: *mut Parser, t: *mut Token) !bool {
    let k = t.kind;
    if (k == TokenKind.CHARS) and cur_is_table_ish(p) {
        p.pend.clear();
        p.pend_text = false;
        p.orig = p.mode;
        p.mode = Mode.IN_TABLE_TEXT;
        return true;
    }
    if k == TokenKind.COMMENT {
        p.insert_comment(t, p.place(NONE))!;
        return false;
    }
    if k == TokenKind.DOCTYPE {
        return false;
    }
    if k == TokenKind.START {
        let g = t.tag;
        if g == tags.T_CAPTION {
            p.clear_to(tags.T_TABLE, tags.T_TABLE, tags.T_TABLE);
            p.afe.push(MARKER)!;
            _ = p.insert(t, Namespace.HTML)!;
            p.mode = Mode.IN_CAPTION;
            return false;
        }
        if g == tags.T_COLGROUP {
            p.clear_to(tags.T_TABLE, tags.T_TABLE, tags.T_TABLE);
            _ = p.insert(t, Namespace.HTML)!;
            p.mode = Mode.IN_COLUMN_GROUP;
            return false;
        }
        if g == tags.T_COL {
            p.clear_to(tags.T_TABLE, tags.T_TABLE, tags.T_TABLE);
            _ = p.insert_fake(tags.T_COLGROUP)!;
            p.mode = Mode.IN_COLUMN_GROUP;
            return true;
        }
        if (g == tags.T_TBODY) or (g == tags.T_TFOOT) or (g == tags.T_THEAD) {
            p.clear_to(tags.T_TABLE, tags.T_TABLE, tags.T_TABLE);
            _ = p.insert(t, Namespace.HTML)!;
            p.mode = Mode.IN_TABLE_BODY;
            return false;
        }
        if (g == tags.T_TD) or (g == tags.T_TH) or (g == tags.T_TR) {
            p.clear_to(tags.T_TABLE, tags.T_TABLE, tags.T_TABLE);
            _ = p.insert_fake(tags.T_TBODY)!;
            p.mode = Mode.IN_TABLE_BODY;
            return true;
        }
        if g == tags.T_TABLE {
            if not p.in_scope(tags.T_TABLE, Scope.TABLE) {
                return false;
            }
            p.pop_until(tags.T_TABLE);
            p.reset_mode();
            return true;
        }
        if (g == tags.T_STYLE) or (g == tags.T_SCRIPT) or (g == tags.T_TEMPLATE) {
            return in_head(p, t);
        }
        if (g == tags.T_INPUT) and is_hidden_input(t) {
            _ = p.insert_void(t)!;
            return false;
        }
        if g == tags.T_FORM {
            if (p.form != NONE) and not p.in_template_contents() {
                return false;
            }
            let id = p.insert_void(t)!;
            if not p.in_template_contents() {
                p.form = id;
            }
            return false;
        }
    } else if k == TokenKind.END {
        let g = t.tag;
        if g == tags.T_TABLE {
            if not p.in_scope(tags.T_TABLE, Scope.TABLE) {
                return false;
            }
            p.pop_until(tags.T_TABLE);
            p.reset_mode();
            return false;
        }
        if (g == tags.T_BODY) or (g == tags.T_CAPTION) or (g == tags.T_COL) or (g == tags.T_COLGROUP) or
           (g == tags.T_HTML) or (g == tags.T_TBODY) or (g == tags.T_TD) or (g == tags.T_TFOOT) or (g == tags.T_TH) or
           (g == tags.T_THEAD) or (g == tags.T_TR) {
            return false;
        }
        if g == tags.T_TEMPLATE {
            return in_head(p, t);
        }
    } else if k == TokenKind.EOF {
        return in_body(p, t);
    }
    p.foster = true;
    let r = in_body(p, t);
    p.foster = false;
    return r;
}

fn in_table_text(p: *mut Parser, t: *mut Token) !bool {
    if t.kind == TokenKind.CHARS {
        for c in t.data {
            if c == 0 {
                continue;
            }
            p.pend.push(c)!;
            if not is_ws(c) {
                p.pend_text = true;
            }
        }
        return false;
    }
    if p.pend_text {
        p.foster = true;
        let r = in_body_chars(p, p.pend.bytes());
        p.foster = false;
        r!;
    } else {
        p.insert_text(p.pend.bytes())!;
    }
    p.pend.clear();
    p.mode = p.orig;
    return true;
}

fn close_caption(p: *mut Parser) bool {
    if not p.in_scope(tags.T_CAPTION, Scope.TABLE) {
        return false;
    }
    p.gen_implied(0);
    p.pop_until(tags.T_CAPTION);
    p.afe_clear_to_marker();
    p.mode = Mode.IN_TABLE;
    return true;
}

fn in_caption(p: *mut Parser, t: *mut Token) !bool {
    let g = t.tag;
    if is_end(t, tags.T_CAPTION) {
        _ = close_caption(p);
        return false;
    }
    if ((t.kind == TokenKind.START) and
        ((g == tags.T_CAPTION) or (g == tags.T_COL) or (g == tags.T_COLGROUP) or (g == tags.T_TBODY) or
         (g == tags.T_TD) or (g == tags.T_TFOOT) or (g == tags.T_TH) or (g == tags.T_THEAD) or (g == tags.T_TR))) or
       is_end(t, tags.T_TABLE) {
        return close_caption(p);
    }
    if (t.kind == TokenKind.END) and
       ((g == tags.T_BODY) or (g == tags.T_COL) or (g == tags.T_COLGROUP) or (g == tags.T_HTML) or
        (g == tags.T_TBODY) or (g == tags.T_TD) or (g == tags.T_TFOOT) or (g == tags.T_TH) or (g == tags.T_THEAD) or
        (g == tags.T_TR)) {
        return false;
    }
    return in_body(p, t);
}

fn in_column_group(p: *mut Parser, t: *mut Token) !bool {
    let k = t.kind;
    if k == TokenKind.CHARS {
        if not split_ws(p, t, Whitespace.INSERT)! {
            return false;
        }
    } else if k == TokenKind.COMMENT {
        p.insert_comment(t, p.place(NONE))!;
        return false;
    } else if k == TokenKind.DOCTYPE {
        return false;
    } else if is_start(t, tags.T_HTML) {
        return in_body(p, t);
    } else if is_start(t, tags.T_COL) {
        _ = p.insert_void(t)!;
        return false;
    } else if is_end(t, tags.T_COLGROUP) {
        if p.cur_is(tags.T_COLGROUP) {
            p.pop();
            p.mode = Mode.IN_TABLE;
        }
        return false;
    } else if is_end(t, tags.T_COL) {
        return false;
    } else if is_start(t, tags.T_TEMPLATE) or is_end(t, tags.T_TEMPLATE) {
        return in_head(p, t);
    } else if k == TokenKind.EOF {
        return in_body(p, t);
    }
    if not p.cur_is(tags.T_COLGROUP) {
        return false;
    }
    p.pop();
    p.mode = Mode.IN_TABLE;
    return true;
}

fn in_table_body(p: *mut Parser, t: *mut Token) !bool {
    let g = t.tag;
    if t.kind == TokenKind.START {
        if g == tags.T_TR {
            p.clear_to(tags.T_TBODY, tags.T_TFOOT, tags.T_THEAD);
            _ = p.insert(t, Namespace.HTML)!;
            p.mode = Mode.IN_ROW;
            return false;
        }
        if (g == tags.T_TH) or (g == tags.T_TD) {
            p.clear_to(tags.T_TBODY, tags.T_TFOOT, tags.T_THEAD);
            _ = p.insert_fake(tags.T_TR)!;
            p.mode = Mode.IN_ROW;
            return true;
        }
        if (g == tags.T_CAPTION) or (g == tags.T_COL) or (g == tags.T_COLGROUP) or (g == tags.T_TBODY) or
           (g == tags.T_TFOOT) or (g == tags.T_THEAD) {
            return leave_table_body(p);
        }
    } else if t.kind == TokenKind.END {
        if (g == tags.T_TBODY) or (g == tags.T_TFOOT) or (g == tags.T_THEAD) {
            if not p.in_scope(g, Scope.TABLE) {
                return false;
            }
            p.clear_to(tags.T_TBODY, tags.T_TFOOT, tags.T_THEAD);
            p.pop();
            p.mode = Mode.IN_TABLE;
            return false;
        }
        if g == tags.T_TABLE {
            return leave_table_body(p);
        }
        if (g == tags.T_BODY) or (g == tags.T_CAPTION) or (g == tags.T_COL) or (g == tags.T_COLGROUP) or
           (g == tags.T_HTML) or (g == tags.T_TD) or (g == tags.T_TH) or (g == tags.T_TR) {
            return false;
        }
    }
    return in_table(p, t);
}

fn leave_table_body(p: *mut Parser) bool {
    if not (p.in_scope(tags.T_TBODY, Scope.TABLE) or p.in_scope(tags.T_THEAD, Scope.TABLE) or
            p.in_scope(tags.T_TFOOT, Scope.TABLE)) {
        return false;
    }
    p.clear_to(tags.T_TBODY, tags.T_TFOOT, tags.T_THEAD);
    p.pop();
    p.mode = Mode.IN_TABLE;
    return true;
}

fn leave_row(p: *mut Parser) bool {
    if not p.in_scope(tags.T_TR, Scope.TABLE) {
        return false;
    }
    p.clear_to(tags.T_TR, tags.T_TR, tags.T_TR);
    p.pop();
    p.mode = Mode.IN_TABLE_BODY;
    return true;
}

fn in_row(p: *mut Parser, t: *mut Token) !bool {
    let g = t.tag;
    if t.kind == TokenKind.START {
        if (g == tags.T_TH) or (g == tags.T_TD) {
            p.clear_to(tags.T_TR, tags.T_TR, tags.T_TR);
            let id = p.insert(t, Namespace.HTML)!;
            p.mode = Mode.IN_CELL;
            if p.opened(id) {
                p.afe.push(MARKER)!;
            }
            return false;
        }
        if (g == tags.T_CAPTION) or (g == tags.T_COL) or (g == tags.T_COLGROUP) or (g == tags.T_TBODY) or
           (g == tags.T_TFOOT) or (g == tags.T_THEAD) or (g == tags.T_TR) {
            return leave_row(p);
        }
    } else if t.kind == TokenKind.END {
        if g == tags.T_TR {
            _ = leave_row(p);
            return false;
        }
        if g == tags.T_TABLE {
            return leave_row(p);
        }
        if (g == tags.T_TBODY) or (g == tags.T_TFOOT) or (g == tags.T_THEAD) {
            if not p.in_scope(g, Scope.TABLE) {
                return false;
            }
            return leave_row(p);
        }
        if (g == tags.T_BODY) or (g == tags.T_CAPTION) or (g == tags.T_COL) or (g == tags.T_COLGROUP) or
           (g == tags.T_HTML) or (g == tags.T_TD) or (g == tags.T_TH) {
            return false;
        }
    }
    return in_table(p, t);
}

fn close_cell(p: *mut Parser) void {
    p.gen_implied(0);
    while p.stack.len > 1 {
        let c = p.cur();
        p.pop();
        if p.is(c, tags.T_TD) or p.is(c, tags.T_TH) {
            break;
        }
    }
    p.afe_clear_to_marker();
    p.mode = Mode.IN_ROW;
}

fn in_cell(p: *mut Parser, t: *mut Token) !bool {
    let g = t.tag;
    if t.kind == TokenKind.END {
        if (g == tags.T_TD) or (g == tags.T_TH) {
            if not p.in_scope(g, Scope.TABLE) {
                return false;
            }
            p.gen_implied(0);
            p.pop_until(g);
            p.afe_clear_to_marker();
            p.mode = Mode.IN_ROW;
            return false;
        }
        if (g == tags.T_BODY) or (g == tags.T_CAPTION) or (g == tags.T_COL) or (g == tags.T_COLGROUP) or
           (g == tags.T_HTML) {
            return false;
        }
        if (g == tags.T_TABLE) or (g == tags.T_TBODY) or (g == tags.T_TFOOT) or (g == tags.T_THEAD) or
           (g == tags.T_TR) {
            if not p.in_scope(g, Scope.TABLE) {
                return false;
            }
            close_cell(p);
            return true;
        }
    } else if t.kind == TokenKind.START {
        if (g == tags.T_CAPTION) or (g == tags.T_COL) or (g == tags.T_COLGROUP) or (g == tags.T_TBODY) or
           (g == tags.T_TD) or (g == tags.T_TFOOT) or (g == tags.T_TH) or (g == tags.T_THEAD) or (g == tags.T_TR) {
            if not (p.in_scope(tags.T_TD, Scope.TABLE) or p.in_scope(tags.T_TH, Scope.TABLE)) {
                return false;
            }
            close_cell(p);
            return true;
        }
    }
    return in_body(p, t);
}

fn switch_template(p: *mut Parser, mode: Mode) !bool {
    _ = p.tmodes.pop() catch Mode.IN_BODY;
    p.tmodes.push(mode)!;
    p.mode = mode;
    return true;
}

fn in_template(p: *mut Parser, t: *mut Token) !bool {
    let k = t.kind;
    let g = t.tag;
    if (k == TokenKind.CHARS) or (k == TokenKind.COMMENT) or (k == TokenKind.DOCTYPE) {
        return in_body(p, t);
    }
    if k == TokenKind.START {
        if tag_in(t, HEAD_TAGS[..]) {
            return in_head(p, t);
        }
        if (g == tags.T_CAPTION) or (g == tags.T_COLGROUP) or (g == tags.T_TBODY) or (g == tags.T_TFOOT) or
           (g == tags.T_THEAD) {
            return switch_template(p, Mode.IN_TABLE);
        }
        if g == tags.T_COL {
            return switch_template(p, Mode.IN_COLUMN_GROUP);
        }
        if g == tags.T_TR {
            return switch_template(p, Mode.IN_TABLE_BODY);
        }
        if (g == tags.T_TD) or (g == tags.T_TH) {
            return switch_template(p, Mode.IN_ROW);
        }
        return switch_template(p, Mode.IN_BODY);
    }
    if k == TokenKind.END {
        if g == tags.T_TEMPLATE {
            return in_head(p, t);
        }
        return false;
    }
    if k == TokenKind.EOF {
        if not p.has_template() {
            return false;
        }
        p.pop_until(tags.T_TEMPLATE);
        p.afe_clear_to_marker();
        _ = p.tmodes.pop() catch Mode.IN_BODY;
        p.reset_mode();
        return true;
    }
    return false;
}

fn after_body(p: *mut Parser, t: *mut Token) !bool {
    let k = t.kind;
    if k == TokenKind.CHARS {
        if not split_ws(p, t, Whitespace.IN_BODY)! {
            return false;
        }
    } else if k == TokenKind.COMMENT {
        p.insert_comment(t, Loc.{ parent: p.stack.items()[0], before: NONE })!;
        return false;
    } else if k == TokenKind.DOCTYPE {
        return false;
    } else if is_start(t, tags.T_HTML) {
        return in_body(p, t);
    } else if is_end(t, tags.T_HTML) {
        if p.context == NONE {
            p.mode = Mode.AFTER_AFTER_BODY;
        }
        return false;
    } else if k == TokenKind.EOF {
        return false;
    }
    p.mode = Mode.IN_BODY;
    return true;
}

// Inserts the whitespace characters of t (the rest are dropped).
fn insert_ws_only(p: *mut Parser, t: *Token) !void {
    p.sbuf.clear();
    for c in t.data {
        if is_ws(c) {
            p.sbuf.push(c)!;
        }
    }
    p.insert_text(p.sbuf.bytes())!;
}

fn in_frameset(p: *mut Parser, t: *mut Token) !bool {
    let k = t.kind;
    if k == TokenKind.CHARS {
        insert_ws_only(p, t)!;
    } else if k == TokenKind.COMMENT {
        p.insert_comment(t, p.place(NONE))!;
    } else if is_start(t, tags.T_HTML) {
        return in_body(p, t);
    } else if is_start(t, tags.T_FRAMESET) {
        _ = p.insert(t, Namespace.HTML)!;
    } else if is_end(t, tags.T_FRAMESET) {
        if p.stack.len > 1 {
            p.pop();
            if (p.context == NONE) and not p.cur_is(tags.T_FRAMESET) {
                p.mode = Mode.AFTER_FRAMESET;
            }
        }
    } else if is_start(t, tags.T_FRAME) {
        _ = p.insert_void(t)!;
    } else if is_start(t, tags.T_NOFRAMES) {
        return in_head(p, t);
    }
    return false;
}

fn after_frameset(p: *mut Parser, t: *mut Token) !bool {
    let k = t.kind;
    if k == TokenKind.CHARS {
        insert_ws_only(p, t)!;
    } else if k == TokenKind.COMMENT {
        p.insert_comment(t, p.place(NONE))!;
    } else if is_start(t, tags.T_HTML) {
        return in_body(p, t);
    } else if is_end(t, tags.T_HTML) {
        p.mode = Mode.AFTER_AFTER_FRAMESET;
    } else if is_start(t, tags.T_NOFRAMES) {
        return in_head(p, t);
    }
    return false;
}

fn after_after_body(p: *mut Parser, t: *mut Token) !bool {
    let k = t.kind;
    if k == TokenKind.COMMENT {
        p.insert_comment(t, Loc.{ parent: 0, before: NONE })!;
        return false;
    }
    if (k == TokenKind.DOCTYPE) or is_start(t, tags.T_HTML) {
        return in_body(p, t);
    }
    if k == TokenKind.CHARS {
        if not split_ws(p, t, Whitespace.IN_BODY)! {
            return false;
        }
    }
    if k == TokenKind.EOF {
        return false;
    }
    p.mode = Mode.IN_BODY;
    return true;
}

fn after_after_frameset(p: *mut Parser, t: *mut Token) !bool {
    let k = t.kind;
    if k == TokenKind.COMMENT {
        p.insert_comment(t, Loc.{ parent: 0, before: NONE })!;
        return false;
    }
    if (k == TokenKind.DOCTYPE) or is_start(t, tags.T_HTML) {
        return in_body(p, t);
    }
    if k == TokenKind.CHARS {
        p.sbuf.clear();
        for c in t.data {
            if is_ws(c) {
                p.sbuf.push(c)!;
            }
        }
        let mut w = t.*;
        w.data = p.sbuf.bytes();
        if w.data.len > 0 {
            return in_body(p, &mut w);
        }
        return false;
    }
    if is_start(t, tags.T_NOFRAMES) {
        return in_head(p, t);
    }
    return false;
}

let BREAKOUT: [44]u16 = [
    tags.T_B,
    tags.T_BIG,
    tags.T_BLOCKQUOTE,
    tags.T_BODY,
    tags.T_BR,
    tags.T_CENTER,
    tags.T_CODE,
    tags.T_DD,
    tags.T_DIV,
    tags.T_DL,
    tags.T_DT,
    tags.T_EM,
    tags.T_EMBED,
    tags.T_H1,
    tags.T_H2,
    tags.T_H3,
    tags.T_H4,
    tags.T_H5,
    tags.T_H6,
    tags.T_HEAD,
    tags.T_HR,
    tags.T_I,
    tags.T_IMG,
    tags.T_LI,
    tags.T_LISTING,
    tags.T_MENU,
    tags.T_META,
    tags.T_NOBR,
    tags.T_OL,
    tags.T_P,
    tags.T_PRE,
    tags.T_RUBY,
    tags.T_S,
    tags.T_SMALL,
    tags.T_SPAN,
    tags.T_STRONG,
    tags.T_STRIKE,
    tags.T_SUB,
    tags.T_SUP,
    tags.T_TABLE,
    tags.T_TT,
    tags.T_U,
    tags.T_UL,
    tags.T_VAR,
];

fn foreign(p: *mut Parser, t: *mut Token) !bool {
    let k = t.kind;
    if k == TokenKind.CHARS {
        p.sbuf.clear();
        let mut text = false;
        for c in t.data {
            if c == 0 {
                p.sbuf.push_str("\xef\xbf\xbd")!;
            } else {
                p.sbuf.push(c)!;
                if not is_ws(c) {
                    text = true;
                }
            }
        }
        p.insert_text(p.sbuf.bytes())!;
        if text {
            p.frameset_ok = false;
        }
        return false;
    }
    if k == TokenKind.COMMENT {
        p.insert_comment(t, p.place(NONE))!;
        return false;
    }
    if k == TokenKind.DOCTYPE {
        return false;
    }
    let mut breakout = (k == TokenKind.START) and tag_in(t, BREAKOUT[..]);
    if is_start(t, tags.T_FONT) {
        for a in t.attrs {
            if strs.eq(a.name, "color") or strs.eq(a.name, "face") or strs.eq(a.name, "size") {
                breakout = true;
            }
        }
    }
    if is_end(t, tags.T_BR) or is_end(t, tags.T_P) {
        breakout = true;
    }
    if breakout {
        while p.stack.len > 1 {
            let c = p.cur();
            if p.mathml_text_ip(c) or p.html_ip(c) or (p.nd(c).ns == Namespace.HTML) {
                break;
            }
            p.pop();
        }
        return step(p, p.mode, t);
    }
    if k == TokenKind.START {
        let ns = p.nd(p.adjusted_current()).ns;
        let id = p.insert(t, ns)!;
        if t.self_closing and p.opened(id) {
            p.pop();
        }
        return false;
    }
    if k == TokenKind.END {
        let mut i = p.stack.len - 1;
        loop {
            if i == 0 {
                return false;
            }
            let id = p.stack.items()[i];
            if strs.eq_ignore_case(p.nd(id).name, t.name) {
                p.pop_until_node(id);
                return false;
            }
            i -= 1;
            if p.nd(p.stack.items()[i]).ns == Namespace.HTML {
                return step(p, p.mode, t);
            }
        }
    }
    return false;
}

// -----------------------------------------------------------------------------
// Parsing
// -----------------------------------------------------------------------------

fn new_parser(doc: *mut Document, tz: *mut Tokenizer, opts: Options) Parser {
    return Parser.{ doc: doc, tz: tz, stack: vec.Vec.[u32].init(), open: [0; 124], afe: vec.Vec.[u32].init(),
                    tmodes: vec.Vec.[Mode].init(), mode: Mode.INITIAL, orig: Mode.INITIAL, head: NONE, form: NONE,
                    context: NONE, frameset_ok: true, foster: false, scripting: opts.scripting, skip_lf: false,
                    text_elem: NONE, pend: strs.String.init(), pend_text: false, sbuf: strs.String.init(),
                    abuf: vec.Vec.[Attr].init() };
}

fn run_parser(p: *mut Parser) !void {
    loop {
        let a = p.adjusted_current();
        p.tz.cdata_ok = (a != NONE) and (p.nd(a).ns != Namespace.HTML);
        let mut t = p.tz.next()!;
        if p.skip_lf {
            p.skip_lf = false;
            if (t.kind == TokenKind.CHARS) and (t.data[0] == '\n') {
                t.data = t.data[1..];
                if t.data.len == 0 {
                    continue;
                }
            }
        }
        dispatch(p, t)!;
        if t.kind == TokenKind.EOF {
            return;
        }
    }
}

/// Parses an HTML document (UTF-8).
pub fn parse(text: []u8) !Document {
    return parse_with(text, Options.default());
}

pub fn parse_with(text: []u8, opts: Options) !Document {
    let mut doc = Document.init();
    build(&mut doc, text, opts, "", Namespace.HTML) catch |e| {
        doc.deinit();
        return e;
    };
    return doc;
}

/// Parses a fragment as the children of an element named context (for
/// example "div" or "tr"; "svg path" and "math mi" name SVG and MathML
/// elements), as innerHTML does. Node 0 of the result is a FRAGMENT that
/// holds the parsed nodes.
pub fn parse_fragment(text: []u8, context: []u8, opts: Options) !Document {
    let mut doc = Document.init();
    let mut ns = Namespace.HTML;
    let mut name = context;
    if strs.starts_with(context, "svg ") {
        ns = Namespace.SVG;
        name = context[4..];
    } else if strs.starts_with(context, "math ") {
        ns = Namespace.MATHML;
        name = context[5..];
    }
    build(&mut doc, text, opts, name, ns) catch |e| {
        doc.deinit();
        return e;
    };
    return doc;
}

/// Parses bytes in an unknown encoding: a byte-order mark (UTF-8, UTF-16LE
/// or UTF-16BE) decides, else a <meta charset> (or http-equiv
/// Content-Type) in the first 1024 bytes naming windows-1252 or one of its
/// aliases (ISO-8859-1, ASCII, ...), else UTF-8 if the bytes are valid
/// UTF-8, else windows-1252.
pub fn parse_bytes(bytes: []u8, opts: Options) !Document {
    let mut s = strs.String.init();
    defer s.deinit();
    let text = decode(bytes, &mut s)!;
    return parse_with(text, opts);
}

/// Decodes bytes as parse_bytes does, into out if they are not already
/// UTF-8: returns the UTF-8 text.
pub fn decode(b: []u8, out: *mut strs.String) ![]u8 {
    if (b.len >= 2) and (((b[0] == 0xff) and (b[1] == 0xfe)) or ((b[0] == 0xfe) and (b[1] == 0xff))) {
        let le = b[0] == 0xff;
        let mut i: usize = 2;
        while (i + 1) < b.len {
            let mut u = (@as(u32, b[i + 1]) << 8) | @as(u32, b[i]);
            if not le {
                u = (@as(u32, b[i]) << 8) | @as(u32, b[i + 1]);
            }
            i += 2;
            if (u >= 0xd800) and (u < 0xdc00) and ((i + 1) < b.len) {
                let mut v = (@as(u32, b[i + 1]) << 8) | @as(u32, b[i]);
                if not le {
                    v = (@as(u32, b[i]) << 8) | @as(u32, b[i + 1]);
                }
                if (v >= 0xdc00) and (v < 0xe000) {
                    u = 0x10000 + ((u - 0xd800) << 10) + (v - 0xdc00);
                    i += 2;
                }
            }
            out.push_rune(u)!;  // (lone surrogates become U+FFFD)
        }
        if i < b.len {
            out.push_rune(0xfffd)!;
        }
        return out.bytes();
    }
    if (b.len >= 3) and (b[0] == 0xef) and (b[1] == 0xbb) and (b[2] == 0xbf) {
        return b;
    }
    let cs = prescan_charset(b[..@min(b.len, 1024)]);
    let mut latin = is_windows_1252(cs);
    if (cs.len == 0) and not strs.valid_utf8(b) {
        latin = true;
    }
    if not latin {
        return b;
    }
    out.reserve(b.len + (b.len / 4))!;
    for c in b {
        if c < 0x80 {
            out.push(c)!;
        } else if (c < 0xa0) and (C1[@as(usize, c - 0x80)] != 0) {
            out.push_rune(C1[@as(usize, c - 0x80)])!;
        } else {
            out.push_rune(@as(u32, c))!;
        }
    }
    return out.bytes();
}

fn is_windows_1252(cs: []u8) bool {
    for x in ["windows-1252", "cp1252", "x-cp1252", "iso-8859-1", "iso8859-1", "iso_8859-1", "latin1", "l1", "us-ascii",
              "ascii", "iso-ir-100", "csisolatin1", "cp819", "ibm819", "ansi_x3.4-1968"] {
        if strs.eq_ignore_case(cs, x) {
            return true;
        }
    }
    return false;
}

// The charset a <meta> near the start declares, or "".
fn prescan_charset(b: []u8) []u8 {
    let mut i: usize = 0;
    while i < b.len {
        let lt = strs.index_of_from(b, "<", i) catch return "";
        i = lt + 1;
        if (i + 4) > b.len {
            return "";
        }
        if strs.starts_with(b[i..], "!--") {
            i = (strs.index_of_from(b, "-->", i) catch return "") + 3;
            continue;
        }
        if not (strs.eq_ignore_case(b[i..i + 4], "meta") and ((i + 4) < b.len) and
                (is_ws(b[i + 4]) or (b[i + 4] == '/'))) {
            continue;
        }
        let end = strs.index_of_from(b, ">", i) catch b.len;
        let tag = b[i + 4..end];
        let cs = charset_in(tag);
        if cs.len > 0 {
            return cs;
        }
        i = end;
    }
    return "";
}

// charset=... in a meta tag's text (as an attribute or inside content=).
fn charset_in(tag: []u8) []u8 {
    let mut i: usize = 0;
    while (i + 8) <= tag.len {
        if strs.eq_ignore_case(tag[i..i + 7], "charset") {
            let mut j = i + 7;
            while (j < tag.len) and is_ws(tag[j]) {
                j += 1;
            }
            if (j < tag.len) and (tag[j] == '=') {
                j += 1;
                while (j < tag.len) and (is_ws(tag[j]) or (tag[j] == '"') or (tag[j] == '\'')) {
                    j += 1;
                }
                let st = j;
                while (j < tag.len) and not is_ws(tag[j]) and (tag[j] != '"') and (tag[j] != '\'') and
                      (tag[j] != ';') and (tag[j] != '/') {
                    j += 1;
                }
                return tag[st..j];
            }
        }
        i += 1;
    }
    return "";
}

fn build(doc: *mut Document, text0: []u8, opts: Options, context: []u8, cns: Namespace) !void {
    _ = doc.new_node(Kind.DOCUMENT)!;
    let mut text = text0;
    if (text.len >= 3) and (text[0] == 0xef) and (text[1] == 0xbb) and (text[2] == 0xbf) {
        text = text[3..];  // a byte-order mark
    }
    let mut tz = Tokenizer.init(text)!;
    defer tz.deinit();
    let mut p = new_parser(doc, &mut tz, opts);
    defer p.deinit();
    let mut root = NONE;
    if context.len > 0 {
        let lname = strs.to_lower(context)!;
        defer mem.free(lname);
        let mut ct = fake_token(tags.T_HTML);
        ct.name = lname;
        ct.tag = tags.tag_of(lname);
        p.context = p.create_element(&mut ct, cns)!;
        if cns == Namespace.HTML {
            let g = ct.tag;
            if (g == tags.T_TITLE) or (g == tags.T_TEXTAREA) {
                tz.state = State.RCDATA;
            } else if (g == tags.T_STYLE) or (g == tags.T_XMP) or (g == tags.T_IFRAME) or (g == tags.T_NOEMBED) or
                      (g == tags.T_NOFRAMES) or ((g == tags.T_NOSCRIPT) and opts.scripting) {
                tz.state = State.RAWTEXT;
            } else if g == tags.T_SCRIPT {
                tz.state = State.SCRIPT;
            } else if g == tags.T_PLAINTEXT {
                tz.state = State.PLAINTEXT;
            }
        }
        let mut h = fake_token(tags.T_HTML);
        root = p.create_element(&mut h, Namespace.HTML)!;
        doc.append_child(0, root);
        _ = p.push(root)!;
        if p.is(p.context, tags.T_TEMPLATE) {
            p.tmodes.push(Mode.IN_TEMPLATE)!;
        }
        p.reset_mode();
        if p.is(p.context, tags.T_FORM) {
            p.form = p.context;
        }
    }
    run_parser(&mut p)!;
    if root != NONE {
        // the fragment: the root element's children, under node 0
        doc.remove(root);
        doc.nm(0).kind = Kind.FRAGMENT;
        loop {
            let c = doc.node(root).first;
            if c == NONE {
                break;
            }
            doc.remove(c);
            doc.append_child(0, c);
        }
    }
    doc.finish_text();
    for id in p.stack.items() {
        doc.nm(id).flags &= ~FL_OPEN;
    }
    for id in p.afe.items() {
        if id != MARKER {
            doc.nm(id).flags &= ~FL_AFE;
        }
    }
    fill_selectedcontent(doc)!;
}

// A <select>'s <selectedcontent> shows a copy of the selected <option>'s
// content (the last option marked selected, else the first).
fn fill_selectedcontent(doc: *mut Document) !void {
    let n = @truncate(u32, doc.nodes.len);
    for sel in @as(u32, 0)..n {
        let s = doc.node(sel);
        if (s.kind != Kind.ELEMENT) or (s.ns != Namespace.HTML) or (s.tag != tags.T_SELECT) or
           has_attr_named(s, "multiple") {
            continue;
        }
        let mut sc = NONE;
        let mut first = NONE;
        let mut chosen = NONE;
        let mut w = doc.walk(sel);
        _ = w.next();
        while w.next() {
            if not w.entering {
                continue;
            }
            let e = doc.node(w.id);
            if (e.kind != Kind.ELEMENT) or (e.ns != Namespace.HTML) {
                continue;
            }
            if (e.tag == tags.T_SELECTEDCONTENT) and (sc == NONE) {
                sc = w.id;
            } else if e.tag == tags.T_OPTION {
                if first == NONE {
                    first = w.id;
                }
                if has_attr_named(e, "selected") {
                    chosen = w.id;
                }
            }
        }
        if chosen == NONE {
            chosen = first;
        }
        if (sc == NONE) or (chosen == NONE) or (doc.node(sc).first != NONE) {
            continue;
        }
        let mut c = doc.node(chosen).first;
        while c != NONE {
            let k = doc.clone_tree(c)!;
            doc.append_child(sc, k);
            c = doc.node(c).next;
        }
    }
}

fn has_attr_named(n: *Node, name: []u8) bool {
    for a in n.attrs {
        if (a.ns == AttrNamespace.NONE) and strs.eq(a.name, name) {
            return true;
        }
    }
    return false;
}

// -----------------------------------------------------------------------------
// Walking, reading and changing the tree
// -----------------------------------------------------------------------------

/// A depth-first walk over a subtree: each node is visited entering (before
/// its children) and leaving (after them). Template contents are walked as
/// the template's children.
pub struct Walker {
    doc: *Document,
    root: u32,
    id: u32,
    entering: bool,
    started: bool,
    templates: bool,

    /// Moves on; false when the walk is over.
    pub fn next(self: *mut Walker) bool {
        if not self.started {
            self.started = true;
            self.id = self.root;
            self.entering = true;
            return true;
        }
        if self.entering {
            let f = self.doc.first_kid(self.id, self.templates);
            if f != NONE {
                self.id = f;
                return true;
            }
            self.entering = false;
            return true;
        }
        if self.id == self.root {
            return false;
        }
        let nx = self.doc.node(self.id).next;
        if nx != NONE {
            self.id = nx;
            self.entering = true;
            return true;
        }
        self.id = self.doc.up(self.id);
        return true;
    }

    /// Skips the children of the node just entered.
    pub fn skip(self: *mut Walker) void {
        self.entering = false;
    }
}

/// The children of a node, in order.
pub struct Children {
    doc: *Document,
    id: u32,

    pub fn next(self: *mut Children) !u32 {
        if self.id == NONE {
            return error.NotFound;
        }
        let r = self.id;
        self.id = self.doc.node(r).next;
        return r;
    }
}

fn take_vec(v: *mut vec.Vec.[u32]) ![]mut u32 {
    let out = mem.alloc.[u32](v.len)!;
    @mem_copy(out, v.items());
    v.deinit();
    return out;
}

fn attr_is(a: Attr, name: []u8) bool {
    if a.prefix.len == 0 {
        return strs.eq(a.name, name);
    }
    return (name.len == a.prefix.len + 1 + a.name.len) and strs.starts_with(name, a.prefix) and
           (name[a.prefix.len] == ':') and strs.ends_with(name, a.name);
}

// Whether an element has a local name (ASCII case-insensitively for HTML).
fn name_is(n: *Node, name: []u8) bool {
    if n.ns == Namespace.HTML {
        return strs.eq_ignore_case(n.name, name);
    }
    return strs.eq(n.name, name);
}

/// Writes text escaped for HTML: & < > and no-break space, and " too in
/// attribute values.
pub fn escape(out: io.Writer, s: []u8, attr: bool) !void {
    let mut st: usize = 0;
    let mut i: usize = 0;
    while i < s.len {
        let c = s[i];
        let mut rep: []u8 = "";
        let mut len: usize = 1;
        if c == '&' {
            rep = "&amp;";
        } else if c == '<' {
            rep = "&lt;";
        } else if c == '>' {
            rep = "&gt;";
        } else if (c == '"') and attr {
            rep = "&quot;";
        } else if (c == 0xc2) and ((i + 1) < s.len) and (s[i + 1] == 0xa0) {
            rep = "&nbsp;";
            len = 2;
        }
        if rep.len > 0 {
            out.write_all(s[st..i])!;
            out.write_all(rep)!;
            i += len;
            st = i;
        } else {
            i += 1;
        }
    }
    out.write_all(s[st..])!;
}

// -----------------------------------------------------------------------------
// CSS selectors
// -----------------------------------------------------------------------------
//
// Supported: type and universal selectors, #id, .class, attribute selectors
// ([a] [a=v] [a~=v] [a|=v] [a^=v] [a$=v] [a*=v], with an i flag), the
// combinators (descendant, >, +, ~), selector lists, and the pseudo-classes
// :root :empty :first-child :last-child :only-child :first-of-type
// :last-of-type :only-of-type :nth-child() :nth-last-child() :nth-of-type()
// :nth-last-of-type() :not() :is() :where() :link :checked :disabled
// :enabled.

// Simple selector kinds
enum SimpleKind: u8 {
    TYPE,
    UNIVERSAL,
    ID,
    CLASS,
    ATTR,
    ROOT,
    EMPTY,
    NTH,  // op: bit 0 from the end, bit 1 of type
    NOT,  // sub: a list
    IS,
    LINK,
    CHECKED,
    DISABLED,
    ENABLED,
}

// Attribute operators
const AO_EXISTS: u8 = 0;
const AO_EQ: u8 = 1;
const AO_WORD: u8 = 2;    // ~=
const AO_DASH: u8 = 3;    // |=
const AO_PREFIX: u8 = 4;  // ^=
const AO_SUFFIX: u8 = 5;  // $=
const AO_SUB: u8 = 6;     // *=

// Combinators (to the compound on the left)
enum Combinator: u8 {
    NONE,
    DESCENDANT,
    CHILD,
    NEXT,
    LATER,
}

struct Simple {
    kind: SimpleKind,
    op: u8,
    ci: bool,
    name: []u8,
    value: []u8,
    a: i64,
    b: i64,
    sub: u32,
}

struct Compound {
    first: u32,  // simples[first..first + count]
    count: u32,
    comb: Combinator,  // how it relates to the compound before it
}

struct Complex {
    first: u32,  // compounds[first..first + count], left to right
    count: u32,
}

struct Range {
    first: u32,
    count: u32,
}

// Match results (as in Servo, which avoids exponential backtracking)
enum MatchResult: u8 {
    MATCHED,
    LATER_SIBLING,  // not matched: restart from the closest later-sibling combinator
    DESCENDANT,     // ... from the closest descendant combinator
    GLOBALLY,       // not matched, and no other placement can match
}

/// A compiled selector list.
pub struct Selector {
    simples: vec.Vec.[Simple],
    compounds: vec.Vec.[Compound],
    complexes: vec.Vec.[Complex],
    lists: vec.Vec.[Range],  // ranges of complexes; the last is the whole selector
    top: u32,
    arena: arena.Arena,

    pub fn deinit(self: *mut Selector) void {
        self.simples.deinit();
        self.compounds.deinit();
        self.complexes.deinit();
        self.lists.deinit();
        self.arena.deinit();
    }

    /// Whether an element matches.
    pub fn matches(self: *Selector, doc: *Document, id: u32) bool {
        if doc.node(id).kind != Kind.ELEMENT {
            return false;
        }
        return self.list_matches(doc, self.top, id, 0);
    }

    fn list_matches(self: *Selector, doc: *Document, list: u32, id: u32, depth: u32) bool {
        let r = self.lists.get(@as(usize, list));
        for k in r.first..r.first + r.count {
            let c = self.complexes.get(@as(usize, k));
            if self.match_from(doc, c, c.count - 1, id, depth) == MatchResult.MATCHED {
                return true;
            }
        }
        return false;
    }

    fn match_from(self: *Selector, doc: *Document, cx: Complex, i: u32, id: u32, depth: u32) MatchResult {
        let comp = self.compounds.get(@as(usize, cx.first + i));
        if not self.compound_matches(doc, comp, id, depth) {
            return MatchResult.LATER_SIBLING;
        }
        if i == 0 {
            return MatchResult.MATCHED;
        }
        let comb = comp.comb;
        let mut not_found = MatchResult.GLOBALLY;
        if (comb == Combinator.NEXT) or (comb == Combinator.LATER) {
            not_found = MatchResult.DESCENDANT;
        }
        let mut next = id;
        loop {
            if (comb == Combinator.CHILD) or (comb == Combinator.DESCENDANT) {
                next = doc.parent_element(next);
            } else {
                next = prev_element(doc, next);
            }
            if next == NONE {
                return not_found;
            }
            let r = self.match_from(doc, cx, i - 1, next, depth);
            if (r == MatchResult.MATCHED) or (r == MatchResult.GLOBALLY) or (comb == Combinator.NEXT) {
                return r;
            }
            if comb == Combinator.CHILD {
                return MatchResult.DESCENDANT;
            }
            if (r == MatchResult.DESCENDANT) and (comb == Combinator.LATER) {
                return r;
            }
        }
    }

    fn compound_matches(self: *Selector, doc: *Document, comp: Compound, id: u32, depth: u32) bool {
        for k in comp.first..comp.first + comp.count {
            if not self.simple_matches(doc, self.simples.get(@as(usize, k)), id, depth) {
                return false;
            }
        }
        return true;
    }

    fn simple_matches(self: *Selector, doc: *Document, s: Simple, id: u32, depth: u32) bool {
        let n = doc.node(id);
        let k = s.kind;
        if k == SimpleKind.TYPE {
            return name_is(n, s.name);
        }
        if k == SimpleKind.UNIVERSAL {
            return true;
        }
        if k == SimpleKind.ID {
            let v = doc.attr(id, "id") catch return false;
            return strs.eq(v, s.name);
        }
        if k == SimpleKind.CLASS {
            let v = doc.attr(id, "class") catch return false;
            return has_word(v, s.name, false);
        }
        if k == SimpleKind.ATTR {
            for a in n.attrs {
                let mut hit = false;
                if n.ns == Namespace.HTML {
                    hit = (a.prefix.len == 0) and strs.eq_ignore_case(a.name, s.name);
                } else {
                    hit = attr_is(a, s.name);
                }
                if hit {
                    return attr_value_matches(a.value, s);
                }
            }
            return false;
        }
        if k == SimpleKind.ROOT {
            return (n.parent != NONE) and (doc.node(n.parent).kind == Kind.DOCUMENT);
        }
        if k == SimpleKind.EMPTY {
            let mut c = n.first;
            while c != NONE {
                let ck = doc.node(c).kind;
                if (ck == Kind.ELEMENT) or ((ck == Kind.TEXT) and (doc.node(c).text.len > 0)) {
                    return false;
                }
                c = doc.node(c).next;
            }
            return true;
        }
        if k == SimpleKind.NTH {
            let from_end = (s.op & 1) != 0;
            let of_type = (s.op & 2) != 0;
            let mut pos: i64 = 1;
            let mut c = id;
            loop {
                if from_end {
                    c = next_element(doc, c);
                } else {
                    c = prev_element(doc, c);
                }
                if c == NONE {
                    break;
                }
                if not of_type or ((doc.node(c).ns == n.ns) and strs.eq(doc.node(c).name, n.name)) {
                    pos += 1;
                }
            }
            if s.a == 0 {
                return pos == s.b;
            }
            let d = pos - s.b;
            return ((d % s.a) == 0) and ((d / s.a) >= 0);
        }
        if (k == SimpleKind.NOT) or (k == SimpleKind.IS) {
            if depth > 32 {
                return false;
            }
            let m = self.list_matches(doc, s.sub, id, depth + 1);
            return m == (k == SimpleKind.IS);
        }
        if (n.ns != Namespace.HTML) {
            return false;
        }
        if k == SimpleKind.LINK {
            return ((n.tag == tags.T_A) or (n.tag == tags.T_AREA)) and doc.has_attr(id, "href");
        }
        if k == SimpleKind.CHECKED {
            return (((n.tag == tags.T_INPUT) and doc.has_attr(id, "checked")) or
                    ((n.tag == tags.T_OPTION) and doc.has_attr(id, "selected")));
        }
        let form = (n.tag == tags.T_BUTTON) or (n.tag == tags.T_INPUT) or (n.tag == tags.T_SELECT) or
                   (n.tag == tags.T_TEXTAREA) or (n.tag == tags.T_OPTGROUP) or (n.tag == tags.T_OPTION) or
                   (n.tag == tags.T_FIELDSET);
        if k == SimpleKind.DISABLED {
            return form and doc.has_attr(id, "disabled");
        }
        return form and not doc.has_attr(id, "disabled");
    }
}

fn prev_element(doc: *Document, id: u32) u32 {
    let mut c = doc.node(id).prev;
    while (c != NONE) and (doc.node(c).kind != Kind.ELEMENT) {
        c = doc.node(c).prev;
    }
    return c;
}

fn next_element(doc: *Document, id: u32) u32 {
    let mut c = doc.node(id).next;
    while (c != NONE) and (doc.node(c).kind != Kind.ELEMENT) {
        c = doc.node(c).next;
    }
    return c;
}

fn has_word(list: []u8, word: []u8, ci: bool) bool {
    if word.len == 0 {
        return false;
    }
    let mut it = strs.fields(list);
    while true {
        let w = it.next() catch break;
        if strs.eq(w, word) or (ci and strs.eq_ignore_case(w, word)) {
            return true;
        }
    }
    return false;
}

fn attr_value_matches(v: []u8, s: Simple) bool {
    let want = s.value;
    let op = s.op;
    if op == AO_EXISTS {
        return true;
    }
    if op == AO_WORD {
        return has_word(v, want, s.ci) and not strs.contains(want, " ");
    }
    if (op != AO_EQ) and (want.len == 0) {
        return false;
    }
    let mut part = v;
    if op == AO_PREFIX {
        if v.len < want.len {
            return false;
        }
        part = v[..want.len];
    } else if op == AO_SUFFIX {
        if v.len < want.len {
            return false;
        }
        part = v[v.len - want.len..];
    } else if op == AO_SUB {
        if s.ci {
            let mut i: usize = 0;
            while (i + want.len) <= v.len {
                if strs.eq_ignore_case(v[i..i + want.len], want) {
                    return true;
                }
                i += 1;
            }
            return false;
        }
        return strs.contains(v, want);
    } else if op == AO_DASH {
        if (v.len > want.len) and (v[want.len] == '-') {
            part = v[..want.len];
        }
    }
    if s.ci {
        return strs.eq_ignore_case(part, want);
    }
    return strs.eq(part, want);
}

/// Compiles a selector list (for matching many elements).
pub fn compile(text: []u8) !Selector {
    let mut sel = Selector.{ simples: vec.Vec.[Simple].init(), compounds: vec.Vec.[Compound].init(),
                             complexes: vec.Vec.[Complex].init(), lists: vec.Vec.[Range].init(), top: 0,
                             arena: arena.Arena.init() };
    let mut ps = SelParser.{ s: text, i: 0, sel: &mut sel };
    let top = ps.list(0) catch |e| {
        sel.deinit();
        return e;
    };
    ps.ws();
    if ps.i < text.len {
        sel.deinit();
        return error.SyntaxError;
    }
    sel.top = top;
    return sel;
}

struct SelParser {
    s: []u8,
    i: usize,
    sel: *mut Selector,

    fn peek(self: *SelParser) u8 {
        if self.i < self.s.len {
            return self.s[self.i];
        }
        return 0;
    }

    fn ws(self: *mut SelParser) void {
        while (self.i < self.s.len) and is_ws(self.s[self.i]) {
            self.i += 1;
        }
    }

    // A selector list, up to ")" or the end: the index of its Range.
    fn list(self: *mut SelParser, depth: u32) !u32 {
        if depth > 32 {
            return error.SyntaxError;
        }
        let mut items = vec.Vec.[Complex].init();
        defer items.deinit();
        loop {
            self.ws();
            items.push(self.complex(depth)!)!;
            self.ws();
            if self.peek() != ',' {
                break;
            }
            self.i += 1;
        }
        let first = @truncate(u32, self.sel.complexes.len);
        self.sel.complexes.extend(items.items())!;
        self.sel.lists.push(Range.{ first: first, count: @truncate(u32, items.len) })!;
        return @truncate(u32, self.sel.lists.len - 1);
    }

    fn complex(self: *mut SelParser, depth: u32) !Complex {
        let mut comps = vec.Vec.[Compound].init();
        defer comps.deinit();
        let mut comb = Combinator.NONE;
        loop {
            let mut c = self.compound(depth)!;
            c.comb = comb;
            comps.push(c)!;
            let had_ws = (self.i < self.s.len) and is_ws(self.s[self.i]);
            self.ws();
            let ch = self.peek();
            if ch == '>' {
                comb = Combinator.CHILD;
            } else if ch == '+' {
                comb = Combinator.NEXT;
            } else if ch == '~' {
                comb = Combinator.LATER;
            } else if had_ws and (ch != 0) and (ch != ',') and (ch != ')') {
                comb = Combinator.DESCENDANT;
                continue;
            } else {
                break;
            }
            self.i += 1;
            self.ws();
        }
        let first = @truncate(u32, self.sel.compounds.len);
        self.sel.compounds.extend(comps.items())!;
        return Complex.{ first: first, count: @truncate(u32, comps.len) };
    }

    fn ident(self: *mut SelParser) ![]u8 {
        let st = self.i;
        while self.i < self.s.len {
            let c = self.s[self.i];
            if is_alnum(@as(i32, c)) or (c == '-') or (c == '_') or (c >= 0x80) {
                self.i += 1;
            } else if (c == '\\') and ((self.i + 1) < self.s.len) {
                self.i += 2;
            } else {
                break;
            }
        }
        if self.i == st {
            return error.SyntaxError;
        }
        return unescape_css(self.s[st..self.i], &mut self.sel.arena);
    }

    fn compound(self: *mut SelParser, depth: u32) !Compound {
        // (collected apart: :not() and :is() add their own simples as they go)
        let mut out = vec.Vec.[Simple].init();
        defer out.deinit();
        let c = self.peek();
        if c == '*' {
            self.i += 1;
            add(&mut out, SimpleKind.UNIVERSAL, "")!;
        } else if is_alnum(@as(i32, c)) or (c == '-') or (c == '_') or (c == '\\') or (c >= 0x80) {
            let nm = self.ident()!;
            add(&mut out, SimpleKind.TYPE, nm)!;
        }
        loop {
            let ch = self.peek();
            if ch == '#' {
                self.i += 1;
                let nm = self.ident()!;
                add(&mut out, SimpleKind.ID, nm)!;
            } else if ch == '.' {
                self.i += 1;
                let nm = self.ident()!;
                add(&mut out, SimpleKind.CLASS, nm)!;
            } else if ch == '[' {
                self.i += 1;
                self.attribute(&mut out)!;
            } else if ch == ':' {
                self.i += 1;
                if self.peek() == ':' {
                    return error.SyntaxError;  // (pseudo-elements never match)
                }
                self.pseudo(&mut out, depth)!;
            } else {
                break;
            }
        }
        if out.len == 0 {
            return error.SyntaxError;
        }
        let first = @truncate(u32, self.sel.simples.len);
        self.sel.simples.extend(out.items())!;
        return Compound.{ first: first, count: @truncate(u32, out.len), comb: Combinator.NONE };
    }

    fn attribute(self: *mut SelParser, out: *mut vec.Vec.[Simple]) !void {
        self.ws();
        let nm = self.ident()!;
        self.ws();
        let mut s = Simple.{ kind: SimpleKind.ATTR, op: AO_EXISTS, ci: false, name: nm, value: "", a: 0, b: 0, sub: 0 };
        let c = self.peek();
        if c != ']' {
            if c == '=' {
                s.op = AO_EQ;
                self.i += 1;
            } else {
                if (self.i + 1) >= self.s.len or (self.s[self.i + 1] != '=') {
                    return error.SyntaxError;
                }
                if c == '~' {
                    s.op = AO_WORD;
                } else if c == '|' {
                    s.op = AO_DASH;
                } else if c == '^' {
                    s.op = AO_PREFIX;
                } else if c == '$' {
                    s.op = AO_SUFFIX;
                } else if c == '*' {
                    s.op = AO_SUB;
                } else {
                    return error.SyntaxError;
                }
                self.i += 2;
            }
            self.ws();
            let q = self.peek();
            if (q == '"') or (q == '\'') {
                self.i += 1;
                let st = self.i;
                while (self.i < self.s.len) and (self.s[self.i] != q) {
                    if self.s[self.i] == '\\' {
                        self.i += 1;
                    }
                    self.i += 1;
                }
                if self.i >= self.s.len {
                    return error.SyntaxError;
                }
                s.value = unescape_css(self.s[st..self.i], &mut self.sel.arena)!;
                self.i += 1;
            } else {
                s.value = self.ident()!;
            }
            self.ws();
            if (self.peek() == 'i') or (self.peek() == 'I') {
                s.ci = true;
                self.i += 1;
                self.ws();
            } else if (self.peek() == 's') or (self.peek() == 'S') {
                self.i += 1;
                self.ws();
            }
        }
        if self.peek() != ']' {
            return error.SyntaxError;
        }
        self.i += 1;
        out.push(s)!;
    }

    fn pseudo(self: *mut SelParser, out: *mut vec.Vec.[Simple], depth: u32) !void {
        let nm = self.ident()!;
        if strs.eq_ignore_case(nm, "root") {
            return add(out, SimpleKind.ROOT, "");
        }
        if strs.eq_ignore_case(nm, "empty") {
            return add(out, SimpleKind.EMPTY, "");
        }
        if strs.eq_ignore_case(nm, "link") or strs.eq_ignore_case(nm, "any-link") {
            return add(out, SimpleKind.LINK, "");
        }
        if strs.eq_ignore_case(nm, "checked") {
            return add(out, SimpleKind.CHECKED, "");
        }
        if strs.eq_ignore_case(nm, "disabled") {
            return add(out, SimpleKind.DISABLED, "");
        }
        if strs.eq_ignore_case(nm, "enabled") {
            return add(out, SimpleKind.ENABLED, "");
        }
        // positions: (from the end, of type) and an+b
        let mut op: u8 = 0;
        let mut a: i64 = 0;
        let mut b: i64 = 1;
        let mut both = false;  // only-*: first and last
        if strs.eq_ignore_case(nm, "first-child") {
            op = 0;
        } else if strs.eq_ignore_case(nm, "last-child") {
            op = 1;
        } else if strs.eq_ignore_case(nm, "only-child") {
            both = true;
        } else if strs.eq_ignore_case(nm, "first-of-type") {
            op = 2;
        } else if strs.eq_ignore_case(nm, "last-of-type") {
            op = 3;
        } else if strs.eq_ignore_case(nm, "only-of-type") {
            op = 2;
            both = true;
        } else {
            if self.peek() != '(' {
                return error.SyntaxError;
            }
            self.i += 1;
            self.ws();
            if strs.eq_ignore_case(nm, "not") or strs.eq_ignore_case(nm, "is") or strs.eq_ignore_case(nm, "where") or
               strs.eq_ignore_case(nm, "matches") {
                let sub = self.list(depth + 1)!;
                self.ws();
                if self.peek() != ')' {
                    return error.SyntaxError;
                }
                self.i += 1;
                let mut kind = SimpleKind.IS;
                if strs.eq_ignore_case(nm, "not") {
                    kind = SimpleKind.NOT;
                }
                out.push(Simple.{ kind: kind, op: 0, ci: false, name: "", value: "", a: 0, b: 0, sub: sub })!;
                return;
            }
            if strs.eq_ignore_case(nm, "nth-child") {
                op = 0;
            } else if strs.eq_ignore_case(nm, "nth-last-child") {
                op = 1;
            } else if strs.eq_ignore_case(nm, "nth-of-type") {
                op = 2;
            } else if strs.eq_ignore_case(nm, "nth-last-of-type") {
                op = 3;
            } else {
                return error.SyntaxError;
            }
            let st = self.i;
            while (self.i < self.s.len) and (self.s[self.i] != ')') {
                self.i += 1;
            }
            if self.i >= self.s.len {
                return error.SyntaxError;
            }
            parse_nth(strs.trim(self.s[st..self.i]), &mut a, &mut b)!;
            self.i += 1;
        }
        out.push(Simple.{ kind: SimpleKind.NTH, op: op, ci: false, name: "", value: "", a: a, b: b, sub: 0 })!;
        if both {
            out.push(Simple.{ kind: SimpleKind.NTH, op: op | 1, ci: false, name: "", value: "", a: 0, b: 1, sub: 0 })!;
        }
    }
}

fn add(out: *mut vec.Vec.[Simple], kind: SimpleKind, name: []u8) !void {
    out.push(Simple.{ kind: kind, op: 0, ci: false, name: name, value: "", a: 0, b: 0, sub: 0 })!;
}

// an+b (or odd, even, or an integer).
fn parse_nth(s: []u8, a: *mut i64, b: *mut i64) !void {
    if strs.eq_ignore_case(s, "odd") {
        a.* = 2;
        b.* = 1;
        return;
    }
    if strs.eq_ignore_case(s, "even") {
        a.* = 2;
        b.* = 0;
        return;
    }
    let mut compact = strs.String.init();
    defer compact.deinit();
    for c in s {
        if not is_ws(c) {
            compact.push(strs.to_lower_byte(c))!;
        }
    }
    let t = compact.bytes();
    let n_at = strs.index_of_byte(t, 'n') catch NONE_USIZE;
    if n_at == NONE_USIZE {
        a.* = 0;
        b.* = fmt.parse_int.[i64](t) catch return error.SyntaxError;
        return;
    }
    let head = t[..n_at];
    if (head.len == 0) or strs.eq(head, "+") {
        a.* = 1;
    } else if strs.eq(head, "-") {
        a.* = -1;
    } else {
        a.* = fmt.parse_int.[i64](head) catch return error.SyntaxError;
    }
    let tail = t[n_at + 1..];
    if tail.len == 0 {
        b.* = 0;
        return;
    }
    if (tail[0] != '+') and (tail[0] != '-') {
        return error.SyntaxError;
    }
    let v = fmt.parse_int.[i64](tail[1..]) catch return error.SyntaxError;
    if tail[0] == '-' {
        b.* = -v;
    } else {
        b.* = v;
    }
}

// Removes CSS backslash escapes (\x and hex escapes).
fn unescape_css(s: []u8, a: *mut arena.Arena) ![]u8 {
    if (strs.index_of_byte(s, '\\') catch NONE_USIZE) == NONE_USIZE {
        return a.dup(s);
    }
    let mut out = strs.String.init();
    defer out.deinit();
    let mut i: usize = 0;
    while i < s.len {
        if (s[i] == '\\') and ((i + 1) < s.len) {
            i += 1;
            let mut v: u32 = 0;
            let mut k: usize = 0;
            while (k < 6) and ((i + k) < s.len) and strs.is_hex_digit(s[i + k]) {
                v = (v * 16) + @as(u32, hexv(s[i + k]));
                k += 1;
            }
            if k > 0 {
                out.push_rune(v)!;
                i += k;
                if (i < s.len) and is_ws(s[i]) {
                    i += 1;
                }
                continue;
            }
        }
        out.push(s[i])!;
        i += 1;
    }
    return a.dup(out.bytes());
}

fn hexv(c: u8) u8 {
    if c <= '9' {
        return c - '0';
    }
    if c >= 'a' {
        return c - 'a' + 10;
    }
    return c - 'A' + 10;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

// The html5lib-tests tree format.
fn dump(doc: *Document, from: u32, out: *mut strs.String) !void {
    let mut work = vec.Vec.[u32].init();  // pairs: node, depth
    defer work.deinit();
    push_children(doc, &mut work, doc.node(from).first, 0)!;
    while work.len > 0 {
        let depth = work.pop()!;
        let id = work.pop()!;
        let n = doc.node(id);
        out.push_str("| ")!;
        for _k in @as(u32, 0)..depth {
            out.push_str("  ")!;
        }
        if n.kind == Kind.FRAGMENT {
            out.push_str("content\n")!;
            push_children(doc, &mut work, n.first, depth + 1)!;
            continue;
        }
        if n.kind == Kind.ELEMENT {
            out.push('<')!;
            if n.ns == Namespace.SVG {
                out.push_str("svg ")!;
            } else if n.ns == Namespace.MATHML {
                out.push_str("math ")!;
            }
            out.push_str(n.name)!;
            out.push_str(">\n")!;
            // attributes, sorted by their displayed names
            let mut attrs = vec.Vec.[Attr].init();
            defer attrs.deinit();
            attrs.extend(n.attrs)!;
            attrs.sort(display_less);
            for a in attrs.items() {
                out.push_str("| ")!;
                for _k in @as(u32, 0)..depth + 1 {
                    out.push_str("  ")!;
                }
                if a.prefix.len > 0 {
                    out.push_str(a.prefix)!;
                    out.push(' ')!;
                }
                out.push_str(a.name)!;
                out.push_str("=\"")!;
                out.push_str(a.value)!;
                out.push_str("\"\n")!;
            }
            if n.contents != NONE {
                work.push(n.contents)!;
                work.push(depth + 1)!;
            }
            push_children(doc, &mut work, n.first, depth + 1)!;
        } else if n.kind == Kind.TEXT {
            out.push('"')!;
            out.push_str(n.text)!;
            out.push_str("\"\n")!;
        } else if n.kind == Kind.COMMENT {
            out.push_str("<!-- ")!;
            out.push_str(n.text)!;
            out.push_str(" -->\n")!;
        } else if n.kind == Kind.DOCTYPE {
            out.push_str("<!DOCTYPE ")!;
            out.push_str(n.name)!;
            if (n.text.len > 0) or (n.system_id.len > 0) {
                out.push_str(" \"")!;
                out.push_str(n.text)!;
                out.push_str("\" \"")!;
                out.push_str(n.system_id)!;
                out.push('"')!;
            }
            out.push_str(">\n")!;
        }
    }
}

// The byte at i of an attribute's displayed name ("prefix name"), or -1.
fn display_at(a: Attr, i: usize) i32 {
    let mut k = i;
    if a.prefix.len > 0 {
        if k < a.prefix.len {
            return @as(i32, a.prefix[k]);
        }
        if k == a.prefix.len {
            return ' ';
        }
        k -= a.prefix.len + 1;
    }
    if k < a.name.len {
        return @as(i32, a.name[k]);
    }
    return -1;
}

fn display_less(a: Attr, b: Attr) bool {
    let mut i: usize = 0;
    loop {
        let x = display_at(a, i);
        let y = display_at(b, i);
        if x != y {
            return x < y;
        }
        if x < 0 {
            return false;
        }
        i += 1;
    }
}

// Pushes the siblings from `first` on, last first (so they pop in order).
fn push_children(doc: *Document, work: *mut vec.Vec.[u32], first: u32, depth: u32) !void {
    let st = work.len;
    let mut c = first;
    while c != NONE {
        work.push(c)!;
        work.push(depth)!;
        c = doc.node(c).next;
    }
    // reverse the pairs
    let items = work.items();
    let cnt = (work.len - st) / 2;
    for k in @as(usize, 0)..cnt / 2 {
        let i = st + (2 * k);
        let j = st + (2 * (cnt - 1 - k));
        let a0 = items[i];
        let a1 = items[i + 1];
        items[i] = items[j];
        items[i + 1] = items[j + 1];
        items[j] = a0;
        items[j + 1] = a1;
    }
}

fn tree_of(input: []u8, context: []u8, scripting: bool) ![]mut u8 {
    let mut o = Options.default();
    o.scripting = scripting;
    let mut doc = Document.init();
    if context.len > 0 {
        doc = parse_fragment(input, context, o)!;
    } else {
        doc = parse_with(input, o)!;
    }
    defer doc.deinit();
    let mut s = strs.String.init();
    dump(&doc, 0, &mut s) catch |e| {
        s.deinit();
        return e;
    };
    return s.take();
}

test "html5lib tree construction" {
    let data = fs.read_file("std/text/html/testdata/tree.dat") catch return;
    defer mem.free(data);
    let mut parts = strs.split(data, "\n#data\n");
    _ = parts.next() catch return;
    let mut n: usize = 0;
    let mut failed: usize = 0;
    while true {
        let t = parts.next() catch break;
        let mut input: []u8 = "";
        if not strs.starts_with(t, "#errors\n") {
            let e = strs.index_of(t, "\n#errors\n") catch {
                @expect(false);
                break;
            };
            input = t[..e];
        }
        let mut context: []u8 = "";
        let fr = strs.index_of(t, "\n#document-fragment\n") catch NONE_USIZE;
        if fr != NONE_USIZE {
            let st = fr + 20;
            let nl = strs.index_of_from(t, "\n", st) catch t.len;
            context = t[st..nl];
        }
        let mut modes: u8 = 3;  // bit 0: scripting off, bit 1: on
        if strs.contains(t, "\n#script-on\n") {
            modes = 2;
        } else if strs.contains(t, "\n#script-off\n") {
            modes = 1;
        }
        let d = strs.index_of(t, "\n#document\n") catch {
            @expect(false);
            break;
        };
        let mut want = t[d + 11..];
        while (want.len > 0) and (want[want.len - 1] == '\n') {
            want = want[..want.len - 1];
        }
        for m in [@as(u8, 1), 2] {
            if (modes & m) == 0 {
                continue;
            }
            n += 1;
            let got = tree_of(input, context, m == 2)!;
            defer mem.free(got);
            let mut g = got[..];
            while (g.len > 0) and (g[g.len - 1] == '\n') {
                g = g[..g.len - 1];
            }
            if not strs.eq(g, want) {
                failed += 1;
                if failed <= 30 {
                    fmt.print("--- #data\n{}\n--- context {} scripting {}\n--- want\n{}\n--- got\n{}\n",
                              [fmt.str(input), fmt.str(context), fmt.int(m - 1), fmt.str(want), fmt.str(g)]) catch {};
                }
            }
        }
    }
    if failed > 0 {
        fmt.print("tree construction: {} of {} failed\n", [fmt.int(failed), fmt.int(n)]) catch {};
    }
    @expect(n > 3000);
    @expect_eq(failed, 0);
}

fn esc_field(out: *mut strs.String, s: []u8) !void {
    let hex = "0123456789abcdef";
    for c in s {
        if (c < 0x20) or (c == '\\') or (c == '|') {
            out.push_str("\\x")!;
            out.push(hex[@as(usize, c >> 4)])!;
            out.push(hex[@as(usize, c & 15)])!;
        } else {
            out.push(c)!;
        }
    }
}

fn attr_less(a: Attr, b: Attr) bool {
    return strs.less(a.name, b.name);
}

fn tokens_of(input: []u8, state: State, last: []u8, out: *mut strs.String) !void {
    let mut tz = Tokenizer.init(input)!;
    defer tz.deinit();
    tz.state = state;
    if not strs.eq(last, "-") {
        tz.set_last_start_tag(last)!;
    }
    let mut chars = false;
    loop {
        let t = tz.next()!;
        let k = t.kind;
        if k == TokenKind.EOF {
            return;
        }
        if k == TokenKind.CHARS {
            if not chars {
                if out.len > 0 {
                    out.push('\n')!;
                }
                out.push_str("T|")!;
            }
            esc_field(out, t.data)!;
            chars = true;
            continue;
        }
        chars = false;
        if out.len > 0 {
            out.push('\n')!;
        }
        if k == TokenKind.COMMENT {
            out.push_str("C|")!;
            esc_field(out, t.data)!;
        } else if k == TokenKind.END {
            out.push_str("E|")!;
            esc_field(out, t.name)!;
        } else if k == TokenKind.START {
            out.push_str("S|")!;
            esc_field(out, t.name)!;
            if t.self_closing {
                out.push_str("|1")!;
            } else {
                out.push_str("|0")!;
            }
            let mut attrs = vec.Vec.[Attr].init();
            defer attrs.deinit();
            attrs.extend(t.attrs)!;
            attrs.sort(attr_less);
            for a in attrs.items() {
                out.push('|')!;
                esc_field(out, a.name)!;
                out.push('|')!;
                esc_field(out, a.value)!;
            }
        } else if k == TokenKind.DOCTYPE {
            out.push_str("D|")!;
            let parts: [3][]u8 = [t.name, t.public_id, t.system_id];
            let has: [3]bool = [t.has_name, t.has_public, t.has_system];
            for i in @as(usize, 0)..3 {
                if has[i] {
                    out.push('+')!;
                    esc_field(out, parts[i])!;
                } else {
                    out.push('-')!;
                }
                out.push('|')!;
            }
            if t.force_quirks {
                out.push('0')!;
            } else {
                out.push('1')!;
            }
        }
    }
}

test "html5lib tokenizer" {
    let data = fs.read_file("std/text/html/testdata/tokenizer.txt") catch return;
    defer mem.free(data);
    let mut at = (strs.index_of(data, "\n") catch 0) + 1;
    let mut n: usize = 0;
    let mut failed: usize = 0;
    while at < data.len {
        let nl = strs.index_of_from(data, "\n", at) catch data.len;
        let mut f = strs.fields(data[at..nl]);
        at = nl + 1;
        _ = f.next() catch break;
        let st = f.next() catch break;
        let last = f.next() catch break;
        let ilen = fmt.parse_int.[usize](f.next() catch break) catch break;
        let elen = fmt.parse_int.[usize](f.next() catch break) catch break;
        let input = data[at..at + ilen];
        at += ilen + 1;
        let want = data[at..at + elen];
        at += elen + 1;
        let mut state = State.DATA;
        if strs.eq(st, "plaintext") {
            state = State.PLAINTEXT;
        } else if strs.eq(st, "rcdata") {
            state = State.RCDATA;
        } else if strs.eq(st, "rawtext") {
            state = State.RAWTEXT;
        } else if strs.eq(st, "script") {
            state = State.SCRIPT;
        } else if strs.eq(st, "cdata") {
            state = State.CDATA;
        }
        let mut got = strs.String.init();
        defer got.deinit();
        tokens_of(input, state, last, &mut got)!;
        n += 1;
        if not strs.eq(got.bytes(), want) {
            failed += 1;
            if failed <= 30 {
                fmt.print("--- {} {}: {}\n--- want\n{}\n--- got\n{}\n",
                          [fmt.str(st), fmt.str(last), fmt.str(input), fmt.str(want), fmt.str(got.bytes())]) catch {};
            }
        }
    }
    if failed > 0 {
        fmt.print("tokenizer: {} of {} failed\n", [fmt.int(failed), fmt.int(n)]) catch {};
    }
    @expect(n > 6000);
    @expect_eq(failed, 0);
}

test "reading the tree" {
    let text =
        "<!doctype html><title> A  <b>title</b>\n</title><body class='x y'><ul id=l><li>one<li data-n=2>two &amp; &lt;three&gt;</ul><p>caf&eacute;&notit; &#x1F600;</p><template><i>t</i></template>";
    let mut doc = parse(text)!;
    defer doc.deinit();
    @expect(doc.mode == QuirksMode.NO_QUIRKS);
    let t = doc.title()!;
    defer mem.free(t);
    @expect_eq(t, "A <b>title</b>");
    let body = doc.body();
    @expect_eq(doc.node(body).name, "body");
    @expect_eq(doc.attr(body, "class")!, "x y");
    @expect(not doc.has_attr(body, "id"));
    let ul = doc.find(0, "UL");
    @expect_eq(doc.attr(ul, "id")!, "l");
    let mut names = strs.String.init();
    defer names.deinit();
    let mut it = doc.children(ul);
    while true {
        let c = it.next() catch break;
        names.push_str(doc.node(c).name)!;
    }
    @expect_eq(names.bytes(), "lili");
    let tx = doc.text_content(ul)!;
    defer mem.free(tx);
    @expect_eq(tx, "onetwo & <three>");
    let p = doc.find(0, "p");
    let pt = doc.text_content(p)!;
    defer mem.free(pt);
    @expect_eq(pt, "caf\xc3\xa9\xc2\xacit; \xf0\x9f\x98\x80");
    // template contents are walked as children, but are not text content
    let tpl = doc.find(0, "template");
    @expect_eq(doc.node(tpl).first, NONE);
    @expect(doc.find(tpl, "i") != NONE);
    let tt = doc.text_content(tpl)!;
    defer mem.free(tt);
    @expect_eq(tt, "");
    @expect_eq(doc.parent_element(doc.find(tpl, "i")), tpl);
    // quirks
    let mut q = parse("<p>x")!;
    defer q.deinit();
    @expect(q.mode == QuirksMode.QUIRKS);
}

fn round(text: []u8) ![]mut u8 {
    let mut doc = parse(text)!;
    defer doc.deinit();
    return doc.inner_html(doc.body());
}

test "serialization" {
    let cases: [8][2][]u8 = [
        ["<p class=\"a&quot;b\" title='<&>'>x &amp; y &lt; z</p>",
         "<p class=\"a&quot;b\" title=\"&lt;&amp;&gt;\">x &amp; y &lt; z</p>"],
        ["<br><img src=a.png><input disabled>", "<br><img src=\"a.png\"><input disabled=\"\">"],
        ["x<script>if (a < b && c) {}</script><style>p > a {}</style>",
         "x<script>if (a < b && c) {}</script><style>p > a {}</style>"],
        ["<textarea>a&lt;b</textarea>", "<textarea>a&lt;b</textarea>"],
        ["<svg viewbox=\"0 0 1 1\"><use xlink:href=#a /></svg>",
         "<svg viewBox=\"0 0 1 1\"><use xlink:href=\"#a\"></use></svg>"],
        ["x<template><td>x</td></template>", "x<template><td>x</td></template>"],
        ["a\xc2\xa0b<!--c-->", "a&nbsp;b<!--c-->"],
        ["<table><tr><td>1</table>", "<table><tbody><tr><td>1</td></tr></tbody></table>"],
    ];
    for c in cases {
        let got = round(c[0])!;
        defer mem.free(got);
        @expect_eq(got, c[1]);
    }
    let mut doc = parse("<!DOCTYPE html><html><head></head><body>x</body></html>")!;
    defer doc.deinit();
    let all = doc.to_html(0)!;
    defer mem.free(all);
    @expect_eq(all, "<!DOCTYPE html><html><head></head><body>x</body></html>");
}

test "selectors" {
    let text =
        "<div id=main class='a b'><p class=a>1</p><p lang=en-GB>2</p><span>3</span><p title='x y'>4</p></div><ul><li>a<li class=on>b<li>c<li>d</ul><a href=/x>l</a><a>m</a><input type=checkbox checked><svg><clipPath id=c /></svg>";
    let mut doc = parse(text)!;
    defer doc.deinit();
    let cases: [22][2][]u8 = [
        ["p", "1 2 4"],
        ["#main > p.a", "1"],
        ["div p", "1 2 4"],
        ["p + span", "3"],
        ["p ~ p", "2 4"],
        ["[lang|=en]", "2"],
        ["[title~=y]", "4"],
        ["[title^='x ']", "4"],
        ["li:nth-child(2n+1)", "a c"],
        ["li:nth-child(odd)", "a c"],
        ["li:nth-last-child(1)", "d"],
        ["li:not(.on):not(:first-child)", "c d"],
        ["li:first-child, li:last-child", "a d"],
        ["ul > :is(.on, :last-child)", "b d"],
        ["a:link", "l"],
        ["p:nth-of-type(2)", "2"],
        ["div > :only-of-type", "3"],
        ["span:first-child", ""],
        ["DIV#main.b", "(div)"],
        ["[href$=x]", "l"],
        ["clipPath", "(clipPath)"],
        [":checked", "(input)"],
    ];
    for c in cases {
        let ids = doc.query_all(c[0])!;
        defer mem.free(ids);
        let mut got = strs.String.init();
        defer got.deinit();
        for id in ids {
            if got.len > 0 {
                got.push(' ')!;
            }
            let t = doc.text_content(id)!;
            defer mem.free(t);
            if t.len > 0 {
                got.push_str(t)!;
            } else {
                got.push('(')!;
                got.push_str(doc.node(id).name)!;
                got.push(')')!;
            }
        }
        let want = c[1];
        if strs.eq(want, "(div)") {
            @expect_eq(ids.len, 1);
            @expect_eq(doc.node(ids[0]).name, "div");
            continue;
        }
        if not strs.eq(got.bytes(), want) {
            fmt.print("{}: got {} want {}\n", [fmt.str(c[0]), fmt.str(got.bytes()), fmt.str(want)]) catch {};
        }
        @expect_eq(got.bytes(), want);
    }
    @expect(doc.matches(doc.find(0, "span"), "div > span:nth-child(3)")!);
    @expect_eq(doc.query("nav")!, NONE);
    let bad: [6][]u8 = ["", "p >", "[x", ":nth-child(x)", "p::before", "a,,b"];
    for b in bad {
        _ = compile(b) catch continue;
        fmt.print("accepted: {}\n", [fmt.str(b)]) catch {};
        @expect(false);
    }
}

test "changing the tree" {
    let mut doc = parse("<ul><li>a</li></ul>")!;
    defer doc.deinit();
    let ul = doc.find(0, "ul");
    let li = doc.create_element("LI")!;
    doc.set_attr(li, "class", "new")!;
    doc.append_child(li, doc.create_text("b & c")!);
    doc.append_child(ul, li);
    let copy = doc.clone_tree(li)!;
    doc.set_attr(copy, "class", "copy")!;
    doc.set_attr(copy, "id", "z")!;
    doc.insert_before(ul, copy, doc.node(ul).first);
    doc.remove(doc.find(ul, "li"));  // the copy
    doc.remove_attr(li, "class")!;
    doc.append_child(ul, doc.create_comment("end")!);
    let s = doc.to_html(ul)!;
    defer mem.free(s);
    @expect_eq(s, "<ul><li>a</li><li>b &amp; c</li><!--end--></ul>");
}

test "fragments" {
    let mut f = parse_fragment("<td>x<td>y", "tr", Options.default())!;
    defer f.deinit();
    @expect(f.node(0).kind == Kind.FRAGMENT);
    let s = f.inner_html(0)!;
    defer mem.free(s);
    @expect_eq(s, "<td>x</td><td>y</td>");
    let mut g = parse_fragment("<path d=M0/>x</title>y", "svg title", Options.default())!;
    defer g.deinit();
    let t = g.inner_html(0)!;
    defer mem.free(t);
    // (svg title is an HTML integration point, so that path is HTML, and the
    // unquoted value takes the slash)
    @expect_eq(t, "<path d=\"M0/\">xy</path>");
    let mut h = parse_fragment("<path d='M0'/>x<clippath>", "svg g", Options.default())!;
    defer h.deinit();
    let u = h.inner_html(0)!;
    defer mem.free(u);
    @expect_eq(u, "<path d=\"M0\"></path>x<clipPath></clipPath>");
}

test "encodings" {
    // UTF-16LE with a byte-order mark
    let u16le: [22]u8 = [0xff, 0xfe, '<', 0, 'p', 0, '>', 0, 0xe9, 0, 0x3d, 0xd8, 0x00, 0xde, '<', 0, '/', 0, 'p', 0,
                         '>', 0];
    let mut a = parse_bytes(u16le[..], Options.default())!;
    defer a.deinit();
    let ta = a.text_content(a.find(0, "p"))!;
    defer mem.free(ta);
    @expect_eq(ta, "\xc3\xa9\xf0\x9f\x98\x80");
    let mut b = parse_bytes("<meta charset=\"windows-1252\"><p>\x80\xe9</p>", Options.default())!;
    defer b.deinit();
    let tb = b.text_content(b.find(0, "p"))!;
    defer mem.free(tb);
    @expect_eq(tb, "\xe2\x82\xac\xc3\xa9");
    let mut c = parse_bytes("<p>caf\xc3\xa9", Options.default())!;
    defer c.deinit();
    let tc = c.text_content(c.find(0, "p"))!;
    defer mem.free(tc);
    @expect_eq(tc, "caf\xc3\xa9");
    let mut d = parse_bytes("<p>caf\xe9", Options.default())!;  // not UTF-8: windows-1252
    defer d.deinit();
    let td = d.text_content(d.find(0, "p"))!;
    defer mem.free(td);
    @expect_eq(td, "caf\xc3\xa9");
    // invalid UTF-8 given to parse
    let mut e = parse("<p>a\xffb\r\nc")!;
    defer e.deinit();
    let te = e.text_content(e.find(0, "p"))!;
    defer mem.free(te);
    @expect_eq(te, "a\xef\xbf\xbdb\nc");
}

test "hostile input" {
    let mut s = strs.String.init();
    defer s.deinit();
    // deep nesting: the stack stops at MAX_DEPTH, and nothing recurses
    for _k in @as(usize, 0)..100000 {
        s.push_str("<div>")!;
    }
    for _k in @as(usize, 0)..20000 {
        s.push_str("</p>")!;
    }
    let mut d1 = parse(s.bytes())!;
    let h1 = d1.to_html(0)!;
    mem.free(h1);
    d1.deinit();
    // misnested formatting elements with distinct attributes
    s.clear();
    for k in @as(usize, 0)..20000 {
        fmt.write(s.writer(), "<p><b id={}><i>x</p>", [fmt.int(k)])!;
    }
    let mut d2 = parse(s.bytes())!;
    @expect(d2.nodes.len < 3000000);
    d2.deinit();
    // many attributes, most repeated
    s.clear();
    s.push_str("<p")!;
    for k in @as(usize, 0)..50000 {
        fmt.write(s.writer(), " a{}=1", [fmt.int(k % 1000)])!;
    }
    s.push_str(">")!;
    let mut d3 = parse(s.bytes())!;
    @expect_eq(d3.node(d3.find(0, "p")).attrs.len, 1000);
    d3.deinit();
    // long runs of things that look like references, tables and foster parenting
    s.clear();
    for _k in @as(usize, 0)..20000 {
        s.push_str("&aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa<table>x<tr>y<td>z</table>&#99999999999;")!;
    }
    let mut d4 = parse(s.bytes())!;
    d4.deinit();
}
