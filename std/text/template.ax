// =============================================================================
// std/text/template.ax - Mustache templates.
//
//     let mut doc = json.parse("{\"name\": \"Ada\", \"langs\": [\"en\", \"fr\"]}")!;
//     defer doc.deinit();
//     let page = template.render_alloc("Hi {{name}}!{{#langs}} {{.}}{{/langs}}", doc.root)!;
//     // "Hi Ada! en fr"
//
//     let mut t = template.Template.compile(src)!;     // compile once ...
//     defer t.deinit();
//     t.render(data, out)!;                            // ... render often
//     t.render_with(data, partials, out)!;             // with {{> name}}s
//
// The language is Mustache (https://mustache.github.io/mustache.5.html):
// {{name}} (HTML-escaped), {{{name}}} and {{& name}} (not escaped), dotted
// names (a.b.c) and {{.}} for the current value, sections {{#name}} ...
// {{/name}} (repeated for each element of an array, entered once for
// another true value, skipped for false, null, empty arrays and missing
// names), inverted sections {{^name}}, comments {{! ... }}, partials
// {{> name}} and set-delimiter tags {{=<% %>=}}; tags alone on their line
// leave no blank line behind. Data is a json.Value. It passes the required
// parts of the Mustache specification (1.4: comments, delimiters,
// interpolation, inverted sections, partials, sections); lambdas and the
// optional extensions are not supported.
//
// Templates run no code, so rendering untrusted templates is safe: the
// output is bounded by the template and data sizes, and partials may nest
// only MAX_DEPTH deep.
// =============================================================================

import "../collections/vec.ax" as vec;
import "../encoding/json.ax" as json;
import "../fmt.ax" as fmt;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../os/fs.ax" as fs;
import "../str.ax" as strs;

error { InvalidTemplate, TooDeep, OutOfMemory }

/// How deeply partials may include one another.
pub const MAX_DEPTH: u32 = 100;

/// A named partial, for {{> name}}.
pub struct Partial {
    name: []u8,
    source: []u8,
}

enum Kind: u8 {
    TEXT,
    VAR,  // escaped
    RAW,  // not escaped
    SECTION,
    INVERTED,
    PARTIAL,
}

struct Token {
    kind: Kind,
    text: []u8,    // the text, or the tag's name
    indent: []u8,  // for a standalone partial: the whitespace before it
    end: usize,    // for a section: the index after its closing tag
}

/// A parsed template; it refers to the source text, which must outlive it.
pub struct Template {
    tokens: []mut Token,

    /// Parses a template: InvalidTemplate for unclosed tags, unbalanced
    /// sections and bad delimiters.
    pub fn compile(src: []u8) !Template {
        let mut toks = vec.Vec.[Token].init();
        parse(src, &mut toks) catch |e| {
            toks.deinit();
            return e;
        };
        let out = mem.alloc.[Token](toks.len) catch |e| {
            toks.deinit();
            return e;
        };
        @mem_copy(out, toks.items());
        toks.deinit();
        return Template.{ tokens: out };
    }

    pub fn deinit(self: *mut Template) void {
        mem.free(self.tokens);
    }

    /// Renders the template with `data` as the context.
    pub fn render(self: *Template, data: json.Value, w: io.Writer) !void {
        self.render_with(data, NO_PARTIALS[..0], w)!;
    }

    /// render, with partials for {{> name}} (missing ones render nothing).
    pub fn render_with(self: *Template, data: json.Value, partials: []Partial, w: io.Writer) !void {
        let mut r = Renderer.{ stack: vec.Vec.[json.Value].init(), partials: partials, w: w, depth: 0 };
        defer r.stack.deinit();
        r.stack.push(data)!;
        r.run(self.tokens, 0, self.tokens.len)!;
    }
}

let NO_PARTIALS: [1]Partial = [Partial.{ name: "", source: "" }];

/// Parses and renders in one step.
pub fn render(src: []u8, data: json.Value, w: io.Writer) !void {
    render_with(src, data, NO_PARTIALS[..0], w)!;
}

pub fn render_with(src: []u8, data: json.Value, partials: []Partial, w: io.Writer) !void {
    let mut t = Template.compile(src)!;
    defer t.deinit();
    t.render_with(data, partials, w)!;
}

/// render, into a new string the caller frees.
pub fn render_alloc(src: []u8, data: json.Value) ![]mut u8 {
    return render_with_alloc(src, data, NO_PARTIALS[..0])!;
}

pub fn render_with_alloc(src: []u8, data: json.Value, partials: []Partial) ![]mut u8 {
    let mut s = strs.String.init();
    render_with(src, data, partials, s.writer()) catch |e| {
        s.deinit();
        return e;
    };
    return s.take();
}

// -----------------------------------------------------------------------------
// Parsing
// -----------------------------------------------------------------------------

fn is_blank(c: u8) bool {
    return (c == ' ') or (c == '\t');
}

fn trim(s: []u8) []u8 {
    let mut a: usize = 0;
    let mut b = s.len;
    while (a < b) and strs.is_space(s[a]) {
        a += 1;
    }
    while (b > a) and strs.is_space(s[b - 1]) {
        b -= 1;
    }
    return s[a..b];
}

fn ended(f: *mut strs.Fields) bool {
    _ = f.next() catch return true;
    return false;
}

fn parse(src: []u8, toks: *mut vec.Vec.[Token]) !void {
    let mut otag: []u8 = "{{";
    let mut ctag: []u8 = "}}";
    let mut open = vec.Vec.[usize].init();  // the open sections' tokens
    defer open.deinit();
    let mut pos: usize = 0;
    let mut line_tagged: usize = 0;  // where the last tag ended (a line with an earlier tag has no standalone tag)
    while pos < src.len {
        let t = strs.index_of_from(src, otag, pos) catch {
            toks.push(Token.{ kind: Kind.TEXT, text: src[pos..], indent: "", end: 0 })!;
            break;
        };
        // the tag: its kind and content
        let mut i = t + otag.len;
        let mut sigil: u8 = 0;
        if i < src.len {
            let c = src[i];
            if (((c == '#') or (c == '^')) or ((c == '/') or (c == '!'))) or
               (((c == '>') or (c == '=')) or ((c == '{') or (c == '&'))) {
                sigil = c;
                i += 1;
            }
        }
        let mut close = ctag;
        let mut extra: []u8 = "";
        if sigil == '{' {
            extra = "}";
        } else if sigil == '=' {
            extra = "=";
        }
        let mut e: usize = 0;
        let mut body: []u8 = "";
        if extra.len > 0 {
            // "}}}" or "=}}": find the pair
            let mut k = i;
            while true {
                let at = strs.index_of_from(src, close, k) catch return error.InvalidTemplate;
                if (at >= (i + extra.len)) and strs.eq(src[at - extra.len..at], extra) {
                    body = src[i..at - extra.len];
                    e = at + close.len;
                    break;
                }
                k = at + 1;
            }
        } else {
            let at = strs.index_of_from(src, close, i) catch return error.InvalidTemplate;
            body = src[i..at];
            e = at + close.len;
        }
        // standalone: alone on its line but for blanks
        let mut ls = t;
        while (ls > 0) and (src[ls - 1] != '\n') {
            ls -= 1;
        }
        let mut standalone = false;
        let mut after = e;
        if ((((sigil == '#') or (sigil == '^')) or ((sigil == '/') or (sigil == '!'))) or
            ((sigil == '>') or (sigil == '='))) and (ls >= line_tagged) {
            let mut blank = true;
            for c in src[ls..t] {
                if not is_blank(c) {
                    blank = false;
                }
            }
            let mut j = e;
            while (j < src.len) and is_blank(src[j]) {
                j += 1;
            }
            if blank {
                if j == src.len {
                    standalone = true;
                    after = j;
                } else if src[j] == '\n' {
                    standalone = true;
                    after = j + 1;
                } else if ((j + 1) < src.len) and ((src[j] == '\r') and (src[j + 1] == '\n')) {
                    standalone = true;
                    after = j + 2;
                }
            }
        }
        let mut text_end = t;
        let mut indent: []u8 = "";
        if standalone {
            text_end = ls;
            indent = src[ls..t];
        }
        if text_end > pos {
            toks.push(Token.{ kind: Kind.TEXT, text: src[pos..text_end], indent: "", end: 0 })!;
        }
        pos = after;
        line_tagged = e;
        let name = trim(body);
        if sigil == '!' {
            continue;
        }
        if sigil == '=' {
            // new delimiters: two words, without "="
            let mut f = strs.fields(name);
            let a = f.next() catch return error.InvalidTemplate;
            let b = f.next() catch return error.InvalidTemplate;
            if not ended(&mut f) or strs.contains(a, "=") or strs.contains(b, "=") {
                return error.InvalidTemplate;
            }
            otag = a;
            ctag = b;
            continue;
        }
        if (sigil == '#') or (sigil == '^') {
            let mut kind = Kind.SECTION;
            if sigil == '^' {
                kind = Kind.INVERTED;
            }
            open.push(toks.len)!;
            toks.push(Token.{ kind: kind, text: name, indent: "", end: 0 })!;
            continue;
        }
        if sigil == '/' {
            let k = open.pop() catch return error.InvalidTemplate;
            if not strs.eq(toks.items()[k].text, name) {
                return error.InvalidTemplate;
            }
            toks.items()[k].end = toks.len;
            continue;
        }
        if sigil == '>' {
            toks.push(Token.{ kind: Kind.PARTIAL, text: name, indent: indent, end: 0 })!;
            continue;
        }
        let mut kind = Kind.VAR;
        if (sigil == '{') or (sigil == '&') {
            kind = Kind.RAW;
        }
        if name.len == 0 {
            return error.InvalidTemplate;
        }
        toks.push(Token.{ kind: kind, text: name, indent: "", end: 0 })!;
    }
    if open.len > 0 {
        return error.InvalidTemplate;
    }
}

// -----------------------------------------------------------------------------
// Rendering
// -----------------------------------------------------------------------------

struct Renderer {
    stack: vec.Vec.[json.Value],  // the context, innermost last
    partials: []Partial,
    w: io.Writer,
    depth: u32,

    fn run(self: *mut Renderer, toks: []Token, from: usize, to: usize) !void {
        let mut k = from;
        while k < to {
            let t = toks[k];
            if t.kind == Kind.TEXT {
                self.w.write_all(t.text)!;
                k += 1;
                continue;
            }
            if (t.kind == Kind.VAR) or (t.kind == Kind.RAW) {
                let v = self.lookup(t.text);
                write_value(self.w, v, t.kind == Kind.VAR)!;
                k += 1;
                continue;
            }
            if t.kind == Kind.PARTIAL {
                self.partial(t.text, t.indent)!;
                k += 1;
                continue;
            }
            // a section: its tokens are k + 1 .. t.end
            let v = self.lookup(t.text);
            let truthy = is_truthy(v);
            if t.kind == Kind.INVERTED {
                if not truthy {
                    self.run(toks, k + 1, t.end)!;
                }
            } else if truthy {
                match v {
                    .Array(xs) => {
                        for x in xs {
                            self.stack.push(x)!;
                            let r = self.run(toks, k + 1, t.end);
                            _ = self.stack.pop() catch json.Value.Null;
                            r!;
                        }
                    }
                    else => {
                        self.stack.push(v)!;
                        let r = self.run(toks, k + 1, t.end);
                        _ = self.stack.pop() catch json.Value.Null;
                        r!;
                    }
                }
            }
            k = t.end;
        }
    }

    // The value of a name: "." is the current value; otherwise the first
    // part is looked for from the innermost context out, and the rest
    // inside it. Missing names are Null.
    fn lookup(self: *Renderer, name: []u8) json.Value {
        let items = self.stack.items();
        if strs.eq(name, ".") {
            return items[items.len - 1];
        }
        let mut dot = strs.index_of_byte(name, '.') catch name.len;
        let first = name[..dot];
        let mut v = json.Value.Null;
        let mut found = false;
        let mut i = items.len;
        while i > 0 {
            i -= 1;
            let got = items[i].get(first) catch continue;
            v = got;
            found = true;
            break;
        }
        if not found {
            return json.Value.Null;
        }
        while dot < name.len {
            let rest = name[dot + 1..];
            let next = strs.index_of_byte(rest, '.') catch rest.len;
            v = v.get(rest[..next]) catch return json.Value.Null;
            dot = dot + 1 + next;
        }
        return v;
    }

    fn partial(self: *mut Renderer, name: []u8, indent: []u8) !void {
        let mut src: []u8 = "";
        let mut found = false;
        for p in self.partials {
            if strs.eq(p.name, name) {
                src = p.source;
                found = true;
            }
        }
        if not found {
            return;
        }
        if self.depth >= MAX_DEPTH {
            return error.TooDeep;
        }
        // the indentation goes before each line of the partial's source
        let mut text = strs.String.init();
        defer text.deinit();
        if indent.len > 0 {
            let mut start = true;
            for c in src {
                if start {
                    text.push_str(indent)!;
                }
                text.push(c)!;
                start = c == '\n';
            }
            src = text.bytes();
        }
        let mut t = Template.compile(src)!;
        defer t.deinit();
        self.depth += 1;
        let r = self.run(t.tokens, 0, t.tokens.len);
        self.depth -= 1;
        r!;
    }
}

fn is_truthy(v: json.Value) bool {
    match v {
        .Null      => { return false; }
        .Bool(b)   => { return b; }
        .Array(xs) => { return xs.len > 0; }
        else       => { return true; }
    }
}

fn write_value(w: io.Writer, v: json.Value, escape: bool) !void {
    let mut buf: [40]u8 = [0; 40];
    match v {
        .Null => {}
        .Bool(b) => {
            if b {
                w.write_all("true")!;
            } else {
                w.write_all("false")!;
            }
        }
        .Int(n)   => { w.write_all(fmt.format_int(buf[..], n))!; }
        .Float(f) => { w.write_all(fmt.format_float(buf[..], f)!)!; }
        .String(s) => {
            if escape {
                write_escaped(w, s)!;
            } else {
                w.write_all(s)!;
            }
        }
        else => {
            // arrays and objects as JSON
            let s = json.stringify(v)!;
            defer mem.free(s);
            if escape {
                write_escaped(w, s)!;
            } else {
                w.write_all(s)!;
            }
        }
    }
}

/// Writes s with &, <, >, " and ' escaped for HTML.
pub fn write_escaped(w: io.Writer, s: []u8) !void {
    let mut start: usize = 0;
    for i in @as(usize, 0)..s.len {
        let c = s[i];
        let mut rep: []u8 = "";
        if c == '&' {
            rep = "&amp;";
        } else if c == '<' {
            rep = "&lt;";
        } else if c == '>' {
            rep = "&gt;";
        } else if c == '"' {
            rep = "&quot;";
        } else if c == '\'' {
            rep = "&#39;";
        } else {
            continue;
        }
        w.write_all(s[start..i])!;
        w.write_all(rep)!;
        start = i + 1;
    }
    w.write_all(s[start..])!;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn run_spec(path: []u8) !usize {
    let text = fs.read_file(path) catch return 0;
    defer mem.free(text);
    let mut doc = json.parse(text)!;
    defer doc.deinit();
    let tests = doc.root.get("tests")!.as_array()!;
    let mut n: usize = 0;
    for t in tests {
        let src = t.get("template")!.as_str()!;
        let want = t.get("expected")!.as_str()!;
        let mut parts = vec.Vec.[Partial].init();
        defer parts.deinit();
        let ps = t.get("partials") catch json.Value.Null;
        match ps {
            .Object(ms) => {
                for m in ms {
                    parts.push(Partial.{ name: m.key, source: m.value.as_str()! })!;
                }
            }
            else => {}
        }
        let got = render_with_alloc(src, t.get("data")!, parts.items())!;
        defer mem.free(got);
        if not strs.eq(got, want) {
            @expect_eq(t.get("name")!.as_str()!, "");
        }
        n += 1;
    }
    return n;
}

test "the Mustache specification" {
    let files: [6][]u8 = ["comments", "delimiters", "interpolation", "inverted", "partials", "sections"];
    let mut total: usize = 0;
    for f in files {
        let mut p = strs.String.init();
        defer p.deinit();
        p.push_str("std/text/template/testdata/")!;
        p.push_str(f)!;
        p.push_str(".json")!;
        total += run_spec(p.bytes())!;
    }
    @expect((total == 0) or (total == 136));
}

test "examples" {
    let mut doc =
        json.parse("{\"name\": \"Ada\", \"langs\": [\"en\", \"fr\"], \"html\": \"<b>'&'</b>\", \"n\": 3, \"x\": 1.5}")!;
    defer doc.deinit();
    let a = render_alloc("Hi {{name}}!{{#langs}} {{.}}{{/langs}}", doc.root)!;
    defer mem.free(a);
    @expect_eq(a, "Hi Ada! en fr");
    let b = render_alloc("{{html}} {{{html}}} {{n}} {{x}} {{missing}}|{{^missing}}none{{/missing}}", doc.root)!;
    defer mem.free(b);
    @expect_eq(b, "&lt;b&gt;&#39;&amp;&#39;&lt;/b&gt; <b>'&'</b> 3 1.5 |none");
    let bad: [5][]u8 = ["{{#a}}", "{{/a}}", "{{#a}}{{/b}}", "{{name", "{{=<% %>"];
    for s in bad {
        @expect(invalid(render_alloc(s, doc.root)));
    }
    // a partial that includes itself stops at MAX_DEPTH
    let loop_: [1]Partial = [Partial.{ name: "p", source: "x{{>p}}" }];
    let r = render_with_alloc("{{>p}}", doc.root, loop_[..]);
    @expect(too_deep(r));
}

fn too_deep(r: ![]mut u8) bool {
    let x = r catch |e| return e == error.TooDeep;
    mem.free(x);
    return false;
}

fn invalid(r: ![]mut u8) bool {
    let x = r catch |e| return e == error.InvalidTemplate;
    mem.free(x);
    return false;
}
