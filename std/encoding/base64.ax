// =============================================================================
// std/encoding/base64.ax - Base64 (RFC 4648), standard and URL-safe alphabets.
//
//     let n = base64.encoded_len(data.len);
//     base64.encode(data, out[..n], base64.STANDARD);
//     let bytes = base64.decode(text, out, base64.STANDARD)!;
//     let owned = base64.decode_alloc(text, base64.STANDARD)!;  // mem.free
//     base64.encode_to(w, data, base64.STANDARD)!;  // to an io.Writer
// =============================================================================

import "../io.ax" as io;
import "../mem.ax" as mem;

error { InvalidBase64, NoSpaceLeft, OutOfMemory }

pub struct Encoding {
    alphabet: []u8,
    pad: bool,
}

pub let STANDARD: Encoding = Encoding.{ alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/",
                                        pad: true };
pub let URL: Encoding = Encoding.{ alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_",
                                   pad: false };

/// The length of the encoding of n bytes.
pub fn encoded_len_with(n: usize, enc: Encoding) usize {
    if enc.pad {
        return ((n + 2) / 3) * 4;
    }
    return ((n * 4) + 2) / 3;
}

/// The length of the standard (padded) encoding of n bytes.
pub fn encoded_len(n: usize) usize {
    return ((n + 2) / 3) * 4;
}

/// Encodes data into out, which must be encoded_len_with(data.len) long.
pub fn encode(data: []u8, out: []mut u8, enc: Encoding) []u8 {
    let a = enc.alphabet;
    let mut o: usize = 0;
    let mut i: usize = 0;
    while (i + 3) <= data.len {
        let v = ((@as(u32, data[i]) << 16) | (@as(u32, data[i + 1]) << 8)) | @as(u32, data[i + 2]);
        out[o] = a[@as(usize, (v >> 18) & 63)];
        out[o + 1] = a[@as(usize, (v >> 12) & 63)];
        out[o + 2] = a[@as(usize, (v >> 6) & 63)];
        out[o + 3] = a[@as(usize, v & 63)];
        o += 4;
        i += 3;
    }
    let rest = data.len - i;
    if rest > 0 {
        let mut v = @as(u32, data[i]) << 16;
        if rest == 2 {
            v = v | (@as(u32, data[i + 1]) << 8);
        }
        out[o] = a[@as(usize, (v >> 18) & 63)];
        out[o + 1] = a[@as(usize, (v >> 12) & 63)];
        o += 2;
        if rest == 2 {
            out[o] = a[@as(usize, (v >> 6) & 63)];
            o += 1;
        }
        if enc.pad {
            while (o % 4) != 0 {
                out[o] = '=';
                o += 1;
            }
        }
    }
    return out[..o];
}

/// Encodes into new memory (free it with mem.free).
pub fn encode_alloc(data: []u8, enc: Encoding) ![]mut u8 {
    let out = mem.alloc.[u8](encoded_len_with(data.len, enc))!;
    _ = encode(data, out, enc);
    return out;
}

/// Encodes data to w, a kilobyte of text at a time.
pub fn encode_to(w: io.Writer, data: []u8, enc: Encoding) !void {
    let mut buf: [1024]u8 = [0; 1024];
    let mut i: usize = 0;
    while (data.len - i) > 768 {
        w.write_all(encode(data[i..i + 768], buf[..], enc))!;
        i += 768;
    }
    w.write_all(encode(data[i..], buf[..], enc))!;
}

fn value_of(c: u8, enc: *Encoding) u32 {
    if (c >= 'A') and (c <= 'Z') {
        return @as(u32, c - 'A');
    }
    if (c >= 'a') and (c <= 'z') {
        return @as(u32, c - 'a') + 26;
    }
    if (c >= '0') and (c <= '9') {
        return @as(u32, c - '0') + 52;
    }
    if c == enc.alphabet[62] {
        return 62;
    }
    if c == enc.alphabet[63] {
        return 63;
    }
    return 64;
}

/// The most bytes that len characters can decode to.
pub fn decoded_len(len: usize) usize {
    return ((len + 3) / 4) * 3;
}

/// Decodes text into out (decoded_len(text.len) bytes suffice). Whitespace
/// is skipped; padding is optional; anything else fails with
/// InvalidBase64.
pub fn decode(text: []u8, out: []mut u8, enc: Encoding) ![]u8 {
    let mut acc: u32 = 0;
    let mut nbits: u32 = 0;
    let mut o: usize = 0;
    let mut padding: u32 = 0;
    let mut chars: usize = 0;
    // whole groups of four go through a table; anything else (white space,
    // padding, errors) the careful way below, a character at a time
    let mut rev: [256]u8 = [0xff; 256];
    if text.len >= 64 {
        for k in @as(usize, 0)..256 {
            rev[k] = @truncate(u8, @min(value_of(@truncate(u8, k), &enc), 0xff));
        }
    }
    let mut i: usize = 0;
    while i < text.len {
        if (nbits == 0) and (padding == 0) and ((i + 4) <= text.len) and ((o + 3) <= out.len) {
            let a = @as(u32, rev[@as(usize, text[i])]);
            let b = @as(u32, rev[@as(usize, text[i + 1])]);
            let c3 = @as(u32, rev[@as(usize, text[i + 2])]);
            let d = @as(u32, rev[@as(usize, text[i + 3])]);
            if (((a | b) | c3) | d) <= 63 {
                let v = (((a << 18) | (b << 12)) | (c3 << 6)) | d;
                out[o] = @truncate(u8, v >> 16);
                out[o + 1] = @truncate(u8, v >> 8);
                out[o + 2] = @truncate(u8, v);
                o += 3;
                chars += 4;
                i += 4;
                continue;
            }
        }
        let c = text[i];
        i += 1;
        if (c == ' ') or (c == '\n') or (c == '\r') or (c == '\t') {
            continue;
        }
        if c == '=' {
            padding += 1;
            continue;
        }
        if padding > 0 {
            return error.InvalidBase64;  // data after padding
        }
        let v = value_of(c, &enc);
        if v > 63 {
            return error.InvalidBase64;
        }
        chars += 1;
        acc = (acc << 6) | v;
        nbits += 6;
        if nbits >= 8 {
            nbits -= 8;
            if o >= out.len {
                return error.NoSpaceLeft;
            }
            out[o] = @truncate(u8, acc >> nbits);
            o += 1;
        }
    }
    // leftover bits must be zero and fewer than a byte
    if (nbits >= 6) or ((acc & ((@as(u32, 1) << nbits) - 1)) != 0) or (padding > 2) {
        return error.InvalidBase64;
    }
    // padding, if any, is exactly what completes the last group
    if (padding > 0) and (@as(usize, padding) != ((4 - (chars % 4)) % 4)) {
        return error.InvalidBase64;
    }
    return out[..o];
}

/// Decodes into new memory (free it with mem.free).
pub fn decode_alloc(text: []u8, enc: Encoding) ![]mut u8 {
    let buf = mem.alloc.[u8](decoded_len(text.len))!;
    let got = decode(text, buf, enc) catch |e| {
        mem.free(buf);
        return e;
    };
    return mem.realloc(buf, got.len) catch |e| {
        mem.free(buf);
        return e;
    };
}

test "rfc 4648 vectors" {
    let ins: [7][]u8 = ["", "f", "fo", "foo", "foob", "fooba", "foobar"];
    let outs: [7][]u8 = ["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy"];
    let mut b: [16]u8 = [0; 16];
    let mut d: [16]u8 = [0; 16];
    for i in 0..ins.len {
        let e = encode(ins[i], b[..encoded_len(ins[i].len)], STANDARD);
        @expect_eq(e, outs[i]);
        @expect_eq(decode(e, d[..], STANDARD)!, ins[i]);
    }
    @expect_eq(encode("\xfb\xff", b[..encoded_len_with(2, URL)], URL), "-_8");
    @expect_eq(decode("-_8", d[..], URL)!, "\xfb\xff");
    @expect_eq(decode("Zm9v\nYmFy\n", d[..], STANDARD)!, "foobar");
    let bad: [4][]u8 = ["Zm9v!", "Zg=x", "Zh==", "Z"];
    for s in bad {
        _ = decode(s, d[..], STANDARD) catch continue;
        @trap();
    }
    let owned = decode_alloc("aGVsbG8=", STANDARD)!;
    defer mem.free(owned);
    @expect_eq(owned, "hello");
}

test "padding must be exact" {
    let mut out: [16]u8 = [0; 16];
    @expect(@mem_eq(decode("Zm8=", out[..], STANDARD)!, "fo"));
    @expect(@mem_eq(decode("Zm8", out[..], STANDARD)!, "fo"));
    @expect(@mem_eq(decode("Zm9v", out[..], STANDARD)!, "foo"));
    _ = decode("Zm8==", out[..], STANDARD) catch |e| {
        @expect(e == error.InvalidBase64);
        _ = decode("Zm9v==", out[..], STANDARD) catch return;
        @expect(false);
        return;
    };
    @expect(false);
}

test "long input, with line breaks, padding and errors" {
    let mut data: [301]u8 = [0; 301];
    for i in @as(usize, 0)..data.len {
        data[i] = @truncate(u8, (i * 167) + 13);
    }
    let mut e: [404]u8 = [0; 404];
    let enc = encode(data[..], e[..encoded_len(data.len)], STANDARD);
    let mut d: [310]u8 = [0; 310];
    @expect_eq(decode(enc, d[..], STANDARD)!, data[..]);
    // a line break every 76 characters
    let mut wrapped: [420]u8 = [0; 420];
    let mut n: usize = 0;
    for i in @as(usize, 0)..enc.len {
        if (i > 0) and ((i % 76) == 0) {
            wrapped[n] = '\n';
            n += 1;
        }
        wrapped[n] = enc[i];
        n += 1;
    }
    @expect_eq(decode(wrapped[..n], d[..], STANDARD)!, data[..]);
    // a bad character deep inside, and data after the padding
    wrapped[200] = '*';
    @expect(failed(decode(wrapped[..n], d[..], STANDARD)));
    let mut padded: [410]u8 = [0; 410];
    @mem_copy(padded[..enc.len], enc);
    @mem_copy(padded[enc.len..enc.len + 4], "Zm9v");
    @expect(failed(decode(padded[..enc.len + 4], d[..], STANDARD)));
    // too little room
    @expect(failed(decode(enc, d[..300], STANDARD)));
}

test "encode_to matches encode_alloc" {
    let mut data: [2000]u8 = [0; 2000];
    for i in @as(usize, 0)..data.len {
        data[i] = @truncate(u8, (i * 89) + 7);
    }
    let lens: [5]usize = [0, 1, 768, 769, 2000];
    for n in lens {
        let a = encode_alloc(data[..n], URL)!;
        defer mem.free(a);
        let mut out: [2700]u8 = [0; 2700];
        let mut bw = io.BufferWriter.init(out[..]);
        encode_to(bw.writer(), data[..n], URL)!;
        @expect_eq(bw.written(), a);
    }
    let mut small: [10]u8 = [0; 10];
    let mut sw = io.BufferWriter.init(small[..]);
    encode_to(sw.writer(), data[..], STANDARD) catch |e| {
        @expect_eq(e, error.NoSpaceLeft);
        return;
    };
    @trap();
}

fn failed(r: ![]u8) bool {
    _ = r catch return true;
    return false;
}
