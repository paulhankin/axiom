// =============================================================================
// std/encoding/ini.ax - INI configuration files.
//
//     let mut doc = ini.parse(text)!;
//     defer doc.deinit();
//     let host = doc.get("server", "host")!;          // "" for keys before any [section]
//     let port = doc.get_i64("server", "port")!;
//     let debug = doc.get_bool("app", "debug") catch false;
//
// The dialect is Python configparser's common ground: [section] headers,
// `key = value` or `key: value`, comments on lines of their own starting
// with ; or #, and indented lines continuing the previous value. Names of
// sections and keys compare without regard to ASCII case; the last of
// duplicate keys wins. Values are trimmed, and one pair of surrounding
// quotes is removed.
// =============================================================================

import "../collections/arena.ax" as arena;
import "../collections/vec.ax" as vec;
import "../fmt.ax" as fmt;
import "../io.ax" as io;
import "../str.ax" as strs;

error { SyntaxError, NotFound, WrongType, OutOfMemory }

pub struct Entry {
    key: []u8,
    value: []u8,
}

pub struct Section {
    name: []u8,
    entries: []Entry,
}

pub struct Document {
    sections: []Section,  // in order; the first is "" (keys before any header)
    arena: arena.Arena,

    pub fn deinit(self: *mut Document) void {
        self.arena.deinit();
    }

    pub fn section(self: *Document, name: []u8) !Section {
        let mut i = self.sections.len;
        while i > 0 {
            i -= 1;
            if strs.eq_ignore_case(self.sections[i].name, name) {
                return self.sections[i];
            }
        }
        return error.NotFound;
    }

    pub fn has(self: *Document, section: []u8, key: []u8) bool {
        _ = self.get(section, key) catch return false;
        return true;
    }

    /// The value of key in section (the last one, if repeated anywhere).
    pub fn get(self: *Document, section: []u8, key: []u8) ![]u8 {
        let mut i = self.sections.len;
        while i > 0 {
            i -= 1;
            let s = self.sections[i];
            if not strs.eq_ignore_case(s.name, section) {
                continue;
            }
            let mut k = s.entries.len;
            while k > 0 {
                k -= 1;
                if strs.eq_ignore_case(s.entries[k].key, key) {
                    return s.entries[k].value;
                }
            }
        }
        return error.NotFound;
    }

    pub fn get_i64(self: *Document, section: []u8, key: []u8) !i64 {
        let v = self.get(section, key)!;
        return fmt.parse_int.[i64](v) catch return error.WrongType;
    }

    pub fn get_f64(self: *Document, section: []u8, key: []u8) !f64 {
        let v = self.get(section, key)!;
        return fmt.parse_float(v) catch return error.WrongType;
    }

    /// true for 1, yes, true, on; false for 0, no, false, off (any case).
    pub fn get_bool(self: *Document, section: []u8, key: []u8) !bool {
        let v = self.get(section, key)!;
        for t in ["1", "yes", "true", "on"]{
            if strs.eq_ignore_case(v, t) {
                return true;
            }
        }
        for f in ["0", "no", "false", "off"]{
            if strs.eq_ignore_case(v, f) {
                return false;
            }
        }
        return error.WrongType;
    }
}

/// Where parsing failed.
pub struct ErrorInfo {
    line: u32,
    message: []u8,
}

pub fn parse(text: []u8) !Document {
    let mut info = ErrorInfo.{ line: 0, message: "" };
    return parse_with(text, &mut info);
}

pub fn parse_with(text: []u8, info: *mut ErrorInfo) !Document {
    let mut doc = Document.{ sections: @slice_from_ptr(@ptr_from_int(*Section, 8), 0), arena: arena.Arena.init() };
    parse_into(text, &mut doc, info) catch |e| {
        doc.arena.deinit();
        return e;
    };
    return doc;
}

fn unquote(v: []u8) []u8 {
    if (v.len >= 2) and (((v[0] == '"') and (v[v.len - 1] == '"')) or ((v[0] == '\'') and (v[v.len - 1] == '\''))) {
        return v[1..v.len - 1];
    }
    return v;
}

fn parse_into(text0: []u8, doc: *mut Document, info: *mut ErrorInfo) !void {
    let mut text = text0;
    if (text.len >= 3) and (text[0] == 0xef) and (text[1] == 0xbb) and (text[2] == 0xbf) {
        text = text[3..];
    }
    let mut sections = vec.Vec.[Section].init();
    defer sections.deinit();
    let mut entries = vec.Vec.[Entry].init();
    defer entries.deinit();
    let mut value = strs.String.init();
    defer value.deinit();
    let mut name: []u8 = "";
    let mut key: []u8 = "";
    let mut have_key = false;
    let mut lines = strs.lines(text);
    let mut ln: u32 = 0;
    while true {
        let raw = lines.next() catch break;
        ln += 1;
        let t = strs.trim(raw);
        let indented = (raw.len > 0) and ((raw[0] == ' ') or (raw[0] == '\t'));
        if (t.len == 0) or (t[0] == ';') or (t[0] == '#') {
            if t.len == 0 {
                // a blank line ends a continued value
                if have_key {
                    finish(doc, &mut entries, key, value.bytes())!;
                    have_key = false;
                }
            }
            continue;
        }
        if indented and have_key {
            value.push('\n')!;
            value.push_str(t)!;
            continue;
        }
        if have_key {
            finish(doc, &mut entries, key, value.bytes())!;
            have_key = false;
        }
        if t[0] == '[' {
            if t[t.len - 1] != ']' {
                info.line = ln;
                info.message = "unterminated section header";
                return error.SyntaxError;
            }
            sections.push(Section.{ name: name, entries: doc.arena.copy.[Entry](entries.items())! })!;
            entries.clear();
            name = doc.arena.dup(strs.trim(t[1..t.len - 1]))!;
            continue;
        }
        let eq = strs.index_of_any(t, "=:") catch t.len;
        let k = strs.trim(t[..eq]);
        if k.len == 0 {
            info.line = ln;
            info.message = "missing key";
            return error.SyntaxError;
        }
        key = doc.arena.dup(k)!;
        value.clear();
        if eq < t.len {
            value.push_str(strs.trim(t[eq + 1..]))!;
        }
        have_key = true;
    }
    if have_key {
        finish(doc, &mut entries, key, value.bytes())!;
    }
    sections.push(Section.{ name: name, entries: doc.arena.copy.[Entry](entries.items())! })!;
    doc.sections = doc.arena.copy.[Section](sections.items())!;
}

fn finish(doc: *mut Document, entries: *mut vec.Vec.[Entry], key: []u8, v: []u8) !void {
    entries.push(Entry.{ key: key, value: doc.arena.dup(unquote(v))! })!;
}

/// Writes INI text: call section() and entry() in order.
pub struct Writer {
    out: io.Writer,
    started: bool,

    pub fn init(out: io.Writer) Writer {
        return Writer.{ out: out, started: false };
    }

    pub fn section(self: *mut Writer, name: []u8) !void {
        if self.started {
            self.out.write_all("\n")!;
        }
        self.out.write_all("[")!;
        self.out.write_all(name)!;
        self.out.write_all("]\n")!;
        self.started = true;
    }

    /// key = value; a value with line breaks is written as continuation
    /// lines, and one with spaces at either end is quoted.
    pub fn entry(self: *mut Writer, key: []u8, value: []u8) !void {
        self.out.write_all(key)!;
        self.out.write_all(" = ")!;
        let pad = (value.len > 0) and ((value[0] == ' ') or (value[value.len - 1] == ' ') or (value[0] == '"'));
        if pad {
            self.out.write_all("\"")!;
        }
        let mut it = strs.split(value, "\n");
        let mut first = true;
        while true {
            let part = it.next() catch break;
            if not first {
                self.out.write_all("\n    ")!;
            }
            self.out.write_all(part)!;
            first = false;
        }
        if pad {
            self.out.write_all("\"")!;
        }
        self.out.write_all("\n")!;
        self.started = true;
    }
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

test "ini" {
    let text =
        "; global\nname = demo\n\n[Server]\nhost = example.org\nport: 8080\ndebug = Yes\n# note\npath = \"/srv \"\n[paths]\nlist = a\n  b\n  c\nempty\nport = 1\n[server]\nport = 9090\n";
    let mut doc = parse(text)!;
    defer doc.deinit();
    @expect_eq(doc.get("", "name")!, "demo");
    @expect_eq(doc.get("server", "HOST")!, "example.org");
    @expect_eq(doc.get_i64("SERVER", "port")!, 9090);  // the later section wins
    @expect(doc.get_bool("server", "debug")!);
    @expect_eq(doc.get("server", "path")!, "/srv ");
    @expect_eq(doc.get("paths", "list")!, "a\nb\nc");
    @expect_eq(doc.get("paths", "empty")!, "");
    @expect(not doc.has("paths", "missing"));
    @expect_eq(doc.sections.len, 4);
    @expect_eq(doc.section("paths")!.entries.len, 3);
    let mut info = ErrorInfo.{ line: 0, message: "" };
    _ = parse_with("a=1\n[bad\n", &mut info) catch |e| {
        @expect_eq(e, error.SyntaxError);
        @expect_eq(info.line, 2);
        return;
    };
    @trap();
}

test "writing" {
    let mut s = strs.String.init();
    defer s.deinit();
    let mut w = Writer.init(s.writer());
    w.section("main")!;
    w.entry("a", "1")!;
    w.entry("lines", "x\ny")!;
    w.section("more")!;
    w.entry("sp", " padded ")!;
    @expect_eq(s.bytes(), "[main]\na = 1\nlines = x\n    y\n\n[more]\nsp = \" padded \"\n");
    let mut doc = parse(s.bytes())!;
    defer doc.deinit();
    @expect_eq(doc.get("main", "lines")!, "x\ny");
    @expect_eq(doc.get("more", "sp")!, " padded ");
}
