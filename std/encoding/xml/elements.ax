// =============================================================================
// std/encoding/xml/elements.ax - Start/end tags, attribute parsing and defaults,
// and XML namespace scope resolution, part of std/encoding/xml.
// =============================================================================

import "../../collections/map.ax" as maps;
import "../../collections/vec.ax" as vec;
import "../../hash.ax" as hash;
import "../../str.ax" as strs;

// -----------------------------------------------------------------------------
// Namespace scopes
// -----------------------------------------------------------------------------

struct Binding {
    prefix: []u8,
    uri: []u8,
    depth: usize,  // the element depth that declared it
    prev: usize,   // the binding of the same prefix it hides, or NONE
}

// Namespace bindings in scope: a stack, and each prefix's latest binding, so
// that a lookup does not scan the stack.
nocopy struct Scope {
    stack: vec.Vec.[Binding],
    latest: maps.Map.[[]u8, usize, hash.hash_bytes, hash.eq_bytes],  // prefix -> index in stack

    fn init() Scope {
        return Scope.{
            stack: vec.Vec.[Binding].init(), latest: maps.Map.[[]u8, usize, hash.hash_bytes, hash.eq_bytes].init() };
    }

    fn deinit(self: *mut Scope) void {
        self.stack.deinit();
        self.latest.deinit();
    }

    // The URI bound to prefix, or "" for none.
    fn uri(self: *Scope, prefix: []u8) []u8 {
        let i = self.latest.get(prefix) ?? return "";
        return self.stack.get(i).uri;
    }

    fn push(self: *mut Scope, prefix: []u8, uri: []u8, depth: usize) XmlError!void {
        let prev = self.latest.get(prefix) ?? NONE;
        self.stack.push(Binding.{ prefix: prefix, uri: uri, depth: depth, prev: prev })!;
        self.latest.put(prefix, self.stack.len() - 1) catch |e| {
            _ = self.stack.pop();
            return e;
        };
    }

    fn pop(self: *mut Scope) void {
        let b = self.stack.pop() ?? return;
        if b.prev == NONE {
            _ = self.latest.remove(b.prefix);
        } else {
            // (the prefix is in the map, so this does not allocate)
            self.latest.put(b.prefix, b.prev) catch {};
        }
    }

    fn truncate(self: *mut Scope, n: usize) void {
        while self.stack.len() > n {
            self.pop();
        }
    }
}

// -----------------------------------------------------------------------------
// Elements, attributes, and namespaces
// -----------------------------------------------------------------------------

fn reader_start_tag(r: *mut Reader) XmlError!Token {
    r.advance(1);
    let qname = r.name()!;
    if r.seen.len() > 0 {
        for a in r.attrs.items() {
            _ = r.seen.remove(a.name);
        }
    }
    r.attrs.clear();
    loop {
        let sp = r.skip_space();
        if r.looking_at("/>") or (r.at(0) == '>') {
            break;
        }
        if not sp {
            return r.fail("expected white space before an attribute");
        }
        let an = r.name()!;
        _ = r.skip_space();
        r.expect("=", "expected = after an attribute name")!;
        _ = r.skip_space();
        let v = reader_attr_value(r, qname, an)!;
        if r.attrs.len() < FEW_ATTRS {
            for a in r.attrs.items() {
                if strs.eq(a.name, an) {
                    return r.fail("duplicate attribute");
                }
            }
        } else {
            if r.attrs.len() == FEW_ATTRS {
                for a in r.attrs.items() {
                    r.seen.put(a.name, 0)!;
                }
            }
            if r.seen.contains(an) {
                return r.fail("duplicate attribute");
            }
            r.seen.put(an, 0)!;
        }
        r.attrs.push(Attr.{ name: an, local: an, ns: "", value: v })!;
    }
    let empty = r.looking_at("/>");
    if empty {
        r.advance(2);
    } else {
        r.advance(1);
    }
    // attribute defaults from the DTD, each counted against default_limit
    let n = r.attrs.len();
    let mut i = (r.defaults.get(qname) ?? Defaults.{ first: NONE, last: NONE }).first;
    while i != NONE {
        let d = r.attdefs.get(i);
        i = d.next;
        let mut have = false;
        if n > FEW_ATTRS {
            have = r.seen.contains(d.name);
        } else {
            for a in r.attrs.items()[..n] {
                if strs.eq(a.name, d.name) {
                    have = true;
                }
            }
        }
        if not have {
            r.defaulted += d.value.len + @size_of(Attr);
            if r.defaulted > r.default_limit {
                return r.fail_err("attribute defaults exceed size limit", error.TooLarge);
            }
            r.attrs.push(Attr.{ name: d.name, local: d.name, ns: "", value: d.value })!;
        }
    }
    if r.open.len() >= MAX_DEPTH {
        return r.fail_err("elements nested too deeply", error.TooDeep);
    }
    let depth = r.open.len() + 1;
    let mut t = Reader.token(TokenKind.START);
    t.name = qname;
    t.local = qname;
    if r.opts.namespaces {
        reader_namespaces(r, qname, depth, &mut t)!;
    }
    t.attrs = r.ar.copy.[Attr](r.attrs.items())!;
    t.self_closing = empty;
    r.seen_root = true;
    if empty {
        // the END token comes next, and closes the namespace scope
        r.pending_end = true;
        r.pending_name = qname;
        r.pending_local = t.local;
        r.pending_ns = t.ns;
        r.pending_depth = depth;
    } else {
        r.open.push(qname)!;
        r.open_src.push(r.src.len() - 1)!;
    }
    return t;
}

fn reader_end_tag(r: *mut Reader) XmlError!Token {
    r.advance(2);
    let n = r.name()!;
    _ = r.skip_space();
    r.expect(">", "expected > to end an end tag")!;
    if r.open.len() == 0 {
        return r.fail("an end tag with no open element");
    }
    let top = r.open.get(r.open.len() - 1);
    if not strs.eq(top, n) {
        return r.fail("an end tag does not match its start tag");
    }
    if r.open_src.get(r.open_src.len() - 1) != (r.src.len() - 1) {
        return r.fail("an element starts in one entity and ends in another");
    }
    let depth = r.open.len();
    _ = r.open.pop();
    _ = r.open_src.pop();
    let mut t = Reader.token(TokenKind.END);
    t.name = n;
    t.local = n;
    if r.opts.namespaces {
        let c = strs.index_of_byte(n, ':') ?? n.len;
        if c < n.len {
            t.local = n[c + 1..];
            t.ns = reader_lookup(r, n[..c]);
        } else {
            t.ns = reader_lookup(r, "");
        }
    }
    reader_close_scope(r, depth);
    return t;
}

// A quoted attribute value, normalized (white space to spaces;
// references resolved; for non-CDATA declared types, trimmed and
// collapsed).
fn reader_attr_value(r: *mut Reader, element: []u8, name: []u8) XmlError![]u8 {
    let q = r.at(0);
    if (q != '"') and (q != '\'') {
        return r.fail("expected a quoted attribute value");
    }
    r.advance(1);
    r.buf2.clear();
    let base = r.src.len();
    loop {
        if r.eof() {
            if r.src.len() > base {
                _ = r.src.pop();
                continue;
            }
            return r.fail("unterminated attribute value");
        }
        let c = r.at(0);
        if (c == q) and (r.src.len() == base) {
            r.advance(1);
            break;
        }
        if c == '<' {
            return r.fail("< in an attribute value");
        }
        if c == '&' {
            if r.at(1) == '#' {
                r.char_ref(&mut r.buf2)!;
                continue;
            }
            r.advance(1);
            let n = r.name()!;
            r.expect(";", "expected ; after an entity name")!;
            let p = predefined(n);
            if (p.len > 0) and not r.general.contains(n) {
                r.buf2.push_str(p)!;
                continue;
            }
            let e = r.general.get(n) ?? {
                if p.len > 0 {
                    r.buf2.push_str(p)!;
                    continue;
                }
                return r.fail("reference to an undeclared entity in an attribute value");
            };
            if e.external or e.unparsed {
                return r.fail("reference to an external entity in an attribute value");
            }
            r.push_entity(n, e.value, true)!;
            continue;
        }
        if is_space(c) {
            r.buf2.push(' ')!;
        } else {
            r.buf2.push(c)!;
        }
        r.advance(1);
    }
    let mut v: []u8 = r.buf2.bytes();
    // declared non-CDATA types: trim and collapse spaces
    if r.attdefs.len() > 0 {
        let i = r.attdef_of.get(reader_attdef_key(r, element, name)!) ?? NONE;
        if (i != NONE) and not r.attdefs.get(i).cdata {
            v = collapse(v, &mut r.buf);
        }
    }
    return r.ar.dup(v);
}

// "element name" (in r.key) to look an attribute's declaration up by.
fn reader_attdef_key(r: *mut Reader, element: []u8, name: []u8) XmlError![]u8 {
    r.key.clear();
    r.key.push_str(element)!;
    r.key.push(' ')!;
    r.key.push_str(name)!;
    return r.key.bytes();
}

fn reader_lookup(r: *Reader, prefix: []u8) []u8 {
    if strs.eq(prefix, "xml") {
        return XML_NS;
    }
    return r.scope.uri(prefix);
}

fn reader_bound(r: *Reader, prefix: []u8) bool {
    if strs.eq(prefix, "xml") {
        return true;
    }
    return r.scope.uri(prefix).len > 0;
}

fn reader_close_scope(r: *mut Reader, depth: usize) void {
    while (r.scope.stack.len() > 0) and (r.scope.stack.get(r.scope.stack.len() - 1).depth >= depth) {
        r.scope.pop();
    }
}

// Declares the element's namespaces and resolves its names.
fn reader_namespaces(r: *mut Reader, qname: []u8, depth: usize, t: *mut Token) XmlError!void {
    let attrs = r.attrs.items_mut();
    for i in @as(usize, 0)..attrs.len {
        let a = attrs[i];
        let mut prefix: []u8 = "\x00";
        if strs.eq(a.name, "xmlns") {
            prefix = "";
        } else if strs.starts_with(a.name, "xmlns:") {
            prefix = a.name[6..];
        }
        if (prefix.len == 1) and (prefix[0] == 0) {
            continue;
        }
        if strs.eq(prefix, "xmlns") {
            return r.fail("the xmlns prefix cannot be declared");
        }
        if strs.eq(prefix, "xml") != strs.eq(a.value, XML_NS) {
            return r.fail("the xml prefix is bound only to its own namespace");
        }
        if strs.eq(a.value, XMLNS_NS) {
            return r.fail("the xmlns namespace cannot be bound");
        }
        if (prefix.len > 0) and (a.value.len == 0) {
            return r.fail("a prefix cannot be undeclared (namespaces 1.0)");
        }
        if (prefix.len > 0) and (strs.contains(prefix, ":") or not is_name(prefix)) {
            return r.fail("a bad namespace prefix");
        }
        for c in a.value {
            if (strs.index_of_byte(" <>\"{}|\\^`\t\n", c) ?? 99) != 99 {
                return r.fail("a namespace name is not a URI reference");
            }
        }
        r.scope.push(prefix, a.value, depth)!;
    }
    // the element
    let p = qprefix(qname);
    let l = qlocal(qname);
    if not reader_valid_qname(qname) {
        return r.fail("a malformed qualified name");
    }
    if (p.len > 0) and not reader_bound(r, p) {
        return r.fail("an unbound namespace prefix");
    }
    if strs.eq(p, "xmlns") {
        return r.fail("an element cannot have the xmlns prefix");
    }
    t.local = l;
    t.ns = reader_lookup(r, p);
    // the attributes
    for i in @as(usize, 0)..attrs.len {
        let a = attrs[i];
        if not reader_valid_qname(a.name) {
            return r.fail("a malformed qualified name");
        }
        let ap = qprefix(a.name);
        let al = qlocal(a.name);
        let mut ns: []u8 = "";
        if strs.eq(a.name, "xmlns") or strs.eq(ap, "xmlns") {
            ns = XMLNS_NS;
        } else if ap.len > 0 {
            if not reader_bound(r, ap) {
                return r.fail("an unbound namespace prefix on an attribute");
            }
            ns = reader_lookup(r, ap);
        }
        attrs[i].local = al;
        if strs.eq(a.name, "xmlns") {
            attrs[i].local = "xmlns";
        }
        attrs[i].ns = ns;
    }
    // no two attributes with the same expanded name (past FEW_ATTRS, found
    // next to each other once sorted)
    if attrs.len <= FEW_ATTRS {
        for i in @as(usize, 0)..attrs.len {
            for j in i + 1..attrs.len {
                if (attrs[i].ns.len > 0) and strs.eq(attrs[i].ns, attrs[j].ns) and
                   strs.eq(attrs[i].local, attrs[j].local) {
                    return r.fail("two attributes with the same namespace and local name");
                }
            }
        }
        return;
    }
    r.sorted.clear();
    for a in attrs {
        if a.ns.len > 0 {
            r.sorted.push(a)!;
        }
    }
    let ss = r.sorted.items_mut();
    vec.sort.[Attr, attr_less](ss);
    for i in @as(usize, 1)..ss.len {
        if strs.eq(ss[i - 1].ns, ss[i].ns) and strs.eq(ss[i - 1].local, ss[i].local) {
            return r.fail("two attributes with the same namespace and local name");
        }
    }
}

fn reader_valid_qname(n: []u8) bool {
    let c = strs.index_of_byte(n, ':') ?? return true;
    if (c == 0) or ((c + 1) == n.len) {
        return false;
    }
    let rest = n[c + 1..];
    if strs.contains(rest, ":") {
        return false;
    }
    return is_name(rest);
}

// "p:local" -> "p" and "local"; "local" -> "" and "local".
fn qprefix(n: []u8) []u8 {
    let c = strs.index_of_byte(n, ':') ?? return "";
    return n[..c];
}

fn qlocal(n: []u8) []u8 {
    let c = strs.index_of_byte(n, ':') ?? return n;
    return n[c + 1..];
}

// Trims spaces and collapses runs of them (into buf; returns a view of it).
fn collapse(v: []u8, buf: *mut strs.String) []u8 {
    buf.clear();
    let mut space = false;
    for c in v {
        if c == ' ' {
            space = buf.len() > 0;
            continue;
        }
        if space {
            buf.push(' ') catch {};
            space = false;
        }
        buf.push(c) catch {};
    }
    return buf.bytes();
}
