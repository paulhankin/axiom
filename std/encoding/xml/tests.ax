// =============================================================================
// std/encoding/xml/tests.ax - Tests for std/encoding/xml, part of std/encoding/xml.
// =============================================================================

import "../../diag.ax" as diag;
import "../../fmt.ax" as fmt;
import "../../mem.ax" as mem;
import "../../os/fs.ax" as fs;
import "../../str.ax" as strs;

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn next_line(data: []u8, at: *mut usize) []u8 {
    let st = at.*;
    let nl = strs.index_of_from(data, "\n", st) ?? data.len;
    at.* = nl + 1;
    return data[st..nl];
}

test "a corpus against libxml2's canonical forms" {
    let data = fs.read_file("std/encoding/xml/testdata/cases.txt") catch return;
    defer mem.free(data);
    let mut at: usize = 0;
    _ = next_line(data, &mut at);
    let mut failed: usize = 0;
    let mut n: usize = 0;
    while at < data.len {
        let head = next_line(data, &mut at);
        let mut f = strs.fields(head);
        _ = f.next() ?? break;
        let id = f.next() ?? break;
        let ilen = fmt.parse_int.[usize](f.next() ?? break) catch break;
        let elen = fmt.parse_int.[i64](f.next() ?? break) catch break;
        let input = data[at..at + ilen];
        at += ilen + 1;
        let mut want: []u8 = "";
        if elen >= 0 {
            let k = @truncate(usize, @bit_cast(u64, elen));
            want = data[at..at + k];
            at += k + 1;
        }
        n += 1;
        let mut info = ErrorInfo.{ line: 0, message: "" };
        let mut ok = false;
        let mut doc = parse_with(input, Options.default(), &mut info) catch |e| {
            _ = e;
            if elen >= 0 {
                fmt.print(
                    "case {}: rejected ({}) but libxml2 accepts it\n", [fmt.str(id), fmt.str(info.message)]) catch {};
                failed += 1;
            }
            continue;
        };
        if elen < 0 {
            fmt.print("case {}: accepted but libxml2 rejects it\n", [fmt.str(id)]) catch {};
        } else {
            let c = canonicalize(&doc)!;
            ok = strs.eq(c, want);
            if not ok {
                fmt.print("case {}: got {} want {}\n", [fmt.str(id), fmt.str(c), fmt.str(want)]) catch {};
            }
            mem.free(c);
        }
        doc.deinit();
        if not ok {
            failed += 1;
        }
    }
    @expect(n > 80);
    @expect_eq(failed, 0);
}

test "the tree and the reader" {
    let text =
        "<?xml version=\"1.0\"?>\n<!-- top -->\n<lib xmlns=\"http://lib\" xmlns:x=\"http://x\"><book id=\"1\" x:rare=\"yes\"><title>A &amp; B</title></book><book id=\"2\"><title>C<![CDATA[<d>]]></title></book></lib>";
    let mut doc = parse(text)!;
    defer doc.deinit();
    @expect_eq(doc.root.local, "lib");
    @expect_eq(doc.root.ns, "http://lib");
    @expect_eq(doc.prolog.len, 1);
    let mut it = doc.root.elements();
    let b1 = it.next() ?? @trap();
    @expect_eq(b1.attr("id")!, "1");
    @expect_eq(b1.attr_ns("http://x", "rare")!, "yes");
    let t1 = b1.child("title")!.text_alloc()!;
    defer mem.free(t1);
    @expect_eq(t1, "A & B");
    let b2 = it.next() ?? @trap();
    let t2 = b2.text_alloc()!;
    defer mem.free(t2);
    @expect_eq(t2, "C<d>");
    @expect(is_none(it.next()));
    // streaming
    let mut r = Reader.init("<a x='1'><b/>t</a>", Options.default())!;
    defer r.deinit();
    let kinds: [5]TokenKind = [TokenKind.START, TokenKind.START, TokenKind.END, TokenKind.TEXT, TokenKind.END];
    for k in kinds {
        let t = r.next()! ?? @trap();
        @expect(t.kind == k);
    }
    @expect(is_none(r.next()!));
}

fn is_none[T](v: ?T) bool {
    if let .some(_) = v {
        return false;
    }
    return true;
}

test "writing" {
    let mut s = strs.String.init();
    defer s.deinit();
    let mut w = Writer.pretty(s.writer(), 2);
    defer w.deinit();
    w.declaration()!;
    w.start("list")!;
    w.attr("kind", "a\"b<c")!;
    w.start("item")!;
    w.text("x & y")!;
    w.end()!;
    w.start("empty")!;
    w.end()!;
    w.comment(" note ")!;
    w.end()!;
    @expect_eq(s.bytes(),
               "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<list kind=\"a&quot;b&lt;c\">\n  <item>x &amp; y</item>\n  <empty/>\n  <!-- note -->\n</list>");
    let mut doc = parse(s.bytes())!;
    defer doc.deinit();
    @expect_eq(doc.root.attr("kind")!, "a\"b<c");
    @expect(fails_void(w.end()));
    @expect(fails_void(w.comment("a--b")));
}

fn fails_void(r: !void) bool {
    r catch return true;
    return false;
}

test "encodings and hostile input" {
    // UTF-16 little-endian with a byte-order mark
    let u16le: [18]u8 = [0xff, 0xfe, '<', 0, 'a', 0, '>', 0, 0xe9, 0, '<', 0, '/', 0, 'a', 0, '>', 0];
    let mut d1 = parse(u16le[..])!;
    defer d1.deinit();
    let t1 = d1.root.text_alloc()!;
    defer mem.free(t1);
    @expect_eq(t1, "\xc3\xa9");
    let latin = "<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?><a>\xe9</a>";
    let mut d2 = parse(latin)!;
    defer d2.deinit();
    let t = d2.root.text_alloc()!;
    defer mem.free(t);
    @expect_eq(t, "\xc3\xa9");
    // billion laughs
    let mut s = strs.String.init();
    defer s.deinit();
    s.push_str("<!DOCTYPE a [<!ENTITY l0 \"hahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahaha\">")!;
    for k in @as(usize, 1)..10 {
        fmt.write(s.writer(), "<!ENTITY l{} \"", [fmt.int(k)])!;
        for _j in @as(usize, 0)..10 {
            fmt.write(s.writer(), "&l{};", [fmt.int(k - 1)])!;
        }
        s.push_str("\">")!;
    }
    s.push_str("]><a>&l9;</a>")!;
    @expect(fails_doc(s.bytes()));
    // deep nesting
    let mut deep = strs.String.init();
    defer deep.deinit();
    for _k in @as(usize, 0)..5000 {
        deep.push_str("<a>")!;
    }
    @expect(fails_doc(deep.bytes()));
}

test "attribute defaults and many attributes" {
    // defaults by element, the first declaration counting; collapsed non-CDATA values
    let dtd =
        "<!DOCTYPE r [<!ATTLIST x a CDATA \"1\" t NMTOKENS #IMPLIED><!ATTLIST x a CDATA \"2\" b CDATA \"3\"><!ATTLIST y a CDATA \"4\">]>";
    let mut s = strs.String.init();
    defer s.deinit();
    s.push_str(dtd)!;
    s.push_str("<r><x t=' p  q '/><x a='5'/><y/></r>")!;
    let mut doc = parse(s.bytes())!;
    let c = canonicalize(&doc)!;
    @expect_eq(c, "<r><x a=\"1\" b=\"3\" t=\"p q\"></x><x a=\"5\" b=\"3\"></x><y a=\"4\"></y></r>");
    mem.free(c);
    doc.deinit();
    // more attributes than FEW_ATTRS: duplicates found, defaults not repeated
    s.clear();
    s.push_str("<!DOCTYPE r [<!ATTLIST r a30 CDATA \"d\" z CDATA \"e\">]><r xmlns:p='u'")!;
    for k in @as(usize, 0)..40 {
        fmt.write(s.writer(), " a{}='v' p:b{}='w'", [fmt.int(k), fmt.int(k)])!;
    }
    let base = s.len();
    s.push_str("/>")!;
    doc = parse(s.bytes())!;
    @expect_eq(doc.root.attr("a30")!, "v");
    @expect_eq(doc.root.attr("z")!, "e");
    @expect_eq(doc.root.attrs.len, 82);
    doc.deinit();
    s.truncate(base);
    s.push_str(" a7='x'/>")!;
    @expect(fails_doc(s.bytes()));
    s.truncate(base);
    s.push_str(" xmlns:q='u' q:b9='x'/>")!;
    @expect(fails_doc(s.bytes()));
    // namespace scopes: an inner binding hides an outer one until it closes
    let mut d2 = parse("<p:r xmlns:p='u1'><p:a xmlns:p='u2'><p:b/></p:a><p:c/></p:r>")!;
    defer d2.deinit();
    let mut it = d2.root.elements();
    let a = it.next() ?? @trap();
    @expect_eq(a.ns, "u2");
    let mut ai = a.elements();
    @expect_eq((ai.next() ?? @trap()).ns, "u2");
    @expect_eq((it.next() ?? @trap()).ns, "u1");
}

test "hostile attribute lists stay linear and bounded" {
    // k defaults on k elements: quadratic in its output, so refused
    let k: usize = 2000;
    let mut s = strs.String.init();
    defer s.deinit();
    s.push_str("<!DOCTYPE r [<!ATTLIST x")!;
    for i in @as(usize, 0)..k {
        fmt.write(s.writer(), " a{} CDATA ''", [fmt.int(i)])!;
    }
    s.push_str(">]><r>")!;
    for _i in @as(usize, 0)..k {
        s.push_str("<x/>")!;
    }
    s.push_str("</r>")!;
    @expect(fails_doc(s.bytes()));
    // a long default on many elements
    s.clear();
    s.push_str("<!DOCTYPE r [<!ATTLIST x a CDATA '")!;
    for _i in @as(usize, 0)..50000 {
        s.push('A')!;
    }
    s.push_str("'>]><r>")!;
    for _i in @as(usize, 0)..10000 {
        s.push_str("<x/>")!;
    }
    s.push_str("</r>")!;
    @expect(fails_doc(s.bytes()));
    // many attributes, namespace declarations and bindings in scope
    s.clear();
    s.push_str("<r xmlns:q='u'")!;
    for i in @as(usize, 0)..20000 {
        fmt.write(s.writer(), " a{}='v' q:b{}='v' xmlns:p{}='u{}'", [fmt.int(i), fmt.int(i), fmt.int(i), fmt.int(i)])!;
    }
    s.push_str(">")!;
    for _i in @as(usize, 0)..50000 {
        s.push_str("<p0:a xmlns:p1='u1'/>")!;
    }
    s.push_str("</r>")!;
    let mut doc = parse(s.bytes())!;
    defer doc.deinit();
    let c = canonicalize(&doc)!;
    defer mem.free(c);
    @expect(c.len < s.len() * 2);
}

fn fails_doc(text: []u8) bool {
    let mut d = parse(text) catch return true;
    d.deinit();
    return false;
}

fn parse_with_diag_err(text: []u8, opts: Options, info: *mut diag.ErrorInfo) ?XmlError {
    let mut d = parse_with_diag(text, opts, info) catch |e| {
        return .some(e);
    };
    d.deinit();
    return .none;
}

test "parse_diag and parse_with_diag" {
    let mut info = diag.ErrorInfo.at(99, 9, 9, "stale");
    let mut ok = parse_diag("<a>\n  <b/>\n</a>", &mut info)!;
    defer ok.deinit();
    @expect_eq(info.offset, 0);
    @expect_eq(info.line, 0);
    @expect_eq(info.col, 0);
    @expect_eq(info.detail, "");

    // mismatched end tag on line 2
    let e1 = parse_with_diag_err("<a>\n  <b></c>\n</a>", Options.default(), &mut info) ?? @trap();
    @expect_eq(e1, error.SyntaxError);
    @expect_eq(info.offset, 13);
    @expect_eq(info.line, 2);
    @expect_eq(info.col, 10);
    @expect_eq(info.detail, "an end tag does not match its start tag");

    // CRLF input still maps offset back to input bytes
    let e_crlf = parse_with_diag_err("<a>\r\n  <b></c>\r\n</a>", Options.default(), &mut info) ?? @trap();
    @expect_eq(e_crlf, error.SyntaxError);
    @expect_eq(info.offset, 14);
    @expect_eq(info.line, 2);
    @expect_eq(info.col, 10);

    // invalid UTF-8 detected during decode
    let e2 = parse_with_diag_err("<a>\xff</a>", Options.default(), &mut info) ?? @trap();
    @expect_eq(e2, error.SyntaxError);
    @expect_eq(info.offset, 3);
    @expect_eq(info.line, 1);
    @expect_eq(info.col, 4);
    @expect_eq(info.detail, "invalid UTF-8");

    // deep nesting records TooDeep with position and detail
    let mut deep = strs.String.init();
    defer deep.deinit();
    for _k in @as(usize, 0)..1100 {
        deep.push_str("<a>")!;
    }
    let e3 = parse_with_diag_err(deep.bytes(), Options.default(), &mut info) ?? @trap();
    @expect_eq(e3, error.TooDeep);
    @expect(info.offset > 0);
    @expect_eq(info.line, 1);
    @expect(info.col > 1);
    @expect_eq(info.detail, "elements nested too deeply");

    // parse_with_diag respects Options.namespaces
    let e4 = parse_with_diag_err("<p:a/>", Options.default(), &mut info) ?? @trap();
    @expect_eq(e4, error.SyntaxError);
    @expect_eq(info.line, 1);
    @expect(info.detail.len > 0);

    let mut no_ns = parse_with_diag("<p:a/>", Options.{ namespaces: false, keep_whitespace: false }, &mut info)!;
    defer no_ns.deinit();
    @expect_eq(info.offset, 0);
    @expect_eq(info.line, 0);
    @expect_eq(info.col, 0);
    @expect_eq(info.detail, "");
}
