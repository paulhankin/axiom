// =============================================================================
// std/encoding/msgpack.ax - MessagePack: a compact binary form of JSON-like data.
//
//     let bytes = msgpack.encode(msgpack.Value.Str("hi"))!;   // (the caller frees)
//     msgpack.encode_to(w, value)!;                        // to an io.Writer
//
//     let mut s = strs.String.init();                      // streaming
//     let mut w = msgpack.Writer.init(s.writer());
//     w.map_header(2)!;
//     w.str("id")!; w.int(7)!;
//     w.str("tags")!; w.array_header(1)!; w.str("x")!;
//
//     let mut doc = msgpack.decode(bytes)!;                // reading
//     defer doc.deinit();
//     let id = doc.root.get("id")!.as_i64()!;
//
// Every type of the specification is supported: nil, booleans, integers
// (all of int64 and uint64), float32 and float64, strings, binary, arrays,
// maps (keys of any type) and extensions, with the timestamp extension (-1)
// read and written through Timestamp. Writers use the smallest encoding of
// each value (floats as float32 when that is exact). to_json and
// Writer.json convert to and from JSON.
//
// Decoding checks everything: truncated input, lengths beyond the input,
// nesting deeper than MAX_DEPTH, and (by default) invalid UTF-8 in strings
// are errors, so untrusted input is safe to decode.
// =============================================================================

import "../collections/arena.ax" as arena;
import "../collections/vec.ax" as vec;
import "../fmt.ax" as fmt;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../os/fs.ax" as fs;
import "../str.ax" as strs;
import "binary.ax" as binary;
import "hex.ax" as hex;
import "json.ax" as json;

error { Truncated, Corrupt, TooDeep, TrailingData, WrongType, NotFound, OutOfMemory }

/// Nesting deeper than this is refused (error.TooDeep).
pub const MAX_DEPTH: u32 = 512;

/// The timestamp extension type.
pub const EXT_TIMESTAMP: i8 = -1;

pub struct Pair {
    key: Value,
    value: Value,
}

pub struct Ext {
    kind: i8,  // application types are 0..127; negative ones are reserved
    data: []u8,
}

/// Seconds since 1970-01-01T00:00:00Z plus nanoseconds (0..999999999).
pub struct Timestamp {
    sec: i64,
    nsec: u32,
}

pub union Value {
    Nil,
    Bool: bool,
    Int: i64,
    Uint: u64,  // (only for values above the largest i64)
    Float: f64,
    Str: []u8,
    Bin: []u8,
    Array: []Value,
    Map: []Pair,
    Ext: Ext,

    /// The value of the entry whose key is the string `key` in a map.
    pub fn get(self: Value, key: []u8) !Value {
        match self {
            .Map(ps) => {
                for p in ps {
                    match p.key {
                        .Str(k) => {
                            if strs.eq(k, key) {
                                return p.value;
                            }
                        }
                        else => {}
                    }
                }
                return error.NotFound;
            }
            else => { return error.WrongType; }
        }
    }

    /// Element i of an array.
    pub fn at(self: Value, i: usize) !Value {
        match self {
            .Array(xs) => {
                if i >= xs.len {
                    return error.NotFound;
                }
                return xs[i];
            }
            else => { return error.WrongType; }
        }
    }

    /// The number of elements, entries or bytes; 0 for other values.
    pub fn len(self: Value) usize {
        match self {
            .Array(xs) => { return xs.len; }
            .Map(ps)   => { return ps.len; }
            .Str(s)    => { return s.len; }
            .Bin(b)    => { return b.len; }
            else       => { return 0; }
        }
    }

    pub fn is_nil(self: Value) bool {
        match self {
            .Nil => { return true; }
            else => { return false; }
        }
    }

    pub fn as_bool(self: Value) !bool {
        match self {
            .Bool(b) => { return b; }
            else     => { return error.WrongType; }
        }
    }

    /// An integer (or a float with an integral value) that fits in i64.
    pub fn as_i64(self: Value) !i64 {
        match self {
            .Int(i) => { return i; }
            .Float(f) => {
                if (f >= -9223372036854775808.0) and (f < 9223372036854775808.0) and
                   (@float_from_int(f64, @int_from_float(i64, f)) == f) {
                    return @int_from_float(i64, f);
                }
                return error.WrongType;
            }
            else => { return error.WrongType; }
        }
    }

    pub fn as_u64(self: Value) !u64 {
        match self {
            .Uint(u) => { return u; }
            .Int(i) => {
                if i < 0 {
                    return error.WrongType;
                }
                return @bit_cast(u64, i);
            }
            else => { return error.WrongType; }
        }
    }

    /// Any number, as an f64.
    pub fn as_f64(self: Value) !f64 {
        match self {
            .Float(f) => { return f; }
            .Int(i)   => { return @float_from_int(f64, i); }
            .Uint(u)  => { return @float_from_int(f64, u); }
            else      => { return error.WrongType; }
        }
    }

    pub fn as_str(self: Value) ![]u8 {
        match self {
            .Str(s) => { return s; }
            else    => { return error.WrongType; }
        }
    }

    pub fn as_bin(self: Value) ![]u8 {
        match self {
            .Bin(b) => { return b; }
            else    => { return error.WrongType; }
        }
    }

    pub fn as_array(self: Value) ![]Value {
        match self {
            .Array(xs) => { return xs; }
            else       => { return error.WrongType; }
        }
    }

    pub fn as_map(self: Value) ![]Pair {
        match self {
            .Map(ps) => { return ps; }
            else     => { return error.WrongType; }
        }
    }

    /// A timestamp extension value.
    pub fn as_timestamp(self: Value) !Timestamp {
        match self {
            .Ext(e) => { return timestamp_of(e); }
            else    => { return error.WrongType; }
        }
    }
}

/// Decodes the timestamp extension (4, 8 or 12 bytes of data).
pub fn timestamp_of(e: Ext) !Timestamp {
    if e.kind != EXT_TIMESTAMP {
        return error.WrongType;
    }
    let d = e.data;
    if d.len == 4 {
        return Timestamp.{ sec: @as(i64, binary.u32_be(d)), nsec: 0 };
    }
    if d.len == 8 {
        let v = binary.u64_be(d);
        let nsec = @truncate(u32, v >> 34);
        if nsec > 999999999 {
            return error.Corrupt;
        }
        return Timestamp.{ sec: @bit_cast(i64, v & 0x3ffffffff), nsec: nsec };
    }
    if d.len == 12 {
        let nsec = binary.u32_be(d);
        if nsec > 999999999 {
            return error.Corrupt;
        }
        return Timestamp.{ sec: @bit_cast(i64, binary.u64_be(d[4..])), nsec: nsec };
    }
    return error.Corrupt;
}

fn put_be(buf: []mut u8, v: u64, n: usize) void {
    for k in @as(usize, 0)..n {
        buf[k] = @truncate(u8, v >> @as(u64, 8 * (n - 1 - k)));
    }
}

// -----------------------------------------------------------------------------
// Writing
// -----------------------------------------------------------------------------

/// Writes MessagePack. The caller writes each array or map header followed
/// by that many elements (for a map, key then value).
pub struct Writer {
    out: io.Writer,

    pub fn init(out: io.Writer) Writer {
        return Writer.{ out: out };
    }

    fn head(self: *mut Writer, b0: u8, v: u64, n: usize) !void {
        let mut buf: [9]u8 = [0; 9];
        buf[0] = b0;
        put_be(buf[1..], v, n);
        self.out.write_all(buf[..n + 1])!;
    }

    pub fn nil(self: *mut Writer) !void {
        self.out.write_all("\xc0")!;
    }

    pub fn boolean(self: *mut Writer, b: bool) !void {
        if b {
            self.out.write_all("\xc3")!;
        } else {
            self.out.write_all("\xc2")!;
        }
    }

    pub fn int(self: *mut Writer, v: i64) !void {
        if v >= 0 {
            return self.uint(@bit_cast(u64, v));
        }
        if v >= -32 {
            return self.head(@truncate(u8, @bit_cast(u64, v)), 0, 0);
        }
        let u = @bit_cast(u64, v);
        if v >= -128 {
            return self.head(0xd0, u, 1);
        }
        if v >= -32768 {
            return self.head(0xd1, u, 2);
        }
        if v >= -2147483648 {
            return self.head(0xd2, u, 4);
        }
        return self.head(0xd3, u, 8);
    }

    pub fn uint(self: *mut Writer, v: u64) !void {
        if v < 128 {
            return self.head(@truncate(u8, v), 0, 0);
        }
        if v < 256 {
            return self.head(0xcc, v, 1);
        }
        if v < 65536 {
            return self.head(0xcd, v, 2);
        }
        if v < 4294967296 {
            return self.head(0xce, v, 4);
        }
        return self.head(0xcf, v, 8);
    }

    /// A float: as float32 when that holds it exactly, else float64.
    pub fn float(self: *mut Writer, v: f64) !void {
        let f = @float_cast(f32, v);
        if (@as(f64, f) == v) or (v != v) {
            return self.float32(f);
        }
        return self.float64(v);
    }

    pub fn float32(self: *mut Writer, v: f32) !void {
        return self.head(0xca, @as(u64, @bit_cast(u32, v)), 4);
    }

    pub fn float64(self: *mut Writer, v: f64) !void {
        return self.head(0xcb, @bit_cast(u64, v), 8);
    }

    pub fn str(self: *mut Writer, s: []u8) !void {
        let n = @as(u64, s.len);
        if n < 32 {
            self.head(0xa0 | @truncate(u8, n), 0, 0)!;
        } else if n < 256 {
            self.head(0xd9, n, 1)!;
        } else if n < 65536 {
            self.head(0xda, n, 2)!;
        } else {
            self.head(0xdb, n, 4)!;
        }
        self.out.write_all(s)!;
    }

    pub fn bin(self: *mut Writer, b: []u8) !void {
        let n = @as(u64, b.len);
        if n < 256 {
            self.head(0xc4, n, 1)!;
        } else if n < 65536 {
            self.head(0xc5, n, 2)!;
        } else {
            self.head(0xc6, n, 4)!;
        }
        self.out.write_all(b)!;
    }

    pub fn array_header(self: *mut Writer, n: usize) !void {
        let v = @as(u64, n);
        if v < 16 {
            return self.head(0x90 | @truncate(u8, v), 0, 0);
        }
        if v < 65536 {
            return self.head(0xdc, v, 2);
        }
        return self.head(0xdd, v, 4);
    }

    /// A map of n entries (2n values follow).
    pub fn map_header(self: *mut Writer, n: usize) !void {
        let v = @as(u64, n);
        if v < 16 {
            return self.head(0x80 | @truncate(u8, v), 0, 0);
        }
        if v < 65536 {
            return self.head(0xde, v, 2);
        }
        return self.head(0xdf, v, 4);
    }

    pub fn ext(self: *mut Writer, kind: i8, data: []u8) !void {
        let n = @as(u64, data.len);
        let t: [1]u8 = [@bit_cast(u8, kind)];
        if n == 1 {
            self.head(0xd4, 0, 0)!;
        } else if n == 2 {
            self.head(0xd5, 0, 0)!;
        } else if n == 4 {
            self.head(0xd6, 0, 0)!;
        } else if n == 8 {
            self.head(0xd7, 0, 0)!;
        } else if n == 16 {
            self.head(0xd8, 0, 0)!;
        } else if n < 256 {
            self.head(0xc7, n, 1)!;
        } else if n < 65536 {
            self.head(0xc8, n, 2)!;
        } else {
            self.head(0xc9, n, 4)!;
        }
        self.out.write_all(t[..])!;
        self.out.write_all(data)!;
    }

    /// A timestamp, in the smallest of its three forms.
    pub fn timestamp(self: *mut Writer, t: Timestamp) !void {
        let mut buf: [12]u8 = [0; 12];
        if (t.sec >= 0) and ((t.sec >> 34) == 0) {
            let s = @bit_cast(u64, t.sec);
            if (t.nsec == 0) and ((s >> 32) == 0) {
                put_be(buf[..], s, 4);
                return self.ext(EXT_TIMESTAMP, buf[..4]);
            }
            put_be(buf[..], (@as(u64, t.nsec) << 34) | s, 8);
            return self.ext(EXT_TIMESTAMP, buf[..8]);
        }
        put_be(buf[..], @as(u64, t.nsec), 4);
        put_be(buf[4..], @bit_cast(u64, t.sec), 8);
        return self.ext(EXT_TIMESTAMP, buf[..]);
    }

    /// Writes a whole value.
    pub fn value(self: *mut Writer, v: Value) !void {
        let mut work = vec.Vec.[Value].init();  // (no recursion: values may nest deeply)
        defer work.deinit();
        work.push(v)!;
        while work.len > 0 {
            let x = work.pop()!;
            match x {
                .Nil      => { self.nil()!; }
                .Bool(b)  => { self.boolean(b)!; }
                .Int(i)   => { self.int(i)!; }
                .Uint(u)  => { self.uint(u)!; }
                .Float(f) => { self.float(f)!; }
                .Str(s)   => { self.str(s)!; }
                .Bin(b)   => { self.bin(b)!; }
                .Ext(e)   => { self.ext(e.kind, e.data)!; }
                .Array(xs) => {
                    self.array_header(xs.len)!;
                    let mut k = xs.len;
                    while k > 0 {
                        k -= 1;
                        work.push(xs[k])!;
                    }
                }
                .Map(ps) => {
                    self.map_header(ps.len)!;
                    let mut k = ps.len;
                    while k > 0 {
                        k -= 1;
                        work.push(ps[k].value)!;
                        work.push(ps[k].key)!;
                    }
                }
            }
        }
    }

    /// Writes a JSON value (objects become maps with string keys).
    pub fn json(self: *mut Writer, v: json.Value) !void {
        let mut work = vec.Vec.[json.Value].init();
        defer work.deinit();
        work.push(v)!;
        while work.len > 0 {
            let x = work.pop()!;
            match x {
                .Null    => { self.nil()!; }
                .Bool(b) => { self.boolean(b)!; }
                .Int(i)  => { self.int(i)!; }
                .Float(f) => {
                    if (f == @float_from_int(f64, @int_from_float(i64, f))) and (f > -9.0e18) and (f < 9.0e18) {
                        self.int(@int_from_float(i64, f))!;
                    } else {
                        self.float(f)!;
                    }
                }
                .String(s) => { self.str(s)!; }
                .Array(xs) => {
                    self.array_header(xs.len)!;
                    let mut k = xs.len;
                    while k > 0 {
                        k -= 1;
                        work.push(xs[k])!;
                    }
                }
                .Object(ms) => {
                    self.map_header(ms.len)!;
                    let mut k = ms.len;
                    while k > 0 {
                        k -= 1;
                        work.push(ms[k].value)!;
                        work.push(json.Value.String(ms[k].key))!;
                    }
                }
            }
        }
    }
}

/// The MessagePack encoding of a value; the caller frees it.
pub fn encode(v: Value) ![]mut u8 {
    let mut s = strs.String.init();
    encode_to(s.writer(), v) catch |e| {
        s.deinit();
        return e;
    };
    return s.take();
}

/// Writes the MessagePack encoding of a value to w, through a 4 KB buffer
/// flushed before returning.
pub fn encode_to(w: io.Writer, v: Value) !void {
    let mut bw = io.BufWriter.init(w);
    let mut mw = Writer.init(bw.writer());
    mw.value(v)!;
    bw.flush()!;
}

/// Converts JSON text to MessagePack; the caller frees the result.
pub fn from_json_text(text: []u8) ![]mut u8 {
    let mut doc = json.parse(text)!;
    defer doc.deinit();
    let mut s = strs.String.init();
    let mut w = Writer.init(s.writer());
    w.json(doc.root) catch |e| {
        s.deinit();
        return e;
    };
    return s.take();
}

// -----------------------------------------------------------------------------
// Reading
// -----------------------------------------------------------------------------

/// A decoded value and the memory behind it.
pub struct Document {
    root: Value,
    arena: arena.Arena,

    pub fn deinit(self: *mut Document) void {
        self.arena.deinit();
        self.root = Value.Nil;
    }
}

pub struct Options {
    check_utf8: bool,  // strings must be UTF-8 (error.Corrupt if not)

    pub fn default() Options {
        return Options.{ check_utf8: true };
    }
}

/// Decodes one value that fills all of bytes.
pub fn decode(bytes: []u8) !Document {
    return decode_with(bytes, Options.default());
}

pub fn decode_with(bytes: []u8, opts: Options) !Document {
    let mut used: usize = 0;
    let mut doc = decode_prefix(bytes, opts, &mut used)!;
    if used != bytes.len {
        doc.deinit();
        return error.TrailingData;
    }
    return doc;
}

/// Decodes the value at the start of bytes (for a stream of values), and
/// sets used to its length.
pub fn decode_prefix(bytes: []u8, opts: Options, used: *mut usize) !Document {
    let mut d = Decoder.{ s: bytes, i: 0, opts: opts, arena: arena.Arena.init() };
    let v = d.value(0) catch |e| {
        d.arena.deinit();
        return e;
    };
    used.* = d.i;
    return Document.{ root: v, arena: d.arena };
}

struct Decoder {
    s: []u8,
    i: usize,
    opts: Options,
    arena: arena.Arena,

    fn take(self: *mut Decoder, n: usize) ![]u8 {
        if n > (self.s.len - self.i) {
            return error.Truncated;
        }
        let b = self.s[self.i..self.i + n];
        self.i += n;
        return b;
    }

    fn uint_n(self: *mut Decoder, n: usize) !u64 {
        let b = self.take(n)!;
        let mut v: u64 = 0;
        for c in b {
            v = (v << 8) | @as(u64, c);
        }
        return v;
    }

    // A length of n bytes.
    fn len_n(self: *mut Decoder, n: usize) !usize {
        let v = self.uint_n(n)!;
        if v > @as(u64, self.s.len) {
            return error.Truncated;
        }
        return @truncate(usize, v);
    }

    fn string(self: *mut Decoder, n: usize) !Value {
        let b = self.take(n)!;
        if self.opts.check_utf8 and not strs.valid_utf8(b) {
            return error.Corrupt;
        }
        return Value.Str(b);
    }

    fn ext(self: *mut Decoder, n: usize) !Value {
        let t = self.take(1)!;
        let d = self.take(n)!;
        return Value.Ext(Ext.{ kind: @bit_cast(i8, t[0]), data: d });
    }

    // One value; arrays and maps are read with an explicit stack.
    fn value(self: *mut Decoder, depth0: u32) !Value {
        let mut frames = vec.Vec.[Frame].init();
        defer frames.deinit();
        let mut vals = vec.Vec.[Value].init();  // the elements of open arrays and maps
        defer vals.deinit();
        let mut pairs = vec.Vec.[Pair].init();
        defer pairs.deinit();
        _ = depth0;
        loop {
            let mut v = Value.Nil;
            let mut n: usize = 0;
            let kind = self.item(&mut v, &mut n)!;
            if (kind != ItemKind.SCALAR) and (n > 0) {
                if frames.len >= @as(usize, MAX_DEPTH) {
                    return error.TooDeep;
                }
                let mut need = n;
                if kind == ItemKind.MAP {
                    need = n * 2;
                }
                if need > (self.s.len - self.i) {
                    return error.Truncated;  // (each value takes a byte at least)
                }
                frames.push(Frame.{ is_map: kind == ItemKind.MAP, left: need, start: vals.len })!;
                continue;
            }
            if kind == ItemKind.ARRAY {
                v = Value.Array(@slice_from_ptr(@ptr_from_int(*Value, 8), 0));
            } else if kind == ItemKind.MAP {
                v = Value.Map(@slice_from_ptr(@ptr_from_int(*Pair, 8), 0));
            }
            // v is complete: add it to the open containers, closing those that fill up
            loop {
                if frames.len == 0 {
                    return v;
                }
                vals.push(v)!;
                let top = frames.get_ptr(frames.len - 1);
                top.left -= 1;
                if top.left > 0 {
                    break;
                }
                let items = vals.items()[top.start..];
                if top.is_map {
                    pairs.clear();
                    for k in @as(usize, 0)..items.len / 2 {
                        pairs.push(Pair.{ key: items[2 * k], value: items[(2 * k) + 1] })!;
                    }
                    v = Value.Map(self.arena.copy.[Pair](pairs.items())!);
                } else {
                    v = Value.Array(self.arena.copy.[Value](items)!);
                }
                vals.truncate(top.start);
                frames.truncate(frames.len - 1);
            }
        }
    }

    // Reads one item: a scalar into v, or the header of an array or map
    // (its length into n).
    fn item(self: *mut Decoder, v: *mut Value, n: *mut usize) !ItemKind {
        let b = self.take(1)![0];
        if b < 0x80 {
            v.* = Value.Int(@as(i64, b));
            return ItemKind.SCALAR;
        }
        if b >= 0xe0 {
            v.* = Value.Int(@as(i64, @bit_cast(i8, b)));
            return ItemKind.SCALAR;
        }
        if b < 0x90 {
            n.* = @as(usize, b & 15);
            return ItemKind.MAP;
        }
        if b < 0xa0 {
            n.* = @as(usize, b & 15);
            return ItemKind.ARRAY;
        }
        if b < 0xc0 {
            v.* = self.string(@as(usize, b & 31))!;
            return ItemKind.SCALAR;
        }
        match b {
            0xdc => {
                n.* = self.len_n(2)!;
                return ItemKind.ARRAY;
            }
            0xdd => {
                n.* = self.len_n(4)!;
                return ItemKind.ARRAY;
            }
            0xde => {
                n.* = self.len_n(2)!;
                return ItemKind.MAP;
            }
            0xdf => {
                n.* = self.len_n(4)!;
                return ItemKind.MAP;
            }
            else => {}
        }
        v.* = self.scalar(b)!;
        return ItemKind.SCALAR;
    }

    fn scalar(self: *mut Decoder, b: u8) !Value {
        match b {
            0xc0 => { return Value.Nil; }
            0xc2 => { return Value.Bool(false); }
            0xc3 => { return Value.Bool(true); }
            0xc4 => { return Value.Bin(self.take(self.len_n(1)!)!); }
            0xc5 => { return Value.Bin(self.take(self.len_n(2)!)!); }
            0xc6 => { return Value.Bin(self.take(self.len_n(4)!)!); }
            0xc7 => { return self.ext(self.len_n(1)!); }
            0xc8 => { return self.ext(self.len_n(2)!); }
            0xc9 => { return self.ext(self.len_n(4)!); }
            0xca => { return Value.Float(@as(f64, @bit_cast(f32, @truncate(u32, self.uint_n(4)!)))); }
            0xcb => { return Value.Float(@bit_cast(f64, self.uint_n(8)!)); }
            0xcc => { return Value.Int(@bit_cast(i64, self.uint_n(1)!)); }
            0xcd => { return Value.Int(@bit_cast(i64, self.uint_n(2)!)); }
            0xce => { return Value.Int(@bit_cast(i64, self.uint_n(4)!)); }
            0xcf => {
                let u = self.uint_n(8)!;
                if (u >> 63) != 0 {
                    return Value.Uint(u);
                }
                return Value.Int(@bit_cast(i64, u));
            }
            0xd0 => { return Value.Int(@as(i64, @bit_cast(i8, @truncate(u8, self.uint_n(1)!)))); }
            0xd1 => { return Value.Int(@as(i64, @bit_cast(i16, @truncate(u16, self.uint_n(2)!)))); }
            0xd2 => { return Value.Int(@as(i64, @bit_cast(i32, @truncate(u32, self.uint_n(4)!)))); }
            0xd3 => { return Value.Int(@bit_cast(i64, self.uint_n(8)!)); }
            0xd4 => { return self.ext(1); }
            0xd5 => { return self.ext(2); }
            0xd6 => { return self.ext(4); }
            0xd7 => { return self.ext(8); }
            0xd8 => { return self.ext(16); }
            0xd9 => { return self.string(self.len_n(1)!); }
            0xda => { return self.string(self.len_n(2)!); }
            0xdb => { return self.string(self.len_n(4)!); }
            else => { return error.Corrupt; }  // 0xc1 is never used
        }
    }
}

enum ItemKind: u8 {
    SCALAR,
    ARRAY,
    MAP,
}

struct Frame {
    is_map: bool,
    left: usize,   // values still to come (a map's keys and values both count)
    start: usize,  // where its values begin in the decoder's list
}

// -----------------------------------------------------------------------------
// JSON
// -----------------------------------------------------------------------------

/// Writes a value as JSON text. Binary becomes an array of byte values,
/// an extension {"ext": type, "data": [bytes]}, a map key that is not a
/// string the JSON text of the key, and NaN and the infinities null.
pub fn to_json(out: io.Writer, v: Value) !void {
    let mut work = vec.Vec.[Item].init();
    defer work.deinit();
    work.push(Item.{ v: v, op: Step.VALUE })!;
    while work.len > 0 {
        let it = work.pop()!;
        let op = it.op;
        if op == Step.CLOSE_ARRAY {
            out.write_all("]")!;
            continue;
        }
        if op == Step.CLOSE_MAP {
            out.write_all("}")!;
            continue;
        }
        if (op == Step.COMMA_VALUE) or (op == Step.COMMA_KEY) {
            out.write_all(",")!;
        } else if op == Step.COLON_VALUE {
            out.write_all(":")!;
        }
        if (op == Step.KEY) or (op == Step.COMMA_KEY) {
            match it.v {
                .Str(s) => { json.write_string(out, s)!; }
                else => {
                    let mut ks = strs.String.init();
                    defer ks.deinit();
                    to_json(ks.writer(), it.v)!;
                    json.write_string(out, ks.bytes())!;
                }
            }
            continue;
        }
        match it.v {
            .Nil => { out.write_all("null")!; }
            .Bool(b) => {
                if b {
                    out.write_all("true")!;
                } else {
                    out.write_all("false")!;
                }
            }
            .Int(i)  => { fmt.write(out, "{}", [fmt.int(i)])!; }
            .Uint(u) => { fmt.write(out, "{}", [fmt.int(u)])!; }
            .Float(f) => {
                if (f != f) or ((f - f) != 0.0) {
                    out.write_all("null")!;
                } else {
                    fmt.write(out, "{}", [fmt.float(f)])!;
                }
            }
            .Str(s) => { json.write_string(out, s)!; }
            .Bin(b) => { bytes_json(out, b)!; }
            .Ext(e) => {
                out.write_all("{\"ext\":")!;
                fmt.write(out, "{}", [fmt.int(@as(i64, e.kind))])!;
                out.write_all(",\"data\":")!;
                bytes_json(out, e.data)!;
                out.write_all("}")!;
            }
            .Array(xs) => {
                out.write_all("[")!;
                work.push(Item.{ v: Value.Nil, op: Step.CLOSE_ARRAY })!;
                let mut k = xs.len;
                while k > 0 {
                    k -= 1;
                    let mut o = Step.COMMA_VALUE;
                    if k == 0 {
                        o = Step.VALUE;
                    }
                    work.push(Item.{ v: xs[k], op: o })!;
                }
            }
            .Map(ps) => {
                out.write_all("{")!;
                work.push(Item.{ v: Value.Nil, op: Step.CLOSE_MAP })!;
                let mut k = ps.len;
                while k > 0 {
                    k -= 1;
                    work.push(Item.{ v: ps[k].value, op: Step.COLON_VALUE })!;
                    let mut o = Step.COMMA_KEY;
                    if k == 0 {
                        o = Step.KEY;
                    }
                    work.push(Item.{ v: ps[k].key, op: o })!;
                }
            }
        }
    }
}

enum Step: u8 {
    VALUE,
    COMMA_VALUE,
    COLON_VALUE,
    KEY,
    COMMA_KEY,
    CLOSE_ARRAY,
    CLOSE_MAP,
}

struct Item {
    v: Value,
    op: Step,
}

fn bytes_json(out: io.Writer, b: []u8) !void {
    out.write_all("[")!;
    for k in @as(usize, 0)..b.len {
        if k > 0 {
            out.write_all(",")!;
        }
        fmt.write(out, "{}", [fmt.int(@as(u64, b[k]))])!;
    }
    out.write_all("]")!;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

// The dump format of cmd/axiom/internal/tests/tools/gen_binary_tests.py.
fn dump(v: Value, out: *mut strs.String) !void {
    match v {
        .Nil => { out.push_str("nil")!; }
        .Bool(b) => {
            if b {
                out.push_str("true")!;
            } else {
                out.push_str("false")!;
            }
        }
        .Int(i)  => { fmt.write(out.writer(), "{}", [fmt.int(i)])!; }
        .Uint(u) => { fmt.write(out.writer(), "{}", [fmt.int(u)])!; }
        .Float(f) => {
            if (f >= -9223372036854775808.0) and (f < 9223372036854775808.0) and
               (@float_from_int(f64, @int_from_float(i64, f)) == f) {
                fmt.write(out.writer(), "{}", [fmt.int(@int_from_float(i64, f))])!;
            } else {
                let mut b: [8]u8 = [0; 8];
                put_be(b[..], @bit_cast(u64, f), 8);
                let mut h: [16]u8 = [0; 16];
                out.push_str("f:")!;
                out.push_str(hex.encode(b[..], h[..]))!;
            }
        }
        .Str(s) => {
            out.push_str("s:")!;
            out.push_str(s)!;
        }
        .Bin(b) => {
            let h = hex.encode_alloc(b)!;
            defer mem.free(h);
            out.push_str("b:")!;
            out.push_str(h)!;
        }
        .Ext(e) => {
            if e.kind == EXT_TIMESTAMP {
                let t = timestamp_of(e)!;
                fmt.write(out.writer(), "ts({},{})", [fmt.int(t.sec), fmt.int(t.nsec)])!;
            } else {
                let h = hex.encode_alloc(e.data)!;
                defer mem.free(h);
                fmt.write(out.writer(), "ext({},{})", [fmt.int(e.kind), fmt.str(h)])!;
            }
        }
        .Array(xs) => {
            out.push('[')!;
            for k in @as(usize, 0)..xs.len {
                if k > 0 {
                    out.push(',')!;
                }
                dump(xs[k], out)!;
            }
            out.push(']')!;
        }
        .Map(ps) => {
            out.push('{')!;
            for k in @as(usize, 0)..ps.len {
                if k > 0 {
                    out.push(',')!;
                }
                dump(ps[k].key, out)!;
                out.push(':')!;
                dump(ps[k].value, out)!;
            }
            out.push('}')!;
        }
    }
}

test "msgpack-test-suite" {
    let data = fs.read_file("std/encoding/msgpack/testdata/suite.txt") catch return;
    defer mem.free(data);
    let mut lines = strs.lines(data);
    _ = lines.next()!;
    let mut n: usize = 0;
    while true {
        let line = lines.next() catch break;
        let tab = strs.index_of_byte(line, '\t')!;
        let want = line[..tab];
        let mut encs = strs.fields(line[tab + 1..]);
        let mut first = true;
        while true {
            let hx = encs.next() catch break;
            let bytes = hex.decode_alloc(hx)!;
            defer mem.free(bytes);
            let mut doc = decode(bytes)!;
            defer doc.deinit();
            let mut got = strs.String.init();
            defer got.deinit();
            dump(doc.root, &mut got)!;
            if not strs.eq(got.bytes(), want) {
                fmt.print("{}: got {} want {}\n", [fmt.str(hx), fmt.str(got.bytes()), fmt.str(want)]) catch {};
            }
            @expect_eq(got.bytes(), want);
            if first {
                // no longer than the shortest encoding, and the same value
                let again = encode(doc.root)!;
                defer mem.free(again);
                @expect(again.len <= bytes.len);
                let mut d2 = decode(again)!;
                defer d2.deinit();
                let mut got2 = strs.String.init();
                defer got2.deinit();
                dump(d2.root, &mut got2)!;
                @expect_eq(got2.bytes(), want);
                first = false;
            }
            n += 1;
        }
    }
    @expect(n > 200);
}

test "writing and reading" {
    let mut s = strs.String.init();
    defer s.deinit();
    let mut w = Writer.init(s.writer());
    w.map_header(4)!;
    w.str("id")!;
    w.int(-70000)!;
    w.str("big")!;
    w.uint(18446744073709551615)!;
    w.str("when")!;
    w.timestamp(Timestamp.{ sec: -5, nsec: 7 })!;
    w.str("list")!;
    w.array_header(3)!;
    w.float(1.5)!;
    w.float(0.1)!;
    w.bin("\x00\x01")!;
    let mut doc = decode(s.bytes())!;
    defer doc.deinit();
    let r = doc.root;
    @expect_eq(r.get("id")!.as_i64()!, -70000);
    @expect_eq(r.get("big")!.as_u64()!, 18446744073709551615);
    let t = r.get("when")!.as_timestamp()!;
    @expect_eq(t.sec, -5);
    @expect_eq(t.nsec, 7);
    @expect_eq(r.get("list")!.at(1)!.as_f64()!, 0.1);
    @expect_eq(r.get("list")!.at(2)!.as_bin()!, "\x00\x01");
    @expect(fails(r.get("nope")));
    let mut j = strs.String.init();
    defer j.deinit();
    to_json(j.writer(), r)!;
    @expect_eq(j.bytes(),
               "{\"id\":-70000,\"big\":18446744073709551615,\"when\":{\"ext\":-1,\"data\":[0,0,0,7,255,255,255,255,255,255,255,251]},\"list\":[1.5,0.1,[0,1]]}");
    // JSON in, JSON out
    let mp = from_json_text("{\"a\":[1,2.5,\"x\",null,true],\"b\":{}}")!;
    defer mem.free(mp);
    let mut d2 = decode(mp)!;
    defer d2.deinit();
    j.clear();
    to_json(j.writer(), d2.root)!;
    @expect_eq(j.bytes(), "{\"a\":[1,2.5,\"x\",null,true],\"b\":{}}");
    // encode_to gives encode's bytes, and passes on the writer's errors
    let again = encode(d2.root)!;
    defer mem.free(again);
    @expect_eq(again, mp);
    let mut out = strs.String.init();
    defer out.deinit();
    encode_to(out.writer(), doc.root)!;
    @expect_eq(out.bytes(), s.bytes());
    let mut small: [8]u8 = [0; 8];
    let mut bw = io.BufferWriter.init(small[..]);
    encode_to(bw.writer(), doc.root) catch |e| {
        @expect_eq(e, error.NoSpaceLeft);
        return;
    };
    @trap();
}

fn fails(r: !Value) bool {
    _ = r catch return true;
    return false;
}

fn fails_doc(r: !Document) bool {
    let mut d = r catch return true;
    d.deinit();
    return false;
}

test "hostile input" {
    let bad: [8][]u8 = [
        "",                      // nothing
        "\xc1",                  // never used
        "\x92\x01",              // truncated array
        "\xdd\xff\xff\xff\xff",  // an array longer than the input
        "\xdb\xff\xff\xff\xff",  // a string longer than the input
        "\xa2\xff\xfe",          // not UTF-8
        "\xcf\x00",              // truncated integer
        "\x01\x02",              // trailing data
    ];
    for b in bad {
        @expect(fails_doc(decode(b)));
    }
    // deep nesting
    let mut s = strs.String.init();
    defer s.deinit();
    for _k in @as(usize, 0)..100000 {
        s.push(0x91)!;
    }
    s.push(0xc0)!;
    @expect(fails_doc(decode(s.bytes())));
    // a stream of values
    let mut used: usize = 0;
    let mut d = decode_prefix("\x01\x02", Options.default(), &mut used)!;
    d.deinit();
    @expect_eq(used, 1);
}
