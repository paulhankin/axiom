// =============================================================================
// std/encoding/yaml/composer.ax - Composing YAML events into json.Value trees, part of std/encoding/yaml.
// =============================================================================

import "../../collections/arena.ax" as arena;
import "../../collections/map.ax" as maps;
import "../../collections/vec.ax" as vec;
import "../../diag.ax" as diag;
import "../../fmt.ax" as fmt;
import "../../hash.ax" as hash;
import "../../str.ax" as strs;
import "../json.ax" as json;

// -----------------------------------------------------------------------------
// Composing documents: events into json.Value trees
// -----------------------------------------------------------------------------

nocopy struct Frame {
    seq: bool,
    items: vec.Vec.[json.Value],
    members: vec.Vec.[json.Member],
    key: []u8,
    has_key: bool,
    anchor: []u8,
    size: u64,
}

struct Anchored {
    value: json.Value,
    size: u64,
}

nocopy struct Composer {
    ev: *mut Events,
    ar: *mut arena.Arena,
    frames: vec.Vec.[Frame],
    anchors: maps.Map.[[]u8, Anchored, hash.hash_bytes, hash.eq_bytes],
    total: u64,
    limit: u64,
    msg: []u8,
    cur_mark: Mark,
    doc_start: Mark,
    err_mark: Mark,
    has_err_mark: bool,

    fn fail(self: *mut Composer, m: []u8, e: YamlError) YamlError {
        return self.fail_at(m, self.cur_mark, e);
    }

    fn fail_at(self: *mut Composer, m: []u8, mark: Mark, e: YamlError) YamlError {
        if self.msg.len == 0 {
            self.msg = m;
            self.err_mark = mark;
            self.has_err_mark = true;
        }
        return e;
    }

    // Adds a finished value (of `size`: a node counts 1, and a scalar its
    // length more) to the current collection, or returns true when it is the
    // document's root.
    fn add(self: *mut Composer, v: json.Value, size: u64, root: *mut json.Value) infer!bool {
        self.total = @add_checked(self.total, size) catch @max_value(u64);
        if self.total > self.limit {
            return self.fail("aliases expand beyond the size limit", error.TooLarge);
        }
        if self.frames.len() == 0 {
            root.* = v;
            return true;
        }
        let f = self.frames.get_ptr(self.frames.len() - 1);
        f.size += size;  // (at most total, so this cannot wrap)
        if f.seq {
            f.items.push(v)!;
            return false;
        }
        if not f.has_key {
            let k = v.as_str() catch "";
            match v {
                .Array(_x)  => { return self.fail("a mapping key is not a scalar", error.Unsupported); }
                .Object(_y) => { return self.fail("a mapping key is not a scalar", error.Unsupported); }
                else => {}
            }
            f.key = scalar_text(self.ar, v, k)!;
            f.has_key = true;
            return false;
        }
        f.members.push(json.Member.{ key: f.key, value: v })!;
        f.has_key = false;
        return false;
    }

    fn remember(self: *mut Composer, anchor: []u8, v: json.Value, size: u64) infer!void {
        if anchor.len > 0 {
            self.anchors.put(anchor, Anchored.{ value: v, size: size })!;
        }
    }

    // The next document's root, or .none at the end of the stream.
    fn document(self: *mut Composer) infer!?json.Value {
        loop {
            let e = self.ev.next()! ?? return .none;
            if e.kind == EventKind.STREAM_START {
                continue;
            }
            if e.kind == EventKind.STREAM_END {
                return .none;
            }
            if e.kind == EventKind.DOCUMENT_START {
                self.doc_start = e.start;
                self.cur_mark = e.start;
                break;
            }
        }
        self.anchors.clear();
        let mut root = json.Value.Null;
        loop {
            let e = self.ev.next()! ?? return self.fail("expected the end of the document", error.SyntaxError);
            self.cur_mark = e.start;
            match e.kind {
                .ALIAS => {
                    let a = self.anchors.get(e.anchor) ?? return self.fail(
                        "an alias to an unknown anchor", error.SyntaxError);
                    if self.add(a.value, a.size, &mut root)! {
                        break;
                    }
                }
                .SCALAR => {
                    let v = resolve(self.ar, e) catch |err| {
                        return self.fail("a scalar does not match its tag", err);
                    };
                    let size = 1 + @as(u64, e.value.len);
                    self.remember(e.anchor, v, size)!;
                    if self.add(v, size, &mut root)! {
                        break;
                    }
                }
                .SEQUENCE_START => {
                    self.frames.push(Frame.{ seq: true, items: vec.Vec.[json.Value].init(),
                                             members: vec.Vec.[json.Member].init(), key: "", has_key: false,
                                             anchor: e.anchor, size: 1 })!;
                }
                .MAPPING_START => {
                    self.frames.push(Frame.{ seq: false, items: vec.Vec.[json.Value].init(),
                                             members: vec.Vec.[json.Member].init(), key: "", has_key: false,
                                             anchor: e.anchor, size: 1 })!;
                }
                .SEQUENCE_END => {
                    let mut f = self.frames.pop() ?? @trap();
                    let xs = self.ar.copy.[json.Value](f.items.items()) catch |err| {
                        f.items.deinit();
                        f.members.deinit();
                        return err;
                    };
                    f.items.deinit();
                    f.members.deinit();
                    let v = json.Value.Array(xs);
                    self.remember(f.anchor, v, f.size)!;
                    self.total -= f.size - 1;  // (counted as the children were added)
                    if self.add(v, f.size, &mut root)! {
                        break;
                    }
                }
                .MAPPING_END => {
                    let mut f = self.frames.pop() ?? @trap();
                    let dup = has_duplicates(f.members.items());
                    let ms = self.ar.copy.[json.Member](f.members.items()) catch |err| {
                        f.items.deinit();
                        f.members.deinit();
                        return err;
                    };
                    f.items.deinit();
                    f.members.deinit();
                    if dup {
                        return self.fail("duplicate mapping key", error.DuplicateKey);
                    }
                    let v = json.Value.Object(ms);
                    self.remember(f.anchor, v, f.size)!;
                    self.total -= f.size - 1;
                    if self.add(v, f.size, &mut root)! {
                        break;
                    }
                }
                else => {}
            }
        }
        // the document's end
        let e = self.ev.next()! ?? return self.fail("expected the end of the document", error.SyntaxError);
        if e.kind != EventKind.DOCUMENT_END {
            return self.fail("expected the end of the document", error.SyntaxError);
        }
        return .some(root);
    }
}

fn scalar_text(a: *mut arena.Arena, v: json.Value, s: []u8) infer![]u8 {
    match v {
        .String(x) => { return x; }
        .Null      => { return ""; }
        .Bool(b) => {
            if b {
                return "true";
            }
            return "false";
        }
        .Int(i) => {
            let mut buf: [24]u8 = [0; 24];
            return a.dup(fmt.format_int(buf[..], i));
        }
        .Float(x) => {
            let mut buf: [40]u8 = [0; 40];
            let t = fmt.format_float(buf[..], x) catch return error.NoSpaceLeft;
            return a.dup(t);
        }
        else => { return s; }
    }
}

fn str_less(a: []u8, b: []u8) bool {
    return strs.compare(a, b) < 0;
}

fn has_duplicates(ms: []json.Member) bool {
    if ms.len <= 16 {
        for i in @as(usize, 0)..ms.len {
            for j in i + 1..ms.len {
                if @mem_eq(ms[i].key, ms[j].key) {
                    return true;
                }
            }
        }
        return false;
    }
    let mut keys = vec.Vec.[[]u8].with_capacity(ms.len) catch return false;
    defer keys.deinit();
    for m in ms {
        keys.push(m.key) catch return false;
    }
    let ks = keys.items_mut();
    vec.sort.[[]u8, str_less](ks);
    for i in @as(usize, 1)..ks.len {
        if @mem_eq(ks[i - 1], ks[i]) {
            return true;
        }
    }
    return false;
}

let CORE: []u8 = "tag:yaml.org,2002:";

// A scalar's value under the core schema (or its tag).
fn resolve(a: *mut arena.Arena, e: Event) infer!json.Value {
    let s = e.value;
    let t = e.tag;
    if strs.starts_with(t, CORE) {
        let k = t[CORE.len..];
        if strs.eq(k, "str") {
            return json.Value.String(s);
        }
        if strs.eq(k, "null") {
            return json.Value.Null;
        }
        if strs.eq(k, "bool") {
            let v = plain_value(s);
            match v {
                .Bool(_b) => { return v; }
                else      => { return error.WrongType; }
            }
        }
        if strs.eq(k, "int") {
            let v = plain_value(s);
            match v {
                .Int(_i) => { return v; }
                else     => { return error.WrongType; }
            }
        }
        if strs.eq(k, "float") {
            let v = plain_value(s);
            match v {
                .Float(_f) => { return v; }
                .Int(i)    => { return json.Value.Float(@float_from_int(f64, i)); }
                else       => { return error.WrongType; }
            }
        }
    }
    if (t.len > 0) or (e.style != Style.PLAIN) {
        return json.Value.String(s);  // quoted, "!" or another tag: a string
    }
    return plain_value(s);
}

fn plain_value(s: []u8) json.Value {
    for n in ["", "~", "null", "Null", "NULL"] {
        if strs.eq(s, n) {
            return json.Value.Null;
        }
    }
    for b in ["true", "True", "TRUE"] {
        if strs.eq(s, b) {
            return json.Value.Bool(true);
        }
    }
    for b in ["false", "False", "FALSE"] {
        if strs.eq(s, b) {
            return json.Value.Bool(false);
        }
    }
    if is_int(s) {
        let v = fmt.parse_int.[i64](strs.strip_prefix(s,
                                                      "+") ??
                                    s) catch return json.Value.Float(fmt.parse_float(s) catch 0.0);
        return json.Value.Int(v);
    }
    if (s.len > 2) and (s[0] == '0') and ((s[1] == 'o') or (s[1] == 'x')) {
        let mut base: u64 = 8;
        if s[1] == 'x' {
            base = 16;
        }
        let mut v: u64 = 0;
        let mut ok = true;
        for c in s[2..] {
            let d = @as(u64, hexv(c));
            if d >= base {
                ok = false;
                break;
            }
            v = @mul_checked(v, base) catch 0xffffffffffffffff;
            v = @add_checked(v, d) catch 0xffffffffffffffff;
        }
        if ok and (v <= 0x7fffffffffffffff) {
            return json.Value.Int(@bit_cast(i64, v));
        }
    }
    let mut body = s;
    let mut neg = false;
    if (s.len > 0) and ((s[0] == '-') or (s[0] == '+')) {
        body = s[1..];
        neg = s[0] == '-';
    }
    for inf in [".inf", ".Inf", ".INF"] {
        if strs.eq(body, inf) {
            if neg {
                return json.Value.Float(-1.0 / 0.0);
            }
            return json.Value.Float(1.0 / 0.0);
        }
    }
    for nan in [".nan", ".NaN", ".NAN"] {
        if strs.eq(s, nan) {
            return json.Value.Float(0.0 / 0.0);
        }
    }
    if is_float(body) {
        let f = fmt.parse_float(s) catch return json.Value.String(s);
        return json.Value.Float(f);
    }
    return json.Value.String(s);
}

fn is_int(s: []u8) bool {
    let mut i: usize = 0;
    if (s.len > 0) and ((s[0] == '-') or (s[0] == '+')) {
        i = 1;
    }
    if i >= s.len {
        return false;
    }
    for c in s[i..] {
        if (c < '0') or (c > '9') {
            return false;
        }
    }
    return true;
}

// ( \. [0-9]+ | [0-9]+ ( \. [0-9]* )? ) ( [eE] [-+]? [0-9]+ )?
fn is_float(s: []u8) bool {
    let mut i: usize = 0;
    let mut digits: usize = 0;
    while (i < s.len) and (s[i] >= '0') and (s[i] <= '9') {
        i += 1;
        digits += 1;
    }
    if (i < s.len) and (s[i] == '.') {
        i += 1;
        while (i < s.len) and (s[i] >= '0') and (s[i] <= '9') {
            i += 1;
            digits += 1;
        }
    }
    if digits == 0 {
        return false;
    }
    if (i < s.len) and ((s[i] == 'e') or (s[i] == 'E')) {
        i += 1;
        if (i < s.len) and ((s[i] == '-') or (s[i] == '+')) {
            i += 1;
        }
        let st = i;
        while (i < s.len) and (s[i] >= '0') and (s[i] <= '9') {
            i += 1;
        }
        if i == st {
            return false;
        }
    }
    return i == s.len;
}

fn compose_all_diag(text: []u8, a: *mut arena.Arena, docs: *mut vec.Vec.[json.Value], info: *mut diag.ErrorInfo,
                    one: bool) infer!void {
    let mut ev = Events.with_arena(text, a);
    defer ev.deinit();
    let zero_mark = Mark.{ index: 0, line: 0, column: 0 };
    let mut c = Composer.{
        ev: &mut ev,
        ar: a,
        frames: vec.Vec.[Frame].init(),
        anchors: maps.Map.[[]u8, Anchored, hash.hash_bytes, hash.eq_bytes].init(),
        total: 0,
        limit: (100 * @as(u64, text.len)) + 100000,
        msg: "",
        cur_mark: zero_mark,
        doc_start: zero_mark,
        err_mark: zero_mark,
        has_err_mark: false,
    };
    defer c.anchors.deinit();
    let r = compose_loop(&mut c, docs, one);
    for &mut f in c.frames.items_mut() {
        f.items.deinit();
        f.members.deinit();
    }
    c.frames.deinit();
    r catch |e| {
        let mut m = ev.error_mark();
        let mut msg = ev.error_message();
        if msg.len == 0 {
            msg = c.msg;
            if c.has_err_mark {
                m = c.err_mark;
            } else {
                m = ev.sc.m;
            }
        }
        if (msg.len == 0) and (e == error.TooDeep) {
            msg = "nesting too deep";
        }
        if (msg.len == 0) and (e == error.OutOfMemory) {
            msg = "out of memory";
        }
        info.* = diag.ErrorInfo.at(m.index, m.line + 1, m.column + 1, msg);
        return e;
    };
}

fn compose_loop(c: *mut Composer, docs: *mut vec.Vec.[json.Value], one: bool) infer!void {
    loop {
        let v = c.document()! ?? return;
        if one and (docs.len() == 1) {
            return c.fail_at("more than one document", c.doc_start, error.MultipleDocuments);
        }
        docs.push(v)!;
    }
}
