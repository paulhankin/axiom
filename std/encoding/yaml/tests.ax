import "../../collections/arena.ax" as arena;
import "../../collections/vec.ax" as vec;
import "../../diag.ax" as diag;
import "../../fmt.ax" as fmt;
import "../../io.ax" as io;
import "../../mem.ax" as mem;
import "../../os/fs.ax" as fs;
import "../../str.ax" as strs;
import "../json.ax" as json;

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn next_line(data: []u8, at: *mut usize) []u8 {
    let st = at.*;
    let nl = strs.index_of_from(data, "\n", st) ?? data.len;
    at.* = nl + 1;
    return data[st..nl];
}

// A case of the test-suite file: a line "<id> <name> <error> <yaml length>
// <events length> <json length, or -1 for none>", then the yaml, the events
// and the json, each followed by a newline.
struct SuiteCase {
    name: []u8,
    is_err: bool,
    yaml: []u8,
    events: []u8,
    json: []u8,
    has_json: bool,
}

// The case at `at` (which moves past it), or .none at the end.
fn next_case(data: []u8, at: *mut usize) ?SuiteCase {
    if at.* >= data.len {
        return .none;
    }
    let head = next_line(data, at);
    let mut f = strs.fields(head);
    _ = f.next() ?? return .none;
    let name = f.next() ?? return .none;
    let is_err = strs.eq(f.next() ?? return .none, "1");
    let ylen = fmt.parse_int.[usize](f.next() ?? return .none) catch return .none;
    let elen = fmt.parse_int.[usize](f.next() ?? return .none) catch return .none;
    let jlen = fmt.parse_int.[i64](f.next() ?? return .none) catch return .none;
    let mut c = SuiteCase.{ name: name, is_err: is_err, yaml: "", events: "", json: "", has_json: jlen >= 0 };
    c.yaml = data[at.*..at.* + ylen];
    at.* += ylen + 1;
    c.events = data[at.*..at.* + elen];
    at.* += elen + 1;
    if c.has_json {
        let jn = @truncate(usize, @bit_cast(u64, jlen));
        c.json = data[at.*..at.* + jn];
        at.* += jn + 1;
    }
    return c;
}

// The event stream of text in test-suite form, or an error.
fn events_text(text: []u8, out: *mut strs.String) !void {
    let mut a = arena.Arena.init();
    defer a.deinit();
    let mut ev = Events.with_arena(text, &mut a);
    defer ev.deinit();
    loop {
        let e = ev.next()! ?? return;
        format_event(e, out.writer())!;
        out.push('\n')!;
    }
}

test "yaml-test-suite: events" {
    let data = fs.read_file("std/encoding/yaml/testdata/yaml-test-suite.txt") catch return;
    defer mem.free(data);
    let mut at: usize = 0;
    _ = next_line(data, &mut at);
    let mut passed: usize = 0;
    let mut failed: usize = 0;
    let mut got = strs.String.init();
    defer got.deinit();
    loop {
        let c = next_case(data, &mut at) ?? break;
        got.clear();
        let r = events_text(c.yaml, &mut got);
        let mut ok = false;
        if c.is_err {
            ok = fails(r);
        } else {
            ok = not fails(r) and strs.eq(got.bytes(), c.events);
        }
        if ok {
            passed += 1;
        } else {
            failed += 1;
            if failed <= 60 {
                fmt.print("FAIL {}\n", [fmt.str(c.name)]) catch {};
            }
        }
    }
    fmt.print("yaml-test-suite events: {} passed, {} failed\n", [fmt.int(passed), fmt.int(failed)]) catch {};
    @expect_eq(failed, 0);
}

fn fails(r: !void) bool {
    r catch return true;
    return false;
}

// The top-level JSON values of text (the suite's in.json holds one per document).
fn json_values(text: []u8, out: *mut vec.Vec.[[]u8]) infer!void {
    let mut i: usize = 0;
    while i < text.len {
        while (i < text.len) and ((text[i] == ' ') or (text[i] == '\n') or (text[i] == '\t') or (text[i] == '\r')) {
            i += 1;
        }
        if i >= text.len {
            return;
        }
        let st = i;
        let mut depth: usize = 0;
        let mut in_str = false;
        while i < text.len {
            let c = text[i];
            if in_str {
                if c == '\\' {
                    i += 1;
                } else if c == '"' {
                    in_str = false;
                    if depth == 0 {
                        i += 1;
                        break;
                    }
                }
            } else if c == '"' {
                in_str = true;
            } else if (c == '[') or (c == '{') {
                depth += 1;
            } else if (c == ']') or (c == '}') {
                depth -= 1;
                if depth == 0 {
                    i += 1;
                    break;
                }
            } else if (depth == 0) and ((c == ' ') or (c == '\n')) {
                break;
            }
            i += 1;
        }
        out.push(text[st..i])!;
    }
}

fn same(a: json.Value, b: json.Value) bool {
    match b {
        .Null      => { return a.is_null(); }
        .Bool(x)   => { return (a.as_bool() catch return false) == x; }
        .Int(x)    => { return (a.as_f64() catch return false) == @float_from_int(f64, x); }
        .Float(x)  => { return (a.as_f64() catch return false) == x; }
        .String(x) => { return strs.eq(a.as_str() catch return false, x); }
        .Array(xs) => {
            let ys = a.as_array() catch return false;
            if xs.len != ys.len {
                return false;
            }
            for k in @as(usize, 0)..xs.len {
                if not same(ys[k], xs[k]) {
                    return false;
                }
            }
            return true;
        }
        .Object(ms) => {
            let ns = a.as_object() catch return false;
            if ns.len != ms.len {
                return false;
            }
            for m in ms {
                if not same(a.get(m.key) ?? return false, m.value) {
                    return false;
                }
            }
            return true;
        }
    }
}

test "yaml-test-suite: documents against in.json" {
    let data = fs.read_file("std/encoding/yaml/testdata/yaml-test-suite.txt") catch return;
    defer mem.free(data);
    let mut at: usize = 0;
    _ = next_line(data, &mut at);
    let mut passed: usize = 0;
    let mut failed: usize = 0;
    let mut vals = vec.Vec.[[]u8].init();
    defer vals.deinit();
    loop {
        let c = next_case(data, &mut at) ?? break;
        if not c.has_json or c.is_err {
            continue;  // (a few error cases carry JSON of what came before the error)
        }
        vals.clear();
        json_values(c.json, &mut vals)!;
        let mut ok = true;
        let mut st = parse_all(c.yaml) catch |e| {
            fmt.print("FAIL {} ({})\n", [fmt.str(c.name), fmt.str(@error_name(e))]) catch {};
            failed += 1;
            continue;
        };
        if st.documents.len != vals.len() {
            ok = false;
        } else {
            for k in @as(usize, 0)..vals.len() {
                let mut want = json.parse(vals.get(k)) catch @trap();
                if not same(st.documents[k], want.root) {
                    ok = false;
                }
                want.deinit();
            }
        }
        st.deinit();
        if ok {
            passed += 1;
        } else {
            failed += 1;
            fmt.print("FAIL {}\n", [fmt.str(c.name)]) catch {};
        }
    }
    fmt.print("yaml-test-suite documents: {} passed, {} failed\n", [fmt.int(passed), fmt.int(failed)]) catch {};
    @expect_eq(failed, 0);
    @expect(passed > 250);
}

test "trees, tags and errors" {
    let mut d =
        parse("name: Ada\nborn: 1815\nratio: 0.5\nlangs: [en, fr]\nnothing: ~\nyes: true\nhex: 0x1F\nquoted: '42'\ntagged: !!str 7\nfloat: !!float 3\n")!;
    defer d.deinit();
    @expect_eq((d.root.get("name") ?? @trap()).as_str()!, "Ada");
    @expect_eq((d.root.get("born") ?? @trap()).as_i64()!, 1815);
    @expect_eq((d.root.get("ratio") ?? @trap()).as_f64()!, 0.5);
    @expect_eq(((d.root.get("langs") ?? @trap()).at(1) ?? @trap()).as_str()!, "fr");
    @expect((d.root.get("nothing") ?? @trap()).is_null());
    @expect((d.root.get("yes") ?? @trap()).as_bool()!);
    @expect_eq((d.root.get("hex") ?? @trap()).as_i64()!, 31);
    @expect_eq((d.root.get("quoted") ?? @trap()).as_str()!, "42");
    @expect_eq((d.root.get("tagged") ?? @trap()).as_str()!, "7");
    @expect_eq((d.root.get("float") ?? @trap()).as_f64()!, 3.0);
    // anchors share their value
    let mut a = parse("base: &b {x: 1}\nuse: *b\n")!;
    defer a.deinit();
    @expect_eq(((a.root.get("use") ?? @trap()).get("x") ?? @trap()).as_i64()!, 1);
    // errors
    let mut info = ErrorInfo.{ line: 0, column: 0, message: "" };
    _ = parse_with("a: 1\nb: [1, 2\n", &mut info) catch |e| {
        @expect_eq(e, error.SyntaxError);
        @expect(info.line >= 2);
        @expect(info.message.len > 0);
        @expect(fails_doc("a: 1\na: 2\n"));
        @expect(fails_doc("--- 1\n--- 2\n"));
        @expect(fails_doc("x: !!int abc\n"));
        @expect(fails_doc("x: *nope\n"));
        return;
    };
    @trap();
}

fn fails_doc(text: []u8) bool {
    let mut d = parse(text) catch return true;
    d.deinit();
    return false;
}

test "hostile input" {
    // billion laughs: refused, not expanded
    let mut s = strs.String.init();
    defer s.deinit();
    s.push_str("a: &a [x, x, x, x, x, x, x, x, x, x]\n")!;
    let names = "abcdefghij";
    for k in @as(usize, 1)..10 {
        let c = names[k..k + 1];
        let p = names[k - 1..k];
        s.push_str(c)!;
        s.push_str(": &")!;
        s.push_str(c)!;
        s.push_str(" [")!;
        for q in @as(usize, 0)..10 {
            if q > 0 {
                s.push_str(", ")!;
            }
            s.push('*')!;
            s.push_str(p)!;
        }
        s.push_str("]\n")!;
    }
    _ = parse(s.bytes()) catch |e| {
        @expect_eq(e, error.TooLarge);
        // deep nesting
        let mut deep = strs.String.init();
        defer deep.deinit();
        for _k in @as(usize, 0)..100000 {
            deep.push('[')!;
        }
        _ = parse(deep.bytes()) catch |e2| {
            @expect_eq(e2, error.TooDeep);
            let mut blk = strs.String.init();
            defer blk.deinit();
            for k in @as(usize, 0)..2000 {
                indent_to(blk.writer(), k)!;
                blk.push_str("- \n")!;
            }
            _ = parse(blk.bytes()) catch return;
            @trap();
        };
        @trap();
    };
    @trap();
}

test "aliases of long scalars count their length" {
    let mut s = strs.String.init();
    defer s.deinit();
    s.push_str("a: &a ")!;
    for _k in @as(usize, 0)..50000 {
        s.push('x')!;
    }
    s.push_str("\nb: [")!;
    let base = s.len();
    for _k in @as(usize, 0)..10 {
        s.push_str("*a, ")!;
    }
    s.push_str("*a]\n")!;
    let mut doc = parse(s.bytes())!;
    @expect_eq((doc.root.get("b") ?? @trap()).len(), 11);
    doc.deinit();
    // 10000 copies of 50000 bytes: refused
    s.truncate(base);
    for _k in @as(usize, 0)..10000 {
        s.push_str("*a, ")!;
    }
    s.push_str("*a]\n")!;
    _ = parse(s.bytes()) catch |e| {
        @expect_eq(e, error.TooLarge);
        return;
    };
    @trap();
}

test "writing round trips" {
    let src =
        "title: \"true\"\ncount: 3\nitems:\n- plain text\n- 'with: colon'\n- \"line\\nbreak\"\n- {a: 1, b: [x, y]}\n- []\nempty: {}\nweird: \" padded \"\nnum_str: \"012\"\nf: 2.0\nn: null\n";
    let mut d = parse(src)!;
    defer d.deinit();
    let out = stringify(d.root)!;
    defer mem.free(out);
    let mut back = parse(out)!;
    defer back.deinit();
    @expect(same(back.root, d.root));
    @expect(strs.contains(out, "title: \"true\"\n"));
    @expect(strs.contains(out, "- plain text\n"));
    @expect(strs.contains(out, "f: 2.0\n"));
    let mut sw = strs.String.init();
    defer sw.deinit();
    stringify_to(sw.writer(), d.root)!;
    @expect_eq(sw.bytes(), out);
    let mut small: [16]u8 = [0; 16];
    let mut bw = io.BufferWriter.init(small[..]);
    stringify_to(bw.writer(), d.root) catch |e| {
        @expect_eq(e, error.NoSpaceLeft);
        return;
    };
    @trap();
}

test "writing long keys, byte order marks and C1 controls" {
    let mut src = strs.String.init();
    defer src.deinit();
    src.push_str("{\"bom\": \"\\uFEFFx\", \"c1\": \"x\\u009Cy\\u0085z\", \"\\uFEFF\": 1, \"outer\": {\"")!;
    for _i in @as(usize, 0)..1025 {
        src.push('k')!;
    }
    src.push_str("\": {\"a\": [1, 2]}, \"")!;
    for _i in @as(usize, 0)..1024 {
        src.push('j')!;
    }
    src.push_str("\": null, \"")!;
    for _i in @as(usize, 0)..600 {
        src.push_str("\\u00e9")!;
    }
    src.push_str("\": \"q\\\"\", \"b\": 2}}")!;
    let mut d = json.parse(src.bytes())!;
    defer d.deinit();
    let out = stringify(d.root)!;
    defer mem.free(out);
    let mut back = parse(out)!;
    defer back.deinit();
    @expect(same(back.root, d.root));
    @expect(strs.contains(out, "bom: \"\\uFEFFx\"\n"));
    @expect(strs.contains(out, "c1: \"x\\x9Cy\u{85}z\"\n"));
    @expect(strs.contains(out, "  ? kkk"));
    @expect(strs.contains(out, "k\n  :\n    a:\n"));
    @expect(strs.contains(out, "  jjj"));
    @expect(not strs.contains(out, "? jjj"));
    @expect(strs.contains(out, "  ? \u{e9}"));
}

fn parse_diag_err(text: []u8, info: *mut diag.ErrorInfo) ?YamlError {
    let mut d = parse_diag(text, info) catch |e| {
        return .some(e);
    };
    d.deinit();
    return .none;
}

fn parse_all_diag_err(text: []u8, info: *mut diag.ErrorInfo) ?YamlError {
    let mut s = parse_all_diag(text, info) catch |e| {
        return .some(e);
    };
    s.deinit();
    return .none;
}

test "parse_diag, parse_all_diag and narrowed stringify" {
    let mut info = diag.ErrorInfo.at(99, 9, 9, "stale");
    let mut ok = parse_diag("a: 1\nb: 2\n", &mut info)!;
    defer ok.deinit();
    @expect_eq(info.offset, 0);
    @expect_eq(info.line, 0);
    @expect_eq(info.col, 0);
    @expect_eq(info.detail, "");

    let e1 = parse_diag_err("a: 1\nb: [1, 2\n", &mut info) ?? @trap();
    @expect_eq(e1, error.SyntaxError);
    @expect(info.offset >= 7);
    @expect(info.line >= 2);
    @expect(info.col >= 1);
    @expect(info.detail.len > 0);

    let e2 = parse_diag_err("--- 1\n--- 2\n", &mut info) ?? @trap();
    @expect_eq(e2, error.MultipleDocuments);
    @expect_eq(info.offset, 6);
    @expect_eq(info.line, 2);
    @expect_eq(info.col, 1);
    @expect_eq(info.detail, "more than one document");

    let e3 = parse_diag_err("a: 1\nx: !!int abc\n", &mut info) ?? @trap();
    @expect_eq(e3, error.WrongType);
    @expect_eq(info.offset, 8);
    @expect_eq(info.line, 2);
    @expect_eq(info.col, 4);
    @expect_eq(info.detail, "a scalar does not match its tag");

    info = diag.ErrorInfo.at(77, 7, 7, "stale");
    let mut st = parse_all_diag("--- 1\n--- 2\n", &mut info)!;
    defer st.deinit();
    @expect_eq(st.documents.len, 2);
    @expect_eq(info.offset, 0);
    @expect_eq(info.line, 0);
    @expect_eq(info.col, 0);
    @expect_eq(info.detail, "");

    let e4 = parse_all_diag_err("--- 1\n--- *nope\n", &mut info) ?? @trap();
    @expect_eq(e4, error.SyntaxError);
    @expect_eq(info.offset, 10);
    @expect_eq(info.line, 2);
    @expect_eq(info.col, 5);
    @expect_eq(info.detail, "an alias to an unknown anchor");

    // stringify preserves TooDeep when value exceeds MAX_DEPTH
    let mut cells: [520]json.Value = [json.Value.Null; 520];
    let mut cur = json.Value.Null;
    for i in @as(usize, 0)..520 {
        cells[i] = cur;
        cur = json.Value.Array(cells[i..i + 1]);
    }
    let mut deep_failed = false;
    let out = stringify(cur) catch |e| {
        @expect_eq(e, error.TooDeep);
        deep_failed = true;
        return;
    };
    mem.free(out);
    @expect(deep_failed);
}
