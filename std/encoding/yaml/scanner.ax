// =============================================================================
// std/encoding/yaml/scanner.ax - YAML token types and scanner core, part of std/encoding/yaml.
// =============================================================================

import "../../collections/arena.ax" as arena;
import "../../collections/vec.ax" as vec;
import "../../fmt.ax" as fmt;
import "../../str.ax" as strs;

// -----------------------------------------------------------------------------
// Tokens
// -----------------------------------------------------------------------------

enum TokenKind: u8 {
    NONE,
    STREAM_START,
    STREAM_END,
    VERSION_DIRECTIVE,
    TAG_DIRECTIVE,
    DOCUMENT_START,
    DOCUMENT_END,
    BLOCK_SEQUENCE_START,
    BLOCK_MAPPING_START,
    BLOCK_END,
    FLOW_SEQUENCE_START,
    FLOW_SEQUENCE_END,
    FLOW_MAPPING_START,
    FLOW_MAPPING_END,
    BLOCK_ENTRY,
    FLOW_ENTRY,
    KEY,
    VALUE,
    ALIAS,
    ANCHOR,
    TAG,
    SCALAR,
}

struct Token {
    kind: TokenKind,
    start: Mark,
    end: Mark,
    value: []u8,   // scalar text, anchor or alias name, directive value
    handle: []u8,  // tag handle, or %TAG handle
    style: Style,
}

struct SimpleKey {
    possible: bool,
    required: bool,
    token_number: usize,
    mark: Mark,
}

// -----------------------------------------------------------------------------
// The scanner
// -----------------------------------------------------------------------------

// "---" or "..." at the start of a line, then a blank or the end.
fn is_doc_marker(sc: *Scanner) bool {
    let a = sc.at(0);
    return (sc.m.column == 0) and ((a == '-') or (a == '.')) and (sc.at(1) == a) and (sc.at(2) == a) and sc.blankz(3);
}

nocopy struct Scanner {
    s: []u8,
    m: Mark,
    ar: *mut arena.Arena,
    tokens: vec.Vec.[Token],
    head: usize,    // the next token to hand out, in tokens
    parsed: usize,  // tokens handed out so far
    started: bool,
    ended: bool,
    indent: i32,
    indents: vec.Vec.[i32],
    allowed: bool,  // a simple key may start here
    keys: vec.Vec.[SimpleKey],
    flow: u32,
    flow_maps: vec.Vec.[bool],  // for each open flow collection: is it a mapping
    line_start: usize,          // where the current line starts
    token_line: u32,            // the line where the last token ended
    last_kind: TokenKind,       // the last token queued, and its style
    last_style: Style,
    last_end: usize,
    buf: strs.String,
    lead: strs.String,   // scalar folding: the leading line break
    trail: strs.String,  // and the ones after it
    ws: strs.String,     // and white space
    err: []u8,
    err_mark: Mark,

    fn fail(self: *mut Scanner, msg: []u8) YamlError {
        if self.err.len == 0 {
            self.err = msg;
            self.err_mark = self.m;
        }
        return error.SyntaxError;
    }

    fn at(self: *Scanner, k: usize) u8 {
        let i = self.m.index + k;
        if i < self.s.len {
            return self.s[i];
        }
        return 0;
    }

    fn eof(self: *Scanner) bool {
        return self.m.index >= self.s.len;
    }

    fn blankz(self: *Scanner, k: usize) bool {
        let i = self.m.index + k;
        if i >= self.s.len {
            return true;
        }
        let c = self.s[i];
        return is_blank(c) or is_break(c);
    }

    fn breakz(self: *Scanner, k: usize) bool {
        let i = self.m.index + k;
        return (i >= self.s.len) or is_break(self.s[i]);
    }

    // One character (a whole UTF-8 sequence).
    fn skip(self: *mut Scanner) void {
        let c = self.s[self.m.index];
        let mut n: usize = 1;
        if c >= 0xf0 {
            n = 4;
        } else if c >= 0xe0 {
            n = 3;
        } else if c >= 0xc0 {
            n = 2;
        }
        self.m.index = @min(self.m.index + n, self.s.len);
        self.m.column += 1;
    }

    fn skip_line(self: *mut Scanner) void {
        if (self.at(0) == '\r') and (self.at(1) == '\n') {
            self.m.index += 2;
        } else {
            self.m.index += 1;
        }
        self.m.line += 1;
        self.m.column = 0;
        self.line_start = self.m.index;
    }

    // Copies one character to b.
    fn copy(self: *mut Scanner, b: *mut strs.String) YamlError!void {
        let st = self.m.index;
        self.skip();
        b.push_str(self.s[st..self.m.index])!;
    }

    // A line break into b, as \n.
    fn read_line(self: *mut Scanner, b: *mut strs.String) YamlError!void {
        self.skip_line();
        b.push('\n')!;
    }

    fn token(self: *Scanner, kind: TokenKind, start: Mark) Token {
        return Token.{ kind: kind, start: start, end: self.m, value: "", handle: "", style: Style.NONE };
    }

    fn push(self: *mut Scanner, t: Token) YamlError!void {
        self.tokens.push(t)!;
        self.last_kind = t.kind;
        self.last_style = t.style;
        self.last_end = t.end.index;
        self.token_line = t.end.line;
    }

    // --- the token queue ---------------------------------------------------------

    /// The next token (not consumed).
    fn peek_token(self: *mut Scanner) YamlError!*mut Token {
        self.fetch_more()!;
        return self.tokens.get_ptr(self.head);
    }

    fn take_token(self: *mut Scanner) void {
        self.head += 1;
        self.parsed += 1;
        if (self.head > 256) and ((self.head * 2) > self.tokens.len()) {
            // drop the handed-out tokens
            let rest = self.tokens.len() - self.head;
            let items = self.tokens.items_mut();
            @mem_copy(items[..rest], items[self.head..]);
            self.tokens.truncate(rest);
            self.head = 0;
        }
    }

    fn fetch_more(self: *mut Scanner) YamlError!void {
        loop {
            let mut need = self.head >= self.tokens.len();
            if not need {
                self.stale_keys()!;
                for k in self.keys.items() {
                    if k.possible and (k.token_number == self.parsed) {
                        need = true;
                    }
                }
            }
            if not need {
                return;
            }
            if self.ended and (self.head >= self.tokens.len()) {
                return self.fail("unexpected end of stream");
            }
            self.fetch_next()!;
        }
    }

    // --- simple keys ---------------------------------------------------------------

    fn stale_keys(self: *mut Scanner) YamlError!void {
        for i in @as(usize, 0)..self.keys.len() {
            let k = self.keys.get_ptr(i);
            let multiline_ok = (i > 0) and (i <= self.flow_maps.len()) and self.flow_maps.get(i - 1);
            if k.possible and
               (((k.mark.line < self.m.line) and not multiline_ok) or
                ((self.m.index - k.mark.index) > MAX_IMPLICIT_KEY)) {
                if k.required {
                    return self.fail("could not find expected ':'");
                }
                k.possible = false;
            }
        }
    }

    fn save_key(self: *mut Scanner) YamlError!void {
        let required = (self.flow == 0) and (self.indent == @bit_cast(i32, self.m.column));
        if self.allowed {
            self.remove_key()!;
            let k = self.keys.get_ptr(self.keys.len() - 1);
            k.possible = true;
            k.required = required;
            k.token_number = self.parsed + (self.tokens.len() - self.head);
            k.mark = self.m;
        }
    }

    fn remove_key(self: *mut Scanner) YamlError!void {
        let k = self.keys.get_ptr(self.keys.len() - 1);
        if k.possible and k.required {
            return self.fail("could not find expected ':'");
        }
        k.possible = false;
    }

    fn flow_in(self: *mut Scanner, mapping: bool) YamlError!void {
        if self.keys.len() > MAX_DEPTH {
            if self.err.len == 0 {
                self.err = "nesting too deep";
                self.err_mark = self.m;
            }
            return error.TooDeep;
        }
        self.keys.push(SimpleKey.{ possible: false, required: false, token_number: 0, mark: self.m })!;
        self.flow_maps.push(mapping)!;
        self.flow += 1;
    }

    fn flow_out(self: *mut Scanner) void {
        if self.flow > 0 {
            self.flow -= 1;
            _ = self.keys.pop();
            _ = self.flow_maps.pop();
        }
    }

    // --- indentation -------------------------------------------------------------------

    // Opens a block collection at column (its start token goes at token
    // number `number`, or at the end).
    fn roll(self: *mut Scanner, column: i32, number: usize, at_end: bool, kind: TokenKind, mark: Mark) YamlError!void {
        if self.flow > 0 {
            return;
        }
        if self.indent < column {
            if self.indents.len() > MAX_DEPTH {
                if self.err.len == 0 {
                    self.err = "nesting too deep";
                    self.err_mark = mark;
                }
                return error.TooDeep;
            }
            // the white space before a block collection's first token
            // (indentation or separation) must not hold a tab
            let mut k = mark.index;
            while (k > 0) and is_blank(self.s[k - 1]) {
                if self.s[k - 1] == '\t' {
                    return self.fail("a tab cannot separate or indent a block collection");
                }
                k -= 1;
            }
            self.indents.push(self.indent)!;
            self.indent = column;
            let t = Token.{ kind: kind, start: mark, end: mark, value: "", handle: "", style: Style.NONE };
            if at_end {
                self.push(t)!;
            } else {
                self.tokens.insert(self.head + (number - self.parsed), t)!;
            }
        }
    }

    fn unroll(self: *mut Scanner, column: i32) YamlError!void {
        if self.flow > 0 {
            return;
        }
        while self.indent > column {
            self.push(self.token(TokenKind.BLOCK_END, self.m))!;
            self.indent = self.indents.pop() ?? -1;
        }
    }

    // --- dispatch --------------------------------------------------------------------------

    fn fetch_next(self: *mut Scanner) YamlError!void {
        if not self.started {
            self.started = true;
            self.indent = -1;
            self.allowed = true;
            self.keys.push(SimpleKey.{ possible: false, required: false, token_number: 0, mark: self.m })!;
            self.push(self.token(TokenKind.STREAM_START, self.m))!;
            return;
        }
        self.skip_to_token()!;
        self.stale_keys()!;
        self.unroll(@bit_cast(i32, self.m.column))!;
        if self.eof() {
            return self.fetch_stream_end();
        }
        let c = self.at(0);
        let col0 = self.m.column == 0;
        // flow content on a new line must be indented past the block around it
        if (self.flow > 0) and (self.m.line > self.token_line) and
           (@bit_cast(i32, self.line_spaces()) <= self.indent) and not (col0 and is_doc_marker(self)) {
            return self.fail("wrong indentation in a flow collection");
        }
        if col0 and (c == '%') and (self.flow == 0) {
            return self.fetch_directive();
        }
        if col0 and (c == '-') and (self.at(1) == '-') and (self.at(2) == '-') and self.blankz(3) {
            return self.fetch_document_indicator(TokenKind.DOCUMENT_START);
        }
        if col0 and (c == '.') and (self.at(1) == '.') and (self.at(2) == '.') and self.blankz(3) {
            return self.fetch_document_indicator(TokenKind.DOCUMENT_END);
        }
        if c == '[' {
            return self.fetch_flow_start(TokenKind.FLOW_SEQUENCE_START, false);
        }
        if c == '{' {
            return self.fetch_flow_start(TokenKind.FLOW_MAPPING_START, true);
        }
        if c == ']' {
            return self.fetch_flow_end(TokenKind.FLOW_SEQUENCE_END);
        }
        if c == '}' {
            return self.fetch_flow_end(TokenKind.FLOW_MAPPING_END);
        }
        if c == ',' {
            return self.fetch_flow_entry();
        }
        if (c == '-') and self.blankz(1) {
            return self.fetch_block_entry();
        }
        if (c == '?') and self.blankz(1) {
            return self.fetch_key();
        }
        if (c == ':') and
           (self.blankz(1) or ((self.flow > 0) and (is_flow_indicator(self.at(1)) or self.after_json_node()))) {
            return self.fetch_value();
        }
        if c == '*' {
            return self.fetch_anchor(TokenKind.ALIAS);
        }
        if c == '&' {
            return self.fetch_anchor(TokenKind.ANCHOR);
        }
        if c == '!' {
            return self.fetch_tag();
        }
        if ((c == '|') or (c == '>')) and (self.flow == 0) {
            return scan_block_scalar(self, c == '|');
        }
        if c == '\'' {
            return scan_flow_scalar(self, true);
        }
        if c == '"' {
            return scan_flow_scalar(self, false);
        }
        // a plain scalar starts with anything but an indicator; - ? : start
        // one when followed by a non-space
        let indicator = (strs.index_of_byte("-?:,[]{}#&*!|>'\"%@`", c) ?? 99) != 99;
        let flow_safe = not ((self.flow > 0) and is_flow_indicator(self.at(1)));
        if (not indicator and not self.blankz(0)) or ((c == '-') and not self.blankz(1) and flow_safe) or
           ((self.flow == 0) and ((c == '?') or (c == ':')) and not self.blankz(1)) or
           ((self.flow > 0) and ((c == '?') or (c == ':')) and not self.blankz(1) and
            not is_flow_indicator(self.at(1))) {
            return scan_plain_scalar(self);
        }
        return self.fail("found a character that cannot start any token");
    }

    // Spaces (not tabs) at the start of the current line.
    fn line_spaces(self: *Scanner) u32 {
        let mut k = self.line_start;
        while (k < self.s.len) and (self.s[k] == ' ') {
            k += 1;
        }
        return @truncate(u32, k - self.line_start);
    }

    // In a flow collection, ':' after a quoted key or a JSON-like node is
    // a value indicator even without a space after it ("a":b).
    fn after_json_node(self: *Scanner) bool {
        let k = self.last_kind;
        return ((k == TokenKind.SCALAR) and
                ((self.last_style == Style.SINGLE_QUOTED) or (self.last_style == Style.DOUBLE_QUOTED))) or
               (k == TokenKind.FLOW_SEQUENCE_END) or (k == TokenKind.FLOW_MAPPING_END);
    }

    fn skip_to_token(self: *mut Scanner) YamlError!void {
        loop {
            if (self.m.index == 0) and (self.at(0) == 0xef) and (self.at(1) == 0xbb) and (self.at(2) == 0xbf) {
                self.m.index = 3;
            }
            while is_blank(self.at(0)) {
                self.skip();
            }
            if self.at(0) == '#' {
                if (self.m.index > 0) and not is_blank(self.s[self.m.index - 1]) and
                   not is_break(self.s[self.m.index - 1]) {
                    return self.fail("a comment must follow white space");
                }
                while not self.breakz(0) {
                    self.skip();
                }
            }
            if not self.eof() and is_break(self.at(0)) {
                self.skip_line();
                if self.flow == 0 {
                    self.allowed = true;
                }
                continue;
            }
            return;
        }
    }

    fn fetch_stream_end(self: *mut Scanner) YamlError!void {
        if self.m.column != 0 {
            self.m.column = 0;
            self.m.line += 1;
        }
        self.unroll(-1)!;
        self.remove_key()!;
        self.allowed = false;
        self.push(self.token(TokenKind.STREAM_END, self.m))!;
        self.ended = true;
    }

    fn fetch_directive(self: *mut Scanner) YamlError!void {
        self.unroll(-1)!;
        self.remove_key()!;
        self.allowed = false;
        let start = self.m;
        self.skip();
        let ns = self.m.index;
        while is_word(self.at(0)) {
            self.skip();
        }
        let name = self.s[ns..self.m.index];
        if name.len == 0 {
            return self.fail("expected a directive name");
        }
        if not self.blankz(0) {
            return self.fail("unexpected character after the directive name");
        }
        while is_blank(self.at(0)) {
            self.skip();
        }
        if strs.eq(name, "YAML") {
            let vs = self.m.index;
            while not self.blankz(0) {
                self.skip();
            }
            let v = self.s[vs..self.m.index];
            let dot = strs.index_of_byte(v, '.') ?? return self.fail("bad %YAML version");
            let major = fmt.parse_int.[u32](v[..dot]) catch return self.fail("bad %YAML version");
            _ = fmt.parse_int.[u32](v[dot + 1..]) catch return self.fail("bad %YAML version");
            if major != 1 {
                return self.fail("unsupported YAML version");
            }
            self.directive_end()!;
            let mut t = self.token(TokenKind.VERSION_DIRECTIVE, start);
            t.value = v;
            self.push(t)!;
            return;
        }
        if strs.eq(name, "TAG") {
            let hs = self.m.index;
            while not self.blankz(0) {
                self.skip();
            }
            let handle = self.s[hs..self.m.index];
            while is_blank(self.at(0)) {
                self.skip();
            }
            let ps = self.m.index;
            while not self.blankz(0) {
                self.skip();
            }
            let prefix = self.s[ps..self.m.index];
            if (handle.len == 0) or (handle[0] != '!') or ((handle.len > 1) and (handle[handle.len - 1] != '!')) or
               (prefix.len == 0) {
                return self.fail("bad %TAG directive");
            }
            self.directive_end()!;
            let mut t = self.token(TokenKind.TAG_DIRECTIVE, start);
            t.handle = handle;
            t.value = prefix;
            self.push(t)!;
            return;
        }
        // an unknown directive: ignored
        while not self.breakz(0) {
            self.skip();
        }
    }

    fn directive_end(self: *mut Scanner) YamlError!void {
        while is_blank(self.at(0)) {
            self.skip();
        }
        if self.at(0) == '#' {
            while not self.breakz(0) {
                self.skip();
            }
        }
        if not self.breakz(0) {
            return self.fail("did not find expected comment or line break after a directive");
        }
    }

    fn fetch_document_indicator(self: *mut Scanner, kind: TokenKind) YamlError!void {
        self.unroll(-1)!;
        self.remove_key()!;
        self.allowed = false;
        let start = self.m;
        self.skip();
        self.skip();
        self.skip();
        if kind == TokenKind.DOCUMENT_END {
            // nothing but a comment may follow ... on its line
            let mut k: usize = 0;
            while is_blank(self.at(k)) {
                k += 1;
            }
            if not self.breakz(k) and (self.at(k) != '#') {
                return self.fail("found content after a document end marker");
            }
        }
        self.push(self.token(kind, start))!;
    }

    fn fetch_flow_start(self: *mut Scanner, kind: TokenKind, mapping: bool) YamlError!void {
        self.save_key()!;
        self.flow_in(mapping)!;
        self.allowed = true;
        let start = self.m;
        self.skip();
        self.push(self.token(kind, start))!;
    }

    fn fetch_flow_end(self: *mut Scanner, kind: TokenKind) YamlError!void {
        self.remove_key()!;
        self.flow_out();
        self.allowed = false;
        let start = self.m;
        self.skip();
        self.push(self.token(kind, start))!;
    }

    fn fetch_flow_entry(self: *mut Scanner) YamlError!void {
        self.remove_key()!;
        self.allowed = true;
        let start = self.m;
        self.skip();
        self.push(self.token(TokenKind.FLOW_ENTRY, start))!;
    }

    fn fetch_block_entry(self: *mut Scanner) YamlError!void {
        if self.flow == 0 {
            if not self.allowed {
                return self.fail("block sequence entries are not allowed in this context");
            }
            self.roll(@bit_cast(i32, self.m.column), 0, true, TokenKind.BLOCK_SEQUENCE_START, self.m)!;
        }
        self.remove_key()!;
        self.allowed = true;
        let start = self.m;
        self.skip();
        self.push(self.token(TokenKind.BLOCK_ENTRY, start))!;
    }

    fn fetch_key(self: *mut Scanner) YamlError!void {
        if self.flow == 0 {
            if not self.allowed {
                return self.fail("mapping keys are not allowed in this context");
            }
            self.roll(@bit_cast(i32, self.m.column), 0, true, TokenKind.BLOCK_MAPPING_START, self.m)!;
        }
        self.remove_key()!;
        self.allowed = self.flow == 0;
        let start = self.m;
        self.skip();
        self.push(self.token(TokenKind.KEY, start))!;
    }

    fn fetch_value(self: *mut Scanner) YamlError!void {
        let k = self.keys.get(self.keys.len() - 1);
        if k.possible {
            // the simple key becomes a KEY token (and maybe opens a mapping)
            let t = Token.{ kind: TokenKind.KEY, start: k.mark, end: k.mark, value: "", handle: "", style: Style.NONE };
            self.tokens.insert(self.head + (k.token_number - self.parsed), t)!;
            self.roll(@bit_cast(i32, k.mark.column), k.token_number, false, TokenKind.BLOCK_MAPPING_START, k.mark)!;
            self.keys.get_ptr(self.keys.len() - 1).possible = false;
            self.allowed = false;
        } else {
            if self.flow == 0 {
                if not self.allowed {
                    return self.fail("mapping values are not allowed in this context");
                }
                self.roll(@bit_cast(i32, self.m.column), 0, true, TokenKind.BLOCK_MAPPING_START, self.m)!;
            }
            self.allowed = self.flow == 0;
        }
        let start = self.m;
        self.skip();
        self.push(self.token(TokenKind.VALUE, start))!;
    }

    fn fetch_anchor(self: *mut Scanner, kind: TokenKind) YamlError!void {
        self.save_key()!;
        self.allowed = false;
        let start = self.m;
        self.skip();
        let ns = self.m.index;
        while not self.blankz(0) and not is_flow_indicator(self.at(0)) {
            self.skip();
        }
        if self.m.index == ns {
            return self.fail("did not find expected alphabetic or numeric character after & or *");
        }
        let mut t = self.token(kind, start);
        t.value = self.s[ns..self.m.index];
        self.push(t)!;
    }

    fn fetch_tag(self: *mut Scanner) YamlError!void {
        self.save_key()!;
        self.allowed = false;
        let start = self.m;
        let mut handle: []u8 = "";
        self.buf.clear();
        if self.at(1) == '<' {
            // !<verbatim>
            self.skip();
            self.skip();
            self.tag_uri(false)!;
            if self.at(0) != '>' {
                return self.fail("did not find the expected '>'");
            }
            self.skip();
            if self.buf.len() == 0 {
                return self.fail("empty verbatim tag");
            }
        } else {
            // !, !suffix, !!suffix or !handle!suffix
            let hs = self.m.index;
            self.skip();
            while is_word(self.at(0)) {
                self.skip();
            }
            if self.at(0) == '!' {
                self.skip();
                handle = self.s[hs..self.m.index];
                self.tag_uri(true)!;
            } else {
                // "!word...": the primary handle, with the word as the suffix's start
                handle = "!";
                self.m = Mark.{ index: hs + 1, line: start.line, column: start.column + 1 };
                self.tag_uri(true)!;
                if self.buf.len() == 0 {
                    handle = "";  // the non-specific tag "!"
                    self.buf.push('!')!;
                }
            }
        }
        if not self.blankz(0) and not ((self.flow > 0) and is_flow_indicator(self.at(0))) {
            return self.fail("did not find expected whitespace or line break after a tag");
        }
        let mut t = self.token(TokenKind.TAG, start);
        t.handle = handle;
        t.value = self.ar.dup(self.buf.bytes())!;
        self.push(t)!;
    }

    // Tag URI characters into buf (%XX decoded).
    fn tag_uri(self: *mut Scanner, allow_empty: bool) YamlError!void {
        loop {
            let c = self.at(0);
            if self.eof() {
                break;
            }
            let ok = is_word(c) or ((strs.index_of_byte(";/?:@&=+$.!~*'()%#", c) ?? 99) != 99) or
                     (not allow_empty and ((c == ',') or (c == '[') or (c == ']')));
            if not ok {
                break;
            }
            if c == '%' {
                let h = hexv(self.at(1));
                let l = hexv(self.at(2));
                if (h > 15) or (l > 15) {
                    return self.fail("bad URI escape in a tag");
                }
                self.buf.push(@truncate(u8, (h << 4) | l))!;
                self.skip();
                self.skip();
                self.skip();
                continue;
            }
            self.copy(&mut self.buf)!;
        }
        if (self.buf.len() == 0) and not allow_empty {
            return self.fail("did not find expected tag URI");
        }
    }
}
