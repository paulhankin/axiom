// =============================================================================
// std/os/window.ax - a window on the desktop and its events (keys, mouse,
// size, close), on Windows (std/os/win32) and macOS (std/os/cocoa), chosen
// when the program runs; for drawing into with std/graphics/gpu.
//
//     let mut w = window.Window.open("Demo", 800, 600)!;
//     defer w.deinit();
//     let size = w.size();                                  // pixels
//     let mut g = gpu.Device.init_window(w.handle(), size[0], size[1])!;
//     loop {
//         let e = w.next_event();
//         if e.kind == window.EventKind.CLOSE { break; }
//         if e.kind == window.EventKind.NONE { /* draw a frame */ }
//     }
//
// Key codes are Windows' virtual-key codes on both systems (KEY_*, and
// 'A'..'Z', '0'..'9'). open's size is the content area's in points: macOS's,
// or on Windows 96-DPI pixels (the process is made DPI aware, so nothing is
// stretched); size(), RESIZE events and mouse positions are the screen's
// pixels, scale() of them to a point. A window belongs to the thread that
// opened it (on macOS, the main thread), which must also read its events.
// =============================================================================

import "cocoa.ax" as cocoa;
import "win32.ax" as win32;

error { Unsupported, Failed }

import host "axiom" {
    fn ax_os() i32;
}

/// What happened (EventKind.NONE: nothing is waiting; draw a frame).
pub enum EventKind: u8 {
    NONE,
    CLOSE,     // the user asked to close the window
    RESIZE,    // the content area is now width × height pixels
    KEY_DOWN,  // key: a virtual-key code (KEY_*, or 'A'..'Z', '0'..'9')
    KEY_UP,
    MOUSE_MOVE,  // x, y: in the content area, in pixels
    MOUSE_DOWN,  // button: 0 left, 1 right, 2 middle
    MOUSE_UP,
    MOUSE_WHEEL,  // delta: + away from the user, 120 per notch
    MENU,  // key: the id of the menu item chosen (add_item)
}

pub struct Event {
    kind: EventKind,
    key: u32,
    x: i32,
    y: i32,
    button: u32,
    delta: i32,
    width: u32,
    height: u32,
}

pub const KEY_BACKSPACE: u32 = 0x08;
pub const KEY_TAB: u32 = 0x09;
pub const KEY_ENTER: u32 = 0x0d;
pub const KEY_SHIFT: u32 = 0x10;
pub const KEY_CONTROL: u32 = 0x11;
pub const KEY_ALT: u32 = 0x12;
pub const KEY_ESCAPE: u32 = 0x1b;
pub const KEY_SPACE: u32 = 0x20;
pub const KEY_LEFT: u32 = 0x25;
pub const KEY_UP: u32 = 0x26;
pub const KEY_RIGHT: u32 = 0x27;
pub const KEY_DOWN: u32 = 0x28;
pub const KEY_F1: u32 = 0x70;

/// The menu named after the app on macOS (holding Quit), for add_item: what
/// is added there goes before Quit. Windows has none: add_item fails.
pub const APP_MENU: u32 = 0;

fn mac() bool {
    return ax_os() == 2;
}

pub struct Window {
    w: win32.Window,
    c: cocoa.Window,

    /// Opens a window whose content area is width × height (pixels on
    /// Windows, points on macOS).
    pub fn open(title: []u8, width: u32, height: u32) !Window {
        let mut win = Window.{
            w: win32.Window.{ hwnd: 0 }, c: cocoa.Window.{ win: 0, view: 0, delegate: 0, buttons: 0, mods: 0 } };
        if mac() {
            win.c = cocoa.Window.open(title, width, height) catch return error.Failed;
        } else {
            win.w = win32.Window.open(title, width, height) catch return error.Failed;
        }
        return win;
    }

    pub fn deinit(self: *mut Window) void {
        if mac() {
            self.c.deinit();
        } else {
            self.w.deinit();
        }
    }

    /// What std/graphics/gpu draws into: the HWND, or the content NSView.
    pub fn handle(self: *Window) usize {
        if mac() {
            return self.c.handle();
        }
        return self.w.handle();
    }

    /// The content area's size in pixels: width, height.
    pub fn size(self: *Window) [2]u32 {
        if mac() {
            return self.c.size();
        }
        return self.w.size();
    }

    /// Pixels per point: 2 on a Retina screen, the DPI / 96 on Windows
    /// (1.5 at 150% scaling). It changes when the window moves to a screen
    /// of another density.
    pub fn scale(self: *Window) f64 {
        if mac() {
            return self.c.scale();
        }
        return self.w.scale();
    }

    /// Adds a menu called `title` to the menu bar (on macOS the screen's,
    /// after the app's own menu; on Windows the window's, which makes its
    /// content area shorter: a RESIZE): its number, for add_item.
    pub fn add_menu(self: *Window, title: []u8) !u32 {
        if mac() {
            return cocoa.add_menu(title);
        }
        return self.w.add_menu(title);
    }

    /// Adds an item `title` to `menu` (add_menu's number, or APP_MENU),
    /// which, chosen, comes from next_event as a MENU event with key `id`;
    /// `key` is its shortcut with Command (macOS) or Ctrl (Windows): "o",
    /// ","; "" for none.
    pub fn add_item(self: *Window, menu: u32, title: []u8, id: u32, key: []u8) !void {
        if mac() {
            return cocoa.add_item(menu, title, id, key);
        }
        return self.w.add_item(menu, title, id, key);
    }

    /// A line between items of `menu`.
    pub fn add_separator(self: *Window, menu: u32) !void {
        if mac() {
            return cocoa.add_separator(menu);
        }
        return self.w.add_separator(menu);
    }

    /// Asks for a file to open, in the system's standard dialog titled
    /// `title`, of the types `exts` (extensions: "mat"; none, any): its
    /// path, empty if none was chosen. The caller frees it.
    pub fn open_file(self: *Window, title: []u8, exts: [][]u8) ![]mut u8 {
        if mac() {
            return cocoa.open_file(title, exts);
        }
        return self.w.open_file(title, exts);
    }

    pub fn set_title(self: *Window, title: []u8) void {
        if mac() {
            self.c.set_title(title);
        } else {
            self.w.set_title(title);
        }
    }

    /// The next event, without waiting (EventKind.NONE when none is left).
    pub fn next_event(self: *mut Window) Event {
        if mac() {
            let e = self.c.next_event();
            return Event.{ kind: @enum_from_int(EventKind, @int_from_enum(e.kind)), key: e.key, x: e.x, y: e.y,
                           button: e.button, delta: e.delta, width: e.width, height: e.height };
        }
        let e = self.w.next_event();
        return Event.{ kind: @enum_from_int(EventKind, @int_from_enum(e.kind)), key: e.key, x: e.x, y: e.y,
                       button: e.button, delta: e.delta, width: e.width, height: e.height };
    }
}
