// =============================================================================
// std/os/gamepad.ax - game controllers on Windows (std/os/xinput) and macOS
// (std/os/gamecontroller), chosen when the program runs: up to four pads'
// buttons, triggers and sticks, rumble, battery.
//
//     let p = gamepad.state(0);                 // pad 0
//     if p.connected and p.down(gamepad.A) { jump(); }
//     move(p.left_x, p.left_y);                 // -1..1, the dead zone removed
//     _ = gamepad.vibrate(0, 0.5, 0.0);
//
// Buttons are named by their places on an Xbox controller.
// =============================================================================

import "gamecontroller.ax" as gc;
import "xinput.ax" as xinput;

import host "axiom" {
    fn ax_os() i32;
}

pub const MAX_PADS: u32 = 4;

pub const DPAD_UP: u16 = 0x0001;
pub const DPAD_DOWN: u16 = 0x0002;
pub const DPAD_LEFT: u16 = 0x0004;
pub const DPAD_RIGHT: u16 = 0x0008;
pub const START: u16 = 0x0010;
pub const BACK: u16 = 0x0020;
pub const LEFT_THUMB: u16 = 0x0040;
pub const RIGHT_THUMB: u16 = 0x0080;
pub const LEFT_SHOULDER: u16 = 0x0100;
pub const RIGHT_SHOULDER: u16 = 0x0200;
pub const A: u16 = 0x1000;
pub const B: u16 = 0x2000;
pub const X: u16 = 0x4000;
pub const Y: u16 = 0x8000;

fn mac() bool {
    return ax_os() == 2;
}

pub struct Pad {
    connected: bool,
    packet: u32,  // changes whenever the state does
    buttons: u16,
    left_trigger: f32,  // 0..1
    right_trigger: f32,
    left_x: f32,  // -1..1 (right, up positive)
    left_y: f32,
    right_x: f32,
    right_y: f32,

    /// Is a button (or all of several) held?
    pub fn down(self: Pad, b: u16) bool {
        return (self.buttons & b) == b;
    }
}

/// Pad `index` (0..3) now.
pub fn state(index: u32) Pad {
    if mac() {
        let p = gc.state(index);
        return Pad.{ connected: p.connected, packet: p.packet, buttons: p.buttons, left_trigger: p.left_trigger,
                     right_trigger: p.right_trigger, left_x: p.left_x, left_y: p.left_y, right_x: p.right_x,
                     right_y: p.right_y };
    }
    let p = xinput.state(index);
    return Pad.{ connected: p.connected, packet: p.packet, buttons: p.buttons, left_trigger: p.left_trigger,
                 right_trigger: p.right_trigger, left_x: p.left_x, left_y: p.left_y, right_x: p.right_x,
                 right_y: p.right_y };
}

/// Sets pad `index`'s rumble: the left (low-frequency) and right
/// (high-frequency) motors, 0..1; false if the pad is not there or cannot.
pub fn vibrate(index: u32, left: f32, right: f32) bool {
    if mac() {
        return gc.vibrate(index, left, right);
    }
    return xinput.vibrate(index, left, right);
}

pub enum BatteryKind: u8 {
    DISCONNECTED,
    WIRED,
    ALKALINE,
    NIMH,
    UNKNOWN,
}

pub struct Battery {
    kind: BatteryKind,
    level: u8,  // 0 empty, 1 low, 2 medium, 3 full
}

pub fn battery(index: u32) Battery {
    if mac() {
        let b = gc.battery(index);
        return Battery.{ kind: @enum_from_int(BatteryKind, @int_from_enum(b.kind)), level: b.level };
    }
    let b = xinput.battery(index);
    return Battery.{ kind: @enum_from_int(BatteryKind, @int_from_enum(b.kind)), level: b.level };
}

/// Buttons pressed and released between updates, for all pads.
pub struct Tracker {
    prev: [4]u16,
    now: [4]u16,

    pub fn init() Tracker {
        return Tracker.{ prev: [0; 4], now: [0; 4] };
    }

    /// Reads every pad; returns them.
    pub fn update(self: *mut Tracker) [4]Pad {
        let mut pads: [4]Pad = [state(0), state(1), state(2), state(3)];
        for i in @as(usize, 0)..4 {
            self.prev[i] = self.now[i];
            self.now[i] = pads[i].buttons;
        }
        return pads;
    }

    /// Went down since the last update?
    pub fn pressed(self: *Tracker, pad: u32, b: u16) bool {
        let i = @as(usize, pad);
        return ((self.now[i] & b) != 0) and ((self.prev[i] & b) == 0);
    }

    pub fn released(self: *Tracker, pad: u32, b: u16) bool {
        let i = @as(usize, pad);
        return ((self.now[i] & b) == 0) and ((self.prev[i] & b) != 0);
    }
}
