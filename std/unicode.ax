// =============================================================================
// std/unicode.ax - Unicode: character properties, case mapping and folding,
// normalization, text segmentation (UAX #29), display width, UTF-16.
//
//     unicode.category(cp) == unicode.Category.LU  // an uppercase letter
//     let up = unicode.upper("straße")!;           // "STRASSE"; mem.free it
//     unicode.equal_fold("Straße", "STRASSE")      // true
//     let n = unicode.nfc(bytes)!;                 // composed form; mem.free it
//     let mut g = unicode.graphemes("e\u{301}🇫🇷");  // "é", "🇫🇷"
//     let w = unicode.string_width("日本語");       // 6 terminal columns
//
// The data is Unicode 15.1 (std/unicode/tables, generated by
// tools/gen_unicode.py). Text is UTF-8; invalid bytes read as U+FFFD.
// Functions returning new text return memory to free with mem.free.
// =============================================================================

import "collections/vec.ax" as vec;
import "mem.ax" as mem;
import "str.ax" as strs;
import "unicode/tables.ax" as t;

error { OutOfMemory, Done }

pub let VERSION: []u8 = "15.1.0";

// -----------------------------------------------------------------------------
// Properties
// -----------------------------------------------------------------------------

/// General categories (as category() returns them). The values are the
/// std/unicode/tables codes (t.GC_*).
pub enum Category: u32 {
    CN,
    LU,
    LL,
    LT,
    LM,
    LO,
    MN,
    MC,
    ME,
    ND,
    NL,
    NO,
    PC,
    PD,
    PS,
    PE,
    PI,
    PF,
    PO,
    SM,
    SC,
    SK,
    SO,
    ZS,
    ZL,
    ZP,
    CC,
    CF,
    CS,
    CO,

    /// The two-letter name ("Lu", "Nd", ...).
    pub fn name(self: Category) []u8 {
        return t.GC_NAMES[@as(usize, @int_from_enum(self))];
    }
}

/// East Asian widths (east_asian_width).
pub enum EastAsianWidth: u32 {
    N,
    A,
    H,
    W,
    F,
    NA,
}

/// The property record of a code point.
fn rec(cp: u32) u64 {
    if cp < t.LOW_LIMIT {
        return t.RECORDS[@as(usize, t.LOW[@as(usize, cp)])];
    }
    let c = @min(cp, 0x10FFFF);
    let runs = t.RUN_START[..];
    let mut lo: usize = 0;
    let mut hi = runs.len;
    while (hi - lo) > 1 {
        let mid = (lo + hi) / 2;
        if runs[mid] <= c {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    return t.RECORDS[@as(usize, t.RUN_RECORD[lo])];
}

fn field(r: u64, off: u32, bits: u32) u32 {
    return @truncate(u32, (r >> @as(u64, off)) & ((@as(u64, 1) << @as(u64, bits)) - 1));
}

fn flag(cp: u32, off: u32) bool {
    return field(rec(cp), off, 1) == 1;
}

/// The general category.
pub fn category(cp: u32) Category {
    return @enum_from_int(Category, category_code(cp));
}

/// The general category as its std/unicode/tables code (t.GC_*), for
/// table-driven code that indexes or ranges over categories.
pub fn category_code(cp: u32) u32 {
    return field(rec(cp), t.F_GC, t.W_GC);
}

/// The two-letter name of a category ("Lu", "Nd", ...).
pub fn category_name(gc: Category) []u8 {
    return gc.name();
}

pub fn is_letter(cp: u32) bool {
    let c = category_code(cp);
    return (c >= t.GC_LU) and (c <= t.GC_LO);
}

pub fn is_mark(cp: u32) bool {
    let c = category_code(cp);
    return (c >= t.GC_MN) and (c <= t.GC_ME);
}

/// A decimal digit (category Nd) in any script.
pub fn is_digit(cp: u32) bool {
    return category_code(cp) == t.GC_ND;
}

pub fn is_number(cp: u32) bool {
    let c = category_code(cp);
    return (c >= t.GC_ND) and (c <= t.GC_NO);
}

pub fn is_punct(cp: u32) bool {
    let c = category_code(cp);
    return (c >= t.GC_PC) and (c <= t.GC_PO);
}

pub fn is_symbol(cp: u32) bool {
    let c = category_code(cp);
    return (c >= t.GC_SM) and (c <= t.GC_SO);
}

pub fn is_control(cp: u32) bool {
    return category_code(cp) == t.GC_CC;
}

/// The White_Space property.
pub fn is_space(cp: u32) bool {
    return flag(cp, t.F_WHITE);
}

/// The Alphabetic property.
pub fn is_alphabetic(cp: u32) bool {
    return flag(cp, t.F_ALPHA);
}

/// The Uppercase property.
pub fn is_upper(cp: u32) bool {
    return flag(cp, t.F_UPPER);
}

/// The Lowercase property.
pub fn is_lower(cp: u32) bool {
    return flag(cp, t.F_LOWER);
}

/// Letters, marks, numbers, punctuation, symbols and spaces (not controls,
/// formats, surrogates, private use or unassigned).
pub fn is_graphic(cp: u32) bool {
    let c = category_code(cp);
    return (c >= t.GC_LU) and (c <= t.GC_ZS);
}

/// Whether cp may start an identifier (ID_Start) or continue one
/// (ID_Continue), per UAX #31.
pub fn is_id_start(cp: u32) bool {
    return flag(cp, t.F_ID_START);
}

pub fn is_id_continue(cp: u32) bool {
    return flag(cp, t.F_ID_CONTINUE);
}

/// The canonical combining class (0 for starters).
pub fn combining_class(cp: u32) u32 {
    return field(rec(cp), t.F_CCC, t.W_CCC);
}

/// The East Asian Width property.
pub fn east_asian_width(cp: u32) EastAsianWidth {
    return @enum_from_int(EastAsianWidth, field(rec(cp), t.F_EA, t.W_EA));
}

/// The Bidi_Class property (see std/unicode/tables: BIDI_*).
pub fn bidi_class(cp: u32) u32 {
    return field(rec(cp), t.F_BIDI, t.W_BIDI);
}

/// The Line_Break property (tables: LB_*), for line breaking (UAX #14).
pub fn line_break_class(cp: u32) u32 {
    return field(rec(cp), t.F_LB, t.W_LB);
}

pub fn is_bidi_mirrored(cp: u32) bool {
    return flag(cp, t.F_MIRRORED);
}

/// The character whose glyph is cp's mirror image (cp itself if none).
pub fn mirror(cp: u32) u32 {
    let i = find_u32(t.MIRROR_FROM[..], cp);
    if i < 0 {
        return cp;
    }
    return t.MIRROR_TO[@truncate(usize, @bit_cast(u64, i))];
}

pub fn is_emoji_presentation(cp: u32) bool {
    return flag(cp, t.F_EMOJI_PRES);
}

pub fn is_extended_pictographic(cp: u32) bool {
    return flag(cp, t.F_EXT_PICT);
}

/// The index of v in a sorted array, or -1.
fn find_u32(a: []u32, v: u32) i64 {
    let mut lo: usize = 0;
    let mut hi = a.len;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if a[mid] < v {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if (lo < a.len) and (a[lo] == v) {
        return @as(i64, @truncate(u32, lo));
    }
    return -1;
}

// -----------------------------------------------------------------------------
// Width
// -----------------------------------------------------------------------------

/// The columns a code point takes in a terminal: 0 for combining and
/// invisible characters, 2 for wide (East Asian wide and full-width,
/// emoji), -1 for control characters, else 1.
pub fn width(cp: u32) i32 {
    if cp == 0 {
        return 0;
    }
    if (cp < 0x20) or ((cp >= 0x7f) and (cp < 0xa0)) {
        return -1;
    }
    if cp < 0x300 {
        if cp == 0xad {
            return 1;  // soft hyphen: shown where it breaks
        }
        return 1;
    }
    let r = rec(cp);
    let gc = field(r, t.F_GC, t.W_GC);
    if (gc == t.GC_MN) or (gc == t.GC_ME) or (gc == t.GC_CF) or (field(r, t.F_IGNORABLE, 1) == 1) {
        return 0;
    }
    if ((cp >= 0x1160) and (cp <= 0x11ff)) or ((cp >= 0xd7b0) and (cp <= 0xd7ff)) {
        return 0;  // Hangul medial vowels and final consonants join the syllable
    }
    let ea = field(r, t.F_EA, t.W_EA);
    if (ea == t.EA_W) or (ea == t.EA_F) or (field(r, t.F_EMOJI_PRES, 1) == 1) {
        return 2;
    }
    return 1;
}

/// The columns text takes in a terminal: each grapheme cluster as wide as
/// its first character (emoji sequences and characters followed by the
/// emoji variation selector U+FE0F are 2); control characters count 0.
pub fn string_width(s: []u8) usize {
    let mut total: usize = 0;
    let mut g = graphemes(s);
    loop {
        let cl = g.next() catch break;
        let first = strs.decode_rune(cl);
        let mut w = width(first.value);
        if w < 0 {
            w = 0;
        }
        if (w == 1) and (cl.len > first.len) and is_extended_pictographic(first.value) {
            // emoji presentation asked for, or an emoji sequence
            let mut i = first.len;
            while i < cl.len {
                let r = strs.decode_rune(cl[i..]);
                if (r.value == 0xfe0f) or (r.value == 0x200d) {
                    w = 2;
                }
                i += r.len;
            }
        }
        if (w == 1) and (cl.len > first.len) and (grapheme_break(first.value) == t.GB_REGIONAL_INDICATOR) {
            w = 2;  // a flag
        }
        total += @as(usize, @bit_cast(u32, w));
    }
    return total;
}

// -----------------------------------------------------------------------------
// Case
// -----------------------------------------------------------------------------

fn pair_lookup(from: []u32, to: []u32, cp: u32) u32 {
    let i = find_u32(from, cp);
    if i < 0 {
        return cp;
    }
    return to[@truncate(usize, @bit_cast(u64, i))];
}

/// Simple (one code point) case mappings.
pub fn to_upper(cp: u32) u32 {
    if cp < 0x80 {
        if (cp >= 'a') and (cp <= 'z') {
            return cp - 32;
        }
        return cp;
    }
    return pair_lookup(t.UPPER_FROM[..], t.UPPER_TO[..], cp);
}

pub fn to_lower(cp: u32) u32 {
    if cp < 0x80 {
        if (cp >= 'A') and (cp <= 'Z') {
            return cp + 32;
        }
        return cp;
    }
    return pair_lookup(t.LOWER_FROM[..], t.LOWER_TO[..], cp);
}

pub fn to_title(cp: u32) u32 {
    let i = find_u32(t.TITLE_FROM[..], cp);
    if i >= 0 {
        return t.TITLE_TO[@truncate(usize, @bit_cast(u64, i))];
    }
    return to_upper(cp);
}

/// Simple case folding (for comparisons of single code points).
pub fn fold(cp: u32) u32 {
    if cp < 0x80 {
        return to_lower(cp);
    }
    return pair_lookup(t.FOLD_FROM[..], t.FOLD_TO[..], cp);
}

/// A full mapping from a sequence table, or none (empty).
fn seq_lookup(keys: []u32, seqs: []u32, pool: []u32, cp: u32) []u32 {
    let i = find_u32(keys, cp);
    if i < 0 {
        return pool[..0];
    }
    let v = seqs[@truncate(usize, @bit_cast(u64, i))];
    let off = @as(usize, v >> 8);
    return pool[off..off + @as(usize, v & 255)];
}

fn push_cp(out: *mut strs.String, cp: u32) !void {
    let mut b: [4]u8 = [0; 4];
    out.push_str(strs.encode_rune(b[..], cp))!;
}

enum CaseMode: u8 {
    UPPER,
    LOWER,
    FOLD,
    TITLE,
}

/// Appends the full mapping of cp in a mode.
fn map_full(out: *mut strs.String, cp: u32, mode: CaseMode) !void {
    if cp < 0x80 {
        let mut c = cp;
        if (mode == CaseMode.UPPER) or (mode == CaseMode.TITLE) {
            c = to_upper(cp);
        } else {
            c = to_lower(cp);
        }
        out.push(@truncate(u8, c))!;
        return;
    }
    let mut seq: []u32 = t.SPECIAL_UPPER_POOL[..0];
    if mode == CaseMode.UPPER {
        seq = seq_lookup(t.SPECIAL_UPPER_KEYS[..], t.SPECIAL_UPPER_SEQ[..], t.SPECIAL_UPPER_POOL[..], cp);
    } else if mode == CaseMode.LOWER {
        seq = seq_lookup(t.SPECIAL_LOWER_KEYS[..], t.SPECIAL_LOWER_SEQ[..], t.SPECIAL_LOWER_POOL[..], cp);
    } else if mode == CaseMode.TITLE {
        seq = seq_lookup(t.SPECIAL_TITLE_KEYS[..], t.SPECIAL_TITLE_SEQ[..], t.SPECIAL_TITLE_POOL[..], cp);
    } else {
        seq = seq_lookup(t.FULL_FOLD_KEYS[..], t.FULL_FOLD_SEQ[..], t.FULL_FOLD_POOL[..], cp);
    }
    if seq.len > 0 {
        for c in seq {
            push_cp(out, c)!;
        }
        return;
    }
    let mut c = cp;
    if mode == CaseMode.UPPER {
        c = to_upper(cp);
    } else if mode == CaseMode.LOWER {
        c = to_lower(cp);
    } else if mode == CaseMode.TITLE {
        c = to_title(cp);
    } else {
        c = fold(cp);
    }
    push_cp(out, c)!;
}

fn is_cased(cp: u32) bool {
    return flag(cp, t.F_CASED);
}

fn is_case_ignorable(cp: u32) bool {
    return flag(cp, t.F_CASE_IGNORABLE);
}

/// Whether the capital sigma at s[i] ends a word (Final_Sigma): a cased
/// letter before it and none after, skipping case-ignorable characters.
fn final_sigma(s: []u8, i: usize, len: usize) bool {
    let mut before = false;
    let mut k = i;
    while k > 0 {
        k = prev_start(s, k);
        let c = strs.decode_rune(s[k..]).value;
        if is_case_ignorable(c) {
            continue;
        }
        before = is_cased(c);
        break;
    }
    if not before {
        return false;
    }
    let mut j = i + len;
    while j < s.len {
        let r = strs.decode_rune(s[j..]);
        if not is_case_ignorable(r.value) {
            return not is_cased(r.value);
        }
        j += r.len;
    }
    return true;
}

fn map_string(s: []u8, mode: CaseMode) ![]mut u8 {
    let mut out = strs.String.init();
    map_into(s, mode, &mut out) catch |e| {
        out.deinit();
        return e;
    };
    return out.take();
}

fn map_into(s: []u8, mode: CaseMode, out: *mut strs.String) !void {
    out.reserve(s.len)!;
    let mut i: usize = 0;
    while i < s.len {
        let b = s[i];
        if b < 0x80 {
            // ASCII maps only between A-Z and a-z
            let mut c = b;
            let up = (mode == CaseMode.UPPER) or (mode == CaseMode.TITLE);
            if up and (b >= 'a') and (b <= 'z') {
                c = b - 32;
            } else if not up and (b >= 'A') and (b <= 'Z') {
                c = b + 32;
            }
            out.push(c)!;
            i += 1;
            continue;
        }
        let r = strs.decode_rune(s[i..]);
        if (mode == CaseMode.LOWER) and (r.value == 0x3a3) and final_sigma(s, i, r.len) {
            push_cp(out, 0x3c2)!;
        } else {
            map_full(out, r.value, mode)!;
        }
        i += r.len;
    }
}

/// Text in uppercase, with the full mappings ("ß" becomes "SS").
pub fn upper(s: []u8) ![]mut u8 {
    return map_string(s, CaseMode.UPPER);
}

/// Text in lowercase, with the full mappings and the final-sigma rule
/// ("ΟΔΟΣ" becomes "οδος").
pub fn lower(s: []u8) ![]mut u8 {
    return map_string(s, CaseMode.LOWER);
}

/// Full case folding, for caseless matching ("Straße" and "STRASSE" fold
/// alike).
pub fn case_fold(s: []u8) ![]mut u8 {
    return map_string(s, CaseMode.FOLD);
}

/// Title case: in each word (UAX #29), the first cased character in
/// titlecase and the rest in lowercase.
pub fn title(s: []u8) ![]mut u8 {
    let mut out = strs.String.init();
    title_into(s, &mut out) catch |e| {
        out.deinit();
        return e;
    };
    return out.take();
}

fn title_into(s: []u8, out: *mut strs.String) !void {
    let mut w = words(s);
    let mut base: usize = 0;
    loop {
        let word = w.next() catch break;
        let mut seen = false;
        let mut i: usize = 0;
        while i < word.len {
            let r = strs.decode_rune(word[i..]);
            if not seen and is_cased(r.value) {
                map_full(out, r.value, CaseMode.TITLE)!;
                seen = true;
            } else if (r.value == 0x3a3) and final_sigma(s, base + i, r.len) {
                push_cp(out, 0x3c2)!;
            } else {
                map_full(out, r.value, CaseMode.LOWER)!;
            }
            i += r.len;
        }
        base += word.len;
    }
}

/// Folds code points one at a time into a small buffer (for equal_fold).
struct Folder {
    s: []u8,
    i: usize,
    buf: [3]u32,
    n: usize,
    k: usize,

    fn next(self: *mut Folder) i64 {
        if self.k < self.n {
            let v = self.buf[self.k];
            self.k += 1;
            return @as(i64, v);
        }
        if self.i >= self.s.len {
            return -1;
        }
        let r = strs.decode_rune(self.s[self.i..]);
        self.i += r.len;
        let seq = seq_lookup(t.FULL_FOLD_KEYS[..], t.FULL_FOLD_SEQ[..], t.FULL_FOLD_POOL[..], r.value);
        if seq.len > 0 {
            for j in @as(usize, 0)..seq.len {
                self.buf[j] = seq[j];
            }
            self.n = seq.len;
            self.k = 1;
            return @as(i64, seq[0]);
        }
        self.n = 0;
        self.k = 0;
        return @as(i64, fold(r.value));
    }
}

/// Whether two texts are equal ignoring case (full case folding).
pub fn equal_fold(a: []u8, b: []u8) bool {
    let mut x = Folder.{ s: a, i: 0, buf: [0; 3], n: 0, k: 0 };
    let mut y = Folder.{ s: b, i: 0, buf: [0; 3], n: 0, k: 0 };
    loop {
        let p = x.next();
        let q = y.next();
        if p != q {
            return false;
        }
        if p < 0 {
            return true;
        }
    }
}

// -----------------------------------------------------------------------------
// Normalization
// -----------------------------------------------------------------------------

const S_BASE: u32 = 0xac00;
const L_BASE: u32 = 0x1100;
const V_BASE: u32 = 0x1161;
const T_BASE: u32 = 0x11a7;
const L_COUNT: u32 = 19;
const V_COUNT: u32 = 21;
const T_COUNT: u32 = 28;
const N_COUNT: u32 = 588;    // V_COUNT * T_COUNT
const S_COUNT: u32 = 11172;  // L_COUNT * N_COUNT

/// The normalization forms.
pub enum Form: u8 {
    NFC,
    NFD,
    NFKC,
    NFKD,
}

/// Appends the full decomposition of cp.
fn decompose_cp(cp: u32, compat: bool, out: *mut vec.Vec.[u32]) !void {
    if (cp >= S_BASE) and (cp < (S_BASE + S_COUNT)) {
        let s = cp - S_BASE;
        out.push(L_BASE + (s / N_COUNT))!;
        out.push(V_BASE + ((s % N_COUNT) / T_COUNT))!;
        if (s % T_COUNT) != 0 {
            out.push(T_BASE + (s % T_COUNT))!;
        }
        return;
    }
    if cp < 0xc0 {
        if not compat or (cp < 0xa0) {
            out.push(cp)!;
            return;
        }
    }
    let mut seq = seq_lookup(t.CANON_KEYS[..], t.CANON_SEQ[..], t.CANON_POOL[..], cp);
    if (seq.len == 0) and compat {
        seq = seq_lookup(t.COMPAT_KEYS[..], t.COMPAT_SEQ[..], t.COMPAT_POOL[..], cp);
    }
    if seq.len == 0 {
        out.push(cp)!;
        return;
    }
    for c in seq {
        decompose_cp(c, compat, out)!;
    }
}

/// Puts runs of non-starters in canonical order (stable by combining class).
fn reorder(cps: []mut u32) !void {
    let mut i: usize = 0;
    while i < cps.len {
        if combining_class(cps[i]) == 0 {
            i += 1;
            continue;
        }
        let start = i;
        while (i < cps.len) and (combining_class(cps[i]) != 0) {
            i += 1;
        }
        if (i - start) > 32 {
            // a long run (only hostile text has them): a stable counting sort
            let run = cps[start..i];
            let tmp = mem.alloc.[u32](run.len)!;
            defer mem.free(tmp);
            let mut at: [257]usize = [0; 257];
            for c in run {
                at[@as(usize, combining_class(c)) + 1] += 1;
            }
            for k in @as(usize, 1)..257 {
                at[k] += at[k - 1];
            }
            for c in run {
                let cc = @as(usize, combining_class(c));
                tmp[at[cc]] = c;
                at[cc] += 1;
            }
            @mem_copy(run, tmp);
            continue;
        }
        // insertion sort: runs are short
        for k in (start + 1)..i {
            let v = cps[k];
            let cv = combining_class(v);
            let mut j = k;
            while (j > start) and (combining_class(cps[j - 1]) > cv) {
                cps[j] = cps[j - 1];
                j -= 1;
            }
            cps[j] = v;
        }
    }
}

/// The primary composite of a and b, or 0.
fn compose_pair(a: u32, b: u32) u32 {
    // Hangul
    if (a >= L_BASE) and (a < (L_BASE + L_COUNT)) and (b >= V_BASE) and (b < (V_BASE + V_COUNT)) {
        return S_BASE + ((((a - L_BASE) * V_COUNT) + (b - V_BASE)) * T_COUNT);
    }
    if (a >= S_BASE) and (a < (S_BASE + S_COUNT)) and (((a - S_BASE) % T_COUNT) == 0) and (b > T_BASE) and
       (b < (T_BASE + T_COUNT)) {
        return a + (b - T_BASE);
    }
    let key = (@as(u64, a) << 21) | @as(u64, b);
    let keys = t.COMPOSE_KEY[..];
    let mut lo: usize = 0;
    let mut hi = keys.len;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if keys[mid] < key {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if (lo < keys.len) and (keys[lo] == key) {
        return t.COMPOSE_TO[lo];
    }
    return 0;
}

/// Appends the canonical decomposition (NFD) of the code points cps to out:
/// each fully decomposed, then non-starters put in canonical order. For
/// algorithms over code points (collation), where text may not be UTF-8.
pub fn decompose_into(cps: []u32, out: *mut vec.Vec.[u32]) !void {
    let start = out.len;
    for c in cps {
        decompose_cp(c, false, out)!;
    }
    reorder(out.items()[start..])!;
}

/// One step of canonical decomposition: cp's mapping as [a, b] (b = 0 for a
/// singleton), or [0, 0] when cp has none. Hangul LVT syllables split into
/// an LV syllable and a trailing consonant.
pub fn decompose_step(cp: u32) [2]u32 {
    if (cp >= S_BASE) and (cp < (S_BASE + S_COUNT)) {
        let s = cp - S_BASE;
        if (s % T_COUNT) != 0 {
            return [cp - (s % T_COUNT), T_BASE + (s % T_COUNT)];
        }
        return [L_BASE + (s / N_COUNT), V_BASE + ((s % N_COUNT) / T_COUNT)];
    }
    if cp < 0xc0 {
        return [0, 0];
    }
    let seq = seq_lookup(t.CANON_KEYS[..], t.CANON_SEQ[..], t.CANON_POOL[..], cp);
    if seq.len == 1 {
        return [seq[0], 0];
    }
    if seq.len == 2 {
        return [seq[0], seq[1]];
    }
    return [0, 0];
}

/// The primary composite of a followed by b, or 0 if there is none.
pub fn compose_step(a: u32, b: u32) u32 {
    return compose_pair(a, b);
}

/// Canonical composition, in place; returns the new length.
fn compose(cps: []mut u32) usize {
    if cps.len == 0 {
        return 0;
    }
    let mut starter: usize = 0;
    let mut have_starter = combining_class(cps[0]) == 0;
    let mut last_cc: i32 = -1;
    if not have_starter {
        last_cc = 256;
    }
    let mut out: usize = 1;
    for i in @as(usize, 1)..cps.len {
        let c = cps[i];
        let cc = @bit_cast(i32, combining_class(c));
        if have_starter {
            // blocked if a character between has a class >= this one's (or is a starter)
            let blocked = (last_cc != -1) and ((last_cc >= cc) or (last_cc == 0));
            if not blocked {
                let comp = compose_pair(cps[starter], c);
                if comp != 0 {
                    cps[starter] = comp;
                    continue;
                }
            }
        }
        if cc == 0 {
            starter = out;
            have_starter = true;
            last_cc = -1;
        } else {
            last_cc = cc;
        }
        cps[out] = c;
        out += 1;
    }
    return out;
}

/// Text in a normalization form (NFC, NFD, NFKC or NFKD).
pub fn normalize(s: []u8, form: Form) ![]mut u8 {
    let compat = (form == Form.NFKC) or (form == Form.NFKD);
    let composed = (form == Form.NFC) or (form == Form.NFKC);
    // ASCII is in every form
    let mut ascii = true;
    for b in s {
        if b >= 0x80 {
            ascii = false;
            break;
        }
    }
    if ascii {
        return mem.dup(s);
    }
    let mut cps = vec.Vec.[u32].init();
    defer cps.deinit();
    let mut i: usize = 0;
    while i < s.len {
        let r = strs.decode_rune(s[i..]);
        decompose_cp(r.value, compat, &mut cps)!;
        i += r.len;
    }
    let all = cps.items();
    reorder(all)!;
    let mut n = all.len;
    if composed {
        n = compose(all);
    }
    let mut out = strs.String.init();
    out.reserve(s.len + (s.len / 2)) catch |e| {
        out.deinit();
        return e;
    };
    for c in all[..n] {
        push_cp(&mut out, c) catch |e| {
            out.deinit();
            return e;
        };
    }
    return out.take();
}

pub fn nfc(s: []u8) ![]mut u8 {
    return normalize(s, Form.NFC);
}

pub fn nfd(s: []u8) ![]mut u8 {
    return normalize(s, Form.NFD);
}

pub fn nfkc(s: []u8) ![]mut u8 {
    return normalize(s, Form.NFKC);
}

pub fn nfkd(s: []u8) ![]mut u8 {
    return normalize(s, Form.NFKD);
}

/// Whether text is already in a normalization form.
pub fn is_normalized(s: []u8, form: Form) !bool {
    let n = normalize(s, form)!;
    defer mem.free(n);
    return @mem_eq(n, s);
}

// -----------------------------------------------------------------------------
// Segmentation (UAX #29)
// -----------------------------------------------------------------------------

/// The Grapheme_Cluster_Break, Word_Break and Sentence_Break properties
/// (tables: GB_*, WB_*, SB_*).
pub fn grapheme_break(cp: u32) u32 {
    return field(rec(cp), t.F_GB, t.W_GB);
}

pub fn word_break(cp: u32) u32 {
    return field(rec(cp), t.F_WB, t.W_WB);
}

pub fn sentence_break(cp: u32) u32 {
    return field(rec(cp), t.F_SB, t.W_SB);
}

/// Where the code point before position i starts.
fn prev_start(s: []u8, i: usize) usize {
    let mut k = i - 1;
    let mut n: usize = 0;
    while (k > 0) and ((s[k] & 0xc0) == 0x80) and (n < 3) {
        k -= 1;
        n += 1;
    }
    // accept the lead byte only if it really spans to i
    let r = strs.decode_rune(s[k..]);
    if (k + r.len) == i {
        return k;
    }
    return i - 1;
}

const INCB_LINKER: u32 = 1;
const INCB_CONSONANT: u32 = 2;
const INCB_EXTEND: u32 = 3;

/// Extended grapheme clusters of text, in order.
pub struct Graphemes {
    s: []u8,
    pos: usize,

    /// The next cluster, or error.Done.
    pub fn next(self: *mut Graphemes) ![]u8 {
        if self.pos >= self.s.len {
            return error.Done;
        }
        let start = self.pos;
        let s = self.s;
        // two ASCII characters always break, except CR LF (no ASCII
        // character extends or prepends)
        let b0 = s[start];
        if (b0 < 0x80) and
           (((start + 1) == s.len) or ((s[start + 1] < 0x80) and not ((b0 == '\r') and (s[start + 1] == '\n')))) {
            self.pos = start + 1;
            return s[start..start + 1];
        }
        let first = strs.decode_rune(s[start..]);
        let mut i = start + first.len;
        let mut prev = rec(first.value);
        let mut pgb = field(prev, t.F_GB, t.W_GB);
        // state for GB11 (emoji ZWJ sequences), GB12/13 (flags), GB9c (conjuncts)
        let mut emoji = field(prev, t.F_EXT_PICT, 1) == 1;  // ExtPict Extend*
        let mut emoji_zwj = false;  // ExtPict Extend* ZWJ
        let mut ri: u32 = 0;
        if pgb == t.GB_REGIONAL_INDICATOR {
            ri = 1;
        }
        let pincb = field(prev, t.F_INCB, t.W_INCB);
        let mut conj: u32 = 0;  // 1: after a consonant, 2: and a linker since
        if pincb == INCB_CONSONANT {
            conj = 1;
        }
        while i < s.len {
            let r = strs.decode_rune(s[i..]);
            let cur = rec(r.value);
            let gb = field(cur, t.F_GB, t.W_GB);
            let incb = field(cur, t.F_INCB, t.W_INCB);
            let ext_pict = field(cur, t.F_EXT_PICT, 1) == 1;
            if not grapheme_joins(pgb, gb, emoji_zwj and ext_pict, ri, (conj == 2) and (incb == INCB_CONSONANT)) {
                break;
            }
            // advance the state
            if emoji and (gb == t.GB_EXTEND) {
                // still ExtPict Extend*
            } else if emoji and (gb == t.GB_ZWJ) {
                emoji = false;
                emoji_zwj = true;
            } else {
                emoji_zwj = false;
                emoji = ext_pict;
            }
            if gb == t.GB_REGIONAL_INDICATOR {
                ri += 1;
            } else {
                ri = 0;
            }
            if incb == INCB_CONSONANT {
                conj = 1;
            } else if (conj > 0) and (incb == INCB_LINKER) {
                conj = 2;
            } else if (conj > 0) and (incb == INCB_EXTEND) {
                // unchanged
            } else {
                conj = 0;
            }
            pgb = gb;
            i += r.len;
        }
        self.pos = i;
        return s[start..i];
    }
}

/// Whether there is no break between characters of classes a and b.
fn grapheme_joins(a: u32, b: u32, gb11: bool, ri: u32, gb9c: bool) bool {
    if (a == t.GB_CR) and (b == t.GB_LF) {
        return true;
    }
    if (a == t.GB_CONTROL) or (a == t.GB_CR) or (a == t.GB_LF) {
        return false;
    }
    if (b == t.GB_CONTROL) or (b == t.GB_CR) or (b == t.GB_LF) {
        return false;
    }
    if (a == t.GB_L) and ((b == t.GB_L) or (b == t.GB_V) or (b == t.GB_LV) or (b == t.GB_LVT)) {
        return true;
    }
    if ((a == t.GB_LV) or (a == t.GB_V)) and ((b == t.GB_V) or (b == t.GB_T)) {
        return true;
    }
    if ((a == t.GB_LVT) or (a == t.GB_T)) and (b == t.GB_T) {
        return true;
    }
    if (b == t.GB_EXTEND) or (b == t.GB_ZWJ) or (b == t.GB_SPACINGMARK) {
        return true;
    }
    if a == t.GB_PREPEND {
        return true;
    }
    if gb9c or gb11 {
        return true;
    }
    if (a == t.GB_REGIONAL_INDICATOR) and (b == t.GB_REGIONAL_INDICATOR) and ((ri % 2) == 1) {
        return true;
    }
    return false;
}

pub fn graphemes(s: []u8) Graphemes {
    return Graphemes.{ s: s, pos: 0 };
}

/// How many grapheme clusters (user-perceived characters) text has.
pub fn grapheme_count(s: []u8) usize {
    let mut g = graphemes(s);
    let mut n: usize = 0;
    loop {
        _ = g.next() catch break;
        n += 1;
    }
    return n;
}

// Words ------------------------------------------------------------------------

fn wb_at(s: []u8, i: usize) u32 {
    return (word_break(strs.decode_rune(s[i..]).value));
}

fn wb_ignorable(w: u32) bool {
    return (w == t.WB_EXTEND) or (w == t.WB_FORMAT) or (w == t.WB_ZWJ);
}

fn ahletter(w: u32) bool {
    return (w == t.WB_ALETTER) or (w == t.WB_HEBREW_LETTER);
}

fn midnumletq(w: u32) bool {
    return (w == t.WB_MIDNUMLET) or (w == t.WB_SINGLE_QUOTE);
}

/// The word-break class of the character before position i, skipping
/// Extend, Format and ZWJ (WB4); its start in *at. 0xff at the start.
fn wb_before(s: []u8, i: usize, at: *mut usize) u32 {
    let mut k = i;
    while k > 0 {
        k = prev_start(s, k);
        let w = wb_at(s, k);
        if not wb_ignorable(w) {
            at.* = k;
            return w;
        }
        // an ignorable directly after a hard break stands alone
        if k > 0 {
            let p = prev_start(s, k);
            let pw = wb_at(s, p);
            if (pw == t.WB_CR) or (pw == t.WB_LF) or (pw == t.WB_NEWLINE) {
                at.* = k;
                return w;
            }
        } else {
            at.* = k;
            return w;
        }
    }
    at.* = 0;
    return 0xff;
}

/// The class of the first character at or after i that is not ignorable
/// (0xff at the end); the position after it in *after.
fn wb_after(s: []u8, i: usize, after: *mut usize) u32 {
    let mut k = i;
    while k < s.len {
        let r = strs.decode_rune(s[k..]);
        let w = (word_break(r.value));
        k += r.len;
        if not wb_ignorable(w) {
            after.* = k;
            return w;
        }
    }
    after.* = k;
    return 0xff;
}

/// Whether there is a word boundary at position i (0 < i < s.len).
fn word_boundary(s: []u8, i: usize, floor: usize) bool {
    let pstart = prev_start(s, i);
    let prev_cp = strs.decode_rune(s[pstart..]).value;
    let a_raw = (word_break(prev_cp));
    let next = strs.decode_rune(s[i..]);
    let b_raw = (word_break(next.value));
    // WB3-WB3d
    if (a_raw == t.WB_CR) and (b_raw == t.WB_LF) {
        return false;
    }
    if (a_raw == t.WB_CR) or (a_raw == t.WB_LF) or (a_raw == t.WB_NEWLINE) {
        return true;
    }
    if (b_raw == t.WB_CR) or (b_raw == t.WB_LF) or (b_raw == t.WB_NEWLINE) {
        return true;
    }
    if (a_raw == t.WB_ZWJ) and is_extended_pictographic(next.value) {
        return false;
    }
    if (a_raw == t.WB_WSEGSPACE) and (b_raw == t.WB_WSEGSPACE) {
        return false;
    }
    // WB4
    if wb_ignorable(b_raw) {
        return false;
    }
    let mut a_at: usize = 0;
    let a = wb_before(s, i, &mut a_at);
    let b = b_raw;
    let mut a2_at: usize = 0;
    let mut a2: u32 = 0xff;
    if a_at > 0 {
        a2 = wb_before(s, a_at, &mut a2_at);
    }
    let mut after_b: usize = 0;
    _ = wb_after(s, i, &mut after_b);
    let mut after_b2: usize = 0;
    let b2 = wb_after(s, after_b, &mut after_b2);
    if ahletter(a) and ahletter(b) {
        return false;  // WB5
    }
    if ahletter(a) and ((b == t.WB_MIDLETTER) or midnumletq(b)) and ahletter(b2) {
        return false;  // WB6
    }
    if ahletter(a2) and ((a == t.WB_MIDLETTER) or midnumletq(a)) and ahletter(b) {
        return false;  // WB7
    }
    if (a == t.WB_HEBREW_LETTER) and (b == t.WB_SINGLE_QUOTE) {
        return false;  // WB7a
    }
    if (a == t.WB_HEBREW_LETTER) and (b == t.WB_DOUBLE_QUOTE) and (b2 == t.WB_HEBREW_LETTER) {
        return false;  // WB7b
    }
    if (a2 == t.WB_HEBREW_LETTER) and (a == t.WB_DOUBLE_QUOTE) and (b == t.WB_HEBREW_LETTER) {
        return false;  // WB7c
    }
    if (a == t.WB_NUMERIC) and (b == t.WB_NUMERIC) {
        return false;  // WB8
    }
    if ahletter(a) and (b == t.WB_NUMERIC) {
        return false;  // WB9
    }
    if (a == t.WB_NUMERIC) and ahletter(b) {
        return false;  // WB10
    }
    if (a2 == t.WB_NUMERIC) and ((a == t.WB_MIDNUM) or midnumletq(a)) and (b == t.WB_NUMERIC) {
        return false;  // WB11
    }
    if (a == t.WB_NUMERIC) and ((b == t.WB_MIDNUM) or midnumletq(b)) and (b2 == t.WB_NUMERIC) {
        return false;  // WB12
    }
    if (a == t.WB_KATAKANA) and (b == t.WB_KATAKANA) {
        return false;  // WB13
    }
    if (ahletter(a) or (a == t.WB_NUMERIC) or (a == t.WB_KATAKANA) or (a == t.WB_EXTENDNUMLET)) and
       (b == t.WB_EXTENDNUMLET) {
        return false;  // WB13a
    }
    if (a == t.WB_EXTENDNUMLET) and (ahletter(b) or (b == t.WB_NUMERIC) or (b == t.WB_KATAKANA)) {
        return false;  // WB13b
    }
    if (a == t.WB_REGIONAL_INDICATOR) and (b == t.WB_REGIONAL_INDICATOR) {
        // WB15/16: an odd number of RI before (counted back to floor, the
        // start of the current segment: a boundary inside a run of RIs
        // only ever falls after a pair, so the parity is the same, and a
        // long run costs linear time, not quadratic)
        let mut n: usize = 0;
        let mut k = i;
        loop {
            if k <= floor {
                break;
            }
            let mut at: usize = 0;
            let w = wb_before(s, k, &mut at);
            if w != t.WB_REGIONAL_INDICATOR {
                break;
            }
            n += 1;
            k = at;
            if k == 0 {
                break;
            }
        }
        return (n % 2) == 0;
    }
    return true;  // WB999
}

/// Words and the text between them (spaces, punctuation), as UAX #29
/// splits text: concatenated, the pieces are the whole text.
pub struct Words {
    s: []u8,
    pos: usize,

    pub fn next(self: *mut Words) ![]u8 {
        if self.pos >= self.s.len {
            return error.Done;
        }
        let start = self.pos;
        let mut i = start + strs.decode_rune(self.s[start..]).len;
        while (i < self.s.len) and not word_boundary(self.s, i, start) {
            i += strs.decode_rune(self.s[i..]).len;
        }
        self.pos = i;
        return self.s[start..i];
    }
}

pub fn words(s: []u8) Words {
    return Words.{ s: s, pos: 0 };
}

/// Whether a piece from words() is a word (has a letter, digit or
/// ideograph) rather than spaces or punctuation.
pub fn is_word(piece: []u8) bool {
    let mut i: usize = 0;
    while i < piece.len {
        let r = strs.decode_rune(piece[i..]);
        let w = (word_break(r.value));
        if ahletter(w) or (w == t.WB_NUMERIC) or (w == t.WB_KATAKANA) or (w == t.WB_EXTENDNUMLET) or
           is_alphabetic(r.value) or is_number(r.value) {
            return true;
        }
        i += r.len;
    }
    return false;
}

// Sentences ------------------------------------------------------------------

fn sb_at(s: []u8, i: usize) u32 {
    return (sentence_break(strs.decode_rune(s[i..]).value));
}

fn sb_ignorable(v: u32) bool {
    return (v == t.SB_EXTEND) or (v == t.SB_FORMAT);
}

fn para_sep(v: u32) bool {
    return (v == t.SB_SEP) or (v == t.SB_CR) or (v == t.SB_LF);
}

fn saterm(v: u32) bool {
    return (v == t.SB_STERM) or (v == t.SB_ATERM);
}

/// The sentence-break class before i, skipping Extend and Format (SB5);
/// its start in *at; 0xff at the start.
fn sb_before(s: []u8, i: usize, at: *mut usize) u32 {
    let mut k = i;
    while k > 0 {
        k = prev_start(s, k);
        let v = sb_at(s, k);
        if not sb_ignorable(v) {
            at.* = k;
            return v;
        }
        if k > 0 {
            let p = prev_start(s, k);
            if para_sep(sb_at(s, p)) {
                at.* = k;
                return v;
            }
        } else {
            at.* = k;
            return v;
        }
    }
    at.* = 0;
    return 0xff;
}

/// What precedes a position, for SB8-SB11: SATerm Close* Sp* (term is
/// 0xff if the text before does not end so).
struct Suffix {
    term: u32,
    close_seen: bool,
    sp_seen: bool,
}

/// The suffix before i, scanning back (used once per sentence).
fn suffix_before(s: []u8, i: usize) Suffix {
    let mut k = i;
    let mut sp_seen = false;
    let mut close_seen = false;
    loop {
        let mut at: usize = 0;
        let v = sb_before(s, k, &mut at);
        if v == 0xff {
            break;
        }
        if (v == t.SB_SP) and not close_seen {
            sp_seen = true;
            k = at;
            continue;
        }
        if v == t.SB_CLOSE {
            close_seen = true;
            k = at;
            continue;
        }
        if saterm(v) {
            return Suffix.{ term: v, close_seen: close_seen, sp_seen: sp_seen };
        }
        break;
    }
    return Suffix.{ term: 0xff, close_seen: false, sp_seen: false };
}

/// The suffix after one more character of class v (as suffix_before would
/// find it, in constant time).
fn suffix_step(st: Suffix, v: u32) Suffix {
    if sb_ignorable(v) {
        return st;
    }
    if saterm(v) {
        return Suffix.{ term: v, close_seen: false, sp_seen: false };
    }
    if (st.term != 0xff) and (v == t.SB_CLOSE) and not st.sp_seen {
        return Suffix.{ term: st.term, close_seen: true, sp_seen: false };
    }
    if (st.term != 0xff) and (v == t.SB_SP) {
        return Suffix.{ term: st.term, close_seen: st.close_seen, sp_seen: true };
    }
    return Suffix.{ term: 0xff, close_seen: false, sp_seen: false };
}

/// SB8's look ahead from `from` stopped at `to` and found a Lower or not;
/// the answer holds for every position in between.
struct Sb8Cache {
    from: usize,
    to: usize,
    lower: bool,
    valid: bool,
}

fn sentence_boundary(s: []u8, i: usize, suf: Suffix, sb8: *mut Sb8Cache) bool {
    let pstart = prev_start(s, i);
    let a_raw = sb_at(s, pstart);
    let b = sb_at(s, i);
    if (a_raw == t.SB_CR) and (b == t.SB_LF) {
        return false;  // SB3
    }
    if para_sep(a_raw) {
        return true;  // SB4
    }
    if sb_ignorable(b) {
        return false;  // SB5
    }
    let mut a_at: usize = 0;
    let a = sb_before(s, i, &mut a_at);
    if (a == t.SB_ATERM) and (b == t.SB_NUMERIC) {
        return false;  // SB6
    }
    if a == t.SB_ATERM {
        let mut x: usize = 0;
        let a2 = sb_before(s, a_at, &mut x);
        if ((a2 == t.SB_UPPER) or (a2 == t.SB_LOWER)) and (b == t.SB_UPPER) {
            return false;  // SB7
        }
    }
    // SATerm Close* Sp* before i (kept up to date by the caller)
    let term = suf.term;
    let sp_seen = suf.sp_seen;
    if term == 0xff {
        return false;  // SB998
    }
    if term == t.SB_ATERM {
        // SB8: ( ¬(OLetter | Upper | Lower | ParaSep | SATerm) )* Lower
        if not (sb8.valid and (sb8.from <= i) and (i <= sb8.to)) {
            let mut j = i;
            let mut found = false;
            while j < s.len {
                let v = sb_at(s, j);
                if v == t.SB_LOWER {
                    found = true;
                    break;
                }
                if (v == t.SB_OLETTER) or (v == t.SB_UPPER) or para_sep(v) or saterm(v) {
                    break;
                }
                j += strs.decode_rune(s[j..]).len;
            }
            sb8.* = Sb8Cache.{ from: i, to: j, lower: found, valid: true };
        }
        if sb8.lower {
            return false;
        }
    }
    if (b == t.SB_SCONTINUE) or saterm(b) {
        return false;  // SB8a
    }
    if not sp_seen and ((b == t.SB_CLOSE) or (b == t.SB_SP) or para_sep(b)) {
        return false;  // SB9
    }
    if (b == t.SB_SP) or para_sep(b) {
        return false;  // SB10
    }
    return true;  // SB11
}

/// Sentences of text (with their trailing spaces), per UAX #29.
pub struct Sentences {
    s: []u8,
    pos: usize,

    pub fn next(self: *mut Sentences) ![]u8 {
        if self.pos >= self.s.len {
            return error.Done;
        }
        let start = self.pos;
        let first = strs.decode_rune(self.s[start..]).len;
        let mut i = start + first;
        // the SATerm Close* Sp* state, carried forward a character at a time
        let mut suf = suffix_before(self.s, i);
        let mut sb8 = Sb8Cache.{ from: 0, to: 0, lower: false, valid: false };
        while (i < self.s.len) and not sentence_boundary(self.s, i, suf, &mut sb8) {
            suf = suffix_step(suf, sb_at(self.s, i));
            i += strs.decode_rune(self.s[i..]).len;
        }
        self.pos = i;
        return self.s[start..i];
    }
}

pub fn sentences(s: []u8) Sentences {
    return Sentences.{ s: s, pos: 0 };
}

// -----------------------------------------------------------------------------
// UTF-16
// -----------------------------------------------------------------------------

/// Text as UTF-16 code units.
pub fn to_utf16(s: []u8) ![]mut u16 {
    let mut out = vec.Vec.[u16].init();
    let mut i: usize = 0;
    while i < s.len {
        let r = strs.decode_rune(s[i..]);
        i += r.len;
        if r.value >= 0x10000 {
            let v = r.value - 0x10000;
            out.push(@truncate(u16, 0xd800 + (v >> 10))) catch |e| {
                out.deinit();
                return e;
            };
            out.push(@truncate(u16, 0xdc00 + (v & 0x3ff))) catch |e| {
                out.deinit();
                return e;
            };
        } else {
            out.push(@truncate(u16, r.value)) catch |e| {
                out.deinit();
                return e;
            };
        }
    }
    let items = out.items();
    let copy = mem.dup(items[..]) catch |e| {
        out.deinit();
        return e;
    };
    out.deinit();
    return copy;
}

/// UTF-16 as UTF-8 text; unpaired surrogates become U+FFFD.
pub fn from_utf16(u: []u16) ![]mut u8 {
    let mut out = strs.String.init();
    let mut i: usize = 0;
    while i < u.len {
        let mut c = @as(u32, u[i]);
        i += 1;
        if (c >= 0xd800) and (c < 0xdc00) {
            if (i < u.len) and (u[i] >= 0xdc00) and (u[i] < 0xe000) {
                c = 0x10000 + ((c - 0xd800) << 10) + (@as(u32, u[i]) - 0xdc00);
                i += 1;
            } else {
                c = strs.REPLACEMENT;
            }
        } else if (c >= 0xdc00) and (c < 0xe000) {
            c = strs.REPLACEMENT;
        }
        push_cp(&mut out, c) catch |e| {
            out.deinit();
            return e;
        };
    }
    return out.take();
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

import "io.ax" as io;

fn read_optional(p: []u8) ![]mut u8 {
    let f = io.open(p)!;
    defer f.close();
    return f.reader().read_all();
}

enum Segmentation: u8 {
    GRAPHEME,
    WORD,
    SENTENCE,
}

/// Runs a UCD segmentation test file (lines like "÷ 0020 × 0308 ÷"):
/// returns [cases, failures], or [0, 0] if the file is missing.
fn run_seg_test(file: []u8, kind: Segmentation) ![2]usize {
    let data = read_optional(file) catch return [@as(usize, 0), 0];
    defer mem.free(data);
    let mut cases: usize = 0;
    let mut failures: usize = 0;
    let mut lines = strs.lines(data);
    loop {
        let raw = lines.next() catch break;
        let hash = strs.index_of(raw, "#") catch raw.len;
        let line = strs.trim(raw[..hash]);
        if line.len == 0 {
            continue;
        }
        // the text, and where the breaks should be
        let mut text = strs.String.init();
        defer text.deinit();
        let mut want = vec.Vec.[usize].init();
        defer want.deinit();
        let mut f = strs.fields(line);
        loop {
            let tok = f.next() catch break;
            if @mem_eq(tok, "\xc3\xb7") {
                want.push(text.len)!;
            } else if @mem_eq(tok, "\xc3\x97") {
                // no break
            } else {
                let cp = fmt_parse_hex(tok);
                push_cp(&mut text, cp)!;
            }
        }
        cases += 1;
        let s = text.bytes();
        let mut got = vec.Vec.[usize].init();
        defer got.deinit();
        got.push(0)!;
        if kind == Segmentation.GRAPHEME {
            let mut it = graphemes(s);
            let mut at: usize = 0;
            loop {
                let piece = it.next() catch break;
                at += piece.len;
                got.push(at)!;
            }
        } else if kind == Segmentation.WORD {
            let mut it = words(s);
            let mut at: usize = 0;
            loop {
                let piece = it.next() catch break;
                at += piece.len;
                got.push(at)!;
            }
        } else {
            let mut it = sentences(s);
            let mut at: usize = 0;
            loop {
                let piece = it.next() catch break;
                at += piece.len;
                got.push(at)!;
            }
        }
        let mut same = got.len == want.len;
        if same {
            for k in @as(usize, 0)..got.len {
                if got.get(k) != want.get(k) {
                    same = false;
                }
            }
        }
        if not same {
            failures += 1;
        }
    }
    return [cases, failures];
}

fn fmt_parse_hex(s: []u8) u32 {
    let mut v: u32 = 0;
    for c in s {
        let mut d: u32 = 0;
        if (c >= '0') and (c <= '9') {
            d = @as(u32, c - '0');
        } else if (c >= 'A') and (c <= 'F') {
            d = @as(u32, c - 'A') + 10;
        } else if (c >= 'a') and (c <= 'f') {
            d = @as(u32, c - 'a') + 10;
        }
        v = (v * 16) + d;
    }
    return v;
}

test "segmentation conformance (UCD test files, when installed)" {
    let g = run_seg_test("/usr/share/unicode/auxiliary/GraphemeBreakTest.txt", Segmentation.GRAPHEME)!;
    @expect_eq(g[1], 0);
    let w = run_seg_test("/usr/share/unicode/auxiliary/WordBreakTest.txt", Segmentation.WORD)!;
    @expect_eq(w[1], 0);
    let s = run_seg_test("/usr/share/unicode/auxiliary/SentenceBreakTest.txt", Segmentation.SENTENCE)!;
    @expect_eq(s[1], 0);
}

test "properties" {
    @expect(category('A') == Category.LU);
    @expect(category(0x3b1) == Category.LL);  // α
    @expect(category(0x662) == Category.ND);  // Arabic-Indic two
    @expect(category(0x10ffff) == Category.CN);
    @expect(category(0xe000) == Category.CO);
    @expect_eq(category_name(category(0x20ac)), "Sc");  // €
    @expect(is_space(0x3000));
    @expect(not is_space('x'));
    @expect(is_letter(0x4e2d));
    @expect(is_alphabetic(0x4e2d));
    @expect(is_upper(0x10400));
    @expect_eq(combining_class(0x301), 230);
    @expect(east_asian_width(0x4e2d) == EastAsianWidth.W);
    @expect_eq(mirror('('), ')');
    @expect(is_id_start('_') == false);
    @expect(is_id_continue('_'));
    @expect_eq(width('a'), 1);
    @expect_eq(width(0x301), 0);
    @expect_eq(width(0x4e2d), 2);
    @expect_eq(width(0x1f600), 2);
    @expect_eq(width(7), -1);
    @expect_eq(string_width("日本語 ok"), 9);
    @expect_eq(string_width("e\xcc\x81"), 1);
    @expect_eq(string_width("\xf0\x9f\x91\xa9\xe2\x80\x8d\xf0\x9f\x92\xbb"), 2);  // woman technologist (ZWJ)
    @expect_eq(string_width("\xf0\x9f\x87\xab\xf0\x9f\x87\xb7"), 2);              // flag
}

fn expect_map(f: fn([]u8) ![]mut u8, s: []u8, want: []u8) !void {
    let got = f(s)!;
    defer mem.free(got);
    @expect_eq(got, want);
}

test "case" {
    @expect_eq(to_upper('a'), 'A');
    @expect_eq(to_upper(0x3b1), 0x391);
    @expect_eq(to_lower(0x130), 0x69);
    @expect_eq(to_title(0x1c6), 0x1c5);  // ǆ -> ǅ
    expect_map(upper, "stra\xc3\x9fe", "STRASSE")!;
    expect_map(lower, "\xce\x9f\xce\x94\xce\x9f\xce\xa3", "\xce\xbf\xce\xb4\xce\xbf\xcf\x82")!;  // ΟΔΟΣ -> οδος
    expect_map(lower, "\xce\xa3", "\xcf\x83")!;  // a lone Σ is σ
    expect_map(case_fold, "Stra\xc3\x9fe", "strasse")!;
    expect_map(title, "hello wORLD, \xc7\x86ungla", "Hello World, \xc7\x85ungla")!;
    @expect(equal_fold("Stra\xc3\x9fe", "STRASSE"));
    @expect(equal_fold("\xe1\xba\x9e", "ss"));  // ẞ
    @expect(not equal_fold("abc", "abd"));
    @expect(not equal_fold("abc", "ab"));
}

test "normalization" {
    expect_map(nfd, "\xc3\xa9", "e\xcc\x81")!;
    expect_map(nfc, "e\xcc\x81", "\xc3\xa9")!;
    expect_map(nfc, "\xe1\x84\x80\xe1\x85\xa1\xe1\x86\xa8", "\xea\xb0\x81")!;  // Hangul jamo -> 각
    expect_map(nfd, "\xea\xb0\x81", "\xe1\x84\x80\xe1\x85\xa1\xe1\x86\xa8")!;
    expect_map(nfkc, "\xef\xac\x81", "fi")!;  // ﬁ
    expect_map(nfkd, "\xe2\x91\xa0", "1")!;   // ①
    // canonical ordering: dot below (220) before acute (230)
    expect_map(nfd, "a\xcc\x81\xcc\xa3", "a\xcc\xa3\xcc\x81")!;
    expect_map(nfc, "a\xcc\x81\xcc\xa3", "\xe1\xba\xa1\xcc\x81")!;
    @expect(is_normalized("caf\xc3\xa9", Form.NFC)!);
    @expect(not is_normalized("cafe\xcc\x81", Form.NFC)!);
}

test "segmentation" {
    let mut g = graphemes("e\xcc\x81\xf0\x9f\x87\xab\xf0\x9f\x87\xb7!");
    @expect_eq(g.next()!, "e\xcc\x81");
    @expect_eq(g.next()!, "\xf0\x9f\x87\xab\xf0\x9f\x87\xb7");
    @expect_eq(g.next()!, "!");
    @expect_eq(grapheme_count("\r\nab"), 3);
    let mut w = words("Hello, world! It's 3.14.");
    let want: [11][]u8 = ["Hello", ",", " ", "world", "!", " ", "It's", " ", "3.14", ".", ""];
    for k in @as(usize, 0)..10 {
        @expect_eq(w.next()!, want[k]);
    }
    @expect(is_word("It's"));
    @expect(not is_word(", "));
    let mut s = sentences("He said hi. Then he left! OK?");
    @expect_eq(s.next()!, "He said hi. ");
    @expect_eq(s.next()!, "Then he left! ");
    @expect_eq(s.next()!, "OK?");
}

test "utf-16" {
    let u = to_utf16("a\xc3\xa9\xf0\x9f\x98\x80")!;
    defer mem.free(u);
    @expect_eq(u.len, 4);
    @expect_eq(u[2], 0xd83d);
    @expect_eq(u[3], 0xde00);
    let back = from_utf16(u)!;
    defer mem.free(back);
    @expect_eq(back, "a\xc3\xa9\xf0\x9f\x98\x80");
    let lone: [2]u16 = [0xd800, 0x41];
    let fixed = from_utf16(lone[..])!;
    defer mem.free(fixed);
    @expect_eq(fixed, "\xef\xbf\xbdA");
}
