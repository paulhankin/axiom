test "decodes like the reference decoder" {
    let mut text = strs.String.init();
    defer text.deinit();
    for l in TINY {
        text.push_str(l)!;
    }
    let data = base64.decode_alloc(text.bytes(), base64.STANDARD)!;
    defer mem.free(data);
    let mut s = decode(data)!;
    defer s.deinit();
    @expect_eq(s.frames, 2000);
    @expect_eq(s.channels, 2);
    @expect_eq(s.rate, 8000);
    // the energy, and samples, as libvorbis gives them
    let mut energy: f64 = 0.0;
    for v in s.samples_f32() {
        energy += @float_cast(f64, v) * @float_cast(f64, v);
    }
    @expect(@abs(energy - 335.317480758171) < 1e-3);
    @expect(@abs(s.get(500, 0) - 0.02695661410689354) < 1e-5);
    @expect(@abs(s.get(500, 1) - 0.09827262163162231) < 1e-5);
    @expect(@abs(s.get(1003, 0) - 0.8854621648788452) < 1e-5);
    @expect(@abs(s.get(1003, 1) - -0.11724459379911423) < 1e-5);
}

fn less_u64(a: u64, b: u64) bool {
    return a < b;
}

