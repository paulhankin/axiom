];
let SILENT_2: [3][]u8 = [
    "T2dnUwACAAAAAAAAAAABAAAAAAAAAOcn83sBHgF2b3JiaXMAAAAAAoC7AAAAAAAAAAAAAAAAAADYAU9nZ1MAAAAAAAAAAAAA",
    "AQAAAAEAAADvR/lEAhA0A3ZvcmJpcwAAAAAAAAAAAQV2b3JiaXMAQkNWAQACAAAAAAAAABAAAEAAAAAAAAAAAAAAAAAAAAAA",
    "AAAAAIAAAAAAAAFPZ2dTAAD/////////fwEAAAACAAAAzqZGugMBAQEGBgY=",
];

fn from_base64(lines: [][]u8) VorbisError![]mut u8 {
    let mut text = strs.String.init();
    defer text.deinit();
    for l in lines {
        text.push_str(l) catch return error.OutOfMemory;
    }
    return base64.decode_alloc(text.bytes(), base64.STANDARD) catch return error.Corrupt;
}

fn fails_with(lines: [][]u8, want: VorbisError) bool {
    let data = from_base64(lines) catch return false;
    defer mem.free(data);
    let mut s = decode(data) catch |e| return e == want;
    s.deinit();
    return false;
}

test "codebooks and output are limited by the input" {
    @expect(fails_with(BOOKS[..], error.TooLarge));
    @expect(fails_with(SILENT_255[..], error.TooLarge));  // 21 million samples from 222 bytes
    let data = from_base64(SILENT_2[..])!;
    defer mem.free(data);
    let mut s = decode(data)!;
    defer s.deinit();
    @expect_eq(s.frames, 8192);
    @expect_eq(s.peak(), 0.0);
}
