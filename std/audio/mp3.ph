// =============================================================================
// std/audio/mp3.ph - MP3 decoding: MPEG-1, MPEG-2 and MPEG-2.5 audio layer III.
//
//     let mut s = mp3.decode(bytes)!;   // F32 samples
//     defer s.deinit();
//
// Decodes every layer III stream: all bit rates (constant and variable) and
// sample rates, mono, stereo, dual channel and joint stereo (mid/side and
// intensity), long, short and mixed blocks, the bit reservoir. ID3v2 and
// ID3v1 tags are skipped. A Xing/Info frame with LAME's gapless-playback
// fields trims the encoder's delay and padding, so the output has the
// original length. Layers I and II and free-format streams are not
// supported.
// =============================================================================

import "../audio.ph" as audio;
import "../base64.ph" as base64;
import "../math.ph" as math;
import "../mem.ph" as mem;
import "../str.ph" as strs;
import "../sync.ph" as sync;

error { InvalidAudio, Unsupported, OutOfMemory, TooLarge }

