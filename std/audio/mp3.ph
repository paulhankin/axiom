test "decodes like the reference decoder" {
    let mut text = strs.String.init();
    defer text.deinit();
    for l in TINY {
        text.push_str(l)!;
    }
    let data = base64.decode_alloc(text.bytes(), base64.STANDARD)!;
    defer mem.free(data);
    let mut s = decode(data)!;
    defer s.deinit();
    @expect_eq(s.frames, 2000);
    @expect_eq(s.channels, 2);
    @expect_eq(s.rate, 8000);
    // the energy, and samples, as libmpg123 gives them
    let mut energy: f64 = 0.0;
    for v in s.samples_f32() {
        energy += @float_cast(f64, v) * @float_cast(f64, v);
    }
    @expect(@abs(energy - 300.9178868599444) < 1e-3);
    @expect(@abs(s.get(500, 0) - -0.0012535974383354187) < 1e-5);
    @expect(@abs(s.get(500, 1) - 0.11070708930492401) < 1e-5);
    @expect(@abs(s.get(1003, 0) - 0.9820026159286499) < 1e-5);
    @expect(@abs(s.get(1003, 1) - -0.3384595513343811) < 1e-5);
}
