// =============================================================================
// std/audio/xaudio2.ax - playing sound on Windows with XAudio2: an engine
// with a mastering voice (the speakers), and source voices that play
// std/audio Sounds (16-bit or 32-bit float samples), with volume, pitch and
// looping; many voices mix.
//
//     let mut eng = xaudio2.Engine.init()!;
//     defer eng.deinit();
//     let snd = formats.read_file("boom.wav")!;          // std/audio/formats
//     let mut v = eng.voice(&snd)!;                       // its format
//     defer v.destroy();
//     v.play(&snd, false)!;                               // snd must outlive the playing
//     while v.playing() { ... }
//
// Windows only (--target=x86_64-windows; xaudio2_9.dll is part of Windows 10).
// =============================================================================

import "../audio.ax" as audio;
import "../os/com.ax" as com;

error { Unsupported, Failed }

extern "C" "xaudio2_9" {
    fn XAudio2Create(engine: *mut usize, flags: u32, processor: u32) i32;
}

pub struct Engine {
    x: usize,       // IXAudio2
    master: usize,  // IXAudio2MasteringVoice (not a COM object)

    /// The engine, playing to the default audio device.
    pub fn init() !Engine {
        com.init();
        let mut e = Engine.{ x: 0, master: 0 };
        if XAudio2Create(&mut e.x, 0, 0xffff_ffff) < 0 {  // XAUDIO2_DEFAULT_PROCESSOR
            return error.Unsupported;
        }
        // CreateMasteringVoice(voice, channels, rate (0: the device's),
        // flags, device, effects, category: game effects)
        let f = @bit_cast(fn(usize, *mut usize, u32, u32, u32, *void, *void, u32) i32, com.method(e.x, 7));
        if f(e.x, &mut e.master, 0, 0, 0, @ptr_from_int(*void, 0), @ptr_from_int(*void, 0), 6) < 0 {
            com.release(e.x);
            return error.Unsupported;  // (no audio device)
        }
        return e;
    }

    pub fn deinit(self: *mut Engine) void {
        if self.master != 0 {
            @bit_cast(fn(usize) void, com.method(self.master, 18))(self.master);  // DestroyVoice
        }
        com.release(self.x);
        self.master = 0;
        self.x = 0;
    }

    /// The overall volume (1: as is, 0: silent).
    pub fn set_volume(self: *mut Engine, v: f32) void {
        _ = @bit_cast(fn(usize, f32, u32) i32, com.method(self.master, 12))(self.master, v, 0);
    }

    /// A voice for sounds of s's format (channels, rate, S16 or F32 samples).
    pub fn voice(self: *mut Engine, s: *audio.Sound) !Voice {
        return self.voice_for(@truncate(u32, s.channels), s.rate, s.format);
    }

    pub fn voice_for(self: *mut Engine, channels: u32, rate: u32, format: audio.SampleFormat) !Voice {
        // WAVEFORMATEX (18 bytes): tag, channels, rate, bytes per second,
        // block align, bits per sample, extra size
        let mut tag: u16 = 1;  // WAVE_FORMAT_PCM
        let mut bits: u32 = 16;
        if format == audio.SampleFormat.F32 {
            tag = 3;  // WAVE_FORMAT_IEEE_FLOAT
            bits = 32;
        } else if format != audio.SampleFormat.S16 {
            return error.Unsupported;  // (Sound.convert to S16 or F32 first)
        }
        let block = channels * (bits / 8);
        let mut wf: [20]u8 = [0; 20];
        com.put16(wf[..], 0, tag);
        com.put16(wf[..], 2, @truncate(u16, channels));
        com.put32(wf[..], 4, rate);
        com.put32(wf[..], 8, rate * block);
        com.put16(wf[..], 12, @truncate(u16, block));
        com.put16(wf[..], 14, @truncate(u16, bits));
        let mut v: usize = 0;
        // CreateSourceVoice(voice, format, flags, max frequency ratio,
        // callback, sends, effects)
        let f = @bit_cast(fn(usize, *mut usize, *u8, u32, f32, *void, *void, *void) i32, com.method(self.x, 5));
        if f(
            self.x, &mut v, &wf[0], 0, 4.0, @ptr_from_int(*void, 0), @ptr_from_int(*void, 0), @ptr_from_int(
                *void, 0)) < 0 {
            return error.Failed;
        }
        return Voice.{ v: v, block: block };
    }
}

pub struct Voice {
    v: usize,  // IXAudio2SourceVoice (not a COM object)
    block: u32,

    /// Plays a sound (all of it; again and again when `looping`) after what
    /// is queued. Its samples must stay alive until it has played.
    pub fn play(self: *mut Voice, s: *audio.Sound, looping: bool) !void {
        self.queue(s.data, looping)!;
        self.start();
    }

    /// Queues raw samples in the voice's format.
    pub fn queue(self: *mut Voice, data: []u8, looping: bool) !void {
        // XAUDIO2_BUFFER (44 bytes, packed): flags (end of stream), bytes,
        // data at 8, play begin/length, loop begin at 24, loop length, loop
        // count at 32, context
        let mut b: [44]u8 = [0; 44];
        com.put32(b[..], 0, 0x40);  // XAUDIO2_END_OF_STREAM
        com.put32(b[..], 4, @truncate(u32, data.len));
        com.ptr(b[..], 8, @int_from_ptr(data.ptr));
        if looping {
            com.put32(b[..], 32, 255);  // XAUDIO2_LOOP_INFINITE
        }
        let f = @bit_cast(fn(usize, *u8, *void) i32, com.method(self.v, 21));  // SubmitSourceBuffer
        if f(self.v, &b[0], @ptr_from_int(*void, 0)) < 0 {
            return error.Failed;
        }
    }

    pub fn start(self: *mut Voice) void {
        _ = @bit_cast(fn(usize, u32, u32) i32, com.method(self.v, 19))(self.v, 0, 0);
    }

    /// Stops and forgets what was queued.
    pub fn stop(self: *mut Voice) void {
        _ = @bit_cast(fn(usize, u32, u32) i32, com.method(self.v, 20))(self.v, 0, 0);
        _ = @bit_cast(fn(usize) i32, com.method(self.v, 22))(self.v);  // FlushSourceBuffers
    }

    /// Ends a looping sound after its current pass.
    pub fn end_loop(self: *mut Voice) void {
        _ = @bit_cast(fn(usize, u32) i32, com.method(self.v, 24))(self.v, 0);
    }

    /// The voice's volume (1: as is).
    pub fn set_volume(self: *mut Voice, v: f32) void {
        _ = @bit_cast(fn(usize, f32, u32) i32, com.method(self.v, 12))(self.v, v, 0);
    }

    /// Plays faster and higher (> 1) or slower and lower (< 1), up to 4.
    pub fn set_pitch(self: *mut Voice, ratio: f32) void {
        _ = @bit_cast(fn(usize, f32, u32) i32, com.method(self.v, 26))(self.v, ratio, 0);
    }

    // XAUDIO2_VOICE_STATE (20 bytes, packed): context, buffers queued at 8,
    // samples played (u64) at 12
    fn state(self: *Voice) [20]u8 {
        let mut st: [20]u8 = [0; 20];
        @bit_cast(fn(usize, *mut u8, u32) void, com.method(self.v, 25))(self.v, &mut st[0], 0);
        return st;
    }

    /// Is something still queued?
    pub fn playing(self: *Voice) bool {
        let st = self.state();
        return com.get32(st[..], 8) != 0;
    }

    /// Frames played since the voice started.
    pub fn frames_played(self: *Voice) u64 {
        let st = self.state();
        return com.get64(st[..], 12);
    }

    pub fn destroy(self: *mut Voice) void {
        if self.v != 0 {
            @bit_cast(fn(usize) void, com.method(self.v, 18))(self.v);
        }
        self.v = 0;
    }
}
