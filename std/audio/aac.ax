// =============================================================================
// std/audio/aac.ax - AAC decoding, from ADTS streams (.aac) and MP4 files
// (.m4a, .mp4).
//
// License: the decoder this imports (std/audio/internal/aac/) is derived from FFmpeg's
// and licensed under the LGPL 2.1 or later (std/audio/internal/aac/LICENSE), unlike the
// rest of std. Only a program that imports this module includes it; see
// THIRD-PARTY-NOTICES.md for what distributing one entails. std/audio/formats
// reads AAC once this module's decoder is added to it:
//
//     formats.add(aac.DECODER);
//
//     let mut s = aac.decode(bytes)!;   // F32 samples
//     defer s.deinit();
//
// AAC Main, LC and LTP (aac/decoder.ax), HE-AAC (spectral band
// replication, aac/sbr.ax) and HE-AAC v2 (parametric stereo, aac/ps.ax),
// signalled explicitly or implicitly; up to 64 channels (the standard
// channel configurations, in FFmpeg's channel order, or a program
// configuration element). Mono HE-AAC decodes to stereo, as in FFmpeg
// (parametric stereo may appear). An MP4 file's first audio track is
// decoded and trimmed by its edit list (or iTunes' iTunSMPB gapless
// information), so the output has exactly the encoded length; an ADTS
// stream is decoded whole, including the encoder's priming.
// =============================================================================

import "../audio.ax" as audio;
import "../mem.ax" as mem;
import "formats.ax" as formats;
import "internal/aac/bits.ax" as bitio;
import "internal/aac/decoder.ax" as dec;

pub error AacError { Corrupt, Unsupported, OutOfMemory, TooLarge, Empty, NotFound }

fn id3_skip(data: []u8) usize {
    if (data.len >= 10) and @mem_eq(data[..3], "ID3") {
        let size = (@as(usize, data[6] & 0x7f) << 21) | (@as(usize, data[7] & 0x7f) << 14) | (
            @as(usize, data[8] & 0x7f) << 7) | @as(usize, data[9] & 0x7f);
        let mut n = 10 + size;
        if (data[5] & 0x10) != 0 {
            n += 10;
        }
        return @min(n, data.len);
    }
    return 0;
}

fn is_adts_at(data: []u8, o: usize) bool {
    return ((o + 7) <= data.len) and (data[o] == 0xff) and ((data[o + 1] & 0xf6) == 0xf0);
}

/// AAC for std/audio/formats: formats.add(DECODER).
pub let DECODER: formats.Decoder = formats.Decoder.{ format: formats.Format.AAC, extensions: "aac adts m4a m4b mp4",
                                                     is: is_aac, decode: decode };

/// Whether data is an ADTS stream or an MP4 file with an AAC track.
pub fn is_aac(data: []u8) bool {
    let o = id3_skip(data);
    if is_adts_at(data, o) {
        let len = ((@as(usize, data[o + 3]) & 3) << 11) | (@as(usize, data[o + 4]) << 3) | (
            @as(usize, data[o + 5]) >> 5);
        // one frame, then another header (or the end)
        return (len >= 7) and (((o + len) == data.len) or is_adts_at(data, o + len) or ((o + len) > data.len));
    }
    if (data.len >= 12) and @mem_eq(data[4..8], "ftyp") {
        // an mp4a sample entry somewhere in the file
        let n = data.len - 4;
        for i in @as(usize, 0)..n {
            if (data[i] == 'm') and @mem_eq(data[i..i + 4], "mp4a") {
                return true;
            }
        }
    }
    return false;
}

// The most samples a byte of AAC holds (audio.max_samples): an empty
// channel element takes 4 bytes for 1024 frames, which spectral band
// replication doubles and parametric stereo doubles again.
const PER_BYTE: usize = 2048;

/// The decoded samples (F32, interleaved), grown as blocks arrive.
struct Out {
    data: []mut u8,
    frames: usize,
    channels: usize,
    limit: usize,  // the most samples (audio.max_samples)

    fn init(input_len: usize) AacError!Out {
        return Out.{ data: mem.alloc.[u8](0)!, frames: 0, channels: 0, limit: audio.max_samples(input_len, PER_BYTE) };
    }

    fn deinit(self: *mut Out) void {
        mem.free(self.data);
    }
}

fn emit(o: *mut Out, block: []f32, n: usize, frames: usize) AacError!void {
    if (o.frames + frames) > (o.limit / n) {
        return error.TooLarge;
    }
    let f32s = audio.SampleFormat.F32;
    let need = audio.sample_bytes((o.frames + frames) * n, f32s)!;
    if need > o.data.len {
        let most = audio.sample_bytes((o.limit / n) * n, f32s)!;
        o.data = mem.realloc(o.data, @min(@max(o.data.len * 2, need + 65536), most))!;
    }
    let v = @cast_slice(f32, o.data[..need]);
    @mem_copy(v[o.frames * n..], block[..frames * n]);
    o.frames += frames;
}

/// The sound: total frames after the first skip (each clamped to what was
/// decoded). The samples move to it.
fn finish(o: *mut Out, rate: i32, skip0: usize, total0: usize) AacError!audio.Sound {
    let skip = @min(skip0, o.frames);
    let total = @min(total0, o.frames - skip);
    let n = o.channels;
    let v = @cast_slice(f32, o.data[..o.frames * n * 4]);
    for i in @as(usize, 0)..(total * n) {
        v[i] = v[(skip * n) + i];
    }
    let mut s = audio.Sound.init(0, n, @bit_cast(u32, rate), audio.SampleFormat.F32)!;
    let data = mem.realloc(o.data, @max(total * n * 4, 1)) catch |e| {
        s.deinit();
        return e;
    };
    mem.free(s.data);
    s.data = data;
    s.frames = total;
    o.data = mem.alloc.[u8](0)!;  // (empty: cannot fail)
    return s;
}

// -----------------------------------------------------------------------------
// ADTS
// -----------------------------------------------------------------------------

/// An ADTS frame's header.
struct AdtsFrame {
    end: bool,  // no frame here: the end of the audio
    profile: i32,
    rate_index: i32,
    chan: i32,
    len: usize,  // the whole frame
    hl: usize,   // its header
    nblocks: usize,
}

/// The header of the ADTS frame at o. Once frames have been decoded
/// (started), trailing junk or a truncated frame ends the audio.
fn adts_frame(data: []u8, o: usize, started: bool) AacError!AdtsFrame {
    let mut f = AdtsFrame.{ end: true, profile: 0, rate_index: 0, chan: 0, len: 0, hl: 7, nblocks: 0 };
    if (o + 7) > data.len {
        return f;
    }
    if not is_adts_at(data, o) {
        if started {
            return f;  // trailing junk (an ID3v1 tag, say)
        }
        return error.Corrupt;
    }
    let h = data[o..];
    let protection_absent = (h[1] & 1) != 0;
    f.profile = @as(i32, h[2] >> 6);
    f.rate_index = @as(i32, (h[2] >> 2) & 15);
    f.chan = (@as(i32, h[2] & 1) << 2) | @as(i32, h[3] >> 6);
    f.len = ((@as(usize, h[3]) & 3) << 11) | (@as(usize, h[4]) << 3) | (@as(usize, h[5]) >> 5);
    f.nblocks = @as(usize, h[6] & 3) + 1;
    if (f.len < 7) or ((o + f.len) > data.len) or (f.rate_index > 12) {
        if started and ((o + f.len) > data.len) {
            return f;  // a truncated last frame
        }
        return error.Corrupt;
    }
    if not protection_absent {
        if f.nblocks > 1 {
            return error.Unsupported;
        }
        f.hl = 9;
    }
    if f.hl > f.len {
        return error.Corrupt;
    }
    f.end = false;
    return f;
}

fn decode_adts(data: []u8) AacError!audio.Sound {
    let mut o = id3_skip(data);
    // the first frame sets the format
    let first = adts_frame(data, o, false)!;
    if first.end {
        return error.Corrupt;
    }
    let mut cfg = dec.empty_config();
    cfg.object_type = first.profile + 1;
    if (cfg.object_type != dec.AOT_MAIN) and (cfg.object_type != dec.AOT_LC) and (cfg.object_type != dec.AOT_LTP) {
        return error.Unsupported;
    }
    cfg.sampling_index = first.rate_index;
    cfg.sample_rate = dec.SAMPLE_RATES[@as(usize, @bit_cast(u32, first.rate_index))];
    cfg.chan_config = first.chan;
    if first.chan > 7 {
        return error.Unsupported;
    }
    let d = dec.new(cfg)!;
    defer {
        d.deinit();
        mem.destroy(d);
    }
    let block = mem.alloc.[f32](2048 * 64)!;
    defer mem.free(block);
    let mut out = Out.init(data.len)!;
    defer out.deinit();
    loop {
        let f = adts_frame(data, o, out.frames > 0)!;
        if f.end {
            break;
        }
        if (f.profile != first.profile) or (f.rate_index != first.rate_index) or (f.chan != first.chan) {
            return error.Unsupported;  // the format changes mid-stream
        }
        let mut b = bitio.Bits.init(data[o + f.hl..o + f.len]);
        for _k in @as(usize, 0)..f.nblocks {
            let got = dec.decode_block(d, &mut b, block)!;
            if got > 0 {
                let n = dec.channels(d);
                if (out.channels != 0) and (out.channels != n) {
                    return error.Unsupported;
                }
                out.channels = n;
                emit(&mut out, block, n, got)!;
            }
            b.align();
        }
        o += f.len;
    }
    if out.channels == 0 {
        return error.Corrupt;
    }
    let total = out.frames;
    return finish(&mut out, dec.output_rate(d), 0, total);
}

// -----------------------------------------------------------------------------
// MP4
// -----------------------------------------------------------------------------

struct Box {
    typ: [4]u8,
    body: usize,
    end: usize,
}

/// The box at o in data[..end], or false.
fn box_at(data: []u8, o: usize, end: usize, bx: *mut Box) bool {
    if (o + 8) > end {
        return false;
    }
    let mut size = @as(u64, binary.u32_be(data[o..]));
    let mut hdr: usize = 8;
    if size == 1 {
        if (o + 16) > end {
            return false;
        }
        size = binary.u64_be(data[o + 8..]);
        hdr = 16;
    } else if size == 0 {
        size = @as(u64, end - o);
    }
    if (size < @as(u64, hdr)) or (size > @as(u64, end - o)) {
        return false;
    }
    bx.typ = [data[o + 4], data[o + 5], data[o + 6], data[o + 7]];
    bx.body = o + hdr;
    bx.end = o + @truncate(usize, size);
    return true;
}

/// The first child box of the given type in data[o..end].
fn find(data: []u8, o0: usize, end: usize, typ: []u8, bx: *mut Box) bool {
    let mut o = o0;
    while box_at(data, o, end, bx) {
        if @mem_eq(bx.typ[..], typ) {
            return true;
        }
        o = bx.end;
    }
    return false;
}

/// A path of nested boxes.
fn find_path(data: []u8, o: usize, end: usize, path: [][]u8, bx: *mut Box) bool {
    let mut s = o;
    let mut e = end;
    for p in path {
        if not find(data, s, e, p, bx) {
            return false;
        }
        s = bx.body;
        e = bx.end;
    }
    return true;
}

struct Track {
    asc: []u8,
    stsz: Box,
    stsc: Box,
    stco: Box,
    co64: bool,
    timescale: u32,
    duration: u64,
    edit_skip: i64,  // media time of the first edit, or -1
    edit_len: u64,   // its length, in the movie timescale
}

fn desc_len(data: []u8, o: *mut usize, end: usize) usize {
    let mut n: usize = 0;
    for _i in @as(usize, 0)..4 {
        if o.* >= end {
            return 0;
        }
        let b = data[o.*];
        o.* += 1;
        n = (n << 7) | @as(usize, b & 0x7f);
        if (b & 0x80) == 0 {
            break;
        }
    }
    return n;
}

/// The AudioSpecificConfig in an esds box.
fn esds_asc(data: []u8, bx: *Box) AacError![]u8 {
    let mut o = bx.body + 4;
    let end = bx.end;
    while (o + 2) <= end {
        let tag = data[o];
        o += 1;
        let len = desc_len(data, &mut o, end);
        if tag == 3 {
            if (o + 3) > end {
                return error.Corrupt;
            }
            let flags = data[o + 2];
            o += 3;
            if (flags & 0x80) != 0 {
                o += 2;
            }
            if (flags & 0x40) != 0 {
                if o >= end {
                    return error.Corrupt;
                }
                o += 1 + @as(usize, data[o]);
            }
            if (flags & 0x20) != 0 {
                o += 2;
            }
        } else if tag == 4 {
            if (o + 13) > end {
                return error.Corrupt;
            }
            let oti = data[o];
            if (oti != 0x40) and (oti != 0x66) and (oti != 0x67) and (oti != 0x68) {
                return error.Unsupported;  // not AAC
            }
            o += 13;
        } else if tag == 5 {
            if (o + len) > end {
                return error.Corrupt;
            }
            return data[o..o + len];
        } else {
            o += len;
        }
    }
    return error.Corrupt;
}

fn read_track(data: []u8, trak: *Box, movie_scale: u32, tr: *mut Track) AacError!bool {
    let mut bx = Box.{ typ: [0; 4], body: 0, end: 0 };
    let hp: [2][]u8 = ["mdia", "hdlr"];
    if not find_path(data, trak.body, trak.end, hp[..], &mut bx) or ((bx.body + 12) > bx.end) or
       not @mem_eq(data[bx.body + 8..bx.body + 12], "soun") {
        return false;
    }
    let mp: [2][]u8 = ["mdia", "mdhd"];
    if not find_path(data, trak.body, trak.end, mp[..], &mut bx) or ((bx.body + 24) > bx.end) {
        return error.Corrupt;
    }
    if data[bx.body] == 1 {
        if (bx.body + 32) > bx.end {
            return error.Corrupt;
        }
        tr.timescale = binary.u32_be(data[bx.body + 20..]);
        tr.duration = binary.u64_be(data[bx.body + 24..]);
    } else {
        tr.timescale = binary.u32_be(data[bx.body + 12..]);
        tr.duration = @as(u64, binary.u32_be(data[bx.body + 16..]));
    }
    let sp: [5][]u8 = ["mdia", "minf", "stbl", "stsd", "mp4a"];
    if not find_path(data, trak.body, trak.end, sp[..4], &mut bx) {
        return error.Corrupt;
    }
    // stsd: version/flags, count, then the sample entries
    let mut entry = Box.{ typ: [0; 4], body: 0, end: 0 };
    if not box_at(data, bx.body + 8, bx.end, &mut entry) {
        return error.Corrupt;
    }
    if not @mem_eq(entry.typ[..], "mp4a") {
        return error.Unsupported;
    }
    let mut version: u32 = 0;
    if (entry.body + 10) <= entry.end {
        version = @as(u32, binary.u16_be(data[entry.body + 8..]));
    }
    let mut children = entry.body + 28;
    if version == 1 {
        children += 16;
    } else if version == 2 {
        children += 36;
    }
    let mut esds = Box.{ typ: [0; 4], body: 0, end: 0 };
    if not find(data, children, entry.end, "esds", &mut esds) {
        // QuickTime puts it in a wave box
        let mut wave = Box.{ typ: [0; 4], body: 0, end: 0 };
        if not find(data, children, entry.end, "wave", &mut wave) or
           not find(data, wave.body, wave.end, "esds", &mut esds) {
            return error.Corrupt;
        }
    }
    tr.asc = esds_asc(data, &esds)!;
    let st: [3][]u8 = ["mdia", "minf", "stbl"];
    let mut stbl = Box.{ typ: [0; 4], body: 0, end: 0 };
    _ = find_path(data, trak.body, trak.end, st[..], &mut stbl);
    if not find(data, stbl.body, stbl.end, "stsz", &mut tr.stsz) or
       not find(data, stbl.body, stbl.end, "stsc", &mut tr.stsc) {
        return error.Corrupt;
    }
    tr.co64 = false;
    if not find(data, stbl.body, stbl.end, "stco", &mut tr.stco) {
        if not find(data, stbl.body, stbl.end, "co64", &mut tr.stco) {
            return error.Corrupt;
        }
        tr.co64 = true;
    }
    // the edit list: the first edit that is not empty
    tr.edit_skip = -1;
    let ep: [2][]u8 = ["edts", "elst"];
    if find_path(data, trak.body, trak.end, ep[..], &mut bx) and ((bx.body + 8) <= bx.end) {
        let v = data[bx.body];
        let n = @as(usize, binary.u32_be(data[bx.body + 4..]));
        let mut o = bx.body + 8;
        for _i in @as(usize, 0)..n {
            let mut dur: u64 = 0;
            let mut mt: i64 = 0;
            if v == 1 {
                if (o + 20) > bx.end {
                    break;
                }
                dur = binary.u64_be(data[o..]);
                mt = @bit_cast(i64, binary.u64_be(data[o + 8..]));
                o += 20;
            } else {
                if (o + 12) > bx.end {
                    break;
                }
                dur = @as(u64, binary.u32_be(data[o..]));
                mt = @as(i64, @bit_cast(i32, binary.u32_be(data[o + 4..])));
                o += 12;
            }
            if mt >= 0 {
                tr.edit_skip = mt;
                tr.edit_len = dur;
                if movie_scale == 0 {
                    tr.edit_skip = -1;
                }
                break;
            }
        }
    }
    return true;
}

/// iTunes gapless information: the priming and the length, in samples.
fn itunsmpb(data: []u8, moov: *Box, priming: *mut u64, length: *mut u64) bool {
    let key = "iTunSMPB";
    let mut i = moov.body;
    while (i + key.len) <= moov.end {
        if @mem_eq(data[i..i + key.len], key) {
            let mut bx = Box.{ typ: [0; 4], body: 0, end: 0 };
            if find(data, i + key.len, moov.end, "data", &mut bx) and ((bx.body + 8) <= bx.end) {
                // " 00000000 00000840 000001C4 0000000000046A7C ..."
                let s = data[bx.body + 8..bx.end];
                let mut vals: [4]u64 = [0; 4];
                let mut k: usize = 0;
                let mut j: usize = 0;
                while (j < s.len) and (k < 4) {
                    while (j < s.len) and (s[j] == ' ') {
                        j += 1;
                    }
                    let st = j;
                    let mut v: u64 = 0;
                    while j < s.len {
                        let c = s[j];
                        let mut h: u64 = 0;
                        if (c >= '0') and (c <= '9') {
                            h = @as(u64, c - '0');
                        } else if (c >= 'A') and (c <= 'F') {
                            h = @as(u64, c - 'A') + 10;
                        } else if (c >= 'a') and (c <= 'f') {
                            h = @as(u64, c - 'a') + 10;
                        } else {
                            break;
                        }
                        v = (v << 4) | h;
                        j += 1;
                    }
                    if j == st {
                        break;
                    }
                    vals[k] = v;
                    k += 1;
                }
                if (k == 4) and (vals[3] > 0) {
                    priming.* = vals[1];
                    length.* = vals[3];
                    return true;
                }
            }
            return false;
        }
        i += 1;
    }
    return false;
}

fn decode_mp4(data: []u8) AacError!audio.Sound {
    let mut moov = Box.{ typ: [0; 4], body: 0, end: 0 };
    if not find(data, 0, data.len, "moov", &mut moov) {
        return error.Corrupt;
    }
    let mut movie_scale: u32 = 0;
    let mut bx = Box.{ typ: [0; 4], body: 0, end: 0 };
    if find(data, moov.body, moov.end, "mvhd", &mut bx) and ((bx.body + 24) <= bx.end) {
        if data[bx.body] == 1 {
            movie_scale = binary.u32_be(data[bx.body + 20..]);
        } else {
            movie_scale = binary.u32_be(data[bx.body + 12..]);
        }
    }
    // the first audio track
    let mut tr = Track.{ asc: data[..0], stsz: bx, stsc: bx, stco: bx, co64: false, timescale: 0, duration: 0,
                         edit_skip: -1, edit_len: 0 };
    let mut o = moov.body;
    let mut found = false;
    let mut trak = Box.{ typ: [0; 4], body: 0, end: 0 };
    while box_at(data, o, moov.end, &mut trak) {
        if @mem_eq(trak.typ[..], "trak") and read_track(data, &trak, movie_scale, &mut tr)! {
            found = true;
            break;
        }
        o = trak.end;
    }
    if not found {
        return error.Corrupt;
    }
    let mut cfg = dec.empty_config();
    dec.parse_asc(tr.asc, &mut cfg)!;
    let d = dec.new(cfg)!;
    defer {
        d.deinit();
        mem.destroy(d);
    }
    let block = mem.alloc.[f32](2048 * 64)!;
    defer mem.free(block);
    let mut out = Out.init(data.len)!;
    defer out.deinit();
    // the samples: chunks (stco) of runs of samples (stsc) of sizes (stsz)
    if ((tr.stsz.body + 12) > tr.stsz.end) or ((tr.stsc.body + 8) > tr.stsc.end) or ((tr.stco.body + 8) > tr.stco.end) {
        return error.Corrupt;
    }
    // (the tables' sizes compared by division: a product can wrap)
    let fixed = binary.u32_be(data[tr.stsz.body + 4..]);
    let nsamples = @as(usize, binary.u32_be(data[tr.stsz.body + 8..]));
    if (fixed == 0) and (nsamples > ((tr.stsz.end - tr.stsz.body - 12) / 4)) {
        return error.Corrupt;
    }
    let nchunks = @as(usize, binary.u32_be(data[tr.stco.body + 4..]));
    let mut csize: usize = 4;
    if tr.co64 {
        csize = 8;
    }
    if nchunks > ((tr.stco.end - tr.stco.body - 8) / csize) {
        return error.Corrupt;
    }
    let nruns = @as(usize, binary.u32_be(data[tr.stsc.body + 4..]));
    if nruns > ((tr.stsc.end - tr.stsc.body - 8) / 12) {
        return error.Corrupt;
    }
    // samples may not share bytes: those decoded total at most the file
    let mut left = data.len;
    let mut sample: usize = 0;
    let mut run: usize = 0;
    for chunk in @as(usize, 0)..nchunks {
        // the run this chunk is in (first_chunk counts from 1)
        while ((run + 1) < nruns) and
              (@as(usize, binary.u32_be(data[tr.stsc.body + 8 + (12 * (run + 1))..])) <= (chunk + 1)) {
            run += 1;
        }
        if nruns == 0 {
            break;
        }
        let per = @as(usize, binary.u32_be(data[tr.stsc.body + 8 + (12 * run) + 4..]));
        let mut pos: usize = 0;
        if tr.co64 {
            let p64 = binary.u64_be(data[tr.stco.body + 8 + (8 * chunk)..]);
            if p64 > @as(u64, data.len) {
                return error.Corrupt;
            }
            pos = @truncate(usize, p64);
        } else {
            pos = @as(usize, binary.u32_be(data[tr.stco.body + 8 + (4 * chunk)..]));
        }
        for _k in @as(usize, 0)..per {
            if sample >= nsamples {
                break;
            }
            let mut size = @as(usize, fixed);
            if fixed == 0 {
                size = @as(usize, binary.u32_be(data[tr.stsz.body + 12 + (4 * sample)..]));
            }
            if (pos > data.len) or (size > (data.len - pos)) or (size > left) {
                return error.Corrupt;
            }
            left -= size;
            let mut b = bitio.Bits.init(data[pos..pos + size]);
            let got = dec.decode_block(d, &mut b, block)!;
            if got > 0 {
                let n = dec.channels(d);
                if (out.channels != 0) and (out.channels != n) {
                    return error.Unsupported;
                }
                out.channels = n;
                emit(&mut out, block, n, got)!;
            }
            pos += size;
            sample += 1;
        }
    }
    if out.channels == 0 {
        return error.Corrupt;
    }
    // trimming: the edit list, else iTunes' gapless information
    let orate = dec.output_rate(d);
    let rate = @as(u64, @bit_cast(u32, orate));
    let ts = @as(u64, tr.timescale);
    let frames = @as(u64, out.frames);
    let mut skip: u64 = 0;
    let mut total = frames;
    if (tr.edit_skip >= 0) and (ts > 0) {
        skip = rescale(@bit_cast(u64, tr.edit_skip), rate, ts);
        if (tr.edit_len > 0) and (movie_scale > 0) {
            total = rescale(tr.edit_len, rate, @as(u64, movie_scale));
            // the media's own length is exact where the movie's timescale is coarse
            if tr.duration > @bit_cast(u64, tr.edit_skip) {
                let media = rescale(tr.duration - @bit_cast(u64, tr.edit_skip), rate, ts);
                let diff = @max(media, total) - @min(media, total);
                let err = @mul_checked(diff, @as(u64, movie_scale)) catch rate;
                if err < rate {
                    total = media;
                }
            }
        }
    } else {
        let mut priming: u64 = 0;
        let mut length: u64 = 0;
        if itunsmpb(data, &moov, &mut priming, &mut length) {
            skip = priming;
            total = length;
        }
    }
    return finish(&mut out, orate, @truncate(usize, @min(skip, frames)), @truncate(usize, @min(total, frames)));
}

// v * by / per for a 32-bit per, or the most a u64 holds if v * by does
// not fit in one (the quotient is then at least 2^32, past any output).
fn rescale(v: u64, by: u64, per: u64) u64 {
    let p = @mul_checked(v, by) catch return @max_value(u64);
    return p / per;
}

/// Decodes an ADTS stream or an MP4 file's first AAC track to F32 samples.
pub fn decode(data: []u8) AacError!audio.Sound {
    if (data.len >= 12) and @mem_eq(data[4..8], "ftyp") {
        return decode_mp4(data);
    }
    return decode_adts(data);
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

import "../encoding/base64.ax" as base64;
import "../encoding/binary.ax" as binary;
import "../os/fs.ax" as fs;
import "../str.ax" as strs;

fn field(line: []u8, n: usize) []u8 {
    let mut k: usize = 0;
    let mut s: usize = 0;
    for i in @as(usize, 0)..(line.len + 1) {
        if (i == line.len) or (line[i] == ' ') {
            if k == n {
                return line[s..i];
            }
            k += 1;
            s = i + 1;
        }
    }
    return line[..0];
}

fn num(s: []u8) usize {
    let mut v: usize = 0;
    for c in s {
        v = (v * 10) + @as(usize, c - '0');
    }
    return v;
}

test "decodes like FFmpeg" {
    let list = fs.read_file("std/audio/testdata/aac/cases.txt") catch return;
    defer mem.free(list);
    let mut start: usize = 0;
    let mut n: usize = 0;
    for i in @as(usize, 0)..list.len {
        if list[i] != '\n' {
            continue;
        }
        let line = list[start..i];
        start = i + 1;
        let name = field(line, 0);
        let mut path = strs.String.init();
        defer path.deinit();
        path.push_str("std/audio/testdata/aac/")!;
        path.push_str(name)!;
        path.push_str(".")!;
        path.push_str(field(line, 1))!;
        let data = fs.read_file(path.bytes())!;
        defer mem.free(data);
        @expect(is_aac(data));
        let mut s = decode(data)!;
        defer s.deinit();
        @expect_eq(s.channels, num(field(line, 2)));
        @expect_eq(@as(usize, s.rate), num(field(line, 4)));
        @expect_eq(s.frames, num(field(line, 5)));
        path.truncate(path.bytes().len - field(line, 1).len);
        path.push_str("pcm")!;
        let want = fs.read_file(path.bytes())!;
        defer mem.free(want);
        let got = s.samples_f32();
        let mut worst: f32 = 0.0;
        for k in @as(usize, 0)..@min(got.len, want.len / 2) {
            let w = @float_from_int(f32, @bit_cast(i16, @as(u16, want[2 * k]) | (@as(u16, want[(2 * k) + 1]) << 8)));
            let g = @min(@max(got[k] * 32768.0, -32768.0), 32767.0);
            worst = @max(worst, @abs(g - w));
        }
        // SBR and PS amplify rounding differences: FFmpeg's own C and SIMD
        // code differ by up to 0.75 of a 16-bit step on these streams
        let mut limit: f32 = 1.0;
        if (name.len >= 2) and @mem_eq(name[..2], "he") {
            limit = 2.0;
        }
        @expect(worst <= limit);
        n += 1;
    }
    @expect_eq(n, 17);
}

test "std/audio/formats reads AAC once DECODER is added" {
    formats.add(DECODER);
    formats.add(DECODER);  // a second time: nothing changes
    @expect(formats.from_extension("song.M4A") == formats.Format.AAC);
    @expect(formats.from_extension("x.adts") == formats.Format.AAC);
    @expect(formats.from_extension("x.flac") == formats.Format.FLAC);
    let data = fs.read_file("std/audio/testdata/aac/lc_mono.aac") catch return;
    defer mem.free(data);
    @expect(formats.detect(data) == formats.Format.AAC);
    let mut s = formats.decode(data)!;
    defer s.deinit();
    @expect((s.channels == 1) and (s.frames > 0));
}

test "rejects damaged files" {
    let names: [3][]u8 = ["std/audio/testdata/aac/lc_mono.aac", "std/audio/testdata/aac/main.m4a",
                          "std/audio/testdata/aac/he_v2.aac"];
    let mut seed: u32 = 777;
    for name in names {
        let data = fs.read_file(name) catch return;
        defer mem.free(data);
        let buf = mem.alloc.[u8](data.len)!;
        defer mem.free(buf);
        for _it in @as(usize, 0)..150 {
            @mem_copy(buf, data);
            for _f in @as(usize, 0)..6 {
                seed = (seed *% 1664525) +% 1013904223;
                buf[@as(usize, seed >> 8) % buf.len] ^= @truncate(u8, seed >> 2);
            }
            seed = (seed *% 1664525) +% 1013904223;
            let n = buf.len - (@as(usize, seed >> 8) % (buf.len / 2));
            let mut s = decode(buf[..n]) catch continue;
            s.deinit();
        }
    }
}

/// Hostile MP4 files (for tests): 64 chunks that all start at the same four samples, and a
/// sample size table claiming 2^30 + 1 entries (4 times that wraps to 4 in 32 bits).
let REUSE: [10][]u8 = [
    "AAAAEGZ0eXBNNEEgAAAAAAAAAmxtb292AAAAbG12aGQAAAAAAAAAAAAAAAAAAAPoAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAB+HRyYWsAAAHw",
    "bWRpYQAAACBtZGhkAAAAAAAAAAAAAAAAAACsRAAAAAAAAAAAAAAAIGhkbHIAAAAAAAAAAHNvdW4AAAAAAAAAAAAAAAAAAAGo",
    "bWluZgAAAaBzdGJsAAAAWHN0c2QAAAAAAAAAAQAAAEhtcDRhAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAACRlc2Rz",
    "AAAAAAMWAAEABA1AFQAAAAAAAAAAAAAABQISCAAAABRzdHN6AAAAAAAAAAT/////AAAAHHN0c2MAAAAAAAAAAQAAAAEAAAAE",
    "AAAAAQAAARBzdGNvAAAAAAAAAEAAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKE",
    "AAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKE",
    "AAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKE",
    "AAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAChAAAAoQAAAKEAAAAGG1kYXQAyAAH",
    "AMgABwDIAAcAyAAH",
];
let WRAP: [6][]u8 = [
    "AAAAEGZ0eXBNNEEgAAAAAAAAAAptZGF04OAAAAF0bW9vdgAAAGxtdmhkAAAAAAAAAAAAAAAAAAAD6AAAAAAAAAAAAAAAAAAA",
    "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "AQB0cmFrAAAA+G1kaWEAAAAgbWRoZAAAAAAAAAAAAAAAAAAArEQAAAAAAAAAAAAAACBoZGxyAAAAAAAAAABzb3VuAAAAAAAA",
    "AAAAAAAAAAAAsG1pbmYAAACoc3RibAAAAFhzdHNkAAAAAAAAAAEAAABIbXA0YQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "AAAAAAAkZXNkcwAAAAADFgABAAQNQBUAAAAAAAAAAAAAAAUCEhAAAAAcc3RzYwAAAAAAAAABAAAAAQAAAAIAAAABAAAAFHN0",
    "Y28AAAAAAAAAAQAAABgAAAAYc3RzegAAAAAAAAAAQAAAAQAAAAE=",
];

fn from_base64(lines: [][]u8) AacError![]mut u8 {
    let mut text = strs.String.init();
    defer text.deinit();
    for l in lines {
        text.push_str(l) catch return error.OutOfMemory;
    }
    return base64.decode_alloc(text.bytes(), base64.STANDARD) catch return error.Corrupt;
}

fn fails_with(data: []u8, want: AacError) bool {
    let mut s = decode(data) catch |e| return e == want;
    s.deinit();
    return false;
}

test "samples may not share bytes, and tables are checked without wrapping" {
    let reuse = from_base64(REUSE[..])!;
    defer mem.free(reuse);
    @expect(fails_with(reuse, error.Corrupt));
    let wrap = from_base64(WRAP[..])!;
    defer mem.free(wrap);
    @expect(fails_with(wrap, error.Corrupt));
}

test "absent channels are silent, and output is limited" {
    // ADTS frames of 4 blocks in 8 channels (7.1), each block one empty
    // single channel element: the other seven are absent, and silent
    let frame: [23]u8 = [0xff, 0xf1, 0x4d, 0xc0, 0x02, 0xff, 0xff, 0x00, 0xc8, 0x00, 0x07, 0x00, 0xc8, 0x00, 0x07, 0x00,
                         0xc8, 0x00, 0x07, 0x00, 0xc8, 0x00, 0x07];
    let data = mem.alloc.[u8](20 * frame.len)!;
    defer mem.free(data);
    for i in @as(usize, 0)..20 {
        @mem_copy(data[i * frame.len..(i + 1) * frame.len], frame[..]);
    }
    let mut s = decode(data)!;
    defer s.deinit();
    @expect_eq(s.channels, 8);
    @expect_eq(s.frames, 20 * 4 * 1024);
    @expect_eq(s.peak(), 0.0);
    let mut o = Out.init(0)!;
    defer o.deinit();
    o.limit = 3000;
    let block = mem.alloc_zeroed.[f32](2048)!;
    defer mem.free(block);
    emit(&mut o, block, 2, 1024)!;
    let mut refused = false;
    emit(&mut o, block, 2, 1024) catch |e| {
        refused = e == error.TooLarge;
    };
    @expect(refused and (o.frames == 1024));
}

// main.m4a with its edit list rewritten as one version 1 edit (64-bit
// fields), the boxes holding it grown to fit.
fn with_edit(orig: []u8, dur: u64, media_time: u64) ![]mut u8 {
    let e = strs.index_of(orig, "elst")!;
    let d = mem.alloc.[u8](orig.len + 8)!;
    @mem_copy(d[..e + 4], orig[..e + 4]);
    @mem_copy(d[e + 32..], orig[e + 24..]);
    binary.put_u32(d[e + 4..], 0x01000000, binary.Endian.BIG);
    binary.put_u32(d[e + 8..], 1, binary.Endian.BIG);
    binary.put_u64(d[e + 12..], dur, binary.Endian.BIG);
    binary.put_u64(d[e + 20..], media_time, binary.Endian.BIG);
    binary.put_u32(d[e + 28..], 0x00010000, binary.Endian.BIG);
    for typ in ["moov", "trak", "edts", "elst"] {
        let at = (strs.index_of(d[..e + 4], typ)!) - 4;
        binary.put_u32(d[at..], binary.u32_be(d[at..]) + 8, binary.Endian.BIG);
    }
    return d;
}

test "edit lists too long to scale are clamped, not overflowed" {
    let orig = fs.read_file("std/audio/testdata/aac/main.m4a") catch return;
    defer mem.free(orig);
    let mut plain = decode(orig)!;
    defer plain.deinit();
    // a long edit: everything decoded is kept
    let long = with_edit(orig, 1 << 63, 0)!;
    defer mem.free(long);
    let mut s = decode(long)!;
    defer s.deinit();
    @expect(s.frames >= plain.frames);
    // a late start: nothing is
    let late = with_edit(orig, 1 << 62, 1 << 62)!;
    defer mem.free(late);
    let mut t = decode(late)!;
    defer t.deinit();
    @expect_eq(t.frames, 0);
}
