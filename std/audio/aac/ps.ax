// =============================================================================
// std/audio/aac/ps.ax - parametric stereo (HE-AAC v2, ISO/IEC 14496-3
// subpart 8.6.4): the PS bitstream (IID, ICC, IPD/OPD, 10/20/34 bands), the
// hybrid filterbank, decorrelation (all-pass filters, transient
// attenuation) and the stereo mixing. Follows FFmpeg's float decoder
// (libavcodec/aacps.c, aacps_common.c, aacpsdsp_template.c).
// =============================================================================

import "bits.ax" as bitio;
import "tables.ax" as t;

const MAX_NUM_ENV: usize = 5;
const NR: usize = 34;  // PS_MAX_NR_IIDICC
const SLOTS: usize = 32;
const MAX_DELAY: usize = 14;
const AP_LINKS: usize = 3;
const MAX_AP_DELAY: usize = 5;

// codebooks (FFmpeg's order)
const IID_DF1: usize = 0;
const IID_DT1: usize = 1;
const IID_DF0: usize = 2;
const IID_DT0: usize = 3;
const ICC_DF: usize = 4;
const ICC_DT: usize = 5;
const IPD_DF: usize = 6;
const IPD_DT: usize = 7;
const OPD_DF: usize = 8;
const OPD_DT: usize = 9;

let NUM_ENV_TAB: [8]i32 = [0, 1, 2, 4, 1, 2, 3, 4];
let NR_IIDICC_PAR: [6]i32 = [10, 20, 34, 10, 20, 34];
let NR_IIDOPD_PAR: [6]i32 = [5, 11, 17, 5, 11, 17];
let HUFF_IID: [4]usize = [IID_DF0, IID_DF1, IID_DT0, IID_DT1];
let NR_PAR_BANDS: [2]usize = [20, 34];
let NR_IPDOPD_BANDS: [2]usize = [11, 17];
let NR_BANDS: [2]usize = [71, 91];
let DECAY_CUTOFF: [2]i32 = [10, 32];
let NR_ALLPASS_BANDS: [2]usize = [30, 50];
let SHORT_DELAY_BAND: [2]usize = [42, 62];
let G1_Q2: [7]f32 = [0.0, 0.01899487526049, 0.0, -0.07293139167538, 0.0, 0.30596630545168, 0.5];
let AP_A: [3]f32 = [0.65143905753106, 0.56471812200776, 0.48954165955695];

fn us(v: i32) usize {
    return @as(usize, @bit_cast(u32, v));
}

fn bi(b: bool) usize {
    if b {
        return 1;
    }
    return 0;
}

fn si(v: usize) i32 {
    return @bit_cast(i32, @truncate(u32, v));
}

pub struct Common {
    start: bool,
    enable_iid: bool,
    iid_quant: i32,
    nr_iid_par: i32,
    nr_ipdopd_par: i32,
    enable_icc: bool,
    icc_mode: i32,
    nr_icc_par: i32,
    enable_ext: bool,
    frame_class: i32,
    num_env_old: i32,
    num_env: i32,
    enable_ipdopd: bool,
    border_position: [6]i32,
    iid_par: [5][34]i32,
    icc_par: [5][34]i32,
    ipd_par: [5][34]i32,
    opd_par: [5][34]i32,
    is34bands: bool,
    is34bands_old: bool,
}

pub struct Ps {
    common: Common,
    in_buf: [5][44][2]f32,
    delay: [91][46][2]f32,
    ap_delay: [50][3][37][2]f32,
    peak_decay_nrg: [34]f32,
    power_smooth: [34]f32,
    peak_decay_diff_smooth: [34]f32,
    h11: [2][6][34]f32,
    h12: [2][6][34]f32,
    h21: [2][6][34]f32,
    h22: [2][6][34]f32,
    lbuf: [91][32][2]f32,
    rbuf: [91][32][2]f32,
    opd_hist: [34]i32,
    ipd_hist: [34]i32,
}

// -----------------------------------------------------------------------------
// The bitstream
// -----------------------------------------------------------------------------

/// kind: 0 iid, 1 icc, 2 ipd/opd. False on an illegal value.
fn read_par(ps: *mut Common, b: *mut bitio.Bits, h: *bitio.Huff, par: *mut [5][34]i32, book: usize, e: usize, dt: bool,
            kind: i32) bool {
    let mut num = ps.nr_iid_par;
    if kind == 1 {
        num = ps.nr_icc_par;
    } else if kind == 2 {
        num = ps.nr_ipdopd_par;
    }
    let mut offset: i32 = 0;
    if kind != 2 {
        offset = @as(i32, t.PS_HUFF_OFFSET[book]);
    }
    let mut e_prev: i32 = si(e) - 1;
    if e == 0 {
        e_prev = ps.num_env_old - 1;
    }
    e_prev = @max(e_prev, 0);
    let mut val: i32 = 0;
    for bb in @as(usize, 0)..us(num) {
        let sym = bitio.decode(h, book, b);
        if sym < 0 {
            return false;
        }
        if dt {
            val = par[us(e_prev)][bb] + (sym - offset);
        } else {
            val += sym - offset;
        }
        if kind == 2 {
            val &= 7;
        }
        par[e][bb] = val;
        if kind == 0 {
            if @abs(val) > (7 + (8 * ps.iid_quant)) {
                return false;
            }
        } else if kind == 1 {
            if (val < 0) or (val > 7) {
                return false;
            }
        }
    }
    return true;
}

fn read_extension(ps: *mut Common, b: *mut bitio.Bits, h: *bitio.Huff, id: u32) i32 {
    let start = b.pos;
    if id != 0 {
        return 0;
    }
    ps.enable_ipdopd = b.get1() != 0;
    if ps.enable_ipdopd {
        for e in @as(usize, 0)..us(ps.num_env) {
            let mut dt = b.get1() != 0;
            let mut book = IPD_DF;
            if dt {
                book = IPD_DT;
            }
            _ = read_par(ps, b, h, &mut ps.ipd_par, book, e, dt, 2);
            dt = b.get1() != 0;
            book = OPD_DF;
            if dt {
                book = OPD_DT;
            }
            _ = read_par(ps, b, h, &mut ps.opd_par, book, e, dt, 2);
        }
    }
    b.skip(1);
    return si(b.pos - start);
}

fn clear_pars(ps: *mut Common) void {
    ps.iid_par = [[0; 34]; 5];
    ps.icc_par = [[0; 34]; 5];
    ps.ipd_par = [[0; 34]; 5];
    ps.opd_par = [[0; 34]; 5];
}

fn read_body(ps: *mut Common, b: *mut bitio.Bits, h: *bitio.Huff, header: bool) bool {
    if header {
        ps.enable_iid = b.get1() != 0;
        if ps.enable_iid {
            let mode = b.geti(3);
            if mode > 5 {
                return false;
            }
            ps.nr_iid_par = NR_IIDICC_PAR[us(mode)];
            ps.iid_quant = 0;
            if mode > 2 {
                ps.iid_quant = 1;
            }
            ps.nr_ipdopd_par = NR_IIDOPD_PAR[us(mode)];
        }
        ps.enable_icc = b.get1() != 0;
        if ps.enable_icc {
            ps.icc_mode = b.geti(3);
            if ps.icc_mode > 5 {
                return false;
            }
            ps.nr_icc_par = NR_IIDICC_PAR[us(ps.icc_mode)];
        }
        ps.enable_ext = b.get1() != 0;
    }
    ps.frame_class = b.geti(1);
    ps.num_env_old = ps.num_env;
    ps.num_env = NUM_ENV_TAB[us((ps.frame_class * 4) + b.geti(2))];
    ps.border_position[0] = -1;
    if ps.frame_class != 0 {
        for e in @as(usize, 1)..(us(ps.num_env) + 1) {
            ps.border_position[e] = b.geti(5);
            if ps.border_position[e] < ps.border_position[e - 1] {
                return false;
            }
        }
    } else {
        let log2: [5]u32 = [0, 0, 1, 1, 2];
        for e in @as(usize, 1)..(us(ps.num_env) + 1) {
            ps.border_position[e] = ((si(e) * 32) >> log2[us(ps.num_env)]) - 1;
        }
    }
    if ps.enable_iid {
        for e in @as(usize, 0)..us(ps.num_env) {
            let dt = b.get1() != 0;
            let mut k = us(ps.iid_quant);
            if dt {
                k += 2;
            }
            if not read_par(ps, b, h, &mut ps.iid_par, HUFF_IID[k], e, dt, 0) {
                return false;
            }
        }
    } else {
        ps.iid_par = [[0; 34]; 5];
    }
    if ps.enable_icc {
        for e in @as(usize, 0)..us(ps.num_env) {
            let dt = b.get1() != 0;
            let mut book = ICC_DF;
            if dt {
                book = ICC_DT;
            }
            if not read_par(ps, b, h, &mut ps.icc_par, book, e, dt, 1) {
                return false;
            }
        }
    } else {
        ps.icc_par = [[0; 34]; 5];
    }
    if ps.enable_ext {
        let mut cnt = b.geti(4);
        if cnt == 15 {
            cnt += b.geti(8);
        }
        cnt *= 8;
        while cnt > 7 {
            let id = b.get(2);
            cnt -= 2 + read_extension(ps, b, h, id);
        }
        if cnt < 0 {
            return false;
        }
        b.skip(us(cnt));
    }
    // fix up the envelopes
    if (ps.num_env == 0) or (ps.border_position[us(ps.num_env)] < 31) {
        let mut source = ps.num_env_old - 1;
        if ps.num_env != 0 {
            source = ps.num_env - 1;
        }
        let ne = us(ps.num_env);
        if (source >= 0) and (source != ps.num_env) {
            let sr = us(source);
            if ps.enable_iid {
                ps.iid_par[ne] = ps.iid_par[sr];
            }
            if ps.enable_icc {
                ps.icc_par[ne] = ps.icc_par[sr];
            }
            if ps.enable_ipdopd {
                ps.ipd_par[ne] = ps.ipd_par[sr];
                ps.opd_par[ne] = ps.opd_par[sr];
            }
        }
        if ps.enable_iid {
            for bb in @as(usize, 0)..us(ps.nr_iid_par) {
                if @abs(ps.iid_par[ne][bb]) > (7 + (8 * ps.iid_quant)) {
                    return false;
                }
            }
        }
        if ps.enable_icc {
            for bb in @as(usize, 0)..us(ps.nr_iid_par) {
                if (ps.icc_par[ne][bb] < 0) or (ps.icc_par[ne][bb] > 7) {
                    return false;
                }
            }
        }
        ps.num_env += 1;
        ps.border_position[us(ps.num_env)] = 31;
    }
    ps.is34bands_old = ps.is34bands;
    if ps.enable_iid or ps.enable_icc {
        ps.is34bands = (ps.enable_iid and (ps.nr_iid_par == 34)) or (ps.enable_icc and (ps.nr_icc_par == 34));
    }
    if not ps.enable_ipdopd {
        ps.ipd_par = [[0; 34]; 5];
        ps.opd_par = [[0; 34]; 5];
    }
    if header {
        ps.start = true;
    }
    return true;
}

/// Reads PS data (at most bits_left bits) from b; returns the bits used.
pub fn read_data(ps: *mut Common, b: *mut bitio.Bits, bits_left: i32, h: *bitio.Huff) i32 {
    let mut g = b.*;
    let start = g.pos;
    let header = g.get1() != 0;
    if read_body(ps, &mut g, h, header) {
        let used = si(g.pos - start);
        if used <= bits_left {
            b.skip(us(used));
            return used;
        }
    }
    ps.start = false;
    b.skip(us(@max(bits_left, 0)));
    clear_pars(ps);
    return bits_left;
}

// -----------------------------------------------------------------------------
// Hybrid filterbank
// -----------------------------------------------------------------------------

/// One output band per filter, from 13 input samples at in_[io..].
fn hybrid_filter(inb: *[44][2]f32, io: usize, filter: []f32, band: usize) [2]f32 {
    let mut inre0: [6]f32 = [0.0; 6];
    let mut inre1: [6]f32 = [0.0; 6];
    let mut inim0: [6]f32 = [0.0; 6];
    let mut inim1: [6]f32 = [0.0; 6];
    for j in @as(usize, 0)..6 {
        inre0[j] = inb[io + j][0] + inb[(io + 12) - j][0];
        inre1[j] = inb[io + j][1] - inb[(io + 12) - j][1];
        inim0[j] = inb[io + j][1] + inb[(io + 12) - j][1];
        inim1[j] = inb[io + j][0] - inb[(io + 12) - j][0];
    }
    let f = band * 16;
    let mut sum_re = filter[f + 12] * inb[io + 6][0];
    let mut sum_im = filter[f + 12] * inb[io + 6][1];
    for j in @as(usize, 0)..6 {
        sum_re += (filter[f + (2 * j)] * inre0[j]) - (filter[f + (2 * j) + 1] * inre1[j]);
        sum_im += (filter[f + (2 * j)] * inim0[j]) + (filter[f + (2 * j) + 1] * inim1[j]);
    }
    return [sum_re, sum_im];
}

fn hybrid_analysis(ps: *mut Ps, x: *[2][2][38][64]f32, is34: bool) void {
    for i in @as(usize, 0)..5 {
        for j in @as(usize, 0)..38 {
            ps.in_buf[i][j + 6][0] = x[0][0][j][i];
            ps.in_buf[i][j + 6][1] = x[0][1][j][i];
        }
    }
    if is34 {
        for i in @as(usize, 0)..SLOTS {
            for q in @as(usize, 0)..12 {
                ps.lbuf[q][i] = hybrid_filter(&ps.in_buf[0], i, t.PS_F34_0_12[..], q);
            }
            for q in @as(usize, 0)..8 {
                ps.lbuf[12 + q][i] = hybrid_filter(&ps.in_buf[1], i, t.PS_F34_1_8[..], q);
            }
            for q in @as(usize, 0)..4 {
                ps.lbuf[20 + q][i] = hybrid_filter(&ps.in_buf[2], i, t.PS_F34_2_4[..], q);
                ps.lbuf[24 + q][i] = hybrid_filter(&ps.in_buf[3], i, t.PS_F34_2_4[..], q);
                ps.lbuf[28 + q][i] = hybrid_filter(&ps.in_buf[4], i, t.PS_F34_2_4[..], q);
            }
        }
        for i in @as(usize, 5)..64 {
            for j in @as(usize, 0)..SLOTS {
                ps.lbuf[27 + i][j] = [x[0][0][j][i], x[0][1][j][i]];
            }
        }
    } else {
        for i in @as(usize, 0)..SLOTS {
            let mut temp: [8][2]f32 = [[0.0; 2]; 8];
            for q in @as(usize, 0)..8 {
                temp[q] = hybrid_filter(&ps.in_buf[0], i, t.PS_F20_0_8[..], q);
            }
            ps.lbuf[0][i] = temp[6];
            ps.lbuf[1][i] = temp[7];
            ps.lbuf[2][i] = temp[0];
            ps.lbuf[3][i] = temp[1];
            ps.lbuf[4][i] = [temp[2][0] + temp[5][0], temp[2][1] + temp[5][1]];
            ps.lbuf[5][i] = [temp[3][0] + temp[4][0], temp[3][1] + temp[4][1]];
        }
        // two real bands each from QMF bands 1 and 2
        for pair in @as(usize, 0)..2 {
            let inb = &ps.in_buf[1 + pair];
            let o = 6 + (2 * pair);
            let rev = 1 - pair;  // band 1 is reversed
            for i in @as(usize, 0)..SLOTS {
                let re_in = G1_Q2[6] * inb[i + 6][0];
                let im_in = G1_Q2[6] * inb[i + 6][1];
                let mut re_op: f32 = 0.0;
                let mut im_op: f32 = 0.0;
                let mut j: usize = 0;
                while j < 6 {
                    re_op += G1_Q2[j + 1] * (inb[i + j + 1][0] + inb[(i + 12) - j - 1][0]);
                    im_op += G1_Q2[j + 1] * (inb[i + j + 1][1] + inb[(i + 12) - j - 1][1]);
                    j += 2;
                }
                ps.lbuf[o + rev][i] = [re_in + re_op, im_in + im_op];
                ps.lbuf[(o + 1) - rev][i] = [re_in - re_op, im_in - im_op];
            }
        }
        for i in @as(usize, 3)..64 {
            for j in @as(usize, 0)..SLOTS {
                ps.lbuf[7 + i][j] = [x[0][0][j][i], x[0][1][j][i]];
            }
        }
    }
    for i in @as(usize, 0)..5 {
        for j in @as(usize, 0)..6 {
            ps.in_buf[i][j] = ps.in_buf[i][32 + j];
        }
    }
}

fn hybrid_synthesis(out: *mut [2][38][64]f32, inb: *[91][32][2]f32, is34: bool) void {
    if is34 {
        for n in @as(usize, 0)..SLOTS {
            for k in @as(usize, 0)..5 {
                out[0][n][k] = 0.0;
                out[1][n][k] = 0.0;
            }
            for i in @as(usize, 0)..12 {
                out[0][n][0] += inb[i][n][0];
                out[1][n][0] += inb[i][n][1];
            }
            for i in @as(usize, 0)..8 {
                out[0][n][1] += inb[12 + i][n][0];
                out[1][n][1] += inb[12 + i][n][1];
            }
            for i in @as(usize, 0)..4 {
                out[0][n][2] += inb[20 + i][n][0];
                out[1][n][2] += inb[20 + i][n][1];
                out[0][n][3] += inb[24 + i][n][0];
                out[1][n][3] += inb[24 + i][n][1];
                out[0][n][4] += inb[28 + i][n][0];
                out[1][n][4] += inb[28 + i][n][1];
            }
        }
        for i in @as(usize, 5)..64 {
            for n in @as(usize, 0)..SLOTS {
                out[0][n][i] = inb[27 + i][n][0];
                out[1][n][i] = inb[27 + i][n][1];
            }
        }
    } else {
        for n in @as(usize, 0)..SLOTS {
            for c in @as(usize, 0)..2 {
                out[c][n][0] = ((((inb[0][n][c] + inb[1][n][c]) + inb[2][n][c]) + inb[3][n][c]) + inb[4][n][c]) +
                               inb[5][n][c];
                out[c][n][1] = inb[6][n][c] + inb[7][n][c];
                out[c][n][2] = inb[8][n][c] + inb[9][n][c];
            }
        }
        for i in @as(usize, 3)..64 {
            for n in @as(usize, 0)..SLOTS {
                out[0][n][i] = inb[7 + i][n][0];
                out[1][n][i] = inb[7 + i][n][1];
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Decorrelation
// -----------------------------------------------------------------------------

fn k_to_i(is34: bool, k: usize) usize {
    if is34 {
        return @as(usize, @bit_cast(u8, t.PS_K_TO_I_34[k]));
    }
    return @as(usize, @bit_cast(u8, t.PS_K_TO_I_20[k]));
}

fn decorrelation(ps: *mut Ps, is34: bool) void {
    let mut power: [34][32]f32 = [[0.0; 32]; 34];
    let mut transient_gain: [34][32]f32 = [[0.0; 32]; 34];
    let peak_decay_factor: f32 = 0.76592833836465;
    let a_smooth: f32 = 0.25;
    let transient_impact: f32 = 1.5;
    let i34 = bi(is34);
    if is34 != ps.common.is34bands_old {
        ps.peak_decay_nrg = [0.0; 34];
        ps.power_smooth = [0.0; 34];
        ps.peak_decay_diff_smooth = [0.0; 34];
        for k in @as(usize, 0)..91 {
            for n in @as(usize, 0)..46 {
                ps.delay[k][n] = [0.0, 0.0];
            }
        }
        for k in @as(usize, 0)..50 {
            for m in @as(usize, 0)..3 {
                for n in @as(usize, 0)..37 {
                    ps.ap_delay[k][m][n] = [0.0, 0.0];
                }
            }
        }
    }
    for k in @as(usize, 0)..NR_BANDS[i34] {
        let i = k_to_i(is34, k);
        for n in @as(usize, 0)..SLOTS {
            let v = ps.lbuf[k][n];
            power[i][n] += (v[0] * v[0]) + (v[1] * v[1]);
        }
    }
    for i in @as(usize, 0)..NR_PAR_BANDS[i34] {
        for n in @as(usize, 0)..SLOTS {
            let decayed = peak_decay_factor * ps.peak_decay_nrg[i];
            ps.peak_decay_nrg[i] = @max(decayed, power[i][n]);
            ps.power_smooth[i] += a_smooth * (power[i][n] - ps.power_smooth[i]);
            ps.peak_decay_diff_smooth[i] += a_smooth *
                                            ((ps.peak_decay_nrg[i] - power[i][n]) - ps.peak_decay_diff_smooth[i]);
            let denom = transient_impact * ps.peak_decay_diff_smooth[i];
            if denom > ps.power_smooth[i] {
                transient_gain[i][n] = ps.power_smooth[i] / denom;
            } else {
                transient_gain[i][n] = 1.0;
            }
        }
    }
    let mut k: usize = 0;
    while k < NR_ALLPASS_BANDS[i34] {
        let b = k_to_i(is34, k);
        let mut g_decay_slope: f32 = 1.0 - (0.05 * @float_from_int(f32, si(k) - DECAY_CUTOFF[i34]));
        g_decay_slope = @min(@max(g_decay_slope, 0.0), 1.0);
        shift_delay(ps, k);
        for m in @as(usize, 0)..AP_LINKS {
            for n in @as(usize, 0)..MAX_AP_DELAY {
                ps.ap_delay[k][m][n] = ps.ap_delay[k][m][SLOTS + n];
            }
        }
        // decorrelate
        let mut ag: [3]f32 = [0.0; 3];
        for m in @as(usize, 0)..AP_LINKS {
            ag[m] = AP_A[m] * g_decay_slope;
        }
        let pf = (((i34 * 50) + k) * 2);
        let phi0 = t.PS_PHI_FRACT[pf];
        let phi1 = t.PS_PHI_FRACT[pf + 1];
        let qf = ((i34 * 50) + k) * 6;
        for n in @as(usize, 0)..SLOTS {
            let dl = ps.delay[k][(MAX_DELAY - 2) + n];
            let mut in_re = (dl[0] * phi0) - (dl[1] * phi1);
            let mut in_im = (dl[0] * phi1) + (dl[1] * phi0);
            for m in @as(usize, 0)..AP_LINKS {
                let a_re = ag[m] * in_re;
                let a_im = ag[m] * in_im;
                let link = ps.ap_delay[k][m][(n + 2) - m];
                let fd_re = t.PS_Q_FRACT_ALLPASS[qf + (2 * m)];
                let fd_im = t.PS_Q_FRACT_ALLPASS[qf + (2 * m) + 1];
                let apd_re = in_re;
                let apd_im = in_im;
                in_re = (link[0] * fd_re) - (link[1] * fd_im);
                in_re -= a_re;
                in_im = (link[0] * fd_im) + (link[1] * fd_re);
                in_im -= a_im;
                ps.ap_delay[k][m][n + 5] = [apd_re + (ag[m] * in_re), apd_im + (ag[m] * in_im)];
            }
            ps.rbuf[k][n] = [transient_gain[b][n] * in_re, transient_gain[b][n] * in_im];
        }
        k += 1;
    }
    while k < SHORT_DELAY_BAND[i34] {
        let i = k_to_i(is34, k);
        shift_delay(ps, k);
        for n in @as(usize, 0)..SLOTS {
            let dl = ps.delay[k][n];
            ps.rbuf[k][n] = [dl[0] * transient_gain[i][n], dl[1] * transient_gain[i][n]];
        }
        k += 1;
    }
    while k < NR_BANDS[i34] {
        let i = k_to_i(is34, k);
        shift_delay(ps, k);
        for n in @as(usize, 0)..SLOTS {
            let dl = ps.delay[k][(MAX_DELAY - 1) + n];
            ps.rbuf[k][n] = [dl[0] * transient_gain[i][n], dl[1] * transient_gain[i][n]];
        }
        k += 1;
    }
}

fn shift_delay(ps: *mut Ps, k: usize) void {
    for n in @as(usize, 0)..MAX_DELAY {
        ps.delay[k][n] = ps.delay[k][SLOTS + n];
    }
    for n in @as(usize, 0)..SLOTS {
        ps.delay[k][MAX_DELAY + n] = ps.lbuf[k][n];
    }
}

// -----------------------------------------------------------------------------
// Stereo processing
// -----------------------------------------------------------------------------

fn map_idx_10_to_20(out: *mut [34]i32, par: *[34]i32, full: bool) void {
    let mut b: i32 = 4;
    if full {
        b = 9;
    } else {
        out[10] = 0;
    }
    while b >= 0 {
        let v = par[us(b)];
        out[us((2 * b) + 1)] = v;
        out[us(2 * b)] = v;
        b -= 1;
    }
}

fn map_idx_34_to_20(out: *mut [34]i32, p: *[34]i32, full: bool) void {
    out[0] = ((2 * p[0]) + p[1]) / 3;
    out[1] = (p[1] + (2 * p[2])) / 3;
    out[2] = ((2 * p[3]) + p[4]) / 3;
    out[3] = (p[4] + (2 * p[5])) / 3;
    out[4] = (p[6] + p[7]) / 2;
    out[5] = (p[8] + p[9]) / 2;
    out[6] = p[10];
    out[7] = p[11];
    out[8] = (p[12] + p[13]) / 2;
    out[9] = (p[14] + p[15]) / 2;
    out[10] = p[16];
    if full {
        out[11] = p[17];
        out[12] = p[18];
        out[13] = p[19];
        out[14] = (p[20] + p[21]) / 2;
        out[15] = (p[22] + p[23]) / 2;
        out[16] = (p[24] + p[25]) / 2;
        out[17] = (p[26] + p[27]) / 2;
        out[18] = (((p[28] + p[29]) + p[30]) + p[31]) / 4;
        out[19] = (p[32] + p[33]) / 2;
    }
}

let MAP_10_TO_34: [34]u8 = [0, 0, 0, 1, 1, 1, 2, 2, 2, 2, 3, 3, 4, 4, 4, 4, 5, 5, 6, 6, 7, 7, 7, 7, 8, 8, 8, 8, 9, 9, 9,
                            9, 9, 9];

fn map_idx_10_to_34(out: *mut [34]i32, p: *[34]i32, full: bool) void {
    let mut n: usize = 16;
    if full {
        n = 34;
    } else {
        out[16] = 0;
    }
    for i in @as(usize, 0)..n {
        out[i] = p[@as(usize, MAP_10_TO_34[i])];
    }
}

let MAP_20_TO_34: [34]u8 = [0, 0, 1, 2, 0, 3, 4, 4, 5, 5, 6, 7, 8, 8, 9, 9, 10, 11, 12, 13, 14, 14, 15, 15, 16, 16, 17,
                            17, 18, 18, 18, 18, 19, 19];

fn map_idx_20_to_34(out: *mut [34]i32, p: *[34]i32, full: bool) void {
    let mut n: usize = 17;
    if full {
        n = 34;
    }
    for i in @as(usize, 0)..n {
        out[i] = p[@as(usize, MAP_20_TO_34[i])];
    }
    out[1] = (p[0] + p[1]) / 2;
    out[4] = (p[2] + p[3]) / 2;
}

fn map_val_34_to_20(p: *mut [34]f32) void {
    p[0] = ((2.0 * p[0]) + p[1]) * 0.33333333;
    p[1] = (p[1] + (2.0 * p[2])) * 0.33333333;
    p[2] = ((2.0 * p[3]) + p[4]) * 0.33333333;
    p[3] = (p[4] + (2.0 * p[5])) * 0.33333333;
    p[4] = (p[6] + p[7]) * 0.5;
    p[5] = (p[8] + p[9]) * 0.5;
    p[6] = p[10];
    p[7] = p[11];
    p[8] = (p[12] + p[13]) * 0.5;
    p[9] = (p[14] + p[15]) * 0.5;
    p[10] = p[16];
    p[11] = p[17];
    p[12] = p[18];
    p[13] = p[19];
    p[14] = (p[20] + p[21]) * 0.5;
    p[15] = (p[22] + p[23]) * 0.5;
    p[16] = (p[24] + p[25]) * 0.5;
    p[17] = (p[26] + p[27]) * 0.5;
    p[18] = (((p[28] + p[29]) + p[30]) + p[31]) * 0.25;
    p[19] = (p[32] + p[33]) * 0.5;
}

fn map_val_20_to_34(p: *mut [34]f32) void {
    p[33] = p[19];
    p[32] = p[19];
    p[31] = p[18];
    p[30] = p[18];
    p[29] = p[18];
    p[28] = p[18];
    p[27] = p[17];
    p[26] = p[17];
    p[25] = p[16];
    p[24] = p[16];
    p[23] = p[15];
    p[22] = p[15];
    p[21] = p[14];
    p[20] = p[14];
    p[19] = p[13];
    p[18] = p[12];
    p[17] = p[11];
    p[16] = p[10];
    p[15] = p[9];
    p[14] = p[9];
    p[13] = p[8];
    p[12] = p[8];
    p[11] = p[7];
    p[10] = p[6];
    p[9] = p[5];
    p[8] = p[5];
    p[7] = p[4];
    p[6] = p[4];
    p[5] = p[3];
    p[4] = (p[2] + p[3]) * 0.5;
    p[3] = p[2];
    p[2] = p[1];
    p[1] = (p[0] + p[1]) * 0.5;
}

/// The parameters remapped to the processing's band count (in place of
/// FFmpeg's remap20/remap34).
fn remap(out: *mut [5][34]i32, par: *[5][34]i32, num_par: i32, num_env: i32, full: bool, is34: bool) void {
    for e in @as(usize, 0)..us(num_env) {
        if is34 {
            if (num_par == 20) or (num_par == 11) {
                map_idx_20_to_34(&mut out[e], &par[e], full);
            } else if (num_par == 10) or (num_par == 5) {
                map_idx_10_to_34(&mut out[e], &par[e], full);
            } else {
                out[e] = par[e];
            }
        } else if (num_par == 34) or (num_par == 17) {
            map_idx_34_to_20(&mut out[e], &par[e], full);
        } else if (num_par == 10) or (num_par == 5) {
            map_idx_10_to_20(&mut out[e], &par[e], full);
        } else {
            out[e] = par[e];
        }
    }
}

fn stereo_processing(ps: *mut Ps, is34: bool) void {
    let c = &mut ps.common;
    let i34 = bi(is34);
    let mut iid_m: [5][34]i32 = [[0; 34]; 5];
    let mut icc_m: [5][34]i32 = [[0; 34]; 5];
    let mut ipd_m: [5][34]i32 = [[0; 34]; 5];
    let mut opd_m: [5][34]i32 = [[0; 34]; 5];
    let use_hb = c.icc_mode >= 3;
    if c.num_env_old != 0 {
        let o = us(c.num_env_old);
        for q in @as(usize, 0)..2 {
            ps.h11[q][0] = ps.h11[q][o];
            ps.h12[q][0] = ps.h12[q][o];
            ps.h21[q][0] = ps.h21[q][o];
            ps.h22[q][0] = ps.h22[q][o];
        }
    }
    remap(&mut iid_m, &c.iid_par, c.nr_iid_par, c.num_env, true, is34);
    remap(&mut icc_m, &c.icc_par, c.nr_icc_par, c.num_env, true, is34);
    if c.enable_ipdopd {
        remap(&mut ipd_m, &c.ipd_par, c.nr_ipdopd_par, c.num_env, false, is34);
        remap(&mut opd_m, &c.opd_par, c.nr_ipdopd_par, c.num_env, false, is34);
    }
    if is34 != c.is34bands_old {
        for q in @as(usize, 0)..2 {
            if is34 {
                map_val_20_to_34(&mut ps.h11[q][0]);
                map_val_20_to_34(&mut ps.h12[q][0]);
                map_val_20_to_34(&mut ps.h21[q][0]);
                map_val_20_to_34(&mut ps.h22[q][0]);
            } else {
                map_val_34_to_20(&mut ps.h11[q][0]);
                map_val_34_to_20(&mut ps.h12[q][0]);
                map_val_34_to_20(&mut ps.h21[q][0]);
                map_val_34_to_20(&mut ps.h22[q][0]);
            }
        }
        ps.ipd_hist = [0; 34];
        ps.opd_hist = [0; 34];
    }
    for e in @as(usize, 0)..us(c.num_env) {
        for b in @as(usize, 0)..NR_PAR_BANDS[i34] {
            let row = us(iid_m[e][b] + 7 + (23 * c.iid_quant));
            let li = (((row * 8) + us(icc_m[e][b])) * 4);
            let mut h11: f32 = 0.0;
            let mut h12: f32 = 0.0;
            let mut h21: f32 = 0.0;
            let mut h22: f32 = 0.0;
            if use_hb {
                h11 = t.PS_HB[li];
                h12 = t.PS_HB[li + 1];
                h21 = t.PS_HB[li + 2];
                h22 = t.PS_HB[li + 3];
            } else {
                h11 = t.PS_HA[li];
                h12 = t.PS_HA[li + 1];
                h21 = t.PS_HA[li + 2];
                h22 = t.PS_HA[li + 3];
            }
            if c.enable_ipdopd and (b < NR_IPDOPD_BANDS[i34]) {
                let opd_idx = us((ps.opd_hist[b] * 8) + opd_m[e][b]);
                let ipd_idx = us((ps.ipd_hist[b] * 8) + ipd_m[e][b]);
                let opd_re = t.PS_PD_RE_SMOOTH[opd_idx];
                let opd_im = t.PS_PD_IM_SMOOTH[opd_idx];
                let ipd_re = t.PS_PD_RE_SMOOTH[ipd_idx];
                let ipd_im = t.PS_PD_IM_SMOOTH[ipd_idx];
                ps.opd_hist[b] = si(opd_idx & 0x3f);
                ps.ipd_hist[b] = si(ipd_idx & 0x3f);
                let ipd_adj_re = (opd_re * ipd_re) + (opd_im * ipd_im);
                let ipd_adj_im = (opd_im * ipd_re) - (opd_re * ipd_im);
                let h11i = h11 * opd_im;
                h11 = h11 * opd_re;
                let h12i = h12 * ipd_adj_im;
                h12 = h12 * ipd_adj_re;
                let h21i = h21 * opd_im;
                h21 = h21 * opd_re;
                let h22i = h22 * ipd_adj_im;
                h22 = h22 * ipd_adj_re;
                ps.h11[1][e + 1][b] = h11i;
                ps.h12[1][e + 1][b] = h12i;
                ps.h21[1][e + 1][b] = h21i;
                ps.h22[1][e + 1][b] = h22i;
            }
            ps.h11[0][e + 1][b] = h11;
            ps.h12[0][e + 1][b] = h12;
            ps.h21[0][e + 1][b] = h21;
            ps.h22[0][e + 1][b] = h22;
        }
        let start = c.border_position[e];
        let stop = c.border_position[e + 1];
        let len = stop - start;
        let mut wd = len;
        if wd == 0 {
            wd = 1;
        }
        let width = 1.0 / @float_from_int(f32, wd);
        for k in @as(usize, 0)..NR_BANDS[i34] {
            let b = k_to_i(is34, k);
            let mut h: [2][4]f32 = [[0.0; 4]; 2];
            let mut hs: [2][4]f32 = [[0.0; 4]; 2];
            h[0] = [ps.h11[0][e][b], ps.h12[0][e][b], ps.h21[0][e][b], ps.h22[0][e][b]];
            if c.enable_ipdopd {
                let neg = (is34 and (k <= 13) and (k >= 9)) or (not is34 and (k <= 1));
                h[1] = [ps.h11[1][e][b], ps.h12[1][e][b], ps.h21[1][e][b], ps.h22[1][e][b]];
                if neg {
                    for q in @as(usize, 0)..4 {
                        h[1][q] = -h[1][q];
                    }
                }
            }
            hs[0] = [(ps.h11[0][e + 1][b] - h[0][0]) * width, (ps.h12[0][e + 1][b] - h[0][1]) * width,
                     (ps.h21[0][e + 1][b] - h[0][2]) * width, (ps.h22[0][e + 1][b] - h[0][3]) * width];
            if c.enable_ipdopd {
                hs[1] = [(ps.h11[1][e + 1][b] - h[1][0]) * width, (ps.h12[1][e + 1][b] - h[1][1]) * width,
                         (ps.h21[1][e + 1][b] - h[1][2]) * width, (ps.h22[1][e + 1][b] - h[1][3]) * width];
            }
            if len != 0 {
                let base = us(start + 1);
                if c.enable_ipdopd {
                    let mut h00 = h[0][0];
                    let mut h01 = h[0][1];
                    let mut h02 = h[0][2];
                    let mut h03 = h[0][3];
                    let mut h10 = h[1][0];
                    let mut h11 = h[1][1];
                    let mut h12 = h[1][2];
                    let mut h13 = h[1][3];
                    for n in @as(usize, 0)..us(len) {
                        let l = ps.lbuf[k][base + n];
                        let r = ps.rbuf[k][base + n];
                        h00 += hs[0][0];
                        h01 += hs[0][1];
                        h02 += hs[0][2];
                        h03 += hs[0][3];
                        h10 += hs[1][0];
                        h11 += hs[1][1];
                        h12 += hs[1][2];
                        h13 += hs[1][3];
                        ps.lbuf[k][base + n] = [(((h00 * l[0]) + (h02 * r[0])) - (h10 * l[1])) - (h12 * r[1]),
                                                (((h00 * l[1]) + (h02 * r[1])) + (h10 * l[0])) + (h12 * r[0])];
                        ps.rbuf[k][base + n] = [(((h01 * l[0]) + (h03 * r[0])) - (h11 * l[1])) - (h13 * r[1]),
                                                (((h01 * l[1]) + (h03 * r[1])) + (h11 * l[0])) + (h13 * r[0])];
                    }
                } else {
                    let mut h0 = h[0][0];
                    let mut h1 = h[0][1];
                    let mut h2 = h[0][2];
                    let mut h3 = h[0][3];
                    for n in @as(usize, 0)..us(len) {
                        let l = ps.lbuf[k][base + n];
                        let r = ps.rbuf[k][base + n];
                        h0 += hs[0][0];
                        h1 += hs[0][1];
                        h2 += hs[0][2];
                        h3 += hs[0][3];
                        ps.lbuf[k][base + n] = [(h0 * l[0]) + (h2 * r[0]), (h0 * l[1]) + (h2 * r[1])];
                        ps.rbuf[k][base + n] = [(h1 * l[0]) + (h3 * r[0]), (h1 * l[1]) + (h3 * r[1])];
                    }
                }
            }
        }
    }
}

/// Makes the right channel x[1] from the left x[0] (QMF domain, [re/im][time][band]).
pub fn apply(ps: *mut Ps, x: *mut [2][2][38][64]f32, top0: i32) void {
    let is34 = ps.common.is34bands;
    let i34 = bi(is34);
    let top = us(@max(top0 + (si(NR_BANDS[i34]) - 64), 0));
    for k in top..NR_BANDS[i34] {
        for n in @as(usize, 0)..46 {
            ps.delay[k][n] = [0.0, 0.0];
        }
    }
    if top < NR_ALLPASS_BANDS[i34] {
        for k in top..NR_ALLPASS_BANDS[i34] {
            for m in @as(usize, 0)..3 {
                for n in @as(usize, 0)..37 {
                    ps.ap_delay[k][m][n] = [0.0, 0.0];
                }
            }
        }
    }
    hybrid_analysis(ps, x, is34);
    decorrelation(ps, is34);
    stereo_processing(ps, is34);
    hybrid_synthesis(&mut x[0], &ps.lbuf, is34);
    hybrid_synthesis(&mut x[1], &ps.rbuf, is34);
}
