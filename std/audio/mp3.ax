// =============================================================================
// std/audio/mp3.ax - MP3 decoding: MPEG-1, MPEG-2 and MPEG-2.5 audio layer III.
//
//     let mut s = mp3.decode(bytes)!;   // F32 samples
//     defer s.deinit();
//
// Decodes every layer III stream: all bit rates (constant and variable) and
// sample rates, mono, stereo, dual channel and joint stereo (mid/side and
// intensity), long, short and mixed blocks, the bit reservoir. ID3v2 and
// ID3v1 tags are skipped. A Xing/Info frame with LAME's gapless-playback
// fields trims the encoder's delay and padding, so the output has the
// original length. Layers I and II and free-format streams are not
// supported.
// =============================================================================

import "../audio.ax" as audio;
import "../encoding/base64.ax" as base64;
import "../encoding/binary.ax" as binary;
import "../math.ax" as math;
import "../mem.ax" as mem;
import "../str.ax" as strs;
import "../sync.ax" as sync;
import "internal/mp3/tables.ax" as tables;

error { InvalidAudio, Unsupported, OutOfMemory, TooLarge }
// -----------------------------------------------------------------------------
// Frames
// -----------------------------------------------------------------------------

struct Header {
    lsf: bool,  // MPEG-2 or 2.5: one granule, other scale factors
    mpeg25: bool,
    sfreq: usize,  // 0-8, indexing tables.RATES and the band tables
    rate: u32,
    crc: bool,
    mode: u32,  // 0 stereo, 1 joint stereo, 2 dual channel, 3 mono
    mode_ext: u32,
    channels: usize,
    len: usize,   // of the whole frame, in bytes
    side: usize,  // of the side information
}

fn header_at(d: []u8, p: usize) !Header {
    if ((p + 4) > d.len) or (d[p] != 0xff) or ((d[p + 1] & 0xe0) != 0xe0) {
        return error.InvalidAudio;
    }
    let ver = (d[p + 1] >> 3) & 3;
    let layer = (d[p + 1] >> 1) & 3;
    let br = @as(usize, d[p + 2] >> 4);
    let sr = @as(usize, (d[p + 2] >> 2) & 3);
    if (ver == 1) or (layer == 0) or (br == 15) or (sr == 3) {
        return error.InvalidAudio;
    }
    if (layer != 1) or (br == 0) {
        return error.Unsupported;  // layers I and II; free format
    }
    let lsf = ver != 3;
    let mpeg25 = ver == 0;
    let mut sfreq = sr;
    if mpeg25 {
        sfreq += 6;
    } else if lsf {
        sfreq += 3;
    }
    let rate = tables.RATES[sfreq];
    let mut kbps: u32 = 0;
    if lsf {
        kbps = tables.BITRATES[1][br];
    } else {
        kbps = tables.BITRATES[0][br];
    }
    let pad = @as(usize, (d[p + 2] >> 1) & 1);
    let mut len: usize = 0;
    if lsf {
        len = @as(usize, (72000 * kbps) / rate) + pad;
    } else {
        len = @as(usize, (144000 * kbps) / rate) + pad;
    }
    let mode = @as(u32, d[p + 3] >> 6);
    let mut channels: usize = 2;
    if mode == 3 {
        channels = 1;
    }
    let mut side: usize = 0;
    if lsf {
        side = 17;
        if channels == 1 {
            side = 9;
        }
    } else {
        side = 32;
        if channels == 1 {
            side = 17;
        }
    }
    return Header.{
        lsf: lsf,
        mpeg25: mpeg25,
        sfreq: sfreq,
        rate: rate,
        crc: (d[p + 1] & 1) == 0,
        mode: mode,
        mode_ext: @as(u32, (d[p + 3] >> 4) & 3),
        channels: channels,
        len: len,
        side: side,
    };
}

/// Whether a frame starts at p, with another like it after it (or the end
/// of the data).
fn frame_at(d: []u8, p: usize) bool {
    let h = header_at(d, p) catch return false;
    let q = p + h.len;
    if (q + 4) > d.len {
        return q <= d.len;
    }
    let h2 = header_at(d, q) catch return false;
    return (h2.sfreq == h.sfreq) and (h2.channels == h.channels);
}

/// The first byte after any ID3v2 tags.
fn skip_id3(d: []u8) usize {
    let mut p: usize = 0;
    while ((p + 10) <= d.len) and @mem_eq(d[p..p + 3], "ID3") {
        let size = (
            ((@as(usize, d[p + 6] & 0x7f) << 21) | (@as(usize, d[p + 7] & 0x7f) << 14)) | (
                @as(usize, d[p + 8] & 0x7f) << 7)) | @as(usize, d[p + 9] & 0x7f);
        p += 10 + size;
        if (d[p - size - 5] & 0x10) != 0 {
            p += 10;  // footer
        }
    }
    return p;
}

/// The next frame at or after p, or d.len.
fn find_frame(d: []u8, p: usize) usize {
    let mut q = p;
    while (q + 4) <= d.len {
        if (d[q] == 0xff) and frame_at(d, q) {
            return q;
        }
        q += 1;
    }
    return d.len;
}

pub fn is_mp3(data: []u8) bool {
    let p = skip_id3(data);
    if p >= data.len {
        return false;
    }
    // a frame at the start (after tags), or within a little junk
    let q = find_frame(data, p);
    return (q < data.len) and ((q - p) < 4096);
}

// -----------------------------------------------------------------------------
// Bits
// -----------------------------------------------------------------------------

struct Bits {
    d: []u8,
    pos: usize,  // in bits

    fn read(self: *mut Bits, n: u32) u32 {
        if n == 0 {
            return 0;
        }
        let mut v: u32 = 0;
        let mut k: u32 = 0;
        while k < n {
            let byte = self.pos >> 3;
            let mut b: u32 = 0;
            if byte < self.d.len {
                b = @as(u32, self.d[byte]);
            }
            let off = @as(u32, @truncate(u8, self.pos & 7));
            let take = @min(8 - off, n - k);
            let bits = (b >> (8 - off - take)) & ((@as(u32, 1) << take) - 1);
            v = (v << take) | bits;
            k += take;
            self.pos += @as(usize, take);
        }
        return v;
    }

    fn bit(self: *mut Bits) u32 {
        let byte = self.pos >> 3;
        let mut b: u32 = 0;
        if byte < self.d.len {
            b = @as(u32, self.d[byte]);
        }
        let v = (b >> (7 - @as(u32, @truncate(u8, self.pos & 7)))) & 1;
        self.pos += 1;
        return v;
    }
}

// -----------------------------------------------------------------------------
// Side information and scale factors
// -----------------------------------------------------------------------------

struct Granule {
    part23: usize,
    big_values: usize,
    gain: i32,
    sfc: u32,
    block_type: u32,  // 0 normal, 1 start, 2 short, 3 stop
    mixed: bool,
    table: [3]u32,
    subgain: [3]i32,
    region1: usize,  // where regions 1 and 2 start, in lines
    region2: usize,
    preflag: bool,
    sf_scale: bool,
    count1: u32,
    scfsi: u32,
}

fn empty_granule() Granule {
    return Granule.{
        part23: 0,
        big_values: 0,
        gain: 0,
        sfc: 0,
        block_type: 0,
        mixed: false,
        table: [0, 0, 0],
        subgain: [0, 0, 0],
        region1: 0,
        region2: 0,
        preflag: false,
        sf_scale: false,
        count1: 0,
        scfsi: 0,
    };
}

fn read_side(b: *mut Bits, h: *Header, grs: *mut [2][2]Granule) u32 {
    let nch = h.channels;
    let mut mdb: u32 = 0;
    if h.lsf {
        mdb = b.read(8);
        _ = b.read(@as(u32, @truncate(u8, nch)));
    } else {
        mdb = b.read(9);
        if nch == 1 {
            _ = b.read(5);
        } else {
            _ = b.read(3);
        }
        for c in @as(usize, 0)..nch {
            grs[1][c].scfsi = b.read(4);
        }
    }
    let mut ngr: usize = 2;
    if h.lsf {
        ngr = 1;
    }
    for gr in @as(usize, 0)..ngr {
        for c in @as(usize, 0)..nch {
            let g = &mut grs[gr][c];
            let scfsi = g.scfsi;
            g.* = empty_granule();
            if gr == 1 {
                g.scfsi = scfsi;
            }
            g.part23 = @as(usize, b.read(12));
            g.big_values = @min(@as(usize, b.read(9)), 288);
            g.gain = @bit_cast(i32, b.read(8));
            if h.lsf {
                g.sfc = b.read(9);
            } else {
                g.sfc = b.read(4);
            }
            let edges = tables.LONG_EDGES[h.sfreq];
            if b.bit() == 1 {
                g.block_type = b.read(2);
                g.mixed = b.bit() == 1;
                g.table[0] = b.read(5);
                g.table[1] = b.read(5);
                for w in @as(usize, 0)..3 {
                    g.subgain[w] = @bit_cast(i32, b.read(3));
                }
                if g.block_type == 0 {
                    g.block_type = 1;  // invalid; treat as a start block
                }
                if h.mpeg25 {
                    let mut r0: usize = 7;
                    if (g.block_type == 2) and not g.mixed {
                        r0 = 5;
                    }
                    g.region1 = @as(usize, edges[r0 + 1]);
                    g.region2 = 576;
                } else if not h.lsf or (g.block_type == 2) {
                    g.region1 = 36;
                    g.region2 = 576;
                } else {
                    g.region1 = 54;
                    g.region2 = 576;
                }
            } else {
                for i in @as(usize, 0)..3 {
                    g.table[i] = b.read(5);
                }
                let r0 = @as(usize, b.read(4));
                let r1 = @as(usize, b.read(3));
                g.region1 = @as(usize, edges[@min(r0 + 1, 22)]);
                if (r0 + r1 + 2) > 22 {
                    g.region2 = 576;
                } else {
                    g.region2 = @as(usize, edges[r0 + r1 + 2]);
                }
            }
            if not h.lsf {
                g.preflag = b.bit() == 1;
            }
            g.sf_scale = b.bit() == 1;
            g.count1 = b.bit();
        }
    }
    return mdb;
}

/// Scale factors: long[22] for long bands, short[13][3] for short ones.
struct Scale {
    long: [22]i32,
    short: [13][3]i32,
    lmax: [22]i32,  // for MPEG-2 intensity stereo: the illegal position per band
    smax: [13][3]i32,
    preflag: bool,
}

fn empty_scale() Scale {
    return Scale.{ long: [0; 22], short: [[0; 3]; 13], lmax: [0; 22], smax: [[0; 3]; 13], preflag: false };
}

fn read_scale1(b: *mut Bits, g: *Granule, gr: usize, sf: *mut Scale) void {
    let s1 = @as(u32, tables.SLEN[0][@as(usize, g.sfc)]);
    let s2 = @as(u32, tables.SLEN[1][@as(usize, g.sfc)]);
    if g.block_type == 2 {
        let mut first: usize = 0;
        if g.mixed {
            for sfb in @as(usize, 0)..8 {
                sf.long[sfb] = @bit_cast(i32, b.read(s1));
            }
            first = 3;
        }
        for sfb in first..12 {
            let mut bits = s1;
            if sfb >= 6 {
                bits = s2;
            }
            for w in @as(usize, 0)..3 {
                sf.short[sfb][w] = @bit_cast(i32, b.read(bits));
            }
        }
        for w in @as(usize, 0)..3 {
            sf.short[12][w] = 0;
        }
        return;
    }
    let groups: [5]usize = [0, 6, 11, 16, 21];
    for k in @as(usize, 0)..4 {
        let keep = (gr == 1) and (((g.scfsi >> @as(u32, @truncate(u8, 3 - k))) & 1) == 1);
        if keep {
            continue;  // the first granule's values stand
        }
        let mut bits = s1;
        if k >= 2 {
            bits = s2;
        }
        for sfb in groups[k]..groups[k + 1] {
            sf.long[sfb] = @bit_cast(i32, b.read(bits));
        }
    }
    sf.long[21] = 0;
}

fn read_scale2(b: *mut Bits, g: *Granule, ch: usize, h: *Header, sf: *mut Scale) void {
    let mut slen: [4]u32 = [0; 4];
    let mut tab: usize = 0;
    let i_stereo = (h.mode == 1) and ((h.mode_ext & 1) != 0) and (ch == 1);
    sf.preflag = false;
    if i_stereo {
        let s = g.sfc >> 1;
        if s < 180 {
            slen = [s / 36, (s % 36) / 6, (s % 36) % 6, 0];
            tab = 3;
        } else if s < 244 {
            let t = s - 180;
            slen = [(t & 63) >> 4, (t & 15) >> 2, t & 3, 0];
            tab = 4;
        } else {
            let t = s - 244;
            slen = [t / 3, t % 3, 0, 0];
            tab = 5;
        }
    } else {
        let s = g.sfc;
        if s < 400 {
            slen = [(s >> 4) / 5, (s >> 4) % 5, (s & 15) >> 2, s & 3];
            tab = 0;
        } else if s < 500 {
            let t = s - 400;
            slen = [(t >> 2) / 5, (t >> 2) % 5, t & 3, 0];
            tab = 1;
        } else {
            let t = s - 500;
            slen = [t / 3, t % 3, 0, 0];
            tab = 2;
            sf.preflag = true;
        }
    }
    let mut kind: usize = 0;
    if g.block_type == 2 {
        kind = 1;
        if g.mixed {
            kind = 2;
        }
    }
    let counts = tables.NR_OF_SFB[kind][tab];
    // the scale factors in order: long bands, then short bands by window
    let mut vals: [45]i32 = [0; 45];
    let mut maxs: [45]i32 = [0; 45];
    let mut n: usize = 0;
    for part in @as(usize, 0)..4 {
        let bits = slen[part];
        for _k in @as(usize, 0)..@as(usize, counts[part]) {
            if n < 45 {
                vals[n] = @bit_cast(i32, b.read(bits));
                maxs[n] = (@as(i32, 1) << @as(u32, @truncate(u8, bits))) - 1;
                n += 1;
            }
        }
    }
    let mut k: usize = 0;
    if g.block_type == 2 {
        let mut first: usize = 0;
        if g.mixed {
            for sfb in @as(usize, 0)..6 {
                sf.long[sfb] = vals[k];
                sf.lmax[sfb] = maxs[k];
                k += 1;
            }
            first = 3;
        }
        for sfb in first..12 {
            for w in @as(usize, 0)..3 {
                sf.short[sfb][w] = vals[k];
                sf.smax[sfb][w] = maxs[k];
                k += 1;
            }
        }
        for w in @as(usize, 0)..3 {
            sf.short[12][w] = 0;
            sf.smax[12][w] = sf.smax[11][w];
        }
    } else {
        for sfb in @as(usize, 0)..21 {
            sf.long[sfb] = vals[k];
            sf.lmax[sfb] = maxs[k];
            k += 1;
        }
        sf.long[21] = 0;
        sf.lmax[21] = sf.lmax[20];
    }
}

// -----------------------------------------------------------------------------
// Huffman decoding and requantization
// -----------------------------------------------------------------------------

fn huff(b: *mut Bits, start: usize) i32 {
    let mut p = start;
    loop {
        let v = tables.HUFF[p];
        if v >= 0 {
            return @as(i32, v);
        }
        p += 1;
        if b.bit() == 1 {
            p += @as(usize, @truncate(u16, @bit_cast(u16, -v)));
        }
    }
}

/// Decodes a granule's spectral values into is (576 values); returns how
/// many lines can be nonzero.
fn read_values(b: *mut Bits, g: *Granule, end: usize, is: []mut i32) usize {
    let bv = g.big_values * 2;
    let mut i: usize = 0;
    while i < bv {
        let mut region: usize = 0;
        if i >= g.region2 {
            region = 2;
        } else if i >= g.region1 {
            region = 1;
        }
        let t = @as(usize, g.table[region]);
        let lin = @as(u32, tables.HUFF_LINBITS[t]);
        let start = @as(usize, tables.HUFF_START[t]);
        let v = huff(b, start);
        let mut x = v >> 4;
        let mut y = v & 15;
        if (lin > 0) and (x == 15) {
            x += @bit_cast(i32, b.read(lin));
        }
        if (x != 0) and (b.bit() == 1) {
            x = -x;
        }
        if (lin > 0) and (y == 15) {
            y += @bit_cast(i32, b.read(lin));
        }
        if (y != 0) and (b.bit() == 1) {
            y = -y;
        }
        is[i] = x;
        is[i + 1] = y;
        i += 2;
    }
    // count1: quadruples of -1, 0, 1
    let mut start = tables.COUNT1_A;
    if g.count1 == 1 {
        start = tables.COUNT1_B;
    }
    while ((i + 4) <= 576) and (b.pos < end) {
        let v = huff(b, start);
        let mut q: [4]i32 = [0; 4];
        for k in @as(usize, 0)..4 {
            if (v & (@as(i32, 8) >> @as(u32, @truncate(u8, k)))) != 0 {
                q[k] = 1;
                if b.bit() == 1 {
                    q[k] = -1;
                }
            }
        }
        if b.pos > end {
            break;  // the last quadruple ran past the granule: drop it
        }
        for k in @as(usize, 0)..4 {
            is[i + k] = q[k];
        }
        i += 4;
    }
    for k in i..576 {
        is[k] = 0;
    }
    return i;
}

let mut pow43_table: [8207]f64 = [0.0; 8207];
let mut pow43_once: sync.Once = sync.Once.{ state: 0 };

fn build_pow43(_u: u8) void {
    for k in @as(usize, 0)..8207 {
        let x = @float_from_int(f64, k);
        pow43_table[k] = x * math.cbrt(x);
    }
}

fn pow43(v: i32) f64 {
    pow43_once.call(build_pow43, @as(u8, 0));
    let a = @abs(v);
    let mut m: f64 = 0.0;
    if a < 8207 {
        m = pow43_table[@as(usize, @bit_cast(u32, a))];
    } else {
        let x = @float_from_int(f64, a);
        m = x * math.cbrt(x);
    }
    if v < 0 {
        return -m;
    }
    return m;
}

/// 2^(q / 4).
fn pow2q(q: i32) f64 {
    let quarters: [4]f64 = [1.0, 1.189207115002721, 1.4142135623730951, 1.681792830507429];
    let whole = q >> 2;
    return math.ldexp(quarters[@as(usize, @bit_cast(u32, q & 3))], whole);
}

/// Requantizes is into xr (in the bitstream's order: short bands by window).
fn requantize(g: *Granule, sf: *Scale, sfreq: usize, is: []i32, xr: []mut f64, preflag: bool) void {
    let mut mult: i32 = 2;  // scale factors count in steps of 2^(mult / 4)
    if g.sf_scale {
        mult = 4;
    }
    let base = g.gain - 210;
    let le = tables.LONG_EDGES[sfreq];
    let se = tables.SHORT_EDGES[sfreq];
    let mut line: usize = 0;
    if g.block_type != 2 or g.mixed {
        // long bands (all of them, or those below line 36 in a mixed block)
        let mut limit: usize = 576;
        if g.block_type == 2 {
            limit = 36;
        }
        let mut sfb: usize = 0;
        while (sfb < 22) and (@as(usize, le[sfb]) < limit) {
            let mut s = sf.long[sfb];
            if preflag {
                s += @as(i32, tables.PRETAB[sfb]);
            }
            let scale = pow2q(base - (mult * s));
            let end = @min(@as(usize, le[sfb + 1]), limit);
            for i in @as(usize, le[sfb])..end {
                xr[i] = pow43(is[i]) * scale;
            }
            sfb += 1;
        }
        line = limit;
        if g.block_type != 2 {
            return;
        }
    }
    // short bands, each stored as three windows one after another
    let mut sfb: usize = 0;
    while (@as(usize, se[sfb]) * 3) < line {
        sfb += 1;
    }
    while sfb < 13 {
        let width = @as(usize, se[sfb + 1] - se[sfb]);
        let start = @as(usize, se[sfb]) * 3;
        for w in @as(usize, 0)..3 {
            let s = sf.short[sfb][w];
            let scale = pow2q((base - (8 * g.subgain[w])) - (mult * s));
            let at = start + (w * width);
            for i in at..at + width {
                xr[i] = pow43(is[i]) * scale;
            }
        }
        sfb += 1;
    }
}

// -----------------------------------------------------------------------------
// Stereo
// -----------------------------------------------------------------------------

/// The lines of a granule after the last nonzero one of each short window
/// (as a band index), or of the long bands: where intensity stereo starts.
fn first_zero_band_long(xr: []f64, le: [23]u16, limit: usize) usize {
    let mut last: i64 = -1;
    for i in @as(usize, 0)..limit {
        if xr[i] != 0.0 {
            last = @bit_cast(i64, @as(u64, i));
        }
    }
    let mut sfb: usize = 0;
    while (sfb < 22) and (@bit_cast(i64, @as(u64, le[sfb])) <= last) {
        sfb += 1;
    }
    return sfb;
}

fn first_zero_band_short(xr: []f64, se: [14]u16, w: usize, from_sfb: usize) usize {
    let mut first: usize = from_sfb;
    for sfb in from_sfb..13 {
        let width = @as(usize, se[sfb + 1] - se[sfb]);
        let at = (@as(usize, se[sfb]) * 3) + (w * width);
        for i in at..at + width {
            if xr[i] != 0.0 {
                first = sfb + 1;
            }
        }
    }
    return first;
}

/// Intensity-stereo gains for position p: [left, right].
fn is_gains(h: *Header, p: i32, sfc: u32) [2]f64 {
    if not h.lsf {
        if p >= 6 {
            return [1.0, 0.0];
        }
        let t = math.tan((@float_from_int(f64, p) * math.PI) / 12.0);
        return [t / (1.0 + t), 1.0 / (1.0 + t)];
    }
    let mut io: f64 = 0.8408964152537145;  // 2^-1/4
    if (sfc & 1) == 1 {
        io = 0.7071067811865476;  // 2^-1/2
    }
    if p == 0 {
        return [1.0, 1.0];
    }
    if (p & 1) == 1 {
        return [math.pow(io, @float_from_int(f64, (p + 1) / 2)), 1.0];
    }
    return [1.0, math.pow(io, @float_from_int(f64, p / 2))];
}

fn stereo(h: *Header, g: *Granule, sf1: *Scale, l: []mut f64, r: []mut f64) void {
    let ms = (h.mode_ext & 2) != 0;
    let intensity = (h.mode_ext & 1) != 0;
    let mut is_line: [576]bool = [false; 576];
    if intensity {
        let le = tables.LONG_EDGES[h.sfreq];
        let se = tables.SHORT_EDGES[h.sfreq];
        if g.block_type == 2 {
            let mut first: usize = 0;
            if g.mixed {
                first = 3;
            }
            let mut all_empty = true;
            for w in @as(usize, 0)..3 {
                let start = first_zero_band_short(r, se, w, first);
                if start > first {
                    all_empty = false;
                }
                for sfb in start..13 {
                    let mut src = sfb;
                    if sfb == 12 {
                        src = 11;  // the last band has no position of its own
                    }
                    let p = sf1.short[src][w];
                    if (not h.lsf and (p == 7)) or (h.lsf and (p == sf1.smax[src][w])) {
                        continue;
                    }
                    let k = is_gains(h, p, g.sfc);
                    let width = @as(usize, se[sfb + 1] - se[sfb]);
                    let at = (@as(usize, se[sfb]) * 3) + (w * width);
                    for i in at..at + width {
                        let v = l[i];
                        l[i] = v * k[0];
                        r[i] = v * k[1];
                        is_line[i] = true;
                    }
                }
            }
            if g.mixed and all_empty {
                let start = first_zero_band_long(r, le, 36);
                let mut sfb = start;
                while (sfb < 22) and (@as(usize, le[sfb]) < 36) {
                    let p = sf1.long[sfb];
                    if not ((not h.lsf and (p == 7)) or (h.lsf and (p == sf1.lmax[sfb]))) {
                        let k = is_gains(h, p, g.sfc);
                        for i in @as(usize, le[sfb])..@as(usize, le[sfb + 1]) {
                            let v = l[i];
                            l[i] = v * k[0];
                            r[i] = v * k[1];
                            is_line[i] = true;
                        }
                    }
                    sfb += 1;
                }
            }
        } else {
            let start = first_zero_band_long(r, le, 576);
            for sfb in start..22 {
                let mut src = sfb;
                if sfb == 21 {
                    src = 20;
                }
                let p = sf1.long[src];
                if (not h.lsf and (p == 7)) or (h.lsf and (p == sf1.lmax[src])) {
                    continue;
                }
                let k = is_gains(h, p, g.sfc);
                for i in @as(usize, le[sfb])..@as(usize, le[sfb + 1]) {
                    let v = l[i];
                    l[i] = v * k[0];
                    r[i] = v * k[1];
                    is_line[i] = true;
                }
            }
        }
    }
    if ms {
        let s: f64 = 0.7071067811865476;
        for i in @as(usize, 0)..576 {
            if not is_line[i] {
                let m = l[i];
                let d = r[i];
                l[i] = (m + d) * s;
                r[i] = (m - d) * s;
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Synthesis
// -----------------------------------------------------------------------------

/// Tables for the transforms, computed once.
struct Tables {
    imdct_long: [36][18]f64,
    imdct_short: [12][6]f64,
    win: [4][36]f64,  // long windows, by block type (2: the short window, in its first 12)
    cs: [8]f64,
    ca: [8]f64,
    matrix: [64][32]f64,
    d: [512]f64,
}

fn make_tables(t: *mut Tables) void {
    for i in @as(usize, 0)..36 {
        for k in @as(usize, 0)..18 {
            t.imdct_long[i][k] = math.cos((math.PI / 72.0) * @float_from_int(f64, ((2 * i) + 1 + 18) * ((2 * k) + 1)));
        }
    }
    for i in @as(usize, 0)..12 {
        for k in @as(usize, 0)..6 {
            t.imdct_short[i][k] = math.cos((math.PI / 24.0) * @float_from_int(f64, ((2 * i) + 1 + 6) * ((2 * k) + 1)));
        }
    }
    for i in @as(usize, 0)..36 {
        let long = math.sin((math.PI / 36.0) * (@float_from_int(f64, i) + 0.5));
        t.win[0][i] = long;
        // start
        if i < 18 {
            t.win[1][i] = long;
        } else if i < 24 {
            t.win[1][i] = 1.0;
        } else if i < 30 {
            t.win[1][i] = math.sin((math.PI / 12.0) * (@float_from_int(f64, i - 18) + 0.5));
        } else {
            t.win[1][i] = 0.0;
        }
        // stop
        if i < 6 {
            t.win[3][i] = 0.0;
        } else if i < 12 {
            t.win[3][i] = math.sin((math.PI / 12.0) * (@float_from_int(f64, i - 6) + 0.5));
        } else if i < 18 {
            t.win[3][i] = 1.0;
        } else {
            t.win[3][i] = long;
        }
        t.win[2][i] = 0.0;
        if i < 12 {
            t.win[2][i] = math.sin((math.PI / 12.0) * (@float_from_int(f64, i) + 0.5));
        }
    }
    for i in @as(usize, 0)..8 {
        let c = tables.ALIAS_C[i];
        let sq = @sqrt(1.0 + (c * c));
        t.cs[i] = 1.0 / sq;
        t.ca[i] = c / sq;
    }
    for i in @as(usize, 0)..64 {
        for k in @as(usize, 0)..32 {
            t.matrix[i][k] = math.cos((@float_from_int(f64, (16 + i) * ((2 * k) + 1)) * math.PI) / 64.0);
        }
    }
    // tables.WINDOW is the symmetric prototype filter; the synthesis window D
    // alternates its sign every 64 taps
    for i in @as(usize, 0)..512 {
        let mut k = i;
        if i > 256 {
            k = 512 - i;
        }
        let mut v = @float_from_int(f64, tables.WINDOW[k]) / 65536.0;
        if ((i >> 6) & 1) == 1 {
            v = -v;
        }
        t.d[i] = v;
    }
}

/// A channel's state between granules.
struct Chan {
    overlap: [576]f64,
    v: [1024]f64,
    voff: usize,
}

/// Turns a granule's requantized lines (bitstream order) into 576 samples.
fn synthesize(t: *Tables, g: *Granule, sfreq: usize, xr: []mut f64, st: *mut Chan, out: []mut f32) void {
    // reorder short bands: lines of the three windows interleaved
    if g.block_type == 2 {
        let se = tables.SHORT_EDGES[sfreq];
        let mut tmp: [576]f64 = [0.0; 576];
        let mut sfb: usize = 0;
        if g.mixed {
            while (@as(usize, se[sfb]) * 3) < 36 {
                sfb += 1;
            }
        }
        let first = @as(usize, se[sfb]) * 3;
        while sfb < 13 {
            let width = @as(usize, se[sfb + 1] - se[sfb]);
            let start = @as(usize, se[sfb]) * 3;
            for w in @as(usize, 0)..3 {
                for k in @as(usize, 0)..width {
                    tmp[start + (3 * k) + w] = xr[start + (w * width) + k];
                }
            }
            sfb += 1;
        }
        @mem_copy(xr[first..576], tmp[first..576]);
    }
    // alias reduction between subbands (not within short blocks)
    let mut sblim: usize = 32;
    if g.block_type == 2 {
        sblim = 0;
        if g.mixed {
            sblim = 2;
        }
    }
    let mut sb: usize = 1;
    while sb < sblim {
        for i in @as(usize, 0)..8 {
            let a = xr[(18 * sb) - 1 - i];
            let b = xr[(18 * sb) + i];
            xr[(18 * sb) - 1 - i] = (a * t.cs[i]) - (b * t.ca[i]);
            xr[(18 * sb) + i] = (b * t.cs[i]) + (a * t.ca[i]);
        }
        sb += 1;
    }
    // the inverse MDCT of each subband, overlapped with the last granule's
    let mut sub: [32][18]f64 = [[0.0; 18]; 32];
    for s in @as(usize, 0)..32 {
        let x = xr[18 * s..(18 * s) + 18];
        let mut z: [36]f64 = [0.0; 36];
        let mut silent = true;
        for k in @as(usize, 0)..18 {
            if x[k] != 0.0 {
                silent = false;
            }
        }
        let mut bt = g.block_type;
        if g.mixed and (s < 2) {
            bt = 0;
        }
        if silent {
            // nothing to transform
        } else if bt == 2 {
            for w in @as(usize, 0)..3 {
                for i in @as(usize, 0)..12 {
                    let mut acc: f64 = 0.0;
                    for k in @as(usize, 0)..6 {
                        acc += x[(3 * k) + w] * t.imdct_short[i][k];
                    }
                    z[6 + (6 * w) + i] += acc * t.win[2][i];
                }
            }
        } else {
            let wv = t.win[@as(usize, bt)];
            for i in @as(usize, 0)..36 {
                let mut acc: f64 = 0.0;
                for k in @as(usize, 0)..18 {
                    acc += x[k] * t.imdct_long[i][k];
                }
                z[i] = acc * wv[i];
            }
        }
        let ov = st.overlap[18 * s..(18 * s) + 18];
        for i in @as(usize, 0)..18 {
            let mut v = z[i] + ov[i];
            if ((s & 1) == 1) and ((i & 1) == 1) {
                v = -v;  // frequency inversion
            }
            sub[s][i] = v;
            ov[i] = z[18 + i];
        }
    }
    // the polyphase filter bank
    for slot in @as(usize, 0)..18 {
        st.voff = (st.voff + 1024 - 64) & 1023;
        let mut col: [32]f64 = [0.0; 32];
        for k in @as(usize, 0)..32 {
            col[k] = sub[k][slot];
        }
        // V[16] is 0, V[32 - i] = -V[i] and V[48 + j] = V[48 - j]: only
        // rows 0-15 and 33-48 need computing
        let mut vv: [64]f64 = [0.0; 64];
        for i in @as(usize, 0)..49 {
            if (i >= 16) and (i <= 32) {
                continue;
            }
            let row = t.matrix[i];
            let mut acc: f64 = 0.0;
            for k in @as(usize, 0)..32 {
                acc += row[k] * col[k];
            }
            vv[i] = acc;
        }
        for i in @as(usize, 0)..16 {
            vv[32 - i] = -vv[i];
        }
        for j in @as(usize, 1)..16 {
            vv[48 + j] = vv[48 - j];
        }
        for i in @as(usize, 0)..64 {
            st.v[(st.voff + i) & 1023] = vv[i];
        }
        for j in @as(usize, 0)..32 {
            let mut acc: f64 = 0.0;
            for i in @as(usize, 0)..16 {
                let vi = ((i >> 1) * 128) + j + ((i & 1) * 96);
                acc += st.v[(st.voff + vi) & 1023] * t.d[j + (32 * i)];
            }
            out[(slot * 32) + j] = @float_cast(f32, acc);
        }
    }
}

// -----------------------------------------------------------------------------
// Decoding
// -----------------------------------------------------------------------------

fn is_tag(d: []u8, at: usize) bool {
    return ((at + 4) <= d.len) and (@mem_eq(d[at..at + 4], "Xing") or @mem_eq(d[at..at + 4], "Info"));
}

/// The Xing/Info frame's gapless fields: [audio frames, delay, padding]
/// (-1 where unknown), or none if the frame at p is not one.
fn xing(d: []u8, p: usize, h: *Header) ![3]i64 {
    // after the side information (LAME puts it there even when the frame
    // has a CRC; others after the CRC)
    let mut at = p + 4 + h.side;
    if h.crc and ((at + 6) <= d.len) and not is_tag(d, at) {
        at += 2;
    }
    if ((at + 8) > d.len) or not is_tag(d, at) {
        return error.InvalidAudio;
    }
    let flags = binary.u32_be(d[at + 4..]);
    let mut off = at + 8;
    let mut frames: i64 = -1;
    if (flags & 1) != 0 {
        if (off + 4) > d.len {
            return error.InvalidAudio;
        }
        frames = @as(i64, binary.u32_be(d[off..]));
        off += 4;
    }
    if (flags & 2) != 0 {
        off += 4;
    }
    if (flags & 4) != 0 {
        off += 100;
    }
    if (flags & 8) != 0 {
        off += 4;
    }
    let mut delay: i64 = -1;
    let mut padding: i64 = -1;
    if ((off + 24) <= d.len) and
       (@mem_eq(d[off..off + 4], "LAME") or @mem_eq(d[off..off + 4], "Lavc") or @mem_eq(d[off..off + 4], "Lavf")) {
        let b0 = @as(i64, d[off + 21]);
        let b1 = @as(i64, d[off + 22]);
        let b2 = @as(i64, d[off + 23]);
        delay = (b0 << 4) | (b1 >> 4);
        padding = ((b1 & 15) << 8) | b2;
    }
    return [frames, delay, padding];
}

pub fn decode(data: []u8) !audio.Sound {
    // drop an ID3v1 tag
    let mut d = data;
    if (d.len >= 128) and @mem_eq(d[d.len - 128..d.len - 125], "TAG") {
        d = d[..d.len - 128];
    }
    let mut p = find_frame(d, skip_id3(d));
    if p >= d.len {
        return error.InvalidAudio;
    }
    let first = header_at(d, p)!;
    let mut info: [3]i64 = [-1, -1, -1];
    let mut have_xing = false;
    let xi = xing(d, p, &first) catch [@as(i64, -2), -1, -1];
    if xi[0] != -2 {
        info = xi;
        have_xing = true;
        p += first.len;
    }
    let t = mem.new.[Tables]()!;
    defer mem.destroy(t);
    make_tables(t);
    let chans = mem.alloc_zeroed.[Chan](2)!;
    defer mem.free(chans);
    let nch = first.channels;
    let mut out = audio.Sound.init(0, nch, first.rate, audio.SampleFormat.F32)!;
    decode_frames(d, p, &first, t, chans, &mut out) catch |e| {
        out.deinit();
        return e;
    };
    // gapless trimming
    if have_xing and (info[1] >= 0) {
        let mut spf: i64 = 1152;
        if first.lsf {
            spf = 576;
        }
        let total = @bit_cast(i64, @as(u64, out.frames));
        let begin = @min(info[1] + 529, total);
        let mut end = total;
        if info[0] >= 0 {
            end = @min(((info[0] * spf) - info[2]) + 529, total);
        }
        if end < begin {
            end = begin;
        }
        let b = @truncate(usize, @bit_cast(u64, begin));
        let e = @truncate(usize, @bit_cast(u64, end));
        let s = @cast_slice(f32, out.data[..out.frames * nch * 4]);
        for i in @as(usize, 0)..(e - b) * nch {
            s[i] = s[i + (b * nch)];
        }
        out.frames = e - b;
    }
    out.data = mem.realloc(out.data, @max(out.frames * nch * 4, 1)) catch |e| {
        out.deinit();
        return e;
    };
    return out;
}

fn decode_frames(d: []u8, p0: usize, first: *Header, t: *Tables, chans: []mut Chan, out: *mut audio.Sound) !void {
    let nch = first.channels;
    let mut res: [4096]u8 = [0; 4096];  // the bit reservoir
    let mut rl: usize = 0;
    let mut buf: [6144]u8 = [0; 6144];
    let mut grs: [2][2]Granule = [[empty_granule(); 2]; 2];
    let mut sfs: [2]Scale = [empty_scale(); 2];
    let mut is: [576]i32 = [0; 576];
    let mut xr: [2][576]f64 = [[0.0; 576]; 2];
    let mut pcm: [576]f32 = [0.0; 576];
    let mut cap: usize = 0;
    let mut frames: usize = 0;
    let mut p = p0;
    while p < d.len {
        let h = header_at(d, p) catch {
            let q = find_frame(d, p + 1);
            if q >= d.len {
                break;
            }
            p = q;
            continue;
        };
        if (h.channels != nch) or (h.sfreq != first.sfreq) {
            let q = find_frame(d, p + 1);  // a stray header, or another stream
            p = q;
            continue;
        }
        if (p + h.len) > d.len {
            break;  // a truncated last frame
        }
        let mut side_at = p + 4;
        if h.crc {
            side_at += 2;
        }
        let main_at = side_at + h.side;
        if main_at > (p + h.len) {
            p += h.len;
            continue;
        }
        let mut sb = Bits.{ d: d[side_at..main_at], pos: 0 };
        let mdb = @as(usize, read_side(&mut sb, &h, &mut grs));
        let main = d[main_at..p + h.len];
        let mut ngr: usize = 2;
        if h.lsf {
            ngr = 1;
        }
        // room for the output
        let count = ngr * 576;
        if (frames + count) > cap {
            cap = @max(cap * 2, frames + count + 16384);
            if (cap * nch) > audio.MAX_SAMPLES {
                return error.TooLarge;
            }
            out.data = mem.realloc(out.data, cap * nch * 4)!;
        }
        let o = @cast_slice(f32, out.data[..cap * nch * 4]);
        if mdb > rl {
            // the reservoir it needs is missing (the stream was cut): silence
            for i in @as(usize, 0)..count * nch {
                o[(frames * nch) + i] = 0.0;
            }
        } else {
            let n = mdb + main.len;
            @mem_copy(buf[..mdb], res[rl - mdb..rl]);
            @mem_copy(buf[mdb..n], main);
            let mut b = Bits.{ d: buf[..n], pos: 0 };
            for gr in @as(usize, 0)..ngr {
                for c in @as(usize, 0)..nch {
                    let g = &grs[gr][c];
                    let start = b.pos;
                    if h.lsf {
                        sfs[c] = empty_scale();
                        read_scale2(&mut b, g, c, &h, &mut sfs[c]);
                    } else {
                        if gr == 0 {
                            sfs[c] = empty_scale();
                        }
                        read_scale1(&mut b, g, gr, &mut sfs[c]);
                    }
                    let end = start + g.part23;
                    _ = read_values(&mut b, g, end, is[..]);
                    b.pos = end;
                    let pre = g.preflag or sfs[c].preflag;
                    requantize(g, &sfs[c], h.sfreq, is[..], xr[c][..], pre);
                }
                if (nch == 2) and (h.mode == 1) {
                    stereo(&h, &grs[gr][1], &sfs[1], xr[0][..], xr[1][..]);
                }
                for c in @as(usize, 0)..nch {
                    synthesize(t, &grs[gr][c], h.sfreq, xr[c][..], &mut chans[c], pcm[..]);
                    let base = (frames + (gr * 576)) * nch;
                    for i in @as(usize, 0)..576 {
                        o[base + (i * nch) + c] = pcm[i];
                    }
                }
            }
        }
        frames += count;
        // keep this frame's main data for the frames after it
        if (rl + main.len) > res.len {
            let keep = @min(rl, res.len - main.len);
            for i in @as(usize, 0)..keep {
                res[i] = res[rl - keep + i];
            }
            rl = keep;
        }
        @mem_copy(res[rl..rl + main.len], main);
        rl += main.len;
        p += h.len;
    }
    out.frames = frames;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

test "huffman trees" {
    // table 1: 1 -> (0,0); 001 -> (0,1) ...
    let bytes: [1]u8 = [0x80];
    let mut b = Bits.{ d: bytes[..], pos: 0 };
    @expect_eq(huff(&mut b, @as(usize, tables.HUFF_START[1])), 0);
    @expect_eq(b.pos, 1);
}

test "synthesis window" {
    let t = mem.new.[Tables]()!;
    defer mem.destroy(t);
    make_tables(t);
    @expect(@abs(t.d[256] - 1.144989014) < 1e-6);
    @expect(@abs(t.d[1] + 0.000015259) < 1e-8);
    @expect(@abs(t.d[511] - 0.000015259) < 1e-8);
}

