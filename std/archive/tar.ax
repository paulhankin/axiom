// =============================================================================
// std/archive/tar.ax - tar archives (POSIX ustar and pax, and GNU): reading and
// writing.
//
//     let mut r = tar.Reader.init(bytes);               // reading
//     defer r.deinit();
//     loop {
//         let e = r.next() catch |err| { if err == error.Done { break; } return err; };
//         if e.kind == tar.FILE { ... e.name ... e.data ... }
//     }
//
//     let mut w = tar.Writer.init(out);                 // writing
//     w.add_file("docs/a.txt", "hello\n", tar.Options.default())!;
//     w.add_dir("docs/", tar.Options.default())!;
//     w.finish()!;
//
// For .tar.gz, run the bytes through deflate.decompress(data, deflate.Format.GZIP,
// limit) first (or deflate.compress(tar, deflate.Format.GZIP, level) after).
//
// Reading understands ustar headers (with the name prefix), pax extended
// and global headers (path, linkpath, size, mtime, uid, gid, uname,
// gname), GNU long names and links, and GNU base-256 numbers. Checksums are
// verified, and sizes are checked against the input, so hostile archives
// fail cleanly. extract_all refuses names that would leave its directory
// or are longer than zip.MAX_NAME, and link entries. Writing uses plain
// ustar headers when they suffice and adds pax records for long names, big
// sizes and out-of-range times.
// =============================================================================

import "../compress/deflate.ax" as deflate;
import "../fmt.ax" as fmt;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../os/fs.ax" as fs;
import "../os/path.ax" as path;
import "../str.ax" as strs;
import "zip.ax" as zip;

pub error TarError { Done, Corrupt, ChecksumMismatch, TooLarge, UnsafePath, OutOfMemory, NotFound, BadFormat, IoError,
                     BadPattern, InvalidUtf8, InvalidNumber, PermissionDenied, Overflow, Exists, NotADirectory,
                     IsDirectory, NotEmpty, Unsupported, Empty, InvalidArgument, Failed }

// Entry kinds (the typeflag bytes)
pub const FILE: u8 = '0';
pub const HARDLINK: u8 = '1';
pub const SYMLINK: u8 = '2';
pub const CHAR: u8 = '3';
pub const BLOCK: u8 = '4';
pub const DIR: u8 = '5';
pub const FIFO: u8 = '6';

pub struct Entry {
    name: []u8,  // (valid until the next call of next)
    kind: u8,    // FILE, DIR, SYMLINK, HARDLINK, ...
    mode: u32,   // permission bits
    uid: u64,
    gid: u64,
    size: u64,
    mtime: i64,      // Unix time
    linkname: []u8,  // link target
    uname: []u8,
    gname: []u8,
    data: []u8,  // a file's contents
}

fn nul_trim(b: []u8) []u8 {
    let n = strs.index_of_byte(b, 0) catch b.len;
    return b[..n];
}

// A numeric field: octal text, or GNU base-256.
fn number(b: []u8) TarError!u64 {
    if (b.len > 0) and ((b[0] & 0x80) != 0) {
        if (b[0] & 0x40) != 0 {
            return error.Corrupt;  // negative
        }
        let mut v: u64 = @as(u64, b[0] & 0x3f);
        for c in b[1..] {
            if (v >> 56) != 0 {
                return error.Corrupt;
            }
            v = (v << 8) | @as(u64, c);
        }
        return v;
    }
    let mut v: u64 = 0;
    let mut seen = false;
    for c in b {
        if (c == 0) or (c == ' ') {
            if seen {
                break;
            }
            continue;
        }
        if (c < '0') or (c > '7') {
            return error.Corrupt;
        }
        if (v >> 60) != 0 {
            return error.Corrupt;
        }
        v = (v * 8) + @as(u64, c - '0');
        seen = true;
    }
    return v;
}

// Values from pax extended headers.
struct Pax {
    path: strs.String,
    linkpath: strs.String,
    uname: strs.String,
    gname: strs.String,
    size: u64,
    mtime: i64,
    uid: u64,
    gid: u64,
    has: u32,  // which are set (bits below)

    fn init() Pax {
        return Pax.{ path: strs.String.init(), linkpath: strs.String.init(), uname: strs.String.init(),
                     gname: strs.String.init(), size: 0, mtime: 0, uid: 0, gid: 0, has: 0 };
    }

    fn deinit(self: *mut Pax) void {
        self.path.deinit();
        self.linkpath.deinit();
        self.uname.deinit();
        self.gname.deinit();
    }

    fn clear(self: *mut Pax) void {
        self.has = 0;
    }

    fn set(self: *mut Pax, key: []u8, v: []u8) TarError!void {
        if strs.eq(key, "path") {
            self.path.clear();
            self.path.push_str(v)!;
            self.has |= P_PATH;
        } else if strs.eq(key, "linkpath") {
            self.linkpath.clear();
            self.linkpath.push_str(v)!;
            self.has |= P_LINK;
        } else if strs.eq(key, "uname") {
            self.uname.clear();
            self.uname.push_str(v)!;
            self.has |= P_UNAME;
        } else if strs.eq(key, "gname") {
            self.gname.clear();
            self.gname.push_str(v)!;
            self.has |= P_GNAME;
        } else if strs.eq(key, "size") {
            self.size = fmt.parse_int.[u64](v) catch return error.Corrupt;
            self.has |= P_SIZE;
        } else if strs.eq(key, "uid") {
            self.uid = fmt.parse_int.[u64](v) catch return error.Corrupt;
            self.has |= P_UID;
        } else if strs.eq(key, "gid") {
            self.gid = fmt.parse_int.[u64](v) catch return error.Corrupt;
            self.has |= P_GID;
        } else if strs.eq(key, "mtime") {
            let dot = strs.index_of_byte(v, '.') catch v.len;
            self.mtime = fmt.parse_int.[i64](v[..dot]) catch return error.Corrupt;
            self.has |= P_MTIME;
        }
    }

    // Parses records "<length> <key>=<value>\n".
    fn parse(self: *mut Pax, b: []u8) TarError!void {
        let mut i: usize = 0;
        while i < b.len {
            if b[i] == 0 {
                break;
            }
            let sp = strs.index_of_from(b, " ", i) catch return error.Corrupt;
            let n = fmt.parse_int.[usize](b[i..sp]) catch return error.Corrupt;
            if (n < (sp - i) + 3) or (n > (b.len - i)) {
                return error.Corrupt;
            }
            let rec = b[sp + 1..i + n];
            if rec[rec.len - 1] != '\n' {
                return error.Corrupt;
            }
            let eq = strs.index_of_byte(rec, '=') catch return error.Corrupt;
            self.set(rec[..eq], rec[eq + 1..rec.len - 1])!;
            i += n;
        }
    }
}

const P_PATH: u32 = 1;
const P_LINK: u32 = 2;
const P_UNAME: u32 = 4;
const P_GNAME: u32 = 8;
const P_SIZE: u32 = 16;
const P_MTIME: u32 = 32;
const P_UID: u32 = 64;
const P_GID: u32 = 128;

/// Reads the entries of a tar archive in memory (which must outlive it).
pub struct Reader {
    s: []u8,
    i: usize,
    local: Pax,
    global: Pax,
    name: strs.String,
    link: strs.String,
    long_name: bool,  // a GNU long name applies to the next entry
    long_link: bool,

    pub fn init(bytes: []u8) Reader {
        return Reader.{ s: bytes, i: 0, local: Pax.init(), global: Pax.init(), name: strs.String.init(),
                        link: strs.String.init(), long_name: false, long_link: false };
    }

    pub fn deinit(self: *mut Reader) void {
        self.local.deinit();
        self.global.deinit();
        self.name.deinit();
        self.link.deinit();
    }

    /// The next entry, or error.Done at the end.
    pub fn next(self: *mut Reader) TarError!Entry {
        loop {
            if (self.s.len - self.i) < 512 {
                if self.i == self.s.len {
                    return error.Done;  // (no end blocks: tolerated)
                }
                return error.Corrupt;
            }
            let h = self.s[self.i..self.i + 512];
            if all_zero(h) {
                return error.Done;
            }
            verify(h)!;
            let kind = h[156];
            let mut size = number(h[124..136])!;
            if ((kind == 'x') or (kind == 'g') or (kind == 'L') or (kind == 'K')) and (size > 16777216) {
                return error.TooLarge;
            }
            if (self.local.has & P_SIZE) != 0 {
                size = self.local.size;
            }
            let body = self.i + 512;
            if size > @as(u64, self.s.len - body) {
                return error.Corrupt;
            }
            let n = @truncate(usize, size);
            let data = self.s[body..body + n];
            self.i = body + (((n + 511) / 512) * 512);
            if self.i > self.s.len {
                self.i = self.s.len;
            }
            if kind == 'x' {
                self.local.clear();
                self.local.parse(data)!;
                continue;
            }
            if kind == 'g' {
                self.global.parse(data)!;
                continue;
            }
            if kind == 'L' {
                self.name.clear();
                self.name.push_str(nul_trim(data))!;
                self.long_name = true;
                continue;
            }
            if kind == 'K' {
                self.link.clear();
                self.link.push_str(nul_trim(data))!;
                self.long_link = true;
                continue;
            }
            let mut e = Entry.{ name: "", kind: kind, mode: @truncate(u32, number(h[100..108])! & 0o7777),
                                uid: number(h[108..116])!, gid: number(h[116..124])!, size: size,
                                mtime: @bit_cast(i64, number(h[136..148])!), linkname: nul_trim(h[157..257]),
                                uname: nul_trim(h[265..297]), gname: nul_trim(h[297..329]), data: data };
            if kind == 0 {
                e.kind = FILE;
            }
            if (kind == '7') {
                e.kind = FILE;  // contiguous files are files
            }
            // the name: GNU long name, or pax path, or ustar prefix/name
            if self.long_name {
                e.name = self.name.bytes();
            } else {
                self.name.clear();
                let ustar = strs.eq(h[257..263], "ustar\x00");
                let prefix = nul_trim(h[345..500]);
                if ustar and (prefix.len > 0) {
                    self.name.push_str(prefix)!;
                    self.name.push('/')!;
                }
                self.name.push_str(nul_trim(h[0..100]))!;
                e.name = self.name.bytes();
            }
            if self.long_link {
                e.linkname = self.link.bytes();
            }
            self.apply(&self.global, &mut e);
            self.apply(&self.local, &mut e);
            if (e.kind == DIR) and strs.ends_with(e.name, "/") and (e.name.len > 1) {
                e.name = e.name[..e.name.len - 1];
            }
            if (e.kind != FILE) and (e.kind != 'S') {
                e.data = "";
            }
            self.local.clear();
            self.long_name = false;
            self.long_link = false;
            return e;
        }
    }

    fn apply(self: *Reader, p: *Pax, e: *mut Entry) void {
        _ = self;
        if (p.has & P_PATH) != 0 {
            e.name = p.path.bytes();
        }
        if (p.has & P_LINK) != 0 {
            e.linkname = p.linkpath.bytes();
        }
        if (p.has & P_UNAME) != 0 {
            e.uname = p.uname.bytes();
        }
        if (p.has & P_GNAME) != 0 {
            e.gname = p.gname.bytes();
        }
        if (p.has & P_MTIME) != 0 {
            e.mtime = p.mtime;
        }
        if (p.has & P_UID) != 0 {
            e.uid = p.uid;
        }
        if (p.has & P_GID) != 0 {
            e.gid = p.gid;
        }
    }
}

fn all_zero(b: []u8) bool {
    for c in b {
        if c != 0 {
            return false;
        }
    }
    return true;
}

fn verify(h: []u8) TarError!void {
    let want = number(h[148..156])!;
    let mut u: u64 = 0;
    let mut sgn: i64 = 0;
    for k in @as(usize, 0)..512 {
        let mut c = h[k];
        if (k >= 148) and (k < 156) {
            c = ' ';
        }
        u += @as(u64, c);
        sgn += @as(i64, @bit_cast(i8, c));
    }
    if (u != want) and (@bit_cast(u64, sgn) != want) {
        return error.ChecksumMismatch;
    }
}

/// Extracts the files and directories of an archive under dir, refusing
/// names that would leave it or are longer than zip.MAX_NAME, and link
/// entries (other kinds are skipped).
pub fn extract_all(bytes: []u8, dir: []u8) TarError!void {
    // check first, so nothing is written from an unsafe archive
    let mut r = Reader.init(bytes);
    defer r.deinit();
    loop {
        let e = r.next() catch |err| {
            if err == error.Done {
                break;
            }
            return err;
        };
        if not zip.safe_name(e.name) or (e.kind == SYMLINK) or (e.kind == HARDLINK) {
            return error.UnsafePath;
        }
    }
    fs.mkdir_all(dir)!;
    let mut r2 = Reader.init(bytes);
    defer r2.deinit();
    loop {
        let e = r2.next() catch |err| {
            if err == error.Done {
                return;
            }
            return err;
        };
        let target = path.join2(dir, e.name)!;
        defer mem.free(target);
        if e.kind == DIR {
            fs.mkdir_all(target)!;
        } else if e.kind == FILE {
            let parent = path.dir(target);
            if parent.len > 0 {
                fs.mkdir_all(parent)!;
            }
            fs.write_file(target, e.data)!;
        }
    }
}

// -----------------------------------------------------------------------------
// Writing
// -----------------------------------------------------------------------------

pub struct Options {
    mode: u32,  // permission bits (default 0o644, 0o755 for directories)
    mtime: i64,
    uid: u64,
    gid: u64,
    uname: []u8,
    gname: []u8,

    pub fn default() Options {
        return Options.{ mode: 0, mtime: 0, uid: 0, gid: 0, uname: "", gname: "" };
    }
}

/// Writes a tar archive: add entries, then finish().
pub struct Writer {
    out: io.Writer,

    pub fn init(out: io.Writer) Writer {
        return Writer.{ out: out };
    }

    pub fn add_file(self: *mut Writer, name: []u8, data: []u8, opts: Options) !void {
        let mut o = opts;
        if o.mode == 0 {
            o.mode = 0o644;
        }
        self.entry(name, FILE, "", @as(u64, data.len), o)!;
        self.out.write_all(data)!;
        self.pad(data.len)!;
    }

    pub fn add_dir(self: *mut Writer, name: []u8, opts: Options) !void {
        let mut o = opts;
        if o.mode == 0 {
            o.mode = 0o755;
        }
        let mut n = strs.String.init();
        defer n.deinit();
        n.push_str(name)!;
        if not strs.ends_with(name, "/") {
            n.push('/')!;
        }
        return self.entry(n.bytes(), DIR, "", 0, o);
    }

    pub fn add_symlink(self: *mut Writer, name: []u8, target: []u8, opts: Options) !void {
        let mut o = opts;
        if o.mode == 0 {
            o.mode = 0o777;
        }
        return self.entry(name, SYMLINK, target, 0, o);
    }

    /// Writes the two zero blocks that end an archive.
    pub fn finish(self: *mut Writer) !void {
        let z: [1024]u8 = [0; 1024];
        self.out.write_all(z[..])!;
    }

    fn pad(self: *mut Writer, n: usize) !void {
        let z: [512]u8 = [0; 512];
        let r = n % 512;
        if r != 0 {
            self.out.write_all(z[..512 - r])!;
        }
    }

    fn entry(self: *mut Writer, name: []u8, kind: u8, link: []u8, size: u64, o: Options) !void {
        // what does not fit in a ustar header goes in pax records
        let mut pax = strs.String.init();
        defer pax.deinit();
        let mut prefix: []u8 = "";
        let mut short = name;
        if name.len > 100 {
            let cut = split_name(name);
            if cut == 0 {
                record(&mut pax, "path", name)!;
                short = name[name.len - @min(name.len, 99)..];
            } else {
                prefix = name[..cut];
                short = name[cut + 1..];
            }
        }
        if not ascii(name) and (pax.len == 0) {
            record(&mut pax, "path", name)!;
        }
        if (link.len > 100) or not ascii(link) {
            record(&mut pax, "linkpath", link)!;
        }
        if size >= 0o77777777777 {
            let mut b: [24]u8 = [0; 24];
            record(&mut pax, "size", io.fmt_u64(b[..], size))!;
        }
        if (o.mtime < 0) or (o.mtime >= 0o77777777777) {
            let mut b: [24]u8 = [0; 24];
            record(&mut pax, "mtime", io.fmt_i64(b[..], o.mtime))!;
        }
        if (o.uid >= 0o7777777) or (o.gid >= 0o7777777) {
            let mut b: [24]u8 = [0; 24];
            record(&mut pax, "uid", io.fmt_u64(b[..], o.uid))!;
            record(&mut pax, "gid", io.fmt_u64(b[..], o.gid))!;
        }
        if pax.len > 0 {
            let mut pn = strs.String.init();
            defer pn.deinit();
            pn.push_str("PaxHeaders/")!;
            let base = path.base(name);
            pn.push_str(base[..@min(base.len, 80)])!;
            let ph = header(pn.bytes(), "", 'x', "", @as(u64, pax.len), o)!;
            self.out.write_all(ph[..])!;
            self.out.write_all(pax.bytes())!;
            self.pad(pax.len)!;
        }
        let h = header(short, prefix, kind, link[..@min(link.len, 100)], size, o)!;
        self.out.write_all(h[..])!;
    }
}

fn ascii(s: []u8) bool {
    for c in s {
        if c >= 0x80 {
            return false;
        }
    }
    return true;
}

// Where to split a long name into prefix (<= 155) and name (<= 100), or 0.
fn split_name(name: []u8) usize {
    let mut i = @min(name.len - 1, 155);
    while i > 0 {
        if (name[i] == '/') and ((name.len - i - 1) <= 100) and ((name.len - i - 1) > 0) {
            return i;
        }
        i -= 1;
    }
    return 0;
}

// A pax record: "<length> key=value\n", where length counts itself.
fn record(out: *mut strs.String, key: []u8, v: []u8) !void {
    let body = key.len + v.len + 3;  // space, "=", newline
    let mut n = body + 1;
    loop {
        let mut digits: usize = 1;
        let mut x = n / 10;
        while x > 0 {
            digits += 1;
            x /= 10;
        }
        if (body + digits) == n {
            break;
        }
        n = body + digits;
    }
    fmt.write(out.writer(), "{} ", [fmt.int(n)])!;
    out.push_str(key)!;
    out.push('=')!;
    out.push_str(v)!;
    out.push('\n')!;
}

fn octal(b: []mut u8, v: u64) void {
    // width - 1 digits and a NUL
    let mut x = v;
    let mut i = b.len - 1;
    b[i] = 0;
    while i > 0 {
        i -= 1;
        b[i] = '0' + @truncate(u8, x & 7);
        x >>= 3;
    }
}

fn header(name: []u8, prefix: []u8, kind: u8, link: []u8, size: u64, o: Options) TarError![512]u8 {
    let mut h: [512]u8 = [0; 512];
    @mem_copy(h[..@min(name.len, 100)], name[..@min(name.len, 100)]);
    octal(h[100..108], @as(u64, o.mode & 0o7777));
    octal(h[108..116], @min(o.uid, 0o7777777));
    octal(h[116..124], @min(o.gid, 0o7777777));
    octal(h[124..136], @min(size, 0o77777777777));
    let mut mt: u64 = 0;
    if o.mtime > 0 {
        mt = @min(@bit_cast(u64, o.mtime), 0o77777777777);
    }
    octal(h[136..148], mt);
    h[156] = kind;
    @mem_copy(h[157..157 + link.len], link);
    @mem_copy(h[257..265], "ustar\x0000");
    @mem_copy(h[265..265 + @min(o.uname.len, 31)], o.uname[..@min(o.uname.len, 31)]);
    @mem_copy(h[297..297 + @min(o.gname.len, 31)], o.gname[..@min(o.gname.len, 31)]);
    octal(h[329..337], 0);
    octal(h[337..345], 0);
    @mem_copy(h[345..345 + @min(prefix.len, 155)], prefix[..@min(prefix.len, 155)]);
    // the checksum, counting its own field as spaces
    @mem_set(h[148..156], ' ');
    let mut sum: u64 = 0;
    for c in h {
        sum += @as(u64, c);
    }
    octal(h[148..155], sum);
    h[155] = ' ';
    return h;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn listing(bytes: []u8, out: *mut strs.String) !void {
    let mut r = Reader.init(bytes);
    defer r.deinit();
    loop {
        let e = r.next() catch |err| {
            if err == error.Done {
                return;
            }
            return err;
        };
        let mut kind: []u8 = "f";
        if e.kind == DIR {
            kind = "d";
        } else if e.kind == SYMLINK {
            kind = "l";
        }
        fmt.write(out.writer(), "{} {} {:o} {} {:08x} {}", [fmt.str(kind), fmt.int(e.data.len), fmt.int(e.mode),
                                                            fmt.int(e.mtime), fmt.int(deflate.crc32(0, e.data)),
                                                            fmt.str(e.name)])!;
        if e.kind == SYMLINK {
            out.push_str(" -> ")!;
            out.push_str(e.linkname)!;
        }
        out.push('\n')!;
    }
}

test "archives made by Python's tarfile" {
    for name in ["ustar", "gnu", "pax"] {
        let mut p = strs.String.init();
        defer p.deinit();
        fmt.write(p.writer(), "std/archive/tar/testdata/{}.tar.gz", [fmt.str(name)])!;
        let gz = fs.read_file(p.bytes()) catch return;
        defer mem.free(gz);
        let data = deflate.decompress(gz, deflate.Format.GZIP, 1 << 24)!;
        defer mem.free(data);
        p.truncate(p.len - 6);
        p.push_str("txt")!;
        let want = fs.read_file(p.bytes())!;
        defer mem.free(want);
        let mut got = strs.String.init();
        defer got.deinit();
        listing(data, &mut got)!;
        if not strs.eq(got.bytes(), want) {
            fmt.print("{}:\n{}\nwant\n{}\n", [fmt.str(name), fmt.str(got.bytes()), fmt.str(want)]) catch {};
        }
        @expect_eq(got.bytes(), want);
    }
}

test "writing and reading back" {
    let mut s = strs.String.init();
    defer s.deinit();
    let mut w = Writer.init(s.writer());
    let mut o = Options.default();
    o.mtime = 1700000000;
    o.uname = "me";
    let mut long = strs.String.init();
    defer long.deinit();
    for _k in @as(usize, 0)..30 {
        long.push_str("segment/")!;
    }
    long.push_str("file.txt")!;  // 248 bytes: splits into prefix and name
    let mut longer = strs.String.init();
    defer longer.deinit();
    longer.push_str(long.bytes())!;
    longer.push_str("-and-a-very-long-last-part-that-cannot-be-split-anywhere-at-all-because-it-has-no-slash-in-it-at-all")!;
    w.add_dir("d", o)!;
    w.add_file("d/a.txt", "hello\n", o)!;
    w.add_file(long.bytes(), "L", o)!;
    w.add_file(longer.bytes(), "LL", o)!;
    w.add_file("caf\xc3\xa9", "", o)!;
    o.mtime = -86400;
    w.add_symlink("lnk", "d/a.txt", o)!;
    w.finish()!;
    @expect_eq(s.len % 512, 0);
    let mut got = strs.String.init();
    defer got.deinit();
    listing(s.bytes(), &mut got)!;
    let mut want = strs.String.init();
    defer want.deinit();
    fmt.write(want.writer(),
              "d 0 755 1700000000 00000000 d\nf 6 644 1700000000 363a3020 d/a.txt\nf 1 644 1700000000 {:08x} {}\nf 2 644 1700000000 {:08x} {}\nf 0 644 1700000000 00000000 caf\xc3\xa9\nl 0 777 -86400 00000000 lnk -> d/a.txt\n",
              [fmt.int(deflate.crc32(0, "L")), fmt.str(long.bytes()), fmt.int(deflate.crc32(0, "LL")),
               fmt.str(longer.bytes())])!;
    @expect_eq(got.bytes(), want.bytes());
}

fn fails_all(bytes: []u8) bool {
    let mut r = Reader.init(bytes);
    defer r.deinit();
    loop {
        _ = r.next() catch |e| {
            return e != error.Done;
        };
    }
}

test "hostile archives" {
    let mut s = strs.String.init();
    defer s.deinit();
    let mut w = Writer.init(s.writer());
    w.add_file("f", "data", Options.default())!;
    w.finish()!;
    let good = s.bytes();
    @expect(not fails_all(good));
    let mut bad = strs.String.from(good)!;
    defer bad.deinit();
    bad.bytes()[0] = 'g';  // checksum no longer matches
    @expect(fails_all(bad.bytes()));
    @expect(fails_all(good[..300]));
    // a size far past the end
    let mut big = strs.String.init();
    defer big.deinit();
    let mut w2 = Writer.init(big.writer());
    w2.add_file("f", "x", Options.default())!;
    let b = big.bytes();
    @mem_copy(b[124..136], "77777777777\x00");
    let mut sum: u64 = 0;
    @mem_set(b[148..156], ' ');
    for k in @as(usize, 0)..512 {
        sum += @as(u64, b[k]);
    }
    octal(b[148..155], sum);
    @expect(fails_all(b));
    // unsafe names are refused before anything is written
    let mut u = strs.String.init();
    defer u.deinit();
    let mut w3 = Writer.init(u.writer());
    w3.add_file("../escape", "x", Options.default())!;
    w3.finish()!;
    @expect(fails_extract(u.bytes()));
    @expect(not fs.exists("../escape"));
    // nor are names past zip.MAX_NAME, deep or not
    let mut deep = strs.String.init();
    defer deep.deinit();
    while deep.len <= zip.MAX_NAME {
        deep.push_str("a/")!;
    }
    deep.push_str("f")!;
    let mut v = strs.String.init();
    defer v.deinit();
    let mut w4 = Writer.init(v.writer());
    w4.add_file(deep.bytes(), "x", Options.default())!;
    w4.finish()!;
    @expect(fails_extract(v.bytes()));
}

fn fails_extract(b: []u8) bool {
    extract_all(b, "tar-test-out-never-created") catch return true;
    return false;
}
