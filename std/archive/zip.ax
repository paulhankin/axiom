// =============================================================================
// std/archive/zip.ax - ZIP archives: reading and writing.
//
//     let mut a = zip.Archive.open(bytes)!;             // reading
//     defer a.deinit();
//     for e in a.entries { ... e.name ... e.size ... }
//     let data = a.extract(a.find("docs/readme.txt")!)!;   // (the caller frees it)
//     a.extract_all("out/dir")!;                        // to the filesystem
//
//     let mut s = strs.String.init();                   // writing
//     let mut w = zip.Writer.init(s.writer());
//     w.add("hello.txt", "Hello\n", zip.Options.default())!;
//     w.add_dir("empty/")!;
//     w.finish()!;
//     w.deinit();
//
// Reading follows the central directory, with ZIP64 for big archives,
// archive comments and UTF-8 names; entries may be stored or deflated
// (other methods, and encrypted entries, fail with Unsupported). Every
// entry's CRC-32 and size are checked, and extraction never produces more
// than the size an entry declares, so "zip bombs" cannot run away.
// extract_all refuses names that would leave the target directory
// (absolute paths, "..", drive letters: "zip slip"), and symbolic links.
//
// Writing deflates (or stores, when that is smaller or asked for) each
// entry, records Unix permissions and modification times, and switches to
// ZIP64 records only when sizes, offsets or the number of entries need it.
// =============================================================================

import "../collections/vec.ax" as vec;
import "../compress/deflate.ax" as deflate;
import "../fmt.ax" as fmt;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../os/fs.ax" as fs;
import "../os/path.ax" as path;
import "../str.ax" as strs;
import "../time.ax" as time;

error { NotZip, Corrupt, Unsupported, ChecksumMismatch, TooLarge, UnsafePath, NotFound, OutOfMemory }

pub const STORE: u16 = 0;
pub const DEFLATE: u16 = 8;

const SIG_LOCAL: u32 = 0x04034b50;
const SIG_CENTRAL: u32 = 0x02014b50;
const SIG_END: u32 = 0x06054b50;
const SIG_END64: u32 = 0x06064b50;
const SIG_LOC64: u32 = 0x07064b50;

pub struct Entry {
    name: []u8,  // with "/" separators; directories end in "/"
    method: u16,
    flags: u16,
    crc: u32,
    csize: u64,   // compressed size
    size: u64,    // uncompressed size
    offset: u64,  // of the local header
    mtime: i64,   // Unix time (from the DOS time, taken as UTC, or an extended timestamp)
    mode: u32,    // Unix mode bits (file type and permissions), or 0 if not recorded
    comment: []u8,

    pub fn is_dir(self: Entry) bool {
        return strs.ends_with(self.name, "/") or ((self.mode & 0o170000) == 0o040000);
    }

    pub fn is_symlink(self: Entry) bool {
        return (self.mode & 0o170000) == 0o120000;
    }

    pub fn encrypted(self: Entry) bool {
        return (self.flags & 1) != 0;
    }
}

fn le16(b: []u8, at: usize) u16 {
    return @as(u16, b[at]) | (@as(u16, b[at + 1]) << 8);
}

fn le32(b: []u8, at: usize) u32 {
    return @as(u32, le16(b, at)) | (@as(u32, le16(b, at + 2)) << 16);
}

fn le64(b: []u8, at: usize) u64 {
    return @as(u64, le32(b, at)) | (@as(u64, le32(b, at + 4)) << 32);
}

/// A zip archive in memory (the bytes must outlive it).
pub struct Archive {
    data: []u8,
    entries: []Entry,
    comment: []u8,
    list: vec.Vec.[Entry],

    /// Reads the central directory.
    pub fn open(data: []u8) !Archive {
        let mut a = Archive.{ data: data, entries: @slice_from_ptr(@ptr_from_int(*Entry, 8), 0), comment: "",
                              list: vec.Vec.[Entry].init() };
        a.read_directory() catch |e| {
            a.list.deinit();
            return e;
        };
        a.entries = a.list.items();
        return a;
    }

    pub fn deinit(self: *mut Archive) void {
        self.list.deinit();
    }

    fn read_directory(self: *mut Archive) !void {
        let d = self.data;
        if d.len < 22 {
            return error.NotZip;
        }
        // the end of central directory record: the last one, within the
        // 64 KiB a comment may take
        let mut e = d.len - 22;
        let lowest = d.len - @min(d.len, 22 + 65535);
        loop {
            if (le32(d, e) == SIG_END) and ((e + 22 + @as(usize, le16(d, e + 20))) <= d.len) {
                break;
            }
            if e == lowest {
                return error.NotZip;
            }
            e -= 1;
        }
        let clen = @as(usize, le16(d, e + 20));
        self.comment = d[e + 22..e + 22 + clen];
        let mut count = @as(u64, le16(d, e + 10));
        let mut cd_size = @as(u64, le32(d, e + 12));
        let mut cd_off = @as(u64, le32(d, e + 16));
        // ZIP64: a locator just before the record points to the real numbers
        if (e >= 20) and (le32(d, e - 20) == SIG_LOC64) {
            let r = le64(d, e - 12);
            if (r > @as(u64, d.len - 56)) or (le32(d, @truncate(usize, r)) != SIG_END64) {
                return error.Corrupt;
            }
            let ri = @truncate(usize, r);
            count = le64(d, ri + 32);
            cd_size = le64(d, ri + 40);
            cd_off = le64(d, ri + 48);
        }
        if (cd_off > @as(u64, d.len)) or (cd_size > (@as(u64, d.len) - cd_off)) {
            return error.Corrupt;
        }
        if count > (cd_size / 46) {
            return error.Corrupt;
        }
        let mut p = @truncate(usize, cd_off);
        let end = p + @truncate(usize, cd_size);
        self.list.reserve(@truncate(usize, count))!;
        for _k in @as(u64, 0)..count {
            if ((p + 46) > end) or (le32(d, p) != SIG_CENTRAL) {
                return error.Corrupt;
            }
            let nlen = @as(usize, le16(d, p + 28));
            let xlen = @as(usize, le16(d, p + 30));
            let klen = @as(usize, le16(d, p + 32));
            if (p + 46 + nlen + xlen + klen) > end {
                return error.Corrupt;
            }
            let made_by = le16(d, p + 4) >> 8;
            let mut ent = Entry.{ name: d[p + 46..p + 46 + nlen], method: le16(d, p + 10), flags: le16(d, p + 8),
                                  crc: le32(d, p + 16), csize: @as(u64, le32(d, p + 20)), size: @as(
                                      u64, le32(d, p + 24)), offset: @as(u64, le32(d, p + 42)), mtime: dos_time(
                                          le16(d, p + 12), le16(d, p + 14)), mode: 0,
                                  comment: d[p + 46 + nlen + xlen..p + 46 + nlen + xlen + klen] };
            if made_by == 3 {
                ent.mode = le32(d, p + 38) >> 16;  // made on Unix: the mode is in the high bits
            }
            extra_fields(d[p + 46 + nlen..p + 46 + nlen + xlen], &mut ent)!;
            self.list.push(ent)!;
            p += 46 + nlen + xlen + klen;
        }
    }

    /// The entry with this name.
    pub fn find(self: *Archive, name: []u8) !Entry {
        for e in self.entries {
            if strs.eq(e.name, name) {
                return e;
            }
        }
        return error.NotFound;
    }

    /// An entry's compressed bytes (as stored in the archive).
    pub fn raw(self: *Archive, e: Entry) ![]u8 {
        let d = self.data;
        if (e.offset > @as(u64, d.len - @min(d.len, 30))) or (le32(d, @truncate(usize, e.offset)) != SIG_LOCAL) {
            return error.Corrupt;
        }
        let o = @truncate(usize, e.offset);
        let st = o + 30 + @as(usize, le16(d, o + 26)) + @as(usize, le16(d, o + 28));
        if (st > d.len) or (e.csize > @as(u64, d.len - st)) {
            return error.Corrupt;
        }
        return d[st..st + @truncate(usize, e.csize)];
    }

    /// An entry's contents, checked against its size and CRC-32; the caller
    /// frees them.
    pub fn extract(self: *Archive, e: Entry) ![]mut u8 {
        if e.encrypted() {
            return error.Unsupported;
        }
        let src = self.raw(e)!;
        if e.size > @as(u64, 0xffffffffffff) {
            return error.TooLarge;
        }
        let n = @truncate(usize, e.size);
        let mut out: []mut u8 = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
        if e.method == STORE {
            if e.csize != e.size {
                return error.Corrupt;
            }
            out = mem.alloc.[u8](n)!;
            @mem_copy(out, src);
        } else if e.method == DEFLATE {
            out = deflate.decompress(src, deflate.Format.RAW, n) catch |err| {
                if err == error.TooLarge {
                    return error.Corrupt;  // more than it declares
                }
                if err == error.OutOfMemory {
                    return err;
                }
                return error.Corrupt;
            };
            if out.len != n {
                mem.free(out);
                return error.Corrupt;
            }
        } else {
            return error.Unsupported;
        }
        if deflate.crc32(0, out) != e.crc {
            mem.free(out);
            return error.ChecksumMismatch;
        }
        return out;
    }

    /// Extracts every entry under dir (created if need be), refusing names
    /// that would leave it, and symbolic links.
    pub fn extract_all(self: *Archive, dir: []u8) !void {
        fs.mkdir_all(dir)!;
        for e in self.entries {
            if not safe_name(e.name) or e.is_symlink() {
                return error.UnsafePath;
            }
        }
        for e in self.entries {
            let target = path.join2(dir, e.name)!;
            defer mem.free(target);
            if e.is_dir() {
                fs.mkdir_all(target)!;
                continue;
            }
            let parent = path.dir(target);
            if parent.len > 0 {
                fs.mkdir_all(parent)!;
            }
            let data = self.extract(e)!;
            defer mem.free(data);
            fs.write_file(target, data)!;
        }
    }
}

/// Whether an entry name stays inside the directory it is extracted to:
/// relative, without "..", backslashes or drive letters.
pub fn safe_name(name: []u8) bool {
    if (name.len == 0) or (name[0] == '/') or strs.contains(name, "\\") or strs.contains(name, "\x00") {
        return false;
    }
    if (name.len >= 2) and (name[1] == ':') {
        return false;
    }
    let mut it = strs.split(name, "/");
    while true {
        let part = it.next() catch break;
        if strs.eq(part, "..") {
            return false;
        }
    }
    return true;
}

// The ZIP64 sizes and offset, and an extended timestamp.
fn extra_fields(x: []u8, e: *mut Entry) !void {
    let mut i: usize = 0;
    while (i + 4) <= x.len {
        let id = le16(x, i);
        let n = @as(usize, le16(x, i + 2));
        if (i + 4 + n) > x.len {
            return error.Corrupt;
        }
        let f = x[i + 4..i + 4 + n];
        if id == 0x0001 {
            // only the fields whose 32-bit values are saturated are present
            let mut j: usize = 0;
            if e.size == 0xffffffff {
                if (j + 8) > f.len {
                    return error.Corrupt;
                }
                e.size = le64(f, j);
                j += 8;
            }
            if e.csize == 0xffffffff {
                if (j + 8) > f.len {
                    return error.Corrupt;
                }
                e.csize = le64(f, j);
                j += 8;
            }
            if e.offset == 0xffffffff {
                if (j + 8) > f.len {
                    return error.Corrupt;
                }
                e.offset = le64(f, j);
            }
        } else if (id == 0x5455) and (n >= 5) and ((f[0] & 1) != 0) {
            e.mtime = @as(i64, @bit_cast(i32, le32(f, 1)));
        }
        i += 4 + n;
    }
}

// A DOS date and time, taken as UTC.
fn dos_time(t: u16, d: u16) i64 {
    let year = 1980 + @as(i64, d >> 9);
    let mut month = @as(u32, (d >> 5) & 15);
    let mut day = @as(u32, d & 31);
    if (month < 1) or (month > 12) {
        month = 1;
    }
    if day < 1 {
        day = 1;
    }
    let days = time.days_from_civil(year, month, day);
    return (days * 86400) + (@as(i64, t >> 11) * 3600) + (@as(i64, (t >> 5) & 63) * 60) + (@as(i64, t & 31) * 2);
}

// The DOS time and date for a Unix time (clamped to 1980..2107).
fn to_dos(unix: i64, t: *mut u16, d: *mut u16) void {
    let mut s = unix;
    let lo = time.days_from_civil(1980, 1, 1) * 86400;
    let hi = time.days_from_civil(2107, 12, 31) * 86400;
    s = @max(lo, @min(s, hi));
    let dt = time.Time.from_unix(s, 0).utc();
    t.* = @truncate(u16, (dt.hour << 11) | (dt.minute << 5) | (dt.second / 2));
    d.* = @truncate(u16, (@as(u32, @truncate(u16, @bit_cast(u64, dt.year - 1980))) << 9) | (dt.month << 5) | dt.day);
}

// -----------------------------------------------------------------------------
// Writing
// -----------------------------------------------------------------------------

pub struct Options {
    method: u16,  // DEFLATE (stored instead when that is no bigger) or STORE
    level: u32,   // deflate level, 1 to 9
    mtime: i64,   // Unix time
    mode: u32,    // Unix permissions (0o644 by default)

    pub fn default() Options {
        return Options.{ method: DEFLATE, level: deflate.DEFAULT_LEVEL, mtime: 315532800, mode: 0o644 };
    }
}

struct Written {
    name: []mut u8,  // owned
    method: u16,
    crc: u32,
    csize: u64,
    size: u64,
    offset: u64,
    dtime: u16,
    ddate: u16,
    mode: u32,
    mtime: i64,
}

/// Writes a zip archive to a stream: add entries, then finish(), then
/// deinit().
pub struct Writer {
    out: io.Writer,
    offset: u64,
    written: vec.Vec.[Written],
    comment: []u8,  // the archive comment (at most 65535 bytes)

    pub fn init(out: io.Writer) Writer {
        return Writer.{ out: out, offset: 0, written: vec.Vec.[Written].init(), comment: "" };
    }

    fn put(self: *mut Writer, b: []u8) !void {
        self.out.write_all(b)!;
        self.offset += @as(u64, b.len);
    }

    /// Adds a file.
    pub fn add(self: *mut Writer, name: []u8, data: []u8, opts: Options) !void {
        let mut method = opts.method;
        let mut packed: []mut u8 = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
        if method == DEFLATE {
            packed = deflate.compress(data, deflate.Format.RAW, opts.level)!;
            if packed.len >= data.len {
                mem.free(packed);
                packed = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
                method = STORE;
            }
        } else if method != STORE {
            return error.Unsupported;
        }
        defer {
            if packed.len > 0 {
                mem.free(packed);
            }
        }
        let mut body = data;
        if method == DEFLATE {
            body = packed;
        }
        self.entry(name, method, deflate.crc32(0, data), @as(u64, data.len), body, opts.mtime,
                   0o100000 | (opts.mode & 0o7777))!;
    }

    /// Adds a directory (its name should end in "/").
    pub fn add_dir(self: *mut Writer, name: []u8) !void {
        let mut o = Options.default();
        o.mode = 0o755;
        return self.entry(name, STORE, 0, 0, "", o.mtime, 0o040755);
    }

    fn entry(self: *mut Writer, name: []u8, method: u16, crc: u32, size: u64, body: []u8, mtime: i64, mode: u32) !void {
        if name.len > 65535 {
            return error.TooLarge;
        }
        let mut w = Written.{ name: strs.dup(name)!, method: method, crc: crc, csize: @as(u64, body.len), size: size,
                              offset: self.offset, dtime: 0, ddate: 0, mode: mode, mtime: mtime };
        to_dos(mtime, &mut w.dtime, &mut w.ddate);
        self.written.push(w) catch |e| {
            mem.free(w.name);
            return e;
        };
        let big = (size >= 0xffffffff) or (w.csize >= 0xffffffff);
        let mut h = Buf.{ b: [0; 64], n: 0 };
        h.put32(SIG_LOCAL);
        if big {
            h.put16(45);
        } else {
            h.put16(20);
        }
        h.put16(0x0800);  // UTF-8 names
        h.put16(method);
        h.put16(w.dtime);
        h.put16(w.ddate);
        h.put32(crc);
        if big {
            h.put32(0xffffffff);
            h.put32(0xffffffff);
        } else {
            h.put32(@truncate(u32, w.csize));
            h.put32(@truncate(u32, size));
        }
        h.put16(@truncate(u16, name.len));
        if big {
            h.put16(20);
        } else {
            h.put16(0);
        }
        self.put(h.bytes())!;
        self.put(name)!;
        if big {
            let mut x = Buf.{ b: [0; 64], n: 0 };
            x.put16(0x0001);
            x.put16(16);
            x.put64(size);
            x.put64(w.csize);
            self.put(x.bytes())!;
        }
        self.put(body)!;
    }

    /// Writes the central directory. The Writer can then be dropped.
    pub fn finish(self: *mut Writer) !void {
        let cd_start = self.offset;
        for w in self.written.items() {
            let need_size = (w.size >= 0xffffffff) or (w.csize >= 0xffffffff);
            let need_off = w.offset >= 0xffffffff;
            let mut x = Buf.{ b: [0; 64], n: 0 };
            if need_size or need_off {
                x.put16(0x0001);
                let mut n: u16 = 0;
                if need_size {
                    n += 16;
                }
                if need_off {
                    n += 8;
                }
                x.put16(n);
                if need_size {
                    x.put64(w.size);
                    x.put64(w.csize);
                }
                if need_off {
                    x.put64(w.offset);
                }
            }
            let mut h = Buf.{ b: [0; 64], n: 0 };
            h.put32(SIG_CENTRAL);
            h.put16(0x0300 | 45);  // made by Unix, version 4.5
            if need_size or need_off {
                h.put16(45);
            } else {
                h.put16(20);
            }
            h.put16(0x0800);
            h.put16(w.method);
            h.put16(w.dtime);
            h.put16(w.ddate);
            h.put32(w.crc);
            if need_size {
                h.put32(0xffffffff);
                h.put32(0xffffffff);
            } else {
                h.put32(@truncate(u32, w.csize));
                h.put32(@truncate(u32, w.size));
            }
            h.put16(@truncate(u16, w.name.len));
            h.put16(@truncate(u16, x.n));
            h.put16(0);  // comment
            h.put16(0);  // disk
            h.put16(0);  // internal attributes
            let mut dos_attr: u32 = 0;
            if (w.mode & 0o170000) == 0o040000 {
                dos_attr = 0x10;
            }
            h.put32((w.mode << 16) | dos_attr);
            if need_off {
                h.put32(0xffffffff);
            } else {
                h.put32(@truncate(u32, w.offset));
            }
            self.put(h.bytes())!;
            self.put(w.name)!;
            self.put(x.bytes())!;
        }
        let cd_size = self.offset - cd_start;
        let count = @as(u64, self.written.len);
        let need64 = (count >= 0xffff) or (cd_size >= 0xffffffff) or (cd_start >= 0xffffffff);
        if need64 {
            let rec = self.offset;
            let mut z = Buf.{ b: [0; 64], n: 0 };
            z.put32(SIG_END64);
            z.put64(44);
            z.put16(45);
            z.put16(45);
            z.put32(0);
            z.put32(0);
            z.put64(count);
            z.put64(count);
            z.put64(cd_size);
            z.put64(cd_start);
            self.put(z.bytes())!;
            let mut l = Buf.{ b: [0; 64], n: 0 };
            l.put32(SIG_LOC64);
            l.put32(0);
            l.put64(rec);
            l.put32(1);
            self.put(l.bytes())!;
        }
        let mut e = Buf.{ b: [0; 64], n: 0 };
        e.put32(SIG_END);
        e.put16(0);
        e.put16(0);
        e.put16(@truncate(u16, @min(count, 0xffff)));
        e.put16(@truncate(u16, @min(count, 0xffff)));
        e.put32(@truncate(u32, @min(cd_size, 0xffffffff)));
        e.put32(@truncate(u32, @min(cd_start, 0xffffffff)));
        let c = self.comment[..@min(self.comment.len, 65535)];
        e.put16(@truncate(u16, c.len));
        self.put(e.bytes())!;
        self.put(c)!;
    }

    /// Frees the Writer's records (after finish, or to give up).
    pub fn deinit(self: *mut Writer) void {
        for w in self.written.items() {
            mem.free(w.name);
        }
        self.written.deinit();
    }
}

struct Buf {
    b: [64]u8,
    n: usize,

    fn put16(self: *mut Buf, v: u16) void {
        self.b[self.n] = @truncate(u8, v);
        self.b[self.n + 1] = @truncate(u8, v >> 8);
        self.n += 2;
    }

    fn put32(self: *mut Buf, v: u32) void {
        self.put16(@truncate(u16, v));
        self.put16(@truncate(u16, v >> 16));
    }

    fn put64(self: *mut Buf, v: u64) void {
        self.put32(@truncate(u32, v));
        self.put32(@truncate(u32, v >> 32));
    }

    fn bytes(self: *Buf) []u8 {
        return self.b[..self.n];
    }
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

// The listing format of tools/gen_archive_tests.py.
fn listing(a: *Archive, out: *mut strs.String) !void {
    for e in a.entries {
        let data = a.extract(e)!;
        defer mem.free(data);
        let mut kind: []u8 = "f";
        if e.is_dir() {
            kind = "d";
        }
        fmt.write(out.writer(), "{} {} {:o} {} {:08x} {}\n", [fmt.str(kind), fmt.int(e.size), fmt.int(e.mode & 0o7777),
                                                              fmt.int(e.mtime), fmt.int(deflate.crc32(0, data)),
                                                              fmt.str(e.name)])!;
    }
}

test "archives made by Python's zipfile" {
    for name in ["stored", "deflated", "zip64"]{
        let mut zp = strs.String.init();
        defer zp.deinit();
        fmt.write(zp.writer(), "std/archive/zip/testdata/{}.zip", [fmt.str(name)])!;
        let data = fs.read_file(zp.bytes()) catch return;
        defer mem.free(data);
        zp.truncate(zp.len - 3);
        zp.push_str("txt")!;
        let want = fs.read_file(zp.bytes())!;
        defer mem.free(want);
        let mut a = Archive.open(data)!;
        defer a.deinit();
        @expect_eq(a.comment, "made by tools/gen_archive_tests.py");
        let mut got = strs.String.init();
        defer got.deinit();
        listing(&a, &mut got)!;
        @expect_eq(got.bytes(), want);
        let h = a.extract(a.find("hello.txt")!)!;
        defer mem.free(h);
        @expect_eq(h, "Hello, world!\n");
    }
}

test "writing and reading back" {
    let mut s = strs.String.init();
    defer s.deinit();
    let mut w = Writer.init(s.writer());
    let mut big = strs.String.init();
    defer big.deinit();
    for k in @as(usize, 0)..20000 {
        big.push(@truncate(u8, (k * k) >> 3))!;
    }
    let mut o = Options.default();
    o.mtime = 1700000000;
    w.add("a/b.txt", "text text text text text text\n", o)!;
    w.add("big.bin", big.bytes(), o)!;
    w.add("tiny", "x", o)!;  // (stored: deflate would be bigger)
    o.method = STORE;
    o.mode = 0o755;
    w.add("run.sh", "#!/bin/sh\n", o)!;
    w.add_dir("empty/")!;
    w.comment = "hi";
    w.finish()!;
    w.deinit();
    let mut a = Archive.open(s.bytes())!;
    defer a.deinit();
    @expect_eq(a.entries.len, 5);
    @expect_eq(a.comment, "hi");
    let e = a.find("big.bin")!;
    @expect_eq(e.method, DEFLATE);
    @expect_eq(e.mtime, 1700000000);
    let b = a.extract(e)!;
    defer mem.free(b);
    @expect_eq(b, big.bytes());
    @expect_eq(a.find("tiny")!.method, STORE);
    @expect_eq(a.find("run.sh")!.mode, 0o100755);
    @expect(a.find("empty/")!.is_dir());
}

fn fails_open(data: []u8) bool {
    let mut a = Archive.open(data) catch return true;
    a.deinit();
    return false;
}

test "hostile archives" {
    // a small archive to damage
    let mut s = strs.String.init();
    defer s.deinit();
    let mut w = Writer.init(s.writer());
    let mut zeros = strs.String.init();
    defer zeros.deinit();
    for _k in @as(usize, 0)..100000 {
        zeros.push(0)!;
    }
    w.add("z", zeros.bytes(), Options.default())!;
    w.finish()!;
    w.deinit();
    let good = s.bytes();
    // a declared size smaller than the data: never inflated past it
    let mut bomb = strs.String.from(good)!;
    defer bomb.deinit();
    let b = bomb.bytes();
    let cd = strs.last_index_of(b, "PK\x01\x02")!;
    b[cd + 24] = 100;  // uncompressed size 100
    b[cd + 25] = 0;
    b[cd + 26] = 0;
    let mut a = Archive.open(b)!;
    defer a.deinit();
    @expect(fails_extract(&a, a.entries[0]));
    // a damaged CRC
    let mut bad = strs.String.from(good)!;
    defer bad.deinit();
    bad.bytes()[cd + 16] ^= 1;
    let mut a2 = Archive.open(bad.bytes())!;
    defer a2.deinit();
    @expect(fails_extract(&a2, a2.entries[0]));
    // truncations anywhere
    for n in @as(usize, 0)..good.len {
        let mut t = Archive.open(good[..n]) catch continue;
        for e in t.entries {
            let x = t.extract(e) catch continue;
            mem.free(x);
        }
        t.deinit();
    }
    @expect(fails_open("PK\x05\x06"));
    @expect(fails_open("not a zip file at all, not at all, no"));
    // names that would escape
    for n in ["../x", "/etc/passwd", "a/../../x", "c:/x", "a\\b"]{
        @expect(not safe_name(n));
    }
    @expect(safe_name("a/b..c/d"));
}

fn fails_extract(a: *Archive, e: Entry) bool {
    let x = a.extract(e) catch return true;
    mem.free(x);
    return false;
}
