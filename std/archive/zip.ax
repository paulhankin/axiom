// =============================================================================
// std/archive/zip.ax - ZIP archives: reading and writing.
//
//     let mut a = zip.Archive.open(bytes)!;             // reading
//     defer a.deinit();
//     for e in a.entries { ... e.name ... e.size ... }
//     let data = a.extract(a.find("docs/readme.txt")!)!;   // (the caller frees it)
//     a.extract_all("out/dir", 1 << 30)!;               // to the filesystem (at most 1 GiB)
//
//     let mut s = strs.String.init();                   // writing
//     let mut w = zip.Writer.init(s.writer());
//     w.add("hello.txt", "Hello\n", zip.Options.default())!;
//     w.add_dir("empty/")!;
//     w.finish()!;
//     w.deinit();
//
// Reading follows the central directory, with ZIP64 for big archives,
// archive comments and UTF-8 names; entries may be stored or deflated
// (other methods fail with Unsupported). Every entry's CRC-32 and size are
// checked, extraction never produces more than the size an entry
// declares, entries cannot share their bytes (open fails with Corrupt), and
// extract_all takes a limit on the sizes' sum, so "zip bombs" cannot run
// away.
//
// Encrypted entries (extract fails with PasswordRequired) are read with
// extract_password / extract_all_password: WinZip AES (AE-1 and AE-2, 128,
// 192 and 256-bit keys, the MAC checked before anything is decrypted) and
// the traditional PKWARE encryption ("ZipCrypto", which is weak: anyone can
// break it, so treat it as obfuscation). A wrong password fails with
// WrongPassword (for ZipCrypto, 1 in 256 wrong ones get past the check
// byte and fail the CRC instead). Options.password writes entries with
// AES-256 (AE-2), as 7-Zip, WinZip and pyzipper read them.
// extract_all refuses names that would leave the target directory
// (absolute paths, "..", drive letters: "zip slip"), and symbolic links.
//
// Writing deflates (or stores, when that is smaller or asked for) each
// entry, records Unix permissions and modification times, and switches to
// ZIP64 records only when sizes, offsets or the number of entries need it.
// =============================================================================

import "../collections/vec.ax" as vec;
import "../compress/deflate.ax" as deflate;
import "../crypto/aes.ax" as aes;
import "../crypto/hmac.ax" as hmac;
import "../crypto/kdf.ax" as kdf;
import "../crypto/random.ax" as random;
import "../crypto/sha2.ax" as sha2;
import "../crypto/subtle.ax" as subtle;
import "../encoding/binary.ax" as binary;
import "../fmt.ax" as fmt;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../os/fs.ax" as fs;
import "../os/path.ax" as path;
import "../str.ax" as strs;
import "../time.ax" as time;

pub error ZipError { NotZip, Corrupt, Unsupported, ChecksumMismatch, TooLarge, UnsafePath, NotFound, OutOfMemory,
                     PasswordRequired, WrongPassword, Done, BadFormat, Empty, Truncated, IoError, RandomFailed,
                     PermissionDenied, BadPattern, InvalidUtf8, InvalidNumber, Exists, Overflow, EndOfStream,
                     NotADirectory, NoSpaceLeft, IsDirectory, NotEmpty, InvalidArgument, Failed }

pub const STORE: u16 = 0;
pub const DEFLATE: u16 = 8;
/// The method of WinZip AES entries (the real one is in Entry.aes_method).
pub const AES: u16 = 99;
/// The longest entry name `safe_name` accepts, in bytes.
pub const MAX_NAME: usize = 4096;

const SIG_LOCAL: u32 = 0x04034b50;
const SIG_CENTRAL: u32 = 0x02014b50;
const SIG_END: u32 = 0x06054b50;
const SIG_END64: u32 = 0x06064b50;
const SIG_LOC64: u32 = 0x07064b50;

pub struct Entry {
    name: []u8,  // with "/" separators; directories end in "/"
    method: u16,
    flags: u16,
    crc: u32,
    csize: u64,   // compressed size
    size: u64,    // uncompressed size
    offset: u64,  // of the local header
    mtime: i64,   // Unix time (from the DOS time, taken as UTC, or an extended timestamp)
    mode: u32,    // Unix mode bits (file type and permissions), or 0 if not recorded
    comment: []u8,
    aes_strength: u8,  // WinZip AES: 1, 2 or 3 for 128, 192 or 256-bit keys (0: not AES)
    aes_version: u16,  // 1 (AE-1: the CRC-32 is checked) or 2 (AE-2: it is not recorded)
    aes_method: u16,   // the compression method under the encryption

    pub fn is_dir(self: Entry) bool {
        return strs.ends_with(self.name, "/") or ((self.mode & 0o170000) == 0o040000);
    }

    pub fn is_symlink(self: Entry) bool {
        return (self.mode & 0o170000) == 0o120000;
    }

    pub fn encrypted(self: Entry) bool {
        return (self.flags & 1) != 0;
    }
}

/// A zip archive in memory (the bytes must outlive it).
pub struct Archive {
    data: []u8,
    entries: []Entry,
    comment: []u8,
    list: vec.Vec.[Entry],

    /// Reads the central directory.
    pub fn open(data: []u8) ZipError!Archive {
        let mut a = Archive.{ data: data, entries: @slice_from_ptr(@ptr_from_int(*Entry, 8), 0), comment: "",
                              list: vec.Vec.[Entry].init() };
        a.read_directory() catch |e| {
            a.list.deinit();
            return e;
        };
        a.entries = a.list.items();
        return a;
    }

    pub fn deinit(self: *mut Archive) void {
        self.list.deinit();
    }

    fn read_directory(self: *mut Archive) ZipError!void {
        let d = self.data;
        if d.len < 22 {
            return error.NotZip;
        }
        // the end of central directory record: the last one, within the
        // 64 KiB a comment may take
        let mut e = d.len - 22;
        let lowest = d.len - @min(d.len, 22 + 65535);
        loop {
            if (binary.u32_le(d[e..]) == SIG_END) and ((e + 22 + @as(usize, binary.u16_le(d[e + 20..]))) <= d.len) {
                break;
            }
            if e == lowest {
                return error.NotZip;
            }
            e -= 1;
        }
        let clen = @as(usize, binary.u16_le(d[e + 20..]));
        self.comment = d[e + 22..e + 22 + clen];
        let mut count = @as(u64, binary.u16_le(d[e + 10..]));
        let mut cd_size = @as(u64, binary.u32_le(d[e + 12..]));
        let mut cd_off = @as(u64, binary.u32_le(d[e + 16..]));
        // ZIP64: a locator just before the record points to the real numbers
        if (e >= 20) and (binary.u32_le(d[e - 20..]) == SIG_LOC64) {
            let r = binary.u64_le(d[e - 12..]);
            // (the 56-byte ZIP64 record comes before the locator)
            if (e < (20 + 56)) or (r > @as(u64, e - (20 + 56))) or
               (binary.u32_le(d[@truncate(usize, r)..]) != SIG_END64) {
                return error.Corrupt;
            }
            let ri = @truncate(usize, r);
            count = binary.u64_le(d[ri + 32..]);
            cd_size = binary.u64_le(d[ri + 40..]);
            cd_off = binary.u64_le(d[ri + 48..]);
        }
        if (cd_off > @as(u64, d.len)) or (cd_size > (@as(u64, d.len) - cd_off)) {
            return error.Corrupt;
        }
        if count > (cd_size / 46) {
            return error.Corrupt;
        }
        let mut p = @truncate(usize, cd_off);
        let end = p + @truncate(usize, cd_size);
        self.list.reserve(@truncate(usize, count))!;
        for _k in @as(u64, 0)..count {
            if ((p + 46) > end) or (binary.u32_le(d[p..]) != SIG_CENTRAL) {
                return error.Corrupt;
            }
            let nlen = @as(usize, binary.u16_le(d[p + 28..]));
            let xlen = @as(usize, binary.u16_le(d[p + 30..]));
            let klen = @as(usize, binary.u16_le(d[p + 32..]));
            if (p + 46 + nlen + xlen + klen) > end {
                return error.Corrupt;
            }
            let made_by = binary.u16_le(d[p + 4..]) >> 8;
            let mut ent = Entry.{ name: d[p + 46..p + 46 + nlen], method: binary.u16_le(d[p + 10..]),
                                  flags: binary.u16_le(d[p + 8..]), crc: binary.u32_le(d[p + 16..]),
                                  csize: @as(u64, binary.u32_le(d[p + 20..])),
                                  size: @as(u64, binary.u32_le(d[p + 24..])),
                                  offset: @as(u64, binary.u32_le(d[p + 42..])),
                                  mtime: dos_time(binary.u16_le(d[p + 12..]), binary.u16_le(d[p + 14..])), mode: 0,
                                  comment: d[p + 46 + nlen + xlen..p + 46 + nlen + xlen + klen], aes_strength: 0,
                                  aes_version: 0, aes_method: 0 };
            if made_by == 3 {
                ent.mode = binary.u32_le(d[p + 38..]) >> 16;  // made on Unix: the mode is in the high bits
            }
            extra_fields(d[p + 46 + nlen..p + 46 + nlen + xlen], &mut ent)!;
            self.list.push(ent)!;
            p += 46 + nlen + xlen + klen;
        }
        self.check_spans()!;
    }

    // Each entry's local header and data must be bytes of its own: entries
    // sharing them would let a small archive extract to any size.
    fn check_spans(self: *Archive) ZipError!void {
        let es = self.list.items();
        let spans = mem.alloc.[Span](es.len)!;
        defer mem.free(spans);
        for k in @as(usize, 0)..es.len {
            let st = self.data_start(es[k])!;
            spans[k] = Span.{ lo: @truncate(usize, es[k].offset), hi: st + @truncate(usize, es[k].csize) };
        }
        vec.sort(spans, span_less);
        for k in @as(usize, 1)..spans.len {
            if spans[k].lo < spans[k - 1].hi {
                return error.Corrupt;
            }
        }
    }

    /// The entry with this name.
    pub fn find(self: *Archive, name: []u8) ZipError!Entry {
        for e in self.entries {
            if strs.eq(e.name, name) {
                return e;
            }
        }
        return error.NotFound;
    }

    /// An entry's compressed bytes (as stored in the archive).
    pub fn raw(self: *Archive, e: Entry) ZipError![]u8 {
        let st = self.data_start(e)!;
        return self.data[st..st + @truncate(usize, e.csize)];
    }

    // Where an entry's compressed bytes start, after its local header (and
    // checked to fit in the archive).
    fn data_start(self: *Archive, e: Entry) ZipError!usize {
        let d = self.data;
        if (d.len < 30) or (e.offset > @as(u64, d.len - 30)) or
           (binary.u32_le(d[@truncate(usize, e.offset)..]) != SIG_LOCAL) {
            return error.Corrupt;
        }
        let o = @truncate(usize, e.offset);
        let st = o + 30 + @as(usize, binary.u16_le(d[o + 26..])) + @as(usize, binary.u16_le(d[o + 28..]));
        if (st > d.len) or (e.csize > @as(u64, d.len - st)) {
            return error.Corrupt;
        }
        return st;
    }

    /// An entry's contents, checked against its size and CRC-32; the caller
    /// frees them.
    pub fn extract(self: *Archive, e: Entry) ![]mut u8 {
        if e.encrypted() {
            return error.PasswordRequired;
        }
        let src = self.raw(e)!;
        return unpack(e, src, e.method, true);
    }

    /// An entry's contents, decrypted with password if it is encrypted
    /// (as extract otherwise); the caller frees them.
    pub fn extract_password(self: *Archive, e: Entry, password: []u8) ![]mut u8 {
        if not e.encrypted() {
            return self.extract(e);
        }
        if (e.flags & 0x40) != 0 {
            return error.Unsupported;  // PKWARE's "strong encryption"
        }
        let src = self.raw(e)!;
        if e.method == AES {
            let plain = aes_open(e, src, password)!;
            defer mem.free(plain);
            return unpack(e, plain, e.aes_method, e.aes_version != 2);
        }
        // ZipCrypto: the last header byte checks the password against the
        // CRC's top byte, or the time's with a data descriptor
        let mut check = @truncate(u8, e.crc >> 24);
        if (e.flags & 8) != 0 {
            let o = @truncate(usize, e.offset);
            check = @truncate(u8, binary.u16_le(self.data[o + 10..]) >> 8);
        }
        let plain = zipcrypto_open(src, password, check)!;
        defer mem.free(plain);
        return unpack(e, plain, e.method, true);
    }

    /// extract_all, decrypting encrypted entries with password.
    pub fn extract_all_password(self: *Archive, dir: []u8, password: []u8, max_size: usize) !void {
        self.extract_all_with(dir, password, max_size)!;
    }

    /// Extracts every entry under dir (created if need be), refusing names
    /// that would leave it or are longer than MAX_NAME, and symbolic
    /// links. Fails with TooLarge, before writing anything, if the entries'
    /// sizes add up to more than max_size bytes.
    pub fn extract_all(self: *Archive, dir: []u8, max_size: usize) !void {
        self.extract_all_with(dir, "", max_size)!;
    }

    fn extract_all_with(self: *Archive, dir: []u8, password: []u8, max_size: usize) !void {
        let mut total: u64 = 0;
        for e in self.entries {
            if not safe_name(e.name) or e.is_symlink() {
                return error.UnsafePath;
            }
            if not e.is_dir() {
                total = @min(total, @as(u64, 1) << 62) + @min(e.size, @as(u64, 1) << 62);
            }
        }
        if total > @as(u64, max_size) {
            return error.TooLarge;
        }
        fs.mkdir_all(dir)!;
        for e in self.entries {
            let target = path.join2(dir, e.name)!;
            defer mem.free(target);
            if e.is_dir() {
                fs.mkdir_all(target)!;
                continue;
            }
            let parent = path.dir(target);
            if parent.len > 0 {
                fs.mkdir_all(parent)!;
            }
            let mut data: []mut u8 = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
            if password.len > 0 {
                data = self.extract_password(e, password)!;
            } else {
                data = self.extract(e)!;
            }
            defer mem.free(data);
            fs.write_file(target, data)!;
        }
    }
}

struct Span {
    lo: usize,
    hi: usize,
}

fn span_less(a: Span, b: Span) bool {
    return a.lo < b.lo;
}

// An entry's (decrypted) data, decompressed and checked against its size
// and, unless check_crc is false, its CRC-32.
fn unpack(e: Entry, src: []u8, method: u16, check_crc: bool) ![]mut u8 {
    if e.size > @as(u64, 0xffffffffffff) {
        return error.TooLarge;
    }
    let n = @truncate(usize, e.size);
    let mut out: []mut u8 = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
    if method == STORE {
        if @as(u64, src.len) != e.size {
            return error.Corrupt;
        }
        out = mem.alloc.[u8](n)!;
        @mem_copy(out, src);
    } else if method == DEFLATE {
        out = deflate.decompress(src, deflate.Format.RAW, n) catch |err| {
            if err == error.TooLarge {
                return error.Corrupt;  // more than it declares
            }
            if err == error.OutOfMemory {
                return err;
            }
            return error.Corrupt;
        };
        if out.len != n {
            mem.free(out);
            return error.Corrupt;
        }
    } else {
        return error.Unsupported;
    }
    if check_crc and (deflate.crc32(0, out) != e.crc) {
        mem.free(out);
        return error.ChecksumMismatch;
    }
    return out;
}

// -----------------------------------------------------------------------------
// Encryption
// -----------------------------------------------------------------------------

// The CRC-32 table step that ZipCrypto's keys use.
fn crc_table(t: *mut [256]u32) void {
    for i in @as(u32, 0)..256 {
        let mut c = i;
        for _k in @as(u32, 0)..8 {
            if (c & 1) != 0 {
                c = 0xedb88320 ^ (c >> 1);
            } else {
                c >>= 1;
            }
        }
        t[@as(usize, i)] = c;
    }
}

// The three keys of the traditional PKWARE encryption (APPNOTE 6.1).
struct ZipKeys {
    k: [3]u32,
    t: [256]u32,

    fn init(password: []u8) ZipKeys {
        let mut z = ZipKeys.{ k: [0x12345678, 0x23456789, 0x34567890], t: [0; 256] };
        crc_table(&mut z.t);
        for c in password {
            z.update(c);
        }
        return z;
    }

    fn crc(self: *ZipKeys, c: u32, b: u8) u32 {
        return self.t[@as(usize, (c ^ @as(u32, b)) & 0xff)] ^ (c >> 8);
    }

    fn update(self: *mut ZipKeys, b: u8) void {
        self.k[0] = self.crc(self.k[0], b);
        self.k[1] = ((self.k[1] +% (self.k[0] & 0xff)) *% 134775813) +% 1;
        self.k[2] = self.crc(self.k[2], @truncate(u8, self.k[1] >> 24));
    }

    fn stream_byte(self: *ZipKeys) u8 {
        let t = (self.k[2] | 2) & 0xffff;
        return @truncate(u8, (t * (t ^ 1)) >> 8);
    }

    fn decrypt(self: *mut ZipKeys, c: u8) u8 {
        let p = c ^ self.stream_byte();
        self.update(p);
        return p;
    }
}

fn zipcrypto_open(src: []u8, password: []u8, check: u8) ZipError![]mut u8 {
    if src.len < 12 {
        return error.Corrupt;
    }
    let mut z = ZipKeys.init(password);
    let mut last: u8 = 0;
    for i in @as(usize, 0)..12 {
        last = z.decrypt(src[i]);
    }
    if last != check {
        return error.WrongPassword;
    }
    let out = mem.alloc.[u8](src.len - 12)!;
    for i in @as(usize, 12)..src.len {
        out[i - 12] = z.decrypt(src[i]);
    }
    return out;
}

// WinZip AES: key sizes by strength, and the derived keys.
fn aes_key_len(strength: u8) ZipError!usize {
    if (strength < 1) or (strength > 3) {
        return error.Unsupported;
    }
    return 8 + (8 * @as(usize, strength));
}

// PBKDF2-HMAC-SHA1 (1000 rounds) of the password and salt: the AES key,
// the MAC key and a 2-byte password check, in out (2 * klen + 2 bytes).
fn aes_derive(password: []u8, salt: []u8, klen: usize, out: []mut u8) void {
    kdf.pbkdf2(sha2.Algorithm.SHA1, password, salt, 1000, out[..(2 * klen) + 2]);
}

// AES-CTR with a little-endian counter starting at 1 (Gladman's, as
// WinZip uses it): encryption and decryption alike.
fn aes_ctr_le(key: []u8, data: []u8, out: []mut u8) ZipError!void {
    let c = aes.Cipher.init(key) catch return error.Corrupt;
    let mut ctr: [16]u8 = [0; 16];
    let mut ks: [16]u8 = [0; 16];
    let mut i: usize = 0;
    while i < data.len {
        let mut j: usize = 0;
        while j < 16 {
            ctr[j] +%= 1;
            if ctr[j] != 0 {
                break;
            }
            j += 1;
        }
        c.encrypt_block(ctr[..], ks[..]);
        let n = @min(16, data.len - i);
        for k in @as(usize, 0)..n {
            out[i + k] = data[i + k] ^ ks[k];
        }
        i += n;
    }
}

fn aes_open(e: Entry, src: []u8, password: []u8) ZipError![]mut u8 {
    let klen = aes_key_len(e.aes_strength)!;
    let slen = klen / 2;
    if src.len < ((slen + 2) + 10) {
        return error.Corrupt;
    }
    let mut keys: [66]u8 = [0; 66];
    aes_derive(password, src[..slen], klen, keys[..]);
    if not subtle.equal(keys[2 * klen..(2 * klen) + 2], src[slen..slen + 2]) {
        return error.WrongPassword;
    }
    let ct = src[slen + 2..src.len - 10];
    let mut mac: [20]u8 = [0; 20];
    hmac.hmac(sha2.Algorithm.SHA1, keys[klen..2 * klen], ct, mac[..]);
    if not subtle.equal(mac[..10], src[src.len - 10..]) {
        return error.ChecksumMismatch;  // altered, or (rarely) a wrong password
    }
    let out = mem.alloc.[u8](ct.len)!;
    aes_ctr_le(keys[..klen], ct, out) catch |err| {
        mem.free(out);
        return err;
    };
    return out;
}

// salt || password check || AES-256-CTR(data) || MAC: an AE-2 entry's data.
fn aes_seal(password: []u8, data: []u8) ZipError![]mut u8 {
    let out = mem.alloc.[u8](((16 + 2) + data.len) + 10)!;
    random.fill(out[..16]) catch |err| {
        mem.free(out);
        return err;
    };
    let mut keys: [66]u8 = [0; 66];
    aes_derive(password, out[..16], 32, keys[..]);
    @mem_copy(out[16..18], keys[64..66]);
    let ct = out[18..18 + data.len];
    aes_ctr_le(keys[..32], data, ct) catch |err| {
        mem.free(out);
        return err;
    };
    let mut mac: [20]u8 = [0; 20];
    hmac.hmac(sha2.Algorithm.SHA1, keys[32..64], ct, mac[..]);
    @mem_copy(out[18 + data.len..], mac[..10]);
    return out;
}

/// Whether an entry name stays inside the directory it is extracted to:
/// relative, without "..", backslashes or drive letters, and at most
/// MAX_NAME bytes.
pub fn safe_name(name: []u8) bool {
    if (name.len == 0) or (name.len > MAX_NAME) or (name[0] == '/') or strs.contains(name, "\\") or
       strs.contains(name, "\x00") {
        return false;
    }
    if (name.len >= 2) and (name[1] == ':') {
        return false;
    }
    let mut it = strs.split(name, "/");
    while true {
        let part = it.next() catch break;
        if strs.eq(part, "..") {
            return false;
        }
    }
    return true;
}

// The ZIP64 sizes and offset, and an extended timestamp.
fn extra_fields(x: []u8, e: *mut Entry) ZipError!void {
    let mut i: usize = 0;
    while (i + 4) <= x.len {
        let id = binary.u16_le(x[i..]);
        let n = @as(usize, binary.u16_le(x[i + 2..]));
        if (i + 4 + n) > x.len {
            return error.Corrupt;
        }
        let f = x[i + 4..i + 4 + n];
        if id == 0x0001 {
            // only the fields whose 32-bit values are saturated are present
            let mut j: usize = 0;
            if e.size == 0xffffffff {
                if (j + 8) > f.len {
                    return error.Corrupt;
                }
                e.size = binary.u64_le(f[j..]);
                j += 8;
            }
            if e.csize == 0xffffffff {
                if (j + 8) > f.len {
                    return error.Corrupt;
                }
                e.csize = binary.u64_le(f[j..]);
                j += 8;
            }
            if e.offset == 0xffffffff {
                if (j + 8) > f.len {
                    return error.Corrupt;
                }
                e.offset = binary.u64_le(f[j..]);
            }
        } else if (id == 0x9901) and (n >= 7) and (f[2] == 'A') and (f[3] == 'E') {
            e.aes_version = binary.u16_le(f[0..]);
            e.aes_strength = f[4];
            e.aes_method = binary.u16_le(f[5..]);
        } else if (id == 0x5455) and (n >= 5) and ((f[0] & 1) != 0) {
            e.mtime = @as(i64, @bit_cast(i32, binary.u32_le(f[1..])));
        }
        i += 4 + n;
    }
}

// A DOS date and time, taken as UTC.
fn dos_time(t: u16, d: u16) i64 {
    let year = 1980 + @as(i64, d >> 9);
    let mut month = @as(u32, (d >> 5) & 15);
    let mut day = @as(u32, d & 31);
    if (month < 1) or (month > 12) {
        month = 1;
    }
    if day < 1 {
        day = 1;
    }
    let days = time.days_from_civil(year, month, day);
    return (days * 86400) + (@as(i64, t >> 11) * 3600) + (@as(i64, (t >> 5) & 63) * 60) + (@as(i64, t & 31) * 2);
}

// The DOS time and date for a Unix time (clamped to 1980..2107).
fn to_dos(unix: i64, t: *mut u16, d: *mut u16) void {
    let mut s = unix;
    let lo = time.days_from_civil(1980, 1, 1) * 86400;
    let hi = time.days_from_civil(2107, 12, 31) * 86400;
    s = @max(lo, @min(s, hi));
    let dt = time.Time.from_unix(s, 0).utc();
    t.* = @truncate(u16, (dt.hour << 11) | (dt.minute << 5) | (dt.second / 2));
    d.* = @truncate(u16, (@as(u32, @truncate(u16, @bit_cast(u64, dt.year - 1980))) << 9) | (dt.month << 5) | dt.day);
}

// -----------------------------------------------------------------------------
// Writing
// -----------------------------------------------------------------------------

pub struct Options {
    method: u16,     // DEFLATE (stored instead when that is no bigger) or STORE
    level: u32,      // deflate level, 1 to 9
    mtime: i64,      // Unix time
    mode: u32,       // Unix permissions (0o644 by default)
    password: []u8,  // non-empty: encrypt with AES-256 (WinZip AE-2)

    pub fn default() Options {
        return Options.{ method: DEFLATE, level: deflate.DEFAULT_LEVEL, mtime: 315532800, mode: 0o644, password: "" };
    }
}

struct Written {
    name: []mut u8,  // owned
    method: u16,
    crc: u32,
    csize: u64,
    size: u64,
    offset: u64,
    dtime: u16,
    ddate: u16,
    mode: u32,
    mtime: i64,
    aes_method: u16,  // the method under AES encryption (method is then AES)
    flags: u16,
}

/// Writes a zip archive to a stream: add entries, then finish(), then
/// deinit().
pub struct Writer {
    out: io.Writer,
    offset: u64,
    written: vec.Vec.[Written],
    comment: []u8,  // the archive comment (at most 65535 bytes)

    pub fn init(out: io.Writer) Writer {
        return Writer.{ out: out, offset: 0, written: vec.Vec.[Written].init(), comment: "" };
    }

    fn put(self: *mut Writer, b: []u8) !void {
        self.out.write_all(b)!;
        self.offset += @as(u64, b.len);
    }

    /// Adds a file.
    pub fn add(self: *mut Writer, name: []u8, data: []u8, opts: Options) !void {
        let mut method = opts.method;
        let mut packed: []mut u8 = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
        if method == DEFLATE {
            packed = deflate.compress(data, deflate.Format.RAW, opts.level)!;
            if packed.len >= data.len {
                mem.free(packed);
                packed = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
                method = STORE;
            }
        } else if method != STORE {
            return error.Unsupported;
        }
        defer {
            if packed.len > 0 {
                mem.free(packed);
            }
        }
        let mut body = data;
        if method == DEFLATE {
            body = packed;
        }
        if opts.password.len > 0 {
            // AE-2: no CRC (it would tell about the contents), a MAC instead
            let sealed = aes_seal(opts.password, body)!;
            defer mem.free(sealed);
            self.entry_with(name, AES, 0, @as(u64, data.len), sealed, opts.mtime, 0o100000 | (opts.mode & 0o7777),
                            method)!;
            return;
        }
        self.entry(name, method, deflate.crc32(0, data), @as(u64, data.len), body, opts.mtime,
                   0o100000 | (opts.mode & 0o7777))!;
    }

    /// Adds a directory (its name should end in "/").
    pub fn add_dir(self: *mut Writer, name: []u8) !void {
        let mut o = Options.default();
        o.mode = 0o755;
        return self.entry(name, STORE, 0, 0, "", o.mtime, 0o040755);
    }

    fn entry(self: *mut Writer, name: []u8, method: u16, crc: u32, size: u64, body: []u8, mtime: i64, mode: u32) !void {
        self.entry_with(name, method, crc, size, body, mtime, mode, 0)!;
    }

    fn entry_with(self: *mut Writer, name: []u8, method: u16, crc: u32, size: u64, body: []u8, mtime: i64, mode: u32,
                  aes_method: u16) !void {
        if name.len > 65535 {
            return error.TooLarge;
        }
        let mut flags: u16 = 0x0800;  // UTF-8 names
        if method == AES {
            flags |= 1;
        }
        let mut w = Written.{ name: strs.dup(name)!, method: method, crc: crc, csize: @as(u64, body.len), size: size,
                              offset: self.offset, dtime: 0, ddate: 0, mode: mode, mtime: mtime, aes_method: aes_method,
                              flags: flags };
        to_dos(mtime, &mut w.dtime, &mut w.ddate);
        self.written.push(w) catch |e| {
            mem.free(w.name);
            return e;
        };
        let big = (size >= 0xffffffff) or (w.csize >= 0xffffffff);
        let mut h = Buf.{ b: [0; 64], n: 0 };
        h.put32(SIG_LOCAL);
        if big {
            h.put16(45);
        } else {
            h.put16(20);
        }
        h.put16(flags);
        h.put16(method);
        h.put16(w.dtime);
        h.put16(w.ddate);
        h.put32(crc);
        if big {
            h.put32(0xffffffff);
            h.put32(0xffffffff);
        } else {
            h.put32(@truncate(u32, w.csize));
            h.put32(@truncate(u32, size));
        }
        h.put16(@truncate(u16, name.len));
        let mut x = Buf.{ b: [0; 64], n: 0 };
        if big {
            x.put16(0x0001);
            x.put16(16);
            x.put64(size);
            x.put64(w.csize);
        }
        if method == AES {
            aes_extra(&mut x, aes_method);
        }
        h.put16(@truncate(u16, x.n));
        self.put(h.bytes())!;
        self.put(name)!;
        self.put(x.bytes())!;
        self.put(body)!;
    }

    /// Writes the central directory. The Writer can then be dropped.
    pub fn finish(self: *mut Writer) !void {
        let cd_start = self.offset;
        for w in self.written.items() {
            let need_size = (w.size >= 0xffffffff) or (w.csize >= 0xffffffff);
            let need_off = w.offset >= 0xffffffff;
            let mut x = Buf.{ b: [0; 64], n: 0 };
            if need_size or need_off {
                x.put16(0x0001);
                let mut n: u16 = 0;
                if need_size {
                    n += 16;
                }
                if need_off {
                    n += 8;
                }
                x.put16(n);
                if need_size {
                    x.put64(w.size);
                    x.put64(w.csize);
                }
                if need_off {
                    x.put64(w.offset);
                }
            }
            if w.method == AES {
                aes_extra(&mut x, w.aes_method);
            }
            let mut h = Buf.{ b: [0; 64], n: 0 };
            h.put32(SIG_CENTRAL);
            h.put16(0x0300 | 45);  // made by Unix, version 4.5
            if need_size or need_off {
                h.put16(45);
            } else {
                h.put16(20);
            }
            h.put16(w.flags);
            h.put16(w.method);
            h.put16(w.dtime);
            h.put16(w.ddate);
            h.put32(w.crc);
            if need_size {
                h.put32(0xffffffff);
                h.put32(0xffffffff);
            } else {
                h.put32(@truncate(u32, w.csize));
                h.put32(@truncate(u32, w.size));
            }
            h.put16(@truncate(u16, w.name.len));
            h.put16(@truncate(u16, x.n));
            h.put16(0);  // comment
            h.put16(0);  // disk
            h.put16(0);  // internal attributes
            let mut dos_attr: u32 = 0;
            if (w.mode & 0o170000) == 0o040000 {
                dos_attr = 0x10;
            }
            h.put32((w.mode << 16) | dos_attr);
            if need_off {
                h.put32(0xffffffff);
            } else {
                h.put32(@truncate(u32, w.offset));
            }
            self.put(h.bytes())!;
            self.put(w.name)!;
            self.put(x.bytes())!;
        }
        let cd_size = self.offset - cd_start;
        let count = @as(u64, self.written.len);
        let need64 = (count >= 0xffff) or (cd_size >= 0xffffffff) or (cd_start >= 0xffffffff);
        if need64 {
            let rec = self.offset;
            let mut z = Buf.{ b: [0; 64], n: 0 };
            z.put32(SIG_END64);
            z.put64(44);
            z.put16(45);
            z.put16(45);
            z.put32(0);
            z.put32(0);
            z.put64(count);
            z.put64(count);
            z.put64(cd_size);
            z.put64(cd_start);
            self.put(z.bytes())!;
            let mut l = Buf.{ b: [0; 64], n: 0 };
            l.put32(SIG_LOC64);
            l.put32(0);
            l.put64(rec);
            l.put32(1);
            self.put(l.bytes())!;
        }
        let mut e = Buf.{ b: [0; 64], n: 0 };
        e.put32(SIG_END);
        e.put16(0);
        e.put16(0);
        e.put16(@truncate(u16, @min(count, 0xffff)));
        e.put16(@truncate(u16, @min(count, 0xffff)));
        e.put32(@truncate(u32, @min(cd_size, 0xffffffff)));
        e.put32(@truncate(u32, @min(cd_start, 0xffffffff)));
        let c = self.comment[..@min(self.comment.len, 65535)];
        e.put16(@truncate(u16, c.len));
        self.put(e.bytes())!;
        self.put(c)!;
    }

    /// Frees the Writer's records (after finish, or to give up).
    pub fn deinit(self: *mut Writer) void {
        for w in self.written.items() {
            mem.free(w.name);
        }
        self.written.deinit();
    }
}

// The WinZip AES extra field: AE-2, 256-bit keys, the real method.
fn aes_extra(x: *mut Buf, method: u16) void {
    x.put16(0x9901);
    x.put16(7);
    x.put16(2);
    x.put16(0x4541);  // "AE"
    x.b[x.n] = 3;
    x.n += 1;
    x.put16(method);
}

struct Buf {
    b: [64]u8,
    n: usize,

    fn put16(self: *mut Buf, v: u16) void {
        self.b[self.n] = @truncate(u8, v);
        self.b[self.n + 1] = @truncate(u8, v >> 8);
        self.n += 2;
    }

    fn put32(self: *mut Buf, v: u32) void {
        self.put16(@truncate(u16, v));
        self.put16(@truncate(u16, v >> 16));
    }

    fn put64(self: *mut Buf, v: u64) void {
        self.put32(@truncate(u32, v));
        self.put32(@truncate(u32, v >> 32));
    }

    fn bytes(self: *Buf) []u8 {
        return self.b[..self.n];
    }
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

// The listing format of cmd/axiom/internal/tests/tools/gen_archive_tests.py.
fn listing(a: *Archive, out: *mut strs.String) !void {
    for e in a.entries {
        let data = a.extract(e)!;
        defer mem.free(data);
        let mut kind: []u8 = "f";
        if e.is_dir() {
            kind = "d";
        }
        fmt.write(out.writer(), "{} {} {:o} {} {:08x} {}\n", [fmt.str(kind), fmt.int(e.size), fmt.int(e.mode & 0o7777),
                                                              fmt.int(e.mtime), fmt.int(deflate.crc32(0, data)),
                                                              fmt.str(e.name)])!;
    }
}

test "archives made by Python's zipfile" {
    for name in ["stored", "deflated", "zip64"] {
        let mut zp = strs.String.init();
        defer zp.deinit();
        fmt.write(zp.writer(), "std/archive/zip/testdata/{}.zip", [fmt.str(name)])!;
        let data = fs.read_file(zp.bytes()) catch return;
        defer mem.free(data);
        zp.truncate(zp.len - 3);
        zp.push_str("txt")!;
        let want = fs.read_file(zp.bytes())!;
        defer mem.free(want);
        let mut a = Archive.open(data)!;
        defer a.deinit();
        @expect_eq(a.comment, "made by cmd/axiom/internal/tests/tools/gen_archive_tests.py");
        let mut got = strs.String.init();
        defer got.deinit();
        listing(&a, &mut got)!;
        @expect_eq(got.bytes(), want);
        let h = a.extract(a.find("hello.txt")!)!;
        defer mem.free(h);
        @expect_eq(h, "Hello, world!\n");
    }
}

test "writing and reading back" {
    let mut s = strs.String.init();
    defer s.deinit();
    let mut w = Writer.init(s.writer());
    let mut big = strs.String.init();
    defer big.deinit();
    for k in @as(usize, 0)..20000 {
        big.push(@truncate(u8, (k * k) >> 3))!;
    }
    let mut o = Options.default();
    o.mtime = 1700000000;
    w.add("a/b.txt", "text text text text text text\n", o)!;
    w.add("big.bin", big.bytes(), o)!;
    w.add("tiny", "x", o)!;  // (stored: deflate would be bigger)
    o.method = STORE;
    o.mode = 0o755;
    w.add("run.sh", "#!/bin/sh\n", o)!;
    w.add_dir("empty/")!;
    w.comment = "hi";
    w.finish()!;
    w.deinit();
    let mut a = Archive.open(s.bytes())!;
    defer a.deinit();
    @expect_eq(a.entries.len, 5);
    @expect_eq(a.comment, "hi");
    let e = a.find("big.bin")!;
    @expect_eq(e.method, DEFLATE);
    @expect_eq(e.mtime, 1700000000);
    let b = a.extract(e)!;
    defer mem.free(b);
    @expect_eq(b, big.bytes());
    @expect_eq(a.find("tiny")!.method, STORE);
    @expect_eq(a.find("run.sh")!.mode, 0o100755);
    @expect(a.find("empty/")!.is_dir());
}

fn fails_open(data: []u8) bool {
    let mut a = Archive.open(data) catch return true;
    a.deinit();
    return false;
}

test "hostile archives" {
    // a small archive to damage
    let mut s = strs.String.init();
    defer s.deinit();
    let mut w = Writer.init(s.writer());
    let mut zeros = strs.String.init();
    defer zeros.deinit();
    for _k in @as(usize, 0)..100000 {
        zeros.push(0)!;
    }
    w.add("z", zeros.bytes(), Options.default())!;
    w.finish()!;
    w.deinit();
    let good = s.bytes();
    // a declared size smaller than the data: never inflated past it
    let mut bomb = strs.String.from(good)!;
    defer bomb.deinit();
    let b = bomb.bytes();
    let cd = strs.last_index_of(b, "PK\x01\x02")!;
    b[cd + 24] = 100;  // uncompressed size 100
    b[cd + 25] = 0;
    b[cd + 26] = 0;
    let mut a = Archive.open(b)!;
    defer a.deinit();
    @expect(fails_extract(&a, a.entries[0]));
    // a damaged CRC
    let mut bad = strs.String.from(good)!;
    defer bad.deinit();
    bad.bytes()[cd + 16] ^= 1;
    let mut a2 = Archive.open(bad.bytes())!;
    defer a2.deinit();
    @expect(fails_extract(&a2, a2.entries[0]));
    // truncations anywhere
    for n in @as(usize, 0)..good.len {
        let mut t = Archive.open(good[..n]) catch continue;
        for e in t.entries {
            let x = t.extract(e) catch continue;
            mem.free(x);
        }
        t.deinit();
    }
    @expect(fails_open("PK\x05\x06"));
    @expect(fails_open("not a zip file at all, not at all, no"));
    // names that would escape
    for n in ["../x", "/etc/passwd", "a/../../x", "c:/x", "a\\b"] {
        @expect(not safe_name(n));
    }
    @expect(safe_name("a/b..c/d"));
    // nor so long (or deep) that extracting it would be unreasonable
    let long = mem.alloc.[u8](MAX_NAME + 1)!;
    defer mem.free(long);
    for i in 0..long.len {
        long[i] = 'a';
        if (i % 2) == 1 {
            long[i] = '/';
        }
    }
    @expect(safe_name(long[..MAX_NAME]));
    @expect(not safe_name(long));
}

test "entries sharing their bytes, and extract_all's limit" {
    let mut s = strs.String.init();
    defer s.deinit();
    let mut w = Writer.init(s.writer());
    let mut zeros = strs.String.init();
    defer zeros.deinit();
    for _k in @as(usize, 0)..100000 {
        zeros.push(0)!;
    }
    w.add("z", zeros.bytes(), Options.default())!;
    w.finish()!;
    w.deinit();
    let good = s.bytes();
    let mut a = Archive.open(good)!;
    defer a.deinit();
    // (fails before it creates the directory)
    let mut too_large = false;
    a.extract_all("zip-test-out-never-created", 99999) catch |e| {
        too_large = e == error.TooLarge;
    };
    @expect(too_large);
    // the central directory entry three times over, for one local file
    let cd = strs.last_index_of(good, "PK\x01\x02")!;
    let eocd = strs.last_index_of(good, "PK\x05\x06")!;
    let mut b = strs.String.from(good[..eocd])!;
    defer b.deinit();
    b.push_str(good[cd..eocd])!;
    b.push_str(good[cd..eocd])!;
    b.push_str(good[eocd..])!;
    let n = b.len - 22;
    let x = b.bytes();
    binary.put_u16_le(x[n + 8..n + 10], 3);
    binary.put_u16_le(x[n + 10..n + 12], 3);
    binary.put_u32_le(x[n + 12..n + 16], @truncate(u32, 3 * (eocd - cd)));
    @expect(fails_open(x));
    // the same entries, each with a local file of its own
    let mut c = strs.String.from(good[..cd])!;
    defer c.deinit();
    c.push_str(good[..cd])!;
    c.push_str(good[cd..eocd])!;
    c.push_str(good[cd..eocd])!;
    binary.put_u32_le(c.bytes()[c.len - (eocd - cd) + 42..], @truncate(u32, cd));
    c.push_str(good[eocd..])!;
    let m = c.len - 22;
    let y = c.bytes();
    binary.put_u16_le(y[m + 8..m + 10], 2);
    binary.put_u16_le(y[m + 10..m + 12], 2);
    binary.put_u32_le(y[m + 12..m + 16], @truncate(u32, 2 * (eocd - cd)));
    binary.put_u32_le(y[m + 16..m + 20], @truncate(u32, 2 * cd));
    let mut a2 = Archive.open(y)!;
    defer a2.deinit();
    @expect_eq(a2.entries.len, 2);
    let z = a2.extract(a2.entries[1])!;
    defer mem.free(z);
    @expect_eq(z, zeros.bytes());
}

test "a ZIP64 locator in a short archive" {
    // the locator, pointing at offset 16, and an empty end record: 42 bytes
    let mut b: [42]u8 = [0; 42];
    binary.put_u32_le(b[0..4], SIG_LOC64);
    b[8] = 16;
    binary.put_u32_le(b[16..20], SIG_END64);
    binary.put_u32_le(b[20..24], SIG_END);
    @expect(fails_open(b[..]));
}

fn fails_extract(a: *Archive, e: Entry) bool {
    let x = a.extract(e) catch return true;
    mem.free(x);
    return false;
}

fn data_bin(out: *mut strs.String) ZipError!void {
    // cmd/axiom/internal/tests/tools/gen_zip_crypt_tests.py's data.bin
    let mut x: u32 = 12345;
    for i in @as(usize, 0)..20000 {
        x = ((x *% 1103515245) +% 12345) & 0x7fffffff;
        if (i % 3) == 0 {
            out.push(0x41)!;
        } else {
            out.push(@truncate(u8, x >> 16))!;
        }
    }
}

fn wrong_password(a: *Archive, e: Entry, pw: []u8) bool {
    let r = a.extract_password(e, pw) catch |err| return (err == error.WrongPassword) or
            (err == error.ChecksumMismatch) or (err == error.Corrupt);
    mem.free(r);
    return false;
}

fn needs_password(a: *Archive, e: Entry) bool {
    let r = a.extract(e) catch |err| return err == error.PasswordRequired;
    mem.free(r);
    return false;
}

test "encrypted archives: ZipCrypto and WinZip AES" {
    let mut want = strs.String.init();
    defer want.deinit();
    data_bin(&mut want)!;
    for name in ["zipcrypto", "zipcrypto_stream", "aes128", "aes192", "aes256", "aes256_ae1"] {
        let mut zp = strs.String.init();
        defer zp.deinit();
        fmt.write(zp.writer(), "std/archive/zip/testdata/{}.zip", [fmt.str(name)])!;
        let data = fs.read_file(zp.bytes())!;
        defer mem.free(data);
        let mut a = Archive.open(data)!;
        defer a.deinit();
        @expect_eq(a.entries.len, 3);
        for e in a.entries {
            @expect(e.encrypted());
            @expect(needs_password(&a, e));
        }
        let h = a.extract_password(a.find("hello.txt")!, "secret")!;
        defer mem.free(h);
        @expect_eq(h, "Hello, world!\n");
        let d = a.extract_password(a.find("data.bin")!, "secret")!;
        defer mem.free(d);
        @expect_eq(d, want.bytes());
        let z = a.extract_password(a.find("empty.txt")!, "secret")!;
        defer mem.free(z);
        @expect_eq(z.len, 0);
        @expect(wrong_password(&a, a.find("data.bin")!, "Secret"));
        @expect(wrong_password(&a, a.find("hello.txt")!, ""));
    }
    // an AES entry whose ciphertext was altered fails its MAC
    let data = fs.read_file("std/archive/zip/testdata/aes256.zip")!;
    defer mem.free(data);
    let mut a = Archive.open(data)!;
    defer a.deinit();
    let e = a.find("data.bin")!;
    let raw = a.raw(e)!;
    let copy = mem.dup(data)!;
    defer mem.free(copy);
    let at = (@int_from_ptr(raw.ptr) - @int_from_ptr(data.ptr)) + 100;
    copy[at] ^= 1;
    let mut b = Archive.open(copy)!;
    defer b.deinit();
    let r = b.extract_password(b.find("data.bin")!, "secret");
    _ = r catch |err| {
        @expect(err == error.ChecksumMismatch);
        return;
    };
    @expect(false);
}

test "writing AES-encrypted entries" {
    let mut s = strs.String.init();
    defer s.deinit();
    let mut big = strs.String.init();
    defer big.deinit();
    data_bin(&mut big)!;
    let mut w = Writer.init(s.writer());
    let mut o = Options.default();
    o.password = "pa55";
    w.add("big.bin", big.bytes(), o)!;
    w.add("tiny", "x", o)!;
    w.add("empty", "", o)!;
    o.password = "";
    w.add("plain.txt", "not secret", o)!;
    w.finish()!;
    w.deinit();
    let mut a = Archive.open(s.bytes())!;
    defer a.deinit();
    let e = a.find("big.bin")!;
    @expect(e.encrypted() and (e.method == AES) and (e.aes_strength == 3) and (e.aes_version == 2));
    @expect_eq(e.aes_method, DEFLATE);
    @expect_eq(e.crc, 0);
    let b = a.extract_password(e, "pa55")!;
    defer mem.free(b);
    @expect_eq(b, big.bytes());
    let t = a.extract_password(a.find("tiny")!, "pa55")!;
    defer mem.free(t);
    @expect_eq(t, "x");
    @expect_eq(a.find("tiny")!.aes_method, STORE);
    let z = a.extract_password(a.find("empty")!, "pa55")!;
    defer mem.free(z);
    @expect_eq(z.len, 0);
    @expect(wrong_password(&a, e, "pass"));
    // unencrypted entries need no password, and take one harmlessly
    let p = a.extract_password(a.find("plain.txt")!, "pa55")!;
    defer mem.free(p);
    @expect_eq(p, "not secret");
    @expect(not a.find("plain.txt")!.encrypted());
}
