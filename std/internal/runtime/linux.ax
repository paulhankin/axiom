// =============================================================================
// std/internal/runtime/linux.ax - the Linux system calls the native runtime uses, made
// directly (through the linker's ax_syscall stub, cmd/axiom/src/lstub.ax):
// native programs need no C library. Results are the kernel's: a negative
// value is -errno.
// =============================================================================

pub extern "C" {
    fn ax_syscall(n: i64, a: usize, b: usize, c: usize, d: usize, e: usize, f: usize) isize;
    fn ax_thread_create(f: fn(*mut void) void, arg: *mut void, stack_top: usize, tls: usize, ctid: *mut u32) isize;
    fn ax_sigreturn() void;
    fn ax_start_sp() usize;
    fn ax_tls_info() *TlsInfo;
    fn ax_libc_linked() i32;
    fn axiom_target_arch() i32;  // 1 x86-64, 2 AArch64
}

pub struct TlsInfo {
    template: usize,  // address of the initialized part
    filesz: usize,
    memsz: usize,
    align: usize,
}

pub struct Timespec {
    sec: i64,
    nsec: i64,
}

pub const EINTR: isize = 4;
pub const ENOENT: isize = 2;
pub const EACCES: isize = 13;
pub const EAGAIN: isize = 11;
pub const ETIMEDOUT: isize = 110;
pub const ECONNREFUSED: isize = 111;
pub const EADDRINUSE: isize = 98;
pub const EPERM: isize = 1;
pub const EEXIST: isize = 17;
pub const ENOTDIR: isize = 20;
pub const EISDIR: isize = 21;
pub const ENOTEMPTY: isize = 39;
pub const ELOOP: isize = 40;
pub const ERANGE: isize = 34;

// System call numbers: [x86-64, AArch64]
let SYS_READ: [2]i64 = [0, 63];
let SYS_WRITE: [2]i64 = [1, 64];
let SYS_OPENAT: [2]i64 = [257, 56];
let SYS_CLOSE: [2]i64 = [3, 57];
let SYS_MMAP: [2]i64 = [9, 222];
let SYS_MPROTECT: [2]i64 = [10, 226];
let SYS_MUNMAP: [2]i64 = [11, 215];
let SYS_MADVISE: [2]i64 = [28, 233];
let SYS_RT_SIGACTION: [2]i64 = [13, 134];
let SYS_SIGALTSTACK: [2]i64 = [131, 132];
let SYS_GETPID: [2]i64 = [39, 172];
let SYS_GETTID: [2]i64 = [186, 178];
let SYS_TGKILL: [2]i64 = [234, 131];
let SYS_EXIT_GROUP: [2]i64 = [231, 94];
let SYS_SCHED_YIELD: [2]i64 = [24, 124];
let SYS_NANOSLEEP: [2]i64 = [35, 101];
let SYS_FUTEX: [2]i64 = [202, 98];
let SYS_SOCKET: [2]i64 = [41, 198];
let SYS_CONNECT: [2]i64 = [42, 203];
let SYS_ACCEPT4: [2]i64 = [288, 242];
let SYS_SENDTO: [2]i64 = [44, 206];
let SYS_RECVFROM: [2]i64 = [45, 207];
let SYS_BIND: [2]i64 = [49, 200];
let SYS_LISTEN: [2]i64 = [50, 201];
let SYS_GETSOCKNAME: [2]i64 = [51, 204];
let SYS_SETSOCKOPT: [2]i64 = [54, 208];
let SYS_SHUTDOWN: [2]i64 = [48, 210];
let SYS_GETRANDOM: [2]i64 = [318, 278];
let SYS_CLONE: [2]i64 = [56, 220];
let SYS_WAIT4: [2]i64 = [61, 260];
let SYS_PIPE2: [2]i64 = [293, 59];
let SYS_DUP3: [2]i64 = [292, 24];
let SYS_SETITIMER: [2]i64 = [38, 103];
let SYS_PPOLL: [2]i64 = [271, 73];
let SYS_CLOCK_GETTIME: [2]i64 = [228, 113];
let SYS_SCHED_GETAFFINITY: [2]i64 = [204, 123];
let SYS_TIMER_CREATE: [2]i64 = [222, 107];
let SYS_TIMER_SETTIME: [2]i64 = [223, 110];
let SYS_TIMER_DELETE: [2]i64 = [226, 111];
let SYS_STATX: [2]i64 = [332, 291];
let SYS_MKDIRAT: [2]i64 = [258, 34];
let SYS_UNLINKAT: [2]i64 = [263, 35];
let SYS_RENAMEAT2: [2]i64 = [316, 276];
let SYS_GETDENTS64: [2]i64 = [217, 61];
let SYS_GETCWD: [2]i64 = [79, 17];
let SYS_LSEEK: [2]i64 = [8, 62];
let SYS_EXECVE: [2]i64 = [59, 221];
let SYS_CHDIR: [2]i64 = [80, 49];
let SYS_KILL: [2]i64 = [62, 129];
let SYS_IOCTL: [2]i64 = [16, 29];
let SYS_GETPEERNAME: [2]i64 = [52, 205];
let SYS_FCHMODAT: [2]i64 = [268, 53];
let SYS_SYMLINKAT: [2]i64 = [266, 36];
let SYS_READLINKAT: [2]i64 = [267, 78];
let SYS_LINKAT: [2]i64 = [265, 37];
let SYS_UTIMENSAT: [2]i64 = [280, 88];
let SYS_FTRUNCATE: [2]i64 = [77, 46];
let SYS_FSYNC: [2]i64 = [74, 82];
let SYS_FLOCK: [2]i64 = [73, 32];
let SYS_MSYNC: [2]i64 = [26, 227];
let SYS_INOTIFY_INIT1: [2]i64 = [294, 26];
let SYS_INOTIFY_ADD_WATCH: [2]i64 = [254, 27];
let SYS_INOTIFY_RM_WATCH: [2]i64 = [255, 28];
let SYS_PRCTL: [2]i64 = [157, 167];

fn nr(t: [2]i64) i64 {
    if axiom_target_arch() == 2 {
        return t[1];
    }
    return t[0];
}

fn sys0(t: [2]i64) isize {
    return ax_syscall(nr(t), 0, 0, 0, 0, 0, 0);
}

fn sys1(t: [2]i64, a: usize) isize {
    return ax_syscall(nr(t), a, 0, 0, 0, 0, 0);
}

fn sys2(t: [2]i64, a: usize, b: usize) isize {
    return ax_syscall(nr(t), a, b, 0, 0, 0, 0);
}

fn sys3(t: [2]i64, a: usize, b: usize, c: usize) isize {
    return ax_syscall(nr(t), a, b, c, 0, 0, 0);
}

fn sys4(t: [2]i64, a: usize, b: usize, c: usize, d: usize) isize {
    return ax_syscall(nr(t), a, b, c, d, 0, 0);
}

fn sys6(t: [2]i64, a: usize, b: usize, c: usize, d: usize, e: usize, f: usize) isize {
    return ax_syscall(nr(t), a, b, c, d, e, f);
}

fn ip(p: *void) usize {
    return @int_from_ptr(p);
}

fn si(x: i32) usize {
    return @bit_cast(usize, @as(isize, x));
}

pub fn read(fd: i32, p: *mut u8, n: usize) isize {
    return sys3(SYS_READ, si(fd), @int_from_ptr(p), n);
}

pub fn write(fd: i32, p: *u8, n: usize) isize {
    return sys3(SYS_WRITE, si(fd), @int_from_ptr(p), n);
}

// Writes all of s (retrying after interruptions and short writes).
pub fn write_all(fd: i32, s: []u8) void {
    let mut off: usize = 0;
    while off < s.len {
        let r = write(fd, &s[off], s.len - off);
        if r == -EINTR {
            continue;
        }
        if r <= 0 {
            return;
        }
        off += @bit_cast(usize, r);
    }
}

// path: NUL-terminated
pub fn open(path: *u8, flags: i32, mode: i32) isize {
    return sys4(SYS_OPENAT, si(-100), @int_from_ptr(path), si(flags), si(mode));  // AT_FDCWD
}

// Opens the directory `name` in the directory dirfd (-100 for the working
// directory) without following a symbolic link there.
pub fn open_dir_at(dirfd: i32, name: *u8) isize {
    // O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC; the first two differ on AArch64
    let mut flags: usize = 0x10000 | 0x20000 | 0x80000;
    if axiom_target_arch() == 2 {
        flags = 0x4000 | 0x8000 | 0x80000;
    }
    return sys4(SYS_OPENAT, si(dirfd), @int_from_ptr(name), flags, 0);
}

// flags 0x200 (AT_REMOVEDIR) removes a directory
pub fn unlink_at(dirfd: i32, name: *u8, flags: i32) isize {
    return sys3(SYS_UNLINKAT, si(dirfd), @int_from_ptr(name), si(flags));
}

pub fn close(fd: i32) isize {
    return sys1(SYS_CLOSE, si(fd));
}

// Files and directories. Paths are NUL-terminated and relative to the
// working directory (AT_FDCWD).

// buf: a struct statx (256 bytes); flags 0x100 is AT_SYMLINK_NOFOLLOW
pub fn statx(path: *u8, flags: i32, buf: *mut u8) isize {
    return sys6(SYS_STATX, si(-100), @int_from_ptr(path), si(flags), 0x7ff, @int_from_ptr(buf), 0);
}

pub fn mkdir(path: *u8, mode: i32) isize {
    return sys3(SYS_MKDIRAT, si(-100), @int_from_ptr(path), si(mode));
}

// flags 0x200 (AT_REMOVEDIR) removes a directory
pub fn unlink(path: *u8, flags: i32) isize {
    return sys3(SYS_UNLINKAT, si(-100), @int_from_ptr(path), si(flags));
}

pub fn rename(from: *u8, to: *u8) isize {
    return sys6(SYS_RENAMEAT2, si(-100), @int_from_ptr(from), si(-100), @int_from_ptr(to), 0, 0);
}

pub fn getdents64(fd: i32, buf: *mut u8, n: usize) isize {
    return sys3(SYS_GETDENTS64, si(fd), @int_from_ptr(buf), n);
}

pub fn getcwd(buf: *mut u8, n: usize) isize {
    return sys2(SYS_GETCWD, @int_from_ptr(buf), n);
}

pub fn lseek(fd: i32, off: i64, whence: i32) isize {
    return sys3(SYS_LSEEK, si(fd), @bit_cast(usize, @truncate(isize, off)), si(whence));
}

// Anonymous read-write memory, or 0.
pub fn mmap_anon(len: usize) usize {
    // PROT_READ | PROT_WRITE; MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE
    let r = sys6(SYS_MMAP, 0, len, 3, 0x4022, si(-1), 0);
    if (r < 0) and (r > -4096) {
        return 0;
    }
    return @bit_cast(usize, r);
}

// No access (a guard page).
pub fn protect_none(addr: usize, len: usize) isize {
    return sys3(SYS_MPROTECT, addr, len, 0);
}

pub fn munmap(addr: usize, len: usize) isize {
    return sys2(SYS_MUNMAP, addr, len);
}

pub fn madvise(addr: usize, len: usize, advice: i32) isize {
    return sys3(SYS_MADVISE, addr, len, si(advice));
}

// The kernel's struct sigaction (not the C library's): handler, flags,
// restorer, mask. On AArch64 the kernel supplies the return trampoline.
pub struct KSigAction {
    handler: fn(i32, *mut void, *mut void) void,
    flags: u64,
    restorer: fn() void,
    mask: u64,
}

struct KSigDefault {
    handler: usize,  // 0: SIG_DFL
    flags: u64,
    restorer: usize,
    mask: u64,
}

pub fn sigaction(sig: i32, handler: fn(i32, *mut void, *mut void) void, flags: u64) isize {
    let mut sa = KSigAction.{ handler: handler, flags: flags, restorer: ax_sigreturn, mask: 0 };
    if axiom_target_arch() != 2 {
        sa.flags |= 0x0400_0000;  // SA_RESTORER
    }
    return sys4(SYS_RT_SIGACTION, si(sig), @int_from_ptr(&sa), 0, 8);
}

// Back to the default action.
pub fn sigdefault(sig: i32) isize {
    let sa = KSigDefault.{ handler: 0, flags: 0, restorer: 0, mask: 0 };
    return sys4(SYS_RT_SIGACTION, si(sig), @int_from_ptr(&sa), 0, 8);
}

// Ignore the signal.
pub fn sigignore(sig: i32) isize {
    let sa = KSigDefault.{ handler: 1, flags: 0, restorer: 0, mask: 0 };
    return sys4(SYS_RT_SIGACTION, si(sig), @int_from_ptr(&sa), 0, 8);
}

pub struct StackT {
    sp: usize,
    flags: i32,
    size: usize,
}

pub fn sigaltstack(sp: usize, size: usize) isize {
    let st = StackT.{ sp: sp, flags: 0, size: size };
    return sys2(SYS_SIGALTSTACK, @int_from_ptr(&st), 0);
}

/// Stops using an alternate signal stack (SS_DISABLE).
pub fn sigaltstack_disable() isize {
    let st = StackT.{ sp: 0, flags: 2, size: 0 };
    return sys2(SYS_SIGALTSTACK, @int_from_ptr(&st), 0);
}

pub fn getpid() i32 {
    return @truncate(i32, sys0(SYS_GETPID));
}

pub fn gettid() i32 {
    return @truncate(i32, sys0(SYS_GETTID));
}

// Sends sig to the calling thread.
pub fn raise(sig: i32) isize {
    return sys3(SYS_TGKILL, si(getpid()), si(gettid()), si(sig));
}

pub fn exit(code: i32) void {
    loop {
        _ = sys1(SYS_EXIT_GROUP, si(code));
    }
}

pub fn sched_yield() isize {
    return sys0(SYS_SCHED_YIELD);
}

pub fn nanosleep(ns: u64) void {
    let mut ts = Timespec.{ sec: @bit_cast(i64, ns / 1_000_000_000), nsec: @bit_cast(i64, ns % 1_000_000_000) };
    loop {
        if sys2(SYS_NANOSLEEP, @int_from_ptr(&ts), @int_from_ptr(&ts)) != -EINTR {
            return;
        }
    }
}

pub fn futex(p: *u32, op: i32, val: u32, timeout: usize) isize {
    return sys6(SYS_FUTEX, @int_from_ptr(p), si(op), @as(usize, val), timeout, 0, 0);
}

pub fn socket(domain: i32, ty: i32, protocol: i32) isize {
    return sys3(SYS_SOCKET, si(domain), si(ty), si(protocol));
}

pub fn connect(fd: i32, addr: *void, len: u32) isize {
    return sys3(SYS_CONNECT, si(fd), ip(addr), @as(usize, len));
}

pub fn bind(fd: i32, addr: *void, len: u32) isize {
    return sys3(SYS_BIND, si(fd), ip(addr), @as(usize, len));
}

pub fn listen(fd: i32, backlog: i32) isize {
    return sys2(SYS_LISTEN, si(fd), si(backlog));
}

pub fn accept4(fd: i32, flags: i32) isize {
    return sys4(SYS_ACCEPT4, si(fd), 0, 0, si(flags));
}

pub fn setsockopt(fd: i32, level: i32, name: i32, value: *void, len: u32) isize {
    return ax_syscall(nr(SYS_SETSOCKOPT), si(fd), si(level), si(name), ip(value), @as(usize, len), 0);
}

pub fn getrandom(p: *mut u8, n: usize) isize {
    return sys3(SYS_GETRANDOM, @int_from_ptr(p), n, 0);
}

pub fn shutdown(fd: i32, how: i32) isize {
    return sys2(SYS_SHUTDOWN, si(fd), si(how));
}

pub fn getsockname(fd: i32, addr: *mut void, len: *mut u32) isize {
    return sys3(SYS_GETSOCKNAME, si(fd), @int_from_ptr(addr), @int_from_ptr(len));
}

pub fn sendto(fd: i32, p: *u8, n: usize, flags: i32, addr: usize, alen: u32) isize {
    return ax_syscall(nr(SYS_SENDTO), si(fd), @int_from_ptr(p), n, si(flags), addr, @as(usize, alen));
}

pub fn getpeername(fd: i32, addr: *mut void, len: *mut u32) isize {
    return sys3(SYS_GETPEERNAME, si(fd), @int_from_ptr(addr), @int_from_ptr(len));
}

// recvfrom, with the sender's address
pub fn recvfrom_addr(fd: i32, p: *mut u8, n: usize, addr: *mut void, len: *mut u32) isize {
    return ax_syscall(nr(SYS_RECVFROM), si(fd), @int_from_ptr(p), n, 0, @int_from_ptr(addr), @int_from_ptr(len));
}

pub fn recvfrom(fd: i32, p: *mut u8, n: usize, flags: i32) isize {
    return ax_syscall(nr(SYS_RECVFROM), si(fd), @int_from_ptr(p), n, si(flags), 0, 0);
}

// fork(): clone with SIGCHLD and nothing shared. 0 in the child.
pub fn fork() isize {
    return sys6(SYS_CLONE, 17, 0, 0, 0, 0, 0);
}

pub fn wait4(pid: i32, status: *mut i32, options: i32) isize {
    return sys4(SYS_WAIT4, si(pid), @int_from_ptr(status), si(options), 0);
}

pub fn execve(path: *u8, argv: usize, envp: usize) isize {
    return sys3(SYS_EXECVE, @int_from_ptr(path), argv, envp);
}

pub fn ioctl(fd: i32, req: u64, p: usize) isize {
    return sys3(SYS_IOCTL, si(fd), @truncate(usize, req), p);
}

const AT_FDCWD: usize = 0xffff_ffff_ffff_ff9c;  // -100

pub fn chmod(path: *u8, mode: u32) isize {
    return sys4(SYS_FCHMODAT, AT_FDCWD, @int_from_ptr(path), @as(usize, mode), 0);
}

pub fn symlink(target: *u8, name: *u8) isize {
    return sys3(SYS_SYMLINKAT, @int_from_ptr(target), AT_FDCWD, @int_from_ptr(name));
}

pub fn readlink(path: *u8, buf: *mut u8, n: usize) isize {
    return sys4(SYS_READLINKAT, AT_FDCWD, @int_from_ptr(path), @int_from_ptr(buf), n);
}

pub fn link(from: *u8, to: *u8) isize {
    return sys6(SYS_LINKAT, AT_FDCWD, @int_from_ptr(from), AT_FDCWD, @int_from_ptr(to), 0, 0);
}

// times: [atime, mtime] as seconds and nanoseconds
pub fn utimens(path: *u8, times: *[2]Timespec) isize {
    return sys4(SYS_UTIMENSAT, AT_FDCWD, @int_from_ptr(path), @int_from_ptr(times), 0);
}

pub fn ftruncate(fd: i32, size: i64) isize {
    return sys2(SYS_FTRUNCATE, si(fd), @truncate(usize, @bit_cast(u64, size)));
}

pub fn fsync(fd: i32) isize {
    return sys1(SYS_FSYNC, si(fd));
}

pub fn flock(fd: i32, op: i32) isize {
    return sys2(SYS_FLOCK, si(fd), si(op));
}

// A shared mapping of a file (prot: 1 read, 3 read and write).
pub fn mmap_file(len: usize, prot: i32, fd: i32, off: i64) isize {
    return sys6(SYS_MMAP, 0, len, si(prot), 1, si(fd), @truncate(usize, @bit_cast(u64, off)));
}

pub fn msync(addr: usize, len: usize) isize {
    return sys3(SYS_MSYNC, addr, len, 4);  // MS_SYNC
}

pub fn inotify_init() isize {
    return sys1(SYS_INOTIFY_INIT1, 0x80000 | 0x800);  // IN_CLOEXEC | IN_NONBLOCK
}

pub fn inotify_add_watch(fd: i32, path: *u8, mask: u32) isize {
    return sys3(SYS_INOTIFY_ADD_WATCH, si(fd), @int_from_ptr(path), @as(usize, mask));
}

pub fn inotify_rm_watch(fd: i32, wd: i32) isize {
    return sys2(SYS_INOTIFY_RM_WATCH, si(fd), si(wd));
}

pub fn chdir(path: *u8) isize {
    return sys1(SYS_CHDIR, @int_from_ptr(path));
}

pub fn kill(pid: i32, sig: i32) isize {
    return sys2(SYS_KILL, si(pid), si(sig));
}

pub fn pipe2(fds: *mut i32, flags: i32) isize {
    return sys2(SYS_PIPE2, @int_from_ptr(fds), si(flags));
}

pub fn dup2(a: i32, b: i32) isize {
    return sys3(SYS_DUP3, si(a), si(b), 0);
}

pub fn setitimer(which: i32, value: *void) isize {
    return sys3(SYS_SETITIMER, si(which), ip(value), 0);
}

// Dying from a signal then dumps no core (PR_SET_DUMPABLE 0): with a piped
// core_pattern (as under WSL) the kernel ignores RLIMIT_CORE, and a dump
// into a helper that does not read it never ends.
pub fn no_core_dump() isize {
    return sys2(SYS_PRCTL, 4, 0);
}

pub fn ppoll(fds: *mut void, n: u64, timeout_ms: i32) isize {
    let mut ts = Timespec.{ sec: @as(i64, timeout_ms) / 1000, nsec: (@as(i64, timeout_ms) % 1000) * 1000000 };
    let mut tsp: usize = 0;
    if timeout_ms >= 0 {
        tsp = @int_from_ptr(&ts);
    }
    return ax_syscall(nr(SYS_PPOLL), @int_from_ptr(fds), @truncate(usize, n), tsp, 0, 8, 0);
}

// clock_gettime through the vDSO, the kernel's code mapped into every process, which reads
// the clock without entering the kernel (a system call costs several times as much, and a
// program that times short pieces of work measures it); the system call when there is no
// vDSO or it has no clock_gettime, or it answers that it cannot read this clock.
pub fn clock_gettime(clock: i32, ts: *mut Timespec) isize {
    let f = vdso_clock_gettime();
    if f != 0 {
        let call = @bit_cast(fn(i32, *mut Timespec) i32, f);
        let r = call(clock, ts);
        if r == 0 {
            return 0;
        }
    }
    return sys2(SYS_CLOCK_GETTIME, si(clock), @int_from_ptr(ts));
}

// The address of the vDSO's clock_gettime, or 0: looked up once (every thread finds the same).
let mut vdso_cgt: usize = 0;
let mut vdso_looked_up: u32 = 0;

fn vdso_clock_gettime() usize {
    if @atomic_load(&vdso_looked_up) != 0 {
        return @atomic_load(&vdso_cgt);
    }
    let mut name: []u8 = "__vdso_clock_gettime";
    if axiom_target_arch() == 2 {
        name = "__kernel_clock_gettime";
    }
    let f = vdso_symbol(@truncate(usize, auxv(33)), name);  // AT_SYSINFO_EHDR
    @atomic_store(&mut vdso_cgt, f);
    @atomic_store(&mut vdso_looked_up, 1);
    return f;
}

fn rd8(a: usize) u8 {
    return @ptr_from_int(*u8, a).*;
}

fn rd16(a: usize) u16 {
    return @ptr_from_int(*u16, a).*;
}

fn rd32(a: usize) u32 {
    return @ptr_from_int(*u32, a).*;
}

fn rd64(a: usize) u64 {
    return @ptr_from_int(*u64, a).*;
}

// The address of the function `name` defined by the ELF image (the vDSO) at `base`, or 0.
fn vdso_symbol(base: usize, name: []u8) usize {
    if base == 0 {
        return 0;
    }
    // ELF64, little-endian ("\x7fELF", class 2, data 1)
    if (rd32(base) != 0x464c457f) or (rd8(base + 4) != 2) or (rd8(base + 5) != 1) {
        return 0;
    }
    let phoff = @truncate(usize, rd64(base + 32));
    let phentsize = @as(usize, rd16(base + 54));
    let phnum = @as(usize, rd16(base + 56));
    // Addresses in the image are virtual addresses of its first PT_LOAD.
    let mut load_bias: usize = 0;
    let mut have_load = false;
    let mut dynamic: usize = 0;
    for i in @as(usize, 0)..phnum {
        let ph = (base + phoff) + (i * phentsize);
        let kind = rd32(ph);
        let offset = @truncate(usize, rd64(ph + 8));
        let vaddr = @truncate(usize, rd64(ph + 16));
        if (kind == 1) and not have_load {  // PT_LOAD
            load_bias = (base + offset) -% vaddr;
            have_load = true;
        } else if kind == 2 {  // PT_DYNAMIC
            dynamic = base + offset;
        }
    }
    if (dynamic == 0) or not have_load {
        return 0;
    }
    let mut strtab: usize = 0;
    let mut symtab: usize = 0;
    let mut hash: usize = 0;
    let mut gnu_hash: usize = 0;
    let mut d = dynamic;
    loop {
        let tag = rd64(d);
        if tag == 0 {
            break;
        }
        let v = load_bias +% @truncate(usize, rd64(d + 8));
        if tag == 5 {  // DT_STRTAB
            strtab = v;
        } else if tag == 6 {  // DT_SYMTAB
            symtab = v;
        } else if tag == 4 {  // DT_HASH
            hash = v;
        } else if tag == 0x6ffffef5 {  // DT_GNU_HASH
            gnu_hash = v;
        }
        d += 16;
    }
    if (strtab == 0) or (symtab == 0) {
        return 0;
    }
    // The number of symbols: DT_HASH's chain count, else one past the last symbol a
    // DT_GNU_HASH chain reaches.
    let mut nsyms: usize = 0;
    if hash != 0 {
        nsyms = @as(usize, rd32(hash + 4));
    } else if gnu_hash != 0 {
        let nbuckets = @as(usize, rd32(gnu_hash));
        let symoffset = @as(usize, rd32(gnu_hash + 4));
        let bloom_size = @as(usize, rd32(gnu_hash + 8));
        let buckets = (gnu_hash + 16) + (bloom_size * 8);
        let chains = buckets + (nbuckets * 4);
        let mut last: usize = 0;
        for b in @as(usize, 0)..nbuckets {
            last = @max(last, @as(usize, rd32(buckets + (b * 4))));
        }
        if last >= symoffset {
            while (rd32(chains + ((last - symoffset) * 4)) & 1) == 0 {
                last += 1;
            }
            nsyms = last + 1;
        }
    }
    for i in @as(usize, 0)..nsyms {
        let sym = symtab + (i * 24);
        let info = rd8(sym + 4);
        let shndx = rd16(sym + 6);
        // a defined function (STT_FUNC), global or weak
        if ((info & 0xf) != 2) or (((info >> 4) != 1) and ((info >> 4) != 2)) or (shndx == 0) {
            continue;
        }
        let s = strtab + @as(usize, rd32(sym));
        let mut k: usize = 0;
        while (k < name.len) and (rd8(s + k) == name[k]) {
            k += 1;
        }
        if (k == name.len) and (rd8(s + k) == 0) {
            return load_bias +% @truncate(usize, rd64(sym + 8));
        }
    }
    return 0;
}

// The number of processors the program may run on.
pub fn cpu_count() u32 {
    let mut set: [128]u64 = [0; 128];
    let r = sys3(SYS_SCHED_GETAFFINITY, 0, 1024, @int_from_ptr(&mut set[0]));
    if r <= 0 {
        return 1;
    }
    let mut n: u64 = 0;
    for i in 0..@bit_cast(usize, r) / 8 {
        n += @popcount(set[i]);
    }
    if n == 0 {
        return 1;
    }
    return @truncate(u32, n);
}

pub fn timer_create(clock: i32, sev: *void, timer: *mut i32) isize {
    return sys3(SYS_TIMER_CREATE, si(clock), ip(sev), @int_from_ptr(timer));
}

pub fn timer_settime(timer: i32, value: *void) isize {
    return sys4(SYS_TIMER_SETTIME, si(timer), 0, ip(value), 0);
}

pub fn timer_delete(timer: i32) isize {
    return sys1(SYS_TIMER_DELETE, si(timer));
}

// -----------------------------------------------------------------------------
// The process's environment, from the stack at entry: argc, argv..., 0,
// envp..., 0.
// -----------------------------------------------------------------------------
fn cstr_len(p: usize) usize {
    let mut n: usize = 0;
    while @ptr_from_int(*u8, p + n).* != 0 {
        n += 1;
    }
    return n;
}

// Entry `kind` of the auxiliary vector the kernel passed the program (0 if
// it has none): after the environment on the start-up stack, or, when the
// C library's _start ran instead of ours, from /proc/self/auxv.
pub fn auxv(kind: u64) u64 {
    let sp = ax_start_sp();
    if sp != 0 {
        let argc = @ptr_from_int(*usize, sp).*;
        let mut e = sp + ((argc + 2) * 8);
        while @ptr_from_int(*usize, e).* != 0 {
            e += 8;
        }
        e += 8;
        loop {
            let k = @ptr_from_int(*u64, e).*;
            if k == 0 {
                return 0;
            }
            if k == kind {
                return @ptr_from_int(*u64, e + 8).*;
            }
            e += 16;
        }
    }
    let fd = open("/proc/self/auxv".ptr, 0, 0);
    if fd < 0 {
        return 0;
    }
    let mut v: [256]u64 = [0; 256];
    let n = read(@truncate(i32, fd), @ptr_cast(*mut u8, &mut v[0]), 2048);
    _ = close(@truncate(i32, fd));
    if n <= 0 {
        return 0;
    }
    let mut i: usize = 0;
    while (i + 1) < (@bit_cast(usize, n) / 8) {
        if v[i] == 0 {
            return 0;
        }
        if v[i] == kind {
            return v[i + 1];
        }
        i += 2;
    }
    return 0;
}

// main's arguments (std/internal/runtime/native.ax: ax_rt_args), for when the C
// library's _start ran instead of ours (a program linked by the C toolchain)
pub let mut main_argc: usize = 0;
pub let mut main_argv: usize = 0;

// Argument i of the program, or an empty slice with a 0 pointer if there is
// no such argument.
pub fn arg(i: usize) []u8 {
    let none = @slice_from_ptr(@ptr_from_int(*u8, 0), 0);
    let sp = ax_start_sp();
    let mut argc: usize = 0;
    let mut argv: usize = 0;
    if sp != 0 {
        argc = @ptr_from_int(*usize, sp).*;
        argv = sp + @size_of(usize);
    } else if main_argv != 0 {
        argc = main_argc;
        argv = main_argv;
    }
    if i >= argc {
        return none;
    }
    let p = @ptr_from_int(*usize, argv + (i * @size_of(usize))).*;
    return @slice_from_ptr(@ptr_from_int(*u8, p), cstr_len(p));
}

pub fn arg_count() usize {
    let sp = ax_start_sp();
    if sp != 0 {
        return @ptr_from_int(*usize, sp).*;
    }
    return main_argc;
}

// Entry k ("NAME=value") of the environment the program started with, or
// an empty slice with a 0 pointer past the last.
pub fn env_entry(k: usize) []u8 {
    let none = @slice_from_ptr(@ptr_from_int(*u8, 0), 0);
    let sp = ax_start_sp();
    let mut e: usize = 0;
    if sp != 0 {
        let argc = @ptr_from_int(*usize, sp).*;
        e = sp + ((argc + 2) * @size_of(usize));
    } else if main_argv != 0 {
        e = main_argv + ((main_argc + 1) * @size_of(usize));
    } else {
        return none;
    }
    for _i in @as(usize, 0)..k {
        if @ptr_from_int(*usize, e).* == 0 {
            return none;
        }
        e += @size_of(usize);
    }
    let p = @ptr_from_int(*usize, e).*;
    if p == 0 {
        return none;
    }
    return @slice_from_ptr(@ptr_from_int(*u8, p), cstr_len(p));
}

// The value of environment variable `name`, or nosym (a 0 pointer) if unset.
pub fn getenv(name: []u8) []u8 {
    let none = @slice_from_ptr(@ptr_from_int(*u8, 0), 0);
    let sp = ax_start_sp();
    let mut e: usize = 0;
    if sp != 0 {
        let argc = @ptr_from_int(*usize, sp).*;
        e = sp + ((argc + 2) * @size_of(usize));
    } else if main_argv != 0 {
        e = main_argv + ((main_argc + 1) * @size_of(usize));
    } else {
        return none;
    }
    loop {
        let p = @ptr_from_int(*usize, e).*;
        if p == 0 {
            return none;
        }
        let s = @slice_from_ptr(@ptr_from_int(*u8, p), cstr_len(p));
        if (s.len > name.len) and (s[name.len] == '=') and @mem_eq(s[0..name.len], name) {
            return s[name.len + 1..];
        }
        e += @size_of(usize);
    }
}
