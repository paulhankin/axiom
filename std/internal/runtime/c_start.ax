// =============================================================================
// std/internal/runtime/c_start.ax - the start-up of a C program: the root
// module of `axiom build prog.c`, compiled as any Axiom program is. Its main
// gives the C program's main its arguments, as C strings, and returns its
// status.
//
// The C front end (cmd/axiom/src/c/cgen.ax) generates the translation unit
// into the same IR module, with a function __axiom_c_main(argc, argv) that
// calls the program's main (with or without the arguments, as main takes
// them) and returns its value as an i32. If the program defines exit (a C
// unit, or an Axiom module's export fn: the hosted C library's), or on
// Windows (the system C library's), __axiom_c_main calls exit with that
// value, which then ends the process (5.1.2.2.3).
//
// The order (docs/c.md, "Start-up and exit"): the runtime's entry point
// (codegen.ax: emit_native_entry; on WebAssembly the host) starts the
// runtime (ax_rt_args, the processor check, ax_rt_init), then calls this
// main, which allocates the arguments with the Axiom allocator, so that
// the whole runtime works from C main's first instruction; main's status
// comes back here unless exit was called, and the entry point finishes the
// runtime (ax_rt_fini) and returns it. Axiom modules beside a C program
// (`axiom build main.c rt.ax`) are part of this module's program.
// =============================================================================
import "../../mem.ax" as mem;
import "../../os.ax" as os;

extern "C" {
    fn __axiom_c_main(argc: i32, argv: *mut *mut u8) i32;
}

export fn main() i32 {
    let n = os.arg_count();
    let argv = mem.alloc.[*mut u8](n + 1) catch {
        return 1;
    };
    for i in 0..n {
        argv[i] = @ptr_from_int(*mut u8, 0);
        let a = os.arg(i) catch {
            continue;
        };
        let s = mem.alloc.[u8](a.len + 1) catch {
            continue;
        };
        @mem_copy(s[0..a.len], a);
        s[a.len] = 0;
        argv[i] = s.ptr;
        mem.free(a);
    }
    argv[n] = @ptr_from_int(*mut u8, 0);
    return __axiom_c_main(@truncate(i32, @bit_cast(isize, n)), argv.ptr);
}
