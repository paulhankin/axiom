// =============================================================================
// std/internal/runtime/native.ax - the Axiom host ABI (import module "axiom") for
// native targets on Linux, and crash reporting (trap messages and stack
// traces, spec §16.4). The compiler builds it into every native
// program; ax_rt_init runs before `main` and ax_rt_fini after it.
//
// Everything goes through Linux system calls (linux.ax): no C library.
// Threads are made with clone() on memory the runtime maps (stack, guard
// page, thread-local storage, signal stack). Host names are resolved here
// too: dotted quads, localhost, /etc/hosts, then DNS (A records) over UDP to
// the name servers of /etc/resolv.conf. If the program is linked against the
// C library (it calls C), threads come from pthread_create instead, so that
// C code on them has the C library's thread state.
// =============================================================================
import "linux.ax" as sys;
import "trap_format.ax" as tf;

pub extern "C" {
    fn axiom_shadow_stack() *tf.ShadowStack;
    fn axiom_frame_table() *usize;
    fn axiom_frame_address() *usize;
    // only called when the C library is linked (see cmd/axiom/src/lstub.ax)
    fn pthread_create(t: *mut u64, attr: *void, f: fn(*mut void) *mut void, arg: *mut void) i32;
    fn pthread_attr_init(a: *mut void) i32;
    fn pthread_attr_setdetachstate(a: *mut void, s: i32) i32;
    fn pthread_attr_destroy(a: *mut void) i32;
}

// Error codes shared with std/internal/runtime/host.mjs and std/net.ax.
const AX_ERR: i32 = -1;
const AX_REFUSED: i32 = -2;
const AX_ADDR_IN_USE: i32 = -3;
const AX_BAD_ADDRESS: i32 = -4;
const AX_TIMED_OUT: i32 = -5;

pub const SIGBUS: i32 = 7;
pub const SIGFPE: i32 = 8;
pub const SIGSEGV: i32 = 11;

pub fn nil_ptr[T]() *mut T {
    return @ptr_from_int(*mut T, 0);
}

fn retry(r: isize) bool {
    return r == -sys.EINTR;
}

export fn ax_write(fd: i32, p: *u8, n: usize) isize {
    loop {
        let r = sys.write(fd, p, n);
        if retry(r) {
            continue;
        }
        if r < 0 {
            return -1;
        }
        return r;
    }
}

export fn ax_read(fd: i32, p: *mut u8, n: usize) isize {
    loop {
        let r = sys.read(fd, p, n);
        if retry(r) {
            continue;
        }
        if r < 0 {
            return -1;
        }
        return r;
    }
}

// A NUL-terminated copy of s in buf (false if it does not fit).
fn copy_cstr(buf: []mut u8, s: *u8, n: usize) bool {
    if (n + 1) > buf.len {
        return false;
    }
    if n > 0 {
        @mem_copy(buf[0..n], @slice_from_ptr(s, n));
    }
    // a NUL would silently cut the name short
    for i in @as(usize, 0)..n {
        if buf[i] == 0 {
            return false;
        }
    }
    buf[n] = 0;
    return true;
}

export fn ax_open(path: *u8, len: usize, flags: u32) i32 {
    let mut buf: [4096]u8 = [0; 4096];
    if not copy_cstr(buf[..], path, len) {
        return AX_ERR;
    }
    let mut f: i32 = 0;  // O_RDONLY
    if flags == 1 {
        f = (1 | 0x40) | 0x200;  // O_WRONLY | O_CREAT | O_TRUNC
    } else if flags == 2 {
        f = (1 | 0x40) | 0x400;  // O_WRONLY | O_CREAT | O_APPEND
    } else if flags == 3 {
        f = 2;  // O_RDWR
    }
    let fd = sys.open(&buf[0], f | 0x80000, 0o644);  // O_CLOEXEC
    if fd >= 0 {
        return @truncate(i32, fd);
    }
    if fd == -sys.ENOENT {
        return -2;
    }
    if fd == -sys.EACCES {
        return -13;
    }
    return AX_ERR;
}

// Creates (or truncates) a file for writing; a new file gets the permission
// bits mode (less the umask).
export fn ax_create(path: *u8, len: usize, mode: u32) i32 {
    let mut buf: [4096]u8 = [0; 4096];
    if not copy_cstr(buf[..], path, len) {
        return AX_ERR;
    }
    // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC
    let fd = sys.open(&buf[0], ((1 | 0x40) | 0x200) | 0x80000, @bit_cast(i32, mode & 0o777));
    if fd >= 0 {
        return @truncate(i32, fd);
    }
    return fs_err(fd);
}

export fn ax_close(fd: i32) void {
    _ = sys.close(fd);
}

// -----------------------------------------------------------------------------
// Files, directories and the process
// -----------------------------------------------------------------------------

// The host ABI's code for a failed call's -errno.
fn fs_err(r: isize) i32 {
    let e = -r;
    if e == sys.ENOENT {
        return -2;
    }
    if (e == sys.EACCES) or (e == sys.EPERM) {
        return -13;
    }
    if e == sys.EEXIST {
        return -17;
    }
    if e == sys.ENOTDIR {
        return -20;
    }
    if e == sys.EISDIR {
        return -21;
    }
    if e == sys.ENOTEMPTY {
        return -39;
    }
    if e == sys.ELOOP {
        return -40;
    }
    return AX_ERR;
}

fn rd16(b: []u8, i: usize) u32 {
    return @as(u32, b[i]) | (@as(u32, b[i + 1]) << 8);
}

fn rd32(b: []u8, i: usize) u32 {
    return rd16(b, i) | (rd16(b, i + 2) << 16);
}

fn rd64(b: []u8, i: usize) u64 {
    return @as(u64, rd32(b, i)) | (@as(u64, rd32(b, i + 4)) << 32);
}

// out: kind (1 file, 2 directory, 3 symbolic link, 4 other), size,
// modification time (ns since 1970), permission bits
export fn ax_stat(path: *u8, len: usize, follow: u32, out: *mut i64) i32 {
    let mut buf: [4096]u8 = [0; 4096];
    if not copy_cstr(buf[..], path, len) {
        return AX_ERR;
    }
    let mut st: [256]u8 = [0; 256];
    let mut flags: i32 = 0x100;  // AT_SYMLINK_NOFOLLOW
    if follow != 0 {
        flags = 0;
    }
    let r = sys.statx(&buf[0], flags, &mut st[0]);
    if r < 0 {
        return fs_err(r);
    }
    stat_out(st[..], out);
    return 0;
}

// As ax_stat, for an open file.
export fn ax_fstat(fd: i32, out: *mut i64) i32 {
    let mut st: [256]u8 = [0; 256];
    let r = sys.fstatx(fd, &mut st[0]);
    if r < 0 {
        return fs_err(r);
    }
    stat_out(st[..], out);
    return 0;
}

// ax_stat's out[0..4] from a struct statx.
fn stat_out(st: []u8, out: *mut i64) void {
    let mode = rd16(st, 28);
    let fmt = mode & 0o170000;
    let mut kind: i64 = 4;
    if fmt == 0o100000 {
        kind = 1;
    } else if fmt == 0o040000 {
        kind = 2;
    } else if fmt == 0o120000 {
        kind = 3;
    }
    let o = @slice_from_ptr(out, 4);
    o[0] = kind;
    o[1] = @bit_cast(i64, rd64(st, 40));
    // (nanoseconds overflow 64 bits for times past 2262: saturate)
    o[2] = @add_sat(@mul_sat(@bit_cast(i64, rd64(st, 112)), 1000000000), @as(i64, rd32(st, 120)));
    o[3] = @as(i64, mode & 0o7777);
}

export fn ax_mkdir(path: *u8, len: usize, mode: u32) i32 {
    let mut buf: [4096]u8 = [0; 4096];
    if not copy_cstr(buf[..], path, len) {
        return AX_ERR;
    }
    let r = sys.mkdir(&buf[0], @bit_cast(i32, mode & 0o7777));
    if r < 0 {
        return fs_err(r);
    }
    return 0;
}

export fn ax_remove(path: *u8, len: usize, dir: u32) i32 {
    let mut buf: [4096]u8 = [0; 4096];
    if not copy_cstr(buf[..], path, len) {
        return AX_ERR;
    }
    let mut flags: i32 = 0;
    if dir != 0 {
        flags = 0x200;  // AT_REMOVEDIR
    }
    let r = sys.unlink(&buf[0], flags);
    if r < 0 {
        return fs_err(r);
    }
    return 0;
}

export fn ax_rename(from: *u8, flen: usize, to: *u8, tlen: usize) i32 {
    let mut a: [4096]u8 = [0; 4096];
    let mut b: [4096]u8 = [0; 4096];
    if not copy_cstr(a[..], from, flen) or not copy_cstr(b[..], to, tlen) {
        return AX_ERR;
    }
    let r = sys.rename(&a[0], &b[0]);
    if r < 0 {
        return fs_err(r);
    }
    return 0;
}

// Writes the directory's entries (not . and ..) to buf as a kind byte
// (as ax_stat's, 0 if unknown), the name and a 0 byte each; returns the
// bytes all of them need (more than cap: call again with more room).
export fn ax_readdir(path: *u8, len: usize, buf: *mut u8, cap: usize) isize {
    let mut name: [4096]u8 = [0; 4096];
    if not copy_cstr(name[..], path, len) {
        return @as(isize, AX_ERR);
    }
    let fd = sys.open(&name[0], 0x80000, 0);  // O_RDONLY | O_CLOEXEC
    if fd < 0 {
        return @as(isize, fs_err(fd));
    }
    let r = read_entries(@truncate(i32, fd), buf, cap);
    _ = sys.close(@truncate(i32, fd));
    return r;
}

// ax_readdir's work on an open directory, from its start.
fn read_entries(fd: i32, buf: *mut u8, cap: usize) isize {
    let s = sys.lseek(fd, 0, 0);
    if s < 0 {
        return @as(isize, fs_err(s));
    }
    let out = @slice_from_ptr(buf, cap);
    let mut need: usize = 0;
    let mut d: [8192]u8 = [0; 8192];
    loop {
        let n = sys.getdents64(fd, &mut d[0], d.len);
        if n < 0 {
            return @as(isize, fs_err(n));
        }
        if n == 0 {
            break;
        }
        let mut p: usize = 0;
        while p < @bit_cast(usize, n) {
            let reclen = @as(usize, rd16(d[..], p + 16));
            let ty = d[p + 18];
            let mut e = p + 19;
            while (e < (p + reclen)) and (d[e] != 0) {
                e += 1;
            }
            let nm = d[p + 19..e];
            let dots = ((nm.len == 1) and (nm[0] == '.')) or ((nm.len == 2) and (nm[0] == '.') and (nm[1] == '.'));
            if not dots {
                let mut kind: u8 = 0;
                if ty == 8 {
                    kind = 1;  // DT_REG
                } else if ty == 4 {
                    kind = 2;  // DT_DIR
                } else if ty == 10 {
                    kind = 3;  // DT_LNK
                } else if ty != 0 {
                    kind = 4;
                }
                if (need + nm.len + 2) <= cap {
                    out[need] = kind;
                    @mem_copy(out[need + 1..need + 1 + nm.len], nm);
                    out[need + 1 + nm.len] = 0;
                }
                need += nm.len + 2;
            }
            p += reclen;
        }
    }
    return @bit_cast(isize, need);
}

// Directory handles, for walking trees without following symbolic links
// that are swapped in meanwhile. dir is a handle from ax_dir_open, or -1
// for the working directory; name is a path (from -1) or a single entry.

// Opens a directory, failing with -40 if name is a symbolic link and -20
// if it is something else.
export fn ax_dir_open(dir: i32, name: *u8, len: usize) i32 {
    let mut buf: [4096]u8 = [0; 4096];
    if not copy_cstr(buf[..], name, len) {
        return AX_ERR;
    }
    let mut at = dir;
    if dir < 0 {
        at = -100;  // AT_FDCWD
    }
    let r = sys.open_dir_at(at, &buf[0]);
    if r < 0 {
        return fs_err(r);
    }
    return @truncate(i32, r);
}

// As ax_readdir, for a handle.
export fn ax_dir_read(dir: i32, buf: *mut u8, cap: usize) isize {
    return read_entries(dir, buf, cap);
}

// Removes an entry (a directory if dir != 0) of a directory.
export fn ax_dir_remove(dir: i32, name: *u8, len: usize, isdir: u32) i32 {
    let mut buf: [4096]u8 = [0; 4096];
    if not copy_cstr(buf[..], name, len) {
        return AX_ERR;
    }
    let mut at = dir;
    if dir < 0 {
        at = -100;
    }
    let mut flags: i32 = 0;
    if isdir != 0 {
        flags = 0x200;  // AT_REMOVEDIR
    }
    let r = sys.unlink_at(at, &buf[0], flags);
    if r < 0 {
        return fs_err(r);
    }
    return 0;
}

export fn ax_dir_close(dir: i32) void {
    _ = sys.close(dir);
}

// out: device, inode: the identity of an open directory (to check one
// reopened through a child's "..").
export fn ax_dir_stat(dir: i32, out: *mut i64) i32 {
    let mut st: [256]u8 = [0; 256];
    let r = sys.fstatx(dir, &mut st[0]);
    if r < 0 {
        return fs_err(r);
    }
    let o = @slice_from_ptr(out, 2);
    o[0] = @bit_cast(i64, (@as(u64, rd32(st[..], 136)) << 32) | @as(u64, rd32(st[..], 140)));  // stx_dev_major, minor
    o[1] = @bit_cast(i64, rd64(st[..], 32));  // stx_ino
    return 0;
}

export fn ax_getcwd(buf: *mut u8, cap: usize) isize {
    let mut tmp: [4096]u8 = [0; 4096];
    let r = sys.getcwd(&mut tmp[0], tmp.len);
    if r < 0 {
        return @as(isize, fs_err(r));
    }
    let mut n: usize = 0;
    while (n < tmp.len) and (tmp[n] != 0) {
        n += 1;
    }
    if n <= cap {
        @mem_copy(@slice_from_ptr(buf, n), tmp[..n]);
    }
    return @bit_cast(isize, n);
}

// whence: 0 from the start, 1 from the current position, 2 from the end
export fn ax_seek(fd: i32, off: i64, whence: u32) i64 {
    let r = sys.lseek(fd, off, @bit_cast(i32, whence));
    if r < 0 {
        return @as(i64, fs_err(r));
    }
    return @as(i64, r);
}

export fn ax_argc() i32 {
    return @truncate(i32, @bit_cast(isize, sys.arg_count()));
}

// Copies argument i to buf; returns its length (-1 if there is none).
export fn ax_arg(i: i32, buf: *mut u8, cap: usize) isize {
    if i < 0 {
        return @as(isize, AX_ERR);
    }
    let a = sys.arg(@as(usize, @bit_cast(u32, i)));
    if (a.len == 0) and (@int_from_ptr(a.ptr) == 0) {
        return @as(isize, AX_ERR);
    }
    if a.len <= cap {
        @mem_copy(@slice_from_ptr(buf, a.len), a);
    }
    return @bit_cast(isize, a.len);
}

// Copies environment variable name's value to buf; returns its length (-2
// if it is not set).
export fn ax_getenv(name: *u8, len: usize, buf: *mut u8, cap: usize) isize {
    if @atomic_load(&env_blob) != 0 {
        return env_get(@slice_from_ptr(name, len), buf, cap);
    }
    let v = sys.getenv(@slice_from_ptr(name, len));
    if (v.len == 0) and (@int_from_ptr(v.ptr) == 0) {
        return -2;
    }
    if v.len <= cap {
        @mem_copy(@slice_from_ptr(buf, v.len), v);
    }
    return @bit_cast(isize, v.len);
}

export fn ax_exit(code: i32) void {
    ax_rt_fini();
    sys.exit(code);
}

// -----------------------------------------------------------------------------
// Host names (IPv4)
// -----------------------------------------------------------------------------
// An IPv4 address, as its four bytes in network order (a in the low byte).
fn parse_ipv4(s: []u8) i64 {
    let mut v: u32 = 0;
    let mut part: u32 = 0;
    let mut digits: u32 = 0;
    let mut dots: u32 = 0;
    for i in 0..s.len + 1 {
        if (i == s.len) or (s[i] == '.') {
            if (digits == 0) or (part > 255) {
                return -1;
            }
            v |= part << (dots * 8);
            if i < s.len {
                dots += 1;
                if dots > 3 {
                    return -1;
                }
            }
            part = 0;
            digits = 0;
        } else if (s[i] >= '0') and (s[i] <= '9') {
            part = (part * 10) + @as(u32, s[i] - '0');
            digits += 1;
            if digits > 3 {
                return -1;
            }
        } else {
            return -1;
        }
    }
    if dots != 3 {
        return -1;
    }
    return @as(i64, v);
}

fn lower(c: u8) u8 {
    if (c >= 'A') and (c <= 'Z') {
        return c + 32;
    }
    return c;
}

fn same_name(a: []u8, b: []u8) bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if lower(a[i]) != lower(b[i]) {
            return false;
        }
    }
    return true;
}

fn is_space(c: u8) bool {
    return (c == ' ') or (c == '\t') or (c == '\r');
}

// Reads a small file (up to buf.len bytes); its bytes, or none.
fn read_small(path: []u8, buf: []mut u8) []u8 {
    let mut name: [256]u8 = [0; 256];
    if not copy_cstr(name[..], path.ptr, path.len) {
        return buf[0..0];
    }
    let fd = sys.open(&name[0], 0x80000, 0);
    if fd < 0 {
        return buf[0..0];
    }
    let mut n: usize = 0;
    while n < buf.len {
        let r = sys.read(@truncate(i32, fd), &mut buf[n], buf.len - n);
        if retry(r) {
            continue;
        }
        if r <= 0 {
            break;
        }
        n += @bit_cast(usize, r);
    }
    _ = sys.close(@truncate(i32, fd));
    return buf[0..n];
}

// The words of each line of `text` (comments removed), one line at a time.
struct Lines {
    text: []u8,
    pos: usize,
    words: [8][]u8,
    n: usize,

    fn next(self: *mut Self) bool {
        if self.pos >= self.text.len {
            return false;
        }
        let mut end = self.pos;
        while (end < self.text.len) and (self.text[end] != '\n') {
            end += 1;
        }
        let mut line = self.text[self.pos..end];
        self.pos = end + 1;
        for i in 0..line.len {
            if line[i] == '#' {
                line = line[0..i];
                break;
            }
        }
        self.n = 0;
        let mut i: usize = 0;
        while (i < line.len) and (self.n < 8) {
            while (i < line.len) and is_space(line[i]) {
                i += 1;
            }
            let s = i;
            while (i < line.len) and not is_space(line[i]) {
                i += 1;
            }
            if i > s {
                self.words[self.n] = line[s..i];
                self.n += 1;
            }
        }
        return true;
    }
}

fn lines(text: []u8) Lines {
    return Lines.{ text: text, pos: 0, words: [text[0..0]; 8], n: 0 };
}

let mut file_buf: [65536]u8 = [0; 65536];

fn from_hosts(name: []u8, out: []mut u32) usize {
    let mut ls = lines(read_small("/etc/hosts", file_buf[..]));
    let mut n: usize = 0;
    while ls.next() {
        if ls.n < 2 {
            continue;
        }
        let a = parse_ipv4(ls.words[0]);
        if a < 0 {
            continue;
        }
        for k in 1..ls.n {
            if same_name(ls.words[k], name) and (n < out.len) {
                out[n] = @truncate(u32, @bit_cast(u64, a));
                n += 1;
            }
        }
    }
    return n;
}

struct SockAddrIn {
    family: u16,
    port: u16,  // network byte order
    addr: u32,  // network byte order
    zero: u64,
}

fn sockaddr(a: u32, port: u32) SockAddrIn {
    let p = @truncate(u16, ((port & 0xff) << 8) | ((port >> 8) & 0xff));
    return SockAddrIn.{ family: 2, port: p, addr: a, zero: 0 };
}

// One DNS query for the A records of `name`, to name server `ns`.
fn dns_query(name: []u8, ns: u32, out: []mut u32) usize {
    let mut q: [512]u8 = [0; 512];
    // a random query id (with the source check below, a spoofed answer
    // must guess it)
    let mut rid: [2]u8 = [0, 0];
    if sys.getrandom(&mut rid[0], 2) != 2 {
        let mut ts = sys.Timespec.{ sec: 0, nsec: 0 };
        _ = sys.clock_gettime(1, &mut ts);
        rid[0] = @truncate(u8, @bit_cast(u64, ts.nsec) >> 8);
        rid[1] = @truncate(u8, @bit_cast(u64, ts.nsec ^ ts.sec));
    }
    let id = (@as(u16, rid[0]) << 8) | @as(u16, rid[1]);
    q[0] = @truncate(u8, id >> 8);
    q[1] = @truncate(u8, id);
    q[2] = 1;  // recursion desired
    q[5] = 1;  // one question
    let mut n: usize = 12;
    let mut s: usize = 0;
    for i in 0..name.len + 1 {
        if (i == name.len) or (name[i] == '.') {
            let len = i - s;
            if (len == 0) or (len > 63) or ((n + len + 6) > q.len) {
                return 0;
            }
            q[n] = @truncate(u8, len);
            @mem_copy(q[n + 1..n + 1 + len], name[s..i]);
            n += len + 1;
            s = i + 1;
        }
    }
    q[n] = 0;
    q[n + 2] = 1;  // type A
    q[n + 4] = 1;  // class IN
    n += 5;
    let fd = sys.socket(2, 2 | 0x80000, 0);  // AF_INET, SOCK_DGRAM | SOCK_CLOEXEC
    if fd < 0 {
        return 0;
    }
    let sock = @truncate(i32, fd);
    let sa = sockaddr(ns, 53);
    // connected: the kernel drops datagrams from anyone but the name server
    if sys.connect(sock, @ptr_cast(*void, &sa), 16) < 0 {
        _ = sys.close(sock);
        return 0;
    }
    let mut got: usize = 0;
    let mut r: [1024]u8 = [0; 1024];
    for _attempt in @as(u32, 0)..2 {
        if sys.sendto(sock, &q[0], n, 0, 0, 0) < 0 {
            break;
        }
        let mut pfd: [2]u32 = [@bit_cast(u32, sock), 1];  // POLLIN
        if sys.ppoll(@ptr_cast(*mut void, &mut pfd[0]), 1, 2000) <= 0 {
            continue;
        }
        let len = sys.recvfrom(sock, &mut r[0], r.len, 0);
        if len < 12 {
            continue;
        }
        got = parse_answer(r[0..@bit_cast(usize, len)], id, q[12..n], out);
        break;
    }
    _ = sys.close(sock);
    return got;
}

// Skips a (possibly compressed) name at i; the index after it.
fn skip_name(m: []u8, i0: usize) usize {
    let mut i = i0;
    while i < m.len {
        let c = m[i];
        if c == 0 {
            return i + 1;
        }
        if (c & 0xC0) == 0xC0 {
            return i + 2;
        }
        i += @as(usize, c) + 1;
    }
    return m.len;
}

fn be16(m: []u8, i: usize) usize {
    return (@as(usize, m[i]) << 8) | @as(usize, m[i + 1]);
}

fn parse_answer(m: []u8, id: u16, question: []u8, out: []mut u32) usize {
    if (be16(m, 0) != @as(usize, id)) or ((m[3] & 15) != 0) {
        return 0;
    }
    let qd = be16(m, 4);
    let an = be16(m, 6);
    // the answer is to our question
    if (qd != 1) or ((12 + question.len) > m.len) or not u_eq(m[12..12 + question.len], question) {
        return 0;
    }
    let mut i: usize = 12 + question.len;
    let mut n: usize = 0;
    for _a in 0..an {
        i = skip_name(m, i);
        if (i + 10) > m.len {
            break;
        }
        let ty = be16(m, i);
        let len = be16(m, i + 8);
        i += 10;
        if (i + len) > m.len {
            break;
        }
        if (ty == 1) and (len == 4) and (n < out.len) {
            out[n] = @as(u32, m[i]) | (@as(u32, m[i + 1]) << 8) | (@as(u32, m[i + 2]) << 16) | (
                @as(u32, m[i + 3]) << 24);
            n += 1;
        }
        i += len;
    }
    return n;
}

fn from_dns(name: []u8, out: []mut u32) usize {
    let mut servers: [4]u32 = [0; 4];
    let mut ns: usize = 0;
    let mut search: [4][]u8 = [name[0..0]; 4];
    let mut nsearch: usize = 0;
    let mut ls = lines(read_small("/etc/resolv.conf", file_buf[..]));
    while ls.next() {
        if (ls.n >= 2) and u_eq(ls.words[0], "nameserver") and (ns < 4) {
            let a = parse_ipv4(ls.words[1]);
            if a >= 0 {
                servers[ns] = @truncate(u32, @bit_cast(u64, a));
                ns += 1;
            }
        } else if (ls.n >= 2) and (u_eq(ls.words[0], "search") or u_eq(ls.words[0], "domain")) {
            for k in 1..ls.n {
                if nsearch < 4 {
                    search[nsearch] = ls.words[k];
                    nsearch += 1;
                }
            }
        }
    }
    if ns == 0 {
        servers[0] = 0x0100007F;  // 127.0.0.1
        ns = 1;
    }
    // the names to try: as given, then with each search domain if it has no dot
    let mut names: [5][]u8 = [name; 5];
    let mut storage: [5][256]u8 = [[0; 256]; 5];
    let mut nn: usize = 1;
    let mut dotted = false;
    for c in name {
        if c == '.' {
            dotted = true;
        }
    }
    if not dotted {
        for k in 0..nsearch {
            let d = search[k];
            if (name.len + 1 + d.len) <= 256 {
                @mem_copy(storage[nn][0..name.len], name);
                storage[nn][name.len] = '.';
                @mem_copy(storage[nn][name.len + 1..name.len + 1 + d.len], d);
                names[nn] = storage[nn][0..name.len + 1 + d.len];
                nn += 1;
            }
        }
    }
    for k in 0..nn {
        for s in 0..ns {
            let n = dns_query(names[k], servers[s], out);
            if n > 0 {
                return n;
            }
        }
    }
    return 0;
}

fn u_eq(a: []u8, b: []u8) bool {
    return (a.len == b.len) and @mem_eq(a, b);
}

// The IPv4 addresses of a host name (at most out.len); 0 if none.
fn resolve(name: []u8, out: []mut u32) usize {
    let a = parse_ipv4(name);
    if a >= 0 {
        out[0] = @truncate(u32, @bit_cast(u64, a));
        return 1;
    }
    if (name.len == 0) or (name.len > 253) {
        return 0;
    }
    if same_name(name, "localhost") {
        out[0] = 0x0100007F;
        return 1;
    }
    let n = from_hosts(name, out);
    if n > 0 {
        return n;
    }
    return from_dns(name, out);
}

export fn ax_tcp_connect(name: *u8, len: usize, port: u32) i32 {
    let mut addrs: [8]u32 = [0; 8];
    let n = resolve(@slice_from_ptr(name, len), addrs[..]);
    if n == 0 {
        return AX_BAD_ADDRESS;
    }
    let mut result = AX_ERR;
    for i in 0..n {
        let fd = sys.socket(2, 1 | 0x80000, 0);  // AF_INET, SOCK_STREAM | SOCK_CLOEXEC
        if fd < 0 {
            continue;
        }
        let sa = sockaddr(addrs[i], port);
        let r = sys.connect(@truncate(i32, fd), @ptr_cast(*void, &sa), 16);
        if r == 0 {
            return @truncate(i32, fd);
        }
        result = AX_ERR;
        if r == -sys.ECONNREFUSED {
            result = AX_REFUSED;
        }
        _ = sys.close(@truncate(i32, fd));
    }
    return result;
}

export fn ax_tcp_listen(name: *u8, len: usize, port: u32) i32 {
    let mut addrs: [8]u32 = [0; 8];
    let mut n: usize = 1;  // (no name: every address)
    if len > 0 {
        n = resolve(@slice_from_ptr(name, len), addrs[..]);
        if n == 0 {
            return AX_BAD_ADDRESS;
        }
    }
    let mut result = AX_ERR;
    for i in 0..n {
        let fd = sys.socket(2, 1 | 0x80000, 0);
        if fd < 0 {
            continue;
        }
        let sock = @truncate(i32, fd);
        let one: i32 = 1;
        _ = sys.setsockopt(sock, 1, 2, @ptr_cast(*void, &one), 4);  // SOL_SOCKET, SO_REUSEADDR
        let sa = sockaddr(addrs[i], port);
        let r = sys.bind(sock, @ptr_cast(*void, &sa), 16);
        if (r == 0) and (sys.listen(sock, 128) == 0) {
            return sock;
        }
        result = AX_ERR;
        if r == -sys.EADDRINUSE {
            result = AX_ADDR_IN_USE;
        }
        _ = sys.close(sock);
    }
    return result;
}

export fn ax_tcp_accept(listener: i32) i32 {
    loop {
        let fd = sys.accept4(listener, 0x80000);
        if retry(fd) {
            continue;
        }
        if fd < 0 {
            return AX_ERR;
        }
        return @truncate(i32, fd);
    }
}

export fn ax_tcp_local_port(h: i32) i32 {
    let mut ss: [128]u8 = [0; 128];
    let mut sl: u32 = 128;
    if sys.getsockname(h, @ptr_cast(*mut void, &mut ss[0]), &mut sl) != 0 {
        return AX_ERR;
    }
    let family = @as(u32, ss[0]) | (@as(u32, ss[1]) << 8);
    if (family == 2) or (family == 10) {
        return (@as(i32, ss[2]) << 8) | @as(i32, ss[3]);  // network byte order
    }
    return AX_ERR;
}

export fn ax_sock_read(h: i32, p: *mut u8, n: usize) isize {
    loop {
        let r = sys.recvfrom(h, p, n, 0);
        if retry(r) {
            continue;
        }
        if r == -sys.EAGAIN {
            return @as(isize, AX_TIMED_OUT);
        }
        if r < 0 {
            return -1;
        }
        return r;
    }
}

export fn ax_sock_write(h: i32, p: *u8, n: usize) isize {
    loop {
        let r = sys.sendto(h, p, n, 0x4000, 0, 0);  // MSG_NOSIGNAL
        if retry(r) {
            continue;
        }
        if r == -sys.EAGAIN {
            return @as(isize, AX_TIMED_OUT);
        }
        if r < 0 {
            return -1;
        }
        return r;
    }
}

// Reads and writes on h fail with AX_TIMED_OUT after ms milliseconds (0:
// never).
export fn ax_sock_timeout(h: i32, ms: u32) i32 {
    let tv: [2]i64 = [@as(i64, ms / 1000), @as(i64, ms % 1000) * 1000];
    let a = sys.setsockopt(h, 1, 20, @ptr_cast(*void, &tv), 16);  // SOL_SOCKET, SO_RCVTIMEO
    let b = sys.setsockopt(h, 1, 21, @ptr_cast(*void, &tv), 16);  // SO_SNDTIMEO
    if (a != 0) or (b != 0) {
        return AX_ERR;
    }
    return 0;
}

// Shutting the socket down first wakes a thread blocked in accept on it.
export fn ax_sock_close(h: i32) void {
    _ = sys.shutdown(h, 2);  // SHUT_RDWR
    _ = sys.close(h);
}

// -----------------------------------------------------------------------------
// Threads (std/thread) and wait / notify
//
// Each thread gets one mapping: a guard page, its stack, its signal stack,
// its thread-local storage block and thread control block, and the
// ThreadStart record. The kernel clears `ctid` when the thread has exited;
// later spawns unmap such blocks.
// -----------------------------------------------------------------------------
const GUARD: usize = 65536;
const STACK: usize = 8 << 20;
const ALT: usize = 65536;

struct ThreadStart {
    entry: fn(*mut void) void,
    arg: *mut void,
    exited: *mut u32,
    base: usize,  // the mapping
    size: usize,
    alt: usize,   // the signal stack
    ctid: u32,    // cleared by the kernel when the thread is gone
    next: usize,  // earlier threads' records, until reclaimed
}

let mut next_thread_id: i32 = 1;
let mut threads: usize = 0;  // ThreadStart records of threads not yet reclaimed
let mut threads_lock: u32 = 0;

fn thread_run(p: *mut void) void {
    let mark: usize = 0;
    stack_hi = @int_from_ptr(&mark);
    let st = @ptr_cast(*mut ThreadStart, p);
    _ = sys.sigaltstack(st.alt, ALT);
    st.entry(st.arg);
    @atomic_store(st.exited, 1);
    _ = ax_notify32(st.exited, 1);
}

// (pthread_create's calling convention: returns a pointer.) The thread
// frees its own mapping (record and signal stack) when it is done: its
// stack is the C library's.
fn thread_main(p: *mut void) *mut void {
    let st = @ptr_cast(*mut ThreadStart, p);
    let base = st.base;
    let size = st.size;
    thread_run(p);
    _ = sys.sigaltstack_disable();
    _ = sys.munmap(base, size);
    return @ptr_from_int(*mut void, 0);
}

fn align_up(x: usize, a: usize) usize {
    return (x + (a - 1)) & ~(a - 1);
}

// Unmaps the blocks of threads that have exited.
fn reclaim() void {
    while @atomic_xchg(&mut threads_lock, 1) != 0 {
        _ = sys.sched_yield();
    }
    let mut prev: usize = 0;
    let mut t = threads;
    while t != 0 {
        let st = @ptr_from_int(*mut ThreadStart, t);
        let next = st.next;
        if @atomic_load(&st.ctid) == 0 {
            if prev == 0 {
                threads = next;
            } else {
                @ptr_from_int(*mut ThreadStart, prev).next = next;
            }
            _ = sys.munmap(st.base, st.size);
        } else {
            prev = t;
        }
        t = next;
    }
    @atomic_store(&mut threads_lock, 0);
}

// stack_top is ignored: native threads get their stack from the runtime.
export fn ax_thread_spawn(entry: fn(*mut void) void, arg: *mut void, stack_top: usize, exited: *mut u32) i32 {
    reclaim();
    if sys.ax_libc_linked() != 0 {
        return spawn_pthread(entry, arg, exited);
    }
    let ti = sys.ax_tls_info();
    let align = @max(ti.align, 1);
    let tls_align = @max(align, 16);
    let tls_size = align_up(ti.memsz, tls_align) + (2 * tls_align) + 16;
    let size = align_up(GUARD + STACK + ALT + tls_size + @size_of(ThreadStart) + 64, 65536);
    let base = sys.mmap_anon(size);
    if base == 0 {
        return AX_ERR;
    }
    _ = sys.protect_none(base, GUARD);
    let stack_top_addr = base + GUARD + STACK;  // 16-aligned
    let alt = stack_top_addr;
    let tls_area = alt + ALT;
    let mut tp: usize = 0;
    let mut block: usize = 0;
    if sys.axiom_target_arch() == 2 {
        // variant I: TCB (16 bytes) at tp, then the block
        tp = align_up(tls_area, tls_align);
        block = tp + align_up(16, align);
    } else {
        // variant II: the block ends at tp, which points at itself
        block = align_up(tls_area, tls_align);
        tp = block + align_up(ti.memsz, align);
        @ptr_from_int(*mut usize, tp).* = tp;
    }
    if ti.filesz > 0 {
        @mem_copy(@slice_from_ptr(@ptr_from_int(*mut u8, block), ti.filesz),
                  @slice_from_ptr(@ptr_from_int(*u8, ti.template), ti.filesz));
    }
    let st = @ptr_from_int(*mut ThreadStart, align_up(tls_area + tls_size, 16));
    st.* = ThreadStart.{ entry: entry, arg: arg, exited: exited, base: base, size: size, alt: alt, ctid: 1, next: 0 };
    let r = sys.ax_thread_create(thread_run, @ptr_cast(*mut void, st), stack_top_addr, tp, &mut st.ctid);
    if r < 0 {
        _ = sys.munmap(base, size);
        return AX_ERR;
    }
    while @atomic_xchg(&mut threads_lock, 1) != 0 {
        _ = sys.sched_yield();
    }
    st.next = threads;
    threads = @int_from_ptr(st);
    @atomic_store(&mut threads_lock, 0);
    return @atomic_add(&mut next_thread_id, 1);
}

// With the C library linked: its threads (and its own thread-local storage),
// so that C code runs on them too. The mapping holds the record and signal
// stack; the thread unmaps it as it ends.
fn spawn_pthread(entry: fn(*mut void) void, arg: *mut void, exited: *mut u32) i32 {
    let size = align_up(ALT + @size_of(ThreadStart) + 64, 65536);
    let base = sys.mmap_anon(size);
    if base == 0 {
        return AX_ERR;
    }
    let st = @ptr_from_int(*mut ThreadStart, base + ALT);
    st.* = ThreadStart.{ entry: entry, arg: arg, exited: exited, base: base, size: size, alt: base, ctid: 1, next: 0 };
    let mut t: u64 = 0;
    let mut attr: [64]u64 = [0; 64];
    _ = pthread_attr_init(@ptr_cast(*mut void, &mut attr[0]));
    _ = pthread_attr_setdetachstate(@ptr_cast(*mut void, &mut attr[0]), 1);  // PTHREAD_CREATE_DETACHED
    let rc = pthread_create(&mut t, @ptr_cast(*void, &attr[0]), thread_main, @ptr_cast(*mut void, st));
    _ = pthread_attr_destroy(@ptr_cast(*mut void, &mut attr[0]));
    if rc != 0 {
        _ = sys.munmap(base, size);
        return AX_ERR;
    }
    return @atomic_add(&mut next_thread_id, 1);
}

// Native threads need no stack from the program.
export fn ax_thread_stack_size() usize {
    return 0;
}

// The operating system (Linux).
export fn ax_os() i32 {
    return 1;
}

// The processor's extensions as std/os/cpu.ax's A_* bits, on AArch64, from
// the kernel's hardware capabilities (AT_HWCAP, AT_HWCAP2). x86-64
// programs ask the processor (cpuid) instead: 0.
export fn ax_cpu_features() u64 {
    if sys.axiom_target_arch() != 2 {
        return 0;
    }
    let h = sys.auxv(16);
    let h2 = sys.auxv(26);
    let mut f: u64 = 0;
    // [hwcap bit, A_* bit]
    // (ATOMICS, LRCPC, ASIMDDP, AES, SHA2, SHA3, SHA512, SM4, CRC32, ASIMDRDM, ASIMDHP, ASIMDFHM, SVE, DIT)
    let map: [14][2]u64 = [[8, 0x1], [15, 0x2], [20, 0x4], [3, 0x10], [6, 0x20], [17, 0x40], [21, 0x80], [19, 0x100],
                           [7, 0x200], [12, 0x400], [10, 0x800], [23, 0x1000], [22, 0x8000], [24, 0x20000]];
    for m in map {
        if ((h >> @truncate(u32, m[0])) & 1) != 0 {
            f = f | m[1];
        }
    }
    // AES needs PMULL as well (one extension in std/os/cpu.ax); SHA2 needs SHA1
    if (((h >> 3) & 1) != 0) and (((h >> 4) & 1) == 0) {
        f = f & ~@as(u64, 0x10);
    }
    if (((h >> 6) & 1) != 0) and (((h >> 5) & 1) == 0) {
        f = f & ~@as(u64, 0x20);
    }
    // hwcap2: SVE2 1, I8MM 13, BF16 14, SME 23, CSSC 34
    let map2: [5][2]u64 = [[1, 0x10000], [13, 0x4000], [14, 0x2000], [23, 0x40000], [34, 0x8]];
    for m in map2 {
        if ((h2 >> @truncate(u32, m[0])) & 1) != 0 {
            f = f | m[1];
        }
    }
    return f;
}

export fn ax_cpu_count() u32 {
    return sys.cpu_count();
}

export fn ax_sleep_ns(ns: u64) void {
    sys.nanosleep(ns);
}

// Fills p[0..n] with cryptographically secure random bytes; 0 on success.
export fn ax_random(p: *mut u8, n: usize) i32 {
    let mut done: usize = 0;
    while done < n {
        let r = sys.getrandom(@ptr_from_int(*mut u8, @int_from_ptr(p) + done), n - done);
        if retry(r) {
            continue;
        }
        if r <= 0 {
            return AX_ERR;
        }
        done += @int_cast(usize, r);
    }
    return 0;
}

// Nanoseconds on clock 0 (real time since 1970) or 1 (monotonic).
export fn ax_clock_ns(clock: u32) i64 {
    let mut ts = sys.Timespec.{ sec: 0, nsec: 0 };
    let mut id: i32 = 0;  // CLOCK_REALTIME
    if clock == 1 {
        id = 1;  // CLOCK_MONOTONIC
    }
    _ = sys.clock_gettime(id, &mut ts);
    return (ts.sec * 1000000000) + ts.nsec;
}

// Same results as WebAssembly memory.atomic.wait32: 0 woken, 1 not equal, 2 timed out.
export fn ax_wait32(p: *mut u32, expected: u32, timeout_ns: i64) i32 {
    let mut ts = sys.Timespec.{ sec: 0, nsec: 0 };
    let mut tsp: usize = 0;
    if timeout_ns >= 0 {
        ts.sec = timeout_ns / 1000000000;
        ts.nsec = timeout_ns % 1000000000;
        tsp = @int_from_ptr(&ts);
    }
    loop {
        let r = sys.futex(p, 128, expected, tsp);  // FUTEX_WAIT_PRIVATE
        if r == 0 {
            return 0;
        }
        if r == -sys.EAGAIN {
            return 1;
        }
        if r == -sys.ETIMEDOUT {
            return 2;
        }
        if r != -sys.EINTR {
            return 0;
        }
    }
}

export fn ax_notify32(p: *mut u32, count: i32) i32 {
    let mut n = count;
    if count < 0 {
        n = 0x7fff_ffff;
    }
    let r = sys.futex(p, 129, @bit_cast(u32, n), 0);  // FUTEX_WAKE_PRIVATE
    if r < 0 {
        return 0;
    }
    return @truncate(i32, r);
}

// -----------------------------------------------------------------------------
// Processes, the environment and signals
// -----------------------------------------------------------------------------

// The environment once the program has changed it: "K=V\0" entries in a
// mapping of env_cap bytes (0 until the first change: then the initial
// environment is read from the stack).
let mut env_blob: usize = 0;
let mut env_len: usize = 0;
let mut env_cap: usize = 0;
let mut env_lock: u32 = 0;

fn lock_env() void {
    while @atomic_cas(&mut env_lock, 0, 1) != 0 {
        _ = ax_wait32(&mut env_lock, 1, -1);
    }
}

fn unlock_env() void {
    @atomic_store(&mut env_lock, 0);
    _ = ax_notify32(&mut env_lock, 1);
}

fn env_bytes() []mut u8 {
    return @slice_from_ptr(@ptr_from_int(*mut u8, env_blob), env_cap);
}

// Makes room for `more` bytes, copying the initial environment first.
fn env_reserve(more: usize) bool {
    if env_blob == 0 {
        // the initial environment
        let mut total: usize = 0;
        let mut k: usize = 0;
        loop {
            let e = sys.env_entry(k);
            if @int_from_ptr(e.ptr) == 0 {
                break;
            }
            total += e.len + 1;
            k += 1;
        }
        let cap = align_up(total + more + 4096, 4096);
        let p = sys.mmap_anon(cap);
        if p == 0 {
            return false;
        }
        env_blob = p;
        env_cap = cap;
        env_len = 0;
        let b = env_bytes();
        k = 0;
        loop {
            let e = sys.env_entry(k);
            if @int_from_ptr(e.ptr) == 0 {
                break;
            }
            @mem_copy(b[env_len..env_len + e.len], e);
            b[env_len + e.len] = 0;
            env_len += e.len + 1;
            k += 1;
        }
    }
    if (env_len + more) <= env_cap {
        return true;
    }
    let cap = align_up((env_len + more) * 2, 4096);
    let p = sys.mmap_anon(cap);
    if p == 0 {
        return false;
    }
    @mem_copy(@slice_from_ptr(@ptr_from_int(*mut u8, p), env_len), env_bytes()[..env_len]);
    _ = sys.munmap(env_blob, env_cap);
    env_blob = p;
    env_cap = cap;
    return true;
}

// The entry for name in the changed environment: where it starts and ends
// (end == start: none).
fn env_find(name: []u8, start: *mut usize, end: *mut usize) void {
    let b = env_bytes();
    let mut i: usize = 0;
    while i < env_len {
        let mut j = i;
        while b[j] != 0 {
            j += 1;
        }
        let e = b[i..j];
        if (e.len > name.len) and (e[name.len] == '=') and @mem_eq(e[..name.len], name) {
            start.* = i;
            end.* = j + 1;
            return;
        }
        i = j + 1;
    }
    start.* = 0;
    end.* = 0;
}

// Removes every entry for name (the initial environment can hold several).
fn env_remove(name: []u8) void {
    let b = env_bytes();
    let mut i: usize = 0;
    let mut n: usize = 0;
    while i < env_len {
        let mut j = i;
        while b[j] != 0 {
            j += 1;
        }
        let e = b[i..j];
        if not ((e.len > name.len) and (e[name.len] == '=') and @mem_eq(e[..name.len], name)) {
            for k in i..j + 1 {
                b[n + (k - i)] = b[k];
            }
            n += (j + 1) - i;
        }
        i = j + 1;
    }
    env_len = n;
}

fn env_name_ok(name: []u8) bool {
    if name.len == 0 {
        return false;
    }
    for c in name {
        if (c == '=') or (c == 0) {
            return false;
        }
    }
    return true;
}

export fn ax_setenv(k: *u8, kn: usize, v: *u8, vn: usize) i32 {
    let name = @slice_from_ptr(k, kn);
    let value = @slice_from_ptr(v, vn);
    if not env_name_ok(name) {
        return AX_ERR;
    }
    for c in value {
        if c == 0 {
            return AX_ERR;
        }
    }
    lock_env();
    if not env_reserve(kn + vn + 2) {
        unlock_env();
        return AX_ERR;
    }
    env_remove(name);
    let b = env_bytes();
    @mem_copy(b[env_len..env_len + kn], name);
    b[env_len + kn] = '=';
    @mem_copy(b[env_len + kn + 1..env_len + kn + 1 + vn], value);
    b[env_len + kn + 1 + vn] = 0;
    env_len += kn + vn + 2;
    unlock_env();
    return 0;
}

export fn ax_unsetenv(k: *u8, kn: usize) i32 {
    let name = @slice_from_ptr(k, kn);
    if not env_name_ok(name) {
        return AX_ERR;
    }
    lock_env();
    if not env_reserve(0) {
        unlock_env();
        return AX_ERR;
    }
    env_remove(name);
    unlock_env();
    return 0;
}

// The whole environment, as "K=V\0" entries; returns its length.
export fn ax_environ(buf: *mut u8, cap: usize) isize {
    lock_env();
    if not env_reserve(0) {
        unlock_env();
        return @as(isize, AX_ERR);
    }
    let n = env_len;
    if n <= cap {
        @mem_copy(@slice_from_ptr(buf, n), env_bytes()[..n]);
    }
    unlock_env();
    return @bit_cast(isize, n);
}

// (getenv for the host ABI, after any changes)
fn env_get(name: []u8, buf: *mut u8, cap: usize) isize {
    lock_env();
    let mut a: usize = 0;
    let mut e: usize = 0;
    env_find(name, &mut a, &mut e);
    if e == a {
        unlock_env();
        return -2;
    }
    let v = env_bytes()[a + name.len + 1..e - 1];
    if v.len <= cap {
        @mem_copy(@slice_from_ptr(buf, v.len), v);
    }
    unlock_env();
    return @bit_cast(isize, v.len);
}

export fn ax_getpid() i32 {
    return sys.getpid();
}

// A copy of this process: 0 in the copy, its handle (for ax_proc_wait) in
// this one; negative if it cannot be made.
export fn ax_fork() i32 {
    let pid = sys.fork();
    if pid < 0 {
        return AX_ERR;
    }
    return @truncate(i32, pid);
}

export fn ax_chdir(path: *u8, len: usize) i32 {
    let mut buf: [4096]u8 = [0; 4096];
    if not copy_cstr(buf[..], path, len) {
        return AX_ERR;
    }
    let r = sys.chdir(&buf[0]);
    if r < 0 {
        return fs_err(r);
    }
    return 0;
}

// The spec: argv strings, each ending in 0, then a 0; the environment
// ("K=V" strings, each ending in 0), then a 0; then the directory to run in
// (empty: this one). stdio[i] is 0 to inherit stream i, 1 for a pipe, 2 for
// /dev/null; it is replaced by the pipe's handle, or -1.
export fn ax_proc_spawn(spec: *u8, len: usize, stdio: *mut i32) i32 {
    let s = @slice_from_ptr(spec, len);
    let modes = @slice_from_ptr(stdio, 3);
    // count the strings
    let mut i: usize = 0;
    let mut argc: usize = 0;
    while (i < s.len) and (s[i] != 0) {
        while (i < s.len) and (s[i] != 0) {
            i += 1;
        }
        i += 1;
        argc += 1;
    }
    i += 1;
    let env_at = i;
    let mut envc: usize = 0;
    while (i < s.len) and (s[i] != 0) {
        while (i < s.len) and (s[i] != 0) {
            i += 1;
        }
        i += 1;
        envc += 1;
    }
    i += 1;
    if (argc == 0) or (i > s.len) {
        return AX_ERR;
    }
    let cwd = s[i..];
    // the pointer arrays, and room for the directory and the program's
    // paths along $PATH, in one mapping
    let ptrs = (argc + envc + 2) * @size_of(usize);
    let room = align_up(ptrs + cwd.len + 1 + 65536, 4096);
    let m = sys.mmap_anon(room);
    if m == 0 {
        return AX_ERR;
    }
    let argv = m;
    let envp = m + ((argc + 1) * @size_of(usize));
    let mut j: usize = 0;
    for k in @as(usize, 0)..argc {
        @ptr_from_int(*mut usize, argv + (k * @size_of(usize))).* = @int_from_ptr(spec) + j;
        while s[j] != 0 {
            j += 1;
        }
        j += 1;
    }
    @ptr_from_int(*mut usize, argv + (argc * @size_of(usize))).* = 0;
    j = env_at;
    let mut path_var = s[0..0];
    for k in @as(usize, 0)..envc {
        @ptr_from_int(*mut usize, envp + (k * @size_of(usize))).* = @int_from_ptr(spec) + j;
        let st = j;
        while s[j] != 0 {
            j += 1;
        }
        if ((j - st) > 5) and @mem_eq(s[st..st + 5], "PATH=") {
            path_var = s[st + 5..j];
        }
        j += 1;
    }
    @ptr_from_int(*mut usize, envp + (envc * @size_of(usize))).* = 0;
    let extra = @slice_from_ptr(@ptr_from_int(*mut u8, m + ptrs), room - ptrs);
    @mem_copy(extra[..cwd.len], cwd);
    extra[cwd.len] = 0;
    // the program: as given if it has a "/", else each directory of PATH
    // in turn ("dir/prog\0" strings, then a 0)
    let mut plen: usize = 0;
    while s[plen] != 0 {
        plen += 1;
    }
    let pname = s[..plen];
    let cands = extra[cwd.len + 1..];
    let mut c: usize = 0;
    let mut has_slash = false;
    for ch in pname {
        if ch == '/' {
            has_slash = true;
        }
    }
    if has_slash {
        @mem_copy(cands[..plen], pname);
        cands[plen] = 0;
        c = plen + 1;
    } else {
        let mut pv = path_var;
        if pv.len == 0 {
            pv = "/usr/local/bin:/usr/bin:/bin";
        }
        let mut a: usize = 0;
        while a <= pv.len {
            let mut b = a;
            while (b < pv.len) and (pv[b] != ':') {
                b += 1;
            }
            let mut dir = pv[a..b];
            if dir.len == 0 {
                dir = ".";
            }
            if (c + dir.len + plen + 2) < cands.len {
                @mem_copy(cands[c..c + dir.len], dir);
                cands[c + dir.len] = '/';
                @mem_copy(cands[c + dir.len + 1..c + dir.len + 1 + plen], pname);
                cands[c + dir.len + 1 + plen] = 0;
                c += dir.len + plen + 2;
            }
            a = b + 1;
        }
    }
    cands[c] = 0;
    // the pipes: [ours, theirs] for each stream, and one for exec's error
    let mut fds: [6]i32 = [-1, -1, -1, -1, -1, -1];
    let mut err: [2]i32 = [-1, -1];
    let mut ok = sys.pipe2(&mut err[0], 0x80000) >= 0;  // O_CLOEXEC
    for k in @as(usize, 0)..3 {
        if not ok {
            break;
        }
        if modes[k] == 1 {
            let mut p: [2]i32 = [-1, -1];
            ok = sys.pipe2(&mut p[0], 0x80000) >= 0;
            // stdin: the child reads; stdout and stderr: we read
            if k == 0 {
                fds[0] = p[1];
                fds[1] = p[0];
            } else {
                fds[2 * k] = p[0];
                fds[(2 * k) + 1] = p[1];
            }
        } else if modes[k] == 2 {
            let mut dn: [10]u8 = [0; 10];
            @mem_copy(dn[..9], "/dev/null");
            let fd = sys.open(&dn[0], 2 | 0x80000, 0);  // O_RDWR | O_CLOEXEC
            ok = fd >= 0;
            fds[(2 * k) + 1] = @truncate(i32, fd);
        }
    }
    let mut pid: isize = -1;
    if ok {
        pid = sys.fork();
    }
    if pid == 0 {
        // the child: system calls only
        for k in @as(usize, 0)..3 {
            let fd = fds[(2 * k) + 1];
            if fd >= 0 {
                _ = sys.dup2(fd, @truncate(i32, @bit_cast(isize, k)));
            }
        }
        _ = sys.sigdefault(13);  // SIGPIPE, which the parent may ignore
        let mut e: isize = 0;
        if cwd.len > 0 {
            e = sys.chdir(&extra[0]);
        }
        if e >= 0 {
            e = -sys.ENOENT;
            let mut a: usize = 0;
            while cands[a] != 0 {
                let r = sys.execve(&cands[a], argv, envp);
                // keep the most telling error (EACCES over ENOENT)
                if (r != -sys.ENOENT) and (r != -sys.ENOTDIR) {
                    e = r;
                }
                while cands[a] != 0 {
                    a += 1;
                }
                a += 1;
            }
        }
        let mut code: i32 = @truncate(i32, -e);
        _ = sys.write(err[1], @ptr_cast(*u8, &code), 4);
        sys.exit(127);
    }
    // the parent: close the child's ends, and learn whether exec worked
    _ = sys.close(err[1]);
    for k in @as(usize, 0)..3 {
        if fds[(2 * k) + 1] >= 0 {
            _ = sys.close(fds[(2 * k) + 1]);
        }
    }
    let mut result: i32 = AX_ERR;
    if pid > 0 {
        let mut code: i32 = 0;
        let mut got: isize = 0;
        loop {
            got = sys.read(err[0], @ptr_cast(*mut u8, &mut code), 4);
            if not retry(got) {
                break;
            }
        }
        if got == 4 {
            let mut st: i32 = 0;
            _ = sys.wait4(@truncate(i32, pid), &mut st, 0);
            result = AX_ERR;
            if code == @truncate(i32, sys.ENOENT) {
                result = -2;
            } else if (code == @truncate(i32, sys.EACCES)) or (code == @truncate(i32, sys.EPERM)) {
                result = -13;
            }
        } else {
            result = @truncate(i32, pid);
        }
    }
    if err[0] >= 0 {
        _ = sys.close(err[0]);
    }
    for k in @as(usize, 0)..3 {
        if (result >= 0) and (modes[k] == 1) {
            modes[k] = fds[2 * k];
        } else {
            if fds[2 * k] >= 0 {
                _ = sys.close(fds[2 * k]);
            }
            modes[k] = -1;
        }
    }
    _ = sys.munmap(m, room);
    return result;
}

// 0: still running (block 0); 1: exited, with *status its code; 2: killed
// by signal *status.
export fn ax_proc_wait(h: i32, block: u32, status: *mut i32) i32 {
    let mut st: i32 = 0;
    let mut opts: i32 = 1;  // WNOHANG
    if block != 0 {
        opts = 0;
    }
    loop {
        let r = sys.wait4(h, &mut st, opts);
        if retry(r) {
            continue;
        }
        if r < 0 {
            return AX_ERR;
        }
        if r == 0 {
            return 0;
        }
        break;
    }
    if (st & 0x7f) == 0 {
        status.* = (st >> 8) & 0xff;
        return 1;
    }
    status.* = st & 0x7f;
    return 2;
}

export fn ax_proc_kill(h: i32, sig: i32) i32 {
    if sys.kill(h, sig) < 0 {
        return AX_ERR;
    }
    return 0;
}

export fn ax_pipe_read(h: i32, p: *mut u8, n: usize) isize {
    loop {
        let r = sys.read(h, p, n);
        if retry(r) {
            continue;
        }
        if r < 0 {
            return @as(isize, AX_ERR);
        }
        return r;
    }
}

export fn ax_pipe_write(h: i32, p: *u8, n: usize) isize {
    ignore_sigpipe();
    loop {
        let r = sys.write(h, p, n);
        if retry(r) {
            continue;
        }
        if r < 0 {
            return @as(isize, AX_ERR);
        }
        return r;
    }
}

export fn ax_pipe_close(h: i32) void {
    _ = sys.close(h);
}

// Writing to a pipe whose reader has gone should fail, not kill the program.
let mut sigpipe_ignored: u32 = 0;

fn ignore_sigpipe() void {
    if @atomic_xchg(&mut sigpipe_ignored, 1) == 0 {
        if sig_actions[13] != 2 {
            _ = sys.sigignore(13);
        }
    }
}

// Signals the program catches: their bits, set by the handler; sig_seq is
// bumped (and woken) on each.
let mut sig_pending: u64 = 0;
let mut sig_seq: u32 = 0;
let mut sig_actions: [65]u8 = [0; 65];

fn on_signal(sig: i32, si: *mut void, uc: *mut void) void {
    _ = si;
    _ = uc;
    _ = @atomic_or(&mut sig_pending, @as(u64, 1) << @truncate(u64, @bit_cast(u64, @as(i64, sig))));
    _ = @atomic_add(&mut sig_seq, 1);
    _ = ax_notify32(&mut sig_seq, -1);
}

// action: 0 the default, 1 ignore, 2 catch (for ax_signal_take).
export fn ax_signal(sig: i32, action: u32) i32 {
    // not the ones the runtime uses, nor SIGKILL and SIGSTOP
    if (((sig < 1) or (sig > 64)) or ((sig == 9) or (sig == 19))) or
       (((sig == SIGSEGV) or (sig == SIGBUS)) or (sig == SIGFPE)) {
        return AX_ERR;
    }
    let mut r: isize = 0;
    if action == 0 {
        r = sys.sigdefault(sig);
    } else if action == 1 {
        r = sys.sigignore(sig);
    } else if action == 2 {
        r = sys.sigaction(sig, on_signal, 4 | 0x1000_0000);  // SA_SIGINFO | SA_RESTART
    } else {
        return AX_ERR;
    }
    if r < 0 {
        return AX_ERR;
    }
    sig_actions[@as(usize, @bit_cast(u32, sig))] = @truncate(u8, action);
    return 0;
}

// The signals caught since the last call, as bits; waits up to timeout_ns
// (-1: for ever) for one if there are none.
export fn ax_signal_take(timeout_ns: i64) i64 {
    loop {
        let seq = @atomic_load(&sig_seq);
        let got = @atomic_xchg(&mut sig_pending, 0);
        if (got != 0) or (timeout_ns == 0) {
            return @bit_cast(i64, got);
        }
        if ax_wait32(&mut sig_seq, seq, timeout_ns) == 2 {
            return @bit_cast(i64, @atomic_xchg(&mut sig_pending, 0));
        }
    }
}

// -----------------------------------------------------------------------------
// Addresses, IPv6, UDP, Unix sockets and polling
//
// An address record is 24 bytes: [0] the family (4 or 6), [2..4] the port
// (big-endian), [4..20] the address (IPv4 in the first 4 bytes), [20..24]
// the IPv6 scope id (little-endian).
// -----------------------------------------------------------------------------

fn rec_port(r: []u8) u32 {
    return (@as(u32, r[2]) << 8) | @as(u32, r[3]);
}

// The record as a struct sockaddr; returns its length (0: bad family).
fn rec_sockaddr(r: []u8, sa: []mut u8) u32 {
    @mem_set(sa[..28], 0);
    if r[0] == 4 {
        sa[0] = 2;  // AF_INET
        sa[2] = r[2];
        sa[3] = r[3];
        @mem_copy(sa[4..8], r[4..8]);
        return 16;
    }
    if r[0] == 6 {
        sa[0] = 10;  // AF_INET6
        sa[2] = r[2];
        sa[3] = r[3];
        @mem_copy(sa[8..24], r[4..20]);
        @mem_copy(sa[24..28], r[20..24]);
        return 28;
    }
    return 0;
}

fn sockaddr_rec(sa: []u8, r: []mut u8) bool {
    @mem_set(r[..24], 0);
    let family = @as(u32, sa[0]) | (@as(u32, sa[1]) << 8);
    if family == 2 {
        r[0] = 4;
        r[2] = sa[2];
        r[3] = sa[3];
        @mem_copy(r[4..8], sa[4..8]);
        return true;
    }
    if family == 10 {
        r[0] = 6;
        r[2] = sa[2];
        r[3] = sa[3];
        @mem_copy(r[4..20], sa[8..24]);
        @mem_copy(r[20..24], sa[24..28]);
        return true;
    }
    return false;
}

fn hexval(c: u8) i32 {
    if (c >= '0') and (c <= '9') {
        return @as(i32, c - '0');
    }
    let l = lower(c);
    if (l >= 'a') and (l <= 'f') {
        return @as(i32, l - 'a') + 10;
    }
    return -1;
}

// An IPv6 literal (without brackets or a zone) into 16 bytes.
fn parse_ipv6(s: []u8, out: []mut u8) bool {
    let mut groups: [8]u32 = [0; 8];
    let mut n: usize = 0;
    let mut gap: usize = 9;  // where "::" is (9: none)
    let mut i: usize = 0;
    if (s.len >= 2) and (s[0] == ':') and (s[1] == ':') {
        gap = 0;
        i = 2;
    }
    while i < s.len {
        if n == 8 {
            return false;
        }
        let mut v: u32 = 0;
        let mut d: usize = 0;
        while (i < s.len) and (hexval(s[i]) >= 0) and (d < 4) {
            v = (v << 4) | @bit_cast(u32, hexval(s[i]));
            i += 1;
            d += 1;
        }
        if d == 0 {
            return false;
        }
        groups[n] = v;
        n += 1;
        if i == s.len {
            break;
        }
        if s[i] != ':' {
            return false;
        }
        i += 1;
        if (i < s.len) and (s[i] == ':') {
            if gap != 9 {
                return false;
            }
            gap = n;
            i += 1;
        } else if i == s.len {
            return false;
        }
    }
    if (gap == 9) and (n != 8) {
        return false;
    }
    if (gap != 9) and (n > 7) {
        return false;
    }
    @mem_set(out[..16], 0);
    let mut at: usize = 0;
    for k in @as(usize, 0)..n {
        if k == gap {
            at = 8 - (n - gap);
        }
        out[2 * at] = @truncate(u8, groups[k] >> 8);
        out[(2 * at) + 1] = @truncate(u8, groups[k]);
        at += 1;
    }
    return true;
}

// IPv6 addresses for name from /etc/hosts
fn hosts_v6(name: []u8, out: []mut u8, max: usize) usize {
    let mut buf: [16384]u8 = [0; 16384];
    let mut ls = lines(read_small("/etc/hosts", buf[..]));
    let mut n: usize = 0;
    while ls.next() and (n < max) {
        if ls.n < 2 {
            continue;
        }
        let mut a: [16]u8 = [0; 16];
        if not parse_ipv6(ls.words[0], a[..]) {
            continue;
        }
        for k in 1..ls.n {
            if same_name(ls.words[k], name) and (n < max) {
                let r = out[n * 24..(n + 1) * 24];
                @mem_set(r, 0);
                r[0] = 6;
                @mem_copy(r[4..20], a[..]);
                n += 1;
                break;
            }
        }
    }
    return n;
}

// The addresses of a name: IPv4 ones (as ax_tcp_connect finds them) and
// IPv6 literals and /etc/hosts entries. Returns how many.
export fn ax_resolve(name: *u8, len: usize, out: *mut u8, max: u32) i32 {
    let s = @slice_from_ptr(name, len);
    let o = @slice_from_ptr(out, @as(usize, max) * 24);
    let m = @as(usize, max);
    if m == 0 {
        return 0;
    }
    let mut a6: [16]u8 = [0; 16];
    if parse_ipv6(s, a6[..]) {
        @mem_set(o[..24], 0);
        o[0] = 6;
        @mem_copy(o[4..20], a6[..]);
        return 1;
    }
    let mut n: usize = 0;
    let mut v4: [8]u32 = [0; 8];
    let k = resolve(s, v4[..]);
    for i in @as(usize, 0)..k {
        if n == m {
            break;
        }
        let r = o[n * 24..(n + 1) * 24];
        @mem_set(r, 0);
        r[0] = 4;
        // (resolve gives them in network byte order, as sockaddr_in has them)
        r[4] = @truncate(u8, v4[i]);
        r[5] = @truncate(u8, v4[i] >> 8);
        r[6] = @truncate(u8, v4[i] >> 16);
        r[7] = @truncate(u8, v4[i] >> 24);
        n += 1;
    }
    if n < m {
        n += hosts_v6(s, o[n * 24..], m - n);
    }
    if n == 0 {
        return AX_BAD_ADDRESS;
    }
    return @truncate(i32, @bit_cast(isize, n));
}

fn socket_for(r: []u8, ty: i32) isize {
    let mut family: i32 = 2;
    if r[0] == 6 {
        family = 10;
    }
    return sys.socket(family, ty | 0x80000, 0);
}

export fn ax_tcp_connect_addr(a: *u8) i32 {
    let r = @slice_from_ptr(a, 24);
    let mut sa: [28]u8 = [0; 28];
    let sl = rec_sockaddr(r, sa[..]);
    if sl == 0 {
        return AX_BAD_ADDRESS;
    }
    let fd = socket_for(r, 1);
    if fd < 0 {
        return AX_ERR;
    }
    let sock = @truncate(i32, fd);
    loop {
        let c = sys.connect(sock, @ptr_cast(*void, &sa[0]), sl);
        if retry(c) {
            continue;
        }
        if c == 0 {
            return sock;
        }
        _ = sys.close(sock);
        if c == -sys.ECONNREFUSED {
            return AX_REFUSED;
        }
        return AX_ERR;
    }
}

export fn ax_tcp_listen_addr(a: *u8) i32 {
    let r = @slice_from_ptr(a, 24);
    let mut sa: [28]u8 = [0; 28];
    let sl = rec_sockaddr(r, sa[..]);
    if sl == 0 {
        return AX_BAD_ADDRESS;
    }
    let fd = socket_for(r, 1);
    if fd < 0 {
        return AX_ERR;
    }
    let sock = @truncate(i32, fd);
    let one: i32 = 1;
    _ = sys.setsockopt(sock, 1, 2, @ptr_cast(*void, &one), 4);  // SO_REUSEADDR
    let b = sys.bind(sock, @ptr_cast(*void, &sa[0]), sl);
    if (b == 0) and (sys.listen(sock, 128) == 0) {
        return sock;
    }
    _ = sys.close(sock);
    if b == -sys.EADDRINUSE {
        return AX_ADDR_IN_USE;
    }
    return AX_ERR;
}

// The socket's own address (peer 0) or its peer's.
export fn ax_sock_addr(h: i32, peer: u32, out: *mut u8) i32 {
    let mut ss: [128]u8 = [0; 128];
    let mut sl: u32 = 128;
    let mut r: isize = 0;
    if peer != 0 {
        r = sys.getpeername(h, @ptr_cast(*mut void, &mut ss[0]), &mut sl);
    } else {
        r = sys.getsockname(h, @ptr_cast(*mut void, &mut ss[0]), &mut sl);
    }
    if r != 0 {
        return AX_ERR;
    }
    if not sockaddr_rec(ss[..], @slice_from_ptr(out, 24)) {
        return AX_ERR;
    }
    return 0;
}

// A UDP socket bound to the address (port 0: any).
export fn ax_udp_open(a: *u8) i32 {
    let r = @slice_from_ptr(a, 24);
    let mut sa: [28]u8 = [0; 28];
    let sl = rec_sockaddr(r, sa[..]);
    if sl == 0 {
        return AX_BAD_ADDRESS;
    }
    let fd = socket_for(r, 2);  // SOCK_DGRAM
    if fd < 0 {
        return AX_ERR;
    }
    let sock = @truncate(i32, fd);
    let b = sys.bind(sock, @ptr_cast(*void, &sa[0]), sl);
    if b != 0 {
        _ = sys.close(sock);
        if b == -sys.EADDRINUSE {
            return AX_ADDR_IN_USE;
        }
        return AX_ERR;
    }
    return sock;
}

export fn ax_udp_send(h: i32, p: *u8, n: usize, a: *u8) isize {
    let mut sa: [28]u8 = [0; 28];
    let sl = rec_sockaddr(@slice_from_ptr(a, 24), sa[..]);
    if sl == 0 {
        return @as(isize, AX_BAD_ADDRESS);
    }
    loop {
        let r = sys.sendto(h, p, n, 0x4000, @int_from_ptr(&sa[0]), sl);
        if retry(r) {
            continue;
        }
        if r == -sys.EAGAIN {
            return @as(isize, AX_TIMED_OUT);
        }
        if r < 0 {
            return @as(isize, AX_ERR);
        }
        return r;
    }
}

// Receives a datagram (waiting at most the socket's timeout); its sender
// goes to from.
export fn ax_udp_recv(h: i32, p: *mut u8, n: usize, from: *mut u8) isize {
    let mut ss: [128]u8 = [0; 128];
    loop {
        let mut sl: u32 = 128;
        let r = sys.recvfrom_addr(h, p, n, @ptr_cast(*mut void, &mut ss[0]), &mut sl);
        if retry(r) {
            continue;
        }
        if r == -sys.EAGAIN {
            return @as(isize, AX_TIMED_OUT);
        }
        if r < 0 {
            return @as(isize, AX_ERR);
        }
        _ = sockaddr_rec(ss[..], @slice_from_ptr(from, 24));
        return r;
    }
}

fn unix_addr(path: *u8, len: usize, sa: []mut u8) bool {
    if (len == 0) or (len > 107) {
        return false;
    }
    @mem_set(sa[..110], 0);
    sa[0] = 1;  // AF_UNIX
    @mem_copy(sa[2..2 + len], @slice_from_ptr(path, len));
    for c in sa[2..2 + len] {
        if c == 0 {
            return false;
        }
    }
    return true;
}

export fn ax_unix_connect(path: *u8, len: usize) i32 {
    let mut sa: [110]u8 = [0; 110];
    if not unix_addr(path, len, sa[..]) {
        return AX_BAD_ADDRESS;
    }
    let fd = sys.socket(1, 1 | 0x80000, 0);
    if fd < 0 {
        return AX_ERR;
    }
    let sock = @truncate(i32, fd);
    let c = sys.connect(sock, @ptr_cast(*void, &sa[0]), @truncate(u32, len + 3));
    if c == 0 {
        return sock;
    }
    _ = sys.close(sock);
    if (c == -sys.ECONNREFUSED) or (c == -sys.ENOENT) {
        return AX_REFUSED;
    }
    return AX_ERR;
}

export fn ax_unix_listen(path: *u8, len: usize) i32 {
    let mut sa: [110]u8 = [0; 110];
    if not unix_addr(path, len, sa[..]) {
        return AX_BAD_ADDRESS;
    }
    let fd = sys.socket(1, 1 | 0x80000, 0);
    if fd < 0 {
        return AX_ERR;
    }
    let sock = @truncate(i32, fd);
    let b = sys.bind(sock, @ptr_cast(*void, &sa[0]), @truncate(u32, len + 3));
    if (b == 0) and (sys.listen(sock, 128) == 0) {
        return sock;
    }
    _ = sys.close(sock);
    if b == -sys.EADDRINUSE {
        return AX_ADDR_IN_USE;
    }
    return AX_ERR;
}

// entries: n of (handle i32, events u16, revents u16), events 1 readable
// (or a connection to accept), 4 writable; revents also 8 error, 16 hung
// up. Waits up to timeout_ms (-1: for ever); returns how many are ready.
export fn ax_poll(entries: *mut u8, n: u32, timeout_ms: i32) i32 {
    // struct pollfd has the same layout
    loop {
        let r = sys.ppoll(@ptr_cast(*mut void, entries), @as(u64, n), timeout_ms);
        if retry(r) {
            continue;
        }
        if r < 0 {
            return AX_ERR;
        }
        return @truncate(i32, r);
    }
}

// -----------------------------------------------------------------------------
// More of the file system: permissions, links, times, locks, mappings and
// watching
// -----------------------------------------------------------------------------

export fn ax_chmod(path: *u8, len: usize, mode: u32) i32 {
    let mut buf: [4096]u8 = [0; 4096];
    if not copy_cstr(buf[..], path, len) {
        return AX_ERR;
    }
    let r = sys.chmod(&buf[0], mode & 0o7777);
    if r < 0 {
        return fs_err(r);
    }
    return 0;
}

export fn ax_symlink(target: *u8, tlen: usize, link: *u8, llen: usize) i32 {
    let mut a: [4096]u8 = [0; 4096];
    let mut b: [4096]u8 = [0; 4096];
    if not copy_cstr(a[..], target, tlen) or not copy_cstr(b[..], link, llen) {
        return AX_ERR;
    }
    let r = sys.symlink(&a[0], &b[0]);
    if r < 0 {
        return fs_err(r);
    }
    return 0;
}

export fn ax_link(from: *u8, flen: usize, to: *u8, tlen: usize) i32 {
    let mut a: [4096]u8 = [0; 4096];
    let mut b: [4096]u8 = [0; 4096];
    if not copy_cstr(a[..], from, flen) or not copy_cstr(b[..], to, tlen) {
        return AX_ERR;
    }
    let r = sys.link(&a[0], &b[0]);
    if r < 0 {
        return fs_err(r);
    }
    return 0;
}

// The target of a symbolic link; returns its length.
// The running program's own file (for a program that finds what is installed
// beside it: the compiler's standard library). Its length.
export fn ax_self_path(buf: *mut u8, cap: usize) isize {
    let p = "/proc/self/exe";
    return ax_readlink(p.ptr, p.len, buf, cap);
}

export fn ax_readlink(path: *u8, len: usize, buf: *mut u8, cap: usize) isize {
    let mut p: [4096]u8 = [0; 4096];
    if not copy_cstr(p[..], path, len) {
        return @as(isize, AX_ERR);
    }
    let mut tmp: [4096]u8 = [0; 4096];
    let r = sys.readlink(&p[0], &mut tmp[0], tmp.len);
    if r < 0 {
        return @as(isize, fs_err(r));
    }
    let n = @bit_cast(usize, r);
    if n <= cap {
        @mem_copy(@slice_from_ptr(buf, n), tmp[..n]);
    }
    return r;
}

// Sets the access and modification times (nanoseconds since 1970).
export fn ax_utimes(path: *u8, len: usize, atime_ns: i64, mtime_ns: i64) i32 {
    let mut p: [4096]u8 = [0; 4096];
    if not copy_cstr(p[..], path, len) {
        return AX_ERR;
    }
    let ts: [2]sys.Timespec = [split_ns(atime_ns), split_ns(mtime_ns)];
    let r = sys.utimens(&p[0], &ts);
    if r < 0 {
        return fs_err(r);
    }
    return 0;
}

fn split_ns(ns: i64) sys.Timespec {
    let mut s = ns / 1000000000;
    let mut n = ns % 1000000000;
    if n < 0 {
        n += 1000000000;
        s -= 1;
    }
    return sys.Timespec.{ sec: s, nsec: n };
}

export fn ax_ftruncate(fd: i32, size: i64) i32 {
    let r = sys.ftruncate(fd, size);
    if r < 0 {
        return fs_err(r);
    }
    return 0;
}

export fn ax_fsync(fd: i32) i32 {
    if sys.fsync(fd) < 0 {
        return AX_ERR;
    }
    return 0;
}

// op: 1 shared, 2 exclusive, 8 unlock; | 4 not to wait (then -11 if it
// would have to).
export fn ax_flock(fd: i32, op: u32) i32 {
    loop {
        let r = sys.flock(fd, @bit_cast(i32, op));
        if retry(r) {
            continue;
        }
        if r == -sys.EAGAIN {
            return -11;
        }
        if r < 0 {
            return AX_ERR;
        }
        return 0;
    }
}

// A shared mapping of len bytes of the file at off; 0 if it cannot be made.
export fn ax_mmap(fd: i32, off: i64, len: usize, writable: u32) usize {
    let mut prot: i32 = 1;
    if writable != 0 {
        prot = 3;
    }
    let r = sys.mmap_file(len, prot, fd, off);
    if (r < 0) and (r > -4096) {
        return 0;
    }
    return @bit_cast(usize, r);
}

export fn ax_munmap(addr: usize, len: usize) i32 {
    if sys.munmap(addr, len) < 0 {
        return AX_ERR;
    }
    return 0;
}

export fn ax_msync(addr: usize, len: usize) i32 {
    if sys.msync(addr, len) < 0 {
        return AX_ERR;
    }
    return 0;
}

// Watching: an inotify instance. Events are read as the kernel's struct
// inotify_event records (wd, mask, cookie, len, name).
export fn ax_watch_open() i32 {
    let r = sys.inotify_init();
    if r < 0 {
        return AX_ERR;
    }
    return @truncate(i32, r);
}

export fn ax_watch_add(h: i32, path: *u8, len: usize) i32 {
    let mut p: [4096]u8 = [0; 4096];
    if not copy_cstr(p[..], path, len) {
        return AX_ERR;
    }
    // modify, attrib, moved from/to, create, delete, delete self, move self
    let r = sys.inotify_add_watch(h, &p[0], 0xfc6);
    if r < 0 {
        return fs_err(r);
    }
    return @truncate(i32, r);
}

export fn ax_watch_remove(h: i32, wd: i32) i32 {
    if sys.inotify_rm_watch(h, wd) < 0 {
        return AX_ERR;
    }
    return 0;
}

// Waits up to timeout_ms (-1: for ever) for events; returns the bytes read
// (0: none came).
export fn ax_watch_read(h: i32, buf: *mut u8, cap: usize, timeout_ms: i32) isize {
    let mut pfd: [2]i32 = [h, 1];  // struct pollfd: fd, events POLLIN (revents 0)
    loop {
        let r = sys.read(h, buf, cap);
        if r >= 0 {
            return r;
        }
        if retry(r) {
            continue;
        }
        if r != -sys.EAGAIN {
            return @as(isize, AX_ERR);
        }
        let p = sys.ppoll(@ptr_cast(*mut void, &mut pfd[0]), 1, timeout_ms);
        if p == 0 {
            return 0;
        }
        if (p < 0) and not retry(p) {
            return @as(isize, AX_ERR);
        }
        pfd[1] = 1;
    }
}

export fn ax_watch_close(h: i32) void {
    _ = sys.close(h);
}

// -----------------------------------------------------------------------------
// Terminals
// -----------------------------------------------------------------------------

const TCGETS: u64 = 0x5401;
const TCSETSW: u64 = 0x5403;
const TIOCGWINSZ: u64 = 0x5413;

export fn ax_isatty(fd: i32) i32 {
    let mut t: [64]u8 = [0; 64];
    if sys.ioctl(fd, TCGETS, @int_from_ptr(&t[0])) == 0 {
        return 1;
    }
    return 0;
}

// out: columns, rows
export fn ax_term_size(fd: i32, out: *mut u32) i32 {
    let mut ws: [4]u16 = [0; 4];
    if sys.ioctl(fd, TIOCGWINSZ, @int_from_ptr(&ws[0])) != 0 {
        return AX_ERR;
    }
    let o = @slice_from_ptr(out, 2);
    o[0] = @as(u32, ws[1]);
    o[1] = @as(u32, ws[0]);
    return 0;
}

// The terminal settings before raw mode (the kernel's struct termios: four
// u32 flag words, the line discipline and 19 control characters).
let mut saved_termios: [64]u8 = [0; 64];
let mut saved_fd: i32 = -1;

// enable 1: raw mode (no echo, no line editing, no signals from keys, no
// output processing), saving the settings; 0: back to them.
export fn ax_term_raw(fd: i32, enable: u32) i32 {
    if enable == 0 {
        if saved_fd != fd {
            return AX_ERR;
        }
        saved_fd = -1;
        if sys.ioctl(fd, TCSETSW, @int_from_ptr(&saved_termios[0])) != 0 {
            return AX_ERR;
        }
        return 0;
    }
    let mut t: [64]u8 = [0; 64];
    if sys.ioctl(fd, TCGETS, @int_from_ptr(&t[0])) != 0 {
        return AX_ERR;
    }
    if saved_fd < 0 {
        saved_termios = t;
        saved_fd = fd;
    }
    let mut w: [4]u32 = [0; 4];
    for k in @as(usize, 0)..4 {
        w[k] = @as(u32, t[4 * k]) | (@as(u32, t[(4 * k) + 1]) << 8) | (@as(u32, t[(4 * k) + 2]) << 16) | (
            @as(u32, t[(4 * k) + 3]) << 24);
    }
    // cfmakeraw
    w[0] &= ~@as(u32, 0x1 | 0x2 | 0x8 | 0x20 | 0x40 | 0x80 | 0x100 | 0x400);  // IGNBRK BRKINT PARMRK ISTRIP INLCR IGNCR ICRNL IXON
    w[1] &= ~@as(u32, 0x1);  // OPOST
    w[3] &= ~@as(u32, 0x8 | 0x40 | 0x2 | 0x1 | 0x8000);  // ECHO ECHONL ICANON ISIG IEXTEN
    w[2] &= ~@as(u32, 0x30 | 0x100);                     // CSIZE PARENB
    w[2] |= 0x30;                                        // CS8
    for k in @as(usize, 0)..4 {
        t[4 * k] = @truncate(u8, w[k]);
        t[(4 * k) + 1] = @truncate(u8, w[k] >> 8);
        t[(4 * k) + 2] = @truncate(u8, w[k] >> 16);
        t[(4 * k) + 3] = @truncate(u8, w[k] >> 24);
    }
    // c_cc starts after the flags and c_line: VTIME is 5, VMIN 6
    t[17 + 5] = 0;
    t[17 + 6] = 1;
    if sys.ioctl(fd, TCSETSW, @int_from_ptr(&t[0])) != 0 {
        return AX_ERR;
    }
    return 0;
}

// -----------------------------------------------------------------------------
// Linear memory (@memory_size, @memory_grow): 64 KiB pages committed from one
// region reserved at the first use. The region is as large as the system
// allows (up to 1 TiB of address space) and has no access: reserving it
// costs no memory, and counts against no limit on memory (overcommit, the
// data size). @memory_grow makes its next pages read-write, which is when
// the kernel commits them; it supplies physical pages only when they are
// touched.
// -----------------------------------------------------------------------------
let mut mem_base: usize = 0;   // 64 KiB-aligned start of the region
let mut mem_limit: usize = 0;  // its size in pages
let mut mem_pages: usize = 0;  // pages handed out
let mut mem_state: u32 = 0;    // 0: not reserved, 1: reserving, 2: ready, 3: failed
let mut mem_lock: u32 = 0;     // held while pages are committed

fn mem_reserve() void {
    if @atomic_cas(&mut mem_state, 0, 1) == 0 {
        let mut size: usize = 1 << 40;
        while size >= (1 << 28) {
            let p = sys.mmap_reserve(size + 65536);
            if p != 0 {
                mem_base = (p + 65535) & ~@as(usize, 65535);
                mem_limit = size / 65536;
                @atomic_store(&mut mem_state, 2);
                return;
            }
            size /= 2;
        }
        @atomic_store(&mut mem_state, 3);
        return;
    }
    while @atomic_load(&mem_state) == 1 {
        _ = sys.sched_yield();
    }
}

export fn ax_memory_size() isize {
    if @atomic_load(&mem_state) != 2 {
        mem_reserve();
    }
    return @bit_cast(isize, (mem_base / 65536) + @atomic_load(&mem_pages));
}

// The previous size in pages (as ax_memory_size counts them), or -1.
export fn ax_memory_grow(n: isize) isize {
    if @atomic_load(&mem_state) != 2 {
        mem_reserve();
    }
    if (@atomic_load(&mem_state) != 2) or (n < 0) {
        return -1;
    }
    let k = @bit_cast(usize, n);
    while @atomic_cas(&mut mem_lock, 0, 1) != 0 {
        _ = sys.sched_yield();
    }
    let old = mem_pages;
    if (k > (mem_limit - old)) or ((k > 0) and (sys.protect_rw(mem_base + (old * 65536), k * 65536) < 0)) {
        @atomic_store(&mut mem_lock, 0);
        return -1;
    }
    @atomic_store(&mut mem_pages, old + k);
    @atomic_store(&mut mem_lock, 0);
    return @bit_cast(isize, (mem_base / 65536) + old);
}

// @memory_discard: the whole 64 KiB pages in the range go back to the system
// (they stay read-write, and read as zero when next touched). Only pages of
// @memory_grow's region: anything else (the stack, globals, code, C's heap)
// is left alone.
export fn ax_memory_discard(addr: usize, len: usize) void {
    if @atomic_load(&mem_state) != 2 {
        return;
    }
    let lo = mem_base;
    let hi = mem_base + (@atomic_load(&mem_pages) * 65536);
    let mut end = addr +% len;
    if end < addr {
        end = ~@as(usize, 0);
    }
    if (addr >= hi) or (end <= lo) {
        return;
    }
    let a = (@max(addr, lo) + 65535) & ~@as(usize, 65535);
    let b = @min(end, hi) & ~@as(usize, 65535);
    if a < b {
        _ = sys.madvise(a, b - a, 4);  // MADV_DONTNEED
    }
}

// -----------------------------------------------------------------------------
// Traps and crashes
// -----------------------------------------------------------------------------
// Called by code for `axiom profile` builds to write the samples so far.
pub let mut profile_flush: fn() void = no_flush;
pub let mut has_profile: bool = false;
// Replaces the default trap report (std/internal/runtime/test_main.ax).
pub let mut trap_hook: fn(*tf.Site, *tf.TrapInfo, *tf.ShadowStack) void = no_hook;
pub let mut has_trap_hook: bool = false;

fn no_flush() void {}

fn no_hook(site: *tf.Site, info: *tf.TrapInfo, ss: *tf.ShadowStack) void {}

let mut report: [16384]u8 = [0; 16384];

fn flush_profile() void {
    if has_profile {
        profile_flush();
    }
}

// Every trap calls this (see codegen: axiom.trap).
export fn ax_on_trap(site: *tf.Site, info: *tf.TrapInfo, ss: *tf.ShadowStack) void {
    if has_trap_hook {
        trap_hook(site, info, ss);
        return;
    }
    let mut o = tf.fmt(report[..]);
    o.s("axiom: ");
    tf.format_trap(&mut o, site, info);
    o.s(" at ");
    o.s(tf.cstr(site.file()));
    o.c(':');
    o.u(@as(u64, site.line));
    o.c(':');
    o.u(@as(u64, site.col));
    o.c('\n');
    tf.format_stack(&mut o, site, ss);
    sys.write_all(2, o.text());
    flush_profile();
}

// Stack traces from frame pointers (trap_format.ax: walk_frames). The
// frame walk stops at the top of the thread's stack, as far as Axiom code
// goes: set as each thread starts (the main thread's arguments are above
// its frames).
threadlocal let mut stack_hi: usize = 0;

fn is_x64() bool {
    return sys.axiom_target_arch() != 2;
}

fn shadow_stack() *mut tf.ShadowStack {
    return @ptr_from_int(*mut tf.ShadowStack, @int_from_ptr(axiom_shadow_stack()));
}

// Functions of another system's libraries (an extern block naming a macOS
// framework or a Windows DLL) are linked to this, so that a program can
// support several systems and choose at run time; calling one is a crash
// with a stack trace.
export fn ax_unavailable() void {
    let mut o = tf.fmt(report[..]);
    o.s("axiom: crash: called a function from another system's library (not available on Linux)\n");
    let fp = axiom_frame_address().*;  // this function's frame
    tf.walk_frames(axiom_frame_table(), shadow_stack(), fp, fp, stack_hi, 0, is_x64());
    tf.format_stack(&mut o, @ptr_from_int(*tf.Site, 0), axiom_shadow_stack());
    sys.write_all(2, o.text());
    flush_profile();
    sys.exit(134);
}

// From axiom.trap (codegen), with its own frame.
export fn ax_stack_walk(fp: *void) void {
    let f = @int_from_ptr(fp);
    tf.walk_frames(axiom_frame_table(), shadow_stack(), f, f, stack_hi, 0, is_x64());
}

// From a signal handler: the frames of the code it interrupted.
pub fn stack_walk_signal(uc: *mut void) void {
    let tab = axiom_frame_table();
    if tf.is_null(@ptr_cast(*void, tab)) {
        return;
    }
    let b = @int_from_ptr(uc);
    // x86-64: uc_mcontext.gregs[REG_RBP, REG_RSP, REG_RIP]; AArch64:
    // uc_mcontext.regs[29, 30], sp, pc
    let mut fp = @ptr_from_int(*usize, b + 120).*;
    let sp = signal_sp(uc);
    let mut pc = @ptr_from_int(*usize, b + 168).*;
    if not is_x64() {
        fp = @ptr_from_int(*usize, b + 416).*;
        pc = @ptr_from_int(*usize, b + 440).*;
    }
    let mut leaf: usize = 0;
    if tf.frameless_at(tab, pc) {
        // its return address: at the stack pointer, or in the link register
        leaf = @ptr_from_int(*usize, sp).*;
        if not is_x64() {
            leaf = @ptr_from_int(*usize, b + 424).*;
        }
    }
    tf.walk_frames(tab, shadow_stack(), fp, sp, stack_hi, leaf, is_x64());
}

// The stack pointer when a signal arrived, from its ucontext.
pub fn signal_sp(uc: *mut void) usize {
    let mut off: usize = 160;  // x86-64: uc_mcontext.gregs[REG_RSP]
    if sys.axiom_target_arch() == 2 {
        off = 432;  // AArch64: uc_mcontext.sp
    }
    return @ptr_from_int(*usize, @int_from_ptr(uc) + off).*;
}

// Was a fault at addr (with the stack pointer at sp) a stack overflow: an
// access just beyond the stack pointer, into a guard page?
pub fn at_stack_limit(addr: usize, sp: usize) bool {
    return ((addr + 65536) >= sp) and (addr < (sp + 65536));
}

// Crashes that are not Axiom traps (a stack overflow, or a fault in C code
// called through the FFI) are reported with the shadow stack, then the
// signal is re-raised.
fn on_crash(sig: i32, si: *mut void, uc: *mut void) void {
    let addr = @ptr_cast(*usize, @ptr_from_int(*u8, @int_from_ptr(si) + 16)).*;
    stack_walk_signal(uc);
    let mut code: u32 = 5;
    if sig == SIGFPE {
        code = 3;
    } else if at_stack_limit(addr, signal_sp(uc)) {
        code = 8;
    }
    let mut o = tf.fmt(report[..]);
    if code == 8 {
        o.s("axiom: trap T0008 (stack exhausted)\n");
    } else {
        o.s("axiom: crash: ");
        if sig == SIGSEGV {
            o.s("segmentation fault");
        } else if sig == SIGBUS {
            o.s("bus error");
        } else {
            o.s("arithmetic fault");
        }
        o.s(" (address 0x");
        o.hex(@as(u64, addr));
        o.s(")\n");
    }
    tf.format_stack(&mut o, @ptr_from_int(*tf.Site, 0), axiom_shadow_stack());
    sys.write_all(2, o.text());
    flush_profile();
    _ = sys.sigdefault(sig);
    _ = sys.raise(sig);
}

// The main thread's signal stack (threads have theirs in their mapping).
pub fn install_crash_stack() void {
    let p = sys.mmap_anon(ALT);
    if p != 0 {
        _ = sys.sigaltstack(p, ALT);
    }
}

pub fn set_handler(sig: i32, f: fn(i32, *mut void, *mut void) void, flags: u64) void {
    _ = sys.sigaction(sig, f, flags);
}

// main's arguments (the environment follows argv).
export fn ax_rt_args(argc: i32, argv: *mut *mut u8) void {
    sys.main_argc = @as(usize, @bit_cast(u32, argc));
    sys.main_argv = @int_from_ptr(argv);
    stack_hi = @int_from_ptr(argv);
}

// Runs before main.
export fn ax_rt_init() void {
    install_crash_stack();
    let flags: u64 = 4 | 0x0800_0000;  // SA_SIGINFO | SA_ONSTACK
    set_handler(SIGSEGV, on_crash, flags);
    set_handler(SIGBUS, on_crash, flags);
    set_handler(SIGFPE, on_crash, flags);
}

// Runs after main returns.
export fn ax_rt_fini() void {
    flush_profile();
}
