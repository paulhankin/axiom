// =============================================================================
// std/internal/runtime/profile.ax - sampling profiler for native Axiom programs (spec
// §16.6). `axiom profile` builds it in and runs the program with
// AXIOM_PROFILE=<raw output file> and AXIOM_PROFILE_HZ=<rate>.
//
// A SIGPROF timer on the process CPU clock interrupts whichever thread is
// running; the handler copies that thread's shadow stack (§16.4) into a
// preallocated buffer. At exit the samples are aggregated and written in the
// raw format read by `axiom profile`:
//
//   # axiom-profile-raw 1
//   hz <rate>
//   clock cpu
//   S <count> <depth> <leaf> <site>...        (tab-separated, sites innermost first)
//
// where each <site> is <file id>\x1f<start>\x1f<end>\x1f<function>.
// =============================================================================
import "linux.ax" as sys;
import "native.ax" as rt;
import "profile_out.ax" as po;
import "trap_format.ax" as tf;

struct SigEvent {
    value: u64,
    signo: i32,
    notify: i32,
    pad: [12]u64,
}

struct ITimerSpec {
    interval_sec: i64,
    interval_nsec: i64,
    value_sec: i64,
    value_nsec: i64,
}

const SIGPROF: i32 = 27;

let mut buf: *mut u64 = @ptr_from_int(*mut u64, 0);
let mut buf_pos: usize = 0;
let mut dropped: u64 = 0;
let mut hz: i32 = 999;
let mut out_path: *u8 = @ptr_from_int(*u8, 0);
let mut timer: i32 = 0;
let mut timer_ok: bool = false;
let mut written: bool = false;

fn words() []mut u64 {
    return @slice_from_ptr(buf, po.BUF_WORDS);
}

// Each sample: [depth (top bit: not the main thread), weight, frames...].
// The kernel may check CPU timers only at scheduler ticks; expirations it
// merged are reported as the overrun, so a sample stands for 1 + overrun
// periods.
fn on_prof(sig: i32, si: *mut void, uc: *mut void) void {
    let ss = rt.axiom_shadow_stack();
    if tf.is_null(@ptr_cast(*void, ss)) {
        return;
    }
    let depth = @atomic_load(&ss.depth);
    let mut n = depth;
    if n > tf.SS_CAP {
        n = tf.SS_CAP;
    }
    let at = @atomic_add(&mut buf_pos, @as(usize, n) + 2);
    if (at + @as(usize, n) + 2) > po.BUF_WORDS {
        _ = @atomic_add(&mut dropped, 1);
        return;
    }
    let w = words();
    w[at] = @as(u64, depth);
    if sys.gettid() != sys.getpid() {
        w[at] = w[at] | po.THREAD_BIT;
    }
    // siginfo: si_code at 8; for timers si_overrun at 20
    let base = @int_from_ptr(si);
    let si_code = @ptr_from_int(*i32, base + 8).*;
    let overrun = @ptr_from_int(*i32, base + 20).*;
    w[at + 1] = 1;
    if (si_code == -2) and (overrun > 0) {  // SI_TIMER
        w[at + 1] = 1 + @as(u64, @bit_cast(u32, overrun));
    }
    for i in 0..n {
        w[at + 2 + @as(usize, i)] = @as(u64, @int_from_ptr(tf.call_at(ss, (depth - 1) - i)));
    }
}

fn write_fd(fd: usize, s: []u8) void {
    let mut off: usize = 0;
    while off < s.len {
        let w = sys.write(@truncate(i32, fd), &s[off], s.len - off);
        if w <= 0 {
            break;
        }
        off += @int_cast(usize, w);
    }
}

fn write_profile() void {
    if written or (@int_from_ptr(buf) == 0) {
        return;
    }
    written = true;
    if timer_ok {
        _ = sys.timer_delete(timer);
    }
    _ = sys.sigignore(SIGPROF);
    let mut end = @atomic_load(&buf_pos);
    if end > po.BUF_WORDS {
        end = po.BUF_WORDS;
    }
    let fd0 = sys.open(out_path, 0x80241, 0o644);  // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC
    if fd0 < 0 {
        return;
    }
    let fd = @truncate(i32, fd0);
    let o = @ptr_from_int(*mut po.Out, sys.mmap_anon(@size_of(po.Out)));
    po.init(o, @int_cast(usize, fd), write_fd);
    let cap = po.table_cap(end);
    let tp = sys.mmap_anon(cap * @size_of(po.Entry));  // (zeroed)
    let mut tab = @slice_from_ptr(@ptr_from_int(*mut po.Entry, 8), 0);
    if tp != 0 {
        tab = @slice_from_ptr(@ptr_from_int(*mut po.Entry, tp), cap);
    }
    po.write(o, words(), end, hz, dropped, tab);
    _ = sys.close(fd);
    if tp != 0 {
        _ = sys.munmap(tp, cap * @size_of(po.Entry));
    }
    _ = sys.munmap(@int_from_ptr(o), @size_of(po.Out));
}

export fn ax_profile_start() void {
    let path = sys.getenv("AXIOM_PROFILE");
    if path.len == 0 {
        return;
    }
    out_path = path.ptr;  // (NUL-terminated, in the environment)
    let r = sys.getenv("AXIOM_PROFILE_HZ");
    let mut v: i32 = 0;
    for c in r {
        if (c < '0') or (c > '9') or (v > 1_000_000) {
            break;
        }
        v = (v * 10) + @as(i32, c - '0');
    }
    if v > 0 {
        hz = v;
    }
    let p = sys.mmap_anon(po.BUF_WORDS * 8);
    if p == 0 {
        return;
    }
    buf = @ptr_from_int(*mut u64, p);
    // written when main returns (ax_rt_fini), or at a trap or crash
    rt.profile_flush = write_profile;
    rt.has_profile = true;
    rt.set_handler(SIGPROF, on_prof, 0x1000_0004);  // SA_RESTART | SA_SIGINFO
    // A timer on the process's CPU clock: unlike setitimer(ITIMER_PROF) it
    // is not limited to the scheduler tick.
    let sev = SigEvent.{ value: 0, signo: SIGPROF, notify: 0, pad: [0; 12] };  // SIGEV_SIGNAL
    if sys.timer_create(2, @ptr_cast(*void, &sev), &mut timer) != 0 {          // CLOCK_PROCESS_CPUTIME_ID
        return;
    }
    timer_ok = true;
    let ns = @as(i64, 1_000_000_000 / hz);
    let its = ITimerSpec.{ interval_sec: ns / 1_000_000_000, interval_nsec: ns % 1_000_000_000,
                           value_sec: ns / 1_000_000_000, value_nsec: ns % 1_000_000_000 };
    _ = sys.timer_settime(timer, @ptr_cast(*void, &its));
}
