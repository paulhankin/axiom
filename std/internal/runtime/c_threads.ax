// =============================================================================
// std/internal/runtime/c_threads.ax - the start-up of a C program that
// names the runtime's thread functions (cmd/axiom/src/c/cc.ax: uses_threads),
// instead of c_start.ax: main as c_start.ax's, and two functions C code
// declares and calls,
//
//     void *__axiom_c_thread_start(void (*f)(void *), void *arg);
//     void __axiom_c_thread_join(void *thread);
//
// which run f(arg) on a new thread of the runtime (std/thread.ax), with its
// own instances of the program's thread-locals, and wait for it to end. The
// test suite's threaded C tests use them; <threads.h> is not built on them
// yet. (A program that imports std/thread.ax creates threads: on
// WebAssembly its memory is shared, so the other start-up has none.)
// =============================================================================
import "../../mem.ax" as mem;
import "../../os.ax" as os;
import "../../thread.ax" as thread;

extern "C" {
    fn __axiom_c_main(argc: i32, argv: *mut *mut u8) i32;
}

// (as c_start.ax's main)
export fn main() i32 {
    let n = os.arg_count();
    let argv = mem.alloc.[*mut u8](n + 1) catch {
        return 1;
    };
    for i in 0..n {
        argv[i] = @ptr_from_int(*mut u8, 0);
        let a = os.arg(i) catch {
            continue;
        };
        let s = mem.alloc.[u8](a.len + 1) catch {
            continue;
        };
        @mem_copy(s[0..a.len], a);
        s[a.len] = 0;
        argv[i] = s.ptr;
        mem.free(a);
    }
    argv[n] = @ptr_from_int(*mut u8, 0);
    return __axiom_c_main(@truncate(i32, @bit_cast(isize, n)), argv.ptr);
}

/// Runs f(arg) on a new thread; the thread's handle for
/// __axiom_c_thread_join, or null if it could not be started.
export fn __axiom_c_thread_start(f: fn(*mut void) void, arg: *mut void) *mut void {
    let h = mem.new.[thread.Thread.[*mut void]]() catch {
        return @ptr_from_int(*mut void, 0);
    };
    let t = thread.spawn(f, arg) catch {
        mem.destroy(h);
        return @ptr_from_int(*mut void, 0);
    };
    h.* = t;
    return @ptr_cast(*mut void, h);
}

/// Waits for the thread `h` (from __axiom_c_thread_start) to end, and
/// releases it.
export fn __axiom_c_thread_join(h: *mut void) void {
    let t = @ptr_cast(*mut thread.Thread.[*mut void], h);
    t.join();
    mem.destroy(t);
}
