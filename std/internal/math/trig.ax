// =============================================================================
// std/internal/math/trig.ax - sin, cos and tan (std/math's and the C
// library's: 7.12.4.5-7, F.10.1.5-7), and the reduction by multiples of pi/2
// that they share.
//
// Reduction: x = n pi/2 + r, |r| <= pi/4, as a double-double r + rl. Below
// 2^20 pi/2, by Cody and Waite's method (W. J. Cody and W. Waite, "Software
// Manual for the Elementary Functions", 1980) with pi/2 in three parts, the
// first two short enough that n times them is exact; beyond, and when the
// result is too small for that to be accurate, by Payne and Hanek's method
// (M. Payne and R. Hanek, "Radian reduction for trigonometric functions",
// SIGNUM Newsletter 18, 1983): the 53-bit integer of x times the 192 bits of
// 2/pi that matter at x's exponent, in integer arithmetic, which leaves
// x 2/pi modulo 4 with 120 bits or more below its leading one, enough for
// the closest any double comes to a multiple of pi/2 (about 2^-61).
//
// Kernels on |r| <= pi/4: minimax polynomials (tables.ax); sin and cos
// in double (sin in double-double for |r| > 0.45, where r^3/6 is too large a
// part of it); tan by tan(c + u) = (tan c + tan u)/(1 - tan c tan u) for the
// c = j/256 nearest r (a table of tan c to 106 bits, and a short polynomial
// for tan u), to 2^-66 (see tan_dd).
// =============================================================================
import "core.ax" as m;
import "tables.ax" as t;

/// x = n pi/2 + (hi + lo).
pub struct Red {
    n: i32,
    hi: f64,
    lo: f64,
}

/// The high and low 64 bits of a b.
fn mul128(a: u64, b: u64) [2]u64 {
    let a0 = a & 0xffffffff;
    let a1 = a >> 32;
    let b0 = b & 0xffffffff;
    let b1 = b >> 32;
    let p00 = a0 * b0;
    let p01 = a0 * b1;
    let p10 = a1 * b0;
    let p11 = a1 * b1;
    let mid = ((p00 >> 32) + (p01 & 0xffffffff)) + (p10 & 0xffffffff);
    let hi = ((p11 + (p01 >> 32)) + (p10 >> 32)) + (mid >> 32);
    return [hi, (mid << 32) | (p00 & 0xffffffff)];
}

/// Payne and Hanek's reduction of a finite x (|x| >= pi/4).
fn reduce_big(x: f64) Red @multiversion("fma") {
    let ax = m.abits(x);
    let e = @as(i32, @truncate(u16, ax >> 52)) - 1075;  // x = M 2^e
    let mant = (ax & 0x000fffffffffffff) | 0x0010000000000000;
    // the bits of 2/pi from j = e - 1 on (those before give multiples of 4):
    // bit j is bit 63 + j of TWO_OVER_PI, so the window starts at bit e + 62
    let g = @as(u32, @bit_cast(u32, e + 62));
    let w = @as(usize, g / 64);
    let sh = g % 64;
    let tp = t.TWO_OVER_PI;
    let mut w2 = tp[w] << sh;
    let mut w1 = tp[w + 1] << sh;
    let mut w0 = tp[w + 2] << sh;
    if sh != 0 {
        w2 = w2 | (tp[w + 1] >> (64 - sh));
        w1 = w1 | (tp[w + 2] >> (64 - sh));
        w0 = w0 | (tp[w + 3] >> (64 - sh));
    }
    // M (w2 w1 w0) 2^-190: the integer part (mod 4) is bits 190 and 191
    let a = mul128(mant, w0);
    let b = mul128(mant, w1);
    let c = mul128(mant, w2);
    let p0 = a[1];
    let p1 = b[1] +% a[0];
    let mut carry: u64 = 0;
    if p1 < b[1] {
        carry = 1;
    }
    let p2 = (c[1] +% b[0]) +% carry;
    // the fraction, 190 bits, as a signed value in [-1/2, 1/2): its top 64
    // bits (f2) then 64 more (f1)
    let mut n = @bit_cast(i32, @truncate(u32, p2 >> 62));
    let mut f2 = (p2 << 2) | (p1 >> 62);
    let mut f1 = (p1 << 2) | (p0 >> 62);
    let mut f0 = p0 << 2;
    let mut neg = false;
    if (f2 >> 63) != 0 {
        // F >= 1/2: n + 1, and the fraction F - 1, whose magnitude is the
        // two's complement of the bits
        n += 1;
        neg = true;
        f0 = (~f0) +% 1;
        f1 = ~f1;
        f2 = ~f2;
        if f0 == 0 {
            f1 = f1 +% 1;
            if f1 == 0 {
                f2 = f2 +% 1;
            }
        }
    }
    // normalize the magnitude (at least 2^-62: the leading one is within the
    // first 64 + 62 bits) to 106 bits as two doubles
    let mut sc: i32 = -64;
    if f2 == 0 {
        f2 = f1;
        f1 = f0;
        f0 = 0;
        sc = -128;
    }
    let lz = @as(u64, @clz(f2));
    if lz != 0 {
        f2 = (f2 << lz) | (f1 >> (64 - lz));
        f1 = (f1 << lz) | (f0 >> (64 - lz));
    }
    let lzi = @as(i32, @truncate(u8, lz));
    let fh = @float_from_int(f64, f2 >> 11) * m.pow2(sc - lzi - 53 + 64);
    let fl = @float_from_int(f64, ((f2 & 0x7ff) << 42) | (f1 >> 22)) * m.pow2(sc - lzi - 106 + 64);
    // times pi/2
    let p = m.two_prod(fh, t.PIO2_HI);
    let r = m.fast_two_sum(p.hi, p.lo + ((fh * t.PIO2_LO) + (fl * t.PIO2_HI)));
    let mut hi = r.hi;
    let mut lo = r.lo;
    if neg {
        hi = -hi;
        lo = -lo;
    }
    if x < 0.0 {
        return Red.{ n: -n, hi: -hi, lo: -lo };
    }
    return Red.{ n: n, hi: hi, lo: lo };
}

/// x = n pi/2 + r for finite x with |x| > pi/4.
pub inline fn reduce(x: f64) Red {
    if m.abits(x) < 0x413921fb54442d18 {
        // |x| < 2^20 pi/2: n x PIO2_1 and n x PIO2_2 are exact (n the
        // integer nearest x 2/pi, by adding 1.5 2^52; in a directed rounding
        // mode, a neighbour, and |r| is then beyond pi/4: the exact
        // reduction does it)
        let kd = (x * t.INVPIO2) + 6755399441055744.0;
        let fnv = kd - 6755399441055744.0;
        let r0 = x - (fnv * t.PIO2_1);
        let a = m.two_sum(r0, -(fnv * t.PIO2_2));
        let ar = m.abits(a.hi);
        if (ar > 0x3e30000000000000) and (ar < 0x3fe9220000000000) {
            // 2^-28 < |r| < pi/4 + 2^-18: the third part's error (2^-100)
            // is small enough
            let b = m.fast_two_sum(a.hi, a.lo - (fnv * t.PIO2_3));
            return Red.{ n: @bit_cast(i32, @truncate(u32, m.bits(kd))), hi: b.hi, lo: b.lo };
        }
    }
    return reduce_big(x);
}

// The kernels, for |r| <= pi/4 (r + rl).

inline fn k_sin(r: f64, rl: f64) f64 {
    // r + q, q = r^3 (-1/6 + ...) within about 0.6 ulp(q), |q| <= 0.08 |r|:
    // within 0.55 ulp of sin r
    let z = r * r;
    let w = z * z;
    let p = ((t.SIN_P1 + (z * t.SIN_P2)) + (w * (t.SIN_P3 + (z * t.SIN_P4)))) + ((w * w) * (t.SIN_P5 + (z * t.SIN_P6)));
    let q = (r * z) * (t.SIN_P0 + (z * p));
    return r + (q + (rl - ((0.5 * z) * rl)));
}

inline fn k_cos(r: f64, rl: f64) f64 {
    let z = m.two_sqr(r);
    let zz = z.hi;
    let w = zz * zz;
    let c = w *
            (((t.COS_P0 + (zz * t.COS_P1)) + (w * (t.COS_P2 + (zz * t.COS_P3)))) +
             ((w * w) * (t.COS_P4 + (zz * t.COS_P5))));
    let hz = 0.5 * zz;
    let v = 1.0 - hz;
    return v + ((((1.0 - v) - hz) - (0.5 * z.lo)) + (c - ((r * rl) * (1.0 - (zz * 0.16666666666666666)))));
}

/// sin(r + rl) as a double-double (to about 2^-66).
pub fn sin_dd(r: f64, rl: f64) m.DD @multiversion("fma") {
    let z = m.two_sqr(r);
    let zz = z.hi;
    let w = zz * zz;
    let p = ((t.SIN_P1 + (zz * t.SIN_P2)) + (w * (t.SIN_P3 + (zz * t.SIN_P4)))) +
            ((w * w) * (t.SIN_P5 + (zz * t.SIN_P6)));
    // r^3 (-1/6) in double-double, the rest of the series in double
    let r3 = m.dd_mul_d(z, r);
    let a = m.dd_mul(r3, m.dd(t.SIN_P0, t.SIN_P0_LO));
    let tail = ((r3.hi * zz) * p) + (rl - ((0.5 * zz) * rl));
    let s = m.two_sum(r, a.hi);
    return m.fast_two_sum(s.hi, s.lo + (a.lo + tail));
}

/// cos(r + rl) as a double-double: 1 - z/2 and z^2 P0 (the next term, a
/// sixtieth of the result) in double-double, the rest of the series in
/// double.
pub fn cos_dd(r: f64, rl: f64) m.DD @multiversion("fma") {
    let z = m.two_sqr(r);
    let zz = z.hi;
    let w = m.dd_mul(z, z);
    let q = (t.COS_P1 + (zz * t.COS_P2)) + ((zz * zz) * (t.COS_P3 + (zz * (t.COS_P4 + (zz * t.COS_P5)))));
    let c = m.dd_mul_d(w, t.COS_P0);
    let v = m.two_sum(1.0, -0.5 * zz);
    let a = m.two_sum(v.hi, c.hi);
    return m.fast_two_sum(a.hi,
                          ((a.lo + v.lo) + c.lo) +
                          (((w.hi * zz) * q) - ((0.5 * z.lo) + ((r * rl) * (1.0 - (zz * 0.16666666666666666))))));
}

/// sin(x).
pub inline fn sin(x: f64, rep: m.Rep) f64 {
    let ax = m.abits(x);
    if ax <= 0x3fe921fb54442d18 {
        // |x| <= pi/4
        if ax < 0x3e40000000000000 {
            // |x| < 2^-27: sin x = x - x^3/6 rounds to x
            if (ax < 0x0010000000000000) and (ax != 0) {
                m.raise_underflow(rep);
            }
            return x;
        }
        return k_sin(x, 0.0);
    }
    if ax >= 0x7ff0000000000000 {
        if ax > 0x7ff0000000000000 {
            return x + x;
        }
        return m.domain(rep);  // sin(+-inf)
    }
    let r = reduce(x);
    let q = r.n & 3;
    if q == 0 {
        return k_sin(r.hi, r.lo);
    }
    if q == 1 {
        return k_cos(r.hi, r.lo);
    }
    if q == 2 {
        return -k_sin(r.hi, r.lo);
    }
    return -k_cos(r.hi, r.lo);
}

/// cos(x).
pub inline fn cos(x: f64, rep: m.Rep) f64 {
    let ax = m.abits(x);
    if ax <= 0x3fe921fb54442d18 {
        if ax < 0x3e40000000000000 {
            return 1.0;  // |x| < 2^-27 (cos x = 1 - x^2/2 rounds to 1)
        }
        return k_cos(x, 0.0);
    }
    if ax >= 0x7ff0000000000000 {
        if ax > 0x7ff0000000000000 {
            return x + x;
        }
        return m.domain(rep);
    }
    let r = reduce(x);
    let q = r.n & 3;
    if q == 0 {
        return k_cos(r.hi, r.lo);
    }
    if q == 1 {
        return -k_sin(r.hi, r.lo);
    }
    if q == 2 {
        return -k_cos(r.hi, r.lo);
    }
    return k_sin(r.hi, r.lo);
}

/// tan(r + rl) for |r| <= pi/4 (+ a little), or -1/tan(r + rl) if odd, as
/// a double-double. With c = j/256 nearest |r|, T = tan c (TAN_T, to 2^-106),
/// u = |r| - c (exact, |u| <= 1/512) and tan(u + rl) = u + w (w from TAN_Q,
/// within 2^-73 u), tan|r| = (T + u + w)/(1 - T u - T w): a quotient
/// (A + a_w)/(B + b_w) of double-doubles A, B that do not wait for the
/// polynomial, and small terms with |b_w/B| <= 2^-19.5. The division starts
/// on B alone; q0 + r1 = (A + a_w)/B.hi with the residual exact, and the
/// rest of the denominator, y = (B.lo + b_w)/B.hi, is divided out by its
/// series to y^3. The roundings are each within 2^-70 relative: the result
/// is within 2^-66 relative.
pub inline fn tan_dd(r: f64, rl: f64, odd: bool) m.DD {
    let a = @abs(r);
    let sg = @copysign(1.0, r);
    let al = rl * sg;
    // j: a 256 rounded by adding 1.5 2^52 (in a directed rounding mode, a
    // neighbour: u is then within 3/512, the estimate a little less accurate)
    let sh = (a * 256.0) + 6755399441055744.0;
    let j = @as(usize, @truncate(u32, m.bits(sh) & 255));
    let u = a - ((sh - 6755399441055744.0) * 0.00390625);
    let th = m.from_bits(t.TAN_T[2 * j]);
    let tl = m.from_bits(t.TAN_T[(2 * j) + 1]);
    let z = u * u;
    let w = al + ((u * z) * (t.TAN_Q0 + (z * (t.TAN_Q1 + (z * t.TAN_Q2)))));
    // T + u and 1 - T u
    let n1 = m.fast_two_sum(th, u);
    let p = m.two_prod(th, u);
    let d1 = m.fast_two_sum(1.0, -p.hi);
    let nl = n1.lo + tl;
    let dl = d1.lo - (p.lo + (tl * u));
    let tw = th * w;
    let mut ah = n1.hi;
    let mut alo = nl + w;
    let mut bh = d1.hi;
    let mut bl = dl - tw;
    if odd {
        ah = -d1.hi;
        alo = tw - dl;
        bh = n1.hi;
        bl = nl + w;
    }
    let inv = 1.0 / bh;
    let q0 = ah * inv;
    let pr = m.two_prod(q0, bh);
    let r1 = (((ah - pr.hi) - pr.lo) + alo) * inv;
    let y = bl * inv;
    let s = q0 + r1;
    let d = r1 - (s * (y * (1.0 - (y * (1.0 - y)))));
    let b = m.fast_two_sum(q0, d);
    return m.dd(b.hi * sg, b.lo * sg);
}

/// tan(x).
pub inline fn tan(x: f64, rep: m.Rep) f64 {
    let ax = m.abits(x);
    if ax < 0x3e30000000000000 {
        // |x| < 2^-28: tan x = x + x^3/3 rounds to x
        if (ax < 0x0010000000000000) and (ax != 0) {
            m.raise_underflow(rep);
        }
        return x;
    }
    if ax >= 0x7ff0000000000000 {
        if ax > 0x7ff0000000000000 {
            return x + x;
        }
        return m.domain(rep);
    }
    let mut r = Red.{ n: 0, hi: x, lo: 0.0 };
    if ax > 0x3fe921fb54442d18 {
        r = reduce(x);
    }
    // (within 2^-66 relative before the rounding: 0.5 + 2^-13 ulp)
    let f = tan_dd(r.hi, r.lo, (r.n & 1) != 0);
    return f.hi + f.lo;
}

/// sin(x) and cos(x).
pub struct SinCos {
    sin: f64,
    cos: f64,
}

/// Both sin(x) and cos(x), with one reduction.
pub inline fn sincos(x: f64, rep: m.Rep) SinCos {
    let ax = m.abits(x);
    if ax <= 0x3fe921fb54442d18 {
        return SinCos.{ sin: sin(x, rep), cos: cos(x, rep) };
    }
    if ax >= 0x7ff0000000000000 {
        let v = sin(x, rep);
        return SinCos.{ sin: v, cos: v };
    }
    let r = reduce(x);
    let s = k_sin(r.hi, r.lo);
    let c = k_cos(r.hi, r.lo);
    let q = r.n & 3;
    if q == 0 {
        return SinCos.{ sin: s, cos: c };
    }
    if q == 1 {
        return SinCos.{ sin: c, cos: -s };
    }
    if q == 2 {
        return SinCos.{ sin: -s, cos: -c };
    }
    return SinCos.{ sin: -c, cos: s };
}
