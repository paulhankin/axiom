// =============================================================================
// std/internal/math/special.ax - erf, erfc, lgamma and tgamma (std/math's and
// the C library's: 7.12.8, F.10.5), and C23's sinpi and cospi, which the
// reflection formula needs.
//
// erf x = x P(x^2) for |x| < 1; beyond, 1 - erfc|x|. erfc x = e^(-x^2) F(x)
// for x >= 1/2, F = erfc e^(x^2) smooth and fitted piecewise (beyond 4, F x
// in 1/x), e^(-x^2) to 2^-62 from exp.ax with x^2 exact; 2 - erfc|x| below
// -1/2. The polynomials are evaluated by compensated Horner (Graillat,
// Langlois and Louvet, "Compensated Horner scheme", 2005), which leaves only
// the fits' errors (2^-60) before the last rounding.
//
// tgamma: gamma(1 + t), 0 <= t <= 1, fitted piecewise; x = n + 1 + t is
// reduced to it by the recurrence gamma(x + 1) = x gamma(x) (the factors
// x - k exact, their product in double-double), Stirling's series (log
// gamma(x) = (x - 1/2) log x - x + log(2 pi)/2 + S(x), Abramowitz and Stegun
// 6.1.40, S fitted as a minimax polynomial) beyond 12, and below 0 the
// reflection formula gamma(x) gamma(-x) = -pi / (x sin(pi x)) (A&S 6.1.17).
// lgamma: the logarithm of those (double-double), and near its zeros at 1
// and 2, lgamma(1 + t)/t and lgamma(2 + t)/t fitted directly, and near its
// zeros below -2 (where the reflection formula's terms cancel) its Taylor
// series at each zero (the coefficients are the polygamma functions there).
// =============================================================================
import "core.ax" as m;
import "exp.ax" as ex;
import "log.ax" as lg;
import "tables.ax" as t;
import "trig.ax" as tr;

/// The polynomial whose coefficients (from t^0) are the n doubles at
/// tab[off..], at x, by compensated Horner: as a double-double.
fn horner(tab: []u64, off: usize, n: usize, x: f64) m.DD @multiversion("fma") {
    let mut s = m.from_bits(tab[(off + n) - 1]);
    let mut e: f64 = 0.0;
    let mut i = n - 1;
    while i > 0 {
        i -= 1;
        let p = m.two_prod(s, x);
        let q = m.two_sum(p.hi, m.from_bits(tab[off + i]));
        s = q.hi;
        e = (e * x) + (p.lo + q.lo);
    }
    return m.fast_two_sum(s, e);
}

/// The polynomial of horner, compensated for its first kc coefficients only
/// (the terms of the others are small enough that plain Horner's rounding
/// errors, a few 2^-53 of them, are far below an ulp of the value).
fn horner_k(tab: []u64, off: usize, n: usize, x: f64, kc: usize) m.DD @multiversion("fma") {
    let mut s = m.from_bits(tab[(off + n) - 1]);
    let mut i = n - 1;
    while i > kc {
        i -= 1;
        s = (s * x) + m.from_bits(tab[off + i]);
    }
    let mut e: f64 = 0.0;
    while i > 0 {
        i -= 1;
        let p = m.two_prod(s, x);
        let q = m.two_sum(p.hi, m.from_bits(tab[off + i]));
        s = q.hi;
        e = (e * x) + (p.lo + q.lo);
    }
    return m.fast_two_sum(s, e);
}

/// The coefficient k of the polynomial at p.
inline fn cf(p: *u64, k: usize) f64 {
    return m.from_bits(@ptr_add(p, k).*);
}

/// sum c_k x^(k-2) for k = 2 .. n - 1 (n = 10, 14 or 15: the pieces'
/// degrees 9, 13 and 14), the coefficients at p, by Estrin's scheme in plain
/// double.
inline fn tail_estrin(p: *u64, n: usize, x: f64) f64 {
    let x2 = x * x;
    let x4 = x2 * x2;
    let a = ((cf(p, 2) + (x * cf(p, 3))) + (x2 * (cf(p, 4) + (x * cf(p, 5))))) + (
        x4 * ((cf(p, 6) + (x * cf(p, 7))) + (x2 * (cf(p, 8) + (x * cf(p, 9))))));
    if n == 10 {
        return a;
    }
    let mut b = (cf(p, 10) + (x * cf(p, 11))) + (x2 * (cf(p, 12) + (x * cf(p, 13))));
    if n == 15 {
        b = b + (x4 * cf(p, 14));
    }
    return a + ((x4 * x4) * b);
}

/// The polynomial of tab[off..off + n) (n = 10, 14 or 15) at x as a
/// double-double: c0 + c1 x with the product's and the sum's errors kept,
/// the rest (x^2 times the polynomial of c2..) in plain double; for |c1 x|
/// and the rest small enough beside c0 that their roundings are far below an
/// ulp of the value (the pieces: |x| <= 1/8).
inline fn poly_dd(tab: []u64, off: usize, n: usize, x: f64) m.DD {
    let p = &tab[off + n - 1];  // (the bounds checked once)
    let q = tail_estrin(@ptr_sub(p, n - 1), n, x);
    let a = m.two_prod(m.from_bits(tab[off + 1]), x);
    let b = m.fast_two_sum(m.from_bits(tab[off]), a.hi);
    return m.fast_two_sum(b.hi, (b.lo + a.lo) + ((x * x) * q));
}

/// The piece of a table of pieces (tables.ax: rows of lo, hi, c, the
/// constant coefficient's low part, then the coefficients) that holds x,
/// as the offset of its row.
fn piece(tab: []u64, n: usize, w: usize, x: f64) usize {
    let mut i: usize = 0;
    while ((i + 1) < n) and (x > m.from_bits(tab[(i * w) + 1])) {
        i += 1;
    }
    return i * w;
}

/// The pieces' polynomial at x, as a double-double: t = x - c exactly
/// (two_sum), its low part through the derivative's first term, and the
/// constant coefficient's low part.
fn eval_pieces(tab: []u64, n: usize, w: usize, invw: f64, x: f64) m.DD @multiversion("fma") {
    // (equal pieces: the index from x, then a step for the rounding)
    let lo = m.from_bits(tab[0]);
    let mut i = @as(usize, @int_from_float(u32, @min(@max((x - lo) * invw, 0.0), @float_from_int(f64, n - 1))));
    if (i > 0) and (x < m.from_bits(tab[i * w])) {
        i -= 1;
    } else if ((i + 1) < n) and (x > m.from_bits(tab[(i * w) + 1])) {
        i += 1;
    }
    let r = i * w;
    let c = m.from_bits(tab[r + 2]);
    let d = m.two_sum(x, -c);
    let p = poly_dd(tab, r + 4, w - 4, d.hi);
    return m.dd_add_d(p, m.from_bits(tab[r + 3]) + (d.lo * m.from_bits(tab[r + 5])));
}

// -----------------------------------------------------------------------------
// erf and erfc
// -----------------------------------------------------------------------------

/// erf x / x for |x| < 1 (z = x^2 as a double-double).
fn erf_ratio(z: m.DD) m.DD @multiversion("fma") {
    // P0 + P1 z exactly but for 2^-106 (the product and the sum's errors
    // kept), the rest (z^2 P2 + ..., at most a ninth of the value) by Estrin's
    // scheme in plain double
    let zz = z.hi;
    let z2 = zz * zz;
    let z4 = z2 * z2;
    let z8 = z4 * z4;
    let q0 = ((t.ERF_P2 + (zz * t.ERF_P3)) + (z2 * (t.ERF_P4 + (zz * t.ERF_P5)))) +
             (z4 * ((t.ERF_P6 + (zz * t.ERF_P7)) + (z2 * (t.ERF_P8 + (zz * t.ERF_P9)))));
    let q1 = ((t.ERF_P10 + (zz * t.ERF_P11)) + (z2 * (t.ERF_P12 + (zz * t.ERF_P13)))) +
             (z4 * (t.ERF_P14 + (zz * t.ERF_P15)));
    let a = m.two_prod(t.ERF_P1, zz);
    let b = m.fast_two_sum(t.ERF_P0, a.hi);
    // P0's low part, and z's through P'(z) (to a few percent)
    let d = t.ERF_P1 + (zz * ((2.0 * t.ERF_P2) + (zz * (3.0 * t.ERF_P3))));
    return m.fast_two_sum(b.hi, ((b.lo + a.lo) + (z2 * (q0 + (z8 * q1)))) + (t.ERF_P0_LO + (z.lo * d)));
}

/// erf x for |x| < 1 as a double-double.
inline fn erf_small(x: f64) m.DD {
    let r = erf_ratio(m.two_sqr(x));
    return m.dd_mul_d(r, x);
}

/// erfc x = 2^k (hi + lo) for 1/2 <= x <= 27.3.
struct Scaled {
    k: i32,
    v: m.DD,
}

fn erfc_pos(x: f64) Scaled @multiversion("fma") {
    // e^(-x^2)
    let x2 = m.two_sqr(x);
    let e = ex.parts(-x2.hi, -x2.lo);
    let mut f = m.dd(0.0, 0.0);
    if x <= 4.0 {
        f = eval_pieces(t.ERFC_A[..], t.ERFC_A_N, t.ERFC_A_W, t.ERFC_A_INVW, x);
    } else {
        // F = G(v) v, v = 1/x as a double-double: G(v + vl) (v + vl) =
        // G(v) v + vl (G(v) + v G'(v)), the last about G(v) (1 - v^2)
        let v = m.dd_recip(m.dd(x, 0.0));
        let g = eval_pieces(t.ERFC_B[..], t.ERFC_B_N, t.ERFC_B_W, t.ERFC_B_INVW, v.hi);
        f = m.dd_add_d(m.dd_mul_d(g, v.hi), v.lo * (g.hi * (1.0 - (v.hi * v.hi))));
    }
    let p = m.dd_mul(m.dd(e.s, e.e), f);
    // normalized to [1, 2) for the scaling
    let ep = m.exponent(p.hi) - 1023;
    let sc = m.pow2(-ep);
    return Scaled.{ k: e.k + ep, v: m.dd(p.hi * sc, p.lo * sc) };
}

/// The error function.
pub fn erf(x: f64, rep: m.Rep) f64 @multiversion("fma") {
    let ax = m.abits(x);
    if ax >= 0x4018000000000000 {
        // |x| >= 6: +-1 (erfc 6 < 2^-54), and NaN
        if ax > 0x7ff0000000000000 {
            return x + x;
        }
        return @copysign(1.0, x);
    }
    if ax < 0x3e30000000000000 {
        // |x| < 2^-28: 2x/sqrt(pi)
        if ax < 0x0060000000000000 {
            return m.check_tiny(rep, x * t.ERF_P0);  // (subnormal results; x = +-0)
        }
        let p = m.two_prod(x, t.ERF_P0);
        return p.hi + (p.lo + (x * t.ERF_P0_LO));
    }
    if ax < 0x3ff0000000000000 {
        return m.dd_round(erf_small(x));
    }
    let c = erfc_pos(m.from_bits(ax));
    let sc = m.pow2(c.k);
    let r = m.dd_round(m.dd_add_d(m.dd(-c.v.hi * sc, -c.v.lo * sc), 1.0));
    return @copysign(r, x);
}

/// The complementary error function.
pub fn erfc(x: f64, rep: m.Rep) f64 @multiversion("fma") {
    let ax = m.abits(x);
    let neg = x < 0.0;
    if ax >= 0x7ff0000000000000 {
        if ax > 0x7ff0000000000000 {
            return x + x;
        }
        if neg {
            return 2.0;
        }
        return 0.0;
    }
    if ax < 0x3fe0000000000000 {
        // |x| < 1/2: 1 - erf x
        if ax < 0x3c70000000000000 {
            return 1.0 - x;  // |x| < 2^-56
        }
        return m.dd_round(m.dd_add_d(m.dd_neg(erf_small(x)), 1.0));
    }
    if neg {
        if ax >= 0x4018000000000000 {
            return 2.0;  // x <= -6: 2 - erfc|x| rounds to 2
        }
        let c = erfc_pos(m.from_bits(ax));
        let sc = m.pow2(c.k);
        return m.dd_round(m.dd_add_d(m.dd(-c.v.hi * sc, -c.v.lo * sc), 2.0));
    }
    if x >= 27.3 {
        return m.underflow(rep, false);
    }
    let c = erfc_pos(x);
    return ex.scale(c.v.hi, c.v.lo, c.k, rep);
}

// -----------------------------------------------------------------------------
// sin(pi x), cos(pi x)
// -----------------------------------------------------------------------------

/// sin(pi a) for 0 <= a <= 1/2, as a double-double.
pub inline fn sinpi_k(a: f64) m.DD {
    if a <= 0.25 {
        let p = m.two_prod(t.PI_HI, a);
        return tr.sin_dd(p.hi, p.lo + (t.PI_LO * a));
    }
    let b = 0.5 - a;  // exact
    let p = m.two_prod(t.PI_HI, b);
    return tr.cos_dd(p.hi, p.lo + (t.PI_LO * b));
}

/// sin(pi x) for finite x as a double-double: x reduced modulo 2 exactly.
pub inline fn sinpi_dd(x: f64) m.DD {
    if m.abits(x) >= 0x4330000000000000 {
        return m.dd(@copysign(0.0, x), 0.0);  // an even integer (|x| >= 2^52)
    }
    let r = x - (2.0 * @nearest(0.5 * x));  // in [-1, 1], exact
    let mut a = @abs(r);
    if a > 0.5 {
        a = 1.0 - a;
    }
    let s = sinpi_k(a);
    if r < 0.0 {
        return m.dd_neg(s);
    }
    return s;
}

/// sin(pi x) (C23).
pub fn sinpi(x: f64, rep: m.Rep) f64 @multiversion("fma") {
    let ax = m.abits(x);
    if ax >= 0x7ff0000000000000 {
        if ax > 0x7ff0000000000000 {
            return x + x;
        }
        return m.domain(rep);
    }
    if ax < 0x3c90000000000000 {
        // |x| < 2^-54: pi x
        if ax < 0x0060000000000000 {
            return m.check_tiny(rep, x * t.PI_HI);
        }
        let p = m.two_prod(x, t.PI_HI);
        return p.hi + (p.lo + (x * t.PI_LO));
    }
    let s = sinpi_dd(x);
    let r = m.dd_round(s);
    if r == 0.0 {
        return @copysign(0.0, x);  // sinpi(n) = +-0 with x's sign
    }
    return r;
}

/// cos(pi x) (C23).
pub fn cospi(x: f64, rep: m.Rep) f64 @multiversion("fma") {
    let ax = m.abits(x);
    if ax >= 0x7ff0000000000000 {
        if ax > 0x7ff0000000000000 {
            return x + x;
        }
        return m.domain(rep);
    }
    if ax >= 0x4340000000000000 {
        return 1.0;  // |x| >= 2^53: an even integer
    }
    // cos(pi x) = sin(pi (1/2 - |x|)), |x| reduced modulo 2 first
    let a = m.from_bits(ax);
    let r = a - (2.0 * @nearest(0.5 * a));  // in [-1, 1]
    let b = 0.5 - @abs(r);                  // exact: |r| <= 1
    let s = m.dd_round(sinpi_k(@abs(b)));
    if s == 0.0 {
        return 0.0;  // cospi(n + 1/2) = +0
    }
    if b < 0.0 {
        return -s;
    }
    return s;
}

// -----------------------------------------------------------------------------
// tgamma and lgamma
// -----------------------------------------------------------------------------

/// gamma(1 + u), 0 <= u <= 1, as a double-double.
fn g1(u: f64) m.DD @multiversion("fma") {
    return eval_pieces(t.GAM[..], t.GAM_N, t.GAM_W, t.GAM_INVW, u);
}

/// log gamma(x) for x >= 12 (and x <= 2^900) by Stirling's series, as a
/// double-double.
fn stirling(x: f64, fast: bool) m.DD @multiversion("fma") {
    // (lgamma: log x within 2^-60, which the result keeps; tgamma, whose
    // exponential turns the absolute error into the relative one: to 2^-75)
    let mut lx = m.dd(0.0, 0.0);
    if fast {
        lx = lg.log_fast(x);
    } else {
        lx = lg.log_dd(x);
    }
    let a = m.dd_mul(lx, m.dd(x - 0.5, 0.0));  // (x - 1/2 is exact)
    let b = m.dd_add(m.dd_add_d(a, -x), m.dd(t.HLN2PI_HI, t.HLN2PI_LO));
    let w = 1.0 / (x * x);
    let s =
        (((((t.STIRLING_P0 + (w * t.STIRLING_P1)) + ((w * w) * (t.STIRLING_P2 + (w * t.STIRLING_P3)))) +
           (((w * w) * (w * w)) *
            (((t.STIRLING_P4 + (w * t.STIRLING_P5)) + ((w * w) * (t.STIRLING_P6 + (w * t.STIRLING_P7)))) +
             (((w * w) * (w * w)) * t.STIRLING_P8))))) / x);
    return m.dd_add_d(b, s);
}

/// gamma(x) for 0 < x < 12 as a double-double (x >= 2^-990).
fn gamma_small(x: f64) m.DD @multiversion("fma") {
    if x < 1.0 {
        return m.dd_div(g1(x), m.dd(x, 0.0));
    }
    let fl = @floor(x);
    let u = x - fl;  // exact
    let mut acc = g1(u);
    // gamma(x) = (x - 1) (x - 2) ... (x - n) gamma(1 + u), n = floor(x) - 1
    let mut k: f64 = 1.0;
    while k < fl {
        acc = m.dd_mul_d(acc, x - k);  // (exact factors)
        k += 1.0;
    }
    return acc;
}

/// The gamma function.
pub fn tgamma(x: f64, rep: m.Rep) f64 @multiversion("fma") {
    let ax = m.abits(x);
    if ax >= 0x7ff0000000000000 {
        if (ax > 0x7ff0000000000000) or (x > 0.0) {
            return x + x;  // NaN, +inf
        }
        return m.domain(rep);  // -inf
    }
    if ax == 0 {
        return m.pole(rep, (m.bits(x) >> 63) != 0);  // tgamma(+-0) = +-inf
    }
    if ax < 0x3c70000000000000 {
        // |x| < 2^-56: gamma(x) = 1/x - 0.577..., the second below a
        // sixteenth of an ulp
        return m.check_huge(rep, 1.0 / x);
    }
    if x > 0.0 {
        if x > 171.62437695630272 {
            return m.overflow(rep, false);
        }
        if x < 12.0 {
            return m.dd_round(gamma_small(x));
        }
        let l = stirling(x, false);
        return ex.exp_dd(l.hi, l.lo, rep);
    }
    if @floor(x) == x {
        return m.domain(rep);  // a negative integer
    }
    // gamma(x) = -pi / (x sin(pi x) gamma(-x))
    let y = -x;
    let s = sinpi_dd(x);
    let xs = m.dd_mul_d(s, x);
    if y < 12.0 {
        let d = m.dd_mul(xs, gamma_small(y));
        return m.dd_round(m.dd_div(m.dd(-t.PI_HI, -t.PI_LO), d));
    }
    if y > 190.0 {
        return m.underflow(rep, s.hi < 0.0);
    }
    // |gamma(x)| = e^(log pi - log|x sin(pi x)| - log gamma(-x)); the sign
    // is sin(pi x)'s
    let l = m.dd_add(m.dd(t.LNPI_HI, t.LNPI_LO), m.dd_neg(m.dd_add(lg.log_dd2(dd_abs(xs)), stirling(y, false))));
    let r = ex.exp_dd(l.hi, l.lo, rep);
    if s.hi < 0.0 {
        return -r;
    }
    return r;
}

inline fn dd_abs(a: m.DD) m.DD {
    if a.hi < 0.0 {
        return m.dd_neg(a);
    }
    return a;
}

/// log(a) for a double-double a > 0, within 2^-60 relative (lgamma's).
inline fn log_fast2(a: m.DD) m.DD {
    let l = lg.log_fast(a.hi);
    return m.fast_two_sum(l.hi, l.lo + (a.lo / a.hi));
}

/// log|gamma(x)| for 0 < x <= 2^900, as a double-double.
fn lgamma_pos(x: f64) m.DD @multiversion("fma") {
    if x < 1.0e-21 {
        // -log x (the next term, -0.577 x, is far below an ulp)
        return m.dd_neg(lg.log_fast(x));
    }
    if x < 0.75 {
        return m.dd_add(log_fast2(g1(x)), m.dd_neg(lg.log_fast(x)));
    }
    if x <= 1.25 {
        let u = x - 1.0;  // exact
        let p = eval_pieces(t.LGAM1[..], t.LGAM1_N, t.LGAM1_W, t.LGAM1_INVW, u);
        return m.dd_mul_d(p, u);
    }
    if x < 1.5 {
        return log_fast2(g1(x - 1.0));
    }
    if x <= 2.5 {
        let u = x - 2.0;
        let p = eval_pieces(t.LGAM2[..], t.LGAM2_N, t.LGAM2_W, t.LGAM2_INVW, u);
        return m.dd_mul_d(p, u);
    }
    if x < 12.0 {
        return log_fast2(gamma_small(x));
    }
    return stirling(x, true);
}

/// The logarithm of the absolute value of the gamma function.
pub fn lgamma(x: f64, rep: m.Rep) f64 @multiversion("fma") {
    let ax = m.abits(x);
    if ax >= 0x7ff0000000000000 {
        return m.from_bits(ax) + m.from_bits(ax);  // +inf for +-inf, NaN
    }
    if (x <= 0.0) and (@floor(x) == x) {
        return m.pole(rep, false);  // 0 and the negative integers: +inf
    }
    if x > 0.0 {
        if x > 1.0e270 {
            // x (log x - 1), the rest far below an ulp (and overflow beyond
            // 2.55e305)
            let lx = lg.log_fast(x);
            return m.check_huge(rep, x * ((lx.hi - 1.0) + lx.lo));
        }
        return m.dd_round(lgamma_pos(x));
    }
    // log pi - log|x sin(pi x)| - lgamma(-x)
    let y = -x;
    if y < 1.0e-21 {
        return m.dd_round(m.dd_neg(lg.log_fast(y)));
    }
    if (y > 2.0) and (y < 18.0) {
        // near a zero: the Taylor series there (the reflection formula's
        // terms cancel to below their errors)
        let w = t.LGZ_W;
        for i in @as(usize, 0)..t.LGZ_N {
            let x0 = m.from_bits(t.LGZ[i * w]);
            let dh = x - x0;  // exact: x is near x0
            let dd = m.two_sum(dh, -m.from_bits(t.LGZ[(i * w) + 1]));
            if @abs(dd.hi) <= m.from_bits(t.LGZ[(i * w) + 2]) {
                let sc = m.from_bits(t.LGZ[(i * w) + 3]);
                let p0 = horner(t.LGZ[..], (i * w) + 5, w - 5, dd.hi / sc);  // (exact: sc is a power of two)
                let p = m.dd_add_d(p0, m.from_bits(t.LGZ[(i * w) + 4]));
                let r = m.dd_mul_d(p, dd.hi);
                return r.hi + (r.lo + (dd.lo * m.from_bits(t.LGZ[(i * w) + 5])));
            }
        }
    }
    let xs = dd_abs(m.dd_mul_d(sinpi_dd(x), x));
    let l = m.dd_add(m.dd(t.LNPI_HI, t.LNPI_LO), m.dd_neg(m.dd_add(log_fast2(xs), lgamma_pos(y))));
    return m.dd_round(l);
}
