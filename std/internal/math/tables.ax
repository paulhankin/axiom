// pi/2 = PIO2_1 + PIO2_2 + PIO2_3 (to 2^-120 or so), the first two of 32 bits (n times them is exact for |n| < 2^21)
pub const PIO2_1: f64 = 1.5707963267341256;
pub const PIO2_2: f64 = 6.077100506303966e-11;
pub const PIO2_3: f64 = 2.0222662487959506e-21;
// pi/2 = PIO2_HI + PIO2_LO
pub const PIO2_HI: f64 = 1.5707963267948966;
pub const PIO2_LO: f64 = 6.123233995736766e-17;
// 2/pi
pub const INVPIO2: f64 = 0.6366197723675814;
// pi = PI_HI + PI_LO
pub const PI_HI: f64 = 3.141592653589793;
pub const PI_LO: f64 = 1.2246467991473532e-16;
// pi/4 = PIO4_HI + PIO4_LO
pub const PIO4_HI: f64 = 0.7853981633974483;
pub const PIO4_LO: f64 = 3.061616997868383e-17;
// 1/pi = INVPI_HI + INVPI_LO
pub const INVPI_HI: f64 = 0.3183098861837907;
pub const INVPI_LO: f64 = -1.9678676675182486e-17;
// 3pi/4 = PI3O4_HI + PI3O4_LO
pub const PI3O4_HI: f64 = 2.356194490192345;
pub const PI3O4_LO: f64 = 9.184850993605148e-17;

// sin r = r + r z (P0 + P1 z + ... + P6 z^6), z = r^2, |r| <= pi/4 (relative error 2^-57.1)
pub const SIN_P0: f64 = -0.16666666666666666;
pub const SIN_P1: f64 = 0.008333333333333333;
