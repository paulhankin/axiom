// ln 2 = LN2_HI + LN2_LO + LN2_LO2 (LN2_HI with 42 bits: k LN2_HI is exact for |k| < 2^11)
pub const LN2_HI: f64 = 0.6931471805598903;
pub const LN2_LO: f64 = 5.497923018708371e-14;
pub const LN2_LO2: f64 = 1.94704509238075e-31;
// log1p(r) = r + r^2 (P0 + P1 r + ... + P6 r^6) for |r| <= the bound above (relative error 2^-70.5)
pub const LOG_P0: f64 = -0.5;
pub const LOG_P1: f64 = 0.3333333333333336;
pub const LOG_P2: f64 = -0.2500000000000002;
pub const LOG_P3: f64 = 0.19999999993219242;
pub const LOG_P4: f64 = -0.1666666666056398;
pub const LOG_P5: f64 = 0.1428621805883913;
pub const LOG_P6: f64 = -0.12500453396031358;

// log1p(r) = r - r^2/2 + r^3 (P0 + ... + P9 r^9), for the double-double logarithm (relative error 2^-66.7)
pub const LOGD_P0: f64 = 0.3333333333333333;
pub const LOGD_P1: f64 = -0.2499999999940142;
pub const LOGD_P2: f64 = 0.20000000000887036;
pub const LOGD_P3: f64 = -0.16666881084250698;
pub const LOGD_P4: f64 = 0.14285589109980387;
pub const LOGD_P5: f64 = 0.12961619382500375;
pub const LOGD_P6: f64 = 0.17918802363518835;
pub const LOGD_P7: f64 = -12332.797434215485;
pub const LOGD_P8: f64 = -1261.7131785925726;
pub const LOGD_P9: f64 = 210237136.37706155;

// 1/3 - LOGD_P0 (the logarithm adds r^3 THIRD_LO)
pub const THIRD_LO: f64 = 1.850371707708594e-17;
// ln 2 = LN2D_HI + LN2D_LO (the double nearest, and the rest)
pub const LN2D_HI: f64 = 0.6931471805599453;
pub const LN2D_LO: f64 = 2.3190468138462996e-17;
// 1 / ln 2 = INVLN2_HI + INVLN2_LO
pub const INVLN2_HI: f64 = 1.4426950408889634;
pub const INVLN2_LO: f64 = 2.0355273740931033e-17;
// 1 / ln 10 = INVLN10_HI + INVLN10_LO
pub const INVLN10_HI: f64 = 0.4342944819032518;
pub const INVLN10_LO: f64 = 1.098319650216765e-17;
// ln 10 = LN10_HI + LN10_LO
pub const LN10_HI: f64 = 2.302585092994046;
pub const LN10_LO: f64 = -2.1707562233822494e-16;

// the bits of 2/pi after the binary point, 64 to a word, after a zero word
