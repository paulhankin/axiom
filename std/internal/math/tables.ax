// -1/6 - SIN_P0
pub const SIN_P0_LO: f64 = -9.25185853854297e-18;
// cos r = 1 - z/2 + z^2 (P0 + P1 z + ... + P5 z^5) (relative error 2^-60.7)
pub const COS_P0: f64 = 0.04166666666666665;
pub const COS_P1: f64 = -0.001388888888888284;
pub const COS_P2: f64 = 2.4801587294628004e-05;
