pub const ATAN_P6: f64 = -0.06643732067367922;

// atan u = u + u z (Q0 + Q1 z + ... + Q4 z^4), z = u^2, |u| <= 1/32 (the fast path) (relative error 2^-65.7)
pub const ATAN_Q0: f64 = -0.3333333333333333;
pub const ATAN_Q1: f64 = 0.1999999999999768;
pub const ATAN_Q2: f64 = -0.14285714274093292;
pub const ATAN_Q3: f64 = 0.11111086852599648;
pub const ATAN_Q4: f64 = -0.09068404652489988;

// atan u = u + u z (R0 + R1 z + R2 z^2 + R3 z^3), z = u^2, |u| <= 1/64 (the fast path) (relative error 2^-70.7)
pub const ATAN_R0: f64 = -0.3333333333333333;
pub const ATAN_R1: f64 = 0.19999999999909096;
pub const ATAN_R2: f64 = -0.14285713134778466;
pub const ATAN_R3: f64 = 0.11105564351292546;

