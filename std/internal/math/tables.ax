// atan u = u + u z (P0 + P1 z + ... + P6 z^6), z = u^2, |u| <= 1/32 (relative error 2^-65.6)
pub const ATAN_P0: f64 = -0.3333333333333333;
pub const ATAN_P1: f64 = 0.2;
pub const ATAN_P2: f64 = -0.14285714285714282;
pub const ATAN_P3: f64 = 0.11111111111098479;
