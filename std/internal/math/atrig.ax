// =============================================================================
// std/internal/math/atrig.ax - asin, acos, atan and atan2 (std/math's and the
// C library's: 7.12.4.1-4, F.10.1.1-4).
//
// asin and acos: a minimax polynomial for |x| <= 1/2, and beyond, the
// identities asin x = pi/2 - 2 asin(sqrt((1 - x)/2)) and acos x =
// 2 asin(sqrt((1 - x)/2)) (and pi - ... for x < 0; see Abramowitz and
// Stegun 4.4), with the square root as a double-double and (1 - x)/2 exact.
// atan: atan x = atan c + atan((x - c)/(1 + x c)) for c the middle of x's
// sixteenth of its binade, in [2^-6, 2^6) (a table of atan c to 106 bits,
// indexed by x's top bits), first in plain double with a bound on its error,
// and in double-double when that does not decide the rounding (Ziv's
// strategy); the series below, and pi/2 - atan(1/x) above. atan2 reduces to
// atan of the smaller over the larger magnitude (as a double-double), and
// puts the quadrant back in double-double. Each is rounded once at the end:
// within about 0.52 ulp.
// =============================================================================
import "core.ax" as m;
import "tables.ax" as t;

/// asin(s) - s for 0 <= s <= 1/2 and z = s^2: s z P(z), within 2^-52 of
/// itself (at most a 24th of asin s).
pub inline fn asin_tail(s: f64, z: f64) f64 {
    let z2 = z * z;
    let z4 = z2 * z2;
    let z8 = z4 * z4;
    let q0 = ((t.ASIN_P0 + (z * t.ASIN_P1)) + (z2 * (t.ASIN_P2 + (z * t.ASIN_P3)))) +
             (z4 * ((t.ASIN_P4 + (z * t.ASIN_P5)) + (z2 * (t.ASIN_P6 + (z * t.ASIN_P7)))));
    let q1 = ((t.ASIN_P8 + (z * t.ASIN_P9)) + (z2 * (t.ASIN_P10 + (z * t.ASIN_P11)))) + (z4 * t.ASIN_P12);
    return (s * z) * (q0 + (z8 * q1));
}

/// sqrt(z) as a double-double, z = (1 - a)/2 exactly (1/2 <= a < 1): the
/// residual's correction divided by 2 sqrt z = 2 z / sqrt z, through 1/(1 - a)
/// (which the division computes beside the square root).
pub inline fn sqrt_dd(z: f64, a: f64) m.DD {
    let inv = 1.0 / (1.0 - a);
    let s = @sqrt(z);
    let p = m.two_sqr(s);
    return m.dd(s, ((z - p.hi) - p.lo) * (s * inv));
}

/// The arcsine.
pub inline fn asin(x: f64, rep: m.Rep) f64 {
    let ax = m.abits(x);
    if ax < 0x3fe0000000000000 {
        // |x| < 1/2
        if ax < 0x3e40000000000000 {
            // |x| < 2^-27: asin x = x + x^3/6 rounds to x
            if (ax < 0x0010000000000000) and (ax != 0) {
                m.raise_underflow(rep);
            }
            return x;
        }
        return x + asin_tail(x, x * x);
    }
    if ax >= 0x3ff0000000000000 {
        if ax == 0x3ff0000000000000 {
            return x * t.PIO2_HI;  // asin(+-1) = +-pi/2
        }
        if ax > 0x7ff0000000000000 {
            return x + x;
        }
        return m.domain(rep);
    }
    // asin|x| = pi/2 - 2 asin s, s = sqrt(z), z = (1 - |x|)/2
    let z = (1.0 - m.from_bits(ax)) * 0.5;
    // (2 s <= 1: pi/2 - 2 s.hi is exact as a + a.lo; the tail is at most a
    // 24th of 2 asin s, which is at most two thirds of the result)
    let s = sqrt_dd(z, m.from_bits(ax));
    let q = asin_tail(s.hi, z);
    let a = m.fast_two_sum(t.PIO2_HI, -2.0 * s.hi);
    return @copysign(a.hi + ((a.lo + t.PIO2_LO) - (2.0 * (s.lo + q))), x);
}

/// The arccosine.
pub inline fn acos(x: f64, rep: m.Rep) f64 {
    let ax = m.abits(x);
    if ax < 0x3fe0000000000000 {
        // acos x = pi/2 - asin x
        if ax < 0x3c80000000000000 {
            return t.PIO2_HI;  // |x| < 2^-55
        }
        let q = asin_tail(x, x * x);
        let a = m.fast_two_sum(t.PIO2_HI, -x);
        return a.hi + ((a.lo + t.PIO2_LO) - q);
    }
    if ax >= 0x3ff0000000000000 {
        if x == 1.0 {
            return 0.0;
        }
        if x == -1.0 {
            return t.PI_HI;
        }
        if ax > 0x7ff0000000000000 {
            return x + x;
        }
        return m.domain(rep);
    }
    let z = (1.0 - m.from_bits(ax)) * 0.5;
    let s = sqrt_dd(z, m.from_bits(ax));
    let q = asin_tail(s.hi, z);
    if x > 0.0 {
        return 2.0 * (s.hi + (s.lo + q));  // 2 asin s
    }
    // pi - 2 asin s
    let a = m.fast_two_sum(t.PI_HI, -2.0 * s.hi);
    return a.hi + ((a.lo + t.PI_LO) - (2.0 * (s.lo + q)));
}

/// atan(u) - u for |u| <= 1/32 (z = u^2).
inline fn atan_tail(u: f64, z: f64) f64 {
    let z2 = z * z;
    let p = ((t.ATAN_P0 + (z * t.ATAN_P1)) + (z2 * (t.ATAN_P2 + (z * t.ATAN_P3)))) +
            ((z2 * z2) * ((t.ATAN_P4 + (z * t.ATAN_P5)) + (z2 * t.ATAN_P6)));
    return (u * z) * p;
}

/// atan(a + al) for 2^-6 <= a < 2^6 (|al| <= 2 ulp(a)), as a double-double:
/// atan c + atan(u), u = (a - c)/(1 + a c), c the middle of a's sixteenth
/// of its binade (tables.ax: ATAN_B, so |u| <= 1/32); a - c is exact,
/// u is a double-double from one division and the exact residual.
inline fn atan_k(a: f64, al: f64) m.DD {
    let row = @as(usize, @truncate(u32, (m.bits(a) >> 48) & 255)) * 3;
    let c = m.from_bits(t.ATAN_B[row]);
    let n = m.two_sum(a - c, al);
    let p = m.two_prod(a, c);
    let s = m.two_sum(1.0, p.hi);
    let dl = (s.lo + p.lo) + (al * c);
    let inv = 1.0 / s.hi;
    let q = n.hi * inv;
    let pr = m.two_prod(q, s.hi);
    let ql = ((((n.hi - pr.hi) - pr.lo) + n.lo) - (q * dl)) * inv;
    let tail = atan_tail(q, q * q);
    let b = m.fast_two_sum(m.from_bits(t.ATAN_B[row + 1]), q);
    return m.fast_two_sum(b.hi, ((b.lo + m.from_bits(t.ATAN_B[row + 2])) + ql) + tail);
}

inline fn b2u(c: bool) u64 {
    if c {
        return 1;
    }
    return 0;
}

/// An estimate hi + (lo + tail) of a value, within e.
struct Est {
    hi: f64,
    lo: f64,
    tail: f64,
    e: f64,
}

/// Whether every value within f.e of f's sum rounds to the same double
/// (Ziv's test: rounds(), whose error bound e covers the rounding of
/// lo + tail).
inline fn est_rounds(f: Est) bool {
    return m.rounds(f.hi, f.lo + f.tail, f.e);
}

/// atan(a) for 2^-6 <= a < 2^6 as an estimate in plain double arithmetic
/// (atan_k's reduction without the residuals): with |u| <= 1/65, u is within
/// 3.02 2^-53 |u| (a - c is exact; a c, 1 + a c and the division each round
/// once; 2.02 2^-53 |u| with a fused multiply-add for 1 + a c); the series
/// (ATAN_R) within 2^-70 |u|, and the sum's low part within 2^-103 atan a.
inline fn atan_est(a: f64) Est {
    // the exponent and the significand's top 4 bits
    let row = @as(usize, @truncate(u32, (m.bits(a) >> 48) & 255)) * 3;
    let c = m.from_bits(t.ATAN_B[row]);
    let q = (a - c) / m.mla(a, c, 1.0);
    let z = q * q;
    let tail = (q * z) * (m.mla(z * z, m.mla(z, t.ATAN_R3, t.ATAN_R2), m.mla(z, t.ATAN_R1, t.ATAN_R0)));
    let b = m.fast_two_sum(m.from_bits(t.ATAN_B[row + 1]), q);
    let mut eq: f64 = 3.352873534367973e-16;  // 3.02 2^-53
    if @target_has("fma") or @target_arch("aarch64") {
        eq = 2.242650509742816e-16;  // 2.02 2^-53
    }
    return Est.{
        hi: b.hi,
        lo: b.lo + m.from_bits(t.ATAN_B[row + 2]),
        tail: tail,
        e: m.mla(@abs(q), eq, 1.55e-31),  // (+ 2^-103 pi/2)
    };
}

/// atan2's estimate of atan(s/b) = atan c + atan u + ul, c from a table: the
/// parts that come from the table (c_hi, c_lo) apart from those computed.
struct Est2 {
    c_hi: f64,
    c_lo: f64,
    u: f64,
    ul: f64,
    tail: f64,
    e: f64,
}

/// atan(s/b) for 2^-6 <= s/b <= 1 (q = s/b rounded) as an estimate in plain
/// double arithmetic: atan c + atan u, u = (s - c b)/(b + c s), c from q's
/// interval as in atan_est (|u| <= 1/64): the numerator rounded once (b c
/// is near s), the denominator once or twice, the quotient once: u within
/// 3.02 2^-53 |u| (4.02 without a fused multiply-add).
inline fn atan2_est(s: f64, b: f64, q: f64) Est2 {
    let row = @as(usize, @truncate(u32, (m.bits(q) >> 48) & 255)) * 3;
    let c = m.from_bits(t.ATAN_B[row]);
    let u = m.sub_prod(s, c, b) / m.mla(c, s, b);
    let z = u * u;
    let mut eq: f64 = 4.463096558993129e-16;  // 4.02 2^-53
    if @target_has("fma") or @target_arch("aarch64") {
        eq = 3.352873534367973e-16;  // 3.02 2^-53
    }
    return Est2.{
        c_hi: m.from_bits(t.ATAN_B[row + 1]),
        c_lo: m.from_bits(t.ATAN_B[row + 2]),
        u: u,
        ul: 0.0,
        tail: (u * z) * (m.mla(z * z, m.mla(z, t.ATAN_R3, t.ATAN_R2), m.mla(z, t.ATAN_R1, t.ATAN_R0))),
        e: @abs(u) * eq,
    };
}

/// atan(1/(a + al)) for a >= 2^6, as a double-double: 1/a by one division
/// and the exact residual, then the series.
inline fn atan_inv(a: f64, al: f64) m.DD {
    let inv = 1.0 / a;
    if a > 1.0e100 {
        return m.dd(inv, 0.0);  // atan(1/a) = 1/a within 2^-300 relative
    }
    let p = m.two_prod(inv, a);
    let ul = (((1.0 - p.hi) - p.lo) - (inv * al)) * inv;
    return m.fast_two_sum(inv, ul + atan_tail(inv, inv * inv));
}

/// atan(a + al) for 0 <= a (finite), as a double-double.
pub inline fn atan_pos(a: f64, al: f64) m.DD {
    if a < 0.015625 {
        return m.fast_two_sum(a, al + atan_tail(a, a * a));  // a < 2^-6: the series
    }
    if a < 64.0 {
        return atan_k(a, al);
    }
    let v = atan_inv(a, al);
    return m.dd_add(m.dd(t.PIO2_HI, t.PIO2_LO), m.dd_neg(v));
}

/// The arctangent.
pub inline fn atan(x: f64, rep: m.Rep) f64 {
    let ax = m.abits(x);
    if ax < 0x3e40000000000000 {
        if (ax < 0x0010000000000000) and (ax != 0) {
            m.raise_underflow(rep);
        }
        return x;  // |x| < 2^-27
    }
    if ax >= 0x7ff0000000000000 {
        if ax > 0x7ff0000000000000 {
            return x + x;
        }
        return @copysign(t.PIO2_HI, x);
    }
    let a = m.from_bits(ax);
    if (ax - 0x3f90000000000000) < (0x4050000000000000 - 0x3f90000000000000) {
        // 2^-6 <= |x| < 2^6
        let f = atan_est(a);
        if est_rounds(f) {
            return @copysign(f.hi + (f.lo + f.tail), x);
        }
    }
    let r = m.dd_round(atan_pos(a, 0.0));
    return @copysign(r, x);
}

// atan2's quadrants for |y| > |x| (1) and x < 0 (2): O (hi, lo) and the
// sign of atan(min/max) in O +- atan
let QUAD: [12]f64 = [
    0.0, 0.0, 1.0,               // atan
    t.PIO2_HI, t.PIO2_LO, -1.0,  // pi/2 - atan
    t.PI_HI, t.PI_LO, -1.0,      // pi - atan
    t.PIO2_HI, t.PIO2_LO, 1.0,   // pi - (pi/2 - atan)
];

/// The arctangent of y/x, in the quadrant of (x, y): for exponents within
/// 60 of each other and in [0x200, 0x600) (neither zero, infinite nor NaN,
/// and no scaling needed), an estimate in double and a rounding test
/// (Ziv's strategy), else atan2_slow.
pub inline fn atan2(y: f64, x: f64, rep: m.Rep) f64 {
    let bx = m.bits(x);
    let by = m.bits(y);
    let ax = bx & 0x7fffffffffffffff;
    let ay = by & 0x7fffffffffffffff;
    let ex = ax >> 52;
    let ey = ay >> 52;
    if ((ex -% 0x200) < 0x400) and ((ey -% 0x200) < 0x400) and (((ex -% ey) +% 60) <= 120) {
        // atan of the smaller over the larger, from their quotient (the
        // order of positive doubles is that of their bits)
        let sw = b2u(ay > ax);
        let small = m.from_bits(@min(ax, ay));
        let big = m.from_bits(@max(ax, ay));
        let q = small / big;
        let mut f = Est2.{ c_hi: 0.0, c_lo: 0.0, u: 0.0, ul: 0.0, tail: 0.0, e: 0.0 };
        if q >= 0.015625 {
            f = atan2_est(small, big, q);
        } else {
            // c = 0 and u + ul = small/big, the residual exact (ul within
            // 2^-105 u), the series within 2^-70 u
            let z = q * q;
            f = Est2.{
                c_hi: 0.0,
                c_lo: 0.0,
                u: q,
                ul: m.residual(small, q, big) / big,
                tail: (q * z) * (m.mla(z * z, m.mla(z, t.ATAN_R3, t.ATAN_R2), m.mla(z, t.ATAN_R1, t.ATAN_R0))),
                e: q * 8.470329472543003e-22,  // 2^-70
            };
        }
        // O + atan or O - atan for the quadrant's O in {0, pi/2, pi} (QUAD's
        // row, without branches: the quadrants are unpredictable): O + s c
        // (from the tables, early) and then s u, exactly (|u| <= |O + s c|
        // or both are 0) but for the low parts' roundings (each within
        // 2^-104 of the result)
        let row = @min(@as(usize, @truncate(u32, sw + ((bx >> 63) * 2))), 3) * 3;
        let sg = QUAD[row + 2];
        let a = m.fast_two_sum(QUAD[row], f.c_hi * sg);
        let b = m.fast_two_sum(a.hi, f.u * sg);
        let g = Est.{
            hi: b.hi,
            lo: b.lo + ((a.lo + QUAD[row + 1]) + ((f.c_lo + f.ul) * sg)),
            tail: f.tail * sg,
            e: f.e + 3.1e-31,  // (+ 2^-103 pi)
        };
        if est_rounds(g) {
            return @copysign(g.hi + (g.lo + g.tail), y);
        }
    }
    return atan2_slow(y, x, rep);
}

/// atan2 where its fast path does not decide: the special operands, the
/// operands of exponents far apart or far from 0, and the estimates that
/// fail the rounding test (in double-double, rounded once).
fn atan2_slow(y: f64, x: f64, rep: m.Rep) f64 @multiversion("fma") {
    let bx = m.bits(x);
    let by = m.bits(y);
    let ax = bx & 0x7fffffffffffffff;
    let ay = by & 0x7fffffffffffffff;
    if (ax > 0x7ff0000000000000) or (ay > 0x7ff0000000000000) {
        return x + y;
    }
    let neg_y = (by >> 63) != 0;
    let neg_x = (bx >> 63) != 0;
    let mut r = m.dd(0.0, 0.0);
    if ay == 0 {
        // atan2(+-0, x): +-0 for x > 0 or +0, +-pi for x < 0 or -0
        if neg_x {
            r = m.dd(t.PI_HI, t.PI_LO);
        } else {
            return y;
        }
    } else if ax == 0 {
        r = m.dd(t.PIO2_HI, t.PIO2_LO);
    } else if (ax == 0x7ff0000000000000) or (ay == 0x7ff0000000000000) {
        if ax != 0x7ff0000000000000 {
            r = m.dd(t.PIO2_HI, t.PIO2_LO);  // y infinite
        } else if ay == 0x7ff0000000000000 {
            if neg_x {
                r = m.dd(t.PI3O4_HI, t.PI3O4_LO);
            } else {
                r = m.dd(t.PIO4_HI, t.PIO4_LO);
            }
        } else if neg_x {
            r = m.dd(t.PI_HI, t.PI_LO);  // x = -inf
        } else {
            r = m.dd(0.0, 0.0);  // x = +inf
        }
    } else {
        let ex = m.exponent(m.from_bits(ax));
        let ey = m.exponent(m.from_bits(ay));
        if (ex - ey) > 60 {
            // |y/x| < 2^-59: atan(y/x) = y/x to within 2^-118 relative
            if not neg_x {
                let q = m.from_bits(ay) / m.from_bits(ax);
                if q < 2.2250738585072014e-308 {
                    m.raise_underflow(rep);
                }
                if neg_y {
                    return -q;
                }
                return q;
            }
            r = m.dd(t.PI_HI, t.PI_LO);
        } else if (ey - ex) > 60 {
            r = m.dd(t.PIO2_HI, t.PIO2_LO);
        } else {
            // scaled near 1 (exactly: their exponents are within 60) where
            // either is far from it
            let mut fx = m.from_bits(ax);
            let mut fy = m.from_bits(ay);
            if ((ex - 0x200) >= 0x400) or ((ey - 0x200) >= 0x400) or (ex < 0x200) or (ey < 0x200) {
                let k = 1023 - ex;
                let sc1 = m.pow2(k / 2);
                let sc2 = m.pow2(k - (k / 2));
                fx = (fx * sc1) * sc2;
                fy = (fy * sc1) * sc2;
            }
            // atan of the smaller over the larger, from their quotient (the
            // order of positive doubles is that of their bits) as a
            // double-double (the residual exact)
            let ix = m.bits(fx);
            let iy = m.bits(fy);
            let sw = b2u(iy > ix);
            let small = m.from_bits(@min(ix, iy));
            let big = m.from_bits(@max(ix, iy));
            let q = small / big;
            let ql = m.residual(small, q, big) / big;
            r = atan_pos(q, ql);
            if sw != 0 {
                r = m.dd_add(m.dd(t.PIO2_HI, t.PIO2_LO), m.dd_neg(r));
            }
            if neg_x {
                r = m.dd_add(m.dd(t.PI_HI, t.PI_LO), m.dd_neg(r));
            }
        }
    }
    let v = m.dd_round(r);
    if neg_y {
        return -v;
    }
    return v;
}
