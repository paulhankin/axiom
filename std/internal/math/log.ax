// =============================================================================
// std/internal/math/log.ax - log, log2, log10 and log1p (std/math's and the C
// library's: 7.12.6.7-12, F.10.3.7-12), and the double-double logarithm that
// pow and the inverse hyperbolic functions use.
//
// The method is table-driven (P. T. P. Tang, "Table-driven implementation of
// the logarithm function in IEEE floating-point arithmetic", ACM TOMS 16,
// 1990, with the reciprocal table of S. Gal's "accurate tables"): x = 2^k m,
// m in [0.709, 1.418), and for the interval of m that a table of 128 holds a
// c near 1/m, a multiple of 2^-9 with log c to 106 bits; then
//
//     log x = k ln2 - log c + log1p(r),  r = m c - 1, |r| <= 2^-7.7,
//
// where r is computed exactly (m split so that each product is exact) and
// log1p(r) is r plus a minimax polynomial. For the interval that holds 1.0,
// c is 1: there log x = log1p(m - 1) with nothing to cancel. The sum is
// formed with its rounding errors kept, and rounded once: within 0.51 ulp.
// (The sums of k ln2 - log c with r need no more than Dekker's Fast2Sum:
// for c != 1, |log c| is at least 1.97 |r| over the table, and for k != 0
// the first term is at least a third.)
// log2 has its own table of log2 c (with a high part that k + it keeps
// exact) and polynomial; it and log1p take the double-double logarithm only
// when the fast sum's error bound does not decide the rounding (Ziv's
// strategy).
// =============================================================================
import "core.ax" as m;
import "tables.ax" as t;

/// The reduction of x (the bits of a positive normal double): x = 2^k m,
/// m c = 1 + r + rl exactly, and -log c = l_hi + l_lo.
struct Red {
    i: usize,
    k: f64,
    r: f64,
    rl: f64,
    l_hi: f64,
    l_lo: f64,
}

inline fn reduce(ix: u64) Red {
    let tmp = ix -% t.LOG_OFF;
    let i = @as(usize, @truncate(u8, (tmp >> 45) & 127));
    let k = @bit_cast(i64, tmp) >> 52;
    let iz = ix -% (tmp & 0xfff0000000000000);
    let mm = m.from_bits(iz);
    let c = m.from_bits(t.LOG_C[i]);
    // m = mh + ml with mh of 43 bits: mh c (53 bits) and ml c are exact, and
    // so is mh c - 1 (mh c is within 2^-7 of 1); their sum rounds once, and
    // fast_two_sum keeps its error (exact, or the sum is: see below)
    let mh = m.from_bits(iz & 0xfffffffffffffc00);
    let ml = mm - mh;
    let a = (mh * c) - 1.0;
    let b = ml * c;
    // (if |a| < |b|, both are multiples of 2^-62 below 2^-40: the sum is
    // exact, and fast_two_sum's error is 0)
    let s = m.fast_two_sum(a, b);
    return Red.{ i: i, k: @float_from_int(f64, k), r: s.hi, rl: s.lo, l_hi: m.from_bits(t.LOG_L[2 * i]),
                 l_lo: m.from_bits(t.LOG_L[(2 * i) + 1]) };
}

/// The bits of x > 0 (finite, nonzero) as those of a normal number, and the
/// power of two that was taken out (0 or 52).
inline fn normal_bits(x: f64) u64 {
    let ix = m.bits(x);
    if ix < 0x0010000000000000 {
        return m.bits(x * 4503599627370496.0) -% (@as(u64, 52) << 52);  // 2^52
    }
    return ix;
}

/// log1p(r) - r for the fast logarithm.
inline fn poly(r: f64) f64 {
    let z = r * r;
    let w = z * z;
    return z *
           (((t.LOG_P0 + (r * t.LOG_P1)) + (z * (t.LOG_P2 + (r * t.LOG_P3)))) +
            (w * ((t.LOG_P4 + (r * t.LOG_P5)) + (z * t.LOG_P6))));
}

/// The value of a special argument of a logarithm (x = +-0, negative, inf or
/// NaN; the bits ix), as 7.12.6 and F.10.3 say.
fn special(x: f64, ix: u64, rep: m.Rep) f64 {
    if (ix << 1) == 0 {
        return m.pole(rep, true);  // log(+-0) = -inf
    }
    if ix == 0x7ff0000000000000 {
        return x;  // log(+inf) = +inf
    }
    if (ix & 0x7fffffffffffffff) > 0x7ff0000000000000 {
        return x + x;  // NaN
    }
    return m.domain(rep);  // x < 0
}

/// The natural logarithm.
pub inline fn log(x: f64, rep: m.Rep) f64 {
    let mut ix = m.bits(x);
    if (ix -% 0x0010000000000000) >= 0x7fe0000000000000 {
        // not a positive normal number
        if (ix >= 0x7ff0000000000000) or ((ix << 1) == 0) {
            return special(x, ix, rep);
        }
        ix = normal_bits(x);  // subnormal
    }
    let rd = reduce(ix);
    // k ln2_hi is exact; when k is not 0 it is the larger term
    let a = m.fast_two_sum(rd.k * t.LN2_HI, rd.l_hi);
    let b = m.fast_two_sum(a.hi, rd.r);
    let lo = (((a.lo + b.lo) + (rd.k * t.LN2_LO)) + (rd.l_lo + rd.rl)) + poly(rd.r);
    return b.hi + lo;
}

/// The natural logarithm of x > 0 (finite) as hi + lo before its last
/// rounding, within 2^-60 relative (log's sum: the inverse hyperbolic
/// functions add a correction before rounding).
pub inline fn log_fast(x: f64) m.DD {
    let rd = reduce(normal_bits(x));
    let a = m.fast_two_sum(rd.k * t.LN2_HI, rd.l_hi);
    let b = m.fast_two_sum(a.hi, rd.r);
    return m.dd(b.hi, (((a.lo + b.lo) + (rd.k * t.LN2_LO)) + (rd.l_lo + rd.rl)) + poly(rd.r));
}

/// log(1 + x) for x > -1 (finite), as hi + lo before its last rounding,
/// within 2^-59 relative (log1p's two paths).
pub inline fn log1p_fast(x: f64) m.DD {
    if @abs(x) <= 0.03125 {
        let z = x * x;
        let w = z * z;
        let p = ((t.LOG1P_P0 + (x * t.LOG1P_P1)) + (z * (t.LOG1P_P2 + (x * t.LOG1P_P3)))) +
                (w * (((t.LOG1P_P4 + (x * t.LOG1P_P5)) + (z * (t.LOG1P_P6 + (x * t.LOG1P_P7)))) + (w * t.LOG1P_P8)));
        return m.dd(x, z * p);
    }
    let s = m.two_sum(1.0, x);
    let l = log_fast(s.hi);
    return m.dd(l.hi, l.lo + (s.lo / s.hi));
}

/// The natural logarithm of x > 0 (finite) as a double-double, to about
/// 2^-75 (relative).
pub fn log_dd(x: f64) m.DD @multiversion("fma") {
    return log_dd_k(x);
}

/// log_dd, inline (pow).
pub inline fn log_dd_k(x: f64) m.DD {
    let rd = reduce(normal_bits(x));
    let r = rd.r;
    // log1p(r + rl) = r - r^2/2 + r^3 q(r) + rl (1 - r) + ...
    let s = m.two_sqr(r);
    let r3 = r * s.hi;
    let z = s.hi;
    let w = z * z;
    let q =
        (((t.LOGD_P1 + (r * t.LOGD_P2)) + (z * (t.LOGD_P3 + (r * t.LOGD_P4)))) +
         (w * ((t.LOGD_P5 + (r * t.LOGD_P6)) + (z * (t.LOGD_P7 + (r * t.LOGD_P8)))))) + ((w * w) * t.LOGD_P9);
    let tail = (r3 * t.LOGD_P0) + (r3 * ((r * q) + t.THIRD_LO));
    let a = m.fast_two_sum(rd.k * t.LN2_HI, rd.l_hi);
    let b = m.fast_two_sum(a.hi, r);
    let c = m.fast_two_sum(b.hi, -0.5 * s.hi);
    let lo = ((((a.lo + b.lo) + c.lo) + ((rd.k * t.LN2_LO) + rd.l_lo)) + ((rd.rl - (r * rd.rl)) - (0.5 * s.lo))) +
             (tail + (rd.k * t.LN2_LO2));
    return m.fast_two_sum(c.hi, lo);
}

/// log(x) for x as a double-double (x > 0 finite).
pub inline fn log_dd2(x: m.DD) m.DD {
    let l = log_dd(x.hi);
    return m.dd_add_d(l, x.lo / x.hi);
}

/// The base-2 logarithm.
pub inline fn log2(x: f64, rep: m.Rep) f64 {
    let mut ix = m.bits(x);
    if (ix -% 0x0010000000000000) >= 0x7fe0000000000000 {
        if (ix >= 0x7ff0000000000000) or ((ix << 1) == 0) {
            return special(x, ix, rep);
        }
        ix = normal_bits(x);
    }
    let rd = reduce(ix);
    // log2 x = k - log2 c + log2(1 + r + rl): k - log2 c's high part (42
    // bits, LOG2_L) is exact, r/ln2 a double-double, and
    // log2(1 + r) - r/ln2 = r^2 P(r) within 2^-61.2 |r| (LOG2_P); with the
    // roundings of the low parts, the sum is within 2^-59 |r| + 2^-100 |x|
    let l = m.from_bits(t.LOG2_L[2 * rd.i]) + rd.k;
    let p = m.two_prod(rd.r, t.INVLN2_HI);
    let a = m.fast_two_sum(l, p.hi);
    let r = rd.r;
    let z = r * r;
    let w = z * z;
    let q = z *
            (((t.LOG2_P0 + (r * t.LOG2_P1)) + (z * (t.LOG2_P2 + (r * t.LOG2_P3)))) +
             (w * ((t.LOG2_P4 + (r * t.LOG2_P5)) + (z * t.LOG2_P6))));
    let lo = ((a.lo + p.lo) + ((m.from_bits(t.LOG2_L[(2 * rd.i) + 1]) + (r * t.INVLN2_LO)) + (rd.rl * t.INVLN2_HI))) +
             q;
    // (within 0.5 + 2^-6 ulp: |r|/ln2 + log2 c is at least |r|)
    return a.hi + lo;
}

/// The base-10 logarithm.
pub inline fn log10(x: f64, rep: m.Rep) f64 {
    let mut ix = m.bits(x);
    if (ix -% 0x0010000000000000) >= 0x7fe0000000000000 {
        if (ix >= 0x7ff0000000000000) or ((ix << 1) == 0) {
            return special(x, ix, rep);
        }
        ix = normal_bits(x);
    }
    // log10 x = k log10(2) - log10 c + log10(1 + r + rl), as log2's (with
    // log10's table of -log10 c and polynomial): within 0.5 + 2^-6 ulp
    let rd = reduce(ix);
    let l = m.from_bits(t.LOG10_L[2 * rd.i]) + (rd.k * t.LOG10_2_HI);
    let p = m.two_prod(rd.r, t.INVLN10_HI);
    let a = m.fast_two_sum(l, p.hi);
    let r = rd.r;
    let z = r * r;
    let w = z * z;
    let q = z *
            (((t.LOG10_P0 + (r * t.LOG10_P1)) + (z * (t.LOG10_P2 + (r * t.LOG10_P3)))) +
             (w * ((t.LOG10_P4 + (r * t.LOG10_P5)) + (z * t.LOG10_P6))));
    let lo =
        ((a.lo + p.lo) +
         (((m.from_bits(t.LOG10_L[(2 * rd.i) + 1]) + (rd.k * t.LOG10_2_LO)) + (r * t.INVLN10_LO)) +
          (rd.rl * t.INVLN10_HI))) + q;
    return a.hi + lo;
}

/// log(1 + x).
pub inline fn log1p(x: f64, rep: m.Rep) f64 {
    let ix = m.bits(x);
    let ax = ix & 0x7fffffffffffffff;
    if ax < 0x3c90000000000000 {
        return x;  // |x| < 2^-54 (and +-0)
    }
    if ix >= 0xbff0000000000000 {
        // x <= -1, or a NaN with the sign bit
        if ax > 0x7ff0000000000000 {
            return x + x;
        }
        if ix == 0xbff0000000000000 {
            return m.pole(rep, true);
        }
        return m.domain(rep);
    }
    if (ix >= 0x7ff0000000000000) and (ix < 0x8000000000000000) {
        return x + x;  // +inf, NaN
    }
    if ax <= 0x3fa0000000000000 {
        // |x| <= 1/32: x + x^2 P(x) (LOG1P_P within 2^-61.5; x^2 P is at most
        // x/60, its roundings a fortieth of an ulp)
        let z = x * x;
        let w = z * z;
        let p = ((t.LOG1P_P0 + (x * t.LOG1P_P1)) + (z * (t.LOG1P_P2 + (x * t.LOG1P_P3)))) +
                (w * (((t.LOG1P_P4 + (x * t.LOG1P_P5)) + (z * (t.LOG1P_P6 + (x * t.LOG1P_P7)))) + (w * t.LOG1P_P8)));
        return x + (z * p);
    }
    // 1 + x = u + c exactly; log1p(x) = log(u) + log1p(c/u), |c/u| < 2^-52:
    // log u as log's (LOG_P within 2^-70 |r|, its evaluation within 2^-61.5
    // |r|, the low parts' roundings 2^-95 of the result) and c/u (within
    // 2^-104 |c/u|), the result at least 1/33: within 0.5 + 2^-7 ulp
    let s = m.two_sum(1.0, x);
    let rd = reduce(m.bits(s.hi));
    let cu = s.lo / s.hi;
    let a = m.fast_two_sum(rd.k * t.LN2_HI, rd.l_hi);
    let b = m.fast_two_sum(a.hi, rd.r);
    let lo = ((((a.lo + b.lo) + (rd.k * t.LN2_LO)) + (rd.l_lo + rd.rl)) + poly(rd.r)) + cu;
    return b.hi + lo;
}

/// log(1 + x) as a double-double, for x > -1 finite (the inverse
/// hyperbolic functions).
pub inline fn log1p_dd(x: m.DD) m.DD {
    let s = m.two_sum(1.0, x.hi);
    let l = log_dd(s.hi);
    return m.dd_add_d(l, (s.lo + x.lo) / s.hi);
}
