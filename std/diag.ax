// =============================================================================
// std/diag.ax - diagnostic context for parsers and validators.
//
//     let mut info = diag.ErrorInfo.init();
//     parse_with(text, &mut info) catch |e| {
//         // info.offset, info.line, info.col, info.detail describe the failure
//     };
// =============================================================================

/// Standard parse and validation diagnostic context, passed by `*mut ErrorInfo`
/// alongside compact error codes.
pub struct ErrorInfo {
    pub offset: usize,
    pub line: u32,
    pub col: u32,
    pub detail: []u8,

    /// Returns a zeroed/empty `ErrorInfo`.
    pub fn init() ErrorInfo {
        return ErrorInfo.{ offset: 0, line: 0, col: 0, detail: "" };
    }

    /// Constructs an `ErrorInfo` at the given byte offset, 1-based line and
    /// column, and detail message.
    pub fn at(offset: usize, line: u32, col: u32, detail: []u8) ErrorInfo {
        return ErrorInfo.{ offset: offset, line: line, col: col, detail: detail };
    }
}

/// Returns a zeroed/empty `ErrorInfo`.
pub fn init() ErrorInfo {
    return ErrorInfo.init();
}

/// Constructs an `ErrorInfo` at the given byte offset, 1-based line and
/// column, and detail message.
pub fn at(offset: usize, line: u32, col: u32, detail: []u8) ErrorInfo {
    return ErrorInfo.at(offset, line, col, detail);
}

// -----------------------------------------------------------------------------
// Tests (axiom test std/diag.ax)
// -----------------------------------------------------------------------------

test "ErrorInfo.init and ErrorInfo.at" {
    let z = ErrorInfo.init();
    @expect_eq(z.offset, 0);
    @expect_eq(z.line, 0);
    @expect_eq(z.col, 0);
    @expect_eq(z.detail, "");
    @expect_eq(z.detail.len, 0);

    let d = ErrorInfo.at(42, 3, 17, "unexpected token");
    @expect_eq(d.offset, 42);
    @expect_eq(d.line, 3);
    @expect_eq(d.col, 17);
    @expect_eq(d.detail, "unexpected token");
}

test "diag.init and diag.at" {
    let z = init();
    @expect_eq(z.offset, 0);
    @expect_eq(z.line, 0);
    @expect_eq(z.col, 0);
    @expect_eq(z.detail, "");

    let d = at(10, 2, 5, "bad byte");
    @expect_eq(d.offset, 10);
    @expect_eq(d.line, 2);
    @expect_eq(d.col, 5);
    @expect_eq(d.detail, "bad byte");
}
