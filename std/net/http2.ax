// =============================================================================
// std/net/http2.ax - HTTP/2 (RFC 9113): framing, streams, flow control, and a
// client; std/net/http serves HTTP/2 with it.
//
//     // over a connection the caller made (TLS with ALPN "h2", or plain for
//     // "prior knowledge"), as an io.Reader and io.Writer:
//     let mut c = http2.Client.init(r, w, "example.com", "https")!;
//     defer c.deinit();
//     let mut resp = c.request("GET", "/", no_headers, "")!;   // resp.status, .headers, .body
//     defer resp.deinit();
//
// http.request uses this for https:// URLs when ClientOptions.http2 is set
// and the server agrees; an http.Server speaks HTTP/2 to clients that ask
// for it (ALPN "h2" over TLS, or the HTTP/2 preface on a plain connection).
//
// A Conn is one side of a connection, used by one thread at a time: it
// reads and handles frames (settings, pings, window updates, resets,
// goaway) as it goes, and waits for window updates when flow control says
// so. It checks what the peer sends: frame sizes, stream states, header
// blocks and their CONTINUATION frames, header fields (RFC 9113 8.2 and
// 8.3: a malformed message resets its stream), windows, and limits on
// concurrent streams, header list size and body size (each stream's, and
// all of a connection's together). Server push is refused.
// =============================================================================

import "../collections/vec.ax" as vec;
import "../encoding/binary.ax" as binary;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../net.ax" as net;
import "../str.ax" as strs;
import "../time.ax" as time;
import "hpack.ax" as hpack;

pub error Http2Error { ProtocolError, FlowControlError, FrameSizeError, CompressionError, StreamClosed, StreamReset,
                       GoAway, TooBig, Closed, NetError, TimedOut, OutOfMemory, ConnectionRefused, NotFound, Empty,
                       DecodeError, AddressInUse, Done, ListTooLarge, InvalidUtf8, InvalidAddress, IoError }

/// Frame types.
pub const DATA: u8 = 0;
pub const HEADERS: u8 = 1;
pub const PRIORITY: u8 = 2;
pub const RST_STREAM: u8 = 3;
pub const SETTINGS: u8 = 4;
pub const PUSH_PROMISE: u8 = 5;
pub const PING: u8 = 6;
pub const GOAWAY: u8 = 7;
pub const WINDOW_UPDATE: u8 = 8;
pub const CONTINUATION: u8 = 9;

const END_STREAM: u8 = 1;
const ACK: u8 = 1;
const END_HEADERS: u8 = 4;
const PADDED: u8 = 8;
const PRIO: u8 = 0x20;

/// Error codes (for RST_STREAM and GOAWAY).
pub const NO_ERROR: u32 = 0;
pub const PROTOCOL_ERROR: u32 = 1;
pub const INTERNAL_ERROR: u32 = 2;
pub const FLOW_CONTROL_ERROR: u32 = 3;
pub const STREAM_CLOSED: u32 = 5;
pub const FRAME_SIZE_ERROR: u32 = 6;
pub const REFUSED_STREAM: u32 = 7;
pub const CANCEL: u32 = 8;
pub const COMPRESSION_ERROR: u32 = 9;
pub const ENHANCE_YOUR_CALM: u32 = 11;

/// The client's first 24 bytes.
pub let PREFACE: []u8 = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";

const MAX_FRAME: usize = 16384;  // what this side accepts (the default)
const WINDOW: i64 = 1048576;     // this side's receive windows
const MAX_WINDOW: i64 = 2147483647;
// request bodies a connection may hold at once: max_body and this much more
const BUFFER_ALLOWANCE: usize = 1048576;

/// A stream: its request or response as it arrives.
pub struct Stream {
    id: u32,
    send_window: i64,
    recv_window: i64,
    got_headers: bool,
    remote_done: bool,  // END_STREAM received
    local_done: bool,   // END_STREAM sent
    reset: bool,
    reset_code: u32,
    content_length: i64,  // (a request's) -1: none
    store: strs.String,   // header names and values
    spans: vec.Vec.[[4]usize],
    list: vec.Vec.[hpack.Header],
    body: strs.String,

    fn init(id: u32, send_window: i64) Stream {
        return Stream.{ id: id, send_window: send_window, recv_window: WINDOW, got_headers: false, remote_done: false,
                        local_done: false, reset: false, reset_code: 0, content_length: -1, store: strs.String.init(),
                        spans: vec.Vec.[[4]usize].init(), list: vec.Vec.[hpack.Header].init(),
                        body: strs.String.init() };
    }

    fn deinit(self: *mut Stream) void {
        self.store.deinit();
        self.spans.deinit();
        self.list.deinit();
        self.body.deinit();
    }

    /// The headers received (pseudo-headers such as ":path" first), valid
    /// while the stream is.
    pub fn headers(self: *mut Stream) []hpack.Header {
        self.list.clear();
        let st = self.store.bytes();
        for sp in self.spans.items() {
            self.list.push(hpack.Header.{ name: st[sp[0]..sp[0] + sp[1]], value: st[sp[2]..sp[2] + sp[3]] }) catch {};
        }
        return self.list.items();
    }

    /// The first header of that name ("" if none).
    pub fn header(self: *mut Stream, name: []u8) []u8 {
        for h in self.headers() {
            if strs.eq(h.name, name) {
                return h.value;
            }
        }
        return "";
    }
}

pub struct Conn {
    r: io.Reader,
    w: io.Writer,
    server: bool,
    rbuf: []mut u8,
    start: usize,
    end: usize,
    enc: hpack.Encoder,
    dec: hpack.Decoder,
    peer_max_frame: usize,
    peer_initial_window: i64,
    peer_max_streams: u32,
    send_window: i64,  // the connection's
    recv_window: i64,
    streams: vec.Vec.[*mut Stream],
    last_peer_stream: u32,
    next_stream: u32,  // for a client's requests
    max_streams: u32,  // concurrent streams the peer may open
    max_body: usize,
    got_goaway: bool,
    goaway_last: u32,
    sent_goaway: bool,
    block: strs.String,  // a header block across CONTINUATION frames
    block_stream: u32,
    block_end_stream: bool,
    in_block: bool,
    out: strs.String,
    buffered: usize,      // the bodies of all streams
    done: vec.Vec.[u32],  // streams send_data saw complete, for take_done
    deadline: i64,        // monotonic ns after which reads fail with TimedOut (0: none)

    /// A connection over r and w. prefill: bytes already read from it (they
    /// are read first).
    pub fn init(r: io.Reader, w: io.Writer, server: bool, prefill: []u8) Http2Error!Conn {
        let buf = mem.alloc.[u8](@max(MAX_FRAME + 9, prefill.len) + 16)!;
        @mem_copy(buf[..prefill.len], prefill);
        let mut next: u32 = 1;
        if server {
            next = 2;
        }
        return Conn.{ r: r, w: w, server: server, rbuf: buf, start: 0, end: prefill.len, enc: hpack.Encoder.init(),
                      dec: hpack.Decoder.init(4096), peer_max_frame: 16384, peer_initial_window: 65535,
                      peer_max_streams: 100, send_window: 65535, recv_window: 65535,
                      streams: vec.Vec.[*mut Stream].init(), last_peer_stream: 0, next_stream: next, max_streams: 100,
                      max_body: 16777216, got_goaway: false, goaway_last: 0, sent_goaway: false,
                      block: strs.String.init(), block_stream: 0, block_end_stream: false, in_block: false,
                      out: strs.String.init(), buffered: 0, done: vec.Vec.[u32].init(), deadline: 0 };
    }

    pub fn deinit(self: *mut Conn) void {
        for s in self.streams.items() {
            s.deinit();
            mem.destroy(s);
        }
        self.streams.deinit();
        mem.free(self.rbuf);
        self.enc.deinit();
        self.dec.deinit();
        self.block.deinit();
        self.out.deinit();
        self.done.deinit();
    }

    /// The opening: a client sends the preface; each side its SETTINGS and
    /// a bigger connection window. A server first reads the preface.
    pub fn handshake(self: *mut Conn) Http2Error!void {
        if self.server {
            self.fill(24)!;
            if not strs.eq(self.rbuf[self.start..self.start + 24], PREFACE) {
                return error.ProtocolError;
            }
            self.start += 24;
        } else {
            self.w.write_all(PREFACE) catch return error.NetError;
        }
        // SETTINGS: no push (client), concurrent streams (server), window
        let mut p = strs.String.init();
        defer p.deinit();
        if self.server {
            setting(&mut p, 3, self.max_streams)!;  // MAX_CONCURRENT_STREAMS
            setting(&mut p, 6, 65536)!;             // MAX_HEADER_LIST_SIZE
        } else {
            setting(&mut p, 2, 0)!;  // ENABLE_PUSH
        }
        setting(&mut p, 4, @truncate(u32, @bit_cast(u64, WINDOW)))!;  // INITIAL_WINDOW_SIZE
        self.write_frame(SETTINGS, 0, 0, p.bytes())!;
        let inc = WINDOW - 65535;
        self.window_update(0, @truncate(u32, @bit_cast(u64, inc)))!;
        self.recv_window += inc;
    }

    fn fill(self: *mut Conn, n: usize) Http2Error!void {
        if (self.end - self.start) >= n {
            return;
        }
        if self.start > 0 {
            let k = self.end - self.start;
            for i in @as(usize, 0)..k {
                self.rbuf[i] = self.rbuf[self.start + i];
            }
            self.start = 0;
            self.end = k;
        }
        while self.end < n {
            // (pings and the like must not keep a connection for ever)
            if (self.deadline != 0) and (time.Instant.now().ns > self.deadline) {
                return error.TimedOut;
            }
            let got = self.r.read(self.rbuf[self.end..]) catch |e| {
                if e == error.TimedOut {
                    return error.TimedOut;
                }
                return error.NetError;
            };
            if got == 0 {
                return error.Closed;
            }
            self.end += got;
        }
    }

    fn write_frame(self: *mut Conn, ty: u8, flags: u8, stream: u32, payload: []u8) Http2Error!void {
        self.out.clear();
        let n = payload.len;
        self.out.push(@truncate(u8, n >> 16))!;
        self.out.push(@truncate(u8, n >> 8))!;
        self.out.push(@truncate(u8, n))!;
        self.out.push(ty)!;
        self.out.push(flags)!;
        put32(&mut self.out, stream & 0x7fffffff)!;
        self.out.push_str(payload)!;
        self.w.write_all(self.out.bytes()) catch return error.NetError;
    }

    fn window_update(self: *mut Conn, stream: u32, inc: u32) Http2Error!void {
        let mut p: [4]u8 = [0; 4];
        binary.put_u32_be(p[..], inc);
        self.write_frame(WINDOW_UPDATE, 0, stream, p[..])!;
    }

    /// Resets a stream (CANCEL, REFUSED_STREAM, ...).
    pub fn reset_stream(self: *mut Conn, id: u32, code: u32) Http2Error!void {
        let mut p: [4]u8 = [0; 4];
        binary.put_u32_be(p[..], code);
        self.write_frame(RST_STREAM, 0, id, p[..])!;
        let s = self.find(id) catch return;
        s.reset = true;
        s.local_done = true;
        s.remote_done = true;
    }

    /// Ends the connection: GOAWAY, naming the last stream this side took.
    pub fn goaway(self: *mut Conn, code: u32) Http2Error!void {
        if self.sent_goaway {
            return;
        }
        self.sent_goaway = true;
        let mut p: [8]u8 = [0; 8];
        binary.put_u32_be(p[..4], self.last_peer_stream);
        binary.put_u32_be(p[4..], code);
        self.write_frame(GOAWAY, 0, 0, p[..])!;
    }

    // a connection error: GOAWAY with the code, then the error
    fn fail(self: *mut Conn, code: u32, e: error) error {
        self.goaway(code) catch {};
        return e;
    }

    fn has(self: *Conn, id: u32) bool {
        for s in self.streams.items() {
            if s.id == id {
                return true;
            }
        }
        return false;
    }

    fn find(self: *mut Conn, id: u32) Http2Error!*mut Stream {
        for s in self.streams.items() {
            if s.id == id {
                return s;
            }
        }
        return error.StreamClosed;
    }

    fn open(self: *mut Conn, id: u32) Http2Error!*mut Stream {
        let s = mem.create(Stream.init(id, self.peer_initial_window))!;
        self.streams.push(s) catch |e| {
            mem.destroy(s);
            return e;
        };
        return s;
    }

    /// Forgets a finished stream.
    pub fn drop_stream(self: *mut Conn, id: u32) void {
        let ss = self.streams.items();
        for k in @as(usize, 0)..ss.len {
            if ss[k].id == id {
                let s = ss[k];
                _ = self.streams.remove(k);
                self.buffered -= s.body.len;
                s.deinit();
                mem.destroy(s);
                return;
            }
        }
    }

    fn active(self: *Conn) u32 {
        let mut n: u32 = 0;
        for s in self.streams.items() {
            if not (s.remote_done and s.local_done) {
                n += 1;
            }
        }
        return n;
    }

    /// Reads and handles one frame. Returns the stream it completed (a
    /// request or response whose END_STREAM arrived, or that was reset), or
    /// 0.
    pub fn step(self: *mut Conn) !u32 {
        self.fill(9)!;
        let h = self.rbuf[self.start..self.start + 9];
        let len = ((@as(usize, h[0]) << 16) | (@as(usize, h[1]) << 8)) | @as(usize, h[2]);
        let ty = h[3];
        let flags = h[4];
        let sid = binary.u32_be(h[5..]) & 0x7fffffff;
        if len > MAX_FRAME {
            return self.fail(FRAME_SIZE_ERROR, error.FrameSizeError);
        }
        self.fill(9 + len)!;
        let payload = self.rbuf[self.start + 9..self.start + 9 + len];
        self.start += 9 + len;
        // inside a header block only its CONTINUATION frames may come
        if self.in_block and ((ty != CONTINUATION) or (sid != self.block_stream)) {
            return self.fail(PROTOCOL_ERROR, error.ProtocolError);
        }
        if ty == SETTINGS {
            return self.on_settings(flags, sid, payload);
        }
        if ty == PING {
            if (sid != 0) or (len != 8) {
                return self.fail(PROTOCOL_ERROR, error.ProtocolError);
            }
            if (flags & ACK) == 0 {
                let mut copy: [8]u8 = [0; 8];
                @mem_copy(copy[..], payload);
                self.write_frame(PING, ACK, 0, copy[..])!;
            }
            return 0;
        }
        if ty == WINDOW_UPDATE {
            if len != 4 {
                return self.fail(FRAME_SIZE_ERROR, error.FrameSizeError);
            }
            let inc = @as(i64, binary.u32_be(payload[0..]) & 0x7fffffff);
            if sid == 0 {
                if inc == 0 {
                    return self.fail(PROTOCOL_ERROR, error.ProtocolError);
                }
                self.send_window += inc;
                if self.send_window > MAX_WINDOW {
                    return self.fail(FLOW_CONTROL_ERROR, error.FlowControlError);
                }
                return 0;
            }
            let s = self.find(sid) catch return 0;
            if inc == 0 {
                self.reset_stream(sid, PROTOCOL_ERROR)!;
                return sid;
            }
            s.send_window += inc;
            if s.send_window > MAX_WINDOW {
                self.reset_stream(sid, FLOW_CONTROL_ERROR)!;
                return sid;
            }
            return 0;
        }
        if ty == GOAWAY {
            if (sid != 0) or (len < 8) {
                return self.fail(PROTOCOL_ERROR, error.ProtocolError);
            }
            self.got_goaway = true;
            self.goaway_last = binary.u32_be(payload[0..]) & 0x7fffffff;
            return 0;
        }
        if ty == RST_STREAM {
            if (sid == 0) or (len != 4) {
                return self.fail(PROTOCOL_ERROR, error.ProtocolError);
            }
            let s = self.find(sid) catch return 0;
            s.reset = true;
            s.reset_code = binary.u32_be(payload[0..]);
            s.remote_done = true;
            s.local_done = true;
            return sid;
        }
        if ty == PRIORITY {
            if (sid == 0) or (len != 5) {
                return self.fail(PROTOCOL_ERROR, error.ProtocolError);
            }
            return 0;
        }
        if ty == PUSH_PROMISE {
            // (this side disabled push)
            return self.fail(PROTOCOL_ERROR, error.ProtocolError);
        }
        if (ty == HEADERS) or (ty == CONTINUATION) {
            return self.on_headers(ty, flags, sid, payload);
        }
        if ty == DATA {
            return self.on_data(flags, sid, payload);
        }
        return 0;  // unknown frame types are ignored
    }

    fn on_settings(self: *mut Conn, flags: u8, sid: u32, p: []u8) !u32 {
        if sid != 0 {
            return self.fail(PROTOCOL_ERROR, error.ProtocolError);
        }
        if (flags & ACK) != 0 {
            if p.len != 0 {
                return self.fail(FRAME_SIZE_ERROR, error.FrameSizeError);
            }
            return 0;
        }
        if (p.len % 6) != 0 {
            return self.fail(FRAME_SIZE_ERROR, error.FrameSizeError);
        }
        let mut i: usize = 0;
        while i < p.len {
            let id = (@as(u16, p[i]) << 8) | @as(u16, p[i + 1]);
            let v = binary.u32_be(p[i + 2..]);
            i += 6;
            if id == 1 {
                self.enc.set_max_size(@as(usize, @min(v, 65536)))!;
            } else if id == 2 {
                if v > 1 {
                    return self.fail(PROTOCOL_ERROR, error.ProtocolError);
                }
            } else if id == 3 {
                self.peer_max_streams = v;
            } else if id == 4 {
                if v > 0x7fffffff {
                    return self.fail(FLOW_CONTROL_ERROR, error.FlowControlError);
                }
                // open streams' windows move by the difference
                let delta = @as(i64, v) - self.peer_initial_window;
                self.peer_initial_window = @as(i64, v);
                for s in self.streams.items() {
                    s.send_window += delta;
                    if s.send_window > MAX_WINDOW {
                        return self.fail(FLOW_CONTROL_ERROR, error.FlowControlError);
                    }
                }
            } else if id == 5 {
                if (v < 16384) or (v > 16777215) {
                    return self.fail(PROTOCOL_ERROR, error.ProtocolError);
                }
                self.peer_max_frame = @as(usize, v);
            }
        }
        self.write_frame(SETTINGS, ACK, 0, "")!;
        return 0;
    }

    fn on_headers(self: *mut Conn, ty: u8, flags: u8, sid: u32, p0: []u8) !u32 {
        if sid == 0 {
            return self.fail(PROTOCOL_ERROR, error.ProtocolError);
        }
        let mut p = p0;
        if ty == HEADERS {
            if self.in_block {
                return self.fail(PROTOCOL_ERROR, error.ProtocolError);
            }
            p = unpad(flags, p) catch return self.fail(PROTOCOL_ERROR, error.ProtocolError);
            if (flags & PRIO) != 0 {
                if p.len < 5 {
                    return self.fail(FRAME_SIZE_ERROR, error.FrameSizeError);
                }
                p = p[5..];
            }
            self.block.clear();
            self.block_stream = sid;
            self.block_end_stream = (flags & END_STREAM) != 0;
            self.in_block = true;
        } else if not self.in_block {
            return self.fail(PROTOCOL_ERROR, error.ProtocolError);
        }
        if (self.block.len + p.len) > 262144 {
            return self.fail(ENHANCE_YOUR_CALM, error.TooBig);
        }
        self.block.push_str(p)!;
        if (flags & END_HEADERS) == 0 {
            return 0;
        }
        self.in_block = false;
        // the stream: a new one from the client, or one this side opened
        if not self.has(sid) {
            if not self.server or ((sid & 1) == 0) or (sid <= self.last_peer_stream) {
                // (a closed stream, or one this side never opened)
                let hs = self.dec.decode(self.block.bytes()) catch return self.fail(
                    COMPRESSION_ERROR, error.CompressionError);
                _ = hs;
                return self.fail(PROTOCOL_ERROR, error.ProtocolError);
            }
            self.last_peer_stream = sid;
            _ = self.open(sid)!;
            if self.active() > self.max_streams {
                _ = self.dec.decode(self.block.bytes()) catch return self.fail(
                    COMPRESSION_ERROR, error.CompressionError);
                self.reset_stream(sid, REFUSED_STREAM)!;
                self.drop_stream(sid);
                return 0;
            }
        }
        let s = self.find(sid)!;
        let hs = self.dec.decode(self.block.bytes()) catch return self.fail(COMPRESSION_ERROR, error.CompressionError);
        if s.remote_done {
            if s.reset {
                return 0;  // (sent before our RST_STREAM arrived)
            }
            return self.fail(STREAM_CLOSED, error.StreamClosed);
        }
        // a malformed message resets its stream (RFC 9113 8.1.1); a second
        // block is trailers, which end the stream
        let trailers = s.got_headers;
        if (trailers and not self.block_end_stream) or not check_fields(hs, self.server, trailers) {
            self.reset_stream(sid, PROTOCOL_ERROR)!;
            return sid;
        }
        if self.server and not trailers {
            s.content_length = content_length(hs);
            if s.content_length == -2 {
                self.reset_stream(sid, PROTOCOL_ERROR)!;
                return sid;
            }
        }
        // (a server drops trailers, as HTTP/1 does)
        if not (trailers and self.server) {
            for x in hs {
                let na = s.store.len;
                s.store.push_str(x.name)!;
                let va = s.store.len;
                s.store.push_str(x.value)!;
                s.spans.push([na, x.name.len, va, x.value.len])!;
            }
        }
        s.got_headers = true;
        // (a 1xx response is followed by the real one)
        if not self.server and strs.starts_with(s.header(":status"), "1") and not self.block_end_stream {
            s.spans.clear();
            s.store.clear();
            s.got_headers = false;
            return 0;
        }
        if self.block_end_stream {
            if (s.content_length >= 0) and (@as(i64, @bit_cast(i64, @as(u64, s.body.len))) != s.content_length) {
                self.reset_stream(sid, PROTOCOL_ERROR)!;
                return sid;
            }
            s.remote_done = true;
            return sid;
        }
        return 0;
    }

    fn on_data(self: *mut Conn, flags: u8, sid: u32, p0: []u8) !u32 {
        if sid == 0 {
            return self.fail(PROTOCOL_ERROR, error.ProtocolError);
        }
        // flow control counts the whole payload, padding too
        let n = @as(i64, @bit_cast(i64, @as(u64, p0.len)));
        self.recv_window -= n;
        if self.recv_window < 0 {
            return self.fail(FLOW_CONTROL_ERROR, error.FlowControlError);
        }
        let p = unpad(flags, p0) catch return self.fail(PROTOCOL_ERROR, error.ProtocolError);
        let known = self.has(sid);
        let mut done = false;
        if not known {
            if (((sid & 1) == 1) == self.server) and (sid > self.last_peer_stream) {
                return self.fail(PROTOCOL_ERROR, error.ProtocolError);  // an idle stream
            }
            self.reset_stream(sid, STREAM_CLOSED)!;
        } else {
            let s = self.find(sid)!;
            if s.remote_done or not s.got_headers {
                self.reset_stream(sid, STREAM_CLOSED)!;
                return sid;
            }
            s.recv_window -= n;
            if s.recv_window < 0 {
                self.reset_stream(sid, FLOW_CONTROL_ERROR)!;
                return sid;
            }
            if (s.body.len + p.len) > self.max_body {
                self.reset_stream(sid, CANCEL)!;
                return sid;
            }
            // (the streams together hold at most a little more than one
            // body: past that, a stream is refused)
            if (self.buffered + p.len) > (self.max_body + BUFFER_ALLOWANCE) {
                self.reset_stream(sid, REFUSED_STREAM)!;
                return sid;
            }
            let total = @as(i64, @bit_cast(i64, @as(u64, s.body.len + p.len)));
            if (s.content_length >= 0) and
               ((total > s.content_length) or (((flags & END_STREAM) != 0) and (total != s.content_length))) {
                self.reset_stream(sid, PROTOCOL_ERROR)!;
                return sid;
            }
            s.body.push_str(p)!;
            self.buffered += p.len;
            // give the window back at once, once half is used
            if s.recv_window < (WINDOW / 2) {
                self.window_update(sid, @truncate(u32, @bit_cast(u64, WINDOW - s.recv_window)))!;
                s.recv_window = WINDOW;
            }
            if (flags & END_STREAM) != 0 {
                s.remote_done = true;
                done = true;
            }
        }
        if self.recv_window < (WINDOW / 2) {
            self.window_update(0, @truncate(u32, @bit_cast(u64, WINDOW - self.recv_window)))!;
            self.recv_window = WINDOW;
        }
        if done {
            return sid;
        }
        return 0;
    }

    /// Sends a header block (split into CONTINUATION frames as needed).
    pub fn send_headers(self: *mut Conn, id: u32, headers: []hpack.Header, end_stream: bool) Http2Error!void {
        let mut b = strs.String.init();
        defer b.deinit();
        self.enc.encode(headers, &mut b)!;
        let bytes = b.bytes();
        let mut flags: u8 = 0;
        if end_stream {
            flags = END_STREAM;
        }
        let mut at: usize = 0;
        let mut first = true;
        loop {
            let n = @min(bytes.len - at, self.peer_max_frame);
            let last = (at + n) == bytes.len;
            let mut f = flags;
            if last {
                f |= END_HEADERS;
            }
            if first {
                self.write_frame(HEADERS, f, id, bytes[at..at + n])!;
            } else {
                self.write_frame(CONTINUATION, f & END_HEADERS, id, bytes[at..at + n])!;
            }
            first = false;
            flags = 0;
            at += n;
            if last {
                break;
            }
        }
        if end_stream {
            let s = self.find(id) catch return;
            s.local_done = true;
        }
    }

    /// Sends data, as flow control allows: while the windows are shut, it
    /// reads and handles frames until the peer opens them.
    pub fn send_data(self: *mut Conn, id: u32, data: []u8, end_stream: bool) !void {
        let mut at: usize = 0;
        loop {
            let s = self.find(id) catch return error.StreamReset;
            if s.reset {
                return error.StreamReset;
            }
            let room = @min(
                @min(s.send_window, self.send_window), @as(i64, @bit_cast(i64, @as(u64, self.peer_max_frame))));
            let left = data.len - at;
            if (left > 0) and (room <= 0) {
                // (a request completing meanwhile is kept for take_done)
                let got = self.step()!;
                if (got != 0) and (got != id) {
                    self.keep_done(got)!;
                }
                continue;
            }
            let n = @min(left, @as(usize, @truncate(usize, @bit_cast(u64, @max(room, 0)))));
            let last = (at + n) == data.len;
            let mut f: u8 = 0;
            if last and end_stream {
                f = END_STREAM;
            }
            self.write_frame(DATA, f, id, data[at..at + n])!;
            s.send_window -= @as(i64, @bit_cast(i64, @as(u64, n)));
            self.send_window -= @as(i64, @bit_cast(i64, @as(u64, n)));
            at += n;
            if last {
                if end_stream {
                    s.local_done = true;
                }
                return;
            }
        }
    }

    /// The stream with that id (StreamClosed if there is none).
    pub fn stream(self: *mut Conn, id: u32) Http2Error!*mut Stream {
        return self.find(id)!;
    }

    fn keep_done(self: *mut Conn, id: u32) Http2Error!void {
        for d in self.done.items() {
            if d == id {
                return;
            }
        }
        self.done.push(id)!;
    }

    /// A stream that completed while send_data waited (as step would have
    /// returned it), or 0.
    pub fn take_done(self: *mut Conn) u32 {
        if self.done.len == 0 {
            return 0;
        }
        return self.done.remove(0);
    }
}

// Pseudo-headers, as bits.
const PS_METHOD: u32 = 1;
const PS_SCHEME: u32 = 2;
const PS_AUTHORITY: u32 = 4;
const PS_PATH: u32 = 8;
const PS_STATUS: u32 = 16;

fn pseudo_bit(name: []u8, request: bool) u32 {
    if request {
        if strs.eq(name, ":method") {
            return PS_METHOD;
        }
        if strs.eq(name, ":scheme") {
            return PS_SCHEME;
        }
        if strs.eq(name, ":authority") {
            return PS_AUTHORITY;
        }
        if strs.eq(name, ":path") {
            return PS_PATH;
        }
    } else if strs.eq(name, ":status") {
        return PS_STATUS;
    }
    return 0;
}

// Whether a header block is well-formed (RFC 9113 8.2 and 8.3): lower-case
// token names, values without NUL, CR, LF or blanks at the ends, no
// connection-specific fields, and the pseudo-headers a request (or a
// response) needs, each once and before the other fields; none in
// trailers.
fn check_fields(hs: []hpack.Header, request: bool, trailers: bool) bool {
    let mut seen: u32 = 0;
    let mut regular = false;
    let mut connect = false;
    for x in hs {
        let v = x.value;
        for c in v {
            if (c == 0) or (c == '\r') or (c == '\n') {
                return false;
            }
        }
        if (v.len > 0) and (is_blank(v[0]) or is_blank(v[v.len - 1])) {
            return false;
        }
        if (x.name.len > 0) and (x.name[0] == ':') {
            let bit = pseudo_bit(x.name, request);
            if trailers or regular or (bit == 0) or ((seen & bit) != 0) {
                return false;
            }
            seen |= bit;
            if (bit == PS_METHOD) and strs.eq(v, "CONNECT") {
                connect = true;
            }
            if (bit == PS_PATH) and (v.len == 0) {
                return false;
            }
            continue;
        }
        regular = true;
        if x.name.len == 0 {
            return false;
        }
        for c in x.name {
            if ((c >= 'A') and (c <= 'Z')) or not is_token_char(c) {
                return false;
            }
        }
        let n = x.name;
        if strs.eq(n, "connection") or strs.eq(n, "keep-alive") or strs.eq(n, "proxy-connection") or
           strs.eq(n, "transfer-encoding") or strs.eq(n, "upgrade") or
           (strs.eq(n, "te") and not strs.eq(v, "trailers")) {
            return false;
        }
    }
    if trailers {
        return true;
    }
    if not request {
        return seen == PS_STATUS;
    }
    if connect {
        return seen == (PS_METHOD | PS_AUTHORITY);
    }
    return (seen & (PS_METHOD | PS_SCHEME | PS_PATH)) == (PS_METHOD | PS_SCHEME | PS_PATH);
}

fn is_blank(c: u8) bool {
    return (c == ' ') or (c == '\t');
}

fn is_token_char(c: u8) bool {
    if strs.is_alnum(c) {
        return true;
    }
    for s in "!#$%&'*+-.^_`|~" {
        if c == s {
            return true;
        }
    }
    return false;
}

// A request's content-length: -1 if it has none, -2 if it is not a number
// or its values differ.
fn content_length(hs: []hpack.Header) i64 {
    let mut n: i64 = -1;
    for x in hs {
        if not strs.eq(x.name, "content-length") {
            continue;
        }
        if (x.value.len == 0) or (x.value.len > 18) {
            return -2;
        }
        let mut v: i64 = 0;
        for c in x.value {
            if (c < '0') or (c > '9') {
                return -2;
            }
            v = (v * 10) + @as(i64, c - '0');
        }
        if (n >= 0) and (v != n) {
            return -2;
        }
        n = v;
    }
    return n;
}

fn unpad(flags: u8, p: []u8) Http2Error![]u8 {
    if (flags & PADDED) == 0 {
        return p;
    }
    if p.len == 0 {
        return error.ProtocolError;
    }
    let pad = @as(usize, p[0]);
    if (pad + 1) > p.len {
        return error.ProtocolError;
    }
    return p[1..p.len - pad];
}

fn put32(s: *mut strs.String, v: u32) Http2Error!void {
    let mut b: [4]u8 = [0; 4];
    binary.put_u32_be(b[..], v);
    s.push_str(b[..])!;
}

fn setting(s: *mut strs.String, id: u16, v: u32) Http2Error!void {
    s.push(@truncate(u8, id >> 8))!;
    s.push(@truncate(u8, id))!;
    put32(s, v)!;
}

// -----------------------------------------------------------------------------
// The client
// -----------------------------------------------------------------------------

/// A response: the status, the headers (without pseudo-headers) and body.
pub struct Response {
    status: u16,
    headers: []hpack.Header,
    body: []u8,
    stream: *mut Stream,
    conn: *mut Conn,

    pub fn header(self: *Response, name: []u8) []u8 {
        for h in self.headers {
            if strs.eq_ignore_case(h.name, name) {
                return h.value;
            }
        }
        return "";
    }

    pub fn deinit(self: *mut Response) void {
        self.conn.drop_stream(self.stream.id);
    }
}

pub struct Client {
    conn: Conn,
    authority: []u8,
    scheme: []u8,

    /// A client over a connection (the preface and settings are sent now).
    /// authority is the host (and port) for ":authority", scheme "https" or
    /// "http"; both must outlive the client.
    pub fn init(r: io.Reader, w: io.Writer, authority: []u8, scheme: []u8) Http2Error!Client {
        let mut c = Client.{ conn: Conn.init(r, w, false, "")!, authority: authority, scheme: scheme };
        c.conn.handshake() catch |e| {
            c.conn.deinit();
            return e;
        };
        return c;
    }

    /// Says goodbye (GOAWAY) and frees the connection's state (the
    /// connection itself is the caller's to close).
    pub fn deinit(self: *mut Client) void {
        self.conn.goaway(NO_ERROR) catch {};
        self.conn.deinit();
    }

    /// Sends a request and waits for its response (which stays valid
    /// until its deinit). Header names must be lower-case; hop-by-hop
    /// headers (Connection and the like) are not allowed in HTTP/2.
    pub fn request(self: *mut Client, method: []u8, path: []u8, headers: []hpack.Header, body: []u8) !Response {
        if self.conn.got_goaway {
            return error.GoAway;
        }
        let id = self.conn.next_stream;
        if id > 0x7ffffffd {
            return error.GoAway;
        }
        self.conn.next_stream += 2;
        let s = self.conn.open(id)!;
        let mut hs = vec.Vec.[hpack.Header].init();
        defer hs.deinit();
        hs.push(hpack.Header.{ name: ":method", value: method })!;
        hs.push(hpack.Header.{ name: ":scheme", value: self.scheme })!;
        hs.push(hpack.Header.{ name: ":authority", value: self.authority })!;
        hs.push(hpack.Header.{ name: ":path", value: path })!;
        for h in headers {
            hs.push(h)!;
        }
        self.conn.send_headers(id, hs.items(), body.len == 0)!;
        if body.len > 0 {
            self.conn.send_data(id, body, true)!;
        }
        while not s.remote_done {
            _ = self.conn.step()!;
            if self.conn.got_goaway and (id > self.conn.goaway_last) {
                self.conn.drop_stream(id);
                return error.GoAway;
            }
        }
        if s.reset {
            self.conn.drop_stream(id);
            return error.StreamReset;
        }
        let st = s.header(":status");
        let mut status: u16 = 0;
        for c in st {
            if (c < '0') or (c > '9') {
                status = 0;
                break;
            }
            status = (status * 10) + @as(u16, c - '0');
        }
        if (st.len != 3) or (status < 100) {
            self.conn.drop_stream(id);
            return error.ProtocolError;
        }
        let all = s.headers();
        let mut k: usize = 0;
        while (k < all.len) and (all[k].name.len > 0) and (all[k].name[0] == ':') {
            k += 1;
        }
        return Response.{ status: status, headers: all[k..], body: s.body.bytes(), stream: s, conn: &mut self.conn };
    }
}

// -----------------------------------------------------------------------------
// Tests: hostile frames at a server
// -----------------------------------------------------------------------------

struct Pair {
    a: net.TcpStream,  // the peer, writing the frames
    b: net.TcpStream,  // the connection under test
}

fn sread(ctx: *mut void, buf: []mut u8) Http2Error!usize {
    let t = @ptr_cast(*mut net.TcpStream, ctx);
    return t.read(buf)!;
}

fn swrite(ctx: *mut void, bytes: []u8) Http2Error!usize {
    let t = @ptr_cast(*mut net.TcpStream, ctx);
    return t.write(bytes)!;
}

fn pair(p: *mut Pair) Http2Error!void {
    let l = net.listen_addr(net.Addr.loopback(net.Family.V4, 0))!;
    defer l.close();
    p.a = net.connect_addr(l.local_addr()!)!;
    p.b = l.accept()!;
    p.b.set_timeout(300)!;
}

fn frame(out: *mut strs.String, ty: u8, flags: u8, id: u32, payload: []u8) Http2Error!void {
    out.push(@truncate(u8, payload.len >> 16))!;
    out.push(@truncate(u8, payload.len >> 8))!;
    out.push(@truncate(u8, payload.len))!;
    out.push(ty)!;
    out.push(flags)!;
    put32(out, id)!;
    out.push_str(payload)!;
}

// Runs the frames (after the preface and an empty SETTINGS) against a server
// Conn; the error its steps end with.
fn against(frames: []u8) error {
    let mut p = Pair.{ a: net.TcpStream.{ handle: -1 }, b: net.TcpStream.{ handle: -1 } };
    pair(&mut p) catch |e| return e;
    defer p.a.close();
    defer p.b.close();
    let mut all = strs.String.init();
    defer all.deinit();
    all.push_str(PREFACE) catch |e| return e;
    frame(&mut all, SETTINGS, 0, 0, "") catch |e| return e;
    all.push_str(frames) catch |e| return e;
    p.a.write_all(all.bytes()) catch |e| return e;
    let r = io.Reader.{ ctx: @ptr_cast(*mut void, &mut p.b), read_fn: sread };
    let w = io.Writer.{ ctx: @ptr_cast(*mut void, &mut p.b), write_fn: swrite };
    let mut c = Conn.init(r, w, true, "") catch |e| return e;
    defer c.deinit();
    c.handshake() catch |e| return e;
    for _k in @as(usize, 0)..32 {
        _ = c.step() catch |e| return e;
    }
    return error.Closed;
}

test "protocol errors" {
    let mut f = strs.String.init();
    defer f.deinit();
    // a frame bigger than the maximum
    let big = mem.alloc.[u8](20000)!;
    defer mem.free(big);
    @mem_set(big, 0);
    frame(&mut f, DATA, 0, 1, big)!;
    @expect(against(f.bytes()) == error.FrameSizeError);
    // CONTINUATION with no HEADERS before it
    f.clear();
    frame(&mut f, CONTINUATION, END_HEADERS, 1, "\x82")!;
    @expect(against(f.bytes()) == error.ProtocolError);
    // a window grown past 2^31 - 1
    f.clear();
    frame(&mut f, WINDOW_UPDATE, 0, 0, "\x7f\xff\xff\xff")!;
    @expect(against(f.bytes()) == error.FlowControlError);
    // SETTINGS: ENABLE_PUSH 2; a bad length; on a stream
    f.clear();
    frame(&mut f, SETTINGS, 0, 0, "\x00\x02\x00\x00\x00\x02")!;
    @expect(against(f.bytes()) == error.ProtocolError);
    f.clear();
    frame(&mut f, SETTINGS, 0, 0, "\x00\x02\x00")!;
    @expect(against(f.bytes()) == error.FrameSizeError);
    f.clear();
    frame(&mut f, SETTINGS, 0, 3, "")!;
    @expect(against(f.bytes()) == error.ProtocolError);
    // PUSH_PROMISE from a client; DATA on a stream never opened
    f.clear();
    frame(&mut f, PUSH_PROMISE, END_HEADERS, 1, "\x00\x00\x00\x02\x82")!;
    @expect(against(f.bytes()) == error.ProtocolError);
    f.clear();
    frame(&mut f, DATA, 0, 7, "x")!;
    @expect(against(f.bytes()) == error.ProtocolError);
    // a header block that does not decode
    f.clear();
    frame(&mut f, HEADERS, END_HEADERS | END_STREAM, 1, "\xff\xff\xff\xff\xff\xff\x7f")!;
    @expect(against(f.bytes()) == error.CompressionError);
    // a HEADERS frame on stream 2 (the client's are odd)
    f.clear();
    frame(&mut f, HEADERS, END_HEADERS | END_STREAM, 2, "\x82\x84\x86")!;
    @expect(against(f.bytes()) == error.ProtocolError);
    // a PING is answered, and a good request passes
    f.clear();
    frame(&mut f, PING, 0, 0, "12345678")!;
    frame(&mut f, HEADERS, END_HEADERS | END_STREAM, 1, "\x82\x84\x86\x41\x09localhost")!;
    @expect(against(f.bytes()) == error.TimedOut);
}

// -----------------------------------------------------------------------------
// Tests: requests fed to a server Conn from memory
// -----------------------------------------------------------------------------

// Header fields from "name=value|name=value".
fn fields(spec: []u8, out: *mut vec.Vec.[hpack.Header]) !void {
    out.clear();
    let mut it = strs.split(spec, "|");
    loop {
        let f = it.next() catch break;
        let eq = strs.index_of_byte(f, '=')!;
        out.push(hpack.Header.{ name: f[..eq], value: f[eq + 1..] })!;
    }
}

let GET: []u8 = ":method=GET|:scheme=https|:path=/|:authority=a";
let POST: []u8 = ":method=POST|:scheme=https|:path=/|:authority=a";

// A request on stream 1: its headers, a body (if any) and trailers (if
// any, with END_STREAM when trailers_end). Whether the server reset the
// stream; *probe gets the length of the probe header's value.
fn reset_by(spec: []u8, body: []u8, trailers: []u8, trailers_end: bool, probe: []u8, got: *mut usize) !bool {
    let mut enc = hpack.Encoder.init();
    defer enc.deinit();
    let mut hs = vec.Vec.[hpack.Header].init();
    defer hs.deinit();
    let mut b = strs.String.init();
    defer b.deinit();
    let mut d = strs.String.init();
    defer d.deinit();
    d.push_str(PREFACE)!;
    frame(&mut d, SETTINGS, 0, 0, "")!;
    fields(spec, &mut hs)!;
    enc.encode(hs.items(), &mut b)!;
    let mut f = END_HEADERS;
    if (body.len == 0) and (trailers.len == 0) {
        f |= END_STREAM;
    }
    frame(&mut d, HEADERS, f, 1, b.bytes())!;
    if body.len > 0 {
        let mut df: u8 = 0;
        if trailers.len == 0 {
            df = END_STREAM;
        }
        frame(&mut d, DATA, df, 1, body)!;
    }
    if trailers.len > 0 {
        fields(trailers, &mut hs)!;
        b.clear();
        enc.encode(hs.items(), &mut b)!;
        let mut tf = END_HEADERS;
        if trailers_end {
            tf |= END_STREAM;
        }
        frame(&mut d, HEADERS, tf, 1, b.bytes())!;
    }
    let mut rd = io.SliceReader.init("");
    let mut out = strs.String.init();
    defer out.deinit();
    let mut c = Conn.init(rd.reader(), out.writer(), true, d.bytes())!;
    defer c.deinit();
    c.handshake()!;
    loop {
        let id = c.step() catch break;  // (Closed at the end)
        if id == 1 {
            break;
        }
    }
    let s = c.stream(1)!;
    got.* = s.header(probe).len;
    return s.reset;
}

test "malformed requests reset their streams" {
    let mut n: usize = 0;
    let bad: [27][]u8 = [
        ":method=GET|:scheme=https|:path=/a b\r\nX: y|:authority=a",
        ":method=GET|:scheme=https|:path=/|:authority=a\r\nb",
        ":method=GET|:scheme=https|:path=/|:authority=a|x-evil=v\x00",
        ":method=GET|:scheme=https|:path=/|:authority=a|x-a= v",
        ":method=GET|:scheme=https|:path=/|:authority=a|x-a=v\t",
        ":method=GET|:scheme=https|:path=/|:authority=a|bad name:=z",
        ":method=GET|:scheme=https|:path=/|:authority=a|X-Upper=z",
        ":method=GET|:scheme=https|:path=/|:authority=a|=z",
        ":method=GET|:scheme=https|:path=/|:authority=a|transfer-encoding=chunked",
        ":method=GET|:scheme=https|:path=/|:authority=a|connection=close",
        ":method=GET|:scheme=https|:path=/|:authority=a|keep-alive=1",
        ":method=GET|:scheme=https|:path=/|:authority=a|proxy-connection=x",
        ":method=GET|:scheme=https|:path=/|:authority=a|upgrade=h2c",
        ":method=GET|:scheme=https|:path=/|:authority=a|te=gzip",
        ":method=GET|:scheme=https|:path=/|:authority=a|:foo=bar",
        ":method=GET|:scheme=https|:path=/|:authority=a|:status=200",
        ":method=GET|:scheme=https|:path=/|:path=/x",
        ":method=GET|:scheme=https|x-a=b|:path=/",
        ":scheme=https|:path=/|:authority=a",
        ":method=GET|:path=/|:authority=a",
        ":method=GET|:scheme=https|:authority=a",
        ":method=GET|:scheme=https|:path=|:authority=a",
        ":method=CONNECT|:authority=a:443|:path=/",
        ":method=GET|:scheme=https|:path=/|:authority=a|content-length=abc",
        ":method=GET|:scheme=https|:path=/|:authority=a|content-length=1|content-length=2",
        ":method=GET|:scheme=https|:path=/|:authority=a|content-length=1",
        ":method=GET|:scheme=https|:path=/|:authority=a|content-length=-1",
    ];
    for k in @as(usize, 0)..bad.len {
        if not reset_by(bad[k], "", "", true, "", &mut n)! {
            @expect_eq(k, 99);
        }
    }
    // a body that is not the length announced
    @expect(reset_by(":method=POST|:scheme=https|:path=/|:authority=a|content-length=5", "abc", "", true, "", &mut n)!);
    @expect(reset_by(":method=POST|:scheme=https|:path=/|:authority=a|content-length=2", "abc", "", true, "", &mut n)!);
    // trailers: with pseudo-headers, without END_STREAM
    @expect(reset_by(POST, "abc", ":path=/x", true, "", &mut n)!);
    @expect(reset_by(POST, "abc", "x-t=1", false, "", &mut n)!);
    // and what is well-formed passes (trailers are dropped)
    @expect(not reset_by(GET, "", "", true, ":path", &mut n)!);
    @expect(n == 1);
    @expect(not reset_by(":method=GET|:scheme=https|:path=/|:authority=a|te=trailers|x-a=b c", "", "", true, "x-a",
                         &mut n)!);
    @expect(n == 3);
    @expect(not reset_by(":method=CONNECT|:authority=a:443", "", "", true, "", &mut n)!);
    @expect(not reset_by(":method=POST|:scheme=https|:path=/|:authority=a|content-length=3", "abc", "x-t=1", true,
                         "x-t", &mut n)!);
    @expect(n == 0);
}

test "a connection's bodies are bounded together" {
    let max_body: usize = 262144;
    let mut enc = hpack.Encoder.init();
    defer enc.deinit();
    let mut hs = vec.Vec.[hpack.Header].init();
    defer hs.deinit();
    fields(POST, &mut hs)!;
    let mut d = strs.String.init();
    defer d.deinit();
    d.push_str(PREFACE)!;
    frame(&mut d, SETTINGS, 0, 0, "")!;
    // 50 streams each sending just under max_body, never ending
    let chunk = mem.alloc.[u8](16384)!;
    defer mem.free(chunk);
    @mem_set(chunk, 0x41);
    let mut b = strs.String.init();
    defer b.deinit();
    for k in @as(u32, 0)..50 {
        b.clear();
        enc.encode(hs.items(), &mut b)!;
        frame(&mut d, HEADERS, END_HEADERS, (2 * k) + 1, b.bytes())!;
        for _j in @as(usize, 0)..((max_body / 16384) - 1) {
            frame(&mut d, DATA, 0, (2 * k) + 1, chunk)!;
        }
    }
    let mut rd = io.SliceReader.init("");
    let mut out = strs.String.init();
    defer out.deinit();
    let mut c = Conn.init(rd.reader(), out.writer(), true, "")!;
    defer c.deinit();
    c.max_body = max_body;
    let mut src = io.SliceReader.init(d.bytes());
    c.r = src.reader();
    c.handshake()!;
    let mut refused: usize = 0;
    loop {
        let id = c.step() catch break;
        if id != 0 {
            let s = c.stream(id)!;
            @expect(s.reset);
            refused += 1;
            c.drop_stream(id);
        }
    }
    let mut held: usize = 0;
    for s in c.streams.items() {
        held += s.body.len;
    }
    @expect(held == c.buffered);
    @expect(held <= (max_body + BUFFER_ALLOWANCE));
    @expect((refused > 40) and (c.streams.len == (50 - refused)));
}

test "a deadline, and requests that complete while a response waits" {
    // PINGs do not keep a connection past its deadline
    let mut d = strs.String.init();
    defer d.deinit();
    d.push_str(PREFACE)!;
    frame(&mut d, SETTINGS, 0, 0, "")!;
    let mut pings = strs.String.init();
    defer pings.deinit();
    for _k in @as(usize, 0)..10000 {
        frame(&mut pings, PING, 0, 0, "12345678")!;
    }
    let mut rd = io.SliceReader.init(pings.bytes());
    let mut out = strs.String.init();
    defer out.deinit();
    let mut c = Conn.init(rd.reader(), out.writer(), true, d.bytes())!;
    defer c.deinit();
    c.handshake()!;
    c.deadline = 1;  // (long past)
    let mut steps: usize = 0;
    loop {
        _ = c.step() catch |e| {
            @expect(e == error.TimedOut);
            break;
        };
        steps += 1;
    }
    @expect(steps < 2000);
    // stream 3 completes while the answer to 1 waits for its window
    let mut enc = hpack.Encoder.init();
    defer enc.deinit();
    let mut hs = vec.Vec.[hpack.Header].init();
    defer hs.deinit();
    fields(GET, &mut hs)!;
    let mut b = strs.String.init();
    defer b.deinit();
    enc.encode(hs.items(), &mut b)!;
    let mut d2 = strs.String.init();
    defer d2.deinit();
    d2.push_str(PREFACE)!;
    frame(&mut d2, SETTINGS, 0, 0, "\x00\x04\x00\x00\x00\x00")!;  // INITIAL_WINDOW_SIZE 0
    frame(&mut d2, HEADERS, END_HEADERS | END_STREAM, 1, b.bytes())!;
    b.clear();
    enc.encode(hs.items(), &mut b)!;
    frame(&mut d2, HEADERS, END_HEADERS | END_STREAM, 3, b.bytes())!;
    frame(&mut d2, WINDOW_UPDATE, 0, 1, "\x00\x00\x00\x0a")!;
    let mut rd2 = io.SliceReader.init("");
    let mut out2 = strs.String.init();
    defer out2.deinit();
    let mut c2 = Conn.init(rd2.reader(), out2.writer(), true, d2.bytes())!;
    defer c2.deinit();
    c2.handshake()!;
    let mut first: u32 = 0;
    while first == 0 {
        first = c2.step()!;
    }
    @expect(first == 1);
    @expect(c2.take_done() == 0);
    c2.send_data(1, "0123456789", true)!;
    @expect(c2.take_done() == 3);
    @expect(c2.take_done() == 0);
}

test "table size settings do not pile up" {
    let mut p = strs.String.init();
    defer p.deinit();
    for k in @as(usize, 0)..2000 {
        setting(&mut p, 1, @truncate(u32, k & 1))!;
    }
    let mut d = strs.String.init();
    defer d.deinit();
    d.push_str(PREFACE)!;
    for _k in @as(usize, 0)..10 {
        frame(&mut d, SETTINGS, 0, 0, p.bytes())!;
    }
    let mut rd = io.SliceReader.init("");
    let mut out = strs.String.init();
    defer out.deinit();
    let mut c = Conn.init(rd.reader(), out.writer(), true, d.bytes())!;
    defer c.deinit();
    c.handshake()!;
    loop {
        _ = c.step() catch break;
    }
    @expect(c.enc.pending.len <= 2);
}
