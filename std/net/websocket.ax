// =============================================================================
// std/net/websocket.ax - WebSocket (RFC 6455) clients and servers.
//
//     let mut ws = websocket.connect("ws://localhost:8080/chat", http.ClientOptions.default())!;
//     defer ws.close_and_deinit();
//     ws.send_text("hello")!;
//     let m = ws.recv()!;                    // m.kind, m.data (until the next recv)
//
// A server accepts inside an http handler (std/net/http):
//
//     fn chat(app: *mut App, req: *http.Request, res: *mut http.Response) !void {
//         let mut ws = websocket.accept(req, res) catch return;   // 101, or 400 sent
//         defer ws.deinit();
//         loop {
//             let m = ws.recv() catch break;          // Closed when the peer closes
//             ws.send(m.kind, m.data)!;               // echo
//         }
//     }
//
// recv answers pings with pongs itself, joins fragmented messages, and
// checks what it is sent: masking the right way round, no reserved bits or
// opcodes (no extensions are negotiated), text in valid UTF-8, messages no
// bigger than max_message, a valid close code. A protocol error closes the
// connection with the right status code and fails with ProtocolError.
// =============================================================================

import "../crypto/random.ax" as random;
import "../crypto/sha1.ax" as sha1;
import "../encoding/base64.ax" as base64;
import "../fmt.ax" as fmt;
import "../mem.ax" as mem;
import "../net.ax" as net;
import "../str.ax" as strs;
import "../thread.ax" as thread;
import "http.ax" as http;
import "tls.ax" as tls;

error { HandshakeFailed, ProtocolError, MessageTooBig, Closed, BadUrl, NetError, TimedOut, OutOfMemory,
        InvalidArgument }

/// Message and frame kinds (the opcodes).
pub enum Opcode: u8 {
    CONTINUATION = 0,
    TEXT = 1,
    BINARY = 2,
    CLOSE = 8,
    PING = 9,
    PONG = 10,
}

/// Close codes.
pub const NORMAL: u16 = 1000;
pub const GOING_AWAY: u16 = 1001;
pub const PROTOCOL_ERROR: u16 = 1002;
pub const UNSUPPORTED: u16 = 1003;
pub const INVALID_DATA: u16 = 1007;
pub const POLICY: u16 = 1008;
pub const TOO_BIG: u16 = 1009;
pub const INTERNAL_ERROR: u16 = 1011;

let GUID: []u8 = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";

/// The Sec-WebSocket-Accept value for a key.
pub fn accept_key(key: []u8, out: []mut u8) []u8 {
    let mut both: [128]u8 = [0; 128];
    let n = @min(key.len, 128 - GUID.len);
    @mem_copy(both[..n], key[..n]);
    @mem_copy(both[n..n + GUID.len], GUID);
    let mut d: [20]u8 = [0; 20];
    sha1.sha1(both[..n + GUID.len], d[..]);
    return base64.encode(d[..], out, base64.STANDARD);
}

/// A received message: TEXT or BINARY, or CLOSE (with the peer's code).
pub struct Message {
    kind: Opcode,
    data: []u8,
    code: u16,
}

pub struct Conn {
    t: http.Transport,
    client: bool,  // mask what is sent
    rbuf: []mut u8,
    start: usize,
    end: usize,
    msg: strs.String,    // the message being received
    frame: strs.String,  // a control frame's payload
    out: strs.String,    // frames being sent
    max_message: usize,
    sent_close: bool,
    got_close: bool,
    owns_transport: bool,

    fn init(t: http.Transport, client: bool, owns: bool) !Conn {
        return Conn.{ t: t, client: client, rbuf: mem.alloc.[u8](16384)!, start: 0, end: 0, msg: strs.String.init(),
                      frame: strs.String.init(), out: strs.String.init(), max_message: 16777216, sent_close: false,
                      got_close: false, owns_transport: owns };
    }

    /// Frees the connection's buffers (and closes it, for a client).
    pub fn deinit(self: *mut Conn) void {
        mem.free(self.rbuf);
        self.msg.deinit();
        self.frame.deinit();
        self.out.deinit();
        if self.owns_transport {
            self.t.close();
        }
    }

    /// Closes politely (see close), then deinit.
    pub fn close_and_deinit(self: *mut Conn) void {
        self.close(NORMAL, "") catch {};
        self.deinit();
    }

    pub fn send_text(self: *mut Conn, s: []u8) !void {
        self.send(Opcode.TEXT, s)!;
    }

    pub fn send_binary(self: *mut Conn, b: []u8) !void {
        self.send(Opcode.BINARY, b)!;
    }

    /// Sends a message (TEXT, BINARY) or a control frame (PING, PONG).
    pub fn send(self: *mut Conn, kind: Opcode, data: []u8) !void {
        if self.sent_close {
            return error.Closed;
        }
        if ((kind == Opcode.PING) or (kind == Opcode.PONG)) and (data.len > 125) {
            return error.InvalidArgument;
        }
        if (kind == Opcode.TEXT) and not strs.valid_utf8(data) {
            return error.InvalidArgument;
        }
        self.send_frame(kind, data)!;
    }

    pub fn ping(self: *mut Conn, data: []u8) !void {
        self.send(Opcode.PING, data)!;
    }

    /// Starts the closing handshake: sends a close frame, then waits (up to
    /// a few frames) for the peer's.
    pub fn close(self: *mut Conn, code: u16, reason: []u8) !void {
        if not self.sent_close {
            let mut p: [125]u8 = [0; 125];
            p[0] = @truncate(u8, code >> 8);
            p[1] = @truncate(u8, code);
            let n = @min(reason.len, 123);
            @mem_copy(p[2..2 + n], reason[..n]);
            self.send_frame(Opcode.CLOSE, p[..2 + n])!;
            self.sent_close = true;
        }
        for _k in @as(usize, 0)..16 {
            if self.got_close {
                return;
            }
            _ = self.recv() catch return;
        }
    }

    fn send_frame(self: *mut Conn, op: Opcode, data: []u8) !void {
        self.out.clear();
        self.out.push(0x80 | @int_from_enum(op))!;
        let mut mbit: u8 = 0;
        if self.client {
            mbit = 0x80;
        }
        if data.len < 126 {
            self.out.push(mbit | @truncate(u8, data.len))!;
        } else if data.len < 65536 {
            self.out.push(mbit | 126)!;
            self.out.push(@truncate(u8, data.len >> 8))!;
            self.out.push(@truncate(u8, data.len))!;
        } else {
            self.out.push(mbit | 127)!;
            let n = @as(u64, data.len);
            let mut sh: u64 = 56;
            loop {
                self.out.push(@truncate(u8, n >> sh))!;
                if sh == 0 {
                    break;
                }
                sh -= 8;
            }
        }
        if self.client {
            let mut key: [4]u8 = [0; 4];
            random.fill(key[..]) catch {};
            self.out.push_str(key[..])!;
            let at = self.out.len;
            self.out.push_str(data)!;
            let b = self.out.bytes();
            for k in @as(usize, 0)..data.len {
                b[at + k] ^= key[k & 3];
            }
        } else {
            self.out.push_str(data)!;
        }
        self.t.write_all(self.out.bytes()) catch return error.NetError;
    }

    // at least n bytes buffered
    fn fill(self: *mut Conn, n: usize) !void {
        if (self.end - self.start) >= n {
            return;
        }
        if self.start > 0 {
            let k = self.end - self.start;
            for i in @as(usize, 0)..k {
                self.rbuf[i] = self.rbuf[self.start + i];
            }
            self.start = 0;
            self.end = k;
        }
        if n > self.rbuf.len {
            let bigger = mem.alloc.[u8](@max(n, self.rbuf.len * 2))!;
            @mem_copy(bigger[..self.end], self.rbuf[..self.end]);
            mem.free(self.rbuf);
            self.rbuf = bigger;
        }
        while self.end < n {
            let got = self.t.read(self.rbuf[self.end..]) catch |e| {
                if e == error.TimedOut {
                    return error.TimedOut;
                }
                return error.NetError;
            };
            if got == 0 {
                return error.Closed;
            }
            self.end += got;
        }
    }

    // Fails the connection: a close frame with the code, then the error.
    fn fail(self: *mut Conn, code: u16, e: error) error {
        if not self.sent_close {
            let p: [2]u8 = [@truncate(u8, code >> 8), @truncate(u8, code)];
            self.send_frame(Opcode.CLOSE, p[..]) catch {};
            self.sent_close = true;
        }
        self.got_close = true;
        return e;
    }

    /// The next message. data stays valid until the next recv. After the
    /// peer's close frame (returned once, as CLOSE), Closed.
    pub fn recv(self: *mut Conn) !Message {
        if self.got_close {
            return error.Closed;
        }
        self.msg.clear();
        let mut kind = Opcode.CONTINUATION;  // (none yet)
        loop {
            self.fill(2)!;
            let b0 = self.rbuf[self.start];
            let b1 = self.rbuf[self.start + 1];
            let fin = (b0 & 0x80) != 0;
            let op = b0 & 15;
            let masked = (b1 & 0x80) != 0;
            if (b0 & 0x70) != 0 {
                return self.fail(PROTOCOL_ERROR, error.ProtocolError);
            }
            // clients must mask, servers must not
            if masked == self.client {
                return self.fail(PROTOCOL_ERROR, error.ProtocolError);
            }
            let mut len = @as(u64, b1 & 0x7f);
            let mut hl: usize = 2;
            if len == 126 {
                self.fill(4)!;
                len = (@as(u64, self.rbuf[self.start + 2]) << 8) | @as(u64, self.rbuf[self.start + 3]);
                hl = 4;
                if len < 126 {
                    return self.fail(PROTOCOL_ERROR, error.ProtocolError);
                }
            } else if len == 127 {
                self.fill(10)!;
                len = 0;
                for k in @as(usize, 2)..10 {
                    len = (len << 8) | @as(u64, self.rbuf[self.start + k]);
                }
                hl = 10;
                if (len < 65536) or ((len >> 63) != 0) {
                    return self.fail(PROTOCOL_ERROR, error.ProtocolError);
                }
            }
            let control = op >= 8;
            if control and (not fin or (len > 125)) {
                return self.fail(PROTOCOL_ERROR, error.ProtocolError);
            }
            if not control and ((@as(u64, self.msg.len) + len) > @as(u64, self.max_message)) {
                return self.fail(TOO_BIG, error.MessageTooBig);
            }
            let mut mask: [4]u8 = [0; 4];
            if masked {
                self.fill(hl + 4)!;
                for k in @as(usize, 0)..4 {
                    mask[k] = self.rbuf[self.start + hl + k];
                }
                hl += 4;
            }
            let n = @truncate(usize, len);
            self.fill(hl + n)!;
            let payload = self.rbuf[self.start + hl..self.start + hl + n];
            if masked {
                for k in @as(usize, 0)..n {
                    payload[k] ^= mask[k & 3];
                }
            }
            self.start += hl + n;
            if control {
                if op == @int_from_enum(Opcode.PING) {
                    if not self.sent_close {
                        self.frame.clear();
                        self.frame.push_str(payload)!;
                        // (a peer that has gone will show on the next read)
                        self.send_frame(Opcode.PONG, self.frame.bytes()) catch {};
                    }
                    continue;
                }
                if op == @int_from_enum(Opcode.PONG) {
                    continue;
                }
                if op != @int_from_enum(Opcode.CLOSE) {
                    return self.fail(PROTOCOL_ERROR, error.ProtocolError);
                }
                // close: code (optional) and a UTF-8 reason
                let mut code: u16 = 1005;
                if n == 1 {
                    return self.fail(PROTOCOL_ERROR, error.ProtocolError);
                }
                if n >= 2 {
                    code = (@as(u16, payload[0]) << 8) | @as(u16, payload[1]);
                    if not valid_close_code(code) {
                        return self.fail(PROTOCOL_ERROR, error.ProtocolError);
                    }
                    if not strs.valid_utf8(payload[2..]) {
                        return self.fail(INVALID_DATA, error.ProtocolError);
                    }
                }
                self.got_close = true;
                if not self.sent_close {
                    let back: [2]u8 = [@truncate(u8, code >> 8), @truncate(u8, code)];
                    if code == 1005 {
                        self.send_frame(Opcode.CLOSE, back[..0]) catch {};
                    } else {
                        self.send_frame(Opcode.CLOSE, back[..]) catch {};
                    }
                    self.sent_close = true;
                }
                self.frame.clear();
                if n >= 2 {
                    self.frame.push_str(payload[2..])!;
                }
                return Message.{ kind: Opcode.CLOSE, data: self.frame.bytes(), code: code };
            }
            // a data frame
            if op == @int_from_enum(Opcode.CONTINUATION) {
                if kind == Opcode.CONTINUATION {
                    return self.fail(PROTOCOL_ERROR, error.ProtocolError);
                }
            } else if (op == @int_from_enum(Opcode.TEXT)) or (op == @int_from_enum(Opcode.BINARY)) {
                if kind != Opcode.CONTINUATION {
                    return self.fail(PROTOCOL_ERROR, error.ProtocolError);
                }
                kind = @enum_from_int(Opcode, op);  // (TEXT or BINARY: checked above)
            } else {
                return self.fail(PROTOCOL_ERROR, error.ProtocolError);
            }
            self.msg.push_str(payload)!;
            if fin {
                if (kind == Opcode.TEXT) and not strs.valid_utf8(self.msg.bytes()) {
                    return self.fail(INVALID_DATA, error.ProtocolError);
                }
                return Message.{ kind: kind, data: self.msg.bytes(), code: 0 };
            }
        }
    }

    /// Makes recv fail with TimedOut after ms milliseconds without data
    /// (0: wait for ever).
    pub fn set_timeout(self: *mut Conn, ms: u32) !void {
        self.t.tcp.set_timeout(ms) catch return error.NetError;
    }
}

// Codes a peer may send (RFC 6455 7.4, and the registered 1012-1014).
fn valid_close_code(c: u16) bool {
    return ((c >= 1000) and (c <= 1003)) or ((c >= 1007) and (c <= 1014)) or ((c >= 3000) and (c <= 4999));
}

/// Accepts a WebSocket handshake in an http handler: checks the request,
/// answers "101 Switching Protocols" and returns the connection, which the
/// handler uses until it returns (then the server closes it). A request
/// that is not a WebSocket handshake gets 400 and HandshakeFailed (return
/// from the handler without an error to keep the 400, which an error would
/// turn into a 500).
pub fn accept(req: *http.Request, res: *mut http.Response) !Conn {
    let upgrade = req.header("Upgrade") catch "";
    let key = req.header("Sec-WebSocket-Key") catch "";
    let version = req.header("Sec-WebSocket-Version") catch "";
    let conn = req.header("Connection") catch "";
    if not strs.eq(req.method, "GET") or not strs.eq_ignore_case(strs.trim(upgrade), "websocket") or
       not has_token(conn, "upgrade") or (key.len != 24) or not strs.eq(strs.trim(version), "13") {
        res.text(400, "a WebSocket handshake was expected\n") catch {};
        return error.HandshakeFailed;
    }
    let mut ab: [40]u8 = [0; 40];
    let acc = accept_key(key, ab[..]);
    res.header("Upgrade", "websocket")!;
    res.header("Connection", "Upgrade")!;
    res.header("Sec-WebSocket-Accept", acc)!;
    let t = res.upgrade()!;
    return Conn.init(t, false, false)!;
}

fn has_token(v: []u8, tok: []u8) bool {
    let mut parts = strs.split(v, ",");
    while true {
        let p = parts.next() catch break;
        if strs.eq_ignore_case(strs.trim(p), tok) {
            return true;
        }
    }
    return false;
}

/// Connects to a ws:// or wss:// URL.
pub fn connect(url: []u8, opts: http.ClientOptions) !Conn {
    let mut u8url = strs.String.init();
    defer u8url.deinit();
    // (as an http URL, for its parser)
    if strs.starts_with(url, "ws://") {
        u8url.push_str("http://")!;
        u8url.push_str(url[5..])!;
    } else if strs.starts_with(url, "wss://") {
        u8url.push_str("https://")!;
        u8url.push_str(url[6..])!;
    } else {
        return error.BadUrl;
    }
    let u = http.parse_url(u8url.bytes()) catch return error.BadUrl;
    let tcp = net.connect(u.hostname, u.port) catch return error.NetError;
    tcp.set_timeout(opts.timeout_ms) catch {};
    let mut t = http.Transport.plain(tcp);
    if u.secure {
        let mut cfg = opts.tls_config;
        if not opts.has_tls_config {
            cfg = http.system_tls() catch |e| {
                tcp.close();
                return e;
            };
        }
        t = http.Transport.over_tls(tls.client(tcp, u.hostname, cfg) catch return error.HandshakeFailed);
    }
    let mut c = Conn.init(t, true, true) catch |e| {
        t.close();
        return e;
    };
    handshake(&mut c, u) catch |e| {
        c.deinit();
        return e;
    };
    // (no timeout on messages, unless set)
    tcp.set_timeout(0) catch {};
    return c;
}

fn handshake(c: *mut Conn, u: http.Url) !void {
    let mut kb: [16]u8 = [0; 16];
    random.fill(kb[..]) catch {};
    let mut key: [24]u8 = [0; 24];
    let k = base64.encode(kb[..], key[..], base64.STANDARD);
    let mut h = strs.String.init();
    defer h.deinit();
    let w = h.writer();
    fmt.write(w, "GET {} HTTP/1.1\r\nHost: {}", [fmt.str(u.target), fmt.str(u.hostname)])!;
    if ((u.port != 80) and not u.secure) or ((u.port != 443) and u.secure) {
        fmt.write(w, ":{}", [fmt.int(u.port)])!;
    }
    fmt.write(w,
              "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {}\r\nSec-WebSocket-Version: 13\r\n\r\n",
              [fmt.str(k)])!;
    c.t.write_all(h.bytes()) catch return error.NetError;
    // the response head (frames may follow it in the same read)
    let mut head_end: usize = 0;
    loop {
        let have = c.rbuf[..c.end];
        let at = strs.index_of(have, "\r\n\r\n") catch {
            if c.end >= 16384 {
                return error.HandshakeFailed;
            }
            c.fill(c.end + 1)!;
            continue;
        };
        head_end = at + 4;
        break;
    }
    let head = c.rbuf[..head_end];
    let nl = strs.index_of_byte(head, '\n')!;
    if not strs.starts_with(head, "HTTP/1.1 101") {
        return error.HandshakeFailed;
    }
    let mut hs: [64]http.Header = [http.Header.{ name: "", value: "" }; 64];
    let n = http.parse_headers(head[nl + 1..head_end - 2], hs[..]) catch return error.HandshakeFailed;
    let mut ab: [40]u8 = [0; 40];
    let want = accept_key(k, ab[..]);
    let got = http.find_header(hs[..n], "Sec-WebSocket-Accept") catch return error.HandshakeFailed;
    let up = http.find_header(hs[..n], "Upgrade") catch "";
    if not strs.eq(strs.trim(got), want) or not strs.eq_ignore_case(strs.trim(up), "websocket") {
        return error.HandshakeFailed;
    }
    c.start = head_end;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

// a Conn reading from bytes given in advance (writes go nowhere useful)
/// A connection (a client's if `client`) that receives exactly `frames` and
/// then the peer's close, over a loopback socket: for tests and the fuzzer.
pub fn from_bytes(frames: []u8, client: bool) !Conn {
    let bytes = frames;
    let l = net.listen_addr(net.Addr.loopback(net.Family.V4, 0))!;
    defer l.close();
    let a = net.connect_addr(l.local_addr()!)!;
    let b = l.accept()!;
    a.write_all(bytes)!;
    a.close();
    return Conn.init(http.Transport.plain(b), client, true)!;
}

test "the RFC's examples" {
    let mut ab: [40]u8 = [0; 40];
    @expect_eq(accept_key("dGhlIHNhbXBsZSBub25jZQ==", ab[..]), "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=");
    // a single-frame unmasked text message, as a client receives it
    let mut c = from_bytes("\x81\x05\x48\x65\x6c\x6c\x6f", true)!;
    let m = c.recv()!;
    @expect((m.kind == Opcode.TEXT) and strs.eq(m.data, "Hello"));
    c.deinit();
    // masked, as a server receives it; and a fragmented one
    let mut s = from_bytes("\x81\x85\x37\xfa\x21\x3d\x7f\x9f\x4d\x51\x58", false)!;
    @expect_eq(s.recv()!.data, "Hello");
    s.deinit();
    let mut f = from_bytes("\x01\x03\x48\x65\x6c\x89\x00\x80\x02\x6c\x6f", true)!;
    let fm = f.recv()!;
    @expect((fm.kind == Opcode.TEXT) and strs.eq(fm.data, "Hello"));
    f.deinit();
}

test "protocol errors" {
    // (as a server: unmasked frames, reserved bits, a bad opcode, a split
    // control frame, invalid UTF-8, a bad close code, a continuation first)
    let bad: [7][]u8 = ["\x81\x02hi", "\xc1\x80\x00\x00\x00\x00", "\x83\x80\x00\x00\x00\x00",
                        "\x09\x80\x00\x00\x00\x00", "\x81\x82\x00\x00\x00\x00\xc3\x28",
                        "\x88\x82\x00\x00\x00\x00\x03\xed", "\x80\x80\x00\x00\x00\x00"];
    for b in bad {
        let mut c = from_bytes(b, false)!;
        @expect(protocol_error(c.recv()));
        @expect(closed(c.recv()));
        c.deinit();
    }
    let mut big = from_bytes("\x82\xfe\x04\x00\x00\x00\x00\x00", false)!;
    big.max_message = 1000;
    @expect(too_big(big.recv()));
    big.deinit();
}

fn protocol_error(r: !Message) bool {
    _ = r catch |e| return e == error.ProtocolError;
    return false;
}

fn closed(r: !Message) bool {
    _ = r catch |e| return e == error.Closed;
    return false;
}

fn too_big(r: !Message) bool {
    _ = r catch |e| return e == error.MessageTooBig;
    return false;
}

struct App {
    served: u32,
}

fn echo(app: *mut App, req: *http.Request, res: *mut http.Response) !void {
    let mut ws = accept(req, res) catch return;  // (keeping the 400)
    defer ws.deinit();
    _ = @atomic_add(&mut app.served, 1);
    loop {
        let m = ws.recv() catch break;
        if m.kind == Opcode.CLOSE {
            break;
        }
        ws.send(m.kind, m.data)!;
    }
}

fn run_server(s: *mut http.Server.[App]) void {
    s.run() catch {};
}

test "a client and a server" {
    let mut app = App.{ served: 0 };
    let mut srv = http.server("127.0.0.1", 0, echo, &mut app, http.Options.default())!;
    let t = thread.spawn(run_server, &mut srv)!;
    let mut url = strs.String.init();
    defer url.deinit();
    fmt.write(url.writer(), "ws://127.0.0.1:{}/echo", [fmt.int(srv.port())])!;
    let mut ws = connect(url.bytes(), http.ClientOptions.default())!;
    ws.send_text("héllo")!;
    let m = ws.recv()!;
    @expect((m.kind == Opcode.TEXT) and strs.eq(m.data, "héllo"));
    // a big binary message (a 64-bit length), and a ping on the way
    let big = mem.alloc.[u8](70000)!;
    defer mem.free(big);
    for k in @as(usize, 0)..big.len {
        big[k] = @truncate(u8, k * 7);
    }
    ws.ping("are you there")!;
    ws.send_binary(big)!;
    let b = ws.recv()!;
    @expect((b.kind == Opcode.BINARY) and @mem_eq(b.data, big));
    ws.close(NORMAL, "bye")!;
    @expect(closed(ws.recv()));
    ws.deinit();
    // a plain request to the handler is refused
    let mut plain = strs.String.init();
    defer plain.deinit();
    fmt.write(plain.writer(), "http://127.0.0.1:{}/echo", [fmt.int(srv.port())])!;
    let mut r = http.get(plain.bytes())!;
    @expect(r.status == 400);
    r.deinit();
    @expect(fails(connect("http://x/", http.ClientOptions.default()), error.BadUrl));
    srv.stop();
    t.join();
    @expect(app.served == 1);
}

fn fails(r: !Conn, want: error) bool {
    let mut c = r catch |e| return e == want;
    c.deinit();
    return false;
}
