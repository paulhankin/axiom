fn serve_once_with(cfg: *ServerConfig, port_out: *mut u16) !TestServer {
    let ts = TestServer.{ listener: net.listen("127.0.0.1", 0)!, cfg: cfg, failures: 0 };
    port_out.* = ts.listener.port();
    return ts;
}

fn key_update_fails(c: *mut Conn) bool {
    c.key_update() catch return true;
    return false;
}

fn exchange_12(port: u16, ccfg: *ClientConfig) !void {
    let c = connect("localhost", port, ccfg)!;
    defer c.close();
    @expect_eq(c.version(), VERSION_1_2);
    @expect(c.suite.v12);
    c.write_all("hello")!;
    let mut buf: [8]u8 = [0; 8];
    c.reader().read_exact(buf[..5])!;
    @expect_eq(buf[..5], "hello");
    let big = mem.alloc.[u8](70000)!;
    defer mem.free(big);
    for i in 0..big.len {
        big[i] = @truncate(u8, i * 13);
    }
    c.write_all(big)!;
    let back = mem.alloc.[u8](70000)!;
    defer mem.free(back);
    c.reader().read_exact(back)!;
    @expect(@mem_eq(back, big));
    @expect(key_update_fails(c));
}

test "TLS 1.2" {
    let protos: [2][]u8 = ["h2", "http/1.1"];
    for kind in @as(u32, 0)..2 {
        let mut cert = join(TEST_CERT[..])!;
        let mut key = join(TEST_KEY[..])!;
        if kind == 1 {
            mem.free(cert);
            mem.free(key);
            cert = join(TEST_RSA_CERT[..])!;
            key = join(TEST_RSA_KEY[..])!;
        }
        defer mem.free(cert);
        defer mem.free(key);
        let mut scfg = ServerConfig.from_pem(cert, key)!;
        defer scfg.deinit();
        scfg.alpn = protos[1..];
        let mut port: u16 = 0;
        let mut ts = serve_once_with(&scfg, &mut port)!;
        let th = thread.spawn(test_serve, &mut ts)!;
        let mut ccfg = ClientConfig.with_roots_pem(cert)!;
        defer ccfg.deinit();
        ccfg.max_version = VERSION_1_2;
        ccfg.alpn = protos[..];
        exchange_12(port, &ccfg)!;
        let c = connect("localhost", port, &ccfg)!;
        @expect_eq(c.protocol(), "http/1.1");
        c.close();
        // by default the same pair speaks 1.3
        ccfg.max_version = VERSION_1_3;
        let c3 = connect("localhost", port, &ccfg)!;
        @expect_eq(c3.version(), VERSION_1_3);
        c3.close();
        // a 1.3-only client and a 1.2-only one meet a server that wants 1.3
        scfg.min_version = VERSION_1_3;
        ccfg.max_version = VERSION_1_2;
        @expect(fails(connect("localhost", port, &ccfg)));
        scfg.min_version = VERSION_1_2;
        ccfg.max_version = VERSION_1_3;
        ccfg.min_version = VERSION_1_3;
        let c4 = connect("localhost", port, &ccfg)!;
        @expect_eq(c4.version(), VERSION_1_3);
        c4.close();
        // the wrong name is still refused over 1.2
        ccfg.min_version = VERSION_1_2;
        ccfg.max_version = VERSION_1_2;
        let s5 = net.connect("127.0.0.1", port)!;
        @expect(fails(client(s5, "other.test", &ccfg)));
        ts.listener.close();
        th.join();
        @expect_eq(ts.failures, 2);
    }
}

test "TLS 1.2 PRF" {
    // the TLS 1.2 PRF test vector for SHA-256 (from the IETF TLS mailing
    // list, used by Go and others)
    let secret: [16]u8 = [0x9b, 0xbe, 0x43, 0x6b, 0xa9, 0x40, 0xf0, 0x17, 0xb1, 0x76, 0x52, 0x84, 0x9a, 0x71, 0xdb,
                          0x35];
    let seed: [16]u8 = [0xa0, 0xba, 0x9f, 0x93, 0x6c, 0xda, 0x31, 0x18, 0x27, 0xa6, 0xf7, 0x96, 0xff, 0xd5, 0x19, 0x8c];
    let mut o: [100]u8 = [0; 100];
    prf12(sha2.Algorithm.SHA256, secret[..], "test label", seed[..], o[..]);
    let want: [16]u8 = [0xe3, 0xf2, 0x29, 0xba, 0x72, 0x7b, 0xe1, 0x7b, 0x8d, 0x12, 0x26, 0x20, 0x55, 0x7c, 0xd4, 0x53];
    @expect_eq(o[..16], want[..]);
    let tail: [4]u8 = [0x87, 0x34, 0x7b, 0x66];  // (computed with Python's hmac)
    @expect_eq(o[96..], tail[..]);
}
