// -----------------------------------------------------------------------------
// Reading and writing message fields
// -----------------------------------------------------------------------------

/// A cursor over received bytes; every read fails with DecodeError when
/// the data runs out.
struct Cur {
    b: []u8,
    i: usize,

    fn get8(self: *mut Cur) !u8 {
        if self.i >= self.b.len {
            return error.DecodeError;
        }
        self.i += 1;
        return self.b[self.i - 1];
    }

    fn get16(self: *mut Cur) !u16 {
        let hi = self.get8()!;
        let lo = self.get8()!;
        return (@as(u16, hi) << 8) | @as(u16, lo);
    }

    fn get24(self: *mut Cur) !usize {
        let a = self.get8()!;
        let b = self.get16()!;
        return (@as(usize, a) << 16) | @as(usize, b);
    }

    fn bytes(self: *mut Cur, n: usize) ![]u8 {
        if n > (self.b.len - self.i) {
            return error.DecodeError;
        }
        self.i += n;
        return self.b[self.i - n..self.i];
    }

    fn vec8(self: *mut Cur) ![]u8 {
        let n = @as(usize, self.get8()!);
        return self.bytes(n);
    }

    fn vec16(self: *mut Cur) ![]u8 {
        let n = @as(usize, self.get16()!);
        return self.bytes(n);
    }

    fn vec24(self: *mut Cur) ![]u8 {
        let n = self.get24()!;
        return self.bytes(n);
    }

    fn done(self: *Cur) bool {
        return self.i >= self.b.len;
    }
}

fn cur(b: []u8) Cur {
    return Cur.{ b: b, i: 0 };
}

/// Appends big-endian integers and length-prefixed vectors.
struct Out {
    s: strs.String,

    fn put8(self: *mut Out, v: u8) !void {
        self.s.push(v)!;
    }

    fn put16(self: *mut Out, v: u16) !void {
        self.s.push(@truncate(u8, v >> 8))!;
        self.s.push(@truncate(u8, v))!;
    }

    fn put24(self: *mut Out, v: usize) !void {
        self.s.push(@truncate(u8, v >> 16))!;
        self.s.push(@truncate(u8, v >> 8))!;
        self.s.push(@truncate(u8, v))!;
    }

    fn put(self: *mut Out, b: []u8) !void {
        self.s.push_str(b)!;
    }

    /// Starts a vector with an n-byte length; finish it with close.
    fn open(self: *mut Out, n: usize) !usize {
        let at = self.s.len;
        for i in 0..n {
            self.s.push(0)!;
        }
        return at;
    }

    fn close(self: *mut Out, at: usize, n: usize) void {
        let len = (self.s.len - at) - n;
        let b = self.s.bytes();
        for i in 0..n {
            b[at + i] = @truncate(u8, len >> @truncate(u32, 8 * ((n - 1) - i)));
        }
    }

    fn bytes(self: *Out) []u8 {
        return self.s.bytes();
    }
}

fn out() Out {
    return Out.{ s: strs.String.init() };
}

// -----------------------------------------------------------------------------
// Cipher suites, keys and the key schedule
// -----------------------------------------------------------------------------

struct Suite {
    id: u16,
    hash: sha2.Algorithm,  // SHA256 or SHA384
    key_len: usize,
    v12: bool,    // a TLS 1.2 suite
    ecdsa: bool,  // (TLS 1.2) the certificate's key: ECDSA or Ed25519, else RSA
}

fn suite_of(id: u16) !Suite {
    let mut s = Suite.{ id: id, hash: sha2.Algorithm.SHA256, key_len: 32, v12: false, ecdsa: false };
    if id == TLS_CHACHA20_POLY1305_SHA256 {
        return s;
    }
    if id == TLS_AES_128_GCM_SHA256 {
        s.key_len = 16;
        return s;
    }
    if id == TLS_AES_256_GCM_SHA384 {
        s.hash = sha2.Algorithm.SHA384;
        return s;
    }
    s.v12 = true;
    s.ecdsa = (id == ECDHE_ECDSA_CHACHA20_POLY1305) or (id == ECDHE_ECDSA_AES_128_GCM_SHA256) or
              (id == ECDHE_ECDSA_AES_256_GCM_SHA384);
    if (id == ECDHE_ECDSA_CHACHA20_POLY1305) or (id == ECDHE_RSA_CHACHA20_POLY1305) {
        return s;
    }
    if (id == ECDHE_ECDSA_AES_128_GCM_SHA256) or (id == ECDHE_RSA_AES_128_GCM_SHA256) {
        s.key_len = 16;
        return s;
    }
    if (id == ECDHE_ECDSA_AES_256_GCM_SHA384) or (id == ECDHE_RSA_AES_256_GCM_SHA384) {
        s.hash = sha2.Algorithm.SHA384;
        return s;
    }
    return error.HandshakeFailure;
}

fn is_chacha(id: u16) bool {
    return (id == TLS_CHACHA20_POLY1305_SHA256) or (id == ECDHE_ECDSA_CHACHA20_POLY1305) or
           (id == ECDHE_RSA_CHACHA20_POLY1305);
}

/// The TLS 1.2 PRF (RFC 5246 5): P_hash(secret, label || seed).
fn prf12(hash: sha2.Algorithm, secret: []u8, label: []u8, seed: []u8, out_buf: []mut u8) void {
    let hl = sha2.digest_size(hash);
    let mut ls: [160]u8 = [0; 160];  // label || seed
    @mem_copy(ls[..label.len], label);
    @mem_copy(ls[label.len..label.len + seed.len], seed);
    let lsn = label.len + seed.len;
    let mut a: [64]u8 = [0; 64];  // A(i)
    hmac.hmac(hash, secret, ls[..lsn], a[..hl]);
    let mut buf: [224]u8 = [0; 224];  // A(i) || label || seed
    let mut block: [64]u8 = [0; 64];
    let mut done: usize = 0;
    while done < out_buf.len {
        @mem_copy(buf[..hl], a[..hl]);
        @mem_copy(buf[hl..hl + lsn], ls[..lsn]);
        hmac.hmac(hash, secret, buf[..hl + lsn], block[..hl]);
        let n = @min(hl, out_buf.len - done);
        @mem_copy(out_buf[done..done + n], block[..n]);
        done += n;
        let prev = a;
        hmac.hmac(hash, secret, prev[..hl], a[..hl]);
    }
}

/// HKDF-Expand-Label (RFC 8446 7.1).
fn expand_label(hash: sha2.Algorithm, secret: []u8, label: []u8, context: []u8, out_buf: []mut u8) void {
    let mut info: [300]u8 = [0; 300];
    let n = out_buf.len;
    info[0] = @truncate(u8, n >> 8);
    info[1] = @truncate(u8, n);
    info[2] = @truncate(u8, 6 + label.len);
    @mem_copy(info[3..9], "tls13 ");
    @mem_copy(info[9..9 + label.len], label);
    let at = 9 + label.len;
    info[at] = @truncate(u8, context.len);
    @mem_copy(info[at + 1..(at + 1) + context.len], context);
    hmac.expand(hash, secret, info[..(at + 1) + context.len], out_buf);
}

/// One direction's record protection.
struct Cipher {
    suite: u16,
    active: bool,
    key: [32]u8,
    iv: [12]u8,
    seq: u64,
    gcm: aes_gcm.AesGcm,

    fn none() Cipher {
        return Cipher.{ suite: 0, active: false, key: [0; 32], iv: [0; 12], seq: 0,
                        gcm: aes_gcm.AesGcm.init("0123456789abcdef") catch @trap() };
    }

    /// Keys from a traffic secret.
    fn set(self: *mut Cipher, s: Suite, secret: []u8) !void {
        self.suite = s.id;
        self.active = true;
        self.seq = 0;
        @mem_set(self.key[..], 0);
        expand_label(s.hash, secret, "key", "", self.key[..s.key_len]);
        expand_label(s.hash, secret, "iv", "", self.iv[..]);
        if not is_chacha(s.id) {
            self.gcm = aes_gcm.AesGcm.init(self.key[..s.key_len])!;
        }
    }

    /// TLS 1.2 keys: the write key and IV (a 4-byte salt for AES-GCM, 12
    /// bytes for ChaCha20-Poly1305).
    fn set12(self: *mut Cipher, s: Suite, key: []u8, iv: []u8) !void {
        self.suite = s.id;
        self.active = true;
        self.seq = 0;
        @mem_set(self.key[..], 0);
        @mem_copy(self.key[..key.len], key);
        @mem_set(self.iv[..], 0);
        @mem_copy(self.iv[..iv.len], iv);
        if not is_chacha(s.id) {
            self.gcm = aes_gcm.AesGcm.init(key)!;
        }
    }

    // seq_num || type || version || length (RFC 5246 6.2.3.3)
    fn aad12(self: *Cipher, ty: u8, len: usize, out_buf: []mut u8) void {
        for i in @as(usize, 0)..8 {
            out_buf[i] = @truncate(u8, self.seq >> @truncate(u32, 56 - (8 * i)));
        }
        out_buf[8] = ty;
        out_buf[9] = 3;
        out_buf[10] = 3;
        out_buf[11] = @truncate(u8, len >> 8);
        out_buf[12] = @truncate(u8, len);
    }

    /// Seals a TLS 1.2 record's content into sealed: the explicit nonce
    /// (the sequence number), ciphertext and tag for AES-GCM, ciphertext
    /// and tag for ChaCha20-Poly1305 (RFC 7905). Returns the length.
    fn seal12(self: *mut Cipher, ty: u8, plain: []u8, sealed: []mut u8) !usize {
        let mut aad: [13]u8 = [0; 13];
        self.aad12(ty, plain.len, aad[..]);
        let mut n: [12]u8 = [0; 12];
        if is_chacha(self.suite) {
            self.nonce(n[..]);
            chacha.seal(self.key[..], n[..], aad[..], plain, sealed[..plain.len + 16])!;
            self.seq += 1;
            return plain.len + 16;
        }
        @mem_copy(n[..4], self.iv[..4]);
        @mem_copy(n[4..12], aad[..8]);
        @mem_copy(sealed[..8], aad[..8]);
        self.gcm.seal(n[..], aad[..], plain, sealed[8..(8 + plain.len) + 16])!;
        self.seq += 1;
        return plain.len + 24;
    }

    /// Opens a TLS 1.2 record's fragment into plain; returns its length.
    fn open12(self: *mut Cipher, ty: u8, body: []u8, plain: []mut u8) !usize {
        let mut overhead: usize = 24;
        if is_chacha(self.suite) {
            overhead = 16;
        }
        if body.len < overhead {
            return error.BadRecordMac;
        }
        let len = body.len - overhead;
        let mut aad: [13]u8 = [0; 13];
        self.aad12(ty, len, aad[..]);
        let mut n: [12]u8 = [0; 12];
        if is_chacha(self.suite) {
            self.nonce(n[..]);
            chacha.open(self.key[..], n[..], aad[..], body, plain[..len]) catch return error.BadRecordMac;
        } else {
            @mem_copy(n[..4], self.iv[..4]);
            @mem_copy(n[4..12], body[..8]);
            self.gcm.open(n[..], aad[..], body[8..], plain[..len]) catch return error.BadRecordMac;
        }
        self.seq += 1;
        return len;
    }

    fn nonce(self: *Cipher, out_buf: []mut u8) void {
        @mem_copy(out_buf[..12], self.iv[..]);
        for i in @as(usize, 0)..8 {
            out_buf[11 - i] ^= @truncate(u8, self.seq >> @truncate(u32, 8 * i));
        }
    }

    fn seal(self: *mut Cipher, aad: []u8, plain: []u8, sealed: []mut u8) !void {
        let mut n: [12]u8 = [0; 12];
        self.nonce(n[..]);
        if is_chacha(self.suite) {
            chacha.seal(self.key[..], n[..], aad, plain, sealed)!;
        } else {
            self.gcm.seal(n[..], aad, plain, sealed)!;
        }
        self.seq += 1;
    }

    fn open(self: *mut Cipher, aad: []u8, sealed: []u8, plain: []mut u8) !void {
        let mut n: [12]u8 = [0; 12];
        self.nonce(n[..]);
        if is_chacha(self.suite) {
            chacha.open(self.key[..], n[..], aad, sealed, plain) catch return error.BadRecordMac;
        } else {
            self.gcm.open(n[..], aad, sealed, plain) catch return error.BadRecordMac;
        }
        self.seq += 1;
    }
}

/// The running transcript hash, over the ClientHello (and anything before
/// the suite is known) and every handshake message after it.
struct Transcript {
    started: bool,
    pending: strs.String,  // messages seen before the hash was chosen
    h: sha2.Hasher,

    fn init() Transcript {
        return Transcript.{ started: false, pending: strs.String.init(), h: sha2.Hasher.init(sha2.Algorithm.SHA256) };
    }

    fn deinit(self: *mut Transcript) void {
        self.pending.deinit();
    }

    fn add(self: *mut Transcript, msg: []u8) !void {
        if self.started {
            self.h.update(msg);
        } else {
            self.pending.push_str(msg)!;
        }
    }

    fn start(self: *mut Transcript, hash: sha2.Algorithm) void {
        self.h = sha2.Hasher.init(hash);
        self.h.update(self.pending.bytes());
        self.started = true;
    }

    /// The hash of everything so far (the running hash continues).
    fn current(self: *Transcript, out_buf: []mut u8) []u8 {
        let mut copy = self.h;
        copy.final(out_buf);
        return out_buf[..self.h.size()];
    }
}

// -----------------------------------------------------------------------------
// Configuration
// -----------------------------------------------------------------------------

/// Settings for clients.
pub struct ClientConfig {
    roots: x509.CertPool,
    verify: bool,      // check the server's certificate (keep this on)
    alpn: [][]u8,      // protocols to offer, e.g. ["h2", "http/1.1"]
    min_version: u16,  // VERSION_1_2 (the default) or VERSION_1_3
    max_version: u16,  // VERSION_1_3 (the default) or VERSION_1_2

    /// Trusts the operating system's root certificates.
    pub fn system() !ClientConfig {
        let mut c = ClientConfig.{ roots: x509.CertPool.init(), verify: true, alpn: no_protocols(),
                                   min_version: VERSION_1_2, max_version: VERSION_1_3 };
        _ = c.roots.load_system() catch |e| {
            c.roots.deinit();
            return e;
        };
        return c;
    }

    /// Trusts the certificates of a PEM text only.
    pub fn with_roots_pem(pem: []u8) !ClientConfig {
        let mut c = ClientConfig.{ roots: x509.CertPool.init(), verify: true, alpn: no_protocols(),
                                   min_version: VERSION_1_2, max_version: VERSION_1_3 };
        _ = c.roots.add_pem(pem) catch |e| {
            c.roots.deinit();
            return e;
        };
        return c;
    }

    /// Accepts any server certificate: for testing only, as it allows
    /// anyone in the middle to read and change the traffic.
    pub fn insecure() ClientConfig {
        return ClientConfig.{ roots: x509.CertPool.init(), verify: false, alpn: no_protocols(),
                              min_version: VERSION_1_2, max_version: VERSION_1_3 };
    }

    pub fn deinit(self: *mut ClientConfig) void {
        self.roots.deinit();
    }
}

fn no_protocols() [][]u8 {
    return @slice_from_ptr(@ptr_from_int(*[]u8, 8), 0);
}

/// Settings for servers: the certificate chain (leaf first) and its key.
pub struct ServerConfig {
    chain: vec.Vec.[[]mut u8],  // DER certificates
    key: x509.PrivateKey,
    key_kind: x509.KeyKind,
    alpn: [][]u8,      // protocols accepted, in order of preference
    min_version: u16,  // VERSION_1_2 (the default): TLS 1.2 clients are served too; or VERSION_1_3

    /// From PEM texts: the certificates (leaf first) and the private key.
    pub fn from_pem(cert_pem: []u8, key_pem: []u8) !ServerConfig {
        let mut chain = vec.Vec.[[]mut u8].init();
        let mut it = x509.pem_blocks(cert_pem);
        loop {
            let b = it.next() catch break;
            if @mem_eq(b.label, "CERTIFICATE") {
                let d = x509.pem_decode(b) catch |e| {
                    free_chain(&mut chain);
                    return e;
                };
                chain.push(d) catch |e| {
                    mem.free(d);
                    free_chain(&mut chain);
                    return e;
                };
            }
        }
        if chain.len == 0 {
            free_chain(&mut chain);
            return error.NoCertificate;
        }
        let key = x509.parse_private_key_pem(key_pem) catch |e| {
            free_chain(&mut chain);
            return e;
        };
        let mut kind = x509.KeyKind.UNSUPPORTED;
        match key {
            .Rsa(k)     => { kind = x509.KeyKind.RSA; }
            .P256(k)    => { kind = x509.KeyKind.P256; }
            .P384(k)    => { kind = x509.KeyKind.P384; }
            .Ed25519(k) => { kind = x509.KeyKind.ED25519; }
        }
        return ServerConfig.{ chain: chain, key: key, key_kind: kind, alpn: no_protocols(), min_version: VERSION_1_2 };
    }

    pub fn deinit(self: *mut ServerConfig) void {
        free_chain(&mut self.chain);
        self.key.deinit();
    }
}

fn free_chain(c: *mut vec.Vec.[[]mut u8]) void {
    for d in c.items() {
        mem.free(d);
    }
    c.deinit();
}

// -----------------------------------------------------------------------------
// Connections
// -----------------------------------------------------------------------------

pub struct Conn {
    stream: net.TcpStream,
    is_client: bool,
    suite: Suite,
    rd: Cipher,
    wr: Cipher,
    // records received: raw bytes in inbuf[..inlen]
    inbuf: [16645]u8,
    inlen: usize,
    // the plaintext of the last record
    plain: [16645]u8,
    plain_start: usize,
    plain_end: usize,
    plain_type: u8,
    // handshake bytes not yet made into messages
    hs: strs.String,
    hs_start: usize,
    // application data received and not yet read
    app_start: usize,
    app_end: usize,
    closed_read: bool,
    closed_write: bool,
    secret_rd: [48]u8,  // the current traffic secrets, for KeyUpdate
    secret_wr: [48]u8,
    alpn_selected: [32]u8,
    alpn_len: usize,
    sni: [256]u8,  // the server name (client: requested; server: received)
    sni_len: usize,
    established: bool,  // the handshake is over
    deadline: i64,      // monotonic ns by which the handshake must be done (0: none)
    v12: bool,          // TLS 1.2 records
    rd_next: Cipher,    // (TLS 1.2) the read keys a ChangeCipherSpec switches to
    ccs_expected: bool,

    /// The protocol version in use: VERSION_1_3 or VERSION_1_2.
    pub fn version(self: *Conn) u16 {
        if self.v12 {
            return VERSION_1_2;
        }
        return VERSION_1_3;
    }

    /// Reads decrypted application data; 0 means the peer closed the
    /// connection (with close_notify).
    pub fn read(self: *mut Conn, buf: []mut u8) !usize {
        loop {
            if self.app_start < self.app_end {
                let n = @min(buf.len, self.app_end - self.app_start);
                @mem_copy(buf[..n], self.plain[self.app_start..self.app_start + n]);
                self.app_start += n;
                return n;
            }
            if self.closed_read {
                return 0;
            }
            let ty = self.read_record() catch |e| {
                if (e == error.Closed) and self.closed_read {
                    return 0;  // close_notify
                }
                return e;
            };
            if ty == CT_APPLICATION_DATA {
                self.app_start = self.plain_start;
                self.app_end = self.plain_end;
            } else if ty == CT_HANDSHAKE {
                self.post_handshake()!;
            } else {
                return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
            }
        }
    }

    /// Encrypts and sends bytes (in records of at most 16 KiB).
    pub fn write(self: *mut Conn, bytes: []u8) !usize {
        if self.closed_write {
            return error.Closed;
        }
        let n = @min(bytes.len, MAX_PLAINTEXT);
        self.send_record(CT_APPLICATION_DATA, bytes[..n])!;
        return n;
    }

    pub fn write_all(self: *mut Conn, bytes: []u8) !void {
        let mut rest = bytes;
        while rest.len > 0 {
            let n = self.write(rest)!;
            rest = rest[n..];
        }
    }

    pub fn reader(self: *mut Conn) io.Reader {
        return io.Reader.{ ctx: @ptr_cast(*mut void, self), read_fn: conn_read };
    }

    pub fn writer(self: *mut Conn) io.Writer {
        return io.Writer.{ ctx: @ptr_cast(*mut void, self), write_fn: conn_write };
    }

    /// The protocol chosen by ALPN ("" if none).
    pub fn protocol(self: *Conn) []u8 {
        return self.alpn_selected[..self.alpn_len];
    }

    /// The server name: the one the client asked for (SNI).
    pub fn server_name(self: *Conn) []u8 {
        return self.sni[..self.sni_len];
    }

    /// Sends close_notify, closes the socket and frees the connection.
    pub fn close(self: *mut Conn) void {
        if not self.closed_write {
            let a: [2]u8 = [1, ALERT_CLOSE_NOTIFY];
            self.send_record(CT_ALERT, a[..]) catch {};
            self.closed_write = true;
        }
        self.stream.close();
        self.hs.deinit();
        mem.destroy(self);
    }

    // --- records -------------------------------------------------------------

    /// Sends one record, encrypted once keys are set.
    fn send_record(self: *mut Conn, ty: u8, data: []u8) !void {
        let mut rec: [16645]u8 = [0; 16645];
        if not self.wr.active {
            rec[0] = ty;
            rec[1] = 3;
            rec[2] = 3;
            rec[3] = @truncate(u8, data.len >> 8);
            rec[4] = @truncate(u8, data.len);
            @mem_copy(rec[5..5 + data.len], data);
            self.stream.write_all(rec[..5 + data.len])!;
            return;
        }
        if self.v12 {
            let clen = self.wr.seal12(ty, data, rec[5..])!;
            rec[0] = ty;
            rec[1] = 3;
            rec[2] = 3;
            rec[3] = @truncate(u8, clen >> 8);
            rec[4] = @truncate(u8, clen);
            self.stream.write_all(rec[..5 + clen])!;
            return;
        }
        // TLSInnerPlaintext: content || type, sealed
        let mut inner: [16385]u8 = [0; 16385];
        @mem_copy(inner[..data.len], data);
        inner[data.len] = ty;
        let clen = (data.len + 1) + 16;
        rec[0] = CT_APPLICATION_DATA;
        rec[1] = 3;
        rec[2] = 3;
        rec[3] = @truncate(u8, clen >> 8);
        rec[4] = @truncate(u8, clen);
        let hdr: [5]u8 = [rec[0], rec[1], rec[2], rec[3], rec[4]];
        self.wr.seal(hdr[..], inner[..data.len + 1], rec[5..5 + clen])!;
        self.stream.write_all(rec[..5 + clen])!;
    }

    /// Reads bytes until inbuf holds at least n.
    fn fill(self: *mut Conn, n: usize) !void {
        while self.inlen < n {
            // (a peer dripping a byte at a time must not hold a handshake open)
            if (self.deadline != 0) and (time.Instant.now().ns > self.deadline) {
                return error.TimedOut;
            }
            let got = self.stream.read(self.inbuf[self.inlen..])!;
            if got == 0 {
                return error.Closed;
            }
            self.inlen += got;
        }
    }

    /// Reads the next record (skipping ChangeCipherSpec) into plain; returns
    /// its content type. Alerts end the connection here.
    fn read_record(self: *mut Conn) !u8 {
        loop {
            self.fill(5)!;
            let ty = self.inbuf[0];
            let len = (@as(usize, self.inbuf[3]) << 8) | @as(usize, self.inbuf[4]);
            // not TLS at all (plain HTTP, say): say so now rather than wait
            // for a body that isn't coming
            if (ty < CT_CHANGE_CIPHER_SPEC) or (ty > CT_APPLICATION_DATA) or (self.inbuf[1] != 3) {
                return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
            }
            if len > MAX_CIPHERTEXT {
                return self.fail(ALERT_DECODE_ERROR, error.RecordOverflow);
            }
            self.fill(5 + len)!;
            let hdr: [5]u8 = [self.inbuf[0], self.inbuf[1], self.inbuf[2], self.inbuf[3], self.inbuf[4]];
            let body = self.inbuf[5..5 + len];
            let mut real_type = ty;
            let mut plen: usize = 0;
            if (ty == CT_CHANGE_CIPHER_SPEC) and self.v12 {
                // TLS 1.2: the peer's keys change here, between whole
                // handshake messages
                if not self.ccs_expected or (len != 1) or (body[0] != 1) or (self.hs_start != self.hs.len) {
                    return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
                }
                self.ccs_expected = false;
                self.rd = self.rd_next;
                self.consume(5 + len);
                continue;
            }
            if ty == CT_CHANGE_CIPHER_SPEC {
                // compatibility mode: a single 0x01, dropped, and only during
                // the handshake (RFC 8446 5)
                if self.established or (len != 1) or (body[0] != 1) {
                    return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
                }
                self.consume(5 + len);
                continue;
            }
            if self.rd.active and self.v12 {
                let opened = self.rd.open12(ty, body, self.plain[..]);
                self.consume(5 + len);
                plen = opened catch |e| {
                    return self.fail(ALERT_BAD_RECORD_MAC, e);
                };
                if plen > MAX_PLAINTEXT {
                    return self.fail(ALERT_RECORD_OVERFLOW, error.RecordOverflow);
                }
            } else if self.rd.active {
                if (ty != CT_APPLICATION_DATA) or (len < 17) {
                    return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
                }
                let n = len - 16;
                let open_result = self.rd.open(hdr[..], body, self.plain[..n]);
                self.consume(5 + len);
                open_result catch |e| {
                    return self.fail(ALERT_BAD_RECORD_MAC, e);
                };
                // strip the zero padding; the last non-zero byte is the type
                let mut k = n;
                while (k > 0) and (self.plain[k - 1] == 0) {
                    k -= 1;
                }
                if k == 0 {
                    return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
                }
                real_type = self.plain[k - 1];
                plen = k - 1;
                if plen > MAX_PLAINTEXT {
                    return self.fail(ALERT_RECORD_OVERFLOW, error.RecordOverflow);
                }
            } else {
                if len > MAX_PLAINTEXT {
                    return self.fail(ALERT_DECODE_ERROR, error.RecordOverflow);
                }
                @mem_copy(self.plain[..len], body);
                plen = len;
                self.consume(5 + len);
            }
            self.plain_start = 0;
            self.plain_end = plen;
            self.plain_type = real_type;
            if real_type == CT_ALERT {
                if plen < 2 {
                    return error.DecodeError;
                }
                if self.plain[1] == ALERT_CLOSE_NOTIFY {
                    self.closed_read = true;
                    return error.Closed;
                }
                self.closed_read = true;
                self.closed_write = true;
                return error.AlertReceived;
            }
            if (plen == 0) and (real_type != CT_APPLICATION_DATA) {
                return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
            }
            return real_type;
        }
    }

    fn consume(self: *mut Conn, n: usize) void {
        let rest = self.inlen - n;
        if rest > 0 {
            @mem_copy(self.inbuf[..rest], self.inbuf[n..self.inlen]);
        }
        self.inlen = rest;
    }

    /// Sends a fatal alert (best effort) and returns e.
    fn fail(self: *mut Conn, alert: u8, e: error) error { if not self.closed_write {
        let a: [2]u8 = [2, alert];
        self.send_record(CT_ALERT, a[..]) catch {};
        self.closed_write = true;
    }
    return e; }

    // --- handshake messages --------------------------------------------------

    /// The next handshake message (header included), reading records as
    /// needed. The slice is valid until the next call.
    fn next_message(self: *mut Conn) ![]u8 {
        loop {
            let avail = self.hs.len - self.hs_start;
            if avail >= 4 {
                let b = self.hs.bytes()[self.hs_start..];
                let len = ((@as(usize, b[1]) << 16) | (@as(usize, b[2]) << 8)) | @as(usize, b[3]);
                if len > 65536 {
                    return self.fail(ALERT_DECODE_ERROR, error.DecodeError);
                }
                if avail >= (4 + len) {
                    let msg = b[..4 + len];
                    self.hs_start += 4 + len;
                    return msg;
                }
            }
            if self.hs_start == self.hs.len {
                self.hs.clear();
                self.hs_start = 0;
            }
            let ty = self.read_record()!;
            if ty != CT_HANDSHAKE {
                return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
            }
            self.hs.push_str(self.plain[self.plain_start..self.plain_end])!;
        }
    }

    /// The next message, which must have the given type.
    fn expect_message(self: *mut Conn, ty: u8) ![]u8 {
        let m = self.next_message()!;
        if m[0] != ty {
            return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
        }
        return m;
    }

    fn send_handshake(self: *mut Conn, msg: []u8) !void {
        let mut rest = msg;
        while rest.len > 0 {
            let n = @min(rest.len, MAX_PLAINTEXT);
            self.send_record(CT_HANDSHAKE, rest[..n])!;
            rest = rest[n..];
        }
    }

    /// Handshake messages after the handshake: tickets and key updates.
    fn post_handshake(self: *mut Conn) !void {
        self.hs.push_str(self.plain[self.plain_start..self.plain_end])!;
        loop {
            let avail = self.hs.len - self.hs_start;
            if avail < 4 {
                break;
            }
            let b = self.hs.bytes()[self.hs_start..];
            let len = ((@as(usize, b[1]) << 16) | (@as(usize, b[2]) << 8)) | @as(usize, b[3]);
            if len > 65536 {
                return self.fail(ALERT_DECODE_ERROR, error.DecodeError);
            }
            if avail < (4 + len) {
                break;
            }
            let ty = b[0];
            let body = b[4..4 + len];
            self.hs_start += 4 + len;
            if self.v12 {
                if (ty == HS_HELLO_REQUEST) and self.is_client and (len == 0) {
                    // a server asking to renegotiate: refused with a
                    // warning, and the connection goes on
                    let a: [2]u8 = [1, ALERT_NO_RENEGOTIATION];
                    self.send_record(CT_ALERT, a[..])!;
                    continue;
                }
                return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
            }
            if (ty == HS_NEW_SESSION_TICKET) and self.is_client {
                continue;  // no resumption (and only servers send tickets)
            }
            if ty == HS_KEY_UPDATE {
                if (len != 1) or (body[0] > 1) {
                    return self.fail(ALERT_DECODE_ERROR, error.DecodeError);
                }
                // the key changes here: nothing more may share its record
                if self.hs_start != self.hs.len {
                    return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
                }
                let requested = body[0] == 1;
                self.update_read_key()!;
                if requested {
                    let msg: [5]u8 = [HS_KEY_UPDATE, 0, 0, 1, 0];
                    self.send_record(CT_HANDSHAKE, msg[..])!;
                    self.update_write_key()!;
                }
                continue;
            }
            return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
        }
        // keep only the unfinished message (the buffer cannot grow without bound)
        let rest = self.hs.len - self.hs_start;
        if (self.hs_start > 0) and (rest > 0) {
            let bytes = self.hs.bytes();
            @mem_copy(bytes[..rest], bytes[self.hs_start..self.hs.len]);
        }
        self.hs.truncate(rest);
        self.hs_start = 0;
    }

    /// Switches to new read keys during the handshake: handshake messages
    /// must not straddle the change (RFC 8446 5.1).
    fn handshake_read_key(self: *mut Conn, secret: []u8) !void {
        if self.hs_start != self.hs.len {
            return self.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
        }
        self.rd.set(self.suite, secret)!;
    }

    fn update_read_key(self: *mut Conn) !void {
        let n = sha2.digest_size(self.suite.hash);
        let mut next: [48]u8 = [0; 48];
        expand_label(self.suite.hash, self.secret_rd[..n], "traffic upd", "", next[..n]);
        self.secret_rd = next;
        self.rd.set(self.suite, self.secret_rd[..n])!;
    }

    fn update_write_key(self: *mut Conn) !void {
        let n = sha2.digest_size(self.suite.hash);
        let mut next: [48]u8 = [0; 48];
        expand_label(self.suite.hash, self.secret_wr[..n], "traffic upd", "", next[..n]);
        self.secret_wr = next;
        self.wr.set(self.suite, self.secret_wr[..n])!;
    }

    /// Asks the peer to update its keys too (and updates ours).
    pub fn key_update(self: *mut Conn) !void {
        if self.v12 {
            return error.Unsupported;  // a TLS 1.3 message
        }
        let msg: [5]u8 = [HS_KEY_UPDATE, 0, 0, 1, 1];
        self.send_record(CT_HANDSHAKE, msg[..])!;
        self.update_write_key()!;
    }
}

fn conn_read(ctx: *mut void, buf: []mut u8) !usize {
    let c = @ptr_cast(*mut Conn, ctx);
    return c.read(buf);
}

fn conn_write(ctx: *mut void, bytes: []u8) !usize {
    let c = @ptr_cast(*mut Conn, ctx);
    return c.write(bytes);
}

fn new_conn(stream: net.TcpStream, is_client: bool) !*mut Conn {
    // most fields are buffers: start from zeros
    let p = mem.new_zeroed.[Conn]()!;
    p.stream = stream;
    p.is_client = is_client;
    p.suite = Suite.{ id: 0, hash: sha2.Algorithm.SHA256, key_len: 0, v12: false, ecdsa: false };
    p.rd = Cipher.none();
    p.wr = Cipher.none();
    p.rd_next = Cipher.none();
    p.hs = strs.String.init();
    return p;
}

// -----------------------------------------------------------------------------
// Key exchange
// -----------------------------------------------------------------------------

/// Our key pairs for the offered groups.
struct Shares {
    x25519: curve25519.X25519Keypair,
    p256: ec.P256,
    p256_pub: [65]u8,
}

fn make_shares() !Shares {
    let mut s = Shares.{ x25519: curve25519.x25519_keypair()!, p256: ec.P256.generate()!, p256_pub: [0; 65] };
    s.p256.public_key(s.p256_pub[..]);
    return s;
}

/// The shared secret with the peer's share in `group`.
fn agree(s: *Shares, group: u16, peer: []u8, out_buf: []mut u8) ![]u8 {
    if group == GROUP_X25519 {
        if peer.len != 32 {
            return error.IllegalParameter;
        }
        curve25519.x25519(s.x25519.secret[..], peer, out_buf[..32]) catch return error.IllegalParameter;
        return out_buf[..32];
    }
    if group == GROUP_P256 {
        s.p256.ecdh(peer, out_buf[..32]) catch return error.IllegalParameter;
        return out_buf[..32];
    }
    return error.IllegalParameter;
}

// -----------------------------------------------------------------------------
// Signatures on the handshake
// -----------------------------------------------------------------------------

/// The content a CertificateVerify signs: 64 spaces, a context string, 0,
/// then the transcript hash.
fn verify_content(is_server: bool, th: []u8, out_buf: []mut u8) []u8 {
    @mem_set(out_buf[..64], ' ');
    let mut ctx: []u8 = "TLS 1.3, client CertificateVerify";
    if is_server {
        ctx = "TLS 1.3, server CertificateVerify";
    }
    @mem_copy(out_buf[64..64 + ctx.len], ctx);
    out_buf[64 + ctx.len] = 0;
    @mem_copy(out_buf[65 + ctx.len..(65 + ctx.len) + th.len], th);
    return out_buf[..(65 + ctx.len) + th.len];
}

/// Checks a CertificateVerify signature with the leaf certificate's key.
fn check_signature(key: *x509.PublicKey, scheme: u16, content: []u8, sig: []u8) bool {
    match scheme {
        0x0807 => { return key.verify(x509.SigAlg.ED25519, sha2.Algorithm.SHA256, content, sig); }
        0x0403 => {
            return (key.kind == x509.KeyKind.P256) and
                   key.verify(x509.SigAlg.ECDSA, sha2.Algorithm.SHA256, content, sig);
        }
        0x0503 => {
            return (key.kind == x509.KeyKind.P384) and
                   key.verify(x509.SigAlg.ECDSA, sha2.Algorithm.SHA384, content, sig);
        }
        0x0804 => { return key.verify(x509.SigAlg.RSA_PSS, sha2.Algorithm.SHA256, content, sig); }
        0x0805 => { return key.verify(x509.SigAlg.RSA_PSS, sha2.Algorithm.SHA384, content, sig); }
        0x0806 => { return key.verify(x509.SigAlg.RSA_PSS, sha2.Algorithm.SHA512, content, sig); }
        else   => { return false; }
    }
}

/// DER encoding of an ECDSA signature from r || s.
fn ecdsa_der(rs: []u8, out_buf: []mut u8) []u8 {
    let half = rs.len / 2;
    let mut o: usize = 2;
    for part in @as(usize, 0)..2 {
        let mut v = rs[part * half..(part + 1) * half];
        while (v.len > 1) and (v[0] == 0) {
            v = v[1..];
        }
        let pad = (v[0] & 0x80) != 0;
        out_buf[o] = 0x02;
        out_buf[o + 1] = @truncate(u8, v.len + @as(usize, if_u8(pad)));
        o += 2;
        if pad {
            out_buf[o] = 0;
            o += 1;
        }
        @mem_copy(out_buf[o..o + v.len], v);
        o += v.len;
    }
    out_buf[0] = 0x30;
    out_buf[1] = @truncate(u8, o - 2);
    return out_buf[..o];
}

fn if_u8(b: bool) u8 {
    if b {
        return 1;
    }
    return 0;
}

/// Signs content with the server key; returns the scheme and signature.
fn sign_content(cfg: *ServerConfig, schemes: []u8, content: []u8, sig: []mut u8, scheme: *mut u16) ![]u8 {
    match cfg.key {
        .Ed25519(k) => {
            if not scheme_offered(schemes, SIG_ED25519) {
                return error.HandshakeFailure;
            }
            k.sign(content, sig[..64]);
            scheme.* = SIG_ED25519;
            return sig[..64];
        }
        .P256(k) => {
            if not scheme_offered(schemes, SIG_ECDSA_P256_SHA256) {
                return error.HandshakeFailure;
            }
            let mut d: [32]u8 = [0; 32];
            sha2.sha256(content, d[..]);
            let mut rs: [64]u8 = [0; 64];
            k.sign(d[..], rs[..])!;
            scheme.* = SIG_ECDSA_P256_SHA256;
            return ecdsa_der(rs[..], sig);
        }
        .P384(k) => {
            if not scheme_offered(schemes, SIG_ECDSA_P384_SHA384) {
                return error.HandshakeFailure;
            }
            let mut d: [48]u8 = [0; 48];
            sha2.sha384(content, d[..]);
            let mut rs: [96]u8 = [0; 96];
            k.sign(d[..], rs[..])!;
            scheme.* = SIG_ECDSA_P384_SHA384;
            return ecdsa_der(rs[..], sig);
        }
        .Rsa(k) => {
            if not scheme_offered(schemes, SIG_RSA_PSS_SHA256) {
                return error.HandshakeFailure;
            }
            let mut d: [32]u8 = [0; 32];
            sha2.sha256(content, d[..]);
            let n = k.public.size;
            k.sign_pss(sha2.Algorithm.SHA256, d[..], sig[..n])!;
            scheme.* = SIG_RSA_PSS_SHA256;
            return sig[..n];
        }
    }
}

fn scheme_offered(list: []u8, id: u16) bool {
    let mut i: usize = 0;
    while (i + 1) < list.len {
        if ((@as(u16, list[i]) << 8) | @as(u16, list[i + 1])) == id {
            return true;
        }
        i += 2;
    }
    return false;
}

// -----------------------------------------------------------------------------
// The client
// -----------------------------------------------------------------------------

/// Connects to hostname:port and performs the handshake.
pub fn connect(hostname: []u8, port: u16, cfg: *ClientConfig) !*mut Conn {
    let s = net.connect(hostname, port)!;
    return client(s, hostname, cfg);
}

/// Runs the client handshake over a connected stream. hostname is sent as
/// SNI (unless it is an IP address) and checked against the certificate.
/// The stream belongs to the Conn afterwards (on failure too).
pub fn client(stream: net.TcpStream, hostname: []u8, cfg: *ClientConfig) !*mut Conn {
    // (longer than any DNS name; and with no name, the certificate could
    // belong to anyone: verification needs one)
    if (hostname.len > 255) or ((hostname.len == 0) and cfg.verify) {
        stream.close();
        return error.InvalidArgument;
    }
    let c = new_conn(stream, true)!;
    let n = hostname.len;
    @mem_copy(c.sni[..n], hostname[..n]);
    c.sni_len = n;
    c.deadline = time.Instant.now().ns + (HANDSHAKE_TIMEOUT_MS * 1000000);
    client_handshake(c, cfg) catch |e| {
        stream.close();
        c.hs.deinit();
        mem.destroy(c);
        return e;
    };
    c.deadline = 0;
    return c;
}

fn is_ip(sni: []u8) bool {
    _ = net.parse_ipv4(sni) catch return false;
    return true;
}

fn client_hello(c: *mut Conn, cfg: *ClientConfig, shares: *Shares, random_bytes: []u8, session_id: []u8,
                only_group: u16, cookie: []u8) !Out {
    let mut o = out();
    o.put8(HS_CLIENT_HELLO)!;
    let body = o.open(3)!;
    o.put16(0x0303)!;
    o.put(random_bytes)!;
    o.put8(32)!;
    o.put(session_id)!;
    let v13 = cfg.max_version >= VERSION_1_3;
    let v12 = cfg.min_version <= VERSION_1_2;
    let cs = o.open(2)!;
    if v13 {
        o.put16(TLS_CHACHA20_POLY1305_SHA256)!;
        o.put16(TLS_AES_128_GCM_SHA256)!;
        o.put16(TLS_AES_256_GCM_SHA384)!;
    }
    if v12 {
        let suites12: [6]u16 = [ECDHE_ECDSA_CHACHA20_POLY1305, ECDHE_RSA_CHACHA20_POLY1305,
                                ECDHE_ECDSA_AES_128_GCM_SHA256, ECDHE_RSA_AES_128_GCM_SHA256,
                                ECDHE_ECDSA_AES_256_GCM_SHA384, ECDHE_RSA_AES_256_GCM_SHA384];
        for x in suites12 {
            o.put16(x)!;
        }
    }
    o.close(cs, 2);
    o.put8(1)!;
    o.put8(0)!;
    let exts = o.open(2)!;
    let sni = c.sni[..c.sni_len];
    if (sni.len > 0) and not is_ip(sni) {
        o.put16(EXT_SERVER_NAME)!;
        let e = o.open(2)!;
        let l = o.open(2)!;
        o.put8(0)!;
        o.put16(@truncate(u16, sni.len))!;
        o.put(sni)!;
        o.close(l, 2);
        o.close(e, 2);
    }
    if v13 {
        o.put16(EXT_SUPPORTED_VERSIONS)!;
        let sv = o.open(2)!;
        let svl = o.open(1)!;
        o.put16(VERSION_1_3)!;
        if v12 {
            o.put16(VERSION_1_2)!;
        }
        o.close(svl, 1);
        o.close(sv, 2);
    }
    o.put16(EXT_SUPPORTED_GROUPS)!;
    let sg = o.open(2)!;
    let sgl = o.open(2)!;
    o.put16(GROUP_X25519)!;
    o.put16(GROUP_P256)!;
    if v12 and (only_group == 0) {
        o.put16(GROUP_P384)!;  // for TLS 1.2 ECDHE (a 1.3 share is never P-384)
    }
    o.close(sgl, 2);
    o.close(sg, 2);
    if v12 {
        o.put16(EXT_EC_POINT_FORMATS)!;
        o.put16(2)!;
        o.put8(1)!;
        o.put8(0)!;  // uncompressed
        o.put16(EXT_EXTENDED_MASTER_SECRET)!;
        o.put16(0)!;
        o.put16(EXT_RENEGOTIATION_INFO)!;
        o.put16(1)!;
        o.put8(0)!;  // an initial handshake
    }
    o.put16(EXT_SIGNATURE_ALGORITHMS)!;
    let sa = o.open(2)!;
    let sl = o.open(2)!;
    let schemes: [9]u16 = [SIG_ED25519, SIG_ECDSA_P256_SHA256, SIG_ECDSA_P384_SHA384, SIG_RSA_PSS_SHA256,
                           SIG_RSA_PSS_SHA384, SIG_RSA_PSS_SHA512, SIG_RSA_PKCS1_SHA256, SIG_RSA_PKCS1_SHA384,
                           SIG_RSA_PKCS1_SHA512];
    for sc in schemes {
        o.put16(sc)!;
    }
    o.close(sl, 2);
    o.close(sa, 2);
    if v13 {
        o.put16(EXT_KEY_SHARE)!;
        let ks = o.open(2)!;
        let kl = o.open(2)!;
        if (only_group == 0) or (only_group == GROUP_X25519) {
            o.put16(GROUP_X25519)!;
            o.put16(32)!;
            o.put(shares.x25519.public[..])!;
        }
        if (only_group == 0) or (only_group == GROUP_P256) {
            o.put16(GROUP_P256)!;
            o.put16(65)!;
            o.put(shares.p256_pub[..])!;
        }
        o.close(kl, 2);
        o.close(ks, 2);
    }
    if cookie.len > 0 {
        o.put16(EXT_COOKIE)!;
        let ck = o.open(2)!;
        o.put(cookie)!;
        o.close(ck, 2);
    }
    if cfg.alpn.len > 0 {
        o.put16(EXT_ALPN)!;
        let a = o.open(2)!;
        let al = o.open(2)!;
        for p in cfg.alpn {
            o.put8(@truncate(u8, p.len))!;
            o.put(p)!;
        }
        o.close(al, 2);
        o.close(a, 2);
    }
    o.close(exts, 2);
    o.close(body, 3);
    return o;
}

/// The fields of a ServerHello (or HelloRetryRequest).
struct ServerHello {
    hrr: bool,
    suite: u16,
    version: u16,  // from supported_versions (0: none, TLS 1.2)
    group: u16,
    share: []u8,
    cookie: []u8,
    session_id: []u8,
    random: []u8,
    ems: bool,        // (TLS 1.2) extended_master_secret
    has_reneg: bool,  // (TLS 1.2) renegotiation_info, and whether it is empty
    reneg_ok: bool,
    alpn: []u8,  // (TLS 1.2) the ALPN extension's data
}

fn parse_server_hello(msg: []u8) !ServerHello {
    let mut r = cur(msg[4..]);
    let mut sh = ServerHello.{ hrr: false, suite: 0, version: 0, group: 0, share: "", cookie: "", session_id: "",
                               random: "", ems: false, has_reneg: false, reneg_ok: false, alpn: "" };
    if r.get16()! != 0x0303 {
        return error.ProtocolVersion;
    }
    let rnd = r.bytes(32)!;
    sh.random = rnd;
    sh.hrr = @mem_eq(rnd, HRR_RANDOM[..]);
    sh.session_id = r.vec8()!;
    sh.suite = r.get16()!;
    if r.get8()! != 0 {
        return error.IllegalParameter;
    }
    let mut e = cur(r.vec16()!);
    while not e.done() {
        let ty = e.get16()!;
        let mut d = cur(e.vec16()!);
        if ty == EXT_SUPPORTED_VERSIONS {
            sh.version = d.get16()!;
        } else if ty == EXT_KEY_SHARE {
            sh.group = d.get16()!;
            if not sh.hrr {
                sh.share = d.vec16()!;
            }
        } else if ty == EXT_COOKIE {
            sh.cookie = d.vec16()!;
        } else if ty == EXT_EXTENDED_MASTER_SECRET {
            sh.ems = true;
        } else if ty == EXT_RENEGOTIATION_INFO {
            sh.has_reneg = true;
            let ri = d.vec8()!;
            sh.reneg_ok = (ri.len == 0) and d.done();
        } else if ty == EXT_ALPN {
            sh.alpn = d.b;
        }
    }
    return sh;
}

fn client_handshake(c: *mut Conn, cfg: *ClientConfig) !void {
    let mut shares = make_shares()!;
    let mut rnd: [32]u8 = [0; 32];
    let mut sid: [32]u8 = [0; 32];
    random.fill(rnd[..])!;
    random.fill(sid[..])!;
    let mut tr = Transcript.init();
    defer tr.deinit();
    let mut ch = client_hello(c, cfg, &shares, rnd[..], sid[..], 0, "")!;
    tr.add(ch.bytes())!;
    c.send_handshake(ch.bytes())!;
    ch.s.deinit();
    let mut msg = c.expect_message(HS_SERVER_HELLO)!;
    let mut sh = parse_server_hello(msg)!;
    if (sh.version == 0) and not sh.hrr {
        // TLS 1.2
        if cfg.min_version > VERSION_1_2 {
            return c.fail(ALERT_PROTOCOL_VERSION, error.ProtocolVersion);
        }
        if (cfg.max_version >= VERSION_1_3) and @mem_eq(sh.random[24..], DOWNGRADE_12[..]) {
            // a server that speaks 1.3 answered with 1.2: someone in the
            // middle removed 1.3 from our hello (RFC 8446 4.1.3)
            return c.fail(ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);
        }
        if @mem_eq(sh.session_id, sid[..]) {
            // resuming a session we never had
            return c.fail(ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);
        }
        return client_handshake12(c, cfg, &mut tr, msg, sh, rnd[..]);
    }
    if (cfg.max_version < VERSION_1_3) or not @mem_eq(sh.session_id, sid[..]) {
        return c.fail(ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);  // must echo ours
    }
    if sh.hrr {
        // HelloRetryRequest: the transcript restarts from a hash of the
        // first ClientHello, and a second ClientHello carries the one share
        // the server asked for
        if (sh.version != 0x0304) or ((sh.group != GROUP_X25519) and (sh.group != GROUP_P256)) {
            return c.fail(ALERT_ILLEGAL_PARAMETER, error.HandshakeFailure);
        }
        let s = suite_of(sh.suite) catch return c.fail(ALERT_HANDSHAKE_FAILURE, error.HandshakeFailure);
        let mut h1: [48]u8 = [0; 48];
        sha2.hash(s.hash, tr.pending.bytes(), h1[..]);
        let hl = sha2.digest_size(s.hash);
        tr.pending.clear();
        let hdr: [4]u8 = [HS_MESSAGE_HASH, 0, 0, @truncate(u8, hl)];
        tr.add(hdr[..])!;
        tr.add(h1[..hl])!;
        tr.add(msg)!;
        let mut cookie = strs.String.init();
        defer cookie.deinit();
        cookie.push_str(sh.cookie)!;
        let mut ch2 = client_hello(c, cfg, &shares, rnd[..], sid[..], sh.group, cookie.bytes())!;
        tr.add(ch2.bytes())!;
        c.send_handshake(ch2.bytes())!;
        ch2.s.deinit();
        msg = c.expect_message(HS_SERVER_HELLO)!;
        let hrr_suite = sh.suite;
        let hrr_group = sh.group;
        sh = parse_server_hello(msg)!;
        if sh.hrr {
            return c.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
        }
        // the ServerHello must keep what the retry chose
        if (sh.suite != hrr_suite) or (sh.group != hrr_group) or not @mem_eq(sh.session_id, sid[..]) {
            return c.fail(ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);
        }
    }
    if sh.version != 0x0304 {
        return c.fail(ALERT_PROTOCOL_VERSION, error.ProtocolVersion);
    }
    c.suite = suite_of(sh.suite) catch return c.fail(ALERT_ILLEGAL_PARAMETER, error.HandshakeFailure);
    tr.add(msg)!;
    tr.start(c.suite.hash);
    let hash = c.suite.hash;
    let hl = sha2.digest_size(hash);
    // the handshake secrets
    let mut shared_buf: [48]u8 = [0; 48];
    let shared = agree(&shares, sh.group, sh.share, shared_buf[..]) catch return c.fail(
        ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);
    let mut ks = KeySchedule.init(hash);
    let mut th: [48]u8 = [0; 48];
    ks.handshake(shared, tr.current(th[..]));
    c.handshake_read_key(ks.server_hs[..hl])!;
    // encrypted handshake messages
    let ee = c.expect_message(HS_ENCRYPTED_EXTENSIONS)!;
    tr.add(ee)!;
    read_encrypted_extensions(c, ee, cfg.alpn)!;
    let mut next = c.next_message()!;
    let mut cert_requested = false;
    if next[0] == HS_CERTIFICATE_REQUEST {
        cert_requested = true;
        tr.add(next)!;
        next = c.next_message()!;
    }
    if next[0] != HS_CERTIFICATE {
        return c.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
    }
    tr.add(next)!;
    let mut chain = parse_certificates(c, next)!;
    defer free_certs(&mut chain);
    if chain.len == 0 {
        return c.fail(ALERT_DECODE_ERROR, error.BadCertificate);
    }
    if cfg.verify {
        let mut roots = cfg.roots;
        x509.verify_chain(chain.items(), &roots, c.sni[..c.sni_len], time.now()) catch |e| {
            return c.fail(ALERT_BAD_CERTIFICATE, e);
        };
    }
    let cv = c.expect_message(HS_CERTIFICATE_VERIFY)!;
    let mut cvr = cur(cv[4..]);
    let scheme = cvr.get16()!;
    let sig = cvr.vec16()!;
    let mut content_buf: [200]u8 = [0; 200];
    let content = verify_content(true, tr.current(th[..]), content_buf[..]);
    if not check_signature(&chain.get_ptr(0).key, scheme, content, sig) {
        return c.fail(ALERT_DECRYPT_ERROR, error.BadCertificate);
    }
    tr.add(cv)!;
    let fin = c.expect_message(HS_FINISHED)!;
    let mut want: [48]u8 = [0; 48];
    finished_mac(hash, ks.server_hs[..hl], tr.current(th[..]), want[..hl]);
    if (fin.len != (4 + hl)) or not subtle.equal(fin[4..], want[..hl]) {
        return c.fail(ALERT_DECRYPT_ERROR, error.HandshakeFailure);
    }
    tr.add(fin)!;
    // application secrets from the transcript through the server Finished
    ks.application(tr.current(th[..]));
    // compatibility: a ChangeCipherSpec before our encrypted messages
    let ccs: [1]u8 = [1];
    c.send_record(CT_CHANGE_CIPHER_SPEC, ccs[..])!;
    c.wr.set(c.suite, ks.client_hs[..hl])!;
    if cert_requested {
        // an empty Certificate (with an empty request context)
        let empty: [8]u8 = [HS_CERTIFICATE, 0, 0, 4, 0, 0, 0, 0];
        tr.add(empty[..])!;
        c.send_handshake(empty[..])!;
    }
    let mut mine: [52]u8 = [0; 52];
    mine[0] = HS_FINISHED;
    mine[3] = @truncate(u8, hl);
    finished_mac(hash, ks.client_hs[..hl], tr.current(th[..]), mine[4..4 + hl]);
    c.send_handshake(mine[..4 + hl])!;
    c.handshake_read_key(ks.server_ap[..hl])!;
    c.wr.set(c.suite, ks.client_ap[..hl])!;
    c.established = true;
    @mem_copy(c.secret_rd[..hl], ks.server_ap[..hl]);
    @mem_copy(c.secret_wr[..hl], ks.client_ap[..hl]);
}

fn read_encrypted_extensions(c: *mut Conn, ee: []u8, offered: [][]u8) !void {
    let mut r = cur(ee[4..]);
    let mut e = cur(r.vec16()!);
    while not e.done() {
        let ty = e.get16()!;
        let data = e.vec16()!;
        if ty == EXT_ALPN {
            accept_alpn(c, data, offered)!;
        }
    }
}

// The server's ALPN choice (an extension's data): one of ours.
fn accept_alpn(c: *mut Conn, data: []u8, offered: [][]u8) !void {
    let mut a = cur(data);
    let mut l = cur(a.vec16()!);
    let p = l.vec8()!;
    if (p.len == 0) or (p.len > 32) {
        return c.fail(ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);
    }
    // the server must pick one of ours
    let mut ok = false;
    for o in offered {
        if @mem_eq(o, p) {
            ok = true;
        }
    }
    if not ok {
        return c.fail(ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);
    }
    @mem_copy(c.alpn_selected[..p.len], p);
    c.alpn_len = p.len;
}

fn parse_certificates(c: *mut Conn, msg: []u8) !vec.Vec.[x509.Certificate] {
    let mut list = vec.Vec.[x509.Certificate].init();
    let mut r = cur(msg[4..]);
    _ = r.vec8()!;  // certificate_request_context
    let mut entries = cur(r.vec24()!);
    while not entries.done() {
        let d = entries.vec24() catch |e| {
            free_certs(&mut list);
            return e;
        };
        _ = entries.vec16() catch |e| {
            free_certs(&mut list);
            return e;
        };
        let mut cert = x509.Certificate.parse(d) catch |e| {
            free_certs(&mut list);
            return c.fail(ALERT_BAD_CERTIFICATE, e);
        };
        list.push(cert) catch |e| {
            cert.deinit();
            free_certs(&mut list);
            return e;
        };
    }
    return list;
}

fn free_certs(list: *mut vec.Vec.[x509.Certificate]) void {
    for i in 0..list.len {
        list.get_ptr(i).deinit();
    }
    list.deinit();
}

/// HMAC(finished_key, transcript hash).
fn finished_mac(hash: sha2.Algorithm, base: []u8, th: []u8, out_buf: []mut u8) void {
    let hl = sha2.digest_size(hash);
    let mut fk: [48]u8 = [0; 48];
    expand_label(hash, base, "finished", "", fk[..hl]);
    hmac.hmac(hash, fk[..hl], th, out_buf);
}

/// The TLS 1.3 key schedule without pre-shared keys.
struct KeySchedule {
    hash: sha2.Algorithm,
    hl: usize,
    handshake_secret: [48]u8,
    client_hs: [48]u8,
    server_hs: [48]u8,
    client_ap: [48]u8,
    server_ap: [48]u8,

    fn init(hash: sha2.Algorithm) KeySchedule {
        return KeySchedule.{ hash: hash, hl: sha2.digest_size(hash), handshake_secret: [0; 48], client_hs: [0; 48],
                             server_hs: [0; 48], client_ap: [0; 48], server_ap: [0; 48] };
    }

    /// Derive-Secret(secret, label, transcript hash).
    fn derive(self: *KeySchedule, secret: []u8, label: []u8, th: []u8, out_buf: []mut u8) void {
        expand_label(self.hash, secret, label, th, out_buf[..self.hl]);
    }

    fn empty_hash(self: *KeySchedule, out_buf: []mut u8) []u8 {
        sha2.hash(self.hash, "", out_buf);
        return out_buf[..self.hl];
    }

    fn handshake(self: *mut KeySchedule, shared: []u8, th: []u8) void {
        let hl = self.hl;
        let zeros: [48]u8 = [0; 48];
        let mut early: [48]u8 = [0; 48];
        hmac.extract(self.hash, "", zeros[..hl], early[..hl]);
        let mut eh: [48]u8 = [0; 48];
        let empty = self.empty_hash(eh[..]);
        let mut derived: [48]u8 = [0; 48];
        self.derive(early[..hl], "derived", empty, derived[..]);
        hmac.extract(self.hash, derived[..hl], shared, self.handshake_secret[..hl]);
        let hs = self.handshake_secret;
        self.derive(hs[..hl], "c hs traffic", th, self.client_hs[..]);
        self.derive(hs[..hl], "s hs traffic", th, self.server_hs[..]);
    }

    fn application(self: *mut KeySchedule, th: []u8) void {
        let hl = self.hl;
        let zeros: [48]u8 = [0; 48];
        let mut eh: [48]u8 = [0; 48];
        let empty = self.empty_hash(eh[..]);
        let mut derived: [48]u8 = [0; 48];
        let hs = self.handshake_secret;
        self.derive(hs[..hl], "derived", empty, derived[..]);
        let mut master: [48]u8 = [0; 48];
        hmac.extract(self.hash, derived[..hl], zeros[..hl], master[..hl]);
        self.derive(master[..hl], "c ap traffic", th, self.client_ap[..]);
        self.derive(master[..hl], "s ap traffic", th, self.server_ap[..]);
    }
}

// -----------------------------------------------------------------------------
// TLS 1.2 (RFC 5246, with RFC 7627, 5746, 8422, 7905 and 5288)
// -----------------------------------------------------------------------------

/// An ephemeral ECDHE key on one group.
struct Eph {
    group: u16,
    x: curve25519.X25519Keypair,
    p256: ec.P256,
    p384: ec.P384,
    public: [97]u8,
    public_len: usize,
}

fn eph_new(group: u16) !Eph {
    let mut one: [48]u8 = [0; 48];
    one[47] = 1;
    let mut e = Eph.{ group: group, x: curve25519.X25519Keypair.{ secret: [0; 32], public: [0; 32] },
                      p256: ec.P256.from_bytes(one[16..])!, p384: ec.P384.from_bytes(one[..])!, public: [0; 97],
                      public_len: 0 };
    if group == GROUP_X25519 {
        e.x = curve25519.x25519_keypair()!;
        @mem_copy(e.public[..32], e.x.public[..]);
        e.public_len = 32;
    } else if group == GROUP_P256 {
        e.p256 = ec.P256.generate()!;
        e.p256.public_key(e.public[..65]);
        e.public_len = 65;
    } else if group == GROUP_P384 {
        e.p384 = ec.P384.generate()!;
        e.p384.public_key(e.public[..97]);
        e.public_len = 97;
    } else {
        return error.IllegalParameter;
    }
    return e;
}

/// The premaster secret with the peer's public point.
fn eph_agree(e: *Eph, peer: []u8, out_buf: []mut u8) ![]u8 {
    if e.group == GROUP_X25519 {
        if peer.len != 32 {
            return error.IllegalParameter;
        }
        curve25519.x25519(e.x.secret[..], peer, out_buf[..32]) catch return error.IllegalParameter;
        return out_buf[..32];
    }
    if e.group == GROUP_P256 {
        e.p256.ecdh(peer, out_buf[..32]) catch return error.IllegalParameter;
        return out_buf[..32];
    }
    e.p384.ecdh(peer, out_buf[..48]) catch return error.IllegalParameter;
    return out_buf[..48];
}

/// The master secret: from the session hash with the extended master
/// secret, else from the two randoms.
fn master12(hash: sha2.Algorithm, pms: []u8, ems: bool, session_hash: []u8, cr: []u8, sr: []u8,
            out_buf: []mut u8) void {
    if ems {
        prf12(hash, pms, "extended master secret", session_hash, out_buf[..48]);
        return;
    }
    let mut seed: [64]u8 = [0; 64];
    @mem_copy(seed[..32], cr);
    @mem_copy(seed[32..], sr);
    prf12(hash, pms, "master secret", seed[..], out_buf[..48]);
}

/// The record keys from the master secret: the client's write cipher in
/// cw, the server's in sw.
fn keys12(s: Suite, master: []u8, cr: []u8, sr: []u8, cw: *mut Cipher, sw: *mut Cipher) !void {
    let mut seed: [64]u8 = [0; 64];
    @mem_copy(seed[..32], sr);
    @mem_copy(seed[32..], cr);
    let mut iv_len: usize = 4;
    if is_chacha(s.id) {
        iv_len = 12;
    }
    let mut kb: [88]u8 = [0; 88];
    let n = 2 * (s.key_len + iv_len);
    prf12(s.hash, master, "key expansion", seed[..], kb[..n]);
    let k = s.key_len;
    cw.set12(s, kb[..k], kb[2 * k..(2 * k) + iv_len])!;
    sw.set12(s, kb[k..2 * k], kb[(2 * k) + iv_len..n])!;
}

/// A Finished message: the PRF of the transcript hash under label.
fn finished12(hash: sha2.Algorithm, master: []u8, label: []u8, th: []u8, out_buf: []mut u8) []u8 {
    out_buf[0] = HS_FINISHED;
    out_buf[1] = 0;
    out_buf[2] = 0;
    out_buf[3] = 12;
    prf12(hash, master, label, th, out_buf[4..16]);
    return out_buf[..16];
}

/// The certificate list of a TLS 1.2 Certificate message.
fn parse_certificates12(c: *mut Conn, msg: []u8) !vec.Vec.[x509.Certificate] {
    let mut list = vec.Vec.[x509.Certificate].init();
    let mut r = cur(msg[4..]);
    let mut entries = cur(r.vec24()!);
    while not entries.done() {
        let d = entries.vec24() catch |e| {
            free_certs(&mut list);
            return e;
        };
        let mut cert = x509.Certificate.parse(d) catch |e| {
            free_certs(&mut list);
            return c.fail(ALERT_BAD_CERTIFICATE, e);
        };
        list.push(cert) catch |e| {
            cert.deinit();
            free_certs(&mut list);
            return e;
        };
    }
    return list;
}

/// Checks a ServerKeyExchange signature (TLS 1.2 also allows PKCS #1 v1.5).
fn check_signature12(key: *x509.PublicKey, scheme: u16, content: []u8, sig: []u8) bool {
    if scheme == SIG_RSA_PKCS1_SHA256 {
        return key.verify(x509.SigAlg.RSA_PKCS1, sha2.Algorithm.SHA256, content, sig);
    }
    if scheme == SIG_RSA_PKCS1_SHA384 {
        return key.verify(x509.SigAlg.RSA_PKCS1, sha2.Algorithm.SHA384, content, sig);
    }
    if scheme == SIG_RSA_PKCS1_SHA512 {
        return key.verify(x509.SigAlg.RSA_PKCS1, sha2.Algorithm.SHA512, content, sig);
    }
    // In TLS 1.2 these name only the hash: any curve's key may sign
    // (OpenSSL signs with P-384 and SHA-256, for one).
    let ec_key = (key.kind == x509.KeyKind.P256) or (key.kind == x509.KeyKind.P384);
    if scheme == SIG_ECDSA_P256_SHA256 {
        return ec_key and key.verify(x509.SigAlg.ECDSA, sha2.Algorithm.SHA256, content, sig);
    }
    if scheme == SIG_ECDSA_P384_SHA384 {
        return ec_key and key.verify(x509.SigAlg.ECDSA, sha2.Algorithm.SHA384, content, sig);
    }
    return check_signature(key, scheme, content, sig);
}

/// Signs a ServerKeyExchange: as sign_content, or with PKCS #1 v1.5 for an
/// RSA key when the client does not offer PSS.
fn sign_content12(cfg: *ServerConfig, schemes: []u8, content: []u8, sig: []mut u8, scheme: *mut u16) ![]u8 {
    match cfg.key {
        .Rsa(k) => {
            if not scheme_offered(schemes, SIG_RSA_PSS_SHA256) and scheme_offered(schemes, SIG_RSA_PKCS1_SHA256) {
                let mut d: [32]u8 = [0; 32];
                sha2.sha256(content, d[..]);
                let n = k.public.size;
                k.sign_pkcs1v15(sha2.Algorithm.SHA256, d[..], sig[..n])!;
                scheme.* = SIG_RSA_PKCS1_SHA256;
                return sig[..n];
            }
        }
        else => {}
    }
    return sign_content(cfg, schemes, content, sig, scheme);
}

fn client_handshake12(c: *mut Conn, cfg: *ClientConfig, tr: *mut Transcript, sh_msg: []u8, sh: ServerHello,
                      cr: []u8) !void {
    c.v12 = true;
    let mut sr: [32]u8 = [0; 32];
    @mem_copy(sr[..], sh.random);
    c.suite = suite_of(sh.suite) catch return c.fail(ALERT_ILLEGAL_PARAMETER, error.HandshakeFailure);
    if not c.suite.v12 {
        return c.fail(ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);
    }
    if sh.has_reneg and not sh.reneg_ok {
        return c.fail(ALERT_HANDSHAKE_FAILURE, error.HandshakeFailure);
    }
    if sh.alpn.len > 0 {
        accept_alpn(c, sh.alpn, cfg.alpn)!;
    }
    let ems = sh.ems;
    tr.add(sh_msg)!;
    tr.start(c.suite.hash);
    let hash = c.suite.hash;
    // the server's certificate
    let cm = c.expect_message(HS_CERTIFICATE)!;
    tr.add(cm)!;
    let mut chain = parse_certificates12(c, cm)!;
    defer free_certs(&mut chain);
    if chain.len == 0 {
        return c.fail(ALERT_DECODE_ERROR, error.BadCertificate);
    }
    if cfg.verify {
        let mut roots = cfg.roots;
        x509.verify_chain(chain.items(), &roots, c.sni[..c.sni_len], time.now()) catch |e| {
            return c.fail(ALERT_BAD_CERTIFICATE, e);
        };
    }
    let key = &chain.get_ptr(0).key;
    let ecdsa_key = (key.kind == x509.KeyKind.P256) or (key.kind == x509.KeyKind.P384) or
                    (key.kind == x509.KeyKind.ED25519);
    if (c.suite.ecdsa != ecdsa_key) or (not ecdsa_key and (key.kind != x509.KeyKind.RSA)) {
        return c.fail(ALERT_ILLEGAL_PARAMETER, error.BadCertificate);  // not the suite's kind of key
    }
    // its ECDHE share, signed
    let ske = c.expect_message(HS_SERVER_KEY_EXCHANGE)!;
    tr.add(ske)!;
    let mut r = cur(ske[4..]);
    if r.get8()! != 3 {
        return c.fail(ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);  // named_curve only
    }
    let group = r.get16()!;
    let point = r.vec8()!;
    let params = ske[4..8 + point.len];
    let scheme = r.get16()!;
    let sig = r.vec16()!;
    if not r.done() {
        return c.fail(ALERT_DECODE_ERROR, error.DecodeError);
    }
    let mut content: [400]u8 = [0; 400];
    @mem_copy(content[..32], cr);
    @mem_copy(content[32..64], sr[..]);
    @mem_copy(content[64..64 + params.len], params);
    if not check_signature12(key, scheme, content[..64 + params.len], sig) {
        return c.fail(ALERT_DECRYPT_ERROR, error.BadCertificate);
    }
    let mut eph = eph_new(group) catch return c.fail(ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);
    let mut pms_buf: [48]u8 = [0; 48];
    let pms = eph_agree(&eph, point, pms_buf[..]) catch return c.fail(ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);
    // an optional CertificateRequest, then ServerHelloDone
    let mut next = c.next_message()!;
    let mut cert_requested = false;
    if next[0] == HS_CERTIFICATE_REQUEST {
        cert_requested = true;
        tr.add(next)!;
        next = c.next_message()!;
    }
    if (next[0] != HS_SERVER_HELLO_DONE) or (next.len != 4) {
        return c.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
    }
    tr.add(next)!;
    if cert_requested {
        let empty: [7]u8 = [HS_CERTIFICATE, 0, 0, 3, 0, 0, 0];
        tr.add(empty[..])!;
        c.send_handshake(empty[..])!;
    }
    // ClientKeyExchange: our share
    let mut cke: [102]u8 = [0; 102];
    let pl = eph.public_len;
    cke[0] = HS_CLIENT_KEY_EXCHANGE;
    cke[3] = @truncate(u8, pl + 1);
    cke[4] = @truncate(u8, pl);
    @mem_copy(cke[5..5 + pl], eph.public[..pl]);
    tr.add(cke[..5 + pl])!;
    c.send_handshake(cke[..5 + pl])!;
    // keys
    let mut th: [48]u8 = [0; 48];
    let mut master: [48]u8 = [0; 48];
    master12(hash, pms, ems, tr.current(th[..]), cr, sr[..], master[..]);
    let mut cw = Cipher.none();
    keys12(c.suite, master[..], cr, sr[..], &mut cw, &mut c.rd_next)!;
    let ccs: [1]u8 = [1];
    c.send_record(CT_CHANGE_CIPHER_SPEC, ccs[..])!;
    c.wr = cw;
    let mut fin: [16]u8 = [0; 16];
    let mine = finished12(hash, master[..], "client finished", tr.current(th[..]), fin[..]);
    tr.add(mine)!;
    c.send_handshake(mine)!;
    // the server's ChangeCipherSpec and Finished
    c.ccs_expected = true;
    let sf = c.expect_message(HS_FINISHED)!;
    if c.ccs_expected {
        return c.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);  // Finished before the keys changed
    }
    let mut want: [16]u8 = [0; 16];
    let w = finished12(hash, master[..], "server finished", tr.current(th[..]), want[..]);
    if not subtle.equal(sf, w) {
        return c.fail(ALERT_DECRYPT_ERROR, error.HandshakeFailure);
    }
    c.established = true;
}

// The best TLS 1.2 suite the client offers for our key: ChaCha20, AES-128,
// AES-256; ECDSA suites for EC and Ed25519 keys, RSA ones for RSA keys.
fn choose_suite12(offered: []u8, kind: x509.KeyKind) u16 {
    let mut prefs: [3]u16 = [ECDHE_ECDSA_CHACHA20_POLY1305, ECDHE_ECDSA_AES_128_GCM_SHA256,
                             ECDHE_ECDSA_AES_256_GCM_SHA384];
    if kind == x509.KeyKind.RSA {
        prefs = [ECDHE_RSA_CHACHA20_POLY1305, ECDHE_RSA_AES_128_GCM_SHA256, ECDHE_RSA_AES_256_GCM_SHA384];
    }
    for x in prefs {
        if scheme_offered(offered, x) {
            return x;
        }
    }
    return 0;
}

fn server_handshake12(c: *mut Conn, cfg: *ServerConfig, tr: *mut Transcript, ch_msg: []u8, hello: Hello) !void {
    c.v12 = true;
    if hello.legacy_version < VERSION_1_2 {
        return c.fail(ALERT_PROTOCOL_VERSION, error.ProtocolVersion);
    }
    if hello.fallback {
        // a client retrying with a lower version than it could: we speak 1.3
        return c.fail(ALERT_INAPPROPRIATE_FALLBACK, error.ProtocolVersion);
    }
    let id = choose_suite12(hello.suites, cfg.key_kind);
    if (id == 0) or (hello.schemes.len == 0) {
        return c.fail(ALERT_HANDSHAKE_FAILURE, error.HandshakeFailure);
    }
    let mut group: u16 = 0;
    if hello.wants_x25519 {
        group = GROUP_X25519;
    } else if hello.wants_p256 {
        group = GROUP_P256;
    } else if hello.wants_p384 {
        group = GROUP_P384;
    } else {
        return c.fail(ALERT_HANDSHAKE_FAILURE, error.HandshakeFailure);
    }
    c.suite = suite_of(id)!;
    let hash = c.suite.hash;
    let mut cr: [32]u8 = [0; 32];
    @mem_copy(cr[..], hello.random);
    tr.add(ch_msg)!;
    // ServerHello
    let mut sr: [32]u8 = [0; 32];
    random.fill(sr[..24])!;
    @mem_copy(sr[24..], DOWNGRADE_12[..]);  // we speak 1.3 (RFC 8446 4.1.3)
    let mut o = out();
    defer o.s.deinit();
    o.put8(HS_SERVER_HELLO)!;
    let body = o.open(3)!;
    o.put16(VERSION_1_2)!;
    o.put(sr[..])!;
    o.put8(0)!;  // no session id: no resumption
    o.put16(id)!;
    o.put8(0)!;
    let exts = o.open(2)!;
    if hello.reneg {
        o.put16(EXT_RENEGOTIATION_INFO)!;
        o.put16(1)!;
        o.put8(0)!;
    }
    if hello.ems {
        o.put16(EXT_EXTENDED_MASTER_SECRET)!;
        o.put16(0)!;
    }
    if hello.point_formats {
        o.put16(EXT_EC_POINT_FORMATS)!;
        o.put16(2)!;
        o.put8(1)!;
        o.put8(0)!;
    }
    let chosen = choose_alpn(cfg.alpn, hello.alpn);
    if chosen.len > 0 {
        o.put16(EXT_ALPN)!;
        let a = o.open(2)!;
        let al = o.open(2)!;
        o.put8(@truncate(u8, chosen.len))!;
        o.put(chosen)!;
        o.close(al, 2);
        o.close(a, 2);
        @mem_copy(c.alpn_selected[..chosen.len], chosen);
        c.alpn_len = chosen.len;
    } else if (hello.alpn.len > 0) and (cfg.alpn.len > 0) {
        return c.fail(ALERT_NO_APPLICATION_PROTOCOL, error.HandshakeFailure);
    }
    o.close(exts, 2);
    o.close(body, 3);
    tr.add(o.bytes())!;
    tr.start(hash);
    c.send_handshake(o.bytes())!;
    // Certificate
    let mut cm = out();
    defer cm.s.deinit();
    cm.put8(HS_CERTIFICATE)!;
    let cb = cm.open(3)!;
    let cl = cm.open(3)!;
    for d in cfg.chain.items() {
        cm.put24(d.len)!;
        cm.put(d)!;
    }
    cm.close(cl, 3);
    cm.close(cb, 3);
    tr.add(cm.bytes())!;
    c.send_handshake(cm.bytes())!;
    // ServerKeyExchange: our share, signed with the randoms
    let mut eph = eph_new(group)!;
    let pl = eph.public_len;
    let mut params: [101]u8 = [0; 101];
    params[0] = 3;
    params[1] = @truncate(u8, group >> 8);
    params[2] = @truncate(u8, group);
    params[3] = @truncate(u8, pl);
    @mem_copy(params[4..4 + pl], eph.public[..pl]);
    let mut content: [168]u8 = [0; 168];
    @mem_copy(content[..32], cr[..]);
    @mem_copy(content[32..64], sr[..]);
    @mem_copy(content[64..68 + pl], params[..4 + pl]);
    let mut sig_buf: [1024]u8 = [0; 1024];
    let mut scheme: u16 = 0;
    let sig = sign_content12(cfg, hello.schemes, content[..68 + pl], sig_buf[..], &mut scheme) catch |e| {
        return c.fail(ALERT_HANDSHAKE_FAILURE, e);
    };
    let mut sk = out();
    defer sk.s.deinit();
    sk.put8(HS_SERVER_KEY_EXCHANGE)!;
    let skb = sk.open(3)!;
    sk.put(params[..4 + pl])!;
    sk.put16(scheme)!;
    sk.put16(@truncate(u16, sig.len))!;
    sk.put(sig)!;
    sk.close(skb, 3);
    tr.add(sk.bytes())!;
    c.send_handshake(sk.bytes())!;
    let done: [4]u8 = [HS_SERVER_HELLO_DONE, 0, 0, 0];
    tr.add(done[..])!;
    c.send_handshake(done[..])!;
    // the client's share
    let cke = c.expect_message(HS_CLIENT_KEY_EXCHANGE)!;
    let mut r = cur(cke[4..]);
    let point = r.vec8()!;
    if not r.done() {
        return c.fail(ALERT_DECODE_ERROR, error.DecodeError);
    }
    let mut pms_buf: [48]u8 = [0; 48];
    let pms = eph_agree(&eph, point, pms_buf[..]) catch return c.fail(ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);
    tr.add(cke)!;
    let mut th: [48]u8 = [0; 48];
    let mut master: [48]u8 = [0; 48];
    master12(hash, pms, hello.ems, tr.current(th[..]), cr[..], sr[..], master[..]);
    let mut sw = Cipher.none();
    keys12(c.suite, master[..], cr[..], sr[..], &mut c.rd_next, &mut sw)!;
    // the client's ChangeCipherSpec and Finished
    c.ccs_expected = true;
    let cf = c.expect_message(HS_FINISHED)!;
    if c.ccs_expected {
        return c.fail(ALERT_UNEXPECTED_MESSAGE, error.UnexpectedMessage);
    }
    let mut want: [16]u8 = [0; 16];
    let w = finished12(hash, master[..], "client finished", tr.current(th[..]), want[..]);
    if not subtle.equal(cf, w) {
        return c.fail(ALERT_DECRYPT_ERROR, error.HandshakeFailure);
    }
    tr.add(cf)!;
    // ours
    let ccs: [1]u8 = [1];
    c.send_record(CT_CHANGE_CIPHER_SPEC, ccs[..])!;
    c.wr = sw;
    let mut fin: [16]u8 = [0; 16];
    c.send_handshake(finished12(hash, master[..], "server finished", tr.current(th[..]), fin[..]))!;
    c.established = true;
}

// -----------------------------------------------------------------------------
// The server
// -----------------------------------------------------------------------------

/// Runs the server handshake on an accepted connection. The stream
/// belongs to the Conn afterwards (and is closed if the handshake fails).
pub fn server(stream: net.TcpStream, cfg: *ServerConfig) !*mut Conn {
    let c = new_conn(stream, false)!;
    c.deadline = time.Instant.now().ns + (HANDSHAKE_TIMEOUT_MS * 1000000);
    server_handshake(c, cfg) catch |e| {
        stream.close();
        c.hs.deinit();
        mem.destroy(c);
        return e;
    };
    c.deadline = 0;
    return c;
}

/// A handshake must finish within this long (whatever the socket's own
/// timeout, which limits each read).
pub const HANDSHAKE_TIMEOUT_MS: i64 = 20000;

/// What the server takes from a ClientHello.
struct Hello {
    session_id: []u8,
    suite: u16,
    tls13: bool,
    legacy_version: u16,
    random: []u8,
    suites: []u8,  // the cipher_suites list
    wants_p384: bool,
    ems: bool,    // extended_master_secret offered
    reneg: bool,  // renegotiation_info (empty) or its signalling suite offered
    point_formats: bool,
    fallback: bool,  // TLS_FALLBACK_SCSV
    group: u16,      // the group of a usable share (0: none)
    share: []u8,
    wants_x25519: bool,  // listed in supported_groups
    wants_p256: bool,
    schemes: []u8,
    alpn: []u8,  // the protocol_name_list
    cookie: []u8,
}

fn parse_client_hello(c: *mut Conn, msg: []u8) !Hello {
    let mut h = Hello.{ session_id: "", suite: 0, tls13: false, legacy_version: 0, random: "", suites: "",
                        wants_p384: false, ems: false, reneg: false, point_formats: false, fallback: false, group: 0,
                        share: "", wants_x25519: false, wants_p256: false, schemes: "", alpn: "", cookie: "" };
    let mut r = cur(msg[4..]);
    h.legacy_version = r.get16()!;
    h.random = r.bytes(32)!;
    h.session_id = r.vec8()!;
    h.suites = r.vec16()!;
    let mut suites = cur(h.suites);
    // our preference: ChaCha20 (fastest in software), then AES-128, AES-256
    let mut best: u32 = 99;
    while not suites.done() {
        let s = suites.get16()!;
        let mut rank: u32 = 99;
        if s == EMPTY_RENEGOTIATION_INFO_SCSV {
            h.reneg = true;
        } else if s == FALLBACK_SCSV {
            h.fallback = true;
        }
        if s == TLS_CHACHA20_POLY1305_SHA256 {
            rank = 0;
        } else if s == TLS_AES_128_GCM_SHA256 {
            rank = 1;
        } else if s == TLS_AES_256_GCM_SHA384 {
            rank = 2;
        }
        if rank < best {
            best = rank;
            h.suite = s;
        }
    }
    _ = r.vec8()!;
    if r.done() {
        return h;  // no extensions: not TLS 1.3
    }
    let mut e = cur(r.vec16()!);
    while not e.done() {
        let ty = e.get16()!;
        let data = e.vec16()!;
        let mut d = cur(data);
        if ty == EXT_SUPPORTED_VERSIONS {
            let mut vs = cur(d.vec8()!);
            while not vs.done() {
                if vs.get16()! == 0x0304 {
                    h.tls13 = true;
                }
            }
        } else if ty == EXT_SUPPORTED_GROUPS {
            let mut gs = cur(d.vec16()!);
            while not gs.done() {
                let g = gs.get16()!;
                if g == GROUP_X25519 {
                    h.wants_x25519 = true;
                } else if g == GROUP_P256 {
                    h.wants_p256 = true;
                } else if g == GROUP_P384 {
                    h.wants_p384 = true;
                }
            }
        } else if ty == EXT_KEY_SHARE {
            let mut ks = cur(d.vec16()!);
            while not ks.done() {
                let g = ks.get16()!;
                let k = ks.vec16()!;
                if (g == GROUP_X25519) and (h.group != GROUP_X25519) {
                    h.group = g;
                    h.share = k;
                } else if (g == GROUP_P256) and (h.group == 0) {
                    h.group = g;
                    h.share = k;
                }
            }
        } else if ty == EXT_SIGNATURE_ALGORITHMS {
            h.schemes = d.vec16()!;
        } else if ty == EXT_ALPN {
            h.alpn = d.vec16()!;
        } else if ty == EXT_COOKIE {
            h.cookie = d.vec16()!;
        } else if ty == EXT_EXTENDED_MASTER_SECRET {
            h.ems = true;
        } else if ty == EXT_RENEGOTIATION_INFO {
            let ri = d.vec8()!;
            if ri.len != 0 {
                return error.HandshakeFailure;  // not an initial handshake
            }
            h.reneg = true;
        } else if ty == EXT_EC_POINT_FORMATS {
            h.point_formats = true;
        } else if ty == EXT_SERVER_NAME {
            let mut l = cur(d.vec16()!);
            if l.get8()! == 0 {
                let name = l.vec16()!;
                let n = @min(name.len, 255);
                @mem_copy(c.sni[..n], name[..n]);
                c.sni_len = n;
            }
        }
    }
    return h;
}

fn server_hello(sid: []u8, suite: u16, hrr: bool, group: u16, share: []u8) !Out {
    let mut o = out();
    o.put8(HS_SERVER_HELLO)!;
    let body = o.open(3)!;
    o.put16(0x0303)!;
    if hrr {
        o.put(HRR_RANDOM[..])!;
    } else {
        let mut rnd: [32]u8 = [0; 32];
        random.fill(rnd[..])!;
        o.put(rnd[..])!;
    }
    o.put8(@truncate(u8, sid.len))!;
    o.put(sid)!;
    o.put16(suite)!;
    o.put8(0)!;
    let exts = o.open(2)!;
    o.put16(EXT_SUPPORTED_VERSIONS)!;
    o.put16(2)!;
    o.put16(0x0304)!;
    o.put16(EXT_KEY_SHARE)!;
    if hrr {
        o.put16(2)!;
        o.put16(group)!;
    } else {
        let k = o.open(2)!;
        o.put16(group)!;
        o.put16(@truncate(u16, share.len))!;
        o.put(share)!;
        o.close(k, 2);
    }
    o.close(exts, 2);
    o.close(body, 3);
    return o;
}

fn server_handshake(c: *mut Conn, cfg: *ServerConfig) !void {
    let mut tr = Transcript.init();
    defer tr.deinit();
    let mut msg = c.expect_message(HS_CLIENT_HELLO)!;
    let mut hello = parse_client_hello(c, msg) catch |e| {
        return c.fail(ALERT_HANDSHAKE_FAILURE, e);
    };
    if not hello.tls13 {
        if cfg.min_version > VERSION_1_2 {
            return c.fail(ALERT_PROTOCOL_VERSION, error.ProtocolVersion);
        }
        return server_handshake12(c, cfg, &mut tr, msg, hello);
    }
    if (hello.suite == 0) or (hello.schemes.len == 0) {
        return c.fail(ALERT_HANDSHAKE_FAILURE, error.HandshakeFailure);
    }
    c.suite = suite_of(hello.suite)!;
    let hash = c.suite.hash;
    let hl = sha2.digest_size(hash);
    tr.add(msg)!;
    let mut sid_copy: [32]u8 = [0; 32];
    let sid_len = @min(hello.session_id.len, 32);
    @mem_copy(sid_copy[..sid_len], hello.session_id[..sid_len]);
    let mut sent_ccs = false;
    if hello.group == 0 {
        // no usable share: ask for one (HelloRetryRequest)
        let mut g: u16 = 0;
        if hello.wants_x25519 {
            g = GROUP_X25519;
        } else if hello.wants_p256 {
            g = GROUP_P256;
        } else {
            return c.fail(ALERT_HANDSHAKE_FAILURE, error.HandshakeFailure);
        }
        let mut h1: [48]u8 = [0; 48];
        sha2.hash(hash, tr.pending.bytes(), h1[..]);
        tr.pending.clear();
        let hdr: [4]u8 = [HS_MESSAGE_HASH, 0, 0, @truncate(u8, hl)];
        tr.add(hdr[..])!;
        tr.add(h1[..hl])!;
        let mut hrr = server_hello(sid_copy[..sid_len], hello.suite, true, g, "")!;
        tr.add(hrr.bytes())!;
        c.send_handshake(hrr.bytes())!;
        hrr.s.deinit();
        if sid_len > 0 {
            let ccs: [1]u8 = [1];
            c.send_record(CT_CHANGE_CIPHER_SPEC, ccs[..])!;
            sent_ccs = true;
        }
        msg = c.expect_message(HS_CLIENT_HELLO)!;
        hello = parse_client_hello(c, msg)!;
        if (hello.group != g) or (hello.suite != c.suite.id) {
            return c.fail(ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);
        }
        tr.add(msg)!;
    }
    tr.start(hash);
    // our share and the shared secret
    let mut shares = make_shares()!;
    let mut shared_buf: [48]u8 = [0; 48];
    let shared = agree(&shares, hello.group, hello.share, shared_buf[..]) catch return c.fail(
        ALERT_ILLEGAL_PARAMETER, error.IllegalParameter);
    let mut ours: []u8 = shares.x25519.public[..];
    if hello.group == GROUP_P256 {
        ours = shares.p256_pub[..];
    }
    let mut sh = server_hello(sid_copy[..sid_len], hello.suite, false, hello.group, ours)!;
    tr.add(sh.bytes())!;
    c.send_handshake(sh.bytes())!;
    sh.s.deinit();
    if (sid_len > 0) and not sent_ccs {
        let ccs: [1]u8 = [1];
        c.send_record(CT_CHANGE_CIPHER_SPEC, ccs[..])!;
    }
    let mut ks = KeySchedule.init(hash);
    let mut th: [48]u8 = [0; 48];
    ks.handshake(shared, tr.current(th[..]));
    c.wr.set(c.suite, ks.server_hs[..hl])!;
    c.handshake_read_key(ks.client_hs[..hl])!;
    // EncryptedExtensions, with the ALPN choice
    let mut ee = out();
    defer ee.s.deinit();
    ee.put8(HS_ENCRYPTED_EXTENSIONS)!;
    let eb = ee.open(3)!;
    let el = ee.open(2)!;
    let chosen = choose_alpn(cfg.alpn, hello.alpn);
    if chosen.len > 0 {
        ee.put16(EXT_ALPN)!;
        let a = ee.open(2)!;
        let al = ee.open(2)!;
        ee.put8(@truncate(u8, chosen.len))!;
        ee.put(chosen)!;
        ee.close(al, 2);
        ee.close(a, 2);
        @mem_copy(c.alpn_selected[..chosen.len], chosen);
        c.alpn_len = chosen.len;
    } else if (hello.alpn.len > 0) and (cfg.alpn.len > 0) {
        return c.fail(ALERT_NO_APPLICATION_PROTOCOL, error.HandshakeFailure);
    }
    ee.close(el, 2);
    ee.close(eb, 3);
    tr.add(ee.bytes())!;
    c.send_handshake(ee.bytes())!;
    // Certificate
    let mut cm = out();
    defer cm.s.deinit();
    cm.put8(HS_CERTIFICATE)!;
    let cb = cm.open(3)!;
    cm.put8(0)!;
    let cl = cm.open(3)!;
    for d in cfg.chain.items() {
        cm.put24(d.len)!;
        cm.put(d)!;
        cm.put16(0)!;
    }
    cm.close(cl, 3);
    cm.close(cb, 3);
    tr.add(cm.bytes())!;
    c.send_handshake(cm.bytes())!;
    // CertificateVerify
    let mut content_buf: [200]u8 = [0; 200];
    let content = verify_content(true, tr.current(th[..]), content_buf[..]);
    let mut sig_buf: [1024]u8 = [0; 1024];
    let mut scheme: u16 = 0;
    let sig = sign_content(cfg, hello.schemes, content, sig_buf[..], &mut scheme) catch |e| {
        return c.fail(ALERT_HANDSHAKE_FAILURE, e);
    };
    let mut cv = out();
    defer cv.s.deinit();
    cv.put8(HS_CERTIFICATE_VERIFY)!;
    let vb = cv.open(3)!;
    cv.put16(scheme)!;
    cv.put16(@truncate(u16, sig.len))!;
    cv.put(sig)!;
    cv.close(vb, 3);
    tr.add(cv.bytes())!;
    c.send_handshake(cv.bytes())!;
    // Finished
    let mut fin: [52]u8 = [0; 52];
    fin[0] = HS_FINISHED;
    fin[3] = @truncate(u8, hl);
    finished_mac(hash, ks.server_hs[..hl], tr.current(th[..]), fin[4..4 + hl]);
    tr.add(fin[..4 + hl])!;
    c.send_handshake(fin[..4 + hl])!;
    ks.application(tr.current(th[..]));
    c.wr.set(c.suite, ks.server_ap[..hl])!;
    // the client's Finished
    let cf = c.expect_message(HS_FINISHED)!;
    let mut want: [48]u8 = [0; 48];
    finished_mac(hash, ks.client_hs[..hl], tr.current(th[..]), want[..hl]);
    if (cf.len != (4 + hl)) or not subtle.equal(cf[4..], want[..hl]) {
        return c.fail(ALERT_DECRYPT_ERROR, error.HandshakeFailure);
    }
    c.handshake_read_key(ks.client_ap[..hl])!;
    c.established = true;
    @mem_copy(c.secret_rd[..hl], ks.client_ap[..hl]);
    @mem_copy(c.secret_wr[..hl], ks.server_ap[..hl]);
}

/// The first of our protocols that the client offers ("" if none).
fn choose_alpn(ours: [][]u8, offered: []u8) []u8 {
    for p in ours {
        let mut l = cur(offered);
        while not l.done() {
            let q = l.vec8() catch return "";
            if @mem_eq(p, q) {
                return p;
            }
        }
    }
    return "";
}

// -----------------------------------------------------------------------------
// Tests: a client and a server in one process, over loopback. The server
// has a self-signed P-256 certificate for localhost and 127.0.0.1.
// -----------------------------------------------------------------------------

