// =============================================================================
// std/net/tls.ax - TLS 1.3 (RFC 8446), client and server.
//
//     let mut cfg = tls.ClientConfig.system()!;    // the OS's root CAs
//     defer cfg.deinit();
//     let conn = tls.connect("example.com", 443, &cfg)!;
//     defer conn.close();
//     conn.write_all("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")!;
//     let n = conn.read(buf[..])!;                  // 0 at the end
//
//     let mut scfg = tls.ServerConfig.from_pem(cert_chain_pem, key_pem)!;
//     let conn = tls.server(stream, &scfg)!;       // after listener.accept()
//
// TLS 1.3 is spoken, with the cipher suites TLS_CHACHA20_POLY1305_SHA256,
// TLS_AES_128_GCM_SHA256 and TLS_AES_256_GCM_SHA384, key exchange over
// X25519, P-256 or P-384, and certificates signed with Ed25519, ECDSA
// (P-256, P-384) or RSA (PSS; PKCS #1 v1.5 within certificates). Clients
// verify the server's certificate chain and host name (std/crypto/x509)
// unless told not to. There is no session resumption or 0-RTT data, and a
// client asked for a certificate answers with none.
//
// TLS 1.2 (RFC 5246) is spoken too, by both sides, with peers that lack 1.3:
// only ECDHE key exchange (X25519, P-256, P-384) with the AEAD suites
// ECDHE_{ECDSA,RSA}_WITH_{CHACHA20_POLY1305,AES_128_GCM,AES_256_GCM}, the
// extended master secret (RFC 7627) when the peer offers it, secure
// renegotiation signalling (RFC 5746) without renegotiating, and the TLS
// 1.3 downgrade protection (a client that offered 1.3 refuses a 1.2
// ServerHello carrying the "DOWNGRD" sentinel; a server that negotiates 1.2
// sets it). ClientConfig.min_version / max_version and
// ServerConfig.min_version choose the versions (VERSION_1_2, VERSION_1_3);
// Conn.version() tells the one in use.
//
// A Conn is used by one thread at a time; ClientConfig and ServerConfig may
// be shared by many connections at once.
// =============================================================================

import "../collections/vec.ax" as vec;
import "../crypto/aes_gcm.ax" as aes_gcm;
import "../crypto/chacha20poly1305.ax" as chacha;
import "../crypto/curve25519.ax" as curve25519;
import "../crypto/ec.ax" as ec;
import "../crypto/hmac.ax" as hmac;
import "../crypto/random.ax" as random;
import "../crypto/sha2.ax" as sha2;
import "../crypto/subtle.ax" as subtle;
import "../crypto/x509.ax" as x509;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../net.ax" as net;
import "../str.ax" as strs;
import "../thread.ax" as thread;
import "../time.ax" as time;

error {
    HandshakeFailure,
    DecodeError,
    UnexpectedMessage,
    BadRecordMac,
    RecordOverflow,
    ProtocolVersion,
    IllegalParameter,
    AlertReceived,
    BadCertificate,
    Closed,
    NoCertificate,
    InvalidArgument,
    TimedOut,
    OutOfMemory,
    Unsupported,
}

// Record content types
const CT_CHANGE_CIPHER_SPEC: u8 = 20;
const CT_ALERT: u8 = 21;
const CT_HANDSHAKE: u8 = 22;
const CT_APPLICATION_DATA: u8 = 23;

// Handshake message types
const HS_HELLO_REQUEST: u8 = 0;
const HS_CLIENT_HELLO: u8 = 1;
const HS_SERVER_HELLO: u8 = 2;
const HS_NEW_SESSION_TICKET: u8 = 4;
const HS_ENCRYPTED_EXTENSIONS: u8 = 8;
const HS_CERTIFICATE: u8 = 11;
const HS_SERVER_KEY_EXCHANGE: u8 = 12;
const HS_CERTIFICATE_REQUEST: u8 = 13;
const HS_SERVER_HELLO_DONE: u8 = 14;
const HS_CERTIFICATE_VERIFY: u8 = 15;
const HS_CLIENT_KEY_EXCHANGE: u8 = 16;
const HS_FINISHED: u8 = 20;
const HS_KEY_UPDATE: u8 = 24;
const HS_MESSAGE_HASH: u8 = 254;

// Extensions
const EXT_SERVER_NAME: u16 = 0;
const EXT_SUPPORTED_GROUPS: u16 = 10;
const EXT_EC_POINT_FORMATS: u16 = 11;
const EXT_SIGNATURE_ALGORITHMS: u16 = 13;
const EXT_ALPN: u16 = 16;
const EXT_EXTENDED_MASTER_SECRET: u16 = 23;
const EXT_SUPPORTED_VERSIONS: u16 = 43;
const EXT_COOKIE: u16 = 44;
const EXT_KEY_SHARE: u16 = 51;
const EXT_RENEGOTIATION_INFO: u16 = 0xff01;

// Cipher suites
const TLS_AES_128_GCM_SHA256: u16 = 0x1301;
const TLS_AES_256_GCM_SHA384: u16 = 0x1302;
const TLS_CHACHA20_POLY1305_SHA256: u16 = 0x1303;

// TLS 1.2 cipher suites: ECDHE with an AEAD only
const ECDHE_ECDSA_CHACHA20_POLY1305: u16 = 0xcca9;
const ECDHE_RSA_CHACHA20_POLY1305: u16 = 0xcca8;
const ECDHE_ECDSA_AES_128_GCM_SHA256: u16 = 0xc02b;
const ECDHE_RSA_AES_128_GCM_SHA256: u16 = 0xc02f;
const ECDHE_ECDSA_AES_256_GCM_SHA384: u16 = 0xc02c;
const ECDHE_RSA_AES_256_GCM_SHA384: u16 = 0xc030;
const EMPTY_RENEGOTIATION_INFO_SCSV: u16 = 0x00ff;
const FALLBACK_SCSV: u16 = 0x5600;

/// TLS 1.2, for ClientConfig.min_version and the like.
pub const VERSION_1_2: u16 = 0x0303;
/// TLS 1.3.
pub const VERSION_1_3: u16 = 0x0304;

// The end of a TLS 1.2 ServerHello.random from a server that speaks 1.3.
let DOWNGRADE_12: [8]u8 = [0x44, 0x4f, 0x57, 0x4e, 0x47, 0x52, 0x44, 0x01];

// Groups
const GROUP_P256: u16 = 0x0017;
const GROUP_P384: u16 = 0x0018;
const GROUP_X25519: u16 = 0x001d;

// Signature schemes
const SIG_RSA_PKCS1_SHA256: u16 = 0x0401;
const SIG_RSA_PKCS1_SHA384: u16 = 0x0501;
const SIG_RSA_PKCS1_SHA512: u16 = 0x0601;
const SIG_ECDSA_P256_SHA256: u16 = 0x0403;
const SIG_ECDSA_P384_SHA384: u16 = 0x0503;
const SIG_RSA_PSS_SHA256: u16 = 0x0804;
const SIG_RSA_PSS_SHA384: u16 = 0x0805;
const SIG_RSA_PSS_SHA512: u16 = 0x0806;
const SIG_ED25519: u16 = 0x0807;

// Alerts
const ALERT_CLOSE_NOTIFY: u8 = 0;
const ALERT_UNEXPECTED_MESSAGE: u8 = 10;
const ALERT_BAD_RECORD_MAC: u8 = 20;
const ALERT_HANDSHAKE_FAILURE: u8 = 40;
