// =============================================================================
// std/crypto/argon2.ax - Argon2 password hashing (RFC 9106): Argon2id
// (recommended), Argon2i and Argon2d, version 1.3.
//
//     let p = argon2.Params.default();           // Argon2id, 19 MiB, t=2, p=1
//     let s = argon2.hash_encoded(password, salt, p)!;   // "$argon2id$v=19$..." (mem.free)
//     if argon2.verify_encoded(s, attempt)! { ... }
//
//     argon2.hash(password, salt, p, key[..32])!;       // raw bytes
//
// Lanes are filled one after another (the result is the same as with
// threads). Memory is m KiB; parameters are checked against MAX_MEMORY_KIB
// so a stored hash cannot make verification allocate without limit.
// =============================================================================

import "../encoding/base64.ax" as base64;
import "../encoding/binary.ax" as binary;
import "../fmt.ax" as fmt;
import "../mem.ax" as mem;
import "../str.ax" as strs;
import "blake2.ax" as blake2;
import "subtle.ax" as subtle;

pub error Argon2Error { InvalidArgument, TooExpensive, InvalidEncoding, OutOfMemory, NoSpaceLeft, InvalidBase64,
                        NotFound, BadFormat, Done, IoError, InvalidNumber, InvalidUtf8, Overflow }

/// Argon2d, Argon2i and Argon2id.
pub enum Variant: u8 {
    D = 0,
    I = 1,
    ID = 2,
}

/// The most memory parameters may ask for: 4 GiB.
pub const MAX_MEMORY_KIB: u32 = 4 * 1024 * 1024;

const WORDS: usize = 128;  // u64 words in a 1 KiB block
const SYNC_POINTS: usize = 4;

pub struct Params {
    variant: Variant,
    t: u32,        // passes over memory (>= 1)
    m: u32,        // memory in KiB (>= 8 * p)
    p: u32,        // lanes (1..=2^24 - 1)
    secret: []u8,  // an optional key ("pepper")
    ad: []u8,      // optional associated data

    /// Argon2id with 19 MiB, 2 passes and 1 lane (OWASP's minimum).
    pub fn default() Params {
        return Params.{ variant: Variant.ID, t: 2, m: 19 * 1024, p: 1, secret: "", ad: "" };
    }
}

// H': BLAKE2b stretched to any length.
fn hprime(out: []mut u8, parts: [][]u8) void {
    let mut n: [4]u8 = [0; 4];
    binary.put_u32_le(n[..], @truncate(u32, out.len));
    if out.len <= 64 {
        let mut h = blake2.Blake2b.init(out.len, "") catch @trap();
        h.update(n[..]);
        for p in parts {
            h.update(p);
        }
        h.final(out);
        return;
    }
    let mut v: [64]u8 = [0; 64];
    let mut h = blake2.Blake2b.init(64, "") catch @trap();
    h.update(n[..]);
    for p in parts {
        h.update(p);
    }
    h.final(v[..]);
    let r = ((out.len + 31) / 32) - 2;
    @mem_copy(out[..32], v[..32]);
    let mut o: usize = 32;
    for _i in @as(usize, 1)..r {
        let prev = v;
        blake2.blake2b(prev[..], "", v[..]);
        @mem_copy(out[o..o + 32], v[..32]);
        o += 32;
    }
    let prev = v;
    blake2.blake2b(prev[..], "", out[o..]);
}

fn blamka(x: u64, y: u64) u64 {
    return (x +% y) +% ((2 *% (x & 0xffffffff)) *% (y & 0xffffffff));
}

fn gb(v: *mut [WORDS]u64, a: usize, b: usize, c: usize, d: usize) void {
    v[a] = blamka(v[a], v[b]);
    v[d] = @rotr(v[d] ^ v[a], 32);
    v[c] = blamka(v[c], v[d]);
    v[b] = @rotr(v[b] ^ v[c], 24);
    v[a] = blamka(v[a], v[b]);
    v[d] = @rotr(v[d] ^ v[a], 16);
    v[c] = blamka(v[c], v[d]);
    v[b] = @rotr(v[b] ^ v[c], 63);
}

// The BLAKE2 round on the 16 words at the given positions.
fn round(v: *mut [WORDS]u64, i: [16]usize) void {
    gb(v, i[0], i[4], i[8], i[12]);
    gb(v, i[1], i[5], i[9], i[13]);
    gb(v, i[2], i[6], i[10], i[14]);
    gb(v, i[3], i[7], i[11], i[15]);
    gb(v, i[0], i[5], i[10], i[15]);
    gb(v, i[1], i[6], i[11], i[12]);
    gb(v, i[2], i[7], i[8], i[13]);
    gb(v, i[3], i[4], i[9], i[14]);
}

// dst = G(x, y) (^ the old dst when xor): the compression function.
fn compress(x: []u64, y: []u64, dst: []mut u64, xor: bool) void {
    let mut r: [WORDS]u64 = [0; WORDS];
    for k in @as(usize, 0)..WORDS {
        r[k] = x[k] ^ y[k];
    }
    let mut z = r;
    for i in @as(usize, 0)..8 {
        let b = 16 * i;
        round(&mut z, [b, b + 1, b + 2, b + 3, b + 4, b + 5, b + 6, b + 7, b + 8, b + 9, b + 10, b + 11, b + 12, b + 13,
                       b + 14, b + 15]);
    }
    for i in @as(usize, 0)..8 {
        let b = 2 * i;
        round(&mut z, [b, b + 1, b + 16, b + 17, b + 32, b + 33, b + 48, b + 49, b + 64, b + 65, b + 80, b + 81, b + 96,
                       b + 97, b + 112, b + 113]);
    }
    for k in @as(usize, 0)..WORDS {
        let v = z[k] ^ r[k];
        if xor {
            dst[k] ^= v;
        } else {
            dst[k] = v;
        }
    }
}

struct Instance {
    mem: []mut u64,
    lanes: usize,
    lane_len: usize,  // blocks in a lane
    seg_len: usize,
    passes: u32,
    blocks: usize,
    variant: Variant,

    fn block(self: *Instance, i: usize) []mut u64 {
        return self.mem[i * WORDS..(i + 1) * WORDS];
    }

    fn index_alpha(self: *Instance, pass: u32, slice: usize, index: usize, rand: u64, same_lane: bool) usize {
        let mut area: usize = 0;
        if pass == 0 {
            if slice == 0 {
                area = index - 1;
            } else if same_lane {
                area = ((slice * self.seg_len) + index) - 1;
            } else if index == 0 {
                area = (slice * self.seg_len) - 1;
            } else {
                area = slice * self.seg_len;
            }
        } else if same_lane {
            area = ((self.lane_len - self.seg_len) + index) - 1;
        } else if index == 0 {
            area = (self.lane_len - self.seg_len) - 1;
        } else {
            area = self.lane_len - self.seg_len;
        }
        let j1 = rand & 0xffffffff;
        let x = (j1 *% j1) >> 32;
        let rel = (@as(u64, area) - 1) - ((@as(u64, area) *% x) >> 32);
        let mut start: usize = 0;
        if (pass != 0) and (slice != (SYNC_POINTS - 1)) {
            start = (slice + 1) * self.seg_len;
        }
        return (start + @truncate(usize, rel)) % self.lane_len;
    }

    fn fill_segment(self: *mut Instance, pass: u32, lane: usize, slice: usize) void {
        let independent = (self.variant == Variant.I) or ((self.variant == Variant.ID) and (pass == 0) and (slice < 2));
        let zero: [WORDS]u64 = [0; WORDS];
        let mut input: [WORDS]u64 = [0; WORDS];
        let mut addr: [WORDS]u64 = [0; WORDS];
        if independent {
            input[0] = @as(u64, pass);
            input[1] = @as(u64, lane);
            input[2] = @as(u64, slice);
            input[3] = @as(u64, self.blocks);
            input[4] = @as(u64, self.passes);
            input[5] = @as(u64, @int_from_enum(self.variant));
        }
        let mut start: usize = 0;
        if (pass == 0) and (slice == 0) {
            start = 2;
            if independent {
                next_addresses(&mut input, &mut addr, &zero);
            }
        }
        let mut cur = ((lane * self.lane_len) + (slice * self.seg_len)) + start;
        let mut prev = (cur + self.lane_len) - 1;  // the lane's last block, for its first
        if (cur % self.lane_len) != 0 {
            prev = cur - 1;
        }
        for i in start..self.seg_len {
            if (cur % self.lane_len) == 1 {
                prev = cur - 1;
            }
            let mut rand: u64 = 0;
            if independent {
                if (i % WORDS) == 0 {
                    next_addresses(&mut input, &mut addr, &zero);
                }
                rand = addr[i % WORDS];
            } else {
                rand = self.mem[prev * WORDS];
            }
            let mut ref_lane = @truncate(usize, (rand >> 32) % @as(u64, self.lanes));
            if (pass == 0) and (slice == 0) {
                ref_lane = lane;
            }
            let ref_index = self.index_alpha(pass, slice, i, rand, ref_lane == lane);
            let rb = (ref_lane * self.lane_len) + ref_index;
            // (the three blocks are distinct: prev and ref are before cur)
            let m = self.mem;
            compress(m[prev * WORDS..(prev + 1) * WORDS], m[rb * WORDS..(rb + 1) * WORDS],
                     m[cur * WORDS..(cur + 1) * WORDS], pass != 0);
            cur += 1;
            prev += 1;
        }
    }
}

fn next_addresses(input: *mut [WORDS]u64, addr: *mut [WORDS]u64, zero: *[WORDS]u64) void {
    input[6] +%= 1;
    let mut tmp: [WORDS]u64 = [0; WORDS];
    compress(zero[..], input[..], tmp[..], false);
    compress(zero[..], tmp[..], addr[..], false);
}

fn check(p: *Params, salt: []u8, out_len: usize) Argon2Error!void {
    if (p.t == 0) or (p.p == 0) or (p.p > 0xffffff) or (out_len < 4) or (salt.len < 8) or (salt.len > 0xffffffff) {
        return error.InvalidArgument;
    }
    if @as(u64, p.m) < (8 * @as(u64, p.p)) {
        return error.InvalidArgument;
    }
    if p.m > MAX_MEMORY_KIB {
        return error.TooExpensive;
    }
}

/// Argon2 of password and salt (>= 8 bytes, 16 recommended) into out
/// (>= 4 bytes; 32 is usual).
pub fn hash(password: []u8, salt: []u8, p: Params, out: []mut u8) Argon2Error!void {
    check(&p, salt, out.len)!;
    // H0
    let mut w: [24]u8 = [0; 24];
    binary.put_u32_le(w[0..4], p.p);
    binary.put_u32_le(w[4..8], @truncate(u32, out.len));
    binary.put_u32_le(w[8..12], p.m);
    binary.put_u32_le(w[12..16], p.t);
    binary.put_u32_le(w[16..20], 0x13);
    binary.put_u32_le(w[20..24], @as(u32, @int_from_enum(p.variant)));
    let mut h = blake2.Blake2b.init(64, "") catch @trap();
    h.update(w[..]);
    let mut len: [4]u8 = [0; 4];
    for part in [password, salt, p.secret, p.ad] {
        binary.put_u32_le(len[..], @truncate(u32, part.len));
        h.update(len[..]);
        h.update(part);
    }
    let mut h0: [72]u8 = [0; 72];
    h.final(h0[..64]);
    // memory: m rounded down to a multiple of 4p blocks
    let lanes = @as(usize, p.p);
    let blocks = (@as(usize, p.m) / (4 * lanes)) * (4 * lanes);
    let lane_len = blocks / lanes;
    let memory = mem.alloc.[u64](blocks * WORDS)!;
    defer mem.free(memory);
    let mut inst = Instance.{ mem: memory, lanes: lanes, lane_len: lane_len, seg_len: lane_len / SYNC_POINTS,
                              passes: p.t, blocks: blocks, variant: p.variant };
    let mut bytes: [1024]u8 = [0; 1024];
    for l in @as(usize, 0)..lanes {
        for k in @as(u32, 0)..2 {
            binary.put_u32_le(h0[64..68], k);
            binary.put_u32_le(h0[68..72], @truncate(u32, l));
            let parts: [1][]u8 = [h0[..]];
            hprime(bytes[..], parts[..]);
            let b = inst.block((l * lane_len) + @as(usize, k));
            for q in @as(usize, 0)..WORDS {
                b[q] = load64(bytes[8 * q..(8 * q) + 8]);
            }
        }
    }
    for pass in @as(u32, 0)..p.t {
        for slice in @as(usize, 0)..SYNC_POINTS {
            for l in @as(usize, 0)..lanes {
                inst.fill_segment(pass, l, slice);
            }
        }
    }
    // the XOR of the lanes' last blocks, hashed to the tag
    let mut c: [WORDS]u64 = [0; WORDS];
    for l in @as(usize, 0)..lanes {
        let b = inst.block(((l + 1) * lane_len) - 1);
        for q in @as(usize, 0)..WORDS {
            c[q] ^= b[q];
        }
    }
    for q in @as(usize, 0)..WORDS {
        for k in @as(usize, 0)..8 {
            bytes[(8 * q) + k] = @truncate(u8, c[q] >> @truncate(u64, 8 * k));
        }
    }
    let parts: [1][]u8 = [bytes[..]];
    hprime(out, parts[..]);
    subtle.zero(bytes[..]);
    subtle.zero(@cast_slice(u8, memory));
}

fn load64(b: []u8) u64 {
    return (
        (((((@as(u64, b[0]) | (@as(u64, b[1]) << 8)) | (@as(u64, b[2]) << 16)) | (@as(u64, b[3]) << 24)) | (@as(u64,
                                                                                                                b[4]) <<
                                                                                                            32)) |
         (@as(u64, b[5]) << 40)) | (@as(u64, b[6]) << 48)) | (@as(u64, b[7]) << 56);
}

// -----------------------------------------------------------------------------
// The PHC string format
// -----------------------------------------------------------------------------

let B64: base64.Encoding = base64.Encoding.{
    alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/",
    pad: false,
};

fn variant_name(v: Variant) []u8 {
    if v == Variant.I {
        return "argon2i";
    }
    if v == Variant.D {
        return "argon2d";
    }
    return "argon2id";
}

/// Hashes a password to "$argon2id$v=19$m=...,t=...,p=...$salt$hash" with a
/// 32-byte tag (free it with mem.free). The secret and ad of p are used but
/// not recorded.
pub fn hash_encoded(password: []u8, salt: []u8, p: Params) ![]mut u8 {
    let mut tag: [32]u8 = [0; 32];
    hash(password, salt, p, tag[..])!;
    let mut s = strs.String.init();
    encode_into(&mut s, p, salt, tag[..]) catch |e| {
        s.deinit();
        return e;
    };
    return s.take();
}

fn encode_into(s: *mut strs.String, p: Params, salt: []u8, tag: []u8) !void {
    fmt.write(s.writer(), "${}$v=19$m={},t={},p={}$", [fmt.str(variant_name(p.variant)), fmt.int(p.m), fmt.int(p.t),
                                                       fmt.int(p.p)])!;
    let a = base64.encode_alloc(salt, B64)!;
    defer mem.free(a);
    s.push_str(a)!;
    s.push('$')!;
    let b = base64.encode_alloc(tag, B64)!;
    defer mem.free(b);
    s.push_str(b)!;
}

/// Whether password matches an encoded hash (compared in constant time).
/// InvalidEncoding if the string is malformed, TooExpensive if it asks for
/// more than MAX_MEMORY_KIB.
pub fn verify_encoded(encoded: []u8, password: []u8) Argon2Error!bool {
    return verify_with(encoded, password, "", "");
}

/// verify_encoded with the secret and associated data used when hashing.
pub fn verify_with(encoded: []u8, password: []u8, secret: []u8, ad: []u8) Argon2Error!bool {
    // $variant$v=19$m=..,t=..,p=..$salt$hash
    let mut parts: [6][]u8 = ["", "", "", "", "", ""];
    let mut n: usize = 0;
    let mut it = strs.split(encoded, "$");
    while true {
        let f = it.next() catch break;
        if n >= 6 {
            return error.InvalidEncoding;
        }
        parts[n] = f;
        n += 1;
    }
    if (n != 6) or (parts[0].len != 0) {
        return error.InvalidEncoding;
    }
    let mut p = Params.default();
    p.secret = secret;
    p.ad = ad;
    if strs.eq(parts[1], "argon2id") {
        p.variant = Variant.ID;
    } else if strs.eq(parts[1], "argon2i") {
        p.variant = Variant.I;
    } else if strs.eq(parts[1], "argon2d") {
        p.variant = Variant.D;
    } else {
        return error.InvalidEncoding;
    }
    if not strs.eq(parts[2], "v=19") {
        return error.InvalidEncoding;
    }
    let mut seen: u32 = 0;
    let mut pit = strs.split(parts[3], ",");
    while true {
        let kv = pit.next() catch break;
        let c = strs.cut(kv, "=") catch return error.InvalidEncoding;
        let v = fmt.parse_int.[u32](c.after) catch return error.InvalidEncoding;
        if strs.eq(c.before, "m") {
            p.m = v;
            seen |= 1;
        } else if strs.eq(c.before, "t") {
            p.t = v;
            seen |= 2;
        } else if strs.eq(c.before, "p") {
            p.p = v;
            seen |= 4;
        } else {
            return error.InvalidEncoding;
        }
    }
    if seen != 7 {
        return error.InvalidEncoding;
    }
    let salt = base64.decode_alloc(parts[4], B64) catch return error.InvalidEncoding;
    defer mem.free(salt);
    let want = base64.decode_alloc(parts[5], B64) catch return error.InvalidEncoding;
    defer mem.free(want);
    if (want.len < 4) or (want.len > 1024) {
        return error.InvalidEncoding;
    }
    let got = mem.alloc.[u8](want.len)!;
    defer mem.free(got);
    hash(password, salt, p, got)!;
    return subtle.equal(got, want);
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn hex(d: []u8, out: []mut u8) []u8 {
    let digits = "0123456789abcdef";
    for i in @as(usize, 0)..d.len {
        out[2 * i] = digits[@as(usize, d[i] >> 4)];
        out[(2 * i) + 1] = digits[@as(usize, d[i] & 15)];
    }
    return out[..2 * d.len];
}

test "argon2 reference values" {
    let mut k: [40]u8 = [0; 40];
    let mut h: [80]u8 = [0; 80];
    let mut p = Params.{ variant: Variant.ID, t: 2, m: 64, p: 1, secret: "", ad: "" };
    hash("password", "somesalt", p, k[..32])!;
    @expect_eq(hex(k[..32], h[..]), "16a1a498734609dd01456da406de9f3d9da93e6c86c300a12fc1465214ce4922");
    p.variant = Variant.I;
    hash("password", "somesalt", p, k[..32])!;
    @expect_eq(hex(k[..32], h[..]), "989da65458e8be1440ae555d0b3c8ac3a6584e0d2290b9dcc915a68a71e41c1e");
    p.variant = Variant.D;
    hash("password", "somesalt", p, k[..32])!;
    @expect_eq(hex(k[..32], h[..]), "f920d95538648465abeeba6ae06ea532ed26df314aff60150237d8fe116f62cd");
    let q = Params.{ variant: Variant.ID, t: 3, m: 256, p: 4, secret: "", ad: "" };
    hash("pw", "saltsaltsalt", q, k[..])!;
    @expect_eq(hex(k[..], h[..]), "4fb6852ad09221e5daa74ef8cad8a587112e3b3992ef45aa8c3a8d7e35ce366ba1930234e6f0c325");
}

test "argon2 encoded strings" {
    let p = Params.{ variant: Variant.ID, t: 2, m: 64, p: 1, secret: "", ad: "" };
    let s = hash_encoded("password", "somesalt", p)!;
    defer mem.free(s);
    @expect_eq(s, "$argon2id$v=19$m=64,t=2,p=1$c29tZXNhbHQ$FqGkmHNGCd0BRW2kBt6fPZ2pPmyGwwChL8FGUhTOSSI");
    @expect(verify_encoded(s, "password")!);
    @expect(not verify_encoded(s, "passwore")!);
    let bad: [5][]u8 = [
        "$argon2x$v=19$m=64,t=2,p=1$c29tZXNhbHQ$FqGkmHNGCd0BRW2kBt6fPZ2pPmyGwwChL8FGUhTOSSI",
        "$argon2id$v=16$m=64,t=2,p=1$c29tZXNhbHQ$FqGkmHNGCd0BRW2kBt6fPZ2pPmyGwwChL8FGUhTOSSI",
        "$argon2id$v=19$m=64,t=2$c29tZXNhbHQ$FqGkmHNGCd0BRW2kBt6fPZ2pPmyGwwChL8FGUhTOSSI",
        "$argon2id$v=19$m=64,t=2,p=1$c29tZXNhbHQ",
        "$argon2id$v=19$m=4000000000,t=2,p=1$c29tZXNhbHQ$FqGkmHNGCd0BRW2kBt6fPZ2pPmyGwwChL8FGUhTOSSI",
    ];
    for b in bad {
        @expect(fails(verify_encoded(b, "password")));
    }
    let tiny = Params.{ variant: Variant.ID, t: 1, m: 7, p: 1, secret: "", ad: "" };
    let mut k: [32]u8 = [0; 32];
    @expect(fails_void(hash("pw", "saltsalt", tiny, k[..])));
    @expect(fails_void(hash("pw", "short", Params.default(), k[..])));
}

fn fails(r: !bool) bool {
    _ = r catch return true;
    return false;
}

fn fails_void(r: !void) bool {
    r catch return true;
    return false;
}
