// =============================================================================
// std/crypto/aes_gcm.ax - AES-128, AES-192 and AES-256 in GCM mode (FIPS 197,
// NIST SP 800-38D).
//
//     let g = aes_gcm.AesGcm.init(key)!;          // 16, 24 or 32 bytes
//     g.seal(nonce, aad, plaintext, out)!;         // out: len + 16
//     g.open(nonce, aad, sealed, out)!;            // AuthFailed if forged
//
// Nonces are 12 bytes and must never repeat under one key. The cipher runs
// in time independent of the key and data. Where the processor has AES and
// carry-less multiplication instructions (AES-NI and PCLMULQDQ on x86-64,
// the ARMv8 AES instructions and PMULL on AArch64), they do the work, eight
// counter blocks at a time and GHASH four blocks per reduction; those
// instructions take the same time for every input. Elsewhere the S-box is
// 16 table lookups with vector shuffles over all 256 entries (no memory
// access depends on a secret), and GHASH multiplies with integer
// multiplications whose unused bits are masked off (after BearSSL's
// ghash_ctmul64). The choice is made at run time (@multiversion, spec
// §13.4) unless the build's processor has the instructions anyway.
// =============================================================================

import "subtle.ax" as subtle;

error { AuthFailed, InvalidLength }

/// GCM takes at most 2^32 - 2 blocks per message (the counter would wrap
/// into the tag's block).
fn too_long(n: usize) bool {
    return @as(u64, n) > ((@as(u64, 1) << 36) - 32);
}

pub const NONCE_LEN: usize = 12;
pub const TAG_LEN: usize = 16;

