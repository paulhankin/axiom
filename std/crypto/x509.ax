fn wildcard_path(sub: [][]u8, leaf: [][]u8, hostname: []u8) !void {
    let mut roots = CertPool.init();
    defer roots.deinit();
    let rt = join(WC_ROOT_PEM[..])!;
    defer mem.free(rt);
    _ = roots.add_pem(rt)!;
    let mut chain: [2]Certificate = [cert_of(leaf)!, cert_of(sub)!];
    defer chain[0].deinit();
    defer chain[1].deinit();
    return verify_chain(chain[..], &roots, hostname, time.date(2030, 1, 1, 0, 0, 0)!);
}

test "name constraints and wildcards" {
    @expect(fails_with(wildcard_path(WC_SUB_A_PEM[..], WC_LEAF_PEM[..], "victim.example.com"), error.NameConstraint));
    @expect(fails_with(wildcard_path(WC_SUB_A_PEM[..], WC_LEAF_PEM[..], "a.example.com"), error.NameConstraint));
    @expect(fails_with(wildcard_path(WC_SUB_COM_PEM[..], WC_LEAF_COM_PEM[..], "x.com"), error.NameConstraint));
    wildcard_path(WC_SUB_PARENT_PEM[..], WC_LEAF_PEM[..], "victim.example.com")!;
    wildcard_path(WC_SUB_DOT_PEM[..], WC_LEAF_PEM[..], "victim.example.com")!;
    @expect(fails_with(wildcard_path(WC_SUB_DOT_PEM[..], WC_LEAF_COM_PEM[..], "x.com"), error.NameConstraint));
}

test "unsupported name constraints" {
    let mut roots = CertPool.init();
    defer roots.deinit();
    let rt = join(DN_ROOT_PEM[..])!;
    defer mem.free(rt);
    @expect_eq(roots.add_pem(rt)!, 1);
    @expect(roots.certs.items()[0].constraints_unsupported);
    let mut chain: [1]Certificate = [cert_of(DN_LEAF_PEM[..])!];
    defer chain[0].deinit();
    @expect(fails_with(verify_chain(chain[..], &roots, "evil.test", time.date(2030, 1, 1, 0, 0, 0)!),
                       error.NameConstraint));
}

