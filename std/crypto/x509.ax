test "verify chains" {
    let mut roots = CertPool.init();
    defer roots.deinit();
    let rt = join(ROOT_PEM[..])!;
    defer mem.free(rt);
    @expect_eq(roots.add_pem(rt)!, 1);
    let mut chain: [2]Certificate = [cert_of(LEAF_PEM[..])!, cert_of(INTER_PEM[..])!];
    defer chain[0].deinit();
    defer chain[1].deinit();
    let now = time.date(2030, 1, 1, 0, 0, 0)!;
    verify_chain(chain[..], &roots, "example.test", now)!;
    verify_chain(chain[..], &roots, "x.wild.test", now)!;
    @expect(fails_with(verify_chain(chain[..], &roots, "other.test", now), error.HostnameMismatch));
    @expect(fails_with(verify_chain(chain[..1], &roots, "example.test", now), error.UnknownAuthority));
    @expect(fails_with(verify_chain(chain[..], &roots, "example.test", time.date(2200, 1, 1, 0, 0, 0)!),
                       error.Expired));
    @expect(fails_with(verify_chain(chain[..], &roots, "example.test", time.date(2000, 1, 1, 0, 0, 0)!),
                       error.NotYetValid));
    let mut empty = CertPool.init();
    defer empty.deinit();
    @expect(fails_with(verify_chain(chain[..], &empty, "example.test", now), error.UnknownAuthority));
    // name constraints
    let mut good: [2]Certificate = [cert_of(GOOD_PEM[..])!, cert_of(CON_PEM[..])!];
    defer good[0].deinit();
    defer good[1].deinit();
    verify_chain(good[..], &roots, "www.good.test", now)!;
    let mut bad: [2]Certificate = [cert_of(BAD_PEM[..])!, cert_of(CON_PEM[..])!];
    defer bad[0].deinit();
    defer bad[1].deinit();
    @expect(fails_with(verify_chain(bad[..], &roots, "www.evil.test", now), error.NameConstraint));
    let mut nroots = CertPool.init();
    defer nroots.deinit();
    let nr = join(NC_ROOT_PEM[..])!;
    defer mem.free(nr);
    @expect_eq(nroots.add_pem(nr)!, 1);
    let mut dot: [1]Certificate = [cert_of(NC_DOT_LEAF_PEM[..])!];
    defer dot[0].deinit();
    @expect(fails_with(verify_chain(dot[..], &nroots, "evil.test", time.date(2027, 1, 1, 0, 0, 0)!),
                       error.NameConstraint));
    // a constrained CA's constraints bind the sub-CAs under it, not only the leaf
    let mut r2 = CertPool.init();
    defer r2.deinit();
    let nr2 = join(NC2_ROOT_PEM[..])!;
    defer mem.free(nr2);
    @expect_eq(r2.add_pem(nr2)!, 1);
    let mut evil: [3]Certificate = [cert_of(NC2_LEAF_EVIL_PEM[..])!, cert_of(NC2_SUB_EVIL_PEM[..])!,
                                    cert_of(NC2_CON_PEM[..])!];
    defer evil[0].deinit();
    defer evil[1].deinit();
    defer evil[2].deinit();
    @expect(fails_with(verify_chain(evil[..], &r2, "www.good.test", now), error.NameConstraint));
    let mut fine: [3]Certificate = [cert_of(NC2_LEAF_GOOD_PEM[..])!, cert_of(NC2_SUB_GOOD_PEM[..])!,
                                    cert_of(NC2_CON_PEM[..])!];
    defer fine[0].deinit();
    defer fine[1].deinit();
    defer fine[2].deinit();
    verify_chain(fine[..], &r2, "www.good.test", now)!;
    @expect_eq(one_label_under("www.x.test", "x.test"), true);
    @expect_eq(one_label_under("a.www.x.test", "x.test"), false);
    @expect_eq(one_label_under("x.test", "x.test"), false);
}

