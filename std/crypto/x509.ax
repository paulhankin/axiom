test "parse certificates" {
    let mut leaf = cert_of(LEAF_PEM[..])!;
    defer leaf.deinit();
    @expect_eq(leaf.common_name, "example.test");
    @expect(leaf.key.kind == KeyKind.P256);
    @expect(leaf.sig_alg == SigAlg.ECDSA);
    @expect(leaf.sig_hash == sha2.Algorithm.SHA384);
    @expect(not leaf.is_ca);
    @expect_eq(leaf.dns_names.len, 2);
    @expect(leaf.matches_host("example.test"));
    @expect(leaf.matches_host("EXAMPLE.test."));
    @expect(leaf.matches_host("a.wild.test"));
    @expect(not leaf.matches_host("wild.test"));
    @expect(not leaf.matches_host("a.b.wild.test"));
    @expect(leaf.matches_host("127.0.0.1"));
    @expect(not leaf.matches_host("127.0.0.2"));
    let mut inter = cert_of(INTER_PEM[..])!;
    defer inter.deinit();
    @expect(inter.key.kind == KeyKind.P384);
    @expect(inter.is_ca);
    @expect_eq(inter.max_path_len, 0);
    @expect(leaf.signed_by(&inter));
    let mut root = cert_of(ROOT_PEM[..])!;
    defer root.deinit();
    @expect(root.key.kind == KeyKind.RSA);
    @expect(inter.signed_by(&root));
    @expect(not leaf.signed_by(&root));
    @expect(root.signed_by(&root));
    let mut ed = cert_of(ED_PEM[..])!;
    defer ed.deinit();
    @expect(ed.key.kind == KeyKind.ED25519);
    @expect(ed.sig_alg == SigAlg.RSA_PSS);
    @expect(ed.signed_by(&root));
}

test "verify chains" {
    let mut roots = CertPool.init();
    defer roots.deinit();
    let rt = join(ROOT_PEM[..])!;
    defer mem.free(rt);
    @expect_eq(roots.add_pem(rt)!, 1);
    let mut chain: [2]Certificate = [cert_of(LEAF_PEM[..])!, cert_of(INTER_PEM[..])!];
    defer chain[0].deinit();
    defer chain[1].deinit();
    let now = time.date(2030, 1, 1, 0, 0, 0)!;
    verify_chain(chain[..], &roots, "example.test", now)!;
    verify_chain(chain[..], &roots, "x.wild.test", now)!;
    @expect(fails_with(verify_chain(chain[..], &roots, "other.test", now), error.HostnameMismatch));
    @expect(fails_with(verify_chain(chain[..1], &roots, "example.test", now), error.UnknownAuthority));
    @expect(fails_with(verify_chain(chain[..], &roots, "example.test", time.date(2200, 1, 1, 0, 0, 0)!),
                       error.Expired));
    @expect(fails_with(verify_chain(chain[..], &roots, "example.test", time.date(2000, 1, 1, 0, 0, 0)!),
                       error.NotYetValid));
    let mut empty = CertPool.init();
    defer empty.deinit();
    @expect(fails_with(verify_chain(chain[..], &empty, "example.test", now), error.UnknownAuthority));
    // name constraints
    let mut good: [2]Certificate = [cert_of(GOOD_PEM[..])!, cert_of(CON_PEM[..])!];
    defer good[0].deinit();
    defer good[1].deinit();
    verify_chain(good[..], &roots, "www.good.test", now)!;
    let mut bad: [2]Certificate = [cert_of(BAD_PEM[..])!, cert_of(CON_PEM[..])!];
    defer bad[0].deinit();
    defer bad[1].deinit();
    @expect(fails_with(verify_chain(bad[..], &roots, "www.evil.test", now), error.NameConstraint));
    let mut nroots = CertPool.init();
    defer nroots.deinit();
    let nr = join(NC_ROOT_PEM[..])!;
    defer mem.free(nr);
    @expect_eq(nroots.add_pem(nr)!, 1);
    let mut dot: [1]Certificate = [cert_of(NC_DOT_LEAF_PEM[..])!];
    defer dot[0].deinit();
    @expect(fails_with(verify_chain(dot[..], &nroots, "evil.test", time.date(2027, 1, 1, 0, 0, 0)!),
                       error.NameConstraint));
    @expect_eq(one_label_under("www.x.test", "x.test"), true);
    @expect_eq(one_label_under("a.www.x.test", "x.test"), false);
    @expect_eq(one_label_under("x.test", "x.test"), false);
}

test "private keys" {
    let lk = join(LEAF_KEY[..])!;
    defer mem.free(lk);
    let mut k = parse_private_key_pem(lk)!;
    defer k.deinit();
    let mut leaf = cert_of(LEAF_PEM[..])!;
    defer leaf.deinit();
    match k {
        .P256(p) => {
            let mut pubk: [65]u8 = [0; 65];
            p.public_key(pubk[..]);
            @expect_eq(pubk[..], leaf.key.point);
        }
        else => { @trap(); }
    }
    let ek = join(ED_KEY[..])!;
    defer mem.free(ek);
    let mut e = parse_private_key_pem(ek)!;
    let mut ed = cert_of(ED_PEM[..])!;
    defer ed.deinit();
    match e {
        .Ed25519(s) => { @expect_eq(s.public[..], ed.key.point); }
        else        => { @trap(); }
    }
    e.deinit();
    let rk = join(ROOT_KEY[..])!;
    defer mem.free(rk);
    let mut r = parse_private_key_pem(rk)!;
    defer r.deinit();
    let mut root = cert_of(ROOT_PEM[..])!;
    defer root.deinit();
    match r {
        .Rsa(s) => {
            let mut digest: [32]u8 = [0; 32];
            sha2.sha256("msg", digest[..]);
            let mut sig: [256]u8 = [0; 256];
            s.sign_pss(sha2.Algorithm.SHA256, digest[..], sig[..])!;
            @expect(root.key.verify(SigAlg.RSA_PSS, sha2.Algorithm.SHA256, "msg", sig[..]));
        }
        else => { @trap(); }
    }
}
