fn join(lines: [][]u8) ![]mut u8 {
    let mut s = strs.String.init();
    for l in lines {
        s.push_str(l)!;
    }
    return s.take();
}

/// Parses the first certificate of a PEM text.
fn cert_of(lines: [][]u8) !Certificate {
    let text = join(lines)!;
    defer mem.free(text);
    let mut it = pem_blocks(text);
    let b = it.next()!;
    let d = pem_decode(b)!;
    defer mem.free(d);
    return Certificate.parse(d);
}

fn fails_with(r: !void, want: error) bool {
    r catch |e| {
        return e == want;
    };
    return false;
}

// A root excluding the subtree evil.test, and a leaf it signed for "evil.test."
// (a trailing dot must not slip past the constraint).
let NC_ROOT_PEM: [8][]u8 = [
    "-----BEGIN CERTIFICATE-----\n",
    "MIIBEDCBw6ADAgECAgEGMAUGAytlcDARMQ8wDQYDVQQDDAZOQ1Jvb3QwHhcNMjYw\n",
