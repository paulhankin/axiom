let EM_LEAF_PEM: [9][]u8 = [
    "-----BEGIN CERTIFICATE-----\n",
    "MIIBLjCB4aADAgECAgEHMAUGAytlcDA/MQswCQYDVQQGEwJOTDETMBEGA1UECgwK\n",
    "ZU11ZGhyYSBCVjEbMBkGA1UEAwwSRU0gRFYgVExTIENBIC0gRzNCMB4XDTI2MDEw\n",
    "MTAwMDAwMFoXDTM2MDEwMTAwMDAwMFowFDESMBAGA1UEAwwJYmFuay50ZXN0MCow\n",
    "BQYDK2VwAyEAd18V3g8OFVOoxImbLed5ioyjPwPhH0EetdfjAqF3ZnqjLTArMBQG\n",
    "A1UdEQQNMAuCCWJhbmsudGVzdDATBgNVHSUEDDAKBggrBgEFBQcDATAFBgMrZXAD\n",
    "QQCUfRs6m9igKkCb5MzQRN7tyMe8yHYsWZqbhK43FBADn3gJQd3/SZDBo4lyx0YJ\n",
    "GSM1C9jzw2b5sasWoARdPzYE\n",
    "-----END CERTIFICATE-----\n",
];

test "distrusted keys" {
    for d in DISTRUSTED {
        @expect_eq(d.len, 64);
    }
    let mut ca = cert_of(EM_DV_G3B_PEM[..])!;
    defer ca.deinit();
    @expect(distrusted(&ca));
    let now = time.date(2030, 1, 1, 0, 0, 0)!;
    // as a root in the pool
    let mut roots = CertPool.init();
    defer roots.deinit();
    let em = join(EM_DV_G3B_PEM[..])!;
    defer mem.free(em);
    @expect_eq(roots.add_pem(em)!, 1);
    let mut chain: [1]Certificate = [cert_of(EM_LEAF_PEM[..])!];
    defer chain[0].deinit();
    @expect(fails_with(verify_chain(chain[..], &roots, "bank.test", now), error.Distrusted));
    // as an intermediate the peer sends
    let mut other = CertPool.init();
    defer other.deinit();
    let rt = join(ROOT_PEM[..])!;
    defer mem.free(rt);
    _ = other.add_pem(rt)!;
    let mut two: [2]Certificate = [cert_of(EM_LEAF_PEM[..])!, cert_of(EM_DV_G3B_PEM[..])!];
    defer two[0].deinit();
    defer two[1].deinit();
    @expect(fails_with(verify_chain(two[..], &other, "bank.test", now), error.Distrusted));
    // and our own test root is not on the list
    @expect(not distrusted(&other.certs.items()[0]));
}

test "duplicate extensions" {
    let mut c = cert_of(DUP_EXT_PEM[..]) catch |e| {
        @expect_eq(e, error.InvalidCertificate);
        return;
    };
    c.deinit();
    @trap();
}

test "key usage bits" {
    let mut c = cert_of(LEAF_PEM[..])!;
    defer c.deinit();
    // keyCertSign and cRLSign: 1 unused bit
    @expect(c.extension(OID_KEY_USAGE, "\x03\x02\x01\x06")!);
    @expect_eq(c.key_usage, KU_KEY_CERT_SIGN | (1 << 6));
    // digitalSignature, with the unused bits honoured
    @expect(c.extension(OID_KEY_USAGE, "\x03\x02\x07\x80")!);
    @expect_eq(c.key_usage, KU_DIGITAL_SIGNATURE);
    let bad: [4][]u8 = ["\x03\x02\x01\x07", "\x03\x02\x08\x00", "\x03\x01\x01", "\x03\x02\x02\x06"];
    for b in bad {
        _ = c.extension(OID_KEY_USAGE, b) catch continue;
        @trap();
    }
}

test "private keys" {
    let lk = join(LEAF_KEY[..])!;
    defer mem.free(lk);
    let mut k = parse_private_key_pem(lk)!;
    defer k.deinit();
    let mut leaf = cert_of(LEAF_PEM[..])!;
    defer leaf.deinit();
    match k {
        .P256(p) => {
            let mut pubk: [65]u8 = [0; 65];
            p.public_key(pubk[..]);
            @expect_eq(pubk[..], leaf.key.point);
        }
        else => { @trap(); }
    }
    let ek = join(ED_KEY[..])!;
    defer mem.free(ek);
    let mut e = parse_private_key_pem(ek)!;
    let mut ed = cert_of(ED_PEM[..])!;
    defer ed.deinit();
    match e {
        .Ed25519(s) => { @expect_eq(s.public[..], ed.key.point); }
        else        => { @trap(); }
    }
    e.deinit();
    let rk = join(ROOT_KEY[..])!;
    defer mem.free(rk);
    let mut r = parse_private_key_pem(rk)!;
    defer r.deinit();
    let mut root = cert_of(ROOT_PEM[..])!;
    defer root.deinit();
    match r {
        .Rsa(s) => {
            let mut digest: [32]u8 = [0; 32];
            sha2.sha256("msg", digest[..]);
            let mut sig: [256]u8 = [0; 256];
            s.sign_pss(sha2.Algorithm.SHA256, digest[..], sig[..])!;
            @expect(root.key.verify(SigAlg.RSA_PSS, sha2.Algorithm.SHA256, "msg", sig[..]));
        }
        else => { @trap(); }
    }
}
