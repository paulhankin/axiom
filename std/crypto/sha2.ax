fn be32(b: []u8) u32 {
    return (((@as(u32, b[0]) << 24) | (@as(u32, b[1]) << 16)) | (@as(u32, b[2]) << 8)) | @as(u32, b[3]);
}

fn be64(b: []u8) u64 {
    return (@as(u64, be32(b[0..4])) << 32) | @as(u64, be32(b[4..8]));
}

fn put32(b: []mut u8, v: u32) void {
    b[0] = @truncate(u8, v >> 24);
    b[1] = @truncate(u8, v >> 16);
    b[2] = @truncate(u8, v >> 8);
    b[3] = @truncate(u8, v);
}

fn put64(b: []mut u8, v: u64) void {
    put32(b[0..4], @truncate(u32, v >> 32));
    put32(b[4..8], @truncate(u32, v));
}

pub struct Sha256 {
    h: [8]u32,
    buf: [64]u8,
    nbuf: usize,
    total: u64,

    pub fn init() Sha256 {
        return Sha256.{
            h: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19],
            buf: [0; 64],
            nbuf: 0,
            total: 0,
        };
    }

    fn block(self: *mut Sha256, p: []u8) void {
        let mut w: [64]u32 = [0; 64];
        for i in @as(usize, 0)..16 {
            w[i] = be32(p[4 * i..(4 * i) + 4]);
        }
        for i in @as(usize, 16)..64 {
            let a = w[i - 15];
            let b = w[i - 2];
            let s0 = (@rotr(a, 7) ^ @rotr(a, 18)) ^ (a >> 3);
            let s1 = (@rotr(b, 17) ^ @rotr(b, 19)) ^ (b >> 10);
            w[i] = ((w[i - 16] +% s0) +% w[i - 7]) +% s1;
        }
        let mut a = self.h[0];
        let mut b = self.h[1];
        let mut c = self.h[2];
        let mut d = self.h[3];
        let mut e = self.h[4];
        let mut f = self.h[5];
        let mut g = self.h[6];
        let mut h = self.h[7];
        for i in @as(usize, 0)..64 {
            let s1 = (@rotr(e, 6) ^ @rotr(e, 11)) ^ @rotr(e, 25);
            let ch = (e & f) ^ (~e & g);
            let t1 = (((h +% s1) +% ch) +% K256[i]) +% w[i];
            let s0 = (@rotr(a, 2) ^ @rotr(a, 13)) ^ @rotr(a, 22);
            let maj = ((a & b) ^ (a & c)) ^ (b & c);
            let t2 = s0 +% maj;
            h = g;
            g = f;
            f = e;
            e = d +% t1;
            d = c;
            c = b;
            b = a;
            a = t1 +% t2;
        }
        self.h[0] +%= a;
        self.h[1] +%= b;
        self.h[2] +%= c;
        self.h[3] +%= d;
        self.h[4] +%= e;
        self.h[5] +%= f;
        self.h[6] +%= g;
        self.h[7] +%= h;
    }

    pub fn update(self: *mut Sha256, data: []u8) void {
        self.total +%= @as(u64, data.len);
        let mut d = data;
        if self.nbuf > 0 {
            let k = @min(64 - self.nbuf, d.len);
            @mem_copy(self.buf[self.nbuf..self.nbuf + k], d[..k]);
            self.nbuf += k;
            d = d[k..];
            if self.nbuf < 64 {
                return;
            }
            let b = self.buf;
            self.block(b[..]);
            self.nbuf = 0;
        }
        while d.len >= 64 {
            self.block(d[..64]);
            d = d[64..];
        }
        @mem_copy(self.buf[..d.len], d);
        self.nbuf = d.len;
    }

    /// Writes the 32-byte digest to out. The hasher is finished afterwards.
    pub fn final(self: *mut Sha256, out: []mut u8) void {
        let bits = self.total *% 8;
        let mut pad: [72]u8 = [0; 72];
        pad[0] = 0x80;
        let mut n = 64 - ((self.nbuf + 8) % 64);
        if n == 0 {
            n = 64;
        }
        self.update(pad[..n]);
        let mut len: [8]u8 = [0; 8];
        put64(len[..], bits);
        self.update(len[..]);
        for i in @as(usize, 0)..8 {
            put32(out[4 * i..(4 * i) + 4], self.h[i]);
        }
    }
}

pub struct Sha512 {
    h: [8]u64,
    buf: [128]u8,
    nbuf: usize,
    total: u64,
    out_len: usize,  // 64, or 48 for SHA-384

    pub fn init() Sha512 {
        return Sha512.{
            h: [
                0x6a09e667f3bcc908,
                0xbb67ae8584caa73b,
                0x3c6ef372fe94f82b,
                0xa54ff53a5f1d36f1,
                0x510e527fade682d1,
                0x9b05688c2b3e6c1f,
                0x1f83d9abfb41bd6b,
                0x5be0cd19137e2179,
            ],
            buf: [0; 128],
            nbuf: 0,
            total: 0,
            out_len: 64,
        };
    }

    pub fn init384() Sha512 {
        return Sha512.{
            h: [
                0xcbbb9d5dc1059ed8,
                0x629a292a367cd507,
                0x9159015a3070dd17,
                0x152fecd8f70e5939,
                0x67332667ffc00b31,
                0x8eb44a8768581511,
                0xdb0c2e0d64f98fa7,
                0x47b5481dbefa4fa4,
            ],
            buf: [0; 128],
            nbuf: 0,
            total: 0,
            out_len: 48,
        };
    }

    fn block(self: *mut Sha512, p: []u8) void {
        let mut w: [80]u64 = [0; 80];
        for i in @as(usize, 0)..16 {
            w[i] = be64(p[8 * i..(8 * i) + 8]);
        }
        for i in @as(usize, 16)..80 {
            let a = w[i - 15];
            let b = w[i - 2];
            let s0 = (@rotr(a, 1) ^ @rotr(a, 8)) ^ (a >> 7);
            let s1 = (@rotr(b, 19) ^ @rotr(b, 61)) ^ (b >> 6);
            w[i] = ((w[i - 16] +% s0) +% w[i - 7]) +% s1;
        }
        let mut a = self.h[0];
        let mut b = self.h[1];
        let mut c = self.h[2];
        let mut d = self.h[3];
        let mut e = self.h[4];
        let mut f = self.h[5];
        let mut g = self.h[6];
        let mut h = self.h[7];
        for i in @as(usize, 0)..80 {
            let s1 = (@rotr(e, 14) ^ @rotr(e, 18)) ^ @rotr(e, 41);
            let ch = (e & f) ^ (~e & g);
            let t1 = (((h +% s1) +% ch) +% K512[i]) +% w[i];
            let s0 = (@rotr(a, 28) ^ @rotr(a, 34)) ^ @rotr(a, 39);
            let maj = ((a & b) ^ (a & c)) ^ (b & c);
            let t2 = s0 +% maj;
            h = g;
            g = f;
            f = e;
            e = d +% t1;
            d = c;
            c = b;
            b = a;
            a = t1 +% t2;
        }
        self.h[0] +%= a;
        self.h[1] +%= b;
        self.h[2] +%= c;
        self.h[3] +%= d;
        self.h[4] +%= e;
        self.h[5] +%= f;
        self.h[6] +%= g;
        self.h[7] +%= h;
    }

    pub fn update(self: *mut Sha512, data: []u8) void {
        self.total +%= @as(u64, data.len);
        let mut d = data;
        if self.nbuf > 0 {
            let k = @min(128 - self.nbuf, d.len);
            @mem_copy(self.buf[self.nbuf..self.nbuf + k], d[..k]);
            self.nbuf += k;
            d = d[k..];
            if self.nbuf < 128 {
                return;
            }
            let b = self.buf;
            self.block(b[..]);
            self.nbuf = 0;
        }
        while d.len >= 128 {
            self.block(d[..128]);
            d = d[128..];
        }
        @mem_copy(self.buf[..d.len], d);
        self.nbuf = d.len;
    }

    /// Writes the 64-byte (SHA-384: 48-byte) digest to out.
    pub fn final(self: *mut Sha512, out: []mut u8) void {
        let bits = self.total *% 8;
        let mut pad: [144]u8 = [0; 144];
        pad[0] = 0x80;
        let mut n = 128 - ((self.nbuf + 16) % 128);
        if n == 0 {
            n = 128;
        }
        self.update(pad[..n]);
        let mut len: [16]u8 = [0; 16];
        put64(len[8..16], bits);
        self.update(len[..]);
        let mut full: [64]u8 = [0; 64];
        for i in @as(usize, 0)..8 {
            put64(full[8 * i..(8 * i) + 8], self.h[i]);
        }
        @mem_copy(out[..self.out_len], full[..self.out_len]);
    }
}

pub fn sha256(data: []u8, out: []mut u8) void {
    let mut h = Sha256.init();
    h.update(data);
    h.final(out);
}

pub fn sha384(data: []u8, out: []mut u8) void {
    let mut h = Sha512.init384();
    h.update(data);
    h.final(out);
}

pub fn sha512(data: []u8, out: []mut u8) void {
    let mut h = Sha512.init();
    h.update(data);
    h.final(out);
}

/// The hash functions a Hasher can compute.
pub enum Algorithm: u8 {
    SHA256 = 1,
    SHA384 = 2,
    SHA512 = 3,
    SHA1 = 4,  // for protocols that need it (HMAC-SHA1): see sha1.ax
}

/// One of the functions above, chosen at run time.
pub struct Hasher {
    kind: Algorithm,
    s256: Sha256,
    s512: Sha512,
    s1: sha1.Sha1,

    pub fn init(kind: Algorithm) Hasher {
        let mut s = Sha512.init();
        if kind == Algorithm.SHA384 {
            s = Sha512.init384();
        }
        return Hasher.{ kind: kind, s256: Sha256.init(), s512: s, s1: sha1.Sha1.init() };
    }

    /// The digest size in bytes.
    pub fn size(self: *Hasher) usize {
        return digest_size(self.kind);
    }

    pub fn block_size(self: *Hasher) usize {
        if (self.kind == Algorithm.SHA256) or (self.kind == Algorithm.SHA1) {
            return 64;
        }
        return 128;
    }

    pub fn update(self: *mut Hasher, data: []u8) void {
        if self.kind == Algorithm.SHA1 {
            self.s1.update(data);
        } else if self.kind == Algorithm.SHA256 {
            self.s256.update(data);
        } else {
            self.s512.update(data);
        }
    }

    /// Writes size() bytes to out.
    pub fn final(self: *mut Hasher, out: []mut u8) void {
        if self.kind == Algorithm.SHA1 {
            self.s1.final(out);
        } else if self.kind == Algorithm.SHA256 {
            self.s256.final(out);
        } else {
            self.s512.final(out);
        }
    }
}

pub fn digest_size(kind: Algorithm) usize {
    match kind {
        .SHA256 => { return 32; }
        .SHA384 => { return 48; }
        .SHA512 => { return 64; }
        .SHA1   => { return 20; }
    }
}

/// One-shot hash with a Hasher kind.
pub fn hash(kind: Algorithm, data: []u8, out: []mut u8) void {
    let mut h = Hasher.init(kind);
    h.update(data);
    h.final(out);
}

// -----------------------------------------------------------------------------
// Tests (FIPS 180-4 examples)
// -----------------------------------------------------------------------------

fn hex(b: []u8, out: []mut u8) []u8 {
    let digits = "0123456789abcdef";
    for i in 0..b.len {
        out[2 * i] = digits[@as(usize, b[i] >> 4)];
        out[(2 * i) + 1] = digits[@as(usize, b[i] & 15)];
    }
    return out[..2 * b.len];
}

test "sha-256" {
    let mut d: [32]u8 = [0; 32];
    let mut x: [128]u8 = [0; 128];
    sha256("abc", d[..]);
    @expect_eq(hex(d[..], x[..]), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    sha256("", d[..]);
    @expect_eq(hex(d[..], x[..]), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", d[..]);
    @expect_eq(hex(d[..], x[..]), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
    // a million 'a's, fed unevenly
    let mut h = Sha256.init();
    let chunk: [1000]u8 = ['a'; 1000];
    for i in @as(usize, 0)..1000 {
        h.update(chunk[..(i % 7) + 1]);
        h.update(chunk[(i % 7) + 1..]);
    }
    h.final(d[..]);
    @expect_eq(hex(d[..], x[..]), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0");
}

test "sha-384 and sha-512" {
    let mut d: [64]u8 = [0; 64];
    let mut x: [128]u8 = [0; 128];
    sha512("abc", d[..]);
    @expect_eq(hex(d[..], x[..]),
               "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
    sha384("abc", d[..48]);
    @expect_eq(hex(d[..48], x[..]),
               "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7");
    sha512("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
           d[..]);
    @expect_eq(hex(d[..], x[..]),
               "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909");
    hash(Algorithm.SHA256, "abc", d[..32]);
    @expect_eq(hex(d[..32], x[..]), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}
