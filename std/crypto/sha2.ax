// =============================================================================
// std/crypto/sha2.ax - SHA-256, SHA-384 and SHA-512 (FIPS 180-4).
//
//     let mut h = sha2.Sha256.init();
//     h.update("abc");
//     let mut out: [32]u8 = [0; 32];
//     h.final(out[..]);
//
// or sha2.sha256(data, out[..]) in one call. Hasher chooses the function at
// run time, for code (HMAC, HKDF, TLS) that works with several.
//
// Where the processor has SHA instructions they compress the blocks:
// SHA-NI (sha256rnds2, sha256msg1/2) on x86-64 and the ARMv8 SHA2
// extension (sha256h/h2, sha256su0/1) for SHA-256, the ARMv8.2 SHA512
// extension for SHA-384 and SHA-512 (spec §13.5). The choice is made at
// run time (@multiversion), the portable code otherwise.
// =============================================================================

import "../encoding/binary.ax" as binary;
import "sha1.ax" as sha1;

