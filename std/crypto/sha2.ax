// =============================================================================
// std/crypto/sha2.ax - SHA-256, SHA-384 and SHA-512 (FIPS 180-4).
//
//     let mut h = sha2.Sha256.init();
//     h.update("abc");
//     let mut out: [32]u8 = [0; 32];
//     h.final(out[..]);
//
// or sha2.sha256(data, out[..]) in one call. Hasher chooses the function at
// run time, for code (HMAC, HKDF, TLS) that works with several.
// =============================================================================

