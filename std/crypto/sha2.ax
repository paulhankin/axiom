fn put32(b: []mut u8, v: u32) void {
    b[0] = @truncate(u8, v >> 24);
    b[1] = @truncate(u8, v >> 16);
    b[2] = @truncate(u8, v >> 8);
    b[3] = @truncate(u8, v);
}

fn put64(b: []mut u8, v: u64) void {
    put32(b[0..4], @truncate(u32, v >> 32));
    put32(b[4..8], @truncate(u32, v));
}

fn block256_soft(hs: *mut [8]u32, p: []u8) void {
    let mut w: [64]u32 = [0; 64];
    for i in @as(usize, 0)..16 {
        w[i] = binary.u32_be(p[4 * i..(4 * i) + 4]);
    }
    for i in @as(usize, 16)..64 {
        let a = w[i - 15];
        let b = w[i - 2];
        let s0 = (@rotr(a, 7) ^ @rotr(a, 18)) ^ (a >> 3);
        let s1 = (@rotr(b, 17) ^ @rotr(b, 19)) ^ (b >> 10);
        w[i] = ((w[i - 16] +% s0) +% w[i - 7]) +% s1;
    }
    let mut a = hs[0];
    let mut b = hs[1];
    let mut c = hs[2];
    let mut d = hs[3];
    let mut e = hs[4];
    let mut f = hs[5];
    let mut g = hs[6];
    let mut h = hs[7];
    for i in @as(usize, 0)..64 {
        let s1 = (@rotr(e, 6) ^ @rotr(e, 11)) ^ @rotr(e, 25);
        let ch = (e & f) ^ (~e & g);
        let t1 = (((h +% s1) +% ch) +% K256[i]) +% w[i];
        let s0 = (@rotr(a, 2) ^ @rotr(a, 13)) ^ @rotr(a, 22);
        let maj = ((a & b) ^ (a & c)) ^ (b & c);
        let t2 = s0 +% maj;
        h = g;
        g = f;
        f = e;
        e = d +% t1;
        d = c;
        c = b;
        b = a;
        a = t1 +% t2;
    }
    hs[0] +%= a;
    hs[1] +%= b;
    hs[2] +%= c;
    hs[3] +%= d;
    hs[4] +%= e;
    hs[5] +%= f;
    hs[6] +%= g;
    hs[7] +%= h;
}

// The big-endian 32-bit words of 16 bytes.
fn be4(p: []u8) u32x4 {
    let b = @load(u8x16, p);
    return @bit_cast(u32x4, @shuffle(b, b, [3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12]));
}

/// The blocks of p (a multiple of 64 bytes) into the state.
fn blocks256(hs: *mut [8]u32, p: []u8) void @multiversion("sha,ssse3,sse4.1", "sha2") {
    if @target_arch("x86_64") and @target_has("sha") {
        // SHA-NI: the state as ABEF and CDGH (lanes from the last: A, B, E, F)
        let mut s0 = @vec(u32x4, hs[5], hs[4], hs[1], hs[0]);
        let mut s1 = @vec(u32x4, hs[7], hs[6], hs[3], hs[2]);
        let mut i: usize = 0;
        while i < p.len {
            let a0 = s0;
            let c0 = s1;
            let mut w0 = be4(p[i..i + 16]);
            let mut w1 = be4(p[i + 16..i + 32]);
            let mut w2 = be4(p[i + 32..i + 48]);
            let mut w3 = be4(p[i + 48..i + 64]);
            for j in @as(usize, 0)..16 {
                // four rounds: two per sha256rnds2, the words in its low half
                let t = w0 +% @load(u32x4, K256[4 * j..(4 * j) + 4]);
                s1 = @x86_sha256rnds2(s1, s0, t);
                s0 = @x86_sha256rnds2(s0, s1, @shuffle(t, t, [2, 3, 0, 1]));
                // the next four words of the schedule
                let nw = @x86_sha256msg2(@x86_sha256msg1(w0, w1) +% @shuffle(w2, w3, [1, 2, 3, 4]), w3);
                w0 = w1;
                w1 = w2;
                w2 = w3;
                w3 = nw;
            }
            s0 +%= a0;
            s1 +%= c0;
            i += 64;
        }
        hs[0] = @extract_lane(s0, 3);
        hs[1] = @extract_lane(s0, 2);
        hs[4] = @extract_lane(s0, 1);
        hs[5] = @extract_lane(s0, 0);
        hs[2] = @extract_lane(s1, 3);
        hs[3] = @extract_lane(s1, 2);
        hs[6] = @extract_lane(s1, 1);
        hs[7] = @extract_lane(s1, 0);
        return;
    }
    if @target_arch("aarch64") and @target_has("sha2") {
        let mut abcd = @load(u32x4, hs[0..4]);
        let mut efgh = @load(u32x4, hs[4..8]);
        let mut i: usize = 0;
        while i < p.len {
            let a0 = abcd;
            let e0 = efgh;
            let mut w0 = be4(p[i..i + 16]);
            let mut w1 = be4(p[i + 16..i + 32]);
            let mut w2 = be4(p[i + 32..i + 48]);
            let mut w3 = be4(p[i + 48..i + 64]);
            for j in @as(usize, 0)..16 {
                let wk = w0 +% @load(u32x4, K256[4 * j..(4 * j) + 4]);
                let t = abcd;
                abcd = @arm_sha256h(abcd, efgh, wk);
                efgh = @arm_sha256h2(efgh, t, wk);
                let nw = @arm_sha256su1(@arm_sha256su0(w0, w1), w2, w3);
                w0 = w1;
                w1 = w2;
                w2 = w3;
                w3 = nw;
            }
            abcd +%= a0;
            efgh +%= e0;
            i += 64;
        }
        @store(hs[0..4], abcd);
        @store(hs[4..8], efgh);
        return;
    }
    let mut i: usize = 0;
    while i < p.len {
        block256_soft(hs, p[i..i + 64]);
        i += 64;
    }
}

pub struct Sha256 {
    h: [8]u32,
    buf: [64]u8,
    nbuf: usize,
    total: u64,

    pub fn init() Sha256 {
        return Sha256.{
            h: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19],
            buf: [0; 64],
            nbuf: 0,
            total: 0,
        };
    }

    fn block(self: *mut Sha256, p: []u8) void {
        blocks256(&mut self.h, p);
    }

    pub fn update(self: *mut Sha256, data: []u8) void {
        self.total +%= @as(u64, data.len);
        let mut d = data;
        if self.nbuf > 0 {
            let k = @min(64 - self.nbuf, d.len);
            @mem_copy(self.buf[self.nbuf..self.nbuf + k], d[..k]);
            self.nbuf += k;
            d = d[k..];
            if self.nbuf < 64 {
                return;
            }
            let b = self.buf;
            self.block(b[..]);
            self.nbuf = 0;
        }
        let whole = d.len - (d.len % 64);
        if whole > 0 {
            blocks256(&mut self.h, d[..whole]);
            d = d[whole..];
        }
        @mem_copy(self.buf[..d.len], d);
        self.nbuf = d.len;
    }

    /// Writes the 32-byte digest to out. The hasher is finished afterwards.
    pub fn final(self: *mut Sha256, out: []mut u8) void {
        let bits = self.total *% 8;
        let mut pad: [72]u8 = [0; 72];
        pad[0] = 0x80;
        let mut n = 64 - ((self.nbuf + 8) % 64);
        if n == 0 {
            n = 64;
        }
        self.update(pad[..n]);
        let mut len: [8]u8 = [0; 8];
        put64(len[..], bits);
        self.update(len[..]);
        for i in @as(usize, 0)..8 {
            put32(out[4 * i..(4 * i) + 4], self.h[i]);
        }
    }
}

pub struct Sha512 {
    h: [8]u64,
    buf: [128]u8,
    nbuf: usize,
    total: u64,
    out_len: usize,  // 64, or 48 for SHA-384

    pub fn init() Sha512 {
        return Sha512.{
            h: [
                0x6a09e667f3bcc908,
                0xbb67ae8584caa73b,
                0x3c6ef372fe94f82b,
                0xa54ff53a5f1d36f1,
                0x510e527fade682d1,
                0x9b05688c2b3e6c1f,
                0x1f83d9abfb41bd6b,
                0x5be0cd19137e2179,
            ],
            buf: [0; 128],
            nbuf: 0,
            total: 0,
            out_len: 64,
        };
    }

    pub fn init384() Sha512 {
        return Sha512.{
            h: [
                0xcbbb9d5dc1059ed8,
                0x629a292a367cd507,
                0x9159015a3070dd17,
                0x152fecd8f70e5939,
                0x67332667ffc00b31,
                0x8eb44a8768581511,
                0xdb0c2e0d64f98fa7,
                0x47b5481dbefa4fa4,
            ],
            buf: [0; 128],
            nbuf: 0,
            total: 0,
            out_len: 48,
        };
    }

    fn block(self: *mut Sha512, p: []u8) void {
        blocks512(&mut self.h, p);
    }

    pub fn update(self: *mut Sha512, data: []u8) void {
        self.total +%= @as(u64, data.len);
        let mut d = data;
        if self.nbuf > 0 {
            let k = @min(128 - self.nbuf, d.len);
            @mem_copy(self.buf[self.nbuf..self.nbuf + k], d[..k]);
            self.nbuf += k;
            d = d[k..];
            if self.nbuf < 128 {
                return;
            }
            let b = self.buf;
            self.block(b[..]);
            self.nbuf = 0;
        }
        let whole = d.len - (d.len % 128);
        if whole > 0 {
            blocks512(&mut self.h, d[..whole]);
            d = d[whole..];
        }
        @mem_copy(self.buf[..d.len], d);
        self.nbuf = d.len;
    }

    /// Writes the 64-byte (SHA-384: 48-byte) digest to out.
    pub fn final(self: *mut Sha512, out: []mut u8) void {
        let bits = self.total *% 8;
        let mut pad: [144]u8 = [0; 144];
        pad[0] = 0x80;
        let mut n = 128 - ((self.nbuf + 16) % 128);
        if n == 0 {
            n = 128;
        }
        self.update(pad[..n]);
        let mut len: [16]u8 = [0; 16];
        put64(len[8..16], bits);
        self.update(len[..]);
        let mut full: [64]u8 = [0; 64];
        for i in @as(usize, 0)..8 {
            put64(full[8 * i..(8 * i) + 8], self.h[i]);
        }
        @mem_copy(out[..self.out_len], full[..self.out_len]);
    }
}

fn block512_soft(hs: *mut [8]u64, p: []u8) void {
    let mut w: [80]u64 = [0; 80];
    for i in @as(usize, 0)..16 {
        w[i] = binary.u64_be(p[8 * i..(8 * i) + 8]);
    }
    for i in @as(usize, 16)..80 {
        let a = w[i - 15];
        let b = w[i - 2];
        let s0 = (@rotr(a, 1) ^ @rotr(a, 8)) ^ (a >> 7);
        let s1 = (@rotr(b, 19) ^ @rotr(b, 61)) ^ (b >> 6);
        w[i] = ((w[i - 16] +% s0) +% w[i - 7]) +% s1;
    }
    let mut a = hs[0];
    let mut b = hs[1];
    let mut c = hs[2];
    let mut d = hs[3];
    let mut e = hs[4];
    let mut f = hs[5];
    let mut g = hs[6];
    let mut h = hs[7];
    for i in @as(usize, 0)..80 {
        let s1 = (@rotr(e, 14) ^ @rotr(e, 18)) ^ @rotr(e, 41);
        let ch = (e & f) ^ (~e & g);
        let t1 = (((h +% s1) +% ch) +% K512[i]) +% w[i];
        let s0 = (@rotr(a, 28) ^ @rotr(a, 34)) ^ @rotr(a, 39);
        let maj = ((a & b) ^ (a & c)) ^ (b & c);
        let t2 = s0 +% maj;
        h = g;
        g = f;
        f = e;
        e = d +% t1;
        d = c;
        c = b;
        b = a;
        a = t1 +% t2;
    }
    hs[0] +%= a;
    hs[1] +%= b;
    hs[2] +%= c;
    hs[3] +%= d;
    hs[4] +%= e;
    hs[5] +%= f;
    hs[6] +%= g;
    hs[7] +%= h;
}
// SHA-512 with the ARMv8.2 SHA512 instructions: two rounds per dround over
// five vector registers that change roles each time (after the Linux
// kernel's sha512-ce-core.S), the schedule eight registers of two words.
let ROLES: [5][5]usize = [[0, 1, 2, 3, 4], [3, 0, 4, 2, 1], [2, 3, 1, 4, 0], [4, 2, 0, 1, 3], [1, 4, 3, 0, 2]];

fn be8x2(p: []u8) u64x2 {
    let b = @load(u8x16, p);
    return @bit_cast(u64x2, @shuffle(b, b, [7, 6, 5, 4, 3, 2, 1, 0, 15, 14, 13, 12, 11, 10, 9, 8]));
}

/// The blocks of p (a multiple of 128 bytes) into the state.
fn blocks512(hs: *mut [8]u64, p: []u8) void @multiversion("sha512") {
    if @target_arch("aarch64") and @target_has("sha512") {
        let mut hv: [4]u64x2 = [
            @load(u64x2, hs[0..2]), @load(u64x2, hs[2..4]), @load(u64x2, hs[4..6]), @load(u64x2, hs[6..8])];
        let mut i: usize = 0;
        while i < p.len {
            let mut st: [5]u64x2 = [hv[0], hv[1], hv[2], hv[3], hv[0]];
            let mut m: [8]u64x2 = [@splat(@as(u64, 0)); 8];
            for k in @as(usize, 0)..8 {
                m[k] = be8x2(p[i + (16 * k)..i + (16 * k) + 16]);
            }
            for t in @as(usize, 0)..40 {
                let r = ROLES[t % 5];
                let in0 = t % 8;
                let rc = @load(u64x2, K512[2 * t..(2 * t) + 2]);
                let mut v5 = rc +% m[in0];
                let v6 = @shuffle(st[r[2]], st[r[3]], [1, 2]);
                v5 = @shuffle(v5, v5, [1, 0]);
                let v7 = @shuffle(st[r[1]], st[r[2]], [1, 2]);
                st[r[3]] = st[r[3]] +% v5;
                if t < 32 {
                    let x = @shuffle(m[(t + 4) % 8], m[(t + 5) % 8], [1, 2]);
                    let s0 = @arm_sha512su0(m[in0], m[(t + 1) % 8]);
                    m[in0] = @arm_sha512su1(s0, m[(t + 7) % 8], x);
                }
                st[r[3]] = @arm_sha512h(st[r[3]], v6, v7);
                st[r[4]] = st[r[1]] +% st[r[3]];
                st[r[3]] = @arm_sha512h2(st[r[3]], st[r[1]], st[r[0]]);
            }
            for k in @as(usize, 0)..4 {
                hv[k] = hv[k] +% st[k];
            }
            i += 128;
        }
        for k in @as(usize, 0)..4 {
            @store(hs[2 * k..(2 * k) + 2], hv[k]);
        }
        return;
    }
    let mut i: usize = 0;
    while i < p.len {
        block512_soft(hs, p[i..i + 128]);
        i += 128;
    }
}

pub fn sha256(data: []u8, out: []mut u8) void {
    let mut h = Sha256.init();
    h.update(data);
    h.final(out);
}

pub fn sha384(data: []u8, out: []mut u8) void {
    let mut h = Sha512.init384();
    h.update(data);
    h.final(out);
}

pub fn sha512(data: []u8, out: []mut u8) void {
    let mut h = Sha512.init();
    h.update(data);
    h.final(out);
}

/// The hash functions a Hasher can compute.
pub enum Algorithm: u8 {
    SHA256 = 1,
    SHA384 = 2,
    SHA512 = 3,
    SHA1 = 4,  // for protocols that need it (HMAC-SHA1): see sha1.ax
}

/// One of the functions above, chosen at run time.
pub struct Hasher {
    kind: Algorithm,
    s256: Sha256,
    s512: Sha512,
    s1: sha1.Sha1,

    pub fn init(kind: Algorithm) Hasher {
        let mut s = Sha512.init();
        if kind == Algorithm.SHA384 {
            s = Sha512.init384();
        }
        return Hasher.{ kind: kind, s256: Sha256.init(), s512: s, s1: sha1.Sha1.init() };
    }

    /// The digest size in bytes.
    pub fn size(self: *Hasher) usize {
        return digest_size(self.kind);
    }

    pub fn block_size(self: *Hasher) usize {
        if (self.kind == Algorithm.SHA256) or (self.kind == Algorithm.SHA1) {
            return 64;
        }
        return 128;
    }

    pub fn update(self: *mut Hasher, data: []u8) void {
        if self.kind == Algorithm.SHA1 {
            self.s1.update(data);
        } else if self.kind == Algorithm.SHA256 {
            self.s256.update(data);
        } else {
            self.s512.update(data);
        }
    }

    /// Writes size() bytes to out.
    pub fn final(self: *mut Hasher, out: []mut u8) void {
        if self.kind == Algorithm.SHA1 {
            self.s1.final(out);
        } else if self.kind == Algorithm.SHA256 {
            self.s256.final(out);
        } else {
            self.s512.final(out);
        }
    }
}

pub fn digest_size(kind: Algorithm) usize {
    match kind {
        .SHA256 => { return 32; }
        .SHA384 => { return 48; }
        .SHA512 => { return 64; }
        .SHA1   => { return 20; }
    }
}

/// One-shot hash with a Hasher kind.
pub fn hash(kind: Algorithm, data: []u8, out: []mut u8) void {
    let mut h = Hasher.init(kind);
    h.update(data);
    h.final(out);
}

// -----------------------------------------------------------------------------
// Tests (FIPS 180-4 examples)
// -----------------------------------------------------------------------------

fn hex(b: []u8, out: []mut u8) []u8 {
    let digits = "0123456789abcdef";
    for i in 0..b.len {
        out[2 * i] = digits[@as(usize, b[i] >> 4)];
        out[(2 * i) + 1] = digits[@as(usize, b[i] & 15)];
    }
    return out[..2 * b.len];
}

test "sha-256" {
    let mut d: [32]u8 = [0; 32];
    let mut x: [128]u8 = [0; 128];
    sha256("abc", d[..]);
    @expect_eq(hex(d[..], x[..]), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    sha256("", d[..]);
    @expect_eq(hex(d[..], x[..]), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", d[..]);
    @expect_eq(hex(d[..], x[..]), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
    // a million 'a's, fed unevenly
    let mut h = Sha256.init();
    let chunk: [1000]u8 = ['a'; 1000];
    for i in @as(usize, 0)..1000 {
        h.update(chunk[..(i % 7) + 1]);
        h.update(chunk[(i % 7) + 1..]);
    }
    h.final(d[..]);
    @expect_eq(hex(d[..], x[..]), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0");
}

test "sha-384 and sha-512" {
    let mut d: [64]u8 = [0; 64];
    let mut x: [128]u8 = [0; 128];
    sha512("abc", d[..]);
    @expect_eq(hex(d[..], x[..]),
               "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
    sha384("abc", d[..48]);
    @expect_eq(hex(d[..48], x[..]),
               "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7");
    sha512("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
           d[..]);
    @expect_eq(hex(d[..], x[..]),
               "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909");
    hash(Algorithm.SHA256, "abc", d[..32]);
    @expect_eq(hex(d[..32], x[..]), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}

// a deterministic stream of test bytes (xorshift)
fn fill(state: *mut u64, out: []mut u8) void {
    for i in 0..out.len {
        let mut x = state.*;
        x ^= x << 13;
        x ^= x >> 7;
        x ^= x << 17;
        state.* = x;
        out[i] = @truncate(u8, x >> 24);
    }
}

test "the processor's instructions agree with the portable code" {
    let mut st: u64 = 0x9e37_79b9_7f4a_7c15;
    let mut data: [1024]u8 = [0; 1024];
    for t in @as(usize, 0)..16 {
        let n = 64 * (t + 1);
        fill(&mut st, data[..n]);
        let mut a: [8]u32 = [0; 8];
        let mut b: [8]u32 = [0; 8];
        for k in @as(usize, 0)..8 {
            a[k] = @truncate(u32, st >> @as(u64, 4 * k));
            b[k] = a[k];
        }
        blocks256(&mut a, data[..n]);
        let mut i: usize = 0;
        while i < n {
            block256_soft(&mut b, data[i..i + 64]);
            i += 64;
        }
        for k in @as(usize, 0)..8 {
            @expect_eq(a[k], b[k]);
        }
        let m = 128 * ((t % 8) + 1);
        let mut c: [8]u64 = [0; 8];
        let mut e: [8]u64 = [0; 8];
        for k in @as(usize, 0)..8 {
            c[k] = st *% @as(u64, k + 1);
            e[k] = c[k];
        }
        blocks512(&mut c, data[..m]);
        i = 0;
        while i < m {
            block512_soft(&mut e, data[i..i + 128]);
            i += 128;
        }
        for k in @as(usize, 0)..8 {
            @expect_eq(c[k], e[k]);
        }
    }
}
