// =============================================================================
// std/crypto/der.ax - reading ASN.1 DER (X.690), as used by X.509 and key
// files.
//
//     let mut r = der.Reader.init(bytes);
//     let mut seq = r.sequence()!;          // a Reader over the contents
//     let n = seq.integer()!;               // big-endian magnitude
//     let oid = seq.oid()!;                 // encoded OID bytes
//
// Only DER is accepted: definite, minimal lengths and low tag numbers.
// Readers are views: nothing is copied or allocated.
// =============================================================================

import "../time.ax" as time;

pub error DerError { Corrupt, UnexpectedTag, Done }

pub const INTEGER: u8 = 0x02;
pub const BIT_STRING: u8 = 0x03;
pub const OCTET_STRING: u8 = 0x04;
pub const NULL: u8 = 0x05;
pub const OID: u8 = 0x06;
pub const UTF8_STRING: u8 = 0x0c;
pub const PRINTABLE_STRING: u8 = 0x13;
pub const IA5_STRING: u8 = 0x16;
pub const UTC_TIME: u8 = 0x17;
pub const GENERALIZED_TIME: u8 = 0x18;
pub const SEQUENCE: u8 = 0x30;
pub const SET: u8 = 0x31;
pub const BOOLEAN: u8 = 0x01;

/// The tag of an explicit or implicit context-specific field [n].
pub fn context(n: u8, constructed: bool) u8 {
    if constructed {
        return 0xa0 | n;
    }
    return 0x80 | n;
}

/// One element: its tag, its contents, and all of its bytes.
pub struct Element {
    tag: u8,
    content: []u8,
    raw: []u8,
}

pub struct Reader {
    data: []u8,
    pos: usize,

    pub fn init(data: []u8) Reader {
        return Reader.{ data: data, pos: 0 };
    }

    pub fn empty(self: *Reader) bool {
        return self.pos >= self.data.len;
    }

    /// The tag of the next element (0 at the end).
    pub fn peek_tag(self: *Reader) u8 {
        if self.pos >= self.data.len {
            return 0;
        }
        return self.data[self.pos];
    }

    /// The next element, whatever it is.
    pub fn next(self: *mut Reader) DerError!Element {
        let d = self.data;
        let start = self.pos;
        if (start + 2) > d.len {
            return error.Corrupt;
        }
        let tag = d[start];
        if (tag & 0x1f) == 0x1f {
            return error.Corrupt;  // high tag numbers are not used here
        }
        let mut i = start + 1;
        let first = d[i];
        i += 1;
        let mut len: usize = 0;
        if first < 0x80 {
            len = @as(usize, first);
        } else {
            let n = @as(usize, first & 0x7f);
            if (n == 0) or (n > 4) or ((i + n) > d.len) {
                return error.Corrupt;  // indefinite or absurd
            }
            if d[i] == 0 {
                return error.Corrupt;  // not minimal
            }
            for k in 0..n {
                len = (len << 8) | @as(usize, d[i + k]);
            }
            i += n;
            if len < 0x80 {
                return error.Corrupt;  // should have used the short form
            }
        }
        if len > (d.len - i) {
            return error.Corrupt;
        }
        self.pos = i + len;
        return Element.{ tag: tag, content: d[i..i + len], raw: d[start..i + len] };
    }

    /// The next element, which must have the given tag.
    pub fn expect(self: *mut Reader, tag: u8) DerError!Element {
        if self.peek_tag() != tag {
            return error.UnexpectedTag;
        }
        return self.next();
    }

    /// Skips the next element if it has the given tag; true if it did.
    pub fn skip_if(self: *mut Reader, tag: u8) DerError!bool {
        if self.peek_tag() != tag {
            return false;
        }
        _ = self.next()!;
        return true;
    }

    /// A Reader over the contents of the next SEQUENCE.
    pub fn sequence(self: *mut Reader) DerError!Reader {
        return Reader.init(self.expect(SEQUENCE)!.content);
    }

    /// A Reader over the contents of the next element with the given
    /// (constructed) tag, such as an explicit [0].
    pub fn nested(self: *mut Reader, tag: u8) DerError!Reader {
        return Reader.init(self.expect(tag)!.content);
    }

    /// A non-negative INTEGER's magnitude, big-endian without leading zeros
    /// (fails on negative numbers).
    pub fn integer(self: *mut Reader) DerError![]u8 {
        let c = self.expect(INTEGER)!.content;
        if c.len == 0 {
            return error.Corrupt;
        }
        if (c[0] & 0x80) != 0 {
            return error.Corrupt;  // negative
        }
        if (c.len > 1) and (c[0] == 0) {
            if (c[1] & 0x80) == 0 {
                return error.Corrupt;  // not minimal
            }
            return c[1..];
        }
        return c;
    }

    /// A small INTEGER as i64 (negative values allowed).
    pub fn small_integer(self: *mut Reader) DerError!i64 {
        let c = self.expect(INTEGER)!.content;
        if (c.len == 0) or (c.len > 8) {
            return error.Corrupt;
        }
        // DER: the shortest encoding (no redundant leading 00 or ff byte)
        if (c.len > 1) and (((c[0] == 0) and ((c[1] & 0x80) == 0)) or ((c[0] == 0xff) and ((c[1] & 0x80) != 0))) {
            return error.Corrupt;
        }
        let mut v: i64 = 0;
        if (c[0] & 0x80) != 0 {
            v = -1;
        }
        for b in c {
            v = (v << 8) | @as(i64, b);
        }
        return v;
    }

    pub fn boolean(self: *mut Reader) DerError!bool {
        let c = self.expect(BOOLEAN)!.content;
        if c.len != 1 {
            return error.Corrupt;
        }
        if c[0] == 0 {
            return false;
        }
        if c[0] == 0xff {
            return true;
        }
        return error.Corrupt;
    }

    /// The encoded bytes of an OBJECT IDENTIFIER (compare with oid values
    /// such as "\x2a\x86\x48\x86\xf7\x0d\x01\x01\x0b").
    pub fn oid(self: *mut Reader) DerError![]u8 {
        return self.expect(OID)!.content;
    }

    /// A BIT STRING's bytes (which must have no unused bits).
    pub fn bit_string(self: *mut Reader) DerError![]u8 {
        let c = self.expect(BIT_STRING)!.content;
        if (c.len == 0) or (c[0] != 0) {
            return error.Corrupt;
        }
        return c[1..];
    }

    pub fn octet_string(self: *mut Reader) DerError![]u8 {
        return self.expect(OCTET_STRING)!.content;
    }

    /// A UTCTime or GeneralizedTime (in UTC, "Z" form, as X.509 requires).
    pub fn time_value(self: *mut Reader) DerError!time.Time {
        let e = self.next()!;
        let s = e.content;
        let mut year: i64 = 0;
        let mut at: usize = 0;
        if (e.tag == UTC_TIME) and (s.len == 13) {
            let yy = @as(i64, digits(s[0..2])!);
            year = 1900 + yy;
            if yy < 50 {
                year = 2000 + yy;
            }
            at = 2;
        } else if (e.tag == GENERALIZED_TIME) and (s.len == 15) {
            year = @as(i64, digits(s[0..4])!);
            at = 4;
        } else {
            return error.Corrupt;
        }
        if s[s.len - 1] != 'Z' {
            return error.Corrupt;
        }
        let mo = digits(s[at..at + 2])!;
        let d = digits(s[at + 2..at + 4])!;
        let h = digits(s[at + 4..at + 6])!;
        let mi = digits(s[at + 6..at + 8])!;
        let se = digits(s[at + 8..at + 10])!;
        return time.date(year, mo, d, h, mi, se) catch return error.Corrupt;
    }
}

fn digits(s: []u8) DerError!u32 {
    let mut v: u32 = 0;
    for c in s {
        if (c < '0') or (c > '9') {
            return error.Corrupt;
        }
        v = (v * 10) + @as(u32, c - '0');
    }
    return v;
}

test "reading der" {
    // SEQUENCE { INTEGER 128, OID 1.2.840.113549, BOOLEAN true, [0] { NULL } }
    let data = "\x30\x13\x02\x02\x00\x80\x06\x06\x2a\x86\x48\x86\xf7\x0d\x01\x01\xff\xa0\x02\x05\x00";
    let mut r = Reader.init(data);
    let mut s = r.sequence()!;
    @expect(r.empty());
    @expect_eq(s.integer()!, "\x80");
    @expect_eq(s.oid()!, "\x2a\x86\x48\x86\xf7\x0d");
    @expect(s.boolean()!);
    let mut inner = s.nested(context(0, true))!;
    @expect_eq(inner.next()!.tag, NULL);
    @expect(s.empty());
    let mut t = Reader.init("\x17\x0d\x32\x36\x30\x39\x32\x38\x31\x32\x30\x30\x30\x30\x5a");
    let tv = t.time_value()!;
    let mut b: [40]u8 = [0; 40];
    @expect_eq(tv.format_rfc3339(b[..]), "2026-09-28T12:00:00Z");
    let bad: [4][]u8 = ["\x30\x81\x05\x00\x00\x00\x00\x00", "\x30\x80\x00\x00", "\x02\x02\x00\x01", "\x30\x05\x00"];
    for x in bad {
        let mut rr = Reader.init(x);
        let el = rr.next() catch continue;
        if el.tag == INTEGER {
            let mut r2 = Reader.init(x);
            _ = r2.integer() catch continue;
        }
        @trap();
    }
}
