// =============================================================================
// std/mem/slab.ax - small-object spans and per-thread caches (part of std/mem).
// =============================================================================

// -----------------------------------------------------------------------------
// Small objects
// -----------------------------------------------------------------------------
fn partial_remove(i: usize, s: usize) void {
    let sp = span(s);
    if sp.prev != 0 {
        span(sp.prev).next = sp.next;
    } else {
        partial[i] = sp.next;
    }
    if sp.next != 0 {
        span(sp.next).prev = sp.prev;
    }
}

// The heap's current span for class c has no free object: finds one that
// has, and allocates from it. 0 if memory is exhausted.
fn refill(h: usize, c: usize) usize {
    let i = (h * NCLS) + c;
    let old = active[i];
    if old != 0 {
        span(old).state = FULL;
        active[i] = 0;
    }
    let mut s = partial[i];
    if s != 0 {
        partial_remove(i, s);
    } else {
        pool_enter();
        s = span_take();
        pool_leave();
        if s == 0 {
            return 0;
        }
        let sp = span(s);
        let osize = @as(usize, class_size[c]);
        sp.free = 0;
        sp.bump = s + HDR;
        sp.end = s + HDR + (((PAGE - HDR) / osize) * osize);
        sp.osize = class_size[c];
        let mut odd = class_size[c];
        let mut sh: u32 = 0;
        while (odd & 1) == 0 {
            odd >>= 1;
            sh += 1;
        }
        let mut inv = odd;
        for _k in @as(usize, 0)..5 {
            inv = inv *% (2 -% (odd *% inv));
        }
        sp.dshift = sh;
        sp.dinv = inv;
        sp.dlim = 0xffffffff / odd;
        sp.used = 0;
        sp.cls = @truncate(u32, c);
        sp.heap = @truncate(u32, h);
    }
    let sp = span(s);
    sp.state = ACTIVE;
    sp.next = 0;
    sp.prev = 0;
    active[i] = s;
    return span_alloc(sp, h);
}

fn span_alloc(sp: *mut Span, h: usize) usize {
    let mut p = sp.free;
    if p != 0 {
        sp.free = word(p).*;
    } else {
        p = sp.bump;
        sp.bump += @as(usize, sp.osize);
    }
    sp.used += 1;
    heap_bytes[h] += @as(usize, sp.osize);
    return p;
}

// Takes an object of class c from heap h (locked), or 0 if memory is
// exhausted.
fn heap_alloc(h: usize, c: usize) usize {
    let s = active[(h * NCLS) + c];
    if s != 0 {
        let sp = span(s);
        if (sp.free != 0) or (sp.bump < sp.end) {
            return span_alloc(sp, h);
        }
    }
    return refill(h, c);
}

// Puts span s, which has a free object again, in its heap's list of partial
// spans: in address order as far as a few steps go, so that refill (which
// takes the first) prefers low spans and high ones can drain and go back.
fn partial_insert(i: usize, s: usize) void {
    let sp = span(s);
    sp.state = PARTIAL;
    let mut before: usize = 0;
    let mut q = partial[i];
    let mut k: u32 = 0;
    while (q != 0) and (q < s) and (k < 16) {
        before = q;
        q = span(q).next;
        k += 1;
    }
    sp.prev = before;
    sp.next = q;
    if before != 0 {
        span(before).next = s;
    } else {
        partial[i] = s;
    }
    if q != 0 {
        span(q).prev = s;
    }
}

// Takes up to n more objects from span sp of heap h (locked), linked after
// `last` (whose link is set, to 0 after the last); returns how many.
fn span_take_batch(sp: *mut Span, h: usize, last0: usize, n: u32) u32 {
    let mut last = last0;
    let mut got: u32 = 0;
    // the span's free list is linked already: cut it after n objects
    let f = sp.free;
    if (f != 0) and (n > 0) {
        let mut q = f;
        got = 1;
        while (got < n) and (word(q).* != 0) {
            q = word(q).*;
            got += 1;
        }
        word(last).* = f;
        last = q;
        sp.free = word(q).*;
    }
    // then objects never handed out
    let os = @as(usize, sp.osize);
    let mut b = sp.bump;
    while (got < n) and (b < sp.end) {
        word(last).* = b;
        last = b;
        b += os;
        got += 1;
    }
    sp.bump = b;
    word(last).* = 0;
    sp.used += got;
    heap_bytes[h] += @as(usize, got) * os;
    return got;
}

// Returns object p (checked) to its span, of heap h (locked).
fn span_free(h: usize, p: usize) void {
    let s = p & ~(PAGE - 1);
    let sp = span(s);
    if p == sp.free {
        @trap();  // freed twice
    }
    word(p).* = sp.free;
    sp.free = p;
    sp.used -= 1;
    heap_bytes[h] -= @as(usize, sp.osize);
    if sp.state == FULL {
        partial_insert((h * NCLS) + @as(usize, sp.cls), s);
    } else if (sp.state == PARTIAL) and (sp.used == 0) {
        partial_remove((h * NCLS) + @as(usize, sp.cls), s);
        pool_enter();
        span_give(s);
        pool_leave();
    }
}

// Traps unless p is an object of a span, of class c0 or above (an aligned
// allocation may come from a larger class than its size's).
fn small_check(p: usize, c0: usize) void {
    let s = p & ~(PAGE - 1);
    let sp = span(s);
    if (sp.magic != tag(MAGIC_SPAN, s)) or (sp.cls < @truncate(u32, c0)) or (sp.state == CACHED) or
       not is_object_start(sp, s, p) {
        @trap();  // not an object of this size from the allocator
    }
}

// An object of class c straight from the thread's heap (no cache: one thread,
// or the address sanitizer's allocations).
fn small_alloc(c: usize) usize {
    let h = my_heap();
    let m = multi;
    if m {
        lock(&mut heap_lock[h]);
    }
    let r = heap_alloc(h, c);
    if m {
        unlock(&mut heap_lock[h]);
    }
    return r;
}

fn small_free(p: usize, c0: usize) void {
    small_check(p, c0);
    let h = @as(usize, span(p & ~(PAGE - 1)).heap);
    let m = multi;
    if m {
        lock(&mut heap_lock[h]);
    }
    span_free(h, p);
    if m {
        unlock(&mut heap_lock[h]);
    }
}

// -----------------------------------------------------------------------------
// Per-thread caches
//
// Once threads run, each thread keeps, per small class, a stack of free
// objects (linked through their first word), so that most allocations and
// frees take no lock and no atomic operation. An empty stack is refilled from
// the thread's heap with a batch of objects under one lock; a stack past its
// limit gives back half of it, grouped by the heap owning each object (one
// lock per heap: objects freed by a thread other than the one that allocated
// them are cached like any other, and go back to their heap in a batch). A
// class's limit starts small and doubles each time its stack runs empty or
// over, up to CACHE_BYTES of objects (CACHE_MIN to CACHE_MAX of them); every
// GC_EVERY misses and flushes, one class (in turn) whose stack was not
// refilled or flushed since its last turn gives back half of what it holds
// and halves its limit. A thread's cache is emptied when it ends
// (thread_exit, from std/thread). Before a second thread starts the caches
// are not used (see cache_alloc).
// -----------------------------------------------------------------------------
const CACHE_BYTES: usize = 65536;
const CACHE_MAX: u32 = 256;  // objects per class, at most
const CACHE_MIN: u32 = 4;    // the smallest limit
const CACHE_START: u32 = 8;  // a class's first limit
const GC_EVERY: u32 = 16;

struct TCache {
    head: [32]usize,  // per class, the newest free object (0: none)
    count: [32]u32,   // objects in the stack
    limit: [32]u32,   // a free beyond this many flushes
    touched: u32,     // bit c: class c was refilled or flushed since its collection
    heap: u32,        // the thread's heap + 1; 0 until set up (by the first miss or flush)
    ticks: u32,       // misses and flushes, for the collection
    gc_next: u32,     // the class collected next
    misses: u64,
    flushes: u64,
    next: usize,  // links in the list of set-up caches (caches)
    prev: usize,
}

threadlocal let mut tc: TCache = TCache.{ head: [0; 32], count: [0; 32], limit: [0; 32], touched: 0, heap: 0, ticks: 0,
                                          gc_next: 0, misses: 0, flushes: 0, next: 0, prev: 0 };
let mut caches: usize = 0;     // the threads' caches (pool lock)
let mut gone_misses: u64 = 0;  // counters of the caches of threads that ended
let mut gone_flushes: u64 = 0;

fn cache_cap(c: usize) u32 {
    let n = CACHE_BYTES / @as(usize, class_size[c]);
    return @truncate(u32, @min(@max(n, @as(usize, CACHE_MIN)), @as(usize, CACHE_MAX)));
}

fn cache_of(a: usize) *mut TCache {
    return @ptr_from_int(*mut TCache, a);
}

// Gives the calling thread a heap (the one fewest threads use) and its
// cache its limits, the first time.
fn cache_setup() void {
    if tc.heap != 0 {
        return;
    }
    pool_enter();
    let mut h: usize = 0;
    if multi {
        for k in 1..nheaps {
            if heap_threads[k] < heap_threads[h] {
                h = k;
            }
        }
    }
    heap_threads[h] += 1;
    tc.heap = @truncate(u32, h + 1);
    let me = @int_from_ptr(&mut tc);
    tc.prev = 0;
    tc.next = caches;
    if caches != 0 {
        cache_of(caches).prev = me;
    }
    caches = me;
    pool_leave();
    for c in 0..NCLS {
        tc.limit[c] = @min(CACHE_START, cache_cap(c));
    }
}

/// An object of class c, from the thread's cache; 0 if memory is exhausted.
/// (Before a second thread starts there is no lock to save, and objects come
/// from their spans, small_alloc and small_free: so that allocations fill the
/// current span, and spans whose objects are freed drain and go back, rather
/// than being spread by a cache's reuse of whatever was freed last. Measured,
/// that kept the memory of a shrinking workload from going back.)
fn cache_alloc(c: usize) usize {
    let p = tc.head[c];
    if p != 0 {
        tc.head[c] = word(p).*;
        tc.count[c] -= 1;
        return p;
    }
    return cache_miss(c);
}

// The cache of class c is empty: refills it with a batch from the thread's
// heap, and returns one object.
fn cache_miss(c: usize) usize {
    cache_setup();
    let mut lim = tc.limit[c];
    let cap = cache_cap(c);
    if lim < cap {
        lim = @min(cap, lim * 2);
        tc.limit[c] = lim;
    }
    let want = @max(lim / 2, 1);
    let h = @as(usize, tc.heap - 1);
    let m = multi;
    if m {
        lock(&mut heap_lock[h]);
    }
    // the first object as one alloc would take it (refilling the heap's span
    // if need be), then more from the same span
    let first = heap_alloc(h, c);
    let mut got: u32 = 0;
    if first != 0 {
        got = 1 + span_take_batch(span(active[(h * NCLS) + c]), h, first, want - 1);
    }
    if m {
        unlock(&mut heap_lock[h]);
    }
    if first == 0 {
        return 0;
    }
    tc.head[c] = word(first).*;
    tc.count[c] = got - 1;
    tc.misses += 1;
    tc.touched |= @as(u32, 1) << @truncate(u32, c);
    cache_tick();
    return first;
}

/// Frees object p (of class c0 or, if aligned, above) into the thread's cache.
fn cache_free(p: usize, c0: usize) void {
    small_check(p, c0);
    let c = @as(usize, span(p & ~(PAGE - 1)).cls);
    let top = tc.head[c];
    if p == top {
        @trap();  // freed twice
    }
    word(p).* = top;
    tc.head[c] = p;
    tc.count[c] += 1;
    if tc.count[c] > tc.limit[c] {
        cache_overflow(c);
    }
}

// The cache of class c is past its limit: gives back the older half.
fn cache_overflow(c: usize) void {
    cache_setup();
    let mut lim = tc.limit[c];
    if tc.count[c] <= lim {
        return;
    }
    let cap = cache_cap(c);
    if lim < cap {
        lim = @min(cap, lim * 2);
        tc.limit[c] = lim;
    }
    cache_trim(c, lim / 2);
    tc.flushes += 1;
    tc.touched |= @as(u32, 1) << @truncate(u32, c);
    cache_tick();
}

// Gives back all but `keep` objects of class c's cache (the newest: they
// are found without walking past them).
fn cache_trim(c: usize, keep: u32) void {
    let n = tc.count[c];
    if n <= keep {
        return;
    }
    let rest = tc.head[c];
    let mut q = rest;
    for _k in @as(u32, 1)..(n - keep) {
        q = word(q).*;
    }
    tc.head[c] = word(q).*;
    word(q).* = 0;
    tc.count[c] = keep;
    release_list(rest);
}

// Returns a list of objects to their spans, taking each heap's lock once.
fn release_list(list0: usize) void {
    let mut list = list0;
    let m = multi;
    while list != 0 {
        let h = span(list & ~(PAGE - 1)).heap;
        if m {
            lock(&mut heap_lock[@as(usize, h)]);
        }
        let mut other: usize = 0;
        let mut q = list;
        while q != 0 {
            let nx = word(q).*;
            if span(q & ~(PAGE - 1)).heap == h {
                span_free(@as(usize, h), q);
            } else {
                word(q).* = other;
                other = q;
            }
            q = nx;
        }
        if m {
            unlock(&mut heap_lock[@as(usize, h)]);
        }
        list = other;
    }
}

// The incremental collection: a step every GC_EVERY misses and flushes.
fn cache_tick() void {
    tc.ticks += 1;
    if (tc.ticks % GC_EVERY) != 0 {
        return;
    }
    let c = @as(usize, tc.gc_next);
    tc.gc_next = @truncate(u32, (c + 1) % NCLS);
    let bit = @as(u32, 1) << @truncate(u32, c);
    if ((tc.touched & bit) == 0) and (tc.count[c] > 0) {
        cache_trim(c, tc.count[c] / 2);
        tc.limit[c] = @max(tc.limit[c] / 2, @min(CACHE_MIN, cache_cap(c)));
    }
    tc.touched &= ~bit;
}

/// Called by std/thread when a thread's function returns: gives back the
/// objects in the thread's cache, and its place on its heap.
pub fn thread_exit() void {
    if tc.heap == 0 {
        return;
    }
    for c in 0..NCLS {
        cache_trim(c, 0);
        tc.limit[c] = 0;  // (a later free sets the cache up again)
    }
    pool_enter();
    if tc.prev != 0 {
        cache_of(tc.prev).next = tc.next;
    } else {
        caches = tc.next;
    }
    if tc.next != 0 {
        cache_of(tc.next).prev = tc.prev;
    }
    heap_threads[@as(usize, tc.heap - 1)] -= 1;
    gone_misses += tc.misses;
    gone_flushes += tc.flushes;
    pool_leave();
    tc.heap = 0;
    tc.misses = 0;
    tc.flushes = 0;
}

// Bytes of free objects in the threads' caches (pool lock).
fn cached_bytes() usize {
    let mut n: usize = 0;
    let mut a = caches;
    while a != 0 {
        let t = cache_of(a);
        for c in 0..NCLS {
            n += @as(usize, t.count[c]) * @as(usize, class_size[c]);
        }
        a = t.next;
    }
    return n;
}
