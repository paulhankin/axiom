// =============================================================================
// std/mem/tests.ax - tests for the global allocator (part of std/mem).
// =============================================================================

fn class_by_formula(size: usize) usize {
    if size <= 128 {
        return ((size + 15) >> 4) - 1;
    }
    let x = size - 1;
    let b = log2(x);
    return (8 + ((b - 7) * 4) + (x >> (b - 2))) - 4;
}

test "size classes" {
    for sz in @as(usize, 1)..SMALL_MAX + 1 {
        @expect_eq(class_of(sz), class_by_formula(sz));
    }
    let mut s: usize = 1;
    while s <= SMALL_MAX {
        let c = class_of(s);
        @expect(@as(usize, class_size[c]) >= s);
        if c > 0 {
            @expect(@as(usize, class_size[c - 1]) < s);
        }
        s += 1;
    }
    @expect_eq(class_of(SMALL_MAX), NCLS - 1);
}

test "small objects are distinct, aligned and reused" {
    let base = in_use();
    let ptrs = alloc.[usize](1000)!;
    for i in 0..ptrs.len {
        let x = alloc.[u8](1 + (i % 200))!;
        @expect_eq(@int_from_ptr(x.ptr) % 16, 0);
        @mem_set(x, @truncate(u8, i));
        ptrs[i] = @int_from_ptr(x.ptr);
    }
    for i in 0..ptrs.len {
        let x = @slice_from_ptr(@ptr_from_int(*mut u8, ptrs[i]), 1 + (i % 200));
        @expect_eq(x[x.len - 1], @truncate(u8, i));
        free(x);
    }
    free(ptrs);
    @expect_eq(in_use(), base);
    if @sanitize_address() {
        return;  // freed memory is quarantined, not reused at once
    }
    // freed memory comes back
    let a = alloc.[u64](4)!;
    free(a);
    let b = alloc.[u64](4)!;
    @expect_eq(@int_from_ptr(a.ptr), @int_from_ptr(b.ptr));
    free(b);
}

test "large objects merge and are reused" {
    if @sanitize_address() {
        return;  // freed memory is quarantined, not reused at once
    }
    let base = in_use();
    let a = alloc.[u8](100000)!;
    let b = alloc.[u8](200000)!;
    let c = alloc.[u8](300000)!;
    a[99999] = 1;
    c[0] = 3;
    free(a);
    free(b);
    // a and b merged: room for more than either
    let d = alloc.[u8](290000)!;
    @expect(@int_from_ptr(d.ptr) < @int_from_ptr(c.ptr));
    free(d);
    free(c);
    @expect_eq(in_use(), base);
}

test "realloc keeps contents and grows in place when it can" {
    let mut v = alloc.[u32](10)!;
    for i in 0..v.len {
        v[i] = @truncate(u32, i);
    }
    let mut n: usize = 10;
    while n < 1000000 {
        n *= 3;
        v = realloc(v, n)!;
        @expect_eq(v[9], 9);
    }
    v = realloc(v, 5)!;
    @expect_eq(v[4], 4);
    free(v);
    let e = alloc.[u32](0)!;
    @expect_eq(e.len, 0);
    free(e);
}

test "create and destroy" {
    let p = create.[u64](42)!;
    @expect_eq(p.*, 42);
    destroy(p);
    let z = alloc_zeroed.[u64](3000)!;
    @expect_eq(z[2999], 0);
    free(z);
}

fn next_rand(s: *mut u64) u64 {
    s.* ^= s.* << 13;
    s.* ^= s.* >> 7;
    s.* ^= s.* << 17;
    return s.*;
}

fn fill(x: []mut u8, k: usize) void {
    for i in 0..x.len {
        x[i] = @truncate(u8, (k *% 131) +% i);
    }
}

fn intact(x: []u8, k: usize) bool {
    for i in 0..x.len {
        if x[i] != @truncate(u8, (k *% 131) +% i) {
            return false;
        }
    }
    return true;
}

test "random allocations, frees and reallocs keep every object intact" {
    let base = in_use();
    let n: usize = 300;
    let objs = alloc.[[]mut u8](n)!;
    let keys = alloc.[usize](n)!;
    for i in 0..n {
        objs[i] = alloc.[u8](0)!;
        keys[i] = 0;
    }
    let mut seed: u64 = 0x2545_F491_4F6C_DD1D;
    for step in @as(usize, 0)..20000 {
        let i = @truncate(usize, next_rand(&mut seed) % @as(u64, n));
        @expect(intact(objs[i], keys[i]));
        let r = next_rand(&mut seed);
        // mostly small, some medium, a few large
        let mut size = @truncate(usize, r % 200);
        if (r % 7) == 0 {
            size = @truncate(usize, r % 9000);
        }
        if (r % 97) == 0 {
            size = @truncate(usize, r % 300000);
        }
        if (r % 3) == 0 {
            let old_len = objs[i].len;
            objs[i] = realloc(objs[i], size)!;
            @expect(intact(objs[i][..@min(old_len, size)], keys[i]));
        } else {
            free(objs[i]);
            objs[i] = alloc.[u8](size)!;
        }
        keys[i] = step;
        fill(objs[i], step);
    }
    for i in 0..n {
        @expect(intact(objs[i], keys[i]));
        free(objs[i]);
    }
    free(objs);
    free(keys);
    @expect_eq(in_use(), base);
}

test "aligned allocations are aligned, intact and freed with free" {
    let before = in_use();
    let sizes: [12]usize = [1, 3, 5, 16, 25, 64, 100, 250, 700, 2047, 3000, 9000];
    let aligns: [8]usize = [1, 16, 32, 64, 128, 256, 1024, 4096];
    let mut all: [96][]mut u32 = [[]; 96];
    let mut k: usize = 0;
    for n in sizes {
        for al in aligns {
            let x = alloc_aligned.[u32](n, al)!;
            @expect((@int_from_ptr(x.ptr) % @max(al, 4)) == 0);
            for i in 0..n {
                x[i] = @truncate(u32, (k * 7919) + i);
            }
            all[k] = x;
            k += 1;
        }
    }
    for j in 0..k {
        let x = all[j];
        for i in 0..x.len {
            @expect(x[i] == @truncate(u32, (j * 7919) + i));
        }
    }
    // freed in another order, some after a move by realloc
    var_free(all[..k]);
    @expect(in_use() == before);
    let z = alloc_zeroed_aligned.[u8](5000, 4096)!;
    @expect((@int_from_ptr(z.ptr) % 4096) == 0);
    for b in z {
        @expect(b == 0);
    }
    let d = dup_aligned.[u8](z[0..100], 64)!;
    @expect(((@int_from_ptr(d.ptr) % 64) == 0) and (d.len == 100) and (d[99] == 0));
    free(d);
    free(z);
    let e = alloc_aligned.[u64](0, 256)!;
    @expect(e.len == 0);
    @expect(in_use() == before);
}

fn var_free(xs: []mut []mut u32) void {
    let mut j = xs.len;
    while j > 0 {
        j -= 1;
        if (j % 3) == 0 {
            let r = realloc.[u32](xs[j], xs[j].len + 50) catch @trap();
            free(r);
        } else {
            free(xs[j]);
        }
    }
}

test "an alignment that is not a power of two traps" expect trap {
    _ = alloc_aligned.[u8](10, 48) catch return;
}

test "freeing a large block twice traps" expect trap {
    let a = alloc.[u8](100000)!;
    free(a);
    free(a);
}

test "freeing what did not come from alloc traps" expect trap {
    let big = alloc.[u8](200000)!;
    free(big[70000..70016]);
}

test "realloc within a size class moves an over-aligned object that would not fit" {
    if @sanitize_address() {
        return;
    }
    let base = in_use();
    // 7169 bytes at 256: a block of two units, the object 256 bytes in, so
    // the class's 8192 bytes do not fit after it
    let x = alloc_aligned.[u8](7169, 256)!;
    @mem_set(x, 0x5A);
    let y = realloc(x, 8192)!;
    let p = @int_from_ptr(y.ptr);
    if is_over_aligned(p) {
        let s = block(p - HDR).size;  // (the alias header names the block)
        @expect((p + y.len) <= (s + block(s).size));
    } else {
        @expect(class_of(8192) == class_of(7169));  // a fresh object of the class
    }
    for i in @as(usize, 0)..7169 {
        @expect(y[i] == 0x5A);
    }
    @mem_set(y, 0xA5);
    free(y);
    @expect_eq(in_use(), base);
}

test "huge requests fail cleanly" {
    @expect(huge_fails((@max_value(usize) / 2) + 1));
    @expect(huge_fails(@max_value(usize) - 10));
    let a = alloc.[u8](100000)!;
    let r = realloc(a, @max_value(usize) - 10) catch {
        free(a);
        return;
    };
    free(r);
    @expect(false);
}

fn huge_fails(n: usize) bool {
    let a = alloc.[u8](n) catch return true;
    free(a);
    return false;
}

test "zeroed memory is zero after a block grew into the wilderness" {
    // a large block at the wilderness's edge grows in place, is written, and
    // goes back to the wilderness: what is allocated there next is not fresh
    let a = alloc.[u8](100000)!;
    let b = realloc(a, 300000)!;
    @mem_set(b, 0xa5);
    free(b);
    let z = alloc_zeroed.[u8](250000)!;
    defer free(z);
    let mut bad: usize = 0;
    for x in z {
        if x != 0 {
            bad += 1;
        }
    }
    @expect_eq(bad, 0);
}

test "zeroed memory is zero, fresh or reused" {
    for round in @as(usize, 0)..3 {
        let a = alloc.[u8](200000)!;
        @mem_set(a, 0xab);
        free(a);
        let z = alloc_zeroed.[u8](200000 + round)!;
        for b in z {
            @expect_eq(b, 0);
        }
        @mem_set(z, 0xcd);
        free(z);
        let big = alloc_zeroed.[u64](1 << 20)!;
        @expect_eq(big[0], 0);
        @expect_eq(big[big.len - 1], 0);
        @expect_eq(big[12345], 0);
        free(big);
    }
}

test "free memory is given back as it ages" {
    if @sanitize_address() or @target_arch("wasm32") or @target_arch("wasm64") {
        return;  // (WebAssembly memory cannot shrink)
    }
    // a time past the clock's, so that the allocator's own looks at it
    // change nothing
    let t = ax_clock_ns(1) + 1_000_000_000_000;
    decay_start = 0;
    decay_at(t);
    let mut blocks: [8][]mut u8 = [[]; 8];
    for k in 0..blocks.len {
        blocks[k] = alloc.[u8](1 << 20)!;
        @mem_set(blocks[k], 1);
    }
    let guard = alloc.[u8](100000)!;  // (the blocks do not border the wilderness)
    for k in 0..blocks.len {
        free(blocks[k]);
    }
    let before = stats();
    @expect(before.retained >= (8 << 20));
    decay_at(t + 1_000_000_000);  // freed a second ago: kept
    @expect(stats().retained >= (before.retained / 2));
    decay_at(t + 11_000_000_000);  // freed 11 seconds ago: given back
    let after = stats();
    @expect(after.retained < (before.retained / 4));
    @expect(after.given_back >= (@as(u64, before.retained - after.retained) / 2));
    free(guard);
}

test "the bytes freed in an epoch saturate" {
    // (found with --overflow=report: a benchmark of realloc on wasm32 freed
    // more than 4 GiB in one epoch)
    if @sanitize_address() {
        return;  // (its frees are held back)
    }
    let e = decay_epoch;
    let saved = freed_in[e];
    freed_in[e] = @max_value(usize) - 8;
    let b = alloc.[u8](1 << 20)!;
    free(b);
    @expect((decay_epoch != e) or (freed_in[e] == @max_value(usize)));
    freed_in[e] = saved;
}

test "caches: limits, the collection, and emptying at a thread's end" {
    if @sanitize_address() {
        return;  // (the sanitizer uses no caches)
    }
    let base = in_use();
    enable_threads();  // (batches, as with threads)
    let c = class_of(64);
    let xs = alloc.[[]mut u8](1000)!;
    let mid = in_use();
    for i in @as(usize, 0)..200 {
        xs[i] = alloc.[u8](64)!;
    }
    for i in @as(usize, 0)..200 {
        free(xs[i]);
    }
    let before = tc.count[c];
    @expect((before > 0) and (before <= tc.limit[c]) and (tc.limit[c] <= cache_cap(c)));
    @expect(in_use() == mid);  // (cached objects do not count)
    // misses and flushes of another class collect the idle one
    for _r in @as(usize, 0)..300 {
        for i in @as(usize, 0)..1000 {
            xs[i] = alloc.[u8](1000)!;
        }
        for i in @as(usize, 0)..1000 {
            free(xs[i]);
        }
    }
    @expect(tc.count[c] < before);
    @expect(stats().cache_flushes > 0);
    free(xs);
    @expect(in_use() == base);
    thread_exit();
    for k in 0..NCLS {
        @expect(tc.count[k] == 0);
    }
    @expect(stats().cached == 0);
    let p = create.[u64](7)!;  // (the cache is set up again)
    destroy(p);
    @expect(in_use() == base);
}
