/// f * 2^e with 64 significant bits.
struct DiyFp {
    f: u64,
    e: i32,
}

/// The product, rounded to 64 bits (error at most half a unit).
fn diy_mul(x: DiyFp, y: DiyFp) DiyFp {
    let m32: u64 = 0xFFFFFFFF;
    let a = x.f >> 32;
    let b = x.f & m32;
    let c = y.f >> 32;
    let d = y.f & m32;
    let ac = a * c;
    let bc = b * c;
    let ad = a * d;
    let bd = b * d;
    let tmp = (bd >> 32) + (ad & m32) + (bc & m32) + (@as(u64, 1) << 31);
    return DiyFp.{ f: ac + (ad >> 32) + (bc >> 32) + (tmp >> 32), e: x.e + y.e + 64 };
}

fn diy_normalize(x: DiyFp) DiyFp {
    let s = @clz(x.f);
    return DiyFp.{ f: x.f << s, e: x.e - @int_cast(i32, s) };
}

fn cached_power(i: usize) DiyFp {
    return DiyFp.{ f: CACHED_SIG[i], e: CACHED_EXP[i] };
}

/// The biggest power of ten <= x (x < 2^bits), and its exponent plus one.
fn biggest_pow10(x: u64, out_exp: *mut i32) u64 {
    let mut p: u64 = 1;
    let mut k: i32 = 1;
    while (p <= (x / 10)) and (k < 20) {
        p *= 10;
        k += 1;
    }
    out_exp.* = k;
    return p;
}

/// Grisu3's last-digit adjustment; false when the result is not provably
/// the closest shortest one.
fn round_weed(dg: *mut Digits, dist_high_w: u64, unsafe_interval: u64, rest0: u64, ten_kappa: u64, unit: u64) bool {
    let small = dist_high_w - unit;
    let big = dist_high_w + unit;
    let mut rest = rest0;
    while (rest < small) and ((unsafe_interval - rest) >= ten_kappa) and
          (((rest + ten_kappa) < small) or ((small - rest) >= ((rest + ten_kappa) - small))) {
        dg.d[dg.n - 1] -= 1;
        rest += ten_kappa;
    }
    if (rest < big) and ((unsafe_interval - rest) >= ten_kappa) and
       (((rest + ten_kappa) < big) or ((big - rest) > ((rest + ten_kappa) - big))) {
        return false;
    }
    return ((2 * unit) <= rest) and (rest <= (unsafe_interval - (4 * unit)));
}

/// Grisu3: the shortest digits of m * 2^e, or false if it cannot be sure.
fn grisu3(p: Parts, out: *mut Digits) bool {
    let w = diy_normalize(DiyFp.{ f: p.m, e: p.e });
    let plus = diy_normalize(DiyFp.{ f: (p.m << 1) + 1, e: p.e - 1 });
    let mut minus = DiyFp.{ f: (p.m << 1) - 1, e: p.e - 1 };
    if p.lower_closer {
        minus = DiyFp.{ f: (p.m << 2) - 1, e: p.e - 2 };
    }
    minus = DiyFp.{ f: minus.f << @int_cast(u32, minus.e - plus.e), e: plus.e };
    // a cached 10^-k bringing w's exponent into [-60, -32]
    let min_exp = -60 - (w.e + 64);
    let kf = @ceil(@float_from_int(f64, (min_exp + 64) - 1) * 0.30102999566398114);
    let kk = @int_from_float(i32, kf);
    let index = @int_cast(usize, (((348 + kk) - 1) / 8) + 1);
    let ten_mk = cached_power(index);
    let mk = -348 + (8 * @int_cast(i32, index));
    let sw = diy_mul(w, ten_mk);
    let slow = diy_mul(minus, ten_mk);
    let shigh = diy_mul(plus, ten_mk);
    // digit generation
    let mut unit: u64 = 1;
    let too_low = slow.f - unit;
    let too_high = shigh.f + unit;
    let mut unsafe_interval = too_high - too_low;
    let shift = @int_cast(u32, -sw.e);
    let one = @as(u64, 1) << shift;
    let mut integrals = too_high >> shift;
    let mut fractionals = too_high & (one - 1);
    let mut kappa: i32 = 0;
    let mut divisor = biggest_pow10(integrals, &mut kappa);
    out.n = 0;
    while kappa > 0 {
        let digit = integrals / divisor;
        out.d[out.n] = @truncate(u8, digit);
        out.n += 1;
        integrals = integrals % divisor;
        kappa -= 1;
        let rest = (integrals << shift) + fractionals;
        if rest < unsafe_interval {
            out.dp = @int_cast(i32, out.n) + (kappa - mk);
            return round_weed(out, too_high - sw.f, unsafe_interval, rest, divisor << shift, unit) and trim_digits(out);
        }
        divisor = divisor / 10;
    }
    loop {
        fractionals *= 10;
        unit *= 10;
        unsafe_interval *= 10;
        out.d[out.n] = @truncate(u8, fractionals >> shift);
        out.n += 1;
        fractionals = fractionals & (one - 1);
        kappa -= 1;
        if fractionals < unsafe_interval {
            out.dp = @int_cast(i32, out.n) + (kappa - mk);
            return round_weed(out, (too_high - sw.f) * unit, unsafe_interval, fractionals, one, unit) and
                   trim_digits(out);
        }
        if out.n >= 18 {
            return false;
        }
    }
}

/// Drops leading and trailing zero digits (true, for chaining).
fn trim_digits(dg: *mut Digits) bool {
    while (dg.n > 0) and (dg.d[dg.n - 1] == 0) {
        dg.n -= 1;
    }
    let mut z: usize = 0;
    while (z < dg.n) and (dg.d[z] == 0) {
        z += 1;
    }
    if z > 0 {
        for i in z..dg.n {
            dg.d[i - z] = dg.d[i];
        }
        dg.n -= z;
        dg.dp -= @int_cast(i32, z);
    }
    return dg.n > 0;
}

let ADJUST_SIG: [8]u64 = [
    0x8000000000000000,
    0xa000000000000000,
    0xc800000000000000,
    0xfa00000000000000,
    0x9c40000000000000,
    0xc350000000000000,
    0xf424000000000000,
    0x9896800000000000,
];

let ADJUST_EXP: [8]i32 = [-63, -60, -57, -54, -50, -47, -44, -40];

/// Bits of the float nearest f * 2^e (f may have up to 54 significant
/// bits), for floats of kind k.
fn diy_to_bits(f0: u64, e0: i32, k: FloatKind) u64 {
    let hidden = @as(u64, 1) << k.mbits;
    let denormal_exp = k.bias;
    let max_exp = @int_cast(i32, exp_mask(k)) + (k.bias - 1);
    let mut f = f0;
    let mut e = e0;
    while f > (hidden + frac_mask(k)) {
        f = f >> 1;
        e += 1;
    }
    if e >= max_exp {
        return exp_mask(k) << k.mbits;
    }
    if e < denormal_exp {
        return 0;
    }
    while (e > denormal_exp) and ((f & hidden) == 0) {
        f = f << 1;
        e -= 1;
    }
    let mut biased: u64 = 0;
    if (e != denormal_exp) or ((f & hidden) != 0) {
        biased = @int_cast(u64, (e - k.bias) + 1);
    }
    return (f & frac_mask(k)) | (biased << k.mbits);
}

/// Extended-precision Clinger: lead (the first up to 19 digits) times
/// 10^e10, with `inexact` digits dropped after them. Returns true with the
/// correctly rounded bits in guess, or false with guess within an ulp.
fn diy_strtod(lead: u64, nlead: i32, e10: i32, inexact: bool, k: FloatKind, guess: *mut u64) bool {
    let denominator: u64 = 8;
    let mut slop: u64 = 0;
    if inexact {
        slop = denominator / 2;
    }
    let mut input = DiyFp.{ f: lead, e: 0 };
    let s0 = @clz(input.f);
    input = diy_normalize(input);
    slop = slop << s0;
    if e10 < -348 {
        guess.* = 0;
        return true;
    }
    let index = @int_cast(usize, (e10 + 348) / 8);
    let cached = cached_power(index);
    let cached_e10 = -348 + (8 * @int_cast(i32, index));
    if cached_e10 != e10 {
        let adj = e10 - cached_e10;
        input = diy_mul(input, DiyFp.{ f: ADJUST_SIG[@int_cast(usize, adj)], e: ADJUST_EXP[@int_cast(usize, adj)] });
        // exact when lead * 10^adj fits in 64 bits
        if (19 - nlead) < adj {
            slop += denominator / 2;
        }
    }
    input = diy_mul(input, cached);
    // the multiplication's slop, the cached power's, and a fixed half unit
    let mut error_ab: u64 = 0;
    if slop != 0 {
        error_ab = 1;
    }
    slop += (denominator / 2) + error_ab + (denominator / 2);
    let s1 = @clz(input.f);
    input = diy_normalize(input);
    slop = slop << s1;
    let order = 64 + input.e;
    let sig_bits = @int_cast(i32, k.mbits) + 1;
    let mut eff: i32 = sig_bits;
    if order < (k.bias + sig_bits) {
        eff = @max(order - k.bias, 0);
    }
    let mut prec = 64 - eff;
    if (prec + 3) >= 64 {
        let sh = (prec + 3) - 63;
        input = DiyFp.{ f: input.f >> @int_cast(u32, sh), e: input.e + sh };
        slop = (slop >> @int_cast(u32, sh)) + 1 + denominator;
        prec -= sh;
    }
    let pmask = (@as(u64, 1) << @int_cast(u32, prec)) - 1;
    let bits_below = (input.f & pmask) * denominator;
    let half = (@as(u64, 1) << @int_cast(u32, prec - 1)) * denominator;
    let mut rf = input.f >> @int_cast(u32, prec);
    if bits_below >= (half + slop) {
        rf += 1;
    }
    guess.* = diy_to_bits(rf, input.e + prec, k);
    return not ((@sub_sat(half, slop) < bits_below) and (bits_below < (half + slop)));
}

// -----------------------------------------------------------------------------
// Writing floats
// -----------------------------------------------------------------------------

/// A little buffered writer for assembling a number before padding it.
struct Out {
    b: [1200]u8,
    n: usize,

    fn put(self: *mut Out, c: u8) void {
        if self.n < self.b.len {
            self.b[self.n] = c;
            self.n += 1;
        }
    }

    fn puts(self: *mut Out, s: []u8) void {
        for c in s {
            self.put(c);
        }
    }

    fn zeros(self: *mut Out, k: i32) void {
        let mut i: i32 = 0;
        while i < k {
            self.put('0');
            i += 1;
        }
    }

    fn exponent(self: *mut Out, e: i32, always_sign: bool) void {
        self.put('e');
        let mut m = e;
        if e < 0 {
            self.put('-');
            m = -e;
        } else if always_sign {
            self.put('+');
        }
        let mut tmp: [12]u8 = [0; 12];
        self.puts(format_uint(tmp[..], @as(u64, @int_cast(u32, m)), 10, false));
    }
}

fn out_init() Out {
    return Out.{ b: [0; 1200], n: 0 };
}

/// digits and dp in JavaScript's Number-to-String layout.
fn layout_shortest(o: *mut Out, dg: *Digits) void {
    let k = @int_cast(i32, dg.n);
    let n = dg.dp;
    if (k <= n) and (n <= 21) {
        for i in 0..dg.n {
            o.put('0' + dg.d[i]);
        }
        o.zeros(n - k);
    } else if (0 < n) and (n <= 21) {
        for i in 0..dg.n {
            if i == @int_cast(usize, n) {
                o.put('.');
            }
            o.put('0' + dg.d[i]);
        }
    } else if (-6 < n) and (n <= 0) {
        o.puts("0.");
        o.zeros(-n);
        for i in 0..dg.n {
            o.put('0' + dg.d[i]);
        }
    } else {
        o.put('0' + dg.d[0]);
        if k > 1 {
            o.put('.');
            for i in 1..dg.n {
                o.put('0' + dg.d[i]);
            }
        }
        o.exponent(n - 1, true);
    }
}

/// Rounds the decimal x to keep digits before position `keep` (which may be
/// negative or beyond x.n), ties to even. Returns the rounded digits in
/// out (possibly one longer, when 9s carry) and their dp.
fn round_decimal(x: *mut Decimal, keep: i32) void {
    if keep < 0 {
        x.n = 0;
        return;
    }
    if keep >= @int_cast(i32, x.n) {
        return;
    }
    let kk = @int_cast(usize, keep);
    let d = x.d[kk];
    let mut up = false;
    if d > 5 {
        up = true;
    } else if d == 5 {
        if (kk + 1) < x.n {
            up = true;  // digits are trimmed, so anything after is non-zero
        } else if kk == 0 {
            up = false;  // 0.5 of the last kept unit, and the kept digit is 0
        } else {
            up = (x.d[kk - 1] & 1) == 1;
        }
    }
    x.n = kk;
    if up {
        let mut i = kk;
        loop {
            if i == 0 {
                // all nines: 0.999 -> 1.000
                x.d[0] = 1;
                x.n = 1;
                x.dp += 1;
                break;
            }
            i -= 1;
            if x.d[i] < 9 {
                x.d[i] += 1;
                x.n = i + 1;
                break;
            }
        }
    }
    while (x.n > 0) and (x.d[x.n - 1] == 0) {
        x.n -= 1;
    }
}

fn digit_of(x: *Decimal, i: i32) u8 {
    if (i < 0) or (i >= @int_cast(i32, x.n)) {
        return 0;
    }
    return x.d[@int_cast(usize, i)];
}

/// Fixed notation with `prec` digits after the point.
fn layout_fixed(o: *mut Out, x: *mut Decimal, prec: i32) void {
    round_decimal(x, x.dp + prec);
    if (x.n == 0) or (x.dp <= 0) {
        o.put('0');
    } else {
        for i in 0..x.dp {
            o.put('0' + digit_of(x, i));
        }
    }
    if prec > 0 {
        o.put('.');
        for j in 0..prec {
            if x.n == 0 {
                o.put('0');
            } else {
                o.put('0' + digit_of(x, x.dp + j));
            }
        }
    }
}

/// Scientific notation with `prec` digits after the first.
fn layout_sci(o: *mut Out, x: *mut Decimal, prec: i32) void {
    round_decimal(x, prec + 1);
    if x.n == 0 {
        o.put('0');
        if prec > 0 {
            o.put('.');
            o.zeros(prec);
        }
        o.puts("e+0");
        return;
    }
    o.put('0' + x.d[0]);
    if prec > 0 {
        o.put('.');
        for j in 1..prec + 1 {
            o.put('0' + digit_of(x, j));
        }
    }
    o.exponent(x.dp - 1, true);
}

fn layout_shortest_sci(o: *mut Out, dg: *Digits) void {
    o.put('0' + dg.d[0]);
    if dg.n > 1 {
        o.put('.');
        for i in 1..dg.n {
            o.put('0' + dg.d[i]);
        }
    }
    o.exponent(dg.dp - 1, true);
}

fn write_float(w: io.Writer, bits: u64, k: FloatKind, sp: *Spec) !void {
    let total_bits = k.mbits + k.ebits;
    let neg = ((bits >> total_bits) & 1) == 1;
    let mag = bits & ((@as(u64, 1) << total_bits) - 1);
    let mut o = out_init();
    let inf_bits = exp_mask(k) << k.mbits;
    let mut sign: []u8 = "";
    if neg {
        sign = "-";
    } else if sp.plus {
        sign = "+";
    }
    if mag > inf_bits {
        write_padded(w, sp, "", "NaN", false)!;
        return;
    }
    if mag == inf_bits {
        o.puts("inf");
        write_padded(w, sp, sign, o.b[..o.n], false)!;
        return;
    }
    let kind = sp.kind;
    if (kind == 'f') or sp.has_precision {
        let mut prec: i32 = 6;
        if sp.has_precision {
            prec = @int_cast(i32, @min(sp.precision, 1000));
        }
        let mut x = decimal_zero();
        if mag != 0 {
            let p = split_bits(mag, k);
            exact(p.m, p.e, &mut x);
        }
        if kind == 'e' {
            layout_sci(&mut o, &mut x, prec);
        } else {
            layout_fixed(&mut o, &mut x, prec);
        }
    } else if mag == 0 {
        o.put('0');
    } else {
        let mut dg = Digits.{ d: [0; 20], n: 0, dp: 0 };
        let p = split_bits(mag, k);
        if (p.e >= 0) or (p.e <= -64) or ((p.m & ((@as(u64, 1) << @int_cast(u32, -p.e)) - 1)) != 0) {
            if not grisu3(p, &mut dg) {
                shortest(p, &mut dg);
            }
        } else {
            // an integer below 2^53: its digits are its shortest form
            let mut t = p.m >> @int_cast(u32, -p.e);
            let mut tmp: [20]u8 = [0; 20];
            let mut nd: usize = 0;
            while t > 0 {
                tmp[nd] = @truncate(u8, t % 10);
                t = t / 10;
                nd += 1;
            }
            dg.dp = @int_cast(i32, nd);
            let mut z: usize = 0;
            while tmp[z] == 0 {
                z += 1;
            }
            dg.n = nd - z;
            for q in 0..dg.n {
                dg.d[q] = tmp[nd - 1 - q];
            }
        }
        if kind == 'e' {
            layout_shortest_sci(&mut o, &dg);
        } else {
            layout_shortest(&mut o, &dg);
        }
    }
    write_padded(w, sp, sign, o.b[..o.n], true)!;
}

/// The shortest form of x that reads back as x (32 bytes suffice).
pub fn format_float(out: []mut u8, x: f64) FmtError![]u8 {
    let mut bw = io.BufferWriter.init(out);
    let sp = Spec.default();
    write_float(bw.writer(), @bit_cast(u64, x), F64, &sp) catch return error.NoSpaceLeft;
    return bw.written();
}

/// The shortest form of x that reads back as the same f32 (24 bytes
/// suffice).
pub fn format_float32(out: []mut u8, x: f32) FmtError![]u8 {
    let mut bw = io.BufferWriter.init(out);
    let sp = Spec.default();
    write_float(bw.writer(), @as(u64, @bit_cast(u32, x)), F32, &sp) catch return error.NoSpaceLeft;
    return bw.written();
}

// -----------------------------------------------------------------------------
// Parsing floats
// -----------------------------------------------------------------------------

let POW10: [23]f64 = [
    1.0e0,
    1.0e1,
    1.0e2,
    1.0e3,
    1.0e4,
    1.0e5,
    1.0e6,
    1.0e7,
    1.0e8,
    1.0e9,
    1.0e10,
    1.0e11,
    1.0e12,
    1.0e13,
    1.0e14,
    1.0e15,
    1.0e16,
    1.0e17,
    1.0e18,
    1.0e19,
    1.0e20,
    1.0e21,
    1.0e22,
];

let POW10_32: [11]f32 = [1.0e0, 1.0e1, 1.0e2, 1.0e3, 1.0e4, 1.0e5, 1.0e6, 1.0e7, 1.0e8, 1.0e9, 1.0e10];

/// The digits of a number being parsed: 0.d[0].. x 10^dp, plus the first
/// up to 19 of them as an integer.
struct Scanned {
    neg: bool,
    special: u8,  // 0 number, 'i' infinity, 'n' NaN
    dec: Decimal,
    lead: u64,  // the first `nlead` digits
    nlead: i32,
}

fn match_word(s: []u8, i: usize, word: []u8) bool {
    if (s.len - i) != word.len {
        return false;
    }
    return strs.eq_ignore_case(s[i..], word);
}

fn scan(s: []u8, sc: *mut Scanned) FmtError!void {
    let mut i: usize = 0;
    if (s.len > 0) and ((s[0] == '-') or (s[0] == '+')) {
        sc.neg = s[0] == '-';
        i = 1;
    }
    if match_word(s, i, "inf") or match_word(s, i, "infinity") {
        sc.special = 'i';
        return;
    }
    if match_word(s, i, "nan") {
        sc.special = 'n';
        return;
    }
    let mut digits = false;
    let mut dp: i64 = 0;
    let mut seen_point = false;
    let mut truncated = false;
    let d = &mut sc.dec;
    while i < s.len {
        let c = s[i];
        if c == '.' {
            if seen_point {
                return error.InvalidNumber;
            }
            seen_point = true;
            i += 1;
            continue;
        }
        if not strs.is_digit(c) {
            break;
        }
        digits = true;
        let v = c - '0';
        if (v == 0) and (d.n == 0) {
            // leading zeros only move the point
            if seen_point {
                dp -= 1;
            }
        } else {
            if d.n < (MAX_DIGITS - 1) {
                d.d[d.n] = v;
                d.n += 1;
            } else if v != 0 {
                truncated = true;
            }
            if not seen_point {
                dp += 1;
            }
        }
        i += 1;
    }
    if not digits {
        return error.InvalidNumber;
    }
    if (i < s.len) and ((s[i] | 0x20) == 'e') {
        i += 1;
        let mut eneg = false;
        if (i < s.len) and ((s[i] == '-') or (s[i] == '+')) {
            eneg = s[i] == '-';
            i += 1;
        }
        if (i >= s.len) or not strs.is_digit(s[i]) {
            return error.InvalidNumber;
        }
        let mut ev: i64 = 0;
        while (i < s.len) and strs.is_digit(s[i]) {
            if ev < 1000000 {
                ev = (ev * 10) + @as(i64, s[i] - '0');
            }
            i += 1;
        }
        if eneg {
            dp -= ev;
        } else {
            dp += ev;
        }
    }
    if i != s.len {
        return error.InvalidNumber;
    }
    // drop trailing zeros; a truncated tail is represented by a final 1
    while (d.n > 0) and (d.d[d.n - 1] == 0) {
        d.n -= 1;
    }
    if truncated {
        d.d[d.n] = 1;
        d.n += 1;
    }
    d.dp = @int_cast(i32, @max(@min(dp, 100000), -100000));
    let mut lead: u64 = 0;
    let mut nl: usize = 0;
    while (nl < d.n) and (nl < 19) {
        lead = (lead * 10) + @as(u64, d.d[nl]);
        nl += 1;
    }
    sc.lead = lead;
    sc.nlead = @int_cast(i32, nl);
}

/// The correctly rounded bits of the positive decimal x, starting from an
/// estimate and moving one float at a time until x lies between the
/// midpoints around it.
fn refine(x: *Decimal, estimate: u64, k: FloatKind) u64 {
    let inf_bits = exp_mask(k) << k.mbits;
    let mut bits = estimate;
    if bits >= inf_bits {
        bits = inf_bits - 1;
    }
    if bits == 0 {
        bits = 1;
    }
    let mut mid = decimal_zero();
    loop {
        let p = split_bits(bits, k);
        let odd = (p.m & 1) == 1;
        exact((2 * p.m) + 1, p.e - 1, &mut mid);
        let c = compare_decimal(x, &mid);
        if (c > 0) or ((c == 0) and odd) {
            bits += 1;
            if bits == inf_bits {
                return inf_bits;
            }
            continue;
        }
        if p.lower_closer {
            exact((4 * p.m) - 1, p.e - 2, &mut mid);
        } else {
            exact((2 * p.m) - 1, p.e - 1, &mut mid);
        }
        let c2 = compare_decimal(x, &mid);
        if (c2 < 0) or ((c2 == 0) and odd) {
            bits -= 1;
            if bits == 0 {
                return 0;
            }
            continue;
        }
        return bits;
    }
}

fn parse_bits(s: []u8, k: FloatKind) FmtError!u64 {
    let mut sc = Scanned.{ neg: false, special: 0, dec: decimal_zero(), lead: 0, nlead: 0 };
    scan(s, &mut sc)!;
    let mut sign_bit: u64 = 0;
    if sc.neg {
        sign_bit = @as(u64, 1) << (k.mbits + k.ebits);
    }
    let inf_bits = exp_mask(k) << k.mbits;
    if sc.special == 'i' {
        return sign_bit | inf_bits;
    }
    if sc.special == 'n' {
        return inf_bits | (@as(u64, 1) << (k.mbits - 1));
    }
    let d = &sc.dec;
    if d.n == 0 {
        return sign_bit;
    }
    // out of range either way
    if d.dp > 310 {
        return sign_bit | inf_bits;
    }
    if d.dp < -326 {
        return sign_bit;
    }
    // exact small cases: an exactly representable integer times or divided
    // by an exactly representable power of ten rounds once
    let e10 = d.dp - @int_cast(i32, d.n);
    if k.mbits == 52 {
        if (d.n <= 15) and (e10 >= -22) and (e10 <= 22) {
            let v = @float_from_int(f64, sc.lead);
            let mut r = v;
            if e10 >= 0 {
                r = v * POW10[@int_cast(usize, e10)];
            } else {
                r = v / POW10[@int_cast(usize, -e10)];
            }
            return sign_bit | @bit_cast(u64, r);
        }
    } else if (d.n <= 7) and (e10 >= -10) and (e10 <= 10) {
        let v = @float_from_int(f32, sc.lead);
        let mut r = v;
        if e10 >= 0 {
            r = v * POW10_32[@int_cast(usize, e10)];
        } else {
            r = v / POW10_32[@int_cast(usize, -e10)];
        }
        return sign_bit | @as(u64, @bit_cast(u32, r));
    }
    let mut guess: u64 = 0;
    if diy_strtod(sc.lead, sc.nlead, d.dp - sc.nlead, d.n > @int_cast(usize, sc.nlead), k, &mut guess) {
        return sign_bit | guess;
    }
    return sign_bit | refine(d, guess, k);
}

/// Parses a decimal floating-point number: an optional sign, digits with an
/// optional point, and an optional exponent (1.5, -2e10, .5, 3.); also
/// "inf", "infinity" and "nan" in any case. The result is correctly rounded.
/// No surrounding whitespace is allowed.
pub fn parse_float(s: []u8) FmtError!f64 {
    return @bit_cast(f64, parse_bits(s, F64)!);
}

pub fn parse_float32(s: []u8) FmtError!f32 {
    return @bit_cast(f32, @truncate(u32, parse_bits(s, F32)!));
}

// -----------------------------------------------------------------------------
// Tests (axiom test std/fmt.ax)
// -----------------------------------------------------------------------------

fn check(x: f64, want: []u8) void {
    let mut b: [40]u8 = [0; 40];
    let got = format_float(b[..], x) catch @trap();
    @expect_eq(got, want);
    // and back
    if x == x {
        @expect_eq(@bit_cast(u64, parse_float(got) catch @trap()), @bit_cast(u64, x));
    }
}

test "shortest float formatting" {
    check(0.0, "0");
    check(-0.0, "-0");
    check(1.0, "1");
    check(0.1, "0.1");
    check(0.3, "0.3");
    check(0.1 + 0.2, "0.30000000000000004");
    check(1.5, "1.5");
    check(-2.25, "-2.25");
    check(100.0, "100");
    check(123456789.0, "123456789");
    check(1.0e21, "1e+21");
    check(1.0e20, "100000000000000000000");
    check(1.0e-7, "1e-7");
    check(1.0e-6, "0.000001");
    check(1.2345e-6, "0.0000012345");
    check(5.0e-324, "5e-324");
    check(2.2250738585072014e-308, "2.2250738585072014e-308");
    check(1.7976931348623157e308, "1.7976931348623157e+308");
    check(9007199254740993.0, "9007199254740992");
    check(123.456, "123.456");
    check(1.0 / 3.0, "0.3333333333333333");
    check(2.0 / 3.0, "0.6666666666666666");
    check(1.0e23, "1e+23");
    check(4.35, "4.35");
    check(0.000123, "0.000123");
    check(1.0 / 0.0, "inf");
    check(-1.0 / 0.0, "-inf");
    check(0.0 / 0.0, "NaN");
    let mut b: [24]u8 = [0; 24];
    @expect_eq(format_float32(b[..], 0.1)!, "0.1");
    @expect_eq(format_float32(b[..], 16777216.0)!, "16777216");
    @expect_eq(format_float32(b[..], 3.4028235e38)!, "3.4028235e+38");
    @expect_eq(format_float32(b[..], 1.0e-45)!, "1e-45");
}

test "float parsing" {
    @expect_eq(parse_float("0")!, 0.0);
    @expect_eq(parse_float("-1.5e3")!, -1500.0);
    @expect_eq(parse_float(".5")!, 0.5);
    @expect_eq(parse_float("5.")!, 5.0);
    @expect_eq(parse_float("1e-400")!, 0.0);
    @expect_eq(parse_float("1e400")!, 1.0 / 0.0);
    @expect_eq(parse_float("-Infinity")!, -1.0 / 0.0);
    let n = parse_float("NaN")!;
    @expect(n != n);
    // halfway cases and long inputs
    @expect_eq(parse_float("9007199254740993")!, 9007199254740992.0);
    @expect_eq(parse_float("9007199254740995")!, 9007199254740996.0);
    @expect_eq(parse_float("9007199254740993.0000000000000000000000000001")!, 9007199254740994.0);
    @expect_eq(parse_float("2.2250738585072011e-308")!, 2.225073858507201e-308);
    @expect_eq(parse_float("4.9406564584124654e-324")!, 5.0e-324);
    @expect_eq(parse_float("2.4703282292062327e-324")!, 0.0);
    @expect_eq(parse_float("2.4703282292062328e-324")!, 5.0e-324);
    @expect_eq(parse_float("1.7976931348623158e308")!, 1.7976931348623157e308);
    @expect_eq(parse_float("1.7976931348623159e308")!, 1.0 / 0.0);
    @expect_eq(parse_float("0.1000000000000000055511151231257827021181583404541015625")!, 0.1);
    @expect_eq(parse_float32("0.1")!, 0.1);
    @expect_eq(parse_float32("16777217")!, 16777216.0);
    @expect_eq(parse_float32("3.40282356e38")!, 3.4028235e38);
    let bad: [7][]u8 = ["", "-", ".", "1e", "1.2.3", " 1", "0x10"];
    for s in bad {
        _ = parse_float(s) catch continue;
        @trap();
    }
}

test "integers" {
    @expect_eq(parse_int.[i32]("-2147483648")!, -2147483648);
    @expect_eq(parse_int.[u8]("255")!, 255);
    @expect_eq(parse_int.[i64]("+42")!, 42);
    @expect_eq(parse_int_base.[u32]("ff", 16)!, 255);
    @expect_eq(parse_int_base.[i32]("-0x10", 0)!, -16);
    @expect_eq(parse_int_base.[u64]("0b101", 0)!, 5);
    @expect_eq(parse_int.[u64]("18446744073709551615")!, 18446744073709551615);
    @expect(fails_with(widen(parse_int.[u8]("256")), error.Overflow));
    @expect(fails_with(widen(parse_int.[u64]("18446744073709551616")), error.Overflow));
    @expect(fails_with(widen(parse_int.[u32]("-1")), error.Overflow));
    @expect(fails_with(widen(parse_int.[i8]("-129")), error.Overflow));
    @expect_eq(parse_int.[i8]("-128")!, -128);
    @expect(fails_with(widen(parse_int.[i32]("12a")), error.InvalidNumber));
    @expect(fails_with(widen(parse_int.[i32]("")), error.InvalidNumber));
    @expect(fails_with(widen(parse_int.[i32]("-")), error.InvalidNumber));
    let mut b: [40]u8 = [0; 40];
    @expect_eq(format_int(b[..], @as(i8, -128)), "-128");
    @expect_eq(format_int(b[..], @as(u16, 65535)), "65535");
    @expect_eq(format_uint(b[..], 255, 2, false), "11111111");
}

fn fails_with[T](r: !T, want: error) bool {
    _ = r catch |e| {
        return e == want;
    };
    return false;
}

fn f1(template: []u8, a: Arg, want: []u8) void {
    let mut b: [128]u8 = [0; 128];
    let got = bufprint(b[..], template, [a]) catch @trap();
    @expect_eq(got, want);
}

test "templates" {
    let mut b: [128]u8 = [0; 128];
    @expect_eq(bufprint(b[..], "{} + {} = {}", [int.[i64](2), int(@as(u8, 3)), int(@as(i64, 5))])!, "2 + 3 = 5");
    @expect_eq(bufprint(b[..], "{1}{0}{1} {{}}", [str("a"), str("b")])!, "bab {}");
    f1("[{:5}]", int.[i64](42), "[   42]");
    f1("[{:<5}]", int.[i64](42), "[42   ]");
    f1("[{:^6}]", str("ab"), "[  ab  ]");
    f1("[{:*>6}]", str("ab"), "[****ab]");
    f1("[{:05}]", int.[i64](-42), "[-0042]");
    f1("{:+}", int.[i64](7), "+7");
    f1("{:x}", int.[i64](255), "ff");
    f1("{:#X}", int.[i64](255), "0xFF");
    f1("{:#010b}", int.[i64](5), "0b00000101");
    f1("{:o}", int.[i64](8), "10");
    f1("{}", int(@as(i64, -9223372036854775807) - 1), "-9223372036854775808");
    f1("{}", int(@as(u64, 18446744073709551615)), "18446744073709551615");
    f1("{:.2}", float(3.14159), "3.14");
    f1("{:.0}", float(2.5), "2");
    f1("{:.0}", float(3.5), "4");
    f1("{:.1}", float(0.25), "0.2");
    f1("{:.3}", float(-0.0005), "-0.001");
    f1("{:.2}", float(0.125), "0.12");
    f1("{:.2}", float(0.375), "0.38");
    f1("{:.1}", float(9.96), "10.0");
    f1("{:f}", float(1.0), "1.000000");
    f1("{:.20}", float(0.1), "0.10000000000000000555");
    f1("{:e}", float(1234.5), "1.2345e+3");
    f1("{:.2e}", float(1234.5), "1.23e+3");
    f1("{:.2e}", float(0.0), "0.00e+0");
    f1("{:8.3}", float(3.14159), "   3.142");
    f1("{:08.2}", float(-1.5), "-0001.50");
    f1("{}", float32(0.3), "0.3");
    f1("{}", boolean(true), "true");
    f1("{}", rune(0x263A), "\u{263A}");
    f1("{:?}", str("a\"b\n\u{1}"), "\"a\\\"b\\n\\u{01}\"");
    f1("{:.3}", str("h\u{e9}llo"), "h\u{e9}l");
    f1("[{:4}]", str("\u{e9}"), "[\u{e9}   ]");
    let bad: [5][]u8 = ["{", "}", "{:q}", "{5}", "{:.}"];
    for t in bad {
        _ = bufprint(b[..], t, [int.[i64](1)]) catch continue;
        @trap();
    }
    let s = alloc("{}-{}", [str("x"), float(0.5)])!;
    defer mem.free(s);
    @expect_eq(s, "x-0.5");
}

// A result with this module's errors as one with any error, for the
// helpers of the tests (error unions do not widen by themselves).
fn widen[T](r: FmtError!T) !T {
    return r!;
}
