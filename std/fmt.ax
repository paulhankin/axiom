// =============================================================================
// std/fmt.ax - formatting and parsing numbers, and formatting templates.
//
// Templates:
//
//     fmt.print("{} is {} years old\n", [fmt.str(name), fmt.int(age)])!;
//     let s = fmt.alloc("{:>8.3} {:x}", [fmt.float(x), fmt.int(n)])!;  // mem.free(s)
//     let t = fmt.bufprint(buf[..], "{}", [fmt.float32(y)])!;          // no allocation
//
// A template's `{}` takes the next argument and `{2}` a particular one;
// `{{` and `}}` are literal braces. After a `:` comes a spec,
//
//     [[fill]align][+][#][0][width][.precision][type]
//
//   align      `<` left, `>` right, `^` centre (numbers default to right,
//              everything else to left); `fill` is any ASCII character
//   `+`        a sign on positive numbers too
//   `#`        a 0x / 0b / 0o prefix for `x`, `X`, `b`, `o`
//   `0`        pad numbers with zeros after the sign
//   width      the minimum width in code points
//   precision  floats: digits after the point (`e`: after the first digit);
//              strings: the most code points to show
//   type       integers: `x` `X` `b` `o` (default decimal); floats: `e`
//              (scientific) and `f` (fixed, precision 6 unless given);
//              strings: `?` quotes and escapes them
//
// A malformed template, or one that names a missing argument, fails with
// error.BadFormat.
//
// Floats print in the shortest form that reads back as the same value
// (0.1 prints as "0.1"), in the notation JavaScript uses: plain decimal for
// 1e-7 < |x| < 1e21, otherwise like "1.5e+21". With a precision they are
// correctly rounded (ties to even) from their exact binary value.
// parse_float is correctly rounded for any number of digits.
// =============================================================================

import "io.ax" as io;
import "mem.ax" as mem;
import "str.ax" as strs;

pub error FmtError { BadFormat, InvalidNumber, Overflow, NoSpaceLeft, OutOfMemory, IoError, NotFound, EndOfStream,
                     Done }

// -----------------------------------------------------------------------------
// Arguments
// -----------------------------------------------------------------------------

pub union Arg {
    Int: i64,
    Uint: u64,
    Float: f64,
    Float32: f32,
    Str: []u8,
    Bool: bool,
    Rune: u32,
}

/// Any integer type.
pub fn int[T: Int](x: T) Arg {
    if @min_value(T) < 0 {
        return Arg.Int(@int_cast(i64, x));
    }
    return Arg.Uint(@int_cast(u64, x));
}

pub fn float(x: f64) Arg {
    return Arg.Float(x);
}

/// An f32, printed in the shortest form that reads back as the same f32.
pub fn float32(x: f32) Arg {
    return Arg.Float32(x);
}

pub fn str(s: []u8) Arg {
    return Arg.Str(s);
}

pub fn boolean(b: bool) Arg {
    return Arg.Bool(b);
}

/// A code point, printed as UTF-8.
pub fn rune(r: u32) Arg {
    return Arg.Rune(r);
}

// -----------------------------------------------------------------------------
// Template entry points
// -----------------------------------------------------------------------------

/// Formats to a Writer.
pub fn write[const N: usize](w: io.Writer, template: []u8, args: [N]Arg) !void {
    format(w, template, args[..])!;
}

/// Formats to standard output.
pub fn print[const N: usize](template: []u8, args: [N]Arg) !void {
    let mut bw = io.BufWriter.init(io.stdout());
    format(bw.writer(), template, args[..])!;
    bw.flush()!;
}

/// Formats to standard error.
pub fn eprint[const N: usize](template: []u8, args: [N]Arg) !void {
    let mut bw = io.BufWriter.init(io.stderr());
    format(bw.writer(), template, args[..])!;
    bw.flush()!;
}

/// Formats into new memory (free it with mem.free).
pub fn alloc[const N: usize](template: []u8, args: [N]Arg) ![]mut u8 {
    let mut s = strs.String.init();
    format(s.writer(), template, args[..]) catch |e| {
        s.deinit();
        return e;
    };
    return s.take()!;
}

/// Formats into buf and returns the part written; NoSpaceLeft if it does
/// not fit.
pub fn bufprint[const N: usize](out: []mut u8, template: []u8, args: [N]Arg) ![]u8 {
    let mut bw = io.BufferWriter.init(out);
    format(bw.writer(), template, args[..])!;
    return bw.written();
}

/// The template engine behind write, print, eprint, alloc and bufprint.
pub fn format(w: io.Writer, template: []u8, args: []Arg) !void {
    let mut next: usize = 0;
    let mut i: usize = 0;
    let mut lit: usize = 0;
    while i < template.len {
        let c = template[i];
        if c == '}' {
            if ((i + 1) < template.len) and (template[i + 1] == '}') {
                w.write_all(template[lit..i + 1])!;
                i += 2;
                lit = i;
                continue;
            }
            return error.BadFormat;
        }
        if c != '{' {
            i += 1;
            continue;
        }
        w.write_all(template[lit..i])!;
        if ((i + 1) < template.len) and (template[i + 1] == '{') {
            w.write_all("{")!;
            i += 2;
            lit = i;
            continue;
        }
        let close = strs.index_of_byte(template[i..], '}') catch return error.BadFormat;
        let inner = template[i + 1..i + close];
        i += close + 1;
        lit = i;
        // argument index
        let mut k: usize = 0;
        let mut index = next;
        if (k < inner.len) and strs.is_digit(inner[k]) {
            index = 0;
            while (k < inner.len) and strs.is_digit(inner[k]) {
                index = (index * 10) + @as(usize, inner[k] - '0');
                k += 1;
                if index > 1000000 {
                    return error.BadFormat;
                }
            }
        } else {
            next += 1;
        }
        let mut spec = Spec.default();
        if k < inner.len {
            if inner[k] != ':' {
                return error.BadFormat;
            }
            spec = parse_spec(inner[k + 1..])!;
        }
        if index >= args.len {
            return error.BadFormat;
        }
        write_arg(w, args[index], &spec)!;
    }
    w.write_all(template[lit..])!;
}

// -----------------------------------------------------------------------------
// Specs
// -----------------------------------------------------------------------------

const ALIGN_NONE: u8 = 0;
const ALIGN_LEFT: u8 = 1;
const ALIGN_RIGHT: u8 = 2;
const ALIGN_CENTER: u8 = 3;

/// A parsed `{:...}` spec; see the top of this file.
pub struct Spec {
    fill: u8,
    align: u8,
    plus: bool,
    alt: bool,
    zero: bool,
    width: usize,
    precision: usize,
    has_precision: bool,
    kind: u8,  // 0, 'x', 'X', 'b', 'o', 'e', 'f', '?'

    pub fn default() Spec {
        return Spec.{
            fill: ' ',
            align: ALIGN_NONE,
            plus: false,
            alt: false,
            zero: false,
            width: 0,
            precision: 0,
            has_precision: false,
            kind: 0,
        };
    }
}

fn align_of_char(c: u8) u8 {
    match c {
        '<'  => { return ALIGN_LEFT; }
        '>'  => { return ALIGN_RIGHT; }
        '^'  => { return ALIGN_CENTER; }
        else => { return ALIGN_NONE; }
    }
}

pub fn parse_spec(s: []u8) FmtError!Spec {
    let mut sp = Spec.default();
    let mut i: usize = 0;
    if (s.len >= 2) and (align_of_char(s[1]) != ALIGN_NONE) {
        sp.fill = s[0];
        sp.align = align_of_char(s[1]);
        i = 2;
    } else if (s.len >= 1) and (align_of_char(s[0]) != ALIGN_NONE) {
        sp.align = align_of_char(s[0]);
        i = 1;
    }
    if (i < s.len) and (s[i] == '+') {
        sp.plus = true;
        i += 1;
    }
    if (i < s.len) and (s[i] == '#') {
        sp.alt = true;
        i += 1;
    }
    if (i < s.len) and (s[i] == '0') {
        sp.zero = true;
        i += 1;
    }
    while (i < s.len) and strs.is_digit(s[i]) {
        sp.width = (sp.width * 10) + @as(usize, s[i] - '0');
        i += 1;
        if sp.width > 100000 {
            return error.BadFormat;
        }
    }
    if (i < s.len) and (s[i] == '.') {
        i += 1;
        if (i >= s.len) or not strs.is_digit(s[i]) {
            return error.BadFormat;
        }
        sp.has_precision = true;
        while (i < s.len) and strs.is_digit(s[i]) {
            sp.precision = (sp.precision * 10) + @as(usize, s[i] - '0');
            i += 1;
            if sp.precision > 100000 {
                return error.BadFormat;
            }
        }
    }
    if i < s.len {
        let k = s[i];
        if (k == 'x') or (k == 'X') or (k == 'b') or (k == 'o') or (k == 'e') or (k == 'f') or (k == '?') {
            sp.kind = k;
            i += 1;
        }
    }
    if i != s.len {
        return error.BadFormat;
    }
    return sp;
}

fn write_fill(w: io.Writer, fill: u8, n: usize) !void {
    let mut chunk: [32]u8 = [0; 32];
    @mem_set(chunk[..], fill);
    let mut left = n;
    while left > 0 {
        let k = @min(left, 32);
        w.write_all(chunk[..k])!;
        left -= k;
    }
}

/// Writes `sign` then `body` padded to the spec's width. Zero padding goes
/// between the sign (and prefix) and the digits.
fn write_padded(w: io.Writer, sp: *Spec, prefix: []u8, body: []u8, numeric: bool) !void {
    let len = prefix.len + strs.rune_count(body);
    if len >= sp.width {
        w.write_all(prefix)!;
        w.write_all(body)!;
        return;
    }
    let pad = sp.width - len;
    if numeric and sp.zero and (sp.align == ALIGN_NONE) {
        w.write_all(prefix)!;
        write_fill(w, '0', pad)!;
        w.write_all(body)!;
        return;
    }
    let mut align = sp.align;
    if align == ALIGN_NONE {
        align = ALIGN_LEFT;
        if numeric {
            align = ALIGN_RIGHT;
        }
    }
    let mut before: usize = 0;
    if align == ALIGN_RIGHT {
        before = pad;
    } else if align == ALIGN_CENTER {
        before = pad / 2;
    }
    write_fill(w, sp.fill, before)!;
    w.write_all(prefix)!;
    w.write_all(body)!;
    write_fill(w, sp.fill, pad - before)!;
}

fn write_arg(w: io.Writer, a: Arg, sp: *Spec) !void {
    match a {
        .Int(v) => {
            let neg = v < 0;
            let mut mag = @bit_cast(u64, v);
            if neg {
                mag = 0 -% mag;
            }
            write_integer(w, mag, neg, sp)!;
        }
        .Uint(v)    => { write_integer(w, v, false, sp)!; }
        .Float(v)   => { write_float(w, @bit_cast(u64, v), F64, sp)!; }
        .Float32(v) => { write_float(w, @as(u64, @bit_cast(u32, v)), F32, sp)!; }
        .Str(s)     => { write_string(w, s, sp)!; }
        .Bool(b) => {
            let mut t: []u8 = "false";
            if b {
                t = "true";
            }
            write_string(w, t, sp)!;
        }
        .Rune(r) => {
            let mut tmp: [4]u8 = [0; 4];
            write_string(w, strs.encode_rune(tmp[..], r), sp)!;
        }
    }
}

fn write_string(w: io.Writer, s: []u8, sp: *Spec) !void {
    let mut body = s;
    if sp.has_precision {
        // at most `precision` code points
        let mut it = strs.runes(s);
        let mut n: usize = 0;
        while n < sp.precision {
            _ = it.next() catch break;
            n += 1;
        }
        body = s[..it.pos];
    }
    if sp.kind == '?' {
        let mut q = strs.String.init();
        defer q.deinit();
        write_quoted(q.writer(), body)!;
        write_padded(w, sp, "", q.bytes(), false)!;
        return;
    }
    write_padded(w, sp, "", body, false)!;
}

/// Writes s in double quotes with `"`, `\`, and control characters escaped
/// (\n, \r, \t, or \u{..}); invalid UTF-8 bytes are written as \x...
pub fn write_quoted(w: io.Writer, s: []u8) !void {
    w.write_all("\"")!;
    let hex = "0123456789abcdef";
    let mut i: usize = 0;
    let mut lit: usize = 0;
    while i < s.len {
        let c = s[i];
        let mut esc: []u8 = "";
        let mut tmp: [10]u8 = [0; 10];
        let mut n: usize = 1;
        if c == '"' {
            esc = "\\\"";
        } else if c == '\\' {
            esc = "\\\\";
        } else if c == '\n' {
            esc = "\\n";
        } else if c == '\r' {
            esc = "\\r";
        } else if c == '\t' {
            esc = "\\t";
        } else if (c < 0x20) or (c == 0x7F) {
            tmp[0] = '\\';
            tmp[1] = 'u';
            tmp[2] = '{';
            tmp[3] = hex[@as(usize, c >> 4)];
            tmp[4] = hex[@as(usize, c & 15)];
            tmp[5] = '}';
            esc = tmp[..6];
        } else if c >= 0x80 {
            let r = strs.decode_rune(s[i..]);
            n = r.len;
            if (r.value == strs.REPLACEMENT) and (r.len == 1) {
                tmp[0] = '\\';
                tmp[1] = 'x';
                tmp[2] = hex[@as(usize, c >> 4)];
                tmp[3] = hex[@as(usize, c & 15)];
                esc = tmp[..4];
            }
        }
        if esc.len > 0 {
            w.write_all(s[lit..i])!;
            w.write_all(esc)!;
            lit = i + n;
        }
        i += n;
    }
    w.write_all(s[lit..])!;
    w.write_all("\"")!;
}

// -----------------------------------------------------------------------------
// Integers
// -----------------------------------------------------------------------------

/// The digits of x in `base` (2 to 36), written at the end of buf (64 bytes
/// suffice), lower-case unless `upper`.
pub fn format_uint(buf: []mut u8, x: u64, base: u32, upper: bool) []u8 {
    let mut digits = "0123456789abcdefghijklmnopqrstuvwxyz";
    if upper {
        digits = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    }
    let b = @as(u64, base);
    let mut i = buf.len;
    let mut v = x;
    loop {
        i -= 1;
        buf[i] = digits[@truncate(usize, v % b)];
        v = v / b;
        if v == 0 {
            break;
        }
    }
    return buf[i..];
}

/// Decimal form of any integer, written at the end of buf (40 bytes
/// suffice).
pub fn format_int[T: Int](buf: []mut u8, x: T) []u8 {
    if @min_value(T) < 0 {
        let v = @int_cast(i64, x);
        if v < 0 {
            let digits = format_uint(buf, 0 -% @bit_cast(u64, v), 10, false);
            let start = buf.len - digits.len - 1;
            buf[start] = '-';
            return buf[start..];
        }
        return format_uint(buf, @bit_cast(u64, v), 10, false);
    }
    return format_uint(buf, @int_cast(u64, x), 10, false);
}

fn write_integer(w: io.Writer, mag: u64, neg: bool, sp: *Spec) !void {
    let mut base: u32 = 10;
    let mut pfx: []u8 = "";
    match sp.kind {
        'x' => {
            base = 16;
            pfx = "0x";
        }
        'X' => {
            base = 16;
            pfx = "0x";
        }
        'b' => {
            base = 2;
            pfx = "0b";
        }
        'o' => {
            base = 8;
            pfx = "0o";
        }
        else => {}
    }
    if (sp.kind == 'e') or (sp.kind == 'f') {
        // integers accept the float kinds
        let mut f = @float_from_int(f64, mag);
        if neg {
            f = -f;
        }
        write_float(w, @bit_cast(u64, f), F64, sp)!;
        return;
    }
    let mut tmp: [64]u8 = [0; 64];
    let digits = format_uint(tmp[..], mag, base, sp.kind == 'X');
    let mut prefix: [3]u8 = [0; 3];
    let mut np: usize = 0;
    if neg {
        prefix[0] = '-';
        np = 1;
    } else if sp.plus {
        prefix[0] = '+';
        np = 1;
    }
    if sp.alt and (pfx.len > 0) {
        prefix[np] = pfx[0];
        prefix[np + 1] = pfx[1];
        np += 2;
    }
    write_padded(w, sp, prefix[..np], digits, true)!;
}

fn digit_value(c: u8) u32 {
    if strs.is_digit(c) {
        return @as(u32, c - '0');
    }
    let l = c | 0x20;
    if (l >= 'a') and (l <= 'z') {
        return @as(u32, l - 'a') + 10;
    }
    return 99;
}

/// Parses an integer in `base` (2 to 36) with an optional sign. With base 0
/// the base comes from a prefix: 0x, 0b, 0o, or none for decimal.
/// Fails with InvalidNumber on bad syntax and Overflow if it does not fit.
pub fn parse_int_base[T: Int](s: []u8, base: u32) FmtError!T {
    let mut i: usize = 0;
    let mut neg = false;
    if (s.len > 0) and ((s[0] == '-') or (s[0] == '+')) {
        neg = s[0] == '-';
        i = 1;
    }
    let mut b = base;
    if b == 0 {
        b = 10;
        if ((i + 1) < s.len) and (s[i] == '0') {
            let p = s[i + 1] | 0x20;
            if p == 'x' {
                b = 16;
            } else if p == 'b' {
                b = 2;
            } else if p == 'o' {
                b = 8;
            }
            if b != 10 {
                i += 2;
            }
        }
    }
    if (b < 2) or (b > 36) or (i >= s.len) {
        return error.InvalidNumber;
    }
    let mut mag: u64 = 0;
    let mut over = false;
    while i < s.len {
        let d = digit_value(s[i]);
        if d >= b {
            return error.InvalidNumber;
        }
        let m = @mul_checked(mag, @as(u64, b)) catch 0;
        if (m == 0) and (mag != 0) {
            over = true;
        }
        mag = @add_checked(m, @as(u64, d)) catch 0;
        if (mag == 0) and ((m != 0) or (d != 0)) {
            over = true;
        }
        i += 1;
    }
    if over {
        return error.Overflow;
    }
    if neg {
        if @min_value(T) == 0 {
            if mag != 0 {
                return error.Overflow;
            }
            return @int_cast(T, @as(u64, 0));
        }
        let lim = @int_cast(u64, @max_value(T)) + 1;
        if mag > lim {
            return error.Overflow;
        }
        return @int_cast(T, @bit_cast(i64, 0 -% mag));
    }
    if mag > @int_cast(u64, @max_value(T)) {
        return error.Overflow;
    }
    return @int_cast(T, mag);
}

/// Parses a decimal integer with an optional sign.
pub fn parse_int[T: Int](s: []u8) FmtError!T {
    return parse_int_base.[T](s, 10);
}

// -----------------------------------------------------------------------------
// Exact decimal values of binary floats
// -----------------------------------------------------------------------------

const MAX_DIGITS: usize = 800;

/// A positive decimal 0.d[0]d[1]...d[n-1] x 10^dp, without leading or
/// trailing zeros (n == 0 means zero).
struct Decimal {
    d: [800]u8,
    n: usize,
    dp: i32,
}

fn decimal_zero() Decimal {
    return Decimal.{ d: [0; 800], n: 0, dp: 0 };
}

/// Sets out to the exact value k * 2^e (k > 0). Every such value has a
/// finite decimal expansion: for e < 0, k * 2^e = k * 5^-e / 10^-e.
fn exact(k: u64, e: i32, out: *mut Decimal) void {
    let mut limbs: [100]u64 = [0; 100];  // base 1e9, least significant first
    limbs[0] = k % 1_000_000_000;
    limbs[1] = (k / 1_000_000_000) % 1_000_000_000;
    limbs[2] = k / 1_000_000_000_000_000_000;
    let mut n: usize = 3;
    let mut mul: u64 = 2;
    let mut times = e;
    let mut shift: i32 = 0;
    if e < 0 {
        mul = 5;
        times = -e;
        shift = e;
    }
    while times > 0 {
        // multiply by mul^j, keeping the factor below 2^31
        let mut j: i32 = 0;
        let mut f: u64 = 1;
        while (j < times) and (f < 200_000_000) {
            f *= mul;
            j += 1;
        }
        times -= j;
        let mut carry: u64 = 0;
        for i in 0..n {
            let v = (limbs[i] * f) + carry;
            limbs[i] = v % 1_000_000_000;
            carry = v / 1_000_000_000;
        }
        while carry > 0 {
            limbs[n] = carry % 1_000_000_000;
            carry = carry / 1_000_000_000;
            n += 1;
        }
    }
    while (n > 1) and (limbs[n - 1] == 0) {
        n -= 1;
    }
    let mut nd: usize = 0;
    let mut i = n;
    while i > 0 {
        i -= 1;
        let mut t = limbs[i];
        let mut d: [9]u8 = [0; 9];
        for q in @as(usize, 0)..9 {
            d[8 - q] = @truncate(u8, t % 10);
            t = t / 10;
        }
        let mut q0: usize = 0;
        if nd == 0 {
            while (q0 < 9) and (d[q0] == 0) {
                q0 += 1;
            }
        }
        for q in q0..9 {
            out.d[nd] = d[q];
            nd += 1;
        }
    }
    out.dp = @int_cast(i32, nd) + shift;
    while (nd > 0) and (out.d[nd - 1] == 0) {
        nd -= 1;
    }
    out.n = nd;
}

/// Compares two positive decimals.
fn compare_decimal(a: *Decimal, b: *Decimal) i32 {
    if a.dp != b.dp {
        if a.dp < b.dp {
            return -1;
        }
        return 1;
    }
    let n = @max(a.n, b.n);
    for i in 0..n {
        let mut x: u8 = 0;
        let mut y: u8 = 0;
        if i < a.n {
            x = a.d[i];
        }
        if i < b.n {
            y = b.d[i];
        }
        if x != y {
            if x < y {
                return -1;
            }
            return 1;
        }
    }
    return 0;
}

// -----------------------------------------------------------------------------
// Float layouts
// -----------------------------------------------------------------------------

struct FloatKind {
    mbits: u32,  // stored mantissa bits: 52 or 23
    ebits: u32,  // exponent bits: 11 or 8
    bias: i32,   // exponent of the smallest subnormal: -1074 or -149
    max_digits: usize,
}

let F64: FloatKind = FloatKind.{ mbits: 52, ebits: 11, bias: -1074, max_digits: 17 };
let F32: FloatKind = FloatKind.{ mbits: 23, ebits: 8, bias: -149, max_digits: 9 };

/// A finite positive value m * 2^e, and whether the next value down is
/// closer than the next value up (at a power of two).
struct Parts {
    m: u64,
    e: i32,
    lower_closer: bool,
}

fn exp_mask(k: FloatKind) u64 {
    return (@as(u64, 1) << k.ebits) - 1;
}

fn frac_mask(k: FloatKind) u64 {
    return (@as(u64, 1) << k.mbits) - 1;
}

fn split_bits(bits: u64, k: FloatKind) Parts {
    let f = bits & frac_mask(k);
    let be = (bits >> k.mbits) & exp_mask(k);
    if be == 0 {
        return Parts.{ m: f, e: k.bias, lower_closer: false };
    }
    return Parts.{
        m: f | (@as(u64, 1) << k.mbits),
        e: (@int_cast(i32, be) - 1) + k.bias,
        lower_closer: (f == 0) and (be > 1),
    };
}

// -----------------------------------------------------------------------------
// Shortest digits
// -----------------------------------------------------------------------------

/// Up to 20 significant digits and a decimal point position:
/// 0.d[0]..d[n-1] x 10^dp.
struct Digits {
    d: [20]u8,
    n: usize,
    dp: i32,
}

/// Digit `pos` of x on a grid whose first position is 10^(top - 1).
fn digit_at(x: *Decimal, top: i32, pos: i32) u64 {
    let i = pos - (top - x.dp);
    if (i < 0) or (i >= @int_cast(i32, x.n)) {
        return 0;
    }
    return @as(u64, x.d[@int_cast(usize, i)]);
}

fn prefix_of(x: *Decimal, top: i32, k: i32) u64 {
    let mut v: u64 = 0;
    for pos in 0..k {
        v = (v * 10) + digit_at(x, top, pos);
    }
    return v;
}

/// Whether x has a non-zero digit at grid position k or later.
fn rest_nonzero(x: *Decimal, top: i32, k: i32) bool {
    let first = k - (top - x.dp);
    return first < @int_cast(i32, x.n);
}

/// The shortest decimal that reads back as the float m * 2^e, and of those
/// the closest to it.
fn shortest(p: Parts, out: *mut Digits) void {
    let mut v = decimal_zero();
    let mut lo = decimal_zero();
    let mut hi = decimal_zero();
    exact(p.m, p.e, &mut v);
    exact((2 * p.m) + 1, p.e - 1, &mut hi);
    if p.lower_closer {
        exact((4 * p.m) - 1, p.e - 2, &mut lo);
    } else {
        exact((2 * p.m) - 1, p.e - 1, &mut lo);
    }
    // the midpoints themselves round to v when its mantissa is even
    let inclusive = (p.m & 1) == 0;
    let top = hi.dp;
    let mut k: i32 = 1;
    while k < 20 {
        // the smallest grid number >= lo (> lo if exclusive)
        let mut nlo = prefix_of(&lo, top, k);
        if rest_nonzero(&lo, top, k) or not inclusive {
            nlo += 1;
        }
        // the largest grid number <= hi (< hi if exclusive)
        let mut nhi = prefix_of(&hi, top, k);
        let mut ok = true;
        if not rest_nonzero(&hi, top, k) and not inclusive {
            if nhi == 0 {
                ok = false;
            } else {
                nhi -= 1;
            }
        }
        if ok and (nlo <= nhi) {
            // v rounded to k digits, ties to even, then kept in range
            let mut nv = prefix_of(&v, top, k);
            if rest_nonzero(&v, top, k) {
                let d = digit_at(&v, top, k);
                let more = rest_nonzero(&v, top, k + 1);
                if (d > 5) or ((d == 5) and (more or ((nv & 1) == 1))) {
                    nv += 1;
                }
            }
            if nv < nlo {
                nv = nlo;
            }
            if nv > nhi {
                nv = nhi;
            }
            let mut tmp: [20]u8 = [0; 20];
            let mut t = nv;
            let mut nd: usize = 0;
            while t > 0 {
                tmp[nd] = @truncate(u8, t % 10);
                t = t / 10;
                nd += 1;
            }
            out.dp = (top - k) + @int_cast(i32, nd);
            let mut z: usize = 0;
            while (z < nd) and (tmp[z] == 0) {
                z += 1;
            }
            out.n = nd - z;
            for q in 0..out.n {
                out.d[q] = tmp[nd - 1 - q];
            }
            return;
        }
        k += 1;
    }
    @trap();
}

// -----------------------------------------------------------------------------
// Fast paths: 64-bit arithmetic with error bounds, falling back to the exact
// code above when the bounds cannot decide (Grisu3 for formatting and
// extended-precision Clinger for parsing, as in Google's double-conversion)
// -----------------------------------------------------------------------------

