// =============================================================================
// std/compress/lz4.ax - LZ4: very fast compression (the frame format, and blocks).
//
//     let packed = lz4.compress(data, lz4.Options.default())!;   // the caller frees
//     let back = lz4.decompress(packed, 1 << 30)!;               // at most 1 GiB out
//     lz4.compress_to(w, data, lz4.Options.default())!;          // to an io.Writer
//
// decompress reads LZ4 frames (any block size, independent or linked
// blocks, block and content checksums, stored content sizes), skippable
// frames and the legacy format, one after another. compress writes a frame
// with a content size and content checksum; Options.level trades speed for
// size (1 looks at one earlier position per byte, higher levels follow
// hash chains further). compress_block and decompress_block handle raw
// blocks, for formats that embed them.
//
// Decompression checks every length and offset and stops at max_size, so
// hostile input cannot overrun anything or balloon.
// =============================================================================

import "../hash/xxhash.ax" as xxhash;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../os/fs.ax" as fs;
import "../str.ax" as strs;

error { Corrupt, ChecksumMismatch, TooLarge, Unsupported, OutOfMemory }

const MAGIC: u32 = 0x184d2204;
const LEGACY_MAGIC: u32 = 0x184c2102;
const MIN_MATCH: usize = 4;
const LAST_LITERALS: usize = 5;
const MF_LIMIT: usize = 12;

fn le32(b: []u8, i: usize) u32 {
    return @as(u32, b[i]) | (@as(u32, b[i + 1]) << 8) | (@as(u32, b[i + 2]) << 16) | (@as(u32, b[i + 3]) << 24);
}

fn put32(out: *mut strs.String, v: u32) !void {
    let b: [4]u8 = [@truncate(u8, v), @truncate(u8, v >> 8), @truncate(u8, v >> 16), @truncate(u8, v >> 24)];
    out.push_str(b[..])!;
}

// -----------------------------------------------------------------------------
// Blocks
// -----------------------------------------------------------------------------

/// Decompresses one block, appending to out. Matches may reach back into
/// what out already holds (as linked blocks do). Fails with TooLarge if
/// out would grow past max_size bytes.
pub fn decompress_block(src: []u8, out: *mut strs.String, max_size: usize) !void {
    let mut i: usize = 0;
    loop {
        if i >= src.len {
            return error.Corrupt;
        }
        let token = src[i];
        i += 1;
        // literals
        let mut lit = @as(usize, token >> 4);
        if lit == 15 {
            loop {
                if i >= src.len {
                    return error.Corrupt;
                }
                let b = src[i];
                i += 1;
                lit += @as(usize, b);
                if lit > src.len {
                    return error.Corrupt;
                }
                if b != 255 {
                    break;
                }
            }
        }
        if lit > (src.len - i) {
            return error.Corrupt;
        }
        if (out.len + lit) > max_size {
            return error.TooLarge;
        }
        out.push_str(src[i..i + lit])!;
        i += lit;
        if i == src.len {
            return;  // the last sequence has only literals
        }
        // the match
        if (i + 2) > src.len {
            return error.Corrupt;
        }
        let off = @as(usize, src[i]) | (@as(usize, src[i + 1]) << 8);
        i += 2;
        if (off == 0) or (off > out.len) {
            return error.Corrupt;
        }
        let mut ml = @as(usize, token & 15) + MIN_MATCH;
        if (token & 15) == 15 {
            loop {
                if i >= src.len {
                    return error.Corrupt;
                }
                let b = src[i];
                i += 1;
                ml += @as(usize, b);
                if ml > (max_size + 1) {
                    return error.TooLarge;
                }
                if b != 255 {
                    break;
                }
            }
        }
        if (out.len + ml) > max_size {
            return error.TooLarge;
        }
        out.reserve(ml)!;
        let buf = out.buf;
        let mut at = out.len;
        let mut from = at - off;
        if off >= ml {
            @mem_copy(buf[at..at + ml], buf[from..from + ml]);
        } else {
            for _k in @as(usize, 0)..ml {
                buf[at] = buf[from];
                at += 1;
                from += 1;
            }
        }
        out.len += ml;
    }
}

const HASH_BITS: u64 = 16;

fn hash4(b: []u8, i: usize) usize {
    let v = le32(b, i);
    return @truncate(usize, (@as(u64, v) *% 2654435761) >> 16) & ((@as(usize, 1) << @truncate(u32, HASH_BITS)) - 1);
}

fn put_len(out: *mut strs.String, n: usize) !void {
    let mut r = n;
    while r >= 255 {
        out.push(255)!;
        r -= 255;
    }
    out.push(@truncate(u8, r))!;
}

fn sequence(out: *mut strs.String, lits: []u8, off: usize, ml: usize) !void {
    let mut token: u8 = 0;
    if lits.len >= 15 {
        token = 0xf0;
    } else {
        token = @truncate(u8, lits.len << 4);
    }
    if ml > 0 {
        if (ml - MIN_MATCH) >= 15 {
            token |= 15;
        } else {
            token |= @truncate(u8, ml - MIN_MATCH);
        }
    }
    out.push(token)!;
    if lits.len >= 15 {
        put_len(out, lits.len - 15)!;
    }
    out.push_str(lits)!;
    if ml > 0 {
        out.push(@truncate(u8, off))!;
        out.push(@truncate(u8, off >> 8))!;
        if (ml - MIN_MATCH) >= 15 {
            put_len(out, ml - MIN_MATCH - 15)!;
        }
    }
}

/// Compresses src as one block, appending to out. level: 1 (fastest) to
/// 12 (smallest).
pub fn compress_block(src: []u8, out: *mut strs.String, level: u32) !void {
    let n = src.len;
    if n < (MF_LIMIT + 1) {
        return sequence(out, src, 0, 0);
    }
    let size = @as(usize, 1) << @truncate(u32, HASH_BITS);
    let head = mem.alloc.[u32](size)!;
    defer mem.free(head);
    @mem_set(@cast_slice(u8, head), 0xff);
    let mut chain: []mut u32 = @slice_from_ptr(@ptr_from_int(*mut u32, 4), 0);
    let depth = @as(usize, 1) << @truncate(u32, @min(level, 12) - @min(level, 1));
    if depth > 1 {
        chain = mem.alloc.[u32](n)!;
    }
    defer {
        if chain.len > 0 {
            mem.free(chain);
        }
    }
    let limit = n - MF_LIMIT;           // matches start before this
    let match_end = n - LAST_LITERALS;  // and end by this
    let mut anchor: usize = 0;
    let mut i: usize = 0;
    while i < limit {
        let h = hash4(src, i);
        let mut cand = head[h];
        let mut best_len: usize = 0;
        let mut best_off: usize = 0;
        let mut tries = depth;
        while (cand != 0xffffffff) and (tries > 0) {
            let c = @as(usize, cand);
            if (i - c) > 65535 {
                break;
            }
            if le32(src, c) == le32(src, i) {
                let mut l = MIN_MATCH;
                while ((i + l) < match_end) and (src[c + l] == src[i + l]) {
                    l += 1;
                }
                if l > best_len {
                    best_len = l;
                    best_off = i - c;
                }
            }
            tries -= 1;
            if chain.len == 0 {
                break;
            }
            cand = chain[c];
        }
        if chain.len > 0 {
            chain[i] = head[h];
        }
        head[h] = @truncate(u32, i);
        if best_len < MIN_MATCH {
            i += 1;
            continue;
        }
        sequence(out, src[anchor..i], best_off, best_len)!;
        // index the positions the match covers (cheaply at low levels)
        let end = i + best_len;
        let mut j = i + 1;
        let step: usize = 1;
        while (j < end) and (j < limit) {
            let hj = hash4(src, j);
            if chain.len > 0 {
                chain[j] = head[hj];
            }
            head[hj] = @truncate(u32, j);
            j += step;
        }
        i = end;
        anchor = i;
    }
    return sequence(out, src[anchor..], 0, 0);
}

// -----------------------------------------------------------------------------
// Frames
// -----------------------------------------------------------------------------

/// Decompresses LZ4 frames (and skippable and legacy frames) one after
/// another; the caller frees the result.
pub fn decompress(data: []u8, max_size: usize) ![]mut u8 {
    let mut out = strs.String.init();
    decode_frames(data, &mut out, max_size) catch |e| {
        out.deinit();
        return e;
    };
    return out.take();
}

fn decode_frames(data: []u8, out: *mut strs.String, max_size: usize) !void {
    let mut i: usize = 0;
    if data.len < 4 {
        return error.Corrupt;
    }
    while i < data.len {
        if (data.len - i) < 4 {
            return error.Corrupt;
        }
        let magic = le32(data, i);
        if (magic & 0xfffffff0) == 0x184d2a50 {
            if (data.len - i) < 8 {
                return error.Corrupt;
            }
            let n = @as(usize, le32(data, i + 4));
            if n > (data.len - i - 8) {
                return error.Corrupt;
            }
            i += 8 + n;
            continue;
        }
        if magic == LEGACY_MAGIC {
            i = legacy(data, i + 4, out, max_size)!;
            continue;
        }
        if magic != MAGIC {
            return error.Corrupt;
        }
        i = frame(data, i + 4, out, max_size)!;
    }
}

fn legacy(data: []u8, at: usize, out: *mut strs.String, max_size: usize) !usize {
    let mut i = at;
    while (data.len - i) >= 4 {
        let w = le32(data, i);
        if w == LEGACY_MAGIC {
            return i;  // the next legacy frame
        }
        let n = @as(usize, w);
        if n > (data.len - i - 4) {
            return error.Corrupt;
        }
        // legacy blocks are independent
        let mut blk = strs.String.init();
        defer blk.deinit();
        decompress_block(data[i + 4..i + 4 + n], &mut blk, @min(max_size - out.len, 8 << 20))!;
        out.push_str(blk.bytes())!;
        i += 4 + n;
    }
    return data.len;
}

fn frame(data: []u8, at: usize, out: *mut strs.String, max_size: usize) !usize {
    let mut i = at;
    if (data.len - i) < 3 {
        return error.Corrupt;
    }
    let flg = data[i];
    let bd = data[i + 1];
    if ((flg >> 6) != 1) or ((flg & 2) != 0) or ((bd & 0x8f) != 0) {
        return error.Corrupt;
    }
    let bsize_id = (bd >> 4) & 7;
    if bsize_id < 4 {
        return error.Corrupt;
    }
    let max_block = @as(usize, 1) << (8 + (2 * @as(u32, bsize_id)));
    let linked = (flg & 0x20) == 0;
    let block_sum = (flg & 0x10) != 0;
    let has_size = (flg & 8) != 0;
    let content_sum = (flg & 4) != 0;
    let dict = (flg & 1) != 0;
    let mut hlen: usize = 2;
    if has_size {
        hlen += 8;
    }
    if dict {
        hlen += 4;
    }
    if (data.len - i) < (hlen + 1) {
        return error.Corrupt;
    }
    let hc = @truncate(u8, xxhash.xxh32(data[i..i + hlen], 0) >> 8);
    if hc != data[i + hlen] {
        return error.ChecksumMismatch;
    }
    if dict {
        return error.Unsupported;  // (a preset dictionary)
    }
    let mut content_size: u64 = 0;
    if has_size {
        for k in @as(usize, 0)..8 {
            content_size |= @as(u64, data[i + 2 + k]) << @as(u64, 8 * k);
        }
    }
    i += hlen + 1;
    let start = out.len;
    let mut blk = strs.String.init();
    defer blk.deinit();
    loop {
        if (data.len - i) < 4 {
            return error.Corrupt;
        }
        let word = le32(data, i);
        i += 4;
        if word == 0 {
            break;
        }
        let stored = (word & 0x80000000) != 0;
        let n = @as(usize, word & 0x7fffffff);
        if (n > max_block) or (n > (data.len - i)) {
            return error.Corrupt;
        }
        let b = data[i..i + n];
        i += n;
        if block_sum {
            if (data.len - i) < 4 {
                return error.Corrupt;
            }
            if xxhash.xxh32(b, 0) != le32(data, i) {
                return error.ChecksumMismatch;
            }
            i += 4;
        }
        if stored {
            if (out.len + n) > max_size {
                return error.TooLarge;
            }
            out.push_str(b)!;
        } else if linked {
            // matches may reach into earlier blocks of the frame
            let before = out.len;
            decompress_block(b, out, @min(max_size, before + max_block))!;
            if (out.len - before) > max_block {
                return error.Corrupt;
            }
        } else {
            blk.clear();
            decompress_block(b, &mut blk, @min(max_size - out.len, max_block))!;
            out.push_str(blk.bytes())!;
        }
    }
    if has_size and (@as(u64, out.len - start) != content_size) {
        return error.Corrupt;
    }
    if content_sum {
        if (data.len - i) < 4 {
            return error.Corrupt;
        }
        if xxhash.xxh32(out.bytes()[start..], 0) != le32(data, i) {
            return error.ChecksumMismatch;
        }
        i += 4;
    }
    return i;
}

pub struct Options {
    level: u32,         // 1 (fastest) to 12
    block_size: usize,  // 64 KiB, 256 KiB, 1 MiB or 4 MiB
    content_checksum: bool,
    block_checksum: bool,
    content_size: bool,  // record the size in the header

    pub fn default() Options {
        return Options.{ level: 1, block_size: 4 << 20, content_checksum: true, block_checksum: false,
                         content_size: true };
    }
}

/// Compresses data as one LZ4 frame (independent blocks); the caller frees
/// the result.
pub fn compress(data: []u8, opts: Options) ![]mut u8 {
    let mut out = strs.String.init();
    compress_to(out.writer(), data, opts) catch |e| {
        out.deinit();
        return e;
    };
    return out.take();
}

/// Compresses data as one LZ4 frame and writes it to w, a block at a time
/// (only the block being compressed is held in memory).
pub fn compress_to(w: io.Writer, data: []u8, o: Options) !void {
    let mut bsize_id: u8 = 7;
    if o.block_size <= (64 << 10) {
        bsize_id = 4;
    } else if o.block_size <= (256 << 10) {
        bsize_id = 5;
    } else if o.block_size <= (1 << 20) {
        bsize_id = 6;
    }
    let max_block = @as(usize, 1) << (8 + (2 * @as(u32, bsize_id)));
    let mut blk = strs.String.init();
    defer blk.deinit();
    put32(&mut blk, MAGIC)!;
    let mut flg: u8 = 0x60;  // version 1, independent blocks
    if o.block_checksum {
        flg |= 0x10;
    }
    if o.content_size {
        flg |= 8;
    }
    if o.content_checksum {
        flg |= 4;
    }
    blk.push(flg)!;
    blk.push(bsize_id << 4)!;
    if o.content_size {
        let n = @as(u64, data.len);
        put32(&mut blk, @truncate(u32, n))!;
        put32(&mut blk, @truncate(u32, n >> 32))!;
    }
    blk.push(@truncate(u8, xxhash.xxh32(blk.bytes()[4..], 0) >> 8))!;
    w.write_all(blk.bytes())!;
    let mut i: usize = 0;
    while i < data.len {
        let chunk = data[i..@min(i + max_block, data.len)];
        i += chunk.len;
        // the block's size word, its body and its checksum, in one write
        blk.clear();
        put32(&mut blk, 0)!;
        compress_block(chunk, &mut blk, o.level)!;
        let mut word = @truncate(u32, blk.len - 4);
        if (blk.len - 4) >= chunk.len {
            blk.truncate(4);  // stored: compression did not help
            blk.push_str(chunk)!;
            word = @truncate(u32, chunk.len) | 0x80000000;
        }
        let b = blk.bytes();
        b[0] = @truncate(u8, word);
        b[1] = @truncate(u8, word >> 8);
        b[2] = @truncate(u8, word >> 16);
        b[3] = @truncate(u8, word >> 24);
        if o.block_checksum {
            let sum = xxhash.xxh32(blk.bytes()[4..], 0);
            put32(&mut blk, sum)!;
        }
        w.write_all(blk.bytes())!;
    }
    blk.clear();
    put32(&mut blk, 0)!;
    if o.content_checksum {
        put32(&mut blk, xxhash.xxh32(data, 0))!;
    }
    w.write_all(blk.bytes())!;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

test "files made by the lz4 library" {
    let corpus = fs.read_file("std/compress/testdata/corpus.bin") catch return;
    defer mem.free(corpus);
    let mut dir = fs.read_dir("std/compress/lz4/testdata")!;
    defer dir.deinit();
    let mut n: usize = 0;
    for e in dir.entries.items() {
        let mut p = strs.String.init();
        defer p.deinit();
        p.push_str("std/compress/lz4/testdata/")!;
        p.push_str(e.name)!;
        let data = fs.read_file(p.bytes())!;
        defer mem.free(data);
        let got = decompress(data, 1 << 24)!;
        defer mem.free(got);
        if strs.starts_with(e.name, "corpus") {
            @expect_eq(got, corpus);
        } else if strs.starts_with(e.name, "short") {
            @expect_eq(got, "Hello, Hello, Hello, world!\n");
        } else {
            @expect_eq(got.len, 0);
        }
        n += 1;
    }
    @expect(n >= 7);
}

test "round trips" {
    let corpus = fs.read_file("std/compress/testdata/corpus.bin") catch return;
    defer mem.free(corpus);
    let mut o = Options.default();
    let mut last: usize = 0xffffffff;
    for level in [@as(u32, 1), 4, 9]{
        o.level = level;
        let c = compress(corpus, o)!;
        defer mem.free(c);
        @expect(c.len < ((corpus.len * 3) / 4));
        @expect(c.len <= last);
        last = c.len;
        let d = decompress(c, corpus.len)!;
        defer mem.free(d);
        @expect_eq(d, corpus);
        @expect(fails(decompress(c, corpus.len - 1)));  // the size limit
    }
    o.block_size = 64 << 10;
    o.block_checksum = true;
    o.content_size = false;
    for input in ["", "a", "abcabcabcabcabcabcabcabcabc", "0123456789012"]{
        let c = compress(input, o)!;
        defer mem.free(c);
        let d = decompress(c, 100)!;
        defer mem.free(d);
        @expect_eq(d, input);
    }
    let c = compress(corpus, o)!;
    defer mem.free(c);
    let d = decompress(c, corpus.len)!;
    defer mem.free(d);
    @expect_eq(d, corpus);
}

test "compress_to" {
    // compressible and incompressible blocks, with block checksums
    let data = mem.alloc.[u8](150000)!;
    defer mem.free(data);
    let mut x: u32 = 1;
    for i in @as(usize, 0)..data.len {
        x = (x *% 1103515245) +% 12345;
        data[i] = @truncate(u8, x >> 16);
        if ((i / 40000) % 2) == 0 {
            data[i] = @truncate(u8, i % 7);
        }
    }
    let mut o = Options.default();
    o.block_size = 64 << 10;
    o.block_checksum = true;
    let c = compress(data, o)!;
    defer mem.free(c);
    let mut out = strs.String.init();
    defer out.deinit();
    compress_to(out.writer(), data, o)!;
    @expect_eq(out.bytes(), c);
    let d = decompress(c, data.len)!;
    defer mem.free(d);
    @expect_eq(d, data);
    let mut small: [100]u8 = [0; 100];
    let mut bw = io.BufferWriter.init(small[..]);
    compress_to(bw.writer(), data, o) catch |e| {
        @expect_eq(e, error.NoSpaceLeft);
        return;
    };
    @trap();
}

fn fails(r: ![]mut u8) bool {
    let x = r catch return true;
    mem.free(x);
    return false;
}

test "damaged input" {
    let c = compress("hello hello hello hello hello hello", Options.default())!;
    defer mem.free(c);
    // every truncation and every single-bit change fails or decodes safely
    for n in @as(usize, 0)..c.len {
        @expect(fails(decompress(c[..n], 1000)));
    }
    let mut b = strs.String.from(c)!;
    defer b.deinit();
    for k in @as(usize, 0)..(c.len * 8) {
        b.bytes()[k / 8] ^= @truncate(u8, @as(u32, 1) << @as(u32, @truncate(u8, k % 8)));
        let r = decompress(b.bytes(), 1000) catch {
            b.bytes()[k / 8] ^= @truncate(u8, @as(u32, 1) << @as(u32, @truncate(u8, k % 8)));
            continue;
        };
        mem.free(r);
        b.bytes()[k / 8] ^= @truncate(u8, @as(u32, 1) << @as(u32, @truncate(u8, k % 8)));
    }
    // raw blocks: offsets before the start, and lengths past the end
    let mut out = strs.String.init();
    defer out.deinit();
    @expect(fails_block("\x00\x05\x00", &mut out));      // offset 5 into nothing
    @expect(fails_block("\xf0\xff\xff\xff", &mut out));  // literals past the end
    @expect(fails_block("\x1fa\x01\x00\xff\xff\xff\xff\xff\xff\xff\xff", &mut out));  // a huge match
}

fn fails_block(b: []u8, out: *mut strs.String) bool {
    out.clear();
    decompress_block(b, out, 1000) catch return true;
    return false;
}
