// =============================================================================
// std/compress/internal/testdata.ax - helpers for the compressors' tests: the
// files in their testdata directories, made by the formats' reference
// libraries, and a check that a decoder fails.
// =============================================================================

import "../../mem.ax" as mem;
import "../../os/fs.ax" as fs;
import "../../str.ax" as strs;

/// Whether r is an error (freeing the result if it is not).
pub fn fails(r: ![]mut u8) bool {
    let x = r catch return true;
    mem.free(x);
    return false;
}

/// Decodes each file in dir whose name ends with ext, and checks what it holds by its
/// name: corpus (std/compress/testdata/corpus.bin) for "corpus...", a short greeting
/// for "short...", nothing for any other. Returns the number of files checked.
pub fn check_files(dir: []u8, ext: []u8, corpus: []u8, decode: fn([]u8, usize) ![]mut u8) !usize {
    let mut d = fs.read_dir(dir)!;
    defer d.deinit();
    let mut n: usize = 0;
    for e in d.entries.items() {
        if not strs.ends_with(e.name, ext) {
            continue;
        }
        let mut p = strs.String.init();
        defer p.deinit();
        p.push_str(dir)!;
        p.push('/')!;
        p.push_str(e.name)!;
        let data = fs.read_file(p.bytes())!;
        defer mem.free(data);
        let got = decode(data, 1 << 24)!;
        defer mem.free(got);
        if strs.starts_with(e.name, "corpus") {
            @expect_eq(got, corpus);
        } else if strs.starts_with(e.name, "short") {
            @expect_eq(got, "Hello, Hello, Hello, world!\n");
        } else {
            @expect_eq(got.len, 0);
        }
        n += 1;
    }
    return n;
}
