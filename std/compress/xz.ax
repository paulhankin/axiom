/// The CRC-64 of xz (ECMA-182), continued from crc (0 to start).
pub fn crc64(crc: u64, data: []u8) u64 {
    let mut c = ~crc;
    for b in data {
        c = CRC64_TABLE[@as(usize, @truncate(u8, c) ^ b)] ^ (c >> 8);
    }
    return ~c;
}

// -----------------------------------------------------------------------------
// The range decoder and the LZMA decoder
// -----------------------------------------------------------------------------

const PROB_INIT: u16 = 1024;
const NUM_STATES: usize = 12;
const MATCH_MIN: usize = 2;

struct Rc {
    s: []u8,
    i: usize,
    range: u32,
    code: u32,
    over: bool,  // read past the end (the input is corrupt)

    fn init(s: []u8) XzError!Rc {
        if (s.len < 5) or (s[0] != 0) {
            return error.Corrupt;
        }
        let code = (@as(u32, s[1]) << 24) | (@as(u32, s[2]) << 16) | (@as(u32, s[3]) << 8) | @as(u32, s[4]);
        return Rc.{ s: s, i: 5, range: 0xffffffff, code: code, over: false };
    }

    fn next(self: *mut Rc) u32 {
        if self.i >= self.s.len {
            self.over = true;
            return 0;
        }
        let b = self.s[self.i];
        self.i += 1;
        return @as(u32, b);
    }

    fn bit(self: *mut Rc, p: *mut u16) u32 {
        let bound = (self.range >> 11) * @as(u32, p.*);
        let mut r: u32 = 0;
        if self.code < bound {
            self.range = bound;
            p.* += (2048 - p.*) >> 5;
        } else {
            self.range -= bound;
            self.code -= bound;
            p.* -= p.* >> 5;
            r = 1;
        }
        if self.range < 0x1000000 {
            self.range <<= 8;
            self.code = (self.code << 8) | self.next();
        }
        return r;
    }

    fn direct(self: *mut Rc, n: u32) u32 {
        let mut r: u32 = 0;
        for _k in @as(u32, 0)..n {
            self.range >>= 1;
            let mut b: u32 = 0;
            if self.code >= self.range {
                self.code -= self.range;
                b = 1;
            }
            r = (r << 1) | b;
            if self.range < 0x1000000 {
                self.range <<= 8;
                self.code = (self.code << 8) | self.next();
            }
        }
        return r;
    }

    fn tree(self: *mut Rc, probs: []mut u16, bits: u32) u32 {
        let mut m: u32 = 1;
        for _k in @as(u32, 0)..bits {
            m = (m << 1) | self.bit(&mut probs[@as(usize, m)]);
        }
        return m - (@as(u32, 1) << bits);
    }

    fn reverse(self: *mut Rc, probs: []mut u16, bits: u32) u32 {
        let mut m: u32 = 1;
        let mut r: u32 = 0;
        for k in @as(u32, 0)..bits {
            let b = self.bit(&mut probs[@as(usize, m)]);
            m = (m << 1) | b;
            r |= b << k;
        }
        return r;
    }
}

struct LenCoder {
    choice: u16,
    choice2: u16,
    low: [128]u16,
    mid: [128]u16,
    high: [256]u16,

    fn reset(self: *mut LenCoder) void {
        self.choice = PROB_INIT;
        self.choice2 = PROB_INIT;
        for k in @as(usize, 0)..128 {
            self.low[k] = PROB_INIT;
            self.mid[k] = PROB_INIT;
        }
        for k in @as(usize, 0)..256 {
            self.high[k] = PROB_INIT;
        }
    }

    // A length less MATCH_MIN.
    fn decode(self: *mut LenCoder, rc: *mut Rc, pos_state: usize) u32 {
        if rc.bit(&mut self.choice) == 0 {
            return rc.tree(self.low[pos_state * 8..(pos_state * 8) + 8], 3);
        }
        if rc.bit(&mut self.choice2) == 0 {
            return 8 + rc.tree(self.mid[pos_state * 8..(pos_state * 8) + 8], 3);
        }
        return 16 + rc.tree(self.high[..], 8);
    }
}

// The probability model and state of LZMA (shared by the encoder).
struct Model {
    lc: u32,
    lp: u32,
    pb: u32,
    state: usize,
    reps: [4]u32,
    is_match: [192]u16,
    is_rep: [12]u16,
    is_rep_g0: [12]u16,
    is_rep_g1: [12]u16,
    is_rep_g2: [12]u16,
    is_rep0_long: [192]u16,
    pos_slot: [256]u16,
    pos_special: [115]u16,
    align: [16]u16,
    len: LenCoder,
    rep_len: LenCoder,
    literal: []mut u16,

    fn deinit(self: *mut Model) void {
        if self.literal.len > 0 {
            mem.free(self.literal);
        }
    }

    // New properties (lc + lp at most 12); resets the state.
    fn set_props(self: *mut Model, lc: u32, lp: u32, pb: u32) XzError!void {
        if (lc > 8) or (lp > 4) or (pb > 4) {
            return error.Corrupt;
        }
        let n = @as(usize, 0x300) << @truncate(u32, lc + lp);
        if n != self.literal.len {
            if self.literal.len > 0 {
                mem.free(self.literal);
            }
            self.literal = @slice_from_ptr(@ptr_from_int(*mut u16, 2), 0);
            self.literal = mem.alloc.[u16](n)!;
        }
        self.lc = lc;
        self.lp = lp;
        self.pb = pb;
        self.reset();
    }

    fn reset(self: *mut Model) void {
        self.state = 0;
        self.reps = [0, 0, 0, 0];
        for k in @as(usize, 0)..192 {
            self.is_match[k] = PROB_INIT;
            self.is_rep0_long[k] = PROB_INIT;
        }
        for k in @as(usize, 0)..12 {
            self.is_rep[k] = PROB_INIT;
            self.is_rep_g0[k] = PROB_INIT;
            self.is_rep_g1[k] = PROB_INIT;
            self.is_rep_g2[k] = PROB_INIT;
        }
        for k in @as(usize, 0)..256 {
            self.pos_slot[k] = PROB_INIT;
        }
        for k in @as(usize, 0)..115 {
            self.pos_special[k] = PROB_INIT;
        }
        for k in @as(usize, 0)..16 {
            self.align[k] = PROB_INIT;
        }
        for k in @as(usize, 0)..self.literal.len {
            self.literal[k] = PROB_INIT;
        }
        self.len.reset();
        self.rep_len.reset();
    }
}

fn new_model() Model {
    return Model.{ lc: 0, lp: 0, pb: 0, state: 0, reps: [0, 0, 0, 0], is_match: [0; 192], is_rep: [0; 12],
                   is_rep_g0: [0; 12], is_rep_g1: [0; 12], is_rep_g2: [0; 12], is_rep0_long: [0; 192],
                   pos_slot: [0; 256], pos_special: [0; 115], align: [0; 16],
                   len: LenCoder.{ choice: 0, choice2: 0, low: [0; 128], mid: [0; 128], high: [0; 256] },
                   rep_len: LenCoder.{ choice: 0, choice2: 0, low: [0; 128], mid: [0; 128], high: [0; 256] },
                   literal: @slice_from_ptr(@ptr_from_int(*mut u16, 2), 0) };
}

fn after_literal(s: usize) usize {
    if s < 4 {
        return 0;
    }
    if s < 10 {
        return s - 3;
    }
    return s - 6;
}

fn after_match(s: usize) usize {
    if s < 7 {
        return 7;
    }
    return 10;
}

fn after_rep(s: usize) usize {
    if s < 7 {
        return 8;
    }
    return 11;
}

fn after_short_rep(s: usize) usize {
    if s < 7 {
        return 9;
    }
    return 11;
}

// Decodes LZMA data onto out until `want` more bytes have come (or, with
// eopm, an end marker). Matches reach back no further than dict_start.
// Returns whether an end marker was seen.
fn lzma_decode(m: *mut Model, rc: *mut Rc, out: *mut strs.String, dict_start: usize, want: u64, eopm: bool,
               max_size: usize) XzError!bool {
    let goal = @as(u64, out.len) + want;
    let pb_mask = (@as(usize, 1) << @truncate(u32, m.pb)) - 1;
    let lp_mask = (@as(usize, 1) << @truncate(u32, m.lp)) - 1;
    while @as(u64, out.len) < goal {
        if rc.over {
            return error.Corrupt;
        }
        let pos = out.len - dict_start;
        let ps = pos & pb_mask;
        let st = m.state;
        if rc.bit(&mut m.is_match[(st << 4) + ps]) == 0 {
            // a literal
            let mut prev: u32 = 0;
            if out.len > dict_start {
                prev = @as(u32, out.buf[out.len - 1]);
            }
            let base = 0x300 * (
                ((pos & lp_mask) << @truncate(u32, m.lc)) + @as(usize, prev >> @truncate(u32, 8 - m.lc)));
            let probs = m.literal[base..base + 0x300];
            let mut sym: u32 = 1;
            if st >= 7 {
                let back = @as(usize, m.reps[0]) + 1;
                if back > (out.len - dict_start) {
                    return error.Corrupt;
                }
                let mut mb = @as(u32, out.buf[out.len - back]);
                while sym < 0x100 {
                    let mbit = (mb >> 7) & 1;
                    mb <<= 1;
                    let b = rc.bit(&mut probs[@as(usize, ((1 + mbit) << 8) + sym)]);
                    sym = (sym << 1) | b;
                    if mbit != b {
                        break;
                    }
                }
            }
            while sym < 0x100 {
                sym = (sym << 1) | rc.bit(&mut probs[@as(usize, sym)]);
            }
            if out.len >= max_size {
                return error.TooLarge;
            }
            out.push(@truncate(u8, sym))!;
            m.state = after_literal(st);
            continue;
        }
        let mut len: usize = 0;
        if rc.bit(&mut m.is_rep[st]) != 0 {
            if (out.len - dict_start) == 0 {
                return error.Corrupt;
            }
            if rc.bit(&mut m.is_rep_g0[st]) == 0 {
                if rc.bit(&mut m.is_rep0_long[(st << 4) + ps]) == 0 {
                    // a short rep: one byte from rep0
                    m.state = after_short_rep(st);
                    let back = @as(usize, m.reps[0]) + 1;
                    if back > (out.len - dict_start) {
                        return error.Corrupt;
                    }
                    if out.len >= max_size {
                        return error.TooLarge;
                    }
                    out.push(out.buf[out.len - back])!;
                    continue;
                }
            } else {
                let mut d: u32 = 0;
                if rc.bit(&mut m.is_rep_g1[st]) == 0 {
                    d = m.reps[1];
                } else {
                    if rc.bit(&mut m.is_rep_g2[st]) == 0 {
                        d = m.reps[2];
                    } else {
                        d = m.reps[3];
                        m.reps[3] = m.reps[2];
                    }
                    m.reps[2] = m.reps[1];
                }
                m.reps[1] = m.reps[0];
                m.reps[0] = d;
            }
            len = @as(usize, m.rep_len.decode(rc, ps)) + MATCH_MIN;
            m.state = after_rep(st);
        } else {
            m.reps[3] = m.reps[2];
            m.reps[2] = m.reps[1];
            m.reps[1] = m.reps[0];
            len = @as(usize, m.len.decode(rc, ps)) + MATCH_MIN;
            m.state = after_match(st);
            // the distance
            let ls = @min(len - MATCH_MIN, 3);
            let slot = rc.tree(m.pos_slot[ls * 64..(ls * 64) + 64], 6);
            let mut dist: u32 = slot;
            if slot >= 4 {
                let nd = (slot >> 1) - 1;
                dist = (2 | (slot & 1)) << nd;
                if slot < 14 {
                    let base = @as(usize, dist - slot);
                    dist += rc.reverse(m.pos_special[base..base + (@as(usize, 1) << @truncate(u32, nd))], nd);
                } else {
                    dist += rc.direct(nd - 4) << 4;
                    dist += rc.reverse(m.align[..], 4);
                }
            }
            if dist == 0xffffffff {
                if eopm {
                    return true;
                }
                return error.Corrupt;
            }
            m.reps[0] = dist;
        }
        let back = @as(usize, m.reps[0]) + 1;
        if back > (out.len - dict_start) {
            return error.Corrupt;
        }
        let n = @truncate(usize, @min(@as(u64, len), goal - @as(u64, out.len)));
        if (out.len + n) > max_size {
            return error.TooLarge;
        }
        out.reserve(n)!;
        let b = out.buf;
        let mut at = out.len;
        for _k in @as(usize, 0)..n {
            b[at] = b[at - back];
            at += 1;
        }
        out.len = at;
        if n < len {
            return error.Corrupt;  // a match past the end of the data
        }
    }
    return false;
}

// -----------------------------------------------------------------------------
// LZMA2
// -----------------------------------------------------------------------------

// Decodes LZMA2 data onto out; returns how many input bytes it took.
fn lzma2_decode(src: []u8, out: *mut strs.String, max_size: usize) XzError!usize {
    let mut m = new_model();
    defer m.deinit();
    let mut dict_start = out.len;
    let mut i: usize = 0;
    let mut need_dict = true;
    let mut need_props = true;
    let mut need_state = true;
    loop {
        if i >= src.len {
            return error.Corrupt;
        }
        let c = src[i];
        i += 1;
        if c == 0 {
            return i;
        }
        if (c == 1) or (c == 2) {
            if (src.len - i) < 2 {
                return error.Corrupt;
            }
            let n = ((@as(usize, src[i]) << 8) | @as(usize, src[i + 1])) + 1;
            i += 2;
            if c == 1 {
                dict_start = out.len;
                need_dict = false;
            } else if need_dict {
                return error.Corrupt;
            }
            if (src.len - i) < n {
                return error.Corrupt;
            }
            if (out.len + n) > max_size {
                return error.TooLarge;
            }
            out.push_str(src[i..i + n])!;
            i += n;
            need_state = true;  // (an LZMA chunk must reset the state next)
            continue;
        }
        if c < 0x80 {
            return error.Corrupt;
        }
        if (src.len - i) < 4 {
            return error.Corrupt;
        }
        let unpacked = ((@as(usize, c & 0x1f) << 16) | (@as(usize, src[i]) << 8) | @as(usize, src[i + 1])) + 1;
        let packed = ((@as(usize, src[i + 2]) << 8) | @as(usize, src[i + 3])) + 1;
        i += 4;
        let reset = (c >> 5) & 3;
        if reset == 3 {
            dict_start = out.len;
            need_dict = false;
        } else if need_dict {
            return error.Corrupt;
        }
        if reset >= 2 {
            if i >= src.len {
                return error.Corrupt;
            }
            let p = @as(u32, src[i]);
            i += 1;
            if p >= (9 * 5 * 5) {
                return error.Corrupt;
            }
            let lc = p % 9;
            let lp = (p / 9) % 5;
            let pb = p / 45;
            if (lc + lp) > 4 {
                return error.Corrupt;
            }
            m.set_props(lc, lp, pb)!;
            need_props = false;
        } else if need_props {
            return error.Corrupt;
        } else if reset == 1 {
            m.reset();
        } else if need_state {
            return error.Corrupt;
        }
        need_state = false;
        if (src.len - i) < packed {
            return error.Corrupt;
        }
        let mut rc = Rc.init(src[i..i + packed])!;
        _ = lzma_decode(&mut m, &mut rc, out, dict_start, @as(u64, unpacked), false, max_size)!;
        if rc.over or (rc.i != packed) or (rc.code != 0) {
            return error.Corrupt;
        }
        i += packed;
    }
}

/// Decodes a raw LZMA2 stream (as other formats embed it); the caller frees
/// the result.
pub fn decompress_lzma2(src: []u8, max_size: usize) XzError![]mut u8 {
    let mut out = strs.String.init();
    _ = lzma2_decode(src, &mut out, max_size) catch |e| {
        out.deinit();
        return e;
    };
    return out.take();
}

/// Decompresses the legacy .lzma format; the caller frees the result.
pub fn decompress_lzma(src: []u8, max_size: usize) XzError![]mut u8 {
    if src.len < 13 {
        return error.Corrupt;
    }
    let p = @as(u32, src[0]);
    if p >= (9 * 5 * 5) {
        return error.Corrupt;
    }
    let size = binary.u64_le(src[5..]);
    let known = size != 0xffffffffffffffff;
    if known and (size > @as(u64, max_size)) {
        return error.TooLarge;
    }
    let mut m = new_model();
    defer m.deinit();
    m.set_props(p % 9, (p / 9) % 5, p / 45)!;
    let mut out = strs.String.init();
    let mut rc = Rc.init(src[13..]) catch |e| {
        out.deinit();
        return e;
    };
    let mut want: u64 = 0xffffffffffffffff;
    if known {
        want = size;
    } else {
        want = @as(u64, max_size) + 1;
    }
    let ended = lzma_decode(&mut m, &mut rc, &mut out, 0, want, true, max_size) catch |e| {
        out.deinit();
        return e;
    };
    if (not known and not ended) or rc.over {
        out.deinit();
        return error.Corrupt;
    }
    return out.take();
}

// -----------------------------------------------------------------------------
// Filters (applied to a block's decoded bytes)
// -----------------------------------------------------------------------------

const F_DELTA: u64 = 0x03;
const F_X86: u64 = 0x04;
const F_PPC: u64 = 0x05;
const F_IA64: u64 = 0x06;
const F_ARM: u64 = 0x07;
const F_ARMTHUMB: u64 = 0x08;
const F_SPARC: u64 = 0x09;
const F_ARM64: u64 = 0x0a;
const F_LZMA2: u64 = 0x21;

fn delta_decode(b: []mut u8, dist: usize) void {
    for i in dist..b.len {
        b[i] = b[i] +% b[i - dist];
    }
}

// The x86 branch converter (decoding): E8/E9 call and jump targets back to
// relative addresses.
fn x86_decode(b: []mut u8, start: u32) void {
    let mask_to_allowed: [8]bool = [true, true, true, false, true, false, false, false];
    let mask_to_bit: [8]u32 = [0, 1, 2, 2, 3, 3, 3, 3];
    if b.len < 5 {
        return;
    }
    let mut prev_pos: usize = 0;
    let mut prev_mask: u32 = 0;
    let mut i: usize = 0;
    let limit = b.len - 5;
    let mut have_prev = false;
    while i <= limit {
        let op = b[i];
        if (op != 0xe8) and (op != 0xe9) {
            i += 1;
            continue;
        }
        let gap = i - prev_pos;
        if not have_prev or (gap > 3) {
            prev_mask = 0;
        } else {
            prev_mask = (prev_mask << @truncate(u32, gap - 1)) & 7;
            if prev_mask != 0 {
                let t = b[i + 4 - @as(usize, mask_to_bit[@as(usize, prev_mask)])];
                if not mask_to_allowed[@as(usize, prev_mask)] or (t == 0) or (t == 0xff) {
                    prev_pos = i;
                    have_prev = true;
                    prev_mask = (prev_mask << 1) | 1;
                    i += 1;
                    continue;
                }
            }
        }
        prev_pos = i;
        have_prev = true;
        let b4 = b[i + 4];
        if (b4 == 0) or (b4 == 0xff) {
            let mut src = binary.u32_le(b[i + 1..]);
            let now = start +% @truncate(u32, i + 5);
            let mut dest: u32 = 0;
            loop {
                dest = src -% now;
                if prev_mask == 0 {
                    break;
                }
                let k = mask_to_bit[@as(usize, prev_mask)] * 8;
                let t = @truncate(u8, dest >> (24 - k));
                if (t != 0) and (t != 0xff) {
                    break;
                }
                src = dest ^ ((@as(u32, 1) << (32 - k)) - 1);
            }
            dest &= 0x01ffffff;
            if (dest & 0x01000000) != 0 {
                dest |= 0xff000000;
            }
            b[i + 1] = @truncate(u8, dest);
            b[i + 2] = @truncate(u8, dest >> 8);
            b[i + 3] = @truncate(u8, dest >> 16);
            b[i + 4] = @truncate(u8, dest >> 24);
            i += 5;
            prev_mask = 0;
        } else {
            i += 1;
            prev_mask |= 1;
            if (b4 == 0) or (b4 == 0xff) {
                prev_mask |= 0x10;
            }
        }
    }
}

fn arm_decode(b: []mut u8, start: u32) void {
    let mut i: usize = 0;
    while (i + 4) <= b.len {
        if b[i + 3] == 0xeb {
            let src = (@as(u32, b[i + 2]) << 16) | (@as(u32, b[i + 1]) << 8) | @as(u32, b[i]);
            let dest = ((src << 2) -% (start +% @truncate(u32, i + 8))) >> 2;
            b[i] = @truncate(u8, dest);
            b[i + 1] = @truncate(u8, dest >> 8);
            b[i + 2] = @truncate(u8, dest >> 16);
        }
        i += 4;
    }
}

fn armthumb_decode(b: []mut u8, start: u32) void {
    let mut i: usize = 0;
    while (i + 4) <= b.len {
        if ((b[i + 1] & 0xf8) == 0xf0) and ((b[i + 3] & 0xf8) == 0xf8) {
            let src = ((@as(u32, b[i + 1]) & 7) << 19) | (@as(u32, b[i]) << 11) | (
                (@as(u32, b[i + 3]) & 7) << 8) | @as(u32, b[i + 2]);
            let dest = ((src << 1) -% (start +% @truncate(u32, i + 4))) >> 1;
            b[i + 1] = @truncate(u8, 0xf0 | ((dest >> 19) & 7));
            b[i] = @truncate(u8, dest >> 11);
            b[i + 3] = @truncate(u8, 0xf8 | ((dest >> 8) & 7));
            b[i + 2] = @truncate(u8, dest);
            i += 2;
        }
        i += 2;
    }
}

fn arm64_decode(b: []mut u8, start: u32) void {
    let mut i: usize = 0;
    while (i + 4) <= b.len {
        let pc = start +% @truncate(u32, i);
        let mut ins = binary.u32_le(b[i..]);
        if (ins >> 26) == 0x25 {
            // BL
            let src = ins;
            ins = 0x94000000 | (((src & 0x03ffffff) -% (pc >> 2)) & 0x03ffffff);
            binary.put_u32_le(b[i..], ins);
        } else if (ins & 0x9f000000) == 0x90000000 {
            // ADRP
            let src = ((ins >> 29) & 3) | ((ins >> 3) & 0x001ffffc);
            if ((src +% 0x00020000) & 0x001c0000) == 0 {
                let dest = src -% (pc >> 12);
                ins &= 0x9000001f;
                ins |= (dest & 3) << 29;
                ins |= (dest & 0x0003fffc) << 3;
                ins |= (0 -% (dest & 0x00020000)) & 0x00e00000;
                binary.put_u32_le(b[i..], ins);
            }
        }
        i += 4;
    }
}

fn ppc_decode(b: []mut u8, start: u32) void {
    let mut i: usize = 0;
    while (i + 4) <= b.len {
        if ((b[i] >> 2) == 0x12) and ((b[i + 3] & 3) == 1) {
            let src = ((@as(u32, b[i]) & 3) << 24) | (@as(u32, b[i + 1]) << 16) | (@as(u32, b[i + 2]) << 8) | (
                @as(u32, b[i + 3]) & 0xfc);
            let dest = src -% (start +% @truncate(u32, i));
            b[i] = @truncate(u8, 0x48 | ((dest >> 24) & 3));
            b[i + 1] = @truncate(u8, dest >> 16);
            b[i + 2] = @truncate(u8, dest >> 8);
            b[i + 3] = (b[i + 3] & 3) | @truncate(u8, dest & 0xfc);
        }
        i += 4;
    }
}

fn sparc_decode(b: []mut u8, start: u32) void {
    let mut i: usize = 0;
    while (i + 4) <= b.len {
        if ((b[i] == 0x40) and ((b[i + 1] & 0xc0) == 0)) or ((b[i] == 0x7f) and ((b[i + 1] & 0xc0) == 0xc0)) {
            let mut src = (@as(u32, b[i]) << 24) | (@as(u32, b[i + 1]) << 16) | (@as(u32, b[i + 2]) << 8) | @as(
                u32, b[i + 3]);
            src <<= 2;
            let mut dest = src -% (start +% @truncate(u32, i));
            dest >>= 2;
            dest = (((0 -% ((dest >> 22) & 1)) << 22) & 0x3fffffff) | (dest & 0x3fffff) | 0x40000000;
            b[i] = @truncate(u8, dest >> 24);
            b[i + 1] = @truncate(u8, dest >> 16);
            b[i + 2] = @truncate(u8, dest >> 8);
            b[i + 3] = @truncate(u8, dest);
        }
        i += 4;
    }
}

// -----------------------------------------------------------------------------
// The .xz container
// -----------------------------------------------------------------------------

let HEADER_MAGIC: []u8 = "\xfd7zXZ\x00";

// The size of the check with ID `check` in a stream header.
fn check_size(check: u8) XzError!usize {
    if check <= 15 {
        let sizes: [16]usize = [0, 4, 4, 4, 8, 8, 8, 16, 16, 16, 32, 32, 32, 64, 64, 64];
        return sizes[@as(usize, check)];  // (unknown kinds: skipped, not checked)
    }
    return error.Corrupt;
}

// A variable-length integer (7 bits a byte, at most 9 bytes).
fn varint(b: []u8, at: *mut usize, end: usize) XzError!u64 {
    let mut v: u64 = 0;
    let mut shift: u64 = 0;
    loop {
        if (at.* >= end) or (shift > 56) {
            return error.Corrupt;
        }
        let c = b[at.*];
        at.* += 1;
        v |= @as(u64, c & 0x7f) << shift;
        if (c & 0x80) == 0 {
            if (c == 0) and (shift > 0) {
                return error.Corrupt;  // (not the shortest form)
            }
            return v;
        }
        shift += 7;
    }
}

struct Filter {
    id: u64,
    props: []u8,
}

struct Record {
    unpadded: u64,
    size: u64,
}

/// Decompresses .xz data (one or more streams); the caller frees the result.
pub fn decompress(data: []u8, max_size: usize) XzError![]mut u8 {
    let mut out = strs.String.init();
    decode_streams(data, &mut out, max_size) catch |e| {
        out.deinit();
        return e;
    };
    return out.take();
}

fn decode_streams(d: []u8, out: *mut strs.String, max_size: usize) XzError!void {
    let mut i: usize = 0;
    let mut streams: usize = 0;
    while i < d.len {
        // stream padding: zeros in groups of four
        if (streams > 0) and (d[i] == 0) {
            if ((d.len - i) < 4) or (binary.u32_le(d[i..]) != 0) {
                return error.Corrupt;
            }
            i += 4;
            continue;
        }
        i = stream(d, i, out, max_size)!;
        streams += 1;
    }
    if streams == 0 {
        return error.Corrupt;
    }
}

fn stream(d: []u8, at: usize, out: *mut strs.String, max_size: usize) XzError!usize {
    if ((d.len - at) < 24) or not strs.eq(d[at..at + 6], HEADER_MAGIC) {
        return error.Corrupt;
    }
    if deflate.crc32(0, d[at + 6..at + 8]) != binary.u32_le(d[at + 8..]) {
        return error.ChecksumMismatch;
    }
    if (d[at + 6] != 0) or (d[at + 7] > 15) {
        return error.Unsupported;
    }
    let check = d[at + 7];
    let csize = check_size(check)!;
    let mut i = at + 12;
    let mut records = vec.Vec.[Record].init();
    defer records.deinit();
    loop {
        if i >= d.len {
            return error.Corrupt;
        }
        if d[i] == 0 {
            break;  // the index
        }
        let before = out.len;
        let mut unpadded: u64 = 0;
        i = block(d, i, check, csize, out, max_size, &mut unpadded)!;
        records.push(Record.{ unpadded: unpadded, size: @as(u64, out.len - before) })!;
    }
    // the index: it must list exactly the blocks read
    let ix = i;
    i += 1;
    let n = varint(d, &mut i, d.len)!;
    if n != @as(u64, records.len) {
        return error.Corrupt;
    }
    for r in records.items() {
        let unpadded = varint(d, &mut i, d.len)!;
        let size = varint(d, &mut i, d.len)!;
        if (unpadded != r.unpadded) or (size != r.size) {
            return error.Corrupt;
        }
    }
    while ((i - ix) % 4) != 0 {
        if (i >= d.len) or (d[i] != 0) {
            return error.Corrupt;
        }
        i += 1;
    }
    if ((d.len - i) < 4) or (deflate.crc32(0, d[ix..i]) != binary.u32_le(d[i..])) {
        return error.ChecksumMismatch;
    }
    i += 4;
    // the footer
    if (d.len - i) < 12 {
        return error.Corrupt;
    }
    if deflate.crc32(0, d[i + 4..i + 10]) != binary.u32_le(d[i..]) {
        return error.ChecksumMismatch;
    }
    let backward = (@as(u64, binary.u32_le(d[i + 4..])) + 1) * 4;
    if (backward != @as(u64, i - ix)) or (d[i + 8] != 0) or (d[i + 9] != check) or (d[i + 10] != 'Y') or
       (d[i + 11] != 'Z') {
        return error.Corrupt;
    }
    return i + 12;
}

fn block(d: []u8, at: usize, check: u8, csize: usize, out: *mut strs.String, max_size: usize,
         unpadded: *mut u64) XzError!usize {
    let hsize = (@as(usize, d[at]) + 1) * 4;
    if (d.len - at) < hsize {
        return error.Corrupt;
    }
    if deflate.crc32(0, d[at..at + hsize - 4]) != binary.u32_le(d[at + hsize - 4..]) {
        return error.ChecksumMismatch;
    }
    let flags = d[at + 1];
    if (flags & 0x3c) != 0 {
        return error.Unsupported;
    }
    let nfilters = @as(usize, flags & 3) + 1;
    let hend = at + hsize - 4;
    let mut i = at + 2;
    let mut comp_size: u64 = 0xffffffffffffffff;
    let mut size: u64 = 0xffffffffffffffff;
    if (flags & 0x40) != 0 {
        comp_size = varint(d, &mut i, hend)!;
    }
    if (flags & 0x80) != 0 {
        size = varint(d, &mut i, hend)!;
    }
    let mut filters: [4]Filter = [Filter.{ id: 0, props: "" }; 4];
    for k in @as(usize, 0)..nfilters {
        let id = varint(d, &mut i, hend)!;
        let np = varint(d, &mut i, hend)!;
        if np > @as(u64, hend - i) {
            return error.Corrupt;
        }
        filters[k] = Filter.{ id: id, props: d[i..i + @truncate(usize, np)] };
        i += @truncate(usize, np);
    }
    while i < hend {
        if d[i] != 0 {
            return error.Corrupt;
        }
        i += 1;
    }
    let last = filters[nfilters - 1];
    if (last.id != F_LZMA2) or (last.props.len != 1) or (last.props[0] > 40) {
        return error.Unsupported;
    }
    let start = out.len;
    let data_at = at + hsize;
    let used = lzma2_decode(d[data_at..], out, max_size)!;
    unpadded.* = @as(u64, hsize + used + csize);
    if (comp_size != 0xffffffffffffffff) and (comp_size != @as(u64, used)) {
        return error.Corrupt;
    }
    if (size != 0xffffffffffffffff) and (size != @as(u64, out.len - start)) {
        return error.Corrupt;
    }
    // the other filters, last to first
    let mut k = nfilters - 1;
    while k > 0 {
        k -= 1;
        let f = filters[k];
        let buf = out.buf[start..out.len];
        let mut offset: u32 = 0;
        if (f.id != F_DELTA) and (f.props.len == 4) {
            offset = binary.u32_le(f.props[0..]);
        } else if (f.id != F_DELTA) and (f.props.len != 0) {
            return error.Corrupt;
        }
        if f.id == F_DELTA {
            if f.props.len != 1 {
                return error.Corrupt;
            }
            delta_decode(buf, @as(usize, f.props[0]) + 1);
        } else if f.id == F_X86 {
            x86_decode(buf, offset);
        } else if f.id == F_ARM {
            arm_decode(buf, offset);
        } else if f.id == F_ARMTHUMB {
            armthumb_decode(buf, offset);
        } else if f.id == F_ARM64 {
            arm64_decode(buf, offset);
        } else if f.id == F_PPC {
            ppc_decode(buf, offset);
        } else if f.id == F_SPARC {
            sparc_decode(buf, offset);
        } else {
            return error.Unsupported;
        }
    }
    // padding, then the check
    let mut e = data_at + used;
    while ((e - data_at) % 4) != 0 {
        if (e >= d.len) or (d[e] != 0) {
            return error.Corrupt;
        }
        e += 1;
    }
    if (d.len - e) < csize {
        return error.Corrupt;
    }
    let body = out.buf[start..out.len];
    if check == @int_from_enum(Check.CRC32) {
        if deflate.crc32(0, body) != binary.u32_le(d[e..]) {
            return error.ChecksumMismatch;
        }
    } else if check == @int_from_enum(Check.CRC64) {
        if crc64(0, body) != binary.u64_le(d[e..]) {
            return error.ChecksumMismatch;
        }
    } else if check == @int_from_enum(Check.SHA256) {
        let mut h: [32]u8 = [0; 32];
        sha2.sha256(body, h[..]);
        if not strs.eq(h[..], d[e..e + 32]) {
            return error.ChecksumMismatch;
        }
    }
    return e + csize;
}

// -----------------------------------------------------------------------------
// The range encoder and the LZMA encoder
// -----------------------------------------------------------------------------

struct Re {
    out: strs.String,
    low: u64,
    range: u32,
    cache: u8,
    cache_size: u64,

    fn init() Re {
        return Re.{ out: strs.String.init(), low: 0, range: 0xffffffff, cache: 0, cache_size: 1 };
    }

    fn restart(self: *mut Re) void {
        self.out.clear();
        self.low = 0;
        self.range = 0xffffffff;
        self.cache = 0;
        self.cache_size = 1;
    }

    fn shift_low(self: *mut Re) XzError!void {
        if ((self.low & 0xffffffff) < 0xff000000) or ((self.low >> 32) != 0) {
            let carry = @truncate(u8, self.low >> 32);
            let mut temp = self.cache;
            loop {
                self.out.push(temp +% carry)!;
                temp = 0xff;
                self.cache_size -= 1;
                if self.cache_size == 0 {
                    break;
                }
            }
            self.cache = @truncate(u8, self.low >> 24);
        }
        self.cache_size += 1;
        self.low = (self.low & 0x00ffffff) << 8;
    }

    fn bit(self: *mut Re, p: *mut u16, b: u32) XzError!void {
        let bound = (self.range >> 11) * @as(u32, p.*);
        if b == 0 {
            self.range = bound;
            p.* += (2048 - p.*) >> 5;
        } else {
            self.low += @as(u64, bound);
            self.range -= bound;
            p.* -= p.* >> 5;
        }
        while self.range < 0x1000000 {
            self.range <<= 8;
            self.shift_low()!;
        }
    }

    fn direct(self: *mut Re, v: u32, n: u32) XzError!void {
        let mut k = n;
        while k > 0 {
            k -= 1;
            self.range >>= 1;
            if ((v >> k) & 1) != 0 {
                self.low += @as(u64, self.range);
            }
            while self.range < 0x1000000 {
                self.range <<= 8;
                self.shift_low()!;
            }
        }
    }

    fn tree(self: *mut Re, probs: []mut u16, bits: u32, v: u32) XzError!void {
        let mut m: u32 = 1;
        let mut k = bits;
        while k > 0 {
            k -= 1;
            let b = (v >> k) & 1;
            self.bit(&mut probs[@as(usize, m)], b)!;
            m = (m << 1) | b;
        }
    }

    fn reverse(self: *mut Re, probs: []mut u16, bits: u32, v: u32) XzError!void {
        let mut m: u32 = 1;
        for k in @as(u32, 0)..bits {
            let b = (v >> k) & 1;
            self.bit(&mut probs[@as(usize, m)], b)!;
            m = (m << 1) | b;
        }
    }

    fn flush(self: *mut Re) XzError!void {
        for _k in @as(usize, 0)..5 {
            self.shift_low()!;
        }
    }

    // The bytes flushing would leave.
    fn pending(self: *Re) usize {
        return self.out.len + @truncate(usize, self.cache_size) + 4;
    }
}

fn enc_len(re: *mut Re, lc: *mut LenCoder, v: u32, ps: usize) XzError!void {
    if v < 8 {
        re.bit(&mut lc.choice, 0)!;
        re.tree(lc.low[ps * 8..(ps * 8) + 8], 3, v)!;
    } else if v < 16 {
        re.bit(&mut lc.choice, 1)!;
        re.bit(&mut lc.choice2, 0)!;
        re.tree(lc.mid[ps * 8..(ps * 8) + 8], 3, v - 8)!;
    } else {
        re.bit(&mut lc.choice, 1)!;
        re.bit(&mut lc.choice2, 1)!;
        re.tree(lc.high[..], 8, v - 16)!;
    }
}

fn dist_slot(d: u32) u32 {
    if d < 4 {
        return d;
    }
    let bits = 31 - @truncate(u32, @clz(d));
    return (bits * 2) + ((d >> (bits - 1)) & 1);
}

const MATCH_MAX: usize = 273;
const HASH_SIZE: usize = 1 << 18;

// Encodes data[from..to] as LZMA symbols (earlier bytes serve as the
// dictionary), calling close when a chunk fills.
struct Encoder {
    m: Model,
    re: Re,
    data: []u8,
    head: []mut u32,
    chain: []mut u32,
    depth: u32,
    nice: usize,
    dict: usize,

    fn deinit(self: *mut Encoder) void {
        self.m.deinit();
        self.re.out.deinit();
        mem.free(self.head);
        mem.free(self.chain);
    }

    fn hash3(self: *Encoder, i: usize) usize {
        let d = self.data;
        let v = (@as(u32, d[i]) << 16) | (@as(u32, d[i + 1]) << 8) | @as(u32, d[i + 2]);
        return @as(usize, (v *% 2654435761) >> 14) & (HASH_SIZE - 1);
    }

    fn insert(self: *mut Encoder, i: usize) void {
        if (i + 3) > self.data.len {
            return;
        }
        let h = self.hash3(i);
        self.chain[i] = self.head[h];
        self.head[h] = @truncate(u32, i);
    }

    fn match_len(self: *Encoder, i: usize, back: usize, limit: usize) usize {
        let d = self.data;
        let mut l: usize = 0;
        while (l < limit) and (d[i + l] == d[i + l - back]) {
            l += 1;
        }
        return l;
    }

    // The longest match at i (length into len, distance - 1 returned).
    fn find(self: *Encoder, i: usize, len: *mut usize) u32 {
        len.* = 0;
        if (i + 3) > self.data.len {
            return 0;
        }
        let limit = @min(MATCH_MAX, self.data.len - i);
        let mut best: usize = 0;
        let mut best_d: usize = 0;
        let mut c = self.head[self.hash3(i)];
        let mut tries = self.depth;
        while (c != 0xffffffff) and (tries > 0) {
            let back = i - @as(usize, c);
            if back > self.dict {
                break;
            }
            if best >= limit {
                break;
            }
            if (self.data[@as(usize, c) + best] == self.data[i + best]) or (best == 0) {
                let l = self.match_len(i, back, limit);
                if l > best {
                    best = l;
                    best_d = back;
                    if l >= self.nice {
                        break;
                    }
                }
            }
            c = self.chain[@as(usize, c)];
            tries -= 1;
        }
        len.* = best;
        if best < 2 {
            len.* = 0;
            return 0;
        }
        return @truncate(u32, best_d - 1);
    }

    fn literal(self: *mut Encoder, i: usize, start: usize) XzError!void {
        let m = &mut self.m;
        let pos = i - start;
        let ps = pos & ((@as(usize, 1) << @truncate(u32, m.pb)) - 1);
        let st = m.state;
        self.re.bit(&mut m.is_match[(st << 4) + ps], 0)!;
        let mut prev: u32 = 0;
        if i > start {
            prev = @as(u32, self.data[i - 1]);
        }
        let base = 0x300 * (
            ((pos & ((@as(usize, 1) << @truncate(u32, m.lp)) - 1)) << @truncate(u32, m.lc)) + @as(
                usize, prev >> @truncate(u32, 8 - m.lc)));
        let probs = m.literal[base..base + 0x300];
        let byte = @as(u32, self.data[i]);
        let mut sym: u32 = 1;
        let mut k: u32 = 8;
        if st >= 7 {
            let mb = @as(u32, self.data[i - @as(usize, m.reps[0]) - 1]);
            while k > 0 {
                k -= 1;
                let b = (byte >> k) & 1;
                let mbit = (mb >> k) & 1;
                self.re.bit(&mut probs[@as(usize, ((1 + mbit) << 8) + sym)], b)!;
                sym = (sym << 1) | b;
                if mbit != b {
                    break;
                }
            }
        }
        while k > 0 {
            k -= 1;
            let b = (byte >> k) & 1;
            self.re.bit(&mut probs[@as(usize, sym)], b)!;
            sym = (sym << 1) | b;
        }
        m.state = after_literal(st);
    }

    fn rep(self: *mut Encoder, i: usize, start: usize, k: usize, len: usize) XzError!void {
        let m = &mut self.m;
        let ps = (i - start) & ((@as(usize, 1) << @truncate(u32, m.pb)) - 1);
        let st = m.state;
        self.re.bit(&mut m.is_match[(st << 4) + ps], 1)!;
        self.re.bit(&mut m.is_rep[st], 1)!;
        if k == 0 {
            self.re.bit(&mut m.is_rep_g0[st], 0)!;
            self.re.bit(&mut m.is_rep0_long[(st << 4) + ps], 1)!;
        } else {
            self.re.bit(&mut m.is_rep_g0[st], 1)!;
            let d = m.reps[k];
            if k == 1 {
                self.re.bit(&mut m.is_rep_g1[st], 0)!;
            } else {
                self.re.bit(&mut m.is_rep_g1[st], 1)!;
                if k == 2 {
                    self.re.bit(&mut m.is_rep_g2[st], 0)!;
                } else {
                    self.re.bit(&mut m.is_rep_g2[st], 1)!;
                    m.reps[3] = m.reps[2];
                }
                m.reps[2] = m.reps[1];
            }
            m.reps[1] = m.reps[0];
            m.reps[0] = d;
        }
        enc_len(&mut self.re, &mut m.rep_len, @truncate(u32, len - MATCH_MIN), ps)!;
        m.state = after_rep(st);
    }

    fn match_(self: *mut Encoder, i: usize, start: usize, dist: u32, len: usize) XzError!void {
        let m = &mut self.m;
        let ps = (i - start) & ((@as(usize, 1) << @truncate(u32, m.pb)) - 1);
        let st = m.state;
        self.re.bit(&mut m.is_match[(st << 4) + ps], 1)!;
        self.re.bit(&mut m.is_rep[st], 0)!;
        enc_len(&mut self.re, &mut m.len, @truncate(u32, len - MATCH_MIN), ps)!;
        let ls = @min(len - MATCH_MIN, 3);
        let slot = dist_slot(dist);
        self.re.tree(m.pos_slot[ls * 64..(ls * 64) + 64], 6, slot)!;
        if slot >= 4 {
            let nd = (slot >> 1) - 1;
            let base = (2 | (slot & 1)) << nd;
            let reduced = dist - base;
            if slot < 14 {
                let b = @as(usize, base - slot);
                self.re.reverse(m.pos_special[b..b + (@as(usize, 1) << @truncate(u32, nd))], nd, reduced)!;
            } else {
                self.re.direct(reduced >> 4, nd - 4)!;
                self.re.reverse(m.align[..], 4, reduced & 15)!;
            }
        }
        m.reps[3] = m.reps[2];
        m.reps[2] = m.reps[1];
        m.reps[1] = m.reps[0];
        m.reps[0] = dist;
        m.state = after_match(st);
    }

    // The longest repeat-distance match at i: its index into k.
    fn best_rep(self: *Encoder, i: usize, start: usize, k: *mut usize) usize {
        let limit = @min(MATCH_MAX, self.data.len - i);
        let mut best: usize = 0;
        for r in @as(usize, 0)..4 {
            let back = @as(usize, self.m.reps[r]) + 1;
            if back > (i - start) {
                continue;
            }
            let l = self.match_len(i, back, limit);
            if l > best {
                best = l;
                k.* = r;
            }
        }
        return best;
    }
}

pub struct Options {
    level: u32,    // 1 (fastest) to 9 (smallest)
    check: Check,  // CRC64 by default

    pub fn default() Options {
        return Options.{ level: 6, check: Check.CRC64 };
    }
}

// The dictionary size for a level.
fn level_dict(level: u32) usize {
    let dicts: [10]usize = [0, 1 << 20, 2 << 20, 4 << 20, 4 << 20, 8 << 20, 8 << 20, 16 << 20, 32 << 20, 64 << 20];
    return dicts[@as(usize, @max(@min(level, 9), 1))];
}

fn new_encoder(data: []u8, level: u32) XzError!Encoder {
    let lv = @max(@min(level, 9), 1);
    let depths: [10]u32 = [0, 4, 8, 16, 24, 32, 48, 96, 192, 384];
    let mut e = Encoder.{ m: new_model(), re: Re.init(), data: data, head: mem.alloc.[u32](HASH_SIZE)!,
                          chain: @slice_from_ptr(@ptr_from_int(*mut u32, 4), 0), depth: depths[@as(usize, lv)],
                          nice: 32 + (@as(usize, lv) * 24), dict: level_dict(lv) };
    @mem_set(@cast_slice(u8, e.head), 0xff);
    e.chain = mem.alloc.[u32](@max(data.len, 1)) catch |err| {
        mem.free(e.head);
        return err;
    };
    e.m.set_props(3, 0, 2) catch |err| {
        e.deinit();
        return err;
    };
    return e;
}

// The LZMA2 dictionary-size byte for at least n bytes.
fn dict_byte(n: usize) u8 {
    let mut c: u32 = 0;
    while c < 40 {
        let size = @as(u64, 2 | (c & 1)) << @as(u64, (c / 2) + 11);
        if size >= @as(u64, n) {
            return @truncate(u8, c);
        }
        c += 1;
    }
    return 40;
}

// Chooses the next symbol at i and encodes it: returns how many bytes it
// covers.
fn step(e: *mut Encoder, i: usize, start: usize) XzError!usize {
    let mut rk: usize = 0;
    let rlen = e.best_rep(i, start, &mut rk);
    let mut mlen: usize = 0;
    let dist = e.find(i, &mut mlen);
    if (rlen >= 2) and ((rlen + 1) >= mlen) {
        e.rep(i, start, rk, rlen)!;
        return rlen;
    }
    if (mlen >= 3) or ((mlen == 2) and (dist < 128)) {
        // one step of lazy evaluation: a longer match next is worth a literal now
        if (i + 1) < e.data.len {
            let mut next_len: usize = 0;
            e.insert(i);
            let mut rk2: usize = 0;
            let r2 = e.best_rep(i + 1, start, &mut rk2);
            _ = e.find(i + 1, &mut next_len);
            e.head[e.hash3(i)] = e.chain[i];  // (undo: step inserts i itself)
            if (next_len > (mlen + 1)) or (r2 > (mlen + 1)) {
                e.literal(i, start)!;
                return 1;
            }
        }
        e.match_(i, start, dist, mlen)!;
        return mlen;
    }
    e.literal(i, start)!;
    return 1;
}

// The LZMA2 dictionary-size byte compress uses for data at a level.
fn lzma2_dict_byte(data: []u8, level: u32) u8 {
    return dict_byte(@max(@min(level_dict(level), data.len), 4096));
}

// Encodes data as LZMA2 to w, a chunk (at most 64 KiB) at a time, but for
// the end marker (a zero byte) the caller writes; returns how many bytes
// that was.
fn lzma2_encode(data: []u8, level: u32, w: io.Writer) !usize {
    let mut e = new_encoder(data, level)!;
    defer e.deinit();
    let mut ob = strs.String.init();
    defer ob.deinit();
    let out = &mut ob;
    let mut total: usize = 0;
    let mut i: usize = 0;
    let mut first = true;
    let mut need_reset = false;  // after a stored chunk
    while i < data.len {
        let cstart = i;
        e.re.restart();
        if need_reset {
            e.m.reset();
        }
        while (i < data.len) and ((i - cstart) < ((2 << 20) - MATCH_MAX)) and (e.re.pending() < (65536 - 64)) {
            let n = step(&mut e, i, 0)!;
            for k in i..i + n {
                e.insert(k);
            }
            i += n;
        }
        e.re.flush()!;
        let packed = e.re.out.bytes();
        let unpacked = i - cstart;
        if packed.len >= unpacked {
            // stored instead, in pieces of at most 64 KiB
            let mut k = cstart;
            while k < i {
                let n = @min(i - k, 65536);
                if first {
                    out.push(1)!;
                } else {
                    out.push(2)!;
                }
                out.push(@truncate(u8, (n - 1) >> 8))!;
                out.push(@truncate(u8, n - 1))!;
                out.push_str(data[k..k + n])!;
                k += n;
                first = false;
                w.write_all(out.bytes())!;
                total += out.len;
                out.clear();
            }
            need_reset = true;
            continue;
        }
        let mut control: u8 = 0x80;
        if first {
            control = 0xe0;  // dictionary reset, new properties
        } else if need_reset {
            control = 0xc0;  // state reset, with the properties again
        }
        let u = unpacked - 1;
        let p = packed.len - 1;
        out.push(control | @truncate(u8, u >> 16))!;
        out.push(@truncate(u8, u >> 8))!;
        out.push(@truncate(u8, u))!;
        out.push(@truncate(u8, p >> 8))!;
        out.push(@truncate(u8, p))!;
        if control >= 0xc0 {
            out.push(0x5d)!;  // lc 3, lp 0, pb 2
        }
        out.push_str(packed)!;
        first = false;
        need_reset = false;
        w.write_all(out.bytes())!;
        total += out.len;
        out.clear();
    }
    return total;
}

/// Compresses data as an .xz stream; the caller frees the result.
pub fn compress(data: []u8, opts: Options) ![]mut u8 {
    let mut out = strs.String.init();
    compress_to(out.writer(), data, opts) catch |e| {
        out.deinit();
        return e;
    };
    return out.take();
}

fn put32(out: *mut strs.String, v: u32) XzError!void {
    let b: [4]u8 = [@truncate(u8, v), @truncate(u8, v >> 8), @truncate(u8, v >> 16), @truncate(u8, v >> 24)];
    out.push_str(b[..])!;
}

fn put_varint(out: *mut strs.String, v: u64) XzError!void {
    let mut x = v;
    while x >= 0x80 {
        out.push(@truncate(u8, x) | 0x80)!;
        x >>= 7;
    }
    out.push(@truncate(u8, x))!;
}

/// Compresses data as an .xz stream (see compress) and writes it to w as
/// it is produced, an LZMA2 chunk (at most 64 KiB) at a time.
pub fn compress_to(w: io.Writer, data: []u8, o: Options) !void {
    let check = @int_from_enum(o.check);
    let csize = check_size(check)!;
    let mut ob = strs.String.init();
    defer ob.deinit();
    let out = &mut ob;
    // the stream header
    out.push_str(HEADER_MAGIC)!;
    out.push(0)!;
    out.push(check)!;
    put32(out, deflate.crc32(0, out.bytes()[6..8]))!;
    // the block: header, LZMA2 data, padding, check (the header holds no
    // sizes, so the data can follow as it is made)
    let bh = out.len;
    let hdr: [12]u8 = [2, 0, 0x21, 1, lzma2_dict_byte(data, o.level), 0, 0, 0, 0, 0, 0, 0];
    out.push_str(hdr[..8])!;  // size (2 + 1) * 4 = 12: flags, filter, padding
    put32(out, deflate.crc32(0, out.bytes()[bh..bh + 8]))!;
    w.write_all(out.bytes())!;
    out.clear();
    let chunks_len = lzma2_encode(data, o.level, w)!;
    out.push(0)!;  // the LZMA2 end marker
    let unpadded = @as(u64, 12 + chunks_len + 1 + csize);
    while ((12 + chunks_len + out.len) % 4) != 0 {
        out.push(0)!;
    }
    match o.check {
        .NONE => {}
        .CRC32 => { put32(out, deflate.crc32(0, data))!; }
        .CRC64 => {
            let c = crc64(0, data);
            put32(out, @truncate(u32, c))!;
            put32(out, @truncate(u32, c >> 32))!;
        }
        .SHA256 => {
            let mut h: [32]u8 = [0; 32];
            sha2.sha256(data, h[..]);
            out.push_str(h[..])!;
        }
    }
    // the index
    let ix = out.len;
    out.push(0)!;
    put_varint(out, 1)!;
    put_varint(out, unpadded)!;
    put_varint(out, @as(u64, data.len))!;
    while ((out.len - ix) % 4) != 0 {
        out.push(0)!;
    }
    put32(out, deflate.crc32(0, out.bytes()[ix..]))!;
    let index_size = out.len - ix;
    // the footer
    let mut f: [6]u8 = [0; 6];
    let back = @truncate(u32, (index_size / 4) - 1);
    f[0] = @truncate(u8, back);
    f[1] = @truncate(u8, back >> 8);
    f[2] = @truncate(u8, back >> 16);
    f[3] = @truncate(u8, back >> 24);
    f[5] = check;
    put32(out, deflate.crc32(0, f[..]))!;
    out.push_str(f[..])!;
    out.push_str("YZ")!;
    w.write_all(out.bytes())!;
}

/// Compresses data in the legacy .lzma format; the caller frees the result.
pub fn compress_lzma(data: []u8, level: u32) ![]mut u8 {
    let mut out = strs.String.init();
    compress_lzma_to(out.writer(), data, level) catch |err| {
        out.deinit();
        return err;
    };
    return out.take();
}

/// Compresses data in the legacy .lzma format and writes it to w as it is
/// produced, about 64 KiB at a time.
pub fn compress_lzma_to(w: io.Writer, data: []u8, level: u32) !void {
    let mut e = new_encoder(data, level)!;
    defer e.deinit();
    // the header goes first in the range encoder's output (which only appends)
    let out = &mut e.re.out;
    out.push(0x5d)!;
    // (the size in a form xz recognizes: 2^n or 2^n + 2^(n-1))
    let c = @as(u32, dict_byte(@max(@min(e.dict, e.data.len), 4096)));
    put32(out, (2 | (c & 1)) << ((c / 2) + 11))!;
    put32(out, @truncate(u32, e.data.len))!;
    put32(out, @truncate(u32, @as(u64, e.data.len) >> 32))!;
    let mut i: usize = 0;
    while i < e.data.len {
        let n = step(&mut e, i, 0)!;
        for k in i..i + n {
            e.insert(k);
        }
        i += n;
        if e.re.out.len >= 65536 {
            w.write_all(e.re.out.bytes())!;
            e.re.out.clear();
        }
    }
    e.re.flush()!;
    w.write_all(e.re.out.bytes())!;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn fails(r: ![]mut u8) bool {
    let x = r catch return true;
    mem.free(x);
    return false;
}

test "files made by liblzma" {
    let corpus = fs.read_file("std/compress/testdata/corpus.bin") catch return;
    defer mem.free(corpus);
    let mut dir = fs.read_dir("std/compress/xz/testdata")!;
    defer dir.deinit();
    let mut n: usize = 0;
    for e in dir.entries.items() {
        let mut p = strs.String.init();
        defer p.deinit();
        p.push_str("std/compress/xz/testdata/")!;
        p.push_str(e.name)!;
        let data = fs.read_file(p.bytes())!;
        defer mem.free(data);
        let mut got: []mut u8 = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
        if strs.ends_with(e.name, ".lzma") {
            got = decompress_lzma(data, 1 << 24)!;
        } else {
            got = decompress(data, 1 << 24)!;
        }
        defer mem.free(got);
        if strs.starts_with(e.name, "corpus") {
            @expect_eq(got, corpus);
        } else if strs.starts_with(e.name, "short") {
            @expect_eq(got, "Hello, Hello, Hello, world!\n");
        } else {
            @expect_eq(got.len, 0);
        }
        n += 1;
    }
    @expect(n >= 12);
}

test "round trips" {
    let corpus = fs.read_file("std/compress/testdata/corpus.bin") catch return;
    defer mem.free(corpus);
    let mut o = Options.default();
    for level in [@as(u32, 1), 6, 9] {
        o.level = level;
        let c = compress(corpus, o)!;
        defer mem.free(c);
        @expect(c.len < (corpus.len / 2));
        let d = decompress(c, corpus.len)!;
        defer mem.free(d);
        @expect_eq(d, corpus);
    }
    for chk in [Check.NONE, Check.CRC32, Check.SHA256] {
        o.check = chk;
        for input in ["", "a", "aaaaaaaaaaaaaaaaaaaaaaaaaaaa", "abcabcabcabcabcabcabcabxabc"] {
            let c = compress(input, o)!;
            defer mem.free(c);
            let d = decompress(c, 1000)!;
            defer mem.free(d);
            @expect_eq(d, input);
        }
    }
    let l = compress_lzma(corpus, 6)!;
    defer mem.free(l);
    let ld = decompress_lzma(l, corpus.len)!;
    defer mem.free(ld);
    @expect_eq(ld, corpus);
    // random bytes do not compress: stored chunks
    let mut rnd = strs.String.init();
    defer rnd.deinit();
    let mut x: u32 = 12345;
    for _k in @as(usize, 0)..200000 {
        x = (x *% 1103515245) +% 12345;
        rnd.push(@truncate(u8, x >> 16))!;
    }
    let rc = compress(rnd.bytes(), Options.default())!;
    defer mem.free(rc);
    @expect(rc.len < (rnd.len + 200));
    let rd = decompress(rc, rnd.len)!;
    defer mem.free(rd);
    @expect_eq(rd, rnd.bytes());
    // the writer forms give the same bytes, and pass on the writer's errors
    let mut out = strs.String.init();
    defer out.deinit();
    compress_to(out.writer(), rnd.bytes(), Options.default())!;
    @expect_eq(out.bytes(), rc);
    out.clear();
    compress_lzma_to(out.writer(), corpus, 6)!;
    @expect_eq(out.bytes(), l);
    let mut small: [100]u8 = [0; 100];
    let mut bw = io.BufferWriter.init(small[..]);
    compress_to(bw.writer(), rnd.bytes(), Options.default()) catch |e| {
        @expect_eq(e, error.NoSpaceLeft);
        return;
    };
    @trap();
}

test "damaged input" {
    let c = compress("hello hello hello hello hello hello, world", Options.default())!;
    defer mem.free(c);
    for n in @as(usize, 0)..c.len {
        @expect(fails(decompress(c[..n], 1000)));
    }
    let mut b = strs.String.from(c)!;
    defer b.deinit();
    for k in @as(usize, 0)..(c.len * 8) {
        let bit = @truncate(u8, @as(u32, 1) << @as(u32, @truncate(u8, k % 8)));
        b.bytes()[k / 8] ^= bit;
        @expect(fails(decompress(b.bytes(), 1000)));  // (every part is checked)
        b.bytes()[k / 8] ^= bit;
    }
    @expect(fails(decompress(c, 10)));  // the size limit
}
