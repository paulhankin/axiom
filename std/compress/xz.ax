// =============================================================================
// std/compress/xz.ax - xz and LZMA compression.
//
//     let packed = xz.compress(data, xz.Options.default())!;   // the caller frees
//     let back = xz.decompress(packed, 1 << 30)!;              // at most 1 GiB out
//     let old = xz.decompress_lzma(legacy_bytes, 1 << 30)!;    // .lzma files
//     xz.compress_to(w, data, xz.Options.default())!;          // to an io.Writer
//
// decompress reads .xz files: one or more streams (with stream padding),
// every block and index record checked, with CRC-32, CRC-64 or SHA-256
// checks, LZMA2 compression, and the delta and branch-conversion (BCJ)
// filters for x86, ARM, ARM-Thumb, ARM64, PowerPC and SPARC code.
// decompress_lzma reads the legacy .lzma ("LZMA alone") format.
//
// compress writes an .xz stream with a CRC-64 check and one LZMA2 block.
// The LZMA encoder finds matches with hash chains, uses the repeated-
// distance matches LZMA favours, and looks one position ahead before
// committing to a match; Options.level (1 to 9) sets how hard it searches
// and the dictionary size. compress_lzma writes the .lzma format.
//
// Decompression checks every size, distance and checksum and stops at
// max_size, so hostile input cannot overrun anything or balloon.
// =============================================================================

import "../collections/vec.ax" as vec;
import "../crypto/sha2.ax" as sha2;
import "../encoding/binary.ax" as binary;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../os/fs.ax" as fs;
import "../str.ax" as strs;
import "deflate.ax" as deflate;

pub error XzError { Corrupt, ChecksumMismatch, TooLarge, Unsupported, OutOfMemory, IoError, NotFound, Empty, Done,
                    InvalidUtf8 }

/// The integrity checks compress can write. (A stream being decompressed
/// may name others, which are skipped rather than checked.)
pub enum Check: u8 {
    NONE = 0,
    CRC32 = 1,
    CRC64 = 4,
    SHA256 = 10,
}

