fn crc_update(crc: u32, b: u8) u32 {
    return (crc << 8) ^ CRC_TABLE[@as(usize, (crc >> 24) ^ @as(u32, b))];
}

// -----------------------------------------------------------------------------
// Reading bits
// -----------------------------------------------------------------------------

struct Bits {
    s: []u8,
    i: usize,  // next byte
    acc: u64,
    n: u32,  // bits in acc

    fn need(self: *mut Bits, k: u32) Bzip2Error!void {
        while self.n < k {
            if self.i >= self.s.len {
                return error.Corrupt;
            }
            self.acc = (self.acc << 8) | @as(u64, self.s[self.i]);
            self.i += 1;
            self.n += 8;
        }
    }

    fn bits(self: *mut Bits, k: u32) Bzip2Error!u32 {
        self.need(k)!;
        self.n -= k;
        return @truncate(u32, (self.acc >> @as(u64, self.n)) & ((@as(u64, 1) << @as(u64, k)) - 1));
    }

    fn bit(self: *mut Bits) Bzip2Error!bool {
        return (self.bits(1)!) != 0;
    }

    // Skips to the next byte boundary.
    fn align(self: *mut Bits) void {
        self.n -= self.n % 8;
    }

    // Whether all the input has been read (to the byte).
    fn at_end(self: *Bits) bool {
        return (self.i >= self.s.len) and (self.n < 8);
    }
}

// A canonical Huffman decoding table (codes up to MAX_CODE_LEN bits).
struct Table {
    limit: [21]i32,  // the largest code of each length (or -1)
    base: [21]i32,   // perm index offset for each length
    perm: [258]u16,  // symbols in code order
    min_len: u32,
    max_len: u32,

    fn build(self: *mut Table, lens: []u8) Bzip2Error!void {
        self.min_len = 32;
        self.max_len = 0;
        for l in lens {
            if (l < 1) or (@as(u32, l) > MAX_CODE_LEN) {
                return error.Corrupt;
            }
            self.min_len = @min(self.min_len, @as(u32, l));
            self.max_len = @max(self.max_len, @as(u32, l));
        }
        let mut pp: usize = 0;
        for l in self.min_len..self.max_len + 1 {
            for s in @as(usize, 0)..lens.len {
                if @as(u32, lens[s]) == l {
                    self.perm[pp] = @truncate(u16, s);
                    pp += 1;
                }
            }
        }
        let mut code: i32 = 0;
        let mut idx: i32 = 0;
        for l in @as(u32, 0)..21 {
            self.limit[@as(usize, l)] = -1;
            self.base[@as(usize, l)] = 0;
        }
        for l in self.min_len..self.max_len + 1 {
            let mut count: i32 = 0;
            for x in lens {
                if @as(u32, x) == l {
                    count += 1;
                }
            }
            self.base[@as(usize, l)] = idx - code;
            code += count;
            idx += count;
            self.limit[@as(usize, l)] = code - 1;
            if code > (@as(i32, 1) << @truncate(u32, l)) {
                return error.Corrupt;  // over-subscribed
            }
            code <<= 1;
        }
    }

    fn decode(self: *Table, b: *mut Bits) Bzip2Error!u16 {
        let mut l = self.min_len;
        let mut code = @bit_cast(i32, b.bits(l)!);
        loop {
            if code <= self.limit[@as(usize, l)] {
                let k = code + self.base[@as(usize, l)];
                if (k < 0) or (k >= 258) {
                    return error.Corrupt;
                }
                return self.perm[@as(usize, @bit_cast(u32, k))];
            }
            l += 1;
            if l > self.max_len {
                return error.Corrupt;
            }
            code = (code << 1) | @bit_cast(i32, b.bits(1)!);
        }
    }
}

// -----------------------------------------------------------------------------
// Decompression
// -----------------------------------------------------------------------------

/// Decompresses bzip2 streams (one or more, concatenated); the caller frees
/// the result.
pub fn decompress(data: []u8, max_size: usize) Bzip2Error![]mut u8 {
    let mut out = strs.String.init();
    decode_streams(data, &mut out, max_size) catch |e| {
        out.deinit();
        return e;
    };
    return out.take()!;
}

fn decode_streams(data: []u8, out: *mut strs.String, max_size: usize) Bzip2Error!void {
    let mut b = Bits.{ s: data, i: 0, acc: 0, n: 0 };
    let mut tt = vec.Vec.[u32].init();
    defer tt.deinit();
    let mut first = true;
    loop {
        if not first {
            b.align();
            if b.at_end() {
                return;
            }
        }
        first = false;
        if (b.bits(8)! != 'B') or (b.bits(8)! != 'Z') or (b.bits(8)! != 'h') {
            return error.Corrupt;
        }
        let level = b.bits(8)!;
        if (level < '1') or (level > '9') {
            return error.Corrupt;
        }
        let block_max = @as(usize, level - '0') * 100000;
        let mut combined: u32 = 0;
        loop {
            let magic = (@as(u64, b.bits(24)!) << 24) | @as(u64, b.bits(24)!);
            if magic == END_MAGIC {
                let want = b.bits(32)!;
                if want != combined {
                    return error.ChecksumMismatch;
                }
                break;
            }
            if magic != BLOCK_MAGIC {
                return error.Corrupt;
            }
            let want = b.bits(32)!;
            let got = decode_block(&mut b, block_max, &mut tt, out, max_size)!;
            if got != want {
                return error.ChecksumMismatch;
            }
            combined = ((combined << 1) | (combined >> 31)) ^ got;
        }
    }
}

// Decodes one block onto out: returns its CRC.
fn decode_block(b: *mut Bits, block_max: usize, tt: *mut vec.Vec.[u32], out: *mut strs.String,
                max_size: usize) Bzip2Error!u32 {
    if b.bit()! {
        return error.Unsupported;  // randomised
    }
    let orig = @as(usize, b.bits(24)!);
    // the bytes in use
    let mut used: [256]u8 = [0; 256];
    let mut nused: usize = 0;
    let groups16 = b.bits(16)!;
    for i in @as(u32, 0)..16 {
        if (groups16 & (@as(u32, 0x8000) >> i)) != 0 {
            let bits16 = b.bits(16)!;
            for j in @as(u32, 0)..16 {
                if (bits16 & (@as(u32, 0x8000) >> j)) != 0 {
                    used[nused] = @truncate(u8, (i * 16) + j);
                    nused += 1;
                }
            }
        }
    }
    if nused == 0 {
        return error.Corrupt;
    }
    let alpha = nused + 2;
    let ngroups = @as(usize, b.bits(3)!);
    if (ngroups < 2) or (ngroups > MAX_GROUPS) {
        return error.Corrupt;
    }
    let nsel = @as(usize, b.bits(15)!);
    if nsel == 0 {
        return error.Corrupt;
    }
    let mut selectors = vec.Vec.[u8].init();
    defer selectors.deinit();
    selectors.reserve(nsel)!;
    let mut mtf_groups: [6]u8 = [0, 1, 2, 3, 4, 5];
    for _k in @as(usize, 0)..nsel {
        let mut j: usize = 0;
        while b.bit()! {
            j += 1;
            if j >= ngroups {
                return error.Corrupt;
            }
        }
        let v = mtf_groups[j];
        while j > 0 {
            mtf_groups[j] = mtf_groups[j - 1];
            j -= 1;
        }
        mtf_groups[0] = v;
        selectors.push(v)!;
    }
    // the code length tables
    let tables = mem.alloc.[Table](ngroups)!;
    defer mem.free(tables);
    let mut lens: [258]u8 = [0; 258];
    for t in @as(usize, 0)..ngroups {
        let mut cur = @bit_cast(i32, b.bits(5)!);
        for s in @as(usize, 0)..alpha {
            loop {
                if (cur < 1) or (cur > 20) {
                    return error.Corrupt;
                }
                if not b.bit()! {
                    break;
                }
                if b.bit()! {
                    cur -= 1;
                } else {
                    cur += 1;
                }
            }
            lens[s] = @truncate(u8, @bit_cast(u32, cur));
        }
        tables[t].build(lens[..alpha])!;
    }
    // the symbols: MTF indexes with zero runs, to the end-of-block symbol
    let eob = @truncate(u16, alpha - 1);
    let mut mtf: [256]u8 = [0; 256];
    for k in @as(usize, 0)..256 {
        mtf[k] = @truncate(u8, k);
    }
    let mut counts: [256]u32 = [0; 256];
    tt.clear();
    tt.reserve(block_max)!;
    let mut sel_i: usize = 0;
    let mut left: usize = 0;
    let mut table: usize = 0;
    let mut run: usize = 0;
    let mut run_w: usize = 1;
    loop {
        if left == 0 {
            if sel_i >= selectors.len {
                return error.Corrupt;
            }
            table = @as(usize, selectors.items()[sel_i]);
            sel_i += 1;
            left = GROUP_SIZE;
        }
        left -= 1;
        let sym = tables[table].decode(b)!;
        if (sym == 0) or (sym == 1) {
            // RUNA and RUNB: a run of the front byte, in bijective base 2
            run += run_w << @as(usize, sym);
            run_w <<= 1;
            if run > block_max {
                return error.Corrupt;
            }
            continue;
        }
        if run > 0 {
            let v = used[@as(usize, mtf[0])];
            if (tt.len + run) > block_max {
                return error.Corrupt;
            }
            counts[@as(usize, v)] += @truncate(u32, run);
            for _k in @as(usize, 0)..run {
                tt.push(@as(u32, v))!;
            }
            run = 0;
            run_w = 1;
        }
        if sym == eob {
            break;
        }
        let j = @as(usize, sym - 1);
        if j >= nused {
            return error.Corrupt;
        }
        let m = mtf[j];
        let mut k = j;
        while k > 0 {
            mtf[k] = mtf[k - 1];
            k -= 1;
        }
        mtf[0] = m;
        let v = used[@as(usize, m)];
        if tt.len >= block_max {
            return error.Corrupt;
        }
        counts[@as(usize, v)] += 1;
        tt.push(@as(u32, v))!;
    }
    let n = tt.len;
    if orig >= n {
        if n == 0 {
            return 0xffffffff ^ 0xffffffff;
        }
        return error.Corrupt;
    }
    // the inverse BWT: tt[i] (high bits) links each position to the next
    let mut cum: [256]u32 = [0; 256];
    let mut sum: u32 = 0;
    for c in @as(usize, 0)..256 {
        cum[c] = sum;
        sum += counts[c];
    }
    let t = tt.items();
    for i in @as(usize, 0)..n {
        let c = @as(usize, t[i] & 0xff);
        t[@as(usize, cum[c])] |= @truncate(u32, i) << 8;
        cum[c] += 1;
    }
    // undo the initial run-length coding while walking the links
    let mut crc: u32 = 0xffffffff;
    let mut pos = t[orig] >> 8;
    let mut last: i32 = -1;
    let mut same: u32 = 0;
    let mut k: usize = 0;
    out.reserve(n)!;
    while k < n {
        let e = t[@as(usize, pos)];
        let c = @truncate(u8, e);
        pos = e >> 8;
        k += 1;
        if same == 4 {
            // a count of extra copies
            let reps = @as(usize, c);
            if (out.len + reps) > max_size {
                return error.TooLarge;
            }
            let lb = @truncate(u8, @bit_cast(u32, last));
            for _j in @as(usize, 0)..reps {
                out.push(lb)!;
                crc = crc_update(crc, lb);
            }
            same = 0;
            last = -1;
            continue;
        }
        if @as(i32, c) == last {
            same += 1;
        } else {
            same = 1;
            last = @as(i32, c);
        }
        if out.len >= max_size {
            return error.TooLarge;
        }
        out.push(c)!;
        crc = crc_update(crc, c);
    }
    return crc ^ 0xffffffff;
}

// -----------------------------------------------------------------------------
// Compression
// -----------------------------------------------------------------------------

struct BitWriter {
    out: *mut strs.String,
    acc: u64,
    n: u32,

    fn put(self: *mut BitWriter, k: u32, v: u32) Bzip2Error!void {
        self.acc = (self.acc << @as(u64, k)) | @as(u64, v & (@truncate(u32, (@as(u64, 1) << @as(u64, k)) - 1)));
        self.n += k;
        while self.n >= 8 {
            self.n -= 8;
            self.out.push(@truncate(u8, self.acc >> @as(u64, self.n)))!;
        }
    }

    fn flush(self: *mut BitWriter) Bzip2Error!void {
        if self.n > 0 {
            self.out.push(@truncate(u8, self.acc << @as(u64, 8 - self.n)))!;
            self.n = 0;
        }
    }
}

/// Compresses data with blocks of level x 100 kB (1 to 9); the caller
/// frees the result.
pub fn compress(data: []u8, level: u32) ![]mut u8 {
    let mut out = strs.String.init();
    compress_to(out.writer(), data, level) catch |e| {
        out.deinit();
        return e;
    };
    return out.take()!;
}

/// Compresses data with blocks of level x 100 kB (1 to 9) and writes it
/// to dst a block at a time, as each is compressed (blocks are not byte
/// aligned: a block's last bits go out with the next one).
pub fn compress_to(dst: io.Writer, data: []u8, level0: u32) !void {
    let level = @max(@min(level0, 9), 1);
    let mut ob = strs.String.init();
    defer ob.deinit();
    let mut w = BitWriter.{ out: &mut ob, acc: 0, n: 0 };
    w.put(8, 'B')!;
    w.put(8, 'Z')!;
    w.put(8, 'h')!;
    w.put(8, '0' + level)!;
    // (a block holds at most this much after run-length coding, as bzip2 keeps)
    let cap = (@as(usize, level) * 100000) - 19;
    let mut block = vec.Vec.[u8].init();
    defer block.deinit();
    block.reserve(cap + 8)!;
    let mut combined: u32 = 0;
    let mut i: usize = 0;
    while i < data.len {
        // run-length code as much input as fits
        block.clear();
        let mut crc: u32 = 0xffffffff;
        while (i < data.len) and (block.len < cap) {
            let c = data[i];
            let mut r: usize = 1;
            while ((i + r) < data.len) and (data[i + r] == c) and (r < 255) {
                r += 1;
            }
            if (block.len + @min(r, 5)) > cap {
                break;
            }
            for _k in @as(usize, 0)..r {
                crc = crc_update(crc, c);
            }
            if r >= 4 {
                for _k in @as(usize, 0)..4 {
                    block.push(c)!;
                }
                block.push(@truncate(u8, r - 4))!;
            } else {
                for _k in @as(usize, 0)..r {
                    block.push(c)!;
                }
            }
            i += r;
        }
        crc ^= 0xffffffff;
        combined = ((combined << 1) | (combined >> 31)) ^ crc;
        w.put(24, 0x314159)!;
        w.put(24, 0x265359)!;
        w.put(32, crc)!;
        encode_block(&mut w, block.items())!;
        dst.write_all(ob.bytes())!;
        ob.clear();
    }
    w.put(24, 0x177245)!;
    w.put(24, 0x385090)!;
    w.put(32, combined)!;
    w.flush()!;
    dst.write_all(ob.bytes())!;
}

// The Burrows-Wheeler transform of s (cyclic rotations, sorted by prefix
// doubling): fills last with the last column and returns the row of s.
fn bwt(s: []u8, last: []mut u8) Bzip2Error!usize {
    let n = s.len;
    let sa = mem.alloc.[u32](n)!;
    defer mem.free(sa);
    let rank = mem.alloc.[u32](n)!;
    defer mem.free(rank);
    let tmp = mem.alloc.[u32](n)!;
    defer mem.free(tmp);
    let cnt = mem.alloc.[u32](@max(n, 256) + 1)!;
    defer mem.free(cnt);
    // sort by the first byte
    @mem_set(@cast_slice(u8, cnt), 0);
    for c in s {
        cnt[@as(usize, c) + 1] += 1;
    }
    for k in @as(usize, 1)..257 {
        cnt[k] += cnt[k - 1];
    }
    for i in @as(usize, 0)..n {
        let c = @as(usize, s[i]);
        sa[@as(usize, cnt[c])] = @truncate(u32, i);
        cnt[c] += 1;
    }
    let mut classes: u32 = 1;
    rank[@as(usize, sa[0])] = 0;
    for k in @as(usize, 1)..n {
        if s[@as(usize, sa[k])] != s[@as(usize, sa[k - 1])] {
            classes += 1;
        }
        rank[@as(usize, sa[k])] = classes - 1;
    }
    let mut h: usize = 1;
    while (h < n) and (@as(usize, classes) < n) {
        // sort by (rank[i], rank[i + h]): the order of i - h is already sorted by the second key
        for k in @as(usize, 0)..n {
            let p = @as(usize, sa[k]);
            tmp[k] = @truncate(u32, (p + n - h) % n);
        }
        @mem_set(@cast_slice(u8, cnt[..@as(usize, classes) + 1]), 0);
        for k in @as(usize, 0)..n {
            cnt[@as(usize, rank[@as(usize, tmp[k])]) + 1] += 1;
        }
        for k in @as(usize, 1)..@as(usize, classes) + 1 {
            cnt[k] += cnt[k - 1];
        }
        for k in @as(usize, 0)..n {
            let p = tmp[k];
            let r = @as(usize, rank[@as(usize, p)]);
            sa[@as(usize, cnt[r])] = p;
            cnt[r] += 1;
        }
        // new classes
        tmp[@as(usize, sa[0])] = 0;
        classes = 1;
        for k in @as(usize, 1)..n {
            let a = @as(usize, sa[k]);
            let b = @as(usize, sa[k - 1]);
            if (rank[a] != rank[b]) or (rank[(a + h) % n] != rank[(b + h) % n]) {
                classes += 1;
            }
            tmp[a] = classes - 1;
        }
        @mem_copy(rank, tmp);
        h *= 2;
    }
    let mut orig: usize = 0;
    for k in @as(usize, 0)..n {
        let p = @as(usize, sa[k]);
        if p == 0 {
            orig = k;
            last[k] = s[n - 1];
        } else {
            last[k] = s[p - 1];
        }
    }
    return orig;
}

// Code lengths (at most max_len bits) for the frequencies, as bzip2 does:
// Huffman, with the frequencies flattened until the longest code fits.
fn code_lengths(freq: []u32, lens: []mut u8, max_len: u32) Bzip2Error!void {
    let n = freq.len;
    let w = mem.alloc.[u64](n)!;
    defer mem.free(w);
    let mut scale: u64 = 0;
    loop {
        for k in @as(usize, 0)..n {
            let f = @max(@as(u64, freq[k]), 1);
            w[k] = @max(f >> scale, 1);
        }
        huffman(w, lens)!;
        let mut longest: u32 = 0;
        for l in lens {
            longest = @max(longest, @as(u32, l));
        }
        if longest <= max_len {
            return;
        }
        scale += 1;
    }
}

// Huffman code lengths for weights (a simple O(n^2) build: n <= 258).
fn huffman(w: []u64, lens: []mut u8) Bzip2Error!void {
    let n = w.len;
    let total = (2 * n) - 1;
    let weight = mem.alloc.[u64](total)!;
    defer mem.free(weight);
    let parent = mem.alloc.[u32](total)!;
    defer mem.free(parent);
    let alive = mem.alloc.[bool](total)!;
    defer mem.free(alive);
    for k in @as(usize, 0)..n {
        weight[k] = w[k];
        alive[k] = true;
    }
    for k in n..total {
        alive[k] = false;
    }
    let mut next = n;
    while next < total {
        // the two lightest live nodes
        let mut a = NONE;
        let mut b = NONE;
        for k in @as(usize, 0)..next {
            if not alive[k] {
                continue;
            }
            if (a == NONE) or (weight[k] < weight[a]) {
                b = a;
                a = k;
            } else if (b == NONE) or (weight[k] < weight[b]) {
                b = k;
            }
        }
        weight[next] = weight[a] + weight[b];
        alive[a] = false;
        alive[b] = false;
        alive[next] = true;
        parent[a] = @truncate(u32, next);
        parent[b] = @truncate(u32, next);
        next += 1;
    }
    parent[total - 1] = @truncate(u32, total);
    for k in @as(usize, 0)..n {
        let mut d: u32 = 0;
        let mut p = k;
        while p != (total - 1) {
            p = @as(usize, parent[p]);
            d += 1;
        }
        lens[k] = @truncate(u8, @min(d, 255));
    }
    if n == 1 {
        lens[0] = 1;
    }
}

const NONE: usize = 0xffffffff;

fn encode_block(w: *mut BitWriter, block: []u8) Bzip2Error!void {
    let n = block.len;
    let last = mem.alloc.[u8](n)!;
    defer mem.free(last);
    let orig = bwt(block, last)!;
    // the bytes in use
    let mut inuse: [256]bool = [false; 256];
    for c in block {
        inuse[@as(usize, c)] = true;
    }
    let mut index: [256]u8 = [0; 256];
    let mut nused: usize = 0;
    for c in @as(usize, 0)..256 {
        if inuse[c] {
            index[c] = @truncate(u8, nused);
            nused += 1;
        }
    }
    let alpha = nused + 2;
    let eob = @truncate(u16, alpha - 1);
    // move-to-front, with zero runs as RUNA/RUNB
    let mut syms = vec.Vec.[u16].init();
    defer syms.deinit();
    syms.reserve(n + 1)!;
    let mut mtf: [256]u8 = [0; 256];
    for k in @as(usize, 0)..nused {
        mtf[k] = @truncate(u8, k);
    }
    let mut zeros: usize = 0;
    for c in last {
        let v = index[@as(usize, c)];
        let mut j: usize = 0;
        while mtf[j] != v {
            j += 1;
        }
        if j == 0 {
            zeros += 1;
            continue;
        }
        put_run(&mut syms, zeros)!;
        zeros = 0;
        syms.push(@truncate(u16, j + 1))!;
        while j > 0 {
            mtf[j] = mtf[j - 1];
            j -= 1;
        }
        mtf[0] = v;
    }
    put_run(&mut syms, zeros)!;
    syms.push(eob)!;
    let s = syms.items();
    // the number of tables, and a first split of the symbols among them
    let mut ngroups: usize = 6;
    if s.len < 200 {
        ngroups = 2;
    } else if s.len < 600 {
        ngroups = 3;
    } else if s.len < 1200 {
        ngroups = 4;
    } else if s.len < 2400 {
        ngroups = 5;
    }
    let nsel = (s.len + GROUP_SIZE - 1) / GROUP_SIZE;
    let mut freq: [6][258]u32 = [[0; 258]; 6];
    let mut lens: [6][258]u8 = [[0; 258]; 6];
    let mut total: [258]u32 = [0; 258];
    for x in s {
        total[@as(usize, x)] += 1;
    }
    // initial tables: each covers a band of symbols holding about an equal share
    let mut remaining = s.len;
    let mut lo: usize = 0;
    for g in @as(usize, 0)..ngroups {
        let share = remaining / (ngroups - g);
        let mut hi = lo;
        let mut acc: usize = 0;
        while (acc < share) and (hi < alpha) {
            acc += @as(usize, total[hi]);
            hi += 1;
        }
        for k in @as(usize, 0)..alpha {
            if (k >= lo) and (k < hi) {
                lens[g][k] = 0;
            } else {
                lens[g][k] = 15;
            }
        }
        lo = hi;
        remaining -= @min(acc, remaining);
    }
    let selectors = mem.alloc.[u8](nsel)!;
    defer mem.free(selectors);
    // refine: choose the cheapest table for each group, recount, rebuild
    for _iter in @as(usize, 0)..4 {
        for g in @as(usize, 0)..ngroups {
            @mem_set(@cast_slice(u8, freq[g][..]), 0);
        }
        for gi in @as(usize, 0)..nsel {
            let part = s[gi * GROUP_SIZE..@min((gi + 1) * GROUP_SIZE, s.len)];
            let mut best: usize = 0;
            let mut best_cost: u32 = 0xffffffff;
            for g in @as(usize, 0)..ngroups {
                let mut cost: u32 = 0;
                for x in part {
                    cost += @as(u32, lens[g][@as(usize, x)]);
                }
                if cost < best_cost {
                    best_cost = cost;
                    best = g;
                }
            }
            selectors[gi] = @truncate(u8, best);
            for x in part {
                freq[best][@as(usize, x)] += 1;
            }
        }
        for g in @as(usize, 0)..ngroups {
            code_lengths(freq[g][..alpha], lens[g][..alpha], 17)!;
        }
    }
    // the header
    w.put(1, 0)!;
    w.put(24, @truncate(u32, orig))!;
    let mut groups16: u32 = 0;
    for i in @as(usize, 0)..16 {
        for j in @as(usize, 0)..16 {
            if inuse[(i * 16) + j] {
                groups16 |= @as(u32, 0x8000) >> @truncate(u32, i);
            }
        }
    }
    w.put(16, groups16)!;
    for i in @as(usize, 0)..16 {
        if (groups16 & (@as(u32, 0x8000) >> @truncate(u32, i))) != 0 {
            let mut bits16: u32 = 0;
            for j in @as(usize, 0)..16 {
                if inuse[(i * 16) + j] {
                    bits16 |= @as(u32, 0x8000) >> @truncate(u32, j);
                }
            }
            w.put(16, bits16)!;
        }
    }
    w.put(3, @truncate(u32, ngroups))!;
    w.put(15, @truncate(u32, nsel))!;
    let mut order: [6]u8 = [0, 1, 2, 3, 4, 5];
    for gi in @as(usize, 0)..nsel {
        let v = selectors[gi];
        let mut j: usize = 0;
        while order[j] != v {
            j += 1;
        }
        for _k in @as(usize, 0)..j {
            w.put(1, 1)!;
        }
        w.put(1, 0)!;
        while j > 0 {
            order[j] = order[j - 1];
            j -= 1;
        }
        order[0] = v;
    }
    for g in @as(usize, 0)..ngroups {
        let mut cur = @as(i32, lens[g][0]);
        w.put(5, @bit_cast(u32, cur))!;
        for k in @as(usize, 0)..alpha {
            let want = @as(i32, lens[g][k]);
            while cur < want {
                w.put(2, 2)!;  // 10: one longer
                cur += 1;
            }
            while cur > want {
                w.put(2, 3)!;  // 11: one shorter
                cur -= 1;
            }
            w.put(1, 0)!;
        }
    }
    // the symbols, with canonical codes
    let mut codes: [6][258]u32 = [[0; 258]; 6];
    for g in @as(usize, 0)..ngroups {
        let mut code: u32 = 0;
        for l in @as(u8, 1)..21 {
            for k in @as(usize, 0)..alpha {
                if lens[g][k] == l {
                    codes[g][k] = code;
                    code += 1;
                }
            }
            code <<= 1;
        }
    }
    for gi in @as(usize, 0)..nsel {
        let g = @as(usize, selectors[gi]);
        for x in s[gi * GROUP_SIZE..@min((gi + 1) * GROUP_SIZE, s.len)] {
            let k = @as(usize, x);
            w.put(@as(u32, lens[g][k]), codes[g][k])!;
        }
    }
}

// A run of n zeros (MTF index 0) in bijective base 2: RUNA = 1, RUNB = 2.
fn put_run(syms: *mut vec.Vec.[u16], n: usize) Bzip2Error!void {
    let mut r = n;
    while r > 0 {
        r -= 1;
        syms.push(@truncate(u16, r & 1))!;
        r >>= 1;
    }
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn fails(r: Bzip2Error![]mut u8) bool {
    let x = r catch return true;
    mem.free(x);
    return false;
}

test "files made by the bz2 library" {
    let corpus = fs.read_file("std/compress/testdata/corpus.bin") catch return;
    defer mem.free(corpus);
    let mut dir = fs.read_dir("std/compress/bzip2/testdata")!;
    defer dir.deinit();
    let mut n: usize = 0;
    for e in dir.entries.items() {
        let mut p = strs.String.init();
        defer p.deinit();
        p.push_str("std/compress/bzip2/testdata/")!;
        p.push_str(e.name)!;
        let data = fs.read_file(p.bytes())!;
        defer mem.free(data);
        let got = decompress(data, 1 << 24)!;
        defer mem.free(got);
        if strs.starts_with(e.name, "corpus") {
            @expect_eq(got, corpus);
        } else if strs.starts_with(e.name, "short") {
            @expect_eq(got, "Hello, Hello, Hello, world!\n");
        } else {
            @expect_eq(got.len, 0);
        }
        n += 1;
    }
    @expect(n >= 5);
}

test "round trips" {
    let corpus = fs.read_file("std/compress/testdata/corpus.bin") catch return;
    defer mem.free(corpus);
    for level in [@as(u32, 1), 9] {
        let c = compress(corpus, level)!;
        defer mem.free(c);
        @expect(c.len < (corpus.len / 2));
        let d = decompress(c, corpus.len)!;
        defer mem.free(d);
        @expect_eq(d, corpus);
        @expect(fails(decompress(c, corpus.len - 1)));
    }
    let mut runs = strs.String.init();
    defer runs.deinit();
    for k in @as(usize, 0)..3000 {
        for _j in @as(usize, 0)..(k % 300) {
            runs.push(@truncate(u8, k))!;
        }
    }
    for input in ["", "a", "aaaa", "aaaaa", "abababababababab", runs.bytes()] {
        let c = compress(input, 1)!;
        defer mem.free(c);
        let d = decompress(c, 1 << 24)!;
        defer mem.free(d);
        @expect_eq(d, input);
    }
    // compress_to: the same bytes, block by block (three blocks here)
    let mut text = strs.String.init();
    defer text.deinit();
    let mut x: u32 = 7;
    for _k in @as(usize, 0)..230000 {
        x = (x *% 1103515245) +% 12345;
        text.push('a' + @truncate(u8, (x >> 16) % 7))!;
    }
    let c = compress(text.bytes(), 1)!;
    defer mem.free(c);
    let mut out = strs.String.init();
    defer out.deinit();
    compress_to(out.writer(), text.bytes(), 1)!;
    @expect_eq(out.bytes(), c);
    let back = decompress(c, text.len)!;
    defer mem.free(back);
    @expect_eq(back, text.bytes());
    let mut small: [100]u8 = [0; 100];
    let mut bw = io.BufferWriter.init(small[..]);
    compress_to(bw.writer(), text.bytes(), 1) catch |e| {
        @expect_eq(e, error.NoSpaceLeft);
        return;
    };
    @trap();
}

test "damaged input" {
    let c = compress("hello hello hello hello hello hello, world", 9)!;
    defer mem.free(c);
    for n in @as(usize, 0)..c.len {
        @expect(fails(decompress(c[..n], 1000)));
    }
    let mut b = strs.String.from(c)!;
    defer b.deinit();
    for k in @as(usize, 0)..(c.len * 8) {
        let bit = @truncate(u8, @as(u32, 1) << @as(u32, @truncate(u8, k % 8)));
        b.bytes()[k / 8] ^= bit;
        let r = decompress(b.bytes(), 1000) catch {
            b.bytes()[k / 8] ^= bit;
            continue;
        };
        mem.free(r);
        b.bytes()[k / 8] ^= bit;
    }
}
