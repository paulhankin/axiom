// =============================================================================
// std/compress/bzip2.ax - bzip2 compression (Burrows-Wheeler).
//
//     let packed = bzip2.compress(data, 9)!;          // block size 1..9 (x 100 kB)
//     let back = bzip2.decompress(packed, 1 << 30)!;  // at most 1 GiB out
//     bzip2.compress_to(w, data, 9)!;                 // to an io.Writer
//
// decompress reads bzip2 streams, one after another (as bzip2 does for
// concatenated files), checking every block's CRC and the stream CRC.
// compress writes the format bzip2 1.0 writes: run-length coding, the
// Burrows-Wheeler transform (by cyclic prefix doubling, so any input sorts
// in n log n time), move-to-front with zero-run coding, and two to six
// Huffman tables chosen per 50 symbols, refined over several passes.
//
// Decompression checks every table, symbol and index and stops at
// max_size, so hostile input fails cleanly. Blocks marked "randomised"
// (never written since bzip2 0.9.5) fail with Unsupported.
// =============================================================================

import "../collections/vec.ax" as vec;
import "../io.ax" as io;
import "../mem.ax" as mem;
import "../os/fs.ax" as fs;
import "../str.ax" as strs;

pub error Bzip2Error { Corrupt, ChecksumMismatch, TooLarge, Unsupported, OutOfMemory, Empty, IoError, NotFound, Done,
                       InvalidUtf8 }

const BLOCK_MAGIC: u64 = 0x314159265359;
const END_MAGIC: u64 = 0x177245385090;
const MAX_GROUPS: usize = 6;
const MAX_ALPHA: usize = 258;
const MAX_CODE_LEN: u32 = 20;
const GROUP_SIZE: usize = 50;

