// =============================================================================
// std/unicode/collate.ax - sorting text by the Unicode Collation Algorithm
// (UTS #10) with the Default Unicode Collation Element Table (DUCET), as
// people expect text sorted rather than by code point: "Äpfel" < "apple" <
// "Apple" < "banana", "résumé" next to "resume", digits before letters,
// punctuation ignored or not.
//
//     let mut c = collate.Collator.init(collate.Options.default());
//     defer c.deinit();
//     let order = c.compare("cote", "côte")!;          // -1
//     c.sort(names[..])!;                               // a []mut []u8, in place
//     c.sort_key("Ünïcödé", &mut key)!;                 // bytes that compare like the text
//
//     collate.compare(a, b)!                            // with the default options
//
// Options choose the strength (how many levels count: PRIMARY compares
// base letters only, SECONDARY adds accents, TERTIARY case and variants,
// QUATERNARY punctuation under SHIFTED) and how variable elements (spaces,
// punctuation, symbols) weigh: NON_IGNORABLE (the default, as in CLDR's
// root) sorts them like letters; SHIFTED ignores them except as a last
// resort. The default is TERTIARY and NON_IGNORABLE.
//
// The algorithm follows UTS #10 version 15.1: NFD first, then the longest
// contiguous match of contractions, discontiguous matches over unblocked
// non-starters, implicit weights for ideographs (core Han, other Han,
// Tangut, Nushu, Khitan) and for everything the table leaves out, variable
// weighting, and sort keys with level separators. It passes the UCA
// conformance tests (CollationTest_NON_IGNORABLE_SHORT and _SHIFTED_SHORT)
// in collate/testdata. Language-specific tailorings (CLDR) are not
// included. Text that is not valid UTF-8 is read with U+FFFD for each bad
// sequence. The tables (collate/tables.ax) are generated by
// cmd/internal/tools/gen_collate.py.
// =============================================================================

import "../collections/vec.ax" as vec;
import "../mem.ax" as mem;
import "../str.ax" as strs;
import "../unicode.ax" as unicode;
import "collate/tables.ax" as t;

pub error CollateError { OutOfMemory, NotFound, Empty, BadFormat, Corrupt, Done, InvalidUtf8, InvalidNumber,
                         ChecksumMismatch, PermissionDenied, IoError, Overflow, TooLarge, Exists, EndOfStream,
                         NoSpaceLeft, Unsupported, NotADirectory, IsDirectory }

/// How many levels of difference count.
pub enum Strength: u8 {
    PRIMARY = 1,     // base characters
    SECONDARY = 2,   // and accents
    TERTIARY = 3,    // and case and variants
    QUATERNARY = 4,  // and, with SHIFTED, the variable elements
}

/// How variable elements (white space, punctuation, most symbols) weigh.
pub enum Alternate: u8 {
    NON_IGNORABLE,  // like any other character
    SHIFTED,        // ignored at the first three levels; the fourth orders them
}

/// Collation settings.
pub struct Options {
    strength: Strength,
    alternate: Alternate,

    /// TERTIARY and NON_IGNORABLE.
    pub fn default() Options {
        return Options.{ strength: Strength.TERTIARY, alternate: Alternate.NON_IGNORABLE };
    }
}

/// The UCA (and DUCET) version.
pub fn version() []u8 {
    return t.VERSION;
}

// A collation element: primary << 15 | secondary << 6 | tertiary << 1 | variable.
fn ce_primary(ce: u32) u32 {
    return ce >> 15;
}

fn ce_secondary(ce: u32) u32 {
    return (ce >> 6) & 0x1ff;
}

fn ce_tertiary(ce: u32) u32 {
    return (ce >> 1) & 0x1f;
}

fn make_ce(p: u32, s: u32, tt: u32) u32 {
    return ((p << 15) | (s << 6)) | (tt << 1);
}

fn lookup(cp: u32) u32 {
    if cp > 0x10ffff {
        return 0;
    }
    let block = @as(usize, t.STAGE1[@as(usize, cp >> 8)]);
    return t.STAGE2[(block * 256) + @as(usize, cp & 0xff)];
}

fn push_entry(e: u32, out: *mut vec.Vec.[u32]) CollateError!void {
    if (e & 0x80000000) != 0 {
        out.push(e & 0x7fffffff)!;
        return;
    }
    let at = @as(usize, e >> 8);
    let n = @as(usize, (e >> 1) & 0x7f);
    out.extend(t.POOL[at..at + n])!;
}

fn in_ranges(r: []u32, cp: u32) bool {
    let mut i: usize = 0;
    while (i + 1) < r.len {
        if (cp >= r[i]) and (cp <= r[i + 1]) {
            return true;
        }
        i += 2;
    }
    return false;
}

/// The two implicit CEs of a code point the table leaves out (UTS #10 10.1).
fn implicit(cp: u32, out: *mut vec.Vec.[u32]) CollateError!void {
    for k in @as(usize, 0)..t.IMPLICIT_LO.len {
        if (cp >= t.IMPLICIT_LO[k]) and (cp <= t.IMPLICIT_HI[k]) {
            // offsets count from the first range with this base (Tangut's
            // supplement continues Tangut's numbering)
            let base = t.IMPLICIT_BASE[k];
            let mut first = t.IMPLICIT_LO[k];
            for j in @as(usize, 0)..t.IMPLICIT_LO.len {
                if (t.IMPLICIT_BASE[j] == base) and (t.IMPLICIT_LO[j] < first) {
                    first = t.IMPLICIT_LO[j];
                }
            }
            out.push(make_ce(base, 0x20, 2))!;
            out.push(make_ce((cp - first) | 0x8000, 0, 0))!;
            return;
        }
    }
    let mut base: u32 = 0xfbc0;
    if in_ranges(t.IDEO_CORE[..], cp) {
        base = 0xfb40;
    } else if in_ranges(t.IDEO_OTHER[..], cp) {
        base = 0xfb80;
    }
    out.push(make_ce(base + (cp >> 15), 0x20, 2))!;
    out.push(make_ce((cp & 0x7fff) | 0x8000, 0, 0))!;
}

// The first contraction starting with cp (CONTR_FIRST is sorted).
fn contractions_of(cp: u32) usize {
    let mut lo: usize = 0;
    let mut hi = t.CONTR_FIRST.len;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if t.CONTR_FIRST[mid] < cp {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn pack_seq(cps: []u32) u64 {
    let mut v: u64 = 0;
    for c in cps {
        v = (v << 21) | @as(u64, c);
    }
    return v;
}

/// The contraction whose code points are seq, or CONTR_FIRST.len.
fn find_contraction(seq: []u32) usize {
    let packed = pack_seq(seq);
    let mut k = contractions_of(seq[0]);
    while (k < t.CONTR_FIRST.len) and (t.CONTR_FIRST[k] == seq[0]) {
        if (@as(usize, t.CONTR_LEN[k]) == seq.len) and (t.CONTR_SEQ[k] == packed) {
            return k;
        }
        k += 1;
    }
    return t.CONTR_FIRST.len;
}

/// Reusable buffers for computing sort keys. Not for use by two threads at
/// once; make one per thread.
pub struct Collator {
    opts: Options,
    cps: vec.Vec.[u32],
    nfd: vec.Vec.[u32],
    ces: vec.Vec.[u32],
    ka: strs.String,
    kb: strs.String,

    pub fn init(opts: Options) Collator {
        return Collator.{ opts: opts, cps: vec.Vec.[u32].init(), nfd: vec.Vec.[u32].init(), ces: vec.Vec.[u32].init(),
                          ka: strs.String.init(), kb: strs.String.init() };
    }

    pub fn deinit(self: *mut Collator) void {
        self.cps.deinit();
        self.nfd.deinit();
        self.ces.deinit();
        self.ka.deinit();
        self.kb.deinit();
    }

    /// Appends the sort key of UTF-8 text s to out: comparing keys byte by
    /// byte (strs.compare, or memcmp) orders texts as compare does.
    pub fn sort_key(self: *mut Collator, s: []u8, out: *mut strs.String) CollateError!void {
        self.cps.clear();
        let mut it = strs.runes(s);
        loop {
            let r = it.next() catch break;
            self.cps.push(r)!;
        }
        let cps = self.cps;
        self.sort_key_cps(cps.items(), out)!;
    }

    /// The sort key of a sequence of code points (which may include
    /// surrogates; values beyond U+10FFFF count as U+FFFD).
    pub fn sort_key_cps(self: *mut Collator, cps: []u32, out: *mut strs.String) CollateError!void {
        self.nfd.clear();
        for c in cps {
            if c > 0x10ffff {
                // (rare: a copy with the bad values replaced)
                let fixed = mem.dup(cps)!;
                defer mem.free(fixed);
                for k in @as(usize, 0)..fixed.len {
                    if fixed[k] > 0x10ffff {
                        fixed[k] = 0xfffd;
                    }
                }
                unicode.decompose_into(fixed, &mut self.nfd)!;
                self.ces.clear();
                elements(&mut self.nfd, &mut self.ces)!;
                key_from(self.ces.items(), self.opts, out)!;
                return;
            }
        }
        unicode.decompose_into(cps, &mut self.nfd)!;
        self.ces.clear();
        elements(&mut self.nfd, &mut self.ces)!;
        key_from(self.ces.items(), self.opts, out)!;
    }

    /// -1, 0 or 1 as a sorts before, the same as, or after b.
    pub fn compare(self: *mut Collator, a: []u8, b: []u8) CollateError!i32 {
        self.ka.clear();
        self.kb.clear();
        self.sort_key(a, &mut self.ka)!;
        self.sort_key(b, &mut self.kb)!;
        return strs.compare(self.ka.bytes(), self.kb.bytes());
    }

    /// Whether a and b are equal at the collator's strength.
    pub fn equal(self: *mut Collator, a: []u8, b: []u8) CollateError!bool {
        return self.compare(a, b)! == 0;
    }

    /// Sorts xs in place (stably: equal texts keep their order).
    pub fn sort(self: *mut Collator, xs: []mut []u8) CollateError!void {
        let mut keys = strs.String.init();
        defer keys.deinit();
        let ends = mem.alloc.[usize](xs.len)!;
        defer mem.free(ends);
        for i in @as(usize, 0)..xs.len {
            self.sort_key(xs[i], &mut keys)!;
            ends[i] = keys.len;
        }
        let order = mem.alloc.[usize](xs.len)!;
        defer mem.free(order);
        for i in @as(usize, 0)..xs.len {
            order[i] = i;
        }
        let ctx = KeyCtx.{ keys: keys.bytes(), ends: ends };
        vec.sort_stable_with(order, ctx, key_less)!;
        let copy = mem.dup(xs)!;
        defer mem.free(copy);
        for i in @as(usize, 0)..xs.len {
            xs[i] = copy[order[i]];
        }
    }
}

struct KeyCtx {
    keys: []u8,
    ends: []usize,
}

fn key_at(c: KeyCtx, i: usize) []u8 {
    let mut start: usize = 0;
    if i > 0 {
        start = c.ends[i - 1];
    }
    return c.keys[start..c.ends[i]];
}

fn key_less(c: KeyCtx, a: usize, b: usize) bool {
    return strs.compare(key_at(c, a), key_at(c, b)) < 0;
}

/// Compares two UTF-8 texts with the default options.
pub fn compare(a: []u8, b: []u8) CollateError!i32 {
    let mut c = Collator.init(Options.default());
    defer c.deinit();
    return c.compare(a, b);
}

/// Sorts texts in place with the default options.
pub fn sort(xs: []mut []u8) CollateError!void {
    let mut c = Collator.init(Options.default());
    defer c.deinit();
    c.sort(xs)!;
}

/// The collation elements of NFD text s (S2 of UTS #10). Code points that
/// take part in a discontiguous contraction are removed from s.
fn elements(s: *mut vec.Vec.[u32], out: *mut vec.Vec.[u32]) CollateError!void {
    let mut i: usize = 0;
    while i < s.len {
        let cp = s.get(i);
        let e = lookup(cp);
        if e == 0 {
            implicit(cp, out)!;
            i += 1;
            continue;
        }
        if ((e & 0x80000000) != 0) or ((e & 1) == 0) {
            push_entry(e, out)!;
            i += 1;
            continue;
        }
        // a contraction may start here: the longest contiguous match
        let items = s.items();
        let mut seq: [8]u32 = [0; 8];
        let mut n: usize = 1;
        seq[0] = cp;
        let mut entry = e;
        let mut k = contractions_of(cp);
        while (k < t.CONTR_FIRST.len) and (t.CONTR_FIRST[k] == cp) {
            let len = @as(usize, t.CONTR_LEN[k]);
            if ((i + len) <= items.len) and (pack_seq(items[i..i + len]) == t.CONTR_SEQ[k]) {
                n = len;
                @mem_copy(seq[..n], items[i..i + n]);
                entry = t.CONTR_CE[k];
                break;  // (longest first)
            }
            k += 1;
        }
        let contiguous = n;
        // then unblocked non-starters further on that extend it
        // (discontiguous matches, S2.1.1-S2.1.3)
        let mut j = i + n;
        let mut last_ccc: u32 = 0;
        while (j < s.len) and (n < seq.len) {
            let c = s.get(j);
            let cc = unicode.combining_class(c);
            if cc == 0 {
                break;
            }
            if (last_ccc != 0) and (last_ccc >= cc) {
                j += 1;  // blocked
                continue;
            }
            seq[n] = c;
            let found = find_contraction(seq[..n + 1]);
            if found < t.CONTR_FIRST.len {
                n += 1;
                entry = t.CONTR_CE[found];
                _ = s.remove(j);
                continue;
            }
            last_ccc = cc;
            j += 1;
        }
        push_entry(entry, out)!;
        i += contiguous;  // (the discontiguous ones were removed)
    }
}

/// The sort key of collation elements (S3 and S4 of UTS #10).
fn key_from(ces: []u32, opts: Options, out: *mut strs.String) CollateError!void {
    let shifted = opts.alternate == Alternate.SHIFTED;
    let mut levels = @as(u32, @int_from_enum(opts.strength));
    if not shifted and (levels > 3) {
        levels = 3;
    }
    for level in @as(u32, 1)..levels + 1 {
        if level > 1 {
            out.push(0)!;
            out.push(0)!;
        }
        let mut after_variable = false;
        for ce in ces {
            let mut w: u32 = 0;
            let p = ce_primary(ce);
            if shifted and ((ce & 1) != 0) {
                // variable: only the fourth level, with its primary
                after_variable = true;
                if level == 4 {
                    w = p;
                }
            } else if shifted and (ce == 0) {
                w = 0;  // completely ignorable
            } else if shifted and (p == 0) and after_variable {
                w = 0;  // ignorable after a variable element
            } else {
                if p != 0 {
                    after_variable = false;
                }
                if level == 1 {
                    w = p;
                } else if level == 2 {
                    w = ce_secondary(ce);
                } else if level == 3 {
                    w = ce_tertiary(ce);
                } else {
                    w = 0xffff;
                }
            }
            if w != 0 {
                out.push(@truncate(u8, w >> 8))!;
                out.push(@truncate(u8, w))!;
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Tests (axiom test std/unicode/collate.ax)
// -----------------------------------------------------------------------------

import "../compress/xz.ax" as xz;
import "../fmt.ax" as fmt;
import "../io.ax" as io;
import "../os/fs.ax" as fs;

// Each line of a CollationTest file (code points in hex) must not sort
// before the one above it.
fn conformance(name: []u8, opts: Options) !usize {
    let mut p = strs.String.init();
    defer p.deinit();
    fmt.write(p.writer(), "std/unicode/collate/testdata/{}.txt.xz", [fmt.str(name)])!;
    let packed = fs.read_file(p.bytes())!;
    defer mem.free(packed);
    let text = xz.decompress(packed, 8000000)!;
    defer mem.free(text);
    let mut c = Collator.init(opts);
    defer c.deinit();
    let mut prev = strs.String.init();
    defer prev.deinit();
    let mut key = strs.String.init();
    defer key.deinit();
    let mut cps = vec.Vec.[u32].init();
    defer cps.deinit();
    let mut lines = strs.lines(text);
    let mut n: usize = 0;
    let mut bad: usize = 0;
    let mut have_prev = false;
    loop {
        let line = lines.next() catch break;
        if (line.len == 0) or (line[0] == '#') {
            continue;
        }
        cps.clear();
        let mut f = strs.fields(line);
        loop {
            let h = f.next() catch break;
            cps.push(fmt.parse_int_base.[u32](h, 16)!)!;
        }
        key.clear();
        c.sort_key_cps(cps.items(), &mut key)!;
        if have_prev and (strs.compare(prev.bytes(), key.bytes()) > 0) {
            if bad < 5 {
                io.stderr().write_all("out of order: ") catch {};
                io.stderr().write_all(line) catch {};
                io.stderr().write_all("\n") catch {};
            }
            bad += 1;
        }
        prev.clear();
        prev.push_str(key.bytes())!;
        have_prev = true;
        n += 1;
    }
    @expect(n > 100000);
    return bad;
}

test "UCA conformance: non-ignorable" {
    @expect_eq(conformance("CollationTest_NON_IGNORABLE_SHORT", Options.default())!, 0);
}

test "UCA conformance: shifted" {
    let o = Options.{ strength: Strength.QUATERNARY, alternate: Alternate.SHIFTED };
    @expect_eq(conformance("CollationTest_SHIFTED_SHORT", o)!, 0);
}

test "comparing and sorting" {
    @expect_eq(compare("Äpfel", "apple")!, -1);  // f before p: the umlaut matters less
    @expect_eq(compare("cote", "côte")!, -1);
    @expect_eq(compare("côte", "coté")!, 1);  // accents compare from the start
    @expect_eq(compare("a", "A")!, -1);       // lower case first at the third level
    @expect_eq(compare("résumé", "résumé")!, 0);
    @expect_eq(compare("e\u{301}", "\u{e9}")!, 0);  // canonically equivalent
    @expect_eq(compare("9", "a")!, -1);
    @expect_eq(compare("z", "\u{4e00}")!, -1);  // letters before ideographs
    let mut c = Collator.init(Options.{ strength: Strength.PRIMARY, alternate: Alternate.NON_IGNORABLE });
    defer c.deinit();
    @expect(c.equal("Resume", "résumé")!);
    @expect(not c.equal("resume", "resumes")!);
    // SHIFTED ignores punctuation and spaces until the fourth level
    let mut sh = Collator.init(Options.{ strength: Strength.TERTIARY, alternate: Alternate.SHIFTED });
    defer sh.deinit();
    @expect(sh.equal("black-bird", "blackbird")!);
    @expect(sh.equal("black bird", "blackbird")!);
    @expect(not c.equal("black-bird", "blackbird")!);
    let mut words: [8][]u8 = ["banana", "Äpfel", "apple", "Apple", "zebra", "\u{e9}clair", "eclair", "10"];
    sort(words[..])!;
    let want: [8][]u8 = ["10", "Äpfel", "apple", "Apple", "banana", "eclair", "\u{e9}clair", "zebra"];
    for i in @as(usize, 0)..8 {
        @expect_eq(words[i], want[i]);
    }
    // invalid UTF-8 sorts as U+FFFD
    @expect_eq(compare("a\xffb", "a\u{fffd}b")!, 0);
    @expect_eq(version(), "15.1.0");
}

test "code points beyond Unicode sort as U+FFFD" {
    let mut c = Collator.init(Options.default());
    defer c.deinit();
    let bad: [2]u32 = [0x61, 0xffffffff];
    let good: [2]u32 = [0x61, 0xfffd];
    let mut k1 = strs.String.init();
    defer k1.deinit();
    let mut k2 = strs.String.init();
    defer k2.deinit();
    c.sort_key_cps(bad[..], &mut k1)!;
    c.sort_key_cps(good[..], &mut k2)!;
    @expect_eq(k1.bytes(), k2.bytes());
}
