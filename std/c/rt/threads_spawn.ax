// =============================================================================
// std/c/rt/threads_spawn.ax - the creation and end of C's threads
// (<threads.h>: thrd_create, thrd_join, thrd_detach, thrd_exit; C17
// 7.26.5) on the Axiom runtime's threads (std/thread.spawn), and what exit
// does in a program that has them. The rest of <threads.h> is threads.ax.
// On WebAssembly without the atomics extension, where a program cannot
// have threads, the C library links threads_spawn_none.ax instead (std/c/
// lib/index: its A line; cmd/axiom/src/main.ax, c_library_units).
//
// A thread's record (Spawned) holds threads.ax's CThread first (thrd_t
// points to it) and the std/thread handle. It ends (`end`) after the
// return of its start function or at thrd_exit: its tss destructors run,
// its result is stored and `done` set (which thrd_join waits for), and the
// count of running threads goes down (which thrd_exit on the main thread
// waits for). thrd_join then joins the std/thread handle (which waits
// until the thread is off its stack, and frees that), and frees the record.
// A detached thread's record is put on a list, from which the next
// thrd_create, thrd_detach or end of a thread frees those that are off
// their stacks.
//
// exit in a program with threads (core.ax's hook, set at the first
// thrd_create): the first thread to call exit runs the atexit functions
// and the rest; another thread that calls exit then waits for the end,
// which the host brings about from whichever thread asks (ax_exit, spec
// §12.8.5: on WebAssembly too).
// =============================================================================
import "../../mem.ax" as mem;
import "../../thread.ax" as thread;
import "core.ax" as core;
import "threads.ax" as th;

extern "C" {
    // std/c/lib/threads/__axc_thrd_call.c: func(arg), its int as i64
    fn __axc_thrd_call(func: fn(*mut void) i64, arg: *mut void) i64;
}

struct Spawned {
    rec: th.CThread,  // (first: thrd_t points to it)
    func: fn(*mut void) i64,
    arg: *mut void,
    handle: thread.Thread.[*mut Spawned],
    ready: u32,   // 1 once handle is set (the thread may run before)
    joined: u32,  // 1 once thrd_join or thrd_detach has it
    next: *mut Spawned,
}

// the threads thrd_create started that have not ended
let mut running: u32 = 0;
// detached threads not yet freed, and its lock (threads.ax's lock word)
let mut detached: *mut Spawned = @ptr_from_int(*mut Spawned, 0);
let mut ndetached: u32 = 0;
let mut detached_lock: u32 = 0;

fn null_spawned() *mut Spawned {
    return @ptr_from_int(*mut Spawned, 0);
}

fn run(s: *mut Spawned) void {
    th.cur = &mut s.rec;
    let r = __axc_thrd_call(s.func, s.arg);
    end(s, r);
}

// What ends a thread of thrd_create (7.26.5.5, 7.26.6.1).
fn end(s: *mut Spawned, res: i64) void {
    th.run_dtors();
    s.rec.result = res;
    @atomic_store(&mut s.rec.done, 1);
    _ = @atomic_notify(&s.rec.done, 0xFFFF_FFFF);
    reap();
    // (after this the record may be gone: a detached one's is freed once
    // the thread is off its stack)
    if @atomic_sub(&mut running, 1) == 1 {
        _ = @atomic_notify(&running, 0xFFFF_FFFF);
    }
}

// Frees the detached threads that are off their stacks.
fn reap() void {
    if @atomic_load(&ndetached) == 0 {
        return;
    }
    _ = th.acquire(&mut detached_lock, -1);
    let mut prev = null_spawned();
    let mut s = detached;
    while @int_from_ptr(s) != 0 {
        let next = s.next;
        if (@atomic_load(&s.ready) != 0) and s.handle.is_finished() {
            if @int_from_ptr(prev) == 0 {
                detached = next;
            } else {
                prev.next = next;
            }
            _ = @atomic_sub(&mut ndetached, 1);
            s.handle.join();
            mem.destroy(s);
        } else {
            prev = s;
        }
        s = next;
    }
    th.release(&mut detached_lock);
}

/// thrd_create (7.26.5.1): starts func(arg) on a new thread, whose record
/// goes to *out. thrd_nomem without memory, thrd_error if the runtime could
/// not start it.
export fn __axc_thrd_spawn(func: fn(*mut void) i64, arg: *mut void, out: *mut *mut th.CThread) i64 {
    reap();
    core.thread_hooks(exit_begin);
    let s = mem.new.[Spawned]() catch {
        return th.NOMEM;
    };
    s.rec = th.CThread.{ result: 0, done: 0, spawned: true };
    s.func = func;
    s.arg = arg;
    s.ready = 0;
    s.joined = 0;
    s.next = null_spawned();
    _ = @atomic_add(&mut running, 1);
    let h = thread.spawn(run, s) catch |e| {
        _ = @atomic_sub(&mut running, 1);
        mem.destroy(s);
        if e == error.OutOfMemory {
            return th.NOMEM;
        }
        return th.ERROR;
    };
    s.handle = h;
    @atomic_store(&mut s.ready, 1);
    _ = @atomic_notify(&s.ready, 0xFFFF_FFFF);
    out.* = &mut s.rec;
    return th.SUCCESS;
}

// The thread's Spawned record, or null if thrd_create did not start it.
fn spawned_of(t: *mut th.CThread) *mut Spawned {
    if (@int_from_ptr(t) == 0) or not t.spawned {
        return null_spawned();
    }
    return @ptr_cast(*mut Spawned, t);
}

/// thrd_join (7.26.5.6): waits for the thread to end; its result in *res.
/// thrd_error for the calling thread, a detached or joined one. (The main
/// thread, joined by another after its thrd_exit: its result, and done.)
export fn __axc_thrd_join(t: *mut th.CThread, res: *mut i64) i64 {
    if (@int_from_ptr(t) == 0) or (t == th.current()) {
        return th.ERROR;
    }
    let s = spawned_of(t);
    if (@int_from_ptr(s) != 0) and (@atomic_xchg(&mut s.joined, 1) != 0) {
        return th.ERROR;
    }
    while @atomic_load(&t.done) == 0 {
        _ = th.wait(&t.done, 0, -1);
    }
    res.* = t.result;
    if @int_from_ptr(s) != 0 {
        // (thrd_current's value may reach a joiner before thrd_create has
        // returned it)
        while @atomic_load(&s.ready) == 0 {
            _ = th.wait(&s.ready, 0, -1);
        }
        s.handle.join();
        mem.destroy(s);
    }
    return th.SUCCESS;
}

/// thrd_detach (7.26.5.3): the thread's record goes when it is off its
/// stack. thrd_error for one thrd_create did not start, or one joined or
/// detached already.
export fn __axc_thrd_detach(t: *mut th.CThread) i64 {
    let s = spawned_of(t);
    if (@int_from_ptr(s) == 0) or (@atomic_xchg(&mut s.joined, 1) != 0) {
        return th.ERROR;
    }
    _ = th.acquire(&mut detached_lock, -1);
    s.next = detached;
    detached = s;
    _ = @atomic_add(&mut ndetached, 1);
    th.release(&mut detached_lock);
    reap();
    return th.SUCCESS;
}

/// thrd_exit (7.26.5.5): ends the calling thread with result res, after its
/// destructors. On the main thread (which no std/thread.spawn started) it
/// returns once every thread thrd_create started has ended, and the C side
/// then calls exit(EXIT_SUCCESS).
export fn __axc_thrd_exit(res: i64) void {
    let t = th.current();
    let s = spawned_of(t);
    if @int_from_ptr(s) != 0 {
        end(s, res);
        thread.exit();
    }
    th.run_dtors();
    t.result = res;
    @atomic_store(&mut t.done, 1);
    _ = @atomic_notify(&t.done, 0xFFFF_FFFF);
    // (a thread something else started with std/thread ends here)
    thread.exit();
    loop {
        let n = @atomic_load(&running);
        if n == 0 {
            return;
        }
        _ = th.wait(&running, n, -1);
    }
}

// exit's hook (core.ax): one thread runs exit.
let mut exit_owner: u64 = 0;
let mut never: u32 = 0;

fn exit_begin() void {
    let m = th.me();
    let o = @atomic_cas(&mut exit_owner, 0, m);
    if (o == 0) or (o == m) {
        return;
    }
    loop {
        _ = th.wait(&never, 0, -1);
    }
}
