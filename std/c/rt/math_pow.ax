// =============================================================================
// std/c/rt/math_pow.ax - pow, sqrt, cbrt and hypot (7.12.7, F.10.4)
// of the C library: the kernels of std/internal/math/pow.ax, with the
// library's errors (math.ax).
// =============================================================================
import "../../internal/math/pow.ax" as k;
import "math.ax" as c;

export fn pow(x: f64, y: f64) f64 @multiversion("fma") {
    return k.pow(x, y, c.rep());
}

export fn sqrt(x: f64) f64 {
    return k.sqrt(x, c.rep());
}

export fn cbrt(x: f64) f64 @multiversion("fma") {
    return k.cbrt(x);
}

export fn hypot(x: f64, y: f64) f64 @multiversion("fma") {
    return k.hypot(x, y, c.rep());
}
