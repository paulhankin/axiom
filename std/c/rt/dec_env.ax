// =============================================================================
// std/c/rt/dec_env.ax - the decimal floating-point environment of a C
// program's thread (C23 7.6): the dynamic decimal rounding direction, which
// fe_dec_setround sets (decimal operations read it: decimal.ax's `dec_`
// functions), and the exception flags decimal operations have raised that
// <fenv.h> has not yet merged into the hardware's flags (fe_raw.c reads them
// through dfp.ax: __axc_dec_flags, and clears them once it has).
//
// The rounding directions are decimal.ax's R_ numbers (<fenv.h>'s
// FE_DEC_TONEAREST ... are the same numbers), the flags <fenv.h>'s FE_
// values.
// =============================================================================

/// The decimal rounding direction of this thread (decimal.ax R_NEAREST ...).
pub threadlocal let mut g_round: u32 = 0;

/// The exception flags raised by decimal operations on this thread since
/// <fenv.h> last merged them (FE_INVALID ...).
pub threadlocal let mut g_flags: u32 = 0;

/// Raises the flags f (no trap: they are recorded).
pub fn raise(f: u32) void {
    if f != 0 {
        g_flags = g_flags | f;
    }
}
