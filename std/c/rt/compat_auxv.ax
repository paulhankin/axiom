// =============================================================================
// std/c/rt/compat_auxv.ax - __getauxval, the system interface of Linux
// programs through which code of the platform's toolchain (its compiler's
// run-time library: AArch64's choice of atomic instructions) reads the
// auxiliary vector the kernel passed the program: as the Linux Standard
// Base specifies getauxval, an entry of that vector (AT_HWCAP, ...), or 0
// if there is none. Defined here so that such code links with the
// compiler's C library, statically or not (docs/c.md, "Objects and
// libraries of other compilers").
// =============================================================================

extern "C" {
    fn ax_start_sp() usize;  // (cmd/axiom/src/lstub.ax: the stack pointer at entry)
}

/// Entry `kind` of the auxiliary vector (after the arguments and the
/// environment on the start-up stack), or 0.
export fn __getauxval(kind: u64) u64 {
    if not @target_os("linux") {
        return 0;
    }
    let sp = ax_start_sp();
    if sp == 0 {
        return 0;
    }
    let argc = @ptr_from_int(*usize, sp).*;
    let mut e = sp + ((argc + 2) * 8);
    while @ptr_from_int(*usize, e).* != 0 {
        e += 8;
    }
    e += 8;
    loop {
        let k = @ptr_from_int(*u64, e).*;
        if k == 0 {
            return 0;
        }
        if k == kind {
            return @ptr_from_int(*u64, e + 8).*;
        }
        e += 16;
    }
}
