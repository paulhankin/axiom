// =============================================================================
// std/c/rt/text.ax - the Unicode properties of the C library's <wctype.h>
// (std/c/lib/text/), from the standard library's Unicode tables
// (std/unicode/tables, which std/unicode reads).
//
// The wide character classes of a UTF-8 locale (docs/c-text.md, "Wide
// character classes"), as bits (axc/text.h's __AXC_W_*):
//
//     cntrl   general category Cc, Cf, Zl or Zp
//     print   not cntrl, and assigned (not Cn), not a surrogate (Cs), not
//             private use (Co)
//     space   White_Space
//     blank   space, and Zs or U+0009
//     digit   '0' to '9' (C17 7.30.2.1.5: the decimal digits only)
//     xdigit  '0' to '9', 'a' to 'f', 'A' to 'F' (7.30.2.1.12)
//     upper   Uppercase, print and not space
//     lower   Lowercase, print and not space
//     alpha   Alphabetic, upper or lower, print, not space, not digit
//     alnum   alpha or digit
//     graph   print and not space
//     punct   graph and not alnum
//
// so that the classes relate as C17 7.30.2.1 requires (alpha holds upper
// and lower and none of cntrl, digit, punct, space; punct is print and
// neither space nor alnum; graph is print and not space).
// =============================================================================

import "std/unicode/tables" as t;

const ALNUM: u32 = 0x001;
const ALPHA: u32 = 0x002;
const BLANK: u32 = 0x004;
const CNTRL: u32 = 0x008;
const DIGIT: u32 = 0x010;
const GRAPH: u32 = 0x020;
const LOWER: u32 = 0x040;
const PRINT: u32 = 0x080;
const PUNCT: u32 = 0x100;
const SPACE: u32 = 0x200;
const UPPER: u32 = 0x400;
const XDIGIT: u32 = 0x800;

// The classes of a property record of std/unicode/tables (they depend on
// its general category, White_Space, Alphabetic, Uppercase and Lowercase
// only), computed the first time they are needed: per_record[i] is the
// classes of t.RECORDS[i] (digit and xdigit, which only ASCII characters
// have, aside).
let mut per_record: [1024]u16 = [0; 1024];
let mut records_state: u32 = 0;  // 0 not computed, 1 being computed, 2 computed

// The runs of t.RUN_START by blocks of 256 code points, computed with
// per_record: run_index[k] is the last run that begins at or before
// k * 256, so that a code point's run is found among the few of its block.
let mut run_index: [4353]u16 = [0; 4353];

fn field(r: u64, off: u32, bits: u32) u32 {
    return @truncate(u32, (r >> @as(u64, off)) & ((@as(u64, 1) << @as(u64, bits)) - 1));
}

fn record_classes(r: u64) u32 {
    let gc = field(r, t.F_GC, t.W_GC);
    let mut k: u32 = 0;
    if (gc == t.GC_CC) or (gc == t.GC_CF) or (gc == t.GC_ZL) or (gc == t.GC_ZP) {
        k |= CNTRL;
    } else if (gc != t.GC_CN) and (gc != t.GC_CS) and (gc != t.GC_CO) {
        k |= PRINT;
    }
    if field(r, t.F_WHITE, 1) == 1 {
        k |= SPACE;
        if gc == t.GC_ZS {
            k |= BLANK;
        }
    }
    if (k & (PRINT | SPACE)) == PRINT {
        k |= GRAPH;
        if field(r, t.F_UPPER, 1) == 1 {
            k |= UPPER;
        }
        if field(r, t.F_LOWER, 1) == 1 {
            k |= LOWER;
        }
        if ((k & (UPPER | LOWER)) != 0) or (field(r, t.F_ALPHA, 1) == 1) {
            k |= ALPHA | ALNUM;
        } else {
            k |= PUNCT;
        }
    }
    return k;
}

fn compute_records() void {
    if @atomic_load(&records_state) == 2 {
        return;
    }
    if @atomic_cas(&mut records_state, 0, 1) == 0 {
        let n = @min(t.RECORDS.len, per_record.len);
        for i in 0..n {
            per_record[i] = @truncate(u16, record_classes(t.RECORDS[i]));
        }
        let mut r: usize = 0;
        for k in 0..run_index.len {
            let start = @truncate(u32, k) << 8;
            while ((r + 1) < t.RUN_START.len) and (t.RUN_START[r + 1] <= start) {
                r += 1;
            }
            run_index[k] = @truncate(u16, r);
        }
        @atomic_store(&mut records_state, 2);
        _ = @atomic_notify(&records_state, 0xFFFF_FFFF);
        return;
    }
    while @atomic_load(&records_state) != 2 {
        _ = @atomic_wait(&records_state, 1, -1);
    }
}

// The index in t.RECORDS of c's record (as std/unicode finds it), at most
// U+10FFFF, once compute_records has run.
fn record_of(c: u32) usize {
    if c < t.LOW_LIMIT {
        return @as(usize, t.LOW[@as(usize, c)]);
    }
    let runs = t.RUN_START[..];
    let b = @as(usize, c >> 8);
    let mut lo = @as(usize, run_index[b]);
    let mut hi = @min(@as(usize, run_index[b + 1]) + 1, runs.len);
    while (hi - lo) > 1 {
        let mid = (lo + hi) / 2;
        if runs[mid] <= c {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    return @as(usize, t.RUN_RECORD[lo]);
}

/// The wide character classes of code point c by Unicode's properties
/// (above); none beyond U+10FFFF.
export fn __axc_wclass_unicode(cp: u64) u64 {
    if cp > 0x10FFFF {
        return 0;
    }
    let c = @truncate(u32, cp);
    compute_records();
    let i = record_of(c);
    if i >= per_record.len {
        return 0;
    }
    let mut r = @as(u32, per_record[i]);
    if c == 9 {
        r |= BLANK;
    }
    if (c >= '0') and (c <= '9') {
        // (not Alphabetic: alnum by digit)
        r = (r & ~PUNCT) | DIGIT | XDIGIT | ALNUM;
    } else if ((c >= 'a') and (c <= 'f')) or ((c >= 'A') and (c <= 'F')) {
        r |= XDIGIT;
    }
    return @as(u64, r);
}

// The value that `from` (increasing) maps c to by `to`, or c itself (the
// simple case mappings of std/unicode/tables).
fn mapped(from: []u32, to: []u32, c: u32) u32 {
    let mut lo: usize = 0;
    let mut hi = from.len;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if from[mid] < c {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if (lo < from.len) and (from[lo] == c) {
        return to[lo];
    }
    return c;
}

/// The simple uppercase mapping of c (c itself if it has none), as
/// std/unicode's to_upper.
export fn __axc_wupper_unicode(c: u64) u64 {
    if c > 0x10FFFF {
        return c;
    }
    return @as(u64, mapped(t.UPPER_FROM[..], t.UPPER_TO[..], @truncate(u32, c)));
}

/// The simple lowercase mapping of c (c itself if it has none), as
/// std/unicode's to_lower.
export fn __axc_wlower_unicode(c: u64) u64 {
    if c > 0x10FFFF {
        return c;
    }
    return @as(u64, mapped(t.LOWER_FROM[..], t.LOWER_TO[..], @truncate(u32, c)));
}
