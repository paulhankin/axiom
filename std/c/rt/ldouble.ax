// =============================================================================
// std/c/rt/ldouble.ax - C's long double where it is wider than double, in
// software: the two formats the C ABIs of our targets give it, written from
// IEEE 754-2019 (and, for the 80-bit format, the x87 data formats).
//
//   binary128 (Q)   AArch64 Linux, WebAssembly: 1 sign bit, 15 exponent bits
//                   (bias 16383), 112 fraction bits; the significand's
//                   leading bit is implicit (113 bits of precision)
//   x87 extended (X) x86-64 Linux: 1 sign bit, 15 exponent bits (bias 16383),
//                   a 64-bit significand whose leading (integer) bit is
//                   explicit, in the low 10 of 16 bytes
//
// A value is 16 bytes in memory (W: lo the first eight, hi the next eight,
// little-endian), and the operations take and return them through pointers:
// the C front end (cmd/axiom/src/c/cgen_ld.ax) calls them for C's
// arithmetic, comparisons and conversions, and folds constants with them.
// The result may be one of the operands.
//
// Every operation is correctly rounded with gradual underflow (subnormal
// results), in a rounding direction and raising IEEE 754's exceptions
// (invalid, division by zero, overflow, underflow -- a tiny inexact result,
// tininess detected after rounding, IEEE 754-2019 7.5 -- and inexact) into
// an Env. The functions without an Env argument round to nearest with ties
// to even and discard the flags: the compiler folds constants with them,
// and C code that is not under FENV_ACCESS calls them (the environment of
// such code is the default one, C23 7.6.1p2: see "The environment" below).
// NaNs: an
// invalid operation (inf - inf, 0 * inf, 0 / 0, inf / inf) gives the
// default NaN, binary128's positive quiet NaN and the x87's "real
// indefinite" (negative, significand 0xC000000000000000); otherwise a NaN
// operand is the result, quieted (binary128: a signaling operand first,
// then the first operand; x87: the operand with the larger significand).
// x87 encodings no x87 operation produces as a result (an exponent with a
// zero integer bit: unnormals, pseudo-infinities, pseudo-NaNs) are invalid
// operands, as they are to the x87 since the 80387: they give the default
// NaN; pseudo-denormals (exponent 0, integer bit 1) are read as the value
// they denote. Results are always canonical, and an x87 result's six bytes
// after the ten are zero.
//
// Conversions to integers truncate toward zero and saturate (NaN gives 0),
// as the code generator's do for float and double: the C program's
// behaviour is undefined when the value does not fit (C17 6.3.1.4).
// =============================================================================

/// A long double's 16 bytes.
pub struct W {
    lo: u64,
    hi: u64,
}

/// The formats (the `f` argument of the operations).
pub const FMT_Q: u32 = 0;  // binary128
pub const FMT_X: u32 = 1;  // x87 80-bit extended
// binary128 here; math_ld.ax's functions take it as their wide form (their
// arguments with 128-bit significands, their results before the rounding:
// math_ld.ax's TArg and TRes), for the decimal functions of _Decimal128
pub const FMT_T: u32 = 2;

const BIAS: i32 = 16383;
const MAXEF: i32 = 0x7FFF;

// A 128-bit unsigned integer.
struct U2 {
    h: u64,
    l: u64,
}

// What a value is (Un.cls).
const C_ZERO: u32 = 0;
const C_FIN: u32 = 1;
const C_INF: u32 = 2;
const C_NAN: u32 = 3;

// A value taken apart: finite and nonzero, it is s * 2^(e - 127) with s's
// bit 127 set.
struct Un {
    cls: u32,
    neg: bool,
    e: i32,
    s: U2,
    snan: bool,  // C_NAN: signaling
}

/// The format's precision in bits (113 or 64).
pub fn precision(f: u32) i32 {
    return prec(f);
}

fn prec(f: u32) i32 {
    if f == FMT_X {
        return 64;
    }
    return 113;
}

// -----------------------------------------------------------------------------
// The environment: a rounding direction, and the exceptions raised
//
// C code under FENV_ACCESS ON, or in the scope of a static FENV_ROUND
// direction (cmd/axiom/src/c/cgen_ld.ax: ir.Func's strict_fp), calls the
// `e_` functions below, which take the floating-point environment's
// register (MXCSR on x86-64; FPCR, and FPSR in the high half, on AArch64:
// the word ir.IN_FPENV_GET writes), round in its direction and OR the flags
// they raise into it, for ir.IN_FPENV_SET. Other C code calls the functions
// without an Env, which round to nearest and raise nothing: that is exact,
// not an approximation, because code translated with FENV_ACCESS OFF runs
// in the default mode (to nearest) or the program's behaviour is undefined,
// and its flags may not be tested (C23 7.6.1p2; the optimizer folds and
// removes float and double operations of such code just as freely).
// -----------------------------------------------------------------------------

/// The rounding directions (in the order of x86-64's MXCSR.RC).
pub const RN: u32 = 0;  // to nearest, ties to even
pub const RD: u32 = 1;  // toward -infinity
pub const RU: u32 = 2;  // toward +infinity
pub const RZ: u32 = 3;  // toward zero

/// The exception flags (the bits of <fenv.h>'s FE_ values, MXCSR's).
pub const X_INVALID: u32 = 0x01;
pub const X_DIVBYZERO: u32 = 0x04;
pub const X_OVERFLOW: u32 = 0x08;
pub const X_UNDERFLOW: u32 = 0x10;
pub const X_INEXACT: u32 = 0x20;

/// The kinds of environment register (cmd/axiom/src/c/csema_fp.ax's
/// __builtin_axiom_fenv_kind).
pub const K_NONE: u32 = 0;
pub const K_X64: u32 = 1;
pub const K_A64: u32 = 2;

/// A rounding direction, and the flags raised so far.
pub struct Env {
    mode: u32,
    flags: u32,
}

/// To nearest, no flags.
pub fn env_nearest() Env {
    return Env.{ mode: RN, flags: 0 };
}

/// The environment of register value v (of kind k).
pub fn env_of(v: u64, k: u32) Env {
    if k == K_X64 {
        return Env.{ mode: @truncate(u32, (v >> 13) & 3), flags: 0 };
    }
    if k == K_A64 {
        // (FPCR.RMode: 0 nearest, 1 toward +inf, 2 toward -inf, 3 toward zero)
        let m = @truncate(u32, (v >> 22) & 3);
        if (m == 1) or (m == 2) {
            return Env.{ mode: m ^ 3, flags: 0 };
        }
        return Env.{ mode: m, flags: 0 };
    }
    return env_nearest();
}

/// Register value v (of kind k) with the flags of c raised.
pub fn env_raise(v: u64, k: u32, c: Env) u64 {
    let f = @as(u64, c.flags);
    if k == K_X64 {
        return v | f;
    }
    if k == K_A64 {
        // (FPSR: IOC DZC OFC UFC IXC in bits 0-4)
        return v | (((f & 1) | ((f >> 1) & 0x1E)) << 32);
    }
    return v;
}

// The environment of the register word at ev, and the flags of c into it.
fn ein(ev: *u64, k: u32) Env {
    return env_of(ev.*, k);
}

fn eout(ev: *mut u64, k: u32, c: Env) void {
    ev.* = env_raise(ev.*, k, c);
}

// Does a value that rounding drops `half` (the first bit dropped) and
// `rest` (any below it) from, with an odd last bit kept (odd), round up in
// magnitude in direction `mode` (the value negative: neg)?
fn rounds_up(mode: u32, neg: bool, half: bool, rest: bool, odd: bool) bool {
    if mode == RN {
        return half and (rest or odd);
    }
    if (mode == RZ) or not (half or rest) {
        return false;
    }
    return neg == (mode == RD);
}

// Does an overflow give an infinity (not the largest finite value)?
fn overflows_to_inf(mode: u32, neg: bool) bool {
    if mode == RN {
        return true;
    }
    if mode == RZ {
        return false;
    }
    return neg == (mode == RD);
}

// -----------------------------------------------------------------------------
// 128-bit integers
// -----------------------------------------------------------------------------

fn u2(h: u64, l: u64) U2 {
    return U2.{ h: h, l: l };
}

fn is0(a: U2) bool {
    return (a.h | a.l) == 0;
}

fn shl(a: U2, n: u32) U2 {
    if n == 0 {
        return a;
    }
    if n >= 128 {
        return u2(0, 0);
    }
    if n >= 64 {
        return u2(a.l << (n - 64), 0);
    }
    return u2((a.h << n) | (a.l >> (64 - n)), a.l << n);
}

fn shr(a: U2, n: u32) U2 {
    if n == 0 {
        return a;
    }
    if n >= 128 {
        return u2(0, 0);
    }
    if n >= 64 {
        return u2(0, a.h >> (n - 64));
    }
    return u2(a.h >> n, (a.l >> n) | (a.h << (64 - n)));
}

// Are any of a's bits below bit n set?
fn low_set(a: U2, n: u32) bool {
    if n == 0 {
        return false;
    }
    if n >= 128 {
        return not is0(a);
    }
    return not is0(shl(a, 128 - n));
}

// a >> n, with the bits shifted out ORed into bit 0 (a sticky bit).
fn shr_jam(a: U2, n: u32) U2 {
    let r = shr(a, n);
    if low_set(a, n) {
        return u2(r.h, r.l | 1);
    }
    return r;
}

fn add2(a: U2, b: U2) U2 {
    let l = a.l +% b.l;
    let mut c: u64 = 0;
    if l < a.l {
        c = 1;
    }
    return u2((a.h +% b.h) +% c, l);
}

fn sub2(a: U2, b: U2) U2 {
    let l = a.l -% b.l;
    let mut c: u64 = 0;
    if a.l < b.l {
        c = 1;
    }
    return u2((a.h -% b.h) -% c, l);
}

fn lt2(a: U2, b: U2) bool {
    return (a.h < b.h) or ((a.h == b.h) and (a.l < b.l));
}

fn clz2(a: U2) u32 {
    if a.h != 0 {
        return @truncate(u32, @clz(a.h));
    }
    if a.l != 0 {
        return 64 + @truncate(u32, @clz(a.l));
    }
    return 128;
}

// The 128-bit product of two 64-bit integers.
fn mul64(a: u64, b: u64) U2 {
    let m: u64 = 0xFFFF_FFFF;
    let a0 = a & m;
    let a1 = a >> 32;
    let b0 = b & m;
    let b1 = b >> 32;
    let p00 = a0 *% b0;
    let p01 = a0 *% b1;
    let p10 = a1 *% b0;
    let p11 = a1 *% b1;
    let mid = ((p00 >> 32) +% (p01 & m)) +% (p10 & m);
    let lo = (p00 & m) | (mid << 32);
    let hi = ((p11 +% (p01 >> 32)) +% (p10 >> 32)) +% (mid >> 32);
    return u2(hi, lo);
}

// -----------------------------------------------------------------------------
// Taking apart and putting together
// -----------------------------------------------------------------------------

fn un_zero(neg: bool) Un {
    return Un.{ cls: C_ZERO, neg: neg, e: 0, s: u2(0, 0), snan: false };
}

fn un_cls(c: u32, neg: bool) Un {
    return Un.{ cls: c, neg: neg, e: 0, s: u2(0, 0), snan: false };
}

// An x87 encoding that is no value: an invalid operand, which signals as a
// signaling NaN does.
fn un_invalid() Un {
    return Un.{ cls: C_NAN, neg: false, e: 0, s: u2(0, 0), snan: true };
}

// A finite value m * 2^(ef - BIAS - (p - 1)) (m nonzero, at most 128 bits)
// taken apart.
fn un_fin(neg: bool, ef: i32, m: U2, p: i32) Un {
    let z = clz2(m);
    let e = ((ef - BIAS) - (p - 1)) - @bit_cast(i32, z) + 127;
    return Un.{ cls: C_FIN, neg: neg, e: e, s: shl(m, z), snan: false };
}

fn unpack(a: *W, f: u32) Un {
    if f == FMT_X {
        let ef = @bit_cast(i32, @truncate(u32, a.hi & 0x7FFF));
        let neg = (a.hi & 0x8000) != 0;
        let m = a.lo;
        let j = (m >> 63) != 0;
        if ef == MAXEF {
            if not j {
                return un_invalid();  // (pseudo-infinity or pseudo-NaN)
            }
            if (m << 1) == 0 {
                return un_cls(C_INF, neg);
            }
            let mut n = un_cls(C_NAN, neg);
            n.snan = ((m >> 62) & 1) == 0;
            return n;
        }
        if ef == 0 {
            if m == 0 {
                return un_zero(neg);
            }
            return un_fin(neg, 1, u2(0, m), 64);  // (a denormal or pseudo-denormal)
        }
        if not j {
            return un_invalid();  // (an unnormal)
        }
        return un_fin(neg, ef, u2(0, m), 64);
    }
    let ef = @bit_cast(i32, @truncate(u32, (a.hi >> 48) & 0x7FFF));
    let neg = (a.hi >> 63) != 0;
    let fr = u2(a.hi & 0xFFFF_FFFF_FFFF, a.lo);
    if ef == MAXEF {
        if is0(fr) {
            return un_cls(C_INF, neg);
        }
        let mut n = un_cls(C_NAN, neg);
        n.snan = ((fr.h >> 47) & 1) == 0;
        return n;
    }
    if ef == 0 {
        if is0(fr) {
            return un_zero(neg);
        }
        return un_fin(neg, 1, fr, 113);
    }
    return un_fin(neg, ef, u2(fr.h | (@as(u64, 1) << 48), fr.l), 113);
}

// The P-bit significand m with biased exponent ef of a rounded value.
struct Rd {
    ef: i32,
    m: U2,
}

// (-1)^neg s * 2^(e - 127) (s nonzero: normalized here) rounded to p bits in
// c's direction, for a format with exponent bias `bias` and largest
// exponent field `maxef` (that of infinities): ef is maxef for an overflow
// to infinity (m 0), 0 for a subnormal (or zero) result; the flags into c.
// `sticky`: the value is a little more than s * 2^(e - 127) in magnitude.
fn round(neg: bool, e0: i32, s0: U2, sticky: bool, p: i32, bias: i32, maxef: i32, c: *mut Env) Rd {
    let z = clz2(s0);
    let s = shl(s0, z);
    let e = e0 - @bit_cast(i32, z);
    let ef0 = e + bias;
    let mut ef = ef0;
    let mut drop = 128 - p;
    if ef < 1 {
        // (subnormal: fewer bits are kept)
        let extra = 1 - ef;
        if extra > 200 {
            drop = 200 + drop;
        } else {
            drop = drop + extra;
        }
        ef = 0;
    }
    let d = @bit_cast(u32, drop);
    let mut m = shr(s, d);
    let half = (shr(s, d - 1).l & 1) != 0;
    let rest = low_set(s, d - 1) or sticky;
    if rounds_up(c.mode, neg, half, rest, (m.l & 1) != 0) {
        m = add2(m, u2(0, 1));
    }
    let top = shl(u2(0, 1), @bit_cast(u32, p - 1));
    if ef == 0 {
        if not lt2(m, top) {
            ef = 1;  // (rounded up to the smallest normal value)
        }
    } else if not lt2(m, shl(top, 1)) {
        m = shr(m, 1);
        ef += 1;
    }
    if half or rest {
        c.flags = c.flags | X_INEXACT;
        // tiny: below 2^emin once rounded to p bits with an unbounded
        // exponent (IEEE 754-2019 7.5; only a value whose leading bit is
        // 2^(emin - 1) can round up to 2^emin)
        let mut tiny = ef0 < 0;
        if ef0 == 0 {
            let d2 = @bit_cast(u32, 128 - p);
            let m2 = shr(s, d2);
            let up = rounds_up(c.mode, neg, (shr(s, d2 - 1).l & 1) != 0, low_set(s, d2 - 1) or sticky, (m2.l & 1) != 0);
            let all_ones = sub2(shl(top, 1), u2(0, 1));
            tiny = not (up and (m2.h == all_ones.h) and (m2.l == all_ones.l));
        }
        if tiny {
            c.flags = c.flags | X_UNDERFLOW;
        }
    }
    if ef >= maxef {
        c.flags = c.flags | (X_OVERFLOW | X_INEXACT);
        if overflows_to_inf(c.mode, neg) {
            return Rd.{ ef: maxef, m: u2(0, 0) };
        }
        return Rd.{ ef: maxef - 1, m: sub2(shl(top, 1), u2(0, 1)) };
    }
    return Rd.{ ef: ef, m: m };
}

/// A value rounded to a binary format: its biased exponent and significand
/// (ldouble.ax's round: ef = maxef for an infinity).
pub struct Bin {
    ef: i32,
    mh: u64,
    ml: u64,
}

/// (-1)^neg (h:l) 2^(e - 127) (h:l nonzero; a little more in magnitude if
/// sticky) rounded to a binary format of p bits of precision, exponent
/// bias `bias` and largest exponent field `maxef`, in c's direction,
/// raising into c (decimal.ax's conversions to binary formats).
pub fn round_bin(neg: bool, e: i32, h: u64, l: u64, sticky: bool, p: i32, bias: i32, maxef: i32, c: *mut Env) Bin {
    let d = round(neg, e, u2(h, l), sticky, p, bias, maxef, c);
    return Bin.{ ef: d.ef, mh: d.m.h, ml: d.m.l };
}

fn put(r: *mut W, lo: u64, hi: u64) void {
    r.lo = lo;
    r.hi = hi;
}

fn sgn(neg: bool, bit: u32) u64 {
    if neg {
        return @as(u64, 1) << bit;
    }
    return 0;
}

// A rounded value of format f into r.
fn pack(r: *mut W, neg: bool, d: Rd, f: u32) void {
    let ef = @as(u64, @bit_cast(u32, d.ef));
    if f == FMT_X {
        let mut m = d.m.l;
        if d.ef == MAXEF {
            m = @as(u64, 1) << 63;
        }
        put(r, m, sgn(neg, 15) | ef);
        return;
    }
    put(r, d.m.l, (sgn(neg, 63) | (ef << 48)) | (d.m.h & 0xFFFF_FFFF_FFFF));
}

fn pack_zero(r: *mut W, neg: bool, f: u32) void {
    if f == FMT_X {
        put(r, 0, sgn(neg, 15));
        return;
    }
    put(r, 0, sgn(neg, 63));
}

fn pack_inf(r: *mut W, neg: bool, f: u32) void {
    if f == FMT_X {
        put(r, @as(u64, 1) << 63, sgn(neg, 15) | 0x7FFF);
        return;
    }
    put(r, 0, sgn(neg, 63) | (@as(u64, 0x7FFF) << 48));
}

// The default NaN (of an invalid operation).
fn pack_dnan(r: *mut W, f: u32) void {
    if f == FMT_X {
        put(r, 0xC000_0000_0000_0000, 0xFFFF);
        return;
    }
    put(r, 0, 0x7FFF_8000_0000_0000);
}

// NaN a (of format f) quieted, canonical.
fn quiet(r: *mut W, a: *W, f: u32) void {
    if f == FMT_X {
        put(r, a.lo | 0xC000_0000_0000_0000, a.hi & 0xFFFF);
        return;
    }
    put(r, a.lo, a.hi | 0x0000_8000_0000_0000);
}

// An exact or rounded finite result (s * 2^(e - 127), sticky) of format f.
fn finish(r: *mut W, neg: bool, e: i32, s: U2, sticky: bool, f: u32, c: *mut Env) void {
    pack(r, neg, round(neg, e, s, sticky, prec(f), BIAS, MAXEF, c), f);
}

// The default NaN, and "invalid".
fn invalid(r: *mut W, f: u32, c: *mut Env) void {
    c.flags = c.flags | X_INVALID;
    pack_dnan(r, f);
}

// The result of an operation with a NaN operand (a or b; ua and ub taken
// apart), as the format's rule says.
fn nan_result(r: *mut W, a: *W, ua: Un, b: *W, ub: Un, f: u32, c: *mut Env) void {
    let an = ua.cls == C_NAN;
    let bn = ub.cls == C_NAN;
    if (an and ua.snan) or (bn and ub.snan) {
        c.flags = c.flags | X_INVALID;
    }
    if f == FMT_X {
        // (an invalid encoding is no NaN of its own: the default one)
        let ai = an and not (((a.hi & 0x7FFF) == 0x7FFF) and ((a.lo >> 63) != 0));
        let bi = bn and not (((b.hi & 0x7FFF) == 0x7FFF) and ((b.lo >> 63) != 0));
        if ai or bi {
            pack_dnan(r, f);
            return;
        }
        if an and bn {
            // a quiet NaN before a signaling one; of two of a kind, the
            // larger significand, and of equal ones the positive one
            let mut pick_b = false;
            if ua.snan != ub.snan {
                pick_b = ua.snan;
            } else if a.lo != b.lo {
                pick_b = b.lo > a.lo;
            } else {
                pick_b = ua.neg;
            }
            if pick_b {
                quiet(r, b, f);
            } else {
                quiet(r, a, f);
            }
            return;
        }
        if an {
            quiet(r, a, f);
        } else {
            quiet(r, b, f);
        }
        return;
    }
    if an and ua.snan {
        quiet(r, a, f);
    } else if bn and ub.snan {
        quiet(r, b, f);
    } else if an {
        quiet(r, a, f);
    } else {
        quiet(r, b, f);
    }
}

// -----------------------------------------------------------------------------
// Arithmetic
// -----------------------------------------------------------------------------

/// r = a + b.
pub fn add(r: *mut W, a: *W, b: *W, f: u32) void {
    if f == FMT_X {
        if fast_add_x(r, a, b, 0) {
            return;
        }
    } else if fast_add_q(r, a, b, 0) {
        return;
    }
    let mut c = env_nearest();
    addsub(r, a, b, false, f, &mut c);
}

/// r = a - b.
pub fn sub(r: *mut W, a: *W, b: *W, f: u32) void {
    if f == FMT_X {
        if fast_add_x(r, a, b, 0x8000) {
            return;
        }
    } else if fast_add_q(r, a, b, 0x8000_0000_0000_0000) {
        return;
    }
    let mut c = env_nearest();
    addsub(r, a, b, true, f, &mut c);
}

// -----------------------------------------------------------------------------
// Fast paths: the x87 format's +, -, * and / to nearest (the functions
// without an Env) of normal operands with a normal result, in 64-bit
// integers on the 64-bit significands, without taking the operands apart
// into Un or the general rounding; anything else (zeros, subnormals,
// infinities, NaNs, invalid encodings, a result that overflows or is
// subnormal) is left to the general code, which these agree with bit for
// bit.
// -----------------------------------------------------------------------------

// Is the x87 encoding (sign and exponent field se, significand m) a normal
// number: exponent field 1 .. 0x7FFE and the integer bit set?
inline fn x_normal(se: u64, m: u64) bool {
    return (((se & 0x7FFF) -% 1) < 0x7FFE) and ((m >> 63) != 0);
}

// The significand hi with the 64 bits below it in lo (and, below those,
// something nonzero if sticky), rounded to nearest with ties to even, and
// put with sign and exponent field se into r; false (r untouched) if the
// rounded exponent field leaves 1 .. 0x7FFE.
inline fn put_x(r: *mut W, se: u64, hi: u64, lo: u64, sticky: bool) bool {
    let mut m = hi;
    let mut e = se & 0x7FFF;
    if ((lo >> 63) != 0) and ((((lo << 1) != 0) or sticky) or ((m & 1) != 0)) {
        m = m +% 1;
        if m == 0 {
            m = @as(u64, 1) << 63;
            e += 1;
        }
    }
    if (e -% 1) >= 0x7FFE {
        return false;
    }
    r.lo = m;
    r.hi = (se & 0x8000) | e;
    return true;
}

// r = a + b (b's sign flipped by nb: 0 or 0x8000), if the fast path applies.
fn fast_add_x(r: *mut W, a: *W, b: *W, nb: u64) bool {
    let mut sa = a.hi & 0xFFFF;
    let mut sb = (b.hi & 0xFFFF) ^ nb;
    let mut ma = a.lo;
    let mut mb = b.lo;
    if not (x_normal(sa, ma) and x_normal(sb, mb)) {
        return false;
    }
    // the larger magnitude first
    if ((sb & 0x7FFF) > (sa & 0x7FFF)) or (((sb & 0x7FFF) == (sa & 0x7FFF)) and (mb > ma)) {
        let t = sa;
        sa = sb;
        sb = t;
        let u = ma;
        ma = mb;
        mb = u;
    }
    let d = (sa & 0x7FFF) - (sb & 0x7FFF);
    if d >= 66 {
        // b is below a quarter of an ulp of a: a is the sum rounded
        r.lo = ma;
        r.hi = sa;
        return true;
    }
    // b aligned to a as bh:bl (and the bits shifted out of it: sticky)
    let mut bh = mb;
    let mut bl: u64 = 0;
    let mut sticky = false;
    if d > 64 {
        bh = 0;
        bl = mb >> @truncate(u32, d - 64);
        sticky = (mb << @truncate(u32, 128 - d)) != 0;
    } else if d == 64 {
        bh = 0;
        bl = mb;
    } else if d > 0 {
        let k = @truncate(u32, d);
        bh = mb >> k;
        bl = mb << (64 - k);
    }
    if ((sa ^ sb) & 0x8000) == 0 {
        let h = ma +% bh;
        if h < ma {
            // a carry: one bit down
            sticky = sticky or ((bl & 1) != 0);
            return put_x(r, sa + 1, (h >> 1) | (@as(u64, 1) << 63), (bl >> 1) | (h << 63), sticky);
        }
        return put_x(r, sa, h, bl, sticky);
    }
    // a - b: ma:0 - bh:bl, and the bits below if sticky (then 1 less at
    // the bottom, and something below)
    let mut l = (@as(u64, 0) -% bl);
    let mut h = ma -% bh;
    if bl != 0 {
        h = h -% 1;
    }
    if sticky {
        if l == 0 {
            h = h -% 1;
        }
        l = l -% 1;
    }
    if (h | l) == 0 {
        r.lo = 0;
        r.hi = 0;  // +0 (to nearest)
        return true;
    }
    // normalize (by more than one bit only for d <= 1: then nothing is
    // below l)
    let mut e = sa & 0x7FFF;
    if h == 0 {
        h = l;
        l = 0;
        if e <= 64 {
            return false;
        }
        e -= 64;
    }
    let z = @as(u64, @clz(h));
    if z != 0 {
        if e <= z {
            return false;  // (subnormal)
        }
        h = (h << @truncate(u32, z)) | (l >> @truncate(u32, 64 - z));
        l = l << @truncate(u32, z);
        e -= z;
    }
    return put_x(r, (sa & 0x8000) | e, h, l, sticky);
}

// r = a * b, if the fast path applies.
fn fast_mul_x(r: *mut W, a: *W, b: *W) bool {
    let sa = a.hi & 0xFFFF;
    let sb = b.hi & 0xFFFF;
    if not (x_normal(sa, a.lo) and x_normal(sb, b.lo)) {
        return false;
    }
    let p = mul64(a.lo, b.lo);
    // the product in [2^126, 2^128): its leading bit at 127, or at 126
    let mut e = @bit_cast(i64, ((sa & 0x7FFF) + (sb & 0x7FFF))) - (@as(i64, BIAS) - 1);
    let mut h = p.h;
    let mut l = p.l;
    if (h >> 63) == 0 {
        h = (h << 1) | (l >> 63);
        l = l << 1;
        e -= 1;
    }
    if (e < 1) or (e >= 0x7FFF) {
        return false;
    }
    return put_x(r, ((sa ^ sb) & 0x8000) | @bit_cast(u64, e), h, l, false);
}

// binary128's: the 113-bit significands shifted up 15 bits (bit 127 their
// leading one, 15 guard bits below the last).

// Is the binary128 value with high word h normal (exponent 1 .. 0x7FFE)?
inline fn q_normal(h: u64) bool {
    return (((h >> 48) & 0x7FFF) -% 1) < 0x7FFE;
}

// The significand of a normal binary128 value, shifted to bit 127.
inline fn q_sig(a: *W) U2 {
    let h = (a.hi & 0xFFFF_FFFF_FFFF) | (@as(u64, 1) << 48);
    return u2((h << 15) | (a.lo >> 49), a.lo << 15);
}

// The 128-bit significand s (bit 127 set; something nonzero below it if
// sticky) rounded to 113 bits to nearest with ties to even and put with sign
// (bit 63 of sg) and biased exponent e into r; false (r untouched) if the
// rounded exponent leaves 1 .. 0x7FFE.
inline fn put_q(r: *mut W, sg: u64, e0: i64, s: U2, sticky: bool) bool {
    let mut e = e0;
    let mut mh = s.h >> 15;
    let mut ml = (s.h << 49) | (s.l >> 15);
    let half = ((s.l >> 14) & 1) != 0;
    let rest = ((s.l & 0x3FFF) != 0) or sticky;
    if half and (rest or ((ml & 1) != 0)) {
        ml = ml +% 1;
        if ml == 0 {
            mh += 1;
            if (mh >> 49) != 0 {
                mh = mh >> 1;  // (2^113: the low word is 0)
                e += 1;
            }
        }
    }
    if ((e - 1) < 0) or ((e - 1) >= 0x7FFE) {
        return false;
    }
    r.lo = ml;
    r.hi = (sg & 0x8000_0000_0000_0000) | (@bit_cast(u64, e) << 48) | (mh & 0xFFFF_FFFF_FFFF);
    return true;
}

// r = a + b (b's sign flipped by nb: 0 or bit 63), if the fast path applies.
fn fast_add_q(r: *mut W, a: *W, b: *W, nb: u64) bool {
    let ha = a.hi;
    let hb = b.hi ^ nb;
    if not (q_normal(ha) and q_normal(hb)) {
        return false;
    }
    let mut ea = @bit_cast(i64, (ha >> 48) & 0x7FFF);
    let mut eb = @bit_cast(i64, (hb >> 48) & 0x7FFF);
    let mut sa = ha;
    let mut sb = hb;
    let mut x = q_sig(a);
    let mut y = q_sig(b);
    if (eb > ea) or ((eb == ea) and lt2(x, y)) {
        let t = x;
        x = y;
        y = t;
        let te = ea;
        ea = eb;
        eb = te;
        let ts = sa;
        sa = sb;
        sb = ts;
    }
    let d = ea - eb;
    if d >= 116 {
        // b is below a quarter of an ulp of a: a is the sum rounded
        r.lo = a.lo;
        r.hi = a.hi;
        if sa != ha {
            r.lo = b.lo;
            r.hi = hb;
        }
        return true;
    }
    // y aligned (its bits shifted out: sticky)
    let k = @truncate(u32, @bit_cast(u64, d));
    let sticky = low_set(y, k);
    let ya = shr(y, k);
    if ((sa ^ sb) >> 63) == 0 {
        let z = add2(x, ya);
        if lt2(z, x) {
            // a carry: one bit down
            return put_q(r, sa, ea + 1, u2((z.h >> 1) | (@as(u64, 1) << 63), (z.l >> 1) | (z.h << 63)), sticky or
                         ((z.l & 1) != 0));
        }
        return put_q(r, sa, ea, z, sticky);
    }
    // x - y, and 1 less at the bottom if bits were shifted out (then
    // something below)
    let mut z = sub2(x, ya);
    if sticky {
        z = sub2(z, u2(0, 1));
    }
    if is0(z) {
        r.lo = 0;
        r.hi = 0;  // +0 (to nearest)
        return true;
    }
    let n = clz2(z);
    if @as(i64, n) >= ea {
        return false;  // (subnormal)
    }
    return put_q(r, sa, ea - @as(i64, n), shl(z, n), sticky);
}

// r = a * b, if the fast path applies.
fn fast_mul_q(r: *mut W, a: *W, b: *W) bool {
    if not (q_normal(a.hi) and q_normal(b.hi)) {
        return false;
    }
    let x = q_sig(a);
    let y = q_sig(b);
    // the 256-bit product in [2^254, 2^256): its high 128 bits, the low
    // ones as sticky
    let ll = mul64(x.l, y.l);
    let lh = mul64(x.l, y.h);
    let hl = mul64(x.h, y.l);
    let hh = mul64(x.h, y.h);
    let mid = add2(add2(u2(0, ll.h), u2(0, lh.l)), u2(0, hl.l));
    let mut hi = add2(add2(hh, u2(0, lh.h)), add2(u2(0, hl.h), u2(0, mid.h)));
    let mut lo = mid.l;
    let sticky = ll.l != 0;
    let mut e = (@bit_cast(i64, (a.hi >> 48) & 0x7FFF) + @bit_cast(i64, (b.hi >> 48) & 0x7FFF)) - (@as(i64, BIAS) - 1);
    if (hi.h >> 63) == 0 {
        hi = u2((hi.h << 1) | (hi.l >> 63), (hi.l << 1) | (lo >> 63));
        lo = lo << 1;
        e -= 1;
    }
    return put_q(r, a.hi ^ b.hi, e, hi, sticky or (lo != 0));
}

// The quotient and remainder of the 128-bit u1:u0 by v, for u1 < v and v's
// top bit set: two 64-bit divisions by v's high half, each corrected (H. S.
// Warren, "Hacker's Delight", 2nd ed., 9-4, divlu).
inline fn udiv128(u1: u64, u0: u64, v: u64) U2 {
    let b: u64 = 0x1_0000_0000;
    let vn1 = v >> 32;
    let vn0 = v & 0xFFFF_FFFF;
    let un1 = u0 >> 32;
    let un0 = u0 & 0xFFFF_FFFF;
    let mut q1 = u1 / vn1;
    let mut rhat = u1 - (q1 * vn1);
    while (q1 >= b) or ((q1 * vn0) > ((rhat << 32) | un1)) {
        q1 -= 1;
        rhat += vn1;
        if rhat >= b {
            break;
        }
    }
    let un21 = ((u1 << 32) | un1) -% (q1 *% v);
    let mut q0 = un21 / vn1;
    rhat = un21 - (q0 * vn1);
    while (q0 >= b) or ((q0 * vn0) > ((rhat << 32) | un0)) {
        q0 -= 1;
        rhat += vn1;
        if rhat >= b {
            break;
        }
    }
    return u2((q1 << 32) | q0, ((un21 << 32) | un0) -% (q0 *% v));
}

// r = a / b, if the fast path applies.
fn fast_div_x(r: *mut W, a: *W, b: *W) bool {
    let sa = a.hi & 0xFFFF;
    let sb = b.hi & 0xFFFF;
    let ma = a.lo;
    let mb = b.lo;
    if not (x_normal(sa, ma) and x_normal(sb, mb)) {
        return false;
    }
    let mut e = (@bit_cast(i64, sa & 0x7FFF) - @bit_cast(i64, sb & 0x7FFF)) + @as(i64, BIAS);
    let se = (sa ^ sb) & 0x8000;
    if ma >= mb {
        // the quotient ma 2^64/mb in [2^64, 2^65): 2^64 + q (q the quotient
        // of (ma - mb) 2^64), the bit below the 64 kept that of q
        let qr = udiv128(ma - mb, 0, mb);
        if (e < 1) or (e >= 0x7FFF) {
            return false;
        }
        return put_x(r, se | @bit_cast(u64, e), (qr.h >> 1) | (@as(u64, 1) << 63), qr.h << 63, qr.l != 0);
    }
    // ma 2^64/mb in [2^63, 2^64): rounded by the remainder (2 rem against
    // mb: above, below or exactly half)
    let qr = udiv128(ma, 0, mb);
    e -= 1;
    if (e < 1) or (e >= 0x7FFF) {
        return false;
    }
    let rem = qr.l;
    let mut lo: u64 = 0;
    if (rem >> 63) != 0 {
        lo = @as(u64, 1) << 63;  // 2 rem >= 2^64 > mb: above half
        return put_x(r, se | @bit_cast(u64, e), qr.h, lo, true);
    }
    let twice = rem << 1;
    if twice > mb {
        return put_x(r, se | @bit_cast(u64, e), qr.h, @as(u64, 1) << 63, true);
    }
    if twice == mb {
        return put_x(r, se | @bit_cast(u64, e), qr.h, @as(u64, 1) << 63, false);
    }
    return put_x(r, se | @bit_cast(u64, e), qr.h, 0, rem != 0);
}

/// r = a op b (op: 0 +, 1 -, 2 *, 3 /) in the environment of the register
/// word at ev (of kind k), the exceptions raised into it.
pub fn e_arith(r: *mut W, a: *W, b: *W, f: u32, op: u32, ev: *mut u64, k: u32) void {
    let mut c = ein(ev, k);
    arith_c(r, a, b, f, op, &mut c);
    eout(ev, k, c);
}

/// r = a op b (op: 0 +, 1 -, 2 *, 3 /) in c's direction, raising into c.
pub fn arith_c(r: *mut W, a: *W, b: *W, f: u32, op: u32, c: *mut Env) void {
    if op <= 1 {
        addsub(r, a, b, op == 1, f, c);
    } else if op == 2 {
        mul_c(r, a, b, f, c);
    } else {
        div_c(r, a, b, f, c);
    }
}

fn addsub(r: *mut W, a: *W, b: *W, minus: bool, f: u32, c: *mut Env) void {
    let x = unpack(a, f);
    let mut y = unpack(b, f);
    if (x.cls == C_NAN) or (y.cls == C_NAN) {
        nan_result(r, a, x, b, y, f, c);
        return;
    }
    if minus {
        y.neg = not y.neg;
    }
    if x.cls == C_INF {
        if (y.cls == C_INF) and (y.neg != x.neg) {
            invalid(r, f, c);
        } else {
            pack_inf(r, x.neg, f);
        }
        return;
    }
    if y.cls == C_INF {
        pack_inf(r, y.neg, f);
        return;
    }
    if y.cls == C_ZERO {
        if x.cls == C_ZERO {
            // (an exact zero sum of operands of opposite signs is +0, -0
            // when rounding toward -infinity: IEEE 754-2019 6.3)
            if x.neg == y.neg {
                pack_zero(r, x.neg, f);
            } else {
                pack_zero(r, c.mode == RD, f);
            }
            return;
        }
        finish(r, x.neg, x.e, x.s, false, f, c);
        return;
    }
    if x.cls == C_ZERO {
        finish(r, y.neg, y.e, y.s, false, f, c);
        return;
    }
    // the larger magnitude first
    let mut big = x;
    let mut small = y;
    if (y.e > x.e) or ((y.e == x.e) and lt2(x.s, y.s)) {
        big = y;
        small = x;
    }
    let d = big.e - small.e;
    // (both one bit down, for the carry; the smaller aligned, its bits
    // shifted out kept as a sticky bit: at least 14 bits below the
    // rounding position, as no format has more than 113)
    let bs = shr(big.s, 1);
    let mut ss = shr(small.s, 1);
    if d > 200 {
        ss = shr_jam(ss, 200);
    } else {
        ss = shr_jam(ss, @bit_cast(u32, d));
    }
    if big.neg == small.neg {
        finish(r, big.neg, big.e + 1, add2(bs, ss), false, f, c);
        return;
    }
    let s = sub2(bs, ss);
    if is0(s) {
        pack_zero(r, c.mode == RD, f);
        return;
    }
    finish(r, big.neg, big.e + 1, s, false, f, c);
}

/// r = a * b.
pub fn mul(r: *mut W, a: *W, b: *W, f: u32) void {
    if f == FMT_X {
        if fast_mul_x(r, a, b) {
            return;
        }
    } else if fast_mul_q(r, a, b) {
        return;
    }
    let mut c = env_nearest();
    mul_c(r, a, b, f, &mut c);
}

fn mul_c(r: *mut W, a: *W, b: *W, f: u32, c: *mut Env) void {
    let x = unpack(a, f);
    let y = unpack(b, f);
    if (x.cls == C_NAN) or (y.cls == C_NAN) {
        nan_result(r, a, x, b, y, f, c);
        return;
    }
    let neg = x.neg != y.neg;
    if (x.cls == C_INF) or (y.cls == C_INF) {
        if (x.cls == C_ZERO) or (y.cls == C_ZERO) {
            invalid(r, f, c);
        } else {
            pack_inf(r, neg, f);
        }
        return;
    }
    if (x.cls == C_ZERO) or (y.cls == C_ZERO) {
        pack_zero(r, neg, f);
        return;
    }
    // the 256-bit product of the significands: its high 128 bits, and
    // whether the low ones are zero
    let ll = mul64(x.s.l, y.s.l);
    let lh = mul64(x.s.l, y.s.h);
    let hl = mul64(x.s.h, y.s.l);
    let hh = mul64(x.s.h, y.s.h);
    let mid = add2(add2(u2(0, ll.h), u2(0, lh.l)), u2(0, hl.l));  // (bits 64..191 of the sum, low part)
    let lo64 = ll.l;
    let w1 = mid.l;
    let hi = add2(add2(hh, u2(0, lh.h)), add2(u2(0, hl.h), u2(0, mid.h)));
    let sticky = (lo64 | w1) != 0;
    // value = (hi * 2^128 + low) * 2^(x.e + y.e - 254)
    finish(r, neg, (x.e + y.e) + 1, hi, sticky, f, c);
}

/// r = a / b.
pub fn div(r: *mut W, a: *W, b: *W, f: u32) void {
    if (f == FMT_X) and fast_div_x(r, a, b) {
        return;
    }
    let mut c = env_nearest();
    div_c(r, a, b, f, &mut c);
}

fn div_c(r: *mut W, a: *W, b: *W, f: u32, c: *mut Env) void {
    let x = unpack(a, f);
    let y = unpack(b, f);
    if (x.cls == C_NAN) or (y.cls == C_NAN) {
        nan_result(r, a, x, b, y, f, c);
        return;
    }
    let neg = x.neg != y.neg;
    if x.cls == C_INF {
        if y.cls == C_INF {
            invalid(r, f, c);
        } else {
            pack_inf(r, neg, f);
        }
        return;
    }
    if y.cls == C_INF {
        pack_zero(r, neg, f);
        return;
    }
    if y.cls == C_ZERO {
        if x.cls == C_ZERO {
            invalid(r, f, c);
        } else {
            c.flags = c.flags | X_DIVBYZERO;
            pack_inf(r, neg, f);
        }
        return;
    }
    if x.cls == C_ZERO {
        pack_zero(r, neg, f);
        return;
    }
    let qr = div256(x.s, y.s);
    finish(r, neg, x.e - y.e, qr.q, qr.inexact, f, c);
}

// A 128-bit quotient, and whether the division left a remainder.
struct Quot {
    q: U2,
    inexact: bool,
}

// floor(a 2^127 / b) for a and b with their bit 127 set (the quotient is
// below 2^128), by D. E. Knuth's algorithm D (TAOCP vol. 2, 4.3.1) in base
// 2^64: two digits, each estimated from the remainder's top two words by
// udiv128 and corrected by the divisor's second word.
fn div256(a: U2, b: U2) Quot {
    // the dividend a 2^127 as four words u3 u2 u1 u0 (u0 = 0)
    let mut u3 = a.h >> 1;
    let mut u2w = (a.h << 63) | (a.l >> 1);
    let mut u1 = a.l << 63;
    let mut u0: u64 = 0;
    let d1 = b.h;
    let d0 = b.l;
    let mut q: [2]u64 = [0, 0];
    for j in @as(usize, 0)..2 {
        // the digit of (u3 u2 u1) / (d1 d0), u3 u2 < d1 d0
        let mut qh: u64 = 0xFFFF_FFFF_FFFF_FFFF;
        let mut rh: u64 = 0;
        let mut rh_big = false;
        if u3 < d1 {
            let t = udiv128(u3, u2w, d1);
            qh = t.h;
            rh = t.l;
        } else {
            // (u3 == d1) q = 2^64 - 1, its remainder u3 u2 - q d1 = u2 + d1
            rh = u2w +% d1;
            rh_big = rh < d1;
        }
        // q d0 > rh 2^64 + u1: q one too large (at most twice)
        while not rh_big {
            let p = mul64(qh, d0);
            if (p.h > rh) or ((p.h == rh) and (p.l > u1)) {
                qh -= 1;
                rh = rh +% d1;
                rh_big = rh < d1;
            } else {
                break;
            }
        }
        // (u3 u2 u1) -= q (d1 d0), adding the divisor back if it went below 0
        let p0 = mul64(qh, d0);
        let p1 = mul64(qh, d1);
        let w0 = u1 -% p0.l;
        let b0 = b01(u1 < p0.l);
        let m1 = p1.l +% p0.h;
        let c1 = b01(m1 < p1.l);
        let w1 = (u2w -% m1) -% b0;
        let b1 = b01((u2w < m1) or ((u2w == m1) and (b0 != 0)));
        // (p1.h <= 2^64 - 2: the top word u3 - t1 - b1 without overflow)
        let t1 = p1.h + c1;
        if (u3 < t1) or ((u3 - t1) < b1) {
            qh -= 1;
            let s0 = w0 +% d0;
            let k0 = b01(s0 < w0);
            u1 = s0;
            u2w = (w1 +% d1) +% k0;
        } else {
            u1 = w0;
            u2w = w1;
        }
        q[j] = qh;
        // the next digit's window: shift the dividend's words up
        u3 = u2w;
        u2w = u1;
        u1 = u0;
        u0 = 0;
    }
    return Quot.{ q: u2(q[0], q[1]), inexact: (u3 | u2w) != 0 };
}

fn b01(c: bool) u64 {
    if c {
        return 1;
    }
    return 0;
}

/// The order of a and b: -1 (a < b), 0 (equal), 1 (a > b), or 2
/// (unordered: a NaN).
pub fn cmp(a: *W, b: *W, f: u32) i32 {
    let mut c = env_nearest();
    return cmp_c(a, b, f, false, &mut c);
}

/// cmp's order of a and b in the environment of the register word at ev
/// (kind k): "invalid" for a signaling NaN, and for any NaN if sig (C's
/// relational operators, F.9.3).
pub fn e_cmp(a: *W, b: *W, f: u32, sig: u32, ev: *mut u64, k: u32) i32 {
    let mut c = ein(ev, k);
    let r = cmp_c(a, b, f, sig != 0, &mut c);
    eout(ev, k, c);
    return r;
}

fn cmp_c(a: *W, b: *W, f: u32, sig: bool, c: *mut Env) i32 {
    let x = unpack(a, f);
    let y = unpack(b, f);
    if (x.cls == C_NAN) or (y.cls == C_NAN) {
        if sig or ((x.cls == C_NAN) and x.snan) or ((y.cls == C_NAN) and y.snan) {
            c.flags = c.flags | X_INVALID;
        }
        return 2;
    }
    if (x.cls == C_ZERO) and (y.cls == C_ZERO) {
        return 0;
    }
    if x.neg != y.neg {
        if x.neg {
            return -1;
        }
        return 1;
    }
    // the same sign: by magnitude
    let mut o: i32 = 0;
    if x.cls != y.cls {
        if x.cls < y.cls {
            o = -1;
        } else {
            o = 1;
        }
    } else if x.cls == C_FIN {
        if x.e != y.e {
            if x.e < y.e {
                o = -1;
            } else {
                o = 1;
            }
        } else if lt2(x.s, y.s) {
            o = -1;
        } else if lt2(y.s, x.s) {
            o = 1;
        }
    }
    if x.neg {
        return 0 - o;
    }
    return o;
}

/// r = s * 2^(e - 127), rounded, for s = h:l (nonzero) and a little more
/// if sticky (the compiler reads floating constants so).
pub fn from_parts(r: *mut W, neg: bool, e: i32, h: u64, l: u64, sticky: bool, f: u32) void {
    let mut c = env_nearest();
    finish(r, neg, e, u2(h, l), sticky, f, &mut c);
}

/// from_parts rounded in c's direction, raising into c (the compiler reads
/// constants under a static rounding direction so).
pub fn from_parts_c(r: *mut W, neg: bool, e: i32, h: u64, l: u64, sticky: bool, f: u32, c: *mut Env) void {
    finish(r, neg, e, u2(h, l), sticky, f, c);
}

/// Is a an infinity?
pub fn is_inf(a: *W, f: u32) bool {
    return unpack(a, f).cls == C_INF;
}

/// Is a not zero (a NaN is not)?
pub fn nonzero(a: *W, f: u32) bool {
    return unpack(a, f).cls != C_ZERO;
}

/// r = -a (the sign changed, the rest as it is).
pub fn negate(r: *mut W, a: *W, f: u32) void {
    if f == FMT_X {
        put(r, a.lo, (a.hi & 0xFFFF) ^ 0x8000);
        return;
    }
    put(r, a.lo, a.hi ^ 0x8000_0000_0000_0000);
}

// -----------------------------------------------------------------------------
// Conversions
// -----------------------------------------------------------------------------

/// r = x (exact).
pub fn from_u64(r: *mut W, x: u64, f: u32) void {
    if x == 0 {
        pack_zero(r, false, f);
        return;
    }
    let mut c = env_nearest();
    finish(r, false, 63, u2(x, 0), false, f, &mut c);
}

/// r = x (exact).
pub fn from_i64(r: *mut W, x: i64, f: u32) void {
    if x >= 0 {
        from_u64(r, @bit_cast(u64, x), f);
        return;
    }
    let mut c = env_nearest();
    finish(r, true, 63, u2(0 -% @bit_cast(u64, x), 0), false, f, &mut c);
}

/// a truncated toward zero to an integer of `bits` bits (at most 64; signed:
/// sg), in the environment of the register word at ev (kind k): out of
/// range, an infinity or a NaN raises "invalid" and gives the bound the
/// value is beyond (0 for a NaN), a value that is not an integer "inexact"
/// (F.4). The result is extended to 64 bits as its type's sign says.
pub fn e_to_int(a: *W, f: u32, bits: u32, sg: u32, ev: *mut u64, k: u32) u64 {
    let mut c = ein(ev, k);
    let mut v: [1]u64 = [0];
    let x = unpack(a, f);
    if not to_int(&mut v[0], 1, bits, sg != 0, a, f) {
        c.flags = c.flags | X_INVALID;
    } else if frac_nonzero(x) {
        c.flags = c.flags | X_INEXACT;
    }
    eout(ev, k, c);
    return v[0];
}

/// to_int (n limbs at r) in the environment of the register word at ev
/// (kind k), raising "invalid" when the value does not fit and "inexact"
/// when it is not an integer.
pub fn e_to_wint(r: *mut u64, n: usize, bits: u32, sg: bool, a: *W, f: u32, ev: *mut u64, k: u32) void {
    let mut c = ein(ev, k);
    if not to_int(r, n, bits, sg, a, f) {
        c.flags = c.flags | X_INVALID;
    } else if frac_nonzero(unpack(a, f)) {
        c.flags = c.flags | X_INEXACT;
    }
    eout(ev, k, c);
}

// Has finite x a fraction (bits below its units)?
fn frac_nonzero(x: Un) bool {
    if x.cls != C_FIN {
        return false;
    }
    if x.e < 0 {
        return true;
    }
    if x.e >= 127 {
        return false;
    }
    return low_set(x.s, @bit_cast(u32, 127 - x.e));
}

/// a truncated toward zero, saturated to i64 (NaN: 0).
pub fn to_i64(a: *W, f: u32) i64 {
    let x = unpack(a, f);
    if x.cls == C_NAN {
        return 0;
    }
    if x.cls == C_INF {
        if x.neg {
            return @min_value(i64);
        }
        return @max_value(i64);
    }
    if (x.cls == C_ZERO) or (x.e < 0) {
        return 0;
    }
    if x.e >= 63 {
        if x.neg {
            return @min_value(i64);
        }
        return @max_value(i64);
    }
    let m = x.s.h >> @bit_cast(u32, 63 - x.e);
    if x.neg {
        return 0 - @bit_cast(i64, m);
    }
    return @bit_cast(i64, m);
}

/// a truncated toward zero, saturated to u64 (NaN: 0).
pub fn to_u64(a: *W, f: u32) u64 {
    let x = unpack(a, f);
    if (x.cls == C_NAN) or (x.cls == C_ZERO) {
        return 0;
    }
    if x.neg {
        return 0;
    }
    if x.cls == C_INF {
        return @max_value(u64);
    }
    if x.e < 0 {
        return 0;
    }
    if x.e >= 64 {
        return @max_value(u64);
    }
    return x.s.h >> @bit_cast(u32, 63 - x.e);
}

// Limb i of the n limbs at p (0 past them).
fn limb(p: *u64, n: usize, i: usize) u64 {
    if i >= n {
        return 0;
    }
    return @ptr_add(p, i).*;
}

/// r = the integer of n 64-bit limbs at p (least significant first; two's
/// complement when sg), correctly rounded: C's integers wider than 64 bits
/// (cmd/axiom/src/c/cgen_wint.ax).
pub fn from_int(r: *mut W, p: *u64, n: usize, sg: bool, f: u32) void {
    let mut c = env_nearest();
    from_int_c(r, p, n, sg, f, &mut c);
}

/// from_int in the environment of the register word at ev (kind k).
pub fn e_from_int(r: *mut W, p: *u64, n: usize, sg: bool, f: u32, ev: *mut u64, k: u32) void {
    let mut c = ein(ev, k);
    from_int_c(r, p, n, sg, f, &mut c);
    eout(ev, k, c);
}

fn from_int_c(r: *mut W, p: *u64, n: usize, sg: bool, f: u32, c: *mut Env) void {
    let x = int_parts(p, n, sg);
    if x.zero {
        pack_zero(r, false, f);
        return;
    }
    finish(r, x.neg, x.e, x.w, x.sticky, f, c);
}

/// The integer of n limbs at p (signed: sg) rounded to double (w 64) or
/// float (w 32), its bits, in the environment of the register word at ev
/// (kind k).
pub fn e_wint_to_bin(p: *u64, n: usize, sg: bool, w: u32, ev: *mut u64, k: u32) u64 {
    let mut c = ein(ev, k);
    let x = int_parts(p, n, sg);
    let mut r: u64 = 0;
    if not x.zero {
        if w == 32 {
            let d = round(x.neg, x.e, x.w, x.sticky, 24, 127, 0xFF, &mut c);
            r = (sgn(x.neg, 31) | (@as(u64, @bit_cast(u32, d.ef)) << 23)) | (d.m.l & 0x7F_FFFF);
        } else {
            let d = round(x.neg, x.e, x.w, x.sticky, 53, 1023, 0x7FF, &mut c);
            r = (sgn(x.neg, 63) | (@as(u64, @bit_cast(u32, d.ef)) << 52)) | (d.m.l & 0xF_FFFF_FFFF_FFFF);
        }
    }
    eout(ev, k, c);
    return r;
}

/// The double with bits b truncated toward zero to an integer of n limbs at
/// r (`bits` bits, signed: sg), as e_to_wint does.
pub fn e_wint_from_f64(r: *mut u64, n: usize, bits: u32, sg: bool, b: u64, ev: *mut u64, k: u32) void {
    let mut c = ein(ev, k);
    let mut w = W.{ lo: 0, hi: 0 };
    from_f64_c(&mut w, b, FMT_Q, &mut c);  // (exact)
    if not to_int(r, n, bits, sg, &w, FMT_Q) {
        c.flags = c.flags | X_INVALID;
    } else if frac_nonzero(unpack(&w, FMT_Q)) {
        c.flags = c.flags | X_INEXACT;
    }
    eout(ev, k, c);
}

// An integer's magnitude as s * 2^(e - 127) (its leading 128 bits; sticky:
// bits below them set).
struct IntP {
    zero: bool,
    neg: bool,
    e: i32,
    w: U2,
    sticky: bool,
}

fn int_parts(p: *u64, n: usize, sg: bool) IntP {
    let neg = sg and ((limb(p, n, n - 1) >> 63) != 0);
    // the magnitude's limbs, one at a time: -x is ~x + 1, the carry ends at
    // the first limb that is not 0
    let mut top: usize = n;
    let mut i = n;
    while i > 0 {
        i -= 1;
        if mag(p, n, i, neg) != 0 {
            top = i;
            break;
        }
    }
    if top == n {
        return IntP.{ zero: true, neg: false, e: 0, w: u2(0, 0), sticky: false };
    }
    // the leading 128 bits (from limbs top and below), and whether any
    // bits below them are set
    let h = mag(p, n, top, neg);
    let z = @truncate(u32, @clz(h));
    let mut w = u2(h, 0);
    let mut sticky = false;
    if top >= 1 {
        w = u2(h, mag(p, n, top - 1, neg));
    }
    let mut x: u64 = 0;
    if top >= 2 {
        x = mag(p, n, top - 2, neg);
    }
    w = shl(w, z);
    if z != 0 {
        w = u2(w.h, w.l | (x >> (64 - z)));
        sticky = (x << z) != 0;
    } else {
        sticky = x != 0;
    }
    if top >= 3 {
        for k in 0..(top - 2) {
            if mag(p, n, k, neg) != 0 {
                sticky = true;
            }
        }
    }
    let e = ((@bit_cast(i32, @truncate(u32, top)) * 64) + 63) - @bit_cast(i32, z);
    return IntP.{ zero: false, neg: neg, e: e, w: w, sticky: sticky };
}

// Limb i of the magnitude of the integer at p (n limbs; negative: neg).
fn mag(p: *u64, n: usize, i: usize, neg: bool) u64 {
    let v = limb(p, n, i);
    if not neg {
        return v;
    }
    // (~v, plus the carry of the limbs below: 1 when they are all 0)
    for k in 0..i {
        if limb(p, n, k) != 0 {
            return ~v;
        }
    }
    return (~v) +% 1;
}

/// r (n limbs) = a truncated toward zero, saturated to the range of an
/// integer of `bits` bits (signed: sg; NaN: 0), extended to the n limbs;
/// whether its value fitted.
pub fn to_int(r: *mut u64, n: usize, bits: u32, sg: bool, a: *W, f: u32) bool {
    for i in 0..n {
        @ptr_add(r, i).* = 0;
    }
    let x = unpack(a, f);
    if x.cls == C_NAN {
        return false;
    }
    if (x.cls == C_ZERO) or ((x.cls == C_FIN) and (x.e < 0)) {
        return true;
    }
    let mut lim = @bit_cast(i32, bits);
    if sg {
        lim -= 1;
    }
    let exact_min = sg and x.neg and (x.cls == C_FIN) and (x.e == lim) and int_bits_zero(x.s, x.e);
    if (x.cls == C_INF) or (x.e >= lim) or (x.neg and not sg) {
        // the least or the largest value
        if x.neg and sg {
            let k = bits - 1;
            @ptr_add(r, @as(usize, k / 64)).* = @as(u64, 1) << (k % 64);
            for i in (@as(usize, k / 64) + 1)..n {
                @ptr_add(r, i).* = 0xFFFF_FFFF_FFFF_FFFF;
            }
            // (the bits above, within the limb, are the sign's)
            let t = @as(usize, k / 64);
            @ptr_add(r, t).* = @ptr_add(r, t).* | ~((@as(u64, 1) << (k % 64)) -% 1);
        } else if not x.neg {
            let k = @as(u32, @bit_cast(u32, lim));
            for i in 0..n {
                let lo = @truncate(u32, i * 64);
                if (lo + 64) <= k {
                    @ptr_add(r, i).* = 0xFFFF_FFFF_FFFF_FFFF;
                } else if lo < k {
                    @ptr_add(r, i).* = (@as(u64, 1) << (k - lo)) - 1;
                }
            }
        }
        return exact_min;
    }
    // the integer part of s * 2^(e - 127)
    if x.e <= 127 {
        let v = shr(x.s, @bit_cast(u32, 127 - x.e));
        @ptr_add(r, 0).* = v.l;
        if n > 1 {
            @ptr_add(r, 1).* = v.h;
        }
    } else {
        let k = @bit_cast(u32, x.e - 127);
        let q = @as(usize, k / 64);
        let b = k % 64;
        if q < n {
            @ptr_add(r, q).* = x.s.l << b;
        }
        if (q + 1) < n {
            let mut v = x.s.h << b;
            if b != 0 {
                v = v | (x.s.l >> (64 - b));
            }
            @ptr_add(r, q + 1).* = v;
        }
        if ((q + 2) < n) and (b != 0) {
            @ptr_add(r, q + 2).* = x.s.h >> (64 - b);
        }
    }
    if x.neg {
        let mut c: u64 = 1;
        for i in 0..n {
            let v = (~@ptr_add(r, i).*) +% c;
            if v != 0 {
                c = 0;
            }
            @ptr_add(r, i).* = v;
        }
    }
    return true;
}

// Are the bits of the integer part of s * 2^(e - 127) (s normalized, e >=
// 0) below the leading one all 0?
fn int_bits_zero(s: U2, e: i32) bool {
    if e >= 127 {
        return is0(u2(s.h & 0x7FFF_FFFF_FFFF_FFFF, s.l));
    }
    let v = shr(s, @bit_cast(u32, 127 - e));
    return is0(sub2(v, shl(u2(0, 1), @bit_cast(u32, e))));
}

/// r = the double whose bits are `bits` (exact; a NaN quieted).
pub fn from_f64(r: *mut W, bits: u64, f: u32) void {
    let mut c = env_nearest();
    from_f64_c(r, bits, f, &mut c);
}

fn from_f64_c(r: *mut W, bits: u64, f: u32, c: *mut Env) void {
    from_bin(r, (bits >> 63) != 0, @bit_cast(i32, @truncate(u32, (bits >> 52) & 0x7FF)), bits & 0xF_FFFF_FFFF_FFFF, 53,
             1023, 0x7FF, f, c);
}

/// r = the float whose bits are `bits` (exact; a NaN quieted).
pub fn from_f32(r: *mut W, bits: u32, f: u32) void {
    let mut c = env_nearest();
    from_f32_c(r, bits, f, &mut c);
}

fn from_f32_c(r: *mut W, bits: u32, f: u32, c: *mut Env) void {
    from_bin(r, (bits >> 31) != 0, @bit_cast(i32, (bits >> 23) & 0xFF), @as(u64, bits & 0x7F_FFFF), 24, 127, 0xFF, f,
             c);
}

/// r = the double (w 64) or float (w 32) with bits `bits`, in the
/// environment of the register word at ev (kind k): exact, but "invalid"
/// for a signaling NaN.
pub fn e_from_bin(r: *mut W, bits: u64, w: u32, f: u32, ev: *mut u64, k: u32) void {
    let mut c = ein(ev, k);
    if w == 32 {
        from_f32_c(r, @truncate(u32, bits), f, &mut c);
    } else {
        from_f64_c(r, bits, f, &mut c);
    }
    eout(ev, k, c);
}

// From a binary format of p bits of precision (fraction fr of p - 1 bits).
fn from_bin(r: *mut W, neg: bool, ef: i32, fr: u64, p: i32, bias: i32, maxef: i32, f: u32, c: *mut Env) void {
    let fb = @bit_cast(u32, p - 1);
    if ef == maxef {
        if fr == 0 {
            pack_inf(r, neg, f);
            return;
        }
        if ((fr >> (fb - 1)) & 1) == 0 {
            c.flags = c.flags | X_INVALID;  // (a signaling NaN)
        }
        // the payload at the top of the fraction, quiet
        if f == FMT_X {
            put(r, (@as(u64, 0xC000_0000_0000_0000) | (fr << (63 - fb))), sgn(neg, 15) | 0x7FFF);
            return;
        }
        let w = shl(u2(0, fr), 112 - fb);
        put(r, w.l, ((sgn(neg, 63) | (@as(u64, 0x7FFF) << 48)) | (w.h & 0xFFFF_FFFF_FFFF)) | 0x0000_8000_0000_0000);
        return;
    }
    if ef == 0 {
        if fr == 0 {
            pack_zero(r, neg, f);
            return;
        }
        // m * 2^(1 - bias - (p - 1)) = (m << 64) * 2^(e - 127)
        finish(r, neg, ((1 - bias) - (p - 1)) + 63, u2(fr, 0), false, f, c);
        return;
    }
    let m = fr | (@as(u64, 1) << fb);
    finish(r, neg, ((ef - bias) - (p - 1)) + 63, u2(m, 0), false, f, c);
}

/// a rounded to double: its bits.
pub fn to_f64(a: *W, f: u32) u64 {
    let mut c = env_nearest();
    return to_bin(a, 53, 1023, 0x7FF, f, &mut c);
}

/// a rounded to float: its bits.
pub fn to_f32(a: *W, f: u32) u32 {
    let mut c = env_nearest();
    return @truncate(u32, to_bin(a, 24, 127, 0xFF, f, &mut c));
}

/// a rounded to double (w 64) or float (w 32), its bits, in the
/// environment of the register word at ev (kind k).
pub fn e_to_bin(a: *W, f: u32, w: u32, ev: *mut u64, k: u32) u64 {
    let mut c = ein(ev, k);
    let mut r: u64 = 0;
    if w == 32 {
        r = to_bin(a, 24, 127, 0xFF, f, &mut c);
    } else {
        r = to_bin(a, 53, 1023, 0x7FF, f, &mut c);
    }
    eout(ev, k, c);
    return r;
}

// To a binary format of p bits of precision, 1 + w + (p - 1) bits wide.
fn to_bin(a: *W, p: i32, bias: i32, maxef: i32, f: u32, c: *mut Env) u64 {
    let x = unpack(a, f);
    let fb = @bit_cast(u32, p - 1);
    let eb = @as(u64, @bit_cast(u32, maxef));
    let sb = fb + (32 - @truncate(u32, @clz(@as(u32, @bit_cast(u32, maxef)))));
    let s = sgn(x.neg, sb);
    let fm = (@as(u64, 1) << fb) - 1;
    if x.cls == C_NAN {
        if x.snan {
            c.flags = c.flags | X_INVALID;
        }
        // the payload's top bits, quiet
        let mut top: u64 = 0;
        if f == FMT_X {
            if ((a.hi & 0x7FFF) != 0x7FFF) or ((a.lo >> 63) == 0) {
                // (an invalid encoding: the default NaN, as the x87 gives it)
                return (sgn(true, sb) | (eb << fb)) | (@as(u64, 1) << (fb - 1));
            }
            top = (a.lo << 1) >> (64 - fb);
        } else {
            top = shr(u2(a.hi & 0xFFFF_FFFF_FFFF, a.lo), 112 - fb).l;
        }
        return ((s | (eb << fb)) | (top & fm)) | (@as(u64, 1) << (fb - 1));
    }
    if x.cls == C_INF {
        return s | (eb << fb);
    }
    if x.cls == C_ZERO {
        return s;
    }
    let d = round(x.neg, x.e, x.s, false, p, bias, maxef, c);
    return (s | (@as(u64, @bit_cast(u32, d.ef)) << fb)) | (d.m.l & fm);
}

/// r = a, of format ff, in format tf: exact from the x87's format to
/// binary128 (a subset of its values), correctly rounded the other way; a
/// NaN keeps the top bits of its payload, quieted (C's _Float128, _Float64x
/// and long double where two of them have different formats).
pub fn convert(r: *mut W, a: *W, ff: u32, tf: u32) void {
    let mut c = env_nearest();
    convert_c(r, a, ff, tf, &mut c);
}

/// convert in the environment of the register word at ev (kind k).
pub fn e_convert(r: *mut W, a: *W, ff: u32, tf: u32, ev: *mut u64, k: u32) void {
    let mut c = ein(ev, k);
    convert_c(r, a, ff, tf, &mut c);
    eout(ev, k, c);
}

fn convert_c(r: *mut W, a: *W, ff: u32, tf: u32, c: *mut Env) void {
    if ff == tf {
        put(r, a.lo, a.hi);
        return;
    }
    let x = unpack(a, ff);
    if x.cls == C_NAN {
        if x.snan {
            c.flags = c.flags | X_INVALID;
        }
        // the payload below the quiet bit, as many of its top bits as fit
        let mut pl = u2(0, 0);
        if ff == FMT_X {
            pl = u2(a.lo << 2, 0);  // (62 payload bits, at the top of 128)
        } else {
            pl = shl(u2(a.hi & 0x7FFF_FFFF_FFFF, a.lo), 17);  // (111 bits)
        }
        if (ff == FMT_X) and (((a.hi & 0x7FFF) != 0x7FFF) or ((a.lo >> 63) == 0)) {
            pack_dnan(r, tf);  // (an invalid x87 encoding)
            return;
        }
        if tf == FMT_X {
            put(r, 0xC000_0000_0000_0000 | (pl.h >> 2), sgn(x.neg, 15) | 0x7FFF);
            return;
        }
        let q = shr(pl, 17);
        put(r, q.l, ((sgn(x.neg, 63) | (@as(u64, 0x7FFF) << 48)) | 0x0000_8000_0000_0000) | (q.h & 0x7FFF_FFFF_FFFF));
        return;
    }
    if x.cls == C_INF {
        pack_inf(r, x.neg, tf);
        return;
    }
    if x.cls == C_ZERO {
        pack_zero(r, x.neg, tf);
        return;
    }
    finish(r, x.neg, x.e, x.s, false, tf, c);
}

// -----------------------------------------------------------------------------
// binary16 (C's _Float16): its values are their 16 bits, which the C front
// end widens to float for each operation and rounds back (cgen_half.ax).
// Every conversion here is correctly rounded, to nearest with ties to even;
// a NaN keeps the top bits of its payload, quieted.
// -----------------------------------------------------------------------------

// The binary16 encoding of m * 2^e (m nonzero), rounded in c's direction
// (a little more than that if sticky), with sign neg.
fn half_round(neg: bool, m0: u64, e0: i32, sticky: bool, c: *mut Env) u64 {
    // (m * 2^e is (m << 64) * 2^((e + 63) - 127))
    let d = round(neg, e0 + 63, u2(m0, 0), sticky, 11, 15, 0x1F, c);
    return (sgn(neg, 15) | (@as(u64, @bit_cast(u32, d.ef)) << 10)) | (d.m.l & 0x3FF);
}

// The binary16 encoding of a value of a binary format: sign, biased exponent
// ef, fraction fr of fb bits, its bias and largest exponent field.
fn half_of(neg: bool, ef: i32, fr: u64, fb: u32, bias: i32, maxef: i32, c: *mut Env) u64 {
    if ef == maxef {
        if fr == 0 {
            return sgn(neg, 15) | 0x7C00;
        }
        if ((fr >> (fb - 1)) & 1) == 0 {
            c.flags = c.flags | X_INVALID;  // (a signaling NaN)
        }
        return (sgn(neg, 15) | 0x7E00) | ((fr >> (fb - 10)) & 0x1FF);
    }
    if ef == 0 {
        if fr == 0 {
            return sgn(neg, 15);
        }
        return half_round(neg, fr, (1 - bias) - @bit_cast(i32, fb), false, c);
    }
    return half_round(neg, fr | (@as(u64, 1) << fb), (ef - bias) - @bit_cast(i32, fb), false, c);
}

fn h_f32(x: u64, c: *mut Env) u64 {
    return half_of(((x >> 31) & 1) != 0, @bit_cast(i32, @truncate(u32, (x >> 23) & 0xFF)), x & 0x7F_FFFF, 23, 127, 0xFF,
                   c);
}

fn h_f64(x: u64, c: *mut Env) u64 {
    return half_of((x >> 63) != 0, @bit_cast(i32, @truncate(u32, (x >> 52) & 0x7FF)), x & 0xF_FFFF_FFFF_FFFF, 52, 1023,
                   0x7FF, c);
}

fn h_int(x: u64, sg: bool, c: *mut Env) u64 {
    let neg = sg and ((x >> 63) != 0);
    let mut m = x;
    if neg {
        m = 0 -% x;
    }
    if m == 0 {
        return 0;
    }
    return half_round(neg, m, 0, false, c);
}

/// The binary16 bits of the float with bits x (its low 32).
pub fn h_from_f32(x: u64) u64 {
    let mut c = env_nearest();
    return h_f32(x, &mut c);
}

/// The binary16 bits of the double with bits x.
pub fn h_from_f64(x: u64) u64 {
    let mut c = env_nearest();
    return h_f64(x, &mut c);
}

/// The binary16 bits of a (of format f).
pub fn h_from_w(a: *W, f: u32) u64 {
    let mut c = env_nearest();
    return to_bin(a, 11, 15, 0x1F, f, &mut c);
}

/// r = the binary16 value with bits h (exact).
pub fn h_to_w(r: *mut W, h: u64, f: u32) void {
    let mut c = env_nearest();
    from_bin(r, ((h >> 15) & 1) != 0, @bit_cast(i32, @truncate(u32, (h >> 10) & 0x1F)), h & 0x3FF, 11, 15, 0x1F, f,
             &mut c);
}

/// The binary16 bits of the integer x (signed: sg), correctly rounded.
pub fn h_from_int(x: u64, sg: bool) u64 {
    let mut c = env_nearest();
    return h_int(x, sg, &mut c);
}

/// The binary16 bits of s * 2^(e - 127) (s = h:l, nonzero), rounded (a
/// little more if sticky): the compiler reads _Float16 constants so.
pub fn h_from_parts(neg: bool, e: i32, h: u64, l: u64, sticky: bool) u64 {
    let mut c = env_nearest();
    return h_from_parts_c(neg, e, h, l, sticky, &mut c);
}

/// h_from_parts in c's direction, raising into c.
pub fn h_from_parts_c(neg: bool, e: i32, h: u64, l: u64, sticky: bool, c: *mut Env) u64 {
    let s = u2(h, l);
    let z = clz2(s);
    let n = shl(s, z);
    return half_round(neg, n.h, (e - @bit_cast(i32, z)) - 63, sticky or (n.l != 0), c);
}

/// A conversion to binary16, in the environment of the register word at ev
/// (kind k): of the float (from 0) or double (1) with bits x, of the
/// integer x (2 unsigned, 3 signed), or of the value of format f at a (4).
pub fn e_h_from(x: u64, a: *W, f: u32, from: u32, ev: *mut u64, k: u32) u64 {
    let mut c = ein(ev, k);
    let mut r: u64 = 0;
    if from == 0 {
        r = h_f32(x, &mut c);
    } else if from == 1 {
        r = h_f64(x, &mut c);
    } else if from <= 3 {
        r = h_int(x, from == 3, &mut c);
    } else {
        r = to_bin(a, 11, 15, 0x1F, f, &mut c);
    }
    eout(ev, k, c);
    return r;
}

/// r = the binary16 value with bits h, in the environment of the register
/// word at ev (kind k): exact, but "invalid" for a signaling NaN.
pub fn e_h_to_w(r: *mut W, h: u64, f: u32, ev: *mut u64, k: u32) void {
    let mut c = ein(ev, k);
    from_bin(r, ((h >> 15) & 1) != 0, @bit_cast(i32, @truncate(u32, (h >> 10) & 0x1F)), h & 0x3FF, 11, 15, 0x1F, f,
             &mut c);
    eout(ev, k, c);
}

// -----------------------------------------------------------------------------
// bfloat16 (the C front end's __bf16, a GNU dialect's type): 1 sign bit, 8
// exponent bits (bias 127, as binary32's), 7 fraction bits (8 bits of
// precision). Conversions to it round once from the source's own value.
// -----------------------------------------------------------------------------

fn b_w(a: *W, f: u32, c: *mut Env) u64 {
    return to_bin(a, 8, 127, 0xFF, f, c);
}

fn b_f64(x: u64, c: *mut Env) u64 {
    let mut w = W.{ lo: 0, hi: 0 };
    from_f64_c(&mut w, x, FMT_Q, c);  // (exact: "invalid" for a signaling NaN, quieted)
    return b_w(&w, FMT_Q, c);
}

fn b_int(x: u64, sg: bool) W {
    let mut w = W.{ lo: 0, hi: 0 };
    if sg {
        from_i64(&mut w, @bit_cast(i64, x), FMT_Q);
    } else {
        from_u64(&mut w, x, FMT_Q);
    }
    return w;  // (exact: 113 bits)
}

fn b_to(r: *mut W, b: u64, f: u32, c: *mut Env) void {
    from_bin(r, ((b >> 15) & 1) != 0, @bit_cast(i32, @truncate(u32, (b >> 7) & 0xFF)), b & 0x7F, 8, 127, 0xFF, f, c);
}

/// The bfloat16 bits of the float with bits x (its low 32).
pub fn b_from_f32(x: u64) u64 {
    return b_from_f64(from32(x));
}

// The double bits of the float with bits x (exact; a NaN's payload kept).
fn from32(x: u64) u64 {
    let mut w = W.{ lo: 0, hi: 0 };
    from_f32(&mut w, @truncate(u32, x), FMT_Q);
    return to_f64(&w, FMT_Q);
}

/// The bfloat16 bits of the double with bits x.
pub fn b_from_f64(x: u64) u64 {
    let mut c = env_nearest();
    return b_f64(x, &mut c);
}

/// The bfloat16 bits of a (of format f).
pub fn b_from_w(a: *W, f: u32) u64 {
    let mut c = env_nearest();
    return b_w(a, f, &mut c);
}

/// The bfloat16 bits of the integer x (signed: sg), correctly rounded.
pub fn b_from_int(x: u64, sg: bool) u64 {
    let mut c = env_nearest();
    let w = b_int(x, sg);
    return b_w(&w, FMT_Q, &mut c);
}

/// r = the bfloat16 value with bits b (exact).
pub fn b_to_w(r: *mut W, b: u64, f: u32) void {
    let mut c = env_nearest();
    b_to(r, b, f, &mut c);
}

/// A conversion to bfloat16, in the environment of the register word at
/// ev (kind k): of the float (from 0) or double (1) with bits x, of the
/// integer x (2 unsigned, 3 signed), or of the value of format f at a (4).
pub fn e_b_from(x: u64, a: *W, f: u32, from: u32, ev: *mut u64, k: u32) u64 {
    let mut c = ein(ev, k);
    let mut r: u64 = 0;
    if from == 0 {
        let mut w = W.{ lo: 0, hi: 0 };
        from_f32_c(&mut w, @truncate(u32, x), FMT_Q, &mut c);
        r = b_w(&w, FMT_Q, &mut c);
    } else if from == 1 {
        r = b_f64(x, &mut c);
    } else if from <= 3 {
        let w = b_int(x, from == 3);
        r = b_w(&w, FMT_Q, &mut c);
    } else {
        r = b_w(a, f, &mut c);
    }
    eout(ev, k, c);
    return r;
}

/// r = the bfloat16 value with bits b, in the environment of the register
/// word at ev (kind k): exact, but "invalid" for a signaling NaN.
pub fn e_b_to_w(r: *mut W, b: u64, f: u32, ev: *mut u64, k: u32) void {
    let mut c = ein(ev, k);
    b_to(r, b, f, &mut c);
    eout(ev, k, c);
}

// -----------------------------------------------------------------------------
// Complex multiplication and division (C99 6.5.5, Annex G.5.1), of long
// double _Complex values: the algorithms of the C front end's for float
// and double (cmd/axiom/src/c/ccomplex.ax), step for step in this
// arithmetic. The compiler folds constants with these functions too.
// -----------------------------------------------------------------------------

// A format, and the environment the operations round in and raise into.
struct Fx {
    f: u32,
    c: Env,
}

fn wop(op: u32, x: W, y: W, f: *mut Fx) W {
    let mut r = W.{ lo: 0, hi: 0 };
    arith_c(&mut r, &x, &y, f.f, op, &mut f.c);
    return r;
}

fn wadd(x: W, y: W, f: *mut Fx) W {
    return wop(0, x, y, f);
}

fn wsub(x: W, y: W, f: *mut Fx) W {
    return wop(1, x, y, f);
}

fn wmul(x: W, y: W, f: *mut Fx) W {
    return wop(2, x, y, f);
}

fn wdiv(x: W, y: W, f: *mut Fx) W {
    return wop(3, x, y, f);
}

fn wcls(x: W, f: *mut Fx) u32 {
    return unpack(&x, f.f).cls;
}

fn w_is_nan(x: W, f: *mut Fx) bool {
    return wcls(x, f) == C_NAN;
}

fn w_is_inf(x: W, f: *mut Fx) bool {
    return wcls(x, f) == C_INF;
}

fn w_is_finite(x: W, f: *mut Fx) bool {
    let c = wcls(x, f);
    return (c == C_ZERO) or (c == C_FIN);
}

// m with the sign of s.
fn wcopysign(m: W, s: W, f: *mut Fx) W {
    if f.f == FMT_X {
        return W.{ lo: m.lo, hi: ((m.hi & 0x7FFF) | (s.hi & 0x8000)) };
    }
    return W.{ lo: m.lo, hi: (m.hi & 0x7FFF_FFFF_FFFF_FFFF) | (s.hi & 0x8000_0000_0000_0000) };
}

fn wabs(x: W, f: *mut Fx) W {
    return wcopysign(x, W.{ lo: 0, hi: 0 }, f);
}

fn wzero() W {
    return W.{ lo: 0, hi: 0 };
}

fn wone(f: *mut Fx) W {
    let mut r = wzero();
    from_u64(&mut r, 1, f.f);
    return r;
}

fn winf(f: *mut Fx) W {
    let mut r = wzero();
    pack_inf(&mut r, false, f.f);
    return r;
}

// copysign(isinf(x) ? 1 : 0, x)
fn wboxed(x: W, f: *mut Fx) W {
    if w_is_inf(x, f) {
        return wcopysign(wone(f), x, f);
    }
    return wcopysign(wzero(), x, f);
}

// A NaN made a zero (of its sign), other values unchanged.
fn wnan0(x: W, f: *mut Fx) W {
    if w_is_nan(x, f) {
        return wcopysign(wzero(), x, f);
    }
    return x;
}

fn wcmp(x: W, y: W, f: *mut Fx) i32 {
    return cmp_c(&x, &y, f.f, false, &mut f.c);
}

/// re + i im = (a + ib)(c + id), both complex.
pub fn cmul(re: *mut W, im: *mut W, a0: *W, b0: *W, c0: *W, d0: *W, f: u32) void {
    let mut x = Fx.{ f: f, c: env_nearest() };
    cmul_c(re, im, a0, b0, c0, d0, &mut x);
}

/// cmul and cdiv (div true) in the environment of the register word at ev
/// (kind k).
pub fn e_cmuldiv(re: *mut W, im: *mut W, a0: *W, b0: *W, c0: *W, d0: *W, f: u32, is_div: bool, ev: *mut u64,
                 k: u32) void {
    let mut x = Fx.{ f: f, c: ein(ev, k) };
    if is_div {
        cdiv_c(re, im, a0, b0, c0, d0, &mut x);
    } else {
        cmul_c(re, im, a0, b0, c0, d0, &mut x);
    }
    eout(ev, k, x.c);
}

fn cmul_c(re: *mut W, im: *mut W, a0: *W, b0: *W, c0: *W, d0: *W, f: *mut Fx) void {
    let mut a = a0.*;
    let mut b = b0.*;
    let mut c = c0.*;
    let mut d = d0.*;
    let ac = wmul(a, c, f);
    let bd = wmul(b, d, f);
    let ad = wmul(a, d, f);
    let bc = wmul(b, c, f);
    let x = wsub(ac, bd, f);
    let y = wadd(ad, bc, f);
    re.* = x;
    im.* = y;
    if not w_is_nan(x, f) or not w_is_nan(y, f) {
        return;
    }
    // G.5.1: the infinities of a product that computed as NaN + iNaN
    let mut recalc = false;
    if w_is_inf(a, f) or w_is_inf(b, f) {
        a = wboxed(a, f);
        b = wboxed(b, f);
        c = wnan0(c, f);
        d = wnan0(d, f);
        recalc = true;
    }
    if w_is_inf(c, f) or w_is_inf(d, f) {
        c = wboxed(c, f);
        d = wboxed(d, f);
        a = wnan0(a, f);
        b = wnan0(b, f);
        recalc = true;
    }
    if not recalc and (w_is_inf(ac, f) or w_is_inf(bd, f) or w_is_inf(ad, f) or w_is_inf(bc, f)) {
        a = wnan0(a, f);
        b = wnan0(b, f);
        c = wnan0(c, f);
        d = wnan0(d, f);
        recalc = true;
    }
    if recalc {
        re.* = wmul(winf(f), wsub(wmul(a, c, f), wmul(b, d, f), f), f);
        im.* = wmul(winf(f), wadd(wmul(a, d, f), wmul(b, c, f), f), f);
    }
}

/// re + i im = (a + ib) / (c + id), both complex (b +0 for a real
/// dividend): Smith's method, then G.5.1's recovery of infinities and
/// zeros.
pub fn cdiv(re: *mut W, im: *mut W, a0: *W, b0: *W, c0: *W, d0: *W, f: u32) void {
    let mut x = Fx.{ f: f, c: env_nearest() };
    cdiv_c(re, im, a0, b0, c0, d0, &mut x);
}

fn cdiv_c(re: *mut W, im: *mut W, a0: *W, b0: *W, c0: *W, d0: *W, f: *mut Fx) void {
    let mut a = a0.*;
    let mut b = b0.*;
    let mut c = c0.*;
    let mut d = d0.*;
    let z = wzero();
    let mut x = z;
    let mut y = z;
    let ge = wcmp(wabs(c, f), wabs(d, f), f);
    if (ge == 0) or (ge == 1) {
        let r = wdiv(d, c, f);
        let den = wadd(c, wmul(d, r, f), f);
        if wcmp(r, z, f) != 0 {
            x = wdiv(wadd(a, wmul(b, r, f), f), den, f);
            y = wdiv(wsub(b, wmul(a, r, f), f), den, f);
        } else {
            x = wdiv(wadd(a, wmul(d, wdiv(b, c, f), f), f), den, f);
            y = wdiv(wsub(b, wmul(d, wdiv(a, c, f), f), f), den, f);
        }
    } else {
        let r = wdiv(c, d, f);
        let den = wadd(wmul(c, r, f), d, f);
        if wcmp(r, z, f) != 0 {
            x = wdiv(wadd(wmul(a, r, f), b, f), den, f);
            y = wdiv(wsub(wmul(b, r, f), a, f), den, f);
        } else {
            x = wdiv(wadd(wmul(c, wdiv(a, d, f), f), b, f), den, f);
            y = wdiv(wsub(wmul(c, wdiv(b, d, f), f), a, f), den, f);
        }
    }
    re.* = x;
    im.* = y;
    if not w_is_nan(x, f) or not w_is_nan(y, f) {
        return;
    }
    if (wcmp(c, z, f) == 0) and (wcmp(d, z, f) == 0) and (not w_is_nan(a, f) or not w_is_nan(b, f)) {
        let k = wcopysign(winf(f), c, f);
        re.* = wmul(k, a, f);
        im.* = wmul(k, b, f);
        return;
    }
    if (w_is_inf(a, f) or w_is_inf(b, f)) and w_is_finite(c, f) and w_is_finite(d, f) {
        a = wboxed(a, f);
        b = wboxed(b, f);
        re.* = wmul(winf(f), wadd(wmul(a, c, f), wmul(b, d, f), f), f);
        im.* = wmul(winf(f), wsub(wmul(b, c, f), wmul(a, d, f), f), f);
        return;
    }
    if (w_is_inf(c, f) or w_is_inf(d, f)) and w_is_finite(a, f) and w_is_finite(b, f) {
        c = wboxed(c, f);
        d = wboxed(d, f);
        re.* = wmul(z, wadd(wmul(a, c, f), wmul(b, d, f), f), f);
        im.* = wmul(z, wsub(wmul(b, c, f), wmul(a, d, f), f), f);
    }
}
