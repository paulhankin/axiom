// =============================================================================
// std/c/rt/math_trig.ax - sin, cos and tan (7.12.4.5-7, F.10.1.5-7)
// of the C library: the kernels of std/internal/math/trig.ax, with the
// library's errors (math.ax).
// =============================================================================
import "../../internal/math/trig.ax" as k;
import "math.ax" as c;

export fn sin(x: f64) f64 @multiversion("fma") {
    return k.sin(x, c.rep());
}

export fn cos(x: f64) f64 @multiversion("fma") {
    return k.cos(x, c.rep());
}

export fn tan(x: f64) f64 @multiversion("fma") {
    return k.tan(x, c.rep());
}
