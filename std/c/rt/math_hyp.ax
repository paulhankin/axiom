// =============================================================================
// std/c/rt/math_hyp.ax - sinh, cosh, tanh, asinh, acosh and atanh (7.12.5, F.10.2)
// of the C library: the kernels of std/internal/math/hyp.ax, with the
// library's errors (math.ax).
// =============================================================================
import "../../internal/math/hyp.ax" as k;
import "math.ax" as c;

export fn sinh(x: f64) f64 @multiversion("fma") {
    return k.sinh(x, c.rep());
}

export fn cosh(x: f64) f64 @multiversion("fma") {
    return k.cosh(x, c.rep());
}

export fn tanh(x: f64) f64 @multiversion("fma") {
    return k.tanh(x, c.rep());
}

export fn asinh(x: f64) f64 @multiversion("fma") {
    return k.asinh(x, c.rep());
}

export fn acosh(x: f64) f64 @multiversion("fma") {
    return k.acosh(x, c.rep());
}

export fn atanh(x: f64) f64 @multiversion("fma") {
    return k.atanh(x, c.rep());
}
