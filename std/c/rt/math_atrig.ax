// =============================================================================
// std/c/rt/math_atrig.ax - asin, acos, atan and atan2 (7.12.4.1-4, F.10.1.1-4)
// of the C library: the kernels of std/internal/math/atrig.ax, with the
// library's errors (math.ax).
// =============================================================================
import "../../internal/math/atrig.ax" as k;
import "math.ax" as c;

export fn asin(x: f64) f64 @multiversion("fma") {
    return k.asin(x, c.rep());
}

export fn acos(x: f64) f64 @multiversion("fma") {
    return k.acos(x, c.rep());
}

export fn atan(x: f64) f64 {
    return k.atan(x, c.rep());
}

export fn atan2(y: f64, x: f64) f64 @multiversion("fma") {
    return k.atan2(y, x, c.rep());
}
