// =============================================================================
// std/c/rt/core_errno.ax - where errno is when the system's C library is in
// the program too (on Linux when the program is linked against it, always
// on macOS): that library's own (its __errno_location, __error), so that
// errno is one object whichever library's function sets it, and an object
// compiled against the system's headers reads what the hosted library's
// functions set. Otherwise null: the hosted library's own
// (std/c/lib/core/__axc_errno.c).
// =============================================================================

extern "C" {
    // Linux (cmd/axiom/src/lstub.ax: 0, and a null errno, in a static program)
    fn ax_libc_linked() i32;
    fn __axiom_libc___errno_location() *mut i32;
    // macOS (cmd/axiom/src/mlink.ax binds __axiom_libc_<name> to libSystem's)
    fn __axiom_libc___error() *mut i32;
}

/// The system C library's errno for the calling thread, or null if the
/// program does not have that library.
export fn __axc_sys_errno() *mut i32 {
    if @target_os("linux") {
        if ax_libc_linked() != 0 {
            return __axiom_libc___errno_location();
        }
    } else if @target_os("macos") {
        return __axiom_libc___error();
    }
    return @ptr_from_int(*mut i32, 0);
}
