// =============================================================================
// std/c/rt/math_log.ax - log, log2, log10 and log1p (7.12.6.7-12, F.10.3.7-12)
// of the C library: the kernels of std/internal/math/log.ax, with the
// library's errors (math.ax).
// =============================================================================
import "../../internal/math/log.ax" as k;
import "math.ax" as c;

export fn log(x: f64) f64 {
    return k.log(x, c.rep());
}

export fn log2(x: f64) f64 @multiversion("fma") {
    return k.log2(x, c.rep());
}

export fn log10(x: f64) f64 @multiversion("fma") {
    return k.log10(x, c.rep());
}

export fn log1p(x: f64) f64 {
    return k.log1p(x, c.rep());
}
