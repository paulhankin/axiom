// =============================================================================
// std/c/rt/dfp_env.ax - the decimal floating-point environment for the C
// library's <fenv.h> (std/c/lib/math/fenv.c, fe_raw.c): the thread's decimal
// rounding direction (C23 7.6.7: fe_dec_getround, fe_dec_setround; the
// FE_DEC_ macros are decimal.ax's R_ numbers) and the exception flags that
// decimal operations raised (dec_env.ax), which <fenv.h> merges with the
// hardware's.
// =============================================================================
import "dec_env.ax" as env;

/// The decimal rounding direction (FE_DEC_TONEAREST 0 ... ).
export fn __axc_dec_round_get() u64 {
    return @as(u64, env.g_round);
}

/// Sets the decimal rounding direction to m: 0 if done, 1 if m is not one.
export fn __axc_dec_round_set(m: u64) u64 {
    if m > 4 {
        return 1;
    }
    env.g_round = @truncate(u32, m);
    return 0;
}

/// The flags decimal operations raised since they were last cleared.
export fn __axc_dec_flags() u64 {
    return @as(u64, env.g_flags);
}

/// Clears the flags of mask among them.
export fn __axc_dec_flags_clear(mask: u64) void {
    env.g_flags = env.g_flags & ~@truncate(u32, mask);
}
