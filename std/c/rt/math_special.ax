// =============================================================================
// std/c/rt/math_special.ax - erf, erfc, lgamma and tgamma (7.12.8, F.10.5), and C23's sinpi and cospi
// of the C library: the kernels of std/internal/math/special.ax, with the
// library's errors (math.ax).
// =============================================================================
import "../../internal/math/special.ax" as k;
import "math.ax" as c;

export fn erf(x: f64) f64 {
    return k.erf(x, c.rep());
}

export fn erfc(x: f64) f64 {
    return k.erfc(x, c.rep());
}

export fn sinpi(x: f64) f64 {
    return k.sinpi(x, c.rep());
}

export fn cospi(x: f64) f64 {
    return k.cospi(x, c.rep());
}

export fn tgamma(x: f64) f64 {
    return k.tgamma(x, c.rep());
}

export fn lgamma(x: f64) f64 {
    return k.lgamma(x, c.rep());
}
