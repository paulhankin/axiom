// =============================================================================
// std/c/rt/core.ax - the run-time layer of the C library's core part
// (std/c/lib/core): what it takes from the Axiom standard library, under C
// names (std/c/include/axc/core_impl.h, <stdlib.h>). Each export is
// generated only when C code refers to it (docs/c.md, "The C library").
//
// No int crosses (its width is the build's, --c-int): i64 is long long.
//
//   __axc_exit(status)              ends the process (std/os.exit)
//   __axc_exit_begin()              the start of exit (threads: one runs it)
//   __axc_write_err(p, n)           n bytes to standard error
//   __axc_parse_f64(p, n)           std/fmt.parse_float of a valid decimal
//   __axc_parse_f32(p, n)           ... and parse_float32
//   getenv(name)                    C's getenv (7.24.4.6)
//   __axc_system(string)            system's command processor (7.24.4.8)
// =============================================================================
import "../../fmt.ax" as fmt;
import "../../io.ax" as io;
import "../../mem.ax" as mem;
import "../../os.ax" as os;
import "../../os/fs.ax" as fs;

// (the host's processes directly: std/os/process imports std/thread, which
// would give every hosted WebAssembly program a shared memory)
import host "axiom" {
    fn ax_proc_spawn(spec: *u8, len: usize, stdio: *mut i32) i32;
    fn ax_proc_wait(h: i32, block: u32, status: *mut i32) i32;
}

fn nullp() *mut u8 {
    return @ptr_from_int(*mut u8, 0);
}

fn is_null(p: *u8) bool {
    return @int_from_ptr(p) == 0;
}

// The bytes of the NUL-terminated string at p (without the NUL).
fn cstr(p: *u8) []u8 {
    let mut n: usize = 0;
    while @slice_from_ptr(p, n + 1)[n] != 0 {
        n += 1;
    }
    return @slice_from_ptr(p, n);
}

// What exit does in a program with threads (std/c/rt/threads_spawn.ax sets
// it at its first thrd_create): exit_begin as exit starts (one thread runs
// it). The end itself is the host's from any thread (ax_exit, spec §12.8.5).
let mut has_thread_hooks: u32 = 0;
let mut exit_begin: fn() void = no_begin;

fn no_begin() void {}

/// (threads_spawn.ax) Sets exit's hook for a program with threads.
pub fn thread_hooks(begin: fn() void) void {
    if has_thread_hooks == 0 {
        exit_begin = begin;
        @atomic_store(&mut has_thread_hooks, 1);
    }
}

/// The start of exit (std/c/lib/core/exit.c): in a program with threads,
/// the first thread to call it goes on (so does a second call on that
/// thread, from an atexit function), any other waits for the end.
export fn __axc_exit_begin() void {
    if @atomic_load(&has_thread_hooks) != 0 {
        exit_begin();
    }
}

/// Ends the process with `status` at once (C's _Exit, and the end of exit),
/// from any thread.
export fn __axc_exit(status: i64) void {
    os.exit(@truncate(i32, status));
}

/// Writes n bytes at p to standard error (unbuffered).
export fn __axc_write_err(p: *u8, n: usize) void {
    io.stderr().write_all(@slice_from_ptr(p, n)) catch return;
}

/// The nearest double to the decimal at p (n bytes: digits, an optional
/// '.', an optional exponent part; std/c/lib/core/__axc_strtofp.c checks
/// the form), correctly rounded.
export fn __axc_parse_f64(p: *u8, n: usize) f64 {
    return fmt.parse_float(@slice_from_ptr(p, n)) catch 0.0;
}

/// As __axc_parse_f64, rounded once to float.
export fn __axc_parse_f32(p: *u8, n: usize) f32 {
    return fmt.parse_float32(@slice_from_ptr(p, n)) catch 0.0;
}

// -----------------------------------------------------------------------------
// getenv: the values asked for, by name, NUL-terminated. A value stays where
// it is until a later call for its name finds the environment changed.
// -----------------------------------------------------------------------------
struct EnvValue {
    name: []mut u8,
    value: []mut u8,  // with a NUL after it
    next: *mut EnvValue,
}

let mut env_values: *mut EnvValue = @ptr_from_int(*mut EnvValue, 0);

fn same(a: []u8, b: []u8) bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

// The lock of env_values (std/sync's Mutex protocol: 0 unlocked, 1
// locked, 2 locked with waiters): getenv may be called from any thread
// (7.24.4.6p2 asks only that the environment not be changed meanwhile).
let mut env_lock: u32 = 0;

fn lock_env() void {
    let mut s = @atomic_cas(&mut env_lock, 0, 1);
    if s == 0 {
        return;
    }
    if s != 2 {
        s = @atomic_xchg(&mut env_lock, 2);
    }
    while s != 0 {
        _ = @atomic_wait(&env_lock, 2, -1);
        s = @atomic_xchg(&mut env_lock, 2);
    }
}

fn unlock_env() void {
    if @atomic_sub(&mut env_lock, 1) != 1 {
        @atomic_store(&mut env_lock, 0);
        _ = @atomic_notify(&env_lock, 1);
    }
}

/// C's getenv: the value of the environment variable `name`, or null.
/// Thread-safe (env_lock).
export fn getenv(name: *u8) *mut u8 {
    lock_env();
    defer unlock_env();
    let key = cstr(name);
    let v = os.getenv(key) catch {
        return nullp();
    };
    defer mem.free(v);
    let mut e = env_values;
    while @int_from_ptr(e) != 0 {
        if same(e.name, key) {
            if not same(e.value[0..e.value.len - 1], v) {
                let nv = mem.alloc.[u8](v.len + 1) catch {
                    return nullp();
                };
                @mem_copy(nv[0..v.len], v);
                nv[v.len] = 0;
                mem.free(e.value);
                e.value = nv;
            }
            return e.value.ptr;
        }
        e = e.next;
    }
    let ne = mem.new.[EnvValue]() catch {
        return nullp();
    };
    let nm = mem.dup.[u8](key) catch {
        mem.destroy(ne);
        return nullp();
    };
    let nv = mem.alloc.[u8](v.len + 1) catch {
        mem.free(nm);
        mem.destroy(ne);
        return nullp();
    };
    @mem_copy(nv[0..v.len], v);
    nv[v.len] = 0;
    ne.name = nm;
    ne.value = nv;
    ne.next = env_values;
    env_values = ne;
    return nv.ptr;
}

// -----------------------------------------------------------------------------
// system
// -----------------------------------------------------------------------------

/// system's part (std/c/lib/core/system.c): with a null string, whether
/// there is a command processor
/// (/bin/sh on Linux and macOS, %ComSpec% (else cmd.exe) on Windows, none
/// under WebAssembly); else runs the command with it, waits, and returns
/// its status: on Linux and macOS as POSIX encodes it (the exit status
/// times 256, or the number of the signal that ended it), on Windows the
/// exit status; -1 if it could not be run. The command is the shell's text
/// as it is: sh -c's argument, and on Windows the command line
/// `cmd.exe /s /c "command"` (/s: the processor takes the text between the
/// first and the last quote verbatim, quotes inside it included).
export fn __axc_system(string: *u8) i64 {
    let windows = @target_os("windows");
    if @target_os("none") {
        return @as(i64, is_null(string)) - 1;
    }
    if is_null(string) {
        if windows {
            return 1;
        }
        return @as(i64, fs.exists("/bin/sh"));
    }
    let mut shell: []u8 = "/bin/sh";
    let mut flag: []u8 = "-c";
    let mut cmd = cstr(string);
    // (Windows: %ComSpec%'s value, and the argument of /s /c, ours to free)
    let mut comspec: []mut u8 = mem.alloc.[u8](0) catch return -1;
    defer mem.free(comspec);
    let mut wrapped: []mut u8 = mem.alloc.[u8](cmd.len + 9) catch return -1;
    defer mem.free(wrapped);
    if windows {
        shell = "cmd.exe";
        let cs = os.getenv("ComSpec") catch comspec;
        if cs.len > 0 {
            mem.free(comspec);
            comspec = cs;
            shell = comspec;
        }
        // (byte 1: the host puts the argument into the command line as it
        // is, std/internal/runtime/windows.ax)
        let pre = "\x01/s /c \"";
        @mem_copy(wrapped[0..pre.len], pre);
        @mem_copy(wrapped[pre.len..pre.len + cmd.len], cmd);
        wrapped[pre.len + cmd.len] = '"';
        flag = wrapped[0..pre.len + cmd.len + 1];
        cmd = "";
    }
    // the host's spawn takes argv\0...\0 env\0...\0 cwd (std/os/process)
    let mut env = os.environ() catch return -1;
    defer env.deinit();
    let mut n = shell.len + flag.len + cmd.len + 5;
    for i in @as(usize, 0)..env.len() {
        n += env.entry(i).len + 1;
    }
    let spec = mem.alloc.[u8](n) catch return -1;
    defer mem.free(spec);
    let mut k: usize = 0;
    let parts: [3][]u8 = [shell, flag, cmd];
    for a in parts {
        if windows and (a.len == 0) {
            continue;  // (the command is in flag's argument)
        }
        @mem_copy(spec[k..k + a.len], a);
        k += a.len;
        spec[k] = 0;
        k += 1;
    }
    spec[k] = 0;
    k += 1;
    for i in @as(usize, 0)..env.len() {
        let e = env.entry(i);
        @mem_copy(spec[k..k + e.len], e);
        k += e.len;
        spec[k] = 0;
        k += 1;
    }
    spec[k] = 0;
    k += 1;
    let mut sio: [3]i32 = [0, 0, 0];  // (the streams inherited)
    let h = ax_proc_spawn(spec.ptr, k, &mut sio[0]);
    if h < 0 {
        return -1;
    }
    let mut st: i32 = 0;
    let r = ax_proc_wait(h, 1, &mut st);
    if r <= 0 {
        return -1;
    }
    if windows {
        return @as(i64, st);
    }
    if r != 1 {
        return @as(i64, st & 0x7F);  // (killed by signal st)
    }
    return @as(i64, (st & 0xFF) << 8);
}
