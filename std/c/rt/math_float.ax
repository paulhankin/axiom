export fn fmaximumf(x: f32, y: f32) f32 {
    return @float_cast(f32, fmaximum(d(x), d(y)));
}

export fn fminimumf(x: f32, y: f32) f32 {
    return @float_cast(f32, fminimum(d(x), d(y)));
}

export fn fmaximum_magf(x: f32, y: f32) f32 {
    return @float_cast(f32, fmaximum_mag(d(x), d(y)));
}

export fn fminimum_magf(x: f32, y: f32) f32 {
    return @float_cast(f32, fminimum_mag(d(x), d(y)));
}

export fn fmaximum_numf(x: f32, y: f32) f32 {
    return @float_cast(f32, fmaximum_num(d(x), d(y)));
}

export fn fminimum_numf(x: f32, y: f32) f32 {
    return @float_cast(f32, fminimum_num(d(x), d(y)));
}

export fn fmaximum_mag_numf(x: f32, y: f32) f32 {
    return @float_cast(f32, fmaximum_mag_num(d(x), d(y)));
}

export fn fminimum_mag_numf(x: f32, y: f32) f32 {
    return @float_cast(f32, fminimum_mag_num(d(x), d(y)));
}

export fn sinpif(x: f32) f32 {
    return m.to_f32(sinpi(d(x)));
}

export fn cospif(x: f32) f32 {
    return m.to_f32(cospi(d(x)));
}

export fn sqrtf(x: f32) f32 {
    if x < 0.0 {
        return @float_cast(f32, m.domain());
    }
    return @sqrt(x);
}

export fn modff(x: f32, ip: *mut f32) f32 {
    let mut i: f64 = 0.0;
    let r = modf(d(x), &mut i);
    ip.* = @float_cast(f32, i);
    return @float_cast(f32, r);
}
