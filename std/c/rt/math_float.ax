// =============================================================================
// std/c/rt/math_float.ax - the float forms of <math.h>'s functions (C17
// 7.12): the elementary ones are std/internal/math/float.ax's kernels, with
// the library's errors (math.ax); the exact operations compute the double
// function of their argument (exactly converted), which is exact (and +,
// sqrt, fma-free ones correctly rounded: double has more than 2 x 24 + 2
// bits). nextafterf, the fma and the functions with int arguments are their
// own (math_exact.ax, and the C wrappers of std/c/lib/math/).
// =============================================================================
import "../../internal/math/float.ax" as k;
import "math.ax" as c;

// the double functions (this library's, the C units' names for them)
extern "C" {
    fn ceil(x: f64) f64;
    fn copysign(x: f64, y: f64) f64;
    fn fabs(x: f64) f64;
    fn fdim(x: f64, y: f64) f64;
    fn floor(x: f64) f64;
    fn fmax(x: f64, y: f64) f64;
    fn fmaximum(x: f64, y: f64) f64;
    fn fmaximum_mag(x: f64, y: f64) f64;
    fn fmaximum_mag_num(x: f64, y: f64) f64;
    fn fmaximum_num(x: f64, y: f64) f64;
    fn fmin(x: f64, y: f64) f64;
    fn fminimum(x: f64, y: f64) f64;
    fn fminimum_mag(x: f64, y: f64) f64;
    fn fminimum_mag_num(x: f64, y: f64) f64;
    fn fminimum_num(x: f64, y: f64) f64;
    fn fmod(x: f64, y: f64) f64;
    fn logb(x: f64) f64;
    fn modf(x: f64, ip: *mut f64) f64;
    fn remainder(x: f64, y: f64) f64;
    fn rint(x: f64) f64;
    fn round(x: f64) f64;
    fn roundeven(x: f64) f64;
    fn trunc(x: f64) f64;
}

inline fn d(x: f32) f64 {
    return @float_cast(f64, x);
}

export fn expf(x: f32) f32 {
    return k.expf(x, c.rep());
}

export fn exp2f(x: f32) f32 {
    return k.exp2f(x, c.rep());
}

export fn expm1f(x: f32) f32 {
    return k.expm1f(x, c.rep());
}

export fn exp10f(x: f32) f32 {
    return k.exp10f(x, c.rep());
}

export fn logf(x: f32) f32 {
    return k.logf(x, c.rep());
}

export fn log2f(x: f32) f32 {
    return k.log2f(x, c.rep());
}

export fn log10f(x: f32) f32 {
    return k.log10f(x, c.rep());
}

export fn log1pf(x: f32) f32 {
    return k.log1pf(x, c.rep());
}

export fn sinf(x: f32) f32 {
    return k.sinf(x, c.rep());
}

export fn cosf(x: f32) f32 {
    return k.cosf(x, c.rep());
}

export fn tanf(x: f32) f32 {
    return k.tanf(x, c.rep());
}

export fn asinf(x: f32) f32 {
    return k.asinf(x, c.rep());
}

export fn acosf(x: f32) f32 {
    return k.acosf(x, c.rep());
}

export fn atanf(x: f32) f32 {
    return k.atanf(x, c.rep());
}

export fn sinhf(x: f32) f32 {
    return k.sinhf(x, c.rep());
}

export fn coshf(x: f32) f32 {
    return k.coshf(x, c.rep());
}

export fn tanhf(x: f32) f32 {
    return k.tanhf(x, c.rep());
}

export fn asinhf(x: f32) f32 {
    return k.asinhf(x, c.rep());
}

export fn acoshf(x: f32) f32 {
    return k.acoshf(x, c.rep());
}

export fn atanhf(x: f32) f32 {
    return k.atanhf(x, c.rep());
}

export fn cbrtf(x: f32) f32 {
    return k.cbrtf(x, c.rep());
}

export fn erff(x: f32) f32 {
    return k.erff(x, c.rep());
}

export fn erfcf(x: f32) f32 {
    return k.erfcf(x, c.rep());
}

export fn lgammaf(x: f32) f32 {
    return k.lgammaf(x, c.rep());
}

export fn tgammaf(x: f32) f32 {
    return k.tgammaf(x, c.rep());
}

export fn powf(x: f32, y: f32) f32 {
    return k.powf(x, y, c.rep());
}

export fn atan2f(x: f32, y: f32) f32 {
    return k.atan2f(x, y, c.rep());
}

export fn hypotf(x: f32, y: f32) f32 {
    return k.hypotf(x, y, c.rep());
}

export fn ceilf(x: f32) f32 {
    return @float_cast(f32, ceil(d(x)));
}

export fn floorf(x: f32) f32 {
    return @float_cast(f32, floor(d(x)));
}

export fn truncf(x: f32) f32 {
    return @float_cast(f32, trunc(d(x)));
}

export fn roundf(x: f32) f32 {
    return @float_cast(f32, round(d(x)));
}

export fn roundevenf(x: f32) f32 {
    return @float_cast(f32, roundeven(d(x)));
}

export fn rintf(x: f32) f32 {
    return @float_cast(f32, rint(d(x)));
}

export fn fabsf(x: f32) f32 {
    return @float_cast(f32, fabs(d(x)));
}

export fn logbf(x: f32) f32 {
    return @float_cast(f32, logb(d(x)));
}

export fn fmodf(x: f32, y: f32) f32 {
    return @float_cast(f32, fmod(d(x), d(y)));
}

export fn remainderf(x: f32, y: f32) f32 {
    return @float_cast(f32, remainder(d(x), d(y)));
}

export fn copysignf(x: f32, y: f32) f32 {
    return @float_cast(f32, copysign(d(x), d(y)));
}

export fn fdimf(x: f32, y: f32) f32 {
    return @float_cast(f32, fdim(d(x), d(y)));
}

export fn fmaxf(x: f32, y: f32) f32 {
    return @float_cast(f32, fmax(d(x), d(y)));
}

export fn fminf(x: f32, y: f32) f32 {
    return @float_cast(f32, fmin(d(x), d(y)));
}

export fn fmaximumf(x: f32, y: f32) f32 {
    return @float_cast(f32, fmaximum(d(x), d(y)));
}

export fn fminimumf(x: f32, y: f32) f32 {
    return @float_cast(f32, fminimum(d(x), d(y)));
}

export fn fmaximum_magf(x: f32, y: f32) f32 {
    return @float_cast(f32, fmaximum_mag(d(x), d(y)));
}

export fn fminimum_magf(x: f32, y: f32) f32 {
    return @float_cast(f32, fminimum_mag(d(x), d(y)));
}

export fn fmaximum_numf(x: f32, y: f32) f32 {
    return @float_cast(f32, fmaximum_num(d(x), d(y)));
}

export fn fminimum_numf(x: f32, y: f32) f32 {
    return @float_cast(f32, fminimum_num(d(x), d(y)));
}

export fn fmaximum_mag_numf(x: f32, y: f32) f32 {
    return @float_cast(f32, fmaximum_mag_num(d(x), d(y)));
}

export fn fminimum_mag_numf(x: f32, y: f32) f32 {
    return @float_cast(f32, fminimum_mag_num(d(x), d(y)));
}

export fn sinpif(x: f32) f32 {
    return k.sinpif(x, c.rep());
}

export fn cospif(x: f32) f32 {
    return k.cospif(x, c.rep());
}

export fn sqrtf(x: f32) f32 {
    if x < 0.0 {
        return @float_cast(f32, c.domain());
    }
    return @sqrt(x);
}

export fn modff(x: f32, ip: *mut f32) f32 {
    let mut i: f64 = 0.0;
    let r = modf(d(x), &mut i);
    ip.* = @float_cast(f32, i);
    return @float_cast(f32, r);
}
