// =============================================================================
// std/c/rt/math_exp.ax - exp, exp2, expm1 and exp10 (C23) (7.12.6.1-3, F.10.3.1-3)
// of the C library: the kernels of std/internal/math/exp.ax, with the
// library's errors (math.ax).
// =============================================================================
import "../../internal/math/exp.ax" as k;
import "math.ax" as c;

export fn exp(x: f64) f64 {
    return k.exp(x, c.rep());
}

export fn exp2(x: f64) f64 {
    return k.exp2(x, c.rep());
}

export fn expm1(x: f64) f64 {
    return k.expm1(x, c.rep());
}

export fn exp10(x: f64) f64 @multiversion("fma") {
    return k.exp10(x, c.rep());
}
