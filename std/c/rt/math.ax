// =============================================================================
// std/c/rt/math.ax - how the C library's <math.h> functions (std/c/rt/math_*.ax)
// report their errors (7.12.1: errno and the floating-point exceptions,
// math_errhandling being MATH_ERRNO | MATH_ERREXCEPT where the target has
// exception flags): the Rep of the shared kernels (std/internal/math/core.ax)
// that calls the library's own __axc_math_err, and the error functions of
// the kernels with it.
// =============================================================================
import "../../internal/math/core.ax" as k;

// The C library's own functions (std/c/lib/math/m_err.c): errno and the
// exception flags.
extern "C" {
    fn __axc_math_err(e: i32, flags: u32) void;
}

fn report(e: i32, flags: u32) void {
    __axc_math_err(e, flags);
}

/// The C library's Rep: errno and the exception flags.
pub inline fn rep() k.Rep {
    return k.Rep.{ err: report };
}

/// A domain error: NaN, "invalid", EDOM.
pub fn domain() f64 {
    return k.domain(rep());
}

/// A pole error: an exact infinity of the given sign, "divide-by-zero", ERANGE.
pub fn pole(neg: bool) f64 {
    return k.pole(rep(), neg);
}

/// An overflow: +-inf, "overflow" and "inexact", ERANGE.
pub fn overflow(neg: bool) f64 {
    return k.overflow(rep(), neg);
}

/// An underflow to zero: +-0, "underflow" and "inexact", ERANGE.
pub fn underflow(neg: bool) f64 {
    return k.underflow(rep(), neg);
}

/// r, rounded from a nonzero true result: ERANGE if it is subnormal or zero.
pub inline fn check_tiny(r: f64) f64 {
    return k.check_tiny(rep(), r);
}

/// r, computed from finite operands: ERANGE if it is infinite.
pub inline fn check_huge(r: f64) f64 {
    return k.check_huge(rep(), r);
}

/// Sets errno alone (the flags having been raised by the arithmetic).
pub fn set_errno(e: i32) void {
    __axc_math_err(e, 0);
}

/// A subnormal result that was rounded: "underflow" and "inexact", ERANGE.
pub fn raise_underflow() void {
    __axc_math_err(k.ERANGE, k.FE_UNDERFLOW | k.FE_INEXACT);
}

/// Raises flags alone.
pub fn raise(flags: u32) void {
    __axc_math_err(0, flags);
}

/// A float result rounded from the double r (range errors of float).
pub inline fn to_f32(r: f64) f32 {
    return k.to_f32(rep(), r);
}

/// The float r of an exact operation on floats, rounded to float.
pub inline fn to_f32_exact(r: f64, nonzero: bool) f32 {
    return k.to_f32_exact(rep(), r, nonzero);
}
