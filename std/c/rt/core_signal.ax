// =============================================================================
// std/c/rt/core_signal.ax - the system's part of C's <signal.h>
// (std/c/lib/core/signal.c, raise.c): the library's signal numbers are
// Linux's (SIGINT 2, SIGILL 4, SIGABRT 6, SIGFPE 8, SIGSEGV 11, SIGTERM 15),
// which macOS shares.
//
//   __axc_os_signal(sig, action)   the system's action for sig: 0 its
//                                  default, 1 ignore, 2 call
//                                  __axc_sig_deliver(sig) (C's handler)
//   __axc_os_raise(sig)            sends sig to the calling thread
//
// Linux: rt_sigaction through the runtime's system call stub (ax_syscall;
// the return trampoline ax_sigreturn on x86-64, the kernel's on AArch64),
// with SA_SIGINFO, SA_RESTART and SA_ONSTACK (on the runtime's signal stack
// where the thread has one), the signal itself blocked while its handler
// runs; raise is tgkill. The first change of a signal saves the action
// before it, which the default (SIG_DFL) puts back: so SIGSEGV, SIGFPE and
// SIGILL go back to the runtime's crash report.
// macOS: libSystem's sigaction (SA_SIGINFO 0x40, SA_ONSTACK 1, SA_RESTART
// 2) and pthread_kill; the same saving.
// Windows: SIGINT is the console's Ctrl-C and Ctrl-Break, through a console
// control handler (which the system calls on a thread of its own). SIGSEGV,
// SIGFPE and SIGILL are the processor's exceptions in the program's own
// code (x64 and ARM64; see win_fault), while a handler is set: else they stay the
// crash reporter's (std/internal/runtime/windows.ax). raise sends nothing
// through the system (-1: the C side calls the handler at once).
// WebAssembly: none (-1).
// =============================================================================

extern "C" {
    fn __axc_sig_deliver(sig: i64) void;  // (no int crosses: core.ax)
    // Linux (lstub.ax)
    fn ax_syscall(n: isize, a: isize, b: isize, c: isize, d: isize, e: isize, f: isize) isize;
    fn ax_sigreturn() void;
    // macOS (libSystem)
    fn sigaction(sig: i32, act: *void, old: *mut void) i32;
    fn pthread_kill(t: usize, sig: i32) i32;
    fn pthread_self() usize;
    // Windows (kernel32, ntdll)
    fn SetConsoleCtrlHandler(handler: fn(u32) i32, add: i32) i32;
    fn AddVectoredExceptionHandler(first: u32, handler: fn(*mut usize) i32) *mut void;
    fn GetModuleHandleW(name: *u16) usize;
    fn GetCurrentThreadStackLimits(low: *mut usize, high: *mut usize) void;
    fn RtlRestoreContext(context: *mut u8, rec: *mut u8) void;
    // (cmd/axiom/src/plink.ax: x64, a frame on rbp, rsp aligned, call r8;
    // ARM64, its unwind information the CONTEXT at sp, blr x2)
    fn __axc_sig_trampoline() void;
}

// The kernel's struct sigaction on Linux (not the C library's).
struct LinuxAction {
    handler: usize,
    flags: u64,
    restorer: usize,
    mask: u64,
}

struct LinuxActionFn {
    handler: fn(i32, *mut void, *mut void) void,
    flags: u64,
    restorer: fn() void,
    mask: u64,
}

// macOS's struct sigaction.
struct DarwinAction {
    handler: usize,
    mask: u32,
    flags: i32,
}

struct DarwinActionFn {
    handler: fn(i32, *mut void, *mut void) void,
    mask: u32,
    flags: i32,
}

// the actions before the library's first change, per signal
let mut saved_linux: [32]LinuxAction = [LinuxAction.{ handler: 0, flags: 0, restorer: 0, mask: 0 }; 32];
let mut saved_darwin: [32]DarwinAction = [DarwinAction.{ handler: 0, mask: 0, flags: 0 }; 32];
let mut saved: [32]bool = [false; 32];
// Windows: SIGINT's action (0 default, 1 ignore, 2 deliver), and whether
// the console handler is set
let mut ctrl_action: i32 = 0;
let mut ctrl_set: bool = false;
// Windows: SIGILL's, SIGFPE's and SIGSEGV's actions (index the signal), and
// whether the exception handler is set; the image's addresses
let mut fault_action: [12]i32 = [0; 12];
let mut fault_set: bool = false;
let mut image_lo: usize = 0;
let mut image_hi: usize = 0;

// The library's signal for exception code c (the processor's, NTSTATUS
// values), or 0: SIGSEGV for an access violation, a page that could not be
// read in, misaligned data, an array bound; SIGFPE for integer division by
// zero or overflow and the floating-point exceptions (when unmasked);
// SIGILL for an illegal or privileged instruction (and the trap instruction
// of an Axiom run-time check, after its report, as on Linux). A stack
// overflow is not delivered: no stack is left for a handler (the crash
// reporter reports it).
fn fault_signal(c: u32) i32 {
    if (c == 0xc000_0005) or (c == 0xc000_0006) or (c == 0x8000_0002) or (c == 0xc000_008c) {
        return 11;
    }
    if (c == 0xc000_0094) or (c == 0xc000_0095) or ((c >= 0xc000_008d) and (c <= 0xc000_0093)) or (c == 0xc000_02b4) or
       (c == 0xc000_02b5) {
        return 8;
    }
    if (c == 0xc000_001d) or (c == 0xc000_0096) {
        return 4;
    }
    return 0;
}

// The exception handler (vectored: before the frames' and the crash
// reporter's, which was set earlier): a fault of the program's own code
// whose signal has a handler is delivered on the faulting thread, as the
// system delivers it elsewhere. The context is copied (to the thread's
// fault_ctx) and redirected as if the faulting instruction had called
// __axc_sig_trampoline (its address pushed below rsp, which on Windows
// holds nothing: the stack's guard is the system's), which calls
// win_deliver(sig, copy): the system's walks (a longjmp out of the
// handler, RtlUnwindEx; a stack trace) go from the handler through the
// faulting function. If the handler returns, the copy is restored: the
// instruction runs again (C17 7.14.1.1p3: undefined for a computational
// exception). A thread with less than 32 KiB of stack left gets the crash
// report.
fn win_fault(ep: *mut usize) i32 {
    let ptrs = @slice_from_ptr(ep, 2);
    let rec = @ptr_from_int(*mut u32, ptrs[0]);
    let ctx = @ptr_from_int(*mut u8, ptrs[1]);
    let sig = fault_signal(rec.*);
    let at = @ptr_from_int(*usize, ptrs[0] + 16).*;  // ExceptionAddress
    if (sig == 0) or (fault_action[@as(usize, @bit_cast(u32, sig))] != 2) or (at < image_lo) or (at >= image_hi) {
        return 0;  // EXCEPTION_CONTINUE_SEARCH
    }
    if @target_arch("aarch64") {
        return arm64_fault(ctx, sig);
    }
    let r = @slice_from_ptr(@ptr_from_int(*mut u64, @int_from_ptr(ctx)), 0x4d0 / 8);
    let rsp = @truncate(usize, r[0x98 / 8]);
    let mut low: usize = 0;
    let mut high: usize = 0;
    GetCurrentThreadStackLimits(&mut low, &mut high);
    if rsp < low + 32768 {
        return 0;
    }
    let copy = (@int_from_ptr(&fault_ctx[0]) + 15) & ~@as(usize, 15);
    @mem_copy(@slice_from_ptr(@ptr_from_int(*mut u8, copy), 0x4d0), @slice_from_ptr(ctx, 0x4d0));
    @ptr_from_int(*mut u64, rsp - 8).* = r[0xf8 / 8];  // the "return address": the faulting instruction's
    r[0x98 / 8] = @as(u64, rsp - 8);
    r[0xf8 / 8] = trampoline();
    r[0x80 / 8] = @as(u64, @bit_cast(u32, sig));            // rcx
    r[0x88 / 8] = @as(u64, copy);                           // rdx
    r[0xb8 / 8] = @as(u64, @bit_cast(usize, win_deliver));  // r8
    return -1;                                              // EXCEPTION_CONTINUE_EXECUTION
}

// ARM64: the same, but the copy of the context is on the faulting thread's
// stack, just below its stack pointer (ARM64 Windows keeps nothing below
// sp), and __axc_sig_trampoline is entered with sp at it: its unwind
// information is the code that says the CONTEXT at sp holds the caller's
// registers (MSFT_OP_CONTEXT), so that the system's walks go on in the
// faulting function with every register as it was there (x30 too, whatever
// the function). The ARM64 CONTEXT: x0-x28 from 8, sp at 256, pc at 264,
// 0x390 bytes. (Built and checked for its structure only: nothing here runs
// Windows on ARM64.)
fn arm64_fault(ctx: *mut u8, sig: i32) i32 {
    let r = @slice_from_ptr(@ptr_from_int(*mut u64, @int_from_ptr(ctx)), 0x390 / 8);
    let sp = @truncate(usize, r[256 / 8]);
    let mut low: usize = 0;
    let mut high: usize = 0;
    GetCurrentThreadStackLimits(&mut low, &mut high);
    if sp < low + 32768 {
        return 0;
    }
    let copy = (sp - 0x390) & ~@as(usize, 15);
    @mem_copy(@slice_from_ptr(@ptr_from_int(*mut u8, copy), 0x390), @slice_from_ptr(ctx, 0x390));
    r[256 / 8] = @as(u64, copy);
    r[264 / 8] = trampoline();
    r[8 / 8] = @as(u64, @bit_cast(u32, sig));             // x0
    r[16 / 8] = @as(u64, copy);                           // x1
    r[24 / 8] = @as(u64, @bit_cast(usize, win_deliver));  // x2
    return -1;                                            // EXCEPTION_CONTINUE_EXECUTION
}

// the context of the fault being delivered on this thread (16-aligned within)
threadlocal let mut fault_ctx: [0x4e0]u8 = [0; 0x4e0];

// __axc_sig_trampoline's address (plink.ax)
fn trampoline() u64 {
    return @as(u64, @bit_cast(usize, __axc_sig_trampoline));
}

fn win_deliver(sig: u64, context: *mut u8) void {
    __axc_sig_deliver(@bit_cast(i64, sig));
    RtlRestoreContext(context, @ptr_from_int(*mut u8, 0));
}

fn win_fault_signal(sig: i32, action: i32) i32 {
    fault_action[@as(usize, @bit_cast(u32, sig))] = action;
    if not fault_set {
        let base = GetModuleHandleW(@ptr_from_int(*u16, 0));
        let pe = base + @as(usize, @ptr_from_int(*u32, base + 0x3c).*);
        image_lo = base;
        image_hi = base + @as(usize, @ptr_from_int(*u32, pe + 24 + 56).*);  // SizeOfImage
        if @int_from_ptr(AddVectoredExceptionHandler(1, win_fault)) == 0 {
            return -2;
        }
        fault_set = true;
    }
    return 0;
}

fn on_signal(sig: i32, si: *mut void, uc: *mut void) void {
    _ = si;
    _ = uc;
    __axc_sig_deliver(@as(i64, sig));
}

fn on_ctrl(ev: u32) i32 {
    if ev > 1 {
        return 0;  // (not Ctrl-C or Ctrl-Break: the next handler's)
    }
    if ctrl_action == 2 {
        __axc_sig_deliver(2);
        return 1;
    }
    return @as(i32, ctrl_action == 1);
}

fn linux_sigaction(sig: i32, act: usize, old: usize) isize {
    let mut n: isize = 13;  // x86-64
    if @target_arch("aarch64") {
        n = 134;
    }
    return ax_syscall(n, @as(isize, sig), @bit_cast(isize, act), @bit_cast(isize, old), 8, 0, 0);
}

fn linux_signal(sig: i32, action: i32) i32 {
    let k = @as(usize, @bit_cast(u32, sig));
    if not saved[k] {
        if linux_sigaction(sig, 0, @int_from_ptr(&mut saved_linux[k])) < 0 {
            return -2;
        }
        saved[k] = true;
    }
    let mut r: isize = 0;
    if action == 2 {
        // SA_SIGINFO | SA_ONSTACK | SA_RESTART (| SA_RESTORER on x86-64)
        let mut flags: u64 = 0x0000_0004 | 0x0800_0000 | 0x1000_0000;
        if @target_arch("x86_64") {
            flags |= 0x0400_0000;
        }
        let sa = LinuxActionFn.{ handler: on_signal, flags: flags, restorer: ax_sigreturn, mask: 0 };
        r = linux_sigaction(sig, @int_from_ptr(&sa), 0);
    } else if action == 1 {
        let sa = LinuxAction.{ handler: 1, flags: 0, restorer: 0, mask: 0 };
        r = linux_sigaction(sig, @int_from_ptr(&sa), 0);
    } else {
        let sa = saved_linux[k];
        r = linux_sigaction(sig, @int_from_ptr(&sa), 0);
    }
    if r < 0 {
        return -2;
    }
    return 0;
}

fn darwin_signal(sig: i32, action: i32) i32 {
    let k = @as(usize, @bit_cast(u32, sig));
    if not saved[k] {
        if sigaction(sig, @ptr_from_int(*void, 0), @ptr_cast(*mut void, &mut saved_darwin[k])) != 0 {
            return -2;
        }
        saved[k] = true;
    }
    let mut r: i32 = 0;
    if action == 2 {
        let sa = DarwinActionFn.{ handler: on_signal, mask: 0, flags: 0x40 | 0x1 | 0x2 };
        r = sigaction(sig, @ptr_cast(*void, &sa), @ptr_from_int(*mut void, 0));
    } else if action == 1 {
        let sa = DarwinAction.{ handler: 1, mask: 0, flags: 0 };
        r = sigaction(sig, @ptr_cast(*void, &sa), @ptr_from_int(*mut void, 0));
    } else {
        let sa = saved_darwin[k];
        r = sigaction(sig, @ptr_cast(*void, &sa), @ptr_from_int(*mut void, 0));
    }
    if r != 0 {
        return -2;
    }
    return 0;
}

/// Sets the system's action for the library's signal sig (one of the six;
/// signal.c checks): 0 default, 1 ignore, 2 deliver to __axc_sig_deliver.
/// 0, -1 where the system has no such signal (only raise delivers it), or
/// -2 if the system refused.
export fn __axc_os_signal(sig64: i64, action64: i64) i64 {
    let sig = @truncate(i32, sig64);
    let action = @truncate(i32, action64);
    if @target_os("linux") {
        return @as(i64, linux_signal(sig, action));
    }
    if @target_os("macos") {
        return @as(i64, darwin_signal(sig, action));
    }
    if @target_os("windows") {
        if (sig == 4) or (sig == 8) or (sig == 11) {
            return @as(i64, win_fault_signal(sig, action));
        }
        if sig != 2 {
            return -1;
        }
        ctrl_action = action;
        if not ctrl_set {
            if SetConsoleCtrlHandler(on_ctrl, 1) == 0 {
                return -2;
            }
            ctrl_set = true;
        }
        return 0;
    }
    return -1;
}

/// Sends the library's signal sig to the calling thread through the system:
/// 0 (its handler has returned, or its action was taken), or -1 where the
/// system has no such signal.
export fn __axc_os_raise(sig64: i64) i64 {
    let sig = @truncate(i32, sig64);
    if @target_os("linux") {
        let mut nr: [3]isize = [39, 186, 234];  // getpid, gettid, tgkill (x86-64)
        if @target_arch("aarch64") {
            nr = [172, 178, 131];
        }
        let pid = ax_syscall(nr[0], 0, 0, 0, 0, 0, 0);
        let tid = ax_syscall(nr[1], 0, 0, 0, 0, 0, 0);
        if ax_syscall(nr[2], pid, tid, @as(isize, sig), 0, 0, 0) < 0 {
            return -1;
        }
        return 0;
    }
    if @target_os("macos") {
        if pthread_kill(pthread_self(), sig) != 0 {
            return -1;
        }
        return 0;
    }
    return -1;
}
