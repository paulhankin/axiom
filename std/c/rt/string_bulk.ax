// =============================================================================
// std/c/rt/string_bulk.ax - the bytes of <string.h>'s memcpy, memmove and
// memset (C23 7.26.2.1, 7.26.2.3, 7.26.6.1) on WebAssembly with the
// bulk-memory extension, where their C sources (std/c/lib/string/) call
// these: memory.copy (which allows overlap, as memmove needs) and
// memory.fill, which the engine does at the host's speed. Under node they
// were faster than the C loops at every size: twice at 16 bytes, 30 to
// 300 times from 256 bytes (those loops go a byte at a time when the two
// addresses are aligned differently).
// =============================================================================

/// n bytes from s to d (which may overlap); d.
export fn __axc_mem_copy(d: *mut u8, s: *u8, n: usize) *mut u8 {
    if n != 0 {
        @mem_copy(@slice_from_ptr(d, n), @slice_from_ptr(s, n));
    }
    return d;
}

/// n bytes at d set to c; d.
export fn __axc_mem_set(d: *mut u8, c: u8, n: usize) *mut u8 {
    if n != 0 {
        @mem_set(@slice_from_ptr(d, n), c);
    }
    return d;
}
