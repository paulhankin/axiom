// =============================================================================
// std/c/rt/threads_spawn_none.ax - threads_spawn.ax's functions for a
// program that cannot have threads: on WebAssembly without the atomics
// extension (--features=-atomics), where the C library links this module in
// threads_spawn.ax's place (std/c/lib/index: its A line). thrd_create
// fails with thrd_error, nothing can be joined or detached, and thrd_exit
// on the only thread runs its destructors and returns (the C side then
// calls exit(EXIT_SUCCESS)).
// =============================================================================
import "threads.ax" as th;

/// thrd_create: thrd_error (no threads).
export fn __axc_thrd_spawn(func: fn(*mut void) i64, arg: *mut void, out: *mut *mut th.CThread) i64 {
    _ = func;
    _ = arg;
    _ = out;
    return th.ERROR;
}

/// thrd_join: thrd_error (there is no other thread).
export fn __axc_thrd_join(t: *mut th.CThread, res: *mut i64) i64 {
    _ = t;
    _ = res;
    return th.ERROR;
}

/// thrd_detach: thrd_error.
export fn __axc_thrd_detach(t: *mut th.CThread) i64 {
    _ = t;
    return th.ERROR;
}

/// thrd_exit on the only thread: its destructors; then exit(EXIT_SUCCESS).
export fn __axc_thrd_exit(res: i64) void {
    let t = th.current();
    th.run_dtors();
    t.result = res;
    t.done = 1;
}
