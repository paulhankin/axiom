// tan u = u + u z (Q0 + Q1 z + Q2 z^2), z = u^2, |u| <= 1/512 (relative error 2^-73.6)
pub const TAN_Q0: f64 = 0.3333333333333333;
pub const TAN_Q1: f64 = 0.13333333333295527;
pub const TAN_Q2: f64 = 0.05396842085294496;

// e^r = 1 + r + r^2 (P0 + P1 r), |r| <= ln2/256 (relative error 2^-40.7)
pub const EXPF_P0: f64 = 0.5000003055249702;
pub const EXPF_P1: f64 = 0.16666672777165645;

// log1p(r) = r + r^2 (P0 + P1 r + P2 r^2 + P3 r^3) for |r| <= the bound of LOG_P (relative error 2^-44.3)
pub const LOGF_P0: f64 = -0.49999999995717453;
pub const LOGF_P1: f64 = 0.33333333329662573;
pub const LOGF_P2: f64 = -0.2500056674122501;
pub const LOGF_P3: f64 = 0.20000485778549748;

// sin r = r + r z (P0 + P1 z + P2 z^2 + P3 z^3), z = r^2, |r| <= pi/4 (relative error 2^-36.8)
pub const SINF_P0: f64 = -0.16666666644202188;
pub const SINF_P1: f64 = 0.008333329326706468;
pub const SINF_P2: f64 = -0.00019839260753528926;
pub const SINF_P3: f64 = 2.717341837262255e-06;

// cos r = 1 + z (P0 + P1 z + ... + P4 z^4), z = r^2, |r| <= pi/4 (relative error 2^-42.8)
pub const COSF_P0: f64 = -0.49999999999639166;
pub const COSF_P1: f64 = 0.04166666656722289;
pub const COSF_P2: f64 = -0.0013888880996652385;
pub const COSF_P3: f64 = 2.479897719475613e-05;
pub const COSF_P4: f64 = -2.7173380557468284e-07;

// lgamma near its zeros below -2: rows of x0 (hi, lo), the radius r, a power of
