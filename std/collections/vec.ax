// =============================================================================
// std/collections/vec.ax - growable arrays and slice algorithms.
// =============================================================================

import "../mem.ax" as mem;

pub error VecError { Empty, NotFound, OutOfMemory }

/// A growable array. Its elements live in memory from mem.alloc; `deinit`
/// frees them.
/// Slices returned by `items()` and `items_mut()` are invalidated by any
/// operation that grows the vector.
pub nocopy struct Vec[T] {
    buf: []mut T,  // capacity == buf.len
    count: usize,

    pub fn init() Self {
        return Self.{ buf: [], count: 0 };
    }

    pub fn with_capacity(cap: usize) { OutOfMemory }!Self {
        let mut v = Self.init();
        v.reserve(cap)!;
        return v;
    }

    pub fn deinit(self: *mut Self) void {
        mem.free(self.buf);
        self.buf = [];
        self.count = 0;
    }

    pub fn len(self: *Self) usize {
        return self.count;
    }

    pub fn capacity(self: *Self) usize {
        return self.buf.len;
    }

    /// Ensures room for `extra` more elements without reallocating.
    pub fn reserve(self: *mut Self, extra: usize) { OutOfMemory }!void {
        let need = @add_checked(self.count, extra) catch return error.OutOfMemory;
        if need <= self.buf.len {
            return;
        }
        let mut cap = @max(self.buf.len, 4);
        while cap < need {
            cap = @mul_checked(cap, 2) catch return error.OutOfMemory;
        }
        self.buf = mem.realloc(self.buf, cap)!;
    }

    pub fn push(self: *mut Self, x: T) { OutOfMemory }!void {
        if self.count == self.buf.len {
            self.reserve(1)!;
        }
        self.buf[self.count] = x;
        self.count += 1;
    }

    pub fn pop(self: *mut Self) ?T {
        if self.count == 0 {
            return .none;
        }
        self.count -= 1;
        return .some(self.buf[self.count]);
    }

    pub fn last(self: *Self) ?T {
        if self.count == 0 {
            return .none;
        }
        return .some(self.buf[self.count - 1]);
    }

    /// Element `i`; traps if `i >= len`.
    pub fn get(self: *Self, i: usize) T {
        return self.buf[..self.count][i];
    }

    pub fn set(self: *mut Self, i: usize, x: T) void {
        self.buf[..self.count][i] = x;
    }

    pub fn get_ptr(self: *mut Self, i: usize) *mut T {
        return &mut self.buf[..self.count][i];
    }

    /// The live elements.
    pub fn items(self: *Self) []T {
        return self.buf[..self.count];
    }

    /// The live elements, mutable.
    pub fn items_mut(self: *mut Self) []mut T {
        return self.buf[..self.count];
    }

    pub fn clear(self: *mut Self) void {
        self.count = 0;
    }

    pub fn truncate(self: *mut Self, n: usize) void {
        if n < self.count {
            self.count = n;
        }
    }

    pub fn extend(self: *mut Self, xs: []T) { OutOfMemory }!void {
        if xs.len == 0 {
            return;
        }
        // xs may be part of this Vec, which growing moves: copy from where it went
        let base = @int_from_ptr(self.buf.ptr);
        let at = @int_from_ptr(xs.ptr);
        let size = @max(@size_of(T), 1);
        if (at >= base) and ((at - base) / size < self.buf.len) {
            let off = (at - base) / size;
            self.reserve(xs.len)!;
            @mem_copy(self.buf[self.count..self.count + xs.len], self.buf[off..off + xs.len]);
        } else {
            self.reserve(xs.len)!;
            @mem_copy(self.buf[self.count..self.count + xs.len], xs);
        }
        self.count += xs.len;
    }

    /// Inserts at `i` (0 <= i <= len), shifting later elements right.
    pub fn insert(self: *mut Self, i: usize, x: T) { OutOfMemory }!void {
        if i > self.count {
            @trap();
        }
        self.reserve(1)!;
        let mut j = self.count;
        while j > i {
            self.buf[j] = self.buf[j - 1];
            j -= 1;
        }
        self.buf[i] = x;
        self.count += 1;
    }

    /// Removes element `i`, shifting later elements left. Traps if `i >= len`.
    pub fn remove(self: *mut Self, i: usize) T {
        let x = self.buf[..self.count][i];
        for j in i..self.count - 1 {
            self.buf[j] = self.buf[j + 1];
        }
        self.count -= 1;
        return x;
    }

    /// Removes element `i` in O(1) by moving the last element into its place.
    pub fn swap_remove(self: *mut Self, i: usize) T {
        let x = self.buf[..self.count][i];
        self.buf[i] = self.buf[self.count - 1];
        self.count -= 1;
        return x;
    }

    pub fn sort[const LESS: fn(T, T) bool](self: *mut Self) void {
        sort.[T, LESS](self.buf[..self.count]);
    }

    pub fn sort_dyn(self: *mut Self, less: fn(T, T) bool) void {
        sort_dyn.[T](self.buf[..self.count], less);
    }

    /// Sorts keeping equal elements in order (allocates scratch memory).
    pub fn sort_stable[const LESS: fn(T, T) bool](self: *mut Self) { OutOfMemory }!void {
        sort_stable.[T, LESS](self.buf[..self.count])!;
    }

    /// Sorts keeping equal elements in order using a runtime comparator.
    pub fn sort_stable_dyn(self: *mut Self, less: fn(T, T) bool) { OutOfMemory }!void {
        sort_stable_dyn.[T](self.buf[..self.count], less)!;
    }
}

// -----------------------------------------------------------------------------
// Slice algorithms
// -----------------------------------------------------------------------------

// The sorts take a context value passed to every comparison (`ctx`), so a
// comparison can depend on data outside the elements (sort indices by the
// keys they point at, a collation, a direction). `sort` calls `sort_with`
// with a dummy context, and `*_dyn` wraps the runtime comparator in a
// small context struct.

struct DynLess[T] {
    f: fn(T, T) bool,
}

struct DynCtxLess[C, T] {
    ctx: C,
    f: fn(C, T, T) bool,
}

inline fn call_plain[T, const LESS: fn(T, T) bool](_ctx: u8, a: T, b: T) bool {
    return LESS(a, b);
}

inline fn call_dyn[T](d: DynLess.[T], a: T, b: T) bool {
    return d.f(a, b);
}

inline fn call_dyn_ctx[C, T](d: DynCtxLess.[C, T], a: T, b: T) bool {
    return d.f(d.ctx, a, b);
}

fn swap[T](xs: []mut T, i: usize, j: usize) void {
    let tmp = xs[i];
    xs[i] = xs[j];
    xs[j] = tmp;
}

fn sift_down[T, C, const LESS: fn(C, T, T) bool](xs: []mut T, start: usize, end: usize, ctx: C) void {
    let mut root = start;
    loop {
        let child = (2 * root) + 1;
        if child >= end {
            return;
        }
        let mut top = root;
        if LESS(ctx, xs[top], xs[child]) {
            top = child;
        }
        if ((child + 1) < end) and LESS(ctx, xs[top], xs[child + 1]) {
            top = child + 1;
        }
        if top == root {
            return;
        }
        swap(xs, root, top);
        root = top;
    }
}

fn heapsort[T, C, const LESS: fn(C, T, T) bool](xs: []mut T, ctx: C) void {
    let n = xs.len;
    let mut start = n / 2;
    while start > 0 {
        start -= 1;
        sift_down.[T, C, LESS](xs, start, n, ctx);
    }
    let mut end = n;
    while end > 1 {
        end -= 1;
        swap(xs, 0, end);
        sift_down.[T, C, LESS](xs, 0, end, ctx);
    }
}

// Stable: an element moves left only past greater ones.
fn insertion_sort[T, C, const LESS: fn(C, T, T) bool](xs: []mut T, ctx: C) void {
    for i in @as(usize, 1)..xs.len {
        let x = xs[i];
        let mut j = i;
        while (j > 0) and LESS(ctx, x, xs[j - 1]) {
            xs[j] = xs[j - 1];
            j -= 1;
        }
        xs[j] = x;
    }
}

/// Sorts in place in O(n log n), not stable.
pub fn sort[T, const LESS: fn(T, T) bool](xs: []mut T) void {
    sort_with.[T, u8, call_plain.[T, LESS]](xs, 0);
}

/// Sorts in place in O(n log n) using a runtime comparator, not stable.
pub fn sort_dyn[T](xs: []mut T, less: fn(T, T) bool) void {
    sort_with.[T, DynLess.[T], call_dyn.[T]](xs, DynLess.[T].{ f: less });
}

/// Sorts in place in O(n log n) time and no extra memory, not stable
/// (introsort: quicksort on a median of three, heapsort past a depth of
/// 2 log2 n, insertion sort for short ranges). `LESS(ctx, a, b)` must be a
/// strict weak order.
pub fn sort_with[T, C, const LESS: fn(C, T, T) bool](xs: []mut T, ctx: C) void {
    let mut depth: usize = 0;
    let mut n = xs.len;
    while n > 1 {
        depth += 2;
        n >>= 1;
    }
    introsort.[T, C, LESS](xs, ctx, depth);
}

/// `sort_with` using a runtime comparator.
pub fn sort_with_dyn[T, C](xs: []mut T, ctx: C, less: fn(C, T, T) bool) void {
    sort_with.[T, DynCtxLess.[C, T], call_dyn_ctx.[C, T]](xs, DynCtxLess.[C, T].{ ctx: ctx, f: less });
}

fn introsort[T, C, const LESS: fn(C, T, T) bool](all: []mut T, ctx: C, max_depth: usize) void {
    let mut xs = all;
    let mut depth = max_depth;
    loop {
        let n = xs.len;
        if n <= 16 {
            insertion_sort.[T, C, LESS](xs, ctx);
            return;
        }
        if depth == 0 {
            heapsort.[T, C, LESS](xs, ctx);
            return;
        }
        depth -= 1;
        // The median of the first, middle and last elements is the pivot;
        // the other two bound the scans below.
        let m = n / 2;
        if LESS(ctx, xs[m], xs[0]) {
            swap(xs, m, 0);
        }
        if LESS(ctx, xs[n - 1], xs[m]) {
            swap(xs, n - 1, m);
            if LESS(ctx, xs[m], xs[0]) {
                swap(xs, m, 0);
            }
        }
        let p = xs[m];
        let mut i: usize = 0;
        let mut j = n - 1;
        loop {
            while LESS(ctx, xs[i], p) {
                i += 1;
            }
            while LESS(ctx, p, xs[j]) {
                j -= 1;
            }
            if i >= j {
                break;
            }
            swap(xs, i, j);
            i += 1;
            j -= 1;
        }
        // xs[..j + 1] <= p <= xs[j + 1..], both non-empty: recurse into the
        // smaller part and loop on the larger, so the stack stays O(log n).
        let split = j + 1;
        if split < (n - split) {
            introsort.[T, C, LESS](xs[..split], ctx, depth);
            xs = xs[split..];
        } else {
            introsort.[T, C, LESS](xs[split..], ctx, depth);
            xs = xs[..split];
        }
    }
}

/// Sorts in place keeping equal elements in their order (merge sort,
/// O(n log n)); allocates n / 2 elements of scratch memory.
pub fn sort_stable[T, const LESS: fn(T, T) bool](xs: []mut T) { OutOfMemory }!void {
    sort_stable_with.[T, u8, call_plain.[T, LESS]](xs, 0)!;
}

/// `sort_stable` using a runtime comparator.
pub fn sort_stable_dyn[T](xs: []mut T, less: fn(T, T) bool) { OutOfMemory }!void {
    sort_stable_with.[T, DynLess.[T], call_dyn.[T]](xs, DynLess.[T].{ f: less })!;
}

/// sort_stable with a context passed to every comparison.
pub fn sort_stable_with[T, C, const LESS: fn(C, T, T) bool](xs: []mut T, ctx: C) { OutOfMemory }!void {
    if xs.len <= 16 {
        insertion_sort.[T, C, LESS](xs, ctx);
        return;
    }
    let buf = mem.alloc.[T]((xs.len + 1) / 2)!;
    defer mem.free(buf);
    merge_sort.[T, C, LESS](xs, buf, ctx);
}

/// `sort_stable_with` using a runtime comparator.
pub fn sort_stable_with_dyn[T, C](xs: []mut T, ctx: C, less: fn(C, T, T) bool) { OutOfMemory }!void {
    sort_stable_with.[T, DynCtxLess.[C, T], call_dyn_ctx.[C, T]](xs, DynCtxLess.[C, T].{ ctx: ctx, f: less })!;
}

// Sorts xs using buf (at least half as long) for the left halves.
fn merge_sort[T, C, const LESS: fn(C, T, T) bool](xs: []mut T, buf: []mut T, ctx: C) void {
    let n = xs.len;
    if n <= 16 {
        insertion_sort.[T, C, LESS](xs, ctx);
        return;
    }
    let mid = n / 2;
    merge_sort.[T, C, LESS](xs[..mid], buf, ctx);
    merge_sort.[T, C, LESS](xs[mid..], buf, ctx);
    if not LESS(ctx, xs[mid], xs[mid - 1]) {
        return;  // already in order
    }
    // Merge: the left half moves to buf, then the two are merged back into
    // xs; an equal pair takes the left element first, which keeps it stable.
    @mem_copy(buf[..mid], xs[..mid]);
    let mut i: usize = 0;
    let mut j = mid;
    let mut k: usize = 0;
    while (i < mid) and (j < n) {
        if LESS(ctx, xs[j], buf[i]) {
            xs[k] = xs[j];
            j += 1;
        } else {
            xs[k] = buf[i];
            i += 1;
        }
        k += 1;
    }
    while i < mid {
        xs[k] = buf[i];
        i += 1;
        k += 1;
    }
}

fn is_sorted_ctx[T, C, const LESS: fn(C, T, T) bool](xs: []T, ctx: C) bool {
    for i in @as(usize, 1)..xs.len {
        if LESS(ctx, xs[i], xs[i - 1]) {
            return false;
        }
    }
    return true;
}

/// Whether xs is in order under `LESS` (no element less than the one
/// before it).
pub fn is_sorted[T, const LESS: fn(T, T) bool](xs: []T) bool {
    return is_sorted_ctx.[T, u8, call_plain.[T, LESS]](xs, 0);
}

/// Whether xs is in order under `less`.
pub fn is_sorted_dyn[T](xs: []T, less: fn(T, T) bool) bool {
    return is_sorted_ctx.[T, DynLess.[T], call_dyn.[T]](xs, DynLess.[T].{ f: less });
}

fn lower_bound_ctx[T, C, const LESS: fn(C, T, T) bool](xs: []T, x: T, ctx: C) usize {
    let mut lo: usize = 0;
    let mut hi = xs.len;
    while lo < hi {
        let mid = lo + ((hi - lo) / 2);
        if LESS(ctx, xs[mid], x) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// In a slice sorted by `LESS`, the index of the first element not less
/// than x (xs.len if there is none): where x would be inserted first.
pub fn lower_bound[T, const LESS: fn(T, T) bool](xs: []T, x: T) usize {
    return lower_bound_ctx.[T, u8, call_plain.[T, LESS]](xs, x, 0);
}

/// `lower_bound` using a runtime comparator.
pub fn lower_bound_dyn[T](xs: []T, x: T, less: fn(T, T) bool) usize {
    return lower_bound_ctx.[T, DynLess.[T], call_dyn.[T]](xs, x, DynLess.[T].{ f: less });
}

fn upper_bound_ctx[T, C, const LESS: fn(C, T, T) bool](xs: []T, x: T, ctx: C) usize {
    let mut lo: usize = 0;
    let mut hi = xs.len;
    while lo < hi {
        let mid = lo + ((hi - lo) / 2);
        if LESS(ctx, x, xs[mid]) {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    return lo;
}

/// In a slice sorted by `LESS`, the index of the first element greater
/// than x (xs.len if there is none): where x would be inserted last.
pub fn upper_bound[T, const LESS: fn(T, T) bool](xs: []T, x: T) usize {
    return upper_bound_ctx.[T, u8, call_plain.[T, LESS]](xs, x, 0);
}

/// `upper_bound` using a runtime comparator.
pub fn upper_bound_dyn[T](xs: []T, x: T, less: fn(T, T) bool) usize {
    return upper_bound_ctx.[T, DynLess.[T], call_dyn.[T]](xs, x, DynLess.[T].{ f: less });
}

pub fn reverse[T](xs: []mut T) void {
    if xs.len < 2 {
        return;
    }
    let mut i: usize = 0;
    let mut j = xs.len - 1;
    while i < j {
        let tmp = xs[i];
        xs[i] = xs[j];
        xs[j] = tmp;
        i += 1;
        j -= 1;
    }
}

pub fn index_of[T: Eq](xs: []T, x: T) ?usize {
    for i in 0..xs.len {
        if xs[i] == x {
            return .some(i);
        }
    }
    return .none;
}

fn binary_search_ctx[T, C, const LESS: fn(C, T, T) bool](xs: []T, x: T, ctx: C) ?usize {
    let mut lo: usize = 0;
    let mut hi = xs.len;
    while lo < hi {
        let mid = lo + ((hi - lo) / 2);
        if LESS(ctx, xs[mid], x) {
            lo = mid + 1;
        } else if LESS(ctx, x, xs[mid]) {
            hi = mid;
        } else {
            return .some(mid);
        }
    }
    return .none;
}

/// Binary search in a slice sorted by `LESS`. Returns the index of an element
/// equal to `x`, or `.none`.
pub fn binary_search[T, const LESS: fn(T, T) bool](xs: []T, x: T) ?usize {
    return binary_search_ctx.[T, u8, call_plain.[T, LESS]](xs, x, 0);
}

/// `binary_search` using a runtime comparator.
pub fn binary_search_dyn[T](xs: []T, x: T, less: fn(T, T) bool) ?usize {
    return binary_search_ctx.[T, DynLess.[T], call_dyn.[T]](xs, x, DynLess.[T].{ f: less });
}

// -----------------------------------------------------------------------------
// Tests (axiom test std/collections/vec.ax)
// -----------------------------------------------------------------------------

fn test_less(a: i32, b: i32) bool {
    return a < b;
}

test "push, pop and grow" {
    let mut v = Vec.[i32].init();
    defer v.deinit();
    for i in @as(i32, 0)..100 {
        v.push(i)!;
    }
    @expect_eq(v.len(), 100);
    @expect(v.capacity() >= 100);
    @expect_eq(v.last() ?? {
        @trap();
    }, 99);
    @expect_eq(v.pop() ?? {
        @trap();
    }, 99);
    @expect_eq(v.last() ?? {
        @trap();
    }, 98);
    @expect_eq(v.get(10), 10);

    let mut vc = Vec.[i32].with_capacity(16)!;
    defer vc.deinit();
    @expect(vc.capacity() >= 16);
}

test "pop and last on empty return none" {
    let mut v = Vec.[u8].init();
    if let .some(got) = v.pop() {
        _ = got;
        @trap();
    }
    if let .some(got) = v.last() {
        _ = got;
        @trap();
    }
}

test "get out of range traps" expect trap(T0001) {
    let mut v = Vec.[u8].init();
    v.push(1)!;
    _ = v.get(1);
}

test "insert, remove, swap_remove" {
    let mut v = Vec.[i32].init();
    defer v.deinit();
    let xs: [4]i32 = [1, 2, 3, 4];
    v.extend(xs[..])!;
    v.insert(0, 0)!;
    @expect_eq(v.remove(2), 2);
    @expect_eq(v.swap_remove(0), 0);
    @expect_eq(v.get(0), 4);
    @expect_eq(v.len(), 3);
}

test "sort and binary_search" {
    let mut xs: [9]i32 = [5, -3, 8, 0, 8, 2, -7, 1, 9];
    sort.[i32, test_less](xs[..]);
    for i in 1..xs.len {
        @expect(xs[i - 1] <= xs[i]);
    }
    let found = binary_search.[i32, test_less](xs[..], 2) ?? {
        @trap();
    };
    @expect_eq(xs[found], 2);
    @expect_eq(binary_search_dyn(xs[..], 2, test_less) ?? {
        @trap();
    }, found);
    if let .some(got) = binary_search.[i32, test_less](xs[..], 999) {
        _ = got;
        @trap();
    }
    if let .some(got) = binary_search_dyn(xs[..], 999, test_less) {
        _ = got;
        @trap();
    }
    reverse(xs[..]);
    @expect_eq(xs[0], 9);
    @expect_eq(index_of(xs[..], -7) ?? {
        @trap();
    }, 8);
    if let .some(got) = index_of(xs[..], 999) {
        _ = got;
        @trap();
    }

    let mut ys: [9]i32 = [5, -3, 8, 0, 8, 2, -7, 1, 9];
    sort_dyn(ys[..], test_less);
    @expect(is_sorted_dyn(ys[..], test_less));
    @expect(is_sorted.[i32, test_less](ys[..]));
    let mut v = Vec.[i32].init();
    defer v.deinit();
    v.extend(ys[..])!;
    reverse(v.items_mut());
    v.sort.[test_less]();
    @expect(is_sorted.[i32, test_less](v.items()));
    reverse(v.items_mut());
    v.sort_dyn(test_less);
    @expect(is_sorted.[i32, test_less](v.items()));
}

test "extend from itself" {
    let mut v = Vec.[u32].init();
    defer v.deinit();
    for i in @as(u32, 0)..4 {
        v.push(100 + i)!;
    }
    // growing moves the buffer the argument points into
    v.extend(v.items())!;
    v.extend(v.items()[1..3])!;
    let want: [10]u32 = [100, 101, 102, 103, 100, 101, 102, 103, 101, 102];
    @expect_eq(v.len(), 10);
    for k in @as(usize, 0)..10 {
        @expect_eq(v.get(k), want[k]);
    }
}

struct Rec {
    key: u32,
    seq: u32,
}

fn rec_less(a: Rec, b: Rec) bool {
    return a.key < b.key;
}

fn by_key(keys: []u32, a: usize, b: usize) bool {
    return keys[a] < keys[b];
}

fn fill_pattern(xs: []mut u32, pattern: u32, seed: *mut u64) void {
    let n = xs.len;
    for i in @as(usize, 0)..n {
        seed.* = (seed.* *% 6364136223846793005) +% 1442695040888963407;
        let r = @truncate(u32, seed.* >> 33);
        let mut v = r;  // 0: random
        if pattern == 1 {
            v = r % 4;  // many equal
        } else if pattern == 2 {
            v = @truncate(u32, i);  // sorted
        } else if pattern == 3 {
            v = @truncate(u32, n - i);  // reversed
        } else if pattern == 4 {
            v = @truncate(u32, @min(i, n - i));  // organ pipe
        } else if pattern == 5 {
            v = 7;  // all equal
        } else if pattern == 6 {
            v = @truncate(u32, i) ^ ((r % 16) / 15);  // nearly sorted
        }
        xs[i] = v;
    }
}

inline fn u32_less(a: u32, b: u32) bool {
    return a < b;
}

test "sort, sort_with and sort_stable on many sizes and patterns" {
    let sizes: [12]usize = [0, 1, 2, 3, 15, 16, 17, 31, 100, 257, 1000, 5000];
    let mut buf: [5000]u32 = [0; 5000];
    let mut seed: u64 = 1;
    for n in sizes {
        for pattern in @as(u32, 0)..7 {
            for algo in @as(u32, 0)..4 {
                let xs = buf[..n];
                fill_pattern(xs, pattern, &mut seed);
                // A checksum of the multiset: sum and xor of hashed values.
                let mut sum: u64 = 0;
                let mut x: u64 = 0;
                for v in xs {
                    sum +%= @as(u64, v) *% 0x9e3779b97f4a7c15;
                    x ^= (@as(u64, v) + 1) *% 0xff51afd7ed558ccd;
                }
                if algo == 0 {
                    sort.[u32, u32_less](xs);
                } else if algo == 1 {
                    sort_stable.[u32, u32_less](xs)!;
                } else if algo == 2 {
                    sort_dyn(xs, u32_less);
                } else {
                    sort_stable_dyn(xs, u32_less)!;
                }
                @expect(is_sorted.[u32, u32_less](xs));
                @expect(is_sorted_dyn(xs, u32_less));
                for v in xs {
                    sum -%= @as(u64, v) *% 0x9e3779b97f4a7c15;
                    x ^= (@as(u64, v) + 1) *% 0xff51afd7ed558ccd;
                }
                @expect((sum == 0) and (x == 0));
            }
        }
    }
    // Sort indices by the keys they point at.
    let keys: [6]u32 = [50, 10, 40, 10, 30, 0];
    let mut idx: [6]usize = [0, 1, 2, 3, 4, 5];
    sort_with.[usize, []u32, by_key](idx[..], keys[..]);
    @expect_eq(idx[0], 5);
    @expect_eq(keys[idx[1]], 10);
    @expect_eq(idx[5], 0);
    let mut idx2: [6]usize = [0, 1, 2, 3, 4, 5];
    sort_with_dyn(idx2[..], keys[..], by_key);
    @expect_eq(idx2[0], 5);
    @expect_eq(keys[idx2[1]], 10);
    @expect_eq(idx2[5], 0);
    let mut idx3: [6]usize = [0, 1, 2, 3, 4, 5];
    sort_stable_with.[usize, []u32, by_key](idx3[..], keys[..])!;
    @expect_eq(idx3[0], 5);
    @expect_eq(idx3[1], 1);
    @expect_eq(idx3[2], 3);
    let mut idx4: [6]usize = [0, 1, 2, 3, 4, 5];
    sort_stable_with_dyn(idx4[..], keys[..], by_key)!;
    @expect_eq(idx4[0], 5);
    @expect_eq(idx4[1], 1);
    @expect_eq(idx4[2], 3);
}

test "sort_stable keeps equal elements in order" {
    let mut recs: [3000]Rec = [Rec.{ key: 0, seq: 0 }; 3000];
    let mut seed: u64 = 9;
    for i in @as(usize, 0)..recs.len {
        seed = (seed *% 6364136223846793005) +% 1442695040888963407;
        recs[i] = Rec.{ key: @truncate(u32, seed >> 40) % 50, seq: @truncate(u32, i) };
    }
    sort_stable.[Rec, rec_less](recs[..])!;
    for i in @as(usize, 1)..recs.len {
        @expect(recs[i - 1].key <= recs[i].key);
        if recs[i - 1].key == recs[i].key {
            @expect(recs[i - 1].seq < recs[i].seq);
        }
    }
    let mut v = Vec.[Rec].init();
    defer v.deinit();
    v.push(Rec.{ key: 2, seq: 0 })!;
    v.push(Rec.{ key: 1, seq: 1 })!;
    v.push(Rec.{ key: 2, seq: 2 })!;
    v.push(Rec.{ key: 1, seq: 3 })!;
    v.sort_stable.[rec_less]()!;
    @expect_eq(v.get(0).seq, 1);
    @expect_eq(v.get(1).seq, 3);
    @expect_eq(v.get(2).seq, 0);
    @expect_eq(v.get(3).seq, 2);

    let mut vd = Vec.[Rec].init();
    defer vd.deinit();
    vd.push(Rec.{ key: 2, seq: 0 })!;
    vd.push(Rec.{ key: 1, seq: 1 })!;
    vd.push(Rec.{ key: 2, seq: 2 })!;
    vd.push(Rec.{ key: 1, seq: 3 })!;
    vd.sort_stable_dyn(rec_less)!;
    @expect_eq(vd.get(0).seq, 1);
    @expect_eq(vd.get(1).seq, 3);
    @expect_eq(vd.get(2).seq, 0);
    @expect_eq(vd.get(3).seq, 2);
}

test "lower_bound and upper_bound" {
    let xs: [7]u32 = [1, 3, 3, 3, 5, 8, 8];
    @expect_eq(lower_bound.[u32, u32_less](xs[..], 3), 1);
    @expect_eq(upper_bound.[u32, u32_less](xs[..], 3), 4);
    @expect_eq(lower_bound.[u32, u32_less](xs[..], 0), 0);
    @expect_eq(upper_bound.[u32, u32_less](xs[..], 8), 7);
    @expect_eq(lower_bound.[u32, u32_less](xs[..], 6), 5);
    @expect_eq(lower_bound.[u32, u32_less](xs[..0], 6), 0);
    @expect(is_sorted.[u32, u32_less](xs[..]));
    let ys: [3]u32 = [2, 1, 3];
    @expect(not is_sorted.[u32, u32_less](ys[..]));

    @expect_eq(lower_bound_dyn(xs[..], 3, u32_less), 1);
    @expect_eq(upper_bound_dyn(xs[..], 3, u32_less), 4);
    @expect(is_sorted_dyn(xs[..], u32_less));
    @expect(not is_sorted_dyn(ys[..], u32_less));
}
