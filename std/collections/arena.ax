// =============================================================================
// std/collections/arena.ax - arena (bump) allocation: many small allocations freed
// together.
//
//     let mut a = arena.Arena.init();
//     defer a.deinit();
//     let s = a.dup("text")!;                 // copied into the arena
//     let xs = a.copy.[u32](items)!;          // any element type
//
// Parsers use one per document, so that a whole tree is freed at once.
// =============================================================================

import "../mem.ax" as mem;
import "vec.ax" as vec;

pub error ArenaError { OutOfMemory, Empty, NotFound }

pub struct Arena {
    chunks: vec.Vec.[[]mut u8],
    cur: []mut u8,
    used: usize,

    pub fn init() Arena {
        return Arena.{ chunks: vec.Vec.[[]mut u8].init(), cur: @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0), used: 0 };
    }

    /// Frees everything allocated from the arena.
    pub fn deinit(self: *mut Arena) void {
        for c in self.chunks.items() {
            mem.free(c);
        }
        self.chunks.deinit();
        self.cur = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
        self.used = 0;
    }

    /// n bytes, 8-byte aligned (contents undefined).
    pub fn bytes(self: *mut Arena, n: usize) ArenaError![]mut u8 {
        let start = (self.used + 7) & ~@as(usize, 7);
        if (start <= self.cur.len) and (n <= (self.cur.len - start)) {
            self.used = start + n;
            return self.cur[start..start + n];
        }
        if n >= 16384 {
            // a big block gets a chunk of its own
            let big = mem.alloc.[u8](n)!;
            self.chunks.push(big) catch |e| {
                mem.free(big);
                return e;
            };
            return big;
        }
        let size = @max(@min(@max(self.cur.len * 2, 4096), 1048576), n);
        let c = mem.alloc.[u8](size)!;
        self.chunks.push(c) catch |e| {
            mem.free(c);
            return e;
        };
        self.cur = c;
        self.used = n;
        return c[..n];
    }

    /// A copy of s in the arena.
    pub fn dup(self: *mut Arena, s: []u8) ArenaError![]u8 {
        if s.len == 0 {
            return "";
        }
        let b = self.bytes(s.len)!;
        @mem_copy(b, s);
        return b;
    }

    /// A copy of xs in the arena (T needs at most 8-byte alignment).
    pub fn copy[T](self: *mut Arena, xs: []T) ArenaError![]T {
        if xs.len == 0 {
            return @slice_from_ptr(@ptr_from_int(*T, @align_of(T)), 0);
        }
        let n = @mul_checked(xs.len, @size_of(T)) catch return error.OutOfMemory;
        let b = self.bytes(n)!;
        let out = @cast_slice(T, b);
        @mem_copy(out, xs);
        return out;
    }
}

test "arenas" {
    let mut a = Arena.init();
    defer a.deinit();
    let s = a.dup("hello")!;
    @expect_eq(s, "hello");
    let xs: [3]u64 = [1, 2, 3];
    let c = a.copy.[u64](xs[..])!;
    @expect_eq(c[2], 3);
    @expect_eq(@int_from_ptr(c.ptr) % 8, 0);
    for i in @as(usize, 0)..10000 {
        let b = a.bytes((i % 50) + 1)!;
        b[0] = 1;
    }
    let big = a.bytes(100000)!;
    big[99999] = 7;
    @expect_eq(a.dup("")!.len, 0);
}
