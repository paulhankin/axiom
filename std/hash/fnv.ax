// =============================================================================
// std/hash/fnv.ax - FNV-1 and FNV-1a (Fowler-Noll-Vo), 32 and 64 bits.
//
//     let h = fnv.fnv1a_64(data);
//
//     let mut s = fnv.OFFSET64;                 // streaming: carry the state
//     s = fnv.fnv1a_64_update(s, part1);
//     s = fnv.fnv1a_64_update(s, part2);        // s is the hash
//
// FNV is a byte-at-a-time multiplicative hash: tiny and fast on short keys,
// and the hash named by formats and protocols that use it (FNV-1a above
// all). It is unkeyed, so an adversary can make collisions at will: for
// tables of untrusted keys use std/hash (keyed SipHash). Constants from the
// FNV specification (draft-eastlake-fnv), whose test strings these pass.
// =============================================================================

/// The 32-bit offset basis: the hash of no bytes.
pub const OFFSET32: u32 = 0x811c9dc5;
/// The 32-bit FNV prime.
pub const PRIME32: u32 = 0x01000193;
/// The 64-bit offset basis: the hash of no bytes.
pub const OFFSET64: u64 = 0xcbf29ce484222325;
/// The 64-bit FNV prime.
pub const PRIME64: u64 = 0x100000001b3;

/// FNV-1 of data, 32 bits.
pub fn fnv1_32(data: []u8) u32 {
    return fnv1_32_update(OFFSET32, data);
}

/// FNV-1a of data, 32 bits.
pub fn fnv1a_32(data: []u8) u32 {
    return fnv1a_32_update(OFFSET32, data);
}

/// FNV-1 of data, 64 bits.
pub fn fnv1_64(data: []u8) u64 {
    return fnv1_64_update(OFFSET64, data);
}

/// FNV-1a of data, 64 bits.
pub fn fnv1a_64(data: []u8) u64 {
    return fnv1a_64_update(OFFSET64, data);
}

/// Continues an FNV-1 (32-bit) hash h with more data; start from OFFSET32.
pub fn fnv1_32_update(h: u32, data: []u8) u32 {
    let mut x = h;
    for b in data {
        x = (x *% PRIME32) ^ @as(u32, b);
    }
    return x;
}

/// Continues an FNV-1a (32-bit) hash h with more data; start from OFFSET32.
pub fn fnv1a_32_update(h: u32, data: []u8) u32 {
    let mut x = h;
    for b in data {
        x = (x ^ @as(u32, b)) *% PRIME32;
    }
    return x;
}

/// Continues an FNV-1 (64-bit) hash h with more data; start from OFFSET64.
pub fn fnv1_64_update(h: u64, data: []u8) u64 {
    let mut x = h;
    for b in data {
        x = (x *% PRIME64) ^ @as(u64, b);
    }
    return x;
}

/// Continues an FNV-1a (64-bit) hash h with more data; start from OFFSET64.
pub fn fnv1a_64_update(h: u64, data: []u8) u64 {
    let mut x = h;
    for b in data {
        x = (x ^ @as(u64, b)) *% PRIME64;
    }
    return x;
}

// -----------------------------------------------------------------------------
// Tests: the specification's examples, and a Python transcription of it
// over bytes (i * 31 + 7) & 255
// -----------------------------------------------------------------------------

struct Vector {
    n: usize,
    f1_32: u32,
    f1a_32: u32,
    f1_64: u64,
    f1a_64: u64,
}

let FNV_VECTORS: [17]Vector = [
    Vector.{ n: 0, f1_32: 0x811c9dc5, f1a_32: 0x811c9dc5, f1_64: 0xcbf29ce484222325, f1a_64: 0xcbf29ce484222325 },
    Vector.{ n: 1, f1_32: 0x050c5d18, f1a_32: 0x020c5866, f1_64: 0xaf63bd4c8601b7d8, f1a_64: 0xaf63ba4c8601b2c6 },
    Vector.{ n: 2, f1_32: 0x0a768cee, f1a_32: 0x796eecc0, f1_64: 0x08328107b4eb642e, f1a_64: 0x08287007b4e2f2a0 },
    Vector.{ n: 3, f1_32: 0x669fdaef, f1a_32: 0xae9e555f, f1_64: 0xd9356e186bfb3a6f, f1a_64: 0xbfa942185da2bb1f },
    Vector.{ n: 4, f1_32: 0x7ca5a659, f1a_32: 0x1e402be1, f1_64: 0x1104827f7be44af9, f1a_64: 0x4f56ca671b849201 },
    Vector.{ n: 5, f1_32: 0x91c4de98, f1a_32: 0x01044b46, f1_64: 0xcef4b79f84eb6598, f1a_64: 0x550c6f33c244f2e6 },
    Vector.{ n: 7, f1_32: 0x8b04bb9f, f1a_32: 0x27b49bd7, f1_64: 0x8e86173fcffa205f, f1a_64: 0xd35312172464add7 },
    Vector.{ n: 8, f1_32: 0x77735bad, f1a_32: 0xb8505795, f1_64: 0x27f9e06e6605018d, f1a_64: 0x7ad4f452d7125475 },
    Vector.{ n: 9, f1_32: 0xb79951a8, f1a_32: 0x90799bde, f1_64: 0xf299e8975a81a268, f1a_64: 0xca2fb2c37425a67e },
    Vector.{ n: 15, f1_32: 0x0800ab1f, f1a_32: 0x89e5b19f, f1_64: 0x1b9b815ac7c04b1f, f1a_64: 0x783fbfa2d48ea91f },
    Vector.{ n: 16, f1_32: 0xb80d6115, f1a_32: 0x5b9612c5, f1_64: 0xa987ec416bbfa575, f1a_64: 0xe2fc68af2e6a7d25 },
    Vector.{ n: 17, f1_32: 0xd20fd4f8, f1a_32: 0x5f3ea4b6, f1_64: 0xd19be82a16a62538, f1a_64: 0x1d63b3abdef3cbd6 },
    Vector.{ n: 31, f1_32: 0x4f73983f, f1a_32: 0xb781a08f, f1_64: 0xb819789495b8bcbf, f1a_64: 0xc4bf699c47db1d8f },
    Vector.{ n: 32, f1_32: 0x51f8abe5, f1a_32: 0x280f4fc5, f1_64: 0x8c04a37a68e8b845, f1a_64: 0x2c5dbb8e1952bfa5 },
    Vector.{ n: 33, f1_32: 0xef769998, f1a_32: 0x32199286, f1_64: 0xd49a0e0043711dd8, f1a_64: 0xb604f475079afd26 },
    Vector.{ n: 100, f1_32: 0x307a2039, f1a_32: 0xdb23aea1, f1_64: 0xb756a1d639666a99, f1a_64: 0xf275ebb2a87c0581 },
    Vector.{ n: 299, f1_32: 0xe87a3c2f, f1a_32: 0x026e3b67, f1_64: 0x43fd7c24377c6f2f, f1a_64: 0xd04c365932c9ee27 },
];

test "fnv known answers" {
    @expect_eq(fnv1a_32(""), 0x811c9dc5);
    @expect_eq(fnv1a_32("a"), 0xe40c292c);
    @expect_eq(fnv1a_32("foobar"), 0xbf9cf968);
    @expect_eq(fnv1_32("a"), 0x050c5d7e);
    @expect_eq(fnv1_32("foobar"), 0x31f0b262);
    @expect_eq(fnv1a_64(""), 0xcbf29ce484222325);
    @expect_eq(fnv1a_64("a"), 0xaf63dc4c8601ec8c);
    @expect_eq(fnv1a_64("foobar"), 0x85944171f73967e8);
    @expect_eq(fnv1_64("a"), 0xaf63bd4c8601b7be);
    @expect_eq(fnv1_64("foobar"), 0x340d8765a4dda9c2);
}

test "fnv vectors and streaming" {
    let mut data: [300]u8 = [0; 300];
    for i in @as(usize, 0)..300 {
        data[i] = @truncate(u8, (i * 31) + 7);
    }
    for v in FNV_VECTORS {
        let d = data[..v.n];
        @expect_eq(fnv1_32(d), v.f1_32);
        @expect_eq(fnv1a_32(d), v.f1a_32);
        @expect_eq(fnv1_64(d), v.f1_64);
        @expect_eq(fnv1a_64(d), v.f1a_64);
        let half = v.n / 2;
        @expect_eq(fnv1a_64_update(fnv1a_64_update(OFFSET64, d[..half]), d[half..]), v.f1a_64);
        @expect_eq(fnv1_32_update(fnv1_32_update(OFFSET32, d[..half]), d[half..]), v.f1_32);
    }
}
