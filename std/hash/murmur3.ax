    Vector.{ n: 33, seed: 0x00000000, h32: 0xd7d09e89, h1: 0xfa0bc7309230cdeb, h2: 0x3721c70c96532164 },
    Vector.{ n: 33, seed: 0x9747b28c, h32: 0xfc12f764, h1: 0x85aac9ff6999f2cd, h2: 0x39846019246bd5b1 },
    Vector.{ n: 100, seed: 0x00000000, h32: 0x34c6bb9c, h1: 0x024e0b490a12c598, h2: 0x6dbbc2144bf00383 },
    Vector.{ n: 100, seed: 0x9747b28c, h32: 0x7bd4d1c7, h1: 0xb502601d6c7fdf71, h2: 0xe920da50d1bca772 },
    Vector.{ n: 299, seed: 0x00000000, h32: 0xbc71a2f9, h1: 0xf3360c687d2df2cd, h2: 0x218eacf29e2d9198 },
    Vector.{ n: 299, seed: 0x9747b28c, h32: 0x2c362cb5, h1: 0xf5744c65867b9a26, h2: 0x9a5e27a45fab7357 },
    Vector.{ n: 0, seed: 0x00000001, h32: 0x514e28b7, h1: 0x4610abe56eff5cb5, h2: 0x51622daa78f83583 },
    Vector.{ n: 0, seed: 0xffffffff, h32: 0x81f16f39, h1: 0x6af1df4d9d3bc9ec, h2: 0x857421121ee6446b },
    Vector.{ n: 1, seed: 0x00000001, h32: 0x16b344ea, h1: 0x587362219a67c0a2, h2: 0x84ad1332679ba0f3 },
    Vector.{ n: 1, seed: 0xffffffff, h32: 0xf261df19, h1: 0x45dcefa96b6ae797, h2: 0xffd58bdb8c6c0470 },
    Vector.{ n: 16, seed: 0x00000001, h32: 0xe4fc49d4, h1: 0x927c77d3376549f8, h2: 0x963f2cee2fc573a7 },
    Vector.{ n: 16, seed: 0xffffffff, h32: 0x1ef58c6d, h1: 0x15a053dfed5d7c31, h2: 0x50a3530fc7cab351 },
];

test "murmur3 vectors" {
    let mut data: [300]u8 = [0; 300];
    for i in @as(usize, 0)..300 {
        data[i] = @truncate(u8, (i * 31) + 7);
    }
    for v in MM_VECTORS {
        let d = data[..v.n];
        @expect_eq(x86_32(d, v.seed), v.h32);
        let h = x64_128(d, v.seed);
        @expect_eq(h.h1, v.h1);
        @expect_eq(h.h2, v.h2);
    }
}

test "murmur3 known answers" {
    @expect_eq(x86_32("", 1), 0x514e28b7);
    @expect_eq(x86_32("Hello, world!", 1234), 0xfaf6cdb3);
    let b = x64_128("The quick brown fox jumps over the lazy dog", 0).bytes();
    let want: [16]u8 = [0x6c, 0x1b, 0x07, 0xbc, 0x7b, 0xbc, 0x4b, 0xe3, 0x47, 0x93, 0x9a, 0xc4, 0xa9, 0x3c, 0x43, 0x7a];
    @expect_eq(b[..], want[..]);
}
