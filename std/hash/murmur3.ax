    Vector.{ n: 17, seed: 0x00000000, h32: 0x3e8a519e, h1: 0xeb322f84309de524, h2: 0x082aa01f2728481b },
    Vector.{ n: 17, seed: 0x9747b28c, h32: 0xa2cdd862, h1: 0x0b583dc53f00886e, h2: 0x9f17c457949bc501 },
    Vector.{ n: 31, seed: 0x00000000, h32: 0x46d9904d, h1: 0x49db93da32960569, h2: 0x90b21e6033dc6c1e },
