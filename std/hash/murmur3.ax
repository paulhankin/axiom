// =============================================================================
// std/hash/murmur3.ax - MurmurHash3 (Austin Appleby): x86_32 and x64_128.
//
//     let h = murmur3.x86_32(data, seed);           // u32
//     let w = murmur3.x64_128(data, seed);          // Hash128 { h1, h2 }
//     let b = w.bytes();                            // [16]u8, as the reference writes it
//
// Fast, well-mixed, non-cryptographic hashes, the ones named by Bloom
// filters, Cassandra, Kafka partitioners and many file formats. They are
// unkeyed (the seed is no secret: collisions independent of the seed are
// known), so for tables of untrusted keys use std/hash. Follows
// MurmurHash3.cpp from SMHasher; checked against the Python mmh3 package,
// which wraps it.
// =============================================================================

fn le32(b: []u8, i: usize) u32 {
    return @as(u32, b[i]) | (@as(u32, b[i + 1]) << 8) | (@as(u32, b[i + 2]) << 16) | (@as(u32, b[i + 3]) << 24);
}

fn le64(b: []u8, i: usize) u64 {
    return @as(u64, le32(b, i)) | (@as(u64, le32(b, i + 4)) << 32);
}

/// The tail bytes from i on (fewer than a block), little-endian.
fn tail64(b: []u8, i: usize, n: usize) u64 {
    let mut x: u64 = 0;
    for k in @as(usize, 0)..n {
        x |= @as(u64, b[i + k]) << @as(u64, 8 * k);
    }
    return x;
}

fn fmix32(x: u32) u32 {
    let mut h = x;
    h ^= h >> 16;
    h *%= 0x85ebca6b;
    h ^= h >> 13;
    h *%= 0xc2b2ae35;
    h ^= h >> 16;
    return h;
}

fn fmix64(x: u64) u64 {
    let mut k = x;
    k ^= k >> 33;
    k *%= 0xff51afd7ed558ccd;
    k ^= k >> 33;
    k *%= 0xc4ceb9fe1a85ec53;
    k ^= k >> 33;
    return k;
}

const C1_32: u32 = 0xcc9e2d51;
const C2_32: u32 = 0x1b873593;
const C1_64: u64 = 0x87c37b91114253d5;
const C2_64: u64 = 0x4cf5ad432745937f;

/// MurmurHash3_x86_32 of data.
pub fn x86_32(data: []u8, seed: u32) u32 {
    let mut h = seed;
    let nblocks = data.len / 4;
    for b in @as(usize, 0)..nblocks {
        let mut k = le32(data, 4 * b);
        k *%= C1_32;
        k = @rotl(k, 15);
        k *%= C2_32;
        h ^= k;
        h = @rotl(h, 13);
        h = (h *% 5) +% 0xe6546b64;
    }
    let rest = data.len % 4;
    if rest > 0 {
        let mut k = @truncate(u32, tail64(data, 4 * nblocks, rest));
        k *%= C1_32;
        k = @rotl(k, 15);
        k *%= C2_32;
        h ^= k;
    }
    h ^= @truncate(u32, data.len);
    return fmix32(h);
}

/// A 128-bit MurmurHash3 result: the reference's two words.
pub struct Hash128 {
    h1: u64,
    h2: u64,

    /// The 16 bytes the reference writes (h1 then h2, little-endian).
    pub fn bytes(self: Hash128) [16]u8 {
        let mut out: [16]u8 = [0; 16];
        for i in @as(usize, 0)..8 {
            out[i] = @truncate(u8, self.h1 >> @as(u64, 8 * i));
            out[i + 8] = @truncate(u8, self.h2 >> @as(u64, 8 * i));
        }
        return out;
    }
}

/// MurmurHash3_x64_128 of data.
pub fn x64_128(data: []u8, seed: u32) Hash128 {
    let mut h1 = @as(u64, seed);
    let mut h2 = @as(u64, seed);
    let nblocks = data.len / 16;
    for b in @as(usize, 0)..nblocks {
        let mut k1 = le64(data, 16 * b);
        let mut k2 = le64(data, (16 * b) + 8);
        k1 *%= C1_64;
        k1 = @rotl(k1, 31);
        k1 *%= C2_64;
        h1 ^= k1;
        h1 = @rotl(h1, 27);
        h1 +%= h2;
        h1 = (h1 *% 5) +% 0x52dce729;
        k2 *%= C2_64;
        k2 = @rotl(k2, 33);
        k2 *%= C1_64;
        h2 ^= k2;
        h2 = @rotl(h2, 31);
        h2 +%= h1;
        h2 = (h2 *% 5) +% 0x38495ab5;
    }
    let base = 16 * nblocks;
    let rest = data.len % 16;
    if rest > 8 {
        let mut k2 = tail64(data, base + 8, rest - 8);
        k2 *%= C2_64;
        k2 = @rotl(k2, 33);
        k2 *%= C1_64;
        h2 ^= k2;
    }
    if rest > 0 {
        let mut k1 = tail64(data, base, @min(rest, 8));
        k1 *%= C1_64;
        k1 = @rotl(k1, 31);
        k1 *%= C2_64;
        h1 ^= k1;
    }
    h1 ^= @as(u64, data.len);
    h2 ^= @as(u64, data.len);
    h1 +%= h2;
    h2 +%= h1;
    h1 = fmix64(h1);
    h2 = fmix64(h2);
    h1 +%= h2;
    h2 +%= h1;
    return Hash128.{ h1: h1, h2: h2 };
}

// -----------------------------------------------------------------------------
// Tests: from the Python mmh3 package (hash, hash128 with x64arch=True), over
// bytes (i * 31 + 7) & 255
// -----------------------------------------------------------------------------

struct Vector {
    n: usize,
    seed: u32,
    h32: u32,
    h1: u64,
    h2: u64,
}

let MM_VECTORS: [40]Vector = [
    Vector.{ n: 0, seed: 0x00000000, h32: 0x00000000, h1: 0x0000000000000000, h2: 0x0000000000000000 },
    Vector.{ n: 0, seed: 0x9747b28c, h32: 0xebb6c228, h1: 0x392b208a1daabbb3, h2: 0x93b0608fe302957a },
