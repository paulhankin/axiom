// =============================================================================
// std/math/rational.ax - exact rational numbers over std/math/bigint.
//
//     let mut a = rational.Rational.parse("3/4")!;
//     defer a.deinit();
//     let mut b = rational.Rational.parse("1.25")!;   // 5/4
//     defer b.deinit();
//     let mut c = rational.Rational.init()!;
//     defer c.deinit();
//     c.add(&a, &b)!;                       // 2
//     c.div(&c, &b)!;                       // 8/5; the result may be an operand
//     let s = c.to_string()!;               // "8/5"; mem.free(s)
//     let x = c.to_f64();                   // 1.6, correctly rounded
//     let mut pi = rational.Rational.from_f64(3.141592653589793)!;  // exact
//     defer pi.deinit();
//     pi.limit_denominator(&pi, 1000)!;     // 355/113
//
// A Rational is a numerator and a denominator (BigInts) kept normalized:
// the denominator is positive and shares no factor with the numerator, so
// equal numbers have equal representations. As in std/math/bigint,
// operations are methods on the result, which may be one of the operands
// (z.add(&x, &y) sets z = x + y), and a Rational owns its memory (deinit
// frees it; use set or clone rather than copying the struct).
//
// Behaviour follows Python's fractions.Fraction: parsing accepts the same
// strings ("-3/4", "1.25", ".5e-3", "1_000"), to_string gives str()'s
// "n/d" (or "n" for integers), to_f64 rounds correctly to the nearest
// double as float() does, from_f64 is exact, round rounds half to even,
// and limit_denominator gives the closest fraction with a bounded
// denominator by the same continued-fraction method (ties to the smaller
// denominator). Checked against Python's fractions module
// (std/math/rational/testdata, from cmd/axiom/internal/tests/tools/gen_rational_tests.py).
//
// Decimal exponents in parsed strings are limited to +-MAX_EXP, so hostile
// input cannot ask for 10^(10^9).
// =============================================================================

import "../io.ax" as io;
import "../mem.ax" as mem;
import "../os/fs.ax" as fs;
import "../str.ax" as strs;
import "bigint.ax" as bigint;

pub error RationalError { InvalidNumber, DivisionByZero, Overflow, OutOfMemory, Negative, NotFound, IoError,
                          NotInvertible, Done, NoSpaceLeft, InvalidUtf8 }

/// The largest decimal exponent parse accepts ("1e100000").
pub const MAX_EXP: i64 = 100000;

pub struct Rational {
    num: bigint.BigInt,  // signed
    den: bigint.BigInt,  // positive, coprime to num

    /// Zero (0/1).
    pub fn init() RationalError!Rational {
        return Rational.{ num: bigint.BigInt.init(), den: bigint.BigInt.from_i64(1)! };
    }

    pub fn deinit(self: *mut Rational) void {
        self.num.deinit();
        self.den.deinit();
    }

    pub fn from_i64(v: i64) RationalError!Rational {
        let mut r = Rational.init()!;
        r.num.set_i64(v) catch |e| {
            r.deinit();
            return e;
        };
        return r;
    }

    /// n / d, normalized; DivisionByZero if d is 0.
    pub fn from_ints(n: i64, d: i64) RationalError!Rational {
        let mut bn = bigint.BigInt.from_i64(n)!;
        defer bn.deinit();
        let mut bd = bigint.BigInt.from_i64(d)!;
        defer bd.deinit();
        return Rational.from_bigints(&bn, &bd)!;
    }

    /// n / d, normalized; DivisionByZero if d is 0.
    pub fn from_bigints(n: *bigint.BigInt, d: *bigint.BigInt) RationalError!Rational {
        let mut r = Rational.init()!;
        r.set_bigints(n, d) catch |e| {
            r.deinit();
            return e;
        };
        return r;
    }

    /// The exact value of a finite double (0.1 is 3602879701896397/36028797018963968);
    /// InvalidNumber for infinities and NaN.
    pub fn from_f64(x: f64) RationalError!Rational {
        let mut r = Rational.init()!;
        r.set_f64(x) catch |e| {
            r.deinit();
            return e;
        };
        return r;
    }

    /// A new Rational equal to x.
    pub fn clone(x: *Rational) RationalError!Rational {
        let mut r = Rational.init()!;
        r.set(x) catch |e| {
            r.deinit();
            return e;
        };
        return r;
    }

    /// Parses, as Python's Fraction(str) does, optional surrounding
    /// whitespace, a sign, and either "n/d" or a decimal number with an
    /// optional point and exponent ("1.25", ".5", "5.", "1e-3", "2.5E+10");
    /// underscores may separate digits.
    pub fn parse(s: []u8) RationalError!Rational {
        let mut r = Rational.init()!;
        r.set_string(s) catch |e| {
            r.deinit();
            return e;
        };
        return r;
    }

    // --- access --------------------------------------------------------------

    /// The numerator (with the sign).
    pub fn numerator(self: *Rational) *bigint.BigInt {
        return &self.num;
    }

    /// The denominator (positive).
    pub fn denominator(self: *Rational) *bigint.BigInt {
        return &self.den;
    }

    // --- setting -------------------------------------------------------------

    pub fn set(self: *mut Rational, x: *Rational) RationalError!void {
        if @int_from_ptr(self) == @int_from_ptr(x) {
            return;
        }
        self.num.set(&x.num)!;
        self.den.set(&x.den)!;
    }

    pub fn set_i64(self: *mut Rational, v: i64) RationalError!void {
        self.num.set_i64(v)!;
        self.den.set_i64(1)!;
    }

    /// self = n / d, normalized; DivisionByZero if d is 0.
    pub fn set_bigints(self: *mut Rational, n: *bigint.BigInt, d: *bigint.BigInt) RationalError!void {
        if d.is_zero() {
            return error.DivisionByZero;
        }
        let mut a = bigint.BigInt.clone(n)!;
        defer a.deinit();
        let mut b = bigint.BigInt.clone(d)!;
        defer b.deinit();
        self.take_parts(&mut a, &mut b)!;
    }

    /// self = the exact value of x (see from_f64).
    pub fn set_f64(self: *mut Rational, x: f64) RationalError!void {
        let bits = @bit_cast(u64, x);
        let e = @as(i64, @truncate(u32, (bits >> 52) & 0x7ff));
        let mut m = bits & 0xfffffffffffff;
        if e == 0x7ff {
            return error.InvalidNumber;
        }
        let mut e2: i64 = -1074;
        if e != 0 {
            m = m | 0x10000000000000;
            e2 = e - 1075;
        }
        if m == 0 {
            self.set_i64(0)!;
            return;
        }
        let tz = @ctz(m);
        m = m >> tz;
        e2 += @int_cast(i64, tz);
        self.num.set_u64(m)!;
        self.den.set_i64(1)!;
        if e2 >= 0 {
            self.num.shl(&self.num, @int_cast(usize, e2))!;
        } else {
            self.den.shl(&self.den, @int_cast(usize, -e2))!;
        }
        if (bits >> 63) == 1 {
            self.num.neg_of(&self.num)!;
        }
    }

    /// self = the number s spells (see parse).
    pub fn set_string(self: *mut Rational, s: []u8) RationalError!void {
        let t = trim_space(s);
        let mut i: usize = 0;
        let mut neg = false;
        if (t.len > 0) and ((t[0] == '+') or (t[0] == '-')) {
            neg = t[0] == '-';
            i = 1;
        }
        let int_start = i;
        let int_end = scan_digits(t, i)!;
        i = int_end;
        let mut n = bigint.BigInt.init();
        defer n.deinit();
        let mut d = bigint.BigInt.from_i64(1)!;
        defer d.deinit();
        if (i < t.len) and (t[i] == '/') {
            if int_end == int_start {
                return error.InvalidNumber;
            }
            let den_start = i + 1;
            let den_end = scan_digits(t, den_start)!;
            if (den_end == den_start) or (den_end != t.len) {
                return error.InvalidNumber;
            }
            n.deinit();
            n = bigint.BigInt.parse(t[int_start..int_end], 10)!;
            d.deinit();
            d = bigint.BigInt.parse(t[den_start..den_end], 10)!;
        } else {
            let mut frac_start = i;
            let mut frac_end = i;
            if (i < t.len) and (t[i] == '.') {
                frac_start = i + 1;
                frac_end = scan_digits(t, frac_start)!;
                i = frac_end;
            }
            if (int_end == int_start) and (frac_end == frac_start) {
                return error.InvalidNumber;
            }
            let mut exp: i64 = 0;
            if (i < t.len) and ((t[i] == 'e') or (t[i] == 'E')) {
                i += 1;
                let mut eneg = false;
                if (i < t.len) and ((t[i] == '+') or (t[i] == '-')) {
                    eneg = t[i] == '-';
                    i += 1;
                }
                let e_end = scan_digits(t, i)!;
                if e_end == i {
                    return error.InvalidNumber;
                }
                for c in t[i..e_end] {
                    if c != '_' {
                        exp = (exp * 10) + @as(i64, c - '0');
                        if exp > MAX_EXP {
                            return error.Overflow;
                        }
                    }
                }
                if eneg {
                    exp = -exp;
                }
                i = e_end;
            }
            if i != t.len {
                return error.InvalidNumber;
            }
            // n = the digits before and after the point, d = 10^(digits after)
            if int_end > int_start {
                n.deinit();
                n = bigint.BigInt.parse(t[int_start..int_end], 10)!;
            }
            let mut places: i64 = 0;
            if frac_end > frac_start {
                let mut f = bigint.BigInt.parse(t[frac_start..frac_end], 10)!;
                defer f.deinit();
                for c in t[frac_start..frac_end] {
                    if c != '_' {
                        places += 1;
                    }
                }
                let mut p = pow10(places)!;
                defer p.deinit();
                n.mul(&n, &p)!;
                n.add(&n, &f)!;
            }
            exp -= places;
            if exp > 0 {
                let mut p = pow10(exp)!;
                defer p.deinit();
                n.mul(&n, &p)!;
            } else if exp < 0 {
                let mut p = pow10(-exp)!;
                defer p.deinit();
                d.mul(&d, &p)!;
            }
        }
        if neg {
            n.neg_of(&n)!;
        }
        if d.is_zero() {
            return error.DivisionByZero;
        }
        self.take_parts(&mut n, &mut d)!;
    }

    /// Normalizes n / d (d != 0) into self, leaving n and d with self's old parts.
    fn take_parts(self: *mut Rational, n: *mut bigint.BigInt, d: *mut bigint.BigInt) RationalError!void {
        if d.sign() < 0 {
            n.neg_of(n)!;
            d.neg_of(d)!;
        }
        let mut g = bigint.BigInt.init();
        defer g.deinit();
        g.gcd(n, d)!;
        if g.cmp_i64(1) != 0 {
            n.quo(n, &g)!;
            d.quo(d, &g)!;
        }
        let tn = self.num;
        self.num = n.*;
        n.* = tn;
        let td = self.den;
        self.den = d.*;
        d.* = td;
    }

    // --- queries -------------------------------------------------------------

    /// -1, 0 or 1.
    pub fn sign(self: *Rational) i32 {
        return self.num.sign();
    }

    pub fn is_zero(self: *Rational) bool {
        return self.num.is_zero();
    }

    /// Whether the denominator is 1.
    pub fn is_integer(self: *Rational) bool {
        return self.den.cmp_i64(1) == 0;
    }

    /// Negative, zero or positive as self < x, self == x, self > x.
    pub fn cmp(self: *Rational, x: *Rational) RationalError!i32 {
        if self.num.sign() != x.num.sign() {
            if self.num.sign() < x.num.sign() {
                return -1;
            }
            return 1;
        }
        let mut a = bigint.BigInt.init();
        defer a.deinit();
        let mut b = bigint.BigInt.init();
        defer b.deinit();
        a.mul(&self.num, &x.den)!;
        b.mul(&x.num, &self.den)!;
        return a.cmp(&b);
    }

    /// Whether self and x are the same number.
    pub fn eq(self: *Rational, x: *Rational) bool {
        return (self.num.cmp(&x.num) == 0) and (self.den.cmp(&x.den) == 0);
    }

    // --- arithmetic ----------------------------------------------------------

    /// self = x + y.
    pub fn add(self: *mut Rational, x: *Rational, y: *Rational) RationalError!void {
        self.add_sub(x, y, false)!;
    }

    /// self = x - y.
    pub fn sub(self: *mut Rational, x: *Rational, y: *Rational) RationalError!void {
        self.add_sub(x, y, true)!;
    }

    fn add_sub(self: *mut Rational, x: *Rational, y: *Rational, minus: bool) RationalError!void {
        let mut n = bigint.BigInt.init();
        defer n.deinit();
        let mut t = bigint.BigInt.init();
        defer t.deinit();
        let mut d = bigint.BigInt.init();
        defer d.deinit();
        n.mul(&x.num, &y.den)!;
        t.mul(&y.num, &x.den)!;
        if minus {
            n.sub(&n, &t)!;
        } else {
            n.add(&n, &t)!;
        }
        d.mul(&x.den, &y.den)!;
        self.take_parts(&mut n, &mut d)!;
    }

    /// self = x * y.
    pub fn mul(self: *mut Rational, x: *Rational, y: *Rational) RationalError!void {
        let mut n = bigint.BigInt.init();
        defer n.deinit();
        let mut d = bigint.BigInt.init();
        defer d.deinit();
        n.mul(&x.num, &y.num)!;
        d.mul(&x.den, &y.den)!;
        self.take_parts(&mut n, &mut d)!;
    }

    /// self = x / y; DivisionByZero if y is 0.
    pub fn div(self: *mut Rational, x: *Rational, y: *Rational) RationalError!void {
        if y.num.is_zero() {
            return error.DivisionByZero;
        }
        let mut n = bigint.BigInt.init();
        defer n.deinit();
        let mut d = bigint.BigInt.init();
        defer d.deinit();
        n.mul(&x.num, &y.den)!;
        d.mul(&x.den, &y.num)!;
        self.take_parts(&mut n, &mut d)!;
    }

    /// self = -x.
    pub fn neg_of(self: *mut Rational, x: *Rational) RationalError!void {
        self.set(x)!;
        self.num.neg_of(&self.num)!;
    }

    /// self = |x|.
    pub fn abs(self: *mut Rational, x: *Rational) RationalError!void {
        self.set(x)!;
        self.num.abs(&self.num)!;
    }

    /// self = 1 / x; DivisionByZero if x is 0.
    pub fn inv(self: *mut Rational, x: *Rational) RationalError!void {
        if x.num.is_zero() {
            return error.DivisionByZero;
        }
        let mut n = bigint.BigInt.clone(&x.den)!;
        defer n.deinit();
        let mut d = bigint.BigInt.clone(&x.num)!;
        defer d.deinit();
        self.take_parts(&mut n, &mut d)!;
    }

    /// self = x^e (e may be negative; 0^-1 is DivisionByZero, x^0 is 1).
    pub fn pow(self: *mut Rational, x: *Rational, e: i64) RationalError!void {
        let mut n = bigint.BigInt.init();
        defer n.deinit();
        let mut d = bigint.BigInt.init();
        defer d.deinit();
        let mut m = @bit_cast(u64, e);
        if e < 0 {
            if x.num.is_zero() {
                return error.DivisionByZero;
            }
            m = 0 -% m;
            n.pow(&x.den, m)!;
            d.pow(&x.num, m)!;
        } else {
            n.pow(&x.num, m)!;
            d.pow(&x.den, m)!;
        }
        self.take_parts(&mut n, &mut d)!;
    }

    // --- rounding to integers ------------------------------------------------

    /// out = the largest integer <= self.
    pub fn floor(self: *Rational, out: *mut bigint.BigInt) RationalError!void {
        let mut m = bigint.BigInt.init();
        defer m.deinit();
        bigint.BigInt.div_mod(out, &mut m, &self.num, &self.den)!;
    }

    /// out = the smallest integer >= self.
    pub fn ceil(self: *Rational, out: *mut bigint.BigInt) RationalError!void {
        let mut n = bigint.BigInt.init();
        defer n.deinit();
        let mut m = bigint.BigInt.init();
        defer m.deinit();
        n.neg_of(&self.num)!;
        bigint.BigInt.div_mod(out, &mut m, &n, &self.den)!;
        out.neg_of(out)!;
    }

    /// out = self rounded toward zero.
    pub fn trunc(self: *Rational, out: *mut bigint.BigInt) RationalError!void {
        out.quo(&self.num, &self.den)!;
    }

    /// out = the nearest integer to self, halves to even (as Python's round).
    pub fn round(self: *Rational, out: *mut bigint.BigInt) RationalError!void {
        let mut m = bigint.BigInt.init();
        defer m.deinit();
        let mut f = bigint.BigInt.init();
        defer f.deinit();
        bigint.BigInt.div_mod(&mut f, &mut m, &self.num, &self.den)!;
        m.shl(&m, 1)!;
        let c = m.cmp(&self.den);
        if (c > 0) or ((c == 0) and f.is_odd()) {
            f.add_i64(&f, 1)!;
        }
        out.set(&f)!;
    }

    // --- approximation -------------------------------------------------------

    /// self = the closest rational to x with a denominator of at most
    /// max_den (>= 1, else InvalidNumber); of two equally close, the one with
    /// the smaller denominator. As Python's Fraction.limit_denominator.
    pub fn limit_denominator(self: *mut Rational, x: *Rational, max_den: u64) RationalError!void {
        if max_den < 1 {
            return error.InvalidNumber;
        }
        let mut md = bigint.BigInt.from_u64(max_den)!;
        defer md.deinit();
        if x.den.cmp(&md) <= 0 {
            self.set(x)!;
            return;
        }
        // convergents p0/q0, p1/q1 of the continued fraction of n/d
        let mut p0 = bigint.BigInt.from_i64(0)!;
        defer p0.deinit();
        let mut q0 = bigint.BigInt.from_i64(1)!;
        defer q0.deinit();
        let mut p1 = bigint.BigInt.from_i64(1)!;
        defer p1.deinit();
        let mut q1 = bigint.BigInt.from_i64(0)!;
        defer q1.deinit();
        let mut n = bigint.BigInt.clone(&x.num)!;
        defer n.deinit();
        let mut d = bigint.BigInt.clone(&x.den)!;
        defer d.deinit();
        let mut a = bigint.BigInt.init();
        defer a.deinit();
        let mut r = bigint.BigInt.init();
        defer r.deinit();
        let mut t = bigint.BigInt.init();
        defer t.deinit();
        loop {
            bigint.BigInt.div_mod(&mut a, &mut r, &n, &d)!;
            t.mul(&a, &q1)!;
            t.add(&t, &q0)!;  // q2
            if t.cmp(&md) > 0 {
                break;
            }
            q0.set(&q1)!;
            q1.set(&t)!;
            t.mul(&a, &p1)!;
            t.add(&t, &p0)!;
            p0.set(&p1)!;
            p1.set(&t)!;
            n.set(&d)!;
            d.set(&r)!;
        }
        // k = (max_den - q0) // q1; bound1 = (p0 + k p1)/(q0 + k q1), bound2 = p1/q1
        let mut k = bigint.BigInt.init();
        defer k.deinit();
        t.sub(&md, &q0)!;
        k.quo(&t, &q1)!;
        let mut bn = bigint.BigInt.init();
        defer bn.deinit();
        let mut bd = bigint.BigInt.init();
        defer bd.deinit();
        bn.mul(&k, &p1)!;
        bn.add(&bn, &p0)!;
        bd.mul(&k, &q1)!;
        bd.add(&bd, &q0)!;
        // bound2 is at least as close iff 2 d (q0 + k q1) <= x.den (d is the last remainder)
        t.mul(&d, &bd)!;
        t.shl(&t, 1)!;
        if t.cmp(&x.den) <= 0 {
            self.set_bigints(&p1, &q1)!;
        } else {
            self.set_bigints(&bn, &bd)!;
        }
    }

    /// The terms [a0; a1, a2, ...] of the continued fraction of self (the
    /// shorter of the two forms: the last term is > 1 unless it is a0).
    /// Free the result with free_terms.
    pub fn continued_fraction(self: *Rational) RationalError![]mut bigint.BigInt {
        let mut n = bigint.BigInt.clone(&self.num)!;
        defer n.deinit();
        let mut d = bigint.BigInt.clone(&self.den)!;
        defer d.deinit();
        let mut r = bigint.BigInt.init();
        defer r.deinit();
        // at most about 1.44 log2(den) + 2 terms
        let cap = ((self.den.bit_len() * 3) / 2) + 3;
        let out = mem.alloc.[bigint.BigInt](cap)!;
        let mut count: usize = 0;
        while not d.is_zero() {
            out[count] = bigint.BigInt.init();
            count += 1;
            bigint.BigInt.div_mod(&mut out[count - 1], &mut r, &n, &d) catch |e| {
                free_terms(out[..count]);
                return e;
            };
            n.set(&d) catch |e| {
                free_terms(out[..count]);
                return e;
            };
            d.set(&r) catch |e| {
                free_terms(out[..count]);
                return e;
            };
        }
        let res = mem.realloc(out, count) catch |e| {
            free_terms(out[..count]);
            return e;
        };
        return res;
    }

    /// self = [a0; a1, ..., an] (at least one term); DivisionByZero if a
    /// partial denominator comes out zero.
    pub fn set_continued_fraction(self: *mut Rational, terms: []bigint.BigInt) RationalError!void {
        if terms.len == 0 {
            return error.InvalidNumber;
        }
        // h/k from the last term back: x = a + 1/x'
        let mut h = bigint.BigInt.clone(&terms[terms.len - 1])!;
        defer h.deinit();
        let mut k = bigint.BigInt.from_i64(1)!;
        defer k.deinit();
        let mut t = bigint.BigInt.init();
        defer t.deinit();
        let mut j = terms.len - 1;
        while j > 0 {
            j -= 1;
            // a + k/h = (a h + k) / h
            t.mul(&terms[j], &h)!;
            t.add(&t, &k)!;
            k.set(&h)!;
            h.set(&t)!;
        }
        if k.is_zero() {
            return error.DivisionByZero;
        }
        self.set_bigints(&h, &k)!;
    }

    // --- conversion ----------------------------------------------------------

    /// The nearest double (ties to even), as Python's float(Fraction) gives;
    /// +-inf beyond the range (where Python raises OverflowError).
    pub fn to_f64(self: *Rational) f64 {
        return self.to_f64_checked() catch 0.0;
    }

    fn to_f64_checked(self: *Rational) RationalError!f64 {
        if self.num.is_zero() {
            return 0.0;
        }
        let mut a = bigint.BigInt.init();
        defer a.deinit();
        a.abs(&self.num)!;
        let la = @int_cast(i64, a.bit_len());
        let lb = @int_cast(i64, self.den.bit_len());
        // q = floor(a 2^s / b) has 55 or 56 bits; sticky: whether bits were lost
        let s = (55 + lb) - la;
        let mut q = bigint.BigInt.init();
        defer q.deinit();
        let mut r = bigint.BigInt.init();
        defer r.deinit();
        if s >= 0 {
            a.shl(&a, @int_cast(usize, s))!;
            bigint.BigInt.quo_rem(&mut q, &mut r, &a, &self.den)!;
        } else {
            let mut b = bigint.BigInt.init();
            defer b.deinit();
            b.shl(&self.den, @int_cast(usize, -s))!;
            bigint.BigInt.quo_rem(&mut q, &mut r, &a, &b)!;
        }
        let qv = q.to_u64()!;
        let sticky = not r.is_zero();
        let lq = 64 - @int_cast(i64, @clz(qv));
        // the value is qv 2^-s; its last kept bit has weight 2^ulp
        let top = (lq - 1) - s;
        let mut sign: u64 = 0;
        if self.num.sign() < 0 {
            sign = 0x8000000000000000;
        }
        if top > 1023 {
            return @bit_cast(f64, sign | 0x7ff0000000000000);
        }
        let ulp = @max(top - 52, -1074);
        let drop = ulp + s;  // bits of qv below the last kept one (>= 2)
        let mut m: u64 = 0;
        if drop <= 64 {
            let dk = @as(u32, @truncate(u32, @bit_cast(u64, drop)));
            m = qv >> dk;
            let rest = qv & ((@as(u64, 1) << dk) -% 1);
            let half = @as(u64, 1) << (dk - 1);
            if (rest > half) or ((rest == half) and (sticky or ((m & 1) == 1))) {
                m += 1;
            }
        }
        let mut e = ulp;
        if m == 0x20000000000000 {
            m = m >> 1;
            e += 1;
        }
        if m >= 0x10000000000000 {
            let biased = (e + 52) + 1023;
            if biased >= 2047 {
                return @bit_cast(f64, sign | 0x7ff0000000000000);
            }
            return @bit_cast(f64, (sign | (@bit_cast(u64, biased) << 52)) | (m & 0xfffffffffffff));
        }
        return @bit_cast(f64, sign | m);  // subnormal (or zero): e is -1074
    }

    /// Writes "n/d", or "n" if the denominator is 1 (as Python's str).
    pub fn format(self: *Rational, w: io.Writer) !void {
        self.num.format(w, 10)!;
        if not self.is_integer() {
            w.write_all("/")!;
            self.den.format(w, 10)!;
        }
    }

    /// format's text in new memory (free it with mem.free).
    pub fn to_string(self: *Rational) ![]mut u8 {
        let mut s = strs.String.init();
        self.format(s.writer()) catch |e| {
            s.deinit();
            return e;
        };
        return s.take();
    }
}

/// Frees terms from Rational.continued_fraction.
pub fn free_terms(terms: []mut bigint.BigInt) void {
    for k in @as(usize, 0)..terms.len {
        terms[k].deinit();
    }
    mem.free(terms);
}

fn trim_space(s: []u8) []u8 {
    let mut a: usize = 0;
    let mut b = s.len;
    while (a < b) and strs.is_space(s[a]) {
        a += 1;
    }
    while (b > a) and strs.is_space(s[b - 1]) {
        b -= 1;
    }
    return s[a..b];
}

/// The end of the digits (with single underscores between them) at s[i..];
/// InvalidNumber for a misplaced underscore.
fn scan_digits(s: []u8, i: usize) RationalError!usize {
    let mut k = i;
    while k < s.len {
        if strs.is_digit(s[k]) {
            k += 1;
        } else if s[k] == '_' {
            if (k == i) or ((k + 1) >= s.len) or not strs.is_digit(s[k + 1]) {
                return error.InvalidNumber;
            }
            k += 1;
        } else {
            break;
        }
    }
    return k;
}

fn pow10(e: i64) RationalError!bigint.BigInt {
    let mut ten = bigint.BigInt.from_i64(10)!;
    defer ten.deinit();
    let mut p = bigint.BigInt.init();
    p.pow(&ten, @bit_cast(u64, e)) catch |err| {
        p.deinit();
        return err;
    };
    return p;
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn is(x: *Rational, want: []u8) bool {
    let s = x.to_string() catch return false;
    defer mem.free(s);
    return strs.eq(s, want);
}

test "normalization and parsing" {
    let mut a = Rational.from_ints(6, -8)!;
    defer a.deinit();
    @expect(is(&a, "-3/4"));
    let mut b = Rational.parse(" -1.25 ")!;
    defer b.deinit();
    @expect(is(&b, "-5/4"));
    let mut c = Rational.parse(".5e-3")!;
    defer c.deinit();
    @expect(is(&c, "1/2000"));
    let mut d = Rational.parse("1_000/3_0")!;
    defer d.deinit();
    @expect(is(&d, "100/3"));
    let mut e = Rational.parse("2.5E+2")!;
    defer e.deinit();
    @expect(is(&e, "250"));
    @expect(e.is_integer());
    let mut z = Rational.parse("-0/5")!;
    defer z.deinit();
    @expect(is(&z, "0"));
    @expect(bad("1/0", error.DivisionByZero));
    @expect(bad("", error.InvalidNumber));
    @expect(bad(".", error.InvalidNumber));
    @expect(bad("1/", error.InvalidNumber));
    @expect(bad("/2", error.InvalidNumber));
    @expect(bad("1.5/2", error.InvalidNumber));
    @expect(bad("1__0", error.InvalidNumber));
    @expect(bad("1e", error.InvalidNumber));
    @expect(bad("1e999999999", error.Overflow));
    @expect(bad("1 /2", error.InvalidNumber));
}

fn bad(s: []u8, want: error) bool {
    let mut r = Rational.parse(s) catch |e| return e == want;
    r.deinit();
    return false;
}

test "arithmetic" {
    let mut a = Rational.from_ints(1, 3)!;
    defer a.deinit();
    let mut b = Rational.from_ints(1, 6)!;
    defer b.deinit();
    let mut c = Rational.init()!;
    defer c.deinit();
    c.add(&a, &b)!;
    @expect(is(&c, "1/2"));
    c.sub(&b, &a)!;
    @expect(is(&c, "-1/6"));
    c.mul(&c, &c)!;
    @expect(is(&c, "1/36"));
    c.div(&a, &b)!;
    @expect(is(&c, "2"));
    c.inv(&b)!;
    @expect(is(&c, "6"));
    c.pow(&a, -3)!;
    @expect(is(&c, "27"));
    c.pow(&b, 0)!;
    @expect(is(&c, "1"));
    @expect(a.cmp(&b)! > 0);
    @expect(b.cmp(&a)! < 0);
    @expect(a.cmp(&a)! == 0);
    c.set_i64(0)!;
    c.inv(&c) catch |e| {
        @expect(e == error.DivisionByZero);
        return;
    };
    @trap();
}

test "floats" {
    let mut a = Rational.from_f64(0.1)!;
    defer a.deinit();
    @expect(is(&a, "3602879701896397/36028797018963968"));
    @expect(a.to_f64() == 0.1);
    let mut b = Rational.from_ints(1, 3)!;
    defer b.deinit();
    @expect(b.to_f64() == (1.0 / 3.0));
    let mut tiny = Rational.from_f64(4.9406564584124654e-324)!;
    defer tiny.deinit();
    @expect(tiny.to_f64() == 4.9406564584124654e-324);
    let mut big = Rational.parse("1e400")!;
    defer big.deinit();
    @expect(big.to_f64() == (1.0 / 0.0));
    _ = Rational.from_f64(0.0 / 0.0) catch |e| {
        @expect(e == error.InvalidNumber);
        return;
    };
    @trap();
}

test "rounding" {
    let mut x = Rational.parse("-7/2")!;
    defer x.deinit();
    let mut n = bigint.BigInt.init();
    defer n.deinit();
    x.floor(&mut n)!;
    @expect(n.cmp_i64(-4) == 0);
    x.ceil(&mut n)!;
    @expect(n.cmp_i64(-3) == 0);
    x.trunc(&mut n)!;
    @expect(n.cmp_i64(-3) == 0);
    x.round(&mut n)!;
    @expect(n.cmp_i64(-4) == 0);
    let mut y = Rational.parse("5/2")!;
    defer y.deinit();
    y.round(&mut n)!;
    @expect(n.cmp_i64(2) == 0);
}

test "approximation" {
    let mut pi = Rational.parse("3.141592653589793")!;
    defer pi.deinit();
    let mut r = Rational.init()!;
    defer r.deinit();
    r.limit_denominator(&pi, 10)!;
    @expect(is(&r, "22/7"));
    r.limit_denominator(&pi, 100)!;
    @expect(is(&r, "311/99"));
    r.limit_denominator(&pi, 1000)!;
    @expect(is(&r, "355/113"));
    let mut q = Rational.from_ints(4321, 8765)!;
    defer q.deinit();
    r.limit_denominator(&q, 10000)!;
    @expect(is(&r, "4321/8765"));
    // continued fractions: 415/93 = [4; 2, 6, 7]
    let mut f = Rational.from_ints(415, 93)!;
    defer f.deinit();
    let ts = f.continued_fraction()!;
    defer free_terms(ts);
    @expect(ts.len == 4);
    @expect((ts[0].cmp_i64(4) == 0) and (ts[1].cmp_i64(2) == 0) and (ts[2].cmp_i64(6) == 0) and
            (ts[3].cmp_i64(7) == 0));
    r.set_continued_fraction(ts)!;
    @expect(r.eq(&f));
    let mut g = Rational.from_ints(-7, 3)!;
    defer g.deinit();
    let gs = g.continued_fraction()!;
    defer free_terms(gs);
    @expect((gs.len == 3) and (gs[0].cmp_i64(-3) == 0) and (gs[1].cmp_i64(1) == 0) and (gs[2].cmp_i64(2) == 0));
}

test "against Python's fractions" {
    let data = fs.read_file("std/math/rational/testdata/cases.txt") catch return;
    defer mem.free(data);
    let mut lines = strs.lines(data);
    let mut count: usize = 0;
    while true {
        let line = lines.next() catch break;
        if (line.len == 0) or (line[0] == '#') {
            continue;
        }
        let mut f = strs.fields(line);
        let op = f.next()!;
        let mut a = Rational.parse(f.next()!)!;
        defer a.deinit();
        let bs = f.next()!;
        let want = f.next()!;
        let mut r = Rational.init()!;
        defer r.deinit();
        let mut n = bigint.BigInt.init();
        defer n.deinit();
        let mut got = strs.String.init();
        defer got.deinit();
        if strs.eq(op, "parse") {
            // a is the parsed text; want its value
            r.set(&a)!;
            r.format(got.writer())!;
        } else if strs.eq(op, "float") {
            let x = a.to_f64();
            if @bit_cast(u64, x) != parse_hex_bits(want) {
                @expect_eq(line, "");
            }
            count += 1;
            continue;
        } else if strs.eq(op, "from_float") {
            r.set_f64(@bit_cast(f64, parse_hex_bits(bs)))!;
            r.format(got.writer())!;
        } else if strs.eq(op, "limit") {
            let mut md = bigint.BigInt.parse(bs, 10)!;
            defer md.deinit();
            r.limit_denominator(&a, md.to_u64()!)!;
            r.format(got.writer())!;
        } else if strs.eq(op, "floor") or strs.eq(op, "ceil") or strs.eq(op, "round") {
            if strs.eq(op, "floor") {
                a.floor(&mut n)!;
            } else if strs.eq(op, "ceil") {
                a.ceil(&mut n)!;
            } else {
                a.round(&mut n)!;
            }
            n.format(got.writer(), 10)!;
        } else if strs.eq(op, "cmp") {
            let mut b = Rational.parse(bs)!;
            defer b.deinit();
            let c = a.cmp(&b)!;
            if c < 0 {
                got.push_str("-1")!;
            } else if c > 0 {
                got.push_str("1")!;
            } else {
                got.push_str("0")!;
            }
        } else {
            let mut b = Rational.parse(bs)!;
            defer b.deinit();
            if strs.eq(op, "add") {
                r.add(&a, &b)!;
            } else if strs.eq(op, "sub") {
                r.sub(&a, &b)!;
            } else if strs.eq(op, "mul") {
                r.mul(&a, &b)!;
            } else if strs.eq(op, "div") {
                r.div(&a, &b)!;
            } else if strs.eq(op, "pow") {
                let mut e = bigint.BigInt.parse(bs, 10)!;
                defer e.deinit();
                r.pow(&a, e.to_i64()!)!;
            } else {
                @expect_eq(op, "an operation");
            }
            r.format(got.writer())!;
        }
        if not strs.eq(got.bytes(), want) {
            @expect_eq(line, got.bytes());
        }
        count += 1;
    }
    @expect(count >= 1000);
}

fn parse_hex_bits(s: []u8) u64 {
    let mut v: u64 = 0;
    for c in s {
        let mut d: u64 = 0;
        if strs.is_digit(c) {
            d = @as(u64, c - '0');
        } else {
            d = @as(u64, (c | 0x20) - 'a') + 10;
        }
        v = (v << 4) | d;
    }
    return v;
}
