    let zs: [10]Complex = [
        c(0.5, 0.25), c(-1.5, 2.0), c(3.0, -0.75), c(-0.2, -0.9), c(1.0, 0.5), c(0.0, 2.0), c(2.0, 0.0), c(-3.0, 0.0),
        c(0.0, -1.5), c(1e-09, 2e-09)];
