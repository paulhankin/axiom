// =============================================================================
// std/io.ax - readers, writers, formatting, standard streams and files.
//
// Writer and Reader are interfaces: a context pointer plus a function
// pointer. Anything can be a Writer by providing a write function.
//
// Standard streams and files use the Axiom host ABI (import module
// "axiom"), provided by std/internal/runtime/host.mjs (WebAssembly under node) and
// std/internal/runtime/native_host.c (native targets).
// =============================================================================

import "mem.ax" as mem;

error { IoError, EndOfStream, NoSpaceLeft, NotFound, PermissionDenied, IsDirectory, OutOfMemory }

import host "axiom" {
    fn ax_write(fd: i32, p: *u8, n: usize) isize;
    fn ax_read(fd: i32, p: *mut u8, n: usize) isize;
    fn ax_open(path: *u8, len: usize, flags: u32) i32;
    fn ax_close(fd: i32) void;
    fn ax_seek(fd: i32, off: i64, whence: u32) i64;
}

// -----------------------------------------------------------------------------
// Formatting into caller-provided buffers
// -----------------------------------------------------------------------------

/// Decimal digits of x, written at the end of buf (needs 20 bytes).
pub fn fmt_u64(buf: []mut u8, x: u64) []u8 {
    let mut i = buf.len;
    let mut v = x;
    loop {
        i -= 1;
        buf[i] = @truncate(u8, v % 10) + '0';
        v = v / 10;
        if v == 0 {
            break;
        }
    }
    return buf[i..];
}

/// Decimal form of x, written at the end of buf (needs 20 bytes).
pub fn fmt_i64(buf: []mut u8, x: i64) []u8 {
    if x >= 0 {
        return fmt_u64(buf, @as(u64, @bit_cast(u64, x)));
    }
    let digits = fmt_u64(buf, 0 -% @bit_cast(u64, x));
    let start = buf.len - digits.len - 1;
    buf[start] = '-';
    return buf[start..];
}

/// Lower-case hexadecimal digits of x, at the end of buf (needs 16 bytes).
pub fn fmt_hex(buf: []mut u8, x: u64) []u8 {
    let digits = "0123456789abcdef";
    let mut i = buf.len;
    let mut v = x;
    loop {
        i -= 1;
        buf[i] = digits[@truncate(usize, v & 15)];
        v = v >> 4;
        if v == 0 {
            break;
        }
    }
    return buf[i..];
}

/// Parses an unsigned decimal integer.
pub fn parse_u64(s: []u8) !u64 {
    if s.len == 0 {
        return error.IoError;
    }
    let mut v: u64 = 0;
    for c in s {
        if (c < '0') or (c > '9') {
            return error.IoError;
        }
        v = @mul_checked(v, 10) catch return error.IoError;
        v = @add_checked(v, @as(u64, c - '0')) catch return error.IoError;
    }
    return v;
}

/// Parses a decimal integer with an optional leading '-'.
pub fn parse_i64(s: []u8) !i64 {
    if (s.len > 0) and (s[0] == '-') {
        let m = parse_u64(s[1..])!;
        if m > 9223372036854775808 {
            return error.IoError;
        }
        return @bit_cast(i64, 0 -% m);
    }
    let m = parse_u64(s)!;
    if m > 9223372036854775807 {
        return error.IoError;
    }
    return @bit_cast(i64, m);
}

// -----------------------------------------------------------------------------
// Writer
// -----------------------------------------------------------------------------

pub struct Writer {
    ctx: *mut void,
    write_fn: fn(*mut void, []u8) !usize,  // writes a prefix of the bytes, returns its length

    pub fn write(self: Writer, bytes: []u8) !usize {
        return self.write_fn(self.ctx, bytes);
    }

    pub fn write_all(self: Writer, bytes: []u8) !void {
        let mut rest = bytes;
        while rest.len > 0 {
            let n = self.write_fn(self.ctx, rest)!;
            if n == 0 {
                return error.IoError;
            }
            rest = rest[n..];
        }
    }

    pub fn print(self: Writer, s: []u8) !void {
        self.write_all(s)!;
    }

    pub fn println(self: Writer, s: []u8) !void {
        self.write_all(s)!;
        self.write_all("\n")!;
    }

    pub fn print_byte(self: Writer, b: u8) !void {
        let one: [1]u8 = [b];
        self.write_all(one[..])!;
    }

    pub fn print_u64(self: Writer, x: u64) !void {
        let mut buf: [20]u8 = [0; 20];
        self.write_all(fmt_u64(buf[..], x))!;
    }

    pub fn print_i64(self: Writer, x: i64) !void {
        let mut buf: [21]u8 = [0; 21];
        self.write_all(fmt_i64(buf[..], x))!;
    }

    pub fn print_hex(self: Writer, x: u64) !void {
        let mut buf: [16]u8 = [0; 16];
        self.write_all(fmt_hex(buf[..], x))!;
    }

    pub fn print_bool(self: Writer, b: bool) !void {
        if b {
            self.write_all("true")!;
        } else {
            self.write_all("false")!;
        }
    }

    /// Fixed-point decimal with `decimals` digits after the point (at most 9).
    /// Values of magnitude >= 1e18 are printed in scientific form, e.g. 1.5e20.
    pub fn print_f64(self: Writer, x: f64, decimals: u32) !void {
        if x != x {
            self.write_all("nan")!;
            return;
        }
        let mut v = x;
        if v < 0.0 {
            self.write_all("-")!;
            v = -v;
        }
        if v == (1.0 / 0.0) {
            self.write_all("inf")!;
            return;
        }
        let mut exp: u32 = 0;
        if v >= 1.0e18 {
            while v >= 10.0 {
                v = v / 10.0;
                exp += 1;
            }
        }
        let d = @min(decimals, 9);
        let mut scale: u64 = 1;
        for i in @as(u32, 0)..d {
            scale *= 10;
        }
        let ip = @trunc(v);
        let mut ipart = @int_from_float(u64, ip);
        let mut fpart = @int_from_float(u64, @nearest((v - ip) * @float_from_int(f64, scale)));
        if fpart >= scale {
            ipart += 1;
            fpart -= scale;
        }
        self.print_u64(ipart)!;
        if d > 0 {
            self.write_all(".")!;
            let mut buf: [20]u8 = [0; 20];
            let digits = fmt_u64(buf[..], fpart);
            for i in digits.len..@as(usize, d) {
                self.write_all("0")!;
            }
            self.write_all(digits)!;
        }
        if exp > 0 {
            self.write_all("e")!;
            self.print_u64(@as(u64, exp))!;
        }
    }
}

// -----------------------------------------------------------------------------
// Reader
// -----------------------------------------------------------------------------

pub struct Reader {
    ctx: *mut void,
    read_fn: fn(*mut void, []mut u8) !usize,  // 0 means end of stream

    pub fn read(self: Reader, buf: []mut u8) !usize {
        return self.read_fn(self.ctx, buf);
    }

    /// Fills buf completely, or fails with EndOfStream.
    pub fn read_exact(self: Reader, buf: []mut u8) !void {
        let mut got: usize = 0;
        while got < buf.len {
            let n = self.read_fn(self.ctx, buf[got..])!;
            if n == 0 {
                return error.EndOfStream;
            }
            got += n;
        }
    }

    /// Reads up to and excluding the next '\n' (a trailing '\r' is dropped).
    /// Fails with EndOfStream at end of input, NoSpaceLeft if the line does
    /// not fit in buf.
    pub fn read_line(self: Reader, buf: []mut u8) ![]mut u8 {
        let mut n: usize = 0;
        let mut one: [1]u8 = [0];
        loop {
            let got = self.read_fn(self.ctx, one[..])!;
            if got == 0 {
                if n == 0 {
                    return error.EndOfStream;
                }
                break;
            }
            if one[0] == '\n' {
                break;
            }
            if n == buf.len {
                return error.NoSpaceLeft;
            }
            buf[n] = one[0];
            n += 1;
        }
        if (n > 0) and (buf[n - 1] == '\r') {
            n -= 1;
        }
        return buf[..n];
    }

    /// Reads everything that is left into new memory (free it with mem.free).
    pub fn read_all(self: Reader) ![]mut u8 {
        let mut buf = mem.alloc.[u8](4096)!;
        let mut len: usize = 0;
        loop {
            if len == buf.len {
                buf = mem.realloc(buf, buf.len * 2) catch |e| {
                    mem.free(buf);
                    return e;
                };
            }
            let n = self.read_fn(self.ctx, buf[len..]) catch |e| {
                mem.free(buf);
                return e;
            };
            if n == 0 {
                return mem.realloc(buf, len) catch |e| {
                    mem.free(buf);
                    return e;
                };
            }
            len += n;
        }
    }
}

// -----------------------------------------------------------------------------
// Standard streams and files (host)
// -----------------------------------------------------------------------------

fn fd_of(ctx: *mut void) i32 {
    return @int_cast(i32, @int_from_ptr(ctx));
}

fn fd_ctx(fd: i32) *mut void {
    return @ptr_from_int(*mut void, @int_cast(usize, fd));
}

fn fd_write(ctx: *mut void, bytes: []u8) !usize {
    let n = ax_write(fd_of(ctx), bytes.ptr, bytes.len);
    if n < 0 {
        return error.IoError;
    }
    return @int_cast(usize, n);
}

fn fd_read(ctx: *mut void, buf: []mut u8) !usize {
    let n = ax_read(fd_of(ctx), buf.ptr, buf.len);
    if n < 0 {
        return error.IoError;
    }
    return @int_cast(usize, n);
}

pub fn stdout() Writer {
    return Writer.{ ctx: fd_ctx(1), write_fn: fd_write };
}

pub fn stderr() Writer {
    return Writer.{ ctx: fd_ctx(2), write_fn: fd_write };
}

pub fn stdin() Reader {
    return Reader.{ ctx: fd_ctx(0), read_fn: fd_read };
}

pub struct File {
    fd: i32,

    pub fn reader(self: File) Reader {
        return Reader.{ ctx: fd_ctx(self.fd), read_fn: fd_read };
    }

    pub fn writer(self: File) Writer {
        return Writer.{ ctx: fd_ctx(self.fd), write_fn: fd_write };
    }

    pub fn close(self: File) void {
        ax_close(self.fd);
    }

    /// Moves the position for the next read or write to `off` bytes from
    /// the start (Whence.SET), the current position (Whence.CUR) or the end
    /// (Whence.END); returns the new position.
    pub fn seek(self: File, off: i64, whence: Whence) !u64 {
        let r = ax_seek(self.fd, off, @int_from_enum(whence));
        if r < 0 {
            return error.IoError;
        }
        return @bit_cast(u64, r);
    }

    /// The current position.
    pub fn position(self: File) !u64 {
        return self.seek(0, Whence.CUR);
    }

    /// The file's size (the position is kept).
    pub fn size(self: File) !u64 {
        let here = self.seek(0, Whence.CUR)!;
        let end = self.seek(0, Whence.END)!;
        _ = self.seek(@bit_cast(i64, here), Whence.SET)!;
        return end;
    }
}

/// Where File.seek counts from.
pub enum Whence: u32 {
    SET = 0,  // the start
    CUR = 1,  // the current position
    END = 2,
}

const OPEN_READ: u32 = 0;
const OPEN_WRITE: u32 = 1;   // create or truncate
const OPEN_APPEND: u32 = 2;  // create or append
const OPEN_UPDATE: u32 = 3;  // read and write, neither creating nor truncating

fn open_with(path: []u8, flags: u32) !File {
    let fd = ax_open(path.ptr, path.len, flags);
    if fd >= 0 {
        return File.{ fd: fd };
    }
    match fd {
        -2   => { return error.NotFound; }
        -13  => { return error.PermissionDenied; }
        -21  => { return error.IsDirectory; }
        else => { return error.IoError; }
    }
}

/// Opens an existing file for reading.
pub fn open(path: []u8) !File {
    return open_with(path, OPEN_READ);
}

/// Creates (or truncates) a file for writing.
pub fn create(path: []u8) !File {
    return open_with(path, OPEN_WRITE);
}

/// Opens a file for appending, creating it if needed.
pub fn append(path: []u8) !File {
    return open_with(path, OPEN_APPEND);
}

/// Opens an existing file for reading and writing, without truncating it.
pub fn open_update(path: []u8) !File {
    return open_with(path, OPEN_UPDATE);
}

// -----------------------------------------------------------------------------
// In-memory readers and writers
// -----------------------------------------------------------------------------

/// Writes into a fixed buffer; fails with NoSpaceLeft when it is full.
pub struct BufferWriter {
    buf: []mut u8,
    len: usize,

    pub fn init(buf: []mut u8) BufferWriter {
        return BufferWriter.{ buf: buf, len: 0 };
    }

    /// The returned Writer points at this BufferWriter: do not move it while
    /// the Writer is in use.
    pub fn writer(self: *mut BufferWriter) Writer {
        return Writer.{ ctx: @ptr_cast(*mut void, self), write_fn: buffer_write };
    }

    pub fn written(self: *BufferWriter) []mut u8 {
        return self.buf[..self.len];
    }

    pub fn reset(self: *mut BufferWriter) void {
        self.len = 0;
    }
}

fn buffer_write(ctx: *mut void, bytes: []u8) !usize {
    let w = @ptr_cast(*mut BufferWriter, ctx);
    let room = w.buf.len - w.len;
    if (room == 0) and (bytes.len > 0) {
        return error.NoSpaceLeft;
    }
    let n = @min(room, bytes.len);
    @mem_copy(w.buf[w.len..w.len + n], bytes[..n]);
    w.len += n;
    return n;
}

/// Reads from a byte slice.
pub struct SliceReader {
    data: []u8,
    pos: usize,

    pub fn init(data: []u8) SliceReader {
        return SliceReader.{ data: data, pos: 0 };
    }

    pub fn reader(self: *mut SliceReader) Reader {
        return Reader.{ ctx: @ptr_cast(*mut void, self), read_fn: slice_read };
    }
}

fn slice_read(ctx: *mut void, buf: []mut u8) !usize {
    let r = @ptr_cast(*mut SliceReader, ctx);
    let n = @min(r.data.len - r.pos, buf.len);
    @mem_copy(buf[..n], r.data[r.pos..r.pos + n]);
    r.pos += n;
    return n;
}

/// Buffers writes to another Writer; call flush() when done.
pub struct BufWriter {
    inner: Writer,
    buf: [4096]u8,
    len: usize,

    pub fn init(inner: Writer) BufWriter {
        return BufWriter.{ inner: inner, buf: [0; 4096], len: 0 };
    }

    pub fn writer(self: *mut BufWriter) Writer {
        return Writer.{ ctx: @ptr_cast(*mut void, self), write_fn: bufwriter_write };
    }

    pub fn flush(self: *mut BufWriter) !void {
        if self.len > 0 {
            let n = self.len;
            self.len = 0;
            self.inner.write_all(self.buf[..n])!;
        }
    }
}

fn bufwriter_write(ctx: *mut void, bytes: []u8) !usize {
    let w = @ptr_cast(*mut BufWriter, ctx);
    if bytes.len >= w.buf.len {
        w.flush()!;
        return w.inner.write(bytes);
    }
    if (w.len + bytes.len) > w.buf.len {
        w.flush()!;
    }
    @mem_copy(w.buf[w.len..w.len + bytes.len], bytes);
    w.len += bytes.len;
    return bytes.len;
}

/// Passes writes on to another Writer and counts the bytes: the offset of
/// what is written next, for formats that record where things are.
pub struct CountingWriter {
    inner: Writer,
    count: u64,

    pub fn init(inner: Writer) CountingWriter {
        return CountingWriter.{ inner: inner, count: 0 };
    }

    /// The returned Writer points at this CountingWriter: do not move it
    /// while the Writer is in use.
    pub fn writer(self: *mut CountingWriter) Writer {
        return Writer.{ ctx: @ptr_cast(*mut void, self), write_fn: counting_write };
    }
}

fn counting_write(ctx: *mut void, bytes: []u8) !usize {
    let w = @ptr_cast(*mut CountingWriter, ctx);
    let n = w.inner.write(bytes)!;
    w.count += @as(u64, n);
    return n;
}

/// A Writer that accepts and drops everything (to measure output, with a
/// CountingWriter).
pub fn discard() Writer {
    return Writer.{ ctx: @ptr_from_int(*mut void, 1), write_fn: discard_write };
}

fn discard_write(ctx: *mut void, bytes: []u8) !usize {
    return bytes.len;
}

// -----------------------------------------------------------------------------
// Tests (axiom test std/io.ax)
// -----------------------------------------------------------------------------

test "integer formatting" {
    let mut buf: [21]u8 = [0; 21];
    @expect_eq(fmt_u64(buf[..], 0), "0");
    @expect_eq(fmt_u64(buf[..], 18446744073709551615), "18446744073709551615");
    @expect_eq(fmt_i64(buf[..], -9223372036854775807 - 1), "-9223372036854775808");
    @expect_eq(fmt_hex(buf[..], 0xbeef), "beef");
}

test "integer parsing" {
    @expect_eq(parse_u64("12345")!, 12345);
    @expect_eq(parse_i64("-42")!, -42);
    _ = parse_u64("18446744073709551616") catch |e| {
        @expect_eq(e, error.IoError);
        return;
    };
    @trap();
}

test "BufferWriter and print_f64" {
    let mut storage: [64]u8 = [0; 64];
    let mut bw = BufferWriter.init(storage[..]);
    let w = bw.writer();
    w.print_f64(2.5, 2)!;
    w.print(" ")!;
    w.print_f64(-0.125, 1)!;
    w.print(" ")!;
    w.print_f64(1.0e20, 0)!;
    @expect_eq(bw.written(), "2.50 -0.1 1e20");
}

test "CountingWriter and discard" {
    let mut cw = CountingWriter.init(discard());
    let w = cw.writer();
    w.print("hello, ")!;
    w.print_u64(12345)!;
    @expect_eq(cw.count, 12);
    let mut storage: [8]u8 = [0; 8];
    let mut bw = BufferWriter.init(storage[..]);
    let mut c2 = CountingWriter.init(bw.writer());
    c2.writer().print("abc")!;
    @expect_eq(c2.count, 3);
    @expect_eq(bw.written(), "abc");
}

test "read_line over a SliceReader" {
    let mut sr = SliceReader.init("a\r\nbc\n");
    let r = sr.reader();
    let mut buf: [8]u8 = [0; 8];
    @expect_eq(r.read_line(buf[..])!, "a");
    @expect_eq(r.read_line(buf[..])!, "bc");
}
