                             100.45424938742576, 4.865010737554133, -81.85766189486368, -75.72346321951116,
                             -75.65523364346461, -42.9647256728029, -30.731553361466784, -71.77471012625332,
                             -107.86095037806571, -50.85575623154513, -57.190316739557694, -33.233793474673384,
