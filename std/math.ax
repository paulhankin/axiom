                       -17.34635105174432, -1.8760829789961875, -12.380253714560887, -19.380342677168866,
                       -15.296290023634892, -12.951996702019947, -37.84028427104839, -4.01867959768191,
                       -8.80122037175709, -5.019472634620939, -8.085075152137357, 200.0, 1000.5, 100000.0,
                       10000000000.0, 1e+300, -1000.5, 1.0000001, 1.9999, 2.0001, 0.9999];
    let lgamma_w: [98]f64 = [6.907178885383854, 2.2527126517342055, 0.5723649429247004, 0.0663762397347431, 0.0,
