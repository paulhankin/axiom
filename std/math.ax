                             -19.387021718651354, -100.50877988257712, 0.7746713498201956, -10.674895517907562,
                             -0.881379724326758, -8.310987734782755, 857.9336698258575, 5908.674175848678,
                             1051287.7089736566, 220258509288.81058, 6.897755278982137e+302, -5914.437701116853,
                             -5.772155869943063e-08, -4.227520877231328e-05, 4.228165811270834e-05,
                             5.772979156160041e-05];
    let mut e1: u64 = 0;
    let mut e2: u64 = 0;
    let mut e3: u64 = 0;
    let mut e4: f64 = 0.0;
    for k in @as(usize, 0)..ex.len {
        e1 = @max(e1, ulps(erf(ex[k]), erf_w[k]));
        e2 = @max(e2, ulps(erfc(ex[k]), erfc_w[k]));
    }
    for k in @as(usize, 0)..gx.len {
        e3 = @max(e3, ulps(gamma(gx[k]), gamma_w[k]));
    }
    for k in @as(usize, 0)..lx.len {
        // relative error, or absolute near the zeros
        e4 = @max(e4, @abs(lgamma(lx[k]) - lgamma_w[k]) / @max(@abs(lgamma_w[k]), 1.0));
    }
    @expect(e1 <= 4);
    @expect(e2 <= 2);
    @expect(e3 <= 8);
    @expect(e4 <= 2.0e-15);
    // just below zero and the negative integers, and the smallest x
    let nx: [5]f64 = [-1e-17, -3e-16, -1e-10, -0.999999999999999, -2.99999999];
    let ngamma_w: [5]f64 = [-1e+17, -3333333333333334.0, -10000000000.577215, -1000799917193444.0, -16666666.977310799];
    for k in @as(usize, 0)..nx.len {
        @expect(ulps(gamma(nx[k]), ngamma_w[k]) <= 8);
    }
    let tx: [4]f64 = [-1e-17, -3e-16, 1e-310, -1e-310];
    let tlgamma_w: [4]f64 = [39.14394658089878, 35.74274919923662, 713.8013788281542, 713.8013788281542];
    for k in @as(usize, 0)..tx.len {
        @expect((@abs(lgamma(tx[k]) - tlgamma_w[k]) / tlgamma_w[k]) <= 2.0e-15);
    }
    @expect(gamma(-1e-310) == -inf());
    @expect(is_nan(erf(nan())) and is_nan(erfc(nan())) and is_nan(gamma(nan())) and is_nan(lgamma(nan())));
    @expect(is_nan(gamma(-3.0)) and (gamma(0.0) == inf()) and (gamma(-0.0) == -inf()) and (gamma(200.0) == inf()));
    @expect((lgamma(0.0) == inf()) and (lgamma(-2.0) == inf()) and (lgamma(inf()) == inf()));
    @expect((erf(inf()) == 1.0) and (erfc(-inf()) == 2.0) and (erfc(inf()) == 0.0));
    @expect(gamma(21.0) == 2432902008176640000.0);
}

// the distance in ulps (large for different signs)
fn ulps(a: f64, b: f64) u64 {
    if a == b {
        return 0;
    }
    let ia = @bit_cast(i64, bits(a));
    let ib = @bit_cast(i64, bits(b));
    if (ia < 0) != (ib < 0) {
        return 1 << 62;
    }
    return @bit_cast(u64, @abs(ia - ib));
}
