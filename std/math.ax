    let mut e2: u64 = 0;
    let mut e3: u64 = 0;
    let mut e4: f64 = 0.0;
    for k in @as(usize, 0)..ex.len {
        e1 = @max(e1, ulps(erf(ex[k]), erf_w[k]));
        e2 = @max(e2, ulps(erfc(ex[k]), erfc_w[k]));
    }
    for k in @as(usize, 0)..gx.len {
        e3 = @max(e3, ulps(gamma(gx[k]), gamma_w[k]));
    }
    for k in @as(usize, 0)..lx.len {
        // relative error, or absolute near the zeros
        e4 = @max(e4, @abs(lgamma(lx[k]) - lgamma_w[k]) / @max(@abs(lgamma_w[k]), 1.0));
    }
    @expect(e1 <= 4);
    @expect(e2 <= 2);
    @expect(e3 <= 8);
    @expect(e4 <= 2.0e-15);
    @expect(is_nan(erf(nan())) and is_nan(erfc(nan())) and is_nan(gamma(nan())) and is_nan(lgamma(nan())));
    @expect(is_nan(gamma(-3.0)) and (gamma(0.0) == inf()) and (gamma(-0.0) == -inf()) and (gamma(200.0) == inf()));
    @expect((lgamma(0.0) == inf()) and (lgamma(-2.0) == inf()) and (lgamma(inf()) == inf()));
    @expect((erf(inf()) == 1.0) and (erfc(-inf()) == 2.0) and (erfc(inf()) == 0.0));
    @expect(gamma(21.0) == 2432902008176640000.0);
}

// the distance in ulps (large for different signs)
fn ulps(a: f64, b: f64) u64 {
    if a == b {
        return 0;
    }
    let ia = @bit_cast(i64, bits(a));
    let ib = @bit_cast(i64, bits(b));
    if (ia < 0) != (ib < 0) {
        return 1 << 62;
    }
    return @bit_cast(u64, @abs(ia - ib));
}
