// =============================================================================
// std/math.ax - elementary functions on f64 (and f32).
//
//     let y = math.sin(x) * math.exp(-t);
//     let h = math.atan2(dy, dx);
//     let g = math.powf(c, 1.0 / 2.4);      // f32 versions end in f
//
// Square roots, floor, ceil, trunc, rounding, fma, remainder, copysign and
// abs are builtins (@sqrt, @floor, ...). The functions here are the C
// library's (std/internal/math/, which cites the methods), without its
// errno and exception flags: measured against exact results, each is within
// 1 ulp over the whole domain (most within 0.52; trigonometry of huge
// arguments included: the reduction is exact), the same bits on every
// target. The f32 versions are correctly rounded but in rare cases (within
// 0.5 + 2^-12 ulp).
// =============================================================================
import "internal/math/atrig.ax" as m_at;
import "internal/math/core.ax" as m_core;
import "internal/math/exp.ax" as m_exp;
import "internal/math/float.ax" as m_fl;
import "internal/math/hyp.ax" as m_hyp;
import "internal/math/log.ax" as m_log;
import "internal/math/pow.ax" as m_pow;
import "internal/math/special.ax" as m_sp;
import "internal/math/trig.ax" as m_tr;

pub const PI: f64 = 3.14159265358979323846;
pub const TAU: f64 = 6.28318530717958647693;
pub const E: f64 = 2.71828182845904523536;
pub const LN2: f64 = 0.693147180559945309417;
pub const LN10: f64 = 2.30258509299404568402;
pub const SQRT2: f64 = 1.41421356237309504880;

/// Infinity and a quiet NaN.
pub fn inf() f64 {
    return @bit_cast(f64, @as(u64, 0x7ff0000000000000));
}

pub fn nan() f64 {
    return @bit_cast(f64, @as(u64, 0x7ff8000000000000));
}

pub fn is_nan(x: f64) bool {
    return x != x;
}

pub fn is_inf(x: f64) bool {
    return (x == inf()) or (x == -inf());
}

pub fn is_finite(x: f64) bool {
    return (x - x) == 0.0;
}

fn bits(x: f64) u64 {
    return @bit_cast(u64, x);
}

fn from_bits(b: u64) f64 {
    return @bit_cast(f64, b);
}

/// x * 2^n.
pub fn ldexp(x: f64, n: i32) f64 {
    let mut y = x;
    let mut k = n;
    let p1023 = from_bits(0x7fe0000000000000);
    let m969 = from_bits(0x0360000000000000);  // 2^-1022 * 2^53
    if k > 1023 {
        y = y * p1023;
        k -= 1023;
        if k > 1023 {
            y = y * p1023;
            k = @min(k - 1023, 1023);
        }
    } else if k < -1022 {
        y = y * m969;
        k += 1022 - 53;
        if k < -1022 {
            y = y * m969;
            k = @max(k + (1022 - 53), -1022);
        }
    }
    return y * from_bits(@as(u64, @truncate(u32, 0x3ff + k)) << 52);
}

/// x as m * 2^e with 0.5 <= |m| < 1 (or x itself for 0, inf and NaN).
pub fn frexp(x: f64) Frexp {
    let e = @as(i32, @truncate(u16, (bits(x) >> 52) & 0x7ff));
    if e == 0 {
        if x == 0.0 {
            return Frexp.{ mantissa: x, exponent: 0 };
        }
        let r = frexp(x * from_bits(0x43f0000000000000));  // 2^64
        return Frexp.{ mantissa: r.mantissa, exponent: r.exponent - 64 };
    }
    if e == 0x7ff {
        return Frexp.{ mantissa: x, exponent: 0 };
    }
    let m = from_bits((bits(x) & 0x800fffffffffffff) | 0x3fe0000000000000);
    return Frexp.{ mantissa: m, exponent: e - 0x3fe };
}

pub struct Frexp {
    mantissa: f64,
    exponent: i32,
}

// -----------------------------------------------------------------------------
// Exponentials and logarithms
// -----------------------------------------------------------------------------

/// e^x.
pub fn exp(x: f64) f64 {
    return m_exp.exp(x, m_core.quiet());
}

/// 2^x.
pub fn exp2(x: f64) f64 {
    return m_exp.exp2(x, m_core.quiet());
}

/// e^x - 1, accurate for small x.
pub fn expm1(x: f64) f64 {
    return m_exp.expm1(x, m_core.quiet());
}

/// The natural logarithm.
pub fn log(x: f64) f64 {
    return m_log.log(x, m_core.quiet());
}

/// log(1 + x), accurate for small x.
pub fn log1p(x: f64) f64 {
    return m_log.log1p(x, m_core.quiet());
}

/// The base-2 logarithm.
pub fn log2(x: f64) f64 @multiversion("fma") {
    return m_log.log2(x, m_core.quiet());
}

/// The base-10 logarithm.
pub fn log10(x: f64) f64 @multiversion("fma") {
    return m_log.log10(x, m_core.quiet());
}

/// x^y.
pub fn pow(x: f64, y: f64) f64 @multiversion("fma") {
    return m_pow.pow(x, y, m_core.quiet());
}

/// The cube root.
pub fn cbrt(x: f64) f64 {
    return m_pow.cbrt(x);
}

/// sqrt(x^2 + y^2) without undue overflow or underflow.
pub fn hypot(x: f64, y: f64) f64 @multiversion("fma") {
    return m_pow.hypot(x, y, m_core.quiet());
}

// -----------------------------------------------------------------------------
// Trigonometry
// -----------------------------------------------------------------------------

/// sin(x).
pub fn sin(x: f64) f64 {
    return m_tr.sin(x, m_core.quiet());
}

/// cos(x).
pub fn cos(x: f64) f64 {
    return m_tr.cos(x, m_core.quiet());
}

/// Both sin(x) and cos(x).
pub fn sincos(x: f64) SinCos @multiversion("fma") {
    let r = m_tr.sincos(x, m_core.quiet());
    return SinCos.{ sin: r.sin, cos: r.cos };
}

pub struct SinCos {
    sin: f64,
    cos: f64,
}

/// tan(x).
pub fn tan(x: f64) f64 @multiversion("fma") {
    return m_tr.tan(x, m_core.quiet());
}

/// The arctangent.
pub fn atan(x: f64) f64 @multiversion("fma") {
    return m_at.atan(x, m_core.quiet());
}

/// The arctangent of y/x, in the quadrant of (x, y).
pub fn atan2(y: f64, x: f64) f64 @multiversion("fma") {
    return m_at.atan2(y, x, m_core.quiet());
}

/// The arcsine.
pub fn asin(x: f64) f64 @multiversion("fma") {
    return m_at.asin(x, m_core.quiet());
}

/// The arccosine.
pub fn acos(x: f64) f64 @multiversion("fma") {
    return m_at.acos(x, m_core.quiet());
}

// -----------------------------------------------------------------------------
// Hyperbolic and special functions
// -----------------------------------------------------------------------------

/// The hyperbolic sine.
pub fn sinh(x: f64) f64 @multiversion("fma") {
    return m_hyp.sinh(x, m_core.quiet());
}

/// The hyperbolic cosine.
pub fn cosh(x: f64) f64 @multiversion("fma") {
    return m_hyp.cosh(x, m_core.quiet());
}

/// The hyperbolic tangent.
pub fn tanh(x: f64) f64 @multiversion("fma") {
    return m_hyp.tanh(x, m_core.quiet());
}

/// The error function.
pub fn erf(x: f64) f64 {
    return m_sp.erf(x, m_core.quiet());
}

/// The complementary error function, 1 - erf(x), accurate for large x.
pub fn erfc(x: f64) f64 {
    return m_sp.erfc(x, m_core.quiet());
}

/// The gamma function.
pub fn gamma(x: f64) f64 {
    return m_sp.tgamma(x, m_core.quiet());
}

/// log|gamma(x)|.
pub fn lgamma(x: f64) f64 {
    return m_sp.lgamma(x, m_core.quiet());
}

// -----------------------------------------------------------------------------
// f32 versions
// -----------------------------------------------------------------------------

pub fn expf(x: f32) f32 {
    return m_fl.expf(x, m_core.quiet());
}

pub fn logf(x: f32) f32 {
    return m_fl.logf(x, m_core.quiet());
}

pub fn log2f(x: f32) f32 {
    return m_fl.log2f(x, m_core.quiet());
}

pub fn cbrtf(x: f32) f32 {
    return m_fl.cbrtf(x, m_core.quiet());
}

pub fn sinf(x: f32) f32 {
    return m_fl.sinf(x, m_core.quiet());
}

pub fn cosf(x: f32) f32 {
    return m_fl.cosf(x, m_core.quiet());
}

pub fn tanf(x: f32) f32 {
    return m_fl.tanf(x, m_core.quiet());
}

pub fn atanf(x: f32) f32 {
    return m_fl.atanf(x, m_core.quiet());
}

pub fn tanhf(x: f32) f32 {
    return m_fl.tanhf(x, m_core.quiet());
}

pub fn powf(x: f32, y: f32) f32 @multiversion("fma") {
    return m_fl.powf(x, y, m_core.quiet());
}

pub fn atan2f(y: f32, x: f32) f32 {
    return m_fl.atan2f(y, x, m_core.quiet());
}

pub fn hypotf(x: f32, y: f32) f32 {
    return m_fl.hypotf(x, y, m_core.quiet());
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

/// Whether a and b are within n ulps.
fn close(a: f64, b: f64, n: u64) bool {
    if a == b {
        return true;
    }
    let ia = @bit_cast(i64, bits(a));
    let ib = @bit_cast(i64, bits(b));
    if (ia < 0) != (ib < 0) {
        return false;
    }
    let d = @abs(ia - ib);
    return @bit_cast(u64, d) <= n;
}

test "values" {
    @expect(close(exp(1.0), E, 1));
    @expect(close(log(E), 1.0, 1));
    @expect_eq(log(1.0), 0.0);
    @expect_eq(exp(0.0), 1.0);
    @expect_eq(pow(2.0, 10.0), 1024.0);
    @expect_eq(pow(-2.0, 3.0), -8.0);
    @expect(is_nan(pow(-2.0, 0.5)));
    @expect(close(pow(10.0, 0.5), 3.1622776601683795, 1));
    @expect_eq(cbrt(27.0), 3.0);
    @expect_eq(cbrt(-8.0), -2.0);
    @expect(close(sin(PI / 6.0), 0.5, 1));
    @expect(close(cos(PI / 3.0), 0.5, 1));
    @expect(close(atan2(1.0, 1.0), PI / 4.0, 1));
    @expect(close(atan2(-1.0, -1.0), (-3.0 * PI) / 4.0, 1));
    @expect_eq(atan2(0.0, -1.0), PI);
    @expect(close(sin(1.0e22), -0.8522008497671888, 1));
    @expect(close(cos(1.0e300), -0.5753861119575491, 1));
    @expect_eq(log2(1024.0), 10.0);
    @expect(close(log10(1000.0), 3.0, 1));
    @expect(close(expm1(1.0e-10), 1.00000000005e-10, 1));
    @expect(close(log1p(1.0e-10), 9.999999999500001e-11, 1));
    @expect(close(tanh(0.5), 0.46211715726000974, 2));
    @expect(close(hypot(3.0, 4.0), 5.0, 0));
    @expect(is_inf(exp(1000.0)));
    @expect_eq(exp(-1000.0), 0.0);
    @expect(is_inf(-log(0.0)));
    @expect(is_nan(log(-1.0)));
    let f = frexp(48.0);
    @expect_eq(f.mantissa, 0.75);
    @expect_eq(f.exponent, 6);
    @expect_eq(ldexp(0.75, 6), 48.0);
    @expect_eq(ldexp(1.0, -1074), from_bits(1));
    @expect_eq(sinf(0.0), 0.0);
    @expect_eq(powf(2.0, 3.0), 8.0);
}
