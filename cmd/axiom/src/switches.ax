// =============================================================================
// switches.ax - multiway branches: what the optimizer simplifies in an IR
// switch (simplify), and how code generation lowers one (lower), the same
// for both front ends and every target.
//
// A switch stays one instruction through the optimizer (whose passes see
// its cases as edges: gvn.ax knows the value on a case edge, thread.ax
// threads through one). Just before code generation (x64.ax, a64.ax,
// wasm.ax: compile_func / gen_function) lower() turns each switch into
// a search over clusters of its cases, sorted by their values as signed
// integers of the switch's type:
//
//   - a range: consecutive values with one target (one value: `x == v`;
//     several: `x - lo <=u hi - lo`, or one signed compare where the
//     search already knows one side);
//   - a jump table: a run of at least TABLE_MIN ranges, at least 40% of
//     whose span (at most TABLE_MAX values) are cases (60% for fewer than
//     8 values). It is a range check
//     (unless the search knows the value is in the run) and a switch on
//     `x - lo` marked ir.SW_TABLE, with a case for every value of the span,
//     which the native backends make an indirect jump through a table of
//     32-bit offsets and WebAssembly a br_table;
//   - a bit test: cases within one 64-bit word's range going to at most
//     three targets, enough of them to beat their compares (one target and
//     at least three compares, two and five, three and six, a range counting
//     two): a range check, then `(1 << (x - base)) & mask` per target.
//
// Jump tables are chosen first, by dynamic programming over the ranges for
// the fewest clusters (greedily for more than DP_MAX ranges), then bit tests
// greedily among the ranges left. The clusters are then searched by a
// balanced binary tree of signed compares, down to at most LEAF clusters,
// tested in ascending order: where the clusters at a leaf are all single
// values they stay one small switch, which the backends compare in a
// chain. The search keeps the interval the value is known to be in, which
// drops range checks a table or bit test does not need and turns the last
// range of an interval into a plain jump.
//
// A switch with at most LEAF cases is left as it is (a compare chain).
//
// What `unreachable` says (C's __builtin_unreachable and unreachable(), a
// path the program never takes): a switch whose default is a block of
// nothing but `unreachable`, or whose value the conditional branches above
// it (each the only way on, its other way such a block) keep within values
// that all have cases, has no default to go to (dead_default): a table needs
// no range check and the search knows the value is among the cases. Once
// the switches are lowered, those branches go straight on (drop_dead_tests):
// their tests are not made.
// =============================================================================
import "ir.ax" as ir;
import "util.ax" as u;

pub const TABLE_MIN: usize = 4;    // ranges a jump table covers at least
pub const TABLE_MAX: u64 = 65536;  // values a jump table spans at most
const LEAF: usize = 4;             // clusters tested in sequence at a leaf of the search
const DP_MAX: usize = 2000;        // ranges the dynamic programming partitions at most
const WORD: u64 = 64;              // the bits of a bit test's mask

const K_RANGE: i32 = 0;
const K_TABLE: i32 = 1;
const K_BITS: i32 = 2;

struct Case {
    v: i64,  // the value, sign-extended from the switch's type
    b: *mut ir.Block,
}

struct Cl {
    kind: i32,
    lo: i64,  // the values it covers: lo..hi (signed order)
    hi: i64,
    b: *mut ir.Block,  // K_RANGE: the target
    first: usize,      // its cases: cs[first..last]
    last: usize,
}

// -----------------------------------------------------------------------------
// Simplification (opt.simplify_cfg)
// -----------------------------------------------------------------------------

/// Simplifies the switch t ending block b: cases that go where the default
/// does are dropped (b stays a predecessor of that block: its phis keep
/// their input), a switch left without cases becomes a jump and one with one
/// case a compare and a conditional branch. (A switch on a constant is
/// opt.simplify_cfg's.) True if anything changed.
pub fn simplify(b: *mut ir.Block, t: *mut ir.Value) bool {
    if (t.op != ir.OP_SWITCH) or ir.is_const(t.a) or (t.cv == ir.SW_TABLE) {
        return false;
    }
    let mut any = false;
    let mut n: usize = 0;
    let bs = ir.bs_mut(t);
    for k in 0..t.xs.len {
        if bs.get(k) != t.t1 {
            ir.set_x(t, n, t.xs.get(k));
            bs.set(n, bs.get(k));
            n += 1;
        }
    }
    if n != t.xs.len {
        ir.trunc_x(t, n);
        bs.len = n;
        any = true;
    }
    if n == 0 {
        t.op = ir.OP_BR;
        ir.set_a(t, ir.vnil());
        return true;
    }
    if (n == 1) and (t.a.ty.kind == ir.T_INT) and (t.a.ty.bits > 1) {
        // (a bool's switch stays: compare chains test it as it is)
        let c = ir.new_inst(b.fnp, ir.OP_ICMP, ir.t_int(1));
        c.cv = @as(u64, @bit_cast(u32, ir.IntEQ));
        ir.set_a(c, t.a);
        ir.set_b(c, t.xs.get(0));
        c.src = t.src;
        c.scope = t.scope;
        ir.insert_before(t, c);
        let target = bs.get(0);
        ir.clear_x(t);
        bs.clear();
        t.op = ir.OP_CONDBR;
        ir.set_a(t, c);
        t.t2 = t.t1;
        t.t1 = target;
        return true;
    }
    return any;
}

// -----------------------------------------------------------------------------
// Lowering
// -----------------------------------------------------------------------------

threadlocal let mut BD: *mut ir.Builder = @ptr_from_int(*mut ir.Builder, 0);
threadlocal let mut F: *mut ir.Func = @ptr_from_int(*mut ir.Func, 0);
threadlocal let mut X: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);     // the value switched on
threadlocal let mut DFLT: *mut ir.Block = @ptr_from_int(*mut ir.Block, 0);  // where no case goes
threadlocal let mut CS: u.List.[Case] = u.List.[Case].{ data: @ptr_from_int(*mut Case, 0), len: 0, cap: 0 };  // the cases, sorted
threadlocal let mut MADE: u.List.[*mut ir.Block] = u.List.[*mut ir.Block].{
    data: @ptr_from_int(*mut *mut ir.Block, 0), len: 0, cap: 0 };

fn cmp_case(a: Case, b: Case) i32 {
    if a.v < b.v {
        return -1;
    }
    if a.v > b.v {
        return 1;
    }
    return 0;
}

/// Lowers f's switches for code generation, as the header says.
// Is b a block of nothing but `unreachable` (no trap before it: a path the
// program does not take)?
fn bare_unreachable(b: *ir.Block) bool {
    return u.notnil(b) and u.notnil(b.first) and (b.first.op == ir.OP_UNREACHABLE);
}

// The block whose terminator is the only way into b (nil: none, or several).
fn only_pred(f: *mut ir.Func, b: *mut ir.Block) *mut ir.Block {
    let mut r = ir.bnil();
    let mut x = f.first;
    while u.notnil(x) {
        let t = ir.terminator(x);
        for k in 0..ir.succ_count(t) {
            if ir.succ(t, k) == b {
                if u.notnil(r) and (r != x) {
                    return ir.bnil();
                }
                r = x;
            }
        }
        x = x.next;
    }
    return r;
}

// The interval lo..hi (signed) value x is known to be in at the end of b
// from the branches above it whose other way is a bare `unreachable`: on
// the way from each one only, up to 8 of them. False if none says anything.
fn known_interval(f: *mut ir.Func, b0: *mut ir.Block, x: *mut ir.Value, lo: *mut i64, hi: *mut i64) bool {
    let mut b = b0;
    let mut any = false;
    for _k in @as(i32, 0)..8 {
        let p = only_pred(f, b);
        if u.isnil(p) {
            break;
        }
        let t = ir.terminator(p);
        if (t.op == ir.OP_CONDBR) and (t.t1 != t.t2) and (bare_unreachable(t.t1) or bare_unreachable(t.t2)) {
            let c = t.a;
            // the condition holds on our way when the bare block is t2
            let truth = bare_unreachable(t.t2);
            if ir.is_op(c, ir.OP_ICMP) and (ir.resolve(c.a) == x) and ir.is_cint(c.b) and (x.ty.bits <= 64) {
                if narrow(ir.pred_of(c), ir.sval(c.b), truth, x.ty.bits, lo, hi) {
                    any = true;
                }
            } else if ir.is_op(c, ir.OP_ICMP) and ir.is_op(ir.resolve(c.a), ir.OP_LSHR) and ir.is_cint(c.b) and
                      (ir.cint_val(c.b) == 0) and (ir.resolve(ir.resolve(c.a).a) == x) and
                      ir.is_cint(ir.resolve(c.a).b) and
                      (ir.cint_val(ir.resolve(c.a).b) == @as(u64, @bit_cast(u32, x.ty.bits - 1))) and
                      ((ir.pred_of(c) == ir.IntEQ) or (ir.pred_of(c) == ir.IntNE)) {
                // x >> (bits - 1) == 0: the sign bit clear, x >= 0
                if narrow(ir.IntSGE, 0, truth == (ir.pred_of(c) == ir.IntEQ), x.ty.bits, lo, hi) {
                    any = true;
                }
            }
        }
        b = p;
    }
    return any;
}

// Narrows lo..hi by `x pred k` being `truth` (x of `bits` bits, k read as
// signed); true if it did. Unsigned relations narrow only where k is at
// least 0 and the relation keeps x within 0..smax (x <u k, x <=u k).
fn narrow(pred: i32, k: i64, truth: bool, bits: i32, lo: *mut i64, hi: *mut i64) bool {
    let mut p = pred;
    if not truth {
        p = ir.inv_pred(p);
    }
    let mut l = lo.*;
    let mut h = hi.*;
    if p == ir.IntEQ {
        l = @max(l, k);
        h = @min(h, k);
    } else if p == ir.IntSLT {
        h = @min(h, k -% 1);
    } else if p == ir.IntSLE {
        h = @min(h, k);
    } else if p == ir.IntSGT {
        l = @max(l, k +% 1);
    } else if p == ir.IntSGE {
        l = @max(l, k);
    } else if ((p == ir.IntULT) or (p == ir.IntULE)) and (k >= 0) and
              ((bits == 64) or (k < (@as(i64, 1) << @int_cast(u32, bits - 1)))) {
        l = @max(l, 0);
        if p == ir.IntULT {
            h = @min(h, k - 1);
        } else {
            h = @min(h, k);
        }
    } else {
        return false;
    }
    lo.* = l;
    hi.* = h;
    return true;
}

// Does switch t (ending b) never go to its default: the default is a bare
// `unreachable`, or the value is known (known_interval) to be one of the
// cases' values? lo and hi: the interval known (else the type's).
fn dead_default(f: *mut ir.Func, b: *mut ir.Block, t: *ir.Value, lo: *mut i64, hi: *mut i64) bool {
    let x = ir.resolve(t.a);
    let known = known_interval(f, b, x, lo, hi);
    if bare_unreachable(t.t1) {
        return true;
    }
    if not known or (lo.* > hi.*) or (dist(lo.*, hi.*) >= 4096) {
        return false;
    }
    // every value of lo..hi a case (to another block than the default)
    let n = @truncate(usize, dist(lo.*, hi.*)) + 1;
    let seen = u.calloc_slice.[bool](n);
    let mut cnt: usize = 0;
    for k in 0..t.xs.len {
        let v = ir.sval(t.xs.get(k));
        if (v >= lo.*) and (v <= hi.*) and (ir.bs_of(t).get(k) != t.t1) {
            let i = @truncate(usize, dist(lo.*, v));
            if not seen[i] {
                seen[i] = true;
                cnt += 1;
            }
        }
    }
    u.free_slice(seen);
    return cnt == n;
}

// The conditional branches whose one way is a bare `unreachable`: a jump
// the other way (the program never takes the first, so the test changes
// nothing). After the switches are lowered, which ask about them.
fn drop_dead_tests(f: *mut ir.Func) void {
    let mut any = false;
    let mut b = f.first;
    while u.notnil(b) {
        let t = ir.terminator(b);
        if u.notnil(t) and (t.op == ir.OP_CONDBR) and (t.t1 != t.t2) and
           (bare_unreachable(t.t1) != bare_unreachable(t.t2)) {
            let mut keep = t.t1;
            if bare_unreachable(t.t1) {
                keep = t.t2;
            }
            t.op = ir.OP_BR;
            ir.set_a(t, ir.vnil());
            t.t1 = keep;
            t.t2 = ir.bnil();
            any = true;
        }
        b = b.next;
    }
    if any {
        ir.remove_unreachable(f);
        drop_unused(f);
    }
}

// Removes the instructions without effects whose values nothing uses
// (the tests drop_dead_tests left, and what only they used).
fn drop_unused(f: *mut ir.Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.aux = 0;
            i = i.next;
        }
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            count_use(i.a);
            count_use(i.b);
            count_use(i.c);
            for k in 0..i.xs.len {
                count_use(i.xs.get(k));
            }
            i = i.next;
        }
        b = b.next;
    }
    let mut work = u.List.[*mut ir.Value].empty();
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if removable(i) {
                work.push(i);
            }
            i = i.next;
        }
        b = b.next;
    }
    while work.len > 0 {
        let i = work.pop();
        if (i.aux != 0) or u.isnil(i.blk) {
            continue;
        }
        let ops: [3]*mut ir.Value = [ir.resolve(i.a), ir.resolve(i.b), ir.resolve(i.c)];
        ir.remove_inst(i);
        for o in ops {
            if u.notnil(o) and (o.kind == ir.V_INST) {
                o.aux -= 1;
                if removable(o) {
                    work.push(o);
                }
            }
        }
    }
    work.deinit();
}

fn count_use(o: *mut ir.Value) void {
    if u.notnil(o) {
        let r = ir.resolve(o);
        if r.kind == ir.V_INST {
            r.aux += 1;
        }
    }
}

// (an unused instruction of the few kinds a test is made of: compares,
// shifts and the bitwise operations, without operands in xs)
fn removable(i: *ir.Value) bool {
    let op = i.op;
    return (i.aux == 0) and (i.xs.len == 0) and not ir.has_effects(i) and
           ((op == ir.OP_ICMP) or (op == ir.OP_LSHR) or (op == ir.OP_ASHR) or (op == ir.OP_SHL) or (op == ir.OP_AND) or
            (op == ir.OP_OR) or (op == ir.OP_XOR) or (op == ir.OP_ADD) or (op == ir.OP_SUB));
}

pub fn lower(f: *mut ir.Func) void {
    lower_switches(f);
    drop_dead_tests(f);
}

fn lower_switches(f: *mut ir.Func) void {
    let mut todo = u.List.[*mut ir.Block].empty();
    let mut b = f.first;
    while u.notnil(b) {
        let t = ir.terminator(b);
        if u.notnil(t) and (t.op == ir.OP_SWITCH) and (t.cv != ir.SW_TABLE) and (t.a.ty.kind == ir.T_INT) and
           (t.a.ty.bits >= 8) and (t.a.ty.bits <= 64) and not ir.is_const(t.a) and (t.xs.len > LEAF) {
            todo.push(b);
        }
        b = b.next;
    }
    if todo.len == 0 {
        todo.deinit();
        return;
    }
    if u.isnil(BD) {
        BD = ir.new_builder();
    }
    F = f;
    let src = ir.cur_src;
    let scope = ir.cur_scope;
    for k in 0..todo.len {
        lower_one(todo.get(k));
    }
    ir.cur_src = src;
    ir.cur_scope = scope;
    todo.deinit();
}

// The input of phi p from block `from` (nil: none).
fn phi_input(p: *ir.Value, from: *mut ir.Block) *mut ir.Value {
    for k in 0..ir.bs_of(p).len {
        if ir.bs_of(p).get(k) == from {
            return p.xs.get(k);
        }
    }
    return ir.vnil();
}

fn lower_one(b: *mut ir.Block) void {
    let t = ir.terminator(b);
    X = t.a;
    DFLT = t.t1;
    // (what unreachable paths say: dead_default, and the interval the
    // search starts from)
    let mut klo: i64 = 0 - 0x7fff_ffff_ffff_ffff - 1;
    let mut khi: i64 = 0x7fff_ffff_ffff_ffff;
    let dead = dead_default(F, b, t, &mut klo, &mut khi);
    ir.cur_src = t.src;
    ir.cur_scope = t.scope;
    // the cases, sorted, without those going to the default and (keeping
    // the first) repeated values
    let n0 = t.xs.len;
    CS.clear();
    for _k in 0..n0 {
        CS.push(Case.{ v: 0, b: DFLT });
    }
    let cs = CS.items();
    let mut n: usize = 0;
    for k in 0..n0 {
        if ir.bs_of(t).get(k) != DFLT {
            cs[n] = Case.{ v: ir.sval(t.xs.get(k)), b: ir.bs_of(t).get(k) };
            n += 1;
        }
    }
    u.sort.[Case](cs[0..n], cmp_case);  // (stable)
    let mut m: usize = 0;
    for k in 0..n {
        if (m == 0) or (cs[k].v != cs[m - 1].v) {
            cs[m] = cs[k];
            m += 1;
        }
    }
    CS.len = m;
    // the old successors with phis (each once: is_old, by block id), to
    // give the phis inputs from the new blocks and take b's away where b no
    // longer goes
    let nids = @int_cast(usize, F.nblocks);
    let mut olds = u.List.[*mut ir.Block].empty();
    let is_old = u.calloc_slice.[bool](nids + 1);
    for k in 0..ir.succ_count(t) {
        let s = ir.succ(t, k);
        let id = @int_cast(usize, s.id);
        if not is_old[id] and u.notnil(s.first) and (s.first.op == ir.OP_PHI) {
            is_old[id] = true;
            olds.push(s);
        }
    }
    ir.remove_inst(t);
    MADE.clear();
    if m == 0 {
        ir.at_end(BD, b);
        ir.br(BD, DFLT);
    } else {
        let cl = clusters(CS.items());
        let bits = X.ty.bits;
        let mut tmin: i64 = 0 - 0x7fff_ffff_ffff_ffff - 1;
        let mut tmax: i64 = 0x7fff_ffff_ffff_ffff;
        if bits < 64 {
            tmax = @bit_cast(i64, (@as(u64, 1) << @int_cast(u32, bits - 1)) - 1);
            tmin = 0 - tmax - 1;
        }
        if dead {
            klo = @max(klo, cs[0].v);
            khi = @min(khi, cs[m - 1].v);
        }
        if (klo <= khi) and (klo >= tmin) and (khi <= tmax) {
            tmin = klo;
            tmax = khi;
        }
        tree(b, cl.items(), tmin, tmax);
        cl.deinit();
    }
    if olds.len > 0 {
        // each new block's edges into them take b's input (once per block:
        // seen holds 1 + the index of the last block that gave one)
        let seen = u.calloc_slice.[usize](nids + 1);
        for mi in 0..MADE.len {
            let nb = MADE.get(mi);
            let nt = ir.terminator(nb);
            for k in 0..ir.succ_count(nt) {
                let s = ir.succ(nt, k);
                let id = @int_cast(usize, s.id);
                if (id < nids) and is_old[id] and (seen[id] != mi + 1) {
                    seen[id] = mi + 1;
                    let mut p = s.first;
                    while u.notnil(p) and (p.op == ir.OP_PHI) {
                        let x = phi_input(p, b);
                        if u.notnil(x) {
                            ir.add_incoming(p, x, nb);
                        }
                        p = p.next;
                    }
                }
            }
        }
        // b's own input stays where b still goes
        let bt = ir.terminator(b);
        for k in 0..ir.succ_count(bt) {
            let id = @int_cast(usize, ir.succ(bt, k).id);
            if id < nids {
                seen[id] = 0x7fff_ffff;
            }
        }
        for s in olds.items() {
            if seen[@int_cast(usize, s.id)] != 0x7fff_ffff {
                ir.remove_phi_input(s, b);
            }
        }
        u.free_slice(seen);
    }
    u.free_slice(is_old);
    olds.deinit();
}

fn new_block() *mut ir.Block {
    let b = ir.append_block(F, "switch");
    MADE.push(b);
    return b;
}

// d = hi - lo, as an unsigned distance (it may not fit an i64)
fn dist(lo: i64, hi: i64) u64 {
    return @bit_cast(u64, hi) -% @bit_cast(u64, lo);
}

// The clusters of the sorted cases cs (the header says how).
fn clusters(cs: []Case) u.List.[Cl] {
    // ranges
    let mut rs = u.List.[Cl].empty();
    for k in 0..cs.len {
        if (rs.len > 0) and (rs.get(rs.len - 1).b == cs[k].b) and (cs[k].v == rs.get(rs.len - 1).hi +% 1) {
            let r = rs.at(rs.len - 1);
            r.hi = cs[k].v;
            r.last = k + 1;
        } else {
            rs.push(Cl.{ kind: K_RANGE, lo: cs[k].v, hi: cs[k].v, b: cs[k].b, first: k, last: k + 1 });
        }
    }
    let nr = rs.len;
    // jump tables: end[i] is the last range of the cluster starting at i
    let end = u.newn.[usize](nr + 1);
    for i in 0..nr {
        end[i] = i;
    }
    if nr >= TABLE_MIN {
        if nr <= DP_MAX {
            // fewest clusters for rs[i..]: best[i]
            let best = u.newn.[usize](nr + 1);
            best[nr] = 0;
            let mut i = nr;
            while i > 0 {
                i -= 1;
                best[i] = 1 + best[i + 1];
                let mut j = i + TABLE_MIN - 1;
                while j < nr {
                    let d = dist(rs.get(i).lo, rs.get(j).hi);
                    if d >= TABLE_MAX {
                        break;
                    }
                    if dense(rs.get(i).first, rs.get(j).last, d) and (1 + best[j + 1] <= best[i]) {
                        best[i] = 1 + best[j + 1];
                        end[i] = j;
                    }
                    j += 1;
                }
            }
        } else {
            let mut i: usize = 0;
            while i < nr {
                let mut j = i;
                while (j + 1 < nr) and (dist(rs.get(i).lo, rs.get(j + 1).hi) < TABLE_MAX) and
                      dense(rs.get(i).first, rs.get(j + 1).last, dist(rs.get(i).lo, rs.get(j + 1).hi)) {
                    j += 1;
                }
                if j + 1 - i >= TABLE_MIN {
                    end[i] = j;
                }
                i = j + 1;
            }
        }
    }
    let mut cl = u.List.[Cl].empty();
    let mut i: usize = 0;
    while i < nr {
        let j = end[i];
        if j + 1 - i >= TABLE_MIN {
            cl.push(Cl.{ kind: K_TABLE, lo: rs.get(i).lo, hi: rs.get(j).hi, b: ir.bnil(), first: rs.get(i).first,
                         last: rs.get(j).last });
            i = j + 1;
            continue;
        }
        // bit tests, among the ranges up to the next table
        let mut stop = i + 1;
        while (stop < nr) and (end[stop] + 1 - stop < TABLE_MIN) {
            stop += 1;
        }
        let mut p = i;
        while p < stop {
            let q = bit_run(rs.items(), p, stop);
            if q > p {
                cl.push(Cl.{ kind: K_BITS, lo: rs.get(p).lo, hi: rs.get(q).hi, b: ir.bnil(), first: rs.get(p).first,
                             last: rs.get(q).last });
                p = q + 1;
            } else {
                cl.push(rs.get(p));
                p += 1;
            }
        }
        i = stop;
    }
    rs.deinit();
    return cl;
}

// Are the values of the cases CS[first..last], spanning d + 1, dense
// enough for a jump table: at least 40% of the span, or 60% for fewer than
// 8 values (where a few compares cost about what the table's lookup does)?
fn dense(first: usize, last: usize, d: u64) bool {
    let n = @as(u64, last - first);
    if n < 8 {
        return n * 10 >= (d + 1) * 6;
    }
    return n * 10 >= (d + 1) * 4;
}

// The last range of a bit test starting at range p (before `stop`), or p
// if none is worth it.
fn bit_run(rs: []Cl, p: usize, stop: usize) usize {
    let mut tg: [3]*mut ir.Block = [ir.bnil(), ir.bnil(), ir.bnil()];
    let mut nt: usize = 0;
    let mut ncmp: usize = 0;
    let mut best = p;
    let mut q = p;
    while (q < stop) and (dist(rs[p].lo, rs[q].hi) < WORD) {
        let mut known = false;
        for k in 0..nt {
            if tg[k] == rs[q].b {
                known = true;
            }
        }
        if not known {
            if nt == 3 {
                break;
            }
            tg[nt] = rs[q].b;
            nt += 1;
        }
        ncmp += 2;
        if rs[q].lo == rs[q].hi {
            ncmp -= 1;
        }
        if ((nt == 1) and (ncmp >= 3)) or ((nt == 2) and (ncmp >= 5)) or ((nt == 3) and (ncmp >= 6)) {
            best = q;
        }
        q += 1;
    }
    return best;
}

// The search over the clusters cl from block b, the value known to be in
// lo..hi.
fn tree(b: *mut ir.Block, cl: []Cl, lo: i64, hi: i64) void {
    if cl.len <= LEAF {
        leaf(b, cl, lo, hi);
        return;
    }
    let mid = cl.len / 2;
    let pivot = cl[mid].lo;
    let lb = new_block();
    let rb = new_block();
    ir.at_end(BD, b);
    let c = ir.icmp(BD, ir.IntSLT, X, ir.cint(X.ty, @bit_cast(u64, pivot)));
    ir.condbr(BD, c, lb, rb);
    tree(lb, cl[0..mid], lo, pivot -% 1);
    tree(rb, cl[mid..cl.len], pivot, hi);
}

fn single(c: Cl) bool {
    return (c.kind == K_RANGE) and (c.lo == c.hi);
}

// The tests of clusters cl in turn, from block b (the value in lo..hi).
fn leaf(b: *mut ir.Block, cl: []Cl, lo0: i64, hi0: i64) void {
    let mut lo = lo0;
    let mut hi = hi0;
    let mut all_single = cl.len >= 2;
    for c in cl {
        if not single(c) {
            all_single = false;
        }
    }
    if all_single and ((cl[0].lo > lo) or (cl[cl.len - 1].hi < hi)) {
        // a chain of compares (a small switch)
        ir.at_end(BD, b);
        let sw = ir.switch_(BD, X, DFLT);
        for c in cl {
            ir.add_case(sw, ir.cint(X.ty, @bit_cast(u64, c.lo)), c.b);
        }
        return;
    }
    let mut cur = b;
    for k in 0..cl.len {
        let mut els = DFLT;
        if k + 1 < cl.len {
            els = new_block();
        }
        test_one(cur, cl[k], lo, hi, els);
        // (failed: not in cl[k], which may narrow the interval)
        if cl[k].lo <= lo {
            lo = cl[k].hi +% 1;
        }
        cur = els;
    }
}

// Block b tests cluster c (the value in lo..hi) and goes on to els if the
// value is not in it.
fn test_one(b: *mut ir.Block, c: Cl, lo: i64, hi: i64, els: *mut ir.Block) void {
    ir.at_end(BD, b);
    let ty = X.ty;
    let inside = (c.lo <= lo) and (c.hi >= hi);  // (the value is in c's span)
    if c.kind == K_RANGE {
        if inside {
            ir.br(BD, c.b);
        } else if c.lo == c.hi {
            ir.condbr(BD, ir.icmp(BD, ir.IntEQ, X, ir.cint(ty, @bit_cast(u64, c.lo))), c.b, els);
        } else if c.lo <= lo {
            ir.condbr(BD, ir.icmp(BD, ir.IntSLE, X, ir.cint(ty, @bit_cast(u64, c.hi))), c.b, els);
        } else if c.hi >= hi {
            ir.condbr(BD, ir.icmp(BD, ir.IntSGE, X, ir.cint(ty, @bit_cast(u64, c.lo))), c.b, els);
        } else {
            let d = ir.binop(BD, ir.OP_SUB, X, ir.cint(ty, @bit_cast(u64, c.lo)));
            ir.condbr(BD, ir.icmp(BD, ir.IntULE, d, ir.cint(ty, dist(c.lo, c.hi))), c.b, els);
        }
        return;
    }
    if c.kind == K_TABLE {
        let d = dist(c.lo, c.hi);
        let mut idx = X;
        if c.lo != 0 {
            idx = ir.binop(BD, ir.OP_SUB, X, ir.cint(ty, @bit_cast(u64, c.lo)));
        }
        let mut tb = b;
        if not inside {
            tb = new_block();
            ir.condbr(BD, ir.icmp(BD, ir.IntULE, idx, ir.cint(ty, d)), tb, els);
            ir.at_end(BD, tb);
        }
        // a case for each value of the span (the holes: the default)
        let sw = ir.switch_(BD, idx, CS.get(c.first).b);
        sw.cv = ir.SW_TABLE;
        let mut k = c.first;
        for j in @as(u64, 0)..(d + 1) {
            let v = c.lo +% @bit_cast(i64, j);
            let mut s = DFLT;
            if (k < c.last) and (CS.get(k).v == v) {
                s = CS.get(k).b;
                k += 1;
            }
            ir.add_case(sw, ir.cint(ty, j), s);
        }
        return;
    }
    // a bit test: base 0 when the cases are within the first word (the
    // values below c.lo are no other cluster's: those before were tested
    // already, those after are above)
    let mut base = c.lo;
    if (c.lo >= 0) and (c.hi < @bit_cast(i64, WORD)) {
        base = 0;
    }
    let mut idx = X;
    if base != 0 {
        idx = ir.binop(BD, ir.OP_SUB, X, ir.cint(ty, @bit_cast(u64, base)));
    }
    let mut tb = b;
    if not ((base <= lo) and (c.hi >= hi)) {
        tb = new_block();
        ir.condbr(BD, ir.icmp(BD, ir.IntULE, idx, ir.cint(ty, dist(base, c.hi))), tb, els);
        ir.at_end(BD, tb);
    }
    let i64t = ir.t_int(64);
    let mut wide = idx;
    if ty.bits < 64 {
        wide = ir.zext(BD, idx, i64t);
    }
    let bit = ir.binop(BD, ir.OP_SHL, ir.cint(i64t, 1), wide);
    // the targets and their masks, the most cases first
    let mut tg: [3]*mut ir.Block = [ir.bnil(), ir.bnil(), ir.bnil()];
    let mut mk: [3]u64 = [0, 0, 0];
    let mut cnt: [3]u32 = [0, 0, 0];
    let mut nt: usize = 0;
    for k in c.first..c.last {
        let mut at = nt;
        for j in 0..nt {
            if tg[j] == CS.get(k).b {
                at = j;
            }
        }
        if at == nt {
            tg[nt] = CS.get(k).b;
            nt += 1;
        }
        mk[at] = mk[at] | (@as(u64, 1) << @truncate(u32, dist(base, CS.get(k).v)));
        cnt[at] += 1;
    }
    for i in 0..nt {
        for j in (i + 1)..nt {
            if cnt[j] > cnt[i] {
                let a = tg[i];
                tg[i] = tg[j];
                tg[j] = a;
                let x = mk[i];
                mk[i] = mk[j];
                mk[j] = x;
                let y = cnt[i];
                cnt[i] = cnt[j];
                cnt[j] = y;
            }
        }
    }
    let mut cur = tb;
    for j in 0..nt {
        let mut next = DFLT;
        if j + 1 < nt {
            next = new_block();
        }
        ir.at_end(BD, cur);
        let hit = ir.binop(BD, ir.OP_AND, bit, ir.cint(i64t, mk[j]));
        ir.condbr(BD, ir.icmp(BD, ir.IntNE, hit, ir.cint(i64t, 0)), tg[j], next);
        cur = next;
    }
}

// -----------------------------------------------------------------------------
// Switches of constants as lookup tables
// -----------------------------------------------------------------------------
// A switch whose cases and default each only give a constant, either
//
//     case blocks that are `ret c` (the default too), or
//     case blocks that are `br J` (or J itself) and J's phis take constants
//     from them (the default's edge too),
//
// is a load from a table of the constants (one per phi) indexed by x - lo
// (the default's constant where no case is, and out of the span; the cases
// read as signed or as unsigned values, whichever spans fewer: an i8 switch
// over 0..254 spans 255 unsigned, 256 signed): no
// branches, which beat compares and jump tables alike when the value is
// not predictable. A read-only global holds each table; the index is
// clamped into it (a select) before the load, which is then always in
// bounds, and a select gives the default outside (none where the span is
// every value of the type: x - lo <u 2^bits would wrap). Taken for 3 cases or
// more spanning at most 1024 values, at least a third of them cases, of
// integer constants of at most 64 bits.
// -----------------------------------------------------------------------------
const LT_MIN: usize = 3;
const LT_SPAN: i64 = 1024;
threadlocal let mut lt_count: i32 = 0;

// The constant block b gives (its value when it is `ret c`), or nil.
fn ret_const(b: *mut ir.Block) *mut ir.Value {
    let i = b.first;
    if u.isnil(i) or (i.op != ir.OP_RET) or u.isnil(i.a) or (i.xs.len != 0) or not ir.is_small_cint(i.a) {
        return ir.vnil();
    }
    return i.a;
}

// Does b only jump to j?
fn only_br(b: *mut ir.Block, j: *mut ir.Block) bool {
    let i = b.first;
    return u.notnil(i) and (i.op == ir.OP_BR) and (i.t1 == j);
}

/// The switches of f that give constants as table lookups (above); m gets
/// the tables. True if any was.
pub fn lookup_tables(m: *mut ir.Module, f: *mut ir.Func) bool {
    let mut any = false;
    let mut b = f.first;
    while u.notnil(b) {
        let t = ir.terminator(b);
        if u.notnil(t) and (t.op == ir.OP_SWITCH) and (t.cv != ir.SW_TABLE) and (t.a.ty.kind == ir.T_INT) and
           (t.a.ty.bits >= 8) and (t.a.ty.bits <= 64) and not ir.is_const(t.a) and (t.xs.len >= LT_MIN) and
           (f.ret_ext < ir.EXT_REGS) and not f.sret {
            if table_one(m, f, b, t) {
                any = true;
            }
        }
        b = b.next;
    }
    if any {
        ir.remove_unreachable(f);
    }
    return any;
}

// Case k's value, read as unsigned (below 64 bits) when uns.
fn case_val(t: *ir.Value, k: usize, uns: bool) i64 {
    let v = ir.sval(t.xs.get(k));
    if uns and (t.a.ty.bits < 64) {
        return v & @bit_cast(i64, (@as(u64, 1) << @int_cast(u32, t.a.ty.bits)) - 1);
    }
    return v;
}

fn table_one(m: *mut ir.Module, f: *mut ir.Func, b: *mut ir.Block, t: *mut ir.Value) bool {
    let n = t.xs.len;
    let mut dflt = t.t1;
    // a default the switch never goes to (dead_default): no range check,
    // and the default's values are the first case's (never read)
    let mut klo: i64 = 0 - 0x7fff_ffff_ffff_ffff - 1;
    let mut khi: i64 = 0x7fff_ffff_ffff_ffff;
    let dead = (n > 0) and dead_default(f, b, t, &mut klo, &mut khi);
    if dead {
        dflt = ir.bs_of(t).get(0);
    }
    // the span: of the values read as signed, or as unsigned where that is
    // shorter (both below 2^63 for less than 64 bits; 64 bits are signed)
    let mut lo: i64 = 0x7fff_ffff_ffff_ffff;
    let mut hi: i64 = 0 - 0x7fff_ffff_ffff_ffff - 1;
    let mut ulo: i64 = 0x7fff_ffff_ffff_ffff;
    let mut uhi: i64 = 0 - 0x7fff_ffff_ffff_ffff - 1;
    for k in 0..n {
        lo = @min(lo, case_val(t, k, false));
        hi = @max(hi, case_val(t, k, false));
        ulo = @min(ulo, case_val(t, k, true));
        uhi = @max(uhi, case_val(t, k, true));
    }
    let uns = (t.a.ty.bits < 64) and ((uhi - ulo) < (hi - lo));
    if uns {
        lo = ulo;
        hi = uhi;
    }
    if ((hi - lo) >= LT_SPAN) or ((hi - lo) < 0) or ((((hi - lo) + 1) / 3) > @int_cast(i64, n)) {
        return false;
    }
    let span = @bit_cast(u64, (hi - lo) + 1);
    // the form: returns of constants, or jumps to one block J
    let mut j = ir.bnil();
    let dc = ret_const(dflt);
    let mut rets = u.notnil(dc);
    if rets {
        for k in 0..n {
            if u.isnil(ret_const(ir.bs_of(t).get(k))) or (ret_const(ir.bs_of(t).get(k)).ty != dc.ty) {
                rets = false;
            }
        }
    }
    if not rets {
        // J: the default's target (dflt itself, or the block dflt only jumps to)
        j = dflt;
        if only_br(dflt, ir.terminator(dflt).t1) and (dflt.first == ir.terminator(dflt)) {
            j = ir.terminator(dflt).t1;
        }
        if u.isnil(j.first) or (j.first.op != ir.OP_PHI) {
            return false;
        }
        for k in 0..n {
            let cb = ir.bs_of(t).get(k);
            if (cb != j) and not only_br(cb, j) {
                return false;
            }
        }
        // every phi of J: an integer constant from each way in from the switch
        let mut p = j.first;
        while u.notnil(p) and (p.op == ir.OP_PHI) {
            if (p.ty.kind != ir.T_INT) or (p.ty.bits > 64) {
                return false;
            }
            for k in 0..n {
                let cb = ir.bs_of(t).get(k);
                let mut from = cb;
                if cb == j {
                    from = b;
                }
                let x = ir.incoming(p, from);
                if u.isnil(x) or not ir.is_small_cint(x) {
                    return false;
                }
            }
            let mut from_d = dflt;
            if dflt == j {
                from_d = b;
            }
            let xd = ir.incoming(p, from_d);
            if u.isnil(xd) or not ir.is_small_cint(xd) {
                return false;
            }
            p = p.next;
        }
        // (a case to J directly, or the default: J's phis take b's input
        // for it, which given() reads)
    }
    // the tables and the lookup at the end of b
    let bld = ir.new_builder();
    ir.at_before(bld, t);
    let x = t.a;
    let isz = ir.isz();
    let idx = ir.sub(bld, x, ir.cint(x.ty, @bit_cast(u64, lo)));
    let mut wide = idx;
    if x.ty.bits < isz.bits {
        wide = ir.cast(bld, ir.OP_ZEXT, idx, isz);
    } else if x.ty.bits > isz.bits {
        wide = ir.trunc(bld, idx, isz);
    }
    let mut inr = ir.cint(ir.t_int(1), 1);
    if not dead and ((x.ty.bits >= 64) or (span < (@as(u64, 1) << @int_cast(u32, x.ty.bits)))) {
        inr = ir.icmp(bld, ir.IntULT, idx, ir.cint(x.ty, span));
    }
    let at = ir.select(bld, inr, wide, ir.cint(isz, 0));
    if rets {
        let v = lookup(m, bld, t, dflt, at, inr, lo, uns, span, dc.ty, ir.vnil(), ir.bnil(), b);
        ir.remove_inst(t);
        ir.at_end(bld, b);
        ir.ret(bld, v);
        return true;
    }
    let mut vals = u.List.[*mut ir.Value].empty();
    let mut p = j.first;
    while u.notnil(p) and (p.op == ir.OP_PHI) {
        vals.push(lookup(m, bld, t, dflt, at, inr, lo, uns, span, p.ty, p, j, b));
        p = p.next;
    }
    ir.remove_inst(t);
    ir.at_end(bld, b);
    ir.br(bld, j);
    // J's phis: b's input is the lookup (the case blocks no longer come from b)
    let mut q = j.first;
    let mut k: usize = 0;
    while u.notnil(q) and (q.op == ir.OP_PHI) {
        let mut found = false;
        for e in 0..ir.bs_of(q).len {
            if ir.bs_of(q).get(e) == b {
                ir.set_x(q, e, vals.get(k));
                found = true;
            }
        }
        if not found {
            ir.add_incoming(q, vals.get(k), b);
        }
        k += 1;
        q = q.next;
    }
    vals.deinit();
    return true;
}

// The value of the table of the constants a switch gives (returns, or phi
// p's inputs at J), looked up at `at` (in the span when inr), the default's
// outside: made by bld before the switch.
fn lookup(m: *mut ir.Module, bld: *mut ir.Builder, t: *mut ir.Value, dflt: *mut ir.Block, at: *mut ir.Value,
          inr: *mut ir.Value, lo: i64, uns: bool, span: u64, et: *mut ir.Ty, p: *mut ir.Value, j: *mut ir.Block,
          b: *mut ir.Block) *mut ir.Value {
    let d = given(t, dflt, p, j, b);
    let xs = u.newn.[*mut ir.Value](@truncate(usize, span) + 1);
    for k in @as(u64, 0)..span {
        xs[@truncate(usize, k)] = d;
    }
    // (the first of repeated values counts, as the switch tests them)
    let n = t.xs.len;
    let mut k = n;
    while k > 0 {
        k -= 1;
        let off = @bit_cast(u64, case_val(t, k, uns) - lo);
        xs[@truncate(usize, off)] = given(t, ir.bs_of(t).get(k), p, j, b);
    }
    let at_ty = ir.t_array(et, span);
    lt_count += 1;
    let g = ir.add_global(m, at_ty, u.f1("switch.table.%s", u.idec(lt_count)));
    g.init = ir.carray(et, xs[0..@truncate(usize, span)]);
    g.is_const = true;
    g.linkage = ir.LINK_INTERNAL;
    let v = ir.load(bld, et, ir.ptradd(bld, g.val, ir.mul(bld, at, ir.cint(ir.isz(), et.size))));
    v.align = @truncate(u32, et.size);
    return ir.select(bld, inr, v, d);
}

// The constant the switch gives going to block cb (a return's, or phi p's
// input on the way to J).
fn given(t: *ir.Value, cb: *mut ir.Block, p: *mut ir.Value, j: *mut ir.Block, b: *mut ir.Block) *mut ir.Value {
    _ = t;
    if u.isnil(p) {
        return ret_const(cb);
    }
    if cb == j {
        return ir.incoming(p, b);
    }
    return ir.incoming(p, cb);
}
