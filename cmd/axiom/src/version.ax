// =============================================================================
// version.ax - the compiler's version (docs/releasing.md). The bootstrap
// compiler's AXIOM_VERSION (bootstrap/src/version.h) is the same.
// =============================================================================
import "util.ax" as u;

pub let VERSION: []u8 = "0.3.0";

// The numbers of a version "a", "a.b" or "a.b.c" (missing ones are 0), or
// false if it is not one.
pub fn parse(v: []u8, out: *mut [3]u32) bool {
    let mut part: usize = 0;
    let mut digits: usize = 0;
    out.* = [0; 3];
    for c in v {
        if c == '.' {
            if (digits == 0) or (part == 2) {
                return false;
            }
            part += 1;
            digits = 0;
        } else if (c >= '0') and (c <= '9') and (digits < 6) {
            out.*[part] = (out.*[part] * 10) + @as(u32, c - '0');
            digits += 1;
        } else {
            return false;
        }
    }
    return digits > 0;
}

// Whether this compiler is at least version `need` (which parse accepts).
pub fn at_least(need: [3]u32) bool {
    let mut have: [3]u32 = [0; 3];
    _ = parse(VERSION, &mut have);
    for i in @as(usize, 0)..3 {
        if have[i] != need[i] {
            return have[i] > need[i];
        }
    }
    return true;
}

// "a.b" of this compiler's version, for new packages' manifests.
pub fn minor() []u8 {
    let mut have: [3]u32 = [0; 3];
    _ = parse(VERSION, &mut have);
    return u.f2("%s.%s", u.udec(@as(u64, have[0])), u.udec(@as(u64, have[1])));
}

test "versions" {
    let mut v: [3]u32 = [0; 3];
    @expect(parse("0.2", &mut v) and (v[0] == 0) and (v[1] == 2) and (v[2] == 0));
    @expect(parse("1.10.3", &mut v) and (v[1] == 10) and (v[2] == 3));
    @expect(not parse("", &mut v) and not parse("1.", &mut v) and not parse("1.2.3.4", &mut v) and
            not parse("v1", &mut v) and not parse(".1", &mut v));
    @expect(at_least([0, 0, 0]) and at_least([0, 1, 0]) and not at_least([999, 0, 0]));
}
