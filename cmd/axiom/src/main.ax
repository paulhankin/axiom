// =============================================================================
// main.ax - command-line driver.
//
//   axiom build <file.ax> [options] -o <out>
//   axiom check <file.ax> [options]
//   axiom build|check <file.c>... [options]   a C program (c/cc.ax; docs/c-frontend.md)
//   axiom build|check <file.ax> <file.c>...    an Axiom program with C units
//   axiom build|check <file.c>... <file.ax>... a C program with Axiom modules
//   axiom lsp [options]          language server for editors (lsp.ax)
//   axiom ide <file.ax> --query=<q> [options]   one question from it (ide.ax)
//
// Options:
//   --target=wasm32|wasm64|x86_64|aarch64|aarch64-macos|x86_64-windows|native   (default wasm32)
//   --cpu=<name>               processor preset (e.g. x86-64-v3, armv8.1-a, native, mvp)
//   --features=+a,-b           enable / disable processor extensions
//   -O0 -O1 -O2 -O3            optimization level (never changes behavior)
//   --overflow=wrap|trap|saturate   integer overflow mode (default wrap)
//   --release                  accepted for compatibility; changes nothing
//   --emit=exe|obj|ir          output kind (default: exe = .wasm module / native executable)
//   --format=human|agent-json  diagnostic format
//   --std=<dir>                standard library directory
//   --link=<file>              extra C source, object or library to link, or Axiom
//                              source (.ax) to build into the program (repeatable)
//   -l<lib> -L<dir> -I<dir>    C libraries, library and include directories
//   --emit-header=<path>       write a C header for the exported functions
//   --subsystem=console|windows  x86_64-windows: console program (default) or
//                              GUI program with no console window
//   --icon=<file.ico>          x86_64-windows: the program's icon (in its resources)
//   -o <path>                  output path
//
// C sources (c_option, c_options, build_c):
//   --c-std=c89|c90|c95|c99|c11|c17|c18|c23|gnu89|gnu90|gnu99|gnu11|gnu17|gnu18|gnu23   (default c17)
//   --c-char=signed|unsigned  --c-int=16|32|64  --c-long=32|64   (default: the target's C ABI)
//   --c-long-double=64|80|128  long double's format (default: the target's C ABI)
//   -DNAME[=value]  -UNAME  -I<dir> (also -D NAME, -U NAME, -I <dir>)
//   --emit=c-pp|c-tokens|c-ast   preprocessed text, tokens, syntax tree
// =============================================================================
import "ast.ax" as ast;
import "backend.ax" as be;
import "c/cc.ax" as cfront;
import "c/copts.ax" as cop;
import "codegen.ax" as cg;
import "diag.ax" as dg;
import "elf.ax" as elf;
import "elink.ax" as el;
import "fmt.ax" as fmt;
import "header.ax" as header;
import "ide.ax" as ide;
import "lsp.ax" as lsp;
import "lstub.ax" as lstub;
import "mlink.ax" as ml;
import "package.ax" as pkg;
import "plink.ax" as pl;
import "profiler.ax" as profiler;
import "sema.ax" as sema;
import "target.ax" as tg;
import "tester.ax" as tester;
import "types.ax" as ty;
import "units.ax" as units;
import "update.ax" as update;
import "util.ax" as u;
import "version.ax" as ver;
import "wlink.ax" as wl;
import "wobj.ax" as wo;

fn usage() void {
    u.eprint("usage: axiom <build|check|test> [<file.ax> | <package dir>] [options]\n");
    u.eprint("       axiom <build|check> <file.c>... [options]   a C program (its translation units)\n");
    u.eprint("       axiom <build|check> <file.ax> <file.c>...   an Axiom program and C units, one program\n");
    u.eprint("       axiom <build|check> <file.c>... <file.ax>...   a C program and Axiom modules, one program\n");
    u.eprint("       axiom profile [<file.ax> | <package dir>] [--rate=<hz>] [--folded=<path>] [-- <program args>]\n");
    u.eprint("       axiom fmt <file.ax | dir>... [--check] [--stdout]   canonical layout, tidy imports\n");
    u.eprint("       axiom new <name>      create a package skeleton\n");
    u.eprint("       axiom lsp [--target=<t>] [--std=<dir>]   language server (stdio) for editors\n");
    u.eprint("       axiom cache [path|size|clean]  the compiled-module cache\n");
    u.eprint("       axiom version         the compiler's version\n");
    u.eprint("       axiom update [<version> | latest | head]   replace this toolchain with another version\n");
    u.eprint("  test: --filter=<text> --timeout=<ms> --show-output\n");
    u.eprint("  --target=wasm32|wasm64|x86_64|aarch64|aarch64-macos|x86_64-windows|native   --cpu=<name>   --features=+ext,-ext\n");
    u.eprint("  -O0..-O3   --overflow=wrap|trap|saturate (default wrap)\n");
    u.eprint("  --emit=exe|obj|ir  --format=human|agent-json  --std=<dir>  -o <out>\n");
    u.eprint("  --stack-traces=on|off    record call sites for crash traces and profiles (default on)\n");
    u.eprint("  --sanitize=address|none  check heap accesses: use after free, overflows, double frees, leaks\n");
    u.eprint("  --coverage=afl|none      Linux: edge coverage for a coverage-guided fuzzer (default none)\n");
    u.eprint("  -g, --debug-info=full|lines|none   DWARF debug information (-g: full; default none)\n");
    u.eprint("  --subsystem=console|windows  x86_64-windows: a console program (default) or a GUI one\n");
    u.eprint("  --pdb=on|off             x86_64-windows: debug symbols in <out>.pdb (default on)\n");
    u.eprint("  --icon=<file.ico>        x86_64-windows: the program's icon, shown by Explorer and the taskbar\n");
    u.eprint("  --units=module|program   compile modules separately (cached) or as one unit\n");
    u.eprint("                           (default: module at -O0/-O1, program at -O2/-O3)  --verbose\n");
    u.eprint("  C sources:\n");
    u.eprint("  --c-std=c89|c90|c95|c99|c11|c17|c18|c23   the standard (default c17); gnu89 ... gnu23: with GNU extensions\n");
    u.eprint("  --c-char=signed|unsigned  --c-int=16|32|64  --c-long=32|64   (default: the target's C ABI)\n");
    u.eprint("  --c-long-double=64|80|128   long double's format (default: the target's C ABI)\n");
    u.eprint("  -DNAME[=value]  -UNAME  -I<dir>   macros and include directories, in order\n");
    u.eprint("  --emit=c-pp|c-tokens|c-ast   the preprocessed text, the tokens or the syntax tree\n");
    u.eprint("  --emit=obj|ir without a main: the units' code alone, to link into another program\n");
}

fn find_std(argv0: []u8) []u8 {
    let e = u.env("AXIOM_STD");
    if not u.isnos(e) and (e.len > 0) {
        return e;
    }
    let mut exe = u.self_path();
    if u.isnos(exe) {
        return "std";
    }
    let slash = u.rfind(exe, '/');
    if slash >= 0 {
        exe = u.dup(exe[0..@int_cast(usize, slash)]);
    }
    let cands = ["/../../std", "/../std", "/std", "/../share/axiom/std", "/../../../std", "/../../../../std"];
    for c in cands {
        if u.file_exists(u.f2("%s%s/mem.ax", exe, c)) {
            let p = u.cat2(exe, c);
            let r = u.real_path(p);
            if u.isnos(r) {
                return p;
            }
            return r;
        }
    }
    return "std";
}

// ---------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------
fn strip_ph(base: []u8) []u8 {
    if (base.len > 3) and u.ends(base, ".ax") {
        return base[0..base.len - 3];
    }
    if (base.len > 2) and u.ends(base, ".c") {
        return base[0..base.len - 2];
    }
    return base;
}

fn now_ms() f64 {
    return @float_from_int(f64, u.now_ns()) / 1000000.0;
}

// Links our wasm objects into a module (no external tools).
fn link_native(objpath: []u8, unit_objs: [][]u8, out: []u8) i32 {
    let mut os = u.List.[*mut elf.Obj].empty();
    let mut paths = u.List.[[]u8].empty();
    paths.push(objpath);
    for p in unit_objs {
        paths.push(p);
    }
    for k in 0..paths.len {
        let d = u.read_file_heap(paths.get(k));
        let mut o = u.nil.[elf.Obj]();
        if not u.isnos(d) {
            o = elf.read(d);
            u.free_heap(d);
        }
        if u.isnil(o) {
            u.eprint(u.f1("axiom: cannot read object %s\n", paths.get(k)));
            return 1;
        }
        os.push(o);
    }
    if tg.is_darwin() {
        return ml.link(os.items(), out);
    }
    if tg.is_windows() {
        return pl.link(os.items(), out);
    }
    let mut machine = elf.EM_X86_64;
    if tg.g_arch == tg.ARCH_A64 {
        machine = elf.EM_AARCH64;
    }
    return el.link(os.items(), machine, cg.g_link_libs.items(), out);
}

fn link_wasm(objpath: []u8, unit_objs: [][]u8, out: []u8) i32 {
    let mut us = u.List.[*mut wo.Unit].empty();
    let mut paths = u.List.[[]u8].empty();
    paths.push(objpath);
    for p in unit_objs {
        paths.push(p);
    }
    for k in 0..paths.len {
        if (k == 0) and u.notnil(be.g_kept_unit) {
            us.push(be.g_kept_unit);  // (compiled in this process, never written)
            continue;
        }
        let d = u.read_file_heap(paths.get(k));
        let un = wo.read_object(d);
        if not u.isnos(d) {
            u.free_heap(d);
        }
        if u.isnos(d) or u.isnil(un) {
            u.eprint(u.f1("axiom: cannot read object %s\n", paths.get(k)));
            return 1;
        }
        us.push(un);
    }
    let o = wl.Options.{ stack_size: 1048576, shared_memory: cg.g_threads, max_pages: 16384,
                         exports: cg.g_export_names.items() };
    let bytes = wl.link(us.items(), &o);
    if u.isnos(bytes) {
        return 1;
    }
    if not u.write_file(out, bytes) {
        u.eprint(u.f1("axiom: cannot write %s\n", out));
        return 1;
    }
    return 0;
}

// A size for people: "1.5 MiB".
fn human_size(n: i64) []u8 {
    if n < 1024 {
        return u.f1("%s B", u.dec(n));
    }
    let units_ = ["KiB", "MiB", "GiB", "TiB"];
    let mut v = @float_from_int(f64, n) / 1024.0;
    let mut i: usize = 0;
    while (v >= 1024.0) and (i + 1 < units_.len) {
        v /= 1024.0;
        i += 1;
    }
    return u.f2("%s %s", u.ffmt("%.1f", v), units_[i]);
}

// axiom cache [path|size|clean]: the object cache of separate compilation.
fn run_cache(args: [][]u8) i32 {
    let dir = u.cat2(pkg.cache_dir(), "/obj");
    if (args.len >= 1) and u.str_eq(args[0], "clean") {
        let rm = ["rm", "-rf", dir];
        if u.run_status(rm[..], u.OUT_INHERIT) == 0 {
            u.print(u.f1("removed %s\n", dir));
            return 0;
        }
        return 1;
    }
    if (args.len >= 1) and u.str_eq(args[0], "size") {
        let mut es = u.List.[units.CacheEntry].empty();
        let total = units.cache_entries(dir, &mut es);
        let limit = units.cache_limit();
        let mut lim: []u8 = "no limit";
        if limit > 0 {
            lim = u.cat2("limit ", human_size(limit));
        }
        u.print(u.f4("%s: %s objects, %s (%s)\n", dir, u.zdec(es.len), human_size(total), lim));
        return 0;
    }
    if (args.len >= 1) and not u.str_eq(args[0], "path") {
        usage();
        return 2;
    }
    u.print(u.cat2(dir, "\n"));
    return 0;
}

// axiom new <name> [--format=agent-json]
fn run_new(args: [][]u8) i32 {
    if args.len < 1 {
        usage();
        return 2;
    }
    let js = (args.len >= 2) and u.str_eq(args[1], "--format=agent-json");
    if pkg.new_package(args[0], js) {
        return 0;
    }
    return 1;
}

// The command line of build, check, test, profile and ide.
struct Options {
    cmd: []u8,
    testing: bool,
    profiling: bool,
    build: bool,  // build, test or profile
    ide_mode: bool,
    input: []u8,
    out: []u8,
    run_dir: []u8,  // axiom test and profile: a private directory for the program
    std_dir: []u8,
    target: []u8,
    emit: []u8,
    json: bool,
    co: *mut cg.CgOptions,
    link_inputs: u.List.[[]u8],
    ax_links: u.List.[[]u8],  // --link=<file.ax>
    feature_args: u.List.[[]u8],
    link_flags: u.List.[[]u8],  // -l / -L
    inc_flags: u.List.[[]u8],   // -I, for C sources
    c_args: u.List.[[]u8],      // the C front end's options (c_option)
    c_inputs: u.List.[[]u8],    // the C sources after the first (input)
    c_freestanding: bool,       // --c-freestanding: no C library (c_library)
    header_path: []u8,
    test_filter: []u8,
    test_timeout: []u8,
    show_output: bool,
    prof_hz: i32,
    units_mode: i32,  // -1: by optimization level
    verbose: bool,
    folded_path: []u8,
    prog_args: u.List.[[]u8],  // profile: after `--`
}

fn new_options(cmd: []u8) Options {
    let testing = u.str_eq(cmd, "test");
    let profiling = u.str_eq(cmd, "profile");
    let co = u.new.[cg.CgOptions]();
    co.stack_traces = true;
    co.cpu = u.nosym();
    let build = u.str_eq(cmd, "build") or testing or profiling;
    return Options.{ cmd: cmd, testing: testing, profiling: profiling, build: build, ide_mode: u.str_eq(cmd, "ide"),
                     input: u.nosym(), out: u.nosym(), run_dir: u.nosym(), std_dir: u.nosym(), target: "wasm32",
                     emit: "exe", json: false, co: co, link_inputs: u.List.[[]u8].empty(),
                     ax_links: u.List.[[]u8].empty(), feature_args: u.List.[[]u8].empty(),
                     link_flags: u.List.[[]u8].empty(), inc_flags: u.List.[[]u8].empty(), c_args: u.List.[[]u8].empty(),
                     c_inputs: u.List.[[]u8].empty(), c_freestanding: false, header_path: u.nosym(),
                     test_filter: u.nosym(), test_timeout: u.nosym(), show_output: false, prof_hz: 999, units_mode: -1,
                     verbose: false, folded_path: u.nosym(), prog_args: u.List.[[]u8].empty() };
}

// An object of C code alone (build_c): no runtime, so no system call stubs.
let mut g_c_object: bool = false;

// A step of the driver returns this to go on, or an exit status.
const CONTINUE: i32 = -1;

// Reports a fatal error; the exit status for it.
fn fatal(json: bool, code: []u8, msg: []u8) i32 {
    dg.emit_fatal(json, code, msg);
    return 2;
}

// The C front end's options (docs/c.md): the standard, the choices the
// implementation makes, and macros. True if `a` is one (kept in o.c_args, for
// c_options to read once the target is known).
fn c_option(o: *mut Options, a: []u8) bool {
    if u.str_eq(a, "--c-freestanding") {
        o.c_args.push(a);
        o.c_freestanding = true;  // (no C library: c_library)
        return true;
    }
    if u.starts(a, "--c-std=") or u.starts(a, "--c-char=") or u.starts(a, "--c-int=") or u.starts(a, "--c-long=") or
       u.str_eq(a, "--c-warn-unknown-pragmas") or u.starts(a, "--c-long-double=") or
       ((a.len > 2) and (a[0] == '-') and ((a[1] == 'D') or (a[1] == 'U'))) {
        o.c_args.push(a);
        return true;
    }
    return false;
}

// The C options for the target, with o.c_args applied; false on an error
// (reported).
fn c_options(o: *Options, c: *mut cop.COptions) bool {
    let win = tg.g_os == tg.OS_WINDOWS;
    c.std = cop.C17;
    // (the targets' C ABIs: plain char and wchar_t are unsigned on AArch64
    // Linux (AAPCS64; Apple's variant makes char signed and wchar_t int);
    // long is 32 bits on Windows and where pointers are; wchar_t is int, or
    // on Windows unsigned short)
    let a64_linux = (tg.g_arch == tg.ARCH_A64) and (tg.g_os == tg.OS_LINUX);
    c.char_signed = not a64_linux;
    c.int_bits = 32;
    c.ptr_bits = ty.g_target.ptr_bits;
    c.long_bits = 64;
    if win or (c.ptr_bits == 32) {
        c.long_bits = 32;
    }
    c.wchar_bits = 32;
    c.wchar_signed = not a64_linux;
    // (long double: the x87's 80-bit format on x86-64 Linux (System V),
    // binary128 on AArch64 Linux (AAPCS64) and WebAssembly; double on
    // Windows and macOS)
    let x64_linux = (tg.g_arch == tg.ARCH_X64) and (tg.g_os == tg.OS_LINUX) and not ty.g_target.is_wasm;
    c.ld_bits = 64;
    if x64_linux {
        c.ld_bits = 80;
    } else if a64_linux or ty.g_target.is_wasm {
        c.ld_bits = 128;
    }
    if win {
        c.wchar_bits = 16;
        c.wchar_signed = false;
    }
    let mut plat = cop.PLAT_LINUX;
    if tg.is_wasm() {
        plat = cop.PLAT_WASM;
    } else if win {
        plat = cop.PLAT_WINDOWS;
    } else if tg.is_darwin() {
        plat = cop.PLAT_DARWIN;
    }
    cop.set_platform(c, plat, tg.g_arch == tg.ARCH_A64);
    let mut defs = u.List.[cop.Define].empty();
    let mut dirs = u.List.[[]u8].empty();
    for k in 0..o.inc_flags.len {
        let d = o.inc_flags.get(k)[2..];
        if not u.is_dir(d) {
            let what = u.pick(u.file_exists(d), "is not a directory", "does not exist");
            dg.emit_fatal(o.json, "E9001", u.f2("the include directory '%s' (-I) %s", d, what));
            return false;
        }
        dirs.push(d);
    }
    for k in 0..o.c_args.len {
        let a = o.c_args.get(k);
        let mut ok = true;
        if u.str_eq(a, "--c-freestanding") {
            // (main.ax's: c_library)
        } else if u.starts(a, "--c-std=") {
            c.std = cop.std_named(a[8..]);
            c.gnu = cop.is_gnu(a[8..]);
            if c.std < 0 {
                dg.emit_fatal(o.json, "E9001",
                              u.f1("unknown C standard in '%s' (known: c89, c90, c95, c99, c11, c17, c18, c23, gnu89, gnu90, gnu99, gnu11, gnu17, gnu18, gnu23)",
                                   a));
                return false;
            }
        } else if u.str_eq(a, "--c-warn-unknown-pragmas") {
            c.warn_pragmas = true;
        } else if u.starts(a, "--c-char=") {
            c.char_signed = u.str_eq(a[9..], "signed");
            ok = c.char_signed or u.str_eq(a[9..], "unsigned");
        } else if u.starts(a, "--c-int=") {
            c.int_bits = @truncate(i32, u.atol(a[8..]));
            ok = (c.int_bits == 16) or (c.int_bits == 32) or (c.int_bits == 64);
        } else if u.starts(a, "--c-long=") {
            c.long_bits = @truncate(i32, u.atol(a[9..]));
            ok = (c.long_bits == 32) or (c.long_bits == 64);
        } else if u.starts(a, "--c-long-double=") {
            // 80 only where the ABI has the x87 (x86-64 System V); 128 where
            // an ABI says how binary128 travels (as __float128 on x86-64
            // System V; a quad-precision register on AArch64)
            c.ld_bits = @truncate(i32, u.atol(a[16..]));
            ok = (c.ld_bits == 64) or ((c.ld_bits == 80) and x64_linux) or
                 ((c.ld_bits == 128) and (x64_linux or a64_linux or ty.g_target.is_wasm));
            if not ok and ((c.ld_bits == 80) or (c.ld_bits == 128)) {
                dg.emit_fatal(o.json, "E9001", u.f2("--c-long-double=%s is not supported for --target=%s", a[16..],
                                                    o.target));
                return false;
            }
        } else if a[1] == 'U' {
            defs.push(cop.Define.{ name: a[2..], body: "", undef: true });
        } else {
            let eq = u.find(a, '=');
            if eq < 0 {
                defs.push(cop.Define.{ name: a[2..], body: "1", undef: false });
            } else {
                defs.push(cop.Define.{ name: a[2..@int_cast(usize, eq)], body: a[@int_cast(usize, eq) + 1..],
                                       undef: false });
            }
        }
        if not ok {
            dg.emit_fatal(o.json, "E9001", u.f1("bad value in '%s'", a));
            return false;
        }
    }
    if c.long_bits < c.int_bits {
        dg.emit_fatal(o.json, "E9001", "--c-long must be at least --c-int");
        return false;
    }
    c.defines = defs.items();
    c.include_dirs = dirs.items();
    c.sys_include = u.cat2(o.std_dir, "/c/include");
    c.hosted = not o.c_freestanding;
    return true;
}

// Is `path` a C source (its name ends in .c)?
fn is_c_source(path: []u8) bool {
    return (path.len > 2) and u.ends(path, ".c");
}

// Is `path` an Axiom source (its name ends in .ax)?
fn is_ax_source(path: []u8) bool {
    return (path.len > 3) and u.ends(path, ".ax");
}

// The options that are the Axiom compiler's and mean nothing for C sources
// (C code has no overflow modes, heap checks or coverage counters, and an
// Axiom header or source is of Axiom code): false after reporting one.
// Without C sources, the C front end's options are errors.
fn check_c_options(o: *Options) bool {
    let c_input = is_c_source(o.input) or (o.c_inputs.len > 0);
    if not c_input {
        if o.c_args.len > 0 {
            dg.emit_fatal(o.json, "E9001", u.f1("'%s' is an option for C sources, and the input is not one (*.c)",
                                                o.c_args.get(0)));
            return false;
        }
        return true;
    }
    // An Axiom program with C units (its root is the .ax input) takes the
    // options of Axiom code that change only its own code; a C program (the
    // first input is C) takes none of them.
    let ax_root = not is_c_source(o.input);
    let mut bad = u.nosym();
    if (o.co.overflow != cg.OVF_WRAP) and not ax_root {
        bad = "--overflow";  // (C's signed overflow is undefined; unsigned wraps)
    } else if o.co.sanitize_address {
        bad = "--sanitize=address";
    } else if o.co.coverage {
        bad = "--coverage=afl";
    } else if not u.isnos(o.header_path) and not ax_root {
        bad = "--emit-header";
    } else if (o.ax_links.len > 0) and ax_root {
        bad = "--link=<file.ax>";
    } else if o.units_mode >= 0 {
        bad = "--units";
    }
    if not u.isnos(bad) {
        dg.emit_fatal(o.json, "E9001", u.f1("%s is an option for Axiom code, and not for C sources", bad));
        return false;
    }
    if ax_root and (o.testing or o.profiling or o.ide_mode) {
        dg.emit_fatal(o.json, "E9001", u.f1("axiom %s does not take C sources", o.cmd));
        return false;
    }
    if ax_root and cfront.text_emit(o.emit) {
        dg.emit_fatal(o.json, "E9001", u.f1("--emit=%s takes one C source, and no Axiom source", o.emit));
        return false;
    }
    if cfront.text_emit(o.emit) and (o.c_inputs.len > 0) {
        dg.emit_fatal(o.json, "E9001", u.f1("--emit=%s takes one C source", o.emit));
        return false;
    }
    return true;
}

// Reads the options after the command into *o; false on an error (reported).
fn parse_options(o: *mut Options, args: [][]u8) bool {
    let co = o.co;
    let argc = args.len;
    let mut i: usize = 2;
    while i < argc {
        let a = args[i];
        if o.ide_mode and ide.option(a) {
            // axiom ide's own options
        } else if u.str_eq(a, "-o") and ((i + 1) < argc) {
            i += 1;
            o.out = args[i];
        } else if (u.str_eq(a, "-D") or u.str_eq(a, "-U") or u.str_eq(a, "-I")) and ((i + 1) < argc) {
            // (-D NAME, -U NAME, -I dir: as -DNAME, -UNAME, -Idir)
            i += 1;
            let joined = u.cat2(a, args[i]);
            if a[1] == 'I' {
                o.inc_flags.push(joined);
            } else {
                o.c_args.push(joined);
            }
        } else if u.str_eq(a, "-D") or u.str_eq(a, "-U") or u.str_eq(a, "-I") or u.str_eq(a, "-o") {
            dg.emit_fatal(o.json, "E9001", u.f1("'%s' needs a value (-DNAME[=value], -UNAME, -Idir, -o <path>)", a));
            return false;
        } else if u.starts(a, "--target=") {
            o.target = a[9..];
        } else if u.str_eq(a, "-O0") or u.str_eq(a, "-O1") or u.str_eq(a, "-O2") or u.str_eq(a, "-O3") {
            co.opt_level = @as(i32, a[2] - '0');
        } else if u.str_eq(a, "--release") {
            // once --overflow=saturate: no build mode changes semantics
        } else if u.str_eq(a, "--overflow=wrap") {
            co.overflow = cg.OVF_WRAP;
        } else if u.str_eq(a, "--overflow=trap") {
            co.overflow = cg.OVF_TRAP;
        } else if u.str_eq(a, "--overflow=saturate") {
            co.overflow = cg.OVF_SATURATE;
        } else if u.starts(a, "--emit=") {
            o.emit = a[7..];
        } else if u.str_eq(a, "--stack-traces=on") {
            co.stack_traces = true;
        } else if u.str_eq(a, "--stack-traces=off") {
            co.stack_traces = false;
        } else if u.str_eq(a, "-g") or u.str_eq(a, "--debug-info=full") {
            tg.g_debug = tg.DEBUG_FULL;
        } else if u.str_eq(a, "--debug-info=lines") {
            tg.g_debug = tg.DEBUG_LINES;
        } else if u.str_eq(a, "--debug-info=none") {
            tg.g_debug = tg.DEBUG_NONE;
        } else if u.str_eq(a, "--sanitize=address") {
            co.sanitize_address = true;
        } else if u.str_eq(a, "--sanitize=none") {
            co.sanitize_address = false;
        } else if u.str_eq(a, "--coverage=afl") {
            co.coverage = true;
        } else if u.str_eq(a, "--coverage=none") {
            co.coverage = false;
        } else if u.str_eq(a, "--units=module") {
            o.units_mode = 1;
        } else if u.str_eq(a, "--units=program") {
            o.units_mode = 0;
        } else if u.str_eq(a, "--verbose") {
            o.verbose = true;
        } else if u.str_eq(a, "--format=agent-json") {
            o.json = true;
        } else if u.str_eq(a, "--format=human") {
            o.json = false;
        } else if u.starts(a, "--std=") {
            o.std_dir = a[6..];
        } else if u.str_eq(a, "--subsystem=console") {
            pl.g_subsystem = pl.SUBSYSTEM_WINDOWS_CUI;
        } else if u.str_eq(a, "--subsystem=windows") {
            pl.g_subsystem = pl.SUBSYSTEM_WINDOWS_GUI;
        } else if u.starts(a, "--icon=") {
            pl.g_icon = a[7..];
        } else if u.str_eq(a, "--pdb=on") {
            pl.g_pdb = true;
        } else if u.str_eq(a, "--pdb=off") {
            pl.g_pdb = false;
        } else if u.starts(a, "--cpu=") {
            co.cpu = a[6..];
        } else if u.starts(a, "--features=") {
            o.feature_args.push(a[11..]);
        } else if u.starts(a, "--link=") and u.ends(a, ".ax") {
            o.ax_links.push(a[7..]);  // Axiom source: part of the program
        } else if u.starts(a, "--link=") {
            o.link_inputs.push(a[7..]);
        } else if u.starts(a, "--emit-header=") {
            o.header_path = a[14..];
        } else if o.testing and u.starts(a, "--filter=") {
            o.test_filter = a;
        } else if o.testing and u.starts(a, "--timeout=") {
            o.test_timeout = a;
        } else if o.testing and u.str_eq(a, "--show-output") {
            o.show_output = true;
        } else if o.profiling and u.starts(a, "--rate=") and (u.atol(a[7..]) > 0) {
            o.prof_hz = @truncate(i32, u.atol(a[7..]));
        } else if o.profiling and u.starts(a, "--folded=") {
            o.folded_path = a[9..];
        } else if (a.len > 2) and (a[0] == '-') and ((a[1] == 'l') or (a[1] == 'L')) {
            o.link_flags.push(a);
        } else if (a.len > 2) and (a[0] == '-') and (a[1] == 'I') {
            o.inc_flags.push(a);
        } else if c_option(o, a) {
            // an option of the C front end
        } else if o.profiling and u.str_eq(a, "--") {
            // the rest are the program's arguments
            for k in i + 1..argc {
                o.prog_args.push(args[k]);
            }
            break;
        } else if (a.len > 0) and (a[0] == '-') {
            dg.emit_fatal(o.json, "E9001", u.f1("unknown option '%s'", a));
            return false;
        } else if u.isnos(o.input) {
            o.input = a;
        } else if is_c_source(a) {
            o.c_inputs.push(a);  // another translation unit of the program
        } else if is_c_source(o.input) and is_ax_source(a) {
            o.ax_links.push(a);  // an Axiom module of a C program
        } else {
            dg.emit_fatal(o.json, "E9001", u.f1("unexpected argument '%s'", a));
            return false;
        }
        i += 1;
    }
    return true;
}

// A package directory (or none: the current directory) builds the package's
// entry module; `test` also loads all of its sources, into *files.
fn package_input(o: *mut Options, files: *mut u.List.[[]u8]) i32 {
    if not u.isnos(o.input) and not u.is_dir(o.input) {
        return CONTINUE;
    }
    let mut dir: []u8 = ".";
    if not u.isnos(o.input) {
        dir = o.input;
    }
    if not u.file_exists(u.cat2(dir, "/axiom.toml")) {
        if not u.isnos(o.input) {
            return fatal(o.json, "E9001", u.f1("'%s' is a directory without an axiom.toml", o.input));
        }
        return fatal(o.json, "E9001", "no input file (and no axiom.toml in the current directory)");
    }
    let pk = pkg.load_dir(dir, u.nil.[u.Span]());
    if (dg.error_count() != 0) or u.isnil(pk) {
        dg.emit(o.json, o.json);
        return 1;
    }
    o.input = pk.entry;
    pkg.c_sources(&mut o.c_inputs);  // (c-sources: C units beside the Axiom program)
    if o.testing {
        pkg.source_files(pk, files);
    }
    if u.isnos(o.out) and not o.testing and not o.profiling {
        let wasm = u.starts(o.target, "wasm");
        let windows = u.ends(o.target, "windows") or u.ends(o.target, "-msvc");
        o.out = u.cat2(pk.name, u.pick(wasm, ".wasm", u.pick(windows, ".exe", "")));
    }
    return CONTINUE;
}

// Sets the target (ty.g_target, tg.g_arch, tg.g_os) from --target; false on an
// error (reported).
fn set_target(target: []u8, json: bool) bool {
    if u.str_eq(target, "wasm32") or u.str_eq(target, "wasm32-freestanding") {
        ty.g_target = ast.Target.{ ptr_bits: 32, is_wasm: true, triple: "wasm32-unknown-unknown" };
    } else if u.str_eq(target, "wasm64") or u.str_eq(target, "wasm64-freestanding") {
        ty.g_target = ast.Target.{ ptr_bits: 64, is_wasm: true, triple: "wasm64-unknown-unknown" };
    } else if u.str_eq(target, "native") or u.str_eq(target, "x86_64") or u.str_eq(target, "aarch64") {
        let mut arch = tg.host_arch();
        if u.str_eq(target, "x86_64") {
            arch = tg.ARCH_X64;
        } else if u.str_eq(target, "aarch64") {
            arch = tg.ARCH_A64;
        }
        if u.str_eq(target, "native") {
            tg.g_os = tg.host_os();
        }
        ty.g_target = ast.Target.{ ptr_bits: 64, is_wasm: false, triple: tg.triple_of(arch) };
        tg.g_arch = arch;
    } else if u.str_eq(target, "aarch64-macos") or u.str_eq(target, "aarch64-apple-darwin") or
              u.str_eq(target, "macos") {
        tg.g_arch = tg.ARCH_A64;
        tg.g_os = tg.OS_DARWIN;
        ty.g_target = ast.Target.{ ptr_bits: 64, is_wasm: false, triple: tg.triple_of(tg.ARCH_A64) };
    } else if u.str_eq(target, "x86_64-windows") or u.str_eq(target, "x86_64-pc-windows-msvc") or
              u.str_eq(target, "windows") {
        tg.g_arch = tg.ARCH_X64;
        tg.g_os = tg.OS_WINDOWS;
        ty.g_target = ast.Target.{ ptr_bits: 64, is_wasm: false, triple: tg.triple_of(tg.ARCH_X64) };
    } else {
        dg.emit_fatal(json, "E9002",
                      u.f1("unknown target '%s' (expected wasm32, wasm64, x86_64, aarch64, aarch64-macos, x86_64-windows or native)",
                           target));
        return false;
    }
    if ty.g_target.is_wasm {
        tg.g_arch = tg.ARCH_WASM32;
        if ty.g_target.ptr_bits == 64 {
            tg.g_arch = tg.ARCH_WASM64;
        }
    }
    return true;
}

// Processor extensions: a --cpu preset (default: the host for
// --target=native, a baseline otherwise), then --features edits. False on an
// error (reported).
fn set_cpu(o: *Options) bool {
    let mut cpu = o.co.cpu;
    if u.isnos(cpu) {
        cpu = u.pick(u.str_eq(o.target, "native"), "native", "generic");
        if tg.is_darwin() {
            cpu = "apple-m1";  // every Mac with Apple silicon has at least its extensions
        }
    }
    let cr = tg.cpu_features(tg.g_arch, cpu);
    if not cr.ok {
        dg.emit_fatal(o.json, "E9002", u.f2("unknown --cpu '%s' for target %s", cpu, o.target));
        return false;
    }
    tg.g_cpu = cpu;
    tg.g_features = cr.features;
    for k in 0..o.feature_args.len {
        let bad = tg.apply_features(o.feature_args.get(k));
        if not u.isnos(bad) {
            dg.emit_fatal(o.json, "E9002", u.f2("unknown processor extension '%s' (known: %s)", bad,
                                                tg.feature_names()));
            return false;
        }
    }
    return true;
}

// The sources a build adds to the program (into *files): --link=<file.ax>
// and parts of std/internal/runtime. False on an error (reported).
fn runtime_sources(o: *Options, files: *mut u.List.[[]u8]) bool {
    for k in 0..o.ax_links.len {
        files.push(o.ax_links.get(k));
    }
    // std/internal/runtime/rt.ax: software versions of operations some
    // targets lack (@rem, and @fma without hardware fused multiply-add).
    let rtp = u.f1("%s/internal/runtime/rt.ax", o.std_dir);
    if u.file_exists(rtp) {
        files.push(rtp);
    }
    // std/os/cpu.ax: @cpu_has, @features and @multiversion ask it about
    // the processor, and native programs built for more than the
    // baseline check the processor with it before main.
    let cpup = u.f1("%s/os/cpu.ax", o.std_dir);
    if u.file_exists(cpup) {
        files.push(cpup);
    }
    // --sanitize=address checks accesses with std/mem.ax's shadow memory
    if o.co.sanitize_address {
        files.push(u.f1("%s/mem.ax", o.std_dir));
    }
    // --coverage=afl: the coverage runtime (the fuzzer's map and fork
    // server), for Linux only
    if o.co.coverage {
        if ty.g_target.is_wasm or (tg.g_os != tg.OS_LINUX) {
            dg.emit_fatal(o.json, "E9001",
                          u.f1("--coverage=afl is not supported for --target=%s (only for Linux: x86_64, aarch64)",
                               o.target));
            return false;
        }
        files.push(u.f1("%s/internal/runtime/coverage.ax", o.std_dir));
    }
    // Native programs: the host ABI, crash reports, the test runner and
    // the profiler are Axiom code too.
    if tg.is_darwin() and (o.testing or o.profiling) and (tg.host_os() != tg.OS_DARWIN) {
        dg.emit_fatal(o.json, "E9001", u.f2("axiom %s for --target=%s runs only on a Mac", o.cmd, tg.os_target_name()));
        return false;
    }
    if ty.g_target.is_wasm {
        return true;
    }
    let mut names: [3][]u8 = ["native.ax", "", ""];
    if tg.is_darwin() {
        names[0] = "darwin.ax";  // the host ABI over macOS's libSystem
    } else if tg.is_windows() {
        names[0] = "windows.ax";  // the host ABI over the Win32 API
    }
    if o.testing {
        names[1] = "test_main.ax";
        if tg.is_windows() {
            names[1] = "test_main_windows.ax";  // no fork: a process per test
        } else if tg.is_darwin() {
            names[1] = "test_main_darwin.ax";  // fork, over libSystem
        }
    }
    if o.profiling {
        names[2] = "profile.ax";
        if tg.is_windows() {
            names[2] = "profile_windows.ax";  // a sampler thread: no SIGPROF
        } else if tg.is_darwin() {
            names[2] = "profile_darwin.ax";  // setitimer: no POSIX CPU-time timers
        }
    }
    for nm in names {
        if nm.len == 0 {
            continue;
        }
        let p = u.f2("%s/internal/runtime/%s", o.std_dir, nm);
        if not u.file_exists(p) {
            dg.emit_fatal(o.json, "E9003", u.f1("cannot find the native runtime (%s)", p));
            return false;
        }
        files.push(p);
    }
    return true;
}

// --emit-header: writes the C header; C sources may include it. False on an
// error (reported).
fn write_header(o: *mut Options) bool {
    if not header.emit_c_header(o.header_path, u.basename(o.input)) {
        dg.emit_fatal(o.json, "E9005", u.f1("cannot write %s", o.header_path));
        return false;
    }
    let sl = u.rfind(o.header_path, '/');
    if sl >= 0 {
        o.inc_flags.push(u.f1("-I%s", o.header_path[0..@int_cast(usize, sl)]));
    } else {
        o.inc_flags.push("-I.");
    }
    return true;
}

// The commands that compile: build, check, test, profile and ide.
fn compile(args: [][]u8) i32 {
    let mut o = new_options(args[1]);
    cg.g_test_mode = o.testing;
    if not o.build and not u.str_eq(o.cmd, "check") and not o.ide_mode {
        usage();
        return 2;
    }
    if not parse_options(&mut o, args) {
        return 2;
    }
    let mut pkg_files = u.List.[[]u8].empty();
    let rc = package_input(&mut o, &mut pkg_files);
    if rc != CONTINUE {
        return rc;
    }
    if not set_target(o.target, o.json) or not set_cpu(&o) or not check_c_options(&o) {
        return 2;
    }
    if not u.file_exists(o.input) or u.is_dir(o.input) {
        return fatal(o.json, "E0211", u.f1("cannot read '%s'", o.input));
    }
    for k in 0..o.c_inputs.len {
        if not u.file_exists(o.c_inputs.get(k)) or u.is_dir(o.c_inputs.get(k)) {
            return fatal(o.json, "E0211", u.f1("cannot read '%s'", o.c_inputs.get(k)));
        }
    }
    if not u.isnos(o.out) and u.is_dir(o.out) {
        return fatal(o.json, "E9001", u.f1("the output '%s' is a directory (-o names the file to write)", o.out));
    }
    ty.types_init();
    if u.isnos(o.std_dir) {
        o.std_dir = find_std(args[0]);
    }
    if is_c_source(o.input) and o.ide_mode {
        // (axiom lsp asks only about Axiom sources; nothing to answer here)
        return fatal(o.json, "E9001", u.f1("axiom ide answers about Axiom sources, and '%s' is a C source", o.input));
    }
    if is_c_source(o.input) {
        // a C translation unit (docs/c.md)
        let mut c = u.new.[cop.COptions]();
        if not c_options(&o, c) {
            return 2;
        }
        if cfront.text_emit(o.emit) {
            return cfront.run(o.input, c, o.emit, o.out, o.json);
        }
        if u.str_eq(o.emit, "c-lib-defs") {
            // (the C library's index: cmd/internal/tools/gen_c_lib_index.mjs)
            return cfront.lib_defs(o.input, c, o.json);
        }
        return build_c(&mut o, c);
    }
    if o.ide_mode {
        return ide.run(o.input, o.std_dir);
    }
    if o.build and not runtime_sources(&o, &mut pkg_files) {
        return 2;
    }
    if (o.c_inputs.len > 0) and u.str_eq(o.emit, "exe") and not o.c_freestanding {
        // the C library's run-time layer (c_library)
        let rt = u.f1("%s/c/rt", o.std_dir);
        let start = pkg_files.len;
        all_rt_modules(rt, threads_named(&o), &mut pkg_files);
        if pkg_files.len > start {
            let r = u.real_path(rt);
            cg.g_lib_prefix = u.cat2(u.pick(u.isnos(r), rt, r), "/");
        }
    }
    if (o.c_inputs.len > 0) and not has_ldouble(&pkg_files) {
        // (the C units' long double arithmetic, where it is wider than
        // double: cgen_ld.ax; the C options are read after the program is)
        pkg_files.push(u.f1("%s/c/rt/ldouble.ax", o.std_dir));
    }
    let so = sema.SemaOptions.{ std_dir: o.std_dir, extra_files: pkg_files.items() };
    let mut ok = sema.run(o.input, &so);
    u.phase("parse and check");
    if ok and not u.isnos(o.header_path) and not write_header(&mut o) {
        return 2;
    }
    if ok and (o.c_inputs.len > 0) {
        // C units beside the Axiom program (after the header, which they
        // may include)
        let mut c = u.new.[cop.COptions]();
        if not c_options(&o, c) {
            return 2;
        }
        ok = check_c_units(&o, c, true);
        o.units_mode = 0;  // (the units join the program's module)
    }
    if not ok or not o.build {
        dg.emit(o.json, o.json);
        if ok {
            return 0;
        }
        return 1;
    }
    return build_program(&mut o);
}

// A C program (docs/c-frontend.md): each translation unit is checked, the
// units are linked (cfront.link_check), then the start-up module
// (std/internal/runtime/c_start.ax), which calls main, is built as an Axiom
// program, and the units' IR joins its module (codegen.ax), so that all go
// through the same optimizer, backends and linkers. The units are one
// module: they are not compiled separately. An object (--emit=obj or ir) of
// units without main is theirs alone: its root module is
// std/internal/runtime/c_object.ax, with no start-up or runtime.
fn build_c(o: *mut Options, c: *cop.COptions) i32 {
    if o.testing or o.profiling or o.ide_mode {
        return fatal(o.json, "E9001", u.f1("axiom %s does not take a C source", o.cmd));
    }
    let mut ok = cfront.check(o.input, c, false);
    for k in 0..o.c_inputs.len {
        ok = cfront.check(o.c_inputs.get(k), c, false) and ok;
    }
    let exe = u.str_eq(o.emit, "exe");
    let mut lib_modules = u.List.[[]u8].empty();
    if ok and exe {
        ok = c_library(o, c, &mut lib_modules);
    }
    if ok {
        ok = cfront.link_check(o.build and exe);
    }
    if not ok or (not o.build and (o.ax_links.len == 0)) {
        dg.emit(o.json, o.json);
        if ok {
            return 0;
        }
        return 1;
    }
    let object = not exe and not cfront.has_main();
    g_c_object = object;
    let start = u.f2("%s/internal/runtime/%s", o.std_dir, u.pick(object, "c_object.ax", "c_start.ax"));
    if not u.file_exists(start) {
        return fatal(o.json, "E9003", u.f1("cannot find the C start-up module (%s)", start));
    }
    o.units_mode = 0;
    let mut files = u.List.[[]u8].empty();
    if o.build and not object and not runtime_sources(o, &mut files) {
        return 2;
    }
    for k in 0..o.ax_links.len {
        files.push(o.ax_links.get(k));  // (with an object's root too)
    }
    for k in 0..lib_modules.len {
        files.push(lib_modules.get(k));
    }
    set_strip(o);
    if (c.ld_bits != 64) and not has_ldouble(&lib_modules) {
        // long double's arithmetic in software (cgen_ld.ax calls it; only
        // the functions called are generated, objects included): with the
        // C library's run-time layer, else on its own
        files.push(u.f1("%s/c/rt/ldouble.ax", o.std_dir));
    }
    let so = sema.SemaOptions.{ std_dir: o.std_dir, extra_files: files.items() };
    if not sema.run(start, &so) or not cfront.boundary_check(axiom_names(o).items(), false) {
        dg.emit(o.json, o.json);
        return 1;
    }
    u.phase("parse and check");
    if not o.build {
        dg.emit(o.json, o.json);
        return 0;
    }
    return build_program(o);
}

// Is std/c/rt/ldouble.ax among the modules ps (the C library's run-time
// layer)?
fn has_ldouble(ps: *u.List.[[]u8]) bool {
    for k in 0..ps.len {
        if u.ends(ps.get(k), "/c/rt/ldouble.ax") {
            return true;
        }
    }
    return false;
}

// The C library (docs/c.md, "The C library"), linked into a hosted
// program's executable unless --c-freestanding: every C source under
// <std>/c/lib/ is a library's translation unit (cfront.check with lib: a
// program's definition of a name is used instead of the library's), and
// every Axiom module under <std>/c/rt/ (the library's run-time layer, whose
// `export fn`s give it functions with C names) is added to the program
// (into *modules) as a library's, whose exports are generated only when
// referred to (codegen.ax: lazy_export). Either directory may be absent.
// False after an error (reported).
fn c_library(o: *Options, c: *cop.COptions, modules: *mut u.List.[[]u8]) bool {
    let ok = c_library_units(o, c);
    if o.c_freestanding {
        return ok;
    }
    let rt = u.f1("%s/c/rt", o.std_dir);
    let start = modules.len;
    for k in 0..g_rt_needed.len {
        modules.push(g_rt_needed.get(k));
    }
    if modules.len > start {
        let r = u.real_path(rt);
        cg.g_lib_prefix = u.cat2(u.pick(u.isnos(r), rt, r), "/");
    }
    return ok;
}

// The C library's units (<std>/c/lib/**.c), checked as a library's with
// cfront.lib_options, on demand: those that define a name the program's
// units use, and so on for what those use (the index, <std>/c/lib/index,
// maps each external name to the file that defines it; without it, every
// unit is checked). With --c-freestanding only those of <string.h>
// (c/lib/string/), which C23 (4p7) asks of a freestanding implementation
// too. The run-time modules (<std>/c/rt/) whose exports are used are
// recorded in g_rt_needed (c_library adds them). False after an error
// (reported).
fn c_library_units(o: *Options, c: *cop.COptions) bool {
    let mut ok = true;
    let lo = cfront.lib_options(c);
    g_rt_needed = u.List.[[]u8].empty();
    let idx = u.read_file(u.f1("%s/c/lib/index", o.std_dir));
    if u.isnos(idx) {
        let mut srcs = u.List.[[]u8].empty();
        pkg.files_under(u.f2("%s/c/lib%s", o.std_dir, u.pick(o.c_freestanding, "/string", "")), ".c", &mut srcs);
        for k in 0..srcs.len {
            ok = cfront.check(srcs.get(k), lo, true) and ok;
        }
        let rt = u.f1("%s/c/rt", o.std_dir);
        all_rt_modules(rt, true, &mut g_rt_needed);
        return ok;
    }
    // the index: "D name path" (path, under <std>/c/, defines name) and
    // "N path name" (the run-time module path calls name)
    let mut defs = u.SymMap.[[]u8].{ keys: u.nil.[usize](), vals: u.nil.[[]u8](), cap: 0, len: 0 };
    let mut needs = u.List.[[]u8].empty();  // pairs: path, name
    let mut alts = u.List.[[]u8].empty();   // pairs: path, its stand-in
    let mut i: usize = 0;
    while i < idx.len {
        let mut j = i;
        while (j < idx.len) and (idx[j] != '\n') {
            j += 1;
        }
        let line = idx[i..j];
        i = j + 1;
        if (line.len < 3) or (line[1] != ' ') {
            continue;
        }
        let mut k: usize = 2;
        while (k < line.len) and (line[k] != ' ') {
            k += 1;
        }
        if k >= line.len {
            continue;
        }
        let x = line[2..k];
        let y = line[k + 1..];
        if line[0] == 'D' {
            defs.put(u.intern(x), y);
        } else if line[0] == 'N' {
            needs.push(x);
            needs.push(y);
        } else if line[0] == 'A' {
            alts.push(x);
            alts.push(y);
        }
    }
    let mut done = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };  // names, paths
    let mut defined = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    cfront.defined_names(&mut defined);
    let mut work = u.List.[[]u8].empty();
    cfront.all_refs(&mut work);
    if not o.c_freestanding {
        // what code generation calls by name (the start-up's exit; the
        // memory functions the code generators call: c/cstrip.ax)
        for n in ["exit", "memcpy", "memmove", "memset", "memcmp"] {
            work.push(n);
        }
        // and what the program's Axiom modules declare in extern "C" blocks
        extern_c_names(o, &mut work);
    } else {
        for n in ["memcpy", "memmove", "memset", "memcmp"] {
            work.push(n);
        }
    }
    while work.len > 0 {
        let n = u.intern(work.pop());
        if done.has(n) or defined.has(n) {
            continue;
        }
        done.put(n, 1);
        let path = defs.get(n);
        if u.isnos(path) or (path.len == 0) {
            continue;  // (the platform's, or nobody's)
        }
        let pk = u.intern(path);
        if done.has(pk) {
            continue;
        }
        done.put(pk, 1);
        if u.starts(path, "rt/") {
            if o.c_freestanding {
                continue;
            }
            g_rt_needed.push(u.f2("%s/c/%s", o.std_dir, rt_stand_in(path, &alts)));
            for q in 0..needs.len / 2 {
                if u.str_eq(needs.get(2 * q), path) {
                    work.push(needs.get(2 * q + 1));
                }
            }
            continue;
        }
        if o.c_freestanding and not u.starts(path, "lib/string/") {
            continue;
        }
        let before = defined.len;
        _ = before;
        if not cfront.check(u.f2("%s/c/%s", o.std_dir, path), lo, true) {
            ok = false;
            continue;
        }
        for r in cfront.last_refs() {
            work.push(r);
        }
    }
    return ok;
}

// The run-time module of the C library to link for `path` (under <std>/c/):
// itself, or where the target cannot have threads (WebAssembly without the
// atomics extension) its stand-in, if the index's A lines (`alts`: pairs)
// name one.
fn rt_stand_in(path: []u8, alts: *u.List.[[]u8]) []u8 {
    if not ty.g_target.is_wasm or tg.has(tg.W_ATOMICS) {
        return path;
    }
    for q in 0..alts.len / 2 {
        if u.str_eq(alts.get(2 * q), path) {
            return alts.get(2 * q + 1);
        }
    }
    return path;
}

// Every run-time module of the C library (<std>/c/rt/*.ax) into *out, for
// a program that has them all (an Axiom program with C units; a C program
// when there is no index): but a module that creates threads (one X.ax with
// a stand-in X_none.ax: on WebAssembly a program that has std/thread runs
// on a shared memory) only if `threads` (the C sources name <threads.h>'s
// thread functions), and then its stand-in instead where the target cannot
// have threads (rt_stand_in).
fn all_rt_modules(rt: []u8, threads: bool, out: *mut u.List.[[]u8]) void {
    let mut all = u.List.[[]u8].empty();
    pkg.files_under(rt, ".ax", &mut all);
    let none = ty.g_target.is_wasm and not tg.has(tg.W_ATOMICS);
    for k in 0..all.len {
        let f = all.get(k);
        let mut stand_in = false;
        let mut has_stand_in = false;
        if u.ends(f, "_none.ax") {
            stand_in = true;
        } else {
            has_stand_in = u.file_exists(u.cat2(f[0..f.len - 3], "_none.ax"));
        }
        if (stand_in or has_stand_in) and not threads {
            continue;
        }
        if (stand_in and not none) or (has_stand_in and none) {
            continue;
        }
        out.push(f);
    }
}

// Whether the program's C sources name a thread function of <threads.h>
// (thrd_create, thrd_exit, thrd_join, thrd_detach), read as text.
fn threads_named(o: *Options) bool {
    let mut srcs = u.List.[[]u8].empty();
    srcs.push(o.input);
    for k in 0..o.c_inputs.len {
        srcs.push(o.c_inputs.get(k));
    }
    for k in 0..srcs.len {
        if not is_c_source(srcs.get(k)) {
            continue;
        }
        let t = u.read_file(srcs.get(k));
        if u.isnos(t) {
            continue;
        }
        for n in ["thrd_create", "thrd_exit", "thrd_join", "thrd_detach"] {
            if u.contains(t, n) {
                return true;
            }
        }
    }
    return false;
}

// The run-time modules of the C library that the units use (c_library_units).
let mut g_rt_needed: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };

// The names that the extern "C" blocks of the program's own Axiom modules
// declare (the C library's functions they may call): of the Axiom program
// (sema has run), or of the modules beside a C program (--link=file.ax,
// read as text: `fn name(` in an extern "C" block).
fn extern_c_names(o: *Options, out: *mut u.List.[[]u8]) void {
    if u.notnil(sema.g_prog) {
        for i in 0..sema.g_prog.fns.len {
            let d = sema.g_prog.fns.get(i);
            if d.extern_c and not sema.is_std_module(d.module) {
                out.push(d.name);
            }
        }
    }
    for k in 0..o.ax_links.len {
        let t = u.read_file(o.ax_links.get(k));
        if u.isnos(t) {
            continue;
        }
        let mut i: usize = 0;
        let mut inside = false;
        while i < t.len {
            if not inside and u.starts(t[i..], "extern \"C\"") {
                inside = true;
            } else if inside and (t[i] == '}') {
                inside = false;
            } else if inside and u.starts(t[i..], "fn ") {
                let mut j = i + 3;
                while (j < t.len) and
                      ((t[j] == '_') or ((t[j] | 0x20) >= 'a' and (t[j] | 0x20) <= 'z') or
                       (t[j] >= '0' and t[j] <= '9')) {
                    j += 1;
                }
                out.push(t[i + 3..j]);
                i = j;
                continue;
            }
            i += 1;
        }
    }
}

// With C units, an executable that our own linkers link (no --link inputs
// or -l libraries, whose code could refer to anything) is stripped of what
// the units define and nothing reaches (c/cstrip.ax).
fn set_strip(o: *Options) void {
    cg.g_strip = u.str_eq(o.emit, "exe") and (o.link_inputs.len == 0) and (o.link_flags.len == 0);
}

// The C units of an Axiom program (o.c_inputs): checked, linked with each
// other (cfront.link_check) and with the Axiom program (boundary_check).
// The C library's units come after them (c_library: its run-time modules
// are already in the program, lib_modules). False after an error
// (reported).
fn check_c_units(o: *Options, c: *cop.COptions, lib_modules: bool) bool {
    let mut ok = true;
    for k in 0..o.c_inputs.len {
        ok = cfront.check(o.c_inputs.get(k), c, false) and ok;
    }
    if ok and u.str_eq(o.emit, "exe") {
        ok = c_library_units(o, c);
    }
    _ = lib_modules;
    set_strip(o);
    let mut ax_main = false;
    for i in 0..sema.g_prog.fns.len {
        let d = sema.g_prog.fns.get(i);
        if d.is_export and u.str_eq(d.name, "main") and (d.module == sema.g_prog.root) {
            ax_main = true;
        }
    }
    return ok and cfront.link_check(false) and cfront.boundary_check(axiom_names(o).items(), ax_main);
}

// The external names the Axiom program's own modules define (their `export
// fn`s, outside the standard library, whose runtime names C3062 reports),
// for cfront.boundary_check.
fn axiom_names(o: *Options) u.List.[cfront.AxName] {
    _ = o;
    let mut xs = u.List.[cfront.AxName].empty();
    for i in 0..sema.g_prog.fns.len {
        let d = sema.g_prog.fns.get(i);
        if d.is_export and not u.str_eq(d.name, "main") and not sema.is_std_module(d.module) {
            xs.push(cfront.AxName.{ name: d.name, span: d.name_span });
        }
    }
    return xs;
}

// Sets the output kind from --emit; false on an error (reported).
fn set_emit(o: *Options, final_link: bool) bool {
    let co = o.co;
    if u.str_eq(o.emit, "obj") {
        co.emit = cg.EMIT_OBJ;
        be.g_stubs = not ty.g_target.is_wasm and (tg.g_os == tg.OS_LINUX) and not g_c_object;
    } else if u.str_eq(o.emit, "ir") {
        co.emit = cg.EMIT_IR;
    } else if u.str_eq(o.emit, "asm") {
        dg.emit_fatal(o.json, "E9001", "--emit=asm is not supported: use --emit=obj and a disassembler, or --emit=ir");
        return false;
    } else if final_link {
        co.emit = cg.EMIT_OBJ;
    } else {
        dg.emit_fatal(o.json, "E9001", u.f1("unknown --emit kind '%s'", o.emit));
        return false;
    }
    return true;
}

// axiom test and profile build the program into a private directory
// (o.run_dir) and run it. False on an error (reported).
fn private_output(o: *mut Options, final_link: bool, wext: []u8) bool {
    if not final_link {
        let what = u.pick(o.testing, "axiom test builds and runs a test binary",
                          "axiom profile builds and runs the program");
        dg.emit_fatal(o.json, "E9001", u.cat2(what, "; --emit is not supported"));
        return false;
    }
    if o.profiling {
        o.co.stack_traces = true;  // the profiler samples the shadow stack
        o.co.profile = true;
        if u.isnos(o.folded_path) {
            if not u.isnos(o.out) {  // -o names the folded output too
                o.folded_path = o.out;
            } else {
                o.folded_path = u.cat2(strip_ph(u.basename(o.input)), ".folded");
            }
        }
    }
    o.run_dir = u.private_tmp_dir(u.pick(o.testing, "axiom-test-", "axiom-profile-"));
    if u.isnos(o.run_dir) {
        dg.emit_fatal(o.json, "E9001", "cannot make a private directory for the program");
        return false;
    }
    o.out = u.f3("%s/%s%s", o.run_dir, u.pick(o.testing, "tests", "program"), wext);
    pl.g_pdb = false;  // (a temporary executable)
    return true;
}

// Builds the checked program: code generation, linking, and for test and
// profile running it.
fn build_program(o: *mut Options) i32 {
    let co = o.co;
    let final_link = u.str_eq(o.emit, "exe");
    if not set_emit(o, final_link) {
        return 2;
    }
    let wext = u.pick(ty.g_target.is_wasm, ".wasm", "");
    if (o.testing or o.profiling) and not private_output(o, final_link, wext) {
        return 2;
    }
    defer {
        if not u.isnos(o.run_dir) {
            _ = u.rmdir(o.run_dir);
        }
    }
    if u.isnos(o.out) {
        let mut ext: []u8 = "";
        if co.emit == cg.EMIT_IR {
            ext = ".ir";
        } else if co.emit == cg.EMIT_ASM {
            ext = ".s";
        } else if not final_link {
            ext = ".o";
        } else {
            ext = wext;
        }
        o.out = u.cat2(strip_ph(u.basename(o.input)), ext);
    }
    let host_fns = sema.g_prog.host_fns;
    for k in 0..host_fns.len {
        if u.str_eq(host_fns.get(k).name, "ax_thread_spawn") {
            cg.g_threads = true;
        }
    }
    // The wasm profiler reads the shadow stack from another thread, so the
    // program runs on a shared memory.
    if o.profiling and ty.g_target.is_wasm {
        cg.g_threads = true;
    }
    if cg.g_threads and ty.g_target.is_wasm and not tg.has(tg.W_ATOMICS) {
        return fatal(o.json, "E9002", "threads on WebAssembly need the atomics extension (--features=+atomics)");
    }
    let mut objpath = o.out;
    if final_link {
        objpath = u.f2("%s.tmp%s.o", o.out, u.idec(u.getpid()));
        co.out_path = objpath;
    } else {
        co.out_path = o.out;
    }
    cg.collect_link_names(co);
    let n_user_inputs = o.link_inputs.len;
    let mut unit_objs = u.List.[[]u8].empty();
    if final_link and ty.g_target.is_wasm {
        be.g_keep_path = objpath;  // (linked from memory, if our linker links it: link)
    }
    let mut rc = generate(o, objpath, final_link, &mut unit_objs);
    if rc != CONTINUE {
        return rc;
    }
    if final_link {
        rc = link(o, objpath, n_user_inputs, unit_objs.items());
        if rc != CONTINUE {
            return rc;
        }
    }
    if o.testing {
        let trc = tester.run_tests(o.out, o.std_dir, o.test_filter, o.test_timeout, o.json, o.show_output);
        _ = u.unlink(u.cz(o.out));
        return trc;
    }
    if o.profiling {
        let prc = profiler.run_profile(o.out, o.prog_args.items(), o.std_dir, o.folded_path, o.prof_hz, o.json);
        _ = u.unlink(u.cz(o.out));
        return prc;
    }
    dg.emit(o.json, o.json);
    return 0;
}

// Code generation, into objpath, or into a cached object per module (separate
// compilation) or into parts; those objects are added to o.link_inputs and
// *unit_objs.
fn generate(o: *mut Options, objpath: []u8, final_link: bool, unit_objs: *mut u.List.[[]u8]) i32 {
    let co = o.co;
    // Separate compilation (spec §16.7) applies to executables; --emit of a
    // single object/IR/assembly file is always one unit.
    let mut separate = final_link and (co.opt_level <= 1);
    if o.units_mode >= 0 {
        separate = final_link and (o.units_mode == 1);
    }
    let n_user_inputs = o.link_inputs.len;
    if separate {
        let mut objs = u.List.[[]u8].empty();
        let mut us = units.UnitStats.{ total: 0, compiled: 0, evicted: 0, evicted_bytes: 0 };
        let t0 = now_ms();
        let built = units.build_units(co, objpath, &mut objs, &mut us);
        if built < 0 {
            separate = false;  // no processes to compile units in: one unit
        } else if built == 0 {
            dg.emit(o.json, o.json);
            if dg.error_count() == 0 {
                dg.emit_fatal(o.json, "E9007", "code generation failed");
            }
            _ = u.unlink(u.cz(objpath));
            return 1;
        }
        let t1 = now_ms();
        if separate and o.verbose {
            u.eprint(u.f4("axiom: %s modules, %s compiled, %s cached (%s ms)\n", u.zdec(us.total), u.zdec(us.compiled),
                          u.zdec(us.total - us.compiled), u.ffmt("%.0f", t1 - t0)));
            if us.evicted > 0 {
                u.eprint(u.f2("axiom: evicted %s cached objects (%s)\n", u.zdec(us.evicted),
                              human_size(us.evicted_bytes)));
            }
        }
        for k in 0..objs.len {
            o.link_inputs.push(objs.get(k));
            unit_objs.push(objs.get(k));
        }
    }
    // (C code and libraries are linked by the system's linker, which would
    // see the internal symbols of the parts' objects as global)
    be.g_parts = final_link and not separate and (n_user_inputs == 0) and (o.link_flags.len == 0);
    if not separate and not cg.codegen_program(co) {
        dg.emit(o.json, o.json);
        if final_link {
            _ = u.unlink(u.cz(objpath));
        }
        return 1;
    }
    for k in 0..be.g_part_objs.len {
        o.link_inputs.push(be.g_part_objs.get(k));
        unit_objs.push(be.g_part_objs.get(k));
    }
    return CONTINUE;
}

// Links objpath, the units' objects and the user's inputs into o.out: with our
// own linkers where they can, else with wasm-ld or the C compiler.
fn link(o: *mut Options, objpath: []u8, n_user_inputs: usize, unit_objs: [][]u8) i32 {
    let mut rc: i32 = 0;
    let no_c = (n_user_inputs == 0) and (o.link_flags.len == 0);
    let own_link = no_c and (cg.g_link_libs.len == 0);
    let mut native_own = false;
    if tg.g_os != tg.OS_LINUX {
        // (extern "C" "name" blocks name DLLs on Windows, which plink.ax
        // imports from, and dylibs or frameworks on macOS, which mlink.ax
        // loads)
        if not no_c {
            dg.emit_fatal(o.json, "E9004", u.f1("linking C code or libraries for %s is not supported yet",
                                                tg.os_target_name()));
            _ = u.unlink(u.cz(objpath));
            return 1;
        }
        // our own Mach-O or PE linker, against libSystem or the Windows DLLs
        rc = link_native(objpath, unit_objs, o.out);
        native_own = true;
    } else if not ty.g_target.is_wasm and no_c {
        // our own linker; a C toolchain is only needed to link C code
        rc = link_native(objpath, unit_objs, o.out);
        native_own = rc != el.LINK_FALLBACK;
    }
    if ty.g_target.is_wasm and not own_link and u.notnil(be.g_kept_unit) {
        // (wasm-ld reads the object)
        if not be.write_unit(be.g_kept_unit, objpath) {
            return 1;
        }
        be.g_kept_unit = u.nil.[wo.Unit]();
    }
    if ty.g_target.is_wasm and own_link {
        // our own linker; wasm-ld is only needed to link C code
        rc = link_wasm(objpath, unit_objs, o.out);
    } else if native_own {
        // linked
    } else {
        let mut exit = CONTINUE;
        if ty.g_target.is_wasm {
            exit = link_wasm_ld(o, objpath, &mut rc);
        } else {
            exit = link_cc(o, objpath, &mut rc);
        }
        if exit != CONTINUE {
            return exit;
        }
    }
    u.phase("link");
    _ = u.unlink(u.cz(objpath));
    for k in 0..be.g_part_objs.len {
        _ = u.unlink(u.cz(be.g_part_objs.get(k)));
    }
    if rc != 0 {
        dg.emit_fatal(o.json, "E9004", "linking failed");
        return 1;
    }
    return CONTINUE;
}

// Pushes the -l and -L flags, the extern "C" libraries and "-o <out>".
fn push_libs(o: *Options, av: *mut u.List.[[]u8]) void {
    for k in 0..o.link_flags.len {
        av.push(o.link_flags.get(k));
    }
    for k in 0..cg.g_link_libs.len {
        av.push(u.f1("-l%s", cg.g_link_libs.get(k)));
    }
    av.push("-o");
    av.push(o.out);
}

// Links a wasm module with wasm-ld, compiling C sources with clang first. The
// linker's status goes into *rc (the status so far); returns CONTINUE, or an
// exit status after a fatal error (reported).
fn link_wasm_ld(o: *mut Options, objpath: []u8, rc: *mut i32) i32 {
    let names = ["wasm-ld", "wasm-ld-18", "/usr/lib/llvm-18/bin/wasm-ld", "rust-lld"];
    let ld = u.find_tool(names[..]);
    if u.isnos(ld) {
        _ = u.unlink(u.cz(objpath));
        return fatal(o.json, "E9003", "cannot find wasm-ld (install lld)");
    }
    let mut av = u.List.[[]u8].empty();
    av.push(ld);
    if u.str_eq(ld, "rust-lld") {
        av.push("-flavor");
        av.push("wasm");
    }
    if ty.g_target.ptr_bits == 64 {
        av.push("-mwasm64");
    }
    av.push("--no-entry");
    av.push("--stack-first");
    av.push("-z");
    av.push("stack-size=1048576");
    av.push("--export-memory");
    if cg.g_threads {
        // Threads are instances sharing one memory, which the host creates.
        av.push("--shared-memory");
        av.push("--import-memory");
        av.push("--max-memory=1073741824");
    }
    for k in 0..cg.g_export_names.len {
        av.push(u.f1("--export=%s", cg.g_export_names.get(k)));
    }
    av.push(objpath);
    // C sources are compiled for wasm and linked into the same module
    // (they share the linear memory and the stack).
    let mut c_objs = u.List.[[]u8].empty();
    for k in 0..o.link_inputs.len {
        if rc.* != 0 {
            break;
        }
        let inp = o.link_inputs.get(k);
        if (inp.len > 2) and u.ends(inp, ".c") {
            let cc_names = ["clang", "clang-18", "/usr/lib/llvm-18/bin/clang"];
            let clang = u.find_tool(cc_names[..]);
            if u.isnos(clang) {
                _ = u.unlink(u.cz(objpath));
                return fatal(o.json, "E9003", "cannot find clang to compile C sources for wasm");
            }
            let cobj = u.f3("%s.c%s.%s.o", o.out, u.zdec(k), u.idec(u.getpid()));
            let mut cv = u.List.[[]u8].empty();
            cv.push(clang);
            cv.push(u.pick(ty.g_target.ptr_bits == 64, "--target=wasm64-unknown-unknown",
                           "--target=wasm32-unknown-unknown"));
            let copts = ["-O2", "-c", "-ffreestanding", "-mbulk-memory", "-msimd128", "-matomics",
                         "-mnontrapping-fptoint", "-msign-ext", "-mmutable-globals"];
            for c in copts {
                cv.push(c);
            }
            for j in 0..o.inc_flags.len {
                cv.push(o.inc_flags.get(j));
            }
            cv.push(inp);
            cv.push("-o");
            cv.push(cobj);
            rc.* = u.run_status(cv.items(), u.OUT_INHERIT);
            c_objs.push(cobj);
            av.push(cobj);
        } else {
            av.push(inp);
        }
    }
    push_libs(o, &mut av);
    if rc.* == 0 {
        rc.* = u.run_status(av.items(), u.OUT_INHERIT);
    }
    for k in 0..c_objs.len {
        _ = u.unlink(u.cz(c_objs.get(k)));
    }
    return CONTINUE;
}

// Links a native executable with the C compiler (for C code and libraries).
// The linker's status goes into *rc; returns CONTINUE, or an exit status
// after a fatal error (reported).
fn link_cc(o: *mut Options, objpath: []u8, rc: *mut i32) i32 {
    let mut names = ["cc", "clang", "gcc"];
    if tg.g_arch != tg.host_arch() {
        // a cross compiler for the target
        if tg.g_arch == tg.ARCH_A64 {
            names = ["aarch64-linux-gnu-gcc", "aarch64-linux-gnu-cc", "aarch64-linux-gnu-gcc-13"];
        } else {
            names = ["x86_64-linux-gnu-gcc", "x86_64-linux-gnu-cc", "x86_64-linux-gnu-gcc-13"];
        }
    }
    let cc = u.find_tool(names[..]);
    if u.isnos(cc) {
        _ = u.unlink(u.cz(objpath));
        return fatal(o.json, "E9003", "cannot find a C compiler to link with");
    }
    // The toolchain's runtime sources are compiled once and cached.
    let rtdir = u.f1("%s/internal/runtime/", o.std_dir);
    for k in 0..o.link_inputs.len {
        let inp = o.link_inputs.get(k);
        if u.starts(inp, rtdir) {
            let obj = units.cached_runtime_object(cc, inp);
            if not u.isnos(obj) {
                o.link_inputs.set(k, obj);
            }
        }
    }
    let mut av = u.List.[[]u8].empty();
    av.push(cc);
    // C code keeps frame pointers: stack traces walk through it
    // (codegen.ax: frame_tables)
    av.push("-fno-omit-frame-pointer");
    av.push(objpath);
    // the system call stubs the runtime uses (cmd/axiom/src/lstub.ax)
    let mut machine = elf.EM_X86_64;
    if tg.g_arch == tg.ARCH_A64 {
        machine = elf.EM_AARCH64;
    }
    let stub_path = u.cat2(objpath, ".stubs.o");
    if not u.write_file(stub_path, elf.write(lstub.build(machine, false))) {
        dg.emit_fatal(o.json, "E9004", u.f1("cannot write %s", stub_path));
        return 1;
    }
    av.push(stub_path);
    for k in 0..o.inc_flags.len {
        av.push(o.inc_flags.get(k));
    }
    for k in 0..o.link_inputs.len {
        av.push(o.link_inputs.get(k));
    }
    push_libs(o, &mut av);
    av.push("-lm");
    av.push("-pthread");
    rc.* = u.run_status(av.items(), u.OUT_INHERIT);
    _ = u.unlink(u.cz(stub_path));
    return CONTINUE;
}

fn driver(args: [][]u8) i32 {
    u.phase("start");
    if args.len < 2 {
        usage();
        return 2;
    }
    let cmd = args[1];
    for a in args[1..] {
        if u.str_eq(a, "--") {
            break;  // (axiom profile: the program's arguments)
        }
        if u.str_eq(a, "--help") or u.str_eq(a, "-h") {
            usage();
            return 0;
        }
    }
    if u.str_eq(cmd, "help") {
        usage();
        return 0;
    }
    if u.str_eq(cmd, "cache") {
        return run_cache(args[2..]);
    }
    if u.str_eq(cmd, "version") {
        u.print(u.f1("axiom %s\n", ver.VERSION));
        return 0;
    }
    if u.str_eq(cmd, "update") {
        return update.run_update(args[2..]);
    }
    if u.str_eq(cmd, "lsp") {
        let mut exe = u.self_path();
        if u.isnos(exe) {
            exe = args[0];
        }
        return lsp.run(args[2..], exe);
    }
    if u.str_eq(cmd, "fmt") {
        return fmt.run_fmt(args[2..], find_std(args[0]));
    }
    if u.str_eq(cmd, "new") {
        return run_new(args[2..]);
    }
    return compile(args);
}

export fn main() i32 {
    u.keep_memory();
    let rc = driver(u.program_args());
    u.flush_out();
    return rc;
}
