// =============================================================================
// cgmain.ax - a code generation run (codegen_program): the unit's
// functions and globals from codegen.ax, then what the program around them
// needs: the native entry, the exports of the shadow stack, frame and trap
// tables and tests, the library's lazily generated exports.
// =============================================================================
import "ast.ax" as ast;
import "backend.ax" as be;
import "c/cc.ax" as cfront;
import "c/cstrip.ax" as cstrip;
import "cgbase.ax" as cgb;
import "cgctx.ax" as cx;
import "cgrt.ax" as cgrt;
import "codegen.ax" as cg;
import "diag.ax" as dg;
import "ir.ax" as ir;
import "modload.ax" as modl;
import "target.ax" as tg;
import "types.ax" as ty;
import "util.ax" as u;

// ---------------------------------------------------------------------------
// Driver
// ---------------------------------------------------------------------------
/// An object of C translation units alone (--emit=obj of C sources without
/// a main: std/internal/runtime/c_object.ax): it holds their code and data,
/// without the runtime's helpers (axiom_shadow_stack, axiom_frame_table,
/// ...), which the program that links it has; so the system's toolchain
/// links it into a program of the system's C library (docs/c.md).
pub let mut g_bare_object: bool = false;

// A small exported function whose body the caller builds.
fn add_export(name: []u8, ret: *mut ir.Ty, ps: []mut *mut ir.Ty) *mut ir.Value {
    let fty = ir.t_fn(ret, ps, false);
    let f = ir.add_function(cx.M, name, fty).val;
    if cx.g_object_output and not u.str_eq(name, "main") {
        cgrt.set_linkage(f, ir.LINK_LINKONCE);  // (the runtime's helpers: one per program)
    }
    if ty.g_target.is_wasm {
        cgrt.add_str_attr(f, "wasm-export-name", name);
    }
    cx.g_export_names.push(u.intern(name));
    cx.at_end(ir.append_block(ir.fnp_of(f), "entry"));
    return f;
}

// axiom_shadow_stack(): the calling thread's shadow stack record (see
// ss_ptr), or null when built with --stack-traces=off.
fn emit_shadow_stack_export() void {
    _ = add_export("axiom_shadow_stack", cx.T_ptr, cx.no_tys());
    if cgrt.program_traces() {
        ir.ret(cx.B, cgrt.ss_ptr());
    } else {
        ir.ret(cx.B, ir.czero(cx.T_ptr));
    }
}

// axiom_frame_table(): the frame table's bounds {start, end}: the
// linked program's axiom_rets sections (the linkers place them together
// and define these symbols, as the system's linker does), or null when calls
// record themselves on the shadow stack (see frame_tables).
fn emit_frame_table_export() void {
    let mut g = ir.czero(cx.T_ptr);
    if cgrt.frame_tables() {
        let start = ir.add_global(cx.M, cx.T_i8, "__start_axiom_rets").val;
        let stop = ir.add_global(cx.M, cx.T_i8, "__stop_axiom_rets").val;
        cgrt.set_linkage(start, ir.LINK_EXTWEAK);
        cgrt.set_linkage(stop, ir.LINK_EXTWEAK);
        g = ir.add_global(cx.M, ir.t_array(cx.T_ptr, 2), "axiom.rets").val;
        let mut el: [2]*mut ir.Value = [start, stop];
        cgrt.set_init(g, ir.carray(cx.T_ptr, el[..]));
        cgrt.set_linkage(g, ir.LINK_INTERNAL);
        ir.gv_of(g).is_const = true;
        cgrt.set_align(g, 8);
    }
    _ = add_export("axiom_frame_table", cx.T_ptr, cx.no_tys());
    ir.ret(cx.B, g);
    // axiom_frame_address(): its own frame record, whose first word is the
    // caller's frame address (for the runtime's walks from its own frames)
    let f = add_export("axiom_frame_address", cx.T_ptr, cx.no_tys());
    ir.fnp_of(f).noinline = true;
    let mut none: [1]*mut ir.Value = [cx.vnil()];
    ir.ret(cx.B, ir.intr(cx.B, ir.IN_FRAME_ADDR, cx.T_ptr, none[0..0]));
}

// axiom_trap_info(): address of {site, kind, a, b, alen, blen} (64-bit
// fields); `site` points at {code, file_id, start, end, line, col, file, text}.
fn emit_trap_info_export() void {
    _ = add_export("axiom_trap_info", cx.T_ptr, cx.no_tys());
    ir.ret(cx.B, cgrt.trap_info_global());
}

// Test binaries (spec §17): tests are listed and run through exports.
//   axiom_test_count() u32
//   axiom_test_name(i) *u8        NUL-terminated
//   axiom_test_expect(i) i32      -1 must not trap, -2 any trap, n: trap Tn
//   axiom_test_run(i) u32         0, or the error code the test returned
//   axiom_error_name(code) *u8    NUL-terminated
//   axiom_test_leaks() u32        after a test passed: the allocations it
//                                 never freed, reported on stderr
//                                 (--sanitize=address; otherwise 0)
fn emit_test_exports() void {
    let tests = modl.g_prog.tests;
    let n = tests.len;
    _ = add_export("axiom_test_count", cx.T_i32, cx.no_tys());
    ir.ret(cx.B, cx.ci32(@as(u64, n)));

    let names = u.newn.[*mut ir.Value](n + 1);
    let expects = u.newn.[*mut ir.Value](n + 1);
    for i in 0..n {
        let d = tests.get(i);
        names[i] = cgb.string_ptr(cgrt.cstr_prefix(d.test_name));
        expects[i] = ir.cint(cx.T_i32, @bit_cast(u64, @as(i64, d.test_trap)));
    }
    let ntab = ir.add_global(cx.M, ir.t_array(cx.T_ptr, @as(u64, n) + 1), "axiom.test_names").val;
    names[n] = ir.czero(cx.T_ptr);
    cgrt.set_init(ntab, ir.carray(cx.T_ptr, names[0..n + 1]));
    cgrt.set_linkage(ntab, ir.LINK_INTERNAL);
    let etab = ir.add_global(cx.M, ir.t_array(cx.T_i32, @as(u64, n) + 1), "axiom.test_expect").val;
    expects[n] = cx.ci32(0);
    cgrt.set_init(etab, ir.carray(cx.T_i32, expects[0..n + 1]));
    cgrt.set_linkage(etab, ir.LINK_INTERNAL);

    let mut pi: [1]*mut ir.Ty = [cx.T_i32];
    let mut f = add_export("axiom_test_name", cx.T_ptr, pi[..]);
    ir.ret(cx.B, cx.ld(cx.T_ptr, cx.gep2(ir.t_array(cx.T_ptr, @as(u64, n) + 1), ntab, cx.ci32(0), cgrt.param(f, 0))));
    f = add_export("axiom_test_expect", cx.T_i32, pi[..]);
    ir.ret(cx.B, cx.ld(cx.T_i32, cx.gep2(ir.t_array(cx.T_i32, @as(u64, n) + 1), etab, cx.ci32(0), cgrt.param(f, 0))));

    // axiom_test_run: a switch over the test functions.
    let run = add_export("axiom_test_run", cx.T_i32, pi[..]);
    if cx.O.sanitize_address {
        // (the quarantine a test keeps: smaller, as tests run in parallel)
        let ts = cg.mem_fn("asan_test_start");
        _ = cx.call(ts.llty, ts.fnv, cx.no_vals());
    }
    let dflt = ir.append_block(ir.fnp_of(run), "none");
    let sw = ir.switch_(cx.B, cgrt.param(run, 0), dflt);
    for i in 0..n {
        let fi = cgb.get_inst(tests.get(i), ty.no_types());
        let bb = ir.append_block(ir.fnp_of(run), "test");
        ir.add_case(sw, cx.ci32(@as(u64, i)), bb);
        cx.at_end(bb);
        let r = cx.call(fi.llty, fi.fnv, cx.no_vals());
        if cfront.pending() and cfront.hosted() {
            // (with C code: its streams' output written after each test,
            // which --show-output shows and a crash after it does not lose)
            let mut pp: [1]*mut ir.Ty = [cx.T_ptr];
            let fty = ir.t_fn(cx.T_i32, pp[..], false);
            let mut fl = ir.get_function(cx.M, "fflush");
            if u.isnil(fl) {
                fl = ir.add_function(cx.M, "fflush", fty);
            }
            let mut na: [1]*mut ir.Value = [ir.czero(cx.T_ptr)];
            _ = ir.call(cx.B, fl.ty, fl.val, na[..]);
        }
        ir.ret(cx.B, cx.zext(cx.extract(r, 0), cx.T_i32));
    }
    cx.at_end(dflt);
    ir.ret(cx.B, cx.ci32(0xFFFF));

    let en = add_export("axiom_error_name", cx.T_ptr, pi[..]);
    let tab = cg.error_name_table();
    let ne = modl.g_prog.error_names.len;
    let mut code = cx.zext(cgrt.param(en, 0), cx.T_isz);
    code = cx.sel(cx.icmp(ir.IntULE, code, cx.usz(@int_cast(i64, ne))), code, cx.usz(0));
    let stt = cx.lty(ty.type_slice(ty.t_u8, false));
    let sl = cx.ld(stt, cx.gep2(ir.t_array(stt, @as(u64, ne) + 1), tab, cx.usz(0), code));
    ir.ret(cx.B, cx.extract(sl, 0));

    _ = add_export("axiom_test_leaks", cx.T_i32, cx.no_tys());
    if cx.O.sanitize_address {
        let lk = cg.mem_fn("asan_test_leaks");
        ir.ret(cx.B, cx.call(lk.llty, lk.fnv, cx.no_vals()));
    } else {
        ir.ret(cx.B, cx.ci32(0));
    }
}

fn call_runtime(name: []u8) void {
    let fty = ir.t_fn(cx.T_void, cx.no_tys(), false);
    _ = cx.call(fty, ir.add_function(cx.M, name, fty).val, cx.no_vals());
}

// Native programs: axiom_target_arch() for the runtime (std/internal/runtime/native.ax)
// and the C entry point, which initializes the runtime (and the profiler)
// before running the program's main, or the tests.
fn emit_native_entry() void {
    _ = add_export("axiom_target_arch", cx.T_i32, cx.no_tys());
    let mut arch: u64 = 1;
    if tg.g_arch == tg.ARCH_A64 {
        arch = 2;
    }
    ir.ret(cx.B, cx.ci32(arch));

    let mut user_main = u.nil.[ast.Decl]();
    for i in 0..modl.g_prog.fns.len {
        let d = modl.g_prog.fns.get(i);
        if d.is_export and u.str_eq(d.name, "main") {
            user_main = d;
        }
    }
    if u.isnil(user_main) and not cx.g_test_mode {
        return;  // a library, or C code has the entry point
    }
    let mut pi: [2]*mut ir.Ty = [cx.T_i32, cx.T_ptr];
    let f = add_export("main", cx.T_i32, pi[..]);
    // Built for more than the architecture's baseline: check the processor
    // first (std/os/cpu.ax; it and this entry are compiled for the baseline).
    ir.fnp_of(f).features = 0;
    ir.fnp_of(f).has_features = true;
    let aty = ir.t_fn(cx.T_void, pi[..], false);
    let mut aargs: [2]*mut ir.Value = [cgrt.param(f, 0), cgrt.param(f, 1)];
    // On macOS the check comes after ax_rt_args, which makes the thread-local
    // block: before it, std/os/cpu's shadow stack would be written through
    // TSD slot 0, into the thread's own structure. (Every Mac has apple-m1's
    // extensions, what the runtime is built for.)
    if tg.is_darwin() {
        _ = cx.call(aty, ir.add_function(cx.M, "ax_rt_args", aty).val, aargs[..]);
    }
    if tg.g_features != 0 {
        let req = cgb.cpu_fn("require");
        let mut rargs: [2]*mut ir.Value = [
            ir.cint(cx.T_i64, tg.g_features), cgb.const_slice(cgb.string_ptr(tg.g_cpu), @int_cast(i64, tg.g_cpu.len))];
        _ = cx.call(req.llty, req.fnv, rargs[..]);
    }
    if not tg.is_darwin() {
        _ = cx.call(aty, ir.add_function(cx.M, "ax_rt_args", aty).val, aargs[..]);
    }
    call_runtime("ax_rt_init");
    if cx.O.coverage {
        call_runtime("ax_cov_init");  // (attaches the fuzzer's map, runs its fork server)
    }
    if cx.O.profile {
        call_runtime("ax_profile_start");
    }
    if cx.g_test_mode {
        let tty = ir.t_fn(cx.T_i32, pi[..], false);
        let mut args: [2]*mut ir.Value = [cgrt.param(f, 0), cgrt.param(f, 1)];
        ir.ret(cx.B, cx.call(tty, ir.add_function(cx.M, "ax_test_main", tty).val, args[..]));
        return;
    }
    if cx.O.sanitize_address {
        let mut sargs: [2]*mut ir.Value = [cgrt.param(f, 0), cgrt.param(f, 1)];
        let code = cg.asan_call_main(user_main, sargs[..]);
        call_runtime("ax_rt_fini");
        ir.ret(cx.B, code);
        return;
    }
    let fi = cgb.get_inst(user_main, ty.no_types());
    let fty = fi.llty;
    let mut args: [2]*mut ir.Value = [cgrt.param(f, 0), cgrt.param(f, 1)];
    let r = cx.call(fty, fi.fnv, args[0..fty.params.len]);
    call_runtime("ax_rt_fini");
    if fty.ret.kind == ir.T_VOID {
        ir.ret(cx.B, cx.ci32(0));
    } else if fty.ret.bits < 32 {
        ir.ret(cx.B, cx.zext(r, cx.T_i32));
    } else {
        ir.ret(cx.B, r);
    }
}

// Generates the bodies of the functions instantiated and not yet generated.
fn gen_pending() void {
    while u.notnil(cx.S.pending_head) {
        let fi = cx.S.pending_head;
        cx.S.pending_head = fi.next;
        if u.isnil(cx.S.pending_head) {
            cx.S.pending_tail = u.nil.[cx.FnInst]();
        }
        cg.gen_fn_body(fi);
    }
}

// The root module's `export fn main`, or nil.
fn axiom_main_decl() *mut ast.Decl {
    for i in 0..modl.g_prog.fns.len {
        let d = modl.g_prog.fns.get(i);
        if d.is_export and u.str_eq(d.name, "main") and (d.module == modl.g_prog.root) {
            return d;
        }
    }
    return u.nil.[ast.Decl]();
}

// Does an Axiom module define exit (an `export fn`: the hosted C library's
// run-time layer, which the C start-up calls when main returns)?
fn exports_exit() bool {
    let P = modl.g_prog;
    for i in 0..P.fns.len {
        let d = P.fns.get(i);
        if d.is_export and u.str_eq(d.name, "exit") {
            return true;
        }
    }
    return false;
}

fn find_lazy_exports() void {
    let P = modl.g_prog;
    for i in 0..P.fns.len {
        let d = P.fns.get(i);
        if cgrt.lazy_export(d) and not cfront.defines(d.name) {
            cx.S.lazy_fns.put(u.intern(d.name), d);
        }
    }
}

// If declaration f is a library module's export (lazy_fns), generates it,
// and what it refers to; true if so (cstrip.ax calls it for what it
// reaches).
fn define_lazy(f: *mut ir.Func) bool {
    if cx.S.lazy_fns.len == 0 {
        return false;
    }
    let d = cx.S.lazy_fns.get(f.name);
    if u.isnil(d) {
        return false;
    }
    _ = cgb.get_inst(d, ty.no_types());
    gen_pending();
    return not ir.is_decl(f);
}

// After the C units are generated, when nothing is stripped (an object):
// the library modules' exports that the module declares are generated, and
// what they refer to, until no more are (as an archive's members are
// linked).
fn link_lazy_exports() void {
    if cx.S.lazy_fns.len == 0 {
        return;
    }
    let mut done: usize = 0;
    loop {
        let n = cx.M.funcs.len;
        if done == n {
            break;
        }
        for i in done..n {
            let f = cx.M.funcs.get(i);
            if ir.is_decl(f) {
                _ = define_lazy(f);
            }
        }
        done = n;
    }
}

// Generates code for the checked program. False on failure (errors reported
// through diag or printed to stderr).
pub fn codegen_program(o: *mut cx.CgOptions) bool {
    // (what is allocated for the IR is ir.ax's, kept; the rest is given
    // back with the syntax tree once the IR is made)
    u.tree_default = true;
    defer {
        u.tree_default = false;
    }
    cx.O = o;
    cx.S.build_features = tg.g_features;
    cx.S.sanitize_main = o.sanitize_address;
    let P = modl.g_prog;
    ir.init_types(@int_cast(u64, ty.g_target.ptr_bits / 8));
    cx.M = ir.new_module(u.file_of(P.root.file.id).display);
    cx.M.frame_tables = cgrt.frame_tables();
    cx.B = ir.new_builder();
    cx.T_i1 = ir.t_int(1);
    cx.T_i8 = ir.t_int(8);
    cx.T_i16 = ir.t_int(16);
    cx.T_i32 = ir.t_int(32);
    cx.T_i64 = ir.t_int(64);
    cx.T_isz = ir.t_int(ty.g_target.ptr_bits);
    cx.T_ptr = ir.t_ptr();
    cx.T_void = ir.t_void();
    cx.T_f32 = ir.t_float(32);
    cx.T_f64 = ir.t_float(64);
    cx.T_v128 = ir.t_vec(cx.T_i32, 4);

    if cx.O.coverage {
        cx.M.cov_area = cgb.cov_global("area");
        cx.M.cov_prev = cgb.cov_global("prev");
    }
    let program_parts = cx.O.unit != cx.CG_MODULE;
    cx.S.c_program = cfront.pending();
    if program_parts and ty.g_target.is_wasm and cx.g_threads {
        cg.emit_thread_start();
    }

    if cx.O.unit == cx.CG_WHOLE {
        // Roots: exported functions. Everything else (functions, generic
        // instances, globals) is generated on first reference, so
        // unreachable code costs nothing in the backend.
        for i in 0..P.fns.len {
            let d = P.fns.get(i);
            if d.is_export and not cgrt.lazy_export(d) {
                _ = cgb.get_inst(d, ty.no_types());
            }
        }
    } else if cx.O.unit == cx.CG_MODULE {
        // Every non-generic function of the module (other units may call
        // any of them, directly or from a generic instance).
        for i in 0..P.fns.len {
            let d = P.fns.get(i);
            if (d.module == cx.O.module) and (d.gparams.len == 0) and
               not (u.notnil(d.owner) and (d.owner.gparams.len != 0)) {
                _ = cgb.get_inst(d, ty.no_types());
            }
        }
        if cx.g_test_mode {
            for i in 0..P.tests.len {
                if P.tests.get(i).module == cx.O.module {
                    _ = cgb.get_inst(P.tests.get(i), ty.no_types());
                }
            }
        }
    } else {
        // The link unit: globals, error codes and names.
        for i in 0..P.globals.len {
            let d = P.globals.get(i);
            if d.is_tls and ty.g_target.is_wasm {
                _ = cgb.tls_globals();  // (the block, not one global each)
            } else {
                _ = cgb.global_ref(d);
            }
        }
        for i in 0..P.error_names.len {
            let g = ir.add_global(cx.M, cx.T_i16, u.f1("axiom.errcode.%s", P.error_names.get(i))).val;
            cgrt.set_init(g, ir.cint(cx.T_i16, @as(u64, i) + 1));
            ir.gv_of(g).is_const = true;
        }
        _ = cg.error_name_fn();
        if cgrt.program_traces() {
            cgrt.ss_globals();
        }
        if ty.g_target.is_wasm {
            _ = cgrt.stack_limit();
        }
        _ = cgrt.trap_info_global();
    }
    if program_parts {
        if cx.g_test_mode {
            emit_test_exports();
        }
        if ty.g_target.is_wasm {
            emit_trap_info_export();
            if ty.g_target.ptr_bits == 64 {
                // tells hosts that pointers in memory are 64-bit
                _ = add_export("axiom_wasm64", cx.T_i32, cx.no_tys());
                ir.ret(cx.B, cx.ci32(1));
            }
        }
        if not g_bare_object {
            emit_shadow_stack_export();  // (an object of C units alone has none of these)
        }
        if g_bare_object {
            // (its code alone: no runtime)
        } else if not ty.g_target.is_wasm {
            emit_frame_table_export();
            emit_native_entry();
        } else if cx.O.sanitize_address and not cx.g_test_mode {
            cg.emit_asan_main_wasm();
        }
    }
    gen_pending();
    cg.emit_cabi_thunks();
    // the objects exported for C (spec §14.5.6), whether Axiom code uses
    // them or not
    if cx.O.unit != cx.CG_MODULE {
        for i in 0..modl.g_prog.globals.len {
            let gd = modl.g_prog.globals.get(i);
            if gd.is_export {
                _ = cgb.global_ref(gd);
            }
        }
    }
    gen_pending();
    // C translation units (main.ax) join the module: a C program's start-up,
    // or an Axiom program; then the functions of lib/c/rt/ldouble.ax they
    // call (c_ld_fn)
    let c_units = cfront.pending();
    if c_units {
        cfront.set_wasm_threads(ty.g_target.is_wasm and cx.g_threads);
        cfront.set_shadow_stack(cgrt.c_ss_push, cgrt.c_ss_pop, cgrt.c_ss_depth);
    }
    let f0 = cx.M.funcs.len;
    let g0 = cx.M.globals.len;
    let c_main = c_units and cfront.has_main();
    if c_units and not cfront.gen_ir(cx.M, ty.g_target.is_wasm, cgrt.c_call_site, exports_exit(), cg.c_ld_fn) {
        return false;
    }
    if c_units and not c_main {
        // an Axiom program's main: the C units' constructors before it and
        // their destructors after it (GNU dialects)
        let am = axiom_main_decl();
        if u.notnil(am) {
            cfront.wrap_axiom_main(cx.M, ir.fnp_of(cgb.get_inst(am, ty.no_types()).fnv));
        }
    }
    gen_pending();
    let f1 = cx.M.funcs.len;
    let g1 = cx.M.globals.len;
    if c_units {
        find_lazy_exports();
        // the library exports that the objects linked with the program refer
        // to (cstrip.g_roots)
        for n in cstrip.g_root_list.items() {
            let d = cx.S.lazy_fns.get(n);
            if u.notnil(d) {
                _ = cgb.get_inst(d, ty.no_types());
            }
        }
        gen_pending();
        if cx.M.aliases.len > 0 {
            ir.merge_same_named(cx.M);  // (a declaration of an alias's name: its target)
        }
        if cx.g_strip {
            // what nothing reaches goes, and the library exports reached are
            // generated (define_lazy)
            cstrip.strip(cx.M, f0, f1, g0, g1, define_lazy);
        } else {
            // linked with other code by another linker: the program's units
            // keep their external definitions and what those reach, the C
            // library's what they reach (the other code has the system's C
            // library)
            cstrip.strip_kept(cx.M, f0, f1, g0, g1, cfront.g_lib_funcs, cfront.g_lib_globals, define_lazy);
            link_lazy_exports();
        }
    }
    if dg.error_count() != 0 {
        return false;
    }

    cgrt.end_site_strs();
    // the syntax tree, and what the code generator allocated for itself, are
    // done with: their memory is for the IR
    u.tree_default = false;
    u.release_tree();
    u.phase("IR");
    if (cx.g_link_libs.len != 0) and be.g_parts {
        be.g_parts = false;  // (linked by the system's linker: main.ax)
    }
    return be.emit_module(cx.M, cx.O.opt_level, cx.O.emit, cx.O.out_path);
}
