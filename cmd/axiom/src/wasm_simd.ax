// =============================================================================
// wasm_simd.ax - SIMD128 vector operations, lane helpers, shuffles, and
// vector intrinsics, part of wasm.ax.
// =============================================================================
import "ir.ax" as ir;
import "util.ax" as u;
import "wobj.ax" as wo;

fn lane_shape(t: *ir.Ty) i32 {
    // 0: i8x16, 1: i16x8, 2: i32x4, 3: i64x2, 4: f32x4, 5: f64x2
    let e = t.elem;
    if e.kind == ir.T_FLOAT {
        if e.bits == 32 {
            return 4;
        }
        return 5;
    }
    if e.bits == 8 {
        return 0;
    }
    if e.bits == 16 {
        return 1;
    }
    if e.bits == 32 {
        return 2;
    }
    return 3;
}

fn vec_binop(o: i32, t: *ir.Ty) void {
    let sh = lane_shape(t);
    if (o == ir.OP_AND) or (o == ir.OP_OR) or (o == ir.OP_XOR) {
        if o == ir.OP_AND {
            op_fd(78);
        } else if o == ir.OP_OR {
            op_fd(80);
        } else {
            op_fd(81);
        }
        return;
    }
    let adds: [4]u64 = [110, 142, 174, 206];
    let subs: [4]u64 = [113, 145, 177, 209];
    let muls: [4]u64 = [0, 149, 181, 213];
    if sh < 4 {
        let i = @int_cast(usize, sh);
        if o == ir.OP_ADD {
            op_fd(@as(u64, adds[i]));
            return;
        }
        if o == ir.OP_SUB {
            op_fd(@as(u64, subs[i]));
            return;
        }
        if (o == ir.OP_MUL) and (sh > 0) {
            op_fd(@as(u64, muls[i]));
            return;
        }
    } else {
        let mut base: u64 = 228;  // f32x4.add
        if sh == 5 {
            base = 240;  // f64x2.add
        }
        if o == ir.OP_FADD {
            op_fd(base);
            return;
        }
        if o == ir.OP_FSUB {
            op_fd(base + 1);
            return;
        }
        if o == ir.OP_FMUL {
            op_fd(base + 2);
            return;
        }
        if o == ir.OP_FDIV {
            op_fd(base + 3);
            return;
        }
    }
    fail(u.f1("vector operation %s", u.idec(o)));
}

// Shifts of vectors by a lane-uniform count (the IR's second operand is a
// splat of the scalar count, or a vector whose lane 0 we use). A splat's
// scalar is used directly only when the splat is computed here: otherwise the
// liveness of locals tracks only the splat's own local.
fn vec_shift(v: *mut ir.Value) void {
    let sh = lane_shape(v.ty);
    push(v.a);
    let c = v.b;
    if (c.kind == ir.V_INST) and (c.op == ir.OP_SPLAT) and (c.flag == FL_INLINE) {
        push(c.a);
        if is64(c.a.ty) {
            op(0xa7);
        }
    } else {
        push(c);
        extract_lane(c.ty, 0, false);
        if is64(c.ty.elem) {
            op(0xa7);
        }
    }
    let base: [4]u64 = [107, 139, 171, 203];
    let mut k: u64 = 0;
    if v.op == ir.OP_ASHR {
        k = 1;
    } else if v.op == ir.OP_LSHR {
        k = 2;
    }
    op_fd(@as(u64, base[@int_cast(usize, sh)]) + k);
}

fn extract_lane(t: *ir.Ty, lane: u64, signed: bool) void {
    let sh = lane_shape(t);
    if sh == 0 {
        op_fd(@as(u64, u.pick(signed, "\x15", "\x16")[0]));
    } else if sh == 1 {
        op_fd(@as(u64, u.pick(signed, "\x18", "\x19")[0]));
    } else {
        let codes: [6]u64 = [0, 0, 27, 29, 31, 33];
        op_fd(@as(u64, codes[@int_cast(usize, sh)]));
    }
    CB.u8_(@truncate(u8, lane));
}

fn replace_lane(t: *ir.Ty, lane: u64) void {
    let codes: [6]u64 = [23, 26, 28, 30, 32, 34];
    op_fd(@as(u64, codes[@int_cast(usize, lane_shape(t))]));
    CB.u8_(@truncate(u8, lane));
}

fn splat_op(t: *ir.Ty) void {
    op_fd(15 + @as(u64, @bit_cast(u32, lane_shape(t))));
}

fn vec_icmp(p: ir.CmpPred, t: *ir.Ty) void {
    let sh = lane_shape(t);
    if sh == 3 {
        // i64x2: eq ne lt_s gt_s le_s ge_s only; unsigned via flipped sign bits
        let mut k: u64 = 0;
        match p {
            .EQ        => { k = 0; }
            .NE        => { k = 1; }
            .SLT, .ULT => { k = 2; }
            .SGT, .UGT => { k = 3; }
            .SLE, .ULE => { k = 4; }
            else       => { k = 5; }
        }
        op_fd(214 + k);
        return;
    }
    let base: [3]u64 = [35, 45, 55];
    let mut k: u64 = 0;
    match p {
        .EQ  => { k = 0; }
        .NE  => { k = 1; }
        .SLT => { k = 2; }
        .ULT => { k = 3; }
        .SGT => { k = 4; }
        .UGT => { k = 5; }
        .SLE => { k = 6; }
        .ULE => { k = 7; }
        .SGE => { k = 8; }
        else => { k = 9; }
    }
    op_fd(@as(u64, base[@int_cast(usize, sh)]) + k);
}

fn flip_i64_signs() void {
    op_fd(12);
    for i in @as(usize, 0)..2 {
        CB.u64_(0x8000_0000_0000_0000);
    }
    op_fd(81);
}

fn gen_vec_intr(v: *mut ir.Value, id: ir.Intrinsic) void {
    let a = v.xs.get(0);
    let at = a.ty;
    if id == ir.IN_ANYTRUE {
        push(a);
        op_fd(83);
        return;
    }
    if id == ir.IN_ALLTRUE {
        push(a);
        let codes: [6]u64 = [99, 131, 163, 195, 163, 195];
        op_fd(@as(u64, codes[@int_cast(usize, lane_shape(at))]));
        return;
    }
    if id == ir.IN_BITMASK {
        push(a);
        let codes: [6]u64 = [100, 132, 164, 196, 164, 196];
        op_fd(@as(u64, codes[@int_cast(usize, lane_shape(at))]));
        return;
    }
    if id == ir.IN_SWIZZLE {
        push(a);
        push(v.xs.get(1));
        op_fd(14);
        return;
    }
    if id == ir.IN_DOT_I16 {
        push(a);
        push(v.xs.get(1));
        op_fd(186);
        return;
    }
    let t = v.ty;
    let sh = lane_shape(t);
    if sh >= 4 {
        gen_vec_float_intr(v, id, sh == 5);
        return;
    }
    if id == ir.IN_ABS {
        push(a);
        let codes: [4]u64 = [96, 128, 160, 192];
        op_fd(@as(u64, codes[@int_cast(usize, sh)]));
        return;
    }
    if (id == ir.IN_SMIN) or (id == ir.IN_UMIN) or (id == ir.IN_SMAX) or (id == ir.IN_UMAX) {
        gen_vec_minmax(v, id, sh);
        return;
    }
    if (id == ir.IN_SADD_SAT) or (id == ir.IN_UADD_SAT) or (id == ir.IN_SSUB_SAT) or (id == ir.IN_USUB_SAT) {
        if sh <= 1 {
            push(a);
            push(v.xs.get(1));
            let mut base: u64 = 111;
            if sh == 1 {
                base = 143;
            }
            match id {
                .UADD_SAT => { base += 1; }
                .SSUB_SAT => { base += 3; }
                .USUB_SAT => { base += 4; }
                else => {}
            }
            op_fd(base);
            return;
        }
        vec_lanewise(v);
        return;
    }
    if id == ir.IN_CTPOP {
        if sh == 0 {
            push(a);
            op_fd(98);
            return;
        }
    }
    vec_lanewise(v);
}

// A vector float intrinsic, on f64 lanes or f32 ones.
fn gen_vec_float_intr(v: *mut ir.Value, id: ir.Intrinsic, f64_: bool) void {
    let a = v.xs.get(0);
    match id {
        .FABS => {
            push(a);
            op_fd(@as(u64, u.pick(f64_, "\xec", "\xe0")[0]));
        }
        .SQRT => {
            push(a);
            op_fd(@as(u64, u.pick(f64_, "\xef", "\xe3")[0]));
        }
        .CEIL => {
            push(a);
            op_fd(@as(u64, u.pick(f64_, "\x74", "\x67")[0]));
        }
        .FLOOR => {
            push(a);
            op_fd(@as(u64, u.pick(f64_, "\x75", "\x68")[0]));
        }
        .FTRUNC => {
            push(a);
            op_fd(@as(u64, u.pick(f64_, "\x7a", "\x69")[0]));
        }
        .NEAREST => {
            push(a);
            if f64_ {
                op_fd(148);
            } else {
                op_fd(106);
            }
        }
        .FMIN, .FMAX => {
            push(a);
            push(v.xs.get(1));
            let mut c: u64 = 232;
            if f64_ {
                c = 244;
            }
            if id == ir.IN_FMAX {
                c += 1;
            }
            op_fd(c);
        }
        .FMA => { vec_fma(v); }
        else => { fail(u.f1("vector float intrinsic %s", u.idec(@int_from_enum(id)))); }
    }
}

// Integer minimum and maximum of vectors with lane shape sh.
fn gen_vec_minmax(v: *mut ir.Value, id: ir.Intrinsic, sh: i32) void {
    let a = v.xs.get(0);
    if sh == 3 {
        // i64x2: bitselect(a, b, a < b)
        let x = new_local(wo.V128);
        let y = new_local(wo.V128);
        push(a);
        local_tee(x);
        push(v.xs.get(1));
        local_tee(y);
        local_get(x);
        if (id == ir.IN_UMIN) or (id == ir.IN_UMAX) {
            flip_i64_signs();
        }
        local_get(y);
        if (id == ir.IN_UMIN) or (id == ir.IN_UMAX) {
            flip_i64_signs();
        }
        if (id == ir.IN_SMIN) or (id == ir.IN_UMIN) {
            op_fd(216);  // lt_s
        } else {
            op_fd(217);  // gt_s
        }
        op_fd(82);
        return;
    }
    push(a);
    push(v.xs.get(1));
    let base: [3]u64 = [118, 150, 182];
    let mut k: u64 = 0;
    match id {
        .UMIN => { k = 1; }
        .SMAX => { k = 2; }
        .UMAX => { k = 3; }
        else => {}
    }
    op_fd(@as(u64, base[@int_cast(usize, sh)]) + k);
}

// Per-lane fallback: extract each lane, apply the scalar operation, rebuild.
fn vec_lanewise(v: *mut ir.Value) void {
    let t = v.ty;
    let n = @as(u64, @bit_cast(u32, t.lanes));
    let lt = t.elem;
    let xs = u.newn.[u32](v.xs.len + 1);
    for i in 0..v.xs.len {
        xs[i] = new_local(wo.V128);
        push(v.xs.get(i));
        local_set(xs[i]);
    }
    let r = new_local(wo.V128);
    op_fd(12);
    CB.zeros(16);
    local_set(r);
    // the scalar intrinsic over lane values held in locals (as pseudo
    // parameters: a parameter's index is its local)
    for lane in @as(u64, 0)..n {
        local_get(r);
        let ls = u.newn.[*mut ir.Value](v.xs.len + 1);
        for i in 0..v.xs.len {
            let tl = new_local(vt(lt));
            local_get(xs[i]);
            extract_lane(t, lane, false);
            local_set(tl);
            let pv = ir.new_param(F, lt, @as(usize, tl));
            ls[i] = pv;
        }
        let fake = ir.new_inst(F, ir.OP_INTR, lt);
        fake.cv = v.cv;
        for i in 0..v.xs.len {
            ir.push_x(fake, ls[i]);
        }
        fake.flag = FL_INLINE;
        gen_intr(fake);
        replace_lane(t, lane);
        local_set(r);
    }
    local_get(r);
}

fn vec_fma(v: *mut ir.Value) void {
    vec_lanewise(v);
}

fn gen_shuffle(v: *mut ir.Value) void {
    push(v.a);
    push(v.b);
    let lb = @int_cast(usize, v.a.ty.elem.size);
    op_fd(13);
    for i in 0..ir.mask_of(v).len {
        let m = ir.mask_of(v)[i];
        for k in 0..lb {
            let mut idx = @int_cast(usize, m) * lb + k;
            if m < 0 {
                idx = 0;
            }
            CB.u8_(@truncate(u8, idx));
        }
    }
}
