// =============================================================================
// parser.ax - LL(1) recursive-descent parser.
// =============================================================================
import "ast.ax" as ast;
import "diag.ax" as dg;
import "lexer.ax" as lx;
import "util.ax" as u;

struct Parser {
    f: *mut u.SourceFile,
    t: []mut lx.Token,
    pos: usize,
    n: usize,
    mod: *mut ast.Module,
    errors_at_pos: i64,  // suppress cascades: last position we reported at
    ntests: i32,         // test blocks so far (their symbol names are per module)
}

fn peek(P: *Parser) *mut lx.Token {
    return &mut P.t[P.pos];
}

fn peek2(P: *Parser) *mut lx.Token {
    if (P.pos + 1) < P.n {
        return &mut P.t[P.pos + 1];
    }
    return &mut P.t[P.n - 1];
}

fn peek3(P: *Parser) *mut lx.Token {
    if (P.pos + 2) < P.n {
        return &mut P.t[P.pos + 2];
    }
    return &mut P.t[P.n - 1];
}

fn pk(P: *Parser) i32 {
    return P.t[P.pos].kind;
}

fn advance(P: *mut Parser) *mut lx.Token {
    let t = &mut P.t[P.pos];
    if P.pos < (P.n - 1) {
        P.pos += 1;
    }
    return t;
}

fn accept(P: *mut Parser, k: i32) bool {
    if pk(P) == k {
        _ = advance(P);
        return true;
    }
    return false;
}

fn prev_span(P: *Parser) u.Span {
    if P.pos > 0 {
        return P.t[P.pos - 1].span;
    }
    return P.t[0].span;
}

fn syntax_error(P: *mut Parser, what: []u8) void {
    if P.errors_at_pos == @int_cast(i64, P.pos) {
        return;
    }
    P.errors_at_pos = @int_cast(i64, P.pos);
    let t = peek(P);
    _ = dg.err(t.span, "E0100", u.f2("expected %s, found '%s'", what, lx.tok_kind_name(t.kind)));
}

fn expect(P: *mut Parser, k: i32) *mut lx.Token {
    if pk(P) == k {
        return advance(P);
    }
    syntax_error(P, u.f1("'%s'", lx.tok_kind_name(k)));
    return peek(P);
}

struct Ident {
    name: []u8,
    span: u.Span,
}

fn expect_ident(P: *mut Parser) Ident {
    let t = peek(P);
    if t.kind == lx.TK_IDENT {
        _ = advance(P);
        return Ident.{ name: t.name, span: t.span };
    }
    let sp = t.span;
    if (t.kind == lx.TK_PRIM) or ((t.kind >= lx.KW_AND) and (t.kind <= lx.KW_WHILE)) {
        // An identifier-like word that is reserved: consume it so parsing can continue.
        let mut w = lx.tok_kind_name(t.kind);
        if t.kind == lx.TK_PRIM {
            w = lx.prim_name(@int_cast(usize, t.prim));
        }
        _ = dg.err(t.span, "E0104", u.f2("'%s' is a reserved %s and cannot be used as a name", w,
                                         u.pick(t.kind == lx.TK_PRIM, "type name", "keyword")));
        P.errors_at_pos = @int_cast(i64, P.pos);
        _ = advance(P);
        return Ident.{ name: u.intern(u.f1("<reserved %s>", w)), span: sp };
    }
    syntax_error(P, "identifier");
    return Ident.{ name: u.intern("<error>"), span: sp };
}

// Skip to a plausible statement/declaration boundary after an error.
fn sync_stmt(P: *mut Parser) void {
    let mut depth: i32 = 0;
    while pk(P) != lx.TK_EOF {
        let k = pk(P);
        if k == lx.TK_LBRACE {
            depth += 1;
        }
        if k == lx.TK_RBRACE {
            if depth == 0 {
                return;
            }
            depth -= 1;
        }
        _ = advance(P);
        if (k == lx.TK_SEMI) and (depth == 0) {
            return;
        }
    }
}

fn sp_from(P: *Parser, start: u.Span) u.Span {
    let e = prev_span(P);
    let mut r = start;
    if e.end > r.end {
        r.end = e.end;
    }
    return r;
}

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------
// `inline` is a keyword only before `fn` (spec §9.5)
fn at_inline(P: *Parser) bool {
    return (pk(P) == lx.TK_IDENT) and u.str_eq(peek(P).name, "inline") and (peek2(P).kind == lx.KW_FN);
}

fn parse_field_list(P: *mut Parser, out: *mut u.List.[ast.Field]) void {
    // Field ( "," Field )* ","?
    while (pk(P) == lx.TK_IDENT) and not at_inline(P) {
        let id = expect_ident(P);
        _ = expect(P, lx.TK_COLON);
        let te = parse_type(P);
        out.push(ast.Field.{ name: id.name, te: te, span: id.span, ty: u.nil.[ast.Type]() });
        if not accept(P, lx.TK_COMMA) {
            break;
        }
    }
}

fn parse_generic_arg_list(P: *mut Parser, out: *mut u.List.[*mut ast.TypeExpr]) void {
    // after '[' ; GenericArg ( "," GenericArg )* ","? "]"
    if pk(P) == lx.TK_RBRACKET {
        syntax_error(P, "generic argument");
    }
    while (pk(P) != lx.TK_RBRACKET) and (pk(P) != lx.TK_EOF) {
        if pk(P) == lx.TK_INT {
            let t = advance(P);
            out.push(ast.new_te(ast.TypeShape.IntLit(t.ival), t.span));
        } else {
            out.push(parse_type(P));
        }
        if not accept(P, lx.TK_COMMA) {
            break;
        }
    }
    _ = expect(P, lx.TK_RBRACKET);
}

// The named type `n`, unqualified and without arguments so far.
fn named_type(n: *lx.Token) ast.NamedType {
    return ast.NamedType.{ qual: u.nosym(), name: n.name, name_span: n.span, args: u.List.[*mut ast.TypeExpr].empty(),
                           has_args: false };
}

// An array's length, after '[': an integer literal, a name (a const or a
// const parameter, perhaps qualified), or any other constant expression.
fn parse_array_len(P: *mut Parser) *mut ast.TypeExpr {
    if (pk(P) == lx.TK_INT) and (peek2(P).kind == lx.TK_RBRACKET) {
        let n = advance(P);
        return ast.new_te(ast.TypeShape.IntLit(n.ival), n.span);
    }
    if pk(P) == lx.TK_IDENT {
        let qualified = (peek2(P).kind == lx.TK_DOT) and (peek3(P).kind == lx.TK_IDENT);
        if (peek2(P).kind == lx.TK_RBRACKET) or qualified {
            let save = P.pos;
            let n = advance(P);
            let mut nt = named_type(n);
            let mut sp = n.span;
            if qualified {
                _ = advance(P);
                let m = advance(P);
                nt.qual = nt.name;
                nt.name = m.name;
                nt.name_span = m.span;
                sp = u.span_join(n.span, m.span);
            }
            if pk(P) == lx.TK_RBRACKET {
                return ast.new_te(ast.TypeShape.Named(nt), sp);
            }
            P.pos = save;  // an expression after all
        }
    }
    if pk(P) == lx.TK_RBRACKET {
        syntax_error(P, "array length");
        return u.nil.[ast.TypeExpr]();
    }
    let e = parse_expr(P);
    return ast.new_te(ast.TypeShape.ConstExpr(e), e.span);
}

fn parse_type(P: *mut Parser) *mut ast.TypeExpr {
    let t = peek(P);
    let start = t.span;
    let k = t.kind;
    if k == lx.TK_BANG {
        _ = advance(P);
        let elem = parse_type(P);
        let eu = ast.ErrUnionType.{ set: u.nil.[ast.TypeExpr](), elem: elem };
        return ast.new_te(ast.TypeShape.ErrUnion(eu), sp_from(P, start));
    }
    if k == lx.TK_STAR {
        _ = advance(P);
        let is_mut = accept(P, lx.KW_MUT);
        let pt = ast.PtrType.{ elem: parse_type(P), is_mut: is_mut };
        return ast.new_te(ast.TypeShape.Ptr(pt), sp_from(P, start));
    }
    if k == lx.TK_LBRACKET {
        _ = advance(P);
        if accept(P, lx.TK_RBRACKET) {
            let is_mut = accept(P, lx.KW_MUT);
            let pt = ast.PtrType.{ elem: parse_type(P), is_mut: is_mut };
            return ast.new_te(ast.TypeShape.Slice(pt), sp_from(P, start));
        }
        let len = parse_array_len(P);
        _ = expect(P, lx.TK_RBRACKET);
        let at = ast.ArrayType.{ elem: parse_type(P), len: len };
        return ast.new_te(ast.TypeShape.Array(at), sp_from(P, start));
    }
    if k == lx.KW_FN {
        _ = advance(P);
        let mut ps = u.List.[*mut ast.TypeExpr].empty();
        _ = expect(P, lx.TK_LPAREN);
        while (pk(P) != lx.TK_RPAREN) and (pk(P) != lx.TK_EOF) {
            ps.push(parse_type(P));
            if not accept(P, lx.TK_COMMA) {
                break;
            }
        }
        _ = expect(P, lx.TK_RPAREN);
        let ft = ast.FnType.{ params: ps, ret: parse_type(P) };
        return ast.new_te(ast.TypeShape.Fn(ft), sp_from(P, start));
    }
    if k == lx.KW_STRUCT {
        _ = advance(P);
        let mut fields = u.List.[ast.Field].empty();
        _ = expect(P, lx.TK_LBRACE);
        parse_field_list(P, &mut fields);
        _ = expect(P, lx.TK_RBRACE);
        return ast.new_te(ast.TypeShape.AnonStruct(fields), sp_from(P, start));
    }
    if k == lx.KW_ERROR {
        _ = advance(P);
        return ast.new_te(ast.TypeShape.Error, start);
    }
    if k == lx.KW_SELF {
        _ = advance(P);
        return ast.new_te(ast.TypeShape.SelfType, start);
    }
    if k == lx.TK_PRIM {
        _ = advance(P);
        return ast.new_te(ast.TypeShape.Prim(t.prim), start);
    }
    if k == lx.TK_IDENT {
        _ = advance(P);
        let mut nt = named_type(t);
        // NamedType ::= IDENT ( "." ( IDENT GenericArgs? | "[" GenericArgList "]" ) )?
        if pk(P) == lx.TK_DOT {
            let k2 = peek2(P).kind;
            if k2 == lx.TK_IDENT {
                _ = advance(P);
                let m = advance(P);
                nt.qual = nt.name;
                nt.name = m.name;
                nt.name_span = m.span;
                if (pk(P) == lx.TK_DOT) and (peek2(P).kind == lx.TK_LBRACKET) {
                    _ = advance(P);
                    _ = advance(P);
                    nt.has_args = true;
                    parse_generic_arg_list(P, &mut nt.args);
                }
            } else if k2 == lx.TK_LBRACKET {
                _ = advance(P);
                _ = advance(P);
                nt.has_args = true;
                parse_generic_arg_list(P, &mut nt.args);
            }
        }
        let named = ast.new_te(ast.TypeShape.Named(nt), sp_from(P, start));
        // Set!T: an error union of the error set named
        if pk(P) == lx.TK_BANG {
            _ = advance(P);
            let eu = ast.ErrUnionType.{ set: named, elem: parse_type(P) };
            return ast.new_te(ast.TypeShape.ErrUnion(eu), sp_from(P, start));
        }
        return named;
    }
    syntax_error(P, "type");
    return ast.new_te(ast.TypeShape.Error, start);
}

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------
fn parse_field_inits(P: *mut Parser, e: *mut ast.Expr) void {
    // after '{'
    while pk(P) == lx.TK_IDENT {
        let id = expect_ident(P);
        _ = expect(P, lx.TK_COLON);
        let v = parse_expr(P);
        ast.ext(e).inits.push(ast.FieldInit.{ name: id.name, span: id.span, value: v });
        if not accept(P, lx.TK_COMMA) {
            break;
        }
    }
    _ = expect(P, lx.TK_RBRACE);
}

fn parse_builtin(P: *mut Parser) *mut ast.Expr {
    let t = advance(P);
    let e = ast.new_expr(ast.E_BUILTIN, t.span);
    e.name = t.name;
    let id = ast.builtin_lookup(t.name);
    if id < 0 {
        _ = dg.err(t.span, "E0120", u.f1("unknown builtin '@%s'", t.name));
    }
    ast.set_builtin(e, id);
    let mut sig: []u8 = "*";
    if id >= 0 {
        sig = ast.builtin_sig(id);
    }
    let mut si: usize = 0;
    _ = expect(P, lx.TK_LPAREN);
    while (pk(P) != lx.TK_RPAREN) and (pk(P) != lx.TK_EOF) {
        let mut kind: u8 = 'e';
        if (si < sig.len) and (sig[si] != '*') {
            kind = sig[si];
            si += 1;
        }
        let mut a = ast.BuiltinArg.{ e: u.nil.[ast.Expr](), t: u.nil.[ast.TypeExpr]() };
        if kind == 't' {
            a.t = parse_type(P);
        } else {
            a.e = parse_expr(P);
        }
        ast.ext(e).bargs.push(a);
        if not accept(P, lx.TK_COMMA) {
            break;
        }
    }
    _ = expect(P, lx.TK_RPAREN);
    e.span = sp_from(P, t.span);
    return e;
}

fn parse_primary(P: *mut Parser) *mut ast.Expr {
    let t = peek(P);
    let start = t.span;
    let k = t.kind;
    if k == lx.TK_IDENT {
        _ = advance(P);
        let e = ast.new_expr(ast.E_IDENT, start);
        e.name = t.name;
        return e;
    }
    if k == lx.KW_SELF {
        _ = advance(P);
        return ast.new_expr(ast.E_SELF, start);
    }
    if (k == lx.TK_INT) or (k == lx.TK_CHAR) {
        _ = advance(P);
        let e = ast.new_expr(ast.E_INT, start);
        ast.set_ival(e, t.ival);
        return e;
    }
    if k == lx.TK_FLOAT {
        _ = advance(P);
        let e = ast.new_expr(ast.E_FLOAT, start);
        ast.set_fval(e, t.fval);
        ast.ext(e).float_text = t.float_text;
        return e;
    }
    if k == lx.TK_STRING {
        _ = advance(P);
        let e = ast.new_expr(ast.E_STRING, start);
        ast.ext(e).str = t.str;
        return e;
    }
    if (k == lx.KW_TRUE) or (k == lx.KW_FALSE) {
        _ = advance(P);
        let e = ast.new_expr(ast.E_BOOL, start);
        e.bval = k == lx.KW_TRUE;
        return e;
    }
    if k == lx.TK_LPAREN {
        _ = advance(P);
        let e = parse_expr(P);
        _ = expect(P, lx.TK_RPAREN);
        e.parens = true;
        e.span = sp_from(P, start);
        return e;
    }
    if k == lx.TK_DOT {
        _ = advance(P);
        _ = expect(P, lx.TK_LBRACE);
        let e = ast.new_expr(ast.E_STRUCT_LIT, start);
        parse_field_inits(P, e);
        e.span = sp_from(P, start);
        return e;
    }
    if k == lx.TK_LBRACKET {
        _ = advance(P);
        let first = parse_expr(P);
        let mut e = u.nil.[ast.Expr]();
        if accept(P, lx.TK_SEMI) {
            e = ast.new_expr(ast.E_ARRAY_REPEAT, start);
            e.a = first;
            ast.set_b(e, parse_expr(P));
        } else {
            e = ast.new_expr(ast.E_ARRAY_LIT, start);
            ast.args_mut(e).push(first);
            while accept(P, lx.TK_COMMA) {
                if pk(P) == lx.TK_RBRACKET {
                    break;
                }
                ast.args_mut(e).push(parse_expr(P));
            }
        }
        _ = expect(P, lx.TK_RBRACKET);
        e.span = sp_from(P, start);
        return e;
    }
    if k == lx.KW_ERROR {
        _ = advance(P);
        _ = expect(P, lx.TK_DOT);
        let e = ast.new_expr(ast.E_ERROR_VAL, start);
        let id = expect_ident(P);
        e.name = id.name;
        ast.set_name_span(e, id.span);
        e.span = sp_from(P, start);
        return e;
    }
    if k == lx.TK_BUILTIN {
        return parse_builtin(P);
    }
    syntax_error(P, "expression");
    if (pk(P) != lx.TK_EOF) and (pk(P) != lx.TK_RBRACE) and (pk(P) != lx.TK_SEMI) {
        _ = advance(P);
    }
    return ast.new_expr(ast.E_INT, start);
}

fn parse_postfix(P: *mut Parser) *mut ast.Expr {
    let mut e = parse_primary(P);
    let start = e.span;
    loop {
        let k = pk(P);
        if k == lx.TK_DOT {
            _ = advance(P);
            let k2 = pk(P);
            if k2 == lx.TK_IDENT {
                let n = advance(P);
                let f = ast.new_expr(ast.E_FIELD, start);
                f.a = e;
                f.name = n.name;
                ast.set_name_span(f, n.span);
                e = f;
            } else if k2 == lx.TK_STAR {
                _ = advance(P);
                let d = ast.new_expr(ast.E_DEREF, start);
                d.a = e;
                e = d;
            } else if k2 == lx.TK_LBRACE {
                _ = advance(P);
                let s = ast.new_expr(ast.E_STRUCT_LIT, start);
                s.a = e;
                parse_field_inits(P, s);
                e = s;
            } else if k2 == lx.TK_LBRACKET {
                _ = advance(P);
                let ap = ast.new_expr(ast.E_APPLY, start);
                ap.a = e;
                parse_generic_arg_list(P, &mut ast.ext(ap).targs);
                e = ap;
            } else {
                syntax_error(P, "field name, '*', '{' or '[' after '.'");
                return e;
            }
        } else if k == lx.TK_LPAREN {
            _ = advance(P);
            let c = ast.new_expr(ast.E_CALL, start);
            c.a = e;
            while (pk(P) != lx.TK_RPAREN) and (pk(P) != lx.TK_EOF) {
                ast.args_mut(c).push(parse_expr(P));
                if not accept(P, lx.TK_COMMA) {
                    break;
                }
            }
            _ = expect(P, lx.TK_RPAREN);
            e = c;
        } else if k == lx.TK_LBRACKET {
            _ = advance(P);
            let mut lo = u.nil.[ast.Expr]();
            let mut hi = u.nil.[ast.Expr]();
            let mut is_slice = false;
            if accept(P, lx.TK_DOTDOT) {
                is_slice = true;
                if pk(P) != lx.TK_RBRACKET {
                    hi = parse_expr(P);
                }
            } else {
                lo = parse_expr(P);
                if accept(P, lx.TK_DOTDOT) {
                    is_slice = true;
                    if pk(P) != lx.TK_RBRACKET {
                        hi = parse_expr(P);
                    }
                }
            }
            _ = expect(P, lx.TK_RBRACKET);
            let mut xk = ast.E_INDEX;
            if is_slice {
                xk = ast.E_SLICE;
            }
            let x = ast.new_expr(xk, start);
            x.a = e;
            ast.set_b(x, lo);
            ast.set_c(x, hi);
            e = x;
        } else if k == lx.TK_BANG {
            _ = advance(P);
            let x = ast.new_expr(ast.E_TRY, start);
            x.a = e;
            e = x;
        } else {
            break;
        }
        e.span = sp_from(P, start);
    }
    return e;
}

fn parse_unary(P: *mut Parser) *mut ast.Expr {
    let t = peek(P);
    let start = t.span;
    let k = t.kind;
    if (k == lx.TK_MINUS) or (k == lx.TK_MINUS_PCT) or (k == lx.TK_TILDE) or (k == lx.KW_NOT) or (k == lx.TK_AMP) {
        _ = advance(P);
        let e = ast.new_expr(ast.E_UNARY, start);
        ast.set_op(e, k);
        if (k == lx.TK_AMP) and accept(P, lx.KW_MUT) {
            e.bval = true;  // &mut
        }
        e.a = parse_unary(P);
        e.span = sp_from(P, start);
        return e;
    }
    return parse_postfix(P);
}

// --- operator partial order (spec §7.4) ---
const F_NONE: i32 = 0;
const F_M: i32 = 1;
const F_A: i32 = 2;
const F_S: i32 = 3;
const F_BAND: i32 = 4;
const F_BOR: i32 = 5;
const F_BXOR: i32 = 6;
const F_C: i32 = 7;
const F_AND: i32 = 8;
const F_OR: i32 = 9;

fn op_family(k: i32) i32 {
    if (k == lx.TK_STAR) or (k == lx.TK_SLASH) or (k == lx.TK_PERCENT) or (k == lx.TK_STAR_PCT) {
        return F_M;
    }
    if (k == lx.TK_PLUS) or (k == lx.TK_MINUS) or (k == lx.TK_PLUS_PCT) or (k == lx.TK_MINUS_PCT) {
        return F_A;
    }
    if (k == lx.TK_SHL) or (k == lx.TK_SHR) {
        return F_S;
    }
    if k == lx.TK_AMP {
        return F_BAND;
    }
    if k == lx.TK_PIPE {
        return F_BOR;
    }
    if k == lx.TK_CARET {
        return F_BXOR;
    }
    if lx.is_compare_op(k) {
        return F_C;
    }
    if k == lx.KW_AND {
        return F_AND;
    }
    if k == lx.KW_OR {
        return F_OR;
    }
    return F_NONE;
}

fn fam_level(f: i32) i32 {
    if f == F_M {
        return 5;
    }
    if (f == F_A) or (f == F_S) or (f == F_BAND) or (f == F_BOR) or (f == F_BXOR) {
        return 4;
    }
    if f == F_C {
        return 3;
    }
    if f == F_AND {
        return 2;
    }
    if f == F_OR {
        return 1;
    }
    return 0;
}

// x binds strictly tighter than y in the partial order.
fn fam_tighter(x: i32, y: i32) bool {
    let x_arith = (x == F_M) or (x == F_A) or (x == F_S) or (x == F_BAND) or (x == F_BOR) or (x == F_BXOR);
    if (x == F_M) and (y == F_A) {
        return true;
    }
    if x_arith and (y == F_C) {
        return true;
    }
    if (x_arith or (x == F_C)) and ((y == F_AND) or (y == F_OR)) {
        return true;
    }
    return false;
}

fn fam_chainable(f: i32) bool {
    return (f != F_S) and (f != F_C) and (f != F_NONE);
}

fn check_mix(parent: *mut ast.Expr, child: *mut ast.Expr, is_left: bool) void {
    if (child.kind != ast.E_BINARY) or child.parens {
        return;
    }
    let pf = op_family(ast.op_of(parent));
    let cf = op_family(ast.op_of(child));
    if fam_tighter(cf, pf) {
        return;
    }
    if (cf == pf) and fam_chainable(pf) and is_left {
        return;
    }
    let d = dg.err(child.span, "E0150", u.f2("operators '%s' and '%s' cannot be mixed without parentheses",
                                             lx.tok_kind_name(ast.op_of(child)), lx.tok_kind_name(ast.op_of(parent))));
    let fx = dg.fix(d, "add parentheses", "machine");
    dg.edit(fx, u.mkspan(child.span.file, child.span.start, child.span.start), "(");
    dg.edit(fx, u.mkspan(child.span.file, child.span.end, child.span.end), ")");
}

fn reduce(out: *mut u.List.[*mut ast.Expr], st: *mut u.List.[i32]) void {
    let op = st.pop();
    let r = out.pop();
    let l = out.pop();
    let b = ast.new_expr(ast.E_BINARY, u.span_join(l.span, r.span));
    ast.set_op(b, op);
    b.a = l;
    ast.set_b(b, r);
    check_mix(b, l, true);
    check_mix(b, r, false);
    out.push(b);
}

fn parse_binexpr(P: *mut Parser) *mut ast.Expr {
    let first = parse_unary(P);
    if op_family(pk(P)) == F_NONE {
        return first;
    }
    let mut operands = u.List.[*mut ast.Expr].empty();
    let mut ops = u.List.[i32].empty();
    operands.push(first);
    while op_family(pk(P)) != F_NONE {
        ops.push(advance(P).kind);
        operands.push(parse_unary(P));
    }
    // shunting-yard with levels; left-associative within a level
    let mut out = u.List.[*mut ast.Expr].empty();
    let mut st = u.List.[i32].empty();
    out.push(operands.get(0));
    for i in 0..ops.len {
        let lv = fam_level(op_family(ops.get(i)));
        while (st.len > 0) and (fam_level(op_family(st.last())) >= lv) {
            reduce(&mut out, &mut st);
        }
        st.push(ops.get(i));
        out.push(operands.get(i + 1));
    }
    while st.len > 0 {
        reduce(&mut out, &mut st);
    }
    let res = out.get(0);
    out.deinit();
    st.deinit();
    operands.deinit();
    ops.deinit();
    return res;
}

fn parse_expr(P: *mut Parser) *mut ast.Expr {
    let e = parse_binexpr(P);
    if pk(P) != lx.KW_CATCH {
        return e;
    }
    let start = e.span;
    if (e.kind == ast.E_BINARY) and not e.parens {
        let d = dg.err(e.span, "E0150", u.f1("'catch' applies to the whole expression '... %s ...'; add parentheses",
                                             lx.tok_kind_name(ast.op_of(e))));
        let fx = dg.fix(d, "catch only the right operand", "suggestion");
        dg.edit(fx, u.mkspan(ast.b_of(e).span.file, ast.b_of(e).span.start, ast.b_of(e).span.start), "(");
    }
    _ = advance(P);
    let c = ast.new_expr(ast.E_CATCH, start);
    c.a = e;
    if accept(P, lx.TK_PIPE) {
        let id = expect_ident(P);
        ast.ext(c).capture = id.name;
        ast.ext(c).capture_span = id.span;
        _ = expect(P, lx.TK_PIPE);
    }
    let k = pk(P);
    if k == lx.KW_RETURN {
        _ = advance(P);
        let mut v = u.nil.[ast.Expr]();
        let k2 = pk(P);
        if (k2 != lx.TK_SEMI) and (k2 != lx.TK_RPAREN) and (k2 != lx.TK_COMMA) and (k2 != lx.TK_RBRACE) {
            v = parse_expr(P);
        }
        ast.ext(c).handler = ast.Handler.Return(v);
    } else if (k == lx.KW_BREAK) or (k == lx.KW_CONTINUE) {
        _ = advance(P);
        if k == lx.KW_BREAK {
            ast.ext(c).handler = ast.Handler.Break;
        } else {
            ast.ext(c).handler = ast.Handler.Continue;
        }
        if pk(P) == lx.TK_IDENT {
            let id = advance(P);  // the label of the loop to leave (name, as for an identifier)
            c.name = id.name;
            ast.set_name_span(c, id.span);
        }
    } else if k == lx.TK_LBRACE {
        ast.ext(c).handler = ast.Handler.Block(parse_block(P));
    } else {
        ast.ext(c).handler = ast.Handler.Value(parse_binexpr(P));
    }
    c.span = sp_from(P, start);
    return c;
}

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------
fn parse_block(P: *mut Parser) *mut ast.Stmt {
    let start = peek(P).span;
    let b = ast.new_stmt(ast.S_BLOCK, start);
    _ = expect(P, lx.TK_LBRACE);
    while (pk(P) != lx.TK_RBRACE) and (pk(P) != lx.TK_EOF) {
        let before = P.pos;
        let s = parse_stmt(P);
        if u.notnil(s) {
            b.stmts.push(s);
        }
        if P.pos == before {
            _ = advance(P);  // guarantee progress
        }
    }
    _ = expect(P, lx.TK_RBRACE);
    b.span = sp_from(P, start);
    return b;
}

// ExprStmt ::= Expr ( AssignOp Expr )? ";"
fn parse_expr_stmt(P: *mut Parser) *mut ast.Stmt {
    let start = peek(P).span;
    let e = parse_expr(P);
    let mut s = u.nil.[ast.Stmt]();
    if lx.is_assign_op(pk(P)) {
        s = ast.new_stmt(ast.S_ASSIGN, start);
        s.op = advance(P).kind;
        s.e = e;
        s.e2 = parse_expr(P);
    } else {
        s = ast.new_stmt(ast.S_EXPR, start);
        s.e = e;
    }
    if not accept(P, lx.TK_SEMI) {
        syntax_error(P, "';'");
        sync_stmt(P);
    }
    s.span = sp_from(P, start);
    return s;
}

// Pattern ::= "." IDENT ( "(" IDENT ")" )? | "error" "." IDENT | "-"? INT_LIT | CHAR_LIT
//           | "true" | "false" | "else"
fn parse_pattern(P: *mut Parser, arm: *mut ast.MatchArm, allow_else: bool) bool {
    arm.span = peek(P).span;
    if accept(P, lx.TK_DOT) {
        let mut vp = ast.VariantPattern.{ name: expect_ident(P).name, bind: u.nosym(), bind_span: u.mkspan(0, 0, 0) };
        if accept(P, lx.TK_LPAREN) {
            let id = expect_ident(P);
            vp.bind = id.name;
            vp.bind_span = id.span;
            _ = expect(P, lx.TK_RPAREN);
        }
        arm.pat = ast.Pattern.Variant(vp);
    } else if accept(P, lx.KW_ERROR) {
        _ = expect(P, lx.TK_DOT);
        arm.pat = ast.Pattern.Error(expect_ident(P).name);
    } else if (pk(P) == lx.TK_MINUS) or (pk(P) == lx.TK_INT) or (pk(P) == lx.TK_CHAR) {
        let neg = accept(P, lx.TK_MINUS);
        let mut v = u.I128.zero();
        let n = peek(P);
        if (n.kind == lx.TK_INT) or (n.kind == lx.TK_CHAR) {
            _ = advance(P);
            v = u.I128.ofu(n.ival);
            if neg {
                v = v.neg();
            }
        } else {
            syntax_error(P, "integer literal");
        }
        arm.pat = ast.Pattern.Int(v);
    } else if (pk(P) == lx.KW_TRUE) or (pk(P) == lx.KW_FALSE) {
        arm.pat = ast.Pattern.Bool(advance(P).kind == lx.KW_TRUE);
    } else if allow_else and accept(P, lx.KW_ELSE) {
        arm.pat = ast.Pattern.Else;
    } else {
        syntax_error(P, "match pattern");
        return false;
    }
    arm.span = sp_from(P, arm.span);
    return true;
}

// Pattern ( "," Pattern )*, one arm per pattern (all but the first `alt`);
// `else` only alone. False after a syntax error.
fn parse_arm_patterns(P: *mut Parser, s: *mut ast.Stmt, allow_else: bool) bool {
    let first = ast.stmt_more(s).arms.len;
    let arm = u.new.[ast.MatchArm]();
    if not parse_pattern(P, arm, allow_else) {
        return false;
    }
    ast.stmt_ext(s).arms.push(arm.*);
    if arm.is_else() {
        return true;
    }
    while accept(P, lx.TK_COMMA) {
        let alt = u.new.[ast.MatchArm]();
        alt.alt = true;
        if not parse_pattern(P, alt, false) {
            ast.stmt_ext(s).arms.len = first;  // (the arm is dropped)
            return false;
        }
        ast.stmt_ext(s).arms.push(alt.*);
    }
    return true;
}

// The body of the arm just parsed, and of its other patterns.
fn set_arm_body(s: *mut ast.Stmt, body: *mut ast.Stmt) void {
    let mut i = ast.stmt_more(s).arms.len;
    while i > 0 {
        i -= 1;
        ast.stmt_more(s).arms.at(i).body = body;
        if not ast.stmt_more(s).arms.at(i).alt {
            break;
        }
    }
}

// if let Pattern ( "," Pattern )* = Expr Block ( else ( IfStmt | Block ) )?
// is `match Expr { Pattern => Block, else => ... }`.
fn parse_if_let(P: *mut Parser, start: u.Span) *mut ast.Stmt {
    _ = expect(P, lx.KW_LET);
    let s = ast.new_stmt(ast.S_MATCH, start);
    if not parse_arm_patterns(P, s, false) {
        sync_stmt(P);
        return u.nil.[ast.Stmt]();
    }
    _ = expect(P, lx.TK_EQ);
    s.e = parse_expr(P);
    set_arm_body(s, parse_block(P));
    let els = u.new.[ast.MatchArm]();
    els.pat = ast.Pattern.Else;
    els.span = peek(P).span;
    if accept(P, lx.KW_ELSE) {
        if pk(P) == lx.KW_IF {
            let sp = peek(P).span;
            let inner = parse_if(P);
            if u.notnil(inner) {
                els.body = ast.new_stmt(ast.S_BLOCK, inner.span);
                els.body.stmts.push(inner);
            } else {
                els.body = ast.new_stmt(ast.S_BLOCK, sp);
            }
        } else {
            els.body = parse_block(P);
        }
    } else {
        els.body = ast.new_stmt(ast.S_BLOCK, els.span);
    }
    ast.stmt_ext(s).arms.push(els.*);
    s.span = sp_from(P, start);
    return s;
}

fn parse_if(P: *mut Parser) *mut ast.Stmt {
    let start = advance(P).span;
    if pk(P) == lx.KW_LET {
        return parse_if_let(P, start);
    }
    let s = ast.new_stmt(ast.S_IF, start);
    s.e = parse_expr(P);
    s.body = parse_block(P);
    if accept(P, lx.KW_ELSE) {
        if pk(P) == lx.KW_IF {
            s.els = parse_if(P);
        } else {
            s.els = parse_block(P);
        }
    }
    s.span = sp_from(P, start);
    return s;
}

fn parse_stmt(P: *mut Parser) *mut ast.Stmt {
    let t = peek(P);
    let start = t.span;
    let k = t.kind;
    if (k == lx.TK_IDENT) and (peek2(P).kind == lx.TK_COLON) {
        // a loop label: `name: while|loop|for`
        let k3 = peek3(P).kind;
        if (k3 == lx.KW_WHILE) or (k3 == lx.KW_LOOP) or (k3 == lx.KW_FOR) {
            let id = advance(P);
            _ = advance(P);
            let s = parse_stmt(P);
            ast.stmt_ext(s).label = id.name;
            ast.stmt_ext(s).label_span = id.span;
            s.span = sp_from(P, start);
            return s;
        }
    }
    if k == lx.KW_LET {
        _ = advance(P);
        let s = ast.new_stmt(ast.S_LET, start);
        s.is_mut = accept(P, lx.KW_MUT);
        let id = expect_ident(P);
        s.name = id.name;
        s.name_span = id.span;
        if accept(P, lx.TK_COLON) {
            s.te = parse_type(P);
        }
        _ = expect(P, lx.TK_EQ);
        // `undefined` (contextual) as the whole initializer: the variable's bytes left
        // unspecified until written
        s.undef = (peek(P).kind == lx.TK_IDENT) and u.str_eq(peek(P).name, "undefined") and
                  (peek2(P).kind == lx.TK_SEMI);
        s.e = parse_expr(P);
        if not accept(P, lx.TK_SEMI) {
            syntax_error(P, "';'");
            sync_stmt(P);
        }
        s.span = sp_from(P, start);
        return s;
    }
    if k == lx.KW_IF {
        return parse_if(P);
    }
    if k == lx.KW_WHILE {
        _ = advance(P);
        let s = ast.new_stmt(ast.S_WHILE, start);
        s.e = parse_expr(P);
        s.body = parse_block(P);
        s.span = sp_from(P, start);
        return s;
    }
    if k == lx.KW_LOOP {
        _ = advance(P);
        let s = ast.new_stmt(ast.S_LOOP, start);
        s.body = parse_block(P);
        s.span = sp_from(P, start);
        return s;
    }
    if k == lx.KW_FOR {
        _ = advance(P);
        let s = ast.new_stmt(ast.S_FOR, start);
        let id = expect_ident(P);
        s.name = id.name;
        s.name_span = id.span;
        _ = expect(P, lx.KW_IN);
        s.e = parse_expr(P);
        if accept(P, lx.TK_DOTDOT) {
            s.e2 = parse_expr(P);
        }
        s.body = parse_block(P);
        s.span = sp_from(P, start);
        return s;
    }
    if k == lx.KW_MATCH {
        _ = advance(P);
        let s = ast.new_stmt(ast.S_MATCH, start);
        s.e = parse_expr(P);
        _ = expect(P, lx.TK_LBRACE);
        while (pk(P) != lx.TK_RBRACE) and (pk(P) != lx.TK_EOF) {
            if not parse_arm_patterns(P, s, true) {
                sync_stmt(P);
                break;
            }
            _ = expect(P, lx.TK_FATARROW);
            set_arm_body(s, parse_block(P));
            _ = accept(P, lx.TK_COMMA);
        }
        _ = expect(P, lx.TK_RBRACE);
        s.span = sp_from(P, start);
        return s;
    }
    if k == lx.KW_RETURN {
        _ = advance(P);
        let s = ast.new_stmt(ast.S_RETURN, start);
        if pk(P) != lx.TK_SEMI {
            s.e = parse_expr(P);
        }
        _ = expect(P, lx.TK_SEMI);
        s.span = sp_from(P, start);
        return s;
    }
    if (k == lx.KW_BREAK) or (k == lx.KW_CONTINUE) {
        _ = advance(P);
        let mut sk = ast.S_CONTINUE;
        if k == lx.KW_BREAK {
            sk = ast.S_BREAK;
        }
        let s = ast.new_stmt(sk, start);
        if pk(P) == lx.TK_IDENT {
            let id = advance(P);  // the label of the loop to leave
            ast.stmt_ext(s).label = id.name;
            ast.stmt_ext(s).label_span = id.span;
        }
        _ = expect(P, lx.TK_SEMI);
        s.span = sp_from(P, start);
        return s;
    }
    if (k == lx.KW_DEFER) or (k == lx.KW_ERRDEFER) {
        _ = advance(P);
        let s = ast.new_stmt(ast.S_DEFER, start);
        ast.stmt_ext(s).on_error = k == lx.KW_ERRDEFER;
        if pk(P) == lx.TK_LBRACE {
            s.body = parse_block(P);
        } else {
            s.body = parse_expr_stmt(P);
        }
        s.span = sp_from(P, start);
        return s;
    }
    if k == lx.TK_DISCARD {
        _ = advance(P);
        let s = ast.new_stmt(ast.S_DISCARD, start);
        _ = expect(P, lx.TK_EQ);
        s.e = parse_expr(P);
        _ = expect(P, lx.TK_SEMI);
        s.span = sp_from(P, start);
        return s;
    }
    if k == lx.TK_LBRACE {
        return parse_block(P);
    }
    return parse_expr_stmt(P);
}

// ---------------------------------------------------------------------------
// Declarations
// ---------------------------------------------------------------------------
// ErrorDecl ::= "pub"? "error" ( "{" ErrorNames "}"
//                              | IDENT "{" ErrorNames "}"
//                              | IDENT "=" ErrorTerm ( "|" ErrorTerm )* ";" )
// ErrorTerm ::= "{" ErrorNames "}" | IDENT ( "." IDENT )?
fn parse_error_decl(P: *mut Parser, start: u.Span, is_pub: bool) *mut ast.Decl {
    _ = expect(P, lx.KW_ERROR);
    let d = new_decl(P, ast.D_ERROR, start);
    d.is_pub = is_pub;
    if pk(P) == lx.TK_IDENT {
        let id = expect_ident(P);
        d.name = id.name;
        d.name_span = id.span;
        if accept(P, lx.TK_EQ) {
            loop {
                if pk(P) == lx.TK_LBRACE {
                    parse_error_names(P, d);
                } else {
                    let n = peek(P);
                    let rid = expect_ident(P);
                    let mut nt = ast.NamedType.{ qual: u.nosym(), name: rid.name, name_span: rid.span,
                                                 args: u.List.[*mut ast.TypeExpr].empty(), has_args: false };
                    if accept(P, lx.TK_DOT) {
                        let m = expect_ident(P);
                        nt.qual = nt.name;
                        nt.name = m.name;
                        nt.name_span = m.span;
                    }
                    d.error_refs.push(ast.new_te(ast.TypeShape.Named(nt), sp_from(P, n.span)));
                }
                if not accept(P, lx.TK_PIPE) {
                    break;
                }
            }
            _ = expect(P, lx.TK_SEMI);
            d.span = sp_from(P, start);
            return d;
        }
    }
    parse_error_names(P, d);
    d.span = sp_from(P, start);
    return d;
}

// "{" IDENT ( "," IDENT )* ","? "}"
fn parse_error_names(P: *mut Parser, d: *mut ast.Decl) void {
    _ = expect(P, lx.TK_LBRACE);
    while pk(P) == lx.TK_IDENT {
        let id = expect_ident(P);
        d.error_names.push(id.name);
        d.error_spans.push(id.span);
        if not accept(P, lx.TK_COMMA) {
            break;
        }
    }
    _ = expect(P, lx.TK_RBRACE);
}

fn new_decl(P: *Parser, k: ast.DeclKind, sp: u.Span) *mut ast.Decl {
    let d = u.new.[ast.Decl]();
    d.kind = k;
    d.span = sp;
    d.module = P.mod;
    return d;
}

fn parse_generic_params(P: *mut Parser, d: *mut ast.Decl) void {
    if not accept(P, lx.TK_LBRACKET) {
        return;
    }
    while (pk(P) != lx.TK_RBRACKET) and (pk(P) != lx.TK_EOF) {
        let g = u.new.[ast.GenericParam]();
        if accept(P, lx.KW_CONST) {
            g.is_const = true;
            let id = expect_ident(P);
            g.name = id.name;
            g.span = id.span;
            _ = expect(P, lx.TK_COLON);
            g.const_te = parse_type(P);
        } else {
            let id = expect_ident(P);
            g.name = id.name;
            g.span = id.span;
            if accept(P, lx.TK_COLON) {
                let c = expect_ident(P);
                g.constraint = c.name;
                g.constraint_span = c.span;
            }
        }
        d.gparams.push(g.*);
        if not accept(P, lx.TK_COMMA) {
            break;
        }
    }
    _ = expect(P, lx.TK_RBRACKET);
}

fn parse_params(P: *mut Parser, d: *mut ast.Decl) void {
    _ = expect(P, lx.TK_LPAREN);
    while (pk(P) != lx.TK_RPAREN) and (pk(P) != lx.TK_EOF) {
        if pk(P) == lx.TK_ELLIPSIS {  // C varargs; only valid in extern "C" (checked by sema)
            d.variadic = true;
            d.abi_span = advance(P).span;
            break;
        }
        let id = expect_ident(P);
        _ = expect(P, lx.TK_COLON);
        let te = parse_type(P);
        d.params.push(ast.Param.{ name: id.name, span: id.span, te: te, local: u.nil.[ast.Local]() });
        if not accept(P, lx.TK_COMMA) {
            break;
        }
    }
    _ = expect(P, lx.TK_RPAREN);
}

fn parse_fn(P: *mut Parser, start: u.Span, is_pub: bool, is_export: bool) *mut ast.Decl {
    _ = expect(P, lx.KW_FN);
    let d = new_decl(P, ast.D_FN, start);
    d.is_pub = is_pub;
    d.is_export = is_export;
    let id = expect_ident(P);
    d.name = id.name;
    d.name_span = id.span;
    parse_generic_params(P, d);
    parse_params(P, d);
    if pk(P) == lx.TK_LBRACE {
        let sp = peek(P).span;
        let dgn = dg.err(sp, "E0301", "missing return type (write 'void' if the function returns nothing)");
        let fx = dg.fix(dgn, "declare a void return type", "suggestion");
        dg.edit(fx, u.mkspan(sp.file, sp.start, sp.start), "void ");
    } else {
        d.ret_te = parse_type(P);
    }
    while pk(P) == lx.TK_BUILTIN {
        parse_fn_attr(P, d);
    }
    d.body = parse_block(P);
    d.span = sp_from(P, start);
    return d;
}

fn parse_fn_inline(P: *mut Parser, start: u.Span, is_pub: bool, is_export: bool) *mut ast.Decl {
    let is = peek(P).span;
    let inl = at_inline(P);
    if inl {
        _ = advance(P);
    }
    let d = parse_fn(P, start, is_pub, is_export);
    d.is_inline = inl;
    d.inline_span = is;
    return d;
}

// FnAttr ::= ( "@features" | "@multiversion" ) "(" STRING_LIT ( "," STRING_LIT )* ","? ")"
fn parse_fn_attr(P: *mut Parser, d: *mut ast.Decl) void {
    let t = advance(P);
    let mut kind = ast.ATTR_NONE;
    if u.str_eq(t.name, "features") {
        kind = ast.ATTR_FEATURES;
    } else if u.str_eq(t.name, "multiversion") {
        kind = ast.ATTR_MULTIVERSION;
    } else {
        _ = dg.err(t.span, "E0829", u.f1("unknown function attribute '@%s' (expected @features or @multiversion)",
                                         t.name));
    }
    if (kind != ast.ATTR_NONE) and (d.attr != ast.ATTR_NONE) {
        _ = dg.err(t.span, "E0829", "a function has at most one attribute (@features or @multiversion)");
        kind = ast.ATTR_NONE;
    }
    if kind != ast.ATTR_NONE {
        d.attr = kind;
        d.attr_span = t.span;
    }
    _ = expect(P, lx.TK_LPAREN);
    while pk(P) == lx.TK_STRING {
        let s = advance(P);
        if kind != ast.ATTR_NONE {
            d.attr_args.push(s.str);
            d.attr_arg_spans.push(s.span);
        }
        if not accept(P, lx.TK_COMMA) {
            break;
        }
    }
    if pk(P) != lx.TK_RPAREN {
        syntax_error(P, "a string (the extensions)");
    }
    _ = expect(P, lx.TK_RPAREN);
    if kind != ast.ATTR_NONE {
        d.attr_span = sp_from(P, t.span);
    }
}

fn new_variant(name: []u8, span: u.Span) ast.Variant {
    return ast.Variant.{ name: name, span: span, te: u.nil.[ast.TypeExpr](), ty: u.nil.[ast.Type](), has_value: false,
                         value: u.I128.zero(), value_span: span };
}

fn parse_methods(P: *mut Parser, owner: *mut ast.Decl) void {
    while (pk(P) == lx.KW_PUB) or (pk(P) == lx.KW_FN) or at_inline(P) {
        let ms = peek(P).span;
        let mp = accept(P, lx.KW_PUB);
        let m = parse_fn_inline(P, ms, mp, false);
        m.owner = owner;
        owner.methods.push(m);
    }
}

fn is_trap_code(c: []u8) bool {
    return (c.len == 5) and (c[0] == 'T') and u.is_digit(c[1]) and u.is_digit(c[2]) and u.is_digit(c[3]) and
           u.is_digit(c[4]);
}

fn parse_top(P: *mut Parser) void {
    let t = peek(P);
    let start = t.span;
    let mdecls = &mut P.mod.decls;
    if t.kind == lx.KW_IMPORT {
        _ = advance(P);
        if accept(P, lx.KW_HOST) {
            let mut modname = u.intern("env");
            if pk(P) == lx.TK_STRING {
                let s = advance(P);
                modname = u.intern(s.str);
            }
            _ = expect(P, lx.TK_LBRACE);
            while pk(P) == lx.KW_FN {
                let fs = advance(P).span;
                let d = new_decl(P, ast.D_HOST_FN, fs);
                d.host_module = modname;
                let id = expect_ident(P);
                d.name = id.name;
                d.name_span = id.span;
                parse_params(P, d);
                d.ret_te = parse_type(P);
                _ = expect(P, lx.TK_SEMI);
                d.span = sp_from(P, fs);
                mdecls.push(d);
            }
            _ = expect(P, lx.TK_RBRACE);
            return;
        }
        let d = new_decl(P, ast.D_IMPORT, start);
        let s = expect(P, lx.TK_STRING);
        if s.kind == lx.TK_STRING {
            d.import_path = u.intern(s.str);
            d.import_path_span = s.span;
        }
        _ = expect(P, lx.KW_AS);
        let id = expect_ident(P);
        d.name = id.name;
        d.name_span = id.span;
        _ = expect(P, lx.TK_SEMI);
        d.span = sp_from(P, start);
        mdecls.push(d);
        return;
    }
    if t.kind == lx.KW_ERROR {
        mdecls.push(parse_error_decl(P, start, false));
        return;
    }
    if t.kind == lx.KW_TEST {
        // TestDecl ::= "test" STRING_LIT ( "expect" "trap" ( "(" IDENT ")" )? )? Block
        _ = advance(P);
        let d = new_decl(P, ast.D_FN, start);
        d.is_test = true;
        d.test_trap = -1;
        let nm = expect(P, lx.TK_STRING);
        if nm.kind == lx.TK_STRING {
            d.test_name = u.intern(nm.str);
        } else {
            d.test_name = u.intern("?");
        }
        d.name = u.intern(u.f1("test.%s", u.idec(P.ntests)));
        P.ntests += 1;
        d.name_span = nm.span;
        if (pk(P) == lx.TK_IDENT) and u.str_eq(peek(P).name, "expect") {
            _ = advance(P);
            let tr = peek(P);
            if (tr.kind == lx.TK_IDENT) and u.str_eq(tr.name, "trap") {
                _ = advance(P);
            } else {
                syntax_error(P, "'trap' after 'expect'");
            }
            d.test_trap = -2;
            if accept(P, lx.TK_LPAREN) {
                let code = peek(P);
                if code.kind == lx.TK_IDENT {
                    _ = advance(P);
                    let c = code.name;
                    let mut v: i64 = -1;
                    if is_trap_code(c) {
                        v = u.atol(c[1..]);
                    }
                    if (v < 0) or (v > 13) {
                        _ = dg.err(code.span, "E0311", u.f1("unknown trap code '%s' (expected T0000 ... T0013)", c));
                    } else {
                        d.test_trap = @int_cast(i32, v);
                    }
                } else {
                    syntax_error(P, "trap code such as T0001");
                }
                _ = expect(P, lx.TK_RPAREN);
            }
        }
        let v = ast.new_te(ast.TypeShape.Prim(lx.PRIM_VOID), start);
        d.ret_te = ast.new_te(ast.TypeShape.ErrUnion(ast.ErrUnionType.{ set: u.nil.[ast.TypeExpr](), elem: v }), start);
        d.body = parse_block(P);
        d.span = sp_from(P, start);
        mdecls.push(d);
        return;
    }
    if t.kind == lx.KW_EXPORT {
        _ = advance(P);
        if (pk(P) != lx.KW_FN) and not at_inline(P) {
            syntax_error(P, "'fn' after 'export'");
            sync_stmt(P);
            return;
        }
        mdecls.push(parse_fn_inline(P, start, false, true));
        return;
    }
    let is_pub = accept(P, lx.KW_PUB);
    if pk(P) == lx.KW_ERROR {
        mdecls.push(parse_error_decl(P, start, is_pub));
        return;
    }
    if pk(P) == lx.KW_EXTERN {
        // ExternDecl ::= "pub"? "extern" STRING_LIT STRING_LIT? "{" ExternFn* "}"
        _ = advance(P);
        let abi = expect(P, lx.TK_STRING);
        let mut abi_s = u.intern("C");
        if abi.kind == lx.TK_STRING {
            abi_s = u.intern(abi.str);
        }
        let mut lib = u.nosym();
        if pk(P) == lx.TK_STRING {
            let l = advance(P);
            lib = u.intern(l.str);
        }
        _ = expect(P, lx.TK_LBRACE);
        while pk(P) == lx.KW_FN {
            let fs = advance(P).span;
            let d = new_decl(P, ast.D_HOST_FN, fs);
            d.extern_c = true;
            d.is_pub = is_pub;
            d.abi = abi_s;
            d.abi_span = abi.span;
            d.link_lib = lib;
            let id = expect_ident(P);
            d.name = id.name;
            d.name_span = id.span;
            parse_params(P, d);
            d.ret_te = parse_type(P);
            _ = expect(P, lx.TK_SEMI);
            d.span = sp_from(P, fs);
            mdecls.push(d);
        }
        _ = expect(P, lx.TK_RBRACE);
        return;
    }
    let k = pk(P);
    if (k == lx.KW_FN) or at_inline(P) {
        mdecls.push(parse_fn_inline(P, start, is_pub, false));
        return;
    }
    if k == lx.KW_STRUCT {
        _ = advance(P);
        let d = new_decl(P, ast.D_STRUCT, start);
        d.is_pub = is_pub;
        let id = expect_ident(P);
        d.name = id.name;
        d.name_span = id.span;
        parse_generic_params(P, d);
        _ = expect(P, lx.TK_LBRACE);
        parse_field_list(P, &mut d.fields);
        parse_methods(P, d);
        _ = expect(P, lx.TK_RBRACE);
        d.span = sp_from(P, start);
        mdecls.push(d);
        return;
    }
    if k == lx.KW_UNION {
        _ = advance(P);
        let d = new_decl(P, ast.D_UNION, start);
        d.is_pub = is_pub;
        let id = expect_ident(P);
        d.name = id.name;
        d.name_span = id.span;
        parse_generic_params(P, d);
        _ = expect(P, lx.TK_LBRACE);
        while (pk(P) == lx.TK_IDENT) and not at_inline(P) {
            let vid = expect_ident(P);
            let mut v = new_variant(vid.name, vid.span);
            if accept(P, lx.TK_COLON) {
                v.te = parse_type(P);
            }
            d.variants.push(v);
            if not accept(P, lx.TK_COMMA) {
                break;
            }
        }
        parse_methods(P, d);
        _ = expect(P, lx.TK_RBRACE);
        d.span = sp_from(P, start);
        mdecls.push(d);
        return;
    }
    if k == lx.KW_ENUM {
        _ = advance(P);
        let d = new_decl(P, ast.D_ENUM, start);
        d.is_pub = is_pub;
        let id = expect_ident(P);
        d.name = id.name;
        d.name_span = id.span;
        if accept(P, lx.TK_COLON) {
            d.te = parse_type(P);
        }
        _ = expect(P, lx.TK_LBRACE);
        while (pk(P) == lx.TK_IDENT) and not at_inline(P) {
            let vid = expect_ident(P);
            let mut v = new_variant(vid.name, vid.span);
            if accept(P, lx.TK_EQ) {
                let vs = peek(P).span;
                let neg = accept(P, lx.TK_MINUS);
                let n = peek(P);
                if (n.kind == lx.TK_INT) or (n.kind == lx.TK_CHAR) {
                    _ = advance(P);
                    v.has_value = true;
                    v.value = u.I128.ofu(n.ival);
                    if neg {
                        v.value = v.value.neg();
                    }
                } else {
                    syntax_error(P, "integer literal");
                }
                v.value_span = sp_from(P, vs);
            }
            d.variants.push(v);
            if not accept(P, lx.TK_COMMA) {
                break;
            }
        }
        parse_methods(P, d);
        _ = expect(P, lx.TK_RBRACE);
        d.span = sp_from(P, start);
        mdecls.push(d);
        return;
    }
    if k == lx.KW_CONST {
        _ = advance(P);
        let d = new_decl(P, ast.D_CONST, start);
        d.is_pub = is_pub;
        let id = expect_ident(P);
        d.name = id.name;
        d.name_span = id.span;
        _ = expect(P, lx.TK_COLON);
        d.te = parse_type(P);
        _ = expect(P, lx.TK_EQ);
        d.init = parse_expr(P);
        _ = expect(P, lx.TK_SEMI);
        d.span = sp_from(P, start);
        mdecls.push(d);
        return;
    }
    // `threadlocal` is a keyword only here, before a module-level `let`
    let tls = (k == lx.TK_IDENT) and u.str_eq(peek(P).name, "threadlocal") and (peek2(P).kind == lx.KW_LET);
    if (k == lx.KW_LET) or tls {
        if tls {
            _ = advance(P);
        }
        _ = advance(P);
        let d = new_decl(P, ast.D_GLOBAL, start);
        d.is_pub = is_pub;
        d.is_tls = tls;
        d.is_mut = accept(P, lx.KW_MUT);
        let id = expect_ident(P);
        d.name = id.name;
        d.name_span = id.span;
        if not accept(P, lx.TK_COLON) {
            syntax_error(P, "':' (global variables need an explicit type)");
        } else {
            d.te = parse_type(P);
        }
        _ = expect(P, lx.TK_EQ);
        d.init = parse_expr(P);
        _ = expect(P, lx.TK_SEMI);
        d.span = sp_from(P, start);
        mdecls.push(d);
        return;
    }
    syntax_error(P, "declaration");
    sync_stmt(P);
}

// Parser entry point. Returns a module with decls; errors via diag.
pub fn parse_module(f: *mut u.SourceFile) *mut ast.Module {
    let toks = lx.lex_file(f);
    let mut P = Parser.{ f: f, t: toks.items(), pos: 0, n: toks.len, mod: u.new.[ast.Module](), errors_at_pos: -1,
                         ntests: 0 };
    P.mod.file = f;
    while pk(&P) != lx.TK_EOF {
        let before = P.pos;
        parse_top(&mut P);
        if P.pos == before {
            _ = advance(&mut P);
        }
    }
    // (the tree keeps the tokens' strings, not the tokens)
    toks.deinit();
    return P.mod;
}
