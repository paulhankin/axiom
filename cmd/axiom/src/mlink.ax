// =============================================================================
// mlink.ax - links the ELF relocatable objects of a64.ax (read with
// elf.read) into a macOS executable for Apple silicon: Mach-O, position
// independent (the kernel slides it), dynamically linked against libSystem
// (macOS has no stable system call interface, and dyld is how every program
// starts), ad-hoc code-signed (the kernel runs no unsigned arm64 code).
//
// Layout (16 KiB pages; file offsets and addresses agree within each
// segment):
//   __PAGEZERO  the first 4 GiB, unmapped
//   __TEXT      r-x  the Mach header and load commands, __text (code, then
//                    one stub per libSystem function called), __const
//   __DATA      rw-  __got (libSystem addresses, and addresses of our own
//                    symbols that code loads from the GOT), __data (data,
//                    relocated read-only data, the thread-local template,
//                    the runtime's TLS record), then __bss (zero-filled)
//   __LINKEDIT  r--  rebase and bind opcodes for dyld, the export trie,
//                    the symbol and string tables, the code signature
// Undefined symbols are bound by name, with a leading underscore, through
// LC_DYLD_INFO_ONLY: calls go through a stub that jumps through the GOT, and
// data words holding their addresses are bound in place. Every absolute
// address the image holds is rebased. They are libSystem's, unless an
// extern block named a library (codegen leaves the name in a constant
// axiom.import.<function>): a framework ("AppKit", "Metal", ...), "objc"
// (libobjc), a library in /usr/lib ("libz.1.dylib", or "z"), or a path.
// Each library is an LC_LOAD_DYLIB, and its symbols are bound with its
// ordinal (two-level namespace).
//
// Thread-locals: macOS gives programs no thread pointer of their own, so the
// code generator addresses them as a per-thread block found through a TSD
// slot (a64.ax). The linker lays out the template (.tdata, then .tbss) and
// resolves each thread-local's offset in it; the runtime (std/internal/runtime/darwin.ax)
// copies the template for every thread, using the record that ax_tls_info()
// returns: [the slot's byte offset (axiom.tls_key, which the runtime sets),
// the template's address, its initialized size, the block's size, its
// alignment].
// =============================================================================
import "bin.ax" as bn;
import "elf.ax" as elf;
import "nlink.ax" as nl;
import "std/crypto/sha2" as sha2;
import "util.ax" as u;

const BASE: u64 = 0x1_0000_0000;  // the image's address before sliding
const PAGE: u64 = 0x4000;
const CS_PAGE: u64 = 4096;  // the code signature hashes 4 KiB pages

// segment indexes for dyld's opcodes (in load-command order)
const SEG_TEXT: u64 = 1;
const SEG_DATA: u64 = 2;

struct Import {
    seg_off: u64,  // offset in __DATA
    name: []u8,
    addend: i64,
}

let mut stubs: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };    // gsym per stub
let mut rebases: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };  // __DATA offsets
let mut binds: u.List.[Import] = u.List.[Import].{ data: @ptr_from_int(*mut Import, 0), len: 0, cap: 0 };
// libraries beyond libSystem (ordinal 1), as install names: ordinal k + 2
let mut dylibs: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
// function name -> its library's ordinal (from axiom.import.* constants)
let mut import_ord: u.SymMap.[u32] = u.SymMap.[u32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 };

let mut text_addr: u64 = 0;
let mut stub_addr: u64 = 0;
let mut data_addr: u64 = 0;  // __DATA's address (and segment offsets from it)
let mut data_off: u64 = 0;   // __DATA's file offset
let mut got_addr: u64 = 0;
let mut tls_addr: u64 = 0;  // the template's start
let mut tls_filesz: u64 = 0;
let mut tls_memsz: u64 = 0;
let mut tls_align: u64 = 1;

fn is_abs64(ty: u32) bool {
    return ty == elf.R_AARCH64_ABS64;
}

// A section's place: read-only data that holds addresses goes in __DATA,
// since dyld rebases (or binds) them.
fn class_of(s: *elf.Sec) i32 {
    let k = s.kind;
    if k == elf.S_TEXT {
        return nl.C_TEXT;
    }
    if k == elf.S_RODATA {
        for r in s.relocs.items() {
            if is_abs64(r.ty) {
                return nl.C_DATA;
            }
        }
        return nl.C_CONST;
    }
    if k == elf.S_DATA {
        return nl.C_DATA;
    }
    if k == elf.S_BSS {
        return nl.C_BSS;
    }
    if k == elf.S_TDATA {
        return nl.C_TDATA;
    }
    return nl.C_TBSS;
}

// -----------------------------------------------------------------------------
// Symbols
// -----------------------------------------------------------------------------
fn collect_symbols() void {
    nl.define_globals();
    nl.use_unavailable(is_foreign);
    // What is still undefined must come from libSystem: C library names,
    // never our own (module-qualified) ones.
    for gi in 0..nl.gsyms.len {
        let g = nl.gsyms.at(gi);
        if (g.obj < 0) and ((u.find(g.name, '.') >= 0) or (u.find(g.name, '/') >= 0)) {
            nl.err(u.f1("undefined symbol '%s'", g.name));
        }
    }
}

// The ordinal of a function from another system's library.
const FOREIGN: u32 = 0xffff_fffe;

// From another system's library (a Windows DLL)?
fn is_foreign(name: []u8) bool {
    return import_ord.get(u.intern(name)) == FOREIGN;
}

// Frameworks whose install names are not Versions/A.
let FRAMEWORKS_C: [2][]u8 = ["AppKit", "Foundation"];

// The install name of the library an extern block names; "" for libSystem.
fn dylib_path(name: []u8) []u8 {
    if u.find(name, '/') >= 0 {
        return name;  // a path
    }
    if u.str_eq(name, "c") or u.str_eq(name, "m") or u.str_eq(name, "pthread") or u.str_eq(name, "System") or
       u.str_eq(name, "dl") {
        return "";
    }
    if u.str_eq(name, "objc") {
        return "/usr/lib/libobjc.A.dylib";
    }
    if u.ends(name, ".dylib") {
        return u.cat2("/usr/lib/", name);
    }
    if (name.len > 0) and (name[0] >= 'a') and (name[0] <= 'z') {
        return u.cat3("/usr/lib/lib", name, ".dylib");  // "z": libz
    }
    let mut ver: []u8 = "A";
    for f in FRAMEWORKS_C {
        if u.str_eq(f, name) {
            ver = "C";
        }
    }
    return u.f3("/System/Library/Frameworks/%s.framework/Versions/%s/%s", name, ver, name);
}

// The libraries that extern blocks named (the axiom.import.* constants).
fn collect_dylibs() void {
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        for si in 0..o.syms.len {
            let s = o.syms.get(si);
            if (s.sec < 0) or not u.starts(s.name, "axiom.import.") {
                continue;
            }
            let d = o.secs.get(@as(usize, @bit_cast(u32, s.sec))).data.view();
            let start = @truncate(usize, s.value);
            let mut e = start;
            while (e < d.len) and (d[e] != 0) {
                e += 1;
            }
            if nl.is_windows_dll(d[start..e]) {
                import_ord.put(u.intern(s.name[13..]), FOREIGN);
                continue;
            }
            let path = dylib_path(d[start..e]);
            let mut ord: u32 = 1;
            if path.len > 0 {
                let mut k = dylibs.len;
                for j in 0..dylibs.len {
                    if u.str_eq(dylibs.get(j), path) {
                        k = j;
                    }
                }
                if k == dylibs.len {
                    dylibs.push(u.dup(path));
                }
                ord = @int_cast(u32, k) + 2;
            }
            import_ord.put(u.intern(s.name[13..]), ord);
        }
    }
}

// The ordinal of the library that exports name (without its underscore).
fn ordinal_of(name: []u8) u32 {
    let k = import_ord.get(u.intern(name));
    if k == 0 {
        return 1;
    }
    return k;
}

// An LC_LOAD_DYLIB's size for an install name.
fn dylib_cmd_size(path: []u8) u64 {
    return nl.align_up(24 + @as(u64, path.len) + 1, 8);
}

fn load_dylib(h: *mut bn.Bytes, path: []u8, current: u64) void {
    let size = dylib_cmd_size(path);
    h.u32_(0xc);  // LC_LOAD_DYLIB
    h.u32_(size);
    h.u32_(24);           // the name's offset
    h.u32_(2);            // timestamp
    h.u32_(current);      // current version
    h.u32_(0x0001_0000);  // compatibility version 1.0
    h.put(path);
    for _k in @as(u64, path.len) + 24..size {
        h.u8_(0);
    }
}

// From a library?
fn is_import(oi: usize, si: u32) bool {
    let gi = nl.global_of(oi, si);
    return (gi >= 0) and (nl.gsyms.at(@int_cast(usize, gi)).obj < 0);
}

fn import_name(oi: usize, si: u32) []u8 {
    return u.cat2("_", nl.objs.get(oi).syms.get(@as(usize, si)).name);
}

// GOT slots and stubs the relocations need.
fn scan_relocs() void {
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        for k in 0..o.secs.len {
            let s = o.secs.get(k);
            for r in s.relocs.items() {
                if nl.is_got_reloc(false, r.ty) {
                    _ = nl.got_slot(oi, r.sym);
                } else if is_import(oi, r.sym) {
                    if nl.is_call_reloc(false, r.ty) {
                        _ = nl.got_slot(oi, r.sym);
                        let g = nl.gsyms.at(@as(usize, @bit_cast(u32, nl.global_of(oi, r.sym))));
                        if g.stub < 0 {
                            g.stub = @int_cast(i32, stubs.len);
                            stubs.push(@bit_cast(u32, nl.global_of(oi, r.sym)));
                        }
                    } else if not is_abs64(r.ty) {
                        nl.err(u.f1("'%s' (from a library) cannot be referenced this way",
                                    nl.objs.get(oi).syms.get(@as(usize, r.sym)).name));
                    }
                }
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Layout
// -----------------------------------------------------------------------------
// File offset of an address in __TEXT or __DATA.
fn file_of(addr: u64) u64 {
    if addr >= data_addr {
        return data_off + (addr - data_addr);
    }
    return addr - BASE;
}

// -----------------------------------------------------------------------------
// Relocation
// -----------------------------------------------------------------------------
// An absolute address at p (in __DATA): dyld slides it.
fn rebase_at(p: u64) void {
    if p < data_addr {
        nl.err("internal: an absolute address outside __DATA");
        return;
    }
    rebases.push(p - data_addr);
}

fn apply_relocs(b: []mut u8) void {
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        for k in 0..o.secs.len {
            let s = o.secs.get(k);
            let cls = nl.sec_cls.get(oi)[k];
            if (cls == nl.C_BSS) or (cls == nl.C_TBSS) {
                continue;
            }
            let base = nl.sec_addr.get(oi)[k];
            for r in s.relocs.items() {
                let p = base + r.off;
                let fo = file_of(p);
                let t = r.ty;
                let imp = is_import(oi, r.sym);
                let mut sv = nl.sym_addr(oi, r.sym);
                if imp and nl.is_call_reloc(false, t) {
                    let g = nl.gsyms.at(@as(usize, @bit_cast(u32, nl.global_of(oi, r.sym))));
                    sv = stub_addr + (@as(u64, @bit_cast(u32, g.stub)) * 12);
                }
                if nl.is_got_reloc(false, t) {
                    nl.a64_got(b, fo, p, t, got_addr + (@as(u64, @bit_cast(u32, nl.got_slot(oi, r.sym))) * 8));
                    continue;
                }
                let sa = sv +% @bit_cast(u64, r.addend);
                if is_abs64(t) {
                    if imp {
                        binds.push(Import.{ seg_off: p - data_addr, name: import_name(oi, r.sym), addend: r.addend });
                        bn.w64(b, fo, 0);
                    } else {
                        rebase_at(p);
                        bn.w64(b, fo, sa);
                    }
                    continue;
                }
                if nl.a64_reloc(b, fo, p, t, sa) {
                    continue;
                }
                if (t == elf.R_AARCH64_TLSLE_ADD_TPREL_HI12) or (t == elf.R_AARCH64_TLSLE_ADD_TPREL_LO12_NC) {
                    // the offset in the thread's block
                    let v = @bit_cast(i64, sa -% tls_addr);
                    if (v < 0) or (v >= 0x100_0000) {
                        nl.err("thread-local offset out of range");
                    }
                    if t == elf.R_AARCH64_TLSLE_ADD_TPREL_HI12 {
                        nl.a64_imm12(b, fo, @bit_cast(u64, v) >> 12);
                    } else {
                        nl.a64_imm12(b, fo, @bit_cast(u64, v) & 0xfff);
                    }
                } else {
                    nl.err(u.f1("unsupported relocation type %s", u.udec(@as(u64, t))));
                }
            }
        }
    }
}

// -----------------------------------------------------------------------------
// The linker's own object: the thread-local record (axiom.tls_key is its
// first word) and ax_tls_info(), which returns its address.
// -----------------------------------------------------------------------------
fn own_object() *mut elf.Obj {
    let o = elf.new_obj(elf.EM_AARCH64);
    let text = elf.add_sec(o, ".text", elf.S_TEXT, 4);
    let data = elf.add_sec(o, ".data", elf.S_DATA, 8);
    let ds = o.secs.get(@int_cast(usize, data));
    ds.data.zeros(40);
    let info = elf.add_sym(o, elf.Sym.{ name: "axiom.tls_key", sec: data, value: 0, size: 40, bind: elf.B_GLOBAL,
                                        ty: elf.T_OBJECT, hidden: true });
    _ = elf.add_sym(o, elf.Sym.{ name: "ax_tls_info", sec: text, value: 0, size: 12, bind: elf.B_GLOBAL, ty: elf.T_FUNC,
                                 hidden: true });
    let ts = o.secs.get(@int_cast(usize, text));
    ts.relocs.push(elf.Rel.{ off: 0, ty: elf.R_AARCH64_ADR_PREL_PG_HI21, sym: info, addend: 0 });
    ts.data.u32_(0x9000_0000);  // adrp x0, info
    ts.relocs.push(elf.Rel.{ off: 4, ty: elf.R_AARCH64_ADD_ABS_LO12_NC, sym: info, addend: 0 });
    ts.data.u32_(0x9100_0000);  // add x0, x0, :lo12:info
    ts.data.u32_(0xd65f_03c0);  // ret
    return o;
}

// -----------------------------------------------------------------------------
// The Mach-O file
// -----------------------------------------------------------------------------
fn name16(h: *mut bn.Bytes, s: []u8) void {
    for i in @as(usize, 0)..16 {
        if i < s.len {
            h.u8_(s[i]);
        } else {
            h.u8_(0);
        }
    }
}

fn segment(h: *mut bn.Bytes, name: []u8, vmaddr: u64, vmsize: u64, fileoff: u64, filesize: u64, prot: u64,
           nsects: u64) void {
    h.u32_(0x19);  // LC_SEGMENT_64
    h.u32_(72 + (nsects * 80));
    name16(h, name);
    h.u64_(vmaddr);
    h.u64_(vmsize);
    h.u64_(fileoff);
    h.u64_(filesize);
    h.u32_(prot);  // maxprot
    h.u32_(prot);  // initprot
    h.u32_(nsects);
    h.u32_(0);
}

fn section(h: *mut bn.Bytes, name: []u8, seg: []u8, addr: u64, size: u64, offset: u64, align: u64, flags: u64) void {
    name16(h, name);
    name16(h, seg);
    h.u64_(addr);
    h.u64_(size);
    h.u32_(offset);
    let mut lg: u64 = 0;
    while (@as(u64, 1) << lg) < align {
        lg += 1;
    }
    h.u32_(lg);
    h.u32_(0);  // reloff
    h.u32_(0);  // nreloc
    h.u32_(flags);
    h.u32_(0);
    h.u32_(0);
    h.u32_(0);
}

fn be32(b: *mut bn.Bytes, x: u64) void {
    b.u8_(@truncate(u8, x >> 24));
    b.u8_(@truncate(u8, x >> 16));
    b.u8_(@truncate(u8, x >> 8));
    b.u8_(@truncate(u8, x));
}

fn be64(b: *mut bn.Bytes, x: u64) void {
    be32(b, x >> 32);
    be32(b, x & 0xFFFF_FFFF);
}

// The ad-hoc signature of file[0..limit]: a superblob holding one code
// directory (version 0x20400, linker-signed) with a SHA-256 hash per 4 KiB
// page. Its size is known before the hashes are.
fn signature_size(ident: []u8, limit: u64) u64 {
    let npages = (limit + CS_PAGE - 1) / CS_PAGE;
    let cd = nl.align_up(88 + @as(u64, ident.len) + 1, 16) + (npages * 32);
    return nl.align_up(24 + cd, 16);
}

fn signature(file: []u8, ident: []u8, limit: u64, text_size: u64) []u8 {
    let npages = (limit + CS_PAGE - 1) / CS_PAGE;
    let hash_off = nl.align_up(88 + @as(u64, ident.len) + 1, 16);
    let cd_len = hash_off + (npages * 32);
    let total = signature_size(ident, limit);
    let mut b = bn.new_bytes();
    be32(&mut b, 0xfade_0cc0);  // CSMAGIC_EMBEDDED_SIGNATURE
    be32(&mut b, total);
    be32(&mut b, 1);  // one blob
    be32(&mut b, 0);  // CSSLOT_CODEDIRECTORY
    be32(&mut b, 24);
    be32(&mut b, 0);            // (padding to 8)
    be32(&mut b, 0xfade_0c02);  // CSMAGIC_CODEDIRECTORY
    be32(&mut b, cd_len);
    be32(&mut b, 0x20400);
    be32(&mut b, 0x20002);  // CS_ADHOC | CS_LINKER_SIGNED
    be32(&mut b, hash_off);
    be32(&mut b, 88);  // identOffset
    be32(&mut b, 0);   // nSpecialSlots
    be32(&mut b, npages);
    be32(&mut b, limit);
    b.u8_(32);                // hashSize
    b.u8_(2);                 // hashType: SHA-256
    b.u8_(0);                 // platform
    b.u8_(12);                // log2 of the page size
    be32(&mut b, 0);          // spare2
    be32(&mut b, 0);          // scatterOffset
    be32(&mut b, 0);          // teamOffset
    be32(&mut b, 0);          // spare3
    be64(&mut b, 0);          // codeLimit64
    be64(&mut b, 0);          // execSegBase
    be64(&mut b, text_size);  // execSegLimit
    be64(&mut b, 1);          // CS_EXECSEG_MAIN_BINARY
    b.put(ident);
    b.u8_(0);
    while @as(u64, b.len()) < (24 + hash_off) {
        b.u8_(0);
    }
    let mut h: [32]u8 = [0; 32];
    for i in @as(u64, 0)..npages {
        let lo = i * CS_PAGE;
        let hi = @min(lo + CS_PAGE, limit);
        sha2.sha256(file[@truncate(usize, lo)..@truncate(usize, hi)], h[..]);
        b.put(h[..]);
    }
    while @as(u64, b.len()) < total {
        b.u8_(0);
    }
    return b.view();
}

// The export trie: __mh_execute_header (at the image's start) only.
fn export_trie() []u8 {
    let mut t = bn.new_bytes();
    let name = "__mh_execute_header";
    t.u8_(0);  // the root: no terminal information
    t.u8_(1);  // one edge
    t.put(name);
    t.u8_(0);
    let child = @as(u64, t.len()) + 1;
    t.uleb(child);
    t.u8_(2);  // terminal information: 2 bytes
    t.u8_(0);  // flags: regular
    t.u8_(0);  // the offset from the image's start
    t.u8_(0);  // no edges
    t.align(8);
    return t.view();
}

// Runs of consecutive words are one opcode (programs hold many tables of
// addresses).
fn rebase_info() []u8 {
    let mut b = bn.new_bytes();
    let rs = rebases.items();
    u.sort.[u64](rs, cmp_u64);
    b.u8_(0x11);  // REBASE_OPCODE_SET_TYPE_IMM | REBASE_TYPE_POINTER
    b.u8_(0x20 | @truncate(u8, SEG_DATA));  // REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB
    b.uleb(0);
    let mut cur: u64 = 0;  // the opcodes' address (dyld's), as a segment offset
    let mut i: usize = 0;
    while i < rs.len {
        let start = rs[i];
        let mut n: u64 = 1;
        while ((i + 1) < rs.len) and (rs[i + 1] == (start + (n * 8))) {
            n += 1;
            i += 1;
        }
        if (i + 1) < rs.len {
            // skip duplicates (the same word relocated twice)
            while ((i + 1) < rs.len) and (rs[i + 1] < (start + (n * 8))) {
                i += 1;
            }
        }
        i += 1;
        if start != cur {
            b.u8_(0x30);  // REBASE_OPCODE_ADD_ADDR_ULEB
            b.uleb(start - cur);
        }
        b.u8_(0x60);  // REBASE_OPCODE_DO_REBASE_ULEB_TIMES (each advances a word)
        b.uleb(n);
        cur = start + (n * 8);
    }
    b.u8_(0);  // REBASE_OPCODE_DONE
    b.align(8);
    return b.view();
}

fn cmp_u64(a: u64, b: u64) i32 {
    if a < b {
        return -1;
    }
    if a > b {
        return 1;
    }
    return 0;
}

fn bind_info() []u8 {
    let mut b = bn.new_bytes();
    b.u8_(0x51);  // BIND_OPCODE_SET_TYPE_IMM | BIND_TYPE_POINTER
    let mut ord: u32 = 0;
    for x in binds.items() {
        let o = ordinal_of(x.name[1..]);
        if o != ord {
            ord = o;
            if o < 16 {
                b.u8_(0x10 | @truncate(u8, o));  // BIND_OPCODE_SET_DYLIB_ORDINAL_IMM
            } else {
                b.u8_(0x20);  // BIND_OPCODE_SET_DYLIB_ORDINAL_ULEB
                b.uleb(@as(u64, o));
            }
        }
        b.u8_(0x40);  // BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM
        b.put(x.name);
        b.u8_(0);
        b.u8_(0x60);  // BIND_OPCODE_SET_ADDEND_SLEB
        b.sleb(x.addend);
        b.u8_(0x70 | @truncate(u8, SEG_DATA));  // BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB
        b.uleb(x.seg_off);
        b.u8_(0x90);  // BIND_OPCODE_DO_BIND
    }
    b.u8_(0);  // BIND_OPCODE_DONE
    b.align(8);
    return b.view();
}

struct NSym {
    name: []u8,
    ty: u8,
    sect: u8,
    desc: u64,
    value: u64,
}

// Links `inputs` into the executable `out`. 0: done; 1: errors (reported).
pub fn link(inputs: []*mut elf.Obj, out: []u8) i32 {
    nl.begin(inputs);
    nl.objs.push(own_object());
    nl.objs.push(elf.rets_bounds(elf.EM_AARCH64));
    collect_dylibs();
    collect_symbols();
    let mn = nl.gsym_index("main");
    if nl.gsyms.at(@as(usize, mn)).obj < 0 {
        nl.err("no 'main' function");
    }
    nl.classify(class_of);
    scan_relocs();
    if nl.errors != 0 {
        return 1;
    }
    // GOT slots that dyld binds (libSystem) or rebases (our own symbols)
    let ngot = @as(u64, nl.got_sym.len);

    // the load commands' size, which places everything after them
    let ident = u.basename(out);
    let mut ncmds: u64 = 13;
    let mut sizeofcmds: u64 = (72 + (72 + (2 * 80)) + (72 + (3 * 80)) + 72) + 48 + 24 + 80 + 32 + 24 + 24 + 24 + 56 +
                              16;
    for d in dylibs.items() {
        ncmds += 1;
        sizeofcmds += dylib_cmd_size(d);
    }

    // __TEXT
    text_addr = nl.align_up(BASE + 32 + sizeofcmds, 16);
    let code_end = nl.place(nl.C_TEXT, text_addr);
    stub_addr = nl.align_up(code_end, 4);
    let text_end = stub_addr + (@as(u64, stubs.len) * 12);
    let const_addr = nl.align_up(text_end, nl.class_align(nl.C_CONST));
    let const_end = nl.place(nl.C_CONST, const_addr);
    let text_size = nl.align_up(const_end - BASE, PAGE);

    // __DATA
    data_addr = BASE + text_size;
    data_off = text_size;
    got_addr = data_addr;
    let data_start = nl.align_up(got_addr + (ngot * 8), 16);
    let mut data_end = nl.place(nl.C_DATA, data_start);
    tls_align = @max(nl.class_align(nl.C_TDATA), nl.class_align(nl.C_TBSS));
    tls_addr = nl.align_up(data_end, @max(tls_align, 16));
    let tdata_end = nl.place(nl.C_TDATA, tls_addr);
    let tbss_end = nl.place(nl.C_TBSS, nl.align_up(tdata_end, nl.class_align(nl.C_TBSS)));
    tls_filesz = tdata_end - tls_addr;
    tls_memsz = tbss_end - tls_addr;
    data_end = tdata_end;
    let bss_addr = nl.align_up(data_end, nl.class_align(nl.C_BSS));
    let bss_end = nl.place(nl.C_BSS, bss_addr);
    let data_filesize = nl.align_up(data_end - data_addr, PAGE);
    let data_vmsize = nl.align_up(bss_end - data_addr, PAGE);

    let total_body = data_off + data_filesize;
    let mut fileb = bn.new_bytes();
    fileb.zeros(@truncate(usize, total_body));
    let b = fileb.view();
    nl.copy_class(b, nl.C_TEXT, file_of);
    nl.copy_class(b, nl.C_CONST, file_of);
    nl.copy_class(b, nl.C_DATA, file_of);
    nl.copy_class(b, nl.C_TDATA, file_of);

    // stubs: adrp x16, slot@PAGE; ldr x16, [x16, slot@PAGEOFF]; br x16
    for k in 0..stubs.len {
        let g = nl.gsyms.at(@as(usize, stubs.get(k)));
        let at = stub_addr + (@as(u64, k) * 12);
        let slot = got_addr + (@as(u64, @bit_cast(u32, g.got)) * 8);
        let fo = file_of(at);
        bn.w32(b, fo, 0x9000_0010);
        nl.a64_adrp(b, fo, at, slot);
        bn.w32(b, fo + 4, 0xf940_0210);
        nl.a64_imm12(b, fo + 4, (slot & 0xfff) >> 3);
        bn.w32(b, fo + 8, 0xd61f_0200);
    }
    // GOT slots
    for k in 0..nl.got_sym.len {
        let oi = @as(usize, nl.got_obj.get(k));
        let si = nl.got_sym.get(k);
        let at = got_addr + (@as(u64, k) * 8);
        if is_import(oi, si) {
            binds.push(Import.{ seg_off: at - data_addr, name: import_name(oi, si), addend: 0 });
        } else {
            bn.w64(b, file_of(at), nl.sym_addr(oi, si));
            rebase_at(at);
        }
    }
    apply_relocs(b);
    // the runtime's record of the thread-local template
    let info = nl.global_addr("axiom.tls_key");
    let ifo = file_of(info);
    bn.w64(b, ifo + 8, tls_addr);
    rebase_at(info + 8);
    bn.w64(b, ifo + 16, tls_filesz);
    bn.w64(b, ifo + 24, tls_memsz);
    bn.w64(b, ifo + 32, @max(tls_align, 16));
    if nl.errors != 0 {
        return 1;
    }

    // __LINKEDIT: rebase, bind, exports, symbols, strings, signature
    let rebase = rebase_info();
    let bind = bind_info();
    let exports = export_trie();
    let mut strtab = bn.new_bytes();
    strtab.u8_(0x20);
    strtab.u8_(0);
    let mut locals = u.List.[NSym].empty();
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        for si in 0..o.syms.len {
            let s = o.syms.get(si);
            if (s.sec < 0) or (s.name.len == 0) or (s.ty == elf.T_TLS) {
                continue;
            }
            let cls = nl.sec_cls.get(oi)[@as(usize, @bit_cast(u32, s.sec))];
            if (cls == nl.C_TDATA) or (cls == nl.C_TBSS) {
                continue;
            }
            if (s.bind != elf.B_LOCAL) and (nl.global_of(oi, @int_cast(u32, si)) >= 0) {
                let g = nl.gsyms.at(@as(usize, @bit_cast(u32, nl.global_of(oi, @int_cast(u32, si)))));
                if (g.obj != @int_cast(i32, oi)) or (g.sym != @int_cast(u32, si)) {
                    continue;  // a weak definition that lost
                }
            }
            let mut sect: u8 = 1;  // __text
            if cls == nl.C_CONST {
                sect = 2;
            } else if cls == nl.C_DATA {
                sect = 4;
            } else if cls == nl.C_BSS {
                sect = 5;
            }
            locals.push(
                NSym.{ name: s.name, ty: 0x0e, sect: sect, desc: 0, value: nl.sym_addr_in(oi, @int_cast(u32, si)) });
        }
    }
    let mut syms = u.List.[NSym].empty();
    for x in locals.items() {
        syms.push(x);
    }
    // external: the header (for dyld) and main
    syms.push(NSym.{ name: "__mh_execute_header", ty: 0x0f, sect: 1, desc: 0x10, value: BASE });
    syms.push(NSym.{ name: "_main", ty: 0x0f, sect: 1, desc: 0, value: nl.global_addr("main") });
    // undefined: each with its library's ordinal (libSystem's is 1)
    let nlocal = locals.len;
    let mut undef = u.List.[[]u8].empty();
    for gi in 0..nl.gsyms.len {
        let g = nl.gsyms.at(gi);
        if g.obj < 0 {
            undef.push(u.cat2("_", g.name));
        }
    }
    u.sort.[[]u8](undef.items(), u.str_cmp);
    for nm in undef.items() {
        let desc = @as(u64, ordinal_of(nm[1..])) << 8;  // SET_LIBRARY_ORDINAL
        syms.push(NSym.{ name: nm, ty: 0x01, sect: 0, desc: desc, value: 0 });
    }
    let nundef = syms.len - (nlocal + 2);
    let mut symtab = bn.new_bytes();
    for x in syms.items() {
        symtab.u32_(@as(u64, strtab.len()));
        strtab.put(x.name);
        strtab.u8_(0);
        symtab.u8_(x.ty);
        symtab.u8_(x.sect);
        symtab.u16_(x.desc);
        symtab.u64_(x.value);
    }
    strtab.align(8);

    let le_off = data_off + data_filesize;
    let rebase_off = le_off;
    let bind_off = rebase_off + @as(u64, rebase.len);
    let export_off = bind_off + @as(u64, bind.len);
    let sym_off = export_off + @as(u64, exports.len);
    let str_off = sym_off + @as(u64, symtab.len());
    let sig_off = nl.align_up(str_off + @as(u64, strtab.len()), 16);
    let sig_size = signature_size(ident, sig_off);
    let le_size = (sig_off + sig_size) - le_off;
    let le_addr = data_addr + data_vmsize;

    // the header and load commands
    let mut h = bn.new_bytes();
    h.u32_(0xfeed_facf);  // MH_MAGIC_64
    h.u32_(0x0100_000c);  // CPU_TYPE_ARM64
    h.u32_(0);            // CPU_SUBTYPE_ARM64_ALL
    h.u32_(2);            // MH_EXECUTE
    h.u32_(ncmds);
    h.u32_(sizeofcmds);
    h.u32_(0x0020_0085);  // MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE
    h.u32_(0);
    segment(&mut h, "__PAGEZERO", 0, BASE, 0, 0, 0, 0);
    segment(&mut h, "__TEXT", BASE, text_size, 0, text_size, 5, 2);
    section(&mut h, "__text", "__TEXT", text_addr, text_end - text_addr, file_of(text_addr), 16, 0x8000_0400);
    section(&mut h, "__const", "__TEXT", const_addr, const_end - const_addr, file_of(const_addr),
            @max(nl.class_align(nl.C_CONST), 1), 0);
    segment(&mut h, "__DATA", data_addr, data_vmsize, data_off, data_filesize, 3, 3);
    section(&mut h, "__got", "__DATA", got_addr, ngot * 8, data_off, 8, 0);
    section(&mut h, "__data", "__DATA", data_start, data_end - data_start, file_of(data_start), 16, 0);
    section(&mut h, "__bss", "__DATA", bss_addr, bss_end - bss_addr, 0, @max(nl.class_align(nl.C_BSS), 1), 1);
    segment(&mut h, "__LINKEDIT", le_addr, nl.align_up(le_size, PAGE), le_off, le_size, 1, 0);
    h.u32_(0x8000_0022);  // LC_DYLD_INFO_ONLY
    h.u32_(48);
    h.u32_(rebase_off);
    h.u32_(@as(u64, rebase.len));
    h.u32_(bind_off);
    h.u32_(@as(u64, bind.len));
    h.u32_(0);  // weak bind
    h.u32_(0);
    h.u32_(0);  // lazy bind
    h.u32_(0);
    h.u32_(export_off);
    h.u32_(@as(u64, exports.len));
    h.u32_(2);  // LC_SYMTAB
    h.u32_(24);
    h.u32_(sym_off);
    h.u32_(@as(u64, syms.len));
    h.u32_(str_off);
    h.u32_(@as(u64, strtab.len()));
    h.u32_(0xb);  // LC_DYSYMTAB
    h.u32_(80);
    h.u32_(0);  // ilocalsym
    h.u32_(@as(u64, nlocal));
    h.u32_(@as(u64, nlocal));  // iextdefsym
    h.u32_(2);
    h.u32_(@as(u64, nlocal) + 2);  // iundefsym
    h.u32_(@as(u64, nundef));
    for _k in @as(u32, 0)..12 {
        h.u32_(0);  // no TOC, modules, external or indirect symbols, relocations
    }
    h.u32_(0xe);  // LC_LOAD_DYLINKER
    h.u32_(32);
    h.u32_(12);
    name16(&mut h, "/usr/lib/dyld");
    h.u32_(0);
    h.u32_(0x1b);  // LC_UUID (filled in below)
    h.u32_(24);
    let uuid_at = h.len();
    h.zeros(16);
    h.u32_(0x32);  // LC_BUILD_VERSION
    h.u32_(24);
    h.u32_(1);            // PLATFORM_MACOS
    h.u32_(0x000b_0000);  // minos 11.0, the first for Apple silicon
    h.u32_(0x000b_0000);  // sdk
    h.u32_(0);            // no tools
    h.u32_(0x8000_0028);  // LC_MAIN
    h.u32_(24);
    h.u64_(file_of(nl.global_addr("main")));
    h.u64_(0);  // default stack size
    load_dylib(&mut h, "/usr/lib/libSystem.B.dylib", 0x0547_0000);  // current version 1351
    for d in dylibs.items() {
        load_dylib(&mut h, d, 0x0001_0000);
    }
    h.u32_(0x1d);  // LC_CODE_SIGNATURE
    h.u32_(16);
    h.u32_(sig_off);
    h.u32_(sig_size);
    if @as(u64, h.len()) != (32 + sizeofcmds) {
        nl.err("internal: load command size");
        return 1;
    }
    let hv = h.view();
    for i in 0..hv.len {
        b[i] = hv[i];
    }

    // the whole file before the signature
    let mut f = bn.new_bytes();
    f.put(b);
    f.put(rebase);
    f.put(bind);
    f.put(exports);
    f.put(symtab.view());
    f.put(strtab.view());
    while @as(u64, f.len()) < sig_off {
        f.u8_(0);
    }
    // a UUID from the contents (deterministic builds)
    let mut digest: [32]u8 = [0; 32];
    sha2.sha256(f.view(), digest[..]);
    digest[6] = (digest[6] & 0x0f) | 0x40;
    digest[8] = (digest[8] & 0x3f) | 0x80;
    let fv = f.view();
    for i in @as(usize, 0)..16 {
        fv[uuid_at + i] = digest[i];
    }
    let sig = signature(fv, ident, sig_off, text_size);
    f.put(sig);
    // a new file renamed over the output: macOS caches an executable's code
    // signature with its file, and kills a program rewritten in place
    let tmp = u.f2("%s.tmp%s", out, u.idec(u.getpid()));
    if not u.write_file(tmp, f.view()) {
        _ = u.unlink(u.cz(tmp));
        nl.err(u.f1("cannot write %s", out));
        return 1;
    }
    _ = u.chmod(u.cz(tmp), 0o755);
    if u.rename(u.cz(tmp), u.cz(out)) != 0 {
        _ = u.unlink(u.cz(tmp));
        nl.err(u.f1("cannot write %s", out));
        return 1;
    }
    return 0;
}
