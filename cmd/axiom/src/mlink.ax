// =============================================================================
// mlink.ax - links the ELF relocatable objects of a64.ax or x64.ax (read
// with elf.read) into a macOS executable for Apple silicon or for an Intel
// Mac: Mach-O (CPU_TYPE_ARM64 or CPU_TYPE_X86_64), position independent
// (the kernel slides it), dynamically linked against libSystem (macOS has no
// stable system call interface, and dyld is how every program starts),
// ad-hoc code-signed (the kernel runs no unsigned arm64 code; an x86-64
// program is signed the same way, which it may be).
//
// Layout (16 KiB pages; file offsets and addresses agree within each
// segment):
//   __PAGEZERO  the first 4 GiB, unmapped
//   __TEXT      r-x  the Mach header and load commands, __text (code, then
//                    one stub per libSystem function called), __const
//   __DATA      rw-  __got (libSystem addresses, and addresses of our own
//                    symbols that code loads from the GOT), __data (data,
//                    relocated read-only data, the thread-local template,
//                    the runtime's TLS record), then __bss (zero-filled)
//   __LINKEDIT  r--  rebase and bind opcodes for dyld, the export trie,
//                    the symbol and string tables, the code signature
// Undefined symbols are bound by name, with a leading underscore, through
// LC_DYLD_INFO_ONLY: calls go through a stub that jumps through the GOT
// (adrp, ldr, br on arm64; jmp [rip + slot] on x86-64), and data words
// holding their addresses are bound in place. On x86-64 the functions whose
// structures have 64-bit inode numbers (stat, readdir, ...) are bound to
// their $INODE64 names, the variants with the layouts arm64 has (libSystem's
// unsuffixed x86-64 ones keep the old layouts). Every absolute
// address the image holds is rebased. They are libSystem's, unless an
// extern block named a library (codegen leaves the name in a constant
// axiom.import.<function>): a framework ("AppKit", "Metal", ...), "objc"
// (libobjc), a library in /usr/lib ("libz.1.dylib", or "z"), or a path.
// Each library is an LC_LOAD_DYLIB, and its symbols are bound with its
// ordinal (two-level namespace).
//
// Thread-locals: macOS gives programs no thread pointer of their own, so the
// code generator addresses them as a per-thread block found through a TSD
// slot (a64.ax: TPIDRRO_EL0 addresses the slots; x64.ax: the gs segment
// does). The linker lays out the template (.tdata, then .tbss) and
// resolves each thread-local's offset in it; the runtime (std/internal/runtime/darwin.ax)
// copies the template for every thread, using the record that ax_tls_info()
// returns: [the slot's byte offset (axiom.tls_key, which the runtime sets),
// the template's address, its initialized size, the block's size, its
// alignment]. That is --macos-tls=fast, the default; with
// --macos-tls=platform (and in objects for the platform's toolchain) the
// thread-locals are the platform's (isel.ax platform_tlv): descriptors in
// __thread_vars, whose thunk dyld sets and which makes each thread's block
// (C_TLV below), the code calling the thunk; the runtime's block is then
// empty. A link may have both, each variable reached by its own scheme's
// code; a reference of one scheme's code to the other's variable is an
// error (tls_scheme_check).
// =============================================================================
import "bin.ax" as bn;
import "elf.ax" as elf;
import "jstub.ax" as jstub;
import "macho.ax" as mo;
import "macunwind.ax" as mu;
import "nlink.ax" as nl;
import "std/crypto/sha2" as sha2;
import "util.ax" as u;

const EXEC_BASE: u64 = 0x1_0000_0000;  // an executable's address before sliding (a dynamic library's is 0)
let mut image_base: u64 = 0x1_0000_0000;
const PAGE: u64 = 0x4000;
const CS_PAGE: u64 = 4096;  // the code signature hashes 4 KiB pages

// __DATA's index for dyld's opcodes (in load-command order: after
// __PAGEZERO and __TEXT; a dynamic library has no __PAGEZERO)
fn seg_data() u64 {
    if g_dylib {
        return 1;
    }
    return 2;
}

struct Import {
    seg_off: u64,  // offset in __DATA
    name: []u8,
    addend: i64,
}

let mut stubs: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };    // gsym per stub
let mut rebases: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };  // __DATA offsets
let mut binds: u.List.[Import] = u.List.[Import].{ data: @ptr_from_int(*mut Import, 0), len: 0, cap: 0 };
// libraries beyond libSystem (ordinal 1), as install names: ordinal k + 2
let mut dylibs: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
// function name -> its library's ordinal (from axiom.import.* constants)
let mut import_ord: u.SymMap.[u32] = u.SymMap.[u32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 };

/// The dynamic libraries given to the link (linkin.ax: their install names
/// and exports), and the libraries named with -l that are not files here
/// (bound by name: their install names by dylib_path, and the symbols
/// nothing else names looked up in every library loaded).
pub let mut g_dylibs: u.List.[*mut mo.Dylib] = u.List.[*mut mo.Dylib].{ data: @ptr_from_int(*mut *mut mo.Dylib, 0),
                                                                        len: 0, cap: 0 };
pub let mut g_by_name: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
// a library is bound by name: the symbols of no library known are looked
// up in all of them (BIND_SPECIAL_DYLIB_FLAT_LOOKUP)
let mut flat: bool = false;
const FLAT_LOOKUP: u32 = 0xfe;  // (the symbol table's DYNAMIC_LOOKUP_ORDINAL)

/// Linking a dynamic library (--emit=shared): MH_DYLIB (dylib.ax).
pub let mut g_dylib: bool = false;

let mut X64: bool = false;  // linking x86-64 objects (else arm64 ones)

// A stub's size: adrp, ldr, br; or jmp [rip + slot] and two int3s.
fn stub_size() u64 {
    if X64 {
        return 8;
    }
    return 12;
}

fn machine() u32 {
    if X64 {
        return elf.EM_X86_64;
    }
    return elf.EM_AARCH64;
}

fn cpu_type() u64 {
    if X64 {
        return 0x0100_0007;  // CPU_TYPE_X86_64
    }
    return 0x0100_000c;  // CPU_TYPE_ARM64
}

fn cpu_subtype() u64 {
    if X64 {
        return 3;  // CPU_SUBTYPE_X86_64_ALL
    }
    return 0;  // CPU_SUBTYPE_ARM64_ALL
}

let mut text_addr: u64 = 0;
let mut stub_addr: u64 = 0;
let mut data_addr: u64 = 0;  // __DATA's address (and segment offsets from it)
let mut data_off: u64 = 0;   // __DATA's file offset
let mut got_addr: u64 = 0;
let mut tls_addr: u64 = 0;  // the template's start
let mut tls_filesz: u64 = 0;
let mut tls_memsz: u64 = 0;
let mut tls_align: u64 = 1;

fn is_abs64(ty: u32) bool {
    if X64 {
        return ty == elf.R_X86_64_64;
    }
    return ty == elf.R_AARCH64_ABS64;
}

// A thread-local descriptor reference (@TLVPPAGE / @TLVPPAGEOFF, x86-64's
// sym@TLVP): a GOT slot holding the descriptor's address, or the
// descriptor itself (tlvp_reloc).
fn is_tlvp(ty: u32) bool {
    return (ty == elf.R_AARCH64_AXIOM_TLVP_PAGE) or (ty == elf.R_AARCH64_AXIOM_TLVP_PAGEOFF) or
           (ty == elf.R_X86_64_AXIOM_TLV);
}

// The class of the section that defines symbol si of object oi (-1: none, an import).
fn def_class(oi: usize, si: u32) i32 {
    let gi = nl.global_of(oi, si);
    let mut o = oi;
    let mut k = si;
    if gi >= 0 {
        let g = nl.gsyms.at(@int_cast(usize, gi));
        if g.obj < 0 {
            return -1;
        }
        o = @as(usize, @bit_cast(u32, g.obj));
        k = g.sym;
    }
    let sy = nl.objs.get(o).syms.get(@as(usize, k));
    if sy.sec < 0 {
        return -1;
    }
    return nl.sec_cls.get(o)[@as(usize, @bit_cast(u32, sy.sec))];
}

let mut tls_reported: u.SymMap.[i32] = u.SymMap.[i32].{ keys: @ptr_from_int(*mut usize, 0),
                                                        vals: @ptr_from_int(*mut i32, 0), cap: 0, len: 0 };

// A reference of one thread-local scheme's code (TLVP: the platform's
// descriptors; else the runtime's block of --macos-tls=fast) to a variable
// of the other: an error, which says how to build the objects alike.
fn tls_scheme_check(oi: usize, si: u32, tlvp: bool) bool {
    let c = def_class(oi, si);
    let fast = (c == nl.C_TDATA) or (c == nl.C_TBSS);
    let n = nl.objs.get(oi).syms.get(@as(usize, si)).name;
    // (once for each variable: its code has two relocations, high and low)
    let key = u.intern(n);
    if tls_reported.get(key) != 0 {
        return false;
    }
    if (tlvp and fast) or (not tlvp and not fast) {
        tls_reported.put(key, 1);
    }
    if tlvp and fast {
        nl.err(u.f2("%s reaches thread-local '%s' by its descriptor, but it is one of --macos-tls=fast's: build that code with --macos-tls=platform",
                    nl.obj_name(oi), n));
        return false;
    }
    if not tlvp and not fast {
        nl.err(u.f2("%s reaches thread-local '%s' in the runtime's block (--macos-tls=fast), but it is the platform's (a descriptor: of --macos-tls=platform, --emit=obj, a library or the platform's compilers): build that code with --macos-tls=platform",
                    nl.obj_name(oi), n));
        return false;
    }
    return true;
}

// The platform's thread-local variables, of the platform toolchain's
// objects (macho.ax reads them as these sections): their descriptors
// (__thread_vars: a function, a key, the variable's offset in the
// template; dyld sets the first two), and the template (__thread_data,
// then __thread_bss), which dyld copies for each thread. The code calls a
// descriptor's function to find a variable (TLVP relocations: through a
// GOT slot holding the descriptor's address).
const C_TLV: i32 = 10;
// a dynamic library's initializer and terminator pointers (__mod_init_func,
// __mod_term_func: dyld calls them); an executable's start-up runs them
const C_INIT: i32 = 13;
const C_FINI: i32 = 14;
const C_TLV_DATA: i32 = 11;
const C_TLV_BSS: i32 = 12;
// the unwind tables (macunwind.ax): the objects' FDEs, placed together in
// __eh_frame, and their compact entries, which make __unwind_info
const C_EH: i32 = 15;
const C_CU: i32 = 16;
// the debugger's descriptors of thread-locals (-g: dwarf.ax finish_elf), in
// the platform's form (a function, the key, the offset): the key is the
// runtime's, written there at start-up, the offset in our block the
// linker's (macOS's debugger reads a thread-local's address as the TSD value
// of the key plus the offset)
const C_TLVD: i32 = 17;
let mut unwind: bn.Bytes = bn.Bytes.{ b: u.List.[u8].{ data: @ptr_from_int(*mut u8, 0), len: 0, cap: 0 } };
let mut has_tlv: bool = false;
let mut tlv_start: u64 = 0;  // the template's

// A section's place: read-only data that holds addresses goes in __DATA,
// since dyld rebases (or binds) them.
fn class_of(s: *elf.Sec) i32 {
    if u.str_eq(s.name, ".eh_frame") {
        return C_EH;
    }
    if u.str_eq(s.name, "axiom_tlvd") {
        return C_TLVD;
    }
    if u.str_eq(s.name, ".compact_unwind") {
        return C_CU;
    }
    // (and .macho.thread_vars.<name> ..., of --data-sections)
    if u.starts(s.name, ".macho.thread_vars") {
        return C_TLV;
    }
    if u.starts(s.name, ".macho.thread_data") {
        return C_TLV_DATA;
    }
    if u.starts(s.name, ".macho.thread_bss") {
        return C_TLV_BSS;
    }
    if g_dylib and (s.kind == elf.S_DATA) and u.starts(s.name, ".init_array") {
        return C_INIT;
    }
    if g_dylib and (s.kind == elf.S_DATA) and u.starts(s.name, ".fini_array") {
        return C_FINI;
    }
    let k = s.kind;
    if k == elf.S_DEBUG {
        return nl.C_DEBUG;
    }
    if k == elf.S_TEXT {
        return nl.C_TEXT;
    }
    if k == elf.S_RODATA {
        for r in s.relocs.items() {
            if is_abs64(r.ty) {
                return nl.C_DATA;
            }
        }
        return nl.C_CONST;
    }
    if k == elf.S_DATA {
        return nl.C_DATA;
    }
    if k == elf.S_BSS {
        return nl.C_BSS;
    }
    if k == elf.S_TDATA {
        return nl.C_TDATA;
    }
    return nl.C_TBSS;
}

// -----------------------------------------------------------------------------
// Symbols
// -----------------------------------------------------------------------------
fn collect_symbols() void {
    nl.define_globals();
    nl.use_unavailable();
    // What is still undefined must come from libSystem: C library names,
    // never our own (module-qualified) ones.
    for gi in 0..nl.gsyms.len {
        let g = nl.gsyms.at(gi);
        if (g.obj < 0) and ((u.find(g.name, '.') >= 0) or (u.find(g.name, '/') >= 0)) {
            nl.err(u.f1("undefined symbol '%s'", g.name));
        }
    }
}

// Frameworks whose install names are not Versions/A.
let FRAMEWORKS_C: [2][]u8 = ["AppKit", "Foundation"];

// The install name of the library an extern block names; "" for libSystem.
fn dylib_path(name: []u8) []u8 {
    if u.find(name, '/') >= 0 {
        return name;  // a path
    }
    if u.str_eq(name, "c") or u.str_eq(name, "m") or u.str_eq(name, "pthread") or u.str_eq(name, "System") or
       u.str_eq(name, "dl") {
        return "";
    }
    if u.str_eq(name, "objc") {
        return "/usr/lib/libobjc.A.dylib";
    }
    if u.ends(name, ".dylib") {
        return u.cat2("/usr/lib/", name);
    }
    if (name.len > 0) and (name[0] >= 'a') and (name[0] <= 'z') {
        return u.cat3("/usr/lib/lib", name, ".dylib");  // "z": libz
    }
    let mut ver: []u8 = "A";
    for f in FRAMEWORKS_C {
        if u.str_eq(f, name) {
            ver = "C";
        }
    }
    return u.f3("/System/Library/Frameworks/%s.framework/Versions/%s/%s", name, ver, name);
}

// A library's ordinal (by its install name; "": libSystem's, 1), the
// library added if new.
fn dylib_ordinal(path: []u8) u32 {
    if (path.len == 0) or u.str_eq(path, "/usr/lib/libSystem.B.dylib") {
        return 1;
    }
    for j in 0..dylibs.len {
        if u.str_eq(dylibs.get(j), path) {
            return @int_cast(u32, j) + 2;
        }
    }
    dylibs.push(u.dup(path));
    return @int_cast(u32, dylibs.len) + 1;
}

// The libraries that extern blocks named (the functions of Windows DLLs
// are the runtime's ax_unavailable: nl.use_unavailable), then those given
// to the link (their exports' ordinals, where no extern block named
// another library), and those named with -l only.
fn collect_dylibs() void {
    for f in nl.extern_fns(nl.is_windows_dll).items() {
        import_ord.put(u.intern(f.name), dylib_ordinal(dylib_path(f.lib)));
    }
    for lib in g_dylibs.items() {
        let ord = dylib_ordinal(lib.install);
        for n in lib.names.items() {
            if import_ord.get(n) == 0 {
                import_ord.put(n, ord);
            }
        }
    }
    flat = false;
    for n in g_by_name.items() {
        let path = dylib_path(n);
        if path.len > 0 {
            _ = dylib_ordinal(path);
            flat = true;
        }
    }
}

// The ordinal of the library that exports name (without its underscore).
fn ordinal_of(name: []u8) u32 {
    let k = import_ord.get(u.intern(name));
    if k == 0 {
        if flat {
            return FLAT_LOOKUP;
        }
        return 1;
    }
    return k;
}

// An LC_LOAD_DYLIB's size for an install name.
fn dylib_cmd_size(path: []u8) u64 {
    return nl.align_up(24 + @as(u64, path.len) + 1, 8);
}

fn load_dylib(h: *mut bn.Bytes, path: []u8, current: u64) void {
    let size = dylib_cmd_size(path);
    h.u32_(0xc);  // LC_LOAD_DYLIB
    h.u32_(size);
    h.u32_(24);           // the name's offset
    h.u32_(2);            // timestamp
    h.u32_(current);      // current version
    h.u32_(0x0001_0000);  // compatibility version 1.0
    h.put(path);
    for _k in @as(u64, path.len) + 24..size {
        h.u8_(0);
    }
}

// From a library?
fn is_import(oi: usize, si: u32) bool {
    let gi = nl.global_of(oi, si);
    return (gi >= 0) and (nl.gsyms.at(@int_cast(usize, gi)).obj < 0);
}

fn import_name(oi: usize, si: u32) []u8 {
    return bound_name(nl.objs.get(oi).syms.get(@as(usize, si)).name);
}

// The functions whose x86-64 libSystem names without a suffix use the
// structures with 32-bit inode numbers (struct stat, struct dirent, DIR,
// struct statfs); their $INODE64 variants use the 64-bit ones, which are
// the only ones arm64 has (and std/internal/runtime/darwin.ax's layouts).
let INODE64_FNS: [16][]u8 = ["stat", "lstat", "fstat", "fstatat", "statfs", "fstatfs", "getfsstat", "opendir",
                             "fdopendir", "readdir", "readdir_r", "rewinddir", "seekdir", "telldir", "scandir",
                             "alphasort"];

// A function's name from the name it is bound by (bound_name).
fn unbound_name(b: []u8) []u8 {
    if not u.starts(b, "_") {
        return u.cat2("\x01", b);  // (a name as it is)
    }
    let mut n = b[1..];
    let k = u.find(n, '$');
    if k >= 0 {
        n = n[0..@int_cast(usize, k)];
    }
    return n;
}

// The name in libSystem of an imported function: with the Mach-O
// underscore (and on x86-64 the suffix of the variant, above). The
// runtime's __axiom_libc_<name> is libSystem's <name>
// (std/internal/runtime/darwin.ax): the C library's functions of the same
// names (exit, malloc, ...) are a C program's own, which the runtime must
// not call in their place.
fn bound_name(name0: []u8) []u8 {
    if (name0.len > 0) and (name0[0] == 1) {
        return name0[1..];  // (a name as it is: no underscore)
    }
    let mut name = name0;
    if u.starts(name, "__axiom_libc_") {
        name = name[13..];
    }
    if X64 {
        for f in INODE64_FNS {
            if u.str_eq(f, name) {
                return u.f1("_%s$INODE64", name);
            }
        }
    }
    return u.cat2("_", name);
}

// GOT slots and stubs the relocations need.
fn scan_relocs() void {
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        for k in 0..o.secs.len {
            let s = o.secs.get(k);
            if (nl.sec_cls.get(oi)[k] == nl.C_DEBUG) or (nl.sec_cls.get(oi)[k] == C_CU) {
                continue;  // (nl.debug_sections; unwind_entries)
            }
            for r in s.relocs.items() {
                if is_tlvp(r.ty) {
                    // a descriptor: the image's own (reached directly), or a
                    // library's, from its GOT slot
                    if is_import(oi, r.sym) {
                        let n = o.syms.get(@as(usize, r.sym)).name;
                        if (import_ord.get(u.intern(n)) == 0) and not flat and
                           (r.ty != elf.R_AARCH64_AXIOM_TLVP_PAGEOFF) {
                            nl.err(u.f1("undefined thread-local '%s' (no library given to the link defines it)", n));
                        }
                        _ = nl.got_slot(oi, r.sym);
                    } else if r.ty != elf.R_AARCH64_AXIOM_TLVP_PAGEOFF {
                        _ = tls_scheme_check(oi, r.sym, true);
                    }
                } else if (X64 and (r.ty == elf.R_X86_64_TPOFF32)) or (not X64 and nl.is_a64_tls(r.ty)) {
                    // (an offset in the runtime's block: the --macos-tls=fast code's)
                    _ = tls_scheme_check(oi, r.sym, false);
                } else if nl.is_got_reloc(X64, r.ty) {
                    _ = nl.got_slot(oi, r.sym);
                } else if is_import(oi, r.sym) {
                    if nl.is_call_reloc(X64, r.ty) {
                        _ = nl.got_slot(oi, r.sym);
                        let g = nl.gsyms.at(@as(usize, @bit_cast(u32, nl.global_of(oi, r.sym))));
                        if g.stub < 0 {
                            g.stub = @int_cast(i32, stubs.len);
                            stubs.push(@bit_cast(u32, nl.global_of(oi, r.sym)));
                        }
                    } else if not is_abs64(r.ty) {
                        nl.err(u.f1("'%s' (from a library) cannot be referenced this way",
                                    nl.objs.get(oi).syms.get(@as(usize, r.sym)).name));
                    }
                }
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Layout
// -----------------------------------------------------------------------------
// File offset of an address in __TEXT or __DATA.
fn file_of(addr: u64) u64 {
    if addr >= data_addr {
        return data_off + (addr - data_addr);
    }
    return addr - image_base;
}

// -----------------------------------------------------------------------------
// Relocation
// -----------------------------------------------------------------------------
// An absolute address at p (in __DATA): dyld slides it.
fn rebase_at(p: u64) void {
    if p < data_addr {
        nl.err("internal: an absolute address outside __DATA");
        return;
    }
    rebases.push(p - data_addr);
}

fn apply_relocs(b: []mut u8) void {
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        for k in 0..o.secs.len {
            let s = o.secs.get(k);
            let cls = nl.sec_cls.get(oi)[k];
            if (cls == nl.C_BSS) or (cls == nl.C_TBSS) or (cls == nl.C_DEBUG) or (cls == C_TLV_BSS) or (cls == C_CU) {
                continue;
            }
            let base = nl.sec_addr.get(oi)[k];
            for r in s.relocs.items() {
                let p = base + r.off;
                let fo = file_of(p);
                let t = r.ty;
                if (cls == C_TLVD) and nl.sym_dropped(oi, r.sym) {
                    continue;  // (a thread-local the link left out: the descriptor's offset 0)
                }
                if (cls == C_TLVD) and is_abs64(t) {
                    // a descriptor's offset of its variable in our block
                    bn.w64(b, fo, (nl.sym_addr(oi, r.sym) +% @bit_cast(u64, r.addend)) -% tls_addr);
                    continue;
                }
                if (cls == C_TLV) and ((r.off % 24) == 16) and is_abs64(t) {
                    // a descriptor's offset of its variable in the template
                    bn.w64(b, fo, (nl.sym_addr(oi, r.sym) +% @bit_cast(u64, r.addend)) -% tlv_start);
                    continue;
                }
                let imp = is_import(oi, r.sym);
                let mut sv = nl.sym_addr(oi, r.sym);
                if imp and nl.is_call_reloc(X64, t) {
                    let g = nl.gsyms.at(@as(usize, @bit_cast(u32, nl.global_of(oi, r.sym))));
                    sv = stub_addr + (@as(u64, @bit_cast(u32, g.stub)) * stub_size());
                }
                if is_tlvp(t) {
                    tlvp_reloc(b, fo, p, t, oi, r.sym, imp, sv, r.addend);
                    continue;
                }
                if nl.is_got_reloc(X64, t) {
                    let ga = got_addr + (@as(u64, @bit_cast(u32, nl.got_slot(oi, r.sym))) * 8);
                    if not X64 {
                        nl.a64_got(b, fo, p, t, ga);
                    } else if not imp and nl.x64_relax(b, fo, t) {
                        rel32(b, fo, p, sv +% @bit_cast(u64, r.addend));  // (lea of our own symbol)
                    } else {
                        rel32(b, fo, p, ga +% @bit_cast(u64, r.addend));
                    }
                    continue;
                }
                let sa = sv +% @bit_cast(u64, r.addend);
                if is_abs64(t) {
                    if imp {
                        binds.push(Import.{ seg_off: p - data_addr, name: import_name(oi, r.sym), addend: r.addend });
                        bn.w64(b, fo, 0);
                    } else {
                        rebase_at(p);
                        bn.w64(b, fo, sa);
                    }
                    continue;
                }
                if X64 {
                    x64_reloc(b, fo, p, t, sa);
                    continue;
                }
                if nl.a64_reloc(b, fo, p, t, sa) {
                    continue;
                }
                if nl.is_a64_tls(t) {
                    // the offset in the thread's block
                    let v = @bit_cast(i64, sa -% tls_addr);
                    nl.a64_tls(b, fo, t, v, v);
                } else {
                    nl.err(u.f1("unsupported relocation type %s", u.udec(@as(u64, t))));
                }
            }
        }
    }
}

// A thread-local descriptor reference at p (file offset fo): of a
// descriptor of the image (sv, ours or a platform object's), the address
// itself, the GOT load relaxed as the platform's linker relaxes it (arm64:
// the page's ldr becomes an add; x86-64: movq becomes leaq); of a
// library's, its GOT slot, which dyld binds.
fn tlvp_reloc(b: []mut u8, fo: u64, p: u64, t: u32, oi: usize, sym: u32, imp: bool, sv: u64, addend: i64) void {
    let mut target = sv;
    if imp {
        target = got_addr + (@as(u64, @bit_cast(u32, nl.got_slot(oi, sym))) * 8);
    }
    if t == elf.R_X86_64_AXIOM_TLV {
        if not imp {
            if (fo < 2) or (b[@truncate(usize, fo - 2)] != 0x8b) {
                nl.err("sym@TLVP outside a movq (the descriptor's address is loaded into a register)");
                return;
            }
            b[@truncate(usize, fo - 2)] = 0x8d;  // movq -> leaq
        }
        rel32(b, fo, p, target +% @bit_cast(u64, addend));
        return;
    }
    if t == elf.R_AARCH64_AXIOM_TLVP_PAGE {
        nl.a64_adrp(b, fo, p, target);
        return;
    }
    if not imp {
        // ldr xt, [xn, #off] (64-bit, unsigned offset) -> add xt, xn, #off
        let w = bn.rd32(b, @truncate(usize, fo));
        if (w & 0xffc0_0000) != 0xf940_0000 {
            nl.err("@TLVPPAGEOFF outside a 64-bit ldr (the descriptor's address is loaded from its GOT slot)");
            return;
        }
        bn.w32(b, fo, 0x9100_0000 | (w & 0x3ff) | ((target & 0xfff) << 10));
        return;
    }
    nl.a64_imm12(b, fo, (target & 0xfff) >> 3);
}

// A 32-bit displacement at p (file offset fo) to target (x86-64: from the
// end of the field, as the relocations' addends of -4 have it).
fn rel32(b: []mut u8, fo: u64, p: u64, target: u64) void {
    let v = @bit_cast(i64, target) - @bit_cast(i64, p);
    if (v < -0x8000_0000) or (v > 0x7fff_ffff) {
        nl.err(u.f2("relocation out of range (pc32): at %s, to %s", u.hex16(p), u.hex16(target)));
    }
    bn.w32(b, fo, @bit_cast(u64, v) & 0xFFFF_FFFF);
}

// The x86-64 relocations but GOT ones and absolute addresses: calls, jumps
// and RIP-relative references (to a stub for a library's function), and a
// thread-local's offset in the thread's block (TPOFF32: x64.ax addresses
// thread-locals as [block + offset]).
fn x64_reloc(b: []mut u8, fo: u64, p: u64, t: u32, sa: u64) void {
    if nl.is_call_reloc(true, t) {
        rel32(b, fo, p, sa);
    } else if t == elf.R_X86_64_PC64 {
        bn.w64(b, fo, sa -% p);  // (a place-relative 8-byte address: __eh_frame's)
    } else if t == elf.R_X86_64_TPOFF32 {
        let v = @bit_cast(i64, sa -% tls_addr);
        if (v < 0) or (v > 0x7fff_ffff) {
            nl.err("thread-local offset out of range");
        }
        bn.w32(b, fo, @bit_cast(u64, v));
    } else {
        // (R_X86_64_32 and 32S: absolute 32-bit addresses, which a
        // position-independent image cannot hold)
        nl.err(u.f1("unsupported relocation type %s", u.udec(@as(u64, t))));
    }
}

// -----------------------------------------------------------------------------
// The linker's own object: the thread-local record (axiom.tls_key is its
// first word) and ax_tls_info(), which returns its address.
// -----------------------------------------------------------------------------
fn own_object() *mut elf.Obj {
    let o = elf.new_obj(machine());
    let text = elf.add_sec(o, ".text", elf.S_TEXT, 4);
    let data = elf.add_sec(o, ".data", elf.S_DATA, 8);
    let ds = o.secs.get(@int_cast(usize, data));
    ds.data.zeros(56);
    let info = elf.add_sym(o, elf.Sym.{ name: "axiom.tls_key", sec: data, value: 0, size: 56, bind: elf.B_GLOBAL,
                                        ty: elf.T_OBJECT, hidden: true });
    _ = elf.add_sym(o, elf.Sym.{ name: "ax_tls_info", sec: text, value: 0, size: 12, bind: elf.B_GLOBAL, ty: elf.T_FUNC,
                                 hidden: true });
    let ts = o.secs.get(@int_cast(usize, text));
    if X64 {
        let code: [8]u8 = [0x48, 0x8d, 0x05, 0, 0, 0, 0,  // lea rax, [rip + info]
                           0xc3];  // ret
        ts.data.put(code[..]);
        ts.relocs.push(elf.Rel.{ off: 3, ty: elf.R_X86_64_PC32, sym: info, addend: -4 });
        return o;
    }
    ts.relocs.push(elf.Rel.{ off: 0, ty: elf.R_AARCH64_ADR_PREL_PG_HI21, sym: info, addend: 0 });
    ts.data.u32_(0x9000_0000);  // adrp x0, info
    ts.relocs.push(elf.Rel.{ off: 4, ty: elf.R_AARCH64_ADD_ABS_LO12_NC, sym: info, addend: 0 });
    ts.data.u32_(0x9100_0000);  // add x0, x0, :lo12:info
    ts.data.u32_(0xd65f_03c0);  // ret
    return o;
}

// -----------------------------------------------------------------------------
// The Mach-O file
// -----------------------------------------------------------------------------
fn name16(h: *mut bn.Bytes, s: []u8) void {
    for i in @as(usize, 0)..16 {
        if i < s.len {
            h.u8_(s[i]);
        } else {
            h.u8_(0);
        }
    }
}

fn segment(h: *mut bn.Bytes, name: []u8, vmaddr: u64, vmsize: u64, fileoff: u64, filesize: u64, prot: u64,
           nsects: u64) void {
    h.u32_(0x19);  // LC_SEGMENT_64
    h.u32_(72 + (nsects * 80));
    name16(h, name);
    h.u64_(vmaddr);
    h.u64_(vmsize);
    h.u64_(fileoff);
    h.u64_(filesize);
    h.u32_(prot);  // maxprot
    h.u32_(prot);  // initprot
    h.u32_(nsects);
    h.u32_(0);
}

fn section(h: *mut bn.Bytes, name: []u8, seg: []u8, addr: u64, size: u64, offset: u64, align: u64, flags: u64) void {
    name16(h, name);
    name16(h, seg);
    h.u64_(addr);
    h.u64_(size);
    h.u32_(offset);
    let mut lg: u64 = 0;
    while (@as(u64, 1) << lg) < align {
        lg += 1;
    }
    h.u32_(lg);
    h.u32_(0);  // reloff
    h.u32_(0);  // nreloc
    h.u32_(flags);
    h.u32_(0);
    h.u32_(0);
    h.u32_(0);
}

fn be32(b: *mut bn.Bytes, x: u64) void {
    b.u8_(@truncate(u8, x >> 24));
    b.u8_(@truncate(u8, x >> 16));
    b.u8_(@truncate(u8, x >> 8));
    b.u8_(@truncate(u8, x));
}

fn be64(b: *mut bn.Bytes, x: u64) void {
    be32(b, x >> 32);
    be32(b, x & 0xFFFF_FFFF);
}

// The ad-hoc signature of file[0..limit]: a superblob holding one code
// directory (version 0x20400, linker-signed) with a SHA-256 hash per 4 KiB
// page. Its size is known before the hashes are.
fn signature_size(ident: []u8, limit: u64) u64 {
    let npages = (limit + CS_PAGE - 1) / CS_PAGE;
    let cd = nl.align_up(88 + @as(u64, ident.len) + 1, 16) + (npages * 32);
    return nl.align_up(24 + cd, 16);
}

fn signature(file: []u8, ident: []u8, limit: u64, text_size: u64) []u8 {
    let npages = (limit + CS_PAGE - 1) / CS_PAGE;
    let hash_off = nl.align_up(88 + @as(u64, ident.len) + 1, 16);
    let cd_len = hash_off + (npages * 32);
    let total = signature_size(ident, limit);
    let mut b = bn.new_bytes();
    be32(&mut b, 0xfade_0cc0);  // CSMAGIC_EMBEDDED_SIGNATURE
    be32(&mut b, total);
    be32(&mut b, 1);  // one blob
    be32(&mut b, 0);  // CSSLOT_CODEDIRECTORY
    be32(&mut b, 24);
    be32(&mut b, 0);            // (padding to 8)
    be32(&mut b, 0xfade_0c02);  // CSMAGIC_CODEDIRECTORY
    be32(&mut b, cd_len);
    be32(&mut b, 0x20400);
    be32(&mut b, 0x20002);  // CS_ADHOC | CS_LINKER_SIGNED
    be32(&mut b, hash_off);
    be32(&mut b, 88);  // identOffset
    be32(&mut b, 0);   // nSpecialSlots
    be32(&mut b, npages);
    be32(&mut b, limit);
    b.u8_(32);                              // hashSize
    b.u8_(2);                               // hashType: SHA-256
    b.u8_(0);                               // platform
    b.u8_(12);                              // log2 of the page size
    be32(&mut b, 0);                        // spare2
    be32(&mut b, 0);                        // scatterOffset
    be32(&mut b, 0);                        // teamOffset
    be32(&mut b, 0);                        // spare3
    be64(&mut b, 0);                        // codeLimit64
    be64(&mut b, 0);                        // execSegBase
    be64(&mut b, text_size);                // execSegLimit
    be64(&mut b, u64_pick(g_dylib, 0, 1));  // CS_EXECSEG_MAIN_BINARY (not for a dynamic library)
    b.put(ident);
    b.u8_(0);
    while @as(u64, b.len()) < (24 + hash_off) {
        b.u8_(0);
    }
    let mut h: [32]u8 = [0; 32];
    for i in @as(u64, 0)..npages {
        let lo = i * CS_PAGE;
        let hi = @min(lo + CS_PAGE, limit);
        sha2.sha256(file[@truncate(usize, lo)..@truncate(usize, hi)], h[..]);
        b.put(h[..]);
    }
    while @as(u64, b.len()) < total {
        b.u8_(0);
    }
    return b.view();
}

// The export trie: __mh_execute_header (at the image's start) only.
// The exports' trie (dyld's lookups walk it): an executable's
// __mh_execute_header, a dynamic library's exports; one character an edge
// (so no two edges of a node share a prefix), each terminal node's
// information its flags (0: a regular symbol) and the offset from the
// image's start. The nodes' offsets (ULEB128, whose sizes depend on them)
// are found by iterating until they stay put.
struct TNode {
    term: bool,
    value: u64,
    kids: u.List.[u64],  // character << 32 | node
    at: u64,
}

fn export_trie() []u8 {
    let mut names = u.List.[[]u8].empty();
    let mut values = u.List.[u64].empty();
    if g_dylib {
        for gi in dylib_exports.items() {
            let g = nl.gsyms.get(@as(usize, gi));
            names.push(bound_name(g.name));
            values.push(nl.sym_addr_in(@as(usize, @bit_cast(u32, g.obj)), g.sym) - image_base);
        }
    } else {
        names.push("__mh_execute_header");
        values.push(0);
    }
    let mut nodes = u.List.[TNode].empty();
    nodes.push(TNode.{ term: false, value: 0, kids: u.List.[u64].empty(), at: 0 });
    for k in 0..names.len {
        let mut n: usize = 0;
        for c in names.get(k) {
            let mut next: usize = 0;
            for x in nodes.at(n).kids.items() {
                if (x >> 32) == @as(u64, c) {
                    next = @truncate(usize, x & 0xffff_ffff);
                }
            }
            if next == 0 {
                nodes.push(TNode.{ term: false, value: 0, kids: u.List.[u64].empty(), at: 0 });
                next = nodes.len - 1;
                nodes.at(n).kids.push((@as(u64, c) << 32) | @as(u64, next));
            }
            n = next;
        }
        nodes.at(n).term = true;
        nodes.at(n).value = values.get(k);
    }
    // the offsets
    let mut changed = true;
    while changed {
        changed = false;
        let mut pos: u64 = 0;
        for i in 0..nodes.len {
            let x = nodes.at(i);
            if x.at != pos {
                x.at = pos;
                changed = true;
            }
            let mut size: u64 = 1;  // (the terminal size: 0, or below)
            if x.term {
                let ts = 1 + uleb_size(x.value);
                size = uleb_size(ts) + ts;
            }
            size += 1;  // the number of edges
            for kd in x.kids.items() {
                size += 2 + uleb_size(nodes.get(@truncate(usize, kd & 0xffff_ffff)).at);
            }
            pos += size;
        }
    }
    let mut t = bn.new_bytes();
    for i in 0..nodes.len {
        let x = nodes.get(i);
        if x.term {
            t.uleb(1 + uleb_size(x.value));
            t.u8_(0);  // flags: a regular symbol
            t.uleb(x.value);
        } else {
            t.u8_(0);
        }
        t.u8_(@truncate(u8, @as(u64, x.kids.len)));
        for kd in x.kids.items() {
            t.u8_(@truncate(u8, kd >> 32));
            t.u8_(0);
            t.uleb(nodes.get(@truncate(usize, kd & 0xffff_ffff)).at);
        }
    }
    t.align(8);
    return t.view();
}

fn uleb_size(x: u64) u64 {
    let mut n: u64 = 1;
    let mut v = x >> 7;
    while v != 0 {
        n += 1;
        v = v >> 7;
    }
    return n;
}

// The external symbols defined: a dynamic library's exports, or an
// executable's header and main.
fn n_extdef() u64 {
    if g_dylib {
        return @as(u64, dylib_exports.len);
    }
    return 2;
}

// A dynamic library's exports (see g_dylib), sorted by their Mach-O names.
let mut dylib_exports: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };
let mut n_inputs: usize = 0;
let mut install_name: []u8 = "";

fn collect_exports() void {
    dylib_exports = u.List.[u32].empty();
    for gi in 0..nl.gsyms.len {
        let g = nl.gsyms.get(gi);
        if (g.obj < 0) or (@as(usize, @bit_cast(u32, g.obj)) >= n_inputs) {
            continue;
        }
        let sy = nl.objs.get(@as(usize, @bit_cast(u32, g.obj))).syms.get(@as(usize, g.sym));
        if sy.hidden or (sy.bind == elf.B_LOCAL) or elf.is_part_name(sy.name) or u.starts(sy.name, "axiom.") or
           u.starts(sy.name, "__start_") or u.starts(sy.name, "__stop_") or (sy.ty == elf.T_TLS) {
            continue;
        }
        dylib_exports.push(@truncate(u32, gi));
    }
    u.sort.[u32](dylib_exports.items(), cmp_export);
}

fn cmp_export(a: u32, b: u32) i32 {
    return u.str_cmp(bound_name(nl.gsyms.get(@as(usize, a)).name), bound_name(nl.gsyms.get(@as(usize, b)).name));
}

// Runs of consecutive words are one opcode (programs hold many tables of
// addresses).
fn rebase_info() []u8 {
    let mut b = bn.new_bytes();
    let rs = rebases.items();
    u.sort.[u64](rs, cmp_u64);
    b.u8_(0x11);  // REBASE_OPCODE_SET_TYPE_IMM | REBASE_TYPE_POINTER
    b.u8_(0x20 | @truncate(u8, seg_data()));  // REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB
    b.uleb(0);
    let mut cur: u64 = 0;  // the opcodes' address (dyld's), as a segment offset
    let mut i: usize = 0;
    while i < rs.len {
        let start = rs[i];
        let mut n: u64 = 1;
        while ((i + 1) < rs.len) and (rs[i + 1] == (start + (n * 8))) {
            n += 1;
            i += 1;
        }
        if (i + 1) < rs.len {
            // skip duplicates (the same word relocated twice)
            while ((i + 1) < rs.len) and (rs[i + 1] < (start + (n * 8))) {
                i += 1;
            }
        }
        i += 1;
        if start != cur {
            b.u8_(0x30);  // REBASE_OPCODE_ADD_ADDR_ULEB
            b.uleb(start - cur);
        }
        b.u8_(0x60);  // REBASE_OPCODE_DO_REBASE_ULEB_TIMES (each advances a word)
        b.uleb(n);
        cur = start + (n * 8);
    }
    b.u8_(0);  // REBASE_OPCODE_DONE
    b.align(8);
    return b.view();
}

fn cmp_u64(a: u64, b: u64) i32 {
    if a < b {
        return -1;
    }
    if a > b {
        return 1;
    }
    return 0;
}

fn bind_info() []u8 {
    let mut b = bn.new_bytes();
    b.u8_(0x51);  // BIND_OPCODE_SET_TYPE_IMM | BIND_TYPE_POINTER
    let mut ord: u32 = 0;
    for x in binds.items() {
        let o = ordinal_of(unbound_name(x.name));
        if o != ord {
            ord = o;
            if o == FLAT_LOOKUP {
                b.u8_(0x3e);  // BIND_OPCODE_SET_DYLIB_SPECIAL_IMM: BIND_SPECIAL_DYLIB_FLAT_LOOKUP (-2)
            } else if o < 16 {
                b.u8_(0x10 | @truncate(u8, o));  // BIND_OPCODE_SET_DYLIB_ORDINAL_IMM
            } else {
                b.u8_(0x20);  // BIND_OPCODE_SET_DYLIB_ORDINAL_ULEB
                b.uleb(@as(u64, o));
            }
        }
        b.u8_(0x40);  // BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM
        b.put(x.name);
        b.u8_(0);
        b.u8_(0x60);  // BIND_OPCODE_SET_ADDEND_SLEB
        b.sleb(x.addend);
        b.u8_(0x70 | @truncate(u8, seg_data()));  // BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB
        b.uleb(x.seg_off);
        b.u8_(0x90);  // BIND_OPCODE_DO_BIND
    }
    b.u8_(0);  // BIND_OPCODE_DONE
    b.align(8);
    return b.view();
}

// Links `inputs` into the executable `out`. 0: done; 1: errors (reported).
pub fn link(inputs: []*mut elf.Obj, out: []u8) i32 {
    X64 = (inputs.len > 0) and (inputs[0].machine == elf.EM_X86_64);
    image_base = u64_pick(g_dylib, 0, EXEC_BASE);
    install_name = u.cat2("@rpath/", u.basename(out));
    n_inputs = inputs.len;
    nl.begin(inputs);
    nl.g_gc_exports = g_dylib;  // (--gc-sections: a library's exports are kept)
    dylibs = u.List.[[]u8].empty();
    import_ord = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    tls_reported = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    nl.objs.push(leaf_entries(own_object()));  // (its ax_tls_info: a leaf)
    if not g_dylib {
        nl.objs.push(leaf_entries(jstub.build(machine(), false)));  // (C's setjmp and longjmp)
    }
    nl.objs.push(elf.rets_bounds(machine()));
    collect_dylibs();
    collect_symbols();
    let mn = nl.gsym_index("main");
    if (nl.gsyms.at(@as(usize, mn)).obj < 0) and not g_dylib {
        nl.err("no 'main' function");
    }
    nl.classify(class_of);
    has_tlv = false;
    for oi in 0..nl.objs.len {
        for c in nl.sec_cls.get(oi) {
            if (c >= C_TLV) and (c <= C_TLV_BSS) {
                has_tlv = true;
            }
        }
    }
    scan_relocs();
    if g_dylib {
        collect_exports();
        for oi in 0..n_inputs {
            for c in nl.sec_cls.get(oi) {
                if (c == nl.C_TDATA) or (c == nl.C_TBSS) {
                    let o = nl.objs.get(oi);
                    for k in 0..o.secs.len {
                        if (nl.sec_cls.get(oi)[k] == c) and (elf.sec_size(o.secs.get(k)) > 0) {
                            nl.err(u.f1("%s has thread-locals of this compiler's, which a dynamic library cannot have (the runtime that makes their blocks is an executable's)",
                                        nl.obj_name(oi)));
                        }
                    }
                }
            }
        }
    }
    if nl.errors != 0 {
        return 1;
    }
    let ident = u.basename(out);
    let ly = lay_out();
    let mut fileb = bn.new_bytes();
    fileb.zeros(@truncate(usize, data_off + ly.data_filesize));
    let b = fileb.view();
    write_contents(b, &ly);
    if nl.errors != 0 {
        return 1;
    }
    let le = link_edit(&ly, ident);
    let mut h = bn.new_bytes();
    let uuid_at = load_commands(&mut h, &ly, &le);
    if @as(u64, h.len()) != (32 + ly.sizeofcmds) {
        nl.err("internal: load command size");
        return 1;
    }
    bn.put_at(b, 0, h.view());

    // the whole file before the signature
    let mut f = bn.new_bytes();
    f.put(b);
    f.put(le.rebase);
    f.put(le.bind);
    f.put(le.exports);
    f.put(le.symtab.view());
    f.put(le.strtab.view());
    while @as(u64, f.len()) < le.sig_off {
        f.u8_(0);
    }
    // a UUID from the contents (deterministic builds)
    let mut digest: [32]u8 = [0; 32];
    sha2.sha256(f.view(), digest[..]);
    digest[6] = (digest[6] & 0x0f) | 0x40;
    digest[8] = (digest[8] & 0x3f) | 0x80;
    let fv = f.view();
    @mem_copy(fv[uuid_at..uuid_at + 16], digest[0..16]);
    let sig = signature(fv, ident, le.sig_off, ly.text_size);
    f.put(sig);
    let st = write_new(out, f.view());
    if st == 0 {
        return write_dsym(out, digest[0..16], &ly);
    }
    return st;
}

// -----------------------------------------------------------------------------
// Debug information
//
// macOS's debugger reads DWARF from a debug bundle next to the executable,
// <out>.dSYM, whose Contents/Resources/DWARF/<name> is a Mach-O file of type
// MH_DSYM with the executable's UUID: its __DWARF segment holds the
// sections (__debug_info, __debug_line, ...), and its __TEXT segment's
// sections say where the code is (with no contents). The executable itself
// is the same with and without -g (and has no debug map: our objects are
// not kept). Written only when the objects have debug information (-g).
// -----------------------------------------------------------------------------
fn write_dsym(out: []u8, uuid: []u8, ly: *Layout) i32 {
    let dbg = nl.debug_sections();
    if dbg.len == 0 {
        return 0;
    }
    let ncmds: u64 = 3;
    let nsec = @as(u64, dbg.len);
    let sizeofcmds = 24 + (72 + 80) + (72 + (nsec * 80));
    let mut h = bn.new_bytes();
    h.u32_(0xfeed_facf);  // MH_MAGIC_64
    h.u32_(cpu_type());
    h.u32_(cpu_subtype());
    h.u32_(0xa);  // MH_DSYM
    h.u32_(ncmds);
    h.u32_(sizeofcmds);
    h.u32_(0);
    h.u32_(0);
    h.u32_(0x1b);  // LC_UUID
    h.u32_(24);
    h.put(uuid);
    segment(&mut h, "__TEXT", image_base, ly.text_size, 0, 0, 5, 1);
    section(&mut h, "__text", "__TEXT", text_addr, ly.text_end - text_addr, 0, 16, 0x8000_0400);
    let mut size: u64 = 0;
    for k in 0..dbg.len {
        size += @as(u64, dbg.get(k).data.len());
    }
    let dw_off = nl.align_up(32 + sizeofcmds, 16);
    let dw_addr = nl.align_up(data_addr + ly.data_vmsize, PAGE);
    segment(&mut h, "__DWARF", dw_addr, nl.align_up(size, PAGE), dw_off, size, 7, nsec);
    let mut at = dw_off;
    for k in 0..dbg.len {
        let d = dbg.get(k);
        let n = @as(u64, d.data.len());
        section(&mut h, u.f1("__%s", d.name[1..]), "__DWARF", dw_addr + (at - dw_off), n, at, 1, 0x0200_0000);  // S_ATTR_DEBUG
        at += n;
    }
    while @as(u64, h.len()) < dw_off {
        h.u8_(0);
    }
    for k in 0..dbg.len {
        h.put(dbg.at(k).data.view());
        dbg.at(k).data.free();
    }
    let name = u.basename(out);
    let dir = u.f1("%s.dSYM/Contents/Resources/DWARF", out);
    u.mkdirs(dir);
    let plist = u.f3("%s%s%s", "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\">\n<dict>\n",
                     u.f1("\t<key>CFBundleIdentifier</key>\n\t<string>com.apple.xcode.dsym.%s</string>\n", name),
                     "\t<key>CFBundleInfoDictionaryVersion</key>\n\t<string>6.0</string>\n\t<key>CFBundlePackageType</key>\n\t<string>dSYM</string>\n\t<key>CFBundleSignature</key>\n\t<string>????</string>\n\t<key>CFBundleVersion</key>\n\t<string>1</string>\n</dict>\n</plist>\n");
    if not u.write_file(u.f1("%s.dSYM/Contents/Info.plist", out), plist) or
       not u.write_file(u.f2("%s/%s", dir, name), h.view()) {
        nl.err(u.f1("cannot write %s.dSYM", out));
        return 1;
    }
    h.free();
    return 0;
}

// Writes the executable as a new file renamed over `out`: macOS caches an
// executable's code signature with its file, and kills a program rewritten
// in place. 0: done; 1: errors (reported).
fn write_new(out: []u8, d: []u8) i32 {
    let tmp = u.f2("%s.tmp%s", out, u.idec(u.getpid()));
    if not u.write_file(tmp, d) {
        _ = u.unlink(u.cz(tmp));
        nl.err(u.f1("cannot write %s", out));
        return 1;
    }
    _ = u.chmod(u.cz(tmp), 0o755);
    if u.rename(u.cz(tmp), u.cz(out)) != 0 {
        _ = u.unlink(u.cz(tmp));
        nl.err(u.f1("cannot write %s", out));
        return 1;
    }
    return 0;
}

// -----------------------------------------------------------------------------
// Unwind tables (macunwind.ax)
// -----------------------------------------------------------------------------
// o, with unwind entries for its functions, which are leaves without a
// frame (jstub.ax's: setjmp's return address in the link register or at the
// stack pointer throughout; longjmp's until it leaves for setjmp's caller).
fn leaf_entries(o: *mut elf.Obj) *mut elf.Obj {
    let mut out = mu.begin(true, o, X64);
    let mut enc = mu.A64_FRAMELESS;
    if X64 {
        enc = mu.x64_frameless();
    }
    for si in 0..o.syms.len {
        let y = o.syms.get(si);
        if (y.ty != elf.T_FUNC) or (y.sec < 0) {
            continue;
        }
        // (its end: the next function's start, or its section's)
        let mut end = elf.sec_size(o.secs.get(@as(usize, @bit_cast(u32, y.sec))));
        let mut dup = false;
        for z in o.syms.items() {
            if (z.ty == elf.T_FUNC) and (z.sec == y.sec) and (z.value > y.value) and (z.value < end) {
                end = z.value;
            }
        }
        for sj in 0..si {
            let z = o.syms.get(sj);
            if (z.ty == elf.T_FUNC) and (z.sec == y.sec) and (z.value == y.value) {
                dup = true;  // (another name of a function already given)
            }
        }
        if not dup {
            mu.add(&mut out, @truncate(u32, si), 0, end - y.value, enc, u.nil_slice.[u8](), false, false);
        }
    }
    return o;
}

let mut unwind_addr: u64 = 0;
let mut unwind_eh_end: u64 = 0;

// The relocation of section s at offset off (nil: none).
fn reloc_at(s: *elf.Sec, off: u64) *elf.Rel {
    for k in 0..s.relocs.len {
        let r = s.relocs.at(k);
        if r.off == off {
            return r;
        }
    }
    return u.nil.[elf.Rel]();
}

// __unwind_info for the code placed so far, __eh_frame (C_EH) being at
// eh_addr: an entry per function of the objects' compact entries (C_CU),
// those of the DWARF mode with the offset of their function's FDE in
// __eh_frame (a function an object has an FDE for and no compact entry:
// the DWARF mode too), up to code_end (the stubs, which have none).
fn unwind_info(eh_addr: u64, code_end: u64) bn.Bytes {
    let x64 = X64;
    // the FDEs: their functions' addresses and offsets in __eh_frame
    let mut fde_fn = u.List.[u64].empty();
    let mut fde_off = u.List.[u64].empty();
    let mut fde_len = u.List.[u64].empty();
    unwind_eh_end = eh_addr;
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        for k in 0..o.secs.len {
            if nl.sec_cls.get(oi)[k] != C_EH {
                continue;
            }
            let s = o.secs.get(k);
            let d = s.data.view();
            let base = nl.sec_addr.get(oi)[k];
            unwind_eh_end = @max(unwind_eh_end, base + @as(u64, d.len));
            let mut at: usize = 0;
            while (at + 8) <= d.len {
                let n = @truncate(usize, bn.rd32(d, at));
                if (n == 0) or (n == 0xffff_ffff) or ((at + 4 + n) > d.len) {
                    break;  // (a terminator; 64-bit lengths are not written for code)
                }
                let id = @truncate(usize, bn.rd32(d, at + 4));
                if (id != 0) and (id <= (at + 4)) {
                    // (an FDE: its function's address by its relocation, place-relative)
                    let w = mu.enc_size(mu.fde_encoding(d, (at + 4) - id));
                    let r = reloc_at(s, @as(u64, at + 8));
                    if (w > 0) and ((at + 8 + (2 * w)) <= d.len) and u.notnil(r) and not nl.sym_dropped(oi, r.sym) {
                        fde_fn.push(nl.sym_addr(oi, r.sym) +% @bit_cast(u64, r.addend));
                        fde_off.push((base + @as(u64, at)) - eh_addr);
                        if w == 8 {
                            fde_len.push(bn.rd64(d, at + 16));
                        } else {
                            fde_len.push(bn.rd32(d, at + 12));
                        }
                    }
                }
                at += 4 + n;
            }
        }
    }
    let mut ents = u.List.[mu.Ent].empty();
    let mut covered = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        for k in 0..o.secs.len {
            if nl.sec_cls.get(oi)[k] != C_CU {
                continue;
            }
            let s = o.secs.get(k);
            let d = s.data.view();
            let mut at: usize = 0;
            while (at + 32) <= d.len {
                let r = reloc_at(s, @as(u64, at));
                if u.isnil(r) or nl.sym_dropped(oi, r.sym) {
                    at += 32;
                    continue;
                }
                let addr = nl.sym_addr(oi, r.sym) +% @bit_cast(u64, r.addend);
                // (no personality function or LSDA: the table has none)
                let mut enc = @truncate(u32, bn.rd32(d, at + 12)) & ~@as(u32, 0x7000_0000);
                if mu.is_dwarf(enc, x64) {
                    enc = 0;
                    for j in 0..fde_fn.len {
                        if fde_fn.get(j) == addr {
                            enc = mu.dwarf_mode(x64) | @truncate(u32, fde_off.get(j));
                            break;
                        }
                    }
                }
                ents.push(mu.Ent.{ off: addr - image_base, len: bn.rd32(d, at + 8), enc: enc });
                covered.put(u.intern(u.hex16(addr)), 1);
                at += 32;
            }
        }
    }
    for j in 0..fde_fn.len {
        let a = fde_fn.get(j);
        if covered.get(u.intern(u.hex16(a))) == 0 {
            ents.push(
                mu.Ent.{
                    off: a - image_base, len: fde_len.get(j),
                    enc: mu.dwarf_mode(x64) | @truncate(u32, fde_off.get(j)) });
        }
    }
    if (fde_off.len > 0) and (fde_off.last() >= 0x100_0000) {
        nl.err("__eh_frame is larger than the 16 MiB the compact entries can reach");
    }
    let mut all = mu.sorted(ents.items());
    // the functions without an entry: encoding 0
    let mut more = u.List.[mu.Ent].empty();
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        for si in 0..o.syms.len {
            let y = o.syms.get(si);
            if (y.ty != elf.T_FUNC) or (y.sec < 0) or
               (nl.sec_cls.get(oi)[@as(usize, @bit_cast(u32, y.sec))] != nl.C_TEXT) or
               nl.sym_dropped(oi, @truncate(u32, si)) {
                continue;
            }
            let off = nl.sym_addr(oi, @truncate(u32, si)) - image_base;
            if not mu.covers(all.items(), off) {
                more.push(mu.Ent.{ off: off, len: y.size, enc: 0 });
            }
        }
    }
    if (more.len > 0) or (all.len == 0) {
        for e in all.items() {
            more.push(e);
        }
        if more.len == 0 {
            more.push(mu.Ent.{ off: text_addr - image_base, len: code_end - text_addr, enc: 0 });
        }
        all.deinit();
        all = mu.sorted(more.items());
    }
    more.deinit();
    let b = mu.info(all.items());
    ents.deinit();
    all.deinit();
    fde_fn.deinit();
    fde_off.deinit();
    fde_len.deinit();
    return b;
}

// Where the link puts things (beyond the addresses relocation uses).
struct Layout {
    ncmds: u64,  // the load commands
    sizeofcmds: u64,
    text_end: u64,  // __text (code, stubs) ends
    const_addr: u64,
    const_end: u64,
    eh_addr: u64,     // __eh_frame (then __unwind_info at unwind_addr)
    text_size: u64,   // __TEXT's
    ngot: u64,        // GOT slots
    data_start: u64,  // __data
    data_end: u64,
    tlv_vars: u64,  // __thread_vars, __thread_data (from tlv_start), __thread_bss
    tlv_vars_end: u64,
    tlv_data_end: u64,
    tlv_bss: u64,
    tlv_bss_end: u64,
    tlvd_at: u64,  // the thread-locals' descriptors (in __data, after the template)
    tlvd_end: u64,
    init_at: u64,  // a dynamic library's __mod_init_func, then __mod_term_func
    init_end: u64,
    fini_end: u64,
    bss_addr: u64,
    bss_end: u64,
    data_filesize: u64,  // __DATA's
    data_vmsize: u64,
}

// Places __TEXT (after the load commands) and __DATA.
fn lay_out() Layout {
    // the load commands' size, which places everything after them
    let mut ncmds: u64 = 13;
    let mut sizeofcmds: u64 = (72 + (72 + (4 * 80)) + (72 + (3 * 80)) + 72) + 48 + 24 + 80 + 32 + 24 + 24 + 24 + 56 +
                              16;
    if has_tlv {
        sizeofcmds += 3 * 80;
    }
    if g_dylib {
        // no __PAGEZERO, LC_LOAD_DYLINKER, LC_MAIN; LC_ID_DYLIB; the
        // initializers' and terminators' sections
        ncmds -= 2;
        sizeofcmds = (sizeofcmds - 72 - 32 - 24) + dylib_cmd_size(install_name) + (2 * 80);
    }
    for d in dylibs.items() {
        ncmds += 1;
        sizeofcmds += dylib_cmd_size(d);
    }

    // __TEXT
    text_addr = nl.align_up(image_base + 32 + sizeofcmds, 16);
    let code_end = nl.place(nl.C_TEXT, text_addr);
    stub_addr = nl.align_up(code_end, 4);
    let text_end = stub_addr + (@as(u64, stubs.len) * stub_size());
    let const_addr = nl.align_up(text_end, nl.class_align(nl.C_CONST));
    let const_end = nl.place(nl.C_CONST, const_addr);
    let eh_addr = nl.align_up(const_end, 8);
    let eh_end = nl.place(C_EH, eh_addr);
    unwind_addr = nl.align_up(eh_end, 4);
    unwind = unwind_info(eh_addr, stub_addr);
    let text_size = nl.align_up((unwind_addr + @as(u64, unwind.len())) - image_base, PAGE);

    // __DATA: GOT slots that dyld binds (libSystem) or rebases (our own
    // symbols), data, the thread-local template, then .bss
    let ngot = @as(u64, nl.got_sym.len);
    data_addr = image_base + text_size;
    data_off = text_size;
    got_addr = data_addr;
    let data_start = nl.align_up(got_addr + (ngot * 8), 16);
    let mut data_end = nl.place(nl.C_DATA, data_start);
    tls_align = @max(nl.class_align(nl.C_TDATA), nl.class_align(nl.C_TBSS));
    tls_addr = nl.align_up(data_end, @max(tls_align, 16));
    let tdata_end = nl.place(nl.C_TDATA, tls_addr);
    let tbss_end = nl.place(nl.C_TBSS, nl.align_up(tdata_end, nl.class_align(nl.C_TBSS)));
    tls_filesz = tdata_end - tls_addr;
    tls_memsz = tbss_end - tls_addr;
    data_end = tdata_end;
    let tlvd_at = nl.align_up(data_end, 8);
    data_end = nl.place(C_TLVD, tlvd_at);
    let tlvd_end = data_end;
    let init_at = nl.align_up(data_end, 8);
    let init_end = nl.place(C_INIT, init_at);
    let fini_end = nl.place(C_FINI, init_end);
    if g_dylib {
        data_end = fini_end;
    }
    // the platform's thread-local variables: descriptors, the template's
    // data, then (zero-filled) the rest of the template
    let tlv_vars = nl.align_up(data_end, 8);
    let tlv_vars_end = nl.place(C_TLV, tlv_vars);
    tlv_start = nl.align_up(tlv_vars_end, @max(nl.class_align(C_TLV_DATA), nl.class_align(C_TLV_BSS)));
    let tlv_data_end = nl.place(C_TLV_DATA, tlv_start);
    if has_tlv {
        data_end = tlv_data_end;
    }
    let tlv_bss = nl.align_up(data_end, nl.class_align(C_TLV_BSS));
    let tlv_bss_end = nl.place(C_TLV_BSS, tlv_bss);
    let bss_addr = nl.align_up(u64_pick(has_tlv, tlv_bss_end, data_end), nl.class_align(nl.C_BSS));
    let bss_end = nl.place(nl.C_BSS, bss_addr);
    return Layout.{ ncmds: ncmds, sizeofcmds: sizeofcmds, text_end: text_end, const_addr: const_addr,
                    const_end: const_end, eh_addr: eh_addr, text_size: text_size, ngot: ngot, data_start: data_start,
                    data_end: tlvd_end, tlv_vars: tlv_vars, tlv_vars_end: tlv_vars_end, tlv_data_end: tlv_data_end,
                    tlv_bss: tlv_bss, tlv_bss_end: tlv_bss_end, tlvd_at: tlvd_at, tlvd_end: tlvd_end, init_at: init_at,
                    init_end: init_end, fini_end: fini_end, bss_addr: bss_addr, bss_end: bss_end,
                    data_filesize: nl.align_up(data_end - data_addr, PAGE),
                    data_vmsize: nl.align_up(bss_end - data_addr, PAGE) };
}

fn u64_pick(c: bool, a: u64, b: u64) u64 {
    if c {
        return a;
    }
    return b;
}

// __TEXT and __DATA's contents in b: the sections, the stubs, the GOT and
// the runtime's TLS record, relocated (noting what dyld rebases and binds).
fn write_contents(b: []mut u8, ly: *Layout) void {
    nl.copy_class(b, nl.C_TEXT, file_of);
    nl.copy_class(b, nl.C_CONST, file_of);
    nl.copy_class(b, C_EH, file_of);
    bn.put_at(b, file_of(unwind_addr), unwind.view());
    nl.copy_class(b, nl.C_DATA, file_of);
    nl.copy_class(b, nl.C_TDATA, file_of);
    nl.copy_class(b, C_TLV, file_of);
    nl.copy_class(b, C_TLV_DATA, file_of);
    nl.copy_class(b, C_INIT, file_of);
    nl.copy_class(b, C_FINI, file_of);
    nl.copy_class(b, C_TLVD, file_of);

    // stubs: adrp x16, slot@PAGE; ldr x16, [x16, slot@PAGEOFF]; br x16
    // (x86-64: jmp [rip + slot]; int3; int3)
    for k in 0..stubs.len {
        let g = nl.gsyms.at(@as(usize, stubs.get(k)));
        let at = stub_addr + (@as(u64, k) * stub_size());
        let slot = got_addr + (@as(u64, @bit_cast(u32, g.got)) * 8);
        let fo = file_of(at);
        if X64 {
            bn.w16(b, fo, 0x25ff);
            rel32(b, fo + 2, at + 6, slot);
            bn.w16(b, fo + 6, 0xcccc);
            continue;
        }
        bn.w32(b, fo, 0x9000_0010);
        nl.a64_adrp(b, fo, at, slot);
        bn.w32(b, fo + 4, 0xf940_0210);
        nl.a64_imm12(b, fo + 4, (slot & 0xfff) >> 3);
        bn.w32(b, fo + 8, 0xd61f_0200);
    }
    // GOT slots
    for k in 0..nl.got_sym.len {
        let oi = @as(usize, nl.got_obj.get(k));
        let si = nl.got_sym.get(k);
        let at = got_addr + (@as(u64, k) * 8);
        if is_import(oi, si) {
            binds.push(Import.{ seg_off: at - data_addr, name: import_name(oi, si), addend: 0 });
        } else {
            bn.w64(b, file_of(at), nl.sym_addr(oi, si));
            rebase_at(at);
        }
    }
    apply_relocs(b);
    nl.sort_rets(b, file_of);
    // the runtime's record of the thread-local template
    let info = nl.global_addr("axiom.tls_key");
    let ifo = file_of(info);
    bn.w64(b, ifo + 8, tls_addr);
    rebase_at(info + 8);
    bn.w64(b, ifo + 16, tls_filesz);
    bn.w64(b, ifo + 24, tls_memsz);
    bn.w64(b, ifo + 32, @max(tls_align, 16));
    // (with -g: the debugger's descriptors of the thread-locals, dwarf.ax
    // finish_elf: the runtime writes their keys)
    if ly.tlvd_end > ly.tlvd_at {
        bn.w64(b, ifo + 40, ly.tlvd_at);
        rebase_at(info + 40);
        bn.w64(b, ifo + 48, (ly.tlvd_end - ly.tlvd_at) / 24);
    }
}

struct NSym {
    name: []u8,
    ty: u8,
    sect: u8,
    desc: u64,
    value: u64,
}

// __LINKEDIT's contents, and where each is.
struct LinkEdit {
    rebase: []u8,
    bind: []u8,
    exports: []u8,
    symtab: bn.Bytes,
    strtab: bn.Bytes,
    nsyms: u64,
    nlocal: u64,  // the local symbols, then 2 defined external ones, then
    nundef: u64,  // the undefined ones
    off: u64,     // __LINKEDIT's
    addr: u64,
    size: u64,
    rebase_off: u64,
    bind_off: u64,
    export_off: u64,
    sym_off: u64,
    str_off: u64,
    sig_off: u64,
    sig_size: u64,
}

// __LINKEDIT: rebase, bind, exports, symbols, strings, signature.
fn link_edit(ly: *Layout, ident: []u8) LinkEdit {
    let rebase = rebase_info();
    let bind = bind_info();
    let exports = export_trie();
    let mut nlocal: u64 = 0;
    let syms = symbols(&mut nlocal);
    let mut strtab = bn.new_bytes();
    strtab.u8_(0x20);
    strtab.u8_(0);
    let mut symtab = bn.new_bytes();
    for x in syms.items() {
        symtab.u32_(@as(u64, strtab.len()));
        strtab.put(x.name);
        strtab.u8_(0);
        symtab.u8_(x.ty);
        symtab.u8_(x.sect);
        symtab.u16_(x.desc);
        symtab.u64_(x.value);
    }
    strtab.align(8);

    let le_off = data_off + ly.data_filesize;
    let rebase_off = le_off;
    let bind_off = rebase_off + @as(u64, rebase.len);
    let export_off = bind_off + @as(u64, bind.len);
    let sym_off = export_off + @as(u64, exports.len);
    let str_off = sym_off + @as(u64, symtab.len());
    let sig_off = nl.align_up(str_off + @as(u64, strtab.len()), 16);
    let sig_size = signature_size(ident, sig_off);
    return LinkEdit.{ rebase: rebase, bind: bind, exports: exports, symtab: symtab, strtab: strtab,
                      nsyms: @as(u64, syms.len), nlocal: nlocal, nundef: @as(u64, syms.len) - (nlocal + n_extdef()),
                      off: le_off, addr: data_addr + ly.data_vmsize, size: (sig_off + sig_size) - le_off,
                      rebase_off: rebase_off, bind_off: bind_off, export_off: export_off, sym_off: sym_off,
                      str_off: str_off, sig_off: sig_off, sig_size: sig_size };
}

// The symbol table's symbols: the local ones (every defined symbol), the
// external ones (the header, for dyld, and main), then the undefined ones,
// each with its library's ordinal (libSystem's is 1). Sets nlocal.
fn symbols(nlocal: *mut u64) u.List.[NSym] {
    let mut syms = u.List.[NSym].empty();
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        for si in 0..o.syms.len {
            let s = o.syms.get(si);
            if (s.sec < 0) or (s.name.len == 0) or (s.ty == elf.T_TLS) {
                continue;
            }
            let cls = nl.sec_cls.get(oi)[@as(usize, @bit_cast(u32, s.sec))];
            if (cls == nl.C_TDATA) or (cls == nl.C_TBSS) or (cls == nl.C_DEBUG) or (cls >= C_TLV) or (cls < 0) {
                continue;
            }
            if (s.bind != elf.B_LOCAL) and (nl.global_of(oi, @int_cast(u32, si)) >= 0) {
                let g = nl.gsyms.at(@as(usize, @bit_cast(u32, nl.global_of(oi, @int_cast(u32, si)))));
                if (g.obj != @int_cast(i32, oi)) or (g.sym != @int_cast(u32, si)) {
                    continue;  // a weak definition that lost
                }
            }
            // (the sections in load command order: __text, __const,
            // __eh_frame, __unwind_info, __got, __data, ..., __bss)
            let mut sect: u8 = 1;  // __text
            if cls == nl.C_CONST {
                sect = 2;
            } else if cls == C_EH {
                sect = 3;
            } else if (cls == nl.C_DATA) or (cls == nl.C_TDATA) or (cls == C_TLVD) {
                sect = 6;
            } else if cls == nl.C_BSS {
                sect = @truncate(u8, 7 + u64_pick(has_tlv, 3, 0) + u64_pick(g_dylib, 2, 0));
            }
            syms.push(
                NSym.{
                    name: elf.display_name(s.name), ty: 0x0e, sect: sect, desc: 0,
                    value: nl.sym_addr_in(oi, @int_cast(u32, si)) });
        }
    }
    nlocal.* = @as(u64, syms.len);
    if g_dylib {
        for gi in dylib_exports.items() {
            let g = nl.gsyms.get(@as(usize, gi));
            syms.push(
                NSym.{
                    name: bound_name(g.name), ty: 0x0f, sect: 1, desc: 0,
                    value: nl.sym_addr_in(@as(usize, @bit_cast(u32, g.obj)), g.sym) });
        }
    } else {
        syms.push(NSym.{ name: "__mh_execute_header", ty: 0x0f, sect: 1, desc: 0x10, value: image_base });
        syms.push(NSym.{ name: "_main", ty: 0x0f, sect: 1, desc: 0, value: nl.global_addr("main") });
    }
    let mut undef = u.List.[[]u8].empty();
    for gi in 0..nl.gsyms.len {
        let g = nl.gsyms.at(gi);
        if g.obj < 0 {
            undef.push(bound_name(g.name));
        }
    }
    u.sort.[[]u8](undef.items(), u.str_cmp);
    let mut prev: []u8 = "";
    for nm in undef.items() {
        // (once each: a function and the runtime's __axiom_libc_ name for
        // it are one symbol of libSystem)
        if u.str_eq(nm, prev) {
            continue;
        }
        prev = nm;
        let desc = @as(u64, ordinal_of(unbound_name(nm))) << 8;  // SET_LIBRARY_ORDINAL
        syms.push(NSym.{ name: nm, ty: 0x01, sect: 0, desc: desc, value: 0 });
    }
    return syms;
}

// The Mach header and load commands into h; returns the UUID's offset (for
// the caller to fill in).
fn load_commands(h: *mut bn.Bytes, ly: *Layout, le: *LinkEdit) usize {
    h.u32_(0xfeed_facf);  // MH_MAGIC_64
    h.u32_(cpu_type());
    h.u32_(cpu_subtype());
    h.u32_(u64_pick(g_dylib, 6, 2));  // MH_DYLIB, MH_EXECUTE
    h.u32_(ly.ncmds);
    h.u32_(ly.sizeofcmds);
    // MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE (and MH_HAS_TLV_DESCRIPTORS)
    // (a dynamic library: MH_NO_REEXPORTED_DYLIBS, not MH_PIE)
    h.u32_(u64_pick(g_dylib, 0x0010_0085, 0x0020_0085) | u64_pick(has_tlv, 0x0080_0000, 0));
    h.u32_(0);
    if not g_dylib {
        segment(h, "__PAGEZERO", 0, image_base, 0, 0, 0, 0);
    }
    segment(h, "__TEXT", image_base, ly.text_size, 0, ly.text_size, 5, 4);
    section(h, "__text", "__TEXT", text_addr, ly.text_end - text_addr, file_of(text_addr), 16, 0x8000_0400);
    section(h, "__const", "__TEXT", ly.const_addr, ly.const_end - ly.const_addr, file_of(ly.const_addr),
            @max(nl.class_align(nl.C_CONST), 1), 0);
    section(h, "__eh_frame", "__TEXT", ly.eh_addr, unwind_eh_end - ly.eh_addr, file_of(ly.eh_addr), 8, 0x6800_000b);  // S_COALESCED, no TOC, strip static symbols, live support
    section(h, "__unwind_info", "__TEXT", unwind_addr, @as(u64, unwind.len()), file_of(unwind_addr), 4, 0);
    segment(h, "__DATA", data_addr, ly.data_vmsize, data_off, ly.data_filesize, 3,
            3 + u64_pick(has_tlv, 3, 0) + u64_pick(g_dylib, 2, 0));
    section(h, "__got", "__DATA", got_addr, ly.ngot * 8, data_off, 8, 0);
    section(h, "__data", "__DATA", ly.data_start, ly.data_end - ly.data_start, file_of(ly.data_start), 16, 0);
    if g_dylib {
        section(h, "__mod_init_func", "__DATA", ly.init_at, ly.init_end - ly.init_at, file_of(ly.init_at), 8, 9);       // S_MOD_INIT_FUNC_POINTERS
        section(h, "__mod_term_func", "__DATA", ly.init_end, ly.fini_end - ly.init_end, file_of(ly.init_end), 8, 0xa);  // S_MOD_TERM_FUNC_POINTERS
    }
    if has_tlv {
        section(h, "__thread_vars", "__DATA", ly.tlv_vars, ly.tlv_vars_end - ly.tlv_vars, file_of(ly.tlv_vars), 8,
                0x13);  // S_THREAD_LOCAL_VARIABLES
        section(h, "__thread_data", "__DATA", tlv_start, ly.tlv_data_end - tlv_start, file_of(tlv_start),
                @max(nl.class_align(C_TLV_DATA), 1), 0x11);  // S_THREAD_LOCAL_REGULAR
        section(h, "__thread_bss", "__DATA", ly.tlv_bss, ly.tlv_bss_end - ly.tlv_bss, 0,
                @max(nl.class_align(C_TLV_BSS), 1), 0x12);  // S_THREAD_LOCAL_ZEROFILL
    }
    section(h, "__bss", "__DATA", ly.bss_addr, ly.bss_end - ly.bss_addr, 0, @max(nl.class_align(nl.C_BSS), 1), 1);
    segment(h, "__LINKEDIT", le.addr, nl.align_up(le.size, PAGE), le.off, le.size, 1, 0);
    h.u32_(0x8000_0022);  // LC_DYLD_INFO_ONLY
    h.u32_(48);
    h.u32_(le.rebase_off);
    h.u32_(@as(u64, le.rebase.len));
    h.u32_(le.bind_off);
    h.u32_(@as(u64, le.bind.len));
    h.u32_(0);  // weak bind
    h.u32_(0);
    h.u32_(0);  // lazy bind
    h.u32_(0);
    h.u32_(le.export_off);
    h.u32_(@as(u64, le.exports.len));
    h.u32_(2);  // LC_SYMTAB
    h.u32_(24);
    h.u32_(le.sym_off);
    h.u32_(le.nsyms);
    h.u32_(le.str_off);
    h.u32_(@as(u64, le.strtab.len()));
    h.u32_(0xb);  // LC_DYSYMTAB
    h.u32_(80);
    h.u32_(0);  // ilocalsym
    h.u32_(le.nlocal);
    h.u32_(le.nlocal);  // iextdefsym
    h.u32_(n_extdef());
    h.u32_(le.nlocal + n_extdef());  // iundefsym
    h.u32_(le.nundef);
    for _k in @as(u32, 0)..12 {
        h.u32_(0);  // no TOC, modules, external or indirect symbols, relocations
    }
    if g_dylib {
        // LC_ID_DYLIB: the install name programs load it by
        let size = dylib_cmd_size(install_name);
        h.u32_(0xd);
        h.u32_(size);
        h.u32_(24);
        h.u32_(1);
        h.u32_(0x0001_0000);  // current version 1.0
        h.u32_(0x0001_0000);  // compatibility version 1.0
        h.put(install_name);
        for _k in @as(u64, install_name.len) + 24..size {
            h.u8_(0);
        }
    } else {
        h.u32_(0xe);  // LC_LOAD_DYLINKER
        h.u32_(32);
        h.u32_(12);
        name16(h, "/usr/lib/dyld");
        h.u32_(0);
    }
    h.u32_(0x1b);  // LC_UUID (filled in by the caller)
    h.u32_(24);
    let uuid_at = h.len();
    h.zeros(16);
    h.u32_(0x32);  // LC_BUILD_VERSION
    h.u32_(24);
    h.u32_(1);            // PLATFORM_MACOS
    h.u32_(0x000b_0000);  // minos 11.0, the first for Apple silicon (and the runtime's on x86-64: __ulock_wait2)
    h.u32_(0x000b_0000);  // sdk
    h.u32_(0);            // no tools
    if not g_dylib {
        h.u32_(0x8000_0028);  // LC_MAIN
        h.u32_(24);
        h.u64_(file_of(nl.global_addr("main")));
        // the main thread's stack (--stack-size; 0: the system's 8 MiB)
        h.u64_(nl.align_up(nl.g_stack_size, 0x4000));
    }
    load_dylib(h, "/usr/lib/libSystem.B.dylib", 0x0547_0000);  // current version 1351
    for d in dylibs.items() {
        load_dylib(h, d, 0x0001_0000);
    }
    h.u32_(0x1d);  // LC_CODE_SIGNATURE
    h.u32_(16);
    h.u32_(le.sig_off);
    h.u32_(le.sig_size);
    return uuid_at;
}
