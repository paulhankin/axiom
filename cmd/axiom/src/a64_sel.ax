// =============================================================================
// a64_sel.ax - instruction/terminator selection, jump tables, and IR prep, part of a64.ax.
// =============================================================================
import "a64enc.ax" as ae;
import "asm/inline.ax" as ai;
import "elf.ax" as elf;
import "ir.ax" as ir;
import "isel.ax" as is;
import "mach.ax" as mc;
import "util.ax" as u;

// -----------------------------------------------------------------------------
// Instructions
// -----------------------------------------------------------------------------
fn gen_ptradd(v: *mut ir.Value) void {
    let d = vreg(v);
    if is.is_c(v.b) {
        let mut m = addr(v.a);
        let nd = m.disp + is.cval(v.b);
        if is.fits32(nd) and (m.index < 0) {
            m.disp = nd;
            _ = e2(LEA, 8, W(d), m);
            return;
        }
    }
    let a = reg(v.a);
    let off = v.b;
    if ir.is_op(off, ir.OP_MUL) and is.is_c(off.b) {
        let s = is.cval(off.b);
        if (s > 0) and (s <= 128) and ((s & (s - 1)) == 0) {  // (a scale is a u8)
            _ = e2(LEA, 8, W(d), mc.mem(a, reg(off.a), @truncate(u8, @bit_cast(u64, s)), 0));
            return;
        }
    }
    raw3(ae.addsub_reg(1, false, false, 0, 0, 0, 0, 0), d, a, reg(off));
}

fn is_tls_global(v: *ir.Value) bool {
    return ir.is_tls_addr(v);
}

// Constants that take instructions to build (worth building once per loop).
fn const_needs_reg(v: *ir.Value) bool {
    let k = v.kind;
    if k == ir.V_CINT {
        let x = is.cval(v);
        return (v.ty.kind == ir.T_INT) and (v.ty.bits <= 64) and ((x > 0xffff) or (x < -0xffff));
    }
    if k == ir.V_CFP {
        return not ir.is_zero(v);
    }
    if (k == ir.V_CAGG) and (v.ty.kind == ir.T_VEC) {
        return not ir.is_zero(v);
    }
    return false;
}

fn gen_inst(v: *mut ir.Value) void {
    let o = v.op;
    let t = v.ty;
    if (v.flag & 4) != 0 {
        return;  // (part of its user: a bit select or a bit clear)
    }
    if (v.flag & (F_OVBR | F_OVPART)) != 0 {
        return;  // (computed with an overflow: at its branch or select, or with its multiply)
    }
    if (v.flag & 8) != 0 {
        gen_bsl(v);
        return;
    }
    if (v.flag & 16) != 0 {
        gen_bic(v);
        return;
    }
    if (v.flag & 32) != 0 {
        gen_mla(v);
        return;
    }
    if (v.flag & 64) != 0 {
        gen_mull(v);
        return;
    }
    if (v.flag & 128) != 0 {
        gen_addw(v);
        return;
    }
    if o == ir.OP_COPY {
        copy(vreg(v), reg(v.a), class_of(t));
        return;
    }
    if ir.is_int_binop(o) {
        if t.kind == ir.T_VEC {
            vec_binop(v);
        } else if (o == ir.OP_UDIV) or (o == ir.OP_SDIV) or (o == ir.OP_UREM) or (o == ir.OP_SREM) {
            gen_div(v);
        } else if (o == ir.OP_SHL) or (o == ir.OP_LSHR) or (o == ir.OP_ASHR) {
            gen_shift(v);
        } else {
            gen_alu(v);
        }
        return;
    }
    if (o >= ir.OP_FADD) and (o <= ir.OP_FDIV) {
        gen_fbin(v);
        return;
    }
    if o == ir.OP_FNEG {
        gen_fneg(v);
        return;
    }
    if o == ir.OP_ICMP {
        if not is.fused(v) {
            gen_icmp(v);
        }
        return;
    }
    if o == ir.OP_FCMP {
        if not is.fused(v) {
            gen_fcmp(v);
        }
        return;
    }
    if o == ir.OP_SELECT {
        gen_select(v);
        return;
    }
    if ir.is_cast(o) {
        gen_cast(v);
        return;
    }
    if (o == ir.OP_ALLOCA) or (o == ir.OP_PHI) {
        return;
    }
    if o == ir.OP_LOAD {
        gen_load(v);
        return;
    }
    if o == ir.OP_STORE {
        gen_store(v);
        return;
    }
    if o == ir.OP_PTRADD {
        if (v.flag & 1) == 0 {
            gen_ptradd(v);
        }
        return;
    }
    if (o == ir.OP_MEMCPY) or (o == ir.OP_MEMMOVE) or (o == ir.OP_MEMSET) {
        gen_memop(v);
        return;
    }
    if o == ir.OP_RMW {
        gen_rmw(v);
        return;
    }
    if o == ir.OP_CMPXCHG {
        gen_cmpxchg(v);
        return;
    }
    if o == ir.OP_FENCE {
        // (the C11 mapping: an acquire fence orders earlier loads, DMB
        // ISHLD; a release, acq_rel or seq_cst one all accesses, DMB ISH;
        // a relaxed or signal fence none: nothing at this level moves
        // accesses within a block)
        let fo = ir.order(v);
        if ((v.flags & ir.F_SIGNAL) == 0) and (fo != ir.ORD_RELAXED) {
            if fo == ir.ORD_ACQUIRE {
                raw_none(ae.DMB_ISHLD);
            } else {
                raw_none(ae.DMB_ISH);
            }
        }
        return;
    }
    if o == ir.OP_EXTRACTELEM {
        gen_extract(v);
        return;
    }
    if o == ir.OP_INSERTELEM {
        gen_insert(v);
        return;
    }
    if o == ir.OP_SPLAT {
        gen_splat(v);
        return;
    }
    if o == ir.OP_SHUFFLE {
        gen_shuffle(v);
        return;
    }
    if o == ir.OP_CALL {
        if not is.sibling_call(v) or not gen_tail_call(v) {
            gen_call(v);
        }
        return;
    }
    if o == ir.OP_INTR {
        let id = ir.intr_id(v);
        if id == ir.IN_TRAP {
            raw_none(ae.UDF);
            return;
        }
        if id == ir.IN_FRAME_ADDR {
            _ = e2(MOV, 8, W(vreg(v)), R(FP));
            return;
        }
        if id == ir.IN_CALL_RESULT {
            gen_call_result(v);
            return;
        }
        if id == ir.IN_CMPXCHG_OK {
            gen_cas_ok(v);
            return;
        }
        if id == ir.IN_CAS16 {
            gen_cas16(v);
            return;
        }
        if id == ir.IN_ASM {
            // (a template that uses the stack: a frame, addressed from x29 as
            // with a dynamic allocation, so that CFA = x29 + 16 stays exact,
            // and on Windows the unwind information's set_fp)
            if ai.blob(is.cval(v.xs.get(0))).sp {
                FN.dyn_frame = true;
            }
            gen_asm(v);
            return;
        }
        if ir.is_dyn_stack(id) {
            FN.dyn_frame = true;
            if id == ir.IN_STACK_ALLOC {
                let n = vgpr();
                copy(n, reg(v.xs.get(0)), GPR);
                let ops: [3]mc.MOp = [RW(n), W(vreg(v)), RW(SP)];
                let i = emit(DYNSTACK, 8, ops[..]);
                i.cc = 0;
            } else if id == ir.IN_STACK_SAVE {
                let i = e2(DYNSTACK, 8, W(vreg(v)), R(SP));
                i.cc = 1;
            } else {
                let i = e2(DYNSTACK, 8, R(reg(v.xs.get(0))), RW(SP));
                i.cc = 2;
            }
            return;
        }
        if ir.is_prefetch(id) {
            gen_prefetch(v, id);
            return;
        }
        if (id == ir.IN_FPENV_GET) or (id == ir.IN_FPENV_SET) {
            gen_fpenv(v, id);
            return;
        }
        if is.is_insn(id) {
            gen_insn(v, id);
            return;
        }
        if (v.xs.len > 0) and (v.xs.get(0).ty.kind == ir.T_VEC) {
            gen_vec_intr(v, id);
            return;
        }
        if t.kind == ir.T_FLOAT {
            gen_float_intr(v, id);
            return;
        }
        gen_int_intr(v, id);
        return;
    }
    fail(u.f1("cannot select %s", ir.inst_str(v)));
}

fn gen_term(b: *mut ir.Block) void {
    let t = ir.terminator(b);
    let o = t.op;
    if o == ir.OP_BR {
        is.phi_copies(FN.mf, b, reg, vreg, class_of, copy);
        if not is.next_block_is(b, t.t1) {
            jmp(is.blk(t.t1));
        }
        return;
    }
    if o == ir.OP_CONDBR {
        let cc = cond_code(t.a);
        is.phi_copies(FN.mf, b, reg, vreg, class_of, copy);
        let tt = t.t1;
        let ff = t.t2;
        if is.next_block_is(b, tt) {
            bcc(is.invert(cc), is.blk(ff));
            return;
        }
        bcc(cc, is.blk(tt));
        if not is.next_block_is(b, ff) {
            jmp(is.blk(ff));
        }
        return;
    }
    if (o == ir.OP_SWITCH) and (t.cv == ir.SW_TABLE) {
        gen_jump_table(b, t);
        return;
    }
    if o == ir.OP_SWITCH {
        let x = t.a;
        let r = reg_ext(x, true);
        let sf = sfv(x.ty);
        let mut tr = r;
        if ir.is_op(x, ir.OP_PHI) {
            tr = vgpr();
            copy(tr, r, GPR);  // (the phi copies may overwrite a phi's register)
        }
        is.phi_copies(FN.mf, b, reg, vreg, class_of, copy);
        for k in 0..t.xs.len {
            let c = t.xs.get(k);
            let mut cv = is.cval(c);  // (a bool's case: 1, not -1)
            if sf == 0 {
                cv = @as(i64, @truncate(i32, cv));
            }
            if not cmp_imm(sf, tr, cv) {
                let cr = vgpr();
                movi(cr, cv, sf);
                cmp_reg(sf, tr, cr);
            }
            bcc(EQ, is.blk(ir.bs_of(t).get(k)));
        }
        if not is.next_block_is(b, t.t1) {
            jmp(is.blk(t.t1));
        }
        return;
    }
    if (o == ir.OP_RET) and FN.tail_jumped {
        FN.tail_jumped = false;  // (the call before it left the function: gen_tail_call)
        return;
    }
    if o == ir.OP_RET {
        if FN.f.ret_ext >= ir.EXT_REGS {
            ret_c_result(t);
            return;
        }
        if u.notnil(t.a) {
            let x = t.a;
            let mut r: i32 = -1;
            if (FN.f.ret_ext != 0) and (x.ty.kind == ir.T_INT) and (x.ty.bits < 32) {
                // the result extended to 32 bits, as the ABI's mark says:
                // a constant built so, a load that extends (zero), or the
                // value extended
                if is.is_c(x) and (x.kind != ir.V_UNDEF) {
                    r = vgpr();
                    movi(r, ext_const(x, FN.f.ret_ext == 2), 0);
                } else if (FN.f.ret_ext == 1) and ir.is_op(x, ir.OP_LOAD) and (x.flags == 0) and (x.ty.bits >= 8) {
                    r = reg(x);
                } else {
                    r = ext_reg(reg(x), x.ty.bits, FN.f.ret_ext == 2, false);
                }
            } else {
                r = reg(x);
            }
            if class_of(x.ty) == VR {
                let m = e2(FMOV, 16, W(V0), R(r));
                m.is_move = true;
                _ = e1(RET, 0, R(V0));
            } else {
                let m = e2(MOV, 8, W(X0), R(r));
                m.is_move = true;
                _ = e1(RET, 0, R(X0));
            }
            return;
        }
        _ = e0(RET, 0);
        return;
    }
    raw_none(ae.UDF);
}
// A switch lowering made a jump table (switches.ax: its value is less than
// its number of cases, 0, 1, ...): one instruction, JTAB, `adrp t, table;
// add t, t, :lo12:table; ldrsw u, [t, index, uxtw|lsl #2]; add t, t, u; br
// t`. The table, in .rodata, holds each target's offset from the table's
// start (filled in once the code is laid out: enc_jtab), position-
// independent and never in the code. (No branch-target landing pads: the
// code has none.)
fn gen_jump_table(b: *mut ir.Block, t: *mut ir.Value) void {
    let x = t.a;
    let mut r = reg(x);
    let mut sz: u8 = 8;
    if x.ty.bits < 64 {
        sz = 4;
        if x.ty.bits < 32 {
            r = reg_ext(x, false);
        }
    }
    let mut ix = r;
    if ir.is_op(x, ir.OP_PHI) {
        ix = vgpr();
        copy(ix, r, GPR);  // (the phi copies may overwrite a phi's register)
    }
    is.phi_copies(FN.mf, b, reg, vreg, class_of, copy);
    let n = t.xs.len;
    let jsec = is.group_rodata(O.obj, O.text, O.rodata);  // (with the code, in its COMDAT group if it is in one)
    let s = O.obj.secs.get(@int_cast(usize, jsec));
    s.data.align(4);
    let off = @as(u64, s.data.len());
    s.data.zeros(4 * n);
    let sym = elf.add_sym(O.obj, elf.Sym.{ name: ".LJT", sec: jsec, value: off, size: @as(u64, 4 * n),
                                           bind: elf.B_LOCAL, ty: elf.T_OBJECT, hidden: false, protected: false });
    let ops = u.newn.[mc.MOp](n + 3);
    ops[0] = R(ix);
    ops[1] = mc.reg(vgpr(), mc.RD | mc.RE);
    ops[2] = mc.reg(vgpr(), mc.RD | mc.RE);
    for k in 0..n {
        ops[k + 3] = mc.label(is.blk(ir.bs_of(t).get(k)));
    }
    let i = emit(JTAB, sz, ops[0..(n + 3)]);
    i.aux = @as(i64, @bit_cast(i32, sym));
}

// Is argument k of i a memory operand? (A prefetch's address is.)
fn prefetch_arg(i: *ir.Value, _k: usize) bool {
    return (i.op == ir.OP_INTR) and ir.is_prefetch(ir.intr_id(i));
}

fn prepare(f: *mut ir.Func) void {
    is.init_values(f, false, prefetch_arg);
    // vector bit selects, (x & m) | (y & ~m), and bit clears, y & ~m
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if (i.ty.kind == ir.T_VEC) and (i.op == ir.OP_OR) {
                let s = is.sel_parts(i);
                if u.notnil(s.m) and (s.p.nuses == 1) and (s.q.nuses == 1) and (s.n.nuses == 1) {
                    s.p.flag = s.p.flag | 4;
                    s.q.flag = s.q.flag | 4;
                    s.n.flag = s.n.flag | 4;
                    i.flag = i.flag | 8;
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if (i.ty.kind == ir.T_VEC) and (i.op == ir.OP_AND) and ((i.flag & 4) == 0) {
                let n = not_operand(i);
                if u.notnil(n) and (n.nuses == 1) {
                    n.flag = n.flag | 4;
                    i.flag = i.flag | 16;
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    // multiply-adds, acc + x * y (MLA; SMLAL, UMLAL2 ... of widened halves), then
    // the other multiplies of widened halves (SMULL ...); a widening made only
    // for them is not made (their own operands are read: aux2 counts its uses)
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if (i.op == ir.OP_ADD) and (i.ty.kind == ir.T_VEC) and ((i.flag & 4) == 0) {
                let m = mla_operand(i);
                if u.notnil(m) and ((m.flag & 4) == 0) {
                    m.flag = m.flag | 4;
                    i.flag = i.flag | 32;
                    if widening_mul(m) != ir.IN_NONE {
                        m.a.aux2 += 1;
                        m.b.aux2 += 1;
                    }
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    // acc + x and acc - x of a widened half x (SADDW, USUBW2 ...)
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if ((i.op == ir.OP_ADD) or (i.op == ir.OP_SUB)) and (i.ty.kind == ir.T_VEC) and ((i.flag & (4 | 32)) == 0) {
                let w = addw_operand(i);
                if u.notnil(w) {
                    i.flag = i.flag | 128;
                    w.aux2 += 1;
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if ((i.flag & 4) == 0) and (widening_mul(i) != ir.IN_NONE) {
                i.flag = i.flag | 64;
                i.a.aux2 += 1;
                i.b.aux2 += 1;
            }
            i = i.next;
        }
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if (widen_id(i) != ir.IN_NONE) and (i.aux2 == @as(i64, i.nuses)) {
                i.flag = i.flag | 4;
            }
            i = i.next;
        }
        b = b.next;
    }
    // comparisons fused into their branch / select
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if ((i.op == ir.OP_ICMP) or (i.op == ir.OP_FCMP)) and (i.a.ty.kind != ir.T_VEC) and (i.nuses == 1) and
               not ir.fp_pinned(i) {
                let us = ir.single_user(i);
                if (us.blk == b) and (us.a == i) {
                    // (the compare is made at its user, whose condition it is;
                    // not under strict floating point, where it stays before
                    // a call between them)
                    if (us.op == ir.OP_CONDBR) or (us.op == ir.OP_SELECT) {
                        i.flag = i.flag | 2;
                    }
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    // the carries and borrows of multi-word additions and subtractions (adc, sbc)
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            mark_carry(i);
            i = i.next;
        }
        b = b.next;
    }
    mark_overflow(f);  // (after the others: it takes only what they left alone)
}

// x + (p <u q) where p = q + r (the carry of a sum, which cmn q, r sets as
// C) and x - (p <u q) (the borrow of p - q: cmp p, q leaves C clear when
// p <u q), of 64-bit integers, the comparison and its zero-extension used
// only there: adc and sbc (F_ADC; the parts marked 4); x itself, if it is y
// + w (y - w) used only there, the adc's (sbc's) operands. cgen_wint.ax
// makes these idioms.
const F_ADC: i32 = 4096;

fn carry_part(z: *mut ir.Value, i: *ir.Value, sub: bool) bool {
    if not ir.is_op(z, ir.OP_ZEXT) or (z.nuses != 1) or (z.blk != i.blk) or (z.ty != i.ty) or (z.flag != 0) {
        return false;
    }
    let c = z.a;
    if (c.kind != ir.V_INST) or (c.op != ir.OP_ICMP) or (c.cv != ir.pred_cv(ir.IntULT)) or (c.nuses != 1) or
       (c.blk != i.blk) or (c.flag != 0) {
        return false;
    }
    let p = c.a;
    if (p.ty.kind != ir.T_INT) or (p.ty.bits != 64) {
        return false;
    }
    if sub {
        return true;
    }
    if not ir.is_op(p, ir.OP_ADD) or ((p.a != c.b) and (p.b != c.b)) {
        return false;
    }
    // (cmn reads p's other operand, which must have a register: not a part
    // of another carry's adc, which is marked before)
    let mut r = p.b;
    if p.b == c.b {
        r = p.a;
    }
    return (r.kind != ir.V_INST) or ((r.flag & 4) == 0);
}

fn mark_carry(i: *mut ir.Value) void {
    let sub = i.op == ir.OP_SUB;
    if (not sub and (i.op != ir.OP_ADD)) or (i.ty.kind != ir.T_INT) or (i.ty.bits != 64) or (i.flag != 0) {
        return;
    }
    let mut z = i.b;
    let mut x = i.a;
    if not carry_part(z, i, sub) {
        if sub or not carry_part(i.a, i, sub) {
            return;
        }
        z = i.a;
        x = i.b;
    }
    z.flag = z.flag | 4;
    z.a.flag = z.a.flag | 4;
    i.flag = i.flag | F_ADC;
    if (x.kind == ir.V_INST) and (x.op == i.op) and (x.nuses == 1) and (x.blk == i.blk) and (x.flag == 0) and
       (x.ty == i.ty) and ((x.a.kind != ir.V_INST) or (x.a.flag == 0)) and
       ((x.b.kind != ir.V_INST) or (x.b.flag == 0)) {
        x.flag = x.flag | 4;
    }
}

fn gen_carry(v: *mut ir.Value) void {
    let sub = v.op == ir.OP_SUB;
    let mut z = v.b;
    let mut x = v.a;
    if not sub and ((v.b.kind != ir.V_INST) or ((v.b.flag & 4) == 0)) {
        z = v.a;
        x = v.b;
    }
    let c = z.a;
    let mut y = x;
    let mut w = ir.vnil();
    if (x.kind == ir.V_INST) and ((x.flag & 4) != 0) {
        y = x.a;
        w = x.b;
    }
    // (every register first: then the flags, then the instruction that reads them)
    let mut f1 = c.a;
    let mut f2 = c.b;
    if not sub {
        // cmn q, r: C is the carry of q + r = p
        f1 = c.b;
        f2 = c.a.b;
        if c.a.b == c.b {
            f2 = c.a.a;
        }
    }
    let r1 = reg(f1);
    let r2 = reg(f2);
    let ry = reg(y);
    let mut rw: i32 = -1;
    if u.notnil(w) {
        rw = reg(w);
    }
    let d = vreg(v);
    // (p = q + r or p - q just made by a plain add or sub of these registers:
    // that instruction sets the flags instead, adds or subs)
    let last = FN.cb.last;
    let mut fresh = false;
    if u.notnil(last) and (last.op == RAW) and (last.ops.len >= 3) and (last.ops[1].kind == mc.K_REG) and
       (last.ops[2].kind == mc.K_REG) and (last.ops[0].kind == mc.K_REG) {
        let wd = @bit_cast(u64, last.aux);
        let n = last.ops[1].reg;
        let m = last.ops[2].reg;
        // (adds of q and r: C is the carry of q + r; subs of p and q: C is p >= q;
        // whichever register gets the result)
        let ops_ok = ((n == r1) and (m == r2)) or (not sub and (n == r2) and (m == r1));
        fresh = (wd == ae.addsub_reg(1, sub, false, 0, 0, 0, 0, 0)) and ops_ok;
    }
    if fresh {
        last.aux = last.aux | (@as(i64, 1) << 29);
    } else {
        _ = raw(ae.addsub_reg(1, sub, true, 31, 0, 0, 0, 0), NONE(), R(r1), R(r2), NONE());
    }
    // adc (sbc) d, y, w (or xzr)
    let mut word: u64 = 0x9A00_0000;
    if sub {
        word = 0xDA00_0000;
    }
    if rw < 0 {
        _ = raw(word | (31 << 16), W(d), R(ry), NONE(), NONE());
    } else {
        raw3(word, d, ry, rw);
    }
}

// -----------------------------------------------------------------------------
// Overflow from the flags
// -----------------------------------------------------------------------------
// The overflow of an operation that the branch of its block or a select
// there tests, with nothing else in the block reading it (F_OVBR: computed
// there by cond_code, ov_flags), and the operation and the parts of the
// idiom that it computes there, or the plain product beside a
// multiplication's overflow that the overflow's multiply gives (F_OVPART).
const F_OVBR: i32 = 8192;
const F_OVPART: i32 = 16384;

// A multiplication's overflow (IN_UMUL_OV, IN_SMUL_OV), and the plain
// product of the same operands (one it dominates, or one before it in its
// block) if its multiply gives that (8 and 16 bits, and 64 bits signed): the
// product moves next to the overflow and is marked F_OVPART (paired_mul). An
// overflow that the branch of its block or a select there tests, an
// intrinsic's or the idiom of an add's or sub's (is.ov_match), with nothing
// else in the block reading it or the operation's result, is computed
// there: `cset; cmp; b.ne` becomes `b.ne`, `eor; eor; and; cmp; b.lt`
// becomes `adds; b.vs`, `cmp; b.lo` and the sub after it `subs; b.lo`.
fn mark_overflow(f: *mut ir.Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let nx = i.next;
            if ir.is_mul_ov(i) and (i.xs.len == 2) and ir.mul_ov_width(i.xs.get(0).ty) and (i.flag == 0) {
                pair_mul_ov(i);
            }
            i = nx;
        }
        let t = ir.terminator(b);
        if u.notnil(t) and (t.op == ir.OP_CONDBR) and (t.t1 != t.t2) {
            mark_ov_branch(b, t);
        }
        b = b.next;
    }
}

// The user of a multiplication's overflow i that reads its flags, i's only
// use in its block (others are after it): the branch of the block, or a
// select of general registers there; or nil.
fn ov_user(i: *mut ir.Value) *mut ir.Value {
    let ib = i.blk;
    let t = ir.terminator(ib);
    if u.notnil(t) and (t.op == ir.OP_CONDBR) and (t.a == i) and (t.t1 != t.t2) and is.used_after(i, ib, t, t) {
        return t;
    }
    let none = u.nil.[ir.Value]();
    let mut s = none;
    let mut q = i.first_use;
    while u.notnil(q) {
        let x = ir.use_user(q);
        if (x.blk == ib) and (x.op != ir.OP_PHI) {
            if u.notnil(s) or (x.op != ir.OP_SELECT) or (x.a != i) or (x.b == i) or (x.c == i) or (x.flag != 0) or
               (class_of(x.ty) != GPR) {
                return none;
            }
            s = x;
        }
        q = q.next;
    }
    return s;
}

fn pair_mul_ov(i: *mut ir.Value) void {
    let a = i.xs.get(0);
    let b = i.xs.get(1);
    let ib = i.blk;
    let bits = a.ty.bits;
    let mut m = u.nil.[ir.Value]();
    if (bits < 32) or ((bits == 64) and (ir.intr_id(i) == ir.IN_SMUL_OV)) {
        // the plain product: in i's block, or in one i dominates
        m = is.find_op(ir.OP_MUL, a, b, true, ib);
    }
    let s = ov_user(i);
    if u.notnil(s) and (u.isnil(m) or is.used_after(m, ib, s, s)) {
        // computed at the branch or select (its result, if any, read after it)
        i.flag = i.flag | F_OVBR;
    }
    if u.isnil(m) {
        return;
    }
    if (m.blk == ib) and is.before_in_block(m, i) and ((i.flag & F_OVBR) == 0) {
        is.unlink_inst(i);
        ir.insert_before(m.next, i);  // (i reads only what m reads)
    } else {
        is.unlink_inst(m);
        ir.insert_before(i.next, m);  // (what m reads is there for i; what reads m comes after it)
    }
    m.flag = m.flag | F_OVPART;
    i.aux2 = @as(i64, m.id) + 1;
}

// The plain product beside a multiplication's overflow i that i's multiply
// gives (pair_mul_ov), or nil.
fn paired_mul(i: *mut ir.Value) *mut ir.Value {
    if i.aux2 == 0 {
        return u.nil.[ir.Value]();
    }
    let mut j = i.blk.first;
    while u.notnil(j) {
        if (@as(i64, j.id) + 1) == i.aux2 {
            return j;
        }
        j = j.next;
    }
    return u.nil.[ir.Value]();
}

// The add or sub whose overflow b's branch t tests (is.ov_match), with its
// result read only after b (and by the test): computed at the branch.
fn mark_ov_branch(b: *mut ir.Block, t: *mut ir.Value) void {
    let c = t.a;
    if (c.kind != ir.V_INST) or (c.blk != b) or (c.op != ir.OP_ICMP) or ((c.flag & ~2) != 0) or
       not is.used_after(c, b, t, t) {
        return;
    }
    let mut kind: i32 = 0;
    let v = is.ov_match(c, &mut kind, 0);
    if u.isnil(v) or (v.flag != 0) or ((v.blk != b) and not is.dominates(b, v.blk)) {
        return;
    }
    let x = c.a;
    let signed = (kind & is.OV_UNSIGNED) == 0;
    if signed {
        // (the and and its xors, read only there)
        if (x.nuses != 1) or (x.blk != b) or (x.flag != 0) or (x.a.nuses != 1) or (x.b.nuses != 1) or (x.a.blk != b) or
           (x.b.blk != b) or (x.a.flag != 0) or (x.b.flag != 0) {
            return;
        }
        if not is.used_after(v, b, x.a, x.b) {
            return;
        }
    } else if not is.used_after(v, b, c, c) {
        return;
    }
    let ops: [2]*mut ir.Value = [v.a, v.b];
    for o in ops {
        if (o.kind == ir.V_INST) and ((o.flag & 4) != 0) {
            return;  // (computed by its user)
        }
    }
    if v.blk != b {
        is.unlink_inst(v);
        ir.insert_before(t, v);
    }
    c.flag = (c.flag & ~2) | F_OVBR;
    v.flag = v.flag | F_OVPART;
    if signed {
        x.flag = F_OVPART;
        x.a.flag = F_OVPART;
        x.b.flag = F_OVPART;
    }
}

// The flags of overflow condition c (F_OVBR) from its operation, computed
// here (at the end of c's block, or at its select) into the register of the
// value it gives too: the condition code that is c. Signed: adds or subs
// sets V; unsigned: C, set by an add's carry, clear on a sub's borrow (a
// constant operand: an immediate of either, which gives the same flags).
// Of 8 and 16 bits: the operation on the operands shifted to the top of 32
// bits, whose flags are the narrow operation's, then the result shifted
// back.
fn ov_flags(c: *mut ir.Value) i32 {
    if ir.is_mul_ov(c) {
        return mul_ov_flags(c);
    }
    let mut kind: i32 = 0;
    let v = is.ov_match(c, &mut kind, F_OVPART);
    let sub = v.op == ir.OP_SUB;
    let mut a = v.a;
    let mut b = v.b;
    if not sub and is.is_c(a) {
        a = v.b;
        b = v.a;
    }
    let bits = v.ty.bits;
    let sf = sfv(v.ty);
    let d = vreg(v);
    if bits >= 32 {
        let ra = reg(a);
        if is.is_c(b) and addsub_imm_ok(is.cval(b)) and (is.cval(b) != 0) {
            let mut x = is.cval(b);
            if sub {
                x = -x;
            }
            // (adds of -k sets the flags of subs of k: for k not 0, C is x >=u k, and V the same)
            add_imm_s(sf, d, ra, x, true);
        } else {
            raw3(ae.addsub_reg(sf, sub, true, 0, 0, 0, 0, 0), d, ra, reg(b));
        }
    } else {
        let s = @as(u64, @bit_cast(u32, 32 - bits));
        let t = vgpr();
        raw2(ae.lsl_imm(0, 0, 0, s), t, reg(a));
        let w = vgpr();
        raw3(ae.addsub_reg(0, sub, true, 0, 0, 0, 0, s), w, t, reg(b));
        if (kind & is.OV_UNSIGNED) == 0 {
            raw2(ae.asr_imm(0, 0, 0, s), d, w);
        } else {
            raw2(ae.lsr_imm(0, 0, 0, s), d, w);
        }
    }
    let mut cc = VS;
    if (kind & is.OV_UNSIGNED) != 0 {
        cc = HS;
        if sub {
            cc = LO;
        }
    }
    if (kind & is.OV_NOT) != 0 {
        cc = is.invert(cc);
    }
    return cc;
}
