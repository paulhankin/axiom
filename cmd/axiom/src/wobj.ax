// =============================================================================
// wobj.ax - WebAssembly compilation units: the in-memory form produced by the
// wasm code generator, and its encoding as a relocatable object file in the
// LLVM / wasm-ld format (tool-conventions/Linking.md), so that objects work
// with our own linker (wlink.ax) and with wasm-ld (for linking C code).
// =============================================================================
import "bin.ax" as bn;
import "util.ax" as u;

// Value types
pub const I32: u8 = 0x7f;
pub const I64: u8 = 0x7e;
pub const F32: u8 = 0x7d;
pub const F64: u8 = 0x7c;
pub const V128: u8 = 0x7b;

// Symbol kinds and flags
pub const SYM_FUNC: u8 = 0;
pub const SYM_DATA: u8 = 1;
pub const SYM_GLOBAL: u8 = 2;
pub const SYM_TABLE: u8 = 5;
pub const F_WEAK: u32 = 0x1;
pub const F_LOCAL: u32 = 0x2;
pub const F_HIDDEN: u32 = 0x4;
pub const F_UNDEFINED: u32 = 0x10;
pub const F_EXPORTED: u32 = 0x20;
pub const F_EXPLICIT_NAME: u32 = 0x40;
pub const F_NO_STRIP: u32 = 0x80;
pub const F_TLS: u32 = 0x100;

// Relocation types
pub const R_FUNCTION_INDEX_LEB: u8 = 0;
pub const R_TABLE_INDEX_SLEB: u8 = 1;
pub const R_TABLE_INDEX_I32: u8 = 2;
pub const R_MEMORY_ADDR_LEB: u8 = 3;
pub const R_MEMORY_ADDR_SLEB: u8 = 4;
pub const R_MEMORY_ADDR_I32: u8 = 5;
pub const R_TYPE_INDEX_LEB: u8 = 6;
pub const R_GLOBAL_INDEX_LEB: u8 = 7;
pub const R_MEMORY_ADDR_LEB64: u8 = 14;
pub const R_MEMORY_ADDR_SLEB64: u8 = 15;
pub const R_MEMORY_ADDR_I64: u8 = 16;
pub const R_TABLE_INDEX_SLEB64: u8 = 18;
pub const R_TABLE_INDEX_I64: u8 = 19;
pub const R_TABLE_NUMBER_LEB: u8 = 20;

pub fn reloc_has_addend(t: u8) bool {
    return (t == R_MEMORY_ADDR_LEB) or (t == R_MEMORY_ADDR_SLEB) or (t == R_MEMORY_ADDR_I32) or
           (t == R_MEMORY_ADDR_LEB64) or (t == R_MEMORY_ADDR_SLEB64) or (t == R_MEMORY_ADDR_I64);
}

pub struct Reloc {
    ty: u8,
    off: u32,  // in the function body / segment data
    sym: u32,  // symbol index (type index for R_TYPE_INDEX_LEB)
    addend: i64,
}

pub struct Sym {
    kind: u8,
    flags: u32,
    name: []u8,
    index: u32,  // FUNC: function index; GLOBAL: global index; TABLE: table index
    seg: u32,    // DATA (defined)
    off: u64,
    size: u64,
}

pub struct Import {
    module: []u8,
    name: []u8,
    ty: u32,  // FUNC: type index; GLOBAL: value type
    mutable: bool,
}

pub struct Func {
    ty: u32,
    body: bn.Bytes,  // locals and code, ending with `end` (no size prefix)
    relocs: u.List.[Reloc],
    sym: u32,
    name: []u8,
    // -g: the line table, (offset in body << 32) | ir.src_loc where the location
    // changes (in an object: the custom section "axiom.lines"), and the declaration
    lines: u.List.[u64],
    src: u32,
}

pub struct Global {
    vt: u8,
    mutable: bool,
    init: i64,
}

pub struct Seg {
    name: []u8,
    align: u32,  // log2
    data: bn.Bytes,
    relocs: u.List.[Reloc],
    tls: bool,
}

pub struct Export {
    name: []u8,
    func: u32,  // function index
}

pub struct Unit {
    wasm64: bool,
    types: u.List.[[]u8],       // encoded function types (0x60 params results)
    fimports: u.List.[Import],  // function imports: function indices 0..n-1
    gimports: u.List.[Import],  // global imports
    funcs: u.List.[*mut Func],
    globals: u.List.[Global],
    segs: u.List.[*mut Seg],
    syms: u.List.[Sym],
    exports: u.List.[Export],
    uses_table: bool,
    shared_memory: bool,
    symmap: u.SymMap.[u32],  // name -> symbol index + 1 (non-local symbols)
}

pub fn new_unit(wasm64: bool) *mut Unit {
    let un = u.new.[Unit]();
    un.wasm64 = wasm64;
    return un;
}

pub fn type_index(un: *mut Unit, params: []u8, results: []u8) u32 {
    let mut b = bn.new_bytes();
    b.u8_(0x60);
    b.uleb(@as(u64, params.len));
    b.put(params);
    b.uleb(@as(u64, results.len));
    b.put(results);
    let enc = b.view();
    for i in 0..un.types.len {
        if u.str_eq(un.types.get(i), enc) {
            b.free();
            return @int_cast(u32, i);
        }
    }
    un.types.push(u.perm_dup(enc));  // (functions are generated in scratch scopes)
    b.free();
    return @int_cast(u32, un.types.len - 1);
}

pub fn add_sym(un: *mut Unit, s: Sym) u32 {
    un.syms.push(s);
    let idx = @int_cast(u32, un.syms.len - 1);
    if ((s.flags & F_LOCAL) == 0) and (s.name.len > 0) {
        un.symmap.put(u.intern(s.name), idx + 1);
    }
    return idx;
}

// -----------------------------------------------------------------------------
// Encoding as an object file
// -----------------------------------------------------------------------------
fn section(out: *mut bn.Bytes, id: u8, content: *bn.Bytes) void {
    out.u8_(id);
    out.uleb(@as(u64, content.len()));
    out.put(content.view());
}

fn custom(out: *mut bn.Bytes, name: []u8, content: *bn.Bytes) void {
    let mut c = bn.new_bytes();
    c.name(name);
    c.put(content.view());
    section(out, 0, &c);
    c.free();
}

fn write_relocs(r: *mut bn.Bytes, rs: *u.List.[Reloc], base: u32) void {
    for i in 0..rs.len {
        let x = rs.get(i);
        r.u8_(x.ty);
        r.uleb(@as(u64, x.off + base));
        r.uleb(@as(u64, x.sym));
        if reloc_has_addend(x.ty) {
            r.sleb(x.addend);
        }
    }
}

// An object file being written, and its number of (non-custom) sections.
struct Writer {
    out: bn.Bytes,
    nsec: u32,
}

// Adds a section (and frees its content).
fn add_section(w: *mut Writer, id: u8, content: *mut bn.Bytes) void {
    section(&mut w.out, id, content);
    w.nsec += 1;
    content.free();
}

// Adds a custom section (and frees its content).
fn add_custom(w: *mut Writer, name: []u8, content: *mut bn.Bytes) void {
    custom(&mut w.out, name, content);
    content.free();
}

pub fn write_object(un: *mut Unit) []u8 {
    let mut w = Writer.{ out: bn.new_bytes(), nsec: 0 };
    w.out.put("\x00asm");
    w.out.u32_(1);
    // type
    let mut c = bn.new_bytes();
    c.uleb(@as(u64, un.types.len));
    for i in 0..un.types.len {
        c.put(un.types.get(i));
    }
    add_section(&mut w, 1, &mut c);
    c = import_section(un);
    add_section(&mut w, 2, &mut c);
    // function
    c = bn.new_bytes();
    c.uleb(@as(u64, un.funcs.len));
    for i in 0..un.funcs.len {
        c.uleb(@as(u64, un.funcs.get(i).ty));
    }
    add_section(&mut w, 3, &mut c);
    // global
    if un.globals.len > 0 {
        c = bn.new_bytes();
        c.uleb(@as(u64, un.globals.len));
        for i in 0..un.globals.len {
            let g = un.globals.get(i);
            c.u8_(g.vt);
            c.u8_(u.pick(g.mutable, "\x01", "\x00")[0]);
            if g.vt == I64 {
                c.u8_(0x42);
            } else {
                c.u8_(0x41);
            }
            c.sleb(g.init);
            c.u8_(0x0b);
        }
        add_section(&mut w, 6, &mut c);
    }
    // export (functions with export names)
    if un.exports.len > 0 {
        c = bn.new_bytes();
        c.uleb(@as(u64, un.exports.len));
        for i in 0..un.exports.len {
            let e = un.exports.get(i);
            c.name(e.name);
            c.u8_(0);
            c.uleb(@as(u64, e.func));
        }
        add_section(&mut w, 7, &mut c);
    }
    // datacount
    c = bn.new_bytes();
    c.uleb(@as(u64, un.segs.len));
    add_section(&mut w, 12, &mut c);
    // code and data (relocation offsets are relative to the section contents)
    let mut code_relocs = u.List.[Reloc].empty();
    c = code_section(un, &mut code_relocs);
    let code_sec = w.nsec;
    add_section(&mut w, 10, &mut c);
    let mut data_relocs = u.List.[Reloc].empty();
    c = data_section(un, &mut data_relocs);
    let data_sec = w.nsec;
    add_section(&mut w, 11, &mut c);
    c = linking_section(un);
    add_custom(&mut w, "linking", &mut c);
    reloc_section(&mut w, "reloc.CODE", code_sec, &code_relocs);
    reloc_section(&mut w, "reloc.DATA", data_sec, &data_relocs);
    // target features, so wasm-ld accepts the features we use
    c = bn.new_bytes();
    let feats = ["bulk-memory", "mutable-globals", "nontrapping-fptoint", "sign-ext", "simd128"];
    c.uleb(@as(u64, feats.len));
    for f in feats {
        c.u8_('+');
        c.name(f);
    }
    add_custom(&mut w, "target_features", &mut c);
    lines_section(&mut w, un);
    code_relocs.deinit();
    data_relocs.deinit();
    let r = u.dup(w.out.view());
    w.out.free();
    return r;
}

// -g: the functions' line tables (Func.lines), for wlink.ax's DWARF, in a
// custom section "axiom.lines": the files' paths (a count, then names),
// then per function with a table: its index among the definitions, its
// declaration's file (index + 1, 0: none) and line, the number of rows,
// and the rows (code offset, file index, line). Our own: other linkers
// keep custom sections they do not know as they are.
fn lines_section(w: *mut Writer, un: *Unit) void {
    let mut any = false;
    for f in un.funcs.items() {
        any = any or (f.lines.len > 0);
    }
    if not any {
        return;
    }
    let mut files = u.List.[i32].empty();
    let mut idx = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    let mut body = bn.new_bytes();
    let mut nf: u64 = 0;
    for f in un.funcs.items() {
        if f.lines.len > 0 {
            nf += 1;
        }
    }
    body.uleb(nf);
    for k in 0..un.funcs.len {
        let f = un.funcs.get(k);
        if f.lines.len == 0 {
            continue;
        }
        body.uleb(@as(u64, k));
        if f.src == 0 {
            body.uleb(0);
            body.uleb(0);
        } else {
            body.uleb(@as(u64, line_file(&mut files, &mut idx, f.src)) + 1);
            body.uleb(@as(u64, ir_src_line(f.src)));
        }
        body.uleb(@as(u64, f.lines.len));
        for r in f.lines.items() {
            body.uleb(r >> 32);
            body.uleb(@as(u64, line_file(&mut files, &mut idx, @truncate(u32, r))));
            body.uleb(@as(u64, ir_src_line(@truncate(u32, r))));
        }
    }
    let mut c = bn.new_bytes();
    c.uleb(@as(u64, files.len));
    for fid in files.items() {
        c.name(u.file_of(fid).path);
    }
    c.put(body.view());
    body.free();
    add_custom(w, "axiom.lines", &mut c);
}

// (as ir.src_file and ir.src_line, which this module does not import)
fn ir_src_line(s: u32) u32 {
    return s & 0xf_ffff;
}

fn line_file(files: *mut u.List.[i32], idx: *mut u.SymMap.[u32], src: u32) u32 {
    let fid = @bit_cast(i32, src >> 20) - 1;
    let k = u.intern(u.file_of(fid).path);
    let at = idx.get(k);
    if at != 0 {
        return at - 1;
    }
    files.push(fid);
    idx.put(k, @int_cast(u32, files.len));
    return @int_cast(u32, files.len - 1);
}

// Reads "axiom.lines" into the unit's functions: each file becomes a source
// file of this process (u.g_files, with no text: only its path is used).
fn read_lines(r: *mut bn.Reader, un: *mut Unit) void {
    let nfiles = r.uleb();
    let ids = u.newn.[i32](@truncate(usize, nfiles) + 1);
    for k in @as(u64, 0)..nfiles {
        let path = r.name();
        let sf = u.new.[u.SourceFile]();
        sf.path = path;
        sf.display = path;
        sf.text = "";
        sf.id = @int_cast(i32, u.g_files.len);
        u.g_files.push(sf);
        ids[@truncate(usize, k)] = sf.id;
    }
    let nf = r.uleb();
    for _k in @as(u64, 0)..nf {
        let fi = @truncate(usize, r.uleb());
        let df = r.uleb();
        let dl = r.uleb();
        let n = r.uleb();
        let mut f = u.nil.[Func]();
        if fi < un.funcs.len {
            f = un.funcs.get(fi);
        }
        if u.notnil(f) and (df > 0) and (df <= nfiles) {
            f.src = src_of(ids[@truncate(usize, df - 1)], dl);
        }
        for _j in @as(u64, 0)..n {
            let off = r.uleb();
            let file = r.uleb();
            let line = r.uleb();
            if u.notnil(f) and (file < nfiles) {
                f.lines.push((off << 32) | @as(u64, src_of(ids[@truncate(usize, file)], line)));
            }
        }
    }
}

fn src_of(file: i32, line: u64) u32 {
    if (file >= 4095) or (line == 0) or (line >= 0x10_0000) {
        return 0;
    }
    return (@bit_cast(u32, file + 1) << 20) | @truncate(u32, line);
}

// The imports: memory, table, globals, functions.
fn import_section(un: *Unit) bn.Bytes {
    let mut c = bn.new_bytes();
    let mut nimp = 1 + un.gimports.len + un.fimports.len;
    if un.uses_table {
        nimp += 1;
    }
    c.uleb(@as(u64, nimp));
    c.name("env");
    c.name("__linear_memory");
    c.u8_(2);
    let mut lim: u8 = 0;
    if un.wasm64 {
        lim = 4;
    }
    c.u8_(lim);
    c.uleb(0);
    if un.uses_table {
        c.name("env");
        c.name("__indirect_function_table");
        c.u8_(1);
        c.u8_(0x70);
        c.u8_(0);
        c.uleb(0);
    }
    for i in 0..un.gimports.len {
        let g = un.gimports.get(i);
        c.name(g.module);
        c.name(g.name);
        c.u8_(3);
        c.u8_(@truncate(u8, g.ty));
        c.u8_(u.pick(g.mutable, "\x01", "\x00")[0]);
    }
    for i in 0..un.fimports.len {
        let f = un.fimports.get(i);
        c.name(f.module);
        c.name(f.name);
        c.u8_(0);
        c.uleb(@as(u64, f.ty));
    }
    return c;
}

// The function bodies; their relocations go to `relocs`.
fn code_section(un: *Unit, relocs: *mut u.List.[Reloc]) bn.Bytes {
    let mut c = bn.new_bytes();
    c.uleb(@as(u64, un.funcs.len));
    for i in 0..un.funcs.len {
        let f = un.funcs.get(i);
        c.uleb(@as(u64, f.body.len()));
        add_relocs(relocs, &f.relocs, @int_cast(u32, c.len()));
        c.put(f.body.view());
    }
    return c;
}

// The data segments (active, at 0 until linked); their relocations go to
// `relocs`.
fn data_section(un: *Unit, relocs: *mut u.List.[Reloc]) bn.Bytes {
    let mut c = bn.new_bytes();
    c.uleb(@as(u64, un.segs.len));
    for i in 0..un.segs.len {
        let sg = un.segs.get(i);
        c.u8_(0);  // active, memory 0
        if un.wasm64 {
            c.u8_(0x42);
        } else {
            c.u8_(0x41);
        }
        c.sleb(0);
        c.u8_(0x0b);
        c.uleb(@as(u64, sg.data.len()));
        add_relocs(relocs, &sg.relocs, @int_cast(u32, c.len()));
        c.put(sg.data.view());
    }
    return c;
}

// Adds relocations rs, at base in the section, to relocs.
fn add_relocs(relocs: *mut u.List.[Reloc], rs: *u.List.[Reloc], base: u32) void {
    for k in 0..rs.len {
        let mut r = rs.get(k);
        r.off += base;
        relocs.push(r);
    }
}

// The custom section of a section's relocations, if it has any.
fn reloc_section(w: *mut Writer, name: []u8, sec: u32, relocs: *u.List.[Reloc]) void {
    if relocs.len == 0 {
        return;
    }
    let mut c = bn.new_bytes();
    c.uleb(@as(u64, sec));
    c.uleb(@as(u64, relocs.len));
    write_relocs(&mut c, relocs, 0);
    add_custom(w, name, &mut c);
}

// The linking section: the symbol table, then the segments' names,
// alignments and flags.
fn linking_section(un: *Unit) bn.Bytes {
    let mut c = bn.new_bytes();
    c.uleb(2);
    let mut st = bn.new_bytes();
    st.uleb(@as(u64, un.syms.len));
    for i in 0..un.syms.len {
        let s = un.syms.get(i);
        st.u8_(s.kind);
        st.uleb(@as(u64, s.flags));
        if s.kind == SYM_DATA {
            st.name(s.name);
            if (s.flags & F_UNDEFINED) == 0 {
                st.uleb(@as(u64, s.seg));
                st.uleb(s.off);
                st.uleb(s.size);
            }
        } else {
            st.uleb(@as(u64, s.index));
            if ((s.flags & F_UNDEFINED) == 0) or ((s.flags & F_EXPLICIT_NAME) != 0) {
                st.name(s.name);
            }
        }
    }
    subsection(&mut c, 8, &mut st);
    if un.segs.len > 0 {
        st = bn.new_bytes();
        st.uleb(@as(u64, un.segs.len));
        for i in 0..un.segs.len {
            let sg = un.segs.get(i);
            st.name(sg.name);
            st.uleb(@as(u64, sg.align));
            let mut fl: u64 = 0;
            if sg.tls {
                fl = 2;
            }
            st.uleb(fl);
        }
        subsection(&mut c, 5, &mut st);
    }
    return c;
}

// A subsection of the linking section (its content freed).
fn subsection(c: *mut bn.Bytes, id: u8, content: *mut bn.Bytes) void {
    c.u8_(id);
    c.uleb(@as(u64, content.len()));
    c.put(content.view());
    content.free();
}

// -----------------------------------------------------------------------------
// Decoding (objects written by write_object)
// -----------------------------------------------------------------------------
fn read_relocs(r: *mut bn.Reader, out: *mut u.List.[Reloc]) void {
    let n = r.uleb();
    for i in @as(u64, 0)..n {
        let t = r.u8_();
        let off = @truncate(u32, r.uleb());
        let sym = @truncate(u32, r.uleb());
        let mut add: i64 = 0;
        if reloc_has_addend(t) {
            add = r.sleb();
        }
        out.push(Reloc.{ ty: t, off: off, sym: sym, addend: add });
    }
}

// What read_object gathers before it can complete the unit's functions and
// segments.
struct Reading {
    code_relocs: u.List.[Reloc],  // offsets in the code section
    data_relocs: u.List.[Reloc],  // in the data section
    ftypes: u.List.[u32],         // each function's type
    body_offs: u.List.[usize],    // each body's offset in the code section
    seg_offs: u.List.[usize],     // each segment's data in the data section
    seg_names: u.List.[[]u8],
    seg_aligns: u.List.[u32],
    seg_tls: u.List.[bool],
}

// Returns nil if the bytes are not an object this compiler wrote.
pub fn read_object(d: []u8) *mut Unit {
    let mut r = bn.reader(d);
    if (d.len < 8) or not u.str_eq(d[0..4], "\x00asm") {
        return u.nil.[Unit]();
    }
    r.pos = 8;
    let un = new_unit(false);
    let mut rd = Reading.{ code_relocs: u.List.[Reloc].empty(), data_relocs: u.List.[Reloc].empty(),
                           ftypes: u.List.[u32].empty(), body_offs: u.List.[usize].empty(),
                           seg_offs: u.List.[usize].empty(), seg_names: u.List.[[]u8].empty(),
                           seg_aligns: u.List.[u32].empty(), seg_tls: u.List.[bool].empty() };
    while not r.at_end() and not r.bad {
        let id = r.u8_();
        let size = @truncate(usize, r.uleb());
        let start = r.pos;
        let end = start + size;
        if id == 1 {
            let n = r.uleb();
            for i in @as(u64, 0)..n {
                let s = r.pos;
                _ = r.u8_();
                let np = @truncate(usize, r.uleb());
                _ = r.bytes(np);
                let nr = @truncate(usize, r.uleb());
                _ = r.bytes(nr);
                un.types.push(u.dup(d[s..r.pos]));
            }
        } else if id == 2 {
            read_imports(&mut r, un);
        } else if id == 3 {
            let n = r.uleb();
            for i in @as(u64, 0)..n {
                rd.ftypes.push(@truncate(u32, r.uleb()));
            }
        } else if id == 6 {
            let n = r.uleb();
            for i in @as(u64, 0)..n {
                let vt = r.u8_();
                let mu = r.u8_() != 0;
                _ = r.u8_();
                let init = r.sleb();
                _ = r.u8_();
                un.globals.push(Global.{ vt: vt, mutable: mu, init: init });
            }
        } else if id == 7 {
            let n = r.uleb();
            for i in @as(u64, 0)..n {
                let nm = r.name();
                _ = r.u8_();
                let fi = @truncate(u32, r.uleb());
                un.exports.push(Export.{ name: nm, func: fi });
            }
        } else if id == 10 {
            let n = r.uleb();
            for i in @as(u64, 0)..n {
                let sz = @truncate(usize, r.uleb());
                rd.body_offs.push(r.pos - start);
                let f = u.new.[Func]();
                f.ty = rd.ftypes.get(@truncate(usize, i));
                f.body.put(r.bytes(sz));
                un.funcs.push(f);
            }
        } else if id == 11 {
            let n = r.uleb();
            for i in @as(u64, 0)..n {
                _ = r.u8_();
                _ = r.u8_();
                _ = r.sleb();
                _ = r.u8_();
                let sz = @truncate(usize, r.uleb());
                rd.seg_offs.push(r.pos - start);
                let sg = u.new.[Seg]();
                sg.data.put(r.bytes(sz));
                un.segs.push(sg);
            }
        } else if id == 0 {
            let nm = r.name();
            if u.str_eq(nm, "linking") {
                read_linking(&mut r, end, un, &mut rd);
            } else if u.str_eq(nm, "reloc.CODE") {
                _ = r.uleb();
                read_relocs(&mut r, &mut rd.code_relocs);
            } else if u.str_eq(nm, "reloc.DATA") {
                _ = r.uleb();
                read_relocs(&mut r, &mut rd.data_relocs);
            } else if u.str_eq(nm, "axiom.lines") {
                read_lines(&mut r, un);
            }
        }
        r.pos = end;
    }
    if r.bad {
        return u.nil.[Unit]();
    }
    // distribute relocations to functions and segments
    for i in 0..rd.code_relocs.len {
        let x = rd.code_relocs.get(i);
        let k = owner(&rd.body_offs, @as(usize, x.off));
        if k > 0 {
            un.funcs.get(k - 1).relocs.push(moved(x, rd.body_offs.get(k - 1)));
        }
    }
    for i in 0..rd.data_relocs.len {
        let x = rd.data_relocs.get(i);
        let k = owner(&rd.seg_offs, @as(usize, x.off));
        if k > 0 {
            un.segs.get(k - 1).relocs.push(moved(x, rd.seg_offs.get(k - 1)));
        }
    }
    for i in 0..un.segs.len {
        let sg = un.segs.get(i);
        if i < rd.seg_names.len {
            sg.name = rd.seg_names.get(i);
            sg.align = rd.seg_aligns.get(i);
            sg.tls = rd.seg_tls.get(i);
        }
    }
    // function names and symbols
    for i in 0..un.syms.len {
        let s = un.syms.get(i);
        if (s.kind == SYM_FUNC) and ((s.flags & F_UNDEFINED) == 0) {
            let fi = @as(usize, s.index) - un.fimports.len;
            if fi < un.funcs.len {
                un.funcs.get(fi).sym = @int_cast(u32, i);
                un.funcs.get(fi).name = s.name;
            }
        }
    }
    return un;
}

// The import section: function and global imports (the memory's says
// whether the unit is wasm64; a table's that it uses one).
fn read_imports(r: *mut bn.Reader, un: *mut Unit) void {
    let n = r.uleb();
    for i in @as(u64, 0)..n {
        let m = r.name();
        let nm = r.name();
        let kind = r.u8_();
        if kind == 0 {
            let t = @truncate(u32, r.uleb());
            un.fimports.push(Import.{ module: m, name: nm, ty: t, mutable: false });
        } else if kind == 1 {
            _ = r.u8_();
            let fl = r.u8_();
            _ = r.uleb();
            if (fl & 1) != 0 {
                _ = r.uleb();
            }
            un.uses_table = true;
        } else if kind == 2 {
            let fl = r.u8_();
            un.wasm64 = (fl & 4) != 0;
            _ = r.uleb();
            if (fl & 1) != 0 {
                _ = r.uleb();
            }
        } else if kind == 3 {
            let vt = r.u8_();
            let mu = r.u8_() != 0;
            un.gimports.push(Import.{ module: m, name: nm, ty: @as(u32, vt), mutable: mu });
        }
    }
}

// The linking section (to `end`): the symbol table, the segments' info.
fn read_linking(r: *mut bn.Reader, end: usize, un: *mut Unit, rd: *mut Reading) void {
    _ = r.uleb();
    while r.pos < end {
        let sub = r.u8_();
        let ssz = @truncate(usize, r.uleb());
        let send = r.pos + ssz;
        if sub == 8 {
            let n = r.uleb();
            for i in @as(u64, 0)..n {
                _ = add_sym(un, read_sym(r, un));
            }
        } else if sub == 5 {
            let n = r.uleb();
            for i in @as(u64, 0)..n {
                rd.seg_names.push(r.name());
                rd.seg_aligns.push(@truncate(u32, r.uleb()));
                rd.seg_tls.push((r.uleb() & 2) != 0);
            }
        }
        r.pos = send;
    }
}

// A symbol table entry (an undefined one without a name of its own has its
// import's).
fn read_sym(r: *mut bn.Reader, un: *Unit) Sym {
    let mut s = Sym.{ kind: r.u8_(), flags: 0, name: "", index: 0, seg: 0, off: 0, size: 0 };
    s.flags = @truncate(u32, r.uleb());
    if s.kind == SYM_DATA {
        s.name = r.name();
        if (s.flags & F_UNDEFINED) == 0 {
            s.seg = @truncate(u32, r.uleb());
            s.off = r.uleb();
            s.size = r.uleb();
        }
    } else {
        s.index = @truncate(u32, r.uleb());
        if ((s.flags & F_UNDEFINED) == 0) or ((s.flags & F_EXPLICIT_NAME) != 0) {
            s.name = r.name();
        } else if (s.kind == SYM_FUNC) and (@as(usize, s.index) < un.fimports.len) {
            s.name = un.fimports.get(@as(usize, s.index)).name;
        } else if (s.kind == SYM_GLOBAL) and (@as(usize, s.index) < un.gimports.len) {
            s.name = un.gimports.get(@as(usize, s.index)).name;
        }
    }
    return s;
}

// Which of the pieces starting at offs (in increasing order) holds offset off: its
// index + 1, 0 if none. That is the number of offsets <= off, found by binary search.
fn owner(offs: *u.List.[usize], off: usize) usize {
    let mut lo: usize = 0;
    let mut hi = offs.len;
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if offs.get(mid) <= off {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

// A relocation moved to a piece's own offsets (the piece at base).
fn moved(x: Reloc, base: usize) Reloc {
    return Reloc.{ ty: x.ty, off: @int_cast(u32, @as(usize, x.off) - base), sym: x.sym, addend: x.addend };
}
