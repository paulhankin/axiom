// =============================================================================
// passes.ax - the optimization pipeline over a module's IR (after lowering).
//
//   -O0   mem2reg, constant folding, CFG simplification, dead code
//   -O1+  also instruction combining (combine.ax), jump threading and
//         if-conversion (thread.ax), removing copies of aggregates that are
//         only read (copies.ax), scalar replacement of aggregates (sroa.ax),
//         global value numbering, dead stores, bounds and loop-invariant code
//         motion and globals kept in registers across loops (gvn.ax), loop
//         counters narrower than a pointer widened (loops.ax), loops that
//         copy or fill consecutive elements as memmove / memcpy / memset
//         (idioms.ax), calls of a function itself in tail position as a loop
//         (tailrec.ax); at the end, stack slots whose contents are never
//         needed at the same time sharing their bytes (slots.ax)
//   -O2+  also counted loops over arrays as vector loops, and searches as
//         vector searches (vectorize.ax), switches that give constants as
//         table lookups (switches.ax), interprocedural constant propagation and inlining
//         (inline.ax), bottom-up over the call graph, each function simplified
//         again after its calls are inlined; then small loops with a constant
//         trip count unrolled (unroll.ax), and small loops whose trip count
//         is not known by two, and the function simplified again; last, the
//         calls in tail position that can leave the frame first marked for
//         the backends (tailrec.ax: sibling calls)
// =============================================================================
import "copies.ax" as copies;
import "cover.ax" as cover;
import "divconst.ax" as divc;
import "gvn.ax" as gvn;
import "idioms.ax" as idioms;
import "inline.ax" as inl;
import "ir.ax" as ir;
import "loops.ax" as loops;
import "opt.ax" as opt;
import "outline.ax" as outl;
import "slots.ax" as slots;
import "slp.ax" as slp;
import "sroa.ax" as sroa;
import "switches.ax" as sw;
import "tailrec.ax" as tre;
import "target.ax" as tg;
import "thread.ax" as thr;
import "unroll.ax" as unr;
import "util.ax" as u;
import "vectorize.ax" as vec;

// Runs the sub-passes in turn until each has run on the current IR without
// changing it (a pass that changed nothing need not run again until another
// one has). True if anything changed.
fn cleanup(f: *mut ir.Func, level: i32) bool {
    let mut any = false;
    let mut npasses: i32 = 2;
    if level > 0 {
        npasses = 5;
    }
    let mut quiet: i32 = 0;  // passes in a row that changed nothing
    let mut threaded = false;
    let mut k: i32 = 0;
    while (quiet < npasses) and (k < (9 * npasses)) {
        let mut c = false;
        match k % npasses {
            0 => { c = opt.fold_combine(f, level > 0); }
            1 => { c = opt.simplify_cfg(f); }
            2 => {
                // selects of values that no branch tests, before threading
                // duplicates their merges into trees of constants
                c = thr.if_convert_values(f);
            }
            3 => {
                c = thr.jump_thread(f);
                threaded = c;
            }
            else => { c = thr.if_convert(f, not threaded); }
        }
        if c {
            quiet = 0;
            any = true;
        } else {
            quiet += 1;
        }
        k += 1;
    }
    return any;
}

// Scalar replacement and promotion until there is nothing more to take apart
// (at most 6 rounds).
fn sroa_rounds(f: *mut ir.Func, level: i32) void {
    let mut rounds: i32 = 0;
    while (rounds < 6) and sroa.sroa(f) {
        opt.mem2reg(f);
        _ = cleanup(f, level);
        rounds += 1;
    }
}

// Value numbering again only when the cleanup after it found more to do (at
// most 3 rounds).
fn gvn_rounds(f: *mut ir.Func, level: i32) void {
    let mut rounds: i32 = 0;
    while (rounds < 3) and gvn.gvn(f) and cleanup(f, level) {
        rounds += 1;
    }
}

const REGIONS_MAX_VALS: i32 = 1500;

// Jump threading through several blocks (the cleanups thread through one:
// this search costs more, and runs once a function is complete, after
// inlining), and the redundancies it exposes (at most 3 rounds).
fn thread_regions(f: *mut ir.Func, level: i32) bool {
    if f.nvals > REGIONS_MAX_VALS {
        return false;  // (large functions: the search and the passes after it cost too much)
    }
    let mut rounds: i32 = 0;
    while (rounds < 3) and thr.thread_regions(f) {
        _ = cleanup(f, level);
        // (the copies' loads and tests that others repeat; a branch folded
        // needs only the cleanup)
        if (thr.region_copies > 0) and gvn.gvn(f) {
            _ = cleanup(f, level);
        }
        rounds += 1;
    }
    return rounds > 0;
}

// Loop-invariant code motion, and the redundancies it exposes.
fn licm(f: *mut ir.Func, level: i32) void {
    gvn.promoted = false;
    if gvn.licm(f) {
        if gvn.promoted {
            opt.mem2reg(f);  // (the slots of locations promoted across loops)
        }
        _ = cleanup(f, level);
        _ = gvn.gvn(f);
        _ = cleanup(f, level);
    }
}

// Counters narrower than a pointer widened (loops.ax), and what that leaves
// to fold.
fn widen(f: *mut ir.Func, level: i32) void {
    if loops.widen(f) {
        opt.dce(f);
        _ = cleanup(f, level);
        _ = gvn.gvn(f);
        _ = cleanup(f, level);
    }
}

// A function that calls setjmp (ir.Func's returns_twice) only has its
// constants folded and its blocks simplified: what it stores stays in its
// slots, which longjmp leaves as they were (C 7.13.2.1p3).
fn returns_twice(f: *mut ir.Func) bool {
    if not f.returns_twice {
        return false;
    }
    _ = cleanup(f, 0);
    opt.dce(f);
    ir.recycle(f);
    return true;
}

/// The optimizer's level for f: its own (ir.Func.opt_override), or level.
pub fn level_of(f: *ir.Func, level: i32) i32 {
    if f.opt_override > 0 {
        return @as(i32, f.opt_override) - 1;
    }
    return level;
}

pub fn optimize_func(f: *mut ir.Func, level0: i32) void {
    let level = level_of(f, level0);
    if returns_twice(f) {
        return;
    }
    opt.mem2reg(f);
    _ = cleanup(f, level);
    if level > 0 {
        // calls of itself in tail position: a loop
        if tre.eliminate_tail_calls(f) {
            _ = cleanup(f, level);
        }
        // copies of aggregates that are only read (before scalar
        // replacement, which then takes the source apart instead)
        if copies.forward_copies(f) {
            _ = cleanup(f, level);
        }
        sroa_rounds(f, level);
        // copies and loads out of slots filled piece by piece (once scalar
        // replacement has taken apart the slices that held their addresses)
        if copies.split_copies(f) {
            _ = cleanup(f, level);
            sroa_rounds(f, level);
        }
        gvn_rounds(f, level);
        // slots copied whole into memory they could have been built in (the
        // ones scalar replacement left in memory)
        if copies.forward_into(f) {
            _ = cleanup(f, level);
        }
        if unr.onehot_stores(f) {
            _ = cleanup(f, level);
        }
        let dead = gvn.dse(f);
        if copies.unread_writes(f) or dead {
            _ = gvn.gvn(f);
            _ = cleanup(f, level);
        }
        if gvn.ss_opt(f) {
            _ = cleanup(f, level);
        }
        opt.loop_restricts(f);  // (C's restrict scopes in loops: before the loop passes)
        let mut rounds: i32 = 0;
        while (rounds < 8) and gvn.loop_idioms(f) {
            _ = cleanup(f, level);
            rounds += 1;
        }
        licm(f, level);
        widen(f, level);
        if idioms.loop_copies(f) {
            opt.dce(f);
            _ = cleanup(f, level);
        }
        if (level >= 2) and vec.vectorize(f) {
            opt.dce(f);
            _ = cleanup(f, level);
        }
        if slp.compare_masks(f) {
            _ = cleanup(f, level);
        }
        if slp.byte_sums(f) {
            _ = cleanup(f, level);
        }
        opt.dce(f);
        _ = gvn.sink(f);
    }
    opt.dce(f);
    // what the passes took out of f (and did not put back) is garbage now
    ir.recycle(f);
}

// Unrolls loops with a small constant trip count, one at a time (an inner
// loop's start may be a constant once its outer loop is unrolled). True if
// any was.
fn unroll(f: *mut ir.Func) bool {
    let mut n: i32 = 0;
    while (n < 32) and unr.full_unroll(f) {
        n += 1;
    }
    return n > 0;
}

fn resimplify(f: *mut ir.Func) void {
    light_func(f, 2);
}

// The passes after inlining: the ones the inlined code gives work to
// (promotion of the callees' locals, copies of arguments, folding, scalar
// replacement, value numbering, the shadow stack's pushes and pops, loop
// invariants, dead code, sinking). The others (tail calls, the idioms of
// loops and vectors) already ran on the function before inlining.
fn light_func(f: *mut ir.Func, level0: i32) void {
    let level = level_of(f, level0);
    if returns_twice(f) {
        return;
    }
    opt.mem2reg(f);
    _ = cleanup(f, level);
    if copies.forward_copies(f) {
        _ = cleanup(f, level);
    }
    sroa_rounds(f, level);
    gvn_rounds(f, level);
    if gvn.ss_opt(f) {
        _ = cleanup(f, level);
    }
    opt.loop_restricts(f);  // (C's restrict scopes in loops: before licm)
    licm(f, level);
    widen(f, level);
    opt.dce(f);
    _ = gvn.sink(f);
    opt.dce(f);
    ir.recycle(f);
}

fn split_cold(m: *mut ir.Module, f: *mut ir.Func) *mut ir.Func {
    let g = outl.outline_one(m, f);
    if u.notnil(g) {
        optimize_func(f, 2);
    }
    return g;
}

pub fn optimize_module(m: *mut ir.Module, level: i32) void {
    opt.keep_vars = level == 0;
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if not ir.is_decl(f) {
            optimize_func(f, level);
        }
    }
    u.phase("optimize: functions");
    if level >= 2 {
        // uncommon paths that make calls leave small functions (to inline)
        let mut changed = u.List.[*mut ir.Func].empty();
        if outl.outline_module(m, &mut changed) {
            for i in 0..changed.len {
                optimize_func(changed.get(i), level);
            }
        }
        changed.deinit();
        u.phase("optimize: outline");
        // twice: inlining exposes constant arguments (a comparison function
        // passed down through an inlined call), which make new direct calls
        for _round in @as(i32, 0)..2 {
            let consts = inl.ipcp(m);
            for i in 0..consts.len {
                optimize_func(consts.get(i), level);
            }
            u.phase("optimize: constant arguments");
            inl.inline_module(m, resimplify, split_cold);
            u.phase("optimize: inline");
        }
    }
    if level > 0 {
        // (before finish_funcs, from the IR all parts of a module compiled in
        // parts see alike: backend.ax)
        slots.find_kept_params(m);
    }
}

// The passes after inlining, which see one function at a time, over the
// functions i of m with sel[i] (all of them if sel is empty): small loops
// unrolled and loops fused, vector stores, (-O1 and up) stack slots
// shared, and with --coverage=afl the coverage counters (cover.ax).
// optimize_module comes first.
pub fn finish_funcs(m: *mut ir.Module, level0: i32, sel: []bool) void {
    if level0 >= 2 {
        tre.prepare_sibling(m);
    }
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if ir.is_decl(f) or ((sel.len > 0) and not sel[i]) {
            continue;
        }
        // C's object sizes the passes did not find (at every level: no
        // backend sees them)
        opt.finish_objsizes(f);
        if f.returns_twice {
            continue;  // (returns_twice: not optimized, its slots apart, no sibling calls)
        }
        let level = level_of(f, level0);
        if level >= 2 {
            finish_func(f, level);
        }
        if level >= 2 {
            // switches that give constants: table lookups (switches.ax)
            _ = sw.lookup_tables(m, f);
        }
        if level > 0 {
            // divisions by constants as multiplications (last: the passes
            // before see the divisions)
            _ = divc.expand(f);
            // stack slots: copies between them coalesced, and those never
            // needed at the same time sharing their bytes (once the passes,
            // which tell slots apart by their allocas, are done)
            _ = slots.colour_slots(f);
        }
        if f.coverage {
            cover.instrument(m, f);  // --coverage=afl: last, after the optimizer
        }
        if (level >= 2) and (level0 >= 2) {
            _ = tre.mark_sibling_calls(f);  // (after everything that could put code after a call)
        }
    }
    u.phase("optimize: loops, vectors, stack slots");
}

// finish_funcs over all of m.
pub fn finish_module(m: *mut ir.Module, level: i32) void {
    finish_funcs(m, level, u.nil_slice.[bool]());
    slots.forget_kept_params();
}

fn finish_func(f: *mut ir.Func, level: i32) void {
    if thread_regions(f, level) {
        opt.dce(f);
        ir.recycle(f);
    }
    if unroll(f) {
        optimize_func(f, level);
    }
    // loops in a row (an outer loop unrolled) as one
    let mut jams: i32 = 0;
    while (jams < 4) and unr.jam_loops(f) {
        jams += 1;
    }
    if jams > 0 {
        optimize_func(f, level);
    }
    // small loops whose trip count is not known, by two (then the copies'
    // constants folded and what they compute alike shared)
    if unr.runtime_unroll(f) {
        _ = cleanup(f, level);
        _ = gvn.gvn(f);
        _ = cleanup(f, level);
        opt.dce(f);
        ir.recycle(f);
    }
    let split = gvn.split_loops(f);
    if split or gvn.reduce_addresses(f, tg.is_wasm()) {
        gvn_rounds(f, level);
        licm(f, level);
        opt.dce(f);
    }
    // stores of neighbouring elements as vector stores, once the
    // scalar passes (store forwarding, dead stores) are done
    if slp.store_groups(f) {
        _ = cleanup(f, level);
        _ = gvn.gvn(f);
        opt.dce(f);
    }
    // and scalars only broadcast, neighbouring lanes, as vectors
    if slp.splat_groups(f) {
        _ = cleanup(f, level);
        opt.dce(f);
    }
}
