// =============================================================================
// asm/core.ax - what the two assemblers (asm/x64.ax, asm/a64.ax) share: the
// assembly text read into statements (labels, a directive or instruction and
// its operands), expressions over numbers and symbols, sections and their
// bytes, the directives that are not an architecture's, labels (named, and
// numeric local ones: `1:`, `1b`, `1f`), relocations, and the passes that
// settle the sizes of instructions whose length depends on where labels are
// (an architecture's encoder chooses the short form of a jump while its
// target is near: `Stmt.long_` is set, never cleared, when it is not, so the
// passes end).
//
// Two kinds of text are assembled: an asm statement's template (`inline_`:
// its .text bytes go into its function's code, its other sections' into the
// object's, its labels and .globl symbols become the object's: asm/obj.ax)
// and file-scope asm (sections and symbols of the object). The syntax is the
// conventional assembler's for the architecture (AT&T or Intel for x86-64);
// what an instruction or directive this does not know is, is an error
// naming it, never silently wrong bytes.
// =============================================================================
import "../elf.ax" as elf;
import "../target.ax" as tg;
import "../util.ax" as u;
import "inline.ax" as ai;

// -----------------------------------------------------------------------------
// The assembly
// -----------------------------------------------------------------------------
pub struct Stmt {
    line: i32,      // its line in the text (from 1)
    labels: []i32,  // the labels defined just before it (Def indexes)
    op: []u8,       // the directive (with its '.') or mnemonic, lower case; empty for none
    args: []u8,     // the rest of the statement
    long_: bool,    // (the encoder's: a jump that needs its long form)
    aux: i64,       // (the encoder's)
    sec: i32,       // where it was assembled (the last pass): its section and offset
    at: u64,
    lfile: []u8,  // the location .loc gave before it (empty: none), and its line
    lline: i32,
}

pub struct Sec {
    name: []u8,
    kind: i32,  // elf.S_*
    data: u.List.[u8],
    size: u64,  // a section without data (bss): its size
    align: u64,
}

pub struct Reloc {
    sec: i32,
    off: u64,
    ty: u32,     // elf.R_*
    name: []u8,  // the symbol: one this text defines, or another (external)
    addend: i64,
}

// A label or symbol of the text.
pub struct Def {
    name: []u8,
    sec: i32,  // -1: not defined (yet)
    off: u64,
    prev_sec: i32,  // where the previous pass put it (forward references read this)
    prev_off: u64,
    defined: bool,  // in this pass
    global: bool,
    weak: bool,
    ty: u8,  // elf.T_*
    size: i64,
    has_size: bool,
    numeric: bool,  // a numeric local label (`1:`): one of its definitions
    abs: bool,      // `.set name, value` of a constant: value in off
    tmp: bool,      // the current place (`.`) where an expression was read
    intext: bool,   // a label this text defines
    set_si: usize,  // abs: the statement that set it (.set)
}

/// A statement of the text before the expander: its text (labels and all).
pub struct Raw {
    text: []u8,
    line: i32,
}

/// A macro (.macro name params ... .endm).
struct Macro {
    name: []u8,
    params: [][]u8,
    defaults: [][]u8,
    req: []bool,
    vararg: bool,  // the last parameter takes the rest of the arguments
    body: []Raw,
}

pub struct Asm {
    arch: i32,
    inline_: bool,
    text: []u8,
    raw: u.List.[Raw],
    macros: u.List.[Macro],
    nmacro: i64,   // macros expanded so far (\@)
    xline: i32,    // the line the expander is at (for its errors)
    dirs: [][]u8,  // where .incbin looks for files (the first: the source's directory)
    stmts: u.List.[Stmt],
    secs: u.List.[Sec],
    cur: i32,
    stack: u.List.[i32],
    prev: i32,  // .previous
    defs: u.List.[Def],
    names: u.SymMap.[i32],           // name -> Def index + 1
    numeric: u.List.[u.List.[i64]],  // numeric label n -> its definitions (statement index << 32 | Def index)
    relocs: u.List.[Reloc],
    err: []u8,
    err_line: i32,
    pass: i32,
    changed: bool,
    origin: u64,   // inline: where the text starts in its section (for alignment)
    si: usize,     // the statement being assembled
    comment: u8,   // the comment character ('#' for x86-64, 0: '//' only)
    intel: bool,   // x86-64: the Intel syntax is in force (.intel_syntax)
    intel0: bool,  // x86-64: the syntax the text starts in (each pass)
    // call frame information (.cfi_*: cfi_directive)
    procs: u.List.[Proc],  // file-scope: the procedures
    icfi: u.List.[ICfi],   // inline: the template's events
    in_proc: bool,
    cfi_simple: bool,
    cfi_signal: bool,
    cfi_sec: i32,
    cfi_start: u64,
    cfi_loc: u64,  // the place the program has advanced to
    cfi_prog: u.Buf,
    cfi_reg: u64,  // the CFA's register (DWARF) and offset (inline: the stack pointer's move)
    cfi_off: i64,
    cfi_stack: u.List.[i64],  // .cfi_remember_state's
    cfi_x: ProcX,             // the procedure's personality, LSDA, ... (.cfi_personality, ...)
    cfi_no_eh: bool,          // .cfi_sections without .eh_frame (from there on)
    cfi_no_debug: bool,       // ... without .debug_frame
    // Windows unwind information (.seh_*: seh_directive)
    sehs: u.List.[SehProc],
    in_seh: bool,
    seh_sec: i32,
    seh_start: u64,
    seh_prolog: i64,  // the prologue's size (.seh_endprologue), or -1
    seh_codes: u.List.[[]u8],
    seh_epis: u.List.[i64],  // ARM64: each epilogue's offset and its first code's index in seh_codes
    seh_frame: u64,          // x86-64: the frame register and offset (UNWIND_INFO's fourth byte)
    // debug information: .file N "name" (the names), .loc N line (the place in force)
    files: u.List.[[]u8],
    loc_file: []u8,
    loc_line: i32,
    uses_sp: bool,       // an instruction names the stack pointer, or pushes, pops or calls (stack_use)
    calls: bool,         // an instruction calls (x86-64 call, AArch64 bl, blr ...)
    lits: u.List.[Lit],  // AArch64: the literal pool's entries of this pass (`ldr x0, =value`)
}

/// An entry of a literal pool: the value's text, its size, its section and
/// label (a Def), and whether it has been placed (.ltorg, or the pass's end).
pub struct Lit {
    expr: []u8,
    size: u32,
    sec: i32,
    def: i32,
    placed: bool,
}

/// A new assembly of `text` for arch (inline_: an asm statement's template).
pub fn new_asm(arch: i32, text: []u8, inline_: bool, comment: u8) *mut Asm {
    let A = u.new.[Asm]();
    A.arch = arch;
    A.text = text;
    A.inline_ = inline_;
    A.comment = comment;
    A.names = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    A.err_line = -1;
    A.pass = -1;
    A.dirs = u.no_strs();
    return A;
}

/// Reports an error at the statement being assembled (the first only).
pub fn fail(A: *mut Asm, msg: []u8) void {
    if A.err.len > 0 {
        return;
    }
    let mut line: i32 = A.xline;
    if (A.pass >= 0) and (A.si < A.stmts.len) {
        line = A.stmts.get(A.si).line;
    }
    A.err_line = line;
    A.err = msg;
}

pub fn failed(A: *Asm) bool {
    return A.err.len > 0;
}

/// The message of the error, with its line (when the text has several).
pub fn message(A: *Asm) []u8 {
    let mut many = false;
    for ch in A.text {
        if ch == '\n' {
            many = true;
        }
    }
    if many and (A.err_line > 0) {
        return u.f2("%s (line %s of the assembly)", A.err, u.idec(A.err_line));
    }
    return A.err;
}

// -----------------------------------------------------------------------------
// Reading the text
// -----------------------------------------------------------------------------
pub fn is_sym_start(c: u8) bool {
    return ((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z')) or (c == '_') or (c == '.') or (c == '$');
}

pub fn is_sym_char(c: u8) bool {
    return is_sym_start(c) or u.is_digit(c);
}

pub fn is_space(c: u8) bool {
    return (c == ' ') or (c == '\t') or (c == '\r') or (c == 11) or (c == 12);
}

pub fn trim(s: []u8) []u8 {
    let mut a: usize = 0;
    let mut b = s.len;
    while (a < b) and is_space(s[a]) {
        a += 1;
    }
    while (b > a) and is_space(s[b - 1]) {
        b -= 1;
    }
    return s[a..b];
}

pub fn lower(s: []u8) []u8 {
    let b = u.newn.[u8](s.len + 1);
    for k in 0..s.len {
        let c = s[k];
        if (c >= 'A') and (c <= 'Z') {
            b[k] = c + 32;
        } else {
            b[k] = c;
        }
    }
    return b[0..s.len];
}

// Splits the text into raw statements (at newlines and ';', outside
// strings), without comments: what the expander (below) reads.
fn split(A: *mut Asm) void {
    let t = A.text;
    let mut line: i32 = 1;
    let mut b = u.Buf.init();
    let mut i: usize = 0;
    let mut st_line: i32 = 1;
    while i <= t.len {
        if i == t.len {
            A.raw.push(Raw.{ text: b.done(), line: st_line });
            break;
        }
        let c = t[i];
        if c == '"' {
            // a string: to its closing quote
            b.c(c);
            i += 1;
            while (i < t.len) and (t[i] != '"') and (t[i] != '\n') {
                if (t[i] == '\\') and ((i + 1) < t.len) {
                    b.c(t[i]);
                    i += 1;
                }
                b.c(t[i]);
                i += 1;
            }
            if (i < t.len) and (t[i] == '"') {
                b.c('"');
                i += 1;
            }
            continue;
        }
        if (c == '\'') and ((i + 1) < t.len) {
            // a character constant ('c, 'c', '\n'): its character is not a separator
            b.c(c);
            i += 1;
            if (t[i] == '\\') and ((i + 1) < t.len) {
                b.c(t[i]);
                i += 1;
            }
            if t[i] != '\n' {
                b.c(t[i]);
                i += 1;
            }
            continue;
        }
        if (c == '/') and ((i + 1) < t.len) and (t[i + 1] == '*') {
            i += 2;
            while ((i + 1) < t.len) and not ((t[i] == '*') and (t[i + 1] == '/')) {
                if t[i] == '\n' {
                    line += 1;
                }
                i += 1;
            }
            i += 2;
            b.c(' ');
            continue;
        }
        // (AArch64: `//`, and `#` first on a line, as the conventional assembler has them)
        let line_comment = ((c == '/') and ((i + 1) < t.len) and (t[i + 1] == '/') and (A.comment == 0)) or
                           ((A.comment != 0) and (c == A.comment)) or
                           ((A.comment == 0) and (c == '#') and (trim(b.view()).len == 0));
        if line_comment {
            while (i < t.len) and (t[i] != '\n') {
                i += 1;
            }
            continue;
        }
        if (c == '\n') or (c == ';') {
            A.raw.push(Raw.{ text: b.done(), line: st_line });
            b = u.Buf.init();
            if c == '\n' {
                line += 1;
            }
            st_line = line;
            i += 1;
            continue;
        }
        b.c(c);
        i += 1;
    }
}

// One statement's text: its labels, then its directive or instruction.
fn add_stmt(A: *mut Asm, s0: []u8, line: i32) void {
    let mut s = trim(s0);
    let mut labels = u.List.[i32].empty();
    loop {
        // `name:` (or `1:`) at the start
        let mut k: usize = 0;
        if (s.len > 0) and u.is_digit(s[0]) {
            while (k < s.len) and u.is_digit(s[k]) {
                k += 1;
            }
        } else if (s.len > 0) and is_sym_start(s[0]) {
            while (k < s.len) and is_sym_char(s[k]) {
                k += 1;
            }
        }
        if (k == 0) or (k >= s.len) or (s[k] != ':') {
            break;
        }
        let name = s[0..k];
        labels.push(label_def(A, name, line));
        s = trim(s[k + 1..]);
    }
    // `name = expr`: .set
    let mut k: usize = 0;
    while (k < s.len) and is_sym_char(s[k]) {
        k += 1;
    }
    let rest = trim(s[k..]);
    if (k > 0) and (rest.len > 1) and (rest[0] == '=') and (rest[1] != '=') {
        A.stmts.push(Stmt.{ line: line, labels: labels.items(), op: ".set", args: u.cat3(s[0..k], ",", rest[1..]),
                            long_: false, aux: 0, sec: 0, at: 0, lfile: "", lline: 0 });
        return;
    }
    while (k < s.len) and not is_space(s[k]) {
        k += 1;
    }
    let op = lower(s[0..k]);
    let args = trim(s[k..]);
    if (op.len == 0) and (labels.len == 0) {
        return;
    }
    A.stmts.push(Stmt.{ line: line, labels: labels.items(), op: op, args: args, long_: false, aux: 0, sec: 0, at: 0,
                        lfile: "", lline: 0 });
}

// -----------------------------------------------------------------------------
// The expander: macros (.macro ... .endm, with parameters, defaults, :req,
// :vararg, \@ and \()), repetitions (.rept, .irp, .irpc ... .endr) and
// conditional assembly (.if and its kin, .else, .elseif, .endif), as the
// conventional assembler's manual describes them, before the passes. Conditions are
// evaluated where they are read, with the constants .set and .equ have
// given so far and the labels defined so far (.ifdef); a value that
// depends on where labels are placed is an error there.
// -----------------------------------------------------------------------------
struct Cond {
    active: bool,  // its current branch is assembled (and so are its parents')
    done: bool,    // a branch was taken (the rest are not)
    else_: bool,   // .else seen
    outer: bool,   // the enclosing conditions' state
}

// A raw statement split: the text of its labels, its directive or
// mnemonic (lower case) and the rest.
struct Parts {
    labels: []u8,
    op: []u8,
    args: []u8,
}

fn parts(s0: []u8) Parts {
    let s = trim(s0);
    let mut at: usize = 0;
    loop {
        let t = s[at..];
        let mut k: usize = 0;
        if (t.len > 0) and u.is_digit(t[0]) {
            while (k < t.len) and u.is_digit(t[k]) {
                k += 1;
            }
        } else if (t.len > 0) and is_sym_start(t[0]) {
            while (k < t.len) and is_sym_char(t[k]) {
                k += 1;
            }
        }
        if (k == 0) or (k >= t.len) or (t[k] != ':') {
            break;
        }
        at += k + 1;
        while (at < s.len) and is_space(s[at]) {
            at += 1;
        }
    }
    let t = s[at..];
    let mut k: usize = 0;
    while (k < t.len) and not is_space(t[k]) {
        k += 1;
    }
    let mut op = lower(t[0..k]);
    let mut args = trim(t[k..]);
    // `name = value` and `name=value`
    let eq = u.find(t, '=');
    if (eq > 0) and ((@int_cast(usize, eq) + 1) < t.len) and (t[@int_cast(usize, eq) + 1] != '=') {
        let nm = trim(t[0..@int_cast(usize, eq)]);
        let mut all = nm.len > 0;
        for c in nm {
            if not is_sym_char(c) {
                all = false;
            }
        }
        if all {
            op = "=";
            args = u.cat3(nm, ",", t[@int_cast(usize, eq) + 1..]);
        }
    }
    return Parts.{ labels: s[0..at], op: op, args: args };
}

fn is_cond_op(op: []u8) bool {
    return u.starts(op, ".if") or u.str_eq(op, ".else") or u.str_eq(op, ".elseif") or u.str_eq(op, ".endif");
}

// Is the assembly being read assembled (no enclosing condition is false)?
fn cond_active(conds: *u.List.[Cond]) bool {
    if conds.len == 0 {
        return true;
    }
    return conds.get(conds.len - 1).active;
}

fn macro_of(A: *Asm, name: []u8) i32 {
    let mut k = A.macros.len;
    while k > 0 {
        k -= 1;
        if u.str_eq(A.macros.get(k).name, name) {
            return @int_cast(i32, k);
        }
    }
    return -1;
}

// Expands A.raw into A.stmts.
fn expand(A: *mut Asm) void {
    let mut conds = u.List.[Cond].empty();
    let mut exitm = false;
    expand_lines(A, A.raw.items(), 0, &mut conds, &mut exitm);
    if not failed(A) and (conds.len > 0) {
        fail(A, ".if without .endif");
    }
}

// The body of a block that starts at lines[i] (.macro or .rept ...) up to
// its end (`end`: .endm or .endr), nested blocks of the same kind
// included; *next is the line after its end.
fn block(A: *mut Asm, lines: []Raw, i: usize, end: []u8, next: *mut usize) []Raw {
    let mut depth: i32 = 0;
    let mut j = i + 1;
    let mut out = u.List.[Raw].empty();
    while j < lines.len {
        let p = parts(lines[j].text);
        let mut opens = u.str_eq(p.op, ".rept") or u.str_eq(p.op, ".irp") or u.str_eq(p.op, ".irpc") or
                        u.str_eq(p.op, ".rep");
        if u.str_eq(end, ".endm") {
            opens = u.str_eq(p.op, ".macro");
        }
        if opens {
            depth += 1;
        } else if u.str_eq(p.op, end) or (u.str_eq(end, ".endm") and u.str_eq(p.op, ".endmacro")) {
            if depth == 0 {
                next.* = j + 1;
                return out.items();
            }
            depth -= 1;
        }
        out.push(lines[j]);
        j += 1;
    }
    A.xline = lines[i].line;
    fail(A, u.f2("%s without %s", parts(lines[i].text).op, end));
    next.* = lines.len;
    return out.items();
}

fn expand_lines(A: *mut Asm, lines: []Raw, depth: i32, conds: *mut u.List.[Cond], exitm: *mut bool) void {
    if depth > 200 {
        fail(A, "macros or repetitions nested too deeply (200 levels)");
        return;
    }
    let mut i: usize = 0;
    while (i < lines.len) and not failed(A) and not exitm.* {
        let r = lines[i];
        A.xline = r.line;
        let p = parts(r.text);
        if is_cond_op(p.op) {
            conditional(A, p, conds);
            i += 1;
            continue;
        }
        if not cond_active(conds) {
            i += 1;
            continue;
        }
        if (p.labels.len > 0) and
           (u.str_eq(p.op, ".macro") or u.str_eq(p.op, ".rept") or u.str_eq(p.op, ".rep") or u.str_eq(p.op, ".irp") or
            u.str_eq(p.op, ".irpc") or (macro_of(A, p.op) >= 0)) {
            add_stmt(A, p.labels, r.line);
        }
        if u.str_eq(p.op, ".macro") {
            let mut next: usize = 0;
            let body = block(A, lines, i, ".endm", &mut next);
            define_macro(A, p.args, body);
            i = next;
            continue;
        }
        if u.str_eq(p.op, ".rept") or u.str_eq(p.op, ".rep") or u.str_eq(p.op, ".irp") or u.str_eq(p.op, ".irpc") {
            let mut next: usize = 0;
            let body = block(A, lines, i, ".endr", &mut next);
            if failed(A) {
                return;
            }
            A.xline = r.line;
            repeat(A, p, body, depth, conds, exitm);
            i = next;
            continue;
        }
        if u.str_eq(p.op, ".endm") or u.str_eq(p.op, ".endr") or u.str_eq(p.op, ".endmacro") {
            fail(A, u.f1("%s without its beginning", p.op));
            return;
        }
        if u.str_eq(p.op, ".exitm") {
            exitm.* = true;
            return;
        }
        if u.str_eq(p.op, ".purgem") {
            let k = macro_of(A, lower(trim(p.args)));
            if k < 0 {
                fail(A, u.f1("the macro '%s' is not defined", trim(p.args)));
                return;
            }
            A.macros.at(@int_cast(usize, k)).name = "";
            i += 1;
            continue;
        }
        let mk = macro_of(A, p.op);
        if mk >= 0 {
            invoke(A, mk, p.args, depth, conds);
            i += 1;
            continue;
        }
        if u.str_eq(p.op, ".err") {
            fail(A, ".err");
            return;
        }
        if u.str_eq(p.op, ".error") {
            let a = trim(p.args);
            if (a.len >= 2) and (a[0] == '"') {
                fail(A, string(A, a));
            } else {
                fail(A, ".error");
            }
            return;
        }
        if u.str_eq(p.op, ".warning") or u.str_eq(p.op, ".print") {
            i += 1;  // (messages for the person assembling: no effect on the object)
            continue;
        }
        if u.str_eq(p.op, ".include") {
            fail(A, ".include is not supported (the template or source must hold all of its text)");
            return;
        }
        add_stmt(A, r.text, r.line);
        if u.str_eq(p.op, ".set") or u.str_eq(p.op, ".equ") or u.str_eq(p.op, ".equiv") or u.str_eq(p.op, ".eqv") or
           u.str_eq(p.op, "=") {
            preset(A, p.op, p.args);
        }
        i += 1;
    }
}

// .set and its kin while expanding: a constant's value, for conditions and
// counts that follow (the passes assign it again in order); .equiv of a
// symbol already defined is an error.
fn preset(A: *mut Asm, op: []u8, args: []u8) void {
    let xs = split_args(args);
    if xs.len != 2 {
        return;
    }
    let d = sym(A, trim(xs[0]));
    let def = A.defs.get(@int_cast(usize, d));
    if u.str_eq(op, ".equiv") and (def.abs or def.intext) {
        fail(A, u.f1("the symbol '%s' is already defined (.equiv)", def.name));
        return;
    }
    let saved = A.err;
    let v = settle(A, eval(A, xs[1]));
    A.err = saved;  // (not a constant yet: the passes give it its value)
    let p = A.defs.at(@int_cast(usize, d));
    if v.ok and is_const(v) {
        p.abs = true;
        p.off = @bit_cast(u64, v.k);
    } else {
        p.intext = true;
    }
}

// .if and its kin, .else, .elseif, .endif.
fn conditional(A: *mut Asm, p: Parts, conds: *mut u.List.[Cond]) void {
    let op = p.op;
    if u.str_eq(op, ".endif") {
        if conds.len == 0 {
            fail(A, ".endif without .if");
            return;
        }
        _ = conds.pop();
        return;
    }
    if u.str_eq(op, ".else") or u.str_eq(op, ".elseif") {
        if conds.len == 0 {
            fail(A, u.f1("%s without .if", op));
            return;
        }
        let c = conds.at(conds.len - 1);
        if c.else_ {
            fail(A, u.f1("%s after .else", op));
            return;
        }
        if u.str_eq(op, ".else") {
            c.else_ = true;
            c.active = c.outer and not c.done;
            c.done = true;
            return;
        }
        if c.done or not c.outer {
            c.active = false;
            return;
        }
        let t = eval_const(A, p.args, "the condition of .elseif") != 0;
        c.active = t;
        c.done = t;
        return;
    }
    let outer = cond_active(conds);
    let mut t = false;
    if outer {
        t = cond_true(A, op, p.args);
    }
    conds.push(Cond.{ active: outer and t, done: t, else_: false, outer: outer });
}

// Is the condition of `.if`-kind op with args true?
fn cond_true(A: *mut Asm, op: []u8, args: []u8) bool {
    let a = trim(args);
    if u.str_eq(op, ".ifdef") or u.str_eq(op, ".ifndef") or u.str_eq(op, ".ifnotdef") {
        let found = A.names.get(u.intern(a));
        let mut def = false;
        if found != 0 {
            let d = A.defs.get(@int_cast(usize, found - 1));
            def = d.abs or d.intext;
        }
        return def == u.str_eq(op, ".ifdef");
    }
    if u.str_eq(op, ".ifb") or u.str_eq(op, ".ifnb") {
        return (a.len == 0) == u.str_eq(op, ".ifb");
    }
    if u.str_eq(op, ".ifc") or u.str_eq(op, ".ifnc") {
        let xs = split_args(a);
        let mut x = "";
        let mut y = "";
        if xs.len > 0 {
            x = unquote1(xs[0]);
        }
        if xs.len > 1 {
            y = unquote1(xs[1]);
        }
        return u.str_eq(x, y) == u.str_eq(op, ".ifc");
    }
    if u.str_eq(op, ".ifeqs") or u.str_eq(op, ".ifnes") {
        let xs = split_args(a);
        if xs.len != 2 {
            fail(A, u.f1("%s needs two strings", op));
            return false;
        }
        return u.str_eq(string(A, xs[0]), string(A, xs[1])) == u.str_eq(op, ".ifeqs");
    }
    let names = [".if", ".ifne", ".ifeq", ".iflt", ".ifle", ".ifgt", ".ifge"];
    for k in 0..names.len {
        if u.str_eq(op, names[k]) {
            let v = eval_const(A, a, u.f1("the condition of %s", op));
            if k <= 1 {
                return v != 0;
            }
            if k == 2 {
                return v == 0;
            }
            if k == 3 {
                return v < 0;
            }
            if k == 4 {
                return v <= 0;
            }
            if k == 5 {
                return v > 0;
            }
            return v >= 0;
        }
    }
    fail(A, u.f1("the directive '%s' is not supported", op));
    return false;
}

// A .ifc operand: its text, or what is between its single quotes.
fn unquote1(s0: []u8) []u8 {
    let s = trim(s0);
    if (s.len >= 2) and (s[0] == '\'') and (s[s.len - 1] == '\'') {
        return s[1..s.len - 1];
    }
    return s;
}

// .macro name params: the macro is defined (body: its lines).
fn define_macro(A: *mut Asm, args: []u8, body: []Raw) void {
    let a = trim(args);
    let mut k: usize = 0;
    while (k < a.len) and not is_space(a[k]) and (a[k] != ',') {
        k += 1;
    }
    let name = lower(a[0..k]);
    if name.len == 0 {
        fail(A, ".macro needs a name");
        return;
    }
    let mut rest = trim(a[k..]);
    if (rest.len > 0) and (rest[0] == ',') {
        rest = trim(rest[1..]);
    }
    let mut params = u.List.[[]u8].empty();
    let mut defs = u.List.[[]u8].empty();
    let mut req = u.List.[bool].empty();
    let mut vararg = false;
    for x in macro_words(rest) {
        let mut pn = x;
        let mut dflt = "";
        let eq = u.find(x, '=');
        if eq >= 0 {
            pn = trim(x[0..@int_cast(usize, eq)]);
            dflt = unquote_arg(trim(x[@int_cast(usize, eq) + 1..]));
        }
        let mut rq = false;
        let colon = u.find(pn, ':');
        if colon >= 0 {
            let q = lower(pn[@int_cast(usize, colon) + 1..]);
            pn = pn[0..@int_cast(usize, colon)];
            if u.str_eq(q, "req") {
                rq = true;
            } else if u.str_eq(q, "vararg") {
                vararg = true;
            } else {
                fail(A, u.f1("':%s' is not a qualifier of a macro parameter (req, vararg)", q));
                return;
            }
        }
        params.push(pn);
        defs.push(dflt);
        req.push(rq);
    }
    A.macros.push(Macro.{ name: name, params: params.items(), defaults: defs.items(), req: req.items(), vararg: vararg,
                          body: body });
}

// The words of a parameter or argument list: separated by commas, or by
// spaces outside quotes and parentheses (`a, b=2` and `a b=2` alike).
fn macro_words(s: []u8) [][]u8 {
    let mut out = u.List.[[]u8].empty();
    let mut i: usize = 0;
    while i < s.len {
        while (i < s.len) and (is_space(s[i]) or (s[i] == ',')) {
            if s[i] == ',' {
                // an empty argument between two commas
                let mut j = i + 1;
                while (j < s.len) and is_space(s[j]) {
                    j += 1;
                }
                if (j < s.len) and (s[j] == ',') {
                    out.push("");
                }
            }
            i += 1;
        }
        if i >= s.len {
            break;
        }
        let st = i;
        let mut depth: i32 = 0;
        while i < s.len {
            let c = s[i];
            if c == '"' {
                i += 1;
                while (i < s.len) and (s[i] != '"') {
                    if (s[i] == '\\') and ((i + 1) < s.len) {
                        i += 1;
                    }
                    i += 1;
                }
            } else if (c == '(') or (c == '[') {
                depth += 1;
            } else if ((c == ')') or (c == ']')) and (depth > 0) {
                depth -= 1;
            } else if (depth == 0) and (c == ',') {
                break;
            } else if (depth == 0) and is_space(c) {
                // a space ends the word unless an operator joins it to the next
                let mut j = i;
                while (j < s.len) and is_space(s[j]) {
                    j += 1;
                }
                let prev = s[i - 1];
                let joins = (j < s.len) and (is_op_char(s[j]) or is_op_char(prev) or (s[j] == '='));
                if not joins {
                    break;
                }
            }
            if i < s.len {
                i += 1;
            }
        }
        out.push(trim(s[st..@min(i, s.len)]));
    }
    return out.items();
}

fn is_op_char(c: u8) bool {
    return (c == '+') or (c == '-') or (c == '*') or (c == '/') or (c == '|') or (c == '&') or (c == '^') or
           (c == '<') or (c == '>') or (c == '=') or (c == '%') or (c == '!');
}

// A macro argument without its quotes ("a b" is a b).
fn unquote_arg(s: []u8) []u8 {
    if (s.len >= 2) and (s[0] == '"') and (s[s.len - 1] == '"') {
        return s[1..s.len - 1];
    }
    return s;
}

// The macro mk invoked with args.
fn invoke(A: *mut Asm, mk: i32, args: []u8, depth: i32, conds: *mut u.List.[Cond]) void {
    let m = A.macros.get(@int_cast(usize, mk));
    let n = m.params.len;
    let vals = u.newn.[[]u8](n + 1);
    let set = u.newn.[bool](n + 1);
    for k in 0..n {
        vals[k] = m.defaults[k];
        set[k] = false;
    }
    let words = macro_words(args);
    let mut pos: usize = 0;
    let mut w: usize = 0;
    while w < words.len {
        let x = words[w];
        // a keyword argument: param=value
        let eq = u.find(x, '=');
        if (eq > 0) and (((@int_cast(usize, eq) + 1) >= x.len) or (x[@int_cast(usize, eq) + 1] != '=')) {
            let pn = trim(x[0..@int_cast(usize, eq)]);
            let mut found = false;
            for k in 0..n {
                if u.str_eq(m.params[k], pn) {
                    vals[k] = unquote_arg(trim(x[@int_cast(usize, eq) + 1..]));
                    set[k] = true;
                    found = true;
                }
            }
            if found {
                w += 1;
                continue;
            }
        }
        if m.vararg and (n > 0) and (pos == (n - 1)) {
            // the rest, as written
            let mut b = u.Buf.init();
            for j in w..words.len {
                if j > w {
                    b.s(", ");
                }
                b.s(words[j]);
            }
            vals[pos] = b.done();
            set[pos] = true;
            pos += 1;
            break;
        }
        if pos >= n {
            fail(A, u.f1("too many arguments for the macro '%s'", m.name));
            return;
        }
        vals[pos] = unquote_arg(x);
        set[pos] = true;
        pos += 1;
        w += 1;
    }
    for k in 0..n {
        if m.req[k] and not set[k] {
            fail(A, u.f2("the macro '%s' needs its argument '%s'", m.name, m.params[k]));
            return;
        }
    }
    let count = A.nmacro;
    A.nmacro += 1;
    let body = u.newn.[Raw](m.body.len + 1);
    for k in 0..m.body.len {
        body[k] = Raw.{ text: subst(m.body[k].text, m.params, vals[0..n], u.dec(count)), line: A.xline };
    }
    let line = A.xline;
    let mut exitm = false;
    let before = conds.len;
    expand_lines(A, body[0..m.body.len], depth + 1, conds, &mut exitm);
    if not failed(A) and (conds.len != before) and not exitm {
        A.xline = line;
        fail(A, u.f1("a .if of the macro '%s' without its .endif", m.name));
    }
    while conds.len > before {
        _ = conds.pop();
    }
    A.xline = line;
}

// Text s with \param replaced by its value, \@ by `count` and \() by
// nothing.
fn subst(s: []u8, params: [][]u8, vals: [][]u8, count: []u8) []u8 {
    if u.find(s, '\\') < 0 {
        return s;
    }
    let mut b = u.Buf.init();
    let mut i: usize = 0;
    while i < s.len {
        let c = s[i];
        if (c != '\\') or ((i + 1) >= s.len) {
            b.c(c);
            i += 1;
            continue;
        }
        let n = s[i + 1];
        if (i > 0) and (s[i - 1] == '\'') {
            // '\x is a character constant: the assembler language substitutes nothing in it
            b.c(c);
            i += 1;
            continue;
        }
        if n == '@' {
            b.s(count);
            i += 2;
            continue;
        }
        if (n == '(') and ((i + 2) < s.len) and (s[i + 2] == ')') {
            i += 3;
            continue;
        }
        let mut j = i + 1;
        while (j < s.len) and is_sym_char(s[j]) and (s[j] != '.') and (s[j] != '$') {
            j += 1;
        }
        let w = s[i + 1..j];
        let mut done = false;
        for k in 0..params.len {
            if (w.len > 0) and u.str_eq(params[k], w) {
                b.s(vals[k]);
                done = true;
                break;
            }
        }
        if done {
            i = j;
            continue;
        }
        b.c(c);
        i += 1;
    }
    return b.done();
}

// .rept n, .irp sym, values..., .irpc sym, chars: the body, repeated.
fn repeat(A: *mut Asm, p: Parts, body: []Raw, depth: i32, conds: *mut u.List.[Cond], exitm: *mut bool) void {
    if u.str_eq(p.op, ".rept") or u.str_eq(p.op, ".rep") {
        let n = eval_const(A, p.args, "the count of .rept");
        if failed(A) {
            return;
        }
        if (n < 0) or (n > 1000000) {
            fail(A, u.f1("a .rept count of %s", u.dec(n)));
            return;
        }
        for _k in @as(i64, 0)..n {
            expand_lines(A, body, depth + 1, conds, exitm);
            if failed(A) or exitm.* {
                return;
            }
        }
        return;
    }
    let a = trim(p.args);
    let mut k: usize = 0;
    while (k < a.len) and is_sym_char(a[k]) {
        k += 1;
    }
    let name = a[0..k];
    if name.len == 0 {
        fail(A, u.f1("%s needs a name", p.op));
        return;
    }
    let mut rest = trim(a[k..]);
    if (rest.len > 0) and (rest[0] == ',') {
        rest = trim(rest[1..]);
    }
    let one: [1][]u8 = [name];
    let mut vals = u.List.[[]u8].empty();
    if u.str_eq(p.op, ".irpc") {
        let t = unquote_arg(rest);
        for c in t {
            let cb = u.newn.[u8](1);
            cb[0] = c;
            vals.push(cb[0..1]);
        }
    } else {
        for w in macro_words(rest) {
            vals.push(unquote_arg(w));
        }
        if vals.len == 0 {
            vals.push("");
        }
    }
    for v in vals.items() {
        let vs: [1][]u8 = [v];
        let lines = u.newn.[Raw](body.len + 1);
        for j in 0..body.len {
            lines[j] = Raw.{ text: subst(body[j].text, one[..], vs[..], u.dec(A.nmacro)), line: body[j].line };
        }
        expand_lines(A, lines[0..body.len], depth + 1, conds, exitm);
        if failed(A) or exitm.* {
            return;
        }
    }
}

// The Def of label `name` defined at the statement being read (numeric:
// a new definition of it).
fn label_def(A: *mut Asm, name: []u8, line: i32) i32 {
    _ = line;
    if u.is_digit(name[0]) {
        let n = @int_cast(usize, u.atol(name));
        while A.numeric.len <= n {
            A.numeric.push(u.List.[i64].empty());
        }
        let d = new_def(A, u.f2("%s\x02%s", name, u.zdec(A.numeric.at(n).len)));
        A.defs.at(@int_cast(usize, d)).numeric = true;
        A.defs.at(@int_cast(usize, d)).intext = true;
        A.numeric.at(n).push((@int_cast(i64, A.stmts.len) << 32) | @as(i64, d));
        return d;
    }
    let d = sym(A, name);
    A.defs.at(@int_cast(usize, d)).intext = true;
    return d;
}

fn new_def(A: *mut Asm, name: []u8) i32 {
    A.defs.push(Def.{ name: name, sec: -1, off: 0, prev_sec: -1, prev_off: 0, defined: false, global: false,
                      weak: false, ty: elf.T_NOTYPE, size: 0, has_size: false, numeric: false, abs: false, tmp: false,
                      intext: false, set_si: 0 });
    return @int_cast(i32, A.defs.len - 1);
}

/// The Def of symbol `name` (made if new).
pub fn sym(A: *mut Asm, name: []u8) i32 {
    let k = u.intern(name);
    let found = A.names.get(k);
    if found != 0 {
        return found - 1;
    }
    let d = new_def(A, k);
    A.names.put(k, d + 1);
    return d;
}

/// The Def a numeric label reference (`1b`, `1f`) names, or -1.
fn numeric_ref(A: *mut Asm, n: usize, fwd: bool) i32 {
    if n >= A.numeric.len {
        return -1;
    }
    let ds = A.numeric.at(n);
    let mut best: i32 = -1;
    for x in ds.items() {
        let si = @int_cast(usize, x >> 32);
        let d = @truncate(i32, x & 0xffff_ffff);
        if fwd {
            if si > A.si {
                return d;
            }
        } else if si <= A.si {
            best = d;
        }
    }
    return best;
}

// -----------------------------------------------------------------------------
// Expressions
// -----------------------------------------------------------------------------
// Relocation modifiers: `sym@PLT`, `sym@GOTPCREL`, AArch64's `:lo12:sym` ...
pub const RM_NONE: u8 = 0;
pub const RM_PLT: u8 = 1;
pub const RM_GOTPCREL: u8 = 2;
pub const RM_LO12: u8 = 3;      // :lo12:
pub const RM_GOT: u8 = 4;       // :got:
pub const RM_GOT_LO12: u8 = 5;  // :got_lo12:
pub const RM_PG_HI21: u8 = 6;   // (adrp's page: no modifier written)
// the Mach-O spellings of AArch64's: sym@PAGE, @PAGEOFF, @GOTPAGE, @GOTPAGEOFF, @TLVPPAGE, @TLVPPAGEOFF
pub const RM_PAGE: u8 = 7;
pub const RM_PAGEOFF: u8 = 8;
pub const RM_GOTPAGE: u8 = 9;
pub const RM_GOTPAGEOFF: u8 = 10;
pub const RM_TLVPPAGE: u8 = 11;
pub const RM_TLVPPAGEOFF: u8 = 12;
pub const RM_TLVP: u8 = 13;  // x86-64's sym@TLVP (Mach-O): a thread-local's descriptor, rip-relative in a movq

/// An expression's value: k, plus a symbol's address (sym: a Def index, or
/// -1), minus another's (neg, same section: then a constant once both are
/// placed).
pub struct Val {
    ok: bool,
    k: i64,
    sym: i32,
    neg: i32,
    rm: u8,
}

pub fn konst(k: i64) Val {
    return Val.{ ok: true, k: k, sym: -1, neg: -1, rm: RM_NONE };
}

fn bad_val() Val {
    return Val.{ ok: false, k: 0, sym: -1, neg: -1, rm: RM_NONE };
}

/// Is v a plain constant (no symbol)?
pub fn is_const(v: Val) bool {
    return v.ok and (v.sym < 0) and (v.neg < 0);
}

struct Ex {
    A: *mut Asm,
    s: []u8,
    i: usize,
}

fn ex_space(E: *mut Ex) void {
    while (E.i < E.s.len) and is_space(E.s[E.i]) {
        E.i += 1;
    }
}

fn ex_peek(E: *mut Ex) u8 {
    ex_space(E);
    if E.i < E.s.len {
        return E.s[E.i];
    }
    return 0;
}

/// The value of expression s (all of it), or an error.
pub fn eval(A: *mut Asm, s: []u8) Val {
    let mut E = Ex.{ A: A, s: s, i: 0 };
    let v = ex_or(&mut E);
    ex_space(&mut E);
    if v.ok and (E.i < s.len) {
        fail(A, u.f1("unexpected '%s' in an expression", s[E.i..]));
        return bad_val();
    }
    return v;
}

/// The value of s, which must be a constant (what as `what`).
pub fn eval_const(A: *mut Asm, s: []u8, what: []u8) i64 {
    let v = eval(A, s);
    if not v.ok {
        return 0;
    }
    let c = settle(A, v);
    if not is_const(c) {
        fail(A, u.f2("%s must be a constant: '%s'", what, s));
        return 0;
    }
    return c.k;
}

// A difference of two labels of one section, once placed: a constant.
pub fn settle(A: *mut Asm, v: Val) Val {
    if not v.ok or (v.neg < 0) {
        return v;
    }
    if v.sym < 0 {
        return v;
    }
    let a = A.defs.get(@int_cast(usize, v.sym));
    let b = A.defs.get(@int_cast(usize, v.neg));
    let asec = def_sec(A, a);
    let bsec = def_sec(A, b);
    if (asec >= 0) and (asec == bsec) {
        return konst(v.k + (@bit_cast(i64, def_off(A, a)) - @bit_cast(i64, def_off(A, b))));
    }
    return v;
}

/// The section label d is in (this pass's place, else the previous one's).
pub fn def_sec(A: *Asm, d: Def) i32 {
    _ = A;
    if d.defined {
        return d.sec;
    }
    return d.prev_sec;
}

pub fn def_off(A: *Asm, d: Def) u64 {
    _ = A;
    if d.defined {
        return d.off;
    }
    return d.prev_off;
}

// The conventional precedence, lowest first: || and && (results 1 or
// 0; && binds tighter), the comparisons (== != <> < <= > >=: -1 if true),
// + and -, the bitwise | & ^ and ! (or not), and * / % << >>.
fn next_ch(E: *Ex) u8 {
    if (E.i + 1) < E.s.len {
        return E.s[E.i + 1];
    }
    return 0;
}

fn bit(c: bool) i64 {
    if c {
        return 1;
    }
    return 0;
}

fn ex_or(E: *mut Ex) Val {
    let mut a = ex_land(E);
    while a.ok and (ex_peek(E) == '|') and ((E.i + 1) < E.s.len) and (E.s[E.i + 1] == '|') {
        E.i += 2;
        let b = ex_land(E);
        a = arith(E.A, a, b, 'O');
    }
    return a;
}

fn ex_land(E: *mut Ex) Val {
    let mut a = ex_cmp(E);
    while a.ok and (ex_peek(E) == '&') and ((E.i + 1) < E.s.len) and (E.s[E.i + 1] == '&') {
        E.i += 2;
        let b = ex_cmp(E);
        a = arith(E.A, a, b, 'A');
    }
    return a;
}

fn ex_cmp(E: *mut Ex) Val {
    let mut a = ex_add(E);
    loop {
        let c = ex_peek(E);
        let n = next_ch(E);
        let mut op: u8 = 0;
        let mut len: usize = 2;
        if (c == '=') and (n == '=') {
            op = 'e';
        } else if (c == '!') and (n == '=') {
            op = 'n';
        } else if (c == '<') and (n == '>') {
            op = 'n';
        } else if (c == '<') and (n == '=') {
            op = 'l';
        } else if (c == '>') and (n == '=') {
            op = 'g';
        } else if (c == '<') and (n != '<') {
            op = '<';
            len = 1;
        } else if (c == '>') and (n != '>') {
            op = '>';
            len = 1;
        } else if (c == '=') {
            op = 'e';  // (a single '=' compares too)
            len = 1;
        }
        if (op == 0) or not a.ok {
            break;
        }
        E.i += len;
        let b = ex_add(E);
        a = compare(E.A, a, b, op);
    }
    return a;
}

// a op b of the comparisons: -1 if true, else 0 (also of two addresses in
// one section, once placed).
fn compare(A: *mut Asm, a0: Val, b0: Val, op: u8) Val {
    if not a0.ok or not b0.ok {
        return bad_val();
    }
    let mut a = settle(A, a0);
    let mut b = settle(A, b0);
    if (a.sym >= 0) and (b.sym >= 0) and (a.neg < 0) and (b.neg < 0) {
        // two addresses: their difference
        let d = settle(A, Val.{ ok: true, k: a.k - b.k, sym: a.sym, neg: b.sym, rm: RM_NONE });
        a = d;
        b = konst(0);
    }
    if not is_const(a) or not is_const(b) {
        fail(A, "a comparison of a symbol's address with a constant");
        return bad_val();
    }
    let x = a.k;
    let y = b.k;
    let mut t = false;
    if op == 'e' {
        t = x == y;
    } else if op == 'n' {
        t = x != y;
    } else if op == '<' {
        t = x < y;
    } else if op == '>' {
        t = x > y;
    } else if op == 'l' {
        t = x <= y;
    } else {
        t = x >= y;
    }
    if t {
        return konst(-1);
    }
    return konst(0);
}

fn ex_add(E: *mut Ex) Val {
    let mut a = ex_bit(E);
    loop {
        let c = ex_peek(E);
        if not a.ok or ((c != '+') and (c != '-')) {
            break;
        }
        E.i += 1;
        let b = ex_bit(E);
        if not b.ok {
            return b;
        }
        a = add_vals(E.A, a, b, c == '-');
        if not a.ok {
            return a;
        }
    }
    return a;
}

// a + b or a - b of values with symbols: a symbol plus a constant, a
// difference of two symbols (plus a constant).
fn add_vals(A: *mut Asm, a0: Val, b: Val, minus: bool) Val {
    let mut a = a0;
    if not minus {
        if (a.sym >= 0) and (b.sym >= 0) {
            fail(A, "an expression adds two symbols");
            return bad_val();
        }
        if b.sym >= 0 {
            a.sym = b.sym;
            a.rm = b.rm;
        }
        if b.neg >= 0 {
            if a.neg >= 0 {
                fail(A, "an expression subtracts two symbols");
                return bad_val();
            }
            a.neg = b.neg;
        }
        a.k = a.k +% b.k;
        return settle(A, a);
    }
    if b.neg >= 0 {
        // a - (x - y) = a + y - x
        if (a.sym >= 0) or (a.neg >= 0) {
            fail(A, "an expression subtracts a difference of symbols");
            return bad_val();
        }
        a.sym = b.neg;
        a.neg = b.sym;
        a.k = a.k -% b.k;
        return settle(A, a);
    }
    if b.sym >= 0 {
        if a.neg >= 0 {
            fail(A, "an expression subtracts two symbols");
            return bad_val();
        }
        if a.sym < 0 {
            fail(A, "the negation of a symbol's address");
            return bad_val();
        }
        a.neg = b.sym;
    }
    a.k = a.k -% b.k;
    return settle(A, a);
}

fn ex_bit(E: *mut Ex) Val {
    let mut a = ex_mul(E);
    loop {
        let c = ex_peek(E);
        let n = next_ch(E);
        let mut op: u8 = 0;
        if (c == '|') and (n != '|') {
            op = '|';
        } else if (c == '&') and (n != '&') {
            op = '&';
        } else if c == '^' {
            op = '^';
        } else if (c == '!') and (n != '=') {
            op = '!';
        }
        if (op == 0) or not a.ok {
            break;
        }
        E.i += 1;
        let b = ex_mul(E);
        a = arith(E.A, a, b, op);
    }
    return a;
}

fn ex_mul(E: *mut Ex) Val {
    let mut a = ex_unary(E);
    loop {
        let c = ex_peek(E);
        let mut op: u8 = 0;
        if (c == '*') or (c == '/') or (c == '%') {
            op = c;
            E.i += 1;
        } else if ((c == '<') or (c == '>')) and ((E.i + 1) < E.s.len) and (E.s[E.i + 1] == c) {
            op = c;
            E.i += 2;
        } else {
            break;
        }
        if not a.ok {
            break;
        }
        let b = ex_unary(E);
        a = arith(E.A, a, b, op);
    }
    return a;
}

// a op b, both constants (after settling label differences).
fn arith(A: *mut Asm, a0: Val, b0: Val, op: u8) Val {
    if not a0.ok or not b0.ok {
        return bad_val();
    }
    let a = settle(A, a0);
    let b = settle(A, b0);
    // (an address times or divided by 1 is itself, as the conventional
    // assembler takes it: `[rax + sym*1]`)
    if ((op == '*') or (op == '/')) and is_const(b) and (b.k == 1) {
        return a;
    }
    if (op == '*') and is_const(a) and (a.k == 1) {
        return b;
    }
    if not is_const(a) or not is_const(b) {
        fail(A, u.f1("'%s' of a symbol's address (only + and - are)", ch1(op)));
        return bad_val();
    }
    let x = a.k;
    let y = b.k;
    if op == '|' {
        return konst(x | y);
    }
    if op == '!' {
        return konst(x | ~y);
    }
    if op == 'O' {
        return konst(bit((x != 0) or (y != 0)));
    }
    if op == 'A' {
        return konst(bit((x != 0) and (y != 0)));
    }
    if op == '^' {
        return konst(x ^ y);
    }
    if op == '&' {
        return konst(x & y);
    }
    if op == '*' {
        return konst(x *% y);
    }
    if (op == '/') or (op == '%') {
        if y == 0 {
            fail(A, "a division by zero in an expression");
            return bad_val();
        }
        if op == '/' {
            return konst(x / y);
        }
        return konst(x % y);
    }
    let sh = @truncate(u32, @bit_cast(u64, y) & 63);
    if op == '<' {
        return konst(@bit_cast(i64, @bit_cast(u64, x) << sh));
    }
    return konst(x >> sh);
}

fn ch1(c: u8) []u8 {
    let b = u.newn.[u8](1);
    b[0] = c;
    return b[0..1];
}

fn ex_unary(E: *mut Ex) Val {
    let c = ex_peek(E);
    if c == '-' {
        E.i += 1;
        let v = ex_unary(E);
        if not v.ok {
            return v;
        }
        let s = settle(E.A, v);
        if not is_const(s) {
            fail(E.A, "the negation of a symbol's address");
            return bad_val();
        }
        return konst(0 -% s.k);
    }
    if c == '+' {
        E.i += 1;
        return ex_unary(E);
    }
    if (c == '~') or (c == '!') {
        E.i += 1;
        let v = ex_unary(E);
        if not v.ok {
            return v;
        }
        let s = settle(E.A, v);
        if not is_const(s) {
            fail(E.A, "'~' of a symbol's address");
            return bad_val();
        }
        if c == '!' {
            if s.k == 0 {
                return konst(1);
            }
            return konst(0);
        }
        return konst(~s.k);
    }
    return ex_primary(E);
}

fn ex_primary(E: *mut Ex) Val {
    let c = ex_peek(E);
    let s = E.s;
    if c == '(' {
        E.i += 1;
        let v = ex_or(E);
        if ex_peek(E) != ')' {
            fail(E.A, "a ')' missing in an expression");
            return bad_val();
        }
        E.i += 1;
        return v;
    }
    if c == '\'' {
        // a character
        E.i += 1;
        if E.i >= s.len {
            fail(E.A, "a character constant at the end");
            return bad_val();
        }
        let mut ch = @as(i64, s[E.i]);
        if (s[E.i] == '\\') and ((E.i + 1) < s.len) {
            E.i += 1;
            // (in a character constant \v and \0 are those letters)
            ch = @as(i64, s[E.i]);
            if (s[E.i] != 'v') and (s[E.i] != '0') {
                ch = @as(i64, escape(s[E.i]));
            }
        }
        E.i += 1;
        if (E.i < s.len) and (s[E.i] == '\'') {
            E.i += 1;
        }
        return konst(ch);
    }
    if u.is_digit(c) {
        let st = E.i;
        while (E.i < s.len) and (is_sym_char(s[E.i])) {
            E.i += 1;
        }
        let t = s[st..E.i];
        // a numeric label reference: 1b, 1f
        if (t.len >= 2) and ((t[t.len - 1] == 'b') or (t[t.len - 1] == 'f')) and all_digits(t[0..t.len - 1]) {
            let fwd = t[t.len - 1] == 'f';
            let d = numeric_ref(E.A, @int_cast(usize, u.atol(t[0..t.len - 1])), fwd);
            if d < 0 {
                fail(E.A, u.f1("the local label '%s' is not defined", t));
                return bad_val();
            }
            return Val.{ ok: true, k: 0, sym: d, neg: -1, rm: RM_NONE };
        }
        let mut ok = true;
        let n = number(t, &mut ok);
        if not ok {
            fail(E.A, u.f1("'%s' is not a number", t));
            return bad_val();
        }
        return konst(n);
    }
    if is_sym_start(c) or (c == '"') {
        let st = E.i;
        let mut name = "";
        if c == '"' {
            E.i += 1;
            let ns = E.i;
            while (E.i < s.len) and (s[E.i] != '"') {
                E.i += 1;
            }
            name = s[ns..E.i];
            if E.i < s.len {
                E.i += 1;
            }
        } else {
            while (E.i < s.len) and is_sym_char(s[E.i]) {
                E.i += 1;
            }
            name = s[st..E.i];
        }
        if u.str_eq(name, ".") {
            // the current place
            let d = here_def(E.A);
            return Val.{ ok: true, k: 0, sym: d, neg: -1, rm: RM_NONE };
        }
        let mut rm = RM_NONE;
        if (E.i < s.len) and (s[E.i] == '@') {
            let ms = E.i + 1;
            E.i += 1;
            while (E.i < s.len) and is_sym_char(s[E.i]) {
                E.i += 1;
            }
            let m = lower(s[ms..E.i]);
            if u.str_eq(m, "plt") {
                rm = RM_PLT;
            } else if u.str_eq(m, "gotpcrel") {
                rm = RM_GOTPCREL;
            } else if (E.A.arch == tg.ARCH_X64) and u.str_eq(m, "tlvp") {
                rm = RM_TLVP;
            } else if (E.A.arch == tg.ARCH_A64) and
                      (u.str_eq(m, "page") or u.str_eq(m, "pageoff") or u.str_eq(m, "gotpage") or
                       u.str_eq(m, "gotpageoff") or u.str_eq(m, "tlvppage") or u.str_eq(m, "tlvppageoff")) {
                let ms2 = ["page", "pageoff", "gotpage", "gotpageoff", "tlvppage", "tlvppageoff"];
                for j in 0..ms2.len {
                    if u.str_eq(m, ms2[j]) {
                        rm = RM_PAGE + @truncate(u8, j);
                    }
                }
            } else {
                fail(E.A, u.f1("the relocation '@%s' is not supported", s[ms..E.i]));
                return bad_val();
            }
        }
        let d = sym(E.A, name);
        let df = E.A.defs.get(@int_cast(usize, d));
        if df.abs {
            return konst(@bit_cast(i64, df.off));
        }
        return Val.{ ok: true, k: 0, sym: d, neg: -1, rm: rm };
    }
    if c == 0 {
        fail(E.A, "an expression is missing");
    } else {
        fail(E.A, u.f1("unexpected '%s' in an expression", s[E.i..]));
    }
    return bad_val();
}

fn all_digits(s: []u8) bool {
    if s.len == 0 {
        return false;
    }
    for c in s {
        if not u.is_digit(c) {
            return false;
        }
    }
    return true;
}

pub fn escape(c: u8) u8 {
    if c == 'n' {
        return 10;
    }
    if c == 't' {
        return 9;
    }
    if c == 'r' {
        return 13;
    }
    if c == '0' {
        return 0;
    }
    if c == 'b' {
        return 8;
    }
    if c == 'f' {
        return 12;
    }
    if c == 'v' {
        return 11;
    }
    return c;  // (in the assembler language \a and the others are the letter itself)
}

fn digit_val(c: u8) i64 {
    if u.is_digit(c) {
        return @as(i64, c - '0');
    }
    if (c >= 'a') and (c <= 'f') {
        return @as(i64, c - 'a') + 10;
    }
    if (c >= 'A') and (c <= 'F') {
        return @as(i64, c - 'A') + 10;
    }
    return 99;
}

/// An integer in the assembler's notation: decimal, 0x hexadecimal, 0b
/// binary, 0 octal.
pub fn number(t: []u8, ok: *mut bool) i64 {
    let mut base: i64 = 10;
    let mut i: usize = 0;
    if (t.len > 2) and (t[0] == '0') and ((t[1] == 'x') or (t[1] == 'X')) {
        base = 16;
        i = 2;
    } else if (t.len > 2) and (t[0] == '0') and ((t[1] == 'b') or (t[1] == 'B')) {
        base = 2;
        i = 2;
    } else if (t.len > 1) and (t[0] == '0') {
        base = 8;
        i = 1;
    }
    let mut v: u64 = 0;
    if i >= t.len {
        ok.* = t.len > 0;
        return 0;
    }
    while i < t.len {
        let d = digit_val(t[i]);
        if d >= base {
            ok.* = false;
            return 0;
        }
        v = (v *% @bit_cast(u64, base)) +% @bit_cast(u64, d);
        i += 1;
    }
    return @bit_cast(i64, v);
}

// A Def for the current place (`.`): a label made for it.
fn here_def(A: *mut Asm) i32 {
    let d = new_def(A, u.f1(".\x02here%s", u.zdec(A.defs.len)));
    let p = A.defs.at(@int_cast(usize, d));
    p.sec = A.cur;
    p.off = here(A);
    p.defined = true;
    p.tmp = true;
    return d;
}

// -----------------------------------------------------------------------------
// Operand lists
// -----------------------------------------------------------------------------
/// The operands of s, split at the commas outside parentheses, brackets,
/// braces and strings.
pub fn split_args(s: []u8) [][]u8 {
    let mut out = u.List.[[]u8].empty();
    if trim(s).len == 0 {
        return out.items();
    }
    let mut depth: i32 = 0;
    let mut st: usize = 0;
    let mut i: usize = 0;
    let mut in_str = false;
    while i < s.len {
        let c = s[i];
        if in_str {
            if (c == '\\') and ((i + 1) < s.len) {
                i += 1;
            } else if c == '"' {
                in_str = false;
            }
        } else if c == '"' {
            in_str = true;
        } else if (c == '(') or (c == '[') or (c == '{') {
            depth += 1;
        } else if (c == ')') or (c == ']') or (c == '}') {
            depth -= 1;
        } else if (c == ',') and (depth == 0) {
            out.push(trim(s[st..i]));
            st = i + 1;
        }
        i += 1;
    }
    out.push(trim(s[st..]));
    return out.items();
}

// -----------------------------------------------------------------------------
// Sections and bytes
// -----------------------------------------------------------------------------
/// The section named `name` (made, of kind `kind`, if new).
pub fn section(A: *mut Asm, name: []u8, kind: i32) i32 {
    for k in 0..A.secs.len {
        if u.str_eq(A.secs.get(k).name, name) {
            return @int_cast(i32, k);
        }
    }
    A.secs.push(Sec.{ name: u.dup(name), kind: kind, data: u.List.[u8].empty(), size: 0, align: 1 });
    return @int_cast(i32, A.secs.len - 1);
}

/// Where the next byte goes in the current section.
pub fn here(A: *Asm) u64 {
    let s = A.secs.at(@int_cast(usize, A.cur));
    if s.kind == elf.S_BSS {
        return s.size;
    }
    return @as(u64, s.data.len);
}

pub fn emit8(A: *mut Asm, x: u64) void {
    let s = A.secs.at(@int_cast(usize, A.cur));
    if (s.kind == elf.S_BSS) or (s.kind == elf.S_TBSS) {
        if (x & 0xff) != 0 {
            fail(A, "data in a section of zeros (bss)");
        }
        s.size += 1;
        return;
    }
    s.data.push(@truncate(u8, x));
}

pub fn emit16(A: *mut Asm, x: u64) void {
    emit8(A, x);
    emit8(A, x >> 8);
}

pub fn emit32(A: *mut Asm, x: u64) void {
    emit16(A, x);
    emit16(A, x >> 16);
}

pub fn emit64(A: *mut Asm, x: u64) void {
    emit32(A, x);
    emit32(A, x >> 32);
}

/// Overwrites the 4 bytes at off of the current section.
pub fn patch32(A: *mut Asm, off: u64, x: u64) void {
    let s = A.secs.at(@int_cast(usize, A.cur));
    for k in @as(u64, 0)..4 {
        s.data.set(@truncate(usize, off + k), @truncate(u8, x >> @truncate(u32, k * 8)));
    }
}

/// A relocation of type ty at off in the current section for v's symbol.
pub fn reloc(A: *mut Asm, off: u64, ty: u32, v: Val, addend: i64) void {
    let d = A.defs.get(@int_cast(usize, v.sym));
    A.relocs.push(Reloc.{ sec: A.cur, off: off, ty: ty, name: d.name, addend: addend });
}

/// Is v's symbol a label of this text in the current section (so a
/// pc-relative reference to it needs no relocation)? Its offset in `off`
/// (before the label is first placed: here).
pub fn local_target(A: *Asm, v: Val, off: *mut u64) bool {
    if v.sym < 0 {
        return false;
    }
    let d = A.defs.get(@int_cast(usize, v.sym));
    if not d.intext and not d.tmp {
        return false;
    }
    if d.global and not A.inline_ {
        return false;  // (another unit's definition may take its place, as with the system's assemblers)
    }
    let s = def_sec(A, d);
    if s < 0 {
        off.* = here(A);
        return true;  // (not placed yet: the first pass)
    }
    if s != A.cur {
        return false;
    }
    off.* = def_off(A, d);
    return true;
}

// -----------------------------------------------------------------------------
// The passes
// -----------------------------------------------------------------------------
/// The functions an architecture gives the passes: its instruction encoder
/// and its own directives (false: not one of them).
pub struct Arch {
    insn: fn(*mut Asm, *mut Stmt) void,
    directive: fn(*mut Asm, *mut Stmt) bool,
    nop: u8,                    // the byte that pads code (x86-64 0x90), or 0: words (AArch64's nop)
    align_pow2: bool,           // .align n is 2^n (AArch64), else n bytes (x86-64)
    word: u32,                  // .word's size: 2 (x86-64) or 4 (AArch64)
    finish: fn(*mut Asm) void,  // after each pass's statements (AArch64: the literal pools)
}

/// Assembles A's text: passes until no label moves (at most 12).
pub fn run(A: *mut Asm, arch: *Arch) void {
    split(A);
    expand(A);
    if failed(A) {
        return;
    }
    stack_use(A);
    let mut pass: i32 = 0;
    while pass < 12 {
        A.pass = pass;
        A.changed = false;
        one_pass(A, arch);
        if failed(A) {
            return;
        }
        // labels: placed where the previous pass put them?
        let mut moved = false;
        for k in 0..A.defs.len {
            let d = A.defs.at(k);
            if ((d.sec != d.prev_sec) or (d.off != d.prev_off)) and not d.tmp {
                moved = true;
            }
            d.prev_sec = d.sec;
            d.prev_off = d.off;
            if d.defined {
                d.defined = false;
            }
        }
        if not moved and not A.changed and (pass > 0) {
            // the last pass's labels are final: mark them defined again
            for k in 0..A.defs.len {
                let d = A.defs.at(k);
                d.defined = d.sec >= 0;
            }
            cfi_finish(A);
            return;
        }
        pass += 1;
    }
    fail(A, "the assembly's labels do not settle (instructions that change size forever)");
}

fn one_pass(A: *mut Asm, arch: *Arch) void {
    A.secs.clear();
    A.relocs.clear();
    A.stack.clear();
    if A.inline_ {
        A.cur = section(A, ".text", elf.S_TEXT);
    } else {
        A.cur = section(A, ".text", elf.S_TEXT);
    }
    A.prev = A.cur;
    A.intel = A.intel0;
    A.procs.clear();
    A.lits.clear();
    A.icfi.clear();
    A.sehs.clear();
    A.in_seh = false;
    A.in_proc = false;
    A.cfi_off = 0;
    for k in 0..A.defs.len {
        let d = A.defs.at(k);
        d.defined = false;
        if not d.abs {
            d.sec = -1;
            d.off = 0;
        }
    }
    A.loc_file = "";
    A.loc_line = 0;
    for i in 0..A.stmts.len {
        A.si = i;
        let st = A.stmts.at(i);
        st.sec = A.cur;
        st.at = here(A);
        st.lfile = A.loc_file;
        st.lline = A.loc_line;
        for l in st.labels {
            let d = A.defs.at(@int_cast(usize, l));
            if d.defined or d.abs {
                fail(A, u.f1("the label '%s' is defined twice", d.name));
                return;
            }
            d.defined = true;
            d.sec = A.cur;
            d.off = here(A);
        }
        if st.op.len == 0 {
            continue;
        }
        if st.op[0] == '.' {
            if not arch.directive(A, st) {
                directive(A, st, arch);
            }
        } else {
            arch.insn(A, st);
        }
        if failed(A) {
            return;
        }
    }
    arch.finish(A);
}

/// Emits data of n bytes (1, 2, 4, 8) for each comma-separated value of args, as
/// `.byte` ... `.quad` do (an address is a relocation).
pub fn data_values(A: *mut Asm, args: []u8, n: u32) void {
    data(A, args, n);
}

/// Makes the Def d a label here (a label the arch places itself).
pub fn place_label(A: *mut Asm, d: i32) void {
    let p = A.defs.at(@int_cast(usize, d));
    p.sec = A.cur;
    p.off = here(A);
    p.defined = true;
    p.intext = true;
}

// What the text's instructions do with the stack (A.uses_sp, A.calls):
// x86-64 push, pop, call, enter, leave, ret and the stack pointer (rsp, esp,
// sp, spl) as an operand; AArch64 bl, blr and its kin, and sp or wsp as an
// operand. (The backends give a function whose asm uses the stack a frame,
// and make no sibling calls from one whose asm does: docs/c.md.)
fn stack_use(A: *mut Asm) void {
    let a64 = A.arch == tg.ARCH_A64;
    for st in A.stmts.items() {
        let op = st.op;
        if (op.len == 0) or (op[0] == '.') {
            continue;
        }
        if a64 {
            if u.str_eq(op, "bl") or u.starts(op, "blr") {
                A.calls = true;
                A.uses_sp = true;
            }
        } else {
            // (after prefixes: the instruction's own mnemonic)
            let mut m = op;
            let mut rest = st.args;
            while u.str_eq(m, "lock") or u.starts(m, "rep") or u.starts(m, "{") or u.str_eq(m, "notrack") or
                  u.str_eq(m, "bnd") {
                let t = trim(rest);
                let mut k: usize = 0;
                while (k < t.len) and not is_space(t[k]) {
                    k += 1;
                }
                m = lower(t[0..k]);
                rest = t[k..];
            }
            if u.starts(m, "call") {
                A.calls = true;
            }
            if u.starts(m, "push") or u.starts(m, "pop") or u.starts(m, "call") or u.starts(m, "enter") or
               u.starts(m, "leave") or u.starts(m, "ret") or u.starts(m, "iret") {
                A.uses_sp = true;
            }
        }
        // the stack pointer named
        let s = lower(st.args);
        let mut i: usize = 0;
        while i < s.len {
            if is_sym_start(s[i]) and ((i == 0) or not is_sym_char(s[i - 1])) {
                let b0 = i;
                while (i < s.len) and is_sym_char(s[i]) {
                    i += 1;
                }
                let w = s[b0..i];
                if (a64 and (u.str_eq(w, "sp") or u.str_eq(w, "wsp"))) or
                   (not a64 and (u.str_eq(w, "rsp") or u.str_eq(w, "esp") or u.str_eq(w, "sp") or u.str_eq(w, "spl"))) {
                    A.uses_sp = true;
                }
                continue;
            }
            i += 1;
        }
    }
}

// The multi-byte NOP sequences the conventional assembler pads x86-64 code with (one
// NOP of up to 11 bytes, longer runs as 11-byte NOPs then a shorter one), so
// that .p2align and .balign in a text section give the same bytes.
fn x86_nop_pad(A: *mut Asm, pad: u64) void {
    // NOP encodings of lengths 1..11, as the conventional assembler's table has them
    let nops = ["90", "6690", "0f1f00", "0f1f4000", "0f1f440000", "660f1f440000", "0f1f8000000000", "0f1f840000000000",
                "660f1f840000000000", "662e0f1f840000000000", "66662e0f1f840000000000"];
    if pad == 0 {
        return;
    }
    // (the assembler emits a single leading 0x90, then NOPs of up to 11 bytes)
    emit_nop(A, nops, 1);
    let mut left = pad - 1;
    while left > 0 {
        let mut n = left;
        if n > 11 {
            n = 11;
        }
        emit_nop(A, nops, @int_cast(usize, n));
        left -= n;
    }
}

fn emit_nop(A: *mut Asm, nops: [11][]u8, n: usize) void {
    let h = nops[n - 1];
    let mut i: usize = 0;
    while i < h.len {
        emit8(A, @bit_cast(u64, (hexd(h[i]) * 16) + hexd(h[i + 1])));
        i += 2;
    }
}

fn hexd(c: u8) i64 {
    if is_digit_core(c) {
        return @as(i64, c - '0');
    }
    return @as(i64, c - 'a') + 10;
}

fn is_digit_core(c: u8) bool {
    return (c >= '0') and (c <= '9');
}

// The alignment padding to a multiple of n (a power of two).
fn align_to(A: *mut Asm, n: u64, fill: i64, has_fill: bool, arch: *Arch, max: u64) void {
    if (n == 0) or ((n & (n - 1)) != 0) {
        fail(A, u.f1("an alignment of %s, which is not a power of two", u.udec(n)));
        return;
    }
    let s = A.secs.at(@int_cast(usize, A.cur));
    if n > s.align {
        s.align = n;
    }
    let mut at = here(A);
    if A.inline_ {
        at += A.origin;
    }
    let pad = (n - (at % n)) % n;
    if (max != 0) and (pad > max) {
        return;
    }
    if (s.kind == elf.S_TEXT) and not has_fill {
        if arch.nop != 0 {
            x86_nop_pad(A, pad);
        } else {
            let mut p = pad;
            while (p % 4) != 0 {
                emit8(A, 0);
                p -= 1;
            }
            while p > 0 {
                emit32(A, 0xd503201f);  // nop
                p -= 4;
            }
        }
        return;
    }
    for _k in @as(u64, 0)..pad {
        emit8(A, @bit_cast(u64, fill));
    }
}

// Data of n bytes from each operand (a constant, or a symbol's address).
fn data(A: *mut Asm, args: []u8, n: u32) void {
    for a in split_args(args) {
        let v = settle(A, eval(A, a));
        if not v.ok {
            return;
        }
        if is_const(v) {
            let x = @bit_cast(u64, v.k);
            if n == 1 {
                emit8(A, x);
            } else if n == 2 {
                emit16(A, x);
            } else if n == 4 {
                emit32(A, x);
            } else {
                emit64(A, x);
            }
            continue;
        }
        if v.neg >= 0 {
            // sym - label: pc-relative when label is here's section
            let d = A.defs.get(@int_cast(usize, v.neg));
            if def_sec(A, d) == A.cur {
                let off = here(A);
                let ty = pcrel_type(A, n);
                if ty == 0 {
                    fail(A, "a difference of symbols in data of this size");
                    return;
                }
                let delta = @bit_cast(i64, off) - @bit_cast(i64, def_off(A, d));
                reloc(A, off, ty, v, v.k + delta);
                emit_zero(A, n);
                continue;
            }
            if (A.pass == 0) and
               ((def_sec(A, d) < 0) or ((v.sym >= 0) and (def_sec(A, A.defs.get(@int_cast(usize, v.sym))) < 0))) {
                // (a label defined further on: the next pass knows where)
                emit_zero(A, n);
                continue;
            }
            fail(A, "a difference of symbols of different sections");
            return;
        }
        let ty = abs_type(A, n);
        if ty == 0 {
            fail(A, u.f1("an address in %s-byte data", u.udec(@as(u64, n))));
            return;
        }
        reloc(A, here(A), ty, v, v.k);
        emit_zero(A, n);
    }
}

fn emit_zero(A: *mut Asm, n: u32) void {
    for _k in @as(u32, 0)..n {
        emit8(A, 0);
    }
}

fn abs_type(A: *Asm, n: u32) u32 {
    if A.arch == tg.ARCH_X64 {
        if n == 8 {
            return elf.R_X86_64_64;
        }
        if n == 4 {
            return elf.R_X86_64_32;
        }
        return 0;
    }
    if n == 8 {
        return elf.R_AARCH64_ABS64;
    }
    if n == 4 {
        return elf.R_AARCH64_ABS32;
    }
    return 0;
}

fn pcrel_type(A: *Asm, n: u32) u32 {
    if n != 4 {
        return 0;
    }
    if A.arch == tg.ARCH_X64 {
        return elf.R_X86_64_PC32;
    }
    return elf.R_AARCH64_PREL32;
}

// A string literal's bytes (in the conventional assembler's escapes).
pub fn string(A: *mut Asm, s0: []u8) []u8 {
    let s = trim(s0);
    if (s.len < 2) or (s[0] != '"') or (s[s.len - 1] != '"') {
        fail(A, u.f1("'%s' is not a string", s));
        return "";
    }
    let mut b = u.Buf.init();
    let mut i: usize = 1;
    while i < (s.len - 1) {
        let c = s[i];
        if (c == '\\') and ((i + 1) < (s.len - 1)) {
            i += 1;
            let e = s[i];
            if (e >= '0') and (e <= '7') {
                let mut v: u32 = 0;
                let mut n: i32 = 0;
                while (n < 3) and (i < (s.len - 1)) and (s[i] >= '0') and (s[i] <= '7') {
                    v = (v * 8) + @as(u32, s[i] - '0');
                    i += 1;
                    n += 1;
                }
                b.c(@truncate(u8, v));
                continue;
            }
            if e == 'x' {
                i += 1;
                let mut v: u32 = 0;
                while (i < (s.len - 1)) and (digit_val(s[i]) < 16) {
                    v = (v * 16) + @truncate(u32, @bit_cast(u64, digit_val(s[i])));
                    i += 1;
                }
                b.c(@truncate(u8, v));
                continue;
            }
            b.c(escape(e));
            i += 1;
            continue;
        }
        b.c(c);
        i += 1;
    }
    return b.done();
}

fn kind_of_section(name: []u8, flags0: []u8, ty: []u8) i32 {
    let flags = flags0;
    if u.contains(ty, "note") or u.starts(name, ".debug") or u.starts(name, ".comment") or
       (not u.contains(flags, "a") and (flags.len > 2) and not u.contains(flags, "x") and not u.contains(flags, "w")) {
        if not u.starts(name, ".text") and not u.starts(name, ".data") and not u.starts(name, ".rodata") and
           not u.starts(name, ".bss") and not u.starts(name, ".init_array") and not u.starts(name, ".fini_array") {
            return elf.S_DEBUG;  // (not loaded: notes, debug information, comments)
        }
    }
    if u.contains(ty, "init_array") or u.contains(ty, "fini_array") or u.contains(ty, "preinit_array") {
        return elf.S_DATA;
    }
    if u.starts(name, ".text") {
        return elf.S_TEXT;
    }
    if u.starts(name, ".bss") or u.contains(ty, "nobits") {
        if u.contains(flags, "T") or u.starts(name, ".tbss") {
            return elf.S_TBSS;
        }
        return elf.S_BSS;
    }
    if u.starts(name, ".tbss") {
        return elf.S_TBSS;
    }
    if u.starts(name, ".tdata") or u.contains(flags, "T") {
        return elf.S_TDATA;
    }
    if u.starts(name, ".rodata") {
        return elf.S_RODATA;
    }
    if u.starts(name, ".data") {
        return elf.S_DATA;
    }
    if u.contains(flags, "x") {
        return elf.S_TEXT;
    }
    if u.contains(flags, "w") {
        return elf.S_DATA;
    }
    return elf.S_RODATA;
}

// The bits of a .float (or .double: dbl) operand: a decimal number
// (correctly rounded to the format), with an optional 0f, 0e or 0d
// prefix, an integer, inf or nan (all mantissa bits set), with a sign.
fn float_bits(A: *mut Asm, s0: []u8, dbl: bool) u64 {
    let mut s = trim(s0);
    let mut neg = false;
    if (s.len > 0) and ((s[0] == '-') or (s[0] == '+')) {
        neg = s[0] == '-';
        s = trim(s[1..]);
    }
    if (s.len > 2) and (s[0] == '0') and (u.find("fFeEdDrRsSxXpP", s[1]) >= 0) and
       not ((s[1] == 'x') or (s[1] == 'X')) {
        s = s[2..];
        if (s.len > 0) and ((s[0] == '-') or (s[0] == '+')) {
            if s[0] == '-' {
                neg = not neg;
            }
            s = s[1..];
        }
    }
    let l = lower(s);
    let mut sign: u64 = 0;
    if neg {
        sign = 1;
    }
    if u.str_eq(l, "inf") or u.str_eq(l, "infinity") or u.str_eq(l, "nan") {
        let nan = u.str_eq(l, "nan");
        if dbl {
            let mut b: u64 = 0x7ff0_0000_0000_0000;
            if nan {
                b = 0x7fff_ffff_ffff_ffff;
            }
            return b | (sign << 63);
        }
        let mut b: u64 = 0x7f80_0000;
        if nan {
            b = 0x7fff_ffff;
        }
        return b | (sign << 31);
    }
    let mut fl = false;
    for c in l {
        if (c == '.') or (c == 'e') {
            fl = true;
        }
    }
    if (l.len > 1) and (l[0] == '0') and (l[1] == 'x') {
        fl = false;
    }
    if not fl {
        let mut ok = true;
        let n = number(l, &mut ok);
        if not ok {
            fail(A, u.f1("'%s' is not a floating-point number", s0));
            return 0;
        }
        let mut f = @float_from_int(f64, n);
        if neg {
            f = -f;
        }
        if dbl {
            return @bit_cast(u64, f);
        }
        return @as(u64, @bit_cast(u32, @float_cast(f32, f)));
    }
    if not float_text(l) {
        fail(A, u.f1("'%s' is not a floating-point number", s0));
        return 0;
    }
    if dbl {
        let f = u.parse_f64(l);
        let b = @bit_cast(u64, f);
        if (b & 0x7ff0_0000_0000_0000) == 0x7ff0_0000_0000_0000 {
            fail(A, u.f1("the number '%s' is out of the range of a double", s0));
            return 0;
        }
        return b | (sign << 63);
    }
    let f = u.parse_f32(l);
    let b = @as(u64, @bit_cast(u32, f));
    if (b & 0x7f80_0000) == 0x7f80_0000 {
        fail(A, u.f1("the number '%s' is out of the range of a float", s0));
        return 0;
    }
    return b | (sign << 31);
}

// Is s (lower case) digits with at most one '.' and an exponent?
fn float_text(s: []u8) bool {
    let mut i: usize = 0;
    let mut digits: i32 = 0;
    while (i < s.len) and u.is_digit(s[i]) {
        i += 1;
        digits += 1;
    }
    if (i < s.len) and (s[i] == '.') {
        i += 1;
        while (i < s.len) and u.is_digit(s[i]) {
            i += 1;
            digits += 1;
        }
    }
    if digits == 0 {
        return false;
    }
    if (i < s.len) and (s[i] == 'e') {
        i += 1;
        if (i < s.len) and ((s[i] == '+') or (s[i] == '-')) {
            i += 1;
        }
        let st = i;
        while (i < s.len) and u.is_digit(s[i]) {
            i += 1;
        }
        if i == st {
            return false;
        }
    }
    return i == s.len;
}

// A .octa operand: a 128-bit integer literal (decimal, hexadecimal, binary
// or octal, with a sign), or an expression (sign-extended).
fn octa(A: *mut Asm, s0: []u8, lo: *mut u64, hi: *mut u64) void {
    let mut s = s0;
    let mut neg = false;
    if (s.len > 0) and (s[0] == '-') {
        neg = true;
        s = trim(s[1..]);
    }
    let mut base: u64 = 10;
    let mut i: usize = 0;
    if (s.len > 2) and (s[0] == '0') and ((s[1] == 'x') or (s[1] == 'X')) {
        base = 16;
        i = 2;
    } else if (s.len > 2) and (s[0] == '0') and ((s[1] == 'b') or (s[1] == 'B')) {
        base = 2;
        i = 2;
    } else if (s.len > 1) and (s[0] == '0') {
        base = 8;
        i = 1;
    }
    let mut literal = (s.len > 0) and u.is_digit(s[0]);
    for k in i..s.len {
        if digit_val(s[k]) >= @bit_cast(i64, base) {
            literal = false;
        }
    }
    if not literal {
        let v = eval_const(A, s0, "the value of .octa");
        lo.* = @bit_cast(u64, v);
        hi.* = 0;
        if v < 0 {
            hi.* = 0xffff_ffff_ffff_ffff;
        }
        return;
    }
    let mut l: u64 = 0;
    let mut h: u64 = 0;
    while i < s.len {
        let d = @bit_cast(u64, digit_val(s[i]));
        // (h:l) = (h:l) * base + d, in 32-bit pieces
        let p0 = (l & 0xffff_ffff) * base + d;
        let p1 = (l >> 32) * base + (p0 >> 32);
        let p2 = (h & 0xffff_ffff) * base + (p1 >> 32);
        let p3 = (h >> 32) * base + (p2 >> 32);
        l = (p0 & 0xffff_ffff) | (p1 << 32);
        h = (p2 & 0xffff_ffff) | (p3 << 32);
        i += 1;
    }
    if neg {
        l = ~l;
        h = ~h;
        l +%= 1;
        if l == 0 {
            h +%= 1;
        }
    }
    lo.* = l;
    hi.* = h;
}

// x in the LEB128 encoding (DWARF's), unsigned or signed.
fn leb(A: *mut Asm, x0: i64, signed: bool) void {
    let mut x = x0;
    if not signed {
        let mut v = @bit_cast(u64, x0);
        loop {
            let mut b = v & 0x7f;
            v = v >> 7;
            if v != 0 {
                b = b | 0x80;
            }
            emit8(A, b);
            if v == 0 {
                return;
            }
        }
    }
    loop {
        let b = @bit_cast(u64, x) & 0x7f;
        x = x >> 7;
        let done = ((x == 0) and ((b & 0x40) == 0)) or ((x == -1) and ((b & 0x40) != 0));
        if done {
            emit8(A, b);
            return;
        }
        emit8(A, b | 0x80);
    }
}

// .incbin "file"[, skip[, count]]: the file's bytes, found as the C
// preprocessor finds `#include "file"`: in the source's directory, then the
// include directories (A.dirs); an absolute name, or one that leaves them
// with "..", is not looked for.
fn incbin(A: *mut Asm, args: []u8) void {
    let xs = split_args(args);
    if xs.len == 0 {
        fail(A, ".incbin needs a file name");
        return;
    }
    let name = string(A, xs[0]);
    if failed(A) {
        return;
    }
    if (name.len == 0) or (name[0] == '/') or (name[0] == '\\') or u.contains(name, "..") or
       ((name.len > 1) and (name[1] == ':')) {
        fail(A, u.f1(".incbin of '%s': the name must be relative to the include directories", name));
        return;
    }
    let mut bytes = u.nosym();
    for d in A.dirs {
        let p = u.f2("%s/%s", d, name);
        if u.is_file(p) {
            bytes = u.read_file(p);
            break;
        }
    }
    if u.isnos(bytes) {
        fail(A, u.f1(".incbin: the file '%s' is not in the include directories", name));
        return;
    }
    let mut skip: i64 = 0;
    let mut count = @int_cast(i64, bytes.len);
    if xs.len > 1 {
        skip = eval_const(A, xs[1], "the skip of .incbin");
    }
    if xs.len > 2 {
        count = eval_const(A, xs[2], "the count of .incbin");
    }
    if (skip < 0) or (skip > @int_cast(i64, bytes.len)) or (count < 0) or ((skip + count) > @int_cast(i64, bytes.len)) {
        fail(A, ".incbin's skip and count are outside the file");
        return;
    }
    for k in @int_cast(usize, skip)..@int_cast(usize, skip + count) {
        emit8(A, @as(u64, bytes[k]));
    }
}

// Directives every architecture has.
fn directive(A: *mut Asm, st: *mut Stmt, arch: *Arch) void {
    let op = st.op;
    let args = st.args;
    if cfi_directive(A, op, args) or seh_directive(A, op, args) {
        return;
    }
    if u.str_eq(op, ".byte") {
        data(A, args, 1);
        return;
    }
    if u.str_eq(op, ".short") or u.str_eq(op, ".hword") or u.str_eq(op, ".2byte") or u.str_eq(op, ".value") {
        data(A, args, 2);
        return;
    }
    if u.str_eq(op, ".word") {
        data(A, args, arch.word);
        return;
    }
    if u.str_eq(op, ".long") or u.str_eq(op, ".int") or u.str_eq(op, ".4byte") {
        data(A, args, 4);
        return;
    }
    if u.str_eq(op, ".quad") or u.str_eq(op, ".xword") or u.str_eq(op, ".8byte") or u.str_eq(op, ".dword") {
        data(A, args, 8);
        return;
    }
    if u.str_eq(op, ".ascii") or u.str_eq(op, ".asciz") or u.str_eq(op, ".string") {
        for s in split_args(args) {
            for c in string(A, s) {
                emit8(A, @as(u64, c));
            }
            if not u.str_eq(op, ".ascii") {
                emit8(A, 0);
            }
        }
        return;
    }
    if u.str_eq(op, ".float") or u.str_eq(op, ".single") or u.str_eq(op, ".double") {
        let dbl = u.str_eq(op, ".double");
        for s in split_args(args) {
            let bits = float_bits(A, s, dbl);
            if dbl {
                emit64(A, bits);
            } else {
                emit32(A, bits);
            }
        }
        return;
    }
    if u.str_eq(op, ".octa") {
        for s in split_args(args) {
            let mut lo: u64 = 0;
            let mut hi: u64 = 0;
            octa(A, trim(s), &mut lo, &mut hi);
            emit64(A, lo);
            emit64(A, hi);
        }
        return;
    }
    if u.str_eq(op, ".uleb128") or u.str_eq(op, ".sleb128") {
        let signed = op[1] == 's';
        for s in split_args(args) {
            let v = settle(A, eval(A, s));
            if not v.ok {
                return;
            }
            if not is_const(v) {
                fail(A, u.f1("%s of a value that is not a constant here", op));
                return;
            }
            leb(A, v.k, signed);
        }
        return;
    }
    if u.str_eq(op, ".zero") or u.str_eq(op, ".skip") or u.str_eq(op, ".space") {
        let xs = split_args(args);
        if xs.len == 0 {
            fail(A, u.f1("%s needs a size", op));
            return;
        }
        let n = eval_const(A, xs[0], "the size");
        let mut fill: i64 = 0;
        if xs.len > 1 {
            fill = eval_const(A, xs[1], "the fill");
        }
        if (n < 0) or (n > 0x1000_0000) {
            fail(A, u.f1("a size of %s", u.dec(n)));
            return;
        }
        for _k in @as(i64, 0)..n {
            emit8(A, @bit_cast(u64, fill));
        }
        return;
    }
    if u.str_eq(op, ".fill") {
        let xs = split_args(args);
        let n = eval_const(A, xs[0], "the count");
        let mut size: i64 = 1;
        let mut val: i64 = 0;
        if xs.len > 1 {
            size = eval_const(A, xs[1], "the size");
        }
        if xs.len > 2 {
            val = eval_const(A, xs[2], "the value");
        }
        if (n < 0) or (n > 0x100_0000) or (size < 0) or (size > 8) {
            fail(A, ".fill of an unsupported count or size");
            return;
        }
        for _k in @as(i64, 0)..n {
            for j in @as(i64, 0)..size {
                if j < 4 {
                    emit8(A, @bit_cast(u64, val) >> @truncate(u32, @bit_cast(u64, j * 8)));
                } else {
                    emit8(A, 0);
                }
            }
        }
        return;
    }
    if u.str_eq(op, ".balign") or u.str_eq(op, ".p2align") or u.str_eq(op, ".align") or u.str_eq(op, ".balignw") or
       u.str_eq(op, ".balignl") or u.str_eq(op, ".p2alignw") or u.str_eq(op, ".p2alignl") {
        let xs = split_args(args);
        if xs.len == 0 {
            fail(A, u.f1("%s needs an alignment", op));
            return;
        }
        let mut n = eval_const(A, xs[0], "the alignment");
        let pow = u.starts(op, ".p2align") or (u.str_eq(op, ".align") and arch.align_pow2);
        if pow {
            if (n < 0) or (n > 30) {
                fail(A, "an alignment out of range");
                return;
            }
            n = @as(i64, 1) << @truncate(u32, @bit_cast(u64, n));
        }
        let mut fill: i64 = 0;
        let mut has_fill = false;
        if (xs.len > 1) and (xs[1].len > 0) {
            fill = eval_const(A, xs[1], "the fill");
            has_fill = true;
        }
        let mut max: i64 = 0;
        if xs.len > 2 {
            max = eval_const(A, xs[2], "the maximum");
        }
        align_to(A, @bit_cast(u64, n), fill, has_fill, arch, @bit_cast(u64, max));
        return;
    }
    if u.str_eq(op, ".text") or u.str_eq(op, ".data") or u.str_eq(op, ".bss") or u.str_eq(op, ".rodata") or
       u.str_eq(op, ".section") or u.str_eq(op, ".pushsection") {
        let mut name = op;
        let mut flags = "";
        let mut ty = "";
        if u.str_eq(op, ".section") or u.str_eq(op, ".pushsection") {
            let xs = split_args(args);
            if xs.len == 0 {
                fail(A, u.f1("%s needs a name", op));
                return;
            }
            name = xs[0];
            if (name.len >= 2) and (name[0] == '"') {
                name = name[1..name.len - 1];
            }
            if xs.len > 1 {
                flags = xs[1];
            }
            if xs.len > 2 {
                ty = xs[2];
            }
        }
        let kind = kind_of_section(name, flags, ty);
        if u.str_eq(op, ".pushsection") {
            A.stack.push(A.cur);
        }
        A.prev = A.cur;
        A.cur = section(A, name, kind);
        return;
    }
    if u.str_eq(op, ".popsection") {
        if A.stack.len == 0 {
            fail(A, ".popsection without .pushsection");
            return;
        }
        A.prev = A.cur;
        A.cur = A.stack.pop();
        return;
    }
    if u.str_eq(op, ".previous") {
        let p = A.prev;
        A.prev = A.cur;
        A.cur = p;
        return;
    }
    if u.str_eq(op, ".globl") or u.str_eq(op, ".global") or u.str_eq(op, ".weak") or u.str_eq(op, ".local") or
       u.str_eq(op, ".hidden") or u.str_eq(op, ".protected") or u.str_eq(op, ".internal") {
        for n in split_args(args) {
            let d = A.defs.at(@int_cast(usize, sym(A, n)));
            if u.str_eq(op, ".weak") {
                d.weak = true;
                d.global = true;
            } else if u.str_eq(op, ".globl") or u.str_eq(op, ".global") {
                d.global = true;
            } else if u.str_eq(op, ".local") {
                d.global = false;
            }
        }
        return;
    }
    if u.str_eq(op, ".comm") or u.str_eq(op, ".lcomm") {
        // a zero-initialized object of its own in .bss (global for .comm:
        // a definition, as with -fno-common; local for .lcomm)
        let xs = split_args(args);
        if xs.len < 2 {
            fail(A, u.f1("%s needs a name and a size", op));
            return;
        }
        let size = eval_const(A, xs[1], "the size");
        let mut al: i64 = 1;
        if xs.len > 2 {
            al = eval_const(A, xs[2], "the alignment");
        } else if u.str_eq(op, ".comm") {
            // (the conventional assembler's default: the largest power of two up to 16 that divides the size)
            al = 16;
            while (al > 1) and ((size % al) != 0) {
                al = al / 2;
            }
        }
        if failed(A) or (size < 0) or (al <= 0) or ((al & (al - 1)) != 0) {
            fail(A, u.f1("%s of a bad size or alignment", op));
            return;
        }
        let save = A.cur;
        A.cur = section(A, ".bss", elf.S_BSS);
        align_to(A, @bit_cast(u64, al), 0, true, arch, 0);
        let d = A.defs.at(@int_cast(usize, sym(A, trim(xs[0]))));
        if d.defined and (d.sec >= 0) {
            fail(A, u.f1("the symbol '%s' is defined twice", d.name));
            return;
        }
        d.defined = true;
        d.intext = true;
        d.sec = A.cur;
        d.off = here(A);
        d.ty = elf.T_OBJECT;
        d.size = size;
        d.has_size = true;
        if u.str_eq(op, ".comm") {
            d.global = true;
        }
        A.secs.at(@int_cast(usize, A.cur)).size += @bit_cast(u64, size);
        A.cur = save;
        return;
    }
    if u.str_eq(op, ".incbin") {
        incbin(A, args);
        return;
    }
    if u.str_eq(op, ".subsection") {
        // (one subsection per section here: the text keeps its order)
        _ = eval_const(A, args, "the subsection");
        return;
    }
    if u.str_eq(op, ".type") {
        let xs = split_args(args);
        if xs.len == 2 {
            let d = A.defs.at(@int_cast(usize, sym(A, xs[0])));
            let t = xs[1];
            if u.contains(t, "function") {
                d.ty = elf.T_FUNC;
            } else if u.contains(t, "object") {
                d.ty = elf.T_OBJECT;
            } else if u.contains(t, "tls") {
                d.ty = elf.T_TLS;
            }
        }
        return;
    }
    if u.str_eq(op, ".size") {
        let xs = split_args(args);
        if xs.len == 2 {
            let d = sym(A, xs[0]);
            let v = settle(A, eval(A, xs[1]));
            if is_const(v) {
                let p = A.defs.at(@int_cast(usize, d));
                p.size = v.k;
                p.has_size = true;
            }
        }
        return;
    }
    if u.str_eq(op, ".set") or u.str_eq(op, ".equ") {
        let xs = split_args(args);
        if xs.len != 2 {
            fail(A, u.f1("%s needs a name and a value", op));
            return;
        }
        let v = settle(A, eval(A, xs[1]));
        if not v.ok {
            return;
        }
        let d = A.defs.at(@int_cast(usize, sym(A, xs[0])));
        if is_const(v) {
            d.abs = true;
            d.off = @bit_cast(u64, v.k);
            d.set_si = A.si;
            return;
        }
        if (v.sym >= 0) and (v.neg < 0) {
            let t = A.defs.get(@int_cast(usize, v.sym));
            if def_sec(A, t) >= 0 {
                d.defined = true;
                d.sec = def_sec(A, t);
                d.off = def_off(A, t) + @bit_cast(u64, v.k);
                return;
            }
        }
        fail(A, u.f1("%s of a value that is not a constant or a label of this assembly", op));
        return;
    }
    // what changes nothing here: debug information (but asm/obj.ax reads
    // .file and .loc), the file's name, identification, the target already
    // in force
    if u.str_eq(op, ".file") or u.str_eq(op, ".loc") {
        loc_directive(A, op, args);
        return;
    }
    let ignored = [".ident", ".code64", ".arch", ".cpu", ".arch_extension", ".nops_off", ".variant_pcs", ".addrsig",
                   ".addrsig_sym"];
    for x in ignored {
        if u.str_eq(op, x) {
            return;
        }
    }
    fail(A, u.f1("the directive '%s' is not supported", op));
}

/// Is expression text s a constant symbol alone (.set) that is set only
/// after the statement being assembled? (The Intel syntax reads such an
/// operand, as the conventional assembler does, as memory at that address.)
pub fn set_later(A: *mut Asm, s: []u8) bool {
    for c in s {
        if not is_sym_char(c) {
            return false;
        }
    }
    let mut i: usize = 0;
    while i < s.len {
        if is_sym_start(s[i]) and ((i == 0) or not is_sym_char(s[i - 1])) {
            let st = i;
            while (i < s.len) and is_sym_char(s[i]) {
                i += 1;
            }
            let k = A.names.get(u.intern(s[st..i]));
            if k > 0 {
                let d = A.defs.get(@int_cast(usize, k - 1));
                if d.abs and (d.set_si > A.si) {
                    return true;
                }
            }
            continue;
        }
        i += 1;
    }
    return false;
}

/// The value of symbol s, a label placed by this text: its section and offset.
pub fn def_of(A: *Asm, s: i32) Def {
    return A.defs.get(@int_cast(usize, s));
}

// -----------------------------------------------------------------------------
// Call frame information: the .cfi_* directives (as the conventional
// assembler's manual describes them), read into DWARF call frame
// instructions (DWARF 5, 6.4.2) for the procedures of file-scope asm
// (.cfi_startproc ... .cfi_endproc: a Proc, whose program the backends put
// in an FDE of .debug_frame: dwarf.ax add_asm_fde), and for an inline
// template the events the enclosing function's frame description takes
// (ICfi: the stack pointer moved by .cfi_adjust_cfa_offset, a register
// saved on the stack by .cfi_rel_offset, given back by .cfi_restore).
// The code and data alignment factors are those of the compiler's CIE: 1
// (x86-64) or 4 (AArch64), and -8.
// -----------------------------------------------------------------------------
pub struct Proc {
    sec: i32,
    start: u64,
    end: u64,
    prog: []u8,    // the FDE's call frame instructions
    simple: bool,  // .cfi_startproc simple: no initial instructions (the CIE's)
    signal: bool,  // .cfi_signal_frame
    x: ProcX,
}

/// What a procedure's frame description has beyond its program: where it
/// goes (.cfi_sections), and its CIE's personality routine (.cfi_personality:
/// the pointer's encoding, DW_EH_PE_*, and symbol + addend), its FDE's
/// language-specific data area (.cfi_lsda), its return address column
/// (.cfi_return_column) and AArch64's augmentations B (.cfi_b_key_frame:
/// return addresses signed with the B key) and G (.cfi_mte_tagged_frame).
/// A personality and an LSDA are ELF's (.eh_frame) only.
pub struct ProcX {
    no_eh: bool,
    no_debug: bool,
    ra: i64,  // the column + 1 (0: the target's)
    has_p: bool,
    penc: u8,
    psym: []u8,
    padd: i64,
    has_l: bool,
    lenc: u8,
    lsym: []u8,
    ladd: i64,
    bkey: bool,
    mte: bool,
}

/// Is e a pointer encoding (DW_EH_PE_*) of .eh_frame's that this writes:
/// absolute or pc-relative (and indirect: the address of a word holding
/// it), of 4 or 8 bytes (signed or not)?
pub fn eh_enc_ok(e: i64) bool {
    if (e < 0) or (e > 255) {
        return false;
    }
    let app = e & 0x70;
    let f = e & 0x0f;
    return ((app == 0) or (app == 0x10)) and ((f == 0) or (f == 3) or (f == 4) or (f == 0xb) or (f == 0xc));
}

// `sym`, `sym + n` or `sym - n`: the symbol and its addend.
fn sym_plus(A: *mut Asm, s0: []u8, name: *mut []u8, add: *mut i64) void {
    let s = trim(s0);
    let mut k = s.len;
    while k > 1 {
        k -= 1;
        if (s[k] == '+') or (s[k] == '-') {
            name.* = trim(s[0..k]);
            add.* = eval_const(A, s[k..], "the addend");
            return;
        }
    }
    name.* = s;
    add.* = 0;
}

pub const IC_ADJUST: u8 = 1;   // the stack pointer moves down by val (from the template's start, in total)
pub const IC_SAVE: u8 = 2;     // register reg (DWARF) saved at the stack pointer + val
pub const IC_RESTORE: u8 = 3;  // register reg has its value again

/// An event of an inline template's call frame information, at offset `off`
/// of the template.
pub struct ICfi {
    off: u64,
    kind: u8,
    reg: u32,
    val: i64,
}

// DWARF call frame instructions
const DW_ADVANCE_LOC: u8 = 0x40;
const DW_OFFSET: u8 = 0x80;
const DW_RESTORE: u8 = 0xc0;
const DW_ADVANCE_LOC1: u8 = 0x02;
const DW_ADVANCE_LOC2: u8 = 0x03;
const DW_ADVANCE_LOC4: u8 = 0x04;
const DW_OFFSET_EXTENDED: u8 = 0x05;
const DW_RESTORE_EXTENDED: u8 = 0x06;
const DW_UNDEFINED: u8 = 0x07;
const DW_SAME_VALUE: u8 = 0x08;
const DW_REGISTER: u8 = 0x09;
const DW_REMEMBER_STATE: u8 = 0x0a;
const DW_RESTORE_STATE: u8 = 0x0b;
const DW_DEF_CFA: u8 = 0x0c;
const DW_DEF_CFA_REGISTER: u8 = 0x0d;
const DW_DEF_CFA_OFFSET: u8 = 0x0e;
const DW_OFFSET_EXTENDED_SF: u8 = 0x11;
const DW_DEF_CFA_SF: u8 = 0x12;
const DW_DEF_CFA_OFFSET_SF: u8 = 0x13;
const DW_NEGATE_RA_STATE: u8 = 0x2d;
const DW_NEGATE_RA_STATE_WITH_PC: u8 = 0x2c;
const DW_VAL_OFFSET: u8 = 0x14;
const DW_VAL_OFFSET_SF: u8 = 0x15;

pub fn uleb_to(b: *mut u.Buf, x0: u64) void {
    let mut x = x0;
    loop {
        let c = x & 0x7f;
        x = x >> 7;
        if x == 0 {
            b.c(@truncate(u8, c));
            return;
        }
        b.c(@truncate(u8, c | 0x80));
    }
}

pub fn sleb_to(b: *mut u.Buf, x0: i64) void {
    let mut x = x0;
    loop {
        let c = @bit_cast(u64, x) & 0x7f;
        x = x >> 7;
        if ((x == 0) and ((c & 0x40) == 0)) or ((x == -1) and ((c & 0x40) != 0)) {
            b.c(@truncate(u8, c));
            return;
        }
        b.c(@truncate(u8, c | 0x80));
    }
}

// x86-64's DWARF register numbers of ours (rax rcx rdx rbx rsp rbp rsi rdi r8-r15)
let X64_DWARF: [16]i64 = [0, 2, 1, 3, 7, 6, 4, 5, 8, 9, 10, 11, 12, 13, 14, 15];

/// The DWARF register number (the platform ABIs': x86-64 rax 0, rdx 1, rcx 2,
/// rbx 3, rsi 4, rdi 5, rbp 6, rsp 7, r8-r15, rip 16, xmm0-15 17-32, st0-7
/// 33-40, mm0-7 41-48; AArch64 x0-x30 0-30, sp 31, v0-v31 64-95) of the
/// register named s, or a number written as such; -1 if s is neither.
pub fn dwarf_reg(A: *Asm, s0: []u8) i64 {
    let mut s = lower(trim(s0));
    if (s.len > 0) and (s[0] == '%') {
        s = s[1..];
    }
    let n = ai.num(s);
    if n >= 0 {
        return n;
    }
    if A.arch == tg.ARCH_A64 {
        let r = ai.a64_reg(s);
        if r.reg < 0 {
            return -1;
        }
        if r.cls == ai.CL_VEC {
            return 64 + @as(i64, r.reg - 32);
        }
        return @as(i64, r.reg);
    }
    if u.str_eq(s, "rip") {
        return 16;
    }
    let r = ai.x86_reg(s);
    if (r.reg >= 0) and (r.reg < 16) and (r.bits == 64) {
        return X64_DWARF[@int_cast(usize, r.reg)];
    }
    if (r.reg >= 16) and (r.reg < 32) {
        return 17 + @as(i64, r.reg - 16);
    }
    let pres = ["st", "mm"];
    let bases: [2]i64 = [33, 41];
    for k in @as(usize, 0)..2 {
        if u.starts(s, pres[k]) {
            let mut t = s[2..];
            if (t.len == 3) and (t[0] == '(') and (t[2] == ')') {
                t = t[1..2];
            }
            let x = ai.num(t);
            if (x >= 0) and (x < 8) {
                return bases[k] + x;
            }
        }
    }
    return -1;
}

fn cfi_reg(A: *mut Asm, s: []u8) u64 {
    let r = dwarf_reg(A, s);
    if r < 0 {
        fail(A, u.f1("'%s' is not a register of call frame information", trim(s)));
        return 0;
    }
    return @bit_cast(u64, r);
}

// The advance of the procedure's program to the current place.
fn cfi_advance(A: *mut Asm) void {
    let at = here(A);
    if at <= A.cfi_loc {
        return;
    }
    let mut ca: u64 = 1;
    if A.arch == tg.ARCH_A64 {
        ca = 4;
    }
    let d = (at - A.cfi_loc) / ca;
    let b = &mut A.cfi_prog;
    if d < 64 {
        b.c(DW_ADVANCE_LOC | @truncate(u8, d));
    } else if d < 256 {
        b.c(DW_ADVANCE_LOC1);
        b.c(@truncate(u8, d));
    } else if d < 65536 {
        b.c(DW_ADVANCE_LOC2);
        b.c(@truncate(u8, d));
        b.c(@truncate(u8, d >> 8));
    } else {
        b.c(DW_ADVANCE_LOC4);
        for k in @as(u32, 0)..4 {
            b.c(@truncate(u8, d >> (8 * k)));
        }
    }
    A.cfi_loc = at;
}

// A register saved at CFA + off.
fn cfi_offset(A: *mut Asm, r: u64, off: i64) void {
    if (off % 8) != 0 {
        fail(A, u.f1("a register's offset from the CFA (%s) that is not a multiple of 8", u.dec(off)));
        return;
    }
    let f = off / -8;
    let b = &mut A.cfi_prog;
    if f < 0 {
        b.c(DW_OFFSET_EXTENDED_SF);
        uleb_to(b, r);
        sleb_to(b, f);
    } else if r < 64 {
        b.c(DW_OFFSET | @truncate(u8, r));
        uleb_to(b, @bit_cast(u64, f));
    } else {
        b.c(DW_OFFSET_EXTENDED);
        uleb_to(b, r);
        uleb_to(b, @bit_cast(u64, f));
    }
}

fn cfi_def_offset(A: *mut Asm, off: i64) void {
    A.cfi_off = off;
    let b = &mut A.cfi_prog;
    if off < 0 {
        if (off % 8) != 0 {
            fail(A, "a negative CFA offset that is not a multiple of 8");
            return;
        }
        b.c(DW_DEF_CFA_OFFSET_SF);
        sleb_to(b, off / -8);
        return;
    }
    b.c(DW_DEF_CFA_OFFSET);
    uleb_to(b, @bit_cast(u64, off));
}

// Two operands (a register and a value, or two registers).
fn cfi_two(A: *mut Asm, args: []u8, op: []u8) [][]u8 {
    let xs = split_args(args);
    if xs.len != 2 {
        fail(A, u.f1("%s takes two operands", op));
    }
    return xs;
}

/// A .cfi_* directive: false if `op` is not one.
fn cfi_directive(A: *mut Asm, op: []u8, args: []u8) bool {
    if not u.starts(op, ".cfi_") {
        return false;
    }
    if u.str_eq(op, ".cfi_sections") {
        // (the sections of the procedures from here on: .eh_frame, which
        // ELF objects have on Linux, and .debug_frame, with -g)
        A.cfi_no_eh = true;
        A.cfi_no_debug = true;
        for x in split_args(args) {
            let n = trim(x);
            if u.str_eq(n, ".eh_frame") {
                A.cfi_no_eh = false;
            } else if u.str_eq(n, ".debug_frame") {
                A.cfi_no_debug = false;
            } else {
                fail(A, u.f1(".cfi_sections of '%s' (.eh_frame and .debug_frame are the sections)", n));
            }
        }
        return true;
    }
    if A.inline_ {
        cfi_inline(A, op, args);
        return true;
    }
    if u.str_eq(op, ".cfi_startproc") {
        if A.in_proc {
            fail(A, ".cfi_startproc inside a procedure (no .cfi_endproc)");
            return true;
        }
        let a = lower(trim(args));
        if (a.len > 0) and not u.str_eq(a, "simple") {
            fail(A, u.f1("'.cfi_startproc %s' is not supported", args));
            return true;
        }
        A.in_proc = true;
        A.cfi_simple = a.len > 0;
        A.cfi_signal = false;
        A.cfi_sec = A.cur;
        A.cfi_start = here(A);
        A.cfi_loc = A.cfi_start;
        A.cfi_prog = u.Buf.init();
        A.cfi_stack.clear();
        A.cfi_x = ProcX.{ no_eh: A.cfi_no_eh, no_debug: A.cfi_no_debug, ra: 0, has_p: false, penc: 0xff, psym: "",
                          padd: 0, has_l: false, lenc: 0xff, lsym: "", ladd: 0, bkey: false, mte: false };
        // (the CIE's state: x86-64 CFA = rsp + 8, AArch64 CFA = sp)
        A.cfi_reg = 7;
        A.cfi_off = 8;
        if A.arch == tg.ARCH_A64 {
            A.cfi_reg = 31;
            A.cfi_off = 0;
        }
        return true;
    }
    if not A.in_proc {
        fail(A, u.f1("%s outside a procedure (.cfi_startproc)", op));
        return true;
    }
    if A.cur != A.cfi_sec {
        fail(A, u.f1("%s in another section than its procedure's", op));
        return true;
    }
    if u.str_eq(op, ".cfi_endproc") {
        A.in_proc = false;
        A.procs.push(Proc.{ sec: A.cfi_sec, start: A.cfi_start, end: here(A), prog: A.cfi_prog.done(),
                            simple: A.cfi_simple, signal: A.cfi_signal, x: A.cfi_x });
        return true;
    }
    if u.str_eq(op, ".cfi_signal_frame") {
        A.cfi_signal = true;
        return true;
    }
    if u.str_eq(op, ".cfi_personality") or u.str_eq(op, ".cfi_lsda") {
        // (encoding, symbol: the encoding 0xff, "none", takes no symbol)
        let xs = split_args(args);
        if xs.len < 1 {
            fail(A, u.f1("%s takes an encoding and a symbol", op));
            return true;
        }
        let e = eval_const(A, xs[0], "the encoding");
        let pers = u.str_eq(op, ".cfi_personality");
        if e == 255 {
            if pers {
                A.cfi_x.has_p = false;
            } else {
                A.cfi_x.has_l = false;
            }
            return true;
        }
        if xs.len != 2 {
            fail(A, u.f1("%s takes an encoding and a symbol", op));
            return true;
        }
        if not eh_enc_ok(e) {
            fail(A,
                 u.f2("%s with the pointer encoding %s (absolute or pc-relative 4 or 8 bytes are written, optionally indirect)",
                      op, u.dec(e)));
            return true;
        }
        if tg.g_os != tg.OS_LINUX {
            fail(A, u.f1("%s with a routine (ELF's .eh_frame, on Linux only)", op));
            return true;
        }
        let mut name: []u8 = "";
        let mut add: i64 = 0;
        sym_plus(A, xs[1], &mut name, &mut add);
        if pers {
            A.cfi_x.has_p = true;
            A.cfi_x.penc = @truncate(u8, @bit_cast(u64, e));
            A.cfi_x.psym = u.perm_dup(name);
            A.cfi_x.padd = add;
        } else {
            A.cfi_x.has_l = true;
            A.cfi_x.lenc = @truncate(u8, @bit_cast(u64, e));
            A.cfi_x.lsym = u.perm_dup(name);
            A.cfi_x.ladd = add;
        }
        return true;
    }
    if (u.str_eq(op, ".cfi_return_column") or u.str_eq(op, ".cfi_b_key_frame") or
        u.str_eq(op, ".cfi_mte_tagged_frame")) and (tg.g_os != tg.OS_LINUX) {
        fail(A, u.f1("%s (a CIE of its own: ELF's .eh_frame, on Linux only)", op));
        return true;
    }
    if u.str_eq(op, ".cfi_return_column") {
        A.cfi_x.ra = @bit_cast(i64, cfi_reg(A, args)) + 1;
        return true;
    }
    if (u.str_eq(op, ".cfi_b_key_frame") or u.str_eq(op, ".cfi_mte_tagged_frame")) and (A.arch == tg.ARCH_A64) {
        if u.str_eq(op, ".cfi_b_key_frame") {
            A.cfi_x.bkey = true;
        } else {
            A.cfi_x.mte = true;
        }
        return true;
    }
    if u.str_eq(op, ".cfi_label") {
        // (a label at this place, as `name:` would be)
        let d = A.defs.at(@int_cast(usize, sym(A, trim(args))));
        if d.defined or d.abs {
            fail(A, u.f1("the label '%s' is defined twice", d.name));
            return true;
        }
        d.defined = true;
        d.sec = A.cur;
        d.off = here(A);
        return true;
    }
    cfi_advance(A);
    if u.str_eq(op, ".cfi_def_cfa") {
        let xs = cfi_two(A, args, op);
        if failed(A) {
            return true;
        }
        let r = cfi_reg(A, xs[0]);
        let off = eval_const(A, xs[1], "the offset");
        A.cfi_reg = r;
        A.cfi_off = off;
        if off < 0 {
            A.cfi_prog.c(DW_DEF_CFA_SF);
            uleb_to(&mut A.cfi_prog, r);
            sleb_to(&mut A.cfi_prog, off / -8);
        } else {
            A.cfi_prog.c(DW_DEF_CFA);
            uleb_to(&mut A.cfi_prog, r);
            uleb_to(&mut A.cfi_prog, @bit_cast(u64, off));
        }
        return true;
    }
    if u.str_eq(op, ".cfi_def_cfa_register") {
        let r = cfi_reg(A, args);
        A.cfi_reg = r;
        A.cfi_prog.c(DW_DEF_CFA_REGISTER);
        uleb_to(&mut A.cfi_prog, r);
        return true;
    }
    if u.str_eq(op, ".cfi_def_cfa_offset") {
        cfi_def_offset(A, eval_const(A, args, "the offset"));
        return true;
    }
    if u.str_eq(op, ".cfi_adjust_cfa_offset") {
        cfi_def_offset(A, A.cfi_off + eval_const(A, args, "the adjustment"));
        return true;
    }
    if u.str_eq(op, ".cfi_offset") or u.str_eq(op, ".cfi_rel_offset") {
        let xs = cfi_two(A, args, op);
        if failed(A) {
            return true;
        }
        let r = cfi_reg(A, xs[0]);
        let mut off = eval_const(A, xs[1], "the offset");
        if u.str_eq(op, ".cfi_rel_offset") {
            off = off - A.cfi_off;  // (from the CFA register's value: CFA - its offset)
        }
        cfi_offset(A, r, off);
        return true;
    }
    if u.str_eq(op, ".cfi_restore") or u.str_eq(op, ".cfi_undefined") or u.str_eq(op, ".cfi_same_value") {
        for x in split_args(args) {
            let r = cfi_reg(A, x);
            if u.str_eq(op, ".cfi_restore") {
                if r < 64 {
                    A.cfi_prog.c(DW_RESTORE | @truncate(u8, r));
                } else {
                    A.cfi_prog.c(DW_RESTORE_EXTENDED);
                    uleb_to(&mut A.cfi_prog, r);
                }
            } else {
                A.cfi_prog.c(u.pick(u.str_eq(op, ".cfi_undefined"), "\x07", "\x08")[0]);
                uleb_to(&mut A.cfi_prog, r);
            }
        }
        return true;
    }
    if u.str_eq(op, ".cfi_register") {
        let xs = cfi_two(A, args, op);
        if failed(A) {
            return true;
        }
        A.cfi_prog.c(DW_REGISTER);
        uleb_to(&mut A.cfi_prog, cfi_reg(A, xs[0]));
        uleb_to(&mut A.cfi_prog, cfi_reg(A, xs[1]));
        return true;
    }
    if u.str_eq(op, ".cfi_remember_state") {
        A.cfi_stack.push(@bit_cast(i64, A.cfi_reg));
        A.cfi_stack.push(A.cfi_off);
        A.cfi_prog.c(DW_REMEMBER_STATE);
        return true;
    }
    if u.str_eq(op, ".cfi_restore_state") {
        if A.cfi_stack.len < 2 {
            fail(A, ".cfi_restore_state without .cfi_remember_state");
            return true;
        }
        A.cfi_off = A.cfi_stack.pop();
        A.cfi_reg = @bit_cast(u64, A.cfi_stack.pop());
        A.cfi_prog.c(DW_RESTORE_STATE);
        return true;
    }
    if u.str_eq(op, ".cfi_escape") {
        for x in split_args(args) {
            let v = eval_const(A, x, "a byte");
            if (v < 0) or (v > 255) {
                fail(A, u.f1(".cfi_escape of '%s', not a byte", x));
                return true;
            }
            A.cfi_prog.c(@truncate(u8, @bit_cast(u64, v)));
        }
        return true;
    }
    if (u.str_eq(op, ".cfi_negate_ra_state") or u.str_eq(op, ".cfi_window_save")) and (A.arch == tg.ARCH_A64) {
        A.cfi_prog.c(DW_NEGATE_RA_STATE);
        return true;
    }
    if u.str_eq(op, ".cfi_negate_ra_state_with_pc") and (A.arch == tg.ARCH_A64) {
        A.cfi_prog.c(DW_NEGATE_RA_STATE_WITH_PC);
        return true;
    }
    if u.str_eq(op, ".cfi_val_offset") {
        // (the register's value is CFA + off: DW_CFA_val_offset(_sf))
        let xs = cfi_two(A, args, op);
        if failed(A) {
            return true;
        }
        let r = cfi_reg(A, xs[0]);
        let off = eval_const(A, xs[1], "the offset");
        if (off % 8) != 0 {
            fail(A, u.f1("a register's offset from the CFA (%s) that is not a multiple of 8", u.dec(off)));
            return true;
        }
        if off <= 0 {
            A.cfi_prog.c(DW_VAL_OFFSET);
            uleb_to(&mut A.cfi_prog, r);
            uleb_to(&mut A.cfi_prog, @bit_cast(u64, off / -8));
        } else {
            A.cfi_prog.c(DW_VAL_OFFSET_SF);
            uleb_to(&mut A.cfi_prog, r);
            sleb_to(&mut A.cfi_prog, off / -8);
        }
        return true;
    }
    fail(A, u.f1("the directive '%s' is not supported", op));
    return true;
}

// A .cfi_* directive in an inline template, which describes what the
// template does to the enclosing function's frame: the stack pointer it
// moves (.cfi_adjust_cfa_offset), the registers it saves on the stack
// (.cfi_rel_offset: from the stack pointer there) and gives back
// (.cfi_restore). The template must not change the frame otherwise.
fn cfi_inline(A: *mut Asm, op: []u8, args: []u8) void {
    let at = here(A);
    if u.str_eq(op, ".cfi_adjust_cfa_offset") {
        A.cfi_off = A.cfi_off + eval_const(A, args, "the adjustment");
        A.icfi.push(ICfi.{ off: at, kind: IC_ADJUST, reg: 0, val: A.cfi_off });
        return;
    }
    if u.str_eq(op, ".cfi_rel_offset") {
        let xs = cfi_two(A, args, op);
        if failed(A) {
            return;
        }
        let r = cfi_reg(A, xs[0]);
        let off = eval_const(A, xs[1], "the offset");
        A.icfi.push(ICfi.{ off: at, kind: IC_SAVE, reg: @truncate(u32, r), val: off });
        return;
    }
    if u.str_eq(op, ".cfi_restore") or u.str_eq(op, ".cfi_same_value") {
        for x in split_args(args) {
            let r = cfi_reg(A, x);
            A.icfi.push(ICfi.{ off: at, kind: IC_RESTORE, reg: @truncate(u32, r), val: 0 });
        }
        return;
    }
    if u.str_eq(op, ".cfi_startproc") or u.str_eq(op, ".cfi_endproc") {
        fail(A, u.f1("%s in inline assembly (a template is a part of its function)", op));
        return;
    }
    fail(A,
         u.f1("%s in inline assembly: a template cannot change its function's frame (only .cfi_adjust_cfa_offset, .cfi_rel_offset and .cfi_restore)",
              op));
}

// After the last pass: a procedure must be closed, and an inline template
// must leave the stack and the registers it saved as it found them.
fn cfi_finish(A: *mut Asm) void {
    if A.in_seh {
        fail(A, ".seh_proc without its .seh_endproc");
        return;
    }
    if A.in_proc {
        fail(A, ".cfi_startproc without its .cfi_endproc");
        return;
    }
    if not A.inline_ {
        return;
    }
    if A.cfi_off != 0 {
        fail(A, "the template's .cfi_adjust_cfa_offset do not add up to 0 (the stack pointer must be where it was)");
        return;
    }
    let mut saved = u.List.[u32].empty();
    for e in A.icfi.items() {
        if e.kind == IC_SAVE {
            saved.push(e.reg);
        } else if e.kind == IC_RESTORE {
            let mut k: usize = 0;
            while k < saved.len {
                if saved.get(k) == e.reg {
                    saved.set(k, 0xffff_ffff);
                }
                k += 1;
            }
        }
    }
    for r in saved.items() {
        if r != 0xffff_ffff {
            fail(A, u.f1("the template saves register %s (.cfi_rel_offset) and does not restore it (.cfi_restore)",
                         u.udec(@as(u64, r))));
            return;
        }
    }
}

/// Call frame instructions at an offset of an inline template (inline_cfi).
pub struct CfiOut {
    off: u64,
    bytes: []u8,
}

// A register saved at the stack pointer + off: DW_CFA_expression(reg,
// DW_OP_bregN(off)), N the stack pointer's DWARF number.
fn sp_save(b: *mut u.Buf, reg: u32, sp: u32, off: i64) void {
    let mut e = u.Buf.init();
    if sp < 32 {
        e.c(0x70 + @truncate(u8, sp));  // DW_OP_breg0 + sp
    } else {
        e.c(0x92);  // DW_OP_bregx
        uleb_to(&mut e, @as(u64, sp));
    }
    sleb_to(&mut e, off);
    let x = e.done();
    b.c(0x10);  // DW_CFA_expression
    uleb_to(b, @as(u64, reg));
    uleb_to(b, @as(u64, x.len));
    for c in x {
        b.c(c);
    }
}

/// The call frame instructions of an inline template's events (A.icfi): a
/// register the template saves (.cfi_rel_offset reg, off) is at the stack
/// pointer + off then, and as the template moves the stack pointer
/// (.cfi_adjust_cfa_offset) its rule follows; .cfi_restore gives it back
/// the function's rule: at its CFA offset `saved_offs[k]` for the registers
/// `saved_regs` the function's frame saves, else its own value. (The
/// function has a frame: its CFA does not depend on the stack pointer.)
pub fn inline_cfi(A: *Asm, sp: u32, saved_regs: []u32, saved_offs: []i64) []CfiOut {
    let mut out = u.List.[CfiOut].empty();
    let mut regs = u.List.[u32].empty();
    let mut at = u.List.[i64].empty();  // (each saved register's offset from the stack pointer at the template's start)
    let mut delta: i64 = 0;
    for e in A.icfi.items() {
        let mut b = u.Buf.init();
        if e.kind == IC_ADJUST {
            delta = e.val;
            for k in 0..regs.len {
                if regs.get(k) != 0xffff_ffff {
                    sp_save(&mut b, regs.get(k), sp, at.get(k) + delta);
                }
            }
        } else if e.kind == IC_SAVE {
            regs.push(e.reg);
            at.push(e.val - delta);
            sp_save(&mut b, e.reg, sp, e.val);
        } else {
            for k in 0..regs.len {
                if regs.get(k) == e.reg {
                    regs.set(k, 0xffff_ffff);
                }
            }
            let mut done = false;
            for k in 0..saved_regs.len {
                if saved_regs[k] == e.reg {
                    let f = saved_offs[k] / -8;
                    if e.reg < 64 {
                        b.c(DW_OFFSET | @truncate(u8, e.reg));
                    } else {
                        b.c(DW_OFFSET_EXTENDED);
                        uleb_to(&mut b, @as(u64, e.reg));
                    }
                    uleb_to(&mut b, @bit_cast(u64, f));
                    done = true;
                }
            }
            if not done {
                b.c(DW_SAME_VALUE);
                uleb_to(&mut b, @as(u64, e.reg));
            }
        }
        let bytes = b.done();
        if bytes.len > 0 {
            out.push(CfiOut.{ off: e.off, bytes: bytes });
        }
    }
    return out.items();
}

// -----------------------------------------------------------------------------
// Windows unwind information: the .seh_* directives of file-scope asm, read
// into the procedure's unwind record (.xdata; asm/obj.ax places it and the
// backend adds its .pdata entry): x86-64's UNWIND_INFO (the x64 exception
// handling documentation: version 1, the prologue's size, the codes in the
// reverse order of the prologue's instructions, the frame register), and
// ARM64's record (the ARM64 exception handling documentation: a header word,
// the epilogue scopes, the prologue's codes in reverse order then `end`,
// each epilogue's codes then `end`). There are no exception handlers here:
// .seh_handler is an error.
// -----------------------------------------------------------------------------
pub struct SehProc {
    sec: i32,
    start: u64,
    end: u64,
    xdata: []u8,
}

// x86-64 UNWIND_CODE operations
const UWOP_PUSH_NONVOL: u8 = 0;
const UWOP_ALLOC_LARGE: u8 = 1;
const UWOP_ALLOC_SMALL: u8 = 2;
const UWOP_SET_FPREG: u8 = 3;
const UWOP_SAVE_NONVOL: u8 = 4;
const UWOP_SAVE_NONVOL_FAR: u8 = 5;
const UWOP_SAVE_XMM128: u8 = 8;
const UWOP_SAVE_XMM128_FAR: u8 = 9;
const UWOP_PUSH_MACHFRAME: u8 = 10;

// One x86-64 code: its prologue offset, operation and information, and the
// slots that follow it (n of them, little-endian in x).
fn seh_code(A: *mut Asm, op: u8, info: u64, x: u64, n: u32) void {
    let off = here(A) - A.seh_start;
    if off > 255 {
        fail(A, "a prologue of more than 255 bytes (.seh_*)");
        return;
    }
    let mut b = u.Buf.init();
    b.c(@truncate(u8, off));
    b.c(op | @truncate(u8, info << 4));
    for k in @as(u32, 0)..n {
        b.c(@truncate(u8, x >> (16 * k)));
        b.c(@truncate(u8, x >> ((16 * k) + 8)));
    }
    A.seh_codes.push(b.done());
}

fn x64_reg_num(A: *mut Asm, s: []u8, xmm: bool) u64 {
    let mut n = lower(trim(s));
    if (n.len > 0) and (n[0] == '%') {
        n = n[1..];
    }
    let r = ai.x86_reg(n);
    if xmm and (r.reg >= 16) and (r.reg < 32) {
        return @int_cast(u64, r.reg - 16);
    }
    if not xmm and (r.reg >= 0) and (r.reg < 16) and (r.bits == 64) {
        return @int_cast(u64, r.reg);  // (ours are Windows's numbers: rax rcx rdx rbx rsp rbp rsi rdi r8-r15)
    }
    fail(A, u.f1("'%s' is not a register of this .seh_ directive", trim(s)));
    return 0;
}

// The AArch64 register of an ARM64 .seh_ directive: x19-x30 (fp, lr), d8-d15.
fn a64_seh_reg(A: *mut Asm, s: []u8, base: i32, fp: bool) u64 {
    let r = ai.a64_reg(lower(trim(s)));
    let mut n = r.reg;
    if fp and (r.cls == ai.CL_VEC) {
        n = r.reg - 32;
    } else if fp or (r.cls != ai.CL_GPR) {
        n = -1;
    }
    if n < base {
        fail(A, u.f1("'%s' is not a register of this .seh_ directive", trim(s)));
        return 0;
    }
    return @int_cast(u64, n - base);
}

/// A .seh_* directive: false if `op` is not one.
fn seh_directive(A: *mut Asm, op: []u8, args: []u8) bool {
    if not u.starts(op, ".seh_") {
        return false;
    }
    if A.inline_ {
        fail(A, u.f1("%s in inline assembly", op));
        return true;
    }
    if u.str_eq(op, ".seh_proc") {
        if A.in_seh {
            fail(A, ".seh_proc inside a procedure (no .seh_endproc)");
            return true;
        }
        A.in_seh = true;
        A.seh_sec = A.cur;
        A.seh_start = here(A);
        A.seh_prolog = -1;
        A.seh_codes.clear();
        A.seh_epis.clear();
        A.seh_frame = 0;
        return true;
    }
    if not A.in_seh {
        fail(A, u.f1("%s outside a procedure (.seh_proc)", op));
        return true;
    }
    let a64 = A.arch == tg.ARCH_A64;
    let xs = split_args(args);
    let n1 = xs.len >= 1;
    let n2 = xs.len >= 2;
    if u.str_eq(op, ".seh_endprologue") {
        A.seh_prolog = @bit_cast(i64, here(A) - A.seh_start);
        if a64 {
            A.seh_codes.push("\xe4");  // end
        }
        return true;
    }
    if u.str_eq(op, ".seh_endproc") or u.str_eq(op, ".seh_endfunclet") {
        A.in_seh = false;
        if A.seh_prolog < 0 {
            fail(A, ".seh_endproc without .seh_endprologue");
            return true;
        }
        if a64 {
            seh_a64_record(A);
        } else {
            seh_x64_record(A);
        }
        return true;
    }
    if u.str_eq(op, ".seh_handler") or u.str_eq(op, ".seh_handlerdata") {
        fail(A, u.f1("%s: exception handlers are not supported", op));
        return true;
    }
    if (A.seh_prolog >= 0) and not a64 {
        fail(A, u.f1("%s after .seh_endprologue", op));
        return true;
    }
    if not a64 {
        if u.str_eq(op, ".seh_pushreg") and n1 {
            seh_code(A, UWOP_PUSH_NONVOL, x64_reg_num(A, xs[0], false), 0, 0);
        } else if u.str_eq(op, ".seh_stackalloc") and n1 {
            let n = eval_const(A, xs[0], "the size");
            if (n <= 0) or ((n % 8) != 0) {
                fail(A, ".seh_stackalloc of a size that is not a positive multiple of 8");
            } else if n <= 128 {
                seh_code(A, UWOP_ALLOC_SMALL, @bit_cast(u64, (n / 8) - 1), 0, 0);
            } else if n <= 524280 {
                seh_code(A, UWOP_ALLOC_LARGE, 0, @bit_cast(u64, n / 8), 1);
            } else {
                seh_code(A, UWOP_ALLOC_LARGE, 1, @bit_cast(u64, n), 2);
            }
        } else if u.str_eq(op, ".seh_setframe") and n2 {
            let r = x64_reg_num(A, xs[0], false);
            let off = eval_const(A, xs[1], "the offset");
            if (off < 0) or (off > 240) or ((off % 16) != 0) {
                fail(A, ".seh_setframe's offset must be a multiple of 16 up to 240");
                return true;
            }
            A.seh_frame = r | (@bit_cast(u64, off / 16) << 4);
            seh_code(A, UWOP_SET_FPREG, 0, 0, 0);
        } else if (u.str_eq(op, ".seh_savereg") or u.str_eq(op, ".seh_savexmm")) and n2 {
            let xmm = u.str_eq(op, ".seh_savexmm");
            let r = x64_reg_num(A, xs[0], xmm);
            let off = eval_const(A, xs[1], "the offset");
            let mut unit: i64 = 8;
            if xmm {
                unit = 16;
            }
            if (off < 0) or ((off % unit) != 0) {
                fail(A, u.f1("%s's offset must be a multiple of its register's size", op));
            } else if (off / unit) < 65536 {
                seh_code(A, u.pick(xmm, "\x08", "\x04")[0], r, @bit_cast(u64, off / unit), 1);
            } else {
                seh_code(A, u.pick(xmm, "\x09", "\x05")[0], r, @bit_cast(u64, off), 2);
            }
        } else if u.str_eq(op, ".seh_pushframe") {
            seh_code(A, UWOP_PUSH_MACHFRAME, u64_pick(n1, 1, 0), 0, 0);
        } else {
            fail(A, u.f1("the directive '%s' is not supported", op));
        }
        return true;
    }
    // ARM64: each directive is one code for one instruction
    let mut b = u.Buf.init();
    let off = eval_off(A, xs, 1);
    if u.str_eq(op, ".seh_startepilogue") {
        A.seh_epis.push(@bit_cast(i64, here(A) - A.seh_start));
        A.seh_epis.push(@as(i64, @int_cast(i64, A.seh_codes.len)));
        return true;
    }
    if u.str_eq(op, ".seh_endepilogue") {
        A.seh_codes.push("\xe4");
        return true;
    }
    if u.str_eq(op, ".seh_stackalloc") and n1 {
        let n = eval_const(A, xs[0], "the size") / 16;
        if n < 32 {
            b.c(@truncate(u8, @bit_cast(u64, n)));
        } else if n < 2048 {
            b.c(0xc0 | @truncate(u8, @bit_cast(u64, n) >> 8));
            b.c(@truncate(u8, @bit_cast(u64, n)));
        } else {
            b.c(0xe0);
            b.c(@truncate(u8, @bit_cast(u64, n) >> 16));
            b.c(@truncate(u8, @bit_cast(u64, n) >> 8));
            b.c(@truncate(u8, @bit_cast(u64, n)));
        }
    } else if u.str_eq(op, ".seh_save_fplr") and n1 {
        b.c(0x40 | @truncate(u8, eval_off(A, xs, 0) / 8));
    } else if u.str_eq(op, ".seh_save_fplr_x") and n1 {
        b.c(0x80 | @truncate(u8, (eval_off(A, xs, 0) / 8) - 1));
    } else if u.str_eq(op, ".seh_save_regp") and n2 {
        let x = a64_seh_reg(A, xs[0], 19, false);
        b.c(0xc8 | @truncate(u8, x >> 2));
        b.c(@truncate(u8, (x << 6) | (off / 8)));
    } else if u.str_eq(op, ".seh_save_regp_x") and n2 {
        let x = a64_seh_reg(A, xs[0], 19, false);
        b.c(0xcc | @truncate(u8, x >> 2));
        b.c(@truncate(u8, (x << 6) | ((off / 8) - 1)));
    } else if u.str_eq(op, ".seh_save_reg") and n2 {
        let x = a64_seh_reg(A, xs[0], 19, false);
        b.c(0xd0 | @truncate(u8, x >> 2));
        b.c(@truncate(u8, (x << 6) | (off / 8)));
    } else if u.str_eq(op, ".seh_save_reg_x") and n2 {
        let x = a64_seh_reg(A, xs[0], 19, false);
        b.c(0xd4 | @truncate(u8, x >> 3));
        b.c(@truncate(u8, (x << 5) | ((off / 8) - 1)));
    } else if u.str_eq(op, ".seh_save_lrpair") and n2 {
        let x = a64_seh_reg(A, xs[0], 19, false) / 2;
        b.c(0xd6 | @truncate(u8, x >> 2));
        b.c(@truncate(u8, (x << 6) | (off / 8)));
    } else if u.str_eq(op, ".seh_save_fregp") and n2 {
        let x = a64_seh_reg(A, xs[0], 8, true);
        b.c(0xd8 | @truncate(u8, x >> 2));
        b.c(@truncate(u8, (x << 6) | (off / 8)));
    } else if u.str_eq(op, ".seh_save_fregp_x") and n2 {
        let x = a64_seh_reg(A, xs[0], 8, true);
        b.c(0xda | @truncate(u8, x >> 2));
        b.c(@truncate(u8, (x << 6) | ((off / 8) - 1)));
    } else if u.str_eq(op, ".seh_save_freg") and n2 {
        let x = a64_seh_reg(A, xs[0], 8, true);
        b.c(0xdc | @truncate(u8, x >> 2));
        b.c(@truncate(u8, (x << 6) | (off / 8)));
    } else if u.str_eq(op, ".seh_save_freg_x") and n2 {
        let x = a64_seh_reg(A, xs[0], 8, true);
        b.c(0xde);
        b.c(@truncate(u8, (x << 5) | ((off / 8) - 1)));
    } else if u.str_eq(op, ".seh_set_fp") {
        b.c(0xe1);
    } else if u.str_eq(op, ".seh_add_fp") and n1 {
        b.c(0xe2);
        b.c(@truncate(u8, eval_off(A, xs, 0) / 8));
    } else if u.str_eq(op, ".seh_nop") {
        b.c(0xe3);
    } else if u.str_eq(op, ".seh_save_next") {
        b.c(0xe6);
    } else if u.str_eq(op, ".seh_pac_sign_lr") {
        b.c(0xfc);
    } else {
        fail(A, u.f1("the directive '%s' is not supported (or lacks its operands)", op));
        return true;
    }
    A.seh_codes.push(b.done());
    return true;
}

fn u64_pick(c: bool, a: u64, b: u64) u64 {
    if c {
        return a;
    }
    return b;
}

// Operand k of an ARM64 .seh_ directive: an offset, a multiple of 8 below 512.
fn eval_off(A: *mut Asm, xs: [][]u8, k: usize) u64 {
    if k >= xs.len {
        return 0;
    }
    let v = eval_const(A, xs[k], "the offset");
    if (v < 0) or (v > 4088) or ((v % 8) != 0) {
        fail(A, u.f1("the offset %s is not a multiple of 8 in range", u.dec(v)));
        return 0;
    }
    return @bit_cast(u64, v);
}

// The procedure's UNWIND_INFO (x86-64).
fn seh_x64_record(A: *mut Asm) void {
    let mut b = u.Buf.init();
    let mut n: u64 = 0;
    for c in A.seh_codes.items() {
        n += @as(u64, c.len) / 2;
    }
    if (n > 255) or (A.seh_prolog > 255) {
        fail(A, "too many unwind codes, or too long a prologue (.seh_*)");
        return;
    }
    b.c(1);  // version 1, no flags
    b.c(@truncate(u8, @bit_cast(u64, A.seh_prolog)));
    b.c(@truncate(u8, n));
    b.c(@truncate(u8, A.seh_frame));
    let mut k = A.seh_codes.len;
    while k > 0 {
        k -= 1;
        b.s(A.seh_codes.get(k));
    }
    if (n & 1) != 0 {
        b.c(0);
        b.c(0);
    }
    A.sehs.push(SehProc.{ sec: A.seh_sec, start: A.seh_start, end: here(A), xdata: b.done() });
}

// The procedure's ARM64 unwind record.
fn seh_a64_record(A: *mut Asm) void {
    // the codes: the prologue's (before its `end`) reversed, then the epilogues'
    let codes = A.seh_codes.items();
    let mut pend: usize = 0;
    while (pend < codes.len) and not u.str_eq(codes[pend], "\xe4") {
        pend += 1;
    }
    let mut c = u.Buf.init();
    let mut k = pend;
    while k > 0 {
        k -= 1;
        c.s(codes[k]);
    }
    c.c(0xe4);
    // (each epilogue: where it starts, and the byte index of its first code)
    let mut epis = u.List.[u64].empty();
    let mut ci = pend + 1;
    let mut e: usize = 0;
    while e < A.seh_epis.len {
        let eoff = @bit_cast(u64, A.seh_epis.get(e));
        let first = @as(usize, @int_cast(usize, A.seh_epis.get(e + 1)));
        while ci < first {
            c.s(codes[ci]);
            ci += 1;
        }
        epis.push((eoff / 4) | (@as(u64, c.len()) << 22));
        e += 2;
    }
    while ci < codes.len {
        c.s(codes[ci]);
        ci += 1;
    }
    while (c.len() % 4) != 0 {
        c.c(0xe3);  // (nop to a word)
    }
    let words = @as(u64, c.len()) / 4;
    let len = (here(A) - A.seh_start) / 4;
    let mut b = u.Buf.init();
    let mut hdr = len & 0x3ffff;
    let mut ext = false;
    if (epis.len < 32) and (words < 32) {
        hdr = hdr | ((@as(u64, epis.len) << 22) | (words << 27));
    } else {
        ext = true;
    }
    for i in @as(u32, 0)..4 {
        b.c(@truncate(u8, hdr >> (8 * i)));
    }
    if ext {
        let w2 = @as(u64, epis.len) | (words << 16);
        for i in @as(u32, 0)..4 {
            b.c(@truncate(u8, w2 >> (8 * i)));
        }
    }
    for w in epis.items() {
        for i in @as(u32, 0)..4 {
            b.c(@truncate(u8, w >> (8 * i)));
        }
    }
    b.s(c.done());
    A.sehs.push(SehProc.{ sec: A.seh_sec, start: A.seh_start, end: here(A), xdata: b.done() });
}

// .file N "name" (the file table of .loc; .file "name" alone names the
// source, which changes nothing) and .loc N line [column ...]: the source
// place of the statements after it (the backends' line information).
fn loc_directive(A: *mut Asm, op: []u8, args: []u8) void {
    let xs = split_args(args);
    if u.str_eq(op, ".file") {
        let ws = macro_words_of(args);
        if (ws.len >= 2) and all_digits(ws[0]) {
            let n = @int_cast(usize, u.atol(ws[0]));
            let mut name = string(A, ws[ws.len - 1]);
            if ws.len >= 3 {
                // (.file N "dir" "name")
                name = u.cat3(string(A, ws[1]), "/", name);
            }
            while A.files.len <= n {
                A.files.push("");
            }
            A.files.set(n, name);
        }
        return;
    }
    let ws = macro_words_of(args);
    if (ws.len < 2) or not all_digits(ws[0]) or not all_digits(ws[1]) {
        _ = xs;
        fail(A, u.f1("'.loc %s' is not a source place (.loc file line)", args));
        return;
    }
    let n = @int_cast(usize, u.atol(ws[0]));
    if (n >= A.files.len) or (A.files.get(n).len == 0) {
        fail(A, u.f1(".loc of file %s, which no .file names", ws[0]));
        return;
    }
    A.loc_file = A.files.get(n);
    A.loc_line = @truncate(i32, u.atol(ws[1]));
}

// The words of s split at spaces (a string is one word).
fn macro_words_of(s: []u8) [][]u8 {
    let mut out = u.List.[[]u8].empty();
    let mut i: usize = 0;
    while i < s.len {
        while (i < s.len) and (is_space(s[i]) or (s[i] == ',')) {
            i += 1;
        }
        if i >= s.len {
            break;
        }
        let st = i;
        if s[i] == '"' {
            i += 1;
            while (i < s.len) and (s[i] != '"') {
                if s[i] == '\\' {
                    i += 1;
                }
                i += 1;
            }
            i += 1;
        } else {
            while (i < s.len) and not is_space(s[i]) and (s[i] != ',') {
                i += 1;
            }
        }
        out.push(s[st..@min(i, s.len)]);
    }
    return out.items();
}
