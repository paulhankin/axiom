// =============================================================================
// asm/obj.ax - file-scope asm into the object the native backends write:
// its sections (.text joins the object's code; the others are sections of
// their own), its labels (symbols: global with .globl, weak with .weak,
// local otherwise) and its relocations.
// =============================================================================
import "../elf.ax" as elf;
import "../ir.ax" as ir;
import "../util.ax" as u;
import "core.ax" as cr;

// The name a label of the text has in the object (numeric labels are
// numbered: `1` defined three times gives three local symbols).
fn sym_name(d: cr.Def) []u8 {
    let mut b = u.Buf.init();
    for c in d.name {
        if c == 2 {
            b.s("$");
        } else {
            b.c(c);
        }
    }
    if d.numeric {
        return u.cat2(".Lasm$", b.done());
    }
    return b.done();
}

/// A procedure of the text (its .cfi_* directives) placed in the object:
/// a local symbol at its start, its size and call frame instructions, for
/// the backend's frame description (dwarf.ax add_asm_fde).
pub struct FileProc {
    sym: u32,
    size: u64,
    prog: []u8,
    simple: bool,
    signal: bool,
    x: cr.ProcX,  // (its personality's and LSDA's symbols: psym_i, lsym_i)
    psym_i: u32,
    lsym_i: u32,
}

/// The procedures of the file-scope asm added to the object being written
/// (add_file), in order; the backend gives them to its debug information
/// (dwarf.ax add_asm_fde) and clears the list.
pub let mut procs: u.List.[FileProc] = u.List.[FileProc].{ data: @ptr_from_int(*mut FileProc, 0), len: 0, cap: 0 };

/// A procedure's Windows unwind record (.seh_*): a local symbol at its
/// start, its size, its .xdata bytes, for the backend's .pdata entry.
pub struct FileSeh {
    sym: u32,
    size: u64,
    xdata: []u8,
}

pub let mut sehs: u.List.[FileSeh] = u.List.[FileSeh].{ data: @ptr_from_int(*mut FileSeh, 0), len: 0, cap: 0 };

// The object's named symbols (all, local ones too): name -> index + 1, for
// the symbols of internal linkage asm text names (Blob.aliases); `scanned`:
// how many of obj's symbols the map has seen.
let mut named: u.SymMap.[u32] = u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u32, 0),
                                                 cap: 0, len: 0 };
let mut named_obj: *mut elf.Obj = @ptr_from_int(*mut elf.Obj, 0);
let mut scanned: usize = 0;

/// The symbol of name `n` in the alias list of a blob (name, symbol name,
/// ...): the object's symbol of that name, or -1.
pub fn alias_sym(obj: *mut elf.Obj, aliases: [][]u8, n: []u8) i64 {
    let mut k: usize = 0;
    while (k + 1) < aliases.len {
        if u.str_eq(aliases[k], n) {
            if named_obj != obj {
                named_obj = obj;
                named = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
                scanned = 0;
            }
            while scanned < obj.syms.len {
                let s = obj.syms.get(scanned);
                if (s.name.len > 0) and (s.sec >= 0) {
                    named.put(u.intern(s.name), @truncate(u32, scanned) + 1);
                }
                scanned += 1;
            }
            let x = named.get(u.intern(aliases[k + 1]));
            if x != 0 {
                return @as(i64, x - 1);
            }
        }
        k += 2;
    }
    return -1;
}

/// A part of an assembly source's code, from one of its labels to the next
/// (add_file), for the line information: its symbol (at its start), name,
/// size, and rows (offset << 32 | ir.src_loc, as dwarf.Func's).
pub struct FileFunc {
    sym: u32,
    name: []u8,
    external: bool,
    size: u64,
    rows: []u64,
}

/// An error add_file found (a global symbol defined twice), or "": the backend reports it.
pub let mut add_error: []u8 = "";

pub let mut funcs: u.List.[FileFunc] = u.List.[FileFunc].{ data: @ptr_from_int(*mut FileFunc, 0), len: 0, cap: 0 };

/// Adds assembled file-scope asm A to obj, whose code section is `text`;
/// `aliases`: its blob's (the names of internal linkage in it); `file_id`:
/// the assembly source's file, whose lines its code's line information
// The object's symbol for name `nm` of text A (a relocation's, a
// procedure's personality's or LSDA's): its label's (syms: each Def's
// symbol, or -1), an alias's, or an undefined one.
fn name_sym(obj: *mut elf.Obj, A: *mut cr.Asm, syms: []i64, aliases: [][]u8, nm: []u8) u32 {
    let d = A.names.get(u.intern(nm));
    if (d != 0) and (syms[@int_cast(usize, d - 1)] >= 0) {
        return @truncate(u32, @bit_cast(u64, syms[@int_cast(usize, d - 1)]));
    }
    let mut sym: u32 = 0;
    let mut found = false;
    for k in 0..A.defs.len {
        if (syms[k] >= 0) and u.str_eq(A.defs.get(k).name, nm) {
            sym = @truncate(u32, @bit_cast(u64, syms[k]));
            found = true;
        }
    }
    if found {
        return sym;
    }
    let al = alias_sym(obj, aliases, nm);
    if al >= 0 {
        return @truncate(u32, @bit_cast(u64, al));
    }
    return elf.ext_sym(obj, u.perm_dup(nm), false);
}

/// gives (.loc's where it says), or -1.
pub fn add_file(obj: *mut elf.Obj, text: i32, A: *mut cr.Asm, aliases: [][]u8, file_id: i32) void {
    // sections: where each of A's starts in obj's
    let secmap = u.newn.[i32](A.secs.len + 1);
    let base = u.newn.[u64](A.secs.len + 1);
    for k in 0..A.secs.len {
        let s = A.secs.at(k);
        let n = @as(u64, s.data.len);
        if (s.kind == elf.S_TEXT) and u.str_eq(s.name, ".text") {
            let os = obj.secs.get(@int_cast(usize, text));
            os.data.align(@truncate(usize, s.align));
            if s.align > os.align {
                os.align = s.align;
            }
            secmap[k] = text;
            base[k] = @as(u64, os.data.len());
            os.data.put(s.data.items());
            continue;
        }
        _ = n;
        let ns = elf.add_sec(obj, u.perm_dup(s.name), s.kind, s.align);
        let os = obj.secs.get(@int_cast(usize, ns));
        if (s.kind == elf.S_BSS) or (s.kind == elf.S_TBSS) {
            os.size = s.size;
        } else {
            os.data.put(s.data.items());
        }
        secmap[k] = ns;
        base[k] = 0;
    }
    // labels: the global ones, the local ones but .L and numeric labels,
    // and those relocations refer to
    let syms = u.newn.[i64](A.defs.len + 1);
    let wanted = u.newn.[bool](A.defs.len + 1);
    for k in 0..A.defs.len {
        let d = A.defs.get(k);
        wanted[k] = d.global or d.weak or not (d.numeric or u.starts(d.name, ".L"));
    }
    for r in A.relocs.items() {
        for k in 0..A.defs.len {
            if u.str_eq(A.defs.get(k).name, r.name) {
                wanted[k] = true;
            }
        }
    }
    // (and those a procedure's personality and LSDA name)
    for p in A.procs.items() {
        for k in 0..A.defs.len {
            let n = A.defs.get(k).name;
            if (p.x.has_p and u.str_eq(n, p.x.psym)) or (p.x.has_l and u.str_eq(n, p.x.lsym)) {
                wanted[k] = true;
            }
        }
    }
    for k in 0..A.defs.len {
        syms[k] = -1;
        let d = A.defs.get(k);
        if d.tmp or not d.defined or d.abs or (d.sec < 0) or not wanted[k] {
            continue;
        }
        let si = @int_cast(usize, d.sec);
        let mut bind = elf.B_LOCAL;
        if d.weak {
            bind = elf.B_WEAK;
        } else if d.global {
            bind = elf.B_GLOBAL;
        }
        let mut size: u64 = 0;
        if d.has_size {
            size = @bit_cast(u64, d.size);
        }
        let mut ty = d.ty;
        if (ty == elf.T_NOTYPE) and (A.secs.at(si).kind == elf.S_TEXT) {
            ty = elf.T_FUNC;  // (a label in code; untyped ones would be written as objects)
        }
        if bind != elf.B_LOCAL {
            let prev = obj.symmap.get(u.intern(sym_name(d)));
            if (prev != 0) and (obj.syms.get(@as(usize, prev - 1)).sec >= 0) and (bind == elf.B_GLOBAL) and
               (obj.syms.get(@as(usize, prev - 1)).bind == elf.B_GLOBAL) {
                add_error = u.f1("the symbol '%s' that assembly defines is defined elsewhere in the program too",
                                 d.name);
            }
        }
        let s = elf.add_sym(obj, elf.Sym.{ name: u.perm_dup(sym_name(d)), sec: secmap[si], value: base[si] + d.off,
                                           size: size, bind: bind, ty: ty, hidden: false, protected: false });
        syms[k] = @as(i64, s);
        if (bind == elf.B_LOCAL) and not d.numeric {
            use_obj(obj);
            note_local(d.name, s);
        }
    }
    // relocations
    for r in A.relocs.items() {
        let si = @int_cast(usize, r.sec);
        let sym = name_sym(obj, A, syms, aliases, r.name);
        let os = obj.secs.get(@int_cast(usize, secmap[si]));
        os.relocs.push(elf.Rel.{ off: base[si] + r.off, ty: r.ty, sym: sym, addend: r.addend });
    }
    if file_id >= 0 {
        file_lines(obj, text, A, secmap, base, syms, file_id);
    }
    // procedures
    for p in A.procs.items() {
        let si = @int_cast(usize, p.sec);
        let s = elf.add_sym(obj, elf.Sym.{ name: "", sec: secmap[si], value: base[si] + p.start, size: 0,
                                           bind: elf.B_LOCAL, ty: elf.T_NOTYPE, hidden: false, protected: false });
        let mut ps: u32 = 0;
        let mut ls: u32 = 0;
        if p.x.has_p {
            ps = name_sym(obj, A, syms, aliases, p.x.psym);
        }
        if p.x.has_l {
            ls = name_sym(obj, A, syms, aliases, p.x.lsym);
        }
        procs.push(FileProc.{ sym: s, size: p.end - p.start, prog: u.perm_dup(p.prog), simple: p.simple,
                              signal: p.signal, x: p.x, psym_i: ps, lsym_i: ls });
    }
    for p in A.sehs.items() {
        let si = @int_cast(usize, p.sec);
        let s = elf.add_sym(obj, elf.Sym.{ name: "", sec: secmap[si], value: base[si] + p.start, size: 0,
                                           bind: elf.B_LOCAL, ty: elf.T_NOTYPE, hidden: false, protected: false });
        sehs.push(FileSeh.{ sym: s, size: p.end - p.start, xdata: u.perm_dup(p.xdata) });
    }
}

// -----------------------------------------------------------------------------
// Inline templates' symbols and sections. A template's .text bytes are its
// function's code (the backend's); its other sections' bytes (.pushsection,
// .section ... .popsection, .previous) go into the object's sections of those
// names, after what is there; its named labels (but .L and numeric ones)
// become local symbols, its .globl and .weak ones global and weak symbols;
// relocations name the function's symbol (a label in its code), a section's
// symbol (a label in another section) or the symbol named. A backend calls
// inline_pass at the start of each encoding pass of a function, inline_asm
// for each template (the text relocations it returns, from the template's
// start, are the backend's to add), and inline_place once the function's
// place in its section is final.
// -----------------------------------------------------------------------------
/// A relocation in a template's code (from its start).
pub struct TRel {
    off: u64,
    ty: u32,
    sym: u32,
    addend: i64,
}

struct Side {
    sec: i32,  // the object's section
    off: u64,  // where the bytes go in it
    data: []u8,
    size: u64,  // (bss: no data)
}

struct PSym {
    name: []u8,
    sec: i32,  // the object's section, or -1: the function's code (off from its start)
    off: u64,
    bind: u8,
    ty: u8,
    size: u64,
}

let mut sides: u.List.[Side] = u.List.[Side].{ data: @ptr_from_int(*mut Side, 0), len: 0, cap: 0 };
let mut side_rels: u.List.[elf.Rel] = u.List.[elf.Rel].{ data: @ptr_from_int(*mut elf.Rel, 0), len: 0, cap: 0 };
let mut side_rsec: u.List.[i32] = u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 };
let mut psyms: u.List.[PSym] = u.List.[PSym].{ data: @ptr_from_int(*mut PSym, 0), len: 0, cap: 0 };
// (each object section's next free offset in this pass, and its local symbol)
let mut next_off: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };
let mut sec_syms: u.List.[i64] = u.List.[i64].{ data: @ptr_from_int(*mut i64, 0), len: 0, cap: 0 };
let mut cur_obj: *mut elf.Obj = @ptr_from_int(*mut elf.Obj, 0);
// the names of the local symbols asm defines in the object (file-scope asm's
// labels, templates' labels): name -> symbol + 1 (0: none; a name defined
// twice: DUP), for references by name from elsewhere (resolve)
let mut locals: u.SymMap.[u32] = u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u32, 0),
                                                  cap: 0, len: 0 };
const DUP: u32 = 0xffff_ffff;
const DUP_SIZE: u64 = 0xffff_ffff_ffff_fff1;  // (a global symbol's size: defined twice)

fn use_obj(obj: *mut elf.Obj) void {
    if cur_obj != obj {
        cur_obj = obj;
        locals = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
        sec_syms.clear();
        next_off.clear();
    }
}

fn note_local(name: []u8, s: u32) void {
    let k = u.intern(name);
    if locals.get(k) != 0 {
        locals.put(k, DUP);
        return;
    }
    locals.put(k, s + 1);
}

/// The start of an encoding pass of a function: what the templates encoded
/// before it is forgotten.
pub fn inline_pass(obj: *mut elf.Obj) void {
    use_obj(obj);
    sides.clear();
    side_rels.clear();
    side_rsec.clear();
    psyms.clear();
    next_off.clear();
}

fn sec_sym(obj: *mut elf.Obj, sec: i32) u32 {
    let k = @int_cast(usize, sec);
    while sec_syms.len <= k {
        sec_syms.push(-1);
    }
    if sec_syms.get(k) < 0 {
        sec_syms.set(k, @as(i64, elf.add_sym(obj, elf.Sym.{ name: "", sec: sec, value: 0, size: 0, bind: elf.B_LOCAL,
                                                            ty: elf.T_NOTYPE, hidden: false, protected: false })));
    }
    return @truncate(u32, @bit_cast(u64, sec_syms.get(k)));
}

// The object's section of a template's section (made if new), and where
// this template's bytes of it go (aligned).
fn side_place(obj: *mut elf.Obj, s: *cr.Sec, at: *mut u64) i32 {
    let mut idx: i32 = -1;
    for k in 0..obj.secs.len {
        if u.str_eq(obj.secs.get(k).name, s.name) {
            idx = @int_cast(i32, k);
        }
    }
    if idx < 0 {
        // (in permanent memory: functions are compiled in scratch scopes)
        let ns = u.perm_new.[elf.Sec]();
        ns.name = u.perm_dup(s.name);
        ns.kind = s.kind;
        ns.align = @max(s.align, 1);
        obj.secs.push(ns);
        idx = @int_cast(i32, obj.secs.len - 1);
    }
    let os = obj.secs.get(@int_cast(usize, idx));
    if s.align > os.align {
        os.align = s.align;
    }
    let k = @int_cast(usize, idx);
    while next_off.len <= k {
        next_off.push(0xffff_ffff_ffff_ffff);
    }
    if next_off.get(k) == 0xffff_ffff_ffff_ffff {
        next_off.set(k, elf.sec_size(os));
    }
    let al = @max(s.align, 1);
    let o = (next_off.get(k) + al - 1) & ~(al - 1);
    at.* = o;
    let mut n = @as(u64, s.data.len);
    if (s.kind == elf.S_BSS) or (s.kind == elf.S_TBSS) {
        n = s.size;
    }
    next_off.set(k, o + n);
    return idx;
}

/// A template A assembled at function-relative offset `start` of the
/// function whose symbol is `fsym`: its other sections' bytes and symbols
/// noted for inline_place; the relocations of its code returned. `sym_of`
/// is the backend's symbol of a name the template does not define.
pub fn inline_asm(obj: *mut elf.Obj, A: *mut cr.Asm, fsym: u32, start: u64, sym_of: fn([]u8) u32) []TRel {
    use_obj(obj);
    let n = A.secs.len;
    let osec = u.newn.[i32](n + 1);  // -1: the function's code
    let obase = u.newn.[u64](n + 1);
    for k in 0..n {
        let s = A.secs.at(k);
        osec[k] = -1;
        obase[k] = start;
        if (k == 0) or ((s.kind == elf.S_TEXT) and u.str_eq(s.name, ".text")) {
            if k != 0 {
                osec[k] = -2;  // (.text again, after a .section: not supported, below)
            }
            continue;
        }
        let mut at: u64 = 0;
        osec[k] = side_place(obj, s, &mut at);
        obase[k] = at;
        sides.push(Side.{ sec: osec[k], off: at, data: u.perm_dup(s.data.items()), size: s.size });
    }
    // the template's labels: their places (a symbol's, for a relocation to one)
    let byname = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    let mut bn = byname;
    for k in 0..A.defs.len {
        let d = A.defs.get(k);
        if d.intext or d.defined {
            bn.put(u.intern(d.name), @int_cast(i32, k) + 1);
        }
        if not d.defined or d.tmp or d.abs or (d.sec < 0) {
            continue;
        }
        let local = not d.global and not d.weak;
        if local and (d.numeric or u.starts(d.name, ".L")) {
            continue;
        }
        let si = @int_cast(usize, d.sec);
        let mut bind = elf.B_LOCAL;
        if d.weak {
            bind = elf.B_WEAK;
        } else if d.global {
            bind = elf.B_GLOBAL;
        }
        // (a label in a function's code is no function of its own: its type is .type's)
        let ty = d.ty;
        let mut size: u64 = 0;
        if d.has_size {
            size = @bit_cast(u64, d.size);
        }
        psyms.push(PSym.{ name: u.perm_dup(d.name), sec: osec[si], off: obase[si] + d.off, bind: bind, ty: ty,
                          size: size });
    }
    let mut out = u.List.[TRel].empty();
    for r in A.relocs.items() {
        let si = @int_cast(usize, r.sec);
        if osec[si] == -2 {
            cr.fail(A,
                    "inline assembly that returns to .text after another section (use .pushsection and .popsection, or .previous)");
            return out.items();
        }
        // the target: a label of the template, or a symbol of the object
        let mut sym: u32 = 0;
        let mut add = r.addend;
        let di = bn.get(u.intern(r.name));
        if (di > 0) and (A.defs.get(@int_cast(usize, di - 1)).sec >= 0) and
           not A.defs.get(@int_cast(usize, di - 1)).abs {
            let d = A.defs.get(@int_cast(usize, di - 1));
            let ts = @int_cast(usize, d.sec);
            if osec[ts] == -1 {
                sym = fsym;
            } else {
                sym = sec_sym(obj, osec[ts]);
            }
            add = add + @bit_cast(i64, obase[ts] + d.off);
        } else {
            sym = sym_of(r.name);
        }
        if osec[si] == -1 {
            out.push(TRel.{ off: r.off, ty: r.ty, sym: sym, addend: add });
        } else {
            side_rels.push(elf.Rel.{ off: obase[si] + r.off, ty: r.ty, sym: sym, addend: add });
            side_rsec.push(osec[si]);
        }
    }
    return out.items();
}

/// The function's templates' bytes of other sections and their symbols into
/// the object, the function being placed at `fbase` in its code section
/// `text` (once its encoding is final).
pub fn inline_place(obj: *mut elf.Obj, text: i32, fbase: u64) void {
    use_obj(obj);
    for s in sides.items() {
        let os = obj.secs.get(@int_cast(usize, s.sec));
        if (os.kind == elf.S_BSS) or (os.kind == elf.S_TBSS) {
            if (s.off + s.size) > os.size {
                os.size = s.off + s.size;
            }
            continue;
        }
        while @as(u64, os.data.len()) < s.off {
            os.data.u8_(0);
        }
        os.data.put(s.data);
    }
    for k in 0..side_rels.len {
        let os = obj.secs.get(@int_cast(usize, side_rsec.get(k)));
        os.relocs.push(side_rels.get(k));
    }
    for p in psyms.items() {
        let mut sec = p.sec;
        let mut v = p.off;
        if sec == -1 {
            sec = text;
            v = fbase + p.off;
        }
        let s = elf.add_sym(obj, elf.Sym.{ name: p.name, sec: sec, value: v, size: p.size, bind: p.bind, ty: p.ty,
                                           hidden: false, protected: false });
        if p.bind == elf.B_LOCAL {
            note_local(p.name, s);
        } else if obj.syms.get(@as(usize, s)).value != v {
            // (a global defined again: the template's function was copied, by inlining or unrolling)
            obj.syms.at(@as(usize, s)).size = DUP_SIZE;
        }
    }
    inline_pass(obj);
}

/// References by name to the local symbols asm defines (from C, from other
/// templates, from file-scope asm: undefined symbols of the object of those
/// names) are to them; an error message if a name referred to so is
/// defined twice (a template copied), else "".
pub fn resolve(obj: *mut elf.Obj) []u8 {
    use_obj(obj);
    let map = u.newn.[u32](obj.syms.len + 1);
    let mut any = false;
    for k in 0..obj.syms.len {
        map[k] = @truncate(u32, k);
        let s = obj.syms.get(k);
        if (s.sec < 0) and (s.name.len > 0) {
            let l = locals.get(u.intern(s.name));
            if l == DUP {
                return u.f1("the symbol '%s' that inline assembly defines is defined more than once (its asm statement was copied: give the label a number, `1:`, or `%=`)",
                            s.name);
            }
            if l != 0 {
                map[k] = l - 1;
                any = true;
                // (and the reference's own entry, which nothing names now, a copy of the definition)
                let d = obj.syms.get(@as(usize, l - 1));
                obj.syms.at(k).* = d;
            }
        }
        if (s.sec >= 0) and (s.size == DUP_SIZE) and (s.bind != elf.B_LOCAL) {
            return u.f1("the symbol '%s' that inline assembly defines is defined more than once (its asm statement was copied)",
                        s.name);
        }
    }
    if not any {
        return "";
    }
    for k in 0..obj.secs.len {
        let os = obj.secs.get(k);
        for j in 0..os.relocs.len {
            let r = os.relocs.at(j);
            r.sym = map[@as(usize, r.sym)];
        }
    }
    return "";
}

// The line information of an assembly source's code (A's .text): each part
// from a label that is a symbol to the next, with a row for each statement
// (its line in the source, or what .loc says).
fn file_lines(obj: *mut elf.Obj, text: i32, A: *mut cr.Asm, secmap: []i32, base: []u64, syms: []i64,
              file_id: i32) void {
    let mut ti: i32 = -1;
    for k in 0..A.secs.len {
        if secmap[k] == text {
            ti = @int_cast(i32, k);
        }
    }
    if ti < 0 {
        return;
    }
    let tb = base[@int_cast(usize, ti)];
    let end = tb + @as(u64, A.secs.at(@int_cast(usize, ti)).data.len);
    // the parts' starts: the text's start, and each label symbol in it (in order)
    let mut starts = u.List.[u64].empty();
    let mut names = u.List.[[]u8].empty();
    let mut ext = u.List.[bool].empty();
    let mut ss = u.List.[i64].empty();
    starts.push(tb);
    names.push(u.file_of(file_id).display);
    ext.push(false);
    ss.push(-1);
    for k in 0..A.defs.len {
        let d = A.defs.get(k);
        if (syms[k] < 0) or (d.sec != ti) {
            continue;
        }
        let at = tb + d.off;
        let mut j = starts.len;
        while (j > 0) and (starts.get(j - 1) > at) {
            j -= 1;
        }
        if (j > 0) and (starts.get(j - 1) == at) {
            names.set(j - 1, d.name);
            ext.set(j - 1, d.global or d.weak);
            ss.set(j - 1, syms[k]);
            continue;
        }
        starts.push(0);
        names.push("");
        ext.push(false);
        ss.push(-1);
        let mut m = starts.len - 1;
        while m > j {
            starts.set(m, starts.get(m - 1));
            names.set(m, names.get(m - 1));
            ext.set(m, ext.get(m - 1));
            ss.set(m, ss.get(m - 1));
            m -= 1;
        }
        starts.set(j, at);
        names.set(j, d.name);
        ext.set(j, d.global or d.weak);
        ss.set(j, syms[k]);
    }
    for p in 0..starts.len {
        let lo = starts.get(p);
        let mut hi = end;
        if (p + 1) < starts.len {
            hi = starts.get(p + 1);
        }
        if hi <= lo {
            continue;
        }
        let mut rows = u.List.[u64].empty();
        for st in A.stmts.items() {
            if (st.sec != ti) or (st.op.len == 0) {
                continue;
            }
            let at = tb + st.at;
            if (at < lo) or (at >= hi) {
                continue;
            }
            let mut src = ir.src_loc(file_id, st.line);
            if st.lfile.len > 0 {
                src = ir.src_loc(loc_file_id(st.lfile), st.lline);
            }
            rows.push(((at - lo) << 32) | @as(u64, src));
        }
        let mut sym = ss.get(p);
        if sym < 0 {
            sym = @as(i64, elf.add_sym(obj, elf.Sym.{ name: "", sec: text, value: lo, size: 0, bind: elf.B_LOCAL,
                                                      ty: elf.T_NOTYPE, hidden: false, protected: false }));
        }
        let rs = u.perm_newn.[u64](rows.len + 1);
        for k in 0..rows.len {
            rs[k] = rows.get(k);
        }
        funcs.push(FileFunc.{ sym: @truncate(u32, @bit_cast(u64, sym)), name: u.perm_dup(names.get(p)),
                              external: ext.get(p), size: hi - lo, rows: rs[0..rows.len] });
    }
}

// The file (u.g_files) of a name .file gives: the file's, or one of that
// name with no text when there is none (a source the assembly came from).
let mut loc_files: u.SymMap.[i32] = u.SymMap.[i32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0), cap: 0, len: 0 };

fn loc_file_id(name: []u8) i32 {
    let k = u.intern(name);
    let x = loc_files.get(k);
    if x != 0 {
        return x - 1;
    }
    let mut f = u.load_file(name, u.nosym());
    if u.isnil(f) {
        f = u.perm_new.[u.SourceFile]();
        f.path = u.perm_dup(name);
        f.display = f.path;
        f.text = "";
        f.id = @int_cast(i32, u.g_files.len);
        u.g_files.push(f);
    }
    loc_files.put(k, f.id + 1);
    return f.id;
}

// -----------------------------------------------------------------------------
// Absolute addresses in move-wide groups on Mach-O and PE
// -----------------------------------------------------------------------------
/// On Mach-O and PE (the images are position-independent, loaded at an
/// address only the loader knows, and their formats have no relocation of
/// a move-wide group), the complete absolute sequence of an address,
/// `movz xd, #:abs_g3:s; movk xd, #:abs_g2_nc:s; movk xd, #:abs_g1_nc:s;
/// movk xd, #:abs_g0_nc:s` (the four groups of one symbol and addend, in
/// any order, to one register, the movz first, four consecutive
/// instructions), becomes `adrp xd, s; add xd, xd, :lo12:s; nop; nop`,
/// which gives the same value wherever the image is. Returns why another
/// absolute move-wide group cannot be ("" if none is left).
pub fn relax_abs_movw(obj: *mut elf.Obj) []u8 {
    for k in 0..obj.secs.len {
        let s = obj.secs.get(k);
        let rs = s.relocs.items();
        let drop = u.newn.[bool](rs.len + 1);
        let mut any = false;
        for i in 0..rs.len {
            let r = rs[i];
            if not is_uabs(r.ty) or drop[i] {
                continue;
            }
            // the other three, at the next three instructions
            let mut at: [4]usize = [i, 0, 0, 0];
            let mut seen: u32 = @as(u32, 1) << uabs_group(r.ty);
            let mut ok = true;
            for j in @as(usize, 1)..4 {
                let mut f: i64 = -1;
                for x in 0..rs.len {
                    let q = rs[x];
                    if is_uabs(q.ty) and not drop[x] and (q.off == (r.off + @as(u64, 4 * j))) and
                       same_sym(obj, q.sym, r.sym) and (q.addend == r.addend) {
                        f = @int_cast(i64, x);
                    }
                }
                if f < 0 {
                    ok = false;
                    break;
                }
                at[j] = @int_cast(usize, f);
                seen = seen | (@as(u32, 1) << uabs_group(rs[at[j]].ty));
            }
            if not ok or (seen != 15) {
                continue;
            }
            let d = s.data.view();
            let w0 = rd32(d, r.off);
            let rd = w0 & 0x1f;
            if (w0 & 0xff80_0000) != 0xd280_0000 {
                continue;  // (the first a movz of a 64-bit register)
            }
            for j in @as(usize, 1)..4 {
                let w = rd32(d, r.off + @as(u64, 4 * j));
                if ((w & 0xff80_0000) != 0xf280_0000) or ((w & 0x1f) != rd) {
                    ok = false;
                }
            }
            if not ok {
                continue;
            }
            wr32(d, r.off, 0x9000_0000 | rd);
            wr32(d, r.off + 4, 0x9100_0000 | (rd << 5) | rd);
            wr32(d, r.off + 8, 0xd503_201f);
            wr32(d, r.off + 12, 0xd503_201f);
            rs[at[0]].ty = elf.R_AARCH64_ADR_PREL_PG_HI21;
            rs[at[1]].ty = elf.R_AARCH64_ADD_ABS_LO12_NC;
            rs[at[1]].off = r.off + 4;  // (the add's: the second instruction, whichever group it had)
            drop[at[2]] = true;
            drop[at[3]] = true;
            any = true;
        }
        if any {
            let mut kept = u.List.[elf.Rel].empty();
            for i in 0..rs.len {
                if not drop[i] {
                    kept.push(rs[i]);
                }
            }
            s.relocs.clear();
            for x in kept.items() {
                s.relocs.push(x);
            }
        }
        for r in s.relocs.items() {
            let sy = obj.syms.get(@as(usize, r.sym));
            let dbg = (s.kind == elf.S_DEBUG) or
                      ((sy.sec >= 0) and (obj.secs.get(@int_cast(usize, sy.sec)).kind == elf.S_DEBUG));
            if ((r.ty == elf.R_AARCH64_ABS32) or (r.ty == elf.R_AARCH64_ABS16)) and not dbg {
                return u.f1("an address in %s bits (.word, .hword or .short of a symbol): a Mach-O or PE image is loaded above 4 GiB, at an address only the loader knows (an address is a .quad; a difference of two, `.word a - b`, fits)",
                            u.pick(r.ty == elf.R_AARCH64_ABS32, "32", "16"));
            }
            if is_uabs(r.ty) or ((r.ty >= 270) and (r.ty <= 272)) {
                return "an absolute address in a move-wide group (:abs_g*:) that is not the four groups of one address to one register (movz, then three movk): Mach-O and PE images have no relocation of it";
            }
        }
    }
    return "";
}

// (one symbol: the same entry, or entries of one name)
fn same_sym(obj: *elf.Obj, a: u32, b: u32) bool {
    if a == b {
        return true;
    }
    let x = obj.syms.get(@as(usize, a));
    let y = obj.syms.get(@as(usize, b));
    return (x.name.len > 0) and u.str_eq(x.name, y.name) and (x.sec == y.sec) and (x.value == y.value);
}

fn is_uabs(t: u32) bool {
    return (t >= 263) and (t <= 269);  // MOVW_UABS_G0 .. G3 (AAELF64)
}

fn uabs_group(t: u32) u32 {
    return (t - 263) / 2;  // G0 263 264, G1 265 266, G2 267 268, G3 269
}

fn rd32(d: []u8, off: u64) u64 {
    let o = @truncate(usize, off);
    return @as(u64, d[o]) | (@as(u64, d[o + 1]) << 8) | (@as(u64, d[o + 2]) << 16) | (@as(u64, d[o + 3]) << 24);
}

fn wr32(d: []mut u8, off: u64, x: u64) void {
    let o = @truncate(usize, off);
    d[o] = @truncate(u8, x);
    d[o + 1] = @truncate(u8, x >> 8);
    d[o + 2] = @truncate(u8, x >> 16);
    d[o + 3] = @truncate(u8, x >> 24);
}
