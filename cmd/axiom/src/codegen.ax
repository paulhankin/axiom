// =============================================================================
// codegen.ax - lowering of the checked AST to IR (ir.ax): functions,
// statements and expressions.
//
// Generic functions are monomorphized here: each (decl, type arguments)
// pair becomes one IR function, generated from the shared, already
// type-checked body by substituting the type arguments. The context and
// small helpers are cgctx.ax's, the runtime's traps and shadow stack
// cgrt.ax's, the instances' symbols, globals, strings and arithmetic
// cgbase.ax's, the builtins cgbuiltin.ax's; a run (codegen_program) is
// cgmain.ax's.
// =============================================================================
import "ast.ax" as ast;
import "axdebug.ax" as axd;
import "cgbase.ax" as cgb;
import "cgctx.ax" as cx;
import "cgrt.ax" as cgrt;
import "diag.ax" as dg;
import "ir.ax" as ir;
import "lexer.ax" as lx;
import "sema.ax" as sema;
import "semapost.ax" as spost;
import "target.ax" as tg;
import "types.ax" as ty;
import "util.ax" as u;
import part "cgbuiltin.ax";

fn type_mentions_error(t: *mut ast.Type) bool {
    let k = t.kind;
    if (k == ast.TY_ERROR) or (k == ast.TY_ERRUNION) {
        return true;
    }
    if (k == ast.TY_ARRAY) or (k == ast.TY_OPT) {
        return type_mentions_error(t.elem);
    }
    if k == ast.TY_STRUCT {
        for i in 0..t.decl.fields.len {
            if type_mentions_error(ty.type_field(t, i)) {
                return true;
            }
        }
        return false;
    }
    if k == ast.TY_UNION {
        return true;  // conservatively
    }
    return false;
}

// ---------------------------------------------------------------------------
// Function instances
// ---------------------------------------------------------------------------
// The callee of a direct call from the current function. An inline function
// is compiled with its caller's extensions (spec §9.5): one instance per set
// of extensions it is called with, so that @target_has, and lowering that
// depends on extensions, answer for the caller (a version of an @features or
// @multiversion function) into which it is inlined.
fn get_callee(d: *mut ast.Decl, gargs: []mut *mut ast.Type) *mut cx.FnInst {
    if (d.kind == ast.D_FN) and d.is_inline {
        return cgb.get_inst_feats(d, gargs, tg.g_features);
    }
    return cgb.get_inst(d, gargs);
}

// Version k of a function with @features or @multiversion: its body
// compiled with extensions `feats`, under the name of the dispatcher (fi)
// with a suffix, and shown under the function's own name in traces.
fn get_version(fi: *mut cx.FnInst, k: usize, feats: u64) *mut cx.FnInst {
    let key = u.intern(u.f2("%s#v%s", fi.key, u.zdec(k)));
    let found = cx.S.inst_map.get(key);
    if u.notnil(found) {
        return found;
    }
    let v = u.new.[cx.FnInst]();
    v.decl = fi.decl;
    v.gargs = fi.gargs;
    v.key = key;
    v.fnty = fi.fnty;
    v.llty = fi.llty;
    v.sret = fi.sret;
    v.display = fi.display;
    v.feats = feats;
    let mut suffix = tg.features_string(feats & ~cx.S.build_features);
    if suffix.len == 0 {
        suffix = "base";
    }
    v.fnv = ir.add_function(cx.M, u.f2("%s.%s", ir.fnp_of(fi.fnv).name, suffix), v.llty).val;
    ir.fnp_of(v.fnv).features = feats;
    ir.fnp_of(v.fnv).has_features = true;
    cgrt.set_linkage(v.fnv, ir.LINK_INTERNAL);
    cgb.add_ext_attrs(v.fnv, v.fnty, v.sret, false);
    if u.notnil(cx.S.pending_tail) {
        cx.S.pending_tail.next = v;
    } else {
        cx.S.pending_head = v;
    }
    cx.S.pending_tail = v;
    cx.S.inst_map.put(key, v);
    return v;
}

// The body of a function with @features or @multiversion: the first
// version whose extensions the running processor has (the build's own
// count as present), else the @multiversion fallback (the target's
// extensions only), or trap T0013 for @features.
fn gen_dispatch(fi: *mut cx.FnInst) void {
    let d = fi.decl;
    let f = fi.fnv;
    cx.at_end(ir.append_block(ir.fnp_of(f), "entry"));
    cgrt.set_span(d.attr_span);
    let nparams = ir.fnp_of(f).params.len;
    let args = u.newn.[*mut ir.Value](nparams + 1);
    for i in 0..nparams {
        args[i] = cgrt.param(f, @int_cast(u32, i));
    }
    let base = fi.feats;
    let mut k: usize = 0;
    let mut done = false;
    for set in d.feat_sets {
        k += 1;
        if (set == spost.NO_VERSION) or done {
            continue;
        }
        let want = base | set;
        let v = get_version(fi, k, want);
        let missing = want & ~tg.g_features;
        if missing == 0 {
            dispatch_call(fi, v, args[0..nparams]);
            done = true;
            continue;
        }
        let yes = ir.append_block(ir.fnp_of(f), "version");
        let no = ir.append_block(ir.fnp_of(f), "next");
        cx.condbr(cgb.cpu_has_bits(missing), yes, no);
        cx.at_end(yes);
        dispatch_call(fi, v, args[0..nparams]);
        cx.at_end(no);
    }
    if done {
        return;
    }
    if d.attr == ast.ATTR_MULTIVERSION {
        dispatch_call(fi, get_version(fi, 0, base), args[0..nparams]);
    } else {
        cgrt.call_trap_site(cgrt.site_record(cgrt.T_CPU, d.attr_span));
        ir.unreachable(cx.B);
    }
}

fn dispatch_call(fi: *mut cx.FnInst, v: *mut cx.FnInst, args: []mut *mut ir.Value) void {
    let r = cx.call(fi.llty, v.fnv, args);
    cgb.add_ext_attrs(r, fi.fnty, fi.sret, true);
    if fi.llty.ret.kind == ir.T_VOID {
        ir.ret_void(cx.B);
    } else {
        ir.ret(cx.B, r);
    }
}

fn subst_gargs(g: []mut *mut ast.Type) []mut *mut ast.Type {
    if g.len == 0 {
        return ty.no_types();
    }
    let r = u.newn.[*mut ast.Type](g.len);
    for i in 0..g.len {
        r[i] = cx.ct(g[i]);
    }
    return r;
}

// ---------------------------------------------------------------------------
// Defers and control flow
// ---------------------------------------------------------------------------
// Runs the pending deferred statements above `down_to`, innermost first.
// `err` says whether control is leaving by returning an error: nil where it
// is not (a block's end, break, continue, so errdefers are skipped), an i1
// where the return value decides at run time, or `always` where it is
// known (`e!`).
fn emit_defers(down_to: usize, err: *mut ir.Value, always: bool) void {
    let mut i = cx.F.defers.len;
    while i > down_to {
        i -= 1;
        if cx.terminated() {
            return;
        }
        let s = cx.F.defers.get(i);
        if ast.stmt_more(s).on_error and u.isnil(err) and not always {
            continue;
        }
        let saved = cx.F.defers.len;
        cx.F.defers.len = i;  // a deferred statement runs with only the outer defers pending
        if ast.stmt_more(s).on_error and not always {
            let run = cx.new_bb("errdefer".ptr);
            let skip = cx.new_bb("errdefer.end".ptr);
            cx.condbr(err, run, skip);
            cx.at_end(run);
            gen_stmt(s.body);
            if not cx.terminated() {
                cx.br(skip);
            }
            cx.at_end(skip);
        } else {
            gen_stmt(s.body);
        }
        cx.F.defers.len = saved;
    }
}

fn emit_ret(v: *mut ir.Value) void {
    if u.notnil(cx.F.sret_ptr) {
        if u.notnil(v) {
            cgrt.store(cx.F.ret, v, cx.F.sret_ptr, false);
        }
    }
    if cx.F.asan_stack.len > 0 {
        let ff = mem_fn("asan_stack_free");
        for i in 0..cx.F.asan_stack.len {
            let slot = cx.F.asan_stack.get(i);
            let mut fargs: [2]*mut ir.Value = [slot.ptr_u, cx.usz(slot.size)];
            _ = cx.call(ff.llty, ff.fnv, fargs[..]);
        }
    }
    if u.notnil(cx.F.sret_ptr) or (cx.F.ret.kind == ast.TY_VOID) {
        ir.ret_void(cx.B);
    } else {
        ir.ret(cx.B, v);
    }
}

fn gen_return(e: *mut ast.Expr) void {
    let mut v = cx.vnil();
    let mut err = cx.vnil();  // returning an error? (for the errdefers)
    if u.notnil(e) {
        v = gen(e);
        if cx.terminated() {
            return;
        }
        if cx.F.ret.kind == ast.TY_ERRUNION {
            let code = cx.extract(v, 0);
            cgrt.etrace_push(code);
            err = cx.icmp(ir.IntNE, code, ir.cint(cx.T_i16, 0));
        }
    } else if cx.F.ret.kind == ast.TY_ERRUNION {
        v = cgb.errunion_value(cx.F.ret, ir.cint(cx.T_i16, 0), cx.vnil());
    }
    emit_defers(0, err, false);
    if cx.terminated() {
        return;
    }
    emit_ret(v);
    cx.dead_block();
}

// break / continue, leaving `depth` loops beyond the innermost.
fn gen_break(is_break: bool, depth: i32) void {
    if cx.F.loops.len == 0 {
        return;
    }
    let mut i = cx.F.loops.len - 1;
    if @int_cast(usize, depth) < i {
        i -= @int_cast(usize, depth);
    } else {
        i = 0;
    }
    let lc = cx.F.loops.get(i);
    emit_defers(lc.defer_height, cx.vnil(), false);
    if is_break {
        cx.br(lc.brk);
    } else {
        cx.br(lc.cont);
    }
    cx.dead_block();
}

// ---------------------------------------------------------------------------
// Places
// ---------------------------------------------------------------------------
fn addr_or_spill(e: *mut ast.Expr) *mut ir.Value {
    if sema.is_place(e) {
        return gen_addr(e);
    }
    let t = cx.ct(e.ty);
    return cgrt.spill(t, gen(e));
}

fn array_len_value(arr: *mut ast.Type) *mut ir.Value {
    return cx.usz(arr.len);
}

fn gen_addr_inner(e: *mut ast.Expr) *mut ir.Value {
    let k = e.kind;
    if k == ast.E_IDENT {
        if u.notnil(ast.local_of(e)) {
            return cgrt.local_ptr(ast.local_of(e));
        }
        if u.notnil(ast.decl_of(e)) and (ast.decl_of(e).kind == ast.D_GLOBAL) {
            return cgb.global_addr(ast.decl_of(e));
        }
    } else if k == ast.E_DEREF {
        return gen(e.a);
    } else if k == ast.E_FIELD {
        if (ast.field_kind_of(e) == ast.FK_DECL) and u.notnil(ast.decl_of(e)) and
           (ast.decl_of(e).kind == ast.D_GLOBAL) {
            return cgb.global_addr(ast.decl_of(e));
        }
        let at = cx.ct(e.a.ty);
        let mut base = cx.vnil();
        let mut stt = at;
        if ast.self_mode_of(e) == ast.SELF_DEREF {
            base = gen(e.a);
            stt = at.elem;
        } else {
            base = addr_or_spill(e.a);
        }
        return cx.sgep(cx.lty(stt), base, @int_cast(u32, ast.index_of(e)));
    } else if k == ast.E_INDEX {
        let at = cx.ct(e.a.ty);
        if ast.index_kind_of(e) == ast.IDX_SLICE {
            let s = gen(e.a);
            let idx = gen(ast.b_of(e));
            let ptr = cx.extract(s, 0);
            let len = cx.extract(s, 1);
            cgrt.check_or_trap(cx.icmp(ir.IntULT, idx, len), cgrt.T_BOUNDS);
            return cx.gep1(cx.lty(at.elem), ptr, idx);
        }
        let mut arr = at;
        let mut base = cx.vnil();
        if ast.index_kind_of(e) == ast.IDX_PTR_ARRAY {
            arr = at.elem;
            base = gen(e.a);
        } else {
            base = addr_or_spill(e.a);
        }
        let idx = gen(ast.b_of(e));
        cgrt.check_or_trap(cx.icmp(ir.IntULT, idx, array_len_value(arr)), cgrt.T_BOUNDS);
        return cx.gep2(cx.lty(arr), base, cx.usz(0), idx);
    }
    // not a place: materialize
    let t = cx.ct(e.ty);
    return cgrt.spill(t, gen(e));
}

// ---------------------------------------------------------------------------
// Calls
// ---------------------------------------------------------------------------
fn emit_call(fty: *mut ir.Ty, fnv: *mut ir.Value, fnty: *mut ast.Type, sret: bool, argv: []mut *mut ir.Value,
             argt: []mut *mut ast.Type, callee: []u8) *mut ir.Value {
    return emit_call_c(fty, fnv, fnty, sret, argv, argt, callee, false);
}

fn emit_call_c(fty: *mut ir.Ty, fnv: *mut ir.Value, fnty: *mut ast.Type, sret: bool, argv: []mut *mut ir.Value,
               argt: []mut *mut ast.Type, callee: []u8, cabi: bool) *mut ir.Value {
    let argc = argv.len;
    let mut n = argc;
    if sret {
        n += 1;
    }
    let av = u.newn.[*mut ir.Value](n + 1);
    let mut k: usize = 0;
    let mut ret_tmp = cx.vnil();
    if sret {
        ret_tmp = cgrt.temp_alloca(fnty.ret);
        av[k] = ret_tmp;
        k += 1;
    }
    for i in 0..argc {
        if cx.cabi_struct(argt[i], cabi) {
            av[k] = cgrt.spill(argt[i], argv[i]);
        } else {
            av[k] = argv[i];
        }
        k += 1;
    }
    let sf = cgrt.ss_push(callee);
    let r = cx.call(fty, fnv, av[0..n]);
    cgrt.ss_pop(sf, r);
    cgb.add_ext_attrs_c(r, fnty, sret, true, cabi);
    if sret {
        return cgrt.load(fnty.ret, ret_tmp, false);
    }
    if fnty.ret.kind == ast.TY_VOID {
        return cx.vnil();
    }
    return r;
}

fn gen_call(e: *mut ast.Expr) *mut ir.Value {
    if ast.call_kind_of(e) == ast.CALLK_VARIANT {
        let ut = cx.ct(ast.tval_of(e));
        let tmp = cgrt.temp_alloca(ut);
        let tagp = cx.sgep(cx.lty(ut), tmp, 0);
        let payload = gen(ast.args_of(e).get(0));
        _ = cx.st(ir.cint(cx.lty(ty.union_tag_type(ut)), @int_cast(u64, ast.index_of(e))), tagp);
        let pt = ty.type_variant(ut, @int_cast(usize, ast.index_of(e)));
        let pp = cx.sgep(cx.lty(ut), tmp, 1);
        cgrt.store(pt, payload, pp, true);
        return cgrt.load(ut, tmp, false);
    }
    if ast.call_kind_of(e) == ast.CALLK_INDIRECT {
        if (e.a.kind == ast.E_IDENT) and u.isnil(ast.local_of(e.a)) and u.notnil(ast.tval_of(e.a)) {
            let cfn = cx.ct(ast.tval_of(e.a));
            if cfn.kind == ast.TY_CONSTFN {
                let fi = get_callee(cfn.decl, cfn.args);
                let n = ast.args_of(e).len;
                let av = u.newn.[*mut ir.Value](n + 1);
                for i in 0..n {
                    av[i] = gen(ast.args_of(e).get(i));
                }
                return emit_call(fi.llty, fi.fnv, fi.fnty, fi.sret, av[0..n], fi.fnty.params, fi.display);
            }
        }
        let ft = cx.ct(e.a.ty);
        let fp = gen(e.a);
        let n = ast.args_of(e).len;
        let av = u.newn.[*mut ir.Value](n + 1);
        for i in 0..n {
            av[i] = gen(ast.args_of(e).get(i));
        }
        let fl = cx.fn_lty(ft);
        return emit_call(fl.t, fp, ft, fl.sret, av[0..n], ft.params, u.nosym());
    }
    let d = ast.decl_of(e);
    let fi = get_callee(d, subst_gargs(ast.gargs_of(e)));
    let has_recv = u.notnil(ast.b_of(e));
    let mut n = ast.args_of(e).len;
    if has_recv {
        n += 1;
    }
    let av = u.newn.[*mut ir.Value](n + 1);
    let mut k: usize = 0;
    if has_recv {
        let recv = ast.b_of(e);
        let sm = ast.self_mode_of(e);
        if sm == ast.SELF_DEREF {
            let pt = cx.ct(recv.ty);
            av[k] = cgrt.load(pt.elem, gen(recv), true);
        } else if sm == ast.SELF_ADDR {
            av[k] = gen_addr(recv);
        } else {
            av[k] = gen(recv);
        }
        k += 1;
    }
    for i in 0..ast.args_of(e).len {
        av[k] = gen(ast.args_of(e).get(i));
        k += 1;
    }
    let mut argt = fi.fnty.params;
    if d.variadic {  // types of the extra (promoted) arguments
        argt = u.newn.[*mut ast.Type](n + 1);
        let mut off: usize = 0;
        if has_recv {
            off = 1;
        }
        for i in 0..n {
            if i < fi.fnty.params.len {
                argt[i] = fi.fnty.params[i];
            } else {
                argt[i] = cx.ct(ast.args_of(e).get(i - off).ty);
            }
        }
    }
    return emit_call_c(fi.llty, fi.fnv, fi.fnty, fi.sret, av[0..n], argt, fi.display, d.cabi and
                       (d.kind == ast.D_HOST_FN));
}

// ---------------------------------------------------------------------------
// catch / try
// ---------------------------------------------------------------------------
fn gen_try(e: *mut ast.Expr) *mut ir.Value {
    let eu = cx.ct(e.a.ty);
    let v = gen(e.a);
    let code = cx.extract(v, 0);
    let is_err = cx.icmp(ir.IntNE, code, ir.cint(cx.T_i16, 0));
    let err_bb = cx.new_bb("try.err".ptr);
    let ok_bb = cx.new_bb("try.ok".ptr);
    cx.condbr(is_err, err_bb, ok_bb);
    cx.at_end(err_bb);
    cgrt.etrace_push(code);
    let rv = cgb.errunion_value(cx.F.ret, code, cx.vnil());
    emit_defers(0, cx.vnil(), true);
    if not cx.terminated() {
        emit_ret(rv);
    }
    cx.at_end(ok_bb);
    if eu.elem.kind == ast.TY_VOID {
        return cx.vnil();
    }
    return cgrt.from_mem(eu.elem, cx.extract(v, 1));
}

fn gen_catch(e: *mut ast.Expr) *mut ir.Value {
    let eu = cx.ct(e.a.ty);
    let vt = eu.elem;
    let v = gen(e.a);
    let code = cx.extract(v, 0);
    let is_err = cx.icmp(ir.IntNE, code, ir.cint(cx.T_i16, 0));
    let err_bb = cx.new_bb("catch.err".ptr);
    let ok_bb = cx.new_bb("catch.ok".ptr);
    let merge = cx.new_bb("catch.end".ptr);
    cx.condbr(is_err, err_bb, ok_bb);
    cx.at_end(err_bb);
    cgrt.etrace_clear();
    if u.notnil(ast.more_ro(e).capture_local) {
        cgrt.store(ty.t_error, code, cgrt.local_ptr(ast.more_ro(e).capture_local), false);
    }
    let mut hv = cx.vnil();
    let mut hbb = cx.bbnil();
    match ast.more(e).handler {
        .Value(h) => {
            hv = gen(h);
            if not cx.terminated() {
                hbb = ir.insert_block(cx.B);
                cx.br(merge);
            }
        }
        .Return(h) => { gen_return(h); }
        .Break     => { gen_break(true, ast.index_of(e)); }
        .Continue  => { gen_break(false, ast.index_of(e)); }
        .Block(blk) => {
            gen_block(blk);
            if not cx.terminated() {
                cx.br(merge);  // only possible for !void
            }
        }
    }
    if not cx.terminated() {
        ir.unreachable(cx.B);
    }
    cx.at_end(ok_bb);
    let mut ov = cx.vnil();
    if vt.kind != ast.TY_VOID {
        ov = cgrt.from_mem(vt, cx.extract(v, 1));
    }
    let obb = ir.insert_block(cx.B);
    cx.br(merge);
    cx.at_end(merge);
    if vt.kind == ast.TY_VOID {
        return cx.vnil();
    }
    if u.isnil(hbb) or u.isnil(hv) {
        return ov;
    }
    let phi = ir.phi(cx.B, cx.vty(vt));
    let mut vals: [2]*mut ir.Value = [ov, hv];
    let mut bbs: [2]*mut ir.Block = [obb, hbb];
    ir.add_incoming(phi, vals[0], bbs[0]);
    ir.add_incoming(phi, vals[1], bbs[1]);
    return phi;
}

fn opt_some_val(t: *mut ast.Type, v0: *mut ir.Value) *mut ir.Value {
    let niche = ty.opt_niche(t);
    if niche == ty.OPT_BOOL {
        return cgrt.to_mem(ty.t_bool, v0);
    }
    if niche == ty.OPT_TAGGED {
        let lt = cx.lty(t);
        let mut res = ir.undef(lt);
        res = cx.insert(res, ir.cint(cx.T_i8, 1), 0);
        res = cx.insert(res, cgrt.to_mem(t.elem, v0), 1);
        return res;
    }
    return v0;
}

fn opt_has_value(t: *mut ast.Type, v: *mut ir.Value) *mut ir.Value {
    let niche = ty.opt_niche(t);
    if niche == ty.OPT_PTR {
        return cx.icmp(ir.IntNE, v, ir.czero(cx.T_ptr));
    }
    if niche == ty.OPT_BOOL {
        return cx.icmp(ir.IntNE, v, ir.cint(cx.T_i8, 2));
    }
    if niche == ty.OPT_SLICE {
        return cx.icmp(ir.IntNE, cx.extract(v, 0), ir.czero(cx.T_ptr));
    }
    return cx.icmp(ir.IntNE, cx.extract(v, 0), ir.cint(cx.T_i8, 0));
}

fn opt_extract_val(t: *mut ast.Type, v: *mut ir.Value) *mut ir.Value {
    let niche = ty.opt_niche(t);
    if niche == ty.OPT_BOOL {
        return cgrt.from_mem(ty.t_bool, v);
    }
    if niche == ty.OPT_TAGGED {
        return cgrt.from_mem(t.elem, cx.extract(v, 1));
    }
    return v;
}

fn gen_orelse(e: *mut ast.Expr) *mut ir.Value {
    let ot = cx.ct(e.a.ty);
    let vt = ot.elem;
    let v = gen(e.a);
    if cx.terminated() {
        return ir.undef(cx.vty(vt));
    }
    let has = opt_has_value(ot, v);
    let none_bb = cx.new_bb("orelse.none".ptr);
    let some_bb = cx.new_bb("orelse.some".ptr);
    let merge = cx.new_bb("orelse.end".ptr);
    cx.condbr(has, some_bb, none_bb);
    cx.at_end(none_bb);
    let mut hv = cx.vnil();
    let mut hbb = cx.bbnil();
    match ast.more(e).handler {
        .Value(h) => {
            hv = gen(h);
            if not cx.terminated() {
                hbb = ir.insert_block(cx.B);
                cx.br(merge);
            }
        }
        .Return(h)  => { gen_return(h); }
        .Break      => { gen_break(true, ast.index_of(e)); }
        .Continue   => { gen_break(false, ast.index_of(e)); }
        .Block(blk) => { gen_block(blk); }
    }
    if not cx.terminated() {
        ir.unreachable(cx.B);
    }
    cx.at_end(some_bb);
    let ov = opt_extract_val(ot, v);
    let obb = ir.insert_block(cx.B);
    cx.br(merge);
    cx.at_end(merge);
    if u.isnil(hbb) or u.isnil(hv) {
        return ov;
    }
    let phi = ir.phi(cx.B, cx.vty(vt));
    let mut vals: [2]*mut ir.Value = [ov, hv];
    let mut bbs: [2]*mut ir.Block = [obb, hbb];
    ir.add_incoming(phi, vals[0], bbs[0]);
    ir.add_incoming(phi, vals[1], bbs[1]);
    return phi;
}

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------
fn gen_struct_lit(e: *mut ast.Expr) *mut ir.Value {
    let t = cx.ct(e.ty);
    let mut v = ir.undef(cx.lty(t));
    for i in 0..ast.more(e).inits.len {
        let ft = ty.type_field(t, i);
        let fv = gen(ast.more_ro(e).inits.at_mut(i).value);
        v = cx.insert(v, cgrt.to_mem(ft, fv), @int_cast(u32, i));
    }
    return v;
}

fn gen_array_lit(e: *mut ast.Expr) *mut ir.Value {
    let t = cx.ct(e.ty);
    if e.kind == ast.E_ARRAY_LIT {
        let mut v = ir.undef(cx.lty(t));
        for i in 0..ast.args_of(e).len {
            v = cx.insert(v, cgrt.to_mem(t.elem, gen(ast.args_of(e).get(i))), @int_cast(u32, i));
        }
        return v;
    }
    let x = gen(e.a);
    if (ir.is_const(x)) and (ir.is_zero(x)) {
        return ir.czero(cx.lty(t));
    }
    if t.len <= 16 {
        let mut v = ir.undef(cx.lty(t));
        for i in 0..@int_cast(u32, t.len) {
            v = cx.insert(v, cgrt.to_mem(t.elem, x), i);
        }
        return v;
    }
    let tmp = cgrt.temp_alloca(t);
    let iv = cgrt.alloca_in_entry(cx.T_isz, "i".ptr);
    _ = cx.st(cx.usz(0), iv);
    let cond = cx.new_bb("fill.cond".ptr);
    let body = cx.new_bb("fill.body".ptr);
    let end = cx.new_bb("fill.end".ptr);
    cx.br(cond);
    cx.at_end(cond);
    let i = cx.ld(cx.T_isz, iv);
    cx.condbr(cx.icmp(ir.IntULT, i, cx.usz(t.len)), body, end);
    cx.at_end(body);
    cgrt.store(t.elem, x, cx.gep2(cx.lty(t), tmp, cx.usz(0), i), false);
    _ = cx.st(cx.b_add(i, cx.usz(1)), iv);
    cx.br(cond);
    cx.at_end(end);
    return cgrt.load(t, tmp, false);
}

fn gen_unary(e: *mut ast.Expr) *mut ir.Value {
    let t = cx.ct(e.ty);
    let op = ast.op_of(e);
    if (op == lx.KW_NOT) or (op == lx.TK_TILDE) {
        return cx.b_not(gen(e.a));
    }
    if op == lx.TK_AMP {
        return gen_addr(e.a);
    }
    if op == lx.TK_MINUS_PCT {
        return ir.neg(cx.B, gen(e.a));
    }
    if op == lx.TK_MINUS {
        let v = gen(e.a);
        if (t.kind == ast.TY_FLOAT) or ty.is_vec_float(t) {
            return ir.fneg(cx.B, v);
        }
        if t.kind == ast.TY_VEC {
            return ir.neg(cx.B, v);  // integer vectors wrap in every mode
        }
        return cgb.overflow_op(1, true, ir.czero(v.ty), v);
    }
    cx.internal_error("bad unary");
    return cx.vnil();
}

fn gen_binary(e: *mut ast.Expr) *mut ir.Value {
    if (ast.op_of(e) == lx.KW_AND) or (ast.op_of(e) == lx.KW_OR) {
        let is_and = ast.op_of(e) == lx.KW_AND;
        let l = gen(e.a);
        if l.kind == ir.V_CINT {
            // a constant left operand (a target condition): the builder
            // would fold the branch, and the right operand runs or not
            if (l.cv != 0) == is_and {
                return gen(ast.b_of(e));
            }
            return l;
        }
        let lbb = ir.insert_block(cx.B);
        let rhs = cx.new_bb(u.pick(is_and, "and.rhs", "or.rhs").ptr);
        let end = cx.new_bb(u.pick(is_and, "and.end", "or.end").ptr);
        if is_and {
            cx.condbr(l, rhs, end);
        } else {
            cx.condbr(l, end, rhs);
        }
        cx.at_end(rhs);
        let r = gen(ast.b_of(e));
        let rbb = ir.insert_block(cx.B);
        cx.br(end);
        cx.at_end(end);
        let phi = ir.phi(cx.B, cx.T_i1);
        let mut sc: u64 = 1;
        if is_and {
            sc = 0;
        }
        let mut vals: [2]*mut ir.Value = [ir.cint(cx.T_i1, sc), r];
        let mut bbs: [2]*mut ir.Block = [lbb, rbb];
        ir.add_incoming(phi, vals[0], bbs[0]);
        ir.add_incoming(phi, vals[1], bbs[1]);
        return phi;
    }
    let lt = cx.ct(e.a.ty);
    let l = gen(e.a);
    let r = gen(ast.b_of(e));
    return cgb.gen_binop(ast.op_of(e), lt, l, r);
}

fn gen_slice(e: *mut ast.Expr) *mut ir.Value {
    let at = cx.ct(e.a.ty);
    let rt = cx.ct(e.ty);
    let mut ptr = cx.vnil();
    let mut len = cx.vnil();
    if ast.index_kind_of(e) == ast.IDX_SLICE {
        let s = gen(e.a);
        ptr = cx.extract(s, 0);
        len = cx.extract(s, 1);
    } else {
        let mut arr = at;
        if ast.index_kind_of(e) == ast.IDX_PTR_ARRAY {
            arr = at.elem;
            ptr = gen(e.a);
        } else {
            ptr = gen_addr(e.a);
        }
        len = array_len_value(arr);
    }
    let mut lo = cx.usz(0);
    if u.notnil(ast.b_of(e)) {
        lo = gen(ast.b_of(e));
    }
    let mut hi = len;
    if u.notnil(ast.c_of(e)) {
        hi = gen(ast.c_of(e));
    }
    let hl = cx.icmp(ir.IntULE, hi, len);  // (right to left, as in the C implementation)
    let ok = cx.b_and(cx.icmp(ir.IntULE, lo, hi), hl);
    cgrt.check_or_trap(ok, cgrt.T_BOUNDS);
    let np = cx.gep1(cx.lty(rt.elem), ptr, lo);
    let s = cx.insert(ir.undef(cx.lty(rt)), np, 0);
    return cx.insert(s, cx.b_sub(hi, lo), 1);
}

fn gen_inner(e: *mut ast.Expr) *mut ir.Value {
    let t = cx.ct(e.ty);
    if u.notnil(t) and (t.kind == ast.TY_NEVER) {
        // The expression diverges; generate it and hand back a placeholder.
        if e.kind == ast.E_BUILTIN {
            _ = gen_builtin(e);
        }
        let mut want = cx.tnil();
        if u.notnil(ast.tval_of(e)) {
            want = cx.ct(ast.tval_of(e));
        }
        if u.notnil(want) and (want.kind != ast.TY_VOID) and (want.kind != ast.TY_NEVER) {
            return ir.undef(cx.vty(want));
        }
        return cx.vnil();
    }
    if e.is_const and u.notnil(t) {
        if t.kind == ast.TY_INT {
            return cx.cint(cx.lty(t), ast.cval_of(e));
        }
        if t.kind == ast.TY_FLOAT {
            return cx.cfloat(t, e);
        }
        if t.kind == ast.TY_BOOL {
            let mut bv: u64 = 0;
            if e.bval {
                bv = 1;
            }
            return ir.cint(cx.T_i1, bv);
        }
    }
    let k = e.kind;
    if k == ast.E_IDENT {
        if u.notnil(ast.local_of(e)) {
            return cgrt.load(t, cgrt.local_ptr(ast.local_of(e)), false);
        }
        if u.notnil(ast.tval_of(e)) and (ast.tval_of(e).kind == ast.TY_PARAM) and ast.tval_of(e).is_const {
            let c = cx.ct(ast.tval_of(e));
            if c.kind == ast.TY_CONSTFN {
                return cgb.get_inst(c.decl, c.args).fnv;
            }
            return cx.cint(cx.lty(t), u.I128.of(c.cval));
        }
        if u.notnil(ast.decl_of(e)) {
            let dk = ast.decl_of(e).kind;
            if dk == ast.D_GLOBAL {
                return cgrt.load(t, cgb.global_addr(ast.decl_of(e)), false);
            }
            if (dk == ast.D_FN) or (dk == ast.D_HOST_FN) {
                return cgb.get_inst(ast.decl_of(e), subst_gargs(ast.gargs_of(e))).fnv;
            }
            if dk == ast.D_CONST {
                if (cx.O.unit == cx.CG_MODULE) and type_mentions_error(t) {
                    return gen(ast.decl_of(e).cexpr);
                }
                return cgb.gen_const(ast.decl_of(e).cexpr, t);
            }
        }
    } else if k == ast.E_STRING {
        return cgb.const_slice(cgb.string_ptr(ast.more(e).str), @int_cast(i64, ast.more(e).str.len));
    } else if k == ast.E_BOOL {
        let mut bv: u64 = 0;
        if e.bval {
            bv = 1;
        }
        return ir.cint(cx.T_i1, bv);
    } else if k == ast.E_INT {
        return cx.cint(cx.lty(t), u.I128.ofu(ast.ival_of(e)));
    } else if k == ast.E_FLOAT {
        return cx.cfloat(t, e);
    } else if k == ast.E_STRUCT_LIT {
        return gen_struct_lit(e);
    } else if (k == ast.E_ARRAY_LIT) or (k == ast.E_ARRAY_REPEAT) {
        return gen_array_lit(e);
    } else if k == ast.E_ERROR_VAL {
        return cgb.errcode_value(@truncate(u32, ast.cval_of(e).lo));
    } else if k == ast.E_BUILTIN {
        return gen_builtin(e);
    } else if k == ast.E_UNARY {
        return gen_unary(e);
    } else if k == ast.E_BINARY {
        return gen_binary(e);
    } else if k == ast.E_CATCH {
        return gen_catch(e);
    } else if k == ast.E_OPT_NONE {
        return cgb.opt_none_val(t);
    } else if k == ast.E_OPT_SOME {
        let v = gen(e.a);
        if cx.terminated() {
            return ir.undef(cx.vty(t));
        }
        return opt_some_val(t, v);
    } else if k == ast.E_ORELSE {
        return gen_orelse(e);
    } else if k == ast.E_EMPTY_SLICE {
        return cgb.empty_slice_val(t);
    } else if k == ast.E_TRY {
        return gen_try(e);
    } else if k == ast.E_CALL {
        return gen_call(e);
    } else if k == ast.E_FIELD {
        let fk = ast.field_kind_of(e);
        if fk == ast.FK_STRUCT {
            if sema.is_place(e) {
                return cgrt.load(t, asan_place(e, gen_addr(e)), cgb.via_pointer(e));
            }
            if ast.self_mode_of(e) == ast.SELF_DEREF {
                return cgrt.load(t, asan_place(e, gen_addr(e)), true);
            }
            return cgrt.from_mem(t, cx.extract(gen(e.a), @int_cast(u32, ast.index_of(e))));
        }
        if fk == ast.FK_SLICE_LEN {
            return cx.extract(gen(e.a), 1);
        }
        if fk == ast.FK_SLICE_PTR {
            return cx.extract(gen(e.a), 0);
        }
        if fk == ast.FK_ARRAY_LEN {
            return cx.usz(cx.ct(e.a.ty).len);
        }
        if fk == ast.FK_VARIANT_UNIT {
            let tmp = cgrt.temp_alloca(t);
            _ = cx.st(
                ir.cint(cx.lty(ty.union_tag_type(t)), @int_cast(u64, ast.index_of(e))), cx.sgep(cx.lty(t), tmp, 0));
            return cgrt.load(t, tmp, false);
        }
        if fk == ast.FK_CONST {
            return cgb.gen_const(ast.decl_of(e).cexpr, t);
        }
        if fk == ast.FK_DECL {
            if ast.decl_of(e).kind == ast.D_GLOBAL {
                return cgrt.load(t, cgb.global_addr(ast.decl_of(e)), false);
            }
            return cgb.get_inst(ast.decl_of(e), subst_gargs(ast.gargs_of(e))).fnv;
        }
    } else if k == ast.E_DEREF {
        return cgrt.load(t, asan_place(e, gen_addr(e)), true);
    } else if k == ast.E_INDEX {
        return cgrt.load(t, asan_place(e, gen_addr(e)), cgb.via_pointer(e) or (ast.index_kind_of(e) != ast.IDX_ARRAY));
    } else if k == ast.E_SLICE {
        return gen_slice(e);
    } else if k == ast.E_APPLY {
        return cgb.get_inst(ast.decl_of(e), subst_gargs(ast.gargs_of(e))).fnv;
    } else if k == ast.E_CONV {
        if ast.conv_of(e) == ast.CONV_NOOP {
            return gen(e.a);
        }
        if ast.conv_of(e) == ast.CONV_WRAP_OK {
            let mut v = cx.vnil();
            if t.elem.kind != ast.TY_VOID {
                v = gen(e.a);
            }
            return cgb.errunion_value(t, ir.cint(cx.T_i16, 0), v);
        }
        if ast.conv_of(e) == ast.CONV_WRAP_ERR {
            return cgb.errunion_value(t, gen(e.a), cx.vnil());
        }
        if ast.conv_of(e) == ast.CONV_WRAP_SOME {
            let v = gen(e.a);
            if cx.terminated() {
                return ir.undef(cx.vty(t));
            }
            return opt_some_val(t, v);
        }
    }
    cx.internal_error(u.f1("cannot generate expression kind %s", u.idec(@as(i32, @int_from_enum(e.kind)))));
    return cx.vnil();
}

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------
fn gen_block(b: *mut ast.Stmt) void {
    let height = cx.F.defers.len;
    let mut binds = false;
    if axd.on() {
        for i in 0..b.stmts.len {
            binds = binds or (b.stmts.get(i).kind == ast.S_LET);
        }
    }
    let sc = axd.open_block(binds);
    for i in 0..b.stmts.len {
        if cx.terminated() {
            break;
        }
        gen_stmt(b.stmts.get(i));
    }
    if not cx.terminated() {
        emit_defers(height, cx.vnil(), false);
    }
    cx.F.defers.len = height;
    axd.close_scope(sc);
}

fn gen_if(s: *mut ast.Stmt) void {
    // A target condition (spec §13.4): only the branch it selects is compiled.
    let tc = spost.target_cond(s.e, tg.g_features);
    if tc == 1 {
        gen_block(s.body);
        return;
    }
    if tc == 0 {
        if u.notnil(s.els) {
            if s.els.kind == ast.S_IF {
                gen_if(s.els);
            } else {
                gen_block(s.els);
            }
        }
        return;
    }
    let c = gen(s.e);
    let then_bb = cx.new_bb("if.then".ptr);
    let end = cx.new_bb("if.end".ptr);
    let mut else_bb = end;
    if u.notnil(s.els) {
        else_bb = cx.new_bb("if.else".ptr);
    }
    cx.condbr(c, then_bb, else_bb);
    cx.at_end(then_bb);
    gen_block(s.body);
    if not cx.terminated() {
        cx.br(end);
    }
    if u.notnil(s.els) {
        cx.at_end(else_bb);
        if s.els.kind == ast.S_IF {
            gen_if(s.els);
        } else {
            gen_block(s.els);
        }
        if not cx.terminated() {
            cx.br(end);
        }
    }
    cx.at_end(end);
}

fn push_loop(brk: *mut ir.Block, cont: *mut ir.Block) void {
    cx.F.loops.push(cx.LoopCtx.{ brk: brk, cont: cont, defer_height: cx.F.defers.len });
}

fn gen_for(s: *mut ast.Stmt) void {
    let vt = cx.ct(s.local.ty);
    let var = cgrt.local_ptr(s.local);
    let cond = cx.new_bb("for.cond".ptr);
    let body = cx.new_bb("for.body".ptr);
    let step = cx.new_bb("for.step".ptr);
    let end = cx.new_bb("for.end".ptr);
    if u.notnil(s.e2) {
        let lo = gen(s.e);
        let hi = gen(s.e2);
        let iv = cgrt.alloca_in_entry(cx.lty(vt), "for.i".ptr);
        _ = cx.st(lo, iv);
        cx.br(cond);
        cx.at_end(cond);
        let i = cx.ld(cx.lty(vt), iv);
        let mut p = ir.IntULT;
        if vt.is_signed {
            p = ir.IntSLT;
        }
        cx.condbr(cx.icmp(p, i, hi), body, end);
        cx.at_end(body);
        _ = cx.st(i, var);
        push_loop(end, step);
        gen_block(s.body);
        cx.F.loops.len -= 1;
        if not cx.terminated() {
            cx.br(step);
        }
        cx.at_end(step);
        // (the step runs after the body, which runs while i < hi: i + 1 <=
        // hi does not overflow)
        let i2 = cx.ld(cx.lty(vt), iv);
        _ = cx.st(cgrt.no_wrap(cx.b_add(i2, ir.cint(cx.lty(vt), 1)), vt.is_signed), iv);
        cx.br(cond);
        cx.at_end(end);
        return;
    }
    let ctt = cx.ct(s.e.ty);
    let mut ptr = cx.vnil();
    let mut len = cx.vnil();
    if ctt.kind == ast.TY_SLICE {
        let sv = gen(s.e);
        ptr = cx.extract(sv, 0);
        len = cx.extract(sv, 1);
    } else {
        ptr = addr_or_spill(s.e);
        len = cx.usz(ctt.len);
    }
    let iv = cgrt.alloca_in_entry(cx.T_isz, "for.idx".ptr);
    _ = cx.st(cx.usz(0), iv);
    cx.br(cond);
    cx.at_end(cond);
    let i = cx.ld(cx.T_isz, iv);
    cx.condbr(cx.icmp(ir.IntULT, i, len), body, end);
    cx.at_end(body);
    let elt = cx.ct(ctt.elem);
    let ep = cx.gep1(cx.lty(elt), ptr, i);
    if ast.stmt_more(s).ref_iter {
        cgrt.store(vt, ep, var, false);
    } else {
        if ctt.kind == ast.TY_SLICE {
            asan_check(ep, cx.usz(ty.type_size(elt)));
        }
        cgrt.store(elt, cgrt.load(elt, ep, ctt.kind == ast.TY_SLICE), var, false);
    }
    push_loop(end, step);
    gen_block(s.body);
    cx.F.loops.len -= 1;
    if not cx.terminated() {
        cx.br(step);
    }
    cx.at_end(step);
    // (i < len in the body before the step: i + 1 <= len does not wrap)
    let i2 = cx.ld(cx.T_isz, iv);
    _ = cx.st(cgrt.no_wrap(cx.b_add(i2, cx.usz(1)), false), iv);
    cx.br(cond);
    cx.at_end(end);
}

fn is_variant_arm(a: *ast.MatchArm) bool {
    match a.pat {
        .Variant => { return true; }
        else     => { return false; }
    }
}

fn is_error_arm(a: *ast.MatchArm) bool {
    match a.pat {
        .Error => { return true; }
        else   => { return false; }
    }
}

fn gen_match(s: *mut ast.Stmt) void {
    let t0 = cx.ct(s.e.ty);
    let mut by_ref = false;
    let mut t = t0;
    if (t0.kind == ast.TY_PTR) and ((t0.elem.kind == ast.TY_UNION) or (t0.elem.kind == ast.TY_OPT)) {
        by_ref = true;
        t = cx.ct(t0.elem);
    }
    let end = cx.new_bb("match.end".ptr);
    let n = ast.stmt_more(s).arms.len;
    let bbs = u.newn.[*mut ir.Block](n + 1);
    let mut else_idx: i64 = -1;
    for i in 0..n {
        // an arm's other patterns branch to its block
        if ast.stmt_more(s).arms.at(i).alt {
            bbs[i] = bbs[i - 1];
        } else {
            bbs[i] = cx.new_bb("match.arm".ptr);
        }
        if ast.stmt_more(s).arms.at(i).is_else() and (else_idx < 0) {
            else_idx = @int_cast(i64, i);
        }
    }
    let mut payload_ptr = cx.vnil();
    let mut opt_val = cx.vnil();
    if t.kind == ast.TY_UNION {
        let mut up = cx.vnil();
        if by_ref {
            up = gen(s.e);
            asan_check(up, cx.usz(ty.type_size(t)));
        } else {
            up = addr_or_spill(s.e);
        }
        let tag = cgrt.load(ty.union_tag_type(t), cx.sgep(cx.lty(t), up, 0), by_ref);
        if ir.field_count(cx.lty(t)) > 1 {
            payload_ptr = cx.sgep(cx.lty(t), up, 1);
        }
        let nv = t.decl.variants.len;
        let sw = ir.switch_(cx.B, tag, cgrt.trap_block(cgrt.T_UNIONTAG));
        let covered = u.newn.[bool](nv + 1);
        for i in 0..n {
            let a = ast.stmt_more(s).arms.at(i);
            if is_variant_arm(a) and not covered[@int_cast(usize, a.variant)] {
                covered[@int_cast(usize, a.variant)] = true;
                ir.add_case(sw, ir.cint(cx.lty(ty.union_tag_type(t)), @int_cast(u64, a.variant)), bbs[i]);
            }
        }
        if else_idx >= 0 {
            for v in 0..nv {
                if not covered[v] {
                    ir.add_case(
                        sw, ir.cint(cx.lty(ty.union_tag_type(t)), @as(u64, v)), bbs[@int_cast(usize, else_idx)]);
                }
            }
        }
    } else if t.kind == ast.TY_OPT {
        let mut none_bb = cx.bbnil();
        let mut some_bb = cx.bbnil();
        for i in 0..n {
            let a = ast.stmt_more(s).arms.at(i);
            if is_variant_arm(a) {
                if a.variant == 0 {
                    none_bb = bbs[i];
                } else {
                    some_bb = bbs[i];
                }
            }
        }
        if u.isnil(none_bb) and (else_idx >= 0) {
            none_bb = bbs[@int_cast(usize, else_idx)];
        }
        if u.isnil(some_bb) and (else_idx >= 0) {
            some_bb = bbs[@int_cast(usize, else_idx)];
        }
        if u.isnil(none_bb) {
            none_bb = cgrt.trap_block(cgrt.T_UNIONTAG);
        }
        if u.isnil(some_bb) {
            some_bb = cgrt.trap_block(cgrt.T_UNIONTAG);
        }
        let mut has = cx.vnil();
        if by_ref {
            let up = gen(s.e);
            asan_check(up, cx.usz(ty.type_size(t)));
            let niche = ty.opt_niche(t);
            if niche == ty.OPT_PTR {
                let pv = cgrt.load(t.elem, up, true);
                has = cx.icmp(ir.IntNE, pv, ir.czero(cx.T_ptr));
                payload_ptr = up;
            } else if niche == ty.OPT_BOOL {
                let bv = cgrt.load(ty.t_u8, up, true);
                has = cx.icmp(ir.IntNE, bv, ir.cint(cx.T_i8, 2));
                payload_ptr = up;
            } else if niche == ty.OPT_SLICE {
                let sp = cx.sgep(cx.lty(t), up, 0);
                let pv = cgrt.load(ty.type_ptr(ty.t_u8, false), sp, true);
                has = cx.icmp(ir.IntNE, pv, ir.czero(cx.T_ptr));
                payload_ptr = up;
            } else {
                let tp = cx.sgep(cx.lty(t), up, 0);
                let tag = cgrt.load(ty.t_u8, tp, true);
                has = cx.icmp(ir.IntNE, tag, ir.cint(cx.T_i8, 0));
                payload_ptr = cx.sgep(cx.lty(t), up, 1);
            }
        } else {
            opt_val = gen(s.e);
            if cx.terminated() {
                opt_val = ir.undef(cx.lty(t));
            }
            has = opt_has_value(t, opt_val);
        }
        if not cx.terminated() {
            cx.condbr(has, some_bb, none_bb);
        }
    } else if (cx.O.unit == cx.CG_MODULE) and (n > 0) and (cx.ct(s.e.ty).kind == ast.TY_ERROR) {
        // Error codes are link-time values here: compare in arm order.
        let v = gen(s.e);
        for i in 0..n {
            let a = ast.stmt_more(s).arms.at(i);
            if not is_error_arm(a) {
                continue;
            }
            let next = cx.new_bb("match.next".ptr);
            cx.condbr(cx.icmp(ir.IntEQ, v, cgb.errcode_value(a.error_code)), bbs[i], next);
            cx.at_end(next);
        }
        if else_idx >= 0 {
            cx.br(bbs[@int_cast(usize, else_idx)]);
        } else {
            cx.br(cgrt.trap_block(cgrt.T_TRAP));
        }
    } else {
        // integers, bool, error, enum (an enum match without 'else' covers every member)
        let v = gen(s.e);
        let mut dflt = cx.bbnil();
        if else_idx >= 0 {
            dflt = bbs[@int_cast(usize, else_idx)];
        } else if s.e.ty.kind == ast.TY_ENUM {
            dflt = cgrt.trap_block(cgrt.T_UNIONTAG);
        } else {
            dflt = cgrt.trap_block(cgrt.T_TRAP);
        }
        let sw = ir.switch_(cx.B, v, dflt);
        let vt_ = v.ty;
        let mut seen = u.List.[u.I128].empty();
        for i in 0..n {
            let a = ast.stmt_more(s).arms.at(i);
            let mut key = u.I128.zero();
            match a.pat {
                .Int(k) => { key = k; }
                .Bool(bv) => {
                    if bv {
                        key = u.I128.of(1);
                    }
                }
                .Error   => { key = u.I128.ofu(@as(u64, a.error_code)); }
                .Variant => { key = a.value; }
                .Else    => { continue; }
            }
            let mut dup = false;
            for kk in 0..seen.len {
                if seen.get(kk).eq(key) {
                    dup = true;
                }
            }
            if dup {
                continue;
            }
            seen.push(key);
            ir.add_case(sw, cx.cint(vt_, key), bbs[i]);
        }
        seen.deinit();
    }
    for i in 0..n {
        let a = ast.stmt_more_ro(s).arms.at_mut(i);
        if a.alt {
            continue;
        }
        cx.at_end(bbs[i]);
        if u.notnil(a.bind_local) {
            if by_ref {
                if u.notnil(payload_ptr) {
                    cgrt.store(cx.ct(a.bind_local.ty), payload_ptr, cgrt.local_ptr(a.bind_local), false);
                }
            } else if t.kind == ast.TY_OPT {
                cgrt.store(cx.ct(t.elem), opt_extract_val(t, opt_val), cgrt.local_ptr(a.bind_local), false);
            } else if u.notnil(payload_ptr) {
                let pt = ty.type_variant(t, @int_cast(usize, a.variant));
                cgrt.store(pt, cgrt.load(pt, payload_ptr, true), cgrt.local_ptr(a.bind_local), false);
            }
        }
        gen_block(a.body);
        if not cx.terminated() {
            cx.br(end);
        }
    }
    cx.at_end(end);
}

// Whether every bit pattern of t's bytes is a value of t: integers, floats
// and vectors, and arrays and structs of them (padding included).
fn plain_data(t0: *mut ast.Type) bool {
    if t0.kind == ast.TY_ENUM {
        return false;
    }
    let t = cx.ct(t0);
    let k = t.kind;
    if (k == ast.TY_INT) or (k == ast.TY_FLOAT) or (k == ast.TY_VEC) or (k == ast.TY_V128) {
        return true;
    }
    if k == ast.TY_ARRAY {
        return plain_data(t.elem);
    }
    if k == ast.TY_STRUCT {
        for i in 0..t.decl.fields.len {
            if not plain_data(ty.type_field(t, i)) {
                return false;
            }
        }
        return true;
    }
    return false;
}

fn gen_stmt_inner(s: *mut ast.Stmt) void {
    let k = s.kind;
    if (k == ast.S_LET) and s.undef {
        // left unspecified (§8.1): a small variable, which the optimizer could keep in
        // registers, is zeroed (as good a value as any, and free); a larger one's bytes are
        // left as they are in its slot, which is never promoted, when any bytes make valid
        // values of its type. Anything else (a slice, pointer or function pointer that
        // old bytes would forge, a bool, enum, union or error union) is zeroed whatever
        // its size (§12.3).
        let t = cx.ct(s.local.ty);
        let lt = cx.lty(t);
        if (lt.size <= cx.UNDEF_ZEROED) or not plain_data(s.local.ty) {
            cgrt.store(t, ir.czero(lt), cgrt.local_ptr(s.local), false);
        } else {
            _ = cgrt.local_ptr(s.local);
        }
    } else if k == ast.S_LET {
        let v = gen(s.e);
        if cx.terminated() or u.isnil(v) {
            return;
        }
        cgrt.store(cx.ct(s.local.ty), v, cgrt.local_ptr(s.local), false);
    } else if (k == ast.S_EXPR) or (k == ast.S_DISCARD) {
        _ = gen(s.e);
    } else if k == ast.S_ASSIGN {
        let t = cx.ct(s.e.ty);
        let addr = gen_addr(s.e);
        let un = cgb.via_pointer(s.e);
        if s.op == lx.TK_EQ {
            let v = gen(s.e2);
            if u.isnil(v) {
                return;
            }
            cgrt.store(t, v, asan_place(s.e, addr), un);
            return;
        }
        _ = asan_place(s.e, addr);
        let old = cgrt.load(t, addr, un);
        let r = gen(s.e2);
        let nv = cgb.gen_binop(ast.op_of(ast.stmt_more(s).e3), t, old, r);
        cgrt.store(t, nv, addr, un);
    } else if k == ast.S_IF {
        gen_if(s);
    } else if k == ast.S_WHILE {
        let cond = cx.new_bb("while.cond".ptr);
        let body = cx.new_bb("while.body".ptr);
        let end = cx.new_bb("while.end".ptr);
        cx.br(cond);
        cx.at_end(cond);
        let c = gen(s.e);
        cx.condbr(c, body, end);
        cx.at_end(body);
        push_loop(end, cond);
        gen_block(s.body);
        cx.F.loops.len -= 1;
        if not cx.terminated() {
            cx.br(cond);
        }
        cx.at_end(end);
    } else if k == ast.S_LOOP {
        let body = cx.new_bb("loop.body".ptr);
        let end = cx.new_bb("loop.end".ptr);
        cx.br(body);
        cx.at_end(body);
        push_loop(end, body);
        gen_block(s.body);
        cx.F.loops.len -= 1;
        if not cx.terminated() {
            cx.br(body);
        }
        cx.at_end(end);
    } else if k == ast.S_FOR {
        let sc = axd.open_block(true);  // (the loop's variable)
        gen_for(s);
        axd.close_scope(sc);
    } else if k == ast.S_MATCH {
        gen_match(s);
    } else if k == ast.S_RETURN {
        gen_return(s.e);
    } else if k == ast.S_BREAK {
        gen_break(true, s.jump_depth);
    } else if k == ast.S_CONTINUE {
        gen_break(false, s.jump_depth);
    } else if k == ast.S_DEFER {
        cx.F.defers.push(s);
    } else if k == ast.S_BLOCK {
        gen_block(s);
    }
}

// Wrappers that track the source span of the code being generated, for
// trap sites.
fn gen(e: *mut ast.Expr) *mut ir.Value {
    let saved = cx.S.cur_span;
    cgrt.set_span(e.span);
    let v = gen_inner(e);
    cgrt.set_span(saved);
    return v;
}

fn gen_addr(e: *mut ast.Expr) *mut ir.Value {
    let saved = cx.S.cur_span;
    cgrt.set_span(e.span);
    let v = gen_addr_inner(e);
    cgrt.set_span(saved);
    return v;
}

fn gen_stmt(s: *mut ast.Stmt) void {
    let saved = cx.S.cur_span;
    cgrt.set_span(s.span);
    gen_stmt_inner(s);
    cgrt.set_span(saved);
}

// ---------------------------------------------------------------------------
// Function bodies
// ---------------------------------------------------------------------------
pub fn gen_fn_body(fi: *mut cx.FnInst) void {
    let saved_feats = tg.g_features;
    tg.g_features = fi.feats;  // (@target_has, and lowering that depends on extensions)
    if fi.dispatch {
        let saved_f = cx.F;
        let stt = u.new.[cx.FnState]();
        stt.inst = fi;
        stt.decl = fi.decl;
        stt.fnv = fi.fnv;
        stt.no_trace = true;
        cx.F = stt;
        gen_dispatch(fi);
        cx.F = saved_f;
    } else {
        gen_fn_body_of(fi);
    }
    tg.g_features = saved_feats;
}

fn has_noalias_param(d: *ast.Decl) bool {
    for i in 0..d.params.len {
        if d.params.at(i).is_noalias {
            return true;
        }
    }
    return false;
}

fn emit_noalias_checks(d: *ast.Decl, addrs: *u.List.[*mut ir.Value], sizes: *u.List.[*mut ir.Value]) void {
    let z = cx.usz(0);
    for i in 0..d.params.len {
        let ai = addrs.get(i);
        let szi = sizes.get(i);
        if u.isnil(ai) or u.isnil(szi) {
            continue;
        }
        let ni = d.params.at(i).is_noalias;
        for j in (i + 1)..d.params.len {
            if not ni and not d.params.at(j).is_noalias {
                continue;
            }
            let aj = addrs.get(j);
            let szj = sizes.get(j);
            if u.isnil(aj) or u.isnil(szj) {
                continue;
            }
            let both_nz = cx.b_and(cx.icmp(ir.IntNE, szi, z), cx.icmp(ir.IntNE, szj, z));
            let le = cx.icmp(ir.IntULE, ai, aj);
            let diff = cx.sel(le, cx.b_sub(aj, ai), cx.b_sub(ai, aj));
            let bound = cx.sel(le, szi, szj);
            let ok = cx.b_or(cx.b_not(both_nz), cx.icmp(ir.IntUGE, diff, bound));
            cgrt.check_or_trap(ok, cgrt.T_MEMORY);
        }
    }
}

fn gen_fn_body_of(fi: *mut cx.FnInst) void {
    let d = fi.decl;
    let stt = u.new.[cx.FnState]();
    stt.inst = fi;
    stt.decl = d;
    stt.from = d.all_gparams;
    stt.to = fi.gargs;
    stt.fnv = fi.fnv;
    // the function's line: its name in the declaration (also the line of the
    // code before its body's first statement)
    cgrt.set_span(d.name_span);
    ir.fnp_of(fi.fnv).src = ir.cur_src;
    ir.fnp_of(fi.fnv).coverage = cov_on(d.module);
    stt.no_trace = cgrt.is_runtime_module(d.module);
    stt.locals = u.newn.[*mut ir.Value](d.locals.len + 1);
    stt.asan_stack = u.List.[cx.AsanStackSlot].empty();
    let saved = cx.F;
    cx.F = stt;
    stt.ret = fi.fnty.ret;
    stt.entry = ir.append_block(ir.fnp_of(fi.fnv), "entry");
    let start = ir.append_block(ir.fnp_of(fi.fnv), "start");
    cx.at_end(start);
    axd.begin_function(ir.fnp_of(fi.fnv), fi.fnty.ret);
    let mut k: u32 = 0;
    if fi.sret {
        stt.sret_ptr = cgrt.param(fi.fnv, k);
        k += 1;
    }
    let asan_noalias = asan_on() and has_noalias_param(d);
    let mut na_addrs = u.List.[*mut ir.Value].empty();
    let mut na_sizes = u.List.[*mut ir.Value].empty();
    if asan_noalias {
        na_addrs.reserve(d.params.len);
        na_sizes.reserve(d.params.len);
    }
    for i in 0..d.params.len {
        let l = d.params.at_mut(i).local;
        let pt = fi.fnty.params[i];
        let p = cgrt.param(fi.fnv, k);
        k += 1;
        if asan_noalias {
            let mut addr = cx.vnil();
            let mut sz = cx.vnil();
            if pt.kind == ast.TY_SLICE {
                let esz = ty.type_size(pt.elem);
                if esz > 0 {
                    addr = cx.ptrtoint(cx.extract(p, 0), cx.T_isz);
                    sz = cx.b_mul(cx.extract(p, 1), cx.usz(esz));
                }
            } else if pt.kind == ast.TY_PTR {
                let psz = ty.type_size(pt.elem);
                if psz > 0 {
                    addr = cx.ptrtoint(p, cx.T_isz);
                    sz = cx.usz(psz);
                }
            }
            na_addrs.push(addr);
            na_sizes.push(sz);
        }
        if cx.by_ptr(pt) {
            stt.locals[@int_cast(usize, l.index)] = p;  // params are immutable: use the caller's copy directly
            // (its address in an object of its own: -O0 keeps it there, for debuggers)
            let pa = cgrt.alloca_in_entry(cx.T_ptr, "arg.addr".ptr);
            _ = cx.st(p, pa);
            axd.note_local(ir.fnp_of(fi.fnv), l, cgrt.debug_type(l.ty), pa, true);
        } else {
            cgrt.store(pt, p, cgrt.local_ptr(l), false);
        }
    }
    if asan_noalias {
        emit_noalias_checks(d, &na_addrs, &na_sizes);
    }
    na_addrs.deinit();
    na_sizes.deinit();
    if asan_on() {
        cgrt.set_span(d.name_span);
        for i in 0..d.locals.len {
            let l = d.locals.get(i);
            if not l.is_param and l.addr_taken and u.notnil(l.ty) {
                let t = cx.ct(l.ty);
                let sz = ty.type_size(t);
                if ((t.kind == ast.TY_ARRAY) or (t.kind == ast.TY_STRUCT) or (t.kind == ast.TY_UNION)) and (sz > 0) {
                    let fb = cgrt.local_ptr(l);
                    let fa = mem_fn("asan_stack_alloc");
                    let mut aargs: [2]*mut ir.Value = [cx.usz(sz), cx.usz(ty.type_align(t))];
                    let heap_u = cx.call(fa.llty, fa.fnv, aargs[..]);
                    let ok = cx.icmp(ir.IntNE, heap_u, cx.usz(0));
                    let hp = cx.inttoptr(heap_u, cx.T_ptr);
                    stt.locals[@int_cast(usize, l.index)] = ir.select(cx.B, ok, hp, fb);
                    stt.asan_stack.push(cx.AsanStackSlot.{ ptr_u: heap_u, size: sz });
                }
            }
        }
    }
    gen_block(d.body);
    if not cx.terminated() {
        cgrt.set_span(d.name_span);
        if stt.ret.kind == ast.TY_VOID {
            emit_ret(cx.vnil());
        } else if (stt.ret.kind == ast.TY_ERRUNION) and (stt.ret.elem.kind == ast.TY_VOID) {
            emit_ret(cgb.errunion_value(stt.ret, ir.cint(cx.T_i16, 0), cx.vnil()));
        } else {
            ir.unreachable(cx.B);
        }
    }
    if stt.frame > ty.MAX_FRAME {
        _ = dg.err(d.name_span, "E0473",
                   u.f2("the locals of '%s' need more than %s bytes of stack, the most a function can have", d.name,
                        u.dec(ty.MAX_FRAME)));
    }
    cx.at_end(stt.entry);
    if ty.g_target.is_wasm {
        cgrt.check_stack(d, stt.entry, start);
    } else {
        cx.br(start);
    }
    axd.end_function();
    // Delete blocks with no predecessors (continuations after return/break/trap).
    ir.remove_unreachable(ir.fnp_of(stt.fnv));
    stt.defers.deinit();
    stt.loops.deinit();
    stt.asan_stack.deinit();
    cx.F = saved;
}

// ---------------------------------------------------------------------------
// C functions with structures by value (spec §14.5.3)
// ---------------------------------------------------------------------------
// For each such export, cgb.CABI_IMPL + its name: the export's function with
// its structures by pointer (fn_lty_c), for its C wrapper to call.
pub fn emit_cabi_thunks() void {
    for fi in cx.S.cabi_exports.items() {
        let d = fi.decl;
        let cl = cx.fn_lty_c(fi.fnty, true);
        let f = ir.add_function(cx.M, u.cat2(cgb.CABI_IMPL, d.name), cl.t).val;
        cgb.add_ext_attrs_c(f, fi.fnty, cl.sret, false, true);
        cx.at_end(ir.append_block(ir.fnp_of(f), "entry"));
        let np = fi.fnty.params.len;
        let mut nargs = np;
        if fi.sret {
            nargs += 1;
        }
        let av = u.newn.[*mut ir.Value](nargs + 1);
        let mut k: u32 = 0;
        let mut j: usize = 0;
        if cl.sret {
            k = 1;
        }
        if fi.sret {
            av[0] = cgrt.param(f, 0);  // (the result's memory: the caller's)
            j = 1;
        }
        for i in 0..np {
            let pt = fi.fnty.params[i];
            let p = cgrt.param(f, k);
            if cx.cabi_struct(pt, true) and not cx.by_ptr(pt) {
                av[j] = cgrt.load(pt, p, true);
            } else {
                av[j] = p;
            }
            j += 1;
            k += 1;
        }
        let r = cx.call(fi.llty, fi.fnv, av[0..nargs]);
        cgb.add_ext_attrs(r, fi.fnty, fi.sret, true);
        if cl.sret and not fi.sret {
            cgrt.store(fi.fnty.ret, r, cgrt.param(f, 0), true);
            ir.ret_void(cx.B);
        } else if fi.sret or (fi.fnty.ret.kind == ast.TY_VOID) {
            ir.ret_void(cx.B);
        } else {
            ir.ret(cx.B, r);
        }
    }
    cx.S.cabi_exports.clear();
}
