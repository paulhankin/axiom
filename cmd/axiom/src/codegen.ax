// =============================================================================
// codegen.ax - lowering of the checked AST to IR (ir.ax): functions,
// statements, expressions, builtins, strings and globals.
//
// Generic functions are monomorphized here: each (decl, type arguments)
// pair becomes one IR function, generated from the shared, already
// type-checked body by substituting the type arguments. The context and
// small helpers are cgctx.ax's, the runtime's traps and shadow stack
// cgrt.ax's; a run (codegen_program) is cgmain.ax's.
// =============================================================================
import "ast.ax" as ast;
import "axdebug.ax" as axd;
import "c/cc.ax" as cfront;
import "cgctx.ax" as cx;
import "cgrt.ax" as cgrt;
import "diag.ax" as dg;
import "ir.ax" as ir;
import "lexer.ax" as lx;
import "modload.ax" as modl;
import "sema.ax" as sema;
import "semapost.ax" as spost;
import "target.ax" as tg;
import "types.ax" as ty;
import "util.ax" as u;
import "x64caps.ax" as x64c;

// ---------------------------------------------------------------------------
// Strings and globals
// ---------------------------------------------------------------------------
fn dll_import(fname: []u8, lib: []u8) void {
    let gname = u.cat2("axiom.import.", fname);
    if u.notnil(cgrt.named_global(gname)) {
        return;
    }
    let g = ir.add_global(cx.M, ir.t_array(cx.T_i8, @as(u64, lib.len) + 1), gname).val;
    cgrt.set_init(g, ir.cstring(lib));
    cgrt.set_linkage(g, ir.LINK_LINKONCE);
    ir.gv_of(g).is_const = true;
    cgrt.set_align(g, 1);
}

pub fn string_ptr(bytes: []u8) *mut ir.Value {
    let key = u.intern(bytes);
    let mut g = cx.S.string_globals.get(key);
    if u.isnil(g) {
        // A NUL follows every literal (not part of the slice), so that
        // "text".ptr is a valid C string (spec §2.5).
        let init = ir.cstring(bytes);
        g = ir.add_global(cx.M, ir.t_array(cx.T_i8, @as(u64, bytes.len) + 1), ".str").val;
        cgrt.set_init(g, init);
        cgrt.set_linkage(g, ir.LINK_INTERNAL);
        ir.gv_of(g).is_const = true;
        cgrt.set_align(g, 1);
        cx.S.string_globals.put(key, g);
    }
    return g;
}

pub fn const_slice(ptr: *mut ir.Value, len: i64) *mut ir.Value {
    let mut el: [2]*mut ir.Value = [ptr, cx.usz(len)];
    return ir.cstruct(el[..]);
}

fn const_struct2(a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    let mut el: [2]*mut ir.Value = [a, b];
    return ir.cstruct(el[..]);
}

fn const_struct1(a: *mut ir.Value) *mut ir.Value {
    let mut el: [1]*mut ir.Value = [a];
    return ir.cstruct(el[..]);
}

// Constant for a global initializer (spec: constant expressions only).
fn gen_const(e: *mut ast.Expr, t0: *mut ast.Type) *mut ir.Value {
    let t = cx.ct(t0);
    if e.kind == ast.E_CONV {
        if ast.conv_of(e) == ast.CONV_NOOP {
            return gen_const(e.a, t);
        }
        if ast.conv_of(e) == ast.CONV_WRAP_OK {
            if t.elem.kind == ast.TY_VOID {
                return const_struct1(ir.cint(cx.T_i16, 0));
            }
            return const_struct2(ir.cint(cx.T_i16, 0), gen_const(e.a, t.elem));
        }
        if ast.conv_of(e) == ast.CONV_WRAP_ERR {
            let code = gen_const(e.a, ty.t_error);
            if t.elem.kind == ast.TY_VOID {
                return const_struct1(code);
            }
            return const_struct2(code, ir.czero(cx.lty(t.elem)));
        }
    }
    if e.is_const and (t.kind == ast.TY_INT) {
        return cx.cint(cx.lty(t), ast.cval_of(e));
    }
    if e.is_const and (t.kind == ast.TY_FLOAT) {
        return cx.cfloat(t, e);
    }
    if (t.kind == ast.TY_BOOL) and ((e.kind == ast.E_BOOL) or e.is_const) {
        let mut bv: u64 = 0;
        if e.bval {
            bv = 1;
        }
        return ir.cint(cx.T_i8, bv);
    }
    let k = e.kind;
    if k == ast.E_FLOAT {
        return cx.cfloat(t, e);
    }
    if k == ast.E_STRING {
        return const_slice(string_ptr(ast.more(e).str), @int_cast(i64, ast.more(e).str.len));
    }
    if k == ast.E_ERROR_VAL {
        return ir.cint(cx.T_i16, ast.cval_of(e).lo);
    }
    if k == ast.E_ARRAY_LIT {
        let n = ast.args_of(e).len;
        let vs = u.newn.[*mut ir.Value](n + 1);
        for i in 0..n {
            vs[i] = gen_const(ast.args_of(e).get(i), t.elem);
        }
        return ir.carray(cx.lty(t.elem), vs[0..n]);
    }
    if k == ast.E_ARRAY_REPEAT {
        let v = gen_const(e.a, t.elem);
        if ir.is_zero(v) {
            return ir.czero(cx.lty(t));
        }
        let n = @int_cast(usize, t.len);
        let vs = u.newn.[*mut ir.Value](n + 1);
        for i in 0..n {
            vs[i] = v;
        }
        return ir.carray(cx.lty(t.elem), vs[0..n]);
    }
    if k == ast.E_STRUCT_LIT {
        let n = t.decl.fields.len;
        let vs = u.newn.[*mut ir.Value](n + 1);
        for i in 0..n {
            vs[i] = gen_const(ast.more(e).inits.at(i).value, ty.type_field(t, i));
        }
        return ir.cagg(cx.lty(t), vs[0..n]);
    }
    if k == ast.E_FIELD {
        if ast.field_kind_of(e) == ast.FK_VARIANT_UNIT {
            let ut = cx.lty(t);
            let tag = ir.cint(cx.lty(ty.union_tag_type(t)), @int_cast(u64, ast.index_of(e)));
            if ir.field_count(ut) == 1 {
                let mut one: [1]*mut ir.Value = [tag];
                return ir.cagg(ut, one[..]);
            }
            let mut el: [2]*mut ir.Value = [tag, ir.czero(ut.fields[1])];
            return ir.cagg(ut, el[..]);
        }
        if (ast.field_kind_of(e) == ast.FK_DECL) and u.notnil(ast.decl_of(e)) and (ast.decl_of(e).kind == ast.D_FN) {
            return get_inst(ast.decl_of(e), ty.no_types()).fnv;
        }
    } else if k == ast.E_IDENT {
        if u.notnil(ast.decl_of(e)) and ((ast.decl_of(e).kind == ast.D_FN) or (ast.decl_of(e).kind == ast.D_HOST_FN)) {
            return get_inst(ast.decl_of(e), ty.no_types()).fnv;
        }
    } else if k == ast.E_BUILTIN {
        if ast.builtin_of(e) == ast.BI_PTR_FROM_INT {
            return ir.cinttoptr(gen_const(ast.more(e).bargs.at(1).e, ty.t_usize));
        }
    } else if k == ast.E_UNARY {
        if (ast.op_of(e) == lx.TK_MINUS) and (t.kind == ast.TY_FLOAT) {
            if t.bits == 32 {
                return cx.cfloat(t, e);
            }
            return ir.cfp(cx.lty(t), -ast.fval_of(e.a));
        }
    } else if k == ast.E_CALL {
        if ast.call_kind_of(e) == ast.CALLK_VARIANT {
            _ = dg.err(e.span, "E0353", "union constants with a payload are not supported by this compiler yet");
            return ir.czero(cx.lty(t));
        }
    }
    _ = dg.err(e.span, "E0350", "global initializer must be a constant expression");
    return ir.czero(cx.lty(t));
}

// Symbols are prefixed with the module's path (without .ax), which is unique
// within a build, so modules compiled separately never clash.
fn mangle_prefix(d: *mut ast.Decl) []u8 {
    let mut base: []u8 = "";
    if u.notnil(d.module) {
        base = u.file_of(d.module.file.id).display;
    }
    if (base.len > 3) and u.ends(base, ".ax") {
        return u.dup(base[0..base.len - 3]);
    }
    return u.dup(base);
}

// A type in a symbol name: like type_str, but struct and union names are
// qualified by their module, so instances are named the same in every unit.
fn mangle_type_into(b: *mut u.Buf, t: *mut ast.Type) void {
    let k = t.kind;
    if (k == ast.TY_STRUCT) or (k == ast.TY_UNION) {
        if t.decl.anon {  // anonymous structs are the same type everywhere
            b.s("struct{");
            for i in 0..t.decl.fields.len {
                if i != 0 {
                    b.s(",");
                }
                b.s(t.decl.fields.at(i).name);
                b.s(":");
                mangle_type_into(b, ty.type_field(t, i));
            }
            b.s("}");
            return;
        }
        b.s(mangle_prefix(t.decl));
        b.s(".");
        b.s(t.decl.name);
        if t.args.len != 0 {
            b.s("[");
            for i in 0..t.args.len {
                if i != 0 {
                    b.s(",");
                }
                mangle_type_into(b, t.args[i]);
            }
            b.s("]");
        }
    } else if k == ast.TY_PTR {
        b.s(u.pick(t.is_mut, "*mut ", "*"));
        mangle_type_into(b, t.elem);
    } else if k == ast.TY_SLICE {
        b.s(u.pick(t.is_mut, "[]mut ", "[]"));
        mangle_type_into(b, t.elem);
    } else if k == ast.TY_ARRAY {
        b.s("[");
        b.s(u.dec(t.len));
        b.s("]");
        mangle_type_into(b, t.elem);
    } else if k == ast.TY_ERRUNION {
        if u.notnil(t.decl) {
            b.s(mangle_prefix(t.decl));
            b.s(".");
            b.s(t.decl.name);
        }
        b.s("!");
        mangle_type_into(b, t.elem);
    } else if (k == ast.TY_ERROR) and u.notnil(t.decl) {
        b.s(mangle_prefix(t.decl));
        b.s(".");
        b.s(t.decl.name);
    } else if k == ast.TY_FN {
        b.s("fn(");
        for i in 0..t.params.len {
            if i != 0 {
                b.s(",");
            }
            mangle_type_into(b, t.params[i]);
        }
        b.s(")");
        mangle_type_into(b, t.ret);
    } else {
        b.s(ty.type_str(t));
    }
}

fn mangle_type(t: *mut ast.Type) []u8 {
    let mut b = u.Buf.init();
    mangle_type_into(&mut b, t);
    return b.done();
}

// Owner.[A].name.[B], or test "name".
fn fn_display(d: *mut ast.Decl, gargs: []mut *mut ast.Type) []u8 {
    if d.is_test {
        return u.f1("test \"%s\"", d.test_name);
    }
    let n = gargs.len;
    let mut b = u.Buf.init();
    let mut nowner: usize = 0;
    if u.notnil(d.owner) {
        nowner = d.owner.gparams.len;
        b.s(d.owner.name);
        if nowner != 0 {
            b.s(".[");
            for i in 0..nowner {
                if i >= n {
                    break;
                }
                if i != 0 {
                    b.s(", ");
                }
                b.s(ty.type_str(gargs[i]));
            }
            b.s("]");
        }
        b.s(".");
    }
    b.s(d.name);
    let mut nown = d.gparams.len;
    if d.kind == ast.D_HOST_FN {
        nown = 0;
    }
    if nown != 0 {
        b.s(".[");
        for i in n - nown..n {
            if i > (n - nown) {
                b.s(", ");
            }
            b.s(ty.type_str(gargs[i]));
        }
        b.s("]");
    }
    return b.done();
}

// Globals live in the link unit when units are compiled separately (their
// initializers may contain error codes, which only the link unit knows).
pub fn global_ref(d: *mut ast.Decl) *mut ir.Value {
    let k = u.addr_key(@int_from_ptr(d));
    let found = cx.S.global_vals.get(k);
    if u.notnil(found) {
        return found;
    }
    let t = d.ty;
    let mut gname = u.f2("%s.%s", mangle_prefix(d), d.name);
    if d.extern_c or d.is_export {
        gname = d.name;  // (C's object, or one for C: spec §14.5.6)
    }
    if d.extern_c {
        // an object C defines: a declaration (C code may have declared or
        // defined it in the module already)
        let mut ex = ir.get_global(cx.M, gname);
        if u.isnil(ex) {
            ex = ir.add_global(cx.M, cx.lty(t), gname);
            ex.align = @max(ex.align, @bit_cast(u64, ty.type_align(t)));
        }
        cx.S.global_vals.put(k, ex.val);
        return ex.val;
    }
    let g = ir.add_global(cx.M, cx.lty(t), gname).val;
    cgrt.set_align(g, @int_cast(u32, ty.type_align(t)));
    cx.S.global_vals.put(k, g);
    // (on wasm a thread-local lives in the thread's block instead: tls_addr)
    ir.gv_of(g).tls = d.is_tls;
    if cx.O.unit == cx.CG_MODULE {
        return g;  // defined by the link unit
    }
    axd.note_global(d, gname, t, ir.gv_of(g));
    if d.is_export {
        // (C's: external, the program's one definition)
    } else if cx.O.unit == cx.CG_WHOLE {
        // (a constant one has no state to share: the object's own, whose
        // value the optimizer may use)
        if d.is_mut {
            cgrt.set_linkage(g, cx.program_linkage());
        } else {
            cgrt.set_linkage(g, ir.LINK_INTERNAL);
        }
    }
    cgrt.set_init(g, gen_const(d.init, t));
    if cx.O.coverage and is_cov_decl(d, "area") {
        cgrt.set_init(g, cov_global("dummy"));  // (no constant expression says this)
    }
    if not d.is_mut {
        ir.gv_of(g).is_const = true;
    }
    return g;
}

// A global's address in the function being generated.
fn global_addr(d: *mut ast.Decl) *mut ir.Value {
    if d.is_tls and ty.g_target.is_wasm {
        return tls_addr(d);
    }
    return global_ref(d);
}

// Whether the program has thread-locals; on wasm, makes their block's globals.
pub fn tls_globals() bool {
    if u.notnil(cx.S.tls_ty) {
        return true;
    }
    let P = modl.g_prog;
    cx.S.tls_decls.clear();
    for i in 0..P.globals.len {
        let d = P.globals.get(i);
        if d.is_tls {
            cx.S.tls_decls.push(d);
        }
    }
    if cx.S.tls_decls.len == 0 {
        return false;
    }
    let n = cx.S.tls_decls.len;
    let fs = u.newn.[*mut ir.Ty](n + 1);
    for k in 0..n {
        fs[k] = cx.lty(cx.S.tls_decls.get(k).ty);
    }
    cx.S.tls_ty = ir.t_struct(fs[0..n]);
    let mut init = cx.vnil();
    if cx.O.unit != cx.CG_MODULE {
        let vs = u.newn.[*mut ir.Value](n + 1);
        for k in 0..n {
            let d = cx.S.tls_decls.get(k);
            vs[k] = gen_const(d.init, d.ty);
        }
        init = ir.cstruct(vs[0..n]);
    }
    cx.S.tls_main = cgrt.shared_global(cx.S.tls_ty, "axiom.tls.main", init, 0);
    cgrt.set_align(cx.S.tls_main, @int_cast(u32, @max(cx.S.tls_ty.align, 8)));
    cx.S.tls_init = cgrt.shared_global(cx.S.tls_ty, "axiom.tls.init", init, 0);
    cgrt.set_align(cx.S.tls_init, @int_cast(u32, @max(cx.S.tls_ty.align, 8)));
    ir.gv_of(cx.S.tls_init).is_const = true;
    cx.S.tls_ptr = cgrt.shared_global(cx.T_ptr, "axiom.tls", ir.czero(cx.T_ptr), 1);
    return true;
}

fn tls_addr(d: *mut ast.Decl) *mut ir.Value {
    _ = tls_globals();
    let mut field: u32 = 0;
    for k in 0..cx.S.tls_decls.len {
        if cx.S.tls_decls.get(k) == d {
            field = @truncate(u32, k);
        }
    }
    let p = cx.ld(cx.T_ptr, cx.S.tls_ptr);
    let base = ir.select(cx.B, ir.is_null(cx.B, p), cx.S.tls_main, p);
    return cx.sgep(cx.S.tls_ty, base, field);
}

// An error code: a constant, except in module units, where the codes are
// only known at link time (spec §11.1) and are loaded from the link unit.
fn errcode_value(code: u32) *mut ir.Value {
    if (cx.O.unit != cx.CG_MODULE) or (code == 0) or (@as(usize, code) > modl.g_prog.error_names.len) {
        return ir.cint(cx.T_i16, @as(u64, code));
    }
    let name = u.cz(u.f1("axiom.errcode.%s", modl.g_prog.error_names.get(@as(usize, code) - 1)));
    let mut g = cgrt.named_global(u.from_c(name));
    if u.isnil(g) {
        g = ir.add_global(cx.M, cx.T_i16, u.from_c(name)).val;
        ir.gv_of(g).is_const = true;
    }
    return cx.ld(cx.T_i16, g);
}

fn type_mentions_error(t: *mut ast.Type) bool {
    let k = t.kind;
    if (k == ast.TY_ERROR) or (k == ast.TY_ERRUNION) {
        return true;
    }
    if k == ast.TY_ARRAY {
        return type_mentions_error(t.elem);
    }
    if k == ast.TY_STRUCT {
        for i in 0..t.decl.fields.len {
            if type_mentions_error(ty.type_field(t, i)) {
                return true;
            }
        }
        return false;
    }
    if k == ast.TY_UNION {
        return true;  // conservatively
    }
    return false;
}

// ---------------------------------------------------------------------------
// Function instances
// ---------------------------------------------------------------------------
// The extensions a function's code may use, without an attribute: the
// build's (not tg.g_features, which is the current function's while a body
// is generated).
fn base_features(d: *mut ast.Decl) u64 {
    if spost.baseline_fn(d) {
        return 0;
    }
    return cx.S.build_features;
}

pub fn get_inst(d: *mut ast.Decl, gargs: []mut *mut ast.Type) *mut cx.FnInst {
    return get_inst_feats(d, gargs, base_features(d));
}

// The callee of a direct call from the current function. An inline function
// is compiled with its caller's extensions (spec §9.5): one instance per set
// of extensions it is called with, so that @target_has, and lowering that
// depends on extensions, answer for the caller (a version of an @features or
// @multiversion function) into which it is inlined.
fn get_callee(d: *mut ast.Decl, gargs: []mut *mut ast.Type) *mut cx.FnInst {
    if (d.kind == ast.D_FN) and d.is_inline {
        return get_inst_feats(d, gargs, tg.g_features);
    }
    return get_inst(d, gargs);
}

// The symbol of an instance of the function d (not exported, not a host
// function): its module's prefix, owner and name, generic arguments and,
// compiled for its caller's extensions (own_feats), those extensions.
fn inst_symbol(d: *mut ast.Decl, gargs: []mut *mut ast.Type, feats: u64, own_feats: bool) []u8 {
    let n = gargs.len;
    let mut nb = u.Buf.init();
    nb.s(mangle_prefix(d));
    nb.s(".");
    if u.notnil(d.owner) {
        nb.s(d.owner.name);
        nb.s(".");
    }
    nb.s(d.name);
    let nown = d.gparams.len;
    if nown != 0 {
        nb.s(".[");
        for i in n - nown..n {
            if i > (n - nown) {
                nb.s(", ");
            }
            nb.s(mangle_type(gargs[i]));
        }
        nb.s("]");
    }
    if u.notnil(d.owner) and (d.owner.gparams.len != 0) {
        nb.s("@[");
        for i in 0..d.owner.gparams.len {
            if i != 0 {
                nb.s(",");
            }
            nb.s(mangle_type(gargs[i]));
        }
        nb.s("]");
    }
    if own_feats {
        let sfx = tg.features_string(feats & ~cx.S.build_features);
        nb.s(".");
        if sfx.len == 0 {
            nb.s("base");
        } else {
            nb.s(sfx);
        }
    }
    return nb.done();
}

fn get_inst_feats(d: *mut ast.Decl, gargs: []mut *mut ast.Type, feats: u64) *mut cx.FnInst {
    let n = gargs.len;
    let mut kb = u.Buf.init();
    kb.s(u.udec(@as(u64, @int_from_ptr(d))));
    for i in 0..n {
        kb.s(",");
        kb.s(u.idec(gargs[i].id));
    }
    // (an inline function compiled for its caller's extensions)
    let own_feats = feats != base_features(d);
    if own_feats {
        kb.s("#f");
        kb.s(u.udec(feats));
    }
    let k = u.intern(kb.done());
    let found = cx.S.inst_map.get(k);
    if u.notnil(found) {
        return found;
    }
    let fi = u.new.[cx.FnInst]();
    fi.decl = d;
    fi.gargs = gargs;
    fi.key = k;
    fi.feats = feats;
    fi.dispatch = (d.kind == ast.D_FN) and (d.attr != ast.ATTR_NONE);
    if u.notnil(cx.F) {
        fi.depth = cx.F.inst.depth + 1;
    }
    if fi.depth > 64 {
        // (an instance that instantiates its function again with a larger type never ends)
        _ = dg.err(d.name_span, "E0465",
                   u.f1("generic instantiation nested deeper than 64 levels: an instance of '%s' instantiates it again",
                        d.name));
    }
    for i in 0..n {
        if gargs[i].has_params {
            cx.internal_error("generic instance with unsubstituted arguments");
        }
    }
    fi.site = cx.inst_site(d.name_span);
    fi.fnty = d.ty;
    if n != 0 {
        fi.fnty = ty.subst(d.ty, d.all_gparams, gargs);
        cx.check_inst_sizes(fi.fnty, fi.site);
    }
    let host_cabi = d.cabi and (d.kind == ast.D_HOST_FN);
    let fl = cx.fn_lty_c(fi.fnty, host_cabi);
    fi.llty = fl.t;
    fi.sret = fl.sret;
    fi.display = fn_display(d, gargs);
    let mut name = d.name;
    if host_cabi {
        name = u.cat2(CABI_PREFIX, d.name);  // (its wrapper: header.ax, cabi_source)
    } else if d.kind == ast.D_HOST_FN {
        name = d.name;
    } else if d.cabi {
        // an export whose C function is a wrapper (cabi_source) that calls
        // this through emit_cabi_thunks' function
        name = inst_symbol(d, gargs, feats, own_feats);
    } else if d.is_export {
        // On wasm the symbol gets a private name and the export name comes
        // from the wasm-export-name attribute: LLVM treats a symbol called
        // `main` specially on wasm (it would add a second `main` export).
        // Test binaries bring their own `main` (the test driver).
        name = cgrt.export_symbol(d);
    } else {
        name = inst_symbol(d, gargs, feats, own_feats);
    }
    if d.variadic {
        fi.llty = ir.t_fn(fi.llty.ret, fi.llty.params, true);
    }
    let mut existing = cx.vnil();
    if (d.kind == ast.D_HOST_FN) or (d.is_export and cx.S.c_program) {
        // (an export: C code, or an extern "C" block, may have declared it)
        existing = cgrt.named_fn(name);
    }
    if u.notnil(existing) {
        fi.fnv = existing;
        if d.is_export and ir.is_decl(ir.fnp_of(existing)) {
            ir.retype_decl(ir.fnp_of(existing), fi.llty);  // (C's declaration)
        }
    } else {
        fi.fnv = ir.add_function(cx.M, name, fi.llty).val;
    }
    ir.fnp_of(fi.fnv).features = fi.feats;
    ir.fnp_of(fi.fnv).has_features = true;
    ir.fnp_of(fi.fnv).always_inline = (d.kind == ast.D_FN) and d.is_inline;
    // (as LLVM knows malloc: what it returns is a new object, which no
    // pointer the program had before it points into)
    ir.fnp_of(fi.fnv).allocator = (d.kind == ast.D_FN) and u.str_eq(ir.fnp_of(fi.fnv).name, "std/mem.alloc_bytes");
    add_ext_attrs(fi.fnv, fi.fnty, fi.sret, false);
    if d.kind == ast.D_HOST_FN {
        if d.extern_c {
            // libraries: see collect_link_names; on Windows the library is
            // the function's DLL, and on macOS its dylib or framework, which
            // the linker reads from a constant axiom.import.<name> holding
            // its name (cmd/axiom/src/plink.ax, cmd/axiom/src/mlink.ax); on
            // Linux it tells another system's functions (elink.ax)
            if not u.isnos(d.link_lib) {
                dll_import(d.name, d.link_lib);
            }
        } else if ty.g_target.is_wasm {
            cgrt.add_str_attr(fi.fnv, "wasm-import-module", d.host_module);
            cgrt.add_str_attr(fi.fnv, "wasm-import-name", d.name);
        }
    } else {
        // Whole program: everything but exports is internal. Separate units:
        // a non-generic function is defined (externally visible) by its own
        // module's unit and only declared elsewhere; generic instances are
        // defined link-once by every unit that uses them.
        let mut define = fi.depth <= 64;
        if cx.O.unit == cx.CG_LINK {
            define = false;
        } else if (cx.O.unit == cx.CG_MODULE) and (n == 0) {
            define = (d.module == cx.O.module) or own_feats;
        }
        if cgrt.lazy_export(d) and cfront.defines(d.name) {
            define = false;  // a library's: a C unit defines the name, and that is the definition
        }
        if d.cabi and define {
            cx.S.cabi_exports.push(fi);
        }
        if ((cx.O.unit == cx.CG_WHOLE) and (not d.is_export or d.cabi)) or own_feats {
            cgrt.set_linkage(fi.fnv, ir.LINK_INTERNAL);
        } else if define and (n > 0) {
            cgrt.set_linkage(fi.fnv, ir.LINK_LINKONCE);
        } else if cx.g_object_output and d.is_export and modl.is_std_module(d.module) {
            // (the runtime's: one per program, every object's copy the same
            // definition, so the optimizer may inline it as before)
            cgrt.set_linkage(fi.fnv, ir.LINK_LINKONCE);
        }
        let asan_main = cx.S.sanitize_main and not cx.g_test_mode and u.str_eq(d.name, "main");
        if define and d.is_export and ty.g_target.is_wasm and not asan_main and not cgrt.lazy_export(d) and not d.cabi {
            cgrt.add_str_attr(fi.fnv, "wasm-export-name", d.name);
        }
        if define {
            if u.notnil(cx.S.pending_tail) {
                cx.S.pending_tail.next = fi;
            } else {
                cx.S.pending_head = fi;
            }
            cx.S.pending_tail = fi;
        }
    }
    cx.S.inst_map.put(k, fi);
    return fi;
}

// Version k of a function with @features or @multiversion: its body
// compiled with extensions `feats`, under the name of the dispatcher (fi)
// with a suffix, and shown under the function's own name in traces.
fn get_version(fi: *mut cx.FnInst, k: usize, feats: u64) *mut cx.FnInst {
    let key = u.intern(u.f2("%s#v%s", fi.key, u.zdec(k)));
    let found = cx.S.inst_map.get(key);
    if u.notnil(found) {
        return found;
    }
    let v = u.new.[cx.FnInst]();
    v.decl = fi.decl;
    v.gargs = fi.gargs;
    v.key = key;
    v.fnty = fi.fnty;
    v.llty = fi.llty;
    v.sret = fi.sret;
    v.display = fi.display;
    v.feats = feats;
    let mut suffix = tg.features_string(feats & ~cx.S.build_features);
    if suffix.len == 0 {
        suffix = "base";
    }
    v.fnv = ir.add_function(cx.M, u.f2("%s.%s", ir.fnp_of(fi.fnv).name, suffix), v.llty).val;
    ir.fnp_of(v.fnv).features = feats;
    ir.fnp_of(v.fnv).has_features = true;
    cgrt.set_linkage(v.fnv, ir.LINK_INTERNAL);
    add_ext_attrs(v.fnv, v.fnty, v.sret, false);
    if u.notnil(cx.S.pending_tail) {
        cx.S.pending_tail.next = v;
    } else {
        cx.S.pending_head = v;
    }
    cx.S.pending_tail = v;
    cx.S.inst_map.put(key, v);
    return v;
}

// The body of a function with @features or @multiversion: the first
// version whose extensions the running processor has (the build's own
// count as present), else the @multiversion fallback (the target's
// extensions only), or trap T0013 for @features.
fn gen_dispatch(fi: *mut cx.FnInst) void {
    let d = fi.decl;
    let f = fi.fnv;
    cx.at_end(ir.append_block(ir.fnp_of(f), "entry"));
    cgrt.set_span(d.attr_span);
    let nparams = ir.fnp_of(f).params.len;
    let args = u.newn.[*mut ir.Value](nparams + 1);
    for i in 0..nparams {
        args[i] = cgrt.param(f, @int_cast(u32, i));
    }
    let base = fi.feats;
    let mut k: usize = 0;
    let mut done = false;
    for set in d.feat_sets {
        k += 1;
        if (set == spost.NO_VERSION) or done {
            continue;
        }
        let want = base | set;
        let v = get_version(fi, k, want);
        let missing = want & ~tg.g_features;
        if missing == 0 {
            dispatch_call(fi, v, args[0..nparams]);
            done = true;
            continue;
        }
        let yes = ir.append_block(ir.fnp_of(f), "version");
        let no = ir.append_block(ir.fnp_of(f), "next");
        cx.condbr(cpu_has_bits(missing), yes, no);
        cx.at_end(yes);
        dispatch_call(fi, v, args[0..nparams]);
        cx.at_end(no);
    }
    if done {
        return;
    }
    if d.attr == ast.ATTR_MULTIVERSION {
        dispatch_call(fi, get_version(fi, 0, base), args[0..nparams]);
    } else {
        cgrt.call_trap_site(cgrt.site_record(cgrt.T_CPU, d.attr_span));
        ir.unreachable(cx.B);
    }
}

fn dispatch_call(fi: *mut cx.FnInst, v: *mut cx.FnInst, args: []mut *mut ir.Value) void {
    let r = cx.call(fi.llty, v.fnv, args);
    add_ext_attrs(r, fi.fnty, fi.sret, true);
    if fi.llty.ret.kind == ir.T_VOID {
        ir.ret_void(cx.B);
    } else {
        ir.ret(cx.B, r);
    }
}

// std/os/cpu.ax, which every build includes (the start-up check, @cpu_has).
pub fn cpu_fn(name: []u8) *mut cx.FnInst {
    let P = modl.g_prog;
    for i in 0..P.fns.len {
        let d = P.fns.get(i);
        if u.str_eq(d.name, name) and u.notnil(d.module) and
           u.ends(u.file_of(d.module.file.id).display, "std/os/cpu.ax") {
            return get_inst(d, ty.no_types());
        }
    }
    cx.internal_error(u.f1("std/os/cpu.ax has no %s (is --std right?)", name));
    return u.nil.[cx.FnInst]();
}

// Does the running processor have every extension in `bits`? (i1)
fn cpu_has_bits(bits: u64) *mut ir.Value {
    let fi = cpu_fn("features");
    let have = cx.call(fi.llty, fi.fnv, cx.no_vals());
    let m = ir.cint(cx.T_i64, bits);
    return cx.icmp(ir.IntEQ, cx.b_and(have, m), m);
}

// C ABI detail: integers narrower than 32 bits and bool are passed and
// returned sign- or zero-extended. Marking every function (and indirect call)
// this way makes any Axiom function with a scalar signature callable from
// C, and C function pointers callable from Axiom (spec §14.5).
fn ext_attr(v: *mut ir.Value, idx: u32, t0: *mut ast.Type, is_call: bool) void {
    let t = cx.ct(t0);
    let mut kind = u.nosym();
    if t.kind == ast.TY_BOOL {
        kind = "zeroext";
    } else if (t.kind == ast.TY_INT) and (t.bits < 32) {
        kind = u.pick(t.is_signed, "signext", "zeroext");
    }
    if u.isnos(kind) {
        return;
    }
    let mut e: u8 = 1;
    if u.str_eq(kind, "signext") {
        e = 2;
    }
    if is_call {
        ir.ext_of(v)[@as(usize, idx)] = e;
    } else if idx == 0 {
        ir.fnp_of(v).ret_ext = e;
    } else {
        ir.fnp_of(v).param_ext[@as(usize, idx - 1)] = e;
    }
}

fn add_ext_attrs(v: *mut ir.Value, fnty: *mut ast.Type, sret: bool, is_call: bool) void {
    add_ext_attrs_c(v, fnty, sret, is_call, false);
}

fn add_ext_attrs_c(v: *mut ir.Value, fnty: *mut ast.Type, sret: bool, is_call: bool, cabi: bool) void {
    if not sret and (fnty.ret.kind != ast.TY_VOID) {
        ext_attr(v, 0, fnty.ret, is_call);
    }
    let mut first: u32 = 1;
    if sret {
        first = 2;
        if is_call {
            ir.ext_of(v)[1] = ir.EXT_SRET;  // (the result's memory: the call writes it)
        } else {
            ir.fnp_of(v).param_ext[0] = ir.EXT_SRET;
        }
    }
    for i in 0..fnty.params.len {
        if not cx.cabi_struct(fnty.params[i], cabi) {
            ext_attr(v, first + @int_cast(u32, i), fnty.params[i], is_call);
        } else if is_call {
            // an aggregate passed by value, by address: the callee only reads it
            ir.ext_of(v)[@as(usize, first) + i] = ir.EXT_BYVAL;
        } else {
            ir.fnp_of(v).param_ext[@as(usize, first) + i - 1] = ir.EXT_BYVAL;
        }
    }
}

fn subst_gargs(g: []mut *mut ast.Type) []mut *mut ast.Type {
    if g.len == 0 {
        return ty.no_types();
    }
    let r = u.newn.[*mut ast.Type](g.len);
    for i in 0..g.len {
        r[i] = cx.ct(g[i]);
    }
    return r;
}

// ---------------------------------------------------------------------------
// Defers and control flow
// ---------------------------------------------------------------------------
// Runs the pending deferred statements above `down_to`, innermost first.
// `err` says whether control is leaving by returning an error: nil where it
// is not (a block's end, break, continue, so errdefers are skipped), an i1
// where the return value decides at run time, or `always` where it is
// known (`e!`).
fn emit_defers(down_to: usize, err: *mut ir.Value, always: bool) void {
    let mut i = cx.F.defers.len;
    while i > down_to {
        i -= 1;
        if cx.terminated() {
            return;
        }
        let s = cx.F.defers.get(i);
        if ast.stmt_more(s).on_error and u.isnil(err) and not always {
            continue;
        }
        let saved = cx.F.defers.len;
        cx.F.defers.len = i;  // a deferred statement runs with only the outer defers pending
        if ast.stmt_more(s).on_error and not always {
            let run = cx.new_bb("errdefer".ptr);
            let skip = cx.new_bb("errdefer.end".ptr);
            cx.condbr(err, run, skip);
            cx.at_end(run);
            gen_stmt(s.body);
            if not cx.terminated() {
                cx.br(skip);
            }
            cx.at_end(skip);
        } else {
            gen_stmt(s.body);
        }
        cx.F.defers.len = saved;
    }
}

fn emit_ret(v: *mut ir.Value) void {
    if u.notnil(cx.F.sret_ptr) {
        cgrt.store(cx.F.ret, v, cx.F.sret_ptr, false);
        ir.ret_void(cx.B);
    } else if cx.F.ret.kind == ast.TY_VOID {
        ir.ret_void(cx.B);
    } else {
        ir.ret(cx.B, v);
    }
}

fn errunion_value(eu: *mut ast.Type, code: *mut ir.Value, payload: *mut ir.Value) *mut ir.Value {
    let t = cx.lty(eu);
    let mut v = ir.undef(t);
    v = cx.insert(v, code, 0);
    if eu.elem.kind != ast.TY_VOID {
        if u.notnil(payload) {
            v = cx.insert(v, cgrt.to_mem(eu.elem, payload), 1);
        } else {
            v = cx.insert(v, ir.czero(cx.lty(eu.elem)), 1);
        }
    }
    return v;
}

fn gen_return(e: *mut ast.Expr) void {
    let mut v = cx.vnil();
    let mut err = cx.vnil();  // returning an error? (for the errdefers)
    if u.notnil(e) {
        v = gen(e);
        if cx.terminated() {
            return;
        }
        if cx.F.ret.kind == ast.TY_ERRUNION {
            let code = cx.extract(v, 0);
            cgrt.etrace_push(code);
            err = cx.icmp(ir.IntNE, code, ir.cint(cx.T_i16, 0));
        }
    } else if cx.F.ret.kind == ast.TY_ERRUNION {
        v = errunion_value(cx.F.ret, ir.cint(cx.T_i16, 0), cx.vnil());
    }
    emit_defers(0, err, false);
    if cx.terminated() {
        return;
    }
    emit_ret(v);
    cx.dead_block();
}

// break / continue, leaving `depth` loops beyond the innermost.
fn gen_break(is_break: bool, depth: i32) void {
    if cx.F.loops.len == 0 {
        return;
    }
    let mut i = cx.F.loops.len - 1;
    if @int_cast(usize, depth) < i {
        i -= @int_cast(usize, depth);
    } else {
        i = 0;
    }
    let lc = cx.F.loops.get(i);
    emit_defers(lc.defer_height, cx.vnil(), false);
    if is_break {
        cx.br(lc.brk);
    } else {
        cx.br(lc.cont);
    }
    cx.dead_block();
}

// ---------------------------------------------------------------------------
// Arithmetic
// ---------------------------------------------------------------------------
fn int_min(t: *mut ir.Ty) *mut ir.Value {
    let bits = ir.int_width(t);
    return cx.cint(t, u.I128.pow2(bits - 1).neg());
}

fn int_max(t: *mut ir.Ty, is_signed: bool) *mut ir.Value {
    let bits = ir.int_width(t);
    if is_signed {
        return cx.cint(t, u.I128.pow2(bits - 1).sub(u.I128.of(1)));
    }
    return cx.cint(t, u.I128.pow2(bits).sub(u.I128.of(1)));
}

struct Ovf {
    val: *mut ir.Value,
    ovf: *mut ir.Value,
}

// Overflow-checked arithmetic, expressed with plain instructions only.
// (The llvm.*.with.overflow intrinsics would force LLVM's slow SelectionDAG
// path at -O0 on wasm; at -O1+ LLVM re-forms the intrinsics from these
// patterns anyway.)
fn mul_wide_overflow(is_signed: bool, l: *mut ir.Value, r: *mut ir.Value) Ovf {
    let t = l.ty;
    let bits = ir.int_width(t);
    let w = ir.t_int(@int_cast(i32, bits * 2));
    let mut lw = cx.vnil();
    let mut rw = cx.vnil();
    if is_signed {
        lw = cx.sext(l, w);
        rw = cx.sext(r, w);
    } else {
        lw = cx.zext(l, w);
        rw = cx.zext(r, w);
    }
    let p = cx.b_mul(lw, rw);
    let val = cx.trunc(p, t);
    let mut back = cx.vnil();
    if is_signed {
        back = cx.sext(val, w);
    } else {
        back = cx.zext(val, w);
    }
    return Ovf.{ val: val, ovf: cx.icmp(ir.IntNE, back, p) };
}

// 64-bit multiply: the overflow is an intrinsic the native backends compute
// from the machine's multiply (and wasm by dividing back, lower.ax). Wider
// types: no 128-bit multiply needed (freestanding wasm has no compiler-rt);
// overflow is detected by dividing back.
fn mul64_overflow(is_signed: bool, l: *mut ir.Value, r: *mut ir.Value) Ovf {
    let t = l.ty;
    if ir.int_width(t) == 64 {
        let prod = cx.b_mul(l, r);
        let mut xs: [2]*mut ir.Value = [l, r];
        let mut id = ir.IN_UMUL_OV;
        if is_signed {
            id = ir.IN_SMUL_OV;
        }
        return Ovf.{ val: prod, ovf: ir.intr(cx.B, id, cx.T_i1, xs[..]) };
    }
    let zero = ir.czero(t);
    let one = ir.cint(t, 1);
    let prod = cx.b_mul(l, r);
    let lz = cx.icmp(ir.IntEQ, l, zero);
    if not is_signed {
        let div = cx.sel(lz, one, l);
        let back = ir.binop(cx.B, ir.OP_UDIV, prod, div);
        let ne = cx.icmp(ir.IntNE, back, r);  // (right to left, as in the C implementation)
        let ovf = cx.b_and(cx.b_not(lz), ne);
        return Ovf.{ val: prod, ovf: ovf };
    }
    let lm1 = cx.icmp(ir.IntEQ, l, ir.cones(t));
    let safe = cx.b_or(lz, lm1);
    let div = cx.sel(safe, one, l);
    let back = ir.binop(cx.B, ir.OP_SDIV, prod, div);
    let ne = cx.icmp(ir.IntNE, back, r);  // (right to left, as in the C implementation)
    let general = cx.b_and(cx.b_not(safe), ne);
    let m1case = cx.b_and(lm1, cx.icmp(ir.IntEQ, r, int_min(t)));
    return Ovf.{ val: prod, ovf: cx.b_or(general, m1case) };
}

// base: 0 add, 1 sub, 2 mul
fn op_with_overflow(base: i32, is_signed: bool, l: *mut ir.Value, r: *mut ir.Value) Ovf {
    let t = l.ty;
    let zero = ir.czero(t);
    if base == 0 {
        let val = cx.b_add(l, r);
        if is_signed {
            let xr = cx.b_xor(r, val);  // (right to left, as in the C implementation)
            let x = cx.b_and(cx.b_xor(l, val), xr);
            return Ovf.{ val: val, ovf: cx.icmp(ir.IntSLT, x, zero) };
        }
        return Ovf.{ val: val, ovf: cx.icmp(ir.IntULT, val, l) };
    }
    if base == 1 {
        let val = cx.b_sub(l, r);
        if is_signed {
            let xv = cx.b_xor(l, val);  // (right to left, as in the C implementation)
            let x = cx.b_and(cx.b_xor(l, r), xv);
            return Ovf.{ val: val, ovf: cx.icmp(ir.IntSLT, x, zero) };
        }
        return Ovf.{ val: val, ovf: cx.icmp(ir.IntULT, l, r) };
    }
    if ir.int_width(t) <= 32 {
        return mul_wide_overflow(is_signed, l, r);
    }
    return mul64_overflow(is_signed, l, r);
}

fn saturated(t: *mut ir.Ty, neg_direction: *mut ir.Value) *mut ir.Value {
    return cx.sel(neg_direction, int_min(t), int_max(t, true));
}

fn overflow_op(base: i32, is_signed: bool, l: *mut ir.Value, r: *mut ir.Value) *mut ir.Value {
    if cx.O.overflow == cx.OVF_WRAP {
        if base == 0 {
            return cx.b_add(l, r);
        }
        if base == 1 {
            return cx.b_sub(l, r);
        }
        return cx.b_mul(l, r);
    }
    let t = l.ty;
    let o = op_with_overflow(base, is_signed, l, r);
    if cx.O.overflow == cx.OVF_TRAP {
        cgrt.check_or_trap(cx.b_not(o.ovf), cgrt.T_OVERFLOW);
        // (what uses the result comes after the check, where it did not
        // overflow; the check itself reads the operation's own bits, which
        // the flag does not change: ir.F_NSW)
        return cgrt.no_wrap(o.val, is_signed);
    }
    let zero = ir.czero(t);
    let mut s = cx.vnil();
    if base == 2 {
        if is_signed {
            s = saturated(t, cx.icmp(ir.IntSLT, cx.b_xor(l, r), zero));
        } else {
            s = int_max(t, false);
        }
    } else if base == 0 {
        if is_signed {
            s = saturated(t, cx.icmp(ir.IntSLT, l, zero));
        } else {
            s = int_max(t, false);
        }
    } else {
        if is_signed {
            s = saturated(t, cx.icmp(ir.IntSLT, l, zero));
        } else {
            s = zero;
        }
    }
    return cx.sel(o.ovf, s, o.val);
}

// Shift with mathematical semantics for every count (spec §7.6).
fn gen_shift(op: i32, t: *mut ast.Type, x: *mut ir.Value, k: *mut ir.Value) *mut ir.Value {
    let mut lane = t;
    if t.kind == ast.TY_VEC {
        lane = t.elem;
    }
    if (k.ty.kind == ir.T_VEC) and on_x64() and (k.ty.elem.bits == x.ty.elem.bits) {
        // a count per lane, where x86-64 shifts each lane by its own (and
        // counts beyond the lane give 0, or the sign, as here)
        let mut sid = ir.IN_SHLV;
        if op != lx.TK_SHL {
            sid = ir.IN_LSHRV;
            if lane.is_signed {
                sid = ir.IN_ASHRV;
            }
        }
        if x64c.shiftv_ok(sid, x.ty.elem.bits, x.ty.lanes) {
            let mut sargs: [2]*mut ir.Value = [x, k];
            return ir.intr(cx.B, sid, x.ty, sargs[..]);
        }
    }
    if (k.ty.kind == ir.T_VEC) and on_a64() and (k.ty.elem.bits == x.ty.elem.bits) and
       ((@as(u64, @bit_cast(u32, x.ty.lanes * x.ty.elem.bits)) % 128) == 0) {
        // a count per lane, clamped to the lane's bits: USHL / SSHL by it, or by
        // its negation to the right (a64.ax), whose counts of the bits or more
        // give 0, or the sign, as here
        let mut sid = ir.IN_SHLV;
        if op != lx.TK_SHL {
            sid = ir.IN_LSHRV;
            if lane.is_signed {
                sid = ir.IN_ASHRV;
            }
        }
        let bits = ir.splat(cx.B, k.ty, ir.cint(k.ty.elem, @as(u64, @bit_cast(u32, x.ty.elem.bits))));
        let mut margs: [2]*mut ir.Value = [k, bits];
        let kc = ir.intr(cx.B, ir.IN_UMIN, k.ty, margs[..]);
        let mut sargs: [2]*mut ir.Value = [x, kc];
        return ir.intr(cx.B, sid, x.ty, sargs[..]);
    }
    if k.ty.kind == ir.T_VEC {
        // a count per lane: lane by lane
        let mut r = ir.undef(x.ty);
        for i in @as(u64, 0)..@as(u64, @bit_cast(u32, t.lanes)) {
            let y = gen_shift(op, lane, ir.extract_elem(cx.B, x, i), ir.extract_elem(cx.B, k, i));
            r = ir.insert_elem(cx.B, r, y, i);
        }
        return r;
    }
    let n = @int_cast(u32, lane.bits);
    let kty = k.ty;
    let ge = cx.icmp(ir.IntUGE, k, ir.cint(kty, @as(u64, n)));
    let lane_ty = ir.t_int(@int_cast(i32, n));
    let arith = (op == lx.TK_SHR) and lane.is_signed;
    let mut fill: u64 = 0;
    if arith {
        fill = @as(u64, n - 1);
    }
    // Only an arithmetic shift needs its count clamped (to fill with the
    // sign); a shift left or a logical shift right by an out-of-range count
    // computes some value (each backend masks the count) that the select
    // below replaces with 0. The optimizer removes the selects when the
    // count's range is below the width.
    let mut kc = k;
    if arith or ir.is_cint(k) {
        kc = cx.sel(ge, ir.cint(kty, fill), k);
    }
    let kb = ir.int_width(kty);
    if kb > n {
        kc = cx.trunc(kc, lane_ty);
    } else if kb < n {
        kc = cx.zext(kc, lane_ty);
    }
    if t.kind == ast.TY_VEC {
        let vt = x.ty;
        kc = ir.splat(cx.B, vt, kc);
    }
    let mut r = cx.vnil();
    if op == lx.TK_SHL {
        r = ir.binop(cx.B, ir.OP_SHL, x, kc);
    } else if arith {
        return ir.binop(cx.B, ir.OP_ASHR, x, kc);
    } else {
        r = ir.binop(cx.B, ir.OP_LSHR, x, kc);
    }
    return cx.sel(ge, ir.czero(x.ty), r);
}

fn gen_binop(op: i32, t: *mut ast.Type, l: *mut ir.Value, r: *mut ir.Value) *mut ir.Value {
    let is_float = (t.kind == ast.TY_FLOAT) or ty.is_vec_float(t);
    let mut sgn = false;
    if t.kind == ast.TY_INT {
        sgn = t.is_signed;
    } else if t.kind == ast.TY_VEC {
        sgn = t.elem.is_signed;
    }
    let is_vec = t.kind == ast.TY_VEC;  // integer vectors wrap in every mode
    if op == lx.TK_PLUS {
        if is_float {
            return ir.binop(cx.B, ir.OP_FADD, l, r);
        }
        if is_vec {
            return cx.b_add(l, r);
        }
        return overflow_op(0, sgn, l, r);
    }
    if op == lx.TK_MINUS {
        if is_float {
            return ir.binop(cx.B, ir.OP_FSUB, l, r);
        }
        if is_vec {
            return cx.b_sub(l, r);
        }
        return overflow_op(1, sgn, l, r);
    }
    if op == lx.TK_STAR {
        if is_float {
            return ir.binop(cx.B, ir.OP_FMUL, l, r);
        }
        if is_vec {
            return cx.b_mul(l, r);
        }
        return overflow_op(2, sgn, l, r);
    }
    if op == lx.TK_SLASH {
        if is_float {
            return ir.binop(cx.B, ir.OP_FDIV, l, r);
        }
        let tt = l.ty;
        cgrt.check_or_trap(cx.icmp(ir.IntNE, r, ir.czero(tt)), cgrt.T_DIVZERO);
        if not sgn {
            return ir.binop(cx.B, ir.OP_UDIV, l, r);
        }
        if cx.O.overflow == cx.OVF_WRAP {
            // MIN / -1 wraps to MIN: a divisor of -1 negates (as `%` gives 0)
            let m1 = cx.icmp(ir.IntEQ, r, ir.cones(tt));
            let q = ir.binop(cx.B, ir.OP_SDIV, l, cx.sel(m1, ir.cint(tt, 1), r));
            return cx.sel(m1, ir.neg(cx.B, l), q);
        }
        let rm1 = cx.icmp(ir.IntEQ, r, ir.cones(tt));  // (right to left, as in the C implementation)
        let ovf = cx.b_and(cx.icmp(ir.IntEQ, l, int_min(tt)), rm1);
        if cx.O.overflow == cx.OVF_TRAP {
            cgrt.check_or_trap(cx.b_not(ovf), cgrt.T_OVERFLOW);
            return ir.binop(cx.B, ir.OP_SDIV, l, r);
        }
        let r2 = cx.sel(ovf, ir.cint(tt, 1), r);
        let q = ir.binop(cx.B, ir.OP_SDIV, l, r2);
        return cx.sel(ovf, int_max(tt, true), q);
    }
    if op == lx.TK_PERCENT {
        let tt = l.ty;
        cgrt.check_or_trap(cx.icmp(ir.IntNE, r, ir.czero(tt)), cgrt.T_DIVZERO);
        if not sgn {
            return ir.binop(cx.B, ir.OP_UREM, l, r);
        }
        let m1 = cx.icmp(ir.IntEQ, r, ir.cones(tt));
        let r2 = cx.sel(m1, ir.cint(tt, 1), r);
        return ir.binop(cx.B, ir.OP_SREM, l, r2);
    }
    if op == lx.TK_PLUS_PCT {
        return cx.b_add(l, r);
    }
    if op == lx.TK_MINUS_PCT {
        return cx.b_sub(l, r);
    }
    if op == lx.TK_STAR_PCT {
        return cx.b_mul(l, r);
    }
    if op == lx.TK_AMP {
        return cx.b_and(l, r);
    }
    if op == lx.TK_PIPE {
        return cx.b_or(l, r);
    }
    if op == lx.TK_CARET {
        return cx.b_xor(l, r);
    }
    if (op == lx.TK_SHL) or (op == lx.TK_SHR) {
        return gen_shift(op, t, l, r);
    }
    // comparisons
    if is_float {
        let mut p = ir.RealOGE;
        if op == lx.TK_EQEQ {
            p = ir.RealOEQ;
        } else if op == lx.TK_NE {
            p = ir.RealUNE;
        } else if op == lx.TK_LT {
            p = ir.RealOLT;
        } else if op == lx.TK_LE {
            p = ir.RealOLE;
        } else if op == lx.TK_GT {
            p = ir.RealOGT;
        }
        return cx.fcmp(p, l, r);
    }
    let mut p = ir.IntUGE;
    if sgn {
        p = ir.IntSGE;
    }
    if op == lx.TK_EQEQ {
        p = ir.IntEQ;
    } else if op == lx.TK_NE {
        p = ir.IntNE;
    } else if op == lx.TK_LT {
        p = ir.IntULT;
        if sgn {
            p = ir.IntSLT;
        }
    } else if op == lx.TK_LE {
        p = ir.IntULE;
        if sgn {
            p = ir.IntSLE;
        }
    } else if op == lx.TK_GT {
        p = ir.IntUGT;
        if sgn {
            p = ir.IntSGT;
        }
    }
    return cx.icmp(p, l, r);
}

// ---------------------------------------------------------------------------
// Places
// ---------------------------------------------------------------------------
fn addr_or_spill(e: *mut ast.Expr) *mut ir.Value {
    if sema.is_place(e) {
        return gen_addr(e);
    }
    let t = cx.ct(e.ty);
    return cgrt.spill(t, gen(e));
}

// Is e a place whose storage may be misaligned (reached through a pointer)?
fn via_pointer(e: *mut ast.Expr) bool {
    let k = e.kind;
    if k == ast.E_DEREF {
        return true;
    }
    if k == ast.E_FIELD {
        return (ast.self_mode_of(e) == ast.SELF_DEREF) or
               ((ast.field_kind_of(e) == ast.FK_STRUCT) and via_pointer(e.a));
    }
    if k == ast.E_INDEX {
        return (ast.index_kind_of(e) != ast.IDX_ARRAY) or via_pointer(e.a);
    }
    return false;
}

fn array_len_value(arr: *mut ast.Type) *mut ir.Value {
    return cx.usz(arr.len);
}

fn gen_addr_inner(e: *mut ast.Expr) *mut ir.Value {
    let k = e.kind;
    if k == ast.E_IDENT {
        if u.notnil(ast.local_of(e)) {
            return cgrt.local_ptr(ast.local_of(e));
        }
        if u.notnil(ast.decl_of(e)) and (ast.decl_of(e).kind == ast.D_GLOBAL) {
            return global_addr(ast.decl_of(e));
        }
    } else if k == ast.E_DEREF {
        return gen(e.a);
    } else if k == ast.E_FIELD {
        if (ast.field_kind_of(e) == ast.FK_DECL) and u.notnil(ast.decl_of(e)) and
           (ast.decl_of(e).kind == ast.D_GLOBAL) {
            return global_addr(ast.decl_of(e));
        }
        let at = cx.ct(e.a.ty);
        let mut base = cx.vnil();
        let mut stt = at;
        if ast.self_mode_of(e) == ast.SELF_DEREF {
            base = gen(e.a);
            stt = at.elem;
        } else {
            base = addr_or_spill(e.a);
        }
        return cx.sgep(cx.lty(stt), base, @int_cast(u32, ast.index_of(e)));
    } else if k == ast.E_INDEX {
        let at = cx.ct(e.a.ty);
        if ast.index_kind_of(e) == ast.IDX_SLICE {
            let s = gen(e.a);
            let idx = gen(ast.b_of(e));
            let ptr = cx.extract(s, 0);
            let len = cx.extract(s, 1);
            cgrt.check_or_trap(cx.icmp(ir.IntULT, idx, len), cgrt.T_BOUNDS);
            return cx.gep1(cx.lty(at.elem), ptr, idx);
        }
        let mut arr = at;
        let mut base = cx.vnil();
        if ast.index_kind_of(e) == ast.IDX_PTR_ARRAY {
            arr = at.elem;
            base = gen(e.a);
        } else {
            base = addr_or_spill(e.a);
        }
        let idx = gen(ast.b_of(e));
        cgrt.check_or_trap(cx.icmp(ir.IntULT, idx, array_len_value(arr)), cgrt.T_BOUNDS);
        return cx.gep2(cx.lty(arr), base, cx.usz(0), idx);
    }
    // not a place: materialize
    let t = cx.ct(e.ty);
    return cgrt.spill(t, gen(e));
}

// ---------------------------------------------------------------------------
// Calls
// ---------------------------------------------------------------------------
fn emit_call(fty: *mut ir.Ty, fnv: *mut ir.Value, fnty: *mut ast.Type, sret: bool, argv: []mut *mut ir.Value,
             argt: []mut *mut ast.Type, callee: []u8) *mut ir.Value {
    return emit_call_c(fty, fnv, fnty, sret, argv, argt, callee, false);
}

fn emit_call_c(fty: *mut ir.Ty, fnv: *mut ir.Value, fnty: *mut ast.Type, sret: bool, argv: []mut *mut ir.Value,
               argt: []mut *mut ast.Type, callee: []u8, cabi: bool) *mut ir.Value {
    let argc = argv.len;
    let mut n = argc;
    if sret {
        n += 1;
    }
    let av = u.newn.[*mut ir.Value](n + 1);
    let mut k: usize = 0;
    let mut ret_tmp = cx.vnil();
    if sret {
        ret_tmp = cgrt.temp_alloca(fnty.ret);
        av[k] = ret_tmp;
        k += 1;
    }
    for i in 0..argc {
        if cx.cabi_struct(argt[i], cabi) {
            av[k] = cgrt.spill(argt[i], argv[i]);
        } else {
            av[k] = argv[i];
        }
        k += 1;
    }
    let sf = cgrt.ss_push(callee);
    let r = cx.call(fty, fnv, av[0..n]);
    cgrt.ss_pop(sf, r);
    add_ext_attrs_c(r, fnty, sret, true, cabi);
    if sret {
        return cgrt.load(fnty.ret, ret_tmp, false);
    }
    if fnty.ret.kind == ast.TY_VOID {
        return cx.vnil();
    }
    return r;
}

fn gen_call(e: *mut ast.Expr) *mut ir.Value {
    if ast.call_kind_of(e) == ast.CALLK_VARIANT {
        let ut = cx.ct(ast.tval_of(e));
        let tmp = cgrt.temp_alloca(ut);
        let tagp = cx.sgep(cx.lty(ut), tmp, 0);
        let payload = gen(ast.args_of(e).get(0));
        _ = cx.st(ir.cint(cx.lty(ty.union_tag_type(ut)), @int_cast(u64, ast.index_of(e))), tagp);
        let pt = ty.type_variant(ut, @int_cast(usize, ast.index_of(e)));
        let pp = cx.sgep(cx.lty(ut), tmp, 1);
        cgrt.store(pt, payload, pp, true);
        return cgrt.load(ut, tmp, false);
    }
    if ast.call_kind_of(e) == ast.CALLK_INDIRECT {
        let ft = cx.ct(e.a.ty);
        let fp = gen(e.a);
        let n = ast.args_of(e).len;
        let av = u.newn.[*mut ir.Value](n + 1);
        for i in 0..n {
            av[i] = gen(ast.args_of(e).get(i));
        }
        let fl = cx.fn_lty(ft);
        return emit_call(fl.t, fp, ft, fl.sret, av[0..n], ft.params, u.nosym());
    }
    let d = ast.decl_of(e);
    let fi = get_callee(d, subst_gargs(ast.gargs_of(e)));
    let has_recv = u.notnil(ast.b_of(e));
    let mut n = ast.args_of(e).len;
    if has_recv {
        n += 1;
    }
    let av = u.newn.[*mut ir.Value](n + 1);
    let mut k: usize = 0;
    if has_recv {
        let recv = ast.b_of(e);
        let sm = ast.self_mode_of(e);
        if sm == ast.SELF_DEREF {
            let pt = cx.ct(recv.ty);
            av[k] = cgrt.load(pt.elem, gen(recv), true);
        } else if sm == ast.SELF_ADDR {
            av[k] = gen_addr(recv);
        } else {
            av[k] = gen(recv);
        }
        k += 1;
    }
    for i in 0..ast.args_of(e).len {
        av[k] = gen(ast.args_of(e).get(i));
        k += 1;
    }
    let mut argt = fi.fnty.params;
    if d.variadic {  // types of the extra (promoted) arguments
        argt = u.newn.[*mut ast.Type](n + 1);
        let mut off: usize = 0;
        if has_recv {
            off = 1;
        }
        for i in 0..n {
            if i < fi.fnty.params.len {
                argt[i] = fi.fnty.params[i];
            } else {
                argt[i] = cx.ct(ast.args_of(e).get(i - off).ty);
            }
        }
    }
    return emit_call_c(fi.llty, fi.fnv, fi.fnty, fi.sret, av[0..n], argt, fi.display, d.cabi and
                       (d.kind == ast.D_HOST_FN));
}

// ---------------------------------------------------------------------------
// catch / try
// ---------------------------------------------------------------------------
fn gen_try(e: *mut ast.Expr) *mut ir.Value {
    let eu = cx.ct(e.a.ty);
    let v = gen(e.a);
    let code = cx.extract(v, 0);
    let is_err = cx.icmp(ir.IntNE, code, ir.cint(cx.T_i16, 0));
    let err_bb = cx.new_bb("try.err".ptr);
    let ok_bb = cx.new_bb("try.ok".ptr);
    cx.condbr(is_err, err_bb, ok_bb);
    cx.at_end(err_bb);
    cgrt.etrace_push(code);
    let rv = errunion_value(cx.F.ret, code, cx.vnil());
    emit_defers(0, cx.vnil(), true);
    if not cx.terminated() {
        emit_ret(rv);
    }
    cx.at_end(ok_bb);
    if eu.elem.kind == ast.TY_VOID {
        return cx.vnil();
    }
    return cgrt.from_mem(eu.elem, cx.extract(v, 1));
}

fn gen_catch(e: *mut ast.Expr) *mut ir.Value {
    let eu = cx.ct(e.a.ty);
    let vt = eu.elem;
    let v = gen(e.a);
    let code = cx.extract(v, 0);
    let is_err = cx.icmp(ir.IntNE, code, ir.cint(cx.T_i16, 0));
    let err_bb = cx.new_bb("catch.err".ptr);
    let ok_bb = cx.new_bb("catch.ok".ptr);
    let merge = cx.new_bb("catch.end".ptr);
    cx.condbr(is_err, err_bb, ok_bb);
    cx.at_end(err_bb);
    cgrt.etrace_clear();
    if u.notnil(ast.more(e).capture_local) {
        cgrt.store(ty.t_error, code, cgrt.local_ptr(ast.more(e).capture_local), false);
    }
    let mut hv = cx.vnil();
    let mut hbb = cx.bbnil();
    match ast.more(e).handler {
        .Value(h) => {
            hv = gen(h);
            if not cx.terminated() {
                hbb = ir.insert_block(cx.B);
                cx.br(merge);
            }
        }
        .Return(h) => { gen_return(h); }
        .Break     => { gen_break(true, ast.index_of(e)); }
        .Continue  => { gen_break(false, ast.index_of(e)); }
        .Block(blk) => {
            gen_block(blk);
            if not cx.terminated() {
                cx.br(merge);  // only possible for !void
            }
        }
    }
    if not cx.terminated() {
        ir.unreachable(cx.B);
    }
    cx.at_end(ok_bb);
    let mut ov = cx.vnil();
    if vt.kind != ast.TY_VOID {
        ov = cgrt.from_mem(vt, cx.extract(v, 1));
    }
    let obb = ir.insert_block(cx.B);
    cx.br(merge);
    cx.at_end(merge);
    if vt.kind == ast.TY_VOID {
        return cx.vnil();
    }
    if u.isnil(hbb) or u.isnil(hv) {
        return ov;
    }
    let phi = ir.phi(cx.B, cx.vty(vt));
    let mut vals: [2]*mut ir.Value = [ov, hv];
    let mut bbs: [2]*mut ir.Block = [obb, hbb];
    ir.add_incoming(phi, vals[0], bbs[0]);
    ir.add_incoming(phi, vals[1], bbs[1]);
    return phi;
}

// ---------------------------------------------------------------------------
// Builtins
// ---------------------------------------------------------------------------
fn splat(vt: *mut ir.Ty, x: *mut ir.Value, lanes: u32) *mut ir.Value {
    return ir.splat(cx.B, vt, x);
}

// The lanes summed by folding the halves (spec §13.2): lane i plus lane
// i + n/2, until one lane is left. Vectors while the halves are 128 bits or
// more, then lane by lane.
fn reduce_add(vt: *mut ast.Type, v0: *mut ir.Value) *mut ir.Value {
    let is_float = vt.elem.kind == ast.TY_FLOAT;
    let mut v = v0;
    let mut n = @int_cast(usize, vt.lanes);
    let lb = @int_cast(usize, vt.bits);
    while (n > 1) and (((n / 2) * lb) >= 128) {
        let h = n / 2;
        let lo = u.newn.[i32](h);
        let hi = u.newn.[i32](h);
        for i in 0..h {
            lo[i] = @truncate(i32, @bit_cast(isize, i));
            hi[i] = @truncate(i32, @bit_cast(isize, i + h));
        }
        let a = ir.shuffle(cx.B, v, v, lo);
        let b = ir.shuffle(cx.B, v, v, hi);
        if is_float {
            v = ir.binop(cx.B, ir.OP_FADD, a, b);
        } else {
            v = cx.b_add(a, b);
        }
        n = h;
    }
    if (n > 1) and ((n * lb) == 128) {
        // within the 128-bit vector: its upper half's lanes shuffled down and
        // added, the lanes above them ignored
        let l = n;
        while n > 1 {
            let h = n / 2;
            let m = u.newn.[i32](l);
            for i in 0..l {
                m[i] = @truncate(i32, @bit_cast(isize, (i % h) + h));
            }
            let b = ir.shuffle(cx.B, v, v, m);
            if is_float {
                v = ir.binop(cx.B, ir.OP_FADD, v, b);
            } else {
                v = cx.b_add(v, b);
            }
            n = h;
        }
        return cgrt.ext_elem(v, cx.ci32(0));
    }
    let xs = u.newn.[*mut ir.Value](n);
    for i in 0..n {
        xs[i] = cgrt.ext_elem(v, cx.ci32(@as(u64, i)));
    }
    while n > 1 {
        let h = n / 2;
        for i in 0..h {
            if is_float {
                xs[i] = ir.binop(cx.B, ir.OP_FADD, xs[i], xs[i + h]);
            } else {
                xs[i] = cx.b_add(xs[i], xs[i + h]);
            }
        }
        n = h;
    }
    return xs[0];
}

fn ext_int(v: *mut ir.Value, to: *mut ir.Ty, is_signed: bool) *mut ir.Value {
    let a = ir.int_width(v.ty);
    let b = ir.int_width(to);
    if a == b {
        return v;
    }
    if a > b {
        return cx.trunc(v, to);
    }
    if is_signed {
        return cx.sext(v, to);
    }
    return cx.zext(v, to);
}

// x86-64 code generation, which selects some vector builtins whole (where
// the function's extensions have them: x64c.perm_ok and the like).
fn on_x64() bool {
    return tg.g_arch == tg.ARCH_X64;
}

fn on_a64() bool {
    return tg.g_arch == tg.ARCH_A64;
}

// The mask (i64) of the first k lanes, k <= 64: (1 << k) - 1 in two shifts,
// each below 64.
fn lane_mask(k: *mut ir.Value) *mut ir.Value {
    let h = ir.binop(cx.B, ir.OP_LSHR, k, cx.usz(1));
    let one = ir.cint(cx.T_i64, 1);
    let m = ir.binop(cx.B, ir.OP_SHL, ir.binop(cx.B, ir.OP_SHL, one, h), cx.b_sub(k, h));
    return cx.b_sub(m, one);
}

// The integer v (signed or not) converted to the float type t.
fn int_to_float(v: *mut ir.Value, signed: bool, t: *mut ir.Ty) *mut ir.Value {
    if signed {
        return ir.cast(cx.B, ir.OP_SITOFP, v, t);
    }
    return ir.cast(cx.B, ir.OP_UITOFP, v, t);
}

// A lane-wise builtin on a vector (spec §13.2) that the backends have for
// scalars only: lane by lane. `src_signed`: the operand's lanes, for
// @float_from_int.
fn lanewise(id: i32, rt: *mut ast.Type, v: *mut ir.Value, src_signed: bool) *mut ir.Value {
    let n = @as(u64, @bit_cast(u32, rt.lanes));
    let lt = cx.lty(rt.elem);
    let mut r = ir.undef(cx.lty(rt));
    for k in @as(u64, 0)..n {
        let x = ir.extract_elem(cx.B, v, k);
        let mut y = x;
        if (id == ast.BI_CLZ) or (id == ast.BI_CTZ) {
            let mut t: [1]*mut ir.Ty = [x.ty];
            let mut args: [2]*mut ir.Value = [x, ir.cint(cx.T_i1, 0)];
            y = cx.intrinsic(u.pick(id == ast.BI_CLZ, "llvm.ctlz", "llvm.cttz"), t[..], args[..]);
        } else if id == ast.BI_POPCOUNT {
            y = cx.intr1("llvm.ctpop", x);
        } else if id == ast.BI_INT_FROM_FLOAT {
            let mut tys: [2]*mut ir.Ty = [lt, x.ty];
            let mut args: [1]*mut ir.Value = [x];
            y = cx.intrinsic(u.pick(rt.is_signed, "llvm.fptosi.sat", "llvm.fptoui.sat"), tys[..], args[..]);
        } else {
            y = int_to_float(x, src_signed, lt);
        }
        r = ir.insert_elem(cx.B, r, y, k);
    }
    return r;
}

// A vector of n lanes of type lt, each v.
fn const_lanes(lt: *mut ir.Ty, n: usize, v: u64) *mut ir.Value {
    let xs = u.newn.[*mut ir.Value](n);
    for i in 0..n {
        xs[i] = ir.cint(lt, v);
    }
    return ir.cagg(ir.t_vec(lt, @truncate(u32, n)), xs);
}

// @swizzle (spec §13.2): lane i of the result is lane idx[i] of the table, or
// 0 when idx[i] (unsigned) is not a lane. Wider lanes become byte indices,
// min(idx, n) * lanebytes + k for byte k of a lane (at most 64 + 7).
fn swizzle_lanes(t: *mut ast.Type, x: *mut ir.Value, idx: *mut ir.Value) *mut ir.Value {
    let n = @int_cast(usize, t.lanes);
    let lb = @int_cast(usize, t.bits) / 8;
    if lb == 1 {
        let mut sargs: [2]*mut ir.Value = [x, idx];
        return ir.intr(cx.B, ir.IN_SWIZZLE, x.ty, sargs[..]);
    }
    let nb = n * lb;
    let bt = ir.t_vec(cx.T_i8, @truncate(u32, nb));
    let it = idx.ty;
    let cn = const_lanes(it.elem, n, @as(u64, n));
    let m = cx.sext(cx.icmp(ir.IntULT, idx, cn), it);
    let mut cl = cx.b_or(cx.b_and(idx, m), cx.b_and(cn, cx.b_not(m)));
    let mut k: usize = 1;
    while k < lb {
        cl = cx.b_add(cl, cl);
        k *= 2;
    }
    let bytes = cx.bitcast(cl, bt);
    let rep = u.newn.[i32](nb);
    let kk = u.newn.[*mut ir.Value](nb);
    for i in 0..nb {
        rep[i] = @truncate(i32, @bit_cast(isize, (i / lb) * lb));
        kk[i] = ir.cint(cx.T_i8, @as(u64, i % lb));
    }
    let bi = cx.b_add(ir.shuffle(cx.B, bytes, bytes, rep), ir.cagg(bt, kk));
    let mut sargs: [2]*mut ir.Value = [cx.bitcast(x, bt), bi];
    return cx.bitcast(ir.intr(cx.B, ir.IN_SWIZZLE, bt, sargs[..]), x.ty);
}

fn barg(e: *mut ast.Expr, i: usize) *mut ast.Expr {
    return ast.more(e).bargs.at(i).e;
}

// Code for a builtin call (spec §5.7), by family, as sema checks them.
fn gen_builtin(e: *mut ast.Expr) *mut ir.Value {
    let rt = cx.ct(e.ty);
    let id = ast.builtin_of(e);
    if (id <= ast.BI_CAST_SLICE) or (id == ast.BI_INT_FROM_ENUM) or (id == ast.BI_ENUM_FROM_INT) or
       (id == ast.BI_PTR_ADD) or (id == ast.BI_PTR_SUB) {
        return gen_conversion_builtin(e, id, rt);
    }
    if ((id >= ast.BI_MEM_COPY) and (id <= ast.BI_MEMORY_GROW)) or (id == ast.BI_MEMORY_DISCARD) or
       (id == ast.BI_PREFETCH) or (id == ast.BI_PREFETCH_WRITE) {
        return gen_memory_builtin(e, id, rt);
    }
    if (id >= ast.BI_CLZ) and (id <= ast.BI_COPYSIGN) {
        return gen_math_builtin(e, id, rt);
    }
    if ((id >= ast.BI_SPLAT) and (id <= ast.BI_DOT)) or ((id >= ast.BI_LOAD_PARTIAL) and (id <= ast.BI_NARROW)) {
        return gen_vector_builtin(e, id, rt);
    }
    return gen_system_builtin(e, id, rt);
}

fn builtin_missing(e: *mut ast.Expr) *mut ir.Value {
    cx.internal_error(u.f1("builtin @%s not implemented", e.name));
    return cx.vnil();
}

// @int_cast(T, x): x converted to T, trapping unless T holds its value.
fn gen_int_cast(e: *mut ast.Expr, rt: *mut ast.Type) *mut ir.Value {
    let s = cx.ct(barg(e, 1).ty);
    let v = gen(barg(e, 1));
    if s == rt {
        return v;
    }
    // Range check in the source type's width (no 128-bit arithmetic).
    let stt = v.ty;
    let sb = @int_cast(u32, s.bits);
    let tb = @int_cast(u32, rt.bits);
    let mut ok = ir.cint(cx.T_i1, 1);
    if s.is_signed {
        if not rt.is_signed {
            ok = cx.icmp(ir.IntSGE, v, ir.czero(stt));
        } else if tb < sb {
            ok = cx.icmp(ir.IntSGE, v, cx.cint(stt, u.I128.pow2(tb - 1).neg()));
        }
    }
    let mut tmax_bits = tb;  // T.max = 2^tmax_bits - 1
    if rt.is_signed {
        tmax_bits = tb - 1;
    }
    let mut smax_bits = sb;
    if s.is_signed {
        smax_bits = sb - 1;
    }
    if tmax_bits < smax_bits {
        let hi = cx.cint(stt, u.I128.pow2(tmax_bits).sub(u.I128.of(1)));
        let mut p = ir.IntULE;
        if s.is_signed {
            p = ir.IntSLE;
        }
        ok = cx.b_and(ok, cx.icmp(p, v, hi));
    }
    cgrt.check_or_trap(ok, cgrt.T_INTCAST);
    return ext_int(v, cx.lty(rt), s.is_signed);
}

// @enum_from_int(T, x): x, trapping unless it is one of the enum's members.
fn gen_enum_from_int(e: *mut ast.Expr, rt: *mut ast.Type) *mut ir.Value {
    let d = ast.tval_of(e).decl;
    let s = cx.ct(barg(e, 1).ty);
    let v = gen(barg(e, 1));
    let ok = cx.new_bb("enum.ok".ptr);
    let sw = ir.switch_(cx.B, v, cgrt.trap_block(cgrt.T_UNIONTAG));
    let r = ty.int_range(s);
    for i in 0..d.variants.len {
        let x = d.variants.at(i).value;
        if x.ge(r.lo) and x.le(r.hi) {
            ir.add_case(sw, cx.cint(v.ty, x), ok);
        }
    }
    cx.at_end(ok);
    return ext_int(v, cx.lty(rt), s.is_signed);
}

// @cast_slice(T, s): s reinterpreted as a slice of T, trapping unless its bytes
// are a whole number of Ts.
fn gen_cast_slice(e: *mut ast.Expr, rt: *mut ast.Type) *mut ir.Value {
    let stt = cx.ct(barg(e, 1).ty);
    let s = gen(barg(e, 1));
    let from = ty.type_size(stt.elem);
    let to = ty.type_size(rt.elem);
    let len = cx.extract(s, 1);
    let bytes = cx.b_mul(len, cx.usz(from));
    let mut nlen = cx.vnil();
    if to == 0 {
        nlen = cx.usz(0);
    } else {
        cgrt.check_or_trap(cx.icmp(ir.IntEQ, ir.binop(cx.B, ir.OP_UREM, bytes, cx.usz(to)), cx.usz(0)), cgrt.T_LENGTH);
        nlen = ir.binop(cx.B, ir.OP_UDIV, bytes, cx.usz(to));
    }
    return cx.insert(s, nlen, 1);
}

// @size_of ... @cast_slice: types, conversions, pointers and slices.
fn gen_conversion_builtin(e: *mut ast.Expr, id: i32, rt: *mut ast.Type) *mut ir.Value {
    if id == ast.BI_SIZE_OF {
        let t = cx.ct(ast.tval_of(e));
        if (ty.type_size(t) > ty.max_object_size()) and (dg.error_count() == 0) {
            // (the type would have been E0473: a usize could not hold its size)
            cx.internal_error(u.f1("the size of %s reached code generation", ty.type_str(t)));
        }
        return cx.usz(ty.type_size(t));
    }
    if id == ast.BI_ALIGN_OF {
        return cx.usz(ty.type_align(cx.ct(ast.tval_of(e))));
    }
    if id == ast.BI_OFFSET_OF {
        return cx.usz(ty.type_field_offset(cx.ct(ast.tval_of(e)), @int_cast(usize, ast.index_of(barg(e, 1)))));
    }
    if (id == ast.BI_MIN_VALUE) or (id == ast.BI_MAX_VALUE) {
        let r = ty.int_range(rt);
        if id == ast.BI_MIN_VALUE {
            return cx.cint(cx.lty(rt), r.lo);
        }
        return cx.cint(cx.lty(rt), r.hi);
    }
    if id == ast.BI_AS {
        let s = cx.ct(barg(e, 1).ty);
        let v = gen(barg(e, 1));
        if s == rt {
            return v;
        }
        if s.kind == ast.TY_BOOL {
            return cx.zext(v, cx.lty(rt));
        }
        if (s.kind == ast.TY_INT) and (rt.kind == ast.TY_INT) {
            return ext_int(v, cx.lty(rt), s.is_signed);
        }
        if (s.kind == ast.TY_FLOAT) and (rt.kind == ast.TY_FLOAT) {
            return ir.cast(cx.B, ir.OP_FPEXT, v, cx.lty(rt));
        }
        if (s.kind == ast.TY_INT) and (rt.kind == ast.TY_FLOAT) {
            return int_to_float(v, s.is_signed, cx.lty(rt));
        }
        return v;
    }
    if id == ast.BI_INT_FROM_ENUM {
        return gen(barg(e, 0));
    }
    if id == ast.BI_ENUM_FROM_INT {
        return gen_enum_from_int(e, rt);
    }
    if id == ast.BI_INT_CAST {
        return gen_int_cast(e, rt);
    }
    if id == ast.BI_TRUNCATE {
        let s = cx.ct(barg(e, 1).ty);
        return ext_int(gen(barg(e, 1)), cx.lty(rt), s.is_signed);
    }
    if ((id == ast.BI_INT_FROM_FLOAT) or (id == ast.BI_FLOAT_FROM_INT)) and (rt.kind == ast.TY_VEC) {
        let srct = cx.ct(barg(e, 1).ty);
        let v = gen(barg(e, 1));
        if (on_x64() or on_a64()) and (srct.elem.bits == rt.elem.bits) {
            // whole vectors (x64simd.ax and a64.ax convert them, or the lanes one by one)
            let mut op = ir.OP_UITOFP;
            if id == ast.BI_INT_FROM_FLOAT {
                op = ir.OP_FPTOUI_SAT;
                if rt.is_signed {
                    op = ir.OP_FPTOSI_SAT;
                }
            } else if srct.is_signed {
                op = ir.OP_SITOFP;
            }
            return ir.cast(cx.B, op, v, cx.lty(rt));
        }
        return lanewise(id, rt, v, srct.is_signed);
    }
    if id == ast.BI_INT_FROM_FLOAT {
        let v = gen(barg(e, 1));
        let mut tys: [2]*mut ir.Ty = [cx.lty(rt), v.ty];
        let mut args: [1]*mut ir.Value = [v];
        return cx.intrinsic(u.pick(rt.is_signed, "llvm.fptosi.sat", "llvm.fptoui.sat"), tys[..], args[..]);
    }
    if id == ast.BI_FLOAT_FROM_INT {
        let s = cx.ct(barg(e, 1).ty);
        return int_to_float(gen(barg(e, 1)), s.is_signed, cx.lty(rt));
    }
    if id == ast.BI_FLOAT_CAST {
        let s = cx.ct(barg(e, 1).ty);
        let v = gen(barg(e, 1));
        if s.bits == rt.bits {
            return v;
        }
        if s.bits > rt.bits {
            return ir.cast(cx.B, ir.OP_FPTRUNC, v, cx.lty(rt));
        }
        return ir.cast(cx.B, ir.OP_FPEXT, v, cx.lty(rt));
    }
    if id == ast.BI_BIT_CAST {
        let s = cx.ct(barg(e, 1).ty);
        let v = gen(barg(e, 1));
        if s == rt {
            return v;
        }
        if (s.kind == ast.TY_PTR) and (rt.kind != ast.TY_PTR) {
            return cx.ptrtoint(v, cx.lty(rt));
        }
        if (rt.kind == ast.TY_PTR) and (s.kind != ast.TY_PTR) {
            return cx.inttoptr(v, cx.T_ptr);
        }
        if rt.kind == ast.TY_PTR {
            return v;
        }
        return cx.bitcast(v, cx.lty(rt));
    }
    if id == ast.BI_INT_FROM_PTR {
        return cx.ptrtoint(gen(barg(e, 0)), cx.T_isz);
    }
    if id == ast.BI_PTR_FROM_INT {
        return cx.inttoptr(gen(barg(e, 1)), cx.T_ptr);
    }
    if id == ast.BI_PTR_CAST {
        return gen(barg(e, 1));
    }
    if (id == ast.BI_PTR_ADD) or (id == ast.BI_PTR_SUB) {
        let p = gen(barg(e, 0));
        let mut off = cx.b_mul(gen(barg(e, 1)), cx.usz(ty.type_size(rt.elem)));
        if id == ast.BI_PTR_SUB {
            off = ir.neg(cx.B, off);
        }
        return ir.ptradd(cx.B, p, off);
    }
    if id == ast.BI_SLICE_FROM_PTR {
        let p = gen(barg(e, 0));
        let n = gen(barg(e, 1));
        let s = cx.insert(ir.undef(cx.lty(rt)), p, 0);
        return cx.insert(s, n, 1);
    }
    if id == ast.BI_CAST_SLICE {
        return gen_cast_slice(e, rt);
    }
    return builtin_missing(e);
}

// @mem_copy ... @prefetch: memory.
fn gen_memory_builtin(e: *mut ast.Expr, id: i32, rt: *mut ast.Type) *mut ir.Value {
    if id == ast.BI_MEM_COPY {
        let dt = cx.ct(barg(e, 0).ty);
        let d = gen(barg(e, 0));
        let s = gen(barg(e, 1));
        let dl = cx.extract(d, 1);
        let sl = cx.extract(s, 1);
        cgrt.check_or_trap(cx.icmp(ir.IntEQ, dl, sl), cgrt.T_LENGTH);
        let bytes = cx.b_mul(dl, cx.usz(ty.type_size(dt.elem)));
        asan_check_slice(d, dt.elem);
        asan_check_slice(s, dt.elem);
        let sp0 = cx.extract(s, 0);  // (right to left, as in the C implementation)
        _ = ir.memop(cx.B, ir.OP_MEMMOVE, cx.extract(d, 0), sp0, bytes);
        return cx.vnil();
    }
    if id == ast.BI_MEM_SET {
        let dt = cx.ct(barg(e, 0).ty);
        let d = gen(barg(e, 0));
        let v = gen(barg(e, 1));
        let ptr = cx.extract(d, 0);
        let len = cx.extract(d, 1);
        asan_check_slice(d, dt.elem);
        if (dt.elem.kind == ast.TY_INT) and (dt.elem.bits == 8) {
            _ = ir.memop(cx.B, ir.OP_MEMSET, ptr, v, len);
            return cx.vnil();
        }
        // generic loop
        let iv = cgrt.alloca_in_entry(cx.T_isz, "i".ptr);
        _ = cx.st(cx.usz(0), iv);
        let cond = cx.new_bb("memset.cond".ptr);
        let body = cx.new_bb("memset.body".ptr);
        let end = cx.new_bb("memset.end".ptr);
        cx.br(cond);
        cx.at_end(cond);
        let i = cx.ld(cx.T_isz, iv);
        cx.condbr(cx.icmp(ir.IntULT, i, len), body, end);
        cx.at_end(body);
        cgrt.store(dt.elem, v, cx.gep1(cx.lty(dt.elem), ptr, i), true);
        _ = cx.st(cx.b_add(i, cx.usz(1)), iv);
        cx.br(cond);
        cx.at_end(end);
        return cx.vnil();
    }
    if id == ast.BI_MEM_EQ {
        let stt = cx.ct(barg(e, 0).ty);
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        let xl = cx.extract(x, 1);
        let yl = cx.extract(y, 1);
        let xp = cx.extract(x, 0);
        let yp = cx.extract(y, 0);
        let bytes = cx.b_mul(xl, cx.usz(ty.type_size(stt.elem)));
        asan_check_slice(x, stt.elem);
        asan_check_slice(y, cx.ct(barg(e, 1).ty).elem);
        let res = cgrt.alloca_in_entry(cx.T_i1, "eq".ptr);
        let iv = cgrt.alloca_in_entry(cx.T_isz, "i".ptr);
        _ = cx.st(cx.icmp(ir.IntEQ, xl, yl), res);
        _ = cx.st(cx.usz(0), iv);
        let cond = cx.new_bb("memeq.cond".ptr);
        let body = cx.new_bb("memeq.body".ptr);
        let neq = cx.new_bb("memeq.ne".ptr);
        let end = cx.new_bb("memeq.end".ptr);
        cx.br(cond);
        cx.at_end(cond);
        let i = cx.ld(cx.T_isz, iv);
        let lt = cx.icmp(ir.IntULT, i, bytes);  // (right to left, as in the C implementation)
        let more = cx.b_and(cx.ld(cx.T_i1, res), lt);
        cx.condbr(more, body, end);
        cx.at_end(body);
        let bx = cx.ld(cx.T_i8, cx.gep1(cx.T_i8, xp, i));
        let by = cx.ld(cx.T_i8, cx.gep1(cx.T_i8, yp, i));
        _ = cx.st(cx.b_add(i, cx.usz(1)), iv);
        cx.condbr(cx.icmp(ir.IntEQ, bx, by), cond, neq);
        cx.at_end(neq);
        _ = cx.st(ir.cint(cx.T_i1, 0), res);
        cx.br(end);
        cx.at_end(end);
        return cx.ld(cx.T_i1, res);
    }
    if id == ast.BI_MEMORY_SIZE {
        return mem_size();
    }
    if id == ast.BI_MEMORY_GROW {
        let prev = mem_grow(gen(barg(e, 0)));
        let failed = cx.icmp(ir.IntEQ, prev, ir.cones(cx.T_isz));
        let code = cx.sel(failed, errcode_value(sema.error_code_of(u.intern("OutOfMemory"))), ir.cint(cx.T_i16, 0));
        return errunion_value(rt, code, prev);
    }
    if (id == ast.BI_PREFETCH) or (id == ast.BI_PREFETCH_WRITE) {
        // a hint (spec §5.7): the pointer is evaluated; WebAssembly has no
        // prefetch
        let p = gen(barg(e, 0));
        if not ty.g_target.is_wasm {
            let mut args: [1]*mut ir.Value = [p];
            let mut k = ir.IN_PREFETCH;
            if id == ast.BI_PREFETCH_WRITE {
                k = ir.IN_PREFETCHW;
            }
            _ = ir.intr(cx.B, k, cx.T_void, args[..]);
        }
        return cx.vnil();
    }
    if id == ast.BI_MEMORY_DISCARD {
        // WebAssembly memory cannot give pages back: nothing to do there
        let addr = gen(barg(e, 0));
        let len = gen(barg(e, 1));
        if not ty.g_target.is_wasm {
            let mut ps: [2]*mut ir.Ty = [cx.T_isz, cx.T_isz];
            let fty = ir.t_fn(cx.T_void, ps[..], false);
            let mut args: [2]*mut ir.Value = [addr, len];
            _ = cx.call(fty, native_rt_fn("ax_memory_discard", fty), args[..]);
        }
        return cx.vnil();
    }
    return builtin_missing(e);
}

// @clz ... @copysign: integer and float operations.
// Whether the integer type t, or the lanes of the vector type t, are signed.
fn signed_lanes(t: *mut ast.Type) bool {
    if t.kind == ast.TY_INT {
        return t.is_signed;
    }
    return t.elem.is_signed;
}

fn gen_math_builtin(e: *mut ast.Expr, id: i32, rt: *mut ast.Type) *mut ir.Value {
    if ((id == ast.BI_CLZ) or (id == ast.BI_CTZ) or (id == ast.BI_POPCOUNT)) and (rt.kind == ast.TY_VEC) {
        let v = gen(barg(e, 0));
        if on_x64() and (v.ty.elem.bits == cx.lty(rt).elem.bits) {
            // whole vectors (x64simd.ax counts them, or the lanes one by one)
            let mut iid = ir.IN_CTPOP;
            if id == ast.BI_CLZ {
                iid = ir.IN_CTLZ;
            } else if id == ast.BI_CTZ {
                iid = ir.IN_CTTZ;
            }
            let mut args: [1]*mut ir.Value = [v];
            return ir.intr(cx.B, iid, cx.lty(rt), args[..]);
        }
        return lanewise(id, rt, v, false);
    }
    if (id == ast.BI_CLZ) or (id == ast.BI_CTZ) {
        let v = gen(barg(e, 0));
        let mut t: [1]*mut ir.Ty = [v.ty];
        let mut args: [2]*mut ir.Value = [v, ir.cint(cx.T_i1, 0)];
        return cx.intrinsic(u.pick(id == ast.BI_CLZ, "llvm.ctlz", "llvm.cttz"), t[..], args[..]);
    }
    if id == ast.BI_POPCOUNT {
        return cx.intr1("llvm.ctpop", gen(barg(e, 0)));
    }
    if (id == ast.BI_ROTL) or (id == ast.BI_ROTR) {
        let v = gen(barg(e, 0));
        let mut k = gen(barg(e, 1));
        k = ext_int(k, v.ty, false);
        let mut t: [1]*mut ir.Ty = [v.ty];
        let mut args: [3]*mut ir.Value = [v, v, k];
        return cx.intrinsic(u.pick(id == ast.BI_ROTL, "llvm.fshl", "llvm.fshr"), t[..], args[..]);
    }
    if (id == ast.BI_ADD_SAT) or (id == ast.BI_SUB_SAT) {
        let nm = u.f2("llvm.%s%s.sat", u.pick(signed_lanes(rt), "s", "u"), u.pick(id == ast.BI_ADD_SAT, "add", "sub"));
        let a1 = gen(barg(e, 1));  // (right to left, as in the C implementation)
        let a0 = gen(barg(e, 0));
        return cx.intr2(nm, a0, a1);
    }
    if id == ast.BI_MUL_SAT {
        let l = gen(barg(e, 0));
        let r = gen(barg(e, 1));
        let saved = cx.O.overflow;
        cx.O.overflow = cx.OVF_SATURATE;
        let v = overflow_op(2, rt.is_signed, l, r);
        cx.O.overflow = saved;
        return v;
    }
    if (id == ast.BI_ADD_CHECKED) or (id == ast.BI_SUB_CHECKED) or (id == ast.BI_MUL_CHECKED) {
        let t = rt.elem;
        let l = gen(barg(e, 0));
        let r = gen(barg(e, 1));
        let o = op_with_overflow(id - ast.BI_ADD_CHECKED, t.is_signed, l, r);  // (0 add, 1 sub, 2 mul)
        let code = cx.sel(o.ovf, errcode_value(sema.error_code_of(u.intern("Overflow"))), ir.cint(cx.T_i16, 0));
        return errunion_value(rt, code, o.val);
    }
    if (id == ast.BI_MIN) or (id == ast.BI_MAX) {
        let l = gen(barg(e, 0));
        let r = gen(barg(e, 1));
        let mn = id == ast.BI_MIN;
        if (rt.kind == ast.TY_FLOAT) or ty.is_vec_float(rt) {
            return cx.intr2(u.pick(mn, "llvm.minimum", "llvm.maximum"), l, r);
        }
        return cx.intr2(u.f2("llvm.%s%s", u.pick(signed_lanes(rt), "s", "u"), u.pick(mn, "min", "max")), l, r);
    }
    if id == ast.BI_ABS {
        let v = gen(barg(e, 0));
        if (rt.kind == ast.TY_FLOAT) or ty.is_vec_float(rt) {
            return cx.intr1("llvm.fabs", v);
        }
        let t = v.ty;
        let mut tys: [1]*mut ir.Ty = [t];
        if rt.kind == ast.TY_INT {
            let mut is_min = cx.vnil();
            if cx.O.overflow != cx.OVF_WRAP {
                is_min = cx.icmp(ir.IntEQ, v, int_min(t));
            }
            if cx.O.overflow == cx.OVF_TRAP {
                cgrt.check_or_trap(cx.b_not(is_min), cgrt.T_OVERFLOW);
            }
            let mut args: [2]*mut ir.Value = [v, ir.cint(cx.T_i1, 0)];
            let mut r = cx.intrinsic("llvm.abs", tys[..], args[..]);  // @abs(MIN) wraps to MIN
            if cx.O.overflow == cx.OVF_SATURATE {
                r = cx.sel(is_min, int_max(t, true), r);
            }
            return r;
        }
        let mut args: [2]*mut ir.Value = [v, ir.cint(cx.T_i1, 0)];
        return cx.intrinsic("llvm.abs", tys[..], args[..]);  // vectors wrap, as in WASM
    }
    if (id >= ast.BI_SQRT) and (id <= ast.BI_NEAREST) {
        let names = ["llvm.sqrt", "llvm.floor", "llvm.ceil", "llvm.trunc", "llvm.roundeven"];
        return cx.intr1(names[@int_cast(usize, id - ast.BI_SQRT)], gen(barg(e, 0)));
    }
    if id == ast.BI_FMA {
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        let z = gen(barg(e, 2));
        let mut args: [3]*mut ir.Value = [x, y, z];
        if not tg.has_fma() {
            return rt_call_lanes(u.pick(x.ty.bits == 32, "fma32", "fma64"), args[..]);
        }
        return ir.intr(cx.B, ir.IN_FMA, x.ty, args[..]);
    }
    if id == ast.BI_REM {
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        let mut args: [2]*mut ir.Value = [x, y];
        return rt_call_lanes(u.pick(x.ty.bits == 32, "fmod32", "fmod64"), args[..]);
    }
    if id == ast.BI_COPYSIGN {
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        return cx.intr2("llvm.copysign", x, y);
    }
    return builtin_missing(e);
}

// The length and address checks of @load and @store: the slice s (of type
// stt) holds at least vb bytes.
fn check_vec_span(s: *mut ir.Value, stt: *mut ast.Type, vb: i64) void {
    let len = cx.extract(s, 1);
    cgrt.check_or_trap(cx.icmp(ir.IntUGE, len, cx.usz(cx.elems_for(vb, ty.type_size(stt.elem)))), cgrt.T_LENGTH);
    asan_check(cx.extract(s, 0), cx.usz(vb));
}

// @dot(x, y): the lanes' products summed, in pairs (i16), fours (i8) or all (floats).
fn gen_dot(e: *mut ast.Expr, rt: *mut ast.Type) *mut ir.Value {
    let vt = cx.ct(barg(e, 0).ty);
    let x = gen(barg(e, 0));
    let y = gen(barg(e, 1));
    if vt.elem.kind == ast.TY_FLOAT {
        return reduce_add(vt, ir.binop(cx.B, ir.OP_FMUL, x, y));
    }
    if vt.elem.bits == 8 {
        // (u8 by i8 lanes: the first operand's bytes unsigned)
        let sx = vt.elem.is_signed;
        if not sx and on_x64() and x64c.vnni_ok(@as(u64, @bit_cast(u32, vt.lanes))) {
            // (vpdpbusd: x64simd.ax)
            let mut vargs: [2]*mut ir.Value = [x, y];
            return ir.intr(cx.B, ir.IN_DOT_U8I8, cx.lty(rt), vargs[..]);
        }
        if sx and on_a64() and ((@as(u64, @bit_cast(u32, vt.lanes)) % 16) == 0) {
            // (sdot; or fused into the add it feeds: a64.ax)
            let mut sargs: [2]*mut ir.Value = [x, y];
            return ir.intr(cx.B, ir.IN_DOT_I8, cx.lty(rt), sargs[..]);
        }
        // lane by lane
        let n = @as(u64, @bit_cast(u32, rt.lanes));
        let lt = cx.lty(rt.elem);
        let mut r = ir.czero(cx.lty(rt));
        for i in @as(u64, 0)..n {
            let mut s = ir.czero(lt);
            for j in @as(u64, 0)..4 {
                let xa = ext_int(cgrt.ext_elem(x, cx.ci32((4 * i) + j)), lt, sx);
                let ya = ext_int(cgrt.ext_elem(y, cx.ci32((4 * i) + j)), lt, true);
                s = ir.binop(cx.B, ir.OP_ADD, s, ir.binop(cx.B, ir.OP_MUL, xa, ya));
            }
            r = cgrt.ins_elem(r, s, cx.ci32(i));
        }
        return r;
    }
    let mut dargs: [2]*mut ir.Value = [x, y];
    return ir.intr(cx.B, ir.IN_DOT_I16, cx.lty(rt), dargs[..]);
}

// @widen_low, @widen_high: half the lanes, each extended to twice its width.
fn gen_widen(e: *mut ast.Expr, id: i32, rt: *mut ast.Type) *mut ir.Value {
    let vt = cx.ct(barg(e, 0).ty);
    let v = gen(barg(e, 0));
    let wbits = @as(u64, @bit_cast(u32, vt.lanes * vt.elem.bits));
    if (on_a64() and ((wbits % 128) == 0)) or (on_x64() and x64c.widen_ok(wbits)) {
        // (sxtl, uxtl2 ...; or fused into the multiply they feed: a64.ax; pmovsx,
        // pmovzx: x64simd.ax)
        let mut wid = ir.IN_SWIDEN_LO;
        if not vt.elem.is_signed {
            wid = ir.IN_UWIDEN_LO;
        }
        if id == ast.BI_WIDEN_HIGH {
            wid += 1;
        }
        let mut wargs: [1]*mut ir.Value = [v];
        return ir.intr(cx.B, wid, cx.lty(rt), wargs[..]);
    }
    // lane by lane: WebAssembly's extend_low/extend_high
    let n = @as(u64, @bit_cast(u32, rt.lanes));
    let mut base: u64 = 0;
    if id == ast.BI_WIDEN_HIGH {
        base = n;
    }
    let lt = cx.lty(rt.elem);
    let mut r = ir.czero(cx.lty(rt));
    for i in @as(u64, 0)..n {
        let x = ext_int(cgrt.ext_elem(v, cx.ci32(base + i)), lt, vt.elem.is_signed);
        r = cgrt.ins_elem(r, x, cx.ci32(i));
    }
    return r;
}

// @narrow(T, x, y): the lanes of x then y, lane by lane, each saturated to
// the result's range: WebAssembly's narrow_*_sat, by the operand and result
// lane types.
fn gen_narrow(e: *mut ast.Expr, rt: *mut ast.Type) *mut ir.Value {
    let vt = cx.ct(barg(e, 1).ty);
    let x = gen(barg(e, 1));
    let y = gen(barg(e, 2));
    let n = @as(u64, @bit_cast(u32, vt.lanes));
    let wt = cx.lty(vt.elem);
    let lt = cx.lty(rt.elem);
    let bits = @as(u64, @bit_cast(u32, rt.elem.bits));
    let mut hi: u64 = (@as(u64, 1) << bits) - 1;
    let mut lo: u64 = 0;
    if rt.elem.is_signed {
        hi = (@as(u64, 1) << (bits - 1)) - 1;
        lo = 0 -% (@as(u64, 1) << (bits - 1));
    }
    let mut r = ir.czero(cx.lty(rt));
    for i in @as(u64, 0)..(2 * n) {
        let mut src = x;
        let mut k = i;
        if i >= n {
            src = y;
            k = i - n;
        }
        let mut l = cgrt.ext_elem(src, cx.ci32(k));
        if vt.elem.is_signed {
            l = cx.sel(cx.icmp(ir.IntSLT, l, ir.cint(wt, lo)), ir.cint(wt, lo), l);
            l = cx.sel(cx.icmp(ir.IntSGT, l, ir.cint(wt, hi)), ir.cint(wt, hi), l);
        } else {
            l = cx.sel(cx.icmp(ir.IntUGT, l, ir.cint(wt, hi)), ir.cint(wt, hi), l);
        }
        r = cgrt.ins_elem(r, cx.trunc(l, lt), cx.ci32(i));
    }
    return r;
}

// @load_partial(T, s): the first min(len, n) lanes copied to a zeroed vector.
fn gen_load_partial(e: *mut ast.Expr, rt: *mut ast.Type) *mut ir.Value {
    let s = gen(barg(e, 1));
    let p = cx.extract(s, 0);
    let len = cx.extract(s, 1);
    let n = cx.usz(@as(i64, rt.lanes));
    let k = cx.sel(cx.icmp(ir.IntULT, len, n), len, n);
    if on_x64() and x64c.partial_ok(@int_cast(i32, rt.elem.bits), @int_cast(i32, rt.lanes)) {
        let mut pargs: [2]*mut ir.Value = [p, lane_mask(k)];
        return ir.intr(cx.B, ir.IN_LOAD_PARTIAL, cx.lty(rt), pargs[..]);
    }
    let tmp = cgrt.alloca_in_entry(cx.lty(rt), "partial".ptr);
    _ = ir.memop(cx.B, ir.OP_MEMSET, tmp, ir.cint(cx.T_i8, 0), cx.usz(ty.type_size(rt)));
    _ = ir.memop(cx.B, ir.OP_MEMMOVE, tmp, p, cx.b_mul(k, cx.usz(ty.type_size(rt.elem))));
    return cgrt.load(rt, tmp, true);
}

// @store_partial(s, v): the first min(len, n) lanes of v stored to s.
fn gen_store_partial(e: *mut ast.Expr) *mut ir.Value {
    let vt = cx.ct(barg(e, 1).ty);
    let s = gen(barg(e, 0));
    let v = gen(barg(e, 1));
    let p = cx.extract(s, 0);
    let len = cx.extract(s, 1);
    let n = cx.usz(@as(i64, vt.lanes));
    let k = cx.sel(cx.icmp(ir.IntULT, len, n), len, n);
    if on_x64() and x64c.partial_ok(@int_cast(i32, vt.elem.bits), @int_cast(i32, vt.lanes)) {
        let mut pargs: [3]*mut ir.Value = [v, p, lane_mask(k)];
        _ = ir.intr(cx.B, ir.IN_STORE_PARTIAL, cx.T_void, pargs[..]);
        return cx.vnil();
    }
    let tmp = cgrt.alloca_in_entry(cx.lty(vt), "partial".ptr);
    cgrt.store(vt, v, tmp, true);
    _ = ir.memop(cx.B, ir.OP_MEMMOVE, p, tmp, cx.b_mul(k, cx.usz(ty.type_size(vt.elem))));
    return cx.vnil();
}

// @splat ... @narrow: SIMD vectors.
fn gen_vector_builtin(e: *mut ast.Expr, id: i32, rt: *mut ast.Type) *mut ir.Value {
    if id == ast.BI_SPLAT {
        let mut x = gen(barg(e, 0));
        // a literal splatted to a FloatVector parameter is an f64
        let xt = cx.ct(barg(e, 0).ty);
        if (xt.kind == ast.TY_FLOAT) and (xt.bits > rt.elem.bits) {
            x = ir.cast(cx.B, ir.OP_FPTRUNC, x, cx.lty(rt.elem));
        }
        return splat(cx.lty(rt), x, @int_cast(u32, rt.lanes));
    }
    if id == ast.BI_VEC {
        let mut v = ir.undef(cx.lty(rt));
        for i in 1..ast.more(e).bargs.len {
            v = cgrt.ins_elem(v, gen(barg(e, i)), cx.ci32(@as(u64, i - 1)));
        }
        return v;
    }
    if id == ast.BI_EXTRACT_LANE {
        let v = gen(barg(e, 0));
        return cgrt.ext_elem(v, cx.ci32(ast.cval_of(barg(e, 1)).lo));
    }
    if id == ast.BI_REPLACE_LANE {
        let v = gen(barg(e, 0));
        let x = gen(barg(e, 2));
        return cgrt.ins_elem(v, x, cx.ci32(ast.cval_of(barg(e, 1)).lo));
    }
    if id == ast.BI_LOAD {
        let stt = cx.ct(barg(e, 1).ty);
        let s = gen(barg(e, 1));
        check_vec_span(s, stt, ty.type_size(rt));
        return cgrt.load(rt, cx.extract(s, 0), true);
    }
    if id == ast.BI_STORE {
        let stt = cx.ct(barg(e, 0).ty);
        let vt = cx.ct(barg(e, 1).ty);
        let s = gen(barg(e, 0));
        let v = gen(barg(e, 1));
        check_vec_span(s, stt, ty.type_size(vt));
        cgrt.store(vt, v, cx.extract(s, 0), true);
        return cx.vnil();
    }
    if id == ast.BI_SHUFFLE {
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        let idx = barg(e, 2);
        let m = u.newn.[i32](ast.args_of(idx).len + 1);
        for i in 0..ast.args_of(idx).len {
            m[i] = @truncate(i32, ast.cval_of(ast.args_of(idx).get(i)).lo);
        }
        return ir.shuffle(cx.B, x, y, m[0..ast.args_of(idx).len]);
    }
    if id == ast.BI_SWIZZLE {
        let x = gen(barg(e, 0));
        let idx = gen(barg(e, 1));
        if on_x64() and (idx.ty.elem.bits == x.ty.elem.bits) and x64c.perm_ok(x.ty.elem.bits, x.ty.lanes, false) {
            let mut pargs: [2]*mut ir.Value = [x, idx];
            return ir.intr(cx.B, ir.IN_PERM, x.ty, pargs[..]);
        }
        return swizzle_lanes(rt, x, idx);
    }
    if id == ast.BI_SWIZZLE2 {
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        let idx = gen(barg(e, 2));
        if on_x64() and (idx.ty.elem.bits == x.ty.elem.bits) and x64c.perm_ok(x.ty.elem.bits, x.ty.lanes, true) {
            let mut pargs: [3]*mut ir.Value = [x, y, idx];
            return ir.intr(cx.B, ir.IN_PERM2, x.ty, pargs[..]);
        }
        // indices below n pick from x (in y they wrap to beyond its lanes),
        // the others from y
        let lo = swizzle_lanes(rt, x, idx);
        let cn = const_lanes(idx.ty.elem, @int_cast(usize, rt.lanes), @as(u64, @bit_cast(u32, rt.lanes)));
        let hi = swizzle_lanes(rt, y, cx.b_sub(idx, cn));
        return cx.bitcast(cx.b_or(cx.bitcast(lo, idx.ty), cx.bitcast(hi, idx.ty)), x.ty);
    }
    if id == ast.BI_LOAD_PARTIAL {
        return gen_load_partial(e, rt);
    }
    if id == ast.BI_STORE_PARTIAL {
        return gen_store_partial(e);
    }
    if (id >= ast.BI_LANES_EQ) and (id <= ast.BI_LANES_GE) {
        let vt = cx.ct(barg(e, 0).ty);
        let x = gen(barg(e, 0));
        let y = gen(barg(e, 1));
        let ops = [lx.TK_EQEQ, lx.TK_NE, lx.TK_LT, lx.TK_LE, lx.TK_GT, lx.TK_GE];
        let c = gen_binop(ops[@int_cast(usize, id - ast.BI_LANES_EQ)], vt, x, y);
        return cx.sext(c, cx.lty(rt));
    }
    if id == ast.BI_SELECT {
        let m = gen(barg(e, 0));
        let x = gen(barg(e, 1));
        let y = gen(barg(e, 2));
        let mt = m.ty;
        let xm = cx.bitcast(x, mt);
        let ym = cx.bitcast(y, mt);
        let ynm = cx.b_and(ym, cx.b_not(m));  // (right to left, as in the C implementation)
        let r = cx.b_or(cx.b_and(xm, m), ynm);
        return cx.bitcast(r, cx.lty(rt));
    }
    if id == ast.BI_ANY_TRUE {
        let v = gen(barg(e, 0));
        let mut aargs: [1]*mut ir.Value = [v];
        return ir.intr(cx.B, ir.IN_ANYTRUE, cx.T_i1, aargs[..]);
    }
    if id == ast.BI_ALL_TRUE {
        let v = gen(barg(e, 0));
        let vt = cx.ct(barg(e, 0).ty);
        let mut iv = v;
        if vt.elem.kind == ast.TY_FLOAT {
            iv = cx.bitcast(v, ir.t_vec(ir.t_int(vt.elem.bits), @int_cast(u32, vt.lanes)));
        }
        let mut aargs: [1]*mut ir.Value = [iv];
        return ir.intr(cx.B, ir.IN_ALLTRUE, cx.T_i1, aargs[..]);
    }
    if id == ast.BI_BITMASK {
        let v = gen(barg(e, 0));
        let mut bargs: [1]*mut ir.Value = [v];
        return ir.intr(cx.B, ir.IN_BITMASK, cx.lty(rt), bargs[..]);  // (u64 for 64 lanes)
    }
    if id == ast.BI_REDUCE_ADD {
        return reduce_add(cx.ct(barg(e, 0).ty), gen(barg(e, 0)));
    }
    if id == ast.BI_DOT {
        return gen_dot(e, rt);
    }
    if (id == ast.BI_WIDEN_LOW) or (id == ast.BI_WIDEN_HIGH) {
        return gen_widen(e, id, rt);
    }
    if id == ast.BI_NARROW {
        return gen_narrow(e, rt);
    }
    return builtin_missing(e);
}

// @trap, the target and processor queries, tests, atomics and @error_name.
fn gen_system_builtin(e: *mut ast.Expr, id: i32, rt: *mut ast.Type) *mut ir.Value {
    if id == ast.BI_TRAP {
        cgrt.emit_trap(cgrt.T_TRAP);
        return cx.vnil();
    }
    if id == ast.BI_MEMORY_ERROR {
        cgrt.emit_trap(cgrt.T_MEMORY);
        return cx.vnil();
    }
    if id == ast.BI_SANITIZE_ADDRESS {
        if cx.O.sanitize_address {
            return ir.cint(cx.T_i1, 1);
        }
        return ir.cint(cx.T_i1, 0);
    }
    if (id == ast.BI_TARGET_HAS) or (id == ast.BI_TARGET_ARCH) or (id == ast.BI_TARGET_OS) or (id == ast.BI_CPU_HAS) {
        let tc = spost.target_cond(e, tg.g_features);
        if tc >= 0 {
            return ir.cint(cx.T_i1, @as(u64, @bit_cast(u32, tc)));
        }
        // @cpu_has of an extension the build does not assume
        let b = tg.feature_bit(ast.more(barg(e, 0)).str);
        if (b == 0) or ty.g_target.is_wasm {
            return ir.cint(cx.T_i1, 0);
        }
        return cpu_has_bits(b);
    }
    if id == ast.BI_X86_CPUID {
        let mut cargs: [2]*mut ir.Value = [gen(barg(e, 0)), gen(barg(e, 1))];
        return ir.intr(cx.B, ir.IN_CPUID, cx.lty(rt), cargs[..]);
    }
    if id == ast.BI_X86_XGETBV {
        let mut xargs: [1]*mut ir.Value = [gen(barg(e, 0))];
        return ir.intr(cx.B, ir.IN_XGETBV, cx.T_i64, xargs[..]);
    }
    if (id >= ast.BI_X86_AESENC) and (id <= ast.BI_ARM_CRC32C) {
        let n = ast.more(e).bargs.len;
        let args = u.newn.[*mut ir.Value](n + 1);
        for k in 0..n {
            args[k] = gen(barg(e, k));
        }
        return ir.intr(cx.B, ir.IN_AESENC + (id - ast.BI_X86_AESENC), cx.lty(rt), args[0..n]);
    }
    if id == ast.BI_EXPECT {
        cgrt.check_or_trap(gen(barg(e, 0)), cgrt.T_EXPECT);
        return cx.vnil();
    }
    if id == ast.BI_EXPECT_EQ {
        gen_expect_eq(e);
        return cx.vnil();
    }
    if id == ast.BI_FENCE {
        _ = ir.fence(cx.B);
        return cx.vnil();
    }
    if (id >= ast.BI_ATOMIC_LOAD) and (id <= ast.BI_ATOMIC_NOTIFY) {
        return gen_atomic(e);
    }
    if id == ast.BI_ERROR_NAME {
        let code = gen(barg(e, 0));
        let f = error_name_fn();
        let mut args: [1]*mut ir.Value = [code];
        return cx.call(error_name_fty(), f, args[..]);
    }
    return builtin_missing(e);
}

// A function of std/c/rt/ldouble.ax (loaded with a C program whose long
// double is wider than double), std/c/rt/wideint.ax (with one that uses
// integers wider than 64 bits; its names begin with wi_),
// std/c/rt/decimal.ax (with one that operates on decimal floating values;
// dec_) or std/os/cpu.ax ("cpu." and the name), which the C front end's
// code calls: its IR function, generated once the C units are (gen_pending).
pub fn c_ld_fn(name0: []u8) *mut ir.Value {
    let P = modl.g_prog;
    let mut name = name0;
    let mut file = u.pick(u.starts(name, "wi_"), "std/c/rt/wideint.ax", "std/c/rt/ldouble.ax");
    if u.starts(name, "dec_") {
        file = "std/c/rt/decimal.ax";
    } else if u.starts(name, "cpu.") {
        // (std/os/cpu.ax, which every build includes: __builtin_cpu_supports)
        name = name[4..];
        file = "std/os/cpu.ax";
    }
    for i in 0..P.fns.len {
        let d = P.fns.get(i);
        if u.str_eq(d.name, name) and u.notnil(d.module) and u.ends(u.file_of(d.module.file.id).display, file) {
            return get_inst(d, ty.no_types()).fnv;
        }
    }
    cx.internal_error(u.f2("function %s of %s not found", name, file));
    return cx.vnil();
}

// A function of std/internal/runtime/rt.ax (loaded with every program that is built).
fn rt_fn(name: []u8) *mut cx.FnInst {
    let P = modl.g_prog;
    for i in 0..P.fns.len {
        let d = P.fns.get(i);
        if u.str_eq(d.name, name) and u.notnil(d.module) and
           u.ends(u.file_of(d.module.file.id).display, "std/internal/runtime/rt.ax") {
            return get_inst(d, ty.no_types());
        }
    }
    cx.internal_error(u.f1("runtime function %s not found (is std/internal/runtime/rt.ax missing?)", name));
    return u.nil.[cx.FnInst]();
}

// --sanitize=address (spec §16.8): an access of `size` bytes at `addr` is
// checked against std/mem.ax's shadow memory (mem.asan_check), trapping with
// T0012 when it touches memory that is not allocated. The allocator itself
// and the runtime are not checked.
fn asan_on() bool {
    if not cx.O.sanitize_address or u.isnil(cx.F) or u.isnil(cx.F.decl) or u.isnil(cx.F.decl.module) {
        return false;
    }
    let f = u.file_of(cx.F.decl.module.file.id).display;
    return not u.str_eq(f, "std/mem.ax") and not u.starts(f, "std/internal/runtime/");
}

// --coverage=afl: the functions with coverage counters (cover.ax), all but
// the runtime's (std/internal/runtime/, which has the coverage runtime).
fn cov_on(m: *ast.Module) bool {
    if not cx.O.coverage or u.isnil(m) {
        return false;
    }
    return not u.starts(u.file_of(m.file.id).display, "std/internal/runtime/");
}

fn is_cov_decl(d: *ast.Decl, name: []u8) bool {
    return u.str_eq(d.name, name) and u.notnil(d.module) and
           u.ends(u.file_of(d.module.file.id).display, "std/internal/runtime/coverage.ax");
}

// A global of the coverage runtime (std/internal/runtime/coverage.ax).
pub fn cov_global(name: []u8) *mut ir.Value {
    let P = modl.g_prog;
    for i in 0..P.globals.len {
        let d = P.globals.get(i);
        if is_cov_decl(d, name) {
            return global_addr(d);
        }
    }
    cx.internal_error(u.f1("std/internal/runtime/coverage.ax has no %s (is --std right?)", name));
    return u.nil.[ir.Value]();
}

pub fn mem_fn(name: []u8) *mut cx.FnInst {
    let P = modl.g_prog;
    for i in 0..P.fns.len {
        let d = P.fns.get(i);
        if u.str_eq(d.name, name) and u.notnil(d.module) and
           u.str_eq(u.file_of(d.module.file.id).display, "std/mem.ax") {
            return get_inst(d, ty.no_types());
        }
    }
    cx.internal_error(u.f1("std/mem.ax has no %s (is --std right?)", name));
    return u.nil.[cx.FnInst]();
}

fn mem_global(name: []u8) *mut ir.Value {
    let P = modl.g_prog;
    for i in 0..P.globals.len {
        let d = P.globals.get(i);
        if u.str_eq(d.name, name) and u.notnil(d.module) and
           u.str_eq(u.file_of(d.module.file.id).display, "std/mem.ax") {
            return global_addr(d);
        }
    }
    cx.internal_error(u.f1("std/mem.ax has no %s (is --std right?)", name));
    return u.nil.[ir.Value]();
}

// The check is inline for the common cases: an access of at most 8 bytes
// within one granule of tracked (heap) memory whose shadow byte is 0, or an
// access within one 64 KiB page that the sanitizer does not track (stack,
// globals). It walks std/mem.ax's shadow tables (as_base, as_l1, then the
// page's table and its shadow bytes) and calls mem.asan_check, which
// reports, only when that fails.
fn asan_check(addr: *mut ir.Value, size: *mut ir.Value) void {
    if not asan_on() {
        return;
    }
    let a = cx.ptrtoint(addr, cx.T_isz);
    let l1_bb = cx.new_bb("asan.l1".ptr);
    let l2_bb = cx.new_bb("asan.l2".ptr);
    let sh_bb = cx.new_bb("asan.shadow".ptr);
    let untracked = cx.new_bb("asan.untracked".ptr);
    let slow = cx.new_bb("asan.slow".ptr);
    let done = cx.new_bb("asan.ok".ptr);
    let base = cx.ld(cx.T_isz, mem_global("as_base"));
    let rel = cx.b_sub(ir.binop(cx.B, ir.OP_LSHR, a, cx.usz(16)), base);
    cx.condbr(cx.icmp(ir.IntULT, rel, cx.usz(1 << 24)), l1_bb, untracked);
    // the page's table
    cx.at_end(l1_bb);
    let entry = cx.gep1(cx.T_isz, mem_global("as_l1"), ir.binop(cx.B, ir.OP_LSHR, rel, cx.usz(12)));
    let l2 = cx.ld(cx.T_isz, entry);
    cx.condbr(cx.icmp(ir.IntNE, l2, cx.usz(0)), l2_bb, untracked);
    // the page's shadow
    cx.at_end(l2_bb);
    let slot = cx.b_add(l2, cx.b_mul(cx.b_and(rel, cx.usz(4095)), cx.usz(8)));
    let sp64 = cx.ld(cx.T_i64, cx.inttoptr(slot, cx.T_ptr));
    let mut sp = sp64;
    if cx.T_isz != cx.T_i64 {
        sp = cx.trunc(sp64, cx.T_isz);
    }
    cx.condbr(cx.icmp(ir.IntNE, sp, cx.usz(0)), sh_bb, untracked);
    // the granule: all 8 bytes usable, and the access within it
    cx.at_end(sh_bb);
    let sa = cx.b_add(sp, ir.binop(cx.B, ir.OP_LSHR, cx.b_and(a, cx.usz(0xffff)), cx.usz(3)));
    let sb = cx.ld(cx.T_i8, cx.inttoptr(sa, cx.T_ptr));
    let in_granule = cx.b_and(
        cx.icmp(ir.IntULE, size, cx.usz(8)), cx.icmp(ir.IntULE, cx.b_add(cx.b_and(a, cx.usz(7)), size), cx.usz(8)));
    cx.condbr(cx.b_and(cx.icmp(ir.IntEQ, sb, ir.czero(cx.T_i8)), in_granule), done, slow);
    // memory the sanitizer does not track: fine within one page
    cx.at_end(untracked);
    let in_page = cx.b_and(cx.icmp(ir.IntULE, size, cx.usz(0x10000)),
                           cx.icmp(ir.IntULE, cx.b_add(cx.b_and(a, cx.usz(0xffff)), size), cx.usz(0x10000)));
    cx.condbr(in_page, done, slow);
    // everything else: the full check, which reports
    cx.at_end(slow);
    let fi = mem_fn("asan_check");
    let mut args: [2]*mut ir.Value = [a, size];
    let ok = cx.call(fi.llty, fi.fnv, args[..]);
    cgrt.check_or_trap(cx.icmp(ir.IntNE, ok, ir.czero(ok.ty)), cgrt.T_MEMORY);
    cx.br(done);
    cx.at_end(done);
}

// Checks the memory of a slice value (all of its elements).
fn asan_check_slice(s: *mut ir.Value, elem: *mut ast.Type) void {
    if not asan_on() {
        return;
    }
    asan_check(cx.extract(s, 0), cx.b_mul(cx.extract(s, 1), cx.usz(ty.type_size(elem))));
}

// A place reached through a pointer or slice is checked where it is loaded
// or stored (the whole value; not the aggregates on the way to it).
fn asan_place(e: *mut ast.Expr, addr: *mut ir.Value) *mut ir.Value {
    if asan_on() and via_pointer(e) {
        asan_check(addr, cx.usz(ty.type_size(cx.ct(e.ty))));
    }
    return addr;
}

// --sanitize=address: the user's main followed by the leak check
// (mem.asan_exit), which decides the exit status. On wasm this is the
// exported main; natively the entry point calls it.
pub fn asan_call_main(user_main: *mut ast.Decl, args: []mut *mut ir.Value) *mut ir.Value {
    let fi = get_inst(user_main, ty.no_types());
    let fty = fi.llty;
    let r = cx.call(fty, fi.fnv, args[0..fty.params.len]);
    let mut code = cx.ci32(0);
    if fty.ret.kind != ir.T_VOID {
        if fty.ret.bits < 32 {
            code = cx.zext(r, cx.T_i32);
        } else {
            code = r;
        }
    }
    let ex = mem_fn("asan_exit");
    let mut cargs: [1]*mut ir.Value = [code];
    return cx.call(ex.llty, ex.fnv, cargs[..]);
}

pub fn emit_asan_main_wasm() void {
    let mut user_main = u.nil.[ast.Decl]();
    for i in 0..modl.g_prog.fns.len {
        let d = modl.g_prog.fns.get(i);
        if d.is_export and u.str_eq(d.name, "main") {
            user_main = d;
        }
    }
    if u.isnil(user_main) {
        return;
    }
    let mut pi: [2]*mut ir.Ty = [cx.T_i32, cx.T_ptr];
    let fty = ir.t_fn(cx.T_i32, pi[..], false);
    let f = ir.add_function(cx.M, "axiom.export.main", fty).val;
    cgrt.add_str_attr(f, "wasm-export-name", "main");
    cx.g_export_names.push(u.intern("axiom.export.main"));
    cx.at_end(ir.append_block(ir.fnp_of(f), "entry"));
    let mut args: [2]*mut ir.Value = [cgrt.param(f, 0), cgrt.param(f, 1)];
    ir.ret(cx.B, asan_call_main(user_main, args[..]));
}

// Calls rt function `name` on scalar arguments, or lane by lane on vectors.
fn rt_call_lanes(name: []u8, args: []mut *mut ir.Value) *mut ir.Value {
    let fi = rt_fn(name);
    let t = args[0].ty;
    if t.kind != ir.T_VEC {
        return cx.call(fi.llty, fi.fnv, args);
    }
    let mut r = ir.undef(t);
    for lane in 0..@int_cast(u64, t.lanes) {
        let ls = u.newn.[*mut ir.Value](args.len + 1);
        for k in 0..args.len {
            ls[k] = ir.extract_elem(cx.B, args[k], lane);
        }
        r = ir.insert_elem(cx.B, r, cx.call(fi.llty, fi.fnv, ls[0..args.len]), lane);
    }
    return r;
}

// Atomics (spec §12.8): all sequentially consistent, naturally aligned.
// A misaligned atomic access traps (as WebAssembly requires); on native
// targets the check is explicit so behavior matches.
fn native_rt_fn(name: []u8, fty: *mut ir.Ty) *mut ir.Value {
    let mut f = cgrt.named_fn(name);
    if u.isnil(f) {
        f = ir.add_function(cx.M, name, fty).val;
    }
    cx.g_needs_native_runtime = true;
    return f;
}

// @expect_eq(a, b): on failure, record both values (and how to show them) in
// axiom.trap_info before trapping. kind: 1 signed, 2 unsigned, 3 float,
// 4 bool, 5 bytes ([]u8), 6 error, 7 address.
fn store_info(slot: u64, v: *mut ir.Value) void {
    _ = cx.st(v, cgrt.trap_info_slot(slot));
}

fn gen_expect_eq(e: *mut ast.Expr) void {
    let xa = barg(e, 0);
    let xb = barg(e, 1);
    let t = cx.ct(xa.ty);
    let a = gen(xa);
    let b = gen(xb);
    let mut eq = cx.vnil();
    let mut kind: u64 = 0;
    let mut ia = cx.vnil();
    let mut ib = cx.vnil();
    let mut la = cx.vnil();
    let mut lb = cx.vnil();
    if t.kind == ast.TY_FLOAT {
        eq = cx.fcmp(ir.RealOEQ, a, b);
        kind = 3;
        if t.bits == 32 {
            ia = cx.bitcast(ir.cast(cx.B, ir.OP_FPEXT, a, cx.T_f64), cx.T_i64);
            ib = cx.bitcast(ir.cast(cx.B, ir.OP_FPEXT, b, cx.T_f64), cx.T_i64);
        } else {
            ia = cx.bitcast(a, cx.T_i64);
            ib = cx.bitcast(b, cx.T_i64);
        }
    } else if t.kind == ast.TY_SLICE {
        let pa = cx.extract(a, 0);
        let pb = cx.extract(b, 0);
        la = cx.extract(a, 1);
        lb = cx.extract(b, 1);
        // equal lengths and bytes
        let res = cgrt.alloca_in_entry(cx.T_i1, "eq".ptr);
        let iv = cgrt.alloca_in_entry(cx.T_isz, "i".ptr);
        _ = cx.st(cx.icmp(ir.IntEQ, la, lb), res);
        _ = cx.st(cx.usz(0), iv);
        let cond = cx.new_bb("eq.cond".ptr);
        let body = cx.new_bb("eq.body".ptr);
        let neq = cx.new_bb("eq.ne".ptr);
        let end = cx.new_bb("eq.end".ptr);
        cx.br(cond);
        cx.at_end(cond);
        let i = cx.ld(cx.T_isz, iv);
        let lt = cx.icmp(ir.IntULT, i, la);  // (right to left, as in the C implementation)
        let more = cx.b_and(cx.ld(cx.T_i1, res), lt);
        cx.condbr(more, body, end);
        cx.at_end(body);
        let bx = cx.ld(cx.T_i8, cx.gep1(cx.T_i8, pa, i));
        let by = cx.ld(cx.T_i8, cx.gep1(cx.T_i8, pb, i));
        _ = cx.st(cx.b_add(i, cx.usz(1)), iv);
        cx.condbr(cx.icmp(ir.IntEQ, bx, by), cond, neq);
        cx.at_end(neq);
        _ = cx.st(ir.cint(cx.T_i1, 0), res);
        cx.br(end);
        cx.at_end(end);
        eq = cx.ld(cx.T_i1, res);
        kind = 5;
        ia = cx.zext(cx.ptrtoint(pa, cx.T_isz), cx.T_i64);
        ib = cx.zext(cx.ptrtoint(pb, cx.T_isz), cx.T_i64);
        la = cx.zext(la, cx.T_i64);
        lb = cx.zext(lb, cx.T_i64);
    } else if (t.kind == ast.TY_PTR) or (t.kind == ast.TY_FN) {
        eq = cx.icmp(ir.IntEQ, a, b);
        kind = 7;
        ia = cx.zext(cx.ptrtoint(a, cx.T_isz), cx.T_i64);
        ib = cx.zext(cx.ptrtoint(b, cx.T_isz), cx.T_i64);
    } else {  // integers, bool, error
        eq = cx.icmp(ir.IntEQ, a, b);
        let sg = (t.kind == ast.TY_INT) and t.is_signed;
        if t.kind == ast.TY_BOOL {
            kind = 4;
        } else if t.kind == ast.TY_ERROR {
            kind = 6;
        } else if sg {
            kind = 1;
        } else {
            kind = 2;
        }
        if ir.int_width(a.ty) == 64 {
            ia = a;
        } else if sg {
            ia = cx.sext(a, cx.T_i64);
        } else {
            ia = cx.zext(a, cx.T_i64);
        }
        if ir.int_width(b.ty) == 64 {
            ib = b;
        } else if sg {
            ib = cx.sext(b, cx.T_i64);
        } else {
            ib = cx.zext(b, cx.T_i64);
        }
    }
    let ok = cx.new_bb("expect.ok".ptr);
    let fail = cx.new_bb("expect.fail".ptr);
    cx.condbr(eq, ok, fail);
    cx.at_end(fail);
    store_info(1, ir.cint(cx.T_i64, kind));
    store_info(2, ia);
    store_info(3, ib);
    if u.notnil(la) {
        store_info(4, la);
    } else {
        store_info(4, ir.cint(cx.T_i64, 0));
    }
    if u.notnil(lb) {
        store_info(5, lb);
    } else {
        store_info(5, ir.cint(cx.T_i64, 0));
    }
    cgrt.call_trap_site(cgrt.site_record(cgrt.T_EXPECT, e.span));
    ir.unreachable(cx.B);
    cx.at_end(ok);
}

fn gen_atomic(e: *mut ast.Expr) *mut ir.Value {
    let id = ast.builtin_of(e);
    let pt = cx.ct(barg(e, 0).ty);
    let t = pt.elem;
    let p = gen(barg(e, 0));
    let size = ty.type_size(t);
    let asz = @int_cast(u32, size);
    if size > 1 {
        let addr = cx.ptrtoint(p, cx.T_isz);
        cgrt.check_or_trap(cx.icmp(ir.IntEQ, cx.b_and(addr, cx.usz(size - 1)), cx.usz(0)), cgrt.T_ATOMIC_ALIGN);
    }
    asan_check(p, cx.usz(size));
    if id == ast.BI_ATOMIC_LOAD {
        let v = cx.ld(cx.lty(t), p);
        v.flags = ir.F_ATOMIC;
        cgrt.set_align(v, asz);
        return v;
    }
    if id == ast.BI_ATOMIC_STORE {
        let v = gen(barg(e, 1));
        let s = cx.st(v, p);
        s.flags = ir.F_ATOMIC;
        cgrt.set_align(s, asz);
        return cx.vnil();
    }
    if id == ast.BI_ATOMIC_CAS {
        let expv = gen(barg(e, 1));
        let newv = gen(barg(e, 2));
        let r = ir.cmpxchg(cx.B, p, expv, newv);
        cgrt.set_align(r, asz);
        return r;
    }
    if id == ast.BI_ATOMIC_WAIT {
        let expv = gen(barg(e, 1));
        let timeout = gen(barg(e, 2));
        let mut args: [3]*mut ir.Value = [p, expv, timeout];
        if ty.g_target.is_wasm {
            return cx.intrinsic("llvm.wasm.memory.atomic.wait32", cx.no_tys(), args[..]);
        }
        let mut ps: [3]*mut ir.Ty = [cx.T_ptr, cx.T_i32, cx.T_i64];
        let fty = ir.t_fn(cx.T_i32, ps[..], false);
        let f = native_rt_fn("ax_wait32", fty);
        return cx.call(fty, f, args[..]);
    }
    if id == ast.BI_ATOMIC_NOTIFY {
        let count = gen(barg(e, 1));
        let mut args: [2]*mut ir.Value = [p, count];
        if ty.g_target.is_wasm {
            return cx.intrinsic("llvm.wasm.memory.atomic.notify", cx.no_tys(), args[..]);
        }
        let mut ps: [2]*mut ir.Ty = [cx.T_ptr, cx.T_i32];
        let fty = ir.t_fn(cx.T_i32, ps[..], false);
        let f = native_rt_fn("ax_notify32", fty);
        return cx.call(fty, f, args[..]);
    }
    let sg = t.is_signed;
    let mut op = ir.RMW_MAX;
    if not sg {
        op = ir.RMW_UMAX;
    }
    if id == ast.BI_ATOMIC_ADD {
        op = ir.RMW_ADD;
    } else if id == ast.BI_ATOMIC_SUB {
        op = ir.RMW_SUB;
    } else if id == ast.BI_ATOMIC_AND {
        op = ir.RMW_AND;
    } else if id == ast.BI_ATOMIC_OR {
        op = ir.RMW_OR;
    } else if id == ast.BI_ATOMIC_XOR {
        op = ir.RMW_XOR;
    } else if id == ast.BI_ATOMIC_XCHG {
        op = ir.RMW_XCHG;
    } else if id == ast.BI_ATOMIC_MIN {
        op = ir.RMW_MIN;
        if not sg {
            op = ir.RMW_UMIN;
        }
    }
    let v = gen(barg(e, 1));
    let r = ir.rmw(cx.B, op, p, v);
    cgrt.set_align(r, asz);
    return r;
}

// Entry point for threads on wasm: a new thread is a new instance sharing
// the memory; the host calls this export with the thread function, its
// argument and the top of a stack allocated for the thread. The function is
// frameless, so it touches no stack memory before switching stacks.
pub fn emit_thread_start() void {
    let mut ps: [3]*mut ir.Ty = [cx.T_ptr, cx.T_ptr, cx.T_ptr];
    let fty = ir.t_fn(cx.T_void, ps[..], false);
    let f = ir.add_function(cx.M, "axiom_thread_start", fty).val;
    cgrt.add_str_attr(f, "wasm-export-name", "axiom_thread_start");
    cx.g_export_names.push(u.intern("axiom_thread_start"));
    let bb = ir.append_block(ir.fnp_of(f), "entry");
    let saved = ir.insert_block(cx.B);
    cx.at_end(bb);
    let mut top = cgrt.param(f, 2);
    // std/thread stores the stack's lowest address at its top
    _ = cx.st(cx.ld(cx.T_isz, top), cgrt.stack_limit());
    if tls_globals() {
        // the thread's own copy of the thread-locals, at the top of its stack
        let size = (cx.S.tls_ty.size + 15) & ~@as(u64, 15);
        let neg = ir.cint(cx.T_isz, 0 -% size);
        let base = cx.gep1(cx.T_i8, top, neg);
        _ = ir.memop(cx.B, ir.OP_MEMCPY, base, cx.S.tls_init, cx.usz(@bit_cast(i64, cx.S.tls_ty.size)));
        _ = cx.st(base, cx.S.tls_ptr);
        top = base;
    }
    if cgrt.program_traces() {
        // The thread's shadow stack sits at the top of its stack.
        let t = cgrt.ss_type();
        let size = (t.size + 15) & ~@as(u64, 15);
        let neg = ir.cint(cx.T_isz, 0 -% size);
        let base = cx.gep1(cx.T_i8, top, neg);
        _ = ir.memop(cx.B, ir.OP_MEMSET, base, ir.cint(cx.T_i8, 0), cx.usz(@bit_cast(i64, size)));
        cgrt.ss_globals();
        _ = cx.st(base, cx.S.ss_global);
        top = base;
    }
    let mut tys: [1]*mut ir.Ty = [cx.T_ptr];
    let mut targs: [1]*mut ir.Value = [top];
    _ = cx.intrinsic("llvm.stackrestore", tys[..], targs[..]);
    if cfront.pending() {
        // the C units' thread-locals: their block, which the function (no
        // frame in memory) puts below the stack's top (c/cgen_tls.ax)
        let mut cps: [1]*mut ir.Ty = [cx.T_ptr];
        let cfty = ir.t_fn(cx.T_ptr, cps[..], false);
        let mut cf = ir.get_function(cx.M, cfront.tls_start_name());
        if u.isnil(cf) {
            cf = ir.add_function(cx.M, cfront.tls_start_name(), cfty);
        }
        let mut cargs: [1]*mut ir.Value = [top];
        let mut ctop: [1]*mut ir.Value = [cx.call(cfty, cf.val, cargs[..])];
        _ = cx.intrinsic("llvm.stackrestore", tys[..], ctop[..]);
    }
    let mut eps: [1]*mut ir.Ty = [cx.T_ptr];
    let ety = ir.t_fn(cx.T_void, eps[..], false);
    let mut args: [1]*mut ir.Value = [cgrt.param(f, 1)];
    _ = cx.call(ety, cgrt.param(f, 0), args[..]);
    ir.ret_void(cx.B);
    if u.notnil(saved) {
        cx.at_end(saved);
    }
}

pub fn error_name_table() *mut ir.Value {
    if u.notnil(cx.S.errtab) {
        return cx.S.errtab;
    }
    let names = modl.g_prog.error_names;
    let n = names.len;
    let vs = u.newn.[*mut ir.Value](n + 1);
    vs[0] = const_slice(string_ptr("<unknown>"), 9);
    for i in 0..n {
        let s = names.get(i);
        vs[i + 1] = const_slice(string_ptr(s), @int_cast(i64, s.len));
    }
    let stt = cx.lty(ty.type_slice(ty.t_u8, false));
    cx.S.errtab = ir.add_global(cx.M, ir.t_array(stt, @as(u64, n) + 1), "axiom.error_names").val;
    cgrt.set_init(cx.S.errtab, ir.carray(stt, vs[0..n + 1]));
    cgrt.set_linkage(cx.S.errtab, ir.LINK_INTERNAL);
    ir.gv_of(cx.S.errtab).is_const = true;
    return cx.S.errtab;
}

fn error_name_fty() *mut ir.Ty {
    let stt = cx.lty(ty.type_slice(ty.t_u8, false));
    let mut ps: [1]*mut ir.Ty = [cx.T_i16];
    return ir.t_fn(stt, ps[..], false);
}

// axiom.error_name(code) []u8: the name table lives with the error codes
// (in the link unit when units are compiled separately).
pub fn error_name_fn() *mut ir.Value {
    let stt = cx.lty(ty.type_slice(ty.t_u8, false));
    let fty = error_name_fty();
    let existing = cgrt.named_fn("axiom.error_name");
    if u.notnil(existing) {
        return existing;
    }
    let f = ir.add_function(cx.M, "axiom.error_name", fty).val;
    if cx.O.unit == cx.CG_MODULE {
        return f;
    }
    if cx.O.unit == cx.CG_WHOLE {
        cgrt.set_linkage(f, ir.LINK_INTERNAL);
    }
    let saved = ir.insert_block(cx.B);
    cx.at_end(ir.append_block(ir.fnp_of(f), "entry"));
    let tab = error_name_table();
    let n = modl.g_prog.error_names.len;
    let mut c = cx.zext(cgrt.param(f, 0), cx.T_isz);
    c = cx.sel(cx.icmp(ir.IntULE, c, cx.usz(@int_cast(i64, n))), c, cx.usz(0));
    ir.ret(cx.B, cx.ld(stt, cx.gep2(ir.t_array(stt, @as(u64, n) + 1), tab, cx.usz(0), c)));
    if u.notnil(saved) {
        cx.at_end(saved);
    }
    return f;
}

// Linear memory growth. On wasm these are the real instructions; on native
// targets the runtime (ax_memory_size, ax_memory_grow) commits 64 KiB pages of
// one large reserved region, so linear memory is contiguous there too.
fn mem_size() *mut ir.Value {
    if ty.g_target.is_wasm {
        let mut t: [1]*mut ir.Ty = [cx.T_isz];
        let mut args: [1]*mut ir.Value = [cx.ci32(0)];
        return cx.intrinsic("llvm.wasm.memory.size", t[..], args[..]);
    }
    let fty = ir.t_fn(cx.T_isz, cx.no_tys(), false);
    return cx.call(fty, native_rt_fn("ax_memory_size", fty), cx.no_vals());
}

fn mem_grow(pages: *mut ir.Value) *mut ir.Value {
    if ty.g_target.is_wasm {
        let mut t: [1]*mut ir.Ty = [cx.T_isz];
        let mut args: [2]*mut ir.Value = [cx.ci32(0), pages];
        return cx.intrinsic("llvm.wasm.memory.grow", t[..], args[..]);
    }
    let mut ps: [1]*mut ir.Ty = [cx.T_isz];
    let fty = ir.t_fn(cx.T_isz, ps[..], false);
    let mut args: [1]*mut ir.Value = [pages];
    return cx.call(fty, native_rt_fn("ax_memory_grow", fty), args[..]);
}

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------
fn gen_struct_lit(e: *mut ast.Expr) *mut ir.Value {
    let t = cx.ct(e.ty);
    let mut v = ir.undef(cx.lty(t));
    for i in 0..ast.more(e).inits.len {
        let ft = ty.type_field(t, i);
        let fv = gen(ast.more(e).inits.at(i).value);
        v = cx.insert(v, cgrt.to_mem(ft, fv), @int_cast(u32, i));
    }
    return v;
}

fn gen_array_lit(e: *mut ast.Expr) *mut ir.Value {
    let t = cx.ct(e.ty);
    if e.kind == ast.E_ARRAY_LIT {
        let mut v = ir.undef(cx.lty(t));
        for i in 0..ast.args_of(e).len {
            v = cx.insert(v, cgrt.to_mem(t.elem, gen(ast.args_of(e).get(i))), @int_cast(u32, i));
        }
        return v;
    }
    let x = gen(e.a);
    if (ir.is_const(x)) and (ir.is_zero(x)) {
        return ir.czero(cx.lty(t));
    }
    if t.len <= 16 {
        let mut v = ir.undef(cx.lty(t));
        for i in 0..@int_cast(u32, t.len) {
            v = cx.insert(v, cgrt.to_mem(t.elem, x), i);
        }
        return v;
    }
    let tmp = cgrt.temp_alloca(t);
    let iv = cgrt.alloca_in_entry(cx.T_isz, "i".ptr);
    _ = cx.st(cx.usz(0), iv);
    let cond = cx.new_bb("fill.cond".ptr);
    let body = cx.new_bb("fill.body".ptr);
    let end = cx.new_bb("fill.end".ptr);
    cx.br(cond);
    cx.at_end(cond);
    let i = cx.ld(cx.T_isz, iv);
    cx.condbr(cx.icmp(ir.IntULT, i, cx.usz(t.len)), body, end);
    cx.at_end(body);
    cgrt.store(t.elem, x, cx.gep2(cx.lty(t), tmp, cx.usz(0), i), false);
    _ = cx.st(cx.b_add(i, cx.usz(1)), iv);
    cx.br(cond);
    cx.at_end(end);
    return cgrt.load(t, tmp, false);
}

fn gen_unary(e: *mut ast.Expr) *mut ir.Value {
    let t = cx.ct(e.ty);
    let op = ast.op_of(e);
    if (op == lx.KW_NOT) or (op == lx.TK_TILDE) {
        return cx.b_not(gen(e.a));
    }
    if op == lx.TK_AMP {
        return gen_addr(e.a);
    }
    if op == lx.TK_MINUS_PCT {
        return ir.neg(cx.B, gen(e.a));
    }
    if op == lx.TK_MINUS {
        let v = gen(e.a);
        if (t.kind == ast.TY_FLOAT) or ty.is_vec_float(t) {
            return ir.fneg(cx.B, v);
        }
        if t.kind == ast.TY_VEC {
            return ir.neg(cx.B, v);  // integer vectors wrap in every mode
        }
        return overflow_op(1, true, ir.czero(v.ty), v);
    }
    cx.internal_error("bad unary");
    return cx.vnil();
}

fn gen_binary(e: *mut ast.Expr) *mut ir.Value {
    if (ast.op_of(e) == lx.KW_AND) or (ast.op_of(e) == lx.KW_OR) {
        let is_and = ast.op_of(e) == lx.KW_AND;
        let l = gen(e.a);
        if l.kind == ir.V_CINT {
            // a constant left operand (a target condition): the builder
            // would fold the branch, and the right operand runs or not
            if (l.cv != 0) == is_and {
                return gen(ast.b_of(e));
            }
            return l;
        }
        let lbb = ir.insert_block(cx.B);
        let rhs = cx.new_bb(u.pick(is_and, "and.rhs", "or.rhs").ptr);
        let end = cx.new_bb(u.pick(is_and, "and.end", "or.end").ptr);
        if is_and {
            cx.condbr(l, rhs, end);
        } else {
            cx.condbr(l, end, rhs);
        }
        cx.at_end(rhs);
        let r = gen(ast.b_of(e));
        let rbb = ir.insert_block(cx.B);
        cx.br(end);
        cx.at_end(end);
        let phi = ir.phi(cx.B, cx.T_i1);
        let mut sc: u64 = 1;
        if is_and {
            sc = 0;
        }
        let mut vals: [2]*mut ir.Value = [ir.cint(cx.T_i1, sc), r];
        let mut bbs: [2]*mut ir.Block = [lbb, rbb];
        ir.add_incoming(phi, vals[0], bbs[0]);
        ir.add_incoming(phi, vals[1], bbs[1]);
        return phi;
    }
    let lt = cx.ct(e.a.ty);
    let l = gen(e.a);
    let r = gen(ast.b_of(e));
    return gen_binop(ast.op_of(e), lt, l, r);
}

fn gen_slice(e: *mut ast.Expr) *mut ir.Value {
    let at = cx.ct(e.a.ty);
    let rt = cx.ct(e.ty);
    let mut ptr = cx.vnil();
    let mut len = cx.vnil();
    if ast.index_kind_of(e) == ast.IDX_SLICE {
        let s = gen(e.a);
        ptr = cx.extract(s, 0);
        len = cx.extract(s, 1);
    } else {
        let mut arr = at;
        if ast.index_kind_of(e) == ast.IDX_PTR_ARRAY {
            arr = at.elem;
            ptr = gen(e.a);
        } else {
            ptr = gen_addr(e.a);
        }
        len = array_len_value(arr);
    }
    let mut lo = cx.usz(0);
    if u.notnil(ast.b_of(e)) {
        lo = gen(ast.b_of(e));
    }
    let mut hi = len;
    if u.notnil(ast.c_of(e)) {
        hi = gen(ast.c_of(e));
    }
    let hl = cx.icmp(ir.IntULE, hi, len);  // (right to left, as in the C implementation)
    let ok = cx.b_and(cx.icmp(ir.IntULE, lo, hi), hl);
    cgrt.check_or_trap(ok, cgrt.T_BOUNDS);
    let np = cx.gep1(cx.lty(rt.elem), ptr, lo);
    let s = cx.insert(ir.undef(cx.lty(rt)), np, 0);
    return cx.insert(s, cx.b_sub(hi, lo), 1);
}

fn gen_inner(e: *mut ast.Expr) *mut ir.Value {
    let t = cx.ct(e.ty);
    if u.notnil(t) and (t.kind == ast.TY_NEVER) {
        // The expression diverges; generate it and hand back a placeholder.
        if e.kind == ast.E_BUILTIN {
            _ = gen_builtin(e);
        }
        let mut want = cx.tnil();
        if u.notnil(ast.tval_of(e)) {
            want = cx.ct(ast.tval_of(e));
        }
        if u.notnil(want) and (want.kind != ast.TY_VOID) and (want.kind != ast.TY_NEVER) {
            return ir.undef(cx.vty(want));
        }
        return cx.vnil();
    }
    if e.is_const and u.notnil(t) {
        if t.kind == ast.TY_INT {
            return cx.cint(cx.lty(t), ast.cval_of(e));
        }
        if t.kind == ast.TY_FLOAT {
            return cx.cfloat(t, e);
        }
        if t.kind == ast.TY_BOOL {
            let mut bv: u64 = 0;
            if e.bval {
                bv = 1;
            }
            return ir.cint(cx.T_i1, bv);
        }
    }
    let k = e.kind;
    if k == ast.E_IDENT {
        if u.notnil(ast.local_of(e)) {
            return cgrt.load(t, cgrt.local_ptr(ast.local_of(e)), false);
        }
        if u.notnil(ast.tval_of(e)) and (ast.tval_of(e).kind == ast.TY_PARAM) and ast.tval_of(e).is_const {
            let c = cx.ct(ast.tval_of(e));
            return cx.cint(cx.lty(t), u.I128.of(c.cval));
        }
        if u.notnil(ast.decl_of(e)) {
            let dk = ast.decl_of(e).kind;
            if dk == ast.D_GLOBAL {
                return cgrt.load(t, global_addr(ast.decl_of(e)), false);
            }
            if (dk == ast.D_FN) or (dk == ast.D_HOST_FN) {
                return get_inst(ast.decl_of(e), subst_gargs(ast.gargs_of(e))).fnv;
            }
            if dk == ast.D_CONST {
                if (cx.O.unit == cx.CG_MODULE) and type_mentions_error(t) {
                    return gen(ast.decl_of(e).cexpr);
                }
                return gen_const(ast.decl_of(e).cexpr, t);
            }
        }
    } else if k == ast.E_STRING {
        return const_slice(string_ptr(ast.more(e).str), @int_cast(i64, ast.more(e).str.len));
    } else if k == ast.E_BOOL {
        let mut bv: u64 = 0;
        if e.bval {
            bv = 1;
        }
        return ir.cint(cx.T_i1, bv);
    } else if k == ast.E_INT {
        return cx.cint(cx.lty(t), u.I128.ofu(ast.ival_of(e)));
    } else if k == ast.E_FLOAT {
        return cx.cfloat(t, e);
    } else if k == ast.E_STRUCT_LIT {
        return gen_struct_lit(e);
    } else if (k == ast.E_ARRAY_LIT) or (k == ast.E_ARRAY_REPEAT) {
        return gen_array_lit(e);
    } else if k == ast.E_ERROR_VAL {
        return errcode_value(@truncate(u32, ast.cval_of(e).lo));
    } else if k == ast.E_BUILTIN {
        return gen_builtin(e);
    } else if k == ast.E_UNARY {
        return gen_unary(e);
    } else if k == ast.E_BINARY {
        return gen_binary(e);
    } else if k == ast.E_CATCH {
        return gen_catch(e);
    } else if k == ast.E_TRY {
        return gen_try(e);
    } else if k == ast.E_CALL {
        return gen_call(e);
    } else if k == ast.E_FIELD {
        let fk = ast.field_kind_of(e);
        if fk == ast.FK_STRUCT {
            if sema.is_place(e) {
                return cgrt.load(t, asan_place(e, gen_addr(e)), via_pointer(e));
            }
            if ast.self_mode_of(e) == ast.SELF_DEREF {
                return cgrt.load(t, asan_place(e, gen_addr(e)), true);
            }
            return cgrt.from_mem(t, cx.extract(gen(e.a), @int_cast(u32, ast.index_of(e))));
        }
        if fk == ast.FK_SLICE_LEN {
            return cx.extract(gen(e.a), 1);
        }
        if fk == ast.FK_SLICE_PTR {
            return cx.extract(gen(e.a), 0);
        }
        if fk == ast.FK_ARRAY_LEN {
            return cx.usz(cx.ct(e.a.ty).len);
        }
        if fk == ast.FK_VARIANT_UNIT {
            let tmp = cgrt.temp_alloca(t);
            _ = cx.st(
                ir.cint(cx.lty(ty.union_tag_type(t)), @int_cast(u64, ast.index_of(e))), cx.sgep(cx.lty(t), tmp, 0));
            return cgrt.load(t, tmp, false);
        }
        if fk == ast.FK_CONST {
            return gen_const(ast.decl_of(e).cexpr, t);
        }
        if fk == ast.FK_DECL {
            if ast.decl_of(e).kind == ast.D_GLOBAL {
                return cgrt.load(t, global_addr(ast.decl_of(e)), false);
            }
            return get_inst(ast.decl_of(e), subst_gargs(ast.gargs_of(e))).fnv;
        }
    } else if k == ast.E_DEREF {
        return cgrt.load(t, asan_place(e, gen_addr(e)), true);
    } else if k == ast.E_INDEX {
        return cgrt.load(t, asan_place(e, gen_addr(e)), via_pointer(e) or (ast.index_kind_of(e) != ast.IDX_ARRAY));
    } else if k == ast.E_SLICE {
        return gen_slice(e);
    } else if k == ast.E_APPLY {
        return get_inst(ast.decl_of(e), subst_gargs(ast.gargs_of(e))).fnv;
    } else if k == ast.E_CONV {
        if ast.conv_of(e) == ast.CONV_NOOP {
            return gen(e.a);
        }
        if ast.conv_of(e) == ast.CONV_WRAP_OK {
            let mut v = cx.vnil();
            if t.elem.kind != ast.TY_VOID {
                v = gen(e.a);
            }
            return errunion_value(t, ir.cint(cx.T_i16, 0), v);
        }
        if ast.conv_of(e) == ast.CONV_WRAP_ERR {
            return errunion_value(t, gen(e.a), cx.vnil());
        }
    }
    cx.internal_error(u.f1("cannot generate expression kind %s", u.idec(@as(i32, @int_from_enum(e.kind)))));
    return cx.vnil();
}

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------
fn gen_block(b: *mut ast.Stmt) void {
    let height = cx.F.defers.len;
    let mut binds = false;
    if axd.on() {
        for i in 0..b.stmts.len {
            binds = binds or (b.stmts.get(i).kind == ast.S_LET);
        }
    }
    let sc = axd.open_block(binds);
    for i in 0..b.stmts.len {
        if cx.terminated() {
            break;
        }
        gen_stmt(b.stmts.get(i));
    }
    if not cx.terminated() {
        emit_defers(height, cx.vnil(), false);
    }
    cx.F.defers.len = height;
    axd.close_scope(sc);
}

fn gen_if(s: *mut ast.Stmt) void {
    // A target condition (spec §13.4): only the branch it selects is compiled.
    let tc = spost.target_cond(s.e, tg.g_features);
    if tc == 1 {
        gen_block(s.body);
        return;
    }
    if tc == 0 {
        if u.notnil(s.els) {
            if s.els.kind == ast.S_IF {
                gen_if(s.els);
            } else {
                gen_block(s.els);
            }
        }
        return;
    }
    let c = gen(s.e);
    let then_bb = cx.new_bb("if.then".ptr);
    let end = cx.new_bb("if.end".ptr);
    let mut else_bb = end;
    if u.notnil(s.els) {
        else_bb = cx.new_bb("if.else".ptr);
    }
    cx.condbr(c, then_bb, else_bb);
    cx.at_end(then_bb);
    gen_block(s.body);
    if not cx.terminated() {
        cx.br(end);
    }
    if u.notnil(s.els) {
        cx.at_end(else_bb);
        if s.els.kind == ast.S_IF {
            gen_if(s.els);
        } else {
            gen_block(s.els);
        }
        if not cx.terminated() {
            cx.br(end);
        }
    }
    cx.at_end(end);
}

fn push_loop(brk: *mut ir.Block, cont: *mut ir.Block) void {
    cx.F.loops.push(cx.LoopCtx.{ brk: brk, cont: cont, defer_height: cx.F.defers.len });
}

fn gen_for(s: *mut ast.Stmt) void {
    let vt = cx.ct(s.local.ty);
    let var = cgrt.local_ptr(s.local);
    let cond = cx.new_bb("for.cond".ptr);
    let body = cx.new_bb("for.body".ptr);
    let step = cx.new_bb("for.step".ptr);
    let end = cx.new_bb("for.end".ptr);
    if u.notnil(s.e2) {
        let lo = gen(s.e);
        let hi = gen(s.e2);
        let iv = cgrt.alloca_in_entry(cx.lty(vt), "for.i".ptr);
        _ = cx.st(lo, iv);
        cx.br(cond);
        cx.at_end(cond);
        let i = cx.ld(cx.lty(vt), iv);
        let mut p = ir.IntULT;
        if vt.is_signed {
            p = ir.IntSLT;
        }
        cx.condbr(cx.icmp(p, i, hi), body, end);
        cx.at_end(body);
        _ = cx.st(i, var);
        push_loop(end, step);
        gen_block(s.body);
        cx.F.loops.len -= 1;
        if not cx.terminated() {
            cx.br(step);
        }
        cx.at_end(step);
        // (the step runs after the body, which runs while i < hi: i + 1 <=
        // hi does not overflow)
        let i2 = cx.ld(cx.lty(vt), iv);
        _ = cx.st(cgrt.no_wrap(cx.b_add(i2, ir.cint(cx.lty(vt), 1)), vt.is_signed), iv);
        cx.br(cond);
        cx.at_end(end);
        return;
    }
    let ctt = cx.ct(s.e.ty);
    let mut ptr = cx.vnil();
    let mut len = cx.vnil();
    if ctt.kind == ast.TY_SLICE {
        let sv = gen(s.e);
        ptr = cx.extract(sv, 0);
        len = cx.extract(sv, 1);
    } else {
        ptr = addr_or_spill(s.e);
        len = cx.usz(ctt.len);
    }
    let iv = cgrt.alloca_in_entry(cx.T_isz, "for.idx".ptr);
    _ = cx.st(cx.usz(0), iv);
    cx.br(cond);
    cx.at_end(cond);
    let i = cx.ld(cx.T_isz, iv);
    cx.condbr(cx.icmp(ir.IntULT, i, len), body, end);
    cx.at_end(body);
    let ep = cx.gep1(cx.lty(vt), ptr, i);
    if ctt.kind == ast.TY_SLICE {
        asan_check(ep, cx.usz(ty.type_size(vt)));
    }
    cgrt.store(vt, cgrt.load(vt, ep, ctt.kind == ast.TY_SLICE), var, false);
    push_loop(end, step);
    gen_block(s.body);
    cx.F.loops.len -= 1;
    if not cx.terminated() {
        cx.br(step);
    }
    cx.at_end(step);
    // (i < len in the body before the step: i + 1 <= len does not wrap)
    let i2 = cx.ld(cx.T_isz, iv);
    _ = cx.st(cgrt.no_wrap(cx.b_add(i2, cx.usz(1)), false), iv);
    cx.br(cond);
    cx.at_end(end);
}

fn is_variant_arm(a: *ast.MatchArm) bool {
    match a.pat {
        .Variant => { return true; }
        else     => { return false; }
    }
}

fn is_error_arm(a: *ast.MatchArm) bool {
    match a.pat {
        .Error => { return true; }
        else   => { return false; }
    }
}

fn gen_match(s: *mut ast.Stmt) void {
    let t = cx.ct(s.e.ty);
    let end = cx.new_bb("match.end".ptr);
    let n = ast.stmt_more(s).arms.len;
    let bbs = u.newn.[*mut ir.Block](n + 1);
    let mut else_idx: i64 = -1;
    for i in 0..n {
        // an arm's other patterns branch to its block
        if ast.stmt_more(s).arms.at(i).alt {
            bbs[i] = bbs[i - 1];
        } else {
            bbs[i] = cx.new_bb("match.arm".ptr);
        }
        if ast.stmt_more(s).arms.at(i).is_else() and (else_idx < 0) {
            else_idx = @int_cast(i64, i);
        }
    }
    let mut payload_ptr = cx.vnil();
    if t.kind == ast.TY_UNION {
        let up = addr_or_spill(s.e);
        let tag = cx.ld(cx.lty(ty.union_tag_type(t)), cx.sgep(cx.lty(t), up, 0));
        if ir.field_count(cx.lty(t)) > 1 {
            payload_ptr = cx.sgep(cx.lty(t), up, 1);
        }
        let nv = t.decl.variants.len;
        let sw = ir.switch_(cx.B, tag, cgrt.trap_block(cgrt.T_UNIONTAG));
        let covered = u.newn.[bool](nv + 1);
        for i in 0..n {
            let a = ast.stmt_more(s).arms.at(i);
            if is_variant_arm(a) and not covered[@int_cast(usize, a.variant)] {
                covered[@int_cast(usize, a.variant)] = true;
                ir.add_case(sw, ir.cint(cx.lty(ty.union_tag_type(t)), @int_cast(u64, a.variant)), bbs[i]);
            }
        }
        if else_idx >= 0 {
            for v in 0..nv {
                if not covered[v] {
                    ir.add_case(
                        sw, ir.cint(cx.lty(ty.union_tag_type(t)), @as(u64, v)), bbs[@int_cast(usize, else_idx)]);
                }
            }
        }
    } else if (cx.O.unit == cx.CG_MODULE) and (n > 0) and (cx.ct(s.e.ty).kind == ast.TY_ERROR) {
        // Error codes are link-time values here: compare in arm order.
        let v = gen(s.e);
        for i in 0..n {
            let a = ast.stmt_more(s).arms.at(i);
            if not is_error_arm(a) {
                continue;
            }
            let next = cx.new_bb("match.next".ptr);
            cx.condbr(cx.icmp(ir.IntEQ, v, errcode_value(a.error_code)), bbs[i], next);
            cx.at_end(next);
        }
        if else_idx >= 0 {
            cx.br(bbs[@int_cast(usize, else_idx)]);
        } else {
            cx.br(cgrt.trap_block(cgrt.T_TRAP));
        }
    } else {
        // integers, bool, error, enum (an enum match without 'else' covers every member)
        let v = gen(s.e);
        let mut dflt = cx.bbnil();
        if else_idx >= 0 {
            dflt = bbs[@int_cast(usize, else_idx)];
        } else if s.e.ty.kind == ast.TY_ENUM {
            dflt = cgrt.trap_block(cgrt.T_UNIONTAG);
        } else {
            dflt = cgrt.trap_block(cgrt.T_TRAP);
        }
        let sw = ir.switch_(cx.B, v, dflt);
        let vt_ = v.ty;
        let mut seen = u.List.[u.I128].empty();
        for i in 0..n {
            let a = ast.stmt_more(s).arms.at(i);
            let mut key = u.I128.zero();
            match a.pat {
                .Int(k) => { key = k; }
                .Bool(bv) => {
                    if bv {
                        key = u.I128.of(1);
                    }
                }
                .Error   => { key = u.I128.ofu(@as(u64, a.error_code)); }
                .Variant => { key = a.value; }
                .Else    => { continue; }
            }
            let mut dup = false;
            for kk in 0..seen.len {
                if seen.get(kk).eq(key) {
                    dup = true;
                }
            }
            if dup {
                continue;
            }
            seen.push(key);
            ir.add_case(sw, cx.cint(vt_, key), bbs[i]);
        }
        seen.deinit();
    }
    for i in 0..n {
        let a = ast.stmt_more(s).arms.at(i);
        if a.alt {
            continue;
        }
        cx.at_end(bbs[i]);
        if u.notnil(a.bind_local) and u.notnil(payload_ptr) {
            let pt = ty.type_variant(t, @int_cast(usize, a.variant));
            cgrt.store(pt, cgrt.load(pt, payload_ptr, true), cgrt.local_ptr(a.bind_local), false);
        }
        gen_block(a.body);
        if not cx.terminated() {
            cx.br(end);
        }
    }
    cx.at_end(end);
}

// Whether every bit pattern of t's bytes is a value of t: integers, floats
// and vectors, and arrays and structs of them (padding included).
fn plain_data(t0: *mut ast.Type) bool {
    if t0.kind == ast.TY_ENUM {
        return false;
    }
    let t = cx.ct(t0);
    let k = t.kind;
    if (k == ast.TY_INT) or (k == ast.TY_FLOAT) or (k == ast.TY_VEC) or (k == ast.TY_V128) {
        return true;
    }
    if k == ast.TY_ARRAY {
        return plain_data(t.elem);
    }
    if k == ast.TY_STRUCT {
        for i in 0..t.decl.fields.len {
            if not plain_data(ty.type_field(t, i)) {
                return false;
            }
        }
        return true;
    }
    return false;
}

fn gen_stmt_inner(s: *mut ast.Stmt) void {
    let k = s.kind;
    if (k == ast.S_LET) and s.undef {
        // left unspecified (§8.1): a small variable, which the optimizer could keep in
        // registers, is zeroed (as good a value as any, and free); a larger one's bytes are
        // left as they are in its slot, which is never promoted, when any bytes make valid
        // values of its type. Anything else (a slice, pointer or function pointer that
        // old bytes would forge, a bool, enum, union or error union) is zeroed whatever
        // its size (§12.3).
        let t = cx.ct(s.local.ty);
        let lt = cx.lty(t);
        if (lt.size <= cx.UNDEF_ZEROED) or not plain_data(s.local.ty) {
            cgrt.store(t, ir.czero(lt), cgrt.local_ptr(s.local), false);
        } else {
            _ = cgrt.local_ptr(s.local);
        }
    } else if k == ast.S_LET {
        let v = gen(s.e);
        if cx.terminated() or u.isnil(v) {
            return;
        }
        cgrt.store(cx.ct(s.local.ty), v, cgrt.local_ptr(s.local), false);
    } else if (k == ast.S_EXPR) or (k == ast.S_DISCARD) {
        _ = gen(s.e);
    } else if k == ast.S_ASSIGN {
        let t = cx.ct(s.e.ty);
        let addr = gen_addr(s.e);
        let un = via_pointer(s.e);
        if s.op == lx.TK_EQ {
            let v = gen(s.e2);
            if u.isnil(v) {
                return;
            }
            cgrt.store(t, v, asan_place(s.e, addr), un);
            return;
        }
        _ = asan_place(s.e, addr);
        let old = cgrt.load(t, addr, un);
        let r = gen(s.e2);
        let nv = gen_binop(ast.op_of(ast.stmt_more(s).e3), t, old, r);
        cgrt.store(t, nv, addr, un);
    } else if k == ast.S_IF {
        gen_if(s);
    } else if k == ast.S_WHILE {
        let cond = cx.new_bb("while.cond".ptr);
        let body = cx.new_bb("while.body".ptr);
        let end = cx.new_bb("while.end".ptr);
        cx.br(cond);
        cx.at_end(cond);
        let c = gen(s.e);
        cx.condbr(c, body, end);
        cx.at_end(body);
        push_loop(end, cond);
        gen_block(s.body);
        cx.F.loops.len -= 1;
        if not cx.terminated() {
            cx.br(cond);
        }
        cx.at_end(end);
    } else if k == ast.S_LOOP {
        let body = cx.new_bb("loop.body".ptr);
        let end = cx.new_bb("loop.end".ptr);
        cx.br(body);
        cx.at_end(body);
        push_loop(end, body);
        gen_block(s.body);
        cx.F.loops.len -= 1;
        if not cx.terminated() {
            cx.br(body);
        }
        cx.at_end(end);
    } else if k == ast.S_FOR {
        let sc = axd.open_block(true);  // (the loop's variable)
        gen_for(s);
        axd.close_scope(sc);
    } else if k == ast.S_MATCH {
        gen_match(s);
    } else if k == ast.S_RETURN {
        gen_return(s.e);
    } else if k == ast.S_BREAK {
        gen_break(true, s.jump_depth);
    } else if k == ast.S_CONTINUE {
        gen_break(false, s.jump_depth);
    } else if k == ast.S_DEFER {
        cx.F.defers.push(s);
    } else if k == ast.S_BLOCK {
        gen_block(s);
    }
}

// Wrappers that track the source span of the code being generated, for
// trap sites.
fn gen(e: *mut ast.Expr) *mut ir.Value {
    let saved = cx.S.cur_span;
    cgrt.set_span(e.span);
    let v = gen_inner(e);
    cgrt.set_span(saved);
    return v;
}

fn gen_addr(e: *mut ast.Expr) *mut ir.Value {
    let saved = cx.S.cur_span;
    cgrt.set_span(e.span);
    let v = gen_addr_inner(e);
    cgrt.set_span(saved);
    return v;
}

fn gen_stmt(s: *mut ast.Stmt) void {
    let saved = cx.S.cur_span;
    cgrt.set_span(s.span);
    gen_stmt_inner(s);
    cgrt.set_span(saved);
}

// ---------------------------------------------------------------------------
// Function bodies
// ---------------------------------------------------------------------------
pub fn gen_fn_body(fi: *mut cx.FnInst) void {
    let saved_feats = tg.g_features;
    tg.g_features = fi.feats;  // (@target_has, and lowering that depends on extensions)
    if fi.dispatch {
        let saved_f = cx.F;
        let stt = u.new.[cx.FnState]();
        stt.inst = fi;
        stt.decl = fi.decl;
        stt.fnv = fi.fnv;
        stt.no_trace = true;
        cx.F = stt;
        gen_dispatch(fi);
        cx.F = saved_f;
    } else {
        gen_fn_body_of(fi);
    }
    tg.g_features = saved_feats;
}

fn gen_fn_body_of(fi: *mut cx.FnInst) void {
    let d = fi.decl;
    let stt = u.new.[cx.FnState]();
    stt.inst = fi;
    stt.decl = d;
    stt.from = d.all_gparams;
    stt.to = fi.gargs;
    stt.fnv = fi.fnv;
    // the function's line: its name in the declaration (also the line of the
    // code before its body's first statement)
    cgrt.set_span(d.name_span);
    ir.fnp_of(fi.fnv).src = ir.cur_src;
    ir.fnp_of(fi.fnv).coverage = cov_on(d.module);
    stt.no_trace = cgrt.is_runtime_module(d.module);
    stt.locals = u.newn.[*mut ir.Value](d.locals.len + 1);
    let saved = cx.F;
    cx.F = stt;
    stt.ret = fi.fnty.ret;
    stt.entry = ir.append_block(ir.fnp_of(fi.fnv), "entry");
    let start = ir.append_block(ir.fnp_of(fi.fnv), "start");
    cx.at_end(start);
    axd.begin_function(ir.fnp_of(fi.fnv), fi.fnty.ret);
    let mut k: u32 = 0;
    if fi.sret {
        stt.sret_ptr = cgrt.param(fi.fnv, k);
        k += 1;
    }
    for i in 0..d.params.len {
        let l = d.params.at(i).local;
        let pt = fi.fnty.params[i];
        let p = cgrt.param(fi.fnv, k);
        k += 1;
        if cx.by_ptr(pt) {
            stt.locals[@int_cast(usize, l.index)] = p;  // params are immutable: use the caller's copy directly
            // (its address in an object of its own: -O0 keeps it there, for debuggers)
            let pa = cgrt.alloca_in_entry(cx.T_ptr, "arg.addr".ptr);
            _ = cx.st(p, pa);
            axd.note_local(ir.fnp_of(fi.fnv), l, cgrt.debug_type(l.ty), pa, true);
        } else {
            cgrt.store(pt, p, cgrt.local_ptr(l), false);
        }
    }
    gen_block(d.body);
    if not cx.terminated() {
        if stt.ret.kind == ast.TY_VOID {
            ir.ret_void(cx.B);
        } else if (stt.ret.kind == ast.TY_ERRUNION) and (stt.ret.elem.kind == ast.TY_VOID) {
            emit_ret(errunion_value(stt.ret, ir.cint(cx.T_i16, 0), cx.vnil()));
        } else {
            ir.unreachable(cx.B);
        }
    }
    if stt.frame > ty.MAX_FRAME {
        _ = dg.err(d.name_span, "E0473",
                   u.f2("the locals of '%s' need more than %s bytes of stack, the most a function can have", d.name,
                        u.dec(ty.MAX_FRAME)));
    }
    cx.at_end(stt.entry);
    if ty.g_target.is_wasm {
        cgrt.check_stack(d, stt.entry, start);
    } else {
        cx.br(start);
    }
    axd.end_function();
    // Delete blocks with no predecessors (continuations after return/break/trap).
    ir.remove_unreachable(ir.fnp_of(stt.fnv));
    stt.defers.deinit();
    stt.loops.deinit();
    cx.F = saved;
}

// ---------------------------------------------------------------------------
// C functions with structures by value (spec §14.5.3)
// ---------------------------------------------------------------------------

/// The prefix of the symbols of the C wrappers: CABI_PREFIX + name is the
/// wrapper of extern "C" function name, CABI_IMPL + name the function an
/// export's C function calls (header.ax: cabi_source).
pub let CABI_PREFIX: []u8 = "__axiom_cabi_";
pub let CABI_IMPL: []u8 = "__axiom_cabi_impl_";

// For each such export, CABI_IMPL + its name: the export's function with
// its structures by pointer (fn_lty_c), for its C wrapper to call.
pub fn emit_cabi_thunks() void {
    for fi in cx.S.cabi_exports.items() {
        let d = fi.decl;
        let cl = cx.fn_lty_c(fi.fnty, true);
        let f = ir.add_function(cx.M, u.cat2(CABI_IMPL, d.name), cl.t).val;
        add_ext_attrs_c(f, fi.fnty, cl.sret, false, true);
        cx.at_end(ir.append_block(ir.fnp_of(f), "entry"));
        let np = fi.fnty.params.len;
        let mut nargs = np;
        if fi.sret {
            nargs += 1;
        }
        let av = u.newn.[*mut ir.Value](nargs + 1);
        let mut k: u32 = 0;
        let mut j: usize = 0;
        if cl.sret {
            k = 1;
        }
        if fi.sret {
            av[0] = cgrt.param(f, 0);  // (the result's memory: the caller's)
            j = 1;
        }
        for i in 0..np {
            let pt = fi.fnty.params[i];
            let p = cgrt.param(f, k);
            if cx.cabi_struct(pt, true) and not cx.by_ptr(pt) {
                av[j] = cgrt.load(pt, p, true);
            } else {
                av[j] = p;
            }
            j += 1;
            k += 1;
        }
        let r = cx.call(fi.llty, fi.fnv, av[0..nargs]);
        add_ext_attrs(r, fi.fnty, fi.sret, true);
        if cl.sret and not fi.sret {
            cgrt.store(fi.fnty.ret, r, cgrt.param(f, 0), true);
            ir.ret_void(cx.B);
        } else if fi.sret or (fi.fnty.ret.kind == ast.TY_VOID) {
            ir.ret_void(cx.B);
        } else {
            ir.ret(cx.B, r);
        }
    }
    cx.S.cabi_exports.clear();
}
