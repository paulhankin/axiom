// =============================================================================
// isel.ax - what the native code generators (x64.ax and a64.ax) share:
// questions about IR values that instruction selection asks, the machine
// function it fills, the shape of a call, the use counts it starts from,
// the parallel copies into phis, and the module's symbols and data in the
// ELF object. wasm.ax uses the bytes of constants.
// =============================================================================
import "bin.ax" as bn;
import "elf.ax" as elf;
import "ir.ax" as ir;
import "mach.ax" as mc;
import "opt.ax" as opt;
import "target.ax" as tg;
import "util.ax" as u;

// -----------------------------------------------------------------------------
// Values
// -----------------------------------------------------------------------------
// Constant integer value (sign-extended), if v is one.
pub fn cval(v: *ir.Value) i64 {
    if v.kind == ir.V_CINT {
        if v.ty.bits == 1 {
            return @bit_cast(i64, v.cv);  // i1 is 0 or 1
        }
        return ir.sval(v);
    }
    return 0;
}

// -----------------------------------------------------------------------------
// A quotient and a remainder of the same operands (a divisor not constant:
// divconst.ax has made the others multiplications) in one block: one divide
// instruction computes both. The pairs are a division and the first remainder
// after it of the same operands (within DIV_REACH instructions); the division's
// instruction also defines the remainder, which then has none of its own. (The
// remainder faults just when the division does: their operands are the same.)
// -----------------------------------------------------------------------------
const DIV_REACH: i32 = 64;

fn div_pair(q: *ir.Value, r: *ir.Value) bool {
    let o = q.op;
    let mut ro = ir.OP_UREM;
    if o == ir.OP_SDIV {
        ro = ir.OP_SREM;
    } else if o != ir.OP_UDIV {
        return false;
    }
    return (r.kind == ir.V_INST) and (r.op == ro) and (r.a == q.a) and (r.b == q.b) and (r.ty == q.ty) and
           (q.ty.kind == ir.T_INT);
}

// The remainder whose value division q's instruction also gives, or nil.
pub fn div_partner(q: *ir.Value) *mut ir.Value {
    let mut p = q.next;
    let mut n: i32 = 0;
    while u.notnil(p) and (n < DIV_REACH) {
        if div_pair(q, p) {
            return p;
        }
        p = p.next;
        n += 1;
    }
    return u.nil.[ir.Value]();
}

// The division before remainder r whose instruction gives r (div_partner),
// or nil.
pub fn rem_quotient(r: *ir.Value) *mut ir.Value {
    let mut p = r.prev;
    let mut n: i32 = 0;
    while u.notnil(p) and (n < DIV_REACH) {
        if div_pair(p, r) {
            if @int_from_ptr(div_partner(p)) == @int_from_ptr(r) {
                return p;
            }
            return u.nil.[ir.Value]();
        }
        p = p.prev;
        n += 1;
    }
    return u.nil.[ir.Value]();
}

pub fn is_c(v: *ir.Value) bool {
    return (v.kind == ir.V_CINT) or ((v.kind == ir.V_ZERO) and ((v.ty.kind == ir.T_INT) or (v.ty.kind == ir.T_PTR)));
}

pub fn fits32(x: i64) bool {
    return (x >= -2147483648) and (x <= 2147483647);
}

// Is v a comparison fused into its users (branches and selects, which
// each compare again)?
pub fn fused(v: *mut ir.Value) bool {
    return (v.kind == ir.V_INST) and ((v.flag & 2) != 0);
}

// The opposite condition (both targets pair each condition code with its
// inverse).
pub fn invert(cc: i32) i32 {
    return cc ^ 1;
}

// The least and the greatest value of a signed (sg) or unsigned integer of
// fewer than 64 bits: the bounds a saturating operation clamps to.
pub fn sat_min(bits: i32, sg: bool) i64 {
    if sg {
        return -(@as(i64, 1) << @int_cast(u32, bits - 1));
    }
    return 0;
}

pub fn sat_max(bits: i32, sg: bool) i64 {
    if sg {
        return (@as(i64, 1) << @int_cast(u32, bits - 1)) - 1;
    }
    return (@as(i64, 1) << @int_cast(u32, bits)) - 1;
}

pub fn is_f32(t: *ir.Ty) bool {
    if t.kind == ir.T_VEC {
        return t.elem.bits == 32;
    }
    return t.bits == 32;
}

pub fn mem_size(t: *ir.Ty) u8 {
    if (t.kind == ir.T_INT) and (t.bits <= 8) {
        return 1;
    }
    return @truncate(u8, t.size);
}

pub fn lane_bits(t: *ir.Ty) i32 {
    return t.elem.bits;
}

pub fn lane_float(t: *ir.Ty) bool {
    return t.elem.kind == ir.T_FLOAT;
}

// The processor instructions (spec §13.5) of either architecture.
pub fn is_insn(id: i32) bool {
    return (id >= ir.IN_AESENC) and (id <= ir.IN_CRC32C_A);
}

// The machine block of IR block s.
pub fn blk(s: *ir.Block) i32 {
    return @truncate(i32, s.aux);
}

// Is s laid out right after b?
pub fn next_block_is(b: *mut ir.Block, s: *mut ir.Block) bool {
    return s.aux == (b.aux + 1);
}

pub fn mk2(a: mc.MOp, b: mc.MOp) [2]mc.MOp {
    return [a, b];
}

// -----------------------------------------------------------------------------
// Constants
// -----------------------------------------------------------------------------
// The little-endian bytes of constant x at out[base..] (zeros, undefined
// values and padding are zeros).
pub fn const_le(x: *mut ir.Value, out: *mut bn.Bytes, base: usize) void {
    let t = x.ty;
    while out.len() < (base + @truncate(usize, t.size)) {
        out.u8_(0);
    }
    let k = x.kind;
    if k == ir.V_CINT {
        for i in 0..@truncate(usize, t.size) {
            out.set_u8(base + i, @truncate(u8, x.cv >> @int_cast(u32, i * 8)));
        }
    } else if k == ir.V_CFP {
        if t.bits == 32 {
            out.set_u32(base, @as(u64, ir.f32_bits(ir.fv_of(x))));
        } else {
            out.set_u64(base, @bit_cast(u64, ir.fv_of(x)));
        }
    } else if k == ir.V_CAGG {
        for i in 0..x.xs.len {
            const_le(x.xs.get(i), out, base + @truncate(usize, ir.field_off(t, i)));
        }
    } else if k == ir.V_CSTR {
        let bs = ir.bytes_of(x);
        for i in 0..bs.len {
            out.set_u8(base + i, bs[i]);
        }
    }
}

pub fn le8(b: []u8) u64 {
    let mut x: u64 = 0;
    for i in @as(usize, 0)..8 {
        x = x | (@as(u64, b[i]) << @int_cast(u32, i * 8));
    }
    return x;
}

pub fn all_ones(v: *ir.Value) bool {
    if ir.is_op(v, ir.OP_COPY) {
        return all_ones(v.a);  // (a constant hoisted out of a loop)
    }
    if v.kind == ir.V_CAGG {
        for k in 0..v.xs.len {
            let c = v.xs.get(k);
            if (c.kind != ir.V_CINT) or ((c.cv & ir.mask_bits(c.ty.bits)) != ir.mask_bits(c.ty.bits)) {
                return false;
            }
        }
        return true;
    }
    return ir.is_op(v, ir.OP_SPLAT) and (v.a.kind == ir.V_CINT) and
           ((v.a.cv & ir.mask_bits(v.a.ty.bits)) == ir.mask_bits(v.a.ty.bits));
}

// -----------------------------------------------------------------------------
// Bit selects
// -----------------------------------------------------------------------------
// @select as codegen.ax makes it: (x & m) | (y & ~m), for a lane mask m.
pub struct Sel {
    x: *mut ir.Value,
    y: *mut ir.Value,
    m: *mut ir.Value,
    p: *mut ir.Value,  // x & m
    q: *mut ir.Value,  // y & ~m
    n: *mut ir.Value,  // ~m
}

// The parts of o when it is such a select (else x is nil).
pub fn sel_parts(o: *mut ir.Value) Sel {
    let mut r = Sel.{ x: ir.vnil(), y: ir.vnil(), m: ir.vnil(), p: ir.vnil(), q: ir.vnil(), n: ir.vnil() };
    if not ir.is_op(o, ir.OP_OR) or (o.ty.kind != ir.T_VEC) {
        return r;
    }
    let ors: [2]*mut ir.Value = [o.a, o.b];
    for j in @as(usize, 0)..2 {
        let p = ors[j];
        let q = ors[1 - j];
        if not ir.is_op(p, ir.OP_AND) or not ir.is_op(q, ir.OP_AND) {
            continue;
        }
        let ps: [2]*mut ir.Value = [p.a, p.b];
        let qs: [2]*mut ir.Value = [q.a, q.b];
        for k in @as(usize, 0)..2 {
            let m = ps[1 - k];
            for l in @as(usize, 0)..2 {
                let n = qs[1 - l];
                if ir.is_op(n, ir.OP_XOR) and (((n.a == m) and all_ones(n.b)) or ((n.b == m) and all_ones(n.a))) {
                    r.x = ps[k];
                    r.y = qs[l];
                    r.m = m;
                    r.p = p;
                    r.q = q;
                    r.n = n;
                    return r;
                }
            }
        }
    }
    return r;
}

// -----------------------------------------------------------------------------
// Functions
// -----------------------------------------------------------------------------
// The machine function for f: a block for each of f's in layout order (each
// IR block's aux its index), with its loop depth, whether it is cold and its
// unlikely successor, and a stack slot for each alloca (in the alloca's aux).
pub fn new_mfunc(f: *mut ir.Func, order: *u.List.[*mut ir.Block]) *mut mc.MFunc {
    let mf = mc.new_func();
    for i in 0..order.len {
        let b = order.get(i);
        b.aux = @int_cast(i64, i);
        let mb = mc.new_block(mf);
        mb.loop_depth = b.loop_depth;
        let bt = ir.terminator(b);
        mb.cold = (u.notnil(bt) and (bt.op == ir.OP_UNREACHABLE)) or b.cold;
    }
    for i in 0..order.len {
        let us = opt.unlikely_succ(order.get(i));
        if u.notnil(us) {
            mf.blocks.get(i).unlikely = @int_cast(i32, us.aux) + 1;
        }
    }
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if i.op == ir.OP_ALLOCA {
                let mut al = ir.aty_of(i).align;
                if @as(u64, i.align) > al {
                    al = @as(u64, i.align);
                }
                if al == 0 {
                    al = 1;
                }
                i.aux = @int_cast(i64, mc.new_slot(mf, ir.aty_of(i).size, al));
            }
            i = i.next;
        }
        b = b.next;
    }
    return mf;
}

// -----------------------------------------------------------------------------
// Calls
// -----------------------------------------------------------------------------
// The registers of call v's arguments, a narrow integer extended as the
// callee expects (zero-extended for extension 1, sign-extended for 2).
// reg and ext_reg are the target's.
pub fn call_args(v: *mut ir.Value, reg: fn(*mut ir.Value) i32, ext_reg: fn(i32, i32, bool, bool) i32) []mut i32 {
    let n = v.xs.len;
    let regs = u.newn.[i32](n + 1);
    for i in 0..n {
        let x = v.xs.get(i);
        let mut e: u8 = 0;
        if (i + 1) < ir.ext_of(v).len {
            e = ir.ext_of(v)[i + 1];
        }
        let mut r = reg(x);
        if (e != 0) and (x.ty.kind == ir.T_INT) and (x.ty.bits < 32) {
            r = ext_reg(r, x.ty.bits, e == 2, false);
        }
        regs[i] = r;
    }
    return regs;
}

// The operands of call v: the callee (register target, or if that is -1 the
// function's symbol), the argument registers it reads (uses) and the
// register ret of its result (-1: none). func_sym is the target's.
pub fn call_ops(v: *mut ir.Value, target: i32, uses: *u.List.[mc.MOp], func_sym: fn(*ir.Func) i32,
                ret: i32) u.List.[mc.MOp] {
    let mut ops = u.List.[mc.MOp].empty();
    if target >= 0 {
        ops.push(mc.reg(target, mc.RU));
    } else {
        ops.push(mc.symop(func_sym(ir.fnp_of(v.a)), 0));
    }
    for k in 0..uses.len {
        ops.push(uses.get(k));
    }
    if ret >= 0 {
        ops.push(mc.reg(ret, mc.RD));
    }
    return ops;
}

// Whether call v returns a bool made by code that is not this compiler's (a
// C function, or any function called through a pointer): the C ABIs define
// only the low byte of a bool result, where this compiler keeps a bool as 0
// or 1 in the whole register, so the caller extends it.
pub fn foreign_bool(v: *mut ir.Value) bool {
    let rt = ir.fty_of(v).ret;
    if (rt.kind != ir.T_INT) or (rt.bits != 1) {
        return false;
    }
    let g = ir.direct_callee(v);
    return u.isnil(g) or ir.is_decl(g);
}

// Completes ci, the call instruction of v in f: its frame-table entry aux
// and the registers it clobbers (none after a call that does not return).
pub fn finish_call(f: *mut mc.MFunc, ci: *mut mc.MInst, v: *mut ir.Value, aux: i64, clobber: u64) void {
    ci.aux = aux;
    ci.clobber = clobber;
    if (v.a.kind == ir.V_FUNC) and ir.fnp_of(v.a).noreturn {
        ci.clobber = 0;  // nothing is live after it
    }
    f.has_calls = true;
}

// Is call v one to leave the function by (tailrec.ax: mark_sibling_calls,
// ir.F_TAIL), still followed by its block's return of its result or of
// nothing, or (a result in registers, ir.EXT_REGS) by its registers
// (IN_CALL_RESULT) and the return of them? The target then checks where the
// arguments go, and selects neither the registers nor the return.
pub fn sibling_call(v: *ir.Value) bool {
    if (v.flags & ir.F_TAIL) == 0 {
        return false;
    }
    let mut r = v.next;
    while u.notnil(r) and (r.op == ir.OP_INTR) and (ir.intr_id(r) == ir.IN_CALL_RESULT) and
          (@int_from_ptr(ir.resolve(r.xs.get(0))) == @int_from_ptr(v)) {
        r = r.next;
    }
    if u.isnil(r) or (r.op != ir.OP_RET) {
        return false;
    }
    if r.xs.len > 0 {
        // (the registers of v, in order, with the caller's own mark)
        let ex = ir.ext_of(v);
        if (ex.len == 0) or (ex[0] < ir.EXT_REGS) or (ex[0] != v.blk.fnp.ret_ext) or
           (r.xs.len != (@as(usize, ex[0] & 3) + 1)) {
            return false;
        }
        for k in 0..r.xs.len {
            let x = r.xs.get(k);
            if (x.kind != ir.V_INST) or (x.op != ir.OP_INTR) or (ir.intr_id(x) != ir.IN_CALL_RESULT) or
               (@int_from_ptr(ir.resolve(x.xs.get(0))) != @int_from_ptr(v)) or
               (ir.cint_val(x.xs.get(1)) != @as(u64, k)) {
                return false;
            }
        }
        return u.isnil(r.a);
    }
    return u.isnil(r.a) or (@int_from_ptr(r.a) == @int_from_ptr(v));
}

// -----------------------------------------------------------------------------
// Uses
// -----------------------------------------------------------------------------
// Clears the selection state of f's values (loc, flag, uses, user, aux2),
// then counts each instruction's uses (user: the last) and marks with flag
// 1 the pointer arithmetic used only as addresses, folded into memory
// operands: that of loads, stores, atomics and further pointer arithmetic,
// and the arguments of intrinsics for which mem_arg says so. Without
// [base + index + disp] addressing (index_disp false), a register offset
// under further pointer arithmetic is added once, into a register its users
// share (and so is a constant offset under a register one, which needs its
// base in a register: built once rather than at every use).
pub fn count_uses(f: *mut ir.Func, index_disp: bool, mem_arg: fn(*ir.Value, usize) bool) void {
    for p in f.params {
        p.loc = -1;
        p.flag = 0;
    }
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.loc = -1;
            i.flag = 0;
            i.uses = 0;
            i.aux2 = 0;
            i.user = ir.vnil();
            if i.op == ir.OP_PTRADD {
                i.flag = 1;
            }
            i = i.next;
        }
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let ops: [3]*mut ir.Value = [i.a, i.b, i.c];
            for k in @as(usize, 0)..3 {
                let o = ops[k];
                if u.isnil(o) or (o.kind != ir.V_INST) {
                    continue;
                }
                o.uses += 1;
                o.user = i;
                if o.op == ir.OP_PTRADD {
                    let is_addr = ((i.op == ir.OP_LOAD) and (k == 0)) or ((i.op == ir.OP_STORE) and (k == 1)) or
                                  ((i.op == ir.OP_PTRADD) and (k == 0)) or
                                  (((i.op == ir.OP_RMW) or (i.op == ir.OP_CMPXCHG)) and (k == 0));
                    let indexed_base = not index_disp and (i.op == ir.OP_PTRADD) and (k == 0) and
                                       (not is_c(o.b) or not is_c(i.b));
                    if not is_addr or indexed_base {
                        o.flag = o.flag & ~1;
                    }
                }
            }
            for k in 0..i.xs.len {
                let o = i.xs.get(k);
                if o.kind == ir.V_INST {
                    o.uses += 1;
                    o.user = i;
                    if (o.op == ir.OP_PTRADD) and not mem_arg(i, k) {
                        o.flag = o.flag & ~1;
                    }
                }
            }
            i = i.next;
        }
        b = b.next;
    }
}

// -----------------------------------------------------------------------------
// Phis
// -----------------------------------------------------------------------------
// Copies into the successors' phis (as one parallel assignment): each
// as soon as no other copy still reads its destination, and a cycle broken
// by a temporary (rather than every value through one, which would keep
// twice as many registers live across a loop's back edge). reg, vreg,
// class_of and copy are the target's.
pub fn phi_copies(f: *mut mc.MFunc, b: *mut ir.Block, reg: fn(*mut ir.Value) i32, vreg: fn(*mut ir.Value) i32,
                  class_of: fn(*ir.Ty) u8, copy: fn(i32, i32, u8) void) void {
    let t = ir.terminator(b);
    let n = ir.succ_count(t);
    // (a jump table's thousands of edges: each successor once, by its place)
    let mut seen = u.nil_slice.[bool]();
    if n > 8 {
        seen = u.calloc_slice.[bool](f.blocks.len + 1);
    }
    for k in 0..n {
        let s = ir.succ(t, k);
        let mut dup = false;
        if n > 8 {
            dup = seen[@int_cast(usize, s.aux)];
            seen[@int_cast(usize, s.aux)] = true;
        } else {
            for j in 0..k {
                if ir.succ(t, j) == s {
                    dup = true;
                }
            }
        }
        if dup {
            continue;
        }
        let mut ds = u.List.[i32].empty();
        let mut ss = u.List.[i32].empty();
        let mut cs = u.List.[u8].empty();
        let mut p = s.first;
        while u.notnil(p) and (p.op == ir.OP_PHI) {
            // (an undefined input leaves the phi as it is)
            for j in 0..ir.bs_of(p).len {
                if (ir.bs_of(p).get(j) == b) and (p.xs.get(j).kind != ir.V_UNDEF) {
                    let r = reg(p.xs.get(j));
                    let d = vreg(p);
                    if r != d {
                        ds.push(d);
                        ss.push(r);
                        cs.push(class_of(p.ty));
                    }
                    break;
                }
            }
            p = p.next;
        }
        while ds.len > 0 {
            let mut ready: isize = -1;
            for i in 0..ds.len {
                let mut read = false;
                for j in 0..ss.len {
                    if (j != i) and (ss.get(j) == ds.get(i)) {
                        read = true;
                    }
                }
                if not read {
                    ready = @bit_cast(isize, i);
                    break;
                }
            }
            if ready < 0 {
                // a cycle: the first destination's value kept in a temporary
                let d = ds.get(0);
                let tr = mc.new_vreg(f, cs.get(0));
                copy(tr, d, cs.get(0));
                for j in 0..ss.len {
                    if ss.get(j) == d {
                        ss.set(j, tr);
                    }
                }
                continue;
            }
            let i = @bit_cast(usize, ready);
            copy(ds.get(i), ss.get(i), cs.get(i));
            let last = ds.len - 1;
            ds.set(i, ds.get(last));
            ss.set(i, ss.get(last));
            cs.set(i, cs.get(last));
            ds.len = last;
            ss.len = last;
            cs.len = last;
        }
        ds.deinit();
        ss.deinit();
        cs.deinit();
    }
    u.free_slice(seen);
}

// The successors of the IR terminator t as b's (the machine block's): in
// order, or, for more than 8 (a jump table's thousands of edges), each once.
pub fn push_succs(b: *mut mc.MBlock, t: *mut ir.Value) void {
    let n = ir.succ_count(t);
    for k in 0..n {
        b.succs.push(blk(ir.succ(t, k)));
    }
    if n > 8 {
        u.sort.[i32](b.succs.items(), cmp_i32);
        let mut m: usize = 0;
        for k in 0..b.succs.len {
            if (m == 0) or (b.succs.get(k) != b.succs.get(m - 1)) {
                b.succs.set(m, b.succs.get(k));
                m += 1;
            }
        }
        b.succs.len = m;
    }
}

fn cmp_i32(a: i32, b: i32) i32 {
    if a < b {
        return -1;
    }
    if a > b {
        return 1;
    }
    return 0;
}

// -----------------------------------------------------------------------------
// Module
// -----------------------------------------------------------------------------
pub fn bind_of(l: i32) u8 {
    if l == ir.LINK_INTERNAL {
        return elf.B_LOCAL;
    }
    if (l == ir.LINK_LINKONCE) or (l == ir.LINK_WEAK) or (l == ir.LINK_EXTWEAK) {
        return elf.B_WEAK;
    }
    return elf.B_GLOBAL;
}

// A module compiled in parts (backend.ax: compile_parts), whose objects
// refer to each other's internal functions and data: the first
// g_shared_funcs functions and g_shared_globals globals, which the module had
// when it was cut (a part's own are added after them). Their symbols are
// global, under names made unique with their index.
pub threadlocal let mut g_shared_funcs: usize = 0;
pub threadlocal let mut g_shared_globals: usize = 0;

fn shared(linkage: i32, kind: []u8, i: usize) bool {
    if linkage != ir.LINK_INTERNAL {
        return false;
    }
    if u.str_eq(kind, "f") {
        return i < g_shared_funcs;
    }
    return i < g_shared_globals;
}

fn sym_name(name: []u8, linkage: i32, kind: []u8, i: usize) []u8 {
    if shared(linkage, kind, i) {
        return u.f3("%s.#%s%s", name, kind, u.zdec(i));
    }
    return name;
}

fn sym_bind(linkage: i32, kind: []u8, i: usize) u8 {
    if shared(linkage, kind, i) {
        return elf.B_GLOBAL;
    }
    return bind_of(linkage);
}

// What add_symbols records for a function or global defined elsewhere: its
// symbol is made when the code first refers to it (fsym_at, gsym_at), so an
// object (one part of a module compiled in parts) has only those it uses.
pub const LAZY: u32 = 0xFFFFFFFF;

pub fn fsym_at(obj: *mut elf.Obj, fsym: *mut u.List.[u32], f: *ir.Func) u32 {
    let k = @int_cast(usize, f.id);
    let s = fsym.get(k);
    if s != LAZY {
        return s;
    }
    // (perm: the code that first refers to it is compiled in a scratch scope)
    let n = elf.ext_sym(obj, u.perm_dup(sym_name(f.name, f.linkage, "f", k)), f.linkage == ir.LINK_EXTWEAK);
    fsym.set(k, n);
    return n;
}

pub fn gsym_at(obj: *mut elf.Obj, gsym: *mut u.List.[u32], g: *ir.Global) u32 {
    let k = @int_cast(usize, g.id);
    let s = gsym.get(k);
    if s != LAZY {
        return s;
    }
    let n = elf.ext_sym(obj, u.perm_dup(sym_name(g.name, g.linkage, "g", k)), g.linkage == ir.LINK_EXTWEAK);
    if g.tls and not tg.platform_tls() {
        obj.syms.at(@as(usize, n)).ty = elf.T_TLS;  // (the platform's: the descriptor, platform_tlv)
    }
    gsym.set(k, n);
    return n;
}

/// Is a global's address taken from the GOT: a declaration (possibly in a
/// shared library), or a preemptible definition (preemptible)?
pub fn extern_global(g: *ir.Global) bool {
    return u.isnil(g.init) or (not g.tls and preemptible(g.linkage, g.visibility));
}

/// Is a definition of this linkage and visibility (ir.VIS_) preemptible:
/// code for a shared library (--pic: target.ax g_pic; ELF), whose symbols
/// of default visibility a module loaded before it may define, as the ELF
/// gABI's symbol preemption has it (an executable's copy of the library's
/// object, the program's own definition of a function)? Then its address
/// comes from the GOT and its calls go through the PLT, as a declaration's
/// do, and the linker binds them (elink.ax). Hidden and protected symbols
/// bind within the module.
pub fn preemptible(linkage: i32, vis: u8) bool {
    return tg.g_pic and not tg.is_windows() and not tg.is_darwin() and not tg.is_wasm() and
           ((linkage == ir.LINK_EXTERNAL) or (linkage == ir.LINK_WEAK)) and (vis == ir.VIS_DEFAULT);
}

pub fn has_addresses(x: *ir.Value) bool {
    if (x.kind == ir.V_GLOBAL) or (x.kind == ir.V_FUNC) {
        return true;
    }
    if x.kind == ir.V_CAGG {
        for i in 0..x.xs.len {
            if has_addresses(x.xs.get(i)) {
                return true;
            }
        }
    }
    return false;
}

// The initial value x at offset base of s: its bytes, and for the addresses
// in it relocations of type abs64 (fsym and gsym: the symbols of the
// module's functions and globals).
fn emit_data(obj: *mut elf.Obj, s: *mut elf.Sec, base: u64, x: *mut ir.Value, abs64: u32, fsym: *mut u.List.[u32],
             gsym: *mut u.List.[u32]) void {
    let t = x.ty;
    let k = x.kind;
    if k == ir.V_GLOBAL {
        if ir.gv_of(x).tls {
            u.die(u.f1("internal compiler error: a thread-local's address in data: %s", ir.gv_of(x).name));
        }
        s.relocs.push(
            elf.Rel.{ off: base, ty: abs64, sym: gsym_at(obj, gsym, ir.gv_of(x)), addend: @bit_cast(i64, x.cv) });
        return;
    }
    if k == ir.V_FUNC {
        s.relocs.push(elf.Rel.{ off: base, ty: abs64, sym: fsym_at(obj, fsym, ir.fnp_of(x)), addend: 0 });
        return;
    }
    if (k == ir.V_CAGG) and (t.kind != ir.T_VEC) {
        for i in 0..x.xs.len {
            emit_data(obj, s, base + ir.field_off(t, i), x.xs.get(i), abs64, fsym, gsym);
        }
        return;
    }
    // (the section's bytes are zero already, as add_symbols zeroes each global's)
    let v = s.data.view();
    let at = @truncate(usize, base);
    if k == ir.V_CINT {
        for i in 0..@truncate(usize, t.size) {
            v[at + i] = @truncate(u8, x.cv >> @int_cast(u32, i * 8));
        }
        return;
    }
    if k == ir.V_CSTR {
        let bs = ir.bytes_of(x);
        for i in 0..bs.len {
            v[at + i] = bs[i];
        }
        return;
    }
    let mut b = bn.new_bytes();
    const_le(x, &mut b, 0);
    for i in 0..b.len() {
        v[at + i] = b.view()[i];
    }
    b.free();
}

// The section of a global given one by name (C's attribute section, on
// Linux): made the first time, read-only or written data.
// The aliases' symbols whose places are their target functions' (once the
// code is placed: finish_aliases): alias symbol << 32 | target's symbol.
threadlocal let mut alias_fix: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };

// The symbols of m's aliases (ir.Alias) whose targets this object defines:
// a global (or weak) symbol of the alias's name at the target's place, a
// function's once its code is placed (finish_aliases).
fn add_aliases(obj: *mut elf.Obj, m: *mut ir.Module, fsym: *mut u.List.[u32], gsym: *mut u.List.[u32]) void {
    alias_fix.clear();
    for k in 0..m.aliases.len {
        let a = m.aliases.at(k);
        let mut bind = elf.B_GLOBAL;
        if a.weak {
            bind = elf.B_WEAK;
        }
        let af = ir.alias_func(m, a);
        let ag = ir.alias_global(m, a);
        let mut t: u32 = LAZY;
        if u.notnil(af) and not ir.is_decl(af) {
            t = fsym.get(@int_cast(usize, af.id));
        } else if u.notnil(ag) and u.notnil(ag.init) {
            t = gsym.get(@int_cast(usize, ag.id));
        }
        if t == LAZY {
            continue;  // (its target is not this object's: another part's)
        }
        let ts = obj.syms.get(@as(usize, t));
        let mut ty = ts.ty;
        if a.ifunc {
            ty = elf.T_IFUNC;
        }
        let s = elf.add_sym(obj, elf.Sym.{ name: a.name, sec: ts.sec, value: ts.value, size: ts.size, bind: bind,
                                           ty: ty, hidden: hidden_vis(a.visibility),
                                           protected: a.visibility == ir.VIS_PROTECTED });
        if a.ifunc {
            // the name's declaration is the symbol: references bind to it
            let d = m.fmap.get(a.name);
            if u.notnil(d) and ir.is_decl(d) and (d.id >= 0) and (@int_cast(usize, d.id) < m.funcs.len) and
               (m.funcs.get(@int_cast(usize, d.id)) == d) {
                fsym.set(@int_cast(usize, d.id), s);
            }
        }
        if u.notnil(af) {
            alias_fix.push((@as(u64, s) << 32) | @as(u64, t));
        }
    }
}

/// The symbols of aliases of functions get their targets' places, once the
/// code generator has placed the functions' code.
pub fn finish_aliases(obj: *mut elf.Obj) void {
    for x in alias_fix.items() {
        let t = obj.syms.get(@truncate(usize, x & 0xffff_ffff));
        let s = obj.syms.at(@truncate(usize, x >> 32));
        s.sec = t.sec;
        s.value = t.value;
        s.size = t.size;
    }
    alias_fix.clear();
}

/// Each function in a section of its own (--function-sections), each
/// datum likewise (--data-sections): a link may then leave out what nothing
/// refers to (nlink.ax: --gc-sections).
pub let mut g_function_sections: bool = false;
pub let mut g_data_sections: bool = false;
/// An object for other links (--emit=obj, lib, shared): a definition any
/// unit may repeat (ir.LINK_LINKONCE) is in a section of its own, in a
/// COMDAT group named after its symbol (Sec.group), so that a link keeps
/// one group of the name, whichever linker it is.
pub let mut g_comdat: bool = false;

// A section of its own for one function's code or one datum (named after
// its symbol), in COMDAT group `group` if that is not empty.
fn own_section(obj: *mut elf.Obj, name: []u8, kind: i32, align: u64, group: []u8) i32 {
    let k = elf.add_sec(obj, u.perm_dup(name), kind, align);
    obj.secs.get(@int_cast(usize, k)).group = u.perm_dup(group);
    return k;
}

// The code section named `name` (made once).
fn code_section(obj: *mut elf.Obj, name: []u8) i32 {
    let k = elf.find_sec(obj, name);
    if (k >= 0) and (obj.secs.get(@int_cast(usize, k)).kind == elf.S_TEXT) {
        return k;
    }
    return elf.add_sec(obj, u.perm_dup(name), elf.S_TEXT, 16);
}

// The section of function f's code (its symbol: nm). The section attribute
// names it (functions naming one name share it: the Mach-O
// "segment,section" form and COFF names are the object writers'); else a
// cold function's code (C's attribute cold, the outlined cold paths of
// outline.ax) is in .text.unlikely and a hot one's in .text.hot, which
// the linkers place after and before the rest (nlink.ax: place); and the
// code of a link-once function of an object for other links, or of every
// function with --function-sections, is in a section of its own
// (.text.<name>, .text.unlikely.<name>, ...).
fn func_section(obj: *mut elf.Obj, f: *ir.Func, text: i32, nm: []u8) i32 {
    if f.section.len > 0 {
        return code_section(obj, f.section);
    }
    let mut pre = ".text";
    if f.cold {
        pre = ".text.unlikely";
    } else if f.hot {
        pre = ".text.hot";
    }
    let once = g_comdat and (f.linkage == ir.LINK_LINKONCE);
    if g_function_sections or once {
        let mut g: []u8 = "";
        if once {
            g = nm;
        }
        return own_section(obj, u.f2("%s.%s", pre, nm), elf.S_TEXT, 16, g);
    }
    if u.str_eq(pre, ".text") {
        return text;
    }
    return code_section(obj, pre);
}

// The section of datum g (its symbol: nm), given the one its kind goes in
// (sec): that, or with --data-sections, or for a link-once datum of an
// object for other links, a section of its own (<sec's name>.<name>, the
// link-once one in a COMDAT group of the name).
fn data_section(obj: *mut elf.Obj, g: *ir.Global, sec: i32, nm: []u8) i32 {
    let once = g_comdat and (g.linkage == ir.LINK_LINKONCE);
    if not (g_data_sections or once) {
        return sec;
    }
    let base = obj.secs.get(@int_cast(usize, sec));
    let mut grp: []u8 = "";
    if once {
        grp = nm;
    }
    return own_section(obj, u.f2("%s.%s", base.name, nm), base.kind, 1, grp);
}

// --data-sections: the function that first refers to each of the
// compiler's own data (an internal global whose name starts with '.': a
// call-site record, a constant, a string), by Global.id: its index in
// m.funcs + 1, or 0 (none: what only other data refers to; a call's
// chain of records counts as its code's). Such data is
// in a section of its function's (owned_section) rather than one of its
// own: what a link keeps of it is much the same (data of the compiler's
// own is seldom shared by functions), for far fewer sections.
fn data_owners(m: *ir.Module) []mut u32 {
    let own = u.newn.[u32](m.globals.len + 1);
    for fi in 0..m.funcs.len {
        let f = m.funcs.get(fi);
        let mut b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                for k in 0..(3 + i.xs.len) {
                    let v = ir.operand(i, k);
                    if u.notnil(v) and (v.kind == ir.V_GLOBAL) {
                        own_data(m, own, ir.gv_of(v), fi);
                    }
                }
                if i.op == ir.OP_CALL {
                    // (and the records of a call's chain: ftab.ax)
                    let mut c = ir.chain_of(i);
                    while u.notnil(c) {
                        own_data(m, own, ir.gv_of(c.site), fi);
                        c = c.next;
                    }
                }
                i = i.next;
            }
            b = b.next;
        }
    }
    return own;
}

fn own_data(m: *ir.Module, own: []mut u32, g: *ir.Global, fi: usize) void {
    let id = @as(usize, @bit_cast(u32, g.id));
    if (id < m.globals.len) and (own[id] == 0) and (g.linkage == ir.LINK_INTERNAL) and (g.name.len > 0) and
       (g.name[0] == '.') {
        own[id] = @int_cast(u32, fi) + 1;
    }
}

// The section for data of the function whose symbol is fs that would be in
// section `sec` (data_owners): <sec's name>.<the function's>, made once
// (in `made`: sec << 32 | the function's symbol -> the section + 1).
fn owned_section(obj: *mut elf.Obj, sec: i32, fs: u32, made: *mut u.U64Map) i32 {
    let key = (@as(u64, @bit_cast(u32, sec)) << 32) | @as(u64, fs);
    let k = made.get(key);
    if k != 0 {
        return @truncate(i32, @bit_cast(i64, k - 1));
    }
    let base = obj.secs.get(@int_cast(usize, sec));
    let n = own_section(obj, u.f2("%s.%s", base.name, obj.syms.get(@as(usize, fs)).name), base.kind, 1, "");
    made.put(key, @as(u64, @bit_cast(u32, n)) + 1);
    return n;
}

/// The read-only data section for what only the code of section `text`
/// refers to (a jump table, whose entries refer to that code): `rodata`,
/// or for code in a COMDAT group, a section of the group (a link that drops
/// the group drops it too; a relocation from outside a group into a dropped
/// one is an error to the system linkers).
pub fn group_rodata(obj: *mut elf.Obj, text: i32, rodata: i32) i32 {
    let g = obj.secs.get(@int_cast(usize, text)).group;
    if g.len == 0 {
        return rodata;
    }
    let name = u.cat2(".rodata.", g);
    let k = elf.find_sec(obj, name);
    if k >= 0 {
        return k;
    }
    return own_section(obj, name, elf.S_RODATA, 4, g);
}

/// Windows: the unwind information's section `name` (.xdata, .pdata) for
/// the code of section `text`: the object's (`base`) for .text's, else one
/// that goes with the code (Sec.link1), in its COMDAT group if it has one
/// (COFF's associative COMDAT section, coff.ax), so that a link that drops
/// the code (a COMDAT copy, --gc-sections) drops its entries.
pub fn group_unwind(obj: *mut elf.Obj, text: i32, name: []u8, base: i32) i32 {
    let ts = obj.secs.get(@int_cast(usize, text));
    let g = ts.group;
    if u.str_eq(ts.name, ".text") {
        return base;
    }
    for k in 0..obj.secs.len {
        let s = obj.secs.get(k);
        if u.str_eq(s.name, name) and (s.link1 == text + 1) {
            return @int_cast(i32, k);
        }
    }
    let k = own_section(obj, name, elf.S_RODATA, 4, g);
    obj.secs.get(@int_cast(usize, k)).link1 = text + 1;
    return k;
}

fn named_section(obj: *mut elf.Obj, name: []u8, ro: bool) i32 {
    for k in 0..obj.secs.len {
        if u.str_eq(obj.secs.get(k).name, name) {
            return @int_cast(i32, k);
        }
    }
    let mut kind = elf.S_DATA;
    if ro {
        kind = elf.S_RODATA;
    }
    return elf.add_sec(obj, u.perm_dup(name), kind, 1);
}

// Is a symbol of visibility vis (C's attribute visibility: ir.VIS_) hidden
// in the object (STV_HIDDEN)? Internal is written as hidden, which it
// implies (the ELF gABI's STV_INTERNAL adds only a processor's meaning);
// protected is STV_PROTECTED (elf.Sym.protected; Mach-O and COFF have no
// such visibility: there it is default).
fn hidden_vis(vis: u8) bool {
    return (vis == ir.VIS_HIDDEN) or (vis == ir.VIS_INTERNAL);
}

// A thread-local of macOS in the platform's form (--macos-tls=platform: as
// its toolchain makes one, which dyld and the platform's linker and
// debugger read): the variable's symbol is its descriptor in __thread_vars, three words (the
// thunk that finds it, _tlv_bootstrap until dyld replaces it; a key dyld
// sets; the address of its initial value, which the linker makes its
// offset in the template), and the value is <name>$tlv$init in
// __thread_data (__thread_bss if all zero). Code finds the variable by
// calling the thunk with the descriptor's address (a64.ax, x64.ax: TLS).
// Returns the descriptor's symbol.
fn platform_tlv(obj: *mut elf.Obj, g: *ir.Global, i: usize) u32 {
    let zero = ir.is_zero(g.init);
    let gname = sym_name(g.name, g.linkage, "g", i);
    let base_d = tlv_section(
        obj, u.pick(zero, ".macho.thread_bss", ".macho.thread_data"), u32_pick_k(zero, elf.S_BSS, elf.S_DATA), 16);
    let dsec = data_section(obj, g, base_d, gname);
    let vsec = data_section(obj, g, tlv_section(obj, ".macho.thread_vars", elf.S_DATA, 8), gname);
    let ds = obj.secs.get(@int_cast(usize, dsec));
    let mut al = g.align;
    if al == 0 {
        al = 1;
    }
    if al > ds.align {
        ds.align = al;
    }
    let mut off: u64 = 0;
    if zero {
        ds.size = (ds.size + al - 1) & ~(al - 1);
        off = ds.size;
        ds.size += g.ty.size;
    } else {
        ds.data.align(@truncate(usize, al));
        off = @as(u64, ds.data.len());
        ds.data.zeros(@truncate(usize, g.ty.size));
    }
    let init = elf.add_sym(obj, elf.Sym.{ name: u.perm_dup(u.cat2(gname, "$tlv$init")), sec: dsec, value: off,
                                          size: g.ty.size, bind: elf.B_LOCAL, ty: elf.T_OBJECT, hidden: false,
                                          protected: false });
    let vs = obj.secs.get(@int_cast(usize, vsec));
    vs.data.align(8);
    let at = @as(u64, vs.data.len());
    vs.data.zeros(24);
    let boot = elf.ext_sym(obj, "_tlv_bootstrap", false);
    vs.relocs.push(elf.Rel.{ off: at, ty: tlv_abs64(obj), sym: boot, addend: 0 });
    vs.relocs.push(elf.Rel.{ off: at + 16, ty: tlv_abs64(obj), sym: init, addend: 0 });
    return elf.add_sym(obj, elf.Sym.{ name: gname, sec: vsec, value: at, size: 24, bind: sym_bind(g.linkage, "g", i),
                                      ty: elf.T_OBJECT, hidden: hidden_vis(g.visibility),
                                      protected: g.visibility == ir.VIS_PROTECTED });
}

// The section `name` of the platform's thread-locals (made once).
fn tlv_section(obj: *mut elf.Obj, name: []u8, kind: i32, align: u64) i32 {
    let k = elf.find_sec(obj, name);
    if k >= 0 {
        return k;
    }
    return elf.add_sec(obj, name, kind, align);
}

fn u32_pick_k(c: bool, a: i32, b: i32) i32 {
    if c {
        return a;
    }
    return b;
}

// The 8-byte absolute relocation of obj's machine.
fn tlv_abs64(obj: *elf.Obj) u32 {
    if obj.machine == elf.EM_X86_64 {
        return elf.R_X86_64_64;
    }
    return elf.R_AARCH64_ABS64;
}

// The symbols of m's functions (defined in text) and globals, in fsym and
// gsym (by Func.id and Global.id); each defined global laid out in .data,
// .bss, .tbss, .tdata, rodata or .data.rel.ro (sections added here), with
// its initial value (abs64: the relocation type of an address in one).
// Returns .data.rel.ro.
pub fn add_symbols(obj: *mut elf.Obj, m: *mut ir.Module, text: i32, rodata: i32, abs64: u32, fsym: *mut u.List.[u32],
                   gsym: *mut u.List.[u32]) i32 {
    let data = elf.add_sec(obj, ".data", elf.S_DATA, 16);
    let bss = elf.add_sec(obj, ".bss", elf.S_BSS, 16);
    let tbss = elf.add_sec(obj, ".tbss", elf.S_TBSS, 16);
    let tdata = elf.add_sec(obj, ".tdata", elf.S_TDATA, 16);
    let relro = elf.add_sec(obj, ".data.rel.ro", elf.S_DATA, 16);
    fsym.clear();
    gsym.clear();
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if ir.is_decl(f) {
            fsym.push(LAZY);
        } else {
            let nm = sym_name(f.name, f.linkage, "f", i);
            fsym.push(elf.add_sym(obj, elf.Sym.{ name: nm, sec: func_section(obj, f, text, nm), value: 0, size: 0,
                                                 bind: sym_bind(f.linkage, "f", i), ty: elf.T_FUNC,
                                                 hidden: hidden_vis(f.visibility),
                                                 protected: f.visibility == ir.VIS_PROTECTED }));
        }
    }
    let mut owners = u.newn.[u32](1);
    let mut made = u.U64Map.empty();
    if g_data_sections {
        owners = data_owners(m);
    }
    for i in 0..m.globals.len {
        let g = m.globals.get(i);
        if u.isnil(g.init) {
            gsym.push(LAZY);
            continue;
        }
        let mut sec = data;
        if g.tls and tg.platform_tls() {
            gsym.push(platform_tlv(obj, g, i));
            continue;
        } else if g.tls {
            sec = tbss;
            if not ir.is_zero(g.init) {
                sec = tdata;
            }
        } else if g.is_const {
            sec = rodata;
            if has_addresses(g.init) {
                sec = relro;  // relocated at load time
            }
        } else if ir.is_zero(g.init) {
            sec = bss;
        }
        let gname = sym_name(g.name, g.linkage, "g", i);
        if (g.section.len > 0) and not g.tls {
            sec = named_section(obj, g.section, sec == rodata);
        } else if (i < owners.len) and (owners[i] != 0) and not g.tls {
            sec = owned_section(obj, sec, fsym.get(@as(usize, owners[i] - 1)), &mut made);
        } else {
            sec = data_section(obj, g, sec, gname);
        }
        let s = obj.secs.get(@int_cast(usize, sec));
        let mut al = g.align;
        if al == 0 {
            al = 1;
        }
        if al > s.align {
            s.align = al;  // the section is at least as aligned as its contents
        }
        let mut off: u64 = 0;
        if (s.kind == elf.S_BSS) or (s.kind == elf.S_TBSS) {
            s.size = (s.size + al - 1) & ~(al - 1);
            off = s.size;
            s.size += g.ty.size;
        } else {
            s.data.align(@truncate(usize, al));
            off = @as(u64, s.data.len());
            s.data.zeros(@truncate(usize, g.ty.size));
        }
        let mut ty = elf.T_OBJECT;
        if g.tls {
            ty = elf.T_TLS;
        }
        gsym.push(elf.add_sym(obj, elf.Sym.{ name: gname, sec: sec, value: off, size: g.ty.size,
                                             bind: sym_bind(g.linkage, "g", i), ty: ty,
                                             hidden: hidden_vis(g.visibility),
                                             protected: g.visibility == ir.VIS_PROTECTED }));
    }
    made.deinit();
    add_aliases(obj, m, fsym, gsym);
    for i in 0..m.globals.len {
        let g = m.globals.get(i);
        if u.isnil(g.init) {
            continue;
        }
        let mut s = obj.syms.at(@as(usize, gsym.get(i)));
        if g.tls and tg.platform_tls() {
            // (the variable's initial value: in the template, its descriptor's third word's target)
            let vs = obj.secs.get(@int_cast(usize, s.sec));
            for r in vs.relocs.items() {
                if r.off == (s.value + 16) {
                    s = obj.syms.at(@as(usize, r.sym));
                }
            }
        }
        let sec = obj.secs.get(@int_cast(usize, s.sec));
        if (sec.kind == elf.S_BSS) or (sec.kind == elf.S_TBSS) {
            continue;
        }
        emit_data(obj, sec, s.value, g.init, abs64, fsym, gsym);
    }
    return relro;
}
