// =============================================================================
// opt.ax - analyses and transformations on the scalar IR (after lower.ax):
// predecessors, reverse postorder, dominators, promotion of stack slots to
// SSA values (mem2reg), constant folding, dead code elimination and CFG
// simplification.
// =============================================================================
import "combine.ax" as cb;
import "dbginfo.ax" as dbi;
import "ir.ax" as ir;
import "switches.ax" as swl;
import "util.ax" as u;

fn vnil() *mut ir.Value {
    return u.nil.[ir.Value]();
}

fn bnil() *mut ir.Block {
    return u.nil.[ir.Block]();
}

// -----------------------------------------------------------------------------
// CFG analyses
// -----------------------------------------------------------------------------
pub fn compute_preds(f: *mut ir.Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        b.preds.clear();
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let t = ir.terminator(b);
        for i in 0..ir.succ_count(t) {
            let s = ir.succ(t, i);
            // (b's edges are added together: a repeat is the last one)
            if (s.preds.len == 0) or (s.preds.get(s.preds.len - 1) != b) {
                s.preds.push(b);
            }
        }
        b = b.next;
    }
}

// Blocks in reverse postorder (entry first); sets b.rpo. Unreachable blocks
// get rpo -1 and are not in the list. Successors are visited last to first,
// so a block's first successor (the then-block, a loop's body) comes right
// after it: loops stay contiguous in the code layout.
pub fn rpo(f: *mut ir.Func) u.List.[*mut ir.Block] {
    let mut out = u.List.[*mut ir.Block].empty();
    let mut b = f.first;
    let mut n: usize = 0;
    while u.notnil(b) {
        b.rpo = -1;
        b.aux = 0;
        n += 1;
        b = b.next;
    }
    if u.isnil(f.first) {
        return out;
    }
    // iterative DFS: stack of (block, next successor index)
    let st = u.calloc_slice.[*mut ir.Block](n + 1);
    let si = u.calloc_slice.[usize](n + 1);
    let post = u.calloc_slice.[*mut ir.Block](n + 1);
    let mut np: usize = 0;
    let mut sp: usize = 0;
    st[0] = f.first;
    si[0] = 0;
    f.first.aux = 1;
    sp = 1;
    while sp > 0 {
        let x = st[sp - 1];
        let t = ir.terminator(x);
        let k = si[sp - 1];
        let ns = ir.succ_count(t);
        if k < ns {
            si[sp - 1] = k + 1;
            let s = ir.succ(t, (ns - 1) - k);
            if s.aux == 0 {
                s.aux = 1;
                st[sp] = s;
                si[sp] = 0;
                sp += 1;
            }
        } else {
            post[np] = x;
            np += 1;
            sp -= 1;
        }
    }
    out.reserve(np);
    let mut i = np;
    while i > 0 {
        i -= 1;
        post[i].rpo = @int_cast(i32, out.len);
        out.push(post[i]);
    }
    u.free_slice.[*mut ir.Block](st);
    u.free_slice.[usize](si);
    u.free_slice.[*mut ir.Block](post);
    return out;
}

fn intersect(a0: *mut ir.Block, b0: *mut ir.Block) *mut ir.Block {
    let mut a = a0;
    let mut b = b0;
    while a != b {
        while a.rpo > b.rpo {
            a = a.idom;
        }
        while b.rpo > a.rpo {
            b = b.idom;
        }
    }
    return a;
}

// Dominator tree (Cooper, Harvey and Kennedy). Needs compute_preds; returns
// the reverse postorder.
pub fn dominators(f: *mut ir.Func) u.List.[*mut ir.Block] {
    let order = rpo(f);
    for i in 0..order.len {
        let b = order.get(i);
        b.idom = bnil();
        b.dom_kids.clear();
    }
    if order.len == 0 {
        return order;
    }
    let entry = order.get(0);
    entry.idom = entry;
    let mut changed = true;
    while changed {
        changed = false;
        for i in 1..order.len {
            let b = order.get(i);
            let mut nd = bnil();
            for k in 0..b.preds.len {
                let p = b.preds.get(k);
                if (p.rpo < 0) or u.isnil(p.idom) {
                    continue;
                }
                if u.isnil(nd) {
                    nd = p;
                } else {
                    nd = intersect(p, nd);
                }
            }
            if nd != b.idom {
                b.idom = nd;
                changed = true;
            }
        }
    }
    entry.depth = 0;
    for i in 1..order.len {
        let b = order.get(i);
        b.idom.dom_kids.push(b);
    }
    for i in 1..order.len {
        let b = order.get(i);
        b.depth = b.idom.depth + 1;
    }
    number_tree(&order);
    return order;
}

// Numbers the blocks of the dominator tree so that a block's subtree is a
// range (dom_lo..dom_hi): `dominates` is then two comparisons, where walking
// up from the lower block is as long as the tree is deep (a function that is
// a long chain of branches has a tree as deep as it is long).
let mut dom_runs: i32 = 0;

fn number_tree(order: *u.List.[*mut ir.Block]) void {
    dom_runs += 1;
    let n = order.len;
    // subtree sizes (dom_hi, for now), children before parents
    for i in 0..n {
        order.get(i).dom_hi = 1;
    }
    let mut i = n;
    while i > 1 {
        i -= 1;
        let b = order.get(i);
        b.idom.dom_hi += b.dom_hi;
    }
    // a parent's children take consecutive ranges after its own number
    // (dom_run, for now: the next free number in a block's range; parents
    // come before their children)
    let entry = order.get(0);
    entry.dom_lo = 0;
    entry.dom_hi -= 1;
    entry.dom_run = 1;
    for k in 1..n {
        let b = order.get(k);
        let p = b.idom;
        let size = b.dom_hi;
        b.dom_lo = p.dom_run;
        b.dom_hi = b.dom_lo + size - 1;
        p.dom_run += size;
        b.dom_run = b.dom_lo + 1;
    }
    for k in 0..n {
        order.get(k).dom_run = dom_runs;
    }
}

pub fn dominates(a: *mut ir.Block, b0: *mut ir.Block) bool {
    if (a.dom_run == b0.dom_run) and (a.dom_run != 0) {
        return (a.dom_lo <= b0.dom_lo) and (b0.dom_lo <= a.dom_hi);
    }
    // (a block made since the tree was)
    let mut b = b0;
    while b.depth > a.depth {
        b = b.idom;
    }
    return b == a;
}

// Is the edge from p into h a back edge (p reachable, and h dominates it)?
pub fn is_back_edge(p: *mut ir.Block, h: *mut ir.Block) bool {
    return (p.rpo >= 0) and dominates(h, p);
}

// Does a back edge enter h?
pub fn is_loop_header(h: *mut ir.Block) bool {
    for k in 0..h.preds.len {
        if is_back_edge(h.preds.get(k), h) {
            return true;
        }
    }
    return false;
}

// The loop headers in `order` (after its first block), in that order.
pub fn loop_headers(order: *u.List.[*mut ir.Block]) u.List.[*mut ir.Block] {
    let mut hs = u.List.[*mut ir.Block].empty();
    for i in 1..order.len {
        if is_loop_header(order.get(i)) {
            hs.push(order.get(i));
        }
    }
    return hs;
}

// The blocks of the loop with header h (h first): the blocks that reach a
// back edge into h without passing through h, each marked tag.
pub fn members_of(h: *mut ir.Block, tag: i64, out: *mut u.List.[*mut ir.Block]) void {
    out.clear();
    h.mark = tag;
    out.push(h);
    let mut work = u.List.[*mut ir.Block].empty();
    for k in 0..h.preds.len {
        let p = h.preds.get(k);
        if is_back_edge(p, h) and (p.mark != tag) {
            p.mark = tag;
            work.push(p);
        }
    }
    while work.len > 0 {
        let x = work.pop();
        out.push(x);
        for k in 0..x.preds.len {
            let p = x.preds.get(k);
            if (p.rpo >= 0) and (p.mark != tag) {
                p.mark = tag;
                work.push(p);
            }
        }
    }
    work.deinit();
}

// True if v is an instruction in a block marked tag.
pub fn in_members(v: *ir.Value, tag: i64) bool {
    return u.notnil(v) and (v.kind == ir.V_INST) and u.notnil(v.blk) and (v.blk.mark == tag);
}

// After clone_members: the copy of v if it is in a block marked tag, else v.
pub fn member_copy(v: *mut ir.Value, tag: i64) *mut ir.Value {
    if in_members(v, tag) {
        return @ptr_cast(*mut ir.Value, v.auxp);
    }
    return v;
}

pub fn member_copy_blk(b: *mut ir.Block, tag: i64) *mut ir.Block {
    if u.notnil(b) and (b.mark == tag) {
        return @ptr_cast(*mut ir.Block, b.auxp);
    }
    return b;
}

// Copies the blocks of `members` (marked `tag`) into new blocks of f:
// x.auxp is the copy of each block and instruction; operands and targets
// inside the members are mapped to the copies.
pub fn clone_members(f: *mut ir.Func, members: *u.List.[*mut ir.Block], tag: i64) void {
    for k in 0..members.len {
        let x = members.get(k);
        let nb = ir.append_block(f, x.name);
        x.auxp = @ptr_cast(*mut void, nb);
        let mut v = x.first;
        while u.notnil(v) {
            let y = ir.copy_inst(f, v);
            v.auxp = @ptr_cast(*mut void, y);
            ir.append_inst(nb, y);
            v = v.next;
        }
    }
    for k in 0..members.len {
        let nb = @ptr_cast(*mut ir.Block, members.get(k).auxp);
        let mut y = nb.first;
        while u.notnil(y) {
            y.a = member_copy(ir.resolve(y.a), tag);
            y.b = member_copy(ir.resolve(y.b), tag);
            y.c = member_copy(ir.resolve(y.c), tag);
            for j in 0..y.xs.len {
                y.xs.set(j, member_copy(ir.resolve(y.xs.get(j)), tag));
            }
            for j in 0..ir.bs_of(y).len {
                ir.bs_of(y).set(j, member_copy_blk(ir.bs_of(y).get(j), tag));
            }
            y.t1 = member_copy_blk(y.t1, tag);
            y.t2 = member_copy_blk(y.t2, tag);
            // (-g: the copies of the marks, the values they give mapped alike)
            let mut mk = ir.dbg_marks_at(y);
            while mk >= 0 {
                let src = ir.dbg_mark_src(mk);
                if src >= 0 {
                    let v = ir.dbg_mark_value(src);
                    if u.notnil(v) {
                        ir.dbg_mark_set(mk, member_copy(v, tag), ir.dbg_mark_low(src), ir.dbg_mark_add(src));
                    }
                }
                mk = ir.dbg_mark_next(mk);
            }
            y = y.next;
        }
    }
}

// Loop nesting depth of each block (from back edges: an edge to a block
// that dominates its source). Needs dominators.
pub fn loop_depths(f: *mut ir.Func, order: *u.List.[*mut ir.Block]) void {
    for i in 0..order.len {
        order.get(i).loop_depth = 0;
    }
    for i in 0..order.len {
        let h = order.get(i);
        // back edges into h: collect the loop body by walking predecessors
        let mut body = u.List.[*mut ir.Block].empty();
        for k in 0..h.preds.len {
            let p = h.preds.get(k);
            if is_back_edge(p, h) {
                body.push(p);
            }
        }
        if body.len == 0 {
            continue;
        }
        let mark = @int_cast(i64, i) + 1000000;
        h.aux = mark;
        let mut members = u.List.[*mut ir.Block].empty();
        members.push(h);
        while body.len > 0 {
            let x = body.pop();
            if x.aux == mark {
                continue;
            }
            x.aux = mark;
            members.push(x);
            for k in 0..x.preds.len {
                let p = x.preds.get(k);
                if (p.rpo >= 0) and (p.aux != mark) {
                    body.push(p);
                }
            }
        }
        for k in 0..members.len {
            members.get(k).loop_depth += 1;
        }
        body.deinit();
        members.deinit();
    }
}

// -----------------------------------------------------------------------------
// mem2reg
// -----------------------------------------------------------------------------
struct Slot {
    a: *mut ir.Value,  // the alloca
    stack: u.List.[*mut ir.Value],
    defs: u.List.[*mut ir.Block],
}

fn promotable_use(i: *mut ir.Value, a: *mut ir.Value) bool {
    let op = i.op;
    if (op == ir.OP_LOAD) and (i.a == a) {
        return (i.flags == 0) and (i.ty == ir.aty_of(a));
    }
    if (op == ir.OP_STORE) and (i.b == a) and (i.a != a) {
        return (i.flags == 0) and (i.a.ty == ir.aty_of(a));
    }
    return false;
}

fn mark_escape(o: *mut ir.Value, i: *mut ir.Value) void {
    if ir.is_op(o, ir.OP_ALLOCA) {
        if not promotable_use(i, o) {
            o.aux = -1;
        }
    }
}

// -O0: the allocas of C variables (ir.F_VAR) stay in memory (passes.ax sets it).
pub let mut keep_vars: bool = false;

pub fn mem2reg(f: *mut ir.Func) void {
    let e = f.first;
    if u.isnil(e) {
        return;
    }
    // candidates: allocas of scalar types
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if i.op == ir.OP_ALLOCA {
                i.aux = 0;
                if ir.is_agg(ir.aty_of(i)) or (keep_vars and ((i.flags & ir.F_VAR) != 0)) {
                    i.aux = -1;
                }
            } else if i.op == ir.OP_PHI {
                i.aux2 = 0;  // (the phis this places are tagged with their slot)
            }
            i = i.next;
        }
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            mark_escape(i.a, i);
            mark_escape(i.b, i);
            mark_escape(i.c, i);
            for k in 0..i.xs.len {
                let o = i.xs.get(k);
                if ir.is_op(o, ir.OP_ALLOCA) {
                    o.aux = -1;
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    let mut slots = u.List.[*mut Slot].empty();
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if (i.op == ir.OP_ALLOCA) and (i.aux == 0) {
                let s = u.new.[Slot]();
                s.a = i;
                slots.push(s);
                i.aux = @int_cast(i64, slots.len);  // slot index + 1
            }
            i = i.next;
        }
        b = b.next;
    }
    if ir.dbg_on {
        vars_before(f);
    }
    if slots.len == 0 {
        return;
    }
    compute_preds(f);
    let order = dominators(f);
    // definition blocks
    for bi in 0..order.len {
        let bb = order.get(bi);
        let mut i = bb.first;
        while u.notnil(i) {
            if (i.op == ir.OP_STORE) and ir.is_op(i.b, ir.OP_ALLOCA) and (i.b.aux > 0) {
                let s = slots.get(@int_cast(usize, i.b.aux - 1));
                if (s.defs.len == 0) or (s.defs.last() != bb) {
                    s.defs.push(bb);
                }
            }
            i = i.next;
        }
    }
    // dominance frontiers
    let n = order.len;
    let df = u.newn.[u.List.[*mut ir.Block]](n + 1);
    for bi in 0..n {
        let bb = order.get(bi);
        if bb.preds.len < 2 {
            continue;
        }
        for k in 0..bb.preds.len {
            let mut r = bb.preds.get(k);
            if r.rpo < 0 {
                continue;
            }
            while r != bb.idom {
                let l = &mut df[@int_cast(usize, r.rpo)];
                if (l.len == 0) or (l.last() != bb) {
                    l.push(bb);
                }
                r = r.idom;
            }
        }
    }
    // phi placement (iterated dominance frontier)
    let B = ir.new_builder();
    let placed = u.newn.[i64](n + 1);
    let inwork = u.newn.[i64](n + 1);
    for si in 0..slots.len {
        let s = slots.get(si);
        let tag = @int_cast(i64, si) + 1;
        let mut work = u.List.[*mut ir.Block].empty();
        for k in 0..s.defs.len {
            let d = s.defs.get(k);
            inwork[@int_cast(usize, d.rpo)] = tag;
            work.push(d);
        }
        while work.len > 0 {
            let x = work.pop();
            let l = &df[@int_cast(usize, x.rpo)];
            for k in 0..l.len {
                let y = l.get(k);
                let yi = @int_cast(usize, y.rpo);
                if placed[yi] != tag {
                    placed[yi] = tag;
                    if u.notnil(y.first) {
                        ir.at_before(B, y.first);
                    } else {
                        ir.at_end(B, y);
                    }
                    let p = ir.phi(B, ir.aty_of(s.a));
                    p.aux2 = tag;  // which slot
                    let ds = ir.dbg_slot_of(s.a);
                    if ds >= 0 {
                        // (-g: the variable is the merge from the block's start)
                        let d = ir.dbg_slots.get(@int_cast(usize, ds));
                        let mut at = p;
                        while (at.op == ir.OP_PHI) and u.notnil(at.next) {
                            at = at.next;
                        }
                        ir.dbg_mark_first(at, d.owner, d.var, d.off, d.size, p, d.inst);
                    }
                    if inwork[yi] != tag {
                        inwork[yi] = tag;
                        work.push(y);
                    }
                }
            }
        }
        work.deinit();
    }
    // renaming, over the dominator tree
    struct_rename(f, order.get(0), slots.items());
    // delete the promoted allocas
    for si in 0..slots.len {
        let s = slots.get(si);
        ir.remove_inst(s.a);
        s.stack.deinit();
        s.defs.deinit();
    }
    for bi in 0..n {
        u.free(@ptr_cast(*mut void, df[bi].data));
    }
    slots.deinit();
    ir.apply_forwarding(f);
}

// -----------------------------------------------------------------------------
// Debug information (-g, optimized code; dbginfo.ax): the objects of a
// function's variables, whose stores and merges promotion marks (ir.dbg_mark:
// the variable's values from there on); and, at a function's first
// promotion, the stores of those left in memory (where all of them remain,
// the memory holds the variable).
// -----------------------------------------------------------------------------
// The root object of address p (through offsets), or nil.
fn object_of(p: *mut ir.Value) *mut ir.Value {
    let mut x = p;
    while u.notnil(x) and (x.kind == ir.V_INST) and (x.op == ir.OP_PTRADD) {
        x = x.a;
    }
    if u.notnil(x) and (x.kind == ir.V_INST) and (x.op == ir.OP_ALLOCA) {
        return x;
    }
    return ir.vnil();
}

fn writes_object(i: *ir.Value, a: *mut ir.Value) bool {
    if i.op == ir.OP_STORE {
        return object_of(i.b) == a;
    }
    if (i.op == ir.OP_MEMSET) or (i.op == ir.OP_MEMCPY) or (i.op == ir.OP_MEMMOVE) {
        return object_of(i.a) == a;
    }
    return false;
}

// Before f's allocas are promoted (the promoted ones: aux > 0): the objects
// of f's variables noted (ir.dbg_slot_note); of those not looked at yet, the
// ones promoted now are followed by their marks (track 0), the stores of the
// others are followed.
fn vars_before(f: *mut ir.Func) void {
    let vl = dbi.vars_mut(f.name);
    if u.isnil(vl) {
        return;
    }
    for k in 0..vl.len {
        let v = vl.at(k);
        let a = v.alloca;
        if u.notnil(v.global) {
            continue;
        }
        if u.isnil(a) or (a.op != ir.OP_ALLOCA) or (a.id != v.alloca_id) or (a.grave != 0) or u.isnil(a.blk) or
           (@int_from_ptr(a.blk.fnp) != @int_from_ptr(f)) {
            continue;
        }
        if ir.dbg_slot_of(a) < 0 {
            ir.dbg_slot_note(a, f, @int_cast(i32, k), 0, 0, 0);
        }
        if v.seen {
            continue;
        }
        v.seen = true;
        if a.aux > 0 {
            v.track = 0;  // (promoted: its marks)
            continue;
        }
        let first = @int_cast(i32, ir.dbg_refs.len);
        let mut nst: i32 = 0;
        let mut b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                if writes_object(i, a) {
                    nst += 1;
                    _ = ir.dbg_track(i);
                }
                i = i.next;
            }
            b = b.next;
        }
        // (left in memory)
        v.stores = first;
        v.nstores = nst;
    }
}

fn slot_of_ptr(slots: []mut *mut Slot, p: *mut ir.Value) *mut Slot {
    if ir.is_op(p, ir.OP_ALLOCA) and (p.aux > 0) {
        return slots[@int_cast(usize, p.aux - 1)];
    }
    return u.nil.[Slot]();
}

fn top(s: *mut Slot) *mut ir.Value {
    if s.stack.len == 0 {
        return ir.undef(ir.aty_of(s.a));
    }
    return s.stack.last();
}

fn struct_rename(f: *mut ir.Func, entry: *mut ir.Block, slots: []mut *mut Slot) void {
    // explicit DFS stack of (block, child index); on exit, pop what the block pushed
    let mut blocks = u.List.[*mut ir.Block].empty();
    let mut kids = u.List.[usize].empty();
    let mut pushed = u.List.[*mut Slot].empty();
    let mut marks = u.List.[usize].empty();
    blocks.push(entry);
    kids.push(0);
    marks.push(0);
    rename_block(entry, slots, &mut pushed);
    while blocks.len > 0 {
        let b = blocks.last();
        let k = kids.last();
        if k < b.dom_kids.len {
            kids.set(kids.len - 1, k + 1);
            let c = b.dom_kids.get(k);
            marks.push(pushed.len);
            rename_block(c, slots, &mut pushed);
            blocks.push(c);
            kids.push(0);
        } else {
            let m = marks.pop();
            while pushed.len > m {
                let s = pushed.pop();
                s.stack.len -= 1;
            }
            _ = blocks.pop();
            _ = kids.pop();
        }
    }
    blocks.deinit();
    kids.deinit();
    pushed.deinit();
    marks.deinit();
}

fn rename_block(b: *mut ir.Block, slots: []mut *mut Slot, pushed: *mut u.List.[*mut Slot]) void {
    let mut i = b.first;
    while u.notnil(i) {
        let next = i.next;
        if (i.op == ir.OP_PHI) and (i.aux2 > 0) {
            let s = slots[@int_cast(usize, i.aux2 - 1)];
            s.stack.push(i);
            pushed.push(s);
        } else if i.op == ir.OP_LOAD {
            let s = slot_of_ptr(slots, i.a);
            if u.notnil(s) {
                ir.forward(i, top(s));
                ir.remove_inst(i);
            }
        } else if i.op == ir.OP_STORE {
            let s = slot_of_ptr(slots, i.b);
            if u.notnil(s) {
                s.stack.push(ir.resolve(i.a));
                pushed.push(s);
                let ds = ir.dbg_slot_of(s.a);
                if ds >= 0 {
                    // (-g: from here on the variable is the stored value)
                    let d = ir.dbg_slots.get(@int_cast(usize, ds));
                    ir.dbg_mark(i, d.owner, d.var, d.off, d.size, ir.resolve(i.a), d.inst);
                }
                ir.remove_inst(i);
            }
        }
        i = next;
    }
    let t = ir.terminator(b);
    for k in 0..ir.succ_count(t) {
        let sb = ir.succ(t, k);
        let mut p = sb.first;
        while u.notnil(p) and (p.op == ir.OP_PHI) {
            if p.aux2 > 0 {
                let s = slots[@int_cast(usize, p.aux2 - 1)];
                // one input per predecessor block
                let mut dup = false;
                for j in 0..ir.bs_of(p).len {
                    if ir.bs_of(p).get(j) == b {
                        dup = true;
                    }
                }
                if not dup {
                    ir.add_incoming(p, ir.resolve(top(s)), b);
                }
            }
            p = p.next;
        }
    }
}

// -----------------------------------------------------------------------------
// Constant folding and simplification
// -----------------------------------------------------------------------------
fn is_ci(v: *ir.Value) bool {
    return (v.kind == ir.V_CINT) or ((v.kind == ir.V_ZERO) and (v.ty.kind == ir.T_INT));
}

// Lane k of an integer vector known at compile time (a constant vector, or
// a splat of a constant), or nil.
fn const_lane(v: *mut ir.Value, k: usize) *mut ir.Value {
    if (v.kind == ir.V_ZERO) and (v.ty.kind == ir.T_VEC) {
        return ir.czero(v.ty.elem);
    }
    if v.kind == ir.V_CAGG {
        let x = v.xs.get(k);
        if is_ci(x) {
            return x;
        }
        return vnil();
    }
    if ir.is_op(v, ir.OP_SPLAT) and is_ci(v.a) {
        return v.a;
    }
    return vnil();
}

// An integer vector operation or comparison of constant lanes, folded lane by
// lane (the masks and point numbers of an unrolled loop over constant
// vectors), or nil.
fn fold_vec(i: *mut ir.Value) *mut ir.Value {
    let op = i.op;
    let at = i.a.ty;
    if (at.kind != ir.T_VEC) or (at.elem.kind != ir.T_INT) or (at.elem.bits > 64) or (i.ty.kind != ir.T_VEC) {
        return vnil();
    }
    let n = @as(usize, @bit_cast(u32, at.lanes));
    if (n == 0) or u.isnil(const_lane(i.a, 0)) or u.isnil(const_lane(i.b, 0)) {
        return vnil();
    }
    let xs = u.newn.[*mut ir.Value](n);
    for k in 0..n {
        let x = const_lane(i.a, k);
        let y = const_lane(i.b, k);
        if u.isnil(x) or u.isnil(y) {
            return vnil();
        }
        if op == ir.OP_ICMP {
            let mut r: u64 = 0;
            if ir.cint_val(ir.fold_icmp(ir.pred_of(i), x, y)) != 0 {
                r = ir.mask_bits(i.ty.elem.bits);
            }
            xs[k] = ir.cint(i.ty.elem, r);
        } else {
            let r = ir.fold_int_bin(op, at.elem, x, y);
            if u.isnil(r) {
                return vnil();
            }
            xs[k] = r;
        }
    }
    return ir.cagg(i.ty, xs[0..n]);
}

fn cfp_val(v: *ir.Value, out: *mut f64) bool {
    if v.kind == ir.V_CFP {
        out.* = ir.fv_of(v);
        return true;
    }
    if (v.kind == ir.V_ZERO) and (v.ty.kind == ir.T_FLOAT) {
        out.* = 0.0;
        return true;
    }
    return false;
}

// + - * / of two float constants, computed in the type's own precision (an
// f32 operation in f32, rounded once as at run time; a division by a
// constant of a count that is itself constant on a path). Not for NaNs,
// whose payloads the target decides.
fn fold_float_bin(i: *mut ir.Value) *mut ir.Value {
    let mut a: f64 = 0.0;
    let mut b: f64 = 0.0;
    if not cfp_val(i.a, &mut a) or not cfp_val(i.b, &mut b) or (a != a) or (b != b) {
        return vnil();
    }
    let op = i.op;
    let mut r: f64 = 0.0;
    if i.ty.bits == 32 {
        let x = @float_cast(f32, a);
        let y = @float_cast(f32, b);
        let mut z: f32 = 0.0;
        if op == ir.OP_FADD {
            z = x + y;
        } else if op == ir.OP_FSUB {
            z = x - y;
        } else if op == ir.OP_FMUL {
            z = x * y;
        } else {
            z = x / y;
        }
        r = @float_cast(f64, z);
    } else if i.ty.bits == 64 {
        if op == ir.OP_FADD {
            r = a + b;
        } else if op == ir.OP_FSUB {
            r = a - b;
        } else if op == ir.OP_FMUL {
            r = a * b;
        } else {
            r = a / b;
        }
    } else {
        return vnil();
    }
    if r != r {
        return vnil();
    }
    return ir.cfp(i.ty, r);
}

// -----------------------------------------------------------------------------
// C's object sizes (ir.IN_OBJSIZE(p, kind, dynamic)): the object p points
// into, at a constant offset from its start (through ptradds of constants):
// a stack slot (its type's bytes), a global defined in the program that no
// other definition can replace (internal, or external with its
// initializer), a variable length array (IN_STACK_ALLOC's bytes), or the
// result of a direct call of a function with Func.size_args (C's
// alloc_size: an argument, or the product of two, as size_t). The answer is
// the object's bytes less the offset (0 before its start or past its end).
// It is exact for the whole object, so it serves kinds 0 and 2, and kind 1
// (an upper bound for the closest subobject); kind 3, a lower bound for the
// subobject, which the IR does not show, is left unknown. A size known only
// at run time (a variable length array, alloc_size of variables) is
// computed for dynamic only (__builtin_dynamic_object_size), as soon as the
// object is found (inlining may take the call of an allocating function
// away); for the static form it is unknown, and is given only at the end
// (last: passes.finish_funcs), where the size may have become a constant,
// as is the unknown answer.
// -----------------------------------------------------------------------------
/// The value of object size intrinsic i at the builder bd's place, or nil
/// (last: the end, where nil is never the answer).
pub fn objsize(bd: *mut ir.Builder, i: *mut ir.Value, last: bool) *mut ir.Value {
    let t = i.ty;
    let kind = ir.cint_val(i.xs.get(1));
    let dynamic = ir.cint_val(i.xs.get(2)) != 0;
    make_insts = dynamic;
    let mut unknown = ir.cint(t, 0);
    if kind < 2 {
        unknown = ir.cones(t);
    }
    let mut p = ir.resolve(i.xs.get(0));
    let mut off: i64 = 0;
    let mut n: i32 = 0;
    while ir.is_op(p, ir.OP_PTRADD) and ir.is_cint(p.b) and (n < 64) {
        off = off +% ir.sval(p.b);
        p = ir.resolve(p.a);
        n += 1;
    }
    let mut size = vnil();  // the object's bytes, as size_t
    if kind != 3 {
        if ir.is_op(p, ir.OP_ALLOCA) {
            size = ir.cint(t, ir.aty_of(p).size);
        } else if (p.kind == ir.V_GLOBAL) and u.notnil(ir.gv_of(p).init) and
                  ((ir.gv_of(p).linkage == ir.LINK_INTERNAL) or (ir.gv_of(p).linkage == ir.LINK_EXTERNAL)) {
            size = ir.cint(t, ir.gv_of(p).ty.size);
        } else if ir.is_op(p, ir.OP_INTR) and (ir.intr_id(p) == ir.IN_STACK_ALLOC) {
            size = p.xs.get(0);
        } else if ir.is_op(p, ir.OP_CALL) {
            let f = ir.direct_callee(p);
            if u.notnil(f) and (f.size_args[0] > 0) and (@as(usize, @bit_cast(u8, f.size_args[0])) <= p.xs.len) and
               (@as(usize, @bit_cast(u8, f.size_args[1])) <= p.xs.len) {
                size = as_size(bd, p.xs.get(@as(usize, @bit_cast(u8, f.size_args[0])) - 1), t);
                if u.notnil(size) and (f.size_args[1] > 0) {
                    let y = as_size(bd, p.xs.get(@as(usize, @bit_cast(u8, f.size_args[1])) - 1), t);
                    if u.isnil(y) {
                        size = vnil();
                    } else if ir.is_cint(size) and ir.is_cint(y) {
                        size = ir.cint(t, (ir.cint_val(size) *% ir.cint_val(y)) & ir.mask_bits(t.bits));
                    } else if dynamic {
                        size = ir.mul(bd, size, y);
                    } else {
                        size = vnil();
                    }
                }
            }
        }
    }
    if u.isnil(size) or not (ir.is_cint(size) or dynamic) {
        if last {
            return unknown;
        }
        return vnil();
    }
    if ir.is_cint(size) {
        let s = ir.cint_val(size);
        if (off < 0) or (@bit_cast(u64, off) > s) {
            return ir.cint(t, 0);
        }
        return ir.cint(t, s - @bit_cast(u64, off));
    }
    if off < 0 {
        return ir.cint(t, 0);
    }
    let k = ir.cint(t, @bit_cast(u64, off));
    return ir.select(bd, ir.icmp(bd, ir.IntUGE, size, k), ir.sub(bd, size, k), ir.cint(t, 0));
}

let mut make_insts: bool = false;

let mut rs_tag: i64 = 0x4000_0000_0000;

/// Marks C's restrict scopes (ir.IN_RSCOPE) of f that are in a cycle of its
/// blocks (ir.F_RCYCLE), and clears the mark of the others: before a pass
/// that relies on it (ir.restrict_tagged). False if f has none.
pub fn rscope_cycles(f: *mut ir.Func) bool {
    if not f.rscopes {
        return false;
    }
    let mut any = false;
    let mut work = u.List.[*mut ir.Block].empty();
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if ir.is_rscope(i) {
                any = true;
                i.flags = i.flags & ~ir.F_RCYCLE;
                if reaches_itself(b, &mut work) {
                    i.flags = i.flags | ir.F_RCYCLE;
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    work.deinit();
    return any;
}

// Does a path of one or more edges lead from b back to b?
fn reaches_itself(b: *mut ir.Block, work: *mut u.List.[*mut ir.Block]) bool {
    rs_tag += 1;
    work.clear();
    work.push(b);
    while work.len > 0 {
        let x = work.pop();
        let t = ir.terminator(x);
        for k in 0..ir.succ_count(t) {
            let y = ir.succ(t, k);
            if y == b {
                return true;
            }
            if y.mark != rs_tag {
                y.mark = rs_tag;
                work.push(y);
            }
        }
    }
    return false;
}

// The scope of IN_RESTRICT r: a block's object's (its second operand), or a
// member's (its fourth).
fn restrict_scope_of(r: *ir.Value) *mut ir.Value {
    if r.xs.len == 4 {
        return ir.resolve(r.xs.get(3));
    }
    return ir.resolve(r.xs.get(1));
}

// The nearest scope around restrict scope s that is not gone, or nil.
fn kept_parent(s: *mut ir.Value, gone: *mut u.SymMap.[bool]) *mut ir.Value {
    let mut p = ir.rscope_parent(s);
    let mut n: i32 = 0;
    while u.notnil(p) and gone.get(u.addr_key(@int_from_ptr(p))) and (n < 64) {
        p = ir.rscope_parent(p);
        n += 1;
    }
    if n >= 64 {
        return u.nil.[ir.Value]();
    }
    return p;
}

/// C's restrict scopes (ir.IN_RSCOPE) that begin inside a loop: their
/// restricted pointers' reads (ir.IN_RESTRICT) become the pointers again,
/// and what their operations' tags and their inner scopes said of them is
/// said of the scope around them, before the passes that move code out of
/// loops and transform them. What such a scope says holds within one
/// iteration (an execution of its block), which value numbering has used;
/// the loop passes reason about all iterations, and there the reads, which
/// depend on the scope, would keep the addresses from being invariant or
/// sequences. Then the scopes in cycles are marked (rscope_cycles).
pub fn loop_restricts(f: *mut ir.Func) void {
    if not f.rscopes {
        return;
    }
    let mut scopes = u.List.[*mut ir.Value].empty();
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if ir.is_rscope(i) {
                scopes.push(i);
            }
            i = i.next;
        }
        b = b.next;
    }
    if scopes.len == 0 {
        return;
    }
    compute_preds(f);
    let mut order = dominators(f);
    let mut hs = loop_headers(&order);
    let mut members = u.List.[*mut ir.Block].empty();
    let mut inside = u.SymMap.[bool].{ keys: u.nil.[usize](), vals: u.nil.[bool](), cap: 0, len: 0 };
    for k in 0..hs.len {
        rs_tag += 1;
        members_of(hs.get(k), rs_tag, &mut members);
        for m in members.items() {
            inside.put(u.addr_key(@int_from_ptr(m)), true);
        }
    }
    let mut gone = u.SymMap.[bool].{ keys: u.nil.[usize](), vals: u.nil.[bool](), cap: 0, len: 0 };
    for t in scopes.items() {
        if inside.get(u.addr_key(@int_from_ptr(t.blk))) {
            gone.put(u.addr_key(@int_from_ptr(t)), true);
        }
    }
    if gone.len > 0 {
        // (each gone scope's replacement: the nearest kept scope around it)
        let mut repl = u.SymMap.[*mut ir.Value].{ keys: u.nil.[usize](), vals: u.nil.[*mut ir.Value](), cap: 0,
                                                  len: 0 };
        for t in scopes.items() {
            if gone.get(u.addr_key(@int_from_ptr(t))) {
                repl.put(u.addr_key(@int_from_ptr(t)), kept_parent(t, &mut gone));
            }
        }
        b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                let next = i.next;
                if ir.is_op(i, ir.OP_INTR) and (ir.intr_id(i) == ir.IN_RESTRICT) and (i.xs.len >= 3) and
                   gone.get(u.addr_key(@int_from_ptr(restrict_scope_of(i)))) {
                    ir.forward(i, ir.resolve(i.xs.get(0)));
                    ir.remove_inst(i);
                } else if ir.has_tag_slot(i) and u.notnil(ir.tag_slot(i)) and
                          gone.get(u.addr_key(@int_from_ptr(ir.resolve(ir.tag_slot(i))))) {
                    ir.set_tag(i, repl.get(u.addr_key(@int_from_ptr(ir.resolve(ir.tag_slot(i))))));
                } else if ir.is_rscope(i) and not gone.get(u.addr_key(@int_from_ptr(i))) and (i.xs.len == 1) and
                          gone.get(u.addr_key(@int_from_ptr(ir.resolve(i.xs.get(0))))) {
                    let p = repl.get(u.addr_key(@int_from_ptr(ir.resolve(i.xs.get(0)))));
                    i.xs.clear();
                    if u.notnil(p) {
                        i.xs.push(p);
                    }
                }
                i = next;
            }
            b = b.next;
        }
        for t in scopes.items() {
            if gone.get(u.addr_key(@int_from_ptr(t))) {
                if ir.scope_num(t) != 0 {
                    // (its operations are said to be in the scope around:
                    // its objects may be alive there, ir.IN_RSCOPE)
                    ir.forget_lives(f, ir.scope_num(t));
                }
                ir.forward(t, ir.cint(t.ty, 0));
                ir.remove_inst(t);
            }
        }
        ir.apply_forwarding(f);
    }
    members.deinit();
    hs.deinit();
    order.deinit();
    _ = rscope_cycles(f);
}

/// The object size intrinsics left in f: their values (objsize's last).
pub fn finish_objsizes(f: *mut ir.Func) void {
    // (and C's restrict scopes, ir.IN_RSCOPE and IN_RESTRICT, removed)
    let mut bd = u.nil.[ir.Builder]();
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            if ir.is_op(i, ir.OP_INTR) and (ir.intr_id(i) == ir.IN_OBJSIZE) {
                if u.isnil(bd) {
                    bd = ir.new_builder();
                }
                ir.at_before(bd, i);
                let r = objsize(bd, i, true);
                ir.forward(i, r);
                ir.remove_inst(i);
            } else if ir.is_op(i, ir.OP_INTR) and (ir.intr_id(i) == ir.IN_RESTRICT) {
                // (C's restrict: what the passes knew from it is used)
                ir.forward(i, ir.resolve(i.xs.get(0)));
                ir.remove_inst(i);
            } else if ir.is_op(i, ir.OP_INTR) and (ir.intr_id(i) == ir.IN_RSCOPE) {
                ir.forward(i, ir.czero(i.ty));
                ir.remove_inst(i);
            } else if ir.has_tag_slot(i) {
                ir.set_tag(i, u.nil.[ir.Value]());  // (its tag, if any)
            } else if i.op == ir.OP_ALLOCA {
                i.cv = 0;  // (its life, ir.life_of: no use without the scopes)
            }
            i = next;
        }
        b = b.next;
    }
    ir.apply_forwarding(f);
}

// Integer x as a value of size_t t (zero-extended or truncated), or nil
// (before the end, a variable: no instruction is made then).
fn as_size(bd: *mut ir.Builder, x: *mut ir.Value, t: *mut ir.Ty) *mut ir.Value {
    if x.ty.kind != ir.T_INT {
        return vnil();
    }
    if ir.is_cint(x) {
        return ir.cint(t, ir.cint_val(x) & ir.mask_bits(t.bits));
    }
    if not make_insts {
        return vnil();  // (no instruction made for the static form)
    }
    if x.ty.bits < t.bits {
        return ir.zext(bd, x, t);
    }
    if x.ty.bits > t.bits {
        return ir.trunc(bd, x, t);
    }
    return x;
}

// A constant for i, or nil.
fn fold(i: *mut ir.Value) *mut ir.Value {
    let op = i.op;
    if ir.fp_pinned(i) {
        return vnil();  // (strict floating point: computed at run time, in its mode)
    }
    let B = FB;
    ir.at_before(B, i);
    if ir.is_op(i, ir.OP_INTR) and (ir.intr_id(i) == ir.IN_OBJSIZE) {
        return objsize(B, i, false);
    }
    if ir.is_int_binop(op) or (op == ir.OP_ICMP) {
        if (i.ty.kind == ir.T_VEC) and u.notnil(i.a) and u.notnil(i.b) {
            return fold_vec(i);
        }
    }
    if ir.is_int_binop(op) and (i.ty.kind == ir.T_INT) and (i.ty.bits <= 64) {
        if is_ci(i.a) and is_ci(i.b) {
            return ir.fold_int_bin(op, i.ty, i.a, i.b);
        }
        return vnil();
    }
    if (op >= ir.OP_FADD) and (op <= ir.OP_FDIV) and (i.ty.kind == ir.T_FLOAT) {
        return fold_float_bin(i);
    }
    if (op == ir.OP_ICMP) and (i.ty.kind == ir.T_INT) and is_ci(i.a) and is_ci(i.b) and (i.a.ty.kind == ir.T_INT) {
        return ir.icmp(B, ir.pred_of(i), i.a, i.b);
    }
    if op == ir.OP_SELECT {
        if i.a.kind == ir.V_CINT {
            if i.a.cv != 0 {
                return i.b;
            }
            return i.c;
        }
        if i.b == i.c {
            return i.b;
        }
        return vnil();
    }
    if ((op == ir.OP_ZEXT) or (op == ir.OP_SEXT) or (op == ir.OP_TRUNC)) and is_ci(i.a) and (i.ty.kind == ir.T_INT) {
        return ir.cast(B, op, i.a, i.ty);
    }
    if ((op == ir.OP_SITOFP) or (op == ir.OP_UITOFP)) and is_ci(i.a) and (i.a.ty.bits <= 64) and
       (i.ty.kind == ir.T_FLOAT) {
        return fold_int_to_float(op == ir.OP_SITOFP, i.a, i.ty);
    }
    if op == ir.OP_INSERTELEM {
        return fold_insert(i);
    }
    if (op == ir.OP_EXTRACTELEM) and (i.a.ty.kind == ir.T_VEC) and (i.a.ty.elem.kind == ir.T_INT) and
       (i.cv < @as(u64, @bit_cast(u32, i.a.ty.lanes))) {
        // a lane of a constant vector (folded lane by lane above)
        let x = const_lane(i.a, @truncate(usize, i.cv));
        if u.notnil(x) and (x.ty == i.ty) {
            return x;
        }
        return vnil();
    }
    if op == ir.OP_PHI {
        // all inputs the same (ignoring the phi itself)
        let mut same = vnil();
        let mut undefs = false;
        for k in 0..i.xs.len {
            let x = i.xs.get(k);
            if x == i {
                continue;
            }
            if x.kind == ir.V_UNDEF {
                undefs = true;
                continue;
            }
            if u.isnil(same) {
                same = x;
            } else if same != x {
                return vnil();
            }
        }
        if u.isnil(same) {
            return ir.undef(i.ty);
        }
        // phi(x, undef) is x only where x is defined on every path: else the
        // undef paths would read a value never computed on them. An x of
        // the phi's own block comes round a loop: after the phi, or a phi
        // whose value from the previous iteration this phi holds.
        if undefs and (same.kind == ir.V_INST) and ((same.blk == i.blk) or not fold_dominates(same.blk, i.blk)) {
            return vnil();
        }
        return same;
    }
    return vnil();
}

// An integer constant converted to a float type, rounded once to that type
// as the conversion at run time is (an unrolled loop's counter).
fn fold_int_to_float(signed: bool, x: *mut ir.Value, t: *mut ir.Ty) *mut ir.Value {
    if t.bits == 32 {
        if signed {
            return ir.cfp(t, @float_cast(f64, @float_from_int(f32, ir.sval(x))));
        }
        return ir.cfp(t, @float_cast(f64, @float_from_int(f32, ir.cint_val(x))));
    }
    if signed {
        return ir.cfp(t, @float_from_int(f64, ir.sval(x)));
    }
    return ir.cfp(t, @float_from_int(f64, ir.cint_val(x)));
}

let mut FB: *mut ir.Builder = @ptr_from_int(*mut ir.Builder, 0);

// Dominators for fold, computed when first needed in each fold_combine:
// that only removes edges, which keeps every dominance it had.
let mut fold_func: *mut ir.Func = @ptr_from_int(*mut ir.Func, 0);
let mut fold_doms: bool = false;

fn fold_dominates(a: *mut ir.Block, b: *mut ir.Block) bool {
    if not fold_doms {
        compute_preds(fold_func);
        let order = dominators(fold_func);
        order.deinit();
        fold_doms = true;
    }
    if (a.rpo < 0) or (b.rpo < 0) or u.isnil(a.idom) or u.isnil(b.idom) {
        return false;
    }
    return dominates(a, b);
}

// A constant lane into a constant vector (@vec of constants is a chain of
// these): a constant vector, its undefined lanes 0.
fn fold_insert(i: *mut ir.Value) *mut ir.Value {
    let a = i.a;
    let x = i.b;
    let t = i.ty;
    if (t.kind != ir.T_VEC) or ((x.kind != ir.V_CINT) and (x.kind != ir.V_CFP) and (x.kind != ir.V_ZERO)) {
        return vnil();
    }
    if (a.kind != ir.V_CAGG) and (a.kind != ir.V_ZERO) and (a.kind != ir.V_UNDEF) {
        return vnil();
    }
    let n = @as(usize, @bit_cast(u32, t.lanes));
    let lane = @truncate(usize, i.cv);
    let xs = u.newn.[*mut ir.Value](n);
    for k in 0..n {
        if k == lane {
            xs[k] = x;
        } else if a.kind == ir.V_CAGG {
            xs[k] = a.xs.get(k);
        } else {
            xs[k] = ir.czero(t.elem);
        }
    }
    return ir.cagg(t, xs);
}

pub fn fold_combine(f: *mut ir.Func, combine: bool) bool {
    if u.isnil(FB) {
        FB = ir.new_builder();
    }
    let mut any = false;
    let mut changed = true;
    let mut rounds: i32 = 0;
    if combine and cb.narrow_bool_phis(f) {
        any = true;
    }
    if combine and cb.sink_phi_ops(f) {
        any = true;
    }
    // in reverse postorder, definitions come before their uses (but for
    // phis on back edges), so a round or two reach the fixed point
    compute_preds(f);
    let order = rpo(f);
    fold_func = f;
    fold_doms = false;
    while changed and (rounds < 16) {
        changed = false;
        rounds += 1;
        cb.uses_stale = true;
        for bi in 0..order.len {
            let b = order.get(bi);
            let mut i = b.first;
            while u.notnil(i) {
                let next = i.next;
                if u.notnil(i.a) {
                    i.a = ir.resolve(i.a);
                }
                if u.notnil(i.b) {
                    i.b = ir.resolve(i.b);
                }
                if u.notnil(i.c) {
                    i.c = ir.resolve(i.c);
                }
                for k in 0..i.xs.len {
                    i.xs.set(k, ir.resolve(i.xs.get(k)));
                }
                if not ir.has_effects(i) {
                    let mut r = vnil();
                    if combine {
                        r = cb.simplify(FB, i);
                    }
                    if u.isnil(r) {
                        r = fold(i);
                    }
                    if u.notnil(r) and (r != i) {
                        ir.forward(i, r);
                        ir.remove_inst(i);
                        changed = true;
                        any = true;
                    }
                } else if combine and (i.op == ir.OP_CONDBR) {
                    if cb.simplify_branch(i) {
                        changed = true;
                        any = true;
                    }
                } else if combine and (i.op == ir.OP_STORE) and (i.a.kind == ir.V_UNDEF) and (i.flags == 0) {
                    ir.remove_inst(i);  // the memory may keep what it holds
                    changed = true;
                    any = true;
                }
                i = next;
            }
        }
    }
    order.deinit();
    ir.apply_forwarding(f);
    return any;
}

fn mark_live(o: *mut ir.Value, work: *mut u.List.[*mut ir.Value]) void {
    if u.notnil(o) and (o.kind == ir.V_INST) and (o.aux == 0) {
        o.aux = 1;
        work.push(o);
    }
}

// Removes instructions whose results are unused and that have no effects
// (including cycles of dead phis).
pub fn dce(f: *mut ir.Func) void {
    let mut work = u.List.[*mut ir.Value].empty();
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.aux = 0;
            // (a call that promises to return and to write nothing,
            // ir.call_fx, is removed when its result is unused)
            if (ir.has_effects(i) and (ir.call_fx(i) == ir.FX_ANY)) or (i.op == ir.OP_ALLOCA) {
                i.aux = 1;
                work.push(i);
            }
            i = i.next;
        }
        b = b.next;
    }
    while work.len > 0 {
        let i = work.pop();
        mark_live(i.a, &mut work);
        mark_live(i.b, &mut work);
        mark_live(i.c, &mut work);
        for k in 0..i.xs.len {
            mark_live(i.xs.get(k), &mut work);
        }
    }
    work.deinit();
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            if i.aux == 0 {
                ir.remove_inst(i);
            }
            i = next;
        }
        b = b.next;
    }
}

fn has_phis(b: *ir.Block) bool {
    return u.notnil(b.first) and (b.first.op == ir.OP_PHI);
}

// Constant branches, unreachable blocks, jump threading through empty
// blocks and merging of straight-line blocks. True if anything changed.
pub fn simplify_cfg(f: *mut ir.Func) bool {
    let mut any = false;
    // constant conditions
    let mut b = f.first;
    while u.notnil(b) {
        let t = ir.terminator(b);
        if u.notnil(t) and (t.op == ir.OP_CONDBR) {
            let c = t.a;
            if (c.kind == ir.V_CINT) or (t.t1 == t.t2) {
                let mut keep = t.t1;
                let mut drop = t.t2;
                if (c.kind == ir.V_CINT) and (c.cv == 0) {
                    keep = t.t2;
                    drop = t.t1;
                }
                if drop != keep {
                    ir.remove_phi_input(drop, b);
                }
                t.op = ir.OP_BR;
                t.a = vnil();
                t.t1 = keep;
                t.t2 = bnil();
                any = true;
            }
        } else if u.notnil(t) and (t.op == ir.OP_SWITCH) and (t.a.kind == ir.V_CINT) {
            let mut target = t.t1;
            for k in 0..t.xs.len {
                if t.xs.get(k).cv == t.a.cv {
                    target = ir.bs_of(t).get(k);
                }
            }
            for k in 0..ir.succ_count(t) {
                let s = ir.succ(t, k);
                if s != target {
                    ir.remove_phi_input(s, b);
                }
            }
            t.op = ir.OP_BR;
            t.a = vnil();
            t.t1 = target;
            t.xs.clear();
            ir.bs_mut(t).clear();
            any = true;
        } else if u.notnil(t) and swl.simplify(b, t) {
            any = true;  // (cases going where the default does, one case or none)
        }
        b = b.next;
    }
    ir.remove_unreachable(f);
    compute_preds(f);
    // thread jumps through blocks that contain only `br X` (X without phis)
    let mut threaded = false;
    b = f.first.next;
    while u.notnil(b) {
        let next = b.next;
        let t = ir.terminator(b);
        if (b.first == t) and (t.op == ir.OP_BR) and (t.t1 != b) and not has_phis(t.t1) {
            let x = t.t1;
            for k in 0..b.preds.len {
                let p = b.preds.get(k);
                let pt = ir.terminator(p);
                for j in 0..ir.succ_count(pt) {
                    if ir.succ(pt, j) == b {
                        ir.set_succ(pt, j, x);
                    }
                }
            }
            if b.preds.len > 0 {
                any = true;
                threaded = true;
            }
        }
        b = next;
    }
    if threaded {
        ir.remove_unreachable(f);
        compute_preds(f);
    }
    // merge b -> s when b ends in `br s` and s has no other predecessor
    b = f.first;
    while u.notnil(b) {
        let t = ir.terminator(b);
        if u.notnil(t) and (t.op == ir.OP_BR) {
            let s = t.t1;
            if (s != b) and (s.preds.len == 1) and (s != f.first) {
                // s's phis have one input
                let mut p = s.first;
                while u.notnil(p) and (p.op == ir.OP_PHI) {
                    let nx = p.next;
                    ir.forward(p, p.xs.get(0));
                    ir.remove_inst(p);
                    p = nx;
                }
                ir.remove_inst(t);
                let mut i = s.first;
                while u.notnil(i) {
                    let nx = i.next;
                    let mk = ir.dbg_take(i);  // (the marks go along)
                    ir.remove_inst(i);
                    ir.append_inst(b, i);
                    ir.dbg_put(i, mk);
                    i = nx;
                }
                let nt = ir.terminator(b);
                for k in 0..ir.succ_count(nt) {
                    let ss = ir.succ(nt, k);
                    ir.replace_phi_block(ss, s, b);
                    // preds of the successor: s -> b
                    for j in 0..ss.preds.len {
                        if ss.preds.get(j) == s {
                            ss.preds.set(j, b);
                        }
                    }
                }
                ir.dbg_move_end(s, b);
                ir.remove_block(s);
                any = true;
                continue;  // b may merge again
            }
        }
        b = b.next;
    }
    ir.apply_forwarding(f);
    return any;
}

// The layout order for code generation: reverse postorder with the blocks
// that end in `unreachable` (trap paths) moved to the end, out of the way of
// the hot code, and loop headers that test for the exit after their loop's
// body. Sets b.rpo to the new positions. Needs dominators.
pub fn layout(order: *mut u.List.[*mut ir.Block]) void {
    let mut cold = u.List.[*mut ir.Block].empty();
    let mut n: usize = 0;
    for i in 0..order.len {
        let b = order.get(i);
        let t = ir.terminator(b);
        if (i > 0) and u.notnil(t) and (t.op == ir.OP_UNREACHABLE) {
            cold.push(b);
        } else {
            order.set(n, b);
            n += 1;
        }
    }
    for k in 0..cold.len {
        order.set(n + k, cold.get(k));
    }
    for i in 0..order.len {
        order.get(i).rpo = @int_cast(i32, i);
    }
    cold.deinit();
    rotate_loops(order);
    place_unlikely(order);
}

// Static branch prediction: the successor of b's conditional branch that is
// the less likely one, or nil when neither is. An equality is predicted
// false (most values are not the one compared with, and a pointer is rarely
// null), except for a boolean or a test of one bit, and so is a signed
// integer below zero. (Loops and trap paths are
// laid out by their own rules; the register allocator's block frequencies,
// mach.ax, weigh the same edges with mc.UNLIKELY_WEIGHT.)
pub fn unlikely_succ(b: *ir.Block) *mut ir.Block {
    let t = ir.terminator(b);
    if u.isnil(t) or (t.op != ir.OP_CONDBR) or (t.t1 == t.t2) {
        return bnil();
    }
    // (a successor a front end marked cold: ir.Block.cold)
    if t.t1.cold != t.t2.cold {
        if t.t1.cold {
            return t.t1;
        }
        return t.t2;
    }
    let c = t.a;
    if (c.kind != ir.V_INST) or ((c.op != ir.OP_ICMP) and (c.op != ir.OP_FCMP)) or (c.a.ty.kind == ir.T_VEC) {
        return bnil();
    }
    let p = ir.pred_of(c);
    if c.op == ir.OP_ICMP {
        let x = c.a;
        if is_bool(x, 0) or (ir.is_op(x, ir.OP_AND) and (one_bit(x.a) or one_bit(x.b))) {
            return bnil();  // (a boolean, or a test of one bit: either way)
        }
        if p == ir.IntEQ {
            return t.t1;
        }
        if p == ir.IntNE {
            return t.t2;
        }
        if (c.b.kind == ir.V_CINT) and (c.a.ty.kind == ir.T_INT) {
            let k = ir.sval(c.b);
            if ((p == ir.IntSLT) and (k == 0)) or ((p == ir.IntSLE) and (k == -1)) {
                return t.t1;
            }
            if ((p == ir.IntSGT) and (k == -1)) or ((p == ir.IntSGE) and (k == 0)) {
                return t.t2;
            }
        }
        return bnil();
    }
    if p == ir.RealOEQ {
        return t.t1;
    }
    if p == ir.RealUNE {
        return t.t2;
    }
    return bnil();
}

// Is v 0 or 1, a boolean (an i1, or one kept in a wider integer)?
fn is_bool(v: *ir.Value, depth: i32) bool {
    if (v.ty.kind == ir.T_INT) and (v.ty.bits == 1) {
        return true;
    }
    if v.kind == ir.V_CINT {
        return ir.cint_val(v) <= 1;
    }
    if (v.kind != ir.V_INST) or (depth > 3) {
        return false;
    }
    if v.op == ir.OP_ZEXT {
        return is_bool(v.a, depth + 1);
    }
    if v.op == ir.OP_SELECT {
        return is_bool(v.b, depth + 1) and is_bool(v.c, depth + 1);
    }
    if v.op == ir.OP_PHI {
        for k in 0..v.xs.len {
            if not is_bool(v.xs.get(k), depth + 1) {
                return false;
            }
        }
        return true;
    }
    return false;
}

fn one_bit(m: *ir.Value) bool {
    if m.kind == ir.V_CINT {
        let k = ir.cint_val(m);
        return (k & (k - 1)) == 0;
    }
    return ir.is_op(m, ir.OP_SHL) and (m.a.kind == ir.V_CINT) and (ir.cint_val(m.a) == 1);
}

// Could control pass from a to b without a jump (b is a successor of a)?
fn falls_into(a: *ir.Block, b: *mut ir.Block) bool {
    let t = ir.terminator(a);
    if u.isnil(t) {
        return true;
    }
    let n = ir.succ_count(t);
    for k in 0..n {
        if ir.succ(t, k) == b {
            return true;
        }
    }
    return false;
}

// An unlikely successor (unlikely_succ) that the layout put between two
// blocks that could otherwise follow each other without a jump (its branch
// and the likely successor, or the two arms' join) moves out of the way, to
// the nearest place no block falls into (after a jump or a return): the
// likely path then runs straight through, and the unlikely one takes the
// jumps. What moves is the successor and the blocks after it that it
// dominates, in the same loop (a few). Needs dominators; sets b.rpo.
fn place_unlikely(order: *mut u.List.[*mut ir.Block]) void {
    let n = order.len;
    for k in 0..n {
        order.get(k).aux = 0;  // 1: moves, 2: stays where it is
    }
    // the regions that move, [s, e) in the order, each with the block after it
    let mut rs = u.List.[usize].empty();
    let mut re = u.List.[usize].empty();
    for i in 0..n {
        let b = order.get(i);
        let us = unlikely_succ(b);
        if (b.aux == 1) or u.isnil(us) or (us.preds.len != 1) or (us.rpo <= b.rpo) {
            continue;
        }
        let s = @int_cast(usize, us.rpo);
        let mut e = s;
        while (e < n) and (e - s <= 8) and (order.get(e).aux == 0) and (order.get(e).loop_depth == b.loop_depth) and
              dominates(us, order.get(e)) {
            e += 1;
        }
        if (e == s) or (e - s > 8) or (e >= n) or (order.get(e).aux == 1) or (order.get(s - 1).aux == 1) or
           not falls_into(order.get(s - 1), order.get(e)) {
            continue;
        }
        for k in s..e {
            order.get(k).aux = 1;
        }
        order.get(s - 1).aux = 2;
        order.get(e).aux = 2;
        rs.push(s);
        re.push(e);
    }
    if rs.len == 0 {
        return;
    }
    let all = u.calloc_slice.[*mut ir.Block](n + 1);
    for k in 0..n {
        all[k] = order.get(k);
    }
    let mut w: usize = 0;
    for k in 0..n {
        if all[k].aux != 1 {
            order.set(w, all[k]);
            w += 1;
        }
    }
    order.len = w;
    // each region at the gap nearest to where it was
    for r in 0..rs.len {
        for k in 0..order.len {
            order.get(k).rpo = @int_cast(i32, k);
        }
        let s = @int_cast(usize, all[re.get(r)].rpo);  // (where it would go back)
        let mut at = order.len;
        let mut d: usize = 0;
        while d <= 64 {
            if (s > d) and not falls_into(order.get((s - d) - 1), order.get(s - d)) {
                at = s - d;
                break;
            }
            if (d > 0) and (s + d < order.len) and not falls_into(order.get((s + d) - 1), order.get(s + d)) {
                at = s + d;
                break;
            }
            d += 1;
        }
        let m = re.get(r) - rs.get(r);
        let old = order.len;
        for k in 0..m {
            order.push(all[0]);
        }
        let mut k = old;
        while k > at {
            k -= 1;
            order.set(k + m, order.get(k));
        }
        for j in 0..m {
            order.set(at + j, all[rs.get(r) + j]);
        }
    }
    for k in 0..order.len {
        order.get(k).rpo = @int_cast(i32, k);
    }
    u.free_slice.[*mut ir.Block](all);
    rs.deinit();
    re.deinit();
}

// A loop whose header tests for the exit (a `while` loop) has its header
// placed after its body, so an iteration ends in one branch back to the
// body instead of a jump to the header followed by the test. Needs
// dominators; b.rpo holds the positions.
fn rotate_loops(order: *mut u.List.[*mut ir.Block]) void {
    let headers = loop_headers(order);
    let mut body = u.List.[*mut ir.Block].empty();
    for hi in 0..headers.len {
        let h = headers.get(hi);
        let t = ir.terminator(h);
        if u.isnil(t) or (t.op != ir.OP_CONDBR) {
            continue;
        }
        // the loop's blocks: backwards from the latches to the header
        let tag = @int_cast(i64, hi) + 3000000;
        h.aux = tag;
        body.clear();
        let mut last = h.rpo;
        for k in 0..h.preds.len {
            let p = h.preds.get(k);
            if is_back_edge(p, h) and (p.aux != tag) {
                p.aux = tag;
                body.push(p);
            }
        }
        let mut members: i32 = 1;
        while body.len > 0 {
            let x = body.pop();
            members += 1;
            if x.rpo > last {
                last = x.rpo;
            }
            for k in 0..x.preds.len {
                let p = x.preds.get(k);
                if (p.rpo >= 0) and (p.aux != tag) {
                    p.aux = tag;
                    body.push(p);
                }
            }
        }
        // one successor in the loop, one outside; the loop contiguous
        let in1 = t.t1.aux == tag;
        let in2 = t.t2.aux == tag;
        if (in1 == in2) or (last == h.rpo) {
            continue;
        }
        if (last - h.rpo) + 1 != members {
            // blocks that leave the loop placed among its blocks go after it
            let mut w = @int_cast(usize, h.rpo);
            body.clear();
            for i in @int_cast(usize, h.rpo)..(@int_cast(usize, last) + 1) {
                let x = order.get(i);
                if x.aux == tag {
                    order.set(w, x);
                    x.rpo = @int_cast(i32, w);
                    w += 1;
                } else {
                    body.push(x);
                }
            }
            last = @int_cast(i32, w) - 1;
            for k in 0..body.len {
                let x = body.get(k);
                order.set(w + k, x);
                x.rpo = @int_cast(i32, w + k);
            }
        }
        let from = @int_cast(usize, h.rpo);
        let to = @int_cast(usize, last);
        for i in from..to {
            let x = order.get(i + 1);
            order.set(i, x);
            x.rpo = @int_cast(i32, i);
        }
        order.set(to, h);
        h.rpo = @int_cast(i32, to);
    }
    headers.deinit();
    body.deinit();
}

// -----------------------------------------------------------------------------
// Constants in loops: those the target must build in a register (`needs`:
// 64-bit immediates, floating point constants) are built once in the loop's
// preheader, by a copy instruction, instead of at every use. With `globals`,
// so are the addresses of globals indexed by a variable (a pc-relative
// operand has no index register: the address is built in one first). Needs
// dominators and predecessors.
// -----------------------------------------------------------------------------

// One constant: of one kind and type, with the same value (integers, floats
// by their bits), or else the same Value. Stricter than inline.same_const
// (any zeros of a type, and globals and functions by what they name) and
// combine.same_const (any zeros, of any kind).
fn same_const(a: *ir.Value, b: *ir.Value) bool {
    if (a.kind != b.kind) or (a.ty != b.ty) {
        return false;
    }
    if a.kind == ir.V_CINT {
        return a.cv == b.cv;
    }
    if a.kind == ir.V_CFP {
        return @bit_cast(u64, ir.fv_of(a)) == @bit_cast(u64, ir.fv_of(b));
    }
    return a == b;
}

pub fn hoist_constants(f: *mut ir.Func, order: *u.List.[*mut ir.Block], needs: fn(*ir.Value) bool, globals: bool,
                       needs_at: fn(*ir.Value, *ir.Value) bool) void {
    // headers, outermost first; each block's innermost header in auxp
    let mut headers = u.List.[*mut ir.Block].empty();
    for i in 0..order.len {
        let b = order.get(i);
        b.auxp = u.vnil();
        if is_loop_header(b) {
            headers.push(b);
        }
    }
    if headers.len == 0 {
        return;
    }
    // (insertion sort by depth: few headers)
    for i in 1..headers.len {
        let mut j = i;
        while (j > 0) and (headers.get(j - 1).depth > headers.get(j).depth) {
            let t = headers.get(j - 1);
            headers.set(j - 1, headers.get(j));
            headers.set(j, t);
            j -= 1;
        }
    }
    let mut work = u.List.[*mut ir.Block].empty();
    for hi in 0..headers.len {
        let h = headers.get(hi);
        let tag = @int_cast(i64, hi) + 4000000;
        h.aux = tag;
        h.auxp = @ptr_cast(*mut void, h);
        for k in 0..h.preds.len {
            let p = h.preds.get(k);
            if is_back_edge(p, h) and (p.aux != tag) {
                p.aux = tag;
                work.push(p);
            }
        }
        while work.len > 0 {
            let x = work.pop();
            x.auxp = @ptr_cast(*mut void, h);
            for k in 0..x.preds.len {
                let p = x.preds.get(k);
                if (p.rpo >= 0) and (p.aux != tag) {
                    p.aux = tag;
                    work.push(p);
                }
            }
        }
    }
    work.deinit();
    // copies per header: (constant, copy) in the preheader; a loop inside
    // another uses the copies of the loops around it (whose preheaders
    // dominate it) rather than making its own
    let mut made = u.List.[*mut ir.Value].empty();
    let mut offs = u.List.[*mut ir.Value].empty();
    let kept = u.calloc_slice.[u.List.[*mut ir.Value]](headers.len + 1);
    for hi in 0..headers.len {
        let h = headers.get(hi);
        // the preheader: the one predecessor outside the loop, ending in br h
        let mut pre = bnil();
        let mut outside: i32 = 0;
        for k in 0..h.preds.len {
            let p = h.preds.get(k);
            if not dominates(h, p) {
                outside += 1;
                pre = p;
            }
        }
        if outside != 1 {
            continue;
        }
        let pt = ir.terminator(pre);
        if u.isnil(pt) or (pt.op != ir.OP_BR) {
            continue;
        }
        made.clear();
        offs.clear();
        for j in 0..hi {
            if pre.auxp == @ptr_cast(*mut void, headers.get(j)) {
                for k in 0..kept[j].len {
                    made.push(kept[j].get(k));
                }
            }
        }
        for bi in 0..order.len {
            let b = order.get(bi);
            if b.auxp != @ptr_cast(*mut void, h) {
                continue;
            }
            let mut i = b.first;
            while u.notnil(i) {
                if i.op != ir.OP_PHI {
                    if globals {
                        if global_in_reg(i, i.a, 0) {
                            i.a = hoisted(f, i.a, pt, &mut made, any_value);
                        } else if global_indexed(i) {
                            i.a = hoisted_offset(f, ir.resolve(i.a), pt, &mut made, &mut offs);
                        }
                        if global_in_reg(i, i.b, 1) {
                            i.b = hoisted(f, i.b, pt, &mut made, any_value);
                        }
                        if global_in_reg(i, i.c, 2) {
                            i.c = hoisted(f, i.c, pt, &mut made, any_value);
                        }
                        for k in 0..i.xs.len {
                            if global_in_reg(i, i.xs.get(k), 3) {
                                i.xs.set(k, hoisted(f, i.xs.get(k), pt, &mut made, any_value));
                            }
                        }
                    }
                    i.a = hoisted(f, i.a, pt, &mut made, needs);
                    i.b = hoisted(f, i.b, pt, &mut made, needs);
                    i.c = hoisted(f, i.c, pt, &mut made, needs);
                    for k in 0..copyable_xs(i) {
                        let x = i.xs.get(k);
                        if u.notnil(x) and needs_at(i, x) {
                            i.xs.set(k, hoisted(f, x, pt, &mut made, any_value));
                        } else {
                            i.xs.set(k, hoisted(f, x, pt, &mut made, needs));
                        }
                    }
                }
                i = i.next;
            }
        }
        for k in 0..made.len {
            kept[hi].push(made.get(k));
        }
    }
    for hi in 0..headers.len {
        u.free(@ptr_cast(*mut void, kept[hi].data));
    }
    u.free_slice.[u.List.[*mut ir.Value]](kept);
    headers.deinit();
    made.deinit();
    offs.deinit();
}

// Is i (in a loop) an address `(g + k) + x`, g a global (not thread-local), k
// a constant and x not? A pc-relative address takes no register to add x to
// (x86-64), or none at all (AArch64): the instruction selection builds g + k
// where i is, in every iteration, unless it is in a register already.
fn global_indexed(i: *ir.Value) bool {
    if (i.op != ir.OP_PTRADD) or ir.is_cint(i.b) {
        return false;
    }
    let a = ir.resolve(i.a);
    if not ir.is_op(a, ir.OP_PTRADD) or not ir.is_cint(ir.resolve(a.b)) {
        return false;
    }
    let g = ir.resolve(a.a);
    return (g.kind == ir.V_GLOBAL) and not ir.gv_of(g).tls;
}

// Is g, operand k of i (0: a, 1: b, 2: c, 3: xs), the address of a (not
// thread-local) global that i reads from a register? Not the address a load
// or store goes to, or one with a constant added: those are pc-relative.
fn global_in_reg(i: *ir.Value, g: *ir.Value, k: i32) bool {
    if u.isnil(g) or (g.kind != ir.V_GLOBAL) or ir.gv_of(g).tls {
        return false;
    }
    let o = i.op;
    if ((o == ir.OP_LOAD) and (k == 0)) or ((o == ir.OP_STORE) and (k == 1)) {
        return false;
    }
    return (o != ir.OP_PTRADD) or (k != 0) or not ir.is_cint(i.b);
}

// How many of i's xs a constant may be replaced in by a copy: none of a
// switch's, its cases, which selection compares with as constants.
fn copyable_xs(i: *ir.Value) usize {
    if i.op == ir.OP_SWITCH {
        return 0;
    }
    return i.xs.len;
}

fn any_value(v: *ir.Value) bool {
    _ = v;
    return true;
}

// (for hoist_constants: no operand needs a register for its instruction)
pub fn no_operand_needs(i: *ir.Value, v: *ir.Value) bool {
    _ = i;
    _ = v;
    return false;
}

// Constants outside loops that the target must build in a register (`needs`
// says which, for an instruction using them), used more than once: built once, by a copy at a use whose block
// dominates other uses, which use the copy (a 64-bit multiplier used three
// times in a block, a floating point bound compared with in a run of
// branches). The register allocator builds a copy of a constant again where
// it would otherwise spill it. After hoist_constants, which takes the uses
// in loops; needs dominators.
struct SharedConst {
    k: *mut ir.Value,
    blocks: u.List.[*mut ir.Block],  // (of its uses)
    copies: u.List.[*mut ir.Value],
}

pub fn share_constants(f: *mut ir.Func, order: *u.List.[*mut ir.Block], needs: fn(*ir.Value, *ir.Value) bool) void {
    let mut cs = u.List.[SharedConst].empty();
    for pass in @as(i32, 0)..2 {
        // (in reverse postorder: a use in a dominating block comes first)
        for bi in 0..order.len {
            let b = order.get(bi);
            let mut i = b.first;
            while u.notnil(i) {
                if (i.op != ir.OP_PHI) and (i.op != ir.OP_COPY) {
                    if pass == 0 {
                        note_const(&mut cs, i, i.a, b, needs);
                        note_const(&mut cs, i, i.b, b, needs);
                        note_const(&mut cs, i, i.c, b, needs);
                        for k in 0..copyable_xs(i) {
                            note_const(&mut cs, i, i.xs.get(k), b, needs);
                        }
                    } else {
                        i.a = shared(f, &mut cs, i.a, i, needs);
                        i.b = shared(f, &mut cs, i.b, i, needs);
                        i.c = shared(f, &mut cs, i.c, i, needs);
                        for k in 0..copyable_xs(i) {
                            i.xs.set(k, shared(f, &mut cs, i.xs.get(k), i, needs));
                        }
                    }
                }
                i = i.next;
            }
        }
        if cs.len == 0 {
            break;
        }
    }
    for k in 0..cs.len {
        u.free(@ptr_cast(*mut void, cs.at(k).blocks.data));
        u.free(@ptr_cast(*mut void, cs.at(k).copies.data));
    }
    cs.deinit();
}

fn find_const(cs: *mut u.List.[SharedConst], v: *mut ir.Value) i64 {
    for k in 0..cs.len {
        if same_const(cs.at(k).k, v) {
            return @int_cast(i64, k);
        }
    }
    return -1;
}

fn note_const(cs: *mut u.List.[SharedConst], i: *mut ir.Value, v: *mut ir.Value, b: *mut ir.Block,
              needs: fn(*ir.Value, *ir.Value) bool) void {
    if u.isnil(v) or not needs(i, v) {
        return;
    }
    let mut k = find_const(cs, v);
    if k < 0 {
        if cs.len >= 64 {
            return;
        }
        cs.push(SharedConst.{ k: v, blocks: u.List.[*mut ir.Block].empty(), copies: u.List.[*mut ir.Value].empty() });
        k = @int_cast(i64, cs.len) - 1;
    }
    let c = cs.at(@int_cast(usize, k));
    if c.blocks.len < 64 {
        c.blocks.push(b);
    }
}

// v, an operand of i, or a shared copy of it: one made before an earlier
// use that dominates i, or one made here when i's block dominates another
// use.
fn shared(f: *mut ir.Func, cs: *mut u.List.[SharedConst], v: *mut ir.Value, i: *mut ir.Value,
          needs: fn(*ir.Value, *ir.Value) bool) *mut ir.Value {
    if u.isnil(v) or not needs(i, v) {
        return v;
    }
    let k = find_const(cs, v);
    if k < 0 {
        return v;
    }
    let c = cs.at(@int_cast(usize, k));
    let b = i.blk;
    for j in 0..c.copies.len {
        if dominates(c.copies.get(j).blk, b) {
            return c.copies.get(j);
        }
    }
    let mut n: i32 = 0;
    for j in 0..c.blocks.len {
        if dominates(b, c.blocks.get(j)) {
            n += 1;
        }
    }
    if n < 2 {
        return v;
    }
    let cp = ir.new_inst(f, ir.OP_COPY, v.ty);
    cp.a = v;
    ir.insert_before(i, cp);
    c.copies.push(cp);
    return cp;
}

// Values `needs` picks (thread-local addresses on AArch64) are built once in
// the entry block, for the whole function.
pub fn hoist_to_entry(f: *mut ir.Func, needs: fn(*ir.Value) bool) void {
    let e = f.first;
    if u.isnil(e) or u.isnil(e.first) {
        return;
    }
    // after the entry's phis (none) and allocas
    let mut at = e.first;
    while u.notnil(at.next) and (at.op == ir.OP_ALLOCA) {
        at = at.next;
    }
    let mut made = u.List.[*mut ir.Value].empty();
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if (i.op != ir.OP_PHI) and (i.op != ir.OP_COPY) {
                i.a = hoisted(f, i.a, at, &mut made, needs);
                i.b = hoisted(f, i.b, at, &mut made, needs);
                i.c = hoisted(f, i.c, at, &mut made, needs);
                for k in 0..i.xs.len {
                    i.xs.set(k, hoisted(f, i.xs.get(k), at, &mut made, needs));
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    made.deinit();
}

fn hoisted(f: *mut ir.Func, v: *mut ir.Value, at: *mut ir.Value, made: *mut u.List.[*mut ir.Value],
           needs: fn(*ir.Value) bool) *mut ir.Value {
    if u.isnil(v) or not needs(v) {
        return v;
    }
    for k in 0..made.len {
        let c = made.get(k);
        if same_const(c.a, v) {
            return c;
        }
    }
    let c = ir.new_inst(f, ir.OP_COPY, v.ty);
    c.a = v;
    ir.insert_before(at, c);
    made.push(c);
    return c;
}

// g + k (a = ptradd(g, k): global_indexed) computed before at, from the
// global's address in a register (a copy, hoisted): once per loop (offs).
fn hoisted_offset(f: *mut ir.Func, a: *mut ir.Value, at: *mut ir.Value, made: *mut u.List.[*mut ir.Value],
                  offs: *mut u.List.[*mut ir.Value]) *mut ir.Value {
    let g = ir.resolve(a.a);
    let k = ir.resolve(a.b);
    for j in 0..offs.len {
        let o = offs.get(j);
        if (o.a.a == g) and same_const(o.b, k) {
            return o;
        }
    }
    let c = hoisted(f, g, at, made, any_value);
    let o = ir.new_inst(f, ir.OP_PTRADD, a.ty);
    o.a = c;
    o.b = k;
    ir.insert_before(at, o);
    offs.push(o);
    return o;
}

// Splits edges from blocks with several successors to blocks with phis and
// several predecessors, so phi copies can go at the end of the source.
pub fn split_critical_edges(f: *mut ir.Func) void {
    compute_preds(f);
    let mut b = f.first;
    while u.notnil(b) {
        let t = ir.terminator(b);
        let n = ir.succ_count(t);
        if n >= 2 {
            // (every edge to s at once: a later one sees the new block,
            // which has no predecessors yet)
            for k in 0..n {
                let s = ir.succ(t, k);
                if (s.preds.len >= 2) and has_phis(s) {
                    _ = ir.split_edge(f, "edge", b, s);
                }
            }
        }
        b = b.next;
    }
    compute_preds(f);
}

// Splits the edges that leave a loop from a block with several successors
// into a block with several predecessors (LLVM's dedicated exits), so the
// register allocator has a place for code on the way out: reloads of values
// live through the loop that are in memory inside it (around a call on a
// rare path) go there rather than at the end of the loop body. A block left
// empty costs nothing (jumps to it go where it does).
pub fn split_loop_exits(f: *mut ir.Func) void {
    compute_preds(f);
    let order = dominators(f);
    loop_depths(f, &order);
    for oi in 0..order.len {
        let b = order.get(oi);
        let t = ir.terminator(b);
        let n = ir.succ_count(t);
        if (n < 2) or (b.loop_depth == 0) {
            continue;
        }
        for k in 0..n {
            let s = ir.succ(t, k);
            if (s.preds.len < 2) or (s.loop_depth >= b.loop_depth) {
                continue;
            }
            let mut dup = false;
            for j in 0..n {
                if (j != k) and (ir.succ(t, j) == s) {
                    dup = true;
                }
            }
            if dup {
                continue;  // (both successors one block: left alone)
            }
            ir.set_succ(t, k, ir.edge_block(f, "exit", b, s));
        }
    }
    order.deinit();
    compute_preds(f);
}

// -----------------------------------------------------------------------------
// Comparisons tested in other blocks (for the native backends, before
// instruction selection): a branch or select in block X on a comparison
// computed in another block compares again in X, where the flags are set
// right before the jump, instead of testing a 0/1 value kept in a register
// (or spilled) from where it was computed. Only when the operands are
// constants, parameters or values used elsewhere too (so likely live
// anyway); `(x & k) == 0` is computed again with the `and`.
// -----------------------------------------------------------------------------

fn sink_operand_ok(o: *ir.Value) bool {
    return (o.kind != ir.V_INST) or (o.aux >= 2);
}

fn sinkable_cmp(c: *ir.Value) bool {
    if (c.kind != ir.V_INST) or (c.op != ir.OP_ICMP) or (c.ty.kind != ir.T_INT) {
        return false;
    }
    let at = c.a.ty;
    if ((at.kind != ir.T_INT) and (at.kind != ir.T_PTR)) or (at.bits > 64) {
        return false;
    }
    if sink_and(c) {
        return sink_operand_ok(c.a.a);
    }
    return sink_operand_ok(c.a) and sink_operand_ok(c.b);
}

// c is `(x & k) ==/!= 0` with the `and` used only there.
fn sink_and(c: *ir.Value) bool {
    let x = c.a;
    let p = ir.pred_of(c);
    return ((p == ir.IntEQ) or (p == ir.IntNE)) and ir.is_cint(c.b) and (ir.cint_val(c.b) == 0) and
           ir.is_op(x, ir.OP_AND) and (x.aux == 1) and ir.is_cint(x.b) and (x.ty.kind == ir.T_INT) and
           (x.ty.bits <= 64);
}

fn clone_inst(f: *mut ir.Func, i: *ir.Value, before: *mut ir.Value) *mut ir.Value {
    let y = ir.new_inst(f, i.op, i.ty);
    y.cv = i.cv;
    y.a = i.a;
    y.b = i.b;
    y.src = i.src;
    y.scope = i.scope;
    ir.insert_before(before, y);
    return y;
}

pub fn sink_compares(f: *mut ir.Func) void {
    // use counts (aux)
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.aux = 0;
            i = i.next;
        }
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if u.notnil(i.a) and (i.a.kind == ir.V_INST) {
                i.a.aux += 1;
            }
            if u.notnil(i.b) and (i.b.kind == ir.V_INST) {
                i.b.aux += 1;
            }
            if u.notnil(i.c) and (i.c.kind == ir.V_INST) {
                i.c.aux += 1;
            }
            for k in 0..i.xs.len {
                let o = i.xs.get(k);
                if o.kind == ir.V_INST {
                    o.aux += 1;
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    let mut any = false;
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if ((i.op == ir.OP_CONDBR) or (i.op == ir.OP_SELECT)) and (i.a.kind == ir.V_INST) and (i.a.blk != b) and
               sinkable_cmp(i.a) {
                let c = i.a;
                let y = clone_inst(f, c, i);
                if sink_and(c) {
                    y.a = clone_inst(f, c.a, y);
                }
                i.a = y;
                c.aux -= 1;
                any = true;
            }
            i = i.next;
        }
        b = b.next;
    }
    if any {
        dce(f);
    }
}
