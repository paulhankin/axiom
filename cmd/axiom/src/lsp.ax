// =============================================================================
// lsp.ax - the language server (axiom lsp): the Language Server Protocol
// over standard input and output, for editors.
//
//   axiom lsp [--target=<t>] [--std=<dir>]
//
// The server keeps the text of the editor's open documents and answers each
// request in this process, as `axiom ide` (ide.ax) would with those texts on
// its standard input.
//
// It does not check the whole program for each request. A check runs on a
// thread of its own, which gives back all it allocated when it ends, and
// finds what the main thread has checked before (modload.ax's kept modules) as
// it does the main thread's strings, types and files (util.ax's worker
// threads): it checks only the modules it does not find there, so usually
// the documents being edited. The main thread keeps the modules that a
// check found clean, once no message is waiting: it checks them once more
// and keeps them for the session, so that std/ and the files not being
// edited are checked once. A kept module is dropped (with what imports it)
// when its file changes on disk or its open document's text is no longer the
// file's, and one being edited in the editor is never kept.
//
// Diagnostics are published for a document after it changes, once every
// message that has already arrived has been handled, so a burst of edits
// costs one check. Saving a document checks every open one again, since
// they may import it.
// =============================================================================
import "ast.ax" as ast;
import "diag.ax" as dg;
import "ide.ax" as ide;
import "modload.ax" as modl;
import "sema.ax" as sema;
import "std/encoding/json" as json;
import "std/thread" as thread;
import "target.ax" as tg;
import "types.ax" as ty;
import "util.ax" as u;

struct Doc {
    uri: []mut u8,  // as the client sent it
    path: []mut u8,
    real: []mut u8,  // its real path (or path, for a file not on disk)
    text: []mut u8,
    dirty: bool,   // diagnostics to publish
    edited: bool,  // changed since it was opened (then its module is not kept)
}

let mut docs: u.List.[*mut Doc] = u.List.[*mut Doc].{ data: @ptr_from_int(*mut *mut Doc, 0), len: 0, cap: 0 };
let mut g_std: []u8 = "";
let mut shutting_down: bool = false;

// -----------------------------------------------------------------------------
// Heap strings (documents outlive the scratch memory each message gets)
// -----------------------------------------------------------------------------
fn keep(s: []u8) []mut u8 {
    let p = @ptr_cast(*mut u8, u.malloc(s.len + 1));
    let out = @slice_from_ptr(p, s.len);
    @mem_copy(out, s);
    return out;
}

fn drop(s: []mut u8) void {
    u.free(@ptr_cast(*mut void, s.ptr));
}

// -----------------------------------------------------------------------------
// Messages: "Content-Length: n\r\n\r\n" and n bytes of JSON
// -----------------------------------------------------------------------------
let mut inbuf: u.List.[u8] = u.List.[u8].{ data: @ptr_from_int(*mut u8, 0), len: 0, cap: 0 };
let mut inpos: usize = 0;  // where the next message starts

// Reads more input; false at the end.
fn fill() bool {
    let mut chunk: [65536]u8 = [0; 65536];
    let n = u.read(0, &mut chunk[0], 65536);
    if n <= 0 {
        return false;
    }
    for i in 0..@int_cast(usize, n) {
        inbuf.push(chunk[i]);
    }
    return true;
}

fn lower(c: u8) u8 {
    if (c >= 'A') and (c <= 'Z') {
        return c + 32;
    }
    return c;
}

struct Frame {
    ok: bool,      // a whole message is buffered
    start: usize,  // its body
    len: usize,
}

// The next whole message in the buffer, if there is one.
fn frame() Frame {
    let none = Frame.{ ok: false, start: 0, len: 0 };
    let b = inbuf.items();
    let mut i = inpos;
    while (i + 3) < b.len {
        if (b[i] == '\r') and (b[i + 1] == '\n') and (b[i + 2] == '\r') and (b[i + 3] == '\n') {
            break;
        }
        i += 1;
    }
    if (i + 3) >= b.len {
        return none;
    }
    // Content-Length, among the headers
    let key = "content-length:";
    let mut len: usize = 0;
    let mut found = false;
    let mut h = inpos;
    while (h + key.len) <= i {
        let mut same = true;
        for k in 0..key.len {
            if lower(b[h + k]) != key[k] {
                same = false;
                break;
            }
        }
        if same {
            let mut j = h + key.len;
            while (j < i) and (b[j] == ' ') {
                j += 1;
            }
            while (j < i) and u.is_digit(b[j]) {
                len = (len * 10) + @as(usize, b[j] - '0');
                j += 1;
            }
            found = true;
            break;
        }
        h += 1;
    }
    let start = i + 4;
    if not found {
        // not a message we can read: skip the header
        inpos = start;
        return none;
    }
    if len > (b.len - start) {
        return none;
    }
    return Frame.{ ok: true, start: start, len: len };
}

fn have_message() bool {
    return frame().ok;
}

// The next message's body (valid until the next call), or a nil slice at
// the end of the input.
fn next_message() []u8 {
    // drop what has been handled
    if inpos > 0 {
        let b = inbuf.items();
        let rest = b.len - inpos;
        for i in 0..rest {
            b[i] = b[inpos + i];
        }
        inbuf.len = rest;
        inpos = 0;
    }
    loop {
        let f = frame();
        if f.ok {
            inpos = f.start + f.len;
            return inbuf.items()[f.start..f.start + f.len];
        }
        if not fill() {
            return u.nosym();
        }
    }
}

fn send(body: []u8) void {
    u.write_all(1, u.f1("Content-Length: %s\r\n\r\n", u.zdec(body.len)));
    u.write_all(1, body);
}

fn respond(id: []u8, result: []u8) void {
    send(u.f2("{\"jsonrpc\":\"2.0\",\"id\":%s,\"result\":%s}", id, result));
}

fn respond_error(id: []u8, code: i32, msg: []u8) void {
    let mut b = u.Buf.init();
    b.s(u.f2("{\"jsonrpc\":\"2.0\",\"id\":%s,\"error\":{\"code\":%s,\"message\":", id, u.idec(code)));
    dg.json_str(&mut b, msg);
    b.s("}}");
    send(b.done());
}

fn log(msg: []u8) void {
    u.eprint(u.cat2(msg, "\n"));
}

// -----------------------------------------------------------------------------
// Reading requests
// -----------------------------------------------------------------------------
fn get(v: json.Value, key: []u8) json.Value {
    return v.get(key) catch json.Value.Null;
}

fn str_of(v: json.Value) []u8 {
    return v.as_str() catch "";
}

fn int_of(v: json.Value) i64 {
    return v.as_i64() catch -1;
}

// The id of a request as JSON, or a nil slice for a notification.
fn id_of(msg: json.Value) []u8 {
    match get(msg, "id") {
        .Int(x) => { return u.dec(x); }
        .String(s) => {
            let mut b = u.Buf.init();
            dg.json_str(&mut b, s);
            return b.done();
        }
        else => { return u.nosym(); }
    }
}

fn hex_val(c: u8) i32 {
    if (c >= '0') and (c <= '9') {
        return @as(i32, c - '0');
    }
    let l = lower(c);
    if (l >= 'a') and (l <= 'f') {
        return @as(i32, l - 'a') + 10;
    }
    return -1;
}

// file:///home/a/b.ax -> /home/a/b.ax; file:///c%3A/a/b.ax -> C:/a/b.ax
fn path_of(uri: []u8) []u8 {
    if not u.starts(uri, "file://") {
        return uri;
    }
    let s = uri[7..];
    let mut b = u.Buf.init();
    let mut i: usize = 0;
    while i < s.len {
        let c = s[i];
        if (c == '%') and ((i + 2) < s.len) and (hex_val(s[i + 1]) >= 0) and (hex_val(s[i + 2]) >= 0) {
            b.c(@int_cast(u8, (hex_val(s[i + 1]) * 16) + hex_val(s[i + 2])));
            i += 3;
            continue;
        }
        b.c(c);
        i += 1;
    }
    let p = b.done();
    if (p.len >= 3) and (p[0] == '/') and u.is_alnum(p[1]) and not u.is_digit(p[1]) and (p[2] == ':') {
        let mut w = u.Buf.init();
        let d = p[1];
        if (d >= 'a') and (d <= 'z') {
            w.c(d - 32);
        } else {
            w.c(d);
        }
        w.s(p[2..]);
        return w.done();
    }
    return p;
}

fn find_doc(uri: []u8) *mut Doc {
    for i in 0..docs.len {
        let d = docs.get(i);
        if u.str_eq(d.uri, uri) {
            return d;
        }
    }
    return u.nil.[Doc]();
}

fn set_text(d: *mut Doc, text: []u8) void {
    if not u.str_eq(d.text, text) {
        d.edited = true;
    }
    drop(d.text);
    d.text = keep(text);
    d.dirty = true;
}

fn open_doc(uri: []u8, text: []u8) void {
    let old = find_doc(uri);
    if u.notnil(old) {
        set_text(old, text);
        return;
    }
    let d = @ptr_cast(*mut Doc, u.calloc(1, @size_of(Doc)));
    d.uri = keep(uri);
    d.path = keep(path_of(uri));
    let r = u.real_path(d.path);
    d.real = keep(u.pick(u.isnos(r), d.path, r));
    d.text = keep(text);
    d.dirty = true;
    docs.push(d);
}

fn close_doc(uri: []u8) void {
    let xs = docs.items();
    for i in 0..xs.len {
        let d = xs[i];
        if not u.str_eq(d.uri, uri) {
            continue;
        }
        drop(d.uri);
        drop(d.path);
        drop(d.real);
        drop(d.text);
        u.free(@ptr_cast(*mut void, d));
        for j in i + 1..xs.len {
            xs[j - 1] = xs[j];
        }
        docs.len -= 1;
        return;
    }
}

// -----------------------------------------------------------------------------
// The modules kept checked
// -----------------------------------------------------------------------------
struct Kept {
    m: *mut ast.Module,
    stamp: [2]i64,  // its file's size and time when it was kept
}

let mut kept: u.List.[Kept] = u.List.[Kept].{ data: @ptr_from_int(*mut Kept, 0), len: 0, cap: 0 };
// The modules checks found clean, to check and keep (real paths, heap); and
// those that were to be kept but were not, not tried again.
let mut to_keep: u.List.[[]mut u8] = u.List.[[]mut u8].{ data: @ptr_from_int(*mut []mut u8, 0), len: 0, cap: 0 };
let mut not_kept: u.List.[[]mut u8] = u.List.[[]mut u8].{ data: @ptr_from_int(*mut []mut u8, 0), len: 0, cap: 0 };

fn listed(xs: *u.List.[[]mut u8], p: []u8) bool {
    for i in 0..xs.len {
        if u.str_eq(xs.get(i), p) {
            return true;
        }
    }
    return false;
}

// Brings the overlays (the open documents) up to date, and drops the kept
// modules that are no longer what their files hold, with every kept module
// that imports one of them.
fn sync() void {
    u.g_overlays.len = 0;
    for i in 0..docs.len {
        let d = docs.get(i);
        u.g_overlays.push(u.Overlay.{ path: d.real, text: d.text, edited: d.edited });
    }
    let ks = kept.items();
    let mut n: usize = 0;
    for i in 0..ks.len {
        let k = ks[i];
        let m = k.m;
        let st = u.file_stamp(m.path);
        let mut good = (st[0] == k.stamp[0]) and (st[1] == k.stamp[1]);
        let ov = u.overlay_text(m.path);
        if not u.isnos(ov) and not u.str_eq(ov, m.file.text) {
            good = false;
        }
        for j in 0..m.decls.len {
            let d = m.decls.get(j);
            if (d.kind == ast.D_IMPORT) and u.notnil(d.imported) and (modl.kept_module(d.imported.path) != d.imported) {
                good = false;  // (kept before m: dropped above)
            }
        }
        if not good {
            modl.evict(m.path);
            ide.drop_index(m.path);
            continue;
        }
        ks[n] = k;
        n += 1;
    }
    kept.len = n;
}

// On the main thread, between messages: checks the modules to keep (each
// for good, which is why only clean ones are) and keeps those still clean.
fn keep_checked() void {
    if to_keep.len == 0 {
        return;
    }
    sync();
    let mut paths = u.List.[[]u8].empty();
    for i in 0..to_keep.len {
        let p = to_keep.get(i);
        if u.isnil(modl.kept_module(u.intern(p))) {
            paths.push(p);
        }
    }
    if paths.len > 0 {
        dg.clear();
        let so = sema.SemaOptions.{ std_dir: g_std, extra_files: paths.items()[1..] };
        _ = sema.run(paths.get(0), &so);
        let cs = modl.clean();
        for i in 0..cs.len {
            let m = cs.get(i);
            modl.admit(m);
            ide.index_kept(m);
            kept.push(Kept.{ m: m, stamp: u.file_stamp(m.path) });
        }
        dg.clear();
        for i in 0..paths.len {
            let p = paths.get(i);
            if u.isnil(modl.kept_module(u.intern(p))) and not listed(&not_kept, p) {
                not_kept.push(keep(p));
            }
        }
    }
    for i in 0..to_keep.len {
        drop(to_keep.get(i));
    }
    to_keep.len = 0;
}

// -----------------------------------------------------------------------------
// Asking the compiler
// -----------------------------------------------------------------------------
// A question, answered on a thread of its own.
struct Query {
    path: []u8,
    args: [][]u8,  // axiom ide's options (ide.option)
    us: u.WorkerStart,
    ts: ty.WorkerStart,
    features: u64,
    out: []u8,    // the answer (u.keep_dup), or a nil slice
    clean: []u8,  // the modules found clean, a path per line (u.keep_dup), or a nil slice
}

fn answer(q: *mut Query) void {
    u.worker_begin(&q.us);
    ty.worker_begin(&q.ts);
    tg.g_features = q.features;
    for a in q.args {
        _ = ide.option(a);
    }
    let out = ide.answer(q.path, g_std);
    if not u.isnos(out) {
        q.out = u.keep_dup(out);
    }
    if u.notnil(modl.g_prog) {
        let cs = modl.clean();
        let mut b = u.Buf.init();
        for i in 0..cs.len {
            b.s(cs.get(i).path);
            b.c('\n');
        }
        if b.len() > 0 {
            q.clean = u.keep_dup(b.done());
        }
    }
    u.worker_end();
}

// The answer to `--query=<query> <more>...` about the document at `path`
// (JSON), or a nil slice.
fn ask(query: []u8, path: []u8, more: [][]u8) []u8 {
    sync();
    let mut args = u.List.[[]u8].empty();
    args.push(u.cat2("--query=", query));
    for a in more {
        args.push(a);
    }
    let mut q = Query.{ path: path, args: args.items(), us: u.worker_start(), ts: ty.worker_start(),
                        features: tg.g_features, out: u.nosym(), clean: u.nosym() };
    let t = thread.spawn(answer, &mut q) catch |e| {
        log(u.f1("axiom lsp: cannot start a thread: %s", @error_name(e)));
        return u.nosym();
    };
    t.join();
    if not u.isnos(q.clean) {
        let mut rest = q.clean;
        while rest.len > 0 {
            let nl = u.find(rest, '\n');
            let p = rest[0..@int_cast(usize, nl)];
            rest = rest[@int_cast(usize, nl) + 1..];
            if not listed(&to_keep, p) and not listed(&not_kept, p) {
                to_keep.push(keep(p));
            }
        }
        u.free_heap(q.clean);
    }
    if u.isnos(q.out) {
        log(u.f2("axiom lsp: no answer to %s about %s", query, path));
        return u.nosym();
    }
    let r = u.dup(q.out);
    u.free_heap(q.out);
    if r.len == 0 {
        return u.nosym();
    }
    return r;
}

fn publish(d: *mut Doc) void {
    d.dirty = false;
    if not u.ends(d.path, ".ax") {
        return;
    }
    let r = ask("diagnostics", d.path, u.no_strs());
    if u.isnos(r) {
        return;
    }
    let mut b = u.Buf.init();
    b.s("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":");
    dg.json_str(&mut b, d.uri);
    b.s(",\"diagnostics\":");
    b.s(r);
    b.s("}}");
    send(b.done());
}

fn clear_diagnostics(uri: []u8) void {
    let mut b = u.Buf.init();
    b.s("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":");
    dg.json_str(&mut b, uri);
    b.s(",\"diagnostics\":[]}}");
    send(b.done());
}

fn capabilities() []u8 {
    return "{\"capabilities\":{\"positionEncoding\":\"utf-16\",\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":{\"includeText\":false}},\"hoverProvider\":true,\"definitionProvider\":true,\"typeDefinitionProvider\":true,\"referencesProvider\":true,\"documentHighlightProvider\":true,\"renameProvider\":true,\"documentSymbolProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\",\"@\"]},\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"documentFormattingProvider\":true},\"serverInfo\":{\"name\":\"axiom lsp\",\"version\":\"0.1.0\"}}";
}

// The `axiom ide` query for a request about a document, or "".
fn query_of(method: []u8) []u8 {
    let pre = "textDocument/";
    if not u.starts(method, pre) {
        return "";
    }
    let m = method[pre.len..];
    let qs = ["hover", "definition", "typeDefinition", "references", "documentHighlight", "rename", "documentSymbol",
              "completion", "signatureHelp", "formatting"];
    for q in qs {
        if u.str_eq(m, q) {
            return q;
        }
    }
    return "";
}

// Handles one message; false once the client says to exit.
fn handle(body: []u8) bool {
    let mut doc = json.parse(body) catch {
        log("axiom lsp: a message that is not JSON");
        return true;
    };
    defer doc.deinit();
    let msg = doc.root;
    let method = str_of(get(msg, "method"));
    let id = id_of(msg);
    let params = get(msg, "params");
    let td = get(params, "textDocument");
    let uri = str_of(get(td, "uri"));
    if u.str_eq(method, "initialize") {
        respond(id, capabilities());
        return true;
    }
    if u.str_eq(method, "shutdown") {
        shutting_down = true;
        respond(id, "null");
        return true;
    }
    if u.str_eq(method, "exit") {
        return false;
    }
    if u.str_eq(method, "textDocument/didOpen") {
        open_doc(uri, str_of(get(td, "text")));
        return true;
    }
    if u.str_eq(method, "textDocument/didChange") {
        let d = find_doc(uri);
        let changes = get(params, "contentChanges");
        let n = changes.len();
        if u.notnil(d) and (n > 0) {
            // whole-document sync: the last change is the text
            let last = changes.at(n - 1) catch json.Value.Null;
            set_text(d, str_of(get(last, "text")));
        }
        return true;
    }
    if u.str_eq(method, "textDocument/didSave") {
        for i in 0..docs.len {
            let d = docs.get(i);
            d.dirty = true;
        }
        return true;
    }
    if u.str_eq(method, "textDocument/didClose") {
        close_doc(uri);
        clear_diagnostics(uri);
        return true;
    }
    let q = query_of(method);
    if (q.len > 0) and not u.isnos(id) {
        let mut more = u.List.[[]u8].empty();
        let pos = get(params, "position");
        if not pos.is_null() {
            more.push(u.f2("--pos=%s:%s", u.dec(int_of(get(pos, "line"))), u.dec(int_of(get(pos, "character")))));
        }
        if u.str_eq(q, "rename") {
            more.push(u.cat2("--new-name=", str_of(get(params, "newName"))));
        }
        let incl = get(get(params, "context"), "includeDeclaration").as_bool() catch true;
        if u.str_eq(q, "references") and not incl {
            more.push("--exclude-declaration");
        }
        let r = ask(q, path_of(uri), more.items());
        if u.str_eq(q, "rename") and (u.isnos(r) or u.str_eq(r, "null")) {
            respond_error(id, -32803, "this name cannot be renamed here");
            return true;
        }
        if u.isnos(r) {
            respond(id, "null");
        } else {
            respond(id, r);
        }
        return true;
    }
    if not u.isnos(id) {
        respond_error(id, -32601, u.f1("unsupported request %s", method));
    }
    return true;  // a notification we do not need
}

// Serves the client on standard input and output until it says to exit
// (the target set, with the standard library in `std_dir`).
pub fn run(std_dir: []u8) i32 {
    g_std = std_dir;
    loop {
        // between bursts of messages: diagnostics for what changed, then
        // what to keep
        if not have_message() {
            for i in 0..docs.len {
                let d = docs.get(i);
                if d.dirty {
                    u.scratch_begin();
                    publish(d);
                    u.scratch_end();
                }
            }
        }
        if not have_message() {
            keep_checked();
        }
        let body = next_message();
        if u.isnos(body) {
            break;
        }
        u.scratch_begin();
        let go_on = handle(body);
        u.scratch_end();
        if not go_on {
            break;
        }
    }
    if shutting_down {
        return 0;
    }
    return 1;
}
