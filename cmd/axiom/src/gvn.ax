// =============================================================================
// gvn.ax - global value numbering over the dominator tree (in the style of
// LLVM's EarlyCSE, with memory):
//
//   - an instruction without effects that repeats one that dominates it is
//     replaced by it (commutative operands in either order);
//   - a load of a location whose value is known (an earlier load or store,
//     with no possibly aliasing write in between) is replaced by that value,
//     and a store of the value a location already holds is deleted;
//   - below a conditional branch, its condition is a constant, and so are
//     comparisons it implies (the same, inverted or swapped), the operands of
//     an `and` known true or an `or` known false, and x in `x == K`.
//
// Writes between a block's immediate dominator and the block (other paths
// into a join, or a loop's body) are collected so known values survive
// joins and loops that do not write them.
//
// Alias analysis: a pointer is a base plus a constant offset; the object
// under a chain of ptradds is identified when it is an alloca or a global.
// Distinct identified objects never alias, an alloca whose address never
// escapes is not written by calls, no computed pointer reaches a noalias
// global (the shadow stack), and nothing writes a constant global.
// =============================================================================
import "combine.ax" as cb;
import "ir.ax" as ir;
import "opt.ax" as opt;
import "target.ax" as tg;
import "util.ax" as u;

fn vnil() *mut ir.Value {
    return u.nil.[ir.Value]();
}

const K_EXPR: i32 = 0;   // key: an instruction (representative), val: its value
const K_MEM: i32 = 1;    // key: base pointer, off, ty; val: the value in memory
const K_KNOWN: i32 = 2;  // key: a value, val: the constant it equals
const K_LE: i32 = 3;     // key <= val + off (unsigned, as natural numbers; val nil: 0)
const K_FILL: i32 = 4;   // key: base pointer, off; val: a memset of constant bytes there
const K_COPY: i32 = 5;   // key: base pointer, off: of the destination of val, a memcpy or memmove
const K_GE: i32 = 6;     // key >= off (unsigned, off a small constant)

struct Ent {
    kind: i32,
    key: *mut ir.Value,
    off: i64,
    ty: *mut ir.Ty,
    val: *mut ir.Value,
    height: usize,
    next: i64,
    bucket: usize,
}

const W_LOC: i32 = 0;   // a store / memory operation on one location
const W_CALL: i32 = 1;  // everything but non-escaping allocas
const W_ALL: i32 = 2;   // everything

struct Write {
    kind: i32,
    base: *mut ir.Value,
    obj: *mut ir.Value,
    off: i64,
    size: i64,  // -1: unknown
    rok: bool,
    rlo: i64,
    rhi: i64,
}

struct Loc {
    base: *mut ir.Value,
    obj: *mut ir.Value,  // alloca or global under the ptradds, or nil
    off: i64,            // from base
    size: i64,
    rok: bool,  // the offset from obj is known to lie in [rlo, rhi]
    rlo: i64,
    rhi: i64,
}

let mut ents: u.List.[Ent] = u.List.[Ent].{ data: @ptr_from_int(*mut Ent, 0), len: 0, cap: 0 };
let mut writes: u.List.[Write] = u.List.[Write].{ data: @ptr_from_int(*mut Write, 0), len: 0, cap: 0 };
let mut bk: u.List.[i64] = u.List.[i64].{ data: @ptr_from_int(*mut i64, 0), len: 0, cap: 0 };
let mut nb: usize = 0;
let mut B: *mut ir.Builder = @ptr_from_int(*mut ir.Builder, 0);
let mut changed: bool = false;
let mut g_fn: *mut ir.Func = @ptr_from_int(*mut ir.Func, 0);

// -----------------------------------------------------------------------------
// Hashing
// -----------------------------------------------------------------------------
fn hp(p: *ir.Value) u64 {
    let x = @as(u64, @int_from_ptr(p));
    return (x >> 4) *% 0x9E37_79B9_7F4A_7C15;
}

fn mix(h: u64, x: u64) u64 {
    return (h ^ x) *% 0x1000_0000_01B3 +% 0x7F4A_7C15;
}

// Operand identity: constants compare by value.
fn same_val(a: *ir.Value, b: *ir.Value) bool {
    if a == b {
        return true;
    }
    if u.isnil(a) or u.isnil(b) {
        return false;
    }
    if (a.kind == ir.V_CINT) and (b.kind == ir.V_CINT) {
        return (a.ty == b.ty) and (a.cv == b.cv);
    }
    if (a.kind == ir.V_ZERO) and (b.kind == ir.V_ZERO) {
        return a.ty == b.ty;
    }
    if (a.kind == ir.V_CFP) and (b.kind == ir.V_CFP) {
        return (a.ty == b.ty) and (@bit_cast(u64, a.fv) == @bit_cast(u64, b.fv));
    }
    return false;
}

fn hv(v: *ir.Value) u64 {
    if u.isnil(v) {
        return 7;
    }
    if v.kind == ir.V_CINT {
        return mix(@as(u64, @bit_cast(u32, v.ty.id)), v.cv);
    }
    if v.kind == ir.V_ZERO {
        return mix(@as(u64, @bit_cast(u32, v.ty.id)), 0x5a5a);
    }
    if v.kind == ir.V_CFP {
        return mix(@as(u64, @bit_cast(u32, v.ty.id)), @bit_cast(u64, v.fv));
    }
    return hp(v);
}

fn hash_expr(i: *ir.Value) u64 {
    let mut h = mix(@as(u64, @bit_cast(u32, i.op)), @as(u64, @bit_cast(u32, i.ty.id)));
    h = mix(h, i.cv);
    if ir.commutative(i.op) {
        h = mix(h, hv(i.a) +% hv(i.b));
    } else {
        h = mix(h, hv(i.a));
        h = mix(h, hv(i.b));
    }
    h = mix(h, hv(i.c));
    for k in 0..i.xs.len {
        h = mix(h, hv(i.xs.get(k)));
    }
    for k in 0..i.mask.len {
        h = mix(h, @as(u64, @bit_cast(u32, i.mask[k])));
    }
    return h;
}

fn same_expr(x: *ir.Value, y: *ir.Value) bool {
    if (x.op != y.op) or (x.ty != y.ty) or (x.cv != y.cv) or (x.xs.len != y.xs.len) or (x.mask.len != y.mask.len) {
        return false;
    }
    if not same_val(x.c, y.c) {
        return false;
    }
    let direct = same_val(x.a, y.a) and same_val(x.b, y.b);
    if not direct {
        if not ir.commutative(x.op) or not (same_val(x.a, y.b) and same_val(x.b, y.a)) {
            return false;
        }
    }
    for k in 0..x.xs.len {
        if not same_val(x.xs.get(k), y.xs.get(k)) {
            return false;
        }
    }
    for k in 0..x.mask.len {
        if x.mask[k] != y.mask[k] {
            return false;
        }
    }
    // operand types (e.g. casts of different source types)
    if u.notnil(x.a) and u.notnil(y.a) and (x.a.ty != y.a.ty) {
        return false;
    }
    return true;
}

fn push_ent(kind: i32, h: u64, key: *mut ir.Value, off: i64, ty: *mut ir.Ty, val: *mut ir.Value) void {
    let b = @truncate(usize, h) & (nb - 1);
    ents.push(Ent.{ kind: kind, key: key, off: off, ty: ty, val: val, height: writes.len, next: bk.get(b), bucket: b });
    bk.set(b, @int_cast(i64, ents.len) - 1);
}

fn pop_to(n: usize) void {
    while ents.len > n {
        let e = ents.pop();
        bk.set(e.bucket, e.next);
    }
}

fn find_expr(i: *ir.Value) *mut ir.Value {
    let h = hash_expr(i);
    let mut e = bk.get(@truncate(usize, h) & (nb - 1));
    while e >= 0 {
        let x = ents.at(@int_cast(usize, e));
        if (x.kind == K_EXPR) and same_expr(x.key, i) {
            return x.val;
        }
        e = x.next;
    }
    return vnil();
}

fn add_expr(key: *mut ir.Value, val: *mut ir.Value) void {
    push_ent(K_EXPR, hash_expr(key), key, 0, key.ty, val);
}

fn known_hash(v: *ir.Value) u64 {
    return mix(hp(v), 0x4b4e);
}

fn find_known(v: *mut ir.Value) *mut ir.Value {
    let h = known_hash(v);
    let mut e = bk.get(@truncate(usize, h) & (nb - 1));
    while e >= 0 {
        let x = ents.at(@int_cast(usize, e));
        if (x.kind == K_KNOWN) and (x.key == v) {
            return x.val;
        }
        e = x.next;
    }
    return vnil();
}

fn add_known(v: *mut ir.Value, c: *mut ir.Value) void {
    push_ent(K_KNOWN, known_hash(v), v, 0, v.ty, c);
}

fn mem_hash(base: *ir.Value, off: i64, ty: *ir.Ty) u64 {
    return mix(mix(hp(base), @bit_cast(u64, off)), @as(u64, @bit_cast(u32, ty.id)) +% 0x3131);
}

// -----------------------------------------------------------------------------
// Alias analysis
// -----------------------------------------------------------------------------
// The result of a call of the allocator: an object of its own.
fn fresh(v: *ir.Value) bool {
    if not ir.is_op(v, ir.OP_CALL) or (v.a.kind != ir.V_FUNC) {
        return false;
    }
    return v.a.fnp.allocator;
}

fn is_obj(v: *ir.Value) bool {
    return ir.is_op(v, ir.OP_ALLOCA) or (v.kind == ir.V_GLOBAL);
}

struct Range {
    ok: bool,
    lo: i64,
    hi: i64,
}

const RLIM: i64 = 0x4000_0000;

fn rng(lo: i64, hi: i64) Range {
    if (lo < -RLIM) or (hi > RLIM) or (lo > hi) {
        return Range.{ ok: false, lo: 0, hi: 0 };
    }
    return Range.{ ok: true, lo: lo, hi: hi };
}

// The values an integer offset expression can take (small ranges only).
fn range_of(v: *ir.Value, depth: i32) Range {
    if ir.is_cint(v) {
        let x = ir.sval(v);
        return rng(x, x);
    }
    let none = Range.{ ok: false, lo: 0, hi: 0 };
    if (depth > 6) or (v.kind != ir.V_INST) {
        return none;
    }
    let op = v.op;
    if (op == ir.OP_AND) and ir.is_cint(v.b) and (ir.sval(v.b) >= 0) {
        return rng(0, ir.sval(v.b));
    }
    if (op == ir.OP_ZEXT) or (op == ir.OP_SEXT) {
        let r = range_of(v.a, depth + 1);
        if r.ok and ((op == ir.OP_SEXT) or (r.lo >= 0)) {
            return r;
        }
        return none;
    }
    if (op == ir.OP_MUL) and ir.is_cint(v.b) {
        let c = ir.sval(v.b);
        let r = range_of(v.a, depth + 1);
        if r.ok and (c >= 0) and (c <= RLIM) {
            return rng(r.lo * c, r.hi * c);
        }
        return none;
    }
    if (op == ir.OP_SHL) and ir.is_cint(v.b) and (ir.cint_val(v.b) < 30) {
        let r = range_of(v.a, depth + 1);
        let k = @truncate(u32, ir.cint_val(v.b));
        if r.ok and (r.lo >= 0) {
            return rng(r.lo << k, r.hi << k);
        }
        return none;
    }
    if op == ir.OP_ADD {
        let x = range_of(v.a, depth + 1);
        let y = range_of(v.b, depth + 1);
        if x.ok and y.ok {
            return rng(x.lo + y.lo, x.hi + y.hi);
        }
    }
    return none;
}

fn loc_of(p0: *mut ir.Value, size: i64) Loc {
    let mut p = p0;
    let mut off: i64 = 0;
    while ir.is_op(p, ir.OP_PTRADD) and ir.is_cint(p.b) {
        off = off +% ir.sval(p.b);
        p = p.a;
    }
    let base = p;
    let mut r = rng(off, off);
    while ir.is_op(p, ir.OP_PTRADD) {
        if r.ok {
            let x = range_of(p.b, 0);
            if x.ok {
                r = rng(r.lo + x.lo, r.hi + x.hi);
            } else {
                r.ok = false;
            }
        }
        p = p.a;
    }
    let mut obj = vnil();
    if is_obj(p) {
        obj = p;
    } else if ir.is_op(p, ir.OP_INTTOPTR) and fresh(ir.resolve(p.a)) {
        obj = ir.resolve(p.a);
    } else if ir.is_op(p, ir.OP_SELECT) and noalias_global(p.b) {
        // wasm: the thread's shadow stack record, or the main thread's
        obj = p.b;
    }
    return Loc.{ base: base, obj: obj, off: off, size: size, rok: r.ok and u.notnil(obj), rlo: r.lo, rhi: r.hi };
}

// Where in the shadow stack record: 0 the depth, 2 the call site slots.
fn ss_field(l: *Loc) i32 {
    if not noalias_global(l.obj) or not l.rok or (l.size < 0) {
        return -1;
    }
    let t = l.obj.gv.ty;
    if (t.kind != ir.T_STRUCT) or (t.fields.len < 3) {
        return -1;
    }
    if (l.rlo == 0) and (l.rhi == 0) and (l.size == 4) {
        return 0;
    }
    let s = @bit_cast(i64, t.offs[2]);
    if (l.rlo >= s) and ((l.rhi + l.size) <= (s + @bit_cast(i64, t.fields[2].size))) {
        return 2;
    }
    return -1;
}

// Memory the program can only reach by the global's name (the shadow stack).
fn noalias_global(o: *ir.Value) bool {
    return u.notnil(o) and (o.kind == ir.V_GLOBAL) and o.gv.noalias;
}

// An alloca whose address is not visible to calls (aux2 == 1 after escapes()).
fn private_obj(o: *ir.Value) bool {
    return u.notnil(o) and ir.is_op(o, ir.OP_ALLOCA) and (o.aux2 == 1);
}

fn overlap(a: i64, an: i64, b: i64, bn: i64) bool {
    if (an < 0) or (bn < 0) {
        return true;
    }
    return (a < (b + bn)) and (b < (a + an));
}

fn may_alias(x: *Loc, w: *Write) bool {
    if u.notnil(x.obj) and (x.obj.kind == ir.V_GLOBAL) and x.obj.gv.is_const and not x.obj.gv.tls {
        return false;  // (constant data: nothing writes it)
    }
    if w.kind == W_ALL {
        return true;
    }
    if w.kind == W_CALL {
        return not private_obj(x.obj);
    }
    if x.base == w.base {
        return overlap(x.off, x.size, w.off, w.size);
    }
    if (x.size >= 0) and (w.size >= 0) and apart_mod(x, w) {
        return false;
    }
    if u.notnil(x.obj) and (x.obj == w.obj) and x.rok and w.rok and (x.size >= 0) and (w.size >= 0) {
        return overlap(x.rlo, (x.rhi - x.rlo) + x.size, w.rlo, (w.rhi - w.rlo) + w.size);
    }
    if u.notnil(x.obj) and u.notnil(w.obj) and (x.obj != w.obj) {
        return false;
    }
    // a pointer the function was given cannot point into its own stack
    // slots (they did not exist yet)
    if (u.notnil(x.obj) and ir.is_op(x.obj, ir.OP_ALLOCA) and from_param(w.base)) or
       (u.notnil(w.obj) and ir.is_op(w.obj, ir.OP_ALLOCA) and from_param(x.base)) {
        return false;
    }
    if (private_obj(x.obj) and (w.obj != x.obj)) or (private_obj(w.obj) and (x.obj != w.obj)) {
        return false;
    }
    if (noalias_global(x.obj) and (w.obj != x.obj)) or (noalias_global(w.obj) and (x.obj != w.obj)) {
        return false;
    }
    return true;
}

// Can the store st not write what the load ld reads? (Their objects differ,
// or the same address with offsets that do not overlap; what holds without
// the facts the passes record.)
pub fn store_apart(st: *mut ir.Value, ld: *mut ir.Value) bool {
    if (st.op != ir.OP_STORE) or (st.flags != 0) or (ld.op != ir.OP_LOAD) or (ld.flags != 0) {
        return false;
    }
    let l = loc_of(ld.a, @bit_cast(i64, ld.ty.size));
    let w = loc_of(st.b, @bit_cast(i64, st.a.ty.size));
    // (not the shadow stack's object, which loc_of takes from a select)
    if u.notnil(l.obj) and u.notnil(w.obj) and (l.obj != w.obj) and not noalias_global(l.obj) and
       not noalias_global(w.obj) {
        return true;
    }
    return (l.base == w.base) and not overlap(l.off, l.size, w.off, w.size);
}

// -----------------------------------------------------------------------------
// Addresses as a root plus an offset modulo a stride: p = root + off + k * m
// for some integer k (m == 0: exactly root + off). Constant offsets add to
// off; an offset that is a multiple of a constant, and a phi stepping by one
// from its start (an induction pointer), make m the gcd. Two addresses from
// one root whose offsets differ, modulo the stride, by more than their sizes
// cannot overlap: the fields of elements of one array of structs.
// -----------------------------------------------------------------------------
struct Strided {
    root: *mut ir.Value,
    off: i64,
    m: i64,
}

fn gcd(a0: i64, b0: i64) i64 {
    let mut a = a0;
    let mut b = b0;
    while b != 0 {
        let t = a % b;
        a = b;
        b = t;
    }
    return a;
}

// A constant c such that v is always a multiple of it (0: none known; 1 is
// as good as none).
fn multiple_of(v: *ir.Value, depth: i32) i64 {
    if ir.is_cint(v) {
        let x = ir.sval(v);
        if (x < 0) or (x > RLIM) {
            return 0;
        }
        return x;
    }
    if (depth > 4) or (v.kind != ir.V_INST) {
        return 0;
    }
    let op = v.op;
    if (op == ir.OP_MUL) and ir.is_cint(v.b) {
        let c = ir.sval(v.b);
        if (c > 0) and (c <= RLIM) {
            return c;
        }
        return 0;
    }
    if (op == ir.OP_SHL) and ir.is_cint(v.b) and (ir.cint_val(v.b) < 30) {
        return @as(i64, 1) << @truncate(u32, ir.cint_val(v.b));
    }
    if (op == ir.OP_ADD) or (op == ir.OP_SUB) {
        let a = multiple_of(v.a, depth + 1);
        let b = multiple_of(v.b, depth + 1);
        if (a > 0) and (b > 0) {
            return gcd(a, b);
        }
        if (a > 0) and ir.is_cint(v.b) and (ir.sval(v.b) == 0) {
            return a;
        }
        return 0;
    }
    if op == ir.OP_SEXT {
        return multiple_of(v.a, depth + 1);
    }
    return 0;
}

// The modulus with which p advances from phi ph back to itself through
// ptradds (-1: it does not lead back to ph).
fn step_to(p0: *ir.Value, ph: *ir.Value) i64 {
    let mut p = p0;
    let mut m: i64 = 0;
    let mut n: i32 = 0;
    while n < 8 {
        if p == ph {
            return m;
        }
        if not ir.is_op(p, ir.OP_PTRADD) {
            return -1;
        }
        if ir.is_cint(p.b) {
            let c = ir.sval(p.b);
            if (c < -RLIM) or (c > RLIM) {
                return -1;
            }
            m = gcd(m, @abs(c));
        } else {
            let k = multiple_of(p.b, 0);
            if k <= 0 {
                return -1;
            }
            m = gcd(m, k);
        }
        p = p.a;
        n += 1;
    }
    return -1;
}

fn strided_form(p0: *mut ir.Value, depth: i32) Strided {
    let mut p = p0;
    let mut off: i64 = 0;
    let mut m: i64 = 0;
    let mut n: i32 = 0;
    while n < 16 {
        n += 1;
        if ir.is_op(p, ir.OP_PTRADD) {
            if ir.is_cint(p.b) {
                let c = ir.sval(p.b);
                if (c < -RLIM) or (c > RLIM) {
                    break;
                }
                off += c;
            } else {
                let k = multiple_of(p.b, 0);
                if k <= 0 {
                    break;
                }
                m = gcd(m, k);
            }
            p = p.a;
            continue;
        }
        // an induction pointer: phi [start, ...], [step back to it, ...]
        if ir.is_op(p, ir.OP_PHI) and (p.xs.len == 2) and (depth < 3) {
            let mut start = vnil();
            let mut st: i64 = -1;
            for k in @as(usize, 0)..2 {
                let d = step_to(ir.resolve(p.xs.get(k)), p);
                if d > 0 {
                    st = d;
                    start = ir.resolve(p.xs.get(1 - k));
                }
            }
            if (st > 0) and u.notnil(start) and (start != p) {
                let s = strided_form(start, depth + 1);
                return Strided.{ root: s.root, off: s.off + off, m: gcd(gcd(m, s.m), st) };
            }
        }
        break;
    }
    return Strided.{ root: p, off: off, m: m };
}

// Can x and w be told apart as offsets from one root modulo a stride?
fn apart_mod(x: *Loc, w: *Write) bool {
    if u.isnil(x.base) or u.isnil(w.base) {
        return false;
    }
    if not ir.is_op(x.base, ir.OP_PTRADD) and not ir.is_op(x.base, ir.OP_PHI) and not ir.is_op(w.base, ir.OP_PTRADD) and
       not ir.is_op(w.base, ir.OP_PHI) {
        return false;
    }
    let a = strided_form(x.base, 0);
    let b = strided_form(w.base, 0);
    if a.root != b.root {
        return false;
    }
    let m = gcd(a.m, b.m);
    let xo = a.off + x.off;
    let wo = b.off + w.off;
    if m == 0 {
        return not overlap(xo, x.size, wo, w.size);
    }
    if (x.size + w.size) > m {
        return false;
    }
    let mut d = (wo - xo) % m;
    if d < 0 {
        d += m;
    }
    return (d >= x.size) and ((d + w.size) <= m);
}

// Is p a parameter, or computed from one by offsets?
fn from_param(p0: *ir.Value) bool {
    let mut p = p0;
    let mut n: i32 = 0;
    while u.notnil(p) and ir.is_op(p, ir.OP_PTRADD) and (n < 16) {
        p = p.a;
        n += 1;
    }
    return u.notnil(p) and (p.kind == ir.V_PARAM);
}

fn push_write(kind: i32, l: Loc) void {
    writes.push(Write.{ kind: kind, base: l.base, obj: l.obj, off: l.off, size: l.size, rok: l.rok, rlo: l.rlo,
                        rhi: l.rhi });
}

fn nowhere() Loc {
    return Loc.{ base: vnil(), obj: vnil(), off: 0, size: -1, rok: false, rlo: 0, rhi: 0 };
}

// Marks allocas whose address stays private (aux2 = 1): used only as the
// address of loads, stores and memory operations, or offset by ptradd.
// A call whose first argument is the address its result is stored at.
fn sret_call(i: *ir.Value) bool {
    return (i.xs.len > 0) and (i.ext.len > 1) and (i.ext[1] == ir.EXT_SRET);
}

fn escapes(f: *mut ir.Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.aux2 = 0;
            if i.op == ir.OP_ALLOCA {
                i.aux2 = 1;
            }
            i = i.next;
        }
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let op = i.op;
            if op == ir.OP_LOAD {
                // address use only
            } else if op == ir.OP_STORE {
                leak(i.a);
            } else if (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE) or (op == ir.OP_MEMSET) {
                leak(i.c);
                if op == ir.OP_MEMSET {
                    leak(i.b);
                }
            } else if op == ir.OP_PTRADD {
                leak(i.b);
            } else if op == ir.OP_ICMP {
                // comparing addresses does not reveal the object
            } else if (op == ir.OP_CALL) and sret_call(i) {
                // the result's memory: the callee only stores the result there
                leak(i.a);
                for k in 1..i.xs.len {
                    leak(i.xs.get(k));
                }
            } else {
                leak(i.a);
                leak(i.b);
                leak(i.c);
                for k in 0..i.xs.len {
                    leak(i.xs.get(k));
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    // ptradds of an alloca whose results escape
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if (i.op == ir.OP_PTRADD) and (i.aux2 == 2) {
                let mut p = i.a;
                while ir.is_op(p, ir.OP_PTRADD) {
                    p = p.a;
                }
                if ir.is_op(p, ir.OP_ALLOCA) {
                    p.aux2 = 0;
                }
            }
            i = i.next;
        }
        b = b.next;
    }
}

fn leak(v: *mut ir.Value) void {
    if u.isnil(v) or (v.kind != ir.V_INST) {
        return;
    }
    if v.op == ir.OP_ALLOCA {
        v.aux2 = 0;
    } else if v.op == ir.OP_PTRADD {
        v.aux2 = 2;  // resolved to its alloca afterwards
    }
}

// -----------------------------------------------------------------------------
// Effects
// -----------------------------------------------------------------------------
// x86-64's masked vector loads and stores (codegen.ax makes them for
// @load_partial and @store_partial): memory accesses at their pointer, of at
// most the vector's size.
fn partial_loc(i: *ir.Value) Loc {
    if ir.intr_id(i) == ir.IN_LOAD_PARTIAL {
        return loc_of(i.xs.get(0), @bit_cast(i64, i.ty.size));
    }
    return loc_of(i.xs.get(1), @bit_cast(i64, i.xs.get(0).ty.size));
}

// The pure operations (ir.OPF_PURE, ir.INF_PURE), but not the aggregate
// ones (extractvalue, insertvalue), which value numbering leaves alone.
fn cse_able(i: *ir.Value) bool {
    let op = i.op;
    if op == ir.OP_INTR {
        return ir.intr_pure(ir.intr_id(i));
    }
    return ir.op_pure(op) and (op != ir.OP_EXTRACTVALUE) and (op != ir.OP_INSERTVALUE);
}

fn size_of(n: *ir.Value) i64 {
    if ir.is_cint(n) {
        let x = ir.cint_val(n);
        if x < 0x4000_0000_0000_0000 {
            return @bit_cast(i64, x);
        }
    }
    return -1;
}

// The writes of instruction i (for region summaries and the walk).
fn note_writes(i: *mut ir.Value) void {
    let op = i.op;
    if op == ir.OP_STORE {
        if i.flags != 0 {
            push_write(W_ALL, nowhere());
        } else {
            push_write(W_LOC, loc_of(i.b, @bit_cast(i64, i.a.ty.size)));
        }
    } else if (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE) or (op == ir.OP_MEMSET) {
        push_write(W_LOC, loc_of(i.a, size_of(i.c)));
    } else if op == ir.OP_CALL {
        push_write(W_CALL, nowhere());
        if sret_call(i) {
            // (the result's slot, which calls do not otherwise write)
            push_write(W_LOC, loc_of(i.xs.get(0), -1));
        }
    } else if (op == ir.OP_RMW) or (op == ir.OP_CMPXCHG) or (op == ir.OP_FENCE) {
        push_write(W_ALL, nowhere());
    } else if (op == ir.OP_LOAD) and (i.flags != 0) {
        push_write(W_ALL, nowhere());
    } else if ir.intr_id(i) == ir.IN_STORE_PARTIAL {
        push_write(W_LOC, partial_loc(i));
    } else if ir.intr_opaque(ir.intr_id(i)) {
        push_write(W_ALL, nowhere());
    }
}

// Is the value at l (of type t) known? Returns it or nil.
fn find_mem(l: *Loc, t: *mut ir.Ty) *mut ir.Value {
    let h = mem_hash(l.base, l.off, t);
    let mut e = bk.get(@truncate(usize, h) & (nb - 1));
    while e >= 0 {
        let x = ents.at(@int_cast(usize, e));
        if (x.kind == K_MEM) and (x.key == l.base) and (x.off == l.off) and (x.ty == t) {
            // no possibly aliasing write since
            if (writes.len - x.height) > 256 {
                return vnil();
            }
            for w in x.height..writes.len {
                if may_alias(l, writes.at(w)) {
                    return vnil();
                }
            }
            return x.val;
        }
        e = x.next;
    }
    return vnil();
}

fn add_mem(l: *Loc, t: *mut ir.Ty, v: *mut ir.Value) void {
    push_ent(K_MEM, mem_hash(l.base, l.off, t), l.base, l.off, t, v);
}

fn fill_hash(base: *ir.Value) u64 {
    return mix(hp(base), 0x46494c4c);
}

// The byte (a constant) a memset filled the whole of l with, when nothing
// that may write l came since; else nil.
fn find_fill(l: *Loc) *mut ir.Value {
    let mut e = bk.get(@truncate(usize, fill_hash(l.base)) & (nb - 1));
    while e >= 0 {
        let x = ents.at(@int_cast(usize, e));
        if (x.kind == K_FILL) and (x.key == l.base) and (x.off <= l.off) and
           ((l.off + l.size) <= (x.off + size_of(x.val.c))) {
            if (writes.len - x.height) > 256 {
                return vnil();
            }
            for w in x.height..writes.len {
                if may_alias(l, writes.at(w)) {
                    return vnil();
                }
            }
            return x.val.b;
        }
        e = x.next;
    }
    return vnil();
}

// A vector load whose lanes are known, each stored as a scalar or filled
// by a memset since (an array of floats written element by element and
// read as one vector): the vector built from them, else nil.
fn compose_load(i: *mut ir.Value, l: *Loc) *mut ir.Value {
    let t = i.ty;
    let et = t.elem;
    if (t.kind != ir.T_VEC) or ((et.kind != ir.T_INT) and (et.kind != ir.T_FLOAT)) or (t.lanes > 16) or (l.size < 0) {
        return vnil();
    }
    let n = @int_cast(usize, t.lanes);
    let es = @bit_cast(i64, et.size);
    let vals = u.newn.[*mut ir.Value](n);
    let mut nset: usize = 0;
    let mut fill = vnil();
    for j in 0..n {
        let mut lj = l.*;
        lj.off = l.off + (@int_cast(i64, j) * es);
        lj.size = es;
        lj.rlo = l.rlo + (@int_cast(i64, j) * es);
        lj.rhi = l.rhi + (@int_cast(i64, j) * es);
        let v = find_mem(&lj, et);
        if u.notnil(v) {
            vals[j] = v;
            nset += 1;
            continue;
        }
        let b = find_fill(&lj);
        if u.isnil(b) or not ir.is_cint(b) or ((ir.cint_val(b) & 0xff) != 0) {
            return vnil();  // (zero fills only: a float of other bytes is not built here)
        }
        fill = b;
    }
    if (nset == 0) or (nset > 8) or u.isnil(fill) {
        return vnil();  // (all from stores: not built from parts here)
    }
    ir.at_before(B, i);
    let mut v = ir.splat(B, t, ir.czero(et));
    for j in 0..n {
        if u.notnil(vals[j]) {
            v = ir.insert_elem(B, v, vals[j], @as(u64, j));
        }
    }
    changed = true;
    return v;
}

// A vector load of what is known at l as a vector of other lanes of the same
// size (the bytes of a board loaded to compare them and again as 64-bit
// words to add them up), or a scalar load of what is known there as an
// integer or float of its size: that, bitcast; or nil.
// An integer loaded from within a wider integer stored before (a field of
// a small struct copied through the stack as one word): that value's bytes,
// shifted down and truncated (the targets are little-endian).
fn narrowed_load(i: *mut ir.Value, l: *Loc) *mut ir.Value {
    let size = @bit_cast(i64, i.ty.size);
    if (i.ty.kind != ir.T_INT) or (size >= 8) or (@as(i64, i.ty.bits) != (size * 8)) {
        return vnil();
    }
    let mut w: i64 = size * 2;
    while w <= 8 {
        // (the wider value starting at a multiple of the load's size before it)
        let mut d: i64 = 0;
        while (d + size) <= w {
            let wl = Loc.{ base: l.base, obj: l.obj, off: l.off - d, size: w, rok: l.rok, rlo: l.rlo - d,
                           rhi: l.rhi - d };
            let x = find_mem(&wl, ir.t_int(@truncate(i32, w * 8)));
            if u.notnil(x) {
                if u.isnil(B) {
                    B = ir.new_builder();
                }
                ir.at_before(B, i);
                let mut v = x;
                if d > 0 {
                    v = ir.binop(B, ir.OP_LSHR, v, ir.cint(x.ty, @bit_cast(u64, d * 8)));
                }
                return ir.trunc(B, v, i.ty);
            }
            d += size;
        }
        w = w * 2;
    }
    return vnil();
}

fn punned_load(i: *mut ir.Value, l: *Loc) *mut ir.Value {
    let size = i.ty.size;
    if i.ty.kind != ir.T_VEC {
        // a float's bits loaded as an integer before, or the reverse
        if (i.ty.bits != 32) and (i.ty.bits != 64) {
            return vnil();
        }
        let mut o = ir.t_float(i.ty.bits);
        if i.ty.kind == ir.T_FLOAT {
            o = ir.t_int(i.ty.bits);
        }
        let x = find_mem(l, o);
        if u.isnil(x) {
            return vnil();
        }
        if u.isnil(B) {
            B = ir.new_builder();
        }
        ir.at_before(B, i);
        return ir.bitcast(B, x, i.ty);
    }
    for k in @as(i32, 0)..6 {
        let mut lane = ir.t_float(64);
        if k < 4 {
            lane = ir.t_int(@as(i32, 8) << @as(u32, @bit_cast(u32, k)));
        } else if k == 4 {
            lane = ir.t_float(32);
        }
        if (lane.size > size) or ((size % lane.size) != 0) {
            continue;
        }
        let t = ir.t_vec(lane, @truncate(u32, size / lane.size));
        if t == i.ty {
            continue;
        }
        let x = find_mem(l, t);
        if u.notnil(x) {
            if u.isnil(B) {
                B = ir.new_builder();
            }
            ir.at_before(B, i);
            return ir.bitcast(B, x, i.ty);
        }
    }
    return vnil();
}

// -----------------------------------------------------------------------------
// Loads of what a memcpy (or memmove) of a constant size put in memory read
// its source instead, when nothing has written either since: a buffer that is
// zeroed, filled from elsewhere and loaded as vectors (a padded array)
// otherwise goes through the stack, its loads straddling the copy's stores
// (which the processor cannot forward). A load that ends in a zeroed tail
// (memset 0) past the copied bytes is the copy's last bytes, shifted down
// with zeros (a byte shift).
// -----------------------------------------------------------------------------
fn copy_hash(base: *ir.Value) u64 {
    return mix(hp(base), 0x434f_5059);
}

fn note_copy(i: *mut ir.Value) void {
    let n = size_of(i.c);
    if (n <= 0) or (i.flags != 0) {
        return;
    }
    let l = loc_of(i.a, n);
    push_ent(K_COPY, copy_hash(l.base), l.base, l.off, i.ty, i);
}

// Has nothing written l since the write list was h long?
fn quiet_since(h: usize, l: *Loc) bool {
    if (writes.len - h) > 256 {
        return false;
    }
    for w in h..writes.len {
        if may_alias(l, writes.at(w)) {
            return false;
        }
    }
    return true;
}

fn sub_loc(l: *Loc, off: i64, size: i64) Loc {
    return Loc.{ base: l.base, obj: l.obj, off: l.off + off, size: size, rok: l.rok, rlo: l.rlo + off,
                 rhi: l.rhi + off };
}

// The value of load i (at l) from its copy's source, or nil.
fn forward_copy(i: *mut ir.Value, l: *Loc) *mut ir.Value {
    let t = i.ty;
    let size = l.size;
    if (size <= 0) or ((t.kind != ir.T_INT) and (t.kind != ir.T_FLOAT) and (t.kind != ir.T_VEC)) {
        return vnil();
    }
    let mut e = bk.get(@truncate(usize, copy_hash(l.base)) & (nb - 1));
    while e >= 0 {
        let x = ents.at(@int_cast(usize, e));
        e = x.next;
        if (x.kind != K_COPY) or (x.key != l.base) {
            continue;
        }
        let c = x.val;
        let n = size_of(c.c);
        let end = x.off + n;
        if (l.off < x.off) or (l.off >= end) or (n < size) {
            continue;
        }
        let head = @min(l.off + size, end) - l.off;  // bytes from the copy
        let hl = sub_loc(l, 0, head);
        if not quiet_since(x.height, &hl) {
            return vnil();
        }
        // the source bytes the load reads: [from, from + size)
        let mut from = l.off - x.off;
        let tail = size - head;
        if tail > 0 {
            from = n - size;
            if (t.kind != ir.T_VEC) or ((tail % @bit_cast(i64, t.elem.size)) != 0) or
               not zero_since(sub_loc(l, head, tail)) {
                return vnil();
            }
        }
        let src = loc_of(c.b, n);
        let sl = sub_loc(&src, from, size);
        let dw = Write.{ kind: W_LOC, base: l.base, obj: l.obj, off: x.off, size: n, rok: false, rlo: 0, rhi: 0 };
        if may_alias(&sl, &dw) or not quiet_since(x.height, &sl) {
            return vnil();
        }
        let bld = ir.new_builder();
        ir.at_before(bld, i);
        let ld = ir.load(bld, t, ir.ptradd(bld, c.b, ir.cint(ir.isz(), @bit_cast(u64, from))));
        ld.align = 1;
        if tail == 0 {
            return ld;
        }
        // lanes from the copy's last bytes, then zeros
        let lanes = @int_cast(i32, t.lanes);
        let sh = @int_cast(i32, tail / @bit_cast(i64, t.elem.size));
        let mask = u.newn.[i32](@int_cast(usize, lanes) + 1)[0..@int_cast(usize, lanes)];
        for k in @as(i32, 0)..lanes {
            if (k + sh) < lanes {
                mask[@int_cast(usize, k)] = k + sh;
            } else {
                mask[@int_cast(usize, k)] = lanes;
            }
        }
        return ir.shuffle(bld, ld, ir.czero(t), mask);
    }
    return vnil();
}

// Is l zero, set by a memset of 0 with nothing written there since?
fn zero_since(l: Loc) bool {
    let b = find_fill(&l);
    return u.notnil(b) and ir.is_cint(b) and ((ir.cint_val(b) & 0xff) == 0);
}

// -----------------------------------------------------------------------------
// Conditions
// -----------------------------------------------------------------------------
// Comparisons made up as keys for facts and queries: a pool that each run
// of gvn starts again (the table they go in is cleared too).
let mut synth: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0,
                                                                 cap: 0 };
let mut n_synth: usize = 0;

fn synth_icmp(p: i32, a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    if n_synth == synth.len {
        synth.push(u.new.[ir.Value]());
    }
    let v = synth.get(n_synth);
    n_synth += 1;
    v.kind = ir.V_INST;
    v.op = ir.OP_ICMP;
    v.ty = ir.t_int(1);
    v.cv = @as(u64, @bit_cast(u32, p));
    v.a = a;
    v.b = b;
    return v;
}

// c is known to be `val` in the current scope.
fn assume(c: *mut ir.Value, val: bool, depth: i32) void {
    if (depth > 4) or ir.is_const(c) {
        return;
    }
    add_known(c, ir.kbool(val));
    if c.kind != ir.V_INST {
        return;
    }
    if (c.op == ir.OP_ICMP) and (c.ty.kind == ir.T_INT) {
        let p = ir.pred_of(c);
        let mut tp = p;  // the predicate that holds
        if not val {
            tp = ir.inv_pred(p);
        }
        assume_bounds(tp, c.a, c.b);
        add_expr(synth_icmp(tp, c.a, c.b), ir.kbool(true));
        add_expr(synth_icmp(ir.inv_pred(tp), c.a, c.b), ir.kbool(false));
        add_expr(synth_icmp(ir.swap_pred(tp), c.b, c.a), ir.kbool(true));
        add_expr(synth_icmp(ir.inv_pred(ir.swap_pred(tp)), c.b, c.a), ir.kbool(false));
        // x > K is x >= K + 1, x >= K is x > K - 1, and so on
        if ir.is_cint(c.b) and not ir.is_const(c.a) {
            assume_adjacent(tp, c.a, c.b);
        }
        // x == K: x is K
        if (tp == ir.IntEQ) and ir.is_const(c.b) and not ir.is_const(c.a) {
            add_known(c.a, c.b);
        }
        // x == y: the later of them is the earlier (the lengths of slices
        // known to be equal: then their bounds checks are the same)
        if (tp == ir.IntEQ) and not ir.is_const(c.a) and not ir.is_const(c.b) and (c.a != c.b) {
            let ra = def_rank(c.a);
            let rb = def_rank(c.b);
            if (ra != NO_RANK) and (rb != NO_RANK) {
                if ra < rb {
                    add_known(c.b, c.a);
                } else if rb < ra {
                    add_known(c.a, c.b);
                }
            }
        }
        return;
    }
    if (c.op == ir.OP_AND) and val and (c.ty.bits == 1) {
        assume(c.a, true, depth + 1);
        assume(c.b, true, depth + 1);
    } else if (c.op == ir.OP_OR) and not val and (c.ty.bits == 1) {
        assume(c.a, false, depth + 1);
        assume(c.b, false, depth + 1);
    } else if (c.op == ir.OP_XOR) and (c.ty.bits == 1) and ir.is_cint(c.b) {
        assume(c.a, val != (ir.cint_val(c.b) != 0), depth + 1);
    }
}

// The fact x tp k as the same comparison with the neighbouring constant:
// x > k as x >= k + 1, x >= k as x > k - 1, x < k as x <= k - 1, x <= k as
// x < k + 1 (signed or unsigned), where k +- 1 does not wrap.
fn assume_adjacent(tp: i32, x: *mut ir.Value, k: *mut ir.Value) void {
    let t = k.ty;
    let bits = t.bits;
    if (t.kind != ir.T_INT) or (bits > 64) {
        return;
    }
    let all = ir.mask_bits(bits);
    let kc = ir.cint_val(k) & all;
    let smax = all >> 1;
    let smin = smax + 1;
    let mut np: i32 = -1;
    let mut nk: u64 = 0;
    if ((tp == ir.IntSGT) and (kc != smax)) or ((tp == ir.IntUGT) and (kc != all)) {
        np = tp + 1;  // ge
        nk = (kc + 1) & all;
    } else if ((tp == ir.IntSGE) and (kc != smin)) or ((tp == ir.IntUGE) and (kc != 0)) {
        np = tp - 1;  // gt
        nk = (kc -% 1) & all;
    } else if ((tp == ir.IntSLT) and (kc != smin)) or ((tp == ir.IntULT) and (kc != 0)) {
        np = tp + 1;  // le
        nk = (kc -% 1) & all;
    } else if ((tp == ir.IntSLE) and (kc != smax)) or ((tp == ir.IntULE) and (kc != all)) {
        np = tp - 1;  // lt
        nk = (kc + 1) & all;
    }
    if np < 0 {
        return;
    }
    let c = ir.cint(t, nk);
    add_expr(synth_icmp(np, x, c), ir.kbool(true));
    add_expr(synth_icmp(ir.inv_pred(np), x, c), ir.kbool(false));
}

const NO_RANK: i64 = 0x7fff_ffff_ffff_ffff;

// An order of values for replacing one by another known equal: parameters
// first, then instructions by number (the replacement is never replaced
// back, whichever comparison says they are equal).
fn def_rank(v: *ir.Value) i64 {
    if v.kind == ir.V_PARAM {
        return @bit_cast(i64, v.cv) - 0x1_0000_0000;
    }
    if v.kind == ir.V_INST {
        return @as(i64, v.id);
    }
    return NO_RANK;
}

// -----------------------------------------------------------------------------
// Unsigned bounds: facts x <= y + c between values (and constants), from the
// dominating conditions and from how values are computed; a comparison that
// they decide is folded (bounds checks implied by loop conditions, a < mid
// and mid <= n giving a < n, and so on).
// -----------------------------------------------------------------------------
fn le_hash(v: *ir.Value) u64 {
    return mix(hp(v), 0x4c45);
}

// x <= y + c (y nil: x <= c)
fn add_le(x: *mut ir.Value, y: *mut ir.Value, c: i64) void {
    if ir.is_const(x) {
        return;
    }
    push_ent(K_LE, le_hash(x), x, c, x.ty, y);
}

fn ge_hash(v: *ir.Value) u64 {
    return mix(hp(v), 0x4745);
}

// x >= c (unsigned): a lower bound, which decides x >= c' for c' <= c
fn add_ge(x: *mut ir.Value, c: i64) void {
    if ir.is_const(x) or (c <= 0) {
        return;
    }
    push_ent(K_GE, ge_hash(x), x, c, x.ty, vnil());
}

fn small_k(v: *ir.Value) bool {
    return ir.is_cint(v) and (v.ty.kind == ir.T_INT) and (ir.cint_val(v) < 0x4000_0000_0000_0000);
}

fn kv(v: *ir.Value) i64 {
    return @bit_cast(i64, ir.cint_val(v));
}

// x - lo < n (a range check, as x + -lo): x is in [lo, lo + n - 1] when
// that does not wrap.
fn assume_range(a: *mut ir.Value, n: u64) void {
    if not ir.is_op(a, ir.OP_ADD) and not ir.is_op(a, ir.OP_SUB) {
        return;
    }
    let x = ir.resolve(a.a);
    let k = ir.resolve(a.b);
    if not ir.is_cint(k) or ir.is_const(x) {
        return;
    }
    let m = ir.mask_bits(x.ty.bits);
    let mut lo = ir.cint_val(k);
    if a.op == ir.OP_ADD {
        lo = (0 -% lo) & m;
    }
    if (lo == 0) or (lo > (m - (n - 1))) or ((lo + (n - 1)) >= 0x4000_0000_0000_0000) {
        return;
    }
    add_le(x, vnil(), @bit_cast(i64, lo + (n - 1)));
    add_ge(x, @bit_cast(i64, lo));
    add_expr(synth_icmp(ir.IntUGE, x, ir.cint(x.ty, lo)), ir.kbool(true));
    add_expr(synth_icmp(ir.IntNE, x, ir.cint(x.ty, 0)), ir.kbool(true));
}

// a <= b + c with a = x + k (k a small constant, the sum not wrapping):
// x <= b + c - k, a fact about x itself (a block of k elements from x
// tested against a length: x is within it too, and so is x + j for j <= k).
let mut sum_le_busy: bool = false;

fn assume_sum_le(a: *mut ir.Value, b: *mut ir.Value, c: i64) void {
    if not ir.is_op(a, ir.OP_ADD) or not small_k(a.b) or ir.is_const(a.a) or (a.ty.bits > 64) {
        return;
    }
    let k = kv(a.b);
    if (k < 1) or (k >= 0x1_0000_0000) {
        return;
    }
    if sum_le_busy {
        return;  // (ub follows phis, assuming their edges' conditions)
    }
    sum_le_busy = true;
    let saved = prove_budget;
    prove_budget = 64;
    let m = ub(a.a, 0);
    prove_budget = 64;
    // (below_max answers for 64-bit values only)
    let ok = ((m >= 0) and fits_type(m + k, a.ty)) or ((a.ty.bits == 64) and below_max(a.a, k, 0));
    prove_budget = saved;
    sum_le_busy = false;
    if ok {
        add_le(a.a, b, c - k);
    }
}

// Is a >= k (unsigned, k >= 0)? From the facts: n - x >= k when x <= n - k,
// s * c >= k when s >= k / c (rounded up) and the product cannot wrap.
fn at_least(a: *mut ir.Value, k: i64, depth: i32) bool {
    if k <= 0 {
        return true;
    }
    if small_k(a) {
        return kv(a) >= k;
    }
    if (depth > 3) or (a.ty.kind != ir.T_INT) or (a.ty.bits > 64) or (k >= 0x1_0000_0000) {
        return false;
    }
    if known_at_least(a, k) {
        return true;
    }
    if ir.is_op(a, ir.OP_SUB) and not ir.is_const(a.a) and not ir.is_const(a.b) {
        return prove_le(a.b, a.a, 0 - k);  // (then x <= n: no wrap)
    }
    // x - d (or x + -d) with x >= k + d: no wrap, and at least k
    let mut d: i64 = 0;
    if ir.is_op(a, ir.OP_ADD) and ir.is_cint(ir.resolve(a.b)) {
        d = @bit_cast(i64, (0 -% ir.cint_val(ir.resolve(a.b))) & ir.mask_bits(a.ty.bits));
    } else if ir.is_op(a, ir.OP_SUB) and small_k(ir.resolve(a.b)) {
        d = kv(ir.resolve(a.b));
    }
    if (d >= 1) and (d < 0x1_0000_0000) {
        return at_least(ir.resolve(a.a), k + d, depth + 1);
    }
    // x + j (j >= 1) that does not wrap: at least j, and at least k when x >= k - j
    if ir.is_op(a, ir.OP_ADD) and small_k(ir.resolve(a.b)) and (kv(ir.resolve(a.b)) >= 1) and
       (kv(ir.resolve(a.b)) < 0x1_0000_0000) and (a.ty.bits == 64) {
        let j = kv(ir.resolve(a.b));
        let saved = prove_budget;
        prove_budget = 64;
        let nowrap = below_max(ir.resolve(a.a), j, 0);
        prove_budget = saved;
        if nowrap {
            return (j >= k) or at_least(ir.resolve(a.a), k - j, depth + 1);
        }
    }
    if ir.is_op(a, ir.OP_ZEXT) {
        return at_least(ir.resolve(a.a), k, depth + 1);
    }
    let mut c: i64 = 0;
    if ir.is_op(a, ir.OP_MUL) and small_k(a.b) {
        c = kv(a.b);
    } else if ir.is_op(a, ir.OP_SHL) and small_k(a.b) and (kv(a.b) < 32) {
        c = @as(i64, 1) << @truncate(u32, kv(a.b));
    }
    if (c < 1) or (c >= 0x1_0000_0000) {
        return false;
    }
    let s = a.a;
    prove_budget = 64;
    let mut m = ub(s, 0);
    if (m < 0) and ir.is_op(s, ir.OP_SUB) and prove_le(s.b, s.a, 0) {
        prove_budget = 64;
        m = ub(s.a, 0);  // n - x <= n when x <= n
    }
    if (m < 0) or (m >= 0x1_0000_0000) or not fits_type(m * c, a.ty) {
        return false;
    }
    return at_least(s, (k + c - 1) / c, depth + 1);
}

// Unsigned comparison facts: tp holds for (a, b).
fn assume_bounds(tp: i32, a: *mut ir.Value, b: *mut ir.Value) void {
    if (a.ty.kind != ir.T_INT) or (a.ty.bits > 64) {
        return;
    }
    if tp == ir.IntULT {
        if small_k(b) {
            if kv(b) >= 1 {
                add_le(a, vnil(), kv(b) - 1);
                assume_range(a, ir.cint_val(b));
            }
        } else if not ir.is_const(b) {
            add_le(a, b, -1);
            assume_sum_le(a, b, -1);
            if small_k(a) {
                add_ge(b, kv(a) + 1);  // k < b
            }
        }
    } else if tp == ir.IntULE {
        if small_k(b) {
            add_le(a, vnil(), kv(b));
        } else if not ir.is_const(b) {
            add_le(a, b, 0);
            assume_sum_le(a, b, 0);
            if small_k(a) {
                add_ge(b, kv(a));  // k <= b
            }
        }
    } else if (tp == ir.IntUGT) or (tp == ir.IntUGE) {
        let sw = ir.swap_pred(tp);
        if not ir.is_const(b) {
            assume_bounds(sw, b, a);
        } else if small_k(b) {
            add_ge(a, kv(b) + pick1(tp == ir.IntUGT));  // a > k, a >= k
        }
    } else if tp == ir.IntEQ {
        if not ir.is_const(a) and not ir.is_const(b) {
            add_le(a, b, 0);
            add_le(b, a, 0);
        }
    } else if (tp >= ir.IntSGT) and (tp <= ir.IntSLE) and ir.is_cint(a) and not ir.is_const(b) {
        assume_bounds(ir.swap_pred(tp), b, a);
    } else if ((tp == ir.IntSGT) or (tp == ir.IntSGE)) and ir.is_cint(b) and not ir.is_const(a) {
        // a >= lo >= 0 (signed): a is not negative, and at least lo
        let lo = ir.sval(b) + pick1(tp == ir.IntSGT);
        if lo >= 0 {
            add_expr(synth_icmp(ir.IntSGE, a, ir.cint(a.ty, 0)), ir.kbool(true));
            add_expr(synth_icmp(ir.IntUGE, a, ir.cint(a.ty, @bit_cast(u64, lo))), ir.kbool(true));
            if lo >= 1 {
                add_expr(synth_icmp(ir.IntNE, a, ir.cint(a.ty, 0)), ir.kbool(true));
            }
        }
    } else if ((tp == ir.IntSLT) or (tp == ir.IntSLE)) and ir.is_cint(b) and not ir.is_const(a) {
        // a <= hi (signed) with a not negative: a <= hi
        let hi = ir.sval(b) - pick1(tp == ir.IntSLT);
        if (hi >= 0) and known_true(synth_icmp(ir.IntSGE, a, ir.cint(a.ty, 0))) {
            add_le(a, vnil(), hi);
        }
        // k - x <= hi with x in [0, ub(x)] (no signed overflow): x >= k - hi
        if ir.is_op(a, ir.OP_SUB) and small_k(a.a) and not ir.is_const(a.b) and (kv(a.a) <= smax_of(a.ty)) and
           (hi > -0x4000_0000_0000_0000) {
            prove_budget = 64;
            let m = ub(a.b, 0);
            let lo = kv(a.a) - hi;
            if (m >= 0) and (m <= smax_of(a.ty)) and (lo >= 1) and (lo <= m) {
                add_expr(synth_icmp(ir.IntUGE, a.b, ir.cint(a.ty, @bit_cast(u64, lo))), ir.kbool(true));
                add_expr(synth_icmp(ir.IntNE, a.b, ir.cint(a.ty, 0)), ir.kbool(true));
            }
        }
    }
}

// Is x != 0 (or x >= c) known here?
fn known_at_least(x: *mut ir.Value, c: i64) bool {
    if small_k(x) {
        return kv(x) >= c;
    }
    if c <= 0 {
        return true;
    }
    if c == 1 {
        if known_true(synth_icmp(ir.IntNE, x, ir.cint(x.ty, 0))) {
            return true;
        }
    }
    if known_true(synth_icmp(ir.IntUGE, x, ir.cint(x.ty, @bit_cast(u64, c)))) {
        return true;
    }
    if ge_fact(x, c) {
        return true;
    }
    // x >= c - 1 and x != c - 1
    if (c >= 2) and known_true(synth_icmp(ir.IntNE, x, ir.cint(x.ty, @bit_cast(u64, c - 1)))) and
       known_at_least(x, c - 1) {
        return true;
    }
    if ir.is_op(x, ir.OP_PHI) and (x.ty.kind == ir.T_INT) and (x.ty.bits <= 64) and (c < 0x1_0000_0000) {
        return phi_at_least(x, c);
    }
    return false;
}

// A lower bound fact x >= k with k >= c.
fn ge_fact(x: *mut ir.Value, c: i64) bool {
    let mut e = bk.get(@truncate(usize, ge_hash(x)) & (nb - 1));
    while e >= 0 {
        let en = ents.at(@int_cast(usize, e));
        if (en.kind == K_GE) and (en.key == x) and fact_ok(e) and (en.off >= c) {
            return true;
        }
        e = en.next;
    }
    return false;
}

// The loop phis whose lower bounds are being proved by induction.
let mut ind_ge: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0,
                                                                  cap: 0 };

// Is phi x >= c (c >= 1)? When each incoming value is, under its edge's
// condition; the values that come around a loop by induction: with x assumed
// at least c, proved with the facts known at the back edge (those of the
// scope hold for this iteration's values) and the edge's condition (a loop
// counter counting up from 1, or down from a value at least 1 and leaving
// at 1).
fn phi_at_least(x: *mut ir.Value, c: i64) bool {
    if (x.xs.len > 4) or (ind_ge.len >= 2) {
        return false;
    }
    for k in 0..ind_ge.len {
        if ind_ge.get(k) == x {
            return false;
        }
    }
    let mut loops = false;
    for k in 0..x.xs.len {
        let v = x.xs.get(k);
        let p = x.bs.get(k);
        if v == x {
            continue;
        }
        if (p.rpo < 0) or (p.rpo >= x.blk.rpo) {
            loops = true;
            continue;
        }
        let mark = ents.len;
        edge_assume(p, x.blk);
        path_assume(p);
        let ok = at_least(v, c, 1);
        pop_to(mark);
        if not ok {
            return false;
        }
    }
    if not loops {
        return true;
    }
    let lo0 = fact_lo;
    let hi0 = fact_hi;
    ind_ge.push(x);
    let mut ok = true;
    for k in 0..x.xs.len {
        let v = x.xs.get(k);
        let p = x.bs.get(k);
        if (v == x) or not ((p.rpo < 0) or (p.rpo >= x.blk.rpo)) {
            continue;
        }
        let mut lo = ents.len;
        if p.rpo >= 0 {
            lo = facts_at(p);
        }
        if (hi0 > lo0) and (lo0 < lo) {
            lo = lo0;
        }
        fact_lo = lo;
        fact_hi = ents.len;
        let mark = ents.len;
        add_ge(x, c);
        edge_assume(p, x.blk);
        path_assume(p);
        ok = at_least(v, c, 1);
        pop_to(mark);
        if not ok {
            break;
        }
    }
    _ = ind_ge.pop();
    fact_lo = lo0;
    fact_hi = hi0;
    return ok;
}

// Is the comparison i known to hold (by a fact fact_ok allows)?
fn known_true(i: *ir.Value) bool {
    let h = hash_expr(i);
    let mut e = bk.get(@truncate(usize, h) & (nb - 1));
    while e >= 0 {
        let x = ents.at(@int_cast(usize, e));
        if (x.kind == K_EXPR) and same_expr(x.key, i) {
            return fact_ok(e) and ir.is_cint(x.val) and (ir.cint_val(x.val) == 1);
        }
        e = x.next;
    }
    return false;
}

let mut prove_budget: i32 = 0;

// Is x <= y + bound (y nil: x <= bound)? acc is the weight so far.
fn le_path(x: *mut ir.Value, y: *mut ir.Value, bound: i64, depth: i32) bool {
    if x == y {
        return bound >= 0;
    }
    if u.isnil(y) and small_k(x) {
        return kv(x) <= bound;
    }
    if u.isnil(x) {
        return bound >= 0;  // 0 <= y + bound
    }
    if small_k(x) and (y.ty.kind == ir.T_INT) and (y.ty.bits <= 64) {
        // k <= y + bound: y >= k - bound
        let need = kv(x) - bound;
        return (need <= 0) or ((need < 0x1_0000_0000) and known_at_least(y, need));
    }
    if (depth > 5) or (prove_budget <= 0) {
        return false;
    }
    prove_budget -= 1;
    // stored facts x <= w + c
    let mut e = bk.get(@truncate(usize, le_hash(x)) & (nb - 1));
    while e >= 0 {
        let en = ents.at(@int_cast(usize, e));
        if (en.kind == K_LE) and (en.key == x) and fact_ok(e) {
            if le_path(en.val, y, bound - en.off, depth + 1) {
                return true;
            }
        }
        e = en.next;
    }
    if x.kind != ir.V_INST {
        return false;
    }
    // facts from x's definition
    let op = x.op;
    if op == ir.OP_PHI {
        return phi_le(x, y, bound, depth);
    }
    if (op == ir.OP_LSHR) or (op == ir.OP_UDIV) {
        return le_path(x.a, y, bound, depth + 1);
    }
    if (op == ir.OP_SELECT) and (x.a.ty.kind == ir.T_INT) {
        // each arm under its condition (min(a, b) <= a and <= b)
        let mark = ents.len;
        assume(x.a, true, 0);
        let ok = le_path(x.b, y, bound, depth + 1);
        pop_to(mark);
        if not ok {
            return false;
        }
        assume(x.a, false, 0);
        let ok2 = le_path(x.c, y, bound, depth + 1);
        pop_to(mark);
        return ok2;
    }
    if op == ir.OP_AND {
        if small_k(x.b) and le_path(vnil(), y, bound - kv(x.b), depth + 1) {
            return true;
        }
        return le_path(x.a, y, bound, depth + 1);
    }
    if (op == ir.OP_ZEXT) or (op == ir.OP_TRUNC) {
        return le_path(x.a, y, bound, depth + 1);  // (truncation only lowers it)
    }
    if (op == ir.OP_UREM) and not ir.is_const(x.b) {
        return le_path(x.b, y, bound + 1, depth + 1);
    }
    if (op == ir.OP_ADD) and ir.is_cint(x.b) and (x.ty.bits <= 64) and (x.ty.bits > 1) {
        let c = ir.cint_val(x.b);
        let half = ir.mask_bits(x.ty.bits) >> 1;
        if c <= half {
            if c < 0x1_0000_0000 {
                return le_path(x.a, y, bound - @bit_cast(i64, c), depth + 1);  // a + c wraps only down
            }
            return false;
        }
        // a - d, exact when a >= d
        let d = (ir.mask_bits(x.ty.bits) - c) + 1;
        if (d < 0x1_0000_0000) and known_at_least(x.a, @bit_cast(i64, d)) {
            return le_path(x.a, y, bound + @bit_cast(i64, d), depth + 1);
        }
    }
    return false;
}

fn pick1(c: bool) i64 {
    if c {
        return 1;
    }
    return 0;
}

// A phi is bounded when every incoming value is, at the end of its block
// with the condition of the edge (the facts in scope hold there too: they
// come from branches every path to the phi's block goes through).
//
// The values that come around a loop are bounded by induction: with x
// assumed at most y + bound, each must be too, proved with the facts known
// at the back edge (those of the scope hold for this iteration's values) and
// the edge's condition (a counter counting down from below a length). y must
// be the same in every iteration: defined before the loop.
fn phi_le(x: *mut ir.Value, y: *mut ir.Value, bound: i64, depth: i32) bool {
    if x.xs.len > 4 {
        return false;
    }
    let mut loops = false;
    for k in 0..x.xs.len {
        let v = x.xs.get(k);
        let p = x.bs.get(k);
        if v == x {
            continue;
        }
        if (p.rpo < 0) or (p.rpo >= x.blk.rpo) {
            loops = true;
            continue;
        }
        let mark = ents.len;
        edge_assume(p, x.blk);
        let ok = le_path(v, y, bound, depth + 1);
        pop_to(mark);
        if not ok {
            return false;
        }
    }
    if not loops {
        return true;
    }
    if (ind_le.len >= 2) or not invariant_in(y, x.blk) {
        return false;
    }
    for k in 0..ind_le.len {
        if ind_le.get(k) == x {
            return false;
        }
    }
    let lo0 = fact_lo;
    let hi0 = fact_hi;
    ind_le.push(x);
    let mut ok = true;
    for k in 0..x.xs.len {
        let v = x.xs.get(k);
        let p = x.bs.get(k);
        if (v == x) or not ((p.rpo < 0) or (p.rpo >= x.blk.rpo)) {
            continue;
        }
        let mut lo = ents.len;
        if p.rpo >= 0 {
            lo = facts_at(p);
        }
        if (hi0 > lo0) and (lo0 < lo) {
            lo = lo0;
        }
        fact_lo = lo;
        fact_hi = ents.len;
        let mark = ents.len;
        add_le(x, y, bound);
        edge_assume(p, x.blk);
        path_assume(p);
        ok = le_path(v, y, bound, depth + 1);
        pop_to(mark);
        if not ok {
            break;
        }
    }
    _ = ind_le.pop();
    fact_lo = lo0;
    fact_hi = hi0;
    return ok;
}

// The loop phis whose upper bounds (against values) are being proved by
// induction.
let mut ind_le: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0,
                                                                  cap: 0 };

// Is y (nil, a constant, a parameter or an instruction) the same in every
// iteration of the loop headed by h: defined in a block that strictly
// dominates h?
fn invariant_in(y: *mut ir.Value, h: *mut ir.Block) bool {
    if u.isnil(y) or (y.kind != ir.V_INST) {
        return true;
    }
    return u.notnil(y.blk) and (y.blk != h) and (y.blk.rpo >= 0) and opt.dominates(y.blk, h);
}

fn edge_assume(p: *mut ir.Block, b: *mut ir.Block) void {
    let t = ir.terminator(p);
    if u.notnil(t) and (t.op == ir.OP_CONDBR) and (t.t1 != t.t2) {
        assume(t.a, t.t1 == b, 0);
    }
}

fn phi_below_max(x: *mut ir.Value, d: i64, depth: i32) bool {
    if x.xs.len > 4 {
        return false;
    }
    for k in 0..x.xs.len {
        let v = x.xs.get(k);
        if v == x {
            continue;
        }
        let mark = ents.len;
        edge_assume(x.bs.get(k), x.blk);
        let ok = below_max(v, d, depth + 1);
        pop_to(mark);
        if not ok {
            return false;
        }
    }
    return true;
}

// Is x <= MAX - d (d >= 1)? True when x <= w + c for some value w and c <= -d
// (w is at most MAX), following the facts.
fn below_max(x: *mut ir.Value, d: i64, depth: i32) bool {
    if small_k(x) {
        return true;
    }
    if u.notnil(x) and (x.ty.kind == ir.T_INT) and (x.ty.bits < 64) {
        return true;  // (the question is about 64-bit values: narrower ones are far below)
    }
    if (depth > 5) or (prove_budget <= 0) or u.isnil(x) {
        return false;
    }
    prove_budget -= 1;
    let mut e = bk.get(@truncate(usize, le_hash(x)) & (nb - 1));
    while e >= 0 {
        let en = ents.at(@int_cast(usize, e));
        if (en.kind == K_LE) and (en.key == x) and fact_ok(e) {
            if (en.off <= -d) or u.isnil(en.val) {
                return true;  // x <= w - d, or x <= a small constant
            }
            if below_max(en.val, d + en.off, depth + 1) {
                return true;
            }
        }
        e = en.next;
    }
    if (x.kind == ir.V_INST) and ((x.op == ir.OP_LSHR) or (x.op == ir.OP_UDIV)) and ir.is_cint(x.b) and
       (ir.cint_val(x.b) >= 2) {
        return true;  // at most MAX / 2
    }
    if ir.is_op(x, ir.OP_PHI) {
        return phi_below_max(x, d, depth);
    }
    if (x.kind == ir.V_INST) and ((x.op == ir.OP_ZEXT) or (x.op == ir.OP_TRUNC) or (x.op == ir.OP_AND)) {
        return below_max(x.a, d, depth + 1) or ((x.op == ir.OP_AND) and small_k(x.b));
    }
    return false;
}

// Is x <= y + bound?
fn prove_le(x: *mut ir.Value, y: *mut ir.Value, bound: i64) bool {
    prove_budget = 64;
    if small_k(y) {
        return le_path(x, vnil(), bound + kv(y), 0);
    }
    if ir.is_const(y) {
        return false;
    }
    return le_path(x, y, bound, 0);
}

// An upper bound of x (as an unsigned number), or -1 when none is known
// below 2^62: from constants, the facts in scope, masks, shifts, divisions,
// remainders, extensions, sums and products with constants, and phis (each
// incoming value under its edge's condition).
const UB_LIM: i64 = 0x4000_0000_0000_0000;

// Facts in the table at indices from fact_lo to fact_hi are not used: while
// a loop phi's bound is proved by induction (ub_phi), the facts of the scope
// that are not known at the back edge hold for the current iteration's
// values, not for those the back edge carries.
let mut fact_lo: usize = 0;
let mut fact_hi: usize = 0;

fn fact_ok(e: i64) bool {
    let k = @int_cast(usize, e);
    return (k < fact_lo) or (k >= fact_hi);
}

// The walk's path in the dominator tree, and the size of the table when
// each block on it was entered.
let mut wblocks: u.List.[*mut ir.Block] = u.List.[*mut ir.Block].{ data: @ptr_from_int(*mut *mut ir.Block, 0), len: 0,
                                                                   cap: 0 };
let mut wmarks: u.List.[usize] = u.List.[usize].{ data: @ptr_from_int(*mut usize, 0), len: 0, cap: 0 };

// Assumes the conditions on entry to the blocks that dominate p below the
// walk's path (where the facts in the table end), up to a few of them.
fn path_assume(p: *mut ir.Block) void {
    if p.rpo < 0 {
        return;
    }
    let mut j = wblocks.len;
    let mut top = ir.bnil();
    while j > 0 {
        j -= 1;
        if opt.dominates(wblocks.get(j), p) {
            top = wblocks.get(j);
            break;
        }
    }
    let mut b = p;
    let mut n: i32 = 0;
    while u.notnil(b) and (b != top) and (n < 6) {
        if b.preds.len == 1 {
            edge_assume(b.preds.get(0), b);
        }
        b = b.idom;
        n += 1;
    }
}

// The size of the table up to which its facts hold at the end of block p
// (those entered at the blocks of the walk's path that dominate p).
fn facts_at(p: *mut ir.Block) usize {
    let mut j = wblocks.len;
    while j > 0 {
        j -= 1;
        if opt.dominates(wblocks.get(j), p) {
            if (j + 1) < wblocks.len {
                return wmarks.get(j + 1);
            }
            return ents.len;
        }
    }
    return 0;
}

// The loop phis whose bounds are being proved by induction, and the bound
// assumed for each (-1: none).
let mut ind_phi: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0,
                                                                   cap: 0 };
let mut ind_bound: u.List.[i64] = u.List.[i64].{ data: @ptr_from_int(*mut i64, 0), len: 0, cap: 0 };

// The number of bits needed for v >= 0 (0 for 0).
fn bit_len(v: i64) i64 {
    let mut n: i64 = 0;
    while (n < 63) and ((v >> @truncate(u32, n)) != 0) {
        n += 1;
    }
    return n;
}

fn smax_of(t: *ir.Ty) i64 {
    return @bit_cast(i64, ir.mask_bits(t.bits) >> 1);
}

// The smaller of two upper bounds, either of which may be unknown (-1).
fn ub_min(a: i64, b: i64) i64 {
    if (a < 0) or ((b >= 0) and (b < a)) {
        return b;
    }
    return a;
}

fn ub(x: *mut ir.Value, depth: i32) i64 {
    if small_k(x) {
        return kv(x);
    }
    if u.isnil(x) or (x.ty.kind != ir.T_INT) or (depth > 6) or (prove_budget <= 0) {
        return -1;
    }
    for k in 0..ind_phi.len {
        if ind_phi.get(k) == x {
            return ind_bound.get(k);
        }
    }
    prove_budget -= 1;
    let mut best: i64 = -1;
    if x.ty.bits < 62 {
        best = @bit_cast(i64, ir.mask_bits(x.ty.bits));
    }
    // facts x <= w + c
    let mut e = bk.get(@truncate(usize, le_hash(x)) & (nb - 1));
    while e >= 0 {
        let en = ents.at(@int_cast(usize, e));
        if (en.kind == K_LE) and (en.key == x) and fact_ok(e) {
            let mut w: i64 = 0;
            if u.notnil(en.val) {
                w = ub(en.val, depth + 1);
            }
            if (w >= 0) and ((w + en.off) >= 0) and (((best < 0) or ((w + en.off) < best))) {
                best = w + en.off;
            }
        }
        e = en.next;
    }
    if x.kind != ir.V_INST {
        return best;
    }
    let op = x.op;
    let mut d: i64 = -1;
    if op == ir.OP_AND {
        if small_k(x.b) {
            d = ub_min(kv(x.b), ub(x.a, depth + 1));
        } else {
            d = ub_min(ub(x.a, depth + 1), ub(x.b, depth + 1));
        }
    } else if (op == ir.OP_XOR) and small_k(x.b) and (kv(x.b) >= 1) and ((kv(x.b) & (kv(x.b) + 1)) == 0) and
              (ub(x.a, depth + 1) >= 0) and (ub(x.a, depth + 1) <= kv(x.b)) {
        // k ^ y with k = 2^n - 1 and y <= k: k - y <= k - lb(y)
        d = kv(x.b) - lb(x.a, depth + 1);
    } else if (op == ir.OP_OR) or (op == ir.OP_XOR) {
        let a = ub(x.a, depth + 1);
        let b = ub(x.b, depth + 1);
        if (a >= 0) and (b >= 0) {
            let mut m = a;
            if b > m {
                m = b;
            }
            d = @bit_cast(i64, ir.mask_bits(@truncate(i32, bit_len(m))));
        }
    } else if (op == ir.OP_SUB) and small_k(x.a) {
        // c - y <= c - lb(y) when y <= c (no wrap)
        let b = ub(x.b, depth + 1);
        if (b >= 0) and (b <= kv(x.a)) {
            d = kv(x.a) - lb(x.b, depth + 1);
        }
    } else if (op == ir.OP_SHL) and not ir.is_cint(x.b) {
        // by a count below the width
        let a = ub(x.a, depth + 1);
        let k = ub(x.b, depth + 1);
        if (a >= 0) and (a < 0x1_0000_0000) and (k >= 0) and (k < 32) and (k < @as(i64, x.ty.bits)) and
           fits_type(a << @truncate(u32, k), x.ty) {
            d = a << @truncate(u32, k);
        }
    } else if (op == ir.OP_SUB) and
              (known_true(synth_icmp(ir.IntUGE, x.a, x.b)) or known_true(synth_icmp(ir.IntUGT, x.a, x.b))) {
        d = ub(x.a, depth + 1);  // y - z <= y when z <= y
    } else if (op == ir.OP_SEXT) or ((op == ir.OP_ASHR) and not small_k(x.b)) {
        // a value known not negative
        let a = ub(x.a, depth + 1);
        if (a >= 0) and (a <= smax_of(x.a.ty)) {
            d = a;
        }
    } else if (op == ir.OP_ASHR) and (ir.cint_val(x.b) < 63) {
        let a = ub(x.a, depth + 1);
        if (a >= 0) and (a <= smax_of(x.a.ty)) {
            d = a >> @truncate(u32, ir.cint_val(x.b));
        }
    } else if (op == ir.OP_LSHR) and not ir.is_cint(x.b) {
        d = ub(x.a, depth + 1);
    } else if op == ir.OP_INTR {
        d = ub_intr(x, depth);
    } else if op == ir.OP_LOAD {
        d = table_max(x);
    } else if (op == ir.OP_LSHR) and ir.is_cint(x.b) and (ir.cint_val(x.b) < 63) {
        let a = ub(x.a, depth + 1);
        if a >= 0 {
            d = a >> @truncate(u32, ir.cint_val(x.b));
        } else if x.ty.bits == 64 {
            d = @bit_cast(i64, ir.mask_bits(64) >> @truncate(u32, ir.cint_val(x.b)));
            if d >= UB_LIM {
                d = -1;
            }
        }
    } else if (op == ir.OP_UDIV) and small_k(x.b) and (kv(x.b) > 0) {
        let a = ub(x.a, depth + 1);
        if a >= 0 {
            d = a / kv(x.b);
        }
    } else if op == ir.OP_UREM {
        let a = ub(x.b, depth + 1);
        if a > 0 {
            d = a - 1;
        }
    } else if (op == ir.OP_ZEXT) or (op == ir.OP_TRUNC) {
        d = ub(x.a, depth + 1);
    } else if (op == ir.OP_ADD) and ir.is_cint(x.b) and (x.ty.bits > 1) and
              (ir.cint_val(x.b) > (ir.mask_bits(x.ty.bits) >> 1)) {
        // y - c, exact when y >= c, which a result known not negative also
        // shows when y is: else it would be y - c + 2^bits, at least
        // 2^bits - c, which is negative for c up to 2^(bits - 1)
        let c = (ir.mask_bits(x.ty.bits) - ir.cint_val(x.b)) + 1;
        if (c < 0x1_0000_0000) and known_at_least(x.a, @bit_cast(i64, c)) {
            let a = ub(x.a, depth + 1);
            if a >= 0 {
                d = a - @bit_cast(i64, c);
            }
        } else if (c < 0x1_0000_0000) and (x.ty.bits <= 64) and (c <= (ir.mask_bits(x.ty.bits) >> 1) + 1) and
                  known_true(synth_icmp(ir.IntSGE, x, ir.cint(x.ty, 0))) {
            let a = ub(x.a, depth + 1);
            if (a >= 0) and (a <= smax_of(x.ty)) and (a >= @bit_cast(i64, c)) {
                d = a - @bit_cast(i64, c);
            }
        }
    } else if (op == ir.OP_ADD) and small_k(x.b) and (kv(x.b) < 0x1_0000_0000) {
        // no wrap when the bound stays below the type's maximum
        let a = ub(x.a, depth + 1);
        if (a >= 0) and (kv(x.b) >= 0) and (a <= 0x7FFF_FFFF_FFFF_FFFF - kv(x.b)) and fits_type(a + kv(x.b), x.ty) {
            d = a + kv(x.b);
        }
    } else if op == ir.OP_ADD {
        let a = ub(x.a, depth + 1);
        let b = ub(x.b, depth + 1);
        if (a >= 0) and (b >= 0) and (a <= 0x7FFF_FFFF_FFFF_FFFF - b) and fits_type(a + b, x.ty) {
            d = a + b;
        }
    } else if (op == ir.OP_MUL) and small_k(x.b) and (kv(x.b) < 0x1_0000_0000) {
        let a = ub(x.a, depth + 1);
        // (both under 2^32, the product may still pass 2^63)
        if (a >= 0) and (a < 0x1_0000_0000) and (kv(x.b) > 0) and (a <= 0x7FFF_FFFF_FFFF_FFFF / kv(x.b)) and
           fits_type(a * kv(x.b), x.ty) {
            d = a * kv(x.b);
        }
    } else if (op == ir.OP_SHL) and ir.is_cint(x.b) and (ir.cint_val(x.b) < 32) {
        let a = ub(x.a, depth + 1);
        if (a >= 0) and (a < 0x1_0000_0000) and fits_type(a << @truncate(u32, ir.cint_val(x.b)), x.ty) {
            d = a << @truncate(u32, ir.cint_val(x.b));
        }
    } else if (op == ir.OP_SELECT) {
        // each arm under its condition (min(y, c) <= c)
        let mark = ents.len;
        if x.a.ty.kind == ir.T_INT {
            assume(x.a, true, 0);
        }
        let a = ub(x.b, depth + 1);
        pop_to(mark);
        if a >= 0 {
            if x.a.ty.kind == ir.T_INT {
                assume(x.a, false, 0);
            }
            let b = ub(x.c, depth + 1);
            pop_to(mark);
            if b >= 0 {
                d = a;
                if b > a {
                    d = b;
                }
            }
        }
    } else if (op == ir.OP_PHI) and (x.xs.len <= 4) {
        d = ub_phi(x, depth);
    }
    if d >= UB_LIM {
        d = -1;
    }
    if (d >= 0) and ((best < 0) or (d < best)) {
        best = d;
    }
    return best;
}

// A lower bound of x (0 when none is known): constants, and the leading
// zeros of a value with a known upper bound.
fn lb(x: *mut ir.Value, depth: i32) i64 {
    if small_k(x) {
        return kv(x);
    }
    if ir.is_op(x, ir.OP_INTR) and (ir.intr_id(x) == ir.IN_CTLZ) and (x.xs.len == 1) and (x.ty.kind == ir.T_INT) {
        let a = x.xs.get(0);
        let m = ub(a, depth + 1);
        if (m >= 0) and (a.ty.bits <= 64) {
            return @as(i64, a.ty.bits) - bit_len(m);
        }
    }
    return 0;
}

// A phi's bound: the largest of its incoming values' bounds. Values that
// come around a loop (from a block not before the phi's in reverse
// postorder) are bounded by induction: with the phi assumed at most the
// bound of the others, each must stay within it, proved without the facts
// of the scope (they hold for this iteration's values) but with the
// condition of the edge.
fn ub_phi(x: *mut ir.Value, depth: i32) i64 {
    let mut d: i64 = 0;
    let mut loops = false;
    for k in 0..x.xs.len {
        let v = x.xs.get(k);
        let p = x.bs.get(k);
        if v == x {
            continue;
        }
        if (p.rpo < 0) or (p.rpo >= x.blk.rpo) {
            loops = true;
            continue;
        }
        let mark = ents.len;
        edge_assume(p, x.blk);
        path_assume(p);
        let b = ub(v, depth + 1);
        pop_to(mark);
        if b < 0 {
            return -1;
        }
        if b > d {
            d = b;
        }
    }
    if not loops {
        return d;
    }
    let lo0 = fact_lo;
    let hi0 = fact_hi;
    ind_phi.push(x);
    ind_bound.push(d);
    let mut ok = true;
    for k in 0..x.xs.len {
        let v = x.xs.get(k);
        let p = x.bs.get(k);
        if (v == x) or not ((p.rpo < 0) or (p.rpo >= x.blk.rpo)) {
            continue;
        }
        let mut lo = ents.len;
        if p.rpo >= 0 {
            lo = facts_at(p);
        }
        if (hi0 > lo0) and (lo0 < lo) {
            lo = lo0;
        }
        fact_lo = lo;
        fact_hi = ents.len;
        let mark = ents.len;
        edge_assume(p, x.blk);
        path_assume(p);
        let b = ub(v, depth + 1);
        pop_to(mark);
        if (b < 0) or (b > d) {
            ok = false;
            break;
        }
    }
    _ = ind_phi.pop();
    _ = ind_bound.pop();
    fact_lo = lo0;
    fact_hi = hi0;
    if ok {
        return d;
    }
    return -1;
}

// Bounds of the integer intrinsics: bit counts are at most the width (less
// one for leading or trailing zeros of a value known not zero, and trailing
// zeros are below its highest possible bit), minimums and maximums.
fn ub_intr(x: *mut ir.Value, depth: i32) i64 {
    let id = ir.intr_id(x);
    if x.xs.len < 1 {
        return -1;
    }
    let a = x.xs.get(0);
    if (a.ty.kind != ir.T_INT) or (a.ty.bits > 64) {
        return -1;
    }
    let bits = @as(i64, a.ty.bits);
    if id == ir.IN_CTPOP {
        return ub_min(bits, bit_len(ub(a, depth + 1)));
    }
    if (id == ir.IN_CTLZ) or (id == ir.IN_CTTZ) {
        if not known_at_least(a, 1) {
            return bits;
        }
        if id == ir.IN_CTTZ {
            let m = ub(a, depth + 1);
            if m >= 1 {
                return bit_len(m) - 1;
            }
        }
        return bits - 1;
    }
    if x.xs.len != 2 {
        return -1;
    }
    let b = x.xs.get(1);
    if id == ir.IN_UMIN {
        return ub_min(ub(a, depth + 1), ub(b, depth + 1));
    }
    if (id == ir.IN_UMAX) or (id == ir.IN_SMIN) or (id == ir.IN_SMAX) {
        // (signed: both known not negative)
        let mut p = ub(a, depth + 1);
        let mut q = ub(b, depth + 1);
        if id == ir.IN_SMAX {
            // the larger with a constant not negative is not negative
            if ir.is_cint(b) and (ir.sval(b) >= 0) and ((p < 0) or (p > smax_of(a.ty))) {
                p = smax_of(a.ty);
            }
            if ir.is_cint(a) and (ir.sval(a) >= 0) and ((q < 0) or (q > smax_of(a.ty))) {
                q = smax_of(a.ty);
            }
        }
        if (p < 0) or (q < 0) {
            return -1;
        }
        if (id != ir.IN_UMAX) and ((p > smax_of(a.ty)) or (q > smax_of(a.ty))) {
            return -1;
        }
        if (id == ir.IN_SMIN) and (q < p) {
            return q;
        }
        if (id == ir.IN_SMIN) or (p >= q) {
            return p;
        }
        return q;
    }
    return -1;
}

// Constant tables: the largest element a load from a constant global can
// read, when the global holds only integers of the load's type and the
// load's offsets are multiples of its size (or -1). Cached per run of gvn.
let mut tab_key: u.List.[*mut ir.Global] = u.List.[*mut ir.Global].{ data: @ptr_from_int(*mut *mut ir.Global, 0),
                                                                     len: 0, cap: 0 };
let mut tab_ty: u.List.[*mut ir.Ty] = u.List.[*mut ir.Ty].{ data: @ptr_from_int(*mut *mut ir.Ty, 0), len: 0, cap: 0 };
let mut tab_max: u.List.[i64] = u.List.[i64].{ data: @ptr_from_int(*mut i64, 0), len: 0, cap: 0 };

fn table_max(i: *mut ir.Value) i64 {
    if (i.flags != 0) or (i.ty.kind != ir.T_INT) or (i.ty.bits > 64) or (i.ty.size == 0) {
        return -1;
    }
    let sz = i.ty.size;
    let mut p = i.a;
    let mut n: i32 = 0;
    while ir.is_op(p, ir.OP_PTRADD) {
        n += 1;
        if (n > 8) or not mult_of(p.b, sz, 0) {
            return -1;
        }
        p = p.a;
    }
    if (p.kind != ir.V_GLOBAL) or not p.gv.is_const or u.isnil(p.gv.init) or p.gv.tls or
       (p.gv.linkage == ir.LINK_WEAK) or (p.gv.linkage == ir.LINK_EXTWEAK) {
        return -1;
    }
    for k in 0..tab_key.len {
        if (tab_key.get(k) == p.gv) and (tab_ty.get(k) == i.ty) {
            return tab_max.get(k);
        }
    }
    let mut budget: i64 = 1 << 16;
    let m = leaf_max(p.gv.init, i.ty, &mut budget);
    tab_key.push(p.gv);
    tab_ty.push(i.ty);
    tab_max.push(m);
    return m;
}

// A comparison with a constant of a value computed from an element T[x] of
// a constant table (cb.leaf_load: casts and operations with constants),
// where x is known to lie in the table: decided for each x, then tested as
// one range of x (x - a <u n) or as x's bit of a constant (tables of up to
// 64 elements). The load goes (is_term(op), a property of the opcode from a
// table, becomes op - k <u 5).
fn table_cmp(i: *mut ir.Value) *mut ir.Value {
    let c = i.b;
    if not ir.is_cint(c) or (i.a.kind != ir.V_INST) or (i.a.ty.kind != ir.T_INT) or (i.a.ty.bits > 64) {
        return vnil();
    }
    let ld = cb.leaf_load(i.a, 0);
    if u.isnil(ld) or (ld.flags != 0) or (ld.ty.kind != ir.T_INT) or (ld.ty.bits > 64) or (ld.ty.size == 0) {
        return vnil();
    }
    let esz = ld.ty.size;
    // the address: the table plus constants plus x * esz
    let mut p = ld.a;
    let mut off: u64 = 0;
    let mut x = vnil();
    let mut n: i32 = 0;
    while ir.is_op(p, ir.OP_PTRADD) and (n < 8) {
        n += 1;
        if ir.is_cint(p.b) {
            off = off +% ir.cint_val(p.b);
        } else {
            if u.notnil(x) {
                return vnil();
            }
            x = index_of(p.b, esz);
            if u.isnil(x) {
                return vnil();
            }
        }
        p = p.a;
    }
    if u.isnil(x) or (x.ty.kind != ir.T_INT) or (x.ty.bits > 64) or (p.kind != ir.V_GLOBAL) or not p.gv.is_const or
       u.isnil(p.gv.init) or p.gv.tls or (p.gv.linkage == ir.LINK_WEAK) or (p.gv.linkage == ir.LINK_EXTWEAK) or
       (off >= p.gv.ty.size) {
        return vnil();
    }
    let ne = (p.gv.ty.size - off) / esz;
    prove_budget = 64;
    let hi = ub(x, 0);
    if (hi < 0) or (@bit_cast(u64, hi) >= ne) or (hi >= 4096) {
        return vnil();
    }
    // which x make it true
    let mut first: i64 = -1;
    let mut last: i64 = -1;
    let mut count: i64 = 0;
    let mut runs: i32 = 0;
    let mut mask: u64 = 0;
    let p0 = ir.pred_of(i);
    for j in @as(i64, 0)..(hi + 1) {
        let mut ok = false;
        let v = cb.table_int(p, off + (@bit_cast(u64, j) * esz), ld.ty, &mut ok);
        if not ok {
            return vnil();
        }
        let lv = cb.leaf_value(i.a, ld, v);
        let r = ir.fold_icmp(p0, ir.cint(i.a.ty, lv), c);
        if u.isnil(r) or not ir.is_cint(r) {
            return vnil();
        }
        if ir.cint_val(r) != 0 {
            if (last < 0) or (last != (j - 1)) {
                runs += 1;
            }
            if first < 0 {
                first = j;
            }
            last = j;
            count += 1;
            if j < 64 {
                mask = mask | (@as(u64, 1) << @truncate(u32, @bit_cast(u64, j)));
            }
        }
    }
    if count == 0 {
        return ir.kbool(false);
    }
    if count == (hi + 1) {
        return ir.kbool(true);
    }
    ir.at_before(B, i);
    if runs == 1 {
        if first == 0 {
            return ir.icmp(B, ir.IntULT, x, ir.cint(x.ty, @bit_cast(u64, last + 1)));
        }
        let d = ir.binop(B, ir.OP_SUB, x, ir.cint(x.ty, @bit_cast(u64, first)));
        return ir.icmp(B, ir.IntULT, d, ir.cint(x.ty, @bit_cast(u64, (last - first) + 1)));
    }
    if hi >= 64 {
        return vnil();
    }
    let t64 = ir.t_int(64);
    let mut x64 = x;
    if x.ty.bits < 64 {
        x64 = ir.cast(B, ir.OP_ZEXT, x, t64);
    }
    let sh = ir.binop(B, ir.OP_LSHR, ir.cint(t64, mask), x64);
    let bit = ir.binop(B, ir.OP_AND, sh, ir.cint(t64, 1));
    return ir.icmp(B, ir.IntNE, bit, ir.cint(t64, 0));
}

// The x of a byte offset x * sz, or nil.
fn index_of(v: *mut ir.Value, sz: u64) *mut ir.Value {
    if sz == 1 {
        return v;
    }
    if ir.is_op(v, ir.OP_MUL) and ir.is_cint(v.b) and (ir.cint_val(v.b) == sz) {
        return v.a;
    }
    if ir.is_op(v, ir.OP_SHL) and ir.is_cint(v.b) and (ir.cint_val(v.b) < 32) and
       ((@as(u64, 1) << @truncate(u32, ir.cint_val(v.b))) == sz) {
        return v.a;
    }
    return vnil();
}

// Is v (a byte offset) a multiple of sz?
fn mult_of(v: *ir.Value, sz: u64, depth: i32) bool {
    if sz == 1 {
        return true;
    }
    if ir.is_cint(v) {
        return (ir.cint_val(v) % sz) == 0;
    }
    if (v.kind != ir.V_INST) or (depth > 4) {
        return false;
    }
    if (v.op == ir.OP_MUL) and (mult_of(v.a, sz, depth + 1) or mult_of(v.b, sz, depth + 1)) {
        return true;
    }
    if (v.op == ir.OP_SHL) and ir.is_cint(v.b) and (ir.cint_val(v.b) < 32) {
        return (((@as(u64, 1) << @truncate(u32, ir.cint_val(v.b))) % sz) == 0) or mult_of(v.a, sz, depth + 1);
    }
    if (v.op == ir.OP_ADD) or (v.op == ir.OP_SUB) {
        return mult_of(v.a, sz, depth + 1) and mult_of(v.b, sz, depth + 1);
    }
    if (v.op == ir.OP_SEXT) or (v.op == ir.OP_ZEXT) {
        return mult_of(v.a, sz, depth + 1);
    }
    return false;
}

// The largest of the integers of type t that make up constant c (zeros
// count as 0), or -1 when it holds anything else.
fn leaf_max(c: *ir.Value, t: *mut ir.Ty, budget: *mut i64) i64 {
    budget.* -= 1;
    if budget.* < 0 {
        return -1;
    }
    if c.kind == ir.V_ZERO {
        return 0;
    }
    if (c.kind == ir.V_CINT) and (c.ty == t) {
        if ir.cint_val(c) >= @bit_cast(u64, UB_LIM) {
            return -1;
        }
        return @bit_cast(i64, ir.cint_val(c));
    }
    if (c.kind == ir.V_CAGG) and ir.is_agg(c.ty) {
        let mut m: i64 = 0;
        for k in 0..c.xs.len {
            let x = leaf_max(c.xs.get(k), t, budget);
            if x < 0 {
                return -1;
            }
            if x > m {
                m = x;
            }
        }
        return m;
    }
    return -1;
}

fn fits_type(v: i64, t: *ir.Ty) bool {
    if (v < 0) or (v >= UB_LIM) {
        return false;
    }
    return @bit_cast(u64, v) <= ir.mask_bits(t.bits);
}

// The value of an unsigned comparison the bounds decide, or nil.
fn decide(i: *mut ir.Value) *mut ir.Value {
    let mut p = ir.pred_of(i);
    let a = i.a;
    let b = i.b;
    if (a.ty.kind != ir.T_INT) or (a.ty.bits > 64) or (i.ty.kind != ir.T_INT) {
        return vnil();
    }
    // comparisons with constants near the top of the range (overflow checks)
    if ir.is_cint(b) and not small_k(b) and (a.ty.bits == 64) {
        let d = @bit_cast(i64, ir.mask_bits(64) - ir.cint_val(b));  // b = MAX - d
        if (d < 0x1_0000_0000) and (((p == ir.IntULE) and (d >= 1)) or ((p == ir.IntULT) and (d >= 0))) {
            prove_budget = 64;
            let need = d + pick1(p == ir.IntULT);
            if below_max(a, need, 0) {
                return ir.kbool(true);
            }
        }
        if (d < 0x1_0000_0000) and (((p == ir.IntUGT) and (d >= 1)) or ((p == ir.IntUGE) and (d >= 0))) {
            prove_budget = 64;
            let need = d + pick1(p == ir.IntUGE);
            if below_max(a, need, 0) {
                return ir.kbool(false);
            }
        }
        return vnil();
    }
    // bounds from the values' ranges: x < K when ub(x) < K; (x + y) >= x when
    // the sum cannot wrap
    prove_budget = 64;
    if small_k(b) {
        let m = ub(a, 0);
        if (m >= 0) and (p >= ir.IntSGT) and (p <= ir.IntSLE) and (kv(b) <= smax_of(a.ty)) and (m <= smax_of(a.ty)) {
            p = p - (ir.IntSGT - ir.IntUGT);  // both not negative: the unsigned comparison
        }
        if (kv(b) == 0) and ((p == ir.IntUGE) or (p == ir.IntULT)) {
            return ir.kbool(p == ir.IntUGE);
        }
        if m >= 0 {
            if ((p == ir.IntULT) and (m < kv(b))) or ((p == ir.IntUGE) and (m < kv(b))) {
                return ir.kbool(p == ir.IntULT);
            }
            if ((p == ir.IntULE) and (m <= kv(b))) or ((p == ir.IntUGT) and (m <= kv(b))) {
                return ir.kbool(p == ir.IntULE);
            }
        }
    }
    // lower bounds: n - x >= k when x + k <= n, and multiples of them
    if small_k(b) and ((p == ir.IntUGE) or (p == ir.IntUGT) or (p == ir.IntULT) or (p == ir.IntULE)) {
        let mut need = kv(b);
        if (p == ir.IntUGT) or (p == ir.IntULE) {
            need += 1;
        }
        if at_least(a, need, 0) {
            return ir.kbool((p == ir.IntUGE) or (p == ir.IntUGT));
        }
    }
    // k <= x, k < x (and their negations) likewise
    if small_k(a) and not ir.is_const(b) and
       ((p == ir.IntUGE) or (p == ir.IntUGT) or (p == ir.IntULT) or (p == ir.IntULE)) {
        let mut need = kv(a);
        if (p == ir.IntULT) or (p == ir.IntUGE) {
            need += 1;
        }
        if at_least(b, need, 0) {
            return ir.kbool((p == ir.IntULE) or (p == ir.IntULT));
        }
    }
    // (x - d) against k >= 0, signed, with x in [0, ub(x)] and no overflow:
    // x - d >= k exactly when x >= d + k
    if small_k(b) and ir.is_op(a, ir.OP_ADD) and ir.is_cint(a.b) and not ir.is_const(a.a) and (p >= ir.IntSGT) and
       (p <= ir.IntSLE) and (a.ty.bits > 1) {
        let d = 0 - ir.sval(a.b);
        let m = ub(a.a, 0);
        let mut need = d + kv(b);
        if (p == ir.IntSGT) or (p == ir.IntSLE) {
            need += 1;
        }
        if (d >= 1) and (d < 0x1_0000_0000) and (m >= 0) and (m <= smax_of(a.ty)) and (need >= 1) and
           (need <= smax_of(a.ty)) and known_at_least(a.a, need) {
            return ir.kbool((p == ir.IntSGT) or (p == ir.IntSGE));
        }
    }
    if ir.is_op(a, ir.OP_ADD) and ((a.a == b) or (a.b == b)) and ((p == ir.IntUGE) or (p == ir.IntULT)) {
        prove_budget = 64;
        let x = ub(a.a, 0);
        let y = ub(a.b, 0);
        if (x >= 0) and (y >= 0) and fits_type(x + y, a.ty) {
            return ir.kbool(p == ir.IntUGE);
        }
    }
    if (p == ir.IntULT) or (p == ir.IntUGE) {
        // a < b: a <= b - 1; a >= b: b <= a
        if prove_le(a, b, -1) {
            return ir.kbool(p == ir.IntULT);
        }
        if not ir.is_const(b) and prove_le(b, a, 0) {
            return ir.kbool(p == ir.IntUGE);
        }
    } else if (p == ir.IntULE) or (p == ir.IntUGT) {
        if prove_le(a, b, 0) {
            return ir.kbool(p == ir.IntULE);
        }
        if not ir.is_const(b) and prove_le(b, a, -1) {
            return ir.kbool(p == ir.IntUGT);
        }
    }
    return vnil();
}

// Facts on entry to b from its only predecessor.
fn edge_facts(b: *mut ir.Block) void {
    if b.preds.len != 1 {
        return;
    }
    let p = b.preds.get(0);
    let t = ir.terminator(p);
    if u.isnil(t) {
        return;
    }
    if (t.op == ir.OP_CONDBR) and (t.t1 != t.t2) {
        assume(t.a, t.t1 == b, 0);
    } else if (t.op == ir.OP_SWITCH) and (t.t1 != b) and not ir.is_const(t.a) {
        let mut n: i32 = 0;
        let mut c = vnil();
        for k in 0..t.bs.len {
            if t.bs.get(k) == b {
                n += 1;
                c = t.xs.get(k);
            }
        }
        if n == 1 {
            add_known(t.a, c);
        }
    }
}

// Writes on paths from b's immediate dominator to b that avoid it.
fn region_writes(b: *mut ir.Block) void {
    if b.preds.len <= 1 {
        return;
    }
    let d = b.idom;
    let mut work = u.List.[*mut ir.Block].empty();
    let mut seen = u.List.[*mut ir.Block].empty();
    let tag = @int_cast(i64, b.id) + 1 + (@int_cast(i64, g_fn.nblocks) * @int_cast(i64, b.rpo + 1));
    for k in 0..b.preds.len {
        let p = b.preds.get(k);
        if (p != d) and (p.rpo >= 0) and (p.aux != tag) {
            p.aux = tag;
            work.push(p);
            seen.push(p);
        }
    }
    let mut ok = true;
    while work.len > 0 {
        if seen.len > 200 {
            ok = false;
            break;
        }
        let x = work.pop();
        for k in 0..x.preds.len {
            let p = x.preds.get(k);
            if (p != d) and (p.rpo >= 0) and (p.aux != tag) {
                p.aux = tag;
                work.push(p);
                seen.push(p);
            }
        }
    }
    if ok {
        let start = writes.len;
        for k in 0..seen.len {
            let mut i = seen.get(k).first;
            while u.notnil(i) {
                note_writes(i);
                i = i.next;
            }
            if (writes.len - start) > 128 {
                ok = false;
                break;
            }
        }
    }
    if not ok {
        push_write(W_ALL, nowhere());
    }
    work.deinit();
    seen.deinit();
}

// -----------------------------------------------------------------------------
// The walk
// -----------------------------------------------------------------------------
fn replace(i: *mut ir.Value, r: *mut ir.Value) void {
    ir.forward(i, r);
    ir.remove_inst(i);
    changed = true;
}

fn known_operand(o: *mut ir.Value) *mut ir.Value {
    if u.isnil(o) {
        return o;
    }
    let r = ir.resolve(o);
    if (r.kind == ir.V_INST) or (r.kind == ir.V_PARAM) {
        let k = find_known(r);
        if u.notnil(k) {
            changed = true;
            return k;
        }
    }
    return r;
}

fn visit_block(b: *mut ir.Block) void {
    let mut i = b.first;
    while u.notnil(i) {
        let next = i.next;
        let op = i.op;
        if op == ir.OP_PHI {
            for k in 0..i.xs.len {
                i.xs.set(k, ir.resolve(i.xs.get(k)));
            }
            i = next;
            continue;
        }
        i.a = known_operand(i.a);
        i.b = known_operand(i.b);
        i.c = known_operand(i.c);
        for k in 0..i.xs.len {
            i.xs.set(k, known_operand(i.xs.get(k)));
        }
        if (op == ir.OP_SUB) and small_k(i.a) and (i.ty.kind == ir.T_INT) and (i.ty.bits <= 64) and
           not ir.is_const(i.b) and (kv(i.a) >= 1) and ((kv(i.a) & (kv(i.a) + 1)) == 0) and
           not (tg.clz_is_bsr() and ir.is_op(i.b, ir.OP_INTR) and (ir.intr_id(i.b) == ir.IN_CTLZ)) {
            // k - y with k = 2^n - 1 and y <= k: k ^ y (no borrow; one
            // instruction in place on x86-64, 31 - ctlz(x) after lzcnt)
            prove_budget = 64;
            let m = ub(i.b, 0);
            if (m >= 0) and (m <= kv(i.a)) {
                let k = i.a;
                i.op = ir.OP_XOR;
                i.a = i.b;
                i.b = k;
                changed = true;
            }
        }
        if cse_able(i) {
            let mut r = find_expr(i);
            if u.isnil(r) and (op == ir.OP_ICMP) {
                r = decide(i);
                if u.isnil(r) {
                    r = table_cmp(i);
                }
            }
            if u.notnil(r) {
                replace(i, r);
            } else {
                add_expr(i, i);
            }
        } else if op == ir.OP_LOAD {
            if i.flags != 0 {
                note_writes(i);
            } else {
                let l = loc_of(i.a, @bit_cast(i64, i.ty.size));
                let mut r = find_mem(&l, i.ty);
                if u.isnil(r) {
                    r = compose_load(i, &l);
                }
                if u.isnil(r) {
                    r = forward_copy(i, &l);
                }
                if u.isnil(r) and ((i.ty.kind == ir.T_VEC) or (i.ty.kind == ir.T_INT) or (i.ty.kind == ir.T_FLOAT)) {
                    r = punned_load(i, &l);
                }
                if u.isnil(r) {
                    r = narrowed_load(i, &l);
                }
                if u.notnil(r) {
                    replace(i, r);
                } else {
                    add_mem(&l, i.ty, i);
                }
            }
        } else if op == ir.OP_STORE {
            if i.flags != 0 {
                note_writes(i);
            } else {
                let l = loc_of(i.b, @bit_cast(i64, i.a.ty.size));
                let r = find_mem(&l, i.a.ty);
                if u.notnil(r) and (ir.resolve(r) == i.a) {
                    ir.remove_inst(i);  // memory already holds the value
                    changed = true;
                } else {
                    note_writes(i);
                    add_mem(&l, i.a.ty, i.a);
                }
            }
        } else {
            note_writes(i);
            if (op == ir.OP_MEMSET) and ir.is_cint(i.b) and (size_of(i.c) > 0) {
                let l = loc_of(i.a, size_of(i.c));
                push_ent(K_FILL, fill_hash(l.base), l.base, l.off, ir.t_void(), i);
            } else if (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE) {
                note_copy(i);
            }
        }
        i = next;
    }
}

fn walk(entry: *mut ir.Block) void {
    let blocks = &mut wblocks;
    blocks.clear();
    let mut kids = u.List.[usize].empty();
    let ent_marks = &mut wmarks;
    ent_marks.clear();
    let mut wr_marks = u.List.[usize].empty();
    blocks.push(entry);
    kids.push(0);
    ent_marks.push(0);
    wr_marks.push(0);
    visit_block(entry);
    while blocks.len > 0 {
        let b = blocks.last();
        let k = kids.last();
        if k < b.dom_kids.len {
            kids.set(kids.len - 1, k + 1);
            let c = b.dom_kids.get(k);
            ent_marks.push(ents.len);
            wr_marks.push(writes.len);
            blocks.push(c);
            kids.push(0);
            region_writes(c);
            edge_facts(c);
            visit_block(c);
        } else {
            pop_to(ent_marks.pop());
            writes.len = wr_marks.pop();
            _ = blocks.pop();
            _ = kids.pop();
        }
    }
    kids.deinit();
    wr_marks.deinit();
}

// True if anything changed.
pub fn gvn(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    if u.isnil(B) {
        B = ir.new_builder();
    }
    g_fn = f;
    changed = false;
    opt.compute_preds(f);
    let order = opt.dominators(f);
    let mut n: usize = 0;
    let mut b = f.first;
    while u.notnil(b) {
        b.aux = 0;
        let mut i = b.first;
        while u.notnil(i) {
            n += 1;
            i = i.next;
        }
        b = b.next;
    }
    // the buckets are all empty between calls (the walk pops every entry):
    // they only grow, and more of them than this function needs is fine
    let mut want: usize = 256;
    while want < (n * 2) {
        want = want * 2;
    }
    while bk.len < want {
        bk.push(-1);
    }
    nb = bk.len;
    ents.clear();
    writes.clear();
    n_synth = 0;
    fact_lo = 0;
    fact_hi = 0;
    tab_key.clear();
    tab_ty.clear();
    tab_max.clear();
    escapes(f);
    walk(order.get(0));
    pop_to(0);
    ir.apply_forwarding(f);
    pre_loads(f, &order);
    order.deinit();
    ir.apply_forwarding(f);
    return changed;
}

// -----------------------------------------------------------------------------
// Loads at joins (partial redundancy): a load at the start of a block (no
// write to its location before it there) whose value each predecessor knows
// at its end (stored or loaded there, nothing possibly writing the location
// since) is a phi of those values; when one predecessor does not know it,
// the load moves there (onto the edge), so the paths that know it do not
// load again: `if a[1] > a[0] { a[1] = a[0] }` then `a[1]` again, or a
// vector's length loaded again after the call that grows it on the rare
// path. Not across back edges.
// -----------------------------------------------------------------------------
struct PrePhi {
    blk: *mut ir.Block,
    base: *mut ir.Value,
    off: i64,
    ty: *mut ir.Ty,
    val: *mut ir.Value,
}

let mut pre_phis: u.List.[PrePhi] = u.List.[PrePhi].{ data: @ptr_from_int(*mut PrePhi, 0), len: 0, cap: 0 };

// The value at l (of type t) at the start of b is v (nil: not known).
fn set_pre(b: *mut ir.Block, l: *Loc, t: *mut ir.Ty, v: *mut ir.Value) void {
    for k in 0..pre_phis.len {
        let e = pre_phis.at(k);
        if (e.blk == b) and (e.base == l.base) and (e.off == l.off) and (e.ty == t) {
            e.val = v;
            return;
        }
    }
    pre_phis.push(PrePhi.{ blk: b, base: l.base, off: l.off, ty: t, val: v });
}

// Does instruction x possibly write l?
fn writes_loc(x: *mut ir.Value, l: *Loc) bool {
    let h = writes.len;
    note_writes(x);
    let mut hit = false;
    for w in h..writes.len {
        if may_alias(l, writes.at(w)) {
            hit = true;
        }
    }
    writes.len = h;
    return hit;
}

// The value at l (of type t) at the end of block p, or nil: from a store or
// load of it there (or in the blocks before p while each has one
// successor... while p has one predecessor), with nothing writing it since.
fn value_at_end(p0: *mut ir.Block, l: *Loc, t: *mut ir.Ty, depth: i32) *mut ir.Value {
    let mut p = p0;
    let mut budget: i32 = 400;
    let mut hops: i32 = 0;
    loop {
        let mut x = p.last;
        while u.notnil(x) {
            budget -= 1;
            if budget <= 0 {
                return vnil();
            }
            if (x.op == ir.OP_STORE) and (x.flags == 0) {
                let sl = loc_of(x.b, @bit_cast(i64, x.a.ty.size));
                if (sl.base == l.base) and (sl.off == l.off) and (x.a.ty == t) {
                    return x.a;
                }
                // a lane of a vector stored over it
                let vt = x.a.ty;
                if (sl.base == l.base) and (vt.kind == ir.T_VEC) and (vt.elem == t) and
                   (@as(u64, @bit_cast(u32, t.bits)) == (t.size * 8)) and (l.off >= sl.off) and
                   ((l.off + l.size) <= (sl.off + sl.size)) and (((l.off - sl.off) % l.size) == 0) {
                    ir.at_before(B, x.next);
                    return ir.extract_elem(B, x.a, @bit_cast(u64, (l.off - sl.off) / l.size));
                }
            } else if (x.op == ir.OP_LOAD) and (x.flags == 0) and (x.ty == t) {
                let ll = loc_of(x.a, @bit_cast(i64, t.size));
                if (ll.base == l.base) and (ll.off == l.off) {
                    return x;
                }
            }
            if writes_loc(x, l) {
                return vnil();
            }
            x = x.prev;
        }
        for k in 0..pre_phis.len {
            let e = pre_phis.at(k);
            if (e.blk == p) and (e.base == l.base) and (e.off == l.off) and (e.ty == t) {
                return e.val;  // (nil: not known)
            }
        }
        if (p.preds.len >= 2) and (depth < 8) {
            return value_at_join(p, l, t, depth + 1);
        }
        if (p.preds.len != 1) or (hops >= 8) {
            return vnil();
        }
        let q = p.preds.get(0);
        if (q.rpo < 0) or (q.rpo >= p.rpo) {
            return vnil();
        }
        p = q;
        hops += 1;
    }
}

// The value at l at the start of join b when each predecessor knows it at
// its end: theirs, or a phi of them made there; else nil.
fn value_at_join(b: *mut ir.Block, l: *Loc, t: *mut ir.Ty, depth: i32) *mut ir.Value {
    let np = b.preds.len;
    if (np > 4) or not avail_over(l.base, b) {
        return vnil();
    }
    for k in 0..pre_phis.len {
        let e = pre_phis.at(k);
        if (e.blk == b) and (e.base == l.base) and (e.off == l.off) and (e.ty == t) {
            return e.val;  // (nil: not known)
        }
    }
    let r = join_value(b, l, t, depth);
    pre_phis.push(PrePhi.{ blk: b, base: l.base, off: l.off, ty: t, val: r });
    return r;
}

fn join_value(b: *mut ir.Block, l: *Loc, t: *mut ir.Ty, depth: i32) *mut ir.Value {
    let np = b.preds.len;
    let mut vs: [4]*mut ir.Value = [vnil(), vnil(), vnil(), vnil()];
    for k in 0..np {
        let p = b.preds.get(k);
        if (p.rpo < 0) or (p.rpo >= b.rpo) {
            return vnil();
        }
        for j in 0..k {
            if b.preds.get(j) == p {
                return vnil();
            }
        }
        let v = value_at_end(p, l, t, depth);
        if u.isnil(v) {
            return vnil();
        }
        vs[k] = v;
    }
    let mut same = true;
    for k in 1..np {
        if vs[k] != vs[0] {
            same = false;
        }
    }
    if same {
        return vs[0];
    }
    return make_phi(b, t, vs[0..np]);
}

// A phi in b of vs (from b's predecessors in order): one already there with
// those incoming values, or a new one.
fn make_phi(b: *mut ir.Block, t: *mut ir.Ty, vs: []*mut ir.Value) *mut ir.Value {
    let np = b.preds.len;
    let mut ph = b.first;
    while u.notnil(ph) and (ph.op == ir.OP_PHI) {
        if (ph.ty == t) and (ph.xs.len == np) {
            let mut eq = true;
            for k in 0..np {
                let mut found = false;
                for j in 0..np {
                    if (ph.bs.get(j) == b.preds.get(k)) and (ir.resolve(ph.xs.get(j)) == vs[k]) {
                        found = true;
                    }
                }
                if not found {
                    eq = false;
                }
            }
            if eq {
                return ph;
            }
        }
        ph = ph.next;
    }
    ir.at_before(B, b.first);
    let r = ir.phi(B, t);
    for k in 0..np {
        ir.add_incoming(r, vs[k], b.preds.get(k));
    }
    changed = true;
    return r;
}

// Is v available at the end of every predecessor of b (not defined in b,
// and in a block dominating it)?
fn avail_over(v: *mut ir.Value, b: *mut ir.Block) bool {
    if v.kind != ir.V_INST {
        return true;
    }
    return u.notnil(v.blk) and (v.blk != b) and (v.blk.rpo >= 0) and opt.dominates(v.blk, b);
}

fn pre_loads(f: *mut ir.Func, order: *u.List.[*mut ir.Block]) void {
    pre_phis.clear();
    let vals = u.newn.[*mut ir.Value](8);
    for oi in 0..order.len {
        let b = order.get(oi);
        let np = b.preds.len;
        if (np < 2) or (np > 4) {
            continue;
        }
        let mut fwd = true;
        for k in 0..np {
            let p = b.preds.get(k);
            if (p.rpo < 0) or (p.rpo >= b.rpo) {
                fwd = false;
            }
            for j in 0..k {
                if b.preds.get(j) == p {
                    fwd = false;  // (two edges from one block)
                }
            }
        }
        if not fwd {
            continue;
        }
        let mut i = b.first;
        let mut seen: i32 = 0;
        while u.notnil(i) and (seen < 64) {
            let next = i.next;
            seen += 1;
            if (i.op == ir.OP_LOAD) and (i.flags == 0) and ((i.ty.kind == ir.T_INT) or (i.ty.kind == ir.T_FLOAT)) and
               (i.ty.bits <= 64) {
                pre_load(f, b, i, vals);
            }
            i = next;
        }
    }
}

fn pre_load(f: *mut ir.Func, b: *mut ir.Block, i: *mut ir.Value, vals: []mut *mut ir.Value) void {
    let l = loc_of(i.a, @bit_cast(i64, i.ty.size));
    if not avail_over(l.base, b) {
        return;
    }
    // nothing before i in b writes l
    let mut x = b.first;
    while x != i {
        if writes_loc(x, &l) {
            return;
        }
        x = x.next;
    }
    let np = b.preds.len;
    let mut missing: i32 = -1;
    for k in 0..np {
        let v = value_at_end(b.preds.get(k), &l, i.ty, 0);
        vals[k] = v;
        if u.isnil(v) {
            if missing >= 0 {
                return;
            }
            missing = @int_cast(i32, k);
        }
    }
    if (missing >= 0) and (np < 2) {
        return;
    }
    if missing >= 0 {
        // the load on the edge from that predecessor
        let p = b.preds.get(@int_cast(usize, missing));
        let t = ir.terminator(p);
        let mut at = p;
        if ir.succ_count(t) != 1 {
            let mut n: i32 = 0;
            for k in 0..ir.succ_count(t) {
                if ir.succ(t, k) == b {
                    n += 1;
                }
            }
            if n != 1 {
                return;
            }
            at = ir.split_edge(f, "pre", p, b);
            at.rpo = -1;
            b.preds.set(@int_cast(usize, missing), at);
        }
        ir.at_before(B, ir.terminator(at));
        let mut addr = i.a;
        if not avail_over(addr, b) {
            addr = l.base;
            if l.off != 0 {
                addr = ir.ptradd(B, l.base, ir.cint(ir.isz(), @bit_cast(u64, l.off)));
            }
        }
        let ld = ir.load(B, i.ty, addr);
        ld.align = i.align;
        vals[@int_cast(usize, missing)] = ld;
    }
    if missing < 0 {
        let mut same = true;
        for k in 1..np {
            if vals[k] != vals[0] {
                same = false;
            }
        }
        if same {
            set_pre(b, &l, i.ty, vals[0]);
            replace(i, vals[0]);
            return;
        }
    }
    let ph = make_phi(b, i.ty, vals[0..np]);
    set_pre(b, &l, i.ty, ph);
    replace(i, ph);
}

// -----------------------------------------------------------------------------
// Dead store elimination (within blocks): a store to memory that is written
// again later in the block, with nothing in between that may read it, is
// deleted; so is a store to a private alloca that nothing reads before the
// function returns.
// -----------------------------------------------------------------------------
fn loc_write(l: *Loc) Write {
    return Write.{ kind: W_LOC, base: l.base, obj: l.obj, off: l.off, size: l.size, rok: l.rok, rlo: l.rlo,
                   rhi: l.rhi };
}

// Is a covered by b (both exact)?
fn covers(b: *Loc, a: *Loc) bool {
    return (a.base == b.base) and (a.size >= 0) and (b.size >= 0) and (a.off >= b.off) and
           ((a.off + a.size) <= (b.off + b.size));
}

// Removes the killed locations that the read of r may observe.
fn read_loc(killed: *mut u.List.[Loc], r: *Loc) void {
    let w = loc_write(r);
    let mut k: usize = 0;
    while k < killed.len {
        if may_alias(killed.at(k), &w) {
            killed.set(k, killed.get(killed.len - 1));
            killed.len -= 1;
        } else {
            k += 1;
        }
    }
}

// Keeps only the locations in private allocas (a call or return reads the rest).
fn read_nonprivate(killed: *mut u.List.[Loc]) void {
    let mut k: usize = 0;
    while k < killed.len {
        if not private_obj(killed.get(k).obj) {
            killed.set(k, killed.get(killed.len - 1));
            killed.len -= 1;
        } else {
            k += 1;
        }
    }
}

let mut restored: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0,
                                                                    cap: 0 };
let mut ss_dead: bool = false;

fn ss_reads() void {
    ss_dead = false;
    restored.clear();
}

// Is one of xs an operand of v (transitively)?
fn uses_any(v: *mut ir.Value, xs: *u.List.[*mut ir.Value], depth: i32) bool {
    if u.isnil(v) or (depth > 8) {
        return false;
    }
    for k in 0..xs.len {
        if xs.get(k) == v {
            return true;
        }
    }
    if v.kind != ir.V_INST {
        return false;
    }
    return uses_any(v.a, xs, depth + 1) or uses_any(v.b, xs, depth + 1);
}

fn has_obj(xs: *u.List.[*mut ir.Value], o: *mut ir.Value) bool {
    for k in 0..xs.len {
        if xs.get(k) == o {
            return true;
        }
    }
    return false;
}

fn dse_block(b: *mut ir.Block, killed: *mut u.List.[Loc], read_objs: *mut u.List.[*mut ir.Value]) bool {
    killed.clear();
    read_objs.clear();
    let mut any = false;
    let t = ir.terminator(b);
    // at a return, private allocas are dead unless read later in the block
    let mut at_ret = u.notnil(t) and (t.op == ir.OP_RET);
    // Shadow stack call site slots at or above the depth are never read. A
    // push stores the site at slots[D] for the depth D it loaded, and the
    // pop stores D back; a slot store followed by the store of the depth its
    // index was computed from (or by the return), with no call, trap or
    // load of the slots in between, is dead.
    ss_dead = at_ret;
    restored.clear();
    let mut i = b.last;
    while u.notnil(i) {
        let prev = i.prev;
        let op = i.op;
        if op == ir.OP_STORE {
            if i.flags != 0 {
                killed.clear();
                at_ret = false;
                ss_reads();
            } else {
                let l = loc_of(i.b, @bit_cast(i64, i.a.ty.size));
                let sf = ss_field(&l);
                let mut dead = at_ret and private_obj(l.obj) and not has_obj(read_objs, l.obj);
                if (sf == 2) and (ss_dead or uses_any(i.b, &restored, 0)) {
                    dead = true;
                }
                if sf == 0 {
                    restored.push(i.a);
                }
                for k in 0..killed.len {
                    if covers(killed.at(k), &l) {
                        dead = true;
                    }
                }
                if dead {
                    ir.remove_inst(i);
                    any = true;
                } else if (killed.len < 32) and (l.size >= 0) {
                    killed.push(l);
                }
            }
        } else if op == ir.OP_LOAD {
            if i.flags != 0 {
                killed.clear();
                at_ret = false;
                ss_reads();
            } else {
                let l = loc_of(i.a, @bit_cast(i64, i.ty.size));
                read_loc(killed, &l);
                if noalias_global(l.obj) and (ss_field(&l) != 0) {
                    ss_reads();
                }
                if u.notnil(l.obj) {
                    read_objs.push(l.obj);
                }
            }
        } else if (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE) {
            let s = loc_of(i.b, size_of(i.c));
            read_loc(killed, &s);
            if u.notnil(s.obj) {
                read_objs.push(s.obj);
            }
            if noalias_global(s.obj) {
                ss_reads();
            }
            let d = loc_of(i.a, size_of(i.c));
            if (killed.len < 32) and (d.size >= 0) {
                killed.push(d);
            }
        } else if op == ir.OP_MEMSET {
            let d = loc_of(i.a, size_of(i.c));
            if (killed.len < 32) and (d.size >= 0) {
                killed.push(d);
            }
        } else if (op == ir.OP_CALL) or (op == ir.OP_RET) {
            read_nonprivate(killed);
            if op == ir.OP_CALL {
                ss_reads();
            }
        } else if (op == ir.OP_RMW) or (op == ir.OP_CMPXCHG) or (op == ir.OP_FENCE) {
            killed.clear();
            at_ret = false;
            ss_reads();
        } else if ir.intr_id(i) == ir.IN_LOAD_PARTIAL {
            let l = partial_loc(i);
            read_loc(killed, &l);
            if noalias_global(l.obj) and (ss_field(&l) != 0) {
                ss_reads();
            }
            if u.notnil(l.obj) {
                read_objs.push(l.obj);
            }
        } else if (ir.intr_id(i) == ir.IN_STORE_PARTIAL) or ir.is_prefetch(ir.intr_id(i)) {
            // (writes part of its location: nothing it makes dead, nothing it
            // reads; a prefetch neither reads nor writes)
        } else if ir.intr_opaque(ir.intr_id(i)) {
            killed.clear();
            at_ret = false;
            ss_reads();
        }
        i = prev;
    }
    return any;
}

pub fn dse(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    escapes(f);
    let mut killed = u.List.[Loc].empty();
    let mut read_objs = u.List.[*mut ir.Value].empty();
    let mut any = false;
    let mut b = f.first;
    while u.notnil(b) {
        if dse_block(b, &mut killed, &mut read_objs) {
            any = true;
        }
        b = b.next;
    }
    killed.deinit();
    read_objs.deinit();
    return any;
}

// -----------------------------------------------------------------------------
// Shadow stack pushes and pops across blocks. Every call leaves the depth as
// it found it (it restores what it pushed), and slots at or above the depth
// are never read. So:
//   - a push (a call-site slot store, or a depth store) is dead when every
//     path from it overwrites what it wrote (a slot: the depth its index came
//     from is stored back; the depth: another depth store) before a call, a
//     trap or a load of the shadow stack (for the depth also a return);
//   - storing V to the depth is redundant when on every path back to it the
//     last depth store stored V too, or V is the value the depth was loaded
//     as, with only calls in between.
// (Profiling builds make these stores volatile: they are left alone.)
// -----------------------------------------------------------------------------
fn ss_store_field(i: *ir.Value) i32 {
    if (i.op != ir.OP_STORE) or (i.flags != 0) {
        return -1;
    }
    let l = loc_of(i.b, @bit_cast(i64, i.a.ty.size));
    return ss_field(&l);
}

// Does i read the shadow stack (for the depth: returns too)?
fn ss_reader(i: *mut ir.Value, depth: bool) bool {
    let op = i.op;
    if (op == ir.OP_CALL) or (op == ir.OP_RMW) or (op == ir.OP_CMPXCHG) or (op == ir.OP_FENCE) {
        return true;
    }
    if ir.intr_id(i) == ir.IN_LOAD_PARTIAL {
        let l = partial_loc(i);
        return noalias_global(l.obj);
    }
    if (ir.intr_id(i) == ir.IN_STORE_PARTIAL) or ir.is_prefetch(ir.intr_id(i)) {
        return false;
    }
    if ir.intr_opaque(ir.intr_id(i)) {
        return true;
    }
    if (op == ir.OP_RET) and depth {
        return true;
    }
    if (op == ir.OP_STORE) and (i.flags != 0) {
        return true;
    }
    if op == ir.OP_LOAD {
        if i.flags != 0 {
            return true;
        }
        let l = loc_of(i.a, @bit_cast(i64, i.ty.size));
        return noalias_global(l.obj);
    }
    if (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE) {
        let l = loc_of(i.b, size_of(i.c));
        return noalias_global(l.obj);
    }
    return false;
}

let mut ss_work: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0,
                                                                   cap: 0 };
let mut ss_one: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0,
                                                                  cap: 0 };
let mut ss_mark: i64 = 0;

// Is the push store s dead (see above)? Forward over the paths from s.
fn push_dead(s: *mut ir.Value, slot: bool) bool {
    return dead_from(s.next, s, slot);
}

// ... over the paths from instruction `from` on.
fn dead_from(from: *mut ir.Value, s: *mut ir.Value, slot: bool) bool {
    ss_mark += 1;
    ss_work.clear();
    ss_work.push(from);  // where to scan from
    let mut blocks: i32 = 0;
    while ss_work.len > 0 {
        let mut i = ss_work.pop();
        loop {
            if ss_store_field(i) == 0 {
                // a depth store overwrites a depth push; a slot dies with the
                // store of the depth its index came from
                if not slot {
                    break;
                }
                ss_one.clear();
                ss_one.push(i.a);
                if uses_any(s.b, &ss_one, 0) {
                    break;
                }
            } else if ss_reader(i, not slot) {
                return false;
            } else if i.op == ir.OP_RET {
                break;  // slots end with the function
            }
            if ir.is_term(i.op) {
                for k in 0..ir.succ_count(i) {
                    let sb = ir.succ(i, k);
                    if sb.mark != ss_mark {
                        sb.mark = ss_mark;
                        blocks += 1;
                        if u.isnil(sb.first) or (blocks > 64) {
                            return false;
                        }
                        ss_work.push(sb.first);
                    }
                }
                break;
            }
            i = i.next;
        }
    }
    return true;
}

// Is storing s.a to the depth redundant (see above)? Backward over the paths
// to s: every path must reach a depth store of the same value, or the load
// that produced it, with no other depth store on the way.
fn restore_redundant(s: *mut ir.Value) bool {
    let v = s.a;
    ss_mark += 1;
    ss_work.clear();
    ss_work.push(s);  // scan backwards from before it
    let mut blocks: i32 = 0;
    while ss_work.len > 0 {
        let from = ss_work.pop();
        let mut i = from.prev;
        let b = from.blk;
        let mut found = false;
        while u.notnil(i) and not found {
            if i == v {
                // the load v (of the depth, when it is one) is the start
                if (v.op == ir.OP_LOAD) and (v.flags == 0) {
                    let l = loc_of(v.a, 4);
                    if ss_field(&l) == 0 {
                        found = true;
                        continue;
                    }
                }
                return false;
            }
            if ss_store_field(i) == 0 {
                if i.a != v {
                    return false;
                }
                found = true;
                continue;
            }
            if (i.op == ir.OP_STORE) and (i.flags != 0) {
                return false;  // profiling
            }
            i = i.prev;
        }
        if found {
            continue;
        }
        // the start of b: every predecessor's end
        if b.preds.len == 0 {
            return false;  // the function's entry
        }
        for k in 0..b.preds.len {
            let p = b.preds.get(k);
            if p.mark != ss_mark {
                p.mark = ss_mark;
                blocks += 1;
                if blocks > 64 {
                    return false;
                }
                let t = ir.terminator(p);
                if u.isnil(t) {
                    return false;
                }
                ss_work.push(t);
            }
        }
    }
    return true;
}

// A store of the shadow stack read only on uncommon paths (the calls and
// traps of an inlined function's slow path and checks) moves to just before
// each instruction that reads it, off the common path. The readers are found
// forward from the store up to what overwrites it (see push_dead); each must
// be in a block the store's block dominates, no deeper in loops, and not
// reachable from an overwrite without passing the store's block again.
let mut rd_found: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0,
                                                                    cap: 0 };
let mut ow_found: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0,
                                                                    cap: 0 };

// The readers of s forward from `from` (false: too far, or a return).
fn readers_of(from: *mut ir.Value, s: *mut ir.Value, slot: bool) bool {
    rd_found.clear();
    ow_found.clear();
    ss_mark += 1;
    ss_work.clear();
    ss_work.push(from);
    let mut blocks: i32 = 0;
    while ss_work.len > 0 {
        let mut i = ss_work.pop();
        loop {
            if ss_store_field(i) == 0 {
                let mut over = not slot;
                if slot {
                    ss_one.clear();
                    ss_one.push(i.a);
                    over = uses_any(s.b, &ss_one, 0);
                }
                if over {
                    ow_found.push(i);
                    break;
                }
            } else if i.op == ir.OP_RET {
                if not slot {
                    return false;  // (the depth must be restored before)
                }
                break;
            } else if ss_reader(i, not slot) {
                rd_found.push(i);
                break;  // (a copy goes before it; beyond, the path has it)
            }
            if ir.is_term(i.op) {
                for k in 0..ir.succ_count(i) {
                    let sb = ir.succ(i, k);
                    if sb.mark != ss_mark {
                        sb.mark = ss_mark;
                        blocks += 1;
                        if u.isnil(sb.first) or (blocks > 64) or (sb.rpo < 0) {
                            return false;
                        }
                        ss_work.push(sb.first);
                    }
                }
                break;
            }
            i = i.next;
        }
    }
    return true;
}

// Can an overwrite reach one of the readers without passing through b?
fn overwrite_reaches(b: *mut ir.Block) bool {
    ss_mark += 1;
    b.mark = ss_mark;
    ss_work.clear();
    for k in 0..ow_found.len {
        ss_work.push(ow_found.get(k).next);
    }
    let mut blocks: i32 = 0;
    while ss_work.len > 0 {
        let mut i = ss_work.pop();
        while u.notnil(i) {
            for k in 0..rd_found.len {
                if rd_found.get(k) == i {
                    return true;
                }
            }
            if ir.is_term(i.op) {
                for k in 0..ir.succ_count(i) {
                    let sb = ir.succ(i, k);
                    if sb.mark != ss_mark {
                        sb.mark = ss_mark;
                        blocks += 1;
                        if blocks > 128 {
                            return true;
                        }
                        ss_work.push(sb.first);
                    }
                }
                break;
            }
            i = i.next;
        }
    }
    return false;
}

fn sink_ss_store(s: *mut ir.Value, sf: i32) bool {
    let slot = sf != 0;
    let b = s.blk;
    if not readers_of(s.next, s, slot) or (rd_found.len == 0) {
        return false;
    }
    for k in 0..rd_found.len {
        let q = rd_found.get(k).blk;
        if (q == b) or not opt.dominates(b, q) or (q.loop_depth > b.loop_depth) {
            return false;
        }
    }
    if overwrite_reaches(b) {
        return false;
    }
    for k in 0..rd_found.len {
        let r = rd_found.get(k);
        let c = ir.new_inst(b.fnp, ir.OP_STORE, s.ty);
        c.a = s.a;
        c.b = s.b;
        c.align = s.align;
        c.flags = s.flags;
        ir.insert_before(r, c);
    }
    ir.remove_inst(s);
    return true;
}

// True if anything changed.
pub fn ss_opt(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    let mut any = false;
    let mut rounds: i32 = 0;
    loop {
        opt.compute_preds(f);
        let mut moved = false;
        let mut b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                let next = i.next;
                let sf = ss_store_field(i);
                if (sf == 2) and push_dead(i, true) {
                    ir.remove_inst(i);
                    moved = true;
                } else if (sf == 0) and push_dead(i, false) {
                    ir.remove_inst(i);
                    moved = true;
                }
                i = next;
            }
            b = b.next;
        }
        b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                let next = i.next;
                if (ss_store_field(i) == 0) and restore_redundant(i) {
                    ir.remove_inst(i);
                    moved = true;
                }
                i = next;
            }
            b = b.next;
        }
        // stores read on some paths only: to their readers
        rounds += 1;
        if rounds <= 2 {
            let order = opt.dominators(f);
            opt.loop_depths(f, &order);
            order.deinit();
            b = f.first;
            while u.notnil(b) {
                let mut i = b.last;
                while u.notnil(i) {
                    let prev = i.prev;
                    let sf = ss_store_field(i);
                    if ((sf == 0) or (sf == 2)) and sink_ss_store(i, sf) {
                        moved = true;
                    }
                    i = prev;
                }
                b = b.next;
            }
        }
        if not moved {
            break;
        }
        any = true;
        if rounds > 8 {
            break;
        }
    }
    return any;
}

// -----------------------------------------------------------------------------
// Loop-invariant code motion: instructions of a loop whose operands come
// from outside it move to its preheader (inner loops first, so they can
// move out of several). Hoisted: operations without effects that cannot
// trap (divisions only by a nonzero constant), and loads that no write in
// the loop may alias and that may run early: in the header (which runs
// whenever the loop is entered), or within a stack slot or global.
// -----------------------------------------------------------------------------
fn licm_speculatable(i: *ir.Value) bool {
    let op = i.op;
    if ir.is_int_div(op) {
        if not ir.is_cint(i.b) or (ir.cint_val(i.b) == 0) {
            return false;
        }
        // (a signed division by -1 overflows for MIN: the checks come first)
        return ((op == ir.OP_UDIV) or (op == ir.OP_UREM)) or (ir.sval(i.b) != -1);
    }
    return cse_able(i);
}

let mut loop_mark: i64 = 0x1000_0000;

// A preheader for h (members marked `tag`): the only outside predecessor
// when it ends in `br h`, else a new block the outside edges go through.
fn make_preheader(f: *mut ir.Func, h: *mut ir.Block, tag: i64) bool {
    let mut outside = u.List.[*mut ir.Block].empty();
    for k in 0..h.preds.len {
        let p = h.preds.get(k);
        if p.mark != tag {
            outside.push(p);
        }
    }
    let mut made = false;
    if (outside.len == 1) and (ir.succ_count(ir.terminator(outside.get(0))) == 1) {
        // already one
    } else if outside.len > 0 {
        let pre = ir.append_block(f, "preheader");
        let br = ir.new_inst(f, ir.OP_BR, ir.t_void());
        br.t1 = h;
        ir.append_inst(pre, br);
        for k in 0..outside.len {
            ir.retarget(outside.get(k), h, pre);
        }
        // h's phis: the outside inputs merge in the preheader
        let bld = ir.new_builder();
        let mut p = h.first;
        while u.notnil(p) and (p.op == ir.OP_PHI) {
            let mut np = vnil();
            if outside.len > 1 {
                ir.at_before(bld, br);
                np = ir.phi(bld, p.ty);
            }
            let mut k: usize = 0;
            while k < p.bs.len {
                let from = p.bs.get(k);
                if from.mark != tag {
                    if u.notnil(np) {
                        ir.add_incoming(np, p.xs.get(k), from);
                        ir.remove_incoming(p, k);
                        continue;
                    }
                    p.bs.set(k, pre);
                }
                k += 1;
            }
            if u.notnil(np) {
                ir.add_incoming(p, np, pre);
            }
            p = p.next;
        }
        made = true;
    }
    outside.deinit();
    return made;
}

// Is the load at l safe to run before the loop without the loop's guard?
fn deref_ok(l: *Loc, size: i64) bool {
    if u.isnil(l.obj) or not l.rok or (l.rlo < 0) {
        return false;
    }
    let mut objsize: u64 = 0;
    if ir.is_op(l.obj, ir.OP_ALLOCA) {
        objsize = l.obj.aty.size;
    } else if l.obj.kind == ir.V_GLOBAL {
        if l.obj.gv.tls {
            return false;
        }
        objsize = l.obj.gv.ty.size;
    } else {
        return false;
    }
    return (l.rhi + size) <= @bit_cast(i64, objsize);
}

pub fn licm(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    // preheaders
    opt.compute_preds(f);
    let mut order = opt.dominators(f);
    let mut hs = opt.loop_headers(&order);
    if hs.len == 0 {
        order.deinit();
        return false;
    }
    let mut members = u.List.[*mut ir.Block].empty();
    let mut made = false;
    for k in 0..hs.len {
        loop_mark += 1;
        opt.members_of(hs.get(k), loop_mark, &mut members);
        if make_preheader(f, hs.get(k), loop_mark) {
            made = true;
        }
    }
    if made {
        order.deinit();
        hs.deinit();
        opt.compute_preds(f);
        order = opt.dominators(f);
        hs = opt.loop_headers(&order);
    }
    escapes(f);
    // loops entered through a guard, whose first body block then runs
    // whenever the preheader does (its loads hoisted like the header's)
    guarded.clear();
    let mut gd = false;
    for k in 0..hs.len {
        loop_mark += 1;
        opt.members_of(hs.get(k), loop_mark, &mut members);
        if guard_loop(f, hs.get(k), loop_mark, &members) {
            gd = true;
        }
    }
    if gd {
        order.deinit();
        hs.deinit();
        opt.compute_preds(f);
        order = opt.dominators(f);
        hs = opt.loop_headers(&order);
    }
    // inner loops first
    for i in 1..hs.len {
        let mut j = i;
        while (j > 0) and (hs.get(j - 1).depth < hs.get(j).depth) {
            let t = hs.get(j - 1);
            hs.set(j - 1, hs.get(j));
            hs.set(j, t);
            j -= 1;
        }
    }
    let mut any = false;
    for hi in 0..hs.len {
        let h = hs.get(hi);
        loop_mark += 1;
        let tag = loop_mark;
        opt.members_of(h, tag, &mut members);
        let mut pre = ir.bnil();
        for k in 0..h.preds.len {
            if h.preds.get(k).mark != tag {
                pre = h.preds.get(k);
            }
        }
        if u.isnil(pre) or (ir.succ_count(ir.terminator(pre)) != 1) {
            continue;
        }
        let at = ir.terminator(pre);
        // the loop's writes (for loads)
        writes.clear();
        for k in 0..members.len {
            let mut i = members.get(k).first;
            while u.notnil(i) {
                note_writes(i);
                i = i.next;
            }
        }
        // in dominance order: the header first, then the rest by rpo
        if members.len > 2 {
            sort_by_rpo(members.items()[1..members.len]);
        }
        let first = first_body(h, tag);
        for k in 0..members.len {
            let b = members.get(k);
            let mut i = b.first;
            while u.notnil(i) {
                let next = i.next;
                if hoist_ok(i, tag, (b == h) or (b == first)) {
                    ir.remove_inst(i);
                    ir.insert_before(at, i);
                    any = true;
                }
                i = next;
            }
        }
    }
    members.deinit();
    order.deinit();
    hs.deinit();
    return any or made;
}

// -----------------------------------------------------------------------------
// Loop guards. A loop whose header only computes its exit test (phis, pure
// arithmetic, a branch out or into the body's first block S, entered only
// from the header) and whose values are not used outside it can be entered
// through a copy of the test: P -> G (the test on the entry values) -> P2 ->
// H, G going straight to the exit when it fails. Then S runs whenever P2
// does, and the loads of S that the loop does not write can move to P2
// although nothing else shows their addresses are readable. Only for loops
// with such a load.
// -----------------------------------------------------------------------------
let mut guarded: u.List.[*mut ir.Block] = u.List.[*mut ir.Block].{ data: @ptr_from_int(*mut *mut ir.Block, 0), len: 0,
                                                                   cap: 0 };

// The body's first block of a guarded loop with header h (nil otherwise).
fn first_body(h: *mut ir.Block, tag: i64) *mut ir.Block {
    let mut g = false;
    for k in 0..guarded.len {
        if guarded.get(k) == h {
            g = true;
        }
    }
    if not g {
        return ir.bnil();
    }
    let t = ir.terminator(h);
    if u.isnil(t) or (t.op != ir.OP_CONDBR) {
        return ir.bnil();
    }
    let mut s = t.t1;
    if s.mark != tag {
        s = t.t2;
    }
    if (s.mark != tag) or (s == h) or (s.preds.len != 1) {
        return ir.bnil();
    }
    return s;
}

fn guard_map(v: *mut ir.Value, h: *mut ir.Block, pre: *mut ir.Block) *mut ir.Value {
    if u.notnil(v) and (v.kind == ir.V_INST) and (v.blk == h) {
        if v.op == ir.OP_PHI {
            return ir.incoming(v, pre);
        }
        return @ptr_cast(*mut ir.Value, v.auxp);
    }
    return v;
}

fn defined_in(v: *ir.Value, h: *mut ir.Block) bool {
    return u.notnil(v) and (v.kind == ir.V_INST) and (v.blk == h);
}

fn guard_loop(f: *mut ir.Func, h: *mut ir.Block, tag: i64, members: *u.List.[*mut ir.Block]) bool {
    let mut pre = ir.bnil();
    for k in 0..h.preds.len {
        if h.preds.get(k).mark != tag {
            if u.notnil(pre) {
                return false;
            }
            pre = h.preds.get(k);
        }
    }
    if u.isnil(pre) or (ir.succ_count(ir.terminator(pre)) != 1) {
        return false;
    }
    let t = ir.terminator(h);
    if u.isnil(t) or (t.op != ir.OP_CONDBR) or (t.t1 == t.t2) {
        return false;
    }
    let mut s = t.t1;
    let mut x = t.t2;
    if s.mark != tag {
        s = t.t2;
        x = t.t1;
    }
    if (s.mark != tag) or (x.mark == tag) or (s == h) or (s.preds.len != 1) {
        return false;
    }
    // the header: a test of no effect, cheap to copy
    let mut n: i32 = 0;
    let mut i = h.first;
    while u.notnil(i) and (i != t) {
        if i.op != ir.OP_PHI {
            if ir.has_effects(i) or (i.op == ir.OP_LOAD) or (i.op == ir.OP_CALL) or (i.op == ir.OP_ALLOCA) or
               (i.op == ir.OP_INTR) {
                return false;
            }
            n += 1;
        }
        i = i.next;
    }
    if n > 8 {
        return false;
    }
    // a load of S to hoist that only the guard makes safe
    writes.clear();
    for k in 0..members.len {
        let mut w = members.get(k).first;
        while u.notnil(w) {
            note_writes(w);
            w = w.next;
        }
    }
    let mut want = false;
    i = s.first;
    while u.notnil(i) and not want {
        if (i.op == ir.OP_LOAD) and hoist_ok(i, tag, true) and not hoist_ok(i, tag, false) {
            want = true;
        }
        i = i.next;
    }
    if not want {
        return false;
    }
    // the header's values used only in the loop (and by the exit's phis on
    // the edge from the header)
    let mut b = f.first;
    while u.notnil(b) {
        if b.mark != tag {
            let mut y = b.first;
            while u.notnil(y) {
                if y.op == ir.OP_PHI {
                    for k in 0..y.xs.len {
                        let from = y.bs.get(k);
                        if defined_in(ir.resolve(y.xs.get(k)), h) and (from.mark != tag) {
                            return false;
                        }
                    }
                } else if defined_in(y.a, h) or defined_in(y.b, h) or defined_in(y.c, h) {
                    return false;
                } else {
                    for k in 0..y.xs.len {
                        if defined_in(y.xs.get(k), h) {
                            return false;
                        }
                    }
                }
                y = y.next;
            }
        }
        b = b.next;
    }
    // P -> G -> P2 -> H
    let g = ir.append_block(f, "guard");
    ir.move_block_after(g, pre);
    let p2 = ir.append_block(f, "preheader");
    ir.move_block_after(p2, g);
    i = h.first;
    while u.notnil(i) and (i != t) {
        if i.op != ir.OP_PHI {
            let y = ir.copy_inst(f, i);
            y.a = guard_map(y.a, h, pre);
            y.b = guard_map(y.b, h, pre);
            y.c = guard_map(y.c, h, pre);
            for k in 0..y.xs.len {
                y.xs.set(k, guard_map(y.xs.get(k), h, pre));
            }
            i.auxp = @ptr_cast(*mut void, y);
            ir.append_inst(g, y);
        }
        i = i.next;
    }
    let gb = ir.new_builder();
    ir.at_end(gb, g);
    let c = guard_map(t.a, h, pre);
    if t.t1 == s {
        ir.condbr(gb, c, p2, x);
    } else {
        ir.condbr(gb, c, x, p2);
    }
    ir.at_end(gb, p2);
    ir.br(gb, h);
    // the exit's phis: on the way from G, the header's values as G has them
    let mut q = x.first;
    while u.notnil(q) and (q.op == ir.OP_PHI) {
        let v = ir.incoming(q, h);
        if u.notnil(v) {
            ir.add_incoming(q, guard_map(ir.resolve(v), h, pre), g);
        }
        q = q.next;
    }
    ir.retarget(pre, h, g);
    q = h.first;
    while u.notnil(q) and (q.op == ir.OP_PHI) {
        for k in 0..q.bs.len {
            if q.bs.get(k) == pre {
                q.bs.set(k, p2);
            }
        }
        q = q.next;
    }
    // (the predecessor lists and loop marks as they now are, for the loops
    // looked at next)
    g.preds.push(pre);
    p2.preds.push(g);
    for k in 0..h.preds.len {
        if h.preds.get(k) == pre {
            h.preds.set(k, p2);
        }
    }
    x.preds.push(g);
    g.mark = pre.mark;
    p2.mark = pre.mark;
    guarded.push(h);
    return true;
}

// Blocks into increasing rpo (each block's own: no two equal).
let mut rpo_keys: u.List.[usize] = u.List.[usize].{ data: @ptr_from_int(*mut usize, 0), len: 0, cap: 0 };
let mut rpo_was: u.List.[*mut ir.Block] = u.List.[*mut ir.Block].{ data: @ptr_from_int(*mut *mut ir.Block, 0), len: 0,
                                                                   cap: 0 };

fn sort_by_rpo(bs: []mut *mut ir.Block) void {
    rpo_keys.clear();
    rpo_was.clear();
    for k in 0..bs.len {
        rpo_keys.push((@as(usize, @bit_cast(u32, bs[k].rpo)) << 32) | k);
        rpo_was.push(bs[k]);
    }
    u.sort_usize(rpo_keys.items());
    for k in 0..bs.len {
        bs[k] = rpo_was.get(rpo_keys.get(k) & 0xffff_ffff);
    }
}

fn invariant(o: *ir.Value, tag: i64) bool {
    return u.isnil(o) or (o.kind != ir.V_INST) or u.isnil(o.blk) or (o.blk.mark != tag);
}

fn hoist_ok(i: *mut ir.Value, tag: i64, in_header: bool) bool {
    if (i.op == ir.OP_PHI) or ir.is_term(i.op) {
        return false;
    }
    if not invariant(i.a, tag) or not invariant(i.b, tag) or not invariant(i.c, tag) {
        return false;
    }
    for k in 0..i.xs.len {
        if not invariant(i.xs.get(k), tag) {
            return false;
        }
    }
    if i.op == ir.OP_LOAD {
        if (i.flags != 0) or (i.ty.kind == ir.T_VOID) {
            return false;
        }
        let sz = @bit_cast(i64, i.ty.size);
        let l = loc_of(i.a, sz);
        if not in_header and not deref_ok(&l, sz) {
            return false;
        }
        for w in 0..writes.len {
            if may_alias(&l, writes.at(w)) {
                return false;
            }
        }
        return true;
    }
    return licm_speculatable(i);
}

// -----------------------------------------------------------------------------
// Loop idioms: a loop that only stores a loop-invariant value to consecutive
// elements
//     H: i = phi [start, pre], [i + 1, B];  condbr (i <u end) -> B, exit
//     B: store v, base + i * size;  br H
// is one memset before it (v a byte, or a constant whose bytes are equal),
// when nothing after the loop uses its values.
// -----------------------------------------------------------------------------
fn same_bytes(v: *ir.Value) i64 {
    if v.ty.kind != ir.T_INT {
        if ir.is_zero(v) and (v.kind != ir.V_INST) {
            return 0;
        }
        return -1;
    }
    if not ir.is_cint(v) {
        return -1;
    }
    let x = ir.cint_val(v);
    let b = x & 0xff;
    let n = @truncate(u32, v.ty.size);
    for k in 1..n {
        if ((x >> (k * 8)) & 0xff) != b {
            return -1;
        }
    }
    return @bit_cast(i64, b);
}

// The element index of an address base + i * size (or base + i for bytes).
fn strided(p: *mut ir.Value, i: *mut ir.Value, size: u64) *mut ir.Value {
    if not ir.is_op(p, ir.OP_PTRADD) {
        return vnil();
    }
    let off = p.b;
    if (size == 1) and (off == i) {
        return p.a;
    }
    if ir.is_op(off, ir.OP_MUL) and (off.a == i) and ir.is_cint(off.b) and (ir.cint_val(off.b) == size) {
        return p.a;
    }
    if ir.is_op(off, ir.OP_SHL) and (off.a == i) and ir.is_cint(off.b) and (ir.cint_val(off.b) < 8) and
       ((@as(u64, 1) << @truncate(u32, ir.cint_val(off.b))) == size) {
        return p.a;
    }
    return vnil();
}

fn used_outside(f: *mut ir.Func, tag: i64) bool {
    let mut b = f.first;
    while u.notnil(b) {
        if b.mark != tag {
            let mut i = b.first;
            while u.notnil(i) {
                let ops: [3]*mut ir.Value = [i.a, i.b, i.c];
                for o in ops {
                    if u.notnil(o) and (o.kind == ir.V_INST) and u.notnil(o.blk) and (o.blk.mark == tag) {
                        return true;
                    }
                }
                for k in 0..i.xs.len {
                    let o = i.xs.get(k);
                    if (o.kind == ir.V_INST) and u.notnil(o.blk) and (o.blk.mark == tag) {
                        return true;
                    }
                }
                i = i.next;
            }
        }
        b = b.next;
    }
    return false;
}

fn try_memset(f: *mut ir.Func, h: *mut ir.Block, tag: i64, members: *u.List.[*mut ir.Block]) bool {
    if members.len != 2 {
        return false;
    }
    let mut body = members.get(0);
    if body == h {
        body = members.get(1);
    }
    let ht = ir.terminator(h);
    let bt = ir.terminator(body);
    if u.isnil(ht) or u.isnil(bt) or (ht.op != ir.OP_CONDBR) or (bt.op != ir.OP_BR) or (bt.t1 != h) {
        return false;
    }
    // header: one phi and the test
    let i = h.first;
    if u.isnil(i) or (i.op != ir.OP_PHI) or (i.xs.len != 2) or u.isnil(i.next) or (i.next.op == ir.OP_PHI) {
        return false;
    }
    let c = ht.a;
    if not ir.is_op(c, ir.OP_ICMP) or (c.a != i) or (c.blk != h) or (c.next != ht) or (i.next != c) {
        return false;
    }
    let p = ir.pred_of(c);
    let mut exit = ht.t2;
    if (p == ir.IntULT) and (ht.t1 == body) {
        exit = ht.t2;
    } else if (p == ir.IntUGE) and (ht.t2 == body) {
        exit = ht.t1;
    } else {
        return false;
    }
    let end = c.b;
    if not invariant(end, tag) or (i.ty.kind != ir.T_INT) or (i.ty.bits > ir.isz().bits) {
        return false;
    }
    let mut pre = ir.bnil();
    let mut start = vnil();
    let mut next = vnil();
    for k in @as(usize, 0)..2 {
        if i.bs.get(k) == body {
            next = i.xs.get(k);
        } else {
            pre = i.bs.get(k);
            start = i.xs.get(k);
        }
    }
    if u.isnil(pre) or u.isnil(next) or not invariant(start, tag) or (ir.succ_count(ir.terminator(pre)) != 1) {
        return false;
    }
    // body: the store, the address and i + 1 only
    let mut st = vnil();
    let mut x = body.first;
    while u.notnil(x) and (x != bt) {
        if x.op == ir.OP_STORE {
            if u.notnil(st) {
                return false;
            }
            st = x;
        } else if not cse_able(x) {
            return false;
        }
        x = x.next;
    }
    if u.isnil(st) or (st.flags != 0) or not invariant(st.a, tag) {
        return false;
    }
    if not (ir.is_op(next, ir.OP_ADD) and (next.a == i) and cb.is_kv1(next.b)) {
        return false;
    }
    let size = st.a.ty.size;
    let mut byte = vnil();
    if (size == 1) and (st.a.ty.kind == ir.T_INT) and (st.a.ty.bits == 8) {
        byte = st.a;
    } else {
        let bv = same_bytes(st.a);
        if bv < 0 {
            return false;
        }
        byte = ir.cint(ir.t_int(8), @bit_cast(u64, bv));
    }
    let base = strided(st.b, i, size);
    if u.isnil(base) or not invariant(base, tag) {
        return false;
    }
    if used_outside(f, tag) or (u.notnil(exit.first) and (exit.first.op == ir.OP_PHI)) {
        return false;
    }
    // memset(base + start * size, byte, (start < end ? end - start : 0) * size)
    let bld = ir.new_builder();
    let pt = ir.terminator(pre);
    ir.at_before(bld, pt);
    let isz = ir.isz();
    let s = ir.cast(bld, ir.OP_ZEXT, start, isz);
    let e = ir.cast(bld, ir.OP_ZEXT, end, isz);
    let lt = ir.icmp(bld, ir.IntULT, s, e);
    let n = ir.select(bld, lt, ir.sub(bld, e, s), ir.cint(isz, 0));
    let bytes = ir.mul(bld, n, ir.cint(isz, size));
    let dst = ir.ptradd(bld, base, ir.mul(bld, s, ir.cint(isz, size)));
    _ = ir.memop(bld, ir.OP_MEMSET, dst, byte, bytes);
    pt.t1 = exit;
    return true;
}

// True if anything changed.
pub fn loop_idioms(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    opt.compute_preds(f);
    let order = opt.dominators(f);
    let hs = opt.loop_headers(&order);
    let mut members = u.List.[*mut ir.Block].empty();
    let mut any = false;
    for k in 0..hs.len {
        loop_mark += 1;
        opt.members_of(hs.get(k), loop_mark, &mut members);
        if try_memset(f, hs.get(k), loop_mark, &members) {
            any = true;
            break;  // the CFG changed: again later
        }
    }
    members.deinit();
    order.deinit();
    hs.deinit();
    if any {
        ir.remove_unreachable(f);
    }
    return any;
}

// -----------------------------------------------------------------------------
// Range splitting for bounds checks: a loop whose header leaves it when
// i >= end, and whose body checks i < L (L invariant, the failing side
// trapping), first runs as a copy that leaves when i >= min(end, L, ...), in
// which the checks always pass (value numbering removes them), then as
// itself from where the copy stopped: done at once when end <= L, else on to
// the failing check.
//     pre -> H' (the copy) ... H' -> mid -> H (the loop) ... H -> exit
// Every other way out of the loop must be to a block that traps and uses
// nothing computed in the loop.
// -----------------------------------------------------------------------------
const SPLIT_MAX: i32 = 160;  // instructions in a loop that is copied

fn trap_exit(x: *mut ir.Block, tag: i64) bool {
    let t = ir.terminator(x);
    if (x.mark == tag) or u.isnil(t) or (t.op != ir.OP_UNREACHABLE) {
        return false;
    }
    let mut i = x.first;
    while u.notnil(i) {
        if (i.op == ir.OP_PHI) or not invariant(i.a, tag) or not invariant(i.b, tag) or not invariant(i.c, tag) {
            return false;
        }
        for k in 0..i.xs.len {
            if not invariant(i.xs.get(k), tag) {
                return false;
            }
        }
        i = i.next;
    }
    return true;
}

// The invariant terms of the sum v of i and them, in split_terms; the
// number of times i is a term (-1: v is not such a sum).
let mut split_terms: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0),
                                                                       len: 0, cap: 0 };

fn sum_terms(v0: *mut ir.Value, i: *mut ir.Value, tag: i64, depth: i32) i32 {
    let v = ir.resolve(v0);
    if v == i {
        return 1;
    }
    if invariant(v, tag) {
        split_terms.push(v);
        return 0;
    }
    if (depth > 4) or not ir.is_op(v, ir.OP_ADD) or (v.ty != i.ty) {
        return -1;
    }
    let a = sum_terms(v.a, i, tag, depth + 1);
    if a < 0 {
        return -1;
    }
    let b = sum_terms(v.b, i, tag, depth + 1);
    if b < 0 {
        return -1;
    }
    return a + b;
}

// The bound L of a check i < L ending block x (trapping otherwise), or nil;
// of a check i + d < L (d invariant: an index from a base, `a[base + i]`),
// L with *off set to d.
fn check_bound(x: *mut ir.Block, i: *mut ir.Value, tag: i64, off: *mut *mut ir.Value) *mut ir.Value {
    off.* = vnil();
    let t = ir.terminator(x);
    if u.isnil(t) or (t.op != ir.OP_CONDBR) {
        return vnil();
    }
    let c = ir.resolve(t.a);
    if not ir.is_op(c, ir.OP_ICMP) {
        return vnil();
    }
    let ca = ir.resolve(c.a);
    if ca != i {
        // a sum of i and invariant terms (copies of an unrolled body add 1, 2, ...)
        split_terms.clear();
        if not ir.is_op(ca, ir.OP_ADD) or (ca.ty != i.ty) or (sum_terms(ca, i, tag, 0) != 1) {
            return vnil();
        }
        off.* = ca;
    }
    let l = ir.resolve(c.b);
    if (l.ty != i.ty) or not invariant(l, tag) {
        return vnil();
    }
    let p = ir.pred_of(c);
    if (p == ir.IntULT) and (t.t1.mark == tag) and trap_exit(t.t2, tag) {
        return l;
    }
    if (p == ir.IntUGE) and (t.t2.mark == tag) and trap_exit(t.t1, tag) {
        return l;
    }
    return vnil();
}

fn try_split(f: *mut ir.Func, h: *mut ir.Block, tag: i64, members: *u.List.[*mut ir.Block]) bool {
    let ht = ir.terminator(h);
    if h.split or u.isnil(ht) or (ht.op != ir.OP_CONDBR) {
        return false;
    }
    // the header's test: i < end
    let c = ir.resolve(ht.a);
    if not ir.is_op(c, ir.OP_ICMP) {
        return false;
    }
    let i = ir.resolve(c.a);
    let end = ir.resolve(c.b);
    if not ir.is_op(i, ir.OP_PHI) or (i.blk != h) or (i.ty.kind != ir.T_INT) or (i.ty.bits > 64) or (end.ty != i.ty) or
       not invariant(end, tag) {
        return false;
    }
    let p = ir.pred_of(c);
    let mut exit = ir.bnil();
    if (p == ir.IntULT) and (ht.t1.mark == tag) and (ht.t2.mark != tag) {
        exit = ht.t2;
    } else if (p == ir.IntUGE) and (ht.t2.mark == tag) and (ht.t1.mark != tag) {
        exit = ht.t1;
    } else {
        return false;
    }
    // the checks, the other exits, the size
    let mut bounds = u.List.[*mut ir.Value].empty();
    let mut offs = u.List.[*mut ir.Value].empty();
    let mut checked = u.List.[*mut ir.Block].empty();  // blocks of i + d < L checks
    let mut n: i32 = 0;
    let mut ok = true;
    for k in 0..members.len {
        let x = members.get(k);
        let mut v = x.first;
        while u.notnil(v) {
            n += 1;
            if v.op == ir.OP_ALLOCA {
                ok = false;
            }
            v = v.next;
        }
        let t = ir.terminator(x);
        for j in 0..ir.succ_count(t) {
            let s = ir.succ(t, j);
            if (s.mark != tag) and not ((x == h) and (s == exit)) and not trap_exit(s, tag) {
                ok = false;
            }
        }
        if x != h {
            let mut d = vnil();
            let l = check_bound(x, i, tag, &mut d);
            if u.notnil(l) {
                let mut seen = false;
                for j in 0..bounds.len {
                    if (bounds.get(j) == l) and (offs.get(j) == d) {
                        seen = true;
                    }
                }
                if not seen {
                    bounds.push(l);
                    offs.push(d);
                }
                if u.notnil(d) {
                    checked.push(x);
                }
            }
        }
    }
    if not ok or (n > SPLIT_MAX) or (bounds.len == 0) {
        bounds.deinit();
        offs.deinit();
        checked.deinit();
        return false;
    }
    _ = make_preheader(f, h, tag);
    let mut pre = ir.bnil();
    for k in 0..h.preds.len {
        if h.preds.get(k).mark != tag {
            pre = h.preds.get(k);
        }
    }
    // m = min(end, L...) before the loop
    let bld = ir.new_builder();
    let pt = ir.terminator(pre);
    ir.at_before(bld, pt);
    let mut m = end;
    for k in 0..bounds.len {
        let mut l = bounds.get(k);
        let x = offs.get(k);
        if u.notnil(x) {
            // x = i + d (the sum of d's terms) < L holds for i < L - d
            // (none when d > L)
            split_terms.clear();
            _ = sum_terms(x, i, tag, 0);
            let mut d = split_terms.get(0);
            for j in 1..split_terms.len {
                d = ir.binop(bld, ir.OP_ADD, d, split_terms.get(j));
            }
            l = ir.select(bld, ir.icmp(bld, ir.IntULE, d, l), ir.binop(bld, ir.OP_SUB, l, d), ir.cint(l.ty, 0));
        }
        m = ir.select(bld, ir.icmp(bld, ir.IntULT, m, l), m, l);
    }
    bounds.deinit();
    offs.deinit();
    // the copy
    opt.clone_members(f, members, tag);
    // (its checks of i + d < L pass: they go straight on)
    for k in 0..checked.len {
        let ct = ir.terminator(@ptr_cast(*mut ir.Block, checked.get(k).auxp));
        if ir.pred_of(ir.resolve(ct.a)) == ir.IntULT {
            ct.t2 = ir.bnil();
        } else {
            ct.t1 = ct.t2;
            ct.t2 = ir.bnil();
        }
        ct.op = ir.OP_BR;
        ct.a = vnil();
    }
    checked.deinit();
    // the copy leaves at i >= m for mid, which enters the loop
    let h2 = @ptr_cast(*mut ir.Block, h.auxp);
    let ht2 = ir.terminator(h2);
    let mid = ir.edge_block(f, "split", pre, h);
    ir.at_before(bld, ht2);
    ht2.a = ir.icmp(bld, p, @ptr_cast(*mut ir.Value, i.auxp), m);
    if ht2.t1 == exit {
        ht2.t1 = mid;
    } else {
        ht2.t2 = mid;
    }
    let mut q = h.first;
    while u.notnil(q) and (q.op == ir.OP_PHI) {
        for k in 0..q.bs.len {
            if q.bs.get(k) == mid {
                q.xs.set(k, @ptr_cast(*mut ir.Value, q.auxp));
            }
        }
        q = q.next;
    }
    ir.retarget(pre, h, h2);
    h.split = true;
    h2.split = true;
    return true;
}

// True if anything changed. Once per function: after inlining.
pub fn split_loops(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    ir.apply_forwarding(f);
    let mut any = false;
    let mut rounds: i32 = 0;
    while rounds < 8 {
        rounds += 1;
        opt.compute_preds(f);
        let order = opt.dominators(f);
        let hs = opt.loop_headers(&order);
        let mut members = u.List.[*mut ir.Block].empty();
        let mut did = false;
        for k in 0..hs.len {
            loop_mark += 1;
            opt.members_of(hs.get(k), loop_mark, &mut members);
            if try_split(f, hs.get(k), loop_mark, &members) {
                did = true;
                break;  // the CFG changed
            }
        }
        members.deinit();
        order.deinit();
        hs.deinit();
        if not did {
            break;
        }
        any = true;
    }
    return any;
}

// -----------------------------------------------------------------------------
// Code sinking: an instruction computed only for some paths moves down to
// the nearest block dominating all its uses (not into a deeper loop), so
// the other paths skip it: the shadow stack's slot for the calls of a slow
// path, values only a trap reports. A load moves into a successor reached
// only from its block when nothing after it there writes memory. Where every
// path from the block reaches the target anyway (moving saves nothing), an
// instruction moves only when its operands are live there regardless: else
// they, not its result, would be live on the way (across a call, or through
// a chain of sums each sunk to the next one's use, all their terms live to
// the end of the function).
// -----------------------------------------------------------------------------
fn lca(a0: *mut ir.Block, b0: *mut ir.Block) *mut ir.Block {
    if u.isnil(a0) {
        return b0;
    }
    let mut a = a0;
    let mut b = b0;
    while a.depth > b.depth {
        a = a.idom;
    }
    while b.depth > a.depth {
        b = b.idom;
    }
    while a != b {
        a = a.idom;
        b = b.idom;
    }
    return a;
}

fn writes_mem(x: *ir.Value) bool {
    let op = x.op;
    return ir.op_writes_mem(op) or ir.intr_writes_mem(ir.intr_id(x)) or ((op == ir.OP_LOAD) and (x.flags != 0));
}

// The blocks using v: their common dominator (nil: no uses).
fn use_block(users: *u.List.[*mut ir.Value], v: *mut ir.Value) *mut ir.Block {
    let mut l = ir.bnil();
    for k in 0..users.len {
        let x = users.get(k);
        if x.op == ir.OP_PHI {
            for j in 0..x.xs.len {
                if (ir.resolve(x.xs.get(j)) == v) and (x.bs.get(j).rpo >= 0) {
                    l = lca(l, x.bs.get(j));
                }
            }
        } else {
            l = lca(l, x.blk);
        }
    }
    return l;
}

// A memset of a stack slot that nothing else in its block uses moves down
// to where the slot's users are: to the start of the block that dominates
// them, and where that block branches with users on each way, to each way's
// start (into a block entered only from it), so that paths that never use
// the slot do not fill it (a zeroed scratch buffer only fallback paths
// read). Never into a loop it is outside: there it would fill the slot
// again each time round.
fn sink_fills(f: *mut ir.Func, uses: *u.List.[u.List.[*mut ir.Value]]) bool {
    if u.isnil(B) {
        B = ir.new_builder();
    }
    let mut any = false;
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            if (i.op == ir.OP_MEMSET) and (b.rpo >= 0) and (i.aux >= 0) and ir.is_op(i.a, ir.OP_ALLOCA) and
               (i.a.aux >= 0) {
                let mut users = u.List.[*mut ir.Value].empty();
                let mut ok = true;
                let us = uses.at(@int_cast(usize, i.a.aux));
                for k in 0..us.len {
                    let x = us.get(k);
                    if u.isnil(x.blk) {
                        ok = false;  // (moved by this pass)
                    } else if x != i {
                        if (x.op == ir.OP_PHI) or (x.blk == b) or (x.blk.rpo < 0) {
                            ok = false;
                        }
                        users.push(x);
                    }
                }
                let mut to = u.List.[*mut ir.Block].empty();
                if ok and (users.len > 0) and fill_places(b, users.items(), &mut to, 0) and
                   not ((to.len == 1) and (to.get(0) == b)) {
                    for k in 0..to.len {
                        let mut at = to.get(k).first;
                        while at.op == ir.OP_PHI {
                            at = at.next;
                        }
                        ir.at_before(B, at);
                        let c = ir.memop(B, ir.OP_MEMSET, i.a, i.b, i.c);
                        c.src = i.src;
                        c.aux = -1;  // (new: not looked at again)
                    }
                    ir.remove_inst(i);
                    any = true;
                }
                users.deinit();
                to.deinit();
            }
            i = next;
        }
        b = b.next;
    }
    return any;
}

// The blocks below r (or r) whose starts can fill a slot for users (all
// dominated by r) instead of r: into `to`; false if there are too many.
fn fill_places(r: *mut ir.Block, users: []*mut ir.Value, to: *mut u.List.[*mut ir.Block], depth: i32) bool {
    let mut l = ir.bnil();
    for x in users {
        l = lca(l, x.blk);
    }
    if u.isnil(l) or not opt.dominates(r, l) {
        return false;
    }
    // not into a loop r is outside: above the loop header nearest r
    let mut t = l;
    let mut c = l;
    while c != r {
        if opt.is_loop_header(c) {
            t = c.idom;
        }
        c = c.idom;
    }
    // where t branches, each way with users entered only from t
    let mut here = false;
    for x in users {
        if x.blk == t {
            here = true;
        }
    }
    let term = ir.terminator(t);
    if not here and (depth < 4) and u.notnil(term) and (ir.succ_count(term) >= 2) {
        let mut split = true;
        let mut parts = u.List.[*mut ir.Value].empty();
        let mut covered: usize = 0;
        for k in 0..ir.succ_count(term) {
            let s = ir.succ(term, k);
            let mut n: usize = 0;
            for x in users {
                if opt.dominates(s, x.blk) {
                    n += 1;
                }
            }
            if (n > 0) and ((s.preds.len != 1) or (s == t)) {
                split = false;
            }
            covered += n;
        }
        if split and (covered == users.len) {
            for k in 0..ir.succ_count(term) {
                let s = ir.succ(term, k);
                parts.clear();
                for x in users {
                    if opt.dominates(s, x.blk) {
                        parts.push(x);
                    }
                }
                if (parts.len > 0) and not fill_places(s, parts.items(), to, depth + 1) {
                    parts.deinit();
                    return false;
                }
            }
            parts.deinit();
            return to.len <= 4;
        }
        parts.deinit();
    }
    to.push(t);
    return to.len <= 4;
}

fn note_use(uses: *mut u.List.[u.List.[*mut ir.Value]], o: *mut ir.Value, x: *mut ir.Value) void {
    if u.notnil(o) and (o.kind == ir.V_INST) and (o.aux >= 0) {
        uses.at(@int_cast(usize, o.aux)).push(x);
    }
}

// Is there a path from blk that skips t: back to blk, or to a return (not
// to a trap), without passing t? If not, moving an instruction from blk to
// t saves nothing.
fn skips(blk: *mut ir.Block, t: *mut ir.Block, seen: []mut bool) bool {
    for k in 0..seen.len {
        seen[k] = false;
    }
    let mut work = u.List.[*mut ir.Block].empty();
    let bt = ir.terminator(blk);
    for k in 0..ir.succ_count(bt) {
        work.push(ir.succ(bt, k));
    }
    let mut found = false;
    while (work.len > 0) and not found {
        let x = work.get(work.len - 1);
        work.len -= 1;
        if (x == t) or (x.rpo < 0) or seen[@int_cast(usize, x.rpo)] {
            continue;
        }
        seen[@int_cast(usize, x.rpo)] = true;
        if x == blk {
            found = true;
            break;
        }
        let xt = ir.terminator(x);
        let n = ir.succ_count(xt);
        if n == 0 {
            found = u.notnil(xt) and (xt.op != ir.OP_UNREACHABLE);
            continue;  // (a trap does not count)
        }
        for k in 0..n {
            work.push(ir.succ(xt, k));
        }
    }
    work.deinit();
    return found;
}

// Is operand o of i used below t anyway (by something else in a block t
// dominates), so that it is live into t whether or not i moves there?
fn used_below(uses: *u.List.[u.List.[*mut ir.Value]], o: *mut ir.Value, i: *mut ir.Value, t: *mut ir.Block) bool {
    if u.isnil(o) or (o.kind != ir.V_INST) {
        return true;  // (a constant, parameter or global)
    }
    if o.aux < 0 {
        return false;
    }
    let us = uses.at(@int_cast(usize, o.aux));
    for k in 0..us.len {
        let x = us.get(k);
        if x == i {
            continue;
        }
        if x.op == ir.OP_PHI {
            for j in 0..x.xs.len {
                if (ir.resolve(x.xs.get(j)) == o) and (x.bs.get(j).rpo >= 0) and opt.dominates(t, x.bs.get(j)) {
                    return true;
                }
            }
        } else if (x.blk.rpo >= 0) and opt.dominates(t, x.blk) {
            return true;
        }
    }
    return false;
}

fn operands_live_at(uses: *u.List.[u.List.[*mut ir.Value]], i: *mut ir.Value, t: *mut ir.Block) bool {
    if not used_below(uses, ir.resolve(i.a), i, t) or not used_below(uses, ir.resolve(i.b), i, t) or
       not used_below(uses, ir.resolve(i.c), i, t) {
        return false;
    }
    for k in 0..i.xs.len {
        if not used_below(uses, ir.resolve(i.xs.get(k)), i, t) {
            return false;
        }
    }
    return true;
}

fn sink_uses(f: *mut ir.Func, order: *u.List.[*mut ir.Block]) u.List.[u.List.[*mut ir.Value]] {
    let mut uses = u.List.[u.List.[*mut ir.Value]].empty();
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.aux = -1;
            if b.rpo >= 0 {
                i.aux = @int_cast(i64, uses.len);
                uses.push(u.List.[*mut ir.Value].empty());
            }
            i = i.next;
        }
        b = b.next;
    }
    for bi in 0..order.len {
        let mut i = order.get(bi).first;
        while u.notnil(i) {
            note_use(&mut uses, i.a, i);
            note_use(&mut uses, i.b, i);
            note_use(&mut uses, i.c, i);
            for k in 0..i.xs.len {
                note_use(&mut uses, i.xs.get(k), i);
            }
            i = i.next;
        }
    }
    return uses;
}

pub fn sink(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    ir.apply_forwarding(f);
    opt.compute_preds(f);
    let order = opt.dominators(f);
    opt.loop_depths(f, &order);
    // users of each instruction (reachable ones): again when sink_fills
    // moved memsets (the lists hold the ones it took out)
    let mut uses = sink_uses(f, &order);
    let mut any = sink_fills(f, &uses);
    if any {
        for k in 0..uses.len {
            u.free(@ptr_cast(*mut void, uses.at(k).data));
        }
        uses.deinit();
        uses = sink_uses(f, &order);
    }
    // bottom-up: users move before what they use is considered
    let seen = u.newn.[bool](order.len + 1);
    let mut last_from = ir.bnil();
    let mut last_to = ir.bnil();
    let mut last_skips = false;
    let mut bi = order.len;
    while bi > 0 {
        bi -= 1;
        let blk = order.get(bi);
        let mut i = blk.last;
        while u.notnil(i) {
            let prev = i.prev;
            let is_load = (i.op == ir.OP_LOAD) and (i.flags == 0);
            if (i.op != ir.OP_PHI) and (cse_able(i) or is_load) {
                let l = use_block(uses.at(@int_cast(usize, i.aux)), i);
                if u.notnil(l) and (l != blk) and (l.rpo >= 0) and opt.dominates(blk, l) {
                    // the deepest block on the way down not in a deeper loop
                    let mut t = l;
                    while (t != blk) and (t.loop_depth > blk.loop_depth) {
                        t = t.idom;
                    }
                    // not past an inner loop (its operands would live across it)
                    let mut up = t;
                    while up != blk {
                        if up.loop_depth > blk.loop_depth {
                            t = blk;
                            break;
                        }
                        up = up.idom;
                    }
                    if is_load and (t != blk) {
                        // only into a successor reached from here alone, and
                        // nothing after the load here writes memory
                        while (t != blk) and (t.idom != blk) {
                            t = t.idom;
                        }
                        let mut quiet = (t.preds.len == 1);
                        let mut x = i.next;
                        while quiet and u.notnil(x) {
                            if writes_mem(x) {
                                quiet = false;
                            }
                            x = x.next;
                        }
                        if not quiet {
                            t = blk;
                        }
                    }
                    if t != blk {
                        if (t != last_to) or (blk != last_from) {
                            last_from = blk;
                            last_to = t;
                            last_skips = skips(blk, t, seen[0..order.len]);
                        }
                        if not last_skips and not operands_live_at(&uses, i, t) {
                            t = blk;  // (its operands would live on the way instead of it)
                        }
                    }
                    if t != blk {
                        let mut at = t.first;
                        while at.op == ir.OP_PHI {
                            at = at.next;
                        }
                        ir.remove_inst(i);
                        ir.insert_before(at, i);
                        any = true;
                    }
                }
            }
            i = prev;
        }
    }
    for k in 0..uses.len {
        u.free(@ptr_cast(*mut void, uses.at(k).data));
    }
    uses.deinit();
    order.deinit();
    return any;
}

// -----------------------------------------------------------------------------
// Strength reduction of addresses: in a loop, an address base + off where
// base is invariant and off grows by a constant each iteration (an affine
// function of the loop's counters, as (i * 300 + k) * 8) becomes a pointer
// of its own, started before the loop and advanced at its latch. Worth it
// for wasm (no addressing modes) whenever off takes work; for native code
// when it takes a multiplication or more than one operation per access.
// Addresses a constant apart share the pointer.
// -----------------------------------------------------------------------------
struct IvPtr {
    base: *mut ir.Value,
    step: i64,
    off0: *mut ir.Value,
    q: *mut ir.Value,
}

let mut ivps: u.List.[IvPtr] = u.List.[IvPtr].{ data: @ptr_from_int(*mut IvPtr, 0), len: 0, cap: 0 };

// The step of v per iteration of the loop at h (tag), when v is an affine
// function of its counters; `ops` counts the operations that vary.
fn iv_step(v0: *mut ir.Value, h: *mut ir.Block, tag: i64, ok: *mut bool, ops: *mut i32, mulk: *mut bool,
           depth: i32) i64 {
    let v = ir.resolve(v0);
    if invariant(v, tag) {
        return 0;
    }
    if (depth > 6) or (v.ty != ir.isz()) {
        ok.* = false;
        return 0;
    }
    if (v.op == ir.OP_PHI) and (v.blk == h) {
        // a counter: [init from outside, v + c from the latch]
        if v.xs.len != 2 {
            ok.* = false;
            return 0;
        }
        for k in @as(usize, 0)..2 {
            if v.bs.get(k).mark == tag {
                let n = ir.resolve(v.xs.get(k));
                if ir.is_op(n, ir.OP_ADD) and (ir.resolve(n.a) == v) and ir.is_cint(ir.resolve(n.b)) {
                    return @bit_cast(i64, ir.cint_val(ir.resolve(n.b)));
                }
            }
        }
        ok.* = false;
        return 0;
    }
    let op = v.op;
    if (op == ir.OP_ADD) or (op == ir.OP_SUB) {
        let a = iv_step(v.a, h, tag, ok, ops, mulk, depth + 1);
        let b = iv_step(v.b, h, tag, ok, ops, mulk, depth + 1);
        ops.* += 1;
        if op == ir.OP_ADD {
            return a +% b;
        }
        return a -% b;
    }
    if ((op == ir.OP_MUL) or (op == ir.OP_SHL)) and ir.is_cint(ir.resolve(v.b)) {
        let a = iv_step(v.a, h, tag, ok, ops, mulk, depth + 1);
        let k = @bit_cast(i64, ir.cint_val(ir.resolve(v.b)));
        ops.* += 1;
        if op == ir.OP_SHL {
            if (k < 0) or (k > 3) {
                mulk.* = true;
            }
            return a << @truncate(u32, @bit_cast(u64, k) & 63);
        }
        if (k != 1) and (k != 2) and (k != 4) and (k != 8) {
            mulk.* = true;
        }
        return a *% k;
    }
    ok.* = false;
    return 0;
}

// v's value in the loop's first iteration, built before it.
fn iv_start(bld: *mut ir.Builder, v0: *mut ir.Value, h: *mut ir.Block, tag: i64, pre: *mut ir.Block) *mut ir.Value {
    let v = ir.resolve(v0);
    if invariant(v, tag) {
        return v;
    }
    if (v.op == ir.OP_PHI) and (v.blk == h) {
        for k in 0..v.bs.len {
            if v.bs.get(k) == pre {
                return ir.resolve(v.xs.get(k));
            }
        }
    }
    let a = iv_start(bld, v.a, h, tag, pre);
    let b = iv_start(bld, v.b, h, tag, pre);
    if v.op == ir.OP_ADD {
        return ir.add(bld, a, b);
    }
    if v.op == ir.OP_SUB {
        return ir.sub(bld, a, b);
    }
    if v.op == ir.OP_MUL {
        return ir.mul(bld, a, b);
    }
    return ir.binop(bld, ir.OP_SHL, a, b);
}

// Is base + off0 a constant (d) from base1 + off1? Both as a root pointer
// plus a linear combination of values plus a constant (lin_add): the same
// root and the same combination.
fn start_diff(base: *mut ir.Value, off0: *mut ir.Value, base1: *mut ir.Value, off1: *mut ir.Value, d: *mut i64) bool {
    let mut x = Lin.{ terms: u.List.[*mut ir.Value].empty(), coefs: u.List.[i64].empty(), k: 0, ok: true };
    let mut y = Lin.{ terms: u.List.[*mut ir.Value].empty(), coefs: u.List.[i64].empty(), k: 0, ok: true };
    let r = lin_ptr(base, &mut x);
    let r1 = lin_ptr(base1, &mut y);
    lin_add(off0, 1, &mut x, 0);
    lin_add(off1, 1, &mut y, 0);
    let mut same = x.ok and y.ok and (r == r1);
    if same {
        // the same coefficient for each term (y's terms negated into x's)
        for k in 0..y.terms.len {
            lin_term(&mut x, y.terms.get(k), 0 -% y.coefs.get(k));
        }
        for k in 0..x.coefs.len {
            if x.coefs.get(k) != 0 {
                same = false;
            }
        }
    }
    d.* = x.k -% y.k;
    x.terms.deinit();
    x.coefs.deinit();
    y.terms.deinit();
    y.coefs.deinit();
    return same;
}

// A linear combination: the sum of terms[i] * coefs[i], plus k.
struct Lin {
    terms: u.List.[*mut ir.Value],
    coefs: u.List.[i64],
    k: i64,
    ok: bool,
}

fn lin_term(l: *mut Lin, v: *mut ir.Value, c: i64) void {
    for i in 0..l.terms.len {
        if l.terms.get(i) == v {
            l.coefs.set(i, l.coefs.get(i) +% c);
            return;
        }
    }
    l.terms.push(v);
    l.coefs.push(c);
}

// Adds integer v * s to l.
fn lin_add(v0: *mut ir.Value, s: i64, l: *mut Lin, depth: i32) void {
    let v = ir.resolve(v0);
    if ir.is_cint(v) {
        l.k = l.k +% (ir.sval(v) *% s);
        return;
    }
    if depth > 8 {
        l.ok = false;
        return;
    }
    if ir.is_op(v, ir.OP_ADD) {
        lin_add(v.a, s, l, depth + 1);
        lin_add(v.b, s, l, depth + 1);
        return;
    }
    if ir.is_op(v, ir.OP_SUB) {
        lin_add(v.a, s, l, depth + 1);
        lin_add(v.b, 0 -% s, l, depth + 1);
        return;
    }
    if ir.is_op(v, ir.OP_MUL) and ir.is_cint(ir.resolve(v.b)) {
        lin_add(v.a, s *% ir.sval(ir.resolve(v.b)), l, depth + 1);
        return;
    }
    if ir.is_op(v, ir.OP_SHL) and ir.is_cint(ir.resolve(v.b)) and (ir.sval(ir.resolve(v.b)) >= 0) and
       (ir.sval(ir.resolve(v.b)) < 63) {
        lin_add(v.a, s *% (@as(i64, 1) << @truncate(u32, @bit_cast(u64, ir.sval(ir.resolve(v.b))))), l, depth + 1);
        return;
    }
    lin_term(l, v, s);
}

// The root of pointer p through ptradds, their offsets added to l.
fn lin_ptr(p0: *mut ir.Value, l: *mut Lin) *mut ir.Value {
    let mut p = ir.resolve(p0);
    let mut n: i32 = 0;
    while ir.is_op(p, ir.OP_PTRADD) and (n < 8) {
        lin_add(p.b, 1, l, 0);
        p = ir.resolve(p.a);
        n += 1;
    }
    return p;
}

fn try_reduce(f: *mut ir.Func, h: *mut ir.Block, tag: i64, members: *u.List.[*mut ir.Block], no_modes: bool) bool {
    // one latch
    let mut latch = ir.bnil();
    for k in 0..h.preds.len {
        let p = h.preds.get(k);
        if p.mark == tag {
            if u.notnil(latch) {
                return false;
            }
            latch = p;
        }
    }
    if u.isnil(latch) or (ir.terminator(latch).op != ir.OP_BR) {
        return false;
    }
    let mut pre = ir.bnil();
    ivps.clear();
    let mut any = false;
    for mi in 0..members.len {
        let x = members.get(mi);
        let mut p = x.first;
        while u.notnil(p) {
            let next = p.next;
            if (p.op == ir.OP_PTRADD) and invariant(ir.resolve(p.a), tag) and not invariant(ir.resolve(p.b), tag) {
                let mut ok = true;
                let mut ops: i32 = 0;
                let mut mulk = false;
                let st = iv_step(p.b, h, tag, &mut ok, &mut ops, &mut mulk, 0);
                let worth = (no_modes and (ops >= 1)) or mulk or (ops >= 2);
                if ok and (st != 0) and worth {
                    if u.isnil(pre) {
                        _ = make_preheader(f, h, tag);
                        for k in 0..h.preds.len {
                            if h.preds.get(k).mark != tag {
                                pre = h.preds.get(k);
                            }
                        }
                    }
                    let bld = ir.new_builder();
                    ir.at_before(bld, ir.terminator(pre));
                    let base = ir.resolve(p.a);
                    let off0 = iv_start(bld, p.b, h, tag, pre);
                    // a pointer already made for this step that starts a
                    // constant away?
                    let mut q = vnil();
                    let mut d: i64 = 0;
                    for k in 0..ivps.len {
                        let e = ivps.at(k);
                        if u.isnil(q) and (e.step == st) {
                            if (e.base == base) and (e.off0 == off0) {
                                q = e.q;
                            } else if (e.base == base) and ir.is_cint(e.off0) and ir.is_cint(off0) {
                                q = e.q;
                                d = @bit_cast(i64, ir.cint_val(off0)) -% @bit_cast(i64, ir.cint_val(e.off0));
                            } else if not no_modes {
                                // (wasm's offsets cannot be negative)
                                let mut dd: i64 = 0;
                                if start_diff(base, off0, e.base, e.off0, &mut dd) {
                                    q = e.q;
                                    d = dd;
                                }
                            }
                        }
                    }
                    if u.isnil(q) {
                        let start = ir.ptradd(bld, base, off0);
                        ir.at_before(bld, h.first);
                        q = ir.phi(bld, ir.t_ptr());
                        ir.add_incoming(q, start, pre);
                        ir.at_before(bld, ir.terminator(latch));
                        let qn = ir.ptradd(bld, q, ir.cint(ir.isz(), @bit_cast(u64, st)));
                        ir.add_incoming(q, qn, latch);
                        ivps.push(IvPtr.{ base: base, step: st, off0: off0, q: q });
                    }
                    if d != 0 {
                        ir.at_before(bld, p);
                        ir.forward(p, ir.ptradd(bld, q, ir.cint(ir.isz(), @bit_cast(u64, d))));
                    } else {
                        ir.forward(p, q);
                    }
                    ir.remove_inst(p);
                    any = true;
                }
            }
            p = next;
        }
    }
    if any {
        ir.apply_forwarding(f);
    }
    return any;
}

// True if anything changed.
pub fn reduce_addresses(f: *mut ir.Func, no_modes: bool) bool {
    if u.isnil(f.first) {
        return false;
    }
    ir.apply_forwarding(f);
    let mut any = false;
    opt.compute_preds(f);
    let order = opt.dominators(f);
    let hs = opt.loop_headers(&order);
    let mut members = u.List.[*mut ir.Block].empty();
    // inner loops first (their pointers' starts are then reduced in the outer ones)
    let mut k = hs.len;
    while k > 0 {
        k -= 1;
        loop_mark += 1;
        opt.members_of(hs.get(k), loop_mark, &mut members);
        if try_reduce(f, hs.get(k), loop_mark, &members, no_modes) {
            any = true;
            opt.compute_preds(f);  // (a preheader may be new)
        }
    }
    members.deinit();
    order.deinit();
    hs.deinit();
    return any;
}
