// =============================================================================
// dwarf.ax - DWARF 5 debug information for the native code generators
// (x64.ax, a64.ax) and the WebAssembly linker (wlink.ax), with -g or
// --debug-info=lines|full (tg.g_debug).
//
// A Unit collects an object's debug information as its functions are
// encoded: each function's line table rows, its call frame states, its
// name, place and declaration. finish_elf writes the sections into the
// object, one compilation unit per object:
//   .debug_abbrev    the abbreviations (a fixed table: abbrev_table)
//   .debug_info      the compilation unit, a subprogram per function (and,
//                    at DEBUG_FULL, the types and variables dbginfo.ax holds)
//   .debug_str       names (DW_FORM_strp)
//   .debug_line      the line program: a sequence per function
//   .debug_line_str  the line table's directory and file names
//   .debug_aranges   the unit's address range (its .text)
//   .debug_frame     call frame information: a CIE, an FDE per function
//   .debug_rnglists  the address ranges of lexical blocks in more than one piece
//   .debug_loclists  the locations of variables that move (optimized code)
//   .debug_names     the unit's index of names: its subprograms (and at
//                    DEBUG_FULL static variables, named types, enumerators)
// References from one section to another and to code are relocations
// (R_X86_64_32 / R_AARCH64_ABS32 against the section's symbol, R_X86_64_64
// / R_AARCH64_ABS64 against the function's), which the system's linker and
// our own (nlink.ax: debug_sections) resolve.
//
// What is recorded never changes the instructions: the code generators only
// note offsets and states as they encode (and only when tg.g_debug is on);
// the frame table's line rows (ftab.ax) move the data after them in an
// executable, and so the addresses instructions hold.
// Formats: the DWARF 5 standard (dwarfstd.org), sections 6.2 (line number
// information), 6.4 (call frame information), 7 (data representation).
// =============================================================================
import "bin.ax" as bn;
import "dbginfo.ax" as dbi;
import "dloc.ax" as dloc;
import "elf.ax" as elf;
import "ir.ax" as ir;
import "std/crypto/md5" as md5;
import "std/unicode" as uni;
import "target.ax" as tg;
import "util.ax" as u;
import "version.ax" as ver;

// The debug sections, in the order they are written.
pub const D_ABBREV: usize = 0;
pub const D_INFO: usize = 1;
pub const D_STR: usize = 2;
pub const D_LINE: usize = 3;
pub const D_LINE_STR: usize = 4;
pub const D_ARANGES: usize = 5;
pub const D_FRAME: usize = 6;
pub const D_RNGLISTS: usize = 7;
pub const D_LOCLISTS: usize = 8;
pub const D_NAMES: usize = 9;
pub const D_MACRO: usize = 10;
pub const NSEC: usize = 11;

pub let SEC_NAMES: [11][]u8 = [".debug_abbrev", ".debug_info", ".debug_str", ".debug_line", ".debug_line_str",
                               ".debug_aranges", ".debug_frame", ".debug_rnglists", ".debug_loclists", ".debug_names",
                               ".debug_macro"];

// Is it the name of a debug section this module writes (and the linkers merge)?
pub fn is_debug_name(name: []u8) bool {
    for n in SEC_NAMES {
        if u.str_eq(n, name) {
            return true;
        }
    }
    return false;
}

// Fixups: where a section refers to code or to another section.
pub const FX_ADDR: u8 = 0;              // 8 bytes (4 on wasm32): the address of function `sym` + addend
pub const FX_SEC: u8 = 1;               // 4 bytes: offset `addend` in this unit's debug section `sym` (a D_*)
pub const FX_TLS: u8 = 2;               // 8 bytes: the offset of thread-local datum `sym` + addend in the TLS block
pub const FX_SIZE: u8 = 3;              // `sym` bytes: the size of the unit's code (finish_parts: WebAssembly objects)
pub const TEXT_SYM: u32 = 0xffff_ffff;  // FX_ADDR's sym for the start of the unit's code

pub struct Fix {
    off: u64,
    kind: u8,
    sym: u32,
    addend: i64,
}

// A section's bytes and its fixups.
pub struct Part {
    b: bn.Bytes,
    fx: u.List.[Fix],
}

// Architectures (the CIE and the register numbers differ)
pub const ARCH_X64: i32 = 0;
pub const ARCH_A64: i32 = 1;
pub const ARCH_WASM: i32 = 2;

// DWARF register numbers (System V x86-64 psABI 3.6.2; AAPCS64's DWARF
// for the Arm 64-bit architecture, 4.1)
pub const X64_RBP: u32 = 6;
pub const X64_RSP: u32 = 7;
pub const X64_RA: u32 = 16;
pub const A64_FP: u32 = 29;
pub const A64_LR: u32 = 30;
pub const A64_SP: u32 = 31;

pub struct Unit {
    on: bool,
    arch: i32,
    addr_size: u64,
    full: bool,  // DEBUG_FULL: types and variables too
    lang: u32,   // DW_LANG_* (0: none named)
    parts: [11]Part,
    strs: u.SymMap.[u32],   // interned string -> its .debug_str offset + 1
    lstrs: u.SymMap.[u32],  // interned string -> its .debug_line_str offset + 1
    files: u.List.[u32],    // the line table's files: their names' .debug_line_str offsets
    fmap: u.SymMap.[u32],   // interned file name -> its index in the line table
    by_id: u.List.[u32],    // source file id -> its index in the line table + 1 (files without #line)
    nfuncs: u32,
    first_src: u32,  // the first function's location: the unit's name
    text_sym: u32,   // (ELF) a local symbol at the start of .text
    // DEBUG_FULL: references to types (in .debug_info: sym is the type's
    // dbginfo index), and the data's symbols (name -> symbol index + 1)
    trefs: u.List.[Fix],
    gsyms: u.SymMap.[u32],
    toff: u.List.[u64],     // each type's offset in the .debug_info part + 1 (0: not written yet)
    drefs: u.List.[Fix],    // references to entries in the part (addend: its offset), which finish moves
    gdone: u.List.[bool],   // per dbinfo global: written in a lexical block
    voffs: u.List.[u64],    // (while a function is written: its variables' entries' offsets + 1)
    tls_rel: u32,           // the relocation of an offset in the TLS block (FX_TLS), 0: thread-locals have no location
    cies: [4]u64,           // file-scope asm's other CIEs (add_asm_fde: bit 0 simple, bit 1 a signal frame): offset + 1
    size_fix: bool,         // the unit's code size is a fixup (FX_SIZE: finish_parts)
    sums: u.List.[[16]u8],  // the line table's files' MD5 checksums (in files' order)
    nosum: bool,            // a file of the line table has none (a presumed name of C's #line): none are given
    names: u.List.[Named],  // DEBUG_FULL: the entries .debug_names indexes
    // the functions inlined: their abstract instances (abs_ref; interned IR
    // name -> index + 1 in abs_fns), and the references to them
    abs_fns: u.List.[[]u8],
    abs_map: u.SymMap.[u32],
    arefs: u.List.[Fix],
    // (ELF) the unit's code when it is in several sections (isel.ax:
    // func_section): each one's start symbol << 32 | its size; the unit
    // then has DW_AT_ranges, and .debug_aranges an entry for each
    ranges: u.List.[u64],
    // base types of typed operations in .debug_loclists (dloc.LK_TEXPR):
    // their operands' offsets in the part, sym the dloc.TY_*, which finish
    // makes the offsets of those types' entries
    lrefs: u.List.[Fix],
}

// An entry of the name index: its name (interned), tag, and offset in the
// .debug_info part (before the unit's header).
pub struct Named {
    name: []u8,
    tag: u64,
    off: u64,
}

pub fn none() Unit {
    return Unit.{ on: false, arch: 0, addr_size: 8, full: false, lang: 0, parts: [new_part(); 11],
                  strs: u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 },
                  lstrs: u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 },
                  files: u.List.[u32].empty(), fmap: u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](),
                                                                      cap: 0, len: 0 }, by_id: u.List.[u32].empty(),
                  nfuncs: 0, first_src: 0, text_sym: 0, trefs: u.List.[Fix].empty(),
                  gsyms: u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 },
                  toff: u.List.[u64].empty(), drefs: u.List.[Fix].empty(), gdone: u.List.[bool].empty(),
                  voffs: u.List.[u64].empty(), tls_rel: 0, cies: [0; 4], size_fix: false, sums: u.List.[[16]u8].empty(),
                  nosum: false, names: u.List.[Named].empty(), abs_fns: u.List.[[]u8].empty(),
                  abs_map: u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 },
                  arefs: u.List.[Fix].empty(), ranges: u.List.[u64].empty(), lrefs: u.List.[Fix].empty() };
}

fn new_part() Part {
    return Part.{ b: bn.new_bytes(), fx: u.List.[Fix].empty() };
}

/// A unit for an object of architecture `arch` (ARCH_*), with addresses of
/// addr_size bytes, at debug level `level` (tg.DEBUG_*; DEBUG_NONE: off).
pub fn begin(arch: i32, addr_size: u64, level: i32) Unit {
    let mut d = none();
    if level == 0 {
        return d;
    }
    d.on = true;
    d.arch = arch;
    d.addr_size = addr_size;
    d.full = level >= 2;
    // the frame section starts with the CIE (frame_cie), which every FDE refers to
    if arch != ARCH_WASM {
        frame_cie(&mut d);
    }
    return d;
}

// -----------------------------------------------------------------------------
// Strings and files
// -----------------------------------------------------------------------------
fn str_off(d: *mut Unit, s: []u8) u32 {
    let k = u.intern(s);
    let at = d.strs.get(k);
    if at != 0 {
        return at - 1;
    }
    let p = &mut d.parts[D_STR].b;
    let o = @int_cast(u32, p.len());
    p.put(s);
    p.u8_(0);
    d.strs.put(k, o + 1);
    return o;
}

fn line_str_off(d: *mut Unit, s: []u8) u32 {
    let k = u.intern(s);
    let at = d.lstrs.get(k);
    if at != 0 {
        return at - 1;
    }
    let p = &mut d.parts[D_LINE_STR].b;
    let o = @int_cast(u32, p.len());
    p.put(s);
    p.u8_(0);
    d.lstrs.put(k, o + 1);
    return o;
}

// A 4-byte reference to offset `at` of section `sec` of the unit.
fn sec_ref(d: *mut Unit, p: *mut Part, sec: usize, at: u64) void {
    p.fx.push(Fix.{ off: @as(u64, p.b.len()), kind: FX_SEC, sym: @truncate(u32, sec), addend: @bit_cast(i64, at) });
    p.b.u32_(0);
}

// The address of function symbol `sym` + `add`.
fn addr_ref(d: *mut Unit, p: *mut Part, sym: u32, add: u64) void {
    p.fx.push(Fix.{ off: @as(u64, p.b.len()), kind: FX_ADDR, sym: sym, addend: @bit_cast(i64, add) });
    if d.addr_size == 4 {
        p.b.u32_(0);
    } else {
        p.b.u64_(0);
    }
}

// A source file's path as debuggers should find it: absolute, if it exists.
fn file_path(file: i32) []u8 {
    let p = u.file_of(file).path;
    let r = u.real_path(p);
    if u.isnos(r) {
        return p;
    }
    return r;
}

// The line table's index of the file and the line of a location, presumed
// (C's #line directives).
pub struct Where {
    file: u32,
    line: u32,
}

pub fn where_of(d: *mut Unit, src: u32) Where {
    let file = ir.src_file(src);
    let line = ir.src_line(src);
    if (src == 0) or (file < 0) or (@int_cast(usize, file) >= u.g_files.len) {
        return Where.{ file: 0, line: 0 };
    }
    let sf = u.file_of(file);
    if sf.marks.len == 0 {
        let k = @as(usize, @bit_cast(u32, file));
        while d.by_id.len <= k {
            d.by_id.push(0);
        }
        if d.by_id.get(k) == 0 {
            d.by_id.set(k, file_index(d, file_path(file), sf) + 1);
        }
        return Where.{ file: d.by_id.get(k) - 1, line: line };
    }
    let p = u.presumed_line(file, @bit_cast(i32, line));
    let mut name = p.name;
    if not p.marked {
        name = file_path(file);
    }
    let mut ln: u32 = 0;
    if (p.line > 0) and (p.line < 0x7fff_ffff) {
        ln = @truncate(u32, @bit_cast(u64, p.line));
    }
    let mut of = u.nil.[u.SourceFile]();
    if not p.marked {
        of = sf;
    }
    return Where.{ file: file_index(d, name, of), line: ln };
}

// The line table's index of the file named `name` (from 1: DWARF 5's file 0
// is the unit's primary file, which finish repeats as entry 0).
// sf: the source file it is (its text, for its checksum), or nil: a name
// that is not a file read (C's #line).
fn file_index(d: *mut Unit, name: []u8, sf: *mut u.SourceFile) u32 {
    let k = u.intern(name);
    let at = d.fmap.get(k);
    if at != 0 {
        return at;
    }
    d.files.push(line_str_off(d, name));
    let mut sum: [16]u8 = [0; 16];
    if u.notnil(sf) and not u.isnos(sf.text) {
        md5.md5(sf.text, sum[..]);  // (the text as read: the file's bytes)
    } else {
        d.nosum = true;
    }
    d.sums.push(sum);
    let idx = @int_cast(u32, d.files.len);
    d.fmap.put(k, idx);
    return idx;
}

// -----------------------------------------------------------------------------
// Functions
// -----------------------------------------------------------------------------
/// A line table row (encode_func's rows): the code offset in the high 32
/// bits (ROW_PE: where the prologue ends), the source location (ir.src_loc)
/// in the low.
pub const ROW_PE: u64 = @as(u64, 1) << 63;

/// A call frame state: from code offset `off` on (bits 0-31), the CFA is
/// register `reg` (bits 56-60) + 8 * `k` (bits 61-63), and the registers of
/// the function's save list (Func.regs) whose bits are set in bits 32-55
/// are saved at their offsets from the CFA; the others hold the caller's
/// values.
pub fn cfi_state(off: u64, reg: u32, k: u64, mask: u64) u64 {
    return ((off & 0xffff_ffff) | ((mask & 0xff_ffff) << 32)) | ((@as(u64, reg & 31) << 56) | ((k & 7) << 61));
}

/// A saved register (Func.regs): its DWARF number and its offset from the CFA.
pub fn saved_reg(reg: u32, off: i64) u64 {
    return (@as(u64, reg) << 32) | (@bit_cast(u64, off) & 0xffff_ffff);
}

/// Call frame instructions of their own at code offset `off` of a function
/// (an inline template's: the registers it saves on the stack), after the
/// state changes at that offset.
pub struct XCfi {
    off: u64,
    bytes: []u8,
}

pub struct Func {
    xcfi: []XCfi,  // (in code order)
    sym: u32,      // its symbol (ELF: in the object; wasm: the linker's function number)
    name: []u8,    // for people
    external: bool,
    size: u64,
    src: u32,            // its declaration
    rows: []u64,         // ROW_* (in code order)
    scopes: []u64,       // DEBUG_FULL: where the lexical block changes: code offset << 32 | its scope (dbginfo)
    cfi: []u64,          // cfi_state (in code order; empty: none)
    regs: []u64,         // saved_reg
    irf: *ir.Func,       // (DEBUG_FULL: its variables, dbginfo.ax)
    vars: []i64,         // DEBUG_FULL: per variable of dbinfo.vars_of(irf), its frame offset from the CFA, or NO_LOC
    vlocs: []dloc.VLoc,  // optimized code: the variables' location pieces and constant values (dloc.ax)
    // WebAssembly: the local holding the frame's address (its frame base, from
    // which vars count), or -1 (no frame; natively: the CFA is the frame base)
    frame_local: i64,
    calls: []dloc.CallSite,  // optimized code (-g): its call sites (dloc.ax)
}

// Is source location `src` in the standard library?
fn from_std(src: u32) bool {
    let file = ir.src_file(src);
    if (src == 0) or (file < 0) or (@int_cast(usize, file) >= u.g_files.len) {
        return true;
    }
    return u.starts(u.file_of(file).display, "std/");
}

/// The name for people of the function whose symbol is `sym`.
pub fn name_of(sym: []u8) []u8 {
    return dbi.func_name(sym, elf.display_name(sym));
}

/// The name of IR function f (symbol name `sym` for people) in its source:
/// an Axiom function's module.function, an exported one's own name (but the
/// standard library's: a C program's start-up exports a main too).
pub fn func_name(f: *ir.Func, sym: []u8) []u8 {
    let n = dbi.func_name(f.name, sym);
    if u.starts(n, "axiom.export.") and (n.len > 13) and not from_std(f.src) {
        return n[13..];
    }
    return n;
}

/// func_name for IR function f by its symbol's own name (WebAssembly).
pub fn func_name_of(f: *ir.Func) []u8 {
    return func_name(f, elf.display_name(f.name));
}

/// Adds function `f`'s line table, subprogram and frame description.
pub fn add_func(d: *mut Unit, f: *Func) void {
    if not d.on {
        return;
    }
    // (the unit is named after its first function's file, the standard
    // library's only when all are: a C program's start-up comes first)
    if (d.first_src == 0) or (from_std(d.first_src) and not from_std(f.src)) {
        d.first_src = f.src;
    }
    d.nfuncs += 1;
    var_pieces_done();
    line_sequence(d, f);
    subprogram(d, f);
    var_pieces_done();
    if f.cfi.len > 0 {
        fde(d, f);
    }
}

// Line number program opcodes (DWARF 5, 6.2.5)
const LNS_COPY: u8 = 1;
const LNS_ADVANCE_PC: u8 = 2;
const LNS_ADVANCE_LINE: u8 = 3;
const LNS_SET_FILE: u8 = 4;
const LNS_SET_PROLOGUE_END: u8 = 10;
const LNE_END_SEQUENCE: u8 = 1;
const LNE_SET_ADDRESS: u8 = 2;
const LINE_BASE: i64 = -5;
const LINE_RANGE: i64 = 14;
const OPCODE_BASE: i64 = 13;

// An enumerator of an enumeration of `size` bytes: its value as a signed
// 64-bit one, or (m.wide) unsigned, of 128 bits or as many bytes as the type.
fn enumerator(d: *mut Unit, size: u64, m: *dbi.DMember) void {
    if m.wide.len == 0 {
        ib(d).uleb(AB_ENUMERATOR);
        strp(d, m.name);
        ib(d).sleb(m.value);
        return;
    }
    let mut hi_zero = true;
    for k in 1..m.wide.len {
        hi_zero = hi_zero and (m.wide[k] == 0);
    }
    if hi_zero {
        ib(d).uleb(AB_ENUMERATOR_WIDE);
        strp(d, m.name);
        ib(d).uleb(m.wide[0]);
        return;
    }
    let mut n: u64 = 16;
    if size > 16 {
        n = size;
    }
    ib(d).uleb(AB_ENUMERATOR_WIDE + 1);
    strp(d, m.name);
    ib(d).u8_(@truncate(u8, n));
    // (the bytes, low first; past the limbs, the sign's)
    let sx = @bit_cast(u64, @bit_cast(i64, m.wide[m.wide.len - 1]) >> 63);
    for k in 0..n {
        let limb = @int_cast(usize, k / 8);
        let mut w = sx;
        if limb < m.wide.len {
            w = m.wide[limb];
        }
        ib(d).u8_(@truncate(u8, w >> @truncate(u32, 8 * (k % 8))));
    }
}

// The function's rows as a sequence of the line program: the rows in
// order, one per offset (the last there wins, but a prologue end is kept),
// none that repeats the location before it but a prologue end, and rows
// without a location (src 0) left out: their code is the row's before.
fn line_sequence(d: *mut Unit, f: *Func) void {
    let p = &mut d.parts[D_LINE];
    let b = &mut p.b;
    b.u8_(0);
    b.uleb(1 + d.addr_size);
    b.u8_(LNE_SET_ADDRESS);
    addr_ref(d, p, f.sym, 0);
    let mut addr: u64 = 0;
    let mut file: u32 = 1;
    let mut line: i64 = 1;
    let mut started = false;
    let n = f.rows.len;
    let mut k: usize = 0;
    while k < n {
        let r = f.rows[k];
        let off = (r >> 32) & 0x7fff_ffff;
        let mut pe = (r & ROW_PE) != 0;
        let mut src = @truncate(u32, r);
        // the last row at this offset (with a location) is the one
        while ((k + 1) < n) and (((f.rows[k + 1] >> 32) & 0x7fff_ffff) == off) {
            k += 1;
            let r2 = f.rows[k];
            if (r2 & ROW_PE) != 0 {
                pe = true;
            }
            if @truncate(u32, r2) != 0 {
                src = @truncate(u32, r2);
            }
        }
        k += 1;
        if off >= f.size {
            continue;  // (nothing after it: a row at the end)
        }
        let mut w = Where.{ file: file, line: @truncate(u32, @bit_cast(u64, line)) };
        if src != 0 {
            w = where_of(d, src);
            if w.line == 0 {
                w = Where.{ file: file, line: @truncate(u32, @bit_cast(u64, line)) };
            }
        } else if not started {
            continue;
        }
        if started and not pe and (w.file == file) and (@as(i64, w.line) == line) {
            continue;
        }
        if not started and (src == 0) {
            continue;
        }
        if not started and (off > 0) {
            // (code before the first location, the prologue's: that location's)
            row_at(b, &mut file, &mut line, &mut addr, w, 0, false);
            started = true;
            if not pe {
                continue;
            }
        }
        started = true;
        row_at(b, &mut file, &mut line, &mut addr, w, off, pe);
    }
    if not started {
        // (no location at all: the declaration's line for all of it, or line
        // 0, DWARF's "no source", for code the compiler made up)
        let mut w = where_of(d, f.src);
        if w.line == 0 {
            w = Where.{ file: 1, line: 0 };
        }
        row_at(b, &mut file, &mut line, &mut addr, w, 0, false);
    }
    if f.size > addr {
        b.u8_(LNS_ADVANCE_PC);
        b.uleb(f.size - addr);
    }
    b.u8_(0);
    b.uleb(1);
    b.u8_(LNE_END_SEQUENCE);
}

// A row of the line program: location w from code offset `off` on (pe: the
// prologue ends there), from the state (file, line, addr) of the row before.
fn row_at(b: *mut bn.Bytes, file: *mut u32, line: *mut i64, addr: *mut u64, w: Where, off: u64, pe: bool) void {
    if w.file != file.* {
        b.u8_(LNS_SET_FILE);
        b.uleb(@as(u64, w.file));
        file.* = w.file;
    }
    if pe {
        b.u8_(LNS_SET_PROLOGUE_END);
    }
    let dl = @as(i64, w.line) - line.*;
    let da = @bit_cast(i64, off - addr.*);
    let mut sp: i64 = -1;
    if (dl >= LINE_BASE) and (dl < (LINE_BASE + LINE_RANGE)) {
        sp = (dl - LINE_BASE) + (LINE_RANGE * da) + OPCODE_BASE;
    }
    if (sp >= 0) and (sp <= 255) {
        b.u8_(@truncate(u8, @bit_cast(u64, sp)));
    } else {
        if dl != 0 {
            b.u8_(LNS_ADVANCE_LINE);
            b.sleb(dl);
        }
        if da != 0 {
            b.u8_(LNS_ADVANCE_PC);
            b.uleb(@bit_cast(u64, da));
        }
        b.u8_(LNS_COPY);
    }
    addr.* = off;
    line.* = @as(i64, w.line);
}

// -----------------------------------------------------------------------------
// .debug_info
// -----------------------------------------------------------------------------
// Tags, attributes and forms (DWARF 5, 7.5)
pub const TAG_COMPILE_UNIT: u64 = 0x11;
pub const TAG_SUBPROGRAM: u64 = 0x2e;
pub const AT_NAME: u64 = 0x03;
pub const AT_STMT_LIST: u64 = 0x10;
pub const AT_LOW_PC: u64 = 0x11;
pub const AT_HIGH_PC: u64 = 0x12;
pub const AT_LANGUAGE: u64 = 0x13;
pub const AT_COMP_DIR: u64 = 0x1b;
pub const AT_PRODUCER: u64 = 0x25;
pub const AT_DECL_FILE: u64 = 0x3a;
pub const AT_DECL_LINE: u64 = 0x3b;
pub const AT_EXTERNAL: u64 = 0x3f;
pub const AT_FRAME_BASE: u64 = 0x40;
pub const FORM_ADDR: u64 = 0x01;
pub const FORM_DATA2: u64 = 0x05;
pub const FORM_DATA4: u64 = 0x06;
pub const FORM_DATA8: u64 = 0x07;
pub const FORM_DATA1: u64 = 0x0b;
pub const FORM_BLOCK1: u64 = 0x0a;
pub const FORM_FLAG: u64 = 0x0c;
pub const FORM_SDATA: u64 = 0x0d;
pub const FORM_STRP: u64 = 0x0e;
pub const FORM_UDATA: u64 = 0x0f;
pub const FORM_REF4: u64 = 0x13;
pub const FORM_SEC_OFFSET: u64 = 0x17;
pub const FORM_EXPRLOC: u64 = 0x18;
pub const FORM_FLAG_PRESENT: u64 = 0x19;
pub const FORM_LINE_STRP: u64 = 0x1f;
pub const OP_CALL_FRAME_CFA: u8 = 0x9c;

// Abbreviation codes (abbrev_table)
pub const AB_CU: u64 = 1;
pub const AB_CU_NOLANG: u64 = 2;
pub const AB_SUB_EXT: u64 = 3;
pub const AB_SUB: u64 = 4;
pub const AB_SUB_EXT_KIDS: u64 = 5;
pub const AB_SUB_KIDS: u64 = 6;
pub const AB_SUB_TYPED: u64 = 7;  // + AB_SUB_EXT .. AB_SUB_KIDS - 3: with DW_AT_type (a C function's result)
const AB_CU_RANGES: u64 = 82;     // + 0 with the language, 1 without: code in several sections (after AB_IVAR_LIST)
// call sites (DW_TAG_call_site): + 0 with the callee's address (DW_AT_call_target), 1 without; + 2 with
// parameters; + 4: a call in tail position (DW_AT_call_pc, DW_AT_call_tail_call; no parameters)
const AB_CALL: u64 = 84;
const AB_CPARAM: u64 = 90;  // DW_TAG_call_site_parameter: its register, its value
// a subprogram with call sites (DW_AT_call_all_calls): + 0 external, 1 not; + 2 with DW_AT_type
const AB_SUB_CALLS: u64 = 91;
const AT_CALL_ALL_CALLS: u64 = 0x7a;
// a unit with macros (DW_AT_macros after DW_AT_stmt_list): AB_CU, AB_CU_NOLANG, AB_CU_RANGES, + 1's
const AB_CU_MACROS: u64 = 95;
// an enumerator whose value is not a signed 64-bit one: + 0 unsigned 64-bit
// (DW_FORM_udata), 1 wider (DW_FORM_block1, the value as in memory, of 16
// bytes or the type's size: DWARF 5, 7.5.5). Not DW_FORM_data16: a debugger
// that does not know that form drops the whole unit whose abbreviations
// name it, even where no entry uses it.
const AB_ENUMERATOR_WIDE: u64 = 100;
const AT_MACROS: u64 = 0x79;
const TAG_CALL_SITE: u64 = 0x48;
const TAG_CALL_SITE_PARAMETER: u64 = 0x49;
const AT_CALL_RETURN_PC: u64 = 0x7d;
const AT_CALL_VALUE: u64 = 0x7e;
const AT_CALL_PC: u64 = 0x81;
const AT_CALL_TAIL_CALL: u64 = 0x82;
const AT_CALL_TARGET: u64 = 0x83;

// The abbreviations: code, tag, children, (attribute, form) pairs, 0 0.
fn abbrev_table(b: *mut bn.Bytes) void {
    let cu: [7][2]u64 = [[AT_PRODUCER, FORM_STRP], [AT_LANGUAGE, FORM_DATA2], [AT_NAME, FORM_STRP],
                         [AT_COMP_DIR, FORM_STRP], [AT_LOW_PC, FORM_ADDR], [AT_HIGH_PC, FORM_DATA4],
                         [AT_STMT_LIST, FORM_SEC_OFFSET]];
    abbrev(b, AB_CU, TAG_COMPILE_UNIT, true, cu[..]);
    let cu2: [6][2]u64 = [[AT_PRODUCER, FORM_STRP], [AT_NAME, FORM_STRP], [AT_COMP_DIR, FORM_STRP],
                          [AT_LOW_PC, FORM_ADDR], [AT_HIGH_PC, FORM_DATA4], [AT_STMT_LIST, FORM_SEC_OFFSET]];
    abbrev(b, AB_CU_NOLANG, TAG_COMPILE_UNIT, true, cu2[..]);
    // (the code in several sections: its ranges, the base address 0)
    let cur: [7][2]u64 = [[AT_PRODUCER, FORM_STRP], [AT_LANGUAGE, FORM_DATA2], [AT_NAME, FORM_STRP],
                          [AT_COMP_DIR, FORM_STRP], [AT_LOW_PC, FORM_ADDR], [AT_RANGES, FORM_SEC_OFFSET],
                          [AT_STMT_LIST, FORM_SEC_OFFSET]];
    abbrev(b, AB_CU_RANGES, TAG_COMPILE_UNIT, true, cur[..]);
    let cur2: [6][2]u64 = [[AT_PRODUCER, FORM_STRP], [AT_NAME, FORM_STRP], [AT_COMP_DIR, FORM_STRP],
                           [AT_LOW_PC, FORM_ADDR], [AT_RANGES, FORM_SEC_OFFSET], [AT_STMT_LIST, FORM_SEC_OFFSET]];
    abbrev(b, AB_CU_RANGES + 1, TAG_COMPILE_UNIT, true, cur2[..]);
    let mcu: [8][2]u64 = [[AT_PRODUCER, FORM_STRP], [AT_LANGUAGE, FORM_DATA2], [AT_NAME, FORM_STRP],
                          [AT_COMP_DIR, FORM_STRP], [AT_LOW_PC, FORM_ADDR], [AT_HIGH_PC, FORM_DATA4],
                          [AT_STMT_LIST, FORM_SEC_OFFSET], [AT_MACROS, FORM_SEC_OFFSET]];
    abbrev(b, AB_CU_MACROS, TAG_COMPILE_UNIT, true, mcu[..]);
    let mcu2: [7][2]u64 = [[AT_PRODUCER, FORM_STRP], [AT_NAME, FORM_STRP], [AT_COMP_DIR, FORM_STRP],
                           [AT_LOW_PC, FORM_ADDR], [AT_HIGH_PC, FORM_DATA4], [AT_STMT_LIST, FORM_SEC_OFFSET],
                           [AT_MACROS, FORM_SEC_OFFSET]];
    abbrev(b, AB_CU_MACROS + 1, TAG_COMPILE_UNIT, true, mcu2[..]);
    let mcur: [8][2]u64 = [[AT_PRODUCER, FORM_STRP], [AT_LANGUAGE, FORM_DATA2], [AT_NAME, FORM_STRP],
                           [AT_COMP_DIR, FORM_STRP], [AT_LOW_PC, FORM_ADDR], [AT_RANGES, FORM_SEC_OFFSET],
                           [AT_STMT_LIST, FORM_SEC_OFFSET], [AT_MACROS, FORM_SEC_OFFSET]];
    abbrev(b, AB_CU_MACROS + 2, TAG_COMPILE_UNIT, true, mcur[..]);
    let mcur2: [7][2]u64 = [[AT_PRODUCER, FORM_STRP], [AT_NAME, FORM_STRP], [AT_COMP_DIR, FORM_STRP],
                            [AT_LOW_PC, FORM_ADDR], [AT_RANGES, FORM_SEC_OFFSET], [AT_STMT_LIST, FORM_SEC_OFFSET],
                            [AT_MACROS, FORM_SEC_OFFSET]];
    abbrev(b, AB_CU_MACROS + 3, TAG_COMPILE_UNIT, true, mcur2[..]);
    let cs: [2][2]u64 = [[AT_CALL_RETURN_PC, FORM_ADDR], [AT_CALL_TARGET, FORM_EXPRLOC]];
    abbrev(b, AB_CALL, TAG_CALL_SITE, false, cs[..]);
    abbrev(b, AB_CALL + 1, TAG_CALL_SITE, false, cs[0..1]);
    abbrev(b, AB_CALL + 2, TAG_CALL_SITE, true, cs[..]);
    abbrev(b, AB_CALL + 3, TAG_CALL_SITE, true, cs[0..1]);
    let ts: [3][2]u64 = [
        [AT_CALL_PC, FORM_ADDR], [AT_CALL_TAIL_CALL, FORM_FLAG_PRESENT], [AT_CALL_TARGET, FORM_EXPRLOC]];
    abbrev(b, AB_CALL + 4, TAG_CALL_SITE, false, ts[..]);
    abbrev(b, AB_CALL + 5, TAG_CALL_SITE, false, ts[0..2]);
    let cp: [2][2]u64 = [[AT_LOCATION, FORM_EXPRLOC], [AT_CALL_VALUE, FORM_EXPRLOC]];
    abbrev(b, AB_CPARAM, TAG_CALL_SITE_PARAMETER, false, cp[..]);
    let sub: [7][2]u64 = [[AT_NAME, FORM_STRP], [AT_LOW_PC, FORM_ADDR], [AT_HIGH_PC, FORM_DATA4],
                          [AT_FRAME_BASE, FORM_EXPRLOC], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA],
                          [AT_EXTERNAL, FORM_FLAG_PRESENT]];
    abbrev(b, AB_SUB_EXT, TAG_SUBPROGRAM, false, sub[..]);
    abbrev(b, AB_SUB, TAG_SUBPROGRAM, false, sub[0..6]);
    abbrev(b, AB_SUB_EXT_KIDS, TAG_SUBPROGRAM, true, sub[..]);
    abbrev(b, AB_SUB_KIDS, TAG_SUBPROGRAM, true, sub[0..6]);
    let tsub: [9][2]u64 = [[AT_NAME, FORM_STRP], [AT_LOW_PC, FORM_ADDR], [AT_HIGH_PC, FORM_DATA4],
                           [AT_FRAME_BASE, FORM_EXPRLOC], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA],
                           [AT_PROTOTYPED, FORM_FLAG_PRESENT], [AT_TYPE, FORM_REF4], [AT_EXTERNAL, FORM_FLAG_PRESENT]];
    abbrev(b, AB_SUB_TYPED, TAG_SUBPROGRAM, false, tsub[..]);
    abbrev(b, AB_SUB_TYPED + 1, TAG_SUBPROGRAM, false, tsub[0..8]);
    abbrev(b, AB_SUB_TYPED + 2, TAG_SUBPROGRAM, true, tsub[..]);
    abbrev(b, AB_SUB_TYPED + 3, TAG_SUBPROGRAM, true, tsub[0..8]);
    let csub: [8][2]u64 = [[AT_NAME, FORM_STRP], [AT_LOW_PC, FORM_ADDR], [AT_HIGH_PC, FORM_DATA4],
                           [AT_FRAME_BASE, FORM_EXPRLOC], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA],
                           [AT_CALL_ALL_CALLS, FORM_FLAG_PRESENT], [AT_EXTERNAL, FORM_FLAG_PRESENT]];
    abbrev(b, AB_SUB_CALLS, TAG_SUBPROGRAM, true, csub[..]);
    abbrev(b, AB_SUB_CALLS + 1, TAG_SUBPROGRAM, true, csub[0..7]);
    let ctsub: [10][2]u64 = [[AT_NAME, FORM_STRP], [AT_LOW_PC, FORM_ADDR], [AT_HIGH_PC, FORM_DATA4],
                             [AT_FRAME_BASE, FORM_EXPRLOC], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA],
                             [AT_PROTOTYPED, FORM_FLAG_PRESENT], [AT_TYPE, FORM_REF4],
                             [AT_CALL_ALL_CALLS, FORM_FLAG_PRESENT], [AT_EXTERNAL, FORM_FLAG_PRESENT]];
    abbrev(b, AB_SUB_CALLS + 2, TAG_SUBPROGRAM, true, ctsub[..]);
    abbrev(b, AB_SUB_CALLS + 3, TAG_SUBPROGRAM, true, ctsub[0..9]);
    type_abbrevs(b);
    b.u8_(0);
}

pub fn abbrev(b: *mut bn.Bytes, code: u64, tag: u64, children: bool, attrs: [][2]u64) void {
    b.uleb(code);
    b.uleb(tag);
    if children {
        b.u8_(1);
    } else {
        b.u8_(0);
    }
    for a in attrs {
        b.uleb(a[0]);
        b.uleb(a[1]);
    }
    b.u8_(0);
    b.u8_(0);
}

// The function's DW_TAG_subprogram (after the unit's DIE: finish_elf puts
// the header and that DIE before these), with its variables and types in
// its lexical blocks.
fn subprogram(d: *mut Unit, f: *Func) void {
    let mut vs: []dbi.DVar = u.nil_slice.[dbi.DVar]();
    let mut sc: [2]u32 = [0, 0];
    if d.full and u.notnil(f.irf) {
        vs = dbi.vars_of(f.irf.name);
        sc = dbi.scopes_of(f.irf.name);
    }
    // (its lexical blocks and the inline instances of the functions inlined into it)
    let mut tr = scope_tree(f, sc);
    let mut kids = (vs.len > 0) or (tr.kids.get(0).len > 0) or (d.full and (f.calls.len > 0));
    if sc[0] != 0 {
        kids = kids or (dbi.scopes.at(@as(usize, sc[0])).types.len > 0);
    }
    let mut rt: i32 = -2;
    if d.full and u.notnil(f.irf) {
        rt = dbi.result_of(f.irf.name);
    }
    let p = &mut d.parts[D_INFO];
    let mut code = AB_SUB;
    if f.external {
        code = pk(kids, AB_SUB_EXT_KIDS, AB_SUB_EXT);
    } else if kids {
        code = AB_SUB_KIDS;
    }
    if rt >= 0 {
        code += AB_SUB_TYPED - AB_SUB_EXT;
    }
    if d.full and (f.calls.len > 0) {
        // (every call it makes is a call site: DWARF 5, 3.3.1.5)
        code = AB_SUB_CALLS + pk(f.external, 0, 1) + pk(rt >= 0, 2, 0);
    }
    named(d, f.name, TAG_SUBPROGRAM, @as(u64, p.b.len()));
    p.b.uleb(code);
    let so = str_off(d, f.name);
    p.fx.push(Fix.{ off: @as(u64, p.b.len()), kind: FX_SEC, sym: @truncate(u32, D_STR), addend: @as(i64, so) });
    p.b.u32_(0);
    addr_ref(d, p, f.sym, 0);
    p.b.u32_(f.size);
    frame_base(d, f);
    let w = where_of(d, f.src);
    p.b.uleb(@as(u64, w.file));
    p.b.uleb(@as(u64, w.line));
    if rt >= 0 {
        tref(d, rt);
    }
    if kids {
        d.voffs.clear();
        for _k in 0..vs.len {
            d.voffs.push(0);
        }
        scope_body(d, f, vs, sc, &tr, 0);
        d.voffs.clear();
        if d.full {
            call_sites(d, f);
        }
        d.parts[D_INFO].b.u8_(0);
    }
    free_tree(&mut tr);
}

// The function's call sites (DWARF 5, 3.4; dloc.ax), as children of its
// subprogram: where each call returns (a call in tail position: where it
// is, flagged), its callee's address (a function's; or the pointer a datum
// holds, read from it), and the arguments known in registers, for the
// entry values of the callee's parameters.
fn call_sites(d: *mut Unit, f: *Func) void {
    for c in f.calls {
        let mut tsym: u32 = 0;  // (+ 1)
        if c.sym >= 0 {
            tsym = @as(u32, @bit_cast(u32, c.sym)) + 1;
        } else if c.tgsym.len > 0 {
            tsym = d.gsyms.get(u.intern(c.tgsym));
        }
        let has_t = tsym != 0;
        let mut code = AB_CALL + pk(has_t, 0, 1);
        if c.tail {
            code = AB_CALL + 4 + pk(has_t, 0, 1);
        } else if c.params.len > 0 {
            code += 2;
        }
        ib(d).uleb(code);
        if c.tail {
            addr_ref(d, &mut d.parts[D_INFO], f.sym, c.at);
        } else {
            addr_ref(d, &mut d.parts[D_INFO], f.sym, c.ret);
        }
        if has_t {
            if c.sym >= 0 {
                ib(d).uleb(1 + d.addr_size);
                ib(d).u8_(OP_ADDR);
                addr_ref(d, &mut d.parts[D_INFO], tsym - 1, 0);
            } else {
                // (the pointer at the datum's address + toff)
                ib(d).uleb(2 + d.addr_size);
                ib(d).u8_(OP_ADDR);
                addr_ref(d, &mut d.parts[D_INFO], tsym - 1, @bit_cast(u64, c.toff));
                ib(d).u8_(OP_DEREF);
            }
        }
        if c.tail or (c.params.len == 0) {
            continue;
        }
        for q in c.params {
            ib(d).uleb(AB_CPARAM);
            ib(d).uleb(1);
            ib(d).u8_(OP_REG0 + @truncate(u8, @as(u32, @bit_cast(u32, q.reg))));
            ib(d).uleb(@as(u64, q.expr.len) + 1);
            for b in q.expr {
                ib(d).u8_(b);
            }
            ib(d).u8_(OP_STACK_VALUE);
        }
        ib(d).u8_(0);
    }
}

// DW_AT_frame_base (an exprloc): the CFA natively; on WebAssembly the value
// of the local that holds the frame's address (WebAssembly's DWARF
// extension, DW_OP_WASM_location 0 (a local) index, then DW_OP_stack_value),
// or of __stack_pointer (global 0) for a function without a frame.
const OP_WASM_LOCATION: u8 = 0xed;
const OP_STACK_VALUE: u8 = 0x9f;

fn frame_base(d: *mut Unit, f: *Func) void {
    let p = &mut d.parts[D_INFO];
    if d.arch != ARCH_WASM {
        p.b.uleb(1);
        p.b.u8_(OP_CALL_FRAME_CFA);
        return;
    }
    let mut e = bn.new_bytes();
    e.u8_(OP_WASM_LOCATION);
    if f.frame_local >= 0 {
        e.u8_(0);
        e.uleb(@bit_cast(u64, f.frame_local));
    } else {
        e.u8_(3);  // (a global, its index a fixed 4 bytes)
        e.u32_(0);
    }
    e.u8_(OP_STACK_VALUE);
    p.b.uleb(@as(u64, e.len()));
    p.b.put(e.view());
    e.free();
}

/// A piece of code of a lexical block: [start, end) offsets in its function.
pub struct Piece {
    start: u64,
    end: u64,
}

// The scopes of a function's code: its root (node 0: its outermost scope,
// sc[0], or none), its lexical blocks (dbginfo.scopes_of), and the inline
// instances (their roots, the copies of their blocks: dbginfo.add_inline)
// its code is in, each node with its parent's, its children and its code:
// the pieces whose instructions are in it or in a scope inside it
// (codeview.ax's blocks and inline sites too).
pub struct Tree {
    ids: u.List.[u32],            // node -> its scope (node 0: sc[0], which may be 0)
    up: u.List.[u32],             // node -> its parent's node
    idx: u.U64Map,                // scope + 1 -> its node + 1
    kids: u.List.[u.List.[u32]],  // node -> its children's nodes
    pieces: u.List.[u.List.[Piece]],
}

/// Frees tree t (scope_tree).
pub fn free_tree(t: *mut Tree) void {
    for k in 0..t.kids.len {
        t.kids.at(k).deinit();
        t.pieces.at(k).deinit();
    }
    t.ids.deinit();
    t.up.deinit();
    t.idx.deinit();
    t.kids.deinit();
    t.pieces.deinit();
}

// Is scope s one of the function's (sc: its own scopes), or a scope of
// code inlined into it (an inline instance in one of its scopes)? Code moved
// from another function (outlined) is not.
fn scope_mine(s: u32, sc: [2]u32) bool {
    let mut x = s;
    let mut n: u32 = 0;
    while (x != 0) and (n < 100000) {
        if (x >= sc[0]) and (x <= sc[1]) and (sc[0] != 0) {
            return true;
        }
        if @as(usize, x) >= dbi.scopes.len {
            return false;
        }
        let ds = dbi.scopes.get(@as(usize, x));
        if not ds.inl and not ds.copy {
            return false;  // (another function's)
        }
        x = ds.parent;
        n += 1;
    }
    return true;  // (an inline instance at the top: in the outermost scope)
}

// The node of scope s (made, with its parents', if new).
fn tree_node(t: *mut Tree, s: u32, sc: [2]u32) u32 {
    if (s == 0) or (s == sc[0]) {
        return 0;
    }
    let k = @as(u64, s) + 1;
    let at = @truncate(u32, t.idx.get(k));
    if at != 0 {
        return at - 1;
    }
    let pn = tree_node(t, dbi.scopes.get(@as(usize, s)).parent, sc);
    let n = @truncate(u32, t.ids.len);
    t.ids.push(s);
    t.up.push(pn);
    t.kids.push(u.List.[u32].empty());
    t.pieces.push(u.List.[Piece].empty());
    t.kids.at(@as(usize, pn)).push(n);
    t.idx.put(k, @as(u64, n) + 1);
    return n;
}

/// The tree of f's scopes (sc: its own, dbginfo.scopes_of; see Tree).
pub fn scope_tree(f: *Func, sc: [2]u32) Tree {
    let mut t = Tree.{ ids: u.List.[u32].empty(), up: u.List.[u32].empty(), idx: u.U64Map.empty(),
                       kids: u.List.[u.List.[u32]].empty(), pieces: u.List.[u.List.[Piece]].empty() };
    t.ids.push(sc[0]);
    t.up.push(0);
    t.kids.push(u.List.[u32].empty());
    t.pieces.push(u.List.[Piece].empty());
    if sc[0] != 0 {
        for s in (sc[0] + 1)..(sc[1] + 1) {
            _ = tree_node(&mut t, s, sc);
        }
    }
    let mut k: usize = 0;
    while k < f.scopes.len {
        let start = f.scopes[k] >> 32;
        let mut end = f.size;
        if k + 1 < f.scopes.len {
            end = f.scopes[k + 1] >> 32;
        }
        let s = @truncate(u32, f.scopes[k]);
        k += 1;
        if (end <= start) or (start >= f.size) {
            continue;
        }
        let mut n: u32 = 0;
        if scope_mine(s, sc) {
            n = tree_node(&mut t, s, sc);
        }
        loop {
            let l = t.pieces.at(@as(usize, n));
            if (l.len > 0) and (l.last().end == start) {
                l.at(l.len - 1).end = @min(end, f.size);
            } else {
                l.push(Piece.{ start: start, end: @min(end, f.size) });
            }
            if n == 0 {
                break;
            }
            n = t.up.get(@as(usize, n));
        }
    }
    return t;
}

// The entries in node n of f's scopes (sc: f's own, tr: the tree): its
// variables, its types, then its lexical blocks and inline instances that
// have code (a block without any is left out with what it declares: no code
// is in its scope).
fn scope_body(d: *mut Unit, f: *Func, vs: []dbi.DVar, sc: [2]u32, tr: *Tree, n: u32) void {
    let s = tr.ids.get(@as(usize, n));
    let mut clip = u.nil_slice.[Piece]();
    if n != 0 {
        clip = tr.pieces.at(@as(usize, n)).items();
    }
    let mut own = n == 0;
    if (n != 0) and (@as(usize, s) < dbi.scopes.len) {
        let ds = dbi.scopes.get(@as(usize, s));
        own = not ds.inl and not ds.copy;
    }
    if own {
        for k in 0..vs.len {
            let mut vsc = vs[k].scope;
            if (vsc < sc[0]) or (vsc > sc[1]) {
                vsc = sc[0];
            }
            if vsc == s {
                var_die(d, f, k, vs[k], clip);
            }
        }
        if s != 0 {
            for t in dbi.scopes.at(@as(usize, s)).types.items() {
                write_type(d, t);
            }
        }
    } else {
        inline_vars(d, f, s, clip);
    }
    for c in tr.kids.at(@as(usize, n)).items() {
        let ps = tr.pieces.at(@as(usize, c)).items();
        if ps.len == 0 {
            continue;
        }
        let cs = dbi.scopes.get(@as(usize, tr.ids.get(@as(usize, c))));
        if cs.inl {
            // (an inline instance: DWARF 5, 3.3.8.2)
            named(d, abs_name(cs.func), TAG_INLINED_SUBROUTINE, @as(u64, ib(d).len()));
            ib(d).uleb(pk(ps.len == 1, AB_INL, AB_INL_RANGES));
            abs_ref(d, cs.func, 0);
        } else {
            ib(d).uleb(pk(ps.len == 1, AB_LEX, AB_LEX_RANGES));
        }
        if ps.len == 1 {
            addr_ref(d, &mut d.parts[D_INFO], f.sym, ps[0].start);
            ib(d).u32_(ps[0].end - ps[0].start);
        } else {
            sec_ref(d, &mut d.parts[D_INFO], D_RNGLISTS, @as(u64, list_start(d, D_RNGLISTS)));
            let r = &mut d.parts[D_RNGLISTS];
            for pc in ps {
                r.b.u8_(RLE_START_LENGTH);
                addr_ref(d, r, f.sym, pc.start);
                r.b.uleb(pc.end - pc.start);
            }
            r.b.u8_(RLE_END_OF_LIST);
        }
        if cs.inl {
            // (DW_AT_call_file, DW_AT_call_line; line 0 where the compiler
            // made the call: debuggers show an instance only with them)
            decl_at(d, cs.call);
        }
        scope_body(d, f, vs, sc, tr, c);
        ib(d).u8_(0);
    }
}

// The variables of an inlined function in scope s of one of its inline
// instances (the instance's root, or a copy of one of its blocks), within
// the code `clip`: each one's entry refers to its abstract instance's
// (DW_AT_abstract_origin), with its location list (dloc.ax: the
// instance's), if any.
fn inline_vars(d: *mut Unit, f: *Func, s: u32, clip: []Piece) void {
    if not d.full {
        return;
    }
    let inst = dbi.inline_root(s);
    if inst == 0 {
        return;
    }
    let g = dbi.scopes.get(@as(usize, inst)).func;
    let gs = dbi.vars_of(g);
    let gsc = dbi.scopes_of(g);
    let mut want = dbi.origin(s);
    if s == inst {
        want = gsc[0];
    }
    for k in 0..gs.len {
        let v = gs[k];
        if (v.ty < 0) or u.notnil(v.global) or v.artificial {
            continue;
        }
        let mut vsc = v.scope;
        if (vsc < gsc[0]) or (vsc > gsc[1]) {
            vsc = gsc[0];
        }
        if vsc != want {
            continue;
        }
        let pv = pk(v.param, @as(u64, 1), @as(u64, 0));
        if (f.vlocs.len > 0) and optimized_var(d, f, k, v, pv, clip, false, inst, g) {
            continue;
        }
        ib(d).uleb(AB_IVAR + pv);
        abs_ref(d, g, k + 1);
    }
}

/// The name for people of function `ir_name` (interned), which was inlined.
pub fn abs_name(ir_name: []u8) []u8 {
    let n = dbi.func_name(ir_name, elf.display_name(ir_name));
    if u.starts(n, "axiom.export.") and (n.len > 13) {
        return n[13..];
    }
    return n;
}

// A reference to the abstract instance of function `ir_name` (interned;
// k 0), or to that of its variable k - 1 (DWARF 5, 3.3.8.1), which finish
// writes.
fn abs_ref(d: *mut Unit, ir_name: []u8, k: usize) void {
    let key = u.intern(ir_name);
    let mut a = d.abs_map.get(key);
    if a == 0 {
        d.abs_fns.push(key);
        a = @truncate(u32, d.abs_fns.len);
        d.abs_map.put(key, a);
    }
    d.arefs.push(Fix.{ off: @as(u64, ib(d).len()), kind: FX_SEC, sym: a - 1, addend: @int_cast(i64, k) });
    ib(d).u32_(0);
}

// The abstract instances of the functions inlined (abs_ref): each a
// subprogram with DW_AT_inline, its name, declaration and result, and its
// parameters and variables (their names, declarations and types); then the
// references to them.
fn abstracts(d: *mut Unit) void {
    let mut offs = u.List.[u.List.[u64]].empty();
    let mut j: usize = 0;
    while j < d.abs_fns.len {
        let g = d.abs_fns.get(j);
        j += 1;
        let mut l = u.List.[u64].empty();
        let mut gs: []dbi.DVar = u.nil_slice.[dbi.DVar]();
        let mut rt: i32 = -2;
        if d.full {
            gs = dbi.vars_of(g);
            rt = dbi.result_of(g);
        }
        let nm = abs_name(g);
        let at = @as(u64, ib(d).len());
        l.push(at);
        named(d, nm, TAG_SUBPROGRAM, at);
        let kids = gs.len > 0;
        let mut code = pk(kids, AB_ABS_KIDS, AB_ABS);
        if rt >= 0 {
            code += 2;
        }
        ib(d).uleb(code);
        strp(d, nm);
        decl_at(d, dbi.decl_of(g));
        if rt >= 0 {
            tref(d, rt);
        }
        ib(d).u8_(1);  // DW_INL_inlined
        for k in 0..gs.len {
            let v = gs[k];
            if (v.ty < 0) or u.notnil(v.global) or v.artificial {
                l.push(0);
                continue;
            }
            l.push(@as(u64, ib(d).len()));
            ib(d).uleb(AB_AVAR + pk(v.param, @as(u64, 1), @as(u64, 0)));
            strp(d, v.name);
            decl_at(d, v.src);
            tref(d, v.ty);
        }
        if kids {
            ib(d).u8_(0);
        }
        offs.push(l);
    }
    for x in d.arefs.items() {
        let l = offs.at(@as(usize, x.sym));
        let k = @bit_cast(u64, x.addend);
        let mut v = l.get(0);
        if (k < @as(u64, l.len)) and (l.get(@truncate(usize, k)) != 0) {
            v = l.get(@truncate(usize, k));
        }
        d.drefs.push(Fix.{ off: x.off, kind: FX_SEC, sym: 0, addend: @bit_cast(i64, v) });
    }
    d.arefs.deinit();
    for k in 0..offs.len {
        offs.at(k).deinit();
    }
    offs.deinit();
}

// Where the next list of .debug_rnglists or .debug_loclists (sec) starts:
// after the unit's header (DWARF 5, 7.28, 7.29), written with the first.
fn list_start(d: *mut Unit, sec: usize) usize {
    let b = &mut d.parts[sec].b;
    if b.len() == 0 {
        b.u32_(0);  // (the length: finish)
        b.u16_(5);
        b.u8_(@truncate(u8, d.addr_size));
        b.u8_(0);
        b.u32_(0);  // offset_entry_count: lists are referred to by their offsets
    }
    return b.len();
}

// -----------------------------------------------------------------------------
// Types and variables (DEBUG_FULL; dbginfo.ax)
// -----------------------------------------------------------------------------
pub const NO_LOC: i64 = -0x7fff_ffff_ffff_ffff;

pub const TAG_ARRAY_TYPE: u64 = 0x01;
pub const TAG_ENUMERATION_TYPE: u64 = 0x04;
pub const TAG_FORMAL_PARAMETER: u64 = 0x05;
pub const TAG_MEMBER: u64 = 0x0d;
pub const TAG_POINTER_TYPE: u64 = 0x0f;
pub const TAG_STRUCTURE_TYPE: u64 = 0x13;
pub const TAG_SUBROUTINE_TYPE: u64 = 0x15;
pub const TAG_UNION_TYPE: u64 = 0x17;
pub const TAG_UNSPECIFIED_PARAMETERS: u64 = 0x18;
pub const TAG_UNSPECIFIED_TYPE: u64 = 0x3b;
pub const TAG_SUBRANGE_TYPE: u64 = 0x21;
pub const TAG_BASE_TYPE: u64 = 0x24;
pub const TAG_CONST_TYPE: u64 = 0x26;
pub const TAG_ENUMERATOR: u64 = 0x28;
pub const TAG_VARIABLE: u64 = 0x34;
pub const TAG_VOLATILE_TYPE: u64 = 0x35;
pub const TAG_RESTRICT_TYPE: u64 = 0x37;
pub const TAG_ATOMIC_TYPE: u64 = 0x47;
pub const TAG_LEXICAL_BLOCK: u64 = 0x0b;
pub const TAG_TYPEDEF: u64 = 0x16;
pub const AT_RANGES: u64 = 0x55;
pub const AT_ARTIFICIAL: u64 = 0x34;
pub const OP_DEREF: u8 = 0x06;
pub const OP_CONST8U: u8 = 0x0e;
pub const OP_FORM_TLS_ADDRESS: u8 = 0x9b;
const RLE_END_OF_LIST: u8 = 0x00;
const RLE_START_LENGTH: u8 = 0x07;
pub const AT_LOCATION: u64 = 0x02;
pub const AT_BYTE_SIZE: u64 = 0x0b;
pub const AT_BIT_SIZE: u64 = 0x0d;
pub const AT_CONST_VALUE: u64 = 0x1c;
pub const AT_PROTOTYPED: u64 = 0x27;
pub const AT_COUNT: u64 = 0x37;
pub const AT_DATA_MEMBER_LOCATION: u64 = 0x38;
pub const AT_DECLARATION: u64 = 0x3c;
pub const AT_ENCODING: u64 = 0x3e;
pub const AT_TYPE: u64 = 0x49;
pub const AT_DATA_BIT_OFFSET: u64 = 0x6b;
pub const OP_ADDR: u8 = 0x03;
pub const OP_FBREG: u8 = 0x91;

// Abbreviation codes of types and variables (type_abbrevs)
const AB_BASE: u64 = 16;
const AB_PTR: u64 = 17;
const AB_PTR_VOID: u64 = 18;
const AB_QUAL: u64 = 19;  // + 2k (const, volatile, restrict, _Atomic), + 1: of void
const AB_ARRAY: u64 = 27;
const AB_SUBRANGE: u64 = 28;
const AB_SUBRANGE_N: u64 = 29;
const AB_RECORD: u64 = 30;  // + 0 a structure, 1 a union; + 2: without a name; + 4: incomplete
const AB_MEMBER: u64 = 38;
const AB_MEMBER_ANON: u64 = 39;
const AB_BITFIELD: u64 = 40;
const AB_ENUM: u64 = 41;
const AB_ENUM_ANON: u64 = 42;
const AB_ENUMERATOR: u64 = 43;
const AB_FTYPE: u64 = 44;
const AB_FTYPE_VOID: u64 = 45;
const AB_FPARAM: u64 = 46;
const AB_UNSPEC: u64 = 47;
const AB_LVAR: u64 = 48;  // + 0 a variable, 1 a parameter; + 2: optimized out (no location)
const AB_GVAR: u64 = 52;  // + 1: not external
const AB_LEX: u64 = 54;
const AB_LEX_RANGES: u64 = 55;
const AB_TYPEDEF: u64 = 56;
const AB_TYPEDEF_VOID: u64 = 57;
const AB_SUBRANGE_V: u64 = 58;  // the count: a reference to a variable (a VLA's length)
const AB_ART: u64 = 59;         // an artificial variable (the length of a VLA)
const AB_BASE_BITS: u64 = 60;   // a base type narrower than its storage
const AB_LVAR_LIST: u64 = 61;   // + 0 a variable, 1 a parameter: a location list
const AB_LVAR_CONST: u64 = 63;  // + 0 a variable, 1 a parameter: a constant value
const AB_VPART: u64 = 65;
const AB_VARIANT: u64 = 66;
const AB_VARIANT_EMPTY: u64 = 67;
const AB_ART_LIST: u64 = 68;    // an artificial variable with a location list
const AB_OTHER_TYPE: u64 = 69;  // a type of a kind not described otherwise (DW_TAG_unspecified_type)
const AB_ABS: u64 = 70;         // an abstract instance (+ 1: with children; + 2: with a result type)
const AB_ABS_KIDS: u64 = 71;
const AB_AVAR: u64 = 74;        // + 0 a variable, 1 a parameter: of an abstract instance
const AB_INL: u64 = 76;         // an inline instance (DW_TAG_inlined_subroutine), its code in one piece
const AB_INL_RANGES: u64 = 77;  // in several
const AB_IVAR: u64 = 78;        // + 0 a variable, 1 a parameter: of an inline instance, without a location
const AB_IVAR_LIST: u64 = 80;   // + 0 a variable, 1 a parameter: of an inline instance, a location list
pub const TAG_INLINED_SUBROUTINE: u64 = 0x1d;
pub const AT_INLINE: u64 = 0x20;
pub const AT_ABSTRACT_ORIGIN: u64 = 0x31;
pub const AT_CALL_FILE: u64 = 0x58;
pub const AT_CALL_LINE: u64 = 0x59;
pub const TAG_VARIANT: u64 = 0x19;
pub const TAG_VARIANT_PART: u64 = 0x33;
pub const AT_DISCR: u64 = 0x15;
pub const AT_DISCR_VALUE: u64 = 0x16;
const LLE_END_OF_LIST: u8 = 0x00;
const LLE_START_LENGTH: u8 = 0x08;
const OP_REG0: u8 = 0x50;
const OP_REGX: u8 = 0x90;
const OP_BREG0: u8 = 0x70;
const OP_BREGX: u8 = 0x92;
const OP_DEREF_SIZE: u8 = 0x94;
const OP_CONSTS: u8 = 0x11;
const OP_PLUS: u8 = 0x22;
const OP_PIECE: u8 = 0x93;
const OP_IMPLICIT_VALUE: u8 = 0x9e;

fn type_abbrevs(b: *mut bn.Bytes) void {
    let base: [3][2]u64 = [[AT_NAME, FORM_STRP], [AT_BYTE_SIZE, FORM_UDATA], [AT_ENCODING, FORM_DATA1]];
    abbrev(b, AB_BASE, TAG_BASE_TYPE, false, base[..]);
    let ptr: [2][2]u64 = [[AT_BYTE_SIZE, FORM_UDATA], [AT_TYPE, FORM_REF4]];
    abbrev(b, AB_PTR, TAG_POINTER_TYPE, false, ptr[..]);
    abbrev(b, AB_PTR_VOID, TAG_POINTER_TYPE, false, ptr[0..1]);
    let quals: [4]u64 = [TAG_CONST_TYPE, TAG_VOLATILE_TYPE, TAG_RESTRICT_TYPE, TAG_ATOMIC_TYPE];
    let ty: [1][2]u64 = [[AT_TYPE, FORM_REF4]];
    for k in @as(usize, 0)..4 {
        abbrev(b, AB_QUAL + (2 * @as(u64, k)), quals[k], false, ty[..]);
        abbrev(b, AB_QUAL + (2 * @as(u64, k)) + 1, quals[k], false, ty[0..0]);
    }
    abbrev(b, AB_ARRAY, TAG_ARRAY_TYPE, true, ty[..]);
    abbrev(b, AB_SUBRANGE, TAG_SUBRANGE_TYPE, false, ty[0..0]);
    let cnt: [1][2]u64 = [[AT_COUNT, FORM_UDATA]];
    abbrev(b, AB_SUBRANGE_N, TAG_SUBRANGE_TYPE, false, cnt[..]);
    let rec: [4][2]u64 = [
        [AT_NAME, FORM_STRP], [AT_BYTE_SIZE, FORM_UDATA], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA]];
    let decl: [2][2]u64 = [[AT_NAME, FORM_STRP], [AT_DECLARATION, FORM_FLAG_PRESENT]];
    let tags: [2]u64 = [TAG_STRUCTURE_TYPE, TAG_UNION_TYPE];
    for k in @as(usize, 0)..2 {
        abbrev(b, AB_RECORD + @as(u64, k), tags[k], true, rec[..]);
        abbrev(b, AB_RECORD + 2 + @as(u64, k), tags[k], true, rec[1..4]);
        abbrev(b, AB_RECORD + 4 + @as(u64, k), tags[k], false, decl[..]);
        abbrev(b, AB_RECORD + 6 + @as(u64, k), tags[k], false, decl[1..2]);
    }
    let mem: [3][2]u64 = [[AT_NAME, FORM_STRP], [AT_TYPE, FORM_REF4], [AT_DATA_MEMBER_LOCATION, FORM_UDATA]];
    abbrev(b, AB_MEMBER, TAG_MEMBER, false, mem[..]);
    abbrev(b, AB_MEMBER_ANON, TAG_MEMBER, false, mem[1..3]);
    let bf: [4][2]u64 = [
        [AT_NAME, FORM_STRP], [AT_TYPE, FORM_REF4], [AT_BIT_SIZE, FORM_UDATA], [AT_DATA_BIT_OFFSET, FORM_UDATA]];
    abbrev(b, AB_BITFIELD, TAG_MEMBER, false, bf[..]);
    let en: [3][2]u64 = [[AT_NAME, FORM_STRP], [AT_TYPE, FORM_REF4], [AT_BYTE_SIZE, FORM_UDATA]];
    abbrev(b, AB_ENUM, TAG_ENUMERATION_TYPE, true, en[..]);
    abbrev(b, AB_ENUM_ANON, TAG_ENUMERATION_TYPE, true, en[1..3]);
    let er: [2][2]u64 = [[AT_NAME, FORM_STRP], [AT_CONST_VALUE, FORM_SDATA]];
    abbrev(b, AB_ENUMERATOR, TAG_ENUMERATOR, false, er[..]);
    let ew: [2]u64 = [FORM_UDATA, FORM_BLOCK1];
    for k in @as(usize, 0)..2 {
        let erw: [2][2]u64 = [[AT_NAME, FORM_STRP], [AT_CONST_VALUE, ew[k]]];
        abbrev(b, AB_ENUMERATOR_WIDE + @as(u64, k), TAG_ENUMERATOR, false, erw[..]);
    }
    let ft: [2][2]u64 = [[AT_PROTOTYPED, FORM_FLAG], [AT_TYPE, FORM_REF4]];
    abbrev(b, AB_FTYPE, TAG_SUBROUTINE_TYPE, true, ft[..]);
    abbrev(b, AB_FTYPE_VOID, TAG_SUBROUTINE_TYPE, true, ft[0..1]);
    abbrev(b, AB_FPARAM, TAG_FORMAL_PARAMETER, false, ty[..]);
    abbrev(b, AB_UNSPEC, TAG_UNSPECIFIED_PARAMETERS, false, ty[0..0]);
    let lv: [5][2]u64 = [[AT_NAME, FORM_STRP], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA],
                         [AT_TYPE, FORM_REF4], [AT_LOCATION, FORM_EXPRLOC]];
    abbrev(b, AB_LVAR, TAG_VARIABLE, false, lv[..]);
    abbrev(b, AB_LVAR + 1, TAG_FORMAL_PARAMETER, false, lv[..]);
    abbrev(b, AB_LVAR + 2, TAG_VARIABLE, false, lv[0..4]);
    abbrev(b, AB_LVAR + 3, TAG_FORMAL_PARAMETER, false, lv[0..4]);
    let gv: [6][2]u64 = [[AT_NAME, FORM_STRP], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA],
                         [AT_TYPE, FORM_REF4], [AT_LOCATION, FORM_EXPRLOC], [AT_EXTERNAL, FORM_FLAG_PRESENT]];
    abbrev(b, AB_GVAR, TAG_VARIABLE, false, gv[..]);
    abbrev(b, AB_GVAR + 1, TAG_VARIABLE, false, gv[0..5]);
    let lex: [2][2]u64 = [[AT_LOW_PC, FORM_ADDR], [AT_HIGH_PC, FORM_DATA4]];
    abbrev(b, AB_LEX, TAG_LEXICAL_BLOCK, true, lex[..]);
    let lexr: [1][2]u64 = [[AT_RANGES, FORM_SEC_OFFSET]];
    abbrev(b, AB_LEX_RANGES, TAG_LEXICAL_BLOCK, true, lexr[..]);
    let td: [4][2]u64 = [
        [AT_NAME, FORM_STRP], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA], [AT_TYPE, FORM_REF4]];
    abbrev(b, AB_TYPEDEF, TAG_TYPEDEF, false, td[..]);
    abbrev(b, AB_TYPEDEF_VOID, TAG_TYPEDEF, false, td[0..3]);
    let cref: [1][2]u64 = [[AT_COUNT, FORM_REF4]];
    abbrev(b, AB_SUBRANGE_V, TAG_SUBRANGE_TYPE, false, cref[..]);
    let art: [3][2]u64 = [[AT_TYPE, FORM_REF4], [AT_LOCATION, FORM_EXPRLOC], [AT_ARTIFICIAL, FORM_FLAG_PRESENT]];
    abbrev(b, AB_ART, TAG_VARIABLE, false, art[..]);
    let artl: [3][2]u64 = [[AT_TYPE, FORM_REF4], [AT_LOCATION, FORM_SEC_OFFSET], [AT_ARTIFICIAL, FORM_FLAG_PRESENT]];
    abbrev(b, AB_ART_LIST, TAG_VARIABLE, false, artl[..]);
    let ot: [2][2]u64 = [[AT_NAME, FORM_STRP], [AT_BYTE_SIZE, FORM_UDATA]];
    abbrev(b, AB_OTHER_TYPE, TAG_UNSPECIFIED_TYPE, false, ot[..]);
    let bb: [4][2]u64 = [
        [AT_NAME, FORM_STRP], [AT_BYTE_SIZE, FORM_UDATA], [AT_ENCODING, FORM_DATA1], [AT_BIT_SIZE, FORM_UDATA]];
    abbrev(b, AB_BASE_BITS, TAG_BASE_TYPE, false, bb[..]);
    let ll: [5][2]u64 = [[AT_NAME, FORM_STRP], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA],
                         [AT_TYPE, FORM_REF4], [AT_LOCATION, FORM_SEC_OFFSET]];
    abbrev(b, AB_LVAR_LIST, TAG_VARIABLE, false, ll[..]);
    abbrev(b, AB_LVAR_LIST + 1, TAG_FORMAL_PARAMETER, false, ll[..]);
    let cv: [5][2]u64 = [[AT_NAME, FORM_STRP], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA],
                         [AT_TYPE, FORM_REF4], [AT_CONST_VALUE, FORM_BLOCK1]];
    abbrev(b, AB_LVAR_CONST, TAG_VARIABLE, false, cv[..]);
    abbrev(b, AB_LVAR_CONST + 1, TAG_FORMAL_PARAMETER, false, cv[..]);
    let ab: [4][2]u64 = [
        [AT_NAME, FORM_STRP], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA], [AT_INLINE, FORM_DATA1]];
    abbrev(b, AB_ABS, TAG_SUBPROGRAM, false, ab[..]);
    abbrev(b, AB_ABS_KIDS, TAG_SUBPROGRAM, true, ab[..]);
    let abt: [6][2]u64 = [[AT_NAME, FORM_STRP], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA],
                          [AT_PROTOTYPED, FORM_FLAG_PRESENT], [AT_TYPE, FORM_REF4], [AT_INLINE, FORM_DATA1]];
    abbrev(b, AB_ABS + 2, TAG_SUBPROGRAM, false, abt[..]);
    abbrev(b, AB_ABS_KIDS + 2, TAG_SUBPROGRAM, true, abt[..]);
    let av: [4][2]u64 = [
        [AT_NAME, FORM_STRP], [AT_DECL_FILE, FORM_UDATA], [AT_DECL_LINE, FORM_UDATA], [AT_TYPE, FORM_REF4]];
    abbrev(b, AB_AVAR, TAG_VARIABLE, false, av[..]);
    abbrev(b, AB_AVAR + 1, TAG_FORMAL_PARAMETER, false, av[..]);
    let inl: [5][2]u64 = [[AT_ABSTRACT_ORIGIN, FORM_REF4], [AT_LOW_PC, FORM_ADDR], [AT_HIGH_PC, FORM_DATA4],
                          [AT_CALL_FILE, FORM_UDATA], [AT_CALL_LINE, FORM_UDATA]];
    abbrev(b, AB_INL, TAG_INLINED_SUBROUTINE, true, inl[..]);
    let inlr: [4][2]u64 = [[AT_ABSTRACT_ORIGIN, FORM_REF4], [AT_RANGES, FORM_SEC_OFFSET], [AT_CALL_FILE, FORM_UDATA],
                           [AT_CALL_LINE, FORM_UDATA]];
    abbrev(b, AB_INL_RANGES, TAG_INLINED_SUBROUTINE, true, inlr[..]);
    let iv: [1][2]u64 = [[AT_ABSTRACT_ORIGIN, FORM_REF4]];
    abbrev(b, AB_IVAR, TAG_VARIABLE, false, iv[..]);
    abbrev(b, AB_IVAR + 1, TAG_FORMAL_PARAMETER, false, iv[..]);
    let ivl: [2][2]u64 = [[AT_ABSTRACT_ORIGIN, FORM_REF4], [AT_LOCATION, FORM_SEC_OFFSET]];
    abbrev(b, AB_IVAR_LIST, TAG_VARIABLE, false, ivl[..]);
    abbrev(b, AB_IVAR_LIST + 1, TAG_FORMAL_PARAMETER, false, ivl[..]);
    let vp: [1][2]u64 = [[AT_DISCR, FORM_REF4]];
    abbrev(b, AB_VPART, TAG_VARIANT_PART, true, vp[..]);
    let vv: [1][2]u64 = [[AT_DISCR_VALUE, FORM_SDATA]];
    abbrev(b, AB_VARIANT, TAG_VARIANT, true, vv[..]);
    abbrev(b, AB_VARIANT_EMPTY, TAG_VARIANT, false, vv[..]);
}

/// The locations of function f's variables (dbginfo.vars_of), as offsets
/// from the CFA: its object's frame slot's (slot_off: from the register the
/// frame is addressed from, which is `base` below the CFA), or NO_LOC. At
/// -O0 (dbginfo.locations), where each variable stays in its slot
/// (ir.F_VAR), for an object still in the function; in optimized code, for
/// an object left in memory (its address taken, an aggregate not taken
/// apart) whose every store remains and which shares its memory with no
/// other (in_memory).
pub fn var_locs(f: *ir.Func, slot_off: fn(*ir.Value) i64, base: i64) []i64 {
    let vs = dbi.vars_of(f.name);
    if vs.len == 0 {
        return u.nil_slice.[i64]();
    }
    let out = u.newn.[i64](vs.len + 1);
    for k in 0..vs.len {
        out[k] = NO_LOC;
        let a = vs[k].alloca;
        if u.isnil(a) or (a.op != ir.OP_ALLOCA) or (a.grave != 0) or u.isnil(a.blk) or
           (@int_from_ptr(a.blk.fnp) != @int_from_ptr(f)) or (a.id != vs[k].alloca_id) {
            continue;
        }
        if not dbi.locations and not in_memory(&vs[k]) {
            continue;
        }
        let o = slot_off(a);
        if o != NO_LOC {
            out[k] = o - base;
        }
    }
    return out[0..vs.len];
}

// Optimized code: does variable v's object hold its value wherever it is
// in scope? Its stores (dbginfo: those at the first promotion, when it was
// left in memory) are all still there, and no other object's uses were
// given to it (sharing a slot: ir.dbg_was_merged).
fn in_memory(v: *dbi.DVar) bool {
    if not ir.dbg_on or not v.seen or (v.track >= 0) or v.artificial or v.indirect {
        return false;
    }
    if ir.dbg_was_merged(v.alloca, v.alloca_id) {
        return false;
    }
    for k in v.stores..(v.stores + v.nstores) {
        if not ir.dbg_present(k) {
            return false;
        }
    }
    return true;
}

/// Datum `name` of the object is symbol `sym` (DEBUG_FULL: the locations of
/// static variables).
pub fn add_data_sym(d: *mut Unit, name: []u8, sym: u32) void {
    if d.on and d.full {
        d.gsyms.put(u.intern(name), sym + 1);
    }
}

fn pk(c: bool, a: u64, b: u64) u64 {
    if c {
        return a;
    }
    return b;
}

fn ib(d: *mut Unit) *mut bn.Bytes {
    return &mut d.parts[D_INFO].b;
}

fn strp(d: *mut Unit, s: []u8) void {
    let so = str_off(d, s);
    sec_ref(d, &mut d.parts[D_INFO], D_STR, @as(u64, so));
}

// A reference to type t (a dbginfo index), which finish resolves.
fn tref(d: *mut Unit, t: i32) void {
    d.trefs.push(Fix.{ off: @as(u64, ib(d).len()), kind: FX_SEC, sym: @bit_cast(u32, t), addend: 0 });
    ib(d).u32_(0);
}

fn decl_at(d: *mut Unit, src: u32) void {
    let w = where_of(d, src);
    ib(d).uleb(@as(u64, w.file));
    ib(d).uleb(@as(u64, w.line));
}

// Variable k of function f, v: at its frame offset f.vars[k] (from the CFA:
// DW_OP_fbreg, the frame base being the CFA; through the address there,
// for one held by reference), or without a location (optimized out); a
// block-scope static at its address.
fn var_die(d: *mut Unit, f: *Func, k: usize, v: dbi.DVar, clip: []Piece) void {
    if v.ty < 0 {
        return;
    }
    if u.notnil(v.global) {
        let sym = d.gsyms.get(u.intern(v.global.name));
        if (sym == 0) or (v.global.tls and (d.tls_rel == 0)) {
            return;  // (written at the top level: types_and_data)
        }
        named(d, v.name, TAG_VARIABLE, @as(u64, ib(d).len()));
        ib(d).uleb(AB_GVAR + 1);
        strp(d, v.name);
        decl_at(d, v.src);
        tref(d, v.ty);
        global_loc(d, v.global, sym - 1);
        if v.gidx >= 0 {
            let g = @int_cast(usize, v.gidx);
            while d.gdone.len <= g {
                d.gdone.push(false);
            }
            d.gdone.set(g, true);
        }
        return;
    }
    let mut loc = NO_LOC;
    if k < f.vars.len {
        loc = f.vars[k];
    }
    if v.artificial {
        if loc == NO_LOC {
            // (optimized code: its location list, if it has one)
            let at = @as(u64, ib(d).len()) + 1;
            if (f.vlocs.len > 0) and optimized_var(d, f, k, v, 0, clip, true, 0, "") {
                d.voffs.set(k, at);
            }
            return;
        }
        d.voffs.set(k, @as(u64, ib(d).len()) + 1);
        ib(d).uleb(AB_ART);
        tref(d, v.ty);
        fbreg_expr(d, loc, false);
        return;
    }
    let pv = pk(v.param, @as(u64, 1), @as(u64, 0));
    if (loc == NO_LOC) and (f.vlocs.len > 0) and optimized_var(d, f, k, v, pv, clip, false, 0, "") {
        return;
    }
    let mut code = AB_LVAR + pv;
    if loc == NO_LOC {
        code += 2;
    }
    ib(d).uleb(code);
    strp(d, v.name);
    decl_at(d, v.src);
    tref(d, v.ty);
    if loc != NO_LOC {
        fbreg_expr(d, loc, v.indirect);
    }
}

// The location of datum g (symbol sym): its address; a thread-local's,
// its offset in the TLS block, which DW_OP_form_tls_address makes the
// current thread's address (ELF's local-exec TLS: the offset in the
// executable's PT_TLS template, which the system's thread library gives
// debuggers the thread's block of).
fn global_loc(d: *mut Unit, g: *ir.Global, sym: u32) void {
    if g.tls {
        ib(d).uleb(10);
        ib(d).u8_(OP_CONST8U);
        let p = &mut d.parts[D_INFO];
        p.fx.push(Fix.{ off: @as(u64, p.b.len()), kind: FX_TLS, sym: sym, addend: 0 });
        p.b.u64_(0);
        ib(d).u8_(OP_FORM_TLS_ADDRESS);
        return;
    }
    ib(d).uleb(1 + d.addr_size);
    ib(d).u8_(OP_ADDR);
    addr_ref(d, &mut d.parts[D_INFO], sym, 0);
}

// Variable k of function f, v, in optimized code: its location list
// (dloc.ax) within its block's code `clip` (empty: the function's), if it
// has one (true: written). A variable taken apart (pieces) is in pieces at
// each address (DW_OP_piece; one not known there: a piece without a
// location).
fn optimized_var(d: *mut Unit, f: *Func, k: usize, v: dbi.DVar, pv: u64, clip: []Piece, art: bool, inst: u32,
                 g: []u8) bool {
    let mut segs = var_segments(d, f, k, type_size(v.ty), inst);
    let mut n: usize = 0;
    for sg in segs.items() {
        let x = dloc.VLoc.{ var: 0, poff: 0, psize: 0, kind: 0, start: sg.start, end: sg.end, reg: 0, off: 0, add: 0,
                            size: 0, ind: false, gsym: "", inst: 0, expr: "" };
        if clipped(x, clip, 0).end > 0 {
            n += 1;
        }
    }
    if n == 0 {
        free_segments(&mut segs);
        return false;
    }
    if inst != 0 {
        ib(d).uleb(AB_IVAR_LIST + pv);  // (of an inline instance)
        abs_ref(d, g, k + 1);
    } else if art {
        ib(d).uleb(AB_ART_LIST);
        tref(d, v.ty);
    } else {
        ib(d).uleb(AB_LVAR_LIST + pv);
        strp(d, v.name);
        decl_at(d, v.src);
        tref(d, v.ty);
    }
    sec_ref(d, &mut d.parts[D_INFO], D_LOCLISTS, @as(u64, list_start(d, D_LOCLISTS)));
    for sg in segs.items() {
        let x = dloc.VLoc.{ var: 0, poff: 0, psize: 0, kind: 0, start: sg.start, end: sg.end, reg: 0, off: 0, add: 0,
                            size: 0, ind: false, gsym: "", inst: 0, expr: "" };
        let mut ci: usize = 0;
        loop {
            let c = clipped(x, clip, ci);
            if c.end == 0 {
                break;
            }
            ci = @truncate(usize, c.next);
            loc_entry(d, f, &sg, c.start, c.end);
        }
    }
    d.parts[D_LOCLISTS].b.u8_(LLE_END_OF_LIST);
    free_segments(&mut segs);
    return true;
}

// A stretch of code where a variable's location is `expr`.
struct Seg {
    start: u64,
    end: u64,
    expr: bn.Bytes,
    fx: u.List.[SFix],
}

fn free_segments(l: *mut u.List.[Seg]) void {
    for k in 0..l.len {
        l.at(k).expr.free();
        l.at(k).fx.deinit();
    }
    l.deinit();
}

fn same_fixes(a: *u.List.[SFix], b: *u.List.[SFix]) bool {
    if a.len != b.len {
        return false;
    }
    for k in 0..a.len {
        let x = a.get(k);
        let y = b.get(k);
        if (x.off != y.off) or (x.sym != y.sym) or (x.add != y.add) {
            return false;
        }
    }
    return true;
}

// A datum's address in an expression of a stretch: at `off` in it (or,
// sym SFIX_TYPE + a dloc.TY_*, a typed operation's base type there).
struct SFix {
    off: u64,
    sym: u32,
    add: i64,
}

const SFIX_TYPE: u32 = 0xffff_ff00;
// DWARF expression operations (DWARF 5, 7.7.1) of dloc's expressions
const OP_REGVAL_TYPE: u8 = 0xa5;
const OP_DEREF_TYPE: u8 = 0xa6;
const OP_CONST_TYPE: u8 = 0xa4;
const OP_CONVERT: u8 = 0xa8;
const OP_REINTERPRET: u8 = 0xa9;
const OP_CONSTU: u8 = 0x10;
const OP_CONST1U: u8 = 0x08;
const OP_ENTRY_VALUE: u8 = 0xa3;

// An operation without operands that dloc's expressions use: the
// arithmetic, logical and stack operations.
fn dloc_plain_op(o: u8) bool {
    return (o == 0x14) or (o == 0x16) or (o == 0x17) or (o == 0x1a) or (o == 0x1b) or (o == 0x1c) or (o == 0x1e) or
           (o == 0x1f) or (o == 0x21) or (o == 0x22) or (o == 0x24) or (o == 0x25) or (o == 0x26) or (o == 0x27);
}

// The expression of location x (one piece of it: no DW_OP_piece), with
// the data addresses in it (fx); false if it has none after all.
fn loc_expr(d: *mut Unit, e: *mut bn.Bytes, fx: *mut u.List.[SFix], x: *dloc.VLoc) bool {
    let kind = x.kind;
    if kind == dloc.LK_GADDR {
        let sym = d.gsyms.get(u.intern(x.gsym));
        if sym == 0 {
            return false;
        }
        e.u8_(OP_ADDR);
        fx.push(SFix.{ off: @as(u64, e.len()), sym: sym - 1, add: x.off });
        for _j in 0..d.addr_size {
            e.u8_(0);
        }
        if not x.ind {
            e.u8_(OP_STACK_VALUE);
        }
        return true;
    }
    if kind == dloc.LK_CONST {
        e.u8_(OP_IMPLICIT_VALUE);
        e.uleb(@as(u64, x.size));
        let bits = @bit_cast(u64, x.off);
        for j in 0..@as(usize, x.size) {
            e.u8_(@truncate(u8, bits >> @as(u32, @truncate(u32, 8 * j))));
        }
        return true;
    }
    if kind == dloc.LK_ADDR {
        e.u8_(OP_FBREG);
        e.sleb(x.off);
        if not x.ind {
            e.u8_(OP_STACK_VALUE);
        }
        return true;
    }
    if kind == dloc.LK_SLOT {
        e.u8_(OP_FBREG);
        e.sleb(x.off);
        if (x.add != 0) or x.ind {
            // (the value there, plus add: a value, or the variable's address)
            if x.size >= 8 {
                e.u8_(OP_DEREF);
            } else {
                e.u8_(OP_DEREF_SIZE);
                e.u8_(@truncate(u8, x.size));
            }
            if x.add != 0 {
                e.u8_(OP_CONSTS);
                e.sleb(x.add);
                e.u8_(OP_PLUS);
            }
            if not x.ind {
                e.u8_(OP_STACK_VALUE);
            }
        }
        return true;
    }
    if kind == dloc.LK_WLOCAL {
        // (WebAssembly's DWARF: the variable is the function's local reg)
        e.u8_(OP_WASM_LOCATION);
        e.u8_(0);
        e.uleb(@as(u64, @bit_cast(u32, x.reg)));
        return true;
    }
    if kind == dloc.LK_TEXPR {
        // (computed with typed operations: the base types' operands, which
        // loc_entry and finish make their entries' offsets)
        let at = @as(u64, e.len());
        let mut rd = bn.reader(x.expr);
        while not rd.at_end() {
            let o = rd.u8_();
            let mut ty: usize = 0;    // (the operand's offset in the expression + 1)
            let mut tend: usize = 0;  // (and its end)
            if (o == OP_REGVAL_TYPE) or (o == OP_DEREF_TYPE) {
                if o == OP_REGVAL_TYPE {
                    _ = rd.uleb();
                } else {
                    _ = rd.u8_();
                }
                ty = rd.pos + 1;
                _ = rd.uleb();
                tend = rd.pos;
            } else if o == OP_CONST_TYPE {
                ty = rd.pos + 1;
                _ = rd.uleb();
                tend = rd.pos;
                let n = @as(usize, rd.u8_());
                rd.pos += n;
            } else if (o == OP_CONVERT) or (o == OP_REINTERPRET) {
                ty = rd.pos + 1;
                _ = rd.uleb();
                tend = rd.pos;
            } else if (o == OP_CONSTU) or (o == OP_BREGX) {
                _ = rd.uleb();
                if o == OP_BREGX {
                    _ = rd.sleb();
                }
            } else if (o == OP_CONSTS) or (o == OP_FBREG) or ((o >= OP_BREG0) and (o < OP_BREG0 + 32)) {
                _ = rd.sleb();
            } else if (o == OP_CONST1U) or (o == OP_DEREF_SIZE) {
                _ = rd.u8_();
            } else if o == OP_ENTRY_VALUE {
                let n = rd.uleb();
                rd.pos += @truncate(usize, n);
            } else if not dloc_plain_op(o) {
                return false;  // (an operation not of dloc's)
            }
            if rd.bad or (rd.pos > x.expr.len) {
                return false;
            }
            if (ty > 0) and (tend == ty - 1 + dloc.TY_PAD) and (x.expr[ty - 1] != 0) {
                fx.push(SFix.{ off: at + @as(u64, ty - 1), sym: SFIX_TYPE + @as(u32, x.expr[ty - 1] & 0x7f), add: 0 });
            } else if (ty > 0) and (x.expr[ty - 1] != 0) {
                return false;  // (a base type operand dloc did not make)
            }
        }
        for b in x.expr {
            e.u8_(b);
        }
        e.u8_(OP_STACK_VALUE);
        return true;
    }
    if kind == dloc.LK_EXPR {
        // (computed from other values, plus add: dloc.expr_of)
        for b in x.expr {
            e.u8_(b);
        }
        if x.add != 0 {
            e.u8_(OP_CONSTS);
            e.sleb(x.add);
            e.u8_(OP_PLUS);
        }
        if not x.ind {
            e.u8_(OP_STACK_VALUE);
        }
        return true;
    }
    let r = @as(u64, @bit_cast(u32, x.reg));
    if (x.add != 0) or x.ind {
        // (the register's contents plus add: a value, or the variable's address)
        if r < 32 {
            e.u8_(OP_BREG0 + @truncate(u8, r));
        } else {
            e.u8_(OP_BREGX);
            e.uleb(r);
        }
        e.sleb(x.add);
        if not x.ind {
            e.u8_(OP_STACK_VALUE);
        }
        return true;
    }
    if r < 32 {
        e.u8_(OP_REG0 + @truncate(u8, r));
    } else {
        e.u8_(OP_REGX);
        e.uleb(r);
    }
    return true;
}

/// The function's debug information is written: var_pieces's index of its
/// location pieces goes.
pub fn var_pieces_done() void {
    VL_FOR = 0;
}

// The location pieces of the function add_func writes, by variable: its
// instance << 32 | its index -> its first piece's index in f.vlocs + 1, and
// each piece's next one's (+ 1, 0: none), in order; of the vlocs at VL_FOR.
let mut VL_FOR: usize = 0;
let mut VL_LEN: usize = 0;
let mut VL_BY: u.U64Map = u.U64Map.{ keys: @ptr_from_int(*mut u64, 0), vals: @ptr_from_int(*mut u64, 0), cap: 0,
                                     len: 0 };
let mut VL_NEXT: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };

/// The location pieces of variable k of instance inst of the function
/// whose debug information is written (add_func), in order.
pub fn var_pieces(f: *Func, k: usize, inst: u32) u.List.[dloc.VLoc] {
    if (VL_FOR != @int_from_ptr(f.vlocs.ptr)) or (VL_LEN != f.vlocs.len) {
        VL_BY.deinit();
        VL_NEXT.clear();
        for _j in 0..f.vlocs.len {
            VL_NEXT.push(0);
        }
        let mut j = f.vlocs.len;
        while j > 0 {
            j -= 1;
            let x = f.vlocs[j];
            let key = (@as(u64, x.inst) << 32) | @as(u64, x.var);
            VL_NEXT.set(j, @truncate(u32, VL_BY.get(key)));
            VL_BY.put(key, @as(u64, j) + 1);
        }
        VL_FOR = @int_from_ptr(f.vlocs.ptr);
        VL_LEN = f.vlocs.len;
    }
    let mut xs = u.List.[dloc.VLoc].empty();
    if (k >> 32) != 0 {
        return xs;
    }
    let mut j = VL_BY.get((@as(u64, inst) << 32) | @as(u64, k));
    while j != 0 {
        xs.push(f.vlocs[@truncate(usize, j - 1)]);
        j = @as(u64, VL_NEXT.get(@truncate(usize, j - 1)));
    }
    return xs;
}

// The stretches of variable k's locations (in f.vlocs), in order: one
// whole value's, or the pieces' (of a variable of `size` bytes) put
// together at each address where at least one of them has one.
fn var_segments(d: *mut Unit, f: *Func, k: usize, size: u64, inst: u32) u.List.[Seg] {
    let mut out = u.List.[Seg].empty();
    let mut xs = var_pieces(f, k, inst);
    let mut whole = false;
    for x in xs.items() {
        whole = whole or (x.psize == 0);
    }
    if whole {
        // (a value of all of it: its pieces, if any, are left aside)
        let mut n: usize = 0;
        for j in 0..xs.len {
            if xs.get(j).psize == 0 {
                xs.set(n, xs.get(j));
                n += 1;
            }
        }
        xs.len = n;
    }
    if xs.len == 0 {
        xs.deinit();
        return out;
    }
    // the addresses where something changes
    let mut cut = u.List.[usize].empty();
    for x in xs.items() {
        cut.push(@truncate(usize, x.start));
        cut.push(@truncate(usize, x.end));
    }
    u.sort_usize(cut.items());
    // the pieces' places, in order
    let mut pcs = u.List.[[2]u32].empty();
    if not whole {
        for x in xs.items() {
            let mut have = false;
            for p in pcs.items() {
                have = have or ((p[0] == x.poff) and (p[1] == x.psize));
            }
            if not have {
                pcs.push([x.poff, x.psize]);
            }
        }
        for a in 1..pcs.len {
            let mut j = a;
            while (j > 0) and (pcs.get(j - 1)[0] > pcs.get(j)[0]) {
                let y = pcs.get(j);
                pcs.set(j, pcs.get(j - 1));
                pcs.set(j - 1, y);
                j -= 1;
            }
        }
        // (overlapping pieces: none put together)
        for a in 1..pcs.len {
            if pcs.get(a - 1)[0] + pcs.get(a - 1)[1] > pcs.get(a)[0] {
                xs.deinit();
                cut.deinit();
                pcs.deinit();
                return out;
            }
        }
    }
    // each piece's place's locations (of xs, in order; one group if whole),
    // and where the stretches have got to in each (the locations of one
    // place are one after the other: a stretch is in one of them at most,
    // the one it has got to)
    let mut grp = u.List.[usize].empty();
    let mut gat = u.List.[usize].empty();
    let ng = @max(pcs.len, 1);
    for g in 0..ng {
        gat.push(grp.len);
        for j in 0..xs.len {
            let x = xs.get(j);
            if whole or ((x.poff == pcs.get(g)[0]) and (x.psize == pcs.get(g)[1])) {
                grp.push(j);
            }
        }
    }
    gat.push(grp.len);
    let mut ordered = true;
    for g in 0..ng {
        for j in (gat.get(g) + 1)..gat.get(g + 1) {
            ordered = ordered and (xs.get(grp.get(j)).start >= xs.get(grp.get(j - 1)).end);
        }
    }
    let gcur = u.newn.[usize](ng + 1);
    for g in 0..ng {
        gcur[g] = gat.get(g);
    }
    for c in 0..cut.len {
        if c + 1 >= cut.len {
            break;
        }
        let lo = @as(u64, cut.get(c));
        let hi = @as(u64, cut.get(c + 1));
        if hi <= lo {
            continue;
        }
        // (the location of each group for it: an index in xs, -1: none)
        let mut some = false;
        if ordered {
            for g in 0..ng {
                while (gcur[g] < gat.get(g + 1)) and (xs.get(grp.get(gcur[g])).end <= lo) {
                    gcur[g] += 1;
                }
                if gcur[g] < gat.get(g + 1) {
                    let x = xs.get(grp.get(gcur[g]));
                    some = some or ((x.start <= lo) and (x.end >= hi));
                }
            }
            if not some {
                continue;  // (none: no stretch)
            }
        }
        let mut e = bn.new_bytes();
        let mut fx = u.List.[SFix].empty();
        let mut any = false;
        if whole and ordered {
            let x = xs.get(grp.get(gcur[0]));
            any = loc_expr(d, &mut e, &mut fx, &x);
        } else if whole {
            for x in xs.items() {
                if (x.start <= lo) and (x.end >= hi) {
                    any = loc_expr(d, &mut e, &mut fx, &x);
                    break;
                }
            }
        } else {
            let mut at: u64 = 0;
            for g in 0..pcs.len {
                let p = pcs.get(g);
                if @as(u64, p[0]) > at {
                    e.u8_(OP_PIECE);
                    e.uleb(@as(u64, p[0]) - at);
                }
                let mut hit: i64 = -1;
                if ordered {
                    if gcur[g] < gat.get(g + 1) {
                        let x = xs.get(grp.get(gcur[g]));
                        if (x.start <= lo) and (x.end >= hi) {
                            hit = @int_cast(i64, grp.get(gcur[g]));
                        }
                    }
                } else {
                    for j in 0..xs.len {
                        let x = xs.get(j);
                        if (x.poff == p[0]) and (x.psize == p[1]) and (x.start <= lo) and (x.end >= hi) {
                            hit = @int_cast(i64, j);
                            break;
                        }
                    }
                }
                if hit >= 0 {
                    let x = xs.get(@int_cast(usize, hit));
                    let at0 = e.len();
                    if loc_expr(d, &mut e, &mut fx, &x) {
                        any = true;
                    } else {
                        e.b.len = at0;
                    }
                }
                e.u8_(OP_PIECE);
                e.uleb(@as(u64, p[1]));
                at = @as(u64, p[0]) + @as(u64, p[1]);
            }
            if (size > at) and any {
                e.u8_(OP_PIECE);
                e.uleb(size - at);
            }
        }
        if not any {
            e.free();
            fx.deinit();
            continue;
        }
        // (the same as the stretch before it: one)
        if (out.len > 0) and (out.last().end == lo) and u.str_eq(out.last().expr.view(), e.view()) and
           same_fixes(&out.at(out.len - 1).fx, &fx) {
            out.at(out.len - 1).end = hi;
            e.free();
            fx.deinit();
            continue;
        }
        out.push(Seg.{ start: lo, end: hi, expr: e, fx: fx });
    }
    xs.deinit();
    cut.deinit();
    pcs.deinit();
    grp.deinit();
    gat.deinit();
    return out;
}

// A piece of location x, clipped to the block's code (clip, from its piece
// `from` on): start, end (0: no more), and the clip piece to go on from.
struct Clip {
    start: u64,
    end: u64,
    next: u64,
}

fn clipped(x: dloc.VLoc, clip: []Piece, from: usize) Clip {
    if clip.len == 0 {
        if from > 0 {
            return Clip.{ start: 0, end: 0, next: 0 };
        }
        return Clip.{ start: x.start, end: x.end, next: 1 };
    }
    for j in from..clip.len {
        let a = @max(x.start, clip[j].start);
        let b = @min(x.end, clip[j].end);
        if b > a {
            return Clip.{ start: a, end: b, next: @as(u64, j + 1) };
        }
    }
    return Clip.{ start: 0, end: 0, next: 0 };
}

// A location list entry: stretch sg's expression from offset start to end
// of f.
fn loc_entry(d: *mut Unit, f: *Func, sg: *Seg, start: u64, end: u64) void {
    let p = &mut d.parts[D_LOCLISTS];
    p.b.u8_(LLE_START_LENGTH);
    addr_ref(d, p, f.sym, start);
    p.b.uleb(end - start);
    let ex = sg.expr.view();
    p.b.uleb(@as(u64, ex.len));
    let at = @as(u64, p.b.len());
    p.b.put(ex);
    for x in sg.fx.items() {
        if x.sym >= SFIX_TYPE {
            d.lrefs.push(Fix.{ off: at + x.off, kind: FX_SEC, sym: x.sym - SFIX_TYPE, addend: 0 });
            continue;
        }
        p.fx.push(Fix.{ off: at + x.off, kind: FX_ADDR, sym: x.sym, addend: x.add });
    }
}

// The size of type t's values (through typedefs and qualifiers).
fn type_size(t: i32) u64 {
    let mut k = t;
    let mut n: i32 = 0;
    while (k >= 0) and (n < 64) {
        let x = dbi.types.at(@int_cast(usize, k));
        if (x.kind != dbi.DK_TYPEDEF) and (x.kind != dbi.DK_CONST) and (x.kind != dbi.DK_VOLATILE) and
           (x.kind != dbi.DK_RESTRICT) and (x.kind != dbi.DK_ATOMIC) {
            return x.size;
        }
        k = x.target;
        n += 1;
    }
    return 0;
}

// The expression of a location `off` bytes from the frame base (deref: the
// variable is at the address held there).
fn fbreg_expr(d: *mut Unit, off: i64, deref: bool) void {
    let mut e = bn.new_bytes();
    e.u8_(OP_FBREG);
    e.sleb(off);
    if deref {
        e.u8_(OP_DEREF);
    }
    ib(d).uleb(@as(u64, e.len()));
    ib(d).put(e.view());
    e.free();
}

// Type t's entry, here, if not written yet.
fn write_type(d: *mut Unit, t: i32) void {
    let k = @int_cast(usize, t);
    while d.toff.len <= k {
        d.toff.push(0);
    }
    if d.toff.get(k) != 0 {
        return;
    }
    d.toff.set(k, @as(u64, ib(d).len()) + 1);
    let dt = dbi.types.at(k);
    if dt.name.len > 0 {
        let mut tag: u64 = 0;
        if dt.kind == dbi.DK_BASE {
            tag = TAG_BASE_TYPE;
        } else if dt.kind == dbi.DK_TYPEDEF {
            tag = TAG_TYPEDEF;
        } else if ((dt.kind == dbi.DK_STRUCT) and dt.complete) or (dt.kind == dbi.DK_TAGGED) {
            tag = TAG_STRUCTURE_TYPE;
        } else if (dt.kind == dbi.DK_UNION) and dt.complete {
            tag = TAG_UNION_TYPE;
        } else if dt.kind == dbi.DK_ENUM {
            tag = TAG_ENUMERATION_TYPE;
        }
        if tag != 0 {
            named(d, dt.name, tag, @as(u64, ib(d).len()));
        }
    }
    type_die(d, dt);
}

// A reference to the entry at offset `at` of the part (finish moves it).
fn dref(d: *mut Unit, at: u64) void {
    d.drefs.push(Fix.{ off: @as(u64, ib(d).len()), kind: FX_SEC, sym: 0, addend: @bit_cast(i64, at) });
    ib(d).u32_(0);
}

// The unit's static variables (those of the object's data) and every type,
// after the subprograms; each type's offset in the part.
fn types_and_data(d: *mut Unit) []u64 {
    if not d.full {
        return u.nil_slice.[u64]();
    }
    for gi in 0..dbi.globals.len {
        let v = dbi.globals.get(gi);
        if (v.scope != 0) and (gi < d.gdone.len) and d.gdone.get(gi) {
            continue;  // (in its lexical block)
        }
        if u.isnil(v.global) or (v.ty < 0) or (v.global.tls and (d.tls_rel == 0)) {
            // (a thread-local's address is the thread's: where the offset
            // in the TLS block is not known, it is not described)
            continue;
        }
        let sym = d.gsyms.get(u.intern(v.global.name));
        if sym == 0 {
            continue;  // (another object's)
        }
        named(d, v.name, TAG_VARIABLE, @as(u64, ib(d).len()));
        ib(d).uleb(AB_GVAR + pk(v.external, @as(u64, 0), @as(u64, 1)));
        strp(d, v.name);
        decl_at(d, v.src);
        tref(d, v.ty);
        global_loc(d, v.global, sym - 1);
    }
    let n = dbi.types.len;
    for k in 0..n {
        write_type(d, @int_cast(i32, k));
    }
    let offs = u.newn.[u64](n + 1);
    for k in 0..n {
        offs[k] = d.toff.get(k) - 1;
    }
    return offs[0..n];
}

fn type_die(d: *mut Unit, t: *dbi.DType) void {
    let k = t.kind;
    if k == dbi.DK_BASE {
        ib(d).uleb(pk(t.bits > 0, AB_BASE_BITS, AB_BASE));
        strp(d, t.name);
        ib(d).uleb(t.size);
        ib(d).u8_(t.enc);
        if t.bits > 0 {
            ib(d).uleb(@as(u64, @bit_cast(u32, t.bits)));
        }
    } else if k == dbi.DK_POINTER {
        ib(d).uleb(pk(t.target < 0, AB_PTR_VOID, AB_PTR));
        ib(d).uleb(t.size);
        if t.target >= 0 {
            tref(d, t.target);
        }
    } else if (k == dbi.DK_CONST) or (k == dbi.DK_VOLATILE) or (k == dbi.DK_RESTRICT) or (k == dbi.DK_ATOMIC) {
        let q = 2 * @as(u64, k - dbi.DK_CONST);
        if t.target < 0 {
            ib(d).uleb(AB_QUAL + q + 1);
        } else {
            ib(d).uleb(AB_QUAL + q);
            tref(d, t.target);
        }
    } else if k == dbi.DK_ARRAY {
        ib(d).uleb(AB_ARRAY);
        tref(d, t.target);
        let cv = t.count_var;
        if t.count >= 0 {
            ib(d).uleb(AB_SUBRANGE_N);
            ib(d).uleb(@bit_cast(u64, t.count));
        } else if (cv >= 0) and (@int_cast(usize, cv) < d.voffs.len) and (d.voffs.get(@int_cast(usize, cv)) != 0) {
            ib(d).uleb(AB_SUBRANGE_V);  // (a variable length array: its length's variable, in this function)
            dref(d, d.voffs.get(@int_cast(usize, cv)) - 1);
        } else {
            ib(d).uleb(AB_SUBRANGE);  // (a bound not known: incomplete, or a variable length array)
        }
        ib(d).u8_(0);
    } else if (k == dbi.DK_STRUCT) or (k == dbi.DK_UNION) {
        record_die(d, t);
    } else if k == dbi.DK_TAGGED {
        tagged_die(d, t);
    } else if k == dbi.DK_TYPEDEF {
        ib(d).uleb(pk(t.target < 0, AB_TYPEDEF_VOID, AB_TYPEDEF));
        strp(d, t.name);
        decl_at(d, t.src);
        if t.target >= 0 {
            tref(d, t.target);
        }
    } else if k == dbi.DK_ENUM {
        ib(d).uleb(pk(t.name.len > 0, AB_ENUM, AB_ENUM_ANON));
        if t.name.len > 0 {
            strp(d, t.name);
        }
        tref(d, t.target);
        ib(d).uleb(t.size);
        for m in t.members.items() {
            named(d, m.name, TAG_ENUMERATOR, @as(u64, ib(d).len()));
            enumerator(d, t.size, &m);
        }
        ib(d).u8_(0);
    } else if k != dbi.DK_FUNC {
        // (a kind this writer does not know: a type of its name and size, so
        // that what refers to it still refers to an entry)
        ib(d).uleb(AB_OTHER_TYPE);
        strp(d, t.name);
        ib(d).uleb(t.size);
    } else {
        // DK_FUNC: its parameters' types (unspecified after them: variadic, or no prototype)
        ib(d).uleb(pk(t.target < 0, AB_FTYPE_VOID, AB_FTYPE));
        ib(d).u8_(@truncate(u8, pk(t.proto, 1, 0)));
        if t.target >= 0 {
            tref(d, t.target);
        }
        for m in t.members.items() {
            ib(d).uleb(AB_FPARAM);
            tref(d, m.ty);
        }
        if t.variadic or not t.proto {
            ib(d).uleb(AB_UNSPEC);
        }
        ib(d).u8_(0);
    }
}

// A structure or union: its members at their offsets; a bit-field at its
// bit offset from the start (DW_AT_data_bit_offset: on these little-endian
// targets, the storage unit's offset in bits plus the field's place in it
// from its least significant bit).
fn record_die(d: *mut Unit, t: *dbi.DType) void {
    let mut code = AB_RECORD + pk(t.kind == dbi.DK_UNION, @as(u64, 1), @as(u64, 0));
    if t.name.len == 0 {
        code += 2;
    }
    if not t.complete {
        code += 4;
    }
    ib(d).uleb(code);
    if t.name.len > 0 {
        strp(d, t.name);
    }
    if not t.complete {
        return;
    }
    ib(d).uleb(t.size);
    decl_at(d, t.src);
    for m in t.members.items() {
        if m.bits > 0 {
            ib(d).uleb(AB_BITFIELD);
            strp(d, m.name);
            tref(d, m.ty);
            ib(d).uleb(@as(u64, @bit_cast(u32, m.bits)));
            ib(d).uleb((m.off * 8) + @as(u64, @bit_cast(u32, m.bit_off)));
            continue;
        }
        if m.ty < 0 {
            continue;  // (a field of no size)
        }
        ib(d).uleb(pk(m.name.len > 0, AB_MEMBER, AB_MEMBER_ANON));
        if m.name.len > 0 {
            strp(d, m.name);
        }
        tref(d, m.ty);
        ib(d).uleb(m.off);
    }
    ib(d).u8_(0);
}

// A tagged union (DK_TAGGED): a structure of its tag (members[0]) and a
// variant part (DWARF 5, 5.7.10) whose discriminant is the tag, a variant
// per value with its payload's member (none for one without a payload).
fn tagged_die(d: *mut Unit, t: *dbi.DType) void {
    ib(d).uleb(AB_RECORD);
    strp(d, t.name);
    ib(d).uleb(t.size);
    decl_at(d, t.src);
    let ms = t.members.items();
    let tag_at = @as(u64, ib(d).len());
    ib(d).uleb(AB_MEMBER);
    strp(d, ms[0].name);
    tref(d, ms[0].ty);
    ib(d).uleb(ms[0].off);
    ib(d).uleb(AB_VPART);
    dref(d, tag_at);
    for m in ms[1..] {
        if m.ty < 0 {
            ib(d).uleb(AB_VARIANT_EMPTY);
            ib(d).sleb(m.value);
            continue;
        }
        ib(d).uleb(AB_VARIANT);
        ib(d).sleb(m.value);
        ib(d).uleb(AB_MEMBER);
        strp(d, m.name);
        tref(d, m.ty);
        ib(d).uleb(m.off);
        ib(d).u8_(0);
    }
    ib(d).u8_(0);  // (the variant part)
    ib(d).u8_(0);
}

// -----------------------------------------------------------------------------
// .debug_names
// -----------------------------------------------------------------------------
// An entry the name index lists: `name`'s DIE of tag `tag` at offset `off`
// of the .debug_info part.
fn named(d: *mut Unit, name: []u8, tag: u64, off: u64) void {
    if name.len > 0 {
        d.names.push(Named.{ name: u.intern(name), tag: tag, off: off });
    }
}

// The hash of the name index (DWARF 5, 6.1.1.4.5: Bernstein's, from 5381,
// of the name case-folded, so that a lookup may ignore case: each code
// point's simple case folding, in UTF-8; a byte not of a valid sequence as
// it is).
pub fn djb_hash(s: []u8) u32 {
    let mut h: u32 = 5381;
    let mut i: usize = 0;
    while i < s.len {
        let c = s[i];
        if c < 0x80 {
            let mut l = c;
            if (c >= 'A') and (c <= 'Z') {
                l = c + 32;
            }
            h = (h *% 33) +% @as(u32, l);
            i += 1;
            continue;
        }
        let mut n: usize = 0;
        let mut cp: u32 = 0;
        if (c & 0xe0) == 0xc0 {
            n = 2;
            cp = @as(u32, c & 0x1f);
        } else if (c & 0xf0) == 0xe0 {
            n = 3;
            cp = @as(u32, c & 0x0f);
        } else if (c & 0xf8) == 0xf0 {
            n = 4;
            cp = @as(u32, c & 0x07);
        }
        let mut ok = (n > 0) and ((i + n) <= s.len);
        if ok {
            for k in 1..n {
                if (s[i + k] & 0xc0) != 0x80 {
                    ok = false;
                } else {
                    cp = (cp << 6) | @as(u32, s[i + k] & 0x3f);
                }
            }
        }
        if not ok {
            h = (h *% 33) +% @as(u32, c);
            i += 1;
            continue;
        }
        let f = uni.fold(cp);
        let mut enc: [4]u8 = [0; 4];
        let mut m: usize = 0;
        if f < 0x80 {
            enc[0] = @truncate(u8, f);
            m = 1;
        } else if f < 0x800 {
            enc[0] = @truncate(u8, 0xc0 | (f >> 6));
            enc[1] = @truncate(u8, 0x80 | (f & 0x3f));
            m = 2;
        } else if f < 0x10000 {
            enc[0] = @truncate(u8, 0xe0 | (f >> 12));
            enc[1] = @truncate(u8, 0x80 | ((f >> 6) & 0x3f));
            enc[2] = @truncate(u8, 0x80 | (f & 0x3f));
            m = 3;
        } else {
            enc[0] = @truncate(u8, 0xf0 | (f >> 18));
            enc[1] = @truncate(u8, 0x80 | ((f >> 12) & 0x3f));
            enc[2] = @truncate(u8, 0x80 | ((f >> 6) & 0x3f));
            enc[3] = @truncate(u8, 0x80 | (f & 0x3f));
            m = 4;
        }
        for k in 0..m {
            h = (h *% 33) +% @as(u32, enc[k]);
        }
        i += n;
    }
    return h;
}

const IDX_DIE_OFFSET: u64 = 3;

// The unit's name index (DWARF 5, 6.1.1): the header (one compilation unit,
// no type units, no augmentation), the unit, the hash table (buckets of
// names by hash, their hashes), each name's string and entries, the
// abbreviations (one per tag: a DIE offset from the unit's start, the
// unit's header being hn bytes), the entries.
fn name_index(d: *mut Unit, hn: u64) void {
    let es = d.names.items();
    if es.len == 0 {
        return;
    }
    // the names, each once, with its entries
    let mut names = u.List.[[]u8].empty();
    let mut at = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    for e in es {
        if at.get(e.name) == 0 {
            names.push(e.name);
            at.put(e.name, @truncate(u32, names.len));
        }
    }
    let n = names.len;
    let nb = @max(n / 2, 1);
    // each name's hash, once
    let hs = u.newn.[u32](n + 1);
    for j in 0..n {
        hs[j] = djb_hash(names.get(j));
    }
    // the names in bucket order (stable: a counting sort)
    let cnt = u.newn.[usize](nb + 1);
    for b in 0..(nb + 1) {
        cnt[b] = 0;
    }
    for j in 0..n {
        cnt[(@as(usize, hs[j]) % nb) + 1] += 1;
    }
    for b in 0..nb {
        cnt[b + 1] += cnt[b];
    }
    let order = u.newn.[usize](n + 1);
    for j in 0..n {
        let b = @as(usize, hs[j]) % nb;
        order[cnt[b]] = j;
        cnt[b] += 1;
    }
    // each name's entries, in order (a list through `nxt`, from first[name])
    let first = u.newn.[i32](n + 1);
    let last = u.newn.[i32](n + 1);
    let nxt = u.newn.[i32](es.len + 1);
    for j in 0..n {
        first[j] = -1;
        last[j] = -1;
    }
    for q in 0..es.len {
        let j = @as(usize, at.get(es[q].name)) - 1;
        nxt[q] = -1;
        if last[j] < 0 {
            first[j] = @int_cast(i32, q);
        } else {
            nxt[@int_cast(usize, last[j])] = @int_cast(i32, q);
        }
        last[j] = @int_cast(i32, q);
    }
    // the abbreviations: one per tag
    let mut tags = u.List.[u64].empty();
    for e in es {
        let mut have = false;
        for t in tags.items() {
            have = have or (t == e.tag);
        }
        if not have {
            tags.push(e.tag);
        }
    }
    let mut ab = bn.new_bytes();
    for ti in 0..tags.len {
        ab.uleb(@as(u64, ti) + 1);
        ab.uleb(tags.get(ti));
        ab.uleb(IDX_DIE_OFFSET);
        ab.uleb(FORM_REF4);
        ab.uleb(0);
        ab.uleb(0);
    }
    ab.uleb(0);
    // the entries, by name in the table's order
    let mut pool = bn.new_bytes();
    let eoff = u.newn.[u64](n + 1);
    for x in 0..n {
        let j = order[x];
        eoff[x] = @as(u64, pool.len());
        let mut q = first[j];
        while q >= 0 {
            let e = es[@int_cast(usize, q)];
            q = nxt[@int_cast(usize, q)];
            let mut ti: usize = 0;
            while tags.get(ti) != e.tag {
                ti += 1;
            }
            pool.uleb(@as(u64, ti) + 1);
            pool.u32_(e.off + hn);
        }
        pool.uleb(0);
    }
    let p = &mut d.parts[D_NAMES];
    p.b.u32_(0);  // (the length, below)
    p.b.u16_(5);
    p.b.u16_(0);
    p.b.u32_(1);  // compilation units
    p.b.u32_(0);  // local type units
    p.b.u32_(0);  // foreign type units
    p.b.u32_(@as(u64, nb));
    p.b.u32_(@as(u64, n));
    p.b.u32_(@as(u64, ab.len()));
    p.b.u32_(0);  // augmentation string: none
    sec_ref(d, p, D_INFO, 0);
    // the buckets: each its first name's index (from 1), 0 if empty
    let mut x: usize = 0;
    for b in 0..nb {
        if (x < n) and ((@as(usize, hs[order[x]]) % nb) == b) {
            p.b.u32_(@as(u64, x) + 1);
            while (x < n) and ((@as(usize, hs[order[x]]) % nb) == b) {
                x += 1;
            }
        } else {
            p.b.u32_(0);
        }
    }
    for j in 0..n {
        p.b.u32_(@as(u64, hs[order[j]]));
    }
    for j in 0..n {
        sec_ref(d, p, D_STR, @as(u64, str_off(d, names.get(order[j]))));
    }
    for j in 0..n {
        p.b.u32_(eoff[j]);
    }
    p.b.put(ab.view());
    p.b.put(pool.view());
    p.b.set_u32(0, @as(u64, p.b.len() - 4));
    ab.free();
    pool.free();
    names.deinit();
    tags.deinit();
    d.names.deinit();
}

// -----------------------------------------------------------------------------
// .debug_frame
// -----------------------------------------------------------------------------
// Call frame instructions (DWARF 5, 6.4.2)
const CFA_ADVANCE_LOC: u8 = 0x40;
const CFA_OFFSET: u8 = 0x80;
const CFA_NOP: u8 = 0x00;
const CFA_ADVANCE_LOC1: u8 = 0x02;
const CFA_ADVANCE_LOC2: u8 = 0x03;
const CFA_ADVANCE_LOC4: u8 = 0x04;
const CFA_OFFSET_EXTENDED: u8 = 0x05;
const CFA_SAME_VALUE: u8 = 0x08;
const CFA_DEF_CFA: u8 = 0x0c;
const CFA_DEF_CFA_REGISTER: u8 = 0x0d;
const CFA_DEF_CFA_OFFSET: u8 = 0x0e;
const DATA_ALIGN: i64 = -8;

fn code_align(d: *Unit) u64 {
    if d.arch == ARCH_A64 {
        return 4;
    }
    return 1;
}

// The CIE at the start of .debug_frame: version 4, no augmentation, the
// address size, code and data alignment, the return address register, and
// the state at a function's entry: x86-64 CFA = rsp + 8 with the return
// address at CFA - 8; AArch64 CFA = sp, the return address in x30.
fn frame_cie(d: *mut Unit) void {
    let b = &mut d.parts[D_FRAME].b;
    b.u32_(0);  // (the length, below)
    b.u32_(0xffff_ffff);
    b.u8_(4);
    b.u8_(0);
    b.u8_(@truncate(u8, d.addr_size));
    b.u8_(0);
    b.uleb(code_align(d));
    b.sleb(DATA_ALIGN);
    if d.arch == ARCH_A64 {
        b.uleb(@as(u64, A64_LR));
        b.u8_(CFA_DEF_CFA);
        b.uleb(@as(u64, A64_SP));
        b.uleb(0);
    } else {
        b.uleb(@as(u64, X64_RA));
        b.u8_(CFA_DEF_CFA);
        b.uleb(@as(u64, X64_RSP));
        b.uleb(8);
        b.u8_(CFA_OFFSET | @truncate(u8, X64_RA));
        b.uleb(1);
    }
    pad_entry(b, 0);
}

// A CIE for file-scope asm's procedures (add_asm_fde): `simple`, without
// the initial instructions (.cfi_startproc simple), and with the
// augmentation "S" for a signal frame (.cfi_signal_frame: the return
// address is that of the instruction to run, not after a call); its offset.
fn asm_cie(d: *mut Unit, simple: bool, signal: bool) u64 {
    let mut k: usize = 0;
    if simple {
        k = 1;
    }
    if signal {
        k += 2;
    }
    if k == 0 {
        return 0;
    }
    if d.cies[k] != 0 {
        return d.cies[k] - 1;
    }
    let b = &mut d.parts[D_FRAME].b;
    let at = b.len();
    b.u32_(0);
    b.u32_(0xffff_ffff);
    b.u8_(4);
    if signal {
        b.u8_('S');
    }
    b.u8_(0);
    b.u8_(@truncate(u8, d.addr_size));
    b.u8_(0);
    b.uleb(code_align(d));
    b.sleb(DATA_ALIGN);
    if d.arch == ARCH_A64 {
        b.uleb(@as(u64, A64_LR));
        if not simple {
            b.u8_(CFA_DEF_CFA);
            b.uleb(@as(u64, A64_SP));
            b.uleb(0);
        }
    } else {
        b.uleb(@as(u64, X64_RA));
        if not simple {
            b.u8_(CFA_DEF_CFA);
            b.uleb(@as(u64, X64_RSP));
            b.uleb(8);
            b.u8_(CFA_OFFSET | @truncate(u8, X64_RA));
            b.uleb(1);
        }
    }
    pad_entry(b, at);
    d.cies[k] = @as(u64, at) + 1;
    return @as(u64, at);
}

/// An FDE for a procedure of file-scope asm (asm/core.ax Proc): at symbol
/// `sym` + `add`, `size` bytes, its call frame instructions `prog` (what
/// its .cfi_* directives say), after the CIE of its kind.
pub fn add_asm_fde(d: *mut Unit, sym: u32, add: u64, size: u64, prog: []u8, simple: bool, signal: bool) void {
    if not d.on or (d.arch == ARCH_WASM) {
        return;
    }
    let cie = asm_cie(d, simple, signal);
    let p = &mut d.parts[D_FRAME];
    let at = p.b.len();
    p.b.u32_(0);
    sec_ref(d, p, D_FRAME, cie);
    addr_ref(d, p, sym, add);
    if d.addr_size == 4 {
        p.b.u32_(size);
    } else {
        p.b.u64_(size);
    }
    for c in prog {
        p.b.u8_(c);
    }
    pad_entry(&mut p.b, at);
}

// Pads the entry at `at` to a multiple of the address size with nops and
// sets its length.
fn pad_entry(b: *mut bn.Bytes, at: usize) void {
    while ((b.len() - at) % 8) != 0 {
        b.u8_(CFA_NOP);
    }
    b.set_u32(at, @as(u64, b.len() - at - 4));
}

// The function's FDE: its range, then its call frame instructions.
fn fde(d: *mut Unit, f: *Func) void {
    let p = &mut d.parts[D_FRAME];
    let at = p.b.len();
    p.b.u32_(0);
    sec_ref(d, p, D_FRAME, 0);
    addr_ref(d, p, f.sym, 0);
    if d.addr_size == 4 {
        p.b.u32_(f.size);
    } else {
        p.b.u64_(f.size);
    }
    cfa_program(&mut p.b, d.arch == ARCH_A64, f);
    pad_entry(&mut p.b, at);
}

/// The call frame instructions of function f (its cfi states, save list
/// and instructions of its own) after a CIE's initial ones (the state at
/// the entry: x86-64 CFA = rsp + 8, the return address at CFA - 8;
/// AArch64 CFA = sp): for each change of state the advance to it and what
/// changed (the CFA rule, registers saved and given back). Also the
/// programs of macOS's __eh_frame (macunwind.ax).
pub fn cfa_program(b: *mut bn.Bytes, a64: bool, f: *Func) void {
    let mut ca: u64 = 1;
    let mut cur = cfi_state(0, X64_RSP, 1, 0);
    if a64 {
        ca = 4;
        cur = cfi_state(0, A64_SP, 0, 0);
    }
    let mut loc: u64 = 0;
    let mut xi: usize = 0;
    for s in f.cfi {
        let off = s & 0xffff_ffff;
        if off >= f.size {
            break;  // (at the end: no code follows)
        }
        // (the instructions of their own before this offset, or at the one before)
        while (xi < f.xcfi.len) and (f.xcfi[xi].off < off) {
            advance(b, &mut loc, f.xcfi[xi].off, ca);
            for c in f.xcfi[xi].bytes {
                b.u8_(c);
            }
            xi += 1;
        }
        let st = s & ~@as(u64, 0xffff_ffff);
        if st == (cur & ~@as(u64, 0xffff_ffff)) {
            continue;
        }
        advance(b, &mut loc, off, ca);
        let creg = (st >> 56) & 31;
        let ck = (st >> 61) * 8;
        let oreg = (cur >> 56) & 31;
        let ok = (cur >> 61) * 8;
        if (creg != oreg) and (ck != ok) {
            b.u8_(CFA_DEF_CFA);
            b.uleb(creg);
            b.uleb(ck);
        } else if creg != oreg {
            b.u8_(CFA_DEF_CFA_REGISTER);
            b.uleb(creg);
        } else if ck != ok {
            b.u8_(CFA_DEF_CFA_OFFSET);
            b.uleb(ck);
        }
        let nm = (st >> 32) & 0xff_ffff;
        let om = (cur >> 32) & 0xff_ffff;
        for k in 0..f.regs.len {
            let bit = @as(u64, 1) << @as(u32, @truncate(u32, k));
            if ((nm ^ om) & bit) == 0 {
                continue;
            }
            let rg = f.regs[k] >> 32;
            if (nm & bit) != 0 {
                let o = @as(i64, @truncate(i32, @bit_cast(i64, f.regs[k] & 0xffff_ffff)));
                let fo = @bit_cast(u64, o / DATA_ALIGN);
                if rg < 64 {
                    b.u8_(CFA_OFFSET | @truncate(u8, rg));
                } else {
                    b.u8_(CFA_OFFSET_EXTENDED);
                    b.uleb(rg);
                }
                b.uleb(fo);
            } else {
                b.u8_(CFA_SAME_VALUE);
                b.uleb(rg);
            }
        }
        cur = s;
    }
    while (xi < f.xcfi.len) and (f.xcfi[xi].off < f.size) {
        advance(b, &mut loc, f.xcfi[xi].off, ca);
        for c in f.xcfi[xi].bytes {
            b.u8_(c);
        }
        xi += 1;
    }
}

// The advance of an FDE's program from `loc` to code offset `off`.
fn advance(b: *mut bn.Bytes, loc: *mut u64, off: u64, ca: u64) void {
    if off <= loc.* {
        return;
    }
    let delta = (off - loc.*) / ca;
    if delta < 64 {
        b.u8_(CFA_ADVANCE_LOC | @truncate(u8, delta));
    } else if delta < 256 {
        b.u8_(CFA_ADVANCE_LOC1);
        b.u8_(@truncate(u8, delta));
    } else if delta < 65536 {
        b.u8_(CFA_ADVANCE_LOC2);
        b.u16_(delta);
    } else {
        b.u8_(CFA_ADVANCE_LOC4);
        b.u32_(delta);
    }
    loc.* = off;
}

// -----------------------------------------------------------------------------
// Finishing
// -----------------------------------------------------------------------------
// DWARF language codes (DWARF 5, 7.12)
pub const LANG_C89: u32 = 0x01;
pub const LANG_C99: u32 = 0x0c;
pub const LANG_C11: u32 = 0x1d;
/// Axiom's own: a code of the range DWARF leaves to users (DW_LANG_lo_user
/// 0x8000 .. DW_LANG_hi_user 0xffff), 0x8a78 ("ax"), with --debug-language=axiom.
pub const LANG_AXIOM: u32 = 0x8a78;

/// The language of module m's unit (lang).
pub fn module_lang(m: *ir.Module) u32 {
    return lang();
}

/// The language of the program's units: C's, for a C program (its start-up
/// and runtime are Axiom's, in the same unit), of the standard it is
/// compiled to; for an Axiom program C11's too (debuggers that have no
/// expression evaluator or type system for a language code they do not know
/// show no variables of its units, and C's evaluate Axiom's names, structures,
/// slices, enumerations and arithmetic as Axiom has them; the producer says
/// Axiom), or Axiom's own code with --debug-language=axiom.
pub fn lang() u32 {
    if dbi.c_version >= 201112 {
        return LANG_C11;
    }
    if dbi.c_version >= 199901 {
        return LANG_C99;
    }
    if dbi.c_version >= 0 {
        return LANG_C89;
    }
    if tg.g_debug_vendor_lang {
        return LANG_AXIOM;
    }
    return LANG_C11;
}

// The bytes of the unit's sections and their fixups, complete: the unit
// header and DIE before the subprograms, the line program's header, the
// address ranges (text_size bytes of code from text_sym).
let mut MACROS_DONE: bool = false;

// DW_MACRO_* (DWARF 5, 6.3.2)
const MACRO_START_FILE: u8 = 0x03;
const MACRO_END_FILE: u8 = 0x04;
const MACRO_DEFINE_STRP: u8 = 0x05;
const MACRO_UNDEF_STRP: u8 = 0x06;

// The unit's macro information (.debug_macro, DWARF 5, 6.3): the C
// preprocessor's definitions and undefinitions in order (u.g_macros), each
// with its line (0: predefined or on the command line, before the unit's
// own file starts), and the files as they are included, each started at
// the line of its #include and ended; the files are the line table's
// (where_of: a file without code is in it all the same), the texts in
// .debug_str.
fn macro_unit(d: *mut Unit) void {
    let p = &mut d.parts[D_MACRO];
    p.b.u16_(5);
    p.b.u8_(2);  // (32-bit offsets; the offset of the unit's line table follows)
    sec_ref(d, &mut d.parts[D_MACRO], D_LINE, 0);
    for x in u.g_macros.items() {
        let mut line: u64 = 0;
        if (x.at >= 0) and (x.line > 0) {
            let w = where_of(d, ir.src_loc(x.at, x.line));
            line = @as(u64, w.line);
        }
        let mp = &mut d.parts[D_MACRO];
        if (x.kind == 1) or (x.kind == 2) {
            mp.b.u8_(@truncate(u8, pk(x.kind == 1, @as(u64, MACRO_DEFINE_STRP), @as(u64, MACRO_UNDEF_STRP))));
            mp.b.uleb(line);
            let so = str_off(d, x.text);
            sec_ref(d, &mut d.parts[D_MACRO], D_STR, @as(u64, so));
        } else if x.kind == 3 {
            let w = where_of(d, ir.src_loc(x.file, 1));
            mp.b.u8_(MACRO_START_FILE);
            mp.b.uleb(line);
            d.parts[D_MACRO].b.uleb(@as(u64, w.file));
        } else {
            mp.b.u8_(MACRO_END_FILE);
        }
    }
    d.parts[D_MACRO].b.u8_(0);
}

fn finish(d: *mut Unit, text_size: u64) void {
    // .debug_abbrev
    abbrev_table(&mut d.parts[D_ABBREV].b);
    let mut name = "<unknown>";
    if d.first_src != 0 {
        let w = where_of(d, d.first_src);
        if w.file != 0 {
            name = elf.cstr_at(d.parts[D_LINE_STR].b.view(), @as(usize, d.files.get(@as(usize, w.file - 1))));
        }
    }
    let name_s = u.perm_dup(name);
    let comp_dir = u.cwd();
    // .debug_info: the header and the unit's DIE, then the subprograms
    let mut h = new_part();
    h.b.u32_(0);
    h.b.u16_(5);
    h.b.u8_(1);  // DW_UT_compile
    h.b.u8_(@truncate(u8, d.addr_size));
    sec_ref(d, &mut h, D_ABBREV, 0);
    let ranged = d.ranges.len > 1;
    let macros = d.full and (u.g_macros.len > 0) and not MACROS_DONE;
    if macros {
        MACROS_DONE = true;  // (in one unit: the first)
        h.b.uleb(AB_CU_MACROS + pk(d.lang != 0, 0, 1) + pk(ranged, 2, 0));
    } else if ranged {
        h.b.uleb(AB_CU_RANGES + pk(d.lang != 0, 0, 1));
    } else if d.lang != 0 {
        h.b.uleb(AB_CU);
    } else {
        h.b.uleb(AB_CU_NOLANG);
    }
    sec_ref(d, &mut h, D_STR, @as(u64, str_off(d, u.f1("axiom %s", ver.VERSION))));
    if d.lang != 0 {
        h.b.u16_(@as(u64, d.lang));
    }
    sec_ref(d, &mut h, D_STR, @as(u64, str_off(d, name_s)));
    sec_ref(d, &mut h, D_STR, @as(u64, str_off(d, comp_dir)));
    if ranged {
        // (DWARF 5, 2.17.3: the unit's code is the ranges of its list,
        // given as start and length; the base address 0)
        if d.addr_size == 4 {
            h.b.u32_(0);
        } else {
            h.b.u64_(0);
        }
        sec_ref(d, &mut h, D_RNGLISTS, @as(u64, list_start(d, D_RNGLISTS)));
        let r = &mut d.parts[D_RNGLISTS];
        for x in d.ranges.items() {
            r.b.u8_(RLE_START_LENGTH);
            addr_ref(d, r, @truncate(u32, x >> 32), 0);
            r.b.uleb(x & 0xffff_ffff);
        }
        r.b.u8_(RLE_END_OF_LIST);
    } else {
        addr_ref(d, &mut h, d.text_sym, 0);
        size_ref(d, &mut h, 4, text_size);
    }
    sec_ref(d, &mut h, D_LINE, 0);
    if macros {
        sec_ref(d, &mut h, D_MACRO, 0);
        macro_unit(d);
    }
    abstracts(d);
    let toff = types_and_data(d);
    let hn = @as(u64, h.b.len());
    prepend(&mut d.parts[D_INFO], &mut h);
    let info = &mut d.parts[D_INFO];
    for x in d.trefs.items() {
        let mut v: u64 = 0;  // (no type: never written, a reference is always to one)
        if x.sym < @truncate(u32, toff.len) {
            v = toff[@as(usize, x.sym)] + hn;
        }
        info.b.set_u32(@truncate(usize, x.off + hn), v);
    }
    d.trefs.deinit();
    for x in d.drefs.items() {
        info.b.set_u32(@truncate(usize, x.off + hn), @bit_cast(u64, x.addend) + hn);
    }
    d.drefs.deinit();
    typed_bases(d, toff, hn);
    for sec in [D_RNGLISTS, D_LOCLISTS] {
        let lb = &mut d.parts[sec].b;
        if lb.len() > 0 {
            lb.set_u32(0, @as(u64, lb.len() - 4));
        }
    }
    info.b.u8_(0);  // the end of the unit's children
    name_index(d, hn);
    info.b.set_u32(0, @as(u64, info.b.len() - 4));
    // .debug_line: the header, then the program
    let mut lh = new_part();
    lh.b.u32_(0);
    lh.b.u16_(5);
    lh.b.u8_(@truncate(u8, d.addr_size));
    lh.b.u8_(0);
    lh.b.u32_(0);  // header_length (below)
    let hstart = lh.b.len();
    lh.b.u8_(1);  // minimum_instruction_length
    lh.b.u8_(1);  // maximum_operations_per_instruction
    lh.b.u8_(1);  // default_is_stmt
    lh.b.u8_(@truncate(u8, @bit_cast(u64, LINE_BASE)));
    lh.b.u8_(@truncate(u8, @bit_cast(u64, LINE_RANGE)));
    lh.b.u8_(@truncate(u8, @bit_cast(u64, OPCODE_BASE)));
    let lens: [12]u8 = [0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1];
    lh.b.put(lens[..]);
    // directories: the compilation directory
    lh.b.u8_(1);
    lh.b.uleb(1);  // DW_LNCT_path
    lh.b.uleb(FORM_LINE_STRP);
    lh.b.uleb(1);
    sec_ref(d, &mut lh, D_LINE_STR, @as(u64, line_str_off(d, comp_dir)));
    // files: path, directory and (when every file has one) the MD5 of its
    // contents (DWARF 5, 6.2.4.1: DW_LNCT_MD5, DW_FORM_data16); entry 0 (the
    // unit's primary file) is entry 1 again
    if d.files.len == 0 {
        _ = file_index(d, name_s, u.nil.[u.SourceFile]());
    }
    let sums = not d.nosum;
    lh.b.u8_(@truncate(u8, pk(sums, 3, 2)));
    lh.b.uleb(1);
    lh.b.uleb(FORM_LINE_STRP);
    lh.b.uleb(2);  // DW_LNCT_directory_index
    lh.b.uleb(FORM_UDATA);
    if sums {
        lh.b.uleb(5);     // DW_LNCT_MD5
        lh.b.uleb(0x1e);  // DW_FORM_data16
    }
    lh.b.uleb(@as(u64, d.files.len + 1));
    for k in 0..(d.files.len + 1) {
        let mut fk = k;
        if k > 0 {
            fk = k - 1;
        }
        sec_ref(d, &mut lh, D_LINE_STR, @as(u64, d.files.get(fk)));
        lh.b.uleb(0);
        if sums {
            let sm = d.sums.get(fk);
            lh.b.put(sm[..]);
        }
    }
    lh.b.set_u32(hstart - 4, @as(u64, lh.b.len() - hstart));
    prepend(&mut d.parts[D_LINE], &mut lh);
    let line = &mut d.parts[D_LINE];
    line.b.set_u32(0, @as(u64, line.b.len() - 4));
    // .debug_aranges: the unit's code
    let ar = &mut d.parts[D_ARANGES];
    ar.b.u32_(0);
    ar.b.u16_(2);
    sec_ref(d, ar, D_INFO, 0);
    ar.b.u8_(@truncate(u8, d.addr_size));
    ar.b.u8_(0);
    while (ar.b.len() % @as(usize, @truncate(usize, 2 * d.addr_size))) != 0 {
        ar.b.u8_(0);
    }
    if ranged {
        for x in d.ranges.items() {
            addr_ref(d, ar, @truncate(u32, x >> 32), 0);
            if d.addr_size == 4 {
                ar.b.u32_(x & 0xffff_ffff);
            } else {
                ar.b.u64_(x & 0xffff_ffff);
            }
        }
    } else {
        addr_ref(d, ar, d.text_sym, 0);
        size_ref(d, ar, d.addr_size, text_size);
    }
    if d.addr_size == 4 {
        ar.b.u64_(0);
    } else {
        ar.b.u64_(0);
        ar.b.u64_(0);
    }
    ar.b.set_u32(0, @as(u64, ar.b.len() - 4));
}

// The unit's code size in n bytes: text_size, or a fixup (size_fix).
fn size_ref(d: *mut Unit, p: *mut Part, n: u64, text_size: u64) void {
    if d.size_fix {
        p.fx.push(Fix.{ off: @as(u64, p.b.len()), kind: FX_SIZE, sym: @truncate(u32, n), addend: 0 });
    }
    if n == 4 {
        p.b.u32_(text_size);
    } else {
        p.b.u64_(text_size);
    }
}

// Puts `h` (bytes and fixups) before `p`'s.
// The base types the typed operations of the unit's locations name
// (lrefs: dloc.TY_*): their operands become the offsets of the unit's own
// base types of that encoding and size (toff, after a header of hn bytes),
// or of entries made for them at the end of the unit.
fn typed_bases(d: *mut Unit, toff: []u64, hn: u64) void {
    if d.lrefs.len == 0 {
        return;
    }
    let encs: [7]u8 = [0, 4, 4, 5, 5, 7, 7];  // DW_ATE_float, DW_ATE_signed, DW_ATE_unsigned
    let sizes: [7]u64 = [0, 4, 8, 4, 8, 4, 8];
    let cnames: [7][]u8 = ["", "float", "double", "int", "long", "unsigned int", "unsigned long"];
    let anames: [7][]u8 = ["", "f32", "f64", "i32", "i64", "u32", "u64"];
    let mut at: [7]u64 = [0; 7];
    for x in d.lrefs.items() {
        let k = @as(usize, x.sym);
        if (k == 0) or (k >= 7) {
            continue;
        }
        if at[k] == 0 {
            for t in 0..@min(dbi.types.len, toff.len) {
                let y = dbi.types.at(t);
                if (y.kind == dbi.DK_BASE) and (y.bits == 0) and (y.enc == encs[k]) and (y.size == sizes[k]) {
                    at[k] = toff[t] + hn;
                    break;
                }
            }
        }
        if at[k] == 0 {
            at[k] = @as(u64, ib(d).len());
            ib(d).uleb(AB_BASE);
            strp(d, u.pick(dbi.c_version >= 0, cnames[k], anames[k]));
            ib(d).uleb(sizes[k]);
            ib(d).u8_(encs[k]);
        }
        d.parts[D_LOCLISTS].b.set_uleb_n(@truncate(usize, x.off), at[k], dloc.TY_PAD);
    }
    d.lrefs.deinit();
}

fn prepend(p: *mut Part, h: *mut Part) void {
    let n = @as(u64, h.b.len());
    for k in 0..p.fx.len {
        let x = p.fx.at(k);
        x.off += n;
    }
    for x in p.fx.items() {
        h.fx.push(x);
    }
    h.b.put(p.b.view());
    p.b.free();
    p.fx.deinit();
    p.* = h.*;
}

/// Unit.tls_rel of macOS: a thread-local's location is the address of a
/// descriptor of it (finish_elf, mlink.ax), DW_OP_form_tls_address taking
/// it as the platform's debugger does (the key the runtime set, the offset).
pub const TLS_DESC: u32 = 0xffff_ffff;
/// ... of --macos-tls=platform: the variable's symbol is its descriptor in
/// __thread_vars (isel.ax platform_tlv), the address taken as it is.
pub const TLS_PDESC: u32 = 0xffff_fffe;

/// Writes the unit into object `o` as its debug sections (relocations:
/// abs64 for addresses, abs32 for offsets into the sections), its code
/// being section `text` (text_size bytes).
pub fn finish_elf(d: *mut Unit, o: *mut elf.Obj, text: i32, abs64: u32, abs32: u32) void {
    if not d.on or (d.nfuncs == 0) {
        return;
    }
    // the sections of code that have some (isel.ax: func_section)
    d.ranges.clear();
    for k in 0..o.secs.len {
        let s = o.secs.get(k);
        if (s.kind == elf.S_TEXT) and (elf.sec_size(s) > 0) {
            d.ranges.push((@as(u64, elf.sec_sym(o, @int_cast(i32, k))) << 32) | (elf.sec_size(s) & 0xffff_ffff));
        }
    }
    d.text_sym = elf.sec_sym(o, text);
    let mut text_size = elf.sec_size(o.secs.get(@int_cast(usize, text)));
    if d.ranges.len == 1 {
        d.text_sym = @truncate(u32, d.ranges.get(0) >> 32);  // (the one with code, if not .text)
        text_size = d.ranges.get(0) & 0xffff_ffff;
    }
    finish(d, text_size);
    let mut secs: [11]i32 = [0; 11];
    let mut ssym: [11]u32 = [0; 11];
    for k in 0..NSEC {
        if (d.parts[k].b.len() == 0) and (k >= D_RNGLISTS) {
            continue;  // (none: not written)
        }
        secs[k] = elf.add_sec(o, SEC_NAMES[k], elf.S_DEBUG, 1);
        ssym[k] = elf.add_sym(o, elf.Sym.{ name: "", sec: secs[k], value: 0, size: 0, bind: elf.B_LOCAL,
                                           ty: elf.T_NOTYPE, hidden: false, protected: false });
    }
    // (macOS: each thread-local's descriptor, three words: 0, the key, and
    // the offset of the variable in the thread's block, which a relocation
    // to it says)
    let mut tlvd: i32 = -1;
    let mut tlvd_sym: u32 = 0;
    let mut descs = u.SymMap.[u64].{ keys: u.nil.[usize](), vals: u.nil.[u64](), cap: 0, len: 0 };
    for k in 0..NSEC {
        let p = &mut d.parts[k];
        if (p.b.len() == 0) and (k >= D_RNGLISTS) {
            continue;
        }
        let s = o.secs.get(@int_cast(usize, secs[k]));
        s.data.put(p.b.view());
        for x in p.fx.items() {
            if x.kind == FX_ADDR {
                s.relocs.push(elf.Rel.{ off: x.off, ty: abs64, sym: x.sym, addend: x.addend });
            } else if (x.kind == FX_TLS) and (d.tls_rel == TLS_PDESC) {
                s.relocs.push(elf.Rel.{ off: x.off, ty: abs64, sym: x.sym, addend: 0 });
            } else if (x.kind == FX_TLS) and (d.tls_rel == TLS_DESC) {
                if tlvd < 0 {
                    tlvd = elf.add_sec(o, "axiom_tlvd", elf.S_DATA, 8);
                    tlvd_sym = elf.add_sym(o, elf.Sym.{ name: "", sec: tlvd, value: 0, size: 0, bind: elf.B_LOCAL,
                                                        ty: elf.T_NOTYPE, hidden: false, protected: false });
                }
                let key = u.intern(u.f2("%s+%s", u.udec(@as(u64, x.sym)), u.udec(@bit_cast(u64, x.addend))));
                let mut at = descs.get(key);
                if at == 0 {
                    let t = o.secs.get(@int_cast(usize, tlvd));
                    at = @as(u64, t.data.len()) + 1;
                    t.data.zeros(24);
                    t.relocs.push(elf.Rel.{ off: at + 15, ty: abs64, sym: x.sym, addend: x.addend });
                    descs.put(key, at);
                }
                s.relocs.push(elf.Rel.{ off: x.off, ty: abs64, sym: tlvd_sym, addend: @bit_cast(i64, at - 1) });
            } else if x.kind == FX_TLS {
                s.relocs.push(elf.Rel.{ off: x.off, ty: d.tls_rel, sym: x.sym, addend: x.addend });
            } else {
                s.relocs.push(elf.Rel.{ off: x.off, ty: abs32, sym: ssym[@as(usize, x.sym)], addend: x.addend });
            }
        }
        p.b.free();
        p.fx.deinit();
    }
    d.on = false;
}

/// The unit's sections and their fixups, unresolved (a WebAssembly
/// object's, which wlink.ax merges with the others'): FX_ADDR of a function
/// or datum `sym`, or of TEXT_SYM (the start of the unit's code), FX_SIZE
/// (the size of the unit's code), FX_SEC (offset `addend` in the unit's
/// section `sym`). The parts are the caller's.
pub fn finish_parts(d: *mut Unit) [11]Part {
    let mut out: [11]Part = [new_part(); 11];
    if not d.on or (d.nfuncs == 0) {
        return out;
    }
    d.text_sym = TEXT_SYM;
    d.size_fix = true;
    finish(d, 0);
    for k in 0..NSEC {
        out[k] = d.parts[k];
        d.parts[k] = new_part();
    }
    d.on = false;
    return out;
}

/// The unit's sections with their fixups resolved, for a linker that knows
/// each function's address (addr_of(sym)) and places the code at text_addr
/// (text_size bytes): wlink.ax's custom sections.
pub fn finish_linked(d: *mut Unit, text_addr: u64, text_size: u64, addr_of: fn(u32) u64) [11]bn.Bytes {
    let mut out: [11]bn.Bytes = [bn.new_bytes(); 11];
    if not d.on or (d.nfuncs == 0) {
        return out;
    }
    d.text_sym = 0xffff_ffff;
    finish(d, text_size);
    for k in 0..NSEC {
        let p = &mut d.parts[k];
        for x in p.fx.items() {
            let at = @truncate(usize, x.off);
            if x.kind == FX_ADDR {
                let mut a = text_addr;
                if x.sym != 0xffff_ffff {
                    a = addr_of(x.sym);
                }
                let v = a + @bit_cast(u64, x.addend);
                if d.addr_size == 4 {
                    p.b.set_u32(at, v & 0xffff_ffff);
                } else {
                    p.b.set_u64(at, v);
                }
            } else {
                p.b.set_u32(at, @bit_cast(u64, x.addend) & 0xffff_ffff);
            }
        }
        out[k] = p.b;
        p.fx.deinit();
    }
    d.on = false;
    return out;
}
