    INF_LANES,       // IN_FMA
    INF_LANES,       // IN_COPYSIGN
    INF_LANES,       // IN_ABS
    INF_OPAQUE,      // IN_TRAP
    INF_OPAQUE,      // IN_MEMSIZE
    INF_OPAQUE,      // IN_MEMGROW
    INF_OPAQUE,      // IN_WAIT32
    INF_OPAQUE,      // IN_NOTIFY
    INF_OPAQUE,      // IN_SET_SP
    INF_PURE,        // IN_ANYTRUE
    INF_PURE,        // IN_ALLTRUE
    INF_PURE,        // IN_BITMASK
    INF_PURE,        // IN_SWIZZLE
    INF_PURE,        // IN_DOT_I16
    INF_PURE,        // IN_UMUL_OV
    INF_PURE,        // IN_SMUL_OV
    INF_OPAQUE,      // IN_GET_SP
    INF_OPAQUE,      // IN_CPUID
    INF_OPAQUE,      // IN_XGETBV
    INF_PURE,        // IN_AESENC
