// Inline assembly (IN_ASM, whose first operand is its index in asm/inline.ax's
// table): what each statement is, for the passes (the front end notes it:
// note_asm). ASM_NODUP: its template defines symbols (named labels), so
// the statement is not copied (inlined, unrolled, threaded). ASM_PURE: not
// volatile, no "memory" clobber and no memory operands, its outputs in
// registers (IN_CALL_RESULT(asm, k): output operand k): a function of its
// inputs, which is removed when its outputs are unused and may be merged
// with an equal one or moved (INF_PURE). ASM_HINT: volatile, but with no
// "memory" clobber and no memory operands: kept where it is, and no
// barrier to memory accesses (INF_HINT). Neither: it may read and write
// any memory (INF_OPAQUE: a "memory" clobber, memory operands, operands in
// registers the compiler does not allocate, asm goto).
pub const ASM_NODUP: u32 = 1;
pub const ASM_PURE: u32 = 2;
pub const ASM_HINT: u32 = 4;
pub const ASM_STACK: u32 = 8;  // its template calls, or uses the stack (pushes, pops, names the stack pointer): its function makes no sibling calls
// ASM_EXACT: memory operands but no "memory" clobber (not asm goto, nor a
// template that calls): the statement reads its input memory operands'
// objects and writes its output ones', and no other memory (the dialect's
// rule; asm_mem lists them). It stays INF_OPAQUE for the passes that do not
// ask (gvn.ax's memory reasoning does: exact_asm).
pub const ASM_EXACT: u32 = 16;
pub threadlocal let mut asm_flags: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };

/// A memory operand of an ASM_EXACT statement: its address is the IN_ASM's
/// operand `arg`, the object `size` bytes (-1: unknown), read and/or written.
pub struct AsmMem {
    pub arg: u32,
    pub size: i64,
    pub rd: bool,
    pub wr: bool,
}

pub threadlocal let mut asm_mems: u.List.[[]AsmMem] = u.List.[[]AsmMem].{
    data: @ptr_from_int(*mut []AsmMem, 0), len: 0, cap: 0 };

/// Notes the memory operands of the ASM_EXACT statement of index k (ms: in
/// permanent memory).
pub fn note_asm_mem(k: i64, ms: []AsmMem) void {
    let n = @int_cast(usize, k);
    while asm_mems.len <= n {
        asm_mems.push(ms[0..0]);
    }
    asm_mems.set(n, ms);
}

/// The memory operands of IN_ASM v, an ASM_EXACT statement (asm_of).
pub fn asm_mem_of(v: *Value) []AsmMem {
    let k = @int_cast(usize, cint_val(v.xs.get(0)));
    return asm_mems.get(k);
}

/// Notes the flags (ASM_*) of the asm statement of index k.
pub fn note_asm(k: i64, flags: u32) void {
    let n = @int_cast(usize, k);
    while asm_flags.len <= n {
        asm_flags.push(0);
    }
    asm_flags.set(n, flags);
}

/// The ASM_* flags of IN_ASM v (0 for another instruction).
pub fn asm_of(v: *Value) u32 {
    if (intr_id(v) != IN_ASM) or (v.xs.len == 0) or not is_cint(v.xs.get(0)) {
        return 0;
    }
    let k = @int_cast(usize, cint_val(v.xs.get(0)));
    if k >= asm_flags.len {
        return 0;
    }
    return asm_flags.get(k);
}

/// The INF_* properties of intrinsic v: its intrinsic's, but an asm
/// statement's are its own (ASM_*), and the results of a pure one
/// (IN_CALL_RESULT of it) are pure too.
pub fn inst_props(v: *Value) u32 {
    let id = intr_id(v);
    if id == IN_ASM {
        let f = asm_of(v);
        if (f & ASM_PURE) != 0 {
            return INF_PURE;
        }
        if (f & ASM_HINT) != 0 {
            return INF_HINT;
        }
        return INF_OPAQUE;
    }
    if (id == IN_CALL_RESULT) and (v.xs.len > 0) {
        let c = v.xs.get(0);
        if (intr_id(c) == IN_ASM) and ((asm_of(c) & ASM_PURE) != 0) {
            return INF_PURE;
        }
    }
    return intr_props(id);
}

/// Is intrinsic v pure (inst_props)?
pub fn inst_pure(v: *Value) bool {
    return (inst_props(v) & INF_PURE) != 0;
}

/// Is intrinsic v opaque (inst_props)?
pub fn inst_opaque(v: *Value) bool {
    return (inst_props(v) & INF_OPAQUE) != 0;
}

/// Does intrinsic v write memory, or might it (inst_props)?
pub fn inst_writes_mem(v: *Value) bool {
    return (inst_props(v) & (INF_WRITES_MEM | INF_OPAQUE)) != 0;
}

/// Must intrinsic v be kept though its result is unused (inst_props)?
pub fn inst_has_effects(v: *Value) bool {
    return (inst_props(v) & (INF_WRITES_MEM | INF_HINT | INF_OPAQUE)) != 0;
}

/// May instruction v be copied (a statement of inline assembly whose
/// template defines symbols may not)?
pub fn can_copy(v: *Value) bool {
    return (asm_of(v) & ASM_NODUP) == 0;
}

/// May block b's instructions be copied?
pub fn can_copy_block(b: *Block) bool {
    let mut i = b.first;
    while u.notnil(i) {
        if not can_copy(i) {
            return false;
        }
        i = i.next;
    }
    return true;
}

pub fn intr_props(id: Intrinsic) u32 {
    let k = @int_from_enum(id);
    if (k < 0) or (k > @int_from_enum(IN_RESTRICT)) {
        return 0;
    }
    return IN_PROPS[@int_cast(usize, k)];
}

pub fn is_int_binop(op: i32) bool {
    return (op_props(op) & OPF_INT_BINOP) != 0;
}

// Integer or floating point (OP_ADD .. OP_FREM).
pub fn is_binop(op: i32) bool {
    return (op_props(op) & (OPF_INT_BINOP | OPF_FP_BINOP)) != 0;
}

pub fn is_cast(op: i32) bool {
    return (op_props(op) & OPF_CAST) != 0;
}

pub fn is_int_div(op: i32) bool {
    return (op_props(op) & OPF_DIV) != 0;
}

pub fn op_pure(op: i32) bool {
    return (op_props(op) & OPF_PURE) != 0;
}

pub fn op_writes_mem(op: i32) bool {
    return (op_props(op) & OPF_WRITES_MEM) != 0;
}

// Reads or writes memory.
pub fn op_accesses_mem(op: i32) bool {
    return (op_props(op) & OPF_MEM) != 0;
}

pub fn intr_pure(id: Intrinsic) bool {
    return (intr_props(id) & INF_PURE) != 0;
}

pub fn intr_lanewise(id: Intrinsic) bool {
    return (intr_props(id) & INF_LANEWISE) != 0;
}

pub fn intr_opaque(id: Intrinsic) bool {
    return (intr_props(id) & INF_OPAQUE) != 0;
}

// Writes memory, or might (the opaque ones).
pub fn intr_writes_mem(id: Intrinsic) bool {
    return (intr_props(id) & (INF_WRITES_MEM | INF_OPAQUE)) != 0;
}

// Must be kept though its result is unused: all but the pure ones and the
// loads.
pub fn intr_has_effects(id: Intrinsic) bool {
    return (intr_props(id) & (INF_WRITES_MEM | INF_HINT | INF_OPAQUE)) != 0;
}

/// The memory order of atomic operation or fence v (ORD_).
pub fn order(v: *Value) u32 {
    return (v.flags & F_ORD_MASK) >> F_ORD_SHIFT;
}

/// The memory order of cmpxchg v on failure (ORD_).
pub fn fail_order(v: *Value) u32 {
    return (v.flags & F_FAIL_MASK) >> F_FAIL_SHIFT;
}

/// Sets the memory order of atomic operation or fence v (and, of a cmpxchg,
/// its order on failure).
pub fn set_order(v: *mut Value, o: u32, fail: u32) void {
    v.flags = (v.flags & ~(F_ORD_MASK | F_FAIL_MASK)) | ((o << F_ORD_SHIFT) & F_ORD_MASK) |
              ((fail << F_FAIL_SHIFT) & F_FAIL_MASK);
}

/// Does order o (ORD_) make an operation acquire (its reads)?
pub fn ord_acquires(o: u32) bool {
    return (o == ORD_SEQ_CST) or (o == ORD_ACQUIRE) or (o == ORD_ACQ_REL);
}

/// Does order o make an operation release (its writes)?
pub fn ord_releases(o: u32) bool {
    return (o == ORD_SEQ_CST) or (o == ORD_RELEASE) or (o == ORD_ACQ_REL);
}

/// The one order at least as strong as both a cmpxchg's success order s and
/// its failure order f (what one instruction for it must have).
pub fn ord_join(s: u32, f: u32) u32 {
    if (s == ORD_SEQ_CST) or (f == ORD_SEQ_CST) {
        return ORD_SEQ_CST;
    }
    let acq = ord_acquires(s) or ord_acquires(f);
    let rel = ord_releases(s) or ord_releases(f);
    if acq and rel {
        return ORD_ACQ_REL;
    }
    if acq {
        return ORD_ACQUIRE;
    }
    if rel {
        return ORD_RELEASE;
    }
    return ORD_RELAXED;
}
// Does v (an add, sub, mul or shl) have flag fl (F_NSW, F_NUW)?
pub fn no_wrap(v: *Value, fl: u32) bool {
    if u.isnil(v) or (v.kind != V_INST) or ((v.flags & fl) == 0) {
        return false;
    }
    let op = v.op;
    return (op == OP_ADD) or (op == OP_SUB) or (op == OP_MUL) or (op == OP_SHL);
}

// v's operands or operator changed: the flags no longer hold.
pub fn no_wrap_clear(v: *mut Value) void {
    v.flags = v.flags & ~F_NO_WRAP;
}

// v takes the place of w (an equal value): v's flags only where both have them.
pub fn no_wrap_meet(v: *mut Value, w: *Value) void {
    if u.notnil(v) and (v.kind == V_INST) and ((v.flags & F_NO_WRAP) != 0) {
        let keep = (w.kind == V_INST) and (w.op == v.op);
        if keep {
            v.flags = v.flags & (w.flags | ~F_NO_WRAP);
        } else {
            no_wrap_clear(v);
        }
    }
}

// An OP_MEMMOVE whose destination and source are the same bytes or apart,
// never partly overlapping (a C structure assignment, C11 6.5.16.1p3), for
// which a forward copy is correct: marked by its cv (which memory
// operations have no other use for). Passes that make a new memmove, or
// change an operand of one to another object, leave the mark out.
pub const MEMMOVE_SAME_OR_APART: u64 = 1;

pub fn same_or_apart(v: *Value) bool {
    return (v.op == OP_MEMMOVE) and (v.cv == MEMMOVE_SAME_OR_APART);
}

// -----------------------------------------------------------------------------
// What the passes ask of instructions
// -----------------------------------------------------------------------------

// A floating-point operation whose result depends on the rounding mode or
// that may raise an exception: the arithmetic, comparisons, conversions to,
// from and between floating types, and the floating intrinsics (sqrt, fma,
// the roundings, min and max). Negation and the absolute value are exact
// and raise nothing.
pub fn fp_env_op(i: *Value) bool {
    let op = i.op;
    if ((op >= OP_FADD) and (op <= OP_FREM)) or (op == OP_FCMP) or (op == OP_FPEXT) or (op == OP_FPTRUNC) {
        return true;
    }
    if (op == OP_SITOFP) or (op == OP_UITOFP) or (op == OP_FPTOSI_SAT) or (op == OP_FPTOUI_SAT) {
        return true;
    }
    if op == OP_INTR {
        let id = intr_id(i);
        return (id == IN_SQRT) or (id == IN_FMA) or (id == IN_FMIN) or (id == IN_FMAX) or
               intr_between(id, IN_FLOOR, IN_NEAREST);
    }
    return false;
}

// Is i a floating-point operation of a function with strict floating
// point (Func's strict_fp), which the passes must leave where it is, as it
// is: not folded, merged with another, moved (across a call that changes or
// tests the environment) or removed (its exceptions are effects)?
pub inline fn fp_pinned(i: *Value) bool {
    if (i.kind != V_INST) or u.isnil(i.blk) or u.isnil(i.blk.fnp) or not i.blk.fnp.strict_fp {
        return false;
    }
    return fp_env_op(i);
}

// Must instruction i be kept though its result is unused (it writes memory,
// ends its block, is a volatile or atomic load, an intrinsic with an
// effect, or a floating-point operation under strict floating point)?
pub inline fn has_effects(i: *Value) bool {
    let op = i.op;
    if fp_pinned(i) {
        return true;
    }
    if (op_props(op) & (OPF_WRITES_MEM | OPF_TERM)) != 0 {
        return true;
    }
    if op == OP_LOAD {
        return i.flags != 0;
    }
    if op == OP_INTR {
        return inst_has_effects(i);
    }
    return false;
}

// Is v an instruction with opcode op (false for nil)?
pub fn is_op(v: *Value, op: i32) bool {
    return u.notnil(v) and (v.kind == V_INST) and (v.op == op);
}

// The predicate (Int*, Real*) of a comparison.
pub fn pred_of(v: *Value) CmpPred {
    return @enum_from_int(CmpPred, @truncate(i32, @bit_cast(i64, v.cv)));
}

// a if c, else b.
pub fn pick_pred(c: bool, a: CmpPred, b: CmpPred) CmpPred {
    if c {
        return a;
    }
    return b;
}

// A comparison's cv for predicate p.
pub fn pred_cv(p: CmpPred) u64 {
    return @as(u64, @bit_cast(u32, @int_from_enum(p)));
}

// The predicate with its operands swapped: a p b == b swap(p) a.
pub fn swap_pred(p: CmpPred) CmpPred {
    match p {
        .UGT => { return IntULT; }
        .ULT => { return IntUGT; }
        .UGE => { return IntULE; }
        .ULE => { return IntUGE; }
        .SGT => { return IntSLT; }
        .SLT => { return IntSGT; }
        .SGE => { return IntSLE; }
        .SLE => { return IntSGE; }
        else => { return p; }
    }
}

// The negated predicate: not (a p b) == a inv(p) b.
pub fn inv_pred(p: CmpPred) CmpPred {
    match p {
        .EQ  => { return IntNE; }
        .NE  => { return IntEQ; }
        .UGT => { return IntULE; }
        .ULE => { return IntUGT; }
        .UGE => { return IntULT; }
        .ULT => { return IntUGE; }
        .SGT => { return IntSLE; }
        .SLE => { return IntSGT; }
        .SGE => { return IntSLT; }
        else => { return IntSGE; }  // SLT
    }
}

// The unsigned predicate of a signed one: a p b == a unsigned(p) b when
// neither is negative.
pub fn unsigned_pred(p: CmpPred) CmpPred {
    match p {
        .SGT => { return IntUGT; }
        .SGE => { return IntUGE; }
        .SLT => { return IntULT; }
        .SLE => { return IntULE; }
        else => { return p; }
    }
}

pub fn is_signed_pred(p: CmpPred) bool {
    match p {
        .SGT, .SGE, .SLT, .SLE => { return true; }
        else                   => { return false; }
    }
}

// Integer operations whose operands may be swapped.
pub fn commutative_int(op: i32) bool {
    return (op_props(op) & (OPF_COMMUTATIVE | OPF_INT_BINOP)) == (OPF_COMMUTATIVE | OPF_INT_BINOP);
}

// The same, and the floating point ones (the same result, NaNs aside).
pub fn commutative(op: i32) bool {
    return (op_props(op) & OPF_COMMUTATIVE) != 0;
}

// The base of address p, through additions of any offsets.
pub fn ptr_base(p: *mut Value) *mut Value {
    let mut q = p;
    while is_op(q, OP_PTRADD) {
        q = q.a;
    }
    return q;
}

// The function call v calls directly: its callee is a function of the
// call's own signature. A function pointer cast to another function type
// and called is still an indirect call once its value is known (on
// WebAssembly, call_indirect checks the signature and traps, T0009), so it
// is not one of the function's calls: nil.
fn sig_eq(t: *Ty, ft: *Ty) bool {
    if (t.ret != ft.ret) or (t.vararg != ft.vararg) or (t.params.len != ft.params.len) {
        return false;
    }
    for i in 0..t.params.len {
        if t.params[i] != ft.params[i] {
            return false;
        }
    }
    return true;
}

pub fn direct_callee(v: *mut Value) *mut Func {
    if (v.op != OP_CALL) or (v.a.kind != V_FUNC) {
        return u.nil.[Func]();
    }
    let f = fnp_of(v.a);
    if not sig_eq(fty_of(v), f.ty) {
        return u.nil.[Func]();
    }
    return f;
}

/// Is pointer v known not to be null: the address of a stack slot, a
/// parameter with F_NONNULL, or the result of a direct call of a function
/// with ret_nonnull? (Not the address of a global or a function: a weak
/// reference may be null, and on WebAssembly address 0 and table index 0
/// are where objects or functions may be.)
pub fn known_nonnull(v0: *mut Value) bool {
    let v = resolve(v0);
    if u.isnil(v) or (v.ty.kind != T_PTR) {
        return false;
    }
    if v.kind == V_PARAM {
        return (v.flags & F_NONNULL) != 0;
    }
    if v.kind != V_INST {
        return false;
    }
    if v.op == OP_ALLOCA {
        return true;
    }
    if v.op == OP_CALL {
        let f = direct_callee(v);
        return u.notnil(f) and f.ret_nonnull and (ext_of(v).len > 0) and (ext_of(v)[0] == 0);
    }
    return false;
}

/// What call v may do (FX_), as its callee's declaration promises: FX_ANY
/// unless it is a direct call of a function with Func.fx whose arguments
/// and result are scalars (no aggregate's memory: a result written to the
/// caller's slot is a write; an aggregate passed by value is read from its
/// copy, so FX_NONE is FX_READS then) and that neither returns twice nor is
/// declared not to return. An indirect call promises nothing.
pub inline fn call_fx(v: *Value) u8 {
    if (v.kind != V_INST) or (v.op != OP_CALL) or (v.a.kind != V_FUNC) {
        return FX_ANY;
    }
    return direct_call_fx(v);
}

// (call_fx) That of a direct call.
fn direct_call_fx(v: *Value) u8 {
    let f = fnp_ro(v.a);
    if not sig_eq(fty_ro(v), f.ty) or (f.fx == FX_ANY) or f.noreturn or f.returns_twice {
        return FX_ANY;
    }
    let mut fx = f.fx;
    let ext = ext_ro(v);
    for k in 0..ext.len {
        let e = ext[k];
        if (e == EXT_BYVAL) and (k > 0) {
            fx = FX_READS;
        } else if e > 2 {
            return FX_ANY;
        }
    }
    return fx;
}
