// =============================================================================
// wasm_asm.ax - inline and file-scope WebAssembly assembly, part of wasm.ax.
// =============================================================================
import "asm/check.ax" as ack;
import "asm/inline.ax" as ai;
import "asm/wasm.ax" as aw;
import "bin.ax" as bn;
import "ir.ax" as ir;
import "util.ax" as u;
import "wobj.ax" as wo;

// -----------------------------------------------------------------------------
// Inline assembly (the C front end's GNU dialects: asm/wasm.ax)
//
// An asm statement (IN_ASM) gets a local of its own for each operand that
// is one (an input's value, an output, a memory operand's address; an input
// tied to an output shares the output's), set from the inputs before its
// code; its outputs, IN_CALL_RESULT(asm, k), are those locals after it. Its
// symbols are relocations to the program's functions and objects.
// File-scope asm's functions are functions of the unit, after the IR's.
// -----------------------------------------------------------------------------
threadlocal let mut MOD: *mut ir.Module = @ptr_from_int(*mut ir.Module, 0);
threadlocal let mut asm_vals: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{
    data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0, cap: 0 };
threadlocal let mut asm_locs: u.List.[[]i64] = u.List.[[]i64].{ data: @ptr_from_int(*mut []i64, 0), len: 0, cap: 0 };
// (the aliases of the asm being assembled: names of internal linkage, their symbols)
threadlocal let mut asm_blob: *mut ai.Blob = @ptr_from_int(*mut ai.Blob, 0);
// file-scope asm's functions and imports: name (or import's id) -> symbol + 1
threadlocal let mut top_syms: u.SymMap.[u32] = u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0),
                                                                vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 };
threadlocal let mut top_heads: u.List.[*mut aw.AFunc] = u.List.[*mut aw.AFunc].{
    data: @ptr_from_int(*mut *mut aw.AFunc, 0), len: 0, cap: 0 };
// (each text's headers: its other fields, which asm statements see too)
threadlocal let mut top_hdrs: u.List.[*mut aw.Asm] = u.List.[*mut aw.Asm].{
    data: @ptr_from_int(*mut *mut aw.Asm, 0), len: 0, cap: 0 };

// The key of top_syms for a field of kind k (aw.FK_*) named n: each kind
// has its own namespace in the text.
fn fkey(k: u8, n: []u8) []u8 {
    let pre = ["", "\x01g", "\x01t", "\x01d", "\x01e", "\x01y"];
    return u.intern(u.cat2(pre[@as(usize, k)], n));
}

// The key of field n of kind k of the unit's text number j (cur_text):
// each text's names are its own; fkey's are the unit's, the first text's
// that declares the name, which asm statements see.
fn tkey(j: i64, k: u8, n: []u8) []u8 {
    return u.intern(u.cat3(u.idec(@truncate(i32, j)), "\x01", fkey(k, n)));
}

threadlocal let mut cur_text: i64 = -1;  // (the text whose fields' names are being resolved, -1: an asm statement's)

fn put_field(k: u8, n: []u8, sym1: u32) void {
    top_syms.put(tkey(cur_text, k, n), sym1);
    if top_syms.get(fkey(k, n)) == 0 {
        top_syms.put(fkey(k, n), sym1);
    }
}

fn get_field(k: u8, n: []u8) u32 {
    if cur_text >= 0 {
        return top_syms.get(tkey(cur_text, k, n));
    }
    return top_syms.get(fkey(k, n));
}

// A field of the unit's file-scope asm (asm/wasm.ax's g_field).
fn asm_field(k: u8, n: []u8) aw.FieldRef {
    for H in top_hdrs.items() {
        let r = aw.field_of(H, k, n);
        if r.kind != aw.FK_NONE {
            return r;
        }
    }
    return aw.FieldRef.{ kind: aw.FK_NONE, params: "", results: "", mutable: false, imported: false };
}

// The symbol name `n` of asm text stands for (an internal name's).
fn asm_name(n: []u8) []u8 {
    if u.isnil(asm_blob) {
        return n;
    }
    let asm_aliases = asm_blob.aliases;
    let mut k: usize = 0;
    while (k + 1) < asm_aliases.len {
        if u.str_eq(asm_aliases[k], n) {
            return asm_aliases[k + 1];
        }
        k += 2;
    }
    return n;
}

fn fn_vts(t: *ir.Ty) aw.Ref {
    let ps = u.newn.[u8](t.params.len + 2);
    for i in 0..t.params.len {
        ps[i] = vt(t.params[i]);
    }
    let mut np = t.params.len;
    if t.vararg {
        ps[np] = ptr_vt();
        np += 1;
    }
    let rs = u.newn.[u8](2);
    let mut nr: usize = 0;
    if t.ret.kind != ir.T_VOID {
        rs[0] = vt(t.ret);
        nr = 1;
    }
    return aw.Ref.{ kind: aw.RF_FUNC, params: ps[0..np], results: rs[0..nr] };
}

// What a name of asm text is in the program (asm/wasm.ax's g_lookup):
// file-scope asm's functions, the IR's functions and objects.
fn asm_lookup(n0: []u8) aw.Ref {
    for f in top_heads.items() {
        if u.str_eq(f.name, n0) {
            return aw.Ref.{ kind: aw.RF_FUNC, params: f.params, results: f.results };
        }
    }
    let n = asm_name(n0);
    let f = ir.get_function(MOD, n);
    if u.notnil(f) {
        return fn_vts(f.ty);
    }
    let g = ir.get_global(MOD, n);
    if u.notnil(g) and not g.wasm_global {
        return aw.Ref.{ kind: aw.RF_DATA, params: "", results: "" };
    }
    return aw.Ref.{ kind: aw.RF_NONE, params: "", results: "" };
}

// The symbol of function or object `n0` of asm text (imports: an import's
// id in that text, else -1), or -1 (reported).
fn asm_sym(n0: []u8, func: bool) i64 {
    let t = top_syms.get(u.intern(n0));
    if t != 0 {
        return @as(i64, t - 1);
    }
    let n = asm_name(n0);
    if func {
        let f = ir.get_function(MOD, n);
        if u.notnil(f) {
            return @as(i64, fsyms.get(@int_cast(usize, f.id)));
        }
    } else {
        let g = ir.get_global(MOD, n);
        if u.notnil(g) and not g.wasm_global {
            return @as(i64, gsyms.get(@int_cast(usize, g.id)));
        }
    }
    fail(u.f1("asm names $%s, which the program does not define or declare", n0));
    return -1;
}

// The symbol and addend of IR constant x (a function's or object's
// address, plus a constant), or sym -1 (reported).
struct SymAt {
    sym: i64,
    addend: i64,
    func: bool,
}

fn sym_at(x: *mut ir.Value) SymAt {
    if x.kind == ir.V_GLOBAL {
        return SymAt.{ sym: @as(i64, gsyms.get(@int_cast(usize, ir.gv_of(x).id))), addend: 0, func: false };
    }
    if x.kind == ir.V_FUNC {
        return SymAt.{ sym: @as(i64, fsyms.get(@int_cast(usize, ir.fnp_of(x).id))), addend: 0, func: true };
    }
    if (x.kind == ir.V_INST) and (x.op == ir.OP_PTRADD) and (x.b.kind == ir.V_CINT) {
        let mut r = sym_at(x.a);
        r.addend += ir.sval(x.b);
        return r;
    }
    if (x.kind == ir.V_INST) and ((x.op == ir.OP_INTTOPTR) or (x.op == ir.OP_BITCAST)) {
        return sym_at(x.a);
    }
    fail("an asm operand of a symbol is not a function's or an object's address");
    return SymAt.{ sym: -1, addend: 0, func: false };
}

// The relocations of asm code at `base` in buffer `code` (its fixups fx;
// v: the statement, whose operands the fixups may name), into rl.
fn asm_relocs(code: *mut bn.Bytes, base: u32, fx: []aw.Fix, v: *mut ir.Value, rl: *mut u.List.[wo.Reloc]) void {
    for f in fx {
        let off = base + f.off;
        let k = f.kind;
        if k == aw.FX_TYPE {
            let ti = wo.type_index(UN, f.params, f.results);
            code.set_uleb_n(@as(usize, off), @as(u64, ti), 5);
            rl.push(wo.Reloc.{ ty: wo.R_TYPE_INDEX_LEB, off: off, sym: ti, addend: 0 });
            continue;
        }
        if k == aw.FX_SP {
            rl.push(wo.Reloc.{ ty: wo.R_GLOBAL_INDEX_LEB, off: off, sym: sp_sym, addend: 0 });
            continue;
        }
        if (k == aw.FX_GLOBAL) or (k == aw.FX_TAG) or (k == aw.FX_DATA_SEG) or (k == aw.FX_ELEM_SEG) {
            // (a field of file-scope asm: its symbol, or an element segment's index)
            let fk = u8_pick(k == aw.FX_GLOBAL, aw.FK_GLOBAL, u8_pick(k == aw.FX_TAG, aw.FK_TAG,
                                                                      u8_pick(
                                                                          k == aw.FX_DATA_SEG, aw.FK_DATA,
                                                                          aw.FK_ELEM)));
            let t = get_field(fk, f.name);
            if t == 0 {
                fail(u.f1("asm names $%s, which the unit's file-scope asm does not declare", f.name));
                continue;
            }
            let ty = u8_pick(k == aw.FX_GLOBAL, wo.R_GLOBAL_INDEX_LEB,
                             u8_pick(
                                 k == aw.FX_TAG, wo.R_TAG_INDEX_LEB,
                                 u8_pick(k == aw.FX_DATA_SEG, wo.R_AXIOM_DATA_INDEX_LEB, wo.R_AXIOM_ELEM_INDEX_LEB)));
            if k == aw.FX_ELEM_SEG {
                UN.uses_table = true;
            }
            rl.push(wo.Reloc.{ ty: ty, off: off, sym: t - 1, addend: 0 });
            continue;
        }
        let mut at = SymAt.{ sym: -1, addend: 0, func: k != aw.FX_DATA };
        if f.op >= 0 {
            at = sym_at(v.xs.get(@int_cast(usize, f.op) + 1));
        } else {
            at.sym = asm_sym(f.name, k != aw.FX_DATA);
        }
        if at.sym < 0 {
            continue;
        }
        let s = @truncate(u32, @bit_cast(u64, at.sym));
        if k == aw.FX_FUNC {
            rl.push(wo.Reloc.{ ty: wo.R_FUNCTION_INDEX_LEB, off: off, sym: s, addend: 0 });
        } else if k == aw.FX_TABLE {
            UN.uses_table = true;
            rl.push(wo.Reloc.{ ty: u8_pick(W64, wo.R_TABLE_INDEX_SLEB64, wo.R_TABLE_INDEX_SLEB), off: off, sym: s,
                               addend: 0 });
        } else {
            rl.push(wo.Reloc.{ ty: u8_pick(W64, wo.R_MEMORY_ADDR_SLEB64, wo.R_MEMORY_ADDR_SLEB), off: off, sym: s,
                               addend: at.addend });
        }
    }
}

fn u8_pick(c: bool, a: u8, b: u8) u8 {
    if c {
        return a;
    }
    return b;
}

// A number unique to each asm statement emitted (%=).
threadlocal let mut asm_count: u64 = 0;

fn gen_asm(v: *mut ir.Value) void {
    let b = ai.blob(ir.sval(v.xs.get(0)));
    let n = b.ops.len;
    let locs = u.newn.[i64](n + 1);
    let consts = u.newn.[i64](n + 1);
    for k in 0..n {
        let bo = b.ops[k];
        locs[k] = -1;
        consts[k] = 0;
        if bo.kind == ai.OK_IMM {
            let x = v.xs.get(k + 1);
            if not bo.sym and (x.kind == ir.V_CINT) {
                consts[k] = ir.sval(x);
            }
            continue;
        }
        if bo.tie >= 0 {
            locs[k] = locs[@int_cast(usize, bo.tie)];
        } else {
            locs[k] = @as(i64, new_local(ack.wasm_op_vt(bo, W64)));
        }
    }
    // the inputs' values (and memory operands' addresses) into their locals
    for k in 0..n {
        let bo = b.ops[k];
        if (bo.kind == ai.OK_IMM) or (bo.out and (bo.kind != ai.OK_MEM)) {
            continue;
        }
        push(v.xs.get(k + 1));
        local_set(@truncate(u32, @bit_cast(u64, locs[k])));
    }
    let mut res: u32 = 0;
    if b.goto_ {
        res = new_local(wo.I32);
    }
    let env = ack.wasm_env(b, W64, locs[0..n], res);
    if env.err.len > 0 {
        fail(u.f2("asm at %s: %s", b.loc, env.err));
        return;
    }
    asm_blob = b;
    aw.g_lookup = asm_lookup;
    aw.g_field = asm_field;
    asm_count += 1;
    let A = aw.assemble_inline(ack.wasm_text(b, consts[0..n], asm_count), &env.env, W64);
    if aw.failed(A) {
        fail(u.f2("asm at %s: %s", b.loc, aw.message(A, false)));
        return;
    }
    set_end = 0xffff_ffff;
    let base = @int_cast(u32, CB.len());
    CB.put(A.code.view());
    asm_relocs(&mut CB, base, A.fixes.items(), v, &mut RL);
    if A.uses_table {
        UN.uses_table = true;
    }
    asm_vals.push(v);
    asm_locs.push(locs[0..n]);
    if b.goto_ {
        local_get(res);
    }
}

// IN_CALL_RESULT(asm, k): output k's local.
fn asm_result(v: *mut ir.Value) void {
    let a = v.xs.get(0);
    let k = @int_cast(usize, ir.sval(v.xs.get(1)));
    let mut j = asm_vals.len;
    while j > 0 {
        j -= 1;
        if asm_vals.get(j) == a {
            local_get(@truncate(u32, @bit_cast(u64, asm_locs.get(j)[k])));
            return;
        }
    }
    fail("an asm output read before its asm statement");
}

// File-scope asm (ai.toplevel): each text's functions and imports, made
// before the IR's functions are numbered; `skip` the IR's declarations a
// text defines (its function is theirs).
threadlocal let mut top_asms: u.List.[*mut aw.Asm] = u.List.[*mut aw.Asm].{
    data: @ptr_from_int(*mut *mut aw.Asm, 0), len: 0, cap: 0 };
threadlocal let mut top_blobs: u.List.[*mut ai.Blob] = u.List.[*mut ai.Blob].{
    data: @ptr_from_int(*mut *mut ai.Blob, 0), len: 0, cap: 0 };

fn top_assemble(m: *mut ir.Module) bool {
    MOD = m;
    top_syms = u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 };
    top_heads.clear();
    top_hdrs.clear();
    cur_text = -1;
    top_asms.clear();
    top_blobs.clear();
    asm_vals.clear();
    asm_locs.clear();
    // (the headers first: a text may call another's functions)
    aw.g_field = aw.no_field;
    for b in ai.toplevel.items() {
        let H = aw.assemble_headers(b.text, W64);
        if aw.failed(H) {
            fail(u.f2("file-scope asm at %s: %s", b.loc, aw.message(H, true)));
            return false;
        }
        for f in H.funcs.items() {
            for g in top_heads.items() {
                if u.str_eq(g.name, f.name) {
                    fail(u.f2("file-scope asm at %s: $%s is defined twice", b.loc, f.name));
                    return false;
                }
            }
            top_heads.push(f);
        }
        top_hdrs.push(H);
    }
    aw.g_lookup = asm_lookup;
    aw.g_field = asm_field;
    for b in ai.toplevel.items() {
        asm_blob = b;
        let A = aw.assemble_file(b.text, W64);
        if aw.failed(A) {
            fail(u.f2("file-scope asm at %s: %s", b.loc, aw.message(A, true)));
            return false;
        }
        top_asms.push(A);
        top_blobs.push(b);
    }
    return true;
}

// Does file-scope asm define function `n`?
fn top_defines(n: []u8) bool {
    for f in top_heads.items() {
        if u.str_eq(f.name, n) {
            return true;
        }
    }
    return false;
}

// The imports of file-scope asm: symbols of the program's functions
// (module "env": the IR's own function of that name, or an undefined
// symbol), or the host's.
fn top_imports() void {
    for A in top_asms.items() {
        for im in A.imports.items() {
            if u.str_eq(im.module, "env") {
                let f = ir.get_function(MOD, im.name);
                if u.notnil(f) and not top_defines(im.name) {
                    // (resolved when its symbol is: fsyms, after the IR's are made)
                    continue;
                }
                if top_defines(im.name) or (top_syms.get(u.intern(im.name)) != 0) {
                    continue;
                }
            }
            let fi = @int_cast(u32, UN.fimports.len);
            let mut fl = wo.F_UNDEFINED;
            if not u.str_eq(im.module, "env") {
                fl = fl | wo.F_EXPLICIT_NAME;
            }
            UN.fimports.push(wo.Import.{ module: im.module, name: im.name, ty: wo.type_index(UN, im.params, im.results),
                                         mutable: false });
            let s = wo.add_sym(UN, wo.Sym.{ kind: wo.SYM_FUNC, flags: fl, name: im.name, index: fi, seg: 0, off: 0,
                                            size: 0 });
            if u.str_eq(im.module, "env") {
                top_syms.put(u.intern(im.name), s + 1);
            }
        }
    }
}

// The globals and tags file-scope asm imports: undefined symbols of the
// program's (module "env": the stack pointer's for __stack_pointer, the
// longjmp tag's for __axc_longjmp_tag) or the host's. The unit's defined
// globals' indices, after the imports, move up past them.
fn top_field_imports() void {
    let n0 = UN.gimports.len;
    for j in 0..top_asms.len {
        let A = top_asms.get(j);
        cur_text = @int_cast(i64, j);
        for g in A.globals.items() {
            if g.module.len == 0 {
                continue;
            }
            let env = u.str_eq(g.module, "env");
            if env and u.str_eq(g.iname, "__stack_pointer") {
                if (g.vt != ptr_vt()) or not g.mutable {
                    fail(u.f1("file-scope asm imports __stack_pointer as other than (mut %s)", aw.vt_name(ptr_vt())));
                }
                put_field(aw.FK_GLOBAL, g.name, sp_sym + 1);
                continue;
            }
            let gi = @int_cast(u32, UN.gimports.len);
            UN.gimports.push(wo.Import.{ module: g.module, name: g.iname, ty: @as(u32, g.vt), mutable: g.mutable });
            let fl = wo.F_UNDEFINED | explicit_unless(env);
            let sy = wo.add_sym(UN, wo.Sym.{ kind: wo.SYM_GLOBAL, flags: fl, name: g.iname, index: gi, seg: 0, off: 0,
                                             size: 0 });
            put_field(aw.FK_GLOBAL, g.name, sy + 1);
        }
        for t in A.tags.items() {
            if t.module.len == 0 {
                continue;
            }
            let env = u.str_eq(t.module, "env");
            if env and u.str_eq(t.iname, "__axc_longjmp_tag") and (UN.timports.len > 0) {
                put_field(aw.FK_TAG, t.name, tag_sym + 1);
                continue;
            }
            let ti = @int_cast(u32, UN.timports.len);
            UN.timports.push(wo.Import.{ module: t.module, name: t.iname, ty: wo.type_index(UN, t.params, ""),
                                         mutable: false });
            let fl = wo.F_UNDEFINED | explicit_unless(env);
            let sy = wo.add_sym(UN, wo.Sym.{ kind: wo.SYM_TAG, flags: fl, name: t.iname, index: ti, seg: 0, off: 0,
                                             size: 0 });
            put_field(aw.FK_TAG, t.name, sy + 1);
        }
    }
    let moved = @int_cast(u32, UN.gimports.len - n0);
    if moved > 0 {
        for j in 0..UN.syms.len {
            let sy = UN.syms.at_mut(j);
            if (sy.kind == wo.SYM_GLOBAL) and ((sy.flags & wo.F_UNDEFINED) == 0) {
                sy.index += moved;
            }
        }
    }
}

fn explicit_unless(env: bool) u32 {
    if env {
        return 0;
    }
    return wo.F_EXPLICIT_NAME;
}

// The fields file-scope asm defines, after its functions: globals, tags,
// passive data segments (local symbols), element segments (of the
// functions' symbols), the start function, the exports. Its globals and
// tags are external names, as its functions are.
fn top_fields() void {
    for j in 0..top_asms.len {
        let A = top_asms.get(j);
        cur_text = @int_cast(i64, j);
        for g in A.globals.items() {
            if g.module.len > 0 {
                continue;
            }
            let mut wg = wo.Global.{ vt: g.vt, mutable: g.mutable, init: @bit_cast(i64, g.lo), ik: wo.GI_CONST,
                                     hi: @bit_cast(i64, g.hi) };
            if g.ik == aw.GI_NULL {
                wg.ik = wo.GI_NULL;
            } else if g.ik == aw.GI_GET {
                // (global.get of an import: its import's index)
                let t = get_field(aw.FK_GLOBAL, g.gname);
                wg.ik = wo.GI_GET;
                wg.init = @as(i64, UN.syms.get(@as(usize, t - 1)).index);
            }
            let gi = @int_cast(u32, UN.gimports.len + UN.globals.len);
            UN.globals.push(wg);
            let mut fl = wo.F_HIDDEN | wo.F_NO_STRIP;
            if g.exp.len > 0 {
                fl = (fl | wo.F_EXPORTED) & ~wo.F_HIDDEN;
                UN.exports.push(wo.Export.{ name: g.exp, func: gi, kind: wo.EX_GLOBAL });
            }
            let sy = wo.add_sym(UN, wo.Sym.{ kind: wo.SYM_GLOBAL, flags: fl, name: g.name, index: gi, seg: 0, off: 0,
                                             size: 0 });
            put_field(aw.FK_GLOBAL, g.name, sy + 1);
        }
        for t in A.tags.items() {
            if t.module.len > 0 {
                continue;
            }
            let ti = @int_cast(u32, UN.timports.len + UN.tags.len);
            UN.tags.push(wo.type_index(UN, t.params, ""));
            let mut fl = wo.F_HIDDEN | wo.F_NO_STRIP;
            if t.exp.len > 0 {
                fl = (fl | wo.F_EXPORTED) & ~wo.F_HIDDEN;
                UN.exports.push(wo.Export.{ name: t.exp, func: ti, kind: wo.EX_TAG });
            }
            let sy = wo.add_sym(UN, wo.Sym.{ kind: wo.SYM_TAG, flags: fl, name: t.name, index: ti, seg: 0, off: 0,
                                             size: 0 });
            put_field(aw.FK_TAG, t.name, sy + 1);
        }
        for d in A.datas.items() {
            let seg = u.new.[wo.Seg]();
            seg.name = u.cat2(".data.passive.", d.name);
            seg.passive = true;
            seg.data.put(d.bytes);
            UN.segs.push(seg);
            let sy = wo.add_sym(UN, wo.Sym.{ kind: wo.SYM_DATA, flags: wo.F_LOCAL, name: d.name, index: 0,
                                             seg: @int_cast(u32, UN.segs.len - 1), off: 0,
                                             size: @as(u64, d.bytes.len) });
            put_field(aw.FK_DATA, d.name, sy + 1);
        }
    }
}

// The element segments and the start function of file-scope asm (once
// every function has its symbol).
fn top_elems() void {
    for j in 0..top_asms.len {
        let A = top_asms.get(j);
        asm_blob = top_blobs.get(j);
        cur_text = @int_cast(i64, j);
        for e in A.elems.items() {
            let we = u.new.[wo.Elem]();
            we.declare = e.declare;
            for f in e.funcs {
                let sy = asm_sym(f, true);
                if sy >= 0 {
                    we.funcs.push(@truncate(u32, @bit_cast(u64, sy)));
                }
            }
            UN.elems.push(we);
            put_field(aw.FK_ELEM, e.name, @int_cast(u32, UN.elems.len));
        }
        if A.start.len > 0 {
            if UN.start != 0 {
                fail("the unit's file-scope asm has two start functions");
                return;
            }
            let sy = asm_sym(A.start, true);
            if sy >= 0 {
                UN.start = @truncate(u32, @bit_cast(u64, sy)) + 1;
            }
        }
    }
}

// The functions of file-scope asm, after the IR's definitions: their
// symbols (external, never stripped: nothing looks into asm), and the IR's
// declarations of them.
fn top_functions() void {
    for A in top_asms.items() {
        for f in A.funcs.items() {
            let fi = @int_cast(u32, UN.fimports.len + UN.funcs.len);
            let wf = u.new.[wo.Func]();
            wf.ty = wo.type_index(UN, f.params, f.results);
            wf.name = f.name;
            wf.frame_local = -1;
            let mut fl = sym_flags_for(ir.LINK_EXTERNAL, true) | wo.F_NO_STRIP;
            if f.exp.len > 0 {
                fl = (fl | wo.F_EXPORTED) & ~wo.F_HIDDEN;
                UN.exports.push(wo.Export.{ name: f.exp, func: fi, kind: wo.EX_FUNC });
            }
            wf.sym = wo.add_sym(UN, wo.Sym.{ kind: wo.SYM_FUNC, flags: fl, name: f.name, index: fi, seg: 0, off: 0,
                                             size: 0 });
            top_syms.put(u.intern(f.name), wf.sym + 1);
            UN.funcs.push(wf);
            let irf = ir.get_function(MOD, f.name);
            if u.notnil(irf) {
                if not ir.is_decl(irf) {
                    fail(u.f1("file-scope asm defines $%s, which C or Axiom code defines too", f.name));
                }
                fsyms.set(@int_cast(usize, irf.id), wf.sym);
            }
        }
    }
    // (an "env" import of a function the IR has: that function's symbol)
    for A in top_asms.items() {
        for im in A.imports.items() {
            if u.str_eq(im.module, "env") and (top_syms.get(u.intern(im.id)) == 0) {
                let f = ir.get_function(MOD, im.name);
                let s = top_syms.get(u.intern(im.name));
                if s != 0 {
                    top_syms.put(u.intern(im.id), s);
                } else if u.notnil(f) {
                    top_syms.put(u.intern(im.id), fsyms.get(@int_cast(usize, f.id)) + 1);
                }
            } else if not u.str_eq(im.module, "env") {
                // (a host function: its import's symbol)
                for j in 0..UN.syms.len {
                    let sy = UN.syms.get(j);
                    if (sy.kind == wo.SYM_FUNC) and ((sy.flags & wo.F_EXPLICIT_NAME) != 0) and
                       u.str_eq(sy.name, im.name) {
                        top_syms.put(u.intern(im.id), @int_cast(u32, j) + 1);
                    }
                }
            }
        }
    }
}

// Their code: the text's bodies with relocations.
fn top_code() void {
    let nir = UN.funcs.len;
    let mut k = nir;
    for A in top_asms.items() {
        k -= A.funcs.len;
    }
    for j in 0..top_asms.len {
        let A = top_asms.get(j);
        asm_blob = top_blobs.get(j);
        cur_text = @int_cast(i64, j);
        for f in A.funcs.items() {
            let wf = UN.funcs.get(k);
            k += 1;
            let mut rl = u.List.[wo.Reloc].empty();
            asm_relocs(&mut f.code, 0, f.fixes.items(), ir.vnil(), &mut rl);
            wf.body = f.code;
            for r in rl.items() {
                wf.relocs.push(r);
            }
            if A.uses_table {
                UN.uses_table = true;
            }
        }
    }
}
