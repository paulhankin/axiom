    FLOAT_FROM_INT = 9,
    FLOAT_CAST = 10,
    BIT_CAST = 11,
    INT_FROM_PTR = 12,
    PTR_FROM_INT = 13,
    PTR_CAST = 14,
    SLICE_FROM_PTR = 15,
    CAST_SLICE = 16,
    MEM_COPY = 17,
    MEM_SET = 18,
    MEM_EQ = 19,
    SWAP = 20,
    MEMORY_SIZE = 21,
    MEMORY_GROW = 22,
    CLZ = 23,
    CTZ = 24,
    POPCOUNT = 25,
    ROTL = 26,
    ROTR = 27,
    ADD_SAT = 28,
    SUB_SAT = 29,
    MUL_SAT = 30,
    ADD_CHECKED = 31,
    SUB_CHECKED = 32,
    MUL_CHECKED = 33,
    MIN = 34,
    MAX = 35,
    ABS = 36,
    SQRT = 37,
    FLOOR = 38,
    CEIL = 39,
    TRUNC = 40,
    NEAREST = 41,
    FMA = 42,
    REM = 43,
    COPYSIGN = 44,
    SPLAT = 45,
    VEC = 46,
    EXTRACT_LANE = 47,
    REPLACE_LANE = 48,
    LOAD = 49,
    STORE = 50,
    SHUFFLE = 51,
    SWIZZLE = 52,
    LANES_EQ = 53,
    LANES_NE = 54,
    LANES_LT = 55,
    LANES_LE = 56,
    LANES_GT = 57,
    LANES_GE = 58,
    SELECT = 59,
    ANY_TRUE = 60,
    ALL_TRUE = 61,
    BITMASK = 62,
    REDUCE_ADD = 63,
    DOT = 64,
    TRAP = 65,
    ATOMIC_LOAD = 66,
    ATOMIC_STORE = 67,
    ATOMIC_ADD = 68,
    ATOMIC_SUB = 69,
    ATOMIC_AND = 70,
    ATOMIC_OR = 71,
    ATOMIC_XOR = 72,
    ATOMIC_XCHG = 73,
    ATOMIC_MIN = 74,
    ATOMIC_MAX = 75,
