// A new expression of kind k: its kind's record too.
fn new_record(e: *mut Expr) void {
    match e.kind {
        .IDENT        => { e.x = @int_from_ptr(u.tree_new.[XIdent]()); }
        .INT          => { e.x = @int_from_ptr(u.tree_new.[XInt]()); }
        .ARRAY_LIT    => { e.x = @int_from_ptr(u.tree_new.[XArrayLit]()); }
        .ARRAY_REPEAT => { e.x = @int_from_ptr(u.tree_new.[XArrayRepeat]()); }
        .ERROR_VAL    => { e.x = @int_from_ptr(u.tree_new.[XErrorVal]()); }
        .UNARY        => { e.x = @int_from_ptr(u.tree_new.[XUnary]()); }
        .BINARY       => { e.x = @int_from_ptr(u.tree_new.[XBinary]()); }
        .FIELD        => { e.x = @int_from_ptr(u.tree_new.[XField]()); }
        .CALL         => { e.x = @int_from_ptr(u.tree_new.[XCall]()); }
        .INDEX        => { e.x = @int_from_ptr(u.tree_new.[XIndex]()); }
        .SLICE        => { e.x = @int_from_ptr(u.tree_new.[XSlice]()); }
        .CONV         => { e.x = @int_from_ptr(u.tree_new.[XConv]()); }
        else => {}
    }
}

// A copy of e, with records of its own.
pub fn copy_expr(e: *Expr) *mut Expr {
    let c = u.tree_new.[Expr]();
    c.* = e.*;
    match e.kind {
        .IDENT => {
            let r = u.tree_new.[XIdent]();
            r.* = x_ident(e).*;
            c.x = @int_from_ptr(r);
        }
        .INT => {
            let r = u.tree_new.[XInt]();
            r.* = x_int(e).*;
            c.x = @int_from_ptr(r);
        }
        .ARRAY_LIT => {
            let r = u.tree_new.[XArrayLit]();
            r.* = x_array_lit(e).*;
            c.x = @int_from_ptr(r);
        }
        .ARRAY_REPEAT => {
            let r = u.tree_new.[XArrayRepeat]();
            r.* = x_array_repeat(e).*;
            c.x = @int_from_ptr(r);
        }
        .ERROR_VAL => {
            let r = u.tree_new.[XErrorVal]();
            r.* = x_error_val(e).*;
            c.x = @int_from_ptr(r);
        }
        .UNARY => {
            let r = u.tree_new.[XUnary]();
            r.* = x_unary(e).*;
            c.x = @int_from_ptr(r);
        }
        .BINARY => {
            let r = u.tree_new.[XBinary]();
            r.* = x_binary(e).*;
            c.x = @int_from_ptr(r);
        }
        .FIELD => {
            let r = u.tree_new.[XField]();
            r.* = x_field(e).*;
            c.x = @int_from_ptr(r);
        }
        .CALL => {
            let r = u.tree_new.[XCall]();
            r.* = x_call(e).*;
            c.x = @int_from_ptr(r);
        }
        .INDEX => {
            let r = u.tree_new.[XIndex]();
            r.* = x_index(e).*;
            c.x = @int_from_ptr(r);
        }
        .SLICE => {
            let r = u.tree_new.[XSlice]();
            r.* = x_slice(e).*;
            c.x = @int_from_ptr(r);
        }
        .CONV => {
            let r = u.tree_new.[XConv]();
            r.* = x_conv(e).*;
            c.x = @int_from_ptr(r);
        }
        else => {}
    }
    if u.notnil(e.more) {
        let m = u.tree_new.[ExprMore]();
        m.* = e.more.*;
        c.more = m;
    }
    return c;
}

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------
// A match arm's pattern, as written.
pub union Pattern {
    Variant: VariantPattern,  // .NAME or .Name(bind)
    Error: []u8,              // error.Name
    Int: u.I128,              // an integer or character literal
    Bool: bool,
    Else,
}

pub struct VariantPattern {
    pub name: []u8,
    pub bind: []u8,  // or no string
    pub bind_span: u.Span,
}

pub struct MatchArm {
    pub pat: Pattern,
    pub span: u.Span,
    pub alt: bool,  // another pattern of the arm before it (`p1, p2 => ...`): same body
    pub body: *mut Stmt,
    // sema
    pub bind_local: *mut Local,
    pub variant: i32,     // Variant: the variant's or member's index
    pub value: u.I128,    // Variant of an enum: the member's value
    pub error_code: u32,  // Error

    pub fn is_else(self: *MatchArm) bool {
        match self.pat {
            .Else => { return true; }
            else  => { return false; }
        }
    }
}

// A statement. Its fields are in order of size, and what only a few kinds of
// statement have is in `more` (stmt_ext), as for Expr.
pub struct Stmt {
    pub name: []u8,  // let / for variable
    pub te: *mut TypeExpr,
    pub e: *mut Expr,
    pub e2: *mut Expr,
    pub body: *mut Stmt,
    pub els: *mut Stmt,
    pub stmts: u.List.[*mut Stmt],
    pub more: *mut StmtMore,  // nil until stmt_ext(s)
    // sema
    pub local: *mut Local,
    pub span: u.Span,
    pub name_span: u.Span,
    pub op: lx.TokKind,   // assign op TokKind
    pub jump_depth: i32,  // break / continue: loops left (0: the innermost)
    pub kind: StmtKind,
    pub is_mut: bool,
    pub undef: bool,  // let ... = undefined (§8.1): `e` is that identifier, its bytes left unspecified
    pub diverges: bool,
}

// The fields of a Stmt that few kinds of statement have.
pub struct StmtMore {
    pub arms: u.List.[MatchArm],
    pub label: []u8,  // a loop's label; break / continue: the label named, if any
    pub label_span: u.Span,
    pub e3: *mut Expr,   // a compound assignment: the operation, as a binary expression (sema)
    pub on_error: bool,  // defer: an errdefer, run only when the function returns an error
    pub ref_iter: bool,  // for &x / for &mut x
    pub ref_mut: bool,   // for &mut x
}

// s's StmtMore, to change: made (all zero) the first time.
pub fn stmt_ext(s: *mut Stmt) *mut StmtMore {
    if u.isnil(s.more) {
        s.more = u.tree_new.[StmtMore]();
    }
    return s.more;
}

threadlocal let mut no_stmt_more: *mut StmtMore = @ptr_from_int(*mut StmtMore, 0);

pub fn stmt_more_ro(s: *mut Stmt) *mut StmtMore {
    if u.notnil(s.more) {
        return s.more;
    }
    if u.isnil(no_stmt_more) {
        no_stmt_more = u.perm_new.[StmtMore]();
    }
    return no_stmt_more;
}

// s's StmtMore, to read: all zero if it has none.
pub fn stmt_more(s: *Stmt) *StmtMore {
    if u.notnil(s.more) {
        return s.more;
    }
    if u.isnil(no_stmt_more) {
        no_stmt_more = u.perm_new.[StmtMore]();
    }
    return no_stmt_more;
}

// ---------------------------------------------------------------------------
// Declarations
// ---------------------------------------------------------------------------
pub struct GenericParam {
    pub name: []u8,
    pub span: u.Span,
    pub constraint: []u8,  // nil if unconstrained
    pub constraint_span: u.Span,
    pub constraint_te: *mut TypeExpr,
    pub is_const: bool,
    pub const_te: *mut TypeExpr,
    pub ty: *mut Type,  // TY_PARAM
}

pub struct Param {
    pub name: []u8,
    pub span: u.Span,
    pub te: *mut TypeExpr,
    pub local: *mut Local,
    pub is_noalias: bool,
    pub noalias_span: u.Span,
}

pub struct Variant {
    pub name: []u8,
    pub span: u.Span,
    pub te: *mut TypeExpr,  // nil: no payload
    pub ty: *mut Type,
    // enum members
    pub has_value: bool,  // `= value` given
    pub value: u.I128,    // after sema: the member's value
    pub value_span: u.Span,
}

pub struct Local {
    pub name: []u8,
    pub span: u.Span,
    pub ty: *mut Type,
    pub is_mut: bool,
    pub is_param: bool,
    pub addr_taken: bool,
    pub weakened: bool,
    pub moved: bool,
    pub moved_span: u.Span,
    pub index: i32,  // within its function
}

pub struct Decl {
    pub kind: DeclKind,
    pub span: u.Span,
    pub name: []u8,
    pub name_span: u.Span,
    pub is_pub: bool,
    pub is_export: bool,
    pub module: *mut Module,
    pub gparams: u.List.[GenericParam],
    pub fields: u.List.[Field],
    pub variants: u.List.[Variant],
    pub methods: u.List.[*mut Decl],
    pub method_map: u.SymMap.[*mut Decl],
    pub owner: *mut Decl,  // method -> struct/union/enum decl
    pub params: u.List.[Param],
    pub ret_te: *mut TypeExpr,
    pub body: *mut Stmt,
    pub te: *mut TypeExpr,  // const / global type; enum representation type (nil: default)
    pub init: *mut Expr,
    pub is_mut: bool,
    pub is_tls: bool,  // D_GLOBAL: threadlocal (one per thread)
    pub import_path: []u8,
    pub import_path_span: u.Span,
    pub imported: *mut Module,
    pub host_module: []u8,  // D_HOST_FN from `import host "mod"`; nil for extern "C"
    pub extern_c: bool,     // declared in an extern "C" block
    pub cabi: bool,         // a C function (extern "C" or export) with a structure by value: its C symbol is a wrapper's (spec §14.5.3)
    pub variadic: bool,     // C varargs: `...` after the fixed parameters
    pub link_lib: []u8,     // extern "C" "lib": library to link
    pub abi: []u8,
    pub is_inline: bool,  // `inline fn`: always inlined (spec §9.5)
    pub inline_span: u.Span,
    pub inline_callees: u.List.[*mut Decl],  // inline functions this one calls directly (sema)
    pub inline_call_spans: u.List.[u.Span],
    pub inline_mark: i32,  // sema: visited by the cycle check
    pub is_test: bool,     // `test "name" { }` (a D_FN returning !void)
    pub test_name: []u8,
    pub test_trap: i32,  // -1: must not trap; -2: must trap; n >= 0: must trap with Tn
    pub abi_span: u.Span,
    pub error_names: u.List.[[]u8],
    pub error_spans: u.List.[u.Span],
    pub error_refs: u.List.[*mut TypeExpr],  // D_ERROR: the sets a named set includes (error S = A | B;)
    pub set_names: u.List.[[]u8],            // D_ERROR with a name: every name of the set (sema)
    // fn attribute: @features("a,b") or @multiversion("a,b", "c") after the return type
    pub attr: Attr,  // ATTR_*
    pub attr_span: u.Span,
    pub attr_args: u.List.[[]u8],
    pub attr_arg_spans: u.List.[u.Span],

    // ---- sema ----
    pub state: DeclState,
    pub ty: *mut Type,  // fn: TY_FN signature; const/global: value type; struct/union: Self type
    pub ret_type: *mut Type,
    pub param_types: []mut *mut Type,
    pub locals: u.List.[*mut Local],
    pub all_gparams: []mut *mut Type,  // TY_PARAM types, owner's first
    pub self_kind: SelfMode,           // for methods: SELF_VALUE (Self), SELF_ADDR (*Self), SELF_PASS (*mut Self); NONE if not a method
    pub checked: bool,
    layout_done: bool,
    pub gparams_done: bool,
    pub gparams_resolving: bool,
    pub is_nocopy: bool,
    pub nocopy_visiting: bool,
    pub anon: bool,
    pub cexpr: *mut Expr,      // const: checked init expression
    pub feat_sets: []mut u64,  // fn with an attribute: the extensions each version adds (closed under implication)
}

pub struct Module {
    pub file: *mut u.SourceFile,
    pub path: []u8,
    pub decls: u.List.[*mut Decl],
    pub names: u.SymMap.[*mut Decl],    // top-level names (items, not imports)
    pub imports: u.SymMap.[*mut Decl],  // alias -> Decl(D_IMPORT)
    pub pkg: *mut pkg.Package,          // the package this module belongs to, or nil
    checked: bool,
    // Checked before, and kept (axiom lsp's session: modl.admit): a run
    // takes it as it is.
    pub base: bool,
    pub error_uses: u.List.[[]u8],  // the error names its code names (modl.clean)
}

// ---------------------------------------------------------------------------
// Semantic types. Types are hash-consed: equal types are the same pointer.
// ---------------------------------------------------------------------------
pub struct Type {
    pub kind: TyKind,
    pub id: i32,
    pub bits: i32,                // INT / FLOAT; VEC: lane bits
    pub is_signed: bool,          // INT; VEC with int lanes
    pub is_size: bool,            // usize / isize
    pub lanes: i32,               // VEC
    pub elem: *mut Type,          // PTR, SLICE, ARRAY, ERRUNION, VEC (lane type)
    pub is_mut: bool,             // PTR, SLICE
    pub len: i64,                 // ARRAY
    pub len_param: *mut Type,     // ARRAY whose length is a const generic parameter
    pub params: []mut *mut Type,  // FN
    pub ret: *mut Type,
    pub decl: *mut Decl,  // STRUCT, UNION
    pub args: []mut *mut Type,
    // PARAM
    pub owner: *mut Decl,
    pub pindex: i32,
    pub constraint: i32,
    pub constraint_lane: *mut Type,
    pub is_const: bool,
    pub const_type: *mut Type,
    pub name: []u8,
    pub cval: i64,         // CONSTINT
    pub has_params: bool,  // mentions a TY_PARAM somewhere
    // layout cache
    pub size: i64,
    pub align: i64,
    pub layout_done: bool,
    pub size_checked: bool,  // codegen: an instance's type, checked against the largest object
    pub backend: *mut void,  // codegen type cache
}

pub struct Target {
    pub ptr_bits: i32,  // 32 or 64
    pub is_wasm: bool,
    pub triple: []u8,
}

// A catch's handler value (catch <value>, catch return <value>) or block;
// nil if it has none.
pub fn handler_expr(e: *Expr) *mut Expr {
    match more(e).handler {
        .Value(h)  => { return h; }
        .Return(h) => { return h; }
        else       => { return u.nil.[Expr](); }
    }
}

pub fn handler_block(e: *Expr) *mut Stmt {
    match more(e).handler {
        .Block(blk) => { return blk; }
        else        => { return u.nil.[Stmt](); }
    }
}

// Constructors for zeroed nodes.
pub fn new_te(sh: TypeShape, sp: u.Span) *mut TypeExpr {
    let t = u.tree_new.[TypeExpr]();
    t.shape = sh;
    t.span = sp;
    return t;
}

pub fn new_expr(k: ExprKind, sp: u.Span) *mut Expr {
    let e = u.tree_new.[Expr]();
    e.kind = k;
    e.span = sp;
    new_record(e);
    return e;
}

pub fn new_stmt(k: StmtKind, sp: u.Span) *mut Stmt {
    let s = u.tree_new.[Stmt]();
    s.kind = k;
    s.span = sp;
    return s;
}
