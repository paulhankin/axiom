pub fn builtin_name(i: BuiltinId) []u8 {
    return builtins[@int_cast(usize, @int_from_enum(i))].name;
}

pub fn builtin_sig(i: BuiltinId) []u8 {
    return builtins[@int_cast(usize, @int_from_enum(i))].sig;
}

pub fn builtin_lookup(name: []u8) BuiltinId {
    for i in 0..BI_COUNT {
        let b = @enum_from_int(BuiltinId, i);
        if u.str_eq(builtin_name(b), name) {
            return b;
        }
    }
    return BI_UNKNOWN;
}

// id's place after first (0 for first itself), for tables in their order.
pub fn builtin_index(id: BuiltinId, first: BuiltinId) i32 {
    return @int_from_enum(id) - @int_from_enum(first);
}

// Is id one of lo .. hi (in their order here)?
pub fn builtin_between(id: BuiltinId, lo: BuiltinId, hi: BuiltinId) bool {
    let k = @int_from_enum(id);
    return (k >= @int_from_enum(lo)) and (k <= @int_from_enum(hi));
}

// ---------------------------------------------------------------------------
// Type expressions (syntax of types)
// ---------------------------------------------------------------------------
pub struct Field {
    pub name: []u8,
    pub te: *mut TypeExpr,
    pub span: u.Span,
    pub ty: *mut Type,
    pub is_pub: bool,
}

pub struct TypeExpr {
    pub span: u.Span,
    pub shape: TypeShape,
}

// A type expression, as written.
pub union TypeShape {
    Prim: i32,  // a lexer PRIM_ code
    Named: NamedType,
    Ptr: PtrType,
    Slice: PtrType,
    Array: ArrayType,
    Fn: FnType,
    AnonStruct: u.List.[Field],
    ErrUnion: ErrUnionType,  // !T, or Set!T
    Opt: *mut TypeExpr,      // ?T
    Error,
    Invalid,               // what the parser makes of a type it could not read (reported already)
    SelfType,              // Self
    IntLit: u64,           // a generic argument or array length
    ConstExpr: *mut Expr,  // an array length that is a constant expression
}

// !T (set nil: any error) or Set!T (set: a Named type naming an error set).
pub struct ErrUnionType {
    pub set: *mut TypeExpr,
    pub elem: *mut TypeExpr,
}

// [mod.]Name, with generic arguments if has_args, and optional associated member.
pub struct NamedType {
    pub qual: []u8,  // module qualifier, or no string
    pub name: []u8,
    pub name_span: u.Span,
    pub args: u.List.[*mut TypeExpr],
    pub has_args: bool,
    pub has_member: bool,
    pub member: []u8,
    pub member_span: u.Span,
    pub member_args: u.List.[*mut TypeExpr],
    pub has_member_args: bool,
}

// *T, *mut T, []T or []mut T.
pub struct PtrType {
    pub elem: *mut TypeExpr,
    pub is_mut: bool,
}

pub struct ArrayType {
    pub elem: *mut TypeExpr,
    pub len: *mut TypeExpr,  // IntLit, Named (a const or a const parameter) or ConstExpr
}

pub struct FnType {
    pub params: u.List.[*mut TypeExpr],
    pub ret: *mut TypeExpr,
}

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------
pub struct FieldInit {
    pub name: []u8,
    pub span: u.Span,
    pub value: *mut Expr,
}

pub struct BuiltinArg {
    pub e: *mut Expr,
    pub t: *mut TypeExpr,
}

// An expression. Its fields are in order of size. What only some kinds of
// expression have is in a record for the kind (x: XIdent, XCall, ..., made
// with the expression), read with <field>_of(e) and set with set_<field>(e,
// v) or through <field>_mut(e); a field a kind's record does not have is in
// `more` (ext), as are the fields that few kinds have at all (a zero set
// there makes no ExprMore: it reads as zero anyway). So the many
// identifiers, operators, calls and literals stay small.
pub struct Expr {
    pub name: []u8,
    pub a: *mut Expr,
    pub ty: *mut Type,
    x: usize,                 // the kind's record (x_ident(e), ...), or 0
    pub more: *mut ExprMore,  // nil until ext(e)
    pub span: u.Span,
    pub kind: ExprKind,
    pub cat: Cat,
    pub parens: bool,
    pub bval: bool,
    pub is_const: bool,  // cval / fval valid
    pub weakened: bool,
}

// The fields of an Expr that few kinds of expression have, and those of the
// others that its kind's record does not.
pub struct ExprMore {
    pub float_text: []u8,
    pub str: []u8,
    pub inits: u.List.[FieldInit],
    pub bargs: u.List.[BuiltinArg],
    pub targs: u.List.[*mut TypeExpr],
    // catch
    pub capture: []u8,
    pub capture_span: u.Span,
    pub handler: Handler,
    pub capture_local: *mut Local,
    cval: u.I128,  // folded integer constant (untyped / const refs)
    args: u.List.[*mut Expr],
    gargs: []mut *mut Type,  // CAT_FUNC / call: generic args (owner args ++ own args)
    b: *mut Expr,
    c: *mut Expr,
    ival: u64,
    fval: f64,
    local: *mut Local,  // ident -> local
    decl: *mut Decl,    // ident/field -> global/const/fn/type decl; call -> callee fn
    module: *mut Module,
    tval: *mut Type,  // CAT_TYPE: the type; E_BUILTIN: type argument
    name_span: u.Span,
    op: lx.TokKind,      // E_UNARY, E_BINARY: the operator's token kind
    index: i32,          // field index / variant index
    builtin: BuiltinId,  // E_BUILTIN (BI_UNKNOWN if no builtin has its name)
    conv: Conv,
    call_kind: CallKind,
    field_kind: FieldKind,
    index_kind: IndexKind,
    self_mode: SelfMode,
}

// e's ExprMore, to change: made (all zero, as a new Expr's fields are) the
// first time.
pub fn ext(e: *mut Expr) *mut ExprMore {
    if u.isnil(e.more) {
        e.more = u.tree_new.[ExprMore]();
    }
    return e.more;
}

threadlocal let mut no_more: *mut ExprMore = @ptr_from_int(*mut ExprMore, 0);

pub fn more_ro(e: *mut Expr) *mut ExprMore {
    if u.notnil(e.more) {
        return e.more;
    }
    if u.isnil(no_more) {
        no_more = u.perm_new.[ExprMore]();
    }
    return no_more;
}

// e's ExprMore, to read: all zero if it has none.
pub fn more(e: *Expr) *ExprMore {
    if u.notnil(e.more) {
        return e.more;
    }
    if u.isnil(no_more) {
        no_more = u.perm_new.[ExprMore]();
    }
    return no_more;
}

pub struct XIdent {
    decl: *mut Decl,    // ident/field -> global/const/fn/type decl; call -> callee fn
    local: *mut Local,  // ident -> local
    module: *mut Module,
}

fn x_ident(e: *Expr) *mut XIdent {
    return @ptr_from_int(*mut XIdent, e.x);
}

pub struct XInt {
    cval: u.I128,  // folded integer constant (untyped / const refs)
    ival: u64,
}

fn x_int(e: *Expr) *mut XInt {
    return @ptr_from_int(*mut XInt, e.x);
}

pub struct XArrayLit {
    args: u.List.[*mut Expr],
}

fn x_array_lit(e: *Expr) *mut XArrayLit {
    return @ptr_from_int(*mut XArrayLit, e.x);
}

pub struct XArrayRepeat {
    b: *mut Expr,
}

fn x_array_repeat(e: *Expr) *mut XArrayRepeat {
    return @ptr_from_int(*mut XArrayRepeat, e.x);
}

pub struct XErrorVal {
    cval: u.I128,  // folded integer constant (untyped / const refs)
    name_span: u.Span,
}

fn x_error_val(e: *Expr) *mut XErrorVal {
    return @ptr_from_int(*mut XErrorVal, e.x);
}

pub struct XUnary {
    cval: u.I128,    // folded integer constant (untyped / const refs)
    op: lx.TokKind,  // E_UNARY, E_BINARY: the operator's token kind
}

fn x_unary(e: *Expr) *mut XUnary {
    return @ptr_from_int(*mut XUnary, e.x);
}

pub struct XBinary {
    b: *mut Expr,
    op: lx.TokKind,  // E_UNARY, E_BINARY: the operator's token kind
}

fn x_binary(e: *Expr) *mut XBinary {
    return @ptr_from_int(*mut XBinary, e.x);
}

pub struct XField {
    cval: u.I128,            // folded integer constant (untyped / const refs)
    gargs: []mut *mut Type,  // CAT_FUNC / call: generic args (owner args ++ own args)
    b: *mut Expr,
    decl: *mut Decl,  // ident/field -> global/const/fn/type decl; call -> callee fn
    fval: f64,
    name_span: u.Span,
    index: i32,  // field index / variant index
    field_kind: FieldKind,
    self_mode: SelfMode,
}

fn x_field(e: *Expr) *mut XField {
    return @ptr_from_int(*mut XField, e.x);
}

pub struct XCall {
    args: u.List.[*mut Expr],
    gargs: []mut *mut Type,  // CAT_FUNC / call: generic args (owner args ++ own args)
    b: *mut Expr,
    decl: *mut Decl,  // ident/field -> global/const/fn/type decl; call -> callee fn
    call_kind: CallKind,
    self_mode: SelfMode,
}

fn x_call(e: *Expr) *mut XCall {
    return @ptr_from_int(*mut XCall, e.x);
}

pub struct XIndex {
    b: *mut Expr,
    index_kind: IndexKind,
}

fn x_index(e: *Expr) *mut XIndex {
    return @ptr_from_int(*mut XIndex, e.x);
}

pub struct XSlice {
    b: *mut Expr,
    c: *mut Expr,
    index_kind: IndexKind,
}

fn x_slice(e: *Expr) *mut XSlice {
    return @ptr_from_int(*mut XSlice, e.x);
}

pub struct XConv {
    conv: Conv,
}

fn x_conv(e: *Expr) *mut XConv {
    return @ptr_from_int(*mut XConv, e.x);
}

pub fn cval_of(e: *Expr) u.I128 {
    match e.kind {
        .INT       => { return x_int(e).cval; }
        .ERROR_VAL => { return x_error_val(e).cval; }
        .UNARY     => { return x_unary(e).cval; }
        .FIELD     => { return x_field(e).cval; }
        else       => { return more(e).cval; }
    }
}

pub fn set_cval(e: *mut Expr, v: u.I128) void {
    match e.kind {
        .INT       => { x_int(e).cval = v; }
        .ERROR_VAL => { x_error_val(e).cval = v; }
        .UNARY     => { x_unary(e).cval = v; }
        .FIELD     => { x_field(e).cval = v; }
        else => {
            if u.notnil(e.more) or not ((v.lo == 0) and (v.hi == 0)) {
                ext(e).cval = v;
            }
        }
    }
}

pub fn cval_mut(e: *mut Expr) *mut u.I128 {
    match e.kind {
        .INT       => { return &mut x_int(e).cval; }
        .ERROR_VAL => { return &mut x_error_val(e).cval; }
        .UNARY     => { return &mut x_unary(e).cval; }
        .FIELD     => { return &mut x_field(e).cval; }
        else       => { return &mut ext(e).cval; }
    }
}

pub fn args_of(e: *Expr) u.List.[*mut Expr] {
    match e.kind {
        .ARRAY_LIT => { return x_array_lit(e).args; }
        .CALL      => { return x_call(e).args; }
        else       => { return more(e).args; }
    }
}

pub fn set_args(e: *mut Expr, v: u.List.[*mut Expr]) void {
    match e.kind {
        .ARRAY_LIT => { x_array_lit(e).args = v; }
        .CALL      => { x_call(e).args = v; }
        else => {
            if u.notnil(e.more) or not ((v.len == 0) and (v.cap == 0)) {
                ext(e).args = v;
            }
        }
    }
}

pub fn args_mut(e: *mut Expr) *mut u.List.[*mut Expr] {
    match e.kind {
        .ARRAY_LIT => { return &mut x_array_lit(e).args; }
        .CALL      => { return &mut x_call(e).args; }
        else       => { return &mut ext(e).args; }
    }
}

pub fn gargs_of(e: *mut Expr) []mut *mut Type {
    match e.kind {
        .FIELD => { return x_field(e).gargs; }
        .CALL  => { return x_call(e).gargs; }
        else   => { return more_ro(e).gargs; }
    }
}

pub fn set_gargs(e: *mut Expr, v: []mut *mut Type) void {
    match e.kind {
        .FIELD => { x_field(e).gargs = v; }
        .CALL  => { x_call(e).gargs = v; }
        else => {
            if u.notnil(e.more) or not ((v.len == 0) and (@int_from_ptr(v.ptr) == 0)) {
                ext(e).gargs = v;
            }
        }
    }
}

pub fn gargs_mut(e: *mut Expr) *mut []mut *mut Type {
