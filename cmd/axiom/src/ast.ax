    ERROR_NAME = 82,
    MEMORY_DISCARD = 83,
    SANITIZE_ADDRESS = 84,
    MEMORY_ERROR = 85,
    INT_FROM_ENUM = 86,
    ENUM_FROM_INT = 87,
    TARGET_HAS = 88,
    TARGET_ARCH = 89,
    TARGET_OS = 90,
    CPU_HAS = 91,
    X86_CPUID = 92,
    X86_XGETBV = 93,
    // processor instructions (spec §13.5): AES, carry-less multiply, SHA, CRC32
    X86_AESENC = 94,
    X86_AESENCLAST = 95,
    X86_AESDEC = 96,
    X86_AESDECLAST = 97,
    X86_AESIMC = 98,
    X86_AESKEYGENASSIST = 99,
    X86_CLMUL = 100,
    X86_SHA1RNDS4 = 101,
