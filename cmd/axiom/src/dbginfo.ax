// =============================================================================
// dbginfo.ax - what the front ends tell the debug information (dwarf.ax)
// beyond the IR, with -g: the source names of functions whose symbols are
// not (C's internal functions, numbered apart; C's main).
// =============================================================================
import "ir.ax" as ir;
import "util.ax" as u;

/// Variables have locations (at -O0: backend.ax sets it).
pub threadlocal let mut locations: bool = false;

/// A C program's __STDC_VERSION__ (0: C89), -1: not C.
pub threadlocal let mut c_version: i64 = -1;

// IR function name (interned) -> its name in the source
threadlocal let mut names: u.SymMap.[[]u8] = u.SymMap.[[]u8].{ keys: @ptr_from_int(*mut usize, 0),
                                                               vals: @ptr_from_int(*mut []u8, 0), cap: 0, len: 0 };

/// Records that IR function `ir_name` is `name` in the source.
pub fn note_func_name(ir_name: []u8, name: []u8) void {
    names.put(u.intern(ir_name), u.intern(name));
}

/// The source name of IR function `ir_name`, or `dflt` if none was noted.
pub fn func_name(ir_name: []u8, dflt: []u8) []u8 {
    let n = names.get(u.intern(ir_name));
    if n.len > 0 {
        return n;
    }
    return dflt;
}

// -----------------------------------------------------------------------------
// Types and variables (DEBUG_FULL): what the C front end (c/cgen_debug.ax)
// describes of a program's types, functions' variables and globals, for
// dwarf.ax to write as DWARF entries. Types are numbered (indexes in
// `types`); -1 is void.
// -----------------------------------------------------------------------------
pub const DK_BASE: u8 = 1;
pub const DK_POINTER: u8 = 2;
pub const DK_CONST: u8 = 3;
pub const DK_VOLATILE: u8 = 4;
pub const DK_RESTRICT: u8 = 5;
pub const DK_ATOMIC: u8 = 6;
pub const DK_ARRAY: u8 = 7;
pub const DK_STRUCT: u8 = 8;
pub const DK_UNION: u8 = 9;
pub const DK_ENUM: u8 = 10;
pub const DK_TYPEDEF: u8 = 11;
pub const DK_FUNC: u8 = 12;
pub const DK_TAGGED: u8 = 13;  // a tagged union: members[0] the tag, the others its variants (value: the tag's)

// Base type encodings (DWARF 5, 7.8: DW_ATE_*)
pub const ATE_BOOLEAN: u8 = 2;
pub const ATE_COMPLEX_FLOAT: u8 = 3;
pub const ATE_FLOAT: u8 = 4;
pub const ATE_SIGNED: u8 = 5;
pub const ATE_SIGNED_CHAR: u8 = 6;
pub const ATE_UNSIGNED: u8 = 7;
pub const ATE_UNSIGNED_CHAR: u8 = 8;
pub const ATE_DECIMAL_FLOAT: u8 = 15;  // (DWARF 5 7.8: IEEE 754's decimal formats)
pub const ATE_COMPLEX_INT: u8 = 0x80;  // (DW_ATE_lo_user: a complex integer type, as other compilers mark one)

/// A member of a structure or union (bits > 0: a bit-field, bit_off bits
/// past `off` bytes, from the least significant bit), an enumerator
/// (value), or a function type's parameter (ty).
pub struct DMember {
    name: []u8,
    ty: i32,
    off: u64,
    bits: i32,
    bit_off: i32,
    value: i64,
    wide: []u64,  // an enumerator wider than 64 bits: its value's limbs, two's complement, low first (else empty)
}

pub struct DType {
    kind: u8,
    name: []u8,  // (empty: none)
    size: u64,
    enc: u8,      // DK_BASE: ATE_*
    target: i32,  // pointer, qualifier, array (element), typedef, enumeration (its integer type), function (result)
    count: i64,   // DK_ARRAY: the number of elements, -1: not known (incomplete, a VLA)
    members: u.List.[DMember],
    variadic: bool,  // DK_FUNC
    proto: bool,
    complete: bool,  // DK_STRUCT, DK_UNION, DK_ENUM
    src: u32,        // where it is declared (structures, unions, enumerations, typedefs)
    scope: u32,      // the lexical block (scopes) it is declared in; 0: the unit's top level
    bits: i32,       // DK_BASE: the width in bits, if less than the size's (a bit-precise integer); else 0
    count_var: i32,  // DK_ARRAY of variable length: its length's variable, an index in its function's vars (-1: none)
}

/// A variable: a function's (alloca: its object, for its location at -O0),
/// or a static one (global: its datum), named in the source.
pub struct DVar {
    name: []u8,
    ty: i32,
    src: u32,
    alloca: *mut ir.Value,
    alloca_id: i32,  // (the alloca's id: values are reused, an id is not)
    global: *mut ir.Global,
    param: bool,
    external: bool,
    scope: u32,        // the lexical block it is declared in (scopes; its function's root for one at the top)
    indirect: bool,    // the object holds the variable's address (a parameter passed by reference, a VLA)
    gidx: i32,         // a block-scope static: its index in `globals` (written there if its block is not)
    artificial: bool,  // made by the compiler (a VLA's length: DType.count_var)
    // optimized code (opt.vars_before): 0 if its object was promoted (its
    // values are the marks, ir.dbg_mark; -1: not); or the stores to its
    // object, one left in memory (dbg_refs [stores, stores + nstores))
    track: i32,
    stores: i32,
    nstores: i32,
    seen: bool,  // (track_vars has looked at it)
}

/// A lexical block of a function (C's block scopes; DWARF's
/// DW_TAG_lexical_block), or its root (the function's outermost scope,
/// parent 0). Index 0 of `scopes` is no scope.
pub struct DScope {
    parent: u32,
    func: []u8,           // its function's IR name (interned); an inline instance's: the inlined function's
    types: u.List.[i32],  // the types declared in it (DType.scope)
    // Inlining (inline.ax) copies the scopes of the code it copies: the root
    // of an inline instance (`inl`) is the inlined function's root in the
    // caller, a child of the call's scope, `call` the call's location; a
    // copy of another scope (`orig`: the scope copied, which may itself be a
    // copy, of a function inlined before) is in the copy of that one's
    // parent. A root's orig is the inlined function's root (0: none).
    inl: bool,
    call: u32,
    orig: u32,
    copy: bool,  // a copy (of a lexical block or an inline instance's root), made by inlining
}

pub threadlocal let mut scopes: u.List.[DScope] = u.List.[DScope].{ data: @ptr_from_int(*mut DScope, 0), len: 0,
                                                                    cap: 0 };

// IR function name (interned) -> its scopes, which are consecutive: the
// first << 32 | the last
threadlocal let mut func_scopes: u.SymMap.[u64] = u.SymMap.[u64].{ keys: @ptr_from_int(*mut usize, 0),
                                                                   vals: @ptr_from_int(*mut u64, 0), cap: 0, len: 0 };

/// A new lexical block of function `ir_name` in block `parent` (0: a
/// function's root, made before its other scopes, which are made one after
/// the other); its index (from 1).
pub fn add_scope(ir_name: []u8, parent: u32) u32 {
    if scopes.len == 0 {
        scopes.push(DScope.{ parent: 0, func: "", types: u.List.[i32].empty(), inl: false, call: 0, orig: 0,
                             copy: false });
    }
    let k = u.intern(ir_name);
    scopes.push(DScope.{ parent: parent, func: k, types: u.List.[i32].empty(), inl: false, call: 0, orig: 0,
                         copy: false });
    let id = @as(u64, scopes.len - 1);
    let at = func_scopes.get(k);
    if (parent == 0) or (at == 0) {
        func_scopes.put(k, (id << 32) | id);
    } else {
        func_scopes.put(k, (at & ~@as(u64, 0xffff_ffff)) | id);
    }
    return @truncate(u32, id);
}

// IR function name (interned) -> where it is declared (of the functions inlined)
threadlocal let mut decls: u.SymMap.[u32] = u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0),
                                                             vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 };

/// Where function `ir_name`, which was inlined, is declared (0: not known).
pub fn decl_of(ir_name: []u8) u32 {
    return decls.get(u.intern(ir_name));
}

/// The root of an inline instance of function `ir_name` (declared at
/// `decl`; inline.ax), in scope `parent` of the function it is inlined into
/// (0: that one's outermost), the call at source location `call`; its index.
pub fn add_inline(ir_name: []u8, decl: u32, parent: u32, call: u32) u32 {
    decls.put(u.intern(ir_name), decl);
    if scopes.len == 0 {
        scopes.push(DScope.{ parent: 0, func: "", types: u.List.[i32].empty(), inl: false, call: 0, orig: 0,
                             copy: false });
    }
    let k = u.intern(ir_name);
    let sc = scopes_of(k);
    scopes.push(DScope.{ parent: parent, func: k, types: u.List.[i32].empty(), inl: true, call: call, orig: sc[0],
                         copy: false });
    return @truncate(u32, scopes.len - 1);
}

/// A copy of scope s (a lexical block or inline instance of the code
/// inlined), in scope `parent`; its index.
pub fn copy_scope(s: u32, parent: u32) u32 {
    let x = scopes.get(@as(usize, s));
    scopes.push(DScope.{ parent: parent, func: x.func, types: u.List.[i32].empty(), inl: x.inl, call: x.call, orig: s,
                         copy: true });
    return @truncate(u32, scopes.len - 1);
}

/// The scope that scope s is a copy of, through copies of copies (s
/// itself if it is none: a function's own, or an inline instance's root).
pub fn origin(s: u32) u32 {
    let mut x = s;
    while (x != 0) and scopes.get(@as(usize, x)).copy {
        x = scopes.get(@as(usize, x)).orig;
    }
    return x;
}

/// The root of the inline instance scope s is in (s itself for a root),
/// 0: none (its function's own code).
pub fn inline_root(s: u32) u32 {
    let mut x = s;
    let mut n: u32 = 0;
    while (x != 0) and (@as(usize, x) < scopes.len) and (n < 100000) {
        let d = scopes.get(@as(usize, x));
        if d.inl {
            return x;
        }
        x = d.parent;
        n += 1;
    }
    return 0;
}

/// The scopes of function `ir_name`: [first, last] (0, 0: none).
pub fn scopes_of(ir_name: []u8) [2]u32 {
    let at = func_scopes.get(u.intern(ir_name));
    return [@truncate(u32, at >> 32), @truncate(u32, at)];
}

/// Type t is declared in lexical block `scope`.
pub fn set_type_scope(t: i32, scope: u32) void {
    if (t < 0) or (scope == 0) or (@as(usize, scope) >= scopes.len) {
        return;
    }
    let d = types.at(@int_cast(usize, t));
    if d.scope != 0 {
        return;
    }
    d.scope = scope;
    scopes.at(@as(usize, scope)).types.push(t);
}

pub threadlocal let mut types: u.List.[DType] = u.List.[DType].{ data: @ptr_from_int(*mut DType, 0), len: 0, cap: 0 };
// the objects of static storage duration
pub threadlocal let mut globals: u.List.[DVar] = u.List.[DVar].{ data: @ptr_from_int(*mut DVar, 0), len: 0, cap: 0 };
// IR function name (interned) -> its variables, in order of declaration
threadlocal let mut vars: u.SymMap.[*mut u.List.[DVar]] =
    u.SymMap.[*mut u.List.[DVar]].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut *mut u.List.[DVar], 0),
                                    cap: 0, len: 0 };

// IR function name (interned) -> the type of its result + 2 (1: void)
threadlocal let mut results: u.SymMap.[i32] = u.SymMap.[i32].{ keys: @ptr_from_int(*mut usize, 0),
                                                               vals: @ptr_from_int(*mut i32, 0), cap: 0, len: 0 };

/// Function `ir_name` returns type t (-1: void).
pub fn note_result(ir_name: []u8, t: i32) void {
    results.put(u.intern(ir_name), t + 2);
}

/// The type function `ir_name` returns: -1 void, -2 not known.
pub fn result_of(ir_name: []u8) i32 {
    return results.get(u.intern(ir_name)) - 2;
}

/// A new type; its index.
pub fn add_type(t: DType) i32 {
    types.push(t);
    return @int_cast(i32, types.len - 1);
}

/// Adds variable v to the function named `ir_name`; its index there.
pub fn add_var(ir_name: []u8, v: DVar) i32 {
    let k = u.intern(ir_name);
    let mut l = vars.get(k);
    if u.isnil(l) {
        l = u.perm_new.[u.List.[DVar]]();
        vars.put(k, l);
    }
    l.push(v);
    return @int_cast(i32, l.len - 1);
}

/// The variables of the function named `ir_name`, to change (nil: none).
pub fn vars_mut(ir_name: []u8) *mut u.List.[DVar] {
    return vars.get(u.intern(ir_name));
}

/// The variables of the function named `ir_name` (none: empty).
pub fn vars_of(ir_name: []u8) []DVar {
    let l = vars.get(u.intern(ir_name));
    if u.isnil(l) {
        return u.nil_slice.[DVar]();
    }
    return l.items();
}
