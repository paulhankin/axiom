// =============================================================================
// dloc.ax - where the variables of optimized code are (-g, -O1 and up: the
// location lists of dwarf.ax), for the native code generators (x64.ax,
// a64.ax), from their machine code after register allocation.
//
// What is followed: the marks of the IR (ir.dbg_mark), each of which says
// that from its place on a variable (or a piece of one: scalar replacement
// takes structures apart) is a value, or not known (a kill). Instruction
// selection puts them before the machine instructions of the IR they came
// before (before), and they stay there as the instructions around them
// are removed (mach.remove). A variable's value may be a value an
// instruction makes, a parameter, a constant, a frame object's address, a
// value plus a constant (the base it was folded into its uses from: in the
// base's register, plus the constant), or a phi.
//
// The analysis (compute): forward over the machine CFG, what each
// allocatable register and spill slot holds (C: a value's identity, or
// nothing known) and what each variable piece is (D: an identity, plus a
// constant), at each instruction. An identity is a value as its latest
// making left it: the instruction that makes a value makes every other
// copy of it stale (a loop's next round), and a variable that was the
// stale one is no longer known; a mark whose value is made only later on
// (sunk past it) waits for that making. At a join, what all the paths
// agree on stays; a phi is in the registers that hold each path's input at
// the ends of the paths; and a variable the paths disagree on is a merge
// of its own (an identity of the join's), in the registers that hold the
// variable on every path. The meet starts from "anything" (paths not seen
// yet) and settles at a fixed point, every part of which holds by
// induction over a run of the code.
//
// What is relied on (the invariant): after register allocation, a machine
// instruction's register operands written (RD, RUD, RE), its clobbers (a
// call's) and the copies (is_move), spills and reloads (MInst.spill) say
// all that changes the allocatable registers and spill slots. A range of
// code (one machine instruction's, or a few encoded together) gets the
// places that hold its variables before it and that it does not write: a
// debugger stopped in it, or in a call it makes (at its return address),
// reads the value; a callee-saved register keeps its value across a call,
// which a debugger reads through the callee's frame. Code the encoder adds
// around instructions (a prologue, alignment) writes none of the
// allocatable registers; a return or a call in tail position takes the
// frame down: no location there.
// =============================================================================
import "dbginfo.ax" as dbi;
import "ir.ax" as ir;
import "mach.ax" as mc;
import "util.ax" as u;

/// A location piece of variable `var` (an index in its function's dbinfo
/// variables; its `psize` bytes at `poff`, psize 0: all of it), from code
/// offset start to end: LK_REG, in DWARF register `reg` (plus `add`, if not
/// 0: the value is the register's contents plus add); LK_SLOT, at `off` from
/// the CFA (plus add: the value is the `size` bytes there plus add);
/// LK_CONST, the constant `off` (its `size` bytes); LK_ADDR, the address
/// `off` from the CFA; LK_GADDR, the address of a datum plus `off`. With
/// `ind`, the variable is in memory at the address that is that value.
pub struct VLoc {
    var: u32,
    poff: u32,
    psize: u32,
    kind: u8,
    start: u64,
    end: u64,
    reg: i32,
    off: i64,
    add: i64,
    size: u32,
    ind: bool,   // the variable is in memory at the value (a variable length array: its address)
    gsym: []u8,  // LK_GADDR: the datum
    inst: u32,   // a variable of a function inlined: its inline instance (ir.DbgMark.inst; var indexes its
                 // function's), 0: the function's own
    expr: []u8,  // LK_EXPR: a DWARF expression that computes the value (plus add; without DW_OP_stack_value)
}

pub const LK_REG: u8 = 0;
pub const LK_CONST: u8 = 1;
pub const LK_SLOT: u8 = 2;
pub const LK_ADDR: u8 = 3;
pub const LK_GADDR: u8 = 4;  // the address of datum gsym, plus off
pub const LK_EXPR: u8 = 5;
pub const LK_WLOCAL: u8 = 6;  // WebAssembly: in local `reg` (DW_OP_WASM_location 0)   // computed from other values (expr): a value made from them that no place holds

/// What the target tells of its machine code.
pub struct Tgt {
    dw_reg: fn(i32) i32,              // a physical register's DWARF number (-1: none)
    is_exit: fn(*mc.MInst) bool,      // a return or a call in tail position
    is_tail: fn(*mc.MInst) bool,      // a call in tail position (it writes the stack arguments' area)
    slot_off: fn(i32) i64,            // a spill slot's offset from the CFA (NO_LOC: none)
    obj_off: fn(*ir.Value) i64,       // the frame slot of an alloca: its offset from the CFA (NO_LOC: none)
    imm_of: fn(*mc.MInst) i64,        // the constant an instruction puts in its register (all of it; NO_LOC: none)
    may_store: fn(*mc.MInst) bool,    // may an instruction write its memory operand (else it only reads it)
    single: fn(*mc.MInst, u64) bool,  // is an instruction (of that many bytes of code) one machine instruction, not a call
    alloc: u64,                       // the allocatable physical registers
}

pub const NO_LOC: i64 = -0x7fff_ffff_ffff_ffff;

/// A call the function makes (DWARF 5, 3.4: a call site): its code offset
/// after the call (a call in tail position: of the jump), the callee
/// (`sym`, a symbol; or, called through a pointer that a datum holds,
/// `tgsym` plus `toff`, the address of the datum holding it; else none),
/// and the arguments whose values are known where the call returns.
pub struct CallSite {
    ret: u64,
    at: u64,  // (the call's own offset)
    tail: bool,
    sym: i32,     // -1: none
    tgsym: []u8,  // (empty: none)
    toff: i64,
    params: []CallParam,
}

/// An argument of a call site: in DWARF register `reg` at the call, the
/// value DWARF expression `expr` computes (without DW_OP_stack_value) in
/// the caller's frame while the callee runs.
pub struct CallParam {
    reg: i32,
    expr: []u8,
}

/// The call sites of the function compute did last.
pub fn calls() []CallSite {
    return CALLS.items();
}

// A location's expression's memory (an expression is made for one location
// alone: where's, call_site's).
fn drop_expr(x: []u8) void {
    if x.len > 0 {
        u.free(@ptr_from_int(*mut void, @int_from_ptr(x.ptr)));
    }
}

/// Gives back what compute and calls returned for a function, once the
/// debug information has it.
pub fn release(vl: []VLoc, cs: []CallSite) void {
    for x in vl {
        drop_expr(x.expr);
    }
    if vl.len > 0 {
        u.free(@ptr_from_int(*mut void, @int_from_ptr(vl.ptr)));
    }
    for c in cs {
        for q in c.params {
            drop_expr(q.expr);
        }
        if c.params.len > 0 {
            u.free(@ptr_from_int(*mut void, @int_from_ptr(c.params.ptr)));
        }
    }
    if cs.len > 0 {
        u.free(@ptr_from_int(*mut void, @int_from_ptr(cs.ptr)));
    }
}

// (in code order)
pub let mut CALLS: u.List.[CallSite] = u.List.[CallSite].{ data: @ptr_from_int(*mut CallSite, 0), len: 0, cap: 0 };
// each call's machine instruction -> its IR call (+ 0: the address)
let mut call_ir: u.SymMap.[usize] = u.SymMap.[usize].{ keys: @ptr_from_int(*mut usize, 0),
                                                       vals: @ptr_from_int(*mut usize, 0), cap: 0, len: 0 };

// A variable piece followed in the function being compiled.
struct Ent {
    var: u32,
    poff: u32,
    psize: u32,
    size: u32,  // its values' bytes
    ind: bool,  // its values are its address (dbinfo's indirect)
    inst: u32,  // (an inlined function's variable: its inline instance)
    nxt: i32,   // the entity of the same var and piece of another instance (-1: none)
}

// A value the marks name (or a phi's input, or the base of one).
struct Val {
    v: *mut ir.Value,
    def: *mut mc.MInst,  // the instruction that makes it (nil: none found)
    def_op: usize,       // its operand v's register is
    entry_reg: i32,      // a parameter: the physical register it arrives in (-1: none)
    stack_off: i64,      // a parameter: its stack slot's offset from the CFA (NO_LOC: none)
    obj: bool,           // an alloca: its value is the frame object's address
    gsym: []u8,          // a datum's address: its name (empty: not one)
    base: i32,           // a value that is another plus `add` (folded into its uses): that one (-1: none)
    add: i64,
    phi_blk: i32,  // a phi: its machine block (-1: not a phi, or none)
    phi_ops: u.List.[PhiIn],
    // an integer operation of one or two operands (see expr_of): the IR
    // operation (0: none), its operands (VALS indexes, -1: the constant ca,
    // cb), its width and its first operand's in bits
    xop: i32,
    xa: i32,
    xb: i32,
    ca: i64,
    cb: i64,
    bits: u32,
    abits: u32,
}

// A phi's input: from IR block `from`, the value (VALS index, -1: none) or
// constant (CONSTS index, -1: none).
struct PhiIn {
    from: *mut ir.Block,
    val: i32,
    cst: i32,
}

struct Cst {
    bits: u64,
    size: u32,
}

// A mark in the machine code (mc.mk_next chains them): entity `ent` is
// value `val` (a VALS index), or constant `cst`, or not known (both -1).
struct MMark {
    ent: i32,
    val: i32,
    cst: i32,
    add: i64,  // (the value plus this)
}

let mut ENTS: u.List.[Ent] = u.List.[Ent].{ data: @ptr_from_int(*mut Ent, 0), len: 0, cap: 0 };
let mut VALS: u.List.[Val] = u.List.[Val].{ data: @ptr_from_int(*mut Val, 0), len: 0, cap: 0 };
let mut CONSTS: u.List.[Cst] = u.List.[Cst].{ data: @ptr_from_int(*mut Cst, 0), len: 0, cap: 0 };
let mut MKS: u.List.[MMark] = u.List.[MMark].{ data: @ptr_from_int(*mut MMark, 0), len: 0, cap: 0 };
// a value (its address) -> its index in VALS + 1
let mut by_val: u.SymMap.[i32] = u.SymMap.[i32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0),
                                                  cap: 0, len: 0 };
// an entity's (var << 40 | poff << 20 | psize... as a key) index + 1
let mut by_ent: u.SymMap.[i32] = u.SymMap.[i32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0),
                                                  cap: 0, len: 0 };
// the code offset of each machine instruction the encoder visited (its address -> offset + 1), and of each block
let mut offs: u.SymMap.[u64] = u.SymMap.[u64].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u64, 0),
                                                cap: 0, len: 0 };
let mut boffs: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };
// the IR block of each machine block
let mut mb_ir: u.List.[*mut ir.Block] = u.List.[*mut ir.Block].{ data: @ptr_from_int(*mut *mut ir.Block, 0), len: 0,
                                                                 cap: 0 };
// the marks of the IR instruction being selected, not placed yet (a chain
// of MKS, mach.ax's form), and the instruction they go after
let mut pend: i32 = 0;
let mut pend_after: *mut mc.MInst = @ptr_from_int(*mut mc.MInst, 0);
let mut pend_blk: *mut mc.MBlock = @ptr_from_int(*mut mc.MBlock, 0);
let mut FN: *mut ir.Func = @ptr_from_int(*mut ir.Func, 0);

/// Are variables followed in the function being compiled?
pub let mut active: bool = false;

fn key(p: usize) []u8 {
    return @slice_from_ptr(@ptr_from_int(*u8, p), 1);
}

/// Can a variable of type ty (or its piece of psize bytes) be value v (in
/// one register, or a WebAssembly local)?
pub fn fits_var(v: *ir.Value, ty: i32, psize: u32) bool {
    return fits(v, ty, psize);
}

// Can a variable of the type `ty` (a dbinfo type), or the piece of `psize`
// bytes of one (psize > 0), be held by value v (an integer, pointer or
// floating value of its size in one register)?
fn fits(v: *ir.Value, ty: i32, psize: u32) bool {
    if ty < 0 {
        return false;
    }
    let t = v.ty;
    let k = t.kind;
    if (k != ir.T_INT) and (k != ir.T_PTR) and (k != ir.T_FLOAT) and (k != ir.T_VEC) {
        return false;
    }
    if (k == ir.T_INT) and ((t.bits < 8) or (t.bits > 64) or ((t.bits % 8) != 0)) {
        return false;
    }
    // (a vector or a 128-bit floating value: in one vector register, whose
    // DWARF number names all of it)
    if ((k == ir.T_VEC) or (k == ir.T_FLOAT)) and (t.size != 4) and (t.size != 8) and (t.size != 16) {
        return false;
    }
    if psize > 0 {
        return @as(u64, psize) == t.size;
    }
    let d = dbi.types.at(@int_cast(usize, ty));
    let mut dk = d.kind;
    let mut dd = d;
    while (dk == dbi.DK_TYPEDEF) or (dk == dbi.DK_CONST) or (dk == dbi.DK_VOLATILE) or (dk == dbi.DK_RESTRICT) {
        if dd.target < 0 {
            return false;
        }
        dd = dbi.types.at(@int_cast(usize, dd.target));
        dk = dd.kind;
    }
    if (dk == dbi.DK_ARRAY) and (k == ir.T_VEC) {
        return dd.size == t.size;  // (a vector type: its lanes in order, as in memory)
    }
    if (dk != dbi.DK_BASE) and (dk != dbi.DK_POINTER) and (dk != dbi.DK_ENUM) {
        return false;
    }
    if (dk == dbi.DK_BASE) and (dd.bits > 0) {
        return false;  // (a bit-precise integer: its bits beyond its width are not kept)
    }
    return dd.size == t.size;
}

// Can a variable of type ty (or its piece of psize bytes) be the low bytes
// of integer value v (its bytes, 0: no)? An integer variable narrower than v.
fn low_fits(v: *ir.Value, ty: i32, psize: u32) u32 {
    if u.isnil(v) or (v.kind == ir.V_CINT) or (v.kind == ir.V_ZERO) or (v.ty.kind != ir.T_INT) or (v.ty.size > 8) or
       (ty < 0) {
        return 0;
    }
    if psize > 0 {
        if @as(u64, psize) < v.ty.size {
            return psize;
        }
        return 0;
    }
    let mut d = dbi.types.at(@int_cast(usize, ty));
    let mut n: i32 = 0;
    while ((d.kind == dbi.DK_TYPEDEF) or (d.kind == dbi.DK_CONST) or (d.kind == dbi.DK_VOLATILE)) and
          (d.target >= 0) and (n < 16) {
        d = dbi.types.at(@int_cast(usize, d.target));
        n += 1;
    }
    if ((d.kind != dbi.DK_BASE) and (d.kind != dbi.DK_ENUM)) or (d.bits > 0) or (d.size == 0) or (d.size >= v.ty.size) {
        return 0;
    }
    if (d.kind == dbi.DK_BASE) and (d.enc != dbi.ATE_SIGNED) and (d.enc != dbi.ATE_UNSIGNED) and
       (d.enc != dbi.ATE_SIGNED_CHAR) and (d.enc != dbi.ATE_UNSIGNED_CHAR) {
        return 0;
    }
    return @truncate(u32, d.size);
}

fn ent_of(var: i32, poff: u32, psize: u32, size: u32, inst: u32) i32 {
    let kv = (@as(u64, @bit_cast(u32, var)) << 40) | (@as(u64, poff) << 20) | @as(u64, psize & 0xfffff);
    let kk = key(@truncate(usize, kv + 1));
    let k = by_ent.get(kk);
    let mut j = k - 1;
    while j >= 0 {
        let en = ENTS.at(@int_cast(usize, j));
        if en.inst == inst {
            if en.size == 0 {
                en.size = size;  // (a kill made it first)
            }
            return j;
        }
        j = en.nxt;
    }
    ENTS.push(Ent.{ var: @bit_cast(u32, var), poff: poff, psize: psize, size: size, ind: false, inst: inst,
                    nxt: k - 1 });
    by_ent.put(kk, @int_cast(i32, ENTS.len));
    return @int_cast(i32, ENTS.len - 1);
}

fn cst_of(v: *ir.Value) i32 {
    let vk = v.kind;
    let mut bits: u64 = 0;
    if vk == ir.V_CINT {
        bits = ir.cint_val(v);
    } else if vk == ir.V_CFP {
        let fv = ir.fv_of(v);
        if v.ty.size == 4 {
            bits = @as(u64, ir.f32_bits(fv));
        } else {
            bits = @bit_cast(u64, fv);
        }
    } else if vk != ir.V_ZERO {
        return -1;
    }
    let size = @truncate(u32, v.ty.size);
    if (size == 0) or (size > 8) {
        return -1;
    }
    for k in 0..CONSTS.len {
        let c = CONSTS.get(k);
        if (c.bits == bits) and (c.size == size) {
            return @int_cast(i32, k);
        }
    }
    CONSTS.push(Cst.{ bits: bits, size: size });
    return @int_cast(i32, CONSTS.len - 1);
}

// The VALS index of value v of function f (made for it; -1: one not
// followed). depth: how far through bases and phis.
fn val_of(v: *mut ir.Value, depth: i32) i32 {
    let k = by_val.get(key(@int_from_ptr(v)));
    if k > 0 {
        return k - 1;
    }
    let vk = v.kind;
    if vk == ir.V_PARAM {
        let mut mine = false;
        for p in FN.params {
            mine = mine or (p == v);
        }
        if not mine {
            return -1;
        }
    } else if vk == ir.V_INST {
        if u.isnil(v.blk) or (@int_from_ptr(v.blk.fnp) != @int_from_ptr(FN)) {
            return -1;
        }
    } else if vk == ir.V_GLOBAL {
        let g = ir.gv_of(v);
        if u.isnil(g) or g.tls {
            return -1;  // (a thread-local's address is the thread's)
        }
    } else {
        return -1;
    }
    VALS.push(Val.{ v: v, def: u.nil.[mc.MInst](), def_op: 0, entry_reg: -1, stack_off: NO_LOC, obj: false, gsym: "",
                    base: -1, add: 0, phi_blk: -1, phi_ops: u.List.[PhiIn].empty(), xop: 0, xa: -1, xb: -1, ca: 0,
                    cb: 0, bits: 0, abits: 0 });
    let me = @int_cast(i32, VALS.len - 1);
    by_val.put(key(@int_from_ptr(v)), me + 1);
    if vk == ir.V_GLOBAL {
        VALS.at(@int_cast(usize, me)).gsym = ir.gv_of(v).name;
        return me;
    }
    if vk != ir.V_INST {
        return me;
    }
    let op = v.op;
    if depth < 4 {
        expr_ops(v, me, depth);
    }
    if op == ir.OP_ALLOCA {
        VALS.at(@int_cast(usize, me)).obj = true;
    } else if (depth < 4) and ((op == ir.OP_PTRADD) or (op == ir.OP_ADD) or (op == ir.OP_SUB)) and u.notnil(v.b) and
              (v.b.kind == ir.V_CINT) and ((op == ir.OP_PTRADD) or (v.ty.kind == ir.T_INT)) {
        // (a base plus a constant: in the base's place, if not in one of its own)
        let mut c = @bit_cast(i64, ir.cint_val(v.b));
        let bits = v.b.ty.bits;
        if (bits > 0) and (bits < 64) {
            let sh = @as(u32, @int_cast(u32, 64 - bits));
            c = (c << sh) >> sh;  // (sign-extended: the offset is two's complement)
        }
        if op == ir.OP_SUB {
            c = 0 -% c;
        }
        let b = val_of(v.a, depth + 1);
        if b >= 0 {
            let x = VALS.at(@int_cast(usize, me));
            x.base = b;
            x.add = c;
        }
    } else if (depth < 4) and (op == ir.OP_TRUNC) and (v.ty.kind == ir.T_INT) and (v.a.ty.kind == ir.T_INT) {
        // (its low bytes: in the wider value's place)
        let b = val_of(v.a, depth + 1);
        if b >= 0 {
            VALS.at(@int_cast(usize, me)).base = b;
        }
    } else if (op == ir.OP_PHI) and (depth < 6) {
        let bs = ir.bs_of(v);
        let mut ins = u.List.[PhiIn].empty();
        for j in 0..v.xs.len {
            let o = ir.resolve(v.xs.get(j));
            let mut vi: i32 = -1;
            let mut ci: i32 = -1;
            if u.notnil(o) {
                ci = cst_of(o);
                if ci < 0 {
                    vi = val_of(o, depth + 1);
                }
            }
            ins.push(PhiIn.{ from: bs.get(j), val: vi, cst: ci });
        }
        VALS.at(@int_cast(usize, me)).phi_ops = ins;
    }
    return me;
}

// An integer or pointer value of at most 64 bits (its width, 0: not one).
fn int_bits(v: *ir.Value) u32 {
    let t = v.ty;
    if t.kind == ir.T_PTR {
        return @truncate(u32, 8 * t.size);
    }
    if (t.kind == ir.T_INT) and (t.bits >= 1) and (t.bits <= 64) {
        return @as(u32, @int_cast(u32, t.bits));
    }
    return 0;
}

// An operand of an expression: its VALS index (-1: a constant, in *c; -2:
// neither).
fn expr_operand(o0: *mut ir.Value, depth: i32, c: *mut i64) i32 {
    let o = ir.resolve(o0);
    if u.isnil(o) or (int_bits(o) == 0) {
        return -2;
    }
    if (o.kind == ir.V_CINT) or (o.kind == ir.V_ZERO) {
        let mut x: i64 = 0;
        if o.kind == ir.V_CINT {
            x = @bit_cast(i64, ir.cint_val(o));
            let bits = int_bits(o);
            if bits < 64 {
                let sh = 64 - bits;
                x = (x << sh) >> sh;  // (sign-extended)
            }
        }
        c.* = x;
        return -1;
    }
    if (o.kind != ir.V_INST) and (o.kind != ir.V_PARAM) {
        return -2;
    }
    let k = val_of(o, depth + 1);
    if k < 0 {
        return -2;
    }
    return k;
}

// Value v (VALS index me) as an operation on other values and constants,
// which the debugger computes where no place holds v (expr_of): the
// integer operations whose low bits the DWARF stack machine's 64-bit
// arithmetic gives (DWARF 5, 2.5.1.4; narrower values extended where the
// high bits matter).
fn expr_ops(v: *mut ir.Value, me: i32, depth: i32) void {
    let op = v.op;
    let bits = int_bits(v);
    if (bits == 0) or u.isnil(v.a) {
        return;
    }
    // (a multiplication of values of at most 32 bits only: a debugger's
    // DW_OP_mul is right where the product of its operands is a signed
    // 64-bit integer, and no further (a product past it comes out with the
    // wrong sign; measured: randomly generated functions stepped in the
    // system's debugger). expr_op sign-extends both operands from the
    // value's width, which keeps the product within 2^62 and its low bits
    // the machine's.)
    let two = (op == ir.OP_ADD) or (op == ir.OP_SUB) or (op == ir.OP_AND) or (op == ir.OP_OR) or (op == ir.OP_XOR) or
              (op == ir.OP_SHL) or (op == ir.OP_LSHR) or (op == ir.OP_ASHR) or (op == ir.OP_PTRADD) or
              ((op == ir.OP_MUL) and (bits <= 32));
    let one = (op == ir.OP_ZEXT) or (op == ir.OP_SEXT) or (op == ir.OP_TRUNC) or (op == ir.OP_PTRTOINT) or
              (op == ir.OP_INTTOPTR);
    if not two and not one {
        return;
    }
    if two and u.isnil(v.b) {
        return;
    }
    let mut ca: i64 = 0;
    let mut cb: i64 = 0;
    let xa = expr_operand(v.a, depth, &mut ca);
    if (xa == -2) or ((xa == -1) and one) {
        return;
    }
    let mut xb: i32 = -1;
    if two {
        xb = expr_operand(v.b, depth, &mut cb);
        if (xb == -2) or ((xa == -1) and (xb == -1)) {
            return;
        }
    }
    let x = VALS.at(@int_cast(usize, me));
    x.xop = op;
    x.xa = xa;
    x.xb = xb;
    x.ca = ca;
    x.cb = cb;
    x.bits = bits;
    x.abits = int_bits(ir.resolve(v.a));
}

// Gives back a map's memory.
fn drop_map[V](m: *mut u.SymMap.[V]) void {
    u.free(@ptr_cast(*mut void, m.keys));
    u.free(@ptr_cast(*mut void, m.vals));
    m.keys = u.nil.[usize]();
    m.vals = u.nil.[V]();
    m.cap = 0;
    m.len = 0;
}

// the entities of parameters: at the entry, the parameter (VALS index)
let mut PENTS: u.List.[[2]i32] = u.List.[[2]i32].{ data: @ptr_from_int(*mut [2]i32, 0), len: 0, cap: 0 };

/// Function f's code is selected next: the values of its variables to find.
pub fn begin(f: *mut ir.Func, on: bool) void {
    ENTS.clear();
    for k in 0..VALS.len {
        VALS.at(k).phi_ops.deinit();
    }
    VALS.clear();
    CONSTS.clear();
    MKS.clear();
    PENTS.clear();
    RCS.clear();
    mc.mk_next.clear();
    // (the last function's maps given back)
    drop_map.[i32](&mut by_val);
    drop_map.[i32](&mut by_ent);
    drop_map.[u64](&mut offs);
    drop_map.[usize](&mut call_ir);
    by_val = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    by_ent = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    offs = u.SymMap.[u64].{ keys: u.nil.[usize](), vals: u.nil.[u64](), cap: 0, len: 0 };
    call_ir = u.SymMap.[usize].{ keys: u.nil.[usize](), vals: u.nil.[usize](), cap: 0, len: 0 };
    CALLS = u.List.[CallSite].empty();  // (a new one: the last function's went with it: release)
    boffs.clear();
    mb_ir.clear();
    pend = 0;
    pend_after = u.nil.[mc.MInst]();
    pend_blk = u.nil.[mc.MBlock]();
    FN = f;
    active = ir.dbg_on and on;
    if not active {
        return;
    }
    // the values the marks name (their makings are found as they are selected)
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let mut k = ir.dbg_marks_at(i);
            while k >= 0 {
                let m = ir.dbg_marks.get(@int_cast(usize, k));
                if (@int_from_ptr(m.owner) == @int_from_ptr(f)) or (m.inst != 0) {
                    let v = ir.dbg_mark_value(k);
                    if u.notnil(v) and (cst_of(v) < 0) {
                        _ = val_of(v, 0);
                    }
                }
                k = m.next;
            }
            i = i.next;
        }
        b = b.next;
    }
}

/// Instruction selection starts machine block mb, of IR block b.
pub fn enter_block(b: *mut ir.Block, mb: *mc.MBlock) void {
    if not active {
        return;
    }
    let k = @int_cast(usize, mb.id);
    while mb_ir.len <= k {
        mb_ir.push(u.nil.[ir.Block]());
    }
    mb_ir.set(k, b);
}

/// Parameter p arrives in physical register reg (-1: none), or at stack_off
/// from the CFA (NO_LOC: not there).
pub fn param(p: *mut ir.Value, reg: i32, stack_off: i64) void {
    if not active {
        return;
    }
    let k = val_of(p, 0);
    if k >= 0 {
        let x = VALS.at(@int_cast(usize, k));
        x.entry_reg = reg;
        x.stack_off = stack_off;
    }
}

/// IR instruction i is selected next, into machine block b: the marks
/// before it go before the code made for it (or what comes next).
pub fn before(i: *ir.Value, b: *mut mc.MBlock) void {
    if not active {
        return;
    }
    let mut k = ir.dbg_marks_at(i);
    if k < 0 {
        return;
    }
    let own = dbi.vars_of(FN.name);
    let mut chain: i32 = 0;
    while k >= 0 {
        let m = ir.dbg_marks.get(@int_cast(usize, k));
        let mk = k;
        k = m.next;
        let mut vs = own;
        if m.inst != 0 {
            vs = dbi.vars_of(m.owner.name);  // (an inlined function's, of its instance)
        } else if @int_from_ptr(m.owner) != @int_from_ptr(FN) {
            continue;
        }
        if (m.var < 0) or (@int_cast(usize, m.var) >= vs.len) {
            continue;
        }
        let x = vs[@int_cast(usize, m.var)];
        if u.notnil(x.global) {
            continue;
        }
        let v = ir.dbg_mark_value(mk);
        let madd = ir.dbg_mark_add(mk);
        let mut vi: i32 = -1;
        let mut ci: i32 = -1;
        let mut size = m.size;
        if x.indirect {
            // (the address of the variable: it is in memory there)
            if u.notnil(v) and (v.ty.kind == ir.T_PTR) and (m.size == 0) {
                size = @truncate(u32, v.ty.size);
                vi = val_of(v, 0);
            }
        } else if ir.dbg_mark_low(mk) {
            // (the low bits of a wider integer: in its place, read as narrower)
            let ls = low_fits(v, x.ty, m.size);
            if ls > 0 {
                size = ls;
                vi = val_of(v, 0);
            }
        } else if u.notnil(v) and fits(v, x.ty, m.size) {
            size = @truncate(u32, v.ty.size);
            ci = cst_of(v);
            if (ci < 0) or (madd != 0) {
                ci = -1;
                vi = val_of(v, 0);
            }
        }
        let e = ent_of(m.var, m.off, m.size, size, m.inst);
        ENTS.at(@int_cast(usize, e)).ind = x.indirect;
        if (vi >= 0) and x.param and (m.inst == 0) and (VALS.get(@int_cast(usize, vi)).v.kind == ir.V_PARAM) {
            PENTS.push([e, vi]);
        }
        MKS.push(MMark.{ ent: e, val: vi, cst: ci, add: madd });
        mc.mk_next.push(0);
        chain = mc.mk_cat(chain, @int_cast(i32, MKS.len));
    }
    if chain == 0 {
        return;
    }
    if (pend != 0) and (pend_blk == b) {
        pend = mc.mk_cat(pend, chain);
        return;
    }
    pend = chain;
    pend_after = b.last;
    pend_blk = b;
}

// The marks waiting go before the first instruction of b after pend_after.
fn place(b: *mut mc.MBlock) void {
    if (pend == 0) or (pend_blk != b) {
        return;
    }
    let mut n = b.first;
    if u.notnil(pend_after) {
        n = pend_after.next;
    }
    if u.notnil(n) {
        n.mk = mc.mk_cat(pend, n.mk);
        pend = 0;
    }
}

/// The code of IR instruction i was selected into block b, its value in
/// virtual register r (-1: none): the last instruction of b writing r makes
/// it.
pub fn selected(i: *ir.Value, b: *mut mc.MBlock, r: i32) void {
    if not active {
        return;
    }
    place(b);
    if i.op == ir.OP_CALL {
        // (its machine call: the last instruction of b that calls)
        let mut m = b.last;
        while u.notnil(m) and (m.clobber == 0) {
            m = m.prev;
        }
        if u.notnil(m) {
            call_ir.put(key(@int_from_ptr(m)), @int_from_ptr(i));
        }
    }
    let k = by_val.get(key(@int_from_ptr(i)));
    if (k == 0) or (r < 0) {
        return;
    }
    let x = VALS.at(@int_cast(usize, k - 1));
    let mut m = b.last;
    while u.notnil(m) {
        for j in 0..m.ops.len {
            let o = m.ops[j];
            if (o.kind == mc.K_REG) and (o.reg == r) and ((o.role & (mc.RD | mc.RE)) != 0) {
                x.def = m;
                x.def_op = j;
                return;
            }
        }
        m = m.prev;
    }
}

/// Block b's code is selected (its terminator's too): the marks waiting
/// are at its end.
pub fn end_block(b: *mut mc.MBlock) void {
    if not active {
        return;
    }
    place(b);
    if (pend != 0) and (pend_blk == b) {
        b.mk_end = mc.mk_cat(b.mk_end, pend);
        pend = 0;
    }
}

/// The encoder: block bi starts at code offset `off` (before any code the
/// encoder puts there: a prologue); `restart` starts the offsets again (an
/// encoding pass over).
pub fn block_at(bi: usize, off: u64, restart: bool) void {
    if not active {
        return;
    }
    if restart {
        boffs.clear();
        drop_map.[u64](&mut offs);
    }
    while boffs.len <= bi {
        boffs.push(0xffff_ffff_ffff_ffff);
    }
    boffs.set(bi, off);
}

/// The encoder: machine instruction i (and those it encodes with it, up to
/// the next one given) starts at code offset `off`.
pub fn inst_at(i: *mc.MInst, off: u64) void {
    if active {
        offs.put(key(@int_from_ptr(i)), off + 1);
    }
}

fn bit(r: i32) u64 {
    if (r < 0) or (r >= 64) {
        return 0;
    }
    return @as(u64, 1) << @as(u32, @bit_cast(u32, r));
}

// The physical registers i writes.
fn written(mf: *mc.MFunc, i: *mc.MInst) u64 {
    let mut w = i.clobber;
    for o in i.ops {
        if (o.kind == mc.K_REG) and ((o.role & (mc.RD | mc.RE)) != 0) {
            w = w | bit(mc.phys(mf, o.reg));
        }
    }
    return w;
}

fn move_regs(mf: *mc.MFunc, i: *mc.MInst) [2]i32 {
    let mut d: i32 = -1;
    let mut s: i32 = -1;
    for o in i.ops {
        if o.kind != mc.K_REG {
            continue;
        }
        if (o.role & mc.RD) != 0 {
            d = mc.phys(mf, o.reg);
        } else if (o.role & mc.RU) != 0 {
            s = mc.phys(mf, o.reg);
        }
    }
    return [d, s];
}

// -----------------------------------------------------------------------------
// The analysis
// -----------------------------------------------------------------------------
// Places: the physical registers 0-63, then the frame slots the code
// spills to or reloads from (64 + their index in SLOTS).
let mut NL: usize = 64;
let mut SLOTS: u.List.[i32] = u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 };
const MAX_SLOTS: usize = 448;

// The place of frame slot k (-1: none followed).
fn slot_place(k: i32) i32 {
    if k < 0 {
        return -1;
    }
    for j in 0..SLOTS.len {
        if SLOTS.get(j) == k {
            return 64 + @int_cast(i32, j);
        }
    }
    return -1;
}

// The slot of place l (>= 64).
fn place_slot(l: usize) i32 {
    return SLOTS.get(l - 64);
}

// The machine code, flattened: per instruction (in block order), what the
// analysis needs.
struct Ins {
    i: *mut mc.MInst,
    w: u64,       // the registers it writes (allocatable ones)
    kind: u8,     // 0: other, 1: a spill store, 2: a reload, 3: a copy, 4: an exit, 5: a constant (imm) into d
    d: i32,       // a copy's, reload's destination (a physical register), a spill store's source
    s: i32,       // a copy's source register; a spill store's or reload's slot's place (-1: none)
    defv: i32,    // the value it makes (a VALS index, -1: none)
    defr: i32,    // in physical register
    sw: [2]i32,   // the places of the slots it may write otherwise (-1: none)
    swall: bool,  // (and more: all of them)
    imm: i64,
}

// The state at a point: C, what each place holds (0: nothing known, else
// an identity); D and A, what each entity is (an identity plus A).
struct State {
    c: []mut i32,
    d: []mut i32,
    a: []mut i64,
    x: []mut u64,  // per value, a bit: made, and none of the values it is computed from (expr_of) made since
}

// (the number of values followed: State.x's bits, in NXW words)
let mut NX: usize = 0;
let mut NXW: usize = 0;

fn x_has(s: *State, k: usize) bool {
    return (s.x[k >> 6] & (@as(u64, 1) << @truncate(u32, k & 63))) != 0;
}

fn x_put(s: *mut State, k: usize, on: bool) void {
    let m = @as(u64, 1) << @truncate(u32, k & 63);
    if on {
        s.x[k >> 6] = s.x[k >> 6] | m;
    } else {
        s.x[k >> 6] = s.x[k >> 6] & ~m;
    }
}

// The analysis' tables for the function.
struct An {
    mf: *mc.MFunc,
    t: *Tgt,
    nb: usize,
    ne: usize,
    nv: i32,
    syn0: i64,
    ins: u.List.[Ins],
    bfirst: []mut usize,  // each block's first instruction (in ins), and the end (bfirst[nb])
    idom: []mut i32,
    rpo: []mut i32,     // the blocks' order (reverse postorder)
    rpon: []mut i32,    // each block's place in it (-1: unreachable)
    defb: []mut i32,    // each value's making's block (-1: none)
    defi: []mut usize,  // and its index in ins
    tails: bool,
    preds: []mut u.List.[i32],  // each block's predecessors (from the successors)
    rep: []mut i32,             // meet's tables, made once
    at: []mut bool,
}

fn id_val(k: i32) i32 {
    return k + 1;
}

// The constants machine instructions put in registers (all 64 bits): their
// identities are -2, -3, ...
let mut RCS: u.List.[i64] = u.List.[i64].{ data: @ptr_from_int(*mut i64, 0), len: 0, cap: 0 };

fn rc_id(x: i64) i32 {
    for k in 0..RCS.len {
        if RCS.get(k) == x {
            return -2 - @int_cast(i32, k);
        }
    }
    RCS.push(x);
    return -1 - @int_cast(i32, RCS.len);
}

// Does a place holding identity c hold what identity d is (the same one, or
// constant d's bits)?
fn is_held(an: *An, c: i32, d: i32) bool {
    if c == d {
        return c != 0;
    }
    let nv = an.nv;
    if (c <= -2) and (d > 2 * nv) and (@as(i64, d) < an.syn0) {
        let k = CONSTS.get(@int_cast(usize, d - (2 * nv) - 1));
        let v = @bit_cast(u64, RCS.get(@int_cast(usize, -2 - c)));
        if k.size >= 8 {
            return v == k.bits;
        }
        let mask = (@as(u64, 1) << @as(u32, 8 * k.size)) - 1;
        return (v & mask) == k.bits;
    }
    return false;
}

fn st_new(ne: usize) State {
    return State.{ c: u.newn.[i32](NL), d: u.newn.[i32](ne + 1), a: u.newn.[i64](ne + 1), x: u.newn.[u64](NXW + 1) };
}

fn st_copy(to: *mut State, from: *State, ne: usize) void {
    for l in 0..NL {
        to.c[l] = from.c[l];
    }
    for e in 0..ne {
        to.d[e] = from.d[e];
        to.a[e] = from.a[e];
    }
    for k in 0..NXW {
        to.x[k] = from.x[k];
    }
}

fn st_clear(s: *mut State, ne: usize) void {
    for l in 0..NL {
        s.c[l] = 0;
    }
    for e in 0..ne {
        s.d[e] = 0;
        s.a[e] = 0;
    }
    for k in 0..NXW {
        s.x[k] = 0;
    }
}

fn st_same(x: *State, y: *State, ne: usize) bool {
    for l in 0..NL {
        if x.c[l] != y.c[l] {
            return false;
        }
    }
    for e in 0..ne {
        if (x.d[e] != y.d[e]) or (x.a[e] != y.a[e]) {
            return false;
        }
    }
    for k in 0..NXW {
        if x.x[k] != y.x[k] {
            return false;
        }
    }
    return true;
}

fn holds(s: *State, id: i32) bool {
    for l in 0..NL {
        if s.c[l] == id {
            return true;
        }
    }
    return false;
}

// The places of a state by what they hold, while emit_at looks at every
// entity in it (PX_ON): for an identity, the registers that hold it (a
// mask) and the first spill slot's place that does (-1: none). It answers
// what where and expr_of would find by looking at every place.
let mut PX_ON: bool = false;
let mut PX_CAP: usize = 0;
let mut PX_K: u.List.[i32] = u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 };
let mut PX_M: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };
let mut PX_S: u.List.[i32] = u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 };

fn px_slot(id: i32) usize {
    let mut j = @as(usize, @truncate(u32, @bit_cast(u32, id) *% 0x9e37_79b1)) & (PX_CAP - 1);
    while (PX_K.get(j) != 0) and (PX_K.get(j) != id) {
        j = (j + 1) & (PX_CAP - 1);
    }
    return j;
}

fn px_build(s: *State) void {
    let mut cap: usize = 128;
    while cap < (2 * NL) + 2 {
        cap = cap * 2;
    }
    PX_CAP = cap;
    while PX_K.len < cap {
        PX_K.push(0);
        PX_M.push(0);
        PX_S.push(-1);
    }
    for j in 0..cap {
        PX_K.set(j, 0);
    }
    for l in 0..NL {
        let id = s.c[l];
        if id == 0 {
            continue;
        }
        let j = px_slot(id);
        if PX_K.get(j) == 0 {
            PX_K.set(j, id);
            PX_M.set(j, 0);
            PX_S.set(j, -1);
        }
        if l < 64 {
            PX_M.set(j, PX_M.get(j) | (@as(u64, 1) << @truncate(u32, l)));
        } else if PX_S.get(j) < 0 {
            PX_S.set(j, @int_cast(i32, l));
        }
    }
    PX_ON = true;
}

// The registers holding id (a mask) and the first place among the slots
// from which to look for it (NL: none), from the index when it is on.
fn px_regs(s: *State, id: i32) u64 {
    if PX_ON {
        let j = px_slot(id);
        if PX_K.get(j) == 0 {
            return 0;
        }
        return PX_M.get(j);
    }
    let mut m: u64 = 0;
    for p in @as(usize, 0)..64 {
        if s.c[p] == id {
            m = m | (@as(u64, 1) << @truncate(u32, p));
        }
    }
    return m;
}

fn px_first_slot(id: i32) usize {
    if PX_ON {
        let j = px_slot(id);
        if (PX_K.get(j) == 0) or (PX_S.get(j) < 0) {
            return NL;
        }
        return @int_cast(usize, PX_S.get(j));
    }
    return 64;
}

// Does block a dominate block b?
fn dominates(an: *An, a: i32, b: i32) bool {
    if (a < 0) or (b < 0) or (an.rpon[@int_cast(usize, b)] < 0) {
        return false;
    }
    let mut x = b;
    let mut n: usize = 0;
    while (x >= 0) and (n <= an.nb) {
        if x == a {
            return true;
        }
        let y = an.idom[@int_cast(usize, x)];
        if y == x {
            return false;
        }
        x = y;
        n += 1;
    }
    return false;
}

// Is value k made where every path to instruction `at` (in block b) has
// made it last (its making dominates the place)?
fn made_before(an: *An, k: i32, b: i32, at: usize) bool {
    let x = VALS.get(@int_cast(usize, k));
    if x.v.kind == ir.V_PARAM {
        return true;
    }
    if x.phi_blk >= 0 {
        return dominates(an, x.phi_blk, b);
    }
    let db = an.defb[@int_cast(usize, k)];
    if db < 0 {
        return false;
    }
    if db == b {
        return an.defi[@int_cast(usize, k)] < at;
    }
    return dominates(an, db, b);
}

// Mark mm takes effect in state s, before instruction `at` of block b.
fn apply_mark(an: *An, s: *mut State, mm: MMark, b: i32, at: usize) void {
    if mm.ent < 0 {
        return;
    }
    let e = @int_cast(usize, mm.ent);
    s.d[e] = 0;
    s.a[e] = 0;
    if mm.cst >= 0 {
        s.d[e] = 2 * an.nv + mm.cst + 1;
        return;
    }
    let k = mm.val;
    if k < 0 {
        return;
    }
    let x = VALS.get(@int_cast(usize, k));
    if x.obj or (x.gsym.len > 0) or (x.v.kind == ir.V_PARAM) or holds(s, id_val(k)) {
        s.d[e] = id_val(k);
        s.a[e] = mm.add;
        return;
    }
    if x.phi_blk >= 0 {
        if dominates(an, x.phi_blk, b) {
            s.d[e] = id_val(k);
            s.a[e] = mm.add;
        }
        return;
    }
    // folded into its uses: its base's place, plus the constant
    let mut bk = x.base;
    let mut add = x.add +% mm.add;
    let mut n: i32 = 0;
    while (bk >= 0) and (n < 8) {
        let y = VALS.get(@int_cast(usize, bk));
        if y.obj or (y.gsym.len > 0) or holds(s, id_val(bk)) or ((y.v.kind == ir.V_PARAM) and (y.stack_off != NO_LOC)) {
            s.d[e] = id_val(bk);
            s.a[e] = add;
            return;
        }
        add = add +% y.add;
        bk = y.base;
        n += 1;
    }
    if u.notnil(x.def) {
        s.a[e] = mm.add;
        if made_before(an, k, b, at) {
            s.d[e] = id_val(k);
        } else {
            s.d[e] = an.nv + k + 1;  // (made later on: waits for the making)
        }
    }
}

fn apply_marks(an: *An, s: *mut State, chain: i32, b: i32, at: usize) void {
    let mut k = chain;
    while k != 0 {
        apply_mark(an, s, MKS.get(@int_cast(usize, k - 1)), b, at);
        k = mc.mk_next.get(@int_cast(usize, k - 1));
    }
}

fn set_reg(an: *An, s: *mut State, r: i32, id: i32) void {
    if (r >= 0) and (r < 64) and ((an.t.alloc & bit(r)) != 0) {
        s.c[@int_cast(usize, r)] = id;
    }
}

fn get_reg(an: *An, s: *State, r: i32) i32 {
    if (r >= 0) and (r < 64) and ((an.t.alloc & bit(r)) != 0) {
        return s.c[@int_cast(usize, r)];
    }
    return 0;
}

// The state after instruction x (from s before it, its marks applied).
fn step(an: *An, s: *mut State, x: *Ins) void {
    if x.kind == 4 {
        for l in 0..NL {
            s.c[l] = 0;
        }
        return;
    }
    let mut held: i32 = 0;
    if x.kind == 1 {
        held = get_reg(an, s, x.d);
    } else if x.kind == 2 {
        if x.s >= 0 {
            held = s.c[@int_cast(usize, x.s)];
        }
    } else if x.kind == 3 {
        held = get_reg(an, s, x.s);
    }
    if x.w != 0 {
        for p in @as(usize, 0)..64 {
            if (x.w & (@as(u64, 1) << @as(u32, @truncate(u32, p)))) != 0 {
                s.c[p] = 0;
            }
        }
    }
    for q in @as(usize, 0)..2 {
        if x.sw[q] >= 0 {
            s.c[@int_cast(usize, x.sw[q])] = 0;
        }
    }
    if x.swall {
        for l in 64..NL {
            s.c[l] = 0;
        }
    }
    if x.kind == 1 {
        if x.s >= 0 {
            s.c[@int_cast(usize, x.s)] = held;
        }
    } else if (x.kind == 2) or (x.kind == 3) {
        set_reg(an, s, x.d, held);
    } else if x.kind == 5 {
        set_reg(an, s, x.d, rc_id(x.imm));
    }
    if x.defv >= 0 {
        // a value made again: its other copies (and what was it) are stale
        let id = id_val(x.defv);
        let nx = an.nv + x.defv + 1;
        for l in 0..NL {
            if s.c[l] == id {
                s.c[l] = 0;
            }
        }
        for e in 0..an.ne {
            if s.d[e] == id {
                s.d[e] = 0;
                s.a[e] = 0;
            } else if s.d[e] == nx {
                s.d[e] = id;
            }
        }
        set_reg(an, s, x.defr, id);
        remade(s, x.defv);
        x_put(s, @int_cast(usize, x.defv), true);
    }
}

// Value k is made (again): the values computed from it are not from this
// one (State.x).
fn remade(s: *mut State, k: i32) void {
    if @int_cast(usize, k) >= DEPS.len {
        return;
    }
    for j in DEPS.get(@int_cast(usize, k)).items() {
        x_put(s, @int_cast(usize, j), false);
    }
}

// each value -> the values computed from it, directly or not (expr_of's)
let mut DEPS: u.List.[u.List.[i32]] = u.List.[u.List.[i32]].{ data: @ptr_from_int(*mut u.List.[i32], 0), len: 0,
                                                              cap: 0 };

fn add_deps(k: i32, of: i32, depth: i32) void {
    if (of < 0) or (depth > 6) {
        return;
    }
    let x = VALS.get(@int_cast(usize, of));
    if x.xop == 0 {
        return;
    }
    let os: [2]i32 = [x.xa, x.xb];
    for q in @as(usize, 0)..2 {
        let o = os[q];
        if o >= 0 {
            let l = DEPS.at(@int_cast(usize, o));
            let mut have = false;
            for j in l.items() {
                have = have or (j == k);
            }
            if not have {
                l.push(k);
            }
            add_deps(k, o, depth + 1);
        }
    }
}

fn find_deps() void {
    for k in 0..DEPS.len {
        DEPS.at(k).deinit();
    }
    DEPS.clear();
    for _k in 0..VALS.len {
        DEPS.push(u.List.[i32].empty());
    }
    for k in 0..VALS.len {
        add_deps(@int_cast(i32, k), @int_cast(i32, k), 0);
    }
}

// The synthetic identity of entity e's merge at block b (0: none).
fn syn(an: *An, b: usize, e: usize) i32 {
    let id = an.syn0 + (@as(i64, @int_cast(i64, b)) * @as(i64, @int_cast(i64, an.ne))) + @as(i64, @int_cast(i64, e));
    if id >= 0x7fff_0000 {
        return 0;
    }
    return @truncate(i32, id);
}

fn in_syn(id: i32, lo: i64, hi: i64) bool {
    return (@as(i64, id) >= lo) and (@as(i64, id) < hi);
}

// The state at the start of block b, from the states at the ends of its
// predecessors seen so far (outs, seen) and, for the entry, the entry's.
fn meet(an: *An, b: usize, outs: []State, seen: []bool, entry: *State, s: *mut State) void {
    let mb = an.mf.blocks.get(b);
    let mut ps = u.List.[*State].empty();
    let mut pb = u.List.[i32].empty();
    if b == 0 {
        ps.push(entry);
        pb.push(-1);
    }
    for p in an.preds[b].items() {
        if seen[@int_cast(usize, p)] {
            ps.push(&outs[@int_cast(usize, p)]);
            pb.push(p);
        }
    }
    st_clear(s, an.ne);
    if ps.len == 0 {
        ps.deinit();
        pb.deinit();
        return;
    }
    let n = ps.len;
    let pss = ps.items();
    // (the identities of block b's merges, syn's: [slo, shi))
    let slo = an.syn0 + (@as(i64, @int_cast(i64, b)) * @as(i64, @int_cast(i64, an.ne)));
    let shi = slo + @as(i64, @int_cast(i64, an.ne));
    // the entities
    let rep = an.rep;  // a disagreeing entity's representative (-1: none)
    let mut reps = u.List.[usize].empty();  // (the representatives, in order)
    for e in 0..an.ne {
        rep[e] = -1;
        let d0 = pss[0].d[e];
        let a0 = pss[0].a[e];
        let mut same = not in_syn(d0, slo, shi);
        let mut known = d0 != 0;
        let mut adds = true;
        for j in 1..n {
            let x = pss[j];
            if (x.d[e] != d0) or in_syn(x.d[e], slo, shi) {
                same = false;
            }
            if x.a[e] != a0 {
                same = false;
                adds = false;
            }
            known = known and (x.d[e] != 0);
        }
        if same {
            s.d[e] = d0;
            s.a[e] = a0;
            continue;
        }
        if not known or not adds {
            continue;
        }
        // a merge of its own, or of an earlier entity with the same inputs
        let mut r = e;
        for f in reps.items() {
            let mut eq = true;
            for j in 0..n {
                if pss[j].d[f] != pss[j].d[e] {
                    eq = false;
                }
            }
            if eq {
                r = f;
                break;
            }
        }
        rep[e] = @int_cast(i32, r);
        if r == e {
            reps.push(e);
        }
        s.d[e] = syn(an, b, r);
        s.a[e] = a0;
    }
    // the places
    for l in 0..NL {
        let c0 = pss[0].c[l];
        let mut same = (c0 != 0) and not in_syn(c0, slo, shi);
        for j in 1..n {
            if pss[j].c[l] != c0 {
                same = false;
            }
        }
        if same {
            s.c[l] = c0;
            continue;
        }
        for e in reps.items() {
            if s.d[e] == 0 {
                continue;
            }
            let mut all = true;
            for j in 0..n {
                let x = pss[j];
                if not is_held(an, x.c[l], x.d[e]) {
                    all = false;
                    break;
                }
            }
            if all {
                s.c[l] = s.d[e];
                break;
            }
        }
    }
    // the values computed from others: so on every path
    for k in 0..NXW {
        let mut all: u64 = 0xffff_ffff_ffff_ffff;
        for j in 0..n {
            all = all & pss[j].x[k];
        }
        s.x[k] = all;
    }
    // the phis of the block: where each path's input is at its end
    let ib = mb_ir_of(b);
    for k in PHIS.get(b).items() {
        let x = VALS.at(k);
        let id = id_val(@int_cast(i32, k));
        let mut ok = u.notnil(ib) and (b != 0);
        let at = an.at;
        for l in 0..NL {
            at[l] = ok;
        }
        for j in 0..n {
            if not ok {
                break;
            }
            let pi = pb.get(j);
            let from = mb_ir_of(@int_cast(usize, pi));
            let mut inid: i32 = 0;
            for q in x.phi_ops.items() {
                if u.notnil(from) and (q.from == from) and (q.val >= 0) {
                    inid = id_val(q.val);
                } else if u.notnil(from) and (q.from == from) and (q.cst >= 0) {
                    inid = 2 * an.nv + q.cst + 1;
                }
            }
            if inid == 0 {
                ok = false;
                break;
            }
            let ps_j = pss[j];
            for l in 0..NL {
                if not is_held(an, ps_j.c[l], inid) {
                    at[l] = false;
                }
            }
        }
        for l in 0..NL {
            if s.c[l] == id {
                s.c[l] = 0;
            }
        }
        let nx = an.nv + @int_cast(i32, k) + 1;
        for e in 0..an.ne {
            if s.d[e] == id {
                s.d[e] = 0;
                s.a[e] = 0;
            } else if s.d[e] == nx {
                s.d[e] = id;
            }
        }
        remade(s, @int_cast(i32, k));
        if ok {
            for l in 0..NL {
                if at[l] {
                    s.c[l] = id;
                }
            }
        }
    }
    ps.deinit();
    pb.deinit();
    reps.deinit();
}

// each machine block's phis (VALS indexes)
let mut PHIS: u.List.[u.List.[usize]] = u.List.[u.List.[usize]].{ data: @ptr_from_int(*mut u.List.[usize], 0), len: 0,
                                                                  cap: 0 };

// The IR block of machine block b (nil: none), through blocks made since
// with one predecessor.
fn mb_ir_of(b: usize) *mut ir.Block {
    if b < mb_ir.len {
        return mb_ir.get(b);
    }
    return u.nil.[ir.Block]();
}

// The blocks' immediate dominators (the entry's is itself; an unreachable
// block's -1), over the machine CFG: the iterative algorithm over reverse
// postorder (Cooper, Harvey and Kennedy, "A Simple, Fast Dominance
// Algorithm", 2001).
fn dominators(an: *mut An) void {
    let nb = an.nb;
    let color = u.newn.[u8](nb + 1);
    let post = u.newn.[i32](nb + 1);
    let mut np: usize = 0;
    for b in 0..nb {
        color[b] = 0;
        an.rpon[b] = -1;
        an.idom[b] = -1;
    }
    // (an explicit stack of (block, next successor))
    let mut stk = u.List.[[2]i32].empty();
    stk.push([0, 0]);
    color[0] = 1;
    while stk.len > 0 {
        let top = stk.last();
        let b = an.mf.blocks.get(@int_cast(usize, top[0]));
        let k = @int_cast(usize, top[1]);
        if k < b.succs.len {
            stk.set(stk.len - 1, [top[0], top[1] + 1]);
            let s = b.succs.get(k);
            if (s >= 0) and (@int_cast(usize, s) < nb) and (color[@int_cast(usize, s)] == 0) {
                color[@int_cast(usize, s)] = 1;
                stk.push([s, 0]);
            }
        } else {
            post[np] = top[0];
            np += 1;
            _ = stk.pop();
        }
    }
    stk.deinit();
    for k in 0..np {
        let b = post[np - 1 - k];
        an.rpo[k] = b;
        an.rpon[@int_cast(usize, b)] = @int_cast(i32, k);
    }
    for k in np..nb {
        an.rpo[k] = -1;
    }
    an.idom[0] = 0;
    let mut changed = true;
    while changed {
        changed = false;
        for k in 1..np {
            let b = an.rpo[k];
            let mut nd: i32 = -1;
            for p in an.preds[@int_cast(usize, b)].items() {
                if (p < 0) or (an.idom[@int_cast(usize, p)] < 0) {
                    continue;
                }
                if nd < 0 {
                    nd = p;
                    continue;
                }
                // intersect
                let mut x = p;
                let mut y = nd;
                while x != y {
                    while an.rpon[@int_cast(usize, x)] > an.rpon[@int_cast(usize, y)] {
                        x = an.idom[@int_cast(usize, x)];
                    }
                    while an.rpon[@int_cast(usize, y)] > an.rpon[@int_cast(usize, x)] {
                        y = an.idom[@int_cast(usize, y)];
                    }
                }
                nd = x;
            }
            if (nd >= 0) and (an.idom[@int_cast(usize, b)] != nd) {
                an.idom[@int_cast(usize, b)] = nd;
                changed = true;
            }
        }
    }
}

// The flattened code (an.ins, an.bfirst) and each value's making.
fn flatten(an: *mut An) void {
    let mf = an.mf;
    let t = an.t;
    // the slots the code spills to and reloads from
    SLOTS.clear();
    for bi in 0..an.nb {
        let mut i = mf.blocks.get(bi).first;
        while u.notnil(i) {
            if (i.spill != 0) and (i.sslot >= 0) and (slot_place(i.sslot) < 0) and (SLOTS.len < MAX_SLOTS) {
                SLOTS.push(i.sslot);
            }
            i = i.next;
        }
    }
    NL = 64 + SLOTS.len;
    let mut by_def = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    for k in 0..VALS.len {
        let x = VALS.get(k);
        if u.notnil(x.def) {
            by_def.put(key(@int_from_ptr(x.def)), @int_cast(i32, k) + 1);
        }
        an.defb[k] = -1;
        an.defi[k] = 0;
    }
    for bi in 0..an.nb {
        an.bfirst[bi] = an.ins.len;
        let mut i = mf.blocks.get(bi).first;
        while u.notnil(i) {
            an.tails = an.tails or t.is_tail(i);
            let mut x = Ins.{ i: i, w: written(mf, i) & t.alloc, kind: 0, d: -1, s: -1, defv: -1, defr: -1,
                              sw: [-1, -1], swall: false, imm: 0 };
            if t.is_exit(i) {
                x.kind = 4;
            } else if i.spill == 2 {
                x.kind = 1;
                x.d = mc.phys(mf, i.sreg);
                x.s = slot_place(i.sslot);
            } else if (i.spill == 1) and (i.sslot >= 0) {
                x.kind = 2;
                x.d = mc.phys(mf, i.sreg);
                x.s = slot_place(i.sslot);
            } else if i.is_move {
                let ds = move_regs(mf, i);
                x.kind = 3;
                x.d = ds[0];
                x.s = ds[1];
            } else if (t.imm_of(i) != NO_LOC) and (i.ops.len > 0) and (i.ops[0].kind == mc.K_REG) {
                x.kind = 5;
                x.d = mc.phys(mf, i.ops[0].reg);
                x.imm = t.imm_of(i);
            } else if t.may_store(i) {
                let mut n: usize = 0;
                for o in i.ops {
                    let l = slot_place(o.slot);
                    if (o.kind == mc.K_MEM) and (l >= 0) {
                        // (a slot another may write: not followed further)
                        if n < 2 {
                            x.sw[n] = l;
                        } else {
                            x.swall = true;
                        }
                        n += 1;
                    }
                }
            }
            if by_def.len > 0 {
                let dv = by_def.get(key(@int_from_ptr(i))) - 1;
                if dv >= 0 {
                    let v = VALS.get(@int_cast(usize, dv));
                    x.defv = dv;
                    x.defr = mc.phys(mf, i.ops[v.def_op].reg);
                    an.defb[@int_cast(usize, dv)] = @int_cast(i32, bi);
                    an.defi[@int_cast(usize, dv)] = an.ins.len;
                }
            }
            an.ins.push(x);
            i = i.next;
        }
    }
    an.bfirst[an.nb] = an.ins.len;
    drop_map.[i32](&mut by_def);
}

/// The location pieces of the function's variables, from its machine code
/// mf (allocated, encoded: block_at, inst_at), `size` bytes of it.
// debugging: AXIOM_DEBUG_DLOC=<function> (or *) traces the analysis of a
// function: its entities, values and, per instruction, the state.
let mut DBGF: bool = false;
pub fn compute(mf: *mc.MFunc, t: *Tgt, size: u64) []VLoc {
    let mut out = u.List.[VLoc].empty();
    DBGF = u.str_eq(u.env("AXIOM_DEBUG_DLOC"), FN.name) or u.str_eq(u.env("AXIOM_DEBUG_DLOC"), "*");
    if DBGF {
        u.eprint(u.f2("func %s nv %s\n", FN.name, u.idec(@int_cast(i32, VALS.len))));
        for k in 0..VALS.len {
            let x = VALS.get(k);
            let mut op: i32 = -1;
            if x.v.kind == ir.V_INST {
                op = x.v.op;
            } else if x.v.kind == ir.V_PARAM {
                op = -2;
            }
            u.eprint(
                u.f3(
                    "v%s op=%s ty=%s", u.idec(@int_cast(i32, k) + 1), u.idec(op),
                    u.idec(@int_cast(i32, @int_from_enum(x.v.ty.kind)))));
            u.eprint(u.f3(" xop=%s xa=%s xb=%s\n", u.idec(x.xop), u.idec(x.xa + 1), u.idec(x.xb + 1)));
        }
    }
    if DBGF {
        for e in 0..ENTS.len {
            let en = ENTS.get(e);
            let vs = dbi.vars_of(FN.name);
            if (en.inst == 0) and (@as(usize, en.var) < vs.len) {
                u.eprint(u.f2("e%s = %s\n", u.idec(@int_cast(i32, e)), vs[@as(usize, en.var)].name));
            }
        }
    }
    if not active or (ENTS.len == 0) {
        return out.items();
    }
    let nb = mf.blocks.len;
    if (nb == 0) or (boffs.len < nb) {
        return out.items();
    }
    // the phis' blocks
    let mut ir_mb = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    for b in 0..mb_ir.len {
        if u.notnil(mb_ir.get(b)) {
            ir_mb.put(key(@int_from_ptr(mb_ir.get(b))), @int_cast(i32, b) + 1);
        }
    }
    for k in 0..VALS.len {
        let x = VALS.at(k);
        if (x.v.kind == ir.V_INST) and (x.v.op == ir.OP_PHI) and u.notnil(x.v.blk) {
            x.phi_blk = ir_mb.get(key(@int_from_ptr(x.v.blk))) - 1;
        }
    }
    drop_map.[i32](&mut ir_mb);
    let ne = ENTS.len;
    let nv = @int_cast(i32, VALS.len);
    let mut an = An.{ mf: mf, t: t, nb: nb, ne: ne, nv: nv,
                      syn0: (2 * @as(i64, nv)) + @as(i64, @int_cast(i64, CONSTS.len)) + 1, ins: u.List.[Ins].empty(),
                      bfirst: u.newn.[usize](nb + 1), idom: u.newn.[i32](nb + 1), rpo: u.newn.[i32](nb + 1),
                      rpon: u.newn.[i32](nb + 1), defb: u.newn.[i32](VALS.len + 1), defi: u.newn.[usize](VALS.len + 1),
                      tails: false, preds: u.newn.[u.List.[i32]](nb + 1), rep: u.newn.[i32](ENTS.len + 1),
                      at: u.nil_slice.[bool]() };
    for b in 0..nb {
        an.preds[b] = u.List.[i32].empty();
    }
    for b in 0..nb {
        for sc in mf.blocks.get(b).succs.items() {
            if (sc >= 0) and (@int_cast(usize, sc) < nb) {
                an.preds[@int_cast(usize, sc)].push(@int_cast(i32, b));
            }
        }
    }
    dominators(&mut an);
    flatten(&mut an);
    an.at = u.newn.[bool](NL + 1);  // (NL: flatten's)
    NX = VALS.len;
    NXW = (NX + 63) / 64;
    find_deps();
    for k in 0..PHIS.len {
        PHIS.at(k).deinit();
    }
    PHIS.clear();
    for _b in 0..(nb + 1) {
        PHIS.push(u.List.[usize].empty());
    }
    for k in 0..VALS.len {
        let pbk = VALS.get(k).phi_blk;
        if (pbk >= 0) and (@int_cast(usize, pbk) < nb) {
            PHIS.at(@int_cast(usize, pbk)).push(k);
        }
    }
    // the state at the entry: the parameters in their registers, and the
    // variables they are
    let mut entry = st_new(ne);
    st_clear(&mut entry, ne);
    for k in 0..VALS.len {
        let x = VALS.get(k);
        if x.entry_reg >= 0 {
            set_reg(&an, &mut entry, x.entry_reg, id_val(@int_cast(i32, k)));
        }
    }
    for pe in PENTS.items() {
        entry.d[@int_cast(usize, pe[0])] = id_val(pe[1]);
    }
    // (each block's state at its start is the meet of its predecessors' at
    // their ends: made again where it is needed, not kept; a block none of
    // whose predecessors' changed since it was run gives what it gave)
    let outs = u.newn.[State](nb + 1);
    let seen = u.newn.[bool](nb + 1);
    let dirty = u.newn.[bool](nb + 1);
    for b in 0..nb {
        outs[b] = st_new(ne);
        st_clear(&mut outs[b], ne);
        seen[b] = false;
        dirty[b] = true;
    }
    let mut cur = st_new(ne);
    let mut changed = true;
    let mut rounds: i32 = 0;
    while changed and (rounds < 50) {
        changed = false;
        rounds += 1;
        for k in 0..nb {
            let b = an.rpo[k];
            if b < 0 {
                break;
            }
            let bi = @int_cast(usize, b);
            if not dirty[bi] {
                continue;
            }
            dirty[bi] = false;
            meet(&an, bi, outs, seen, &entry, &mut cur);
            run_block(&an, bi, &mut cur);
            if not seen[bi] or not st_same(&cur, &outs[bi], ne) {
                st_copy(&mut outs[bi], &cur, ne);
                seen[bi] = true;
                changed = true;
                for sc in mf.blocks.get(bi).succs.items() {
                    if (sc >= 0) and (@int_cast(usize, sc) < nb) {
                        dirty[@int_cast(usize, sc)] = true;
                    }
                }
            }
        }
    }
    if changed {
        an.ins.deinit();
        return out.items();  // (did not settle: nothing said)
    }
    ranges(&an, outs, seen, &entry, size, &mut out);
    an.ins.deinit();
    for b in 0..nb {
        an.preds[b].deinit();
    }
    return out.items();
}

// Block b's instructions over state s.
fn run_block(an: *An, b: usize, s: *mut State) void {
    for j in an.bfirst[b]..an.bfirst[b + 1] {
        let x = an.ins.at(j);
        if x.i.mk != 0 {
            apply_marks(an, s, x.i.mk, @int_cast(i32, b), j);
        }
        step(an, s, x);
    }
    let mb = an.mf.blocks.get(b);
    if mb.mk_end != 0 {
        apply_marks(an, s, mb.mk_end, @int_cast(i32, b), an.bfirst[b + 1]);
    }
}

// Where entity e is in state s, but in registers `minus` (written by the
// code the location is for): a location (its kind 0xff: none).
fn where(an: *An, s: *State, e: usize, minus: u64, prefer: i32) VLoc {
    let en = ENTS.get(e);
    let mut r = VLoc.{ var: en.var, poff: en.poff, psize: en.psize, kind: 0xff, start: 0, end: 0, reg: -1, off: 0,
                       add: s.a[e], size: en.size, ind: en.ind, gsym: "", inst: en.inst, expr: "" };
    let id = s.d[e];
    if id <= 0 {
        return r;
    }
    let nv = an.nv;
    if (id > 2 * nv) and (@as(i64, id) < an.syn0) {
        let c = CONSTS.get(@int_cast(usize, id - (2 * nv) - 1));
        if en.ind {
            return r;  // (a constant address: not one of a frame's)
        }
        r.kind = LK_CONST;
        r.off = @bit_cast(i64, c.bits);
        r.add = 0;
        r.size = c.size;
        return r;
    }
    if (id > nv) and (id <= 2 * nv) {
        // (waits for its making: computed from its operands, if they are
        // those it will be made from)
        let k = id - nv - 1;
        if (VALS.get(@int_cast(usize, k)).xop != 0) and not en.ind and pending_ok(an, k) {
            let mut ex = u.List.[u8].empty();
            if expr_op(an, s, k, minus, 0, &mut ex) {
                r.kind = LK_EXPR;
                r.expr = ex.items();
            } else {
                ex.deinit();
            }
        }
        return r;
    }
    if id <= nv {
        let x = VALS.get(@int_cast(usize, id - 1));
        if x.gsym.len > 0 {
            r.kind = LK_GADDR;
            r.gsym = x.gsym;
            r.off = r.add;
            r.add = 0;
            return r;
        }
        if x.obj {
            let o = an.t.obj_off(x.v);
            if o != NO_LOC {
                r.kind = LK_ADDR;
                r.off = o +% r.add;
                r.add = 0;
            }
            return r;
        }
    }
    // (the register it was in, if it still is: fewer pieces; else the lowest)
    let mut best: i32 = -1;
    let rm = px_regs(s, id) & ~minus;
    if rm != 0 {
        for p in @as(usize, 0)..64 {
            if (rm & (@as(u64, 1) << @as(u32, @truncate(u32, p)))) != 0 {
                let dr = an.t.dw_reg(@int_cast(i32, p));
                if (dr >= 0) and ((best < 0) or (dr == prefer)) {
                    best = dr;
                }
            }
        }
    }
    if best >= 0 {
        r.kind = LK_REG;
        r.reg = best;
        return r;
    }
    for p in px_first_slot(id)..NL {
        if s.c[p] == id {
            let so = an.t.slot_off(place_slot(p));
            if so != NO_LOC {
                r.kind = LK_SLOT;
                r.off = so;
                return r;
            }
        }
    }
    if id <= nv {
        let x = VALS.get(@int_cast(usize, id - 1));
        if (x.v.kind == ir.V_PARAM) and (x.stack_off != NO_LOC) and not an.tails {
            r.kind = LK_SLOT;
            r.off = x.stack_off;
            return r;
        }
        if (x.v.kind == ir.V_PARAM) and not en.ind {
            let mut ex = u.List.[u8].empty();
            if entry_value(an, &x, &mut ex) {
                r.kind = LK_EXPR;
                r.expr = ex.items();
            } else {
                ex.deinit();
            }
            return r;
        }
        if (x.xop != 0) and x_has(s, @int_cast(usize, id - 1)) and not en.ind {
            let mut ex = u.List.[u8].empty();
            if expr_of(an, s, id - 1, minus, 0, &mut ex) {
                r.kind = LK_EXPR;
                r.expr = ex.items();
            } else {
                ex.deinit();
            }
        }
    }
    return r;
}

// Call x (at code offset `at`; the next instructions of its block from
// index g to hi) in state s, before it: a call site.
fn call_site(an: *An, s: *State, x: *Ins, at: u64, g: usize, hi: usize) void {
    let tail = an.t.is_tail(x.i);
    let mut ret: u64 = 0;
    if not tail {
        // (the return address: the next instruction's offset)
        for j in g..hi {
            let o = offs.get(key(@int_from_ptr(an.ins.get(j).i)));
            if o != 0 {
                ret = o - 1;
                break;
            }
        }
        if ret <= at {
            return;
        }
    }
    let mut cs = CallSite.{ ret: ret, at: at, tail: tail, sym: -1, tgsym: "", toff: 0,
                            params: u.nil_slice.[CallParam]() };
    let i = x.i;
    if (i.ops.len > 0) and (i.ops[0].kind == mc.K_SYM) {
        cs.sym = i.ops[0].sym;
    } else {
        let c = @ptr_from_int(*mut ir.Value, call_ir.get(key(@int_from_ptr(i))));
        if u.notnil(c) and u.notnil(c.a) {
            // (through a pointer loaded from a datum: its address)
            let t = ir.resolve(c.a);
            if u.notnil(t) and (t.kind == ir.V_INST) and (t.op == ir.OP_LOAD) and u.notnil(t.a) {
                let mut a = ir.resolve(t.a);
                let mut off: i64 = 0;
                if (a.kind == ir.V_INST) and (a.op == ir.OP_PTRADD) and u.notnil(a.b) and (a.b.kind == ir.V_CINT) {
                    off = @bit_cast(i64, ir.cint_val(a.b));
                    a = ir.resolve(a.a);
                }
                if a.kind == ir.V_GLOBAL {
                    let gv = ir.gv_of(a);
                    if u.notnil(gv) and not gv.tls {
                        cs.tgsym = gv.name;
                        cs.toff = off;
                    }
                }
            }
        }
    }
    if not tail {
        // the arguments in registers, where the caller's frame keeps them
        let keep = ~(x.w | i.clobber);
        let mut ps = u.List.[CallParam].empty();
        for k in 1..i.ops.len {
            let o = i.ops[k];
            if (o.kind != mc.K_REG) or (o.role != mc.RU) {
                continue;
            }
            let r = mc.phys(an.mf, o.reg);
            let dr = an.t.dw_reg(r);
            let id = get_reg(an, s, r);
            if (dr < 0) or (dr >= 32) or (id == 0) {
                continue;  // (integer registers only)
            }
            let mut ex = u.List.[u8].empty();
            let mut ok = false;
            if id <= -2 {
                ex.push(OP_CONSTU);
                put_uleb(&mut ex, @bit_cast(u64, RCS.get(@int_cast(usize, -2 - id))));
                ok = true;
            } else if (id > 2 * an.nv) and (@as(i64, id) < an.syn0) {
                let c = CONSTS.get(@int_cast(usize, id - (2 * an.nv) - 1));
                ex.push(OP_CONSTU);
                put_uleb(&mut ex, c.bits);
                ok = true;
            } else if (id > 0) and (id <= an.nv) {
                ok = expr_of(an, s, id - 1, ~keep, 0, &mut ex);
            }
            if ok {
                ps.push(CallParam.{ reg: dr, expr: ex.items() });
            } else {
                ex.deinit();
            }
        }
        cs.params = ps.items();
    }
    CALLS.push(cs);
}

// The instruction the locations are found before (ranges: its block and
// index in an.ins).
let mut CUR_B: i32 = -1;
let mut CUR_J: usize = 0;

// Is value k (not made yet) made further on in the block, before which
// none of the values it is computed from is made again? Then what holds
// them now holds what it will be made from.
fn pending_ok(an: *An, k: i32) bool {
    let ku = @int_cast(usize, k);
    if (an.defb[ku] != CUR_B) or (CUR_B < 0) or (an.defi[ku] < CUR_J) or (an.defi[ku] > CUR_J + 64) {
        return false;
    }
    for t in CUR_J..an.defi[ku] {
        let dv = an.ins.get(t).defv;
        if dv >= 0 {
            for j in DEPS.get(@int_cast(usize, dv)).items() {
                if j == k {
                    return false;
                }
            }
        }
    }
    return true;
}

// DWARF expression operations (DWARF 5, 7.7.1)
const OP_CONSTU: u8 = 0x10;
const OP_CONSTS: u8 = 0x11;
const OP_DEREF_SIZE: u8 = 0x94;
const OP_FBREG: u8 = 0x91;
const OP_BREG0: u8 = 0x70;
const OP_BREGX: u8 = 0x92;
const OP_SHL: u8 = 0x24;
const OP_SHR: u8 = 0x25;
const OP_SHRA: u8 = 0x26;
const OP_AND: u8 = 0x1a;
const OP_CONST1U: u8 = 0x08;
const OP_ENTRY_VALUE: u8 = 0xa3;

fn put_uleb(o: *mut u.List.[u8], x0: u64) void {
    let mut x = x0;
    while true {
        let b = @truncate(u8, x & 0x7f);
        x = x >> 7;
        if x == 0 {
            o.push(b);
            return;
        }
        o.push(b | 0x80);
    }
}

fn put_sleb(o: *mut u.List.[u8], x0: i64) void {
    let mut x = x0;
    while true {
        let b = @truncate(u8, @bit_cast(u64, x) & 0x7f);
        x = x >> 7;
        if ((x == 0) and ((b & 0x40) == 0)) or ((x == -1) and ((b & 0x40) != 0)) {
            o.push(b);
            return;
        }
        o.push(b | 0x80);
    }
}

// The top of the stack, its low `bits` bits zero- or sign-extended.
fn put_ext(o: *mut u.List.[u8], bits: u32, signed: bool) void {
    if bits >= 64 {
        return;
    }
    if signed {
        let sh = @as(u8, @truncate(u8, 64 - bits));
        o.push(OP_CONST1U);
        o.push(sh);
        o.push(OP_SHL);
        o.push(OP_CONST1U);
        o.push(sh);
        o.push(OP_SHRA);
        return;
    }
    o.push(OP_CONSTU);
    put_uleb(o, (@as(u64, 1) << @as(u32, bits)) - 1);
    o.push(OP_AND);
}

// Pushes parameter x's value as it arrived, in an integer register: its
// entry value (DWARF 5, 2.5.1.7), which a debugger finds from the call
// sites of the callers (call_site).
fn entry_value(an: *An, x: *Val, out: *mut u.List.[u8]) bool {
    if x.entry_reg < 0 {
        return false;
    }
    let dr = an.t.dw_reg(x.entry_reg);
    if (dr < 0) or (dr >= 32) or (int_bits(x.v) == 0) {
        return false;
    }
    out.push(OP_ENTRY_VALUE);
    out.push(1);
    out.push(0x50 + @truncate(u8, @as(u32, @bit_cast(u32, dr))));  // (DW_OP_regN)
    return true;
}

// Pushes value k's operand (VALS index o, or the constant c).
fn put_operand(an: *An, s: *State, o: i32, c: i64, minus: u64, depth: i32, out: *mut u.List.[u8]) bool {
    if o < 0 {
        out.push(OP_CONSTS);
        put_sleb(out, c);
        return true;
    }
    return expr_of(an, s, o, minus, depth + 1, out);
}

// Pushes value k (a VALS index) in state s, but in registers `minus`: from
// a register or spill slot that holds it, or (a value of expr_ops, none
// of whose operands was made again since it was: State.x) computed from
// its operands. False if it cannot be.
fn expr_of(an: *An, s: *State, k: i32, minus: u64, depth: i32, out: *mut u.List.[u8]) bool {
    let id = id_val(k);
    let x = VALS.get(@int_cast(usize, k));
    let ib = int_bits(x.v);
    if ib == 0 {
        return false;
    }
    let nbytes = (ib + 7) / 8;
    let rm = px_regs(s, id) & ~minus;
    if rm != 0 {
        for p in @as(usize, 0)..64 {
            if (rm & (@as(u64, 1) << @as(u32, @truncate(u32, p)))) != 0 {
                let dr = an.t.dw_reg(@int_cast(i32, p));
                if (dr >= 0) and (dr < 32) {
                    out.push(OP_BREG0 + @truncate(u8, @as(u32, @bit_cast(u32, dr))));
                    put_sleb(out, 0);
                    return true;
                }
            }
        }
    }
    for p in px_first_slot(id)..NL {
        if s.c[p] == id {
            let so = an.t.slot_off(place_slot(p));
            if so != NO_LOC {
                out.push(OP_FBREG);
                put_sleb(out, so);
                out.push(OP_DEREF_SIZE);
                out.push(@truncate(u8, nbytes));
                return true;
            }
        }
    }
    if x.obj {
        let o = an.t.obj_off(x.v);
        if o == NO_LOC {
            return false;
        }
        out.push(OP_FBREG);
        put_sleb(out, o);
        return true;
    }
    if x.v.kind == ir.V_PARAM {
        if (x.stack_off != NO_LOC) and not an.tails {
            out.push(OP_FBREG);
            put_sleb(out, x.stack_off);
            out.push(OP_DEREF_SIZE);
            out.push(@truncate(u8, nbytes));
            return true;
        }
        return entry_value(an, &x, out);
    }
    if (x.xop == 0) or (depth >= 4) or not x_has(s, @int_cast(usize, k)) {
        return false;
    }
    return expr_op(an, s, k, minus, depth, out);
}

// Pushes value k (of expr_ops) computed from its operands.
fn expr_op(an: *An, s: *State, k: i32, minus: u64, depth: i32, out: *mut u.List.[u8]) bool {
    let x = VALS.get(@int_cast(usize, k));
    let op = x.xop;
    if not put_operand(an, s, x.xa, x.ca, minus, depth, out) {
        return false;
    }
    if op == ir.OP_ZEXT {
        put_ext(out, x.abits, false);
        return true;
    }
    if op == ir.OP_SEXT {
        put_ext(out, x.abits, true);
        return true;
    }
    if (op == ir.OP_TRUNC) or (op == ir.OP_PTRTOINT) or (op == ir.OP_INTTOPTR) {
        return true;  // (the low bits: the debugger reads the variable's bytes)
    }
    if op == ir.OP_LSHR {
        put_ext(out, x.bits, false);
    } else if (op == ir.OP_ASHR) or (op == ir.OP_MUL) {
        put_ext(out, x.bits, true);
    }
    if not put_operand(an, s, x.xb, x.cb, minus, depth, out) {
        return false;
    }
    if op == ir.OP_MUL {
        put_ext(out, x.bits, true);  // (both operands within 32 bits: see expr_ops)
    }
    if (op == ir.OP_LSHR) or (op == ir.OP_ASHR) or (op == ir.OP_SHL) {
        put_ext(out, x.bits, false);  // (the count: what the instruction read of it)
    }
    let mut code: u8 = OP_SHRA;
    if (op == ir.OP_ADD) or (op == ir.OP_PTRADD) {
        code = 0x22;
    } else if op == ir.OP_SUB {
        code = 0x1c;
    } else if op == ir.OP_MUL {
        code = 0x1e;
    } else if op == ir.OP_AND {
        code = OP_AND;
    } else if op == ir.OP_OR {
        code = 0x21;
    } else if op == ir.OP_XOR {
        code = 0x27;
    } else if op == ir.OP_SHL {
        code = OP_SHL;
    } else if op == ir.OP_LSHR {
        code = OP_SHR;
    }
    out.push(code);
    return true;
}

fn same_loc(a: *VLoc, b: *VLoc) bool {
    return (a.kind == b.kind) and (a.reg == b.reg) and (a.off == b.off) and (a.add == b.add) and (a.size == b.size) and
           (a.gsym.ptr == b.gsym.ptr) and u.str_eq(a.expr, b.expr);
}

// The locations of every entity from code offset `at` on (in state s, but
// in registers `minus`; none at all: `none`), each one a piece of out
// when it differs from the one before (open: each entity's last piece in
// out + 1, 0: none open).
//
// An entity's location is found again (where) only where it may differ
// from the one found last for it: where depends on the entity's identity
// and constant, the places that hold the identity (the registers of those
// that `minus` names), `none`, and for a value computed from others (or
// waiting for its making) on the places of those: such an entity is
// looked at each time. The others are looked at again when their identity
// or constant changed, a place that held or holds the identity changed
// since (EM: the emission at which each identity's places last changed),
// or `minus` names other registers among those holding it.
fn emit_at(an: *An, em: *mut Em, s: *State, minus: u64, none: bool, at: u64, open: []mut usize,
           out: *mut u.List.[VLoc]) void {
    em.n += 1;
    for l in 0..NL {
        let c = s.c[l];
        if c != em.c[l] {
            em_touch(em, em.c[l]);
            em_touch(em, c);
            em.c[l] = c;
        }
    }
    emit_each(an, em, s, minus, none, at, open, out);
    PX_ON = false;
}

// The incremental emission's tables (ranges makes them for a function).
struct Em {
    n: u64,          // the emissions so far
    c: []mut i32,    // each place's identity as last seen
    ids: u.U64Map,   // an identity -> the emission at which a place that holds it last changed (but:)
    low: []mut u64,  // the same for the identities 1 .. lown (the values, made or waiting, and the constants)
    lown: i32,
    vol: []mut bool,  // per identity 1 .. lown: looked at each time (a value computed from others, or waiting)
    at: []mut u64,    // per entity: the emission of its last where (0: none)
    d: []mut i32,     // and that where's inputs
    a: []mut i64,
    minus: []mut u64,
    none: []mut bool,
}

fn em_new(an: *An, ne: usize) Em {
    let lown = @truncate(i32, an.syn0 - 1);
    let n = @int_cast(usize, lown) + 1;
    let mut em = Em.{ n: 0, c: u.newn.[i32](NL + 1), ids: u.U64Map.empty(), low: u.newn.[u64](n), lown: lown,
                      vol: u.newn.[bool](n), at: u.newn.[u64](ne + 1), d: u.newn.[i32](ne + 1), a: u.newn.[i64](ne + 1),
                      minus: u.newn.[u64](ne + 1), none: u.newn.[bool](ne + 1) };
    let nv = an.nv;
    for id in 0..n {
        em.low[id] = 0;
        let k = @int_cast(i32, id);
        em.vol[id] = ((k > nv) and (k <= 2 * nv)) or ((k > 0) and (k <= nv) and (VALS.get(id - 1).xop != 0));
    }
    for l in 0..NL {
        em.c[l] = 0;
    }
    for e in 0..ne {
        em.at[e] = 0;
    }
    return em;
}

fn em_touch(em: *mut Em, id: i32) void {
    if (id > 0) and (id <= em.lown) {
        em.low[@int_cast(usize, id)] = em.n;
    } else if id != 0 {
        em.ids.put(@as(u64, @bit_cast(u32, id)), em.n);
    }
}

// The registers of mask m that hold id in s.
fn held_in(s: *State, m: u64, id: i32) u64 {
    let mut r: u64 = 0;
    let mut x = m;
    while x != 0 {
        let p = @truncate(u32, @ctz(x));
        x = x & (x - 1);
        if s.c[@as(usize, p)] == id {
            r = r | (@as(u64, 1) << p);
        }
    }
    return r;
}

// Is entity e's location the one found for it last (see emit_at)?
fn em_same(an: *An, em: *mut Em, s: *State, e: usize, minus: u64, none: bool) bool {
    let id = s.d[e];
    if (em.at[e] == 0) or (em.d[e] != id) or (em.a[e] != s.a[e]) or (em.none[e] != none) {
        return false;
    }
    if (id > 0) and (id <= em.lown) {
        if em.vol[@int_cast(usize, id)] or (em.low[@int_cast(usize, id)] > em.at[e]) {
            return false;
        }
    } else if em.ids.get(@as(u64, @bit_cast(u32, id))) > em.at[e] {
        return false;
    }
    return held_in(s, minus, id) == held_in(s, em.minus[e], id);
}

// (emit_at's work)
fn emit_each(an: *An, em: *mut Em, s: *State, minus: u64, none: bool, at: u64, open: []mut usize,
             out: *mut u.List.[VLoc]) void {
    for e in 0..an.ne {
        if (s.d[e] <= 0) and (open[e] == 0) {
            em.at[e] = 0;
            continue;  // (not known, and no piece open: none still)
        }
        if em_same(an, em, s, e, minus, none) {
            continue;
        }
        em.at[e] = em.n;
        em.d[e] = s.d[e];
        em.a[e] = s.a[e];
        em.minus[e] = minus;
        em.none[e] = none;
        if not PX_ON {
            px_build(s);
        }
        let mut prefer: i32 = -1;
        if (open[e] != 0) and (out.at(open[e] - 1).kind == LK_REG) {
            prefer = out.at(open[e] - 1).reg;
        }
        let mut w = where(an, s, e, minus, prefer);
        if none {
            w.kind = 0xff;
        }
        let o = open[e];
        if o != 0 {
            let p = out.at(o - 1);
            if (w.kind != 0xff) and same_loc(p, &w) {
                drop_expr(w.expr);
                continue;
            }
            p.end = at;
            open[e] = 0;
        }
        if w.kind != 0xff {
            w.start = at;
            w.end = at;
            out.push(w);
            open[e] = out.len;
        } else {
            drop_expr(w.expr);
        }
    }
}

// The pieces of the entities' locations over the encoded code: each block's
// start (the state it is entered with) and each visited instruction's group
// (the state before it, but what the group writes), in code order.
fn ranges(an: *An, outs: []State, seen: []bool, entry: *State, size: u64, out: *mut u.List.[VLoc]) void {
    let nb = an.nb;
    let ne = an.ne;
    let mut em = em_new(an, ne);
    let open = u.newn.[usize](ne + 1);
    for e in 0..ne {
        open[e] = 0;
    }
    // the blocks in code order
    let order = u.newn.[usize](nb + 1);
    for b in 0..nb {
        order[b] = b;
    }
    for k in 1..nb {
        let mut j = k;
        while (j > 0) and (boffs.get(order[j - 1]) > boffs.get(order[j])) {
            let y = order[j];
            order[j] = order[j - 1];
            order[j - 1] = y;
            j -= 1;
        }
    }
    let mut s = st_new(ne);
    // (the code before the first block's: the prologue, at the entry)
    CUR_B = -1;
    emit_at(an, &mut em, entry, 0, false, 0, open, out);
    let mut last: u64 = 0;
    for k in 0..nb {
        let b = order[k];
        let bo = boffs.get(b);
        if bo == 0xffff_ffff_ffff_ffff {
            continue;
        }
        let unreached = an.rpon[b] < 0;
        if unreached {
            st_clear(&mut s, ne);
        } else {
            meet(an, b, outs, seen, entry, &mut s);
        }
        let lo = an.bfirst[b];
        let hi = an.bfirst[b + 1];
        // the first visited instruction's offset
        let mut first: u64 = 0xffff_ffff_ffff_ffff;
        for j in lo..hi {
            let o = offs.get(key(@int_from_ptr(an.ins.get(j).i)));
            if o != 0 {
                first = o - 1;
                break;
            }
        }
        CUR_B = @int_cast(i32, b);
        CUR_J = lo;
        if (bo >= last) and ((first == 0xffff_ffff_ffff_ffff) or (bo < first)) {
            emit_at(an, &mut em, &s, 0, unreached, bo, open, out);
            last = bo;
        }
        if DBGF {
            u.eprint(u.f2("block %s at %s\n", u.idec(@int_cast(i32, b)), u.hex16(bo)));
        }
        let mut j = lo;
        while j < hi {
            let x = an.ins.at(j);
            if x.i.mk != 0 {
                apply_marks(an, &mut s, x.i.mk, @int_cast(i32, b), j);
            }
            if DBGF {
                let mut t = u.f2("  %s k%s", u.hex16(offs.get(key(@int_from_ptr(x.i)))), u.idec(@as(i32, x.kind)));
                for e in 0..ne {
                    t = u.f3("%s e%s=%s", t, u.idec(@int_cast(i32, e)), u.idec(s.d[e]));
                }
                for l in 0..NL {
                    if s.c[l] != 0 {
                        t = u.f3("%s p%s:%s", t, u.idec(@int_cast(i32, l)), u.idec(s.c[l]));
                    }
                }
                u.eprint(u.f1("%s\n", t));
            }
            let o = offs.get(key(@int_from_ptr(x.i)));
            if o != 0 {
                // the group: this instruction and those encoded with it
                let mut minus = x.w;
                let mut exit = x.kind == 4;
                let mut g = j + 1;
                while (g < hi) and (offs.get(key(@int_from_ptr(an.ins.get(g).i))) == 0) {
                    minus = minus | an.ins.get(g).w;
                    exit = exit or (an.ins.get(g).kind == 4);
                    g += 1;
                }
                // (one machine instruction: a debugger stops at its start,
                // before it writes its registers, and nowhere else in it)
                if (g == j + 1) and (g < hi) and (x.i.clobber == 0) {
                    let nx = offs.get(key(@int_from_ptr(an.ins.get(g).i)));
                    if (nx > o) and an.t.single(x.i, nx - o) {
                        minus = 0;
                    }
                }
                if o - 1 >= last {
                    CUR_J = j;
                    emit_at(an, &mut em, &s, minus, exit or unreached, o - 1, open, out);
                    last = o - 1;
                }
                if ((x.i.clobber != 0) or an.t.is_tail(x.i)) and not unreached {
                    call_site(an, &s, x, o - 1, g, hi);
                }
            }
            step(an, &mut s, x);
            j += 1;
        }
    }
    em.ids.deinit();
    for e in 0..ne {
        if open[e] != 0 {
            out.at(open[e] - 1).end = size;
        }
    }
    // (pieces of no length out)
    let mut n: usize = 0;
    for k in 0..out.len {
        let p = out.get(k);
        if p.end > p.start {
            out.set(n, p);
            n += 1;
        } else {
            drop_expr(p.expr);
        }
    }
    out.len = n;
}
