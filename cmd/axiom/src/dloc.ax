// =============================================================================
// dloc.ax - where the variables of optimized code are (-g, -O1 and up: the
// location lists of dwarf.ax), for the native code generators (x64.ax,
// a64.ax), from their machine code after register allocation.
//
// What is followed: the marks of the IR (ir.dbg_mark), each of which says
// that from its place on a variable (or a piece of one: scalar replacement
// takes structures apart) is a value, or not known (a kill). Instruction
// selection puts them before the machine instructions of the IR they came
// before (before), and they stay there as the instructions around them
// are removed (mach.remove). A variable's value may be a value an
// instruction makes, a parameter, a constant, a frame object's address, a
// value plus a constant (the base it was folded into its uses from: in the
// base's register, plus the constant), or a phi.
//
// The analysis (compute): forward over the machine CFG, what each
// allocatable register and spill slot holds (C: a value's identity, or
// nothing known) and what each variable piece is (D: an identity, plus a
// constant), at each instruction. An identity is a value as its latest
// making left it: the instruction that makes a value makes every other
// copy of it stale (a loop's next round), and a variable that was the
// stale one is no longer known; a mark whose value is made only later on
// (sunk past it) waits for that making. At a join, what all the paths
// agree on stays; a phi is in the registers that hold each path's input at
// the ends of the paths; and a variable the paths disagree on is a merge
// of its own (an identity of the join's), in the registers that hold the
// variable on every path. The meet starts from "anything" (paths not seen
// yet) and settles at a fixed point, every part of which holds by
// induction over a run of the code.
//
// The work is that of what changes (State): a state keeps what is known
// (few places and variables at a time) with, for each identity, the places
// that hold it and the variables that are it; a block's state at its end is
// kept as what is known in it (SState); a join looks at what its paths
// know; and the locations are found again (emit_at) only for the variables
// whose inputs changed since they were found last.
//
// What is relied on (the invariant): after register allocation, a machine
// instruction's register operands written (RD, RUD, RE), its clobbers (a
// call's) and the copies (is_move), spills and reloads (MInst.spill) say
// all that changes the allocatable registers and spill slots. A range of
// code (one machine instruction's, or a few encoded together) gets the
// places that hold its variables before it and that it does not write: a
// debugger stopped in it, or in a call it makes (at its return address),
// reads the value; a callee-saved register keeps its value across a call,
// which a debugger reads through the callee's frame. Code the encoder adds
// around instructions (a prologue, alignment) writes none of the
// allocatable registers; a return or a call in tail position takes the
// frame down: no location there.
// =============================================================================
import "dbginfo.ax" as dbi;
import "ir.ax" as ir;
import "mach.ax" as mc;
import "util.ax" as u;

/// A location piece of variable `var` (an index in its function's dbinfo
/// variables; its `psize` bytes at `poff`, psize 0: all of it), from code
/// offset start to end: LK_REG, in DWARF register `reg` (plus `add`, if not
/// 0: the value is the register's contents plus add); LK_SLOT, at `off` from
/// the CFA (plus add: the value is the `size` bytes there plus add);
/// LK_CONST, the constant `off` (its `size` bytes); LK_ADDR, the address
/// `off` from the CFA; LK_GADDR, the address of a datum plus `off`. With
/// `ind`, the variable is in memory at the address that is that value.
pub struct VLoc {
    var: u32,
    poff: u32,
    psize: u32,
    kind: u8,
    start: u64,
    end: u64,
    reg: i32,
    off: i64,
    add: i64,
    size: u32,
    ind: bool,   // the variable is in memory at the value (a variable length array: its address)
    gsym: []u8,  // LK_GADDR: the datum
    inst: u32,   // a variable of a function inlined: its inline instance (ir.DbgMark.inst; var indexes its
                 // function's), 0: the function's own
    expr: []u8,  // LK_EXPR: a DWARF expression that computes the value (plus add; without DW_OP_stack_value)
}

pub const LK_REG: u8 = 0;
pub const LK_CONST: u8 = 1;
pub const LK_SLOT: u8 = 2;
pub const LK_ADDR: u8 = 3;
pub const LK_GADDR: u8 = 4;  // the address of datum gsym, plus off
pub const LK_EXPR: u8 = 5;
pub const LK_TEXPR: u8 = 7;   // as LK_EXPR, with typed operations (DWARF 5, 2.5.1.6: base types, TY_*)
pub const LK_WLOCAL: u8 = 6;  // WebAssembly: in local `reg` (DW_OP_WASM_location 0)   // computed from other values (expr): a value made from them that no place holds

// The base types typed operations of an LK_TEXPR expression name
// (DW_OP_regval_type, DW_OP_deref_type, DW_OP_const_type, DW_OP_convert,
// DW_OP_reinterpret): each one's operand, the offset of a base type's entry
// in the unit, is TY_PAD bytes of ULEB128 holding TY_* (padded with
// continuation bits), which dwarf.ax replaces with the entry's offset
// when it writes the location (the unit is laid out after the locations
// are found).
pub const TY_F32: u8 = 1;
pub const TY_F64: u8 = 2;
pub const TY_I32: u8 = 3;
pub const TY_I64: u8 = 4;
pub const TY_U32: u8 = 5;
pub const TY_U64: u8 = 6;
pub const TY_PAD: usize = 5;

/// Floating-point values computed with DWARF's typed operations (LK_TEXPR):
/// on for the targets whose system debugger evaluates them (x86-64 Linux:
/// measured with hand-written expressions; the AArch64 one evaluates none).
pub let mut g_typed: bool = false;

/// What the target tells of its machine code.
pub struct Tgt {
    dw_reg: fn(i32) i32,              // a physical register's DWARF number (-1: none)
    is_exit: fn(*mc.MInst) bool,      // a return or a call in tail position
    is_tail: fn(*mc.MInst) bool,      // a call in tail position (it writes the stack arguments' area)
    slot_off: fn(i32) i64,            // a spill slot's offset from the CFA (NO_LOC: none)
    obj_off: fn(*ir.Value) i64,       // the frame slot of an alloca: its offset from the CFA (NO_LOC: none)
    imm_of: fn(*mc.MInst) i64,        // the constant an instruction puts in its register (all of it; NO_LOC: none)
    may_store: fn(*mc.MInst) bool,    // may an instruction write its memory operand (else it only reads it)
    single: fn(*mc.MInst, u64) bool,  // is an instruction (of that many bytes of code) one machine instruction, not a call
    alloc: u64,                       // the allocatable physical registers
}

pub const NO_LOC: i64 = -0x7fff_ffff_ffff_ffff;

/// A call the function makes (DWARF 5, 3.4: a call site): its code offset
/// after the call (a call in tail position: of the jump), the callee
/// (`sym`, a symbol; or, called through a pointer that a datum holds,
/// `tgsym` plus `toff`, the address of the datum holding it; else none),
/// and the arguments whose values are known where the call returns.
pub struct CallSite {
    ret: u64,
    at: u64,  // (the call's own offset)
    tail: bool,
    sym: i32,     // -1: none
    tgsym: []u8,  // (empty: none)
    toff: i64,
    params: []CallParam,
}

/// An argument of a call site: in DWARF register `reg` at the call, the
/// value DWARF expression `expr` computes (without DW_OP_stack_value) in
/// the caller's frame while the callee runs.
pub struct CallParam {
    reg: i32,
    expr: []u8,
}

/// The call sites of the function compute did last.
pub fn calls() []CallSite {
    return CALLS.items();
}

// A location's expression's memory (an expression is made for one location
// alone: where's, call_site's).
fn drop_expr(x: []u8) void {
    if x.len > 0 {
        u.free(@ptr_from_int(*mut void, @int_from_ptr(x.ptr)));
    }
}

/// Gives back what compute and calls returned for a function, once the
/// debug information has it.
pub fn release(vl: []VLoc, cs: []CallSite) void {
    for x in vl {
        drop_expr(x.expr);
    }
    if vl.len > 0 {
        u.free(@ptr_from_int(*mut void, @int_from_ptr(vl.ptr)));
    }
    for c in cs {
        for q in c.params {
            drop_expr(q.expr);
        }
        if c.params.len > 0 {
            u.free(@ptr_from_int(*mut void, @int_from_ptr(c.params.ptr)));
        }
    }
    if cs.len > 0 {
        u.free(@ptr_from_int(*mut void, @int_from_ptr(cs.ptr)));
    }
}

// (in code order)
pub let mut CALLS: u.List.[CallSite] = u.List.[CallSite].{ data: @ptr_from_int(*mut CallSite, 0), len: 0, cap: 0 };
// each call's machine instruction -> its IR call (+ 0: the address)
let mut call_ir: u.SymMap.[usize] = u.SymMap.[usize].{ keys: @ptr_from_int(*mut usize, 0),
                                                       vals: @ptr_from_int(*mut usize, 0), cap: 0, len: 0 };

// A variable piece followed in the function being compiled.
struct Ent {
    var: u32,
    poff: u32,
    psize: u32,
    size: u32,  // its values' bytes
    ind: bool,  // its values are its address (dbinfo's indirect)
    inst: u32,  // (an inlined function's variable: its inline instance)
    nxt: i32,   // the entity of the same var and piece of another instance (-1: none)
}

// A value the marks name (or a phi's input, or the base of one).
struct Val {
    v: *mut ir.Value,
    def: *mut mc.MInst,  // the instruction that makes it (nil: none found)
    def_op: usize,       // its operand v's register is
    entry_reg: i32,      // a parameter: the physical register it arrives in (-1: none)
    stack_off: i64,      // a parameter: its stack slot's offset from the CFA (NO_LOC: none)
    obj: bool,           // an alloca: its value is the frame object's address
    gsym: []u8,          // a datum's address: its name (empty: not one)
    base: i32,           // a value that is another plus `add` (folded into its uses): that one (-1: none)
    add: i64,
    phi_blk: i32,  // a phi: its machine block (-1: not a phi, or none)
    phi_ops: u.List.[PhiIn],
    // an integer or floating-point operation of one or two operands (see
    // expr_of, fexpr_ops): the IR operation (0: none), its operands (VALS
    // indexes, -1: the constant ca, cb), its width and its first operand's
    // in bits
    xop: i32,
    xa: i32,
    xb: i32,
    ca: i64,
    cb: i64,
    bits: u32,
    abits: u32,
    dep: i32,  // the least depth it was reached at (val_of: followed as far as from there)
}

// A phi's input: from IR block `from`, the value (VALS index, -1: none) or
// constant (CONSTS index, -1: none).
struct PhiIn {
    from: *mut ir.Block,
    val: i32,
    cst: i32,
}

struct Cst {
    bits: u64,
    size: u32,
}

// A mark in the machine code (mc.mk_next chains them): entity `ent` is
// value `val` (a VALS index), or constant `cst`, or not known (both -1).
struct MMark {
    ent: i32,
    val: i32,
    cst: i32,
    add: i64,  // (the value plus this)
}

let mut ENTS: u.List.[Ent] = u.List.[Ent].{ data: @ptr_from_int(*mut Ent, 0), len: 0, cap: 0 };
let mut VALS: u.List.[Val] = u.List.[Val].{ data: @ptr_from_int(*mut Val, 0), len: 0, cap: 0 };
let mut CONSTS: u.List.[Cst] = u.List.[Cst].{ data: @ptr_from_int(*mut Cst, 0), len: 0, cap: 0 };
let mut MKS: u.List.[MMark] = u.List.[MMark].{ data: @ptr_from_int(*mut MMark, 0), len: 0, cap: 0 };
// a value (its address) -> its index in VALS + 1
let mut by_val: u.SymMap.[i32] = u.SymMap.[i32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0),
                                                  cap: 0, len: 0 };
// an entity's (var << 40 | poff << 20 | psize... as a key) index + 1
let mut by_ent: u.SymMap.[i32] = u.SymMap.[i32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0),
                                                  cap: 0, len: 0 };
// the code offset of each machine instruction the encoder visited is in it
// (MInst.doff, of the pass OFF_GEN: offset_of), and of each block in boffs
let mut OFF_GEN: u8 = 1;
let mut boffs: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };
// the IR block of each machine block
let mut mb_ir: u.List.[*mut ir.Block] = u.List.[*mut ir.Block].{ data: @ptr_from_int(*mut *mut ir.Block, 0), len: 0,
                                                                 cap: 0 };
// the marks of the IR instruction being selected, not placed yet (a chain
// of MKS, mach.ax's form), and the instruction they go after
let mut pend: i32 = 0;
let mut pend_after: *mut mc.MInst = @ptr_from_int(*mut mc.MInst, 0);
let mut pend_blk: *mut mc.MBlock = @ptr_from_int(*mut mc.MBlock, 0);
let mut FN: *mut ir.Func = @ptr_from_int(*mut ir.Func, 0);
// the variables of FN, and of the function whose variables before() looked at last
let mut OWN_P: *dbi.DVar = @ptr_from_int(*dbi.DVar, 0);
let mut OWN_N: usize = 0;
let mut LAST_OWNER: *mut ir.Func = @ptr_from_int(*mut ir.Func, 0);
let mut LAST_P: *dbi.DVar = @ptr_from_int(*dbi.DVar, 0);
let mut LAST_N: usize = 0;

/// Are variables followed in the function being compiled?
pub let mut active: bool = false;

fn key(p: usize) []u8 {
    return @slice_from_ptr(@ptr_from_int(*u8, p), 1);
}

/// Can a variable of type ty (or its piece of psize bytes) be value v (in
/// one register, or a WebAssembly local)?
pub fn fits_var(v: *ir.Value, ty: i32, psize: u32) bool {
    return fits(v, ty, psize);
}

// Can a variable of the type `ty` (a dbinfo type), or the piece of `psize`
// bytes of one (psize > 0), be held by value v (an integer, pointer or
// floating value of its size in one register)?
fn fits(v: *ir.Value, ty: i32, psize: u32) bool {
    if ty < 0 {
        return false;
    }
    let t = v.ty;
    let k = t.kind;
    if (k != ir.T_INT) and (k != ir.T_PTR) and (k != ir.T_FLOAT) and (k != ir.T_VEC) {
        return false;
    }
    if (k == ir.T_INT) and ((t.bits < 8) or (t.bits > 64) or ((t.bits % 8) != 0)) {
        return false;
    }
    // (a vector or a 128-bit floating value: in one vector register, whose
    // DWARF number names all of it)
    if ((k == ir.T_VEC) or (k == ir.T_FLOAT)) and (t.size != 4) and (t.size != 8) and (t.size != 16) {
        return false;
    }
    if psize > 0 {
        return @as(u64, psize) == t.size;
    }
    let d = dbi.types.at(@int_cast(usize, ty));
    let mut dk = d.kind;
    let mut dd = d;
    while (dk == dbi.DK_TYPEDEF) or (dk == dbi.DK_CONST) or (dk == dbi.DK_VOLATILE) or (dk == dbi.DK_RESTRICT) {
        if dd.target < 0 {
            return false;
        }
        dd = dbi.types.at(@int_cast(usize, dd.target));
        dk = dd.kind;
    }
    if (dk == dbi.DK_ARRAY) and (k == ir.T_VEC) {
        return dd.size == t.size;  // (a vector type: its lanes in order, as in memory)
    }
    if (dk != dbi.DK_BASE) and (dk != dbi.DK_POINTER) and (dk != dbi.DK_ENUM) {
        return false;
    }
    if (dk == dbi.DK_BASE) and (dd.bits > 0) {
        return false;  // (a bit-precise integer: its bits beyond its width are not kept)
    }
    return dd.size == t.size;
}

// Can a variable of type ty (or its piece of psize bytes) be the low bytes
// of integer value v (its bytes, 0: no)? An integer variable narrower than v.
fn low_fits(v: *ir.Value, ty: i32, psize: u32) u32 {
    if u.isnil(v) or (v.kind == ir.V_CINT) or (v.kind == ir.V_ZERO) or (v.ty.kind != ir.T_INT) or (v.ty.size > 8) or
       (ty < 0) {
        return 0;
    }
    if psize > 0 {
        if @as(u64, psize) < v.ty.size {
            return psize;
        }
        return 0;
    }
    let mut d = dbi.types.at(@int_cast(usize, ty));
    let mut n: i32 = 0;
    while ((d.kind == dbi.DK_TYPEDEF) or (d.kind == dbi.DK_CONST) or (d.kind == dbi.DK_VOLATILE)) and
          (d.target >= 0) and (n < 16) {
        d = dbi.types.at(@int_cast(usize, d.target));
        n += 1;
    }
    if ((d.kind != dbi.DK_BASE) and (d.kind != dbi.DK_ENUM)) or (d.bits > 0) or (d.size == 0) or (d.size >= v.ty.size) {
        return 0;
    }
    if (d.kind == dbi.DK_BASE) and (d.enc != dbi.ATE_SIGNED) and (d.enc != dbi.ATE_UNSIGNED) and
       (d.enc != dbi.ATE_SIGNED_CHAR) and (d.enc != dbi.ATE_UNSIGNED_CHAR) {
        return 0;
    }
    return @truncate(u32, d.size);
}

fn ent_of(var: i32, poff: u32, psize: u32, size: u32, inst: u32) i32 {
    let kv = (@as(u64, @bit_cast(u32, var)) << 40) | (@as(u64, poff) << 20) | @as(u64, psize & 0xfffff);
    let kk = key(@truncate(usize, kv + 1));
    let k = by_ent.get(kk);
    let mut j = k - 1;
    while j >= 0 {
        let en = ENTS.at(@int_cast(usize, j));
        if en.inst == inst {
            if en.size == 0 {
                en.size = size;  // (a kill made it first)
            }
            return j;
        }
        j = en.nxt;
    }
    ENTS.push(Ent.{ var: @bit_cast(u32, var), poff: poff, psize: psize, size: size, ind: false, inst: inst,
                    nxt: k - 1 });
    by_ent.put(kk, @int_cast(i32, ENTS.len));
    return @int_cast(i32, ENTS.len - 1);
}

fn cst_of(v: *ir.Value) i32 {
    let vk = v.kind;
    let mut bits: u64 = 0;
    if vk == ir.V_CINT {
        bits = ir.cint_val(v);
    } else if vk == ir.V_CFP {
        let fv = ir.fv_of(v);
        if v.ty.size == 4 {
            bits = @as(u64, ir.f32_bits(fv));
        } else {
            bits = @bit_cast(u64, fv);
        }
    } else if vk != ir.V_ZERO {
        return -1;
    }
    let size = @truncate(u32, v.ty.size);
    if (size == 0) or (size > 8) {
        return -1;
    }
    for k in 0..CONSTS.len {
        let c = CONSTS.get(k);
        if (c.bits == bits) and (c.size == size) {
            return @int_cast(i32, k);
        }
    }
    CONSTS.push(Cst.{ bits: bits, size: size });
    return @int_cast(i32, CONSTS.len - 1);
}

// The VALS index of value v of function f (made for it; -1: one not
// followed). depth: how far through bases and phis.
fn val_of(v: *mut ir.Value, depth: i32) i32 {
    let k = by_val.get(key(@int_from_ptr(v)));
    if k > 0 {
        // (reached again nearer: followed again from there, as if first
        // reached there, whichever path reached it first)
        let me = k - 1;
        let x = VALS.at(@int_cast(usize, me));
        if (depth < x.dep) and (v.kind == ir.V_INST) {
            x.dep = depth;
            follow(v, me, depth);
        }
        return me;
    }
    let vk = v.kind;
    if vk == ir.V_PARAM {
        let mut mine = false;
        for p in FN.params {
            mine = mine or (p == v);
        }
        if not mine {
            return -1;
        }
    } else if vk == ir.V_INST {
        if u.isnil(v.blk) or (@int_from_ptr(v.blk.fnp) != @int_from_ptr(FN)) {
            return -1;
        }
    } else if vk == ir.V_GLOBAL {
        let g = ir.gv_of(v);
        if u.isnil(g) or g.tls {
            return -1;  // (a thread-local's address is the thread's)
        }
    } else {
        return -1;
    }
    VALS.push(Val.{ v: v, def: u.nil.[mc.MInst](), def_op: 0, entry_reg: -1, stack_off: NO_LOC, obj: false, gsym: "",
                    base: -1, add: 0, phi_blk: -1, phi_ops: u.List.[PhiIn].empty(), xop: 0, xa: -1, xb: -1, ca: 0,
                    cb: 0, bits: 0, abits: 0, dep: depth });
    let me = @int_cast(i32, VALS.len - 1);
    by_val.put(key(@int_from_ptr(v)), me + 1);
    if vk == ir.V_GLOBAL {
        VALS.at(@int_cast(usize, me)).gsym = ir.gv_of(v).name;
        return me;
    }
    if vk != ir.V_INST {
        return me;
    }
    follow(v, me, depth);
    return me;
}

// Follows instruction v (VALS index me), reached at `depth`, to the values
// it is made from (val_of): its operation's operands, base, phi inputs.
fn follow(v: *mut ir.Value, me: i32, depth: i32) void {
    let op = v.op;
    if depth < XDEPTH {
        expr_ops(v, me, depth);
    }
    if op == ir.OP_ALLOCA {
        VALS.at(@int_cast(usize, me)).obj = true;
    } else if (depth < 4) and ((op == ir.OP_PTRADD) or (op == ir.OP_ADD) or (op == ir.OP_SUB)) and u.notnil(v.b) and
              (v.b.kind == ir.V_CINT) and ((op == ir.OP_PTRADD) or (v.ty.kind == ir.T_INT)) {
        // (a base plus a constant: in the base's place, if not in one of its own)
        let mut c = @bit_cast(i64, ir.cint_val(v.b));
        let bits = v.b.ty.bits;
        if (bits > 0) and (bits < 64) {
            let sh = @as(u32, @int_cast(u32, 64 - bits));
            c = (c << sh) >> sh;  // (sign-extended: the offset is two's complement)
        }
        if op == ir.OP_SUB {
            c = 0 -% c;
        }
        let b = val_of(v.a, depth + 1);
        if b >= 0 {
            let x = VALS.at(@int_cast(usize, me));
            x.base = b;
            x.add = c;
        }
    } else if (depth < 4) and (op == ir.OP_TRUNC) and (v.ty.kind == ir.T_INT) and (v.a.ty.kind == ir.T_INT) {
        // (its low bytes: in the wider value's place)
        let b = val_of(v.a, depth + 1);
        if b >= 0 {
            VALS.at(@int_cast(usize, me)).base = b;
        }
    } else if (op == ir.OP_PHI) and (depth < 6) {
        let bs = ir.bs_of(v);
        let mut ins = u.List.[PhiIn].empty();
        for j in 0..v.xs.len {
            let o = ir.resolve(v.xs.get(j));
            let mut vi: i32 = -1;
            let mut ci: i32 = -1;
            if u.notnil(o) {
                ci = cst_of(o);
                if ci < 0 {
                    vi = val_of(o, depth + 1);
                }
            }
            ins.push(PhiIn.{ from: bs.get(j), val: vi, cst: ci });
        }
        let x = VALS.at(@int_cast(usize, me));
        x.phi_ops.deinit();  // (followed before, from further)
        x.phi_ops = ins;
    }
}

// How deep an expression (expr_of) computes a value from others: the
// operations' operands are followed (val_of, expr_ops) as far, and DEPS
// further; and no further than XBYTES bytes of DWARF (the operations
// that reach an operand by several paths compute it for each).
const XDEPTH: i32 = 8;
const XBYTES: usize = 192;

// An integer or pointer value of at most 64 bits (its width, 0: not one).
fn int_bits(v: *ir.Value) u32 {
    let t = v.ty;
    if t.kind == ir.T_PTR {
        return @truncate(u32, 8 * t.size);
    }
    if (t.kind == ir.T_INT) and (t.bits >= 1) and (t.bits <= 64) {
        return @as(u32, @int_cast(u32, t.bits));
    }
    return 0;
}

// A floating-point value of 32 or 64 bits (its width, 0: not one), when
// expressions compute them (g_typed).
fn float_bits(v: *ir.Value) u32 {
    let t = v.ty;
    if g_typed and (t.kind == ir.T_FLOAT) and ((t.bits == 32) or (t.bits == 64)) {
        return @as(u32, @int_cast(u32, t.bits));
    }
    return 0;
}

// A floating-point operand of an expression (float_bits): its VALS index
// (-1: a constant, its bits in *c; -2: neither).
fn fexpr_operand(o0: *mut ir.Value, depth: i32, c: *mut i64) i32 {
    let o = ir.resolve(o0);
    if u.isnil(o) or (float_bits(o) == 0) {
        return -2;
    }
    if o.kind == ir.V_CFP {
        let fv = ir.fv_of(o);
        if o.ty.size == 4 {
            c.* = @as(i64, ir.f32_bits(fv));
        } else {
            c.* = @bit_cast(i64, fv);
        }
        return -1;
    }
    if o.kind == ir.V_ZERO {
        c.* = 0;
        return -1;
    }
    if (o.kind != ir.V_INST) and (o.kind != ir.V_PARAM) {
        return -2;
    }
    let k = val_of(o, depth + 1);
    if k < 0 {
        return -2;
    }
    return k;
}

// An operand of an expression: its VALS index (-1: a constant, in *c; -2:
// neither).
fn expr_operand(o0: *mut ir.Value, depth: i32, c: *mut i64) i32 {
    let o = ir.resolve(o0);
    if u.isnil(o) or (int_bits(o) == 0) {
        return -2;
    }
    if (o.kind == ir.V_CINT) or (o.kind == ir.V_ZERO) {
        let mut x: i64 = 0;
        if o.kind == ir.V_CINT {
            x = @bit_cast(i64, ir.cint_val(o));
            let bits = int_bits(o);
            if bits < 64 {
                let sh = 64 - bits;
                x = (x << sh) >> sh;  // (sign-extended)
            }
        }
        c.* = x;
        return -1;
    }
    if (o.kind != ir.V_INST) and (o.kind != ir.V_PARAM) {
        return -2;
    }
    let k = val_of(o, depth + 1);
    if k < 0 {
        return -2;
    }
    return k;
}

// Value v (VALS index me) as an operation on other values and constants,
// which the debugger computes where no place holds v (expr_of): the
// integer operations whose low bits the DWARF stack machine's 64-bit
// arithmetic gives (DWARF 5, 2.5.1.4; narrower values extended where the
// high bits matter).
fn expr_ops(v: *mut ir.Value, me: i32, depth: i32) void {
    let op = v.op;
    let bits = int_bits(v);
    if u.isnil(v.a) {
        return;
    }
    if (float_bits(v) > 0) or ((op == ir.OP_BITCAST) and (bits > 0)) {
        fexpr_ops(v, me, depth);
        return;
    }
    if bits == 0 {
        return;
    }
    // (the system's debugger computes the stack machine's multiplications
    // and left shifts exactly, and keeps the low 64 bits of the result
    // only where it is not below -2^63: a negative one past it comes out
    // as its magnitude's low bits (measured: randomly generated functions
    // stepped in it). So expr_op multiplies and shifts left values it made
    // not negative: a multiplication of values of at most 32 bits from its
    // operands sign-extended (within 2^62), a wider one from their 32-bit
    // halves (mul64); a left shift of a value of at most 32 bits, or by a
    // constant, from the bits of it that the shift keeps.)
    let cnt = u.notnil(v.b) and (ir.resolve(v.b).kind == ir.V_CINT);
    let two = (op == ir.OP_ADD) or (op == ir.OP_SUB) or (op == ir.OP_AND) or (op == ir.OP_OR) or (op == ir.OP_XOR) or
              ((op == ir.OP_SHL) and ((bits <= 32) or cnt)) or (op == ir.OP_LSHR) or (op == ir.OP_ASHR) or
              (op == ir.OP_PTRADD) or (op == ir.OP_MUL);
    let one = (op == ir.OP_ZEXT) or (op == ir.OP_SEXT) or (op == ir.OP_TRUNC) or (op == ir.OP_PTRTOINT) or
              (op == ir.OP_INTTOPTR);
    if not two and not one {
        return;
    }
    if two and u.isnil(v.b) {
        return;
    }
    let mut ca: i64 = 0;
    let mut cb: i64 = 0;
    let xa = expr_operand(v.a, depth, &mut ca);
    if (xa == -2) or ((xa == -1) and one) {
        return;
    }
    let mut xb: i32 = -1;
    if two {
        xb = expr_operand(v.b, depth, &mut cb);
        if (xb == -2) or ((xa == -1) and (xb == -1)) {
            return;
        }
    }
    let x = VALS.at(@int_cast(usize, me));
    x.xop = op;
    x.xa = xa;
    x.xb = xb;
    x.ca = ca;
    x.cb = cb;
    x.bits = bits;
    x.abits = int_bits(ir.resolve(v.a));
}

// Value v (VALS index me) of a floating-point operation the typed stack
// machine computes as the program does (DWARF 5, 2.5.1.4 and 2.5.1.6: on
// values of a floating-point base type, in its format): an addition,
// subtraction, multiplication, division or negation, a conversion between
// the formats or from an integer (DW_OP_convert: to the integer's type,
// then the format's), and a bit cast between a float and an integer of its
// width (DW_OP_reinterpret). Not a conversion to an integer (the program's
// saturates), a remainder or a comparison.
fn fexpr_ops(v: *mut ir.Value, me: i32, depth: i32) void {
    let op = v.op;
    let fb = float_bits(v);
    let a = ir.resolve(v.a);
    if u.isnil(a) {
        return;
    }
    let mut ca: i64 = 0;
    let mut cb: i64 = 0;
    let mut xa: i32 = -2;
    let mut xb: i32 = -1;
    let mut abits: u32 = 0;
    if (op == ir.OP_FADD) or (op == ir.OP_FSUB) or (op == ir.OP_FMUL) or (op == ir.OP_FDIV) {
        if (fb == 0) or u.isnil(v.b) {
            return;
        }
        xa = fexpr_operand(v.a, depth, &mut ca);
        xb = fexpr_operand(v.b, depth, &mut cb);
        if (xb == -2) or ((xa == -1) and (xb == -1)) {
            return;
        }
        abits = fb;
    } else if (op == ir.OP_FNEG) or (op == ir.OP_FPEXT) or (op == ir.OP_FPTRUNC) {
        abits = float_bits(a);
        if (fb == 0) or (abits == 0) {
            return;
        }
        xa = fexpr_operand(v.a, depth, &mut ca);
    } else if (op == ir.OP_SITOFP) or (op == ir.OP_UITOFP) {
        abits = int_bits(a);
        if (fb == 0) or (abits == 0) or (a.ty.kind != ir.T_INT) {
            return;
        }
        xa = expr_operand(v.a, depth, &mut ca);
    } else if op == ir.OP_BITCAST {
        let ib = int_bits(v);
        if (fb > 0) and (a.ty.kind == ir.T_INT) and (int_bits(a) == fb) {
            abits = fb;
            xa = expr_operand(v.a, depth, &mut ca);
        } else if (ib > 0) and (v.ty.kind == ir.T_INT) and (float_bits(a) == ib) {
            abits = ib;
            xa = fexpr_operand(v.a, depth, &mut ca);
        } else {
            return;
        }
    } else {
        return;
    }
    if (xa == -2) or ((xa == -1) and (xb < 0)) {
        return;  // (an operand not followed, or none computed: folded)
    }
    let x = VALS.at(@int_cast(usize, me));
    x.xop = op;
    x.xa = xa;
    x.xb = xb;
    x.ca = ca;
    x.cb = cb;
    x.bits = @max(fb, int_bits(v));
    x.abits = abits;
}

// Gives back a map's memory.
fn drop_map[V](m: *mut u.SymMap.[V]) void {
    u.free(@ptr_cast(*mut void, m.keys));
    u.free(@ptr_cast(*mut void, m.vals));
    m.keys = u.nil.[usize]();
    m.vals = u.nil.[V]();
    m.cap = 0;
    m.len = 0;
}

// the entities of parameters: at the entry, the parameter (VALS index)
let mut PENTS: u.List.[[2]i32] = u.List.[[2]i32].{ data: @ptr_from_int(*mut [2]i32, 0), len: 0, cap: 0 };

/// Function f's code is selected next: the values of its variables to find.
pub fn begin(f: *mut ir.Func, on: bool) void {
    ENTS.clear();
    for k in 0..VALS.len {
        VALS.at(k).phi_ops.deinit();
    }
    VALS.clear();
    CONSTS.clear();
    MKS.clear();
    PENTS.clear();
    RCS.clear();
    mc.mk_next.clear();
    // (the last function's maps given back)
    drop_map.[i32](&mut by_val);
    drop_map.[i32](&mut by_ent);
    drop_map.[usize](&mut call_ir);
    by_val = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    by_ent = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    call_ir = u.SymMap.[usize].{ keys: u.nil.[usize](), vals: u.nil.[usize](), cap: 0, len: 0 };
    CALLS = u.List.[CallSite].empty();  // (a new one: the last function's went with it: release)
    boffs.clear();
    mb_ir.clear();
    pend = 0;
    pend_after = u.nil.[mc.MInst]();
    pend_blk = u.nil.[mc.MBlock]();
    FN = f;
    active = ir.dbg_on and on;
    if not active {
        return;
    }
    let ov = dbi.vars_of(f.name);
    OWN_P = ov.ptr;
    OWN_N = ov.len;
    LAST_OWNER = u.nil.[ir.Func]();
    // the values the marks name (their makings are found as they are selected)
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let mut k = ir.dbg_marks_at(i);
            while k >= 0 {
                let m = ir.dbg_marks.get(@int_cast(usize, k));
                if (@int_from_ptr(m.owner) == @int_from_ptr(f)) or (m.inst != 0) {
                    let v = ir.dbg_mark_value(k);
                    if u.notnil(v) and (cst_of(v) < 0) {
                        _ = val_of(v, 0);
                    }
                }
                k = m.next;
            }
            i = i.next;
        }
        b = b.next;
    }
}

/// Instruction selection starts machine block mb, of IR block b.
pub fn enter_block(b: *mut ir.Block, mb: *mc.MBlock) void {
    if not active {
        return;
    }
    let k = @int_cast(usize, mb.id);
    while mb_ir.len <= k {
        mb_ir.push(u.nil.[ir.Block]());
    }
    mb_ir.set(k, b);
}

/// Parameter p arrives in physical register reg (-1: none), or at stack_off
/// from the CFA (NO_LOC: not there).
pub fn param(p: *mut ir.Value, reg: i32, stack_off: i64) void {
    if not active {
        return;
    }
    let k = val_of(p, 0);
    if k >= 0 {
        let x = VALS.at(@int_cast(usize, k));
        x.entry_reg = reg;
        x.stack_off = stack_off;
    }
}

/// IR instruction i is selected next, into machine block b: the marks
/// before it go before the code made for it (or what comes next).
pub fn before(i: *ir.Value, b: *mut mc.MBlock) void {
    if not active {
        return;
    }
    let mut k = ir.dbg_marks_at(i);
    if k < 0 {
        return;
    }
    let own = @slice_from_ptr(OWN_P, OWN_N);
    let mut chain: i32 = 0;
    while k >= 0 {
        let m = ir.dbg_marks.get(@int_cast(usize, k));
        let mk = k;
        k = m.next;
        let mut vs = own;
        if m.inst != 0 {
            // (an inlined function's, of its instance)
            if @int_from_ptr(m.owner) != @int_from_ptr(LAST_OWNER) {
                LAST_OWNER = m.owner;
                let lv = dbi.vars_of(m.owner.name);
                LAST_P = lv.ptr;
                LAST_N = lv.len;
            }
            vs = @slice_from_ptr(LAST_P, LAST_N);
        } else if @int_from_ptr(m.owner) != @int_from_ptr(FN) {
            continue;
        }
        if (m.var < 0) or (@int_cast(usize, m.var) >= vs.len) {
            continue;
        }
        let x = vs[@int_cast(usize, m.var)];
        if u.notnil(x.global) {
            continue;
        }
        let v = ir.dbg_mark_value(mk);
        let madd = ir.dbg_mark_add(mk);
        let mut vi: i32 = -1;
        let mut ci: i32 = -1;
        let mut size = m.size;
        if x.indirect {
            // (the address of the variable: it is in memory there)
            if u.notnil(v) and (v.ty.kind == ir.T_PTR) and (m.size == 0) {
                size = @truncate(u32, v.ty.size);
                vi = val_of(v, 0);
            }
        } else if ir.dbg_mark_low(mk) {
            // (the low bits of a wider integer: in its place, read as narrower)
            let ls = low_fits(v, x.ty, m.size);
            if ls > 0 {
                size = ls;
                vi = val_of(v, 0);
            }
        } else if u.notnil(v) and fits(v, x.ty, m.size) {
            size = @truncate(u32, v.ty.size);
            ci = cst_of(v);
            if (ci < 0) or (madd != 0) {
                ci = -1;
                vi = val_of(v, 0);
            }
        }
        let e = ent_of(m.var, m.off, m.size, size, m.inst);
        ENTS.at(@int_cast(usize, e)).ind = x.indirect;
        if (vi >= 0) and x.param and (m.inst == 0) and (VALS.get(@int_cast(usize, vi)).v.kind == ir.V_PARAM) {
            PENTS.push([e, vi]);
        }
        MKS.push(MMark.{ ent: e, val: vi, cst: ci, add: madd });
        mc.mk_next.push(0);
        chain = mc.mk_cat(chain, @int_cast(i32, MKS.len));
    }
    if chain == 0 {
        return;
    }
    if (pend != 0) and (pend_blk == b) {
        pend = mc.mk_cat(pend, chain);
        return;
    }
    pend = chain;
    pend_after = b.last;
    pend_blk = b;
}

// The marks waiting go before the first instruction of b after pend_after.
fn place(b: *mut mc.MBlock) void {
    if (pend == 0) or (pend_blk != b) {
        return;
    }
    let mut n = b.first;
    if u.notnil(pend_after) {
        n = pend_after.next;
    }
    if u.notnil(n) {
        n.mk = mc.mk_cat(pend, n.mk);
        pend = 0;
    }
}

/// The code of IR instruction i was selected into block b, its value in
/// virtual register r (-1: none): the last instruction of b writing r makes
/// it.
pub fn selected(i: *ir.Value, b: *mut mc.MBlock, r: i32) void {
    if not active {
        return;
    }
    place(b);
    if i.op == ir.OP_CALL {
        // (its machine call: the last instruction of b that calls)
        let mut m = b.last;
        while u.notnil(m) and (m.clobber == 0) {
            m = m.prev;
        }
        if u.notnil(m) {
            call_ir.put(key(@int_from_ptr(m)), @int_from_ptr(i));
        }
    }
    let k = by_val.get(key(@int_from_ptr(i)));
    if (k == 0) or (r < 0) {
        return;
    }
    let x = VALS.at(@int_cast(usize, k - 1));
    let mut m = b.last;
    while u.notnil(m) {
        for j in 0..m.ops.len {
            let o = m.ops[j];
            if (o.kind == mc.K_REG) and (o.reg == r) and ((o.role & (mc.RD | mc.RE)) != 0) {
                x.def = m;
                x.def_op = j;
                return;
            }
        }
        m = m.prev;
    }
}

/// Block b's code is selected (its terminator's too): the marks waiting
/// are at its end.
pub fn end_block(b: *mut mc.MBlock) void {
    if not active {
        return;
    }
    place(b);
    if (pend != 0) and (pend_blk == b) {
        b.mk_end = mc.mk_cat(b.mk_end, pend);
        pend = 0;
    }
}

/// The encoder: block bi starts at code offset `off` (before any code the
/// encoder puts there: a prologue); `restart` starts the offsets again (an
/// encoding pass over).
pub fn block_at(bi: usize, off: u64, restart: bool) void {
    if not active {
        return;
    }
    if restart {
        boffs.clear();
        OFF_GEN = OFF_GEN +% 1;  // (the offsets of the pass before: none)
        if OFF_GEN == 0 {
            OFF_GEN = 1;
        }
    }
    while boffs.len <= bi {
        boffs.push(0xffff_ffff_ffff_ffff);
    }
    boffs.set(bi, off);
}

/// The encoder: machine instruction i (and those it encodes with it, up to
/// the next one given) starts at code offset `off`.
pub fn inst_at(i: *mc.MInst, off: u64) void {
    if active {
        let m = @ptr_from_int(*mut mc.MInst, @int_from_ptr(i));
        m.dgen = OFF_GEN;
        m.doff = @truncate(u32, off + 1);
    }
}

// Machine instruction i's code offset + 1 (0: the encoder did not visit it).
fn offset_of(i: *mc.MInst) u64 {
    if i.dgen != OFF_GEN {
        return 0;
    }
    return @as(u64, i.doff);
}

fn bit(r: i32) u64 {
    if (r < 0) or (r >= 64) {
        return 0;
    }
    return @as(u64, 1) << @as(u32, @bit_cast(u32, r));
}

// The physical registers i writes.
fn written(mf: *mc.MFunc, i: *mc.MInst) u64 {
    let mut w = i.clobber;
    for o in i.ops {
        if (o.kind == mc.K_REG) and ((o.role & (mc.RD | mc.RE)) != 0) {
            w = w | bit(mc.phys(mf, o.reg));
        }
    }
    return w;
}

fn move_regs(mf: *mc.MFunc, i: *mc.MInst) [2]i32 {
    let mut d: i32 = -1;
    let mut s: i32 = -1;
    for o in i.ops {
        if o.kind != mc.K_REG {
            continue;
        }
        if (o.role & mc.RD) != 0 {
            d = mc.phys(mf, o.reg);
        } else if (o.role & mc.RU) != 0 {
            s = mc.phys(mf, o.reg);
        }
    }
    return [d, s];
}

// -----------------------------------------------------------------------------
// The analysis
// -----------------------------------------------------------------------------
// Places: the physical registers 0-63, then the frame slots the code
// spills to or reloads from (64 + their index in SLOTS).
let mut NL: usize = 64;
let mut SLOTS: u.List.[i32] = u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 };
const MAX_SLOTS: usize = 448;
// each frame slot's place + 1 (by the slot's index; 0: none followed)
let mut SLOT_PL: u.List.[i32] = u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 };

// The place of frame slot k (-1: none followed).
fn slot_place(k: i32) i32 {
    if (k < 0) or (@int_cast(usize, k) >= SLOT_PL.len) {
        return -1;
    }
    return SLOT_PL.get(@int_cast(usize, k)) - 1;
}

// The slot of place l (>= 64).
fn place_slot(l: usize) i32 {
    return SLOTS.get(l - 64);
}

// The machine code, flattened: per instruction (in block order), what the
// analysis needs.
struct Ins {
    i: *mut mc.MInst,
    w: u64,       // the registers it writes (allocatable ones)
    kind: u8,     // 0: other, 1: a spill store, 2: a reload, 3: a copy, 4: an exit, 5: a constant (imm) into d
    d: i32,       // a copy's, reload's destination (a physical register), a spill store's source
    s: i32,       // a copy's source register; a spill store's or reload's slot's place (-1: none)
    defv: i32,    // the value it makes (a VALS index, -1: none)
    defr: i32,    // in physical register
    sw: [2]i32,   // the places of the slots it may write otherwise (-1: none)
    swall: bool,  // (and more: all of them)
    imm: i64,
}

// The state at a point, as the analysis works on it: C, what each place
// holds (0: nothing known, else an identity); D and A, what each entity is
// (an identity plus A); X, per value a bit: made, and none of the values it
// is computed from (expr_of) made since.
//
// Few places and entities are known at a time, and an instruction changes
// few of them: with the state are kept the places and entities that may be
// known (tc, td), and for each identity the places that hold it and the
// entities that are it (lists through pn, en), so that the work at an
// instruction is that of what it changes, and the work at a join (meet)
// and at a block's end (snap) that of what is known.
struct State {
    c: []mut i32,
    d: []mut i32,
    a: []mut i64,
    x: []mut u64,
    tc: u.List.[usize],  // the places that may hold an identity (each once: tcf)
    tcf: []mut bool,
    td: u.List.[usize],  // the entities that may be one (each once: tdf)
    tdf: []mut bool,
    pn: []mut i32,  // per place: the next and the previous place holding the same identity (-1: none)
    pp: []mut i32,
    en: []mut i32,  // per entity: the next and the previous entity being the same identity
    ep: []mut i32,
    hp: []mut i32,  // per identity 1 .. lown - 1: the first place holding it, and the first entity being it (-1: none)
    he: []mut i32,
    hpm: u.U64Map,  // the same for the other identities (+ 2; 1: none)
    hem: u.U64Map,
    lown: usize,
    trk: bool,  // (ranges) the places and the entities written since the last emission: in pcl, edl (once: pcf, edf)
    pcl: u.List.[usize],
    pcf: []mut bool,
    edl: u.List.[usize],
    edf: []mut bool,
}

// A state as kept at a block's end: what is known in it, in order.
struct SState {
    c: u.List.[PC],
    d: u.List.[PD],
    x: []mut u64,
    seen: bool,  // (made: the block was run)
}

struct PC {
    l: usize,
    id: i32,
}

struct PD {
    e: usize,
    id: i32,
    a: i64,
}

// (the number of values followed: State.x's bits, in NXW words)
let mut NX: usize = 0;
let mut NXW: usize = 0;

fn x_has(s: *State, k: usize) bool {
    return (s.x[k >> 6] & (@as(u64, 1) << @truncate(u32, k & 63))) != 0;
}

fn x_put(s: *mut State, k: usize, on: bool) void {
    let m = @as(u64, 1) << @truncate(u32, k & 63);
    if on {
        s.x[k >> 6] = s.x[k >> 6] | m;
    } else {
        s.x[k >> 6] = s.x[k >> 6] & ~m;
    }
}

// The analysis' tables for the function.
struct An {
    mf: *mc.MFunc,
    t: *Tgt,
    nb: usize,
    ne: usize,
    nv: i32,
    syn0: i64,
    ins: u.List.[Ins],
    bfirst: []mut usize,  // each block's first instruction (in ins), and the end (bfirst[nb])
    idom: []mut i32,
    rpo: []mut i32,     // the blocks' order (reverse postorder)
    rpon: []mut i32,    // each block's place in it (-1: unreachable)
    defb: []mut i32,    // each value's making's block (-1: none)
    defi: []mut usize,  // and its index in ins
    tails: bool,
    preds: []mut u.List.[i32],  // each block's predecessors (from the successors)
    // meet's work tables, made once
    ps: u.List.[*SState],  // the paths' states
    pb: u.List.[i32],      // and blocks
    ul: u.List.[usize],    // the entities some path knows
    uf: []mut bool,
    cur: u.List.[usize],   // per path, where in its state
    tup: u.List.[i32],     // per path, an entity's identity, or a place's
    reps: u.List.[usize],  // the merges' representatives
    rt: u.List.[i32],      // and their paths' identities (n each)
    rnext: u.List.[i32],   // the next representative of the same hash (-1: none)
    tab: Tab,              // a hash of the paths' identities -> its first representative
    atl: u.List.[usize],
    last: i32,        // the block whose state at its end the working state is (-1: none)
    nd: u.List.[PD],  // (meet's result, before it is the working state's)
    nc: u.List.[PC],
    nf: []mut bool,
    ncf: []mut bool,
}

// A table of hashes (by 64-bit hash, to an index), emptied by a new generation.
struct Tab {
    k: []mut u64,
    v: []mut i32,
    g: []mut u32,
    cap: usize,
    gen: u32,
}

fn tab_reset(t: *mut Tab, n: usize) void {
    let mut cap = t.cap;
    if cap == 0 {
        cap = 64;
    }
    while cap < (2 * n) + 2 {
        cap = cap * 2;
    }
    if (cap != t.cap) or (t.gen == 0xffff_ffff) {
        t.k = u.newn.[u64](cap);
        t.v = u.newn.[i32](cap);
        t.g = u.newn.[u32](cap);
        for j in 0..cap {
            t.g[j] = 0;
        }
        t.cap = cap;
        t.gen = 1;
        return;
    }
    t.gen += 1;
}

// The slot of hash h (its own, or the empty one where it would go).
fn tab_slot(t: *Tab, h: u64) usize {
    let mut j = @truncate(usize, (h *% 0x9e37_79b9_7f4a_7c15) >> 32) & (t.cap - 1);
    while (t.g[j] == t.gen) and (t.k[j] != h) {
        j = (j + 1) & (t.cap - 1);
    }
    return j;
}

fn tup_hash(xs: []i32) u64 {
    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
    for x in xs {
        h = (h ^ @as(u64, @bit_cast(u32, x))) *% 0x100_0000_01b3;
    }
    return h ^ (h >> 31);
}

fn tup_eq(a: []i32, b: []i32) bool {
    for j in 0..a.len {
        if a[j] != b[j] {
            return false;
        }
    }
    return true;
}

fn id_val(k: i32) i32 {
    return k + 1;
}

// The constants machine instructions put in registers (all 64 bits): their
// identities are -2, -3, ...
let mut RCS: u.List.[i64] = u.List.[i64].{ data: @ptr_from_int(*mut i64, 0), len: 0, cap: 0 };

fn rc_id(x: i64) i32 {
    for k in 0..RCS.len {
        if RCS.get(k) == x {
            return -2 - @int_cast(i32, k);
        }
    }
    RCS.push(x);
    return -1 - @int_cast(i32, RCS.len);
}

// Does a place holding identity c hold what identity d is (the same one, or
// constant d's bits)?
fn is_held(an: *An, c: i32, d: i32) bool {
    if c == d {
        return c != 0;
    }
    let nv = an.nv;
    if (c <= -2) and (d > 2 * nv) and (@as(i64, d) < an.syn0) {
        let k = CONSTS.get(@int_cast(usize, d - (2 * nv) - 1));
        let v = @bit_cast(u64, RCS.get(@int_cast(usize, -2 - c)));
        if k.size >= 8 {
            return v == k.bits;
        }
        let mask = (@as(u64, 1) << @as(u32, 8 * k.size)) - 1;
        return (v & mask) == k.bits;
    }
    return false;
}

fn st_new(an: *An) State {
    let ne = an.ne;
    let lown = @int_cast(usize, an.syn0);
    let s = State.{ c: u.newn.[i32](NL + 1), d: u.newn.[i32](ne + 1), a: u.newn.[i64](ne + 1), x: u.newn.[u64](NXW + 1),
                    tc: u.List.[usize].empty(), tcf: u.newn.[bool](NL + 1), td: u.List.[usize].empty(),
                    tdf: u.newn.[bool](ne + 1), pn: u.newn.[i32](NL + 1), pp: u.newn.[i32](NL + 1),
                    en: u.newn.[i32](ne + 1), ep: u.newn.[i32](ne + 1), hp: u.newn.[i32](lown + 1),
                    he: u.newn.[i32](lown + 1), hpm: u.U64Map.empty(), hem: u.U64Map.empty(), lown: lown, trk: false,
                    pcl: u.List.[usize].empty(), pcf: u.newn.[bool](NL + 1), edl: u.List.[usize].empty(),
                    edf: u.newn.[bool](ne + 1) };
    for l in 0..NL {
        s.c[l] = 0;
        s.tcf[l] = false;
        s.pcf[l] = false;
    }
    for e in 0..ne {
        s.d[e] = 0;
        s.a[e] = 0;
        s.tdf[e] = false;
        s.edf[e] = false;
    }
    for k in 0..NXW {
        s.x[k] = 0;
    }
    for k in 0..lown {
        s.hp[k] = -1;
        s.he[k] = -1;
    }
    return s;
}

fn st_free(s: *mut State) void {
    s.tc.deinit();
    s.td.deinit();
    s.hpm.deinit();
    s.hem.deinit();
    s.pcl.deinit();
    s.edl.deinit();
}

fn id_key(id: i32) u64 {
    return @as(u64, @bit_cast(u32, id));
}

// The first place holding identity id (-1: none).
fn hp_get(s: *mut State, id: i32) i32 {
    if (id > 0) and (@int_cast(usize, id) < s.lown) {
        return s.hp[@int_cast(usize, id)];
    }
    let v = s.hpm.get(id_key(id));
    if v < 2 {
        return -1;
    }
    return @bit_cast(i32, @truncate(u32, v)) - 2;
}

fn hp_set(s: *mut State, id: i32, l: i32) void {
    if (id > 0) and (@int_cast(usize, id) < s.lown) {
        s.hp[@int_cast(usize, id)] = l;
        return;
    }
    s.hpm.put(id_key(id), @as(u64, @bit_cast(u32, l + 2)));
}

// The first entity being identity id (-1: none).
fn he_get(s: *mut State, id: i32) i32 {
    if (id > 0) and (@int_cast(usize, id) < s.lown) {
        return s.he[@int_cast(usize, id)];
    }
    let v = s.hem.get(id_key(id));
    if v < 2 {
        return -1;
    }
    return @bit_cast(i32, @truncate(u32, v)) - 2;
}

fn he_set(s: *mut State, id: i32, e: i32) void {
    if (id > 0) and (@int_cast(usize, id) < s.lown) {
        s.he[@int_cast(usize, id)] = e;
        return;
    }
    s.hem.put(id_key(id), @as(u64, @bit_cast(u32, e + 2)));
}

// Place l holds identity id from now on.
fn put_c(s: *mut State, l: usize, id: i32) void {
    let old = s.c[l];
    if old == id {
        return;
    }
    if old != 0 {
        let n = s.pn[l];
        let p = s.pp[l];
        if p >= 0 {
            s.pn[@int_cast(usize, p)] = n;
        } else {
            hp_set(s, old, n);
        }
        if n >= 0 {
            s.pp[@int_cast(usize, n)] = p;
        }
    }
    s.c[l] = id;
    if id != 0 {
        let h = hp_get(s, id);
        s.pn[l] = h;
        s.pp[l] = -1;
        if h >= 0 {
            s.pp[@int_cast(usize, h)] = @int_cast(i32, l);
        }
        hp_set(s, id, @int_cast(i32, l));
        if not s.tcf[l] {
            s.tcf[l] = true;
            s.tc.push(l);
        }
    }
    if s.trk and not s.pcf[l] {
        s.pcf[l] = true;
        s.pcl.push(l);
    }
}

// Entity e is identity id plus a from now on.
fn put_d(s: *mut State, e: usize, id: i32, a: i64) void {
    let old = s.d[e];
    if (old == id) and (s.a[e] == a) {
        return;
    }
    if old != id {
        if old != 0 {
            let n = s.en[e];
            let p = s.ep[e];
            if p >= 0 {
                s.en[@int_cast(usize, p)] = n;
            } else {
                he_set(s, old, n);
            }
            if n >= 0 {
                s.ep[@int_cast(usize, n)] = p;
            }
        }
        if id != 0 {
            let h = he_get(s, id);
            s.en[e] = h;
            s.ep[e] = -1;
            if h >= 0 {
                s.ep[@int_cast(usize, h)] = @int_cast(i32, e);
            }
            he_set(s, id, @int_cast(i32, e));
        }
    }
    s.d[e] = id;
    s.a[e] = a;
    if ((id != 0) or (a != 0)) and not s.tdf[e] {
        s.tdf[e] = true;
        s.td.push(e);
    }
    if s.trk and not s.edf[e] {
        s.edf[e] = true;
        s.edl.push(e);
    }
}

// Nothing known.
fn st_clear(s: *mut State) void {
    for l in s.tc.items() {
        put_c(s, l, 0);
        s.tcf[l] = false;
    }
    s.tc.clear();
    for e in s.td.items() {
        put_d(s, e, 0, 0);
        s.tdf[e] = false;
    }
    s.td.clear();
    for k in 0..NXW {
        s.x[k] = 0;
    }
}

fn ss_new() SState {
    let s = SState.{ c: u.List.[PC].empty(), d: u.List.[PD].empty(), x: u.newn.[u64](NXW + 1), seen: false };
    for k in 0..NXW {
        s.x[k] = 0;
    }
    return s;
}

fn ss_free(s: *mut SState) void {
    s.c.deinit();
    s.d.deinit();
}

// What is known in s, into o (and s's lists of what may be, to it).
fn snap(s: *mut State, o: *mut SState) void {
    sort_some(s.tc.items());
    o.c.clear();
    o.c.room(s.tc.len);
    let oc = @slice_from_ptr(o.c.data, s.tc.len);
    let tc = s.tc.items();
    let mut n: usize = 0;
    for l in tc {
        let id = s.c[l];
        if id != 0 {
            oc[n] = PC.{ l: l, id: id };
            tc[n] = l;
            n += 1;
        } else {
            s.tcf[l] = false;
        }
    }
    s.tc.len = n;
    o.c.len = n;
    sort_some(s.td.items());
    o.d.clear();
    o.d.room(s.td.len);
    let od = @slice_from_ptr(o.d.data, s.td.len);
    let td = s.td.items();
    n = 0;
    for e in td {
        let id = s.d[e];
        if (id != 0) or (s.a[e] != 0) {
            od[n] = PD.{ e: e, id: id, a: s.a[e] };
            td[n] = e;
            n += 1;
        } else {
            s.tdf[e] = false;
        }
    }
    s.td.len = n;
    o.d.len = n;
    for k in 0..NXW {
        o.x[k] = s.x[k];
    }
}

// Sorts xs (which are often in order already).
fn sort_some(xs: []mut usize) void {
    for k in @as(usize, 1)..xs.len {
        if xs[k - 1] > xs[k] {
            u.sort_usize(xs);
            return;
        }
    }
}

// s is what o says.
fn load(s: *mut State, o: *SState) void {
    st_clear(s);
    for q in o.c.items() {
        put_c(s, q.l, q.id);
    }
    for q in o.d.items() {
        put_d(s, q.e, q.id, q.a);
    }
    for k in 0..NXW {
        s.x[k] = o.x[k];
    }
}

fn ss_same(x: *SState, y: *SState) bool {
    if (x.c.len != y.c.len) or (x.d.len != y.d.len) {
        return false;
    }
    for k in 0..x.c.len {
        let p = x.c.get(k);
        let q = y.c.get(k);
        if (p.l != q.l) or (p.id != q.id) {
            return false;
        }
    }
    for k in 0..x.d.len {
        let p = x.d.get(k);
        let q = y.d.get(k);
        if (p.e != q.e) or (p.id != q.id) or (p.a != q.a) {
            return false;
        }
    }
    for k in 0..NXW {
        if x.x[k] != y.x[k] {
            return false;
        }
    }
    return true;
}

// What place l holds in o.
fn ss_c(o: *SState, l: usize) i32 {
    let mut lo: usize = 0;
    let mut hi = o.c.len;
    while lo < hi {
        let m = (lo + hi) / 2;
        let p = o.c.get(m);
        if p.l == l {
            return p.id;
        }
        if p.l < l {
            lo = m + 1;
        } else {
            hi = m;
        }
    }
    return 0;
}

fn holds(s: *mut State, id: i32) bool {
    return hp_get(s, id) >= 0;
}

// The registers holding id (a mask).
fn regs_of(s: *mut State, id: i32) u64 {
    let mut m: u64 = 0;
    let mut l = hp_get(s, id);
    while l >= 0 {
        if l < 64 {
            m = m | (@as(u64, 1) << @as(u32, @bit_cast(u32, l)));
        }
        l = s.pn[@int_cast(usize, l)];
    }
    return m;
}

// The first spill slot's place holding id whose offset from the CFA is
// known: its offset (NO_LOC: none).
fn slot_of(an: *An, s: *mut State, id: i32) i64 {
    let mut best: i32 = -1;
    let mut l = hp_get(s, id);
    while l >= 0 {
        if (l >= 64) and ((best < 0) or (l < best)) and (an.t.slot_off(place_slot(@int_cast(usize, l))) != NO_LOC) {
            best = l;
        }
        l = s.pn[@int_cast(usize, l)];
    }
    if best < 0 {
        return NO_LOC;
    }
    return an.t.slot_off(place_slot(@int_cast(usize, best)));
}

// Does block a dominate block b?
fn dominates(an: *An, a: i32, b: i32) bool {
    if (a < 0) or (b < 0) or (an.rpon[@int_cast(usize, b)] < 0) {
        return false;
    }
    let mut x = b;
    let mut n: usize = 0;
    while (x >= 0) and (n <= an.nb) {
        if x == a {
            return true;
        }
        let y = an.idom[@int_cast(usize, x)];
        if y == x {
            return false;
        }
        x = y;
        n += 1;
    }
    return false;
}

// Is value k made where every path to instruction `at` (in block b) has
// made it last (its making dominates the place)?
fn made_before(an: *An, k: i32, b: i32, at: usize) bool {
    let x = VALS.get(@int_cast(usize, k));
    if x.v.kind == ir.V_PARAM {
        return true;
    }
    if x.phi_blk >= 0 {
        return dominates(an, x.phi_blk, b);
    }
    let db = an.defb[@int_cast(usize, k)];
    if db < 0 {
        return false;
    }
    if db == b {
        return an.defi[@int_cast(usize, k)] < at;
    }
    return dominates(an, db, b);
}

// Are the operands of value k (of expr_ops) made where every path to
// instruction `at` of block b has made them last, or (made by no
// instruction) made so here (State.x)?
fn operands_made(an: *An, s: *State, k: i32, b: i32, at: usize) bool {
    let x = VALS.get(@int_cast(usize, k));
    let os: [2]i32 = [x.xa, x.xb];
    for q in @as(usize, 0)..2 {
        let o = os[q];
        if o >= 0 {
            let y = VALS.get(@int_cast(usize, o));
            let here = (an.defb[@int_cast(usize, o)] < 0) and x_has(s, @int_cast(usize, o));
            if not (here or y.obj or (y.gsym.len > 0) or made_before(an, o, b, at)) {
                return false;
            }
        }
    }
    return true;
}

// Mark mm takes effect in state s, before instruction `at` of block b.
fn apply_mark(an: *An, s: *mut State, mm: MMark, b: i32, at: usize) void {
    if mm.ent < 0 {
        return;
    }
    let e = @int_cast(usize, mm.ent);
    if mm.cst >= 0 {
        put_d(s, e, 2 * an.nv + mm.cst + 1, 0);
        return;
    }
    let k = mm.val;
    if k < 0 {
        put_d(s, e, 0, 0);
        return;
    }
    let x = VALS.get(@int_cast(usize, k));
    if x.obj or (x.gsym.len > 0) or (x.v.kind == ir.V_PARAM) or holds(s, id_val(k)) {
        put_d(s, e, id_val(k), mm.add);
        return;
    }
    if x.phi_blk >= 0 {
        if dominates(an, x.phi_blk, b) {
            put_d(s, e, id_val(k), mm.add);
        } else {
            put_d(s, e, 0, 0);
        }
        return;
    }
    // folded into its uses: its base's place, plus the constant
    let mut bk = x.base;
    let mut add = x.add +% mm.add;
    let mut n: i32 = 0;
    while (bk >= 0) and (n < 8) {
        let y = VALS.get(@int_cast(usize, bk));
        if y.obj or (y.gsym.len > 0) or holds(s, id_val(bk)) or ((y.v.kind == ir.V_PARAM) and (y.stack_off != NO_LOC)) {
            put_d(s, e, id_val(bk), add);
            return;
        }
        add = add +% y.add;
        bk = y.base;
        n += 1;
    }
    if (an.defb[@int_cast(usize, k)] < 0) and (x.xop != 0) and operands_made(an, s, k, b, at) {
        // (a value no instruction of the code makes, an operation on
        // others that are made, here as they were when it was: made here,
        // computed from them while none is made again, State.x)
        put_d(s, e, id_val(k), mm.add);
        x_put(s, @int_cast(usize, k), true);
        return;
    }
    if u.notnil(x.def) {
        if made_before(an, k, b, at) {
            put_d(s, e, id_val(k), mm.add);
        } else {
            put_d(s, e, an.nv + k + 1, mm.add);  // (made later on: waits for the making)
        }
        return;
    }
    put_d(s, e, 0, 0);
}

fn apply_marks(an: *An, s: *mut State, chain: i32, b: i32, at: usize) void {
    let mut k = chain;
    while k != 0 {
        apply_mark(an, s, MKS.get(@int_cast(usize, k - 1)), b, at);
        k = mc.mk_next.get(@int_cast(usize, k - 1));
    }
}

fn set_reg(an: *An, s: *mut State, r: i32, id: i32) void {
    if (r >= 0) and (r < 64) and ((an.t.alloc & bit(r)) != 0) {
        put_c(s, @int_cast(usize, r), id);
    }
}

fn get_reg(an: *An, s: *State, r: i32) i32 {
    if (r >= 0) and (r < 64) and ((an.t.alloc & bit(r)) != 0) {
        return s.c[@int_cast(usize, r)];
    }
    return 0;
}

// The state after instruction x (from s before it, its marks applied).
fn step(an: *An, s: *mut State, x: *Ins) void {
    if x.kind == 4 {
        for l in s.tc.items() {
            put_c(s, l, 0);
        }
        return;
    }
    let mut held: i32 = 0;
    if x.kind == 1 {
        held = get_reg(an, s, x.d);
    } else if x.kind == 2 {
        if x.s >= 0 {
            held = s.c[@int_cast(usize, x.s)];
        }
    } else if x.kind == 3 {
        held = get_reg(an, s, x.s);
    }
    let mut w = x.w;
    while w != 0 {
        let p = @as(usize, @truncate(u32, @ctz(w)));
        w = w & (w - 1);
        put_c(s, p, 0);
    }
    for q in @as(usize, 0)..2 {
        if x.sw[q] >= 0 {
            put_c(s, @int_cast(usize, x.sw[q]), 0);
        }
    }
    if x.swall {
        for l in s.tc.items() {
            if l >= 64 {
                put_c(s, l, 0);
            }
        }
    }
    if x.kind == 1 {
        if x.s >= 0 {
            put_c(s, @int_cast(usize, x.s), held);
        }
    } else if (x.kind == 2) or (x.kind == 3) {
        set_reg(an, s, x.d, held);
    } else if x.kind == 5 {
        set_reg(an, s, x.d, rc_id(x.imm));
    }
    if x.defv >= 0 {
        // a value made again: its other copies (and what was it) are stale
        let id = id_val(x.defv);
        made(an, s, x.defv);
        set_reg(an, s, x.defr, id);
        x_put(s, @int_cast(usize, x.defv), true);
    }
}

// Value k is made (again, or a phi at its block's start): no place holds
// it, no entity is what it was, and those waiting for it are it.
fn made(an: *An, s: *mut State, k: i32) void {
    let id = id_val(k);
    let nx = an.nv + k + 1;
    let mut l = hp_get(s, id);
    while l >= 0 {
        put_c(s, @int_cast(usize, l), 0);
        l = hp_get(s, id);
    }
    let mut e = he_get(s, id);
    while e >= 0 {
        put_d(s, @int_cast(usize, e), 0, 0);
        e = he_get(s, id);
    }
    e = he_get(s, nx);
    while e >= 0 {
        let eu = @int_cast(usize, e);
        put_d(s, eu, id, s.a[eu]);
        e = he_get(s, nx);
    }
    remade(s, k);
}

// Value k is made (again): the values computed from it are not from this
// one (State.x).
fn remade(s: *mut State, k: i32) void {
    if @int_cast(usize, k) >= DEPS.len {
        return;
    }
    for j in DEPS.get(@int_cast(usize, k)).items() {
        x_put(s, @int_cast(usize, j), false);
    }
}

// each value -> the values computed from it, directly or not (expr_of's)
let mut DEPS: u.List.[u.List.[i32]] = u.List.[u.List.[i32]].{ data: @ptr_from_int(*mut u.List.[i32], 0), len: 0,
                                                              cap: 0 };

fn add_deps(k: i32, of: i32, depth: i32) void {
    if (of < 0) or (depth > XDEPTH + 2) {
        return;
    }
    let x = VALS.get(@int_cast(usize, of));
    if x.xop == 0 {
        return;
    }
    let os: [2]i32 = [x.xa, x.xb];
    for q in @as(usize, 0)..2 {
        let o = os[q];
        if o >= 0 {
            let l = DEPS.at(@int_cast(usize, o));
            let mut have = false;
            for j in l.items() {
                have = have or (j == k);
            }
            if not have {
                l.push(k);
            }
            add_deps(k, o, depth + 1);
        }
    }
}

fn find_deps() void {
    for k in 0..DEPS.len {
        DEPS.at(k).deinit();
    }
    DEPS.clear();
    for _k in 0..VALS.len {
        DEPS.push(u.List.[i32].empty());
    }
    for k in 0..VALS.len {
        add_deps(@int_cast(i32, k), @int_cast(i32, k), 0);
    }
    // the values each one's expression may read (expr_of: down to depth XDEPTH)
    CLO.clear();
    CLO_AT.clear();
    for k in 0..VALS.len {
        CLO_AT.push(@truncate(u32, CLO.len));
        if VALS.get(k).xop != 0 {
            add_clo(@int_cast(usize, CLO_AT.get(k)), @int_cast(i32, k), 0);
        }
    }
    CLO_AT.push(@truncate(u32, CLO.len));
}

// each value -> the values whose places and State.x its expression
// (expr_of) depends on, it among them: CLO[CLO_AT[k] .. CLO_AT[k + 1]]
let mut CLO: u.List.[i32] = u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 };
let mut CLO_AT: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };

fn add_clo(from: usize, k: i32, depth: i32) void {
    let mut have = false;
    for j in from..CLO.len {
        have = have or (CLO.get(j) == k);
    }
    if not have {
        CLO.push(k);
    }
    if depth >= XDEPTH {
        return;
    }
    let x = VALS.get(@int_cast(usize, k));
    if x.xop == 0 {
        return;
    }
    if x.xa >= 0 {
        add_clo(from, x.xa, depth + 1);
    }
    if x.xb >= 0 {
        add_clo(from, x.xb, depth + 1);
    }
}

// The synthetic identity of entity e's merge at block b (0: none).
fn syn(an: *An, b: usize, e: usize) i32 {
    let id = an.syn0 + (@as(i64, @int_cast(i64, b)) * @as(i64, @int_cast(i64, an.ne))) + @as(i64, @int_cast(i64, e));
    if id >= 0x7fff_0000 {
        return 0;
    }
    return @truncate(i32, id);
}

fn in_syn(id: i32, lo: i64, hi: i64) bool {
    return (@as(i64, id) >= lo) and (@as(i64, id) < hi);
}

// The state at the start of block b, from the states at the ends of its
// predecessors seen so far (outs) and, for the entry, the entry's.
fn meet(an: *mut An, b: usize, outs: []mut SState, entry: *SState, s: *mut State) void {
    if (b != 0) and (an.preds[b].len == 1) and (an.preds[b].get(0) == an.last) and (an.last >= 0) and
       (PHIS.get(b).len == 0) {
        return;  // (its one predecessor's, which s is: s)
    }
    an.last = -1;
    an.ps.clear();
    an.pb.clear();
    if b == 0 {
        an.ps.push(entry);
        an.pb.push(-1);
    }
    for p in an.preds[b].items() {
        if outs[@int_cast(usize, p)].seen {
            an.ps.push(&outs[@int_cast(usize, p)]);
            an.pb.push(p);
        }
    }
    an.nd.clear();
    an.nc.clear();
    if an.ps.len == 0 {
        st_apply(an, s);
        for k in 0..NXW {
            s.x[k] = 0;
        }
        return;
    }
    let n = an.ps.len;
    let pss = an.ps.items();
    // (the identities of block b's merges, syn's: [slo, shi))
    let slo = an.syn0 + (@as(i64, @int_cast(i64, b)) * @as(i64, @int_cast(i64, an.ne)));
    let shi = slo + @as(i64, @int_cast(i64, an.ne));
    // the entities some path knows, in order (the others are not known on
    // any: not known)
    an.ul.clear();
    if n == 1 {
        for q in pss[0].d.items() {
            an.ul.push(q.e);
        }
    } else {
        for j in 0..n {
            for q in pss[j].d.items() {
                if not an.uf[q.e] {
                    an.uf[q.e] = true;
                    an.ul.push(q.e);
                }
            }
        }
        for e in an.ul.items() {
            an.uf[e] = false;
        }
        u.sort_usize(an.ul.items());
    }
    an.cur.clear();
    an.tup.clear();
    for _j in 0..n {
        an.cur.push(0);
        an.tup.push(0);
    }
    let cur = an.cur.items();
    let tup = an.tup.items();
    an.reps.clear();
    an.rt.clear();
    an.rnext.clear();
    tab_reset(&mut an.tab, an.ul.len);
    for e in an.ul.items() {
        // (each path's identity, tup, and constant)
        let mut a0: i64 = 0;
        let mut same = true;
        let mut known = true;
        let mut adds = true;
        for j in 0..n {
            let ds = pss[j].d.items();
            while (cur[j] < ds.len) and (ds[cur[j]].e < e) {
                cur[j] += 1;
            }
            let mut dj: i32 = 0;
            let mut aj: i64 = 0;
            if (cur[j] < ds.len) and (ds[cur[j]].e == e) {
                dj = ds[cur[j]].id;
                aj = ds[cur[j]].a;
            }
            tup[j] = dj;
            if j == 0 {
                a0 = aj;
            } else if aj != a0 {
                same = false;
                adds = false;
            }
            if (dj != tup[0]) or in_syn(dj, slo, shi) {
                same = false;
            }
            known = known and (dj != 0);
        }
        if same {
            if (tup[0] != 0) or (a0 != 0) {
                an.nd.push(PD.{ e: e, id: tup[0], a: a0 });
            }
            continue;
        }
        if not known or not adds {
            continue;
        }
        // a merge of its own, or of an earlier entity with the same inputs
        let h = tup_hash(tup);
        let sl = tab_slot(&an.tab, h);
        let mut ri: i32 = -1;
        if an.tab.g[sl] == an.tab.gen {
            ri = an.tab.v[sl];
            while (ri >= 0) and not tup_eq(tup, an.rt.items()[(@int_cast(usize, ri) * n)..]) {
                ri = an.rnext.get(@int_cast(usize, ri));
            }
        }
        let mut r = e;
        if ri >= 0 {
            r = an.reps.get(@int_cast(usize, ri));
        } else {
            let mut head: i32 = -1;
            if an.tab.g[sl] == an.tab.gen {
                head = an.tab.v[sl];
            }
            an.tab.g[sl] = an.tab.gen;
            an.tab.k[sl] = h;
            an.tab.v[sl] = @int_cast(i32, an.reps.len);
            an.rnext.push(head);
            an.reps.push(e);
            for j in 0..n {
                an.rt.push(tup[j]);
            }
        }
        let sid = syn(an, b, r);
        if (sid != 0) or (a0 != 0) {
            an.nd.push(PD.{ e: e, id: sid, a: a0 });
        }
    }
    // the places: those that every path knows (a place a path knows nothing
    // of holds no merge), each what all hold, or a merge whose inputs all do
    for j in 0..n {
        cur[j] = 0;
    }
    let nr = an.reps.len;
    for q in pss[0].c.items() {
        let l = q.l;
        let c0 = q.id;
        tup[0] = c0;
        let mut all = true;
        let mut same = not in_syn(c0, slo, shi);
        let mut rc = c0 <= -2;
        for j in 1..n {
            let cs = pss[j].c.items();
            while (cur[j] < cs.len) and (cs[cur[j]].l < l) {
                cur[j] += 1;
            }
            if (cur[j] >= cs.len) or (cs[cur[j]].l != l) {
                all = false;
                break;
            }
            let cj = cs[cur[j]].id;
            tup[j] = cj;
            same = same and (cj == c0);
            rc = rc or (cj <= -2);
        }
        if not all {
            continue;
        }
        if same {
            an.nc.push(PC.{ l: l, id: c0 });
            continue;
        }
        if nr == 0 {
            continue;
        }
        if rc {
            // (a constant a machine instruction made: it holds a merge of
            // constants whose bits it has)
            let rt = an.rt.items();
            for k in 0..nr {
                let sid = syn(an, b, an.reps.get(k));
                if sid == 0 {
                    continue;
                }
                let mut hit = true;
                for j in 0..n {
                    if not is_held(an, tup[j], rt[(k * n) + j]) {
                        hit = false;
                        break;
                    }
                }
                if hit {
                    an.nc.push(PC.{ l: l, id: sid });
                    break;
                }
            }
            continue;
        }
        // (else only the merge whose inputs are the place's: one at most)
        let sl = tab_slot(&an.tab, tup_hash(tup));
        if an.tab.g[sl] != an.tab.gen {
            continue;
        }
        let mut ri = an.tab.v[sl];
        while (ri >= 0) and not tup_eq(tup, an.rt.items()[(@int_cast(usize, ri) * n)..]) {
            ri = an.rnext.get(@int_cast(usize, ri));
        }
        if ri >= 0 {
            let sid = syn(an, b, an.reps.get(@int_cast(usize, ri)));
            if sid != 0 {
                an.nc.push(PC.{ l: l, id: sid });
            }
        }
    }
    st_apply(an, s);
    // the values computed from others: so on every path
    for k in 0..NXW {
        let mut all: u64 = 0xffff_ffff_ffff_ffff;
        for j in 0..n {
            all = all & pss[j].x[k];
        }
        s.x[k] = all;
    }
    // the phis of the block: where each path's input is at its end
    let ib = mb_ir_of(b);
    for k in PHIS.get(b).items() {
        let x = VALS.at(k);
        let id = id_val(@int_cast(i32, k));
        let mut ok = u.notnil(ib) and (b != 0);
        for j in 0..n {
            if not ok {
                break;
            }
            let pi = an.pb.get(j);
            let from = mb_ir_of(@int_cast(usize, pi));
            let mut inid: i32 = 0;
            for q in x.phi_ops.items() {
                if u.notnil(from) and (q.from == from) and (q.val >= 0) {
                    inid = id_val(q.val);
                } else if u.notnil(from) and (q.from == from) and (q.cst >= 0) {
                    inid = 2 * an.nv + q.cst + 1;
                }
            }
            if inid == 0 {
                ok = false;
                break;
            }
            tup[j] = inid;
        }
        an.atl.clear();
        if ok {
            for q in pss[0].c.items() {
                let mut hit = is_held(an, q.id, tup[0]);
                for j in 1..n {
                    if not hit {
                        break;
                    }
                    hit = is_held(an, ss_c(pss[j], q.l), tup[j]);
                }
                if hit {
                    an.atl.push(q.l);
                }
            }
        }
        made(an, s, @int_cast(i32, k));
        if ok {
            for l in an.atl.items() {
                put_c(s, l, id);
            }
        }
    }
}

// s is what meet found (an.nd, an.nc, in order): what differs is written.
fn st_apply(an: *mut An, s: *mut State) void {
    for q in an.nd.items() {
        an.nf[q.e] = true;
    }
    for e in s.td.items() {
        if not an.nf[e] {
            put_d(s, e, 0, 0);
        }
        s.tdf[e] = false;
    }
    s.td.clear();
    for q in an.nd.items() {
        an.nf[q.e] = false;
        put_d(s, q.e, q.id, q.a);
        if not s.tdf[q.e] {
            s.tdf[q.e] = true;
            s.td.push(q.e);
        }
    }
    for q in an.nc.items() {
        an.ncf[q.l] = true;
    }
    for l in s.tc.items() {
        if not an.ncf[l] {
            put_c(s, l, 0);
        }
        s.tcf[l] = false;
    }
    s.tc.clear();
    for q in an.nc.items() {
        an.ncf[q.l] = false;
        put_c(s, q.l, q.id);
        if not s.tcf[q.l] {
            s.tcf[q.l] = true;
            s.tc.push(q.l);
        }
    }
}

// each machine block's phis (VALS indexes)
let mut PHIS: u.List.[u.List.[usize]] = u.List.[u.List.[usize]].{ data: @ptr_from_int(*mut u.List.[usize], 0), len: 0,
                                                                  cap: 0 };

// The IR block of machine block b (nil: none), through blocks made since
// with one predecessor.
fn mb_ir_of(b: usize) *mut ir.Block {
    if b < mb_ir.len {
        return mb_ir.get(b);
    }
    return u.nil.[ir.Block]();
}

// The blocks' immediate dominators (the entry's is itself; an unreachable
// block's -1), over the machine CFG: the iterative algorithm over reverse
// postorder (Cooper, Harvey and Kennedy, "A Simple, Fast Dominance
// Algorithm", 2001).
fn dominators(an: *mut An) void {
    let nb = an.nb;
    let color = u.newn.[u8](nb + 1);
    let post = u.newn.[i32](nb + 1);
    let mut np: usize = 0;
    for b in 0..nb {
        color[b] = 0;
        an.rpon[b] = -1;
        an.idom[b] = -1;
    }
    // (an explicit stack of (block, next successor))
    let mut stk = u.List.[[2]i32].empty();
    stk.push([0, 0]);
    color[0] = 1;
    while stk.len > 0 {
        let top = stk.last();
        let b = an.mf.blocks.get(@int_cast(usize, top[0]));
        let k = @int_cast(usize, top[1]);
        if k < b.succs.len {
            stk.set(stk.len - 1, [top[0], top[1] + 1]);
            let s = b.succs.get(k);
            if (s >= 0) and (@int_cast(usize, s) < nb) and (color[@int_cast(usize, s)] == 0) {
                color[@int_cast(usize, s)] = 1;
                stk.push([s, 0]);
            }
        } else {
            post[np] = top[0];
            np += 1;
            _ = stk.pop();
        }
    }
    stk.deinit();
    for k in 0..np {
        let b = post[np - 1 - k];
        an.rpo[k] = b;
        an.rpon[@int_cast(usize, b)] = @int_cast(i32, k);
    }
    for k in np..nb {
        an.rpo[k] = -1;
    }
    an.idom[0] = 0;
    let mut changed = true;
    while changed {
        changed = false;
        for k in 1..np {
            let b = an.rpo[k];
            let mut nd: i32 = -1;
            for p in an.preds[@int_cast(usize, b)].items() {
                if (p < 0) or (an.idom[@int_cast(usize, p)] < 0) {
                    continue;
                }
                if nd < 0 {
                    nd = p;
                    continue;
                }
                // intersect
                let mut x = p;
                let mut y = nd;
                while x != y {
                    while an.rpon[@int_cast(usize, x)] > an.rpon[@int_cast(usize, y)] {
                        x = an.idom[@int_cast(usize, x)];
                    }
                    while an.rpon[@int_cast(usize, y)] > an.rpon[@int_cast(usize, x)] {
                        y = an.idom[@int_cast(usize, y)];
                    }
                }
                nd = x;
            }
            if (nd >= 0) and (an.idom[@int_cast(usize, b)] != nd) {
                an.idom[@int_cast(usize, b)] = nd;
                changed = true;
            }
        }
    }
}

// The flattened code (an.ins, an.bfirst) and each value's making.
fn flatten(an: *mut An) void {
    let mf = an.mf;
    let t = an.t;
    // the slots the code spills to and reloads from
    SLOTS.clear();
    SLOT_PL.clear();
    for bi in 0..an.nb {
        let mut i = mf.blocks.get(bi).first;
        while u.notnil(i) {
            if (i.spill != 0) and (i.sslot >= 0) and (slot_place(i.sslot) < 0) and (SLOTS.len < MAX_SLOTS) {
                while SLOT_PL.len <= @int_cast(usize, i.sslot) {
                    SLOT_PL.push(0);
                }
                SLOTS.push(i.sslot);
                SLOT_PL.set(@int_cast(usize, i.sslot), 64 + @int_cast(i32, SLOTS.len));
            }
            i = i.next;
        }
    }
    NL = 64 + SLOTS.len;
    let mut by_def = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    for k in 0..VALS.len {
        let x = VALS.get(k);
        if u.notnil(x.def) {
            by_def.put(key(@int_from_ptr(x.def)), @int_cast(i32, k) + 1);
        }
        an.defb[k] = -1;
        an.defi[k] = 0;
    }
    for bi in 0..an.nb {
        an.bfirst[bi] = an.ins.len;
        let mut i = mf.blocks.get(bi).first;
        while u.notnil(i) {
            an.tails = an.tails or t.is_tail(i);
            let mut x = Ins.{ i: i, w: written(mf, i) & t.alloc, kind: 0, d: -1, s: -1, defv: -1, defr: -1,
                              sw: [-1, -1], swall: false, imm: 0 };
            if t.is_exit(i) {
                x.kind = 4;
            } else if i.spill == 2 {
                x.kind = 1;
                x.d = mc.phys(mf, i.sreg);
                x.s = slot_place(i.sslot);
            } else if (i.spill == 1) and (i.sslot >= 0) {
                x.kind = 2;
                x.d = mc.phys(mf, i.sreg);
                x.s = slot_place(i.sslot);
            } else if i.is_move {
                let ds = move_regs(mf, i);
                x.kind = 3;
                x.d = ds[0];
                x.s = ds[1];
            } else if (i.ops.len > 0) and (i.ops[0].kind == mc.K_REG) and (t.imm_of(i) != NO_LOC) {
                x.kind = 5;
                x.d = mc.phys(mf, i.ops[0].reg);
                x.imm = t.imm_of(i);
            } else if t.may_store(i) {
                let mut n: usize = 0;
                for o in i.ops {
                    let l = slot_place(o.slot);
                    if (o.kind == mc.K_MEM) and (l >= 0) {
                        // (a slot another may write: not followed further)
                        if n < 2 {
                            x.sw[n] = l;
                        } else {
                            x.swall = true;
                        }
                        n += 1;
                    }
                }
            }
            if by_def.len > 0 {
                let dv = by_def.get(key(@int_from_ptr(i))) - 1;
                if dv >= 0 {
                    let v = VALS.get(@int_cast(usize, dv));
                    x.defv = dv;
                    x.defr = mc.phys(mf, i.ops[v.def_op].reg);
                    an.defb[@int_cast(usize, dv)] = @int_cast(i32, bi);
                    an.defi[@int_cast(usize, dv)] = an.ins.len;
                }
            }
            an.ins.push(x);
            i = i.next;
        }
    }
    an.bfirst[an.nb] = an.ins.len;
    drop_map.[i32](&mut by_def);
}

/// The location pieces of the function's variables, from its machine code
/// mf (allocated, encoded: block_at, inst_at), `size` bytes of it.
// debugging: AXIOM_DEBUG_DLOC=<function> (or *) traces the analysis of a
// function: its entities, values and, per instruction, the state.
let mut DBGF: bool = false;
let mut DBG_ENV: []u8 = "";
let mut DBG_READ: bool = false;
pub fn compute(mf: *mc.MFunc, t: *Tgt, size: u64) []VLoc {
    let mut out = u.List.[VLoc].empty();
    if not DBG_READ {
        DBG_ENV = u.perm_dup(u.env("AXIOM_DEBUG_DLOC"));  // (compute runs in a scratch scope)
        DBG_READ = true;
    }
    DBGF = (DBG_ENV.len > 0) and (u.str_eq(DBG_ENV, FN.name) or u.str_eq(DBG_ENV, "*"));
    if DBGF {
        u.eprint(
            u.f3(
                "func %s nv %s nc %s\n", FN.name, u.idec(@int_cast(i32, VALS.len)),
                u.idec(@int_cast(i32, CONSTS.len))));
        for k in 0..VALS.len {
            let x = VALS.get(k);
            let mut op: i32 = -1;
            if x.v.kind == ir.V_INST {
                op = x.v.op;
            } else if x.v.kind == ir.V_PARAM {
                op = -2;
            }
            u.eprint(
                u.f3(
                    "v%s op=%s ty=%s", u.idec(@int_cast(i32, k) + 1), u.idec(op),
                    u.idec(@int_cast(i32, @int_from_enum(x.v.ty.kind)))));
            u.eprint(u.f3(" xop=%s xa=%s xb=%s", u.idec(x.xop), u.idec(x.xa + 1), u.idec(x.xb + 1)));
            let mut dof: u64 = 0;
            if u.notnil(x.def) {
                dof = offset_of(x.def);
            }
            u.eprint(u.f2(" def=%s at=%s", u.idec(@as(i32, u.notnil(x.def))), u.hex16(dof)));
            if u.notnil(x.def) {
                let ds = move_regs(mf, x.def);
                u.eprint(u.f3(" mv=%s %s,%s", u.idec(@as(i32, x.def.is_move)), u.idec(ds[0]), u.idec(ds[1])));
            }
            u.eprint("\n");
        }
    }
    if DBGF {
        for e in 0..ENTS.len {
            let en = ENTS.get(e);
            let vs = dbi.vars_of(FN.name);
            if (en.inst == 0) and (@as(usize, en.var) < vs.len) {
                u.eprint(u.f2("e%s = %s\n", u.idec(@int_cast(i32, e)), vs[@as(usize, en.var)].name));
            } else if (en.inst != 0) and (@as(usize, en.inst) < dbi.scopes.len) {
                // (a variable of a function inlined: its function's, of instance inst)
                let fv = dbi.vars_of(dbi.scopes.get(@as(usize, en.inst)).func);
                if @as(usize, en.var) < fv.len {
                    u.eprint(u.f3("e%s = %s@%s\n", u.idec(@int_cast(i32, e)), fv[@as(usize, en.var)].name,
                                  u.idec(@bit_cast(i32, en.inst))));
                }
            }
        }
    }
    if not active or (ENTS.len == 0) {
        return out.items();
    }
    let nb = mf.blocks.len;
    if (nb == 0) or (boffs.len < nb) {
        return out.items();
    }
    // the phis' blocks
    let mut ir_mb = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    for b in 0..mb_ir.len {
        if u.notnil(mb_ir.get(b)) {
            ir_mb.put(key(@int_from_ptr(mb_ir.get(b))), @int_cast(i32, b) + 1);
        }
    }
    for k in 0..VALS.len {
        let x = VALS.at(k);
        if (x.v.kind == ir.V_INST) and (x.v.op == ir.OP_PHI) and u.notnil(x.v.blk) {
            x.phi_blk = ir_mb.get(key(@int_from_ptr(x.v.blk))) - 1;
        }
    }
    drop_map.[i32](&mut ir_mb);
    let ne = ENTS.len;
    let nv = @int_cast(i32, VALS.len);
    let mut an = An.{ mf: mf, t: t, nb: nb, ne: ne, nv: nv,
                      syn0: (2 * @as(i64, nv)) + @as(i64, @int_cast(i64, CONSTS.len)) + 1, ins: u.List.[Ins].empty(),
                      bfirst: u.newn.[usize](nb + 1), idom: u.newn.[i32](nb + 1), rpo: u.newn.[i32](nb + 1),
                      rpon: u.newn.[i32](nb + 1), defb: u.newn.[i32](VALS.len + 1), defi: u.newn.[usize](VALS.len + 1),
                      tails: false, preds: u.newn.[u.List.[i32]](nb + 1), ps: u.List.[*SState].empty(),
                      pb: u.List.[i32].empty(), ul: u.List.[usize].empty(), uf: u.newn.[bool](ne + 1),
                      cur: u.List.[usize].empty(), tup: u.List.[i32].empty(), reps: u.List.[usize].empty(),
                      rt: u.List.[i32].empty(), rnext: u.List.[i32].empty(),
                      tab: Tab.{ k: u.nil_slice.[u64](), v: u.nil_slice.[i32](), g: u.nil_slice.[u32](), cap: 0,
                                 gen: 0 }, atl: u.List.[usize].empty(), last: -1, nd: u.List.[PD].empty(),
                      nc: u.List.[PC].empty(), nf: u.newn.[bool](ne + 1), ncf: u.nil_slice.[bool]() };
    for e in 0..ne {
        an.uf[e] = false;
        an.nf[e] = false;
    }
    for b in 0..nb {
        an.preds[b] = u.List.[i32].empty();
    }
    for b in 0..nb {
        for sc in mf.blocks.get(b).succs.items() {
            if (sc >= 0) and (@int_cast(usize, sc) < nb) {
                an.preds[@int_cast(usize, sc)].push(@int_cast(i32, b));
            }
        }
    }
    dominators(&mut an);
    flatten(&mut an);
    an.ncf = u.newn.[bool](NL + 1);
    for l in 0..NL {
        an.ncf[l] = false;
    }
    NX = VALS.len;
    NXW = (NX + 63) / 64;
    find_deps();
    for k in 0..PHIS.len {
        PHIS.at(k).deinit();
    }
    PHIS.clear();
    for _b in 0..(nb + 1) {
        PHIS.push(u.List.[usize].empty());
    }
    for k in 0..VALS.len {
        let pbk = VALS.get(k).phi_blk;
        if (pbk >= 0) and (@int_cast(usize, pbk) < nb) {
            PHIS.at(@int_cast(usize, pbk)).push(k);
        }
    }
    // the state at the entry: the parameters in their registers, and the
    // variables they are
    let mut cur = st_new(&an);
    for k in 0..VALS.len {
        let x = VALS.get(k);
        if x.entry_reg >= 0 {
            set_reg(&an, &mut cur, x.entry_reg, id_val(@int_cast(i32, k)));
        }
    }
    for pe in PENTS.items() {
        put_d(&mut cur, @int_cast(usize, pe[0]), id_val(pe[1]), 0);
    }
    let mut entry = ss_new();
    snap(&mut cur, &mut entry);
    // (each block's state at its start is the meet of its predecessors' at
    // their ends: made again where it is needed, not kept; a block none of
    // whose predecessors' changed since it was run gives what it gave)
    let outs = u.newn.[SState](nb + 1);
    let dirty = u.newn.[bool](nb + 1);
    for b in 0..nb {
        outs[b] = ss_new();
        dirty[b] = true;
    }
    let mut tmp = ss_new();
    let mut changed = true;
    let mut rounds: i32 = 0;
    while changed and (rounds < 50) {
        changed = false;
        rounds += 1;
        for k in 0..nb {
            let b = an.rpo[k];
            if b < 0 {
                break;
            }
            let bi = @int_cast(usize, b);
            if not dirty[bi] {
                continue;
            }
            dirty[bi] = false;
            meet(&mut an, bi, outs, &entry, &mut cur);
            run_block(&an, bi, &mut cur);
            snap(&mut cur, &mut tmp);
            an.last = b;
            if not outs[bi].seen or not ss_same(&tmp, &outs[bi]) {
                let old = outs[bi];
                outs[bi] = tmp;
                tmp = old;
                outs[bi].seen = true;
                changed = true;
                for sc in mf.blocks.get(bi).succs.items() {
                    if (sc >= 0) and (@int_cast(usize, sc) < nb) {
                        dirty[@int_cast(usize, sc)] = true;
                    }
                }
            }
        }
    }
    st_free(&mut cur);
    if not changed {
        ranges(&mut an, outs, &entry, size, &mut out);
    }
    // (did not settle: nothing said)
    an.ins.deinit();
    for b in 0..nb {
        an.preds[b].deinit();
        ss_free(&mut outs[b]);
    }
    ss_free(&mut tmp);
    ss_free(&mut entry);
    an.ps.deinit();
    an.pb.deinit();
    an.ul.deinit();
    an.cur.deinit();
    an.tup.deinit();
    an.reps.deinit();
    an.rt.deinit();
    an.rnext.deinit();
    an.atl.deinit();
    an.nd.deinit();
    an.nc.deinit();
    return out.items();
}

// Block b's instructions over state s.
fn run_block(an: *An, b: usize, s: *mut State) void {
    for j in an.bfirst[b]..an.bfirst[b + 1] {
        let x = an.ins.at(j);
        if x.i.mk != 0 {
            apply_marks(an, s, x.i.mk, @int_cast(i32, b), j);
        }
        step(an, s, x);
    }
    let mb = an.mf.blocks.get(b);
    if mb.mk_end != 0 {
        apply_marks(an, s, mb.mk_end, @int_cast(i32, b), an.bfirst[b + 1]);
    }
}

// Where entity e is in state s, but in registers `minus` (written by the
// code the location is for): a location (its kind 0xff: none).
fn where(an: *An, s: *mut State, e: usize, minus: u64, prefer: i32) VLoc {
    let en = ENTS.get(e);
    let mut r = VLoc.{ var: en.var, poff: en.poff, psize: en.psize, kind: 0xff, start: 0, end: 0, reg: -1, off: 0,
                       add: s.a[e], size: en.size, ind: en.ind, gsym: "", inst: en.inst, expr: "" };
    let id = s.d[e];
    if id <= 0 {
        return r;
    }
    let nv = an.nv;
    if (id > 2 * nv) and (@as(i64, id) < an.syn0) {
        let c = CONSTS.get(@int_cast(usize, id - (2 * nv) - 1));
        if en.ind {
            return r;  // (a constant address: not one of a frame's)
        }
        r.kind = LK_CONST;
        r.off = @bit_cast(i64, c.bits);
        r.add = 0;
        r.size = c.size;
        return r;
    }
    if (id > nv) and (id <= 2 * nv) {
        // (waits for its making: computed from its operands, if they are
        // those it will be made from)
        let k = id - nv - 1;
        if (VALS.get(@int_cast(usize, k)).xop != 0) and not en.ind and pending_ok(an, k) {
            let mut ex = u.List.[u8].empty();
            TYPED = false;
            if expr_op(an, s, k, minus, 0, &mut ex) {
                computed(&mut r, ex);
            } else {
                ex.deinit();
            }
        }
        return r;
    }
    if id <= nv {
        let x = VALS.get(@int_cast(usize, id - 1));
        if x.gsym.len > 0 {
            r.kind = LK_GADDR;
            r.gsym = x.gsym;
            r.off = r.add;
            r.add = 0;
            return r;
        }
        if x.obj {
            let o = an.t.obj_off(x.v);
            if o != NO_LOC {
                r.kind = LK_ADDR;
                r.off = o +% r.add;
                r.add = 0;
            }
            return r;
        }
    }
    // (the register it was in, if it still is: fewer pieces; else the lowest)
    let mut best: i32 = -1;
    let rm = regs_of(s, id) & ~minus;
    if rm != 0 {
        for p in @as(usize, 0)..64 {
            if (rm & (@as(u64, 1) << @as(u32, @truncate(u32, p)))) != 0 {
                let dr = an.t.dw_reg(@int_cast(i32, p));
                if (dr >= 0) and ((best < 0) or (dr == prefer)) {
                    best = dr;
                }
            }
        }
    }
    if best >= 0 {
        r.kind = LK_REG;
        r.reg = best;
        return r;
    }
    let so = slot_of(an, s, id);
    if so != NO_LOC {
        r.kind = LK_SLOT;
        r.off = so;
        return r;
    }
    if id <= nv {
        let x = VALS.get(@int_cast(usize, id - 1));
        if (x.v.kind == ir.V_PARAM) and (x.stack_off != NO_LOC) and not an.tails {
            r.kind = LK_SLOT;
            r.off = x.stack_off;
            return r;
        }
        if (x.v.kind == ir.V_PARAM) and not en.ind {
            let mut ex = u.List.[u8].empty();
            if entry_value(an, &x, &mut ex) {
                r.kind = LK_EXPR;
                r.expr = ex.items();
            } else {
                ex.deinit();
            }
            return r;
        }
        if (x.xop != 0) and x_has(s, @int_cast(usize, id - 1)) and not en.ind {
            let mut ex = u.List.[u8].empty();
            TYPED = false;
            if expr_of(an, s, id - 1, minus, 0, &mut ex) {
                computed(&mut r, ex);
            } else {
                ex.deinit();
            }
        }
    }
    return r;
}

// Location r is the value expression ex computes (expr_of, TYPED since it
// was cleared): LK_EXPR, or LK_TEXPR with typed operations (a value of a
// base type, to which no constant is added).
fn computed(r: *mut VLoc, ex: u.List.[u8]) void {
    if TYPED and (r.add != 0) {
        let mut e = ex;
        e.deinit();
        return;
    }
    r.kind = LK_EXPR;
    if TYPED {
        r.kind = LK_TEXPR;
    }
    r.expr = ex.items();
}

// Call x (at code offset `at`; the next instructions of its block from
// index g to hi) in state s, before it: a call site.
fn call_site(an: *An, s: *mut State, x: *Ins, at: u64, g: usize, hi: usize) void {
    let tail = an.t.is_tail(x.i);
    let mut ret: u64 = 0;
    if not tail {
        // (the return address: the next instruction's offset)
        for j in g..hi {
            let o = offset_of(an.ins.get(j).i);
            if o != 0 {
                ret = o - 1;
                break;
            }
        }
        if ret <= at {
            return;
        }
    }
    let mut cs = CallSite.{ ret: ret, at: at, tail: tail, sym: -1, tgsym: "", toff: 0,
                            params: u.nil_slice.[CallParam]() };
    let i = x.i;
    if (i.ops.len > 0) and (i.ops[0].kind == mc.K_SYM) {
        cs.sym = i.ops[0].sym;
    } else {
        let c = @ptr_from_int(*mut ir.Value, call_ir.get(key(@int_from_ptr(i))));
        if u.notnil(c) and u.notnil(c.a) {
            // (through a pointer loaded from a datum: its address)
            let t = ir.resolve(c.a);
            if u.notnil(t) and (t.kind == ir.V_INST) and (t.op == ir.OP_LOAD) and u.notnil(t.a) {
                let mut a = ir.resolve(t.a);
                let mut off: i64 = 0;
                if (a.kind == ir.V_INST) and (a.op == ir.OP_PTRADD) and u.notnil(a.b) and (a.b.kind == ir.V_CINT) {
                    off = @bit_cast(i64, ir.cint_val(a.b));
                    a = ir.resolve(a.a);
                }
                if a.kind == ir.V_GLOBAL {
                    let gv = ir.gv_of(a);
                    if u.notnil(gv) and not gv.tls {
                        cs.tgsym = gv.name;
                        cs.toff = off;
                    }
                }
            }
        }
    }
    if not tail {
        // the arguments in registers, where the caller's frame keeps them
        let keep = ~(x.w | i.clobber);
        let mut ps = u.List.[CallParam].empty();
        for k in 1..i.ops.len {
            let o = i.ops[k];
            if (o.kind != mc.K_REG) or (o.role != mc.RU) {
                continue;
            }
            let r = mc.phys(an.mf, o.reg);
            let dr = an.t.dw_reg(r);
            let id = get_reg(an, s, r);
            if (dr < 0) or (dr >= 32) or (id == 0) {
                continue;  // (integer registers only)
            }
            let mut ex = u.List.[u8].empty();
            let mut ok = false;
            if id <= -2 {
                ex.push(OP_CONSTU);
                put_uleb(&mut ex, @bit_cast(u64, RCS.get(@int_cast(usize, -2 - id))));
                ok = true;
            } else if (id > 2 * an.nv) and (@as(i64, id) < an.syn0) {
                let c = CONSTS.get(@int_cast(usize, id - (2 * an.nv) - 1));
                ex.push(OP_CONSTU);
                put_uleb(&mut ex, c.bits);
                ok = true;
            } else if (id > 0) and (id <= an.nv) {
                TYPED = false;
                ok = expr_of(an, s, id - 1, ~keep, 0, &mut ex) and not TYPED;  // (dwarf.ax: untyped)
            }
            if ok {
                ps.push(CallParam.{ reg: dr, expr: ex.items() });
            } else {
                ex.deinit();
            }
        }
        cs.params = ps.items();
    }
    CALLS.push(cs);
}

// The instruction the locations are found before (ranges: its block and
// index in an.ins).
let mut CUR_B: i32 = -1;
let mut CUR_J: usize = 0;

// Is value k (not made yet) made further on in the block, before which
// none of the values it is computed from is made again? Then what holds
// them now holds what it will be made from.
fn pending_ok(an: *An, k: i32) bool {
    let ku = @int_cast(usize, k);
    if (an.defb[ku] != CUR_B) or (CUR_B < 0) or (an.defi[ku] < CUR_J) or (an.defi[ku] > CUR_J + 64) {
        return false;
    }
    for t in CUR_J..an.defi[ku] {
        let dv = an.ins.get(t).defv;
        if dv >= 0 {
            for j in DEPS.get(@int_cast(usize, dv)).items() {
                if j == k {
                    return false;
                }
            }
        }
    }
    return true;
}

// DWARF expression operations (DWARF 5, 7.7.1)
const OP_CONSTU: u8 = 0x10;
const OP_CONSTS: u8 = 0x11;
const OP_DEREF_SIZE: u8 = 0x94;
const OP_FBREG: u8 = 0x91;
const OP_BREG0: u8 = 0x70;
const OP_BREGX: u8 = 0x92;
const OP_SHL: u8 = 0x24;
const OP_SHR: u8 = 0x25;
const OP_SHRA: u8 = 0x26;
const OP_MUL: u8 = 0x1e;
const OP_OVER: u8 = 0x14;
const OP_SWAP: u8 = 0x16;
const OP_ROT: u8 = 0x17;
const OP_AND: u8 = 0x1a;
const OP_CONST1U: u8 = 0x08;
const OP_ENTRY_VALUE: u8 = 0xa3;

fn put_uleb(o: *mut u.List.[u8], x0: u64) void {
    let mut x = x0;
    while true {
        let b = @truncate(u8, x & 0x7f);
        x = x >> 7;
        if x == 0 {
            o.push(b);
            return;
        }
        o.push(b | 0x80);
    }
}

fn put_sleb(o: *mut u.List.[u8], x0: i64) void {
    let mut x = x0;
    while true {
        let b = @truncate(u8, @bit_cast(u64, x) & 0x7f);
        x = x >> 7;
        if ((x == 0) and ((b & 0x40) == 0)) or ((x == -1) and ((b & 0x40) != 0)) {
            o.push(b);
            return;
        }
        o.push(b | 0x80);
    }
}

// The top of the stack, its low `bits` bits zero- or sign-extended.
fn put_ext(o: *mut u.List.[u8], bits: u32, signed: bool) void {
    if bits >= 64 {
        return;
    }
    put_mask(o, bits);
    if signed {
        // (shifted left once not negative: see expr_ops)
        let sh = @as(u8, @truncate(u8, 64 - bits));
        o.push(OP_CONST1U);
        o.push(sh);
        o.push(OP_SHL);
        o.push(OP_CONST1U);
        o.push(sh);
        o.push(OP_SHRA);
    }
}

// The low `bits` bits of the value on top of the stack (all of it: 64).
fn put_mask(o: *mut u.List.[u8], bits: u32) void {
    if bits >= 64 {
        return;
    }
    o.push(OP_CONSTU);
    put_uleb(o, (@as(u64, 1) << @as(u32, bits)) - 1);
    o.push(OP_AND);
}

// Pushes parameter x's value as it arrived, in an integer register: its
// entry value (DWARF 5, 2.5.1.7), which a debugger finds from the call
// sites of the callers (call_site).
fn entry_value(an: *An, x: *Val, out: *mut u.List.[u8]) bool {
    if x.entry_reg < 0 {
        return false;
    }
    let dr = an.t.dw_reg(x.entry_reg);
    if (dr < 0) or (dr >= 32) or (int_bits(x.v) == 0) {
        return false;
    }
    out.push(OP_ENTRY_VALUE);
    out.push(1);
    out.push(0x50 + @truncate(u8, @as(u32, @bit_cast(u32, dr))));  // (DW_OP_regN)
    return true;
}

// Pushes value k's operand (VALS index o, or the constant c).
fn put_operand(an: *An, s: *mut State, o: i32, c: i64, minus: u64, depth: i32, out: *mut u.List.[u8]) bool {
    if o < 0 {
        out.push(OP_CONSTS);
        put_sleb(out, c);
        return true;
    }
    return expr_of(an, s, o, minus, depth + 1, out);
}

// Pushes value k (a VALS index) in state s, but in registers `minus`: from
// a register or spill slot that holds it, or (a value of expr_ops, none
// of whose operands was made again since it was: State.x) computed from
// its operands. False if it cannot be.
fn expr_of(an: *An, s: *mut State, k: i32, minus: u64, depth: i32, out: *mut u.List.[u8]) bool {
    let id = id_val(k);
    let x = VALS.get(@int_cast(usize, k));
    let ib = int_bits(x.v);
    if ib == 0 {
        if float_bits(x.v) > 0 {
            return fexpr_of(an, s, k, minus, depth, out);
        }
        return false;
    }
    let nbytes = (ib + 7) / 8;
    let rm = regs_of(s, id) & ~minus;
    if rm != 0 {
        for p in @as(usize, 0)..64 {
            if (rm & (@as(u64, 1) << @as(u32, @truncate(u32, p)))) != 0 {
                let dr = an.t.dw_reg(@int_cast(i32, p));
                if (dr >= 0) and (dr < 32) {
                    out.push(OP_BREG0 + @truncate(u8, @as(u32, @bit_cast(u32, dr))));
                    put_sleb(out, 0);
                    return true;
                }
            }
        }
    }
    let so = slot_of(an, s, id);
    if so != NO_LOC {
        out.push(OP_FBREG);
        put_sleb(out, so);
        out.push(OP_DEREF_SIZE);
        out.push(@truncate(u8, nbytes));
        return true;
    }
    if x.obj {
        let o = an.t.obj_off(x.v);
        if o == NO_LOC {
            return false;
        }
        out.push(OP_FBREG);
        put_sleb(out, o);
        return true;
    }
    if x.v.kind == ir.V_PARAM {
        if (x.stack_off != NO_LOC) and not an.tails {
            out.push(OP_FBREG);
            put_sleb(out, x.stack_off);
            out.push(OP_DEREF_SIZE);
            out.push(@truncate(u8, nbytes));
            return true;
        }
        return entry_value(an, &x, out);
    }
    // (an operand is computed from its operands as they are now, whether
    // or not anything made it since they were (State.x): the value at
    // depth 0 was made, none of what it is computed from made again since
    // (State.x; DEPS: through every depth expr_op reaches), or it is about
    // to be made from what is there now (pending_ok); and an operand's
    // making dominates its use, so no path from its last making to that
    // value's makes its own operands again (SSA): it was made from them as
    // they are)
    if (x.xop == 0) or (depth >= XDEPTH) or (out.len > XBYTES) or ((depth == 0) and not x_has(s, @int_cast(usize, k))) {
        return false;
    }
    return expr_op(an, s, k, minus, depth, out);
}

// Pushes a typed operation's base type operand (TY_*: dwarf.ax makes it
// the base type's offset in the unit).
fn put_ty(o: *mut u.List.[u8], ty: u8) void {
    TYPED = true;
    o.push(0x80 | ty);
    for _j in 2..TY_PAD {
        o.push(0x80);
    }
    o.push(0);
}

// The base type of floating-point values of `bits` bits.
fn fty(bits: u32) u8 {
    if bits == 32 {
        return TY_F32;
    }
    return TY_F64;
}

// An expression made since TYPED was last cleared has typed operations.
let mut TYPED: bool = false;

const OP_REGVAL_TYPE: u8 = 0xa5;
const OP_DEREF_TYPE: u8 = 0xa6;
const OP_CONST_TYPE: u8 = 0xa4;
const OP_CONVERT: u8 = 0xa8;
const OP_REINTERPRET: u8 = 0xa9;

// Pushes floating-point value k (float_bits), a value of its base type: as
// expr_of.
fn fexpr_of(an: *An, s: *mut State, k: i32, minus: u64, depth: i32, out: *mut u.List.[u8]) bool {
    let id = id_val(k);
    let x = VALS.get(@int_cast(usize, k));
    let fb = float_bits(x.v);
    let rm = regs_of(s, id) & ~minus;
    if rm != 0 {
        for p in @as(usize, 0)..64 {
            if (rm & (@as(u64, 1) << @as(u32, @truncate(u32, p)))) != 0 {
                let dr = an.t.dw_reg(@int_cast(i32, p));
                if dr >= 0 {
                    // (the register's low bytes, of the format: DWARF 5, 2.5.1.6)
                    out.push(OP_REGVAL_TYPE);
                    put_uleb(out, @as(u64, @bit_cast(u32, dr)));
                    put_ty(out, fty(fb));
                    return true;
                }
            }
        }
    }
    let mut so = slot_of(an, s, id);
    if (so == NO_LOC) and (x.v.kind == ir.V_PARAM) and (x.stack_off != NO_LOC) and not an.tails {
        so = x.stack_off;
    }
    if so != NO_LOC {
        out.push(OP_FBREG);
        put_sleb(out, so);
        out.push(OP_DEREF_TYPE);
        out.push(@truncate(u8, fb / 8));
        put_ty(out, fty(fb));
        return true;
    }
    if (x.v.kind == ir.V_PARAM) or (x.xop == 0) or (depth >= XDEPTH) or (out.len > XBYTES) or
       ((depth == 0) and not x_has(s, @int_cast(usize, k))) {
        return false;  // (as expr_of; no entry values: call sites give integer registers' only)
    }
    return expr_op(an, s, k, minus, depth, out);
}

// Pushes floating-point operand o (a VALS index, or the constant of bits c)
// of `bits` bits, of its base type.
fn put_foperand(an: *An, s: *mut State, o: i32, c: i64, bits: u32, minus: u64, depth: i32, out: *mut u.List.[u8]) bool {
    if o < 0 {
        out.push(OP_CONST_TYPE);
        put_ty(out, fty(bits));
        out.push(@truncate(u8, bits / 8));
        for j in @as(u32, 0)..(bits / 8) {
            out.push(@truncate(u8, @bit_cast(u64, c) >> (8 * j)));
        }
        return true;
    }
    return expr_of(an, s, o, minus, depth + 1, out);
}

// Pushes value k of fexpr_ops computed from its operands.
fn fexpr_op(an: *An, s: *mut State, k: i32, minus: u64, depth: i32, out: *mut u.List.[u8]) bool {
    let x = VALS.get(@int_cast(usize, k));
    let op = x.xop;
    let fb = float_bits(x.v);
    if (op == ir.OP_SITOFP) or (op == ir.OP_UITOFP) {
        // (the integer, extended to 64 bits as the operation reads it, then
        // converted to the format: rounded as the machine's conversion)
        if not put_operand(an, s, x.xa, x.ca, minus, depth, out) {
            return false;
        }
        let signed = op == ir.OP_SITOFP;
        put_ext(out, x.abits, signed);
        out.push(OP_CONVERT);
        if signed {
            put_ty(out, TY_I64);
        } else {
            put_ty(out, TY_U64);
        }
        out.push(OP_CONVERT);
        put_ty(out, fty(fb));
        return true;
    }
    if op == ir.OP_BITCAST {
        if fb > 0 {
            // (an integer's bits as a float: of the integer's width first)
            if not put_operand(an, s, x.xa, x.ca, minus, depth, out) {
                return false;
            }
            if fb == 32 {
                out.push(OP_CONVERT);
                put_ty(out, TY_U32);
            }
            out.push(OP_REINTERPRET);
            put_ty(out, fty(fb));
            return true;
        }
        // (a float's bits as an integer, then of the generic type)
        if not put_foperand(an, s, x.xa, x.ca, x.abits, minus, depth, out) {
            return false;
        }
        out.push(OP_REINTERPRET);
        if x.abits == 32 {
            put_ty(out, TY_U32);
        } else {
            put_ty(out, TY_U64);
        }
        out.push(OP_CONVERT);
        out.push(0);
        return true;
    }
    if not put_foperand(an, s, x.xa, x.ca, x.abits, minus, depth, out) {
        return false;
    }
    if op == ir.OP_FNEG {
        out.push(0x1f);  // DW_OP_neg
        return true;
    }
    if (op == ir.OP_FPEXT) or (op == ir.OP_FPTRUNC) {
        out.push(OP_CONVERT);
        put_ty(out, fty(fb));
        return true;
    }
    if not put_foperand(an, s, x.xb, x.cb, fb, minus, depth, out) {
        return false;
    }
    let mut code: u8 = 0x1b;  // DW_OP_div
    if op == ir.OP_FADD {
        code = 0x22;
    } else if op == ir.OP_FSUB {
        code = 0x1c;
    } else if op == ir.OP_FMUL {
        code = OP_MUL;
    }
    out.push(code);
    return true;
}

// Pushes value k (of expr_ops) computed from its operands.
fn expr_op(an: *An, s: *mut State, k: i32, minus: u64, depth: i32, out: *mut u.List.[u8]) bool {
    let x = VALS.get(@int_cast(usize, k));
    let op = x.xop;
    if (float_bits(x.v) > 0) or (op == ir.OP_BITCAST) {
        return fexpr_op(an, s, k, minus, depth, out);
    }
    if not put_operand(an, s, x.xa, x.ca, minus, depth, out) {
        return false;
    }
    if op == ir.OP_ZEXT {
        put_ext(out, x.abits, false);
        return true;
    }
    if op == ir.OP_SEXT {
        put_ext(out, x.abits, true);
        return true;
    }
    if (op == ir.OP_TRUNC) or (op == ir.OP_PTRTOINT) or (op == ir.OP_INTTOPTR) {
        return true;  // (the low bits: the debugger reads the variable's bytes)
    }
    let wide_mul = (op == ir.OP_MUL) and (x.bits > 32);
    if op == ir.OP_LSHR {
        put_ext(out, x.bits, false);
    } else if (op == ir.OP_ASHR) or ((op == ir.OP_MUL) and not wide_mul) {
        put_ext(out, x.bits, true);
    } else if op == ir.OP_SHL {
        // (the bits the shift keeps, of a value not negative: see expr_ops)
        let mut keep = x.bits;
        if x.xb < 0 {
            let c = @as(u32, @truncate(u32, @bit_cast(u64, x.cb) & 63));
            if c == 0 {
                return true;
            }
            keep = @min(keep, 64 - c);
        }
        put_mask(out, keep);
    }
    if not put_operand(an, s, x.xb, x.cb, minus, depth, out) {
        return false;
    }
    if wide_mul {
        mul64(out);
        return true;
    }
    if op == ir.OP_MUL {
        put_ext(out, x.bits, true);  // (both operands within 32 bits: see expr_ops)
    }
    if (op == ir.OP_LSHR) or (op == ir.OP_ASHR) or (op == ir.OP_SHL) {
        // (the count, as the machine's shift reads it: modulo 32 for a
        // value of at most 32 bits, else 64)
        if x.bits <= 32 {
            put_mask(out, 5);
        } else {
            put_mask(out, 6);
        }
    }
    let mut code: u8 = OP_SHRA;
    if (op == ir.OP_ADD) or (op == ir.OP_PTRADD) {
        code = 0x22;
    } else if op == ir.OP_SUB {
        code = 0x1c;
    } else if op == ir.OP_MUL {
        code = OP_MUL;
    } else if op == ir.OP_AND {
        code = OP_AND;
    } else if op == ir.OP_OR {
        code = 0x21;
    } else if op == ir.OP_XOR {
        code = 0x27;
    } else if op == ir.OP_SHL {
        code = OP_SHL;
    } else if op == ir.OP_LSHR {
        code = OP_SHR;
    }
    out.push(code);
    return true;
}

// The low 64 bits of the product of the two values on top of the stack,
// in their place, from products and shifts of values not negative (see
// expr_ops): with a = ah 2^32 + al, b = bh 2^32 + bl (halves of 32 bits),
// a b = al bl + ((ah bl + al bh) mod 2^32) 2^32 (mod 2^64).
fn mul64(o: *mut u.List.[u8]) void {
    // [a b]
    o.push(OP_OVER);
    o.push(OP_OVER);
    put_mask(o, 32);
    o.push(OP_SWAP);
    put_mask(o, 32);
    o.push(OP_MUL);  // [a b al.bl]
    o.push(OP_ROT);  // [al.bl a b]
    o.push(OP_OVER);
    o.push(OP_OVER);
    put_mask(o, 32);
    o.push(OP_SWAP);
    o.push(OP_CONST1U);
    o.push(32);
    o.push(OP_SHR);
    o.push(OP_MUL);  // [al.bl a b ah.bl]
    o.push(OP_ROT);  // [al.bl ah.bl a b]
    o.push(OP_CONST1U);
    o.push(32);
    o.push(OP_SHR);
    o.push(OP_SWAP);
    put_mask(o, 32);
    o.push(OP_MUL);  // [al.bl ah.bl al.bh]
    o.push(0x22);    // DW_OP_plus
    put_mask(o, 32);
    o.push(OP_CONST1U);
    o.push(32);
    o.push(OP_SHL);
    o.push(0x22);
}

fn same_loc(a: *VLoc, b: *VLoc) bool {
    return (a.kind == b.kind) and (a.reg == b.reg) and (a.off == b.off) and (a.add == b.add) and (a.size == b.size) and
           (a.gsym.ptr == b.gsym.ptr) and u.str_eq(a.expr, b.expr);
}

// The locations of every entity from code offset `at` on (in state s, but
// in registers `minus`; none at all: `none`), each one a piece of out
// when it differs from the one before (open: each entity's last piece in
// out + 1, 0: none open).
//
// An entity's location is found again (where) only where it may differ
// from the one found last for it: where depends on the entity's identity
// and constant, the places that hold the identity (the registers of those
// that `minus` names), `none`, and for a value computed from others (or
// waiting for its making) on the places of those: such an entity is
// looked at each time. The others are looked at again when their identity
// or constant changed, a place that held or holds the identity changed
// since (EM: the emission at which each identity's places last changed),
// or `minus` names other registers among those holding it.
//
// Which entities to look at is found from what changed since the last
// emission (the state's pcl and edl): those whose identity or constant was
// written, those being an identity a place of which changed, those being
// what a register of `minus` holds, and those that had to be looked at
// again (em.rl: computed or waiting, or held in a register of their
// minus); all of them where `none` changes and at the first emission. The
// others' locations are the ones found last.
fn emit_at(an: *An, em: *mut Em, s: *mut State, minus: u64, none: bool, at: u64, open: []mut usize,
           out: *mut u.List.[VLoc]) void {
    em.n += 1;
    for k in 0..NXW {
        let mut dx = s.x[k] ^ em.xl[k];
        while dx != 0 {
            let b = @as(usize, @truncate(u32, @ctz(dx)));
            dx = dx & (dx - 1);
            em.xst[(k * 64) + b] = em.n;
        }
        em.xl[k] = s.x[k];
    }
    let full = em.full or (none != em.lnone);
    em.full = false;
    em.lnone = none;
    em.rl2.clear();
    if full {
        for l in 0..NL {
            let c = s.c[l];
            if c != em.c[l] {
                em_touch(em, em.c[l]);
                em_touch(em, c);
                em.c[l] = c;
            }
        }
        for e in 0..an.ne {
            emit_one(an, em, s, e, minus, none, at, open, out);
        }
    } else {
        em.tids.clear();
        em.cl.clear();
        for l in s.pcl.items() {
            let c = s.c[l];
            if c != em.c[l] {
                em_touch(em, em.c[l]);
                em_touch(em, c);
                if em.c[l] != 0 {
                    em.tids.push(em.c[l]);
                }
                if c != 0 {
                    em.tids.push(c);
                }
                em.c[l] = c;
            }
        }
        for e in s.edl.items() {
            em_cand(em, e);
        }
        for e in em.rl.items() {
            em_cand(em, e);
        }
        for id in em.tids.items() {
            em_cands(em, s, id);
        }
        let mut m = minus;
        while m != 0 {
            let p = @as(usize, @truncate(u32, @ctz(m)));
            m = m & (m - 1);
            if s.c[p] != 0 {
                em_cands(em, s, s.c[p]);
            }
        }
        u.sort_usize(em.cl.items());
        for e in em.cl.items() {
            em.cf[e] = false;
            emit_one(an, em, s, e, minus, none, at, open, out);
        }
    }
    for l in s.pcl.items() {
        s.pcf[l] = false;
    }
    s.pcl.clear();
    for e in s.edl.items() {
        s.edf[e] = false;
    }
    s.edl.clear();
    let t = em.rl;
    em.rl = em.rl2;
    em.rl2 = t;
}

// Entity e is looked at in this emission.
fn em_cand(em: *mut Em, e: usize) void {
    if not em.cf[e] {
        em.cf[e] = true;
        em.cl.push(e);
    }
}

// And the entities being identity id.
fn em_cands(em: *mut Em, s: *mut State, id: i32) void {
    let mut e = he_get(s, id);
    while e >= 0 {
        em_cand(em, @int_cast(usize, e));
        e = s.en[@int_cast(usize, e)];
    }
}

// The incremental emission's tables (ranges makes them for a function).
struct Em {
    n: u64,          // the emissions so far
    c: []mut i32,    // each place's identity as last seen
    ids: u.U64Map,   // an identity -> the emission at which a place that holds it last changed (but:)
    low: []mut u64,  // the same for the identities 1 .. lown (the values, made or waiting, and the constants)
    lown: i32,
    vol: []mut bool,  // per identity 1 .. lown: looked at each time (a value computed from others, or waiting)
    at: []mut u64,    // per entity: the emission of its last where (0: none)
    d: []mut i32,     // and that where's inputs
    a: []mut i64,
    minus: []mut u64,
    none: []mut bool,
    full: bool,           // the next emission looks at every entity
    lnone: bool,          // (the last emission's none)
    rl: u.List.[usize],   // the entities to look at again in the next emission
    rl2: u.List.[usize],  // (and in the one after this)
    cl: u.List.[usize],   // the entities looked at in this one (once: cf)
    cf: []mut bool,
    tids: u.List.[i32],  // the identities whose places changed since the last
    xl: []mut u64,       // State.x as last seen
    xst: []mut u64,      // per value: the emission at which its State.x bit last changed
}

fn em_new(an: *An, ne: usize) Em {
    let lown = @truncate(i32, an.syn0 - 1);
    let n = @int_cast(usize, lown) + 1;
    let mut em = Em.{ n: 0, c: u.newn.[i32](NL + 1), ids: u.U64Map.empty(), low: u.newn.[u64](n), lown: lown,
                      vol: u.newn.[bool](n), at: u.newn.[u64](ne + 1), d: u.newn.[i32](ne + 1), a: u.newn.[i64](ne + 1),
                      minus: u.newn.[u64](ne + 1), none: u.newn.[bool](ne + 1), full: true, lnone: false,
                      rl: u.List.[usize].empty(), rl2: u.List.[usize].empty(), cl: u.List.[usize].empty(),
                      cf: u.newn.[bool](ne + 1), tids: u.List.[i32].empty(), xl: u.newn.[u64](NXW + 1),
                      xst: u.newn.[u64](NX + 1) };
    for k in 0..NXW {
        em.xl[k] = 0;
    }
    for k in 0..NX {
        em.xst[k] = 0;
    }
    let nv = an.nv;
    for id in 0..n {
        em.low[id] = 0;
        let k = @int_cast(i32, id);
        em.vol[id] = ((k > nv) and (k <= 2 * nv)) or ((k > 0) and (k <= nv) and (VALS.get(id - 1).xop != 0));
    }
    for l in 0..NL {
        em.c[l] = 0;
    }
    for e in 0..ne {
        em.at[e] = 0;
        em.cf[e] = false;
    }
    return em;
}

fn em_free(em: *mut Em) void {
    em.ids.deinit();
    em.rl.deinit();
    em.rl2.deinit();
    em.cl.deinit();
    em.tids.deinit();
}

fn em_touch(em: *mut Em, id: i32) void {
    if (id > 0) and (id <= em.lown) {
        em.low[@int_cast(usize, id)] = em.n;
    } else if id != 0 {
        em.ids.put(@as(u64, @bit_cast(u32, id)), em.n);
    }
}

// The registers of mask m that hold id in s.
fn held_in(s: *State, m: u64, id: i32) u64 {
    let mut r: u64 = 0;
    let mut x = m;
    while x != 0 {
        let p = @truncate(u32, @ctz(x));
        x = x & (x - 1);
        if s.c[@as(usize, p)] == id {
            r = r | (@as(u64, 1) << p);
        }
    }
    return r;
}

// Is entity e's location the one found for it last (see emit_at)?
fn em_same(an: *An, em: *mut Em, s: *State, e: usize, minus: u64, none: bool) bool {
    let id = s.d[e];
    if (em.at[e] == 0) or (em.d[e] != id) or (em.a[e] != s.a[e]) or (em.none[e] != none) {
        return false;
    }
    if (id > 0) and (id <= em.lown) {
        if em.vol[@int_cast(usize, id)] {
            // (computed from others: the same if the places of all it is
            // computed from, and their State.x, are; waiting: looked at)
            if (id > an.nv) or not clo_same(em, s, id - 1, e, minus) {
                return false;
            }
        } else if em.low[@int_cast(usize, id)] > em.at[e] {
            return false;
        }
    } else if em.ids.get(@as(u64, @bit_cast(u32, id))) > em.at[e] {
        return false;
    }
    return held_in(s, minus, id) == held_in(s, em.minus[e], id);
}

// Are the places and State.x of the values value k's expression may read
// (CLO) what they were at entity e's last where, and `minus` names the same
// registers among those holding them as it did?
fn clo_same(em: *mut Em, s: *State, k: i32, e: usize, minus: u64) bool {
    let ku = @int_cast(usize, k);
    for j in @as(usize, CLO_AT.get(ku))..@as(usize, CLO_AT.get(ku + 1)) {
        let c = CLO.get(j);
        let id = id_val(c);
        if (em.low[@int_cast(usize, id)] > em.at[e]) or (em.xst[@int_cast(usize, c)] > em.at[e]) or
           (held_in(s, minus, id) != held_in(s, em.minus[e], id)) {
            return false;
        }
    }
    return true;
}

// Entity e at an emission (emit_at's work).
fn emit_one(an: *An, em: *mut Em, s: *mut State, e: usize, minus: u64, none: bool, at: u64, open: []mut usize,
            out: *mut u.List.[VLoc]) void {
    if (s.d[e] <= 0) and (open[e] == 0) {
        em.at[e] = 0;
        return;  // (not known, and no piece open: none still)
    }
    if not em_same(an, em, s, e, minus, none) {
        emit_where(an, em, s, e, minus, none, at, open, out);
    }
    // (looked at again in the next emission: see emit_at)
    let id = s.d[e];
    if (id > 0) and (((id <= em.lown) and em.vol[@int_cast(usize, id)]) or (held_in(s, minus, id) != 0)) {
        em.rl2.push(e);
    }
}

fn emit_where(an: *An, em: *mut Em, s: *mut State, e: usize, minus: u64, none: bool, at: u64, open: []mut usize,
              out: *mut u.List.[VLoc]) void {
    em.at[e] = em.n;
    em.d[e] = s.d[e];
    em.a[e] = s.a[e];
    em.minus[e] = minus;
    em.none[e] = none;
    let mut prefer: i32 = -1;
    if (open[e] != 0) and (out.at(open[e] - 1).kind == LK_REG) {
        prefer = out.at(open[e] - 1).reg;
    }
    let mut w = where(an, s, e, minus, prefer);
    if none {
        w.kind = 0xff;
    }
    let o = open[e];
    if o != 0 {
        let p = out.at(o - 1);
        if (w.kind != 0xff) and same_loc(p, &w) {
            drop_expr(w.expr);
            return;
        }
        p.end = at;
        open[e] = 0;
    }
    if w.kind != 0xff {
        w.start = at;
        w.end = at;
        out.push(w);
        open[e] = out.len;
    } else {
        drop_expr(w.expr);
    }
}

// The pieces of the entities' locations over the encoded code: each block's
// start (the state it is entered with) and each visited instruction's group
// (the state before it, but what the group writes), in code order.
fn ranges(an: *mut An, outs: []mut SState, entry: *SState, size: u64, out: *mut u.List.[VLoc]) void {
    let nb = an.nb;
    let ne = an.ne;
    let mut em = em_new(an, ne);
    let open = u.newn.[usize](ne + 1);
    for e in 0..ne {
        open[e] = 0;
    }
    // the blocks in code order
    let order = u.newn.[usize](nb + 1);
    for b in 0..nb {
        order[b] = b;
    }
    for k in 1..nb {
        let mut j = k;
        while (j > 0) and (boffs.get(order[j - 1]) > boffs.get(order[j])) {
            let y = order[j];
            order[j] = order[j - 1];
            order[j - 1] = y;
            j -= 1;
        }
    }
    let mut s = st_new(an);
    load(&mut s, entry);
    s.trk = true;
    an.last = -1;
    // (the code before the first block's: the prologue, at the entry)
    CUR_B = -1;
    emit_at(an, &mut em, &mut s, 0, false, 0, open, out);
    let mut last: u64 = 0;
    for k in 0..nb {
        let b = order[k];
        let bo = boffs.get(b);
        if bo == 0xffff_ffff_ffff_ffff {
            continue;
        }
        let unreached = an.rpon[b] < 0;
        if unreached {
            st_clear(&mut s);
            an.last = -1;
        } else {
            meet(an, b, outs, entry, &mut s);
        }
        let lo = an.bfirst[b];
        let hi = an.bfirst[b + 1];
        // the first visited instruction's offset
        let mut first: u64 = 0xffff_ffff_ffff_ffff;
        for j in lo..hi {
            let o = offset_of(an.ins.get(j).i);
            if o != 0 {
                first = o - 1;
                break;
            }
        }
        CUR_B = @int_cast(i32, b);
        CUR_J = lo;
        if (bo >= last) and ((first == 0xffff_ffff_ffff_ffff) or (bo < first)) {
            emit_at(an, &mut em, &mut s, 0, unreached, bo, open, out);
            last = bo;
        }
        if DBGF {
            u.eprint(u.f2("block %s at %s\n", u.idec(@int_cast(i32, b)), u.hex16(bo)));
        }
        let mut j = lo;
        while j < hi {
            let x = an.ins.at(j);
            if x.i.mk != 0 {
                apply_marks(an, &mut s, x.i.mk, @int_cast(i32, b), j);
            }
            if DBGF {
                let mut t = u.f2("  %s k%s", u.hex16(offset_of(x.i)), u.idec(@as(i32, x.kind)));
                for e in 0..ne {
                    t = u.f3("%s e%s=%s", t, u.idec(@int_cast(i32, e)), u.idec(s.d[e]));
                }
                for l in 0..NL {
                    if s.c[l] != 0 {
                        t = u.f3("%s p%s:%s", t, u.idec(@int_cast(i32, l)), u.idec(s.c[l]));
                    }
                }
                for xk in 0..VALS.len {
                    if x_has(&s, xk) {
                        t = u.f2("%s x%s", t, u.idec(@int_cast(i32, xk) + 1));
                    }
                }
                u.eprint(u.f1("%s\n", t));
            }
            let o = offset_of(x.i);
            if o != 0 {
                // the group: this instruction and those encoded with it
                let mut minus = x.w;
                let mut exit = x.kind == 4;
                let mut g = j + 1;
                while (g < hi) and (offset_of(an.ins.get(g).i) == 0) {
                    minus = minus | an.ins.get(g).w;
                    exit = exit or (an.ins.get(g).kind == 4);
                    g += 1;
                }
                // (one machine instruction: a debugger stops at its start,
                // before it writes its registers, and nowhere else in it)
                if (g == j + 1) and (g < hi) and (x.i.clobber == 0) {
                    let nx = offset_of(an.ins.get(g).i);
                    if (nx > o) and an.t.single(x.i, nx - o) {
                        minus = 0;
                    }
                }
                if o - 1 >= last {
                    CUR_J = j;
                    emit_at(an, &mut em, &mut s, minus, exit or unreached, o - 1, open, out);
                    last = o - 1;
                }
                if ((x.i.clobber != 0) or an.t.is_tail(x.i)) and not unreached {
                    call_site(an, &mut s, x, o - 1, g, hi);
                }
            }
            step(an, &mut s, x);
            j += 1;
        }
        // (its end: the state at it is the one the analysis found, for the
        // block after it)
        let mb = an.mf.blocks.get(b);
        if mb.mk_end != 0 {
            apply_marks(an, &mut s, mb.mk_end, @int_cast(i32, b), hi);
        }
        if not unreached {
            an.last = @int_cast(i32, b);
        }
    }
    em_free(&mut em);
    st_free(&mut s);
    for e in 0..ne {
        if open[e] != 0 {
            out.at(open[e] - 1).end = size;
        }
    }
    // (pieces of no length out)
    let mut n: usize = 0;
    for k in 0..out.len {
        let p = out.get(k);
        if p.end > p.start {
            out.set(n, p);
            n += 1;
        } else {
            drop_expr(p.expr);
        }
    }
    out.len = n;
}
