// =============================================================================
// wasm.ax - WebAssembly code generation from the scalar IR.
//
// Control flow: the IR's (reducible) CFG becomes structured wasm with the
// dominator-tree algorithm of Ramsey, "Beyond Relooper" (ICFP 2022): each
// block is emitted once; merge points become `block`s ending just before
// them, loop headers become `loop`s, and branches become `br`s to them.
//
// Values: an instruction used once, by a later instruction of the same
// block, is emitted inline as an operand of that instruction (for effects,
// memory reads and calls only when nothing happens in between); allocas and
// constant pointer offsets are recomputed where used; everything else lives
// in a local. Phi nodes are locals written on each incoming edge, all
// inputs first, so the copies behave as one parallel assignment.
//
// Narrow integers (i1, i8, i16) are held in i32 values whose upper bits are
// unspecified, except i1, which is always 0 or 1; instructions that depend on
// them (comparisons, division, right shifts, extensions) extend first.
//
// Parts: expression lowering (wasm_emit.ax), memory and atomics
// (wasm_atomic.ax), SIMD128 vectors (wasm_simd.ax), scalar/system
// intrinsics (wasm_intr.ax), inline and file-scope assembly (wasm_asm.ax),
// value classification and local allocation (wasm_locals.ax), control flow
// (wasm_stackify.ax), debug info and variable locations (wasm_debug.ax), and
// function/module compilation (wasm_module.ax).
// =============================================================================
import "bin.ax" as bn;
import "ir.ax" as ir;
import "isel.ax" as is;
import "target.ax" as tg;
import "util.ax" as u;
import "wobj.ax" as wo;

import part "wasm_asm.ax";
import part "wasm_atomic.ax";
import part "wasm_debug.ax";
import part "wasm_emit.ax";
import part "wasm_intr.ax";
import part "wasm_locals.ax";
import part "wasm_module.ax";
import part "wasm_simd.ax";
import part "wasm_stackify.ax";

// flag values
const FL_LOCAL: i32 = 0;
const FL_INLINE: i32 = 1;
const FL_REMAT: i32 = 2;

threadlocal let mut UN: *mut wo.Unit = @ptr_from_int(*mut wo.Unit, 0);
threadlocal let mut W64: bool = false;
threadlocal let mut fsyms: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };  // Func.id -> symbol
threadlocal let mut gsyms: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };  // Global.id -> symbol
threadlocal let mut sp_sym: u32 = 0;
threadlocal let mut errors: bool = false;

// -----------------------------------------------------------------------------
// Per-function state
// -----------------------------------------------------------------------------
const CTX_BLOCK: i32 = 0;  // `block` whose end precedes `target`
const CTX_LOOP: i32 = 1;   // `loop` headed by `target`
const CTX_IF: i32 = 2;
const CTX_OTHER: i32 = 3;

struct Ctx {
    kind: i32,
    target: *mut ir.Block,
}

threadlocal let mut F: *mut ir.Func = @ptr_from_int(*mut ir.Func, 0);
threadlocal let mut CB: bn.Bytes = bn.Bytes.{ b: u.List.[u8].{ data: @ptr_from_int(*mut u8, 0), len: 0, cap: 0 } };
threadlocal let mut RL: u.List.[wo.Reloc] = u.List.[wo.Reloc].{ data: @ptr_from_int(*mut wo.Reloc, 0), len: 0, cap: 0 };
threadlocal let mut LT: u.List.[u8] = u.List.[u8].{ data: @ptr_from_int(*mut u8, 0), len: 0, cap: 0 };  // types of locals
threadlocal let mut ctx: u.List.[Ctx] = u.List.[Ctx].{ data: @ptr_from_int(*mut Ctx, 0), len: 0, cap: 0 };
threadlocal let mut fp_local: u32 = 0;
threadlocal let mut frame_size: u64 = 0;
// The largest frame: the stack check (codegen.ax, check_stack) compares
// addresses less than 2 GiB apart. Code generation keeps a function's
// locals to 1 GiB (E0473) and inlining keeps to that too.
const FRAME_MAX: u64 = 0x7000_0000;
threadlocal let mut va_off: i64 = 0;  // frame offset of the varargs buffer
threadlocal let mut nparams: u32 = 0;
threadlocal let mut merge_p: *mut bool = @ptr_from_int(*mut bool, 0);
threadlocal let mut header_p: *mut bool = @ptr_from_int(*mut bool, 0);
threadlocal let mut nblocks: usize = 0;

fn is_merge(b: *ir.Block) bool {
    return @slice_from_ptr(merge_p, nblocks)[@int_cast(usize, b.rpo)];
}

fn is_header(b: *ir.Block) bool {
    return @slice_from_ptr(header_p, nblocks)[@int_cast(usize, b.rpo)];
}

fn fail(msg: []u8) void {
    if u.isnil(F) {
        // (outside a function: file-scope asm's)
        u.eprint(u.f1("axiom: wasm code generation: %s\n", msg));
    } else {
        u.eprint(u.f2("axiom: wasm code generation: %s (in %s)\n", msg, F.name));
    }
    errors = true;
}

fn op(b: u8) void {
    CB.u8_(b);
}

fn op_fc(n: u64) void {
    CB.u8_(0xfc);
    CB.uleb(n);
}

fn op_fd(n: u64) void {
    CB.u8_(0xfd);
    CB.uleb(n);
}

fn op_fe(n: u64) void {
    CB.u8_(0xfe);
    CB.uleb(n);
}

fn ptr_vt() u8 {
    if W64 {
        return wo.I64;
    }
    return wo.I32;
}

pub fn vt(t: *ir.Ty) u8 {
    let k = t.kind;
    if k == ir.T_INT {
        if t.bits > 32 {
            return wo.I64;
        }
        return wo.I32;
    }
    if k == ir.T_PTR {
        return ptr_vt();
    }
    if k == ir.T_FLOAT {
        if t.bits == 32 {
            return wo.F32;
        }
        return wo.F64;
    }
    return wo.V128;
}

fn new_local(t: u8) u32 {
    LT.push(t);
    return nparams + @int_cast(u32, LT.len - 1);
}

// local.set x followed directly by local.get x is local.tee x
threadlocal let mut set_at: usize = 0;
threadlocal let mut set_end: usize = 0xffff_ffff;
threadlocal let mut set_idx: u32 = 0;

fn local_get(i: u32) void {
    if (CB.len() == set_end) and (set_idx == i) {
        CB.set_u8(set_at, 0x22);
        set_end = 0xffff_ffff;
        return;
    }
    op(0x20);
    CB.uleb(@as(u64, i));
}

fn local_set(i: u32) void {
    set_at = CB.len();
    op(0x21);
    CB.uleb(@as(u64, i));
    set_end = CB.len();
    set_idx = i;
}

fn local_tee(i: u32) void {
    op(0x22);
    CB.uleb(@as(u64, i));
}

fn i32c(x: i64) void {
    op(0x41);
    CB.sleb(@as(i64, @truncate(i32, x)));
}

fn i64c(x: i64) void {
    op(0x42);
    CB.sleb(x);
}

fn pconst(x: u64) void {
    if W64 {
        i64c(@bit_cast(i64, x));
    } else {
        i32c(@bit_cast(i64, x));
    }
}

fn reloc(t: u8, sym: u32, addend: i64) void {
    RL.push(wo.Reloc.{ ty: t, off: @int_cast(u32, CB.len()), sym: sym, addend: addend });
}

// -----------------------------------------------------------------------------
// setjmp and longjmp (the exception-handling extension; ir.ax's IN_SJLJ_*,
// made by c/cgen_sjlj.ax)
//
// longjmp (wlink.ax's longjmp_unit) stores its value in the jmp_buf and
// throws the tag __axc_longjmp_tag with the jmp_buf's address. A function
// that calls setjmp runs its body as
//     loop $again
//       block $caught (result ptr)
//         try_table (catch $tag $caught)  <the body>  end
//         unreachable
//       end
//       (the jmp_buf) its first word is not this activation's token (its
//       frame's address, which setjmp stored): throw it on
//       resumed = 1; br $again
//     end
// and its entry block asks IN_SJLJ_CAUGHT whether it was resumed: then
// the code the C front end made goes to the setjmp call the jmp_buf names.
// The rethrow is outside the try_table, so it leaves the function.
// -----------------------------------------------------------------------------
threadlocal let mut tag_sym: u32 = 0;
threadlocal let mut sj_resumed: u32 = 0;  // locals: the flag, the caught jmp_buf
threadlocal let mut sj_env: u32 = 0;

fn is64(t: *ir.Ty) bool {
    return vt(t) == wo.I64;
}

// i32 or i64 opcode by width
fn iop(t: *ir.Ty, o32: u8, o64: u8) void {
    if is64(t) {
        op(o64);
    } else {
        op(o32);
    }
}

// -----------------------------------------------------------------------------
// Narrow integers
// -----------------------------------------------------------------------------
fn bits_of(t: *ir.Ty) i32 {
    if t.kind == ir.T_PTR {
        return t.bits;
    }
    return t.bits;
}

// Zero-extends the i32 on the stack from `bits`.
fn norm_u(bits: i32) void {
    if (bits < 32) and (bits > 1) {
        i32c((@as(i64, 1) << @int_cast(u32, bits)) - 1);
        op(0x71);
    }
}

fn norm_s(bits: i32) void {
    if bits == 1 {
        // 0/1 -> 0/-1
        let t = new_local(wo.I32);
        local_set(t);
        i32c(0);
        local_get(t);
        op(0x6b);
        return;
    }
    if (bits == 8) or (bits == 16) {
        if tg.has(tg.W_SIGN_EXT) {
            op(u.pick(bits == 8, "\xc0", "\xc1")[0]);
        } else {
            let sh = @as(i64, 32 - bits);
            i32c(sh);
            op(0x74);
            i32c(sh);
            op(0x75);
        }
    }
}

// Pushes x, normalized when narrow (sign: sign-extend, else zero-extend).
fn push_ext(x: *mut ir.Value, sign: bool) void {
    push(x);
    let b = bits_of(x.ty);
    if not sign and (x.kind == ir.V_INST) and (x.op == ir.OP_LOAD) and ((b == 8) or (b == 16)) {
        return;  // loaded with load8_u / load16_u: already zero-extended
    }
    if (x.ty.kind == ir.T_INT) and (b < 32) and not ir.is_const(x) {
        if sign {
            norm_s(b);
        } else {
            norm_u(b);
        }
    } else if (x.ty.kind == ir.T_INT) and (b < 32) and sign and (x.kind == ir.V_CINT) {
        // constants are pushed zero-extended: fix the sign
        norm_s(b);
    }
}

// -----------------------------------------------------------------------------
// Operands
// -----------------------------------------------------------------------------
fn push_const(x: *mut ir.Value) void {
    let t = x.ty;
    let k = x.kind;
    if (k == ir.V_GLOBAL) {
        let s = gsyms.get(@int_cast(usize, ir.gv_of(x).id));
        if ir.gv_of(x).wasm_global {
            fail("address of a wasm global");
        }
        if W64 {
            op(0x42);
            reloc(wo.R_MEMORY_ADDR_SLEB64, s, 0);
            CB.sleb10(0);
        } else {
            op(0x41);
            reloc(wo.R_MEMORY_ADDR_SLEB, s, 0);
            CB.sleb5(0);
        }
        return;
    }
    if k == ir.V_FUNC {
        UN.uses_table = true;
        let s = fsyms.get(@int_cast(usize, ir.fnp_of(x).id));
        if W64 {
            op(0x42);
            reloc(wo.R_TABLE_INDEX_SLEB64, s, 0);
            CB.sleb10(0);
        } else {
            op(0x41);
            reloc(wo.R_TABLE_INDEX_SLEB, s, 0);
            CB.sleb5(0);
        }
        return;
    }
    let v = vt(t);
    if v == wo.V128 {
        // v128.const with the lane bytes
        let mut bytes = bn.new_bytes();
        is.const_le(x, &mut bytes, 0);
        op_fd(12);
        CB.put(bytes.view()[0..16]);
        bytes.free();
        return;
    }
    if (k == ir.V_ZERO) or (k == ir.V_UNDEF) {
        if v == wo.I32 {
            i32c(0);
        } else if v == wo.I64 {
            i64c(0);
        } else if v == wo.F32 {
            op(0x43);
            CB.u32_(0);
        } else {
            op(0x44);
            CB.u64_(0);
        }
        return;
    }
    if k == ir.V_CFP {
        if v == wo.F32 {
            op(0x43);
            CB.u32_(@as(u64, ir.f32_bits(ir.fv_of(x))));
        } else {
            op(0x44);
            CB.u64_(@bit_cast(u64, ir.fv_of(x)));
        }
        return;
    }
    if v == wo.I64 {
        i64c(@bit_cast(i64, x.cv));
    } else {
        i32c(@bit_cast(i64, x.cv));
    }
}

pub fn push(x: *mut ir.Value) void {
    let k = x.kind;
    if k == ir.V_PARAM {
        local_get(@truncate(u32, x.cv));
        return;
    }
    if k != ir.V_INST {
        push_const(x);
        return;
    }
    if (x.flag == FL_INLINE) or (x.flag == FL_REMAT) {
        expr(x);
        return;
    }
    if x.loc < 0 {
        fail(u.f1("value used without a local: %s", ir.inst_str(x)));
        return;
    }
    local_get(@int_cast(u32, x.loc));
}

// Pushes the base of an address and returns the constant offset to put in
// the memory instruction.
fn push_addr(p: *mut ir.Value) u64 {
    if (p.kind == ir.V_INST) and (p.op == ir.OP_ALLOCA) {
        local_get(fp_local);
        return @bit_cast(u64, p.aux);
    }
    if (p.kind == ir.V_INST) and (p.op == ir.OP_PTRADD) and ((p.flag == FL_INLINE) or (p.flag == FL_REMAT)) and
       (p.b.kind == ir.V_CINT) and (ir.sval(p.b) >= 0) and (ir.sval(p.b) < 0x4000_0000) {
        let base = push_addr(p.a);
        return base + p.b.cv;
    }
    push(p);
    return 0;
}

fn memarg(align: u32, size: u64, off: u64) void {
    let mut a = @as(u64, align);
    if (a == 0) or (a > size) {
        a = size;
    }
    let mut lg: u64 = 0;
    while (@as(u64, 1) << @truncate(u32, lg)) < a {
        lg += 1;
    }
    CB.uleb(lg);
    CB.uleb(off);
}

fn padd_sub(sub: bool) void {
    if W64 {
        op(u.pick(sub, "\x7d", "\x7c")[0]);
    } else {
        op(u.pick(sub, "\x6b", "\x6a")[0]);
    }
}
