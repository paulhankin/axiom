// =============================================================================
// copies.ax - removes copies of aggregates that are only read.
//
// Lowering (lower.ax) gives every aggregate value memory of its own: reading
// a struct from a variable, a field or through a pointer copies it into a
// fresh stack slot, since the source may change later; a `let` copies it
// again into the variable; passing it on passes the slot's address. So a
// 200-byte struct read, bound and passed on is copied two or three times,
// and inlining strings such copies together.
//
// A copy `memcpy(D, P, n)` into a stack slot D of n bytes is not needed when
//   - it is the only write to D, and everything else only reads D (loads,
//     copies from it, passing it by value: lowering marks those arguments
//     ir.EXT_BYVAL, and the callee cannot write them), after the copy (the
//     copy dominates every read);
//   - P does not change while D is read: P is (inside) a constant global, a
//     parameter passed by value, or a stack slot whose address goes nowhere
//     else and whose every write comes before the copy (dominates it). Then
//     no write to P can come between the copy and a read of D: the read
//     would be reachable from that write without passing the copy, so from
//     the function's entry too, and the copy would not dominate it.
// D's readers then read P instead, and the copy goes. A chain of copies
// collapses in a round: each link's source only gains readers.
//
// Also (renamable): a whole slot S copied into a slot D that is not used
// before, S not used after: D is S. And (split_copies, after scalar
// replacement): a copy or vector load out of a slot filled piece by piece
// is split at the pieces, each part taken from where it was written (a
// stored value, a fill, a copy's unchanged source), since a processor cannot
// forward several narrow stores to one wide load; then the writes of bytes
// nothing reads go (unread_writes).
// =============================================================================
import "ir.ax" as ir;
import "opt.ax" as opt;
import "util.ax" as u;

// What is known about an object whose address is used: its writes and
// reads, and whether its address goes anywhere we cannot follow.
struct Obj {
    writers: u.List.[*mut ir.Value],
    readers: u.List.[*mut ir.Value],
    escapers: u.List.[*mut ir.Value],  // where the address escapes (not for parameters)
    escaped: bool,
    readonly: bool,  // a constant global or a by-value parameter: never written
}

// (Obj records are reused: objs[0..nobjs] are in use.)
threadlocal let mut objs: u.List.[*mut Obj] = u.List.[*mut Obj].{ data: @ptr_from_int(*mut *mut Obj, 0), len: 0,
                                                                  cap: 0 };
threadlocal let mut nobjs: usize = 0;
threadlocal let mut marked: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{
    data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0, cap: 0 };
// (made when first used; never written: what a global is does not change)
threadlocal let mut const_global: *mut Obj = @ptr_from_int(*mut Obj, 0);
threadlocal let mut other_global: *mut Obj = @ptr_from_int(*mut Obj, 0);

// The object an address points into: an alloca, a parameter or a global,
// through constant or variable offsets (nil when it is none of those).
fn root(p: *mut ir.Value) *mut ir.Value {
    let r = ir.ptr_base(p);
    if u.notnil(r) and (ir.is_op(r, ir.OP_ALLOCA) or (r.kind == ir.V_PARAM) or (r.kind == ir.V_GLOBAL)) {
        return r;
    }
    return u.nil.[ir.Value]();
}

// (Allocas and parameters are numbered in aux2 while a round runs.)
fn obj_of(r: *mut ir.Value) *mut Obj {
    if r.kind == ir.V_GLOBAL {
        if u.isnil(const_global) {
            const_global = u.new.[Obj]();
            const_global.readonly = true;
            other_global = u.new.[Obj]();
            other_global.escaped = true;  // (anything may write a variable)
        }
        if ir.gv_of(r).is_const {
            return const_global;
        }
        return other_global;
    }
    if r.aux2 > 0 {
        return objs.get(@truncate(usize, @bit_cast(u64, r.aux2 - 1)));
    }
    if nobjs == objs.len {
        objs.push(u.new.[Obj]());
    }
    let o = objs.get(nobjs);
    nobjs += 1;
    o.writers.clear();
    o.readers.clear();
    o.escapers.clear();
    o.escaped = false;
    o.readonly = false;
    if r.kind == ir.V_PARAM {
        let f = ir.fnp_of(r);
        let k = @truncate(usize, r.cv);
        o.readonly = (k < f.param_ext.len) and (f.param_ext[k] == ir.EXT_BYVAL);
        o.escaped = not o.readonly;
    }
    marked.push(r);
    r.aux2 = @bit_cast(i64, @as(u64, nobjs));
    return o;
}

// How an instruction uses an address.
const READ: i32 = 0;
const WRITE: i32 = 1;
const ESCAPE: i32 = 2;

fn note(i: *mut ir.Value, p: *mut ir.Value, how: i32) void {
    if u.isnil(p) or (p.ty.kind != ir.T_PTR) {
        return;
    }
    let r = root(p);
    if u.isnil(r) {
        return;
    }
    let o = obj_of(r);
    if r.kind == ir.V_GLOBAL {
        return;  // (no lists for globals: what they are does not change)
    }
    if how == READ {
        o.readers.push(i);
    } else if how == WRITE {
        o.writers.push(i);
    } else {
        o.escaped = true;
        o.escapers.push(i);
    }
}

fn scan(f: *mut ir.Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let op = i.op;
            if op == ir.OP_LOAD {
                note(i, i.a, READ);
            } else if op == ir.OP_STORE {
                note(i, i.a, ESCAPE);  // (an address stored somewhere)
                note(i, i.b, WRITE);
            } else if (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE) {
                note(i, i.a, WRITE);
                note(i, i.b, READ);
            } else if op == ir.OP_MEMSET {
                note(i, i.a, WRITE);
            } else if op == ir.OP_CALL {
                note(i, i.a, ESCAPE);
                for k in 0..i.xs.len {
                    let mut e: u8 = 0;
                    if (k + 1) < ir.ext_of(i).len {
                        e = ir.ext_of(i)[k + 1];
                    }
                    if e == ir.EXT_BYVAL {
                        note(i, i.xs.get(k), READ);
                    } else if e == ir.EXT_SRET {
                        note(i, i.xs.get(k), WRITE);
                    } else {
                        note(i, i.xs.get(k), ESCAPE);
                    }
                }
            } else if (op != ir.OP_ALLOCA) and (op != ir.OP_PTRADD) {
                // (an offset address: what is done with it is noted)
                note(i, i.a, ESCAPE);
                note(i, i.b, ESCAPE);
                note(i, i.c, ESCAPE);
                for k in 0..i.xs.len {
                    note(i, i.xs.get(k), ESCAPE);
                }
            }
            i = i.next;
        }
        b = b.next;
    }
}

// Numbers instructions in their blocks, for dominance within a block (and
// clears the marks obj_of leaves in aux2, which other passes use too).
fn number(f: *mut ir.Func) void {
    for k in 0..f.params.len {
        f.params[k].aux2 = 0;
    }
    let mut b = f.first;
    while u.notnil(b) {
        let mut n: i32 = 0;
        let mut i = b.first;
        while u.notnil(i) {
            i.pos = n;
            i.aux2 = 0;
            n += 1;
            i = i.next;
        }
        b = b.next;
    }
}

// Does instruction a run before b on every path to b?
fn dominates(a: *mut ir.Value, b: *mut ir.Value) bool {
    if a.blk == b.blk {
        return a.pos < b.pos;
    }
    if (a.blk.rpo < 0) or (b.blk.rpo < 0) {
        return false;  // (unreachable)
    }
    return opt.dominates(a.blk, b.blk);
}

// Can copy c into slot D go: D only written by c and read after it, its
// source unchanged while D is read?
fn removable(c: *mut ir.Value) bool {
    let d = c.a;
    if (d.kind != ir.V_INST) or (d.op != ir.OP_ALLOCA) or not ir.is_cint(c.c) or
       (ir.cint_val(c.c) != ir.aty_of(d).size) {
        return false;
    }
    let od = obj_of(d);
    if od.escaped or (od.writers.len != 1) or (od.writers.get(0) != c) {
        return false;
    }
    let r = root(c.b);
    if u.isnil(r) or (r == d) {
        return false;
    }
    let os = obj_of(r);
    if os.escaped {
        return false;
    }
    if not os.readonly {
        for k in 0..os.writers.len {
            if not dominates(os.writers.get(k), c) {
                return false;
            }
        }
    }
    for k in 0..od.readers.len {
        if not dominates(c, od.readers.get(k)) {
            return false;
        }
    }
    return true;
}

// The source address of copy c where every use of D sees it: c's operand
// when it is an alloca, a parameter or a global; else its constant offset
// from that, computed after the allocas at the start of the function (nil
// when the offset is not constant). Copies removed earlier in the round are
// seen through (resolve).
fn source_for_uses(f: *mut ir.Func, c: *mut ir.Value) *mut ir.Value {
    let mut p = ir.resolve(c.b);
    let mut off: u64 = 0;
    while ir.is_op(p, ir.OP_PTRADD) {
        if not ir.is_cint(p.b) {
            return u.nil.[ir.Value]();
        }
        off +%= ir.cint_val(p.b);
        p = ir.resolve(p.a);
    }
    if off == 0 {
        return p;
    }
    let x = ir.new_inst(f, ir.OP_PTRADD, ir.t_ptr());
    ir.set_a(x, p);
    ir.set_b(x, ir.cint(ir.isz(), off));
    x.src = c.src;
    x.scope = c.scope;
    let mut at = f.first.first;
    while u.notnil(at) and (at.op == ir.OP_ALLOCA) {
        at = at.next;
    }
    if u.isnil(at) {
        ir.append_inst(f.first, x);
    } else {
        ir.insert_before(at, x);
    }
    return x;
}

// Folds offsets of offsets (ptradd(ptradd(p, a), b) is ptradd(p, a + b)):
// an address made by source_for_uses may have been based on a slot
// forwarded later in the round, to an address made after it.
fn fold_offsets(f: *mut ir.Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if (i.op == ir.OP_PTRADD) and ir.is_cint(i.b) {
                while ir.is_op(i.a, ir.OP_PTRADD) and ir.is_cint(i.a.b) {
                    ir.set_b(i, ir.cint(ir.isz(), ir.cint_val(i.b) +% ir.cint_val(i.a.b)));
                    ir.set_a(i, i.a.a);
                }
            }
            i = i.next;
        }
        b = b.next;
    }
}

// Might instruction i write memory (or run code that does)? Every intrinsic
// counts, even a pure one. A fence does not: these passes read a source
// later than the program did, and a read after the fence can see another
// thread's store that it could not have seen before it only if this thread
// published something in between (spec §12.8.2), which takes a write.
fn writes_memory(i: *ir.Value) bool {
    let op = i.op;
    return (ir.op_writes_mem(op) and (op != ir.OP_FENCE)) or (op == ir.OP_INTR);
}

fn whole(c: *ir.Value, d: *ir.Value) bool {
    return ir.is_op(d, ir.OP_ALLOCA) and ir.is_cint(c.c) and (ir.cint_val(c.c) == ir.aty_of(d).size);
}

// A copy of a copy: c2 copies slot D1, which c1 filled from S just before
// (in the same block, with nothing between them that writes memory), and
// nothing else reads D1. c2 can copy S itself (then c1 is dead), even when S
// may change later: it has not changed yet. Two different objects may still
// be one (two pointer parameters, a parameter and a global): unless S and
// c2's destination are known apart, c2 is put in moves, to become a memmove.
fn copy_of_copy(c2: *mut ir.Value, moves: *mut u.List.[*mut ir.Value]) *mut ir.Value {
    let d1 = c2.b;
    if not whole(c2, d1) {
        return u.nil.[ir.Value]();
    }
    let o = obj_of(d1);
    if o.escaped or (o.writers.len != 1) or (o.readers.len != 1) {
        return u.nil.[ir.Value]();
    }
    let c1 = o.writers.get(0);
    if (c1.op != ir.OP_MEMCPY) or (c1.a != d1) or not whole(c1, d1) or (c1.blk != c2.blk) or (c1.pos >= c2.pos) {
        return u.nil.[ir.Value]();
    }
    let rs = root(c1.b);
    if u.isnil(rs) or (rs == root(c2.a)) {
        return u.nil.[ir.Value]();  // (the copy must not overlap)
    }
    let mut i = c1.next;
    while i != c2 {
        if writes_memory(i) {
            return u.nil.[ir.Value]();
        }
        i = i.next;
    }
    if not apart(rs, root(c2.a)) {
        moves.push(c2);
    }
    return c1;
}

// A copy of a fill: c2 copies slot D1, which only c1 wrote, filling the
// whole of it with one byte (memset) before it in the same block, and
// nothing else reads D1. c2 can fill its destination itself (then c1 is
// dead): a zeroed struct returned and bound copies 0 into the variable.
fn copy_of_fill(c2: *mut ir.Value) *mut ir.Value {
    let d1 = c2.b;
    if not whole(c2, d1) {
        return u.nil.[ir.Value]();
    }
    let o = obj_of(d1);
    if o.escaped or (o.writers.len != 1) or (o.readers.len != 1) {
        return u.nil.[ir.Value]();
    }
    let c1 = o.writers.get(0);
    if (c1.op != ir.OP_MEMSET) or (c1.a != d1) or not whole(c1, d1) or (c1.blk != c2.blk) or (c1.pos >= c2.pos) {
        return u.nil.[ir.Value]();
    }
    return c1;
}

// The result of a call copied into this function's own result: the call
// can write it there itself. The result's memory (the sret parameter) is
// the caller's fresh slot, which nothing else here reads or writes, so it
// only must not be used between the call and the copy.
fn result_into_result(f: *mut ir.Func, c: *mut ir.Value) *mut ir.Value {
    if (f.params.len == 0) or (c.a != f.params[0]) or (f.param_ext.len == 0) or (f.param_ext[0] != ir.EXT_SRET) or
       not whole(c, c.b) {
        return u.nil.[ir.Value]();
    }
    let d = c.b;
    let o = obj_of(d);
    if o.escaped or (o.writers.len != 1) or (o.readers.len != 1) {
        return u.nil.[ir.Value]();
    }
    let k = o.writers.get(0);
    if (k.op != ir.OP_CALL) or (k.blk != c.blk) or (k.pos >= c.pos) or (k.xs.len == 0) or (k.xs.get(0) != d) {
        return u.nil.[ir.Value]();
    }
    for j in 0..k.xs.len {
        if (k.xs.get(j).ty.kind == ir.T_PTR) and (root(k.xs.get(j)) == c.a) {
            return u.nil.[ir.Value]();
        }
    }
    let mut i = k.next;
    while i != c {
        if uses_address(i, c.a) {
            return u.nil.[ir.Value]();
        }
        i = i.next;
    }
    return k;
}

fn uses_address(i: *ir.Value, p: *mut ir.Value) bool {
    let ops: [3]*mut ir.Value = [i.a, i.b, i.c];
    for o in ops {
        if u.notnil(o) and (o.ty.kind == ir.T_PTR) and (root(o) == p) {
            return true;
        }
    }
    for k in 0..i.xs.len {
        let o = i.xs.get(k);
        if (o.ty.kind == ir.T_PTR) and (root(o) == p) {
            return true;
        }
    }
    return false;
}

// The constant offset of address p from its root (false if it has none).
fn const_off(p0: *mut ir.Value, off: *mut i64) bool {
    let mut p = p0;
    let mut o: i64 = 0;
    while ir.is_op(p, ir.OP_PTRADD) {
        if not ir.is_cint(p.b) {
            return false;
        }
        o +%= ir.sval(p.b);
        p = p.a;
    }
    off.* = o;
    return true;
}

// The bytes [lo, hi) of its slot that writer w writes (false if they are
// not constant).
fn written(w: *mut ir.Value, lo: *mut i64, hi: *mut i64) bool {
    let mut p = w.a;
    let mut n: i64 = 0;
    if w.op == ir.OP_STORE {
        p = w.b;
        n = @bit_cast(i64, w.a.ty.size);
    } else if (w.op == ir.OP_MEMCPY) or (w.op == ir.OP_MEMMOVE) or (w.op == ir.OP_MEMSET) {
        if not ir.is_cint(w.c) {
            return false;
        }
        n = ir.sval(w.c);
    } else {
        return false;
    }
    if not const_off(p, lo) {
        return false;
    }
    hi.* = lo.* + n;
    return true;
}

// Does the source of copy w (into a slot) hold the same bytes when copy c
// below it in the block runs? Only writes to other slots whose addresses go
// nowhere (which the source, read through another object, cannot be) may
// come between them.
fn source_unchanged(w: *mut ir.Value, c: *mut ir.Value) bool {
    if ((w.op != ir.OP_MEMCPY) and (w.op != ir.OP_MEMMOVE)) or (w.blk != c.blk) {
        return false;
    }
    let rs = root(w.b);
    let mut i = w.next;
    while u.notnil(i) and (i != c) {
        if writes_memory(i) {
            let op = i.op;
            let mut p = i.a;
            if op == ir.OP_STORE {
                p = i.b;
            } else if (op != ir.OP_MEMCPY) and (op != ir.OP_MEMMOVE) and (op != ir.OP_MEMSET) {
                return false;
            }
            let rd = root(p);
            if u.isnil(rd) or (rd.kind != ir.V_INST) or (rd.op != ir.OP_ALLOCA) or (rd == rs) or obj_of(rd).escaped {
                return false;
            }
        }
        i = i.next;
    }
    return i == c;
}

const MAX_PIECES: usize = 16;

// A copy out of a stack slot that was filled piece by piece (fields
// stored one at a time, halves copied in): the copy reads across the
// pieces' stores, which a processor cannot forward to one wider load (a
// stall of a dozen cycles or more). Split at the pieces' boundaries, each
// part reads what one write wrote; a part that a store wrote just before
// (in the block, nothing writing it since) stores that value instead, and
// the slot may then not be read at all. Splitting a copy is always exact:
// the slot's address goes nowhere else, so the copy cannot overlap it.
fn split_copy(c: *mut ir.Value, B: *mut ir.Builder) bool {
    if ((c.op != ir.OP_MEMCPY) and (c.op != ir.OP_MEMMOVE)) or not ir.is_cint(c.c) {
        return false;
    }
    let r = root(c.b);
    if u.isnil(r) or (r.kind != ir.V_INST) or (r.op != ir.OP_ALLOCA) or (root(c.a) == r) or (r.flag == 78) {
        return false;
    }
    let o = obj_of(r);
    let mut base: i64 = 0;
    if o.escaped or not const_off(c.b, &mut base) {
        return false;
    }
    let n = ir.sval(c.c);
    if (n <= 0) or (n > 256) {
        return false;
    }
    let mut cuts = u.List.[i64].empty();
    if not cuts_of(o, base, n, &mut cuts) {
        cuts.deinit();
        return false;
    }
    // what each part can be had from instead of the slot
    let mut froms = u.List.[*mut ir.Value].empty();
    let mut nfrom: usize = 0;
    for j in 0..(cuts.len - 1) {
        let mut x = exact_writer(o, cuts.get(j), cuts.get(j + 1), c);
        // (a part copied from elsewhere: the parts written before it must
        // not change its source, which must then be apart from the
        // destination)
        if u.notnil(x) and ((x.op == ir.OP_MEMCPY) or (x.op == ir.OP_MEMMOVE)) and not apart(root(x.b), root(c.a)) {
            x = u.nil.[ir.Value]();
        }
        if u.isnil(x) and unwritten(o, cuts.get(j), cuts.get(j + 1)) {
            x = c;  // (nothing to copy)
        }
        if u.notnil(x) {
            nfrom += 1;
        }
        froms.push(x);
    }
    let changed = (cuts.len > 2) or (nfrom > 0);
    if changed {
        ir.at_before(B, c);
        for j in 0..(cuts.len - 1) {
            let off = ir.cint(ir.isz(), @bit_cast(u64, cuts.get(j) - base));
            let size = ir.cint(ir.isz(), @bit_cast(u64, cuts.get(j + 1) - cuts.get(j)));
            let d = ir.ptradd(B, c.a, off);
            let w = froms.get(j);
            if w == c {
                // bytes nothing writes (a struct's padding): their content is
                // not defined, and the destination's will do
            } else if u.isnil(w) {
                let s = ir.ptradd(B, c.b, off);
                _ = ir.memop(B, c.op, d, s, size);
            } else if w.op == ir.OP_STORE {
                let s = ir.store(B, w.a, d);
                s.align = 1;
            } else if w.op == ir.OP_MEMSET {
                _ = ir.memop(B, ir.OP_MEMSET, d, w.b, size);
            } else {
                _ = ir.memop(B, ir.OP_MEMCPY, d, w.b, size);  // (apart)
            }
        }
        // (the copy's destination has new writers: copies out of it wait
        // for the next round)
        let rd = root(c.a);
        if u.notnil(rd) and (rd.kind == ir.V_INST) {
            rd.flag = 78;
            marked_split.push(rd);
        }
        ir.remove_inst(c);
    }
    cuts.deinit();
    froms.deinit();
    return changed;
}

// Are objects s (a copy's source) and d (its destination; nil: not known)
// known not to overlap: different, and one of them a stack slot whose
// address goes nowhere else (which nothing else can point into), or s
// never written?
fn apart(s: *mut ir.Value, d: *mut ir.Value) bool {
    if s == d {
        return false;
    }
    if u.notnil(s) and obj_of(s).readonly {
        return true;
    }
    let xs: [2]*mut ir.Value = [s, d];
    for x in xs {
        if ir.is_op(x, ir.OP_ALLOCA) and not obj_of(x).escaped {
            return true;
        }
    }
    return false;
}

// The cuts [base, ..., base + n) that the writes of slot o make in the
// bytes it reads there, sorted (false if a write's bytes are not constant
// or there are too many).
fn cuts_of(o: *mut Obj, base: i64, n: i64, cuts: *mut u.List.[i64]) bool {
    cuts.push(base);
    cuts.push(base + n);
    for k in 0..o.writers.len {
        let mut lo: i64 = 0;
        let mut hi: i64 = 0;
        if not written(o.writers.get(k), &mut lo, &mut hi) {
            return false;
        }
        let ends: [2]i64 = [lo, hi];
        for e in ends {
            if (e > base) and (e < (base + n)) {
                let mut seen = false;
                for x in cuts.items() {
                    seen = seen or (x == e);
                }
                if not seen {
                    cuts.push(e);
                }
            }
        }
    }
    if (cuts.len - 1) > MAX_PIECES {
        return false;
    }
    // (sorted: a few elements)
    for a in 1..cuts.len {
        let mut b = a;
        while (b > 0) and (cuts.get(b - 1) > cuts.get(b)) {
            let t = cuts.get(b);
            cuts.set(b, cuts.get(b - 1));
            cuts.set(b - 1, t);
            b -= 1;
        }
    }
    return true;
}

// Does no write of slot o write any of bytes [lo, hi)? (Every write's bytes
// are known.)
fn unwritten(o: *mut Obj, lo: i64, hi: i64) bool {
    for k in 0..o.writers.len {
        let mut wl: i64 = 0;
        let mut wh: i64 = 0;
        _ = written(o.writers.get(k), &mut wl, &mut wh);
        if (wh > lo) and (wl < hi) {
            return false;
        }
    }
    return true;
}

// The write of slot o that last wrote bytes [lo, hi) before x in x's block,
// when it wrote exactly those bytes and what it wrote can be had where x
// is: a store's value, a fill, or a copy's source unchanged since. Else nil.
fn exact_writer(o: *mut Obj, lo: i64, hi: i64, x: *mut ir.Value) *mut ir.Value {
    let mut last = u.nil.[ir.Value]();
    for k in 0..o.writers.len {
        let w = o.writers.get(k);
        let mut wl: i64 = 0;
        let mut wh: i64 = 0;
        _ = written(w, &mut wl, &mut wh);
        // (a write in another block cannot run between a write above x in
        // its block and x)
        if (wh > lo) and (wl < hi) and (w.blk == x.blk) and (w.pos < x.pos) and (u.isnil(last) or (last.pos < w.pos)) {
            last = w;
        }
    }
    if u.isnil(last) or (last.flags != 0) {
        return u.nil.[ir.Value]();
    }
    let mut wl: i64 = 0;
    let mut wh: i64 = 0;
    _ = written(last, &mut wl, &mut wh);
    if (wl == lo) and (wh == hi) and
       ((last.op == ir.OP_STORE) or (last.op == ir.OP_MEMSET) or
        ((root(last.b) != root(last.a)) and source_unchanged(last, x))) {
        return last;
    }
    return u.nil.[ir.Value]();
}

// A vector load from a slot filled in equal pieces of 1 to 8 bytes (two
// halves copied in, say): the load reads across the pieces' stores, which
// cannot be forwarded to it. It becomes the pieces as integer lanes, each
// taken from where its write took it (or loaded from the slot by itself).
fn split_load(l: *mut ir.Value, B: *mut ir.Builder) bool {
    if (l.op != ir.OP_LOAD) or (l.flags != 0) or (l.ty.kind != ir.T_VEC) {
        return false;
    }
    let r = root(l.a);
    if u.isnil(r) or (r.kind != ir.V_INST) or (r.op != ir.OP_ALLOCA) or (r.flag == 78) {
        return false;
    }
    let o = obj_of(r);
    let mut base: i64 = 0;
    if o.escaped or not const_off(l.a, &mut base) {
        return false;
    }
    let n = @bit_cast(i64, l.ty.size);
    let mut cuts = u.List.[i64].empty();
    let mut ok = cuts_of(o, base, n, &mut cuts) and (cuts.len > 2);
    let mut w: i64 = 0;
    if ok {
        w = cuts.get(1) - cuts.get(0);
        ok = (w <= 8) and ((w & (w - 1)) == 0);
        for j in 0..(cuts.len - 1) {
            ok = ok and ((cuts.get(j + 1) - cuts.get(j)) == w);
        }
    }
    if not ok {
        cuts.deinit();
        return false;
    }
    let lt = ir.t_int(@truncate(i32, w * 8));
    let vt = ir.t_vec(lt, @truncate(u32, @bit_cast(u64, n / w)));
    ir.at_before(B, l);
    let mut v = ir.undef(vt);
    for j in 0..(cuts.len - 1) {
        let lo = cuts.get(j);
        let x = exact_writer(o, lo, lo + w, l);
        let mut e = u.nil.[ir.Value]();
        if u.isnil(x) {
            let q = ir.load(B, lt, ir.ptradd(B, l.a, ir.cint(ir.isz(), @bit_cast(u64, lo - base))));
            q.align = 1;
            e = q;
        } else if x.op == ir.OP_STORE {
            e = x.a;
            if e.ty.kind == ir.T_PTR {
                e = ir.ptrtoint(B, e, lt);
            } else if (e.ty.kind == ir.T_INT) and (e.ty.bits < lt.bits) {
                e = ir.zext(B, e, lt);  // (a bool: a byte holding 0 or 1)
            } else if e.ty != lt {
                e = ir.bitcast(B, e, lt);
            }
        } else if x.op == ir.OP_MEMSET {
            if ir.is_cint(x.b) {
                let byte = ir.cint_val(x.b) & 0xff;
                let mut k: u64 = 0;
                for _b in 0..@bit_cast(u64, w) {
                    k = (k << 8) | byte;
                }
                e = ir.cint(lt, k);
            } else {
                let q = ir.load(B, lt, ir.ptradd(B, l.a, ir.cint(ir.isz(), @bit_cast(u64, lo - base))));
                q.align = 1;
                e = q;
            }
        } else {
            let q = ir.load(B, lt, x.b);
            q.align = 1;
            e = q;
        }
        v = ir.insert_elem(B, v, e, @as(u64, j));
    }
    if vt != l.ty {
        v = ir.bitcast(B, v, l.ty);
    }
    ir.forward(l, v);
    ir.remove_inst(l);
    cuts.deinit();
    return true;
}

threadlocal let mut SB: *mut ir.Builder = @ptr_from_int(*mut ir.Builder, 0);
threadlocal let mut marked_split: u.List.[*mut ir.Value] =
    u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0, cap: 0 };

/// Splits copies and vector loads out of slots filled piece by piece
/// (split_copy, split_load); true if it changed any.
pub fn split_copies(f: *mut ir.Func) bool {
    if u.isnil(SB) {
        SB = ir.new_builder();
    }
    let mut any = false;
    for _round in @as(i32, 0)..4 {
        number(f);
        scan(f);
        let mut cs = u.List.[*mut ir.Value].empty();
        let mut b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                if (i.op == ir.OP_MEMCPY) or (i.op == ir.OP_MEMMOVE) or (i.op == ir.OP_LOAD) {
                    cs.push(i);
                }
                i = i.next;
            }
            b = b.next;
        }
        let mut changed = false;
        for c in cs.items() {
            if c.op == ir.OP_LOAD {
                if split_load(c, SB) {
                    changed = true;
                }
            } else if split_copy(c, SB) {
                changed = true;
            }
        }
        cs.deinit();
        for x in marked_split.items() {
            x.flag = 0;
        }
        marked_split.clear();
        clear();
        if not changed {
            break;
        }
        any = true;
    }
    if unread_writes(f) {
        any = true;
    }
    return any;
}

/// Removes the writes to stack slots of bytes that nothing reads (see
/// remove_unread_writes); true if it removed any.
pub fn unread_writes(f: *mut ir.Func) bool {
    number(f);
    scan(f);
    let any = remove_unread_writes(f);
    clear();
    return any;
}

// The bytes [lo, hi) of slot r that reader x reads (false if they are not
// constant: then it may read any).
fn read_range(x: *mut ir.Value, r: *mut ir.Value, lo: *mut i64, hi: *mut i64) bool {
    if (x.op == ir.OP_LOAD) and const_off(x.a, lo) {
        hi.* = lo.* + @bit_cast(i64, x.ty.size);
        return true;
    }
    if ((x.op == ir.OP_MEMCPY) or (x.op == ir.OP_MEMMOVE)) and ir.is_cint(x.c) and (root(x.b) == r) and
       (root(x.a) != r) and const_off(x.b, lo) {
        hi.* = lo.* + ir.sval(x.c);
        return true;
    }
    return false;
}

// Removes the writes to stack slots whose addresses go nowhere of bytes that
// nothing reads: what is left of a value built in a slot once the copies
// out of it are split (split_copy), each part taken from where it was
// written. True if it removed any.
fn remove_unread_writes(f: *mut ir.Func) bool {
    let mut dead = u.List.[*mut ir.Value].empty();
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let op = i.op;
            let mut p = i.a;
            if op == ir.OP_STORE {
                p = i.b;
            }
            let mut lo: i64 = 0;
            let mut hi: i64 = 0;
            if ((op == ir.OP_STORE) or (op == ir.OP_MEMSET) or (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE)) and
               (i.flags == 0) and written(i, &mut lo, &mut hi) {
                let r = root(p);
                let copy = (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE);
                if ir.is_op(r, ir.OP_ALLOCA) and not (copy and (root(i.b) == r)) {
                    let o = obj_of(r);
                    let mut read = o.escaped;
                    for k in 0..o.readers.len {
                        let x = o.readers.get(k);
                        let mut rl: i64 = 0;
                        let mut rh: i64 = 0;
                        if not read_range(x, r, &mut rl, &mut rh) or ((rh > lo) and (rl < hi)) {
                            read = true;
                            break;
                        }
                    }
                    if not read {
                        dead.push(i);
                    }
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    for i in dead.items() {
        ir.remove_inst(i);
    }
    let any = dead.len > 0;
    dead.deinit();
    return any;
}

fn clear() void {
    for k in 0..marked.len {
        marked.get(k).aux2 = 0;
    }
    marked.clear();
    nobjs = 0;
}

// Is any of the instructions marked (flag 79) reachable from c: after c in
// its block, or in a block reachable from c's block (c's own block again
// included, when c is in a loop)?
fn reaches_marked(c: *mut ir.Value) bool {
    let mut i = c.next;
    while u.notnil(i) {
        if i.flag == 79 {
            return true;
        }
        i = i.next;
    }
    let mut stack = u.List.[*mut ir.Block].empty();
    let mut seen = u.List.[*mut ir.Block].empty();
    let t = c.blk.last;
    for k in 0..ir.succ_count(t) {
        stack.push(ir.succ(t, k));
    }
    let mut found = false;
    while (stack.len > 0) and not found {
        let b = stack.get(stack.len - 1);
        stack.len -= 1;
        if b.aux == 79 {
            continue;
        }
        b.aux = 79;
        seen.push(b);
        let mut j = b.first;
        while u.notnil(j) {
            if j.flag == 79 {
                found = true;
            }
            j = j.next;
        }
        let bt = b.last;
        for k in 0..ir.succ_count(bt) {
            stack.push(ir.succ(bt, k));
        }
    }
    for b in seen.items() {
        b.aux = 0;
    }
    stack.deinit();
    seen.deinit();
    return found;
}

// A copy of a whole slot S into slot D (at its start) after which S is
// never used again, before which D is not used: D can be S itself (S made
// as large as D), and the copy goes. A value built in a function's local
// and returned, then bound to a variable, is one slot instead of three.
fn renamable(c: *mut ir.Value) bool {
    if (c.op != ir.OP_MEMCPY) or not ir.is_cint(c.c) {
        return false;
    }
    let d = c.a;
    let s = c.b;
    if (d.kind != ir.V_INST) or (d.op != ir.OP_ALLOCA) or (s.kind != ir.V_INST) or (s.op != ir.OP_ALLOCA) or (d == s) or
       (ir.cint_val(c.c) != ir.aty_of(s).size) or (ir.aty_of(s).size > ir.aty_of(d).size) {
        return false;
    }
    let od = obj_of(d);
    let os = obj_of(s);
    if os.escaped {
        return false;  // (D's address may go anywhere, from below the copy)
    }
    let lists: [3]*u.List.[*mut ir.Value] = [&od.readers, &od.writers, &od.escapers];
    for l in lists {
        for k in 0..l.len {
            let x = l.get(k);
            if (x != c) and not dominates(c, x) {
                return false;
            }
        }
    }
    // (the copy itself included: in a loop it reads S again, which must
    // then still hold what it held, not what D became)
    let slists: [2]*u.List.[*mut ir.Value] = [&os.readers, &os.writers];
    for l in slists {
        for k in 0..l.len {
            l.get(k).flag = 79;
        }
    }
    c.flag = 79;
    let ok = not reaches_marked(c);
    for l in slists {
        for k in 0..l.len {
            l.get(k).flag = 0;
        }
    }
    c.flag = 0;
    return ok;
}

// Slot s takes the place of d: s keeps its life (C's: ir.life_of) only if
// d's is the same.
fn same_life(s: *mut ir.Value, d: *mut ir.Value) void {
    if ir.is_op(s, ir.OP_ALLOCA) and (ir.life_of(s) != ir.life_of(d)) {
        ir.set_life(s, 0);
    }
}

/// Removes copies of aggregates into stack slots that are only read; true
/// if it removed any.
pub fn forward_copies(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    let mut any = false;
    for round in @as(i32, 0)..4 {
        _ = round;
        opt.compute_preds(f);
        let order = opt.dominators(f);
        order.deinit();
        number(f);
        scan(f);
        let mut done = u.List.[*mut ir.Value].empty();
        // and pairs for the local rules: (copy, the copy or fill before it)
        // or (copy into the result, the call that made it)
        let mut pairs = u.List.[*mut ir.Value].empty();
        let mut renames = u.List.[*mut ir.Value].empty();
        let mut moves = u.List.[*mut ir.Value].empty();
        let mut b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                if i.op == ir.OP_MEMCPY {
                    if removable(i) {
                        done.push(i);
                    } else if renamable(i) {
                        renames.push(i);
                    } else {
                        let mut c1 = copy_of_copy(i, &mut moves);
                        if u.isnil(c1) {
                            c1 = copy_of_fill(i);
                        }
                        let k = result_into_result(f, i);
                        if u.notnil(c1) {
                            pairs.push(i);
                            pairs.push(c1);
                        } else if u.notnil(k) {
                            pairs.push(i);
                            pairs.push(k);
                        }
                    }
                }
                i = i.next;
            }
            b = b.next;
        }
        clear();
        let mut changed = false;
        // the local rules when nothing else is left (each pair's
        // instructions untouched by another this round)
        if done.len == 0 {
            let mut touched = u.List.[*mut ir.Value].empty();
            let mut k: usize = 0;
            while k < pairs.len {
                let c = pairs.get(k);
                let x = pairs.get(k + 1);
                k += 2;
                if (c.flag == 77) or (x.flag == 77) {
                    continue;
                }
                if x.op == ir.OP_MEMCPY {
                    ir.set_b(c, x.b);  // copy the source itself; the first copy is dead
                    for m in moves.items() {
                        if m == c {
                            c.op = ir.OP_MEMMOVE;  // (it may overlap)
                        }
                    }
                    ir.remove_inst(x);
                } else if x.op == ir.OP_MEMSET {
                    c.op = ir.OP_MEMSET;  // fill the destination itself; the first fill is dead
                    ir.set_b(c, x.b);
                    ir.remove_inst(x);
                } else {
                    ir.set_x(x, 0, c.a);  // the call writes the result; no copy
                    ir.remove_inst(c);
                }
                c.flag = 77;
                x.flag = 77;
                touched.push(c);
                touched.push(x);
                changed = true;
            }
            for t in touched.items() {
                t.flag = 0;
            }
            touched.deinit();
        }
        pairs.deinit();
        moves.deinit();
        // renames when nothing else is left, one per slot a round (each
        // slot's uses were found before any)
        if (done.len == 0) and not changed {
            let mut touched = u.List.[*mut ir.Value].empty();
            for c in renames.items() {
                let d = c.a;
                let s = c.b;
                if (d.flag == 77) or (s.flag == 77) {
                    continue;
                }
                ir.set_aty(s, ir.aty_of(d));
                s.align = @max(s.align, d.align);
                ir.remove_inst(c);
                same_life(s, d);
                ir.forward(d, s);
                d.flag = 77;
                s.flag = 77;
                touched.push(d);
                touched.push(s);
                changed = true;
            }
            for t in touched.items() {
                t.flag = 0;
            }
            touched.deinit();
        }
        renames.deinit();
        for k in 0..done.len {
            let c = done.get(k);
            let d = c.a;
            let s = source_for_uses(f, c);
            if u.isnil(s) {
                continue;
            }
            ir.remove_inst(c);
            same_life(ir.ptr_base(s), d);
            ir.forward(d, s);
            changed = true;
        }
        done.deinit();
        if not changed {
            break;
        }
        fold_offsets(f);
        any = true;
    }
    return any;
}

// -----------------------------------------------------------------------------
// Building a slot's contents where they are copied to (forward_into).
//
// A slot T filled and then copied whole into D, `memcpy(D, T, n)` (or a
// memmove: T is apart from D), as C's `t` built and then `*r = t;` or a
// result built in a local: T's accesses can be D's, and the copy go, when
//   1. T's address goes nowhere: it is only loaded from and stored to (not
//      volatile or atomic accesses), copied from or into, filled, offset;
//   2. T is fresh at K, the region's entry: the function's entry, or the
//      entry of a callee inlined there whose local T is (an object of each
//      call's own, whose contents before the callee writes them are
//      indeterminate: what D holds is as good). Every path from K reaches
//      the copy C or ends the program (an unreachable block: a trap), and
//      none comes back to K;
//   3. no use of T is on a path from C: T is dead after it;
//   4. D is defined before K (a parameter, a global, a stack slot, or the
//      caller's value at the inlined call), and C copies the whole of T;
//   5. no instruction in S, those on a path from K to C, other than T's
//      accesses, reads or writes D's object: each other memory access is
//      to an object known apart from D's (a different global or slot; a
//      slot of this function and a parameter, which cannot point into it;
//      the result's memory, ir.EXT_SRET: the caller's fresh slot, and any
//      other object), and S has no call, no intrinsic but pure ones, no
//      atomic access and no fence. Then the program reads and writes D only
//      through T's accesses until C, and from C on as before;
//   6. other threads: D's bytes now change before C. Another thread that
//      sees them change without a data race would have to synchronize with
//      S, which it cannot (5); a racing read may see them, which Axiom
//      defines (spec §12.8.2: it returns what some store wrote) and C does
//      not (C11 5.1.2.4p25), and if C is never reached (a loop in S running
//      forever), there is no race with C's write in the original. So D is
//      a thread's own (the result's memory, or a slot whose address goes
//      nowhere), or the code is C's (ir.Func.c_races) and either S has no
//      loop or every loop in the code ends (ir.Func.c_progress, C11
//      6.8.5p6: S does no I/O, no volatile or atomic access, no
//      synchronization).
// D's accesses then have the alignment that is known of D, if less than
// T's.
// -----------------------------------------------------------------------------

fn key(p: *ir.Value) u64 {
    return @as(u64, @int_from_ptr(p));
}

fn bkey(b: *ir.Block) u64 {
    return @as(u64, @int_from_ptr(b));
}

// The object address p is in (through ptradds): an alloca, a parameter or a
// global; nil when it is none of these.
fn root_of(p0: *mut ir.Value) *mut ir.Value {
    let mut p = ir.resolve(p0);
    while ir.is_op(p, ir.OP_PTRADD) {
        p = ir.resolve(p.a);
    }
    if u.notnil(p) and (ir.is_op(p, ir.OP_ALLOCA) or (p.kind == ir.V_PARAM) or (p.kind == ir.V_GLOBAL)) {
        return p;
    }
    return u.nil.[ir.Value]();
}

// Is parameter p the result's memory (the caller's fresh slot)?
fn sret_param(p: *ir.Value) bool {
    if p.kind != ir.V_PARAM {
        return false;
    }
    let f = ir.fnp_of(p);
    let k = @truncate(usize, p.cv);
    return (k < f.param_ext.len) and ((f.param_ext[k] == ir.EXT_SRET) or (f.param_ext[k] == ir.EXT_X8SRET));
}

// Are accesses through an address in object r apart from D's object rd (5)?
fn apart_from(r: *mut ir.Value, rd: *mut ir.Value) bool {
    if u.isnil(r) or u.isnil(rd) or (r == rd) {
        return false;
    }
    if ir.objects_apart(r, rd) or sret_param(rd) or sret_param(r) {
        return true;
    }
    let ra = ir.is_op(r, ir.OP_ALLOCA);
    let da = ir.is_op(rd, ir.OP_ALLOCA);
    return (ra and (rd.kind == ir.V_PARAM)) or (da and (r.kind == ir.V_PARAM));
}

// Does the address of slot s go nowhere in f (only loads, stores to it,
// copies, fills and offsets)?
fn slot_private(f: *mut ir.Func, s: *mut ir.Value) bool {
    let mut der = u.U64Map.empty();
    der.put(key(s), 1);
    let mut ok = true;
    let mut grew = true;
    while grew and ok {
        grew = false;
        let mut b = f.first;
        while u.notnil(b) and ok {
            let mut i = b.first;
            while u.notnil(i) {
                let h = access_kind(i, &mut der);
                if h == 2 {
                    if der.get(key(i)) == 0 {
                        der.put(key(i), 1);
                        grew = true;
                    }
                } else if h < 0 {
                    ok = false;
                    break;
                }
                i = i.next;
            }
            b = b.next;
        }
    }
    der.deinit();
    return ok;
}

fn in_set(m: *mut u.U64Map, v: *mut ir.Value) bool {
    return u.notnil(v) and (m.get(key(ir.resolve(v))) != 0);
}

// How instruction i uses the addresses in der (the slot and its offsets): 0
// not at all, 1 an access of the slot (a load, store, copy, fill), 2 an
// offset of it (i is in the slot too), -1 otherwise (its address escapes, or
// the access is volatile or atomic).
fn access_kind(i: *mut ir.Value, der: *mut u.U64Map) i32 {
    let a = in_set(der, i.a);
    let b = in_set(der, i.b);
    let c = in_set(der, i.c);
    let mut x = false;
    for k in 0..i.xs.len {
        if in_set(der, i.xs.get(k)) {
            x = true;
        }
    }
    if not a and not b and not c and not x {
        return 0;
    }
    if x or c {
        return -1;
    }
    let op = i.op;
    let plain = i.flags == 0;
    if (op == ir.OP_LOAD) and plain {
        return 1;
    }
    if (op == ir.OP_STORE) and plain and not a {
        return 1;
    }
    if ((op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE)) and plain {
        return 1;
    }
    if (op == ir.OP_MEMSET) and plain and not b {
        return 1;
    }
    if (op == ir.OP_PTRADD) and not b {
        return 2;
    }
    return -1;
}

// What forward_into knows of a region: its blocks (all of f's when whole).
struct Region {
    f: *mut ir.Func,
    code: *mut ir.Func,  // whose code the region's is (f's, or the inlined function's)
    k: *mut ir.Block,
    whole: bool,
    blocks: *mut u.U64Map,
    outs: *u.List.[*mut ir.Value],  // values used outside the region (an inlined function's results)
}

fn in_region(r: *Region, b: *mut ir.Block) bool {
    return r.whole or (r.blocks.get(bkey(b)) != 0);
}

// Builds slot t's contents in its whole copy's destination where 1-6 above
// hold; true if it did.
fn forward_slot(r: *Region, t: *mut ir.Value, bl: *u.List.[*mut ir.Block]) bool {
    let size = ir.aty_of(t).size;
    // T and its offsets (der), and its one whole copy out (c)
    let mut der = u.U64Map.empty();
    der.put(key(t), 1);
    let mut uses = u.U64Map.empty();
    let mut c = u.nil.[ir.Value]();
    let mut ok = true;
    let mut grew = true;
    while grew and ok {
        grew = false;
        c = u.nil.[ir.Value]();
        for b in bl.items() {
            let mut i = b.first;
            while u.notnil(i) {
                let h = access_kind(i, &mut der);
                if h < 0 {
                    ok = false;
                    break;
                }
                if (h == 2) and (der.get(key(i)) == 0) {
                    der.put(key(i), 1);
                    grew = true;
                }
                if h == 1 {
                    uses.put(key(i), 1);
                    let whole_out = ((i.op == ir.OP_MEMCPY) or (i.op == ir.OP_MEMMOVE)) and (ir.resolve(i.b) == t) and
                                    not in_set(&mut der, i.a) and ir.is_cint(i.c) and (ir.cint_val(i.c) == size);
                    if whole_out {
                        if u.notnil(c) {
                            ok = false;  // (two: neither is the last use)
                        }
                        c = i;
                    }
                }
                i = i.next;
            }
            if not ok {
                break;
            }
        }
    }
    // (1: T's address goes nowhere outside the region either)
    for x in r.outs.items() {
        if in_set(&mut der, x) {
            ok = false;
        }
    }
    let mut done = false;
    if ok and u.notnil(c) {
        done = forward_to(r, t, c, &mut der, &mut uses);
    }
    der.deinit();
    uses.deinit();
    return done;
}

fn forward_to(r: *Region, t: *mut ir.Value, c: *mut ir.Value, der: *mut u.U64Map, uses: *mut u.U64Map) bool {
    let d = ir.resolve(c.a);
    // 4: D is there at K
    let mut before = (d.kind == ir.V_PARAM) or (d.kind == ir.V_GLOBAL) or ir.is_op(d, ir.OP_ALLOCA);
    if not before and not r.whole and (d.kind == ir.V_INST) and u.notnil(d.blk) and not in_region(r, d.blk) {
        before = true;
    }
    if not before {
        return false;
    }
    let rd = root_of(d);
    if u.isnil(rd) {
        return false;
    }
    let cb = c.blk;
    // 2 and 5: the blocks on paths from K to C (s), each instruction checked
    let mut s = u.U64Map.empty();
    let mut work = u.List.[*mut ir.Block].empty();
    let mut sl = u.List.[*mut ir.Block].empty();
    let mut ok = true;
    work.push(r.k);
    s.put(bkey(r.k), 1);
    while (work.len > 0) and ok {
        let b = work.pop();
        sl.push(b);
        let mut i = b.first;
        while u.notnil(i) and (i != c) {
            if (uses.get(key(i)) == 0) and not other_ok(i, rd) {
                ok = false;
                break;
            }
            if (uses.get(key(i)) != 0) and not memop_ok(i, rd, der) {
                ok = false;  // (a copy between T and D's object: would be within D)
                break;
            }
            i = i.next;
        }
        if b == cb {
            continue;  // (C ends the path)
        }
        let tm = ir.terminator(b);
        if u.isnil(tm) or (tm.op == ir.OP_RET) {
            ok = false;  // (a way out without C)
            break;
        }
        for k in 0..ir.succ_count(tm) {
            let n = ir.succ(tm, k);
            if (n == r.k) or not in_region(r, n) {
                ok = false;  // (back to K, or out without C)
                break;
            }
            if s.get(bkey(n)) == 0 {
                s.put(bkey(n), 1);
                work.push(n);
            }
        }
    }
    // 3: no use of T on a path from C
    if ok {
        ok = dead_after(r, c, uses);
    }
    // 6: D another thread may see
    if ok and not (sret_param(rd) or (ir.is_op(rd, ir.OP_ALLOCA) and slot_private(r.f, rd))) {
        ok = r.code.c_races and (r.code.c_progress or not has_cycle(&sl, &mut s, cb));
    }
    s.deinit();
    work.deinit();
    sl.deinit();
    if not ok {
        return false;
    }
    // T's accesses are D's, with the alignment known of D
    let mut al: u32 = 1;
    if rd.kind == ir.V_GLOBAL {
        al = @int_cast(u32, ir.gv_of(rd).align);
    } else if ir.is_op(rd, ir.OP_ALLOCA) {
        al = rd.align;
    }
    if rd != d {
        al = 1;  // (an offset into it)
    }
    let mut b = r.f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if (uses.get(key(i)) != 0) and ((i.op == ir.OP_LOAD) or (i.op == ir.OP_STORE)) and (i.align > al) {
                i.align = al;
            }
            i = i.next;
        }
        b = b.next;
    }
    ir.remove_inst(c);
    ir.replace_uses(r.f, t, d);
    return true;
}

// May instruction i (not an access of T) be among those between K and C,
// D's object rd (5)?
fn other_ok(i: *mut ir.Value, rd: *mut ir.Value) bool {
    let op = i.op;
    if op == ir.OP_CALL {
        // (but a trap, which ends the program: what is seen of its memory
        // after that is not the program's)
        let g = ir.direct_callee(i);
        return u.notnil(g) and u.str_eq(g.name, "axiom.trap");
    }
    if (op == ir.OP_FENCE) or (op == ir.OP_RMW) or (op == ir.OP_CMPXCHG) {
        return false;
    }
    if op == ir.OP_INTR {
        return ir.inst_pure(i) or ir.is_rscope(i);  // (C's scopes access no memory)
    }
    if op == ir.OP_LOAD {
        return ((i.flags & ir.F_ATOMIC) == 0) and apart_from(root_of(i.a), rd);
    }
    if op == ir.OP_STORE {
        return ((i.flags & ir.F_ATOMIC) == 0) and apart_from(root_of(i.b), rd);
    }
    if (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE) {
        return apart_from(root_of(i.a), rd) and apart_from(root_of(i.b), rd);
    }
    if op == ir.OP_MEMSET {
        return apart_from(root_of(i.a), rd);
    }
    return not ir.op_accesses_mem(op);
}

// An access of T (i) whose other operand, a copy's, is in T too or apart from
// D's object rd (5).
fn memop_ok(i: *mut ir.Value, rd: *mut ir.Value, der: *mut u.U64Map) bool {
    if (i.op != ir.OP_MEMCPY) and (i.op != ir.OP_MEMMOVE) {
        return true;
    }
    let a = in_set(der, i.a) or apart_from(root_of(i.a), rd);
    let b = in_set(der, i.b) or apart_from(root_of(i.b), rd);
    return a and b;
}

// Is no use of T (uses) on a path from C (before the region's end)?
fn dead_after(r: *Region, c: *mut ir.Value, uses: *mut u.U64Map) bool {
    let mut i = c.next;
    while u.notnil(i) {
        if uses.get(key(i)) != 0 {
            return false;
        }
        i = i.next;
    }
    let mut seen = u.U64Map.empty();
    let mut work = u.List.[*mut ir.Block].empty();
    let mut ok = true;
    let t0 = ir.terminator(c.blk);
    for k in 0..ir.succ_count(t0) {
        work.push(ir.succ(t0, k));
    }
    while (work.len > 0) and ok {
        let b = work.pop();
        if not in_region(r, b) or (seen.get(bkey(b)) != 0) {
            continue;
        }
        seen.put(bkey(b), 1);
        if b == r.k {
            ok = false;
            break;
        }
        let mut j = b.first;
        while u.notnil(j) {
            if uses.get(key(j)) != 0 {
                ok = false;
                break;
            }
            j = j.next;
        }
        let tm = ir.terminator(b);
        for k in 0..ir.succ_count(tm) {
            work.push(ir.succ(tm, k));
        }
    }
    seen.deinit();
    work.deinit();
    return ok;
}

// Do the blocks of S (sl, in s; C's block cb ends its paths) form a loop?
fn has_cycle(sl: *u.List.[*mut ir.Block], s: *mut u.U64Map, cb: *mut ir.Block) bool {
    // (Kahn's algorithm: S is acyclic iff every block can be taken once its
    // predecessors in S are)
    let mut indeg = u.U64Map.empty();
    for b in sl.items() {
        if b == cb {
            continue;
        }
        let tm = ir.terminator(b);
        for k in 0..ir.succ_count(tm) {
            let n = ir.succ(tm, k);
            if s.get(bkey(n)) != 0 {
                indeg.put(bkey(n), indeg.get(bkey(n)) + 1);
            }
        }
    }
    let mut work = u.List.[*mut ir.Block].empty();
    for b in sl.items() {
        if indeg.get(bkey(b)) == 0 {
            work.push(b);
        }
    }
    let mut taken: usize = 0;
    while work.len > 0 {
        let b = work.pop();
        taken += 1;
        if b == cb {
            continue;
        }
        let tm = ir.terminator(b);
        for k in 0..ir.succ_count(tm) {
            let n = ir.succ(tm, k);
            if s.get(bkey(n)) != 0 {
                let m = indeg.get(bkey(n)) - 1;
                indeg.put(bkey(n), m);
                if m == 0 {
                    work.push(n);
                }
            }
        }
    }
    indeg.deinit();
    let n = sl.len;
    work.deinit();
    return taken != n;
}

/// forward_into over the slots of g, inlined into f at a call: allocas, the
/// clones of its allocas; blocks, the clones of its blocks, of which k is
/// the entry; outs, the values it returns (used outside the blocks). True if any slot's contents were built where they are copied.
pub fn forward_inlined(f: *mut ir.Func, g: *mut ir.Func, k: *mut ir.Block, blocks: *u.List.[*mut ir.Block],
                       allocas: *u.List.[*mut ir.Value], outs: *u.List.[*mut ir.Value]) bool {
    let mut m = u.U64Map.empty();
    for b in blocks.items() {
        m.put(bkey(b), 1);
    }
    let r = Region.{ f: f, code: g, k: k, whole: false, blocks: &mut m, outs: outs };
    let mut any = false;
    for t in allocas.items() {
        if forward_slot(&r, t, blocks) {
            any = true;
        }
    }
    m.deinit();
    return any;
}

/// forward_into over the slots of f, from its entry. True if any slot's
/// contents were built where they are copied.
pub fn forward_into(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    // the candidates: slots copied whole into something else
    let mut ts = u.List.[*mut ir.Value].empty();
    let mut bl = u.List.[*mut ir.Block].empty();
    let mut b = f.first;
    while u.notnil(b) {
        bl.push(b);
        let mut i = b.first;
        while u.notnil(i) {
            if ((i.op == ir.OP_MEMCPY) or (i.op == ir.OP_MEMMOVE)) and whole(i, ir.resolve(i.b)) {
                let t = ir.resolve(i.b);
                let mut dup = false;
                for x in ts.items() {
                    if x == t {
                        dup = true;
                    }
                }
                if not dup {
                    ts.push(t);
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    let mut m = u.U64Map.empty();
    let none = u.List.[*mut ir.Value].empty();
    let r = Region.{ f: f, code: f, k: f.first, whole: true, blocks: &mut m, outs: &none };
    let mut any = false;
    for t in ts.items() {
        if forward_slot(&r, t, &bl) {
            any = true;
        }
    }
    m.deinit();
    ts.deinit();
    bl.deinit();
    return any;
}
