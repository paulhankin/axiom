// =============================================================================
// copies.ax - removes copies of aggregates that are only read.
//
// Lowering (lower.ax) gives every aggregate value memory of its own: reading
// a struct from a variable, a field or through a pointer copies it into a
// fresh stack slot, since the source may change later; a `let` copies it
// again into the variable; passing it on passes the slot's address. So a
// 200-byte struct read, bound and passed on is copied two or three times,
// and inlining strings such copies together.
//
// A copy `memcpy(D, P, n)` into a stack slot D of n bytes is not needed when
//   - it is the only write to D, and everything else only reads D (loads,
//     copies from it, passing it by value: lowering marks those arguments
//     ir.EXT_BYVAL, and the callee cannot write them), after the copy (the
//     copy dominates every read);
//   - P does not change while D is read: P is (inside) a constant global, a
//     parameter passed by value, or a stack slot whose address goes nowhere
//     else and whose every write comes before the copy (dominates it). Then
//     no write to P can come between the copy and a read of D: the read
//     would be reachable from that write without passing the copy, so from
//     the function's entry too, and the copy would not dominate it.
// D's readers then read P instead, and the copy goes. A chain of copies
// collapses in a round: each link's source only gains readers.
//
// Also (renamable): a whole slot S copied into a slot D that is not used
// before, S not used after: D is S. And (split_copies, after scalar
// replacement): a copy or vector load out of a slot filled piece by piece
// is split at the pieces, each part taken from where it was written (a
// stored value, a fill, a copy's unchanged source), since a processor cannot
// forward several narrow stores to one wide load; then the writes of bytes
// nothing reads go (unread_writes).
// =============================================================================
import "ir.ax" as ir;
import "opt.ax" as opt;
import "util.ax" as u;

// What is known about an object whose address is used: its writes and
// reads, and whether its address goes anywhere we cannot follow.
struct Obj {
    writers: u.List.[*mut ir.Value],
    readers: u.List.[*mut ir.Value],
    escapers: u.List.[*mut ir.Value],  // where the address escapes (not for parameters)
    escaped: bool,
    readonly: bool,  // a constant global or a by-value parameter: never written
}

// (Obj records are reused: objs[0..nobjs] are in use.)
let mut objs: u.List.[*mut Obj] = u.List.[*mut Obj].{ data: @ptr_from_int(*mut *mut Obj, 0), len: 0, cap: 0 };
let mut nobjs: usize = 0;
let mut marked: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0,
                                                                  cap: 0 };
// (made when first used; never written: what a global is does not change)
let mut const_global: *mut Obj = @ptr_from_int(*mut Obj, 0);
let mut other_global: *mut Obj = @ptr_from_int(*mut Obj, 0);

// The object an address points into: an alloca, a parameter or a global,
// through constant or variable offsets (nil when it is none of those).
fn root(p: *mut ir.Value) *mut ir.Value {
    let r = ir.ptr_base(p);
    if u.notnil(r) and (ir.is_op(r, ir.OP_ALLOCA) or (r.kind == ir.V_PARAM) or (r.kind == ir.V_GLOBAL)) {
        return r;
    }
    return u.nil.[ir.Value]();
}

// (Allocas and parameters are numbered in aux2 while a round runs.)
fn obj_of(r: *mut ir.Value) *mut Obj {
    if r.kind == ir.V_GLOBAL {
        if u.isnil(const_global) {
            const_global = u.new.[Obj]();
            const_global.readonly = true;
            other_global = u.new.[Obj]();
            other_global.escaped = true;  // (anything may write a variable)
        }
        if ir.gv_of(r).is_const {
            return const_global;
        }
        return other_global;
    }
    if r.aux2 > 0 {
        return objs.get(@truncate(usize, @bit_cast(u64, r.aux2 - 1)));
    }
    if nobjs == objs.len {
        objs.push(u.new.[Obj]());
    }
    let o = objs.get(nobjs);
    nobjs += 1;
    o.writers.clear();
    o.readers.clear();
    o.escapers.clear();
    o.escaped = false;
    o.readonly = false;
    if r.kind == ir.V_PARAM {
        let f = ir.fnp_of(r);
        let k = @truncate(usize, r.cv);
        o.readonly = (k < f.param_ext.len) and (f.param_ext[k] == ir.EXT_BYVAL);
        o.escaped = not o.readonly;
    }
    marked.push(r);
    r.aux2 = @bit_cast(i64, @as(u64, nobjs));
    return o;
}

// How an instruction uses an address.
const READ: i32 = 0;
const WRITE: i32 = 1;
const ESCAPE: i32 = 2;

fn note(i: *mut ir.Value, p: *mut ir.Value, how: i32) void {
    if u.isnil(p) or (p.ty.kind != ir.T_PTR) {
        return;
    }
    let r = root(p);
    if u.isnil(r) {
        return;
    }
    let o = obj_of(r);
    if r.kind == ir.V_GLOBAL {
        return;  // (no lists for globals: what they are does not change)
    }
    if how == READ {
        o.readers.push(i);
    } else if how == WRITE {
        o.writers.push(i);
    } else {
        o.escaped = true;
        o.escapers.push(i);
    }
}

fn scan(f: *mut ir.Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let op = i.op;
            if op == ir.OP_LOAD {
                note(i, i.a, READ);
            } else if op == ir.OP_STORE {
                note(i, i.a, ESCAPE);  // (an address stored somewhere)
                note(i, i.b, WRITE);
            } else if (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE) {
                note(i, i.a, WRITE);
                note(i, i.b, READ);
            } else if op == ir.OP_MEMSET {
                note(i, i.a, WRITE);
            } else if op == ir.OP_CALL {
                note(i, i.a, ESCAPE);
                for k in 0..i.xs.len {
                    let mut e: u8 = 0;
                    if (k + 1) < ir.ext_of(i).len {
                        e = ir.ext_of(i)[k + 1];
                    }
                    if e == ir.EXT_BYVAL {
                        note(i, i.xs.get(k), READ);
                    } else if e == ir.EXT_SRET {
                        note(i, i.xs.get(k), WRITE);
                    } else {
                        note(i, i.xs.get(k), ESCAPE);
                    }
                }
            } else if (op != ir.OP_ALLOCA) and (op != ir.OP_PTRADD) {
                // (an offset address: what is done with it is noted)
                note(i, i.a, ESCAPE);
                note(i, i.b, ESCAPE);
                note(i, i.c, ESCAPE);
                for k in 0..i.xs.len {
                    note(i, i.xs.get(k), ESCAPE);
                }
            }
            i = i.next;
        }
        b = b.next;
    }
}

// Numbers instructions in their blocks, for dominance within a block (and
// clears the marks obj_of leaves in aux2, which other passes use too).
fn number(f: *mut ir.Func) void {
    for k in 0..f.params.len {
        f.params[k].aux2 = 0;
    }
    let mut b = f.first;
    while u.notnil(b) {
        let mut n: i32 = 0;
        let mut i = b.first;
        while u.notnil(i) {
            i.pos = n;
            i.aux2 = 0;
            n += 1;
            i = i.next;
        }
        b = b.next;
    }
}

// Does instruction a run before b on every path to b?
fn dominates(a: *mut ir.Value, b: *mut ir.Value) bool {
    if a.blk == b.blk {
        return a.pos < b.pos;
    }
    if (a.blk.rpo < 0) or (b.blk.rpo < 0) {
        return false;  // (unreachable)
    }
    return opt.dominates(a.blk, b.blk);
}

// Can copy c into slot D go: D only written by c and read after it, its
// source unchanged while D is read?
fn removable(c: *mut ir.Value) bool {
    let d = c.a;
    if (d.kind != ir.V_INST) or (d.op != ir.OP_ALLOCA) or not ir.is_cint(c.c) or
       (ir.cint_val(c.c) != ir.aty_of(d).size) {
        return false;
    }
    let od = obj_of(d);
    if od.escaped or (od.writers.len != 1) or (od.writers.get(0) != c) {
        return false;
    }
    let r = root(c.b);
    if u.isnil(r) or (r == d) {
        return false;
    }
    let os = obj_of(r);
    if os.escaped {
        return false;
    }
    if not os.readonly {
        for k in 0..os.writers.len {
            if not dominates(os.writers.get(k), c) {
                return false;
            }
        }
    }
    for k in 0..od.readers.len {
        if not dominates(c, od.readers.get(k)) {
            return false;
        }
    }
    return true;
}

// The source address of copy c where every use of D sees it: c's operand
// when it is an alloca, a parameter or a global; else its constant offset
// from that, computed after the allocas at the start of the function (nil
// when the offset is not constant). Copies removed earlier in the round are
// seen through (resolve).
fn source_for_uses(f: *mut ir.Func, c: *mut ir.Value) *mut ir.Value {
    let mut p = ir.resolve(c.b);
    let mut off: u64 = 0;
    while ir.is_op(p, ir.OP_PTRADD) {
        if not ir.is_cint(p.b) {
            return u.nil.[ir.Value]();
        }
        off +%= ir.cint_val(p.b);
        p = ir.resolve(p.a);
    }
    if off == 0 {
        return p;
    }
    let x = ir.new_inst(f, ir.OP_PTRADD, ir.t_ptr());
    x.a = p;
    x.b = ir.cint(ir.isz(), off);
    x.src = c.src;
    let mut at = f.first.first;
    while u.notnil(at) and (at.op == ir.OP_ALLOCA) {
        at = at.next;
    }
    if u.isnil(at) {
        ir.append_inst(f.first, x);
    } else {
        ir.insert_before(at, x);
    }
    return x;
}

// Folds offsets of offsets (ptradd(ptradd(p, a), b) is ptradd(p, a + b)):
// an address made by source_for_uses may have been based on a slot
// forwarded later in the round, to an address made after it.
fn fold_offsets(f: *mut ir.Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if (i.op == ir.OP_PTRADD) and ir.is_cint(i.b) {
                while ir.is_op(i.a, ir.OP_PTRADD) and ir.is_cint(i.a.b) {
                    i.b = ir.cint(ir.isz(), ir.cint_val(i.b) +% ir.cint_val(i.a.b));
                    i.a = i.a.a;
                }
            }
            i = i.next;
        }
        b = b.next;
    }
}

// Might instruction i write memory (or run code that does)? Every intrinsic
// counts, even a pure one. A fence does not: these passes read a source
// later than the program did, and a read after the fence can see another
// thread's store that it could not have seen before it only if this thread
// published something in between (spec §12.8.2), which takes a write.
fn writes_memory(i: *ir.Value) bool {
    let op = i.op;
    return (ir.op_writes_mem(op) and (op != ir.OP_FENCE)) or (op == ir.OP_INTR);
}

fn whole(c: *ir.Value, d: *ir.Value) bool {
    return ir.is_op(d, ir.OP_ALLOCA) and ir.is_cint(c.c) and (ir.cint_val(c.c) == ir.aty_of(d).size);
}

// A copy of a copy: c2 copies slot D1, which c1 filled from S just before
// (in the same block, with nothing between them that writes memory), and
// nothing else reads D1. c2 can copy S itself (then c1 is dead), even when S
// may change later: it has not changed yet. Two different objects may still
// be one (two pointer parameters, a parameter and a global): unless S and
// c2's destination are known apart, c2 is put in moves, to become a memmove.
fn copy_of_copy(c2: *mut ir.Value, moves: *mut u.List.[*mut ir.Value]) *mut ir.Value {
    let d1 = c2.b;
    if not whole(c2, d1) {
        return u.nil.[ir.Value]();
    }
    let o = obj_of(d1);
    if o.escaped or (o.writers.len != 1) or (o.readers.len != 1) {
        return u.nil.[ir.Value]();
    }
    let c1 = o.writers.get(0);
    if (c1.op != ir.OP_MEMCPY) or (c1.a != d1) or not whole(c1, d1) or (c1.blk != c2.blk) or (c1.pos >= c2.pos) {
        return u.nil.[ir.Value]();
    }
    let rs = root(c1.b);
    if u.isnil(rs) or (rs == root(c2.a)) {
        return u.nil.[ir.Value]();  // (the copy must not overlap)
    }
    let mut i = c1.next;
    while i != c2 {
        if writes_memory(i) {
            return u.nil.[ir.Value]();
        }
        i = i.next;
    }
    if not apart(rs, root(c2.a)) {
        moves.push(c2);
    }
    return c1;
}

// A copy of a fill: c2 copies slot D1, which only c1 wrote, filling the
// whole of it with one byte (memset) before it in the same block, and
// nothing else reads D1. c2 can fill its destination itself (then c1 is
// dead): a zeroed struct returned and bound copies 0 into the variable.
fn copy_of_fill(c2: *mut ir.Value) *mut ir.Value {
    let d1 = c2.b;
    if not whole(c2, d1) {
        return u.nil.[ir.Value]();
    }
    let o = obj_of(d1);
    if o.escaped or (o.writers.len != 1) or (o.readers.len != 1) {
        return u.nil.[ir.Value]();
    }
    let c1 = o.writers.get(0);
    if (c1.op != ir.OP_MEMSET) or (c1.a != d1) or not whole(c1, d1) or (c1.blk != c2.blk) or (c1.pos >= c2.pos) {
        return u.nil.[ir.Value]();
    }
    return c1;
}

// The result of a call copied into this function's own result: the call
// can write it there itself. The result's memory (the sret parameter) is
// the caller's fresh slot, which nothing else here reads or writes, so it
// only must not be used between the call and the copy.
fn result_into_result(f: *mut ir.Func, c: *mut ir.Value) *mut ir.Value {
    if (f.params.len == 0) or (c.a != f.params[0]) or (f.param_ext.len == 0) or (f.param_ext[0] != ir.EXT_SRET) or
       not whole(c, c.b) {
        return u.nil.[ir.Value]();
    }
    let d = c.b;
    let o = obj_of(d);
    if o.escaped or (o.writers.len != 1) or (o.readers.len != 1) {
        return u.nil.[ir.Value]();
    }
    let k = o.writers.get(0);
    if (k.op != ir.OP_CALL) or (k.blk != c.blk) or (k.pos >= c.pos) or (k.xs.len == 0) or (k.xs.get(0) != d) {
        return u.nil.[ir.Value]();
    }
    for j in 0..k.xs.len {
        if (k.xs.get(j).ty.kind == ir.T_PTR) and (root(k.xs.get(j)) == c.a) {
            return u.nil.[ir.Value]();
        }
    }
    let mut i = k.next;
    while i != c {
        if uses_address(i, c.a) {
            return u.nil.[ir.Value]();
        }
        i = i.next;
    }
    return k;
}

fn uses_address(i: *ir.Value, p: *mut ir.Value) bool {
    let ops: [3]*mut ir.Value = [i.a, i.b, i.c];
    for o in ops {
        if u.notnil(o) and (o.ty.kind == ir.T_PTR) and (root(o) == p) {
            return true;
        }
    }
    for k in 0..i.xs.len {
        let o = i.xs.get(k);
        if (o.ty.kind == ir.T_PTR) and (root(o) == p) {
            return true;
        }
    }
    return false;
}

// The constant offset of address p from its root (false if it has none).
fn const_off(p0: *mut ir.Value, off: *mut i64) bool {
    let mut p = p0;
    let mut o: i64 = 0;
    while ir.is_op(p, ir.OP_PTRADD) {
        if not ir.is_cint(p.b) {
            return false;
        }
        o +%= ir.sval(p.b);
        p = p.a;
    }
    off.* = o;
    return true;
}

// The bytes [lo, hi) of its slot that writer w writes (false if they are
// not constant).
fn written(w: *mut ir.Value, lo: *mut i64, hi: *mut i64) bool {
    let mut p = w.a;
    let mut n: i64 = 0;
    if w.op == ir.OP_STORE {
        p = w.b;
        n = @bit_cast(i64, w.a.ty.size);
    } else if (w.op == ir.OP_MEMCPY) or (w.op == ir.OP_MEMMOVE) or (w.op == ir.OP_MEMSET) {
        if not ir.is_cint(w.c) {
            return false;
        }
        n = ir.sval(w.c);
    } else {
        return false;
    }
    if not const_off(p, lo) {
        return false;
    }
    hi.* = lo.* + n;
    return true;
}

// Does the source of copy w (into a slot) hold the same bytes when copy c
// below it in the block runs? Only writes to other slots whose addresses go
// nowhere (which the source, read through another object, cannot be) may
// come between them.
fn source_unchanged(w: *mut ir.Value, c: *mut ir.Value) bool {
    if ((w.op != ir.OP_MEMCPY) and (w.op != ir.OP_MEMMOVE)) or (w.blk != c.blk) {
        return false;
    }
    let rs = root(w.b);
    let mut i = w.next;
    while u.notnil(i) and (i != c) {
        if writes_memory(i) {
            let op = i.op;
            let mut p = i.a;
            if op == ir.OP_STORE {
                p = i.b;
            } else if (op != ir.OP_MEMCPY) and (op != ir.OP_MEMMOVE) and (op != ir.OP_MEMSET) {
                return false;
            }
            let rd = root(p);
            if u.isnil(rd) or (rd.kind != ir.V_INST) or (rd.op != ir.OP_ALLOCA) or (rd == rs) or obj_of(rd).escaped {
                return false;
            }
        }
        i = i.next;
    }
    return i == c;
}

const MAX_PIECES: usize = 16;

// A copy out of a stack slot that was filled piece by piece (fields
// stored one at a time, halves copied in): the copy reads across the
// pieces' stores, which a processor cannot forward to one wider load (a
// stall of a dozen cycles or more). Split at the pieces' boundaries, each
// part reads what one write wrote; a part that a store wrote just before
// (in the block, nothing writing it since) stores that value instead, and
// the slot may then not be read at all. Splitting a copy is always exact:
// the slot's address goes nowhere else, so the copy cannot overlap it.
fn split_copy(c: *mut ir.Value, B: *mut ir.Builder) bool {
    if ((c.op != ir.OP_MEMCPY) and (c.op != ir.OP_MEMMOVE)) or not ir.is_cint(c.c) {
        return false;
    }
    let r = root(c.b);
    if u.isnil(r) or (r.kind != ir.V_INST) or (r.op != ir.OP_ALLOCA) or (root(c.a) == r) or (r.flag == 78) {
        return false;
    }
    let o = obj_of(r);
    let mut base: i64 = 0;
    if o.escaped or not const_off(c.b, &mut base) {
        return false;
    }
    let n = ir.sval(c.c);
    if (n <= 0) or (n > 256) {
        return false;
    }
    let mut cuts = u.List.[i64].empty();
    if not cuts_of(o, base, n, &mut cuts) {
        cuts.deinit();
        return false;
    }
    // what each part can be had from instead of the slot
    let mut froms = u.List.[*mut ir.Value].empty();
    let mut nfrom: usize = 0;
    for j in 0..(cuts.len - 1) {
        let mut x = exact_writer(o, cuts.get(j), cuts.get(j + 1), c);
        // (a part copied from elsewhere: the parts written before it must
        // not change its source, which must then be apart from the
        // destination)
        if u.notnil(x) and ((x.op == ir.OP_MEMCPY) or (x.op == ir.OP_MEMMOVE)) and not apart(root(x.b), root(c.a)) {
            x = u.nil.[ir.Value]();
        }
        if u.isnil(x) and unwritten(o, cuts.get(j), cuts.get(j + 1)) {
            x = c;  // (nothing to copy)
        }
        if u.notnil(x) {
            nfrom += 1;
        }
        froms.push(x);
    }
    let changed = (cuts.len > 2) or (nfrom > 0);
    if changed {
        ir.at_before(B, c);
        for j in 0..(cuts.len - 1) {
            let off = ir.cint(ir.isz(), @bit_cast(u64, cuts.get(j) - base));
            let size = ir.cint(ir.isz(), @bit_cast(u64, cuts.get(j + 1) - cuts.get(j)));
            let d = ir.ptradd(B, c.a, off);
            let w = froms.get(j);
            if w == c {
                // bytes nothing writes (a struct's padding): their content is
                // not defined, and the destination's will do
            } else if u.isnil(w) {
                let s = ir.ptradd(B, c.b, off);
                _ = ir.memop(B, c.op, d, s, size);
            } else if w.op == ir.OP_STORE {
                let s = ir.store(B, w.a, d);
                s.align = 1;
            } else if w.op == ir.OP_MEMSET {
                _ = ir.memop(B, ir.OP_MEMSET, d, w.b, size);
            } else {
                _ = ir.memop(B, ir.OP_MEMCPY, d, w.b, size);  // (apart)
            }
        }
        // (the copy's destination has new writers: copies out of it wait
        // for the next round)
        let rd = root(c.a);
        if u.notnil(rd) and (rd.kind == ir.V_INST) {
            rd.flag = 78;
            marked_split.push(rd);
        }
        ir.remove_inst(c);
    }
    cuts.deinit();
    froms.deinit();
    return changed;
}

// Are objects s (a copy's source) and d (its destination; nil: not known)
// known not to overlap: different, and one of them a stack slot whose
// address goes nowhere else (which nothing else can point into), or s
// never written?
fn apart(s: *mut ir.Value, d: *mut ir.Value) bool {
    if s == d {
        return false;
    }
    if u.notnil(s) and obj_of(s).readonly {
        return true;
    }
    let xs: [2]*mut ir.Value = [s, d];
    for x in xs {
        if ir.is_op(x, ir.OP_ALLOCA) and not obj_of(x).escaped {
            return true;
        }
    }
    return false;
}

// The cuts [base, ..., base + n) that the writes of slot o make in the
// bytes it reads there, sorted (false if a write's bytes are not constant
// or there are too many).
fn cuts_of(o: *mut Obj, base: i64, n: i64, cuts: *mut u.List.[i64]) bool {
    cuts.push(base);
    cuts.push(base + n);
    for k in 0..o.writers.len {
        let mut lo: i64 = 0;
        let mut hi: i64 = 0;
        if not written(o.writers.get(k), &mut lo, &mut hi) {
            return false;
        }
        let ends: [2]i64 = [lo, hi];
        for e in ends {
            if (e > base) and (e < (base + n)) {
                let mut seen = false;
                for x in cuts.items() {
                    seen = seen or (x == e);
                }
                if not seen {
                    cuts.push(e);
                }
            }
        }
    }
    if (cuts.len - 1) > MAX_PIECES {
        return false;
    }
    // (sorted: a few elements)
    for a in 1..cuts.len {
        let mut b = a;
        while (b > 0) and (cuts.get(b - 1) > cuts.get(b)) {
            let t = cuts.get(b);
            cuts.set(b, cuts.get(b - 1));
            cuts.set(b - 1, t);
            b -= 1;
        }
    }
    return true;
}

// Does no write of slot o write any of bytes [lo, hi)? (Every write's bytes
// are known.)
fn unwritten(o: *mut Obj, lo: i64, hi: i64) bool {
    for k in 0..o.writers.len {
        let mut wl: i64 = 0;
        let mut wh: i64 = 0;
        _ = written(o.writers.get(k), &mut wl, &mut wh);
        if (wh > lo) and (wl < hi) {
            return false;
        }
    }
    return true;
}

// The write of slot o that last wrote bytes [lo, hi) before x in x's block,
// when it wrote exactly those bytes and what it wrote can be had where x
// is: a store's value, a fill, or a copy's source unchanged since. Else nil.
fn exact_writer(o: *mut Obj, lo: i64, hi: i64, x: *mut ir.Value) *mut ir.Value {
    let mut last = u.nil.[ir.Value]();
    for k in 0..o.writers.len {
        let w = o.writers.get(k);
        let mut wl: i64 = 0;
        let mut wh: i64 = 0;
        _ = written(w, &mut wl, &mut wh);
        // (a write in another block cannot run between a write above x in
        // its block and x)
        if (wh > lo) and (wl < hi) and (w.blk == x.blk) and (w.pos < x.pos) and (u.isnil(last) or (last.pos < w.pos)) {
            last = w;
        }
    }
    if u.isnil(last) or (last.flags != 0) {
        return u.nil.[ir.Value]();
    }
    let mut wl: i64 = 0;
    let mut wh: i64 = 0;
    _ = written(last, &mut wl, &mut wh);
    if (wl == lo) and (wh == hi) and
       ((last.op == ir.OP_STORE) or (last.op == ir.OP_MEMSET) or
        ((root(last.b) != root(last.a)) and source_unchanged(last, x))) {
        return last;
    }
    return u.nil.[ir.Value]();
}

// A vector load from a slot filled in equal pieces of 1 to 8 bytes (two
// halves copied in, say): the load reads across the pieces' stores, which
// cannot be forwarded to it. It becomes the pieces as integer lanes, each
// taken from where its write took it (or loaded from the slot by itself).
fn split_load(l: *mut ir.Value, B: *mut ir.Builder) bool {
    if (l.op != ir.OP_LOAD) or (l.flags != 0) or (l.ty.kind != ir.T_VEC) {
        return false;
    }
    let r = root(l.a);
    if u.isnil(r) or (r.kind != ir.V_INST) or (r.op != ir.OP_ALLOCA) or (r.flag == 78) {
        return false;
    }
    let o = obj_of(r);
    let mut base: i64 = 0;
    if o.escaped or not const_off(l.a, &mut base) {
        return false;
    }
    let n = @bit_cast(i64, l.ty.size);
    let mut cuts = u.List.[i64].empty();
    let mut ok = cuts_of(o, base, n, &mut cuts) and (cuts.len > 2);
    let mut w: i64 = 0;
    if ok {
        w = cuts.get(1) - cuts.get(0);
        ok = (w <= 8) and ((w & (w - 1)) == 0);
        for j in 0..(cuts.len - 1) {
            ok = ok and ((cuts.get(j + 1) - cuts.get(j)) == w);
        }
    }
    if not ok {
        cuts.deinit();
        return false;
    }
    let lt = ir.t_int(@truncate(i32, w * 8));
    let vt = ir.t_vec(lt, @truncate(u32, @bit_cast(u64, n / w)));
    ir.at_before(B, l);
    let mut v = ir.undef(vt);
    for j in 0..(cuts.len - 1) {
        let lo = cuts.get(j);
        let x = exact_writer(o, lo, lo + w, l);
        let mut e = u.nil.[ir.Value]();
        if u.isnil(x) {
            let q = ir.load(B, lt, ir.ptradd(B, l.a, ir.cint(ir.isz(), @bit_cast(u64, lo - base))));
            q.align = 1;
            e = q;
        } else if x.op == ir.OP_STORE {
            e = x.a;
            if e.ty.kind == ir.T_PTR {
                e = ir.ptrtoint(B, e, lt);
            } else if (e.ty.kind == ir.T_INT) and (e.ty.bits < lt.bits) {
                e = ir.zext(B, e, lt);  // (a bool: a byte holding 0 or 1)
            } else if e.ty != lt {
                e = ir.bitcast(B, e, lt);
            }
        } else if x.op == ir.OP_MEMSET {
            if ir.is_cint(x.b) {
                let byte = ir.cint_val(x.b) & 0xff;
                let mut k: u64 = 0;
                for _b in 0..@bit_cast(u64, w) {
                    k = (k << 8) | byte;
                }
                e = ir.cint(lt, k);
            } else {
                let q = ir.load(B, lt, ir.ptradd(B, l.a, ir.cint(ir.isz(), @bit_cast(u64, lo - base))));
                q.align = 1;
                e = q;
            }
        } else {
            let q = ir.load(B, lt, x.b);
            q.align = 1;
            e = q;
        }
        v = ir.insert_elem(B, v, e, @as(u64, j));
    }
    if vt != l.ty {
        v = ir.bitcast(B, v, l.ty);
    }
    ir.forward(l, v);
    ir.remove_inst(l);
    cuts.deinit();
    return true;
}

let mut SB: *mut ir.Builder = @ptr_from_int(*mut ir.Builder, 0);
let mut marked_split: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0),
                                                                        len: 0, cap: 0 };

/// Splits copies and vector loads out of slots filled piece by piece
/// (split_copy, split_load); true if it changed any.
pub fn split_copies(f: *mut ir.Func) bool {
    if u.isnil(SB) {
        SB = ir.new_builder();
    }
    let mut any = false;
    for _round in @as(i32, 0)..4 {
        number(f);
        scan(f);
        let mut cs = u.List.[*mut ir.Value].empty();
        let mut b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                if (i.op == ir.OP_MEMCPY) or (i.op == ir.OP_MEMMOVE) or (i.op == ir.OP_LOAD) {
                    cs.push(i);
                }
                i = i.next;
            }
            b = b.next;
        }
        let mut changed = false;
        for c in cs.items() {
            if c.op == ir.OP_LOAD {
                if split_load(c, SB) {
                    changed = true;
                }
            } else if split_copy(c, SB) {
                changed = true;
            }
        }
        if changed {
            ir.apply_forwarding(f);
        }
        cs.deinit();
        for x in marked_split.items() {
            x.flag = 0;
        }
        marked_split.clear();
        clear();
        if not changed {
            break;
        }
        any = true;
    }
    if unread_writes(f) {
        any = true;
    }
    return any;
}

/// Removes the writes to stack slots of bytes that nothing reads (see
/// remove_unread_writes); true if it removed any.
pub fn unread_writes(f: *mut ir.Func) bool {
    number(f);
    scan(f);
    let any = remove_unread_writes(f);
    clear();
    return any;
}

// The bytes [lo, hi) of slot r that reader x reads (false if they are not
// constant: then it may read any).
fn read_range(x: *mut ir.Value, r: *mut ir.Value, lo: *mut i64, hi: *mut i64) bool {
    if (x.op == ir.OP_LOAD) and const_off(x.a, lo) {
        hi.* = lo.* + @bit_cast(i64, x.ty.size);
        return true;
    }
    if ((x.op == ir.OP_MEMCPY) or (x.op == ir.OP_MEMMOVE)) and ir.is_cint(x.c) and (root(x.b) == r) and
       (root(x.a) != r) and const_off(x.b, lo) {
        hi.* = lo.* + ir.sval(x.c);
        return true;
    }
    return false;
}

// Removes the writes to stack slots whose addresses go nowhere of bytes that
// nothing reads: what is left of a value built in a slot once the copies
// out of it are split (split_copy), each part taken from where it was
// written. True if it removed any.
fn remove_unread_writes(f: *mut ir.Func) bool {
    let mut dead = u.List.[*mut ir.Value].empty();
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let op = i.op;
            let mut p = i.a;
            if op == ir.OP_STORE {
                p = i.b;
            }
            let mut lo: i64 = 0;
            let mut hi: i64 = 0;
            if ((op == ir.OP_STORE) or (op == ir.OP_MEMSET) or (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE)) and
               (i.flags == 0) and written(i, &mut lo, &mut hi) {
                let r = root(p);
                let copy = (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE);
                if ir.is_op(r, ir.OP_ALLOCA) and not (copy and (root(i.b) == r)) {
                    let o = obj_of(r);
                    let mut read = o.escaped;
                    for k in 0..o.readers.len {
                        let x = o.readers.get(k);
                        let mut rl: i64 = 0;
                        let mut rh: i64 = 0;
                        if not read_range(x, r, &mut rl, &mut rh) or ((rh > lo) and (rl < hi)) {
                            read = true;
                            break;
                        }
                    }
                    if not read {
                        dead.push(i);
                    }
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    for i in dead.items() {
        ir.remove_inst(i);
    }
    let any = dead.len > 0;
    dead.deinit();
    return any;
}

fn clear() void {
    for k in 0..marked.len {
        marked.get(k).aux2 = 0;
    }
    marked.clear();
    nobjs = 0;
}

// Is any of the instructions marked (flag 79) reachable from c: after c in
// its block, or in a block reachable from c's block (c's own block again
// included, when c is in a loop)?
fn reaches_marked(c: *mut ir.Value) bool {
    let mut i = c.next;
    while u.notnil(i) {
        if i.flag == 79 {
            return true;
        }
        i = i.next;
    }
    let mut stack = u.List.[*mut ir.Block].empty();
    let mut seen = u.List.[*mut ir.Block].empty();
    let t = c.blk.last;
    for k in 0..ir.succ_count(t) {
        stack.push(ir.succ(t, k));
    }
    let mut found = false;
    while (stack.len > 0) and not found {
        let b = stack.get(stack.len - 1);
        stack.len -= 1;
        if b.aux == 79 {
            continue;
        }
        b.aux = 79;
        seen.push(b);
        let mut j = b.first;
        while u.notnil(j) {
            if j.flag == 79 {
                found = true;
            }
            j = j.next;
        }
        let bt = b.last;
        for k in 0..ir.succ_count(bt) {
            stack.push(ir.succ(bt, k));
        }
    }
    for b in seen.items() {
        b.aux = 0;
    }
    stack.deinit();
    seen.deinit();
    return found;
}

// A copy of a whole slot S into slot D (at its start) after which S is
// never used again, before which D is not used: D can be S itself (S made
// as large as D), and the copy goes. A value built in a function's local
// and returned, then bound to a variable, is one slot instead of three.
fn renamable(c: *mut ir.Value) bool {
    if (c.op != ir.OP_MEMCPY) or not ir.is_cint(c.c) {
        return false;
    }
    let d = c.a;
    let s = c.b;
    if (d.kind != ir.V_INST) or (d.op != ir.OP_ALLOCA) or (s.kind != ir.V_INST) or (s.op != ir.OP_ALLOCA) or (d == s) or
       (ir.cint_val(c.c) != ir.aty_of(s).size) or (ir.aty_of(s).size > ir.aty_of(d).size) {
        return false;
    }
    let od = obj_of(d);
    let os = obj_of(s);
    if os.escaped {
        return false;  // (D's address may go anywhere, from below the copy)
    }
    let lists: [3]*u.List.[*mut ir.Value] = [&od.readers, &od.writers, &od.escapers];
    for l in lists {
        for k in 0..l.len {
            let x = l.get(k);
            if (x != c) and not dominates(c, x) {
                return false;
            }
        }
    }
    // (the copy itself included: in a loop it reads S again, which must
    // then still hold what it held, not what D became)
    let slists: [2]*u.List.[*mut ir.Value] = [&os.readers, &os.writers];
    for l in slists {
        for k in 0..l.len {
            l.get(k).flag = 79;
        }
    }
    c.flag = 79;
    let ok = not reaches_marked(c);
    for l in slists {
        for k in 0..l.len {
            l.get(k).flag = 0;
        }
    }
    c.flag = 0;
    return ok;
}

/// Removes copies of aggregates into stack slots that are only read; true
/// if it removed any.
pub fn forward_copies(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    let mut any = false;
    for round in @as(i32, 0)..4 {
        _ = round;
        opt.compute_preds(f);
        let order = opt.dominators(f);
        order.deinit();
        number(f);
        scan(f);
        let mut done = u.List.[*mut ir.Value].empty();
        // and pairs for the local rules: (copy, the copy or fill before it)
        // or (copy into the result, the call that made it)
        let mut pairs = u.List.[*mut ir.Value].empty();
        let mut renames = u.List.[*mut ir.Value].empty();
        let mut moves = u.List.[*mut ir.Value].empty();
        let mut b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                if i.op == ir.OP_MEMCPY {
                    if removable(i) {
                        done.push(i);
                    } else if renamable(i) {
                        renames.push(i);
                    } else {
                        let mut c1 = copy_of_copy(i, &mut moves);
                        if u.isnil(c1) {
                            c1 = copy_of_fill(i);
                        }
                        let k = result_into_result(f, i);
                        if u.notnil(c1) {
                            pairs.push(i);
                            pairs.push(c1);
                        } else if u.notnil(k) {
                            pairs.push(i);
                            pairs.push(k);
                        }
                    }
                }
                i = i.next;
            }
            b = b.next;
        }
        clear();
        let mut changed = false;
        // the local rules when nothing else is left (each pair's
        // instructions untouched by another this round)
        if done.len == 0 {
            let mut touched = u.List.[*mut ir.Value].empty();
            let mut k: usize = 0;
            while k < pairs.len {
                let c = pairs.get(k);
                let x = pairs.get(k + 1);
                k += 2;
                if (c.flag == 77) or (x.flag == 77) {
                    continue;
                }
                if x.op == ir.OP_MEMCPY {
                    c.b = x.b;  // copy the source itself; the first copy is dead
                    for m in moves.items() {
                        if m == c {
                            c.op = ir.OP_MEMMOVE;  // (it may overlap)
                        }
                    }
                    ir.remove_inst(x);
                } else if x.op == ir.OP_MEMSET {
                    c.op = ir.OP_MEMSET;  // fill the destination itself; the first fill is dead
                    c.b = x.b;
                    ir.remove_inst(x);
                } else {
                    x.xs.set(0, c.a);  // the call writes the result; no copy
                    ir.remove_inst(c);
                }
                c.flag = 77;
                x.flag = 77;
                touched.push(c);
                touched.push(x);
                changed = true;
            }
            for t in touched.items() {
                t.flag = 0;
            }
            touched.deinit();
        }
        pairs.deinit();
        moves.deinit();
        // renames when nothing else is left, one per slot a round (each
        // slot's uses were found before any)
        if (done.len == 0) and not changed {
            let mut touched = u.List.[*mut ir.Value].empty();
            for c in renames.items() {
                let d = c.a;
                let s = c.b;
                if (d.flag == 77) or (s.flag == 77) {
                    continue;
                }
                ir.set_aty(s, ir.aty_of(d));
                s.align = @max(s.align, d.align);
                ir.remove_inst(c);
                ir.forward(d, s);
                d.flag = 77;
                s.flag = 77;
                touched.push(d);
                touched.push(s);
                changed = true;
            }
            for t in touched.items() {
                t.flag = 0;
            }
            touched.deinit();
        }
        renames.deinit();
        for k in 0..done.len {
            let c = done.get(k);
            let d = c.a;
            let s = source_for_uses(f, c);
            if u.isnil(s) {
                continue;
            }
            ir.remove_inst(c);
            ir.forward(d, s);
            changed = true;
        }
        done.deinit();
        if not changed {
            break;
        }
        ir.apply_forwarding(f);
        fold_offsets(f);
        any = true;
    }
    return any;
}
