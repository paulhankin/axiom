// =============================================================================
// plink.ax - links the ELF relocatable objects of x64.ax or a64.ax (read
// with elf.read) into a Windows executable for x86-64 or ARM64 (machine
// 0x8664 or 0xAA64): PE32+, a console program
// (or a GUI one, with no console window: --subsystem=windows), position
// independent (base relocations; the loader may place it anywhere),
// importing what the runtime calls from the system's DLLs.
//
// Sections (4 KiB in memory, 512-byte aligned in the file):
//   .text   r-x  code, one jump through the import address table per
//                imported function called, the entry point
//   .rdata  r--  read-only data, relocated read-only data, the thread-local
//                directory, unwind information (.xdata, in each
//                architecture's format: x64.ax's UNWIND_INFO, a64unwind.ax's
//                ARM64 records), then the function table (.pdata: every
//                function with a frame, sorted, 12-byte entries on x86-64
//                and 8-byte ones on ARM64; the
//                exception directory), without which the system cannot walk
//                the stack through our code, and an exception a DLL raises
//                to catch itself further up can end the process; then the
//                debug directory naming the program database (pdb.ax)
//   .idata  rw-  the import directory, lookup and address tables, names
//   .data   rw-  data, the GOT (addresses of our own symbols that code loads
//                through it), the thread-local template, _tls_index, then
//                zero-filled .bss (beyond the section's file data)
//   .reloc  r--  base relocations: every absolute address the image holds
//   .rsrc   r--  with --icon=FILE.ico: the program's icon, as resources (an
//                RT_GROUP_ICON naming one RT_ICON per image in the file),
//                which Explorer, the taskbar and shortcuts show
//
// Imports: what is still undefined after our own objects is a Windows
// function. A function declared in an `extern "C" "name"` block comes from
// name.dll (codegen leaves the name in a constant axiom.import.<function>);
// the runtime's are found in a DLL by their names: the BSD socket functions and those
// beginning with WSA are ws2_32.dll's, Rtl, Nt and Nls ones ntdll.dll's,
// BCrypt ones bcrypt.dll's, other capitalized ones kernel32.dll's. The C
// library is the compiler's own (std/c), linked into the program: nothing
// comes from the system's (msvcrt.dll), and a function or object that C
// code declares, does not define and no rule above names (a constant
// axiom.import.<function> holding "c": cmd/axiom/src/c/cgen.ax) is
// undefined, unless tg.g_system_c_library is set (then it is msvcrt.dll's).
// memcpy, memmove and memset, which a64.ax calls, are on ARM64 the
// linker's own (lstub.ax's, weak: a C library's win) when nothing defines
// them. Anything else is undefined. Calls
// go through a thunk (jmp [rip+slot] on x86-64; adrp x16, slot; ldr x16,
// [x16, :lo12:slot]; br x16 on ARM64); the thunk is also the function's
// address wherever one is taken.
//
// Thread-locals: the TLS directory makes the loader give every thread a copy
// of the template (.tdata, then .tbss as zeros in the file) and store its index in
// axiom.tls_index; code finds the copy in TEB.ThreadLocalStoragePointer
// (x64.ax; on ARM64 through x18, which holds the TEB: a64.ax). A
// thread-local's TPOFF32 (on ARM64, its TLSLE_ADD_TPREL pair) is its offset
// in the template.
//
// Entry: axiom.entry calls main(0, null) (the runtime reads the command line
// itself) and passes its result to ExitProcess.
// =============================================================================
import "a64unwind.ax" as uw;
import "bin.ax" as bn;
import "codeview.ax" as cvw;
import "coff.ax" as coff;
import "elf.ax" as elf;
import "jstub.ax" as jstub;
import "lstub.ax" as lstub;
import "nlink.ax" as nl;
import "pdb.ax" as pdb;
import "target.ax" as tg;
import "util.ax" as u;

const BASE: u64 = 0x1_4000_0000;  // the preferred image base

pub const SUBSYSTEM_WINDOWS_GUI: u64 = 2;
pub const SUBSYSTEM_WINDOWS_CUI: u64 = 3;
// The PE subsystem (--subsystem=console|windows): a GUI program gets no
// console window, and its standard streams are closed unless redirected.
pub let mut g_subsystem: u64 = 3;
// Write a program database next to the executable (--pdb=on|off), for
// debuggers and the system's symbol handler.
pub let mut g_pdb: bool = true;
// The program's icon (--icon=FILE.ico): the path of a Windows icon file, or "".
pub let mut g_icon: []u8 = "";
const SECT: u64 = 0x1000;   // section alignment in memory
const FILEAL: u64 = 0x200;  // and in the file
const STACK_RESERVE: u64 = 8 << 20;

const C_PDATA: i32 = 6;  // the function table (.pdata), one array at the end of .rdata
const C_NONE: i32 = -1;  // not in the image (.axiom.lines: for the PDB)

struct Dll {
    name: []u8,
    funcs: u.List.[u32],  // gsym indexes
}

let mut imports: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };  // gsym per thunk
let mut dlls: u.List.[Dll] = u.List.[Dll].{ data: @ptr_from_int(*mut Dll, 0), len: 0, cap: 0 };
let mut relocs: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };  // RVAs of addresses
// function name -> index in import_dlls + 1 (from axiom.import.* constants)
let mut import_map: u.SymMap.[u32] = u.SymMap.[u32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 };
let mut import_dlls: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
// the functions C code declares and does not define (by name: 1), which are
// C_LIBRARY's unless a rule of dll_of names another DLL
let mut c_library_fns: u.SymMap.[u32] = u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0),
                                                         vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 };
let C_LIBRARY: []u8 = "msvcrt.dll";  // (with tg.g_system_c_library)

/// What import libraries and DLLs given to the link (linkin.ax) say the
/// DLLs export: the name code refers to (or __imp_<name>, the import
/// address table slot), the DLL, the export's name or ordinal.
pub let mut g_imports: u.List.[coff.Import] = u.List.[coff.Import].{ data: @ptr_from_int(*mut coff.Import, 0), len: 0,
                                                                     cap: 0 };
// name -> its g_imports index + 1 (the first of a name)
let mut imp_map: u.SymMap.[u32] = u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u32, 0),
                                                   cap: 0, len: 0 };

let mut A64: bool = false;  // linking ARM64 objects (else x86-64 ones)

/// Linking a DLL (--emit=shared): IMAGE_FILE_DLL, its entry point the
/// linker's axiom.dll_entry, which runs the initialization arrays when a
/// process loads it (DLL_PROCESS_ATTACH) and the termination arrays,
/// backward, when it is unloaded (DLL_PROCESS_DETACH), then calls the
/// program's DllMain (if it defines one; else the answer is TRUE); the
/// export directory names the definitions of global symbols of default
/// visibility of the objects linked (not the linker's own), by name.
pub let mut g_dll: bool = false;
let mut n_inputs: usize = 0;  // the objects given to the link (the others are the linker's)
let mut exports: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };  // gsyms, by name

// An import thunk's size (see the header), and a .pdata entry's.
fn thunk_size() u64 {
    if A64 {
        return 12;
    }
    return 8;
}

fn pdata_entry() u64 {
    if A64 {
        return 8;
    }
    return 12;
}

fn machine() u32 {
    if A64 {
        return elf.EM_AARCH64;
    }
    return elf.EM_X86_64;
}

fn is_rva32(t: u32) bool {
    return (t == elf.R_X86_64_RVA32) or (t == elf.R_AARCH64_RVA32);
}

let mut thunk_addr: u64 = 0;
let mut iat_addr: u64 = 0;  // the import address table: one slot per import, in thunk order, NULL after each DLL's
let mut iat_slot: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };  // import -> its slot's address
let mut got_addr: u64 = 0;
let mut tls_addr: u64 = 0;  // the template's start

// Each section's file and memory placement.
struct Out {
    name: []u8,
    rva: u64,
    vsize: u64,
    fsize: u64,  // initialized bytes
    foff: u64,
    flags: u64,
}

fn class_of(s: *elf.Sec) i32 {
    if u.str_eq(s.name, ".pdata") {
        return C_PDATA;
    }
    let k = s.kind;
    if k == elf.S_DEBUG {
        return C_NONE;
    }
    if k == elf.S_TEXT {
        return nl.C_TEXT;
    }
    if k == elf.S_RODATA {
        return nl.C_CONST;  // (base relocations patch read-only pages too)
    }
    if k == elf.S_DATA {
        return nl.C_DATA;
    }
    if k == elf.S_BSS {
        return nl.C_BSS;
    }
    if k == elf.S_TDATA {
        return nl.C_TDATA;
    }
    return nl.C_TBSS;
}

let SOCKET_FNS: [22][]u8 = ["accept", "bind", "closesocket", "connect", "freeaddrinfo", "getaddrinfo", "gethostname",
                            "getpeername", "getsockname", "getsockopt", "htonl", "htons", "inet_ntop", "inet_pton",
                            "ioctlsocket", "listen", "recv", "recvfrom", "select", "send", "sendto", "setsockopt"];

// The DLLs that extern blocks named (the functions of macOS frameworks and
// dylibs are the runtime's ax_unavailable: nl.use_unavailable).
fn collect_dll_names() void {
    for f in nl.extern_fns(nl.is_apple_lib).items() {
        if u.str_eq(f.lib, "c") {
            c_library_fns.put(u.intern(f.name), 1);
            continue;
        }
        let mut dll = u.dup(f.lib);
        if u.find(dll, '.') < 0 {
            dll = u.cat2(dll, ".dll");
        }
        import_dlls.push(dll);
        import_map.put(u.intern(f.name), @int_cast(u32, import_dlls.len));
    }
}

// The import of a name (or of __imp_<name>) that an import library or a
// DLL given to the link names; nil if none.
fn import_of(name: []u8) *mut coff.Import {
    let mut n = name;
    if u.starts(n, "__imp_") {
        n = n[6..];
    }
    let k = imp_map.get(u.intern(n));
    if k == 0 {
        return u.nil.[coff.Import]();
    }
    return g_imports.at(@as(usize, k - 1));
}

// The DLL that exports a Windows function (see the header); "" if none.
// __imp_<name> is <name>'s import address table slot.
fn dll_of(name: []u8) []u8 {
    let im = import_of(name);
    if u.notnil(im) {
        return im.dll;
    }
    if u.starts(name, "__imp_") {
        return dll_of(name[6..]);
    }
    let k = import_map.get(u.intern(name));
    if k != 0 {
        return import_dlls.get(@as(usize, k - 1));
    }
    for f in SOCKET_FNS {
        if u.str_eq(f, name) {
            return "ws2_32.dll";
        }
    }
    if u.str_eq(name, "shutdown") {
        return "ws2_32.dll";
    }
    if (name.len == 0) or (name[0] < 'A') or (name[0] > 'Z') {
        if tg.g_system_c_library and (c_library_fns.get(u.intern(name)) != 0) {
            return C_LIBRARY;
        }
        return "";
    }
    if u.starts(name, "WSA") {
        return "ws2_32.dll";
    }
    if u.starts(name, "Rtl") or u.starts(name, "Nt") or u.starts(name, "Nls") {
        return "ntdll.dll";
    }
    if u.starts(name, "BCrypt") {
        return "bcrypt.dll";
    }
    if u.starts(name, "ConvertStringSecurityDescriptor") {
        return "advapi32.dll";  // (the runtime's files private to their owner: windows.ax)
    }
    return "kernel32.dll";
}

// -----------------------------------------------------------------------------
// Symbols
// -----------------------------------------------------------------------------
fn collect_symbols() void {
    nl.define_globals();
    nl.use_unavailable();
    // What is still undefined must be a Windows function, never one of our
    // own (module-qualified) names.
    for gi in 0..nl.gsyms.len {
        let g = nl.gsyms.at(gi);
        if (g.obj < 0) and not g.weak and (dll_of(g.name).len == 0) {
            if c_library_fns.get(u.intern(g.name)) != 0 {
                nl.err(u.f1("undefined symbol '%s' (declared by C code and defined by no unit, nor by the C library)",
                            g.name));
            } else {
                nl.err(u.f1("undefined symbol '%s'", g.name));
            }
        }
    }
}

fn is_import(oi: usize, si: u32) bool {
    let gi = nl.global_of(oi, si);
    return (gi >= 0) and (nl.gsyms.at(@int_cast(usize, gi)).obj < 0) and not nl.gsyms.at(@int_cast(usize, gi)).weak;
}

// A symbol's address; an imported function's is its thunk's, and
// __imp_<name>'s its import address table slot.
fn sym_addr(oi: usize, si: u32) u64 {
    if is_import(oi, si) {
        let g = nl.gsyms.at(@as(usize, @bit_cast(u32, nl.global_of(oi, si))));
        if u.starts(g.name, "__imp_") {
            return iat_slot.get(@as(usize, @bit_cast(u32, g.stub)));
        }
        return thunk_addr + (@as(u64, @bit_cast(u32, g.stub)) * thunk_size());
    }
    return nl.sym_addr(oi, si);  // (0 for a missing weak one: see abs_at)
}

fn add_import(gi: u32) void {
    let g = nl.gsyms.at(@as(usize, gi));
    if g.stub >= 0 {
        return;
    }
    if u.starts(g.name, "__imp_") {
        // (the slot of <name>'s import)
        let xi = nl.gsym_index(g.name[6..]);
        add_import(xi);
        nl.gsyms.at(@as(usize, gi)).stub = nl.gsyms.get(@as(usize, xi)).stub;
        return;
    }
    g.stub = @int_cast(i32, imports.len);
    imports.push(gi);
    let dn = dll_of(g.name);
    for k in 0..dlls.len {
        if u.str_eq(dlls.get(k).name, dn) {
            dlls.at(k).funcs.push(gi);
            return;
        }
    }
    let mut d = Dll.{ name: dn, funcs: u.List.[u32].empty() };
    d.funcs.push(gi);
    dlls.push(d);
}

// Imports, and GOT slots that loads through the GOT need (a load of an
// imported function's address reads its import address table slot instead).
fn scan_relocs() void {
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        for k in 0..o.secs.len {
            let s = o.secs.get(k);
            for r in s.relocs.items() {
                if is_import(oi, r.sym) {
                    add_import(@bit_cast(u32, nl.global_of(oi, r.sym)));
                } else if nl.is_got_reloc(not A64, r.ty) {
                    _ = nl.got_slot(oi, r.sym);
                }
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Layout
// -----------------------------------------------------------------------------
let mut outs: [6]Out = [Out.{ name: "", rva: 0, vsize: 0, fsize: 0, foff: 0, flags: 0 }; 6];

// The file offset of an image address (in a section's file data).
fn file_of(addr: u64) u64 {
    let rva = addr - BASE;
    for o in outs {
        if (rva >= o.rva) and (rva < (o.rva + o.fsize)) {
            return o.foff + (rva - o.rva);
        }
    }
    nl.err("internal: an address outside the file's data");
    return 0;
}

// -----------------------------------------------------------------------------
// Relocation
// -----------------------------------------------------------------------------
// An absolute address at addr: the loader adds the image's displacement.
fn abs_at(b: []mut u8, addr: u64, value: u64) void {
    bn.w64(b, file_of(addr), value);
    if value != 0 {
        relocs.push(addr - BASE);
    }
}

fn rel32(b: []mut u8, p: u64, target: u64) void {
    let v = @bit_cast(i64, target) - @bit_cast(i64, p);
    if (v < -0x8000_0000) or (v > 0x7fff_ffff) {
        nl.err("relocation out of range (pc32)");
    }
    bn.w32(b, file_of(p), @bit_cast(u64, v) & 0xFFFF_FFFF);
}

fn apply_relocs(b: []mut u8) void {
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        for k in 0..o.secs.len {
            let s = o.secs.get(k);
            let cls = nl.sec_cls.get(oi)[k];
            if (cls == nl.C_BSS) or (cls == nl.C_TBSS) {
                continue;
            }
            let base = nl.sec_addr.get(oi)[k];
            for r in s.relocs.items() {
                let p = base + r.off;
                let t = r.ty;
                let mut sa = sym_addr(oi, r.sym) +% @bit_cast(u64, r.addend);
                if (cls == C_PDATA) and (o.syms.get(@as(usize, r.sym)).sec >= 0) {
                    // (the object's own copy of the function: one more
                    // object's definition of a weak one won, and the entry
                    // must describe this copy's code, not the other's)
                    sa = nl.sym_addr_in(oi, r.sym) +% @bit_cast(u64, r.addend);
                }
                if A64 {
                    a64_reloc(b, oi, r.sym, p, t, sa);
                    continue;
                }
                if nl.is_got_reloc(true, t) {
                    if is_import(oi, r.sym) {
                        // the import address table slot holds the address
                        let g = nl.gsyms.at(@as(usize, @bit_cast(u32, nl.global_of(oi, r.sym))));
                        rel32(b, p, iat_slot.get(@as(usize, @bit_cast(u32, g.stub))) +% @bit_cast(u64, r.addend));
                        continue;
                    }
                    if nl.x64_relax(b, file_of(p), t) {
                        rel32(b, p, sa);
                        continue;
                    }
                    let ga = got_addr + (@as(u64, @bit_cast(u32, nl.got_slot(oi, r.sym))) * 8);
                    rel32(b, p, ga +% @bit_cast(u64, r.addend));
                    continue;
                }
                if t == elf.R_X86_64_64 {
                    abs_at(b, p, sa);
                } else if nl.is_call_reloc(true, t) {
                    rel32(b, p, sa);
                } else if is_rva32(t) {
                    bn.w32(b, file_of(p), sa - BASE);
                } else if t == elf.R_X86_64_TPOFF32 {
                    // the offset in the thread's copy of the template
                    let v = @bit_cast(i64, sa -% tls_addr);
                    if (v < 0) or (v > 0x7fff_ffff) {
                        nl.err("thread-local offset out of range");
                    }
                    bn.w32(b, file_of(p), @bit_cast(u64, v));
                } else {
                    nl.err(u.f1("unsupported relocation type %s", u.udec(@as(u64, t))));
                }
            }
        }
    }
}

// An ARM64 relocation at p of symbol si of object oi (target sa: the
// symbol's address, an import's thunk's, plus the addend): loads of a GOT
// slot (an import's import address table slot), absolute and image-relative
// addresses, thread-local offsets in the template, and the instruction
// fields nl.a64_reloc fills.
fn a64_reloc(b: []mut u8, oi: usize, si: u32, p: u64, t: u32, sa: u64) void {
    let fo = file_of(p);
    if nl.is_got_reloc(false, t) {
        let mut ga: u64 = 0;
        if is_import(oi, si) {
            let g = nl.gsyms.at(@as(usize, @bit_cast(u32, nl.global_of(oi, si))));
            ga = iat_slot.get(@as(usize, @bit_cast(u32, g.stub)));
        } else {
            ga = got_addr + (@as(u64, @bit_cast(u32, nl.got_slot(oi, si))) * 8);
        }
        nl.a64_got(b, fo, p, t, ga, 0);
        return;
    }
    if t == elf.R_AARCH64_ABS64 {
        abs_at(b, p, sa);
    } else if is_rva32(t) {
        bn.w32(b, fo, sa - BASE);
    } else if nl.a64_reloc(b, fo, p, t, sa) {
        return;
    } else if nl.is_a64_tls(t) {
        // the offset in the thread's copy of the template
        let v = @bit_cast(i64, sa -% tls_addr);
        nl.a64_tls(b, fo, t, v, v);
    } else {
        nl.err(u.f1("unsupported relocation type %s", u.udec(@as(u64, t))));
    }
}

// -----------------------------------------------------------------------------
// The linker's own object: the entry point, the thread-local index, the TLS
// callback list (empty) and the TLS directory (filled in at the end).
// -----------------------------------------------------------------------------
let mut own_tls_dir: u32 = 0;
let mut own_index: usize = 0;  // the object's index in nl.objs

fn own_object() *mut elf.Obj {
    let o = elf.new_obj(machine());
    let text = elf.add_sec(o, ".text", elf.S_TEXT, 16);
    let data = elf.add_sec(o, ".data", elf.S_DATA, 8);
    let rodata = elf.add_sec(o, ".rdata", elf.S_RODATA, 8);
    let ds = o.secs.get(@int_cast(usize, data));
    ds.data.zeros(24);  // axiom.tls_index (u32), the callback list's NULL, _fltused
    _ = elf.add_sym(o, elf.Sym.{ name: "axiom.tls_index", sec: data, value: 0, size: 4, bind: elf.B_GLOBAL,
                                 ty: elf.T_OBJECT, hidden: true, protected: false });
    // what the platform's compilers' objects refer to, which their C
    // runtime defines: the thread-local index (the same), and _fltused
    // (that floating point is used: nothing here)
    _ = elf.add_sym(o, elf.Sym.{ name: "_tls_index", sec: data, value: 0, size: 4, bind: elf.B_WEAK, ty: elf.T_OBJECT,
                                 hidden: true, protected: false });
    _ = elf.add_sym(o, elf.Sym.{ name: "_fltused", sec: data, value: 16, size: 4, bind: elf.B_WEAK, ty: elf.T_OBJECT,
                                 hidden: true, protected: false });
    let rs = o.secs.get(@int_cast(usize, rodata));
    rs.data.zeros(40);  // IMAGE_TLS_DIRECTORY64
    own_tls_dir = elf.add_sym(o, elf.Sym.{ name: "axiom.tls_directory", sec: rodata, value: 0, size: 40,
                                           bind: elf.B_GLOBAL, ty: elf.T_OBJECT, hidden: true, protected: false });
    let ts = o.secs.get(@int_cast(usize, text));
    if g_dll {
        dll_entry(o, text);
        return o;
    }
    let main_ = elf.ext_sym(o, "main", false);
    let exitp = elf.ext_sym(o, "ExitProcess", false);
    if A64 {
        own_entry_a64(o, text, main_, exitp);
        return o;
    }
    let entry: [22]u8 = [0x48, 0x83, 0xec, 0x28,  // sub rsp, 40 (shadow space; aligned)
                         0x31, 0xc9,              // xor ecx, ecx
                         0x31, 0xd2,              // xor edx, edx
                         0xe8, 0, 0, 0, 0,        // call main
                         0x89, 0xc1,              // mov ecx, eax
                         0xe8, 0, 0, 0, 0,        // call ExitProcess
                         0xcc, 0xcc];
    ts.data.put(entry[..]);
    ts.relocs.push(elf.Rel.{ off: 9, ty: elf.R_X86_64_PLT32, sym: main_, addend: -4 });
    ts.relocs.push(elf.Rel.{ off: 16, ty: elf.R_X86_64_PLT32, sym: exitp, addend: -4 });
    let es = elf.add_sym(o, elf.Sym.{ name: "axiom.entry", sec: text, value: 0, size: 22, bind: elf.B_GLOBAL,
                                      ty: elf.T_FUNC, hidden: true, protected: false });
    // its unwind information (sub rsp, 40: UWOP_ALLOC_SMALL after 4 bytes)
    // and function table entry, as x64.ax makes them for compiled functions
    let xdata = elf.add_sec(o, ".xdata", elf.S_RODATA, 4);
    let unwind: [8]u8 = [1, 4, 1, 0, 4, 0x42, 0, 0];
    o.secs.get(@int_cast(usize, xdata)).data.put(unwind[..]);
    let xs = elf.add_sym(o, elf.Sym.{ name: "", sec: xdata, value: 0, size: 8, bind: elf.B_LOCAL, ty: elf.T_NOTYPE,
                                      hidden: false, protected: false });
    let pdata = elf.add_sec(o, ".pdata", elf.S_RODATA, 4);
    let ps = o.secs.get(@int_cast(usize, pdata));
    ps.data.zeros(12);
    ps.relocs.push(elf.Rel.{ off: 0, ty: elf.R_X86_64_RVA32, sym: es, addend: 0 });
    ps.relocs.push(elf.Rel.{ off: 4, ty: elf.R_X86_64_RVA32, sym: es, addend: 22 });
    ps.relocs.push(elf.Rel.{ off: 8, ty: elf.R_X86_64_RVA32, sym: xs, addend: 0 });
    // __axc_sig_trampoline (std/c/rt/core_signal.ax: a fault delivered to a C
    // signal handler), entered as if the faulting instruction had called it
    // (whatever the alignment of rsp): push rbp; mov rbp, rsp; and rsp, -16;
    // sub rsp, 32; call r8; int3, with unwind information on rbp
    // (UWOP_PUSH_NONVOL rbp after 1 byte, UWOP_SET_FPREG after 4): the
    // system's walks go on in the faulting function.
    ts.data.zeros(10);  // (to 32)
    let tramp: [17]u8 = [0x55, 0x48, 0x89, 0xe5, 0x48, 0x83, 0xe4, 0xf0, 0x48, 0x83, 0xec, 0x20, 0x41, 0xff, 0xd0, 0xcc,
                         0xcc];
    ts.data.put(tramp[..]);
    let tsym = elf.add_sym(o, elf.Sym.{ name: "__axc_sig_trampoline", sec: text, value: 32, size: 17,
                                        bind: elf.B_GLOBAL, ty: elf.T_FUNC, hidden: false, protected: false });
    let tinfo: [8]u8 = [1, 4, 2, 5, 4, 3, 1, 0x50];
    o.secs.get(@int_cast(usize, xdata)).data.put(tinfo[..]);
    ps.data.zeros(12);
    ps.relocs.push(elf.Rel.{ off: 12, ty: elf.R_X86_64_RVA32, sym: tsym, addend: 0 });
    ps.relocs.push(elf.Rel.{ off: 16, ty: elf.R_X86_64_RVA32, sym: tsym, addend: 17 });
    ps.relocs.push(elf.Rel.{ off: 20, ty: elf.R_X86_64_RVA32, sym: xs, addend: 8 });
    // __chkstk, which the platform's compilers call before a frame of more
    // than a page (rax: its size): touches each page from the caller's rsp
    // down, in order (the stack grows a guard page at a time), and keeps
    // every register (the caller then moves rsp)
    ts.data.zeros(15);                                   // (to 64)
    let chk: [48]u8 = [0x51, 0x50,                       // push rcx; push rax
                       0x48, 0x8d, 0x4c, 0x24, 0x18,     // lea rcx, [rsp + 24]: the caller's rsp
                       0x48, 0x3d, 0, 0x10, 0, 0,        // cmp rax, 4096
                       0x72, 0x18,                       // jb last
                       0x48, 0x81, 0xe9, 0, 0x10, 0, 0,  // loop: sub rcx, 4096
                       0x48, 0x85, 0x09,                 // test [rcx], rcx
                       0x48, 0x2d, 0, 0x10, 0, 0,        // sub rax, 4096
                       0x48, 0x3d, 0, 0x10, 0, 0,        // cmp rax, 4096
                       0x77, 0xe8,                       // ja loop
                       0x48, 0x29, 0xc1,                 // last: sub rcx, rax
                       0x48, 0x85, 0x09,                 // test [rcx], rcx
                       0x58, 0x59, 0xc3];                // pop rax; pop rcx; ret
    ts.data.put(chk[..]);
    _ = elf.add_sym(o, elf.Sym.{ name: "__chkstk", sec: text, value: 64, size: 48, bind: elf.B_WEAK, ty: elf.T_FUNC,
                                 hidden: true, protected: false });
    return o;
}

// A DLL's entry point, axiom.dll_entry(instance, reason, reserved) (see
// g_dll), with its unwind information and function table entry; and
// DllMain's default (weak: the program's wins), which says TRUE.
fn dll_entry(o: *mut elf.Obj, text: i32) void {
    let ts = o.secs.get(@int_cast(usize, text));
    let ia = elf.ext_sym(o, "__init_array_start", true);
    let ie = elf.ext_sym(o, "__init_array_end", true);
    let fa = elf.ext_sym(o, "__fini_array_start", true);
    let fe = elf.ext_sym(o, "__fini_array_end", true);
    let dm = elf.ext_sym(o, "DllMain", false);
    let xdata = elf.add_sec(o, ".xdata", elf.S_RODATA, 4);
    let xs = elf.add_sym(o, elf.Sym.{ name: "", sec: xdata, value: 0, size: 0, bind: elf.B_LOCAL, ty: elf.T_NOTYPE,
                                      hidden: false, protected: false });
    let pdata = elf.add_sec(o, ".pdata", elf.S_RODATA, 4);
    let ps = o.secs.get(@int_cast(usize, pdata));
    let mut size: u64 = 0;
    let mut tsize: u64 = 0;
    if A64 {
        let words: [37]u32 = [0xa9bd_7bfd,   // stp x29, x30, [sp, #-48]!
                              0x9100_03fd,   // mov x29, sp
                              0xa901_53f3,   // stp x19, x20, [sp, #16]
                              0xa902_5bf5,   // stp x21, x22, [sp, #32]
                              0xaa00_03f3,   // mov x19, x0
                              0x2a01_03f4,   // mov w20, w1
                              0xaa02_03f5,   // mov x21, x2
                              0x7100_069f,   // cmp w20, #1 (DLL_PROCESS_ATTACH)
                              0x5400_0141,   // b.ne detach
                              0x9000_0016,   // adrp x22, __init_array_start
                              0x9100_02d6,   // add x22, x22, :lo12:__init_array_start
                              0x9000_0010,   // init: adrp x16, __init_array_end
                              0x9100_0210,   // add x16, x16, :lo12:__init_array_end
                              0xeb10_02df,   // cmp x22, x16
                              0x5400_01c2,   // b.hs done
                              0xf840_86d0,   // ldr x16, [x22], #8
                              0xd63f_0200,   // blr x16
                              0x17ff_fffa,   // b init
                              0x3500_0154,   // detach: cbnz w20, done (not DLL_PROCESS_DETACH)
                              0x9000_0016,   // adrp x22, __fini_array_end
                              0x9100_02d6,   // add x22, x22, :lo12:__fini_array_end
                              0x9000_0010,   // fini: adrp x16, __fini_array_start
                              0x9100_0210,   // add x16, x16, :lo12:__fini_array_start
                              0xeb10_02df,   // cmp x22, x16
                              0x5400_0089,   // b.ls done
                              0xf85f_8ed0,   // ldr x16, [x22, #-8]!
                              0xd63f_0200,   // blr x16
                              0x17ff_fffa,   // b fini
                              0xaa13_03e0,   // done: mov x0, x19
                              0x2a14_03e1,   // mov w1, w20
                              0xaa15_03e2,   // mov x2, x21
                              0xa942_5bf5,   // ldp x21, x22, [sp, #32]
                              0xa941_53f3,   // ldp x19, x20, [sp, #16]
                              0xa8c3_7bfd,   // ldp x29, x30, [sp], #48
                              0x1400_0000,   // b DllMain
                              0x5280_0020,   // the default DllMain: mov w0, #1
                              0xd65f_03c0];  // ret
        for w in words {
            ts.data.u32_(@as(u64, w));
        }
        let pairs: [4][2]u64 = [[36, 0], [44, 1], [76, 3], [84, 2]];
        let targets: [4]u32 = [ia, ie, fa, fe];
        for k in @as(usize, 0)..4 {
            ts.relocs.push(elf.Rel.{ off: pairs[k][0], ty: elf.R_AARCH64_ADR_PREL_PG_HI21, sym: targets[k],
                                     addend: 0 });
            ts.relocs.push(elf.Rel.{ off: pairs[k][0] + 4, ty: elf.R_AARCH64_ADD_ABS_LO12_NC, sym: targets[k],
                                     addend: 0 });
        }
        ts.relocs.push(elf.Rel.{ off: 136, ty: elf.R_AARCH64_JUMP26, sym: dm, addend: 0 });
        size = 140;
        tsize = 8;
        let mut pro = uw.new_codes();
        uw.save_fplr_x(&mut pro, 48);
        uw.op1(&mut pro, uw.SET_FP);
        uw.save_regp(&mut pro, 19, 16);
        uw.save_regp(&mut pro, 21, 32);
        let mut epi = uw.new_codes();
        uw.save_regp(&mut epi, 21, 32);
        uw.save_regp(&mut epi, 19, 16);
        uw.save_fplr_x(&mut epi, 48);
        let mut eps = u.List.[u64].empty();
        eps.push(124);
        let mut info = uw.xdata(size, &pro, &epi, eps.items());
        o.secs.get(@int_cast(usize, xdata)).data.put(info.view());
        info.free();
    } else {
        let code: [113]u8 = [0x53, 0x56, 0x57, 0x41, 0x54,        // push rbx, rsi, rdi, r12
                             0x48, 0x83, 0xec, 0x28,              // sub rsp, 40
                             0x48, 0x89, 0xcb,                    // mov rbx, rcx
                             0x89, 0xd6,                          // mov esi, edx
                             0x4c, 0x89, 0xc7,                    // mov rdi, r8
                             0x83, 0xfe, 0x01,                    // cmp esi, 1 (DLL_PROCESS_ATTACH)
                             0x75, 0x1d,                          // jne detach
                             0x4c, 0x8d, 0x25, 0, 0, 0, 0,        // lea r12, [rip + __init_array_start]
                             0x48, 0x8d, 0x05, 0, 0, 0, 0,        // init: lea rax, [rip + __init_array_end]
                             0x49, 0x39, 0xc4,                    // cmp r12, rax
                             0x73, 0x2b,                          // jae done
                             0x41, 0xff, 0x14, 0x24,              // call [r12]
                             0x49, 0x83, 0xc4, 0x08,              // add r12, 8
                             0xeb, 0xea,                          // jmp init
                             0x85, 0xf6,                          // detach: test esi, esi (DLL_PROCESS_DETACH)
                             0x75, 0x1d,                          // jne done
                             0x4c, 0x8d, 0x25, 0, 0, 0, 0,        // lea r12, [rip + __fini_array_end]
                             0x48, 0x8d, 0x05, 0, 0, 0, 0,        // fini: lea rax, [rip + __fini_array_start]
                             0x49, 0x39, 0xc4,                    // cmp r12, rax
                             0x76, 0x0a,                          // jbe done
                             0x49, 0x83, 0xec, 0x08,              // sub r12, 8
                             0x41, 0xff, 0x14, 0x24,              // call [r12]
                             0xeb, 0xea,                          // jmp fini
                             0x48, 0x89, 0xd9,                    // done: mov rcx, rbx
                             0x89, 0xf2,                          // mov edx, esi
                             0x49, 0x89, 0xf8,                    // mov r8, rdi
                             0xe8, 0, 0, 0, 0,                    // call DllMain
                             0x48, 0x83, 0xc4, 0x28,              // add rsp, 40
                             0x41, 0x5c, 0x5f, 0x5e, 0x5b, 0xc3,  // pop r12, rdi, rsi, rbx; ret
                             0xb8, 1, 0, 0, 0, 0xc3];             // the default DllMain: mov eax, 1; ret
        ts.data.put(code[..]);
        let at: [4]u64 = [25, 32, 58, 65];
        let targets: [4]u32 = [ia, ie, fe, fa];
        for k in @as(usize, 0)..4 {
            ts.relocs.push(elf.Rel.{ off: at[k], ty: elf.R_X86_64_PC32, sym: targets[k], addend: -4 });
        }
        ts.relocs.push(elf.Rel.{ off: 93, ty: elf.R_X86_64_PLT32, sym: dm, addend: -4 });
        size = 107;
        tsize = 6;
        // pushes of rbx, rsi, rdi, r12 after 1, 2, 3, 5 bytes; 40 bytes
        // allocated after 9 (UWOP_PUSH_NONVOL, UWOP_ALLOC_SMALL)
        let unwind: [16]u8 = [1, 9, 5, 0, 9, 0x42, 5, 0xc0, 3, 0x70, 2, 0x60, 1, 0x30, 0, 0];
        o.secs.get(@int_cast(usize, xdata)).data.put(unwind[..]);
    }
    let es = elf.add_sym(o, elf.Sym.{ name: "axiom.dll_entry", sec: text, value: 0, size: size, bind: elf.B_GLOBAL,
                                      ty: elf.T_FUNC, hidden: true, protected: false });
    _ = elf.add_sym(o, elf.Sym.{ name: "DllMain", sec: text, value: size, size: tsize, bind: elf.B_WEAK, ty: elf.T_FUNC,
                                 hidden: true, protected: false });
    if A64 {
        ps.data.zeros(8);
        ps.relocs.push(elf.Rel.{ off: 0, ty: elf.R_AARCH64_RVA32, sym: es, addend: 0 });
        ps.relocs.push(elf.Rel.{ off: 4, ty: elf.R_AARCH64_RVA32, sym: xs, addend: 0 });
    } else {
        ps.data.zeros(12);
        ps.relocs.push(elf.Rel.{ off: 0, ty: elf.R_X86_64_RVA32, sym: es, addend: 0 });
        ps.relocs.push(elf.Rel.{ off: 4, ty: elf.R_X86_64_RVA32, sym: es, addend: @bit_cast(i64, size) });
        ps.relocs.push(elf.Rel.{ off: 8, ty: elf.R_X86_64_RVA32, sym: xs, addend: 0 });
    }
}

// The DLL's exports (see g_dll), sorted by name (the export name table's
// order, which the loader's lookups search).
fn collect_exports() void {
    exports = u.List.[u32].empty();
    for gi in 0..nl.gsyms.len {
        let g = nl.gsyms.get(gi);
        if (g.obj < 0) or (@as(usize, @bit_cast(u32, g.obj)) >= n_inputs) {
            continue;
        }
        let s = nl.objs.get(@as(usize, @bit_cast(u32, g.obj))).syms.get(@as(usize, g.sym));
        if s.hidden or (s.bind == elf.B_LOCAL) or elf.is_part_name(s.name) or u.starts(s.name, "axiom.") or
           u.starts(s.name, "__start_") or u.starts(s.name, "__stop_") or u.starts(s.name, ".weak.") or
           (s.ty == elf.T_TLS) {
            continue;
        }
        exports.push(@truncate(u32, gi));
    }
    u.sort.[u32](exports.items(), cmp_export);
}

fn cmp_export(a: u32, b: u32) i32 {
    return u.str_cmp(nl.gsyms.get(@as(usize, a)).name, nl.gsyms.get(@as(usize, b)).name);
}

// The export directory's size (with its tables and names), for the DLL
// file name `dll`.
fn export_size(dll: []u8) u64 {
    let n = @as(u64, exports.len);
    let mut size = 40 + (n * 10) + @as(u64, dll.len) + 1;
    for gi in exports.items() {
        size += @as(u64, nl.gsyms.get(@as(usize, gi)).name.len) + 1;
    }
    return size;
}

// The export directory at address `at` (in b): IMAGE_EXPORT_DIRECTORY, the
// export address table (ordinals from 1, in name order), the name pointer
// table, the ordinal table, the names.
fn write_exports(b: []mut u8, at: u64, dll: []u8) void {
    let n = @as(u64, exports.len);
    let rva = at - BASE;
    let eat = rva + 40;
    let npt = eat + (n * 4);
    let ot = npt + (n * 4);
    let mut names = ot + (n * 2);
    let fo = file_of(at);
    bn.w32(b, fo + 12, names);  // Name: the DLL's
    bn.put_at(b, file_of(BASE + names), dll);
    names += @as(u64, dll.len) + 1;
    bn.w32(b, fo + 16, 1);  // ordinal base
    bn.w32(b, fo + 20, n);
    bn.w32(b, fo + 24, n);
    bn.w32(b, fo + 28, eat);
    bn.w32(b, fo + 32, npt);
    bn.w32(b, fo + 36, ot);
    for k in 0..exports.len {
        let g = nl.gsyms.get(@as(usize, exports.get(k)));
        let kk = @as(u64, k);
        bn.w32(b, file_of(BASE + eat + (kk * 4)), sym_addr(@as(usize, @bit_cast(u32, g.obj)), g.sym) - BASE);
        bn.w32(b, file_of(BASE + npt + (kk * 4)), names);
        bn.w16(b, file_of(BASE + ot + (kk * 2)), kk);
        bn.put_at(b, file_of(BASE + names), g.name);
        names += @as(u64, g.name.len) + 1;
    }
}

// ARM64: axiom.entry, with its unwind information (the frame record saved,
// x29 set) and function table entry, as a64.ax makes them.
fn own_entry_a64(o: *mut elf.Obj, text: i32, main_: u32, exitp: u32) void {
    let ts = o.secs.get(@int_cast(usize, text));
    let words: [7]u32 = [0xa9bf_7bfd,   // stp x29, x30, [sp, #-16]!
                         0x9100_03fd,   // mov x29, sp
                         0x5280_0000,   // mov w0, #0
                         0xd280_0001,   // mov x1, #0
                         0x9400_0000,   // bl main
                         0x9400_0000,   // bl ExitProcess (w0: main's result)
                         0x0000_0000];  // udf
    for w in words {
        ts.data.u32_(@as(u64, w));
    }
    ts.relocs.push(elf.Rel.{ off: 16, ty: elf.R_AARCH64_CALL26, sym: main_, addend: 0 });
    ts.relocs.push(elf.Rel.{ off: 20, ty: elf.R_AARCH64_CALL26, sym: exitp, addend: 0 });
    let es = elf.add_sym(o, elf.Sym.{ name: "axiom.entry", sec: text, value: 0, size: 28, bind: elf.B_GLOBAL,
                                      ty: elf.T_FUNC, hidden: true, protected: false });
    let mut pro = uw.new_codes();
    uw.save_fplr_x(&mut pro, 16);
    uw.op1(&mut pro, uw.SET_FP);
    let epi = uw.new_codes();
    let none = u.List.[u64].empty();
    let mut info = uw.xdata(28, &pro, &epi, none.items());
    let xdata = elf.add_sec(o, ".xdata", elf.S_RODATA, 4);
    o.secs.get(@int_cast(usize, xdata)).data.put(info.view());
    info.free();
    let xs = elf.add_sym(o, elf.Sym.{ name: "", sec: xdata, value: 0, size: 8, bind: elf.B_LOCAL, ty: elf.T_NOTYPE,
                                      hidden: false, protected: false });
    let pdata = elf.add_sec(o, ".pdata", elf.S_RODATA, 4);
    let ps = o.secs.get(@int_cast(usize, pdata));
    ps.data.zeros(8);
    ps.relocs.push(elf.Rel.{ off: 0, ty: elf.R_AARCH64_RVA32, sym: es, addend: 0 });
    ps.relocs.push(elf.Rel.{ off: 4, ty: elf.R_AARCH64_RVA32, sym: xs, addend: 0 });
    // __chkstk (x15: the frame's size in 16-byte units), which the
    // platform's compilers call before a frame of more than a page: touches
    // each page below sp, in order, and keeps every register but x16 and
    // x17 (the caller then moves sp)
    ts.data.u32_(0);                  // (to 32)
    let chk: [7]u32 = [0xd37c_edf0,   // lsl x16, x15, #4: the size in bytes
                       0x9100_03f1,   // mov x17, sp
                       0xd140_0631,   // loop: sub x17, x17, #4096
                       0xf140_0610,   // subs x16, x16, #4096
                       0xf940_023f,   // ldr xzr, [x17]
                       0x54ff_ffac,   // b.gt loop
                       0xd65f_03c0];  // ret
    for w in chk {
        ts.data.u32_(@as(u64, w));
    }
    _ = elf.add_sym(o, elf.Sym.{ name: "__chkstk", sec: text, value: 32, size: 28, bind: elf.B_WEAK, ty: elf.T_FUNC,
                                 hidden: true, protected: false });
    // __axc_sig_trampoline (std/c/rt/core_signal.ax: a fault delivered to a C
    // signal handler), entered with sp at a copy of the faulting thread's
    // CONTEXT and x2 the function to call: nop; blr x2; brk #0xf000. Its
    // unwind codes: MSFT_OP_CONTEXT (0xea: the registers of the frame below
    // are the CONTEXT's at sp; for the nop, which is the prologue), end. So
    // the system's walks (a longjmp out of the handler, a stack trace) go on
    // in the faulting function with its registers as they were there.
    ts.data.u32_(0);  // (to 64)
    let tramp: [3]u32 = [0xd503_201f, 0xd63f_0040, 0xd43e_0000];
    for w in tramp {
        ts.data.u32_(@as(u64, w));
    }
    let tsym = elf.add_sym(o, elf.Sym.{ name: "__axc_sig_trampoline", sec: text, value: 64, size: 12,
                                        bind: elf.B_GLOBAL, ty: elf.T_FUNC, hidden: false, protected: false });
    let mut tpro = uw.new_codes();
    uw.op1(&mut tpro, uw.CONTEXT);
    let tepi = uw.new_codes();
    let tnone = u.List.[u64].empty();
    let mut tinfo = uw.xdata(12, &tpro, &tepi, tnone.items());
    let xsec = o.secs.get(@int_cast(usize, xdata));
    xsec.data.align(4);
    let toff = @as(u64, xsec.data.len());
    xsec.data.put(tinfo.view());
    tinfo.free();
    ps.data.zeros(8);
    ps.relocs.push(elf.Rel.{ off: 8, ty: elf.R_AARCH64_RVA32, sym: tsym, addend: 0 });
    ps.relocs.push(elf.Rel.{ off: 12, ty: elf.R_AARCH64_RVA32, sym: xs, addend: @bit_cast(i64, toff) });
}

// The function table must be sorted by start address. It is, as the
// objects' .text and .pdata are placed in the same order; this keeps it so
// whatever the order (insertion sort: one pass when sorted).
fn sort_pdata(b: []mut u8, start: u64, end: u64) void {
    if end <= start {
        return;
    }
    let fo = @truncate(usize, file_of(start));
    let es = @truncate(usize, pdata_entry());
    let n = @truncate(usize, end - start) / es;
    for i in @as(usize, 1)..n {
        let mut j = i;
        while (j > 0) and (bn.rd32(b, fo + (j * es)) < bn.rd32(b, fo + ((j - 1) * es))) {
            for k in @as(usize, 0)..es {
                let t = b[fo + (j * es) + k];
                b[fo + (j * es) + k] = b[fo + ((j - 1) * es) + k];
                b[fo + ((j - 1) * es) + k] = t;
            }
            j -= 1;
        }
    }
}

// -----------------------------------------------------------------------------
// Tables
// -----------------------------------------------------------------------------

// The .idata section at rva: descriptors, then per DLL its lookup table, its
// address table and names. Sets iat_addr and iat_slot; returns the bytes.
fn import_section(rva: u64) bn.Bytes {
    let ndll = @as(u64, dlls.len);
    let nimp = @as(u64, imports.len);
    let desc_size = (ndll + 1) * 20;
    let ilt_at = nl.align_up(desc_size, 8);
    let table_size = (nimp + ndll) * 8;  // each DLL's list ends in a NULL
    let iat_at = ilt_at + table_size;
    let names_at = iat_at + table_size;
    iat_addr = BASE + rva + iat_at;
    for _k in 0..imports.len {
        iat_slot.push(0);
    }
    // hint/name entries and DLL names
    let mut names = bn.new_bytes();
    let hint_name = u.newn.[u64](imports.len + 1);
    let dll_name = u.newn.[u64](dlls.len + 1);
    for d in 0..dlls.len {
        let dl = dlls.get(d);
        for gi in dl.funcs.items() {
            let g = nl.gsyms.get(@as(usize, gi));
            let im = import_of(g.name);
            if u.notnil(im) and (im.ordinal >= 0) {
                // by ordinal: IMAGE_ORDINAL_FLAG64 and the number
                hint_name[@as(usize, @bit_cast(u32, g.stub))] = 0x8000_0000_0000_0000 | @bit_cast(u64, im.ordinal);
                continue;
            }
            names.align(2);
            hint_name[@as(usize, @bit_cast(u32, g.stub))] = rva + names_at + @as(u64, names.len());
            names.u16_(0);
            if u.notnil(im) {
                names.put(im.name);
            } else {
                names.put(g.name);
            }
            names.u8_(0);
        }
        names.align(2);
        dll_name[d] = rva + names_at + @as(u64, names.len());
        names.put(dl.name);
        names.u8_(0);
    }
    let mut b = bn.new_bytes();
    let mut slot: u64 = 0;
    for d in 0..dlls.len {
        let dl = dlls.get(d);
        b.u32_(rva + ilt_at + (slot * 8));  // OriginalFirstThunk
        b.u32_(0);
        b.u32_(0);
        b.u32_(dll_name[d]);
        b.u32_(rva + iat_at + (slot * 8));  // FirstThunk
        slot += @as(u64, dl.funcs.len) + 1;
    }
    b.zeros(20);
    b.align(8);
    // the lookup table, then the address table (the same until bound)
    for pass in @as(usize, 0)..2 {
        for d in 0..dlls.len {
            for gi in dlls.at(d).funcs.items() {
                let th = @as(usize, @bit_cast(u32, nl.gsyms.get(@as(usize, gi)).stub));
                if pass == 1 {
                    iat_slot.items()[th] = BASE + rva + @as(u64, b.len());
                }
                b.u64_(hint_name[th]);
            }
            b.u64_(0);
        }
    }
    b.put(names.view());
    return b;
}

// The base relocation table: blocks of 4 KiB pages, each entry a 12-bit
// offset with type 10 (DIR64).
fn reloc_section() bn.Bytes {
    let n = relocs.len;
    let rs = relocs.items();
    // sort (insertion sort over nearly sorted data)
    for i in @as(usize, 1)..n {
        let x = rs[i];
        let mut j = i;
        while (j > 0) and (rs[j - 1] > x) {
            rs[j] = rs[j - 1];
            j -= 1;
        }
        rs[j] = x;
    }
    let mut b = bn.new_bytes();
    let mut i: usize = 0;
    while i < n {
        let page = rs[i] & ~@as(u64, 0xfff);
        let mut j = i;
        while (j < n) and ((rs[j] & ~@as(u64, 0xfff)) == page) {
            j += 1;
        }
        let mut count = @as(u64, j - i);
        if (count & 1) != 0 {
            count += 1;  // pad the block to 4 bytes
        }
        b.u32_(page);
        b.u32_(8 + (count * 2));
        for k in i..j {
            b.u16_(0xa000 | (rs[k] & 0xfff));
        }
        if ((j - i) & 1) != 0 {
            b.u16_(0);
        }
        i = j;
    }
    return b;
}

fn name8(h: *mut bn.Bytes, s: []u8) void {
    for i in @as(usize, 0)..8 {
        if i < s.len {
            h.u8_(s[i]);
        } else {
            h.u8_(0);
        }
    }
}

// Links `inputs` into the executable `out`. 0: done; 1: errors (reported).
pub fn link(inputs: []*mut elf.Obj, out: []u8) i32 {
    A64 = (inputs.len > 0) and (inputs[0].machine == elf.EM_AARCH64);
    pdb.g_arm64 = A64;
    nl.begin(inputs);
    nl.g_gc_exports = g_dll;  // (--gc-sections: a DLL's exports are kept)
    n_inputs = inputs.len;
    imp_map = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    for k in 0..g_imports.len {
        let key = u.intern(g_imports.get(k).sym);
        if imp_map.get(key) == 0 {
            imp_map.put(key, @truncate(u32, k) + 1);
        }
    }
    _ = nl.lnk_sym("__ImageBase");  // (the image's base: its headers)
    own_index = nl.objs.len;
    nl.objs.push(own_object());
    nl.objs.push(jstub.build(machine(), true));  // (C's setjmp and longjmp)
    if A64 {
        // memcpy, memmove and memset, which a64.ax calls (weak: the C library's win)
        let mo = elf.new_obj(machine());
        lstub.add_mem_a64(mo, elf.add_sec(mo, ".text.axiom.mem", elf.S_TEXT, 16));
        nl.objs.push(mo);
    }
    nl.objs.push(elf.rets_bounds(machine()));
    collect_dll_names();
    collect_symbols();
    if (nl.gsyms.at(@as(usize, nl.gsym_index("main"))).obj < 0) and not g_dll {
        nl.err("no 'main' function");
    }
    nl.classify(class_of);
    scan_relocs();
    if g_dll {
        collect_exports();
    } else {
        add_import(nl.gsym_index("ExitProcess"));
    }
    let ico = read_icon();
    if nl.errors != 0 {
        return 1;
    }
    let ly = lay_out(out);
    nl.set_abs("__ImageBase", BASE);
    let mut f = bn.new_bytes();
    f.zeros(@truncate(usize, ly.file_size));
    let tls_dir = write_contents(f.view(), &ly);
    if nl.errors != 0 {
        return 1;
    }
    let image_size = add_sections(&mut f, &ly, ico);
    let mut h = pe_headers(&ly, tls_dir, image_size);
    let fv = f.view();
    let hv = h.view();
    bn.put_at(fv, 0, hv);
    let mut guid: [16]u8 = [0; 16];
    if g_pdb {
        // the GUID: a hash of the image (so the same build gives the same one)
        let h1 = fnv(fv, 0xcbf2_9ce4_8422_2325);
        let h2 = fnv(fv, 0x8422_2325_cbf2_9ce4 ^ h1);
        for k in @as(usize, 0)..8 {
            guid[k] = @truncate(u8, h1 >> @as(u64, k * 8));
            guid[k + 8] = @truncate(u8, h2 >> @as(u64, k * 8));
        }
        let r = @truncate(usize, file_of(ly.rsds_at));
        @mem_copy(fv[r + 4..r + 20], guid[..]);
    }
    if not u.write_file(out, fv) {
        nl.err(u.f1("cannot write %s", out));
        return 1;
    }
    _ = u.chmod(u.cz(out), 0o755);
    if g_pdb {
        let sh: usize = 0x40 + 4 + 20 + 240;
        let mut files = u.List.[[]u8].empty();
        let pin = pdb_input(ly.text_rva, &mut files);
        if not pdb.write(pdb_file_of(out), guid[..], 1, hv[sh..sh + @truncate(usize, ly.nsec * 40)], files.items(),
                         pin.funcs.items(), pin.mods.items(), pin.tpi.items(), pin.ipi.items()) {
            nl.err(u.f1("cannot write %s", pdb_file_of(out)));
            return 1;
        }
    }
    return 0;
}

// The icon file (--icon), checked; nosym if none.
fn read_icon() []u8 {
    let mut ico = u.nosym();
    if g_icon.len > 0 {
        ico = u.read_file(g_icon);
        if u.isnos(ico) {
            nl.err(u.f1("cannot read the icon %s", g_icon));
        } else if not ico_valid(ico) {
            nl.err(u.f1("%s is not a Windows icon file (.ico)", g_icon));
        }
    }
    return ico;
}

// Where the link puts things (beyond outs and the addresses relocation
// uses).
struct Layout {
    nsec: u64,     // sections
    headers: u64,  // the headers' size
    text_rva: u64,
    pdata_start: u64,  // the function table
    pdata_end: u64,
    debug_at: u64,  // the debug directory
    rsds_at: u64,   // its CodeView record
    pdb_path: []u8,
    rdata_end: u64,
    idata: bn.Bytes,
    tls_align: u64,
    tls_end: u64,  // the thread-local template's end
    data_file_end: u64,
    bss_end: u64,
    file_size: u64,  // without .reloc and .rsrc
    export_at: u64,  // a DLL's export directory
    dll_name: []u8,
}

// Places the sections (outs[0..4]) and what they hold.
fn lay_out(out: []u8) Layout {
    let mut nsec: u64 = 5;
    if g_icon.len > 0 {
        nsec = 6;
    }
    let headers = nl.align_up(0x40 + 4 + 20 + 240 + (nsec * 40), FILEAL);

    // .text: code, then the import thunks
    let text_rva = nl.align_up(headers, SECT);
    let code_end = nl.place(nl.C_TEXT, BASE + text_rva);
    thunk_addr = nl.align_up(code_end, 8);
    let text_end = thunk_addr + (@as(u64, imports.len) * thunk_size());
    // .rdata
    let rdata_rva = nl.align_up(text_end - BASE, SECT);
    let pdata_start = nl.align_up(nl.place(nl.C_CONST, BASE + rdata_rva), 4);
    let pdata_end = nl.place(C_PDATA, pdata_start);
    // the debug directory: one CodeView entry, and its record (RSDS, the
    // GUID, the age, the PDB's path)
    let pdb_path = pdb_path_of(out);
    let debug_at = nl.align_up(pdata_end, 4);
    let rsds_at = debug_at + 28;
    let mut rdata_end = pdata_end;
    if g_pdb {
        rdata_end = rsds_at + 24 + @as(u64, pdb_path.len) + 1;
    }
    // a DLL's export directory
    let export_at = nl.align_up(rdata_end, 4);
    if g_dll {
        rdata_end = export_at + export_size(basename(out));
    }
    // .idata
    let idata_rva = nl.align_up(rdata_end - BASE, SECT);
    let idata = import_section(idata_rva);
    // .data: the thread-local template (first: a thread-local's offset in
    // the section is its offset in each thread's block, as the PDB's
    // S_GTHREAD32 records give it), data, the GOT, then .bss
    let data_rva = nl.align_up(idata_rva + @as(u64, idata.len()), SECT);
    let tls_align = @max(@max(nl.class_align(nl.C_TDATA), nl.class_align(nl.C_TBSS)), 16);
    tls_addr = nl.align_up(BASE + data_rva, tls_align);
    let tdata_end = nl.place(nl.C_TDATA, tls_addr);
    let tbss_start = nl.align_up(tdata_end, nl.class_align(nl.C_TBSS));
    // .tbss is part of the template, as zeros in the file: the Windows loader
    // ignores the TLS directory's SizeOfZeroFill (it allocates and copies
    // only the template, so zero-fill variables would be past the end of
    // each thread's block)
    let tls_end = nl.place(nl.C_TBSS, tbss_start);
    let mut cur = nl.place(nl.C_DATA, nl.align_up(tls_end, nl.class_align(nl.C_DATA)));
    got_addr = nl.align_up(cur, 8);
    cur = got_addr + (@as(u64, nl.got_sym.len) * 8);
    let data_file_end = cur;
    let bss_end = nl.place(nl.C_BSS, nl.align_up(cur, nl.class_align(nl.C_BSS)));

    outs[0] = Out.{ name: ".text", rva: text_rva, vsize: text_end - (BASE + text_rva), fsize: 0, foff: 0,
                    flags: 0x6000_0020 };
    outs[1] = Out.{ name: ".rdata", rva: rdata_rva, vsize: rdata_end - (BASE + rdata_rva), fsize: 0, foff: 0,
                    flags: 0x4000_0040 };
    outs[2] = Out.{ name: ".idata", rva: idata_rva, vsize: @as(u64, idata.len()), fsize: 0, foff: 0,
                    flags: 0xc000_0040 };
    outs[3] = Out.{ name: ".data", rva: data_rva, vsize: bss_end - (BASE + data_rva), fsize: 0, foff: 0,
                    flags: 0xc000_0040 };
    outs[0].fsize = outs[0].vsize;
    outs[1].fsize = outs[1].vsize;
    outs[2].fsize = outs[2].vsize;
    outs[3].fsize = data_file_end - (BASE + data_rva);
    let mut foff = headers;
    for k in @as(usize, 0)..4 {
        outs[k].foff = foff;
        foff += nl.align_up(outs[k].fsize, FILEAL);
    }
    return Layout.{ nsec: nsec, headers: headers, text_rva: text_rva, pdata_start: pdata_start, pdata_end: pdata_end,
                    debug_at: debug_at, rsds_at: rsds_at, pdb_path: pdb_path, rdata_end: rdata_end, idata: idata,
                    tls_align: tls_align, tls_end: tls_end, data_file_end: data_file_end, bss_end: bss_end,
                    file_size: foff, export_at: export_at, dll_name: basename(out) };
}

// The sections' contents in b (the file without .reloc and .rsrc),
// relocated, with the import thunks, the GOT, the debug directory and the
// TLS directory; returns the TLS directory's address.
fn write_contents(b: []mut u8, ly: *Layout) u64 {
    nl.copy_class(b, nl.C_TEXT, file_of);
    nl.copy_class(b, nl.C_CONST, file_of);
    nl.copy_class(b, C_PDATA, file_of);
    nl.copy_class(b, nl.C_DATA, file_of);
    nl.copy_class(b, nl.C_TDATA, file_of);
    bn.put_at(b, outs[2].foff, ly.idata.view());
    if g_dll {
        write_exports(b, ly.export_at, ly.dll_name);
    }
    // the import address table holds addresses only once bound: base
    // relocations do not apply to it
    // thunks: jmp [rip + slot] (ARM64: adrp x16, slot; ldr x16, [x16, slot's
    // offset in its page]; br x16)
    for k in 0..imports.len {
        let at = thunk_addr + (@as(u64, k) * thunk_size());
        if A64 {
            let fo = file_of(at);
            let slot = iat_slot.get(k);
            bn.w32(b, fo, 0x9000_0010);
            nl.a64_adrp(b, fo, at, slot);
            bn.w32(b, fo + 4, 0xf940_0210);
            nl.a64_imm12(b, fo + 4, (slot & 0xfff) >> 3);
            bn.w32(b, fo + 8, 0xd61f_0200);
            continue;
        }
        let fo = @truncate(usize, file_of(at));
        b[fo] = 0xff;
        b[fo + 1] = 0x25;
        rel32(b, at + 2, iat_slot.get(k) - 4);
        b[fo + 6] = 0xcc;
        b[fo + 7] = 0xcc;
    }
    // GOT slots: the addresses of our own symbols
    for k in 0..nl.got_sym.len {
        abs_at(b, got_addr + (@as(u64, k) * 8), sym_addr(@as(usize, nl.got_obj.get(k)), nl.got_sym.get(k)));
    }
    apply_relocs(b);
    nl.sort_rets(b, file_of);
    sort_pdata(b, ly.pdata_start, ly.pdata_end);
    if g_pdb {
        // IMAGE_DEBUG_DIRECTORY: characteristics, time, version, type
        // (CODEVIEW), size, address, file offset
        let at = file_of(ly.debug_at);
        bn.w32(b, at + 12, 2);
        bn.w32(b, at + 16, ly.rdata_end - ly.rsds_at);
        bn.w32(b, at + 20, ly.rsds_at - BASE);
        bn.w32(b, at + 24, file_of(ly.rsds_at));
        let r = file_of(ly.rsds_at);
        bn.put_at(b, r, "RSDS");
        bn.w32(b, r + 20, 1);  // age; the GUID (at 4) once the image is done
        bn.put_at(b, r + 24, ly.pdb_path);
    }
    // the TLS directory: the template, the index's address, the (empty)
    // callback list, the zero fill, the alignment
    // (the linker's own object's: not the last, the frame tables' bounds follow it)
    let dir = nl.sym_addr_in(own_index, own_tls_dir);
    let tls_index = nl.global_addr("axiom.tls_index");
    abs_at(b, dir, tls_addr);
    abs_at(b, dir + 8, ly.tls_end);
    abs_at(b, dir + 16, tls_index);
    abs_at(b, dir + 24, tls_index + 8);
    bn.w32(b, file_of(dir + 32), 0);  // SizeOfZeroFill
    let mut al_bits: u64 = 1;
    while (@as(u64, 1) << (al_bits - 1)) < ly.tls_align {
        al_bits += 1;
    }
    bn.w32(b, file_of(dir + 36), al_bits << 20);
    return dir;
}

// Appends .reloc (outs[4]) and, with an icon, .rsrc (outs[5]) to the file;
// returns the image's size.
fn add_sections(f: *mut bn.Bytes, ly: *Layout, ico: []u8) u64 {
    let rel = reloc_section();
    let reloc_rva = nl.align_up(outs[3].rva + outs[3].vsize, SECT);
    outs[4] = Out.{ name: ".reloc", rva: reloc_rva, vsize: @as(u64, rel.len()), fsize: @as(u64, rel.len()),
                    foff: ly.file_size, flags: 0x4200_0040 };
    f.put(rel.view());
    f.zeros(@truncate(usize, nl.align_up(@as(u64, f.len()), FILEAL) - @as(u64, f.len())));
    let mut image_size = nl.align_up(reloc_rva + outs[4].vsize, SECT);
    if ly.nsec == 6 {
        let rsrc_rva = image_size;
        let res = icon_resources(ico, rsrc_rva);
        outs[5] = Out.{ name: ".rsrc", rva: rsrc_rva, vsize: @as(u64, res.len()), fsize: @as(u64, res.len()),
                        foff: @as(u64, f.len()), flags: 0x4000_0040 };
        f.put(res.view());
        f.zeros(@truncate(usize, nl.align_up(@as(u64, f.len()), FILEAL) - @as(u64, f.len())));
        image_size = nl.align_up(rsrc_rva + outs[5].vsize, SECT);
    }
    return image_size;
}

// The headers: MS-DOS stub, PE signature, COFF file header, optional header
// (with the data directories), section table.
fn pe_headers(ly: *Layout, tls_dir: u64, image_size: u64) bn.Bytes {
    let mut h = bn.new_bytes();
    h.u8_('M');
    h.u8_('Z');
    h.zeros(0x3a);
    h.u32_(0x40);  // e_lfanew
    h.u8_('P');
    h.u8_('E');
    h.u16_(0);
    // COFF file header
    if A64 {
        h.u16_(0xaa64);  // IMAGE_FILE_MACHINE_ARM64
    } else {
        h.u16_(0x8664);  // IMAGE_FILE_MACHINE_AMD64
    }
    h.u16_(ly.nsec);
    h.u32_(0);  // TimeDateStamp (deterministic builds)
    h.u32_(0);
    h.u32_(0);
    h.u16_(240);  // SizeOfOptionalHeader
    // EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE (| DLL)
    if g_dll {
        h.u16_(0x2022);
    } else {
        h.u16_(0x0022);
    }
    // optional header (PE32+)
    h.u16_(0x20b);
    h.u8_(14);
    h.u8_(0);
    h.u32_(nl.align_up(outs[0].vsize, FILEAL));  // SizeOfCode
    let init_size = nl.align_up(outs[1].fsize, FILEAL) + nl.align_up(outs[2].fsize, FILEAL);
    h.u32_((init_size + nl.align_up(outs[3].fsize, FILEAL)) + nl.align_up(outs[5].fsize, FILEAL));  // initialized
    h.u32_(ly.bss_end - ly.data_file_end);  // uninitialized
    h.u32_(nl.global_addr(u.pick(g_dll, "axiom.dll_entry", "axiom.entry")) - BASE);
    h.u32_(ly.text_rva);  // BaseOfCode
    h.u64_(BASE);
    h.u32_(SECT);
    h.u32_(FILEAL);
    // (operating system and subsystem versions: 6.0, Vista, on x86-64; 6.2,
    // the first with ARM64's predecessor, on ARM64, as its loader expects)
    let mut minor: u64 = 0;
    if A64 {
        minor = 2;
    }
    h.u16_(6);  // operating system version
    h.u16_(minor);
    h.u16_(0);  // image version
    h.u16_(0);
    h.u16_(6);  // subsystem version
    h.u16_(minor);
    h.u32_(0);
    h.u32_(image_size);
    h.u32_(ly.headers);
    h.u32_(0);  // CheckSum
    h.u16_(g_subsystem);
    h.u16_(0x8160);  // HIGH_ENTROPY_VA | DYNAMIC_BASE | NX_COMPAT | TERMINAL_SERVER_AWARE
    // the stack: --stack-size or 8 MiB reserved (as on Linux), the
    // default for the program's threads too (CreateThread with no size);
    // 64 KiB committed at first, the rest as the guard page moves down
    let mut reserve = STACK_RESERVE;
    if nl.g_stack_size != 0 {
        reserve = nl.align_up(nl.g_stack_size, 0x10000);
    }
    h.u64_(reserve);
    h.u64_(@min(reserve, 0x10000));  // stack commit
    h.u64_(0x10_0000);
    h.u64_(0x1000);
    h.u32_(0);
    h.u32_(16);
    // data directories
    let ndll = @as(u64, dlls.len);
    for d in @as(u64, 0)..16 {
        if (d == 0) and g_dll {
            h.u32_(ly.export_at - BASE);
            h.u32_(export_size(ly.dll_name));
        } else if d == 1 {
            h.u32_(outs[2].rva);
            h.u32_((ndll + 1) * 20);
        } else if d == 3 {
            // exceptions: the function table, without which the system
            // cannot walk the stack through our code
            h.u32_(ly.pdata_start - BASE);
            h.u32_(ly.pdata_end - ly.pdata_start);
        } else if (d == 6) and g_pdb {
            h.u32_(ly.debug_at - BASE);
            h.u32_(28);
        } else if (d == 2) and (ly.nsec == 6) {
            h.u32_(outs[5].rva);
            h.u32_(outs[5].vsize);
        } else if d == 5 {
            h.u32_(outs[4].rva);
            h.u32_(outs[4].vsize);
        } else if d == 9 {
            h.u32_(tls_dir - BASE);
            h.u32_(40);
        } else if d == 12 {
            h.u32_(iat_addr - BASE);
            h.u32_((@as(u64, imports.len) + ndll) * 8);
        } else {
            h.u32_(0);
            h.u32_(0);
        }
    }
    for k in @as(usize, 0)..@truncate(usize, ly.nsec) {
        let o = outs[k];
        name8(&mut h, o.name);
        h.u32_(o.vsize);
        h.u32_(o.rva);
        h.u32_(nl.align_up(o.fsize, FILEAL));
        if o.fsize == 0 {
            h.u32_(0);
        } else {
            h.u32_(o.foff);
        }
        h.u32_(0);
        h.u32_(0);
        h.u16_(0);
        h.u16_(0);
        h.u32_(o.flags);
    }
    return h;
}

// An icon file: ICONDIR (reserved 0, type 1, count), then per image a
// 16-byte ICONDIRENTRY (width, height, colours, reserved, planes, bits per
// pixel, size, offset) whose bytes lie in the file.
fn ico_valid(ico: []u8) bool {
    if (ico.len < 6) or (bn.rd16(ico, 0) != 0) or (bn.rd16(ico, 2) != 1) {
        return false;
    }
    let n = @truncate(usize, bn.rd16(ico, 4));
    if (n == 0) or (ico.len < (6 + (n * 16))) {
        return false;
    }
    for i in 0..n {
        let e = 6 + (i * 16);
        let size = bn.rd32(ico, e + 8);
        let at = bn.rd32(ico, e + 12);
        if (size == 0) or ((at + size) > @as(u64, ico.len)) {
            return false;
        }
    }
    return true;
}

// The resource section at rva for an icon file's n images: the type
// directory (RT_ICON 3, RT_GROUP_ICON 14), a name directory for each (icons
// 1..n; the group 1), a language directory per resource (US English), a data
// entry per resource, then the group's GRPICONDIR (the ICONDIRENTRYs with an
// icon's id in place of its offset) and the images, 8-byte aligned. A
// directory's entries point at subdirectories (high bit set) or data entries
// by their offset in the section; a data entry at its bytes by RVA.
fn icon_resources(ico: []u8, rva: u64) bn.Bytes {
    let n = bn.rd16(ico, 4);
    let root: u64 = 0;
    let icons_dir = root + 16 + 16;
    let group_dir = icons_dir + 16 + (n * 8);
    let langs = group_dir + 16 + 8;        // n + 1 language directories, 24 bytes each
    let entries = langs + ((n + 1) * 24);  // n + 1 data entries, 16 bytes each
    let group = entries + ((n + 1) * 16);
    let group_size = 6 + (n * 14);
    let mut image_at = u.List.[u64].empty();
    let mut at = nl.align_up(group + group_size, 8);
    for i in @as(u64, 0)..n {
        image_at.push(at);
        at = nl.align_up(at + bn.rd32(ico, @truncate(usize, 6 + (i * 16) + 8)), 8);
    }
    let mut r = bn.new_bytes();
    // the type directory: two id entries
    dir_header(&mut r, 2);
    r.u32_(3);
    r.u32_(0x8000_0000 | icons_dir);
    r.u32_(14);
    r.u32_(0x8000_0000 | group_dir);
    // the icons' names: 1..n
    dir_header(&mut r, n);
    for i in @as(u64, 0)..n {
        r.u32_(i + 1);
        r.u32_(0x8000_0000 | (langs + (i * 24)));
    }
    // the group's name: 1
    dir_header(&mut r, 1);
    r.u32_(1);
    r.u32_(0x8000_0000 | (langs + (n * 24)));
    // a language for each resource
    for i in @as(u64, 0)..(n + 1) {
        dir_header(&mut r, 1);
        r.u32_(0x409);
        r.u32_(entries + (i * 16));
    }
    // the data entries: RVA, size, code page, reserved
    for i in @as(u64, 0)..n {
        r.u32_(rva + image_at.get(@truncate(usize, i)));
        r.u32_(bn.rd32(ico, @truncate(usize, 6 + (i * 16) + 8)));
        r.u32_(0);
        r.u32_(0);
    }
    r.u32_(rva + group);
    r.u32_(group_size);
    r.u32_(0);
    r.u32_(0);
    // GRPICONDIR
    r.u16_(0);
    r.u16_(1);
    r.u16_(n);
    for i in @as(u64, 0)..n {
        let e = @truncate(usize, 6 + (i * 16));
        r.put(ico[e..e + 12]);
        r.u16_(i + 1);
    }
    for i in @as(u64, 0)..n {
        r.zeros(@truncate(usize, image_at.get(@truncate(usize, i)) - @as(u64, r.len())));
        let e = @truncate(usize, 6 + (i * 16));
        let size = @truncate(usize, bn.rd32(ico, e + 8));
        let off = @truncate(usize, bn.rd32(ico, e + 12));
        r.put(ico[off..off + size]);
    }
    return r;
}

// IMAGE_RESOURCE_DIRECTORY: characteristics, time, version, no named
// entries, `ids` id entries.
fn dir_header(r: *mut bn.Bytes, ids: u64) void {
    r.u32_(0);
    r.u32_(0);
    r.u32_(0);
    r.u16_(0);
    r.u16_(ids);
}

fn fnv(b: []u8, seed: u64) u64 {
    let mut h = seed;
    for c in b {
        h = (h ^ @as(u64, c)) *% 0x100_0000_01b3;
    }
    return h;
}

// The PDB's file: the executable's name with .pdb for .exe.
fn pdb_file_of(out: []u8) []u8 {
    if u.ends(out, ".exe") or u.ends(out, ".EXE") {
        return u.cat2(out[0..out.len - 4], ".pdb");
    }
    return u.cat2(out, ".pdb");
}

// The path in the debug directory: the PDB's absolute path, with Windows
// separators when it has a drive letter (debuggers also look for it by name
// next to the executable).
fn pdb_path_of(out: []u8) []u8 {
    let f = pdb_file_of(out);
    let mut p = f;
    if not u.starts(f, "/") and not ((f.len > 1) and (f[1] == ':')) {
        p = u.f2("%s/%s", u.cwd(), f);
    }
    return windows_path(p);
}

// A path with Windows separators when it has a drive letter (a copy).
fn windows_path(p: []u8) []u8 {
    let w = u.newn.[u8](p.len);
    @mem_copy(w, p);
    if (p.len > 1) and (p[1] == ':') {
        for i in 0..w.len {
            if w[i] == '/' {
                w[i] = '\\';
            }
        }
    }
    return w;
}

fn basename(p: []u8) []u8 {
    let mut i = p.len;
    while (i > 0) and (p[i - 1] != '/') and (p[i - 1] != '\\') {
        i -= 1;
    }
    return p[i..];
}

// What the PDB holds of the objects: every function the image holds
// (defined in code, the copy kept of a function more than one object
// defines), with its line table from the object's .axiom.lines (x64.ax,
// a64.ax), its files added to `files`, and its symbols from the object's
// .axiom.cv (codeview.ax) where it has them (-g); a module per object with
// functions or symbols; the objects' types and ids, merged.
struct PdbIn {
    funcs: u.List.[pdb.Func],
    mods: u.List.[pdb.Mod],
    tpi: u.List.[[]u8],
    ipi: u.List.[[]u8],
}

fn pdb_input(text_rva: u64, files: *mut u.List.[[]u8]) PdbIn {
    let mut r = PdbIn.{ funcs: u.List.[pdb.Func].empty(), mods: u.List.[pdb.Mod].empty(), tpi: u.List.[[]u8].empty(),
                        ipi: u.List.[[]u8].empty() };
    let mut file_map = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    let mut tdedup = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    let mut idedup = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    for oi in 0..nl.objs.len {
        let o = nl.objs.get(oi);
        let mut local = u.List.[u32].empty();
        let mut lines = object_lines(o, files, &mut file_map, &mut local);
        let mut cv = CvObj.{ blobs: u.List.[CvBlob].empty(), tmap: u.List.[u32].empty(), imap: u.List.[u32].empty(),
                             names: u.List.[[]u8].empty(), oi: oi, files: local.items() };
        cv_read(o, &mut cv);
        // the types, then the ids (which refer to types)
        for bl in cv.blobs.items() {
            if bl.tag == 'T' {
                merge_records(&bl, &mut cv, false, &mut r.tpi, &mut tdedup);
            }
        }
        for bl in cv.blobs.items() {
            if bl.tag == 'I' {
                merge_records(&bl, &mut cv, true, &mut r.ipi, &mut idedup);
            } else if bl.tag == 'N' {
                cv.names.push(bl.name);
            }
        }
        let mut procs = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
        for k in 0..cv.blobs.len {
            if cv.blobs.get(k).tag == 'P' {
                procs.put(u.intern(cv.blobs.get(k).name), @truncate(u32, k) + 1);
            }
        }
        let mi = @truncate(u32, r.mods.len);
        let nf = r.funcs.len;
        // one function per place: of the names of one (an alias, a weak
        // definition's default) the one its line table or symbols are under,
        // else the first
        let mut place = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
        for si in 0..o.syms.len {
            let sy = o.syms.at(si);
            if (sy.ty != elf.T_FUNC) or (sy.sec < 0) or (sy.name.len == 0) or lost_copy(oi, si) {
                continue;
            }
            let pk = u.intern(u.f2("%s:%s", u.idec(sy.sec), u.hex16(sy.value)));
            let fk = u.intern(cvw.func_key(sy.name, sy.value));
            if (place.get(pk) == 0) or u.notnil(lines.get(fk)) or (procs.get(fk) != 0) {
                place.put(pk, @truncate(u32, si) + 1);
            }
        }
        for si in 0..o.syms.len {
            let sy = o.syms.at(si);
            if (sy.ty != elf.T_FUNC) or (sy.sec < 0) or (sy.name.len == 0) {
                continue;
            }
            if place.get(u.intern(u.f2("%s:%s", u.idec(sy.sec), u.hex16(sy.value)))) != @truncate(u32, si) + 1 {
                continue;  // (another name of the function)
            }
            if nl.sec_cls.get(oi)[@as(usize, @bit_cast(u32, sy.sec))] != nl.C_TEXT {
                continue;
            }
            let gi = nl.global_of(oi, @truncate(u32, si));
            if gi >= 0 {
                let g = nl.gsyms.at(@int_cast(usize, gi));
                if (g.obj != @int_cast(i32, oi)) or (g.sym != @truncate(u32, si)) {
                    continue;
                }
            }
            let addr = nl.sym_addr_in(oi, @truncate(u32, si));
            let mut ls = u.nil_slice.[pdb.Line]();
            let name = elf.display_name(sy.name);
            let found = lines.get(u.intern(cvw.func_key(sy.name, sy.value)));  // (by its symbol: winlines.emit)
            if u.notnil(found) {
                ls = found.items();
            }
            let off = @truncate(u32, addr - BASE - text_rva);
            let mut f = pdb.Func.{ name: name, sec: 1, off: off, size: @truncate(u32, sy.size), lines: ls,
                                   syms: u.nil_slice.[u8](), self_fix: u.nil_slice.[u32](), module: mi,
                                   external: sy.bind != elf.B_LOCAL, file_fix: u.nil_slice.[u32]() };
            let bk = procs.get(u.intern(cvw.func_key(sy.name, sy.value)));
            if bk != 0 {
                let p = patch_syms(cv.blobs.at(@as(usize, bk - 1)), &cv, off);
                f.syms = p.data;
                f.self_fix = p.self_fix;
                f.file_fix = p.file_fix;
            }
            r.funcs.push(f);
        }
        let mut gs: []u8 = u.nil_slice.[u8]();
        for k in 0..cv.blobs.len {
            if cv.blobs.get(k).tag == 'G' {
                gs = patch_syms(cv.blobs.at(k), &cv, 0).data;
            }
        }
        // the functions inlined: their ids, files and lines ('L': codeview.ax)
        let mut inl = u.List.[u32].empty();
        for k in 0..cv.blobs.len {
            let bl = cv.blobs.get(k);
            if (bl.tag == 'L') and (bl.data.len >= 12) {
                inl.push(@truncate(u32, remap(&cv, cvw.FK_ID, bn.rd32(bl.data, 0))));
                inl.push(cv_file(&cv, bn.rd32(bl.data, 4)));
                inl.push(@truncate(u32, bn.rd32(bl.data, 8)));
            }
        }
        if (r.funcs.len > nf) or (gs.len > 0) {
            r.mods.push(pdb.Mod.{ name: module_name(r.funcs.items()[nf..], files.items(), mi), syms: gs,
                                  inlinees: inl.items() });
        }
    }
    return r;
}

// A module's name: the file of its first line, or one made up.
fn module_name(fs: []pdb.Func, files: [][]u8, mi: u32) []u8 {
    for f in fs {
        if f.lines.len > 0 {
            return files[@as(usize, f.lines[0].file)];
        }
    }
    return u.f1("axiom-module-%s", u.idec(@bit_cast(i32, mi)));
}

// Is symbol si of object oi a global one whose definition the link did not
// keep (another object's won)?
fn lost_copy(oi: usize, si: usize) bool {
    let gi = nl.global_of(oi, @truncate(u32, si));
    if gi < 0 {
        return false;
    }
    let g = nl.gsyms.at(@int_cast(usize, gi));
    return (g.obj != @int_cast(i32, oi)) or (g.sym != @truncate(u32, si));
}

// An object's .axiom.cv, read (codeview.ax describes it).
struct CvFix {
    off: u32,
    kind: u8,
    arg: u32,
}

struct CvBlob {
    tag: u8,
    name: []u8,
    data: []u8,
    fx: []CvFix,
}

struct CvObj {
    blobs: u.List.[CvBlob],
    tmap: u.List.[u32],    // the object's type index - 0x1000 -> the program's
    imap: u.List.[u32],    // and its ids'
    names: u.List.[[]u8],  // its data symbols' names (FK_DATA's arguments)
    oi: usize,
    files: []u32,  // its line tables' file numbers -> the program's files (FK_FILE)
}

// The program's file of the object's line-table file k (FK_FILE).
fn cv_file(cv: *CvObj, k: u64) u32 {
    if k >= @as(u64, cv.files.len) {
        nl.err("internal: a debug file number out of range");
        return 0;
    }
    return cv.files[@truncate(usize, k)];
}

fn cv_read(o: *mut elf.Obj, cv: *mut CvObj) void {
    for k in 0..o.secs.len {
        let sec = o.secs.get(k);
        if (sec.kind != elf.S_DEBUG) or not u.str_eq(sec.name, ".axiom.cv") {
            continue;
        }
        let d = sec.data.view();
        let mut at: usize = 0;
        while (at + 13) <= d.len {
            let tag = d[at];
            let nn = @truncate(usize, bn.rd32(d, at + 1));
            let name = d[at + 5..at + 5 + nn];
            at += 5 + nn;
            let nd = @truncate(usize, bn.rd32(d, at));
            let data = d[at + 4..at + 4 + nd];
            at += 4 + nd;
            let nfx = @truncate(usize, bn.rd32(d, at));
            at += 4;
            let fx = u.newn.[CvFix](nfx + 1);
            for j in 0..nfx {
                let b = at + (j * 9);
                fx[j] = CvFix.{
                    off: @truncate(u32, bn.rd32(d, b)), kind: d[b + 4], arg: @truncate(u32, bn.rd32(d, b + 5)) };
            }
            at += nfx * 9;
            cv.blobs.push(CvBlob.{ tag: tag, name: name, data: data, fx: fx[0..nfx] });
        }
    }
}

// An index of the object's (a type's: FK_TYPE, an id's: FK_ID) in the program.
fn remap(cv: *CvObj, kind: u8, v: u64) u64 {
    if v < 0x1000 {
        return v;
    }
    let k = @truncate(usize, v - 0x1000);
    let m = pick_list(kind == cvw.FK_ID, &cv.imap, &cv.tmap);
    if k >= m.len {
        nl.err("internal: a debug type index out of range");
        return 0;
    }
    return @as(u64, m.get(k));
}

fn pick_list(c: bool, a: *u.List.[u32], b: *u.List.[u32]) *u.List.[u32] {
    if c {
        return a;
    }
    return b;
}

// Adds the object's type (ids: id) records of blob bl to the program's
// `out`, the same record once (dedup: its bytes -> its index): their
// indexes, in the object's map.
fn merge_records(bl: *CvBlob, cv: *mut CvObj, ids: bool, out: *mut u.List.[[]u8], dedup: *mut u.SymMap.[u32]) void {
    let d = bl.data;
    let mut at: usize = 0;
    let mut j: usize = 0;
    while (at + 4) <= d.len {
        let n = @truncate(usize, bn.rd16(d, at)) + 2;
        let r = u.newn.[u8](n);
        @mem_copy(r, d[at..at + n]);
        while (j < bl.fx.len) and (@as(usize, bl.fx[j].off) < (at + n)) {
            let x = bl.fx[j];
            let o = @as(usize, x.off) - at;
            bn.w32(r, @as(u64, o), remap(cv, x.kind, bn.rd32(r, o)));
            j += 1;
        }
        let key = u.intern(r);
        let mut idx = dedup.get(key);
        if idx == 0 {
            out.push(key);
            idx = 0x1000 + @truncate(u32, out.len) - 1;
            dedup.put(key, idx);
        }
        if ids {
            cv.imap.push(idx);
        } else {
            cv.tmap.push(idx);
        }
        at += n;
    }
}

// A symbol blob with its fixups applied (a function's at offset `off` of
// .text): the records whose data no longer is in the image left out, the
// blob's own references (FK_SELF, made offsets in the new blob) for pdb.ax
// to make offsets in the module's stream.
// (file_fix: where it holds a file of the program, FK_FILE, for pdb.ax to
// make the offset of its checksum entry)
struct Patched {
    data: []u8,
    self_fix: []u32,
    file_fix: []u32,
}

fn patch_syms(bl: *CvBlob, cv: *CvObj, off: u32) Patched {
    let d = bl.data;
    // the records, and which are kept
    let mut starts = u.List.[usize].empty();
    let mut at: usize = 0;
    while (at + 4) <= d.len {
        starts.push(at);
        at += @truncate(usize, bn.rd16(d, at)) + 2;
    }
    starts.push(d.len);
    let keep = u.newn.[bool](starts.len + 1);
    let addr = u.newn.[u64](bl.fx.len + 1);
    for k in 0..starts.len {
        keep[k] = true;
    }
    let mut ri: usize = 0;
    for j in 0..bl.fx.len {
        let x = bl.fx[j];
        while ((ri + 1) < starts.len) and (starts.get(ri + 1) <= @as(usize, x.off)) {
            ri += 1;
        }
        if x.kind == cvw.FK_DATA {
            addr[j] = data_addr(cv, x.arg);
            if addr[j] == 0 {
                keep[ri] = false;  // (a datum not in the image)
            }
        }
    }
    // the new offsets of the records
    let newat = u.newn.[usize](starts.len + 1);
    let mut size: usize = 0;
    for k in 0..starts.len {
        newat[k] = size;
        if (k + 1) < starts.len and keep[k] {
            size += starts.get(k + 1) - starts.get(k);
        }
    }
    let out = u.newn.[u8](size + 1);
    let mut self_fix = u.List.[u32].empty();
    let mut file_fix = u.List.[u32].empty();
    let mut j: usize = 0;
    for k in 0..(starts.len - 1) {
        let a = starts.get(k);
        let e = starts.get(k + 1);
        let at2 = newat[k];
        while (j < bl.fx.len) and (@as(usize, bl.fx[j].off) < a) {
            j += 1;
        }
        if not keep[k] {
            continue;
        }
        let r = out[at2..at2 + (e - a)];
        @mem_copy(r, d[a..e]);
        while (j < bl.fx.len) and (@as(usize, bl.fx[j].off) < e) {
            let x = bl.fx[j];
            let o = @as(usize, x.off) - a;
            let v = bn.rd32(r, o);
            if (x.kind == cvw.FK_TYPE) or (x.kind == cvw.FK_ID) {
                bn.w32(r, @as(u64, o), remap(cv, x.kind, v));
            } else if x.kind == cvw.FK_CODE {
                bn.w32(r, @as(u64, o), v + @as(u64, off));
                bn.w16(r, @as(u64, o + 4), 1);
            } else if x.kind == cvw.FK_DATA {
                let so = sec_off(addr[j] - BASE);
                bn.w32(r, @as(u64, o), so & 0xffff_ffff);
                bn.w16(r, @as(u64, o + 4), so >> 32);
            } else if x.kind == cvw.FK_SELF {
                // (an offset of a record in the blob)
                let mut t: usize = 0;
                while (t < starts.len) and (starts.get(t) < @truncate(usize, v)) {
                    t += 1;
                }
                bn.w32(r, @as(u64, o), @as(u64, newat[t]));
                self_fix.push(@truncate(u32, at2 + o));
            } else if x.kind == cvw.FK_FILE {
                bn.w32(r, @as(u64, o), @as(u64, cv_file(cv, @as(u64, x.arg))));
                file_fix.push(@truncate(u32, at2 + o));
            }
            j += 1;
        }
    }
    starts.deinit();
    return Patched.{ data: out[0..size], self_fix: self_fix.items(), file_fix: file_fix.items() };
}

// The address of the object's data symbol named by its 'N' blob `k`
// (0: not in the image).
fn data_addr(cv: *CvObj, k: u32) u64 {
    if @as(usize, k) >= cv.names.len {
        return 0;
    }
    let name = cv.names.get(@as(usize, k));
    let o = nl.objs.get(cv.oi);
    for si in 0..o.syms.len {
        let sy = o.syms.at(si);
        if (sy.sec < 0) or not u.str_eq(sy.name, name) {
            continue;
        }
        if nl.sec_cls.get(cv.oi)[@as(usize, @bit_cast(u32, sy.sec))] == C_NONE {
            return 0;
        }
        return nl.sym_addr(cv.oi, @truncate(u32, si));
    }
    return 0;
}

// An image address's (an RVA's) section number << 32 | offset in it.
fn sec_off(rva: u64) u64 {
    for k in 0..outs.len {
        let o = outs[k];
        if (o.vsize > 0) and (rva >= o.rva) and (rva < (o.rva + o.vsize)) {
            return ((@as(u64, k) + 1) << 32) | (rva - o.rva);
        }
    }
    return 0;
}

// An object's line tables (.axiom.lines: winlines.ax), by function (its
// symbol's place: codeview.func_key); file numbers become indexes in `files`.
// (local: the object's file number -> index)
fn object_lines(o: *mut elf.Obj, files: *mut u.List.[[]u8], file_map: *mut u.SymMap.[u32],
                local: *mut u.List.[u32]) u.SymMap.[*mut u.List.[pdb.Line]] {
    let mut m = u.SymMap.[*mut u.List.[pdb.Line]].{ keys: u.nil.[usize](), vals: u.nil.[*mut u.List.[pdb.Line]](),
                                                    cap: 0, len: 0 };
    for k in 0..o.secs.len {
        let sec = o.secs.get(k);
        if (sec.kind != elf.S_DEBUG) or not u.str_eq(sec.name, ".axiom.lines") {
            continue;
        }
        let d = sec.data.view();
        let mut at: usize = 0;
        while (at + 5) <= d.len {
            let tag = d[at];
            let n = @truncate(usize, bn.rd32(d, at + 1));
            let name = d[at + 5..at + 5 + n];
            at += 5 + n;
            if tag == 'F' {
                let key = u.intern(name);
                let mut idx = file_map.get(key);
                if idx == 0 {
                    files.push(windows_path(name));
                    idx = @truncate(u32, files.len);
                    file_map.put(key, idx);
                }
                local.push(idx - 1);
                continue;
            }
            let nrows = @truncate(usize, bn.rd32(d, at));
            at += 4;
            let ls = u.new.[u.List.[pdb.Line]]();
            for r in 0..nrows {
                let b = at + (r * 12);
                let f = @truncate(usize, bn.rd32(d, b + 4));
                ls.push(pdb.Line.{ off: @truncate(u32, bn.rd32(d, b)), line: @truncate(u32, bn.rd32(d, b + 8)),
                                   file: local.get(f) });
            }
            at += nrows * 12;
            m.put(u.intern(name), ls);
        }
    }
    return m;
}
