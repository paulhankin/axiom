// =============================================================================
// header.ax - C header for a program's exported functions (spec §14.5.4).
//
// Every `export fn` gets a prototype. Structs reachable from the exported
// signatures are defined with the same layout Axiom uses (spec §5.9 is
// C's natural layout), so C code can read and write them through pointers.
// =============================================================================
import "ast.ax" as ast;
import "sema.ax" as sema;
import "types.ax" as ty;
import "util.ax" as u;

struct HeaderGen {
    emitted: u.List.[*mut ast.Type],   // structs already defined
    visiting: u.List.[*mut ast.Type],  // cycle guard
    defs: u.Buf,                       // struct definitions, in dependency order
}

fn sanitize(s: []u8) []u8 {
    let mut c = u.Buf.init();
    for x in s {
        let mut ch = x;
        if not (u.is_alnum(x) or (x == '_')) {
            ch = '_';
        }
        // collapse runs of '_'
        if (ch == '_') and (c.len() > 0) and (c.view()[c.len() - 1] == '_') {
            continue;
        }
        c.c(ch);
    }
    let mut r = c.done();
    // trim trailing '_'
    while (r.len > 0) and (r[r.len - 1] == '_') {
        r = r[0..r.len - 1];
    }
    return u.dup(r);
}

fn struct_c_name(t: *mut ast.Type) []u8 {
    if t.decl.anon {
        return u.f1("axiom_anon_%s", u.idec(t.id));
    }
    return sanitize(ty.type_str(t));
}

fn contains(v: *u.List.[*mut ast.Type], t: *mut ast.Type) bool {
    for i in 0..v.len {
        if v.get(i) == t {
            return true;
        }
    }
    return false;
}

// Base type name for scalars, or a nil slice.
fn scalar_name(t: *ast.Type) []u8 {
    let k = t.kind;
    if k == ast.TY_VOID {
        return "void";
    }
    if k == ast.TY_BOOL {
        return "bool";
    }
    if k == ast.TY_INT {
        if t.is_size {
            return u.pick(t.is_signed, "ptrdiff_t", "size_t");
        }
        if t.bits == 8 {
            return u.pick(t.is_signed, "int8_t", "uint8_t");
        }
        if t.bits == 16 {
            return u.pick(t.is_signed, "int16_t", "uint16_t");
        }
        if t.bits == 32 {
            return u.pick(t.is_signed, "int32_t", "uint32_t");
        }
        return u.pick(t.is_signed, "int64_t", "uint64_t");
    }
    if k == ast.TY_FLOAT {
        return u.pick(t.bits == 32, "float", "double");
    }
    if k == ast.TY_ERROR {
        return "uint16_t";
    }
    return u.nosym();
}

// C declaration of `inner` with type t. `konst`: the declared object is const.
fn decl(g: *mut HeaderGen, t: *mut ast.Type, inner: []u8, konst: bool) []u8 {
    let k = u.pick(konst, "const ", "");
    let sep = u.pick(inner.len > 0, " ", "");
    let sc = scalar_name(t);
    if not u.isnos(sc) {
        return u.f4("%s%s%s%s", k, sc, sep, inner);
    }
    let tk = t.kind;
    if tk == ast.TY_PTR {
        let mut in_ = u.f2("*%s%s", u.pick(konst, "const ", ""), inner);
        if t.elem.kind == ast.TY_ARRAY {
            in_ = u.f1("(%s)", in_);
        }
        let e = t.elem;
        if (e.kind == ast.TY_STRUCT) or not u.isnos(scalar_name(e)) or (e.kind == ast.TY_PTR) or
           (e.kind == ast.TY_FN) or (e.kind == ast.TY_ARRAY) {
            return decl(g, e, in_, not t.is_mut);
        }
        return u.f2("%svoid %s", u.pick(t.is_mut, "", "const "), in_);  // pointee has no C spelling
    }
    if tk == ast.TY_FN {
        let mut ps = u.Buf.init();
        if t.params.len == 0 {
            ps.s("void");
        }
        for i in 0..t.params.len {
            if i != 0 {
                ps.s(", ");
            }
            ps.s(decl(g, t.params[i], "", false));
        }
        return decl(g, t.ret, u.f3("(*%s%s)(%s)", u.pick(konst, "const ", ""), inner, ps.done()), false);
    }
    if tk == ast.TY_ARRAY {
        return decl(g, t.elem, u.f2("%s[%s]", inner, u.dec(t.len)), konst);
    }
    if tk == ast.TY_STRUCT {
        need_struct(g, t);
        return u.f4("%s%s%s%s", k, struct_c_name(t), sep, inner);
    }
    if tk == ast.TY_SLICE {
        let mut el = decl(g, t.elem, "*ptr", not t.is_mut);
        if u.isnos(scalar_name(t.elem)) and (t.elem.kind != ast.TY_STRUCT) and (t.elem.kind != ast.TY_PTR) {
            el = u.f1("%svoid *ptr", u.pick(t.is_mut, "", "const "));
        }
        return u.f4("%sstruct { %s; size_t len; }%s%s", k, el, sep, inner);
    }
    if (tk == ast.TY_VEC) or (tk == ast.TY_V128) {
        let mut lane: []u8 = "int32_t";
        if tk != ast.TY_V128 {
            lane = scalar_name(t.elem);
        }
        return u.f5("%s%s __attribute__((vector_size(%s)))%s%s", k, lane, u.dec(ty.type_size(t)), sep, inner);
    }
    // Tagged unions and error unions have no C equivalent: an opaque blob
    // with the right size and alignment keeps enclosing layouts correct.
    return u.f4("%sAXIOM_ALIGNAS(%s) unsigned char %s[%s]", k, u.dec(ty.type_align(t)), inner, u.dec(ty.type_size(t)));
}

fn need_struct(g: *mut HeaderGen, t: *mut ast.Type) void {
    if contains(&g.emitted, t) {
        return;
    }
    let name = struct_c_name(t);
    if contains(&g.visiting, t) {
        return;  // recursion through pointers: typedef already emitted
    }
    g.visiting.push(t);
    // forward typedef first, so self-referential pointers work
    g.defs.s(u.f2("typedef struct %s %s;\n", name, name));
    let mut body = u.Buf.init();
    body.s(u.f1("struct %s {\n", name));
    for i in 0..t.decl.fields.len {
        let ft = ty.type_field(t, i);
        body.s("    ");
        body.s(decl(g, ft, t.decl.fields.at(i).name, false));
        body.s(";\n");
    }
    if t.decl.fields.len == 0 {
        body.s("    char axiom_empty[1]; /* C forbids empty structs; size differs */\n");
    }
    body.s(u.f2("};\nAXIOM_STATIC_ASSERT(sizeof(struct %s) == %s, \"layout mismatch\");\n\n", name,
                u.dec(ty.type_size(t))));
    g.defs.s(body.done());
    g.visiting.len -= 1;
    g.emitted.push(t);
}

fn to_upper(s: []u8) []u8 {
    let r = u.dup(s);
    let m = @slice_from_ptr(@ptr_from_int(*mut u8, @int_from_ptr(r.ptr)), r.len);
    for i in 0..m.len {
        if (m[i] >= 'a') and (m[i] <= 'z') {
            m[i] = m[i] - 32;
        }
    }
    return r;
}

pub fn emit_c_header(path: []u8, source_name: []u8) bool {
    let g = u.new.[HeaderGen]();
    let mut protos = u.Buf.init();
    let fns = sema.g_prog.fns;
    for i in 0..fns.len {
        let d = fns.get(i);
        if not d.is_export {
            continue;
        }
        let mut ps = u.Buf.init();
        if d.params.len == 0 {
            ps.s("void");
        }
        for j in 0..d.params.len {
            if j != 0 {
                ps.s(", ");
            }
            ps.s(decl(g, d.param_types[j], d.params.at(j).name, false));
        }
        protos.s(decl(g, d.ret_type, u.f2("%s(%s)", d.name, ps.done()), false));
        protos.s(";\n");
    }
    let guard = to_upper(u.f1("AXIOM_%s_H", sanitize(source_name)));
    let mut out = u.Buf.init();
    out.s(u.f2("/* Generated by axiom from %s for target %s. Do not edit.\n", source_name, ty.g_target.triple));
    out.s("   Struct layouts depend on the target: regenerate the header per target. */\n");
    out.s(u.f2("#ifndef %s\n#define %s\n\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n", guard,
               guard));
    out.s("#ifdef __cplusplus\n#define AXIOM_STATIC_ASSERT static_assert\n#define AXIOM_ALIGNAS(n) alignas(n)\n");
    out.s("extern \"C\" {\n#else\n#define AXIOM_STATIC_ASSERT _Static_assert\n#define AXIOM_ALIGNAS(n) _Alignas(n)\n");
    out.s("#endif\n\n");
    out.s(u.f2("AXIOM_STATIC_ASSERT(sizeof(void *) == %s, \"this header was generated for %s-bit pointers\");\n\n",
               u.idec(ty.g_target.ptr_bits / 8), u.idec(ty.g_target.ptr_bits)));
    out.s(g.defs.done());
    out.s(protos.done());
    out.s("\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n");
    return u.write_file(path, out.done());
}
