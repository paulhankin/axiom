// Is id one of lo .. hi (in their order here)?
pub fn intr_between(id: Intrinsic, lo: Intrinsic, hi: Intrinsic) bool {
    let k = @int_from_enum(id);
    return (k >= @int_from_enum(lo)) and (k <= @int_from_enum(hi));
}

// The low (_LO) and high (_HI) halves' widening of the same kind as id.
pub fn widen_low(id: Intrinsic) Intrinsic {
    match id {
        .SWIDEN_HI => { return IN_SWIDEN_LO; }
        .UWIDEN_HI => { return IN_UWIDEN_LO; }
        else       => { return id; }
    }
}

pub fn widen_high(id: Intrinsic) Intrinsic {
    match id {
        .SWIDEN_LO => { return IN_SWIDEN_HI; }
        .UWIDEN_LO => { return IN_UWIDEN_HI; }
        else       => { return id; }
    }
}

pub fn is_widen(id: Intrinsic) bool {
    return intr_between(id, IN_SWIDEN_LO, IN_UWIDEN_HI);
}

pub fn is_dyn_stack(id: Intrinsic) bool {
    return intr_between(id, IN_STACK_ALLOC, IN_STACK_RESTORE);
}

/// Does f allocate on the stack dynamically, or move the stack pointer
/// (IN_STACK_ALLOC, IN_STACK_SAVE, IN_STACK_RESTORE)?
pub fn uses_dyn_stack(f: *Func) bool {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if (i.op == OP_INTR) and is_dyn_stack(intr_id(i)) {
                return true;
            }
            i = i.next;
        }
        b = b.next;
    }
    return false;
}

pub fn is_prefetch(id: Intrinsic) bool {
    return (id == IN_PREFETCH) or (id == IN_PREFETCHW);
}

// The intrinsic (IN_*) an instruction calls; 0 when it is not OP_INTR.
pub fn intr_id(v: *Value) Intrinsic {
    if v.op != OP_INTR {
        return IN_NONE;
    }
    return @enum_from_int(Intrinsic, @truncate(i32, @bit_cast(i64, v.cv)));
}

// An intrinsic call's cv for id (in its low 32 bits).
pub fn intr_cv(id: Intrinsic) u64 {
    return @as(u64, @bit_cast(u32, @int_from_enum(id)));
}
