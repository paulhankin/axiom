// =============================================================================
// units.ax - separate compilation (spec §16.7).
//
// Each module is compiled to its own object file, cached under
// <cache>/obj/<key>.o, where the key hashes everything the object depends on:
// the compiler binary, the code generation options, the module's source and
// path, and (recursively) the keys of the modules it imports. A build
// compiles only the modules whose key has no cached object, in parallel
// worker processes forked after type checking, then generates the small
// per-program link unit (globals, error codes, runtime state, exports).
// =============================================================================
import "ast.ax" as ast;
import "codegen.ax" as cg;
import "diag.ax" as dg;
import "package.ax" as pkg;
import "sema.ax" as sema;
import "target.ax" as tg;
import "types.ax" as ty;
import "util.ax" as u;

pub struct UnitStats {
    total: usize,     // modules in the program
    compiled: usize,  // modules compiled (not cached)
    evicted: usize,   // cached objects removed to keep the cache under its limit
    evicted_bytes: i64,
}

// Two independent 64-bit hashes make a 128-bit key.
struct Hasher {
    a: u64,
    b: u64,
}

fn hash_bytes(h: *mut Hasher, s: []u8) void {
    for c in s {
        h.a = (h.a ^ @as(u64, c)) *% 0x100000001b3;
        h.b = ((h.b +% @as(u64, c)) +% 1) *% 0x9E3779B97F4A7C15;
        h.b = h.b ^ (h.b >> 29);
    }
}

fn hash_str(h: *mut Hasher, s: []u8) void {
    hash_bytes(h, s);
    let z: [1]u8 = [0];
    hash_bytes(h, z[..]);  // with the NUL, as a separator
}

fn hasher() Hasher {
    return Hasher.{ a: 0xcbf29ce484222325, b: 0x2545F4914F6CDD1D };
}

fn hex_key(h: *Hasher) []u8 {
    return u.cat2(u.hex16(h.a), u.hex16(h.b));
}

let mut compiler_id_s: []u8 = "";

// The compiler's own identity: a hash of its executable.
fn compiler_id() []u8 {
    if compiler_id_s.len > 0 {
        return compiler_id_s;
    }
    let mut h = hasher();
    let me = u.self_path();
    let mut bytes = u.nosym();
    if not u.isnos(me) {
        bytes = u.read_file(me);
    }
    if not u.isnos(bytes) {
        hash_bytes(&mut h, bytes);
    } else {
        hash_str(&mut h, "axiom (unknown executable)");
    }
    compiler_id_s = hex_key(&h);
    return compiler_id_s;
}

fn options_id(o: *cg.CgOptions) []u8 {
    let mut b = u.Buf.init();
    b.s("unit-v1|");
    b.s(ty.g_target.triple);
    b.s("|");
    b.s(u.idec(ty.g_target.ptr_bits));
    b.s("|");
    b.s(u.idec(o.opt_level));
    b.s("|");
    b.s(u.idec(o.overflow));
    b.s(u.pick(o.stack_traces, "|1", "|0"));
    b.s(u.pick(o.profile, "|1", "|0"));
    b.s(u.pick(o.sanitize_address, "|1", "|0"));
    b.s(u.pick(cg.g_test_mode, "|1", "|0"));
    b.s("|");
    b.s(u.idec(o.emit));
    b.s("|");
    if not u.isnos(o.cpu) {
        b.s(o.cpu);
    }
    b.s("|");
    b.s(u.hex16(tg.g_features));  // the extensions the code may use
    // (x64.ax: measuring code placement)
    let knobs = ["AXIOM_X64_FPAD", "AXIOM_X64_FALIGN", "AXIOM_X64_LALIGN", "AXIOM_X64_LMAX", "AXIOM_X64_LMODE",
                 "AXIOM_X64_JCC"];
    for k in knobs {
        let v = u.env(k);
        if not u.isnos(v) {
            b.s("|");
            b.s(k);
            b.s("=");
            b.s(v);
        }
    }
    return b.done();
}

struct Unit {
    m: *mut ast.Module,
    key: []u8,
    obj: []u8,
    cached: bool,
}

let mut key_memo: u.SymMap.[[]u8] = u.SymMap.[[]u8].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut []u8, 0), cap: 0, len: 0 };

fn module_key(m: *mut ast.Module, opts: []u8) []u8 {
    let mk = u.intern(m.path);
    let k = key_memo.get(mk);
    if not u.isnos(k) {
        return k;
    }
    let mut h = hasher();
    hash_str(&mut h, compiler_id());
    hash_str(&mut h, opts);
    let f = u.file_of(m.file.id);
    hash_str(&mut h, f.display);
    hash_bytes(&mut h, f.text);
    let mut has_tests = false;
    let tests = sema.g_prog.tests;
    for i in 0..tests.len {
        if tests.get(i).module == m {
            has_tests = true;
        }
    }
    hash_str(&mut h, u.pick(has_tests, "tests", "no-tests"));
    for i in 0..m.decls.len {
        let d = m.decls.get(i);
        if (d.kind == ast.D_IMPORT) and u.notnil(d.imported) {
            hash_str(&mut h, interface_key(d.imported, opts));
        }
    }
    let key = hex_key(&h);
    key_memo.put(mk, key);
    return key;
}

let mut iface_memo: u.SymMap.[[]u8] = u.SymMap.[[]u8].{ keys: @ptr_from_int(*mut usize, 0),
                                                        vals: @ptr_from_int(*mut []u8, 0), cap: 0, len: 0 };

// A function whose body no other module's object depends on: not generic
// (instances are compiled where they are used), not inline (inlined there),
// not a test. Callers reach it by name, through its signature.
fn body_private(d: *ast.Decl) bool {
    return (d.kind == ast.D_FN) and u.notnil(d.body) and (d.gparams.len == 0) and not d.is_inline;
}

fn hash_blanked(h: *mut Hasher, text: []u8, from: *mut usize, body: *ast.Stmt) void {
    let a = @as(usize, body.span.start);
    let b = @as(usize, body.span.end);
    if (a < from.*) or (b > text.len) or (a > b) {
        return;
    }
    hash_bytes(h, text[from.*..a]);
    hash_str(h, "{}");
    from.* = b;
}

// What a module's importers depend on: its source without the bodies of
// the functions they never see (body_private), its path, and the interface
// keys of its imports in turn. A change inside such a body changes the
// module's own key alone, so only the module is recompiled.
fn interface_key(m: *mut ast.Module, opts: []u8) []u8 {
    let mk = u.intern(m.path);
    let k = iface_memo.get(mk);
    if not u.isnos(k) {
        return k;
    }
    let mut h = hasher();
    hash_str(&mut h, compiler_id());
    hash_str(&mut h, opts);
    let f = u.file_of(m.file.id);
    hash_str(&mut h, f.display);
    let text = f.text;
    let mut from: usize = 0;
    for i in 0..m.decls.len {
        let d = m.decls.get(i);
        if body_private(d) {
            hash_blanked(&mut h, text, &mut from, d.body);
        } else if ((d.kind == ast.D_STRUCT) or (d.kind == ast.D_UNION) or (d.kind == ast.D_ENUM)) and
                  (d.gparams.len == 0) {
            for j in 0..d.methods.len {
                let md = d.methods.get(j);
                if body_private(md) {
                    hash_blanked(&mut h, text, &mut from, md.body);
                }
            }
        }
    }
    hash_bytes(&mut h, text[from..]);
    for i in 0..m.decls.len {
        let d = m.decls.get(i);
        if (d.kind == ast.D_IMPORT) and u.notnil(d.imported) {
            hash_str(&mut h, interface_key(d.imported, opts));
        }
    }
    let key = hex_key(&h);
    iface_memo.put(mk, key);
    return key;
}

// On wasm every thread-local of the program lives in one block whose layout
// each module's code bakes in, so a module's object also depends on the
// thread-locals of modules it does not import: their order, sizes and
// alignments. Nil when there is no such dependency.
fn tls_layout_id() []u8 {
    if not ty.g_target.is_wasm {
        return u.nil_slice.[u8]();
    }
    let P = sema.g_prog;
    let mut h = hasher();
    let mut any = false;
    for i in 0..P.globals.len {
        let d = P.globals.get(i);
        if d.is_tls {
            any = true;
            hash_str(&mut h, d.module.path);
            hash_str(&mut h, d.name);
            hash_str(&mut h, u.dec(ty.type_size(d.ty)));
            hash_str(&mut h, u.dec(ty.type_align(d.ty)));
        }
    }
    if not any {
        return u.nil_slice.[u8]();
    }
    return hex_key(&h);
}

fn file_ok(p: []u8) bool {
    return u.is_file(p) and (u.file_size(p) > 0);
}

// Compiles one module in a child process. Its handle (negative if
// processes cannot be made).
fn spawn_unit(base: *cg.CgOptions, un: *mut Unit) i32 {
    u.flush_out();
    let pid = u.fork();
    if pid != 0 {
        return pid;
    }
    let co = u.new.[cg.CgOptions]();
    co.* = base.*;
    co.unit = cg.CG_MODULE;
    co.module = un.m;
    let tmp = u.f2("%s.tmp%s", un.obj, u.idec(u.getpid()));
    co.out_path = tmp;
    let ok = cg.codegen_program(co);
    if not ok {
        dg.emit(false, false);
        _ = u.unlink(u.cz(tmp));
        u._exit(1);
    }
    if u.rename(u.cz(tmp), u.cz(un.obj)) != 0 {
        _ = u.unlink(u.cz(tmp));
        u._exit(1);
    }
    u._exit(0);
    return 0;
}

// Compiles every module whose object is not cached, then the link unit into
// `link_obj`. Appends the module objects to `objs`. 1 on success; 0 on
// failure (errors already reported); -1, having done nothing, where the
// host cannot make the processes to compile modules in (WebAssembly).
pub fn build_units(base: *cg.CgOptions, link_obj: []u8, objs: *mut u.List.[[]u8], stats: *mut UnitStats) i32 {
    let opts = options_id(base);
    let dir = u.cat2(pkg.cache_dir(), "/obj");
    u.mkdirs(dir);
    let mods = sema.g_prog.modules;
    let n = mods.len;
    let units = u.newn.[Unit](n + 1);
    let mut todo = u.List.[*mut Unit].empty();
    let tls = tls_layout_id();
    for i in 0..n {
        let un = &mut units[i];
        un.m = mods.get(i);
        un.key = module_key(un.m, opts);
        if not u.isnos(tls) {
            let mut h = hasher();
            hash_str(&mut h, un.key);
            hash_str(&mut h, tls);
            un.key = hex_key(&h);
        }
        un.obj = u.f2("%s/%s.o", dir, un.key);
        un.cached = file_ok(un.obj);
        if un.cached {
            _ = u.touch(un.obj);  // used now (eviction is least recently used)
        } else {
            todo.push(un);
        }
    }
    // Compile what is missing, a few at a time (waiting for the oldest).
    let width = @min(@max(u.cpu_count(), 1), 16);
    let mut running = u.List.[i32].empty();
    let mut first: usize = 0;  // the oldest still running
    let mut next: usize = 0;
    let mut failed = false;
    while (next < todo.len) or (first < running.len) {
        while not failed and ((running.len - first) < width) and (next < todo.len) {
            let p = spawn_unit(base, todo.get(next));
            if p < 0 {
                if running.len == 0 {
                    return -1;
                }
                failed = true;
                break;
            }
            running.push(p);
            next += 1;
        }
        if first == running.len {
            break;
        }
        let status = u.wait_child(running.get(first));
        first += 1;
        if status != 0 {
            failed = true;
        }
    }
    stats.total = n;
    stats.compiled = todo.len;
    if failed {
        return 0;
    }
    for i in 0..n {
        objs.push(units[i].obj);
    }
    // The link unit, in this process.
    let co = u.new.[cg.CgOptions]();
    co.* = base.*;
    co.unit = cg.CG_LINK;
    co.module = u.nil.[ast.Module]();
    co.out_path = link_obj;
    if not cg.codegen_program(co) {
        return 0;
    }
    evict(dir, stats);
    return 1;
}

// -----------------------------------------------------------------------------
// Eviction. The cache is kept under a size limit: after a build, the least
// recently used objects go until it fits. An object's use is its modification
// time (build_units touches the objects it reuses), and objects used or
// written within the last hour stay whatever the size, so that a build
// running at the same time keeps the objects it found. A build that loses an
// object to another process recompiles it.
// -----------------------------------------------------------------------------

let DEFAULT_CACHE_LIMIT: i64 = 2 * 1024 * 1024 * 1024;
let EVICT_GRACE_NS: i64 = 3600 * 1000000000;

// The cache's size limit in bytes: $AXIOM_CACHE_LIMIT, a count of bytes or
// one with a k, m or g suffix (0: no limit); 2 GiB if unset or malformed.
pub fn cache_limit() i64 {
    let s = u.env("AXIOM_CACHE_LIMIT");
    if u.isnos(s) or (s.len == 0) {
        return DEFAULT_CACHE_LIMIT;
    }
    let mut n = s.len;
    let mut mul: i64 = 1;
    let c = s[n - 1] | 0x20;
    if c == 'k' {
        mul = 1024;
        n -= 1;
    } else if c == 'm' {
        mul = 1024 * 1024;
        n -= 1;
    } else if c == 'g' {
        mul = 1024 * 1024 * 1024;
        n -= 1;
    }
    if (n == 0) or (n > 15) {
        return DEFAULT_CACHE_LIMIT;
    }
    for i in 0..n {
        if not u.is_digit(s[i]) {
            return DEFAULT_CACHE_LIMIT;
        }
    }
    return u.atol(s[0..n]) * mul;
}

// A file of the cache directory.
pub struct CacheEntry {
    path: []u8,
    size: i64,
    mtime: i64,
}

// The files of the cache directory `dir` (objects, and temporaries left by
// interrupted builds), in `out`; their total size.
pub fn cache_entries(dir: []u8, out: *mut u.List.[CacheEntry]) i64 {
    let mut names = u.List.[[]u8].empty();
    if not u.list_dir(dir, &mut names) {
        return 0;
    }
    let mut total: i64 = 0;
    for i in 0..names.len {
        let p = u.f2("%s/%s", dir, names.get(i));
        if not u.is_file(p) {
            continue;
        }
        let e = CacheEntry.{ path: p, size: u.file_size(p), mtime: u.file_mtime(p) };
        total += e.size;
        out.push(e);
    }
    return total;
}

fn older_first(a: CacheEntry, b: CacheEntry) i32 {
    if a.mtime < b.mtime {
        return -1;
    }
    if a.mtime > b.mtime {
        return 1;
    }
    return u.str_cmp(a.path, b.path);
}

fn evict(dir: []u8, stats: *mut UnitStats) void {
    let limit = cache_limit();
    if limit <= 0 {
        return;
    }
    let mut es = u.List.[CacheEntry].empty();
    let mut total = cache_entries(dir, &mut es);
    if total <= limit {
        return;
    }
    u.sort.[CacheEntry](es.items(), older_first);
    let cutoff = u.wall_ns() - EVICT_GRACE_NS;
    for i in 0..es.len {
        if total <= limit {
            break;
        }
        let e = es.get(i);
        if e.mtime >= cutoff {
            break;  // in use, perhaps; and everything after it is newer
        }
        if u.unlink(u.cz(e.path)) == 0 {
            total -= e.size;
            stats.evicted += 1;
            stats.evicted_bytes += e.size;
        }
    }
}

// The toolchain's own C runtime (std/internal/runtime/*.c) is compiled once per content
// and compiler, like modules. Its object, or a nil slice to compile it in
// the link step instead.
pub fn cached_runtime_object(cc: []u8, src: []u8) []u8 {
    let text = u.read_file(src);
    if u.isnos(text) {
        return u.nosym();
    }
    let mut h = hasher();
    hash_str(&mut h, "runtime-v1");
    hash_str(&mut h, cc);
    hash_str(&mut h, compiler_id());
    hash_bytes(&mut h, text);
    // Its only local header.
    let mut dir: []u8 = ".";
    let slash = u.rfind(src, '/');
    if slash >= 0 {
        dir = u.dup(src[0..@int_cast(usize, slash)]);
    }
    let hdr = u.read_file(u.cat2(dir, "/trap_format.h"));
    if not u.isnos(hdr) {
        hash_bytes(&mut h, hdr);
    }
    let cdir = u.cat2(pkg.cache_dir(), "/obj");
    u.mkdirs(cdir);
    let obj = u.f2("%s/rt-%s.o", cdir, hex_key(&h));
    if file_ok(obj) {
        return obj;
    }
    let tmp = u.f2("%s.tmp%s", obj, u.idec(u.getpid()));
    let args = [cc, "-O2", "-c", "-pthread", src, "-o", tmp];
    if (u.run_process(args[..], u.no_strs(), u.OUT_INHERIT).status != 0) or (u.rename(u.cz(tmp), u.cz(obj)) != 0) {
        _ = u.unlink(u.cz(tmp));
        return u.nosym();
    }
    return obj;
}
