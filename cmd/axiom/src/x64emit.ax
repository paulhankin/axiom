// =============================================================================
// x64emit.ax - x86-64 code emission, after instruction selection (x64.ax) and
// register allocation: peepholes on the allocated code (flags reused,
// branches tidied, three-address forms), shrink-wrapping's frame tests, the
// prologue and epilogue, Windows unwind information and line tables, code
// placement, and the encoding (x64enc.ax) of each function into the object.
// The state of the function being compiled, which x64.ax sets, lives here.
// =============================================================================
import "asm/core.ax" as acr;
import "asm/inline.ax" as ai;
import "asm/x64.ax" as ax;
import "bin.ax" as bn;
import "dloc.ax" as dloc;
import "dwarf.ax" as dw;
import "elf.ax" as elf;
import "ftab.ax" as ft;
import "ir.ax" as ir;
import "isel.ax" as is;
import "mach.ax" as mc;
import "util.ax" as u;
import "x64enc.ax" as xe;

// The object being written, and the function being compiled
pub let mut OBJ: *mut elf.Obj = @ptr_from_int(*mut elf.Obj, 0);
pub let mut TEXT: i32 = 0;
pub let mut LINES: i32 = -1;  // Windows: line tables (.axiom.lines, for plink.ax's PDB)
pub let mut DBG: dw.Unit = dw.Unit.{ on: false, arch: 0, addr_size: 8, full: false, lang: 0,
                                     parts: [
                                         dw.Part.{
                                             b: bn.Bytes.{
                                                 b: u.List.[u8].{ data: @ptr_from_int(*mut u8, 0), len: 0, cap: 0 } },
                                             fx: u.List.[dw.Fix].{ data: @ptr_from_int(*mut dw.Fix, 0), len: 0,
                                                                   cap: 0 } }; 9],
                                     strs: u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0),
                                                            vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                     lstrs: u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0),
                                                             vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                     files: u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 },
                                     fmap: u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0),
                                                            vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                     by_id: u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 },
                                     nfuncs: 0, first_src: 0, text_sym: 0,
                                     trefs: u.List.[dw.Fix].{ data: @ptr_from_int(*mut dw.Fix, 0), len: 0, cap: 0 },
                                     gsyms: u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0),
                                                             vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                     toff: u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 },
                                     drefs: u.List.[dw.Fix].{ data: @ptr_from_int(*mut dw.Fix, 0), len: 0, cap: 0 },
                                     gdone: u.List.[bool].{ data: @ptr_from_int(*mut bool, 0), len: 0, cap: 0 },
                                     voffs: u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 },
                                     tls_rel: 0 };  // -g: DWARF (dwarf.ax; not on Windows)
pub let mut XDATA: i32 = -1;  // Windows: unwind information, and the function table
pub let mut PDATA: i32 = -1;
pub let mut XDATA_SYM: u32 = 0;
pub let mut FT: ft.Tab = ft.Tab.{ on: false, obj: @ptr_from_int(*mut elf.Obj, 0), rets: -1, chains: -1, text_sym: 0,
                                  chains_sym: 0, rel32: 0, abs64: 0, empty: 0 };  // frame tables (ftab.ax)
pub let mut fsym: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };
pub let mut errors: bool = false;
pub let mut AVX: bool = false;
pub let mut UPPER: bool = false;  // the function uses ymm or zmm registers (vzeroupper before calls and returns)
let mut DIRTY: bool = true;       // ... and may have written one since it was entered or last made a call
pub let mut WIN: bool = false;    // Windows x64: its calling convention, and thread-locals through the TEB
pub let mut F: *mut ir.Func = @ptr_from_int(*mut ir.Func, 0);
pub let mut MF: *mut mc.MFunc = @ptr_from_int(*mut mc.MFunc, 0);
pub let mut out_area: u64 = 0;  // outgoing stack-argument bytes

// Code placement (encode_func), with knobs for measuring it,
// read from the environment and part of the object cache's key:
//
//   AXIOM_X64_FPAD=n    n bytes in front of every function (before it is
//                       aligned): builds of one program with different n
//                       place its code differently
//   AXIOM_X64_FALIGN=a  functions start at multiples of a bytes (default 16)
//   AXIOM_X64_LALIGN=a  hot loop tops start at multiples of a bytes (default
//                       0: not aligned), with no more than AXIOM_X64_LMAX
//                       (default 15) bytes of nops; AXIOM_X64_LMODE=1
//                       (default) aligns the targets of jumps back, 2 any
//                       block in a loop that is not often fallen into (as
//                       LLVM does)
//   AXIOM_X64_JCC=1     no jump, call or return (with the compare a jcc
//                       fuses with) crosses or ends on a 32-byte boundary:
//                       Intel's JCC erratum, whose microcode fix keeps such
//                       a jump out of the decoded-µop cache on Skylake-family
//                       cores; nops move it to the boundary
//
// .text is aligned to 64 bytes, so where each instruction will sit relative
// to 32- and 64-byte boundaries is known while encoding (FBASE: where the
// function being encoded will start). Measured on SIMD kernels (Cascade
// Lake, 0095), neither aligned loops nor the JCC padding made the code faster
// (the padding made it slower), so none is on by default.
let mut FPAD: usize = 0;
let mut FALIGN: u64 = 16;
let mut LALIGN: u64 = 0;
let mut LMAX: u64 = 15;
let mut LMODE: i32 = 1;
let mut JCC: bool = false;
let mut FBASE: u64 = 0;

pub fn fail(msg: []u8) void {
    u.eprint(u.f2("axiom: x86-64 code generation: %s (in %s)\n", msg, F.name));
    errors = true;
}

// -----------------------------------------------------------------------------
// Encoding
// -----------------------------------------------------------------------------
let mut E: xe.Enc = xe.Enc.{ b: bn.Bytes.{ b: u.List.[u8].{ data: @ptr_from_int(*mut u8, 0), len: 0, cap: 0 } },
                             relocs: u.List.[xe.Reloc].{ data: @ptr_from_int(*mut xe.Reloc, 0), len: 0, cap: 0 },
                             fixups: u.List.[xe.Fixup].{ data: @ptr_from_int(*mut xe.Fixup, 0), len: 0, cap: 0 },
                             avx: false };
let mut nsaved: i64 = 0;
let mut saved: [7]i32 = [0; 7];
let mut nxsaved: i64 = 0;  // Windows: xmm6-xmm15 in use, saved below the pushed registers
let mut xsaved: [10]i32 = [0; 10];
let mut local_off: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };

pub fn P(r: i32) i32 {
    if PRE_RA {
        return r;
    }
    return mc.phys(MF, r);
}

pub let mut PRE_RA: bool = false;  // (P names virtual registers: before allocation)

fn b8(x: u64) void {
    E.b.u8_(@truncate(u8, x));
}

fn to_mem(o: mc.MOp) xe.Mem {
    let mut m = xe.Mem.{ base: -1, index: -1, scale: o.scale, disp: o.disp, sym: o.sym, tpoff: false };
    if o.base >= 0 {
        m.base = P(o.base);
    }
    if o.index >= 0 {
        m.index = P(o.index);
    }
    if o.slot >= 0 {
        m.base = xe.RBP;
        m.disp += MF.slots.get(@int_cast(usize, o.slot)).offset;
        m.sym = -1;
    } else if (o.slot == -2) or (o.slot == -3) {
        m.tpoff = true;
    }
    return m;
}

// ModRM for a memory operand, with TLS offsets relative to a base register.
fn enc_mem(rf: i32, o: mc.MOp, imm_after: i64) void {
    let m = to_mem(o);
    xe.modrm_mem(&mut E, @as(u64, @bit_cast(u32, rf)), &m, imm_after);
}

fn rex_for_mem(w: u64, rf: i32, o: mc.MOp, force: bool) void {
    let m = to_mem(o);
    let r = @as(u64, @bit_cast(u32, (rf & 15) >> 3));
    let x = xe.rm_x(&m);
    let b = xe.rm_b(&m);
    let v = ((w << 3) | (r << 2)) | ((x << 1) | b);
    if (v != 0) or force {
        b8(0x40 | v);
    }
}

fn byte_reg_force(r: i32) bool {
    let x = r & 15;
    return (x >= 4) and (x <= 7);
}

// opcode (1-2 bytes) with reg field `reg` and r/m operand `rm` (register or memory)
fn enc_op(sz: u8, nop: i32, op0: u8, op1: u8, rf: i32, rm: mc.MOp, imm_after: i64, byte_op: bool) void {
    enc_op2(sz, nop, op0, op1, rf, rm, imm_after, byte_op, byte_op);
}

// enc_op where byte_rf and byte_rm say which of the reg field (not a /digit
// or a wider register) and the r/m operand is a byte register: spl, bpl,
// sil and dil need a REX prefix, al-bl do not.
fn enc_op2(sz: u8, nop: i32, op0: u8, op1: u8, rf: i32, rm: mc.MOp, imm_after: i64, byte_rf: bool, byte_rm: bool) void {
    if sz == 2 {
        b8(0x66);
    }
    let mut w: u64 = 0;
    if sz == 8 {
        w = 1;
    }
    if rm.kind == mc.K_REG {
        let rr = P(rm.reg);
        let force = (byte_rf and byte_reg_force(rf)) or (byte_rm and byte_reg_force(rr));
        let v = ((w << 3) | ((@as(u64, @bit_cast(u32, rf & 15)) >> 3) << 2)) | (@as(u64, @bit_cast(u32, rr & 15)) >> 3);
        if (v != 0) or force {
            b8(0x40 | v);
        }
        opcode(nop, op0, op1);
        xe.modrm_rr(&mut E, @as(u64, @bit_cast(u32, rf)), @as(u64, @bit_cast(u32, rr)));
        return;
    }
    rex_for_mem(w, rf, rm, byte_rf and byte_reg_force(rf));
    opcode(nop, op0, op1);
    enc_mem(rf, rm, imm_after);
}

fn opcode(n: i32, a: u8, b: u8) void {
    E.b.u8_(a);
    if n == 2 {
        E.b.u8_(b);
    }
}

// An instruction with a byte form (opcode op0, or op0 op1) and a wider one
// (the last opcode byte one more), as sz says: reg field rf (a register, or
// a /digit when digit) and r/m operand rm.
fn enc_op_sz(sz: u8, nop: i32, op0: u8, op1: u8, rf: i32, digit: bool, rm: mc.MOp, imm_after: i64) void {
    if sz == 1 {
        enc_op2(1, nop, op0, op1, rf, rm, imm_after, not digit, true);
    } else if nop == 1 {
        enc_op(sz, 1, op0 + 1, op1, rf, rm, imm_after, false);
    } else {
        enc_op(sz, nop, op0, op1 + 1, rf, rm, imm_after, false);
    }
}

fn imm_len(sz: u8) i64 {
    if sz == 1 {
        return 1;
    }
    if sz == 2 {
        return 2;
    }
    return 4;
}

fn enc_imm(x: i64, n: i64) void {
    xe.imm_n(&mut E, x, @truncate(u8, @bit_cast(u64, n)));
}

// After code with ymm or zmm registers, before code that may use the
// legacy SSE encoding (which would otherwise pay to preserve the upper halves).
// An instruction on 256 or 512 bits, which leaves the upper halves of the
// vector registers in use.
fn writes_wide(i: *mc.MInst) bool {
    return (i.op == xe.SSE) and (i.sz >= 32);
}

// For each block: may the upper halves be in use on entry (vzeroupper
// before a call or return only then)? The function is entered with them
// clear, and a call returns with them clear.
fn upper_dirty() []mut bool {
    let nb = MF.blocks.len;
    let din = u.newn.[bool](nb + 1);
    let dout = u.newn.[bool](nb + 1);
    if not UPPER {
        return din;
    }
    let mut changed = true;
    while changed {
        changed = false;
        for bi in 0..nb {
            let b = MF.blocks.get(bi);
            let mut d = din[bi];
            let mut i = b.first;
            while u.notnil(i) {
                if writes_wide(i) {
                    d = true;
                } else if i.op == xe.CALL {
                    d = false;
                }
                i = i.next;
            }
            if d and not dout[bi] {
                dout[bi] = true;
                for k in 0..b.succs.len {
                    let si = @int_cast(usize, b.succs.get(k));
                    if not din[si] {
                        din[si] = true;
                        changed = true;
                    }
                }
            }
        }
    }
    return din;
}

fn vzeroupper() void {
    b8(0xc5);
    b8(0xf8);
    b8(0x77);
}

fn label_ref(l: i32) void {
    xe.rel32_fixup(&mut E, l);
}

// Branch relaxation (encode_func): the jumps, in the order they are encoded,
// that take a rel8 displacement (jshort); in the first pass, which encodes
// them all with rel32, where each starts and where it goes.
let mut jshort: u.List.[bool] = u.List.[bool].{ data: @ptr_from_int(*mut bool, 0), len: 0, cap: 0 };
let mut jstart: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };
let mut jlabel: u.List.[i32] = u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 };
let mut jnext: usize = 0;
// the rel8 jumps of a pass: jump number << 32 | its fixup
let mut jfix: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };

// A jump (jmp: 0xe9 / 0xeb; jcc: 0x0f 0x80+cc / 0x70+cc) to label l.
fn enc_jump(l: i32, cond: bool, cc: i32) void {
    let k = jnext;
    jnext += 1;
    if k >= jshort.len {
        jshort.push(false);
        jstart.push(@as(u64, E.b.len()));
        jlabel.push(l);
    }
    if jshort.get(k) {
        if cond {
            b8(0x70 + @as(u64, @bit_cast(u32, cc)));
        } else {
            b8(0xeb);
        }
        jfix.push((@as(u64, k) << 32) | @as(u64, E.fixups.len));
        xe.rel8_fixup(&mut E, l);
        return;
    }
    if cond {
        b8(0x0f);
        b8(0x80 + @as(u64, @bit_cast(u32, cc)));
    } else {
        b8(0xe9);
    }
    label_ref(l);
}

// After the first pass: the jumps whose targets are within a rel8 of them
// once the others chosen so are short too (distances only shrink as more
// are: repeated until none changes). True if any is.
fn relax_jumps(boff: []u64) bool {
    let n = jshort.len;
    if n == 0 {
        return false;
    }
    let tgt = u.newn.[u64](n + 1);
    let longl = u.newn.[i64](n + 1);
    for k in 0..n {
        let l = jlabel.get(k);
        if l >= xe.LOCAL_BASE {
            tgt[k] = local_off.get(@int_cast(usize, l - xe.LOCAL_BASE));
        } else {
            tgt[k] = boff[@int_cast(usize, l)];
        }
        longl[k] = 5;
        if E.b.view()[@truncate(usize, jstart.get(k))] == 0x0f {
            longl[k] = 6;
        }
    }
    // before[k]: bytes saved by the short jumps before jump k (starts increase)
    let before = u.newn.[i64](n + 1);
    let mut any = false;
    let mut changed = true;
    while changed {
        changed = false;
        let mut acc: i64 = 0;
        for k in 0..n {
            before[k] = acc;
            if jshort.get(k) {
                acc += longl[k] - 2;
            }
        }
        before[n] = acc;
        for k in 0..n {
            if jshort.get(k) {
                continue;
            }
            // the target, moved up by the savings before it: those of the
            // jumps that start before it
            let t = tgt[k];
            let mut lo: usize = 0;
            let mut hi: usize = n;
            while lo < hi {
                let mid = (lo + hi) / 2;
                if jstart.get(mid) < t {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            let nt = @bit_cast(i64, t) - before[lo];
            let ns = @bit_cast(i64, jstart.get(k)) - before[k];
            let mut rel = nt - (ns + 2);
            if t > jstart.get(k) {
                rel -= longl[k] - 2;  // (this jump's own saving is among those before t)
            }
            if (rel >= -128) and (rel <= 127) {
                jshort.set(k, true);
                changed = true;
                any = true;
            }
        }
    }
    return any;
}

// After a pass with rel8 jumps: those whose targets ended up out of reach
// (padding, see encode_func, can lengthen what relax_jumps expected to
// shrink) take a rel32 from now on. True if any does: encode again.
fn unrelax_jumps(boff: []u64) bool {
    let mut any = false;
    for n in 0..jfix.len {
        let x = jfix.get(n);
        let f = E.fixups.get(@truncate(usize, x & 0xffff_ffff));
        let mut target: u64 = 0;
        if f.label >= xe.LOCAL_BASE {
            target = local_off.get(@int_cast(usize, f.label - xe.LOCAL_BASE));
        } else {
            target = boff[@int_cast(usize, f.label)];
        }
        let rel = @bit_cast(i64, target) - @bit_cast(i64, f.off + 1);
        if (rel < -128) or (rel > 127) {
            jshort.set(@truncate(usize, x >> 32), false);
            any = true;
        }
    }
    return any;
}

// Multi-byte nops (as LLVM writes them), n bytes in all.
// (the k-byte one at k * (k - 1) / 2)
let NOPS: [55]u8 = [0x90, 0x66, 0x90, 0x0f, 0x1f, 0x00, 0x0f, 0x1f, 0x40, 0x00, 0x0f, 0x1f, 0x44, 0x00, 0x00, 0x66,
                    0x0f, 0x1f, 0x44, 0x00, 0x00, 0x0f, 0x1f, 0x80, 0x00, 0x00, 0x00, 0x00, 0x0f, 0x1f, 0x84, 0x00,
                    0x00, 0x00, 0x00, 0x00, 0x66, 0x0f, 0x1f, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00, 0x66, 0x2e, 0x0f,
                    0x1f, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00];

fn emit_nops(n0: u64) void {
    let mut n = n0;
    while n > 0 {
        let k = @min(n, 10);
        let at = @truncate(usize, (k * (k - 1)) / 2);
        E.b.put(NOPS[at..at + @truncate(usize, k)]);
        n -= k;
    }
}

// What the encoder has written so far, to take back an instruction encoded
// in the wrong place (see enc_unit).
struct EncMark {
    b: usize,
    relocs: usize,
    fixups: usize,
    jnext: usize,
    jlen: usize,
    jfix: usize,
}

fn enc_mark() EncMark {
    return EncMark.{ b: E.b.len(), relocs: E.relocs.len, fixups: E.fixups.len, jnext: jnext, jlen: jshort.len,
                     jfix: jfix.len };
}

fn enc_rewind(m: EncMark) void {
    E.b.b.len = m.b;
    E.relocs.len = m.relocs;
    E.fixups.len = m.fixups;
    jnext = m.jnext;
    jshort.len = m.jlen;
    jstart.len = m.jlen;
    jlabel.len = m.jlen;
    jfix.len = m.jfix;
}

// Encodes nothing (a no-op move, a local label).
fn enc_nothing(i: *mc.MInst) bool {
    return noop_move(i) or (i.op == xe.LABEL) or (i.op == xe.NOP);
}

// A compare or test that a jcc right after it fuses with (Skylake: cmp, test,
// add, sub, and; inc and dec are adds here).
fn fuses_with_jcc(i: *mc.MInst) bool {
    if (i.op == xe.TEST) or (i.op == xe.CMP_M) {
        return true;
    }
    return (i.op == xe.ALU) and
           ((i.cc == xe.ALU_ADD) or (i.cc == xe.ALU_AND) or (i.cc == xe.ALU_SUB) or (i.cc == xe.ALU_CMP));
}

// Does code at s of length n cross or end on a 32-byte boundary?
fn crosses32(s: u64, n: u64) bool {
    return (s % 32) + n >= 32;
}

// Encodes i, or (JCC) the jump i starts with the compare it fuses with
// through last: if that crosses or ends on a 32-byte boundary, it is
// encoded again after nops that move it to the boundary. `extra`: the
// length of a jcc that follows (at the start of the next block).
fn enc_unit(i: *mut mc.MInst, last: *mut mc.MInst, extra: u64) void {
    let m = enc_mark();
    let mut x = i;
    loop {
        enc_inst(x);
        if x == last {
            break;
        }
        x = x.next;
    }
    if i.op == xe.RET {
        // (only the ret itself, the epilogue's last byte)
        let e = FBASE + @as(u64, E.b.len());
        if (e % 32) == 0 {
            let n = E.b.len();
            if E.b.view()[n - 1] != 0xc3 {
                fail("internal compiler error: an epilogue that does not end in ret");
            }
            E.b.b.len = n - 1;
            emit_nops(1);
            b8(0xc3);
        }
        return;
    }
    let s = FBASE + @as(u64, m.b);
    let mut pad: u64 = 0;
    if i.op == xe.REP {
        // memmove's own jumps: a fused cmp + jae at 9, a jmp at 28 (see enc_rep)
        while crosses32(s + pad + 9, 5) or crosses32(s + pad + 28, 2) {
            pad += 1;
        }
    } else {
        let len = @as(u64, E.b.len()) - @as(u64, m.b) + extra;
        if crosses32(s, len) and (len < 32) {
            pad = 32 - (s % 32);
        }
    }
    if pad == 0 {
        return;
    }
    enc_rewind(m);
    emit_nops(pad);
    x = i;
    loop {
        enc_inst(x);
        if x == last {
            break;
        }
        x = x.next;
    }
}

// The length of the jcc that the blocks after bi start with, if they fall
// into it with nothing between (no padding, no prologue); else 0.
fn jcc_next_block(bi: usize, skip: []bool, lal: []bool, sw: i32) u64 {
    let mut n = bi + 1;
    while (n < MF.blocks.len) and skip[n] and not lal[n] and (@as(i32, @int_cast(i32, n)) != sw) {
        n += 1;
    }
    if (n >= MF.blocks.len) or lal[n] or (@as(i32, @int_cast(i32, n)) == sw) {
        return 0;
    }
    let mut j = MF.blocks.get(n).first;
    while u.notnil(j) and enc_nothing(j) {
        j = j.next;
    }
    if u.isnil(j) or (j.op != xe.JCC) {
        return 0;
    }
    if (jnext < jshort.len) and jshort.get(jnext) {
        return 2;
    }
    return 6;
}

// The blocks whose start is aligned to LALIGN bytes: hot loop tops (LMODE 1:
// targets of a jump back from later in the function; 2: like LLVM, any
// block in a loop, run at least a fifth as often as a loop header, that
// its layout predecessor does not fall into as often as a fifth of its runs).
fn loop_aligned(skip: []bool) []mut bool {
    let nb = MF.blocks.len;
    let al = u.newn.[bool](nb + 1);
    for bi in 0..nb {
        al[bi] = false;
    }
    if LALIGN == 0 {
        return al;
    }
    let back = u.newn.[bool](nb + 1);
    for bi in 0..nb {
        back[bi] = false;
    }
    for bi in 0..nb {
        if skip[bi] {
            continue;
        }
        let mut i = MF.blocks.get(bi).first;
        while u.notnil(i) {
            if ((i.op == xe.JMP) or (i.op == xe.JCC)) and (i.ops[0].label < xe.LOCAL_BASE) and
               (@as(usize, @int_cast(usize, i.ops[0].label)) <= bi) {
                back[@int_cast(usize, i.ops[0].label)] = true;
            }
            i = i.next;
        }
    }
    for bi in 1..nb {
        let b = MF.blocks.get(bi);
        if skip[bi] or (b.loop_depth == 0) or b.cold {
            continue;
        }
        if LMODE == 1 {
            if not back[bi] {
                continue;
            }
        } else if b.freq < 0.2 * mc.LOOP_SCALE {
            continue;
        }
        // the layout predecessor, and how often it falls into b
        let mut p = bi - 1;
        while (p > 0) and skip[p] {
            p -= 1;
        }
        let pb = MF.blocks.get(p);
        let mut fall: f64 = 0.0;
        if not ends_flow(pb) {
            fall = pb.freq;
            let l = pb.last;
            if u.notnil(l) and (l.op == xe.JCC) {
                fall = pb.freq * 0.5;
            }
        }
        if fall <= 0.2 * b.freq {
            al[bi] = true;
        }
    }
    return al;
}

// A leaf with nothing on the stack needs no frame.
let mut frameless: bool = false;

// Shrink-wrapping (mc.shrink_wrap; not on Windows, whose unwind tables
// describe a prologue at the start): blocks before SW run without the frame,
// which block SW sets up; in_noframe while they are encoded.
pub let mut SW: i32 = -1;
let mut in_noframe: bool = false;
pub const CALLEE_SAVED: u64 = (
    ((@as(u64, 1) << 3) | (@as(u64, 1) << 12)) | ((@as(u64, 1) << 13) | (@as(u64, 1) << 14))) | (@as(u64, 1) << 15);  // rbx r12-r15

// Does i need no frame: no call, no stack, no callee-saved register?
pub fn sw_frame_free(i: *mc.MInst) bool {
    if (i.clobber != 0) or (i.op == xe.CPUID) or (i.op == xe.REP) {
        return false;  // (a call that does not return clobbers nothing: a trap's is fine)
    }
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if o.kind == mc.K_REG {
            let r = P(o.reg);
            if (r == xe.RSP) or (r == xe.RBP) or
               ((r >= 0) and (r < 64) and ((CALLEE_SAVED & (@as(u64, 1) << @int_cast(u32, r))) != 0)) {
                return false;
            }
        } else if o.kind == mc.K_MEM {
            if o.slot >= 0 {
                return false;
            }
            let rs: [2]i32 = [o.base, o.index];
            for x in rs {
                let r = P(x);
                if (r == xe.RSP) or (r == xe.RBP) or
                   ((r >= 0) and (r < 64) and ((CALLEE_SAVED & (@as(u64, 1) << @int_cast(u32, r))) != 0)) {
                    return false;
                }
            }
        }
    }
    return true;
}

// A stack argument's load (rematerialized: see compile_func).
pub fn sw_movable(i: *mc.MInst) bool {
    return (i.op == xe.LOAD) and (i.ops.len == 2) and (i.ops[1].kind == mc.K_MEM) and (i.ops[1].base == xe.RBP) and
           (i.ops[1].disp > 0) and (i.ops[1].index < 0);
}

pub fn is_ret(i: *mc.MInst) bool {
    return (i.op == xe.RET) or is_tail(i);
}

// A CALL with this cc leaves the function: the epilogue, then a jump to the
// callee (x64.ax: gen_tail_call; enc_tail). Its aux is the bytes of stack
// arguments it copies up into the incoming area.
pub const TAIL: i32 = 1;

pub fn is_tail(i: *mc.MInst) bool {
    return (i.op == xe.CALL) and (i.cc == TAIL);
}

fn needs_frame() bool {
    if (nsaved > 0) or (nxsaved > 0) or (MF.slots.len > 0) or (out_area != 0) {
        return true;
    }
    for bi in 0..MF.blocks.len {
        let mut i = MF.blocks.get(bi).first;
        while u.notnil(i) {
            if i.clobber != 0 {
                return true;  // a call that returns (a noreturn one only needs the stack aligned)
            }
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == mc.K_REG) and ((P(o.reg) == xe.RSP) or (P(o.reg) == xe.RBP)) {
                    return true;
                }
                if (o.kind == mc.K_MEM) and
                   ((o.slot >= 0) or (o.base == xe.RBP) or (o.base == xe.RSP) or (o.index == xe.RBP) or
                    (o.index == xe.RSP)) {
                    return true;
                }
            }
            i = i.next;
        }
    }
    return false;
}

// movups [rbp + disp], xmm (store) or movups xmm, [rbp + disp]
fn xmm_rbp(x: i32, disp: i64, store: bool) void {
    let r = x - xe.XMM0;
    if r >= 8 {
        b8(0x44);
    }
    b8(0x0f);
    if store {
        b8(0x11);
    } else {
        b8(0x10);
    }
    b8(0x85 | (@as(u64, @bit_cast(u32, r & 7)) << 3));
    E.b.u32_(@bit_cast(u64, disp));
}

fn xmm_save_off(k: i64) i64 {
    return -((8 * nsaved) + (16 * (k + 1)));
}

fn epilogue() void {
    unframe();
    b8(0xc3);
    cfi_body();
}

// -g: the call frame states as the function is encoded (dwarf.cfi_state;
// none unless DBG is on), and the registers the frame saves (dwarf.saved_reg):
// rbp at CFA - 16, then the pushed callee-saved registers below it.
let mut cfis: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };
let mut cfi_regs: [20]u64 = [0; 20];
// our register numbers -> DWARF's (rax rcx rdx rbx rsp rbp rsi rdi -> 0 2 1 3 7 6 4 5)
let DW_GPR: [16]u32 = [0, 2, 1, 3, 7, 6, 4, 5, 8, 9, 10, 11, 12, 13, 14, 15];

// From here on: CFA = reg + 8k, the save list's registers in mask saved.
fn cfi(reg: u32, k: u64, mask: u64) void {
    if not DBG.on {
        return;
    }
    let at = @as(u64, E.b.len());
    let st = dw.cfi_state(at, reg, k, mask);
    if (cfis.len > 0) and ((cfis.last() & 0xffff_ffff) == at) {
        cfis.set(cfis.len - 1, st);
        return;
    }
    cfis.push(st);
}

// The state at a function's entry (and in blocks run without the frame).
fn cfi_entry() void {
    cfi(dw.X64_RSP, 1, 0);
}

// The state in the function's body: CFA = rbp + 16, rbp and the callee-saved
// registers saved (or, without a frame, the entry's).
fn cfi_body() void {
    if frameless or in_noframe {
        cfi_entry();
        return;
    }
    cfi(dw.X64_RBP, 2, (@as(u64, 1) << @int_cast(u32, nsaved + 1)) - 1);
}

// The epilogue but its ret: the callee-saved registers and the caller's
// frame back.
fn unframe() void {
    if frameless or in_noframe {
        return;
    }
    for k in 0..nxsaved {
        xmm_rbp(xsaved[@int_cast(usize, k)], xmm_save_off(k), false);
    }
    if nsaved > 0 {
        // lea rsp, [rbp - 8*nsaved]
        b8(0x48);
        b8(0x8d);
        let d = -8 * nsaved;
        if d >= -128 {
            b8(0x65);
            b8(@bit_cast(u64, d));
        } else {
            b8(0xa5);
            E.b.u32_(@bit_cast(u64, d));
        }
        let mut k = nsaved;
        while k > 0 {
            k -= 1;
            let r = saved[@int_cast(usize, k)];
            if r >= 8 {
                b8(0x41);
            }
            b8(0x58 + @as(u64, @bit_cast(u32, r & 7)));
            cfi(dw.X64_RBP, 2, (@as(u64, 1) << @int_cast(u32, k + 1)) - 1);  // (restored)
        }
        b8(0x5d);  // pop rbp
    } else {
        b8(0xc9);  // leave
    }
    cfi_entry();
}

// A sibling call (is_tail): its stack arguments, which the outgoing area
// holds, copied up through r10 to where the function's own came in
// (rbp + 16, past Windows' home area), then the epilogue and a jump to the
// callee: `jmp rel32`, or `rex.w jmp r11` for a call through a pointer. Both
// are forms Windows' unwinder takes as the end of an epilogue (a jump
// leaving the function: rel32, or an indirect one with REX.W), and the frame
// tables have no entry for it (no return address: the callee's is the
// caller's).
fn enc_tail(i: *mut mc.MInst) void {
    if UPPER and DIRTY {
        vzeroupper();
    }
    let mut sh: i64 = 0;
    if WIN {
        sh = 32;
    }
    let mut k: i64 = 0;
    while k < i.aux {
        enc_op(8, 1, 0x8b, 0, xe.R10, mc.mem(xe.RSP, -1, 0, sh + k), 0, false);
        enc_op(8, 1, 0x89, 0, xe.R10, mc.mem(xe.RBP, -1, 0, 16 + sh + k), 0, false);
        k += 8;
    }
    unframe();
    let t = i.ops[0];
    if t.kind == mc.K_SYM {
        b8(0xe9);
        E.relocs.push(xe.Reloc.{ off: @as(u64, E.b.len()), ty: elf.R_X86_64_PLT32, sym: t.sym, addend: -4 });
        E.b.u32_(0);
    } else {
        enc_op(8, 1, 0xff, 0, 4, t, 0, false);
    }
    cfi_body();
}

// Windows: a function's line table, into .axiom.lines for plink.ax (which
// writes the PDB). The section is a series of records: 'F', a file's path
// (u32 length, bytes; files are numbered in order), or 'P', a function: its
// symbol's name (u32 length, bytes), the number of rows, and rows of code
// offset, file number and line (u32 each). rows: offset << 32 | ir.src_loc.
// Files and lines are the presumed ones (C's #line).
pub let mut line_file: [4096]u32 = [0; 4096];  // file id (without #line) -> its number + 1 in the section
pub let mut nline_files: u32 = 0;
pub let mut line_names: u.SymMap.[u32] = u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0),
                                                          vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 };

// The section's number of the file of location src, and its line there.
fn line_of(src: u32, line: *mut u32) u32 {
    let file = ir.src_file(src);
    let k = @as(usize, @bit_cast(u32, file));
    line.* = ir.src_line(src);
    let sf = u.file_of(file);
    if (sf.marks.len == 0) and (line_file[k] != 0) {
        return line_file[k] - 1;
    }
    let mut path = u.real_path(sf.path);
    if u.isnos(path) {
        path = sf.path;
    }
    if sf.marks.len > 0 {
        let p = u.presumed_line(file, @bit_cast(i32, line.*));
        if p.marked {
            path = p.name;
            line.* = @truncate(u32, @bit_cast(u64, @max(p.line, 0)));
        }
    }
    let key = u.intern(path);
    let mut n = line_names.get(key);
    if n == 0 {
        let d = &mut OBJ.secs.get(@int_cast(usize, LINES)).data;
        d.u8_('F');
        d.u32_(@as(u64, path.len));
        d.put(path);
        nline_files += 1;
        n = nline_files;
        line_names.put(key, n);
    }
    if sf.marks.len == 0 {
        line_file[k] = n;
    }
    return n - 1;
}

fn emit_lines(name: []u8, rows: []u64) void {
    let mut files = u.List.[u64].empty();
    for r in rows {
        let mut line: u32 = 0;
        let f = line_of(@truncate(u32, r), &mut line);
        files.push((@as(u64, f) << 32) | @as(u64, line));
    }
    let d = &mut OBJ.secs.get(@int_cast(usize, LINES)).data;
    d.u8_('P');
    d.u32_(@as(u64, name.len));
    d.put(name);
    d.u32_(@as(u64, rows.len));
    for k in 0..rows.len {
        d.u32_(rows[k] >> 32);
        d.u32_(files.get(k) >> 32);
        d.u32_(files.get(k) & 0xffff_ffff);
    }
    files.deinit();
}

// Windows: what the prologue did, step by step, for the function's unwind
// information (see unwind_info).
const UW_PUSH: u32 = 0;   // pushed register `reg`
const UW_ALLOC: u32 = 1;  // lowered rsp by `val`
const UW_XMM: u32 = 2;    // stored xmm `reg` at [rsp + val]
const UW_SETFP: u32 = 3;  // rbp = rsp (a function whose stack pointer moves: xe.DYNSTACK)

struct UnwindStep {
    off: u64,  // the code offset just after it
    op: u32,
    reg: u32,
    val: u64,
}

let mut uw: [24]UnwindStep = [UnwindStep.{ off: 0, op: 0, reg: 0, val: 0 }; 24];
let mut nuw: usize = 0;
let mut prologue_end: u64 = 0;

fn uw_step(op: u32, r: i32, val: u64) void {
    uw[nuw] = UnwindStep.{ off: @as(u64, E.b.len()), op: op, reg: @bit_cast(u32, r), val: val };
    nuw += 1;
}

fn prologue(sub: i64) void {
    nuw = 0;
    prologue_end = 0;
    if frameless {
        return;
    }
    b8(0x55);  // push rbp
    uw_step(UW_PUSH, xe.RBP, 0);
    cfi(dw.X64_RSP, 2, 1);
    b8(0x48);
    b8(0x89);
    b8(0xe5);  // mov rbp, rsp
    cfi(dw.X64_RBP, 2, 1);
    if WIN and dyn_stack() {
        uw_step(UW_SETFP, xe.RBP, 0);
    }
    for k in 0..@int_cast(usize, nsaved) {
        let r = saved[k];
        if r >= 8 {
            b8(0x41);
        }
        b8(0x50 + @as(u64, @bit_cast(u32, r & 7)));
        uw_step(UW_PUSH, r, 0);
        cfi(dw.X64_RBP, 2, (@as(u64, 1) << @int_cast(u32, k + 2)) - 1);
    }
    if sub > 0 {
        // touch each page of a large frame in order (stack guard)
        let mut rem = sub;
        while rem > 4096 {
            b8(0x48);
            b8(0x81);
            b8(0xec);
            E.b.u32_(4096);
            // or qword [rsp], 0
            b8(0x48);
            b8(0x83);
            b8(0x0c);
            b8(0x24);
            b8(0x00);
            rem -= 4096;
        }
        b8(0x48);
        b8(0x81);
        b8(0xec);
        E.b.u32_(@bit_cast(u64, rem));
        uw_step(UW_ALLOC, 0, @bit_cast(u64, sub));
    }
    for k in 0..nxsaved {
        xmm_rbp(xsaved[@int_cast(usize, k)], xmm_save_off(k), true);
        // rbp - 8*nsaved - sub is rsp, so the save is at rsp + sub + its offset
        uw_step(UW_XMM, xsaved[@int_cast(usize, k)] - xe.XMM0, @bit_cast(u64, sub + xmm_save_off(k) + (8 * nsaved)));
    }
    prologue_end = @as(u64, E.b.len());
}

// Does MF move the stack pointer after the prologue (xe.DYNSTACK)?
fn dyn_stack() bool {
    for bi in 0..MF.blocks.len {
        let mut i = MF.blocks.get(bi).first;
        while u.notnil(i) {
            if i.op == xe.DYNSTACK {
                return true;
            }
            i = i.next;
        }
    }
    return false;
}

// The function's UNWIND_INFO for Windows x64, which the system's stack
// walker (exception dispatch, stack traces) needs for every function with a
// frame: version 1, no handler, the prologue's size, the number of code
// slots, no frame register (rsp stays put after the prologue, and rbp is
// described as a saved register; but see below), then the codes in reverse order of the
// prologue's steps: push (UWOP_PUSH_NONVOL), sub rsp (UWOP_ALLOC_SMALL or
// _LARGE), xmm saves (UWOP_SAVE_XMM128_FAR, at an unscaled offset from rsp).
// Offsets past 255 (only in prologues with large frames' probes) are
// clamped. A function whose stack pointer moves after the prologue
// (DYNSTACK) has rbp as its frame register: see dyn_unwind_codes.
fn unwind_info() bn.Bytes {
    for k0 in 0..nuw {
        if uw[k0].op == UW_SETFP {
            return dyn_unwind_info();
        }
    }
    let mut codes = bn.new_bytes();
    let mut n: u64 = 0;
    let mut k = nuw;
    while k > 0 {
        k -= 1;
        let s = uw[k];
        let off = @min(s.off, 255);
        if s.op == UW_PUSH {
            codes.u8_(@truncate(u8, off));
            codes.u8_(@truncate(u8, 0 | (@as(u64, s.reg) << 4)));
            n += 1;
        } else if s.op == UW_SETFP {
            codes.u8_(@truncate(u8, off));
            codes.u8_(3);
            n += 1;
        } else if s.op == UW_ALLOC {
            if s.val <= 128 {
                codes.u8_(@truncate(u8, off));
                codes.u8_(@truncate(u8, 2 | (((s.val / 8) - 1) << 4)));
                n += 1;
            } else if s.val <= 524280 {
                codes.u8_(@truncate(u8, off));
                codes.u8_(@truncate(u8, 1));
                codes.u16_(s.val / 8);
                n += 2;
            } else {
                codes.u8_(@truncate(u8, off));
                codes.u8_(@truncate(u8, 1 | (1 << 4)));
                codes.u32_(s.val);
                n += 3;
            }
        } else {
            codes.u8_(@truncate(u8, off));
            codes.u8_(@truncate(u8, 9 | (@as(u64, s.reg) << 4)));
            codes.u32_(s.val);
            n += 3;
        }
    }
    if (n & 1) != 0 {
        codes.u16_(0);  // an even number of slots
    }
    let mut b = bn.new_bytes();
    b.u8_(1);
    b.u8_(@truncate(u8, @min(prologue_end, 255)));
    b.u8_(@truncate(u8, n));
    let mut fr: u64 = 0;
    for k2 in 0..nuw {
        if uw[k2].op == UW_SETFP {
            fr = 5;  // (rbp, at offset 0)
        }
    }
    b.u8_(@truncate(u8, fr));
    b.put(codes.view());
    codes.free();
    return b;
}

// The UNWIND_INFO of a function whose stack pointer moves after the
// prologue (a variable length array, alloca): the system's walk must not
// read anything relative to rsp, which is not where the prologue left it.
// The x64 unwinding rules: with a frame register, the frame's base is
// FrameRegister - 16 * FrameOffset (from the header); UWOP_SAVE_NONVOL_FAR
// and UWOP_SAVE_XMM128_FAR restore a register from base + offset,
// UWOP_SET_FPREG sets rsp to the base, UWOP_ALLOC_* adds to rsp,
// UWOP_PUSH_NONVOL pops; the codes are applied in the order they are listed
// (the reverse of the prologue's), each once the code before its offset has
// run. The prologue keeps rbp at the frame's top (push rbp; mov rbp, rsp:
// rbp-relative slots and the frame chain of stack traces rely on it), and
// saves the callee-saved registers below it, within 216 bytes (7 pushes, 10
// xmm registers), so the codes describe it from a base 16 * FrameOffset
// bytes below rbp (FrameOffset at most 15): each saved register at its
// offset above the base, then rsp = the base, plus 16 * FrameOffset is rbp,
// then rbp's push. All of it is relative to rbp, which the function does not
// change: right wherever the stack pointer is, in the body and from the
// prologue's second instruction on.
fn dyn_unwind_info() bn.Bytes {
    let mut setfp_off: u64 = 0;
    let mut push_off: u64 = 0;
    for k in 0..nuw {
        if uw[k].op == UW_SETFP {
            setfp_off = uw[k].off;
        } else if (uw[k].op == UW_PUSH) and (uw[k].reg == @bit_cast(u32, xe.RBP)) {
            push_off = uw[k].off;
        }
    }
    let below = (8 * @bit_cast(u64, nsaved)) + (16 * @bit_cast(u64, nxsaved));
    let fo = (below + 15) / 16;
    let mut codes = bn.new_bytes();
    let mut n: u64 = 0;
    let mut k = nuw;
    while k > 0 {
        k -= 1;
        let s = uw[k];
        let off = @min(s.off, 255);
        if (s.op == UW_PUSH) and (s.reg != @bit_cast(u32, xe.RBP)) {
            // the k-th push after rbp's: at rbp - 8 * (its place + 1)
            let mut place: u64 = 0;
            for j in 0..k {
                if (uw[j].op == UW_PUSH) and (uw[j].reg != @bit_cast(u32, xe.RBP)) {
                    place += 1;
                }
            }
            codes.u8_(@truncate(u8, off));
            codes.u8_(@truncate(u8, 5 | (@as(u64, s.reg) << 4)));  // UWOP_SAVE_NONVOL_FAR
            codes.u32_((16 * fo) - (8 * (place + 1)));
            n += 3;
        } else if s.op == UW_XMM {
            // at rsp + val after the prologue, rsp = rbp - 8 * nsaved - sub:
            // rbp - (8 * nsaved + sub - val)
            let sub = alloc_of();
            let depth = ((8 * @bit_cast(u64, nsaved)) + sub) - s.val;
            codes.u8_(@truncate(u8, off));
            codes.u8_(@truncate(u8, 9 | (@as(u64, s.reg) << 4)));  // UWOP_SAVE_XMM128_FAR
            codes.u32_((16 * fo) - depth);
            n += 3;
        }
    }
    let sf = @min(setfp_off, 255);
    codes.u8_(@truncate(u8, sf));
    codes.u8_(3);  // UWOP_SET_FPREG: rsp = rbp - 16 * fo
    n += 1;
    let lift = 16 * fo;
    if lift > 0 {
        codes.u8_(@truncate(u8, sf));
        if lift <= 128 {
            codes.u8_(@truncate(u8, 2 | (((lift / 8) - 1) << 4)));  // UWOP_ALLOC_SMALL
            n += 1;
        } else {
            codes.u8_(1);  // UWOP_ALLOC_LARGE, in 8-byte units
            codes.u16_(lift / 8);
            n += 2;
        }
    }
    codes.u8_(@truncate(u8, @min(push_off, 255)));
    codes.u8_(@truncate(u8, 0 | (@as(u64, @bit_cast(u32, xe.RBP)) << 4)));  // UWOP_PUSH_NONVOL rbp
    n += 1;
    if (n & 1) != 0 {
        codes.u16_(0);  // an even number of slots
    }
    let mut b = bn.new_bytes();
    b.u8_(1);
    b.u8_(@truncate(u8, @min(prologue_end, 255)));
    b.u8_(@truncate(u8, n));
    b.u8_(@truncate(u8, 5 | (fo << 4)));  // rbp, at the offset fo
    b.put(codes.view());
    codes.free();
    return b;
}

// The prologue's allocation (UW_ALLOC's bytes), or 0.
fn alloc_of() u64 {
    for k in 0..nuw {
        if uw[k].op == UW_ALLOC {
            return uw[k].val;
        }
    }
    return 0;
}

// Windows: the function placed at `base` in .text with `size` bytes gets its
// unwind information in .xdata and an entry in .pdata (start, end, unwind
// information: addresses relative to the image, which plink.ax resolves).
fn emit_unwind(fs: u32, base: u64, size: u64) void {
    let x = OBJ.secs.get(@int_cast(usize, XDATA));
    x.data.align(4);
    let xoff = @as(u64, x.data.len());
    let mut info = unwind_info();
    x.data.put(info.view());
    info.free();
    let p = OBJ.secs.get(@int_cast(usize, PDATA));
    let poff = @as(u64, p.data.len());
    p.data.zeros(12);
    p.relocs.push(elf.Rel.{ off: poff, ty: elf.R_X86_64_RVA32, sym: fs, addend: 0 });
    p.relocs.push(elf.Rel.{ off: poff + 4, ty: elf.R_X86_64_RVA32, sym: fs, addend: @bit_cast(i64, size) });
    p.relocs.push(elf.Rel.{ off: poff + 8, ty: elf.R_X86_64_RVA32, sym: XDATA_SYM, addend: @bit_cast(i64, xoff) });
}

fn enc_sse(i: *mut mc.MInst) void {
    let id = i.cc;
    let o0 = i.ops[0];
    let o1 = i.ops[1];
    let o2 = i.ops[2];
    let o3 = i.ops[3];
    let mut rf: i32 = 0;
    if o0.kind == mc.K_REG {
        rf = P(o0.reg);
    }
    let mut vv: i32 = -1;
    if o2.kind == mc.K_REG {
        vv = P(o2.reg);
    }
    let has_imm = o3.kind == mc.K_IMM;
    let wide = i.sz == 8;
    let mut vl: u64 = 0;  // (sz 32: a 256-bit operation, 64: a 512-bit one)
    if i.sz == 32 {
        vl = 1;
    } else if i.sz == 64 {
        vl = 2;
    }
    if o1.kind == mc.K_REG {
        let m = xe.Mem.{ base: -1, index: -1, scale: 0, disp: 0, sym: -1, tpoff: false };
        xe.sse(&mut E, id, rf, P(o1.reg), &m, vv, o3.disp, has_imm, wide, vl,
               (@bit_cast(u64, i.aux) & 15) | (@bit_cast(u64, i.aux) & 32));
    } else {
        let mut m = to_mem(o1);
        xe.sse(&mut E, id, rf, -1, &m, vv, o3.disp, has_imm, wide, vl, @bit_cast(u64, i.aux) & 63);
    }
}

// mov d, x: mov r32, imm32 (zero-extending) when x fits, else the
// sign-extending mov r/m64, imm32 or mov r64, imm64.
fn enc_mov_ri(sz: u8, d: i32, x: i64) void {
    if sz == 8 and not ((x >= 0) and (x <= 0xffff_ffff)) {
        b8(0x48 | @as(u64, @bit_cast(u32, (d >> 3) & 1)));
        if is.fits32(x) {
            b8(0xc7);
            b8(0xc0 | @as(u64, @bit_cast(u32, d & 7)));
            E.b.u32_(@bit_cast(u64, x));
            return;
        }
        b8(0xb8 + @as(u64, @bit_cast(u32, d & 7)));
        E.b.u64_(@bit_cast(u64, x));
        return;
    }
    if d >= 8 {
        b8(0x41);
    }
    b8(0xb8 + @as(u64, @bit_cast(u32, d & 7)));
    E.b.u32_(@bit_cast(u64, x));
}

// A load into a register: a narrow one zero-extended (cc 1) or
// sign-extended (cc 2), or an address from the GOT (scale 99).
fn enc_load(i: *mut mc.MInst) void {
    let sz = i.sz;
    let d = P(i.ops[0].reg);
    let m = i.ops[1];
    if m.scale == 99 {
        // mov r64, [rip + sym@GOTPCREL]
        b8(0x48 | (@as(u64, @bit_cast(u32, (d >> 3) & 1)) << 2));
        b8(0x8b);
        b8(0x05 | (@as(u64, @bit_cast(u32, d & 7)) << 3));
        E.relocs.push(xe.Reloc.{ off: @as(u64, E.b.len()), ty: elf.R_X86_64_REX_GOTPCRELX, sym: m.sym, addend: -4 });
        E.b.u32_(0);
        return;
    }
    let k = i.cc;
    if (k == 1) and (sz <= 2) {
        enc_op(4, 2, 0x0f, u.pick(sz == 1, "\xb6", "\xb7")[0], d, m, 0, false);
        return;
    }
    if (k == 2) and (sz <= 2) {
        enc_op(4, 2, 0x0f, u.pick(sz == 1, "\xbe", "\xbf")[0], d, m, 0, false);
        return;
    }
    if sz == 1 {
        enc_op(4, 2, 0x0f, 0xb6, d, m, 0, false);
        return;
    }
    enc_op(sz, 1, 0x8b, 0, d, m, 0, false);
}

// The arithmetic group (/digit cc: add, or, adc, sbb, and, sub, xor, cmp)
// with an immediate, a register or a memory operand.
fn enc_alu(i: *mut mc.MInst) void {
    let sz = i.sz;
    let digit = i.cc;
    let s = i.ops[1];
    if s.kind == mc.K_IMM {
        // (the destination may be memory: cmp [m], k)
        let x = s.disp;
        let rm = i.ops[0];
        if (sz != 1) and (x >= -128) and (x <= 127) {
            enc_op(sz, 1, 0x83, 0, digit, rm, 1, false);
            enc_imm(x, 1);
        } else {
            enc_op_sz(sz, 1, 0x80, 0, digit, true, rm, imm_len(sz));
            enc_imm(x, imm_len(sz));
        }
        return;
    }
    let base = @truncate(u8, @bit_cast(u32, digit)) * 8;
    if i.ops[0].kind == mc.K_MEM {
        // op [m], r
        enc_op_sz(sz, 1, base, 0, P(s.reg), false, i.ops[0], 0);
        return;
    }
    enc_op_sz(sz, 1, base + 2, 0, P(i.ops[0].reg), false, s, 0);
}

// A VEX-encoded BMI instruction on general registers: VEX.LZ.pp.0F38.W
// opc, reg field r (a register or a /digit), vvvv and r/m register rm.
fn enc_vex_0f38(sz: u8, pp: u64, opc: u64, r: i32, vvvv: i32, rm: i32) void {
    let mut w: u64 = 0;
    if sz == 8 {
        w = 1;
    }
    b8(0xc4);
    b8(
        ((((~@as(u64, @bit_cast(u32, r >> 3))) & 1) << 7) | (1 << 6)) | (
            (((~@as(u64, @bit_cast(u32, rm >> 3))) & 1) << 5) | 2));
    b8(((w << 7) | (((~@as(u64, @bit_cast(u32, vvvv))) & 15) << 3)) | pp);
    b8(opc);
    xe.modrm_rr(&mut E, @as(u64, @bit_cast(u32, r)), @as(u64, @bit_cast(u32, rm)));
}

// bswap r: [REX] 0F C8+r
fn enc_bswap(sz: u8, r: i32) void {
    let mut v: u64 = @as(u64, @bit_cast(u32, r & 15)) >> 3;
    if sz == 8 {
        v = v | 8;
    }
    if v != 0 {
        b8(0x40 | v);
    }
    b8(0x0f);
    b8(0xc8 + @as(u64, @bit_cast(u32, r & 7)));
}

// A call of symbol or register (or memory) t.
fn enc_call(t: mc.MOp) void {
    if UPPER and DIRTY {
        vzeroupper();
    }
    DIRTY = false;  // (the callee returns with the upper halves clear)
    let nf = frameless or in_noframe;
    if nf and WIN {
        // (every call on Windows has its shadow space, which gives the function
        // a frame: one without has no unwind information for this)
        fail("internal compiler error: a call in a function without a frame (Windows)");
    }
    if nf {
        // sub rsp, 8: the call (which does not return) needs rsp aligned
        E.b.put("\x48\x83\xec\x08");
        cfi(dw.X64_RSP, 2, 0);
    }
    if t.kind == mc.K_SYM {
        b8(0xe8);
        E.relocs.push(xe.Reloc.{ off: @as(u64, E.b.len()), ty: elf.R_X86_64_PLT32, sym: t.sym, addend: -4 });
        E.b.u32_(0);
    } else {
        enc_op(4, 1, 0xff, 0, 2, t, 0, false);
    }
    if nf {
        cfi_entry();  // (the code after it is reached without the sub)
    }
}

// [66] F2 [REX] 0F 38 F0/F1 /r: crc32 r32/r64, r/m8/16/32/64 (register m)
fn enc_crc32(sz: u8, r: i32, m: i32) void {
    if sz == 2 {
        b8(0x66);
    }
    b8(0xf2);
    let mut rex: u64 = 0;
    if sz == 8 {
        rex = rex | 8;
    }
    if r >= 8 {
        rex = rex | 4;
    }
    if m >= 8 {
        rex = rex | 1;
    }
    if (rex != 0) or ((sz == 1) and (m >= 4)) {
        b8(0x40 | rex);
    }
    b8(0x0f);
    b8(0x38);
    if sz == 1 {
        b8(0xf0);
    } else {
        b8(0xf1);
    }
    b8(0xc0 | ((@as(u64, @bit_cast(u32, r)) & 7) << 3) | (@as(u64, @bit_cast(u32, m)) & 7));
}

// rep movsb (cc 0), rep stosb (1), or a memmove (2) of rcx bytes from rsi
// to rdi.
fn enc_rep(cc: i32) void {
    if cc == 0 {
        E.b.put("\xf3\xa4");
    } else if cc == 1 {
        E.b.put("\xf3\xaa");
    } else {
        // memmove: backwards when the destination is above the source, by
        // at most the length (it overlaps the source's end); forwards when
        // it is the source itself (copied onto itself) or below, or apart
        // mov rax, rdi; sub rax, rsi; dec rax; cmp rax, rcx; jae fwd
        let seq: [12]u8 = [0x48, 0x89, 0xf8, 0x48, 0x29, 0xf0, 0x48, 0xff, 0xc8, 0x48, 0x39, 0xc8];
        E.b.put(seq[..]);
        b8(0x73);
        b8(0x10);  // jae +16 (over the backward copy)
        // lea rsi, [rsi+rcx-1]; lea rdi, [rdi+rcx-1]; std; rep movsb; cld; jmp done
        let back: [17]u8 = [0x48, 0x8d, 0x74, 0x0e, 0xff, 0x48, 0x8d, 0x7c, 0x0f, 0xff, 0xfd, 0xf3, 0xa4, 0xfc, 0xeb,
                            0x02, 0x90];
        E.b.put(back[0..16]);
        // fwd: rep movsb
        b8(0xf3);
        b8(0xa4);
    }
}

// REX.W with the R and B bits of registers r and b.
fn rex_wrb(r: i32, b: i32) void {
    b8(@as(u64, 0x48 | (@bit_cast(u32, r >> 3) << 2)) | @as(u64, @bit_cast(u32, b >> 3)));
}

// xe.DYNSTACK: the stack pointer moved, for dynamic allocation.
fn enc_dynstack(i: *mut mc.MInst) void {
    if i.cc == 1 {
        let d = P(i.ops[0].reg);
        rex_wrb(0, d);
        b8(0x89);
        b8(0xe0 | @as(u64, @bit_cast(u32, d & 7)));  // mov d, rsp
        return;
    }
    if i.cc == 2 {
        let s = P(i.ops[0].reg);
        rex_wrb(0, s);
        b8(0x8b);
        b8(0xe0 | @as(u64, @bit_cast(u32, s & 7)));  // mov rsp, s
        return;
    }
    let t = P(i.ops[0].reg);
    let d = P(i.ops[1].reg);
    let tl = @as(u64, @bit_cast(u32, t & 7));
    // t = (t + 15) & -16
    rex_wrb(0, t);
    b8(0x83);
    b8(0xc0 | tl);
    b8(0x0f);
    rex_wrb(0, t);
    b8(0x83);
    b8(0xe0 | tl);
    b8(0xf0);
    // while t > 4096: one page more, touched (as the prologue does)
    rex_wrb(0, t);
    b8(0x81);
    b8(0xf8 | tl);
    E.b.u32_(4096);  // cmp t, 4096
    b8(0x76);
    b8(21);  // jbe (past the loop)
    b8(0x48);
    b8(0x81);
    b8(0xec);
    E.b.u32_(4096);  // sub rsp, 4096
    b8(0x48);
    b8(0x83);
    b8(0x0c);
    b8(0x24);
    b8(0x00);  // or qword [rsp], 0
    rex_wrb(0, t);
    b8(0x81);
    b8(0xe8 | tl);
    E.b.u32_(4096);  // sub t, 4096
    b8(0xeb);
    b8(0xe2);  // jmp (back to the cmp: -30)
    rex_wrb(t, 0);
    b8(0x29);
    b8(0xc4 | (tl << 3));  // sub rsp, t
    // d = rsp + the outgoing arguments' area (below the allocation)
    rex_wrb(d, 0);
    b8(0x8d);
    b8(0x84 | (@as(u64, @bit_cast(u32, d & 7)) << 3));
    b8(0x24);
    E.b.u32_(out_area);
}

// Jump tables (x64.ax gen_jump_table): the jumps of the pass being encoded,
// whose tables are filled in once the function's place is known
// (fill_jump_tables), and a local symbol at the start of .text for their
// entries (made once per object: JT_OBJ).
let mut jtabs: u.List.[*mut mc.MInst] = u.List.[*mut mc.MInst].{ data: @ptr_from_int(*mut *mut mc.MInst, 0), len: 0,
                                                                 cap: 0 };
pub let mut JT_OBJ: *mut elf.Obj = @ptr_from_int(*mut elf.Obj, 0);  // (x64.ax compile resets it)
let mut JT_TEXT: u32 = 0;

// lea t, [rip + table]; movsxd u, dword [t + index*4]; add t, u; jmp t
fn enc_jtab(i: *mut mc.MInst) void {
    let ix = P(i.ops[0].reg);
    let t = P(i.ops[1].reg);
    let v = P(i.ops[2].reg);
    enc_op(8, 1, 0x8d, 0, t, mc.mem_sym(@truncate(i32, i.aux), 0), 0, false);
    enc_op(8, 1, 0x63, 0, v, mc.mem(t, ix, 4, 0), 0, false);
    enc_op(8, 1, 0x01, 0, v, mc.reg(t, mc.RUD), 0, false);
    enc_op(4, 1, 0xff, 0, 4, mc.reg(t, mc.RU), 0, false);
    jtabs.push(i);
}

// The entries of the tables of the function's jumps through one (encoded
// at base in .text, its blocks at boff): each the 32-bit offset of its
// target from the table's start, a PC-relative relocation against .text
// with the entry's own offset added back (S + A - P, P the entry's address).
fn fill_jump_tables(base: u64, boff: []u64) void {
    if jtabs.len == 0 {
        return;
    }
    if JT_OBJ != OBJ {
        JT_OBJ = OBJ;
        JT_TEXT = elf.add_sym(OBJ, elf.Sym.{ name: "", sec: TEXT, value: 0, size: 0, bind: elf.B_LOCAL,
                                             ty: elf.T_NOTYPE, hidden: false });
    }
    for j in jtabs.items() {
        let ts = OBJ.syms.at(@as(usize, @bit_cast(u32, @truncate(i32, j.aux))));
        let sec = OBJ.secs.get(@int_cast(usize, ts.sec));
        for k in 3..j.ops.len {
            let eo = 4 * @as(u64, k - 3);
            let target = base + boff[@int_cast(usize, j.ops[k].label)];
            sec.relocs.push(
                elf.Rel.{
                    off: ts.value + eo, ty: elf.R_X86_64_PC32, sym: JT_TEXT, addend: @bit_cast(i64, target + eo) });
        }
    }
    jtabs.clear();
}

// -----------------------------------------------------------------------------
// Inline assembly (xe.ASM): the template with the operands where they were
// allocated, assembled (asm/x64.ax) into the function's code
// -----------------------------------------------------------------------------
let mut asm_inst: *mc.MInst = @ptr_from_int(*mc.MInst, 0);
let mut asm_err: []u8 = "";

// Operand k of the statement being encoded, as asm/x64.ax renders it.
fn asm_operand(b: *ai.Blob, k: usize, mod: u8) []u8 {
    let o = asm_inst.ops[k];
    let op = b.ops[k];
    let mut r = ai.rop_reg(0, op.bits, op.fp);
    if o.kind == mc.K_REG {
        r.reg = P(o.reg);
    } else if o.kind == mc.K_MEM {
        let m = to_mem(o);
        r.kind = ai.OK_MEM;
        r.base = m.base;
        r.index = m.index;
        r.scale = m.scale;
        r.disp = m.disp;
        if (m.base < 0) and (m.sym >= 0) {
            r.name = u.cat2("__axiom_sym_", u.idec(m.sym));
        } else if m.base < 0 {
            asm_err = "a memory operand without a base register";
        }
    } else if o.kind == mc.K_SYM {
        r.kind = ai.OK_IMM;
        r.sym = true;
        r.name = u.cat2("__axiom_sym_", u.idec(o.sym));
        r.k = o.disp;
    } else {
        r.kind = ai.OK_IMM;
        r.k = o.disp;
    }
    let mut err = "";
    let t = ax.render(&r, mod, &mut err);
    if (err.len > 0) and (asm_err.len == 0) {
        asm_err = u.f2("operand %s: %s", u.zdec(k), err);
    }
    return t;
}

// The object symbol a relocation of inline assembly names.
fn asm_symbol(name: []u8) u32 {
    if u.starts(name, "__axiom_sym_") {
        return @truncate(u32, @bit_cast(u64, u.atol(name[12..])));
    }
    return elf.ext_sym(OBJ, u.perm_dup(name), false);
}

fn enc_asm(i: *mut mc.MInst) void {
    let b = ai.blob(i.aux);
    asm_inst = i;
    asm_err = "";
    let mut text = ai.expand(b, asm_operand, ax.label_text, @as(u64, @bit_cast(u32, i.cc)));
    if b.goto_ {
        text = u.cat2(text, ax.goto_tail(b.nlabels, P(i.ops[i.ops.len - 1].reg)));
    }
    if asm_err.len > 0 {
        fail(u.f2("inline assembly at %s: %s", b.loc, asm_err));
        return;
    }
    let start = @as(u64, E.b.len());
    let A = ax.assemble_inline(text, FBASE + start);
    if acr.failed(A) {
        fail(u.f2("inline assembly at %s: %s", b.loc, acr.message(A)));
        return;
    }
    let s = A.secs.at(0);
    E.b.put(s.data.items());
    for r in A.relocs.items() {
        E.relocs.push(xe.Reloc.{ off: start + r.off, ty: r.ty, sym: @bit_cast(i32, asm_symbol(r.name)),
                                 addend: r.addend });
    }
}

fn enc_inst(i: *mut mc.MInst) void {
    let op = i.op;
    let sz = i.sz;
    if op == xe.ASM {
        enc_asm(i);
        return;
    }
    if op == xe.DYNSTACK {
        enc_dynstack(i);
        return;
    }
    if op == xe.JTAB {
        enc_jtab(i);
        return;
    }
    // thread-local memory addressed relative to the fs segment
    for k in 0..i.ops.len {
        if (i.ops[k].kind == mc.K_MEM) and (i.ops[k].slot == -3) {
            b8(0x64);
            break;
        }
    }
    if op == xe.MOV_RR {
        let d = P(i.ops[0].reg);
        let s = P(i.ops[1].reg);
        if d == s {
            return;
        }
        enc_op(sz, 1, 0x8b, 0, d, mc.reg(i.ops[1].reg, mc.RU), 0, false);
        return;
    }
    if op == xe.MOV_RI {
        enc_mov_ri(sz, P(i.ops[0].reg), i.ops[1].disp);
        return;
    }
    if op == xe.LOAD {
        enc_load(i);
        return;
    }
    if op == xe.STORE {
        let s = P(i.ops[1].reg);
        enc_op_sz(sz, 1, 0x88, 0, s, false, i.ops[0], 0);
        return;
    }
    if op == xe.STORE_I {
        let x = i.ops[1].disp;
        enc_op_sz(sz, 1, 0xc6, 0, 0, true, i.ops[0], imm_len(sz));
        enc_imm(x, imm_len(sz));
        return;
    }
    if op == xe.LEA {
        enc_op(u.pick(sz == 4, "\x04", "\x08")[0], 1, 0x8d, 0, P(i.ops[0].reg), i.ops[1], 0, false);
        return;
    }
    if op == xe.ALU {
        enc_alu(i);
        return;
    }
    if op == xe.TEST {
        let a = i.ops[0];
        let s = i.ops[1];
        if s.kind == mc.K_IMM {
            enc_op_sz(sz, 1, 0xf6, 0, 0, true, a, imm_len(sz));
            enc_imm(s.disp, imm_len(sz));
            return;
        }
        enc_op_sz(sz, 1, 0x84, 0, P(s.reg), false, a, 0);
        return;
    }
    if op == xe.IMUL {
        enc_op(sz, 2, 0x0f, 0xaf, P(i.ops[0].reg), i.ops[1], 0, false);
        return;
    }
    if op == xe.IMUL_I {
        let x = i.ops[2].disp;
        if (x >= -128) and (x <= 127) {
            enc_op(sz, 1, 0x6b, 0, P(i.ops[0].reg), i.ops[1], 1, false);
            enc_imm(x, 1);
        } else {
            enc_op(sz, 1, 0x69, 0, P(i.ops[0].reg), i.ops[1], 4, false);
            enc_imm(x, 4);
        }
        return;
    }
    if op == xe.SHIFT {
        let digit = i.cc;
        let dst = i.ops[0];
        if i.ops[2].kind == mc.K_IMM {
            enc_op_sz(sz, 1, 0xc0, 0, digit, true, dst, 1);
            enc_imm(i.ops[2].disp, 1);
        } else {
            enc_op_sz(sz, 1, 0xd2, 0, digit, true, dst, 0);
        }
        return;
    }
    if op == xe.SHIFTX {
        // VEX.LZ.{66,F2,F3}.0F38.W F7 /r: reg = dst, rm = src, vvvv = count
        let mut pp: u64 = 1;
        if i.cc == 1 {
            pp = 3;
        } else if i.cc == 2 {
            pp = 2;
        }
        enc_vex_0f38(sz, pp, 0xf7, P(i.ops[0].reg), P(i.ops[2].reg), P(i.ops[1].reg));
        return;
    }
    if op == xe.BLS {
        // VEX.LZ.0F38.W F3 /cc: vvvv = dst, rm = src
        enc_vex_0f38(sz, 0, 0xf3, i.cc, P(i.ops[0].reg), P(i.ops[1].reg));
        return;
    }
    if op == xe.ANDN {
        // VEX.LZ.0F38.W F2 /r: reg = dst, vvvv = the negated source, rm = the other
        enc_vex_0f38(sz, 0, 0xf2, P(i.ops[0].reg), P(i.ops[2].reg), P(i.ops[1].reg));
        return;
    }
    if op == xe.UNARY {
        if i.cc == 8 {
            enc_bswap(sz, P(i.ops[0].reg));
            return;
        }
        enc_op_sz(sz, 1, 0xf6, 0, i.cc, true, i.ops[0], 0);
        return;
    }
    if op == xe.EXT {
        let d = P(i.ops[0].reg);
        let s = i.ops[1];
        let k = i.cc;
        if k == 1 {
            enc_op2(4, 2, 0x0f, 0xb6, d, s, 0, false, true);
        } else if k == 2 {
            enc_op(4, 2, 0x0f, 0xb7, d, s, 0, false);
        } else if k == 3 {
            enc_op2(sz, 2, 0x0f, 0xbe, d, s, 0, false, true);
        } else if k == 4 {
            enc_op(sz, 2, 0x0f, 0xbf, d, s, 0, false);
        } else if k == 5 {
            enc_op(8, 1, 0x63, 0, d, s, 0, false);
        } else {
            enc_op(4, 1, 0x8b, 0, d, s, 0, false);
        }
        return;
    }
    if op == xe.CQO {
        if sz == 8 {
            b8(0x48);
        }
        b8(0x99);
        return;
    }
    if op == xe.DIV {
        enc_op(sz, 1, 0xf7, 0, i.cc, i.ops[2], 0, false);
        return;
    }
    if op == xe.SETCC {
        enc_op2(1, 2, 0x0f, 0x90 + @truncate(u8, @bit_cast(u32, i.cc)), 0, i.ops[0], 0, false, true);
        return;
    }
    if op == xe.CMOV {
        enc_op(sz, 2, 0x0f, 0x40 + @truncate(u8, @bit_cast(u32, i.cc)), P(i.ops[0].reg), i.ops[1], 0, false);
        return;
    }
    if op == xe.BITSCAN {
        let k = i.cc;
        if k >= 2 {
            b8(0xf3);
        }
        let mut opc: u8 = 0xbc;
        if (k == 1) or (k == 3) {
            opc = 0xbd;
        } else if k == 4 {
            opc = 0xb8;
        }
        enc_op(sz, 2, 0x0f, opc, P(i.ops[0].reg), i.ops[1], 0, false);
        return;
    }
    if op == xe.JMP {
        enc_jump(i.ops[0].label, false, 0);
        return;
    }
    if op == xe.JCC {
        enc_jump(i.ops[0].label, true, i.cc);
        return;
    }
    if op == xe.LABEL {
        let l = @truncate(i32, i.aux) - xe.LOCAL_BASE;
        while local_off.len <= @int_cast(usize, l) {
            local_off.push(0);
        }
        local_off.set(@int_cast(usize, l), @as(u64, E.b.len()));
        return;
    }
    if is_tail(i) {
        enc_tail(i);
        return;
    }
    if op == xe.CALL {
        enc_call(i.ops[0]);
        return;
    }
    if op == xe.RET {
        if UPPER and DIRTY {
            vzeroupper();
        }
        epilogue();
        return;
    }
    if op == xe.UD2 {
        E.b.put("\x0f\x0b");
        return;
    }
    if op == xe.XCHG {
        let r = P(i.ops[1].reg);
        enc_op_sz(sz, 1, 0x86, 0, r, false, i.ops[0], 0);
        return;
    }
    if op == xe.XADD {
        b8(0xf0);
        let r = P(i.ops[1].reg);
        enc_op_sz(sz, 2, 0x0f, 0xc0, r, false, i.ops[0], 0);
        return;
    }
    if op == xe.CMPXCHG {
        b8(0xf0);
        let r = P(i.ops[1].reg);
        enc_op_sz(sz, 2, 0x0f, 0xb0, r, false, i.ops[0], 0);
        return;
    }
    if op == xe.MFENCE {
        E.b.put("\x0f\xae\xf0");
        return;
    }
    if op == xe.PREFETCH {
        enc_op(4, 2, 0x0f, u.pick(i.cc == 1, "\x0d", "\x18")[0], 1, i.ops[0], 0, false);
        return;
    }
    if op == xe.MXCSR {
        enc_op(4, 2, 0x0f, 0xae, 2 + i.cc, i.ops[0], 0, false);
        return;
    }
    if op == xe.X87 {
        let mut digit: i32 = 5;
        if i.cc == 1 {
            digit = 7;
        }
        enc_op(4, 1, 0xdb, 0, digit, i.ops[0], 0, false);
        return;
    }
    if op == xe.CPUID {
        E.b.put("\x0f\xa2");
        return;
    }
    if op == xe.BT {
        // [REX] 0F A3 /r: bt r/m, r (cc 1: bts 0F AB, 2: btr 0F B3, 3: btc 0F BB)
        let opc: [4]u8 = [0xa3, 0xab, 0xb3, 0xbb];
        enc_op(i.sz, 2, 0x0f, opc[@int_cast(usize, i.cc & 3)], P(i.ops[1].reg), i.ops[0], 0, false);
        return;
    }
    if op == xe.CRC32 {
        enc_crc32(i.sz, P(i.ops[0].reg), P(i.ops[1].reg));
        return;
    }
    if op == xe.XGETBV {
        E.b.put("\x0f\x01\xd0");
        return;
    }
    if op == xe.TLSBASE {
        let d = P(i.ops[0].reg);
        // mov d, fs:[0] (the thread pointer), on Windows gs:[0x58] (the
        // thread's TLS array)
        E.b.u8_(u.pick(WIN, "\x65", "\x64")[0]);
        b8(0x48 | (@as(u64, @bit_cast(u32, (d >> 3) & 1)) << 2));
        b8(0x8b);
        b8(0x04 | (@as(u64, @bit_cast(u32, d & 7)) << 3));
        b8(0x25);
        if WIN {
            E.b.u32_(0x58);
        } else {
            E.b.u32_(0);
        }
        return;
    }
    if op == xe.SSE {
        if not noop_move(i) {
            enc_sse(i);
        }
        return;
    }
    if op == xe.REP {
        enc_rep(i.cc);
        return;
    }
    if op == xe.NOP {
        return;
    }
    fail(u.f1("cannot encode machine op %s", u.idec(op)));
}

// After allocation: blocks that only jump (their phi copies became no-op
// moves) are bypassed, and a branch to the block that follows becomes a
// fall-through (`jcc next; jmp x` is `j!cc x`). Returns the skipped blocks.
fn noop_move(i: *mc.MInst) bool {
    if (i.op == xe.SSE) and (i.cc == xe.MOVAPS) {
        return (i.ops[0].kind == mc.K_REG) and (i.ops[1].kind == mc.K_REG) and (P(i.ops[0].reg) == P(i.ops[1].reg));
    }
    return (i.op == xe.MOV_RR) and (P(i.ops[0].reg) == P(i.ops[1].reg));
}

fn jump_target(b: *mc.MBlock) i32 {
    let mut i = b.first;
    while u.notnil(i) and (noop_move(i) or (i.op == xe.LABEL)) {
        i = i.next;
    }
    if u.notnil(i) and (i.op == xe.JMP) and u.isnil(i.next) and (i.ops[0].label < xe.LOCAL_BASE) {
        return i.ops[0].label;
    }
    return -1;
}

fn ends_flow(b: *mc.MBlock) bool {
    let l = b.last;
    return u.notnil(l) and
           ((l.op == xe.JMP) or (l.op == xe.RET) or (l.op == xe.UD2) or (l.op == xe.JTAB) or is_tail(l));
}

// Does the code after block bi start with block t (with nothing encoded
// between)?
fn falls_to(skip: []bool, bi: usize, t: i32) bool {
    let nb = MF.blocks.len;
    let mut k = bi + 1;
    while k < nb {
        if @int_cast(usize, t) == k {
            return true;
        }
        if not skip[k] {
            let mut i = MF.blocks.get(k).first;
            while u.notnil(i) {
                if not noop_move(i) and (i.op != xe.LABEL) {
                    return false;
                }
                i = i.next;
            }
        }
        k += 1;
    }
    return false;
}

// Jumps to a local label that nothing but no-op moves and labels precede.
fn drop_local_jumps(b: *mut mc.MBlock) void {
    let mut i = b.first;
    while u.notnil(i) {
        let nx = i.next;
        if (i.op == xe.JMP) and (i.ops[0].label >= xe.LOCAL_BASE) {
            let mut j = nx;
            while u.notnil(j) and (noop_move(j) or ((j.op == xe.LABEL) and (j.aux != @as(i64, i.ops[0].label)))) {
                j = j.next;
            }
            if u.notnil(j) and (j.op == xe.LABEL) and (j.aux == @as(i64, i.ops[0].label)) {
                mc.remove(b, i);
            }
        }
        i = nx;
    }
}

// After allocation, where nothing reads the flags before they are set
// again: `mov r, 0` becomes `xor r32, r32` (shorter, and a zeroing idiom),
// and `mov d, a; add d, b|k` (or sub k) becomes `lea d, [a + b|k]`. Flags
// are never live into a block, except one whose test dup_exit_tests dropped
// (live out of the block falling into it); a label or jump makes them live
// (conservatively), as do the instructions that read them.
fn peephole(b: *mut mc.MBlock) void {
    let mut live = flags_live_out(b);  // (after i)
    let mut i = b.last;
    while u.notnil(i) {
        let op = i.op;
        if not live and three_address(b, i) {
            i = i.prev;
            continue;
        }
        if (op == xe.JMP) and (i.ops[0].label < xe.LOCAL_BASE) {
            live = false;  // (to another block)
        } else if (op == xe.JCC) or (op == xe.CMOV) or (op == xe.SETCC) or (op == xe.JMP) or (op == xe.LABEL) {
            live = true;
        } else if (op == xe.ALU) or (op == xe.TEST) or (op == xe.CMP_M) or (op == xe.BT) or (op == xe.CALL) {
            live = false;
        } else if (op == xe.MOV_RI) and (i.ops[1].disp == 0) and not live {
            i.op = xe.ALU;
            i.cc = xe.ALU_XOR;
            i.sz = 4;
            i.ops[1] = i.ops[0];
        }
        i = i.prev;
    }
}

// A compare of registers (or a register and a constant) that an identical
// earlier one in the block makes redundant, with nothing between that sets
// the flags or writes the registers, is dropped (before allocation, and
// again after it, when copies may have made two compares the same).
pub fn reuse_flags(b: *mut mc.MBlock) void {
    let mut last = u.nil.[mc.MInst]();
    let mut i = b.first;
    while u.notnil(i) {
        let nx = i.next;
        let op = i.op;
        let is_cmp = (((op == xe.ALU) and (i.cc == xe.ALU_CMP)) or (op == xe.TEST)) and (i.ops[0].kind == mc.K_REG) and
                     ((i.ops[1].kind == mc.K_REG) or (i.ops[1].kind == mc.K_IMM));
        if is_cmp {
            if u.notnil(last) and (last.op == op) and (last.sz == i.sz) and (last.cc == i.cc) and
               same_mop(last.ops[0], i.ops[0]) and same_mop(last.ops[1], i.ops[1]) {
                mc.remove(b, i);
            } else if u.notnil(last) and sub_of_copy(last, i) {
                mc.remove(b, i);  // (`mov d, a; sub d, x` set the flags of `cmp a, x`)
            } else if u.notnil(last) and (op == xe.TEST) and same_mop(i.ops[0], i.ops[1]) and (last.sz == i.sz) and
                      sets_flags_of(last) and same_mop(last.ops[0], i.ops[0]) and
                      flags_read_as_test(i, logic_flags(last)) {
                mc.remove(b, i);  // (the flags of the operation that computed the register)
            } else if (((op == xe.TEST) and same_mop(i.ops[0], i.ops[1])) or
                       ((op == xe.ALU) and (i.ops[1].kind == mc.K_IMM) and (i.ops[1].disp == 0))) and
                      sink_setter(b, i) {
                // that operation moved down to here, after `last`: it sets
                // the flags now, and a later test of `last`'s register
                // must not be dropped as reading them
                last = i.prev;
                mc.remove(b, i);
            } else {
                last = i;
            }
        } else if sets_flags_of(i) {
            last = i;
        } else if (op == xe.MOV_RR) or (op == xe.MOV_RI) or (op == xe.LOAD) or (op == xe.STORE) or (op == xe.STORE_I) or
                  (op == xe.LEA) or (op == xe.EXT) or (op == xe.SETCC) or (op == xe.CMOV) or (op == xe.SHIFTX) or
                  (op == xe.JCC) or
                  ((op == xe.SSE) and (i.cc != xe.UCOMISS) and (i.cc != xe.UCOMISD) and (i.cc != xe.PTEST) and
                   (i.cc != xe.KORTESTQ)) {
            if u.notnil(last) and writes_reg_of(i, last) {
                last = u.nil.[mc.MInst]();
            }
        } else {
            last = u.nil.[mc.MInst]();
        }
        i = nx;
    }
}

// Is s a `sub d, x` right after `mov d, a`, and c a `cmp a, x` of the same
// size, with a not written between (s then set the flags c would)?
fn sub_of_copy(s: *mc.MInst, c: *mc.MInst) bool {
    if (s.op != xe.ALU) or (s.cc != xe.ALU_SUB) or (c.op != xe.ALU) or (c.cc != xe.ALU_CMP) or (s.sz != c.sz) or
       (s.ops[0].kind != mc.K_REG) or not same_mop(s.ops[1], c.ops[1]) {
        return false;
    }
    let mv = s.prev;
    if u.isnil(mv) or (mv.op != xe.MOV_RR) or (mv.sz < s.sz) or (P(mv.ops[0].reg) != P(s.ops[0].reg)) or
       not same_mop(mv.ops[1], c.ops[0]) or (P(mv.ops[1].reg) == P(s.ops[0].reg)) {
        return false;
    }
    let a = P(c.ops[0].reg);
    let mut j = s.next;
    while u.notnil(j) and (@int_from_ptr(j) != @int_from_ptr(c)) {
        if writes_phys(j, a) {
            return false;
        }
        j = j.next;
    }
    return u.notnil(j);
}

// test r, r (t) after the operation that last wrote r in the block, which
// sets the flags as it would, with nothing between naming that operation's
// registers or reading the flags: the operation moves down to t, which is
// then not needed (blsr early in a loop body, its test at the end). True if
// it did.
fn sink_setter(b: *mut mc.MBlock, t: *mut mc.MInst) bool {
    let r = P(t.ops[0].reg);
    let mut w = t.prev;
    while u.notnil(w) and (noop_move(w) or not writes_phys(w, r)) {
        let op = w.op;
        if (op == xe.LABEL) or (op == xe.JMP) or (op == xe.JCC) or (op == xe.CALL) {
            return false;
        }
        w = w.prev;
    }
    if u.isnil(w) {
        return false;
    }
    // what reads the flags between reads another instruction's, set after w
    let mut from_w = true;
    let mut x = w.next;
    while x != t {
        let op = x.op;
        let reads = (op == xe.SETCC) or (op == xe.CMOV) or
                    ((op == xe.ALU) and ((x.cc == xe.ALU_ADC) or (x.cc == xe.ALU_SBB)));
        if reads and from_w {
            return false;
        }
        if not keeps_flags(x) {
            from_w = false;
        }
        x = x.next;
    }
    if u.isnil(w) or not sets_flags_of(w) or (w.sz != t.sz) or not flags_read_as_test(t, logic_flags(w)) {
        return false;
    }
    for k in 0..w.ops.len {
        let o = w.ops[k];
        if (o.kind != mc.K_REG) and (o.kind != mc.K_IMM) and (o.kind != mc.K_NONE) {
            return false;
        }
    }
    let mut j = w.next;
    while j != t {
        if touches_any(j, w) {
            return false;
        }
        j = j.next;
    }
    if w.next == t {
        return false;  // (reuse_flags' own case)
    }
    mc.remove(b, w);
    mc.insert_before(b, t, w);
    return true;
}

// Does i leave the flags as they are?
fn keeps_flags(i: *mc.MInst) bool {
    let op = i.op;
    return (op == xe.MOV_RR) or (op == xe.MOV_RI) or (op == xe.LOAD) or (op == xe.STORE) or (op == xe.STORE_I) or
           (op == xe.LEA) or (op == xe.EXT) or (op == xe.SETCC) or (op == xe.CMOV) or (op == xe.SHIFTX) or
           ((op == xe.SSE) and (i.cc != xe.UCOMISS) and (i.cc != xe.UCOMISD) and (i.cc != xe.PTEST) and
            (i.cc != xe.KORTESTQ));
}

// Does i set ZF and SF from the register it writes (its first operand), as
// test r, r would? (and, or, xor, add, sub; andn, blsr, blsmsk, blsi)
fn sets_flags_of(i: *mc.MInst) bool {
    if (i.ops.len == 0) or (i.ops[0].kind != mc.K_REG) {
        return false;
    }
    if i.op == xe.ALU {
        return (i.cc == xe.ALU_ADD) or (i.cc == xe.ALU_OR) or (i.cc == xe.ALU_AND) or (i.cc == xe.ALU_SUB) or
               (i.cc == xe.ALU_XOR);
    }
    return (i.op == xe.ANDN) or (i.op == xe.BLS);
}

// Does i also clear CF and OF, as test does (and, or, xor, andn)?
fn logic_flags(i: *mc.MInst) bool {
    return ((i.op == xe.ALU) and ((i.cc == xe.ALU_OR) or (i.cc == xe.ALU_AND) or (i.cc == xe.ALU_XOR))) or
           (i.op == xe.ANDN);
}

// Is what test t sets read only for ZF and SF (or for anything, when all) up
// to the next instruction that sets the flags? (Flags are never live into a
// block; a local label or jump is taken to read them.)
fn flags_read_as_test(t: *mc.MInst, all: bool) bool {
    let mut j = t.next;
    while u.notnil(j) {
        let op = j.op;
        if (op == xe.JCC) or (op == xe.SETCC) or (op == xe.CMOV) {
            if not all and (j.cc != xe.CC_E) and (j.cc != xe.CC_NE) and (j.cc != xe.CC_S) and (j.cc != xe.CC_NS) {
                return false;
            }
        } else if (op == xe.LABEL) or ((op == xe.JMP) and (j.ops[0].label >= xe.LOCAL_BASE)) {
            return false;
        } else if op == xe.JMP {
            return true;
        } else if (op == xe.ALU) and ((j.cc == xe.ALU_ADC) or (j.cc == xe.ALU_SBB)) {
            return false;  // (adc, sbb)
        } else if (op == xe.ALU) or (op == xe.TEST) or (op == xe.CMP_M) or (op == xe.CALL) {
            return true;
        }
        j = j.next;
    }
    return true;
}

// Likewise a compare into k1 that an identical earlier one in the block
// makes redundant: nothing between writes k1 or the compared registers
// (k1 is the only mask register the selection uses, so two masks used by
// turns are compared again; this drops the repeats that are not).
pub fn reuse_k1(b: *mut mc.MBlock) void {
    let mut last = u.nil.[mc.MInst]();
    let mut i = b.first;
    while u.notnil(i) {
        let nx = i.next;
        let wk = writes_k1(i);
        if wk and (i.op == xe.SSE) and ((i.aux & 1) == 0) and plain_ops(i) {
            if u.notnil(last) and (last.cc == i.cc) and (last.sz == i.sz) and (last.aux == i.aux) and
               (last.ops.len == i.ops.len) and same_ops(last, i) {
                mc.remove(b, i);
            } else {
                last = i;
            }
        } else if wk or (i.op == xe.CALL) or (i.op == xe.LABEL) {
            last = u.nil.[mc.MInst]();
        } else if u.notnil(last) and writes_reg_of_any(i, last) {
            last = u.nil.[mc.MInst]();
        }
        i = nx;
    }
}

fn writes_k1(i: *mc.MInst) bool {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == mc.K_REG) and ((o.role & (mc.RD | mc.RE)) != 0) and (P(o.reg) == xe.K1) {
            return true;
        }
    }
    return false;
}

// Only registers, immediates and nothing as operands (no memory)?
fn plain_ops(i: *mc.MInst) bool {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind != mc.K_REG) and (o.kind != mc.K_IMM) and (o.kind != mc.K_NONE) {
            return false;
        }
    }
    return true;
}

fn same_ops(a: *mc.MInst, b: *mc.MInst) bool {
    for k in 0..a.ops.len {
        let x = a.ops[k];
        let y = b.ops[k];
        if (x.kind != y.kind) or ((x.kind != mc.K_NONE) and not same_mop(x, y)) {
            return false;
        }
    }
    return true;
}

// Does i write a register that c reads?
fn writes_reg_of_any(i: *mc.MInst, c: *mc.MInst) bool {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == mc.K_REG) and ((o.role & (mc.RD | mc.RE)) != 0) {
            let r = P(o.reg);
            for j in 0..c.ops.len {
                if (c.ops[j].kind == mc.K_REG) and ((c.ops[j].role & mc.RU) != 0) and (P(c.ops[j].reg) == r) {
                    return true;
                }
            }
        }
    }
    return false;
}

fn same_mop(a: mc.MOp, b: mc.MOp) bool {
    if a.kind != b.kind {
        return false;
    }
    if a.kind == mc.K_REG {
        return P(a.reg) == P(b.reg);
    }
    return (a.kind == mc.K_IMM) and (a.disp == b.disp);
}

// Does i write a register that compare c reads?
fn writes_reg_of(i: *mc.MInst, c: *mc.MInst) bool {
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == mc.K_REG) and ((o.role & (mc.RD | mc.RE)) != 0) {
            let r = P(o.reg);
            for j in @as(usize, 0)..2 {
                if (c.ops[j].kind == mc.K_REG) and (P(c.ops[j].reg) == r) {
                    return true;
                }
            }
        }
    }
    return false;
}

// `mov d, a; add d, b|k` (sub k) as `lea d, [a + b|k]` at i (the add),
// when d is not a; and `mov d, a; shl d, 1-3` as `lea d, [a * 2-8]`.
fn three_address(b: *mut mc.MBlock, i: *mut mc.MInst) bool {
    let mv = i.prev;
    if (i.op == xe.SHIFT) and (i.cc == 4) and (i.ops[2].kind == mc.K_IMM) and (i.ops[2].disp >= 1) and
       (i.ops[2].disp <= 3) and ((i.sz == 4) or (i.sz == 8)) and u.notnil(mv) and (mv.op == xe.MOV_RR) and
       (i.ops[0].kind == mc.K_REG) {
        // `mov d, a; shl d, k` as `lea d, [a * 2^k]`
        let d = P(i.ops[0].reg);
        if (P(mv.ops[0].reg) != d) or (P(mv.ops[1].reg) == d) or ((mv.sz != 8) and (i.sz == 8)) {
            return false;
        }
        let a = mv.ops[1].reg;
        let k = i.ops[2].disp;
        let mut m = mc.mem(-1, a, @truncate(u8, @as(i64, 1) << @int_cast(u32, k)), 0);
        if k == 1 {
            m = mc.mem(a, a, 1, 0);
        }
        i.op = xe.LEA;
        i.cc = 0;
        i.ops[0] = mc.reg(i.ops[0].reg, mc.RD);
        i.ops[1] = m;
        i.ops[2] = mc.none();
        mc.remove(b, mv);
        return true;
    }
    if (i.op != xe.ALU) or ((i.cc != xe.ALU_ADD) and (i.cc != xe.ALU_SUB)) or ((i.sz != 4) and (i.sz != 8)) or
       u.isnil(mv) or (mv.op != xe.MOV_RR) or (i.ops[0].kind != mc.K_REG) {
        return false;
    }
    let d = P(i.ops[0].reg);
    if (P(mv.ops[0].reg) != d) or (P(mv.ops[1].reg) == d) or ((mv.sz != 8) and (i.sz == 8)) {
        return false;
    }
    let a = mv.ops[1].reg;
    let s = i.ops[1];
    let mut m = mc.mem(a, -1, 0, 0);
    if s.kind == mc.K_IMM {
        let mut k = s.disp;
        if i.cc == 5 {
            k = 0 - k;
        }
        if not is.fits32(k) {
            return false;
        }
        m.disp = k;
    } else if (s.kind == mc.K_REG) and (i.cc == 0) and (P(s.reg) != d) {
        m.index = s.reg;
        m.scale = 1;
    } else {
        return false;
    }
    i.op = xe.LEA;
    i.cc = 0;
    i.ops[0] = mc.reg(i.ops[0].reg, mc.RD);
    i.ops[1] = m;
    mc.remove(b, mv);
    return true;
}

fn tidy_branches() []mut bool {
    let nb = MF.blocks.len;
    let skip = u.newn.[bool](nb + 1);
    let fin = u.newn.[i32](nb + 1);
    for bi in 0..nb {
        fin[bi] = @int_cast(i32, bi);
    }
    // where a jump to each block ends up
    for bi in 1..nb {
        if @as(i32, @int_cast(i32, bi)) == SW {
            continue;  // (where the frame is set up: jumps there stay)
        }
        let mut t = jump_target(MF.blocks.get(bi));
        let mut steps: usize = 0;
        while (t >= 0) and (steps < nb) {
            fin[bi] = t;
            if t == SW {
                break;
            }
            t = jump_target(MF.blocks.get(@int_cast(usize, t)));
            steps += 1;
        }
    }
    for bi in 0..nb {
        let mut i = MF.blocks.get(bi).first;
        while u.notnil(i) {
            if ((i.op == xe.JMP) or (i.op == xe.JCC)) and (i.ops[0].label < xe.LOCAL_BASE) {
                i.ops[0].label = fin[@int_cast(usize, i.ops[0].label)];
            } else if i.op == xe.JTAB {
                for k in 3..i.ops.len {
                    i.ops[k].label = fin[@int_cast(usize, i.ops[k].label)];
                }
            }
            i = i.next;
        }
    }
    // bypassed blocks are left out (a block falling into one jumps instead)
    for bi in 1..nb {
        if fin[bi] == @int_cast(i32, bi) {
            continue;
        }
        let prev = MF.blocks.get(bi - 1);
        if not ends_flow(prev) {
            let ops: [1]mc.MOp = [mc.label(fin[bi])];
            mc.append(prev, mc.new_inst(xe.JMP, 0, ops[..]));
        }
        skip[bi] = true;
    }
    dup_exit_tests(skip);
    // fall-throughs (into the next block, or past blocks that encode
    // nothing: skipped ones, and ones left with only no-op moves; from the
    // last block back, so that a chain of jumps to one place all go)
    for bj in 0..nb {
        let bi = nb - 1 - bj;
        if skip[bi] {
            continue;
        }
        drop_local_jumps(MF.blocks.get(bi));
        reuse_flags(MF.blocks.get(bi));
        reuse_k1(MF.blocks.get(bi));
        peephole(MF.blocks.get(bi));
        let b = MF.blocks.get(bi);
        let l = b.last;
        if u.isnil(l) or (l.op != xe.JMP) or (l.ops[0].label >= xe.LOCAL_BASE) {
            continue;
        }
        if falls_to(skip, bi, l.ops[0].label) {
            mc.remove(b, l);
            continue;
        }
        let pj = l.prev;
        if u.notnil(pj) and (pj.op == xe.JCC) and (pj.ops[0].label < xe.LOCAL_BASE) and
           falls_to(skip, bi, pj.ops[0].label) {
            pj.cc = is.invert(pj.cc);
            pj.ops[0].label = l.ops[0].label;
            mc.remove(b, l);
        }
    }
    return skip;
}

// A compare that starts a block, after every jump into it (and the code
// falling into it) has left the flags of that same compare: it goes (`cmp
// x, 2; jle L` ... `L: cmp x, 2; jge M`, the two tests of an if-else
// chain on one value).
fn reuse_flags_across(skip: []bool) void {
    let nb = MF.blocks.len;
    // the compare each block starts with, if any
    let first = u.calloc_slice.[*mut mc.MInst](nb + 1);
    let bad = u.calloc_slice.[bool](nb + 1);
    let npred = u.calloc_slice.[i32](nb + 1);
    let mut any = false;
    for bi in 1..nb {
        if skip[bi] or (@as(i32, @int_cast(i32, bi)) == SW) {
            continue;  // (SW starts with the prologue, which sets the flags)
        }
        let mut c = MF.blocks.get(bi).first;
        while u.notnil(c) and noop_move(c) {
            c = c.next;
        }
        if u.notnil(c) and plain_compare(c) {
            first[bi] = c;
            any = true;
        }
    }
    if any {
        for pj in 0..nb {
            if skip[pj] {
                continue;
            }
            let p = MF.blocks.get(pj);
            let mut j = p.first;
            while u.notnil(j) {
                if j.op == xe.JTAB {
                    // (the flags of the table's arithmetic)
                    for k in 3..j.ops.len {
                        bad[@int_cast(usize, j.ops[k].label)] = true;
                    }
                }
                if ((j.op == xe.JMP) or (j.op == xe.JCC)) and (j.ops.len > 0) and (j.ops[0].kind == mc.K_LABEL) and
                   (j.ops[0].label >= 0) and (j.ops[0].label < @int_cast(i32, nb)) {
                    let t = @int_cast(usize, j.ops[0].label);
                    if u.notnil(first[t]) {
                        npred[t] += 1;
                        if not flags_hold(j, first[t]) {
                            bad[t] = true;
                        }
                    }
                }
                j = j.next;
            }
        }
        for bi in 1..nb {
            let c = first[bi];
            if u.isnil(c) or bad[bi] {
                continue;
            }
            // the code falling in (the block before, past skipped ones)
            let mut pj = bi - 1;
            while (pj > 0) and skip[pj] {
                pj -= 1;
            }
            let p = MF.blocks.get(pj);
            if not skip[pj] and not ends_flow(p) {
                if u.isnil(p.last) or not falls_to(skip, pj, @int_cast(i32, bi)) or not flags_hold_after(p.last, c) {
                    continue;
                }
                npred[bi] += 1;
            }
            if npred[bi] > 0 {
                mc.remove(MF.blocks.get(bi), c);
            }
        }
    }
    u.free_slice(first);
    u.free_slice(bad);
    u.free_slice(npred);
}

// Do the flags at jump j (before it) come from a compare the same as c,
// with c's registers unchanged since?
fn flags_hold(j: *mc.MInst, c: *mc.MInst) bool {
    if u.isnil(j.prev) {
        return false;
    }
    return flags_hold_after(j.prev, c);
}

// The same after instruction i (included).
fn flags_hold_after(i: *mc.MInst, c: *mc.MInst) bool {
    let mut w = i;
    while u.notnil(w) {
        if (w.op == xe.LABEL) or (w.op == xe.CALL) {
            return false;
        }
        if (w.op == xe.JCC) or noop_move(w) {
            w = w.prev;
            continue;
        }
        if (w.op == c.op) and (w.sz == c.sz) and (w.cc == c.cc) and same_mop(w.ops[0], c.ops[0]) and
           same_mop(w.ops[1], c.ops[1]) {
            return true;
        }
        if not keeps_flags(w) or writes_reg_of(w, c) {
            return false;
        }
        w = w.prev;
    }
    return false;
}

// The real instructions of block b (no no-op moves or local labels), when
// there are at most n of them, else none.
fn few_insts(b: *mc.MBlock, n: usize) []mut *mut mc.MInst {
    let out = u.newn.[*mut mc.MInst](n);
    let mut k: usize = 0;
    let mut i = b.first;
    while u.notnil(i) {
        if not noop_move(i) and (i.op != xe.LABEL) {
            if k == n {
                return out[0..0];
            }
            out[k] = i;
            k += 1;
        }
        i = i.next;
    }
    return out[0..k];
}

// The next block after bi that is not skipped (nb at the end).
fn next_kept(skip: []bool, bi: usize) usize {
    let mut k = bi + 1;
    while (k < MF.blocks.len) and skip[k] {
        k += 1;
    }
    return k;
}

// A test of a register against itself, or a compare of a register with a
// register or a constant.
fn plain_compare(i: *mc.MInst) bool {
    return (((i.op == xe.ALU) and (i.cc == xe.ALU_CMP)) or (i.op == xe.TEST)) and (i.ops[0].kind == mc.K_REG) and
           ((i.ops[1].kind == mc.K_REG) or (i.ops[1].kind == mc.K_IMM));
}

// A jump to a block that only compares and branches (a loop's exit test,
// which the layout places after the body, where the loop's entry jumps)
// compares and branches itself, so that the test block is entered only by
// the body falling into it; a test of a register the body's last operation
// set the flags from is then dropped (blsr, and, sub ... before the test).
// Blocks whose flags are live at their end: dup_exit_tests dropped the test
// the block they fall into starts with, which now reads them.
let mut flags_out: u.List.[*mut mc.MBlock] = u.List.[*mut mc.MBlock].{ data: @ptr_from_int(*mut *mut mc.MBlock, 0),
                                                                       len: 0, cap: 0 };

fn flags_live_out(b: *mut mc.MBlock) bool {
    for k in 0..flags_out.len {
        if flags_out.get(k) == b {
            return true;
        }
    }
    return false;
}

// Can x, at the end of a block that then compares (cmp) and branches to
// block `other` or falls on, move after the branch: an operation on general
// registers only, that writes one the compare does not read and that is not
// needed at `other`?
fn movable_to_fall(x: *mc.MInst, cmp: *mc.MInst, skip: []bool, other: i32) bool {
    let op = x.op;
    if not ((op == xe.MOV_RR) or (op == xe.MOV_RI) or (op == xe.LEA) or (op == xe.EXT) or (op == xe.IMUL_I) or
            ((op == xe.SHIFT) and (x.ops[1].kind != mc.K_REG)) or
            ((op == xe.ALU) and (x.cc != xe.ALU_ADC) and (x.cc != xe.ALU_SBB) and (x.cc != xe.ALU_CMP))) {
        return false;
    }
    if (x.ops.len == 0) or (x.ops[0].kind != mc.K_REG) or (x.sz < 4) {
        return false;
    }
    let d = P(x.ops[0].reg);
    if d >= 16 {
        return false;
    }
    for k in 1..x.ops.len {
        let o = x.ops[k];
        if (o.kind == mc.K_MEM) and (op != xe.LEA) {
            return false;
        }
        if (o.kind == mc.K_REG) and (P(o.reg) >= 16) {
            return false;
        }
    }
    if names_phys(cmp, d) {
        return false;
    }
    let seen = u.calloc_slice.[bool](MF.blocks.len + 1);
    let mut budget: i32 = 48;
    let dead = dead_at(@int_cast(usize, other), d, skip, seen, &mut budget);
    u.free_slice(seen);
    return dead;
}

// Is general register r written before it is read on every way from the
// start of block b (looking at `budget` blocks at most)? False when not
// known. (A block seen before is not looked at again: a read from there on
// is found the first time.)
fn dead_at(b0: usize, r: i32, skip: []bool, seen: []mut bool, budget: *mut i32) bool {
    let mut b = b0;
    while (b < MF.blocks.len) and skip[b] {
        b += 1;
    }
    if b >= MF.blocks.len {
        return false;
    }
    if seen[b] {
        return true;
    }
    seen[b] = true;
    budget.* -= 1;
    if budget.* < 0 {
        return false;
    }
    let mut i = MF.blocks.get(b).first;
    while u.notnil(i) {
        let op = i.op;
        if (op == xe.JMP) or (op == xe.JCC) {
            let t = i.ops[0].label;
            if (t >= xe.LOCAL_BASE) or (t < 0) or not dead_at(@int_cast(usize, t), r, skip, seen, budget) {
                return false;
            }
            if op == xe.JMP {
                return true;
            }
        } else if op == xe.CALL {
            // (its argument registers are its operands; what it clobbers is
            // written)
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if ((o.kind == mc.K_REG) and (P(o.reg) == r)) or
                   ((o.kind == mc.K_MEM) and
                    (((o.base >= 0) and (P(o.base) == r)) or ((o.index >= 0) and (P(o.index) == r)))) {
                    return false;
                }
            }
            if (i.clobber & (@as(u64, 1) << @int_cast(u32, r))) != 0 {
                return true;
            }
            if is_tail(i) {
                // (as at a return: the epilogue restores the registers a convention keeps)
                return (r == xe.RCX) or (r == xe.R8) or (r == xe.R9) or (r == xe.R10) or (r == xe.R11);
            }
        } else if op == xe.UD2 {
            return true;  // (a trap, which may follow code that reads r)
        } else if op == xe.RET {
            // (registers no calling convention keeps or returns in)
            return (r == xe.RCX) or (r == xe.R8) or (r == xe.R9) or (r == xe.R10) or (r == xe.R11);
        } else if op != xe.LABEL {
            if not ((op == xe.MOV_RR) or (op == xe.MOV_RI) or (op == xe.LOAD) or (op == xe.STORE) or
                    (op == xe.STORE_I) or (op == xe.LEA) or (op == xe.ALU) or (op == xe.TEST) or (op == xe.IMUL) or
                    (op == xe.IMUL_I) or (op == xe.SHIFT) or (op == xe.EXT) or (op == xe.CMOV) or (op == xe.SETCC) or
                    (op == xe.CMP_M) or (op == xe.ANDN) or (op == xe.BLS) or (op == xe.NOP) or (op == xe.BITSCAN) or
                    (op == xe.SHIFTX) or (op == xe.BT) or (op == xe.SSE) or (op == xe.PREFETCH) or
                    (op == xe.VZEROUPPER)) {
                return false;
            }
            // (shift by cl: rcx is its operand)
            let mut reads = false;
            let mut full = false;
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if o.kind == mc.K_REG {
                    if P(o.reg) == r {
                        if (o.role & mc.RU) != 0 {
                            reads = true;
                        } else if (o.role & (mc.RD | mc.RE)) != 0 {
                            full = true;
                        }
                    }
                } else if o.kind == mc.K_MEM {
                    if ((o.base >= 0) and (P(o.base) == r)) or ((o.index >= 0) and (P(o.index) == r)) {
                        reads = true;
                    }
                }
            }
            if reads {
                return false;
            }
            if full {
                // a write of 8 or 16 bits keeps the rest
                if (op == xe.SETCC) or ((op == xe.LOAD) and (i.sz < 4) and (i.cc == 0)) or (op == xe.SSE) or
                   ((op == xe.BITSCAN) and (i.cc < 2)) or ((op != xe.LOAD) and (op != xe.EXT) and (i.sz < 4)) {
                    return false;
                }
                return true;
            }
        }
        i = i.next;
    }
    return dead_at(b + 1, r, skip, seen, budget);
}

fn dup_exit_tests(skip: []bool) void {
    flags_out.clear();
    for bi in 0..MF.blocks.len {
        if not skip[bi] {
            dup_exit_test(skip, bi);
        }
    }
    drop_fall_tests(skip);
}

// dup_exit_tests for block bi: if it jumps to a block that only compares
// and branches, it compares and branches itself.
fn dup_exit_test(skip: []bool, bi: usize) void {
    let nb = MF.blocks.len;
    let p = MF.blocks.get(bi);
    let l = p.last;
    if u.isnil(l) or (l.op != xe.JMP) or (l.ops[0].label >= xe.LOCAL_BASE) {
        return;
    }
    let t = @int_cast(usize, l.ops[0].label);
    if (t == bi) or (t >= nb) or skip[t] or falls_to(skip, bi, l.ops[0].label) or (l.ops[0].label == SW) {
        return;
    }
    let ins = few_insts(MF.blocks.get(t), 3);
    if (ins.len < 2) or not plain_compare(ins[0]) or (ins[1].op != xe.JCC) or (ins[1].ops[0].label >= xe.LOCAL_BASE) {
        return;
    }
    let mut after: i32 = -1;
    if ins.len == 3 {
        if (ins[2].op != xe.JMP) or (ins[2].ops[0].label >= xe.LOCAL_BASE) {
            return;
        }
        after = ins[2].ops[0].label;
    } else {
        let n = next_kept(skip, t);
        if n >= nb {
            return;
        }
        after = @int_cast(i32, n);
    }
    mc.remove(p, l);
    // the operations at p's end whose results only the way p falls
    // into needs (the loop's preheader work, as `b * 16` before an inner
    // loop) go after the branch, onto that way
    let fall = @int_cast(i32, next_kept(skip, bi));
    let tl = ins[1].ops[0].label;
    let mut cc = ins[1].cc;
    let mut other: i32 = -1;
    if tl == fall {
        other = after;
        cc = cc ^ 1;
    } else if after == fall {
        other = tl;
    }
    let mut s = p.last;  // (the first of them, or nil)
    let mut moved = false;
    if other >= 0 {
        let mut x = p.last;
        while u.notnil(x) and movable_to_fall(x, ins[0], skip, other) {
            s = x;
            moved = true;
            x = x.prev;
        }
    }
    let mut tail = u.List.[*mut mc.MInst].empty();
    if moved {
        let mut x = s;
        while u.notnil(x) {
            let nx = x.next;
            mc.remove(p, x);
            tail.push(x);
            x = nx;
        }
    }
    for k in @as(usize, 0)..2 {
        let c = mc.new_inst(ins[k].op, ins[k].sz, ins[k].ops);
        c.cc = ins[k].cc;
        c.aux = ins[k].aux;
        c.src = ins[k].src;
        c.scope = ins[k].scope;
        if moved and (k == 1) {
            c.cc = cc;
            c.ops[0] = mc.label(other);
        }
        mc.append(p, c);
    }
    let mut to = after;
    if moved {
        for k in 0..tail.len {
            mc.append(p, tail.get(k));
        }
        to = fall;
    }
    tail.deinit();
    let ops: [1]mc.MOp = [mc.label(to)];
    mc.append(p, mc.new_inst(xe.JMP, 0, ops[..]));
}

// dup_exit_tests' second part: a test at the start of a block entered only
// by falling from the one before is dropped where the flags already hold
// it, the operation that set them perhaps moved to that block's end.
fn drop_fall_tests(skip: []bool) void {
    let nb = MF.blocks.len;
    let refs = u.newn.[i32](nb + 1);
    for bi in 0..nb {
        if skip[bi] {
            continue;
        }
        let mut i = MF.blocks.get(bi).first;
        while u.notnil(i) {
            if ((i.op == xe.JMP) or (i.op == xe.JCC)) and (i.ops[0].label < xe.LOCAL_BASE) {
                refs[@int_cast(usize, i.ops[0].label)] += 1;
            } else if i.op == xe.JTAB {
                for k in 3..i.ops.len {
                    refs[@int_cast(usize, i.ops[k].label)] += 1;
                }
            }
            i = i.next;
        }
    }
    let mut prev: usize = nb;
    for bi in 0..nb {
        if skip[bi] {
            continue;
        }
        let pb = prev;
        prev = bi;
        if (pb == nb) or (refs[bi] != 0) or ends_flow(MF.blocks.get(pb)) or (@as(i32, @int_cast(i32, bi)) == SW) {
            continue;
        }
        let tb = MF.blocks.get(bi);
        let mut ti = tb.first;
        while u.notnil(ti) and noop_move(ti) {
            ti = ti.next;
        }
        if u.isnil(ti) or (ti.op != xe.TEST) or not plain_compare(ti) or not same_mop(ti.ops[0], ti.ops[1]) {
            continue;
        }
        // the operation that last wrote the tested register in the block
        // before: its flags are the test's if nothing after it sets them, or
        // when it can move to the end of the block
        let r = P(ti.ops[0].reg);
        let pbb = MF.blocks.get(pb);
        let mut w = pbb.last;
        while u.notnil(w) and not writes_phys(w, r) {
            w = w.prev;
        }
        if u.isnil(w) or not sets_flags_of(w) or (w.sz != ti.sz) or not flags_read_as_test(ti, logic_flags(w)) {
            continue;
        }
        let mut intact = true;
        let mut movable = true;
        for k in 1..w.ops.len {
            if (w.ops[k].kind != mc.K_REG) and (w.ops[k].kind != mc.K_IMM) and (w.ops[k].kind != mc.K_NONE) {
                movable = false;
            }
        }
        let mut j = w.next;
        let mut set_after = false;  // (flags set since w: what reads them reads those)
        while u.notnil(j) {
            let op = j.op;
            if not noop_move(j) {
                if not ((op == xe.MOV_RR) or (op == xe.MOV_RI) or (op == xe.LOAD) or (op == xe.STORE) or
                        (op == xe.STORE_I) or (op == xe.LEA) or (op == xe.EXT) or (op == xe.SETCC) or (op == xe.CMOV) or
                        (op == xe.SHIFTX) or (op == xe.JCC) or
                        ((op == xe.SSE) and (j.cc != xe.UCOMISS) and (j.cc != xe.UCOMISD) and (j.cc != xe.PTEST) and
                         (j.cc != xe.KORTESTQ))) {
                    intact = false;
                }
                let plain = (op == xe.MOV_RR) or (op == xe.MOV_RI) or (op == xe.LOAD) or (op == xe.STORE) or
                            (op == xe.STORE_I) or (op == xe.LEA) or (op == xe.EXT) or (op == xe.SHIFT) or
                            (op == xe.SHIFTX) or (op == xe.IMUL) or (op == xe.IMUL_I) or (op == xe.TEST) or
                            (op == xe.BITSCAN) or (op == xe.SSE) or (op == xe.BLS) or (op == xe.ANDN) or
                            ((op == xe.ALU) and (j.cc != xe.ALU_ADC) and (j.cc != xe.ALU_SBB)) or
                            (((op == xe.SETCC) or (op == xe.CMOV)) and set_after);
                if not plain or touches_any(j, w) {
                    movable = false;
                }
                if not keeps_flags(j) {
                    set_after = true;
                }
            }
            j = j.next;
        }
        if intact {
            mc.remove(tb, ti);
            flags_out.push(pbb);
        } else if movable {
            mc.remove(pbb, w);
            mc.append(pbb, w);
            mc.remove(tb, ti);
            flags_out.push(pbb);
        }
    }
}

// Does i name physical register r (an operand, or in a memory operand)?
pub fn names_phys(i: *mc.MInst, r: i32) bool {
    if (i.clobber & (@as(u64, 1) << @int_cast(u32, r))) != 0 {
        return true;
    }
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == mc.K_REG) and (P(o.reg) == r) {
            return true;
        }
        if (o.kind == mc.K_MEM) and (((o.base >= 0) and (P(o.base) == r)) or ((o.index >= 0) and (P(o.index) == r))) {
            return true;
        }
    }
    return false;
}

// Does i write physical register r?
fn writes_phys(i: *mc.MInst, r: i32) bool {
    if i.op == xe.CALL {
        return true;  // (and what it clobbers)
    }
    for k in 0..i.ops.len {
        let o = i.ops[k];
        if (o.kind == mc.K_REG) and ((o.role & (mc.RD | mc.RE)) != 0) and (P(o.reg) == r) {
            return true;
        }
    }
    return false;
}

// Does i name (read or write, or address memory with) a register that w names?
fn touches_any(i: *mc.MInst, w: *mc.MInst) bool {
    for k in 0..w.ops.len {
        if w.ops[k].kind == mc.K_REG {
            let r = P(w.ops[k].reg);
            for j in 0..i.ops.len {
                let o = i.ops[j];
                if (o.kind == mc.K_REG) and (P(o.reg) == r) {
                    return true;
                }
                if (o.kind == mc.K_MEM) and
                   (((o.base >= 0) and (P(o.base) == r)) or ((o.index >= 0) and (P(o.index) == r))) {
                    return true;
                }
            }
        }
    }
    return false;
}

// The callee-saved registers MF uses (saved, and Windows' xsaved), counting
// those instructions name themselves.
fn find_saved() void {
    nsaved = 0;
    nxsaved = 0;
    let cs: [5]i32 = [xe.RBX, xe.R12, xe.R13, xe.R14, xe.R15];
    let wcs: [7]i32 = [xe.RBX, xe.RSI, xe.RDI, xe.R12, xe.R13, xe.R14, xe.R15];
    let mut callee = cs[..];
    // registers instructions name themselves (rsi and rdi of the string
    // instructions, rbx of cpuid) are used too
    for bi in 0..MF.blocks.len {
        let mut i = MF.blocks.get(bi).first;
        while u.notnil(i) {
            for k in 0..i.ops.len {
                let o = i.ops[k];
                if (o.kind == mc.K_REG) and not mc.is_vreg(o.reg) and (o.reg >= 0) {
                    MF.used_regs = MF.used_regs | (@as(u64, 1) << @int_cast(u32, o.reg));
                }
            }
            i = i.next;
        }
    }
    if WIN {
        callee = wcs[..];
        for k in @as(i32, 6)..16 {
            if (MF.used_regs & (@as(u64, 1) << @int_cast(u32, xe.XMM0 + k))) != 0 {
                xsaved[@int_cast(usize, nxsaved)] = xe.XMM0 + k;
                nxsaved += 1;
            }
        }
    }
    for r in callee {
        if (MF.used_regs & (@as(u64, 1) << @int_cast(u32, r))) != 0 {
            saved[@int_cast(usize, nsaved)] = r;
            nsaved += 1;
        }
    }
}

// Lays out MF's frame, its slots below the saved registers, and returns
// its size.
fn frame_layout() i64 {
    let mut cur: i64 = (8 * nsaved) + (16 * nxsaved);
    for k in 0..MF.slots.len {
        let s = MF.slots.at(k);
        let a = @bit_cast(i64, s.align);
        cur = (cur + @bit_cast(i64, s.size) + a - 1) & ~(a - 1);
        s.offset = -cur;
    }
    let total = (cur + @bit_cast(i64, out_area) + 15) & ~@as(i64, 15);
    if total > 0x7000_0000 {
        // frame offsets are 32-bit displacements (code generation keeps a
        // function's locals to 1 GiB, E0473, and inlining keeps to that too)
        fail("the stack frame is too large");
    }
    return total;
}

// The block that sets up the frame when shrink-wrapping (SW), or -1: the
// entry does, or there is no frame.
fn wrap_block() i32 {
    if frameless or WIN or (SW < 0) {
        return -1;
    }
    for bi in 0..MF.blocks.len {
        if not MF.blocks.get(bi).noframe {
            continue;
        }
        let mut i = MF.blocks.get(bi).first;
        while u.notnil(i) {
            if not sw_frame_free(i) {
                return -1;  // (spilled there after all)
            }
            i = i.next;
        }
    }
    return SW;
}

// Encodes i, in block bi as encode_func lays it out (skip, lal and sw as
// there): with JCC, a jump, call, ret or memmove, or a compare and the jcc
// it fuses with, as a unit (enc_unit). Returns the last instruction encoded.
fn enc_at(i: *mut mc.MInst, bi: usize, skip: []bool, lal: []bool, sw: i32) *mut mc.MInst {
    let mut last = i;
    let mut unit = false;
    let mut extra: u64 = 0;
    if JCC {
        let op = i.op;
        unit = (op == xe.JCC) or (op == xe.JMP) or (op == xe.CALL) or (op == xe.RET) or
               ((op == xe.REP) and (i.cc == 2));
        if fuses_with_jcc(i) {
            let mut j = i.next;
            while u.notnil(j) and enc_nothing(j) {
                j = j.next;
            }
            if u.notnil(j) and (j.op == xe.JCC) {
                unit = true;
                last = j;
            } else if u.isnil(j) {
                extra = jcc_next_block(bi, skip, lal, sw);
                unit = extra > 0;
            }
        }
    }
    if unit {
        enc_unit(i, last, extra);
    } else {
        enc_inst(i);
    }
    return last;
}

// Fills in the displacements of the branches to blocks (at boff) and local
// labels.
fn resolve_branches(boff: []u64) void {
    for k in 0..E.fixups.len {
        let x = E.fixups.get(k);
        let mut target: u64 = 0;
        if x.label >= xe.LOCAL_BASE {
            target = local_off.get(@int_cast(usize, x.label - xe.LOCAL_BASE));
        } else {
            target = boff[@int_cast(usize, x.label)];
        }
        if x.short {
            let rel = @bit_cast(i64, target) - @bit_cast(i64, x.off + 1);
            if (rel < -128) or (rel > 127) {
                fail("internal compiler error: a short jump out of range");
            }
            E.b.view()[@truncate(usize, x.off)] = @truncate(u8, @bit_cast(u64, rel));
            continue;
        }
        let rel = @bit_cast(i64, target) - @bit_cast(i64, x.off + 4);
        E.b.set_u32(@truncate(usize, x.off), @bit_cast(u64, rel));
    }
}

// The offset from rbp of the frame slot of alloca a (dwarf.var_locs).
fn var_slot_off(a: *ir.Value) i64 {
    let k = @int_cast(usize, a.aux);
    if (a.aux < 0) or (k >= MF.slots.len) {
        return dw.NO_LOC;
    }
    return MF.slots.at(k).offset;
}

// What dloc.ax needs of x86-64's machine code (variables' locations).
let DLOC: dloc.Tgt = dloc.Tgt.{ dw_reg: dw_reg, is_exit: is_ret, is_tail: is_tail, slot_off: slot_cfa_off,
                                alloc: 0xffff_ffcf };

// A physical register's DWARF number (System V psABI 3.6.2): rax, rdx, ...,
// then xmm0-15 at 17; -1 for others.
fn dw_reg(r: i32) i32 {
    if (r >= 0) and (r < 16) {
        return @bit_cast(i32, DW_GPR[@as(usize, @bit_cast(u32, r))]);
    }
    if (r >= xe.XMM0) and (r < xe.XMM0 + 16) {
        return 17 + (r - xe.XMM0);
    }
    return -1;
}

// A frame slot's offset from the CFA (rbp + 16).
fn slot_cfa_off(k: i32) i64 {
    if (k < 0) or (@as(usize, @bit_cast(u32, k)) >= MF.slots.len) or frameless {
        return dloc.NO_LOC;
    }
    return MF.slots.at(@as(usize, @bit_cast(u32, k))).offset - 16;
}

// The location of f's first instruction that has one (or f's own).
fn first_src(f: *ir.Func) u32 {
    for bi in 0..MF.blocks.len {
        let mut i = MF.blocks.get(bi).first;
        while u.notnil(i) {
            if i.src != 0 {
                return i.src;
            }
            i = i.next;
        }
    }
    return f.src;
}

// The name of function f (symbol `sym`) for debuggers.
fn dbg_name(f: *ir.Func, sym: []u8) []u8 {
    return dw.func_name(f, elf.display_name(sym));
}

pub fn encode_func(f: *mut ir.Func) void {
    // callee-saved registers in use
    find_saved();
    let sub = frame_layout() - (8 * nsaved);
    frameless = not needs_frame();
    let sw = wrap_block();
    SW = sw;
    // (shrink-wrapped: where each run of frameless blocks starts and ends)
    let mut noframe = u.List.[u64].empty();
    let nb = MF.blocks.len;
    let skip = tidy_branches();
    reuse_flags_across(skip);
    let boff = u.newn.[u64](nb + 1);
    // the line table: (code offset, source location) where the location changes
    let mut rows = u.List.[u64].empty();
    // -g (full): (code offset, lexical block) where the block changes
    let mut scopes = u.List.[u64].empty();
    // frame tables: (offset after each call, its chain)
    let mut calls = u.List.[u64].empty();
    jshort.clear();
    jstart.clear();
    jlabel.clear();
    // where the function will start (see FALIGN)
    let text = OBJ.secs.get(@int_cast(usize, TEXT));
    FBASE = (@as(u64, text.data.len()) + @as(u64, FPAD) + FALIGN - 1) & ~(FALIGN - 1);
    let lal = loop_aligned(skip);
    let dirty_in = upper_dirty();
    // again if relax_jumps finds jumps that take a rel8, and after that while
    // unrelax_jumps finds that padding left some of them out of reach
    let mut pass: i32 = 0;
    loop {
        E = xe.Enc.{ b: bn.new_bytes(), relocs: u.List.[xe.Reloc].empty(), fixups: u.List.[xe.Fixup].empty(),
                     avx: AVX };
        local_off.clear();
        jnext = 0;
        jfix.clear();
        jtabs.clear();
        rows.clear();
        scopes.clear();
        calls.clear();
        noframe.clear();
        cfis.clear();
        in_noframe = false;
        if sw < 0 {
            prologue(sub);
        }
        let lines = WIN or DBG.on;
        let mut last_src = f.src;
        let mut last_scope: u32 = 0;
        if lines and (f.src != 0) {
            rows.push(@as(u64, f.src));
        }
        // -g: the prologue ends (for a debugger: where a breakpoint on the
        // function stops) at the first instruction of another line than the
        // function's own (past the parameters' stores); until then, the
        // first instruction's line
        let mut pe_done = not DBG.on;
        if DBG.on {
            let mut at = @as(u64, E.b.len());
            if sw >= 0 {
                at = 0;
            }
            rows.push((at << 32) | @as(u64, first_src(f)));
            last_src = first_src(f);
        }
        for bi in 0..nb {
            let b = MF.blocks.get(bi);
            if lal[bi] {
                let at = (FBASE + @as(u64, E.b.len())) % LALIGN;
                if (at != 0) and (LALIGN - at <= LMAX) {
                    emit_nops(LALIGN - at);
                }
            }
            boff[bi] = @as(u64, E.b.len());
            dloc.block_at(bi, boff[bi], bi == 0);
            if @as(i32, @int_cast(i32, bi)) == sw {
                in_noframe = true;
                cfi_entry();
                in_noframe = false;
                prologue(sub);  // (jumps into the block go here)
            }
            if skip[bi] {
                continue;
            }
            if (sw >= 0) and (b.noframe != in_noframe) {
                noframe.push(@as(u64, E.b.len()));
                in_noframe = b.noframe;
            }
            if @as(i32, @int_cast(i32, bi)) != sw {
                cfi_body();
            }
            DIRTY = dirty_in[bi];
            let mut i = b.first;
            while u.notnil(i) {
                if writes_wide(i) {
                    DIRTY = true;  // (no call or return writes a vector register)
                }
                if not pe_done and (i.src != 0) and (i.src != f.src) {
                    rows.push(((@as(u64, E.b.len()) << 32) | dw.ROW_PE) | @as(u64, i.src));
                    last_src = i.src;
                    pe_done = true;
                } else if lines and (i.src != 0) and (i.src != last_src) {
                    rows.push((@as(u64, E.b.len()) << 32) | @as(u64, i.src));
                    last_src = i.src;
                }
                if DBG.full and (i.src != 0) and (i.scope != mc.SCOPE_KEEP) and (i.scope != last_scope) {
                    scopes.push((@as(u64, E.b.len()) << 32) | @as(u64, i.scope));
                    last_scope = i.scope;
                }
                dloc.inst_at(i, @as(u64, E.b.len()));
                let last = enc_at(i, bi, skip, lal, sw);
                if FT.on and (i.op == xe.CALL) and not is_tail(i) {
                    let mut at = @as(u64, E.b.len());
                    if in_noframe {
                        at = at | ft.CALL_FRAMELESS;  // (a call that does not return, before the frame is set up)
                    }
                    calls.push(at);
                    calls.push(@bit_cast(u64, i.aux));
                }
                i = last.next;
            }
        }
        if pass == 0 {
            if not relax_jumps(boff[0..nb]) {
                break;
            }
        } else if not unrelax_jumps(boff[0..nb]) {
            break;
        }
        pass += 1;
        E.b.free();
        E.relocs.deinit();
        E.fixups.deinit();
    }
    if in_noframe {
        noframe.push(@as(u64, E.b.len()));
        in_noframe = false;
    }
    resolve_branches(boff);
    // into .text
    text.data.zeros(FPAD);
    text.data.align(@truncate(usize, FALIGN));
    let base = @as(u64, text.data.len());
    if base != FBASE {
        fail("internal compiler error: a function placed elsewhere than expected");
    }
    text.data.put(E.b.view());
    fill_jump_tables(base, boff);
    for k in 0..E.relocs.len {
        let r = E.relocs.get(k);
        text.relocs.push(elf.Rel.{ off: base + r.off, ty: r.ty, sym: @bit_cast(u32, r.sym), addend: r.addend });
    }
    let s = OBJ.syms.at(@as(usize, fsym.get(@int_cast(usize, f.id))));
    s.value = base;
    s.size = @as(u64, E.b.len());
    ft.func(&FT, base, s.size, frameless, noframe.items(), calls.items());
    noframe.deinit();
    if WIN and not frameless {
        emit_unwind(fsym.get(@int_cast(usize, f.id)), base, @as(u64, E.b.len()));
    }
    if WIN and (rows.len > 0) {
        emit_lines(s.name, rows.items());
    }
    if DBG.on {
        let mut regs: [8]u64 = [0; 8];
        regs[0] = dw.saved_reg(dw.X64_RBP, -16);
        for k in 0..@int_cast(usize, nsaved) {
            regs[k + 1] = dw.saved_reg(
                DW_GPR[@as(usize, @bit_cast(u32, saved[k] & 15))], -24 - (8 * @as(i64, @int_cast(i64, k))));
        }
        let df = dw.Func.{ sym: fsym.get(@int_cast(usize, f.id)), name: dbg_name(f, s.name),
                           external: s.bind != elf.B_LOCAL, size: s.size, src: f.src, rows: rows.items(),
                           scopes: scopes.items(), cfi: cfis.items(), regs: regs[0..@int_cast(usize, nsaved) + 1],
                           irf: f, vars: dw.var_locs(f, var_slot_off, 16), vlocs: dloc.compute(MF, &DLOC, s.size) };
        dw.add_func(&mut DBG, &df);
    }
    E.b.free();
    E.relocs.deinit();
    E.fixups.deinit();
    rows.deinit();
    scopes.deinit();
    calls.deinit();
}

// -----------------------------------------------------------------------------
// Module
// -----------------------------------------------------------------------------
// The code placement knobs (above), from the environment
pub fn placement_knobs() void {
    FPAD = @int_cast(usize, u.env_num("AXIOM_X64_FPAD", 0));
    FALIGN = @int_cast(u64, u.env_num("AXIOM_X64_FALIGN", 16));
    LALIGN = @int_cast(u64, u.env_num("AXIOM_X64_LALIGN", 0));
    LMAX = @int_cast(u64, u.env_num("AXIOM_X64_LMAX", 15));
    LMODE = @int_cast(i32, u.env_num("AXIOM_X64_LMODE", 1));
    JCC = u.env_num("AXIOM_X64_JCC", 0) != 0;
}
