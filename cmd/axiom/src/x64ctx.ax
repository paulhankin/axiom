// =============================================================================
// x64ctx.ax - the x86-64 backend's state: the object being written and the
// function being compiled, which instruction selection (x64.ax) and emission
// (x64emit.ax) share. Each of those keeps the rest of its state in one struct
// of its own (State, S), so these values are all a compilation's x86-64 backend
// state: what a compilation unit, or a thread, would own.
// =============================================================================

import "bin.ax" as bn;
import "dwarf.ax" as dw;
import "elf.ax" as elf;
import "ftab.ax" as ft;
import "ir.ax" as ir;
import "mach.ax" as mc;
import "macunwind.ax" as mu;
import "util.ax" as u;

// The object being written (x64.ax compile)
pub struct Obj {
    obj: *mut elf.Obj,
    text: i32,
    lines: i32,    // Windows: line tables (.axiom.lines, for plink.ax's PDB)
    dbg: dw.Unit,  // -g: DWARF (dwarf.ax; not on Windows)
    xdata: i32,    // Windows: unwind information, and the function table
    pdata: i32,
    xdata_sym: u32,
    ft: ft.Tab,  // frame tables (ftab.ax)
    fsym: u.List.[u32],
    errors: bool,
    win: bool,    // Windows x64: its calling convention, and thread-locals through the TEB
    macos: bool,  // macOS: thread-locals in a block a TSD slot (gs-relative) holds
    // macOS: the unwind tables (macunwind.ax), from the call frame states
    // (recorded for every function there, with or without -g)
    mu: mu.Out,
    // instruction selection's: read-only data, the globals' symbols, the
    // constants pooled there (const_sym), and the symbols of the thread-local
    // helpers (Windows: _tls_index; macOS: the TSD key)
    rodata: i32,
    gsym: u.List.[u32],
    consts: u.SymMap.[u32],
    tls_index_si: i32,
    tls_key_si: i32,
}

pub threadlocal let mut O: Obj = Obj.{ obj: @ptr_from_int(*mut elf.Obj, 0), text: 0, lines: -1,
                                       dbg: dw.Unit.{ on: false, arch: 0, addr_size: 8, full: false, lang: 0,
                                                      parts: [dw.Part.{ b: bn.Bytes.{ b: u.List.[u8].{ data: @ptr_from_int(*mut u8,
                                                                                                                           0),
                                                                                                       len: 0,
                                                                                                       cap: 0 } },
                                                                        fx: u.List.[dw.Fix].{ data: @ptr_from_int(*mut dw.Fix,
                                                                                                                  0),
                                                                                              len: 0, cap: 0 } }; 11],
                                                      strs: u.SymMap.[u32].{
                                                          keys: @ptr_from_int(*mut usize, 0),
                                                          vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                                      lstrs: u.SymMap.[u32].{
                                                          keys: @ptr_from_int(*mut usize, 0),
                                                          vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                                      files: u.List.[u32].{
                                                          data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 },
                                                      fmap: u.SymMap.[u32].{
                                                          keys: @ptr_from_int(*mut usize, 0),
                                                          vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                                      by_id: u.List.[u32].{
                                                          data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 }, nfuncs: 0,
                                                      first_src: 0, text_sym: 0,
                                                      trefs: u.List.[dw.Fix].{
                                                          data: @ptr_from_int(*mut dw.Fix, 0), len: 0, cap: 0 },
                                                      gsyms: u.SymMap.[u32].{
                                                          keys: @ptr_from_int(*mut usize, 0),
                                                          vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                                      toff: u.List.[u64].{
                                                          data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 },
                                                      drefs: u.List.[dw.Fix].{
                                                          data: @ptr_from_int(*mut dw.Fix, 0), len: 0, cap: 0 },
                                                      gdone: u.List.[bool].{
                                                          data: @ptr_from_int(*mut bool, 0), len: 0, cap: 0 },
                                                      voffs: u.List.[u64].{
                                                          data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 },
                                                      tls_rel: 0, cies: [0; 4], size_fix: false,
                                                      sums: u.List.[[16]u8].{
                                                          data: @ptr_from_int(*mut [16]u8, 0), len: 0, cap: 0 },
                                                      nosum: false,
                                                      names: u.List.[dw.Named].{
                                                          data: @ptr_from_int(*mut dw.Named, 0), len: 0, cap: 0 },
                                                      abs_fns: u.List.[[]u8].{
                                                          data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 },
                                                      abs_map: u.SymMap.[u32].{
                                                          keys: @ptr_from_int(*mut usize, 0),
                                                          vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                                      arefs: u.List.[dw.Fix].{
                                                          data: @ptr_from_int(*mut dw.Fix, 0), len: 0, cap: 0 },
                                                      ranges: u.List.[u64].{
                                                          data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 },
                                                      lrefs: u.List.[dw.Fix].{
                                                          data: @ptr_from_int(*mut dw.Fix, 0), len: 0, cap: 0 } },
                                       xdata: -1, pdata: -1, xdata_sym: 0,
                                       ft: ft.Tab.{ on: false, obj: @ptr_from_int(*mut elf.Obj, 0), rets: -1,
                                                    chains: -1, text_sym: 0, chains_sym: 0, text0: -1, rets0: -1,
                                                    cur_text: -1,
                                                    others: u.List.[u64].{
                                                        data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 }, rel32: 0,
                                                    abs64: 0, empty: 0, lines: false, ro: -1, ro_sym: 0,
                                                    rec_of: u.U64Map.{ keys: @ptr_from_int(*mut u64, 0),
                                                                       vals: @ptr_from_int(*mut u64, 0), cap: 0,
                                                                       len: 0 },
                                                    recs: u.U64Map.{ keys: @ptr_from_int(*mut u64, 0),
                                                                     vals: @ptr_from_int(*mut u64, 0), cap: 0, len: 0 },
                                                    pairs: u.U64Map.{ keys: @ptr_from_int(*mut u64, 0),
                                                                      vals: @ptr_from_int(*mut u64, 0), cap: 0,
                                                                      len: 0 },
                                                    ctxs: u.U64Map.{ keys: @ptr_from_int(*mut u64, 0),
                                                                     vals: @ptr_from_int(*mut u64, 0), cap: 0, len: 0 },
                                                    strs: u.SymMap.[u64].{
                                                        keys: @ptr_from_int(*mut usize, 0),
                                                        vals: @ptr_from_int(*mut u64, 0), cap: 0, len: 0 }, last: [
                                                            0, 0] }, fsym: u.List.[u32].{
                                                                data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 },
                                       errors: false, win: false, macos: false,
                                       mu: mu.Out.{ on: false, obj: @ptr_from_int(*mut elf.Obj, 0), x64: true,
                                                    elf: false, cu: -1, eh: -1, cies: [0; 4] }, rodata: 0,
                                       gsym: u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 },
                                       consts: u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0),
                                                                vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                       tls_index_si: -1, tls_key_si: -1 };

// The function being compiled (x64.ax compile_func)
pub struct Func {
    f: *mut ir.Func,
    mf: *mut mc.MFunc,
    avx: bool,      // (the function's own extensions: tg.begin_fn)
    upper: bool,    // the function uses ymm or zmm registers (vzeroupper before calls and returns)
    wide_in: bool,  // it takes a ymm or zmm argument (the upper halves in use on entry)
    out_area: u64,  // outgoing stack-argument bytes
    pre_ra: bool,   // (P names virtual registers: before allocation)
    // Shrink-wrapping (mc.shrink_wrap; not on Windows, whose unwind tables
    // describe a prologue at the start): blocks before SW run without the frame,
    // which block SW sets up (x64emit.ax: in_noframe while they are encoded).
    sw: i32,
}

pub threadlocal let mut FN: Func = Func.{ f: @ptr_from_int(*mut ir.Func, 0), mf: @ptr_from_int(*mut mc.MFunc, 0),
                                          avx: false, upper: false, wide_in: false, out_area: 0, pre_ra: false,
                                          sw: -1 };
