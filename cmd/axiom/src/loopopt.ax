// =============================================================================
// loopopt.ax - the loop passes over gvn.ax's memory model (its locations,
// alias queries and write summaries), run from passes.ax:
//
//   - licm: loop-invariant code motion, promotion of a location to a
//     register across a loop, and loop guards (a loop whose header only
//     tests its exit, rotated behind a copy of that test);
//   - loop_idioms: loops that store one value to consecutive elements as
//     memset;
//   - split_loops: loops whose bounds checks a split of the iteration range
//     proves;
//   - sink: instructions computed only for some paths moved down to them;
//   - reduce_addresses: strength reduction of addresses in loops.
// =============================================================================
import "combine.ax" as cb;
import "gvn.ax" as gvn;
import "ir.ax" as ir;
import "opt.ax" as opt;
import "util.ax" as u;

// -----------------------------------------------------------------------------
// Loop-invariant code motion: instructions of a loop whose operands come
// from outside it move to its preheader (inner loops first, so they can
// move out of several). Hoisted: operations without effects that cannot
// trap (divisions only by a nonzero constant), and loads that no write in
// the loop may alias and that may run early: in the header (which runs
// whenever the loop is entered), or within a stack slot or global.
// -----------------------------------------------------------------------------
threadlocal let mut loop_mark: i64 = 0x1000_0000;

// A preheader for h (members marked `tag`): the only outside predecessor
// when it ends in `br h`, else a new block the outside edges go through.
pub fn make_preheader(f: *mut ir.Func, h: *mut ir.Block, tag: i64) bool {
    let mut outside = u.List.[*mut ir.Block].empty();
    for k in 0..h.preds.len {
        let p = h.preds.get(k);
        if p.mark != tag {
            outside.push(p);
        }
    }
    let mut made = false;
    if (outside.len == 1) and (ir.succ_count(ir.terminator(outside.get(0))) == 1) {
        // already one
    } else if outside.len > 0 {
        let pre = ir.append_block(f, "preheader");
        let br = ir.new_inst(f, ir.OP_BR, ir.t_void());
        br.t1 = h;
        ir.append_inst(pre, br);
        for k in 0..outside.len {
            ir.retarget(outside.get(k), h, pre);
            pre.preds.push(outside.get(k));
        }
        // (and the predecessor lists, where the callers look for it)
        let mut n: usize = 0;
        for k in 0..h.preds.len {
            if h.preds.get(k).mark == tag {
                h.preds.set(n, h.preds.get(k));
                n += 1;
            }
        }
        while h.preds.len > n {
            _ = h.preds.pop();
        }
        h.preds.push(pre);
        // h's phis: the outside inputs merge in the preheader
        let bld = ir.new_builder();
        let mut p = h.first;
        while u.notnil(p) and (p.op == ir.OP_PHI) {
            let mut np = gvn.vnil();
            if outside.len > 1 {
                ir.at_before(bld, br);
                np = ir.phi(bld, p.ty);
            }
            let mut k: usize = 0;
            while k < ir.bs_of(p).len {
                let from = ir.bs_of(p).get(k);
                if from.mark != tag {
                    if u.notnil(np) {
                        ir.add_incoming(np, p.xs.get(k), from);
                        ir.remove_incoming(p, k);
                        continue;
                    }
                    ir.bs_of(p).set(k, pre);
                }
                k += 1;
            }
            if u.notnil(np) {
                ir.add_incoming(p, np, pre);
            }
            p = p.next;
        }
        made = true;
    }
    outside.deinit();
    return made;
}

// Is the load at l safe to run before the loop without the loop's guard?
fn deref_ok(l: *gvn.Loc, size: i64) bool {
    if u.isnil(l.obj) and u.notnil(l.base) and (l.base.kind == ir.V_PARAM) and (l.off >= 0) and (size >= 0) {
        // a parameter declared [static n] (ir.Func.param_bytes): its first
        // bytes are there whenever the function runs (C 6.7.6.3p7)
        let f = ir.fnp_of(l.base);
        let k = @truncate(usize, l.base.cv);
        return u.notnil(f) and (k < f.param_bytes.len) and ((l.off + size) <= @bit_cast(i64, f.param_bytes[k]));
    }
    if u.isnil(l.obj) or not l.rok or (l.rlo < 0) {
        return false;
    }
    let mut objsize: u64 = 0;
    if ir.is_op(l.obj, ir.OP_ALLOCA) {
        objsize = ir.aty_of(l.obj).size;
    } else if l.obj.kind == ir.V_GLOBAL {
        if ir.gv_of(l.obj).tls {
            return false;
        }
        objsize = ir.gv_of(l.obj).ty.size;
    } else {
        return false;
    }
    return (l.rhi + size) <= @bit_cast(i64, objsize);
}

pub fn licm(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    // preheaders
    opt.compute_preds(f);
    let mut order = opt.dominators(f);
    let mut hs = opt.loop_headers(&order);
    if hs.len == 0 {
        order.deinit();
        return false;
    }
    let mut members = u.List.[*mut ir.Block].empty();
    let mut made = false;
    for k in 0..hs.len {
        loop_mark += 1;
        opt.members_of(hs.get(k), loop_mark, &mut members);
        if make_preheader(f, hs.get(k), loop_mark) {
            made = true;
        }
    }
    if made {
        order.deinit();
        hs.deinit();
        opt.compute_preds(f);
        order = opt.dominators(f);
        hs = opt.loop_headers(&order);
    }
    gvn.escapes(f);
    // loops entered through a guard, whose first body block then runs
    // whenever the preheader does (its loads hoisted like the header's)
    guarded.clear();
    let mut gd = false;
    for k in 0..hs.len {
        loop_mark += 1;
        opt.members_of(hs.get(k), loop_mark, &mut members);
        if guard_loop(f, hs.get(k), loop_mark, &members) {
            gd = true;
            // (the dominator tree as it now is, which the next loop's
            // values_stay_in asks)
            order.deinit();
            opt.compute_preds(f);
            order = opt.dominators(f);
        }
    }
    if gd {
        order.deinit();
        hs.deinit();
        opt.compute_preds(f);
        order = opt.dominators(f);
        hs = opt.loop_headers(&order);
    }
    // inner loops first
    for i in 1..hs.len {
        let mut j = i;
        while (j > 0) and (hs.get(j - 1).depth < hs.get(j).depth) {
            let t = hs.get(j - 1);
            hs.set(j - 1, hs.get(j));
            hs.set(j, t);
            j -= 1;
        }
    }
    let mut any = false;
    for hi in 0..hs.len {
        let h = hs.get(hi);
        loop_mark += 1;
        let tag = loop_mark;
        opt.members_of(h, tag, &mut members);
        let mut pre = ir.bnil();
        for k in 0..h.preds.len {
            if h.preds.get(k).mark != tag {
                pre = h.preds.get(k);
            }
        }
        if u.isnil(pre) or (ir.succ_count(ir.terminator(pre)) != 1) {
            continue;
        }
        let at = ir.terminator(pre);
        // the loop's writes (for loads)
        gvn.writes.clear();
        for k in 0..members.len {
            let mut i = members.get(k).first;
            while u.notnil(i) {
                gvn.note_writes(i);
                i = i.next;
            }
        }
        // in dominance order: the header first, then the rest by rpo
        if members.len > 2 {
            sort_by_rpo(members.items()[1..members.len]);
        }
        let first = first_body(h, tag);
        for k in 0..members.len {
            let b = members.get(k);
            // (the instructions of the header, or of the first block of a
            // guarded loop, run whenever the preheader does up to the first
            // that may not return)
            let mut runs = (b == h) or (b == first);
            let mut i = b.first;
            while u.notnil(i) {
                let next = i.next;
                if hoist_ok(i, tag, runs) {
                    ir.remove_inst(i);
                    ir.insert_before(at, i);
                    any = true;
                } else if runs and gvn.may_stop(i) {
                    runs = false;
                }
                i = next;
            }
        }
        if promote(f, h, tag, &members, pre) {
            any = true;
            // (the exits' new blocks in the dominator tree, which the loops
            // around this one ask)
            opt.compute_preds(f);
            order.deinit();
            order = opt.dominators(f);
        }
    }
    members.deinit();
    order.deinit();
    hs.deinit();
    return any or made;
}

// -----------------------------------------------------------------------------
// Promotion of a location to a register across a loop: a global at a fixed
// address that the loop stores to (a counter, `steps += 1`) and accesses only
// by that address, with nothing else in the loop that may read or write it
// (no call, no access that may alias, nothing volatile or atomic, no fence),
// is loaded before the loop, kept in a stack slot of its own in the loop
// (which mem2reg makes a register), and stored back on every exit from the
// loop. The store back writes nothing the program did not: the loop must
// have stored to the location before any exit is taken (a store executes
// before each exiting block, or, for the header's exit, on every way to the
// latches of a loop entered through a guard, which runs it at least once),
// or the exit must end the program (a trap). The load before the loop reads
// what the program may not have read (a global, in bounds: it cannot fault).
// No other thread can see the difference without a data race.
// -----------------------------------------------------------------------------
fn promotable_store(i: *ir.Value, tag: i64) bool {
    if (i.op != ir.OP_STORE) or (i.flags != 0) or not invariant(i.b, tag) or (i.a.ty.size == 0) or
       ((i.a.ty.kind != ir.T_INT) and (i.a.ty.kind != ir.T_FLOAT) and (i.a.ty.kind != ir.T_PTR)) {
        return false;
    }
    let sz = @bit_cast(i64, i.a.ty.size);
    let l = gvn.loc_of(i.b, sz);
    if u.isnil(l.obj) or (l.obj.kind != ir.V_GLOBAL) or gvn.noalias_global(l.obj) or ir.gv_of(l.obj).is_const or
       not deref_ok(&l, sz) or (l.rlo != l.rhi) {
        return false;
    }
    return true;
}

// Do the loop's other instructions leave the location at p (type t) alone,
// and are its own accesses all loads and stores of t at p?
fn only_accessed_at(members: *u.List.[*mut ir.Block], p: *mut ir.Value, t: *mut ir.Ty) bool {
    let l = gvn.loc_of(p, @bit_cast(i64, t.size));
    let w = gvn.loc_write(&l);
    for k in 0..members.len {
        let mut i = members.get(k).first;
        while u.notnil(i) {
            let op = i.op;
            if (op == ir.OP_LOAD) or (op == ir.OP_STORE) {
                let mut addr = i.a;
                let mut ty = i.ty;
                if op == ir.OP_STORE {
                    addr = i.b;
                    ty = i.a.ty;
                }
                if i.flags != 0 {
                    return false;
                }
                if ir.resolve(addr) == p {
                    if ty != t {
                        return false;
                    }
                } else {
                    let x = gvn.loc_of(addr, @bit_cast(i64, ty.size));
                    if gvn.may_alias(&x, &w) {
                        return false;
                    }
                }
            } else if (op == ir.OP_MEMCPY) or (op == ir.OP_MEMMOVE) or (op == ir.OP_MEMSET) {
                if i.flags != 0 {
                    return false;
                }
                let n = gvn.size_of(i.c);
                let d = gvn.loc_of(i.a, n);
                if gvn.may_alias(&d, &w) {
                    return false;
                }
                if op != ir.OP_MEMSET {
                    let sl = gvn.loc_of(i.b, n);
                    if gvn.may_alias(&sl, &w) {
                        return false;
                    }
                }
            } else if (op == ir.OP_CALL) or (op == ir.OP_RMW) or (op == ir.OP_CMPXCHG) or (op == ir.OP_FENCE) {
                return false;
            } else if gvn.exact_asm(i) {
                for m in ir.asm_mem_of(i) {
                    let x = gvn.asm_loc(i, m);
                    if gvn.may_alias(&x, &w) {
                        return false;
                    }
                }
            } else if (op == ir.OP_INTR) and
                      ((ir.inst_props(i) & (ir.INF_READS_MEM | ir.INF_WRITES_MEM | ir.INF_OPAQUE)) != 0) {
                return false;
            } else if ir.op_writes_mem(op) {
                return false;
            }
            i = i.next;
        }
    }
    return true;
}

// Has the loop stored to p before each of its exits is taken (see above)?
fn stored_before_exits(h: *mut ir.Block, tag: i64, members: *u.List.[*mut ir.Block], p: *mut ir.Value) bool {
    // the blocks of the stores
    let mut sb = u.List.[*mut ir.Block].empty();
    for k in 0..members.len {
        let mut i = members.get(k).first;
        while u.notnil(i) {
            if (i.op == ir.OP_STORE) and (i.b == p) {
                sb.push(members.get(k));
            }
            i = i.next;
        }
    }
    let mut ok = true;
    for k in 0..members.len {
        let b = members.get(k);
        let t = ir.terminator(b);
        for j in 0..ir.succ_count(t) {
            let x = ir.succ(t, j);
            if (x.mark == tag) or trap_exit(x, tag) {
                continue;
            }
            if (b == h) and not dominated_by_any(b, &sb) {
                // a guarded loop runs its body once: the header's exit is
                // taken after a latch, which a store's block dominates
                if u.isnil(first_body(h, tag)) {
                    ok = false;
                }
                for q in 0..h.preds.len {
                    let l = h.preds.get(q);
                    if (l.mark == tag) and not dominated_by_any(l, &sb) {
                        ok = false;
                    }
                }
            } else if not dominated_by_any(b, &sb) {
                ok = false;
            }
        }
    }
    sb.deinit();
    return ok;
}

fn dominated_by_any(b: *mut ir.Block, sb: *u.List.[*mut ir.Block]) bool {
    for k in 0..sb.len {
        if opt.dominates(sb.get(k), b) {
            return true;
        }
    }
    return false;
}

// Set when promote made a slot: mem2reg has work (passes.ax).
pub threadlocal let mut promoted: bool = false;

fn promote(f: *mut ir.Func, h: *mut ir.Block, tag: i64, members: *u.List.[*mut ir.Block], pre: *mut ir.Block) bool {
    let mut done = false;
    for k in 0..members.len {
        let mut i = members.get(k).first;
        while u.notnil(i) and not done {
            if promotable_store(i, tag) {
                let p = i.b;
                let t = i.a.ty;
                if only_accessed_at(members, p, t) and stored_before_exits(h, tag, members, p) {
                    promote_at(f, tag, members, pre, p, t, i.align);
                    done = true;
                    promoted = true;
                }
            }
            i = i.next;
        }
    }
    return done;
}

fn promote_at(f: *mut ir.Func, tag: i64, members: *u.List.[*mut ir.Block], pre: *mut ir.Block, p: *mut ir.Value,
              t: *mut ir.Ty, align: u32) void {
    let bld = ir.new_builder();
    ir.at_before(bld, f.first.first);
    let slot = ir.alloca(bld, t, "promoted");
    ir.at_before(bld, ir.terminator(pre));
    let v0 = ir.load(bld, t, p);
    v0.align = align;
    _ = ir.store(bld, v0, slot);
    // the loop's accesses to the slot
    let mut exits = u.List.[*mut ir.Block].empty();
    for k in 0..members.len {
        let b = members.get(k);
        let mut i = b.first;
        while u.notnil(i) {
            if (i.op == ir.OP_LOAD) and (i.a == p) {
                ir.set_a(i, slot);
                i.align = slot.align;
            } else if (i.op == ir.OP_STORE) and (i.b == p) {
                ir.set_b(i, slot);
                i.align = slot.align;
            }
            i = i.next;
        }
        let tm = ir.terminator(b);
        for j in 0..ir.succ_count(tm) {
            let x = ir.succ(tm, j);
            let mut seen = false;
            let mut q: usize = 0;
            while q < exits.len {
                if (exits.get(q) == b) and (exits.get(q + 1) == x) {
                    seen = true;
                }
                q += 2;
            }
            if (x.mark != tag) and not seen {
                exits.push(b);
                exits.push(x);
            }
        }
    }
    // and its value stored back on the way out
    let mut k: usize = 0;
    while k < exits.len {
        let b = exits.get(k);
        let x = exits.get(k + 1);
        let e = ir.edge_block(f, "promoted.exit", b, x);
        ir.retarget(b, x, e);
        ir.at_before(bld, ir.terminator(e));
        let v = ir.load(bld, t, slot);
        let st = ir.store(bld, v, p);
        st.align = align;
        k += 2;
    }
    exits.deinit();
}

// -----------------------------------------------------------------------------
// Loop guards. A loop whose header only computes its exit test (phis, pure
// arithmetic, a branch out or into the body's first block S, entered only
// from the header) and whose values are not used outside it can be entered
// through a copy of the test: P -> G (the test on the entry values) -> P2 ->
// H, G going straight to the exit when it fails. Then S runs whenever P2
// does, and the loads of S that the loop does not write can move to P2
// although nothing else shows their addresses are readable. Only for loops
// with such a load.
// -----------------------------------------------------------------------------
threadlocal let mut guarded: u.List.[*mut ir.Block] = u.List.[*mut ir.Block].{
    data: @ptr_from_int(*mut *mut ir.Block, 0), len: 0, cap: 0 };

// The body's first block of a guarded loop with header h (nil otherwise).
fn first_body(h: *mut ir.Block, tag: i64) *mut ir.Block {
    let mut g = false;
    for k in 0..guarded.len {
        if guarded.get(k) == h {
            g = true;
        }
    }
    if not g {
        return ir.bnil();
    }
    let t = ir.terminator(h);
    if u.isnil(t) or (t.op != ir.OP_CONDBR) {
        return ir.bnil();
    }
    let mut s = t.t1;
    if s.mark != tag {
        s = t.t2;
    }
    if (s.mark != tag) or (s == h) or (s.preds.len != 1) {
        return ir.bnil();
    }
    return s;
}

fn guard_map(v: *mut ir.Value, h: *mut ir.Block, pre: *mut ir.Block) *mut ir.Value {
    if u.notnil(v) and (v.kind == ir.V_INST) and (v.blk == h) {
        if v.op == ir.OP_PHI {
            return ir.incoming(v, pre);
        }
        return @ptr_cast(*mut ir.Value, v.auxp);
    }
    return v;
}

fn defined_in(v: *ir.Value, h: *mut ir.Block) bool {
    return u.notnil(v) and (v.kind == ir.V_INST) and (v.blk == h);
}

// Is the header h (ending in its test t) a test of no effect, cheap to
// copy?
fn cheap_test(h: *mut ir.Block, t: *mut ir.Value) bool {
    let mut n: i32 = 0;
    let mut i = h.first;
    while u.notnil(i) and (i != t) {
        if i.op != ir.OP_PHI {
            if ir.has_effects(i) or (i.op == ir.OP_LOAD) or (i.op == ir.OP_CALL) or (i.op == ir.OP_ALLOCA) or
               (i.op == ir.OP_INTR) {
                return false;
            }
            n += 1;
        }
        i = i.next;
    }
    return n <= 8;
}

// Is there a load in s (the loop's first block after the header) to
// hoist that only the guard makes safe?
fn guard_wanted(s: *mut ir.Block, tag: i64, members: *u.List.[*mut ir.Block]) bool {
    gvn.writes.clear();
    for k in 0..members.len {
        let mut w = members.get(k).first;
        while u.notnil(w) {
            gvn.note_writes(w);
            w = w.next;
        }
    }
    let mut want = false;
    let mut i = s.first;
    while u.notnil(i) and not want {
        if (i.op == ir.OP_LOAD) and hoist_ok(i, tag, true) and not hoist_ok(i, tag, false) {
            want = true;
        }
        // (or a call that writes nothing, ir.call_fx, which runs before the
        // loop only where the body runs at least once)
        if (i.op == ir.OP_CALL) and hoist_ok(i, tag, true) {
            want = true;
        }
        if gvn.may_stop(i) {
            break;
        }
        i = i.next;
    }
    // or a store promote may keep in a register once the body runs
    for k in 0..members.len {
        let mut w = members.get(k).first;
        while u.notnil(w) and not want {
            if promotable_store(w, tag) and only_accessed_at(members, w.b, w.a.ty) {
                want = true;
            }
            w = w.next;
        }
    }
    return want;
}

// Are the header's values used only in the loop, by the exit's phis on the
// edge from the header, in blocks the exit x does not reach without passing
// through the loop (all ways to them still pass through the header), and
// (when x has no other predecessor than the header) in blocks x dominates?
// The guard then gives those last uses a phi in x of the header's value and
// the guard's copy of it: every way to them passes through x, entered either
// from the header or from the guard.
fn values_stay_in(f: *mut ir.Func, h: *mut ir.Block, tag: i64, x: *mut ir.Block) bool {
    let below_x = (x.preds.len == 1) and (x.preds.get(0) == h);
    // the blocks x reaches outside the loop (aux = stamp)
    loop_mark += 1;
    let stamp = loop_mark;
    let mut work = u.List.[*mut ir.Block].empty();
    x.aux = stamp;
    work.push(x);
    while work.len > 0 {
        let b = work.pop();
        let t = ir.terminator(b);
        for k in 0..ir.succ_count(t) {
            let sb = ir.succ(t, k);
            if (sb.mark != tag) and (sb.aux != stamp) {
                sb.aux = stamp;
                work.push(sb);
            }
        }
    }
    work.deinit();
    let mut b = f.first;
    while u.notnil(b) {
        if b.mark != tag {
            let mut y = b.first;
            while u.notnil(y) {
                if y.op == ir.OP_PHI {
                    for k in 0..y.xs.len {
                        let from = ir.bs_of(y).get(k);
                        if defined_in(y.xs.get(k), h) and (from.mark != tag) and (from.aux == stamp) and
                           not (below_x and opt.dominates(x, from)) {
                            return false;
                        }
                    }
                } else if (defined_in(y.a, h) or defined_in(y.b, h) or defined_in(y.c, h) or uses_in(y, h)) and
                          (b.aux == stamp) and not (below_x and opt.dominates(x, b)) {
                    return false;
                }
                y = y.next;
            }
        }
        b = b.next;
    }
    return true;
}

fn uses_in(y: *ir.Value, h: *mut ir.Block) bool {
    for k in 0..y.xs.len {
        if defined_in(y.xs.get(k), h) {
            return true;
        }
    }
    return false;
}

// After guard_loop made G: the uses outside the loop (in blocks below the
// exit x, values_stay_in) of a value v defined in the header h, other than
// the exit's phis on the edge from h, use a phi in x of v (from h) and G's
// copy of it (from g) instead.
fn exit_phis(f: *mut ir.Func, h: *mut ir.Block, tag: i64, x: *mut ir.Block, g: *mut ir.Block, pre: *mut ir.Block) void {
    let bld = ir.new_builder();
    xphi_of.clear();
    xphis.clear();
    let stamp = x.aux;  // (values_stay_in's marks: the blocks x reaches)
    let mut b = f.first;
    while u.notnil(b) {
        if (b.mark != tag) and (b != g) and (b.aux == stamp) {
            let mut y = b.first;
            while u.notnil(y) {
                if y.op == ir.OP_PHI {
                    for k in 0..y.xs.len {
                        let from = ir.bs_of(y).get(k);
                        let v = y.xs.get(k);
                        if defined_in(v, h) and (from.mark != tag) and (from != g) and (from.aux == stamp) {
                            ir.set_x(y, k, exit_phi(bld, v, h, x, g, pre));
                        }
                    }
                } else {
                    if defined_in(y.a, h) {
                        ir.set_a(y, exit_phi(bld, y.a, h, x, g, pre));
                    }
                    if defined_in(y.b, h) {
                        ir.set_b(y, exit_phi(bld, y.b, h, x, g, pre));
                    }
                    if defined_in(y.c, h) {
                        ir.set_c(y, exit_phi(bld, y.c, h, x, g, pre));
                    }
                    for k in 0..y.xs.len {
                        if defined_in(y.xs.get(k), h) {
                            ir.set_x(y, k, exit_phi(bld, y.xs.get(k), h, x, g, pre));
                        }
                    }
                }
                y = y.next;
            }
        }
        b = b.next;
    }
}

// The phi in x of v for exit_phis (made once: xphi_of, xphis).
threadlocal let mut xphi_of: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{
    data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0, cap: 0 };
threadlocal let mut xphis: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{
    data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0, cap: 0 };

fn exit_phi(bld: *mut ir.Builder, v: *mut ir.Value, h: *mut ir.Block, x: *mut ir.Block, g: *mut ir.Block,
            pre: *mut ir.Block) *mut ir.Value {
    for k in 0..xphi_of.len {
        if xphi_of.get(k) == v {
            return xphis.get(k);
        }
    }
    ir.at_before(bld, x.first);
    let p = ir.phi(bld, v.ty);
    ir.add_incoming(p, v, h);
    ir.add_incoming(p, guard_map(v, h, pre), g);
    xphi_of.push(v);
    xphis.push(p);
    return p;
}

fn guard_loop(f: *mut ir.Func, h: *mut ir.Block, tag: i64, members: *u.List.[*mut ir.Block]) bool {
    if not ir.can_copy_block(h) {
        return false;  // (inline assembly that defines symbols: not copied)
    }
    let mut pre = ir.bnil();
    for k in 0..h.preds.len {
        if h.preds.get(k).mark != tag {
            if u.notnil(pre) {
                return false;
            }
            pre = h.preds.get(k);
        }
    }
    if u.isnil(pre) or (ir.succ_count(ir.terminator(pre)) != 1) {
        return false;
    }
    let t = ir.terminator(h);
    if u.isnil(t) or (t.op != ir.OP_CONDBR) or (t.t1 == t.t2) {
        return false;
    }
    let mut s = t.t1;
    let mut x = t.t2;
    if s.mark != tag {
        s = t.t2;
        x = t.t1;
    }
    if (s.mark != tag) or (x.mark == tag) or (s == h) or (s.preds.len != 1) {
        return false;
    }
    if not cheap_test(h, t) or not guard_wanted(s, tag, members) or not values_stay_in(f, h, tag, x) {
        return false;
    }
    // P -> G -> P2 -> H
    let g = ir.append_block(f, "guard");
    ir.move_block_after(g, pre);
    let p2 = ir.append_block(f, "preheader");
    ir.move_block_after(p2, g);
    let mut i = h.first;
    while u.notnil(i) and (i != t) {
        if i.op != ir.OP_PHI {
            let y = ir.copy_inst(f, i);
            ir.set_a(y, guard_map(y.a, h, pre));
            ir.set_b(y, guard_map(y.b, h, pre));
            ir.set_c(y, guard_map(y.c, h, pre));
            for k in 0..y.xs.len {
                ir.set_x(y, k, guard_map(y.xs.get(k), h, pre));
            }
            i.auxp = @ptr_cast(*mut void, y);
            ir.append_inst(g, y);
        }
        i = i.next;
    }
    let gb = ir.new_builder();
    ir.at_end(gb, g);
    let c = guard_map(t.a, h, pre);
    if t.t1 == s {
        ir.condbr(gb, c, p2, x);
    } else {
        ir.condbr(gb, c, x, p2);
    }
    ir.at_end(gb, p2);
    ir.br(gb, h);
    // the exit's phis: on the way from G, the header's values as G has them
    let mut q = x.first;
    while u.notnil(q) and (q.op == ir.OP_PHI) {
        let v = ir.incoming(q, h);
        if u.notnil(v) {
            ir.add_incoming(q, guard_map(ir.resolve(v), h, pre), g);
        }
        q = q.next;
    }
    exit_phis(f, h, tag, x, g, pre);
    ir.retarget(pre, h, g);
    q = h.first;
    while u.notnil(q) and (q.op == ir.OP_PHI) {
        for k in 0..ir.bs_of(q).len {
            if ir.bs_of(q).get(k) == pre {
                ir.bs_of(q).set(k, p2);
            }
        }
        q = q.next;
    }
    // (the predecessor lists and loop marks as they now are, for the loops
    // looked at next)
    g.preds.push(pre);
    p2.preds.push(g);
    for k in 0..h.preds.len {
        if h.preds.get(k) == pre {
            h.preds.set(k, p2);
        }
    }
    x.preds.push(g);
    g.mark = pre.mark;
    p2.mark = pre.mark;
    guarded.push(h);
    return true;
}

// Blocks into increasing rpo (each block's own: no two equal).
threadlocal let mut rpo_keys: u.List.[usize] = u.List.[usize].{ data: @ptr_from_int(*mut usize, 0), len: 0, cap: 0 };
threadlocal let mut rpo_was: u.List.[*mut ir.Block] = u.List.[*mut ir.Block].{
    data: @ptr_from_int(*mut *mut ir.Block, 0), len: 0, cap: 0 };

fn sort_by_rpo(bs: []mut *mut ir.Block) void {
    rpo_keys.clear();
    rpo_was.clear();
    for k in 0..bs.len {
        rpo_keys.push((@as(usize, @bit_cast(u32, bs[k].rpo)) << 32) | k);
        rpo_was.push(bs[k]);
    }
    u.sort_usize(rpo_keys.items());
    for k in 0..bs.len {
        bs[k] = rpo_was.get(rpo_keys.get(k) & 0xffff_ffff);
    }
}

fn invariant(o: *ir.Value, tag: i64) bool {
    return u.isnil(o) or (o.kind != ir.V_INST) or u.isnil(o.blk) or (o.blk.mark != tag);
}

fn hoist_ok(i: *mut ir.Value, tag: i64, in_header: bool) bool {
    if (i.op == ir.OP_PHI) or ir.is_term(i.op) {
        return false;
    }
    if not invariant(i.a, tag) or not invariant(i.b, tag) or not invariant(i.c, tag) {
        return false;
    }
    for k in 0..i.xs.len {
        if not invariant(i.xs.get(k), tag) {
            return false;
        }
    }
    if i.op == ir.OP_LOAD {
        if (i.flags != 0) or (i.ty.kind == ir.T_VOID) {
            return false;
        }
        let sz = @bit_cast(i64, i.ty.size);
        let l = gvn.loc_of(i.a, sz);
        if not in_header and not deref_ok(&l, sz) {
            return false;
        }
        for w in 0..gvn.writes.len {
            if gvn.may_alias(&l, gvn.writes.at(w)) {
                return false;
            }
        }
        return true;
    }
    if i.op == ir.OP_CALL {
        // A call that promises to return and to write nothing (ir.call_fx),
        // of invariant arguments: before the loop, when it runs whenever
        // the loop is entered (in_header: in the header, before anything
        // that may stop; never one in a block some iterations skip, so the
        // call runs before the loop only where the program runs it at
        // least once), and, for one that reads memory (FX_READS), when the
        // loop writes nothing the callee may read (unseen_by: the loop's
        // writes are those of note_writes; a call that may write is W_CALL
        // there).
        let fx = ir.call_fx(i);
        if (fx == ir.FX_ANY) or not in_header or (i.ty.kind == ir.T_VOID) {
            return false;
        }
        if fx == ir.FX_READS {
            for w in 0..gvn.writes.len {
                if not gvn.unseen_by(gvn.writes.at(w), i) {
                    return false;
                }
            }
        }
        return true;
    }
    return gvn.licm_speculatable(i);
}

// -----------------------------------------------------------------------------
// Loop idioms: a loop that only stores a loop-invariant value to consecutive
// elements
//     H: i = phi [start, pre], [i + 1, B];  condbr (i <u end) -> B, exit
//     B: store v, base + i * size;  br H
// is one memset before it (v a byte, or a constant whose bytes are equal),
// when nothing after the loop uses its values.
// -----------------------------------------------------------------------------
fn same_bytes(v: *ir.Value) i64 {
    if v.ty.kind != ir.T_INT {
        if ir.is_zero(v) and (v.kind != ir.V_INST) {
            return 0;
        }
        return -1;
    }
    if not ir.is_cint(v) {
        return -1;
    }
    let x = ir.cint_val(v);
    let b = x & 0xff;
    let n = @truncate(u32, v.ty.size);
    for k in 1..n {
        if ((x >> (k * 8)) & 0xff) != b {
            return -1;
        }
    }
    return @bit_cast(i64, b);
}

// The element index of an address base + i * size (or base + i for bytes).
fn strided(p: *mut ir.Value, i: *mut ir.Value, size: u64) *mut ir.Value {
    if not ir.is_op(p, ir.OP_PTRADD) {
        return gvn.vnil();
    }
    let off = p.b;
    if (size == 1) and (off == i) {
        return p.a;
    }
    if ir.is_op(off, ir.OP_MUL) and (off.a == i) and ir.is_cint(off.b) and (ir.cint_val(off.b) == size) {
        return p.a;
    }
    if ir.is_op(off, ir.OP_SHL) and (off.a == i) and ir.is_cint(off.b) and (ir.cint_val(off.b) < 8) and
       ((@as(u64, 1) << @truncate(u32, ir.cint_val(off.b))) == size) {
        return p.a;
    }
    return gvn.vnil();
}

fn used_outside(f: *mut ir.Func, tag: i64) bool {
    let mut b = f.first;
    while u.notnil(b) {
        if b.mark != tag {
            let mut i = b.first;
            while u.notnil(i) {
                let ops: [3]*mut ir.Value = [i.a, i.b, i.c];
                for o in ops {
                    if u.notnil(o) and (o.kind == ir.V_INST) and u.notnil(o.blk) and (o.blk.mark == tag) {
                        return true;
                    }
                }
                for k in 0..i.xs.len {
                    let o = i.xs.get(k);
                    if (o.kind == ir.V_INST) and u.notnil(o.blk) and (o.blk.mark == tag) {
                        return true;
                    }
                }
                i = i.next;
            }
        }
        b = b.next;
    }
    return false;
}

fn try_memset(f: *mut ir.Func, h: *mut ir.Block, tag: i64, members: *u.List.[*mut ir.Block]) bool {
    if members.len != 2 {
        return false;
    }
    let mut body = members.get(0);
    if body == h {
        body = members.get(1);
    }
    let ht = ir.terminator(h);
    let bt = ir.terminator(body);
    if u.isnil(ht) or u.isnil(bt) or (ht.op != ir.OP_CONDBR) or (bt.op != ir.OP_BR) or (bt.t1 != h) {
        return false;
    }
    // header: one phi and the test
    let i = h.first;
    if u.isnil(i) or (i.op != ir.OP_PHI) or (i.xs.len != 2) or u.isnil(i.next) or (i.next.op == ir.OP_PHI) {
        return false;
    }
    let c = ht.a;
    if not ir.is_op(c, ir.OP_ICMP) or (c.a != i) or (c.blk != h) or (c.next != ht) or (i.next != c) {
        return false;
    }
    let p = ir.pred_of(c);
    let mut exit = ht.t2;
    if (p == ir.IntULT) and (ht.t1 == body) {
        exit = ht.t2;
    } else if (p == ir.IntUGE) and (ht.t2 == body) {
        exit = ht.t1;
    } else {
        return false;
    }
    let end = c.b;
    if not invariant(end, tag) or (i.ty.kind != ir.T_INT) or (i.ty.bits > ir.isz().bits) {
        return false;
    }
    let mut pre = ir.bnil();
    let mut start = gvn.vnil();
    let mut next = gvn.vnil();
    for k in @as(usize, 0)..2 {
        if ir.bs_of(i).get(k) == body {
            next = i.xs.get(k);
        } else {
            pre = ir.bs_of(i).get(k);
            start = i.xs.get(k);
        }
    }
    if u.isnil(pre) or u.isnil(next) or not invariant(start, tag) or (ir.succ_count(ir.terminator(pre)) != 1) {
        return false;
    }
    // body: the store, the address and i + 1 only
    let mut st = gvn.vnil();
    let mut x = body.first;
    while u.notnil(x) and (x != bt) {
        if x.op == ir.OP_STORE {
            if u.notnil(st) {
                return false;
            }
            st = x;
        } else if not gvn.cse_able(x) {
            return false;
        }
        x = x.next;
    }
    if u.isnil(st) or (st.flags != 0) or not invariant(st.a, tag) {
        return false;
    }
    if not (ir.is_op(next, ir.OP_ADD) and (next.a == i) and cb.is_kv1(next.b)) {
        return false;
    }
    let size = st.a.ty.size;
    let mut byte = gvn.vnil();
    if (size == 1) and (st.a.ty.kind == ir.T_INT) and (st.a.ty.bits == 8) {
        byte = st.a;
    } else {
        let bv = same_bytes(st.a);
        if bv < 0 {
            return false;
        }
        byte = ir.cint(ir.t_int(8), @bit_cast(u64, bv));
    }
    let base = strided(st.b, i, size);
    if u.isnil(base) or not invariant(base, tag) {
        return false;
    }
    if used_outside(f, tag) or (u.notnil(exit.first) and (exit.first.op == ir.OP_PHI)) {
        return false;
    }
    // memset(base + start * size, byte, (start < end ? end - start : 0) * size)
    let bld = ir.new_builder();
    let pt = ir.terminator(pre);
    ir.at_before(bld, pt);
    let isz = ir.isz();
    let s = ir.cast(bld, ir.OP_ZEXT, start, isz);
    let e = ir.cast(bld, ir.OP_ZEXT, end, isz);
    let lt = ir.icmp(bld, ir.IntULT, s, e);
    let n = ir.select(bld, lt, ir.sub(bld, e, s), ir.cint(isz, 0));
    let bytes = ir.mul(bld, n, ir.cint(isz, size));
    let dst = ir.ptradd(bld, base, ir.mul(bld, s, ir.cint(isz, size)));
    _ = ir.memop(bld, ir.OP_MEMSET, dst, byte, bytes);
    pt.t1 = exit;
    return true;
}

// True if anything changed.
pub fn loop_idioms(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    opt.compute_preds(f);
    let order = opt.dominators(f);
    let hs = opt.loop_headers(&order);
    let mut members = u.List.[*mut ir.Block].empty();
    let mut any = false;
    for k in 0..hs.len {
        loop_mark += 1;
        opt.members_of(hs.get(k), loop_mark, &mut members);
        if try_memset(f, hs.get(k), loop_mark, &members) {
            any = true;
            break;  // the CFG changed: again later
        }
    }
    members.deinit();
    order.deinit();
    hs.deinit();
    if any {
        ir.remove_unreachable(f);
    }
    return any;
}

// -----------------------------------------------------------------------------
// Range splitting for bounds checks: a loop whose header leaves it when
// i >= end, and whose body checks i < L (L invariant, the failing side
// trapping), first runs as a copy that leaves when i >= min(end, L, ...), in
// which the checks always pass (value numbering removes them), then as
// itself from where the copy stopped: done at once when end <= L, else on to
// the failing check.
//     pre -> H' (the copy) ... H' -> mid -> H (the loop) ... H -> exit
// Every other way out of the loop must be to a block that traps and uses
// nothing computed in the loop. H runs the iteration H' left in again, so
// its instructions must have no effects.
// -----------------------------------------------------------------------------
const SPLIT_MAX: i32 = 160;  // instructions in a loop that is copied

fn trap_exit(x: *mut ir.Block, tag: i64) bool {
    let t = ir.terminator(x);
    if (x.mark == tag) or u.isnil(t) or (t.op != ir.OP_UNREACHABLE) {
        return false;
    }
    let mut i = x.first;
    while u.notnil(i) {
        if (i.op == ir.OP_PHI) or not invariant(i.a, tag) or not invariant(i.b, tag) or not invariant(i.c, tag) {
            return false;
        }
        for k in 0..i.xs.len {
            if not invariant(i.xs.get(k), tag) {
                return false;
            }
        }
        i = i.next;
    }
    return true;
}

// The invariant terms of the sum v of i and them, in split_terms; the
// number of times i is a term (-1: v is not such a sum).
threadlocal let mut split_terms: u.List.[*mut ir.Value] =
    u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0), len: 0, cap: 0 };

fn sum_terms(v0: *mut ir.Value, i: *mut ir.Value, tag: i64, depth: i32) i32 {
    let v = ir.resolve(v0);
    if v == i {
        return 1;
    }
    if invariant(v, tag) {
        split_terms.push(v);
        return 0;
    }
    if (depth > 4) or not ir.is_op(v, ir.OP_ADD) or (v.ty != i.ty) {
        return -1;
    }
    let a = sum_terms(v.a, i, tag, depth + 1);
    if a < 0 {
        return -1;
    }
    let b = sum_terms(v.b, i, tag, depth + 1);
    if b < 0 {
        return -1;
    }
    return a + b;
}

// The bound L of a check i < L ending block x (trapping otherwise), or nil;
// of a check i + d < L (d invariant: an index from a base, `a[base + i]`),
// L with *off set to d.
fn check_bound(x: *mut ir.Block, i: *mut ir.Value, tag: i64, off: *mut *mut ir.Value) *mut ir.Value {
    off.* = gvn.vnil();
    let t = ir.terminator(x);
    if u.isnil(t) or (t.op != ir.OP_CONDBR) {
        return gvn.vnil();
    }
    let c = t.a;
    if not ir.is_op(c, ir.OP_ICMP) {
        return gvn.vnil();
    }
    let ca = c.a;
    if ca != i {
        // a sum of i and invariant terms (copies of an unrolled body add 1, 2, ...)
        split_terms.clear();
        if not ir.is_op(ca, ir.OP_ADD) or (ca.ty != i.ty) or (sum_terms(ca, i, tag, 0) != 1) {
            return gvn.vnil();
        }
        off.* = ca;
    }
    let l = c.b;
    if (l.ty != i.ty) or not invariant(l, tag) {
        return gvn.vnil();
    }
    let p = ir.pred_of(c);
    if (p == ir.IntULT) and (t.t1.mark == tag) and trap_exit(t.t2, tag) {
        return l;
    }
    if (p == ir.IntUGE) and (t.t2.mark == tag) and trap_exit(t.t1, tag) {
        return l;
    }
    return gvn.vnil();
}

fn try_split(f: *mut ir.Func, h: *mut ir.Block, tag: i64, members: *u.List.[*mut ir.Block]) bool {
    let ht = ir.terminator(h);
    if h.split or u.isnil(ht) or (ht.op != ir.OP_CONDBR) {
        return false;
    }
    for k in 0..members.len {
        if not ir.can_copy_block(members.get(k)) {
            return false;  // (inline assembly that defines symbols: not copied)
        }
    }
    // the header's test: i < end
    let c = ht.a;
    if not ir.is_op(c, ir.OP_ICMP) {
        return false;
    }
    let i = c.a;
    let end = c.b;
    if not ir.is_op(i, ir.OP_PHI) or (i.blk != h) or (i.ty.kind != ir.T_INT) or (i.ty.bits > 64) or (end.ty != i.ty) or
       not invariant(end, tag) {
        return false;
    }
    let p = ir.pred_of(c);
    let mut exit = ir.bnil();
    if (p == ir.IntULT) and (ht.t1.mark == tag) and (ht.t2.mark != tag) {
        exit = ht.t2;
    } else if (p == ir.IntUGE) and (ht.t2.mark == tag) and (ht.t1.mark != tag) {
        exit = ht.t1;
    } else {
        return false;
    }
    // the checks, the other exits, the size
    let mut bounds = u.List.[*mut ir.Value].empty();
    let mut offs = u.List.[*mut ir.Value].empty();
    let mut checked = u.List.[*mut ir.Block].empty();  // blocks of i + d < L checks
    let mut n: i32 = 0;
    let mut ok = true;
    for k in 0..members.len {
        let x = members.get(k);
        let mut v = x.first;
        while u.notnil(v) {
            n += 1;
            if v.op == ir.OP_ALLOCA {
                ok = false;
            }
            if (x == h) and (v.op != ir.OP_PHI) and not ir.is_term(v.op) and (ir.has_effects(v) or gvn.may_stop(v)) {
                ok = false;
            }
            v = v.next;
        }
        let t = ir.terminator(x);
        for j in 0..ir.succ_count(t) {
            let s = ir.succ(t, j);
            if (s.mark != tag) and not ((x == h) and (s == exit)) and not trap_exit(s, tag) {
                ok = false;
            }
        }
        if x != h {
            let mut d = gvn.vnil();
            let l = check_bound(x, i, tag, &mut d);
            if u.notnil(l) {
                let mut seen = false;
                for j in 0..bounds.len {
                    if (bounds.get(j) == l) and (offs.get(j) == d) {
                        seen = true;
                    }
                }
                if not seen {
                    bounds.push(l);
                    offs.push(d);
                }
                if u.notnil(d) {
                    checked.push(x);
                }
            }
        }
    }
    if not ok or (n > SPLIT_MAX) or (bounds.len == 0) {
        bounds.deinit();
        offs.deinit();
        checked.deinit();
        return false;
    }
    _ = make_preheader(f, h, tag);
    let mut pre = ir.bnil();
    for k in 0..h.preds.len {
        if h.preds.get(k).mark != tag {
            pre = h.preds.get(k);
        }
    }
    // m = min(end, L...) before the loop
    let bld = ir.new_builder();
    let pt = ir.terminator(pre);
    ir.at_before(bld, pt);
    let mut m = end;
    for k in 0..bounds.len {
        let mut l = bounds.get(k);
        let x = offs.get(k);
        if u.notnil(x) {
            // x = i + d (the sum of d's terms) < L holds for i < L - d
            // (none when d > L)
            split_terms.clear();
            _ = sum_terms(x, i, tag, 0);
            let mut d = split_terms.get(0);
            for j in 1..split_terms.len {
                d = ir.binop(bld, ir.OP_ADD, d, split_terms.get(j));
            }
            l = ir.select(bld, ir.icmp(bld, ir.IntULE, d, l), ir.binop(bld, ir.OP_SUB, l, d), ir.cint(l.ty, 0));
        }
        m = ir.select(bld, ir.icmp(bld, ir.IntULT, m, l), m, l);
    }
    bounds.deinit();
    offs.deinit();
    // the copy
    opt.clone_members(f, members, tag);
    // (its checks of i + d < L pass: they go straight on)
    for k in 0..checked.len {
        let ct = ir.terminator(@ptr_cast(*mut ir.Block, checked.get(k).auxp));
        if ir.pred_of(ct.a) == ir.IntULT {
            ct.t2 = ir.bnil();
        } else {
            ct.t1 = ct.t2;
            ct.t2 = ir.bnil();
        }
        ct.op = ir.OP_BR;
        ir.set_a(ct, gvn.vnil());
    }
    checked.deinit();
    // the copy leaves at i >= m for mid, which enters the loop
    let h2 = @ptr_cast(*mut ir.Block, h.auxp);
    let ht2 = ir.terminator(h2);
    let mid = ir.edge_block(f, "split", pre, h);
    ir.at_before(bld, ht2);
    ir.set_a(ht2, ir.icmp(bld, p, @ptr_cast(*mut ir.Value, i.auxp), m));
    if ht2.t1 == exit {
        ht2.t1 = mid;
    } else {
        ht2.t2 = mid;
    }
    let mut q = h.first;
    while u.notnil(q) and (q.op == ir.OP_PHI) {
        for k in 0..ir.bs_of(q).len {
            if ir.bs_of(q).get(k) == mid {
                ir.set_x(q, k, @ptr_cast(*mut ir.Value, q.auxp));
            }
        }
        q = q.next;
    }
    ir.retarget(pre, h, h2);
    h.split = true;
    h2.split = true;
    return true;
}

// True if anything changed. Once per function: after inlining.
pub fn split_loops(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    let mut any = false;
    let mut rounds: i32 = 0;
    while rounds < 8 {
        rounds += 1;
        opt.compute_preds(f);
        let order = opt.dominators(f);
        let hs = opt.loop_headers(&order);
        let mut members = u.List.[*mut ir.Block].empty();
        let mut did = false;
        for k in 0..hs.len {
            loop_mark += 1;
            opt.members_of(hs.get(k), loop_mark, &mut members);
            if try_split(f, hs.get(k), loop_mark, &members) {
                did = true;
                break;  // the CFG changed
            }
        }
        members.deinit();
        order.deinit();
        hs.deinit();
        if not did {
            break;
        }
        any = true;
    }
    return any;
}

// -----------------------------------------------------------------------------
// Code sinking: an instruction computed only for some paths moves down to
// the nearest block dominating all its uses (not into a deeper loop), so
// the other paths skip it: the shadow stack's slot for the calls of a slow
// path, values only a trap reports. A load moves into a successor reached
// only from its block when nothing after it there writes memory. Where every
// path from the block reaches the target anyway (moving saves nothing), an
// instruction moves only when its operands are live there regardless: else
// they, not its result, would be live on the way (across a call, or through
// a chain of sums each sunk to the next one's use, all their terms live to
// the end of the function).
// -----------------------------------------------------------------------------
fn lca(a0: *mut ir.Block, b0: *mut ir.Block) *mut ir.Block {
    if u.isnil(a0) {
        return b0;
    }
    let mut a = a0;
    let mut b = b0;
    if (a.dom_run == b.dom_run) and (a.dom_run != 0) {
        // (most uses are below one another: no walk up the tree)
        if opt.dominates(b, a) {
            return b;
        }
        while not opt.dominates(a, b) {
            a = a.idom;
        }
        return a;
    }
    while a.depth > b.depth {
        a = a.idom;
    }
    while b.depth > a.depth {
        b = b.idom;
    }
    while a != b {
        a = a.idom;
        b = b.idom;
    }
    return a;
}

fn writes_mem(x: *ir.Value) bool {
    let op = x.op;
    return ir.op_writes_mem(op) or ((op == ir.OP_INTR) and ir.inst_writes_mem(x)) or
           ((op == ir.OP_LOAD) and (x.flags != 0));
}

// The blocks using v: their common dominator (nil: no uses).
fn use_block(users: *u.List.[*mut ir.Value], v: *mut ir.Value) *mut ir.Block {
    let mut l = ir.bnil();
    for k in 0..users.len {
        let x = users.get(k);
        if x.op == ir.OP_PHI {
            for j in 0..x.xs.len {
                if (x.xs.get(j) == v) and (ir.bs_of(x).get(j).rpo >= 0) {
                    l = lca(l, ir.bs_of(x).get(j));
                }
            }
        } else {
            l = lca(l, x.blk);
        }
    }
    return l;
}

// A memset of a stack slot that nothing else in its block uses moves down
// to where the slot's users are: to the start of the block that dominates
// them, and where that block branches with users on each way, to each way's
// start (into a block entered only from it), so that paths that never use
// the slot do not fill it (a zeroed scratch buffer only fallback paths
// read). Never into a loop it is outside: there it would fill the slot
// again each time round.
fn sink_fills(f: *mut ir.Func, uses: *u.List.[u.List.[*mut ir.Value]]) bool {
    if u.isnil(gvn.B) {
        gvn.B = ir.new_builder();
    }
    let mut any = false;
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            if (i.op == ir.OP_MEMSET) and (i.flags == 0) and (b.rpo >= 0) and (i.aux >= 0) and
               ir.is_op(i.a, ir.OP_ALLOCA) and (i.a.aux >= 0) {
                let mut users = u.List.[*mut ir.Value].empty();
                let mut ok = true;
                let us = uses.at(@int_cast(usize, i.a.aux));
                for k in 0..us.len {
                    let x = us.get(k);
                    if u.isnil(x.blk) {
                        ok = false;  // (moved by this pass)
                    } else if x != i {
                        if (x.op == ir.OP_PHI) or (x.blk == b) or (x.blk.rpo < 0) {
                            ok = false;
                        }
                        users.push(x);
                    }
                }
                let mut to = u.List.[*mut ir.Block].empty();
                if ok and (users.len > 0) and fill_places(b, users.items(), &mut to, 0) and
                   not ((to.len == 1) and (to.get(0) == b)) {
                    for k in 0..to.len {
                        let mut at = to.get(k).first;
                        while at.op == ir.OP_PHI {
                            at = at.next;
                        }
                        ir.at_before(gvn.B, at);
                        let c = ir.memop(gvn.B, ir.OP_MEMSET, i.a, i.b, i.c);
                        c.src = i.src;
                        c.scope = i.scope;
                        c.aux = -1;  // (new: not looked at again)
                    }
                    ir.remove_inst(i);
                    any = true;
                }
                users.deinit();
                to.deinit();
            }
            i = next;
        }
        b = b.next;
    }
    return any;
}

// The blocks below r (or r) whose starts can fill a slot for users (all
// dominated by r) instead of r: into `to`; false if there are too many.
fn fill_places(r: *mut ir.Block, users: []*mut ir.Value, to: *mut u.List.[*mut ir.Block], depth: i32) bool {
    let mut l = ir.bnil();
    for x in users {
        l = lca(l, x.blk);
    }
    if u.isnil(l) or not opt.dominates(r, l) {
        return false;
    }
    // not into a loop r is outside: above the loop header nearest r
    let mut t = l;
    let mut c = l;
    while c != r {
        if opt.is_loop_header(c) {
            t = c.idom;
        }
        c = c.idom;
    }
    // where t branches, each way with users entered only from t
    let mut here = false;
    for x in users {
        if x.blk == t {
            here = true;
        }
    }
    let term = ir.terminator(t);
    if not here and (depth < 4) and u.notnil(term) and (ir.succ_count(term) >= 2) {
        let mut split = true;
        let mut parts = u.List.[*mut ir.Value].empty();
        let mut covered: usize = 0;
        for k in 0..ir.succ_count(term) {
            let s = ir.succ(term, k);
            let mut n: usize = 0;
            for x in users {
                if opt.dominates(s, x.blk) {
                    n += 1;
                }
            }
            if (n > 0) and ((s.preds.len != 1) or (s == t)) {
                split = false;
            }
            covered += n;
        }
        if split and (covered == users.len) {
            for k in 0..ir.succ_count(term) {
                let s = ir.succ(term, k);
                parts.clear();
                for x in users {
                    if opt.dominates(s, x.blk) {
                        parts.push(x);
                    }
                }
                if (parts.len > 0) and not fill_places(s, parts.items(), to, depth + 1) {
                    parts.deinit();
                    return false;
                }
            }
            parts.deinit();
            return to.len <= 4;
        }
        parts.deinit();
    }
    to.push(t);
    return to.len <= 4;
}

fn note_use(uses: *mut u.List.[u.List.[*mut ir.Value]], o: *mut ir.Value, x: *mut ir.Value) void {
    if u.notnil(o) and (o.kind == ir.V_INST) and (o.aux >= 0) {
        uses.at(@int_cast(usize, o.aux)).push(x);
    }
}

// Is there a path from blk that skips t: back to blk, or to a return (not
// to a trap), without passing t? If not, moving an instruction from blk to
// t saves nothing.
fn skips(blk: *mut ir.Block, t: *mut ir.Block, seen: []mut bool) bool {
    for k in 0..seen.len {
        seen[k] = false;
    }
    let mut work = u.List.[*mut ir.Block].empty();
    let bt = ir.terminator(blk);
    for k in 0..ir.succ_count(bt) {
        work.push(ir.succ(bt, k));
    }
    let mut found = false;
    while (work.len > 0) and not found {
        let x = work.get(work.len - 1);
        work.len -= 1;
        if (x == t) or (x.rpo < 0) or seen[@int_cast(usize, x.rpo)] {
            continue;
        }
        seen[@int_cast(usize, x.rpo)] = true;
        if x == blk {
            found = true;
            break;
        }
        let xt = ir.terminator(x);
        let n = ir.succ_count(xt);
        if n == 0 {
            found = u.notnil(xt) and (xt.op != ir.OP_UNREACHABLE);
            continue;  // (a trap does not count)
        }
        for k in 0..n {
            work.push(ir.succ(xt, k));
        }
    }
    work.deinit();
    return found;
}

// Is operand o of i used below t anyway (by something else in a block t
// dominates), so that it is live into t whether or not i moves there?
fn used_below(uses: *u.List.[u.List.[*mut ir.Value]], o: *mut ir.Value, i: *mut ir.Value, t: *mut ir.Block) bool {
    if u.isnil(o) or (o.kind != ir.V_INST) {
        return true;  // (a constant, parameter or global)
    }
    if o.aux < 0 {
        return false;
    }
    let us = uses.at(@int_cast(usize, o.aux));
    for k in 0..us.len {
        let x = us.get(k);
        if x == i {
            continue;
        }
        if x.op == ir.OP_PHI {
            for j in 0..x.xs.len {
                if (x.xs.get(j) == o) and (ir.bs_of(x).get(j).rpo >= 0) and opt.dominates(t, ir.bs_of(x).get(j)) {
                    return true;
                }
            }
        } else if (x.blk.rpo >= 0) and opt.dominates(t, x.blk) {
            return true;
        }
    }
    return false;
}

fn operands_live_at(uses: *u.List.[u.List.[*mut ir.Value]], i: *mut ir.Value, t: *mut ir.Block) bool {
    if not used_below(uses, i.a, i, t) or not used_below(uses, i.b, i, t) or not used_below(uses, i.c, i, t) {
        return false;
    }
    for k in 0..i.xs.len {
        if not used_below(uses, i.xs.get(k), i, t) {
            return false;
        }
    }
    return true;
}

fn sink_uses(f: *mut ir.Func, order: *u.List.[*mut ir.Block]) u.List.[u.List.[*mut ir.Value]] {
    let mut uses = u.List.[u.List.[*mut ir.Value]].empty();
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.aux = -1;
            if b.rpo >= 0 {
                i.aux = @int_cast(i64, uses.len);
                uses.push(u.List.[*mut ir.Value].empty());
            }
            i = i.next;
        }
        b = b.next;
    }
    for bi in 0..order.len {
        let mut i = order.get(bi).first;
        while u.notnil(i) {
            note_use(&mut uses, i.a, i);
            note_use(&mut uses, i.b, i);
            note_use(&mut uses, i.c, i);
            for k in 0..i.xs.len {
                note_use(&mut uses, i.xs.get(k), i);
            }
            i = i.next;
        }
    }
    return uses;
}

pub fn sink(f: *mut ir.Func) bool {
    if u.isnil(f.first) {
        return false;
    }
    opt.compute_preds(f);
    let order = opt.dominators(f);
    opt.loop_depths(f, &order);
    // users of each instruction (reachable ones): again when sink_fills
    // moved memsets (the lists hold the ones it took out)
    let mut uses = sink_uses(f, &order);
    let mut any = sink_fills(f, &uses);
    if any {
        for k in 0..uses.len {
            u.free(@ptr_cast(*mut void, uses.at(k).data));
        }
        uses.deinit();
        uses = sink_uses(f, &order);
    }
    // bottom-up: users move before what they use is considered
    let seen = u.newn.[bool](order.len + 1);
    let mut last_from = ir.bnil();
    let mut last_to = ir.bnil();
    let mut last_skips = false;
    let mut bi = order.len;
    while bi > 0 {
        bi -= 1;
        let blk = order.get(bi);
        let mut i = blk.last;
        while u.notnil(i) {
            let prev = i.prev;
            let is_load = (i.op == ir.OP_LOAD) and (i.flags == 0);
            if (i.op != ir.OP_PHI) and (gvn.cse_able(i) or is_load) {
                let l = use_block(uses.at(@int_cast(usize, i.aux)), i);
                if u.notnil(l) and (l != blk) and (l.rpo >= 0) and opt.dominates(blk, l) {
                    // the deepest block on the way down not in a deeper loop
                    let mut t = l;
                    while (t != blk) and (t.loop_depth > blk.loop_depth) {
                        t = t.idom;
                    }
                    // not past an inner loop (its operands would live across it)
                    let mut up = t;
                    while up != blk {
                        if up.loop_depth > blk.loop_depth {
                            t = blk;
                            break;
                        }
                        up = up.idom;
                    }
                    if is_load and (t != blk) {
                        // only into a successor reached from here alone, and
                        // nothing after the load here writes memory
                        while (t != blk) and (t.idom != blk) {
                            t = t.idom;
                        }
                        let mut quiet = (t.preds.len == 1);
                        let mut x = i.next;
                        while quiet and u.notnil(x) {
                            if writes_mem(x) {
                                quiet = false;
                            }
                            x = x.next;
                        }
                        if not quiet {
                            t = blk;
                        }
                    }
                    if t != blk {
                        if (t != last_to) or (blk != last_from) {
                            last_from = blk;
                            last_to = t;
                            last_skips = skips(blk, t, seen[0..order.len]);
                        }
                        if not last_skips and not operands_live_at(&uses, i, t) {
                            t = blk;  // (its operands would live on the way instead of it)
                        }
                    }
                    if t != blk {
                        let mut at = t.first;
                        while at.op == ir.OP_PHI {
                            at = at.next;
                        }
                        ir.remove_inst(i);
                        ir.insert_before(at, i);
                        any = true;
                    }
                }
            }
            i = prev;
        }
    }
    for k in 0..uses.len {
        u.free(@ptr_cast(*mut void, uses.at(k).data));
    }
    uses.deinit();
    order.deinit();
    return any;
}

// -----------------------------------------------------------------------------
// Strength reduction of addresses: in a loop, an address base + off where
// base is invariant and off grows by a constant each iteration (an affine
// function of the loop's counters, as (i * 300 + k) * 8) becomes a pointer
// of its own, started before the loop and advanced at its latch. Worth it
// for wasm (no addressing modes) whenever off takes work; for native code
// when it takes a multiplication or more than one operation per access.
// Addresses a constant apart share the pointer.
// -----------------------------------------------------------------------------
struct IvPtr {
    base: *mut ir.Value,
    step: i64,
    off0: *mut ir.Value,
    q: *mut ir.Value,
}

threadlocal let mut ivps: u.List.[IvPtr] = u.List.[IvPtr].{ data: @ptr_from_int(*mut IvPtr, 0), len: 0, cap: 0 };

// The step of v per iteration of the loop at h (tag), when v is an affine
// function of its counters; `ops` counts the operations that vary.
fn iv_step(v0: *mut ir.Value, h: *mut ir.Block, tag: i64, ok: *mut bool, ops: *mut i32, mulk: *mut bool,
           depth: i32) i64 {
    let v = ir.resolve(v0);
    if invariant(v, tag) {
        return 0;
    }
    if (depth > 6) or (v.ty != ir.isz()) {
        ok.* = false;
        return 0;
    }
    if (v.op == ir.OP_PHI) and (v.blk == h) {
        // a counter: [init from outside, v + c from the latch]
        if v.xs.len != 2 {
            ok.* = false;
            return 0;
        }
        for k in @as(usize, 0)..2 {
            if ir.bs_of(v).get(k).mark == tag {
                let n = v.xs.get(k);
                if ir.is_op(n, ir.OP_ADD) and (n.a == v) and ir.is_cint(n.b) {
                    return @bit_cast(i64, ir.cint_val(n.b));
                }
            }
        }
        ok.* = false;
        return 0;
    }
    let op = v.op;
    if (op == ir.OP_ADD) or (op == ir.OP_SUB) {
        let a = iv_step(v.a, h, tag, ok, ops, mulk, depth + 1);
        let b = iv_step(v.b, h, tag, ok, ops, mulk, depth + 1);
        ops.* += 1;
        if op == ir.OP_ADD {
            return a +% b;
        }
        return a -% b;
    }
    if ((op == ir.OP_MUL) or (op == ir.OP_SHL)) and ir.is_cint(v.b) {
        let a = iv_step(v.a, h, tag, ok, ops, mulk, depth + 1);
        let k = @bit_cast(i64, ir.cint_val(v.b));
        ops.* += 1;
        if op == ir.OP_SHL {
            if (k < 0) or (k > 3) {
                mulk.* = true;
            }
            return a << @truncate(u32, @bit_cast(u64, k) & 63);
        }
        if (k != 1) and (k != 2) and (k != 4) and (k != 8) {
            mulk.* = true;
        }
        return a *% k;
    }
    ok.* = false;
    return 0;
}

// v's value in the loop's first iteration, built before it.
fn iv_start(bld: *mut ir.Builder, v0: *mut ir.Value, h: *mut ir.Block, tag: i64, pre: *mut ir.Block) *mut ir.Value {
    let v = ir.resolve(v0);
    if invariant(v, tag) {
        return v;
    }
    if (v.op == ir.OP_PHI) and (v.blk == h) {
        for k in 0..ir.bs_of(v).len {
            if ir.bs_of(v).get(k) == pre {
                return v.xs.get(k);
            }
        }
    }
    let a = iv_start(bld, v.a, h, tag, pre);
    let b = iv_start(bld, v.b, h, tag, pre);
    if v.op == ir.OP_ADD {
        return ir.add(bld, a, b);
    }
    if v.op == ir.OP_SUB {
        return ir.sub(bld, a, b);
    }
    if v.op == ir.OP_MUL {
        return ir.mul(bld, a, b);
    }
    return ir.binop(bld, ir.OP_SHL, a, b);
}

// Is base + off0 a constant (d) from base1 + off1? Both as a root pointer
// plus a linear combination of values plus a constant (lin_add): the same
// root and the same combination.
fn start_diff(base: *mut ir.Value, off0: *mut ir.Value, base1: *mut ir.Value, off1: *mut ir.Value, d: *mut i64) bool {
    let mut x = Lin.{ terms: u.List.[*mut ir.Value].empty(), coefs: u.List.[i64].empty(), k: 0, ok: true };
    let mut y = Lin.{ terms: u.List.[*mut ir.Value].empty(), coefs: u.List.[i64].empty(), k: 0, ok: true };
    let r = lin_ptr(base, &mut x);
    let r1 = lin_ptr(base1, &mut y);
    lin_add(off0, 1, &mut x, 0);
    lin_add(off1, 1, &mut y, 0);
    let mut same = x.ok and y.ok and (r == r1);
    if same {
        // the same coefficient for each term (y's terms negated into x's)
        for k in 0..y.terms.len {
            lin_term(&mut x, y.terms.get(k), 0 -% y.coefs.get(k));
        }
        for k in 0..x.coefs.len {
            if x.coefs.get(k) != 0 {
                same = false;
            }
        }
    }
    d.* = x.k -% y.k;
    x.terms.deinit();
    x.coefs.deinit();
    y.terms.deinit();
    y.coefs.deinit();
    return same;
}

// A linear combination: the sum of terms[i] * coefs[i], plus k.
struct Lin {
    terms: u.List.[*mut ir.Value],
    coefs: u.List.[i64],
    k: i64,
    ok: bool,
}

fn lin_term(l: *mut Lin, v: *mut ir.Value, c: i64) void {
    for i in 0..l.terms.len {
        if l.terms.get(i) == v {
            l.coefs.set(i, l.coefs.get(i) +% c);
            return;
        }
    }
    l.terms.push(v);
    l.coefs.push(c);
}

// Adds integer v * s to l.
fn lin_add(v0: *mut ir.Value, s: i64, l: *mut Lin, depth: i32) void {
    let v = ir.resolve(v0);
    if ir.is_cint(v) {
        l.k = l.k +% (ir.sval(v) *% s);
        return;
    }
    if depth > 8 {
        l.ok = false;
        return;
    }
    if ir.is_op(v, ir.OP_ADD) {
        lin_add(v.a, s, l, depth + 1);
        lin_add(v.b, s, l, depth + 1);
        return;
    }
    if ir.is_op(v, ir.OP_SUB) {
        lin_add(v.a, s, l, depth + 1);
        lin_add(v.b, 0 -% s, l, depth + 1);
        return;
    }
    if ir.is_op(v, ir.OP_MUL) and ir.is_cint(v.b) {
        lin_add(v.a, s *% ir.sval(v.b), l, depth + 1);
        return;
    }
    if ir.is_op(v, ir.OP_SHL) and ir.is_cint(v.b) and (ir.sval(v.b) >= 0) and (ir.sval(v.b) < 63) {
        lin_add(v.a, s *% (@as(i64, 1) << @truncate(u32, @bit_cast(u64, ir.sval(v.b)))), l, depth + 1);
        return;
    }
    lin_term(l, v, s);
}

// The root of pointer p through ptradds, their offsets added to l.
fn lin_ptr(p0: *mut ir.Value, l: *mut Lin) *mut ir.Value {
    let mut p = ir.resolve(p0);
    let mut n: i32 = 0;
    while ir.is_op(p, ir.OP_PTRADD) and (n < 8) {
        lin_add(p.b, 1, l, 0);
        p = p.a;
        n += 1;
    }
    return p;
}

fn try_reduce(f: *mut ir.Func, h: *mut ir.Block, tag: i64, members: *u.List.[*mut ir.Block], no_modes: bool) bool {
    // one latch
    let mut latch = ir.bnil();
    for k in 0..h.preds.len {
        let p = h.preds.get(k);
        if p.mark == tag {
            if u.notnil(latch) {
                return false;
            }
            latch = p;
        }
    }
    if u.isnil(latch) or (ir.terminator(latch).op != ir.OP_BR) {
        return false;
    }
    let mut pre = ir.bnil();
    ivps.clear();
    let mut any = false;
    for mi in 0..members.len {
        let x = members.get(mi);
        let mut p = x.first;
        while u.notnil(p) {
            let next = p.next;
            if (p.op == ir.OP_PTRADD) and invariant(p.a, tag) and not invariant(p.b, tag) {
                let mut ok = true;
                let mut ops: i32 = 0;
                let mut mulk = false;
                let st = iv_step(p.b, h, tag, &mut ok, &mut ops, &mut mulk, 0);
                let worth = (no_modes and (ops >= 1)) or mulk or (ops >= 2);
                if ok and (st != 0) and worth {
                    if u.isnil(pre) {
                        _ = make_preheader(f, h, tag);
                        for k in 0..h.preds.len {
                            if h.preds.get(k).mark != tag {
                                pre = h.preds.get(k);
                            }
                        }
                    }
                    let bld = ir.new_builder();
                    ir.at_before(bld, ir.terminator(pre));
                    let base = p.a;
                    let off0 = iv_start(bld, p.b, h, tag, pre);
                    // a pointer already made for this step that starts a
                    // constant away?
                    let mut q = gvn.vnil();
                    let mut d: i64 = 0;
                    for k in 0..ivps.len {
                        let e = ivps.at(k);
                        if u.isnil(q) and (e.step == st) {
                            if (e.base == base) and (e.off0 == off0) {
                                q = e.q;
                            } else if (e.base == base) and ir.is_cint(e.off0) and ir.is_cint(off0) {
                                q = e.q;
                                d = @bit_cast(i64, ir.cint_val(off0)) -% @bit_cast(i64, ir.cint_val(e.off0));
                            } else if not no_modes {
                                // (wasm's offsets cannot be negative)
                                let mut dd: i64 = 0;
                                if start_diff(base, off0, e.base, e.off0, &mut dd) {
                                    q = e.q;
                                    d = dd;
                                }
                            }
                        }
                    }
                    if u.isnil(q) {
                        let start = ir.ptradd(bld, base, off0);
                        ir.at_before(bld, h.first);
                        q = ir.phi(bld, ir.t_ptr());
                        ir.add_incoming(q, start, pre);
                        ir.at_before(bld, ir.terminator(latch));
                        let qn = ir.ptradd(bld, q, ir.cint(ir.isz(), @bit_cast(u64, st)));
                        ir.add_incoming(q, qn, latch);
                        ivps.push(IvPtr.{ base: base, step: st, off0: off0, q: q });
                    }
                    if d != 0 {
                        ir.at_before(bld, p);
                        ir.forward(p, ir.ptradd(bld, q, ir.cint(ir.isz(), @bit_cast(u64, d))));
                    } else {
                        ir.forward(p, q);
                    }
                    ir.remove_inst(p);
                    any = true;
                }
            }
            p = next;
        }
    }
    return any;
}

// True if anything changed.
pub fn reduce_addresses(f: *mut ir.Func, no_modes: bool) bool {
    if u.isnil(f.first) {
        return false;
    }
    let mut any = false;
    opt.compute_preds(f);
    let order = opt.dominators(f);
    let hs = opt.loop_headers(&order);
    let mut members = u.List.[*mut ir.Block].empty();
    // inner loops first (their pointers' starts are then reduced in the outer ones)
    let mut k = hs.len;
    while k > 0 {
        k -= 1;
        loop_mark += 1;
        opt.members_of(hs.get(k), loop_mark, &mut members);
        if try_reduce(f, hs.get(k), loop_mark, &members, no_modes) {
            any = true;
            opt.compute_preds(f);  // (a preheader may be new)
        }
    }
    members.deinit();
    order.deinit();
    hs.deinit();
    return any;
}

// -----------------------------------------------------------------------------
// A module compiled in parts (backend.ax: compile_parts): the thread of each
// part starts from what this module holds when the parts begin.
// -----------------------------------------------------------------------------
pub struct PartState {
    loop_mark: i64,
    promoted: bool,
}

pub fn part_state() PartState {
    return PartState.{ loop_mark: loop_mark, promoted: promoted };
}

pub fn part_begin(s: *PartState) void {
    loop_mark = s.loop_mark;
    promoted = s.promoted;
}
