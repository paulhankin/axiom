// =============================================================================
// pdb.ax - writes a program database (PDB) for an executable plink.ax links:
// the debug information Windows debuggers and the system's own symbol
// handler (dbghelp) read. The executable names it in a CodeView debug
// directory entry (plink.ax), by path, GUID and age.
//
// What it holds: a module per object, with its functions as procedures (and
// at -g their frames, lexical blocks, variables and their locations, the
// object's static data and user-defined types: the CodeView symbols
// codeview.ax made, which plink.ax relocated) and their line tables
// (DEBUG_S_LINES, files in DEBUG_S_FILECHKSMS through the /names string
// table); the types and ids every object described, merged (TPI and IPI,
// with their hash streams); every function as a public symbol; the global
// symbols (procedure references, data, user-defined types) and their hash;
// the image's section headers and section map.
//
// The container is an MSF ("multi-stream file") of 4 KiB blocks: block 0 the
// superblock, blocks 1 and 2 (and every 4096th after them) the free block
// maps, the rest streams' data, a stream directory listing each stream's
// size and blocks, and a block listing the directory's blocks. Streams:
//    0 the old directory (empty)       6 TPI's hash values
//    1 PDB info (GUID, age, names)     7 IPI's hash values
//    2 TPI (types)                     8 publics (hash and address map)
//    3 DBI (modules, sections)         9 globals (hash)
//    4 IPI (ids)                      10 symbol records (publics, globals)
//    5 /names (the string table)      11 the section headers
//                                     12.. each module's symbols and lines
// Formats as Microsoft publishes them (the PDB and CodeView formats: the
// MSF container, the streams' headers, cvinfo.h's records).
// =============================================================================
import "bin.ax" as bn;
import "util.ax" as u;

const BS: u64 = 4096;

/// A line table row: from `off` (bytes into the function) on, the code is
/// `line` of file `file` (an index into the files given to write).
pub struct Line {
    off: u32,
    line: u32,
    file: u32,
}

pub struct Func {
    name: []u8,
    sec: u32,  // 1-based section number
    off: u32,  // offset in the section
    size: u32,
    lines: []Line,
    syms: []u8,       // its symbols (codeview.ax's, relocated), or none: a procedure record is made
    self_fix: []u32,  // where syms holds offsets in itself (to become offsets in the module's stream)
    module: u32,      // its module (an index in write's mods)
    external: bool,
}

/// A module (an object): its name and its symbols at the top level.
pub struct Mod {
    name: []u8,
    syms: []u8,
}

// -----------------------------------------------------------------------------
// Hashes and strings
// -----------------------------------------------------------------------------
// The hash of names in the string table and the symbol hash tables
// (Microsoft's LHashPbCb, "hashStringV1").
fn hash_v1(s: []u8) u32 {
    let mut r: u32 = 0;
    let n = s.len / 4;
    for i in 0..n {
        r = r ^ (
            ((@as(u32, s[i * 4]) | (@as(u32, s[(i * 4) + 1]) << 8)) | (@as(u32, s[(i * 4) + 2]) << 16)) | (
                @as(u32, s[(i * 4) + 3]) << 24));
    }
    let mut at = n * 4;
    let mut rem = s.len % 4;
    if rem >= 2 {
        r = r ^ (@as(u32, s[at]) | (@as(u32, s[at + 1]) << 8));
        at += 2;
        rem -= 2;
    }
    if rem == 1 {
        r = r ^ @as(u32, s[at]);
    }
    r = r | 0x2020_2020;
    r = r ^ (r >> 11);
    return r ^ (r >> 16);
}

fn lower(c: u8) u8 {
    if (c >= 'A') and (c <= 'Z') {
        return c + 32;
    }
    return c;
}

// The order of names in a hash bucket: shorter first, then without case.
fn gsi_cmp(a: []u8, b: []u8) i32 {
    if a.len != b.len {
        if a.len < b.len {
            return -1;
        }
        return 1;
    }
    for i in 0..a.len {
        let x = lower(a[i]);
        let y = lower(b[i]);
        if x != y {
            if x < y {
                return -1;
            }
            return 1;
        }
    }
    return 0;
}

fn cstr(b: *mut bn.Bytes, s: []u8) void {
    b.put(s);
    b.u8_(0);
}

// A symbol record: its length (after the length field), kind, fields;
// padded to 4 bytes with LF_PAD bytes as the format expects.
fn rec_begin(b: *mut bn.Bytes, kind: u64) usize {
    let at = b.len();
    b.u16_(0);
    b.u16_(kind);
    return at;
}

fn rec_end(b: *mut bn.Bytes, at: usize) void {
    let mut pad: u8 = 0xf0 + @truncate(u8, (4 - (b.len() % 4)) % 4);
    while (b.len() % 4) != 0 {
        b.u8_(pad);
        pad -= 1;
    }
    let n = @as(u64, b.len() - at - 2);
    b.view()[at] = @truncate(u8, n);
    b.view()[at + 1] = @truncate(u8, n >> 8);
}

// -----------------------------------------------------------------------------
// The string table (/names): file names for the line tables
// -----------------------------------------------------------------------------
struct Names {
    buf: bn.Bytes,
    offs: u.List.[u32],
}

fn names_new() Names {
    let mut n = Names.{ buf: bn.new_bytes(), offs: u.List.[u32].empty() };
    n.buf.u8_(0);  // offset 0: the empty string
    return n;
}

fn names_add(n: *mut Names, s: []u8) u32 {
    let at = @truncate(u32, n.buf.len());
    cstr(&mut n.buf, s);
    n.offs.push(at);
    return at;
}

fn names_stream(n: *mut Names) bn.Bytes {
    let mut b = bn.new_bytes();
    b.u32_(0xeffe_effe);
    b.u32_(1);  // hash version
    b.u32_(@as(u64, n.buf.len()));
    b.put(n.buf.view());
    // buckets: the strings' offsets, by hash, with linear probing
    let count = n.offs.len;
    let nb = (count * 2) + 1;
    let buckets = u.newn.[u32](nb);
    for o in n.offs.items() {
        let v = n.buf.view();
        let mut e = @as(usize, o);
        while v[e] != 0 {
            e += 1;
        }
        let mut k = @as(usize, hash_v1(v[@as(usize, o)..e])) % nb;
        while buckets[k] != 0 {
            k = (k + 1) % nb;
        }
        buckets[k] = o;
    }
    b.u32_(@as(u64, nb));
    for k in 0..nb {
        b.u32_(@as(u64, buckets[k]));
    }
    b.u32_(@as(u64, count));
    return b;
}

// -----------------------------------------------------------------------------
// Symbol hash tables (publics, globals)
// -----------------------------------------------------------------------------
const IPHR_HASH: u32 = 4096;

struct HashEntry {
    name: []u8,
    off: u32,  // the record's offset in the symbol record stream
    bucket: u32,
}

// The order of the hash records: by bucket, then name, then offset.
fn hash_cmp(a: HashEntry, b: HashEntry) i32 {
    if a.bucket != b.bucket {
        if a.bucket < b.bucket {
            return -1;
        }
        return 1;
    }
    let c = gsi_cmp(a.name, b.name);
    if c != 0 {
        return c;
    }
    if a.off < b.off {
        return -1;
    }
    if a.off > b.off {
        return 1;
    }
    return 0;
}

// The GSI hash: a header, a record per symbol (its offset + 1, a reference
// count), a bitmap of the buckets in use, and where each such bucket's
// records start (times 12, the size of the reader's in-memory record).
fn gsi_hash(es: []mut HashEntry) bn.Bytes {
    for k in 0..es.len {
        es[k].bucket = hash_v1(es[k].name) % IPHR_HASH;
    }
    u.sort.[HashEntry](es, hash_cmp);
    let mut recs = bn.new_bytes();
    let mut bitmap: [129]u32 = [0; 129];
    let mut starts = bn.new_bytes();
    let mut nstarts: usize = 0;
    for k in 0..es.len {
        recs.u32_(@as(u64, es[k].off) + 1);
        recs.u32_(1);
        let bk = @as(usize, es[k].bucket);
        if (k == 0) or (es[k - 1].bucket != es[k].bucket) {
            bitmap[bk / 32] = bitmap[bk / 32] | (@as(u32, 1) << @truncate(u32, bk % 32));
            starts.u32_(@as(u64, k) * 12);
            nstarts += 1;
        }
    }
    let mut b = bn.new_bytes();
    b.u32_(0xffff_ffff);
    b.u32_(0xeffe_0000 + 19990810);
    b.u32_(@as(u64, recs.len()));
    b.u32_(@as(u64, (129 * 4) + (nstarts * 4)));
    b.put(recs.view());
    for x in bitmap {
        b.u32_(@as(u64, x));
    }
    b.put(starts.view());
    return b;
}

// -----------------------------------------------------------------------------
// The MSF container
// -----------------------------------------------------------------------------
// The first block from b on that is not a free block map's.
fn past_fpm(b: u64) u64 {
    let mut next = b;
    while ((next % BS) == 1) or ((next % BS) == 2) {
        next += 1;
    }
    return next;
}

fn msf(streams: []bn.Bytes) bn.Bytes {
    let mut next: u64 = 3;
    let nstreams = streams.len;
    // each stream's first block (they are contiguous but for the free block
    // maps, which are skipped)
    let firsts = u.newn.[u64](nstreams + 1);
    let mut dir = bn.new_bytes();
    dir.u32_(@as(u64, nstreams));
    for s in streams {
        dir.u32_(@as(u64, s.len()));
    }
    let mut places = bn.new_bytes();  // (block, stream, block of the stream) to fill
    for si in 0..nstreams {
        let n = (@as(u64, streams[si].len()) + BS - 1) / BS;
        for k in @as(u64, 0)..n {
            next = past_fpm(next);
            if k == 0 {
                firsts[si] = next;
            }
            dir.u32_(next);
            places.u64_(next);
            places.u64_(@as(u64, si));
            places.u64_(k);
            next += 1;
        }
    }
    // the directory's blocks, then the block that lists them
    let ndir = (@as(u64, dir.len()) + BS - 1) / BS;
    let mut dir_blocks = bn.new_bytes();
    for _k in @as(u64, 0)..ndir {
        next = past_fpm(next);
        dir_blocks.u32_(next);
        next += 1;
    }
    next = past_fpm(next);
    let map_block = next;
    next += 1;
    let nblocks = next;
    let mut f = bn.new_bytes();
    f.zeros(@truncate(usize, nblocks * BS));
    let fv = f.view();
    // the superblock
    let magic = "Microsoft C/C++ MSF 7.00\r\n\x1aDS\x00\x00\x00";
    @mem_copy(fv[0..32], magic);
    bn.w32(fv, 32, BS);
    bn.w32(fv, 36, 1);  // the free block map in use: blocks 1, 4097, ...
    bn.w32(fv, 40, nblocks);
    bn.w32(fv, 44, @as(u64, dir.len()));
    bn.w32(fv, 48, 0);
    bn.w32(fv, 52, map_block);
    // streams' data
    let pv = places.view();
    let np = pv.len / 24;
    for i in 0..np {
        let blk = bn.rd64(pv, i * 24);
        let si = @truncate(usize, bn.rd64(pv, (i * 24) + 8));
        let k = bn.rd64(pv, (i * 24) + 16);
        let sv = streams[si].view();
        let from = @truncate(usize, k * BS);
        let to = @min(from + @truncate(usize, BS), sv.len);
        @mem_copy(fv[@truncate(usize, blk * BS)..@truncate(usize, blk * BS) + (to - from)], sv[from..to]);
    }
    // the directory
    let dv = dir.view();
    let dbv = dir_blocks.view();
    for k in 0..@truncate(usize, ndir) {
        let blk = bn.rd32(dbv, k * 4);
        let from = k * @truncate(usize, BS);
        let to = @min(from + @truncate(usize, BS), dv.len);
        @mem_copy(fv[@truncate(usize, blk * BS)..@truncate(usize, blk * BS) + (to - from)], dv[from..to]);
    }
    @mem_copy(fv[@truncate(usize, map_block * BS)..@truncate(usize, map_block * BS) + dbv.len], dbv);
    // the free block map: a bit per block, set when free; every block of
    // the file is in use, the bits past its end are free. It is spread over
    // blocks 1, 4097, ... (each holding the next 4096 bytes of bits).
    let nbytes = (nblocks + 7) / 8;
    let mut fpm: u64 = 1;
    let mut byte: u64 = 0;
    while fpm < nblocks {
        let base = @truncate(usize, fpm * BS);
        for i in @as(u64, 0)..BS {
            let at = byte + i;
            let mut bits: u8 = 0xff;
            if at < nbytes {
                bits = 0;
                for j in @as(u64, 0)..8 {
                    if ((at * 8) + j) >= nblocks {
                        bits = bits | (@as(u8, 1) << @truncate(u8, j));
                    }
                }
            }
            fv[base + @truncate(usize, i)] = bits;
        }
        byte += BS;
        fpm += BS;
    }
    return f;
}

// -----------------------------------------------------------------------------
// The streams
// -----------------------------------------------------------------------------
const S_TPI: u64 = 2;
const S_IPI: u64 = 4;
const S_NAMES: u64 = 5;
const S_TPI_HASH: u64 = 6;
const S_IPI_HASH: u64 = 7;
const S_PUBLICS: u64 = 8;
const S_GLOBALS: u64 = 9;
const S_SYMRECS: u64 = 10;
const S_SECHDR: u64 = 11;
const S_MODULE0: u64 = 12;

fn info_stream(guid: []u8, age: u32) bn.Bytes {
    let mut b = bn.new_bytes();
    b.u32_(20000404);          // VC70
    b.u32_(bn.rd32(guid, 0));  // signature: (the GUID identifies the build)
    b.u32_(@as(u64, age));
    b.put(guid[0..16]);
    // named streams: a string buffer, then a hash table (size, capacity,
    // present and deleted bit vectors, the entries)
    let name = "/names";
    b.u32_(@as(u64, name.len) + 1);
    cstr(&mut b, name);
    b.u32_(1);
    b.u32_(1);
    b.u32_(1);  // present: one word
    b.u32_(1);
    b.u32_(0);         // deleted: none
    b.u32_(0);         // "/names" at offset 0 ...
    b.u32_(S_NAMES);   // ... is stream 5
    b.u32_(0);         // (no more)
    b.u32_(20140508);  // feature: VC140
    return b;
}

// -----------------------------------------------------------------------------
// Types and ids (TPI, IPI)
// -----------------------------------------------------------------------------
const TPI_BUCKETS: u32 = 0x3ffff;

let mut crc_table: [256]u32 = [0; 256];

// A CRC-32 (the reflected polynomial 0xEDB88320) from 0, without the final
// inversion: the hash of type records that have no name to hash.
fn crc32(s: []u8) u32 {
    if crc_table[1] == 0 {
        for i in @as(u32, 0)..256 {
            let mut c = i;
            for _k in @as(u32, 0)..8 {
                if (c & 1) != 0 {
                    c = 0xedb8_8320 ^ (c >> 1);
                } else {
                    c = c >> 1;
                }
            }
            crc_table[@as(usize, i)] = c;
        }
    }
    let mut c: u32 = 0;
    for x in s {
        c = crc_table[@as(usize, (c ^ @as(u32, x)) & 0xff)] ^ (c >> 8);
    }
    return c;
}

/// The size of the numeric leaf at `at` of r.
pub fn numeric_size(r: []u8, at: usize) usize {
    let v = bn.rd16(r, at);
    if v < 0x8000 {
        return 2;
    }
    if v == 0x8000 {
        return 3;
    }
    if (v == 0x8001) or (v == 0x8002) {
        return 4;
    }
    if (v == 0x8003) or (v == 0x8004) {
        return 6;
    }
    return 10;
}

fn cstr_at(r: []u8, at: usize) []u8 {
    let mut e = at;
    while (e < r.len) and (r[e] != 0) {
        e += 1;
    }
    return r[@min(at, e)..e];
}

fn anonymous(n: []u8) bool {
    return u.str_eq(n, "<unnamed-tag>") or u.str_eq(n, "__unnamed") or u.ends(n, "::<unnamed-tag>") or
           u.ends(n, "::__unnamed");
}

/// The hash of a type or id record (its bytes, from its length): a
/// structure's, union's or enumeration's definition by its name (or, scoped
/// to a function, its unique name), an LF_UDT_SRC_LINE by its type's index,
/// others (forward references among them) by a CRC of their bytes.
pub fn record_hash(r: []u8) u32 {
    let kind = bn.rd16(r, 2);
    if (kind == 0x1504) or (kind == 0x1505) or (kind == 0x1506) or (kind == 0x1507) {
        let prop = bn.rd16(r, 6);
        let mut at: usize = 0;
        if kind == 0x1507 {
            at = 16;
        } else if kind == 0x1506 {
            at = 12 + numeric_size(r, 12);
        } else {
            at = 20 + numeric_size(r, 20);
        }
        let name = cstr_at(r, at);
        let fwd = (prop & 0x80) != 0;
        let scoped = (prop & 0x100) != 0;
        let unique = (prop & 0x200) != 0;
        let anon = unique and anonymous(name);
        if not fwd and not scoped and not anon {
            return hash_v1(name);
        }
        if not fwd and unique and not anon {
            return hash_v1(cstr_at(r, at + name.len + 1));
        }
        return crc32(r);
    }
    if (kind == 0x1606) or (kind == 0x1607) {
        return hash_v1(r[4..8]);
    }
    return crc32(r);
}

// A TPI or IPI stream (records: each from its length) and its hash stream
// (stream number hs): each record's hash, then where every 8 KiB of records
// starts (index, offset), then an empty hash adjustment table.
fn types_stream(recs: [][]u8, hs: u64, hash: *mut bn.Bytes) bn.Bytes {
    let mut body = bn.new_bytes();
    let mut offs = bn.new_bytes();
    let mut next_off: usize = 0;
    for k in 0..recs.len {
        if body.len() >= next_off {
            offs.u32_(0x1000 + @as(u64, k));
            offs.u32_(@as(u64, body.len()));
            next_off = body.len() + 8192;
        }
        hash.u32_(@as(u64, record_hash(recs[k]) % TPI_BUCKETS));
        body.put(recs[k]);
    }
    let nh = hash.len();
    hash.put(offs.view());
    let mut b = bn.new_bytes();
    b.u32_(20040203);                     // V80
    b.u32_(56);                           // header size
    b.u32_(0x1000);                       // type indexes begin
    b.u32_(0x1000 + @as(u64, recs.len));  // and end
    b.u32_(@as(u64, body.len()));
    b.u16_(hs);      // hash stream
    b.u16_(0xffff);  // auxiliary hash stream: none
    b.u32_(4);       // hash key size
    b.u32_(@as(u64, TPI_BUCKETS));
    b.u32_(0);  // hash values: offset, length
    b.u32_(@as(u64, nh));
    b.u32_(@as(u64, nh));  // index offsets
    b.u32_(@as(u64, offs.len()));
    b.u32_(@as(u64, hash.len()));  // hash adjustments: none
    b.u32_(0);
    b.put(body.view());
    body.free();
    offs.free();
    return b;
}

/// The executable is for ARM64 (else x86-64): its machine in the DBI
/// stream and the CodeView CPU type.
pub let mut g_arm64: bool = false;

fn machine() u64 {
    if g_arm64 {
        return 0xaa64;  // IMAGE_FILE_MACHINE_ARM64
    }
    return 0x8664;  // IMAGE_FILE_MACHINE_AMD64
}

fn cpu_type() u64 {
    if g_arm64 {
        return 0xf6;  // CV_CFL_ARM64
    }
    return 0xd0;  // CV_CFL_X64
}

/// Writes the PDB for an executable to path. guid: 16 bytes; sections: the
/// image's section headers (40 bytes each); files: the source files lines
/// refer to; funcs: the functions, of modules `mods`; tpi, ipi: the type
/// and id records (from their lengths, indexes from 0x1000).
pub fn write(path: []u8, guid: []u8, age: u32, sections: []u8, files: [][]u8, funcs: []Func, mods: []Mod, tpi: [][]u8,
             ipi: [][]u8) bool {
    let mut names = names_new();
    let mut mds = u.List.[Module].empty();
    let proc_at = u.newn.[u32](funcs.len + 1);
    let mut gl = u.List.[GlobalSym].empty();
    for mi in 0..mods.len {
        mds.push(module_stream(@truncate(u32, mi), funcs, proc_at, &mods[mi], files, &mut names, &mut gl));
    }
    let mut ps = public_symbols(funcs, proc_at, gl.items());
    let mut secs = bn.new_bytes();
    secs.put(sections);
    let ns = @truncate(usize, S_MODULE0) + mods.len;
    let streams = u.newn.[bn.Bytes](ns + 1);
    for k in 0..ns {
        streams[k] = bn.new_bytes();
    }
    streams[1] = info_stream(guid, age);
    let mut th = bn.new_bytes();
    let mut ih = bn.new_bytes();
    streams[@truncate(usize, S_TPI)] = types_stream(tpi, S_TPI_HASH, &mut th);
    streams[@truncate(usize, S_IPI)] = types_stream(ipi, S_IPI_HASH, &mut ih);
    streams[@truncate(usize, S_TPI_HASH)] = th;
    streams[@truncate(usize, S_IPI_HASH)] = ih;
    streams[3] = dbi_stream(age, sections, files, funcs, mds.items());
    streams[@truncate(usize, S_NAMES)] = names_stream(&mut names);
    streams[@truncate(usize, S_PUBLICS)] = ps.publics;
    streams[@truncate(usize, S_GLOBALS)] = ps.globals;
    streams[@truncate(usize, S_SYMRECS)] = ps.recs;
    streams[@truncate(usize, S_SECHDR)] = secs;
    for mi in 0..mds.len {
        streams[@truncate(usize, S_MODULE0) + mi] = mds.get(mi).b;
    }
    let mut f = msf(streams[0..ns]);
    return u.write_file(path, f.view());
}

// A module's stream: its symbols, then its line information.
struct Module {
    name: []u8,
    b: bn.Bytes,
    sym_size: usize,
    c13_size: usize,
    files: u.List.[u32],  // the files its lines are in (indexes in write's files)
    first: i32,           // its first function (-1: none)
}

// A symbol of the globals: its record and name.
struct GlobalSym {
    rec: []u8,
    name: []u8,
}

// The name of a symbol record of the kinds the globals hold (empty:
// another kind).
pub fn sym_name(r: []u8) []u8 {
    let kind = bn.rd16(r, 2);
    if (kind == 0x110c) or (kind == 0x110d) or (kind == 0x1112) or (kind == 0x1113) {
        return cstr_at(r, 14);  // S_LDATA32 S_GDATA32 S_LTHREAD32 S_GTHREAD32
    }
    if kind == 0x1108 {
        return cstr_at(r, 8);  // S_UDT
    }
    if kind == 0x1107 {
        return cstr_at(r, 8 + numeric_size(r, 8));  // S_CONSTANT
    }
    if (kind == 0x110f) or (kind == 0x1110) {
        return cstr_at(r, 39);  // S_LPROC32 S_GPROC32
    }
    return "";
}

fn module_stream(mi: u32, funcs: []Func, proc_at: []mut u32, md: *Mod, files: [][]u8, names: *mut Names,
                 gl: *mut u.List.[GlobalSym]) Module {
    // the symbols: an object name, then each procedure
    let mut m = bn.new_bytes();
    m.u32_(4);  // CV_SIGNATURE_C13
    let r0 = rec_begin(&mut m, 0x1101);  // S_OBJNAME
    m.u32_(0);
    cstr(&mut m, md.name);
    rec_end(&mut m, r0);
    let r1 = rec_begin(&mut m, 0x113c);  // S_COMPILE3
    m.u32_(0);  // language C, no flags
    m.u16_(cpu_type());
    m.zeros(16);  // front and back end versions
    cstr(&mut m, "axiom");
    rec_end(&mut m, r1);
    let mut first: i32 = -1;
    let mut mfiles = u.List.[u32].empty();
    for fi in 0..funcs.len {
        let f = funcs[fi];
        if f.module != mi {
            continue;
        }
        if first < 0 {
            first = @int_cast(i32, fi);
        }
        for l in f.lines {
            let mut seen = false;
            for x in mfiles.items() {
                if x == l.file {
                    seen = true;
                }
            }
            if not seen {
                mfiles.push(l.file);
            }
        }
        let base = m.len();
        proc_at[fi] = @truncate(u32, base);
        if f.syms.len > 0 {
            m.put(f.syms);
            for o in f.self_fix {
                let at = base + @as(usize, o);
                m.set_u32(at, bn.rd32(m.view(), at) + @as(u64, base));
            }
            continue;
        }
        let at = rec_begin(&mut m, pick(f.external, 0x1110, 0x110f));  // S_GPROC32, S_LPROC32
        m.u32_(0);  // parent
        let end_field = m.len();
        m.u32_(0);  // end: patched below
        m.u32_(0);  // next
        m.u32_(@as(u64, f.size));
        m.u32_(0);  // debug start and end: the whole function
        m.u32_(@as(u64, f.size));
        m.u32_(0);  // type: none
        m.u32_(@as(u64, f.off));
        m.u16_(@as(u64, f.sec));
        m.u8_(0);  // flags
        cstr(&mut m, f.name);
        rec_end(&mut m, at);
        let e = rec_begin(&mut m, 0x0006);  // S_END
        rec_end(&mut m, e);
        m.set_u32(end_field, @as(u64, e));
    }
    // the top level's (data, user-defined types): also the globals'
    m.put(md.syms);
    let mut at: usize = 0;
    while (at + 4) <= md.syms.len {
        let n = @truncate(usize, bn.rd16(md.syms, at)) + 2;
        let r = md.syms[at..at + n];
        let name = sym_name(r);
        if name.len > 0 {
            gl.push(GlobalSym.{ rec: r, name: name });
        }
        at += n;
    }
    let sym_size = m.len();
    // line information (C13): the files' checksum entries (no checksums),
    // then each function's lines
    let file_entry = u.newn.[u32](files.len + 1);
    if mfiles.len > 0 {
        let mut c = bn.new_bytes();
        for k in mfiles.items() {
            file_entry[@as(usize, k)] = @truncate(u32, c.len());
            c.u32_(@as(u64, names_add(names, files[@as(usize, k)])));
            c.u8_(0);  // checksum size
            c.u8_(0);  // kind: none
            c.align(4);
        }
        m.u32_(0xf4);  // DEBUG_S_FILECHKSMS
        m.u32_(@as(u64, c.len()));
        m.put(c.view());
    }
    for f in funcs {
        if (f.module != mi) or (f.lines.len == 0) {
            continue;
        }
        line_tables(&mut m, &f, file_entry);
    }
    let c13_size = m.len() - sym_size;
    m.u32_(0);  // global references: none
    return Module.{ name: md.name, b: m, sym_size: sym_size, c13_size: c13_size, files: mfiles, first: first };
}

fn pick(c: bool, a: u64, b: u64) u64 {
    if c {
        return a;
    }
    return b;
}

// A function's lines (DEBUG_S_LINES subsections, into m): a subsection per
// run of rows in one file, covering the code from the run's first row to
// the next run's (readers take a subsection's first file block only).
// file_entry: each file's checksum entry.
fn line_tables(m: *mut bn.Bytes, f: *Func, file_entry: []u32) void {
    let mut i: usize = 0;
    while i < f.lines.len {
        let mut j = i;
        while (j < f.lines.len) and (f.lines[j].file == f.lines[i].file) {
            j += 1;
        }
        let start = f.lines[i].off;
        let mut end = f.size;
        if j < f.lines.len {
            end = f.lines[j].off;
        }
        if end > start {
            let mut l = bn.new_bytes();
            l.u32_(@as(u64, f.off + start));
            l.u16_(@as(u64, f.sec));
            l.u16_(0);  // flags: no columns
            l.u32_(@as(u64, end - start));
            l.u32_(@as(u64, file_entry[@as(usize, f.lines[i].file)]));
            l.u32_(@as(u64, j - i));
            l.u32_(12 + (@as(u64, j - i) * 8));
            for k in i..j {
                l.u32_(@as(u64, f.lines[k].off - start));
                l.u32_(@as(u64, f.lines[k].line & 0xff_ffff) | 0x8000_0000);  // a statement
            }
            m.u32_(0xf2);  // DEBUG_S_LINES
            m.u32_(@as(u64, l.len()));
            m.put(l.view());
            l.free();
        }
        i = j;
    }
}

// The symbol record stream (a public symbol and a procedure reference per
// function, the modules' top-level data and user-defined types, each once)
// and its two hash streams.
struct Publics {
    recs: bn.Bytes,
    publics: bn.Bytes,
    globals: bn.Bytes,
}

fn public_symbols(funcs: []Func, proc_at: []u32, gl: []GlobalSym) Publics {
    let mut recs = bn.new_bytes();
    let pubs = u.newn.[HashEntry](funcs.len + 1);
    let mut globs = u.List.[HashEntry].empty();
    let pub_off = u.newn.[u32](funcs.len + 1);
    for fi in 0..funcs.len {
        let f = funcs[fi];
        let p = rec_begin(&mut recs, 0x110e);  // S_PUB32
        recs.u32_(3);  // code, a function
        recs.u32_(@as(u64, f.off));
        recs.u16_(@as(u64, f.sec));
        cstr(&mut recs, f.name);
        rec_end(&mut recs, p);
        pubs[fi] = HashEntry.{ name: f.name, off: @truncate(u32, p), bucket: 0 };
        pub_off[fi] = @truncate(u32, p);
        let mut pname = f.name;
        if f.syms.len > 0 {
            pname = sym_name(f.syms);
        }
        let g = rec_begin(&mut recs, pick(f.external, 0x1125, 0x1127));  // S_PROCREF, S_LPROCREF
        recs.u32_(0);
        recs.u32_(@as(u64, proc_at[fi]));
        recs.u16_(@as(u64, f.module) + 1);  // (1-based)
        cstr(&mut recs, pname);
        rec_end(&mut recs, g);
        globs.push(HashEntry.{ name: pname, off: @truncate(u32, g), bucket: 0 });
    }
    // (the same record from several objects once)
    let mut seen = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    for x in gl {
        let key = u.intern(x.rec);
        if seen.get(key) != 0 {
            continue;
        }
        seen.put(key, 1);
        let at = recs.len();
        recs.put(x.rec);
        globs.push(HashEntry.{ name: x.name, off: @truncate(u32, at), bucket: 0 });
    }
    let globals = gsi_hash(globs.items());
    // the publics: header, hash, then the address map (the records by
    // section and offset)
    let order = u.newn.[usize](funcs.len + 1);
    for k in 0..funcs.len {
        order[k] = k;
    }
    sort_by_address(order[0..funcs.len], funcs);
    let ph = gsi_hash(pubs[0..funcs.len]);
    let mut publics = bn.new_bytes();
    publics.u32_(@as(u64, ph.len()));
    publics.u32_(@as(u64, funcs.len) * 4);
    publics.zeros(20);  // thunks: none; sections: 0
    publics.put(ph.view());
    for k in 0..funcs.len {
        publics.u32_(@as(u64, pub_off[order[k]]));
    }
    return Publics.{ recs: recs, publics: publics, globals: globals };
}

// DBI: modules, section contributions and map, files, optional streams.
fn dbi_stream(age: u32, sections: []u8, files: [][]u8, funcs: []Func, mds: []Module) bn.Bytes {
    let mut mi = bn.new_bytes();
    for k in 0..mds.len {
        let md = &mds[k];
        mi.u32_(0);
        if md.first >= 0 {
            let f = &funcs[@as(usize, @bit_cast(u32, md.first))];
            section_contribution(&mut mi, @as(u64, f.sec), @as(u64, f.off), @as(u64, f.size), 0x6000_0020, @as(u64, k));
        } else {
            section_contribution(&mut mi, 0, 0, 0, 0, @as(u64, k));
        }
        mi.u16_(0);  // flags
        mi.u16_(S_MODULE0 + @as(u64, k));
        mi.u32_(@as(u64, md.sym_size));
        mi.u32_(0);  // C11 lines
        mi.u32_(@as(u64, md.c13_size));
        mi.u16_(@as(u64, @min(md.files.len, 0xffff)));
        mi.u16_(0);
        mi.u32_(0);
        mi.u32_(0);  // source file name index
        mi.u32_(0);  // PDB path name index
        cstr(&mut mi, md.name);
        cstr(&mut mi, md.name);
        mi.align(4);
    }
    // the section contributions: each function's, by address
    let order = u.newn.[usize](funcs.len + 1);
    for k in 0..funcs.len {
        order[k] = k;
    }
    sort_by_address(order[0..funcs.len], funcs);
    let mut sc = bn.new_bytes();
    sc.u32_(0xeffe_0000 + 19970605);  // version 6.0
    for k in 0..funcs.len {
        let f = &funcs[order[k]];
        section_contribution(
            &mut sc, @as(u64, f.sec), @as(u64, f.off), @as(u64, f.size), 0x6000_0020, @as(u64, f.module));
    }
    let sm = section_map(sections);
    // the files of each module
    let mut fi_ = bn.new_bytes();
    let mut nfiles: usize = 0;
    for md in mds {
        nfiles += md.files.len;
    }
    fi_.u16_(@as(u64, mds.len));
    fi_.u16_(@as(u64, @min(nfiles, 0xffff)));
    let mut first: usize = 0;
    for md in mds {
        fi_.u16_(@as(u64, @min(first, 0xffff)));
        first += md.files.len;
    }
    for md in mds {
        fi_.u16_(@as(u64, @min(md.files.len, 0xffff)));
    }
    let mut fnames = bn.new_bytes();
    let foff = u.newn.[u32](files.len + 1);
    for k in 0..files.len {
        foff[k] = @truncate(u32, fnames.len());
        cstr(&mut fnames, files[k]);
    }
    for md in mds {
        for x in md.files.items() {
            fi_.u32_(@as(u64, foff[@as(usize, x)]));
        }
    }
    fi_.put(fnames.view());
    fi_.align(4);
    let mut ec = bn.new_bytes();  // an empty string table
    ec.u32_(0xeffe_effe);
    ec.u32_(1);
    ec.u32_(1);
    ec.u8_(0);
    ec.u32_(1);
    ec.u32_(0);
    ec.u32_(0);
    let mut dbg = bn.new_bytes();
    for k in @as(u64, 0)..11 {
        if k == 5 {
            dbg.u16_(S_SECHDR);  // the section headers
        } else {
            dbg.u16_(0xffff);
        }
    }
    let mut dbi = bn.new_bytes();
    dbi.u32_(0xffff_ffff);  // version signature
    dbi.u32_(19990903);     // V70
    dbi.u32_(@as(u64, age));
    dbi.u16_(S_GLOBALS);
    dbi.u16_(0x8e00);  // build: new format, 14.0
    dbi.u16_(S_PUBLICS);
    dbi.u16_(0);
    dbi.u16_(S_SYMRECS);
    dbi.u16_(0);
    dbi.u32_(@as(u64, mi.len()));
    dbi.u32_(@as(u64, sc.len()));
    dbi.u32_(@as(u64, sm.len()));
    dbi.u32_(@as(u64, fi_.len()));
    dbi.u32_(0);  // type server map
    dbi.u32_(0);
    dbi.u32_(@as(u64, dbg.len()));
    dbi.u32_(@as(u64, ec.len()));
    dbi.u16_(0);  // flags
    dbi.u16_(machine());
    dbi.u32_(0);
    dbi.put(mi.view());
    dbi.put(sc.view());
    dbi.put(sm.view());
    dbi.put(fi_.view());
    dbi.put(ec.view());
    dbi.put(dbg.view());
    return dbi;
}

// The section map: an entry per section header, then one for absolute
// addresses.
fn section_map(sections: []u8) bn.Bytes {
    let nsec = sections.len / 40;
    let mut sm = bn.new_bytes();
    sm.u16_(@as(u64, nsec) + 1);
    sm.u16_(@as(u64, nsec) + 1);
    for k in 0..nsec {
        let fl = bn.rd32(sections, (k * 40) + 36);
        let mut flags: u64 = 0x108;  // a selector, 32-bit addresses
        if (fl & 0x4000_0000) != 0 {
            flags = flags | 1;  // read
        }
        if (fl & 0x8000_0000) != 0 {
            flags = flags | 2;  // write
        }
        if (fl & 0x2000_0000) != 0 {
            flags = flags | 4;  // execute
        }
        sm.u16_(flags);
        sm.u16_(0);
        sm.u16_(0);
        sm.u16_(@as(u64, k) + 1);  // frame: the section's number
        sm.u16_(0xffff);
        sm.u16_(0xffff);
        sm.u32_(0);
        sm.u32_(bn.rd32(sections, (k * 40) + 8));  // virtual size
    }
    sm.u16_(0x208);  // absolute addresses
    sm.u16_(0);
    sm.u16_(0);
    sm.u16_(@as(u64, nsec) + 1);
    sm.u16_(0xffff);
    sm.u16_(0xffff);
    sm.u32_(0);
    sm.u32_(0xffff_ffff);
    return sm;
}

// A section contribution: section, offset, size, characteristics, module.
fn section_contribution(b: *mut bn.Bytes, sec: u64, off: u64, size: u64, flags: u64, module: u64) void {
    b.u16_(sec);
    b.u16_(0);
    b.u32_(off);
    b.u32_(size);
    b.u32_(flags);
    b.u16_(module);
    b.u16_(0);
    b.u32_(0);  // data and relocation CRCs
    b.u32_(0);
}

fn addr_less(a: *Func, b: *Func) bool {
    if a.sec != b.sec {
        return a.sec < b.sec;
    }
    if a.off != b.off {
        return a.off < b.off;
    }
    return u.str_cmp(a.name, b.name) < 0;
}

fn sort_by_address(order: []mut usize, funcs: []Func) void {
    // functions come in address order from the linker but for a few: an
    // insertion sort
    for i in @as(usize, 1)..order.len {
        let x = order[i];
        let mut j = i;
        while (j > 0) and addr_less(&funcs[x], &funcs[order[j - 1]]) {
            order[j] = order[j - 1];
            j -= 1;
        }
        order[j] = x;
    }
}
