// =============================================================================
// linkin.ax - the inputs a build links besides its own code: relocatable
// objects, static archives and shared libraries, given on the command line
// (`x.o`, `--link=lib.a`, ...), by name (-l<name>, looked for in the -L
// directories and the system's), or compiled from C by the system's C
// compiler (--link=x.c). They may be the compiler's own (--emit=obj,
// --emit=lib) or the platform toolchain's for the same target.
//
// load() reads them once, before code generation, so that the build knows
// what they refer to (refs: the compiler's C library supplies those names,
// and what they reach is kept), and the linker takes what it loaded: the
// objects, the archives' members (it chooses among them: ar.select), the
// shared libraries.
// =============================================================================
import "ar.ax" as ar;
import "coff.ax" as coff;
import "elf.ax" as elf;
import "elink.ax" as el;
import "macho.ax" as mo;
import "target.ax" as tg;
import "types.ax" as ty;
import "util.ax" as u;
import "wobj.ax" as wo;

/// The objects (each with a name for messages), the archive members a link
/// may take, and the shared libraries (by path) loaded (load).
pub let mut g_objs: u.List.[*mut elf.Obj] = u.List.[*mut elf.Obj].{ data: @ptr_from_int(*mut *mut elf.Obj, 0), len: 0,
                                                                    cap: 0 };
pub let mut g_members: u.List.[*mut elf.Obj] = u.List.[*mut elf.Obj].{ data: @ptr_from_int(*mut *mut elf.Obj, 0),
                                                                       len: 0, cap: 0 };
pub let mut g_shlibs: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
// The files the -l names found that are shared objects (or scripts), for
// what they refer to (refs).
let mut g_named_paths: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
/// WebAssembly targets: the objects (wobj.ax units) and archive members.
pub let mut g_wunits: u.List.[*mut wo.Unit] = u.List.[*mut wo.Unit].{ data: @ptr_from_int(*mut *mut wo.Unit, 0), len: 0,
                                                                      cap: 0 };
pub let mut g_wmembers: u.List.[*mut wo.Unit] = u.List.[*mut wo.Unit].{ data: @ptr_from_int(*mut *mut wo.Unit, 0),
                                                                        len: 0, cap: 0 };
/// The -L directories, and the libraries named with -l (in order) that are
/// not static archives (those are read into g_members).
pub let mut g_dirs: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
pub let mut g_names: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
/// Windows: the DLLs' exports that import libraries (their short import
/// records) and DLLs given to the link name (plink.ax binds to them).
pub let mut g_imports: u.List.[coff.Import] = u.List.[coff.Import].{ data: @ptr_from_int(*mut coff.Import, 0), len: 0,
                                                                     cap: 0 };
/// macOS: the dynamic libraries given to the link (mlink.ax binds to them).
pub let mut g_dylibs: u.List.[*mut mo.Dylib] = u.List.[*mut mo.Dylib].{ data: @ptr_from_int(*mut *mut mo.Dylib, 0),
                                                                        len: 0, cap: 0 };
/// Did load() read anything (objects, members or libraries)?
pub let mut g_any: bool = false;
/// The system's C library is the program's (--c-lib=system) on Linux: its
/// archive of the functions its shared object does not export (`atexit`,
/// `at_quick_exit`, `pthread_atfork`: libc_nonshared.a, which the system's
/// libc.so linker script names after libc.so.6) is linked as an archive.
pub let mut g_system_libc: bool = false;

fn machine() u32 {
    if tg.g_arch == tg.ARCH_A64 {
        return elf.EM_AARCH64;
    }
    return elf.EM_X86_64;
}

fn err(msg: []u8) void {
    u.eprint(u.f1("axiom: link error: %s\n", msg));
}

/// Reads the inputs: `paths` (objects, archives, shared libraries, linker
/// scripts), and `flags` (-L<dir>, -l<name>: a library by name, its
/// archive's members or its shared object). False after an error
/// (reported).
pub fn load(paths: [][]u8, flags: [][]u8) bool {
    let mut ok = true;
    for f in flags {
        if u.starts(f, "-L") {
            g_dirs.push(f[2..]);
        }
    }
    for p in paths {
        ok = add_path(p, 0) and ok;
    }
    for f in flags {
        if not u.starts(f, "-l") {
            continue;
        }
        let name = f[2..];
        if ty.g_target.is_wasm {
            // (an archive of WebAssembly objects, in the -L directories)
            let mut found = false;
            for d in g_dirs.items() {
                let p = u.f2("%s/lib%s.a", d, name);
                if not found and u.file_exists(p) {
                    ok = add_path(p, 0) and ok;
                    found = true;
                }
            }
            if not found {
                err(u.f1("cannot find library '%s' (lib%s.a in the -L directories)", name));
                ok = false;
            }
            continue;
        }
        if el_libc_part(name) {
            g_names.push(name);  // (the C library's own: the program's, or the system's)
            continue;
        }
        if tg.is_windows() {
            // name.lib, libname.a, libname.dll.a (archives: objects or an
            // import library), name.dll
            let mut found = false;
            for d in g_dirs.items() {
                for pat in ["%s/%s.lib", "%s/lib%s.a", "%s/lib%s.dll.a", "%s/%s.dll"] {
                    let p = u.f2(pat, d, name);
                    if not found and u.file_exists(p) {
                        ok = add_path(p, 0) and ok;
                        found = true;
                    }
                }
            }
            if not found {
                err(u.f3("cannot find library '%s' (%s.lib, lib%s.a or a DLL in the -L directories)", name, name,
                         name));
                ok = false;
            }
            continue;
        }
        if tg.is_darwin() {
            // libname.a (an archive), libname.dylib (read: its exports),
            // else by name (libname.tbd, or nothing here: the system's
            // libraries; mlink.ax binds by name)
            let mut found = false;
            for d in g_dirs.items() {
                for pat in ["%s/lib%s.a", "%s/lib%s.dylib"] {
                    let p = u.f2(pat, d, name);
                    if not found and u.file_exists(p) {
                        ok = add_path(p, 0) and ok;
                        found = true;
                    }
                }
            }
            if not found {
                g_names.push(name);
            }
            continue;
        }
        if tg.g_os != tg.OS_LINUX {
            g_names.push(name);
            continue;
        }
        let p = el.find_library(name, g_dirs.items(), machine());
        if u.isnos(p) or (p.len == 0) {
            err(u.f1("cannot find library '%s'", name));
            ok = false;
            continue;
        }
        if u.ends(p, ".a") {
            ok = add_path(p, 0) and ok;
        } else {
            g_names.push(name);  // (a shared object or script: elink.load_libs reads it)
            g_named_paths.push(p);
        }
    }
    if g_system_libc and (tg.g_os == tg.OS_LINUX) and not ty.g_target.is_wasm {
        let p = libc_nonshared();
        if p.len > 0 {
            ok = add_path(p, 0) and ok;
        }
    }
    if ((g_objs.len + g_members.len) > 0) and (tg.g_os == tg.OS_LINUX) and not ty.g_target.is_wasm {
        // the platform toolchain's compiler runtime, which its objects call
        // (complex arithmetic, 128-bit integers, AArch64's out-of-line
        // atomics, ...): its archives, from which a member is linked only
        // where nothing else defines what an object needs, as the system's
        // linker links them
        for a in runtime_archives() {
            ok = add_path(a, 0) and ok;
        }
    }
    g_any = (g_objs.len + g_members.len + g_shlibs.len + g_wunits.len + g_wmembers.len + g_imports.len + g_dylibs.len) >
            0;
    return ok;
}

fn is_wasm_object(d: []u8) bool {
    return (d.len >= 8) and u.str_eq(d[0..4], "\x00asm");
}

fn read_wasm(d: []u8, name: []u8) *mut wo.Unit {
    let un = wo.read_object(d);
    if u.isnil(un) {
        err(u.f1("cannot read the WebAssembly object '%s'", name));
        return un;
    }
    if un.wasm64 != (ty.g_target.ptr_bits == 64) {
        err(u.f2("'%s' is not an object for %s", name, u.pick(ty.g_target.ptr_bits == 64, "wasm64", "wasm32")));
        return u.nil.[wo.Unit]();
    }
    return un;
}

// The archives of the system C compiler's runtime for the target
// (libgcc.a, libgcc_eh.a: the directory of its newest version), if any.
// The system C library's libc_nonshared.a (g_system_libc), or "".
fn libc_nonshared() []u8 {
    let triple = u.pick(machine() == elf.EM_AARCH64, "aarch64-linux-gnu", "x86_64-linux-gnu");
    for p in [u.f1("/usr/lib/%s/libc_nonshared.a", triple), u.f1("/usr/%s/lib/libc_nonshared.a", triple),
              "/usr/lib64/libc_nonshared.a", "/usr/lib/libc_nonshared.a"] {
        if u.file_exists(p) {
            return p;
        }
    }
    return "";
}

fn runtime_archives() [][]u8 {
    let mut out = u.List.[[]u8].empty();
    let triple = u.pick(machine() == elf.EM_AARCH64, "aarch64-linux-gnu", "x86_64-linux-gnu");
    for base in ["/usr/lib/gcc", "/usr/lib/gcc-cross"] {
        let dir = u.f2("%s/%s", base, triple);
        let mut vers = u.List.[[]u8].empty();
        if not u.list_dir(dir, &mut vers) {
            continue;
        }
        let mut best: []u8 = "";
        let mut best_v: i64 = -1;
        for v in vers.items() {
            let n = u.atol(v);
            if (n > best_v) and u.file_exists(u.f2("%s/%s/libgcc.a", dir, v)) {
                best_v = n;
                best = v;
            }
        }
        if best_v >= 0 {
            for f in ["libgcc.a", "libgcc_eh.a"] {
                let p = u.f3("%s/%s/%s", dir, best, f);
                if u.file_exists(p) {
                    out.push(p);
                }
            }
            break;
        }
    }
    return out.items();
}

// The libraries of the system's C library itself (elink.ax: is_libc_part).
fn el_libc_part(name: []u8) bool {
    for x in ["c", "m", "pthread", "dl", "rt"] {
        if u.str_eq(x, name) {
            return true;
        }
    }
    return false;
}

// One input by path: what it is is read from its contents.
fn add_path(p: []u8, depth: i32) bool {
    let d = u.read_file(p);
    if u.isnos(d) {
        err(u.f1("cannot read '%s'", p));
        return false;
    }
    if ar.is_archive(d) {
        let mut ok = true;
        let ms = ar.read(d, p, &mut ok);
        if not ok {
            err(u.f1("'%s' is not a valid archive", p));
            return false;
        }
        for m in ms.items() {
            if coff.is_import(m.data) {
                let im = coff.read_import(m.data);
                if im.dll.len == 0 {
                    err(u.f3("%s(%s): %s", p, m.name, coff.g_error));
                    return false;
                }
                g_imports.push(im);
                continue;
            }
            if is_wasm_object(m.data) {
                let w = read_wasm(m.data, u.f2("%s(%s)", p, m.name));
                if u.isnil(w) {
                    return false;
                }
                g_wmembers.push(w);
                continue;
            }
            if u.ends(m.name, ".o") or u.ends(m.name, ".obj") or is_object(m.data) {
                let o = read_object(m.data, u.f2("%s(%s)", p, m.name));
                if u.isnil(o) {
                    return false;
                }
                g_members.push(o);
            }
            // (other members, such as a toolchain's notes, are not objects)
        }
        return true;
    }
    if is_wasm_object(d) {
        let w = read_wasm(d, p);
        if u.isnil(w) {
            return false;
        }
        g_wunits.push(w);
        return true;
    }
    if is_object(d) {
        let o = read_object(d, p);
        if u.isnil(o) {
            return false;
        }
        g_objs.push(o);
        return true;
    }
    if mo.is_dylib(d) and tg.is_darwin() {
        let lib = mo.read_dylib(d, machine() == elf.EM_X86_64);
        if u.isnil(lib) {
            err(u.f2("'%s': %s", p, mo.g_error));
            return false;
        }
        g_dylibs.push(lib);
        return true;
    }
    if coff.is_image(d) and tg.is_windows() {
        // a DLL: what it exports, by name
        let ims = coff.pe_exports(d, u.basename(p), u64_pick(machine() == elf.EM_AARCH64, coff.MACHINE_ARM64,
                                                             coff.MACHINE_AMD64));
        if coff.g_error.len > 0 {
            err(u.f2("'%s': %s", p, coff.g_error));
            return false;
        }
        for im in ims.items() {
            g_imports.push(im);
        }
        return true;
    }
    if (d.len >= 18) and u.str_eq(d[0..4], "\x7fELF") {
        if bn_rd16(d, 16) == 3 {
            g_shlibs.push(p);  // ET_DYN: a shared library
            return true;
        }
        err(u.f1("'%s' is not a relocatable object or a shared library", p));
        return false;
    }
    // a linker script (INPUT, GROUP)
    let mut ok = true;
    let files = el.script_inputs(d, g_dirs.items(), machine(), &mut ok);
    if not ok or (files.len == 0) or (depth > 4) {
        err(u.f1("'%s' is not an object, an archive or a library this linker reads", p));
        return false;
    }
    for f in files.items() {
        if u.ends(f, ".a") {
            ok = add_path(f, depth + 1) and ok;
        } else {
            g_shlibs.push(f);
        }
    }
    return ok;
}

fn u64_pick(c: bool, a: u64, b: u64) u64 {
    if c {
        return a;
    }
    return b;
}

fn bn_rd16(d: []u8, off: usize) u64 {
    return @as(u64, d[off]) | (@as(u64, d[off + 1]) << 8);
}

/// Is d a relocatable object of a format the linkers read (ELF, Mach-O,
/// COFF)?
pub fn is_object(d: []u8) bool {
    return elf.is_object(d) or mo.is_object(d) or coff.is_object(d);
}

/// Object d of any format the linkers read, as the linkers take it (with
/// ELF relocation types), or nil with *why saying why not.
pub fn read_any(d: []u8, why: *mut []u8) *mut elf.Obj {
    why.* = "";
    if mo.is_object(d) {
        let o = mo.read(d);
        if u.isnil(o) {
            why.* = mo.g_error;
        }
        return o;
    }
    if coff.is_object(d) {
        let o = coff.read(d);
        if u.isnil(o) {
            why.* = coff.g_error;
        }
        return o;
    }
    return elf.read(d);
}

fn read_object(d: []u8, name: []u8) *mut elf.Obj {
    let mut why: []u8 = "";
    let o = read_any(d, &mut why);
    if u.isnil(o) {
        if why.len > 0 {
            err(u.f2("cannot read the object '%s': %s", name, why));
        } else {
            err(u.f1("cannot read the object '%s'", name));
        }
        return o;
    }
    if o.machine != machine() {
        err(u.f2("'%s' is not an object for %s", name, tg.os_target_name()));
        return u.nil.[elf.Obj]();
    }
    o.name = name;
    return o;
}

/// The names the inputs refer to and do not define (the objects', and
/// those of the archive members they take), into *out: the program
/// (the compiler's C library above all) is to define them. `roots`: what
/// the program's own code refers to, which archive members may define.
pub fn refs(roots: [][]u8, out: *mut u.List.[[]u8]) void {
    let mut defined = u.List.[[]u8].empty();
    let mut undefined = u.List.[[]u8].empty();
    for o in g_objs.items() {
        el.object_names(o, &mut defined, &mut undefined);
    }
    for w in g_wunits.items() {
        unit_names(w, &mut defined, &mut undefined);
    }
    let nm = g_members.len + g_wmembers.len;
    let ms = u.newn.[ar.Syms](nm + 1);
    for i in 0..nm {
        let mut ds = u.List.[[]u8].empty();
        let mut rs = u.List.[[]u8].empty();
        if i < g_members.len {
            el.object_names(g_members.get(i), &mut ds, &mut rs);
        } else {
            unit_names(g_wmembers.get(i - g_members.len), &mut ds, &mut rs);
        }
        ms[i] = ar.Syms.{ defs: ds.items(), refs: rs.items() };
    }
    // (a shared library's references: the program may define them, and
    // keeps what it defines of them; the system C library's own are not
    // the program's)
    let mut shs = u.List.[[]u8].empty();
    for p in g_shlibs.items() {
        shs.push(p);
    }
    for p in g_named_paths.items() {
        shs.push(p);
    }
    for p in shs.items() {
        let b = u.basename(p);
        if not (u.starts(b, "libc.so") or u.starts(b, "libm.so") or u.starts(b, "ld-linux") or
                u.starts(b, "libpthread") or u.starts(b, "libdl") or u.starts(b, "librt")) {
            el.shlib_undefs(p, machine(), &mut undefined);
        }
    }
    let mut wanted = u.List.[[]u8].empty();
    for n in undefined.items() {
        wanted.push(n);
    }
    for n in roots {
        wanted.push(n);
    }
    let take = ar.select(ms[0..nm], wanted.items(), defined.items());
    let mut have = u.SymMap.[u8].{ keys: u.nil.[usize](), vals: u.nil.[u8](), cap: 0, len: 0 };
    for n in defined.items() {
        have.put(u.intern(n), 1);
    }
    for i in 0..nm {
        if take[i] {
            for n in ms[i].defs {
                have.put(u.intern(n), 1);
            }
            for n in ms[i].refs {
                undefined.push(n);
            }
        }
    }
    for n in undefined.items() {
        let k = u.intern(n);
        if have.get(k) == 0 {
            have.put(k, 1);
            out.push(k);
        }
    }
}

/// The names a WebAssembly unit defines (into *defs) and refers to strongly
/// without defining (into *refs), for archive member selection.
pub fn unit_names(w: *wo.Unit, defs: *mut u.List.[[]u8], uses: *mut u.List.[[]u8]) void {
    for i in 0..w.syms.len {
        let s = w.syms.get(i);
        if ((s.flags & wo.F_LOCAL) != 0) or (s.name.len == 0) or (s.kind == wo.SYM_TABLE) {
            continue;
        }
        if (s.flags & wo.F_UNDEFINED) == 0 {
            defs.push(s.name);
        } else if (s.flags & wo.F_WEAK) == 0 {
            uses.push(s.name);
        }
    }
}

/// The WebAssembly archive members a link takes (ar.select), for units
/// `us` (the program's and g_wunits).
pub fn wasm_members(us: []*mut wo.Unit) u.List.[*mut wo.Unit] {
    let mut out = u.List.[*mut wo.Unit].empty();
    if g_wmembers.len == 0 {
        return out;
    }
    let mut defined = u.List.[[]u8].empty();
    let mut undefined = u.List.[[]u8].empty();
    for w in us {
        unit_names(w, &mut defined, &mut undefined);
    }
    let ms = u.newn.[ar.Syms](g_wmembers.len + 1);
    for i in 0..g_wmembers.len {
        let mut ds = u.List.[[]u8].empty();
        let mut rs = u.List.[[]u8].empty();
        unit_names(g_wmembers.get(i), &mut ds, &mut rs);
        ms[i] = ar.Syms.{ defs: ds.items(), refs: rs.items() };
    }
    let take = ar.select(ms[0..g_wmembers.len], undefined.items(), defined.items());
    for i in 0..g_wmembers.len {
        if take[i] {
            out.push(g_wmembers.get(i));
        }
    }
    return out;
}

// ---------------------------------------------------------------------------
// A C program's main in its objects (main.ax: object_main): when no
// translation unit of the program defines main, the objects and archive
// members read (load) may. The start-up calls it as it calls a unit's
// (cgen.ax: start), under another name, since the program's own `main` is
// the runtime's entry point (codegen: emit_native_entry), which the system's
// start-up calls.

/// No object or member defines main.
pub const MAIN_NONE: i32 = 0;
/// One defines a C function main (the platform toolchain's object, or
/// another compiler's): renamed OBJ_MAIN.
pub const MAIN_C: i32 = 1;
/// One is this compiler's object of C units that define main (--emit=obj):
/// it has the start-up's call of main (START_NAME), renamed OBJ_START, and
/// the runtime's entry point (`main`), which gives way to the program's.
pub const MAIN_START: i32 = 2;

pub let OBJ_MAIN: []u8 = "__axiom_c_obj_main";
pub let OBJ_START: []u8 = "__axiom_c_obj_start";
let START_NAME: []u8 = "__axiom_c_main";

/// What find_main found: the kind (MAIN_*), the object (or member) that
/// defines it, the number of main's parameters (MAIN_C on WebAssembly,
/// where a call takes the function's type: 0 or 2; else 2, which a main
/// without parameters ignores, as the platforms' start-up code calls it),
/// whether it is an archive member's, whether its definition is strong,
/// and the name of a second object (not a member) that defines main
/// strongly, if one does.
pub struct MainDef {
    kind: i32,
    obj: []u8,
    nargs: i32,
    member: bool,
    strong: bool,
    second: []u8,
}

// The kind of main that object o defines (MAIN_*), and whether strongly.
fn obj_main(o: *elf.Obj, strong: *mut bool) i32 {
    let mut kind = MAIN_NONE;
    for si in 0..o.syms.len {
        let sy = o.syms.get(si);
        if (sy.bind == elf.B_LOCAL) or (sy.sec == -1) {
            continue;
        }
        if u.str_eq(sy.name, START_NAME) {
            kind = MAIN_START;
            strong.* = true;
        } else if u.str_eq(sy.name, "main") and (kind == MAIN_NONE) and (sy.ty != elf.T_OBJECT) {
            kind = MAIN_C;
            strong.* = sy.bind == elf.B_GLOBAL;
        }
    }
    return kind;
}

// The kind of main that WebAssembly unit w defines (MAIN_*), whether
// strongly, and (MAIN_C) its number of parameters. A C main is `main`, or
// `__main_argc_argv` (the tool conventions' name of main(argc, argv)).
fn unit_main(w: *wo.Unit, strong: *mut bool, nargs: *mut i32) i32 {
    let mut kind = MAIN_NONE;
    for i in 0..w.syms.len {
        let s = w.syms.get(i);
        if ((s.flags & (wo.F_LOCAL | wo.F_UNDEFINED)) != 0) or (s.kind != wo.SYM_FUNC) {
            continue;
        }
        if u.str_eq(s.name, START_NAME) {
            kind = MAIN_START;
            strong.* = true;
        } else if (u.str_eq(s.name, "main") or u.str_eq(s.name, "__main_argc_argv")) and (kind == MAIN_NONE) {
            kind = MAIN_C;
            strong.* = (s.flags & wo.F_WEAK) == 0;
            nargs.* = 2;
            let fi = @as(usize, s.index);
            if (fi >= w.fimports.len) and ((fi - w.fimports.len) < w.funcs.len) {
                let t = w.types.get(@as(usize, w.funcs.get(fi - w.fimports.len).ty));
                if (t.len > 1) and (t[1] == 0) {
                    nargs.* = 0;
                }
            }
        }
    }
    return kind;
}

/// The main the objects and archive members read (load) define: the first
/// object's, else the first member's (which the start-up's reference then
/// takes).
pub fn find_main() MainDef {
    let mut m = MainDef.{ kind: MAIN_NONE, obj: "", nargs: 2, member: false, strong: false, second: "" };
    let mut strong_seen = false;
    for pass in @as(usize, 0)..2 {
        let mut n = g_objs.len + g_wunits.len;
        if pass == 1 {
            n = g_members.len + g_wmembers.len;
        }
        for i in 0..n {
            let mut strong = false;
            let mut nargs: i32 = 2;
            let mut kind = MAIN_NONE;
            let mut name: []u8 = "";
            if (pass == 0) and (i < g_objs.len) {
                kind = obj_main(g_objs.get(i), &mut strong);
                name = g_objs.get(i).name;
            } else if pass == 0 {
                kind = unit_main(g_wunits.get(i - g_objs.len), &mut strong, &mut nargs);
                name = u.f1("object %s", u.zdec(i - g_objs.len + 1));
            } else if i < g_members.len {
                kind = obj_main(g_members.get(i), &mut strong);
                name = g_members.get(i).name;
            } else {
                kind = unit_main(g_wmembers.get(i - g_members.len), &mut strong, &mut nargs);
                name = u.f1("archive member %s", u.zdec(i - g_members.len + 1));
            }
            if kind == MAIN_NONE {
                continue;
            }
            if (pass == 0) and strong and strong_seen and (m.second.len == 0) {
                m.second = name;
            }
            if (pass == 0) and strong {
                strong_seen = true;
            }
            if m.kind == MAIN_NONE {
                m = MainDef.{ kind: kind, obj: name, nargs: nargs, member: pass == 1, strong: strong,
                              second: m.second };
            }
        }
        if m.kind != MAIN_NONE {
            break;
        }
    }
    return m;
}

// Renames symbol `from` of object o (a definition or a reference) to `to`.
fn rename_sym(o: *mut elf.Obj, from: []u8, to: []u8) void {
    for si in 0..o.syms.len {
        let sy = o.syms.at(si);
        if (sy.bind != elf.B_LOCAL) and u.str_eq(sy.name, from) {
            sy.name = to;
            let k = o.symmap.get(u.intern(from));
            if k != 0 {
                o.symmap.put(u.intern(from), 0);
                o.symmap.put(u.intern(to), k);
            }
        }
    }
}

// The same for WebAssembly unit w.
fn rename_wsym(w: *mut wo.Unit, from: []u8, to: []u8) void {
    for i in 0..w.syms.len {
        let s = w.syms.at(i);
        if ((s.flags & wo.F_LOCAL) == 0) and u.str_eq(s.name, from) {
            s.name = to;
            let k = w.symmap.get(u.intern(from));
            if k != 0 {
                w.symmap.put(u.intern(from), 0);
                w.symmap.put(u.intern(to), k);
            }
        }
    }
}

// Object o defines START_NAME: its `main` (the runtime's entry point, as
// the program's) is weak, so that the program's is linked.
fn yield_entry(o: *mut elf.Obj) void {
    let mut strong = false;
    if obj_main(o, &mut strong) != MAIN_START {
        return;
    }
    for si in 0..o.syms.len {
        let sy = o.syms.at(si);
        if (sy.bind == elf.B_GLOBAL) and (sy.sec != -1) and u.str_eq(sy.name, "main") {
            sy.bind = elf.B_WEAK;
        }
    }
}

/// Makes the main that find_main found (m) the one the program's start-up
/// calls, in every object and member: MAIN_C, its `main` (and the
/// references to it) renamed OBJ_MAIN (on WebAssembly `__main_argc_argv`
/// too); MAIN_START, START_NAME renamed OBJ_START, the objects' entry
/// points weak. The name the start-up calls.
pub fn take_main(m: MainDef) []u8 {
    let mut from: []u8 = START_NAME;
    let mut to: []u8 = OBJ_START;
    if m.kind == MAIN_C {
        from = "main";
        to = OBJ_MAIN;
    }
    for k in 0..g_objs.len + g_members.len {
        let mut o = u.nil.[elf.Obj]();
        if k < g_objs.len {
            o = g_objs.get(k);
        } else {
            o = g_members.get(k - g_objs.len);
        }
        if m.kind == MAIN_START {
            yield_entry(o);
        }
        rename_sym(o, from, to);
    }
    for k in 0..g_wunits.len + g_wmembers.len {
        let mut w = u.nil.[wo.Unit]();
        if k < g_wunits.len {
            w = g_wunits.get(k);
        } else {
            w = g_wmembers.get(k - g_wunits.len);
        }
        rename_wsym(w, from, to);
        if m.kind == MAIN_C {
            rename_wsym(w, "__main_argc_argv", to);
        }
    }
    return to;
}
