// =============================================================================
// backend.ax - from IR to an object file: target-independent lowering and
// optimization (lower.ax, opt.ax), then the target's code generator.
// =============================================================================
import "a64.ax" as a64;
import "asm/inline.ax" as ai;
import "bin.ax" as bn;
import "coff.ax" as coff;
import "dbginfo.ax" as dbi;
import "elf.ax" as elf;
import "elfpack.ax" as ep;
import "gvn.ax" as gvn;
import "idioms.ax" as idioms;
import "ir.ax" as ir;
import "isel.ax" as is;
import "loopopt.ax" as lopt;
import "loops.ax" as loops;
import "lower.ax" as lower;
import "lstub.ax" as lstub;
import "macho.ax" as mo;
import "opt.ax" as opt;
import "outline.ax" as outl;
import "passes.ax" as passes;
import "slots.ax" as slots;
import "std/thread" as thread;
import "tailrec.ax" as tre;
import "target.ax" as tg;
import "thread.ax" as thr;
import "unroll.ax" as unr;
import "util.ax" as u;
import "vectorize.ax" as vec;
import "vsplit.ax" as vsplit;
import "wasm.ax" as wa;
import "wobj.ax" as wo;
import "x64.ax" as x64;
import "x64caps.ax" as x64c;
import "x64simd.ax" as xsd;

pub const EMIT_OBJ: i32 = 0;
pub const EMIT_IR: i32 = 1;
pub const EMIT_ASM: i32 = 2;

// An object for a C program to link (--emit=obj for Linux) carries the
// system call stubs the runtime calls (lstub.ax), which axiom's own linker
// adds to its programs.
pub let mut g_stubs: bool = false;

// A program that axiom's own linker links may have its machine code made in
// parts, in parallel (compile_parts); main sets g_parts then, and links the
// objects of the parts after the first, g_part_objs, with it.
pub let mut g_parts: bool = false;

// A WebAssembly program that axiom's own linker links in this process is not
// written as an object and read back: main sets g_keep_path to the object's
// path, and the unit compiled for that path is kept here, g_kept_unit, for
// the linker.
pub let mut g_keep_path: []u8 = "";
/// Objects for other links (--emit=obj, --emit=lib) are in the target's own
/// format: Mach-O for macOS (macho.ax), COFF for Windows (coff.ax). The
/// objects a build links itself stay ELF ones, which elf.read gives the
/// linkers as they are.
pub let mut g_native_format: bool = false;
/// The ELF objects made on this thread are packed (elfpack.ax): those of
/// the unit cache, which only our own linkers read (units.ax).
pub threadlocal let mut g_pack: bool = false;
pub let mut g_kept_unit: *mut wo.Unit = @ptr_from_int(*mut wo.Unit, 0);
pub let mut g_part_objs: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };

/// The objects of the parts (the first part's at the object's own path),
/// which are not written: the link reads them from here (object_bytes).
pub struct MemObject {
    path: []u8,
    bytes: []u8,
}

pub let mut g_mem_objects: u.List.[MemObject] = u.List.[MemObject].{ data: @ptr_from_int(*mut MemObject, 0), len: 0,
                                                                     cap: 0 };

/// The bytes of the object at path that a part made, or a nil slice (it is
/// in the file).
pub fn object_bytes(path: []u8) []u8 {
    for x in g_mem_objects.items() {
        if u.str_eq(x.path, path) {
            return x.bytes;
        }
    }
    return u.nosym();
}

/// Writes the objects of the parts to their paths (for a link by other
/// tools); false if one cannot be.
pub fn write_objects() bool {
    for x in g_mem_objects.items() {
        if not u.write_file(x.path, x.bytes) {
            u.eprint(u.f1("axiom: cannot write %s\n", x.path));
            return false;
        }
    }
    return true;
}

/// Gives back the objects of the parts, once linked.
pub fn release_objects() void {
    for x in g_mem_objects.items() {
        u.free_heap(x.bytes);
    }
    g_mem_objects.clear();
}

fn no_wide(v: *mut ir.Value) bool {
    return false;
}

pub fn emit_module(m: *mut ir.Module, opt_level: i32, emit: i32, path: []u8) bool {
    let raw = (emit == EMIT_IR) and not u.isnos(u.env("AXIOM_IR_RAW"));
    ir.cur_src = 0;  // (instructions passes make take their location from where they go)
    ir.cur_scope = 0;
    ir.merge_same_named(m);
    tg.g_opt_level = opt_level;
    dbi.locations = opt_level == 0;
    // (optimized code: the variables' values are followed through the passes)
    ir.dbg_on = (opt_level > 0) and (tg.g_debug == tg.DEBUG_FULL);
    ir.dbg_scopes = tg.g_debug != tg.DEBUG_NONE;
    if not raw {
        lower.lower_module(m);
        u.phase("lower");
        passes.optimize_module(m, opt_level);
    }
    let native = (emit != EMIT_IR) and ((tg.g_arch == tg.ARCH_X64) or (tg.g_arch == tg.ARCH_A64));
    // (the IR dumps are of the whole module, in one process)
    let dumps = not u.isnos(u.env("AXIOM_DUMP_IR")) or not u.isnos(u.env("AXIOM_DUMP_SPLIT"));
    if native and g_parts and not raw and not dumps {
        let st = compile_parts(m, opt_level, path);
        if st >= 0 {
            ir.dbg_release();  // (the parts made the code: the link needs none of it)
            return st == 1;
        }
    }
    if not raw {
        passes.finish_module(m, opt_level);
    }
    check_ir(m);
    let dump = u.env("AXIOM_DUMP_IR");  // debugging: the optimized IR of every compilation
    if not u.isnos(dump) {
        _ = u.write_file(dump, ir.module_str(m));
    }
    if emit != EMIT_IR {
        split_vectors(m);
        let sdump = u.env("AXIOM_DUMP_SPLIT");  // debugging: the IR after vectors are split
        if not u.isnos(sdump) {
            _ = u.write_file(sdump, ir.module_str(m));
        }
    }
    if emit == EMIT_IR {
        if not u.write_file(path, ir.module_str(m)) {
            u.eprint(u.f1("axiom: cannot write %s\n", path));
            return false;
        }
        return true;
    }
    if tg.is_wasm() {
        for i in 0..m.funcs.len {
            let f = m.funcs.get(i);
            if not ir.is_decl(f) {
                lower.expand_mul_overflow(f);
            }
        }
        let un = wa.compile(m, tg.g_arch == tg.ARCH_WASM64);
        if u.isnil(un) {
            return false;
        }
        if (g_keep_path.len > 0) and u.str_eq(path, g_keep_path) {
            g_kept_unit = un;  // (linked as it is: main.ax)
            return true;
        }
        return write_unit(un, path);
    }
    if native {
        defer u.phase("machine code");
        return native_obj(m, path);
    }
    u.eprint("axiom: code generation for this target is not implemented yet\n");
    return false;
}

// The object of un at path, and un's code and data given back.
pub fn write_unit(un: *mut wo.Unit, path: []u8) bool {
    let wrote = u.write_file(path, wo.write_object(un));
    release_unit(un);
    if not wrote {
        u.eprint(u.f1("axiom: cannot write %s\n", path));
    }
    return wrote;
}

// Gives back the code and data of a unit that has been written out.
fn release_unit(un: *mut wo.Unit) void {
    for k in 0..un.funcs.len {
        let f = un.funcs.get(k);
        f.body.free();
        f.body = bn.new_bytes();
        f.relocs.deinit();
        f.relocs = u.List.[wo.Reloc].empty();
    }
    for k in 0..un.segs.len {
        let s = un.segs.get(k);
        s.data.free();
        s.data = bn.new_bytes();
        s.relocs.deinit();
        s.relocs = u.List.[wo.Reloc].empty();
    }
}

// Debugging (AXIOM_CHECK_CINTS, AXIOM_CHECK_IR): the IR's invariants.
fn check_ir(m: *mut ir.Module) void {
    if not u.isnos(u.env("AXIOM_CHECK_CINTS")) {
        ir.check_cints();
    }
    if not u.isnos(u.env("AXIOM_CHECK_IR")) {
        ir.check_order(m);
        for i in 0..m.funcs.len {
            ir.check_uses(m.funcs.get(i));
        }
    }
}

// Vectors wider than the target computes: in pieces (x86-64 with AVX2 or
// AVX-512 keeps what it can, in each function's extensions).
fn split_vectors(m: *mut ir.Module) void {
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if not ir.is_decl(f) {
            let saved = tg.begin_fn(f);
            if tg.g_arch == tg.ARCH_X64 {
                vsplit.split_wide(f, x64c.vector_bits(), xsd.wide_legal);
            } else {
                vsplit.split_wide(f, 128, no_wide);
            }
            tg.end_fn(saved);
        }
    }
    u.phase("split vectors");
}

// The machine code of m's functions, as an object at path.
fn native_obj(m: *mut ir.Module, path: []u8) bool {
    let bytes = native_bytes(m, path);
    if u.isnos(bytes) {
        return false;
    }
    let wrote = u.write_file(path, bytes);
    u.free_heap(bytes);
    if not wrote {
        u.eprint(u.f1("axiom: cannot write %s\n", path));
        return false;
    }
    return true;
}

// The machine code of m's functions, the bytes of the object for path
// (u.free_heap), or a nil slice if they cannot be made (and why is
// reported).
fn native_bytes(m: *mut ir.Module, path: []u8) []u8 {
    let mut o = u.nil.[elf.Obj]();
    if tg.g_arch == tg.ARCH_X64 {
        o = x64.compile(m);
    } else {
        o = a64.compile(m);
    }
    u.scratch_release();
    if u.isnil(o) {
        return u.nosym();
    }
    if g_stubs {
        // (weak: several objects may each have them, and a program one set)
        let st = lstub.build(o.machine, false);
        for i in 0..st.syms.len {
            let sy = st.syms.at(i);
            if (sy.sec >= 0) and (sy.bind == elf.B_GLOBAL) {
                sy.bind = elf.B_WEAK;
            }
        }
        elf.merge(o, st);
    }
    let mut bytes: []u8 = "";
    if g_native_format and tg.is_darwin() {
        bytes = mo.write(o);
        if bytes.len == 0 {
            u.eprint(u.f2("axiom: cannot write %s as a Mach-O object: %s\n", path, mo.g_error));
            return u.nosym();
        }
    } else if g_native_format and tg.is_windows() {
        bytes = coff.write(o);
        if bytes.len == 0 {
            u.eprint(u.f2("axiom: cannot write %s as a COFF object: %s\n", path, coff.g_error));
            return u.nosym();
        }
    } else {
        bytes = elf.write(o);
        if g_pack {
            let p = ep.pack(bytes);
            if not u.isnos(p) {
                u.free_heap(bytes);
                bytes = p;
            }
        }
    }
    elf.release(o);
    return bytes;
}

// -----------------------------------------------------------------------------
// Machine code in parts
//
// After inlining, the functions are dealt out to parts of about PART_SIZE
// work each (part_weight; at most MAX_PARTS of them), each finished (the
// passes that see one function at a time: passes.finish_funcs) and compiled
// on a thread of its own to an object: the first part's at path, with all
// of the data, the others' at <path>.p<k>.o, with the functions of the
// other parts and the data as external symbols. So that they can refer to
// each other, the module's internal functions and data become global
// symbols, under names made unique (isel.add_symbols: two modules may each
// have a function of the same name, and string constants share theirs).
// The parts share the module: each changes its own functions, and sees the
// rest as it was when the parts began (ir.part_begin: the other parts'
// functions defined to the passes, declared to the code generator), and
// starts from what the passes' tables held then (part_state), as a process
// forked then would. How the functions are cut depends only on the
// program, not on the machine's processors, so the executable is the same
// wherever it is built, whatever the number of threads.
// -----------------------------------------------------------------------------
const PART_SIZE: i64 = 200000;
const MAX_PARTS: i64 = 4;
const SLICES: i64 = 8;

// What every part's thread starts from (the thread that made the module
// does nothing else while they run).
struct PartsStart {
    us: u.WorkerStart,
    ir: *mut ir.PartStart,
    features: u64,
    nfuncs: usize,
    nglobals: usize,
    blobs: ai.Blobs,
    toplevel: ai.Blobs,
    dbi: dbi.PartState,
    thr: thr.PartState,
    opt: opt.PartState,
    lopt: lopt.PartState,
    gvn: i32,
    loops: i64,
    unr: i64,
    idioms: i64,
    vec: i64,
    outl: i64,
    ret01: u.List.[bool],
    kept: u.List.[u64],
}

fn parts_start(ps: *mut ir.PartStart, m: *ir.Module) *mut PartsStart {
    let s = u.new.[PartsStart]();
    s.* = PartsStart.{ us: u.worker_start(), ir: ps, features: tg.g_features, nfuncs: m.funcs.len,
                       nglobals: m.globals.len, blobs: ai.blobs, toplevel: ai.toplevel, dbi: dbi.part_state(),
                       thr: thr.part_state(), opt: opt.part_state(), lopt: lopt.part_state(), gvn: gvn.part_state(),
                       loops: loops.part_state(), unr: unr.part_state(), idioms: idioms.part_state(),
                       vec: vec.part_state(), outl: outl.part_state(), ret01: tre.part_state(),
                       kept: slots.part_state() };
    return s;
}

// A part, and how it went.
struct Part {
    m: *mut ir.Module,
    level: i32,
    k: usize,
    mine: []mut bool,  // by function: its own
    path: []u8,
    st: *PartsStart,
    ok: bool,
    obj: []u8,  // its object (outside the thread's memory: u.keep_dup)
    done: u32,  // 1 once ok and obj are set
}

// The parts of this build that are done (Part.done), for the thread that
// started them to wait on.
let mut parts_done: u32 = 0;

// 1 if the parts compiled, 0 if one failed (and reported why), -1 if the
// module is too small to cut or threads cannot be made: then nothing was
// done.
fn compile_parts(m: *mut ir.Module, level: i32, path: []u8) i32 {
    let mut total: i64 = 0;
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if not ir.is_decl(f) {
            total += part_weight(f);
        }
    }
    let np = u.env_num("AXIOM_PARTS", @min(total / PART_SIZE, MAX_PARTS));
    if (np < 2) or (total <= 0) {
        return -1;
    }
    // Local symbols that asm defines (named labels) are found by name from
    // C and other asm in the object only (asm/obj.ax: resolve), which the
    // parts would cut apart: such a module is one unit. (Asm naming the
    // internal functions and data finds them in any part: isel.part_sym.)
    for b in ai.blobs.items() {
        if b.locals {
            return -1;
        }
    }
    for b in ai.toplevel.items() {
        if b.locals {
            return -1;
        }
    }
    // The functions in order, cut into SLICES runs of about the same work
    // per part, dealt out in turn: part k has runs k, k + np, k + 2np, ...
    // (so that a few big functions together do not make one part slow).
    let n = @int_cast(usize, np);
    let runs = np * SLICES;
    let parts = u.newn.[Part](n);
    for k in 0..n {
        parts[k] = Part.{ m: m, level: level, k: k, mine: u.newn.[bool](m.funcs.len + 1)[0..m.funcs.len],
                          path: part_path(path, k), st: u.nil.[PartsStart](), ok: false, obj: u.nosym(), done: 0 };
    }
    let mut acc: i64 = 0;
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        let r = @min((acc * runs) / total, runs - 1);
        parts[@int_cast(usize, r % np)].mine[i] = true;
        if not ir.is_decl(f) {
            acc += part_weight(f);
        }
    }
    ir.dbg_compact();
    let ps = ir.part_start(m);
    if u.isnil(ps) {
        if u.env_num("AXIOM_CHECK_PARTS", 0) > 0 {
            u.eprint("axiom: the module cannot be cut into parts\n");
        }
        return -1;
    }
    if level >= 2 {
        tre.prepare_sibling(m);  // (from the IR as it is now: every part finds the same)
    }
    let st = parts_start(ps, m);
    for k in 0..n {
        parts[k].st = st;
    }
    let check = u.env_num("AXIOM_CHECK_PARTS", 0);
    if check > 0 {
        return check_parts(m, parts, check == 2);
    }
    // `width` at a time, the results taken in order
    let width = @min(u.jobs(), n);
    @atomic_store(&mut parts_done, 0);
    let mut running = u.List.[thread.Thread.[*mut Part]].empty();
    let mut taken: usize = 0;
    let mut ok = true;
    loop {
        let done = @atomic_load(&parts_done);
        while ok and (running.len < n) and ((running.len - @as(usize, done)) < width) {
            let t = thread.spawn(run_part, &mut parts[running.len]) catch {
                if running.len == 0 {
                    return -1;  // (in one piece after all)
                }
                ok = false;
                break;
            };
            running.push(t);
        }
        while (taken < running.len) and (@atomic_load(&parts[taken].done) == 1) {
            running.get(taken).join();
            if not parts[taken].ok {
                ok = false;
            }
            taken += 1;
        }
        if (taken == running.len) and (not ok or (taken == n)) {
            break;
        }
        _ = @atomic_wait(&parts_done, done, -1);
    }
    running.deinit();
    u.phase("parts: finish, split vectors, machine code");
    return parts_done_with(parts[0..taken], ok);
}

// The objects of the parts, which have all compiled if ok: kept for the
// link (g_mem_objects, g_part_objs); 1 if ok, else 0.
fn parts_done_with(parts: []mut Part, ok: bool) i32 {
    g_part_objs.clear();
    for k in 0..parts.len {
        let p = &mut parts[k];
        if ok {
            g_mem_objects.push(MemObject.{ path: p.path, bytes: p.obj });
            if k > 0 {
                g_part_objs.push(p.path);
            }
        } else if not u.isnos(p.obj) {
            u.free_heap(p.obj);
        }
    }
    if ok {
        return 1;
    }
    return 0;
}

// Debugging (AXIOM_CHECK_PARTS=1, or 2 for the last part first): the parts
// one at a time, and after each what it changed of the module but its own
// functions (ir.watch_check), which the threads of the others would see.
fn check_parts(m: *mut ir.Module, parts: []mut Part, backwards: bool) i32 {
    let w = ir.watch_module(m);
    let d = &parts[0].st.dbi;
    ir.watch_more(w, @int_from_ptr(d.scopes.data), d.scopes.len * @size_of(dbi.DScope), "debug scopes");
    ir.watch_more(w, @int_from_ptr(d.types.data), d.types.len * @size_of(dbi.DType), "debug types");
    ir.watch_more(w, @int_from_ptr(d.globals.data), d.globals.len * @size_of(dbi.DVar), "debug globals");
    let vs = @slice_from_ptr(d.vars.vals, d.vars.cap);
    for j in 0..d.vars.cap {
        if u.notnil(vs[j]) {
            ir.watch_more(w, @int_from_ptr(vs[j].data), vs[j].len * @size_of(dbi.DVar), "debug variables");
        }
    }
    let bl = parts[0].st.blobs;
    ir.watch_more(w, @int_from_ptr(bl.data), bl.len * 8, "asm statements");
    let mut bad: usize = 0;
    for j in 0..parts.len {
        let mut k = j;
        if backwards {
            k = parts.len - 1 - j;
        }
        let t = thread.spawn(run_part, &mut parts[k]) catch {
            return -1;
        };
        t.join();
        bad += ir.watch_check(w, k, parts[k].mine);
        if not parts[k].ok {
            return parts_done_with(parts, false);
        }
    }
    if bad > 0 {
        u.eprint(u.f1("axiom: the parts changed %s places of what they share\n", u.zdec(bad)));
    }
    return parts_done_with(parts, true);
}

// The work f's part takes for it, roughly: more than in proportion to its
// size, as the passes' work is in big functions.
fn part_weight(f: *ir.Func) i64 {
    let n = @as(f64, @float_from_int(f64, f.nvals));
    return @int_from_float(i64, n * @sqrt(n) / 16.0);
}

fn part_path(path: []u8, k: usize) []u8 {
    if k == 0 {
        return path;
    }
    return u.f2("%s.p%s.o", path, u.zdec(k));
}

// On the thread of part p.
fn run_part(p: *mut Part) void {
    u.worker_begin(&p.st.us);
    let s = p.st;
    tg.g_features = s.features;
    is.g_shared_funcs = s.nfuncs;
    is.g_shared_globals = s.nglobals;
    ai.blobs = s.blobs;
    if p.k == 0 {
        ai.toplevel = s.toplevel;  // (file-scope asm: the first part's)
    }
    dbi.part_begin(&s.dbi);
    thr.part_begin(&s.thr);
    opt.part_begin(&s.opt);
    lopt.part_begin(&s.lopt);
    gvn.part_begin(s.gvn);
    loops.part_begin(s.loops);
    unr.part_begin(s.unr);
    idioms.part_begin(s.idioms);
    vec.part_begin(s.vec);
    outl.part_begin(s.outl);
    tre.part_begin(&s.ret01);
    slots.part_begin(&s.kept);
    ir.part_begin(s.ir, p.mine, p.k == 0);
    let m = ir.part_module(p.m);
    let obj = compile_part(m, p.level, p.mine, p.path);
    p.ok = not u.isnos(obj);
    if p.ok {
        p.obj = u.keep_dup(obj);
    }
    u.worker_end();
    @atomic_store(&mut p.done, 1);
    _ = @atomic_add(&mut parts_done, 1);
    _ = @atomic_notify(&parts_done, 0xFFFF_FFFF);
}

// In a part: its own functions (mine), finished and compiled: the object's
// bytes (for path), or a nil slice if it failed.
fn compile_part(m: *mut ir.Module, level: i32, mine: []bool, path: []u8) []u8 {
    passes.finish_funcs(m, level, mine);
    check_part(m, mine);
    ir.part_declare_others();
    split_vectors(m);
    return native_bytes(m, path);
}

// check_ir, of a part's own functions.
fn check_part(m: *mut ir.Module, mine: []bool) void {
    if not u.isnos(u.env("AXIOM_CHECK_CINTS")) {
        ir.check_cints();
    }
    if not u.isnos(u.env("AXIOM_CHECK_IR")) {
        for i in 0..m.funcs.len {
            if (i >= mine.len) or mine[i] {
                ir.check_order_of(m.funcs.get(i));
                ir.check_uses(m.funcs.get(i));
            }
        }
    }
}
