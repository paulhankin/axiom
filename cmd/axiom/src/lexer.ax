// =============================================================================
// lexer.ax - tokens and the tokenizer (maximal munch, whole file up front).
// =============================================================================
import "diag.ax" as dg;
import "util.ax" as u;

// Token kinds: the operators' are an expression's op (ast.Expr.op).
pub enum TokKind: i32 {
    NONE = -1,  // no token (fmt.ax: a comment it keeps among them, or none)
    EOF = 0,
    IDENT = 1,
    INT = 2,
    FLOAT = 3,
    STRING = 4,
    CHAR = 5,
    BUILTIN = 6,
    DISCARD = 7,
    PRIM = 8,
    AND = 9,
    AS = 10,
    BREAK = 11,
    CATCH = 12,
    CONST = 13,
    CONTINUE = 14,
    DEFER = 15,
    ELSE = 16,
    ENUM = 17,
    ERRDEFER = 18,
    ERROR = 19,
    EXPORT = 20,
    EXTERN = 21,
    FALSE = 22,
    FN = 23,
    FOR = 24,
    HOST = 25,
    IF = 26,
    IMPORT = 27,
    IN = 28,
    LET = 29,
    LOOP = 30,
    MATCH = 31,
    MUT = 32,
    NOT = 33,
    OR = 34,
    PUB = 35,
    RETURN = 36,
    SELF = 37,
    STRUCT = 38,
    TEST = 39,
    TRUE = 40,
    UNION = 41,
    WHILE = 42,
    PLUS = 43,
    MINUS = 44,
    STAR = 45,
    SLASH = 46,
    PERCENT = 47,
    PLUS_PCT = 48,
    MINUS_PCT = 49,
    STAR_PCT = 50,
    AMP = 51,
    PIPE = 52,
    CARET = 53,
    TILDE = 54,
    SHL = 55,
    SHR = 56,
    EQEQ = 57,
    NE = 58,
    LT = 59,
    LE = 60,
    GT = 61,
    GE = 62,
    EQ = 63,
    PLUS_EQ = 64,
    MINUS_EQ = 65,
    STAR_EQ = 66,
    SLASH_EQ = 67,
    PERCENT_EQ = 68,
    PLUS_PCT_EQ = 69,
    MINUS_PCT_EQ = 70,
    STAR_PCT_EQ = 71,
    AMP_EQ = 72,
    PIPE_EQ = 73,
    CARET_EQ = 74,
    SHL_EQ = 75,
    SHR_EQ = 76,
    BANG = 77,
    DOT = 78,
    DOTDOT = 79,
    ELLIPSIS = 80,
    COMMA = 81,
    COLON = 82,
    SEMI = 83,
    FATARROW = 84,
    LPAREN = 85,
    RPAREN = 86,
    LBRACE = 87,
    RBRACE = 88,
    LBRACKET = 89,
    RBRACKET = 90,
}

