pub fn prim_name(i: usize) []u8 {
    let t = ["u8", "u16", "u32", "u64", "usize", "i8", "i16", "i32", "i64", "isize", "f32", "f64", "bool", "void",
             "i8x16", "u8x16", "i16x8", "u16x8", "i32x4", "u32x4", "i64x2", "u64x2", "f32x4", "f64x2", "v128", "i8x32",
             "u8x32", "i16x16", "u16x16", "i32x8", "u32x8", "i64x4", "u64x4", "f32x8", "f64x4", "v256", "i8x64",
             "u8x64", "i16x32", "u16x32", "i32x16", "u32x16", "i64x8", "u64x8", "f32x16", "f64x8", "v512"];
    return t[i];
}
pub fn kw_name(i: usize) []u8 {
    let t = ["and", "as", "break", "catch", "const", "continue", "defer", "else", "enum", "errdefer", "error", "export",
             "extern", "false", "fn", "for", "host", "if", "import", "in", "let", "loop", "match", "mut", "not", "or",
             "pub", "return", "Self", "struct", "test", "true", "union", "while"];
    return t[i];
}
pub fn punct_name(i: usize) []u8 {
    let t = ["+", "-", "*", "/", "%", "+%", "-%", "*%", "&", "|", "^", "~", "<<", ">>", "==", "!=", "<", "<=", ">",
             ">=", "=", "+=", "-=", "*=", "/=", "%=", "+%=", "-%=", "*%=", "&=", "|=", "^=", "<<=", ">>=", "!", ".",
             "..", "...", ",", ":", ";", "=>", "(", ")", "{", "}", "[", "]"];
    return t[i];
}

pub fn tok_kind_name(k: TokKind) []u8 {
    if k == TK_EOF {
        return "end of file";
    }
    if k == TK_IDENT {
        return "identifier";
    }
    if k == TK_INT {
        return "integer literal";
    }
    if k == TK_FLOAT {
        return "float literal";
    }
    if k == TK_STRING {
        return "string literal";
    }
    if k == TK_CHAR {
        return "character literal";
    }
    if k == TK_BUILTIN {
        return "builtin";
    }
    if k == TK_DISCARD {
        return "_";
    }
    if k == TK_PRIM {
        return "type name";
    }
    if tok_between(k, KW_AND, KW_WHILE) {
        return kw_name(@int_cast(usize, @int_from_enum(k) - @int_from_enum(KW_AND)));
    }
    if tok_between(k, TK_PLUS, TK_RBRACKET) {
        return punct_name(@int_cast(usize, @int_from_enum(k) - @int_from_enum(TK_PLUS)));
    }
    return "?";
}

pub struct Token {
    kind: TokKind,
    span: u.Span,
    ival: u64,         // TK_INT, TK_CHAR
    fval: f64,         // TK_FLOAT
    name: []u8,        // TK_IDENT, TK_BUILTIN
    prim: i32,         // TK_PRIM
    str: []u8,         // TK_STRING
    float_text: []u8,  // TK_FLOAT: literal text without '_'
}

fn tok(kind: TokKind, sp: u.Span) Token {
    return Token.{ kind: kind, span: sp, ival: 0, fval: 0.0, name: u.nosym(), prim: 0, str: u.nosym(),
                   float_text: u.nosym() };
}

struct Lexer {
    f: *mut u.SourceFile,
    s: []u8,
    pos: usize,
    toks: u.List.[Token],
}

fn mkspan(L: *Lexer, a: usize, b: usize) u.Span {
    return u.mkspan(L.f.id, @int_cast(u32, a), @int_cast(u32, b));
}

fn is_ident_start(c: u8) bool {
    return ((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z')) or (c == '_');
}

pub fn is_ident_char(c: u8) bool {
    return is_ident_start(c) or ((c >= '0') and (c <= '9'));
}

fn hexval(c: u8) i32 {
    if (c >= '0') and (c <= '9') {
        return @as(i32, c - '0');
    }
    if (c >= 'a') and (c <= 'f') {
        return @as(i32, c - 'a') + 10;
    }
    if (c >= 'A') and (c <= 'F') {
        return @as(i32, c - 'A') + 10;
    }
    return -1;
}

fn at(L: *Lexer, i: usize) u8 {
    if i < L.s.len {
        return L.s[i];
    }
    return 0;
}

fn skip_ws(L: *mut Lexer) void {
    loop {
        if L.pos >= L.s.len {
            return;
        }
        let c = L.s[L.pos];
        if (c == ' ') or (c == '\t') or (c == '\n') or (c == '\r') {
            L.pos += 1;
        } else if (c == '/') and ((L.pos + 1) < L.s.len) and (L.s[L.pos + 1] == '/') {
            while (L.pos < L.s.len) and (L.s[L.pos] != '\n') {
                L.pos += 1;
            }
        } else {
            return;
        }
    }
}

// Decodes one escape sequence starting at the backslash; appends UTF-8 bytes.
fn lex_escape(L: *mut Lexer, out: *mut u.Buf, ascii_only: bool) void {
    let start = L.pos;
    L.pos += 1;
    if L.pos >= L.s.len {
        _ = dg.err(mkspan(L, start, L.pos), "E0006", "unterminated escape sequence");
        return;
    }
    let c = L.s[L.pos];
    L.pos += 1;
    if c == 'n' {
        out.c('\n');
        return;
    }
    if c == 'r' {
        out.c('\r');
        return;
    }
    if c == 't' {
        out.c('\t');
        return;
    }
    if c == '0' {
        out.c(0);
        return;
    }
    if c == '\\' {
        out.c('\\');
        return;
    }
    if c == '"' {
        out.c('"');
        return;
    }
    if c == '\'' {
        out.c('\'');
        return;
    }
    if c == 'x' {
        let mut a: i32 = -1;
        let mut b: i32 = -1;
        if L.pos < L.s.len {
            a = hexval(L.s[L.pos]);
        }
        if (L.pos + 1) < L.s.len {
            b = hexval(L.s[L.pos + 1]);
        }
        if (a < 0) or (b < 0) {
            _ = dg.err(mkspan(L, start, L.pos), "E0006", "\\x escape needs two hex digits");
            return;
        }
        L.pos += 2;
        out.c(@int_cast(u8, (a * 16) + b));
        return;
    }
    if c == 'u' {
        if (L.pos >= L.s.len) or (L.s[L.pos] != '{') {
            _ = dg.err(mkspan(L, start, L.pos), "E0006", "\\u escape must be written \\u{HEX}");
            return;
        }
        L.pos += 1;
        let mut cp: u32 = 0;
        let mut nd: i32 = 0;
        while (L.pos < L.s.len) and (hexval(L.s[L.pos]) >= 0) {
            cp = (cp *% 16) +% @int_cast(u32, hexval(L.s[L.pos]));
            L.pos += 1;
            nd += 1;
            if nd > 6 {
                break;
            }
        }
        if (L.pos >= L.s.len) or (L.s[L.pos] != '}') or (nd == 0) or (cp > 0x10FFFF) or
           ((cp >= 0xD800) and (cp <= 0xDFFF)) {
            _ = dg.err(mkspan(L, start, L.pos), "E0006", "invalid \\u{...} escape");
            return;
        }
        L.pos += 1;
        if ascii_only and (cp > 0x7F) {
            _ = dg.err(mkspan(L, start, L.pos), "E0004", "character literal must be ASCII");
            return;
        }
        if cp < 0x80 {
            out.c(@truncate(u8, cp));
        } else if cp < 0x800 {
            out.c(@truncate(u8, 0xC0 | (cp >> 6)));
            out.c(@truncate(u8, 0x80 | (cp & 0x3F)));
        } else if cp < 0x10000 {
            out.c(@truncate(u8, 0xE0 | (cp >> 12)));
            out.c(@truncate(u8, 0x80 | ((cp >> 6) & 0x3F)));
            out.c(@truncate(u8, 0x80 | (cp & 0x3F)));
        } else {
            out.c(@truncate(u8, 0xF0 | (cp >> 18)));
            out.c(@truncate(u8, 0x80 | ((cp >> 12) & 0x3F)));
            out.c(@truncate(u8, 0x80 | ((cp >> 6) & 0x3F)));
            out.c(@truncate(u8, 0x80 | (cp & 0x3F)));
        }
        return;
    }
    let one = [c];
    _ = dg.err(mkspan(L, start, L.pos), "E0006", u.f1("unknown escape sequence '\\%s'", one[..]));
}

// Whether c is a digit in a literal of the base (2 and 8 take any decimal
// digit here: a digit too large for them is reported separately).
fn is_digit_of(c: u8, base: u64) bool {
    if base == 16 {
        return hexval(c) >= 0;
    }
    return (c >= '0') and (c <= '9');
}

fn lex_number(L: *mut Lexer) void {
    let start = L.pos;
    let s = L.s;
    let mut base: u64 = 10;
    if (s[L.pos] == '0') and ((L.pos + 1) < s.len) and
       ((s[L.pos + 1] == 'x') or (s[L.pos + 1] == 'b') or (s[L.pos + 1] == 'o')) {
        if s[L.pos + 1] == 'x' {
            base = 16;
        } else if s[L.pos + 1] == 'b' {
            base = 2;
        } else {
            base = 8;
        }
        L.pos += 2;
    }
    let mut buf: [128]u8 = [0; 128];
    let mut bl: usize = 0;
    let mut is_float = false;
    let mut bad = false;
    let mut long = false;  // (characters past the 120 kept)
    loop {
        if L.pos >= s.len {
            break;
        }
        let c = s[L.pos];
        if c == '_' {
            // only between two digits (spec §2.5)
            if not is_digit_of(s[L.pos - 1], base) or ((L.pos + 1) == s.len) or not is_digit_of(s[L.pos + 1], base) {
                bad = true;
            }
            L.pos += 1;
            continue;
        }
        let v = hexval(c);
        let mut digit = (c >= '0') and (c <= '9');
        if base == 16 {
            digit = v >= 0;
        }
        if digit {
            if (base == 2) and (c > '1') {
                bad = true;
            }
            if (base == 8) and (c > '7') {
                bad = true;
            }
            if bl < 120 {
                buf[bl] = c;
                bl += 1;
            } else {
                long = true;
            }
            L.pos += 1;
            continue;
        }
        if (base == 10) and (c == '.') and ((L.pos + 1) < s.len) and (s[L.pos + 1] >= '0') and (s[L.pos + 1] <= '9') and
           not is_float {
            is_float = true;
            if bl < 120 {
                buf[bl] = c;
                bl += 1;
            } else {
                long = true;
            }
            L.pos += 1;
            continue;
        }
        if (base == 10) and ((c == 'e') or (c == 'E')) {
            let mut p = L.pos + 1;
            if (p < s.len) and ((s[p] == '+') or (s[p] == '-')) {
                p += 1;
            }
            if (p < s.len) and (s[p] >= '0') and (s[p] <= '9') {
                is_float = true;
                if bl < 120 {
                    buf[bl] = 'e';
                    bl += 1;
                } else {
                    long = true;
                }
                L.pos += 1;
                if (at(L, L.pos) == '+') or (at(L, L.pos) == '-') {
                    if bl < 120 {
                        buf[bl] = s[L.pos];
                        bl += 1;
                    } else {
                        long = true;
                    }
                    L.pos += 1;
                }
                continue;
            }
        }
        break;
    }
    if (L.pos < s.len) and is_ident_char(s[L.pos]) {
        while (L.pos < s.len) and is_ident_char(s[L.pos]) {
            L.pos += 1;
        }
        bad = true;
    }
    let mut t = tok(TK_INT, mkspan(L, start, L.pos));
    if bad or (bl == 0) {
        _ = dg.err(t.span, "E0005", "malformed number literal");
        L.toks.push(t);
        return;
    }
    if long {
        _ = dg.err(t.span, "E0005", "number literal longer than 120 characters");
        L.toks.push(t);
        return;
    }
    if is_float {
        t.kind = TK_FLOAT;
        t.float_text = u.dup(buf[0..bl]);
        t.fval = u.parse_f64(t.float_text);
    } else {
        let mut v: u64 = 0;
        let mut ovf = false;
        for i in 0..bl {
            let d = @int_cast(u64, hexval(buf[i]));
            if v > ((0xFFFF_FFFF_FFFF_FFFF - d) / base) {
                ovf = true;
            }
            v = (v *% base) +% d;
        }
        if ovf {
            _ = dg.err(t.span, "E0005", "integer literal does not fit in 64 bits");
        }
        t.ival = v;
    }
    L.toks.push(t);
}

// Operators for maximal munch, longest first.
struct OpTok {
    s: []u8,
    k: TokKind,
}

fn op_table() [48]OpTok {
    return [OpTok.{ s: "...", k: TK_ELLIPSIS }, OpTok.{ s: "+%=", k: TK_PLUS_PCT_EQ },
            OpTok.{ s: "-%=", k: TK_MINUS_PCT_EQ }, OpTok.{ s: "*%=", k: TK_STAR_PCT_EQ },
            OpTok.{ s: "<<=", k: TK_SHL_EQ }, OpTok.{ s: ">>=", k: TK_SHR_EQ }, OpTok.{ s: "+%", k: TK_PLUS_PCT },
            OpTok.{ s: "-%", k: TK_MINUS_PCT }, OpTok.{ s: "*%", k: TK_STAR_PCT }, OpTok.{ s: "<<", k: TK_SHL },
            OpTok.{ s: ">>", k: TK_SHR }, OpTok.{ s: "==", k: TK_EQEQ }, OpTok.{ s: "!=", k: TK_NE },
            OpTok.{ s: "<=", k: TK_LE }, OpTok.{ s: ">=", k: TK_GE }, OpTok.{ s: "+=", k: TK_PLUS_EQ },
            OpTok.{ s: "-=", k: TK_MINUS_EQ }, OpTok.{ s: "*=", k: TK_STAR_EQ }, OpTok.{ s: "/=", k: TK_SLASH_EQ },
            OpTok.{ s: "%=", k: TK_PERCENT_EQ }, OpTok.{ s: "&=", k: TK_AMP_EQ }, OpTok.{ s: "|=", k: TK_PIPE_EQ },
            OpTok.{ s: "^=", k: TK_CARET_EQ }, OpTok.{ s: "..", k: TK_DOTDOT }, OpTok.{ s: "=>", k: TK_FATARROW },
            OpTok.{ s: "+", k: TK_PLUS }, OpTok.{ s: "-", k: TK_MINUS }, OpTok.{ s: "*", k: TK_STAR },
            OpTok.{ s: "/", k: TK_SLASH }, OpTok.{ s: "%", k: TK_PERCENT }, OpTok.{ s: "&", k: TK_AMP },
            OpTok.{ s: "|", k: TK_PIPE }, OpTok.{ s: "^", k: TK_CARET }, OpTok.{ s: "~", k: TK_TILDE },
            OpTok.{ s: "<", k: TK_LT }, OpTok.{ s: ">", k: TK_GT }, OpTok.{ s: "=", k: TK_EQ },
            OpTok.{ s: "!", k: TK_BANG }, OpTok.{ s: ".", k: TK_DOT }, OpTok.{ s: ",", k: TK_COMMA },
            OpTok.{ s: ":", k: TK_COLON }, OpTok.{ s: ";", k: TK_SEMI }, OpTok.{ s: "(", k: TK_LPAREN },
            OpTok.{ s: ")", k: TK_RPAREN }, OpTok.{ s: "{", k: TK_LBRACE }, OpTok.{ s: "}", k: TK_RBRACE },
            OpTok.{ s: "[", k: TK_LBRACKET }, OpTok.{ s: "]", k: TK_RBRACKET }];
}

pub const N_KEYWORDS: usize = 34;  // KW_AND ... KW_WHILE
const N_RESERVED_FUTURE: usize = 10;

fn reserved_future(i: usize) []u8 {
    let t = ["async", "await", "comptime", "impl", "interface", "null", "trait", "type", "unsafe", "yield"];
    return t[i];
}

fn is_reserved_future(w: []u8) bool {
    for i in 0..N_RESERVED_FUTURE {
        if u.str_eq(reserved_future(i), w) {
            return true;
        }
    }
    return false;
}

// The keyword W is (KW_*), or TK_IDENT.
fn keyword(w: []u8) TokKind {
    for i in 0..N_KEYWORDS {
        if u.str_eq(kw_name(i), w) {
            return @enum_from_int(TokKind, @int_from_enum(KW_AND) + @int_cast(i32, i));
        }
    }
    return TK_IDENT;
}

// The primitive type W names (an index for prim_name), or -1.
fn prim_index(w: []u8) i32 {
    for i in 0..@int_cast(usize, PRIM_COUNT) {
        if u.str_eq(prim_name(i), w) {
            return @int_cast(i32, i);
        }
    }
    return -1;
}

// True if W cannot be an identifier: a keyword, a primitive type, a word
// reserved for future use, or `_`.
pub fn is_reserved(w: []u8) bool {
    return (keyword(w) != TK_IDENT) or (prim_index(w) >= 0) or is_reserved_future(w) or u.str_eq(w, "_");
}

// = and the compound assignments (+= ... >>=).
pub fn is_assign_op(k: TokKind) bool {
    return (k == TK_EQ) or tok_between(k, TK_PLUS_EQ, TK_SHR_EQ);
}

// == != < <= > >=
pub fn is_compare_op(k: TokKind) bool {
    return tok_between(k, TK_EQEQ, TK_GE);
}

// Is k one of lo .. hi (in their order here)?
pub fn tok_between(k: TokKind, lo: TokKind, hi: TokKind) bool {
    let i = @int_from_enum(k);
    return (i >= @int_from_enum(lo)) and (i <= @int_from_enum(hi));
}

// The length of the well-formed UTF-8 sequence at s[i] (a byte >= 0x80): no
// overlong forms, surrogates or code points above U+10FFFF. 0 if there is none.
fn utf8_len(s: []u8, i: usize) usize {
    let c = s[i];
    let mut n: usize = 0;
    let mut lo: u8 = 0x80;
    let mut hi: u8 = 0xBF;
    if (c >= 0xC2) and (c <= 0xDF) {
        n = 2;
    } else if (c >= 0xE0) and (c <= 0xEF) {
        n = 3;
        if c == 0xE0 {
            lo = 0xA0;
        } else if c == 0xED {
            hi = 0x9F;
        }
    } else if (c >= 0xF0) and (c <= 0xF4) {
        n = 4;
        if c == 0xF0 {
            lo = 0x90;
        } else if c == 0xF4 {
            hi = 0x8F;
        }
    } else {
        return 0;
    }
    if n > (s.len - i) {
        return 0;
    }
    if (s[i + 1] < lo) or (s[i + 1] > hi) {
        return 0;
    }
    for k in 2..n {
        if (s[i + k] & 0xC0) != 0x80 {
            return 0;
        }
    }
    return n;
}

// Source text is UTF-8, with lines ended by \n or \r\n (spec §2.1). Reports
// the first byte that breaks this.
fn check_source_text(L: *Lexer) void {
    let s = L.s;
    let mut i: usize = 0;
    while i < s.len {
        let c = s[i];
        if c < 0x80 {
            if (c == '\r') and (((i + 1) == s.len) or (s[i + 1] != '\n')) {
                _ = dg.err(mkspan(L, i, i + 1), "E0007", "carriage return not followed by a line feed");
                return;
            }
            i += 1;
            continue;
        }
        let n = utf8_len(s, i);
        if n == 0 {
            _ = dg.err(mkspan(L, i, i + 1), "E0007", "source text is not valid UTF-8");
            return;
        }
        i += n;
    }
}

// Tokenizes an entire file. Reports lexical errors through diag.
pub fn lex_file(f: *mut u.SourceFile) u.List.[Token] {
    let mut L = Lexer.{ f: f, s: f.text, pos: 0, toks: u.List.[Token].empty() };
    let ops = op_table();
    if (L.s.len >= 3) and (L.s[0] == 0xEF) and (L.s[1] == 0xBB) and (L.s[2] == 0xBF) {
        _ = dg.err(mkspan(&L, 0, 3), "E0001", "source file must not start with a byte-order mark");
        L.pos = 3;
    }
    check_source_text(&L);
    let mut bad = u.nil.[dg.Diag]();  // the last "unexpected character"
    loop {
        skip_ws(&mut L);
        if L.pos >= L.s.len {
            break;
        }
        let start = L.pos;
        let c = L.s[L.pos];
        if is_ident_start(c) {
            while (L.pos < L.s.len) and is_ident_char(L.s[L.pos]) {
                L.pos += 1;
            }
            let w = L.s[start..L.pos];
            let mut t = tok(TK_IDENT, mkspan(&L, start, L.pos));
            if (w.len == 1) and (w[0] == '_') {
                t.kind = TK_DISCARD;
                L.toks.push(t);
                continue;
            }
            t.kind = keyword(w);
            if t.kind == TK_IDENT {
                let p = prim_index(w);
                if p >= 0 {
                    t.kind = TK_PRIM;
                    t.prim = p;
                }
            }
            if t.kind == TK_IDENT {
                if is_reserved_future(w) {
                    _ = dg.err(t.span, "E0003", u.f1("'%s' is reserved for future use", w));
                }
                t.name = u.intern(w);
            }
            L.toks.push(t);
            continue;
        }
        if (c >= '0') and (c <= '9') {
            lex_number(&mut L);
            continue;
        }
        if c == '"' {
            L.pos += 1;
            let mut buf = u.Buf.init();
            let mut closed = false;
            while L.pos < L.s.len {
                let d = L.s[L.pos];
                if d == '"' {
                    L.pos += 1;
                    closed = true;
                    break;
                }
                if d == '\n' {
                    break;
                }
                if d == '\\' {
                    lex_escape(&mut L, &mut buf, false);
                    continue;
                }
                buf.c(d);
                L.pos += 1;
            }
            let mut t = tok(TK_STRING, mkspan(&L, start, L.pos));
            if not closed {
                _ = dg.err(t.span, "E0006", "unterminated string literal");
            }
            t.str = buf.done();
            L.toks.push(t);
            continue;
        }
        if c == '\'' {
            L.pos += 1;
            let mut buf = u.Buf.init();
            if (L.pos < L.s.len) and (L.s[L.pos] == '\\') {
                lex_escape(&mut L, &mut buf, true);
            } else if (L.pos < L.s.len) and (L.s[L.pos] == '\'') {
                _ = dg.err(mkspan(&L, start, L.pos + 1), "E0004", "empty character literal");
                L.pos += 1;
                L.toks.push(tok(TK_CHAR, mkspan(&L, start, L.pos)));
                continue;
            } else if L.pos < L.s.len {
                if L.s[L.pos] >= 0x80 {
                    _ = dg.err(mkspan(&L, start, L.pos + 1), "E0004", "character literal must be ASCII");
                    while (L.pos < L.s.len) and (L.s[L.pos] >= 0x80) {
                        L.pos += 1;
                    }
                } else {
                    buf.c(L.s[L.pos]);
                    L.pos += 1;
                }
            }
            if (L.pos < L.s.len) and (L.s[L.pos] == '\'') {
                L.pos += 1;
            } else {
                _ = dg.err(mkspan(&L, start, L.pos), "E0004", "malformed character literal");
            }
            let mut t = tok(TK_CHAR, mkspan(&L, start, L.pos));
            let bytes = buf.done();
            if bytes.len > 0 {
                t.ival = @as(u64, bytes[0]);
            }
            L.toks.push(t);
            continue;
        }
        if c == '@' {
            L.pos += 1;
            while (L.pos < L.s.len) and is_ident_char(L.s[L.pos]) {
                L.pos += 1;
            }
            let mut t = tok(TK_BUILTIN, mkspan(&L, start, L.pos));
            if L.pos == (start + 1) {
                _ = dg.err(t.span, "E0002", "expected builtin name after '@'");
            }
            t.name = u.intern(L.s[start + 1..L.pos]);
            L.toks.push(t);
            continue;
        }
        // operators: maximal munch
        let mut matched = false;
        for i in @as(usize, 0)..48 {
            let op = ops[i];
            let n = op.s.len;
            if ((L.pos + n) <= L.s.len) and @mem_eq(L.s[L.pos..L.pos + n], op.s) {
                L.pos += n;
                let t = tok(op.k, mkspan(&L, start, L.pos));
                L.toks.push(t);
                matched = true;
                break;
            }
        }
        if not matched {
            let mut e = L.pos + 1;
            while (e < L.s.len) and ((L.s[e] & 0xC0) == 0x80) {
                e += 1;
            }
            if u.notnil(bad) and (bad.span.end == @int_cast(u32, start)) {
                bad.span.end = @int_cast(u32, e);  // (a run of them: one error)
            } else {
                bad = dg.err(mkspan(&L, start, e), "E0002", "unexpected character");
            }
            L.pos = e;
        }
    }
    L.toks.push(tok(TK_EOF, mkspan(&L, L.s.len, L.s.len)));
    return L.toks;
}
