// =============================================================================
// ftab.ax - native frame tables, written by x64.ax and a64.ax.
// Calls do not record themselves on the shadow stack (codegen.ax:
// frame_tables): code keeps frame pointers, and the section axiom_rets maps
// each call's return address to its chain of call-site records (ir.Chain:
// its own, then those of the calls inlined around it, innermost first,
// null-terminated, in .data.rel.ro). A trap or crash walks the frames and
// looks the return addresses up (std/internal/runtime/trap_format.ax: walk_frames).
//
// An entry is 8 bytes, both fields relative to themselves:
//   i32  the return address (the end of the call instruction)
//   i32  the chain, with flags in its two low bits (the chain is 8-aligned
//        and the field is at 4 mod 8, so its offset is 4 mod 8)
// The table is 8-aligned (each entry too).
// Entries are in code order within a section of code: each section of code
// (isel.ax: func_section) has its own axiom_rets section, the first one's
// plain and the others' (and then the first's too) SHF_LINK_ORDER ones
// that go with their code (elf.Sec.link1: a link that leaves the code out
// leaves its entries out, and a system linker places them in the order of
// their code), in the code's COMDAT group if it is in one. The compiler's
// linkers sort the whole table by return address (nlink.ax: sort_rets), so
// the table is sorted (the runtime checks). Only calls that record something have an entry, and
// the calls in functions without a frame (x86-64: a leaf whose only calls do
// not return): F_FRAMELESS says that the caller's own return address is
// further up the stack (above the call's, past 8 bytes of alignment). A
// function without a frame is also bracketed by markers (F_MARKER): at its
// start, and at its end (with F_FRAMELESS), so that a crash in it knows
// where its return address is (runtime: the first entry after the faulting
// instruction is one with F_FRAMELESS). So is the start of a function that
// sets its frame up only after it (x64.ax: shrink-wrapping).
//
// With line tables (-g, --debug-info=lines), the table also maps code to
// source lines, for the line of a crash's faulting instruction (runtime:
// line_rec_at): each function has an entry with F_MARKER at its start
// (before its other entries there) whose second field refers to the
// function's line table instead of a chain. A line table is 4 mod 8
// aligned, so the field (the table's place relative to the field) is 0 mod
// 8 where a chain's is 4 mod 8: bit 2 tells them apart. An entry of another
// marker has the empty chain. Without line tables there are none: the
// table is what it was. The line tables and what they refer to are in the
// object's .rodata.axiom_lines, read-only and without relocations (each reference is
// relative to its own place); the records and their contexts are made once
// per object:
//   a line table:             uleb the number of rows, then for each row
//                             (where the line changes, in code order, the
//                             first at the function's start): uleb its
//                             code offset less the row before's, sleb its
//                             line record's place less the row before's
//                             (in 8 bytes from the table's start)
//   a line record (8 bytes):  u32 the line (0: none), i32 its context
//   a context (12 bytes):     i32 the presumed file's name, i32 the
//                             function's name (NUL-terminated strings),
//                             i32 the record of the call its code was
//                             inlined at (0: not inlined)
// so that code inlined has, after its own record (its location, the
// inlined function's name), one for each call it was inlined at, from the
// innermost (the call's location, the name of the function the call is
// in), records of the same calls shared. Records and tables are 4 mod 8
// aligned (their distances a multiple of 8).
//
// In a chain, a record whose function was inlined into the next one's (the
// next record is that of the call it was inlined at) is referred to with
// its address's low bit set (records are 8-aligned): trap_format.ax shows
// such a frame as inlined.
// =============================================================================
import "dbginfo.ax" as dbi;
import "dwarf.ax" as dw;
import "elf.ax" as elf;
import "ir.ax" as ir;
import "isel.ax" as is;
import "target.ax" as tg;
import "util.ax" as u;

pub const F_FRAMELESS: u64 = 1;
pub const F_MARKER: u64 = 2;
// (func's calls: an offset with this bit is a call made without the frame)
pub const CALL_FRAMELESS: u64 = @as(u64, 1) << 63;

pub struct Tab {
    on: bool,
    obj: *mut elf.Obj,
    rets: i32,      // the section axiom_rets of the function being done (select)
    chains: i32,    // where the chains go (.data.rel.ro)
    text_sym: u32,  // local symbols at the start of its code's section and of `chains`
    chains_sym: u32,
    text0: i32,  // the first section of code (.text): its rets
    rets0: i32,
    cur_text: i32,         // the section of the function being done (select)
    others: u.List.[u64],  // each other section of code << 32 | its axiom_rets
    rel32: u32,            // R_X86_64_PC32 / R_AARCH64_PREL32
    abs64: u32,            // R_X86_64_64 / R_AARCH64_ABS64
    empty: u64,            // the empty chain's offset in `chains`
    lines: bool,           // line rows too (see the header)
    ro: i32,               // where their tables and records go (.rodata.axiom_lines), and its symbol
    ro_sym: u32,
    rec_of: u.U64Map,      // a location << 32 | its scope -> its record's offset + 1 (in this function)
    recs: u.U64Map,        // a line << 32 | a context -> the record's offset + 1
    pairs: u.U64Map,       // a file's name's offset << 32 | a function's -> its number + 1
    ctxs: u.U64Map,        // a pair's number << 32 | the next record + 1 -> the context's offset + 1
    strs: u.SymMap.[u64],  // a name -> its offset + 1
    last: [2]u64,          // the string ro_str gave last at each of its two uses: its offset + 1 (0: none)
    split: *mut Split,     // a section of chains per section of code (see begin), else nil
}

// The chains of an object with a section of them per section of code (see begin).
pub struct Split {
    gsym: *mut u.List.[u32],       // the module's globals' symbols
    distinct: u.List.[*ir.Chain],  // each distinct chain (a call's MInst.aux: its number + 1)
    tchains: u.U64Map,             // a section of code -> its section of chains + 1
    placed: u.U64Map,              // a section of chains << 32 | a chain's number + 1 -> its place + 1
}

pub fn off() Tab {
    return Tab.{ on: false, obj: u.nil.[elf.Obj](), rets: -1, chains: -1, text_sym: 0, chains_sym: 0, text0: -1,
                 rets0: -1, cur_text: -1, others: u.List.[u64].empty(), rel32: 0, abs64: 0, empty: 0, lines: false,
                 ro: -1, ro_sym: 0, rec_of: u.U64Map.empty(), recs: u.U64Map.empty(), pairs: u.U64Map.empty(),
                 ctxs: u.U64Map.empty(), strs: u.SymMap.[u64].{ keys: u.nil.[usize](), vals: u.nil.[u64](), cap: 0,
                                                                len: 0 }, last: [0, 0], split: u.nil.[Split]() };
}

// The module's frame table, if it has one (m.frame_tables), and the chains
// of its calls (ir.Chain.off, then the call's place in `chains` + 1).
// `gsym` maps the module's globals to their symbols. With each function in
// a section of its own (--function-sections, which a link with
// --gc-sections may leave out), the chains of each section's calls are in
// a section of their own that its entries refer to (.data.rel.ro.chains,
// made as the entries are: chain_at), so that what a link leaves out of
// the code takes its chains and their call-site records with it; a call's
// ir.Chain.off is then the chain's number + 1 (in `distinct`), and only
// the empty chain is in `chains`.
pub fn begin(o: *mut elf.Obj, m: *ir.Module, text: i32, chains: i32, gsym: *mut u.List.[u32], rel32: u32,
             abs64: u32) Tab {
    let mut t = off();
    if not m.frame_tables {
        return t;
    }
    t.on = true;
    t.lines = tg.g_debug != tg.DEBUG_NONE;
    t.obj = o;
    t.rets = elf.add_sec(o, "axiom_rets", elf.S_RODATA, 8);
    t.rets0 = t.rets;
    t.text0 = text;
    t.cur_text = text;
    t.chains = chains;
    t.text_sym = elf.sec_sym(o, text);
    t.chains_sym = elf.sec_sym(o, chains);
    if t.lines {
        // (a section of their own: the program's other read-only data is
        // where it is without line tables)
        t.ro = elf.add_sec(o, ".rodata.axiom_lines", elf.S_RODATA, 8);
        t.ro_sym = elf.sec_sym(o, t.ro);
    }
    t.rel32 = rel32;
    t.abs64 = abs64;
    if is.g_function_sections {
        t.split = u.perm_new.[Split]();
        t.split.* = Split.{ gsym: gsym, distinct: u.List.[*ir.Chain].empty(), tchains: u.U64Map.empty(),
                            placed: u.U64Map.empty() };
    }
    let cs = o.secs.get(@int_cast(usize, chains));
    if cs.align < 8 {
        cs.align = 8;
    }
    cs.data.align(8);
    t.empty = @as(u64, cs.data.len());
    cs.data.zeros(8);
    // each distinct chain once
    let mut seen = u.SymMap.[u64].{ keys: u.nil.[usize](), vals: u.nil.[u64](), cap: 0, len: 0 };
    for fi in 0..m.funcs.len {
        let f = m.funcs.get(fi);
        let mut b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                if (i.op == ir.OP_CALL) and u.notnil(ir.chain_of(i)) {
                    let mut key = u.Buf.init();
                    let mut c = ir.chain_of(i);
                    while u.notnil(c) {
                        key.s(u.idec(ir.gv_of(c.site).id));
                        key.s(",");
                        c = c.next;
                    }
                    let k = u.intern(key.done());
                    let mut at = seen.get(k);
                    if (at == 0) and u.notnil(t.split) {
                        t.split.distinct.push(ir.chain_of(i));
                        at = @as(u64, t.split.distinct.len);
                        seen.put(k, at);
                    } else if at == 0 {
                        at = put_chain(&t, gsym, cs, ir.chain_of(i)) + 1;
                        seen.put(k, at);
                    }
                    ir.chain_of(i).off = @bit_cast(i64, at);
                }
                i = i.next;
            }
            b = b.next;
        }
    }
    return t;
}

// Chain c into section cs: its place there.
fn put_chain(t: *Tab, gsym: *mut u.List.[u32], cs: *mut elf.Sec, chain: *ir.Chain) u64 {
    let at = @as(u64, cs.data.len());
    let mut c = chain;
    while u.notnil(c) {
        // (a call inlined into the next one's function: marked)
        let mut inl: i64 = 0;
        if u.notnil(c.next) {
            inl = 1;
        }
        cs.relocs.push(
            elf.Rel.{ off: @as(u64, cs.data.len()), ty: t.abs64, sym: is.gsym_at(t.obj, gsym, ir.gv_of(c.site)),
                      addend: inl });
        cs.data.zeros(8);
        c = c.next;
    }
    cs.data.zeros(8);
    return at;
}

// (split) The section of chains of the code of the section being done
// (made once, in its code's COMDAT group if it is in one), and chain number
// n's place there (put there once): section << 32 | place.
fn chain_at(t: *mut Tab, n: u64) u64 {
    let tk = @as(u64, @bit_cast(u32, t.cur_text));
    let sp = t.split;
    let mut k = sp.tchains.get(tk);
    if k == 0 {
        let c = elf.add_sec(t.obj, ".data.rel.ro.chains", elf.S_DATA, 8);
        t.obj.secs.get(@int_cast(usize, c)).group = t.obj.secs.get(@int_cast(usize, t.cur_text)).group;
        k = @as(u64, @bit_cast(u32, c)) + 1;
        sp.tchains.put(tk, k);
    }
    let key = ((k - 1) << 32) | n;
    let mut at = sp.placed.get(key);
    if at == 0 {
        let cs = t.obj.secs.get(@truncate(usize, k - 1));
        at = put_chain(t, sp.gsym, cs, sp.distinct.get(@truncate(usize, n - 1))) + 1;
        sp.placed.put(key, at);
    }
    return ((k - 1) << 32) | (at - 1);
}

// What a call's machine instruction keeps (MInst.aux): its chain's place + 1,
// or 0 for none.
pub fn call_aux(v: *ir.Value) i64 {
    if u.isnil(ir.chain_of(v)) {
        return 0;
    }
    return ir.chain_of(v).off;
}

fn entry(t: *mut Tab, at: u64, chain: u64, flags: u64) void {
    entry_to(t, at, t.chains_sym, chain, flags);
}

// An entry whose second field refers to `to` in the section of symbol `sym`.
fn entry_to(t: *mut Tab, at: u64, sym: u32, to: u64, flags: u64) void {
    if t.rets < 0 {
        select_rets(t);
    }
    let s = t.obj.secs.get(@int_cast(usize, t.rets));
    let o = @as(u64, s.data.len());
    s.relocs.push(elf.Rel.{ off: o, ty: t.rel32, sym: t.text_sym, addend: @bit_cast(i64, at) });
    s.relocs.push(elf.Rel.{ off: o + 4, ty: t.rel32, sym: sym, addend: @bit_cast(i64, to + flags) });
    s.data.zeros(8);
}

// The line rows of a function as entries (see the header): rows as the
// line tables have them (code offset << 32 | flags | ir.src_loc), in code
// order; name the function's.
struct Lines {
    rows: []u64,
    k: usize,
    name: []u8,
    started: bool,
    scopes: []u64,  // where the scope changes (dwarf.Func.scopes), for the inline instances
    sk: usize,
}

// The scope of the code at offset `at` (rows are visited in order).
fn scope_at(l: *mut Lines, at: u64) u32 {
    while ((l.sk + 1) < l.scopes.len) and ((l.scopes[l.sk + 1] >> 32) <= at) {
        l.sk += 1;
    }
    if (l.sk < l.scopes.len) and ((l.scopes[l.sk] >> 32) <= at) {
        return @truncate(u32, l.scopes[l.sk]);
    }
    return 0;
}

// The offset of the next row of l (none: u64 max), skipping those of the
// line of the row before.
fn next_row(l: *mut Lines) u64 {
    if not l.started {
        return 0;
    }
    if l.k >= l.rows.len {
        return 0xffff_ffff_ffff_ffff;
    }
    return (l.rows[l.k] >> 32) & 0x7fff_ffff;
}

// The next row of l: its code offset << 32 | its line record's offset in
// .rodata.axiom_lines.
fn take_row(t: *mut Tab, l: *mut Lines) u64 {
    if not l.started {
        l.started = true;
        // (a row at the function's start: of its first row's line if that is there)
        let mut src: u32 = 0;
        if (l.rows.len > 0) and (((l.rows[0] >> 32) & 0x7fff_ffff) == 0) {
            src = @truncate(u32, l.rows[0]);
            l.k = 1;
        }
        return line_record(t, src, scope_at(l, 0), l.name);
    }
    let r = l.rows[l.k];
    l.k += 1;
    let at = (r >> 32) & 0x7fff_ffff;
    return (at << 32) | line_record(t, @truncate(u32, r), scope_at(l, at), l.name);
}

// The line table of a function of `size` bytes of code whose rows l has
// (see the header): its offset in .rodata.axiom_lines.
fn line_table(t: *mut Tab, l: *mut Lines, size: u64) u64 {
    let mut rs = u.List.[u64].empty();
    while next_row(l) < size {
        rs.push(take_row(t, l));
    }
    let cs = t.obj.secs.get(@int_cast(usize, t.ro));
    cs.data.align(4);
    if (cs.data.len() % 8) == 0 {
        cs.data.zeros(4);
    }
    let tab = @as(u64, cs.data.len());
    cs.data.uleb(@as(u64, rs.len));
    let mut last: u64 = 0;
    let mut r: i64 = 0;
    for x in rs.items() {
        let at = x >> 32;
        let q = (@bit_cast(i64, x & 0xffff_ffff) - @bit_cast(i64, tab)) / 8;
        cs.data.uleb(at - last);
        cs.data.sleb(q - r);
        last = at;
        r = q;
    }
    rs.deinit();
    return tab;
}

// The function of the code of scope sc for people: an inline instance's,
// or (none) the function's, `name`.
fn scope_func(sc: u32, name: []u8) []u8 {
    let r = dbi.inline_root(sc);
    if r == 0 {
        return name;
    }
    return dw.abs_name(dbi.scopes.get(@as(usize, r)).func);
}

// The line record (its offset in .rodata.axiom_lines) of source location src in scope
// sc of the function named name (see the header), made once per object:
// the location's, whose context refers to the record of the call its code
// was inlined at (sc's innermost inline instance; but a call without a
// location, which the compiler made: C's main is called by a function of
// the start-up's, is passed over), and so on outward.
fn line_record(t: *mut Tab, src: u32, sc: u32, name: []u8) u64 {
    let key = (@as(u64, src) << 32) | @as(u64, sc);
    let known = t.rec_of.get(key);
    if known != 0 {
        return known - 1;
    }
    let mut next: u64 = 0;
    let mut r = dbi.inline_root(sc);
    while r != 0 {
        let x = dbi.scopes.get(@as(usize, r));
        if ir.src_line(x.call) == 0 {
            r = dbi.inline_root(x.parent);  // (a call the compiler made: its function is not shown)
            continue;
        }
        next = line_record(t, x.call, x.parent, name) + 1;
        break;
    }
    let file = ir.src_file(src);
    let mut fname: []u8 = "";
    let mut line: u64 = 0;
    if (src != 0) and (file >= 0) and (@int_cast(usize, file) < u.g_files.len) {
        let p = u.presumed_line(file, @bit_cast(i32, ir.src_line(src)));
        fname = p.name;
        if (p.line > 0) and (p.line < 0x7fff_ffff) {
            line = @bit_cast(u64, p.line);
        }
    }
    let pk = (ro_str(t, fname, 0) << 32) | ro_str(t, scope_func(sc, name), 1);
    let mut pair = t.pairs.get(pk);
    if pair == 0 {
        pair = @as(u64, t.pairs.len) + 1;
        t.pairs.put(pk, pair);
    }
    let cs = t.obj.secs.get(@int_cast(usize, t.ro));
    let ck = (pair << 32) | next;
    let mut ctx = t.ctxs.get(ck);
    if ctx == 0 {
        cs.data.align(4);
        ctx = @as(u64, cs.data.len()) + 1;
        let at = ctx - 1;
        cs.data.u32_(rel(pk >> 32, at));
        cs.data.u32_(rel(pk & 0xffff_ffff, at + 4));
        if next == 0 {
            cs.data.u32_(0);
        } else {
            cs.data.u32_(rel(next - 1, at + 8));
        }
        t.ctxs.put(ck, ctx);
    }
    let rk = (line << 32) | (ctx - 1);
    let mut rec = t.recs.get(rk);
    if rec == 0 {
        cs.data.align(4);
        if (cs.data.len() % 8) == 0 {
            cs.data.zeros(4);
        }
        rec = @as(u64, cs.data.len()) + 1;
        cs.data.u32_(line);
        cs.data.u32_(rel(ctx - 1, rec + 3));
        t.recs.put(rk, rec);
    }
    t.rec_of.put(key, rec);
    return rec - 1;
}

// The 32 bits of a reference from `from` to `to` in .rodata.axiom_lines (to - from).
fn rel(to: u64, from: u64) u64 {
    return (to -% from) & 0xffff_ffff;
}

// The offset in .rodata.axiom_lines of string s (NUL-terminated), made once
// per object (the string given last at the same use, `use`, is looked at
// first: the same file and function, most often).
fn ro_str(t: *mut Tab, s: []u8, use: usize) u64 {
    let lo = t.last[use];
    if lo != 0 {
        let d = t.obj.secs.get(@int_cast(usize, t.ro)).data.view();
        let o = @truncate(usize, lo - 1);
        if ((o + s.len) < d.len) and (d[o + s.len] == 0) and u.str_eq(d[o..o + s.len], s) {
            return lo - 1;
        }
    }
    let r = ro_str_new(t, s);
    t.last[use] = r + 1;
    return r;
}

fn ro_str_new(t: *mut Tab, s: []u8) u64 {
    let k = u.intern(s);
    let at = t.strs.get(k);
    if at != 0 {
        return at - 1;
    }
    let cs = t.obj.secs.get(@int_cast(usize, t.ro));
    let o = @as(u64, cs.data.len());
    cs.data.put(s);
    cs.data.u8_(0);
    t.strs.put(k, o + 1);
    return o;
}

// Makes the entries that follow those of section `text`'s code (its
// axiom_rets made with the first of them: entry).
fn select(t: *mut Tab, text: i32) void {
    t.cur_text = text;
    t.rets = -1;
}

fn select_rets(t: *mut Tab) void {
    let text = t.cur_text;
    t.text_sym = elf.sec_sym(t.obj, text);
    if text == t.text0 {
        t.rets = t.rets0;
        return;
    }
    for x in t.others.items() {
        if @truncate(i32, @bit_cast(i64, x >> 32)) == text {
            t.rets = @truncate(i32, @bit_cast(i64, x & 0xffff_ffff));
            return;
        }
    }
    // (a second section of code: the first's entries go with it too)
    t.obj.secs.get(@int_cast(usize, t.rets0)).link1 = t.text0 + 1;
    t.rets = elf.add_sec(t.obj, "axiom_rets", elf.S_RODATA, 8);
    let r = t.obj.secs.get(@int_cast(usize, t.rets));
    r.link1 = text + 1;
    r.group = t.obj.secs.get(@int_cast(usize, text)).group;
    t.others.push((@as(u64, @bit_cast(u32, text)) << 32) | @as(u64, @bit_cast(u32, t.rets)));
}

// A function's entries, once its code is at `base` in section `text` (`size` bytes):
// `calls` holds pairs of the offset after a call and its MInst.aux; `rows`
// its line table's rows when it has one (else empty), `scopes` where its
// scope changes (dwarf.Func.scopes: the inline instances), `name` its name.
pub fn func(t: *mut Tab, text: i32, base: u64, size: u64, frameless: bool, noframe: []u64, calls: []u64, rows: []u64,
            scopes: []u64, name: []u8) void {
    if not t.on {
        return;
    }
    select(t, text);
    // (an exported function by its own name: C's main, say)
    let mut nm = name;
    if u.starts(nm, "axiom.export.") and (nm.len > 13) {
        nm = nm[13..];
    }
    let mut ls = Lines.{ rows: rows, k: 0, name: nm, started: not t.lines, scopes: scopes, sk: 0 };
    if not t.lines {
        ls.rows = rows[0..0];
    } else if t.rec_of.len > 0 {
        t.rec_of.deinit();  // (its records by location and scope are of the last function's: its name)
    }
    if t.lines and (size > 0) {
        entry_to(t, base, t.ro_sym, line_table(t, &mut ls, size), F_MARKER);
    }
    let mut fl: u64 = 0;
    if frameless {
        fl = F_FRAMELESS;
        entry(t, base, t.empty, F_MARKER);
    }
    // (shrink-wrapped: the stretches [noframe[2i], noframe[2i+1]) run before
    // the frame is set up, and so do the calls marked CALL_FRAMELESS in them:
    // calls of traps, which do not return)
    let mut n: usize = 0;
    let mut k: usize = 0;
    let mut end: u64 = 0;  // (the end of the stretch without the frame the calls are in, if any)
    while ((k + 1) < calls.len) or ((n + 1) < noframe.len) or (end != 0) {
        let more = (k + 1) < calls.len;
        let mut at: u64 = 0;
        if more {
            at = calls[k] & ~CALL_FRAMELESS;
        }
        if (end != 0) and (not more or (end < at)) {
            entry(t, base + end, t.empty, F_MARKER | F_FRAMELESS);
            end = 0;
            continue;
        }
        if (end == 0) and ((n + 1) < noframe.len) and (not more or (noframe[n] < at)) {
            entry(t, base + noframe[n], t.empty, F_MARKER);
            end = noframe[n + 1];
            n += 2;
            continue;
        }
        let aux = calls[k + 1];
        let mut chain = t.empty;
        if aux != 0 {
            chain = aux - 1;
        }
        let mut cf = fl;
        if (calls[k] & CALL_FRAMELESS) != 0 {
            cf = F_FRAMELESS;
        }
        if (aux != 0) and u.notnil(t.split) {
            let x = chain_at(t, aux);
            entry_to(t, base + at, elf.sec_sym(t.obj, @truncate(i32, @bit_cast(i64, x >> 32))), x & 0xffff_ffff, cf);
        } else if (aux != 0) or (cf != 0) {
            entry(t, base + at, chain, cf);
        }
        k += 2;
    }
    if frameless {
        entry(t, base + size, t.empty, F_MARKER | F_FRAMELESS);
    }
}
