// =============================================================================
// ftab.ax - native frame tables, written by x64.ax and a64.ax.
// Calls do not record themselves on the shadow stack (codegen.ax:
// frame_tables): code keeps frame pointers, and the section axiom_rets maps
// each call's return address to its chain of call-site records (ir.Chain:
// its own, then those of the calls inlined around it, innermost first,
// null-terminated, in .data.rel.ro). A trap or crash walks the frames and
// looks the return addresses up (std/internal/runtime/trap_format.ax: walk_frames).
//
// An entry is 8 bytes, both fields relative to themselves:
//   i32  the return address (the end of the call instruction)
//   i32  the chain, with flags in its two low bits (the chain is 8-aligned
//        and the field is at 4 mod 8, so its offset is 4 mod 8)
// Entries are in code order within an object, and the linkers place the
// objects' sections in the same order as their code, so the table is sorted
// (the runtime checks). Only calls that record something have an entry, and
// the calls in functions without a frame (x86-64: a leaf whose only calls do
// not return): F_FRAMELESS says that the caller's own return address is
// further up the stack (above the call's, past 8 bytes of alignment). A
// function without a frame is also bracketed by markers (F_MARKER): at its
// start, and at its end (with F_FRAMELESS), so that a crash in it knows
// where its return address is (runtime: the first entry after the faulting
// instruction is one with F_FRAMELESS). So is the start of a function that
// sets its frame up only after it (x64.ax: shrink-wrapping).
//
// With line tables (-g, --debug-info=lines), the table also maps code to
// source lines, for the line of a crash's faulting instruction (runtime:
// line_at): an entry with F_MARKER where the line changes (the rows of the
// line tables, and one at each function's start), whose chain holds one
// record shaped as a call site's (trap_format.ax's Site: the presumed file,
// the line, column 0, the function's name; line 0 at a function's start
// with no line), and F_FRAMELESS where the code runs without the frame. An
// entry of another marker has the empty chain. Without line tables there
// are none: the table is what it was.
// =============================================================================
import "elf.ax" as elf;
import "ir.ax" as ir;
import "isel.ax" as is;
import "target.ax" as tg;
import "util.ax" as u;

pub const F_FRAMELESS: u64 = 1;
pub const F_MARKER: u64 = 2;
// (func's calls: an offset with this bit is a call made without the frame)
pub const CALL_FRAMELESS: u64 = @as(u64, 1) << 63;

pub struct Tab {
    on: bool,
    obj: *mut elf.Obj,
    rets: i32,      // the section axiom_rets
    chains: i32,    // where the chains go (.data.rel.ro)
    text_sym: u32,  // local symbols at the start of .text and of `chains`
    chains_sym: u32,
    rel32: u32,                 // R_X86_64_PC32 / R_AARCH64_PREL32
    abs64: u32,                 // R_X86_64_64 / R_AARCH64_ABS64
    empty: u64,                 // the empty chain's offset in `chains`
    lines: bool,                // line rows too (see the header)
    line_recs: u.SymMap.[u64],  // their chains, by location and function: offset + 1
}

pub fn off() Tab {
    return Tab.{ on: false, obj: u.nil.[elf.Obj](), rets: -1, chains: -1, text_sym: 0, chains_sym: 0, rel32: 0,
                 abs64: 0, empty: 0, lines: false,
                 line_recs: u.SymMap.[u64].{ keys: u.nil.[usize](), vals: u.nil.[u64](), cap: 0, len: 0 } };
}

fn local_sym(o: *mut elf.Obj, sec: i32) u32 {
    return elf.add_sym(o, elf.Sym.{ name: "", sec: sec, value: 0, size: 0, bind: elf.B_LOCAL, ty: elf.T_NOTYPE,
                                    hidden: false });
}

// The module's frame table, if it has one (m.frame_tables), and the chains
// of its calls (ir.Chain.off, then the call's place in `chains` + 1).
// `gsym` maps the module's globals to their symbols.
pub fn begin(o: *mut elf.Obj, m: *ir.Module, text: i32, chains: i32, gsym: *mut u.List.[u32], rel32: u32,
             abs64: u32) Tab {
    let mut t = off();
    if not m.frame_tables {
        return t;
    }
    t.on = true;
    t.lines = tg.g_debug != tg.DEBUG_NONE;
    t.obj = o;
    t.rets = elf.add_sec(o, "axiom_rets", elf.S_RODATA, 4);
    t.chains = chains;
    t.text_sym = local_sym(o, text);
    t.chains_sym = local_sym(o, chains);
    t.rel32 = rel32;
    t.abs64 = abs64;
    let cs = o.secs.get(@int_cast(usize, chains));
    if cs.align < 8 {
        cs.align = 8;
    }
    cs.data.align(8);
    t.empty = @as(u64, cs.data.len());
    cs.data.zeros(8);
    // each distinct chain once
    let mut seen = u.SymMap.[u64].{ keys: u.nil.[usize](), vals: u.nil.[u64](), cap: 0, len: 0 };
    for fi in 0..m.funcs.len {
        let f = m.funcs.get(fi);
        let mut b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                if (i.op == ir.OP_CALL) and u.notnil(ir.chain_of(i)) {
                    let mut key = u.Buf.init();
                    let mut c = ir.chain_of(i);
                    while u.notnil(c) {
                        key.s(u.idec(ir.gv_of(c.site).id));
                        key.s(",");
                        c = c.next;
                    }
                    let k = u.intern(key.done());
                    let mut at = seen.get(k);
                    if at == 0 {
                        at = @as(u64, cs.data.len()) + 1;
                        c = ir.chain_of(i);
                        while u.notnil(c) {
                            cs.relocs.push(
                                elf.Rel.{
                                    off: @as(u64, cs.data.len()), ty: abs64, sym: is.gsym_at(o, gsym, ir.gv_of(c.site)),
                                    addend: 0 });
                            cs.data.zeros(8);
                            c = c.next;
                        }
                        cs.data.zeros(8);
                        seen.put(k, at);
                    }
                    ir.chain_of(i).off = @bit_cast(i64, at);
                }
                i = i.next;
            }
            b = b.next;
        }
    }
    return t;
}

// What a call's machine instruction keeps (MInst.aux): its chain's place + 1,
// or 0 for none.
pub fn call_aux(v: *ir.Value) i64 {
    if u.isnil(ir.chain_of(v)) {
        return 0;
    }
    return ir.chain_of(v).off;
}

fn entry(t: *Tab, at: u64, chain: u64, flags: u64) void {
    let s = t.obj.secs.get(@int_cast(usize, t.rets));
    let o = @as(u64, s.data.len());
    s.relocs.push(elf.Rel.{ off: o, ty: t.rel32, sym: t.text_sym, addend: @bit_cast(i64, at) });
    s.relocs.push(elf.Rel.{ off: o + 4, ty: t.rel32, sym: t.chains_sym, addend: @bit_cast(i64, chain + flags) });
    s.data.zeros(8);
}

// The line rows of a function as entries (see the header): rows as the
// line tables have them (code offset << 32 | flags | ir.src_loc), in code
// order; name the function's.
struct Lines {
    rows: []u64,
    k: usize,
    name: []u8,
    started: bool,
}

// The offset of the next row of l (none: u64 max), skipping those of the
// line of the row before.
fn next_row(l: *mut Lines) u64 {
    if not l.started {
        return 0;
    }
    if l.k >= l.rows.len {
        return 0xffff_ffff_ffff_ffff;
    }
    return (l.rows[l.k] >> 32) & 0x7fff_ffff;
}

// Writes the next row of l at base + its offset (frameless: the code there
// runs without the frame).
fn put_row(t: *mut Tab, l: *mut Lines, base: u64, frameless: bool) void {
    let mut fl = F_MARKER;
    if frameless {
        fl = fl | F_FRAMELESS;
    }
    if not l.started {
        l.started = true;
        // (a row at the function's start: of its first row's line if that is there)
        let mut src: u32 = 0;
        if (l.rows.len > 0) and (((l.rows[0] >> 32) & 0x7fff_ffff) == 0) {
            src = @truncate(u32, l.rows[0]);
            l.k = 1;
        }
        entry(t, base, line_chain(t, src, l.name), fl);
        return;
    }
    let r = l.rows[l.k];
    l.k += 1;
    entry(t, base + ((r >> 32) & 0x7fff_ffff), line_chain(t, @truncate(u32, r), l.name), fl);
}

// The chain of one record for source location src in the function named
// name (see the header), made once per object; a location without a file
// or line has line 0.
fn line_chain(t: *mut Tab, src: u32, name: []u8) u64 {
    let key = u.intern(u.f2("%s/%s", u.dec(@as(i64, src)), name));
    let at = t.line_recs.get(key);
    if at != 0 {
        return at - 1;
    }
    let file = ir.src_file(src);
    let mut fname: []u8 = "";
    let mut line: u64 = 0;
    if (src != 0) and (file >= 0) and (@int_cast(usize, file) < u.g_files.len) {
        let p = u.presumed_line(file, @bit_cast(i32, ir.src_line(src)));
        fname = p.name;
        if (p.line > 0) and (p.line < 0x7fff_ffff) {
            line = @bit_cast(u64, p.line);
        }
    }
    let cs = t.obj.secs.get(@int_cast(usize, t.chains));
    cs.data.align(8);
    // the record: code, file_id, start, end, line, col, file_off, text_off,
    // fn_off, callee_off (u32), then strs: "file\0name\0\0" after it
    let rec = @as(u64, cs.data.len());
    cs.data.u32_(0);
    cs.data.u32_(0);
    cs.data.u32_(0);
    cs.data.u32_(0);
    cs.data.u32_(line);
    cs.data.u32_(0);
    let nf = @as(u64, fname.len) + 1;
    cs.data.u32_(0);
    cs.data.u32_(nf + @as(u64, name.len) + 1);
    cs.data.u32_(nf);
    cs.data.u32_(nf + @as(u64, name.len) + 1);
    cs.relocs.push(
        elf.Rel.{ off: @as(u64, cs.data.len()), ty: t.abs64, sym: t.chains_sym, addend: @bit_cast(i64, rec + 48) });
    cs.data.zeros(8);
    cs.data.put(fname);
    cs.data.u8_(0);
    cs.data.put(name);
    cs.data.zeros(2);
    cs.data.align(8);
    // the chain: the record, then null
    let ch = @as(u64, cs.data.len());
    cs.relocs.push(elf.Rel.{ off: ch, ty: t.abs64, sym: t.chains_sym, addend: @bit_cast(i64, rec) });
    cs.data.zeros(16);
    t.line_recs.put(key, ch + 1);
    return ch;
}

// A function's entries, once its code is at `base` in .text (`size` bytes):
// `calls` holds pairs of the offset after a call and its MInst.aux; `rows`
// its line table's rows when it has one (else empty), `name` its name.
pub fn func(t: *mut Tab, base: u64, size: u64, frameless: bool, noframe: []u64, calls: []u64, rows: []u64,
            name: []u8) void {
    if not t.on {
        return;
    }
    // (an exported function by its own name: C's main, say)
    let mut nm = name;
    if u.starts(nm, "axiom.export.") and (nm.len > 13) {
        nm = nm[13..];
    }
    let mut ls = Lines.{ rows: rows, k: 0, name: nm, started: not t.lines };
    if not t.lines {
        ls.rows = rows[0..0];
    }
    let mut fl: u64 = 0;
    if frameless {
        fl = F_FRAMELESS;
        entry(t, base, t.empty, F_MARKER);
    }
    // (shrink-wrapped: the stretches [noframe[2i], noframe[2i+1]) run before
    // the frame is set up, and so do the calls marked CALL_FRAMELESS in them:
    // calls of traps, which do not return)
    let mut n: usize = 0;
    let mut k: usize = 0;
    let mut end: u64 = 0;  // (the end of the stretch without the frame the calls are in, if any)
    while ((k + 1) < calls.len) or ((n + 1) < noframe.len) or (end != 0) {
        let more = (k + 1) < calls.len;
        let mut at: u64 = 0;
        if more {
            at = calls[k] & ~CALL_FRAMELESS;
        }
        // (the rows before the next entry, which goes first at the same offset)
        let mut next: u64 = 0xffff_ffff_ffff_ffff;
        if more {
            next = at;
        }
        if (end != 0) and (end < next) {
            next = end;
        }
        if (end == 0) and ((n + 1) < noframe.len) and (noframe[n] < next) {
            next = noframe[n];
        }
        if next_row(&mut ls) < next {
            put_row(t, &mut ls, base, frameless or (end != 0));
            continue;
        }
        if (end != 0) and (not more or (end < at)) {
            entry(t, base + end, t.empty, F_MARKER | F_FRAMELESS);
            end = 0;
            continue;
        }
        if (end == 0) and ((n + 1) < noframe.len) and (not more or (noframe[n] < at)) {
            entry(t, base + noframe[n], t.empty, F_MARKER);
            end = noframe[n + 1];
            n += 2;
            continue;
        }
        let aux = calls[k + 1];
        let mut chain = t.empty;
        if aux != 0 {
            chain = aux - 1;
        }
        let mut cf = fl;
        if (calls[k] & CALL_FRAMELESS) != 0 {
            cf = F_FRAMELESS;
        }
        if (aux != 0) or (cf != 0) {
            entry(t, base + at, chain, cf);
        }
        k += 2;
    }
    while next_row(&mut ls) < size {
        put_row(t, &mut ls, base, frameless);
    }
    if frameless {
        entry(t, base + size, t.empty, F_MARKER | F_FRAMELESS);
    }
}
