// =============================================================================
// profiler.ax - `axiom profile`: runs a program under the sampling profiler
// of std/internal/runtime and reports where its time goes: hot functions,
// call sites, folded stacks for flame graphs (spec §16.6).
// =============================================================================
import "codegen.ax" as cg;
import "diag.ax" as dg;
import "target.ax" as tg;
import "types.ax" as ty;
import "util.ax" as u;

struct ProfFn {
    name: []u8,
    self_: i64,
    total: i64,
    stamp: i64,
}

struct ProfSite {
    sp: u.Span,
    caller: []u8,
    callee: []u8,
    total: i64,
    stamp: i64,
}

struct ProfStack {
    key: []u8,
    count: i64,
}

fn cmp_fn(x: *mut ProfFn, y: *mut ProfFn) i32 {
    if x.self_ != y.self_ {
        if x.self_ < y.self_ {
            return 1;
        }
        return -1;
    }
    if x.total != y.total {
        if x.total < y.total {
            return 1;
        }
        return -1;
    }
    return u.str_cmp(x.name, y.name);
}

fn cmp_site(x: *mut ProfSite, y: *mut ProfSite) i32 {
    if x.total != y.total {
        if x.total < y.total {
            return 1;
        }
        return -1;
    }
    if x.sp.file != y.sp.file {
        return x.sp.file - y.sp.file;
    }
    return @bit_cast(i32, x.sp.start) - @bit_cast(i32, y.sp.start);
}

fn cmp_stack(x: *mut ProfStack, y: *mut ProfStack) i32 {
    return u.str_cmp(x.key, y.key);
}

// Runs a program with extra environment variables; its exit status.
fn spawn_program(args: [][]u8, env: [][]u8, out_to_err: bool) i32 {
    let mut mode = u.OUT_INHERIT;
    if out_to_err {
        mode = u.OUT_STDERR;
    }
    return u.run_process(args, env, mode).status;
}

fn pct(a: i64, n: f64) f64 {
    return (100.0 * @float_from_int(f64, a)) / n;
}

// The profile: functions, call sites and stacks, aggregated over the samples.
struct Profile {
    fns: u.SymMap.[*mut ProfFn],
    sites: u.SymMap.[*mut ProfSite],
    stacks: u.SymMap.[*mut ProfStack],
    fnv: u.List.[*mut ProfFn],
    sitev: u.List.[*mut ProfSite],
    stackv: u.List.[*mut ProfStack],
    nsamples: i64,
    dropped: i64,
    stamp: i64,  // the current sample's number
    truncated: i64,
    hz: i32,
    clock: []u8,
}

// Runs the program with the profiler on; the profile's text, or a nil slice
// after an error (reported). The program's exit status goes into *status.
fn record(bin: []u8, prog_args: [][]u8, std_dir: []u8, hz: i32, json: bool, status: *mut i32) []u8 {
    let raw = u.cat2(bin, ".raw");  // (in the private directory bin is in)
    _ = u.unlink(u.cz(raw));
    let mut av = u.List.[[]u8].empty();
    let mut env = u.List.[[]u8].empty();
    if ty.g_target.is_wasm {
        let names = ["node"];
        let node = u.find_tool(names[..]);
        if u.isnos(node) {
            dg.emit_fatal(json, "E9003",
                          "axiom profile needs node to run WebAssembly programs (or use --target=native)");
            return u.nosym();
        }
        av.push(node);
        av.push(u.f1("%s/internal/runtime/host.mjs", std_dir));
        av.push(u.f1("--profile=%s", raw));
        av.push(u.f1("--profile-hz=%s", u.idec(hz)));
    } else {
        tg.push_emulator(&mut av);
        env.push(u.f1("AXIOM_PROFILE=%s", raw));
        env.push(u.f1("AXIOM_PROFILE_HZ=%s", u.idec(hz)));
    }
    av.push(bin);
    if ty.g_target.is_wasm and (prog_args.len > 0) {
        av.push("--");  // host.mjs: the program's arguments follow
    }
    for a in prog_args {
        av.push(a);
    }
    status.* = spawn_program(av.items(), env.items(), json);
    let text = u.read_file(raw);
    _ = u.unlink(u.cz(raw));
    if u.isnos(text) {
        dg.emit_fatal(json, "E9006", u.f1("no profile was recorded (the program exited with status %s)",
                                          u.idec(status.*)));
    }
    return text;
}

// Adds a sample ("S\t<count>\t<depth>\t<leaf>\t<site>..."; each site is
// file key, start, end and caller, separated by 0x1f, innermost first).
fn add_sample(p: *mut Profile, line: []u8) void {
    let f = u.split(line[2..], '\t', 4 + 256);
    if f.len < 3 {
        return;
    }
    let count = u.atol(f.get(0));
    let depth = u.atol(f.get(1));
    let ns = f.len - 3;
    let leaf = u.intern(f.get(2));
    // Functions root first: the callers of each site, then the leaf.
    let chain = u.newn.[[]u8](ns + 2);
    let spans = u.newn.[u.Span](ns + 1);
    let mut nc: usize = 0;
    let mut k = ns;
    while k > 0 {
        k -= 1;
        let g = u.split(f.get(3 + k), 0x1f, 4);
        if g.len < 4 {
            return;
        }
        let fid = cg.file_from_key(g.get(0));
        let mut sf: i32 = -1;
        if (fid >= 0) and (@int_cast(usize, fid) < u.g_files.len) {
            sf = fid;
        }
        spans[nc] = u.mkspan(sf, u.to_u32(g.get(1)), u.to_u32(g.get(2)));
        chain[nc] = u.intern(g.get(3));
        nc += 1;
    }
    chain[nc] = leaf;
    p.nsamples += count;
    let truncated = depth > @int_cast(i64, ns);
    if truncated {
        p.truncated += count;
    }
    p.stamp += 1;
    add_functions(p, chain[0..nc + 1], count);
    add_sites(p, chain[0..nc + 1], spans[0..nc], count);
    add_stack(p, chain[0..nc + 1], truncated, count);
}

// Counts a sample's functions (root first, the leaf last).
fn add_functions(p: *mut Profile, chain: [][]u8, count: i64) void {
    let leaf = chain.len - 1;
    for kk in 0..chain.len {
        let mut pf = p.fns.get(chain[kk]);
        if u.isnil(pf) {
            pf = u.new.[ProfFn]();
            pf.name = chain[kk];
            p.fns.put(chain[kk], pf);
            p.fnv.push(pf);
        }
        if pf.stamp != p.stamp {  // once per sample, even under recursion
            pf.stamp = p.stamp;
            pf.total += count;
        }
        if kk == leaf {
            pf.self_ += count;
        }
    }
}

// Counts a sample's call sites: spans[k] is where chain[k] calls chain[k + 1].
fn add_sites(p: *mut Profile, chain: [][]u8, spans: []u.Span, count: i64) void {
    for kk in 0..spans.len {
        if spans[kk].file < 0 {
            continue;
        }
        let key = u.intern(u.f4("%s:%s:%s:%s", u.idec(spans[kk].file), u.udec(@as(u64, spans[kk].start)),
                                u.udec(@as(u64, spans[kk].end)), chain[kk]));
        let mut ps = p.sites.get(key);
        if u.isnil(ps) {
            ps = u.new.[ProfSite]();
            ps.sp = spans[kk];
            ps.caller = chain[kk];
            ps.callee = chain[kk + 1];
            p.sites.put(key, ps);
            p.sitev.push(ps);
        }
        if ps.stamp != p.stamp {
            ps.stamp = p.stamp;
            ps.total += count;
        }
    }
}

// Counts a sample's stack, folded: "root;...;leaf" (';' in names become ':').
fn add_stack(p: *mut Profile, chain: [][]u8, truncated: bool, count: i64) void {
    let mut fk = u.Buf.init();
    if truncated {
        fk.s("[truncated];");
    }
    for kk in 0..chain.len {
        for c in chain[kk] {
            if c == ';' {
                fk.c(':');
            } else {
                fk.c(c);
            }
        }
        if kk + 1 < chain.len {
            fk.c(';');
        }
    }
    let skey = u.intern(fk.done());
    let mut stk = p.stacks.get(skey);
    if u.isnil(stk) {
        stk = u.new.[ProfStack]();
        stk.key = skey;
        p.stacks.put(skey, stk);
        p.stackv.push(stk);
    }
    stk.count += count;
}

fn report_json(p: *Profile, status: i32, folded_path: []u8, wrote: bool) void {
    let n = sample_count(p);
    let secs = seconds(p);
    u.print(u.f2("{\"schema\":\"axiom-profile/1\",\"samples\":%s,\"hz\":%s,\"clock\":", u.dec(p.nsamples),
                 u.idec(p.hz)));
    dg.json_str_out(p.clock);
    u.print(u.f4(",\"seconds\":%s,\"dropped\":%s,\"truncated\":%s,\"exit_status\":%s,\"folded\":", u.ffmt("%.3f", secs),
                 u.dec(p.dropped), u.dec(p.truncated), u.idec(status)));
    dg.json_str_out(u.pick(wrote, folded_path, ""));
    u.print(",\"functions\":[");
    for i in 0..p.fnv.len {
        let pf = p.fnv.get(i);
        u.print(u.pick(i != 0, ",", ""));
        u.print("\n  {\"name\":");
        dg.json_str_out(pf.name);
        u.print(u.f4(",\"self\":%s,\"total\":%s,\"self_pct\":%s,\"total_pct\":%s}", u.dec(pf.self_), u.dec(pf.total),
                     u.ffmt("%.1f", pct(pf.self_, n)), u.ffmt("%.1f", pct(pf.total, n))));
    }
    u.print("],\"call_sites\":[");
    for i in 0..p.sitev.len {
        let ps = p.sitev.get(i);
        let lc = u.span_linecol(ps.sp);
        u.print(u.pick(i != 0, ",", ""));
        u.print("\n  {\"file\":");
        dg.json_str_out(u.file_of(ps.sp.file).display);
        u.print(u.f2(",\"line\":%s,\"col\":%s,\"caller\":", u.idec(lc.sl), u.idec(lc.sc)));
        dg.json_str_out(ps.caller);
        u.print(",\"callee\":");
        dg.json_str_out(ps.callee);
        u.print(u.f2(",\"total\":%s,\"total_pct\":%s,\"context\":", u.dec(ps.total), u.ffmt("%.1f", pct(ps.total, n))));
        dg.json_str_out(u.source_line(ps.sp));
        u.print("}");
    }
    u.print("]}\n");
}

fn report_text(p: *Profile, status: i32, folded_path: []u8, wrote: bool) void {
    let n = sample_count(p);
    let nfn = @min(p.fnv.len, 25);
    let nsite = @min(p.sitev.len, 15);
    u.print(u.f4("profile: %s samples at %s Hz (%s time, %s s)", u.dec(p.nsamples), u.idec(p.hz), p.clock,
                 u.ffmt("%.2f", seconds(p))));
    if status != 0 {
        u.print(u.f1("; the program exited with status %s", u.idec(status)));
    }
    u.print("\n\n  self%  total%  function\n");
    for i in 0..nfn {
        let pf = p.fnv.get(i);
        u.print(u.f3("%s %s  %s\n", u.ffmt("%7.1f", pct(pf.self_, n)), u.ffmt("%7.1f", pct(pf.total, n)), pf.name));
    }
    if p.fnv.len > nfn {
        u.print(u.f1("  ... %s more functions\n", u.zdec(p.fnv.len - nfn)));
    }
    if nsite != 0 {
        u.print("\n total%  call site\n");
    }
    for i in 0..nsite {
        let ps = p.sitev.get(i);
        let lc = u.span_linecol(ps.sp);
        u.print(u.f6("%s  %s:%s:%s  %s -> %s\n", u.ffmt("%7.1f", pct(ps.total, n)), u.file_of(ps.sp.file).display,
                     u.idec(lc.sl), u.idec(lc.sc), ps.caller, ps.callee));
    }
    if p.truncated != 0 {
        u.print(u.f1("\n%s samples were deeper than 256 calls; their outer frames are not known\n",
                     u.dec(p.truncated)));
    }
    if p.dropped != 0 {
        u.print(u.f1("%s samples were dropped (sample buffer full)\n", u.dec(p.dropped)));
    }
    if wrote {
        u.print(u.f1("\nfolded stacks: %s (for flamegraph.pl, inferno or speedscope)\n", folded_path));
    }
}

// The number of samples, for percentages (1 if there are none).
fn sample_count(p: *Profile) f64 {
    if p.nsamples != 0 {
        return @float_from_int(f64, p.nsamples);
    }
    return 1.0;
}

fn seconds(p: *Profile) f64 {
    return @float_from_int(f64, p.nsamples) / @float_from_int(f64, p.hz);
}

pub fn run_profile(bin: []u8, prog_args: [][]u8, std_dir: []u8, folded_path: []u8, hz: i32, json: bool) i32 {
    let mut status: i32 = 0;
    let text = record(bin, prog_args, std_dir, hz, json, &mut status);
    if u.isnos(text) {
        return 2;
    }
    let mut p = Profile.{ fns: u.SymMap.[*mut ProfFn].{ keys: u.nil.[usize](), vals: u.nil.[*mut ProfFn](), cap: 0,
                                                        len: 0 },
                          sites: u.SymMap.[*mut ProfSite].{ keys: u.nil.[usize](), vals: u.nil.[*mut ProfSite](),
                                                            cap: 0, len: 0 },
                          stacks: u.SymMap.[*mut ProfStack].{ keys: u.nil.[usize](), vals: u.nil.[*mut ProfStack](),
                                                              cap: 0, len: 0 }, fnv: u.List.[*mut ProfFn].empty(),
                          sitev: u.List.[*mut ProfSite].empty(), stackv: u.List.[*mut ProfStack].empty(), nsamples: 0,
                          dropped: 0, stamp: 0, truncated: 0, hz: hz, clock: "cpu" };
    let lines = u.split(text, '\n', 0xFFFF_FFFF);
    for li in 0..lines.len {
        let line = lines.get(li);
        if u.starts(line, "hz ") {
            p.hz = @truncate(i32, u.atol(line[3..]));
        } else if u.starts(line, "clock ") {
            p.clock = u.dup(line[6..]);
        } else if u.starts(line, "dropped ") {
            p.dropped = u.atol(line[8..]);
        } else if u.starts(line, "S\t") {
            add_sample(&mut p, line);
        }
    }
    u.sort(p.fnv.items(), cmp_fn);
    u.sort(p.sitev.items(), cmp_site);
    u.sort(p.stackv.items(), cmp_stack);
    let mut fb = u.Buf.init();
    for i in 0..p.stackv.len {
        fb.s(u.f2("%s %s\n", p.stackv.get(i).key, u.dec(p.stackv.get(i).count)));
    }
    let wrote = u.write_file(folded_path, fb.done());
    if json {
        report_json(&p, status, folded_path, wrote);
    } else {
        report_text(&p, status, folded_path, wrote);
    }
    if status == 0 {
        return 0;
    }
    return 1;
}
