// =============================================================================
// sema.ax - semantic analysis: name registration, type resolution,
// expression and statement checking. (One module: its parts are mutually
// recursive.) The modules come from modload.ax; the builtins are checked by
// semabuiltin.ax (which calls back through functions sema.run gives it);
// the checks that wait for the end of the analysis are semapost.ax's.
// =============================================================================
import "ast.ax" as ast;
import "diag.ax" as dg;
import "lexer.ax" as lx;
import "modload.ax" as modl;
import "semabuiltin.ax" as sb;
import "semapost.ax" as spost;
import "target.ax" as tg;
import "types.ax" as ty;
import "util.ax" as u;

pub struct SemaOptions {
    pub std_dir: []u8,
    // Extra modules to load after the root (axiom test <package> loads
    // every source file of the package).
    pub extra_files: [][]u8,
}

// Context for resolving type expressions: which generic parameters and
// which `Self` are in scope.
struct TypeCtx {
    mod: *mut ast.Module,
    gowner: *mut ast.Decl,  // struct/union whose generic params are in scope
    gfn: *mut ast.Decl,     // function whose generic params are in scope
    self_: *mut ast.Type,   // `Self`, or nil
}

struct ScopeEntry {
    name: []u8,
    local: *mut ast.Local,
}

struct MoveSnap {
    moved: []mut bool,
    spans: []mut u.Span,
    origins: []mut *mut ast.Local,
    origin_fields: []mut u64,
    n: usize,
}

struct LoopMove {
    base: usize,
    pre: MoveSnap,
    brk: MoveSnap,
    reported: []mut u.Span,
    pre_dead: bool,
    has_break: bool,
}

struct MatchFlow {
    nloc: usize,
    pre: MoveSnap,
    acc: MoveSnap,
    pre_dead: bool,
    any_live: bool,
}

struct FnCtx {
    tc: TypeCtx,
    fnd: *mut ast.Decl,  // nil when checking a const/global initializer
    ret: *mut ast.Type,  // declared return type
    scope: u.List.[ScopeEntry],
    marks: u.List.[usize],
    locals: u.List.[*mut ast.Local],
    loop_moves: u.List.[LoopMove],
    loop_depth: i32,
    defer_depth: i32,
    defer_loop_base: i32,        // loop_depth when the innermost defer began
    loop_breaks: u.List.[bool],  // per enclosing loop: has a break targeting it
    loop_labels: u.List.[[]u8],  // per enclosing loop: its label, or an empty string
    const_ctx: bool,
    in_return: bool,
    flow_dead: bool,
    skip_moved_check: bool,
    ret_err_open: bool,
    ret_errs: u.List.[[]u8],
}

threadlocal let mut C: *mut FnCtx = @ptr_from_int(*mut FnCtx, 0);

fn tnil() *mut ast.Type {
    return u.nil.[ast.Type]();
}

fn dnil() *mut ast.Decl {
    return u.nil.[ast.Decl]();
}

fn fn_ctx(tc: TypeCtx) FnCtx {
    return FnCtx.{
        tc: tc,
        fnd: dnil(),
        ret: tnil(),
        scope: u.List.[ScopeEntry].empty(),
        marks: u.List.[usize].empty(),
        locals: u.List.[*mut ast.Local].empty(),
        loop_moves: u.List.[LoopMove].empty(),
        loop_depth: 0,
        defer_depth: 0,
        defer_loop_base: 0,
        loop_breaks: u.List.[bool].empty(),
        loop_labels: u.List.[[]u8].empty(),
        const_ctx: false,
        in_return: false,
        flow_dead: false,
        skip_moved_check: false,
        ret_err_open: false,
        ret_errs: u.List.[[]u8].empty(),
    };
}

// ---------------------------------------------------------------------------
// nocopy & move tracking (spec §5.9: E0708, E0709)
// ---------------------------------------------------------------------------
pub fn type_is_nocopy(t: *mut ast.Type) bool {
    if u.isnil(t) {
        return false;
    }
    let k = t.kind;
    if k == ast.TY_STRUCT {
        if u.isnil(t.decl) {
            return false;
        }
        if t.decl.is_nocopy {
            return true;
        }
        if t.decl.nocopy_visiting {
            return false;
        }
        t.decl.nocopy_visiting = true;
        if t.decl.state == ast.DeclState.UNRESOLVED {
            resolve_decl(t.decl);
        }
        let mut res = false;
        for i in 0..t.decl.fields.len {
            let ft = ty.type_field(t, i);
            if u.notnil(ft) and type_is_nocopy(ft) {
                res = true;
                break;
            }
        }
        t.decl.nocopy_visiting = false;
        return res;
    }
    if k == ast.TY_UNION {
        if u.isnil(t.decl) {
            return false;
        }
        if t.decl.is_nocopy {
            return true;
        }
        if t.decl.nocopy_visiting {
            return false;
        }
        t.decl.nocopy_visiting = true;
        if t.decl.state == ast.DeclState.UNRESOLVED {
            resolve_decl(t.decl);
        }
        let mut res = false;
        for i in 0..t.decl.variants.len {
            let vt = ty.type_variant(t, i);
            if u.notnil(vt) and type_is_nocopy(vt) {
                res = true;
                break;
            }
        }
        t.decl.nocopy_visiting = false;
        return res;
    }
    if (k == ast.TY_ARRAY) or (k == ast.TY_OPT) or (k == ast.TY_ERRUNION) {
        return type_is_nocopy(t.elem);
    }
    return false;
}

fn unwrap_conv(e0: *mut ast.Expr) *mut ast.Expr {
    let mut e = e0;
    while u.notnil(e) and (e.kind == ast.E_CONV) {
        e = e.a;
    }
    return e;
}

fn check_no_copy(e0: *mut ast.Expr) void {
    let e = unwrap_conv(e0);
    if u.isnil(e) or u.isnil(e.ty) or (e.ty.kind == ast.TY_INVALID) {
        return;
    }
    if is_place(e) and type_is_nocopy(e.ty) {
        if (e.kind == ast.E_IDENT) and u.notnil(ast.local_of(e)) and ast.local_of(e).moved {
            return;
        }
        _ = dg.err(e.span, "E0708", u.f1("cannot copy nocopy value of type %s", tstr(e.ty)));
    }
}

fn move_or_check_nocopy(e0: *mut ast.Expr) void {
    let e = unwrap_conv(e0);
    if u.isnil(e) or u.isnil(e.ty) or (e.ty.kind == ast.TY_INVALID) {
        return;
    }
    if not type_is_nocopy(e.ty) {
        return;
    }
    if (e.kind == ast.E_IDENT) and u.notnil(ast.local_of(e)) {
        let l = ast.local_of(e);
        if not C.flow_dead and not l.moved {
            l.moved = true;
            l.moved_span = e.span;
        }
        return;
    }
    check_no_copy(e);
}

fn save_moves(n: usize) MoveSnap {
    let m = u.newn.[bool](n);
    let sp = u.newn.[u.Span](n);
    let orig = u.newn.[*mut ast.Local](n);
    let oflds = u.newn.[u64](n);
    for i in 0..n {
        let l = C.locals.get(i);
        m[i] = l.moved;
        sp[i] = l.moved_span;
        orig[i] = l.origin_local;
        oflds[i] = l.origin_fields;
    }
    return MoveSnap.{ moved: m, spans: sp, origins: orig, origin_fields: oflds, n: n };
}

fn restore_moves(s: MoveSnap) void {
    for i in 0..s.n {
        let l = C.locals.get(i);
        l.moved = s.moved[i];
        l.moved_span = s.spans[i];
        l.origin_local = s.origins[i];
        l.origin_fields = s.origin_fields[i];
    }
}

fn merge_moves_or(a: MoveSnap, b: MoveSnap) void {
    for i in 0..a.n {
        let l = C.locals.get(i);
        if a.moved[i] {
            l.moved = true;
            l.moved_span = a.spans[i];
        } else if (i < b.n) and b.moved[i] {
            l.moved = true;
            l.moved_span = b.spans[i];
        } else {
            l.moved = false;
        }
        if u.notnil(a.origins[i]) {
            l.origin_local = a.origins[i];
        } else if (i < b.n) and u.notnil(b.origins[i]) {
            l.origin_local = b.origins[i];
        } else {
            l.origin_local = u.nil.[ast.Local]();
        }
        let mut ofld = a.origin_fields[i];
        if i < b.n {
            ofld = ofld | b.origin_fields[i];
        }
        l.origin_fields = ofld;
    }
}

fn or_moves_into(dst: *mut MoveSnap, n: usize) void {
    let k = @min(dst.n, n);
    for i in 0..k {
        let l = C.locals.get(i);
        if l.moved and not dst.moved[i] {
            dst.moved[i] = true;
            dst.spans[i] = l.moved_span;
        }
        if u.notnil(l.origin_local) and u.isnil(dst.origins[i]) {
            dst.origins[i] = l.origin_local;
        }
        dst.origin_fields[i] = dst.origin_fields[i] | l.origin_fields;
    }
}

fn or_snap_into(dst: *mut MoveSnap, src: MoveSnap) void {
    let k = @min(dst.n, src.n);
    for i in 0..k {
        if src.moved[i] and not dst.moved[i] {
            dst.moved[i] = true;
            dst.spans[i] = src.spans[i];
        }
        if u.notnil(src.origins[i]) and u.isnil(dst.origins[i]) {
            dst.origins[i] = src.origins[i];
        }
        dst.origin_fields[i] = dst.origin_fields[i] | src.origin_fields[i];
    }
}

fn span_eq(a: u.Span, b: u.Span) bool {
    return (a.file == b.file) and (a.start == b.start) and (a.end == b.end);
}

fn check_loop_backedge(lm: *mut LoopMove, err_sp: u.Span, has_sp: bool) void {
    for i in 0..lm.base {
        let l = C.locals.get(i);
        if l.moved and not lm.pre.moved[i] {
            if not span_eq(lm.reported[i], l.moved_span) {
                let mut sp = l.moved_span;
                if has_sp {
                    sp = err_sp;
                }
                let d = dg.err(sp, "E0709", u.f1("use of moved value '%s'", l.name));
                dg.note(d, l.moved_span, "value moved here");
                lm.reported[i] = l.moved_span;
            }
        }
    }
}

fn match_flow_begin() MatchFlow {
    let nloc = C.locals.len;
    let pre = save_moves(nloc);
    let acc = MoveSnap.{
        moved: u.newn.[bool](nloc),
        spans: u.newn.[u.Span](nloc),
        origins: u.newn.[*mut ast.Local](nloc),
        origin_fields: u.newn.[u64](nloc),
        n: nloc,
    };
    return MatchFlow.{ nloc: nloc, pre: pre, acc: acc, pre_dead: C.flow_dead, any_live: false };
}

fn match_flow_arm_begin(mf: *MatchFlow) void {
    restore_moves(mf.pre);
    C.flow_dead = mf.pre_dead;
}

fn match_flow_arm_end(mf: *mut MatchFlow, div_arm: bool) void {
    if not div_arm and not mf.pre_dead {
        mf.any_live = true;
        or_moves_into(&mut mf.acc, mf.nloc);
    }
}

fn match_flow_end(mf: *MatchFlow, narms: usize) void {
    if narms == 0 {
        return;
    }
    if not mf.any_live {
        restore_moves(mf.pre);
        C.flow_dead = true;
    } else {
        restore_moves(mf.acc);
        C.flow_dead = mf.pre_dead;
    }
}

fn type_ctx(m: *mut ast.Module, gowner: *mut ast.Decl, gfn: *mut ast.Decl, self_: *mut ast.Type) TypeCtx {
    return TypeCtx.{ mod: m, gowner: gowner, gfn: gfn, self_: self_ };
}

fn tstr(t: *ast.Type) []u8 {
    return ty.type_str(t);
}

fn set_ty(e: *mut ast.Expr, t: *mut ast.Type) *mut ast.Type {
    e.ty = t;
    return t;
}

fn sp_at(sp: u.Span) u.Span {
    return u.mkspan(sp.file, sp.start, sp.start);
}

fn error_code_here(name: []u8) u32 {
    let mut m = u.nil.[ast.Module]();
    if u.notnil(C) {
        m = C.tc.mod;
        if u.isnil(m) and u.notnil(C.fnd) {
            m = C.fnd.module;
        }
    }
    if u.notnil(m) {
        m.error_uses.push(name);
    } else {
        modl.g_error_use_unknown = true;
    }
    return error_code_of(name);
}

// ---------------------------------------------------------------------------
// Registration
// ---------------------------------------------------------------------------
fn is_constraint_name(s: []u8) bool {
    let c = ty.constraint_from_name(s);
    return (c != ast.C_NONE) and (c >= 0);
}

// The parser's name for a name it did not find (after reporting it): not
// checked for duplicates, which in a list of them would take time in the
// square of its length.
fn placeholder(name: []u8) bool {
    return u.str_eq(name, "<error>");
}

fn dup_error(sp: u.Span, name: []u8, prev: u.Span) void {
    if placeholder(name) {
        return;
    }
    let d = dg.err(sp, "E0201", u.f1("'%s' is already declared", name));
    dg.note(d, prev, u.f1("previous declaration of '%s'", name));
}

fn register_module(m: *mut ast.Module) void {
    for i in 0..m.decls.len {
        let d = m.decls.get(i);
        if u.isnos(d.name) {
            continue;
        }
        if d.is_test {  // tests are not names; their descriptions must be unique per module
            for j in 0..i {
                let o = m.decls.get(j);
                if o.is_test and u.same(o.test_name, d.test_name) {
                    let g = dg.err(d.name_span, "E0312", u.f1("duplicate test name \"%s\"", d.test_name));
                    dg.note(g, o.name_span, "first defined here");
                }
            }
            continue;
        }
        if is_constraint_name(d.name) {
            _ = dg.err(d.name_span, "E0206", u.f1("'%s' is a reserved constraint name", d.name));
            continue;
        }
        let mut prev = m.names.get(d.name);
        if u.isnil(prev) {
            prev = m.imports.get(d.name);
        }
        if u.notnil(prev) {
            dup_error(d.name_span, d.name, prev.name_span);
            continue;
        }
        if d.kind == ast.D_IMPORT {
            m.imports.put(d.name, d);
        } else {
            m.names.put(d.name, d);
        }
        if (d.kind == ast.D_STRUCT) or (d.kind == ast.D_UNION) or (d.kind == ast.D_ENUM) {
            for j in 0..d.methods.len {
                let md = d.methods.get(j);
                md.module = m;
                let pm = d.method_map.get(md.name);
                if u.notnil(pm) {
                    dup_error(md.name_span, md.name, pm.name_span);
                    continue;
                }
                d.method_map.put(md.name, md);
            }
            for j in 0..d.fields.len {
                if placeholder(d.fields.at(j).name) {
                    continue;
                }
                for k in 0..j {
                    if u.same(d.fields.at(j).name, d.fields.at(k).name) {
                        dup_error(d.fields.at(j).span, d.fields.at(j).name, d.fields.at(k).span);
                    }
                }
            }
            for j in 0..d.variants.len {
                if placeholder(d.variants.at(j).name) {
                    continue;
                }
                for k in 0..j {
                    if u.same(d.variants.at(j).name, d.variants.at(k).name) {
                        dup_error(d.variants.at(j).span, d.variants.at(j).name, d.variants.at(k).span);
                    }
                }
            }
        }
    }
}

fn sym_cmp(a: []u8, b: []u8) i32 {
    return u.str_cmp(a, b);
}

fn assign_error_codes() void {
    let mut seen = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    let mut names = u.List.[[]u8].empty();
    // Prelude: errors produced by builtins and the standard library.
    let prelude = [u.intern("OutOfMemory"), u.intern("Overflow")];
    for p in prelude {
        seen.put(p, 1);
        names.push(p);
    }
    for mi in 0..modl.g_prog.modules.len {
        let m = modl.g_prog.modules.get(mi);
        for i in 0..m.decls.len {
            let d = m.decls.get(i);
            if d.kind != ast.D_ERROR {
                continue;
            }
            for j in 0..d.error_names.len {
                let n = d.error_names.get(j);
                if seen.get(n) != 0 {
                    continue;
                }
                seen.put(n, 1);
                names.push(n);
            }
        }
        for j in 0..m.inline_error_names.len {
            let n = m.inline_error_names.get(j);
            if seen.get(n) != 0 {
                continue;
            }
            seen.put(n, 1);
            names.push(n);
        }
    }
    u.sort(names.items_mut(), sym_cmp);
    for i in 0..names.len {
        modl.g_prog.error_names.push(names.get(i));
        modl.g_prog.error_codes.put(names.get(i), @int_cast(i32, i) + 1);
    }
    if names.len > 65535 {
        _ = dg.err(modl.g_prog.root.decls.get(0).span, "E0651", "too many error names");
    }
}

// 0 if undeclared.
pub fn error_code_of(name: []u8) u32 {
    return @int_cast(u32, modl.g_prog.error_codes.get(name));
}

// ---------------------------------------------------------------------------
// Lookup helpers
// ---------------------------------------------------------------------------
pub fn module_lookup(m: *mut ast.Module, name: []u8) *mut ast.Decl {
    if u.isnil(m) {
        return dnil();
    }
    return m.names.get(name);
}

fn find_method(owner: *mut ast.Decl, name: []u8) *mut ast.Decl {
    return owner.method_map.get(name);
}

fn find_variant(d: *mut ast.Decl, name: []u8) i32 {
    for i in 0..d.variants.len {
        if u.same(d.variants.at(i).name, name) {
            return @int_cast(i32, i);
        }
    }
    return -1;
}

fn ensure_gparams(d: *mut ast.Decl) void {
    if d.gparams_done or d.gparams_resolving {
        return;
    }
    d.gparams_resolving = true;
    let mut gowner = d;
    let mut gfn = dnil();
    let mut oself = tnil();
    if u.notnil(d.owner) {
        if d.owner.state == ast.DeclState.UNRESOLVED {
            resolve_decl(d.owner);
        }
        ensure_gparams(d.owner);
        gowner = d.owner;
        gfn = d;
        oself = d.owner.ty;
    } else if (d.kind == ast.D_FN) or (d.kind == ast.D_HOST_FN) {
        gowner = dnil();
        gfn = d;
    }
    for i in 0..d.gparams.len {
        let g = d.gparams.at_mut(i);
        if u.notnil(g.ty) {
            continue;
        }
        let mut c = ast.C_NONE;
        let mut ct = tnil();
        let mut lane = tnil();
        if g.is_const {
            let mut tc = type_ctx(d.module, gowner, gfn, oself);
            ct = resolve_type(g.const_te, &mut tc);
            if (ct.kind != ast.TY_INT) and (ct.kind != ast.TY_FN) and (ct.kind != ast.TY_INVALID) {
                _ = dg.err(g.const_te.span, "E0471",
                           u.f1("const generic parameter must have an integer or function type, found %s", tstr(ct)));
                ct = ty.t_usize;
            }
            g.ty = ty.type_param(d, @int_cast(i32, i), g.name, c, g.is_const, ct);
        } else if g.is_error {
            g.ty = ty.type_err_param(d, @int_cast(i32, i), g.name);
        } else {
            if not u.isnos(g.constraint) {
                let mut cc = ty.constraint_from_name(g.constraint);
                if cc < 0 {
                    _ = dg.err(g.constraint_span, "E0470",
                               u.f1("unknown constraint '%s' (expected Eq, Ord, Num, Int, SignedInt, UnsignedInt, Float, FloatVector, IntVector or Vector)",
                                    g.constraint));
                    cc = ast.C_NONE;
                } else if (cc == ast.C_FLOAT_VEC) or (cc == ast.C_INT_VEC) or (cc == ast.C_VEC) {
                    if u.isnil(g.constraint_te) {
                        _ = dg.err(g.constraint_span, "E0470",
                                   u.f2("vector constraint '%s' requires a lane type, e.g. %s[f32]", g.constraint,
                                        g.constraint));
                    } else {
                        let mut tc = type_ctx(d.module, gowner, gfn, oself);
                        let lt = resolve_type(g.constraint_te, &mut tc);
                        if lt.kind != ast.TY_INVALID {
                            let mut ok = false;
                            if cc == ast.C_FLOAT_VEC {
                                ok = (lt.kind == ast.TY_FLOAT) or
                                     ((lt.kind == ast.TY_PARAM) and not lt.is_const and ty.satisfies(lt, ast.C_FLOAT));
                            } else if cc == ast.C_INT_VEC {
                                ok = ((lt.kind == ast.TY_INT) and not lt.is_size) or
                                     ((lt.kind == ast.TY_PARAM) and not lt.is_const and ty.satisfies(lt, ast.C_INT));
                            } else {
                                ok = (lt.kind == ast.TY_FLOAT) or ((lt.kind == ast.TY_INT) and not lt.is_size) or
                                     ((lt.kind == ast.TY_PARAM) and not lt.is_const and ty.satisfies(lt, ast.C_NUM));
                            }
                            if ok {
                                lane = lt;
                            } else {
                                _ = dg.err(g.constraint_te.span, "E0470",
                                           u.f2("invalid lane type %s for constraint '%s'", tstr(lt), g.constraint));
                            }
                        }
                    }
                } else if u.notnil(g.constraint_te) {
                    _ = dg.err(g.constraint_te.span, "E0470",
                               u.f1("constraint '%s' does not take a lane type parameter", g.constraint));
                }
                c = cc;
            }
            g.ty = ty.type_param(d, @int_cast(i32, i), g.name, c, g.is_const, ct);
            g.ty.constraint_lane = lane;
        }
        for j in 0..i {
            if placeholder(g.name) {
                break;
            }
            if u.same(d.gparams.at(j).name, g.name) {
                dup_error(g.span, g.name, d.gparams.at(j).span);
            }
        }
    }
    d.gparams_resolving = false;
    d.gparams_done = true;
}

fn decl_gparam_types(d: *mut ast.Decl) []mut *mut ast.Type {
    ensure_gparams(d);
    let ts = u.newn.[*mut ast.Type](d.gparams.len);
    for i in 0..d.gparams.len {
        ts[i] = d.gparams.at_mut(i).ty;
    }
    return ts;
}

fn make_self_type(d: *mut ast.Decl) *mut ast.Type {
    return ty.type_named(d, decl_gparam_types(d));
}

fn lookup_gparam(tc: *mut TypeCtx, name: []u8) *mut ast.Type {
    let ds = [tc.gfn, tc.gowner];
    for d in ds {
        if u.isnil(d) {
            continue;
        }
        ensure_gparams(d);
        for i in 0..d.gparams.len {
            if u.same(d.gparams.at(i).name, name) {
                return d.gparams.at_mut(i).ty;
            }
        }
    }
    return tnil();
}

// ---------------------------------------------------------------------------
// Type resolution
// ---------------------------------------------------------------------------
fn resolve_named_decl(nt: ast.NamedType, sp: u.Span, tc: *mut TypeCtx, report: bool) *mut ast.Decl {
    let m = tc.mod;
    if not u.isnos(nt.qual) {
        let imp = m.imports.get(nt.qual);
        if u.isnil(imp) {
            if report {
                _ = dg.err(sp, "E0202", u.f1("unknown module '%s'", nt.qual));
            }
            return dnil();
        }
        if u.isnil(imp.imported) {
            return dnil();
        }
        let d = module_lookup(imp.imported, nt.name);
        if u.isnil(d) {
            if report {
                _ = dg.err(nt.name_span, "E0202", u.f2("module '%s' has no declaration '%s'", nt.qual, nt.name));
            }
            return dnil();
        }
        if not d.is_pub {
            if report {
                _ = dg.err(nt.name_span, "E0203", u.f2("'%s' is not public in module '%s'", nt.name, nt.qual));
            }
            return dnil();
        }
        return d;
    }
    let d = module_lookup(m, nt.name);
    if u.isnil(d) and report {
        _ = dg.err(nt.name_span, "E0202", u.f1("unknown type '%s'", nt.name));
    }
    return d;
}

fn type_has_invalid(t: *ast.Type) bool {
    if u.isnil(t) {
        return true;
    }
    let k = t.kind;
    if k == ast.TY_INVALID {
        return true;
    }
    if (k == ast.TY_PTR) or (k == ast.TY_SLICE) or (k == ast.TY_ARRAY) or (k == ast.TY_OPT) {
        return type_has_invalid(t.elem);
    }
    if k == ast.TY_ERRUNION {
        return type_has_invalid(t.elem) or (u.notnil(t.err_param) and type_has_invalid(t.err_param));
    }
    if k == ast.TY_FN {
        for p in t.params {
            if type_has_invalid(p) {
                return true;
            }
        }
        return type_has_invalid(t.ret);
    }
    if (k == ast.TY_STRUCT) or (k == ast.TY_UNION) {
        for a in t.args {
            if type_has_invalid(a) {
                return true;
            }
        }
        return false;
    }
    if k == ast.TY_CONSTFN {
        for a in t.args {
            if type_has_invalid(a) {
                return true;
            }
        }
        return type_has_invalid(t.const_type);
    }
    return false;
}

fn constraint_str(c: i32, lane: *ast.Type) []u8 {
    if u.notnil(lane) and ((c == ast.C_FLOAT_VEC) or (c == ast.C_INT_VEC) or (c == ast.C_VEC)) {
        return u.f2("%s[%s]", ty.constraint_name(c), tstr(lane));
    }
    return ty.constraint_name(c);
}

fn resolve_constfn_decl(d: *mut ast.Decl, owner_args: []mut *mut ast.Type, fn_arg_tes: *u.List.[*mut ast.TypeExpr],
                        has_fn_args: bool, sp: u.Span, name_span: u.Span, tc: *mut TypeCtx) *mut ast.Type {
    resolve_decl(d);
    if (d.state != ast.DeclState.DONE) or u.isnil(d.ty) {
        return ty.t_invalid;
    }
    if (d.kind == ast.D_HOST_FN) and d.cabi {
        _ = dg.err(name_span, "E0801",
                   u.f1("the C function '%s' takes or returns a structure by value: it can only be called, not used as a function value",
                        d.name));
        return ty.t_invalid;
    }
    if d.gparams.len == 0 {
        if has_fn_args {
            _ = dg.err(sp, "E0468", u.f1("'%s' is not generic", d.name));
            return ty.t_invalid;
        }
        ensure_infer_ret(d);
        let mut fn_ty = d.ty;
        if owner_args.len != 0 {
            fn_ty = ty.subst(d.ty, d.all_gparams, owner_args);
        }
        return ty.type_constfn(d, owner_args, fn_ty);
    }
    if not has_fn_args {
        let g = dg.err(sp, "E0466", u.f2("generic function '%s' must be instantiated before use: %s.[...]", d.name,
                                         d.name));
        dg.note(g, d.name_span, u.f1("'%s' declared here", d.name));
        return ty.t_invalid;
    }
    let margs = u.newn.[*mut ast.Type](fn_arg_tes.len);
    for i in 0..fn_arg_tes.len {
        margs[i] = resolve_generic_arg(fn_arg_tes.get(i), tc);
    }
    if not check_generic_args_ctx(d, owner_args, margs, sp, fn_arg_tes) {
        return ty.t_invalid;
    }
    let all_args = u.newn.[*mut ast.Type](owner_args.len + margs.len);
    for i in 0..owner_args.len {
        all_args[i] = owner_args[i];
    }
    for i in 0..margs.len {
        all_args[owner_args.len + i] = margs[i];
    }
    ensure_infer_ret(d);
    let fn_ty = ty.subst(d.ty, d.all_gparams, all_args);
    return ty.type_constfn(d, all_args, fn_ty);
}

// A generic argument: a type, an integer literal, a const name, or a function.
fn resolve_generic_arg(te: *mut ast.TypeExpr, tc: *mut TypeCtx) *mut ast.Type {
    match te.shape {
        .IntLit(v) => { return ty.type_constint(@bit_cast(i64, v)); }
        .Named(nt) => {
            if nt.has_member {
                let base_nt = ast.NamedType.{
                    qual: nt.qual,
                    name: nt.name,
                    name_span: nt.name_span,
                    args: nt.args,
                    has_args: nt.has_args,
                    has_member: false,
                    member: u.nosym(),
                    member_span: u.mkspan(0, 0, 0),
                    member_args: u.List.[*mut ast.TypeExpr].empty(),
                    has_member_args: false,
                };
                let td = resolve_named_decl(base_nt, te.span, tc, true);
                if u.isnil(td) {
                    return ty.t_invalid;
                }
                if (td.kind != ast.D_STRUCT) and (td.kind != ast.D_UNION) and (td.kind != ast.D_ENUM) {
                    _ = dg.err(nt.name_span, "E0400", u.f1("'%s' is not a type", nt.name));
                    return ty.t_invalid;
                }
                resolve_decl(td);
                let mut owner_args = ty.no_types();
                if td.gparams.len == 0 {
                    if nt.has_args {
                        _ = dg.err(te.span, "E0468", u.f1("'%s' is not generic", nt.name));
                        return ty.t_invalid;
                    }
                } else {
                    if not nt.has_args {
                        let g = dg.err(te.span, "E0460", u.f2("generic type '%s' must be given arguments: %s.[...]",
                                                              td.name, td.name));
                        dg.note(g, td.name_span, u.f1("'%s' declared here", td.name));
                        return ty.t_invalid;
                    }
                    owner_args = u.newn.[*mut ast.Type](nt.args.len);
                    for i in 0..nt.args.len {
                        owner_args[i] = resolve_generic_arg(nt.args.get(i), tc);
                    }
                    if not check_generic_args(td, owner_args, te.span, &nt.args) {
                        return ty.t_invalid;
                    }
                }
                let md = find_method(td, nt.member);
                if u.isnil(md) {
                    _ = dg.err(nt.member_span, "E0404", u.f2("type %s has no method '%s'", td.name, nt.member));
                    return ty.t_invalid;
                }
                if not md.is_pub and (md.module != tc.mod) {
                    let g = dg.err(nt.member_span, "E0203", u.f1("'%s' is not public", nt.member));
                    dg.note(g, md.name_span, "declared here");
                    return ty.t_invalid;
                }
                return resolve_constfn_decl(md, owner_args, &nt.member_args, nt.has_member_args, te.span,
                                            nt.member_span, tc);
            }
            if not u.isnos(nt.qual) {
                let imp = tc.mod.imports.get(nt.qual);
                if u.notnil(imp) {
                    if u.isnil(imp.imported) {
                        return ty.t_invalid;
                    }
                    let d = module_lookup(imp.imported, nt.name);
                    if u.isnil(d) {
                        _ = dg.err(nt.name_span, "E0202", u.f2("module '%s' has no declaration '%s'", nt.qual,
                                                               nt.name));
                        return ty.t_invalid;
                    }
                    if not d.is_pub {
                        let g = dg.err(nt.name_span, "E0203", u.f2("'%s' is not public in module '%s'", nt.name,
                                                                   nt.qual));
                        dg.note(g, d.name_span, "declared here");
                        return ty.t_invalid;
                    }
                    if d.kind == ast.D_CONST {
                        if nt.has_args {
                            _ = dg.err(te.span, "E0468", u.f1("'%s' is not generic", nt.name));
                            return ty.t_invalid;
                        }
                        resolve_decl(d);
                        if u.notnil(d.cexpr) and d.cexpr.is_const and (d.ty.kind == ast.TY_INT) {
                            return ty.type_constint(ast.cval_of(d.cexpr).i64v());
                        }
                        _ = dg.err(te.span, "E0472", u.f1("const '%s' is not an integer constant", nt.name));
                        return ty.t_invalid;
                    }
                    if (d.kind == ast.D_FN) or (d.kind == ast.D_HOST_FN) {
                        return resolve_constfn_decl(d, ty.no_types(), &nt.args, nt.has_args, te.span, nt.name_span, tc);
                    }
                    return resolve_type(te, tc);
                }
                let td = module_lookup(tc.mod, nt.qual);
                if u.notnil(td) and ((td.kind == ast.D_STRUCT) or (td.kind == ast.D_UNION) or (td.kind == ast.D_ENUM)) {
                    resolve_decl(td);
                    if td.gparams.len != 0 {
                        let g = dg.err(te.span, "E0460", u.f2("generic type '%s' must be given arguments: %s.[...]",
                                                              td.name, td.name));
                        dg.note(g, td.name_span, u.f1("'%s' declared here", td.name));
                        return ty.t_invalid;
                    }
                    let md = find_method(td, nt.name);
                    if u.isnil(md) {
                        _ = dg.err(nt.name_span, "E0404", u.f2("type %s has no method '%s'", td.name, nt.name));
                        return ty.t_invalid;
                    }
                    if not md.is_pub and (md.module != tc.mod) {
                        let g = dg.err(nt.name_span, "E0203", u.f1("'%s' is not public", nt.name));
                        dg.note(g, md.name_span, "declared here");
                        return ty.t_invalid;
                    }
                    return resolve_constfn_decl(md, ty.no_types(), &nt.args, nt.has_args, te.span, nt.name_span, tc);
                }
            } else {
                let gp = lookup_gparam(tc, nt.name);
                if u.notnil(gp) {
                    if nt.has_args {
                        _ = dg.err(te.span, "E0468", u.f1("generic parameter '%s' cannot take arguments", nt.name));
                        return ty.t_invalid;
                    }
                    return gp;
                }
                let d = module_lookup(tc.mod, nt.name);
                if u.notnil(d) {
                    if d.kind == ast.D_CONST {
                        if nt.has_args {
                            _ = dg.err(te.span, "E0468", u.f1("'%s' is not generic", nt.name));
                            return ty.t_invalid;
                        }
                        resolve_decl(d);
                        if u.notnil(d.cexpr) and d.cexpr.is_const and (d.ty.kind == ast.TY_INT) {
                            return ty.type_constint(ast.cval_of(d.cexpr).i64v());
                        }
                        _ = dg.err(te.span, "E0472", u.f1("const '%s' is not an integer constant", nt.name));
                        return ty.t_invalid;
                    }
                    if (d.kind == ast.D_FN) or (d.kind == ast.D_HOST_FN) {
                        return resolve_constfn_decl(d, ty.no_types(), &nt.args, nt.has_args, te.span, nt.name_span, tc);
                    }
                } else if u.notnil(C) and (tc == &mut C.tc) and u.notnil(scope_lookup(nt.name)) {
                    _ = dg.err(te.span, "E0462",
                               u.f1("'%s' is a local variable and cannot be used as a generic argument", nt.name));
                    return ty.t_invalid;
                }
            }
        }
        else => {}
    }
    return resolve_type(te, tc);
}

fn check_generic_args_ctx(d: *mut ast.Decl, owner_args: []mut *mut ast.Type, args: []mut *mut ast.Type, sp: u.Span,
                          tes: *u.List.[*mut ast.TypeExpr]) bool {
    ensure_gparams(d);
    let n = args.len;
    if n != d.gparams.len {
        let gl = d.gparams.len;
        _ = dg.err(sp, "E0467", u.f5("'%s' takes %s generic argument%s, but %s %s given", d.name, u.zdec(gl),
                                     u.pick(gl == 1, "", "s"), u.zdec(n), u.pick(n == 1, "was", "were")));
        return false;
    }
    let mut nowner: usize = 0;
    if u.notnil(d.owner) and (owner_args.len == d.owner.gparams.len) {
        nowner = d.owner.gparams.len;
    }
    let from = u.newn.[*mut ast.Type](nowner + n);
    let to = u.newn.[*mut ast.Type](nowner + n);
    for j in 0..nowner {
        from[j] = d.owner.gparams.at_mut(j).ty;
        to[j] = owner_args[j];
    }
    let mut ok = true;
    for i in 0..n {
        let g = d.gparams.at_mut(i);
        let a = args[i];
        from[nowner + i] = g.ty;
        to[nowner + i] = a;
        let mut asp = sp;
        if u.notnil(tes) and (i < tes.len) {
            asp = tes.get(i).span;
        }
        if a.kind == ast.TY_INVALID {
            continue;
        }
        if g.is_const {
            let ct = ty.subst(g.ty.const_type, from[0..nowner + i], to[0..nowner + i]);
            if ct.kind == ast.TY_FN {
                if a.kind == ast.TY_CONSTFN {
                    if (a.const_type != ct) and not type_has_invalid(ct) and not type_has_invalid(a.const_type) {
                        let dg_e = dg.err(asp, "E0462", u.f3("generic parameter '%s' expects function %s, found %s",
                                                             g.name, tstr(ct), tstr(a.const_type)));
                        dg.note(dg_e, g.span, u.f1("'%s' declared here", g.name));
                        ok = false;
                    }
                } else if (a.kind == ast.TY_PARAM) and a.is_const {
                    let act = ty.subst(a.const_type, from[0..nowner + i], to[0..nowner + i]);
                    if act != ct {
                        let dg_e = dg.err(asp, "E0462", u.f3("generic parameter '%s' expects function %s, found %s",
                                                             g.name, tstr(ct), tstr(act)));
                        dg.note(dg_e, g.span, u.f1("'%s' declared here", g.name));
                        ok = false;
                    }
                } else {
                    let dg_e = dg.err(asp, "E0462", u.f3("generic parameter '%s' expects a %s function, found %s",
                                                         g.name, tstr(ct), tstr(a)));
                    dg.note(dg_e, g.span, u.f1("'%s' declared here", g.name));
                    ok = false;
                }
            } else if a.kind == ast.TY_CONSTINT {
                if not fits_type(u.I128.of(a.cval), ct) {
                    _ = dg.err(asp, "E0462", u.f3("value %s does not fit const parameter '%s' of type %s",
                                                  u.dec(a.cval), g.name, tstr(ct)));
                    ok = false;
                }
            } else if not ((a.kind == ast.TY_PARAM) and a.is_const and (a.const_type == ct)) {
                _ = dg.err(asp, "E0462", u.f3("generic parameter '%s' expects a %s constant, found %s", g.name,
                                              tstr(ct), tstr(a)));
                ok = false;
            }
        } else if g.is_error {
            if (a.kind != ast.TY_ERROR) and not ((a.kind == ast.TY_PARAM) and a.is_error_param) {
                _ = dg.err(asp, "E0654", u.f2("expected an error set for generic error parameter '%s', found %s",
                                              g.name, tstr(a)));
                ok = false;
            }
        } else {
            let expected_lane = ty.subst(g.ty.constraint_lane, from[0..nowner + i], to[0..nowner + i]);
            if (a.kind == ast.TY_CONSTINT) or (a.kind == ast.TY_CONSTFN) or ((a.kind == ast.TY_PARAM) and a.is_const) {
                _ = dg.err(asp, "E0462", u.f1("generic parameter '%s' expects a type, found a constant", g.name));
                ok = false;
            } else if not ty.satisfies_lane(a, g.ty.constraint, expected_lane) {
                let e = dg.err(asp, "E0462", u.f3("type %s does not satisfy constraint %s of parameter '%s'", tstr(a),
                                                  constraint_str(g.ty.constraint, expected_lane), g.name));
                dg.note(e, g.span, u.f1("'%s' declared here", g.name));
                ok = false;
            }
        }
    }
    return ok;
}

fn check_generic_args(d: *mut ast.Decl, args: []mut *mut ast.Type, sp: u.Span, tes: *u.List.[*mut ast.TypeExpr]) bool {
    return check_generic_args_ctx(d, ty.no_types(), args, sp, tes);
}

threadlocal let mut anon_errsets: u.SymMap.[*mut ast.Decl] = u.SymMap.[*mut ast.Decl].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut *mut ast.Decl, 0), cap: 0, len: 0 };

fn intern_anon_errset(names: *u.List.[[]u8]) *mut ast.Decl {
    let mut tmp = u.List.[[]u8].empty();
    for i in 0..names.len {
        tmp.push(names.get(i));
    }
    if tmp.len > 1 {
        u.sort(tmp.items_mut(), sym_cmp);
    }
    let mut uniq = u.List.[[]u8].empty();
    for i in 0..tmp.len {
        let n = tmp.get(i);
        if (uniq.len == 0) or not u.same(uniq.last(), n) {
            uniq.push(n);
        }
    }
    tmp.deinit();
    let mut cname = u.intern("{}");
    if uniq.len > 0 {
        let mut b = u.Buf.init();
        b.s("{ ");
        for i in 0..uniq.len {
            if i != 0 {
                b.s(", ");
            }
            b.s(uniq.get(i));
        }
        b.s(" }");
        cname = u.intern(b.done());
    }
    let known = anon_errsets.get(cname);
    if u.notnil(known) {
        uniq.deinit();
        return known;
    }
    let d = u.new.[ast.Decl]();
    d.kind = ast.D_ERROR;
    d.name = cname;
    d.is_anon = true;
    d.state = ast.DeclState.DONE;
    d.set_names = uniq;
    anon_errsets.put(cname, d);
    return d;
}

fn resolve_type(te: *mut ast.TypeExpr, tc: *mut TypeCtx) *mut ast.Type {
    if u.isnil(te) {
        return ty.t_invalid;
    }
    match te.shape {
        .Prim(p)           => { return ty.type_prim(p); }
        .Error             => { return ty.t_error; }
        .Invalid           => { return ty.t_invalid; }
        .ErrSetInline(ies) => { return ty.type_errset(intern_anon_errset(&ies.names)); }
        .SelfType => {
            if u.isnil(tc.self_) {
                _ = dg.err(te.span, "E0205", "'Self' is only available inside a struct or union");
                return ty.t_invalid;
            }
            return tc.self_;
        }
        .IntLit => {
            _ = dg.err(te.span, "E0400", "expected a type, found an integer");
            return ty.t_invalid;
        }
        .ConstExpr => {
            _ = dg.err(te.span, "E0400", "expected a type, found an expression");
            return ty.t_invalid;
        }
        .ErrUnion(eu) => {
            if eu.is_infer {
                _ = dg.err(te.span, "E0654", "'infer!T' is only allowed as the return type of a private function");
                let e = resolve_type(eu.elem, tc);
                if e.kind == ast.TY_ERRUNION {
                    return e;
                }
                return ty.type_errunion(e);
            }
            let mut set = dnil();
            let mut ep = tnil();
            if u.notnil(eu.set) {
                match eu.set.shape {
                    .ErrSetInline(ies) => { set = intern_anon_errset(&ies.names); }
                    .Named(nt) => {
                        if u.isnos(nt.qual) {
                            let gp = lookup_gparam(tc, nt.name);
                            if u.notnil(gp) {
                                if nt.has_args {
                                    _ = dg.err(eu.set.span, "E0468",
                                               u.f1("generic parameter '%s' cannot take arguments", nt.name));
                                }
                                if gp.is_error_param {
                                    ep = gp;
                                } else {
                                    _ = dg.err(nt.name_span, "E0654", u.f1("'%s' is not an error set", nt.name));
                                }
                            } else {
                                set = resolve_set_te(eu.set, tc);
                            }
                        } else {
                            set = resolve_set_te(eu.set, tc);
                        }
                    }
                    else => { set = resolve_set_te(eu.set, tc); }
                }
            }
            let e = resolve_type(eu.elem, tc);
            if e.kind == ast.TY_ERRUNION {
                _ = dg.err(te.span, "E0401", "nested error unions (!!T) are not allowed");
                return e;
            }
            if u.notnil(ep) {
                return spost.check_size(te.span, ty.type_errunion_param(e, ep));
            }
            return spost.check_size(te.span, ty.type_errunion_set(e, set));
        }
        .Opt(el) => {
            let e = resolve_type(el, tc);
            if e.kind == ast.TY_VOID {
                _ = dg.err(te.span, "E0404", "optional element type cannot be void");
                return ty.t_invalid;
            }
            return spost.check_size(te.span, ty.type_opt(e));
        }
        .Ptr(pt) => { return ty.type_ptr(resolve_type(pt.elem, tc), pt.is_mut); }
        .Slice(pt) => {
            let e = resolve_type(pt.elem, tc);
            if e.kind == ast.TY_VOID {
                _ = dg.err(te.span, "E0404", "slice element type cannot be void");
            }
            return ty.type_slice(e, pt.is_mut);
        }
        .Array(at) => { return resolve_array_type(te, at, tc); }
        .Fn(ft) => {
            let ps = u.newn.[*mut ast.Type](ft.params.len);
            for i in 0..ft.params.len {
                ps[i] = resolve_type(ft.params.get(i), tc);
            }
            return ty.type_fn(ps, resolve_type(ft.ret, tc));
        }
        .AnonStruct(fields) => {
            let mut fv = u.List.[ast.Field].empty();
            for i in 0..fields.len {
                let mut f = fields.get(i);
                f.ty = resolve_type(f.te, tc);
                for j in 0..i {
                    if placeholder(f.name) {
                        break;
                    }
                    if u.same(fv.at(j).name, f.name) {
                        dup_error(f.span, f.name, fv.at(j).span);
                    }
                }
                fv.push(f);
            }
            let d = ty.anon_struct_decl(tc.mod, fv, te.span);
            return spost.check_size(te.span, d.ty);
        }
        .Named(nt) => { return resolve_named_type(te, nt, tc); }
    }
}

fn resolve_array_type(te: *mut ast.TypeExpr, at: ast.ArrayType, tc: *mut TypeCtx) *mut ast.Type {
    let e = resolve_type(at.elem, tc);
    if e.kind == ast.TY_VOID {
        _ = dg.err(te.span, "E0404", "array element type cannot be void");
    }
    let l = at.len;
    if u.isnil(l) {
        return ty.t_invalid;
    }
    match l.shape {
        .IntLit(n) => {
            if n > 0x7fff_ffff_ffff_ffff {
                _ = dg.err(l.span, "E0472", "array length is too large");
                return ty.t_invalid;
            }
            return spost.check_size(te.span, ty.type_array(e, @bit_cast(i64, n)));
        }
        .ConstExpr(ce) => {
            let n = const_array_len(ce, tc);
            if n < 0 {
                return ty.t_invalid;
            }
            return spost.check_size(te.span, ty.type_array(e, n));
        }
        else => {}
    }
    let a = resolve_generic_arg(l, tc);
    if a.kind == ast.TY_CONSTINT {
        if a.cval < 0 {
            _ = dg.err(l.span, "E0472", "array length must not be negative");
            return ty.type_array(e, 0);
        }
        return spost.check_size(te.span, ty.type_array(e, a.cval));
    }
    if (a.kind == ast.TY_PARAM) and a.is_const and (a.const_type.kind == ast.TY_INT) {
        return ty.type_array_param(e, a);
    }
    if a.kind != ast.TY_INVALID {
        _ = dg.err(l.span, "E0472", "array length must be an integer constant");
    }
    return ty.t_invalid;
}

// The value of a constant expression written as an array length (checked
// in a constant context, as a const initializer is); -1 after an error.
fn const_array_len(ce: *mut ast.Expr, tc: *mut TypeCtx) i64 {
    let ctx = u.new.[FnCtx]();
    ctx.* = fn_ctx(tc.*);
    ctx.const_ctx = true;
    let saved = C;
    C = ctx;
    let t = check_expr(ce, ty.t_usize);
    check_no_copy(ce);
    C = saved;
    if ce.is_const and ((t.kind == ast.TY_INT) or (t.kind == ast.TY_UNTYPED_INT) or (t.kind == ast.TY_CONSTINT)) {
        if ast.cval_of(ce).is_neg() {
            _ = dg.err(ce.span, "E0472", "array length must not be negative");
            return -1;
        }
        if not fits_type(ast.cval_of(ce), ty.t_i64) {
            _ = dg.err(ce.span, "E0472", "array length is too large");
            return -1;
        }
        return ast.cval_of(ce).i64v();
    }
    if t.kind != ast.TY_INVALID {
        _ = dg.err(ce.span, "E0472", "array length must be an integer constant");
    }
    return -1;
}

fn resolve_named_type(te: *mut ast.TypeExpr, nt: ast.NamedType, tc: *mut TypeCtx) *mut ast.Type {
    if nt.has_member {
        _ = dg.err(nt.member_span, "E0400", u.f1("'%s' is not a type", nt.member));
        return ty.t_invalid;
    }
    if u.isnos(nt.qual) {
        let gp = lookup_gparam(tc, nt.name);
        if u.notnil(gp) {
            if nt.has_args {
                _ = dg.err(te.span, "E0468", u.f1("generic parameter '%s' cannot take arguments", nt.name));
            }
            if gp.is_const {
                _ = dg.err(te.span, "E0400", u.f1("'%s' is a constant, not a type", nt.name));
                return ty.t_invalid;
            }
            return gp;
        }
    }
    let d = resolve_named_decl(nt, te.span, tc, true);
    if u.isnil(d) {
        return ty.t_invalid;
    }
    if (d.kind == ast.D_ERROR) and not u.isnos(d.name) {
        if nt.has_args {
            _ = dg.err(te.span, "E0468", u.f1("'%s' is not generic", nt.name));
        }
        resolve_decl(d);
        return ty.type_errset(d);
    }
    if (d.kind != ast.D_STRUCT) and (d.kind != ast.D_UNION) and (d.kind != ast.D_ENUM) {
        _ = dg.err(nt.name_span, "E0400", u.f1("'%s' is not a type", nt.name));
        return ty.t_invalid;
    }
    resolve_decl(d);
    if u.isnil(d.ty) {
        // (an enum still being resolved: named in its own representation, or
        // in that of an enum it depends on)
        _ = dg.err(te.span, "E0308", u.f1("an enum's representation must be an integer type, found %s", te_name(te)));
        return ty.t_invalid;
    }
    if d.gparams.len == 0 {
        if nt.has_args {
            _ = dg.err(te.span, "E0468", u.f1("'%s' is not generic", nt.name));
        }
        return d.ty;
    }
    if not nt.has_args {
        let g = dg.err(te.span, "E0460", u.f2("generic type '%s' must be given arguments: %s.[...]", nt.name, nt.name));
        dg.note(g, d.name_span, u.f1("'%s' declared here", d.name));
        return ty.t_invalid;
    }
    let args = u.newn.[*mut ast.Type](nt.args.len);
    for i in 0..nt.args.len {
        args[i] = resolve_generic_arg(nt.args.get(i), tc);
    }
    if not check_generic_args(d, args, te.span, &nt.args) {
        return ty.t_invalid;
    }
    return spost.check_size(te.span, ty.type_named(d, args));
}

// ---------------------------------------------------------------------------
// Declarations
// ---------------------------------------------------------------------------
// A function type is allowed when its own parameters and result are: C
// calls a callback with its own calling convention.
fn boundary_ok_in(t: *mut ast.Type, is_ret: bool, c_fn: bool) bool {
    if c_fn {
        return boundary_value_ok(t, is_ret);
    }
    return boundary_type_ok(t, is_ret);
}

// A parameter or result of an extern "C" function or an export: a boundary
// type, or a structure of them passed by value as the C ABI says (spec
// §14.5.3); not in `import host` functions (WebAssembly imports' types are
// the scalars).
fn boundary_value_ok(t: *mut ast.Type, is_ret: bool) bool {
    if t.kind == ast.TY_STRUCT {
        return boundary_struct_ok(t);
    }
    return boundary_type_ok(t, is_ret);
}

// A structure that crosses by value, or the type of a C object (spec
// §14.5.6): every member a boundary type (but void, and a function type
// only as a member), a structure of such members, or an array of one.
fn boundary_struct_ok(t: *mut ast.Type) bool {
    if u.isnil(t.decl) or (t.decl.fields.len == 0) {
        return false;
    }
    for i in 0..t.decl.fields.len {
        if not boundary_data_ok(ty.type_field(t, i)) {
            return false;
        }
    }
    return true;
}

fn boundary_data_ok(t: *mut ast.Type) bool {
    if t.kind == ast.TY_STRUCT {
        return boundary_struct_ok(t);
    }
    if t.kind == ast.TY_ARRAY {
        return (t.len > 0) and boundary_data_ok(t.elem);
    }
    if (t.kind == ast.TY_VOID) or (t.kind == ast.TY_VEC) or (t.kind == ast.TY_V128) {
        return false;  // (a vector's layout in C is not the standard's)
    }
    return boundary_type_ok(t, false);
}

fn boundary_type_ok(t: *ast.Type, is_ret: bool) bool {
    let k = t.kind;
    if k == ast.TY_FN {
        for p in t.params {
            if not boundary_type_ok(p, false) {
                return false;
            }
        }
        return boundary_type_ok(t.ret, true);
    }
    if (k == ast.TY_VEC) or (k == ast.TY_V128) {
        return ty.simd_bits(t) == 128;  // (WebAssembly has nothing wider)
    }
    if (k == ast.TY_BOOL) or (k == ast.TY_INT) or (k == ast.TY_FLOAT) or (k == ast.TY_PTR) or (k == ast.TY_INVALID) {
        return true;
    }
    if k == ast.TY_OPT {
        return ((t.elem.kind == ast.TY_PTR) or (t.elem.kind == ast.TY_FN)) and boundary_type_ok(t.elem, false);
    }
    if k == ast.TY_VOID {
        return is_ret;
    }
    return false;
}

fn resolve_fn(d: *mut ast.Decl) void {
    let owner = d.owner;
    if u.notnil(owner) {
        resolve_decl(owner);
    }
    ensure_gparams(d);
    let mut nown: usize = 0;
    if u.notnil(owner) {
        nown = owner.gparams.len;
    }
    d.all_gparams = u.newn.[*mut ast.Type](nown + d.gparams.len);
    for i in 0..nown {
        d.all_gparams[i] = owner.gparams.at_mut(i).ty;
    }
    for i in 0..d.gparams.len {
        d.all_gparams[nown + i] = d.gparams.at_mut(i).ty;
    }
    let mut oself = tnil();
    if u.notnil(owner) {
        oself = owner.ty;
    }
    let mut tc = type_ctx(d.module, owner, d, oself);
    d.param_types = u.newn.[*mut ast.Type](d.params.len);
    for i in 0..d.params.len {
        let p = d.params.at_mut(i);
        p.local = u.nil.[ast.Local]();
        d.param_types[i] = resolve_type(p.te, &mut tc);
        if d.param_types[i].kind == ast.TY_VOID {
            _ = dg.err(p.te.span, "E0404", u.f1("parameter '%s' cannot have type void", p.name));
            d.param_types[i] = ty.t_invalid;
        }
        if p.is_noalias {
            let pt = d.param_types[i];
            if (pt.kind != ast.TY_PTR) and (pt.kind != ast.TY_SLICE) and (pt.kind != ast.TY_INVALID) {
                _ = dg.err(p.noalias_span, "E0315",
                           u.f1("noalias is only allowed on pointer or slice parameters, found %s", tstr(pt)));
            }
        }
        for j in 0..i {
            if placeholder(p.name) {
                break;
            }
            if u.same(d.params.at(j).name, p.name) {
                dup_error(p.span, p.name, d.params.at(j).span);
            }
        }
    }
    if u.notnil(d.ret_te) {
        let mut handled_infer = false;
        if (d.kind == ast.D_FN) and not d.is_pub and not d.is_export and not d.extern_c {
            match d.ret_te.shape {
                .ErrUnion(eu) => {
                    if eu.is_infer {
                        handled_infer = true;
                        let e = resolve_type(eu.elem, &mut tc);
                        if e.kind == ast.TY_ERRUNION {
                            _ = dg.err(d.ret_te.span, "E0401", "nested error unions (!!T) are not allowed");
                            d.ret_type = e;
                        } else {
                            d.is_infer_ret = true;
                            d.ret_type = spost.check_size(d.ret_te.span, ty.type_errunion(e));
                        }
                    }
                }
                else => {}
            }
        }
        if not handled_infer {
            d.ret_type = resolve_type(d.ret_te, &mut tc);
        }
    } else {
        d.ret_type = ty.t_void;
    }
    d.ty = ty.type_fn(d.param_types, d.ret_type);
    d.self_kind = ast.SELF_NONE;
    if u.notnil(owner) and (d.params.len > 0) and u.str_eq(d.params.at(0).name, "self") {
        let pt = d.param_types[0];
        let sf = owner.ty;
        if pt == sf {
            d.self_kind = ast.SELF_VALUE;
        } else if (pt.kind == ast.TY_PTR) and (pt.elem == sf) {
            if pt.is_mut {
                d.self_kind = ast.SELF_PASS;
            } else {
                d.self_kind = ast.SELF_ADDR;
            }
        } else if pt.kind != ast.TY_INVALID {
            _ = dg.err(d.params.at(0).te.span, "E0305", u.f1("'self' must have type Self, *Self or *mut Self, found %s",
                                                             tstr(pt)));
        }
    }
    if d.extern_c and not u.isnos(d.abi) and not u.str_eq(d.abi, "C") {
        _ = dg.err(d.abi_span, "E0306", u.f1("unknown ABI \"%s\" (only \"C\" is supported)", d.abi));
    }
    if d.variadic and not d.extern_c {
        _ = dg.err(d.abi_span, "E0307", "'...' (C varargs) is only allowed in extern \"C\" declarations");
    } else if d.variadic and (d.params.len == 0) {
        _ = dg.err(d.abi_span, "E0307", "a variadic C function needs at least one fixed parameter");
    }
    if d.is_inline {
        if d.is_export {
            _ = dg.err(d.inline_span, "E0313",
                       "an exported function cannot be inline (its callers are outside the program)");
        } else if d.attr != ast.ATTR_NONE {
            let mut an: []u8 = "multiversion";
            if d.attr == ast.ATTR_FEATURES {
                an = "features";
            }
            _ = dg.err(d.inline_span, "E0313",
                       u.f1("an inline function cannot have @%s (it is compiled as part of its callers)", an));
        }
    }
    if d.is_export or (d.kind == ast.D_HOST_FN) {
        let mut what: []u8 = "imported";
        if d.is_export {
            what = "exported";
        } else if d.extern_c {
            what = "C";
        }
        if d.gparams.len != 0 {
            _ = dg.err(d.name_span, "E0466", u.f1("%s functions cannot be generic", what));
        }
        // (structures cross by value in C functions, not in WebAssembly's
        // imports: spec §14.5.3)
        let c_fn = d.extern_c or d.is_export;
        for i in 0..d.params.len {
            if c_fn and (d.param_types[i].kind == ast.TY_STRUCT) {
                d.cabi = true;
            }
            if not boundary_ok_in(d.param_types[i], false, c_fn) and (d.param_types[i].kind != ast.TY_INVALID) {
                _ = dg.err(d.params.at(i).te.span, "E0801", u.f3("type %s is not allowed at the %s function boundary%s",
                                                                 tstr(d.param_types[i]), what,
                                                                 fn_type_hint(d.param_types[i])));
            }
        }
        if c_fn and (d.ret_type.kind == ast.TY_STRUCT) {
            d.cabi = true;
        }
        if d.cabi and d.variadic {
            _ = dg.err(d.name_span, "E0801", "a variadic C function cannot take or return a structure by value");
        }
        if not boundary_ok_in(d.ret_type, true, c_fn) {
            let mut sp = d.name_span;
            if u.notnil(d.ret_te) {
                sp = d.ret_te.span;
            }
            let mut hint = fn_type_hint(d.ret_type);
            if d.ret_type.kind == ast.TY_ERRUNION {
                hint = " (handle errors before the export boundary)";
            }
            _ = dg.err(sp, "E0801", u.f3("return type %s is not allowed at the %s function boundary%s",
                                         tstr(d.ret_type), what, hint));
        }
    }
}

fn fn_type_hint(t: *ast.Type) []u8 {
    if t.kind == ast.TY_FN {
        return " (a function type's parameters and result must be allowed there too)";
    }
    return "";
}

fn pick_span(c: bool, a: u.Span, b: u.Span) u.Span {
    if c {
        return a;
    }
    return b;
}

// The name a type expression gives, for a message ("this type" if it is
// not a name).
fn te_name(te: *ast.TypeExpr) []u8 {
    match te.shape {
        .Named(nt) => {
            if u.isnos(nt.qual) {
                return nt.name;
            }
            return u.f2("%s.%s", nt.qual, nt.name);
        }
        else => { return "this type"; }
    }
}

// An enum's representation and its members' values: each member without
// `= value` is one more than the member before it (the first is 0). Without
// a representation type, the smallest unsigned type that holds every value
// (or signed, when one is negative).
fn resolve_enum(d: *mut ast.Decl) void {
    let mut tc = type_ctx(d.module, dnil(), dnil(), tnil());
    let mut repr = tnil();
    if u.notnil(d.te) {
        repr = resolve_type(d.te, &mut tc);
        if u.isnil(repr) {
            // (an enum whose representation is itself, or an enum whose
            // representation depends on it: not yet a type)
            _ = dg.err(d.te.span, "E0308", u.f1("an enum's representation must be an integer type, found %s",
                                                te_name(d.te)));
            repr = ty.t_invalid;
        }
        if repr.kind != ast.TY_INT {
            if repr.kind != ast.TY_INVALID {
                _ = dg.err(d.te.span, "E0308", u.f1("an enum's representation must be an integer type, found %s",
                                                    tstr(repr)));
            }
            repr = tnil();
        }
    }
    if d.variants.len == 0 {
        _ = dg.err(d.name_span, "E0304", u.f1("enum '%s' must have at least one member", d.name));
    }
    let one = u.I128.of(1);
    let mut next = u.I128.zero();
    let mut lo = u.I128.zero();
    let mut hi = u.I128.zero();
    for i in 0..d.variants.len {
        let v = d.variants.at_mut(i);
        if not v.has_value {
            v.value = next;
        }
        next = v.value.add(one);
        if v.value.lt(lo) {
            lo = v.value;
        }
        if v.value.gt(hi) {
            hi = v.value;
        }
        for j in 0..i {
            let w = d.variants.at(j);
            if w.value.eq(v.value) {
                let dd = dg.err(pick_span(v.has_value, v.value_span, v.span), "E0309",
                                u.f2("enum member '%s' has the same value as '%s'", v.name, w.name));
                dg.note(dd, w.span, u.f1("'%s' declared here", w.name));
                break;
            }
        }
    }
    if u.isnil(repr) {
        let cands = [ty.t_u8, ty.t_u16, ty.t_u32, ty.t_u64, ty.t_i8, ty.t_i16, ty.t_i32, ty.t_i64];
        repr = ty.t_i64;
        let mut k: usize = 0;
        if lo.is_neg() {
            k = 4;
        }
        while k < cands.len {
            let r = ty.int_range(cands[k]);
            if lo.ge(r.lo) and hi.le(r.hi) {
                repr = cands[k];
                break;
            }
            k += 1;
        }
    }
    let r = ty.int_range(repr);
    for i in 0..d.variants.len {
        let v = d.variants.at_mut(i);
        if v.value.lt(r.lo) or v.value.gt(r.hi) {
            _ = dg.err(pick_span(v.has_value, v.value_span, v.span), "E0503",
                       u.f2("the value of '%s' does not fit in %s", v.name, tstr(repr)));
        }
    }
    d.ty = ty.type_enum(d, repr);
}

// ---------------------------------------------------------------------------
// Error sets (spec §11.3)
// ---------------------------------------------------------------------------
// The names of a named error set: its own, and those of the sets it includes.
fn resolve_error_set(d: *mut ast.Decl) void {
    for i in 0..d.error_names.len {
        add_set_name(d, d.error_names.get(i));
    }
    let mut tc = type_ctx(d.module, dnil(), dnil(), tnil());
    for i in 0..d.error_refs.len {
        let s = resolve_set_te(d.error_refs.get(i), &mut tc);
        if u.notnil(s) {
            resolve_decl(s);
            for j in 0..s.set_names.len {
                add_set_name(d, s.set_names.get(j));
            }
        }
    }
}

fn add_set_name(d: *mut ast.Decl, n: []u8) void {
    for i in 0..d.set_names.len {
        if u.same(d.set_names.get(i), n) {
            return;
        }
    }
    d.set_names.push(n);
}

// The error set a type expression names, or nil (after an error).
fn resolve_set_te(te: *mut ast.TypeExpr, tc: *mut TypeCtx) *mut ast.Decl {
    match te.shape {
        .ErrSetInline(ies) => { return intern_anon_errset(&ies.names); }
        .Named(nt) => {
            let d = resolve_named_decl(nt, te.span, tc, true);
            if u.isnil(d) {
                return dnil();
            }
            if (d.kind != ast.D_ERROR) or nt.has_args or nt.has_member {
                _ = dg.err(nt.name_span, "E0654", u.f1("'%s' is not an error set", nt.name));
                return dnil();
            }
            return d;
        }
        else => {}
    }
    _ = dg.err(te.span, "E0654", "expected the name of an error set");
    return dnil();
}

// Whether the error set `set` (nil: any error) holds the error `name`.
fn set_has(set: *mut ast.Decl, name: []u8) bool {
    if u.isnil(set) {
        return true;
    }
    resolve_decl(set);
    for i in 0..set.set_names.len {
        if u.same(set.set_names.get(i), name) {
            return true;
        }
    }
    return false;
}

// The first error of set a that set b does not hold, or no string (both
// named sets).
fn set_missing(a: *mut ast.Decl, b: *mut ast.Decl) []u8 {
    resolve_decl(a);
    for i in 0..a.set_names.len {
        if not set_has(b, a.set_names.get(i)) {
            return a.set_names.get(i);
        }
    }
    return u.nosym();
}

fn errset_label(decl: *mut ast.Decl, ep: *mut ast.Type) []u8 {
    if u.notnil(ep) {
        return ep.name;
    }
    return decl.name;
}

// An error of (a_decl, a_ep) where (b_decl, b_ep) is needed (both nil: any error).
fn error_fits(sp: u.Span, a_decl: *mut ast.Decl, a_ep: *mut ast.Type, b_decl: *mut ast.Decl, b_ep: *mut ast.Type) bool {
    if u.isnil(b_decl) and u.isnil(b_ep) {
        return true;
    }
    if u.notnil(a_ep) and (a_ep == b_ep) {
        return true;
    }
    if u.isnil(a_ep) and u.isnil(b_ep) and (a_decl == b_decl) {
        return true;
    }
    if u.notnil(a_decl) {
        resolve_decl(a_decl);
    }
    if u.notnil(b_decl) {
        resolve_decl(b_decl);
    }
    if u.isnil(a_ep) and u.notnil(a_decl) and (a_decl.set_names.len == 0) {
        return true;
    }
    if u.notnil(a_ep) {
        _ = dg.err(sp, "E0653", u.f2("%s can hold errors unknown to %s", a_ep.name, errset_label(b_decl, b_ep)));
        return false;
    }
    if u.isnil(a_decl) {
        if u.notnil(b_ep) {
            _ = dg.err(sp, "E0653",
                       u.f1("a value of type error can hold any error, but %s may hold fewer; match on it to choose",
                            b_ep.name));
        } else {
            _ = dg.err(sp, "E0653",
                       u.f1("a value of type error can hold any error, but %s holds only its own; match on it to choose",
                            b_decl.name));
        }
        return false;
    }
    if u.notnil(b_ep) {
        _ = dg.err(sp, "E0653", u.f3("%s can hold error.%s, which %s may not hold", a_decl.name,
                                     a_decl.set_names.get(0), b_ep.name));
        return false;
    }
    let m = set_missing(a_decl, b_decl);
    if not u.isnos(m) {
        _ = dg.err(sp, "E0653", u.f3("%s can hold error.%s, which %s does not", a_decl.name, m, b_decl.name));
        return false;
    }
    return true;
}

// Whether (b_decl, b_ep) holds every error of (a_decl, a_ep), without reporting.
fn set_within_err(a_decl: *mut ast.Decl, a_ep: *mut ast.Type, b_decl: *mut ast.Decl, b_ep: *mut ast.Type) bool {
    if u.isnil(b_decl) and u.isnil(b_ep) {
        return true;
    }
    if u.notnil(a_ep) and (a_ep == b_ep) {
        return true;
    }
    if u.isnil(a_ep) and u.isnil(b_ep) and (a_decl == b_decl) {
        return true;
    }
    if u.isnil(a_ep) and u.notnil(a_decl) {
        resolve_decl(a_decl);
        if a_decl.set_names.len == 0 {
            return true;
        }
    }
    if u.notnil(a_ep) or u.isnil(a_decl) or u.notnil(b_ep) {
        return false;
    }
    return u.isnos(set_missing(a_decl, b_decl));
}

// An error union s where the wider t is expected: the same value type, and
// t's set holds every error of s's (spec §11.3).
fn union_fits(sp: u.Span, s: *mut ast.Type, t: *mut ast.Type) bool {
    if (u.notnil(t.decl) or u.notnil(t.err_param)) and u.isnil(s.decl) and u.isnil(s.err_param) {
        if u.notnil(t.err_param) {
            _ = dg.err(sp, "E0653", u.f2("%s can hold any error, but %s may hold fewer; handle the others with catch",
                                         tstr(s), tstr(t)));
        } else {
            _ = dg.err(sp, "E0653",
                       u.f2("%s can hold any error, but %s holds only those of its set; handle the others with catch",
                            tstr(s), tstr(t)));
        }
        return false;
    }
    return error_fits(sp, s.decl, s.err_param, t.decl, t.err_param);
}

// A function whose results widen to those of t (an error union of a set
// within t's), with the same parameters.
fn fn_widens(s: *mut ast.Type, t: *mut ast.Type) bool {
    if s.params.len != t.params.len {
        return false;
    }
    for i in 0..s.params.len {
        if s.params[i] != t.params[i] {
            return false;
        }
    }
    let a = s.ret;
    let b = t.ret;
    return (a.kind == ast.TY_ERRUNION) and (b.kind == ast.TY_ERRUNION) and (a.elem == b.elem) and
           set_within_err(a.decl, a.err_param, b.decl, b.err_param);
}

// The error set an expected type asks for (nil: none, or any error).
fn expected_set(t0: *mut ast.Type) *mut ast.Decl {
    let mut t = t0;
    while u.notnil(t) and (t.kind == ast.TY_OPT) {
        t = t.elem;
    }
    if u.notnil(t) and ((t.kind == ast.TY_ERROR) or (t.kind == ast.TY_ERRUNION)) {
        return t.decl;
    }
    return dnil();
}

// The function E0355 was last reported for.
threadlocal let mut g_self_dep: *mut ast.Decl = @ptr_from_int(*mut ast.Decl, 0);

fn resolve_decl(d: *mut ast.Decl) void {
    if d.state == ast.DeclState.DONE {
        return;
    }
    if d.state == ast.DeclState.RESOLVING {
        if d.kind == ast.D_CONST {
            _ = dg.err(d.name_span, "E0351", u.f1("constant '%s' depends on itself", d.name));
        } else if d.kind == ast.D_ERROR {
            _ = dg.err(d.name_span, "E0654", u.f1("error set '%s' includes itself", d.name));
        } else if ((d.kind == ast.D_FN) or (d.kind == ast.D_HOST_FN)) and (d != g_self_dep) {
            _ = dg.err(d.name_span, "E0355", u.f1("the signature of function '%s' depends on itself", d.name));
            g_self_dep = d;  // (once, however often its signature calls it)
        }
        return;
    }
    d.state = ast.DeclState.RESOLVING;
    let k = d.kind;
    if (k == ast.D_STRUCT) or (k == ast.D_UNION) {
        d.ty = make_self_type(d);
        let mut tc = type_ctx(d.module, d, dnil(), d.ty);
        d.state = ast.DeclState.DONE;  // fields may refer to Self through pointers
        for i in 0..d.fields.len {
            let f = d.fields.at_mut(i);
            f.ty = resolve_type(f.te, &mut tc);
            if f.ty.kind == ast.TY_VOID {
                _ = dg.err(f.te.span, "E0404", u.f1("field '%s' cannot have type void", f.name));
                f.ty = ty.t_invalid;
            }
        }
        for i in 0..d.variants.len {
            let v = d.variants.at_mut(i);
            if u.notnil(v.te) {
                v.ty = resolve_type(v.te, &mut tc);
                if v.ty.kind == ast.TY_VOID {
                    v.ty = tnil();
                }
            }
        }
        if (k == ast.D_UNION) and (d.variants.len == 0) {
            _ = dg.err(d.name_span, "E0304", u.f1("union '%s' must have at least one variant", d.name));
        }
        if (k == ast.D_UNION) and (d.variants.len > 65536) {
            _ = dg.err(d.name_span, "E0304", u.f1("union '%s' has too many variants", d.name));
        }
        _ = spost.check_size(d.name_span, d.ty);
        return;
    }
    if k == ast.D_ENUM {
        resolve_enum(d);
    } else if (k == ast.D_FN) or (k == ast.D_HOST_FN) {
        resolve_fn(d);
    } else if k == ast.D_CONST {
        let tc = type_ctx(d.module, dnil(), dnil(), tnil());
        let mut tc2 = tc;
        d.ty = resolve_type(d.te, &mut tc2);
        let dk = d.ty.kind;
        if (dk != ast.TY_INT) and (dk != ast.TY_FLOAT) and (dk != ast.TY_BOOL) and (dk != ast.TY_ENUM) and
           (dk != ast.TY_STRUCT) and (dk != ast.TY_INVALID) {
            _ = dg.err(d.te.span, "E0352",
                       u.f1("constants must have an integer, float, bool, enum or struct type, found %s", tstr(d.ty)));
            d.ty = ty.t_invalid;
        }
        let ctx = u.new.[FnCtx]();
        ctx.* = fn_ctx(tc);
        ctx.const_ctx = true;
        let saved = C;
        C = ctx;
        _ = check_expr_to(&mut d.init, d.ty);
        check_no_copy(d.init);
        C = saved;
        d.cexpr = d.init;
        let mut ok_const = d.init.is_const or (d.init.kind == ast.E_BOOL);
        if d.ty.kind == ast.TY_STRUCT {
            ok_const = is_const_init(d.init);
        }
        if not ok_const and (d.ty.kind != ast.TY_INVALID) and (d.init.ty.kind != ast.TY_INVALID) {
            _ = dg.err(d.init.span, "E0350", "constant initializer must be a constant expression");
        }
    } else if (k == ast.D_ERROR) and not u.isnos(d.name) {
        resolve_error_set(d);
    } else if k == ast.D_GLOBAL {
        let mut tc = type_ctx(d.module, dnil(), dnil(), tnil());
        d.ty = resolve_type(d.te, &mut tc);
        if d.ty.kind == ast.TY_VOID {
            _ = dg.err(d.te.span, "E0404", u.f1("global '%s' cannot have type void", d.name));
            d.ty = ty.t_invalid;
        }
        if d.is_tls and not d.is_mut {
            _ = dg.err(d.name_span, "E0354",
                       u.f1("thread-local '%s' must be mutable (`threadlocal let mut`; a constant needs no copy per thread)",
                            d.name));
        }
        if (d.extern_c or d.is_export) and (d.ty.kind != ast.TY_INVALID) and not boundary_data_ok(d.ty) {
            // an object C defines, or one C code may use (spec §14.5.6)
            _ = dg.err(d.te.span, "E0801", u.f3("type %s is not allowed for %s object '%s'", tstr(d.ty),
                                                u.pick(d.extern_c, "a C", "an exported"), d.name));
        }
        if d.extern_c and not u.isnos(d.abi) and not u.str_eq(d.abi, "C") {
            _ = dg.err(d.abi_span, "E0306", u.f1("unknown ABI \"%s\" (only \"C\" is supported)", d.abi));
        }
    }
    d.state = ast.DeclState.DONE;
}

// ---------------------------------------------------------------------------
// Infinite-size detection
// ---------------------------------------------------------------------------
fn contains_by_value(t: *mut ast.Type, target: *mut ast.Decl, depth: i32) bool {
    if depth > 64 {
        return false;
    }
    let k = t.kind;
    if (k == ast.TY_ARRAY) or (k == ast.TY_ERRUNION) or (k == ast.TY_OPT) {
        return contains_by_value(t.elem, target, depth + 1);
    }
    if k == ast.TY_STRUCT {
        if (t.decl == target) and (depth > 0) {
            return true;
        }
        for i in 0..t.decl.fields.len {
            if contains_by_value(ty.type_field(t, i), target, depth + 1) {
                return true;
            }
        }
        return false;
    }
    if k == ast.TY_UNION {
        if (t.decl == target) and (depth > 0) {
            return true;
        }
        for i in 0..t.decl.variants.len {
            let p = ty.type_variant(t, i);
            if u.notnil(p) and contains_by_value(p, target, depth + 1) {
                return true;
            }
        }
        return false;
    }
    return false;
}

// ---------------------------------------------------------------------------
// Globals
// ---------------------------------------------------------------------------
fn is_const_init(e: *mut ast.Expr) bool {
    if e.is_const {
        return true;
    }
    let k = e.kind;
    if (k == ast.E_INT) or (k == ast.E_FLOAT) or (k == ast.E_BOOL) or (k == ast.E_STRING) or (k == ast.E_ERROR_VAL) or
       (k == ast.E_OPT_NONE) or (k == ast.E_EMPTY_SLICE) {
        return true;
    }
    if k == ast.E_OPT_SOME {
        return is_const_init(e.a);
    }
    if k == ast.E_CONV {
        return is_const_init(e.a);
    }
    if k == ast.E_ARRAY_LIT {
        for i in 0..ast.args_of(e).len {
            if not is_const_init(ast.args_of(e).get(i)) {
                return false;
            }
        }
        return true;
    }
    if k == ast.E_ARRAY_REPEAT {
        return is_const_init(e.a);
    }
    if k == ast.E_STRUCT_LIT {
        for i in 0..ast.more(e).inits.len {
            if not is_const_init(ast.ext(e).inits.at_mut(i).value) {
                return false;
            }
        }
        return true;
    }
    if k == ast.E_FIELD {
        return (ast.field_kind_of(e) == ast.FK_VARIANT_UNIT) or (ast.field_kind_of(e) == ast.FK_CONST) or
               ((ast.field_kind_of(e) == ast.FK_DECL) and u.notnil(ast.decl_of(e)) and
                (ast.decl_of(e).kind == ast.D_FN));
    }
    if k == ast.E_IDENT {
        return (e.cat == ast.CAT_VALUE) and u.notnil(ast.decl_of(e)) and
               (((ast.decl_of(e).kind == ast.D_FN) and (e.ty.kind == ast.TY_FN)) or
                (ast.decl_of(e).kind == ast.D_CONST));
    }
    if k == ast.E_CALL {
        return (ast.call_kind_of(e) == ast.CALLK_VARIANT) and (ast.args_of(e).len == 1) and
               is_const_init(ast.args_of(e).get(0));
    }
    if k == ast.E_BUILTIN {
        return (ast.builtin_of(e) == ast.BI_PTR_FROM_INT) and (ast.more(e).bargs.len == 2) and
               is_const_init(ast.ext(e).bargs.at_mut(1).e);
    }
    if k == ast.E_UNARY {
        return (ast.op_of(e) == lx.TK_MINUS) and is_const_init(e.a) and (e.a.kind == ast.E_FLOAT);
    }
    return false;
}

fn check_global(d: *mut ast.Decl) void {
    resolve_decl(d);
    if d.extern_c {
        return;  // (C defines it: no initializer)
    }
    let ctx = u.new.[FnCtx]();
    ctx.* = fn_ctx(type_ctx(d.module, dnil(), dnil(), tnil()));
    ctx.const_ctx = true;
    let saved = C;
    C = ctx;
    _ = check_expr_to(&mut d.init, d.ty);
    check_no_copy(d.init);
    C = saved;
    if (d.ty.kind != ast.TY_INVALID) and (d.init.ty.kind != ast.TY_INVALID) and not is_const_init(d.init) {
        _ = dg.err(d.init.span, "E0350", "global initializer must be a constant expression");
    }
}

// ---------------------------------------------------------------------------
// Expressions: helpers
// ---------------------------------------------------------------------------
fn mkconv(e: *mut ast.Expr, k: ast.Conv, t: *mut ast.Type) *mut ast.Expr {
    let c = ast.new_expr(ast.E_CONV, e.span);
    c.a = e;
    ast.set_conv(c, k);
    c.ty = t;
    c.cat = ast.CAT_VALUE;
    c.weakened = e.weakened;
    return c;
}

fn type_mismatch(e: *mut ast.Expr, expected: *mut ast.Type, found: *mut ast.Type) void {
    if (expected.kind == ast.TY_INVALID) or (found.kind == ast.TY_INVALID) {
        return;
    }
    let d = dg.err(e.span, "E0412", u.f2("type mismatch: expected %s, found %s", tstr(expected), tstr(found)));
    dg.set_types(d, tstr(expected), tstr(found));
    if (expected.kind == ast.TY_VEC) and (found == expected.elem) {
        let txt = u.span_text(e.span);
        let fx = dg.fix(d, "broadcast the scalar to all lanes", "machine");
        dg.edit(fx, e.span, u.f1("@splat(%s)", txt));
    } else if (expected.kind == ast.TY_INT) and (found.kind == ast.TY_INT) {
        let txt = u.span_text(e.span);
        let is_lossless = ((found.is_signed == expected.is_signed) and (found.bits < expected.bits)) or
                          (not found.is_signed and expected.is_signed and (found.bits < expected.bits));
        let fx = dg.fix(d, u.pick(is_lossless, "convert explicitly (lossless)",
                                  "convert explicitly (checked at run time)"), "suggestion");
        dg.edit(fx, e.span, u.f2(u.pick(is_lossless, "@as(%s, %s)", "@int_cast(%s, %s)"), tstr(expected), txt));
    }
}

pub fn fits_type(v: u.I128, t: *ast.Type) bool {
    if t.kind != ast.TY_INT {
        return true;
    }
    let r = ty.int_range(t);
    return v.ge(r.lo) and v.le(r.hi);
}

// Literal ranges allowed for a generic parameter type (spec §10.5).
fn lit_ok_for_param(e: *mut ast.Expr, p: *mut ast.Type) bool {
    if e.ty.kind == ast.TY_UNTYPED_FLOAT {
        return p.constraint == ast.C_FLOAT;
    }
    let v = ast.cval_of(e);
    let c = p.constraint;
    if (c == ast.C_NUM) or (c == ast.C_INT) {
        return not v.lti(0) and not v.gti(127);
    }
    if c == ast.C_SIGNED {
        return not v.lti(-128) and not v.gti(127);
    }
    if c == ast.C_UNSIGNED {
        return not v.lti(0) and not v.gti(255);
    }
    if c == ast.C_FLOAT {
        return not v.lti(-16777216) and not v.gti(16777216);
    }
    return false;
}

// Whether constant e has an integer value: an untyped integer, or one
// coerced to a type parameter.
fn int_valued(e: *mut ast.Expr) bool {
    if u.notnil(e.ty) and (e.ty.kind == ast.TY_UNTYPED_INT) {
        return true;
    }
    let k = e.kind;
    if k == ast.E_INT {
        return true;
    }
    if k == ast.E_UNARY {
        return int_valued(e.a);
    }
    if k == ast.E_BINARY {
        return int_valued(e.a) and int_valued(ast.b_of(e));
    }
    return false;
}

// The value of a constant float expression of type f32 (or untyped,
// becoming f32): its literals are rounded to f32, a decimal one directly
// rather than through f64, and its operations are f32 operations (§6.1).
pub fn const_f32(e: *mut ast.Expr) f32 {
    if int_valued(e) {
        return ast.cval_of(e).to_f32();
    }
    let k = e.kind;
    if k == ast.E_FLOAT {
        return u.parse_f32(ast.more(e).float_text);
    }
    if (k == ast.E_UNARY) and (ast.op_of(e) == lx.TK_MINUS) and e.a.is_const {
        return -const_f32(e.a);
    }
    if (k == ast.E_BINARY) and e.a.is_const and ast.b_of(e).is_const {
        let a = const_f32(e.a);
        let b = const_f32(ast.b_of(e));
        if ast.op_of(e) == lx.TK_PLUS {
            return a + b;
        }
        if ast.op_of(e) == lx.TK_MINUS {
            return a - b;
        }
        if ast.op_of(e) == lx.TK_STAR {
            return a * b;
        }
        if ast.op_of(e) == lx.TK_SLASH {
            return a / b;
        }
    }
    return @float_cast(f32, ast.fval_of(e));
}

fn can_take_untyped_float(t: *ast.Type) bool {
    if t.kind == ast.TY_FLOAT {
        return true;
    }
    if (t.kind == ast.TY_PARAM) and not t.is_const {
        return true;
    }
    if (t.kind == ast.TY_OPT) or (t.kind == ast.TY_ERRUNION) {
        return can_take_untyped_float(t.elem);
    }
    return false;
}

fn weaken_mut(t: *mut ast.Type) *mut ast.Type {
    if u.isnil(t) {
        return t;
    }
    if t.kind == ast.TY_PTR {
        if t.is_mut {
            return ty.type_ptr(t.elem, false);
        }
        return t;
    }
    if t.kind == ast.TY_SLICE {
        if t.is_mut {
            return ty.type_slice(t.elem, false);
        }
        return t;
    }
    if t.kind == ast.TY_OPT {
        let w = weaken_mut(t.elem);
        if w != t.elem {
            return ty.type_opt(w);
        }
        return t;
    }
    if t.kind == ast.TY_ERRUNION {
        let w = weaken_mut(t.elem);
        if w != t.elem {
            if u.notnil(t.err_param) {
                return ty.type_errunion_param(w, t.err_param);
            }
            return ty.type_errunion_set(w, t.decl);
        }
        return t;
    }
    if t.kind == ast.TY_ARRAY {
        let w = weaken_mut(t.elem);
        if w != t.elem {
            if u.notnil(t.len_param) {
                return ty.type_array_param(w, t.len_param);
            }
            return ty.type_array(w, t.len);
        }
        return t;
    }
    return t;
}

fn is_err_type(t: *ast.Type) bool {
    return (t.kind == ast.TY_ERROR) or ((t.kind == ast.TY_PARAM) and t.is_error_param);
}

fn err_decl_of(t: *mut ast.Type) *mut ast.Decl {
    if (t.kind == ast.TY_ERROR) or (t.kind == ast.TY_ERRUNION) {
        return t.decl;
    }
    return dnil();
}

fn err_param_of(t: *mut ast.Type) *mut ast.Type {
    if (t.kind == ast.TY_PARAM) and t.is_error_param {
        return t;
    }
    if t.kind == ast.TY_ERRUNION {
        return t.err_param;
    }
    return tnil();
}

fn coerce(pe: *mut *mut ast.Expr, target: *mut ast.Type) void {
    let e = pe.*;
    let s = e.ty;
    if u.isnil(s) or u.isnil(target) {
        return;
    }
    if s.kind == ast.TY_NEVER {
        ast.set_tval(e, target);
        return;
    }
    if (s == target) or (s.kind == ast.TY_INVALID) or (target.kind == ast.TY_INVALID) {
        return;
    }
    if s.kind == ast.TY_UNTYPED_INT {
        if target.kind == ast.TY_INT {
            if not fits_type(ast.cval_of(e), target) {
                let r = ty.int_range(target);
                _ = dg.err(e.span, "E0503", u.f4("literal %s does not fit in %s (range %s..%s)", ast.cval_of(e).str(),
                                                 tstr(target), r.lo.str(), r.hi.str()));
            }
            e.ty = target;
            return;
        }
        if target.kind == ast.TY_FLOAT {
            ast.set_fval(e, ast.cval_of(e).to_f64());
            if target.bits == 32 {
                ast.set_fval(e, @as(f64, ast.cval_of(e).to_f32()));
            }
            e.ty = target;
            return;
        }
        if (target.kind == ast.TY_PARAM) and not target.is_const {
            if not lit_ok_for_param(e, target) {
                _ = dg.err(e.span, "E0461",
                           u.f2("literal %s is not representable in every type satisfying %s; convert explicitly",
                                ast.cval_of(e).str(), constraint_str(target.constraint, target.constraint_lane)));
            }
            ast.set_fval(e, ast.cval_of(e).to_f64());
            e.ty = target;
            return;
        }
        if (target.kind == ast.TY_ERRUNION) and (target.elem.kind != ast.TY_VOID) {
            coerce(pe, target.elem);
            pe.* = mkconv(pe.*, ast.CONV_WRAP_OK, target);
            return;
        }
        if target.kind == ast.TY_OPT {
            coerce(pe, target.elem);
            pe.* = mkconv(pe.*, ast.CONV_WRAP_SOME, target);
            return;
        }
        type_mismatch(e, target, s);
        e.ty = ty.t_invalid;
        return;
    }
    if s.kind == ast.TY_UNTYPED_FLOAT {
        if target.kind == ast.TY_FLOAT {
            if (target.bits == 32) and e.is_const {
                ast.set_fval(e, @as(f64, const_f32(e)));
            }
            e.ty = target;
            return;
        }
        if (target.kind == ast.TY_PARAM) and not target.is_const {
            if not lit_ok_for_param(e, target) {
                _ = dg.err(e.span, "E0461", u.f1("float literal is not allowed for a parameter constrained by %s",
                                                 constraint_str(target.constraint, target.constraint_lane)));
            }
            e.ty = target;
            return;
        }
        if (target.kind == ast.TY_ERRUNION) and (target.elem.kind == ast.TY_FLOAT) {
            coerce(pe, target.elem);
            pe.* = mkconv(pe.*, ast.CONV_WRAP_OK, target);
            return;
        }
        if (target.kind == ast.TY_OPT) and can_take_untyped_float(target.elem) {
            coerce(pe, target.elem);
            pe.* = mkconv(pe.*, ast.CONV_WRAP_SOME, target);
            return;
        }
        type_mismatch(e, target, s);
        e.ty = ty.t_invalid;
        return;
    }
    // mutability weakening
    if ((s.kind == ast.TY_SLICE) or (s.kind == ast.TY_PTR)) and (target.kind == s.kind) and s.is_mut and
       not target.is_mut and (s.elem == target.elem) {
        pe.* = mkconv(e, ast.CONV_NOOP, target);
        return;
    }
    if (s.kind == ast.TY_OPT) and (target.kind == ast.TY_OPT) and
       ((s.elem.kind == ast.TY_SLICE) or (s.elem.kind == ast.TY_PTR)) and (target.elem.kind == s.elem.kind) and
       s.elem.is_mut and not target.elem.is_mut and (s.elem.elem == target.elem.elem) {
        pe.* = mkconv(e, ast.CONV_NOOP, target);
        return;
    }
    // an error of one set where one of another (or any error) is needed
    if is_err_type(s) and is_err_type(target) {
        if error_fits(e.span, err_decl_of(s), err_param_of(s), err_decl_of(target), err_param_of(target)) {
            pe.* = mkconv(e, ast.CONV_NOOP, target);
        }
        return;
    }
    // a narrower error union where a wider one is expected
    if (s.kind == ast.TY_ERRUNION) and (target.kind == ast.TY_ERRUNION) and (s.elem == target.elem) {
        if union_fits(e.span, s, target) {
            pe.* = mkconv(e, ast.CONV_NOOP, target);
        }
        return;
    }
    // a function whose results widen so
    if (s.kind == ast.TY_FN) and (target.kind == ast.TY_FN) and fn_widens(s, target) {
        pe.* = mkconv(e, ast.CONV_NOOP, target);
        return;
    }
    if target.kind == ast.TY_ERRUNION {
        if is_err_type(s) {
            if error_fits(e.span, err_decl_of(s), err_param_of(s), target.decl, target.err_param) {
                pe.* = mkconv(e, ast.CONV_WRAP_ERR, target);
            }
            return;
        }
        if (s.kind != ast.TY_ERRUNION) and (target.elem.kind != ast.TY_VOID) {
            coerce(pe, target.elem);
            if (pe.*.ty == target.elem) or (pe.*.ty.kind == ast.TY_INVALID) {
                pe.* = mkconv(pe.*, ast.CONV_WRAP_OK, target);
                pe.*.ty = target;
            }
            return;
        }
    }
    if target.kind == ast.TY_OPT {
        let can_wrap = ((s.kind != ast.TY_OPT) or (target.elem.kind == ast.TY_OPT) or
                        (target.elem.kind == ast.TY_ERRUNION)) and
                       ((s.kind != ast.TY_ERRUNION) or (target.elem.kind == ast.TY_ERRUNION) or
                        (target.elem.kind == ast.TY_OPT)) and
                       (not is_err_type(s) or is_err_type(target.elem) or (target.elem.kind == ast.TY_ERRUNION) or
                        (target.elem.kind == ast.TY_OPT));
        if can_wrap {
            coerce(pe, target.elem);
            if (pe.*.ty == target.elem) or (pe.*.ty.kind == ast.TY_INVALID) {
                pe.* = mkconv(pe.*, ast.CONV_WRAP_SOME, target);
                pe.*.ty = target;
            }
            return;
        }
    }
    if e.weakened and (weaken_mut(target) == s) {
        let d = dg.err(e.span, "E0707", u.f2("cannot obtain %s through an immutable place (weakened to %s)",
                                             tstr(target), tstr(s)));
        dg.set_types(d, tstr(target), tstr(s));
        if u.notnil(C) and u.notnil(C.fnd) and (C.fnd.params.len > 0) {
            let p0 = C.fnd.params.at(0);
            if u.str_eq(p0.name, "self") and u.notnil(p0.te) {
                match p0.te.shape {
                    .Ptr(pt) => {
                        if not pt.is_mut {
                            let fx = dg.fix(d, "make 'self' mutable", "suggestion");
                            let ts = p0.te.span;
                            dg.edit(fx, u.mkspan(ts.file, ts.start + 1, ts.start + 1), "mut ");
                        }
                    }
                    else => {}
                }
            }
        }
        if u.notnil(C) and C.in_return and u.notnil(C.fnd) and u.notnil(C.fnd.ret_te) {
            let mut rt: *ast.TypeExpr = C.fnd.ret_te;
            loop {
                match rt.shape {
                    .ErrUnion(eu) => { rt = eu.elem; }
                    .Opt(inner)   => { rt = inner; }
                    else          => { break; }
                }
            }
            match rt.shape {
                .Ptr(pt) => {
                    if pt.is_mut {
                        let fx = dg.fix(d, "return an immutable view", "suggestion");
                        let rs = rt.span;
                        dg.edit(fx, u.mkspan(rs.file, rs.start, pt.elem.span.start), "*");
                    }
                }
                .Slice(pt) => {
                    if pt.is_mut {
                        let fx = dg.fix(d, "return an immutable view", "suggestion");
                        let rs = rt.span;
                        dg.edit(fx, u.mkspan(rs.file, rs.start, pt.elem.span.start), "[]");
                    }
                }
                else => {}
            }
        }
        return;
    }
    type_mismatch(e, target, s);
}

fn check_expr_to(pe: *mut *mut ast.Expr, target: *mut ast.Type) *mut ast.Type {
    _ = check_expr(pe.*, target);
    coerce(pe, target);
    return pe.*.ty;
}

fn cat_name(c: ast.Cat) []u8 {
    match c {
        .VALUE   => { return "a value"; }
        .TYPE    => { return "a type"; }
        .MODULE  => { return "a module"; }
        .FUNC    => { return "a function"; }
        .METHOD  => { return "a method"; }
        .VARIANT => { return "a union variant constructor"; }
        .GENERIC => { return "a generic declaration"; }
    }
}

fn func_to_value(e: *mut ast.Expr) void {
    let f = ast.decl_of(e);
    if f.kind == ast.D_HOST_FN {
        if f.cabi {
            // (its structures travel as C's ABI says, and Axiom's calls
            // through a function value do not: spec §14.5.3)
            _ = dg.err(e.span, "E0801",
                       u.f1("the C function '%s' takes or returns a structure by value: it can only be called, not used as a function value",
                            f.name));
        }
        e.cat = ast.CAT_VALUE;
        e.ty = f.ty;
        return;
    }
    if ast.gargs_of(e).len < f.all_gparams.len {
        let d = dg.err(e.span, "E0466",
                       u.f2("generic function '%s' must be instantiated before use as a value: %s.[...]", f.name,
                            f.name));
        dg.note(d, f.name_span, u.f1("'%s' declared here", f.name));
        e.cat = ast.CAT_VALUE;
        e.ty = ty.t_invalid;
        return;
    }
    ensure_infer_ret(f);
    e.cat = ast.CAT_VALUE;
    e.ty = ty.subst(f.ty, f.all_gparams, ast.gargs_of(e)[0..f.all_gparams.len]);
}

fn check_value(e: *mut ast.Expr) void {
    if e.cat == ast.CAT_VALUE {
        return;
    }
    if e.cat == ast.CAT_FUNC {
        func_to_value(e);
        return;
    }
    _ = dg.err(e.span, "E0405", u.f1("expected a value, found %s", cat_name(e.cat)));
    e.cat = ast.CAT_VALUE;
    e.ty = ty.t_invalid;
}

fn check_expr(e: *mut ast.Expr, expected: *mut ast.Type) *mut ast.Type {
    _ = check_operand(e, expected);
    check_value(e);
    if u.isnil(e.ty) {
        e.ty = ty.t_invalid;
    }
    return e.ty;
}

// ---------------------------------------------------------------------------
// Places
// ---------------------------------------------------------------------------
pub fn is_place(e: *mut ast.Expr) bool {
    let k = e.kind;
    if k == ast.E_IDENT {
        return u.notnil(ast.local_of(e)) or (u.notnil(ast.decl_of(e)) and (ast.decl_of(e).kind == ast.D_GLOBAL));
    }
    if k == ast.E_DEREF {
        return true;
    }
    if k == ast.E_FIELD {
        if ast.field_kind_of(e) == ast.FK_DECL {
            return u.notnil(ast.decl_of(e)) and (ast.decl_of(e).kind == ast.D_GLOBAL);
        }
        if ast.field_kind_of(e) != ast.FK_STRUCT {
            return false;
        }
        if ast.self_mode_of(e) == ast.SELF_DEREF {
            return true;
        }
        return is_place(e.a);
    }
    if k == ast.E_INDEX {
        return (ast.index_kind_of(e) != ast.IDX_ARRAY) or is_place(e.a);
    }
    return false;
}

fn is_mut_place(e: *mut ast.Expr) bool {
    let k = e.kind;
    if k == ast.E_IDENT {
        if u.notnil(ast.local_of(e)) {
            return ast.local_of(e).is_mut;
        }
        return u.notnil(ast.decl_of(e)) and (ast.decl_of(e).kind == ast.D_GLOBAL) and ast.decl_of(e).is_mut;
    }
    if k == ast.E_DEREF {
        return (e.a.ty.kind == ast.TY_PTR) and e.a.ty.is_mut;
    }
    if k == ast.E_FIELD {
        if ast.field_kind_of(e) == ast.FK_DECL {
            return u.notnil(ast.decl_of(e)) and (ast.decl_of(e).kind == ast.D_GLOBAL) and ast.decl_of(e).is_mut;
        }
        if ast.field_kind_of(e) != ast.FK_STRUCT {
            return false;
        }
        if ast.self_mode_of(e) == ast.SELF_DEREF {
            return e.a.ty.is_mut;
        }
        return is_mut_place(e.a);
    }
    if k == ast.E_INDEX {
        if ast.index_kind_of(e) == ast.IDX_ARRAY {
            return is_mut_place(e.a);
        }
        return e.a.ty.is_mut;
    }
    return false;
}

// True iff place `e` is reached through an immutable pointer (*T) or slice ([]T).
fn via_immut_indirection(e0: *ast.Expr) bool {
    let mut e = e0;
    loop {
        let k = e.kind;
        if k == ast.E_DEREF {
            return (e.a.ty.kind == ast.TY_PTR) and not e.a.ty.is_mut;
        }
        if (k == ast.E_FIELD) and (ast.field_kind_of(e) == ast.FK_STRUCT) {
            if ast.self_mode_of(e) == ast.SELF_DEREF {
                return not e.a.ty.is_mut;
            }
            e = e.a;
            continue;
        }
        if k == ast.E_INDEX {
            if ast.index_kind_of(e) == ast.IDX_ARRAY {
                e = e.a;
                continue;
            }
            return not e.a.ty.is_mut;
        }
        return false;
    }
}

fn mark_addr_taken(e: *mut ast.Expr) void {
    let k = e.kind;
    if k == ast.E_IDENT {
        if u.notnil(ast.local_of(e)) {
            ast.local_of(e).addr_taken = true;
        }
        return;
    }
    if k == ast.E_FIELD {
        if ast.self_mode_of(e) != ast.SELF_DEREF {
            mark_addr_taken(e.a);
        }
        return;
    }
    if k == ast.E_INDEX {
        if ast.index_kind_of(e) == ast.IDX_ARRAY {
            mark_addr_taken(e.a);
        }
        return;
    }
}

fn root_local(e0: *mut ast.Expr) *mut ast.Local {
    let mut e = e0;
    loop {
        if e.kind == ast.E_IDENT {
            return ast.local_of(e);
        }
        if ((e.kind == ast.E_FIELD) and (ast.self_mode_of(e) != ast.SELF_DEREF)) or
           ((e.kind == ast.E_INDEX) and (ast.index_kind_of(e) == ast.IDX_ARRAY)) {
            e = e.a;
        } else {
            return u.nil.[ast.Local]();
        }
    }
}

fn not_mutable(e: *mut ast.Expr, what: []u8) void {
    let d = dg.err(e.span, "E0701", u.f1("cannot %s: this place is not mutable", what));
    let l = root_local(e);
    if u.notnil(l) and not l.is_param {
        dg.note(d, l.span, u.f1("'%s' is declared without 'mut'", l.name));
        let fx = dg.fix(d, "declare the variable as mutable", "suggestion");
        dg.edit(fx, sp_at(l.span), "mut ");
    } else if u.notnil(l) and l.is_param {
        dg.note(d, l.span, u.f1("parameters are immutable; copy '%s' into a 'let mut' first", l.name));
    }
}

// ---------------------------------------------------------------------------
// Constant folding
// ---------------------------------------------------------------------------
fn wrap_to(v: u.I128, t: *ast.Type) u.I128 {
    let b = @int_cast(u32, t.bits);
    let mut x = v.lo;
    if b < 64 {
        x = x & ((@as(u64, 1) << b) - 1);
        if t.is_signed and (((x >> (b - 1)) & 1) != 0) {
            return u.I128.of(@bit_cast(i64, x | ~((@as(u64, 1) << b) - 1)));
        }
        return u.I128.ofu(x);
    }
    if t.is_signed {
        return u.I128.of(@bit_cast(i64, x));
    }
    return u.I128.ofu(x);
}

fn untyped_limit() u.I128 {
    return u.I128.pow2(100);
}

fn too_big(v: u.I128) bool {
    return v.gt(untyped_limit()) or v.lt(untyped_limit().neg());
}

struct Folded {
    ok: bool,
    v: u.I128,
}

// Folds integer op. t == nil for untyped. !ok on error (reported).
fn fold_int(op: lx.TokKind, a: u.I128, b: u.I128, t: *mut ast.Type, sp: u.Span) Folded {
    let bad = Folded.{ ok: false, v: u.I128.zero() };
    let typed = u.notnil(t);
    let mut r = u.I128.zero();
    match op {
        .PLUS  => { r = a.add(b); }
        .MINUS => { r = a.sub(b); }
        .STAR => {
            if not a.is_zero() and (too_big(b) or too_big(a)) {
                _ = dg.err(sp, "E0530", "overflow in constant expression");
                return bad;
            }
            r = a.mul(b);
        }
        .SLASH, .PERCENT => {
            if b.is_zero() {
                _ = dg.err(sp, "E0531", "division by zero in constant expression");
                return bad;
            }
            if op == lx.TK_SLASH {
                r = a.div(b);
            } else {
                r = a.rem(b);
            }
        }
        .PLUS_PCT => {
            r = a.add(b);
            if typed {
                r = wrap_to(r, t);
            }
        }
        .MINUS_PCT => {
            r = a.sub(b);
            if typed {
                r = wrap_to(r, t);
            }
        }
        .STAR_PCT => {
            if typed {
                r = wrap_to(wrap_to(a, t).mul(wrap_to(b, t)), t);
            } else {
                r = a.mul(b);
            }
        }
        .AMP => {
            r = a.and_(b);
            if typed {
                r = wrap_to(r, t);
            }
        }
        .PIPE => {
            r = a.or_(b);
            if typed {
                r = wrap_to(r, t);
            }
        }
        .CARET => {
            r = a.xor(b);
            if typed {
                r = wrap_to(r, t);
            }
        }
        .SHL => {
            if typed {
                if not b.lt(u.I128.of(@as(i64, t.bits))) {
                    r = u.I128.zero();
                } else {
                    r = wrap_to(a.shl(@truncate(u32, b.lo)), t);
                }
            } else {
                if b.gti(100) {
                    _ = dg.err(sp, "E0530", "overflow in constant expression");
                    return bad;
                }
                r = a.shl(@truncate(u32, b.lo));
            }
        }
        .SHR => {
            if not b.lti(120) {
                if a.is_neg() {
                    r = u.I128.of(-1);
                } else {
                    r = u.I128.zero();
                }
            } else {
                r = a.sar(@truncate(u32, b.lo));
            }
        }
        else => { return bad; }
    }
    if typed and not fits_type(r, t) {
        _ = dg.err(sp, "E0530", u.f2("overflow in constant expression: %s does not fit in %s", r.str(), tstr(t)));
        return bad;
    }
    if not typed and too_big(r) {
        _ = dg.err(sp, "E0530", "constant expression is too large");
        return bad;
    }
    return Folded.{ ok: true, v: r };
}

// ---------------------------------------------------------------------------
// Operators
// ---------------------------------------------------------------------------
fn is_shift_op(op: lx.TokKind) bool {
    return (op == lx.TK_SHL) or (op == lx.TK_SHR);
}

fn param_has(t: *ast.Type, c: i32) bool {
    return (t.kind == ast.TY_PARAM) and ty.satisfies(t, c);
}

fn is_vec_param(t: *ast.Type) bool {
    return (t.kind == ast.TY_PARAM) and not t.is_const and ty.satisfies(t, ast.C_VEC);
}

fn lane_is_float(lane: *ast.Type) bool {
    return u.notnil(lane) and ((lane.kind == ast.TY_FLOAT) or param_has(lane, ast.C_FLOAT));
}

fn lane_is_int(lane: *ast.Type) bool {
    return u.notnil(lane) and ((lane.kind == ast.TY_INT) or param_has(lane, ast.C_INT));
}

fn lane_is_signed(lane: *ast.Type) bool {
    return lane_is_float(lane) or
           (u.notnil(lane) and (((lane.kind == ast.TY_INT) and lane.is_signed) or param_has(lane, ast.C_SIGNED)));
}

fn lane_is_unsigned_int(lane: *ast.Type) bool {
    return u.notnil(lane) and (((lane.kind == ast.TY_INT) and not lane.is_signed) or param_has(lane, ast.C_UNSIGNED));
}

fn lane_mul_ok(lane: *ast.Type) bool {
    return lane_is_float(lane) or (u.notnil(lane) and (lane.kind == ast.TY_INT) and (lane.bits != 8));
}

fn is_int_vec_param(t: *ast.Type) bool {
    return param_has(t, ast.C_INT_VEC) or (param_has(t, ast.C_VEC) and lane_is_int(t.constraint_lane));
}

fn vec_param_allows_arith(op: lx.TokKind, t: *ast.Type) bool {
    if not param_has(t, ast.C_VEC) {
        return false;
    }
    let lane = t.constraint_lane;
    if (op == lx.TK_PLUS) or (op == lx.TK_MINUS) {
        return true;
    }
    if op == lx.TK_STAR {
        return param_has(t, ast.C_FLOAT_VEC) or lane_mul_ok(lane);
    }
    if op == lx.TK_SLASH {
        return param_has(t, ast.C_FLOAT_VEC) or lane_is_float(lane);
    }
    if (op == lx.TK_PLUS_PCT) or (op == lx.TK_MINUS_PCT) or (op == lx.TK_AMP) or (op == lx.TK_PIPE) or
       (op == lx.TK_CARET) {
        return is_int_vec_param(t);
    }
    if op == lx.TK_STAR_PCT {
        return is_int_vec_param(t) and u.notnil(lane) and (lane.kind == ast.TY_INT) and (lane.bits != 8);
    }
    return false;
}

// Validate that arithmetic/bitwise operator `op` applies to operand type t.
fn check_arith_op(op: lx.TokKind, t: *mut ast.Type, sp: u.Span) bool {
    if (t.kind == ast.TY_INVALID) or (t.kind == ast.TY_NEVER) {
        return true;
    }
    let opn = lx.tok_kind_name(op);
    if vec_param_allows_arith(op, t) {
        return true;
    }
    match op {
        .PLUS, .MINUS, .STAR, .SLASH => {
            if ty.is_num(t) or ty.is_untyped(t) or ty.is_vec_float(t) or param_has(t, ast.C_NUM) {
                return true;
            }
            if ty.is_vec_int(t) {
                // lane-wise and wrapping, in every overflow mode (§13.1)
                if op == lx.TK_SLASH {
                    _ = dg.err(sp, "E0811", "integer vectors do not support '/'");
                } else if (op == lx.TK_STAR) and (t.elem.bits == 8) {
                    _ = dg.err(sp, "E0811", "8-bit lane vectors have no multiplication");
                } else {
                    return true;
                }
                return false;
            }
        }
        .PERCENT => {
            if (t.kind == ast.TY_INT) or (t.kind == ast.TY_UNTYPED_INT) or param_has(t, ast.C_INT) {
                return true;
            }
            if (t.kind == ast.TY_FLOAT) or (t.kind == ast.TY_UNTYPED_FLOAT) {
                _ = dg.err(sp, "E0521", "'%' is not defined for floats; use @rem");
                return false;
            }
        }
        .PLUS_PCT, .MINUS_PCT, .STAR_PCT => {
            if (t.kind == ast.TY_INT) or (t.kind == ast.TY_UNTYPED_INT) or param_has(t, ast.C_INT) {
                return true;
            }
            if ty.is_vec_int(t) {
                if (op == lx.TK_STAR_PCT) and (t.elem.bits == 8) {
                    _ = dg.err(sp, "E0811", "8-bit lane vectors have no multiplication");
                    return false;
                }
                return true;
            }
        }
        .AMP, .PIPE, .CARET => {
            if (t.kind == ast.TY_INT) or (t.kind == ast.TY_UNTYPED_INT) or ty.is_vec_int(t) or
               (t.kind == ast.TY_V128) or param_has(t, ast.C_INT) {
                return true;
            }
        }
        else => {}
    }
    if t.kind == ast.TY_PARAM {
        _ = dg.err(sp, "E0461", u.f3("operator '%s' is not permitted on '%s' (constraint %s)", opn, t.name,
                                     constraint_str(t.constraint, t.constraint_lane)));
    } else {
        _ = dg.err(sp, "E0513", u.f2("operator '%s' cannot be applied to %s", opn, tstr(t)));
    }
    return false;
}

fn check_cmp_op(op: lx.TokKind, t: *mut ast.Type, sp: u.Span) bool {
    if (t.kind == ast.TY_INVALID) or (t.kind == ast.TY_NEVER) {
        return true;
    }
    let eq = (op == lx.TK_EQEQ) or (op == lx.TK_NE);
    if ty.is_num(t) or ty.is_untyped(t) {
        return true;
    }
    if t.kind == ast.TY_PARAM {
        let mut c = ast.C_ORD;
        if eq {
            c = ast.C_EQ;
        }
        if ty.satisfies(t, c) {
            return true;
        }
        _ = dg.err(sp, "E0461", u.f3("operator '%s' is not permitted on '%s' (constraint %s)", lx.tok_kind_name(op),
                                     t.name, constraint_str(t.constraint, t.constraint_lane)));
        return false;
    }
    if eq and
       ((t.kind == ast.TY_BOOL) or (t.kind == ast.TY_PTR) or (t.kind == ast.TY_ERROR) or (t.kind == ast.TY_FN) or
        (t.kind == ast.TY_ENUM)) {
        return true;
    }
    if (t.kind == ast.TY_VEC) or (t.kind == ast.TY_V128) {
        _ = dg.err(sp, "E0810", u.f1("vectors cannot be compared with '%s'; use @lanes_eq, @lanes_lt, ...",
                                     lx.tok_kind_name(op)));
    } else {
        _ = dg.err(sp, "E0513", u.f2("operator '%s' cannot be applied to %s", lx.tok_kind_name(op), tstr(t)));
    }
    return false;
}

// Checks the right operand of a shift; returns false on error.
fn check_shift_count(pb: *mut *mut ast.Expr) bool {
    let r = check_expr(pb.*, tnil());
    if r.kind == ast.TY_UNTYPED_INT {
        if ast.cval_of(pb.*).is_neg() {
            _ = dg.err(pb.*.span, "E0525", "shift count must not be negative");
            return false;
        }
        coerce(pb, ty.t_u32);
        return true;
    }
    if r.kind == ast.TY_INVALID {
        return true;
    }
    if ((r.kind == ast.TY_INT) and not r.is_signed) or param_has(r, ast.C_UNSIGNED) {
        return true;
    }
    if ty.is_vec_int(r) and not r.elem.is_signed {
        return true;  // per lane (spec §13.1)
    }
    if is_vec_param(r) and lane_is_unsigned_int(r.constraint_lane) {
        return true;
    }
    if (r.kind == ast.TY_INT) or param_has(r, ast.C_SIGNED) or ty.is_vec_int(r) or is_vec_param(r) {
        _ = dg.err(pb.*.span, "E0525", u.f1("shift count must be unsigned, found %s", tstr(r)));
        return false;
    }
    _ = dg.err(pb.*.span, "E0412", u.f1("shift count must be an unsigned integer, found %s", tstr(r)));
    return false;
}

// x op y for a comparison operator op.
fn compare_f64(op: lx.TokKind, x: f64, y: f64) bool {
    if op == lx.TK_EQEQ {
        return x == y;
    }
    if op == lx.TK_NE {
        return x != y;
    }
    if op == lx.TK_LT {
        return x < y;
    }
    if op == lx.TK_LE {
        return x <= y;
    }
    if op == lx.TK_GT {
        return x > y;
    }
    if op == lx.TK_GE {
        return x >= y;
    }
    return false;
}

fn compare_i128(op: lx.TokKind, x: u.I128, y: u.I128) bool {
    if op == lx.TK_EQEQ {
        return x.eq(y);
    }
    if op == lx.TK_NE {
        return not x.eq(y);
    }
    if op == lx.TK_LT {
        return x.lt(y);
    }
    if op == lx.TK_LE {
        return x.le(y);
    }
    if op == lx.TK_GT {
        return x.gt(y);
    }
    if op == lx.TK_GE {
        return x.ge(y);
    }
    return false;
}

// E0412 for the operands of a binary operator op, of types l and r: with a
// fix that splats a scalar operand of a vector's lane type.
fn operand_types_differ(e: *mut ast.Expr, op: lx.TokKind, l: *mut ast.Type, r: *mut ast.Type) void {
    let d = dg.err(e.span, "E0412", u.f3("operands of '%s' have different types: %s and %s", lx.tok_kind_name(op),
                                         tstr(l), tstr(r)));
    dg.set_types(d, tstr(l), tstr(r));
    if (l.kind == ast.TY_VEC) and (r == l.elem) {
        let txt = u.span_text(ast.b_of(e).span);
        let fx = dg.fix(d, "broadcast the scalar to all lanes", "machine");
        dg.edit(fx, ast.b_of(e).span, u.f1("@splat(%s)", txt));
    } else if (r.kind == ast.TY_VEC) and (l == r.elem) {
        let txt = u.span_text(e.a.span);
        let fx = dg.fix(d, "broadcast the scalar to all lanes", "machine");
        dg.edit(fx, e.a.span, u.f1("@splat(%s)", txt));
    }
}

// A shift (op): the count unsigned, the operand an integer (vectors shift
// per lane, by a scalar or a vector of counts of their shape).
fn check_shift(e: *mut ast.Expr, expected: *mut ast.Type, op: lx.TokKind) *mut ast.Type {
    let mut hint = tnil();
    if u.notnil(expected) and
       ((expected.kind == ast.TY_INT) or ty.is_vec_int(expected) or (expected.kind == ast.TY_PARAM)) {
        hint = expected;
    }
    let mut l = check_expr(e.a, hint);
    let ok = check_shift_count(ast.b_mut(e));
    if l.kind == ast.TY_UNTYPED_INT {
        if e.a.is_const and ast.b_of(e).is_const and (ast.b_of(e).ty.kind == ast.TY_INT) {
            let r = fold_int(op, ast.cval_of(e.a), ast.cval_of(ast.b_of(e)), tnil(), e.span);
            if r.ok {
                ast.set_cval(e, r.v);
                e.is_const = true;
            }
            e.ty = ty.t_untyped_int;
            return e.ty;
        }
        if u.notnil(hint) {
            coerce(&mut e.a, hint);
            l = e.a.ty;
        } else {
            _ = sb.finalize_untyped(&mut e.a);
            return set_ty(e, ty.t_invalid);
        }
    }
    let l_ok = (l.kind == ast.TY_INT) or ty.is_vec_int(l) or param_has(l, ast.C_INT) or is_int_vec_param(l) or
               (l.kind == ast.TY_INVALID);
    if not l_ok {
        if l.kind == ast.TY_PARAM {
            _ = dg.err(e.span, "E0461", u.f3("operator '%s' is not permitted on '%s' (constraint %s)",
                                             lx.tok_kind_name(op), l.name,
                                             constraint_str(l.constraint, l.constraint_lane)));
        } else {
            _ = dg.err(e.a.span, "E0513", u.f1("shift requires an integer operand, found %s", tstr(l)));
        }
        return set_ty(e, ty.t_invalid);
    }
    let k = ast.b_of(e).ty;
    if ok and (ty.is_vec_int(k) or is_vec_param(k)) and (l.kind != ast.TY_INVALID) {
        let shape_ok = (ty.is_vec_int(l) and ty.is_vec_int(k) and (l.lanes == k.lanes) and
                        (l.elem.bits == k.elem.bits)) or (is_vec_param(l) and (l == k));
        if not shape_ok {
            _ = dg.err(ast.b_of(e).span, "E0412",
                       u.f2("per-lane shift counts must have the shape of the shifted vector: %s and %s", tstr(l),
                            tstr(k)));
            return set_ty(e, ty.t_invalid);
        }
    }
    if ok and e.a.is_const and ast.b_of(e).is_const and (l.kind == ast.TY_INT) {
        let r = fold_int(op, ast.cval_of(e.a), ast.cval_of(ast.b_of(e)), l, e.span);
        if r.ok {
            ast.set_cval(e, r.v);
            e.is_const = true;
        }
    }
    e.ty = l;
    return e.ty;
}

fn check_binary(e: *mut ast.Expr, expected: *mut ast.Type) *mut ast.Type {
    let op = ast.op_of(e);
    if (op == lx.KW_AND) or (op == lx.KW_OR) {
        _ = check_expr_to(&mut e.a, ty.t_bool);
        _ = check_expr_to(ast.b_mut(e), ty.t_bool);
        e.ty = ty.t_bool;
        return e.ty;
    }
    if is_shift_op(op) {
        return check_shift(e, expected, op);
    }
    let cmp = lx.is_compare_op(op);
    let mut hint = expected;
    if cmp {
        hint = tnil();
    }
    while u.notnil(hint) and ((hint.kind == ast.TY_ERRUNION) or (hint.kind == ast.TY_OPT)) {
        hint = hint.elem;
    }
    let mut l = check_expr(e.a, hint);
    let mut rhint = l;
    if ty.is_untyped(l) {
        rhint = hint;
    }
    let mut r = check_expr(ast.b_of(e), rhint);
    let mut t = tnil();
    if ty.is_untyped(l) and ty.is_untyped(r) {
        t = ty.t_untyped_int;
        if (l.kind == ast.TY_UNTYPED_FLOAT) or (r.kind == ast.TY_UNTYPED_FLOAT) {
            t = ty.t_untyped_float;
        }
        if t == ty.t_untyped_float {
            if l.kind == ast.TY_UNTYPED_INT {
                ast.set_fval(e.a, ast.cval_of(e.a).to_f64());
            }
            if r.kind == ast.TY_UNTYPED_INT {
                ast.set_fval(ast.b_of(e), ast.cval_of(ast.b_of(e)).to_f64());
            }
        }
    } else if ty.is_untyped(l) {
        coerce(&mut e.a, r);
        t = r;
    } else if ty.is_untyped(r) {
        coerce(ast.b_mut(e), l);
        t = l;
    } else {
        if ((op == lx.TK_EQEQ) or (op == lx.TK_NE)) and (l.kind == ast.TY_PTR) and (r.kind == ast.TY_PTR) and
           (l.elem == r.elem) and (l.is_mut != r.is_mut) {
            if l.is_mut {
                coerce(&mut e.a, r);
                l = r;
            } else {
                coerce(ast.b_mut(e), l);
                r = l;
            }
        }
        t = l;
        if (l != r) and (l.kind != ast.TY_INVALID) and (r.kind != ast.TY_INVALID) and (l.kind != ast.TY_NEVER) and
           (r.kind != ast.TY_NEVER) and not (is_err_type(l) and is_err_type(r)) {
            operand_types_differ(e, op, l, r);
            if cmp {
                e.ty = ty.t_bool;
            } else {
                e.ty = ty.t_invalid;
            }
            return e.ty;
        }
    }
    if cmp {
        _ = check_cmp_op(op, t, e.span);
        if ty.is_untyped(t) and e.a.is_const and ast.b_of(e).is_const {
            // two untyped constants: the comparison is a bool constant
            if t.kind == ast.TY_UNTYPED_FLOAT {
                e.bval = compare_f64(op, ast.fval_of(e.a), ast.fval_of(ast.b_of(e)));
            } else {
                e.bval = compare_i128(op, ast.cval_of(e.a), ast.cval_of(ast.b_of(e)));
            }
            e.is_const = true;
        }
        e.ty = ty.t_bool;
        return e.ty;
    }
    if not check_arith_op(op, t, e.span) {
        return set_ty(e, ty.t_invalid);
    }
    // constant folding
    if e.a.is_const and ast.b_of(e).is_const {
        if (t.kind == ast.TY_UNTYPED_INT) or (t.kind == ast.TY_INT) {
            let mut tt = tnil();
            if t.kind == ast.TY_INT {
                tt = t;
            }
            let r2 = fold_int(op, ast.cval_of(e.a), ast.cval_of(ast.b_of(e)), tt, e.span);
            if r2.ok {
                ast.set_cval(e, r2.v);
                e.is_const = true;
            }
        } else if (t.kind == ast.TY_UNTYPED_FLOAT) or (t.kind == ast.TY_FLOAT) {
            let a = ast.fval_of(e.a);
            let b = ast.fval_of(ast.b_of(e));
            let mut r2: f64 = 0.0;
            match op {
                .PLUS  => { r2 = a + b; }
                .MINUS => { r2 = a - b; }
                .STAR  => { r2 = a * b; }
                .SLASH => { r2 = a / b; }
                else => {
                    e.ty = t;
                    return e.ty;
                }
            }
            if (t.kind == ast.TY_FLOAT) and (t.bits == 32) {
                r2 = @as(f64, @float_cast(f32, r2));
            }
            ast.set_fval(e, r2);
            e.is_const = true;
        }
    }
    e.ty = t;
    return e.ty;
}

fn check_unary(e: *mut ast.Expr, expected: *mut ast.Type) *mut ast.Type {
    let op = ast.op_of(e);
    if op == lx.KW_NOT {
        _ = check_expr_to(&mut e.a, ty.t_bool);
        e.ty = ty.t_bool;
        return e.ty;
    }
    if op == lx.TK_AMP {
        // the pointee type expected, if any, types an untyped temporary
        let mut hint = tnil();
        if u.notnil(expected) and (expected.kind == ast.TY_PTR) {
            hint = expected.elem;
        }
        _ = check_operand(e.a, hint);
        check_value(e.a);
        if ty.is_untyped(e.a.ty) {
            if u.notnil(hint) {
                coerce(&mut e.a, hint);
            } else {
                _ = sb.finalize_untyped(&mut e.a);
            }
        }
        let t = e.a.ty;
        if t.kind == ast.TY_INVALID {
            return set_ty(e, ty.t_invalid);
        }
        if not is_place(e.a) {
            // a temporary: codegen gives it a slot that lives to the end of
            // the function (spec §7.5); only its immutable address is given
            if e.bval {
                _ = dg.err(e.a.span, "E0703", "cannot take a mutable address of a temporary value");
                return set_ty(e, ty.t_invalid);
            }
            if t.kind == ast.TY_VOID {
                _ = dg.err(e.a.span, "E0703", "cannot take the address of a void value");
                return set_ty(e, ty.t_invalid);
            }
        } else {
            if e.bval and not is_mut_place(e.a) {
                not_mutable(e.a, "take a mutable address");
            }
            mark_addr_taken(e.a);
        }
        e.ty = ty.type_ptr(t, e.bval);
        return e.ty;
    }
    if op == lx.TK_MINUS {
        let mut hint = tnil();
        if u.notnil(expected) and (expected.kind != ast.TY_ERRUNION) and (expected.kind != ast.TY_OPT) {
            hint = expected;
        }
        let t = check_expr(e.a, hint);
        if ty.is_untyped(t) {
            if e.a.is_const {
                ast.set_cval(e, ast.cval_of(e.a).neg());
                ast.set_fval(e, -ast.fval_of(e.a));
                e.is_const = true;
            }
            e.ty = t;
            return e.ty;
        }
        if ((t.kind == ast.TY_INT) and not t.is_signed) or (ty.is_vec_int(t) and not t.elem.is_signed) {
            let d = dg.err(e.span, "E0520", u.f1("unary '-' cannot be applied to unsigned type %s", tstr(t)));
            let fx = dg.fix(d, "use wrapping negation", "suggestion");
            dg.edit(fx, u.mkspan(e.span.file, e.span.start, e.span.start + 1), "-%");
            return set_ty(e, ty.t_invalid);
        }
        let vec_neg_ok = param_has(t, ast.C_FLOAT_VEC) or
                         (param_has(t, ast.C_VEC) and lane_is_signed(t.constraint_lane));
        if (t.kind == ast.TY_INT) or (t.kind == ast.TY_FLOAT) or ty.is_vec_float(t) or param_has(t, ast.C_SIGNED) or
           param_has(t, ast.C_FLOAT) or vec_neg_ok or (t.kind == ast.TY_INVALID) {
            if e.a.is_const and (t.kind == ast.TY_INT) {
                if not fits_type(ast.cval_of(e.a).neg(), t) {
                    _ = dg.err(e.span, "E0530", "overflow in constant expression");
                }
                ast.set_cval(e, ast.cval_of(e.a).neg());
                e.is_const = true;
            } else if e.a.is_const and (t.kind == ast.TY_FLOAT) {
                ast.set_fval(e, -ast.fval_of(e.a));
                e.is_const = true;
            }
            e.ty = t;
            return e.ty;
        }
        if ty.is_vec_int(t) {
            e.ty = t;  // lane-wise, wrapping (§13.1)
            return e.ty;
        }
        if t.kind == ast.TY_PARAM {
            _ = dg.err(e.span, "E0461", u.f3("operator '%s' is not permitted on '%s' (constraint %s)", "-", t.name,
                                             constraint_str(t.constraint, t.constraint_lane)));
        } else {
            _ = dg.err(e.span, "E0513", u.f1("unary '-' cannot be applied to %s", tstr(t)));
        }
        return set_ty(e, ty.t_invalid);
    }
    if (op == lx.TK_MINUS_PCT) or (op == lx.TK_TILDE) {
        let mut hint = expected;
        while u.notnil(hint) and ((hint.kind == ast.TY_ERRUNION) or (hint.kind == ast.TY_OPT)) {
            hint = hint.elem;
        }
        let mut t = check_expr(e.a, hint);
        if ty.is_untyped(t) {
            if u.notnil(hint) and ((hint.kind == ast.TY_INT) or (hint.kind == ast.TY_PARAM)) {
                coerce(&mut e.a, hint);
                t = e.a.ty;
            } else {
                _ = sb.finalize_untyped(&mut e.a);
                return set_ty(e, ty.t_invalid);
            }
        }
        let ok = (t.kind == ast.TY_INT) or ty.is_vec_int(t) or param_has(t, ast.C_INT) or is_int_vec_param(t) or
                 (t.kind == ast.TY_INVALID) or ((op == lx.TK_TILDE) and (t.kind == ast.TY_V128));
        if not ok {
            if t.kind == ast.TY_PARAM {
                _ = dg.err(e.span, "E0461", u.f3("operator '%s' is not permitted on '%s' (constraint %s)",
                                                 lx.tok_kind_name(op), t.name,
                                                 constraint_str(t.constraint, t.constraint_lane)));
            } else {
                _ = dg.err(e.span, "E0513", u.f2("operator '%s' cannot be applied to %s", lx.tok_kind_name(op),
                                                 tstr(t)));
            }
            return set_ty(e, ty.t_invalid);
        }
        if e.a.is_const and (t.kind == ast.TY_INT) {
            if op == lx.TK_TILDE {
                ast.set_cval(e, wrap_to(ast.cval_of(e.a).not_(), t));
            } else {
                ast.set_cval(e, wrap_to(ast.cval_of(e.a).neg(), t));
            }
            e.is_const = true;
        }
        e.ty = t;
        return e.ty;
    }
    return set_ty(e, ty.t_invalid);
}

// ---------------------------------------------------------------------------
// Names
// ---------------------------------------------------------------------------
fn decl_ref(e: *mut ast.Expr, d: *mut ast.Decl) void {
    resolve_decl(d);
    ast.set_decl(e, d);
    let k = d.kind;
    if (k == ast.D_FN) or (k == ast.D_HOST_FN) {
        ensure_infer_ret(d);
        e.cat = ast.CAT_FUNC;
        ast.set_gargs(e, ty.no_types());
        e.ty = tnil();
        return;
    }
    if k == ast.D_CONST {
        e.cat = ast.CAT_VALUE;
        e.ty = d.ty;
        if u.notnil(d.cexpr) {
            e.is_const = d.cexpr.is_const or (d.cexpr.kind == ast.E_BOOL);
            ast.set_cval(e, ast.cval_of(d.cexpr));
            ast.set_fval(e, ast.fval_of(d.cexpr));
            e.bval = d.cexpr.bval;
        }
        return;
    }
    if k == ast.D_GLOBAL {
        e.cat = ast.CAT_VALUE;
        e.ty = d.ty;
        if u.notnil(C) and C.const_ctx {
            e.is_const = false;
        }
        return;
    }
    if (k == ast.D_STRUCT) or (k == ast.D_UNION) or (k == ast.D_ENUM) {
        if d.gparams.len != 0 {
            e.cat = ast.CAT_GENERIC;
        } else {
            e.cat = ast.CAT_TYPE;
            ast.set_tval(e, d.ty);
        }
        return;
    }
    e.cat = ast.CAT_VALUE;
    e.ty = ty.t_invalid;
}

fn resolve_ident(e: *mut ast.Expr) void {
    let l = scope_lookup(e.name);
    if u.notnil(l) {
        if not C.flow_dead and not C.skip_moved_check and l.moved {
            let d = dg.err(e.span, "E0709", u.f1("use of moved value '%s'", l.name));
            dg.note(d, l.moved_span, "value moved here");
        }
        ast.set_local(e, l);
        e.cat = ast.CAT_VALUE;
        e.ty = l.ty;
        e.weakened = l.weakened;
        return;
    }
    let gp = lookup_gparam(&mut C.tc, e.name);
    if u.notnil(gp) {
        if gp.is_const {
            e.cat = ast.CAT_VALUE;
            e.ty = gp.const_type;
            ast.set_tval(e, gp);
        } else {
            e.cat = ast.CAT_TYPE;
            ast.set_tval(e, gp);
        }
        return;
    }
    let d = module_lookup(C.tc.mod, e.name);
    if u.notnil(d) {
        decl_ref(e, d);
        return;
    }
    let imp = C.tc.mod.imports.get(e.name);
    if u.notnil(imp) {
        e.cat = ast.CAT_MODULE;
        ast.set_module(e, imp.imported);
        e.ty = ty.t_invalid;
        if u.isnil(imp.imported) {
            e.cat = ast.CAT_VALUE;
        }
        return;
    }
    _ = dg.err(e.span, "E0202", u.f1("unknown name '%s'", e.name));
    e.cat = ast.CAT_VALUE;
    e.ty = ty.t_invalid;
}

// ---------------------------------------------------------------------------
// Field access
// ---------------------------------------------------------------------------
// A method or associated function is visible outside its module only if it is
// `pub` (spec §4.2).
fn check_method_visible(e: *mut ast.Expr, m: *mut ast.Decl) void {
    if not m.is_pub and (m.module != C.tc.mod) {
        let g = dg.err(ast.name_span_of(e), "E0203", u.f1("'%s' is not public", e.name));
        dg.note(g, m.name_span, "declared here");
    }
}

// A named struct's field is visible outside its module only if it is `pub`
// (spec §4.2).
fn check_field_visible(use_sp: u.Span, base_decl: *ast.Decl, f: *ast.Field) void {
    if not base_decl.anon and not f.is_pub and (base_decl.module != C.tc.mod) {
        let g = dg.err(use_sp, "E0203", u.f1("'%s' is not public", f.name));
        dg.note(g, f.span, "declared here");
    }
}

fn check_field(e: *mut ast.Expr) *mut ast.Type {
    let a = e.a;
    _ = check_operand(a, tnil());
    let name = e.name;
    let ac = a.cat;
    if ac == ast.CAT_MODULE {
        let d = module_lookup(ast.module_of(a), name);
        if u.isnil(d) {
            _ = dg.err(ast.name_span_of(e), "E0202", u.f1("module has no declaration '%s'", name));
            return set_ty(e, ty.t_invalid);
        }
        if not d.is_pub {
            let g = dg.err(ast.name_span_of(e), "E0203", u.f1("'%s' is not public", name));
            dg.note(g, d.name_span, "declared here");
        }
        decl_ref(e, d);
        if d.kind == ast.D_CONST {
            ast.set_field_kind(e, ast.FK_CONST);
        } else {
            ast.set_field_kind(e, ast.FK_DECL);
        }
        return e.ty;
    }
    if ac == ast.CAT_GENERIC {
        _ = dg.err(a.span, "E0460", u.f2("generic type '%s' must be given arguments: %s.[...]", ast.decl_of(a).name,
                                         ast.decl_of(a).name));
        return set_ty(e, ty.t_invalid);
    }
    if ac == ast.CAT_TYPE {
        let t = ast.tval_of(a);
        if (t.kind != ast.TY_STRUCT) and (t.kind != ast.TY_UNION) and (t.kind != ast.TY_ENUM) {
            _ = dg.err(ast.name_span_of(e), "E0404", u.f2("type %s has no member '%s'", tstr(t), name));
            return set_ty(e, ty.t_invalid);
        }
        let m = find_method(t.decl, name);
        if u.notnil(m) {
            check_method_visible(e, m);
            resolve_decl(m);
            ensure_infer_ret(m);
            e.cat = ast.CAT_FUNC;
            ast.set_field_kind(e, ast.FK_DECL);
            ast.set_decl(e, m);
            ast.set_gargs(e, t.args);
            return tnil();
        }
        if t.kind == ast.TY_UNION {
            let v = find_variant(t.decl, name);
            if v >= 0 {
                ast.set_index(e, v);
                ast.set_tval(e, t);
                if u.notnil(t.decl.variants.at(@int_cast(usize, v)).ty) {
                    e.cat = ast.CAT_VARIANT;
                    return tnil();
                }
                e.cat = ast.CAT_VALUE;
                ast.set_field_kind(e, ast.FK_VARIANT_UNIT);
                e.ty = t;
                return e.ty;
            }
        }
        if t.kind == ast.TY_ENUM {
            let v = find_variant(t.decl, name);
            if v >= 0 {
                ast.set_index(e, v);
                e.cat = ast.CAT_VALUE;
                ast.set_field_kind(e, ast.FK_CONST);
                e.is_const = true;
                ast.set_cval(e, t.decl.variants.at(@int_cast(usize, v)).value);
                e.ty = t;
                return e.ty;
            }
            _ = dg.err(ast.name_span_of(e), "E0404", u.f2("enum %s has no member or method '%s'", tstr(t), name));
            return set_ty(e, ty.t_invalid);
        }
        _ = dg.err(ast.name_span_of(e), "E0404", u.f2("type %s has no method or variant '%s'", tstr(t), name));
        return set_ty(e, ty.t_invalid);
    }
    if (ac == ast.CAT_FUNC) or (ac == ast.CAT_METHOD) or (ac == ast.CAT_VARIANT) {
        check_value(a);
    }
    let t = a.ty;
    if u.isnil(t) or (t.kind == ast.TY_INVALID) {
        return set_ty(e, ty.t_invalid);
    }
    let mut base = t;
    if (t.kind == ast.TY_PTR) and
       ((t.elem.kind == ast.TY_STRUCT) or (t.elem.kind == ast.TY_UNION) or (t.elem.kind == ast.TY_ENUM)) {
        base = t.elem;
        ast.set_self_mode(e, ast.SELF_DEREF);
    }
    if base.kind == ast.TY_STRUCT {
        let fi = sb.find_field(base.decl, name);
        if fi >= 0 {
            check_field_visible(ast.name_span_of(e), base.decl, base.decl.fields.at(@int_cast(usize, fi)));
            ast.set_field_kind(e, ast.FK_STRUCT);
            ast.set_index(e, fi);
            let mut ft = ty.type_field(base, @int_cast(usize, fi));
            let base_immut = ((ast.self_mode_of(e) == ast.SELF_DEREF) and not t.is_mut) or
                             ((ast.self_mode_of(e) != ast.SELF_DEREF) and via_immut_indirection(a));
            if base_immut {
                let wt = weaken_mut(ft);
                if wt != ft {
                    ft = wt;
                    e.weakened = true;
                }
            }
            e.ty = ft;
            return e.ty;
        }
    }
    if (base.kind == ast.TY_STRUCT) or (base.kind == ast.TY_UNION) or (base.kind == ast.TY_ENUM) {
        let m = find_method(base.decl, name);
        if u.notnil(m) {
            check_method_visible(e, m);
            resolve_decl(m);
            ensure_infer_ret(m);
            e.cat = ast.CAT_METHOD;
            ast.set_decl(e, m);
            ast.set_b(e, a);  // receiver
            ast.set_gargs(e, base.args);
            return tnil();
        }
    }
    if t.kind == ast.TY_SLICE {
        if u.str_eq(name, "len") {
            ast.set_field_kind(e, ast.FK_SLICE_LEN);
            e.ty = ty.t_usize;
            return e.ty;
        }
        if u.str_eq(name, "ptr") {
            ast.set_field_kind(e, ast.FK_SLICE_PTR);
            e.ty = ty.type_ptr(t.elem, t.is_mut);
            e.weakened = a.weakened;
            return e.ty;
        }
    }
    if (t.kind == ast.TY_ARRAY) and u.str_eq(name, "len") {
        ast.set_field_kind(e, ast.FK_ARRAY_LEN);
        if u.isnil(t.len_param) {
            e.is_const = true;
            ast.set_cval(e, u.I128.of(t.len));
        }
        e.ty = ty.t_usize;
        return e.ty;
    }
    _ = dg.err(ast.name_span_of(e), "E0404", u.f2("%s has no field or method '%s'", tstr(t), name));
    return set_ty(e, ty.t_invalid);
}

// ---------------------------------------------------------------------------
// Generic application  x.[args]
// ---------------------------------------------------------------------------
fn resolve_garg(te: *mut ast.TypeExpr) *mut ast.Type {
    return resolve_generic_arg(te, &mut C.tc);
}

fn check_apply(e: *mut ast.Expr) void {
    let a = e.a;
    _ = check_operand(a, tnil());
    let n = ast.more(e).targs.len;
    let args = u.newn.[*mut ast.Type](n);
    for i in 0..n {
        args[i] = resolve_garg(ast.more(e).targs.get(i));
    }
    if a.cat == ast.CAT_GENERIC {
        let d = ast.decl_of(a);
        if not check_generic_args(d, args, e.span, &ast.more(e).targs) {
            e.cat = ast.CAT_TYPE;
            ast.set_tval(e, ty.t_invalid);
            return;
        }
        e.cat = ast.CAT_TYPE;
        ast.set_tval(e, ty.type_named(d, args));
        return;
    }
    if (a.cat == ast.CAT_FUNC) or (a.cat == ast.CAT_METHOD) {
        let f = ast.decl_of(a);
        if (f.kind == ast.D_HOST_FN) or (f.gparams.len == 0) {
            _ = dg.err(e.span, "E0468", u.f1("'%s' is not generic", f.name));
            e.cat = a.cat;
            ast.set_decl(e, f);
            ast.set_gargs(e, ast.gargs_of(a));
            ast.set_b(e, ast.b_of(a));
            ast.set_self_mode(e, ast.self_mode_of(a));
            return;
        }
        let nall = f.all_gparams.len;
        if ast.gargs_of(a).len != (nall - f.gparams.len) {
            _ = dg.err(e.span, "E0469", "generic arguments were already given");
        }
        _ = check_generic_args_ctx(f, ast.gargs_of(a), args, e.span, &ast.more(e).targs);
        let nowner = nall - f.gparams.len;
        e.cat = a.cat;
        ast.set_decl(e, f);
        ast.set_gargs(e, u.newn.[*mut ast.Type](nall));
        for i in 0..nowner {
            ast.gargs_of(e)[i] = ast.gargs_of(a)[i];
        }
        for i in 0..f.gparams.len {
            if i < n {
                ast.gargs_of(e)[nowner + i] = args[i];
            } else {
                ast.gargs_of(e)[nowner + i] = ty.t_invalid;
            }
        }
        ast.set_b(e, ast.b_of(a));
        ast.set_self_mode(e, ast.self_mode_of(a));
        return;
    }
    if a.cat == ast.CAT_TYPE {
        _ = dg.err(e.span, "E0468", u.f1("type %s is not generic", tstr(ast.tval_of(a))));
    } else if u.notnil(a.ty) and (a.ty.kind != ast.TY_INVALID) {
        _ = dg.err(e.span, "E0468", "generic arguments can only be applied to generic types and functions");
    }
    e.cat = ast.CAT_VALUE;
    e.ty = ty.t_invalid;
}

// ---------------------------------------------------------------------------
// Calls
// ---------------------------------------------------------------------------
fn unify(pat: *mut ast.Type, act: *mut ast.Type, vars: []mut *mut ast.Type, sol: []mut *mut ast.Type) bool {
    if not pat.has_params {
        return true;
    }
    if u.isnil(act) or (act.kind == ast.TY_INVALID) or ty.is_untyped(act) or (act.kind == ast.TY_NEVER) {
        return true;
    }
    let k = pat.kind;
    if k == ast.TY_PARAM {
        let mut ok = true;
        for i in 0..vars.len {
            if vars[i] != pat {
                continue;
            }
            if u.isnil(sol[i]) {
                sol[i] = act;
            } else if sol[i] != act {
                ok = false;
            }
            break;
        }
        if not ok {
            return false;
        }
        if not pat.is_const and u.notnil(pat.constraint_lane) {
            if act.kind == ast.TY_VEC {
                return unify(pat.constraint_lane, act.elem, vars, sol);
            }
            if (act.kind == ast.TY_PARAM) and not act.is_const and u.notnil(act.constraint_lane) {
                return unify(pat.constraint_lane, act.constraint_lane, vars, sol);
            }
        }
        return true;
    }
    if k == ast.TY_CONSTFN {
        if (act.kind != ast.TY_CONSTFN) or (act.decl != pat.decl) or (act.args.len != pat.args.len) {
            return true;
        }
        for i in 0..pat.args.len {
            if not unify(pat.args[i], act.args[i], vars, sol) {
                return false;
            }
        }
        return true;
    }
    if (k == ast.TY_PTR) or (k == ast.TY_SLICE) {
        if act.kind != k {
            return true;
        }
        return unify(pat.elem, act.elem, vars, sol);
    }
    if k == ast.TY_ERRUNION {
        if act.kind == ast.TY_ERRUNION {
            if u.notnil(pat.err_param) {
                let mut act_err = act.err_param;
                if u.isnil(act_err) {
                    act_err = ty.type_errset(act.decl);
                }
                if not unify(pat.err_param, act_err, vars, sol) {
                    return false;
                }
            }
            return unify(pat.elem, act.elem, vars, sol);
        }
        if u.notnil(pat.err_param) and is_err_type(act) {
            return unify(pat.err_param, act, vars, sol);
        }
        return unify(pat.elem, act, vars, sol);
    }
    if k == ast.TY_OPT {
        if act.kind == ast.TY_OPT {
            return unify(pat.elem, act.elem, vars, sol);
        }
        return unify(pat.elem, act, vars, sol);
    }
    if k == ast.TY_ARRAY {
        if act.kind != ast.TY_ARRAY {
            return true;
        }
        if not unify(pat.elem, act.elem, vars, sol) {
            return false;
        }
        if u.notnil(pat.len_param) {
            let mut lv = act.len_param;
            if u.isnil(lv) {
                lv = ty.type_constint(act.len);
            }
            return unify(pat.len_param, lv, vars, sol);
        }
        return true;
    }
    if k == ast.TY_FN {
        if (act.kind != ast.TY_FN) or (act.params.len != pat.params.len) {
            return true;
        }
        for i in 0..pat.params.len {
            if not unify(pat.params[i], act.params[i], vars, sol) {
                return false;
            }
        }
        return unify(pat.ret, act.ret, vars, sol);
    }
    if (k == ast.TY_STRUCT) or (k == ast.TY_UNION) {
        if act.decl != pat.decl {
            return true;
        }
        for i in 0..pat.args.len {
            if not unify(pat.args[i], act.args[i], vars, sol) {
                return false;
            }
        }
        return true;
    }
    return true;
}

fn mentions(t: *mut ast.Type, vars: []mut *mut ast.Type) bool {
    if not t.has_params {
        return false;
    }
    for i in 0..vars.len {
        let mut from: [1]*mut ast.Type = [vars[i]];
        let mut to: [1]*mut ast.Type = [ty.t_invalid];
        if ty.subst(t, from[..], to[..]) != t {
            return true;
        }
    }
    return false;
}

// Arguments in the variadic part of a C call undergo C's default argument
// promotions, so only already-promoted types are accepted (spec §14.5).
fn check_vararg(pe: *mut *mut ast.Expr) void {
    let t = check_expr(pe.*, tnil());
    if t.kind == ast.TY_UNTYPED_INT {
        if fits_type(ast.cval_of(pe.*), ty.t_i32) {
            coerce(pe, ty.t_i32);
        } else {
            coerce(pe, ty.t_i64);
        }
        return;
    }
    if t.kind == ast.TY_UNTYPED_FLOAT {
        coerce(pe, ty.t_f64);
        return;
    }
    let ok = ((t.kind == ast.TY_INT) and (t.bits >= 32)) or ((t.kind == ast.TY_FLOAT) and (t.bits == 64)) or
             (t.kind == ast.TY_PTR) or (t.kind == ast.TY_FN) or (t.kind == ast.TY_INVALID) or
             ((t.kind == ast.TY_OPT) and ((t.elem.kind == ast.TY_PTR) or (t.elem.kind == ast.TY_FN)));
    if ok {
        return;
    }
    let d = dg.err(pe.*.span, "E0824",
                   u.f1("C variadic arguments must be i32, u32, i64, u64, isize, usize, f64 or pointers (C's default argument promotions); found %s",
                        tstr(t)));
    if (t.kind == ast.TY_INT) or (t.kind == ast.TY_FLOAT) {
        let txt = u.span_text(pe.*.span);
        let mut to: []u8 = "u32";
        if t.kind == ast.TY_FLOAT {
            to = "f64";
        } else if t.is_signed {
            to = "i32";
        }
        let fx = dg.fix(d, "apply the promotion explicitly", "machine");
        dg.edit(fx, pe.*.span, u.f2("@as(%s, %s)", to, txt));
    }
}

fn check_args_count(e: *mut ast.Expr, want: usize, f: *mut ast.Decl) void {
    let n = ast.args_of(e).len;
    if u.notnil(f) and f.variadic {
        if n < want {
            let d = dg.err(e.span, "E0420", u.f3("expected at least %s argument%s, found %s", u.zdec(want),
                                                 u.pick(want == 1, "", "s"), u.zdec(n)));
            dg.note(d, f.name_span, u.f1("'%s' declared here", f.name));
        }
        return;
    }
    if n != want {
        let d = dg.err(e.span, "E0420",
                       u.f3("expected %s argument%s, found %s", u.zdec(want), u.pick(want == 1, "", "s"), u.zdec(n)));
        if u.notnil(f) {
            dg.note(d, f.name_span, u.f1("'%s' declared here", f.name));
        }
    }
}

fn check_all_args(e: *mut ast.Expr) void {
    for i in 0..ast.args_of(e).len {
        _ = check_expr(ast.args_of(e).get(i), tnil());
    }
}

// A call of the function or method (callee) f: its arguments checked against
// f's parameters (phase 1), generic arguments deduced from them unless all
// are given (phase 2), and the arguments coerced to the parameters (phase 3).
fn check_direct_call(e: *mut ast.Expr, callee: *mut ast.Expr, method: bool) *mut ast.Type {
    let f = ast.decl_of(callee);
    resolve_decl(f);
    if f.state != ast.DeclState.DONE {
        // (a call in the function's own signature, E0355: its parameters are not known yet)
        check_all_args(e);
        return set_ty(e, ty.t_invalid);
    }
    if method and (f.self_kind == ast.SELF_NONE) {
        _ = dg.err(callee.span, "E0421", u.f3("'%s' has no 'self' parameter; call it as %s.%s(...)", f.name,
                                              f.owner.name, f.name));
        check_all_args(e);
        return set_ty(e, ty.t_invalid);
    }
    let mut first: usize = 0;
    if method {
        first = 1;
    }
    let nparams = f.params.len - first;
    check_args_count(e, nparams, f);
    let nall = f.all_gparams.len;
    let mut nown = f.gparams.len;
    if f.kind == ast.D_HOST_FN {
        nown = 0;
    }
    let nowner = nall - nown;
    let gargs = u.newn.[*mut ast.Type](nall);
    let mut i: usize = 0;
    while (i < ast.gargs_of(callee).len) and (i < nall) {
        gargs[i] = ast.gargs_of(callee)[i];
        i += 1;
    }
    let deduce = (nown > 0) and (ast.gargs_of(callee).len < nall);
    let owner_from = f.all_gparams[0..nowner];
    let owner_to = gargs[0..nowner];
    let own_vars = f.all_gparams[nowner..];
    // phase 1: check args
    let mut nargs = ast.args_of(e).len;
    if nargs > nparams {
        nargs = nparams;
    }
    for j in 0..ast.args_of(e).len {
        if j >= nparams {
            if f.variadic {
                check_vararg(ast.args_mut(e).at_mut(j));
            } else {
                _ = check_expr(ast.args_of(e).get(j), tnil());
            }
            continue;
        }
        let mut pt = ty.subst(f.param_types[first + j], owner_from, owner_to);
        if deduce and mentions(pt, own_vars) {
            _ = check_expr(ast.args_of(e).get(j), tnil());
        } else {
            if not deduce {
                pt = ty.subst(f.param_types[first + j], f.all_gparams, gargs);
            }
            _ = check_expr(ast.args_of(e).get(j), pt);
        }
    }
    // phase 2: deduce
    if deduce {
        deduce_gargs(e, f, first, nargs, nowner, gargs);
    }
    // phase 3: coerce args
    for j in 0..nargs {
        let pt = ty.subst(f.param_types[first + j], f.all_gparams, gargs);
        coerce(ast.args_mut(e).at_mut(j), pt);
    }
    for j in 0..ast.args_of(e).len {
        check_no_copy(ast.args_of(e).get(j));
    }
    ast.set_decl(e, f);
    ast.set_gargs(e, gargs);
    ast.set_call_kind(e, ast.CALLK_DIRECT);
    if f.is_inline and u.notnil(C.fnd) and C.fnd.is_inline {
        C.fnd.inline_callees.push(f);
        C.fnd.inline_call_spans.push(e.span);
    }
    if method {
        check_receiver(e, callee, f);
    }
    ensure_infer_ret(f);
    e.ty = ty.subst(f.ret_type, f.all_gparams, gargs);
    return e.ty;
}

// Phase 2 of a direct call of f with deduced generic arguments: f's own
// generic parameters (gargs[nowner..]) solved from the types of the first
// nargs arguments (checked in phase 1). `first` skips a method's self.
fn deduce_gargs(e: *mut ast.Expr, f: *mut ast.Decl, first: usize, nargs: usize, nowner: usize,
                gargs: []mut *mut ast.Type) void {
    let nown = gargs.len - nowner;
    let owner_from = f.all_gparams[0..nowner];
    let owner_to = gargs[0..nowner];
    let own_vars = f.all_gparams[nowner..];
    let sol = u.newn.[*mut ast.Type](nown);
    let mut ok = true;
    for j in 0..nargs {
        let pt = ty.subst(f.param_types[first + j], owner_from, owner_to);
        let arg = ast.args_of(e).get(j);
        let mut before: [16]*mut ast.Type = [tnil(); 16];
        for k in 0..nown {
            if k >= 16 {
                break;
            }
            before[k] = sol[k];
        }
        if not unify(pt, arg.ty, own_vars, sol) {
            for k in 0..nown {
                if k >= 16 {
                    break;
                }
                if u.notnil(before[k]) and (sol[k] == before[k]) {
                    let mut tmp: [1]*mut ast.Type = [tnil()];
                    _ = unify(pt, arg.ty, own_vars[k..k + 1], tmp[..]);
                    if u.notnil(tmp[0]) and (tmp[0] != before[k]) {
                        let gp = f.gparams.at(k);
                        let d = dg.err(arg.span, "E0464",
                                       u.f3("conflicting types for generic parameter '%s': %s and %s", gp.name,
                                            tstr(before[k]), tstr(tmp[0])));
                        dg.note(d, gp.span, u.f1("'%s' declared here", gp.name));
                    }
                }
            }
            ok = false;
        }
    }
    for k in 0..nown {
        if not ok {
            break;
        }
        if u.isnil(sol[k]) {
            let gp = f.gparams.at(k);
            let d = dg.err(e.span, "E0463",
                           u.f3("cannot deduce generic parameter '%s' of '%s'; give it explicitly: %s.[...](...)",
                                gp.name, f.name, f.name));
            dg.note(d, gp.span, u.f1("'%s' declared here", gp.name));
            ok = false;
        }
    }
    for k in 0..nown {
        if u.notnil(sol[k]) {
            gargs[nowner + k] = sol[k];
        } else {
            gargs[nowner + k] = ty.t_invalid;
        }
    }
    if ok {
        _ = check_generic_args_ctx(f, gargs[0..nowner], gargs[nowner..nowner + nown], e.span,
                                   u.nil.[u.List.[*mut ast.TypeExpr]]());
    }
}

// How a method call passes its receiver (callee.b) to f's self.
fn check_receiver(e: *mut ast.Expr, callee: *mut ast.Expr, f: *mut ast.Decl) void {
    let recv = ast.b_of(callee);
    let rt = recv.ty;
    let via_ptr = ast.self_mode_of(callee) == ast.SELF_DEREF;
    let sk = f.self_kind;
    if sk == ast.SELF_VALUE {
        if via_ptr {
            if (rt.kind == ast.TY_PTR) and u.notnil(rt.elem) and (rt.elem.kind != ast.TY_INVALID) and
               type_is_nocopy(rt.elem) {
                _ = dg.err(recv.span, "E0708", u.f1("cannot copy nocopy value of type %s", tstr(rt.elem)));
            }
            ast.set_self_mode(e, ast.SELF_DEREF);
        } else {
            check_no_copy(recv);
            ast.set_self_mode(e, ast.SELF_VALUE);
        }
    } else if sk == ast.SELF_ADDR {
        if via_ptr {
            ast.set_self_mode(e, ast.SELF_PASS);
        } else {
            // a temporary receiver gets a slot, as &temporary does
            ast.set_self_mode(e, ast.SELF_ADDR);
            mark_addr_taken(recv);
        }
    } else if sk == ast.SELF_PASS {
        if via_ptr {
            if not rt.is_mut {
                _ = dg.err(recv.span, "E0702", u.f2("method '%s' takes '*mut Self', but the receiver is %s", f.name,
                                                    tstr(rt)));
            }
            ast.set_self_mode(e, ast.SELF_PASS);
        } else if not is_place(recv) {
            _ = dg.err(recv.span, "E0703",
                       u.f1("method '%s' needs the mutable address of its receiver, but it is a temporary", f.name));
        } else {
            if not is_mut_place(recv) {
                not_mutable(recv, u.f1("call '%s' (it takes *mut Self)", f.name));
            }
            ast.set_self_mode(e, ast.SELF_ADDR);
            mark_addr_taken(recv);
        }
    }
    ast.set_b(e, recv);
}

fn check_call(e: *mut ast.Expr, expected: *mut ast.Type) *mut ast.Type {
    let callee = e.a;
    _ = check_operand(callee, tnil());
    e.cat = ast.CAT_VALUE;
    let cc = callee.cat;
    if (cc == ast.CAT_FUNC) or (cc == ast.CAT_METHOD) {
        return check_direct_call(e, callee, cc == ast.CAT_METHOD);
    }
    if cc == ast.CAT_VARIANT {
        let ut = ast.tval_of(callee);
        let v = ast.index_of(callee);
        let pt = ty.type_variant(ut, @int_cast(usize, v));
        check_args_count(e, 1, dnil());
        for i in 0..ast.args_of(e).len {
            if i == 0 {
                _ = check_expr_to(ast.args_mut(e).at_mut(0), pt);
                move_or_check_nocopy(ast.args_of(e).get(0));
            } else {
                _ = check_expr(ast.args_of(e).get(i), tnil());
            }
        }
        ast.set_call_kind(e, ast.CALLK_VARIANT);
        ast.set_index(e, v);
        ast.set_tval(e, ut);
        e.ty = ut;
        return e.ty;
    }
    if cc == ast.CAT_TYPE {
        _ = dg.err(callee.span, "E0406", u.f2("%s is a type, not a function; use %s.{ ... } to construct a struct",
                                              tstr(ast.tval_of(callee)), tstr(ast.tval_of(callee))));
        return set_ty(e, ty.t_invalid);
    }
    if cc == ast.CAT_GENERIC {
        _ = dg.err(callee.span, "E0460", u.f1("generic type '%s' must be given arguments", ast.decl_of(callee).name));
        return set_ty(e, ty.t_invalid);
    }
    if cc == ast.CAT_MODULE {
        _ = dg.err(callee.span, "E0406", "a module cannot be called");
        return set_ty(e, ty.t_invalid);
    }
    let ft = callee.ty;
    if u.isnil(ft) or (ft.kind == ast.TY_INVALID) {
        check_all_args(e);
        return set_ty(e, ty.t_invalid);
    }
    if ft.kind != ast.TY_FN {
        _ = dg.err(callee.span, "E0406", u.f1("cannot call a value of type %s", tstr(ft)));
        check_all_args(e);
        return set_ty(e, ty.t_invalid);
    }
    check_args_count(e, ft.params.len, dnil());
    for i in 0..ast.args_of(e).len {
        if i < ft.params.len {
            _ = check_expr_to(ast.args_mut(e).at_mut(i), ft.params[i]);
            check_no_copy(ast.args_of(e).get(i));
        } else {
            _ = check_expr(ast.args_of(e).get(i), tnil());
        }
    }
    ast.set_call_kind(e, ast.CALLK_INDIRECT);
    e.ty = ft.ret;
    return e.ty;
}

// ---------------------------------------------------------------------------
// Literals
// ---------------------------------------------------------------------------
fn check_struct_lit(e: *mut ast.Expr, expected: *mut ast.Type) *mut ast.Type {
    let mut t = tnil();
    if u.notnil(e.a) {
        _ = check_operand(e.a, tnil());
        if (e.a.cat == ast.CAT_TYPE) and (ast.tval_of(e.a).kind == ast.TY_STRUCT) {
            t = ast.tval_of(e.a);
        } else if e.a.cat == ast.CAT_GENERIC {
            _ = dg.err(e.a.span, "E0460", u.f2("generic type '%s' must be given arguments: %s.[...]",
                                               ast.decl_of(e.a).name, ast.decl_of(e.a).name));
        } else if not ((e.a.cat == ast.CAT_TYPE) and (ast.tval_of(e.a).kind == ast.TY_INVALID)) and
                  not (u.notnil(e.a.ty) and (e.a.ty.kind == ast.TY_INVALID)) {
            _ = dg.err(e.a.span, "E0408", "struct literal requires a struct type");
        }
    } else if u.notnil(expected) {
        let mut x = expected;
        while u.notnil(x) and ((x.kind == ast.TY_ERRUNION) or (x.kind == ast.TY_OPT)) {
            x = x.elem;
        }
        if x.kind == ast.TY_STRUCT {
            t = x;
        } else if x.kind != ast.TY_INVALID {
            _ = dg.err(e.span, "E0408", u.f1("anonymous struct literal where %s is expected", tstr(expected)));
        }
    } else {
        _ = dg.err(e.span, "E0503", "cannot infer the type of '.{ ... }'; write T.{ ... }");
    }
    if u.isnil(t) {
        for i in 0..ast.more(e).inits.len {
            _ = check_expr(ast.ext(e).inits.at_mut(i).value, tnil());
        }
        return set_ty(e, ty.t_invalid);
    }
    let d = t.decl;
    let nf = d.fields.len;
    let mut order_ok = ast.more(e).inits.len == nf;
    for i in 0..ast.more(e).inits.len {
        if not order_ok {
            break;
        }
        if not u.same(ast.more(e).inits.at(i).name, d.fields.at(i).name) {
            order_ok = false;
        }
    }
    let mut priv_missing = false;
    if not d.anon and (d.module != C.tc.mod) {
        for i in 0..nf {
            let f = d.fields.at(i);
            if f.is_pub {
                continue;
            }
            let mut given = false;
            for j in 0..ast.more(e).inits.len {
                if u.same(ast.more(e).inits.at(j).name, f.name) {
                    given = true;
                    break;
                }
            }
            if not given {
                let dg2 = dg.err(e.span, "E0203", u.f2("cannot construct %s: field '%s' is not public", tstr(t),
                                                       f.name));
                dg.note(dg2, f.span, "declared here");
                priv_missing = true;
                break;
            }
        }
    }
    if not priv_missing and not order_ok {
        // Build a helpful message: expected field order.
        let mut b = u.Buf.init();
        for i in 0..nf {
            if i != 0 {
                b.s(", ");
            }
            b.s(d.fields.at(i).name);
        }
        let dgn = dg.err(e.span, "E0410", u.f2("struct literal of %s must list every field, in declaration order: %s",
                                               tstr(t), b.done()));
        // machine fix: reorder when the set of names is exactly right
        let mut same_set = ast.more(e).inits.len == nf;
        for i in 0..nf {
            if not same_set {
                break;
            }
            let mut found = false;
            for j in 0..ast.more(e).inits.len {
                if u.same(ast.more(e).inits.at(j).name, d.fields.at(i).name) {
                    found = true;
                }
            }
            if not found {
                same_set = false;
            }
        }
        if same_set and (nf > 0) {
            let mut r = u.Buf.init();
            for i in 0..nf {
                for j in 0..ast.more(e).inits.len {
                    let fi = ast.more(e).inits.at(j);
                    if not u.same(fi.name, d.fields.at(i).name) {
                        continue;
                    }
                    if i != 0 {
                        r.s(", ");
                    }
                    r.s(fi.name);
                    r.s(": ");
                    r.s(u.span_text(fi.value.span));
                }
            }
            let whole = u.mkspan(e.span.file, ast.more(e).inits.at(0).span.start,
                                 ast.more(e).inits.at(ast.more(e).inits.len - 1).value.span.end);
            let fx = dg.fix(dgn, "reorder the fields", "machine");
            let text = r.done();
            // (the C implementation copies the replacement as a C string)
            let z = u.find(text, 0);
            if z >= 0 {
                dg.edit(fx, whole, u.dup(text[0..@int_cast(usize, z)]));
            } else {
                dg.edit(fx, whole, text);
            }
        }
    }
    for i in 0..ast.more(e).inits.len {
        let fi = ast.ext(e).inits.at_mut(i);
        let idx = sb.find_field(d, fi.name);
        if idx < 0 {
            _ = dg.err(fi.span, "E0404", u.f2("%s has no field '%s'", tstr(t), fi.name));
            _ = check_expr(fi.value, tnil());
            continue;
        }
        check_field_visible(fi.span, d, d.fields.at(@int_cast(usize, idx)));
        _ = check_expr_to(&mut fi.value, ty.type_field(t, @int_cast(usize, idx)));
        move_or_check_nocopy(fi.value);
    }
    ast.set_tval(e, t);
    e.ty = t;
    return e.ty;
}

fn check_array_lit(e: *mut ast.Expr, expected: *mut ast.Type) *mut ast.Type {
    let mut x = expected;
    while u.notnil(x) and ((x.kind == ast.TY_ERRUNION) or (x.kind == ast.TY_OPT)) {
        x = x.elem;
    }
    let mut elem = tnil();
    if u.notnil(x) and (x.kind == ast.TY_ARRAY) {
        elem = x.elem;
    }
    if e.kind == ast.E_ARRAY_REPEAT {
        _ = check_expr_to(ast.b_mut(e), ty.t_usize);
        // a const generic parameter gives an array of that (symbolic) length
        let mut lenp = tnil();
        if (ast.b_of(e).kind == ast.E_IDENT) and u.notnil(ast.tval_of(ast.b_of(e))) and
           (ast.tval_of(ast.b_of(e)).kind == ast.TY_PARAM) and ast.tval_of(ast.b_of(e)).is_const and
           (ast.tval_of(ast.b_of(e)).const_type.kind == ast.TY_INT) {
            lenp = ast.tval_of(ast.b_of(e));
        }
        if u.isnil(lenp) and not ast.b_of(e).is_const and (ast.b_of(e).ty.kind != ast.TY_INVALID) {
            _ = dg.err(ast.b_of(e).span, "E0350", "array repeat count must be a constant");
            return set_ty(e, ty.t_invalid);
        }
        let n = ast.cval_of(ast.b_of(e)).i64v();
        if u.notnil(elem) {
            _ = check_expr_to(&mut e.a, elem);
        } else {
            elem = check_expr(e.a, tnil());
            if ty.is_untyped(elem) {
                _ = sb.finalize_untyped(&mut e.a);
                return set_ty(e, ty.t_invalid);
            }
        }
        if (u.notnil(lenp) or (n > 1)) and u.notnil(elem) and type_is_nocopy(elem) {
            _ = dg.err(e.span, "E0708", u.f1("cannot repeat nocopy value of type %s", tstr(elem)));
        } else {
            move_or_check_nocopy(e.a);
        }
        if u.notnil(lenp) {
            e.ty = ty.type_array_param(elem, lenp);
            return e.ty;
        }
        let t = ty.type_array(elem, n);
        if u.notnil(x) and (x.kind == ast.TY_ARRAY) and u.isnil(x.len_param) and (x.len != n) and
           (x.elem.kind != ast.TY_INVALID) {
            type_mismatch(e, x, t);
        }
        e.ty = t;
        return e.ty;
    }
    let n = ast.args_of(e).len;
    for i in 0..n {
        if u.notnil(elem) {
            _ = check_expr_to(ast.args_mut(e).at_mut(i), elem);
            move_or_check_nocopy(ast.args_of(e).get(i));
        } else {
            elem = check_expr(ast.args_of(e).get(i), tnil());
            if ty.is_untyped(elem) {
                _ = sb.finalize_untyped(ast.args_mut(e).at_mut(i));
                elem = tnil();
            } else {
                move_or_check_nocopy(ast.args_of(e).get(i));
            }
        }
    }
    if u.isnil(elem) {
        return set_ty(e, ty.t_invalid);
    }
    let t = ty.type_array(elem, @int_cast(i64, n));
    if u.notnil(x) and (x.kind == ast.TY_ARRAY) and u.isnil(x.len_param) and (x.len != @int_cast(i64, n)) {
        type_mismatch(e, x, t);
    }
    e.ty = t;
    return e.ty;
}

// ---------------------------------------------------------------------------
// catch / try
// ---------------------------------------------------------------------------
fn check_leave_ok(sp: u.Span, is_loop_exit: bool) bool {
    if (C.defer_depth > 0) and (not is_loop_exit or (C.loop_depth <= C.defer_loop_base)) {
        _ = dg.err(sp, "E0640", "control flow cannot leave a deferred statement");
        return false;
    }
    return true;
}

fn record_ret_err(name: []u8) void {
    for i in 0..C.ret_errs.len {
        if u.same(C.ret_errs.get(i), name) {
            return;
        }
    }
    C.ret_errs.push(name);
}

fn record_ret_set(d: *mut ast.Decl) void {
    resolve_decl(d);
    for i in 0..d.set_names.len {
        record_ret_err(d.set_names.get(i));
    }
}

fn is_self_infer_call(e0: *mut ast.Expr) bool {
    let e = unwrap_conv(e0);
    return u.notnil(e) and u.notnil(C.fnd) and C.fnd.inferring_ret and (e.kind == ast.E_CALL) and
           (ast.call_kind_of(e) == ast.CALLK_DIRECT) and (ast.decl_of(e) == C.fnd);
}

// pe is nil for a return without a value.
fn check_return_value(pe: *mut *mut ast.Expr, sp: u.Span) void {
    if u.isnil(C.fnd) {
        _ = dg.err(sp, "E0602", "'return' outside of a function");
        return;
    }
    _ = check_leave_ok(sp, false);
    let r = C.ret;
    if u.isnil(pe) or u.isnil(pe.*) {
        if (r.kind != ast.TY_VOID) and not ((r.kind == ast.TY_ERRUNION) and (r.elem.kind == ast.TY_VOID)) and
           (r.kind != ast.TY_INVALID) {
            _ = dg.err(sp, "E0602", u.f1("this function must return a value of type %s", tstr(r)));
        }
        return;
    }
    if r.kind == ast.TY_VOID {
        _ = check_expr(pe.*, tnil());
        _ = dg.err(pe.*.span, "E0603", "a void function cannot return a value");
        return;
    }
    _ = check_expr(pe.*, r);
    if (r.kind == ast.TY_ERRUNION) and not C.ret_err_open {
        let e = pe.*;
        let s = e.ty;
        let ue = unwrap_conv(e);
        if u.notnil(ue) and (ue.kind == ast.E_ERROR_VAL) {
            if not ast.cval_of(ue).is_zero() {
                record_ret_err(ue.name);
            }
        } else if s.kind == ast.TY_ERROR {
            if u.notnil(s.decl) {
                record_ret_set(s.decl);
            } else {
                C.ret_err_open = true;
            }
        } else if (s.kind == ast.TY_PARAM) and s.is_error_param {
            C.ret_err_open = true;
        } else if s.kind == ast.TY_ERRUNION {
            if u.notnil(s.err_param) {
                C.ret_err_open = true;
            } else if u.notnil(s.decl) {
                record_ret_set(s.decl);
            } else if not is_self_infer_call(e) {
                C.ret_err_open = true;
            }
        }
    }
    let prev_ret = C.in_return;
    C.in_return = true;
    coerce(pe, r);
    C.in_return = prev_ret;
    move_or_check_nocopy(pe.*);
    check_escape(pe.*);
}

fn type_can_hold_ptr_rec(t0: *mut ast.Type, depth: i32) bool {
    if u.isnil(t0) or (depth >= 16) {
        return false;
    }
    let k = t0.kind;
    if (k == ast.TY_PTR) or (k == ast.TY_SLICE) {
        return true;
    }
    if (k == ast.TY_OPT) or (k == ast.TY_ERRUNION) or (k == ast.TY_ARRAY) {
        return type_can_hold_ptr_rec(t0.elem, depth + 1);
    }
    if k == ast.TY_STRUCT {
        let d = t0.decl;
        if u.isnil(d) {
            return false;
        }
        if not d.anon and (d.state == ast.DeclState.UNRESOLVED) {
            resolve_decl(d);
        }
        for i in 0..d.fields.len {
            if u.isnil(d.fields.at(i).ty) {
                continue;
            }
            if type_can_hold_ptr_rec(ty.type_field(t0, i), depth + 1) {
                return true;
            }
        }
        return false;
    }
    if k == ast.TY_UNION {
        let d = t0.decl;
        if u.isnil(d) {
            return false;
        }
        if not d.anon and (d.state == ast.DeclState.UNRESOLVED) {
            resolve_decl(d);
        }
        for i in 0..d.variants.len {
            if u.isnil(d.variants.at(i).ty) {
                continue;
            }
            let vt = ty.type_variant(t0, i);
            if u.notnil(vt) and type_can_hold_ptr_rec(vt, depth + 1) {
                return true;
            }
        }
        return false;
    }
    return false;
}

fn type_can_hold_ptr(t0: *mut ast.Type) bool {
    return type_can_hold_ptr_rec(t0, 0);
}

// The local whose storage place e is part of (nil: a global, or memory
// reached through a pointer or a slice).
fn place_local(e: *mut ast.Expr) *mut ast.Local {
    let k = e.kind;
    if k == ast.E_IDENT {
        return ast.local_of(e);
    }
    if (k == ast.E_FIELD) and (ast.field_kind_of(e) == ast.FK_STRUCT) and (ast.self_mode_of(e) != ast.SELF_DEREF) {
        return place_local(e.a);
    }
    if (k == ast.E_INDEX) and (ast.index_kind_of(e) == ast.IDX_ARRAY) {
        return place_local(e.a);
    }
    return u.nil.[ast.Local]();
}

// The local whose storage place `e` points into or is part of (following
// pointer dereferences and slice indexing via expr_local_origin).
fn place_origin(e: *mut ast.Expr) *mut ast.Local {
    if u.isnil(e) {
        return u.nil.[ast.Local]();
    }
    let k = e.kind;
    if k == ast.E_IDENT {
        return ast.local_of(e);
    }
    if k == ast.E_FIELD {
        if ast.field_kind_of(e) == ast.FK_STRUCT {
            if ast.self_mode_of(e) != ast.SELF_DEREF {
                return place_origin(e.a);
            }
            return expr_local_origin(e.a);
        }
        return u.nil.[ast.Local]();
    }
    if k == ast.E_INDEX {
        if ast.index_kind_of(e) == ast.IDX_ARRAY {
            return place_origin(e.a);
        }
        return expr_local_origin(e.a);
    }
    if k == ast.E_DEREF {
        return expr_local_origin(e.a);
    }
    return u.nil.[ast.Local]();
}

fn expr_local_origin_mask(e: *mut ast.Expr, mask_out: *mut u64) *mut ast.Local {
    if u.isnil(e) or u.isnil(e.ty) or (e.ty.kind == ast.TY_INVALID) or not type_can_hold_ptr(e.ty) {
        mask_out.* = 0;
        return u.nil.[ast.Local]();
    }
    let k = e.kind;
    if k == ast.E_CONV {
        if (e.ty.kind == ast.TY_SLICE) and u.notnil(e.a) and u.notnil(e.a.ty) and (e.a.ty.kind == ast.TY_ARRAY) {
            let l = place_origin(e.a);
            if u.notnil(l) {
                mask_out.* = ~@as(u64, 0);
            } else {
                mask_out.* = 0;
            }
            return l;
        }
        return expr_local_origin_mask(e.a, mask_out);
    }
    if k == ast.E_OPT_SOME {
        return expr_local_origin_mask(e.a, mask_out);
    }
    if k == ast.E_STRUCT_LIT {
        let mut mask: u64 = 0;
        let mut first = u.nil.[ast.Local]();
        let mut d = u.nil.[ast.Decl]();
        if e.ty.kind == ast.TY_STRUCT {
            d = e.ty.decl;
        }
        for i in 0..ast.more_ro(e).inits.len {
            let fi = ast.more_ro(e).inits.at_mut(i);
            let fo = expr_local_origin(fi.value);
            if u.isnil(fo) {
                continue;
            }
            if u.isnil(first) {
                first = fo;
            }
            let mut idx: i32 = @int_cast(i32, i);
            if u.notnil(d) {
                idx = sb.find_field(d, fi.name);
            }
            if (idx >= 0) and (idx < 64) {
                mask = mask | (@as(u64, 1) << @int_cast(u32, idx));
            } else {
                mask = ~@as(u64, 0);
            }
        }
        mask_out.* = mask;
        return first;
    }
    if k == ast.E_IDENT {
        let l = ast.local_of(e);
        if u.notnil(l) {
            mask_out.* = l.origin_fields;
            return l.origin_local;
        }
        mask_out.* = 0;
        return u.nil.[ast.Local]();
    }
    if (k == ast.E_CATCH) or (k == ast.E_ORELSE) {
        let mut m1: u64 = 0;
        let mut m2: u64 = 0;
        let l1 = expr_local_origin_mask(e.a, &mut m1);
        let mut l2 = u.nil.[ast.Local]();
        match ast.more_ro(e).handler {
            .Value(h) => { l2 = expr_local_origin_mask(h, &mut m2); }
            else => {}
        }
        mask_out.* = m1 | m2;
        if u.notnil(l1) {
            return l1;
        }
        return l2;
    }
    let l = expr_local_origin(e);
    if u.notnil(l) {
        mask_out.* = ~@as(u64, 0);
    } else {
        mask_out.* = 0;
    }
    return l;
}

fn expr_local_origin(e: *mut ast.Expr) *mut ast.Local {
    if u.isnil(e) or u.isnil(e.ty) or (e.ty.kind == ast.TY_INVALID) or not type_can_hold_ptr(e.ty) {
        return u.nil.[ast.Local]();
    }
    let k = e.kind;
    if k == ast.E_CONV {
        if (e.ty.kind == ast.TY_SLICE) and u.notnil(e.a) and u.notnil(e.a.ty) and (e.a.ty.kind == ast.TY_ARRAY) {
            return place_origin(e.a);
        }
        return expr_local_origin(e.a);
    }
    if k == ast.E_OPT_SOME {
        return expr_local_origin(e.a);
    }
    if k == ast.E_UNARY {
        if (ast.op_of(e) == lx.TK_AMP) and is_place(e.a) {
            return place_origin(e.a);
        }
        return u.nil.[ast.Local]();
    }
    if k == ast.E_SLICE {
        if ast.index_kind_of(e) == ast.IDX_ARRAY {
            return place_origin(e.a);
        }
        return expr_local_origin(e.a);
    }
    if k == ast.E_IDENT {
        let l = ast.local_of(e);
        if u.notnil(l) {
            return l.origin_local;
        }
        return u.nil.[ast.Local]();
    }
    if k == ast.E_FIELD {
        let fk = ast.field_kind_of(e);
        if (fk == ast.FK_STRUCT) and (ast.self_mode_of(e) != ast.SELF_DEREF) {
            let mut m: u64 = 0;
            let l = expr_local_origin_mask(e.a, &mut m);
            if u.isnil(l) {
                return u.nil.[ast.Local]();
            }
            let idx = ast.index_of(e);
            if (idx >= 0) and (idx < 64) and ((m & (@as(u64, 1) << @int_cast(u32, idx))) == 0) {
                return u.nil.[ast.Local]();
            }
            return l;
        }
        if fk == ast.FK_SLICE_PTR {
            return expr_local_origin(e.a);
        }
        return u.nil.[ast.Local]();
    }
    if k == ast.E_INDEX {
        if ast.index_kind_of(e) == ast.IDX_ARRAY {
            return expr_local_origin(e.a);
        }
        return u.nil.[ast.Local]();
    }
    if k == ast.E_STRUCT_LIT {
        for i in 0..ast.more_ro(e).inits.len {
            let o = expr_local_origin(ast.more_ro(e).inits.at_mut(i).value);
            if u.notnil(o) {
                return o;
            }
        }
        return u.nil.[ast.Local]();
    }
    if k == ast.E_ARRAY_LIT {
        for i in 0..ast.args_of(e).len {
            let o = expr_local_origin(ast.args_of(e).get(i));
            if u.notnil(o) {
                return o;
            }
        }
        return u.nil.[ast.Local]();
    }
    if k == ast.E_ARRAY_REPEAT {
        return expr_local_origin(e.a);
    }
    if k == ast.E_CALL {
        if (ast.call_kind_of(e) == ast.CALLK_VARIANT) and (ast.args_of(e).len > 0) {
            return expr_local_origin(ast.args_of(e).get(0));
        }
        return u.nil.[ast.Local]();
    }
    if k == ast.E_TRY {
        return expr_local_origin(e.a);
    }
    if (k == ast.E_CATCH) or (k == ast.E_ORELSE) {
        let o = expr_local_origin(e.a);
        if u.notnil(o) {
            return o;
        }
        match ast.more_ro(e).handler {
            .Value(h) => { return expr_local_origin(h); }
            else => {}
        }
        return u.nil.[ast.Local]();
    }
    return u.nil.[ast.Local]();
}

// A returned address of a local (`&x`, `&mut x.f`, `&a[i]`), slice of a
// local array (`a[..]`, `a[i..j]`), or a value derived from one, dangles once
// the function returns (spec §12.2: E0710).
fn check_escape(e0: *mut ast.Expr) void {
    let l = expr_local_origin(e0);
    if u.notnil(l) {
        _ = dg.err(e0.span, "E0710", u.f1("this points into local '%s', whose storage ends when the function returns",
                                          l.name));
    }
}

fn check_catch(e: *mut ast.Expr) *mut ast.Type {
    let t = check_expr(e.a, tnil());
    check_no_copy(e.a);
    let mut vt = ty.t_invalid;
    let mut et = ty.t_error;
    if t.kind == ast.TY_ERRUNION {
        vt = t.elem;
        if u.notnil(t.err_param) {
            et = t.err_param;
        } else {
            et = ty.type_errset(t.decl);
        }
    } else if t.kind != ast.TY_INVALID {
        _ = dg.err(e.a.span, "E0611", u.f1("'catch' requires an error union (!T), found %s", tstr(t)));
    }
    let nloc = C.locals.len;
    let pre_snap = save_moves(nloc);
    let pre_dead = C.flow_dead;
    let mut h_dead = false;
    scope_push();
    if not u.isnos(ast.more(e).capture) {
        ast.ext(e).capture_local = declare_local(ast.ext(e).capture, ast.ext(e).capture_span, et, false, false);
    }
    match ast.more(e).handler {
        .Value(h) => {
            let mut x = h;
            if vt.kind == ast.TY_VOID {
                // For !void only a diverging handler (e.g. @trap()) makes sense.
                let ht = check_expr(x, tnil());
                if (ht.kind != ast.TY_NEVER) and (ht.kind != ast.TY_INVALID) {
                    _ = dg.err(x.span, "E0613", "a fallback value makes no sense for !void; use a block");
                }
                h_dead = C.flow_dead or (ht.kind == ast.TY_NEVER);
            } else {
                _ = check_expr_to(&mut x, vt);
                check_no_copy(x);
                h_dead = C.flow_dead or (u.notnil(x.ty) and (x.ty.kind == ast.TY_NEVER));
            }
            ast.ext(e).handler = ast.Handler.Value(x);
        }
        .Return(h) => {
            let mut x = h;
            if u.notnil(x) {
                check_return_value(&mut x, e.span);
            } else {
                check_return_value(u.nil.[*mut ast.Expr](), e.span);
            }
            ast.ext(e).handler = ast.Handler.Return(x);
            h_dead = true;
        }
        .Break => {
            check_catch_jump(e, true);
            h_dead = true;
        }
        .Continue => {
            check_catch_jump(e, false);
            h_dead = true;
        }
        .Block(blk) => {
            // For !void the block may complete normally: execution continues after
            // the expression. For !T there is no value to produce, so it must diverge.
            let bdiv = check_block(blk);
            if not bdiv and (vt.kind != ast.TY_VOID) and (vt.kind != ast.TY_INVALID) {
                _ = dg.err(blk.span, "E0612",
                           u.f1("this 'catch' block must not complete normally, because the expression needs a value of type %s (end it with return, break, continue or @trap(), or use 'catch <value>')",
                                tstr(vt)));
            }
            h_dead = bdiv or pre_dead;
        }
    }
    scope_pop();
    if h_dead {
        restore_moves(pre_snap);
        C.flow_dead = pre_dead;
    } else {
        let h_snap = save_moves(nloc);
        merge_moves_or(pre_snap, h_snap);
        C.flow_dead = pre_dead;
    }
    let mut hw = e.a.weakened;
    match ast.more(e).handler {
        .Value(h) => {
            if h.weakened {
                hw = true;
            }
        }
        else => {}
    }
    e.weakened = hw;
    e.ty = vt;
    return e.ty;
}

fn opt_target(expected: *mut ast.Type) *mut ast.Type {
    let mut e = expected;
    if u.notnil(e) and (e.kind == ast.TY_ERRUNION) {
        e = e.elem;
    }
    if u.notnil(e) and (e.kind == ast.TY_OPT) {
        return e;
    }
    return tnil();
}

fn check_opt_none(e: *mut ast.Expr, expected: *mut ast.Type) *mut ast.Type {
    let t = opt_target(expected);
    if u.notnil(t) {
        return set_ty(e, t);
    }
    _ = dg.err(e.span, "E0502", "cannot infer the type of '.none'; add a type annotation");
    return set_ty(e, ty.t_invalid);
}

fn check_opt_some(e: *mut ast.Expr, expected: *mut ast.Type) *mut ast.Type {
    let t = opt_target(expected);
    if u.notnil(t) {
        _ = check_expr_to(&mut e.a, t.elem);
        move_or_check_nocopy(e.a);
        e.weakened = e.a.weakened;
        if t.elem.kind == ast.TY_INVALID {
            return set_ty(e, ty.t_invalid);
        }
        return set_ty(e, t);
    }
    let mut it = check_expr(e.a, tnil());
    if ty.is_untyped(it) {
        it = sb.finalize_untyped(&mut e.a);
    }
    move_or_check_nocopy(e.a);
    e.weakened = e.a.weakened;
    if it.kind == ast.TY_INVALID {
        return set_ty(e, ty.t_invalid);
    }
    if it.kind == ast.TY_NEVER {
        return set_ty(e, ty.t_never);
    }
    if it.kind == ast.TY_VOID {
        _ = dg.err(e.a.span, "E0404", "optional element type cannot be void");
        return set_ty(e, ty.t_invalid);
    }
    return set_ty(e, ty.type_opt(it));
}

fn check_empty_slice(e: *mut ast.Expr, expected: *mut ast.Type) *mut ast.Type {
    let mut t = expected;
    while u.notnil(t) and ((t.kind == ast.TY_ERRUNION) or (t.kind == ast.TY_OPT)) {
        t = t.elem;
    }
    if u.notnil(t) and (t.kind == ast.TY_SLICE) {
        return set_ty(e, t);
    }
    _ = dg.err(e.span, "E0502", "cannot infer the element type of empty slice '[]'; add a type annotation");
    return set_ty(e, ty.t_invalid);
}

fn check_orelse(e: *mut ast.Expr) *mut ast.Type {
    let mut t = check_expr(e.a, tnil());
    if ty.is_untyped(t) {
        t = sb.finalize_untyped(&mut e.a);
    }
    check_no_copy(e.a);
    let mut vt = ty.t_invalid;
    if t.kind == ast.TY_OPT {
        vt = t.elem;
    } else if t.kind != ast.TY_INVALID {
        _ = dg.err(e.a.span, "E0614", u.f1("'??' requires an optional (?T), found %s", tstr(t)));
    }
    let nloc = C.locals.len;
    let pre_snap = save_moves(nloc);
    let pre_dead = C.flow_dead;
    let mut h_dead = false;
    match ast.more(e).handler {
        .Value(h) => {
            let mut x = h;
            _ = check_expr_to(&mut x, vt);
            check_no_copy(x);
            ast.ext(e).handler = ast.Handler.Value(x);
            h_dead = C.flow_dead or (u.notnil(x.ty) and (x.ty.kind == ast.TY_NEVER));
        }
        .Return(h) => {
            let mut x = h;
            if u.notnil(x) {
                check_return_value(&mut x, e.span);
            } else {
                check_return_value(u.nil.[*mut ast.Expr](), e.span);
            }
            ast.ext(e).handler = ast.Handler.Return(x);
            h_dead = true;
        }
        .Break => {
            check_catch_jump(e, true);
            h_dead = true;
        }
        .Continue => {
            check_catch_jump(e, false);
            h_dead = true;
        }
        .Block(blk) => {
            let bdiv = check_block(blk);
            if not bdiv and (vt.kind != ast.TY_INVALID) {
                _ = dg.err(blk.span, "E0612",
                           u.f1("this '??' block must not complete normally, because the expression needs a value of type %s (end it with return, break, continue or @trap(), or use '?? <value>')",
                                tstr(vt)));
            }
            h_dead = bdiv or pre_dead;
        }
    }
    if h_dead {
        restore_moves(pre_snap);
        C.flow_dead = pre_dead;
    } else {
        let h_snap = save_moves(nloc);
        merge_moves_or(pre_snap, h_snap);
        C.flow_dead = pre_dead;
    }
    e.weakened = e.a.weakened;
    match ast.more(e).handler {
        .Value(h) => {
            if h.weakened {
                e.weakened = true;
            }
        }
        else => {}
    }
    e.ty = vt;
    return e.ty;
}

// catch break / catch continue (the label, if any, is in e.name)
fn check_catch_jump(e: *mut ast.Expr, is_break: bool) void {
    let mut sp = e.span;
    if e.name.len > 0 {
        sp = ast.name_span_of(e);
    }
    ast.set_index(e, @max(check_jump_target(e.name, sp, is_break), 0));
}

fn check_try(e: *mut ast.Expr) *mut ast.Type {
    let t = check_expr(e.a, tnil());
    if t.kind == ast.TY_INVALID {
        return set_ty(e, ty.t_invalid);
    }
    check_no_copy(e.a);
    if t.kind != ast.TY_ERRUNION {
        _ = dg.err(e.span, "E0611", u.f1("'!' requires an error union (!T), found %s", tstr(t)));
        return set_ty(e, ty.t_invalid);
    }
    if u.isnil(C.fnd) or u.isnil(C.ret) or (C.ret.kind != ast.TY_ERRUNION) {
        let d = dg.err(e.span, "E0610", "'!' can only be used in a function that returns an error union");
        if u.notnil(C.fnd) and u.notnil(C.fnd.ret_te) {
            let fx = dg.fix(d, "make the function return an error union", "suggestion");
            dg.edit(fx, sp_at(C.fnd.ret_te.span), "!");
        }
    } else {
        _ = check_leave_ok(e.span, false);
        try_fits(e.span, t.decl, t.err_param, C.ret.decl, C.ret.err_param);
        if not C.ret_err_open {
            if u.notnil(t.err_param) {
                C.ret_err_open = true;
            } else if u.notnil(t.decl) {
                record_ret_set(t.decl);
            } else if not is_self_infer_call(e.a) {
                C.ret_err_open = true;
            }
        }
    }
    e.weakened = e.a.weakened;
    e.ty = t.elem;
    return e.ty;
}

// '!' on an error union of (a_decl, a_ep) in a function returning (b_decl, b_ep).
fn try_fits(sp: u.Span, a_decl: *mut ast.Decl, a_ep: *mut ast.Type, b_decl: *mut ast.Decl, b_ep: *mut ast.Type) void {
    if u.isnil(b_decl) and u.isnil(b_ep) {
        return;
    }
    if u.notnil(a_ep) and (a_ep == b_ep) {
        return;
    }
    if u.isnil(a_ep) and u.isnil(b_ep) and (a_decl == b_decl) {
        return;
    }
    if u.notnil(a_decl) {
        resolve_decl(a_decl);
    }
    if u.notnil(b_decl) {
        resolve_decl(b_decl);
    }
    if u.isnil(a_ep) and u.notnil(a_decl) and (a_decl.set_names.len == 0) {
        return;
    }
    if u.notnil(a_ep) {
        _ = dg.err(sp, "E0653", u.f2("this '!' can pass on errors of %s, which %s may not hold", a_ep.name,
                                     errset_label(b_decl, b_ep)));
        return;
    }
    if u.isnil(a_decl) {
        _ = dg.err(sp, "E0653", u.f1("this '!' can pass on any error, but this function returns only those of %s",
                                     errset_label(b_decl, b_ep)));
        return;
    }
    if u.notnil(b_ep) {
        _ = dg.err(sp, "E0653", u.f2("this '!' can pass on error.%s, which %s may not hold", a_decl.set_names.get(0),
                                     b_ep.name));
        return;
    }
    let m = set_missing(a_decl, b_decl);
    if not u.isnos(m) {
        _ = dg.err(sp, "E0653", u.f2("this '!' can pass on error.%s, which %s does not hold", m, b_decl.name));
    }
}

// ---------------------------------------------------------------------------
// Index / slice
// ---------------------------------------------------------------------------
fn check_index(e: *mut ast.Expr) *mut ast.Type {
    let t = check_expr(e.a, tnil());
    let mut elem = tnil();
    if t.kind == ast.TY_ARRAY {
        elem = t.elem;
        ast.set_index_kind(e, ast.IDX_ARRAY);
    } else if t.kind == ast.TY_SLICE {
        elem = t.elem;
        ast.set_index_kind(e, ast.IDX_SLICE);
    } else if (t.kind == ast.TY_PTR) and (t.elem.kind == ast.TY_ARRAY) {
        elem = t.elem.elem;
        ast.set_index_kind(e, ast.IDX_PTR_ARRAY);
    } else if t.kind != ast.TY_INVALID {
        _ = dg.err(e.a.span, "E0407", u.f1("cannot index a value of type %s", tstr(t)));
    }
    if e.kind == ast.E_INDEX {
        let it = check_expr(ast.b_of(e), ty.t_usize);
        if it.kind == ast.TY_UNTYPED_INT {
            coerce(ast.b_mut(e), ty.t_usize);
        } else if (it != ty.t_usize) and (it.kind != ast.TY_INVALID) {
            let d = dg.err(ast.b_of(e).span, "E0540", u.f1("index must have type usize, found %s", tstr(it)));
            if it.kind == ast.TY_INT {
                let txt = u.span_text(ast.b_of(e).span);
                let fx = dg.fix(d, "convert the index", "suggestion");
                dg.edit(fx, ast.b_of(e).span, u.f1("@int_cast(usize, %s)", txt));
            }
        }
        if ast.b_of(e).is_const and (t.kind == ast.TY_ARRAY) and u.isnil(t.len_param) and
           (ast.cval_of(ast.b_of(e)).is_neg() or ast.cval_of(ast.b_of(e)).ge(u.I128.of(t.len))) {
            _ = dg.err(ast.b_of(e).span, "E0541", u.f2("index %s is out of bounds for %s",
                                                       ast.cval_of(ast.b_of(e)).str(), tstr(t)));
        }
        if u.notnil(elem) {
            e.ty = elem;
            e.weakened = e.a.weakened;
        } else {
            e.ty = ty.t_invalid;
        }
        return e.ty;
    }
    // slice
    for k in @as(i32, 0)..2 {
        let mut pb = ast.b_mut(e);
        if k == 1 {
            pb = ast.c_mut(e);
        }
        if u.isnil(pb.*) {
            continue;
        }
        let it = check_expr(pb.*, ty.t_usize);
        if it.kind == ast.TY_UNTYPED_INT {
            coerce(pb, ty.t_usize);
        } else if (it != ty.t_usize) and (it.kind != ast.TY_INVALID) {
            _ = dg.err(pb.*.span, "E0540", u.f1("slice bound must have type usize, found %s", tstr(it)));
        }
    }
    if u.isnil(elem) {
        return set_ty(e, ty.t_invalid);
    }
    let mut m = false;
    if ast.index_kind_of(e) == ast.IDX_ARRAY {
        if not is_place(e.a) {
            _ = dg.err(e.a.span, "E0704", "cannot slice a temporary array; bind it to a variable first");
            return set_ty(e, ty.t_invalid);
        }
        mark_addr_taken(e.a);
        m = is_mut_place(e.a);
    } else {
        m = t.is_mut;
    }
    e.ty = ty.type_slice(elem, m);
    e.weakened = e.a.weakened;
    return e.ty;
}

// ---------------------------------------------------------------------------
// Main dispatch
// ---------------------------------------------------------------------------
fn check_operand(e: *mut ast.Expr, expected: *mut ast.Type) *mut ast.Type {
    e.cat = ast.CAT_VALUE;
    match e.kind {
        .IDENT => {
            resolve_ident(e);
            return e.ty;
        }
        .SELF => {
            if u.isnil(C.tc.self_) {
                _ = dg.err(e.span, "E0205", "'Self' is only available inside a struct or union");
                return set_ty(e, ty.t_invalid);
            }
            e.cat = ast.CAT_TYPE;
            ast.set_tval(e, C.tc.self_);
            return tnil();
        }
        .INT => {
            e.is_const = true;
            ast.set_cval(e, u.I128.ofu(ast.ival_of(e)));
            return set_ty(e, ty.t_untyped_int);
        }
        .FLOAT => {
            e.is_const = true;
            return set_ty(e, ty.t_untyped_float);
        }
        .STRING       => { return set_ty(e, ty.type_slice(ty.t_u8, false)); }
        .BOOL         => { return set_ty(e, ty.t_bool); }
        .STRUCT_LIT   => { return check_struct_lit(e, expected); }
        .ARRAY_LIT    => { return check_array_lit(e, expected); }
        .ARRAY_REPEAT => { return check_array_lit(e, expected); }
        .ERROR_VAL => {
            let code = error_code_here(e.name);
            if code == 0 {
                _ = dg.err(ast.name_span_of(e), "E0650",
                           u.f1("'error.%s' is not declared; add it to an 'error { ... }' block", e.name));
            }
            ast.set_cval(e, u.I128.ofu(@as(u64, code)));
            let set = expected_set(expected);
            if (code != 0) and not set_has(set, e.name) {
                _ = dg.err(ast.name_span_of(e), "E0652", u.f2("'error.%s' is not in error set %s", e.name, set.name));
            }
            return set_ty(e, ty.type_errset(set));
        }
        .BUILTIN     => { return sb.builtin_check(e, expected); }
        .UNARY       => { return check_unary(e, expected); }
        .BINARY      => { return check_binary(e, expected); }
        .CATCH       => { return check_catch(e); }
        .OPT_NONE    => { return check_opt_none(e, expected); }
        .OPT_SOME    => { return check_opt_some(e, expected); }
        .ORELSE      => { return check_orelse(e); }
        .EMPTY_SLICE => { return check_empty_slice(e, expected); }
        .FIELD => {
            _ = check_field(e);
            return e.ty;
        }
        .DEREF => { return check_deref(e); }
        .CALL  => { return check_call(e, expected); }
        .INDEX => { return check_index(e); }
        .SLICE => { return check_index(e); }
        .TRY   => { return check_try(e); }
        .APPLY => {
            check_apply(e);
            return e.ty;
        }
        .CONV => { return e.ty; }
    }
}

fn check_deref(e: *mut ast.Expr) *mut ast.Type {
    let t = check_expr(e.a, tnil());
    if t.kind == ast.TY_PTR {
        if t.elem.kind == ast.TY_VOID {
            _ = dg.err(e.span, "E0705", "cannot dereference *void; convert it with @ptr_cast first");
            return set_ty(e, ty.t_invalid);
        }
        let mut res = t.elem;
        if not t.is_mut {
            let wt = weaken_mut(res);
            if wt != res {
                res = wt;
                e.weakened = true;
            }
        }
        return set_ty(e, res);
    }
    if t.kind != ast.TY_INVALID {
        _ = dg.err(e.span, "E0705", u.f1("cannot dereference a value of type %s", tstr(t)));
    }
    return set_ty(e, ty.t_invalid);
}

// ---------------------------------------------------------------------------
// Scopes and locals
// ---------------------------------------------------------------------------
fn scope_push() void {
    C.marks.push(C.scope.len);
}

fn scope_pop() void {
    C.scope.len = C.marks.pop();
}

fn scope_lookup(name: []u8) *mut ast.Local {
    let mut i = C.scope.len;
    while i > 0 {
        i -= 1;
        if u.same(C.scope.at(i).name, name) {
            return C.scope.at_mut(i).local;
        }
    }
    return u.nil.[ast.Local]();
}

fn declare_local(name: []u8, sp: u.Span, t: *mut ast.Type, is_mut: bool, is_param: bool) *mut ast.Local {
    let prev = scope_lookup(name);
    let mut prev_span = sp;
    if u.notnil(prev) {
        prev_span = prev.span;
    }
    let mut clash = u.notnil(prev);
    let mut what: []u8 = "a variable";
    if not clash and u.notnil(lookup_gparam(&mut C.tc, name)) {
        clash = true;
        what = "a generic parameter";
    }
    if not clash {
        let d = module_lookup(C.tc.mod, name);
        if u.notnil(d) {
            clash = true;
            prev_span = d.name_span;
            what = "a top-level declaration";
        }
    }
    if not clash {
        let d = C.tc.mod.imports.get(name);
        if u.notnil(d) {
            clash = true;
            prev_span = d.name_span;
            what = "an import";
        }
    }
    if clash {
        let g = dg.err(sp, "E0204", u.f2("'%s' shadows %s; choose a different name", name, what));
        dg.note(g, prev_span, u.f1("'%s' is declared here", name));
    }
    let l = u.new.[ast.Local]();
    l.name = name;
    l.span = sp;
    l.ty = t;
    l.is_mut = is_mut;
    l.is_param = is_param;
    l.origin_local = u.nil.[ast.Local]();
    l.origin_fields = 0;
    if u.notnil(C.fnd) {
        l.index = @int_cast(i32, C.fnd.locals.len);
        C.fnd.locals.push(l);
    }
    C.locals.push(l);
    C.scope.push(ScopeEntry.{ name: name, local: l });
    return l;
}

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------
fn check_block(b: *mut ast.Stmt) bool {
    let entry_dead = C.flow_dead;
    scope_push();
    let mut div = false;
    let mut warned = false;
    for i in 0..b.stmts.len {
        let s = b.stmts.get(i);
        if div and not warned {
            _ = dg.warning(s.span, "W0601", "unreachable statement");
            warned = true;
        }
        if check_stmt(s) {
            div = true;
            C.flow_dead = true;
        }
    }
    scope_pop();
    C.flow_dead = entry_dead or div;
    b.diverges = div;
    return div;
}

fn is_leaving_catch(e: *mut ast.Expr) bool {
    if u.isnil(e) or ((e.kind != ast.E_CATCH) and (e.kind != ast.E_ORELSE)) {
        return false;
    }
    match ast.more(e).handler {
        .Return   => { return true; }
        .Break    => { return true; }
        .Continue => { return true; }
        else      => { return false; }
    }
}

fn conv_probe(t: *mut ast.Type, sp: u.Span) *mut ast.Expr {
    let p = ast.new_expr(ast.E_CONV, sp);
    p.ty = t;
    p.cat = ast.CAT_VALUE;
    return p;
}

fn check_assign(s: *mut ast.Stmt) void {
    let lhs = s.e;
    let direct_ident = (s.op == lx.TK_EQ) and (lhs.kind == ast.E_IDENT);
    let prev_skip = C.skip_moved_check;
    if direct_ident {
        C.skip_moved_check = true;
    }
    let lt = check_expr(lhs, tnil());
    C.skip_moved_check = prev_skip;
    if lt.kind == ast.TY_INVALID {
        _ = check_expr(s.e2, tnil());
        return;
    }
    if not is_place(lhs) {
        _ = dg.err(lhs.span, "E0706",
                   "the left-hand side of an assignment must be a variable, field, element or dereference");
        _ = check_expr(s.e2, tnil());
        return;
    }
    if not is_mut_place(lhs) {
        let d = dg.err(lhs.span, "E0701", "cannot assign: this place is not mutable");
        let mut r = lhs;
        while ((r.kind == ast.E_FIELD) and (ast.self_mode_of(r) != ast.SELF_DEREF)) or
              ((r.kind == ast.E_INDEX) and (ast.index_kind_of(r) == ast.IDX_ARRAY)) {
            r = r.a;
        }
        if (r.kind == ast.E_IDENT) and u.notnil(ast.local_of(r)) {
            if ast.local_of(r).is_param {
                dg.note(d, ast.local_of(r).span, u.f1("parameters are immutable; copy '%s' into a 'let mut' first",
                                                      ast.local_of(r).name));
            } else {
                dg.note(d, ast.local_of(r).span, u.f1("'%s' is declared without 'mut'", ast.local_of(r).name));
                let fx = dg.fix(d, "declare the variable as mutable", "machine");
                dg.edit(fx, sp_at(ast.local_of(r).span), "mut ");
            }
        }
    }
    if s.op == lx.TK_EQ {
        _ = check_expr_to(&mut s.e2, lt);
        check_no_copy(s.e2);
        if direct_ident and (lhs.kind == ast.E_IDENT) and u.notnil(ast.local_of(lhs)) and not C.flow_dead {
            ast.local_of(lhs).moved = false;
        }
        if (lhs.kind == ast.E_IDENT) and u.notnil(ast.local_of(lhs)) {
            let lhs_l = ast.local_of(lhs);
            lhs_l.origin_local = expr_local_origin_mask(s.e2, &mut lhs_l.origin_fields);
        } else if (lhs.kind == ast.E_FIELD) and (ast.field_kind_of(lhs) == ast.FK_STRUCT) and
                  (ast.self_mode_of(lhs) != ast.SELF_DEREF) and (lhs.a.kind == ast.E_IDENT) and
                  u.notnil(ast.local_of(lhs.a)) {
            let src = expr_local_origin(s.e2);
            let l = ast.local_of(lhs.a);
            let idx = ast.index_of(lhs);
            if (idx >= 0) and (idx < 64) {
                let bit = @as(u64, 1) << @int_cast(u32, idx);
                if u.notnil(src) {
                    l.origin_fields = l.origin_fields | bit;
                    if u.isnil(l.origin_local) {
                        l.origin_local = src;
                    }
                } else {
                    l.origin_fields = l.origin_fields & ~bit;
                    if l.origin_fields == 0 {
                        l.origin_local = u.nil.[ast.Local]();
                    }
                }
            } else if u.notnil(src) {
                l.origin_fields = ~@as(u64, 0);
                if u.isnil(l.origin_local) {
                    l.origin_local = src;
                }
            }
        } else {
            let src = expr_local_origin(s.e2);
            let dst_local = place_local(lhs);
            if u.notnil(dst_local) {
                if u.notnil(src) {
                    dst_local.origin_local = src;
                    dst_local.origin_fields = ~@as(u64, 0);
                }
            } else {
                let po = place_origin(lhs);
                if u.notnil(po) {
                    if u.notnil(src) {
                        po.origin_local = src;
                        po.origin_fields = ~@as(u64, 0);
                    }
                } else if u.notnil(src) {
                    _ = dg.err(s.e2.span, "E0710",
                               u.f1("this points into local '%s', which cannot be stored in a global or caller-reachable place",
                                    src.name));
                }
            }
        }
        return;
    }
    // compound assignment: lhs op= rhs, with the semantics of lhs op rhs
    let so = s.op;
    let mut op = lx.TK_SHR;
    match so {
        .PLUS_EQ      => { op = lx.TK_PLUS; }
        .MINUS_EQ     => { op = lx.TK_MINUS; }
        .STAR_EQ      => { op = lx.TK_STAR; }
        .SLASH_EQ     => { op = lx.TK_SLASH; }
        .PERCENT_EQ   => { op = lx.TK_PERCENT; }
        .PLUS_PCT_EQ  => { op = lx.TK_PLUS_PCT; }
        .MINUS_PCT_EQ => { op = lx.TK_MINUS_PCT; }
        .STAR_PCT_EQ  => { op = lx.TK_STAR_PCT; }
        .AMP_EQ       => { op = lx.TK_AMP; }
        .PIPE_EQ      => { op = lx.TK_PIPE; }
        .CARET_EQ     => { op = lx.TK_CARET; }
        .SHL_EQ       => { op = lx.TK_SHL; }
        else => {}
    }
    let e3 = ast.new_expr(ast.E_BINARY, s.span);  // synthetic binary expr describing the operation (for codegen)
    ast.stmt_ext(s).e3 = e3;
    ast.set_op(e3, op);
    e3.a = lhs;
    ast.set_b(e3, s.e2);
    e3.ty = lt;
    e3.cat = ast.CAT_VALUE;
    if (op == lx.TK_SHL) or (op == lx.TK_SHR) {
        let r = check_expr(s.e2, tnil());
        if r.kind == ast.TY_UNTYPED_INT {
            coerce(&mut s.e2, ty.t_u32);
        } else if (ty.is_vec_int(r) and not r.elem.is_signed) or
                  (is_vec_param(r) and lane_is_unsigned_int(r.constraint_lane)) {
            // per lane (spec §13.1)
            let shape_ok = (ty.is_vec_int(lt) and ty.is_vec_int(r) and (lt.lanes == r.lanes) and
                            (lt.elem.bits == r.elem.bits)) or (is_vec_param(lt) and (lt == r));
            if (lt.kind != ast.TY_INVALID) and not shape_ok {
                _ = dg.err(s.e2.span, "E0412",
                           u.f2("per-lane shift counts must have the shape of the shifted vector: %s and %s", tstr(lt),
                                tstr(r)));
            }
        } else if not ((r.kind == ast.TY_INT) and not r.is_signed) and (r.kind != ast.TY_INVALID) and
                  not ((r.kind == ast.TY_PARAM) and ty.satisfies(r, ast.C_UNSIGNED)) {
            _ = dg.err(s.e2.span, "E0525", u.f1("shift count must be an unsigned integer, found %s", tstr(r)));
        }
        if (lt.kind != ast.TY_INT) and not ty.is_vec_int(lt) and
           not ((lt.kind == ast.TY_PARAM) and ty.satisfies(lt, ast.C_INT)) and not is_int_vec_param(lt) {
            if lt.kind == ast.TY_PARAM {
                _ = dg.err(s.span, "E0461", u.f3("operator '%s' is not permitted on '%s' (constraint %s)",
                                                 lx.tok_kind_name(op), lt.name,
                                                 constraint_str(lt.constraint, lt.constraint_lane)));
            } else {
                _ = dg.err(s.span, "E0513", u.f1("shift requires an integer operand, found %s", tstr(lt)));
            }
        }
        ast.set_b(ast.stmt_ext(s).e3, s.e2);
        return;
    }
    _ = check_expr_to(&mut s.e2, lt);
    ast.set_b(ast.stmt_ext(s).e3, s.e2);
    // reuse the binary-operator validation by type-checking a probe
    let probe = ast.copy_expr(ast.stmt_more(s).e3);
    probe.a = conv_probe(lt, lhs.span);
    ast.set_b(probe, conv_probe(lt, s.e2.span));
    probe.ty = tnil();
    _ = check_expr(probe, tnil());
}

// The arms of a match on a union or enum (t): its variants or members, each at
// most once, all of them unless there is an else. Whether every arm diverges.
fn check_variant_match(s: *mut ast.Stmt, t: *mut ast.Type, by_ref: bool, ref_mut: bool) bool {
    let mut all_div = true;
    let mut has_else = false;
    let narms = ast.stmt_more(s).arms.len;
    let ud = t.decl;
    let is_enum = t.kind == ast.TY_ENUM;
    let what = u.pick(is_enum, "member", "variant");
    let seen = u.newn.[bool](ud.variants.len);
    let mut mf = match_flow_begin();
    for i in 0..narms {
        let a = ast.stmt_ext(s).arms.at_mut(i);
        if has_else and not a.alt {
            _ = dg.warning(a.span, "W0631", "unreachable match arm after 'else'");
        }
        scope_push();
        if not a.alt {
            match_flow_arm_begin(&mf);
        }
        match a.pat {
            .Else => { has_else = true; }
            .Variant(p) => {
                let v = find_variant(ud, p.name);
                if v < 0 {
                    _ = dg.err(a.span, "E0632", u.f3("%s has no %s '%s'", tstr(t), what, p.name));
                } else {
                    let vi = @int_cast(usize, v);
                    a.variant = v;
                    a.value = ud.variants.at(vi).value;
                    if seen[vi] {
                        _ = dg.err(a.span, "E0631", u.f2("%s '%s' is matched more than once", what, p.name));
                    }
                    seen[vi] = true;
                    let mut pt = tnil();
                    if not is_enum {
                        pt = ty.type_variant(t, vi);
                    }
                    if not u.isnos(p.bind) {
                        if u.isnil(pt) {
                            _ = dg.err(p.bind_span, "E0633",
                                       u.f2("%s '%s' has no payload to bind", u.pick(is_enum, "enum member", "variant"),
                                            p.name));
                        } else if not u.str_eq(p.bind, "_") {
                            if a.alt or (((i + 1) < narms) and ast.stmt_more(s).arms.at(i + 1).alt) {
                                _ = dg.err(p.bind_span, "E0635",
                                           "a match arm with several patterns cannot bind a payload");
                            } else {
                                let mut bt = pt;
                                if by_ref {
                                    bt = ty.type_ptr(pt, ref_mut);
                                }
                                a.bind_local = declare_local(p.bind, p.bind_span, bt, false, false);
                                a.bind_local.weakened = s.e.weakened;
                                if type_can_hold_ptr(bt) {
                                    a.bind_local.origin_local = expr_local_origin(s.e);
                                    if u.notnil(a.bind_local.origin_local) {
                                        a.bind_local.origin_fields = ~@as(u64, 0);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            else => {
                _ = dg.err(a.span, "E0634",
                           u.f2("this pattern cannot match a value of %s type %s", u.pick(is_enum, "enum", "union"),
                                tstr(t)));
            }
        }
        if not a.alt {
            let div_arm = check_block(a.body);
            if not div_arm {
                all_div = false;
            }
            match_flow_arm_end(&mut mf, div_arm);
        }
        scope_pop();
    }
    match_flow_end(&mf, narms);
    if not has_else {
        let mut missing = u.Buf.init();
        let mut nm: i32 = 0;
        for v in 0..ud.variants.len {
            if seen[v] {
                continue;
            }
            if nm != 0 {
                missing.s(", ");
            }
            nm += 1;
            missing.c('.');
            missing.s(ud.variants.at(v).name);
        }
        let ms = missing.done();
        if nm != 0 {
            _ = dg.err(s.span, "E0630", u.f1("non-exhaustive match: missing %s", ms));
        }
    }
    return all_div;
}

fn check_opt_match(s: *mut ast.Stmt, base: *mut ast.Type, by_ref: bool, ref_mut: bool) bool {
    let mut all_div = true;
    let mut has_else = false;
    let mut seen_none = false;
    let mut seen_some = false;
    let narms = ast.stmt_more(s).arms.len;
    let mut mf = match_flow_begin();
    for i in 0..narms {
        let a = ast.stmt_ext(s).arms.at_mut(i);
        if has_else and not a.alt {
            _ = dg.warning(a.span, "W0631", "unreachable match arm after 'else'");
        }
        scope_push();
        if not a.alt {
            match_flow_arm_begin(&mf);
        }
        match a.pat {
            .Else => { has_else = true; }
            .Variant(p) => {
                if u.str_eq(p.name, "none") {
                    a.variant = 0;
                    a.value = u.I128.zero();
                    if seen_none {
                        _ = dg.err(a.span, "E0631", "variant 'none' is matched more than once");
                    }
                    seen_none = true;
                    if not u.isnos(p.bind) {
                        _ = dg.err(p.bind_span, "E0633", "variant 'none' has no payload to bind");
                    }
                } else if u.str_eq(p.name, "some") {
                    a.variant = 1;
                    a.value = u.I128.of(1);
                    if seen_some {
                        _ = dg.err(a.span, "E0631", "variant 'some' is matched more than once");
                    }
                    seen_some = true;
                    if not u.isnos(p.bind) and not u.str_eq(p.bind, "_") {
                        if a.alt or (((i + 1) < narms) and ast.stmt_more(s).arms.at(i + 1).alt) {
                            _ = dg.err(p.bind_span, "E0635", "a match arm with several patterns cannot bind a payload");
                        } else {
                            let mut bt = base.elem;
                            if by_ref {
                                bt = ty.type_ptr(base.elem, ref_mut);
                            }
                            a.bind_local = declare_local(p.bind, p.bind_span, bt, false, false);
                            a.bind_local.weakened = s.e.weakened;
                            if type_can_hold_ptr(bt) {
                                a.bind_local.origin_local = expr_local_origin(s.e);
                                if u.notnil(a.bind_local.origin_local) {
                                    a.bind_local.origin_fields = ~@as(u64, 0);
                                }
                            }
                        }
                    }
                } else {
                    _ = dg.err(a.span, "E0632", u.f2("%s has no variant '%s' (expected 'none' or 'some')", tstr(base),
                                                     p.name));
                }
            }
            else => {
                _ = dg.err(a.span, "E0634", u.f1("this pattern cannot match a value of optional type %s", tstr(base)));
            }
        }
        if not a.alt {
            let div_arm = check_block(a.body);
            if not div_arm {
                all_div = false;
            }
            match_flow_arm_end(&mut mf, div_arm);
        }
        scope_pop();
    }
    match_flow_end(&mf, narms);
    if not has_else {
        if not seen_none and not seen_some {
            _ = dg.err(s.span, "E0630", "non-exhaustive match: missing .none, .some");
        } else if not seen_none {
            _ = dg.err(s.span, "E0630", "non-exhaustive match: missing .none");
        } else if not seen_some {
            _ = dg.err(s.span, "E0630", "non-exhaustive match: missing .some");
        }
    }
    return all_div;
}

// The arms of a match on an integer, bool or error (t): values of its type, each
// at most once, every one (bool, a named error set) or an else. Whether every
// arm diverges.
fn check_value_match(s: *mut ast.Stmt, t: *mut ast.Type) bool {
    let mut all_div = true;
    let mut has_else = false;
    let narms = ast.stmt_more(s).arms.len;
    let mut seen_names = u.List.[[]u8].empty();
    let mut seenv = u.List.[u.I128].empty();
    let mut seen_true = false;
    let mut seen_false = false;
    let mut mf = match_flow_begin();
    for i in 0..narms {
        let a = ast.stmt_ext(s).arms.at_mut(i);
        if has_else and not a.alt {
            _ = dg.warning(a.span, "W0631", "unreachable match arm after 'else'");
        }
        scope_push();
        if not a.alt {
            match_flow_arm_begin(&mf);
        }
        let mut key = u.I128.zero();
        let mut keyed = false;
        let mut fits = false;  // the pattern is of the scrutinee's kind
        match a.pat {
            .Else => {
                has_else = true;
                fits = true;
            }
            .Int(n) => {
                if t.kind == ast.TY_INT {
                    if not fits_type(n, t) {
                        _ = dg.err(a.span, "E0503", u.f1("pattern does not fit in %s", tstr(t)));
                    }
                    key = n;
                    keyed = true;
                    fits = true;
                }
            }
            .Bool(bv) => {
                if t.kind == ast.TY_BOOL {
                    let dupe = (bv and seen_true) or (not bv and seen_false);
                    if dupe {
                        _ = dg.err(a.span, "E0631", "pattern is matched more than once");
                    }
                    if bv {
                        seen_true = true;
                    } else {
                        seen_false = true;
                    }
                    fits = true;
                }
            }
            .Error(name) => {
                if is_err_type(t) {
                    let code = error_code_here(name);
                    if code == 0 {
                        _ = dg.err(a.span, "E0650", u.f1("'error.%s' is not declared", name));
                    } else if (t.kind == ast.TY_ERROR) and not set_has(t.decl, name) {
                        _ = dg.err(a.span, "E0652", u.f2("'error.%s' is not in error set %s", name, t.decl.name));
                    }
                    seen_names.push(name);
                    a.error_code = code;
                    key = u.I128.ofu(@as(u64, code));
                    keyed = true;
                    fits = true;
                }
            }
            .Variant => {}
        }
        if not fits {
            _ = dg.err(a.span, "E0634", u.f1("this pattern cannot match a value of type %s", tstr(t)));
        }
        if keyed {
            for k in 0..seenv.len {
                if seenv.get(k).eq(key) {
                    _ = dg.err(a.span, "E0631", "pattern is matched more than once");
                }
            }
            seenv.push(key);
        }
        if not a.alt {
            let div_arm = check_block(a.body);
            if not div_arm {
                all_div = false;
            }
            match_flow_arm_end(&mut mf, div_arm);
        }
        scope_pop();
    }
    match_flow_end(&mf, narms);
    seenv.deinit();
    let exhaustive = has_else or ((t.kind == ast.TY_BOOL) and seen_true and seen_false);
    if not exhaustive and (t.kind == ast.TY_ERROR) and u.notnil(t.decl) {
        // a named error set: every error it holds, or else
        let mut missing = u.Buf.init();
        let mut nm: i32 = 0;
        for v in 0..t.decl.set_names.len {
            let n = t.decl.set_names.get(v);
            let mut hit = false;
            for k in 0..seen_names.len {
                if u.same(seen_names.get(k), n) {
                    hit = true;
                }
            }
            if hit {
                continue;
            }
            if nm != 0 {
                missing.s(", ");
            }
            nm += 1;
            missing.s("error.");
            missing.s(n);
        }
        let ms = missing.done();
        if nm != 0 {
            _ = dg.err(s.span, "E0630", u.f1("non-exhaustive match: missing %s", ms));
        }
    } else if not exhaustive {
        _ = dg.err(s.span, "E0630", "non-exhaustive match: add an 'else' arm");
    }
    seen_names.deinit();
    return all_div;
}

fn check_match(s: *mut ast.Stmt) bool {
    let mut t = check_expr(s.e, tnil());
    if ty.is_untyped(t) {
        t = sb.finalize_untyped(&mut s.e);
    }
    let se = unwrap_conv(s.e);
    let scrut_moved = u.notnil(se) and (se.kind == ast.E_IDENT) and u.notnil(ast.local_of(se)) and
                      ast.local_of(se).moved;
    let mut base = t;
    let mut by_ref = false;
    let mut ref_mut = false;
    if (t.kind == ast.TY_PTR) and ((t.elem.kind == ast.TY_UNION) or (t.elem.kind == ast.TY_OPT)) {
        base = t.elem;
        by_ref = true;
        ref_mut = t.is_mut;
    }
    let narms = ast.stmt_more(s).arms.len;
    let mut all_div = false;
    if (base.kind == ast.TY_UNION) or (base.kind == ast.TY_ENUM) {
        all_div = check_variant_match(s, base, by_ref, ref_mut);
    } else if base.kind == ast.TY_OPT {
        all_div = check_opt_match(s, base, by_ref, ref_mut);
    } else if (t.kind == ast.TY_INT) or (t.kind == ast.TY_BOOL) or is_err_type(t) {
        all_div = check_value_match(s, t);
    } else {
        if t.kind != ast.TY_INVALID {
            _ = dg.err(s.e.span, "E0634",
                       u.f1("cannot match on a value of type %s (only unions, optionals, *union, *optional, enums, integers, bool and error)",
                            tstr(t)));
        }
        let mut mf = match_flow_begin();
        for i in 0..narms {
            if ast.stmt_more(s).arms.at(i).alt {
                continue;
            }
            scope_push();
            match_flow_arm_begin(&mf);
            let div_arm = check_block(ast.stmt_ext(s).arms.at_mut(i).body);
            match_flow_arm_end(&mut mf, div_arm);
            scope_pop();
        }
        match_flow_end(&mf, narms);
    }
    if not by_ref and not scrut_moved {
        let mut has_bind = false;
        for i in 0..narms {
            if u.notnil(ast.stmt_more(s).arms.at(i).bind_local) {
                has_bind = true;
                break;
            }
        }
        if has_bind and u.notnil(se) and is_place(se) and u.notnil(se.ty) and (se.ty.kind != ast.TY_INVALID) and
           type_is_nocopy(se.ty) {
            _ = dg.err(se.span, "E0708", u.f1("cannot copy nocopy value of type %s", tstr(se.ty)));
        }
    }
    return (narms > 0) and all_div;
}

fn check_stmt(s: *mut ast.Stmt) bool {
    let mut div = false;
    match s.kind {
        .LET    => { div = check_let(s); }
        .EXPR   => { div = check_expr_stmt(s); }
        .ASSIGN => { check_assign(s); }
        .DISCARD => {
            let t = check_expr(s.e, tnil());
            if ty.is_untyped(t) {
                _ = sb.finalize_untyped(&mut s.e);
            } else if t.kind == ast.TY_VOID {
                _ = dg.err(s.e.span, "E0622", "nothing to discard: the expression has type void");
            } else if t.kind == ast.TY_ERRUNION {
                _ = dg.err(s.e.span, "E0621", "an error union cannot be discarded; handle it with '!' or 'catch'");
            } else {
                check_no_copy(s.e);
            }
        }
        .IF => {
            _ = check_expr_to(&mut s.e, ty.t_bool);
            let nloc = C.locals.len;
            let pre = save_moves(nloc);
            let pre_dead = C.flow_dead;
            let a = check_block(s.body);
            let then_dead = pre_dead or a;
            let then_snap = save_moves(nloc);
            let mut b = false;
            if u.notnil(s.els) {
                restore_moves(pre);
                C.flow_dead = pre_dead;
                if s.els.kind == ast.S_IF {
                    b = check_stmt(s.els);
                } else {
                    b = check_block(s.els);
                }
                let else_dead = pre_dead or b;
                let else_snap = save_moves(nloc);
                if then_dead and else_dead {
                    C.flow_dead = true;
                } else if then_dead {
                    restore_moves(else_snap);
                    C.flow_dead = pre_dead;
                } else if else_dead {
                    restore_moves(then_snap);
                    C.flow_dead = pre_dead;
                } else {
                    merge_moves_or(then_snap, else_snap);
                    C.flow_dead = pre_dead;
                }
            } else {
                if then_dead {
                    restore_moves(pre);
                    C.flow_dead = pre_dead;
                } else {
                    merge_moves_or(pre, then_snap);
                    C.flow_dead = pre_dead;
                }
            }
            div = u.notnil(s.els) and a and b;
        }
        .WHILE => {
            let nloc = C.locals.len;
            let pre = save_moves(nloc);
            let pre_dead = C.flow_dead;
            _ = check_expr_to(&mut s.e, ty.t_bool);
            let exit_snap = save_moves(nloc);
            enter_loop(s, nloc, pre, pre_dead);
            let body_dead = check_block(s.body);
            _ = leave_loop(exit_snap, true, body_dead);
        }
        .LOOP => {
            let nloc = C.locals.len;
            let pre = save_moves(nloc);
            let pre_dead = C.flow_dead;
            enter_loop(s, nloc, pre, pre_dead);
            let body_dead = check_block(s.body);
            div = not leave_loop(pre, false, body_dead);
        }
        .FOR   => { check_for(s); }
        .MATCH => { div = check_match(s); }
        .RETURN => {
            if u.notnil(s.e) {
                check_return_value(&mut s.e, s.span);
            } else {
                check_return_value(u.nil.[*mut ast.Expr](), s.span);
            }
            div = true;
        }
        .BREAK => {
            check_jump(s);
            div = true;
        }
        .CONTINUE => {
            check_jump(s);
            div = true;
        }
        .DEFER => { check_defer(s); }
        .BLOCK => { div = check_block(s); }
    }
    s.diverges = div;
    return div;
}

// let x = e; true if e never returns.
fn check_let(s: *mut ast.Stmt) bool {
    if s.undef {
        check_let_undefined(s);
        return false;
    }
    let mut t = tnil();
    if u.notnil(s.te) {
        t = resolve_type(s.te, &mut C.tc);
        if t.kind == ast.TY_VOID {
            _ = dg.err(s.te.span, "E0409", "a variable cannot have type void");
            t = ty.t_invalid;
        }
        _ = check_expr_to(&mut s.e, t);
    } else {
        t = check_expr(s.e, tnil());
        if ty.is_untyped(t) {
            let d = dg.err(s.e.span, "E0502",
                           u.f1("cannot infer the type of '%s' from a literal; add a type annotation", s.name));
            let fx = dg.fix(d, "annotate the type", "placeholder");
            dg.edit(fx, u.mkspan(s.name_span.file, s.name_span.end, s.name_span.end), ": <type>");
            t = ty.t_invalid;
        } else if t.kind == ast.TY_VOID {
            _ = dg.err(s.e.span, "E0409", "cannot bind a value of type void");
            t = ty.t_invalid;
        } else if t.kind == ast.TY_NEVER {
            t = ty.t_invalid;
        }
    }
    check_no_copy(s.e);
    s.local = declare_local(s.name, s.name_span, t, s.is_mut, false);
    s.local.weakened = s.e.weakened;
    s.local.origin_local = expr_local_origin_mask(s.e, &mut s.local.origin_fields);
    return u.notnil(s.e.ty) and (s.e.ty.kind == ast.TY_NEVER);
}

// let x: T = undefined;
fn check_let_undefined(s: *mut ast.Stmt) void {
    // `= undefined`: the type must be written, and the variable writable
    let mut t = ty.t_invalid;
    if u.notnil(s.te) {
        t = resolve_type(s.te, &mut C.tc);
        if t.kind == ast.TY_VOID {
            _ = dg.err(s.te.span, "E0409", "a variable cannot have type void");
            t = ty.t_invalid;
        }
    } else {
        let d = dg.err(s.e.span, "E0414", u.f1("'undefined' gives '%s' no type; add a type annotation", s.name));
        let fx = dg.fix(d, "annotate the type", "placeholder");
        dg.edit(fx, u.mkspan(s.name_span.file, s.name_span.end, s.name_span.end), ": <type>");
    }
    if not s.is_mut {
        let d = dg.err(s.e.span, "E0413",
                       u.f1("'%s' is left undefined but immutable, so it could never be written; use 'let mut'",
                            s.name));
        let fx = dg.fix(d, "make it mutable", "machine");
        dg.edit(fx, u.mkspan(s.name_span.file, s.name_span.start, s.name_span.start), "mut ");
    }
    s.e.ty = t;
    s.local = declare_local(s.name, s.name_span, t, s.is_mut, false);
}

// An expression statement; true if it never returns.
fn check_expr_stmt(s: *mut ast.Stmt) bool {
    let t = check_expr(s.e, tnil());
    if t.kind == ast.TY_NEVER {
        return true;
    }
    if ty.is_untyped(t) or ((t.kind != ast.TY_VOID) and (t.kind != ast.TY_INVALID)) {
        if t.kind == ast.TY_ERRUNION {
            let d = dg.err(s.e.span, "E0620", u.f1("error union result of type %s must be handled", tstr(t)));
            let fx = dg.fix(d, "propagate the error", "suggestion");
            dg.edit(fx, u.mkspan(s.e.span.file, s.e.span.end, s.e.span.end), "!");
        } else {
            let d = dg.err(s.e.span, "E0620", u.f1("result of type %s is discarded; write '_ = ...' to discard it",
                                                   tstr(t)));
            let fx = dg.fix(d, "discard explicitly", "machine");
            dg.edit(fx, sp_at(s.e.span), "_ = ");
        }
    }
    return false;
}

// for x in a..b / for x in xs / for &x in xs / for &mut x in xs
fn check_for(s: *mut ast.Stmt) void {
    let ref_iter = ast.stmt_more(s).ref_iter;
    let ref_mut = ast.stmt_more(s).ref_mut;
    let mut vt = tnil();
    if u.notnil(s.e2) {
        if ref_iter {
            _ = dg.err(s.span, "E0706", "by-reference 'for &' cannot iterate over a range");
            _ = check_expr(s.e, tnil());
            _ = check_expr(s.e2, tnil());
            vt = ty.t_invalid;
        } else {
            let mut a = check_expr(s.e, tnil());
            let mut bh = a;
            if ty.is_untyped(a) {
                bh = tnil();
            }
            let mut b = check_expr(s.e2, bh);
            if ty.is_untyped(a) and not ty.is_untyped(b) {
                coerce(&mut s.e, b);
                a = b;
            } else if not ty.is_untyped(a) and ty.is_untyped(b) {
                coerce(&mut s.e2, a);
                b = a;
            } else if ty.is_untyped(a) and ty.is_untyped(b) {
                _ = dg.err(s.e.span, "E0502",
                           "cannot infer the type of the range; give a bound a type, e.g. @as(usize, 0)");
                a = ty.t_invalid;
                b = ty.t_invalid;
            }
            if (a != b) and (a.kind != ast.TY_INVALID) and (b.kind != ast.TY_INVALID) {
                let d = dg.err(s.e2.span, "E0412", u.f2("range bounds have different types: %s and %s", tstr(a),
                                                        tstr(b)));
                dg.set_types(d, tstr(a), tstr(b));
            }
            if (a.kind != ast.TY_INT) and (a.kind != ast.TY_INVALID) and
               not ((a.kind == ast.TY_PARAM) and ty.satisfies(a, ast.C_INT)) {
                _ = dg.err(s.e.span, "E0412", u.f1("range bounds must be integers, found %s", tstr(a)));
            }
            vt = a;
        }
    } else {
        let t = check_expr(s.e, tnil());
        if t.kind == ast.TY_ARRAY {
            if ref_iter {
                if ref_mut {
                    if not is_place(s.e) {
                        _ = dg.err(s.e.span, "E0703", "'&mut' cannot take the address of a temporary");
                    } else if not is_mut_place(s.e) {
                        _ = dg.err(s.e.span, "E0701", "cannot take '*mut' elements from an immutable array");
                    }
                }
                if is_place(s.e) {
                    mark_addr_taken(s.e);
                }
                vt = ty.type_ptr(t.elem, ref_mut);
            } else {
                vt = t.elem;
            }
        } else if t.kind == ast.TY_SLICE {
            if ref_iter {
                if ref_mut and not t.is_mut {
                    _ = dg.err(s.e.span, "E0701", u.f1("cannot take '*mut' elements from immutable slice %s", tstr(t)));
                }
                vt = ty.type_ptr(t.elem, ref_mut);
            } else {
                vt = t.elem;
            }
        } else {
            if t.kind != ast.TY_INVALID {
                _ = dg.err(s.e.span, "E0412",
                           u.f1("'for x in' needs an array or slice, found %s (use lo..hi for ranges)", tstr(t)));
            }
            vt = ty.t_invalid;
        }
        if not ref_iter and ((t.kind == ast.TY_ARRAY) or (t.kind == ast.TY_SLICE)) and u.notnil(vt) and
           type_is_nocopy(vt) {
            let d = dg.err(s.name_span, "E0708", u.f1("cannot copy nocopy element of type %s in value loop", tstr(vt)));
            let can_mut = ((t.kind == ast.TY_SLICE) and t.is_mut and not s.e.weakened) or
                          ((t.kind == ast.TY_ARRAY) and is_place(s.e) and is_mut_place(s.e));
            if can_mut {
                let fm = dg.fix(d, "iterate by mutable pointer", "machine");
                dg.edit(fm, s.name_span, u.cat2("&mut ", s.name));
            }
            let fr = dg.fix(d, "iterate by pointer", "machine");
            dg.edit(fr, s.name_span, u.cat2("&", s.name));
        }
    }
    let nloc = C.locals.len;
    let pre = save_moves(nloc);
    let pre_dead = C.flow_dead;
    scope_push();
    s.local = declare_local(s.name, s.name_span, vt, false, false);
    if u.isnil(s.e2) and u.notnil(s.e.ty) {
        if ref_iter {
            if s.e.ty.kind == ast.TY_ARRAY {
                s.local.origin_local = place_origin(s.e);
            } else if s.e.ty.kind == ast.TY_SLICE {
                s.local.origin_local = expr_local_origin(s.e);
            }
        } else if type_can_hold_ptr(vt) {
            s.local.origin_local = expr_local_origin(s.e);
        }
        if u.notnil(s.local.origin_local) {
            s.local.origin_fields = ~@as(u64, 0);
        }
    }
    enter_loop(s, nloc, pre, pre_dead);
    let body_dead = check_block(s.body);
    _ = leave_loop(pre, true, body_dead);
    scope_pop();
}

fn enter_loop(s: *mut ast.Stmt, nloc: usize, pre: MoveSnap, pre_dead: bool) void {
    C.loop_depth += 1;
    C.loop_breaks.push(false);
    C.loop_labels.push(ast.stmt_more(s).label);
    let brk = MoveSnap.{
        moved: u.newn.[bool](nloc),
        spans: u.newn.[u.Span](nloc),
        origins: u.newn.[*mut ast.Local](nloc),
        origin_fields: u.newn.[u64](nloc),
        n: nloc,
    };
    C.loop_moves.push(LoopMove.{
        base: nloc,
        pre: pre,
        brk: brk,
        reported: u.newn.[u.Span](nloc),
        pre_dead: pre_dead,
        has_break: false,
    });
}

// Whether a break targeted the loop.
fn leave_loop(exit_snap: MoveSnap, has_cond: bool, body_dead: bool) bool {
    let lm = C.loop_moves.at_mut(C.loop_moves.len - 1);
    if not body_dead and not lm.pre_dead {
        check_loop_backedge(lm, u.mkspan(0, 0, 0), false);
    }
    if not has_cond {
        if lm.has_break {
            restore_moves(lm.brk);
            C.flow_dead = lm.pre_dead;
        } else {
            restore_moves(lm.pre);
            C.flow_dead = true;
        }
    } else {
        let mut acc = MoveSnap.{
            moved: u.newn.[bool](lm.base),
            spans: u.newn.[u.Span](lm.base),
            origins: u.newn.[*mut ast.Local](lm.base),
            origin_fields: u.newn.[u64](lm.base),
            n: lm.base,
        };
        or_snap_into(&mut acc, exit_snap);
        if lm.has_break {
            or_snap_into(&mut acc, lm.brk);
        }
        if not body_dead and not lm.pre_dead {
            or_moves_into(&mut acc, lm.base);
        }
        restore_moves(acc);
        C.flow_dead = lm.pre_dead;
    }
    _ = C.loop_moves.pop();
    C.loop_labels.len -= 1;
    C.loop_depth -= 1;
    return C.loop_breaks.pop();
}

// A break or continue (statement or catch handler) at `sp`, naming the
// loop `label` (or none): the number of loops it leaves beyond the
// innermost, or -1 after an error.
fn check_jump_target(label: []u8, sp: u.Span, is_break: bool) i32 {
    if C.loop_depth == 0 {
        _ = dg.err(sp, "E0604", u.f1("'%s' outside of a loop", u.pick(is_break, "break", "continue")));
        return -1;
    }
    let mut d: i32 = 0;
    if label.len > 0 {
        let n = C.loop_labels.len;
        let mut i = n;
        while (i > 0) and not u.str_eq(C.loop_labels.get(i - 1), label) {
            i -= 1;
        }
        if i == 0 {
            _ = dg.err(sp, "E0605", u.f1("no enclosing loop is labeled '%s'", label));
            return -1;
        }
        d = @int_cast(i32, n - i);
    }
    if (C.defer_depth > 0) and ((C.loop_depth - d) <= C.defer_loop_base) {
        _ = dg.err(sp, "E0640", "control flow cannot leave a deferred statement");
        return -1;
    }
    let idx = C.loop_moves.len - 1 - @int_cast(usize, d);
    if is_break {
        C.loop_breaks.set(idx, true);
        if not C.flow_dead {
            let lm = C.loop_moves.at_mut(idx);
            or_moves_into(&mut lm.brk, lm.base);
            lm.has_break = true;
        }
    } else if not C.flow_dead {
        check_loop_backedge(C.loop_moves.at_mut(idx), sp, true);
    }
    return d;
}

// break / continue
fn check_jump(s: *mut ast.Stmt) void {
    let mut sp = s.span;
    if ast.stmt_more(s).label.len > 0 {
        sp = ast.stmt_more(s).label_span;
    }
    s.jump_depth = @max(check_jump_target(ast.stmt_more(s).label, sp, s.kind == ast.S_BREAK), 0);
}

fn check_defer(s: *mut ast.Stmt) void {
    if ast.stmt_more(s).on_error and (u.isnil(C.ret) or (C.ret.kind != ast.TY_ERRUNION)) {
        _ = dg.err(s.span, "E0641", "errdefer needs a function that returns an error union (!T)");
    }
    let nloc = C.locals.len;
    let pre = save_moves(nloc);
    let saved_base = C.defer_loop_base;
    let saved_dead = C.flow_dead;
    C.defer_depth += 1;
    C.defer_loop_base = C.loop_depth;
    if s.body.kind == ast.S_BLOCK {
        _ = check_block(s.body);
    } else {
        _ = check_stmt(s.body);
        if (s.body.kind == ast.S_EXPR) and is_leaving_catch(s.body.e) {
            _ = dg.err(s.body.span, "E0640", "control flow cannot leave a deferred statement");
        }
    }
    restore_moves(pre);
    C.flow_dead = saved_dead;
    C.defer_depth -= 1;
    C.defer_loop_base = saved_base;
}

fn ensure_infer_ret(f: *mut ast.Decl) void {
    if (f.kind == ast.D_FN) and (f.state == ast.DeclState.DONE) and f.is_infer_ret and not f.checked and
       not f.inferring_ret {
        check_fn_body(f);
    }
}

fn list_has_sym(xs: *u.List.[[]u8], name: []u8) bool {
    for i in 0..xs.len {
        if u.same(xs.get(i), name) {
            return true;
        }
    }
    return false;
}

fn check_unused_errset(decl: *mut ast.Decl, ret_errs: *u.List.[[]u8], set_sp: u.Span, elem_sp: u.Span) void {
    let mut kept = u.List.[[]u8].empty();
    let mut dropped = false;
    for i in 0..decl.set_names.len {
        let n = decl.set_names.get(i);
        if list_has_sym(ret_errs, n) {
            kept.push(n);
        } else {
            dropped = true;
        }
    }
    if not dropped {
        kept.deinit();
        return;
    }
    let d = dg.warning(set_sp, "W0655", "declared error set contains errors this function can never return");
    if kept.len > 0 {
        let mut b = u.Buf.init();
        b.s("{ ");
        for i in 0..kept.len {
            if i != 0 {
                b.s(", ");
            }
            b.s(kept.get(i));
        }
        b.s(" }");
        let fx = dg.fix(d, "narrow the error set", "machine");
        dg.edit(fx, set_sp, b.done());
    } else {
        let fx = dg.fix(d, "remove the unused error set", "suggestion");
        dg.edit(fx, u.mkspan(set_sp.file, set_sp.start, elem_sp.start), "");
    }
    kept.deinit();
}

fn check_fn_body(f: *mut ast.Decl) void {
    if f.checked or f.inferring_ret {
        return;
    }
    if f.is_infer_ret {
        f.inferring_ret = true;
    }
    resolve_decl(f);
    check_fn_attr(f);
    let mut oself = tnil();
    if u.notnil(f.owner) {
        oself = f.owner.ty;
    }
    let ctx = u.new.[FnCtx]();
    ctx.* = fn_ctx(type_ctx(f.module, f.owner, f, oself));
    ctx.fnd = f;
    ctx.ret = f.ret_type;
    let saved = C;
    C = ctx;
    scope_push();
    for i in 0..f.params.len {
        let p = f.params.at_mut(i);
        p.local = declare_local(p.name, p.span, f.param_types[i], false, true);
    }
    let div = check_block(f.body);
    if f.is_infer_ret and (f.ret_type.kind == ast.TY_ERRUNION) {
        if not ctx.ret_err_open {
            let set = intern_anon_errset(&ctx.ret_errs);
            f.ret_type = ty.type_errunion_set(f.ret_type.elem, set);
            f.ty = ty.type_fn(f.param_types, f.ret_type);
        }
    } else if not ctx.ret_err_open and (f.all_gparams.len == 0) and (f.ret_type.kind == ast.TY_ERRUNION) and
              u.notnil(f.ret_type.decl) and f.ret_type.decl.is_anon and u.notnil(f.ret_te) {
        match f.ret_te.shape {
            .ErrUnion(eu) => {
                if u.notnil(eu.set) and u.notnil(eu.elem) {
                    match eu.set.shape {
                        .ErrSetInline => {
                            check_unused_errset(f.ret_type.decl, &ctx.ret_errs, eu.set.span, eu.elem.span);
                        }
                        else => {}
                    }
                }
            }
            else => {}
        }
    }
    let r = f.ret_type;
    if not div and (r.kind != ast.TY_VOID) and (r.kind != ast.TY_INVALID) and
       not ((r.kind == ast.TY_ERRUNION) and (r.elem.kind == ast.TY_VOID)) {
        let bs = f.body.span;
        let mut st: u32 = 0;
        if bs.end > 0 {
            st = bs.end - 1;
        }
        let d = dg.err(u.mkspan(bs.file, st, bs.end), "E0601",
                       u.f2("missing return: function '%s' must return %s on every path", f.name, tstr(r)));
        dg.note(d, f.name_span, u.f1("'%s' declared here", f.name));
    }
    scope_pop();
    f.inferring_ret = false;
    f.checked = true;
    ctx.scope.deinit();
    ctx.marks.deinit();
    ctx.locals.deinit();
    ctx.loop_moves.deinit();
    ctx.loop_breaks.deinit();
    ctx.loop_labels.deinit();
    ctx.ret_errs.deinit();
    C = saved;
    spost.gate_fn(f);
}

// @features / @multiversion: the extension sets, closed under implication.
// A set naming another architecture's extension is NO_VERSION.
fn check_fn_attr(f: *mut ast.Decl) void {
    if f.attr == ast.ATTR_NONE {
        return;
    }
    let n = f.attr_args.len;
    f.feat_sets = u.newn.[u64](n + 1)[0..n];
    let what = u.pick(f.attr == ast.ATTR_FEATURES, "features", "multiversion");
    if n == 0 {
        _ = dg.err(f.attr_span, "E0829", u.f1("@%s needs at least one set of extensions, such as \"avx2,fma\"", what));
        return;
    }
    if (f.attr == ast.ATTR_FEATURES) and (n != 1) {
        _ = dg.err(f.attr_span, "E0829",
                   "@features takes one set of extensions (\"a,b\"); @multiversion takes several");
    }
    for i in 0..n {
        let spec = f.attr_args.get(i);
        let sp = f.attr_arg_spans.get(i);
        let mut bits: u64 = 0;
        let mut foreign = false;
        let mut empty = true;
        let mut k: usize = 0;
        while k <= spec.len {
            let mut j = k;
            while (j < spec.len) and (spec[j] != ',') {
                j += 1;
            }
            let mut name = spec[k..j];
            k = j + 1;
            while (name.len > 0) and (name[0] == ' ') {
                name = name[1..];
            }
            if (name.len > 0) and (name[0] == '+') {
                name = name[1..];
            }
            if name.len == 0 {
                continue;
            }
            empty = false;
            if not tg.feature_known(name) {
                _ = dg.err(sp, "E0827", u.f2("unknown processor extension '%s' (this target has: %s)", name,
                                             tg.feature_names()));
                continue;
            }
            let b = tg.feature_bit(name);
            if b == 0 {
                foreign = true;
            }
            bits = bits | b;
        }
        if empty {
            _ = dg.err(sp, "E0829", "empty set of extensions");
        }
        if foreign {
            f.feat_sets[i] = spost.NO_VERSION;
        } else {
            f.feat_sets[i] = tg.parse_features(spec).bits;
        }
    }
}

// The operands of the processor-instruction builtins (spec §13.5), one
// letter each: W a byte vector (u8x16, u8x32, u8x64), Y a u64 vector (u64x2,
// u64x4, u64x8), B u8x16, Q u64x2, D u32x4, V a 128-bit integer vector, S
// u32, C u8, u16, u32 or u64 (CRC data), I a constant.
fn insn_ops(id: ast.BuiltinId) []u8 {
    let t = ["WW", "WW", "WW", "WW", "B", "BI", "YYI", "DDI", "DD", "DD", "DD", "DDD", "DD", "DD", "SC", "BB", "BB",
             "B", "B", "QQ", "QQ", "DSD", "DSD", "DSD", "S", "DDD", "DD", "DDD", "DDD", "DD", "DDD", "QQQ", "QQQ", "QQ",
             "QQQ", "VVV", "VVV", "QQ", "QQI", "SC", "SC"];
    return t[@int_cast(usize, ast.builtin_index(id, ast.BI_X86_AESENC))];
}

fn insn_kind_ok(c: u8, t: *mut ast.Type) bool {
    if t.kind == ast.TY_INVALID {
        return true;
    }
    if c == 'W' {
        return (t.kind == ast.TY_VEC) and (t.elem == ty.t_u8);
    }
    if c == 'Y' {
        return (t.kind == ast.TY_VEC) and (t.elem == ty.t_u64);
    }
    if c == 'B' {
        return t == ty.type_vec(ty.t_u8, 16);
    }
    if c == 'Q' {
        return t == ty.type_vec(ty.t_u64, 2);
    }
    if c == 'D' {
        return t == ty.type_vec(ty.t_u32, 4);
    }
    return ty.is_vec_int(t) and (ty.simd_bits(t) == 128);  // V
}

fn insn_kind_name(c: u8) []u8 {
    if c == 'W' {
        return "u8x16, u8x32 or u8x64";
    }
    if c == 'Y' {
        return "u64x2, u64x4 or u64x8";
    }
    if c == 'B' {
        return "u8x16";
    }
    if c == 'Q' {
        return "u64x2";
    }
    if c == 'D' {
        return "u32x4";
    }
    return "a 128-bit integer vector";
}

fn insn_check(e: *mut ast.Expr, id: ast.BuiltinId) *mut ast.Type {
    let ops = insn_ops(id);
    let mut first = tnil();
    let mut first_kind: u8 = 0;
    for k in 0..ops.len {
        let c = ops[k];
        let pe = sb.earg(e, k);
        if c == 'I' {
            let mut max: i64 = 255;
            if id == ast.BI_X86_SHA1RNDS4 {
                max = 3;
            } else if id == ast.BI_ARM_XAR {
                max = 63;
            }
            let t = check_expr(pe.*, ty.t_u32);
            if ty.is_untyped(t) {
                coerce(pe, ty.t_u32);
            }
            let a = pe.*;
            if not a.is_const or ast.cval_of(a).is_neg() or ast.cval_of(a).ge(u.I128.of(max + 1)) {
                _ = dg.err(a.span, "E0820", u.f2("@%s needs a constant in 0..%s here", e.name, u.dec(max)));
            }
        } else if c == 'S' {
            _ = check_expr_to(pe, ty.t_u32);
        } else if c == 'C' {
            let t = check_expr(pe.*, tnil());
            if ty.is_untyped(t) {
                _ = sb.finalize_untyped(pe);
            } else if not ((t.kind == ast.TY_INT) and not t.is_signed and not t.is_size) and
                      (t.kind != ast.TY_INVALID) {
                _ = dg.err(pe.*.span, "E0822", u.f2("@%s takes u8, u16, u32 or u64 data, found %s", e.name, tstr(t)));
            }
        } else if u.notnil(first) and (c == first_kind) {
            _ = check_expr_to(pe, first);
        } else {
            let t = check_expr(pe.*, tnil());
            if not insn_kind_ok(c, t) {
                _ = dg.err(pe.*.span, "E0812", u.f3("@%s needs %s operands, found %s", e.name, insn_kind_name(c),
                                                    tstr(t)));
            }
            if u.isnil(first) {
                first = t;
                first_kind = c;
            }
        }
    }
    if (ops[0] == 'S') or (u.isnil(first)) {
        return ty.t_u32;
    }
    if not insn_kind_ok(first_kind, first) {
        return ty.t_invalid;
    }
    return first;
}

// ---------------------------------------------------------------------------
// Driver
// ---------------------------------------------------------------------------
// False if any errors were reported.
// A builtin's type argument (semabuiltin.ax), in the context it is in.
fn resolve_arg(te: *mut ast.TypeExpr) *mut ast.Type {
    return resolve_type(te, &mut C.tc);
}

pub fn run(path: []u8, opts: *SemaOptions) bool {
    sb.check_expr = check_expr;
    sb.check_expr_to = check_expr_to;
    sb.coerce = coerce;
    sb.resolve_arg = resolve_arg;
    sb.insn_check = insn_check;
    sb.check_no_copy = check_no_copy;
    // (a thread's second run, as axiom lsp's main thread makes, starts
    // afresh too)
    C = u.nil.[FnCtx]();
    modl.mod_by_path = u.SymMap.[*mut ast.Module].{ keys: u.nil.[usize](), vals: u.nil.[*mut ast.Module](), cap: 0,
                                                    len: 0 };
    modl.mod_state = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    spost.size_checks = u.List.[spost.SizeCheck].empty();
    spost.gate_reported = u.List.[u32].empty();
    g_self_dep = dnil();
    anon_errsets = u.SymMap.[*mut ast.Decl].{ keys: u.nil.[usize](), vals: u.nil.[*mut ast.Decl](), cap: 0, len: 0 };
    modl.g_error_use_unknown = false;
    modl.g_prog = u.new.[modl.Program]();
    modl.g_std_dir = opts.std_dir;
    modl.g_cwd = u.cwd();
    let root = modl.load_module(path, u.nil.[u.Span]());
    if u.isnil(root) {
        return false;
    }
    modl.g_prog.root = root;
    for x in opts.extra_files {
        _ = modl.load_module(x, u.nil.[u.Span]());
    }
    // (the modules taken as checked are not checked again, but count in
    // every program-wide step)
    for i in 0..modl.g_prog.modules.len {
        if not modl.g_prog.modules.get(i).base {
            register_module(modl.g_prog.modules.get(i));
        }
    }
    assign_error_codes();

    // Resolve all declarations.
    for mi in 0..modl.g_prog.modules.len {
        let m = modl.g_prog.modules.get(mi);
        if m.base {
            continue;
        }
        for i in 0..m.decls.len {
            let d = m.decls.get(i);
            if (d.kind == ast.D_IMPORT) or ((d.kind == ast.D_ERROR) and u.isnos(d.name)) {
                continue;
            }
            resolve_decl(d);
            for j in 0..d.methods.len {
                resolve_decl(d.methods.get(j));
            }
        }
    }
    // Infinite-size types.
    for mi in 0..modl.g_prog.modules.len {
        let m = modl.g_prog.modules.get(mi);
        if m.base {
            continue;
        }
        for i in 0..m.decls.len {
            let d = m.decls.get(i);
            if ((d.kind == ast.D_STRUCT) or (d.kind == ast.D_UNION)) and contains_by_value(d.ty, d, 0) {
                _ = dg.err(d.name_span, "E0403", u.f1("'%s' contains itself by value and would have infinite size",
                                                      d.name));
            }
        }
    }
    // Exported names must be unique program-wide.
    let mut exports = u.SymMap.[*mut ast.Decl].{ keys: u.nil.[usize](), vals: u.nil.[*mut ast.Decl](), cap: 0, len: 0 };
    for mi in 0..modl.g_prog.modules.len {
        let m = modl.g_prog.modules.get(mi);
        for i in 0..m.decls.len {
            let d = m.decls.get(i);
            if (d.kind == ast.D_FN) and d.is_export {
                let p = exports.get(d.name);
                if u.notnil(p) {
                    let g = dg.err(d.name_span, "E0802", u.f1("export name '%s' is used more than once", d.name));
                    dg.note(g, p.name_span, "first exported here");
                } else {
                    exports.put(d.name, d);
                }
            }
        }
    }
    // Globals and function bodies.
    for mi in 0..modl.g_prog.modules.len {
        let m = modl.g_prog.modules.get(mi);
        for i in 0..m.decls.len {
            let d = m.decls.get(i);
            let k = d.kind;
            if k == ast.D_GLOBAL {
                if not m.base {
                    check_global(d);
                }
                modl.g_prog.globals.push(d);
            } else if k == ast.D_FN {
                if not m.base {
                    check_fn_body(d);
                }
                if d.is_test {
                    // Tests run for the root module and, in a package, for the
                    // root package's modules; outside packages, for every
                    // non-std module.
                    let mut runs = m == root;
                    if not runs {
                        if u.notnil(root.pkg) {
                            runs = m.pkg == root.pkg;
                        } else {
                            runs = not modl.is_std_module(m);
                        }
                    }
                    if runs {
                        modl.g_prog.tests.push(d);
                    }
                } else {
                    modl.g_prog.fns.push(d);
                }
            } else if k == ast.D_HOST_FN {
                modl.g_prog.host_fns.push(d);
            } else if (k == ast.D_STRUCT) or (k == ast.D_UNION) or (k == ast.D_ENUM) {
                for j in 0..d.methods.len {
                    if not m.base {
                        check_fn_body(d.methods.get(j));
                    }
                    modl.g_prog.fns.push(d.methods.get(j));
                }
            }
        }
    }
    spost.check_inline_cycles();
    spost.check_sizes();
    return dg.error_count() == 0;
}
