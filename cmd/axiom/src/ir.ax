// =============================================================================
// ir.ax - the compiler's intermediate representation: typed SSA in basic
// blocks, in the style of LLVM IR, and the builder the code generator uses
// to create it.
//
// Values are one struct (`Value`) for everything: constants, globals,
// functions, parameters and instructions. Aggregates (structs and arrays) may
// be SSA values when codegen builds the IR; lower.ax turns them into memory
// before the target backends run, which only see scalars (integers, floats,
// pointers and 128-bit vectors).
//
// The builder folds constant integer operations, like LLVM's IRBuilder, so a
// check whose condition is a constant disappears when the IR is built.
// =============================================================================
import "util.ax" as u;

import part "ir_build.ax";
import part "ir_cfg.ax";
import part "ir_const.ax";
import part "ir_dbg.ax";
import part "ir_intr.ax";
import part "ir_module.ax";
import part "ir_more.ax";
import part "ir_ops.ax";
import part "ir_pool.ax";
import part "ir_restrict.ax";
import part "ir_types.ax";
import part "ir_uses.ax";
import part "ir_verify.ax";

// -----------------------------------------------------------------------------
// Types
// -----------------------------------------------------------------------------
// What an IR type is (Ty.kind).
pub enum TyKind {
    VOID,
    INT,
    FLOAT,
    PTR,
    VEC,
    ARRAY,
    STRUCT,
    FN,
}

pub const T_VOID: TyKind = TyKind.VOID;
pub const T_INT: TyKind = TyKind.INT;      // bits: 1, 8, 16, 32, 64, 128
pub const T_FLOAT: TyKind = TyKind.FLOAT;  // bits: 32, 64
pub const T_PTR: TyKind = TyKind.PTR;
pub const T_VEC: TyKind = TyKind.VEC;        // elem (INT or FLOAT lane), lanes
pub const T_ARRAY: TyKind = TyKind.ARRAY;    // elem, count
pub const T_STRUCT: TyKind = TyKind.STRUCT;  // fields, offs
pub const T_FN: TyKind = TyKind.FN;          // ret, params, vararg

pub struct Ty {
    pub kind: TyKind,
    pub bits: i32,
    pub lanes: i32,
    pub elem: *mut Ty,
    pub count: u64,
    pub fields: []mut *mut Ty,
    pub offs: []mut u64,
    pub ret: *mut Ty,
    pub params: []mut *mut Ty,
    pub vararg: bool,
    pub size: u64,
    pub align: u64,
    name: []u8,
    has_body: bool,
    pub id: i32,
    undef_v: *mut Value,  // the type's undef (made on first use, shared)
}

// -----------------------------------------------------------------------------
// Values
// -----------------------------------------------------------------------------
// What a Value is (Value.kind).
pub enum ValueKind {
    INST,
    CINT,
    CFP,
    ZERO,
    UNDEF,
    CAGG,
    GLOBAL,
    FUNC,
    PARAM,
    CSTR,
}

pub const V_INST: ValueKind = ValueKind.INST;
pub const V_CINT: ValueKind = ValueKind.CINT;  // cv (truncated to the width, zero-extended)
pub const V_CFP: ValueKind = ValueKind.CFP;    // fv
pub const V_ZERO: ValueKind = ValueKind.ZERO;  // zero of any type (null pointer, zeroinitializer)
pub const V_UNDEF: ValueKind = ValueKind.UNDEF;
pub const V_CAGG: ValueKind = ValueKind.CAGG;      // constant struct / array / vector: xs
pub const V_CSTR: ValueKind = ValueKind.CSTR;      // constant [n x i8]: bytes_of (cstring)
pub const V_GLOBAL: ValueKind = ValueKind.GLOBAL;  // address of gv
pub const V_FUNC: ValueKind = ValueKind.FUNC;      // address of fnp
pub const V_PARAM: ValueKind = ValueKind.PARAM;    // cv = index

// Instructions
pub const OP_ADD: i32 = 1;
pub const OP_SUB: i32 = 2;
pub const OP_MUL: i32 = 3;
pub const OP_UDIV: i32 = 4;
pub const OP_SDIV: i32 = 5;
pub const OP_UREM: i32 = 6;
pub const OP_SREM: i32 = 7;
pub const OP_AND: i32 = 8;
pub const OP_OR: i32 = 9;
pub const OP_XOR: i32 = 10;
pub const OP_SHL: i32 = 11;
pub const OP_LSHR: i32 = 12;
pub const OP_ASHR: i32 = 13;
pub const OP_FADD: i32 = 14;
pub const OP_FSUB: i32 = 15;
pub const OP_FMUL: i32 = 16;
pub const OP_FDIV: i32 = 17;
pub const OP_FREM: i32 = 18;
pub const OP_FNEG: i32 = 19;
pub const OP_ICMP: i32 = 20;    // cv: predicate
pub const OP_FCMP: i32 = 21;    // cv: predicate
pub const OP_SELECT: i32 = 22;  // a ? b : c
pub const OP_ZEXT: i32 = 23;
pub const OP_SEXT: i32 = 24;
pub const OP_TRUNC: i32 = 25;
pub const OP_BITCAST: i32 = 26;
pub const OP_PTRTOINT: i32 = 27;
pub const OP_INTTOPTR: i32 = 28;
pub const OP_FPEXT: i32 = 29;
pub const OP_FPTRUNC: i32 = 30;
pub const OP_SITOFP: i32 = 31;
pub const OP_UITOFP: i32 = 32;
pub const OP_FPTOSI_SAT: i32 = 33;
pub const OP_FPTOUI_SAT: i32 = 34;
pub const OP_ALLOCA: i32 = 35;   // aty: allocated type; align
pub const OP_LOAD: i32 = 36;     // a: address
pub const OP_STORE: i32 = 37;    // a: value, b: address
pub const OP_PTRADD: i32 = 38;   // a: pointer, b: byte offset (pointer-sized int)
pub const OP_MEMCPY: i32 = 39;   // a: dst, b: src, c: length (non-overlapping, not even equal)
pub const OP_MEMMOVE: i32 = 40;  // a: dst, b: src, c: length (may overlap)
pub const OP_MEMSET: i32 = 41;   // a: dst, b: byte (i8), c: length
pub const OP_RMW: i32 = 42;      // cv: RMW_*; a: address, b: value
pub const OP_CMPXCHG: i32 = 43;  // a: address, b: expected, c: new; result: old value
pub const OP_FENCE: i32 = 44;
pub const OP_EXTRACTVALUE: i32 = 45;  // a: aggregate, cv: index
pub const OP_INSERTVALUE: i32 = 46;   // a: aggregate, b: value, cv: index
pub const OP_EXTRACTELEM: i32 = 47;   // a: vector, cv: lane
pub const OP_INSERTELEM: i32 = 48;    // a: vector, b: scalar, cv: lane
pub const OP_SHUFFLE: i32 = 49;       // a, b: vectors; mask: lane indices
pub const OP_SPLAT: i32 = 50;         // a: scalar
pub const OP_CALL: i32 = 51;          // a: callee; xs: arguments; fty: signature
pub const OP_INTR: i32 = 52;          // cv: IN_*; xs: arguments
pub const OP_PHI: i32 = 53;           // xs: values, bs: blocks
pub const OP_BR: i32 = 54;            // t1
pub const OP_CONDBR: i32 = 55;        // a: condition; t1 if true, t2 if false
pub const OP_SWITCH: i32 = 56;        // a: value; t1: default; xs: case constants, bs: targets; cv: 0, or SW_TABLE
pub const OP_RET: i32 = 57;           // a: value (nil for void); xs: the registers of a result in registers (EXT_REGS)
pub const OP_UNREACHABLE: i32 = 58;
pub const OP_COPY: i32 = 59;  // a (backend use)

// A switch's cv when lowering for code generation (switches.ax) made it a
// jump table: its cases are 0, 1, ... n - 1 in order, and the value is
// known to be less than n (unsigned). Only code generation sees one.
pub const SW_TABLE: u64 = 1;

// Comparison predicates (LLVM's numbering), an ICMP's or FCMP's cv
pub enum CmpPred: i32 {
    OEQ = 1,  // floating point: ordered (neither is a NaN) and ...
    OGT = 2,
    OGE = 3,
    OLT = 4,
    OLE = 5,
    UNE = 14,  // unordered (either is a NaN) or not equal
    EQ = 32,   // integers
    NE = 33,
    UGT = 34,
    UGE = 35,
    ULT = 36,
    ULE = 37,
    SGT = 38,
    SGE = 39,
    SLT = 40,
    SLE = 41,
}

pub const IntEQ: CmpPred = CmpPred.EQ;
pub const IntNE: CmpPred = CmpPred.NE;
pub const IntUGT: CmpPred = CmpPred.UGT;
pub const IntUGE: CmpPred = CmpPred.UGE;
pub const IntULT: CmpPred = CmpPred.ULT;
pub const IntULE: CmpPred = CmpPred.ULE;
pub const IntSGT: CmpPred = CmpPred.SGT;
pub const IntSGE: CmpPred = CmpPred.SGE;
pub const IntSLT: CmpPred = CmpPred.SLT;
pub const IntSLE: CmpPred = CmpPred.SLE;
pub const RealOEQ: CmpPred = CmpPred.OEQ;
pub const RealOGT: CmpPred = CmpPred.OGT;
pub const RealOGE: CmpPred = CmpPred.OGE;
pub const RealOLT: CmpPred = CmpPred.OLT;
pub const RealOLE: CmpPred = CmpPred.OLE;
pub const RealUNE: CmpPred = CmpPred.UNE;

// Read-modify-write operations
pub const RMW_XCHG: i32 = 0;
pub const RMW_ADD: i32 = 1;
pub const RMW_SUB: i32 = 2;
pub const RMW_AND: i32 = 3;
pub const RMW_OR: i32 = 5;
pub const RMW_XOR: i32 = 6;
pub const RMW_MAX: i32 = 7;
pub const RMW_MIN: i32 = 8;
pub const RMW_UMAX: i32 = 9;
pub const RMW_UMIN: i32 = 10;

// Argument and parameter marks (CALL ext, Func.param_ext) besides 1 (zext)
// and 2 (sext), set by lowering for the address of an aggregate:
pub const EXT_BYVAL: u8 = 3;  // passed by value: the callee only reads it
pub const EXT_SRET: u8 = 4;   // the result's memory: the call writes it (a parameter: the
                              // caller's fresh slot, which nothing else uses)
// The C front end's marks for the platforms' C calling conventions
// (c/cgen_abi.ax); Axiom code has none of them:
pub const EXT_X8SRET: u8 = 5;  // the address of the result's memory, passed in x8 (AArch64), not as a parameter
// A result in 1 to 4 registers (a structure: System V's rax, rdx, xmm0,
// xmm1; AArch64's x0, x1 or v0-v3), as the result's mark (a call's ext[0],
// a function's ret_ext) says. The IR signature's result is void: the call's
// registers are IN_CALL_RESULT(call, k), k from 0, and the function's
// returns return their values as their xs, in order (their a is nil). (No
// pass can then replace the call by another value, nor a return's values
// by none.) The bits below EXT_REGS: the count less one, and which are
// floating-point.
pub const EXT_REGS: u8 = 0x80;
pub const EXT_REGS_FP0: u8 = 0x08;  // shifted left by the register's place (0 to 3)

// Load/store flags
pub const F_VOLATILE: u32 = 1;
pub const F_ATOMIC: u32 = 2;  // atomic (of the memory order the F_ORD bits give: 0 is sequentially consistent)
// The memory order of an atomic load, store, rmw, cmpxchg (its success's) or
// fence: (flags >> F_ORD_SHIFT) & 7, one of the ORD_ values, 0 (seq_cst)
// by default; a cmpxchg's order on failure in the bits F_FAIL_SHIFT (an
// order no stronger than what the backends use is always valid: they may
// implement any order by a stronger one). Only the backends weaken their
// instructions by them; the optimizer treats every atomic operation and
// fence, whatever its order, as it treats a sequentially consistent one
// (it does not move memory accesses across it, merge it or remove it):
// valid for every order, since a weaker order only allows more behaviours.
pub const F_ORD_SHIFT: u32 = 8;
pub const F_ORD_MASK: u32 = 0x700;
pub const F_FAIL_SHIFT: u32 = 11;
pub const F_FAIL_MASK: u32 = 0x3800;
// A cmpxchg that may fail spuriously (C's compare_exchange_weak): its
// success is IN_CMPXCHG_OK(cas) (an i1), not old == expected.
pub const F_WEAK: u32 = 0x4000;
// A fence that orders the thread's accesses only for its own signal
// handlers (atomic_signal_fence): no instruction, but the optimizer and
// the backends keep accesses on their side of it.
pub const F_SIGNAL: u32 = 0x8000;
pub const ORD_SEQ_CST: u32 = 0;
pub const ORD_RELAXED: u32 = 1;
pub const ORD_ACQUIRE: u32 = 2;  // (and consume, which is implemented as acquire)
pub const ORD_RELEASE: u32 = 3;
pub const ORD_ACQ_REL: u32 = 4;

// Call flags
pub const F_TAIL: u32 = 4;  // a sibling call: the backend may jump to the callee (tailrec.ax: mark_sibling_calls)
// No object of the caller's frame whose address escaped is alive during the
// call, other than through its own arguments (C's lifetimes, by the block
// scopes: tailrec.mark_frame_dead)
pub const F_FRAME_DEAD: u32 = 0x80000;
// Flags of add, sub, mul and shl (integers): the operation does not overflow
// as a signed (F_NSW) or as an unsigned (F_NUW) operation, as integers of any
// width (for shl: the bits shifted out are copies of the result's sign bit,
// or zeros). A front end sets one only where an overflow would be undefined
// behaviour (C's signed arithmetic) or cannot happen (the step of a range
// loop, an operation checked for overflow before its result is used). Passes
// may then compute what depends on the result differently in the case of an
// overflow: sext(a +nsw b) as sext(a) + sext(b), a counter widened. Moving or
// copying the instruction keeps the flag (where an overflowed result is
// computed speculatively, nothing that matters uses it); a pass that changes
// an operation's operands or operator in place clears it (no_wrap_clear),
// and one that replaces an operation by an equal one keeps only the flags
// both have (no_wrap_meet).
pub const F_NSW: u32 = 8;
pub const F_NUW: u32 = 16;
pub const F_NO_WRAP: u32 = 24;
// Parameter flags
// F_NOALIAS: a pointer parameter whose pointee, while the function runs, is
// not accessed through a pointer that is not based on it when either
// access writes (C's restrict, 6.7.3.1; the front ends set it only where
// the language says so). Passes may then take an access through the
// parameter plus offsets (based_param) as apart from one through another
// parameter, a global or a stack slot (based_param, gvn.may_alias,
// idioms.ax); nothing else (a pointer loaded from memory may be based on
// it). A copy of the function's body elsewhere (inlining) has no
// parameter: the inliner makes the call a restrict scope (IN_RSCOPE).
pub const F_NOALIAS: u32 = 0x10000;
// F_NONNULL: a pointer parameter that is never null when the function is
// called (C's attribute nonnull, a parameter declared `[static n]`: a call
// with a null pointer there is undefined): passes may fold a test of it
// against null (known_nonnull). Not carried to a copy of the body elsewhere.
pub const F_NONNULL: u32 = 0x20000;
// IN_RSCOPE flags: the scope is in a cycle of its function's blocks (as
// opt.rscope_cycles last found: the passes that rely on it find it first)
pub const F_RCYCLE: u32 = 0x40000;
// Alloca flags
pub const F_VAR: u32 = 32;  // a C variable: -O0 keeps it in memory (opt.mem2reg), where debuggers find it
// An fcmp of an ordered relation (<, <=, >, >=) that signals: "invalid" for
// any NaN operand, quiet or signaling (IEEE 754's compareSignaling: C's
// relational operators, F.9.3), where the plain one does for a signaling
// NaN only (isless ...)
pub const F_SIGNALING: u32 = 64;

// Def-use lists. Each instruction in a block of its function is on the
// lists of uses of the instructions it reads (it is registered): its
// operands a, b and c through the places ua, ub and uc in it, the operands
// in xs through those in xu. A value's list (first_use, then Use.next) has
// a place for each operand that reads it, nuses of them, in no particular
// order; values other than instructions (constants, parameters, globals)
// have none. An instruction is registered when it goes into a block that is
// in its function's list (insert_before, append_inst) and taken off when it
// leaves (remove_inst, remove_block), so the uses are those that walking
// the function would count. Operands of a registered instruction change
// only through set_a, set_b, set_c, set_x, push_x, ... (which keep the
// lists); those of one out of a block may be set directly, until it goes in.
pub struct Use {
    pub next: *mut Use,
    // the address of what points here (the value's first_use or the previous
    // place's next), with which operand this is in its low two bits: 0 a,
    // 1 b, 2 c (a place in the user itself), 3 one of xs (an XUse); 0 when
    // the place is on no list
    back: usize,
}

// The place of one of an instruction's xs on a list of uses.
pub struct XUse {
    u: Use,
    user: *mut Value,
}

pub struct Value {
    // the fields every walk over the IR reads come first (two cache lines)
    pub kind: ValueKind,
    replaced: bool,  // forwarded to another value (resolve(): the table REPL)
    pub op: i32,
    pub ty: *mut Ty,
    pub a: *mut Value,
    pub b: *mut Value,
    pub c: *mut Value,
    pub xs: u.List.[*mut Value],
    pub next: *mut Value,
    pub prev: *mut Value,
    pub blk: *mut Block,
    pub flags: u32,
    pub first_use: *mut Use,  // its uses (instructions only: see Use)
    ua: Use,                  // the places of a, b and c on their lists of uses (registered instructions)
    ub: Use,
    uc: Use,
    xu: *mut XUse,   // those of xs (xucap & XU_CAP of them)
    pub nuses: i32,  // the number of its uses (first_use's list)
    xucap: u32,      // and XU_REG: registered, on the lists of uses of what it reads
    pub cv: u64,
    pub id: i32,
    pub align: u32,
    pub t1: *mut Block,
    pub t2: *mut Block,
    more: usize,   // a record of what few values have (bs_of, ...), or 0
    pub aux: i64,  // pass / backend scratch
    pub aux2: i64,
    pub auxp: *mut void,
    // backend scratch
    pub pos: i32,  // position in its block
    pub loc: i32,  // local / virtual register
    pub flag: i32,
    pub grave: u32,  // 1 + its index in the graveyard (0: not there)
    pub src: u32,    // where in the source it comes from (src_loc), 0: not known
    pub scope: u32,  // -g: the lexical block it is in (dbginfo.ax's scopes), 0: its function's outermost
}

// The fields of a Value that few values have: phis' and switches' blocks,
// calls' signatures, allocas' types, shuffles' masks, and the constants'
// values and referents. They are in a record (Value.more) only once one of
// them is set, which for most values none ever is: a small one with the
// fields of one group (the blocks of a PHI or SWITCH, a CALL's, an ALLOCA's,
// a SHUFFLE's mask, a constant's, a string's bytes), or, once a value has fields of two
// groups, a ValueMore with all of them. A record starts with its group (an
// operation may change in place: the group, not the op, says what the record
// holds). <field>_of(v) reads one (zero if v has none), set_<field>(v, x)
// sets it (setting zero where there is none makes no record), and
// <field>_mut(v) is its address. Records of dead values are reused.
pub struct VmBlocks {
    g: u8,
    bs: u.List.[*mut Block],  // PHI, SWITCH: the blocks
}

pub struct VmCall {
    g: u8,
    fty: *mut Ty,       // CALL: signature
    ext: []mut u8,      // CALL: argument extension (0 none, 1 zext, 2 sext)
    chain: *mut Chain,  // CALL, native frame tables: the call-site records (see Chain)
}

pub struct VmAlloca {
    g: u8,
    aty: *mut Ty,  // ALLOCA: allocated type
    name: []u8,    // ALLOCA, PARAM: a name for people
}

pub struct VmMask {
    g: u8,
    mask: []mut i32,  // SHUFFLE
}

pub struct VmConst {
    g: u8,
    fv: f64,          // CFP: the value
    gv: *mut Global,  // GLOBAL: the global
    fnp: *mut Func,   // FUNC, PARAM: the function
    name: []u8,       // ALLOCA, PARAM: a name for people
}

pub struct ValueMore {
    g: u8,
    bs: u.List.[*mut Block],  // PHI, SWITCH: the blocks
    fv: f64,                  // CFP: the value
    aty: *mut Ty,             // ALLOCA: allocated type
    fty: *mut Ty,             // CALL: signature
    mask: []mut i32,          // SHUFFLE
    ext: []mut u8,            // CALL: argument extension (0 none, 1 zext, 2 sext)
    gv: *mut Global,          // GLOBAL: the global
    fnp: *mut Func,           // FUNC, PARAM: the function
    name: []u8,               // ALLOCA, PARAM: a name for people
    chain: *mut Chain,        // CALL, native frame tables: the call-site records (see Chain)
    bytes: []u8,              // CSTR: the bytes (the last a NUL)
}

pub struct VmBytes {
    g: u8,
    bytes: []u8,  // CSTR: the bytes (the last a NUL)
}

// Native stack traces from frame tables (codegen.ax: frame_tables): the
// call-site records of a call, innermost first: its own (a trap call has
// none) and then those of the calls inlined around it. The backends write
// an entry mapping the call's return address to them.
pub struct Chain {
    pub site: *mut Value,  // a site record (a constant global)
    pub next: *mut Chain,
    pub c_code: bool,  // the record of a call in C code (whose traces may lose frames at -O2: docs/c.md)
}

pub struct Block {
    pub fnp: *mut Func,
    pub first: *mut Value,
    pub last: *mut Value,
    pub prev: *mut Block,
    pub next: *mut Block,
    pub name: []u8,
    pub preds: u.List.[*mut Block],
    pub idom: *mut Block,
    pub dom_kids: u.List.[*mut Block],
    pub aux: i64,
    pub auxp: *mut void,
    pub mark: i64,  // pass scratch that survives CFG analyses
    // its place in the dominator tree when opt.dominators last ran over its
    // function (run dom_run): it dominates the blocks numbered dom_lo..dom_hi
    pub dom_run: i64,
    // (the small fields last, together: no padding between them)
    pub id: i32,
    pub rpo: i32,
    pub depth: i32,  // dominator tree depth
    pub dom_lo: i32,
    pub dom_hi: i32,
    grave: u32,  // 1 + its index in the graveyard (0: not there)
    pub loop_depth: i32,
    pub split: bool,    // a loop header whose range was split (lopt.split_loops)
    gone: bool,         // taken out of its function (remove_block): its instructions are not registered
    pub guarded: bool,  // a loop that idioms.loop_copies keeps for the case its memmove cannot take
    pub cold: bool,     // seldom run, a front end says (C's __builtin_expect, the attribute cold): laid out apart
    // a loop header: what the program asks of the loop (C's #pragma GCC
    // unroll n, ivdep, novector): unroll_hint 0 nothing, 1 no unrolling, n
    // unrolling by n (unroll.ax); ivdep: no dependence between iterations
    // keeps them from running at once, so a vector loop needs no overlap
    // check; novector: not vectorized (vectorize.ax)
    pub unroll_hint: i32,
    pub ivdep: bool,
    pub novector: bool,
}

pub const LINK_EXTERNAL: i32 = 0;
pub const LINK_INTERNAL: i32 = 1;
pub const LINK_LINKONCE: i32 = 2;  // a definition any unit may repeat; one is kept
pub const LINK_EXTWEAK: i32 = 3;   // a weak reference: 0 when not defined
pub const LINK_WEAK: i32 = 4;

pub struct Func {
    pub name: []u8,
    pub ty: *mut Ty,
    pub linkage: i32,
    pub params: []mut *mut Value,
    pub first: *mut Block,
    pub last: *mut Block,
    pub val: *mut Value,
    pub noreturn: bool,
    pub cold: bool,
    pub noinline: bool,
    pub always_inline: bool,  // an `inline fn` (spec §9.5): inlined wherever it can be
    pub allocator: bool,      // returns (as an integer) memory nothing else points into: std/mem.alloc_bytes
    pub ret_ext: u8,          // 0 none, 1 zext, 2 sext
    pub param_ext: []mut u8,
    pub export_name: []u8,    // wasm export
    pub import_module: []u8,  // wasm import
    pub import_name: []u8,
    pub sret: bool,                  // set by lowering: params[0] is the result address
    pub split: u.List.[*mut Value],  // lowering: aggregate parameters passed as their leaves
    pub nvals: i32,
    pub nblocks: i32,
    pub id: i32,
    pub src: u32,  // its declaration's source location (src_loc)
    pub aux: i64,
    auxp: *mut void,
    fwd_seen: u64,                 // fwd_epoch when apply_forwarding last rewrote f
    pub features: u64,             // the processor extensions its code may use (set when has_features)
    pub has_features: bool,        // otherwise: the target's (--cpu, --features)
    pub coverage: bool,            // --coverage: its blocks get coverage counters (cover.ax)
    pub va_home: bool,             // Windows ARM64: 64 bytes for x0-x7 between the frame record and the stack arguments (a64.ax)
    graves: u.List.[*mut Value],   // values put in the graveyard under it (some since moved on)
    bgraves: u.List.[*mut Block],  // its blocks put there
    // opt.ax's CFG analyses, kept while the CFG stays as it was: every edit
    // of its blocks, their order or their successors counts in cfg_ver
    // (cfg_edit); cfg_key is the count when they were worked out. cfg_have:
    // 1 the predecessor lists, 2 the reverse postorder (cfg_order), 4 the
    // dominator tree
    pub cfg_ver: u64,
    pub cfg_key: u64,
    pub cfg_order: u.List.[*mut Block],
    pub cfg_have: u8,
    cfg_clean: u64,  // cfg_ver + 1 when remove_unreachable last found every block reached
    // calls a function that returns twice (C's setjmp, c/cgen_expr.ax): not
    // optimized (its objects stay in memory, their slots apart), not inlined,
    // no sibling calls or shrink-wrapping (passes.ax, inline.ax, the backends)
    pub returns_twice: bool,
    pub rscopes: bool,   // it has (or had) C's restrict scopes (IN_RSCOPE): the C front end's, the inliner's
    pub hot: bool,       // C's attribute hot: the inliner allows its calls, and the calls in it, twice the size
    pub section: []u8,   // the object file section it goes in (C's attribute section), or empty
    pub align: u64,      // its code's alignment in bytes when more than the target's (C's attribute aligned), or 0
    pub visibility: u8,  // C's attribute visibility (and #pragma GCC visibility): VIS_
    // its floating-point operations read and write the floating-point
    // environment (C's FENV_ACCESS ON or FENV_ROUND, --c-fenv-access: c/cgen.ax):
    // each is done where and as often as the program says, in the rounding
    // mode of that moment, and raises its exceptions, so the passes do not
    // fold, merge, move or remove them (fp_pinned)
    pub strict_fp: bool,
    // what a call of it does besides computing its result, as its
    // declaration promises (FX_: C's attributes const and pure, C23's
    // unsequenced and reproducible; call_fx says when a pass may act on it)
    pub fx: u8,
    // the optimizer's level for it, plus one (C's attribute optimize: the
    // passes over it alone run at that level, passes.level_of; it is not
    // inlined, nor is anything inlined into it, below 2), or 0: the program's
    pub opt_override: u8,
    pub ret_nonnull: bool,  // its result is never a null pointer (C's returns_nonnull): known_nonnull
    // C's alloc_size, alloc_align and assume_aligned: the result's size is
    // the product of parameters size_args[0] - 1 and (when nonzero)
    // size_args[1] - 1, its alignment ret_align, or parameter align_arg - 1
    // (0: none known). Read by the object-size intrinsic's folding (opt.ax)
    // and for the alignment of accesses (gvn.ax)
    pub size_args: [2]i8,
    pub align_arg: i8,
    pub ret_align: u64,
    // [static n] parameters: param_bytes[k] bytes from parameter k's address
    // may be read whenever the function runs (empty: none known); gvn.deref_ok
    pub param_bytes: []mut u64,
    // its code is C's, set by the C front end, cleared where code without
    // them comes in (inlining: inline.ax; loops made of tail calls: tailrec.ax):
    // c_races: a data race is undefined (C11 5.1.2.4p25), unlike Axiom's
    // (spec §12.8.2); c_progress: every loop in it ends, or does I/O, a
    // volatile or atomic access or synchronization (6.8.5p6: each loop is an
    // iteration statement whose controlling expression is not a constant
    // expression; no goto). copies.forward_into builds on them
    pub c_races: bool,
    pub c_progress: bool,
}

// Func.fx: what a call may do. A function with FX_READS or FX_NONE is taken
// to return to its caller (the documented rule of those attributes: a call
// of it is never the last thing the program does), to write no memory that
// exists when it is called, and to have no other observable effect: passes
// may remove a call whose result is unused, take an earlier call's result
// for a later call with the same arguments (FX_READS: when nothing that may
// write memory the callee can see came between them), and move a call out
// of a loop that runs it each time the loop is entered (gvn.ax).
pub const FX_ANY: u8 = 0;    // anything (no promise)
pub const FX_READS: u8 = 1;  // reads memory, writes none (pure, reproducible)
pub const FX_NONE: u8 = 2;   // reads no memory but its arguments' values (const, unsequenced)

// Symbol visibilities (Func.visibility, Global.visibility: the ELF and
// Mach-O meanings; the object writers decide what each target makes of them).
pub const VIS_DEFAULT: u8 = 0;
pub const VIS_HIDDEN: u8 = 1;
pub const VIS_PROTECTED: u8 = 2;
pub const VIS_INTERNAL: u8 = 3;

pub struct Global {
    pub name: []u8,
    pub ty: *mut Ty,
    pub init: *mut Value,  // nil: declaration
    pub linkage: i32,
    pub align: u64,
    pub is_const: bool,
    pub tls: bool,
    pub wasm_global: bool,  // a wasm global (per instance) instead of memory
    pub is_noalias: bool,   // compiler-managed: only accessed by name, never through
                            // a pointer the program computes (the shadow stack)
    pub section: []u8,      // the object file section it goes in (C's attribute section; ELF only), or empty
    pub visibility: u8,     // C's attribute visibility (and #pragma GCC visibility): VIS_
    pub val: *mut Value,
    pub id: i32,
    aux: i64,
}

pub struct Module {
    name: []u8,
    pub funcs: u.List.[*mut Func],
    pub globals: u.List.[*mut Global],
    pub fmap: u.SymMap.[*mut Func],
    pub gmap: u.SymMap.[*mut Global],
    pub frame_tables: bool,  // native stack traces from frame tables (calls' chains)
    // --coverage=afl: the coverage runtime's globals the counters use
    // (cover.ax), or nil
    pub cov_area: *mut Value,
    pub cov_prev: *mut Value,
    // other names of functions and globals (C's attribute alias): each a
    // symbol of its own at its target's place (isel.ax), and a declaration
    // of the name is its target (merge_same_named)
    pub aliases: u.List.[Alias],
}

/// Another name for a function or global (C's attribute alias, a GNU
/// dialect): a symbol `name`, weak or not, of visibility `visibility`
/// (VIS_), at the place of `target` (a function's value or a global's).
pub struct Alias {
    pub name: []u8,
    pub target: *mut Value,
    pub weak: bool,
    pub visibility: u8,
    // an indirect function (C's attribute ifunc): the symbol of the name is
    // of type STT_GNU_IFUNC at the target, its resolver, and the name's
    // declaration is not the target (merge_same_named): its calls and its
    // address are the name's, the resolver's result
    pub ifunc: bool,
}
