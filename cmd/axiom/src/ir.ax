// Native stack traces from frame tables (codegen.ax: frame_tables): the
// call-site records of a call, innermost first: its own (a trap call has
// none) and then those of the calls inlined around it. The backends write
// an entry mapping the call's return address to them.
pub struct Chain {
    site: *mut Value,  // a site record (a constant global)
    next: *mut Chain,
    off: i64,      // backend scratch: the chain's place in the object
    c_code: bool,  // the record of a call in C code (whose traces may lose frames at -O2: docs/c.md)
}

pub fn chain1(site: *mut Value) *mut Chain {
    let c = u.perm_new.[Chain]();
    c.site = site;
    return c;
}

// The records of `a`, then those of `b` (inlining a call with chain `b`
// moves code with chain `a` into the caller).
pub fn chain_cat(a: *mut Chain, b: *mut Chain) *mut Chain {
    if u.isnil(a) {
        return b;
    }
    if u.isnil(b) {
        return a;
    }
    let c = chain1(a.site);
    c.c_code = a.c_code;
    c.next = chain_cat(a.next, b);
    return c;
}

pub struct Block {
    fnp: *mut Func,
    first: *mut Value,
    last: *mut Value,
    prev: *mut Block,
    next: *mut Block,
    name: []u8,
    preds: u.List.[*mut Block],
    idom: *mut Block,
    dom_kids: u.List.[*mut Block],
    aux: i64,
    auxp: *mut void,
    mark: i64,  // pass scratch that survives CFG analyses
    // (the small fields last, together: no padding between them)
    id: i32,
    rpo: i32,
    depth: i32,  // dominator tree depth
    // its place in the dominator tree when opt.dominators last ran over its
    // function (run dom_run): it dominates the blocks numbered dom_lo..dom_hi
    dom_lo: i32,
    dom_hi: i32,
    dom_run: i32,
    grave: u32,  // 1 + its index in the graveyard (0: not there)
    loop_depth: i32,
    split: bool,    // a loop header whose range was split (gvn.split_loops)
    guarded: bool,  // a loop that idioms.loop_copies keeps for the case its memmove cannot take
    cold: bool,     // seldom run, a front end says (C's __builtin_expect, the attribute cold): laid out apart
}

pub const LINK_EXTERNAL: i32 = 0;
pub const LINK_INTERNAL: i32 = 1;
pub const LINK_LINKONCE: i32 = 2;  // a definition any unit may repeat; one is kept
pub const LINK_EXTWEAK: i32 = 3;   // a weak reference: 0 when not defined
pub const LINK_WEAK: i32 = 4;

pub struct Func {
    name: []u8,
    ty: *mut Ty,
    linkage: i32,
    params: []mut *mut Value,
    first: *mut Block,
    last: *mut Block,
    val: *mut Value,
    noreturn: bool,
    cold: bool,
    noinline: bool,
    always_inline: bool,  // an `inline fn` (spec §9.5): inlined wherever it can be
    allocator: bool,      // returns (as an integer) memory nothing else points into: std/mem.alloc_bytes
    ret_ext: u8,          // 0 none, 1 zext, 2 sext
    param_ext: []mut u8,
    export_name: []u8,    // wasm export
    import_module: []u8,  // wasm import
    import_name: []u8,
    sret: bool,                  // set by lowering: params[0] is the result address
    split: u.List.[*mut Value],  // lowering: aggregate parameters passed as their leaves
    nvals: i32,
    nblocks: i32,
    id: i32,
    src: u32,  // its declaration's source location (src_loc)
    aux: i64,
    auxp: *mut void,
    fwd_seen: u64,                 // fwd_epoch when apply_forwarding last rewrote f
    features: u64,                 // the processor extensions its code may use (set when has_features)
    has_features: bool,            // otherwise: the target's (--cpu, --features)
    coverage: bool,                // --coverage: its blocks get coverage counters (cover.ax)
    va_home: bool,                 // Windows ARM64: 64 bytes for x0-x7 between the frame record and the stack arguments (a64.ax)
    graves: u.List.[*mut Value],   // values put in the graveyard under it (some since moved on)
    bgraves: u.List.[*mut Block],  // its blocks put there
    // calls a function that returns twice (C's setjmp, c/cgen_expr.ax): not
    // optimized (its objects stay in memory, their slots apart), not inlined,
    // no sibling calls or shrink-wrapping (passes.ax, inline.ax, the backends)
    returns_twice: bool,
    hot: bool,       // C's attribute hot: the inliner allows its calls, and the calls in it, twice the size
    section: []u8,   // the object file section it goes in (C's attribute section), or empty
    visibility: u8,  // C's attribute visibility (and #pragma GCC visibility): VIS_
    // its floating-point operations read and write the floating-point
    // environment (C's FENV_ACCESS ON or FENV_ROUND, --c-fenv-access: c/cgen.ax):
    // each is done where and as often as the program says, in the rounding
    // mode of that moment, and raises its exceptions, so the passes do not
    // fold, merge, move or remove them (fp_pinned)
    strict_fp: bool,
    // what a call of it does besides computing its result, as its
    // declaration promises (FX_: C's attributes const and pure, C23's
    // unsequenced and reproducible; call_fx says when a pass may act on it)
    fx: u8,
    // the optimizer's level for it, plus one (C's attribute optimize: the
    // passes over it alone run at that level, passes.level_of; it is not
    // inlined, nor is anything inlined into it, below 2), or 0: the program's
    opt_override: u8,
    ret_nonnull: bool,  // its result is never a null pointer (C's returns_nonnull): known_nonnull
    // C's alloc_size, alloc_align and assume_aligned: the result's size is
    // the product of parameters size_args[0] - 1 and (when nonzero)
    // size_args[1] - 1, its alignment ret_align, or parameter align_arg - 1
    // (0: none known). Read by the object-size intrinsic's folding (opt.ax)
    // and for the alignment of accesses (gvn.ax)
    size_args: [2]i8,
    align_arg: i8,
    ret_align: u64,
    // [static n] parameters: param_bytes[k] bytes from parameter k's address
    // may be read whenever the function runs (empty: none known); gvn.deref_ok
    param_bytes: []mut u64,
}

// Func.fx: what a call may do. A function with FX_READS or FX_NONE is taken
// to return to its caller (the documented rule of those attributes: a call
// of it is never the last thing the program does), to write no memory that
// exists when it is called, and to have no other observable effect: passes
// may remove a call whose result is unused, take an earlier call's result
// for a later call with the same arguments (FX_READS: when nothing that may
// write memory the callee can see came between them), and move a call out
// of a loop that runs it each time the loop is entered (gvn.ax).
pub const FX_ANY: u8 = 0;    // anything (no promise)
pub const FX_READS: u8 = 1;  // reads memory, writes none (pure, reproducible)
pub const FX_NONE: u8 = 2;   // reads no memory but its arguments' values (const, unsequenced)

// Symbol visibilities (Func.visibility, Global.visibility: the ELF and
// Mach-O meanings; the object writers decide what each target makes of them).
pub const VIS_DEFAULT: u8 = 0;
pub const VIS_HIDDEN: u8 = 1;
pub const VIS_PROTECTED: u8 = 2;
pub const VIS_INTERNAL: u8 = 3;

pub struct Global {
    name: []u8,
    ty: *mut Ty,
    init: *mut Value,  // nil: declaration
    linkage: i32,
    align: u64,
    is_const: bool,
    tls: bool,
    wasm_global: bool,  // a wasm global (per instance) instead of memory
    noalias: bool,      // compiler-managed: only accessed by name, never through
                        // a pointer the program computes (the shadow stack)
    section: []u8,      // the object file section it goes in (C's attribute section; ELF only), or empty
    visibility: u8,     // C's attribute visibility (and #pragma GCC visibility): VIS_
    val: *mut Value,
    id: i32,
    aux: i64,
}

pub struct Module {
    name: []u8,
    funcs: u.List.[*mut Func],
    globals: u.List.[*mut Global],
    fmap: u.SymMap.[*mut Func],
    gmap: u.SymMap.[*mut Global],
    frame_tables: bool,  // native stack traces from frame tables (calls' chains)
    // --coverage=afl: the coverage runtime's globals the counters use
    // (cover.ax), or nil
    cov_area: *mut Value,
    cov_prev: *mut Value,
    // other names of functions and globals (C's attribute alias): each a
    // symbol of its own at its target's place (isel.ax), and a declaration
    // of the name is its target (merge_same_named)
    aliases: u.List.[Alias],
}

/// Another name for a function or global (C's attribute alias, a GNU
/// dialect): a symbol `name`, weak or not, of visibility `visibility`
/// (VIS_), at the place of `target` (a function's value or a global's).
pub struct Alias {
    name: []u8,
    target: *mut Value,
    weak: bool,
    visibility: u8,
}

/// Adds alias `name` of `target` to m.
pub fn add_alias(m: *mut Module, name: []u8, target: *mut Value, weak: bool, visibility: u8) void {
    m.aliases.push(Alias.{ name: u.intern(name), target: target, weak: weak, visibility: visibility });
}

/// The function an alias names, or nil (it names a global, or a definition
/// of its name overrides it: a weak alias).
pub fn alias_func(m: *mut Module, a: *Alias) *mut Func {
    if (a.target.kind != V_FUNC) or alias_overridden(m, a) {
        return u.nil.[Func]();
    }
    return fnp_of(a.target);
}

/// The global an alias names, or nil (likewise).
pub fn alias_global(m: *mut Module, a: *Alias) *mut Global {
    if (a.target.kind != V_GLOBAL) or alias_overridden(m, a) {
        return u.nil.[Global]();
    }
    return gv_of(a.target);
}

// Is a weak alias's name defined otherwise (a strong definition wins)?
fn alias_overridden(m: *mut Module, a: *Alias) bool {
    if not a.weak {
        return false;
    }
    let f = m.fmap.get(a.name);
    if u.notnil(f) and not is_decl(f) {
        return true;
    }
    let g = m.gmap.get(a.name);
    return u.notnil(g) and u.notnil(g.init);
}

pub fn vnil() *mut Value {
    return u.nil.[Value]();
}

pub fn bnil() *mut Block {
    return u.nil.[Block]();
}

fn new_val(k: ValueKind, t: *mut Ty) *mut Value {
    let mut v = vnil();
    if free_vals.len > 0 {
        v = free_vals.pop();
        @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, v), @size_of(Value)), 0);
    } else {
        v = u.perm_new.[Value]();
    }
    v.kind = k;
    v.ty = t;
    return v;
}

// (The IR is allocated with perm_alloc (perm_new, perm_newn, perm_dup): it
// outlives the code generator's memory, which util.tree_default gives back.)

// -----------------------------------------------------------------------------
// Recycling. Instructions and blocks taken out of a function go to a
// graveyard with their function: they may be put back (moved) or be dead.
// recycle(f), called where no pass is at work on f, takes the dead ones
// (still out, with the instructions of dead blocks) for new values and
// blocks to reuse, and frees their lists. Passes delete most of what they
// make, so without this the IR of a build is mostly garbage. With
// AXIOM_POISON, dead values and blocks are filled with 0xA5 instead and
// never reused.
// -----------------------------------------------------------------------------
let mut grave_v: u.List.[*mut Value] = u.List.[*mut Value].{ data: @ptr_from_int(*mut *mut Value, 0), len: 0, cap: 0 };
let mut grave_vf: u.List.[*mut Func] = u.List.[*mut Func].{ data: @ptr_from_int(*mut *mut Func, 0), len: 0, cap: 0 };
let mut grave_b: u.List.[*mut Block] = u.List.[*mut Block].{ data: @ptr_from_int(*mut *mut Block, 0), len: 0, cap: 0 };
let mut free_vals: u.List.[*mut Value] = u.List.[*mut Value].{ data: @ptr_from_int(*mut *mut Value, 0), len: 0,
                                                               cap: 0 };
let mut free_blocks: u.List.[*mut Block] = u.List.[*mut Block].{ data: @ptr_from_int(*mut *mut Block, 0), len: 0,
                                                                 cap: 0 };

fn bury_value(v: *mut Value) void {
    if v.grave != 0 {
        // (an instruction of a dead block that had been moved before)
        let k = @as(usize, v.grave - 1);
        let last = grave_v.get(grave_v.len - 1);
        grave_v.set(k, last);
        grave_vf.set(k, grave_vf.get(grave_vf.len - 1));
        last.grave = v.grave;
        grave_v.len -= 1;
        grave_vf.len -= 1;
        v.grave = 0;
    }
    if dbg_on {
        dbg_buried(v);
        _ = dbg_take(v);
    }
    v.xs.deinit();
    release_more(v);
    if u.poisoning() {
        @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, v), @size_of(Value)), 0xA5);
        return;
    }
    free_vals.push(v);
}

// Gives back the lists of f's instructions and blocks, once its code is made
// and the function is not read again.
pub fn release_lists(f: *mut Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.xs.deinit();
            i.xs = u.List.[*mut Value].empty();
            i = i.next;
        }
        b.preds.deinit();
        b.preds = u.List.[*mut Block].empty();
        b.dom_kids.deinit();
        b.dom_kids = u.List.[*mut Block].empty();
        b = b.next;
    }
}

fn bury_block(b: *mut Block) void {
    if dbg_on {
        _ = mk_block_take(b);
    }
    let mut i = b.first;
    while u.notnil(i) {
        let next = i.next;
        bury_value(i);
        i = next;
    }
    b.preds.deinit();
    b.dom_kids.deinit();
    if u.poisoning() {
        @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, b), @size_of(Block)), 0xA5);
        return;
    }
    free_blocks.push(b);
}

// Each value or block is in the graveyard once, under the function it was
// last taken out of (a value may move between functions, and in and out
// of blocks, before it dies).
fn to_grave(v: *mut Value, f: *mut Func) void {
    if v.grave != 0 {
        let k = @as(usize, v.grave - 1);
        if grave_vf.get(k) != f {
            grave_vf.set(k, f);
            f.graves.push(v);
        }
        return;
    }
    grave_v.push(v);
    grave_vf.push(f);
    v.grave = @truncate(u32, grave_v.len);
    f.graves.push(v);
}

fn block_to_grave(b: *mut Block) void {
    if b.grave != 0 {
        return;
    }
    grave_b.push(b);
    b.grave = @truncate(u32, grave_b.len);
    b.fnp.bgraves.push(b);
}

// The places in the graveyard of f's entries (from f's lists, which may
// name entries that have since moved on or gone), in order.
fn grave_places(vs: *mut u.List.[*mut Value], bs: *mut u.List.[*mut Block], f: *mut Func) u.List.[usize] {
    let mut pos = u.List.[usize].empty();
    for k in 0..vs.len {
        let v = vs.get(k);
        let x = @as(usize, v.grave) -% 1;  // (a buried value may be poison)
        if (x < grave_v.len) and (grave_v.get(x) == v) and (grave_vf.get(x) == f) {
            pos.push(x);
        }
    }
    for k in 0..bs.len {
        let b = bs.get(k);
        let x = @as(usize, b.grave) -% 1;
        if (x < grave_b.len) and (grave_b.get(x) == b) and (b.fnp == f) {
            pos.push(x);
        }
    }
    vs.clear();
    bs.clear();
    u.sort_usize(pos.items());
    let mut n: usize = 0;
    for k in 0..pos.len {
        if (n == 0) or (pos.get(n - 1) != pos.get(k)) {
            pos.set(n, pos.get(k));
            n += 1;
        }
    }
    pos.len = n;
    return pos;
}

// Takes f's entries out of the graveyard in the order a scan from the start
// would (each taken out with the last entry moved into its place, which is
// looked at again), going only to the places of f's entries.
pub fn recycle(f: *mut Func) void {
    // (operands still reaching a dead value through its fwd go straight on)
    apply_forwarding(f);
    let mut nob = u.List.[*mut Block].empty();
    let pv = grave_places(&mut f.graves, &mut nob, f);
    let mut i: usize = 0;
    let mut j: usize = pv.len;  // pv[i..j]: the places still holding f's entries
    while i < j {
        let k = pv.get(i);
        let v = grave_v.get(k);
        let lastk = grave_v.len - 1;
        let last = grave_v.get(lastk);
        grave_v.set(k, last);
        grave_vf.set(k, grave_vf.get(lastk));
        last.grave = @truncate(u32, k + 1);
        grave_v.len -= 1;
        grave_vf.len -= 1;
        v.grave = 0;
        if u.isnil(v.blk) {
            bury_value(v);
        }
        if pv.get(j - 1) == lastk {
            // (f's last entry, now at k: next; or the one just taken out)
            j -= 1;
        } else {
            i += 1;
        }
    }
    pv.deinit();
    let mut nov = u.List.[*mut Value].empty();
    let pb = grave_places(&mut nov, &mut f.bgraves, f);
    i = 0;
    j = pb.len;
    while i < j {
        let k = pb.get(i);
        let b = grave_b.get(k);
        let lastk = grave_b.len - 1;
        let last = grave_b.get(lastk);
        grave_b.set(k, last);
        last.grave = @truncate(u32, k + 1);
        grave_b.len -= 1;
        b.grave = 0;
        if u.isnil(b.prev) and u.isnil(b.next) and (f.first != b) {
            bury_block(b);
        }
        if pb.get(j - 1) == lastk {
            j -= 1;
        } else {
            i += 1;
        }
    }
    pb.deinit();
}

// -----------------------------------------------------------------------------
// Constants
// -----------------------------------------------------------------------------
pub fn mask_bits(bits: i32) u64 {
    if bits >= 64 {
        return 0xFFFF_FFFF_FFFF_FFFF;
    }
    return (@as(u64, 1) << @int_cast(u32, bits)) - 1;
}

// The constant's value sign-extended from its width.
pub fn sval(v: *Value) i64 {
    let bits = v.ty.bits;
    if bits >= 64 {
        return @bit_cast(i64, v.cv);
    }
    let sh = @int_cast(u32, 64 - bits);
    return @bit_cast(i64, v.cv << sh) >> sh;
}

// Integer constants are shared: one Value per type and value, in permanent
// memory. Nothing changes a constant once made (passes and backends write
// their scratch fields on instructions only), and folding makes them by the
// million.
struct CintTable {
    tys: *mut usize,
    vals: *mut u64,
    cs: *mut *mut Value,
    cap: usize,
    len: usize,
}

let mut CINTS: CintTable = CintTable.{ tys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u64, 0),
                                       cs: @ptr_from_int(*mut *mut Value, 0), cap: 0, len: 0 };

fn cint_slot(tys: []usize, vals: []u64, t: usize, v: u64) usize {
    let mask = tys.len - 1;
    let mut j = @truncate(usize, ((@as(u64, t) *% 0x9E3779B97F4A7C15) ^ (v *% 0xC2B2AE3D27D4EB4F)) >> 17) & mask;
    while (tys[j] != 0) and not ((tys[j] == t) and (vals[j] == v)) {
        j = (j + 1) & mask;
    }
    return j;
}

fn cint_grow() void {
    let mut n: usize = 4096;
    if CINTS.cap != 0 {
        n = CINTS.cap * 2;
    }
    let tys = u.calloc_slice.[usize](n);
    let vals = u.calloc_slice.[u64](n);
    let cs = u.calloc_slice.[*mut Value](n);
    let ot = @slice_from_ptr(CINTS.tys, CINTS.cap);
    let ov = @slice_from_ptr(CINTS.vals, CINTS.cap);
    let oc = @slice_from_ptr(CINTS.cs, CINTS.cap);
    for k in 0..CINTS.cap {
        if ot[k] != 0 {
            let j = cint_slot(tys, vals, ot[k], ov[k]);
            tys[j] = ot[k];
            vals[j] = ov[k];
            cs[j] = oc[k];
        }
    }
    u.free_slice.[usize](ot);
    u.free_slice.[u64](ov);
    u.free_slice.[*mut Value](oc);
    CINTS.tys = tys.ptr;
    CINTS.vals = vals.ptr;
    CINTS.cs = cs.ptr;
    CINTS.cap = n;
}

pub fn cint(t: *mut Ty, v: u64) *mut Value {
    let x = v & mask_bits(t.bits);
    if (CINTS.len + 1) * 2 > CINTS.cap {
        cint_grow();
    }
    let tys = @slice_from_ptr(CINTS.tys, CINTS.cap);
    let vals = @slice_from_ptr(CINTS.vals, CINTS.cap);
    let cs = @slice_from_ptr(CINTS.cs, CINTS.cap);
    let key = @int_from_ptr(t);
    let j = cint_slot(tys, vals, key, x);
    if tys[j] != 0 {
        return cs[j];
    }
    // (shared by every function: outside any scratch scope)
    let c = u.perm_new.[Value]();
    c.kind = V_CINT;
    c.ty = t;
    c.cv = x;
    tys[j] = key;
    vals[j] = x;
    cs[j] = c;
    CINTS.len += 1;
    return c;
}

// Debugging (AXIOM_CHECK_CINTS): that no constant was changed.
pub fn check_cints() void {
    let tys = @slice_from_ptr(CINTS.tys, CINTS.cap);
    let vals = @slice_from_ptr(CINTS.vals, CINTS.cap);
    let cs = @slice_from_ptr(CINTS.cs, CINTS.cap);
    let mut bad: usize = 0;
    for k in 0..CINTS.cap {
        if tys[k] == 0 {
            continue;
        }
        let c = cs[k];
        if (c.kind != V_CINT) or (@int_from_ptr(c.ty) != tys[k]) or (c.cv != vals[k]) or u.notnil(c.fwd) or
           u.notnil(c.a) or (c.xs.len != 0) or u.notnil(c.blk) or u.notnil(c.next) {
            bad += 1;
        }
    }
    u.eprint(u.f2("cints: %s, changed: %s\n", u.zdec(CINTS.len), u.zdec(bad)));
}

// Debugging (AXIOM_CHECK_IR): that each instruction's operands from its own
// block (but a phi's, and allocas, which are the frame's) come before it;
// stops at the first that does not.
pub fn check_order(m: *mut Module) void {
    for fi in 0..m.funcs.len {
        let f = m.funcs.get(fi);
        let mut b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                i.pos = 1;  // (not reached yet)
                i = i.next;
            }
            i = b.first;
            while u.notnil(i) {
                if i.op != OP_PHI {
                    check_operand(f, i, i.a);
                    check_operand(f, i, i.b);
                    check_operand(f, i, i.c);
                    for k in 0..i.xs.len {
                        check_operand(f, i, i.xs.get(k));
                    }
                }
                i.pos = 0;
                i = i.next;
            }
            b = b.next;
        }
    }
}

fn check_operand(f: *Func, i: *Value, x0: *mut Value) void {
    if u.isnil(x0) {
        return;
    }
    let x = resolve(x0);
    if (x.kind == V_INST) and (x.blk == i.blk) and (x.pos != 0) and (x.op != OP_ALLOCA) {
        u.die(u.f3("%s: %s before %s", f.name, inst_str(i), inst_str(x)));
    }
}

pub fn ci32(v: u64) *mut Value {
    return cint(t_int(32), v);
}

/// The bits of the float whose value the double x is (a float's value
/// widened, or rounded to float): a NaN keeps its sign, its quiet bit and
/// the top of its payload, so that a signaling one stays one (which a
/// conversion would quiet).
pub fn f32_bits(x: f64) u32 {
    let b = @bit_cast(u64, x);
    if (((b >> 52) & 0x7FF) == 0x7FF) and ((b << 12) != 0) {
        let mut fr = (b >> 29) & 0x7F_FFFF;
        if fr == 0 {
            fr = 0x40_0000;  // (a payload below float's: a quiet NaN)
        }
        return @truncate(u32, (((b >> 63) << 31) | 0x7F80_0000) | fr);
    }
    return @bit_cast(u32, @float_cast(f32, x));
}

/// The float with bits b, widened to double the same way (f32_bits's inverse).
pub fn f32_value(b: u32) f64 {
    if ((b & 0x7F80_0000) == 0x7F80_0000) and ((b & 0x7F_FFFF) != 0) {
        let w = (@as(u64, b >> 31) << 63) | 0x7FF0_0000_0000_0000 | (@as(u64, b & 0x7F_FFFF) << 29);
        return @bit_cast(f64, w);
    }
    return @float_cast(f64, @bit_cast(f32, b));
}

pub fn cfp(t: *mut Ty, x: f64) *mut Value {
    let c = new_val(V_CFP, t);
    if t.bits == 32 {
        set_fv(c, f32_value(f32_bits(x)));
    } else {
        set_fv(c, x);
    }
    return c;
}

pub fn czero(t: *mut Ty) *mut Value {
    if t.kind == T_INT {
        return cint(t, 0);
    }
    return new_val(V_ZERO, t);
}

pub fn cones(t: *mut Ty) *mut Value {
    if t.kind == T_VEC {
        let n = @int_cast(usize, t.lanes);
        let xs = u.perm_newn.[*mut Value](n);
        for i in 0..n {
            xs[i] = cint(t.elem, 0xFFFF_FFFF_FFFF_FFFF);
        }
        return cagg(t, xs);
    }
    return cint(t, 0xFFFF_FFFF_FFFF_FFFF);
}

// One undef per type, shared as integer constants are.
pub fn undef(t: *mut Ty) *mut Value {
    if u.isnil(t.undef_v) {
        let v = u.perm_new.[Value]();
        v.kind = V_UNDEF;
        v.ty = t;
        t.undef_v = v;
    }
    return t.undef_v;
}

pub fn cagg(t: *mut Ty, xs: []mut *mut Value) *mut Value {
    let c = new_val(V_CAGG, t);
    c.xs.reserve(xs.len);
    for x in xs {
        c.xs.push(x);
    }
    return c;
}

pub fn cstruct(xs: []mut *mut Value) *mut Value {
    let ts = u.perm_newn.[*mut Ty](xs.len + 1);
    for i in 0..xs.len {
        ts[i] = xs[i].ty;
    }
    return cagg(t_struct(ts[0..xs.len]), xs);
}

pub fn carray(el: *mut Ty, xs: []mut *mut Value) *mut Value {
    return cagg(t_array(el, @as(u64, xs.len)), xs);
}

// The bytes of `s` followed by a NUL, as an [n+1 x i8] constant: a V_CSTR,
// which holds them as bytes (not as a V_CAGG of byte constants, eight bytes
// a byte); agg_len and agg_elem read either.
pub fn cstring(s: []u8) *mut Value {
    let c = new_val(V_CSTR, t_array(t_int(8), @as(u64, s.len) + 1));
    let b = u.perm_newn.[u8](s.len + 1);
    @mem_copy(b[0..s.len], s);
    b[s.len] = 0;
    set_bytes(c, b);
    return c;
}

// Is v a constant aggregate whose elements agg_elem reads?
pub fn is_cagg(v: *Value) bool {
    return (v.kind == V_CAGG) or (v.kind == V_CSTR);
}

// The number of elements of a constant aggregate (V_CAGG or V_CSTR).
pub fn agg_len(v: *Value) usize {
    if v.kind == V_CSTR {
        return bytes_of(v).len;
    }
    return v.xs.len;
}

// Element i of a constant aggregate (V_CAGG or V_CSTR).
pub fn agg_elem(v: *Value, i: usize) *mut Value {
    if v.kind == V_CSTR {
        return cint(t_int(8), @as(u64, bytes_of(v)[i]));
    }
    return v.xs.get(i);
}

pub fn cinttoptr(v: *mut Value) *mut Value {
    if (v.kind == V_CINT) and (v.cv == 0) {
        return czero(t_ptr());
    }
    return cint(t_ptr(), v.cv);
}

// The address of global g plus `off` bytes, for the initial values of
// globals only (data: a relocation with an addend; C's address constants):
// a V_GLOBAL whose cv is the addend. (Code reaches g + off with ptradd.)
pub fn cgaddr(g: *mut Global, off: u64) *mut Value {
    if off == 0 {
        return g.val;
    }
    let v = new_val(V_GLOBAL, t_ptr());
    set_gv(v, g);
    v.cv = off;
    return v;
}

pub fn is_const(v: *Value) bool {
    return (v.kind != V_INST) and (v.kind != V_PARAM);
}

// The address of a thread-local: a constant in a function (the running
// thread's copy), but not one data can hold (a relocation there is to the
// initial image), so no constant aggregate has one.
pub fn is_tls_addr(v: *Value) bool {
    return (v.kind == V_GLOBAL) and gv_of(v).tls;
}

// An integer (or null pointer) constant.
pub fn is_cint(v: *Value) bool {
    return (v.kind == V_CINT) or ((v.kind == V_ZERO) and ((v.ty.kind == T_INT) or (v.ty.kind == T_PTR)));
}

// An integer constant of at most 64 bits (not a pointer).
pub fn is_small_cint(v: *Value) bool {
    return is_cint(v) and (v.ty.kind == T_INT) and (v.ty.bits <= 64);
}

// The i1 constant b.
pub fn kbool(b: bool) *mut Value {
    if b {
        return cint(t_int(1), 1);
    }
    return cint(t_int(1), 0);
}

pub fn cint_val(v: *Value) u64 {
    if v.kind == V_CINT {
        return v.cv;
    }
    return 0;
}

pub fn is_zero(v: *Value) bool {
    if v.kind == V_ZERO {
        return true;
    }
    if v.kind == V_CINT {
        return v.cv == 0;
    }
    if v.kind == V_CFP {
        return (fv_of(v) == 0.0) and (@bit_cast(u64, fv_of(v)) == 0);
    }
    if v.kind == V_CAGG {
        for i in 0..v.xs.len {
            if not is_zero(v.xs.get(i)) {
                return false;
            }
        }
        return true;
    }
    if v.kind == V_CSTR {
        for c in bytes_of(v) {
            if c != 0 {
                return false;
            }
        }
        return true;
    }
    return false;
}

// -----------------------------------------------------------------------------
// Module, functions, globals
// -----------------------------------------------------------------------------
pub fn new_module(name: []u8) *mut Module {
    let m = u.perm_new.[Module]();
    m.name = u.perm_dup(name);
    return m;
}

pub fn add_function(m: *mut Module, name: []u8, fty: *mut Ty) *mut Func {
    let f = u.perm_new.[Func]();
    f.name = u.intern(name);
    f.ty = fty;
    f.id = @int_cast(i32, m.funcs.len);
    let n = fty.params.len;
    f.params = u.perm_newn.[*mut Value](n + 1)[0..n];
    for i in 0..n {
        let p = new_val(V_PARAM, fty.params[i]);
        p.cv = @as(u64, i);
        set_fnp(p, f);
        f.params[i] = p;
    }
    f.param_ext = u.perm_newn.[u8](n + 1)[0..n];
    let fv = new_val(V_FUNC, t_ptr());
    set_fnp(fv, f);
    f.val = fv;
    m.funcs.push(f);
    if not m.fmap.has(f.name) {
        m.fmap.put(f.name, f);
    }
    return f;
}

/// Gives declaration f the signature fty, with new parameters for it (a
/// declaration made for one language's calls that the other defines: C and
/// Axiom in one program).
pub fn retype_decl(f: *mut Func, fty: *mut Ty) void {
    f.ty = fty;
    let n = fty.params.len;
    if (f.params.len == n) and (f.param_ext.len == n) {
        for i in 0..n {
            f.params[i].ty = fty.params[i];
        }
        return;
    }
    f.params = u.perm_newn.[*mut Value](n + 1)[0..n];
    for i in 0..n {
        f.params[i] = new_param(f, fty.params[i], i);
    }
    f.param_ext = u.perm_newn.[u8](n + 1)[0..n];
}

pub fn new_param(f: *mut Func, t: *mut Ty, idx: usize) *mut Value {
    let p = new_val(V_PARAM, t);
    p.cv = @as(u64, idx);
    set_fnp(p, f);
    return p;
}

// The value `v` stands for after replacements.
pub fn resolve(v: *mut Value) *mut Value {
    let mut x = v;
    while u.notnil(x) and u.notnil(x.fwd) {
        x = x.fwd;
    }
    return x;
}

// Bumped whenever a value is forwarded: a function that apply_forwarding
// has rewritten since then has no operand to rewrite.
let mut fwd_epoch: u64 = 1;

// Forwards v's uses to r (or, with r nil, stops forwarding them).
pub fn forward(v: *mut Value, r: *mut Value) void {
    v.fwd = r;
    fwd_epoch += 1;
    if dbg_on and u.notnil(r) {
        dbg_replace(v, r);  // (nil: forwarding stops, v is v again)
    }
}

// -----------------------------------------------------------------------------
// Debug information of optimized code (-g, -O1 and up: dbginfo.ax): the
// values the variables are given (the marks below; the stores of those left
// in memory), followed as passes replace them (a forwarded value's role
// goes to its replacement: the same value where it is used), through a
// value folded away to the value it was a constant away from, and given up
// when one is dead. An alloca that takes another's place (sharing a slot, a
// copy made the same object) is marked: its memory holds another
// variable's contents too. Values are told apart by their ids (a dead
// value's memory is reused, an id is not).
// -----------------------------------------------------------------------------
pub struct DbgRef {
    v: *mut Value,  // nil: given up
    id: i32,
    low: bool,  // what it stands for is the low bits of v (a counter widened: loops.ax)
    add: i64,   // what it stands for is v + add (a value folded away: dbg_buried)
    alt: i32,   // v as another entry's value plus a constant, or its low bits (dbg_alt; -1: none)
    next: i32,  // the next entry following the same value (-1: none)
}

pub let mut dbg_on: bool = false;
// Inlining records where inlined code came from (inline.ax: the inline
// instances of dbginfo.ax's scopes, in Value.scope): with any debug
// information (line tables too, which crash traces read the chain from).
pub let mut dbg_scopes: bool = false;
pub let mut dbg_refs: u.List.[DbgRef] = u.List.[DbgRef].{ data: @ptr_from_int(*mut DbgRef, 0), len: 0, cap: 0 };
// an instruction (its address) -> the first entry of dbg_refs following it + 1
let mut dbg_at: u.SymMap.[i32] = u.SymMap.[i32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0),
                                                  cap: 0, len: 0 };
// an alloca (its address) -> its id + 1, if another's uses went to it
let mut dbg_merged: u.SymMap.[i32] = u.SymMap.[i32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0), cap: 0, len: 0 };

fn dbg_key(v: *Value) []u8 {
    return u.addr_key(@int_from_ptr(v));
}

/// Follows value v (an instruction or a constant) for the debug
/// information: its index in dbg_refs.
pub fn dbg_track(v: *mut Value) i32 {
    let k = @int_cast(i32, dbg_refs.len);
    dbg_refs.push(DbgRef.{ v: v, id: v.id, low: false, add: 0, alt: -1, next: -1 });
    dbg_link(k, v);
    return k;
}

fn dbg_link(k: i32, v: *mut Value) void {
    if (v.kind == V_INST) or (v.kind == V_PARAM) {
        let key = dbg_key(v);
        dbg_refs.at(@int_cast(usize, k)).next = dbg_at.get(key) - 1;
        dbg_at.put(key, k + 1);
    }
}

/// Is the instruction dbg_refs[k] follows still where it was (in a block,
/// not dead)?
pub fn dbg_present(k: i32) bool {
    let r = dbg_refs.get(@int_cast(usize, k));
    return u.notnil(r.v) and (r.v.kind == V_INST) and (r.v.id == r.id) and (r.v.grave == 0) and u.notnil(r.v.blk);
}

/// Has alloca a (whose id is id) taken another's place (dbg_merged)?
pub fn dbg_was_merged(a: *Value, id: i32) bool {
    return dbg_merged.get(dbg_key(a)) == id + 1;
}

// The entries following v: each one's v and id are v's still (the others,
// stale, leave the chain).
fn dbg_chain(v: *Value) i32 {
    if ((v.kind != V_INST) and (v.kind != V_PARAM)) or (dbg_at.len == 0) {
        return -1;
    }
    return dbg_at.get(dbg_key(v)) - 1;
}

// v's uses go to r.
fn dbg_replace(v: *mut Value, r0: *mut Value) void {
    if (v.kind == V_INST) and (v.op == OP_ALLOCA) {
        let mut a = resolve(r0);
        while u.notnil(a) and (a.kind == V_INST) and (a.op == OP_PTRADD) {
            a = a.a;
        }
        if u.notnil(a) and (a.kind == V_INST) and (a.op == OP_ALLOCA) {
            dbg_merged.put(dbg_key(a), a.id + 1);
        }
    }
    let mut j = dbg_chain(v);
    if j < 0 {
        return;
    }
    dbg_at.put(dbg_key(v), 0);
    let r = resolve(r0);
    let ok = u.notnil(r) and (r != v) and
             ((r.kind == V_INST) or (r.kind == V_CINT) or (r.kind == V_CFP) or (r.kind == V_ZERO) or
              (r.kind == V_GLOBAL) or (r.kind == V_PARAM));
    while j >= 0 {
        let ref = dbg_refs.at(@int_cast(usize, j));
        let nx = ref.next;
        if (ref.v == v) and (ref.id == v.id) {
            if ok {
                ref.v = r;
                ref.id = r.id;
                dbg_link(j, r);
            } else {
                ref.v = vnil();
            }
        }
        j = nx;
    }
}

// v leaves its place (to go elsewhere, or for good): the entries following
// it get, where v is a value plus a constant (folded into its uses) or the
// low bits of one, that one as an entry of their own (alt), for dbg_buried.
// (Its operands are read now: once v is dead they may be too.)
fn dbg_alt(v: *Value) void {
    let mut j = dbg_chain(v);
    if j < 0 {
        return;
    }
    if (v.kind != V_INST) or u.isnil(v.a) or not ((v.ty.kind == T_INT) or (v.ty.kind == T_PTR)) or (v.ty.size > 8) {
        return;
    }
    let op = v.op;
    let mut base = vnil();
    let mut plus: i64 = 0;
    let mut low = false;
    if ((op == OP_PTRADD) or (op == OP_ADD) or (op == OP_SUB)) and u.notnil(v.b) and (v.b.kind == V_CINT) {
        base = resolve(v.a);
        plus = @bit_cast(i64, cint_val(v.b));
        let bits = v.b.ty.bits;
        if (bits > 0) and (bits < 64) {
            let sh = @as(u32, @int_cast(u32, 64 - bits));
            plus = (plus << sh) >> sh;
        }
        if op == OP_SUB {
            plus = 0 -% plus;
        }
        if u.notnil(base) and (base.ty.kind != v.ty.kind) {
            base = vnil();
        }
    } else if (op == OP_TRUNC) and (v.a.ty.kind == T_INT) {
        base = resolve(v.a);
        low = true;
    }
    if u.isnil(base) or not ((base.kind == V_INST) or (base.kind == V_PARAM)) or
       (@int_from_ptr(base) == @int_from_ptr(v)) {
        return;
    }
    while j >= 0 {
        let ref = dbg_refs.at(@int_cast(usize, j));
        let nx = ref.next;
        if (@int_from_ptr(ref.v) == @int_from_ptr(v)) and (ref.id == v.id) and (ref.alt < 0) {
            let a = dbg_track(base);
            let x = dbg_refs.at(@int_cast(usize, a));
            x.add = plus;
            x.low = low;
            dbg_refs.at(@int_cast(usize, j)).alt = a;
        }
        j = nx;
    }
}

// v is dead and its memory about to be reused or poisoned: the entries
// following it give up (dbg_value must not read it again), or follow their
// alternative (dbg_alt): its value, plus its constant, its low bits.
fn dbg_buried(v: *Value) void {
    let mut j = dbg_chain(v);
    if j < 0 {
        return;
    }
    dbg_at.put(dbg_key(v), 0);
    while j >= 0 {
        let ref = dbg_refs.at(@int_cast(usize, j));
        let nx = ref.next;
        if (@int_from_ptr(ref.v) == @int_from_ptr(v)) and (ref.id == v.id) {
            ref.v = vnil();
            if ref.alt >= 0 {
                let x = dbg_refs.get(@int_cast(usize, ref.alt));
                let ok = u.notnil(x.v) and
                         ((x.v.kind == V_PARAM) or ((x.v.kind == V_INST) and (x.v.id == x.id) and (x.v.grave == 0)));
                if ok and not (x.low and ref.low) {
                    ref.v = x.v;
                    ref.id = x.id;
                    ref.add = ref.add +% x.add;
                    ref.low = ref.low or x.low;
                    ref.alt = x.alt;
                    dbg_link(j, x.v);
                }
            }
        }
        j = nx;
    }
}

/// Value p (an integer) is the low bits of value w wherever p is (loops.ax:
/// a counter and its step widened, w the extension of p): what followed p
/// follows w's low bits.
pub fn dbg_low_part(p: *mut Value, w: *mut Value) void {
    if not dbg_on {
        return;
    }
    let mut j = dbg_chain(p);
    if j < 0 {
        return;
    }
    dbg_at.put(dbg_key(p), 0);
    while j >= 0 {
        let ref = dbg_refs.at(@int_cast(usize, j));
        let nx = ref.next;
        if (ref.v == p) and (ref.id == p.id) {
            ref.v = w;
            ref.id = w.id;
            ref.low = true;
            dbg_link(j, w);
        }
        j = nx;
    }
}

/// What mark k's variable is beyond its value (dbg_mark_value): that
/// value plus this.
pub fn dbg_mark_add(k: i32) i64 {
    let r = dbg_marks.get(@int_cast(usize, k)).ref;
    if r < 0 {
        return 0;
    }
    return dbg_refs.get(@int_cast(usize, r)).add;
}

/// Is the value mark k gives (dbg_mark_value) its variable's in its low
/// bits only?
pub fn dbg_mark_low(k: i32) bool {
    let r = dbg_marks.get(@int_cast(usize, k)).ref;
    return (r >= 0) and dbg_refs.get(@int_cast(usize, r)).low;
}

// -----------------------------------------------------------------------------
// Assignments of variables in optimized code (-g, -O1 and up; dloc.ax reads
// them): a mark says that at its place a variable, or a piece of one, takes
// a value (a dbg_refs entry, which follows the value as passes replace it;
// one given up is a kill), or that its value is no longer known (a kill).
// Promotion (opt.mem2reg) makes one for each store to a variable's object
// and for each phi it places for one. A mark is attached to the
// instruction it comes before, in order with the others there, or for a
// while to the end of a block that has no terminator; it stays where it is
// as code moves around it: removing an instruction (to delete it or to put
// it elsewhere) moves its marks to the next instruction (or the block's
// end); a run of instructions moved elsewhere as a whole (blocks merged or
// split) takes its marks along (dbg_take, dbg_put). A copy of an
// instruction (duplicated, unrolled code) comes with kills of the
// variables of the marks before it, and a block taken out of its function
// leaves kills at the start of its successors: a value that may not be the
// variable's is never given as its.
// -----------------------------------------------------------------------------
pub struct DbgMark {
    owner: *mut Func,  // the function whose variable it is (dbginfo.vars_of(owner.name))
    var: i32,          // its index there
    off: u32,          // the piece: `size` bytes from `off` (size 0: the whole variable)
    size: u32,
    ref: i32,   // a dbg_refs index (the value), -1: a kill
    src: i32,   // a copy's (a kill): the mark it is a copy of, for dbg_mark_set (-1: none)
    next: i32,  // the next mark at the same place (-1: none)
    inst: u32,  // a variable of an inlined function's: the root of its inline instance (dbginfo.ax's scopes), 0: owner's own
}

// The marks at a place (an instruction, or a block's end): the first one
// + 1, and the id the instruction (block) had when they were attached to it.
struct MkAt {
    first: i32,
    id: i32,
}

pub let mut dbg_marks: u.List.[DbgMark] = u.List.[DbgMark].{ data: @ptr_from_int(*mut DbgMark, 0), len: 0, cap: 0 };
let mut mk_inst: u.SymMap.[MkAt] = u.SymMap.[MkAt].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut MkAt, 0), cap: 0, len: 0 };
let mut mk_end: u.SymMap.[MkAt] = u.SymMap.[MkAt].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut MkAt, 0), cap: 0, len: 0 };

// A map key for an object's address (SymMap keys by the slice's address).
fn mk_key(p: usize) []u8 {
    return @slice_from_ptr(@ptr_from_int(*u8, p), 1);
}

/// The first mark attached to instruction v (-1: none).
pub fn dbg_marks_at(v: *Value) i32 {
    if not dbg_on or (mk_inst.len == 0) {
        return -1;
    }
    let a = mk_inst.get(mk_key(@int_from_ptr(v)));
    if (a.first == 0) or (a.id != v.id) {
        return -1;
    }
    return a.first - 1;
}

fn mk_set(v: *Value, first: i32) void {
    if (first < 0) and (mk_inst.len == 0) {
        return;
    }
    mk_inst.put(mk_key(@int_from_ptr(v)), MkAt.{ first: first + 1, id: v.id });
}

/// The first mark at the end of block b (-1: none).
pub fn dbg_marks_end(b: *Block) i32 {
    if not dbg_on or (mk_end.len == 0) {
        return -1;
    }
    let a = mk_end.get(mk_key(@int_from_ptr(b)));
    if (a.first == 0) or (a.id != b.id) {
        return -1;
    }
    return a.first - 1;
}

fn mk_block_take(b: *Block) i32 {
    if mk_end.len == 0 {
        return -1;
    }
    let k = mk_key(@int_from_ptr(b));
    let a = mk_end.get(k);
    if (a.first == 0) or (a.id != b.id) {
        return -1;
    }
    mk_end.put(k, MkAt.{ first: 0, id: 0 });
    return a.first - 1;
}

// Chain x followed by chain y (either -1: empty).
fn mk_cat(x: i32, y: i32) i32 {
    if x < 0 {
        return y;
    }
    let mut k = x;
    while dbg_marks.get(@int_cast(usize, k)).next >= 0 {
        k = dbg_marks.get(@int_cast(usize, k)).next;
    }
    dbg_marks.at(@int_cast(usize, k)).next = y;
    return x;
}

/// A mark before instruction `at`, after the others there: variable `var`
/// of function `owner` (its piece of `size` bytes at `off`; size 0: all of
/// it) is v from there on (nil: not known).
pub fn dbg_mark(at: *mut Value, owner: *mut Func, var: i32, off: u32, size: u32, v: *mut Value, inst: u32) void {
    let mut r: i32 = -1;
    if u.notnil(v) {
        r = dbg_track(v);
    }
    let k = @int_cast(i32, dbg_marks.len);
    dbg_marks.push(DbgMark.{ owner: owner, var: var, off: off, size: size, ref: r, src: -1, next: -1, inst: inst });
    mk_set(at, mk_cat(dbg_marks_at(at), k));
}

/// The same, before the marks at `at` already.
pub fn dbg_mark_first(at: *mut Value, owner: *mut Func, var: i32, off: u32, size: u32, v: *mut Value, inst: u32) void {
    let mut r: i32 = -1;
    if u.notnil(v) {
        r = dbg_track(v);
    }
    let k = @int_cast(i32, dbg_marks.len);
    dbg_marks.push(DbgMark.{ owner: owner, var: var, off: off, size: size, ref: r, src: -1, next: dbg_marks_at(at),
                             inst: inst });
    mk_set(at, k);
}

/// The value mark k gives its variable (nil: a kill, or a value given up).
pub fn dbg_mark_value(k: i32) *mut Value {
    let r = dbg_marks.get(@int_cast(usize, k)).ref;
    if r < 0 {
        return vnil();
    }
    let x = dbg_refs.get(@int_cast(usize, r));
    if u.isnil(x.v) {
        return vnil();
    }
    if (x.v.kind == V_INST) and ((x.v.id != x.id) or (x.v.grave != 0) or u.isnil(x.v.blk)) {
        return vnil();
    }
    return x.v;
}

/// Value v is split into pieces ps of `bytes` bytes each, in order (wide
/// vectors: vsplit.ax): each mark whose variable v was gives its pieces, a
/// piece each.
pub fn dbg_split(v: *mut Value, ps: []*mut Value, bytes: u32) void {
    let n = dbg_marks.len;
    for k in 0..n {
        let m = dbg_marks.get(k);
        if m.ref < 0 {
            continue;
        }
        let x = dbg_refs.get(@int_cast(usize, m.ref));
        if (x.v != v) or (x.id != v.id) or x.low or (x.add != 0) {
            continue;
        }
        if (m.size != 0) and (m.size != bytes * @truncate(u32, ps.len)) {
            dbg_marks.at(k).ref = -1;  // (a piece of another size: not known)
            continue;
        }
        let mut next = m.next;
        let mut j = ps.len;
        while j > 1 {
            j -= 1;
            let r = dbg_track(ps[j]);
            dbg_marks.push(DbgMark.{ owner: m.owner, var: m.var, off: m.off + (bytes * @truncate(u32, j)), size: bytes,
                                     ref: r, src: -1, next: next, inst: m.inst });
            next = @int_cast(i32, dbg_marks.len) - 1;
        }
        let mm = dbg_marks.at(k);
        mm.ref = dbg_track(ps[0]);
        mm.size = bytes;
        mm.next = next;
    }
}

/// Mark k (a copy's kill, of mark dbg_mark_src(k)) gives its variable v
/// after all (the pass that copied it knows the copy of the value: its
/// low bits only, `low`).
pub fn dbg_mark_set(k: i32, v: *mut Value, low: bool, plus: i64) void {
    let r = dbg_track(v);
    dbg_refs.at(@int_cast(usize, r)).low = low;
    dbg_refs.at(@int_cast(usize, r)).add = plus;
    let m = dbg_marks.at(@int_cast(usize, k));
    m.ref = r;
    m.src = -1;
}

/// The inline instance of mark k's variable (DbgMark.inst; 0: its owner's own).
pub fn dbg_mark_inst(k: i32) u32 {
    return dbg_marks.get(@int_cast(usize, k)).inst;
}

/// Mark k's variable is of inline instance `inst` (DbgMark.inst).
pub fn dbg_mark_set_inst(k: i32, inst: u32) void {
    dbg_marks.at(@int_cast(usize, k)).inst = inst;
}

/// The mark mark k is a copy (a kill) of, -1: none.
pub fn dbg_mark_src(k: i32) i32 {
    return dbg_marks.get(@int_cast(usize, k)).src;
}

/// The next mark after mark k at its place (-1: none).
pub fn dbg_mark_next(k: i32) i32 {
    return dbg_marks.get(@int_cast(usize, k)).next;
}

/// Takes the marks off instruction v, to put them back (dbg_put) where it
/// goes with them; the first of them (-1: none).
pub fn dbg_take(v: *Value) i32 {
    let k = dbg_marks_at(v);
    if k >= 0 {
        mk_set(v, -1);
    }
    return k;
}

/// Puts marks `chain` (dbg_take) before instruction v, after those there.
pub fn dbg_put(v: *Value, chain: i32) void {
    if chain >= 0 {
        mk_set(v, mk_cat(dbg_marks_at(v), chain));
    }
}

// Instruction v leaves its place: its marks go to the next instruction, or
// to the end of its block.
fn mk_leave(v: *Value) void {
    let k = dbg_take(v);
    if k < 0 {
        return;
    }
    if u.notnil(v.next) {
        mk_set(v.next, mk_cat(k, dbg_marks_at(v.next)));
    } else if u.notnil(v.blk) {
        let b = v.blk;
        mk_end.put(mk_key(@int_from_ptr(b)), MkAt.{ first: mk_cat(k, mk_block_take(b)) + 1, id: b.id });
    }
}

/// Instruction v is unlinked from its block by a pass of its own (not
/// remove_inst): its marks stay where it was.
pub fn dbg_unlinked(v: *Value) void {
    if dbg_on {
        mk_leave(v);
    }
}

// Kills of the variables of chain k0, before instruction y (a copy).
fn mk_copy_kills(y: *mut Value, k0: i32) void {
    let mut k = k0;
    while k >= 0 {
        let m = dbg_marks.get(@int_cast(usize, k));
        dbg_mark(y, m.owner, m.var, m.off, m.size, vnil(), m.inst);
        dbg_marks.at(dbg_marks.len - 1).src = k;
        k = m.next;
    }
}

// Block b leaves its function: the variables of its marks are not known at
// its successors' starts (before their marks).
fn mk_block_gone(b: *mut Block) void {
    let mut all: i32 = -1;
    let mut i = b.first;
    while u.notnil(i) {
        all = mk_cat(all, dbg_take(i));
        i = i.next;
    }
    all = mk_cat(all, mk_block_take(b));
    if all < 0 {
        return;
    }
    let mut ks = u.List.[i32].empty();
    let mut k = all;
    while k >= 0 {
        ks.push(k);
        k = dbg_marks.get(@int_cast(usize, k)).next;
    }
    let t = terminator(b);
    for s in 0..succ_count(t) {
        let sb = succ(t, s);
        if (sb == b) or u.isnil(sb.first) {
            continue;
        }
        let mut at = sb.first;
        while (at.op == OP_PHI) and u.notnil(at.next) {
            at = at.next;
        }
        // (from the last, each one first: in order)
        let mut j = ks.len;
        while j > 0 {
            j -= 1;
            let m = dbg_marks.get(@int_cast(usize, ks.get(j)));
            dbg_mark_first(at, m.owner, m.var, m.off, m.size, vnil(), m.inst);
        }
    }
    ks.deinit();
}

// The objects of variables (allocas), for the marks promotion makes: the
// variable an alloca holds, or a piece of one (scalar replacement's slots
// of one's fields).
pub struct DbgSlot {
    id: i32,  // the alloca's
    owner: *mut Func,
    var: i32,
    off: u32,
    size: u32,  // (0: all of the variable)
    inst: u32,  // (an inlined function's variable: its inline instance, DbgMark.inst)
}

pub let mut dbg_slots: u.List.[DbgSlot] = u.List.[DbgSlot].{ data: @ptr_from_int(*mut DbgSlot, 0), len: 0, cap: 0 };
let mut dbg_slot_at: u.SymMap.[i32] = u.SymMap.[i32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0), cap: 0, len: 0 };

/// The variable alloca a holds a piece of (an index in dbg_slots; -1: none).
pub fn dbg_slot_of(a: *Value) i32 {
    if not dbg_on or (dbg_slot_at.len == 0) {
        return -1;
    }
    let k = dbg_slot_at.get(mk_key(@int_from_ptr(a))) - 1;
    if (k < 0) or (dbg_slots.get(@int_cast(usize, k)).id != a.id) {
        return -1;
    }
    return k;
}

/// Alloca a holds variable `var` of `owner` (its `size` bytes from off; 0: all).
pub fn dbg_slot_note(a: *Value, owner: *mut Func, var: i32, off: u32, size: u32, inst: u32) void {
    dbg_slots.push(DbgSlot.{ id: a.id, owner: owner, var: var, off: off, size: size, inst: inst });
    dbg_slot_at.put(mk_key(@int_from_ptr(a)), @int_cast(i32, dbg_slots.len));
}

/// Alloca `part` holds the `size` bytes at `off` of alloca `whole` (scalar
/// replacement): of its variable, if it holds one.
pub fn dbg_slot_part(part: *Value, whole: *Value, off: u64, size: u64) void {
    let k = dbg_slot_of(whole);
    if (k < 0) or (off > 0xffff_ffff) or (size > 0xffff_ffff) {
        return;
    }
    let s = dbg_slots.get(@int_cast(usize, k));
    dbg_slot_note(part, s.owner, s.var, s.off + @truncate(u32, off), @truncate(u32, size), s.inst);
}

// Rewrites every operand of f's instructions through resolve().
pub fn apply_forwarding(f: *mut Func) void {
    if f.fwd_seen == fwd_epoch {
        return;
    }
    f.fwd_seen = fwd_epoch;
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if u.notnil(i.a) {
                i.a = resolve(i.a);
            }
            if u.notnil(i.b) {
                i.b = resolve(i.b);
            }
            if u.notnil(i.c) {
                i.c = resolve(i.c);
            }
            for k in 0..i.xs.len {
                i.xs.set(k, resolve(i.xs.get(k)));
            }
            i = i.next;
        }
        b = b.next;
    }
}

pub fn get_function(m: *mut Module, name: []u8) *mut Func {
    return m.fmap.get(u.intern(name));
}

pub fn add_global(m: *mut Module, t: *mut Ty, name: []u8) *mut Global {
    let g = u.perm_new.[Global]();
    g.name = u.intern(name);
    g.ty = t;
    g.align = t.align;
    g.id = @int_cast(i32, m.globals.len);
    let gv = new_val(V_GLOBAL, t_ptr());
    set_gv(gv, g);
    g.val = gv;
    m.globals.push(g);
    if not m.gmap.has(g.name) {
        m.gmap.put(g.name, g);
    }
    return g;
}

pub fn get_global(m: *mut Module, name: []u8) *mut Global {
    return m.gmap.get(u.intern(name));
}

pub fn is_decl(f: *Func) bool {
    return u.isnil(f.first);
}

fn new_block() *mut Block {
    if free_blocks.len > 0 {
        let b = free_blocks.pop();
        @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, b), @size_of(Block)), 0);
        return b;
    }
    return u.perm_new.[Block]();
}

pub fn append_block(f: *mut Func, name: []u8) *mut Block {
    let b = new_block();
    b.fnp = f;
    b.name = u.perm_dup(name);  // (made while the code generator's own memory is given back after)
    b.id = f.nblocks;
    f.nblocks += 1;
    if u.isnil(f.last) {
        f.first = b;
    } else {
        f.last.next = b;
        b.prev = f.last;
    }
    f.last = b;
    return b;
}

// Takes all of f's blocks out and gives them and their instructions back
// for reuse: f is left a declaration. For a function nothing refers to.
pub fn drop_body(f: *mut Func) void {
    recycle(f);
    // last first, so that they are reused in the order they lie in memory
    let mut b = f.last;
    while u.notnil(b) {
        let prev = b.prev;
        let mut i = b.last;
        while u.notnil(i) {
            let before = i.prev;
            bury_value(i);
            i = before;
        }
        b.first = vnil();
        b.last = vnil();
        b.prev = bnil();
        b.next = bnil();
        bury_block(b);
        b = prev;
    }
    f.first = bnil();
    f.last = bnil();
}

pub fn remove_block(b: *mut Block) void {
    if dbg_on {
        mk_block_gone(b);
    }
    unlink_block(b);
}

// Removes block b, which no path reaches: what its marks say never takes
// effect (its successors' variables are what their other paths make them).
fn remove_unreached_block(b: *mut Block) void {
    if dbg_on {
        let mut i = b.first;
        while u.notnil(i) {
            _ = dbg_take(i);
            i = i.next;
        }
        _ = mk_block_take(b);
    }
    unlink_block(b);
}

/// Block `from`'s marks at its end (after its last instruction) go to the
/// end of block `to` (merged into it), after those there.
pub fn dbg_move_end(from: *Block, to: *Block) void {
    if not dbg_on {
        return;
    }
    let k = mk_block_take(from);
    if k >= 0 {
        mk_end.put(mk_key(@int_from_ptr(to)), MkAt.{ first: mk_cat(mk_block_take(to), k) + 1, id: to.id });
    }
}

fn unlink_block(b: *mut Block) void {
    let f = b.fnp;
    block_to_grave(b);
    if u.notnil(b.prev) {
        b.prev.next = b.next;
    } else {
        f.first = b.next;
    }
    if u.notnil(b.next) {
        b.next.prev = b.prev;
    } else {
        f.last = b.prev;
    }
    b.prev = bnil();
    b.next = bnil();
}

// Moves `b` to directly after `after`.
pub fn move_block_after(b: *mut Block, after: *mut Block) void {
    if b == after {
        return;
    }
    unlink_block(b);
    let f = after.fnp;
    b.prev = after;
    b.next = after.next;
    if u.notnil(after.next) {
        after.next.prev = b;
    } else {
        f.last = b;
    }
    after.next = b;
}

pub fn terminator(b: *Block) *mut Value {
    let l = b.last;
    if u.notnil(l) and is_term(l.op) {
        return l;
    }
    return vnil();
}

pub fn is_term(op: i32) bool {
    return (op_props(op) & OPF_TERM) != 0;
}

// Successor blocks of a terminator.
pub fn succ_count(t: *Value) usize {
    if u.isnil(t) {
        return 0;
    }
    let op = t.op;
    if op == OP_BR {
        return 1;
    }
    if op == OP_CONDBR {
        return 2;
    }
    if op == OP_SWITCH {
        return 1 + bs_of(t).len;
    }
    return 0;
}

pub fn succ(t: *Value, i: usize) *mut Block {
    if i == 0 {
        return t.t1;
    }
    if t.op == OP_CONDBR {
        return t.t2;
    }
    return bs_of(t).get(i - 1);
}

pub fn set_succ(t: *mut Value, i: usize, b: *mut Block) void {
    if i == 0 {
        t.t1 = b;
    } else if t.op == OP_CONDBR {
        t.t2 = b;
    } else {
        bs_of(t).set(i - 1, b);
    }
}

// Instruction list editing.
pub fn insert_before(pos: *mut Value, v: *mut Value) void {
    let b = pos.blk;
    v.blk = b;
    v.next = pos;
    v.prev = pos.prev;
    if u.notnil(pos.prev) {
        pos.prev.next = v;
    } else {
        b.first = v;
    }
    pos.prev = v;
}

pub fn append_inst(b: *mut Block, v: *mut Value) void {
    if dbg_on and (mk_end.len > 0) {
        let k = mk_block_take(b);
        if k >= 0 {
            mk_set(v, mk_cat(k, dbg_marks_at(v)));  // (the marks left at the block's end)
        }
    }
    v.blk = b;
    v.prev = b.last;
    v.next = vnil();
    if u.notnil(b.last) {
        b.last.next = v;
    } else {
        b.first = v;
    }
    b.last = v;
}

pub fn remove_inst(v: *mut Value) void {
    let b = v.blk;
    if dbg_on {
        mk_leave(v);
        dbg_alt(v);
    }
    to_grave(v, b.fnp);
    if u.notnil(v.prev) {
        v.prev.next = v.next;
    } else {
        b.first = v.next;
    }
    if u.notnil(v.next) {
        v.next.prev = v.prev;
    } else {
        b.last = v.prev;
    }
    v.prev = vnil();
    v.next = vnil();
    v.blk = bnil();
}

// Operands of an instruction, in order: a, b, c, then xs.
pub fn nops(v: *Value) usize {
    let mut n: usize = 0;
    if u.notnil(v.a) {
        n = 1;
    }
    if u.notnil(v.b) {
        n = 2;
    }
    if u.notnil(v.c) {
        n = 3;
    }
    return n;
}

// Replaces every use of `old` by `new` in function f (operands only).
pub fn replace_uses(f: *mut Func, old: *mut Value, new: *mut Value) void {
    if dbg_on {
        dbg_replace(old, new);
    }
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            replace_in(i, old, new);
            i = i.next;
        }
        b = b.next;
    }
}

pub fn replace_in(i: *mut Value, old: *mut Value, new: *mut Value) void {
    if i.a == old {
        i.a = new;
    }
    if i.b == old {
        i.b = new;
    }
    if i.c == old {
        i.c = new;
    }
    for k in 0..i.xs.len {
        if i.xs.get(k) == old {
            i.xs.set(k, new);
        }
    }
}

// -----------------------------------------------------------------------------
// What the passes ask of instructions
// -----------------------------------------------------------------------------

// A floating-point operation whose result depends on the rounding mode or
// that may raise an exception: the arithmetic, comparisons, conversions to,
// from and between floating types, and the floating intrinsics (sqrt, fma,
// the roundings, min and max). Negation and the absolute value are exact
// and raise nothing.
pub fn fp_env_op(i: *Value) bool {
    let op = i.op;
    if ((op >= OP_FADD) and (op <= OP_FREM)) or (op == OP_FCMP) or (op == OP_FPEXT) or (op == OP_FPTRUNC) {
        return true;
    }
    if (op == OP_SITOFP) or (op == OP_UITOFP) or (op == OP_FPTOSI_SAT) or (op == OP_FPTOUI_SAT) {
        return true;
    }
    if op == OP_INTR {
        let id = intr_id(i);
        return (id == IN_SQRT) or (id == IN_FMA) or (id == IN_FMIN) or (id == IN_FMAX) or
               ((id >= IN_FLOOR) and (id <= IN_NEAREST));
    }
    return false;
}

// Is i a floating-point operation of a function with strict floating
// point (Func's strict_fp), which the passes must leave where it is, as it
// is: not folded, merged with another, moved (across a call that changes or
// tests the environment) or removed (its exceptions are effects)?
pub fn fp_pinned(i: *Value) bool {
    if (i.kind != V_INST) or u.isnil(i.blk) or u.isnil(i.blk.fnp) or not i.blk.fnp.strict_fp {
        return false;
    }
    return fp_env_op(i);
}

// Must instruction i be kept though its result is unused (it writes memory,
// ends its block, is a volatile or atomic load, an intrinsic with an
// effect, or a floating-point operation under strict floating point)?
pub fn has_effects(i: *Value) bool {
    let op = i.op;
    if fp_pinned(i) {
        return true;
    }
    if (op_props(op) & (OPF_WRITES_MEM | OPF_TERM)) != 0 {
        return true;
    }
    if op == OP_LOAD {
        return i.flags != 0;
    }
    if op == OP_INTR {
        return inst_has_effects(i);
    }
    return false;
}

// Is v an instruction with opcode op (false for nil)?
pub fn is_op(v: *Value, op: i32) bool {
    return u.notnil(v) and (v.kind == V_INST) and (v.op == op);
}

// The predicate (Int*, Real*) of a comparison.
pub fn pred_of(v: *Value) i32 {
    return @truncate(i32, @bit_cast(i64, v.cv));
}

// The intrinsic (IN_*) an instruction calls; 0 when it is not OP_INTR.
pub fn intr_id(v: *Value) i32 {
    if v.op != OP_INTR {
        return 0;
    }
    return @truncate(i32, @bit_cast(i64, v.cv));
}

// The predicate with its operands swapped: a p b == b swap(p) a.
pub fn swap_pred(p: i32) i32 {
    if p == IntUGT {
        return IntULT;
    }
    if p == IntULT {
        return IntUGT;
    }
    if p == IntUGE {
        return IntULE;
    }
    if p == IntULE {
        return IntUGE;
    }
    if p == IntSGT {
        return IntSLT;
    }
    if p == IntSLT {
        return IntSGT;
    }
    if p == IntSGE {
        return IntSLE;
    }
    if p == IntSLE {
        return IntSGE;
    }
    return p;
}

// The negated predicate: not (a p b) == a inv(p) b.
pub fn inv_pred(p: i32) i32 {
    if p == IntEQ {
        return IntNE;
    }
    if p == IntNE {
        return IntEQ;
    }
    if p == IntUGT {
        return IntULE;
    }
    if p == IntULE {
        return IntUGT;
    }
    if p == IntUGE {
        return IntULT;
    }
    if p == IntULT {
        return IntUGE;
    }
    if p == IntSGT {
        return IntSLE;
    }
    if p == IntSLE {
        return IntSGT;
    }
    if p == IntSGE {
        return IntSLT;
    }
    return IntSGE;  // SLT
}

pub fn is_signed_pred(p: i32) bool {
    return (p >= IntSGT) and (p <= IntSLE);
}

// Integer operations whose operands may be swapped.
pub fn commutative_int(op: i32) bool {
    return (op_props(op) & (OPF_COMMUTATIVE | OPF_INT_BINOP)) == (OPF_COMMUTATIVE | OPF_INT_BINOP);
}

// The same, and the floating point ones (the same result, NaNs aside).
pub fn commutative(op: i32) bool {
    return (op_props(op) & OPF_COMMUTATIVE) != 0;
}

// The base of address p, through additions of any offsets.
pub fn ptr_base(p: *mut Value) *mut Value {
    let mut q = p;
    while is_op(q, OP_PTRADD) {
        q = q.a;
    }
    return q;
}

// Number of uses of each instruction (uses; user: the last user).
pub fn count_uses(f: *mut Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.uses = 0;
            i = i.next;
        }
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            use1(i.a, i);
            use1(i.b, i);
            use1(i.c, i);
            for k in 0..i.xs.len {
                use1(i.xs.get(k), i);
            }
            i = i.next;
        }
        b = b.next;
    }
}

fn use1(o: *mut Value, i: *mut Value) void {
    if u.notnil(o) and (o.kind == V_INST) {
        o.uses += 1;
        o.user = i;
    }
}

// -----------------------------------------------------------------------------
// Phi inputs and edges
// -----------------------------------------------------------------------------

// The value phi p takes over the edge from block `from` (nil: none).
pub fn incoming(p: *Value, from: *mut Block) *mut Value {
    for k in 0..bs_of(p).len {
        if bs_of(p).get(k) == from {
            return p.xs.get(k);
        }
    }
    return vnil();
}

// Removes input k of phi p (the last input takes its place).
pub fn remove_incoming(p: *mut Value, k: usize) void {
    bs_of(p).set(k, bs_of(p).get(bs_of(p).len - 1));
    p.xs.set(k, p.xs.get(p.xs.len - 1));
    bs_mut(p).len -= 1;
    p.xs.len -= 1;
}

// Removes phi p's inputs from block `from`.
pub fn drop_incoming(p: *mut Value, from: *mut Block) void {
    let mut k: usize = 0;
    while k < bs_of(p).len {
        if bs_of(p).get(k) == from {
            remove_incoming(p, k);
        } else {
            k += 1;
        }
    }
}

// Removes the inputs from block `from` of the phis of s.
pub fn remove_phi_input(s: *mut Block, from: *mut Block) void {
    let mut p = s.first;
    while u.notnil(p) and (p.op == OP_PHI) {
        drop_incoming(p, from);
        p = p.next;
    }
}

// The phis of s take their inputs from `old` as from `new`.
pub fn replace_phi_block(s: *mut Block, old: *mut Block, new: *mut Block) void {
    let mut p = s.first;
    while u.notnil(p) and (p.op == OP_PHI) {
        for k in 0..bs_of(p).len {
            if bs_of(p).get(k) == old {
                bs_of(p).set(k, new);
            }
        }
        p = p.next;
    }
}

// Points the edges from b to `old` at `new`.
pub fn retarget(b: *Block, old: *mut Block, new: *mut Block) void {
    let t = terminator(b);
    for k in 0..succ_count(t) {
        if succ(t, k) == old {
            set_succ(t, k, new);
        }
    }
}

// A new block (named `name`, last in f) on the way from `from` to `to`: it
// jumps to `to`, whose phis take their inputs from `from` from it. The
// caller points from's edges at it.
pub fn edge_block(f: *mut Func, name: []u8, from: *mut Block, to: *mut Block) *mut Block {
    let nb = append_block(f, name);
    let j = new_inst(f, OP_BR, t_void());
    j.t1 = to;
    append_inst(nb, j);
    replace_phi_block(to, from, nb);
    return nb;
}

// Splits the edges from `from` to `to` by a new block (edge_block).
pub fn split_edge(f: *mut Func, name: []u8, from: *mut Block, to: *mut Block) *mut Block {
    let nb = edge_block(f, name, from, to);
    retarget(from, to, nb);
    return nb;
}

// -----------------------------------------------------------------------------
// Builder
// -----------------------------------------------------------------------------
pub struct Builder {
    blk: *mut Block,
    before: *mut Value,  // insert before this instruction; nil: at the end
}

pub fn new_builder() *mut Builder {
    return u.perm_new.[Builder]();
}

pub fn at_end(bd: *mut Builder, b: *mut Block) void {
    bd.blk = b;
    bd.before = vnil();
}

pub fn at_before(bd: *mut Builder, v: *mut Value) void {
    bd.blk = v.blk;
    bd.before = v;
}

pub fn insert_block(bd: *Builder) *mut Block {
    return bd.blk;
}

// Source locations (debug information): a file and a line in a u32, for
// every instruction. Code generation sets cur_src as it goes; instructions
// passes insert before another take that one's.
pub let mut cur_src: u32 = 0;
// (and the lexical block they are in, which goes with the location: C's
// block scopes, dbginfo.ax; 0: none)
pub let mut cur_scope: u32 = 0;

pub fn src_loc(file: i32, line: i32) u32 {
    if (file < 0) or (file >= 4095) or (line <= 0) or (line >= 0x10_0000) {
        return 0;
    }
    return (@bit_cast(u32, file + 1) << 20) | @bit_cast(u32, line);
}

pub fn src_file(s: u32) i32 {
    return @bit_cast(i32, s >> 20) - 1;
}

pub fn src_line(s: u32) u32 {
    return s & 0xf_ffff;
}

fn emit(bd: *mut Builder, op: i32, t: *mut Ty) *mut Value {
    let v = new_val(V_INST, t);
    v.op = op;
    v.src = cur_src;
    v.scope = cur_scope;
    if (v.src == 0) and u.notnil(bd.before) {
        v.src = bd.before.src;
        v.scope = bd.before.scope;
    }
    let f = bd.blk.fnp;
    v.id = f.nvals;
    f.nvals += 1;
    if u.notnil(bd.before) {
        insert_before(bd.before, v);
    } else {
        append_inst(bd.blk, v);
    }
    return v;
}

// A new instruction that is not in any block (for passes).
pub fn new_inst(f: *mut Func, op: i32, t: *mut Ty) *mut Value {
    let v = new_val(V_INST, t);
    v.op = op;
    v.id = f.nvals;
    f.nvals += 1;
    return v;
}

// A new instruction of f with everything of v but its place: the same
// operands, targets and source location (not in a block).
pub fn copy_inst(f: *mut Func, v: *Value) *mut Value {
    let y = new_inst(f, v.op, v.ty);
    y.cv = v.cv;
    y.flags = v.flags;
    y.src = v.src;
    y.scope = v.scope;
    if dbg_on {
        mk_copy_kills(y, dbg_marks_at(v));
    }
    y.align = v.align;
    copy_more(y, v);  // (with a block list of its own, filled below)
    y.a = v.a;
    y.b = v.b;
    y.c = v.c;
    y.t1 = v.t1;
    y.t2 = v.t2;
    for j in 0..v.xs.len {
        y.xs.push(v.xs.get(j));
    }
    for j in 0..bs_of(v).len {
        bs_mut(y).push(bs_of(v).get(j));
    }
    return y;
}

pub fn fold_int_bin(op: i32, t: *mut Ty, x: *Value, y: *Value) *mut Value {
    let a = cint_val(x);
    let b = cint_val(y);
    let bits = t.bits;
    let mut r: u64 = 0;
    if op == OP_ADD {
        r = a +% b;
    } else if op == OP_SUB {
        r = a -% b;
    } else if op == OP_MUL {
        r = a *% b;
    } else if op == OP_AND {
        r = a & b;
    } else if op == OP_OR {
        r = a | b;
    } else if op == OP_XOR {
        r = a ^ b;
    } else if op == OP_SHL {
        if b >= @int_cast(u64, bits) {
            return vnil();
        }
        r = a << @truncate(u32, b);
    } else if op == OP_LSHR {
        if b >= @int_cast(u64, bits) {
            return vnil();
        }
        r = a >> @truncate(u32, b);
    } else if op == OP_ASHR {
        if b >= @int_cast(u64, bits) {
            return vnil();
        }
        r = @bit_cast(u64, sval(x) >> @truncate(u32, b));
    } else if op == OP_UDIV {
        if b == 0 {
            return vnil();
        }
        r = a / b;
    } else if op == OP_UREM {
        if b == 0 {
            return vnil();
        }
        r = a % b;
    } else if (op == OP_SDIV) or (op == OP_SREM) {
        let sa = sval(x);
        let sb = sval(y);
        if (sb == 0) or ((sb == -1) and (a == (@as(u64, 1) << @int_cast(u32, bits - 1)))) {
            return vnil();
        }
        if op == OP_SDIV {
            r = @bit_cast(u64, sa / sb);
        } else {
            r = @bit_cast(u64, sa % sb);
        }
    } else {
        return vnil();
    }
    return cint(t, r);
}

pub fn binop(bd: *mut Builder, op: i32, x: *mut Value, y: *mut Value) *mut Value {
    let t = x.ty;
    if (t.kind == T_INT) and is_cint(x) and is_cint(y) and (t.bits <= 64) {
        let r = fold_int_bin(op, t, x, y);
        if u.notnil(r) {
            return r;
        }
    }
    let v = emit(bd, op, t);
    v.a = x;
    v.b = y;
    return v;
}

pub fn add(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_ADD, x, y);
}

pub fn sub(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_SUB, x, y);
}

pub fn mul(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_MUL, x, y);
}

pub fn and_(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_AND, x, y);
}

pub fn or_(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_OR, x, y);
}

pub fn xor(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_XOR, x, y);
}

pub fn not_(bd: *mut Builder, x: *mut Value) *mut Value {
    return binop(bd, OP_XOR, x, cones(x.ty));
}

pub fn neg(bd: *mut Builder, x: *mut Value) *mut Value {
    return binop(bd, OP_SUB, czero(x.ty), x);
}

pub fn fneg(bd: *mut Builder, x: *mut Value) *mut Value {
    if x.kind == V_CFP {
        return cfp(x.ty, -fv_of(x));
    }
    let v = emit(bd, OP_FNEG, x.ty);
    v.a = x;
    return v;
}

fn cmp_fold(p: i32, x: *Value, y: *Value) i32 {
    let a = cint_val(x);
    let b = cint_val(y);
    let sa = sval(x);
    let sb = sval(y);
    let mut r = false;
    if p == IntEQ {
        r = a == b;
    } else if p == IntNE {
        r = a != b;
    } else if p == IntUGT {
        r = a > b;
    } else if p == IntUGE {
        r = a >= b;
    } else if p == IntULT {
        r = a < b;
    } else if p == IntULE {
        r = a <= b;
    } else if p == IntSGT {
        r = sa > sb;
    } else if p == IntSGE {
        r = sa >= sb;
    } else if p == IntSLT {
        r = sa < sb;
    } else if p == IntSLE {
        r = sa <= sb;
    }
    if r {
        return 1;
    }
    return 0;
}

// Comparisons: i1, or for vectors a lane mask (all ones / zeros) of the
// operands' shape with integer lanes.
fn cmp_ty(t: *mut Ty) *mut Ty {
    if t.kind == T_VEC {
        if t.elem.kind == T_FLOAT {
            return t_vec(t_int(t.elem.bits), @int_cast(u32, t.lanes));
        }
        return t;
    }
    return t_int(1);
}

// The comparison `x p y` folded: nil unless x and y are integer constants of
// at most 64 bits.
pub fn fold_icmp(p: i32, x: *Value, y: *Value) *mut Value {
    if (x.ty.kind != T_VEC) and is_cint(x) and is_cint(y) and (x.ty.bits <= 64) {
        return cint(t_int(1), @as(u64, @bit_cast(u32, cmp_fold(p, x, y))));
    }
    return vnil();
}

pub fn icmp(bd: *mut Builder, p: i32, x: *mut Value, y: *mut Value) *mut Value {
    let k = fold_icmp(p, x, y);
    if u.notnil(k) {
        return k;
    }
    let v = emit(bd, OP_ICMP, cmp_ty(x.ty));
    v.cv = @as(u64, @bit_cast(u32, p));
    v.a = x;
    v.b = y;
    return v;
}

pub fn fcmp(bd: *mut Builder, p: i32, x: *mut Value, y: *mut Value) *mut Value {
    let v = emit(bd, OP_FCMP, cmp_ty(x.ty));
    v.cv = @as(u64, @bit_cast(u32, p));
    v.a = x;
    v.b = y;
    return v;
}

pub fn is_null(bd: *mut Builder, p: *mut Value) *mut Value {
    return icmp(bd, IntEQ, p, czero(p.ty));
}

pub fn select(bd: *mut Builder, c: *mut Value, x: *mut Value, y: *mut Value) *mut Value {
    if c.kind == V_CINT {
        if c.cv != 0 {
            return x;
        }
        return y;
    }
    if x == y {
        return x;
    }
    let v = emit(bd, OP_SELECT, x.ty);
    v.a = c;
    v.b = x;
    v.c = y;
    return v;
}

// The cast of x to t, when it needs no instruction (x is t already, or a
// constant): nil otherwise.
pub fn fold_cast(op: i32, x: *mut Value, t: *mut Ty) *mut Value {
    if x.ty == t {
        if (op == OP_ZEXT) or (op == OP_SEXT) or (op == OP_TRUNC) or (op == OP_BITCAST) {
            return x;
        }
    }
    if (x.kind == V_CINT) or ((x.kind == V_ZERO) and (x.ty.kind == T_INT)) {
        if (op == OP_ZEXT) or (op == OP_TRUNC) {
            return cint(t, cint_val(x));
        }
        if op == OP_SEXT {
            return cint(t, @bit_cast(u64, sval(x)));
        }
        if op == OP_INTTOPTR {
            return cinttoptr(x);
        }
    }
    if (x.kind == V_ZERO) and (op == OP_PTRTOINT) {
        return cint(t, 0);
    }
    if (x.kind == V_UNDEF) and (op != OP_FPTOSI_SAT) and (op != OP_FPTOUI_SAT) {
        return undef(t);
    }
    return vnil();
}

pub fn cast(bd: *mut Builder, op: i32, x: *mut Value, t: *mut Ty) *mut Value {
    let k = fold_cast(op, x, t);
    if u.notnil(k) {
        return k;
    }
    let v = emit(bd, op, t);
    v.a = x;
    return v;
}

pub fn zext(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    return cast(bd, OP_ZEXT, x, t);
}

pub fn sext(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    return cast(bd, OP_SEXT, x, t);
}

pub fn trunc(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    return cast(bd, OP_TRUNC, x, t);
}

pub fn bitcast(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    return cast(bd, OP_BITCAST, x, t);
}

pub fn ptrtoint(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    let v = cast(bd, OP_PTRTOINT, x, t_int(@int_cast(i32, ptr_bytes * 8)));
    if t.bits == @int_cast(i32, ptr_bytes * 8) {
        return v;
    }
    if t.bits < @int_cast(i32, ptr_bytes * 8) {
        return trunc(bd, v, t);
    }
    return zext(bd, v, t);
}

pub fn inttoptr(bd: *mut Builder, x: *mut Value) *mut Value {
    let pt = t_int(@int_cast(i32, ptr_bytes * 8));
    let mut y = x;
    if x.ty.bits < pt.bits {
        y = zext(bd, x, pt);
    } else if x.ty.bits > pt.bits {
        y = trunc(bd, x, pt);
    }
    return cast(bd, OP_INTTOPTR, y, t_ptr());
}

pub fn alloca(bd: *mut Builder, t: *mut Ty, name: []u8) *mut Value {
    let v = emit(bd, OP_ALLOCA, t_ptr());
    set_aty(v, t);
    v.align = @int_cast(u32, t.align);
    set_name(v, name);
    return v;
}

pub fn load(bd: *mut Builder, t: *mut Ty, p: *mut Value) *mut Value {
    let v = emit(bd, OP_LOAD, t);
    v.a = p;
    v.align = @int_cast(u32, t.align);
    return v;
}

pub fn store(bd: *mut Builder, x: *mut Value, p: *mut Value) *mut Value {
    let v = emit(bd, OP_STORE, t_void());
    v.a = x;
    v.b = p;
    v.align = @int_cast(u32, x.ty.align);
    return v;
}

pub fn isz() *mut Ty {
    return t_int(@int_cast(i32, ptr_bytes * 8));
}

// p + off bytes (off: a pointer-sized integer)
pub fn ptradd(bd: *mut Builder, p: *mut Value, off: *mut Value) *mut Value {
    if is_cint(off) and (cint_val(off) == 0) {
        return p;
    }
    if (p.kind == V_INST) and (p.op == OP_PTRADD) and is_cint(p.b) and is_cint(off) {
        return ptradd(bd, p.a, cint(isz(), cint_val(p.b) +% cint_val(off)));
    }
    let v = emit(bd, OP_PTRADD, t_ptr());
    v.a = p;
    v.b = off;
    return v;
}

fn index_isz(bd: *mut Builder, i: *mut Value) *mut Value {
    let t = isz();
    if i.ty.bits < t.bits {
        return sext(bd, i, t);
    }
    if i.ty.bits > t.bits {
        return trunc(bd, i, t);
    }
    return i;
}

fn scaled(bd: *mut Builder, i: *mut Value, size: u64) *mut Value {
    let x = index_isz(bd, i);
    if size == 1 {
        return x;
    }
    return mul(bd, x, cint(isz(), size));
}

// LLVM-style GEP: the first index steps over whole `t`s; the rest index
// into struct fields (constant) or array elements.
pub fn gep(bd: *mut Builder, t: *mut Ty, p: *mut Value, idx: []mut *mut Value) *mut Value {
    let mut off = scaled(bd, idx[0], t.size);
    let mut cur = t;
    for k in 1..idx.len {
        let i = idx[k];
        if cur.kind == T_STRUCT {
            let fi = @truncate(usize, cint_val(i));
            off = add(bd, off, cint(isz(), cur.offs[fi]));
            cur = cur.fields[fi];
        } else {
            off = add(bd, off, scaled(bd, i, cur.elem.size));
            cur = cur.elem;
        }
    }
    return ptradd(bd, p, off);
}

pub fn gep1(bd: *mut Builder, t: *mut Ty, p: *mut Value, i: *mut Value) *mut Value {
    return ptradd(bd, p, scaled(bd, i, t.size));
}

pub fn struct_gep(bd: *mut Builder, t: *mut Ty, p: *mut Value, i: u32) *mut Value {
    return ptradd(bd, p, cint(isz(), field_off(t, @as(usize, i))));
}

pub fn memop(bd: *mut Builder, op: i32, d: *mut Value, s: *mut Value, n: *mut Value) *mut Value {
    let v = emit(bd, op, t_void());
    v.a = d;
    v.b = s;
    v.c = index_isz(bd, n);
    return v;
}

pub fn rmw(bd: *mut Builder, op: i32, p: *mut Value, x: *mut Value) *mut Value {
    let v = emit(bd, OP_RMW, x.ty);
    v.cv = @as(u64, @bit_cast(u32, op));
    v.a = p;
    v.b = x;
    v.align = @int_cast(u32, x.ty.size);
    v.flags = F_ATOMIC;
    return v;
}

pub fn cmpxchg(bd: *mut Builder, p: *mut Value, e: *mut Value, n: *mut Value) *mut Value {
    let v = emit(bd, OP_CMPXCHG, e.ty);
    v.a = p;
    v.b = e;
    v.c = n;
    v.align = @int_cast(u32, e.ty.size);
    v.flags = F_ATOMIC;
    return v;
}

pub fn fence(bd: *mut Builder) *mut Value {
    return emit(bd, OP_FENCE, t_void());
}

pub fn extract(bd: *mut Builder, agg: *mut Value, i: u32) *mut Value {
    let ft = field_ty(agg.ty, @as(usize, i));
    if is_cagg(agg) {
        return agg_elem(agg, @as(usize, i));
    }
    if agg.kind == V_ZERO {
        return czero(ft);
    }
    if agg.kind == V_UNDEF {
        return undef(ft);
    }
    // extract(insert(x, v, i), i) = v
    if (agg.kind == V_INST) and (agg.op == OP_INSERTVALUE) and (agg.cv == @as(u64, i)) {
        return agg.b;
    }
    let v = emit(bd, OP_EXTRACTVALUE, ft);
    v.a = agg;
    v.cv = @as(u64, i);
    return v;
}

pub fn insert(bd: *mut Builder, agg: *mut Value, x: *mut Value, i: u32) *mut Value {
    // constants fold (a literal of constants is a constant, and lowering
    // turns a large one into read-only data instead of stores)
    let ak = agg.kind;
    if is_const(x) and not is_tls_addr(x) and
       ((ak == V_CAGG) or (ak == V_CSTR) or (ak == V_UNDEF) or (ak == V_ZERO)) and (agg.ty.kind != T_VEC) and
       (field_count(agg.ty) <= 256) {
        let n = field_count(agg.ty);
        let xs = u.perm_newn.[*mut Value](n + 1);
        for k in 0..n {
            if k == @as(usize, i) {
                xs[k] = x;
            } else if (ak == V_CAGG) or (ak == V_CSTR) {
                xs[k] = agg_elem(agg, k);
            } else if ak == V_ZERO {
                xs[k] = czero(field_ty(agg.ty, k));
            } else {
                xs[k] = undef(field_ty(agg.ty, k));
            }
        }
        return cagg(agg.ty, xs[0..n]);
    }
    let v = emit(bd, OP_INSERTVALUE, agg.ty);
    v.a = agg;
    v.b = x;
    v.cv = @as(u64, i);
    return v;
}

pub fn extract_elem(bd: *mut Builder, vec: *mut Value, i: u64) *mut Value {
    let v = emit(bd, OP_EXTRACTELEM, vec.ty.elem);
    v.a = vec;
    v.cv = i;
    return v;
}

pub fn insert_elem(bd: *mut Builder, vec: *mut Value, x: *mut Value, i: u64) *mut Value {
    let v = emit(bd, OP_INSERTELEM, vec.ty);
    v.a = vec;
    v.b = x;
    v.cv = i;
    return v;
}

pub fn splat(bd: *mut Builder, vt: *mut Ty, x: *mut Value) *mut Value {
    let v = emit(bd, OP_SPLAT, vt);
    v.a = x;
    return v;
}

// Result lanes pick from the concatenation of x and y (indices into 2n lanes).
pub fn shuffle(bd: *mut Builder, x: *mut Value, y: *mut Value, mask: []i32) *mut Value {
    let n = mask.len;
    let v = emit(bd, OP_SHUFFLE, t_vec(x.ty.elem, @int_cast(u32, n)));
    v.a = x;
    v.b = y;
    set_mask(v, u.perm_newn.[i32](n + 1)[0..n]);
    for i in 0..n {
        mask_of(v)[i] = mask[i];
    }
    return v;
}

pub fn call(bd: *mut Builder, fty: *mut Ty, callee: *mut Value, args: []mut *mut Value) *mut Value {
    let v = emit(bd, OP_CALL, fty.ret);
    set_fty(v, fty);
    v.a = callee;
    v.xs.reserve(args.len);
    for x in args {
        v.xs.push(x);
    }
    set_ext(v, u.perm_newn.[u8](args.len + 1)[0..args.len + 1]);
    return v;
}

// The function call v calls directly: its callee is a function of the
// call's own signature. A function pointer cast to another function type
// and called is still an indirect call once its value is known (on
// WebAssembly, call_indirect checks the signature and traps, T0009), so it
// is not one of the function's calls: nil.
pub fn direct_callee(v: *Value) *mut Func {
    if (v.op != OP_CALL) or (v.a.kind != V_FUNC) {
        return u.nil.[Func]();
    }
    let f = fnp_of(v.a);
    let t = fty_of(v);
    let ft = f.ty;
    if (t.ret != ft.ret) or (t.vararg != ft.vararg) or (t.params.len != ft.params.len) {
        return u.nil.[Func]();
    }
    for i in 0..t.params.len {
        if t.params[i] != ft.params[i] {
            return u.nil.[Func]();
        }
    }
    return f;
}

/// Is pointer v known not to be null: the address of a stack slot, a
/// parameter with F_NONNULL, or the result of a direct call of a function
/// with ret_nonnull? (Not the address of a global or a function: a weak
/// reference may be null, and on WebAssembly address 0 and table index 0
/// are where objects or functions may be.)
pub fn known_nonnull(v0: *mut Value) bool {
    let v = resolve(v0);
    if u.isnil(v) or (v.ty.kind != T_PTR) {
        return false;
    }
    if v.kind == V_PARAM {
        return (v.flags & F_NONNULL) != 0;
    }
    if v.kind != V_INST {
        return false;
    }
    if v.op == OP_ALLOCA {
        return true;
    }
    if v.op == OP_CALL {
        let f = direct_callee(v);
        return u.notnil(f) and f.ret_nonnull and (ext_of(v).len > 0) and (ext_of(v)[0] == 0);
    }
    return false;
}

/// What call v may do (FX_), as its callee's declaration promises: FX_ANY
/// unless it is a direct call of a function with Func.fx whose arguments
/// and result are scalars (no aggregate's memory: a result written to the
/// caller's slot is a write; an aggregate passed by value is read from its
/// copy, so FX_NONE is FX_READS then) and that neither returns twice nor is
/// declared not to return. An indirect call promises nothing.
pub fn call_fx(v: *Value) u8 {
    if (v.kind != V_INST) or (v.op != OP_CALL) {
        return FX_ANY;
    }
    let f = direct_callee(v);
    if u.isnil(f) or (f.fx == FX_ANY) or f.noreturn or f.returns_twice {
        return FX_ANY;
    }
    let mut fx = f.fx;
    let ext = ext_of(v);
    for k in 0..ext.len {
        let e = ext[k];
        if (e == EXT_BYVAL) and (k > 0) {
            fx = FX_READS;
        } else if e > 2 {
            return FX_ANY;
        }
    }
    return fx;
}

pub fn intr(bd: *mut Builder, id: i32, t: *mut Ty, args: []mut *mut Value) *mut Value {
    let v = emit(bd, OP_INTR, t);
    v.cv = @as(u64, @bit_cast(u32, id));
    for x in args {
        v.xs.push(x);
    }
    return v;
}

pub fn intr1(bd: *mut Builder, id: i32, x: *mut Value) *mut Value {
    let mut a: [1]*mut Value = [x];
    return intr(bd, id, x.ty, a[..]);
}

pub fn intr2(bd: *mut Builder, id: i32, x: *mut Value, y: *mut Value) *mut Value {
    let mut a: [2]*mut Value = [x, y];
    return intr(bd, id, x.ty, a[..]);
}

pub fn phi(bd: *mut Builder, t: *mut Ty) *mut Value {
    return emit(bd, OP_PHI, t);
}

pub fn add_incoming(p: *mut Value, x: *mut Value, b: *mut Block) void {
    p.xs.push(x);
    bs_mut(p).push(b);
}

pub fn br(bd: *mut Builder, b: *mut Block) void {
    let v = emit(bd, OP_BR, t_void());
    v.t1 = b;
}

pub fn condbr(bd: *mut Builder, c: *mut Value, t: *mut Block, e: *mut Block) void {
    if c.kind == V_CINT {
        if c.cv != 0 {
            br(bd, t);
        } else {
            br(bd, e);
        }
        return;
    }
    let v = emit(bd, OP_CONDBR, t_void());
    v.a = c;
    v.t1 = t;
    v.t2 = e;
}

pub fn switch_(bd: *mut Builder, x: *mut Value, dflt: *mut Block) *mut Value {
    let v = emit(bd, OP_SWITCH, t_void());
    v.a = x;
    v.t1 = dflt;
    return v;
}

pub fn add_case(sw: *mut Value, c: *mut Value, b: *mut Block) void {
    sw.xs.push(c);
    bs_mut(sw).push(b);
}

pub fn ret(bd: *mut Builder, x: *mut Value) void {
    let v = emit(bd, OP_RET, t_void());
    v.a = x;
}

// A return of a result in registers (EXT_REGS): their values xs.
pub fn ret_regs(bd: *mut Builder, xs: []*mut Value) void {
    let v = emit(bd, OP_RET, t_void());
    for y in xs {
        v.xs.push(y);
    }
}

pub fn ret_void(bd: *mut Builder) void {
    _ = emit(bd, OP_RET, t_void());
}

pub fn unreachable(bd: *mut Builder) void {
    _ = emit(bd, OP_UNREACHABLE, t_void());
}

// -----------------------------------------------------------------------------
// Printing (for --emit=ir and debugging)
// -----------------------------------------------------------------------------
fn op_name(op: i32) []u8 {
    let names = ["?", "add", "sub", "mul", "udiv", "sdiv", "urem", "srem", "and", "or", "xor", "shl", "lshr", "ashr",
                 "fadd", "fsub", "fmul", "fdiv", "frem", "fneg", "icmp", "fcmp", "select", "zext", "sext", "trunc",
                 "bitcast", "ptrtoint", "inttoptr", "fpext", "fptrunc", "sitofp", "uitofp", "fptosi.sat", "fptoui.sat",
                 "alloca", "load", "store", "ptradd", "memcpy", "memmove", "memset", "atomicrmw", "cmpxchg", "fence",
                 "extractvalue", "insertvalue", "extractelement", "insertelement", "shuffle", "splat", "call", "intr",
                 "phi", "br", "condbr", "switch", "ret", "unreachable", "copy"];
    if (op < 0) or (@int_cast(usize, op) >= names.len) {
        return "?";
    }
    return names[@int_cast(usize, op)];
}

pub fn val_str(v: *Value) []u8 {
    let k = v.kind;
    if k == V_INST {
        return u.cat2("%", u.idec(v.id));
    }
    if k == V_PARAM {
        return u.cat2("%arg", u.udec(v.cv));
    }
    if k == V_CINT {
        if v.ty.bits == 1 {
            return u.pick(v.cv != 0, "true", "false");
        }
        return u.dec(sval(v));
    }
    if k == V_CFP {
        return u.ffmt("%g", fv_of(v));
    }
    if k == V_ZERO {
        return "zero";
    }
    if k == V_UNDEF {
        return "undef";
    }
    if k == V_GLOBAL {
        if v.cv != 0 {
            return u.f2("@%s+%s", gv_of(v).name, u.udec(v.cv));
        }
        return u.cat2("@", gv_of(v).name);
    }
    if k == V_FUNC {
        return u.cat2("@", fnp_of(v).name);
    }
    let mut b = u.Buf.init();
    b.s("{");
    for i in 0..agg_len(v) {
        if i != 0 {
            b.s(", ");
        }
        b.s(val_str(agg_elem(v, i)));
    }
    b.s("}");
    return b.done();
}

fn blk_str(b: *Block) []u8 {
    return u.f2("%%%s.%s", b.name, u.idec(b.id));
}

pub fn inst_str(v: *Value) []u8 {
    let mut b = u.Buf.init();
    if v.ty.kind != T_VOID {
        b.s(val_str(v));
        b.s(" = ");
    }
    b.s(op_name(v.op));
    if (v.op == OP_ICMP) or (v.op == OP_FCMP) or (v.op == OP_RMW) or (v.op == OP_INTR) or (v.op == OP_EXTRACTVALUE) or
       (v.op == OP_INSERTVALUE) or (v.op == OP_EXTRACTELEM) or (v.op == OP_INSERTELEM) {
        b.s(".");
        b.s(u.udec(v.cv));
    }
    if ((v.flags & F_ATOMIC) != 0) or (v.op == OP_FENCE) {
        if v.op != OP_FENCE {
            b.s(" atomic");
        }
        if (v.flags & F_WEAK) != 0 {
            b.s(" weak");
        }
        if (v.flags & F_SIGNAL) != 0 {
            b.s(" signal");
        }
        let names: [5][]u8 = ["", " relaxed", " acquire", " release", " acq_rel"];
        let o = @as(usize, order(v));
        if o < 5 {
            b.s(names[o]);
        }
        let fo = @as(usize, fail_order(v));
        if (v.op == OP_CMPXCHG) and (fo != o) and (fo < 5) {
            b.s(" fail");
            b.s(u.pick(fo == 0, " seq_cst", names[fo]));
        }
    }
    if (v.flags & F_VOLATILE) != 0 {
        b.s(" volatile");
    }
    if (v.op == OP_CALL) and ((v.flags & F_TAIL) != 0) {
        b.s(" tail");
    }
    if no_wrap(v, F_NSW) {
        b.s(" nsw");
    }
    if no_wrap(v, F_NUW) {
        b.s(" nuw");
    }
    b.s(" ");
    b.s(ty_str(v.ty));
    if v.op == OP_ALLOCA {
        b.s(" ");
        b.s(ty_str(aty_of(v)));
    }
    let ops: [3]*mut Value = [v.a, v.b, v.c];
    for o in ops {
        if u.notnil(o) {
            b.s(" ");
            b.s(val_str(o));
        }
    }
    for i in 0..v.xs.len {
        b.s(", ");
        b.s(val_str(v.xs.get(i)));
        if (v.op == OP_CALL) and ((i + 1) < ext_of(v).len) {
            if ext_of(v)[i + 1] == EXT_BYVAL {
                b.s(" byval");
            } else if ext_of(v)[i + 1] == EXT_SRET {
                b.s(" sret");
            }
        }
        if i < bs_of(v).len {
            b.s(" ");
            b.s(blk_str(bs_of(v).get(i)));
        }
    }
    if u.notnil(v.t1) {
        b.s(" -> ");
        b.s(blk_str(v.t1));
    }
    if u.notnil(v.t2) {
        b.s(", ");
        b.s(blk_str(v.t2));
    }
    if mask_of(v).len > 0 {
        b.s(" [");
        for i in 0..mask_of(v).len {
            if i != 0 {
                b.s(",");
            }
            b.s(u.idec(mask_of(v)[i]));
        }
        b.s("]");
    }
    if v.align != 0 {
        b.s(", align ");
        b.s(u.udec(@as(u64, v.align)));
    }
    return b.done();
}

pub fn func_str(f: *mut Func) []u8 {
    let mut b = u.Buf.init();
    b.s(u.pick(is_decl(f), "declare ", "define "));
    b.s(ty_str(f.ty.ret));
    b.s(" @");
    b.s(f.name);
    b.s("(");
    for i in 0..f.params.len {
        if i != 0 {
            b.s(", ");
        }
        b.s(ty_str(f.params[i].ty));
    }
    b.s(")");
    if is_decl(f) {
        b.s("\n");
        return b.done();
    }
    b.s(" {\n");
    let mut bb = f.first;
    while u.notnil(bb) {
        b.s(blk_str(bb));
        b.s(":\n");
        let mut i = bb.first;
        while u.notnil(i) {
            marks_str(&mut b, dbg_marks_at(i));
            b.s("    ");
            b.s(inst_str(i));
            b.s("\n");
            i = i.next;
        }
        marks_str(&mut b, dbg_marks_end(bb));
        bb = bb.next;
    }
    b.s("}\n");
    return b.done();
}

// The marks of chain k (-g: dbg_mark), one line each: "; var N[.off:size]
// (inline instance I) = value" (a kill: "?").
fn marks_str(b: *mut u.Buf, k0: i32) void {
    let mut k = k0;
    while k >= 0 {
        let m = dbg_marks.get(@int_cast(usize, k));
        b.s("    ; var ");
        b.s(u.idec(m.var));
        if m.size != 0 {
            b.s(u.f2(".%s:%s", u.idec(@bit_cast(i32, m.off)), u.idec(@bit_cast(i32, m.size))));
        }
        if m.inst != 0 {
            b.s(u.f2(" (%s %s)", m.owner.name, u.idec(@bit_cast(i32, m.inst))));
        }
        let v = dbg_mark_value(k);
        if u.isnil(v) {
            b.s(" = ?\n");
        } else {
            b.s(" = ");
            b.s(val_str(v));
            if dbg_mark_low(k) {
                b.s(" (low)");
            }
            let a = dbg_mark_add(k);
            if a != 0 {
                b.s(u.f1(" + %s", u.idec(@truncate(i32, a))));
            }
            b.s("\n");
        }
        k = m.next;
    }
}

pub fn module_str(m: *mut Module) []u8 {
    let mut b = u.Buf.init();
    for i in 0..m.globals.len {
        let g = m.globals.get(i);
        b.s("@");
        b.s(g.name);
        b.s(" = ");
        b.s(u.pick(g.is_const, "constant ", "global "));
        b.s(ty_str(g.ty));
        if u.notnil(g.init) {
            b.s(" ");
            b.s(val_str(g.init));
        }
        b.s("\n");
    }
    for i in 0..m.funcs.len {
        b.s("\n");
        b.s(func_str(m.funcs.get(i)));
    }
    return b.done();
}

// -----------------------------------------------------------------------------
// CFG utilities
// -----------------------------------------------------------------------------
// Deletes the blocks not reachable from the entry, and the phi inputs that
// came from them.
pub fn remove_unreachable(f: *mut Func) void {
    if u.isnil(f.first) {
        return;
    }
    let mut b = f.first;
    while u.notnil(b) {
        b.aux = 0;
        b = b.next;
    }
    let mut work = u.List.[*mut Block].empty();
    f.first.aux = 1;
    work.push(f.first);
    while work.len > 0 {
        let x = work.pop();
        let t = terminator(x);
        for i in 0..succ_count(t) {
            let s = succ(t, i);
            if s.aux == 0 {
                s.aux = 1;
                work.push(s);
            }
        }
    }
    work.deinit();
    b = f.first;
    let mut any = false;
    while u.notnil(b) {
        let next = b.next;
        if b.aux == 0 {
            remove_unreached_block(b);
            any = true;
        }
        b = next;
    }
    if not any {
        return;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) and (i.op == OP_PHI) {
            let mut k: usize = 0;
            while k < bs_of(i).len {
                if bs_of(i).get(k).aux == 0 {
                    remove_incoming(i, k);
                } else {
                    k += 1;
                }
            }
            i = i.next;
        }
        b = b.next;
    }
}

fn resolve_const(c: *mut Value) void {
    if c.kind != V_CAGG {
        return;
    }
    for k in 0..c.xs.len {
        let x = resolve(c.xs.get(k));
        c.xs.set(k, x);
        resolve_const(x);
    }
}

// Declarations of a function the module also defines (an extern "C" block
// naming a runtime export, say) refer to the definition. Same for globals.
pub fn merge_same_named(m: *mut Module) void {
    let mut defs = u.SymMap.[*mut Func].{ keys: u.nil.[usize](), vals: u.nil.[*mut Func](), cap: 0, len: 0 };
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if not is_decl(f) and (f.linkage != LINK_INTERNAL) {
            defs.put(f.name, f);
        }
    }
    let mut any = false;
    // an alias's name, declared (by another C unit): its target, unless a
    // definition of the name overrides a weak alias
    for k in 0..m.aliases.len {
        let a = m.aliases.at(k);
        let af = alias_func(m, a);
        if u.notnil(af) and u.isnil(defs.get(a.name)) {
            defs.put(a.name, af);
        }
        let ag = alias_global(m, a);
        let dg = m.gmap.get(a.name);
        if u.notnil(ag) and u.notnil(dg) and u.isnil(dg.init) and (dg != ag) {
            forward(dg.val, ag.val);
            any = true;
        }
    }
    let mut kept = u.List.[*mut Func].empty();
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if is_decl(f) {
            let d = defs.get(f.name);
            if u.notnil(d) {
                forward(f.val, d.val);
                any = true;
                continue;
            }
        }
        f.id = @int_cast(i32, kept.len);
        kept.push(f);
    }
    if not any {
        return;
    }
    m.funcs = kept;
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        m.fmap.put(f.name, f);
        apply_forwarding(f);
    }
    for i in 0..m.globals.len {
        let g = m.globals.get(i);
        if u.notnil(g.init) {
            g.init = resolve(g.init);
            resolve_const(g.init);
        }
    }
}
