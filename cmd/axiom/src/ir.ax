];

// Inline assembly (IN_ASM, whose first operand is its index in asm/inline.ax's
// table): what each statement is, for the passes (the front end notes it:
// note_asm). ASM_NODUP: its template defines symbols (named labels), so
// the statement is not copied (inlined, unrolled, threaded). ASM_PURE: not
// volatile, no "memory" clobber and no memory operands, its outputs in
// registers (IN_CALL_RESULT(asm, k): output operand k): a function of its
// inputs, which is removed when its outputs are unused and may be merged
// with an equal one or moved (INF_PURE). ASM_HINT: volatile, but with no
// "memory" clobber and no memory operands: kept where it is, and no
// barrier to memory accesses (INF_HINT). Neither: it may read and write
// any memory (INF_OPAQUE: a "memory" clobber, memory operands, operands in
// registers the compiler does not allocate, asm goto).
pub const ASM_NODUP: u32 = 1;
pub const ASM_PURE: u32 = 2;
pub const ASM_HINT: u32 = 4;
pub const ASM_STACK: u32 = 8;  // its template calls, or uses the stack (pushes, pops, names the stack pointer): its function makes no sibling calls
// ASM_EXACT: memory operands but no "memory" clobber (not asm goto, nor a
// template that calls): the statement reads its input memory operands'
// objects and writes its output ones', and no other memory (the dialect's
// rule; asm_mem lists them). It stays INF_OPAQUE for the passes that do not
// ask (gvn.ax's memory reasoning does: exact_asm).
pub const ASM_EXACT: u32 = 16;
pub let mut asm_flags: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };

/// A memory operand of an ASM_EXACT statement: its address is the IN_ASM's
/// operand `arg`, the object `size` bytes (-1: unknown), read and/or written.
pub struct AsmMem {
    arg: u32,
    size: i64,
    rd: bool,
    wr: bool,
}

pub let mut asm_mems: u.List.[[]AsmMem] = u.List.[[]AsmMem].{ data: @ptr_from_int(*mut []AsmMem, 0), len: 0, cap: 0 };

/// Notes the memory operands of the ASM_EXACT statement of index k (ms: in
/// permanent memory).
pub fn note_asm_mem(k: i64, ms: []AsmMem) void {
    let n = @int_cast(usize, k);
    while asm_mems.len <= n {
        asm_mems.push(ms[0..0]);
    }
    asm_mems.set(n, ms);
}

/// The memory operands of IN_ASM v, an ASM_EXACT statement (asm_of).
pub fn asm_mem_of(v: *Value) []AsmMem {
    let k = @int_cast(usize, cint_val(v.xs.get(0)));
    return asm_mems.get(k);
}

/// Notes the flags (ASM_*) of the asm statement of index k.
pub fn note_asm(k: i64, flags: u32) void {
    let n = @int_cast(usize, k);
    while asm_flags.len <= n {
        asm_flags.push(0);
    }
    asm_flags.set(n, flags);
}

/// The ASM_* flags of IN_ASM v (0 for another instruction).
pub fn asm_of(v: *Value) u32 {
    if (intr_id(v) != IN_ASM) or (v.xs.len == 0) or not is_cint(v.xs.get(0)) {
        return 0;
    }
    let k = @int_cast(usize, cint_val(v.xs.get(0)));
    if k >= asm_flags.len {
        return 0;
    }
    return asm_flags.get(k);
}

/// The INF_* properties of intrinsic v: its intrinsic's, but an asm
/// statement's are its own (ASM_*), and the results of a pure one
/// (IN_CALL_RESULT of it) are pure too.
pub fn inst_props(v: *Value) u32 {
    let id = intr_id(v);
    if id == IN_ASM {
        let f = asm_of(v);
        if (f & ASM_PURE) != 0 {
            return INF_PURE;
        }
        if (f & ASM_HINT) != 0 {
            return INF_HINT;
        }
        return INF_OPAQUE;
    }
    if (id == IN_CALL_RESULT) and (v.xs.len > 0) {
        let c = resolve(v.xs.get(0));
        if (intr_id(c) == IN_ASM) and ((asm_of(c) & ASM_PURE) != 0) {
            return INF_PURE;
        }
    }
    return intr_props(id);
}

/// Is intrinsic v pure (inst_props)?
pub fn inst_pure(v: *Value) bool {
    return (inst_props(v) & INF_PURE) != 0;
}

/// Is intrinsic v opaque (inst_props)?
pub fn inst_opaque(v: *Value) bool {
    return (inst_props(v) & INF_OPAQUE) != 0;
}

/// Does intrinsic v write memory, or might it (inst_props)?
pub fn inst_writes_mem(v: *Value) bool {
    return (inst_props(v) & (INF_WRITES_MEM | INF_OPAQUE)) != 0;
}

/// Must intrinsic v be kept though its result is unused (inst_props)?
pub fn inst_has_effects(v: *Value) bool {
    return (inst_props(v) & (INF_WRITES_MEM | INF_HINT | INF_OPAQUE)) != 0;
}

/// May instruction v be copied (a statement of inline assembly whose
/// template defines symbols may not)?
pub fn can_copy(v: *Value) bool {
    return (asm_of(v) & ASM_NODUP) == 0;
}

/// May block b's instructions be copied?
pub fn can_copy_block(b: *Block) bool {
    let mut i = b.first;
    while u.notnil(i) {
        if not can_copy(i) {
            return false;
        }
        i = i.next;
    }
    return true;
}

pub fn intr_props(id: i32) u32 {
    if (id < 0) or (id > IN_RESTRICT) {
        return 0;
    }
    return IN_PROPS[@int_cast(usize, id)];
}

pub fn is_int_binop(op: i32) bool {
    return (op_props(op) & OPF_INT_BINOP) != 0;
}

// Integer or floating point (OP_ADD .. OP_FREM).
pub fn is_binop(op: i32) bool {
    return (op_props(op) & (OPF_INT_BINOP | OPF_FP_BINOP)) != 0;
}

pub fn is_cast(op: i32) bool {
    return (op_props(op) & OPF_CAST) != 0;
}

pub fn is_int_div(op: i32) bool {
    return (op_props(op) & OPF_DIV) != 0;
}

pub fn op_pure(op: i32) bool {
    return (op_props(op) & OPF_PURE) != 0;
}

pub fn op_writes_mem(op: i32) bool {
    return (op_props(op) & OPF_WRITES_MEM) != 0;
}

// Reads or writes memory.
pub fn op_accesses_mem(op: i32) bool {
    return (op_props(op) & OPF_MEM) != 0;
}

pub fn intr_pure(id: i32) bool {
    return (intr_props(id) & INF_PURE) != 0;
}

pub fn intr_lanewise(id: i32) bool {
    return (intr_props(id) & INF_LANEWISE) != 0;
}

pub fn intr_opaque(id: i32) bool {
    return (intr_props(id) & INF_OPAQUE) != 0;
}

// Writes memory, or might (the opaque ones).
pub fn intr_writes_mem(id: i32) bool {
    return (intr_props(id) & (INF_WRITES_MEM | INF_OPAQUE)) != 0;
}

// Must be kept though its result is unused: all but the pure ones and the
// loads.
pub fn intr_has_effects(id: i32) bool {
    return (intr_props(id) & (INF_WRITES_MEM | INF_HINT | INF_OPAQUE)) != 0;
}

// Argument and parameter marks (CALL ext, Func.param_ext) besides 1 (zext)
// and 2 (sext), set by lowering for the address of an aggregate:
pub const EXT_BYVAL: u8 = 3;  // passed by value: the callee only reads it
pub const EXT_SRET: u8 = 4;   // the result's memory: the call writes it (a parameter: the
                              // caller's fresh slot, which nothing else uses)
// The C front end's marks for the platforms' C calling conventions
// (c/cgen_abi.ax); Axiom code has none of them:
pub const EXT_X8SRET: u8 = 5;  // the address of the result's memory, passed in x8 (AArch64), not as a parameter
// A result in 1 to 4 registers (a structure: System V's rax, rdx, xmm0,
// xmm1; AArch64's x0, x1 or v0-v3), as the result's mark (a call's ext[0],
// a function's ret_ext) says. The IR signature's result is void: the call's
// registers are IN_CALL_RESULT(call, k), k from 0, and the function's
// returns return their values as their xs, in order (their a is nil). (No
// pass can then replace the call by another value, nor a return's values
// by none.) The bits below EXT_REGS: the count less one, and which are
// floating-point.
pub const EXT_REGS: u8 = 0x80;
pub const EXT_REGS_FP0: u8 = 0x08;  // shifted left by the register's place (0 to 3)

// Load/store flags
pub const F_VOLATILE: u32 = 1;
pub const F_ATOMIC: u32 = 2;  // atomic (of the memory order the F_ORD bits give: 0 is sequentially consistent)
// The memory order of an atomic load, store, rmw, cmpxchg (its success's) or
// fence: (flags >> F_ORD_SHIFT) & 7, one of the ORD_ values, 0 (seq_cst)
// by default; a cmpxchg's order on failure in the bits F_FAIL_SHIFT (an
// order no stronger than what the backends use is always valid: they may
// implement any order by a stronger one). Only the backends weaken their
// instructions by them; the optimizer treats every atomic operation and
// fence, whatever its order, as it treats a sequentially consistent one
// (it does not move memory accesses across it, merge it or remove it):
// valid for every order, since a weaker order only allows more behaviours.
pub const F_ORD_SHIFT: u32 = 8;
pub const F_ORD_MASK: u32 = 0x700;
pub const F_FAIL_SHIFT: u32 = 11;
pub const F_FAIL_MASK: u32 = 0x3800;
// A cmpxchg that may fail spuriously (C's compare_exchange_weak): its
// success is IN_CMPXCHG_OK(cas) (an i1), not old == expected.
pub const F_WEAK: u32 = 0x4000;
// A fence that orders the thread's accesses only for its own signal
// handlers (atomic_signal_fence): no instruction, but the optimizer and
// the backends keep accesses on their side of it.
pub const F_SIGNAL: u32 = 0x8000;
pub const ORD_SEQ_CST: u32 = 0;
pub const ORD_RELAXED: u32 = 1;
pub const ORD_ACQUIRE: u32 = 2;  // (and consume, which is implemented as acquire)
pub const ORD_RELEASE: u32 = 3;
pub const ORD_ACQ_REL: u32 = 4;

/// The parameter p is based on (through ptradds, and the phis and selects
/// whose operands all are based on it, or step from the phi itself), or nil.
pub fn based_param(p0: *mut Value) *mut Value {
    return based_rec(p0, 0, false);
}

/// The IN_RESTRICT that p is based on (as based_param), or nil.
pub fn based_restrict(p0: *mut Value) *mut Value {
    return based_rec(p0, 0, true);
}

fn is_restrict_root(p: *Value) bool {
    return is_op(p, OP_INTR) and (intr_id(p) == IN_RESTRICT);
}

fn based_rec(p0: *mut Value, depth: i32, restr: bool) *mut Value {
    let mut p = resolve(p0);
    let mut n: i32 = 0;
    while is_op(p, OP_PTRADD) and (n < 32) {
        p = resolve(p.a);
        n += 1;
    }
    if u.isnil(p) {
        return p;
    }
    if (p.kind == V_PARAM) and not restr {
        return p;
    }
    if is_restrict_root(p) {
        if restr {
            return p;
        }
        if depth < 4 {
            return based_rec(p.xs.get(0), depth + 1, false);  // (what the pointer read is based on)
        }
        return u.nil.[Value]();
    }
    if (depth >= 4) or (p.kind != V_INST) or ((p.op != OP_PHI) and (p.op != OP_SELECT)) {
        return u.nil.[Value]();
    }
    let mut r = u.nil.[Value]();
    let mut k: usize = 0;
    let mut n_ops: usize = 2;
    if p.op == OP_PHI {
        n_ops = p.xs.len;
    }
    while k < n_ops {
        let mut x = u.nil.[Value]();
        if p.op == OP_PHI {
            x = p.xs.get(k);
        } else if k == 0 {
            x = p.b;
        } else {
            x = p.c;
        }
        // (a step from the phi itself: p + k ...)
        let mut y = resolve(x);
        let mut m: i32 = 0;
        while is_op(y, OP_PTRADD) and (m < 32) {
            y = resolve(y.a);
            m += 1;
        }
        if y != p {
            let q = based_rec(x, depth + 1, restr);
            if u.isnil(q) or (u.notnil(r) and (q != r)) {
                return u.nil.[Value]();
            }
            r = q;
        }
        k += 1;
    }
    return r;
}

/// Are accesses through pointers based on a and on b apart: two different
/// objects (objects_apart), or by C's restrict (F_NOALIAS: see above), one
/// based on a noalias parameter and the other on another parameter, a
/// global or a stack slot (resolved roots ra and rb, from based_param or the
/// objects under the ptradds)?
pub fn restrict_apart(ra0: *Value, rb0: *Value) bool {
    if u.isnil(ra0) or u.isnil(rb0) or (ra0 == rb0) {
        return false;
    }
    let mut ra = ra0;
    let mut rb = rb0;
    if is_restrict_root(ra) and is_restrict_root(rb) and scoped_apart(ra, rb) {
        return true;
    }
    if in_own_struct(ra, rb) or in_own_struct(rb, ra) {
        return true;
    }
    // (else what the restricted pointers read are based on)
    if is_restrict_root(ra) {
        ra = based_rec(ra.xs.get(0), 1, false);
    }
    if is_restrict_root(rb) {
        rb = based_rec(rb.xs.get(0), 1, false);
    }
    if u.isnil(ra) or u.isnil(rb) or (ra == rb) {
        return false;
    }
    if objects_apart(ra, rb) {
        return true;
    }
    let na = (ra.kind == V_PARAM) and ((ra.flags & F_NOALIAS) != 0);
    let nb = (rb.kind == V_PARAM) and ((rb.flags & F_NOALIAS) != 0);
    if not na and not nb {
        return false;
    }
    return distinct_root(ra) and distinct_root(rb);
}

// Are IN_RESTRICTs a and b two restricted pointer objects of one scope, or
// two restrict-qualified members of one structure object (IN_RESTRICT)?
fn scoped_apart(a: *Value, b: *Value) bool {
    if (a.xs.len != 3) or (b.xs.len != 3) {
        return false;
    }
    let sa = resolve(a.xs.get(1));
    let sb = resolve(b.xs.get(1));
    if (sa != sb) or not is_cint(a.xs.get(2)) or not is_cint(b.xs.get(2)) {
        return false;
    }
    return cint_val(a.xs.get(2)) != cint_val(b.xs.get(2));
}

// Is r a restrict-qualified member's read (IN_RESTRICT) from a structure
// object that is the stack slot or global o (whose address is based on no
// pointer), which accesses based on o reach without it? Then an access
// through r that writes an object another access reaches without it is
// undefined (6.7.3.1p4), the structure's own bytes too.
fn in_own_struct(r: *Value, o: *Value) bool {
    if not is_restrict_root(r) or (r.xs.len != 3) or u.isnil(o) or not ((o.kind == V_GLOBAL) or is_op(o, OP_ALLOCA)) {
        return false;
    }
    let s = resolve(r.xs.get(1));
    if is_op(s, OP_INTR) and (intr_id(s) == IN_RSCOPE) {
        return false;
    }
    return @int_from_ptr(s) == @int_from_ptr(o);
}

/// Are a and b two different objects: globals (not aliases of one another)
/// or stack slots? Accesses through addresses based on them are apart.
pub fn objects_apart(a: *Value, b: *Value) bool {
    if u.isnil(a) or u.isnil(b) or (a == b) {
        return false;
    }
    let ao = (a.kind == V_GLOBAL) or is_op(a, OP_ALLOCA);
    let bo = (b.kind == V_GLOBAL) or is_op(b, OP_ALLOCA);
    return ao and bo;
}

fn distinct_root(r: *Value) bool {
    return (r.kind == V_PARAM) or (r.kind == V_GLOBAL) or is_op(r, OP_ALLOCA);
}

/// The memory order of atomic operation or fence v (ORD_).
pub fn order(v: *Value) u32 {
    return (v.flags & F_ORD_MASK) >> F_ORD_SHIFT;
}

/// The memory order of cmpxchg v on failure (ORD_).
pub fn fail_order(v: *Value) u32 {
    return (v.flags & F_FAIL_MASK) >> F_FAIL_SHIFT;
}

/// Sets the memory order of atomic operation or fence v (and, of a cmpxchg,
/// its order on failure).
pub fn set_order(v: *mut Value, o: u32, fail: u32) void {
    v.flags = (v.flags & ~(F_ORD_MASK | F_FAIL_MASK)) | ((o << F_ORD_SHIFT) & F_ORD_MASK) |
              ((fail << F_FAIL_SHIFT) & F_FAIL_MASK);
}

/// Does order o (ORD_) make an operation acquire (its reads)?
pub fn ord_acquires(o: u32) bool {
    return (o == ORD_SEQ_CST) or (o == ORD_ACQUIRE) or (o == ORD_ACQ_REL);
}

/// Does order o make an operation release (its writes)?
pub fn ord_releases(o: u32) bool {
    return (o == ORD_SEQ_CST) or (o == ORD_RELEASE) or (o == ORD_ACQ_REL);
}

/// The one order at least as strong as both a cmpxchg's success order s and
/// its failure order f (what one instruction for it must have).
pub fn ord_join(s: u32, f: u32) u32 {
    if (s == ORD_SEQ_CST) or (f == ORD_SEQ_CST) {
        return ORD_SEQ_CST;
    }
    let acq = ord_acquires(s) or ord_acquires(f);
    let rel = ord_releases(s) or ord_releases(f);
    if acq and rel {
        return ORD_ACQ_REL;
    }
    if acq {
        return ORD_ACQUIRE;
    }
    if rel {
        return ORD_RELEASE;
    }
    return ORD_RELAXED;
}
// Call flags
pub const F_TAIL: u32 = 4;  // a sibling call: the backend may jump to the callee (tailrec.ax: mark_sibling_calls)
// Flags of add, sub, mul and shl (integers): the operation does not overflow
// as a signed (F_NSW) or as an unsigned (F_NUW) operation, as integers of any
// width (for shl: the bits shifted out are copies of the result's sign bit,
// or zeros). A front end sets one only where an overflow would be undefined
// behaviour (C's signed arithmetic) or cannot happen (the step of a range
// loop, an operation checked for overflow before its result is used). Passes
// may then compute what depends on the result differently in the case of an
// overflow: sext(a +nsw b) as sext(a) + sext(b), a counter widened. Moving or
// copying the instruction keeps the flag (where an overflowed result is
// computed speculatively, nothing that matters uses it); a pass that changes
// an operation's operands or operator in place clears it (no_wrap_clear),
// and one that replaces an operation by an equal one keeps only the flags
// both have (no_wrap_meet).
pub const F_NSW: u32 = 8;
pub const F_NUW: u32 = 16;
pub const F_NO_WRAP: u32 = 24;
// Parameter flags
// F_NOALIAS: a pointer parameter whose pointee, while the function runs, is
// not accessed through a pointer that is not based on it when either
// access writes (C's restrict, 6.7.3.1; the front ends set it only where
// the language says so). Passes may then take an access through the
// parameter plus offsets (based_param) as apart from one through another
// parameter, a global or a stack slot (based_param, gvn.may_alias,
// idioms.ax); nothing else (a pointer loaded from memory may be based on
// it). A copy of the function's body elsewhere (inlining) has no
// parameter, so the fact is not carried there.
pub const F_NOALIAS: u32 = 0x10000;
// F_NONNULL: a pointer parameter that is never null when the function is
// called (C's attribute nonnull, a parameter declared `[static n]`: a call
// with a null pointer there is undefined): passes may fold a test of it
// against null (known_nonnull). Not carried to a copy of the body elsewhere.
pub const F_NONNULL: u32 = 0x20000;
// Alloca flags
pub const F_VAR: u32 = 32;  // a C variable: -O0 keeps it in memory (opt.mem2reg), where debuggers find it
// An fcmp of an ordered relation (<, <=, >, >=) that signals: "invalid" for
// any NaN operand, quiet or signaling (IEEE 754's compareSignaling: C's
// relational operators, F.9.3), where the plain one does for a signaling
// NaN only (isless ...)
pub const F_SIGNALING: u32 = 64;

// Does v (an add, sub, mul or shl) have flag fl (F_NSW, F_NUW)?
pub fn no_wrap(v: *Value, fl: u32) bool {
    if u.isnil(v) or (v.kind != V_INST) or ((v.flags & fl) == 0) {
        return false;
    }
    let op = v.op;
    return (op == OP_ADD) or (op == OP_SUB) or (op == OP_MUL) or (op == OP_SHL);
}

// v's operands or operator changed: the flags no longer hold.
pub fn no_wrap_clear(v: *mut Value) void {
    v.flags = v.flags & ~F_NO_WRAP;
}

// v takes the place of w (an equal value): v's flags only where both have them.
pub fn no_wrap_meet(v: *mut Value, w: *Value) void {
    if u.notnil(v) and (v.kind == V_INST) and ((v.flags & F_NO_WRAP) != 0) {
        let keep = (w.kind == V_INST) and (w.op == v.op);
        if keep {
            v.flags = v.flags & (w.flags | ~F_NO_WRAP);
        } else {
            no_wrap_clear(v);
        }
    }
}

// An OP_MEMMOVE whose destination and source are the same bytes or apart,
// never partly overlapping (a C structure assignment, C11 6.5.16.1p3), for
// which a forward copy is correct: marked by its cv (which memory
// operations have no other use for). Passes that make a new memmove, or
// change an operand of one to another object, leave the mark out.
pub const MEMMOVE_SAME_OR_APART: u64 = 1;

pub fn same_or_apart(v: *Value) bool {
    return (v.op == OP_MEMMOVE) and (v.cv == MEMMOVE_SAME_OR_APART);
}

pub struct Value {
    // the fields every walk over the IR reads come first (two cache lines)
    kind: ValueKind,
    op: i32,
    ty: *mut Ty,
    a: *mut Value,
    b: *mut Value,
    c: *mut Value,
    xs: u.List.[*mut Value],
    next: *mut Value,
    prev: *mut Value,
    blk: *mut Block,
    fwd: *mut Value,   // replacement (passes forward uses through resolve())
    user: *mut Value,  // the only user (when uses == 1)
    uses: i32,
    flags: u32,
    cv: u64,
    id: i32,
    align: u32,
    t1: *mut Block,
    t2: *mut Block,
    more: usize,  // a record of what few values have (bs_of, ...), or 0
    aux: i64,     // pass / backend scratch
    aux2: i64,
    auxp: *mut void,
    // backend scratch
    pos: i32,  // position in its block
    loc: i32,  // local / virtual register
    flag: i32,
    grave: u32,  // 1 + its index in the graveyard (0: not there)
    src: u32,    // where in the source it comes from (src_loc), 0: not known
    scope: u32,  // -g: the lexical block it is in (dbginfo.ax's scopes), 0: its function's outermost
}

// The fields of a Value that few values have: phis' and switches' blocks,
// calls' signatures, allocas' types, shuffles' masks, and the constants'
// values and referents. They are in a record (Value.more) only once one of
// them is set, which for most values none ever is: a small one with the
// fields of one group (the blocks of a PHI or SWITCH, a CALL's, an ALLOCA's,
// a SHUFFLE's mask, a constant's, a string's bytes), or, once a value has fields of two
// groups, a ValueMore with all of them. A record starts with its group (an
// operation may change in place: the group, not the op, says what the record
// holds). <field>_of(v) reads one (zero if v has none), set_<field>(v, x)
// sets it (setting zero where there is none makes no record), and
// <field>_mut(v) is its address. Records of dead values are reused.
pub struct VmBlocks {
    g: u8,
    bs: u.List.[*mut Block],  // PHI, SWITCH: the blocks
}

pub struct VmCall {
    g: u8,
    fty: *mut Ty,       // CALL: signature
    ext: []mut u8,      // CALL: argument extension (0 none, 1 zext, 2 sext)
    chain: *mut Chain,  // CALL, native frame tables: the call-site records (see Chain)
}

pub struct VmAlloca {
    g: u8,
    aty: *mut Ty,  // ALLOCA: allocated type
    name: []u8,    // ALLOCA, PARAM: a name for people
}

pub struct VmMask {
    g: u8,
    mask: []mut i32,  // SHUFFLE
}

pub struct VmConst {
    g: u8,
    fv: f64,          // CFP: the value
    gv: *mut Global,  // GLOBAL: the global
    fnp: *mut Func,   // FUNC, PARAM: the function
    name: []u8,       // ALLOCA, PARAM: a name for people
}

pub struct ValueMore {
    g: u8,
    bs: u.List.[*mut Block],  // PHI, SWITCH: the blocks
    fv: f64,                  // CFP: the value
    aty: *mut Ty,             // ALLOCA: allocated type
    fty: *mut Ty,             // CALL: signature
    mask: []mut i32,          // SHUFFLE
    ext: []mut u8,            // CALL: argument extension (0 none, 1 zext, 2 sext)
    gv: *mut Global,          // GLOBAL: the global
    fnp: *mut Func,           // FUNC, PARAM: the function
    name: []u8,               // ALLOCA, PARAM: a name for people
    chain: *mut Chain,        // CALL, native frame tables: the call-site records (see Chain)
    bytes: []u8,              // CSTR: the bytes (the last a NUL)
}

pub struct VmBytes {
    g: u8,
    bytes: []u8,  // CSTR: the bytes (the last a NUL)
}

// The group of v's record (0: none).
fn more_group(v: *Value) u8 {
    if v.more == 0 {
        return 0;
    }
    return @ptr_from_int(*u8, v.more).*;
}

let mut no_more: *mut ValueMore = @ptr_from_int(*mut ValueMore, 0);

fn zero_more() *ValueMore {
    if u.isnil(no_more) {
        no_more = u.perm_new.[ValueMore]();
    }
    return no_more;
}

// Records of dead values, for reuse, by group.
let mut free_more: [8]u.List.[usize] = [u.List.[usize].{ data: @ptr_from_int(*mut usize, 0), len: 0, cap: 0 }; 8];

fn new_more(g: u8) usize {
    let k = @as(usize, g);
    if free_more[k].len > 0 {
        let r = free_more[k].pop();
        @mem_set(@slice_from_ptr(@ptr_from_int(*mut u8, r), more_size(g)), 0);
        @ptr_from_int(*mut u8, r).* = g;
        return r;
    }
    let mut r: usize = 0;
    match g {
        1    => { r = @int_from_ptr(u.perm_new.[VmBlocks]()); }
        2    => { r = @int_from_ptr(u.perm_new.[VmCall]()); }
        3    => { r = @int_from_ptr(u.perm_new.[VmAlloca]()); }
        4    => { r = @int_from_ptr(u.perm_new.[VmMask]()); }
        5    => { r = @int_from_ptr(u.perm_new.[VmConst]()); }
        6    => { r = @int_from_ptr(u.perm_new.[ValueMore]()); }
        7    => { r = @int_from_ptr(u.perm_new.[VmBytes]()); }
        else => { u.die("more_new: no such group"); }
    }
    @ptr_from_int(*mut u8, r).* = g;
    return r;
}

fn more_size(g: u8) usize {
    match g {
        1    => { return @size_of(VmBlocks); }
        2    => { return @size_of(VmCall); }
        3    => { return @size_of(VmAlloca); }
        4    => { return @size_of(VmMask); }
        5    => { return @size_of(VmConst); }
        6    => { return @size_of(ValueMore); }
        7    => { return @size_of(VmBytes); }
        else => { return 0; }
    }
}

// v's record as a ValueMore (with every field), made from the one it has.
fn more_full(v: *mut Value) *mut ValueMore {
    let g = more_group(v);
    if g == 6 {
        return @ptr_from_int(*mut ValueMore, v.more);
    }
    let r = new_more(6);
    let m = @ptr_from_int(*mut ValueMore, r);
    match g {
        1 => {
            let o = @ptr_from_int(*mut VmBlocks, v.more);
            m.bs = o.bs;
        }
        2 => {
            let o = @ptr_from_int(*mut VmCall, v.more);
            m.fty = o.fty;
            m.ext = o.ext;
            m.chain = o.chain;
        }
        3 => {
            let o = @ptr_from_int(*mut VmAlloca, v.more);
            m.aty = o.aty;
            m.name = o.name;
        }
        4 => {
            let o = @ptr_from_int(*mut VmMask, v.more);
            m.mask = o.mask;
        }
        5 => {
            let o = @ptr_from_int(*mut VmConst, v.more);
            m.fv = o.fv;
            m.gv = o.gv;
            m.fnp = o.fnp;
            m.name = o.name;
        }
        7 => {
            let o = @ptr_from_int(*mut VmBytes, v.more);
            m.bytes = o.bytes;
        }
        else => {}
    }
    if g != 0 {
        free_more[@as(usize, g)].push(v.more);
    }
    v.more = r;
    return m;
}

// Gives back v's record (its block list freed), for reuse.
fn release_more(v: *mut Value) void {
    let g = more_group(v);
    if g == 0 {
        return;
    }
    if g == 1 {
        @ptr_from_int(*mut VmBlocks, v.more).bs.deinit();
    } else if g == 6 {
        @ptr_from_int(*mut ValueMore, v.more).bs.deinit();
    }
    if not u.poisoning() {
        free_more[@as(usize, g)].push(v.more);
    }
    v.more = 0;
}

// y gets a record like v's (with a block list of its own).
fn copy_more(y: *mut Value, v: *Value) void {
    let g = more_group(v);
    if g == 0 {
        return;
    }
    let r = new_more(g);
    @mem_copy(@slice_from_ptr(@ptr_from_int(*mut u8, r), more_size(g)),
              @slice_from_ptr(@ptr_from_int(*u8, v.more), more_size(g)));
    if g == 1 {
        @ptr_from_int(*mut VmBlocks, r).bs = u.List.[*mut Block].empty();
    } else if g == 6 {
        @ptr_from_int(*mut ValueMore, r).bs = u.List.[*mut Block].empty();
    }
    y.more = r;
}

pub fn bs_of(v: *Value) u.List.[*mut Block] {
    match more_group(v) {
        1    => { return @ptr_from_int(*VmBlocks, v.more).bs; }
        6    => { return @ptr_from_int(*ValueMore, v.more).bs; }
        else => { return zero_more().bs; }
    }
}

pub fn bs_mut(v: *mut Value) *mut u.List.[*mut Block] {
    if v.more == 0 {
        v.more = new_more(1);
    }
    match more_group(v) {
        1    => { return &mut @ptr_from_int(*mut VmBlocks, v.more).bs; }
        6    => { return &mut @ptr_from_int(*mut ValueMore, v.more).bs; }
        else => { return &mut more_full(v).bs; }
    }
}

pub fn set_bs(v: *mut Value, x: u.List.[*mut Block]) void {
    if (v.more == 0) and ((x.len == 0) and (x.cap == 0)) {
        return;
    }
    bs_mut(v).* = x;
}

