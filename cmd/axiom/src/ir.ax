pub const RMW_SUB: i32 = 2;
pub const RMW_AND: i32 = 3;
pub const RMW_OR: i32 = 5;
pub const RMW_XOR: i32 = 6;
pub const RMW_MAX: i32 = 7;
pub const RMW_MIN: i32 = 8;
