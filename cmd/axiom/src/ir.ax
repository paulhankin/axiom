// =============================================================================
// ir.ax - the compiler's intermediate representation: typed SSA in basic
// blocks, in the style of LLVM IR, and the builder the code generator uses
// to create it.
//
// Values are one struct (`Value`) for everything: constants, globals,
// functions, parameters and instructions. Aggregates (structs and arrays) may
// be SSA values when codegen builds the IR; lower.ax turns them into memory
// before the target backends run, which only see scalars (integers, floats,
// pointers and 128-bit vectors).
//
// The builder folds constant integer operations, like LLVM's IRBuilder, so a
// check whose condition is a constant disappears when the IR is built.
// =============================================================================
import "util.ax" as u;

// -----------------------------------------------------------------------------
// Types
// -----------------------------------------------------------------------------
// What an IR type is (Ty.kind).
pub enum TyKind {
    VOID,
    INT,
    FLOAT,
    PTR,
    VEC,
    ARRAY,
    STRUCT,
    FN,
}

pub const T_VOID: TyKind = TyKind.VOID;
pub const T_INT: TyKind = TyKind.INT;      // bits: 1, 8, 16, 32, 64, 128
pub const T_FLOAT: TyKind = TyKind.FLOAT;  // bits: 32, 64
pub const T_PTR: TyKind = TyKind.PTR;
pub const T_VEC: TyKind = TyKind.VEC;        // elem (INT or FLOAT lane), lanes
pub const T_ARRAY: TyKind = TyKind.ARRAY;    // elem, count
pub const T_STRUCT: TyKind = TyKind.STRUCT;  // fields, offs
pub const T_FN: TyKind = TyKind.FN;          // ret, params, vararg

pub struct Ty {
    kind: TyKind,
    bits: i32,
    lanes: i32,
    elem: *mut Ty,
    count: u64,
    fields: []mut *mut Ty,
    offs: []mut u64,
    ret: *mut Ty,
    params: []mut *mut Ty,
    vararg: bool,
    size: u64,
    align: u64,
    name: []u8,
    has_body: bool,
    id: i32,
    undef_v: *mut Value,  // the type's undef (made on first use, shared)
}

pub let mut ptr_bytes: u64 = 8;
let mut ty_count: i32 = 0;
let mut int_tys: [129]*mut Ty = [@ptr_from_int(*mut Ty, 0); 129];
let mut t_void_: *mut Ty = @ptr_from_int(*mut Ty, 0);
let mut t_ptr_: *mut Ty = @ptr_from_int(*mut Ty, 0);
let mut t_f32_: *mut Ty = @ptr_from_int(*mut Ty, 0);
let mut t_f64_: *mut Ty = @ptr_from_int(*mut Ty, 0);
let mut derived: u.SymMap.[*mut Ty] = u.SymMap.[*mut Ty].{ keys: @ptr_from_int(*mut usize, 0),
                                                           vals: @ptr_from_int(*mut *mut Ty, 0), cap: 0, len: 0 };

fn new_ty(k: TyKind) *mut Ty {
    let t = u.perm_new.[Ty]();
    t.kind = k;
    ty_count += 1;
    t.id = ty_count;
    return t;
}

// Must be called before any type is created (pointer width of the target).
pub fn init_types(pbytes: u64) void {
    ptr_bytes = pbytes;
}

pub fn t_int(bits: i32) *mut Ty {
    let i = @int_cast(usize, bits);
    if u.isnil(int_tys[i]) {
        let t = new_ty(T_INT);
        t.bits = bits;
        let mut sz: u64 = 1;
        if bits > 8 {
            sz = @int_cast(u64, bits) / 8;
        }
        t.size = sz;
        t.align = sz;
        if sz > 8 {
            t.align = 16;
        }
        int_tys[i] = t;
    }
    return int_tys[i];
}

pub fn t_void() *mut Ty {
    if u.isnil(t_void_) {
        t_void_ = new_ty(T_VOID);
        t_void_.align = 1;
    }
    return t_void_;
}

pub fn t_ptr() *mut Ty {
    if u.isnil(t_ptr_) {
        t_ptr_ = new_ty(T_PTR);
        t_ptr_.size = ptr_bytes;
        t_ptr_.align = ptr_bytes;
        t_ptr_.bits = @int_cast(i32, ptr_bytes * 8);
    }
    return t_ptr_;
}

pub fn t_float(bits: i32) *mut Ty {
    if bits == 32 {
        if u.isnil(t_f32_) {
            t_f32_ = new_ty(T_FLOAT);
            t_f32_.bits = 32;
            t_f32_.size = 4;
            t_f32_.align = 4;
        }
        return t_f32_;
    }
    if u.isnil(t_f64_) {
        t_f64_ = new_ty(T_FLOAT);
        t_f64_.bits = 64;
        t_f64_.size = 8;
        t_f64_.align = 8;
    }
    return t_f64_;
}

pub fn t_vec(lane: *mut Ty, nl: u32) *mut Ty {
    let lanes = @int_cast(i32, nl);
    let k = u.intern(u.f2("v%s.%s", u.idec(lane.id), u.idec(lanes)));
    let found = derived.get(k);
    if u.notnil(found) {
        return found;
    }
    let t = new_ty(T_VEC);
    t.elem = lane;
    t.lanes = lanes;
    t.bits = lane.bits;
    t.size = lane.size * @int_cast(u64, lanes);
    t.align = t.size;
    if t.align < 16 {
        t.align = 16;
    }
    derived.put(k, t);
    return t;
}

pub fn t_array(el: *mut Ty, n: u64) *mut Ty {
    let k = u.intern(u.f2("a%s.%s", u.idec(el.id), u.udec(n)));
    let found = derived.get(k);
    if u.notnil(found) {
        return found;
    }
    let t = new_ty(T_ARRAY);
    t.elem = el;
    t.count = n;
    t.size = el.size * n;
    t.align = el.align;
    t.has_body = true;
    derived.put(k, t);
    return t;
}

fn layout_struct(t: *mut Ty) void {
    let n = t.fields.len;
    t.offs = u.perm_newn.[u64](n + 1);
    let mut off: u64 = 0;
    let mut al: u64 = 1;
    for i in 0..n {
        let f = t.fields[i];
        off = (off + f.align - 1) & ~(f.align - 1);
        t.offs[i] = off;
        off += f.size;
        if f.align > al {
            al = f.align;
        }
    }
    t.size = (off + al - 1) & ~(al - 1);
    t.align = al;
    t.has_body = true;
}

// A literal (anonymous) struct type: interned by its field types.
pub fn t_struct(fields: []mut *mut Ty) *mut Ty {
    let mut b = u.Buf.init();
    b.s("s");
    for f in fields {
        b.s(".");
        b.s(u.idec(f.id));
    }
    let k = u.intern(b.done());
    let found = derived.get(k);
    if u.notnil(found) {
        return found;
    }
    let t = new_ty(T_STRUCT);
    let fs = u.perm_newn.[*mut Ty](fields.len + 1);
    for i in 0..fields.len {
        fs[i] = fields[i];
    }
    t.fields = fs[0..fields.len];
    layout_struct(t);
    derived.put(k, t);
    return t;
}

pub fn t_named_struct(name: []u8) *mut Ty {
    let t = new_ty(T_STRUCT);
    t.name = u.perm_dup(name);
    t.align = 1;
    return t;
}

pub fn struct_set_body(t: *mut Ty, fields: []mut *mut Ty) void {
    let fs = u.perm_newn.[*mut Ty](fields.len + 1);
    for i in 0..fields.len {
        fs[i] = fields[i];
    }
    t.fields = fs[0..fields.len];
    layout_struct(t);
}

pub fn t_fn(rt: *mut Ty, params: []mut *mut Ty, vararg: bool) *mut Ty {
    let t = new_ty(T_FN);
    t.ret = rt;
    let ps = u.perm_newn.[*mut Ty](params.len + 1);
    for i in 0..params.len {
        ps[i] = params[i];
    }
    t.params = ps[0..params.len];
    t.vararg = vararg;
    return t;
}

pub fn is_agg(t: *Ty) bool {
    return (t.kind == T_STRUCT) or (t.kind == T_ARRAY);
}

// Integer width in bits (pointers: the pointer width).
pub fn int_width(t: *Ty) u32 {
    return @int_cast(u32, t.bits);
}

pub fn field_ty(t: *mut Ty, i: usize) *mut Ty {
    if (t.kind == T_ARRAY) or (t.kind == T_VEC) {
        return t.elem;
    }
    return t.fields[i];
}

pub fn field_off(t: *mut Ty, i: usize) u64 {
    if (t.kind == T_ARRAY) or (t.kind == T_VEC) {
        return t.elem.size * @as(u64, i);
    }
    return t.offs[i];
}

pub fn field_count(t: *mut Ty) usize {
    if t.kind == T_ARRAY {
        return @int_cast(usize, t.count);
    }
    return t.fields.len;
}

pub fn ty_str(t: *Ty) []u8 {
    let k = t.kind;
    if k == T_VOID {
        return "void";
    }
    if k == T_INT {
        return u.cat2("i", u.idec(t.bits));
    }
    if k == T_FLOAT {
        return u.pick(t.bits == 32, "float", "double");
    }
    if k == T_PTR {
        return "ptr";
    }
    if k == T_VEC {
        return u.f2("<%s x %s>", u.idec(t.lanes), ty_str(t.elem));
    }
    if k == T_ARRAY {
        return u.f2("[%s x %s]", u.udec(t.count), ty_str(t.elem));
    }
    if k == T_STRUCT {
        if t.name.len > 0 {
            return u.cat2("%", t.name);
        }
        let mut b = u.Buf.init();
        b.s("{ ");
        for i in 0..t.fields.len {
            if i != 0 {
                b.s(", ");
            }
            b.s(ty_str(t.fields[i]));
        }
        b.s(" }");
        return b.done();
    }
    let mut b = u.Buf.init();
    b.s(ty_str(t.ret));
    b.s(" (");
    for i in 0..t.params.len {
        if i != 0 {
            b.s(", ");
        }
        b.s(ty_str(t.params[i]));
    }
    if t.vararg {
        b.s(", ...");
    }
    b.s(")");
    return b.done();
}

// -----------------------------------------------------------------------------
// Values
// -----------------------------------------------------------------------------
// What a Value is (Value.kind).
pub enum ValueKind {
    INST,
    CINT,
    CFP,
    ZERO,
    UNDEF,
    CAGG,
    GLOBAL,
    FUNC,
    PARAM,
}

pub const V_INST: ValueKind = ValueKind.INST;
pub const V_CINT: ValueKind = ValueKind.CINT;  // cv (truncated to the width, zero-extended)
pub const V_CFP: ValueKind = ValueKind.CFP;    // fv
pub const V_ZERO: ValueKind = ValueKind.ZERO;  // zero of any type (null pointer, zeroinitializer)
pub const V_UNDEF: ValueKind = ValueKind.UNDEF;
pub const V_CAGG: ValueKind = ValueKind.CAGG;      // constant struct / array / vector: xs
pub const V_GLOBAL: ValueKind = ValueKind.GLOBAL;  // address of gv
pub const V_FUNC: ValueKind = ValueKind.FUNC;      // address of fnp
pub const V_PARAM: ValueKind = ValueKind.PARAM;    // cv = index

// Instructions
pub const OP_ADD: i32 = 1;
pub const OP_SUB: i32 = 2;
pub const OP_MUL: i32 = 3;
pub const OP_UDIV: i32 = 4;
pub const OP_SDIV: i32 = 5;
pub const OP_UREM: i32 = 6;
pub const OP_SREM: i32 = 7;
pub const OP_AND: i32 = 8;
pub const OP_OR: i32 = 9;
pub const OP_XOR: i32 = 10;
pub const OP_SHL: i32 = 11;
pub const OP_LSHR: i32 = 12;
pub const OP_ASHR: i32 = 13;
pub const OP_FADD: i32 = 14;
pub const OP_FSUB: i32 = 15;
pub const OP_FMUL: i32 = 16;
pub const OP_FDIV: i32 = 17;
pub const OP_FREM: i32 = 18;
pub const OP_FNEG: i32 = 19;
pub const OP_ICMP: i32 = 20;    // cv: predicate
pub const OP_FCMP: i32 = 21;    // cv: predicate
pub const OP_SELECT: i32 = 22;  // a ? b : c
pub const OP_ZEXT: i32 = 23;
pub const OP_SEXT: i32 = 24;
pub const OP_TRUNC: i32 = 25;
pub const OP_BITCAST: i32 = 26;
pub const OP_PTRTOINT: i32 = 27;
pub const OP_INTTOPTR: i32 = 28;
pub const OP_FPEXT: i32 = 29;
pub const OP_FPTRUNC: i32 = 30;
pub const OP_SITOFP: i32 = 31;
pub const OP_UITOFP: i32 = 32;
pub const OP_FPTOSI_SAT: i32 = 33;
pub const OP_FPTOUI_SAT: i32 = 34;
pub const OP_ALLOCA: i32 = 35;   // aty: allocated type; align
pub const OP_LOAD: i32 = 36;     // a: address
pub const OP_STORE: i32 = 37;    // a: value, b: address
pub const OP_PTRADD: i32 = 38;   // a: pointer, b: byte offset (pointer-sized int)
pub const OP_MEMCPY: i32 = 39;   // a: dst, b: src, c: length (non-overlapping, not even equal)
pub const OP_MEMMOVE: i32 = 40;  // a: dst, b: src, c: length (may overlap)
pub const OP_MEMSET: i32 = 41;   // a: dst, b: byte (i8), c: length
pub const OP_RMW: i32 = 42;      // cv: RMW_*; a: address, b: value
pub const OP_CMPXCHG: i32 = 43;  // a: address, b: expected, c: new; result: old value
pub const OP_FENCE: i32 = 44;
pub const OP_EXTRACTVALUE: i32 = 45;  // a: aggregate, cv: index
pub const OP_INSERTVALUE: i32 = 46;   // a: aggregate, b: value, cv: index
pub const OP_EXTRACTELEM: i32 = 47;   // a: vector, cv: lane
pub const OP_INSERTELEM: i32 = 48;    // a: vector, b: scalar, cv: lane
pub const OP_SHUFFLE: i32 = 49;       // a, b: vectors; mask: lane indices
pub const OP_SPLAT: i32 = 50;         // a: scalar
pub const OP_CALL: i32 = 51;          // a: callee; xs: arguments; fty: signature
pub const OP_INTR: i32 = 52;          // cv: IN_*; xs: arguments
pub const OP_PHI: i32 = 53;           // xs: values, bs: blocks
pub const OP_BR: i32 = 54;            // t1
pub const OP_CONDBR: i32 = 55;        // a: condition; t1 if true, t2 if false
pub const OP_SWITCH: i32 = 56;        // a: value; t1: default; xs: case constants, bs: targets
pub const OP_RET: i32 = 57;           // a: value (nil for void)
pub const OP_UNREACHABLE: i32 = 58;
pub const OP_COPY: i32 = 59;  // a (backend use)

// Comparison predicates (LLVM's numbering)
pub const IntEQ: i32 = 32;
pub const IntNE: i32 = 33;
pub const IntUGT: i32 = 34;
pub const IntUGE: i32 = 35;
pub const IntULT: i32 = 36;
pub const IntULE: i32 = 37;
pub const IntSGT: i32 = 38;
pub const IntSGE: i32 = 39;
pub const IntSLT: i32 = 40;
pub const IntSLE: i32 = 41;
pub const RealOEQ: i32 = 1;
pub const RealOGT: i32 = 2;
pub const RealOGE: i32 = 3;
pub const RealOLT: i32 = 4;
pub const RealOLE: i32 = 5;
pub const RealUNE: i32 = 14;

// Read-modify-write operations
pub const RMW_XCHG: i32 = 0;
pub const RMW_ADD: i32 = 1;
pub const RMW_SUB: i32 = 2;
pub const RMW_AND: i32 = 3;
pub const RMW_OR: i32 = 5;
pub const RMW_XOR: i32 = 6;
pub const RMW_MAX: i32 = 7;
pub const RMW_MIN: i32 = 8;
pub const RMW_UMAX: i32 = 9;
pub const RMW_UMIN: i32 = 10;

// Intrinsics
pub const IN_CTLZ: i32 = 1;
pub const IN_CTTZ: i32 = 2;
pub const IN_CTPOP: i32 = 3;
pub const IN_ROTL: i32 = 4;
pub const IN_ROTR: i32 = 5;
pub const IN_SADD_SAT: i32 = 6;
pub const IN_UADD_SAT: i32 = 7;
pub const IN_SSUB_SAT: i32 = 8;
pub const IN_USUB_SAT: i32 = 9;
pub const IN_SMIN: i32 = 10;
pub const IN_SMAX: i32 = 11;
pub const IN_UMIN: i32 = 12;
pub const IN_UMAX: i32 = 13;
pub const IN_FMIN: i32 = 14;  // IEEE minimum: NaN-propagating, -0 < +0
pub const IN_FMAX: i32 = 15;
pub const IN_FABS: i32 = 16;
pub const IN_SQRT: i32 = 17;
pub const IN_FLOOR: i32 = 18;
pub const IN_CEIL: i32 = 19;
pub const IN_FTRUNC: i32 = 20;
pub const IN_NEAREST: i32 = 21;  // round to nearest, ties to even
pub const IN_FMA: i32 = 22;
pub const IN_COPYSIGN: i32 = 23;
pub const IN_ABS: i32 = 24;  // wrapping integer abs
pub const IN_TRAP: i32 = 25;
pub const IN_MEMSIZE: i32 = 26;  // wasm memory.size (pages)
pub const IN_MEMGROW: i32 = 27;  // wasm memory.grow
pub const IN_WAIT32: i32 = 28;   // wasm memory.atomic.wait32
pub const IN_NOTIFY: i32 = 29;   // wasm memory.atomic.notify
pub const IN_SET_SP: i32 = 30;   // set the stack pointer (thread entry on wasm)
pub const IN_ANYTRUE: i32 = 31;  // i1: any bit of the vector set
pub const IN_ALLTRUE: i32 = 32;  // i1: every lane nonzero
pub const IN_BITMASK: i32 = 33;  // i32: top bit of each lane
pub const IN_SWIZZLE: i32 = 34;  // i8x16 swizzle (out-of-range index: 0)
pub const IN_DOT_I16: i32 = 35;  // i32x4 dot product of i16x8 lanes
pub const IN_UMUL_OV: i32 = 36;  // i1: the unsigned product of the two operands overflows
pub const IN_SMUL_OV: i32 = 37;  // i1: the signed product overflows (64-bit operands)
pub const IN_GET_SP: i32 = 38;   // the stack pointer, after this function's frame (wasm)
pub const IN_CPUID: i32 = 39;    // x86-64 cpuid (leaf, subleaf) -> <4 x i32> eax, ebx, ecx, edx
pub const IN_XGETBV: i32 = 40;   // x86-64 xgetbv (register) -> i64
// The processor instructions of spec §13.5, in the order of their builtins
// (ast.BI_X86_AESENC ...): operands as the builtin's, immediates as constants.
pub const IN_AESENC: i32 = 41;
pub const IN_AESENCLAST: i32 = 42;
pub const IN_AESDEC: i32 = 43;
pub const IN_AESDECLAST: i32 = 44;
pub const IN_AESIMC: i32 = 45;
pub const IN_AESKEYGEN: i32 = 46;
pub const IN_CLMUL: i32 = 47;
pub const IN_SHA1RNDS4: i32 = 48;
pub const IN_SHA1NEXTE: i32 = 49;
pub const IN_SHA1MSG1: i32 = 50;
pub const IN_SHA1MSG2: i32 = 51;
pub const IN_SHA256RNDS2: i32 = 52;
pub const IN_SHA256MSG1: i32 = 53;
pub const IN_SHA256MSG2: i32 = 54;
pub const IN_CRC32C: i32 = 55;
pub const IN_AESE: i32 = 56;
pub const IN_AESD: i32 = 57;
pub const IN_AESMC: i32 = 58;
pub const IN_AESIMC_A: i32 = 59;
pub const IN_PMULL: i32 = 60;
pub const IN_PMULL2: i32 = 61;
pub const IN_SHA1C: i32 = 62;
pub const IN_SHA1P: i32 = 63;
pub const IN_SHA1M: i32 = 64;
pub const IN_SHA1H: i32 = 65;
pub const IN_SHA1SU0: i32 = 66;
pub const IN_SHA1SU1: i32 = 67;
pub const IN_SHA256H: i32 = 68;
pub const IN_SHA256H2: i32 = 69;
pub const IN_SHA256SU0: i32 = 70;
pub const IN_SHA256SU1: i32 = 71;
pub const IN_SHA512H: i32 = 72;
pub const IN_SHA512H2: i32 = 73;
pub const IN_SHA512SU0: i32 = 74;
pub const IN_SHA512SU1: i32 = 75;
pub const IN_EOR3: i32 = 76;
pub const IN_BCAX: i32 = 77;
pub const IN_RAX1: i32 = 78;
pub const IN_XAR: i32 = 79;
pub const IN_CRC32: i32 = 80;
pub const IN_CRC32C_A: i32 = 81;
// Vector operations that only x86-64 code generation makes (codegen.ax, where
// the function's extensions select them: AVX2 or AVX-512):
pub const IN_PERM: i32 = 82;           // (table, idx): lane i is table[idx[i]], or 0 when idx[i] (unsigned) is not a lane
pub const IN_PERM2: i32 = 83;          // (a, b, idx): the same over the lanes of a, then b
pub const IN_LOAD_PARTIAL: i32 = 84;   // (ptr, mask i64): the lanes whose mask bit is set loaded, the others 0
pub const IN_STORE_PARTIAL: i32 = 85;  // (vec, ptr, mask i64): the lanes whose mask bit is set stored
pub const IN_SHLV: i32 = 86;           // (x, n): lane by lane x << n, 0 where n (unsigned) >= the lane's bits
pub const IN_LSHRV: i32 = 87;          // x >> n (logical), 0 where n >= bits
pub const IN_ASHRV: i32 = 88;          // x >> n (arithmetic), the sign where n >= bits
// The native frame address (rbp, x29): the function's frame record {the
// caller's frame address, the return address}; codegen's axiom.trap.
pub const IN_FRAME_ADDR: i32 = 89;
// The bytes of a 32- or 64-bit integer reversed (bswap, rev): made by
// combine.ax for the native targets only.
pub const IN_BSWAP: i32 = 90;
// Cache hints (@prefetch, @prefetch_write) of the line at their one operand,
// a pointer; codegen.ax makes them for the native targets only. They read
// and write nothing and never trap, but are kept (has_effects) where
// they are: optimizations that track memory pass over them.
pub const IN_PREFETCH: i32 = 91;   // for reading (prefetcht0, prfm pldl1keep)
pub const IN_PREFETCHW: i32 = 92;  // for writing (prefetchw with prfchw, else prefetcht0; prfm pstl1keep)

// The sums of each 8 bytes of a <16k x i8> vector, unsigned, as <2k x i64>
// (x86-64 psadbw against zero; made by slp.ax for sums of neighbouring bytes).
pub const IN_SAD_U8: i32 = 93;

// The lanes of the low (_LO) or high (_HI) half of an integer vector, each
// sign- (S) or zero-extended (U) to twice its width (@widen_low and
// @widen_high; codegen.ax makes them for AArch64, whose a64.ax makes sxtl,
// uxtl2 ..., or fuses them into the multiplies they feed: smull, smlal2 ...,
// and for x86-64 with SSE4.1, whose x64.ax makes pmovsx, pmovzx).
pub const IN_SWIDEN_LO: i32 = 94;
pub const IN_SWIDEN_HI: i32 = 95;
pub const IN_UWIDEN_LO: i32 = 96;
pub const IN_UWIDEN_HI: i32 = 97;
// <n/4 x i32> sums of the products of each four neighbouring lanes of two <n x i8>
// vectors, signed (@dot of i8 lanes; codegen.ax makes it for AArch64 only: sdot,
// or fused into the add it feeds, a64.ax).
pub const IN_DOT_I8: i32 = 98;
// <n/4 x i32> sums of the products of each four neighbouring lanes of a <n x u8> vector (the
// first operand, unsigned) and a <n x i8> one (@dot of u8 by i8 lanes; codegen.ax makes it for
// x86-64 with VNNI only: vpdpbusd into zero).
pub const IN_DOT_U8I8: i32 = 99;

pub fn is_widen(id: i32) bool {
    return (id >= IN_SWIDEN_LO) and (id <= IN_UWIDEN_HI);
}

pub fn is_prefetch(id: i32) bool {
    return (id == IN_PREFETCH) or (id == IN_PREFETCHW);
}

// -----------------------------------------------------------------------------
// What opcodes and intrinsics are: one table each, which the passes' own
// questions (may it be removed, computed once, moved, run early ...) are
// answered from. A new opcode or intrinsic gets its row here.
// -----------------------------------------------------------------------------
// Opcode properties (op_props):
pub const OPF_PURE: u32 = 1;           // the result is a function of the operands alone, and nothing else
                                       // happens (with OPF_DIV: but a fault); OP_INTR: see INF_PURE
pub const OPF_READS_MEM: u32 = 2;      // may read memory (a volatile load: see has_effects)
pub const OPF_WRITES_MEM: u32 = 4;     // may write memory, or order accesses (fence, atomics), or run code
pub const OPF_TERM: u32 = 8;           // ends its block
pub const OPF_INT_BINOP: u32 = 16;     // integer operation of a and b (lane by lane for vectors)
pub const OPF_FP_BINOP: u32 = 32;      // floating point operation of a and b
pub const OPF_CAST: u32 = 64;          // a converted to the result's type (lane by lane)
pub const OPF_COMMUTATIVE: u32 = 128;  // a op b == b op a (floating point: NaNs aside)
pub const OPF_DIV: u32 = 256;          // integer division: a zero divisor (or signed MIN / -1) faults

const OPF_PURE_INT: u32 = OPF_PURE | OPF_INT_BINOP;
const OPF_PURE_FP: u32 = OPF_PURE | OPF_FP_BINOP;
const OPF_PURE_CAST: u32 = OPF_PURE | OPF_CAST;
const OPF_MEM: u32 = OPF_READS_MEM | OPF_WRITES_MEM;

let OP_PROPS: [60]u32 = [
    0,  // (no opcode 0)
    OPF_PURE_INT | OPF_COMMUTATIVE,  // OP_ADD
    OPF_PURE_INT,                    // OP_SUB
    OPF_PURE_INT | OPF_COMMUTATIVE,  // OP_MUL
    OPF_PURE_INT | OPF_DIV,          // OP_UDIV
    OPF_PURE_INT | OPF_DIV,          // OP_SDIV
    OPF_PURE_INT | OPF_DIV,          // OP_UREM
    OPF_PURE_INT | OPF_DIV,          // OP_SREM
    OPF_PURE_INT | OPF_COMMUTATIVE,  // OP_AND
    OPF_PURE_INT | OPF_COMMUTATIVE,  // OP_OR
    OPF_PURE_INT | OPF_COMMUTATIVE,  // OP_XOR
    OPF_PURE_INT,                    // OP_SHL
    OPF_PURE_INT,                    // OP_LSHR
    OPF_PURE_INT,                    // OP_ASHR
    OPF_PURE_FP | OPF_COMMUTATIVE,   // OP_FADD
    OPF_PURE_FP,                     // OP_FSUB
    OPF_PURE_FP | OPF_COMMUTATIVE,   // OP_FMUL
    OPF_PURE_FP,                     // OP_FDIV
    OPF_PURE_FP,                     // OP_FREM
    OPF_PURE,                        // OP_FNEG
    OPF_PURE,                        // OP_ICMP
    OPF_PURE,                        // OP_FCMP
    OPF_PURE,                        // OP_SELECT
    OPF_PURE_CAST,                   // OP_ZEXT
    OPF_PURE_CAST,                   // OP_SEXT
    OPF_PURE_CAST,                   // OP_TRUNC
    OPF_PURE_CAST,                   // OP_BITCAST
    OPF_PURE_CAST,                   // OP_PTRTOINT
    OPF_PURE_CAST,                   // OP_INTTOPTR
    OPF_PURE_CAST,                   // OP_FPEXT
    OPF_PURE_CAST,                   // OP_FPTRUNC
    OPF_PURE_CAST,                   // OP_SITOFP
    OPF_PURE_CAST,                   // OP_UITOFP
    OPF_PURE_CAST,                   // OP_FPTOSI_SAT (saturates: never faults)
    OPF_PURE_CAST,                   // OP_FPTOUI_SAT
    0,                               // OP_ALLOCA (a new address each time it runs)
    OPF_READS_MEM,                   // OP_LOAD
    OPF_WRITES_MEM,                  // OP_STORE
    OPF_PURE,                        // OP_PTRADD
    OPF_MEM,                         // OP_MEMCPY
    OPF_MEM,                         // OP_MEMMOVE
    OPF_WRITES_MEM,                  // OP_MEMSET
    OPF_MEM,                         // OP_RMW
    OPF_MEM,                         // OP_CMPXCHG
    OPF_MEM,                         // OP_FENCE
    OPF_PURE,                        // OP_EXTRACTVALUE
    OPF_PURE,                        // OP_INSERTVALUE
    OPF_PURE,                        // OP_EXTRACTELEM
    OPF_PURE,                        // OP_INSERTELEM
    OPF_PURE,                        // OP_SHUFFLE
    OPF_PURE,                        // OP_SPLAT
    OPF_MEM,                         // OP_CALL
    0,                               // OP_INTR (intr_props)
    0,                               // OP_PHI
    OPF_TERM,                        // OP_BR
    OPF_TERM,                        // OP_CONDBR
    OPF_TERM,                        // OP_SWITCH
    OPF_TERM,                        // OP_RET
    OPF_TERM,                        // OP_UNREACHABLE
    0,                               // OP_COPY (backends only)
];

pub fn op_props(op: i32) u32 {
    if (op < 0) or (op > OP_COPY) {
        return 0;
    }
    return OP_PROPS[@int_cast(usize, op)];
}

// Intrinsic properties (intr_props); each intrinsic is one of PURE,
// READS_MEM, WRITES_MEM, HINT and OPAQUE:
pub const INF_PURE: u32 = 1;        // the result is a function of the operands alone, and nothing else happens
pub const INF_READS_MEM: u32 = 2;   // reads memory at its pointer operand, and does nothing else
pub const INF_WRITES_MEM: u32 = 4;  // writes memory at its pointer operand, and does nothing else
pub const INF_HINT: u32 = 8;        // reads and writes nothing, but is kept where it is (prefetches)
pub const INF_OPAQUE: u32 = 16;     // reads or changes state the passes do not model (the stack pointer,
                                    // the memory's size, the CPU) or traps: as though it read and wrote
                                    // any memory, and never removed or moved
pub const INF_LANEWISE: u32 = 32;   // PURE, and the same operation on each lane of vector operands

const INF_LANES: u32 = INF_PURE | INF_LANEWISE;

let IN_PROPS: [100]u32 = [
    0,               // (no intrinsic 0)
    INF_LANES,       // IN_CTLZ
    INF_LANES,       // IN_CTTZ
    INF_LANES,       // IN_CTPOP
    INF_LANES,       // IN_ROTL
    INF_LANES,       // IN_ROTR
    INF_LANES,       // IN_SADD_SAT
    INF_LANES,       // IN_UADD_SAT
    INF_LANES,       // IN_SSUB_SAT
    INF_LANES,       // IN_USUB_SAT
    INF_LANES,       // IN_SMIN
    INF_LANES,       // IN_SMAX
    INF_LANES,       // IN_UMIN
    INF_LANES,       // IN_UMAX
    INF_LANES,       // IN_FMIN
    INF_LANES,       // IN_FMAX
    INF_LANES,       // IN_FABS
    INF_LANES,       // IN_SQRT
    INF_LANES,       // IN_FLOOR
    INF_LANES,       // IN_CEIL
    INF_LANES,       // IN_FTRUNC
    INF_LANES,       // IN_NEAREST
    INF_LANES,       // IN_FMA
    INF_LANES,       // IN_COPYSIGN
    INF_LANES,       // IN_ABS
    INF_OPAQUE,      // IN_TRAP
    INF_OPAQUE,      // IN_MEMSIZE
    INF_OPAQUE,      // IN_MEMGROW
    INF_OPAQUE,      // IN_WAIT32
    INF_OPAQUE,      // IN_NOTIFY
    INF_OPAQUE,      // IN_SET_SP
    INF_PURE,        // IN_ANYTRUE
    INF_PURE,        // IN_ALLTRUE
    INF_PURE,        // IN_BITMASK
    INF_PURE,        // IN_SWIZZLE
    INF_PURE,        // IN_DOT_I16
    INF_PURE,        // IN_UMUL_OV
    INF_PURE,        // IN_SMUL_OV
    INF_OPAQUE,      // IN_GET_SP
    INF_OPAQUE,      // IN_CPUID
    INF_OPAQUE,      // IN_XGETBV
    INF_PURE,        // IN_AESENC
    INF_PURE,        // IN_AESENCLAST
    INF_PURE,        // IN_AESDEC
    INF_PURE,        // IN_AESDECLAST
    INF_PURE,        // IN_AESIMC
    INF_PURE,        // IN_AESKEYGEN
    INF_PURE,        // IN_CLMUL
    INF_PURE,        // IN_SHA1RNDS4
    INF_PURE,        // IN_SHA1NEXTE
    INF_PURE,        // IN_SHA1MSG1
    INF_PURE,        // IN_SHA1MSG2
    INF_PURE,        // IN_SHA256RNDS2
    INF_PURE,        // IN_SHA256MSG1
    INF_PURE,        // IN_SHA256MSG2
    INF_PURE,        // IN_CRC32C
    INF_PURE,        // IN_AESE
    INF_PURE,        // IN_AESD
    INF_PURE,        // IN_AESMC
    INF_PURE,        // IN_AESIMC_A
    INF_PURE,        // IN_PMULL
    INF_PURE,        // IN_PMULL2
    INF_PURE,        // IN_SHA1C
    INF_PURE,        // IN_SHA1P
    INF_PURE,        // IN_SHA1M
    INF_PURE,        // IN_SHA1H
    INF_PURE,        // IN_SHA1SU0
    INF_PURE,        // IN_SHA1SU1
    INF_PURE,        // IN_SHA256H
    INF_PURE,        // IN_SHA256H2
    INF_PURE,        // IN_SHA256SU0
    INF_PURE,        // IN_SHA256SU1
    INF_PURE,        // IN_SHA512H
    INF_PURE,        // IN_SHA512H2
    INF_PURE,        // IN_SHA512SU0
    INF_PURE,        // IN_SHA512SU1
    INF_PURE,        // IN_EOR3
    INF_PURE,        // IN_BCAX
    INF_PURE,        // IN_RAX1
    INF_PURE,        // IN_XAR
    INF_PURE,        // IN_CRC32
    INF_PURE,        // IN_CRC32C_A
    INF_PURE,        // IN_PERM
    INF_PURE,        // IN_PERM2
    INF_READS_MEM,   // IN_LOAD_PARTIAL
    INF_WRITES_MEM,  // IN_STORE_PARTIAL
    INF_LANES,       // IN_SHLV
    INF_LANES,       // IN_LSHRV
    INF_LANES,       // IN_ASHRV
    INF_OPAQUE,      // IN_FRAME_ADDR
    INF_PURE,        // IN_BSWAP (of a scalar only)
    INF_HINT,        // IN_PREFETCH
    INF_HINT,        // IN_PREFETCHW
    INF_PURE,        // IN_SAD_U8
    INF_PURE,        // IN_SWIDEN_LO
    INF_PURE,        // IN_SWIDEN_HI
    INF_PURE,        // IN_UWIDEN_LO
    INF_PURE,        // IN_UWIDEN_HI
    INF_PURE,        // IN_DOT_I8
    INF_PURE,        // IN_DOT_U8I8
];

pub fn intr_props(id: i32) u32 {
    if (id < 0) or (id > IN_DOT_U8I8) {
        return 0;
    }
    return IN_PROPS[@int_cast(usize, id)];
}

pub fn is_int_binop(op: i32) bool {
    return (op_props(op) & OPF_INT_BINOP) != 0;
}

// Integer or floating point (OP_ADD .. OP_FREM).
pub fn is_binop(op: i32) bool {
    return (op_props(op) & (OPF_INT_BINOP | OPF_FP_BINOP)) != 0;
}

pub fn is_cast(op: i32) bool {
    return (op_props(op) & OPF_CAST) != 0;
}

pub fn is_int_div(op: i32) bool {
    return (op_props(op) & OPF_DIV) != 0;
}

pub fn op_pure(op: i32) bool {
    return (op_props(op) & OPF_PURE) != 0;
}

pub fn op_writes_mem(op: i32) bool {
    return (op_props(op) & OPF_WRITES_MEM) != 0;
}

// Reads or writes memory.
pub fn op_accesses_mem(op: i32) bool {
    return (op_props(op) & OPF_MEM) != 0;
}

pub fn intr_pure(id: i32) bool {
    return (intr_props(id) & INF_PURE) != 0;
}

pub fn intr_lanewise(id: i32) bool {
    return (intr_props(id) & INF_LANEWISE) != 0;
}

pub fn intr_opaque(id: i32) bool {
    return (intr_props(id) & INF_OPAQUE) != 0;
}

// Writes memory, or might (the opaque ones).
pub fn intr_writes_mem(id: i32) bool {
    return (intr_props(id) & (INF_WRITES_MEM | INF_OPAQUE)) != 0;
}

// Must be kept though its result is unused: all but the pure ones and the
// loads.
pub fn intr_has_effects(id: i32) bool {
    return (intr_props(id) & (INF_WRITES_MEM | INF_HINT | INF_OPAQUE)) != 0;
}

// Argument and parameter marks (CALL ext, Func.param_ext) besides 1 (zext)
// and 2 (sext), set by lowering for the address of an aggregate:
pub const EXT_BYVAL: u8 = 3;  // passed by value: the callee only reads it
pub const EXT_SRET: u8 = 4;   // the result's memory: the call writes it (a parameter: the
                              // caller's fresh slot, which nothing else uses)

// Load/store flags
pub const F_VOLATILE: u32 = 1;
pub const F_ATOMIC: u32 = 2;  // sequentially consistent

pub struct Value {
    // the fields every walk over the IR reads come first (two cache lines)
    kind: ValueKind,
    op: i32,
    ty: *mut Ty,
    a: *mut Value,
    b: *mut Value,
    c: *mut Value,
    xs: u.List.[*mut Value],
    next: *mut Value,
    prev: *mut Value,
    blk: *mut Block,
    fwd: *mut Value,   // replacement (passes forward uses through resolve())
    user: *mut Value,  // the only user (when uses == 1)
    uses: i32,
    flags: u32,
    cv: u64,
    id: i32,
    align: u32,
    t1: *mut Block,
    t2: *mut Block,
    more: usize,  // a record of what few values have (bs_of, ...), or 0
    aux: i64,     // pass / backend scratch
    aux2: i64,
    auxp: *mut void,
    // backend scratch
    pos: i32,  // position in its block
    loc: i32,  // local / virtual register
    flag: i32,
    grave: u32,  // 1 + its index in the graveyard (0: not there)
    src: u32,    // where in the source it comes from (src_loc), 0: not known
}

// The fields of a Value that few values have: phis' and switches' blocks,
// calls' signatures, allocas' types, shuffles' masks, and the constants'
// values and referents. They are in a record (Value.more) only once one of
// them is set, which for most values none ever is: a small one with the
// fields of one group (the blocks of a PHI or SWITCH, a CALL's, an ALLOCA's,
// a SHUFFLE's mask, a constant's), or, once a value has fields of two
// groups, a ValueMore with all of them. A record starts with its group (an
// operation may change in place: the group, not the op, says what the record
// holds). <field>_of(v) reads one (zero if v has none), set_<field>(v, x)
// sets it (setting zero where there is none makes no record), and
// <field>_mut(v) is its address. Records of dead values are reused.
pub struct VmBlocks {
    g: u8,
    bs: u.List.[*mut Block],  // PHI, SWITCH: the blocks
}

pub struct VmCall {
    g: u8,
    fty: *mut Ty,       // CALL: signature
    ext: []mut u8,      // CALL: argument extension (0 none, 1 zext, 2 sext)
    chain: *mut Chain,  // CALL, native frame tables: the call-site records (see Chain)
}

pub struct VmAlloca {
    g: u8,
    aty: *mut Ty,  // ALLOCA: allocated type
    name: []u8,    // ALLOCA, PARAM: a name for people
}

pub struct VmMask {
    g: u8,
    mask: []mut i32,  // SHUFFLE
}

pub struct VmConst {
    g: u8,
    fv: f64,          // CFP: the value
    gv: *mut Global,  // GLOBAL: the global
    fnp: *mut Func,   // FUNC, PARAM: the function
    name: []u8,       // ALLOCA, PARAM: a name for people
}

pub struct ValueMore {
    g: u8,
    bs: u.List.[*mut Block],  // PHI, SWITCH: the blocks
    fv: f64,                  // CFP: the value
    aty: *mut Ty,             // ALLOCA: allocated type
    fty: *mut Ty,             // CALL: signature
    mask: []mut i32,          // SHUFFLE
    ext: []mut u8,            // CALL: argument extension (0 none, 1 zext, 2 sext)
    gv: *mut Global,          // GLOBAL: the global
    fnp: *mut Func,           // FUNC, PARAM: the function
    name: []u8,               // ALLOCA, PARAM: a name for people
    chain: *mut Chain,        // CALL, native frame tables: the call-site records (see Chain)
}

// The group of v's record (0: none).
fn more_group(v: *Value) u8 {
    if v.more == 0 {
        return 0;
    }
    return @ptr_from_int(*u8, v.more).*;
}

let mut no_more: *mut ValueMore = @ptr_from_int(*mut ValueMore, 0);

fn zero_more() *ValueMore {
    if u.isnil(no_more) {
        no_more = u.perm_new.[ValueMore]();
    }
    return no_more;
}

// Records of dead values, for reuse, by group.
let mut free_more: [7]u.List.[usize] = [u.List.[usize].{ data: @ptr_from_int(*mut usize, 0), len: 0, cap: 0 }; 7];

fn new_more(g: u8) usize {
    let k = @as(usize, g);
    if free_more[k].len > 0 {
        let r = free_more[k].pop();
        @mem_set(@slice_from_ptr(@ptr_from_int(*mut u8, r), more_size(g)), 0);
        @ptr_from_int(*mut u8, r).* = g;
        return r;
    }
    let mut r: usize = 0;
    match g {
        1    => { r = @int_from_ptr(u.new.[VmBlocks]()); }
        2    => { r = @int_from_ptr(u.new.[VmCall]()); }
        3    => { r = @int_from_ptr(u.new.[VmAlloca]()); }
        4    => { r = @int_from_ptr(u.new.[VmMask]()); }
        5    => { r = @int_from_ptr(u.new.[VmConst]()); }
        6    => { r = @int_from_ptr(u.new.[ValueMore]()); }
        else => { u.die("more_new: no such group"); }
    }
    @ptr_from_int(*mut u8, r).* = g;
    return r;
}

fn more_size(g: u8) usize {
    match g {
        1    => { return @size_of(VmBlocks); }
        2    => { return @size_of(VmCall); }
        3    => { return @size_of(VmAlloca); }
        4    => { return @size_of(VmMask); }
        5    => { return @size_of(VmConst); }
        6    => { return @size_of(ValueMore); }
        else => { return 0; }
    }
}

// v's record as a ValueMore (with every field), made from the one it has.
fn more_full(v: *mut Value) *mut ValueMore {
    let g = more_group(v);
    if g == 6 {
        return @ptr_from_int(*mut ValueMore, v.more);
    }
    let r = new_more(6);
    let m = @ptr_from_int(*mut ValueMore, r);
    match g {
        1 => {
            let o = @ptr_from_int(*mut VmBlocks, v.more);
            m.bs = o.bs;
        }
        2 => {
            let o = @ptr_from_int(*mut VmCall, v.more);
            m.fty = o.fty;
            m.ext = o.ext;
            m.chain = o.chain;
        }
        3 => {
            let o = @ptr_from_int(*mut VmAlloca, v.more);
            m.aty = o.aty;
            m.name = o.name;
        }
        4 => {
            let o = @ptr_from_int(*mut VmMask, v.more);
            m.mask = o.mask;
        }
        5 => {
            let o = @ptr_from_int(*mut VmConst, v.more);
            m.fv = o.fv;
            m.gv = o.gv;
            m.fnp = o.fnp;
            m.name = o.name;
        }
        else => {}
    }
    if g != 0 {
        free_more[@as(usize, g)].push(v.more);
    }
    v.more = r;
    return m;
}

// Gives back v's record (its block list freed), for reuse.
fn release_more(v: *mut Value) void {
    let g = more_group(v);
    if g == 0 {
        return;
    }
    if g == 1 {
        @ptr_from_int(*mut VmBlocks, v.more).bs.deinit();
    } else if g == 6 {
        @ptr_from_int(*mut ValueMore, v.more).bs.deinit();
    }
    if not u.poisoning() {
        free_more[@as(usize, g)].push(v.more);
    }
    v.more = 0;
}

// y gets a record like v's (with a block list of its own).
fn copy_more(y: *mut Value, v: *Value) void {
    let g = more_group(v);
    if g == 0 {
        return;
    }
    let r = new_more(g);
    @mem_copy(@slice_from_ptr(@ptr_from_int(*mut u8, r), more_size(g)),
              @slice_from_ptr(@ptr_from_int(*u8, v.more), more_size(g)));
    if g == 1 {
        @ptr_from_int(*mut VmBlocks, r).bs = u.List.[*mut Block].empty();
    } else if g == 6 {
        @ptr_from_int(*mut ValueMore, r).bs = u.List.[*mut Block].empty();
    }
    y.more = r;
}

pub fn bs_of(v: *Value) u.List.[*mut Block] {
    match more_group(v) {
        1    => { return @ptr_from_int(*VmBlocks, v.more).bs; }
        6    => { return @ptr_from_int(*ValueMore, v.more).bs; }
        else => { return zero_more().bs; }
    }
}

pub fn bs_mut(v: *mut Value) *mut u.List.[*mut Block] {
    if v.more == 0 {
        v.more = new_more(1);
    }
    match more_group(v) {
        1    => { return &mut @ptr_from_int(*mut VmBlocks, v.more).bs; }
        6    => { return &mut @ptr_from_int(*mut ValueMore, v.more).bs; }
        else => { return &mut more_full(v).bs; }
    }
}

pub fn set_bs(v: *mut Value, x: u.List.[*mut Block]) void {
    if (v.more == 0) and ((x.len == 0) and (x.cap == 0)) {
        return;
    }
    bs_mut(v).* = x;
}

pub fn fv_of(v: *Value) f64 {
    match more_group(v) {
        5    => { return @ptr_from_int(*VmConst, v.more).fv; }
        6    => { return @ptr_from_int(*ValueMore, v.more).fv; }
        else => { return zero_more().fv; }
    }
}

pub fn fv_mut(v: *mut Value) *mut f64 {
    if v.more == 0 {
        v.more = new_more(5);
    }
    match more_group(v) {
        5    => { return &mut @ptr_from_int(*mut VmConst, v.more).fv; }
        6    => { return &mut @ptr_from_int(*mut ValueMore, v.more).fv; }
        else => { return &mut more_full(v).fv; }
    }
}

pub fn set_fv(v: *mut Value, x: f64) void {
    if (v.more == 0) and (@bit_cast(u64, x) == 0) {
        return;
    }
    fv_mut(v).* = x;
}

pub fn aty_of(v: *Value) *mut Ty {
    match more_group(v) {
        3    => { return @ptr_from_int(*VmAlloca, v.more).aty; }
        6    => { return @ptr_from_int(*ValueMore, v.more).aty; }
        else => { return zero_more().aty; }
    }
}

pub fn aty_mut(v: *mut Value) *mut *mut Ty {
    if v.more == 0 {
        v.more = new_more(3);
    }
    match more_group(v) {
        3    => { return &mut @ptr_from_int(*mut VmAlloca, v.more).aty; }
        6    => { return &mut @ptr_from_int(*mut ValueMore, v.more).aty; }
        else => { return &mut more_full(v).aty; }
    }
}

pub fn set_aty(v: *mut Value, x: *mut Ty) void {
    if (v.more == 0) and (u.isnil(x)) {
        return;
    }
    aty_mut(v).* = x;
}

pub fn fty_of(v: *Value) *mut Ty {
    match more_group(v) {
        2    => { return @ptr_from_int(*VmCall, v.more).fty; }
        6    => { return @ptr_from_int(*ValueMore, v.more).fty; }
        else => { return zero_more().fty; }
    }
}

pub fn fty_mut(v: *mut Value) *mut *mut Ty {
    if v.more == 0 {
        v.more = new_more(2);
    }
    match more_group(v) {
        2    => { return &mut @ptr_from_int(*mut VmCall, v.more).fty; }
        6    => { return &mut @ptr_from_int(*mut ValueMore, v.more).fty; }
        else => { return &mut more_full(v).fty; }
    }
}

pub fn set_fty(v: *mut Value, x: *mut Ty) void {
    if (v.more == 0) and (u.isnil(x)) {
        return;
    }
    fty_mut(v).* = x;
}

pub fn mask_of(v: *Value) []mut i32 {
    match more_group(v) {
        4    => { return @ptr_from_int(*VmMask, v.more).mask; }
        6    => { return @ptr_from_int(*ValueMore, v.more).mask; }
        else => { return zero_more().mask; }
    }
}

pub fn mask_mut(v: *mut Value) *mut []mut i32 {
    if v.more == 0 {
        v.more = new_more(4);
    }
    match more_group(v) {
        4    => { return &mut @ptr_from_int(*mut VmMask, v.more).mask; }
        6    => { return &mut @ptr_from_int(*mut ValueMore, v.more).mask; }
        else => { return &mut more_full(v).mask; }
    }
}

pub fn set_mask(v: *mut Value, x: []mut i32) void {
    if (v.more == 0) and ((x.len == 0) and (@int_from_ptr(x.ptr) == 0)) {
        return;
    }
    mask_mut(v).* = x;
}

pub fn ext_of(v: *Value) []mut u8 {
    match more_group(v) {
        2    => { return @ptr_from_int(*VmCall, v.more).ext; }
        6    => { return @ptr_from_int(*ValueMore, v.more).ext; }
        else => { return zero_more().ext; }
    }
}

pub fn ext_mut(v: *mut Value) *mut []mut u8 {
    if v.more == 0 {
        v.more = new_more(2);
    }
    match more_group(v) {
        2    => { return &mut @ptr_from_int(*mut VmCall, v.more).ext; }
        6    => { return &mut @ptr_from_int(*mut ValueMore, v.more).ext; }
        else => { return &mut more_full(v).ext; }
    }
}

pub fn set_ext(v: *mut Value, x: []mut u8) void {
    if (v.more == 0) and ((x.len == 0) and (@int_from_ptr(x.ptr) == 0)) {
        return;
    }
    ext_mut(v).* = x;
}

pub fn gv_of(v: *Value) *mut Global {
    match more_group(v) {
        5    => { return @ptr_from_int(*VmConst, v.more).gv; }
        6    => { return @ptr_from_int(*ValueMore, v.more).gv; }
        else => { return zero_more().gv; }
    }
}

pub fn gv_mut(v: *mut Value) *mut *mut Global {
    if v.more == 0 {
        v.more = new_more(5);
    }
    match more_group(v) {
        5    => { return &mut @ptr_from_int(*mut VmConst, v.more).gv; }
        6    => { return &mut @ptr_from_int(*mut ValueMore, v.more).gv; }
        else => { return &mut more_full(v).gv; }
    }
}

pub fn set_gv(v: *mut Value, x: *mut Global) void {
    if (v.more == 0) and (u.isnil(x)) {
        return;
    }
    gv_mut(v).* = x;
}

pub fn fnp_of(v: *Value) *mut Func {
    match more_group(v) {
        5    => { return @ptr_from_int(*VmConst, v.more).fnp; }
        6    => { return @ptr_from_int(*ValueMore, v.more).fnp; }
        else => { return zero_more().fnp; }
    }
}

pub fn fnp_mut(v: *mut Value) *mut *mut Func {
    if v.more == 0 {
        v.more = new_more(5);
    }
    match more_group(v) {
        5    => { return &mut @ptr_from_int(*mut VmConst, v.more).fnp; }
        6    => { return &mut @ptr_from_int(*mut ValueMore, v.more).fnp; }
        else => { return &mut more_full(v).fnp; }
    }
}

pub fn set_fnp(v: *mut Value, x: *mut Func) void {
    if (v.more == 0) and (u.isnil(x)) {
        return;
    }
    fnp_mut(v).* = x;
}

pub fn name_of(v: *Value) []u8 {
    match more_group(v) {
        3    => { return @ptr_from_int(*VmAlloca, v.more).name; }
        5    => { return @ptr_from_int(*VmConst, v.more).name; }
        6    => { return @ptr_from_int(*ValueMore, v.more).name; }
        else => { return zero_more().name; }
    }
}

pub fn name_mut(v: *mut Value) *mut []u8 {
    if v.more == 0 {
        v.more = new_more(u.pick(v.kind == V_INST, "\x03", "\x05")[0]);
    }
    match more_group(v) {
        3    => { return &mut @ptr_from_int(*mut VmAlloca, v.more).name; }
        5    => { return &mut @ptr_from_int(*mut VmConst, v.more).name; }
        6    => { return &mut @ptr_from_int(*mut ValueMore, v.more).name; }
        else => { return &mut more_full(v).name; }
    }
}

pub fn set_name(v: *mut Value, x: []u8) void {
    if (v.more == 0) and ((x.len == 0) and (@int_from_ptr(x.ptr) == 0)) {
        return;
    }
    name_mut(v).* = x;
}

pub fn chain_of(v: *Value) *mut Chain {
    match more_group(v) {
        2    => { return @ptr_from_int(*VmCall, v.more).chain; }
        6    => { return @ptr_from_int(*ValueMore, v.more).chain; }
        else => { return zero_more().chain; }
    }
}

pub fn chain_mut(v: *mut Value) *mut *mut Chain {
    if v.more == 0 {
        v.more = new_more(2);
    }
    match more_group(v) {
        2    => { return &mut @ptr_from_int(*mut VmCall, v.more).chain; }
        6    => { return &mut @ptr_from_int(*mut ValueMore, v.more).chain; }
        else => { return &mut more_full(v).chain; }
    }
}

pub fn set_chain(v: *mut Value, x: *mut Chain) void {
    if (v.more == 0) and (u.isnil(x)) {
        return;
    }
    chain_mut(v).* = x;
}

// Native stack traces from frame tables (codegen.ax: frame_tables): the
// call-site records of a call, innermost first: its own (a trap call has
// none) and then those of the calls inlined around it. The backends write
// an entry mapping the call's return address to them.
pub struct Chain {
    site: *mut Value,  // a site record (a constant global)
    next: *mut Chain,
    off: i64,  // backend scratch: the chain's place in the object
}

pub fn chain1(site: *mut Value) *mut Chain {
    let c = u.new.[Chain]();
    c.site = site;
    return c;
}

// The records of `a`, then those of `b` (inlining a call with chain `b`
// moves code with chain `a` into the caller).
pub fn chain_cat(a: *mut Chain, b: *mut Chain) *mut Chain {
    if u.isnil(a) {
        return b;
    }
    if u.isnil(b) {
        return a;
    }
    let c = chain1(a.site);
    c.next = chain_cat(a.next, b);
    return c;
}

pub struct Block {
    fnp: *mut Func,
    first: *mut Value,
    last: *mut Value,
    prev: *mut Block,
    next: *mut Block,
    name: []u8,
    id: i32,
    preds: u.List.[*mut Block],
    idom: *mut Block,
    dom_kids: u.List.[*mut Block],
    rpo: i32,
    depth: i32,  // dominator tree depth
    grave: u32,  // 1 + its index in the graveyard (0: not there)
    loop_depth: i32,
    aux: i64,
    auxp: *mut void,
    mark: i64,    // pass scratch that survives CFG analyses
    split: bool,  // a loop header whose range was split (gvn.split_loops)
}

pub const LINK_EXTERNAL: i32 = 0;
pub const LINK_INTERNAL: i32 = 1;
pub const LINK_LINKONCE: i32 = 2;  // a definition any unit may repeat; one is kept
pub const LINK_EXTWEAK: i32 = 3;   // a weak reference: 0 when not defined
pub const LINK_WEAK: i32 = 4;

pub struct Func {
    name: []u8,
    ty: *mut Ty,
    linkage: i32,
    params: []mut *mut Value,
    first: *mut Block,
    last: *mut Block,
    val: *mut Value,
    noreturn: bool,
    cold: bool,
    noinline: bool,
    always_inline: bool,  // an `inline fn` (spec §9.5): inlined wherever it can be
    allocator: bool,      // returns (as an integer) memory nothing else points into: std/mem.alloc_bytes
    ret_ext: u8,          // 0 none, 1 zext, 2 sext
    param_ext: []mut u8,
    export_name: []u8,    // wasm export
    import_module: []u8,  // wasm import
    import_name: []u8,
    sret: bool,                  // set by lowering: params[0] is the result address
    split: u.List.[*mut Value],  // lowering: aggregate parameters passed as their leaves
    nvals: i32,
    nblocks: i32,
    id: i32,
    src: u32,  // its declaration's source location (src_loc)
    aux: i64,
    auxp: *mut void,
    fwd_seen: u64,                 // fwd_epoch when apply_forwarding last rewrote f
    features: u64,                 // the processor extensions its code may use (set when has_features)
    has_features: bool,            // otherwise: the target's (--cpu, --features)
    graves: u.List.[*mut Value],   // values put in the graveyard under it (some since moved on)
    bgraves: u.List.[*mut Block],  // its blocks put there
}

pub struct Global {
    name: []u8,
    ty: *mut Ty,
    init: *mut Value,  // nil: declaration
    linkage: i32,
    align: u64,
    is_const: bool,
    tls: bool,
    wasm_global: bool,  // a wasm global (per instance) instead of memory
    noalias: bool,      // compiler-managed: only accessed by name, never through
                        // a pointer the program computes (the shadow stack)
    val: *mut Value,
    id: i32,
    aux: i64,
}

pub struct Module {
    name: []u8,
    funcs: u.List.[*mut Func],
    globals: u.List.[*mut Global],
    fmap: u.SymMap.[*mut Func],
    gmap: u.SymMap.[*mut Global],
    frame_tables: bool,  // native stack traces from frame tables (calls' chains)
}

pub fn vnil() *mut Value {
    return u.nil.[Value]();
}

pub fn bnil() *mut Block {
    return u.nil.[Block]();
}

fn new_val(k: ValueKind, t: *mut Ty) *mut Value {
    let mut v = vnil();
    if free_vals.len > 0 {
        v = free_vals.pop();
        @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, v), @size_of(Value)), 0);
    } else {
        v = u.new.[Value]();
    }
    v.kind = k;
    v.ty = t;
    return v;
}

// -----------------------------------------------------------------------------
// Recycling. Instructions and blocks taken out of a function go to a
// graveyard with their function: they may be put back (moved) or be dead.
// recycle(f), called where no pass is at work on f, takes the dead ones
// (still out, with the instructions of dead blocks) for new values and
// blocks to reuse, and frees their lists. Passes delete most of what they
// make, so without this the IR of a build is mostly garbage. With
// AXIOM_POISON, dead values and blocks are filled with 0xA5 instead and
// never reused.
// -----------------------------------------------------------------------------
let mut grave_v: u.List.[*mut Value] = u.List.[*mut Value].{ data: @ptr_from_int(*mut *mut Value, 0), len: 0, cap: 0 };
let mut grave_vf: u.List.[*mut Func] = u.List.[*mut Func].{ data: @ptr_from_int(*mut *mut Func, 0), len: 0, cap: 0 };
let mut grave_b: u.List.[*mut Block] = u.List.[*mut Block].{ data: @ptr_from_int(*mut *mut Block, 0), len: 0, cap: 0 };
let mut free_vals: u.List.[*mut Value] = u.List.[*mut Value].{ data: @ptr_from_int(*mut *mut Value, 0), len: 0,
                                                               cap: 0 };
let mut free_blocks: u.List.[*mut Block] = u.List.[*mut Block].{ data: @ptr_from_int(*mut *mut Block, 0), len: 0,
                                                                 cap: 0 };

fn bury_value(v: *mut Value) void {
    if v.grave != 0 {
        // (an instruction of a dead block that had been moved before)
        let k = @as(usize, v.grave - 1);
        let last = grave_v.get(grave_v.len - 1);
        grave_v.set(k, last);
        grave_vf.set(k, grave_vf.get(grave_vf.len - 1));
        last.grave = v.grave;
        grave_v.len -= 1;
        grave_vf.len -= 1;
        v.grave = 0;
    }
    v.xs.deinit();
    release_more(v);
    if u.poisoning() {
        @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, v), @size_of(Value)), 0xA5);
        return;
    }
    free_vals.push(v);
}

fn bury_block(b: *mut Block) void {
    let mut i = b.first;
    while u.notnil(i) {
        let next = i.next;
        bury_value(i);
        i = next;
    }
    b.preds.deinit();
    b.dom_kids.deinit();
    if u.poisoning() {
        @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, b), @size_of(Block)), 0xA5);
        return;
    }
    free_blocks.push(b);
}

// Each value or block is in the graveyard once, under the function it was
// last taken out of (a value may move between functions, and in and out
// of blocks, before it dies).
fn to_grave(v: *mut Value, f: *mut Func) void {
    if v.grave != 0 {
        let k = @as(usize, v.grave - 1);
        if grave_vf.get(k) != f {
            grave_vf.set(k, f);
            f.graves.push(v);
        }
        return;
    }
    grave_v.push(v);
    grave_vf.push(f);
    v.grave = @truncate(u32, grave_v.len);
    f.graves.push(v);
}

fn block_to_grave(b: *mut Block) void {
    if b.grave != 0 {
        return;
    }
    grave_b.push(b);
    b.grave = @truncate(u32, grave_b.len);
    b.fnp.bgraves.push(b);
}

// The places in the graveyard of f's entries (from f's lists, which may
// name entries that have since moved on or gone), in order.
fn grave_places(vs: *mut u.List.[*mut Value], bs: *mut u.List.[*mut Block], f: *mut Func) u.List.[usize] {
    let mut pos = u.List.[usize].empty();
    for k in 0..vs.len {
        let v = vs.get(k);
        let x = @as(usize, v.grave) -% 1;  // (a buried value may be poison)
        if (x < grave_v.len) and (grave_v.get(x) == v) and (grave_vf.get(x) == f) {
            pos.push(x);
        }
    }
    for k in 0..bs.len {
        let b = bs.get(k);
        let x = @as(usize, b.grave) -% 1;
        if (x < grave_b.len) and (grave_b.get(x) == b) and (b.fnp == f) {
            pos.push(x);
        }
    }
    vs.clear();
    bs.clear();
    u.sort_usize(pos.items());
    let mut n: usize = 0;
    for k in 0..pos.len {
        if (n == 0) or (pos.get(n - 1) != pos.get(k)) {
            pos.set(n, pos.get(k));
            n += 1;
        }
    }
    pos.len = n;
    return pos;
}

// Takes f's entries out of the graveyard in the order a scan from the start
// would (each taken out with the last entry moved into its place, which is
// looked at again), going only to the places of f's entries.
pub fn recycle(f: *mut Func) void {
    // (operands still reaching a dead value through its fwd go straight on)
    apply_forwarding(f);
    let mut nob = u.List.[*mut Block].empty();
    let pv = grave_places(&mut f.graves, &mut nob, f);
    let mut i: usize = 0;
    let mut j: usize = pv.len;  // pv[i..j]: the places still holding f's entries
    while i < j {
        let k = pv.get(i);
        let v = grave_v.get(k);
        let lastk = grave_v.len - 1;
        let last = grave_v.get(lastk);
        grave_v.set(k, last);
        grave_vf.set(k, grave_vf.get(lastk));
        last.grave = @truncate(u32, k + 1);
        grave_v.len -= 1;
        grave_vf.len -= 1;
        v.grave = 0;
        if u.isnil(v.blk) {
            bury_value(v);
        }
        if pv.get(j - 1) == lastk {
            // (f's last entry, now at k: next; or the one just taken out)
            j -= 1;
        } else {
            i += 1;
        }
    }
    pv.deinit();
    let mut nov = u.List.[*mut Value].empty();
    let pb = grave_places(&mut nov, &mut f.bgraves, f);
    i = 0;
    j = pb.len;
    while i < j {
        let k = pb.get(i);
        let b = grave_b.get(k);
        let lastk = grave_b.len - 1;
        let last = grave_b.get(lastk);
        grave_b.set(k, last);
        last.grave = @truncate(u32, k + 1);
        grave_b.len -= 1;
        b.grave = 0;
        if u.isnil(b.prev) and u.isnil(b.next) and (f.first != b) {
            bury_block(b);
        }
        if pb.get(j - 1) == lastk {
            j -= 1;
        } else {
            i += 1;
        }
    }
    pb.deinit();
}

// -----------------------------------------------------------------------------
// Constants
// -----------------------------------------------------------------------------
pub fn mask_bits(bits: i32) u64 {
    if bits >= 64 {
        return 0xFFFF_FFFF_FFFF_FFFF;
    }
    return (@as(u64, 1) << @int_cast(u32, bits)) - 1;
}

// The constant's value sign-extended from its width.
pub fn sval(v: *Value) i64 {
    let bits = v.ty.bits;
    if bits >= 64 {
        return @bit_cast(i64, v.cv);
    }
    let sh = @int_cast(u32, 64 - bits);
    return @bit_cast(i64, v.cv << sh) >> sh;
}

// Integer constants are shared: one Value per type and value, in permanent
// memory. Nothing changes a constant once made (passes and backends write
// their scratch fields on instructions only), and folding makes them by the
// million.
struct CintTable {
    tys: *mut usize,
    vals: *mut u64,
    cs: *mut *mut Value,
    cap: usize,
    len: usize,
}

let mut CINTS: CintTable = CintTable.{ tys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u64, 0),
                                       cs: @ptr_from_int(*mut *mut Value, 0), cap: 0, len: 0 };

fn cint_slot(tys: []usize, vals: []u64, t: usize, v: u64) usize {
    let mask = tys.len - 1;
    let mut j = @truncate(usize, ((@as(u64, t) *% 0x9E3779B97F4A7C15) ^ (v *% 0xC2B2AE3D27D4EB4F)) >> 17) & mask;
    while (tys[j] != 0) and not ((tys[j] == t) and (vals[j] == v)) {
        j = (j + 1) & mask;
    }
    return j;
}

fn cint_grow() void {
    let mut n: usize = 4096;
    if CINTS.cap != 0 {
        n = CINTS.cap * 2;
    }
    let tys = u.calloc_slice.[usize](n);
    let vals = u.calloc_slice.[u64](n);
    let cs = u.calloc_slice.[*mut Value](n);
    let ot = @slice_from_ptr(CINTS.tys, CINTS.cap);
    let ov = @slice_from_ptr(CINTS.vals, CINTS.cap);
    let oc = @slice_from_ptr(CINTS.cs, CINTS.cap);
    for k in 0..CINTS.cap {
        if ot[k] != 0 {
            let j = cint_slot(tys, vals, ot[k], ov[k]);
            tys[j] = ot[k];
            vals[j] = ov[k];
            cs[j] = oc[k];
        }
    }
    u.free_slice.[usize](ot);
    u.free_slice.[u64](ov);
    u.free_slice.[*mut Value](oc);
    CINTS.tys = tys.ptr;
    CINTS.vals = vals.ptr;
    CINTS.cs = cs.ptr;
    CINTS.cap = n;
}

pub fn cint(t: *mut Ty, v: u64) *mut Value {
    let x = v & mask_bits(t.bits);
    if (CINTS.len + 1) * 2 > CINTS.cap {
        cint_grow();
    }
    let tys = @slice_from_ptr(CINTS.tys, CINTS.cap);
    let vals = @slice_from_ptr(CINTS.vals, CINTS.cap);
    let cs = @slice_from_ptr(CINTS.cs, CINTS.cap);
    let key = @int_from_ptr(t);
    let j = cint_slot(tys, vals, key, x);
    if tys[j] != 0 {
        return cs[j];
    }
    // (shared by every function: outside any scratch scope)
    let c = u.perm_new.[Value]();
    c.kind = V_CINT;
    c.ty = t;
    c.cv = x;
    tys[j] = key;
    vals[j] = x;
    cs[j] = c;
    CINTS.len += 1;
    return c;
}

// Debugging (AXIOM_CHECK_CINTS): that no constant was changed.
pub fn check_cints() void {
    let tys = @slice_from_ptr(CINTS.tys, CINTS.cap);
    let vals = @slice_from_ptr(CINTS.vals, CINTS.cap);
    let cs = @slice_from_ptr(CINTS.cs, CINTS.cap);
    let mut bad: usize = 0;
    for k in 0..CINTS.cap {
        if tys[k] == 0 {
            continue;
        }
        let c = cs[k];
        if (c.kind != V_CINT) or (@int_from_ptr(c.ty) != tys[k]) or (c.cv != vals[k]) or u.notnil(c.fwd) or
           u.notnil(c.a) or (c.xs.len != 0) or u.notnil(c.blk) or u.notnil(c.next) {
            bad += 1;
        }
    }
    u.eprint(u.f2("cints: %s, changed: %s\n", u.zdec(CINTS.len), u.zdec(bad)));
}

// Debugging (AXIOM_CHECK_IR): that each instruction's operands from its own
// block (but a phi's, and allocas, which are the frame's) come before it;
// stops at the first that does not.
pub fn check_order(m: *mut Module) void {
    for fi in 0..m.funcs.len {
        let f = m.funcs.get(fi);
        let mut b = f.first;
        while u.notnil(b) {
            let mut i = b.first;
            while u.notnil(i) {
                i.pos = 1;  // (not reached yet)
                i = i.next;
            }
            i = b.first;
            while u.notnil(i) {
                if i.op != OP_PHI {
                    check_operand(f, i, i.a);
                    check_operand(f, i, i.b);
                    check_operand(f, i, i.c);
                    for k in 0..i.xs.len {
                        check_operand(f, i, i.xs.get(k));
                    }
                }
                i.pos = 0;
                i = i.next;
            }
            b = b.next;
        }
    }
}

fn check_operand(f: *Func, i: *Value, x0: *mut Value) void {
    if u.isnil(x0) {
        return;
    }
    let x = resolve(x0);
    if (x.kind == V_INST) and (x.blk == i.blk) and (x.pos != 0) and (x.op != OP_ALLOCA) {
        u.die(u.f3("%s: %s before %s", f.name, inst_str(i), inst_str(x)));
    }
}

pub fn ci32(v: u64) *mut Value {
    return cint(t_int(32), v);
}

pub fn cfp(t: *mut Ty, x: f64) *mut Value {
    let c = new_val(V_CFP, t);
    if t.bits == 32 {
        set_fv(c, @float_cast(f64, @float_cast(f32, x)));
    } else {
        set_fv(c, x);
    }
    return c;
}

pub fn czero(t: *mut Ty) *mut Value {
    if t.kind == T_INT {
        return cint(t, 0);
    }
    return new_val(V_ZERO, t);
}

pub fn cones(t: *mut Ty) *mut Value {
    if t.kind == T_VEC {
        let n = @int_cast(usize, t.lanes);
        let xs = u.newn.[*mut Value](n);
        for i in 0..n {
            xs[i] = cint(t.elem, 0xFFFF_FFFF_FFFF_FFFF);
        }
        return cagg(t, xs);
    }
    return cint(t, 0xFFFF_FFFF_FFFF_FFFF);
}

// One undef per type, shared as integer constants are.
pub fn undef(t: *mut Ty) *mut Value {
    if u.isnil(t.undef_v) {
        let v = u.perm_new.[Value]();
        v.kind = V_UNDEF;
        v.ty = t;
        t.undef_v = v;
    }
    return t.undef_v;
}

pub fn cagg(t: *mut Ty, xs: []mut *mut Value) *mut Value {
    let c = new_val(V_CAGG, t);
    for x in xs {
        c.xs.push(x);
    }
    return c;
}

pub fn cstruct(xs: []mut *mut Value) *mut Value {
    let ts = u.newn.[*mut Ty](xs.len + 1);
    for i in 0..xs.len {
        ts[i] = xs[i].ty;
    }
    return cagg(t_struct(ts[0..xs.len]), xs);
}

pub fn carray(el: *mut Ty, xs: []mut *mut Value) *mut Value {
    return cagg(t_array(el, @as(u64, xs.len)), xs);
}

// The bytes of `s` followed by a NUL, as an [n+1 x i8] constant.
pub fn cstring(s: []u8) *mut Value {
    let t8 = t_int(8);
    let xs = u.newn.[*mut Value](s.len + 1);
    for i in 0..s.len {
        xs[i] = cint(t8, @as(u64, s[i]));
    }
    xs[s.len] = cint(t8, 0);
    return cagg(t_array(t8, @as(u64, s.len) + 1), xs);
}

pub fn cinttoptr(v: *mut Value) *mut Value {
    if (v.kind == V_CINT) and (v.cv == 0) {
        return czero(t_ptr());
    }
    return cint(t_ptr(), v.cv);
}

pub fn is_const(v: *Value) bool {
    return (v.kind != V_INST) and (v.kind != V_PARAM);
}

// The address of a thread-local: a constant in a function (the running
// thread's copy), but not one data can hold (a relocation there is to the
// initial image), so no constant aggregate has one.
pub fn is_tls_addr(v: *Value) bool {
    return (v.kind == V_GLOBAL) and gv_of(v).tls;
}

// An integer (or null pointer) constant.
pub fn is_cint(v: *Value) bool {
    return (v.kind == V_CINT) or ((v.kind == V_ZERO) and ((v.ty.kind == T_INT) or (v.ty.kind == T_PTR)));
}

// An integer constant of at most 64 bits (not a pointer).
pub fn is_small_cint(v: *Value) bool {
    return is_cint(v) and (v.ty.kind == T_INT) and (v.ty.bits <= 64);
}

// The i1 constant b.
pub fn kbool(b: bool) *mut Value {
    if b {
        return cint(t_int(1), 1);
    }
    return cint(t_int(1), 0);
}

pub fn cint_val(v: *Value) u64 {
    if v.kind == V_CINT {
        return v.cv;
    }
    return 0;
}

pub fn is_zero(v: *Value) bool {
    if v.kind == V_ZERO {
        return true;
    }
    if v.kind == V_CINT {
        return v.cv == 0;
    }
    if v.kind == V_CFP {
        return (fv_of(v) == 0.0) and (@bit_cast(u64, fv_of(v)) == 0);
    }
    if v.kind == V_CAGG {
        for i in 0..v.xs.len {
            if not is_zero(v.xs.get(i)) {
                return false;
            }
        }
        return true;
    }
    return false;
}

// -----------------------------------------------------------------------------
// Module, functions, globals
// -----------------------------------------------------------------------------
pub fn new_module(name: []u8) *mut Module {
    let m = u.new.[Module]();
    m.name = u.dup(name);
    return m;
}

pub fn add_function(m: *mut Module, name: []u8, fty: *mut Ty) *mut Func {
    let f = u.new.[Func]();
    f.name = u.intern(name);
    f.ty = fty;
    f.id = @int_cast(i32, m.funcs.len);
    let n = fty.params.len;
    f.params = u.newn.[*mut Value](n + 1)[0..n];
    for i in 0..n {
        let p = new_val(V_PARAM, fty.params[i]);
        p.cv = @as(u64, i);
        set_fnp(p, f);
        f.params[i] = p;
    }
    f.param_ext = u.newn.[u8](n + 1)[0..n];
    let fv = new_val(V_FUNC, t_ptr());
    set_fnp(fv, f);
    f.val = fv;
    m.funcs.push(f);
    if not m.fmap.has(f.name) {
        m.fmap.put(f.name, f);
    }
    return f;
}

pub fn new_param(f: *mut Func, t: *mut Ty, idx: usize) *mut Value {
    let p = new_val(V_PARAM, t);
    p.cv = @as(u64, idx);
    set_fnp(p, f);
    return p;
}

// The value `v` stands for after replacements.
pub fn resolve(v: *mut Value) *mut Value {
    let mut x = v;
    while u.notnil(x) and u.notnil(x.fwd) {
        x = x.fwd;
    }
    return x;
}

// Bumped whenever a value is forwarded: a function that apply_forwarding
// has rewritten since then has no operand to rewrite.
let mut fwd_epoch: u64 = 1;

// Forwards v's uses to r (or, with r nil, stops forwarding them).
pub fn forward(v: *mut Value, r: *mut Value) void {
    v.fwd = r;
    fwd_epoch += 1;
}

// Rewrites every operand of f's instructions through resolve().
pub fn apply_forwarding(f: *mut Func) void {
    if f.fwd_seen == fwd_epoch {
        return;
    }
    f.fwd_seen = fwd_epoch;
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if u.notnil(i.a) {
                i.a = resolve(i.a);
            }
            if u.notnil(i.b) {
                i.b = resolve(i.b);
            }
            if u.notnil(i.c) {
                i.c = resolve(i.c);
            }
            for k in 0..i.xs.len {
                i.xs.set(k, resolve(i.xs.get(k)));
            }
            i = i.next;
        }
        b = b.next;
    }
}

pub fn get_function(m: *mut Module, name: []u8) *mut Func {
    return m.fmap.get(u.intern(name));
}

pub fn add_global(m: *mut Module, t: *mut Ty, name: []u8) *mut Global {
    let g = u.new.[Global]();
    g.name = u.intern(name);
    g.ty = t;
    g.align = t.align;
    g.id = @int_cast(i32, m.globals.len);
    let gv = new_val(V_GLOBAL, t_ptr());
    set_gv(gv, g);
    g.val = gv;
    m.globals.push(g);
    if not m.gmap.has(g.name) {
        m.gmap.put(g.name, g);
    }
    return g;
}

pub fn get_global(m: *mut Module, name: []u8) *mut Global {
    return m.gmap.get(u.intern(name));
}

pub fn is_decl(f: *Func) bool {
    return u.isnil(f.first);
}

fn new_block() *mut Block {
    if free_blocks.len > 0 {
        let b = free_blocks.pop();
        @mem_set(@slice_from_ptr(@ptr_cast(*mut u8, b), @size_of(Block)), 0);
        return b;
    }
    return u.new.[Block]();
}

pub fn append_block(f: *mut Func, name: []u8) *mut Block {
    let b = new_block();
    b.fnp = f;
    b.name = name;
    b.id = f.nblocks;
    f.nblocks += 1;
    if u.isnil(f.last) {
        f.first = b;
    } else {
        f.last.next = b;
        b.prev = f.last;
    }
    f.last = b;
    return b;
}

pub fn remove_block(b: *mut Block) void {
    let f = b.fnp;
    block_to_grave(b);
    if u.notnil(b.prev) {
        b.prev.next = b.next;
    } else {
        f.first = b.next;
    }
    if u.notnil(b.next) {
        b.next.prev = b.prev;
    } else {
        f.last = b.prev;
    }
    b.prev = bnil();
    b.next = bnil();
}

// Moves `b` to directly after `after`.
pub fn move_block_after(b: *mut Block, after: *mut Block) void {
    if b == after {
        return;
    }
    remove_block(b);
    let f = after.fnp;
    b.prev = after;
    b.next = after.next;
    if u.notnil(after.next) {
        after.next.prev = b;
    } else {
        f.last = b;
    }
    after.next = b;
}

pub fn terminator(b: *Block) *mut Value {
    let l = b.last;
    if u.notnil(l) and is_term(l.op) {
        return l;
    }
    return vnil();
}

pub fn is_term(op: i32) bool {
    return (op_props(op) & OPF_TERM) != 0;
}

// Successor blocks of a terminator.
pub fn succ_count(t: *Value) usize {
    if u.isnil(t) {
        return 0;
    }
    let op = t.op;
    if op == OP_BR {
        return 1;
    }
    if op == OP_CONDBR {
        return 2;
    }
    if op == OP_SWITCH {
        return 1 + bs_of(t).len;
    }
    return 0;
}

pub fn succ(t: *Value, i: usize) *mut Block {
    if i == 0 {
        return t.t1;
    }
    if t.op == OP_CONDBR {
        return t.t2;
    }
    return bs_of(t).get(i - 1);
}

pub fn set_succ(t: *mut Value, i: usize, b: *mut Block) void {
    if i == 0 {
        t.t1 = b;
    } else if t.op == OP_CONDBR {
        t.t2 = b;
    } else {
        bs_of(t).set(i - 1, b);
    }
}

// Instruction list editing.
pub fn insert_before(pos: *mut Value, v: *mut Value) void {
    let b = pos.blk;
    v.blk = b;
    v.next = pos;
    v.prev = pos.prev;
    if u.notnil(pos.prev) {
        pos.prev.next = v;
    } else {
        b.first = v;
    }
    pos.prev = v;
}

pub fn append_inst(b: *mut Block, v: *mut Value) void {
    v.blk = b;
    v.prev = b.last;
    v.next = vnil();
    if u.notnil(b.last) {
        b.last.next = v;
    } else {
        b.first = v;
    }
    b.last = v;
}

pub fn remove_inst(v: *mut Value) void {
    let b = v.blk;
    to_grave(v, b.fnp);
    if u.notnil(v.prev) {
        v.prev.next = v.next;
    } else {
        b.first = v.next;
    }
    if u.notnil(v.next) {
        v.next.prev = v.prev;
    } else {
        b.last = v.prev;
    }
    v.prev = vnil();
    v.next = vnil();
    v.blk = bnil();
}

// Operands of an instruction, in order: a, b, c, then xs.
pub fn nops(v: *Value) usize {
    let mut n: usize = 0;
    if u.notnil(v.a) {
        n = 1;
    }
    if u.notnil(v.b) {
        n = 2;
    }
    if u.notnil(v.c) {
        n = 3;
    }
    return n;
}

// Replaces every use of `old` by `new` in function f (operands only).
pub fn replace_uses(f: *mut Func, old: *mut Value, new: *mut Value) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            replace_in(i, old, new);
            i = i.next;
        }
        b = b.next;
    }
}

pub fn replace_in(i: *mut Value, old: *mut Value, new: *mut Value) void {
    if i.a == old {
        i.a = new;
    }
    if i.b == old {
        i.b = new;
    }
    if i.c == old {
        i.c = new;
    }
    for k in 0..i.xs.len {
        if i.xs.get(k) == old {
            i.xs.set(k, new);
        }
    }
}

// -----------------------------------------------------------------------------
// What the passes ask of instructions
// -----------------------------------------------------------------------------

// Must instruction i be kept though its result is unused (it writes memory,
// ends its block, is a volatile or atomic load, or an intrinsic with an
// effect)?
pub fn has_effects(i: *Value) bool {
    let op = i.op;
    if (op_props(op) & (OPF_WRITES_MEM | OPF_TERM)) != 0 {
        return true;
    }
    if op == OP_LOAD {
        return i.flags != 0;
    }
    if op == OP_INTR {
        return intr_has_effects(intr_id(i));
    }
    return false;
}

// Is v an instruction with opcode op (false for nil)?
pub fn is_op(v: *Value, op: i32) bool {
    return u.notnil(v) and (v.kind == V_INST) and (v.op == op);
}

// The predicate (Int*, Real*) of a comparison.
pub fn pred_of(v: *Value) i32 {
    return @truncate(i32, @bit_cast(i64, v.cv));
}

// The intrinsic (IN_*) an instruction calls; 0 when it is not OP_INTR.
pub fn intr_id(v: *Value) i32 {
    if v.op != OP_INTR {
        return 0;
    }
    return @truncate(i32, @bit_cast(i64, v.cv));
}

// The predicate with its operands swapped: a p b == b swap(p) a.
pub fn swap_pred(p: i32) i32 {
    if p == IntUGT {
        return IntULT;
    }
    if p == IntULT {
        return IntUGT;
    }
    if p == IntUGE {
        return IntULE;
    }
    if p == IntULE {
        return IntUGE;
    }
    if p == IntSGT {
        return IntSLT;
    }
    if p == IntSLT {
        return IntSGT;
    }
    if p == IntSGE {
        return IntSLE;
    }
    if p == IntSLE {
        return IntSGE;
    }
    return p;
}

// The negated predicate: not (a p b) == a inv(p) b.
pub fn inv_pred(p: i32) i32 {
    if p == IntEQ {
        return IntNE;
    }
    if p == IntNE {
        return IntEQ;
    }
    if p == IntUGT {
        return IntULE;
    }
    if p == IntULE {
        return IntUGT;
    }
    if p == IntUGE {
        return IntULT;
    }
    if p == IntULT {
        return IntUGE;
    }
    if p == IntSGT {
        return IntSLE;
    }
    if p == IntSLE {
        return IntSGT;
    }
    if p == IntSGE {
        return IntSLT;
    }
    return IntSGE;  // SLT
}

pub fn is_signed_pred(p: i32) bool {
    return (p >= IntSGT) and (p <= IntSLE);
}

// Integer operations whose operands may be swapped.
pub fn commutative_int(op: i32) bool {
    return (op_props(op) & (OPF_COMMUTATIVE | OPF_INT_BINOP)) == (OPF_COMMUTATIVE | OPF_INT_BINOP);
}

// The same, and the floating point ones (the same result, NaNs aside).
pub fn commutative(op: i32) bool {
    return (op_props(op) & OPF_COMMUTATIVE) != 0;
}

// The base of address p, through additions of any offsets.
pub fn ptr_base(p: *mut Value) *mut Value {
    let mut q = p;
    while is_op(q, OP_PTRADD) {
        q = q.a;
    }
    return q;
}

// Number of uses of each instruction (uses; user: the last user).
pub fn count_uses(f: *mut Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.uses = 0;
            i = i.next;
        }
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            use1(i.a, i);
            use1(i.b, i);
            use1(i.c, i);
            for k in 0..i.xs.len {
                use1(i.xs.get(k), i);
            }
            i = i.next;
        }
        b = b.next;
    }
}

fn use1(o: *mut Value, i: *mut Value) void {
    if u.notnil(o) and (o.kind == V_INST) {
        o.uses += 1;
        o.user = i;
    }
}

// -----------------------------------------------------------------------------
// Phi inputs and edges
// -----------------------------------------------------------------------------

// The value phi p takes over the edge from block `from` (nil: none).
pub fn incoming(p: *Value, from: *mut Block) *mut Value {
    for k in 0..bs_of(p).len {
        if bs_of(p).get(k) == from {
            return p.xs.get(k);
        }
    }
    return vnil();
}

// Removes input k of phi p (the last input takes its place).
pub fn remove_incoming(p: *mut Value, k: usize) void {
    bs_of(p).set(k, bs_of(p).get(bs_of(p).len - 1));
    p.xs.set(k, p.xs.get(p.xs.len - 1));
    bs_mut(p).len -= 1;
    p.xs.len -= 1;
}

// Removes phi p's inputs from block `from`.
pub fn drop_incoming(p: *mut Value, from: *mut Block) void {
    let mut k: usize = 0;
    while k < bs_of(p).len {
        if bs_of(p).get(k) == from {
            remove_incoming(p, k);
        } else {
            k += 1;
        }
    }
}

// Removes the inputs from block `from` of the phis of s.
pub fn remove_phi_input(s: *mut Block, from: *mut Block) void {
    let mut p = s.first;
    while u.notnil(p) and (p.op == OP_PHI) {
        drop_incoming(p, from);
        p = p.next;
    }
}

// The phis of s take their inputs from `old` as from `new`.
pub fn replace_phi_block(s: *mut Block, old: *mut Block, new: *mut Block) void {
    let mut p = s.first;
    while u.notnil(p) and (p.op == OP_PHI) {
        for k in 0..bs_of(p).len {
            if bs_of(p).get(k) == old {
                bs_of(p).set(k, new);
            }
        }
        p = p.next;
    }
}

// Points the edges from b to `old` at `new`.
pub fn retarget(b: *Block, old: *mut Block, new: *mut Block) void {
    let t = terminator(b);
    for k in 0..succ_count(t) {
        if succ(t, k) == old {
            set_succ(t, k, new);
        }
    }
}

// A new block (named `name`, last in f) on the way from `from` to `to`: it
// jumps to `to`, whose phis take their inputs from `from` from it. The
// caller points from's edges at it.
pub fn edge_block(f: *mut Func, name: []u8, from: *mut Block, to: *mut Block) *mut Block {
    let nb = append_block(f, name);
    let j = new_inst(f, OP_BR, t_void());
    j.t1 = to;
    append_inst(nb, j);
    replace_phi_block(to, from, nb);
    return nb;
}

// Splits the edges from `from` to `to` by a new block (edge_block).
pub fn split_edge(f: *mut Func, name: []u8, from: *mut Block, to: *mut Block) *mut Block {
    let nb = edge_block(f, name, from, to);
    retarget(from, to, nb);
    return nb;
}

// -----------------------------------------------------------------------------
// Builder
// -----------------------------------------------------------------------------
pub struct Builder {
    blk: *mut Block,
    before: *mut Value,  // insert before this instruction; nil: at the end
}

pub fn new_builder() *mut Builder {
    return u.new.[Builder]();
}

pub fn at_end(bd: *mut Builder, b: *mut Block) void {
    bd.blk = b;
    bd.before = vnil();
}

pub fn at_before(bd: *mut Builder, v: *mut Value) void {
    bd.blk = v.blk;
    bd.before = v;
}

pub fn insert_block(bd: *Builder) *mut Block {
    return bd.blk;
}

// Source locations (debug information): a file and a line in a u32, for
// every instruction. Code generation sets cur_src as it goes; instructions
// passes insert before another take that one's.
pub let mut cur_src: u32 = 0;

pub fn src_loc(file: i32, line: i32) u32 {
    if (file < 0) or (file >= 4095) or (line <= 0) or (line >= 0x10_0000) {
        return 0;
    }
    return (@bit_cast(u32, file + 1) << 20) | @bit_cast(u32, line);
}

pub fn src_file(s: u32) i32 {
    return @bit_cast(i32, s >> 20) - 1;
}

pub fn src_line(s: u32) u32 {
    return s & 0xf_ffff;
}

fn emit(bd: *mut Builder, op: i32, t: *mut Ty) *mut Value {
    let v = new_val(V_INST, t);
    v.op = op;
    v.src = cur_src;
    if (v.src == 0) and u.notnil(bd.before) {
        v.src = bd.before.src;
    }
    let f = bd.blk.fnp;
    v.id = f.nvals;
    f.nvals += 1;
    if u.notnil(bd.before) {
        insert_before(bd.before, v);
    } else {
        append_inst(bd.blk, v);
    }
    return v;
}

// A new instruction that is not in any block (for passes).
pub fn new_inst(f: *mut Func, op: i32, t: *mut Ty) *mut Value {
    let v = new_val(V_INST, t);
    v.op = op;
    v.id = f.nvals;
    f.nvals += 1;
    return v;
}

// A new instruction of f with everything of v but its place: the same
// operands, targets and source location (not in a block).
pub fn copy_inst(f: *mut Func, v: *Value) *mut Value {
    let y = new_inst(f, v.op, v.ty);
    y.cv = v.cv;
    y.flags = v.flags;
    y.src = v.src;
    y.align = v.align;
    copy_more(y, v);  // (with a block list of its own, filled below)
    y.a = v.a;
    y.b = v.b;
    y.c = v.c;
    y.t1 = v.t1;
    y.t2 = v.t2;
    for j in 0..v.xs.len {
        y.xs.push(v.xs.get(j));
    }
    for j in 0..bs_of(v).len {
        bs_mut(y).push(bs_of(v).get(j));
    }
    return y;
}

pub fn fold_int_bin(op: i32, t: *mut Ty, x: *Value, y: *Value) *mut Value {
    let a = cint_val(x);
    let b = cint_val(y);
    let bits = t.bits;
    let mut r: u64 = 0;
    if op == OP_ADD {
        r = a +% b;
    } else if op == OP_SUB {
        r = a -% b;
    } else if op == OP_MUL {
        r = a *% b;
    } else if op == OP_AND {
        r = a & b;
    } else if op == OP_OR {
        r = a | b;
    } else if op == OP_XOR {
        r = a ^ b;
    } else if op == OP_SHL {
        if b >= @int_cast(u64, bits) {
            return vnil();
        }
        r = a << @truncate(u32, b);
    } else if op == OP_LSHR {
        if b >= @int_cast(u64, bits) {
            return vnil();
        }
        r = a >> @truncate(u32, b);
    } else if op == OP_ASHR {
        if b >= @int_cast(u64, bits) {
            return vnil();
        }
        r = @bit_cast(u64, sval(x) >> @truncate(u32, b));
    } else if op == OP_UDIV {
        if b == 0 {
            return vnil();
        }
        r = a / b;
    } else if op == OP_UREM {
        if b == 0 {
            return vnil();
        }
        r = a % b;
    } else if (op == OP_SDIV) or (op == OP_SREM) {
        let sa = sval(x);
        let sb = sval(y);
        if (sb == 0) or ((sb == -1) and (a == (@as(u64, 1) << @int_cast(u32, bits - 1)))) {
            return vnil();
        }
        if op == OP_SDIV {
            r = @bit_cast(u64, sa / sb);
        } else {
            r = @bit_cast(u64, sa % sb);
        }
    } else {
        return vnil();
    }
    return cint(t, r);
}

pub fn binop(bd: *mut Builder, op: i32, x: *mut Value, y: *mut Value) *mut Value {
    let t = x.ty;
    if (t.kind == T_INT) and is_cint(x) and is_cint(y) and (t.bits <= 64) {
        let r = fold_int_bin(op, t, x, y);
        if u.notnil(r) {
            return r;
        }
    }
    let v = emit(bd, op, t);
    v.a = x;
    v.b = y;
    return v;
}

pub fn add(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_ADD, x, y);
}

pub fn sub(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_SUB, x, y);
}

pub fn mul(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_MUL, x, y);
}

pub fn and_(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_AND, x, y);
}

pub fn or_(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_OR, x, y);
}

pub fn xor(bd: *mut Builder, x: *mut Value, y: *mut Value) *mut Value {
    return binop(bd, OP_XOR, x, y);
}

pub fn not_(bd: *mut Builder, x: *mut Value) *mut Value {
    return binop(bd, OP_XOR, x, cones(x.ty));
}

pub fn neg(bd: *mut Builder, x: *mut Value) *mut Value {
    return binop(bd, OP_SUB, czero(x.ty), x);
}

pub fn fneg(bd: *mut Builder, x: *mut Value) *mut Value {
    if x.kind == V_CFP {
        return cfp(x.ty, -fv_of(x));
    }
    let v = emit(bd, OP_FNEG, x.ty);
    v.a = x;
    return v;
}

fn cmp_fold(p: i32, x: *Value, y: *Value) i32 {
    let a = cint_val(x);
    let b = cint_val(y);
    let sa = sval(x);
    let sb = sval(y);
    let mut r = false;
    if p == IntEQ {
        r = a == b;
    } else if p == IntNE {
        r = a != b;
    } else if p == IntUGT {
        r = a > b;
    } else if p == IntUGE {
        r = a >= b;
    } else if p == IntULT {
        r = a < b;
    } else if p == IntULE {
        r = a <= b;
    } else if p == IntSGT {
        r = sa > sb;
    } else if p == IntSGE {
        r = sa >= sb;
    } else if p == IntSLT {
        r = sa < sb;
    } else if p == IntSLE {
        r = sa <= sb;
    }
    if r {
        return 1;
    }
    return 0;
}

// Comparisons: i1, or for vectors a lane mask (all ones / zeros) of the
// operands' shape with integer lanes.
fn cmp_ty(t: *mut Ty) *mut Ty {
    if t.kind == T_VEC {
        if t.elem.kind == T_FLOAT {
            return t_vec(t_int(t.elem.bits), @int_cast(u32, t.lanes));
        }
        return t;
    }
    return t_int(1);
}

// The comparison `x p y` folded: nil unless x and y are integer constants of
// at most 64 bits.
pub fn fold_icmp(p: i32, x: *Value, y: *Value) *mut Value {
    if (x.ty.kind != T_VEC) and is_cint(x) and is_cint(y) and (x.ty.bits <= 64) {
        return cint(t_int(1), @as(u64, @bit_cast(u32, cmp_fold(p, x, y))));
    }
    return vnil();
}

pub fn icmp(bd: *mut Builder, p: i32, x: *mut Value, y: *mut Value) *mut Value {
    let k = fold_icmp(p, x, y);
    if u.notnil(k) {
        return k;
    }
    let v = emit(bd, OP_ICMP, cmp_ty(x.ty));
    v.cv = @as(u64, @bit_cast(u32, p));
    v.a = x;
    v.b = y;
    return v;
}

pub fn fcmp(bd: *mut Builder, p: i32, x: *mut Value, y: *mut Value) *mut Value {
    let v = emit(bd, OP_FCMP, cmp_ty(x.ty));
    v.cv = @as(u64, @bit_cast(u32, p));
    v.a = x;
    v.b = y;
    return v;
}

pub fn is_null(bd: *mut Builder, p: *mut Value) *mut Value {
    return icmp(bd, IntEQ, p, czero(p.ty));
}

pub fn select(bd: *mut Builder, c: *mut Value, x: *mut Value, y: *mut Value) *mut Value {
    if c.kind == V_CINT {
        if c.cv != 0 {
            return x;
        }
        return y;
    }
    if x == y {
        return x;
    }
    let v = emit(bd, OP_SELECT, x.ty);
    v.a = c;
    v.b = x;
    v.c = y;
    return v;
}

// The cast of x to t, when it needs no instruction (x is t already, or a
// constant): nil otherwise.
pub fn fold_cast(op: i32, x: *mut Value, t: *mut Ty) *mut Value {
    if x.ty == t {
        if (op == OP_ZEXT) or (op == OP_SEXT) or (op == OP_TRUNC) or (op == OP_BITCAST) {
            return x;
        }
    }
    if (x.kind == V_CINT) or ((x.kind == V_ZERO) and (x.ty.kind == T_INT)) {
        if (op == OP_ZEXT) or (op == OP_TRUNC) {
            return cint(t, cint_val(x));
        }
        if op == OP_SEXT {
            return cint(t, @bit_cast(u64, sval(x)));
        }
        if op == OP_INTTOPTR {
            return cinttoptr(x);
        }
    }
    if (x.kind == V_ZERO) and (op == OP_PTRTOINT) {
        return cint(t, 0);
    }
    if (x.kind == V_UNDEF) and (op != OP_FPTOSI_SAT) and (op != OP_FPTOUI_SAT) {
        return undef(t);
    }
    return vnil();
}

pub fn cast(bd: *mut Builder, op: i32, x: *mut Value, t: *mut Ty) *mut Value {
    let k = fold_cast(op, x, t);
    if u.notnil(k) {
        return k;
    }
    let v = emit(bd, op, t);
    v.a = x;
    return v;
}

pub fn zext(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    return cast(bd, OP_ZEXT, x, t);
}

pub fn sext(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    return cast(bd, OP_SEXT, x, t);
}

pub fn trunc(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    return cast(bd, OP_TRUNC, x, t);
}

pub fn bitcast(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    return cast(bd, OP_BITCAST, x, t);
}

pub fn ptrtoint(bd: *mut Builder, x: *mut Value, t: *mut Ty) *mut Value {
    let v = cast(bd, OP_PTRTOINT, x, t_int(@int_cast(i32, ptr_bytes * 8)));
    if t.bits == @int_cast(i32, ptr_bytes * 8) {
        return v;
    }
    if t.bits < @int_cast(i32, ptr_bytes * 8) {
        return trunc(bd, v, t);
    }
    return zext(bd, v, t);
}

pub fn inttoptr(bd: *mut Builder, x: *mut Value) *mut Value {
    let pt = t_int(@int_cast(i32, ptr_bytes * 8));
    let mut y = x;
    if x.ty.bits < pt.bits {
        y = zext(bd, x, pt);
    } else if x.ty.bits > pt.bits {
        y = trunc(bd, x, pt);
    }
    return cast(bd, OP_INTTOPTR, y, t_ptr());
}

pub fn alloca(bd: *mut Builder, t: *mut Ty, name: []u8) *mut Value {
    let v = emit(bd, OP_ALLOCA, t_ptr());
    set_aty(v, t);
    v.align = @int_cast(u32, t.align);
    set_name(v, name);
    return v;
}

pub fn load(bd: *mut Builder, t: *mut Ty, p: *mut Value) *mut Value {
    let v = emit(bd, OP_LOAD, t);
    v.a = p;
    v.align = @int_cast(u32, t.align);
    return v;
}

pub fn store(bd: *mut Builder, x: *mut Value, p: *mut Value) *mut Value {
    let v = emit(bd, OP_STORE, t_void());
    v.a = x;
    v.b = p;
    v.align = @int_cast(u32, x.ty.align);
    return v;
}

pub fn isz() *mut Ty {
    return t_int(@int_cast(i32, ptr_bytes * 8));
}

// p + off bytes (off: a pointer-sized integer)
pub fn ptradd(bd: *mut Builder, p: *mut Value, off: *mut Value) *mut Value {
    if is_cint(off) and (cint_val(off) == 0) {
        return p;
    }
    if (p.kind == V_INST) and (p.op == OP_PTRADD) and is_cint(p.b) and is_cint(off) {
        return ptradd(bd, p.a, cint(isz(), cint_val(p.b) +% cint_val(off)));
    }
    let v = emit(bd, OP_PTRADD, t_ptr());
    v.a = p;
    v.b = off;
    return v;
}

fn index_isz(bd: *mut Builder, i: *mut Value) *mut Value {
    let t = isz();
    if i.ty.bits < t.bits {
        return sext(bd, i, t);
    }
    if i.ty.bits > t.bits {
        return trunc(bd, i, t);
    }
    return i;
}

fn scaled(bd: *mut Builder, i: *mut Value, size: u64) *mut Value {
    let x = index_isz(bd, i);
    if size == 1 {
        return x;
    }
    return mul(bd, x, cint(isz(), size));
}

// LLVM-style GEP: the first index steps over whole `t`s; the rest index
// into struct fields (constant) or array elements.
pub fn gep(bd: *mut Builder, t: *mut Ty, p: *mut Value, idx: []mut *mut Value) *mut Value {
    let mut off = scaled(bd, idx[0], t.size);
    let mut cur = t;
    for k in 1..idx.len {
        let i = idx[k];
        if cur.kind == T_STRUCT {
            let fi = @truncate(usize, cint_val(i));
            off = add(bd, off, cint(isz(), cur.offs[fi]));
            cur = cur.fields[fi];
        } else {
            off = add(bd, off, scaled(bd, i, cur.elem.size));
            cur = cur.elem;
        }
    }
    return ptradd(bd, p, off);
}

pub fn gep1(bd: *mut Builder, t: *mut Ty, p: *mut Value, i: *mut Value) *mut Value {
    return ptradd(bd, p, scaled(bd, i, t.size));
}

pub fn struct_gep(bd: *mut Builder, t: *mut Ty, p: *mut Value, i: u32) *mut Value {
    return ptradd(bd, p, cint(isz(), field_off(t, @as(usize, i))));
}

pub fn memop(bd: *mut Builder, op: i32, d: *mut Value, s: *mut Value, n: *mut Value) *mut Value {
    let v = emit(bd, op, t_void());
    v.a = d;
    v.b = s;
    v.c = index_isz(bd, n);
    return v;
}

pub fn rmw(bd: *mut Builder, op: i32, p: *mut Value, x: *mut Value) *mut Value {
    let v = emit(bd, OP_RMW, x.ty);
    v.cv = @as(u64, @bit_cast(u32, op));
    v.a = p;
    v.b = x;
    v.align = @int_cast(u32, x.ty.size);
    v.flags = F_ATOMIC;
    return v;
}

pub fn cmpxchg(bd: *mut Builder, p: *mut Value, e: *mut Value, n: *mut Value) *mut Value {
    let v = emit(bd, OP_CMPXCHG, e.ty);
    v.a = p;
    v.b = e;
    v.c = n;
    v.align = @int_cast(u32, e.ty.size);
    v.flags = F_ATOMIC;
    return v;
}

pub fn fence(bd: *mut Builder) void {
    _ = emit(bd, OP_FENCE, t_void());
}

pub fn extract(bd: *mut Builder, agg: *mut Value, i: u32) *mut Value {
    let ft = field_ty(agg.ty, @as(usize, i));
    if agg.kind == V_CAGG {
        return agg.xs.get(@as(usize, i));
    }
    if agg.kind == V_ZERO {
        return czero(ft);
    }
    if agg.kind == V_UNDEF {
        return undef(ft);
    }
    // extract(insert(x, v, i), i) = v
    if (agg.kind == V_INST) and (agg.op == OP_INSERTVALUE) and (agg.cv == @as(u64, i)) {
        return agg.b;
    }
    let v = emit(bd, OP_EXTRACTVALUE, ft);
    v.a = agg;
    v.cv = @as(u64, i);
    return v;
}

pub fn insert(bd: *mut Builder, agg: *mut Value, x: *mut Value, i: u32) *mut Value {
    // constants fold (a literal of constants is a constant, and lowering
    // turns a large one into read-only data instead of stores)
    let ak = agg.kind;
    if is_const(x) and not is_tls_addr(x) and ((ak == V_CAGG) or (ak == V_UNDEF) or (ak == V_ZERO)) and
       (agg.ty.kind != T_VEC) and (field_count(agg.ty) <= 256) {
        let n = field_count(agg.ty);
        let xs = u.newn.[*mut Value](n + 1);
        for k in 0..n {
            if k == @as(usize, i) {
                xs[k] = x;
            } else if ak == V_CAGG {
                xs[k] = agg.xs.get(k);
            } else if ak == V_ZERO {
                xs[k] = czero(field_ty(agg.ty, k));
            } else {
                xs[k] = undef(field_ty(agg.ty, k));
            }
        }
        return cagg(agg.ty, xs[0..n]);
    }
    let v = emit(bd, OP_INSERTVALUE, agg.ty);
    v.a = agg;
    v.b = x;
    v.cv = @as(u64, i);
    return v;
}

pub fn extract_elem(bd: *mut Builder, vec: *mut Value, i: u64) *mut Value {
    let v = emit(bd, OP_EXTRACTELEM, vec.ty.elem);
    v.a = vec;
    v.cv = i;
    return v;
}

pub fn insert_elem(bd: *mut Builder, vec: *mut Value, x: *mut Value, i: u64) *mut Value {
    let v = emit(bd, OP_INSERTELEM, vec.ty);
    v.a = vec;
    v.b = x;
    v.cv = i;
    return v;
}

pub fn splat(bd: *mut Builder, vt: *mut Ty, x: *mut Value) *mut Value {
    let v = emit(bd, OP_SPLAT, vt);
    v.a = x;
    return v;
}

// Result lanes pick from the concatenation of x and y (indices into 2n lanes).
pub fn shuffle(bd: *mut Builder, x: *mut Value, y: *mut Value, mask: []i32) *mut Value {
    let n = mask.len;
    let v = emit(bd, OP_SHUFFLE, t_vec(x.ty.elem, @int_cast(u32, n)));
    v.a = x;
    v.b = y;
    set_mask(v, u.newn.[i32](n + 1)[0..n]);
    for i in 0..n {
        mask_of(v)[i] = mask[i];
    }
    return v;
}

pub fn call(bd: *mut Builder, fty: *mut Ty, callee: *mut Value, args: []mut *mut Value) *mut Value {
    let v = emit(bd, OP_CALL, fty.ret);
    set_fty(v, fty);
    v.a = callee;
    for x in args {
        v.xs.push(x);
    }
    set_ext(v, u.newn.[u8](args.len + 1)[0..args.len + 1]);
    return v;
}

// The function call v calls directly: its callee is a function of the
// call's own signature. A function pointer cast to another function type
// and called is still an indirect call once its value is known (on
// WebAssembly, call_indirect checks the signature and traps, T0009), so it
// is not one of the function's calls: nil.
pub fn direct_callee(v: *Value) *mut Func {
    if (v.op != OP_CALL) or (v.a.kind != V_FUNC) {
        return u.nil.[Func]();
    }
    let f = fnp_of(v.a);
    let t = fty_of(v);
    let ft = f.ty;
    if (t.ret != ft.ret) or (t.vararg != ft.vararg) or (t.params.len != ft.params.len) {
        return u.nil.[Func]();
    }
    for i in 0..t.params.len {
        if t.params[i] != ft.params[i] {
            return u.nil.[Func]();
        }
    }
    return f;
}

pub fn intr(bd: *mut Builder, id: i32, t: *mut Ty, args: []mut *mut Value) *mut Value {
    let v = emit(bd, OP_INTR, t);
    v.cv = @as(u64, @bit_cast(u32, id));
    for x in args {
        v.xs.push(x);
    }
    return v;
}

pub fn intr1(bd: *mut Builder, id: i32, x: *mut Value) *mut Value {
    let mut a: [1]*mut Value = [x];
    return intr(bd, id, x.ty, a[..]);
}

pub fn intr2(bd: *mut Builder, id: i32, x: *mut Value, y: *mut Value) *mut Value {
    let mut a: [2]*mut Value = [x, y];
    return intr(bd, id, x.ty, a[..]);
}

pub fn phi(bd: *mut Builder, t: *mut Ty) *mut Value {
    return emit(bd, OP_PHI, t);
}

pub fn add_incoming(p: *mut Value, x: *mut Value, b: *mut Block) void {
    p.xs.push(x);
    bs_mut(p).push(b);
}

pub fn br(bd: *mut Builder, b: *mut Block) void {
    let v = emit(bd, OP_BR, t_void());
    v.t1 = b;
}

pub fn condbr(bd: *mut Builder, c: *mut Value, t: *mut Block, e: *mut Block) void {
    if c.kind == V_CINT {
        if c.cv != 0 {
            br(bd, t);
        } else {
            br(bd, e);
        }
        return;
    }
    let v = emit(bd, OP_CONDBR, t_void());
    v.a = c;
    v.t1 = t;
    v.t2 = e;
}

pub fn switch_(bd: *mut Builder, x: *mut Value, dflt: *mut Block) *mut Value {
    let v = emit(bd, OP_SWITCH, t_void());
    v.a = x;
    v.t1 = dflt;
    return v;
}

pub fn add_case(sw: *mut Value, c: *mut Value, b: *mut Block) void {
    sw.xs.push(c);
    bs_mut(sw).push(b);
}

pub fn ret(bd: *mut Builder, x: *mut Value) void {
    let v = emit(bd, OP_RET, t_void());
    v.a = x;
}

pub fn ret_void(bd: *mut Builder) void {
    _ = emit(bd, OP_RET, t_void());
}

pub fn unreachable(bd: *mut Builder) void {
    _ = emit(bd, OP_UNREACHABLE, t_void());
}

// -----------------------------------------------------------------------------
// Printing (for --emit=ir and debugging)
// -----------------------------------------------------------------------------
fn op_name(op: i32) []u8 {
    let names = ["?", "add", "sub", "mul", "udiv", "sdiv", "urem", "srem", "and", "or", "xor", "shl", "lshr", "ashr",
                 "fadd", "fsub", "fmul", "fdiv", "frem", "fneg", "icmp", "fcmp", "select", "zext", "sext", "trunc",
                 "bitcast", "ptrtoint", "inttoptr", "fpext", "fptrunc", "sitofp", "uitofp", "fptosi.sat", "fptoui.sat",
                 "alloca", "load", "store", "ptradd", "memcpy", "memmove", "memset", "atomicrmw", "cmpxchg", "fence",
                 "extractvalue", "insertvalue", "extractelement", "insertelement", "shuffle", "splat", "call", "intr",
                 "phi", "br", "condbr", "switch", "ret", "unreachable", "copy"];
    if (op < 0) or (@int_cast(usize, op) >= names.len) {
        return "?";
    }
    return names[@int_cast(usize, op)];
}

pub fn val_str(v: *Value) []u8 {
    let k = v.kind;
    if k == V_INST {
        return u.cat2("%", u.idec(v.id));
    }
    if k == V_PARAM {
        return u.cat2("%arg", u.udec(v.cv));
    }
    if k == V_CINT {
        if v.ty.bits == 1 {
            return u.pick(v.cv != 0, "true", "false");
        }
        return u.dec(sval(v));
    }
    if k == V_CFP {
        return u.ffmt("%g", fv_of(v));
    }
    if k == V_ZERO {
        return "zero";
    }
    if k == V_UNDEF {
        return "undef";
    }
    if k == V_GLOBAL {
        return u.cat2("@", gv_of(v).name);
    }
    if k == V_FUNC {
        return u.cat2("@", fnp_of(v).name);
    }
    let mut b = u.Buf.init();
    b.s("{");
    for i in 0..v.xs.len {
        if i != 0 {
            b.s(", ");
        }
        b.s(val_str(v.xs.get(i)));
    }
    b.s("}");
    return b.done();
}

fn blk_str(b: *Block) []u8 {
    return u.f2("%%%s.%s", b.name, u.idec(b.id));
}

pub fn inst_str(v: *Value) []u8 {
    let mut b = u.Buf.init();
    if v.ty.kind != T_VOID {
        b.s(val_str(v));
        b.s(" = ");
    }
    b.s(op_name(v.op));
    if (v.op == OP_ICMP) or (v.op == OP_FCMP) or (v.op == OP_RMW) or (v.op == OP_INTR) or (v.op == OP_EXTRACTVALUE) or
       (v.op == OP_INSERTVALUE) or (v.op == OP_EXTRACTELEM) or (v.op == OP_INSERTELEM) {
        b.s(".");
        b.s(u.udec(v.cv));
    }
    if (v.flags & F_ATOMIC) != 0 {
        b.s(" atomic");
    }
    if (v.flags & F_VOLATILE) != 0 {
        b.s(" volatile");
    }
    b.s(" ");
    b.s(ty_str(v.ty));
    if v.op == OP_ALLOCA {
        b.s(" ");
        b.s(ty_str(aty_of(v)));
    }
    let ops: [3]*mut Value = [v.a, v.b, v.c];
    for o in ops {
        if u.notnil(o) {
            b.s(" ");
            b.s(val_str(o));
        }
    }
    for i in 0..v.xs.len {
        b.s(", ");
        b.s(val_str(v.xs.get(i)));
        if (v.op == OP_CALL) and ((i + 1) < ext_of(v).len) {
            if ext_of(v)[i + 1] == EXT_BYVAL {
                b.s(" byval");
            } else if ext_of(v)[i + 1] == EXT_SRET {
                b.s(" sret");
            }
        }
        if i < bs_of(v).len {
            b.s(" ");
            b.s(blk_str(bs_of(v).get(i)));
        }
    }
    if u.notnil(v.t1) {
        b.s(" -> ");
        b.s(blk_str(v.t1));
    }
    if u.notnil(v.t2) {
        b.s(", ");
        b.s(blk_str(v.t2));
    }
    if mask_of(v).len > 0 {
        b.s(" [");
        for i in 0..mask_of(v).len {
            if i != 0 {
                b.s(",");
            }
            b.s(u.idec(mask_of(v)[i]));
        }
        b.s("]");
    }
    if v.align != 0 {
        b.s(", align ");
        b.s(u.udec(@as(u64, v.align)));
    }
    return b.done();
}

pub fn func_str(f: *mut Func) []u8 {
    let mut b = u.Buf.init();
    b.s(u.pick(is_decl(f), "declare ", "define "));
    b.s(ty_str(f.ty.ret));
    b.s(" @");
    b.s(f.name);
    b.s("(");
    for i in 0..f.params.len {
        if i != 0 {
            b.s(", ");
        }
        b.s(ty_str(f.params[i].ty));
    }
    b.s(")");
    if is_decl(f) {
        b.s("\n");
        return b.done();
    }
    b.s(" {\n");
    let mut bb = f.first;
    while u.notnil(bb) {
        b.s(blk_str(bb));
        b.s(":\n");
        let mut i = bb.first;
        while u.notnil(i) {
            b.s("    ");
            b.s(inst_str(i));
            b.s("\n");
            i = i.next;
        }
        bb = bb.next;
    }
    b.s("}\n");
    return b.done();
}

pub fn module_str(m: *mut Module) []u8 {
    let mut b = u.Buf.init();
    for i in 0..m.globals.len {
        let g = m.globals.get(i);
        b.s("@");
        b.s(g.name);
        b.s(" = ");
        b.s(u.pick(g.is_const, "constant ", "global "));
        b.s(ty_str(g.ty));
        if u.notnil(g.init) {
            b.s(" ");
            b.s(val_str(g.init));
        }
        b.s("\n");
    }
    for i in 0..m.funcs.len {
        b.s("\n");
        b.s(func_str(m.funcs.get(i)));
    }
    return b.done();
}

// -----------------------------------------------------------------------------
// CFG utilities
// -----------------------------------------------------------------------------
// Deletes the blocks not reachable from the entry, and the phi inputs that
// came from them.
pub fn remove_unreachable(f: *mut Func) void {
    if u.isnil(f.first) {
        return;
    }
    let mut b = f.first;
    while u.notnil(b) {
        b.aux = 0;
        b = b.next;
    }
    let mut work = u.List.[*mut Block].empty();
    f.first.aux = 1;
    work.push(f.first);
    while work.len > 0 {
        let x = work.pop();
        let t = terminator(x);
        for i in 0..succ_count(t) {
            let s = succ(t, i);
            if s.aux == 0 {
                s.aux = 1;
                work.push(s);
            }
        }
    }
    work.deinit();
    b = f.first;
    let mut any = false;
    while u.notnil(b) {
        let next = b.next;
        if b.aux == 0 {
            remove_block(b);
            any = true;
        }
        b = next;
    }
    if not any {
        return;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) and (i.op == OP_PHI) {
            let mut k: usize = 0;
            while k < bs_of(i).len {
                if bs_of(i).get(k).aux == 0 {
                    remove_incoming(i, k);
                } else {
                    k += 1;
                }
            }
            i = i.next;
        }
        b = b.next;
    }
}

fn resolve_const(c: *mut Value) void {
    if c.kind != V_CAGG {
        return;
    }
    for k in 0..c.xs.len {
        let x = resolve(c.xs.get(k));
        c.xs.set(k, x);
        resolve_const(x);
    }
}

// Declarations of a function the module also defines (an extern "C" block
// naming a runtime export, say) refer to the definition. Same for globals.
pub fn merge_same_named(m: *mut Module) void {
    let mut defs = u.SymMap.[*mut Func].{ keys: u.nil.[usize](), vals: u.nil.[*mut Func](), cap: 0, len: 0 };
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if not is_decl(f) and (f.linkage != LINK_INTERNAL) {
            defs.put(f.name, f);
        }
    }
    let mut any = false;
    let mut kept = u.List.[*mut Func].empty();
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if is_decl(f) {
            let d = defs.get(f.name);
            if u.notnil(d) {
                forward(f.val, d.val);
                any = true;
                continue;
            }
        }
        f.id = @int_cast(i32, kept.len);
        kept.push(f);
    }
    if not any {
        return;
    }
    m.funcs = kept;
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        m.fmap.put(f.name, f);
        apply_forwarding(f);
    }
    for i in 0..m.globals.len {
        let g = m.globals.get(i);
        if u.notnil(g.init) {
            g.init = resolve(g.init);
            resolve_const(g.init);
        }
    }
}
