// =============================================================================
// cgen_vec.ax - IR generation for the GNU dialects' vector types
// (csema_vec.ax): their operators, conversions, lane-wise conditions and
// the vector builtins. Part of cgen.ax.
//
// A vector value is memory, as a structure's is (its address: a temporary's
// or an object's, never written through), so that copies, initializers,
// members, arguments and results need nothing of their own. Where the IR's
// vector types hold its lanes (vec_chunk: integers of 8 to 64 bits,
// binary32, binary64, _Float16's bits; 16 bytes or more, on a target that
// has them: WebAssembly with simd128), that memory is chunks of an IR vector
// type of at most 64 bytes, and each operation is one IR vector operation per
// chunk: scalar replacement keeps the values in vector registers, and
// vsplit.ax computes the chunks wider than the target's registers in pieces.
// An operation the IR has no vector form of (integer / and %, a product of
// 8-bit lanes, any operation on _Float16 lanes, conversions that change the
// lanes' width), and every operation on the other vectors (smaller than 16
// bytes, or of wider elements: long double, _Float128, __int128), is done
// lane by lane with the scalar operations of cgen_expr.ax, from the lanes
// taken out of the chunks (or out of memory) and put back. A comparison's
// lanes are -1 or 0 (the IR's lane masks are such).
// =============================================================================
import "../ir.ax" as ir;
import "../util.ax" as u;
import "cast.ax" as cast;
import "csema.ax" as cs;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;

// A vector type as its memory is laid out: its lanes (n, of type el, es
// bytes each), and where the IR's vector types hold them its chunks (ch,
// nch of them, lpc lanes each).
struct Shape {
    t: *mut cty.CType,
    el: *mut cty.CType,
    n: u64,
    es: u64,
    ch: *mut ir.Ty,
    nch: u64,
    lpc: u64,
    al: u64,  // the alignment chunks and lanes are accessed with
}

fn vec_shape(t0: *mut cty.CType) Shape {
    let t = cty.unqual(t0);
    let ch = vec_chunk(t);
    let mut nch: u64 = 0;
    let mut lpc: u64 = 0;
    if u.notnil(ch) {
        nch = cty.size_of(t) / ch.size;
        lpc = @as(u64, @bit_cast(u32, ch.lanes));
    }
    return Shape.{ t: t, el: t.elem, n: t.len, es: cty.size_of(t.elem), ch: ch, nch: nch, lpc: lpc,
                   al: @min(cty.align_of(t), 16) };
}

fn vec_temp(t: *mut cty.CType) *mut ir.Value {
    return temp_object(cty.unqual(t), "vec");
}

fn vec_at(p: *mut ir.Value, off: u64) *mut ir.Value {
    if off == 0 {
        return p;
    }
    return ir.ptradd(B, p, usz(off));
}

fn vec_load_chunk(s: *mut Shape, p: *mut ir.Value, k: u64) *mut ir.Value {
    let v = ir.load(B, s.ch, vec_at(p, k * s.ch.size));
    v.align = @truncate(u32, s.al);
    return v;
}

fn vec_store_chunk(s: *Shape, v: *mut ir.Value, p: *mut ir.Value, k: u64) void {
    let st = ir.store(B, v, vec_at(p, k * s.ch.size));
    st.align = @truncate(u32, s.al);
}

// Lane i of the vector at p (of shape s), from memory: a scalar, or the
// address of a copy (an element that is a value in memory).
fn vec_lane_load(s: *mut Shape, p: *mut ir.Value, i: u64) *mut ir.Value {
    let a = vec_at(p, i * s.es);
    if cty.is_wide(s.el) {
        return ld_snapshot(a, false);
    }
    let v = load(s.el, a);
    if (v.kind == ir.V_INST) and (v.op == ir.OP_LOAD) {
        v.align = @truncate(u32, @min(s.es, s.al));
    }
    return v;
}

fn vec_lane_store(s: *Shape, v: *mut ir.Value, p: *mut ir.Value, i: u64) void {
    let a = vec_at(p, i * s.es);
    if cty.is_wide(s.el) {
        ld_copy(a, v, false);
        return;
    }
    if cty.is_wint(s.el) {
        wint_copy(s.el, a, v, false);
        return;
    }
    let st = ir.store(B, v, a);
    st.align = @truncate(u32, @min(s.es, s.al));
}

// -----------------------------------------------------------------------------
// The expressions
// -----------------------------------------------------------------------------

fn vec_expr(e: *mut cast.Expr, x: *mut ir.Value, y: *mut ir.Value) *mut ir.Value {
    let k = e.kind;
    if k == cast.ExprKind.CAST {
        if e.op == cast.CV_SPLAT {
            return vec_splat(e.ty, rv(e.a));
        }
        return vec_bits(e.a.ty, e.ty, rv(e.a));
    }
    if k == cast.ExprKind.BINARY {
        let a = rv(e.a);
        if vec_is_shift(e.op) and vec_splatted(e.b) {
            return vec_shift(e.op, e.a.ty, a, rv(e.b.a));
        }
        let b = rv(e.b);
        return vec_binop(e.op, e.a.ty, a, b);
    }
    if k == cast.ExprKind.UNARY {
        return vec_unary(e.op, e.ty, rv(e.a));
    }
    if k == cast.ExprKind.ASSIGN {
        // (compound: x the old value, y the right operand's; a count given
        // to every lane is lane 0's)
        let op = vec_base_op(e.op);
        if vec_is_shift(op) and vec_splatted(e.b) {
            let mut s = vec_shape(e.b.ty);
            return vec_shift(op, e.opty, x, vec_lane_load(&mut s, y, 0));
        }
        return vec_binop(op, e.opty, x, y);
    }
    if (k == cast.ExprKind.POSTFIX) or (k == cast.ExprKind.UNARY) {
        let one = vec_splat(e.opty, one_of(e.opty.unq.elem));
        let mut op = ct.P_PLUS;
        if e.op == ct.P_DEC {
            op = ct.P_MINUS;
        }
        return vec_binop(op, e.opty, x, one);
    }
    if k == cast.ExprKind.COND {
        let c = rv(e.a);
        let a = rv(e.b);
        let b = rv(e.c);
        return vec_select(e.a.ty, e.ty, c, a, b);
    }
    return vec_convertvector(e.a.ty, e.ty, rv(e.a));
}

fn vec_is_shift(op: i32) bool {
    return (op == ct.P_SHL) or (op == ct.P_SHR);
}

// Is e a scalar given to every lane (a shift count the same for all)?
fn vec_splatted(e: *cast.Expr) bool {
    return (e.kind == cast.ExprKind.CAST) and (e.op == cast.CV_SPLAT);
}

// x << n or x >> n of vector type t, n (a scalar of its element type) the
// count of every lane: the IR's shift by a count given to every lane (as
// Axiom's vector shifts are); a count of the lanes' width or more is
// undefined in C (the backends mask it).
fn vec_shift(op: i32, t: *mut cty.CType, x: *mut ir.Value, n: *mut ir.Value) *mut ir.Value {
    let mut s = vec_shape(t);
    if u.isnil(s.ch) {
        return vec_binop(op, t, x, vec_splat(t, n));
    }
    let r = vec_temp(t);
    let c = ir.splat(B, s.ch, n);
    let mut o = ir.OP_SHL;
    if op == ct.P_SHR {
        o = vec_pick(s.el.unq.is_signed, ir.OP_ASHR, ir.OP_LSHR);
    }
    for k in 0..s.nch {
        vec_store_chunk(&s, ir.binop(B, o, vec_load_chunk(&mut s, x, k), c), r, k);
    }
    return r;
}

fn vec_base_op(op: i32) i32 {
    let ops: [10]i32 = [ct.P_MUL_EQ, ct.P_DIV_EQ, ct.P_MOD_EQ, ct.P_ADD_EQ, ct.P_SUB_EQ, ct.P_SHL_EQ, ct.P_SHR_EQ,
                        ct.P_AND_EQ, ct.P_XOR_EQ, ct.P_OR_EQ];
    let bs: [10]i32 = [ct.P_STAR, ct.P_SLASH, ct.P_PERCENT, ct.P_PLUS, ct.P_MINUS, ct.P_SHL, ct.P_SHR, ct.P_AMP,
                       ct.P_CARET, ct.P_PIPE];
    for k in 0..ops.len {
        if ops[k] == op {
            return bs[k];
        }
    }
    return op;
}

/// Scalar v (of t's element type) in every lane of a new vector of type t.
fn vec_splat(t: *mut cty.CType, v: *mut ir.Value) *mut ir.Value {
    let s = vec_shape(t);
    let r = vec_temp(t);
    if u.notnil(s.ch) {
        let c = ir.splat(B, s.ch, v);
        for k in 0..s.nch {
            vec_store_chunk(&s, c, r, k);
        }
        return r;
    }
    for i in 0..s.n {
        vec_lane_store(&s, v, r, i);
    }
    return r;
}

// The value v of type `from` (a vector, or an integer) as one of type t of
// the same size (a vector, or an integer): its bytes.
fn vec_bits(from: *mut cty.CType, t: *mut cty.CType, v: *mut ir.Value) *mut ir.Value {
    let n = cty.size_of(t);
    if cty.is_vector(t) and cty.is_integer(from) and not cty.is_wint(from) {
        let r = vec_temp(t);
        let st = ir.store(B, v, r);
        st.align = @truncate(u32, @min(n, 16));
        return r;
    }
    if cty.is_integer(t) and not cty.is_wint(t) {
        let x = ir.load(B, lty(t), v);
        x.align = @truncate(u32, @min(n, cty.align_of(from)));
        return x;
    }
    // (two vectors, or a vector and an integer wider than 64 bits: memory)
    let r = alloca(cty.unqual(t), "vec");
    vec_copy(from, r, v);
    return r;
}

fn vec_is_float_lane(el: *cty.CType) bool {
    return cty.is_floating(el);
}

// Does the IR have op as one vector operation on chunks of shape s (its
// result's lanes as wide as its operands')?
fn vec_native(op: i32, s: *Shape) bool {
    if u.isnil(s.ch) or cty.is_half(s.el) {
        return false;
    }
    let fl = vec_is_float_lane(s.el);
    if (op == ct.P_PLUS) or (op == ct.P_MINUS) {
        return true;
    }
    if op == ct.P_STAR {
        return fl or (s.es > 1);  // (no product of 8-bit lanes)
    }
    if op == ct.P_SLASH {
        return fl;
    }
    if (op == ct.P_AMP) or (op == ct.P_PIPE) or (op == ct.P_CARET) {
        return not fl;
    }
    if (op == ct.P_LT) or (op == ct.P_GT) or (op == ct.P_LE) or (op == ct.P_GE) or (op == ct.P_EQ) or (op == ct.P_NE) {
        return true;
    }
    return false;
}

fn vec_is_cmp(op: i32) bool {
    return (op == ct.P_LT) or (op == ct.P_GT) or (op == ct.P_LE) or (op == ct.P_GE) or (op == ct.P_EQ) or
           (op == ct.P_NE);
}

// x op y on chunks a and b (vec_native(op)).
fn vec_chunk_op(op: i32, s: *Shape, a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    let fl = vec_is_float_lane(s.el);
    let sg = s.el.unq.is_signed;
    if vec_is_cmp(op) {
        if fl {
            let mut p = ir.RealOEQ;
            if op == ct.P_NE {
                p = ir.RealUNE;
            } else if op == ct.P_LT {
                p = ir.RealOLT;
            } else if op == ct.P_GT {
                p = ir.RealOGT;
            } else if op == ct.P_LE {
                p = ir.RealOLE;
            } else if op == ct.P_GE {
                p = ir.RealOGE;
            }
            let c = ir.fcmp(B, p, a, b);
            if (op != ct.P_EQ) and (op != ct.P_NE) and (c.kind == ir.V_INST) {
                // (the relational operators signal "invalid" for a NaN lane, as
                // the scalar ones do: F.9.3; the backends' vector compares do)
                c.flags = c.flags | ir.F_SIGNALING;
            }
            return c;
        }
        return ir.icmp(B, int_pred(op, sg), a, b);
    }
    let mut o = ir.OP_ADD;
    if op == ct.P_MINUS {
        o = vec_pick(fl, ir.OP_FSUB, ir.OP_SUB);
    } else if op == ct.P_PLUS {
        o = vec_pick(fl, ir.OP_FADD, ir.OP_ADD);
    } else if op == ct.P_STAR {
        o = vec_pick(fl, ir.OP_FMUL, ir.OP_MUL);
    } else if op == ct.P_SLASH {
        o = ir.OP_FDIV;
    } else if op == ct.P_AMP {
        o = ir.OP_AND;
    } else if op == ct.P_PIPE {
        o = ir.OP_OR;
    } else if op == ct.P_CARET {
        o = ir.OP_XOR;
    } else if op == ct.P_SHL {
        o = ir.OP_SHL;
    } else {
        o = vec_pick(sg, ir.OP_ASHR, ir.OP_LSHR);
    }
    return ir.binop(B, o, a, b);
}

fn vec_pick(c: bool, a: i32, b: i32) i32 {
    if c {
        return a;
    }
    return b;
}

// Lane values a and b (of element type el) op'd: the scalar operation, a
// comparison's -1 or 0 of the result's element type rel.
fn vec_lane_op(op: i32, el: *mut cty.CType, rel: *mut cty.CType, a: *mut ir.Value, b: *mut ir.Value) *mut ir.Value {
    if vec_is_cmp(op) {
        let c = compare_values(op, el, a, b);
        if cty.is_wint(rel) {
            let r = wint_temp(rel);
            let m = ir.sext(B, c, ir.t_int(64));
            for k in 0..cty.limbs(rel) {
                let st = ir.store(B, m, vec_at(r, @as(u64, k) * 8));
                st.align = 8;
            }
            return r;
        }
        return ir.sext(B, c, lty(rel));
    }
    return arith_wrap(op, el, a, b, el);
}

/// x op y (both of vector type t; op a binary operator's): a new vector,
/// of type t or for a comparison of csema_vec.cmp_type(t).
fn vec_binop(op: i32, t: *mut cty.CType, x: *mut ir.Value, y: *mut ir.Value) *mut ir.Value {
    let mut s = vec_shape(t);
    let mut rt = cty.unqual(t);
    if vec_is_cmp(op) {
        rt = cs.cmp_type(t);
    }
    let rs = vec_shape(rt);
    let r = vec_temp(rt);
    if u.notnil(s.ch) {
        let nat = vec_native(op, &s);
        for k in 0..s.nch {
            let a = vec_load_chunk(&mut s, x, k);
            let b = vec_load_chunk(&mut s, y, k);
            if nat {
                vec_store_chunk(&rs, vec_chunk_op(op, &s, a, b), r, k);
                continue;
            }
            let mut v = ir.undef(rs.ch);
            for i in 0..s.lpc {
                let ai = ir.extract_elem(B, a, i);
                let bi = ir.extract_elem(B, b, i);
                v = ir.insert_elem(B, v, vec_lane_op(op, s.el, rs.el, ai, bi), i);
            }
            vec_store_chunk(&rs, v, r, k);
        }
        return r;
    }
    for i in 0..s.n {
        vec_lane_store(&rs, vec_lane_op(op, s.el, rs.el, vec_lane_load(&mut s, x, i), vec_lane_load(&mut s, y, i)), r,
                       i);
    }
    return r;
}

// op x (unary + - ~) of vector type t.
fn vec_unary(op: i32, t: *mut cty.CType, x: *mut ir.Value) *mut ir.Value {
    if op == ct.P_PLUS {
        return x;
    }
    let mut s = vec_shape(t);
    let r = vec_temp(t);
    if u.notnil(s.ch) {
        for k in 0..s.nch {
            let a = vec_load_chunk(&mut s, x, k);
            let mut v = ir.vnil();
            if op == ct.P_TILDE {
                v = ir.xor(B, a, ir.splat(B, s.ch, ir.cint(s.ch.elem, 0xFFFF_FFFF_FFFF_FFFF)));
            } else if cty.is_half(s.el) {
                v = ir.xor(B, a, ir.splat(B, s.ch, ir.cint(s.ch.elem, 0x8000)));  // (the sign bits)
            } else if vec_is_float_lane(s.el) {
                v = ir.fneg(B, a);
            } else {
                v = ir.sub(B, ir.czero(s.ch), a);
            }
            vec_store_chunk(&s, v, r, k);
        }
        return r;
    }
    for i in 0..s.n {
        let a = vec_lane_load(&mut s, x, i);
        let mut v = ir.vnil();
        if op == ct.P_TILDE {
            v = bitnot_value(s.el, a);
        } else {
            v = negate_value(s.el, a);
        }
        vec_lane_store(&s, v, r, i);
    }
    return r;
}

// c ? a : b lane by lane: c of integer vector type ct, a and b of vector
// type t (of c's shape).
fn vec_select(ctype: *mut cty.CType, t: *mut cty.CType, c: *mut ir.Value, a: *mut ir.Value,
              b: *mut ir.Value) *mut ir.Value {
    let mut cshape = vec_shape(ctype);
    let mut s = vec_shape(t);
    let r = vec_temp(t);
    if u.notnil(s.ch) and u.notnil(cshape.ch) {
        for k in 0..s.nch {
            let m = ir.icmp(B, ir.IntNE, vec_load_chunk(&mut cshape, c, k), ir.czero(cshape.ch));  // (a lane mask: -1 or 0)
            let x = ir.bitcast(B, vec_load_chunk(&mut s, a, k), m.ty);
            let y = ir.bitcast(B, vec_load_chunk(&mut s, b, k), m.ty);
            let ones = ir.splat(B, m.ty, ir.cint(m.ty.elem, 0xFFFF_FFFF_FFFF_FFFF));
            let v = ir.or_(B, ir.and_(B, x, m), ir.and_(B, y, ir.xor(B, m, ones)));
            vec_store_chunk(&s, ir.bitcast(B, v, s.ch), r, k);
        }
        return r;
    }
    for i in 0..s.n {
        let ci = truth(vec_lane_load(&mut cshape, c, i), cshape.el);
        let mut v = ir.vnil();
        if cty.is_wide(s.el) or cty.is_wint(s.el) {
            v = ir.select(B, ci, vec_at(a, i * s.es), vec_at(b, i * s.es));  // (the lane's address)
        } else {
            v = ir.select(B, ci, vec_lane_load(&mut s, a, i), vec_lane_load(&mut s, b, i));
        }
        vec_lane_store(&s, v, r, i);
    }
    return r;
}

// __builtin_convertvector: each lane of v (of vector type f) converted to
// t's element type.
fn vec_convertvector(f: *mut cty.CType, t: *mut cty.CType, v: *mut ir.Value) *mut ir.Value {
    let mut fs = vec_shape(f);
    let ts = vec_shape(t);
    let r = vec_temp(t);
    let fe = fs.el.unq;
    let te = ts.el.unq;
    if fe == te {
        vec_copy(f, r, v);
        return r;
    }
    let same_kind = cty.is_integer(fe) == cty.is_integer(te);
    if u.notnil(fs.ch) and u.notnil(ts.ch) and (fs.es == ts.es) and not cty.is_half(fe) and not cty.is_half(te) and
       (same_kind or not is_wasm) {
        // (lanes of one width: the IR's lane-wise conversion, or the bits
        // between integers of one width)
        let mut cop: i32 = -1;
        if cty.is_integer(fe) and cty.is_floating(te) {
            cop = vec_pick(fe.is_signed, ir.OP_SITOFP, ir.OP_UITOFP);
        } else if cty.is_floating(fe) and cty.is_integer(te) {
            cop = vec_pick(te.is_signed, ir.OP_FPTOSI_SAT, ir.OP_FPTOUI_SAT);
        }
        for k in 0..fs.nch {
            let a = vec_load_chunk(&mut fs, v, k);
            if cop < 0 {
                vec_store_chunk(&ts, ir.bitcast(B, a, ts.ch), r, k);
            } else {
                vec_store_chunk(&ts, ir.cast(B, cop, a, ts.ch), r, k);
            }
        }
        return r;
    }
    for i in 0..fs.n {
        vec_lane_store(&ts, convert(vec_lane_load(&mut fs, v, i), fe, te), r, i);
    }
    return r;
}

// -----------------------------------------------------------------------------
// The builtins
// -----------------------------------------------------------------------------

fn vec_builtin(e: *mut cast.Expr, vs: []mut *mut ir.Value) *mut ir.Value {
    if e.op == cs.GB_SHUFFLE {
        return vec_shuffle(e, vs);
    }
    return vec_shufflevector(e, vs);
}

// __builtin_shuffle(a, [b,] mask): lane i is lane (mask[i] modulo n, or 2n
// with b) of a then b, from a copy of them side by side.
fn vec_shuffle(e: *mut cast.Expr, vs: []mut *mut ir.Value) *mut ir.Value {
    let t = e.ty;
    let mut s = vec_shape(t);
    let two = vs.len == 3;
    let size = cty.size_of(t);
    let both = temp_object(cty.array_of(cty.t_uchar, 2 * size, true), "shuf");
    vec_copy(t, both, vs[0]);
    let mut lanes = s.n;
    if two {
        vec_copy(t, vec_at(both, size), vs[1]);
        lanes = 2 * s.n;
    }
    let mt = e.args.get(vs.len - 1).ty;
    let mut ms = vec_shape(mt);
    let r = vec_temp(t);
    for i in 0..s.n {
        let mut m = vec_lane_load(&mut ms, vs[vs.len - 1], i);
        if cty.is_wint(ms.el) {
            m = wint_limb(m, 0);
        }
        let mut mi = m;
        if mi.ty.bits < T_isz.bits {
            mi = ir.zext(B, mi, T_isz);
        } else if mi.ty.bits > T_isz.bits {
            mi = ir.trunc(B, mi, T_isz);
        }
        let j = ir.and_(B, mi, usz(lanes - 1));
        let src = ir.ptradd(B, both, ir.mul(B, j, usz(s.es)));
        vec_lane_store(&s, vec_lane_load(&mut s, src, 0), r, i);
    }
    return r;
}

// __builtin_shufflevector(a, b, i...) (constant indices; -1: any lane).
fn vec_shufflevector(e: *mut cast.Expr, vs: []mut *mut ir.Value) *mut ir.Value {
    let t = e.ty;
    let at_ = e.args.get(0).ty;
    let mut s = vec_shape(at_);
    let rs = vec_shape(t);
    let m = e.args.len - 2;
    let mask = u.newn.[i32](m + 1);
    for k in 0..m {
        let v = @bit_cast(i64, e.args.get(k + 2).cval);
        mask[k] = 0;
        if v >= 0 {
            mask[k] = @truncate(i32, v);
        }
    }
    let r = vec_temp(t);
    if u.notnil(s.ch) and u.notnil(rs.ch) and (s.nch == 1) and (rs.nch == 1) {
        let a = vec_load_chunk(&mut s, vs[0], 0);
        let b = vec_load_chunk(&mut s, vs[1], 0);
        vec_store_chunk(&rs, ir.shuffle(B, a, b, mask[0..m]), r, 0);
        return r;
    }
    for k in 0..m {
        let j = @as(u64, @bit_cast(u32, mask[k]));
        let mut src = vs[0];
        let mut l = j;
        if j >= s.n {
            src = vs[1];
            l = j - s.n;
        }
        vec_lane_store(&rs, vec_lane_load(&mut s, src, l), r, @as(u64, k));
    }
    return r;
}
