// =============================================================================
// cgen_va.ax - IR generation for the platform C calling conventions (the
// Plans of cgen_abi.ax): the arguments of a call and its result, a
// function's parameters and its return. Part of cgen.ax (see also
// cgen_va_arg.ax).
//
// Values are as cgen.ax has them: a scalar is an IR value, a structure or
// union the address of memory holding it.
//
// A variadic function saves at its start the registers its plan's pads
// arrive in, where va_arg finds them: System V's register save area (176
// bytes: rdi..r9, then xmm0-7 in 16-byte slots), AArch64's (64 bytes of
// x0-x7 below __gr_top, 128 of q0-q7 below __vr_top), or (Windows) the home
// area its caller reserved above the return address (on ARM64, the
// function itself above its frame record: ir.Func.va_home); its stack arguments
// start 16 bytes above the frame address (IN_FRAME_ADDR: the saved frame
// pointer and the return address are there).
// =============================================================================
import "../ir.ax" as ir;
import "../target.ax" as tg;
import "../util.ax" as u;
import "cast.ax" as cast;
import "cgen_abi.ax" as abi;
import "cgen_debug.ax" as cdbg;
import "ctypes.ax" as cty;

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------

fn va_c32(v: i64) *mut ir.Value {
    return ir.cint(T_i32, @bit_cast(u64, v));
}

fn va_c64(v: u64) *mut ir.Value {
    return ir.cint(i64t(), v);
}

// p + off bytes.
fn va_at(p: *mut ir.Value, off: u64) *mut ir.Value {
    if off == 0 {
        return p;
    }
    return ir.ptradd(B, p, usz(off));
}

// The largest power of two (at most a) that divides off.
fn va_align_at(a: u64, off: u64) u64 {
    let mut al = a;
    while (al > 1) and ((off % al) != 0) {
        al = al / 2;
    }
    if al == 0 {
        return 1;
    }
    return al;
}

fn va_ld(t: *mut ir.Ty, p: *mut ir.Value, al: u64) *mut ir.Value {
    let v = ir.load(B, t, p);
    v.align = @truncate(u32, @min(al, t.size));
    return v;
}

fn va_st(v: *mut ir.Value, p: *mut ir.Value, al: u64) void {
    let s = ir.store(B, v, p);
    s.align = @truncate(u32, @min(al, v.ty.size));
}

// A buffer of n bytes in the frame, aligned to al.
fn va_buffer(n: u64, al: u64) *mut ir.Value {
    let mut sz = n;
    if sz == 0 {
        sz = 1;
    }
    return aligned_alloca(cty.array_of(cty.t_uchar, sz, true), "abi", al);
}

fn va_copy_bytes(dst: *mut ir.Value, src: *mut ir.Value, n: u64) void {
    if n > 0 {
        _ = ir.memop(B, ir.OP_MEMMOVE, dst, src, usz(n));
    }
}

// The memory of a structure or union of type t at p, readable for span
// bytes: p, or a copy.
fn va_readable(t: *cty.CType, p: *mut ir.Value, span: u64) *mut ir.Value {
    let size = cty.size_of(t);
    if span <= size {
        return p;
    }
    let b = va_buffer(span, cty.align_of(t));
    va_copy_bytes(b, p, size);
    return b;
}

fn va_alloc_of(t: *mut cty.CType, span: u64) *mut ir.Value {
    if span <= cty.size_of(t) {
        return alloca(t, "tmp");
    }
    return va_buffer(span, @max(cty.align_of(t), 8));
}

// A pointer as an integer and back (for rounding addresses up).
fn va_round_ptr(p: *mut ir.Value, al: u64) *mut ir.Value {
    if al <= 1 {
        return p;
    }
    let i = ir.ptrtoint(B, p, T_isz);
    let r = ir.and_(B, ir.add(B, i, usz(al - 1)), usz(0 - al));
    return ir.inttoptr(B, r);
}

// A value of the promoted type `from` as one of type t (for va_arg of a
// type the promotions change): a narrower integer or float.
fn va_narrow(v: *mut ir.Value, t: *cty.CType) *mut ir.Value {
    if t.kind == cty.TK_BOOL {
        let nz = ir.icmp(B, ir.IntNE, v, ir.cint(v.ty, 0));
        return ir.zext(B, nz, ir.t_int(8));
    }
    if cty.is_integer(t) and (cty.storage_bits(t) < v.ty.bits) {
        return ir.trunc(B, v, ir.t_int(cty.storage_bits(t)));
    }
    if (t.kind == cty.TK_FLOAT) and (v.ty.bits == 64) {
        return ir.cast(B, ir.OP_FPTRUNC, v, ir.t_float(32));
    }
    return v;
}

// A _Float16 (its bits, an i16) as the ABIs pass it: an f32 whose low 16
// bits are them (cgen_abi.scalar_ty).
fn va_half_out(v: *mut ir.Value) *mut ir.Value {
    return ir.bitcast(B, ir.zext(B, v, T_i32), ir.t_float(32));
}

// A _Float16 received as va_half_out makes it: its bits.
fn va_half_in(x: *mut ir.Value) *mut ir.Value {
    return ir.trunc(B, ir.bitcast(B, x, T_i32), ir.t_int(16));
}

// The IR type of scalar C type t.
fn va_sty(t: *mut cty.CType) *mut ir.Ty {
    return lty(t);
}

// -----------------------------------------------------------------------------
// Calls
// -----------------------------------------------------------------------------

/// Emits a call of callee (of IR type fty, made by plan p) with the C
/// argument values vs; returns the C result's value (nil for void).
fn emit_call(p: *mut abi.Plan, fty: *mut ir.Ty, callee: *mut ir.Value, vs: []mut *mut ir.Value) *mut ir.Value {
    let nt = p.tys.len;
    let args = u.newn.[*mut ir.Value](nt + 1);
    let mut res: ?*mut ir.Value = .none;
    let mut vb = ir.vnil();
    for k in 0..nt {
        let w = p.what.get(k);
        let t = p.tys.get(k);
        if w == abi.SL_RET {
            let buf = alloca(p.rty, "ret");
            res = .some(buf);
            args[k] = buf;
        } else if w == abi.SL_VABUF {
            vb = va_buffer(p.vabuf_size + 8, 16);
            args[k] = vb;
        } else if w == abi.SL_CHAIN {
            args[k] = next_chain;  // (a nested function's: cgen_nest.ax)
            next_chain = ir.vnil();
        } else if w != abi.SL_ARG {
            args[k] = ir.czero(t);  // (a filler)
        }
    }
    for i in 0..p.args.len {
        let a = &mut p.args[i];
        let v = vs[i];
        if a.kind == abi.A_SCALAR {
            let mut x = v;
            if cty.is_half(a.ty) and not a.as_int {
                x = va_half_out(v);
            } else if a.as_int {
                // (its bits, in the low part of the integer register)
                if v.ty.size < 8 {
                    x = ir.zext(B, ir.bitcast(B, v, ir.t_int(@truncate(i32, v.ty.size * 8))), i64t());
                } else {
                    x = ir.bitcast(B, v, i64t());
                }
            }
            if a.slot[0] < 0 {
                va_store_scalar(vb, a, 0, x);
            } else {
                if cty.is_decimal(a.ty) {
                    x = va_fit(x, va_t_of(p, a.slot[0]));
                }
                args[@int_cast(usize, a.slot[0])] = x;
            }
        } else if a.kind == abi.A_REF {
            let c = alloca(a.ty, "arg");
            va_copy_bytes(c, v, cty.size_of(a.ty));
            if a.slot[0] < 0 {
                va_st(c, va_at(vb, a.va_off), cty.ptr_bytes);
            } else {
                args[@int_cast(usize, a.slot[0])] = c;
            }
        } else {
            let src = va_readable(a.ty, v, a.span);
            let al = cty.align_of(a.ty);
            for k in 0..a.n {
                let pc = a.pieces[k];
                let x = va_ld(pc.ty, va_at(src, pc.off), va_align_at(al, pc.off));
                if a.slot[k] < 0 {
                    va_store_scalar(vb, a, pc.off, x);
                } else {
                    args[@int_cast(usize, a.slot[k])] = x;
                }
            }
        }
    }
    // (x86-64 System V: an argument aligned to more than 16 bytes on the
    // stack needs the stack pointer aligned to that at the call, as the
    // offsets of the plan assume; the stack is moved down by the remainder
    // and back after the call)
    let mut sp0: ?*mut ir.Value = .none;
    if p.stack_align > 16 {
        let saved = ir.intr(B, ir.IN_STACK_SAVE, T_ptr, []);
        let pad = ir.and_(B, ir.ptrtoint(B, saved, T_isz), usz(p.stack_align - 1));
        let mut one: [1]*mut ir.Value = [pad];
        _ = ir.intr(B, ir.IN_STACK_ALLOC, T_ptr, one[..]);
        sp0 = .some(saved);
    }
    // (WebAssembly: the call's record on the shadow stack while it runs,
    // for stack traces; natively the frame table's chain)
    let mut ssf: [2]*mut ir.Value = [ir.vnil(), ir.vnil()];
    if u.notnil(next_site) and tg.is_wasm() {
        if not ss_tail and not lib_unit {
            ssf = ss_push(B, next_site);
        }
        next_site = ir.vnil();
    }
    let r = ir.call(B, fty, callee, args[0..nt]);
    if u.notnil(ssf[0]) {
        ss_pop(B, ssf[0], ssf[1]);
    }
    if u.notnil(next_site) {
        let ch = ir.chain1(next_site);
        ch.c_code = true;  // (tail calls may drop the frame at -O2: tailrec.ax)
        ir.set_chain(r, ch);
        next_site = ir.vnil();
    }
    let ex = ir.ext_of(r);
    ex[0] = abi.ret_ext(p);
    for k in 0..nt {
        if (k + 1) < ex.len {
            ex[k + 1] = p.exts.get(k);
        }
    }
    let out = va_call_result(p, r, res);
    if let .some(saved) = sp0 {
        let mut one: [1]*mut ir.Value = [saved];
        _ = ir.intr(B, ir.IN_STACK_RESTORE, T_void, one[..]);
    }
    return out;
}

// The C value of the result of call r (plan p; res: the result's memory, R_SRET).
fn va_call_result(p: *mut abi.Plan, r: *mut ir.Value, res: ?*mut ir.Value) *mut ir.Value {
    if p.ret == abi.R_SRET {
        let sret = res ?? ir.vnil();
        if cty.is_wint(p.rty) {
            wint_norm(p.rty, sret);  // (see enter_function)
        }
        return sret;
    }
    if p.ret == abi.R_X87 {
        // st(0) (and st(1)) popped into the result's memory (padding zero)
        let tmp = alloca(p.rty, "ret");
        let sz = cty.size_of(p.rty) / @as(u64, p.rn);
        for k in 0..p.rn {
            let piece = va_at(tmp, @as(u64, k) * sz);
            va_st(va_c64(0), va_at(piece, 8), 8);
            x87_pop(piece);
        }
        return tmp;
    }
    if (p.ret == abi.R_PIECE) or (p.ret == abi.R_REGS) {
        // the registers' pieces stored into an object (which scalar
        // replacement takes apart again when the result is used by field)
        let tmp = va_alloc_of(p.rty, p.rspan);
        let al = cty.align_of(p.rty);
        if p.ret == abi.R_PIECE {
            va_st(r, tmp, al);
            if cty.is_wint(p.rty) {
                wint_norm(p.rty, tmp);
            }
            return tmp;
        }
        for k in 0..p.rn {
            let pc = p.rpieces[k];
            let mut ka: [2]*mut ir.Value = [r, va_c32(@bit_cast(i64, @as(u64, k)))];
            let x = ir.intr(B, ir.IN_CALL_RESULT, pc.ty, ka[..]);
            va_st(x, va_at(tmp, pc.off), va_align_at(al, pc.off));
        }
        if cty.is_wint(p.rty) {
            wint_norm(p.rty, tmp);
        }
        return tmp;
    }
    if p.ret == abi.R_VOID {
        return ir.vnil();
    }
    if cty.is_decimal(p.rty) {
        return va_fit(r, lty(p.rty));  // (its bits: cgen_dec.ax)
    }
    if cty.is_half(p.rty) {
        return va_half_in(r);
    }
    // (a _BitInt result as a parameter: see enter_function)
    return bitint_norm(r, p.rty);
}

// The IR type of parameter k of plan p.
fn va_t_of(p: *abi.Plan, k: i32) *mut ir.Ty {
    return p.tys.get(@int_cast(usize, k));
}

// Scalar x as IR type t: bit-cast between an integer and a floating type of
// one size (a narrow decimal floating value, an integer in the IR, travels
// in a floating-point register: cgen_abi.ax).
fn va_fit(x: *mut ir.Value, t: *mut ir.Ty) *mut ir.Value {
    if (x.ty != t) and (x.ty.size == t.size) and ((x.ty.kind == ir.T_FLOAT) != (t.kind == ir.T_FLOAT)) {
        return ir.bitcast(B, x, t);
    }
    return x;
}

// A WebAssembly variadic argument (a scalar, or a structure's one piece; a
// binary128's piece at off) into the buffer, in a slot of at least 4 bytes.
fn va_store_scalar(vb: *mut ir.Value, a: *abi.ArgPlan, off: u64, x0: *mut ir.Value) void {
    let mut x = x0;
    if (x.ty.kind == ir.T_INT) and (x.ty.bits < 32) {
        if (a.kind == abi.A_SCALAR) and a.ty.is_signed and (a.ty.kind != cty.TK_BOOL) {
            x = ir.sext(B, x, T_i32);
        } else {
            x = ir.zext(B, x, T_i32);
        }
    }
    va_st(x, va_at(vb, a.va_off + off), x.ty.size);
}

// -----------------------------------------------------------------------------
// Functions: parameters and return
// -----------------------------------------------------------------------------

struct VaState {
    p: *mut abi.Plan,
    f: *mut ir.Func,
    on: bool,             // the function is variadic
    save: *mut ir.Value,  // the register save area (System V, AArch64)
    args: *mut ir.Value,  // the stack arguments' start (native targets)
    from: *mut ir.Value,  // a variadic nested function's: the address of its entry's va_list (cgen_nest.ax)
}

/// In a variadic nested function (after enter_function): its variable
/// arguments are those of the va_list at p, which va_start copies.
fn va_from(p: *mut ir.Value) void {
    VA.from = p;
}

/// va_start(*ap) in the function being generated (a variadic one, or an
/// entry of a variadic nested function: cgen_nest.ax).
fn va_start_ap(ap: *mut ir.Value) void {
    va_start(ap);
}

/// The start of function f (plan p), in its first block: the objects of
/// its parameters ps (each one's ir set), the result's address (the
/// returned value: R_SRET), and for a variadic function the registers its
/// variadic arguments may be in, saved.
fn enter_function(p: *mut abi.Plan, f: *mut ir.Func, ps: []*mut cast.CSym, variadic: bool) ?*mut ir.Value {
    VA = VaState.{ p: p, f: f, on: variadic, save: ir.vnil(), args: ir.vnil(), from: ir.vnil() };
    let mut res: ?*mut ir.Value = .none;
    for k in 0..p.what.len {
        if p.what.get(k) == abi.SL_RET {
            res = .some(f.params[k]);
        }
    }
    for i in 0..ps.len {
        let s = ps[i];
        let a = &mut p.args[i];
        if a.kind == abi.A_REF {
            // (the caller's copy: this function's own; but the ABIs align
            // it to 16 bytes at most (AAPCS64 B.4, Windows x64), so a type
            // aligned more strictly is copied into an object aligned as it is)
            let pr = f.params[@int_cast(usize, a.slot[0])];
            if cty.align_of(s.ty) > 16 {
                let o = alloca(s.ty, "arg");
                va_copy_bytes(o, pr, cty.size_of(s.ty));
                s.ir = @ptr_cast(*mut void, o);
                cdbg.note_var(f, s, o);
            } else {
                s.ir = @ptr_cast(*mut void, pr);
                // (its address in an object of its own: -O0 keeps it there, for debuggers)
                let o = alloca(cty.pointer_to(s.ty), "arg.addr");
                va_st(pr, o, 8);
                cdbg.note_indirect(f, s, o);
            }
            if cty.is_wint(s.ty) {
                wint_norm(s.ty, @ptr_cast(*mut ir.Value, s.ir));  // (the copy is the callee's)
            }
            continue;
        }
        let o = va_alloc_of(s.ty, a.span);
        s.ir = @ptr_cast(*mut void, o);
        cdbg.note_var(f, s, o);
        if a.kind == abi.A_SCALAR {
            // (a parameter of a definition with an identifier list arrives
            // promoted: cgen_stmt converts it)
            // (a _BitInt's bits beyond its width are unspecified in the
            // ABIs: the value is brought to this implementation's form)
            if cty.is_half(a.ty) {
                // (its bits: in the low 16 bits of the register, a floating
                // one's or, Windows ARM64's variadic, an integer one's)
                let mut x = f.params[@int_cast(usize, a.slot[0])];
                if a.as_int {
                    x = ir.trunc(B, x, ir.t_int(16));
                } else {
                    x = va_half_in(x);
                }
                if a.ty == cty.unqual(s.ty) {
                    va_st(x, o, 2);
                }
            } else if a.as_int {
                // (Windows ARM64: a floating-point parameter of a variadic
                // function arrives as its bits in an integer register)
                let ft = a.pieces[0].ty;
                let mut x = f.params[@int_cast(usize, a.slot[0])];
                if ft.size < 8 {
                    x = ir.trunc(B, x, ir.t_int(@truncate(i32, ft.size * 8)));
                }
                va_st(ir.bitcast(B, x, ft), o, cty.align_of(s.ty));
            } else if a.ty == cty.unqual(s.ty) {
                va_st(bitint_norm(f.params[@int_cast(usize, a.slot[0])], a.ty), o, cty.align_of(s.ty));
            }
            continue;
        }
        let al = cty.align_of(s.ty);
        for k in 0..a.n {
            let pc = a.pieces[k];
            va_st(f.params[@int_cast(usize, a.slot[k])], va_at(o, pc.off), va_align_at(al, pc.off));
        }
        if cty.is_wint(s.ty) {
            // (an integer wider than 64 bits: the bits beyond its width are
            // unspecified in the ABIs, as a _BitInt's narrower than its
            // storage are; brought to this implementation's form)
            wint_norm(s.ty, o);
        }
    }
    if variadic {
        va_save_registers(p, f);
    }
    return res;
}

fn va_frame_args() *mut ir.Value {
    let fa = ir.intr(B, ir.IN_FRAME_ADDR, T_ptr, []);
    return va_at(fa, 16);
}

fn va_save_registers(p: *mut abi.Plan, f: *mut ir.Func) void {
    let ab = p.abi;
    if ab == abi.ABI_WASM {
        return;
    }
    VA.args = va_frame_args();
    if ab == abi.ABI_WINA64 {
        // the home area the function reserves above its frame record
        // (a64.ax: ir.Func.va_home), below its stack arguments: the
        // positions after the named ones
        f.va_home = true;
        f.noinline = true;  // (its frame is what va_arg reads)
        for j in 0..p.pads_gp.len {
            let x = f.params[@int_cast(usize, p.pads_gp.get(j))];
            va_st(x, va_at(VA.args, (p.va_gp + @as(u64, j)) * 8), 8);
        }
        return;
    }
    if ab == abi.ABI_WIN {
        // the home area of the positions after the named ones
        for j in 0..p.pads_gp.len {
            let x = f.params[@int_cast(usize, p.pads_gp.get(j))];
            va_st(x, va_at(VA.args, (p.va_gp + @as(u64, j)) * 8), 8);
        }
        return;
    }
    if ab == abi.ABI_DARWIN {
        return;
    }
    let mut gsize: u64 = 48;
    if ab == abi.ABI_A64 {
        gsize = 64;
    }
    VA.save = va_buffer(gsize + 128, 16);
    for j in 0..p.pads_gp.len {
        let x = f.params[@int_cast(usize, p.pads_gp.get(j))];
        va_st(x, va_at(VA.save, (p.va_gp + @as(u64, j)) * 8), 8);
    }
    for j in 0..p.pads_fp.len {
        let x = f.params[@int_cast(usize, p.pads_fp.get(j))];
        va_st(x, va_at(VA.save, gsize + ((p.va_fp + @as(u64, j)) * 16)), 16);
    }
}

/// Returns value v (a scalar, or a structure's address; .none: none) of the
/// function with plan p, whose result's address is res.
fn ret_value(p: *mut abi.Plan, res: ?*mut ir.Value, ov: ?*mut ir.Value) void {
    if p.ret == abi.R_VOID {
        ir.ret_void(B);
        return;
    }
    let mut v = ir.vnil();
    if let .some(val) = ov {
        v = val;
    } else {
        ret_default(p, res);
        return;
    }
    if p.ret == abi.R_SCALAR {
        if cty.is_decimal(p.rty) {
            ir.ret(B, va_fit(v, p.rpieces[0].ty));
            return;
        }
        if cty.is_half(p.rty) {
            ir.ret(B, va_half_out(v));
            return;
        }
        ir.ret(B, v);
        return;
    }
    if p.ret == abi.R_X87 {
        va_x87_return(p, v);
        return;
    }
    let size = cty.size_of(p.rty);
    if p.ret == abi.R_PIECE {
        let src = va_readable(p.rty, v, p.rspan);
        ir.ret(B, va_ld(p.rpieces[0].ty, src, cty.align_of(p.rty)));
        return;
    }
    if p.ret == abi.R_REGS {
        // the pieces loaded from the object, into the registers
        // (ir.EXT_REGS)
        let src = va_readable(p.rty, v, p.rspan);
        let al = cty.align_of(p.rty);
        let mut xs: [4]*mut ir.Value = [ir.vnil(), ir.vnil(), ir.vnil(), ir.vnil()];
        for k in 0..p.rn {
            let pc = p.rpieces[k];
            xs[k] = va_ld(pc.ty, va_at(src, pc.off), va_align_at(al, pc.off));
        }
        va_ret_regs(p, xs[..]);
        return;
    }
    let sret = res ?? ir.vnil();
    va_copy_bytes(sret, v, size);
    if p.ret_ptr {
        ir.ret(B, sret);
        return;
    }
    ir.ret_void(B);
}

/// The return at the end of a function body (plan p) that has none: the
/// value is undefined (6.9.1p12), main's is 0 (it returns int).
fn ret_default(p: *mut abi.Plan, res: ?*mut ir.Value) void {
    if p.ret == abi.R_SCALAR {
        ir.ret(B, ir.czero(p.rpieces[0].ty));
    } else if p.ret == abi.R_X87 {
        // (the caller pops what it expects: zeros pushed)
        let z = alloca(p.rty, "ret");
        _ = ir.memop(B, ir.OP_MEMSET, z, ir.cint(ir.t_int(8), 0), usz(cty.size_of(p.rty)));
        va_x87_return(p, z);
    } else if p.ret == abi.R_PIECE {
        ir.ret(B, ir.undef(p.rpieces[0].ty));
    } else if p.ret == abi.R_REGS {
        let mut xs: [4]*mut ir.Value = [ir.vnil(), ir.vnil(), ir.vnil(), ir.vnil()];
        for k in 0..p.rn {
            xs[k] = ir.undef(p.rpieces[k].ty);
        }
        va_ret_regs(p, xs[..]);
    } else if (p.ret == abi.R_SRET) and p.ret_ptr {
        ir.ret(B, res ?? ir.vnil());
    } else {
        ir.ret_void(B);
    }
}

// A return of the value at v on the x87 stack: st(0) (and st(1), the second
// part: COMPLEX_X87), pushed last first.
fn va_x87_return(p: *abi.Plan, v: *mut ir.Value) void {
    let sz = cty.size_of(p.rty) / @as(u64, p.rn);
    let mut k = p.rn;
    while k > 0 {
        k -= 1;
        x87_push(va_at(v, @as(u64, k) * sz));
    }
    ir.ret_void(B);
}

// A return of the result in registers whose pieces are xs[0..p.rn].
fn va_ret_regs(p: *abi.Plan, xs: []mut *mut ir.Value) void {
    ir.ret_regs(B, xs[0..p.rn]);
}
