// =============================================================================
// csema_ice.ax - which constant expressions are integer constant
// expressions (6.6p6). Constant folding (cconst.ax) finds the value of any
// expression whose operands are constants; an integer constant expression
// (an array's length, a case label, an enumeration constant's value, a
// static assertion, a _BitInt width, a null pointer constant) is narrower:
// its operands are integer, enumeration and character constants (C23: also
// true and false), sizeof and _Alignof expressions, and floating constants
// only as the immediate operands of casts; its casts convert arithmetic
// types to integer types. (A sizeof or _Alignof operand is not looked into.)
// =============================================================================
import "../util.ax" as u;
import "cast.ax" as cast;
import "ctypes.ax" as cty;

/// Is typed, constant expression e an integer constant expression?
pub fn is_ice(e: *cast.Expr) bool {
    if not e.is_const or u.isnil(e.ty) or not cty.is_integer(e.ty) {
        return false;
    }
    return operands_ok(e);
}

// Are e's operands (e itself for a leaf) those of an integer constant expression?
fn operands_ok(e: *cast.Expr) bool {
    let k = e.kind;
    if (k == cast.ExprKind.INT) or (k == cast.ExprKind.CHAR) or (k == cast.ExprKind.BOOL) {
        return true;
    }
    if (k == cast.ExprKind.SIZEOF_EXPR) or (k == cast.ExprKind.SIZEOF_TYPE) or (k == cast.ExprKind.ALIGNOF) or
       (k == cast.ExprKind.OFFSETOF) {
        // (offsetof is an integer constant expression: 7.21p3)
        return e.is_const;
    }
    if k == cast.ExprKind.IDENT {
        // an enumeration constant (or a named constant whose value is known)
        return e.is_const;
    }
    // (a subexpression need not be constant itself: `0 && 1 / 0`)
    if u.isnil(e.ty) or not cty.is_integer(e.ty) {
        return false;
    }
    if k == cast.ExprKind.CAST {
        if e.op == cast.CV_LOAD {
            return e.is_const;  // (the value of a named constant)
        }
        if e.op != cast.CV_VALUE {
            return false;
        }
        let a = e.a;
        if u.notnil(e.tname) and (a.kind == cast.ExprKind.FLOAT) {
            return true;
        }
        return cty.is_integer(a.ty) and operands_ok(a);
    }
    if k == cast.ExprKind.UNARY {
        return operands_ok(e.a);
    }
    if k == cast.ExprKind.BINARY {
        return operands_ok(e.a) and operands_ok(e.b);
    }
    if k == cast.ExprKind.COND {
        return operands_ok(e.a) and (u.isnil(e.b) or operands_ok(e.b)) and operands_ok(e.c);
    }
    return false;
}
