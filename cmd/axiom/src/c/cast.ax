// =============================================================================
// cast.ax - the C syntax tree: a translation unit's declarations as written,
// with their declaration specifiers, declarators, statements, expressions,
// initializers and attributes. The parser (cparse.ax) builds it; semantic
// analysis annotates it in place (the `ty`, `sym` and constant fields), and
// IR generation walks it.
//
// Declarations are kept as the grammar has them: no types are built here.
// A declarator's derivations (pointer, array, function) are listed from the
// declared identifier outward, so `int *a[3]` has [array 3, pointer] ("a is
// an array of 3 pointers to int"); its type is made by applying them to the
// type the specifiers give, last first.
//
// Nodes are allocated in the compiler's arena (util.new), zeroed: a field a
// node's kind does not use is nil, empty or zero.
//
// A tree parsed without errors has no ERROR expressions; every Decl of kind
// DECL has specs with at least one item; a FUNC_DEF has one declarator
// whose first derivation is a FUNCTION, a COMPOUND body, and kr_decls only
// if that function has an identifier list; a declarator in a declaration
// or a member declaration has a name, except an unnamed bit-field (which
// has a width); a TypeName's declarator has none; every expression is at
// most MAX_DEPTH (cparse.ax) levels high, and so is the nesting of
// statements, declarators and initializers. After errors the tree is still
// complete enough to walk (no nil where the kind needs a node, but ERROR
// expressions and empty names where the source had none).
// =============================================================================
import "../asm/inline.ax" as ai;
import "../util.ax" as u;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;
import "std/c/rt/ldouble" as ld;

// -----------------------------------------------------------------------------
// Attributes (C23 6.7.13)
// -----------------------------------------------------------------------------

/// One attribute of an attribute specifier `[[...]]`: `name`, or
/// `prefix::name`, with its argument clause kept as the balanced tokens
/// between its parentheses. In a GNU dialect an attribute of
/// `__attribute__((...))`, and one written `[[gnu::name]]` or
/// `[[__gnu__::name]]`, has the prefix "gnu".
pub struct Attr {
    span: u.Span,
    prefix: []u8,  // the vendor prefix of `prefix::name`; empty if none
    name: []u8,
    has_args: bool,             // an argument clause, maybe empty: `name()`
    args: []ct.Token,           // its tokens, without the outer parentheses
    exprs: u.List.[*mut Expr],  // a GNU attribute whose arguments are expressions (aligned(8), ...): them, parsed
}

// -----------------------------------------------------------------------------
// Expressions (6.5)
// -----------------------------------------------------------------------------

/// What an Expr is.
pub enum ExprKind {
    ERROR,        // in place of an expression with a syntax error (reported)
    IDENT,        // name
    INT,          // tok: an integer constant (ival, base, unsigned_, longs, bitint)
    FLOAT,        // tok: a floating constant (fval, fsuffix, text)
    CHAR,         // tok: a character constant (ival, prefix)
    STRING,       // tok: a string literal, adjacent ones joined (units, prefix)
    BOOL,         // C23 `true` or `false`: bval
    NULLPTR,      // C23 `nullptr`
    UNARY,        // op a: & * + - ~ ! and prefix ++ -- (op P_INC, P_DEC)
    POSTFIX,      // a op: postfix ++ -- (op P_INC, P_DEC)
    BINARY,       // a op b: * / % + - << >> < > <= >= == != & ^ | && ||
    ASSIGN,       // a op b: = *= /= %= += -= <<= >>= &= ^= |=
    COND,         // a ? b : c; b nil: `a ?: c` (a GNU dialect: a is evaluated once, and is the value if nonzero)
    COMMA,        // a , b
    CALL,         // a(args)
    INDEX,        // a[b]
    MEMBER,       // a.name (op P_DOT) or a->name (op P_ARROW)
    CAST,         // (tname) a
    SIZEOF_EXPR,  // sizeof a
    SIZEOF_TYPE,  // sizeof (tname)
    ALIGNOF,      // _Alignof (tname), alignof (tname) in C23 (op: the keyword's spelling is in name)
    COMPOUND,     // (tname) { init }: a compound literal; tname.specs may hold storage-class specifiers (C23)
    GENERIC,      // _Generic(a, assocs)
    VA_ARG,       // __builtin_va_arg(a, tname): <stdarg.h>'s va_arg
    OFFSETOF,     // __builtin_offsetof(tname, args): <stddef.h>'s offsetof; args: the member designator, as
                  // MEMBER nodes (`.name`, the first one too) and INDEX nodes (`[b]`), without operands a
    // The GNU dialects':
    STMT_EXPR,     // ({ body }): a statement expression; its value is that of its last statement, an expression
    LABEL_ADDR,    // &&name: the address of a label (a `void *`)
    TYPES_COMPAT,  // __builtin_types_compatible_p(tname, tname2)
}

/// One association of a generic selection: `type-name: e`, or `default: e`
/// (tname nil).
pub struct GenericAssoc {
    span: u.Span,
    tname: *mut TypeName,
    e: *mut Expr,
}

pub struct Expr {
    // (the fields in an order that leaves no padding: a unit has many)
    kind: ExprKind,
    op: i32,  // UNARY, POSTFIX, BINARY, ASSIGN, MEMBER: the operator (a ctok P_ constant)
    span: u.Span,
    parens: i32,        // how many pairs of parentheses enclose it
    name_span: u.Span,  // MEMBER: the member's name
    height: i32,        // the levels of the tree it makes, itself included (at most cparse.MAX_DEPTH)
    a: *mut Expr,
    b: *mut Expr,
    c: *mut Expr,
    args: u.List.[*mut Expr],            // CALL: the arguments
    assocs: *mut u.List.[GenericAssoc],  // GENERIC (nil for the other kinds)
    name: []u8,                          // IDENT, MEMBER (interned); ALIGNOF: the keyword as written
    tname: *mut TypeName,                // CAST, SIZEOF_TYPE, ALIGNOF, COMPOUND, VA_ARG, OFFSETOF, TYPES_COMPAT;
                                         // ALIGNOF of an expression a (a GNU dialect's __alignof__): nil
    tname2: *mut TypeName,               // TYPES_COMPAT: the second type
    body: *mut Stmt,                     // STMT_EXPR: the compound statement
    init: *mut Init,                     // COMPOUND: a brace-enclosed list
    tok: *ct.Token,                      // INT, FLOAT, CHAR, STRING: (a copy of) the token
    // set by semantic analysis (csema.ax describes the typed tree)
    ty: *mut cty.CType,
    cval: u64,             // an integer constant's value, as bits (sign- or zero-extended from its type's width);
                           // MEMBER: the member's offset in the structure or union
    fcval: f64,            // a floating constant's value (a complex constant's real part; a wide long
                           // double's rounded to double)
    fcimag: f64,           // a complex constant's imaginary part
    xv: ld.W,              // a wide long double constant's value (cty.is_wide: cldbl.ax); a complex one's
                           // real part; an integer's wider than 64 bits: xv.hi indexes its value (cwide.ax)
    xvim: ld.W,            // a wide long double complex constant's imaginary part
    sym: *mut CSym,        // IDENT: what it names
    mem: *mut cty.Member,  // MEMBER: the member
    opty: *mut cty.CType,  // ASSIGN (compound), prefix and postfix ++ --: the type the operation is done in
    bval: bool,            // BOOL
    lvalue: bool,          // its value category: an lvalue (or a function designator)
    is_const: bool,        // an (integer or arithmetic) constant expression, whose value is cval or fcval
    ovf: bool,             // is_const, but a signed integer operation in its evaluation overflowed (6.6p4)
}

// -----------------------------------------------------------------------------
// Declaration specifiers and declarators (6.7)
// -----------------------------------------------------------------------------

// Storage-class specifiers (DeclSpec.storage).
pub const SC_TYPEDEF: i32 = 1;
pub const SC_EXTERN: i32 = 2;
pub const SC_STATIC: i32 = 4;
pub const SC_THREAD_LOCAL: i32 = 8;  // _Thread_local, thread_local
pub const SC_AUTO: i32 = 16;
pub const SC_REGISTER: i32 = 32;
pub const SC_CONSTEXPR: i32 = 64;  // C23

// Type qualifiers (DeclSpec.quals, Deriv.quals).
pub const Q_CONST: i32 = 1;
pub const Q_VOLATILE: i32 = 2;
pub const Q_RESTRICT: i32 = 4;
pub const Q_ATOMIC: i32 = 8;  // _Atomic as a qualifier (not followed by '(')

// Function specifiers (DeclSpec.funcs).
pub const FS_INLINE: i32 = 1;
pub const FS_NORETURN: i32 = 2;  // _Noreturn

/// What a Spec is.
pub enum SpecKind {
    STORAGE,       // kw: K_TYPEDEF, K_EXTERN, K_STATIC, K_THREAD_LOCAL, K_AUTO, K_REGISTER, K_CONSTEXPR
    TYPE,          // kw: a type keyword (K_VOID, K_CHAR, K_SHORT, K_INT, K_LONG, K_FLOAT, K_DOUBLE, K_SIGNED,
                   //     K_UNSIGNED, K_BOOL, K_COMPLEX, K_IMAGINARY, K_DECIMAL32/64/128, K_BUILTIN_VA_LIST, K_INT64)
    QUAL,          // kw: K_CONST, K_VOLATILE, K_RESTRICT, K_ATOMIC
    FUNC,          // kw: K_INLINE, K_NORETURN
    ALIGN,         // _Alignas / alignas: (tname) or (e)
    TAG,           // a struct, union or enum specifier: tag
    TYPEDEF_NAME,  // name
    TYPEOF,        // kw K_TYPEOF or K_TYPEOF_UNQUAL: (tname) or (e)
    BITINT,        // _BitInt(e)
    ATOMIC,        // _Atomic(tname), the type specifier
}

/// One declaration specifier, as written.
pub struct Spec {
    kind: SpecKind,
    kw: i32,  // the keyword (a ctok K_ constant)
    span: u.Span,
    name: []u8,            // TYPEDEF_NAME (interned)
    tag: *mut TagSpec,     // TAG
    tname: *mut TypeName,  // ALIGN, TYPEOF of a type name; ATOMIC
    e: *mut Expr,          // ALIGN, TYPEOF of an expression; BITINT: the width
}

/// The declaration specifiers of a declaration, a parameter, a member, or a
/// type name, in the order written (items, duplicates included), with
/// their kinds summed up.
pub struct DeclSpec {
    span: u.Span,
    items: u.List.[Spec],
    storage: i32,                // SC_ bits
    quals: i32,                  // Q_ bits
    funcs: i32,                  // FS_ bits
    has_type: bool,              // a type specifier is among the items (TYPE, TAG, TYPEDEF_NAME, TYPEOF, BITINT, ATOMIC)
    attrs: u.List.[*mut Attr],   // the attributes after the specifiers (C23): they appertain to the type
    gattrs: u.List.[*mut Attr],  // GNU attributes among the specifiers: they appertain to the declared entities
}

/// A struct, union or enum specifier.
pub struct TagSpec {
    kw: i32,  // K_STRUCT, K_UNION or K_ENUM
    span: u.Span,
    name: []u8,  // the tag (interned), or empty
    name_span: u.Span,
    attrs: u.List.[*mut Attr],              // after the keyword
    has_body: bool,                         // a member or enumerator list in braces
    members: u.List.[*mut Decl],            // struct, union: member declarations (DECL with member declarators; STATIC_ASSERT)
    enumerators: u.List.[*mut Enumerator],  // enum
    fixed: *mut TypeName,                   // enum: the fixed underlying type `enum E : T` (C23), or nil
    trailing_comma: bool,                   // enum: the list ends with ','
    pack: u64,                              // struct, union: `#pragma pack` at the end of its members (0: none)
    // set by semantic analysis
    ty: *mut cty.CType,
    sym: *mut CSym,
}

pub struct Enumerator {
    span: u.Span,
    name: []u8,
    attrs: u.List.[*mut Attr],
    value: *mut Expr,  // nil if none
    sym: *mut CSym,
}

/// What a Deriv is.
pub enum DerivKind {
    POINTER,   // * quals attrs
    ARRAY,     // [ static? quals size ] or [ quals * ]
    FUNCTION,  // ( params ) or ( identifier list )
}

/// One derivation of a declarator.
pub struct Deriv {
    kind: DerivKind,
    span: u.Span,
    quals: i32,                 // POINTER, ARRAY: Q_ bits
    dup_quals: bool,            // a qualifier was written more than once
    attrs: u.List.[*mut Attr],  // after '*', ']' or ')' (C23)
    // ARRAY
    size: *mut Expr,  // nil for `[]` and `[*]`
    is_static: bool,  // `[static n]`, `[const static n]`
    is_star: bool,    // `[*]`: a variable-length array of unspecified size
    // FUNCTION
    params: u.List.[*mut Param],  // a parameter type list: as written, so `(void)` has one parameter
    variadic: bool,               // ends with `...` (alone in C23: `(...)`)
    empty: bool,                  // written `()`: no prototype before C23, `(void)` from C23
    id_list: bool,                // an identifier list (K&R): ids
    ids: u.List.[Ident],
}

pub struct Ident {
    name: []u8,
    span: u.Span,
}

/// A declarator: a declared name with its derivations, its initializer or
/// bit-field width. An abstract declarator (in a type name or an unnamed
/// parameter) has an empty name.
pub struct Declarator {
    span: u.Span,
    name: []u8,  // interned; empty if abstract
    name_span: u.Span,
    attrs: u.List.[*mut Attr],  // after the identifier (C23): they appertain to the entity
    derivs: u.List.[Deriv],     // from the identifier outward
    init: *mut Init,            // `= initializer`, or nil
    width: *mut Expr,           // a member's bit-field width, or nil
    asm_name: []u8,             // a GNU dialect's `asm("name")` after the declarator: its symbol (empty: none)
    asm_span: u.Span,
    // set by semantic analysis
    ty: *mut cty.CType,
    sym: *mut CSym,
}

/// A parameter declaration.
pub struct Param {
    span: u.Span,
    attrs: u.List.[*mut Attr],  // before it (C23)
    specs: *mut DeclSpec,
    decl: *mut Declarator,  // maybe abstract
}

/// A type name: specifiers and an abstract declarator.
pub struct TypeName {
    span: u.Span,
    specs: *mut DeclSpec,
    decl: *mut Declarator,  // abstract (no name), maybe with no derivations
    ty: *mut cty.CType,     // set by semantic analysis
}

/// What a Decl is.
pub enum DeclKind {
    DECL,           // specs decls;  (a declaration; or a member declaration, in a TagSpec)
    FUNC_DEF,       // specs decls[0] kr_decls body: a function definition
    STATIC_ASSERT,  // _Static_assert(cond, msg) / static_assert(cond) in C23 (msg nil)
    ATTR,           // an attribute declaration `[[...]];` (C23): attrs
    LABELS,         // `__label__ a, b;` (a GNU dialect): local labels, in decls (their names)
    ASM,            // file-scope `asm("...");` (a GNU dialect): asm
}

/// A declaration, function definition, static assertion or attribute
/// declaration (at file scope, in a block, or as a struct member).
pub struct Decl {
    kind: DeclKind,
    span: u.Span,
    attrs: u.List.[*mut Attr],  // before it (C23): they appertain to each declared entity
    specs: *mut DeclSpec,
    decls: u.List.[*mut Declarator],  // the init-declarators or member declarators, maybe none
    // FUNC_DEF
    kr_decls: u.List.[*mut Decl],  // the declarations of a K&R definition's parameters
    body: *mut Stmt,               // a COMPOUND statement
    // STATIC_ASSERT
    cond: *mut Expr,
    msg: *mut Expr,  // a STRING, or nil
    // ASM
    asm: *mut Asm,
}

// -----------------------------------------------------------------------------
// Inline assembly (a GNU dialect)
// -----------------------------------------------------------------------------

/// One operand of an extended asm statement: `[name] "constraint" (e)`.
pub struct AsmOperand {
    span: u.Span,
    name: []u8,        // the symbolic name (interned), empty if none
    constraint: []u8,  // the constraint string, as written
    cspan: u.Span,     // the constraint's string literal
    e: *mut Expr,      // an lvalue (an output) or any expression (an input)
}

/// One name of an asm statement's clobber list, or a label of `asm goto`.
pub struct AsmName {
    span: u.Span,
    name: []u8,
    stmt: *mut Stmt,  // `asm goto`'s label: a GOTO statement to it (semantic analysis checks it as one)
}

/// An asm statement or file-scope asm: `asm qualifiers ("template" :
/// outputs : inputs : clobbers : labels)`. `basic` is the form with only
/// a template, whose `%` are not operand references.
pub struct Asm {
    span: u.Span,
    tmpl: []u8,  // the template's bytes
    tspan: u.Span,
    basic: bool,
    volatile_: bool,
    inline_: bool,
    goto_: bool,
    outputs: u.List.[*mut AsmOperand],
    inputs: u.List.[*mut AsmOperand],
    clobbers: u.List.[*mut AsmName],
    labels: u.List.[*mut AsmName],
    // set by semantic analysis
    blob: *mut ai.Blob,         // what it is (nil after an error)
    exprs: u.List.[*mut Expr],  // for each of the blob's operands: its value, or for memory or an output its lvalue
}

// -----------------------------------------------------------------------------
// Initializers (6.7.10)
// -----------------------------------------------------------------------------

pub enum InitKind {
    EXPR,  // e
    LIST,  // { items }: maybe empty (C23)
}

pub enum DesigKind {
    INDEX,   // [e]
    MEMBER,  // .name (in a GNU dialect also `name:` before the element)
    RANGE,   // [e ... e2] (a GNU dialect)
}

pub struct Designator {
    kind: DesigKind,
    span: u.Span,
    e: *mut Expr,
    name: []u8,
    e2: *mut Expr,  // RANGE: the last index
}

pub struct Init {
    kind: InitKind,
    span: u.Span,
    e: *mut Expr,
    items: u.List.[*mut Init],    // LIST
    desigs: u.List.[Designator],  // the designation before this element of its list (`.a[2] =`), maybe none
    trailing_comma: bool,         // LIST: ends with ','
}

// -----------------------------------------------------------------------------
// Statements (6.8)
// -----------------------------------------------------------------------------

pub enum StmtKind {
    COMPOUND,  // { items }: statements, DECL statements and labels
    DECL,      // decl (a declaration, static assertion or attribute declaration in a block)
    EXPR,      // e; or the null statement `;` (e nil)
    IF,        // if (e) body else els (els nil without one)
    SWITCH,    // switch (e) body
    WHILE,     // while (e) body
    DO,        // do body while (e);
    FOR,       // for (first or decl; e; step) body: any of first, decl, e, step may be nil
    GOTO,      // goto label; or (a GNU dialect) goto *e;
    CONTINUE,
    BREAK,
    RETURN,   // return e; (e nil without a value)
    LABEL,    // label: body (body nil for a label at the end of a block, C23)
    CASE,     // case e: body (body nil at the end of a block, C23); case e ... hi: (a GNU dialect)
    DEFAULT,  // default: body (likewise)
    ASM,      // an asm statement (a GNU dialect): asm
}

pub struct Stmt {
    kind: StmtKind,
    span: u.Span,
    attrs: u.List.[*mut Attr],  // before it (C23); for a label, those before the label
    e: *mut Expr,
    first: *mut Expr,  // FOR: the first clause, an expression
    step: *mut Expr,   // FOR: the third clause
    decl: *mut Decl,   // DECL; FOR: the first clause, a declaration
    body: *mut Stmt,
    els: *mut Stmt,
    items: u.List.[*mut Stmt],  // COMPOUND
    label: []u8,                // LABEL, GOTO (interned)
    label_span: u.Span,
    hi: *mut Expr,  // CASE: the last value of a case range, or nil
    // set by semantic analysis
    sym: *mut CSym,             // LABEL, GOTO: the label
    cases: u.List.[*mut Stmt],  // SWITCH: its CASE and DEFAULT statements, in order
    cval: u64,                  // CASE: the value, converted to the promoted type of the controlling expression
    cval_hi: u64,               // CASE of a range: its last value, likewise
    asm: *mut Asm,              // ASM
}

/// A translation unit: its external declarations, in order.
pub struct Unit {
    decls: u.List.[*mut Decl],
}

// -----------------------------------------------------------------------------
// Making nodes
// -----------------------------------------------------------------------------

/// A new expression of kind `k` at `sp` (one level high).
pub fn new_expr(k: ExprKind, sp: u.Span) *mut Expr {
    let e = u.new.[Expr]();
    e.kind = k;
    e.span = sp;
    e.height = 1;
    return e;
}

/// A new statement of kind `k` at `sp`.
pub fn new_stmt(k: StmtKind, sp: u.Span) *mut Stmt {
    let s = u.new.[Stmt]();
    s.kind = k;
    s.span = sp;
    return s;
}

/// A new declaration of kind `k` at `sp`.
pub fn new_decl(k: DeclKind, sp: u.Span) *mut Decl {
    let d = u.new.[Decl]();
    d.kind = k;
    d.span = sp;
    return d;
}

/// The usual spelling of a keyword (the C11 one for those C23 respells).
pub fn kw_text(kw: i32) []u8 {
    let names = ["?", "auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else", "enum",
                 "extern", "float", "for", "goto", "if", "int", "long", "register", "return", "short", "signed",
                 "sizeof", "static", "struct", "switch", "typedef", "union", "unsigned", "void", "volatile", "while",
                 "inline", "restrict", "_Bool", "_Complex", "_Imaginary", "_Alignas", "_Alignof", "_Atomic", "_Generic",
                 "_Noreturn", "_Static_assert", "_Thread_local", "constexpr", "false", "nullptr", "true", "typeof",
                 "typeof_unqual", "_BitInt", "_Decimal32", "_Decimal64", "_Decimal128", "__builtin_va_list",
                 "__axiom_int64", "__extension__", "__attribute__", "asm", "__auto_type", "__label__", "__int128",
                 "_Float128"];
    if (kw < 0) or (@int_cast(usize, kw) >= names.len) {
        return "?";
    }
    return names[@int_cast(usize, kw)];
}

/// The spelling of a punctuator (a ctok P_ constant).
pub fn punct_text(p: i32) []u8 {
    let names = ["?", "[", "]", "(", ")", "{", "}", ".", "->", "++", "--", "&", "*", "+", "-", "~", "!", "/", "%", "<<",
                 ">>", "<", ">", "<=", ">=", "==", "!=", "^", "|", "&&", "||", "?", ":", ";", "...", "=", "*=", "/=",
                 "%=", "+=", "-=", "<<=", ">>=", "&=", "^=", "|=", ",", "::"];
    if (p < 0) or (@int_cast(usize, p) >= names.len) {
        return "?";
    }
    return names[@int_cast(usize, p)];
}

// -----------------------------------------------------------------------------
// The typed tree's own records (set by semantic analysis: csema.ax)
// -----------------------------------------------------------------------------

// The conversion a CAST node makes (its op): an explicit cast has a type
// name (tname); semantic analysis inserts the implicit conversions as CAST
// nodes without one.
pub const CV_LOAD: i32 = 1;    // lvalue conversion (6.3.2.1p2): the value of a, an lvalue of a non-array object type
pub const CV_ADECAY: i32 = 2;  // a, of array type, to a pointer to its first element (6.3.2.1p3)
pub const CV_FDECAY: i32 = 3;  // a, a function designator, to a pointer to the function (6.3.2.1p4)
pub const CV_VALUE: i32 = 4;   // a's value (scalar) converted to ty (scalar, or void: evaluated and discarded)

// What a CSym is.
pub const SK_OBJECT: i32 = 1;
pub const SK_FUNC: i32 = 2;
pub const SK_TYPEDEF: i32 = 3;
pub const SK_ENUMCONST: i32 = 4;
pub const SK_LABEL: i32 = 5;

// What else a declaration of an object says (CSym.flags).
pub const CF_CONSTEXPR: i32 = 2;     // declared constexpr (C23): a named constant (6.6p7)
pub const CF_THREAD_LOCAL: i32 = 4;  // declared _Thread_local: an instance per thread (cgen_tls.ax)
pub const CF_ALIGNAS: i32 = 8;       // a declaration had an alignment specifier

// Linkage (6.2.2).
pub const LK_NONE: i32 = 0;
pub const LK_INTERNAL: i32 = 1;
pub const LK_EXTERNAL: i32 = 2;

// Storage duration of an object (6.2.4).
pub const SD_AUTO: i32 = 0;    // automatic (a block's object, a parameter)
pub const SD_STATIC: i32 = 1;  // static (file scope, or `static`/`extern` in a block)

/// What a declared name denotes. Every declaration of one entity with
/// linkage shares a CSym (its type is the composite of the declarations
/// seen so far).
pub struct CSym {
    kind: i32,  // SK_
    name: []u8,
    span: u.Span,  // the first declaration's name
    ty: *mut cty.CType,
    linkage: i32,                // LK_
    duration: i32,               // objects: SD_
    defined: bool,               // object: a definition (an initializer, or a tentative definition at the end); function: a body
    tentative: bool,             // file-scope object: a tentative definition was seen
    is_param: bool,              // a function's parameter
    used: bool,                  // referred to (functions: called or its address taken; labels: by a goto)
    init: *mut InitList,         // object with an initializer: its normal form
    def: *mut Decl,              // function: its definition (FUNC_DEF), once seen
    params: u.List.[*mut CSym],  // function definition: its parameters, in order (unnamed ones too)
    value: u64,                  // SK_ENUMCONST: the value (as cval)
    uid: i32,                    // a number unique in the program (for the symbol names of internal linkage)
    flags: i32,                  // objects: CF_ bits
    align: u64,                  // objects: the alignment an alignment specifier gives (_Alignas), or 0
    weak: bool,                  // a weak definition (an extension's): another unit's definition wins (cc.ax)
    ir: *mut void,               // IR generation's: the object's address, the function, the label's block
    asm_name: []u8,              // a GNU dialect's `asm("name")`: the symbol name (empty: its own)
    label_addr: bool,            // a label whose address is taken (`&&label`, a GNU dialect): value is its index
    owner: *mut CSym,            // such a label: its function
}

/// One element of an initializer's normal form: the subobject at `off`
/// bytes into the object, of type `ty`, gets the value of `e`.
pub struct InitItem {
    off: u64,
    ty: *mut cty.CType,     // a scalar type (e converted to it); a struct or union (e of that type: copied); or an
                            // array of characters (e a string literal, whose code units are copied, then zeros)
    e: *mut Expr,           // nil: the subobject (of any type) is zero
    bits: *mut cty.Member,  // a bit-field (off: its storage unit's offset; ty: its declared type), or nil
}

/// An object's initializer in normal form: its items, in the order they are
/// to be evaluated (6.7.9p23: indeterminately sequenced) and stored.
pub struct InitList {
    items: u.List.[InitItem],
    zero: bool,  // a brace-enclosed initializer: what no item covers is zero (6.7.9p21)
    size: u64,   // a GNU dialect's static object whose flexible array member is initialized: its size (0: its type's)
}
