// =============================================================================
// csema_expr.ax - the typing of C expressions (6.5): each operator's
// constraints and result type, value categories, the implicit conversions
// (inserted as CAST nodes: csema.ax describes the typed tree), null pointer
// constants, and assignment compatibility (6.5.16.1), which initialization,
// argument passing and return use too.
//
// check(e) types e where an lvalue may stand (it returns e, or the node
// that takes its place); rv(e) types e where its value is used: lvalue
// conversion, and arrays and function designators to pointers.
// =============================================================================
import "../util.ax" as u;
import "cast.ax" as cast;
import "cconst.ax" as cc;
import "copts.ax" as co;
import "csema.ax" as cs;
import "csema_bitint.ax" as csb;
import "csema_bits.ax" as cb;
import "csema_generic.ax" as csg;
import "csema_ice.ax" as csi;
import "csema_marks.ax" as csm;
import "csema_named.ax" as cn;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------

fn bad(e: *mut cast.Expr) *mut cast.Expr {
    e.ty = cty.t_error;
    e.lvalue = false;
    return e;
}

fn pick_ty(c: bool, a: *mut cty.CType, b: *mut cty.CType) *mut cty.CType {
    if c {
        return a;
    }
    return b;
}

fn is_err(e: *cast.Expr) bool {
    return u.isnil(e.ty) or (e.ty.kind == cty.TK_ERROR);
}

/// A new implicit conversion of `a` (op: cast.CV_) to type t.
pub fn conv(a: *mut cast.Expr, op: i32, t: *mut cty.CType) *mut cast.Expr {
    let c = cast.new_expr(cast.ExprKind.CAST, a.span);
    c.a = a;
    c.op = op;
    c.ty = t;
    c.height = a.height + 1;
    if op == cast.CV_VALUE {
        cc.fold(c);
    }
    return c;
}

/// Rvalue e converted to type t (nothing if it has that type already).
pub fn convert(e: *mut cast.Expr, t: *mut cty.CType) *mut cast.Expr {
    if is_err(e) or (t.kind == cty.TK_ERROR) {
        return e;
    }
    let tu = cty.unqual(t);
    if cty.unqual(e.ty) == tu {
        return e;
    }
    return conv(e, cast.CV_VALUE, tu);
}

/// The value of typed expression e (6.3.2.1): arrays and functions decay,
/// lvalues are converted to their values.
pub fn value_of(e: *mut cast.Expr) *mut cast.Expr {
    if is_err(e) {
        return e;
    }
    let t = e.ty;
    if t.kind == cty.TK_ARRAY {
        if not e.lvalue and (cs.std() < co.C99) {
            // (C89 3.2.2.1: only an lvalue array is converted to a pointer)
            cs.err(e.span, "C3020",
                   u.f1("an array that is not an lvalue (of type %s) is used as a pointer; that is C99", cs.tq(t)));
            return bad(e);
        }
        let reg = csm.register_object(e);
        if u.notnil(reg) {
            cs.err(e.span, "C3222", u.f1("the array '%s', declared register, is used as a pointer (its address)",
                                         reg.name));
            return bad(e);
        }
        return conv(e, cast.CV_ADECAY, cty.pointer_to(t.elem));
    }
    if t.kind == cty.TK_FUNCTION {
        return conv(e, cast.CV_FDECAY, cty.pointer_to(t));
    }
    if e.lvalue {
        if not cty.is_complete(t) and (t.kind != cty.TK_VOID) {
            cs.err(e.span, "C3007", u.f1("the value of an object of incomplete type %s is used", cs.tq(t)));
            return bad(e);
        }
        let c = conv(e, cast.CV_LOAD, cty.unqual(t));
        let bm = cb.member(e);
        if u.notnil(bm) {
            // (a bit-field's value is promoted by its width: 6.3.1.1p2)
            return convert(c, cb.promoted(bm));
        }
        cn.fold_load(c);
        return c;
    }
    return e;
}

/// Types e where its value is used.
pub fn rv(e: *mut cast.Expr) *mut cast.Expr {
    return value_of(check(e));
}

/// Types e as an expression whose value is not used (an expression
/// statement, the first operand of a comma, the clauses of for).
pub fn full_expr(e: *mut cast.Expr) *mut cast.Expr {
    return rv(e);
}

/// Types the controlling expression of if, while, do, for or ?: (scalar).
pub fn cond_expr(e: *mut cast.Expr, what: []u8) *mut cast.Expr {
    let x = rv(e);
    if not is_err(x) and not cty.is_scalar(x.ty) {
        cs.err(x.span, "C3030", u.f2("the controlling expression of %s has type %s, not a scalar type", what,
                                     cs.tq(x.ty)));
        return bad(x);
    }
    return x;
}

/// The result of ice: whether e is an integer constant expression, and its value.
pub struct Ice {
    ok: bool,
    v: u64,
    e: *mut cast.Expr,
}

/// Types e, which must be an integer constant expression (what: for the message).
pub fn ice(e: *mut cast.Expr, what: []u8) Ice {
    let x = rv(e);
    if is_err(x) {
        return Ice.{ ok: false, v: 0, e: x };
    }
    if not cty.is_integer(x.ty) {
        cs.err(x.span, "C3035", u.f2("%s must have integer type, not %s", what, cs.tq(x.ty)));
        return Ice.{ ok: false, v: 0, e: x };
    }
    if not x.is_const or not csi.is_ice(x) {
        cs.err(x.span, "C3035", u.cat2(what, " must be an integer constant expression"));
        return Ice.{ ok: false, v: 0, e: x };
    }
    return Ice.{ ok: true, v: x.cval, e: x };
}

/// Is e (typed, an rvalue) a null pointer constant (6.3.2.3p3)?
pub fn is_npc(e: *cast.Expr) bool {
    if is_err(e) {
        return false;
    }
    if cty.is_integer(e.ty) and e.is_const and (e.cval == 0) and csi.is_ice(e) {
        return true;
    }
    if e.kind == cast.ExprKind.NULLPTR {
        return true;
    }
    if (e.kind == cast.ExprKind.CAST) and u.notnil(e.tname) and (e.op == cast.CV_VALUE) and cty.is_void_ptr(e.ty) and
       (e.ty.elem.quals == 0) {
        return cty.is_integer(e.a.ty) and e.a.is_const and (e.a.cval == 0) and csi.is_ice(e.a);
    }
    return false;
}

fn has_const_member(t: *mut cty.CType) bool {
    if not cty.is_record(t) or not t.tag.complete {
        return false;
    }
    for m in t.unq.tag.members.items() {
        if ((m.ty.quals & cty.Q_CONST) != 0) or has_const_member(m.ty) {
            return true;
        }
        if (m.ty.kind == cty.TK_ARRAY) and (((m.ty.elem.quals & cty.Q_CONST) != 0) or has_const_member(m.ty.elem)) {
            return true;
        }
    }
    return false;
}

// Reports (C3021, C3026) unless e (typed) is a modifiable lvalue (6.3.2.1p1); `what` names the operation.
fn modifiable(e: *cast.Expr, what: []u8) bool {
    if is_err(e) {
        return false;
    }
    let t = e.ty;
    if not e.lvalue or (t.kind == cty.TK_FUNCTION) {
        cs.err(e.span, "C3021", u.f1("the operand of %s is not a modifiable lvalue", what));
        return false;
    }
    if t.kind == cty.TK_ARRAY {
        cs.err(e.span, "C3021", u.f2("the operand of %s is an array (of type %s)", what, cs.tq(t)));
        return false;
    }
    if (t.quals & cty.Q_CONST) != 0 {
        cs.err(e.span, "C3021", u.f2("the operand of %s has const-qualified type %s", what, cs.tq(t)));
        return false;
    }
    if has_const_member(t) {
        cs.err(e.span, "C3021", u.f2("the operand of %s has a const-qualified member (type %s)", what, cs.tq(t)));
        return false;
    }
    if not cty.is_complete(t) {
        cs.err(e.span, "C3007", u.f2("the operand of %s has incomplete type %s", what, cs.tq(t)));
        return false;
    }
    return true;
}

// A pointer to a complete object type (pointer arithmetic needs one).
fn object_pointer(t: *cty.CType) bool {
    return (t.kind == cty.TK_POINTER) and cty.is_complete(t.elem);
}

// The integer i converted to the pointer-sized type of its signedness, for
// pointer arithmetic.
fn index_operand(i: *mut cast.Expr) *mut cast.Expr {
    if cty.promote(i.ty).is_signed {
        return convert(i, cty.t_ptrdiff);
    }
    return convert(i, cty.t_size);
}

// -----------------------------------------------------------------------------
// Assignment compatibility (6.5.16.1)
// -----------------------------------------------------------------------------

/// Rvalue e converted to type t as if by assignment; `what` says where
/// ("assignment", "initialization", "argument 2 of 'f'", "return").
pub fn assign_convert(e: *mut cast.Expr, t: *mut cty.CType, what: []u8) *mut cast.Expr {
    if is_err(e) or cty.is_error(t) {
        return e;
    }
    let s = e.ty;
    if cty.is_arith(t) and cty.is_arith(s) {
        return convert(e, t);
    }
    if cty.is_record(t) {
        if cty.compatible_unq(t, s) {
            return e;
        }
    } else if cty.is_nullptr(t) {
        // (C23 6.5.17.2p1)
        if is_npc(e) or cty.is_nullptr(s) {
            return convert(e, t);
        }
    } else if t.kind == cty.TK_POINTER {
        if is_npc(e) or cty.is_nullptr(s) {
            return convert(e, t);
        }
        if s.kind == cty.TK_POINTER {
            let l = t.elem;
            let r = s.elem;
            let lobj = l.kind != cty.TK_FUNCTION;
            let robj = r.kind != cty.TK_FUNCTION;
            let ok = cty.compatible_unq(l, r) or ((l.kind == cty.TK_VOID) and robj) or
                     ((r.kind == cty.TK_VOID) and lobj);
            if not ok {
                cs.err(e.span, "C3022", u.f3("incompatible pointer types in %s: %s to %s", what, cs.tq(s), cs.tq(t)));
                return e;
            }
            if (r.quals & ~l.quals) != 0 {
                cs.err(e.span, "C3022", u.f3("%s discards qualifiers: %s to %s", what, cs.tq(s), cs.tq(t)));
                return e;
            }
            return convert(e, t);
        }
    } else if (t.kind == cty.TK_BOOL) and ((s.kind == cty.TK_POINTER) or cty.is_nullptr(s)) {
        return convert(e, t);
    }
    cs.err(e.span, "C3022", u.f3("incompatible types in %s: %s to %s", what, cs.tq(s), cs.tq(t)));
    return e;
}

// -----------------------------------------------------------------------------
// Constants
// -----------------------------------------------------------------------------

// The type of an integer constant (6.4.4.1p5): the first of the candidates
// for its suffix and base that holds its value.
fn int_const(e: *mut cast.Expr) *mut cast.Expr {
    let t = e.tok;
    if t.bitint {
        let bt = csb.const_type(t, e.span);
        if cty.is_error(bt) {
            return bad(e);
        }
        e.ty = bt;
        e.is_const = true;
        e.cval = cty.wrap(bt, t.ival);
        return e;
    }
    let dec = t.base == 10;
    let mut cands = u.List.[*mut cty.CType].empty();
    let ll = cs.std() >= co.C99;
    if not t.unsigned_ {
        if t.longs == 0 {
            cands.push(cty.t_int);
            if not dec {
                cands.push(cty.t_uint);
            }
        }
        if t.longs <= 1 {
            cands.push(cty.t_long);
            if not dec or not ll {
                cands.push(cty.t_ulong);
            }
        }
        if ll {
            cands.push(cty.t_llong);
            if not dec {
                cands.push(cty.t_ullong);
            }
        }
    } else {
        if t.longs == 0 {
            cands.push(cty.t_uint);
        }
        if t.longs <= 1 {
            cands.push(cty.t_ulong);
        }
        if ll {
            cands.push(cty.t_ullong);
        }
    }
    for c in cands.items() {
        if t.ival <= cty.int_max(c) {
            e.ty = c;
            e.is_const = true;
            e.cval = t.ival;
            return e;
        }
    }
    cs.err(e.span, "C3034", u.f1("the integer constant %s is too large for any integer type", t.text));
    return bad(e);
}

fn char_const(e: *mut cast.Expr) *mut cast.Expr {
    let t = e.tok;
    let mut ty = cty.t_int;
    if t.prefix == ct.ENC_WIDE {
        ty = cty.t_wchar;
    } else if t.prefix == ct.ENC_UTF16 {
        ty = cty.t_char16;
    } else if t.prefix == ct.ENC_UTF32 {
        ty = cty.t_char32;
    } else if t.prefix == ct.ENC_UTF8 {
        ty = cty.t_uchar;
    }
    e.ty = ty;
    e.is_const = true;
    e.cval = cty.wrap(ty, t.ival);
    return e;
}

/// The element type of a string literal with encoding prefix p.
pub fn string_elem(p: i32) *mut cty.CType {
    if p == ct.ENC_WIDE {
        return cty.t_wchar;
    }
    if p == ct.ENC_UTF16 {
        return cty.t_char16;
    }
    if p == ct.ENC_UTF32 {
        return cty.t_char32;
    }
    if (p == ct.ENC_UTF8) and (cs.std() >= co.C23) {
        return cty.t_uchar;  // char8_t
    }
    return cty.t_char;
}

// -----------------------------------------------------------------------------
// The kinds of expressions
// -----------------------------------------------------------------------------

/// Types e where an lvalue may stand; returns the node that stands for it.
pub fn check(e: *mut cast.Expr) *mut cast.Expr {
    if u.notnil(e.ty) {
        return e;  // (typed already)
    }
    let k = e.kind;
    if k == cast.ExprKind.ERROR {
        return bad(e);
    }
    if k == cast.ExprKind.IDENT {
        return ident(e);
    }
    if k == cast.ExprKind.INT {
        return int_const(e);
    }
    if k == cast.ExprKind.FLOAT {
        let ft = e.tok.fsuffix;
        if ft == 1 {
            e.ty = cty.t_float;
        } else if ft == 2 {
            e.ty = cty.t_ldouble;
        } else {
            e.ty = cty.t_double;
        }
        e.is_const = true;
        e.fcval = e.tok.fval;
        if ft == 1 {
            e.fcval = @as(f64, @float_cast(f32, e.tok.fval));
        }
        return e;
    }
    if k == cast.ExprKind.CHAR {
        return char_const(e);
    }
    if k == cast.ExprKind.STRING {
        let el = string_elem(e.tok.prefix);
        e.ty = cty.array_of(el, @as(u64, e.tok.units.len) + 1, true);
        e.lvalue = true;
        return e;
    }
    if k == cast.ExprKind.BOOL {
        e.ty = cty.t_bool;
        e.is_const = true;
        e.cval = 0;
        if e.bval {
            e.cval = 1;
        }
        return e;
    }
    if k == cast.ExprKind.NULLPTR {
        // (a null pointer constant, of type nullptr_t)
        e.ty = cty.t_nullptr;
        return e;
    }
    if k == cast.ExprKind.UNARY {
        return unary(e);
    }
    if k == cast.ExprKind.POSTFIX {
        return incdec(e);
    }
    if k == cast.ExprKind.BINARY {
        return binary(e);
    }
    if k == cast.ExprKind.ASSIGN {
        return assign(e);
    }
    if k == cast.ExprKind.COND {
        return conditional(e);
    }
    if k == cast.ExprKind.COMMA {
        e.a = full_expr(e.a);
        e.b = rv(e.b);
        e.ty = e.b.ty;
        return e;
    }
    if k == cast.ExprKind.CALL {
        return call(e);
    }
    if k == cast.ExprKind.INDEX {
        return index(e);
    }
    if k == cast.ExprKind.MEMBER {
        return member(e);
    }
    if k == cast.ExprKind.CAST {
        return explicit_cast(e);
    }
    if (k == cast.ExprKind.SIZEOF_EXPR) or (k == cast.ExprKind.SIZEOF_TYPE) or (k == cast.ExprKind.ALIGNOF) {
        return size_align(e);
    }
    if k == cast.ExprKind.COMPOUND {
        return cs.hooks.compound(e);
    }
    return csg.generic(e, check, rv);
}

fn ident(e: *mut cast.Expr) *mut cast.Expr {
    let s = cs.lookup(e.name);
    if u.isnil(s) {
        if u.str_eq(e.name, "__func__") and u.notnil(cs.cur_fn()) and (cs.std() >= co.C99) {
            return func_name(e);
        }
        cs.err(e.span, "C3001", u.f1("'%s' is not declared", e.name));
        return bad(e);
    }
    e.sym = s;
    s.used = true;
    csm.referred(s, e.span);
    if s.kind == cast.SK_ENUMCONST {
        e.ty = s.ty;
        e.is_const = true;
        e.cval = s.value;
        return e;
    }
    if s.kind == cast.SK_TYPEDEF {
        cs.err(e.span, "C3020", u.f1("'%s' is a type name, not a value", e.name));
        return bad(e);
    }
    e.ty = s.ty;
    e.lvalue = true;
    return e;
}

let mut g_func_names: u.SymMap.[*mut cast.CSym] = u.SymMap.[*mut cast.CSym].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut *mut cast.CSym, 0), cap: 0, len: 0 };

// __func__ (6.4.2.2): as if `static const char __func__[] = "name";` began
// the function's body.
fn func_name(e: *mut cast.Expr) *mut cast.Expr {
    let f = cs.cur_fn();
    let key = u.intern(u.idec(f.uid));
    let mut s = g_func_names.get(key);
    if u.isnil(s) {
        let n = f.name;
        let tok = u.new.[ct.Token]();
        tok.kind = ct.T_STRING;
        tok.text = n;
        let us = u.newn.[u32](n.len + 1);
        for i in 0..n.len {
            us[i] = @as(u32, n[i]);
        }
        tok.units = us[0..n.len];
        let str = cast.new_expr(cast.ExprKind.STRING, e.span);
        str.tok = tok;
        let t = cty.array_of(cty.qualify(cty.t_char, cty.Q_CONST), @as(u64, n.len) + 1, true);
        str.ty = cty.array_of(cty.t_char, @as(u64, n.len) + 1, true);
        str.lvalue = true;
        s = cs.new_sym(cast.SK_OBJECT, "__func__", e.span, t);
        s.duration = cast.SD_STATIC;
        s.defined = true;
        s.init = u.new.[cast.InitList]();
        s.init.items.push(cast.InitItem.{ off: 0, ty: t, e: str, bits: u.nil.[cty.Member]() });
        cs.add_object(s);
        g_func_names.put(key, s);
    }
    e.sym = s;
    s.used = true;
    e.ty = s.ty;
    e.lvalue = true;
    return e;
}

fn unary(e: *mut cast.Expr) *mut cast.Expr {
    let op = e.op;
    if (op == ct.P_INC) or (op == ct.P_DEC) {
        return incdec(e);
    }
    if op == ct.P_AMP {
        let a = check(e.a);
        e.a = a;
        if is_err(a) {
            return bad(e);
        }
        if (a.kind == cast.ExprKind.UNARY) and (a.op == ct.P_STAR) and cty.is_void(a.ty) and (cs.std() >= co.C99) {
            // &*E is E (6.5.3.2p3), also when *E is not an lvalue (E a pointer to void)
            e.ty = a.a.ty;
            return e;
        }
        if not a.lvalue {
            cs.err(a.span, "C3026", "the operand of '&' is not an lvalue");
            return bad(e);
        }
        if u.notnil(cb.member(a)) {
            cs.err(e.span, "C3070", u.f1("the address of the bit-field '%s' is taken", a.mem.name));
            return bad(e);
        }
        let reg = csm.register_object(a);
        if u.notnil(reg) {
            cs.err(a.span, "C3222", u.f1("the address of '%s', declared register, is taken", reg.name));
            return bad(e);
        }
        e.ty = cty.pointer_to(a.ty);
        return e;
    }
    if op == ct.P_STAR {
        let a = rv(e.a);
        e.a = a;
        if is_err(a) {
            return bad(e);
        }
        if a.ty.kind != cty.TK_POINTER {
            cs.err(e.span, "C3020", u.f1("the operand of unary '*' has type %s, not a pointer type", cs.tq(a.ty)));
            return bad(e);
        }
        e.ty = a.ty.elem;
        e.lvalue = a.ty.elem.kind != cty.TK_VOID;
        return e;
    }
    let a = rv(e.a);
    e.a = a;
    if is_err(a) {
        return bad(e);
    }
    let t = a.ty;
    if op == ct.P_BANG {
        if not cty.is_scalar(t) {
            cs.err(e.span, "C3020", u.f1("the operand of '!' has type %s, not a scalar type", cs.tq(t)));
            return bad(e);
        }
        e.ty = cty.t_int;
        cc.fold(e);
        return e;
    }
    if (op == ct.P_TILDE) and not cty.is_integer(t) {
        cs.err(e.span, "C3020", u.f1("the operand of '~' has type %s, not an integer type", cs.tq(t)));
        return bad(e);
    }
    if (op != ct.P_TILDE) and not cty.is_arith(t) {
        cs.err(e.span, "C3020", u.f2("the operand of unary '%s' has type %s, not an arithmetic type",
                                     cast.punct_text(op), cs.tq(t)));
        return bad(e);
    }
    e.a = convert(a, cty.promote(t));
    e.ty = e.a.ty;
    cc.fold(e);
    return e;
}

// ++ and -- (prefix: UNARY, postfix: POSTFIX).
fn incdec(e: *mut cast.Expr) *mut cast.Expr {
    let a = check(e.a);
    e.a = a;
    let what = u.pick(e.op == ct.P_INC, "'++'", "'--'");
    if is_err(a) or not modifiable(a, what) {
        return bad(e);
    }
    let t = a.ty;
    if cty.is_arith(t) {
        e.opty = cb.promote_lvalue(a);
    } else if object_pointer(t) {
        e.opty = cty.unqual(t);
    } else {
        cs.err(e.span, "C3020", u.f2("the operand of %s has type %s, not a real or object pointer type", what,
                                     cs.tq(t)));
        return bad(e);
    }
    e.ty = cty.unqual(t);
    return e;
}

fn binary(e: *mut cast.Expr) *mut cast.Expr {
    let op = e.op;
    let a = rv(e.a);
    let b = rv(e.b);
    e.a = a;
    e.b = b;
    if is_err(a) or is_err(b) {
        return bad(e);
    }
    let ta = a.ty;
    let tb = b.ty;
    if (op == ct.P_ANDAND) or (op == ct.P_OROR) {
        if not cty.is_scalar(ta) or not cty.is_scalar(tb) {
            return bad_operands(e);
        }
        e.ty = cty.t_int;
        cc.fold(e);
        return e;
    }
    if (op == ct.P_STAR) or (op == ct.P_SLASH) {
        if not cty.is_arith(ta) or not cty.is_arith(tb) {
            return bad_operands(e);
        }
        return arith(e);
    }
    if (op == ct.P_PERCENT) or (op == ct.P_AMP) or (op == ct.P_PIPE) or (op == ct.P_CARET) {
        if not cty.is_integer(ta) or not cty.is_integer(tb) {
            return bad_operands(e);
        }
        return arith(e);
    }
    if (op == ct.P_SHL) or (op == ct.P_SHR) {
        if not cty.is_integer(ta) or not cty.is_integer(tb) {
            return bad_operands(e);
        }
        e.a = convert(a, cty.promote(ta));
        e.b = convert(b, cty.promote(tb));
        e.ty = e.a.ty;
        cc.fold(e);
        return e;
    }
    if op == ct.P_PLUS {
        if cty.is_arith(ta) and cty.is_arith(tb) {
            return arith(e);
        }
        if cty.is_integer(ta) and (tb.kind == cty.TK_POINTER) {
            e.a = b;
            e.b = a;
            return ptr_offset(e);
        }
        if (ta.kind == cty.TK_POINTER) and cty.is_integer(tb) {
            return ptr_offset(e);
        }
        return bad_operands(e);
    }
    if op == ct.P_MINUS {
        if cty.is_arith(ta) and cty.is_arith(tb) {
            return arith(e);
        }
        if (ta.kind == cty.TK_POINTER) and cty.is_integer(tb) {
            return ptr_offset(e);
        }
        if (ta.kind == cty.TK_POINTER) and (tb.kind == cty.TK_POINTER) {
            if not cty.compatible_unq(ta.elem, tb.elem) {
                cs.err(e.span, "C3020", u.f2("subtraction of pointers to incompatible types (%s and %s)", cs.tq(ta),
                                             cs.tq(tb)));
                return bad(e);
            }
            if not object_pointer(ta) {
                cs.err(e.span, "C3007", u.f1("subtraction of pointers to an incomplete type (%s)", cs.tq(ta)));
                return bad(e);
            }
            e.ty = cty.t_ptrdiff;
            return e;
        }
        return bad_operands(e);
    }
    if cc.is_compare(op) {
        return compare(e);
    }
    return bad_operands(e);
}

fn bad_operands(e: *mut cast.Expr) *mut cast.Expr {
    cs.err(e.span, "C3020", u.f3("invalid operands to binary '%s' (%s and %s)", cast.punct_text(e.op), cs.tq(e.a.ty),
                                 cs.tq(e.b.ty)));
    return bad(e);
}

// The usual arithmetic conversions, the result in the common type.
fn arith(e: *mut cast.Expr) *mut cast.Expr {
    let t = cty.common_type(e.a.ty, e.b.ty);
    e.a = convert(e.a, t);
    e.b = convert(e.b, t);
    e.ty = t;
    cc.fold(e);
    return e;
}

// pointer a +/- integer b.
fn ptr_offset(e: *mut cast.Expr) *mut cast.Expr {
    if not object_pointer(e.a.ty) {
        cs.err(e.span, "C3020", u.f1("arithmetic on a pointer to an incomplete or function type (%s)", cs.tq(e.a.ty)));
        return bad(e);
    }
    e.b = index_operand(e.b);
    e.ty = e.a.ty;
    return e;
}

fn compare(e: *mut cast.Expr) *mut cast.Expr {
    let op = e.op;
    let ta = e.a.ty;
    let tb = e.b.ty;
    e.ty = cty.t_int;
    if cty.is_arith(ta) and cty.is_arith(tb) {
        let t = cty.common_type(ta, tb);
        e.a = convert(e.a, t);
        e.b = convert(e.b, t);
        cc.fold(e);
        return e;
    }
    let eq = (op == ct.P_EQ) or (op == ct.P_NE);
    if eq and (cty.is_nullptr(ta) or cty.is_nullptr(tb)) {
        // (C23 6.5.10p2: two nullptr_t values, or one and a pointer or a null pointer constant)
        if cty.is_nullptr(ta) and cty.is_nullptr(tb) {
            return e;
        }
        if cty.is_nullptr(ta) and ((tb.kind == cty.TK_POINTER) or is_npc(e.b)) {
            e.a = convert(e.a, pick_ty(tb.kind == cty.TK_POINTER, tb, ta));
            e.b = convert(e.b, e.a.ty);
            return e;
        }
        if cty.is_nullptr(tb) and ((ta.kind == cty.TK_POINTER) or is_npc(e.a)) {
            e.b = convert(e.b, pick_ty(ta.kind == cty.TK_POINTER, ta, tb));
            e.a = convert(e.a, e.b.ty);
            return e;
        }
        return bad_operands(e);
    }
    if (ta.kind == cty.TK_POINTER) and (tb.kind == cty.TK_POINTER) {
        // (6.5.8p2, 6.5.9p2: relational operators take pointers to object
        // types; == and != also a pointer to void with one to an object
        // type, or a null pointer constant)
        let ok = (cty.compatible_unq(ta.elem, tb.elem) and (eq or not cty.is_func(ta.elem))) or
                 (eq and
                  ((cty.is_void(ta.elem) and not cty.is_func(tb.elem)) or
                   (cty.is_void(tb.elem) and not cty.is_func(ta.elem)) or is_npc(e.a) or is_npc(e.b)));
        if not ok {
            cs.err(e.span, "C3020", u.f3("comparison with '%s' of pointers to incompatible types (%s and %s)",
                                         cast.punct_text(op), cs.tq(ta), cs.tq(tb)));
            return bad(e);
        }
        return e;
    }
    if eq and (ta.kind == cty.TK_POINTER) and is_npc(e.b) {
        e.b = convert(e.b, ta);
        return e;
    }
    if eq and (tb.kind == cty.TK_POINTER) and is_npc(e.a) {
        e.a = convert(e.a, tb);
        return e;
    }
    return bad_operands(e);
}

fn assign(e: *mut cast.Expr) *mut cast.Expr {
    let op = e.op;
    let a = check(e.a);
    e.a = a;
    let b = rv(e.b);
    e.b = b;
    if is_err(a) or is_err(b) {
        return bad(e);
    }
    let what = u.f1("'%s'", cast.punct_text(op));
    if not modifiable(a, what) {
        return bad(e);
    }
    let lt = cty.unqual(a.ty);
    e.ty = lt;
    if op == ct.P_ASSIGN {
        e.b = assign_convert(b, lt, "assignment");
        return e;
    }
    let tb = b.ty;
    if (op == ct.P_ADD_EQ) or (op == ct.P_SUB_EQ) {
        if object_pointer(lt) and cty.is_integer(tb) {
            e.opty = lt;
            e.b = index_operand(b);
            return e;
        }
        if cty.is_arith(lt) and cty.is_arith(tb) {
            return compound_arith(e);
        }
    } else if (op == ct.P_MUL_EQ) or (op == ct.P_DIV_EQ) {
        if cty.is_arith(lt) and cty.is_arith(tb) {
            return compound_arith(e);
        }
    } else if (op == ct.P_SHL_EQ) or (op == ct.P_SHR_EQ) {
        if cty.is_integer(lt) and cty.is_integer(tb) {
            e.opty = cb.promote_lvalue(a);
            e.b = convert(b, cty.promote(tb));
            return e;
        }
    } else if cty.is_integer(lt) and cty.is_integer(tb) {
        return compound_arith(e);
    }
    cs.err(e.span, "C3020", u.f3("invalid operands to '%s' (%s and %s)", cast.punct_text(op), cs.tq(a.ty), cs.tq(tb)));
    return bad(e);
}

fn compound_arith(e: *mut cast.Expr) *mut cast.Expr {
    let t = cty.common_type(cb.promote_lvalue(e.a), e.b.ty);
    e.opty = t;
    e.b = convert(e.b, t);
    return e;
}

fn conditional(e: *mut cast.Expr) *mut cast.Expr {
    e.a = cond_expr(e.a, "'?:'");
    let b = rv(e.b);
    let c = rv(e.c);
    e.b = b;
    e.c = c;
    if is_err(e.a) or is_err(b) or is_err(c) {
        return bad(e);
    }
    let tb = b.ty;
    let tc = c.ty;
    if cty.is_arith(tb) and cty.is_arith(tc) {
        let t = cty.common_type(tb, tc);
        e.b = convert(b, t);
        e.c = convert(c, t);
        e.ty = t;
        cc.fold(e);
        return e;
    }
    if cty.is_record(tb) and cty.compatible_unq(tb, tc) {
        e.ty = cty.unqual(tb);
        return e;
    }
    if cty.is_void(tb) and cty.is_void(tc) {
        e.ty = cty.t_void;
        return e;
    }
    // (C23 6.5.16p3: two nullptr_t operands, or one and a pointer)
    if cty.is_nullptr(tb) and cty.is_nullptr(tc) {
        e.ty = cty.t_nullptr;
        return e;
    }
    if cty.is_nullptr(tb) and (tc.kind == cty.TK_POINTER) {
        e.ty = tc;
        e.b = convert(b, tc);
        return e;
    }
    if cty.is_nullptr(tc) and (tb.kind == cty.TK_POINTER) {
        e.ty = tb;
        e.c = convert(c, tb);
        return e;
    }
    if (tb.kind == cty.TK_POINTER) and (tc.kind == cty.TK_POINTER) {
        let q = tb.elem.quals | tc.elem.quals;
        if cty.compatible_unq(tb.elem, tc.elem) {
            e.ty = cty.pointer_to(cty.qualify(cty.composite(cty.unqual(tb.elem), cty.unqual(tc.elem)), q));
        } else if is_npc(c) {
            e.ty = tb;
        } else if is_npc(b) {
            e.ty = tc;
        } else if (cty.is_void(tb.elem) and not cty.is_func(tc.elem)) or
                  (cty.is_void(tc.elem) and not cty.is_func(tb.elem)) {
            e.ty = cty.pointer_to(cty.qualify(cty.t_void, q));
        } else {
            cs.err(e.span, "C3020", u.f2("the operands of '?:' are pointers to incompatible types (%s and %s)",
                                         cs.tq(tb), cs.tq(tc)));
            return bad(e);
        }
        e.b = convert(b, e.ty);
        e.c = convert(c, e.ty);
        return e;
    }
    if (tb.kind == cty.TK_POINTER) and is_npc(c) {
        e.ty = tb;
        e.c = convert(c, tb);
        return e;
    }
    if (tc.kind == cty.TK_POINTER) and is_npc(b) {
        e.ty = tc;
        e.b = convert(b, tc);
        return e;
    }
    cs.err(e.span, "C3020", u.f2("the operands of '?:' have incompatible types (%s and %s)", cs.tq(tb), cs.tq(tc)));
    return bad(e);
}

// The compiler's own functions the headers use (builtin): a call of one, or false.
fn builtin_call(e: *mut cast.Expr) bool {
    let f = e.a;
    if (f.kind != cast.ExprKind.IDENT) or not u.starts(f.name, "__builtin_") or u.notnil(cs.lookup(f.name)) {
        return false;
    }
    let n = f.name;
    if u.str_eq(n, "__builtin_inff") or u.str_eq(n, "__builtin_nanf") {
        // INFINITY and NAN (<float.h>): float constants
        for x in e.args.items() {
            _ = rv(x);
        }
        e.ty = cty.t_float;
        e.is_const = true;
        let z: f64 = 0.0;
        if u.str_eq(n, "__builtin_inff") {
            e.fcval = 1.0 / z;
        } else {
            e.fcval = z / z;
        }
        return true;
    }
    if u.starts(n, "__builtin_va_") {
        cs.unsupported(e.span, "access to variable arguments (va_start, va_arg, va_end, va_copy)");
    } else {
        cs.unsupported(e.span, u.f1("the builtin '%s'", n));
    }
    _ = bad(e);
    return true;
}

fn call(e: *mut cast.Expr) *mut cast.Expr {
    if builtin_call(e) {
        return e;
    }
    let f0 = e.a;
    if (f0.kind == cast.ExprKind.IDENT) and (f0.parens == 0) and u.isnil(cs.lookup(f0.name)) {
        if cs.std() >= co.C99 {
            cs.err(f0.span, "C3060", u.f1("'%s' is not declared (a function must be declared before it is called)",
                                          f0.name));
            for x in e.args.items() {
                _ = rv(x);
            }
            return bad(e);
        }
        // C89, C95: an implicit declaration `extern int f();` (6.5.2.2 of C89)
        cs.warn(f0.span, "C4001", u.f1("implicit declaration of function '%s'", f0.name));
        cs.implicit_function(f0.name, f0.span);
    }
    let f = rv(e.a);
    e.a = f;
    let n = e.args.len;
    for i in 0..n {
        e.args.set(i, rv(e.args.get(i)));
    }
    if is_err(f) {
        return bad(e);
    }
    if (f.ty.kind != cty.TK_POINTER) or (f.ty.elem.kind != cty.TK_FUNCTION) {
        cs.err(f.span, "C3024", u.f1("the called object has type %s, not a function or function pointer", cs.tq(f.ty)));
        return bad(e);
    }
    let ft = f.ty.elem;
    let mut name: []u8 = "the function";
    if (f.kind == cast.ExprKind.CAST) and (f.a.kind == cast.ExprKind.IDENT) {
        name = u.f1("'%s'", f.a.name);
    }
    if ft.proto {
        let np = ft.params.len;
        if (n < np) or ((n > np) and not ft.variadic) {
            cs.err(e.span, "C3023", u.f4("%s takes %s%s arguments, not %s", name, u.pick(ft.variadic, "at least ", ""),
                                         u.zdec(np), u.zdec(n)));
            return bad(e);
        }
        for i in 0..n {
            let a = e.args.get(i);
            if i < np {
                e.args.set(i, assign_convert(a, ft.params[i], u.f2("argument %s of %s", u.zdec(i + 1), name)));
            } else {
                e.args.set(i, promote_arg(a));
            }
        }
    } else {
        for i in 0..n {
            e.args.set(i, promote_arg(e.args.get(i)));
        }
    }
    let rt = ft.ret;
    if not cty.is_void(rt) and not cty.is_complete(rt) {
        cs.err(e.span, "C3007", u.f1("the call's result has incomplete type %s", cs.tq(rt)));
        return bad(e);
    }
    e.ty = cty.unqual(rt);
    return e;
}

// An argument without a parameter: the default argument promotions.
fn promote_arg(a: *mut cast.Expr) *mut cast.Expr {
    if is_err(a) {
        return a;
    }
    if cty.is_void(a.ty) {
        cs.err(a.span, "C3030", "a void value is passed as an argument");
        return bad(a);
    }
    if cty.is_arith(a.ty) {
        return convert(a, cty.arg_promote(a.ty));
    }
    return a;
}

fn index(e: *mut cast.Expr) *mut cast.Expr {
    let mut a = rv(e.a);
    let mut b = rv(e.b);
    if is_err(a) or is_err(b) {
        e.a = a;
        e.b = b;
        return bad(e);
    }
    if cty.is_integer(a.ty) and (b.ty.kind == cty.TK_POINTER) {
        let x = a;
        a = b;
        b = x;
    }
    e.a = a;
    e.b = b;
    if (a.ty.kind != cty.TK_POINTER) or not cty.is_integer(b.ty) {
        cs.err(e.span, "C3020", u.f2("subscript of %s by %s (an array or pointer and an integer are needed)",
                                     cs.tq(a.ty), cs.tq(b.ty)));
        return bad(e);
    }
    if not object_pointer(a.ty) {
        cs.err(e.span, "C3007", u.f1("subscript of a pointer to an incomplete or function type (%s)", cs.tq(a.ty)));
        return bad(e);
    }
    e.b = index_operand(b);
    e.ty = a.ty.elem;
    e.lvalue = true;
    return e;
}

fn member(e: *mut cast.Expr) *mut cast.Expr {
    let arrow = e.op == ct.P_ARROW;
    let mut base = u.nil.[cast.Expr]();
    let mut st = cty.t_error;
    if arrow {
        base = rv(e.a);
        e.a = base;
        if is_err(base) {
            return bad(e);
        }
        if (base.ty.kind != cty.TK_POINTER) or not cty.is_record(base.ty.elem) {
            cs.err(e.span, "C3025", u.f2("'->%s' on %s, not a pointer to a structure or union", e.name,
                                         cs.tq(base.ty)));
            return bad(e);
        }
        st = base.ty.elem;
    } else {
        base = check(e.a);
        e.a = base;
        if is_err(base) {
            return bad(e);
        }
        if not cty.is_record(base.ty) {
            cs.err(e.span, "C3025", u.f2("'.%s' on %s, not a structure or union", e.name, cs.tq(base.ty)));
            return bad(e);
        }
        st = base.ty;
    }
    if not cty.is_complete(st) {
        cs.err(e.span, "C3007", u.f2("'%s' in %s, an incomplete type", e.name, cs.tq(st)));
        return bad(e);
    }
    let fm = cty.find_member(st, e.name);
    if u.isnil(fm.m) {
        cs.err(e.name_span, "C3025", u.f2("%s has no member named '%s'", cs.tq(st), e.name));
        return bad(e);
    }
    e.mem = fm.m;
    e.cval = fm.offset;
    e.ty = cty.qualify(fm.m.ty, st.quals);
    e.lvalue = arrow or base.lvalue;
    return e;
}

fn explicit_cast(e: *mut cast.Expr) *mut cast.Expr {
    let t = cs.hooks.type_name(e.tname);
    let a = rv(e.a);
    e.a = a;
    if is_err(a) or cty.is_error(t) {
        return bad(e);
    }
    e.op = cast.CV_VALUE;
    e.ty = cty.unqual(t);
    if cty.is_void(t) {
        return e;
    }
    let s = a.ty;
    if cty.is_nullptr(s) or cty.is_nullptr(t) {
        // (C23 6.5.5p4: nullptr_t only to void, bool, a pointer type or itself; nothing else to nullptr_t)
        let mut ok = (t.kind == cty.TK_BOOL) or (t.kind == cty.TK_POINTER);
        if cty.is_nullptr(t) {
            ok = cty.is_nullptr(s);
        }
        if not ok {
            let why = "nullptr_t converts only to void, bool and pointer types, and only nullptr_t to it";
            cs.err(e.span, "C3028", u.f3("a cast from %s to %s (%s)", cs.tq(s), cs.tq(t), why));
            return bad(e);
        }
        cc.fold(e);
        return e;
    }
    if not cty.is_scalar(t) or not cty.is_scalar(s) {
        cs.err(e.span, "C3028", u.f2("a cast from %s to %s (casts are between scalar types, or to void)", cs.tq(s),
                                     cs.tq(t)));
        return bad(e);
    }
    if ((t.kind == cty.TK_POINTER) and cty.is_floating(s)) or ((s.kind == cty.TK_POINTER) and cty.is_floating(t)) {
        cs.err(e.span, "C3028", u.f2("a cast between a pointer and a floating type (%s to %s)", cs.tq(s), cs.tq(t)));
        return bad(e);
    }
    cc.fold(e);
    return e;
}

fn size_align(e: *mut cast.Expr) *mut cast.Expr {
    let mut t = cty.t_error;
    let k = e.kind;
    let what = u.pick(k == cast.ExprKind.ALIGNOF, u.cat2("'", u.cat2(e.name, "'")), "'sizeof'");
    if k == cast.ExprKind.SIZEOF_EXPR {
        let a = check(e.a);
        e.a = a;
        if is_err(a) {
            return bad(e);
        }
        if u.notnil(cb.member(a)) {
            cs.err(e.span, "C3070", u.f1("'sizeof' of the bit-field '%s'", a.mem.name));
            return bad(e);
        }
        t = a.ty;
    } else {
        t = cs.hooks.type_name(e.tname);
        if cty.is_error(t) {
            return bad(e);
        }
    }
    if cty.is_func(t) {
        cs.err(e.span, "C3029", u.f2("the operand of %s has function type %s", what, cs.tq(t)));
        return bad(e);
    }
    let alignof_ = k == cast.ExprKind.ALIGNOF;
    if cty.is_vla(t) and not alignof_ and cty.is_complete(t) {
        // (evaluated, at run time: cgen_vla.ax)
        e.ty = cty.t_size;
        return e;
    }
    // (_Alignof of an array of unknown length is its element type's)
    let complete = cty.is_complete(t) or (alignof_ and (t.kind == cty.TK_ARRAY) and cty.is_complete(t.elem));
    if not complete {
        cs.err(e.span, "C3029", u.f2("the operand of %s has incomplete type %s", what, cs.tq(t)));
        return bad(e);
    }
    e.ty = cty.t_size;
    e.is_const = true;
    if alignof_ {
        e.cval = cty.align_of(t);
    } else {
        e.cval = cty.size_of(t);
    }
    return e;
}
