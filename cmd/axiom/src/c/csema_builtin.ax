// =============================================================================
// csema_builtin.ax - the compiler's builtins, which the headers in
// std/c/include/ are written with (their names are in the reserved
// namespace), and the type of __builtin_va_list:
//
//   __builtin_va_start(ap, parmN)  __builtin_va_end(ap)  __builtin_va_copy(d, s)
//   __builtin_va_arg(ap, type)     (a VA_ARG node: cparse.ax)    <stdarg.h>
//   __builtin_offsetof(type, member-designator)  (an OFFSETOF node)  <stddef.h>
//   __builtin_unreachable()                                          <stddef.h>
//   __builtin_stdc_leading_zeros(x) ... __builtin_stdc_bit_ceil(x)   <stdbit.h>
//   __builtin_ckd_add(r, a, b)  __builtin_ckd_sub  __builtin_ckd_mul  <stdckdint.h>
//   __builtin_atomic_load(obj, order) ...  (csema_atomic.ax)             <stdatomic.h>
//   __builtin_complex(x, y)  __builtin_creal(z)  __builtin_cimag(z)
//   __builtin_conj(z)                                                <complex.h>
//   __builtin_axiom_...: <math.h>, <tgmath.h>, <fenv.h> (csema_fp.ax)
//
// __builtin_complex(x, y) is the complex value x + iy of the complex type of
// x and y, which have one real floating type (CMPLX, CMPLXF, CMPLXL, and
// _Complex_I as __builtin_complex(0.0f, 1.0f)): a constant expression when
// both are; so are creal, cimag and conj of a constant (a complex operand).
//
// A call of a builtin is a CALL node whose op is its BI_ number (0 for any
// other call), with its arguments typed (and converted as BI_ says) and no
// callee to generate: cgen_va.ax generates each.
//
// va_list is the target's C ABI's (so that a va_list passed to the C
// library's v... functions means the same there): on x86-64 System V an
// array of one `struct __va_list_tag { unsigned gp_offset, fp_offset; void
// *overflow_arg_area, *reg_save_area; }`, on AArch64 Linux the structure
// `struct __va_list { void *__stack, *__gr_top, *__vr_top; int __gr_offs,
// __vr_offs; }`, elsewhere (Windows, macOS, WebAssembly) `char *`. The va
// builtins take their va_list operand as a pointer to the va_list object
// (an array va_list decays to one; for the others the node `&ap` is made).
//
// Diagnostics:
//   C3080  a va builtin used wrongly: outside a variadic function, an operand that is not a va_list
//   C3081  offsetof of a bit-field, or a member designator that does not designate a member
//   C3082  an operand of a <stdbit.h>, <stdckdint.h> or <complex.h> builtin of a type it does not take
//   C4080  va_start's second argument is not the function's last parameter
//   C4081  va_arg of a type that the default argument promotions change
// =============================================================================
import "../target.ax" as tg;
import "../util.ax" as u;
import "cast.ax" as cast;
import "cconst.ax" as cc;
import "cldbl.ax" as cl;
import "copts.ax" as co;
import "csema.ax" as cs;
import "csema_atomic.ax" as catm;
import "csema_expr.ax" as cx;
import "csema_fp.ax" as fp;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;

// The builtins (a CALL node's op).
pub const BI_VA_START: i32 = 1;
pub const BI_VA_END: i32 = 2;
pub const BI_VA_COPY: i32 = 3;
pub const BI_UNREACHABLE: i32 = 4;
// <stdbit.h>, in the standard's order (BI_STDC + k)
pub const BI_STDC: i32 = 10;
pub const BI_LEADING_ZEROS: i32 = 10;
pub const BI_LEADING_ONES: i32 = 11;
pub const BI_TRAILING_ZEROS: i32 = 12;
pub const BI_TRAILING_ONES: i32 = 13;
pub const BI_FIRST_LEADING_ZERO: i32 = 14;
pub const BI_FIRST_LEADING_ONE: i32 = 15;
pub const BI_FIRST_TRAILING_ZERO: i32 = 16;
pub const BI_FIRST_TRAILING_ONE: i32 = 17;
pub const BI_COUNT_ZEROS: i32 = 18;
pub const BI_COUNT_ONES: i32 = 19;
pub const BI_HAS_SINGLE_BIT: i32 = 20;
pub const BI_BIT_WIDTH: i32 = 21;
pub const BI_BIT_FLOOR: i32 = 22;
pub const BI_BIT_CEIL: i32 = 23;
// <stdckdint.h>
pub const BI_CKD_ADD: i32 = 30;
pub const BI_CKD_SUB: i32 = 31;
pub const BI_CKD_MUL: i32 = 32;
// <complex.h>
pub const BI_COMPLEX: i32 = 40;
pub const BI_CREAL: i32 = 41;
pub const BI_CIMAG: i32 = 42;
pub const BI_CONJ: i32 = 43;

let stdc_names: [14][]u8 = ["leading_zeros", "leading_ones", "trailing_zeros", "trailing_ones", "first_leading_zero",
                            "first_leading_one", "first_trailing_zero", "first_trailing_one", "count_zeros",
                            "count_ones", "has_single_bit", "bit_width", "bit_floor", "bit_ceil"];

/// Installs the builtins in csema_expr.ax.
pub fn install() void {
    cx.builtin_hooks = cx.BuiltinHooks.{ call: builtin_call, special: special };
}

/// Types a call of a GNU dialect's builtin (set by csema_gbuiltin.ax): true
/// if e is one.
pub let mut gnu_call: fn(*mut cast.Expr) bool = no_gnu_call;

fn no_gnu_call(e: *mut cast.Expr) bool {
    _ = e;
    return false;
}

// -----------------------------------------------------------------------------
// va_list
// -----------------------------------------------------------------------------

let mut g_va_list: *mut cty.CType = @ptr_from_int(*mut cty.CType, 0);
let mut g_va_for: *mut cty.CType = @ptr_from_int(*mut cty.CType, 0);  // (the unit's int: types are per unit)

fn member(ti: *mut cty.TagInfo, name: []u8, t: *mut cty.CType) void {
    let m = u.new.[cty.Member]();
    m.name = name;
    m.ty = t;
    m.index = @int_cast(i32, ti.members.len);
    ti.members.push(m);
}

/// The type __builtin_va_list names: the target's va_list.
pub fn va_list_type() *mut cty.CType {
    if u.notnil(g_va_list) and (g_va_for == cty.t_int) {
        return g_va_list;
    }
    g_va_for = cty.t_int;
    let sp = u.mkspan(0, 0, 0);
    let vp = cty.pointer_to(cty.t_void);
    if (tg.g_arch == tg.ARCH_X64) and not tg.is_windows() {
        let t = cty.new_tagged(cty.TK_STRUCT, "__va_list_tag", sp);
        // (32-bit unsigned fields: unsigned int, or the 32-bit type when int is not)
        let mut w = cty.t_uint;
        if w.bits != 32 {
            w = cty.t_ulong;
        }
        member(t.tag, "gp_offset", w);
        member(t.tag, "fp_offset", w);
        member(t.tag, "overflow_arg_area", vp);
        member(t.tag, "reg_save_area", vp);
        cty.layout(t.tag);
        g_va_list = cty.array_of(t, 1, true);
    } else if (tg.g_arch == tg.ARCH_A64) and not tg.is_darwin() and not tg.is_windows() {
        let t = cty.new_tagged(cty.TK_STRUCT, "__va_list", sp);
        let mut w = cty.t_int;
        if w.bits != 32 {
            w = cty.t_long;
        }
        member(t.tag, "__stack", vp);
        member(t.tag, "__gr_top", vp);
        member(t.tag, "__vr_top", vp);
        member(t.tag, "__gr_offs", w);
        member(t.tag, "__vr_offs", w);
        cty.layout(t.tag);
        g_va_list = t;
    } else {
        g_va_list = cty.pointer_to(cty.t_char);
    }
    return g_va_list;
}

fn is_err(e: *cast.Expr) bool {
    return u.isnil(e.ty) or (e.ty.kind == cty.TK_ERROR);
}

fn bad(e: *mut cast.Expr) *mut cast.Expr {
    e.ty = cty.t_error;
    e.lvalue = false;
    return e;
}

// The va_list operand x of builtin `what`, as a pointer to the va_list
// object (nil after an error, reported).
fn va_operand(x: *mut cast.Expr, what: []u8) *mut cast.Expr {
    let vt = va_list_type();
    if vt.kind == cty.TK_ARRAY {
        let v = cx.rv(x);
        if is_err(v) {
            return u.nil.[cast.Expr]();
        }
        if (v.ty.kind == cty.TK_POINTER) and cty.compatible_unq(v.ty.elem, vt.elem) {
            return v;
        }
        cs.err(x.span, "C3080", u.f2("the operand of %s has type %s, not va_list", what, cs.tq(v.ty)));
        return u.nil.[cast.Expr]();
    }
    let v = cx.check(x);
    if is_err(v) {
        return u.nil.[cast.Expr]();
    }
    if not cty.compatible_unq(v.ty, vt) {
        cs.err(x.span, "C3080", u.f2("the operand of %s has type %s, not va_list", what, cs.tq(v.ty)));
        return u.nil.[cast.Expr]();
    }
    if not v.lvalue {
        cs.err(x.span, "C3080", u.f1("the operand of %s is not an object (an lvalue of type va_list)", what));
        return u.nil.[cast.Expr]();
    }
    let a = cast.new_expr(cast.ExprKind.UNARY, x.span);
    a.op = ct.P_AMP;
    a.a = v;
    a.ty = cty.pointer_to(v.ty);
    a.height = v.height + 1;
    return a;
}

// -----------------------------------------------------------------------------
// Calls of builtins
// -----------------------------------------------------------------------------

fn arity(e: *mut cast.Expr, lo: usize, hi: usize) bool {
    let n = e.args.len;
    if (n >= lo) and (n <= hi) {
        return true;
    }
    let mut want = u.zdec(lo);
    if hi > lo {
        want = u.f2("%s or %s", u.zdec(lo), u.zdec(hi));
    }
    cs.err(e.span, "C3023", u.f3("'%s' takes %s arguments, not %s", e.a.name, want, u.zdec(n)));
    return false;
}

// The builtin `name` is: its BI_ number, or 0.
fn builtin_id(name: []u8) i32 {
    if u.starts(name, "__builtin_axiom_") {
        return fp.builtin_id(name[16..]);  // <math.h>, <tgmath.h>, <fenv.h>
    }
    if u.str_eq(name, "__builtin_va_start") {
        return BI_VA_START;
    }
    if u.str_eq(name, "__builtin_va_end") {
        return BI_VA_END;
    }
    if u.str_eq(name, "__builtin_va_copy") {
        return BI_VA_COPY;
    }
    if u.str_eq(name, "__builtin_unreachable") {
        return BI_UNREACHABLE;
    }
    if u.starts(name, "__builtin_stdc_") {
        let rest = name[15..];
        for k in 0..stdc_names.len {
            if u.str_eq(rest, stdc_names[k]) {
                return BI_STDC + @int_cast(i32, k);
            }
        }
        return 0;
    }
    if u.starts(name, "__builtin_atomic_") {
        return catm.builtin_id(name);  // (<stdatomic.h>: BI_ATOMIC_FIRST..BI_ATOMIC_LAST)
    }
    if u.str_eq(name, "__builtin_ckd_add") {
        return BI_CKD_ADD;
    }
    if u.str_eq(name, "__builtin_ckd_sub") {
        return BI_CKD_SUB;
    }
    if u.str_eq(name, "__builtin_ckd_mul") {
        return BI_CKD_MUL;
    }
    if u.str_eq(name, "__builtin_complex") {
        return BI_COMPLEX;
    }
    if u.str_eq(name, "__builtin_creal") {
        return BI_CREAL;
    }
    if u.str_eq(name, "__builtin_cimag") {
        return BI_CIMAG;
    }
    if u.str_eq(name, "__builtin_conj") {
        return BI_CONJ;
    }
    return 0;
}

// Types call e of a builtin, if its callee names one (true then).
fn builtin_call(e: *mut cast.Expr) bool {
    let id = builtin_id(e.a.name);
    if id == 0 {
        return gnu_call(e);  // (a GNU dialect's: csema_gbuiltin.ax)
    }
    if id >= fp.BI_FP {
        return fp.call(e, id);
    }
    e.op = id;
    e.ty = cty.t_void;
    if (id == BI_VA_START) or (id == BI_VA_END) or (id == BI_VA_COPY) {
        va_call(e, id);
    } else if id == BI_UNREACHABLE {
        if not arity(e, 0, 0) {
            _ = bad(e);
        }
    } else if catm.is_builtin(id) {
        catm.call(e, id);
    } else if id < BI_CKD_ADD {
        stdc_call(e, id);
    } else if id < BI_COMPLEX {
        ckd_call(e, id);
    } else {
        complex_call(e, id);
    }
    return true;
}

// __builtin_complex(x, y), __builtin_creal(z), __builtin_cimag(z),
// __builtin_conj(z): typed, and folded when the operands are constants.
fn complex_call(e: *mut cast.Expr, id: i32) void {
    let mut n: usize = 1;
    if id == BI_COMPLEX {
        n = 2;
    }
    if not arity(e, n, n) {
        _ = bad(e);
        return;
    }
    for i in 0..n {
        let x = cx.rv(e.args.get(i));
        e.args.set(i, x);
        if is_err(x) {
            _ = bad(e);
            return;
        }
    }
    let a = e.args.get(0);
    if id == BI_COMPLEX {
        let b = e.args.get(1);
        if not cty.is_floating(a.ty) or (cty.unqual(a.ty) != cty.unqual(b.ty)) {
            cs.err(e.span, "C3082",
                   u.f2("the operands of __builtin_complex have types %s and %s, not one real floating type",
                        cs.tq(a.ty), cs.tq(b.ty)));
            _ = bad(e);
            return;
        }
        e.ty = cty.complex_of(a.ty);
        if a.is_const and b.is_const {
            e.is_const = true;
            e.fcval = a.fcval;
            e.fcimag = b.fcval;
            e.xv = a.xv;  // (a wide long double's parts)
            e.xvim = b.xv;
            e.ovf = a.ovf or b.ovf;
        }
        return;
    }
    if not cty.is_complex(a.ty) {
        cs.err(a.span, "C3082", u.f2("the operand of %s has type %s, not a complex type", e.a.name, cs.tq(a.ty)));
        _ = bad(e);
        return;
    }
    if id == BI_CONJ {
        e.ty = cty.unqual(a.ty);
    } else {
        e.ty = a.ty.unq.elem;
    }
    if a.is_const {
        e.is_const = true;
        e.ovf = a.ovf;
        if id == BI_CREAL {
            e.fcval = a.fcval;
            e.xv = a.xv;
        } else if id == BI_CIMAG {
            e.fcval = a.fcimag;
            e.xv = a.xvim;
        } else {
            e.fcval = a.fcval;
            e.fcimag = -a.fcimag;
            e.xv = a.xv;
            e.xvim = cl.negate(a.xvim, cc.ld_fmt());  // (only a wide long double's is used)
        }
    }
}

fn va_call(e: *mut cast.Expr, id: i32) void {
    let mut lo: usize = 1;
    let mut hi: usize = 1;
    if id == BI_VA_START {
        lo = 2;
        hi = 2;
        if cs.std() >= co.C23 {
            lo = 1;
        }
    } else if id == BI_VA_COPY {
        lo = 2;
        hi = 2;
    }
    let names = ["", "va_start", "va_end", "va_copy"];
    let what = names[@int_cast(usize, id)];
    if not arity(e, lo, hi) {
        _ = bad(e);
        return;
    }
    let ap = va_operand(e.args.get(0), what);
    if u.isnil(ap) {
        _ = bad(e);
        return;
    }
    e.args.set(0, ap);
    if id == BI_VA_COPY {
        let src = va_operand(e.args.get(1), what);
        if u.isnil(src) {
            _ = bad(e);
            return;
        }
        e.args.set(1, src);
        return;
    }
    if id != BI_VA_START {
        return;
    }
    let f = cs.cur_fn();
    if u.isnil(f) or not f.ty.variadic {
        cs.err(e.span, "C3080", "va_start in a function whose parameters do not end with '...'");
        _ = bad(e);
        return;
    }
    if e.args.len < 2 {
        return;
    }
    if cs.std() >= co.C23 {
        // (C23: the arguments after the first are not evaluated)
        _ = e.args.pop();
        return;
    }
    // C89-C17: the second is the last named parameter (6.10.1.4: undefined otherwise)
    let p = e.args.get(1);
    let n = f.params.len;
    let mut ok = (p.kind == cast.ExprKind.IDENT) and (n > 0);
    if ok {
        ok = u.str_eq(p.name, f.params.get(n - 1).name);
    }
    if not ok {
        cs.warn(p.span, "C4080", "the second argument of va_start is not the last parameter of the function");
    }
    _ = e.args.pop();
}

// x's type is one a <stdbit.h> builtin takes: an unsigned integer type
// other than bool (and plain char, which is not one).
fn stdbit_type(t: *cty.CType) bool {
    let k = t.unq.kind;
    return (k == cty.TK_UCHAR) or (k == cty.TK_USHORT) or (k == cty.TK_UINT) or (k == cty.TK_ULONG) or
           (k == cty.TK_ULLONG);
}

fn stdc_call(e: *mut cast.Expr, id: i32) void {
    if not arity(e, 1, 1) {
        _ = bad(e);
        return;
    }
    let x = cx.rv(e.args.get(0));
    e.args.set(0, x);
    if is_err(x) {
        _ = bad(e);
        return;
    }
    let name = stdc_names[@int_cast(usize, id - BI_STDC)];
    if not stdbit_type(x.ty) {
        cs.err(x.span, "C3082", u.f2("the operand of stdc_%s has type %s, not an unsigned integer type", name,
                                     cs.tq(x.ty)));
        _ = bad(e);
        return;
    }
    if (id == BI_BIT_FLOOR) or (id == BI_BIT_CEIL) {
        e.ty = cty.unqual(x.ty);
    } else if id == BI_HAS_SINGLE_BIT {
        e.ty = cty.t_bool;
    } else {
        e.ty = cty.t_uint;
    }
}

// A type <stdckdint.h> takes: an integer type other than plain char, bool
// and enumerations.
fn ckd_type(t: *cty.CType) bool {
    let k = t.unq.kind;
    return cty.is_integer(t) and (k != cty.TK_CHAR) and (k != cty.TK_BOOL) and (k != cty.TK_ENUM);
}

fn ckd_call(e: *mut cast.Expr, id: i32) void {
    let names = ["ckd_add", "ckd_sub", "ckd_mul"];
    let what = names[@int_cast(usize, id - BI_CKD_ADD)];
    if not arity(e, 3, 3) {
        _ = bad(e);
        return;
    }
    let mut ok = true;
    for i in @as(usize, 0)..3 {
        let x = cx.rv(e.args.get(i));
        e.args.set(i, x);
        if is_err(x) {
            ok = false;
        }
    }
    if not ok {
        _ = bad(e);
        return;
    }
    let r = e.args.get(0);
    if (r.ty.kind != cty.TK_POINTER) or not ckd_type(r.ty.elem) or ((r.ty.elem.quals & cty.Q_CONST) != 0) {
        cs.err(r.span, "C3082", u.f3("the first operand of %s has type %s, not a pointer to a modifiable integer %s",
                                     what, cs.tq(r.ty), "(other than char, bool or an enumeration)"));
        _ = bad(e);
        return;
    }
    for i in @as(usize, 1)..3 {
        let x = e.args.get(i);
        if not ckd_type(x.ty) {
            cs.err(x.span, "C3082", u.f4("operand %s of %s has type %s, not an integer type %s", u.zdec(i + 1), what,
                                         cs.tq(x.ty), "(other than char, bool or an enumeration)"));
            _ = bad(e);
            return;
        }
    }
    e.ty = cty.t_bool;
}

// -----------------------------------------------------------------------------
// va_arg and offsetof
// -----------------------------------------------------------------------------

// Types a VA_ARG or OFFSETOF node.
fn special(e: *mut cast.Expr) *mut cast.Expr {
    if e.kind == cast.ExprKind.VA_ARG {
        return va_arg(e);
    }
    return offsetof(e);
}

fn va_arg(e: *mut cast.Expr) *mut cast.Expr {
    let ap = va_operand(e.a, "va_arg");
    let t = cs.hooks.type_name(e.tname);
    if u.isnil(ap) or cty.is_error(t) {
        return bad(e);
    }
    e.a = ap;
    if cty.is_func(t) or (t.kind == cty.TK_ARRAY) or not cty.is_complete(t) {
        cs.err(e.tname.span, "C3080", u.f1("va_arg of type %s (a complete object type that is not an array is needed)",
                                           cs.tq(t)));
        return bad(e);
    }
    if cty.is_arith(t) and (cty.arg_promote(cty.unqual(t)) != cty.unqual(t)) {
        cs.warn(e.tname.span, "C4081",
                u.f2("va_arg of type %s, which the default argument promotions change (the argument has type %s)",
                     cs.tq(t), cs.tq(cty.arg_promote(cty.unqual(t)))));
    }
    e.ty = cty.unqual(t);
    return e;
}

fn offsetof(e: *mut cast.Expr) *mut cast.Expr {
    let t = cs.hooks.type_name(e.tname);
    if cty.is_error(t) {
        return bad(e);
    }
    if not cty.is_record(t) {
        cs.err(e.tname.span, "C3025", u.f1("offsetof of %s, not a structure or union type", cs.tq(t)));
        return bad(e);
    }
    let mut cur = t;
    let mut off: u64 = 0;
    for d in e.args.items() {
        if d.kind == cast.ExprKind.MEMBER {
            if not cty.is_record(cur) {
                cs.err(d.span, "C3081", u.f2("'.%s' in the member designator of offsetof, on %s", d.name, cs.tq(cur)));
                return bad(e);
            }
            if not cty.is_complete(cur) {
                cs.err(d.span, "C3007", u.f2("'%s' in %s, an incomplete type", d.name, cs.tq(cur)));
                return bad(e);
            }
            let fm = cty.find_member(cur, d.name);
            if u.isnil(fm.m) {
                cs.err(d.name_span, "C3025", u.f2("%s has no member named '%s'", cs.tq(cur), d.name));
                return bad(e);
            }
            if is_bitfield(fm.m) {
                cs.err(d.name_span, "C3081", u.f1("offsetof of the bit-field '%s'", d.name));
                return bad(e);
            }
            off += fm.offset;
            cur = fm.m.ty;
        } else {
            let x = cx.ice(d.b, "a subscript in the member designator of offsetof");
            if not x.ok {
                return bad(e);
            }
            d.b = x.e;
            if cur.kind != cty.TK_ARRAY {
                cs.err(d.span, "C3081", u.f1("a subscript in the member designator of offsetof, on %s", cs.tq(cur)));
                return bad(e);
            }
            off += x.v * cty.size_of(cur.elem);
            cur = cur.elem;
        }
    }
    e.ty = cty.t_size;
    e.is_const = true;
    e.cval = cty.wrap(cty.t_size, off);
    return e;
}

fn is_bitfield(m: *cty.Member) bool {
    return m.is_bitfield;
}
