// =============================================================================
// csema_stmt.ax - C statements (6.8) and function bodies: the scopes of
// blocks, switch with its case and default labels (Stmt.cases, Stmt.cval),
// break and continue, return, and the labels of goto, which have function
// scope (Stmt.sym). analyze is the entry point of semantic analysis: it
// installs the hooks csema.ax calls and runs it.
// =============================================================================
import "../target.ax" as tg;
import "../util.ax" as u;
import "cast.ax" as cast;
import "copts.ax" as co;
import "ctypes.ax" as cty;
import "cwide.ax" as cw;

// A switch statement being analyzed.
nocopy struct Switch {
    s: *mut cast.Stmt,
    ty: *mut cty.CType,  // the promoted type of its controlling expression
    values: u.SymMap.[i32],
    has_default: bool,
    scope: ?*mut VNode,               // the scope its body starts in (csema_vla.mark)
    ranges: u.List.[*mut cast.Stmt],  // its case ranges (a GNU dialect)
}

// A local label (`__label__`, a GNU dialect), in its block.
struct Local {
    name: []u8,
    sym: *mut cast.CSym,
}

nocopy struct Body {
    f: *mut cast.CSym,
    ret: *mut cty.CType,
    labels: u.SymMap.[?*mut cast.CSym],
    label_list: u.List.[*mut cast.CSym],
    switches: u.List.[*mut Switch],
    loops: i32,                            // loops around the current statement
    breakable: i32,                        // loops and switches around it
    locals: u.List.[Local],                // the local labels in scope, innermost last
    addr_labels: u.List.[*mut cast.Stmt],  // the computed gotos (`goto *p`)
    parent: ?*mut Body,                    // a nested function's: its enclosing function's body
}

fn cur_body() *mut Body {
    return g_body ?? u.new.[Body]();
}

// Does an enclosing function of the body b (a nested function's) have the
// label `name`, a local label or one used or defined so far?
fn outer_label(b: *mut Body, name: []u8) bool {
    let mut op = b.parent;
    loop {
        let p = op ?? return false;
        if let .some(lbl) = p.labels.get(name) {
            _ = lbl;
            return true;
        }
        for &l in p.locals.items() {
            if u.str_eq(l.name, name) {
                return true;
            }
        }
        op = p.parent;
    }
}

// The labels whose addresses are taken (`&&label`), by function: IR
// generation's, for `goto *` (cgen_stmt.ax).
fn addr_label_list(f: *cast.CSym) *mut u.List.[*mut cast.CSym] {
    let k = u.addr_key(@int_from_ptr(f));
    if let .some(l) = g_addr_labels.get(k) {
        return l;
    }
    let l = u.new.[u.List.[*mut cast.CSym]]();
    g_addr_labels.put(k, .some(l));
    return l;
}

/// The labels of function f whose addresses are taken (`&&label`, a GNU
/// dialect), in the order of their indexes (CSym.value).
pub fn addr_labels(f: *cast.CSym) []mut *mut cast.CSym {
    return addr_label_list(f).items_mut();
}

// The body of function definition d of function f: its parameters are in
// the scope of the body's outermost block.
fn function_body(f: *mut cast.CSym, d: *mut cast.Decl) void {
    let b = u.new.[Body]();
    b.f = f;
    b.ret = f.ty.ret;
    b.labels = u.SymMap.[?*mut cast.CSym].{ keys: u.nil.[usize](), vals: u.nil.[?*mut cast.CSym](), cap: 0, len: 0 };
    let saved = g_body;
    if u.notnil(f.nest_parent) {
        b.parent = saved;
    }
    g_body = .some(b);
    // (a nested function's body is analyzed inside its enclosing one's: what
    // describes that body is set aside, and taken up again after)
    let saved_fn = cur_fn();
    let saved_vla = vla_save();
    let saved_marks = marks_save_body();
    set_cur_fn(.some(f));
    vla_begin_body();
    push_scope();
    for p in f.params.items() {
        p.owner = f;
        if p.name.len > 0 {
            if let .some(prior) = lookup_here(p.name) {
                _ = prior;
            } else {
                declare(p.name, p);
            }
        }
    }
    own_params(f);  // (the lengths in its parameters' types)
    let xs = d.body.items.items();
    let mut naked = false;
    if let .some(gn) = gnu_note_if(@int_from_ptr(f)) {
        naked = gn.naked;
    }
    // (on WebAssembly a naked function's asm is its code, checked as a whole: csema_asm.ax)
    g_naked_wasm = tg.is_wasm() and naked;
    let follow = g_follow_case;
    for i in 0..xs.len {
        g_follow_case = follows_case(xs, i, false);
        stmt(xs[i]);
        fallthrough(xs, i, false);
    }
    g_follow_case = follow;
    g_naked_wasm = false;
    pop_scope();
    if naked {
        naked_body(f, d.body);
    }
    for l in b.label_list.items() {
        if not l.defined and outer_label(b, l.name) {
            // (only a local label of an enclosing function is seen in a
            // nested function: its other labels are its own)
            err(l.span, "C3043",
                u.f1("the label '%s' is used but not defined (a nested function jumps only to the labels of its enclosing function that are declared with '__label__')",
                     l.name));
        } else if not l.defined {
            err(l.span, "C3043", u.f1("the label '%s' is used but not defined", l.name));
        } else if not l.used and not maybe_unused(l) {
            warn(l.span, "C4040", u.f1("the label '%s' is defined but not used", l.name));
        }
    }
    vla_end_body();
    if f.has_nested {
        nest_finish(f, unit().funcs.items());
    }
    set_cur_fn(saved_fn);
    vla_restore(saved_vla);
    marks_restore_body(saved_marks);
    g_body = saved;
}

fn label_sym(name: []u8, sp: u.Span) *mut cast.CSym {
    let b = cur_body();
    // (a local label of a block around it first: a GNU dialect)
    let mut k = b.locals.len;
    while k > 0 {
        k -= 1;
        if u.same(b.locals.get(k).name, name) {
            return b.locals.get(k).sym;
        }
    }
    if let .some(l) = b.labels.get(name) {
        return l;
    }
    let l = new_sym(cast.SK_LABEL, name, sp, cty.t_void);
    b.labels.put(name, .some(l));
    b.label_list.push(l);
    return l;
}

// The label a goto in the body names: as label_sym, but in a nested
// function, if it has no label of the name, a local label (`__label__`) of
// an enclosing function in scope there: a non-local goto, which jumps out of
// the nested function's call into its enclosing function's (6.8.6.1 for a
// goto from there: cgen_nest.ax).
fn goto_label(name: []u8, sp: u.Span) *mut cast.CSym {
    let b = cur_body();
    let mut k = b.locals.len;
    while k > 0 {
        k -= 1;
        if u.same(b.locals.get(k).name, name) {
            return b.locals.get(k).sym;
        }
    }
    if let .some(lbl) = b.labels.get(name) {
        _ = lbl;
    } else {
        let mut op = b.parent;
        loop {
            let p = op ?? break;
            let mut j = p.locals.len;
            while j > 0 {
                j -= 1;
                let l = p.locals.get(j).sym;
                if u.same(l.name, name) {
                    add_once(&mut p.f.nonlocal, l);
                    return l;
                }
            }
            op = p.parent;
        }
    }
    return label_sym(name, sp);
}

fn stmt(s: *mut cast.Stmt) void {
    if u.isnil(s) {
        return;
    }
    let k = s.kind;
    if s.attrs.len > 0 {
        let lab = (k == cast.StmtKind.LABEL) or (k == cast.StmtKind.CASE) or (k == cast.StmtKind.DEFAULT);
        if lab {
            attrs(&s.attrs, AP_LABEL);
        } else {
            attrs(&s.attrs, AP_STMT);
        }
    }
    let b = cur_body();
    if k == cast.StmtKind.COMPOUND {
        push_scope();
        let m = vla_mark();
        let nl = b.locals.len;
        let xs = s.items.items();
        let outer = g_follow_case;
        for i in 0..xs.len {
            if u.notnil(xs[i]) {
                fp_dir(xs[i].fp);  // (each item's floating-point pragmas)
            }
            g_follow_case = follows_case(xs, i, outer);
            stmt(xs[i]);
            fallthrough(xs, i, outer);
        }
        g_follow_case = outer;
        fp_dir(s.fp);
        b.locals.len = nl;
        vla_leave(m);
        pop_scope();
    } else if (k == cast.StmtKind.DECL) and (s.decl.kind == cast.DeclKind.LABELS) {
        local_labels(s.decl);
    } else if k == cast.StmtKind.DECL {
        block_decl(s.decl);
        vla_declared(s.decl);
    } else if k == cast.StmtKind.EXPR {
        if u.notnil(s.e) {
            s.e = full_expr(s.e);
        }
    } else if (k == cast.StmtKind.IF) or (k == cast.StmtKind.SWITCH) or (k == cast.StmtKind.WHILE) or
              (k == cast.StmtKind.DO) {
        // (a selection or iteration statement is a block of its own from C99: 6.8.4p3, 6.8.5p5)
        let scoped = std() >= co.C99;
        if scoped {
            push_scope();
        }
        if k == cast.StmtKind.IF {
            s.e = cond_expr(s.e, "'if'");
            stmt_sub(s.body);
            stmt_sub(s.els);
        } else if k == cast.StmtKind.SWITCH {
            switch_stmt(s);
        } else if k == cast.StmtKind.WHILE {
            s.e = cond_expr(s.e, "'while'");
            loop_body(s.body);
        } else {
            loop_body(s.body);
            s.e = cond_expr(s.e, "'do'");
        }
        if scoped {
            pop_scope();
        }
    } else if k == cast.StmtKind.FOR {
        // (the clauses and body are a block of their own: C99 6.8.5p5)
        push_scope();
        let m = vla_mark();
        if u.notnil(s.decl) {
            for_decl(s.decl);
            vla_declared(s.decl);
        } else if u.notnil(s.first) {
            s.first = full_expr(s.first);
        }
        if u.notnil(s.e) {
            s.e = cond_expr(s.e, "'for'");
        }
        if u.notnil(s.step) {
            s.step = full_expr(s.step);
        }
        loop_body(s.body);
        vla_leave(m);
        pop_scope();
    } else if (k == cast.StmtKind.GOTO) and u.notnil(s.e) {
        computed_goto(s);
    } else if k == cast.StmtKind.GOTO {
        let l = goto_label(s.label, s.label_span);
        l.used = true;
        s.sym = l;
        if u.isnil(l.owner) or (l.owner == b.f) {
            vla_goto(s);  // (a non-local goto leaves this function: cgen_nest.ax)
        }
    } else if k == cast.StmtKind.CONTINUE {
        if b.loops == 0 {
            err(s.span, "C3042", "'continue' is not in a loop");
        }
    } else if k == cast.StmtKind.BREAK {
        if b.breakable == 0 {
            err(s.span, "C3042", "'break' is not in a loop or switch statement");
        }
    } else if k == cast.StmtKind.RETURN {
        return_stmt(s);
    } else if k == cast.StmtKind.LABEL {
        let l = label_sym(s.label, s.label_span);
        if l.defined {
            err_note(s.label_span, "C3002", u.f1("a second label '%s'", s.label), l.span, "the first");
        }
        l.defined = true;
        l.span = s.label_span;
        s.sym = l;
        attr_mark_sym(l, &s.attrs);
        vla_label(l);
        stmt(s.body);
    } else if k == cast.StmtKind.CASE {
        case_stmt(s);
    } else if k == cast.StmtKind.ASM {
        asm_stmt(s.asm);
        // (each label of asm goto: as a goto to it)
        for l in s.asm.labels.items() {
            let g = cast.new_stmt(cast.StmtKind.GOTO, l.span);
            g.label = l.name;
            g.label_span = l.span;
            l.stmt = g;
            stmt(g);
        }
    } else {
        default_stmt(s);
    }
}

// Is s (after its labels) a fallthrough declaration `[[fallthrough]];` (C23)?
fn is_fallthrough(s0: *cast.Stmt) bool {
    let mut s = s0;
    while ((s.kind == cast.StmtKind.LABEL) or (s.kind == cast.StmtKind.CASE) or (s.kind == cast.StmtKind.DEFAULT)) and
          u.notnil(s.body) {
        s = s.body;
    }
    if (s.kind != cast.StmtKind.DECL) or u.isnil(s.decl) or (s.decl.kind != cast.DeclKind.ATTR) {
        return false;
    }
    for a in s.decl.attrs.items() {
        let gnu = u.str_eq(a.prefix, "gnu") and opts().gnu;
        if ((a.prefix.len == 0) or gnu) and (u.str_eq(a.name, "fallthrough") or u.str_eq(a.name, "__fallthrough__")) {
            return true;
        }
    }
    return false;
}

// Is the statement being checked, once it completes, followed by a case or
// default label of the innermost switch statement: the next block item, or
// for the last item of a block the label that follows the block (and so on
// outwards, through selection and labeled statements, not out of a loop's
// or a switch's body)?
// Is block item xs[i] followed so (`outer`: whether the block is)?
fn follows_case(xs: []*mut cast.Stmt, i: usize, outer: bool) bool {
    if (i + 1) == xs.len {
        return outer;
    }
    let k = xs[i + 1].kind;
    return (k == cast.StmtKind.CASE) or (k == cast.StmtKind.DEFAULT);
}

// Block item xs[i], if a fallthrough declaration, is in a switch statement and
// the next block item that would be encountered after it is a case or default
// label (C23 6.7.13.5p2): the next item of its block, or the label after the
// block when it is the block's last (`outer`: whether the block is followed so).
fn fallthrough(xs: []*mut cast.Stmt, i: usize, outer: bool) void {
    if not is_fallthrough(xs[i]) {
        return;
    }
    if (cur_body().switches.len == 0) or not follows_case(xs, i, outer) {
        err(xs[i].span, "C3077", "'[[fallthrough]]' is not followed by a case or default label of a switch statement");
    }
}

// A secondary block (the body of a selection or iteration statement): a
// scope of its own from C99 (6.8.4p3).
fn stmt_sub(s: *mut cast.Stmt) void {
    if u.isnil(s) {
        return;
    }
    let scoped = (std() >= co.C99) and (s.kind != cast.StmtKind.COMPOUND);
    if scoped {
        push_scope();
    }
    stmt(s);
    if scoped {
        pop_scope();
    }
}

fn loop_body(s: *mut cast.Stmt) void {
    let b = cur_body();
    b.loops += 1;
    b.breakable += 1;
    let follow = g_follow_case;
    g_follow_case = false;  // (its end goes back to the loop's test)
    stmt_sub(s);
    g_follow_case = follow;
    b.loops -= 1;
    b.breakable -= 1;
}

fn switch_stmt(s: *mut cast.Stmt) void {
    let b = cur_body();
    let e = rv(s.e);
    let sw = u.new.[Switch]();
    sw.s = s;
    sw.ty = cty.t_error;
    sw.values = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    if u.notnil(e.ty) and not cty.is_error(e.ty) {
        if not cty.is_integer(e.ty) {
            err(e.span, "C3030", u.f1("the controlling expression of 'switch' has type %s, not an integer type",
                                      tq(e.ty)));
        } else {
            sw.ty = cty.promote(e.ty);
        }
    }
    s.e = convert(e, sw.ty);
    sw.scope = vla_mark();
    b.switches.push(sw);
    b.breakable += 1;
    let follow = g_follow_case;
    g_follow_case = false;  // (its end leaves the switch)
    stmt_sub(s.body);
    g_follow_case = follow;
    b.breakable -= 1;
    _ = b.switches.pop();
}

fn case_stmt(s: *mut cast.Stmt) void {
    let b = cur_body();
    if (b.switches.len > 0) and cty.is_wint(b.switches.last().ty) {
        wide_case(s);
        return;
    }
    let r = ice(s.e, "a case label");
    s.e = r.e;
    let mut hi = r;
    if u.notnil(s.hi) {
        hi = ice(s.hi, "the end of a case range");
        s.hi = hi.e;
    }
    if b.switches.len == 0 {
        err(s.span, "C3040", "'case' is not in a switch statement");
    } else if r.ok and hi.ok {
        let sw = b.switches.last();
        if not cty.is_error(sw.ty) {
            // the value converted to the promoted controlling type (6.8.4.2p5)
            s.cval = cty.wrap(sw.ty, r.v);
            s.cval_hi = cty.wrap(sw.ty, hi.v);
            if u.notnil(s.hi) {
                case_range(sw, s);
            } else {
                let key = u.intern(u.udec(s.cval));
                if (sw.values.get(key) != 0) or in_range(sw, s.cval) {
                    err(s.e.span, "C3041", u.f1("a second case with the value %s", val_text(sw, s.cval)));
                }
                sw.values.put(key, 1);
                sw.s.cases.push(s);
            }
        }
        vla_case_label(s, b.switches.last().scope);
    }
    stmt(s.body);
}

// A case label of a switch whose controlling expression is wider than 64
// bits: its value converted to that type is the constant s.e (cwide.ax),
// which cgen_stmt compares with; a case range's last value is s.hi, likewise.
fn wide_case(s: *mut cast.Stmt) void {
    let sw = cur_body().switches.last();
    let r = ice_wide(s.e, "a case label");
    s.e = r.e;
    let mut hi = r;
    if u.notnil(s.hi) {
        hi = ice_wide(s.hi, "the end of a case range");
        s.hi = hi.e;
    }
    if r.ok and hi.ok {
        s.e = convert(r.e, sw.ty);
        s.cval = s.e.cval;
        if u.notnil(s.hi) {
            s.hi = convert(hi.e, sw.ty);
            wide_range(sw, s);
        } else {
            let key = u.intern(cw.text(s.e));
            let mut dup = sw.values.get(key) != 0;
            for c in sw.ranges.items() {
                if (cw.compare(sw.ty, c.e, s.e) <= 0) and (cw.compare(sw.ty, s.e, c.hi) <= 0) {
                    dup = true;
                }
            }
            if dup {
                err(s.e.span, "C3041", u.f1("a second case with the value %s", cw.text(s.e)));
            }
            sw.values.put(key, 1);
            sw.s.cases.push(s);
        }
    }
    vla_case_label(s, sw.scope);
    stmt(s.body);
}

// A case range of a switch wider than 64 bits (as case_range).
fn wide_range(sw: *mut Switch, s: *mut cast.Stmt) void {
    let t = sw.ty;
    if cw.compare(t, s.e, s.hi) > 0 {
        warn(s.span, "C4120", "an empty case range: its first value is greater than its last");
        return;
    }
    for c in sw.ranges.items() {
        if (cw.compare(t, c.e, s.hi) <= 0) and (cw.compare(t, s.e, c.hi) <= 0) {
            err_note(s.e.span, "C3041", "a case range that overlaps another", c.span, "the other");
            return;
        }
    }
    for c in sw.s.cases.items() {
        if (c.kind == cast.StmtKind.CASE) and u.isnil(c.hi) and (cw.compare(t, s.e, c.e) <= 0) and
           (cw.compare(t, c.e, s.hi) <= 0) {
            err_note(s.e.span, "C3041", u.f1("a case range that includes the value %s of another case", cw.text(c.e)),
                     c.span, "the other");
            return;
        }
    }
    sw.ranges.push(s);
    sw.s.cases.push(s);
}

fn val_text(sw: *Switch, v: u64) []u8 {
    return u.pick(sw.ty.is_signed, u.dec(@bit_cast(i64, v)), u.udec(v));
}

// a <= b in the switch's promoted type.
fn le(sw: *Switch, a: u64, b: u64) bool {
    if sw.ty.is_signed {
        return @bit_cast(i64, a) <= @bit_cast(i64, b);
    }
    return a <= b;
}

// Is v in one of the case ranges of the switch?
fn in_range(sw: *Switch, v: u64) bool {
    for c in sw.ranges.items() {
        if le(sw, c.cval, v) and le(sw, v, c.cval_hi) {
            return true;
        }
    }
    return false;
}

// `case lo ... hi:` (a GNU dialect): the values lo to hi, none of them
// another case's (C3041); an empty range (lo > hi) is warning C4120 and
// matches nothing.
fn case_range(sw: *mut Switch, s: *mut cast.Stmt) void {
    if not le(sw, s.cval, s.cval_hi) {
        warn(s.span, "C4120", "an empty case range: its first value is greater than its last");
        return;
    }
    for c in sw.ranges.items() {
        if le(sw, c.cval, s.cval_hi) and le(sw, s.cval, c.cval_hi) {
            err_note(s.e.span, "C3041", "a case range that overlaps another", c.span, "the other");
            return;
        }
    }
    for c in sw.s.cases.items() {
        if (c.kind == cast.StmtKind.CASE) and u.isnil(c.hi) and le(sw, s.cval, c.cval) and le(sw, c.cval, s.cval_hi) {
            err_note(s.e.span, "C3041",
                     u.f1("a case range that holds the value %s of another case", val_text(sw, c.cval)), c.span,
                     "the other");
            return;
        }
    }
    sw.ranges.push(s);
    sw.s.cases.push(s);
}

// `__label__ a, b;` (a GNU dialect): labels of the enclosing block.
fn local_labels(d: *mut cast.Decl) void {
    let b = cur_body();
    let start = b.locals.len;
    for dc in d.decls.items() {
        for k in start..b.locals.len {
            if u.same(b.locals.get(k).name, dc.name) {
                err(dc.name_span, "C3002", u.f1("the local label '%s' is declared twice", dc.name));
            }
        }
        let l = new_sym(cast.SK_LABEL, dc.name, dc.name_span, cty.t_void);
        l.owner = b.f;  // (a nested function may jump to it: goto_label)
        b.label_list.push(l);
        b.locals.push(Local.{ name: dc.name, sym: l });
    }
}

// `goto *e;` (a GNU dialect): e a pointer, to one of the function's labels
// (`&&label`). Where variable length arrays or objects with cleanups are in
// scope, or at the labels, IR generation leaves the scopes the jump leaves
// (and traps on a jump into one: cgen_stmt.computed_goto).
fn computed_goto(s: *mut cast.Stmt) void {
    let e = rv(s.e);
    s.e = e;
    if u.notnil(e.ty) and not cty.is_error(e.ty) and (e.ty.kind != cty.TK_POINTER) {
        err(e.span, "C3020", u.f1("the operand of 'goto *' has type %s, not a pointer type", tq(e.ty)));
    }
    cur_body().addr_labels.push(s);
}

// `&&label` (a GNU dialect): the label's address, a `void *`.
fn label_addr(e: *mut cast.Expr) *mut cast.Expr {
    if let .some(b) = g_body {
        // (in a nested function, a local label (`__label__`) of an enclosing
        // function in scope there, if it has no label of the name: that
        // function's label, whose address its own `goto *` may jump to)
        let mut owner = b.f;
        let mut ol: ?*mut cast.CSym = .none;
        let mut k = b.locals.len;
        while k > 0 {
            k -= 1;
            if u.same(b.locals.get(k).name, e.name) {
                ol = .some(b.locals.get(k).sym);
                break;
            }
        }
        if let .some(found) = ol {
            _ = found;
        } else if let .some(lbl) = b.labels.get(e.name) {
            _ = lbl;
        } else {
            let mut op = b.parent;
            loop {
                let p = op ?? break;
                let mut found = false;
                let mut j = p.locals.len;
                while j > 0 {
                    j -= 1;
                    if u.same(p.locals.get(j).name, e.name) {
                        ol = .some(p.locals.get(j).sym);
                        owner = p.f;
                        found = true;
                        break;
                    }
                }
                if found {
                    break;
                }
                op = p.parent;
            }
        }
        let l = ol ?? label_sym(e.name, e.name_span);
        l.used = true;
        if not l.label_addr {
            // (its index among the function's labels whose addresses are taken)
            l.label_addr = true;
            l.owner = owner;
            l.value = owner.value;
            owner.value += 1;
            addr_label_list(owner).push(l);
        }
        e.sym = l;
        e.ty = cty.pointer_to(cty.t_void);
        return e;
    }
    err(e.span, "C3090", "the address of a label outside a function");
    e.ty = cty.t_error;
    return e;
}

/// The expression statement statement s is, after its labels (the last
/// statement of a statement expression gives its value then), or nil.
pub fn value_stmt(s0: *mut cast.Stmt) *mut cast.Stmt {
    let mut s = s0;
    while ((s.kind == cast.StmtKind.LABEL) or (s.kind == cast.StmtKind.CASE) or (s.kind == cast.StmtKind.DEFAULT)) and
          u.notnil(s.body) {
        s = s.body;
    }
    if (s.kind == cast.StmtKind.EXPR) and u.notnil(s.e) and (s.attrs.len == 0) {
        return s;
    }
    return u.nil.[cast.Stmt]();
}

// `({ ... })` (a GNU dialect): the block's items, in a scope of their own;
// its value and type are those of its last item if that is an expression
// statement, else void.
fn stmt_expr(e: *mut cast.Expr) *mut cast.Expr {
    if let .some(b) = g_body {
        let s = e.body;
        push_scope();
        let m = vla_mark();
        let nl = b.locals.len;
        let xs = s.items.items();
        e.ty = cty.t_void;
        let follow = g_follow_case;
        for i in 0..xs.len {
            let x = xs[i];
            g_follow_case = follows_case(xs, i, false);
            stmt(x);
            fallthrough(xs, i, false);
            let v = value_stmt(x);
            if (i + 1 == xs.len) and u.notnil(v) and u.notnil(v.e.ty) {
                e.ty = cty.unqual(v.e.ty);
            }
        }
        g_follow_case = follow;
        b.locals.len = nl;
        vla_leave(m);
        pop_scope();
        return e;
    }
    err(e.span, "C3090", "a statement expression outside a function");
    e.ty = cty.t_error;
    return e;
}

fn default_stmt(s: *mut cast.Stmt) void {
    let b = cur_body();
    if b.switches.len == 0 {
        err(s.span, "C3040", "'default' is not in a switch statement");
    } else {
        let sw = b.switches.last();
        if sw.has_default {
            err(s.span, "C3041", "a second 'default' label in one switch statement");
        }
        sw.has_default = true;
        sw.s.cases.push(s);
        vla_case_label(s, sw.scope);
    }
    stmt(s.body);
}

fn return_stmt(s: *mut cast.Stmt) void {
    let b = cur_body();
    let rt = b.ret;
    if u.isnil(s.e) {
        if not cty.is_void(rt) and (std() >= co.C99) {
            err(s.span, "C3044", u.f2("'return' without a value in '%s', which returns %s", b.f.name, tq(rt)));
        }
        return;
    }
    let e = rv(s.e);
    s.e = e;
    if cty.is_void(rt) {
        if u.isnil(e.ty) or cty.is_error(e.ty) {
            return;
        }
        if opts().gnu and cty.is_void(e.ty) {
            return;  // (a GNU dialect: an expression of type void, evaluated)
        }
        if opts().gnu and (std() < co.C99) {
            // (gnu89: the value is evaluated and discarded, with a warning)
            warn(e.span, "C4146", u.f1("'return' with a value in '%s', which returns void: the value is discarded",
                                       b.f.name));
            return;
        }
        err(e.span, "C3044", u.f1("'return' with a value in '%s', which returns void", b.f.name));
        return;
    }
    s.e = assign_convert(e, cty.unqual(rt), "return");
}
