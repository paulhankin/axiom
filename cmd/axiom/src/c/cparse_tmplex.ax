// =============================================================================
// cparse_tmplex.ax - a small stand-in tokenizer for the parser's tests, used
// until the preprocessor (cpp.ax) produces tokens: identifiers and keywords,
// integer and floating constants with their suffixes, character constants
// and string literals with their prefixes and simple escapes, punctuators
// and comments. No macros; a line that starts with '#' is skipped.
// =============================================================================
import "../diag.ax" as dg;
import "../util.ax" as u;
import "copts.ax" as co;
import "ctok.ax" as ct;

struct Lex {
    f: *mut u.SourceFile,
    s: []u8,
    i: usize,
    std: i32,
    bol: bool,
    space: bool,
    toks: u.List.[ct.Token],
}

fn at(L: *Lex, k: usize) u8 {
    if (L.i + k) < L.s.len {
        return L.s[L.i + k];
    }
    return 0;
}

fn is_ident_start(c: u8) bool {
    return ((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z')) or (c == '_') or (c >= 0x80);
}

fn is_ident_char(c: u8) bool {
    return is_ident_start(c) or u.is_digit(c);
}

fn hexval(c: u8) i32 {
    if u.is_digit(c) {
        return @as(i32, c - '0');
    }
    if (c >= 'a') and (c <= 'f') {
        return @as(i32, c - 'a') + 10;
    }
    if (c >= 'A') and (c <= 'F') {
        return @as(i32, c - 'A') + 10;
    }
    return -1;
}

fn push(L: *mut Lex, t0: ct.Token, start: usize) void {
    let mut t = t0;
    t.span = u.mkspan(L.f.id, @int_cast(u32, start), @int_cast(u32, L.i));
    t.bol = L.bol;
    t.space = L.space;
    if u.isnos(t.text) {
        t.text = u.dup(L.s[start..L.i]);
    }
    L.toks.push(t);
    L.bol = false;
    L.space = false;
}

fn lex_error(L: *mut Lex, start: usize, msg: []u8) void {
    _ = dg.err(u.mkspan(L.f.id, @int_cast(u32, start), @int_cast(u32, L.i)), "C1001", msg);
}

// One character of a character constant or string literal (an escape
// sequence, or a UTF-8 sequence decoded unless `bytes`), as a value.
fn char_value(L: *mut Lex, bytes: bool) u32 {
    let c = at(L, 0);
    if c != '\\' {
        L.i += 1;
        if bytes or (c < 0x80) {
            return @as(u32, c);
        }
        // a UTF-8 sequence
        let mut n: usize = 0;
        let mut v: u32 = 0;
        if (c & 0xE0) == 0xC0 {
            n = 1;
            v = @as(u32, c & 0x1F);
        } else if (c & 0xF0) == 0xE0 {
            n = 2;
            v = @as(u32, c & 0x0F);
        } else {
            n = 3;
            v = @as(u32, c & 0x07);
        }
        for k in 0..n {
            _ = k;
            let d = at(L, 0);
            if (d & 0xC0) != 0x80 {
                break;
            }
            v = (v << 6) | @as(u32, d & 0x3F);
            L.i += 1;
        }
        return v;
    }
    L.i += 1;
    let e = at(L, 0);
    L.i += 1;
    if e == 'n' {
        return 10;
    }
    if e == 't' {
        return 9;
    }
    if e == 'r' {
        return 13;
    }
    if e == 'a' {
        return 7;
    }
    if e == 'b' {
        return 8;
    }
    if e == 'f' {
        return 12;
    }
    if e == 'v' {
        return 11;
    }
    if (e >= '0') and (e <= '7') {
        let mut v = @as(u32, e - '0');
        let mut n: i32 = 1;
        while (n < 3) and (at(L, 0) >= '0') and (at(L, 0) <= '7') {
            v = (v * 8) + @as(u32, at(L, 0) - '0');
            L.i += 1;
            n += 1;
        }
        return v;
    }
    if e == 'x' {
        let mut v: u32 = 0;
        while hexval(at(L, 0)) >= 0 {
            v = (v *% 16) + @int_cast(u32, hexval(at(L, 0)));
            L.i += 1;
        }
        return v;
    }
    return @as(u32, e);
}

fn lex_quoted(L: *mut Lex, start: usize, prefix: i32) void {
    let q = at(L, 0);
    L.i += 1;
    let bytes = (prefix == ct.ENC_NONE) or (prefix == ct.ENC_UTF8);
    let mut units = u.List.[u32].empty();
    while (L.i < L.s.len) and (at(L, 0) != q) and (at(L, 0) != '\n') {
        let v = char_value(L, bytes);
        if (prefix == ct.ENC_UTF16) and (v >= 0x10000) {
            units.push(0xD800 + ((v - 0x10000) >> 10));
            units.push(0xDC00 + ((v - 0x10000) & 0x3FF));
        } else {
            units.push(v);
        }
    }
    if at(L, 0) != q {
        lex_error(L, start, u.pick(q == '"', "missing terminating '\"'", "missing terminating '''"));
    } else {
        L.i += 1;
    }
    let mut t: ct.Token = undefined;
    t.prefix = prefix;
    if q == '\'' {
        t.kind = ct.T_CHAR;
        let us = units.items();
        let mut v: u64 = 0;
        for x in us {
            v = (v << 8) | @as(u64, x);
        }
        if (prefix != ct.ENC_NONE) and (us.len > 0) {
            v = @as(u64, us[0]);
        }
        t.ival = v;
        push(L, t, start);
        return;
    }
    // adjacent string literals are joined
    let n = L.toks.len;
    if (n > 0) and (L.toks.at(n - 1).kind == ct.T_STRING) {
        let p = L.toks.at(n - 1);
        let mut all = u.List.[u32].empty();
        for x in p.units {
            all.push(x);
        }
        for x in units.items() {
            all.push(x);
        }
        p.units = all.items();
        if p.prefix == ct.ENC_NONE {
            p.prefix = prefix;
        }
        p.span.end = @int_cast(u32, L.i);
        p.text = u.dup(L.s[@as(usize, p.span.start)..L.i]);
        return;
    }
    t.kind = ct.T_STRING;
    t.units = units.items();
    push(L, t, start);
}

fn lex_number(L: *mut Lex, start: usize) void {
    let mut is_float = false;
    let mut base: i32 = 10;
    if (at(L, 0) == '0') and ((at(L, 1) == 'x') or (at(L, 1) == 'X')) {
        base = 16;
        L.i += 2;
    } else if (at(L, 0) == '0') and ((at(L, 1) == 'b') or (at(L, 1) == 'B')) {
        base = 2;
        L.i += 2;
    } else if at(L, 0) == '0' {
        base = 8;
    }
    let ds = L.i;
    // a preprocessing number: digits, letters, '.', '\'' and exponent signs
    while L.i < L.s.len {
        let c = at(L, 0);
        if (c == '.') {
            is_float = true;
            L.i += 1;
        } else if ((c == '+') or (c == '-')) and
                  ((L.s[L.i - 1] == 'e') or (L.s[L.i - 1] == 'E') or (L.s[L.i - 1] == 'p') or (L.s[L.i - 1] == 'P')) {
            L.i += 1;
        } else if is_ident_char(c) or ((c == '\'') and is_ident_char(at(L, 1))) {
            if (base != 16) and ((c == 'e') or (c == 'E')) {
                is_float = true;
            }
            if (base == 16) and ((c == 'p') or (c == 'P')) {
                is_float = true;
            }
            L.i += 1;
        } else {
            break;
        }
    }
    let text = L.s[start..L.i];
    let mut t: ct.Token = undefined;
    if is_float {
        t.kind = ct.T_FLOAT;
        let mut e = text.len;
        let last = text[e - 1];
        if (last == 'f') or (last == 'F') {
            t.fsuffix = 1;
            e -= 1;
        } else if (last == 'l') or (last == 'L') {
            t.fsuffix = 2;
            e -= 1;
        }
        let mut b = u.Buf.init();
        for c in text[0..e] {
            if c != '\'' {
                b.c(c);
            }
        }
        if base == 10 {
            t.fval = u.parse_f64(b.done());
        }
        push(L, t, start);
        return;
    }
    t.kind = ct.T_INT;
    if (base == 8) and ((L.i - ds) == 1) {
        base = 10;
    }
    t.base = base;
    let mut v: u64 = 0;
    let mut k = ds;
    if base == 8 {
        k += 1;
    }
    while k < L.i {
        let c = L.s[k];
        if c == '\'' {
            k += 1;
            continue;
        }
        let d = hexval(c);
        if (d < 0) or (d >= base) {
            break;
        }
        v = (v *% @as(u64, @int_cast(u32, base))) +% @as(u64, @int_cast(u32, d));
        k += 1;
    }
    t.ival = v;
    // the suffix
    while k < L.i {
        let c = L.s[k];
        if (c == 'u') or (c == 'U') {
            t.unsigned_ = true;
            k += 1;
        } else if (c == 'l') or (c == 'L') {
            t.longs += 1;
            k += 1;
        } else if ((c == 'w') or (c == 'W')) and ((k + 1) < L.i) {
            t.bitint = true;
            k += 2;
        } else {
            lex_error(L, start, u.f1("invalid suffix on integer constant '%s'", text));
            break;
        }
    }
    push(L, t, start);
}

// The punctuators, longest first.
let PUNCTS: [53][]u8 = ["...", "<<=", ">>=", "->", "++", "--", "<<", ">>", "<=", ">=", "==", "!=", "&&", "||", "*=",
                        "/=", "%=", "+=", "-=", "&=", "^=", "|=", "::", "<:", ":>", "<%", "%>", "[", "]", "(", ")", "{",
                        "}", ".", "&", "*", "+", "-", "~", "!", "/", "%", "<", ">", "^", "|", "?", ":", ";", "=", ",",
                        "#", "@"];
let PUNCT_IDS: [53]i32 = [
    ct.P_ELLIPSIS,
    ct.P_SHL_EQ,
    ct.P_SHR_EQ,
    ct.P_ARROW,
    ct.P_INC,
    ct.P_DEC,
    ct.P_SHL,
    ct.P_SHR,
    ct.P_LE,
    ct.P_GE,
    ct.P_EQ,
    ct.P_NE,
    ct.P_ANDAND,
    ct.P_OROR,
    ct.P_MUL_EQ,
    ct.P_DIV_EQ,
    ct.P_MOD_EQ,
    ct.P_ADD_EQ,
    ct.P_SUB_EQ,
    ct.P_AND_EQ,
    ct.P_XOR_EQ,
    ct.P_OR_EQ,
    ct.P_COLONCOLON,
    ct.P_LBRACKET,
    ct.P_RBRACKET,
    ct.P_LBRACE,
    ct.P_RBRACE,
    ct.P_LBRACKET,
    ct.P_RBRACKET,
    ct.P_LPAREN,
    ct.P_RPAREN,
    ct.P_LBRACE,
    ct.P_RBRACE,
    ct.P_DOT,
    ct.P_AMP,
    ct.P_STAR,
    ct.P_PLUS,
    ct.P_MINUS,
    ct.P_TILDE,
    ct.P_BANG,
    ct.P_SLASH,
    ct.P_PERCENT,
    ct.P_LT,
    ct.P_GT,
    ct.P_CARET,
    ct.P_PIPE,
    ct.P_QUESTION,
    ct.P_COLON,
    ct.P_SEMI,
    ct.P_ASSIGN,
    ct.P_COMMA,
    0,
    0,
];

fn lex_punct(L: *mut Lex, start: usize) void {
    for k in 0..PUNCTS.len {
        let p = PUNCTS[k];
        if (L.i + p.len) > L.s.len {
            continue;
        }
        if not @mem_eq(L.s[L.i..L.i + p.len], p) {
            continue;
        }
        // `::` is one token only in C23; digraphs from C95
        if (PUNCT_IDS[k] == ct.P_COLONCOLON) and (L.std < co.C23) {
            continue;
        }
        if (p.len == 2) and (L.std < co.C95) and ((p[0] == '<') or (p[0] == '%') or (p[1] == '>')) and
           not u.str_eq(p, "->") and not u.str_eq(p, "<=") and not u.str_eq(p, ">=") and not u.str_eq(p, "<<") and
           not u.str_eq(p, ">>") and not u.str_eq(p, "%=") {
            continue;
        }
        L.i += p.len;
        if PUNCT_IDS[k] == 0 {
            lex_error(L, start, u.f1("stray '%s' in program", p));
            return;
        }
        let mut t: ct.Token = undefined;
        t.kind = ct.T_PUNCT;
        t.id = PUNCT_IDS[k];
        t.text = p;
        push(L, t, start);
        return;
    }
    L.i += 1;
    lex_error(L, start, "stray character in program");
}

/// The tokens of the file at `path`, ending with T_EOF (see the header).
pub fn tokenize(path: []u8, o: *co.COptions) u.List.[ct.Token] {
    let mut L = Lex.{
        f: u.load_file(path, u.nosym()),
        s: u.nosym(),
        i: 0,
        std: o.std,
        bol: true,
        space: false,
        toks: u.List.[ct.Token].empty(),
    };
    if u.isnil(L.f) {
        _ = dg.err(u.mkspan(0, 0, 0), "C1001", u.f1("cannot read '%s'", path));
        let mut t: ct.Token = undefined;
        L.toks.push(t);
        return L.toks;
    }
    L.s = L.f.text;
    while L.i < L.s.len {
        let c = at(&L, 0);
        let start = L.i;
        if c == '\n' {
            L.bol = true;
            L.i += 1;
            continue;
        }
        if (c == ' ') or (c == '\t') or (c == '\r') or (c == 12) or (c == 11) {
            L.space = true;
            L.i += 1;
            continue;
        }
        if (c == '\\') and (at(&L, 1) == '\n') {
            L.i += 2;
            continue;
        }
        if (c == '#') and L.bol {
            while (L.i < L.s.len) and (at(&L, 0) != '\n') {
                L.i += 1;
            }
            continue;
        }
        if (c == '/') and (at(&L, 1) == '/') {
            while (L.i < L.s.len) and (at(&L, 0) != '\n') {
                L.i += 1;
            }
            continue;
        }
        if (c == '/') and (at(&L, 1) == '*') {
            L.i += 2;
            while (L.i < L.s.len) and not ((at(&L, 0) == '*') and (at(&L, 1) == '/')) {
                L.i += 1;
            }
            if L.i >= L.s.len {
                lex_error(&mut L, start, "unterminated comment");
            } else {
                L.i += 2;
            }
            L.space = true;
            continue;
        }
        // prefixes of character constants and string literals
        let mut prefix: i32 = -1;
        let mut plen: usize = 0;
        if (c == 'u') and (at(&L, 1) == '8') and ((at(&L, 2) == '"') or (at(&L, 2) == '\'')) {
            prefix = ct.ENC_UTF8;
            plen = 2;
        } else if ((c == 'u') or (c == 'U') or (c == 'L')) and ((at(&L, 1) == '"') or (at(&L, 1) == '\'')) {
            plen = 1;
            if c == 'u' {
                prefix = ct.ENC_UTF16;
            } else if c == 'U' {
                prefix = ct.ENC_UTF32;
            } else {
                prefix = ct.ENC_WIDE;
            }
        }
        if prefix >= 0 {
            L.i += plen;
            lex_quoted(&mut L, start, prefix);
            continue;
        }
        if (c == '"') or (c == '\'') {
            lex_quoted(&mut L, start, ct.ENC_NONE);
            continue;
        }
        if is_ident_start(c) {
            while (L.i < L.s.len) and is_ident_char(at(&L, 0)) {
                L.i += 1;
            }
            let name = u.intern(L.s[start..L.i]);
            let mut t: ct.Token = undefined;
            t.text = name;
            let kw = ct.keyword_id(name, L.std);
            if kw != 0 {
                t.kind = ct.T_KEYWORD;
                t.id = kw;
            } else {
                t.kind = ct.T_IDENT;
            }
            push(&mut L, t, start);
            continue;
        }
        if u.is_digit(c) or ((c == '.') and u.is_digit(at(&L, 1))) {
            lex_number(&mut L, start);
            continue;
        }
        lex_punct(&mut L, start);
    }
    let mut t: ct.Token = undefined;
    t.kind = ct.T_EOF;
    t.text = "";
    t.bol = true;
    let e = @int_cast(u32, L.s.len);
    t.span = u.mkspan(L.f.id, e, e);
    L.toks.push(t);
    return L.toks;
}
