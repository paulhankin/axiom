// =============================================================================
// csema_bitint.ax - the bit-precise integer types of C23 (6.2.5p6, 6.7.2):
// the type specifier _BitInt(N) with its width's constraints, and the type
// of an integer constant with a wb or uwb suffix (6.4.4.1p5). The types
// themselves, their ranks and storage, are ctypes.ax's (bitint); BITINT_MAXWIDTH
// is 64, as <limits.h> says.
//
// Diagnostics:
//   C3210  a _BitInt width out of range (at least 2, 1 for unsigned _BitInt; at most BITINT_MAXWIDTH)
//   C3211  an integer constant with a wb or uwb suffix too large for any bit-precise type
// =============================================================================
import "../util.ax" as u;
import "csema.ax" as cs;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;

/// The width of _BitInt(e) as an i32, from e's value v (signed: sg), with
/// anything out of range mapped to -1 or BITINT_MAXWIDTH + 1.
pub fn width_value(v: u64, sg: bool) i32 {
    if sg and (@bit_cast(i64, v) < 0) {
        return -1;
    }
    if v > @as(u64, @bit_cast(u32, cty.BITINT_MAXWIDTH)) {
        return cty.BITINT_MAXWIDTH + 1;
    }
    return @truncate(i32, @bit_cast(i64, v));
}

/// _BitInt(n) (sg) or unsigned _BitInt(n), or the error type when n is out
/// of range (reported at sp). A width of 0 is one already reported.
pub fn bitint_type(n: i32, sg: bool, sp: u.Span) *mut cty.CType {
    let mut least: i32 = 1;
    if sg {
        least = 2;
    }
    if (n < least) or (n > cty.BITINT_MAXWIDTH) {
        let what = u.pick(sg, "_BitInt", "unsigned _BitInt");
        let mut shown = u.idec(n);
        if n > cty.BITINT_MAXWIDTH {
            shown = "more than BITINT_MAXWIDTH";
        } else if n < 0 {
            shown = "negative";
        }
        cs.err(sp, "C3210", u.f4("the width of %s is %s; it must be from %s to BITINT_MAXWIDTH (%s)", what, shown,
                                 u.idec(least), u.idec(cty.BITINT_MAXWIDTH)));
        return cty.t_error;
    }
    return cty.bitint(n, sg);
}

// The number of bits value v needs (0 for 0).
fn bit_length(v: u64) i32 {
    let mut n: i32 = 0;
    let mut x = v;
    while x != 0 {
        n += 1;
        x = x >> 1;
    }
    return n;
}

/// The type of integer constant t with a wb suffix (_BitInt of the least
/// width, at least 2, that holds its value, which is not negative) or uwb
/// (unsigned _BitInt of the least width, at least 1); the error type if
/// there is none (reported at sp).
pub fn const_type(t: *ct.Token, sp: u.Span) *mut cty.CType {
    let mut n = bit_length(t.ival);
    if t.unsigned_ {
        if n == 0 {
            n = 1;
        }
    } else {
        n += 1;
        if n < 2 {
            n = 2;
        }
    }
    if n > cty.BITINT_MAXWIDTH {
        cs.err(sp, "C3211",
               u.f2(
                   "the integer constant %s is too large for %s", t.text,
                   u.pick(t.unsigned_, "unsigned _BitInt(BITINT_MAXWIDTH)", "_BitInt(BITINT_MAXWIDTH)")));
        return cty.t_error;
    }
    return cty.bitint(n, not t.unsigned_);
}
