// =============================================================================
// csema_dspec.ax - storage-class, alignment, bit-field, constexpr, auto and
// standard attribute checking (6.7.1, 6.7.5, 6.7.10, 6.7.13), part of csema.ax.
// =============================================================================
import "../util.ax" as u;
import "cast.ax" as cast;
import "cfeat.ax" as cf;
import "copts.ax" as co;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;

/// The strictest alignment an alignment specifier may ask for.
pub const MAX_ALIGN: u64 = 4096;

/// Set while the type name of a compound literal is analyzed (it declares
/// an object: an alignment specifier may stand in it).
/// The alignment an alignment specifier in that type name asks for (0: none).
// -----------------------------------------------------------------------------
// Storage-class specifiers (6.7.1)
// -----------------------------------------------------------------------------

/// What the storage-class specifiers of a declaration say.
pub struct Storage {
    pub sc: i32,           // the one that decides storage and linkage (a cast.SC_ bit), or 0
    pub constexpr_: bool,  // constexpr (C23)
    pub infer_: bool,      // auto without a type specifier (C23): the type is the initializer's
}

fn bit_count(x: i32) i32 {
    let mut n: i32 = 0;
    let mut v = x;
    while v != 0 {
        n += v & 1;
        v = v >> 1;
    }
    return n;
}

/// The storage-class specifiers `bits` (cast.SC_ bits, without thread_local)
/// of declaration specifiers ds, checked: at most one, except as C23 allows.
pub fn storage(bits: i32, ds: *cast.DeclSpec) Storage {
    let mut r = Storage.{ sc: bits, constexpr_: false, infer_: false };
    if bits == 0 {
        return r;
    }
    if std() < co.C23 {
        if bit_count(bits) > 1 {
            err(ds.span, "C3006", "more than one storage-class specifier");
            r.sc = lowest(bits);
        }
        return r;
    }
    let mut rest = bits;
    if (bits & cast.SC_AUTO) != 0 {
        if (bits & cast.SC_TYPEDEF) != 0 {
            err(ds.span, "C3006", "'auto' cannot be combined with 'typedef'");
        }
        r.infer_ = not ds.has_type;
        if r.infer_ or (bits != cast.SC_AUTO) {
            rest = rest & ~cast.SC_AUTO;  // (it only asks for the type to be inferred)
        }
    }
    if (rest & cast.SC_CONSTEXPR) != 0 {
        r.constexpr_ = true;
        rest = rest & ~cast.SC_CONSTEXPR;
        let bad = rest & ~(cast.SC_STATIC | cast.SC_REGISTER | cast.SC_AUTO);
        if bad != 0 {
            err(ds.span, "C3073", u.f1("'constexpr' cannot be combined with '%s'", sc_name(lowest(bad))));
            r.constexpr_ = false;
        }
    }
    if bit_count(rest) > 1 {
        err(ds.span, "C3006", "more than one storage-class specifier");
        rest = lowest(rest);
    }
    r.sc = rest;
    return r;
}

fn lowest(x: i32) i32 {
    return x & -x;
}

/// The keyword of a storage-class specifier bit.
pub fn sc_name(b: i32) []u8 {
    if b == cast.SC_TYPEDEF {
        return "typedef";
    }
    if b == cast.SC_EXTERN {
        return "extern";
    }
    if b == cast.SC_STATIC {
        return "static";
    }
    if b == cast.SC_AUTO {
        return "auto";
    }
    if b == cast.SC_REGISTER {
        return "register";
    }
    if b == cast.SC_THREAD_LOCAL {
        return u.pick(std() >= co.C23, "thread_local", "_Thread_local");
    }
    return "constexpr";
}

/// Checks thread_local in specifiers ds with storage s (6.7.1p3-4):
/// with static or extern only, and in a block only with one of them;
/// block: the declaration is in a block; param: a parameter's.
pub fn thread_local(ds: *cast.DeclSpec, s: Storage, block: bool, param: bool) void {
    let tl = sc_name(cast.SC_THREAD_LOCAL);
    if param {
        err(ds.span, "C3076", u.f1("a parameter cannot be declared '%s'", tl));
        return;
    }
    if s.constexpr_ {
        err(ds.span, "C3073", u.f1("'constexpr' cannot be combined with '%s'", tl));
        return;
    }
    if (s.sc != 0) and (s.sc != cast.SC_STATIC) and (s.sc != cast.SC_EXTERN) {
        err(ds.span, "C3076", u.f2("'%s' cannot be combined with '%s'", tl, sc_name(s.sc)));
        return;
    }
    if block and (s.sc == 0) {
        err(ds.span, "C3076", u.f1("an object declared '%s' in a block must also be 'static' or 'extern'", tl));
    }
}

// -----------------------------------------------------------------------------
// Alignment specifiers (6.7.5)
// -----------------------------------------------------------------------------

/// The alignment that alignment specifier s asks for (0: none, or an error,
/// reported).
pub fn alignment(s: *mut cast.Spec) u64 {
    let what = u.pick(std() >= co.C23, "alignas", "_Alignas");
    if u.notnil(s.tname) {
        let t = type_name(s.tname);
        if cty.is_error(t) {
            return 0;
        }
        let ok = cty.is_complete(t) or ((t.kind == cty.TK_ARRAY) and cty.is_complete(t.elem));
        if not ok {
            err(s.span, "C3071", u.f2("the type in '%s' is %s, not a complete object type", what, tq(t)));
            return 0;
        }
        return cty.align_of(t);
    }
    let r = ice(s.e, u.f1("the alignment in '%s'", what));
    s.e = r.e;
    if not r.ok {
        return 0;
    }
    let v = r.v;
    if r.e.ty.is_signed and (@bit_cast(i64, v) < 0) {
        err(s.e.span, "C3071", u.f1("the alignment %s is negative", u.dec(@bit_cast(i64, v))));
        return 0;
    }
    if v == 0 {
        return 0;  // (no effect)
    }
    if (v & (v - 1)) != 0 {
        err(s.e.span, "C3071", u.f1("the alignment %s is not a power of two", u.udec(v)));
        return 0;
    }
    if v > MAX_ALIGN {
        err(s.e.span, "C3071", u.f2("the alignment %s is larger than the largest supported (%s)", u.udec(v),
                                    u.udec(MAX_ALIGN)));
        return 0;
    }
    return v;
}

/// Checks the alignment `a` the specifiers ask for (at sp) against the type
/// t of the object or member `name` (6.7.5p4: not less strict than t's).
pub fn check_alignment(a: u64, sp: u.Span, t: *mut cty.CType, name: []u8) bool {
    if a == 0 or cty.is_error(t) {
        return true;
    }
    let mut nat = cty.align_of(t);
    if (t.kind == cty.TK_ARRAY) and not t.has_len {
        nat = cty.align_of(t.elem);
    }
    if a < nat {
        err(sp, "C3071", u.f3("the alignment %s is less strict than the alignment of '%s', %s", u.udec(a), name,
                              u.udec(nat)));
        return false;
    }
    return true;
}

/// An alignment specifier where none may be (6.7.5p2): `what` names it.
pub fn misplaced_alignment(sp: u.Span, what: []u8) void {
    err(sp, "C3071", u.f1("an alignment specifier in %s", what));
}

// -----------------------------------------------------------------------------
// Bit-fields (6.7.2.1p4-5)
// -----------------------------------------------------------------------------

// The width of integer type t's objects in bits (_Bool: 1).
fn type_width(t: *cty.CType) i32 {
    if t.unq.kind == cty.TK_BOOL {
        return 1;
    }
    return t.bits;
}

/// The width of bit-field declarator d of type t, checked; -1 after an
/// error (reported).
pub fn bit_width(t: *mut cty.CType, d: *mut cast.Declarator) i32 {
    let name = u.pick(d.name.len > 0, u.f1("the bit-field '%s'", d.name), "an unnamed bit-field");
    let r = ice(d.width, u.f1("the width of %s", name));
    d.width = r.e;
    if cty.is_error(t) {
        return -1;
    }
    if not cty.is_integer(t) {
        err(d.span, "C3070", u.f2("%s has type %s, not an integer type", name, tq(t)));
        return -1;
    }
    if (t.quals & cty.Q_ATOMIC) != 0 {
        // (6.7.2.1p5: whether atomic types are permitted for bit-fields is
        // implementation-defined; they are not)
        err(d.span, "C3070", u.f2("%s has atomic type %s", name, tq(t)));
        return -1;
    }
    let k = t.unq.kind;
    // (gnu89 takes the other integer types too, as C99 6.7.2.1p4 lets an
    // implementation)
    if (std() < co.C99) and not opts().gnu {
        if (k != cty.TK_INT) and (k != cty.TK_UINT) {
            err(d.span, "C3070", u.f2("%s has type %s (before C99: int, signed int or unsigned int)", name, tq(t)));
            return -1;
        }
    }
    if not r.ok {
        return -1;
    }
    let v = r.v;
    if r.e.ty.is_signed and (@bit_cast(i64, v) < 0) {
        err(r.e.span, "C3070", u.f2("the width of %s is negative (%s)", name, u.dec(@bit_cast(i64, v))));
        return -1;
    }
    let tw = type_width(t);
    if v > @as(u64, @bit_cast(u32, tw)) {
        err(r.e.span, "C3070", u.f4("the width of %s is %s, more than the width of %s (%s)", name, u.udec(v), tq(t),
                                    u.idec(tw)));
        return -1;
    }
    if (v == 0) and (d.name.len > 0) {
        err(r.e.span, "C3070", u.f1("%s has width 0 (only an unnamed bit-field can)", name));
        return -1;
    }
    return @bit_cast(i32, @truncate(u32, v));
}

// -----------------------------------------------------------------------------
// constexpr objects (C23 6.7.1p5-6)
// -----------------------------------------------------------------------------

/// Checks the type t of an object declared constexpr (at sp): no volatile,
/// restrict or atomic type, in any of its members either.
pub fn constexpr_type(t: *mut cty.CType, sp: u.Span) bool {
    if (t.quals & (cty.Q_VOLATILE | cty.Q_RESTRICT | cty.Q_ATOMIC)) != 0 {
        err(sp, "C3073", u.f1("an object declared 'constexpr' has type %s (volatile, restrict or atomic)", tq(t)));
        return false;
    }
    if t.kind == cty.TK_ARRAY {
        if t.vla {
            err(sp, "C3073", "an object declared 'constexpr' has a variable length array type");
            return false;
        }
        return constexpr_type(t.elem, sp);
    }
    if cty.is_record(t) and t.tag.complete {
        for m in t.unq.tag.members.items() {
            if not constexpr_type(m.ty, sp) {
                return false;
            }
        }
    }
    return true;
}

// -----------------------------------------------------------------------------
// Type inference (C23 6.7.10)
// -----------------------------------------------------------------------------

/// The type of declarator d of a declaration with `auto` and no type
/// specifier, whose other specifiers add qualifiers quals: its
/// initializer's (after lvalue conversion, unqualified); the error type
/// after an error (reported). `several`: the declaration has more than one
/// declarator (reported at the first).
pub fn inferred(d: *mut cast.Declarator, quals: i32, several: bool, first: bool) *mut cty.CType {
    if several {
        if first {
            err(d.name_span, "C3074", "a declaration whose type is inferred ('auto') can only have one declarator");
        }
        return cty.t_error;
    }
    if d.derivs.len > 0 {
        err(d.name_span, "C3074",
            u.f1("'%s' has its type inferred ('auto'), and its declarator must be the identifier alone", d.name));
        return cty.t_error;
    }
    if u.isnil(d.init) {
        err(d.name_span, "C3074", u.f1("'%s' has its type inferred ('auto') but no initializer", d.name));
        return cty.t_error;
    }
    if d.init.kind != cast.InitKind.EXPR {
        err(d.init.span, "C3074",
            u.f1("'%s' has its type inferred ('auto'): its initializer must be an expression, not a list", d.name));
        return cty.t_error;
    }
    let x = rv(d.init.e);
    if u.isnil(x.ty) or cty.is_error(x.ty) {
        return cty.t_error;
    }
    if cty.is_void(x.ty) {
        err(x.span, "C3074", u.f1("the initializer of '%s' (whose type is inferred) has type void", d.name));
        return cty.t_error;
    }
    return cty.qualify(cty.unqual(x.ty), quals);
}

// -----------------------------------------------------------------------------
// Attributes (C23 6.7.13)
// -----------------------------------------------------------------------------

/// What attributes appertain to.
pub const AP_OBJECT: i32 = 1;       // an object (a parameter too)
pub const AP_FUNC: i32 = 2;         // a function
pub const AP_TYPEDEF: i32 = 3;      // a typedef name
pub const AP_TAG: i32 = 4;          // a structure, union or enumeration (after the keyword)
pub const AP_MEMBER: i32 = 5;       // a member of a structure or union
pub const AP_ENUMERATOR: i32 = 6;   // an enumeration constant
pub const AP_TYPE: i32 = 7;         // a type: after declaration specifiers, '*' or an array declarator's ']'
pub const AP_FUNCTYPE: i32 = 8;     // a function type: after a function declarator's ')'
pub const AP_LABEL: i32 = 9;        // a label
pub const AP_STMT: i32 = 10;        // a statement
pub const AP_NOTHING: i32 = 11;     // an attribute declaration at file scope
pub const AP_BLOCK_DECL: i32 = 12;  // an attribute declaration in a block (fallthrough's place)
pub const AP_TYPE_NAME: i32 = 13;   // a type name's type: in its specifiers or its abstract declarator

// The attribute's name without the `__x__` spelling.
// What a standard attribute may appertain to (6.7.13), for messages:
// empty if `what` is one of them.
fn misplaced(n: []u8, what: i32) []u8 {
    let entity = (what == AP_OBJECT) or (what == AP_FUNC) or (what == AP_TYPEDEF) or (what == AP_TAG) or
                 (what == AP_MEMBER) or (what == AP_ENUMERATOR);
    if u.str_eq(n, "deprecated") {
        if entity {
            return "";
        }
        return "a declaration of an object, function, typedef name, member, enumeration constant or tag";
    }
    if u.str_eq(n, "maybe_unused") {
        if entity or (what == AP_LABEL) {
            return "";
        }
        return "a declaration of an object, function, typedef name, member, enumeration constant, tag or label";
    }
    if u.str_eq(n, "nodiscard") {
        if (what == AP_FUNC) or (what == AP_TAG) {
            return "";
        }
        return "a declaration of a function, or a structure, union or enumeration";
    }
    if u.str_eq(n, "noreturn") or u.str_eq(n, "_Noreturn") {
        if what == AP_FUNC {
            return "";
        }
        return "a declaration of a function";
    }
    if u.str_eq(n, "unsequenced") or u.str_eq(n, "reproducible") {
        if (what == AP_FUNCTYPE) or (what == AP_TYPE) or (what == AP_TYPE_NAME) {
            return "";
        }
        return "a function declarator or a type specifier of a function type";
    }
    if u.str_eq(n, "fallthrough") {
        if what == AP_BLOCK_DECL {
            return "";
        }
        return "a null statement before a case or default label (an attribute declaration)";
    }
    return "";
}

/// Checks the attributes `list` (appertaining to `what`, an AP_ constant):
/// a standard attribute's argument clause and what it may appertain to.
/// Attributes with a prefix are ignored; others without one are ignored
/// with a warning.
/// The entity whose attributes are checked has a function type in its
/// declarator (a pointer to a function, a member, a typedef): the GNU
/// attributes of functions are taken there too (csema_gnu.check), as the
/// GNU compilers apply them to the function type (format on a member that
/// points to a printf-like function).
pub fn attrs(list: *u.List.[*mut cast.Attr], what: i32) void {
    for a in list.items() {
        if u.str_eq(a.prefix, "gnu") or u.str_eq(a.prefix, "__axiom") {
            gnu_check(a, what);
            continue;
        }
        if a.prefix.len > 0 {
            continue;
        }
        let n = cf.plain(a.name);
        let none = u.str_eq(n, "fallthrough") or u.str_eq(n, "maybe_unused") or u.str_eq(n, "noreturn") or
                   u.str_eq(n, "_Noreturn") or u.str_eq(n, "unsequenced") or u.str_eq(n, "reproducible");
        let str = u.str_eq(n, "deprecated") or u.str_eq(n, "nodiscard");
        if not none and not str {
            attr_unknown(a);
            continue;
        }
        if none and a.has_args {
            err(a.span, "C3077", u.f1("the attribute '%s' takes no arguments", a.name));
        } else if str and a.has_args {
            let ok = (a.args.len == 1) and (a.args[0].kind == ct.T_STRING);
            if not ok {
                err(a.span, "C3077", u.f1("the argument of the attribute '%s' must be a string literal", a.name));
            }
        }
        let where = misplaced(n, what);
        if where.len > 0 {
            if u.str_eq(n, "fallthrough") {
                err(a.span, "C3077", "the attribute 'fallthrough' applies only to a null statement before a case");
            } else if (u.str_eq(n, "noreturn") or u.str_eq(n, "_Noreturn")) and (what == AP_OBJECT) {
                err(a.span, "C3077", u.f1("the attribute '%s' applies only to functions", a.name));
            } else {
                err(a.span, "C3077", u.f2("the attribute '%s' can appertain only to %s", a.name, where));
            }
        }
    }
}
