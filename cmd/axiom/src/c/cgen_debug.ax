// =============================================================================
// cgen_debug.ax - what the debug information (dwarf.ax, through dbginfo.ax)
// is told of a C program at -g: its types, each function's parameters and
// local variables (and their objects, which -O0 keeps in memory: ir.F_VAR),
// its objects of static storage duration, its enumerations' constants, and
// its block scopes (lexical blocks: each instruction carries the one it is
// generated in, ir.Value.scope).
//
// Types are described as they are, and a typedef name as a DW_TAG_typedef:
// a variable, parameter or static object declared with one has it as its
// type (or derived from it: `T *p`), and so does a typedef declared with
// another. A block-scope typedef, structure, union or enumeration is
// described in its block.
// =============================================================================
import "../dbginfo.ax" as dbi;
import "../ir.ax" as ir;
import "../target.ax" as tg;
import "../util.ax" as u;
import "cast.ax" as cast;
import "ctypes.ax" as cty;

// a C type's id (CType.id) -> its dbinfo index + 1
let mut by_id: u.List.[i32] = u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 };
// an enumeration's tag id (TagInfo.id) -> its constants
let mut enum_consts: u.List.[*mut u.List.[*mut cast.CSym]] =
    u.List.[*mut u.List.[*mut cast.CSym]].{ data: @ptr_from_int(*mut *mut u.List.[*mut cast.CSym], 0), len: 0, cap: 0 };
// a symbol (its address) -> the typedef name it was declared with (semantic analysis: note_typedef_use)
let mut tdefs: u.SymMap.[*mut cast.CSym] = u.SymMap.[*mut cast.CSym].{ keys: @ptr_from_int(*mut usize, 0),
                                                                       vals: @ptr_from_int(*mut *mut cast.CSym, 0),
                                                                       cap: 0, len: 0 };
// a typedef (its address) -> its dbinfo index + 1
let mut td_ids: u.SymMap.[i32] = u.SymMap.[i32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0),
                                                  cap: 0, len: 0 };
// an object of static storage duration (its address) -> its index in dbi.globals + 1
let mut static_at: u.SymMap.[i32] = u.SymMap.[i32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0), cap: 0, len: 0 };
// the function being generated: its IR name and its root scope
let mut cur_func: []u8 = "";
let mut root: u32 = 0;

fn on() bool {
    return tg.g_debug == tg.DEBUG_FULL;
}

fn key(s: *cast.CSym) []u8 {
    return u.addr_key(@int_from_ptr(s));
}

// -----------------------------------------------------------------------------
// Semantic analysis: the typedef names declarations use
// -----------------------------------------------------------------------------

/// Object, parameter or typedef s was declared with the typedef name td
/// among its specifiers (nil: none).
pub fn note_typedef_use(s: *cast.CSym, td: *mut cast.CSym) void {
    if on() and u.notnil(td) and u.notnil(s) {
        tdefs.put(key(s), td);
    }
}

/// Records the constants of the enumeration with tag `tag` (csema_dspec).
pub fn note_enum(tag: *cty.TagInfo, consts: []*mut cast.CSym) void {
    if not on() or (tag.id < 0) {
        return;
    }
    let k = @int_cast(usize, tag.id);
    while enum_consts.len <= k {
        enum_consts.push(u.nil.[u.List.[*mut cast.CSym]]());
    }
    let l = u.perm_new.[u.List.[*mut cast.CSym]]();
    for c in consts {
        l.push(c);
    }
    enum_consts.set(k, l);
}

/// Function f is C function s (its result's type).
pub fn note_func(f: *ir.Func, s: *cast.CSym) void {
    if on() and u.notnil(s.ty) and (s.ty.kind == cty.TK_FUNCTION) {
        dbi.note_result(f.name, type_id(s.ty.ret));
    }
}

// -----------------------------------------------------------------------------
// Scopes (lexical blocks): ir.cur_scope while a function is generated
// -----------------------------------------------------------------------------

/// Function f's code begins: its parameters and the variables at the top of
/// its body are in its root scope.
pub fn begin_function(f: *ir.Func) void {
    if not on() {
        return;
    }
    cur_func = f.name;
    root = dbi.add_scope(f.name, 0);
    ir.cur_scope = root;
}

/// The function's code ends.
pub fn end_function() void {
    ir.cur_scope = 0;
    root = 0;
}

// Does declaration d declare something a debugger shows (an identifier, a
// structure, union or enumeration with its members)?
fn declares(d: *cast.Decl) bool {
    if u.isnil(d) or (d.kind != cast.DeclKind.DECL) {
        return false;
    }
    if d.decls.len > 0 {
        return true;
    }
    for x in d.specs.items.items() {
        if (x.kind == cast.SpecKind.TAG) and x.tag.has_body {
            return true;
        }
    }
    return false;
}

/// A block (its items) begins: a lexical block if it declares anything
/// (C 6.8.2: a compound statement is a block). The scope to give back to
/// close_scope.
pub fn open_block(items: []*mut cast.Stmt) u32 {
    let saved = ir.cur_scope;
    if (root == 0) or (saved == 0) {
        return saved;
    }
    for x in items {
        if (x.kind == cast.StmtKind.DECL) and declares(x.decl) {
            ir.cur_scope = dbi.add_scope(cur_func, saved);
            break;
        }
    }
    return saved;
}

/// A for statement with declaration d begins (6.8.5p5: a block).
pub fn open_for(d: *cast.Decl) u32 {
    let saved = ir.cur_scope;
    if (root != 0) and (saved != 0) and declares(d) {
        ir.cur_scope = dbi.add_scope(cur_func, saved);
    }
    return saved;
}

/// The block opened with open_block or open_for ends.
pub fn close_scope(saved: u32) void {
    if root != 0 {
        ir.cur_scope = saved;
    }
}

// The structure, union and enumeration types specifiers ds define are of
// scope sc, and so are those their members' specifiers define (C17 6.2.1p4:
// a tag declared in a member list has the scope of the structure's).
fn scope_tags(ds: *mut cast.DeclSpec, sc: u32) void {
    for x in ds.items.items() {
        if (x.kind == cast.SpecKind.TAG) and x.tag.has_body and u.notnil(x.tag.ty) {
            dbi.set_type_scope(type_id(x.tag.ty), sc);
            for m in x.tag.members.items() {
                if u.notnil(m) and (m.kind == cast.DeclKind.DECL) and u.notnil(m.specs) {
                    scope_tags(m.specs, sc);
                }
            }
        }
    }
}

/// Declaration d is reached in the current block: its typedefs, its
/// structure, union and enumeration types, its static objects are of it.
pub fn note_block_decl(d: *cast.Decl) void {
    if not on() or (ir.cur_scope == 0) or not declares(d) {
        return;
    }
    let sc = ir.cur_scope;
    scope_tags(d.specs, sc);
    for x in d.decls.items() {
        let s = x.sym;
        if u.isnil(s) {
            continue;
        }
        if s.kind == cast.SK_TYPEDEF {
            dbi.set_type_scope(typedef_id(s), sc);
        } else if (s.kind == cast.SK_OBJECT) and (s.duration == cast.SD_STATIC) and (s.linkage == cast.LK_NONE) {
            let k = static_at.get(key(s));
            if k > 0 {
                let g = dbi.globals.at(@int_cast(usize, k - 1));
                g.scope = sc;
                let mut v = g.*;
                v.gidx = k - 1;
                _ = dbi.add_var(cur_func, v);
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Variables
// -----------------------------------------------------------------------------

/// Object `a` (an alloca) holds variable s of function f: it is kept in
/// memory at -O0, and, with -g, described.
pub fn note_var(f: *ir.Func, s: *cast.CSym, a: *mut ir.Value) void {
    note_object(f, s, a, false);
}

/// Object `a` (an alloca) holds the address of variable s of function f (a
/// parameter passed by reference, a variable length array).
pub fn note_indirect(f: *ir.Func, s: *cast.CSym, a: *mut ir.Value) void {
    note_object(f, s, a, true);
}

fn note_object(f: *ir.Func, s: *cast.CSym, a: *mut ir.Value, indirect: bool) void {
    if u.isnil(a) or (a.kind != ir.V_INST) or (a.op != ir.OP_ALLOCA) {
        return;
    }
    a.flags = a.flags | ir.F_VAR;
    if not on() or (s.name.len == 0) {
        return;
    }
    let mut sc = ir.cur_scope;
    if s.is_param or (sc == 0) {
        sc = root;
    }
    _ = dbi.add_var(f.name, dbi.DVar.{ name: s.name, ty: var_type(s), src: src_of(s.span), alloca: a, alloca_id: a.id,
                                       global: u.nil.[ir.Global](), param: s.is_param, external: false, scope: sc,
                                       indirect: indirect, gidx: -1, artificial: false, track: -1, stores: 0,
                                       nstores: 0, seen: false });
}

/// Datum g is the object s of static storage duration (described at the
/// top level; a block-scope one is moved into its block by note_block_decl).
pub fn note_static(f: *ir.Func, s: *cast.CSym, g: *mut ir.Global) void {
    _ = f;
    if not on() or (s.name.len == 0) {
        return;
    }
    if tg.is_wasm() and ((s.flags & cast.CF_THREAD_LOCAL) != 0) {
        return;  // (WebAssembly: g is the main thread's instance only, cgen_tls.ax; no one location)
    }
    let v = dbi.DVar.{ name: s.name, ty: var_type(s), src: src_of(s.span), alloca: u.nil.[ir.Value](), alloca_id: 0,
                       global: g, param: false, external: s.linkage == cast.LK_EXTERNAL, scope: 0, indirect: false,
                       gidx: -1, artificial: false, track: -1, stores: 0, nstores: 0, seen: false };
    dbi.globals.push(v);
    static_at.put(key(s), @int_cast(i32, dbi.globals.len));
}

// The type of variable s: through the typedef name it was declared with.
fn var_type(s: *cast.CSym) i32 {
    let td = tdefs.get(key(s));
    if u.notnil(td) {
        let t = via(s.ty, td.ty, td);
        if t != -2 {
            return t;
        }
    }
    return type_id(s.ty);
}

// Type t, if it is typedef td's type (td_ty) with qualifiers or pointer or
// array derivations added: in terms of the typedef; -2 if not.
fn via(t: *cty.CType, td_ty: *cty.CType, td: *cast.CSym) i32 {
    if u.isnil(t) or u.isnil(td_ty) {
        return -2;
    }
    if t == td_ty {
        return typedef_id(td);
    }
    if (t.quals != 0) and (t.unq == td_ty.unq) and ((t.quals & td_ty.quals) == td_ty.quals) {
        return qualified(t.quals & ~td_ty.quals, typedef_id(td));
    }
    if t.quals != 0 {
        let inner = via(t.unq, td_ty, td);
        if inner == -2 {
            return -2;
        }
        return qualified(t.quals, inner);
    }
    if t.kind == cty.TK_POINTER {
        let inner = via(t.elem, td_ty, td);
        if inner == -2 {
            return -2;
        }
        return dbi.add_type(derived(dbi.DK_POINTER, inner, cty.size_of(t)));
    }
    if (t.kind == cty.TK_ARRAY) and not t.vla {
        let inner = via(t.elem, td_ty, td);
        if inner == -2 {
            return -2;
        }
        let mut d = derived(dbi.DK_ARRAY, inner, 0);
        if t.has_len {
            d.count = @bit_cast(i64, t.len);
            d.size = cty.size_of(t);
        }
        return dbi.add_type(d);
    }
    return -2;
}

// The DW_TAG_typedef of typedef td (made once).
fn typedef_id(td: *cast.CSym) i32 {
    let at = td_ids.get(key(td));
    if at != 0 {
        return at - 1;
    }
    let mut d = derived(dbi.DK_TYPEDEF, -1, 0);
    d.name = td.name;
    d.src = src_of(td.span);
    let id = dbi.add_type(d);
    td_ids.put(key(td), id + 1);
    let target = var_type(td);  // (which may add types: the list moves)
    dbi.types.at(@int_cast(usize, id)).target = target;
    return id;
}

/// The object holding the length of a variable length array type t (as
/// size_t), slot, is kept in memory at -O0 (a debugger reads the type's
/// bound from it).
pub fn note_vla_len(slot: *mut ir.Value) void {
    if u.notnil(slot) and (slot.kind == ir.V_INST) and (slot.op == ir.OP_ALLOCA) {
        slot.flags = slot.flags | ir.F_VAR;
    }
}

/// The objects holding the lengths of variable length array types (by their
/// length expressions: cgen_vla.ax), for the bounds of their descriptions.
pub let mut vla_len_slot: fn(*cty.CType) *mut ir.Value = no_slot;

fn no_slot(t: *cty.CType) *mut ir.Value {
    _ = t;
    return ir.vnil();
}

fn src_of(sp: u.Span) u32 {
    if (sp.file < 0) or (@int_cast(usize, sp.file) >= u.g_files.len) {
        return 0;
    }
    return ir.src_loc(sp.file, u.span_line(sp));
}

fn base(name: []u8, size: u64, enc: u8) dbi.DType {
    return dbi.DType.{ kind: dbi.DK_BASE, name: name, size: size, enc: enc, target: -1, count: -1,
                       members: u.List.[dbi.DMember].empty(), variadic: false, proto: false, complete: true, src: 0,
                       scope: 0, bits: 0, count_var: -1 };
}

fn derived(kind: u8, target: i32, size: u64) dbi.DType {
    let mut t = base("", size, 0);
    t.kind = kind;
    t.target = target;
    return t;
}

/// The dbinfo index of C type t (-1: void).
pub fn type_id(t: *cty.CType) i32 {
    if u.isnil(t) or (t.kind == cty.TK_VOID) or (t.kind == cty.TK_ERROR) {
        if u.notnil(t) and (t.quals != 0) and (t.kind == cty.TK_VOID) {
            return qualified(t.quals, -1);
        }
        return -1;
    }
    let k = @int_cast(usize, @max(t.id, 0));
    while by_id.len <= k {
        by_id.push(0);
    }
    if by_id.get(k) != 0 {
        return by_id.get(k) - 1;
    }
    if t.quals != 0 {
        let id = qualified(t.quals, type_id(t.unq));
        by_id.set(k, id + 1);
        return id;
    }
    let kind = t.kind;
    if (kind == cty.TK_STRUCT) or (kind == cty.TK_UNION) {
        return record(t, k);
    }
    let mut d = base("", cty.size_of(t), 0);
    if kind == cty.TK_POINTER {
        d = derived(dbi.DK_POINTER, -1, cty.size_of(t));
        let id = dbi.add_type(d);
        by_id.set(k, id + 1);          // (before the target: a structure may point to itself)
        let target = type_id(t.elem);  // (which may add types: the list moves)
        dbi.types.at(@int_cast(usize, id)).target = target;
        return id;
    }
    if kind == cty.TK_VECTOR {
        // (a vector: an array of its lanes, as the platforms' compilers
        // describe one, without their vendor attribute)
        d = derived(dbi.DK_ARRAY, type_id(t.elem), 0);
        d.count = @bit_cast(i64, t.len);
        d.size = cty.size_of(t);
    } else if kind == cty.TK_IMAGINARY {
        d = base(u.perm_dup(cty.type_str(t)), cty.size_of(t), dbi.ATE_FLOAT);
    } else if kind == cty.TK_ARRAY {
        d = derived(dbi.DK_ARRAY, type_id(t.elem), 0);
        if t.has_len {
            d.count = @bit_cast(i64, t.len);
            d.size = cty.size_of(t);
        } else if t.vla and (root != 0) {
            // (its length, in its slot: an artificial variable of the
            // function, which the type is described in)
            let slot = vla_len_slot(t);
            if u.notnil(slot) {
                d.count_var = dbi.add_var(cur_func, dbi.DVar.{ name: "", ty: type_id(cty.t_size), src: 0, alloca: slot,
                                                               alloca_id: slot.id, global: u.nil.[ir.Global](),
                                                               param: false, external: false, scope: root,
                                                               indirect: false, gidx: -1, artificial: true, track: -1,
                                                               stores: 0, nstores: 0, seen: false });
                let id = dbi.add_type(d);
                by_id.set(k, id + 1);
                dbi.set_type_scope(id, root);
                return id;
            }
        }
    } else if kind == cty.TK_FUNCTION {
        d = derived(dbi.DK_FUNC, type_id(t.ret), 0);
        d.proto = t.proto;
        d.variadic = t.variadic;
        for p in t.params {
            d.members.push(dbi.DMember.{ name: "", ty: type_id(p), off: 0, bits: 0, bit_off: 0, value: 0,
                                         wide: u.nil_slice.[u64]() });
        }
    } else if kind == cty.TK_ENUM {
        d = enumeration(t);
    } else {
        // (a name made here is kept: the syntax tree's memory is released before the
        // debug information is written)
        d = base(u.perm_dup(base_name(t)), cty.size_of(t), encoding(t));
        if (kind == cty.TK_BITINT) and (@as(u64, @bit_cast(u32, t.bits)) < (8 * d.size)) {
            d.bits = t.bits;  // (DWARF 5, 5.1: DW_AT_bit_size, the value's width in its storage)
        }
    }
    let id = dbi.add_type(d);
    by_id.set(k, id + 1);
    return id;
}

// A qualified version of the type `inner` (t's qualifiers, outermost the
// first of const, volatile, restrict, _Atomic).
fn qualified(quals: i32, inner: i32) i32 {
    let mut id = inner;
    let qs: [4]i32 = [cty.Q_ATOMIC, cty.Q_RESTRICT, cty.Q_VOLATILE, cty.Q_CONST];
    let ks: [4]u8 = [dbi.DK_ATOMIC, dbi.DK_RESTRICT, dbi.DK_VOLATILE, dbi.DK_CONST];
    for j in @as(usize, 0)..4 {
        if (quals & qs[j]) != 0 {
            id = dbi.add_type(derived(ks[j], id, 0));
        }
    }
    return id;
}

// A structure or union: its entry first (its members may point to it).
fn record(t: *cty.CType, k: usize) i32 {
    let tag = t.tag;
    let mut kind = dbi.DK_STRUCT;
    if t.kind == cty.TK_UNION {
        kind = dbi.DK_UNION;
    }
    let mut d = derived(kind, -1, 0);
    d.name = tag.name;
    d.complete = tag.complete;
    d.src = src_of(tag.span);
    if tag.complete {
        d.size = tag.size;
    }
    let id = dbi.add_type(d);
    by_id.set(k, id + 1);
    if not tag.complete {
        return id;
    }
    let mut ms = u.List.[dbi.DMember].empty();
    for m in tag.members.items() {
        let mut x = dbi.DMember.{ name: m.name, ty: type_id(m.ty), off: m.offset, bits: 0, bit_off: 0, value: 0,
                                  wide: u.nil_slice.[u64]() };
        if m.is_bitfield {
            if m.name.len == 0 {
                continue;  // (padding)
            }
            x.bits = m.bit_width;
            x.bit_off = m.bit_off;
        }
        ms.push(x);
    }
    dbi.types.at(@int_cast(usize, id)).members = ms;
    return id;
}

fn enumeration(t: *cty.CType) dbi.DType {
    let tag = t.tag;
    let mut d = derived(dbi.DK_ENUM, -1, cty.size_of(t));
    d.name = tag.name;
    d.complete = tag.complete;
    d.src = src_of(tag.span);
    if u.notnil(tag.base) {
        d.target = type_id(tag.base);
    }
    if (tag.id >= 0) and (@int_cast(usize, tag.id) < enum_consts.len) {
        let l = enum_consts.get(@int_cast(usize, tag.id));
        if u.notnil(l) {
            for c in l.items() {
                d.members.push(
                    dbi.DMember.{ name: c.name, ty: -1, off: 0, bits: 0, bit_off: 0, value: @bit_cast(i64, c.value),
                                  wide: wide_value(c) });
            }
        }
    }
    return d;
}

// An enumeration constant's exact value when it is not a signed 64-bit
// one (its limbs: csema_dspec.ax keeps 192 bits), else empty.
fn wide_value(c: *cast.CSym) []u64 {
    let w = c.wide;
    if w.len < 2 {
        return u.nil_slice.[u64]();
    }
    let sx = @bit_cast(u64, @bit_cast(i64, w[0]) >> 63);  // (the sign of the low limb, extended)
    let mut fits = true;
    for k in 1..w.len {
        fits = fits and (w[k] == sx);
    }
    if fits {
        return u.nil_slice.[u64]();
    }
    // (a copy that outlives the unit's trees; also an unsigned value of 64
    // bits whose top bit is set: dwarf.ax's udata)
    let r = u.perm_newn.[u64](w.len);
    for k in 0..w.len {
        r[k] = w[k];
    }
    return r;
}

fn base_name(t: *cty.CType) []u8 {
    let k = t.kind;
    if k == cty.TK_BOOL {
        return "_Bool";
    }
    if k == cty.TK_CHAR {
        return "char";
    }
    if k == cty.TK_SCHAR {
        return "signed char";
    }
    if k == cty.TK_UCHAR {
        return "unsigned char";
    }
    if k == cty.TK_SHORT {
        return "short";
    }
    if k == cty.TK_USHORT {
        return "unsigned short";
    }
    if k == cty.TK_INT {
        return "int";
    }
    if k == cty.TK_UINT {
        return "unsigned int";
    }
    if k == cty.TK_LONG {
        return "long";
    }
    if k == cty.TK_ULONG {
        return "unsigned long";
    }
    if k == cty.TK_LLONG {
        return "long long";
    }
    if k == cty.TK_ULLONG {
        return "unsigned long long";
    }
    if k == cty.TK_FLOAT {
        return "float";
    }
    if k == cty.TK_DOUBLE {
        return "double";
    }
    if k == cty.TK_LDOUBLE {
        return "long double";
    }
    if k == cty.TK_NULLPTR {
        return "nullptr_t";
    }
    if k == cty.TK_COMPLEX {
        return u.f1("%s _Complex", base_name(t.elem));
    }
    if k == cty.TK_BITINT {
        return u.f2("%s_BitInt(%s)", u.pick(t.is_signed, "", "unsigned "), u.idec(t.bits));
    }
    if k == cty.TK_INT128 {
        return "__int128";
    }
    if k == cty.TK_UINT128 {
        return "unsigned __int128";
    }
    if cty.is_decimal(t) {
        return cty.type_str(t);
    }
    if cty.is_floating(t) {
        return cty.type_str(t);  // (_Float16 ... _Float64x)
    }
    return "?";
}

fn encoding(t: *cty.CType) u8 {
    let k = t.kind;
    if k == cty.TK_BOOL {
        return dbi.ATE_BOOLEAN;
    }
    if cty.is_floating(t) {
        return dbi.ATE_FLOAT;
    }
    if (k == cty.TK_COMPLEX) and cty.is_integer(t.elem) {
        return dbi.ATE_COMPLEX_INT;  // (a GNU dialect's _Complex int ...)
    }
    if k == cty.TK_COMPLEX {
        return dbi.ATE_COMPLEX_FLOAT;
    }
    if cty.is_decimal(t) {
        return dbi.ATE_DECIMAL_FLOAT;
    }
    if (k == cty.TK_CHAR) or (k == cty.TK_SCHAR) or (k == cty.TK_UCHAR) {
        if t.is_signed {
            return dbi.ATE_SIGNED_CHAR;
        }
        return dbi.ATE_UNSIGNED_CHAR;
    }
    if (k == cty.TK_NULLPTR) or not t.is_signed {
        return dbi.ATE_UNSIGNED;
    }
    return dbi.ATE_SIGNED;
}
