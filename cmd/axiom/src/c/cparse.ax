// =============================================================================
// cparse.ax - the C parser: from the tokens of a translation unit to its
// syntax tree.
// =============================================================================
import "copts.ax" as co;
import "ctok.ax" as ct;

/// Parses the translation unit and returns its tree as text (--emit=c-ast).
/// Errors are reported through diag.ax.
pub fn dump(toks: []ct.Token, o: *co.COptions) []u8 {
    _ = toks;
    _ = o;
    return "";
}
