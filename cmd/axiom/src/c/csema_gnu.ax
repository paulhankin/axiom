// =============================================================================
// csema_gnu.ax - GNU attributes, mode attribute and attribute notes, part of
// csema.ax.
// =============================================================================
import "../target.ax" as tg;
import "../util.ax" as u;
import "cast.ax" as cast;
import "cfeat.ax" as cf;
import "cpragma.ax" as cpg;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;

/// What GNU attributes said of an entity (a CSym, a TagInfo or a Member).
pub struct Note {
    pub section: []u8,
    pub alias: []u8,  // alias("target"): the entity is another name for target
    pub alias_span: u.Span,
    // ifunc("resolver"): the function is an indirect function (ELF's
    // STT_GNU_IFUNC), whose address the resolver, a function the unit
    // defines, returns when the program starts (cgen.ax, note_alias)
    pub ifunc: []u8,
    pub weak: bool,
    pub used: bool,
    pub visibility: i32,  // cpragma.VIS_
    vis_set: bool,        // given by the attribute (else by #pragma GCC visibility)
    pub noinline: bool,
    pub always_inline: bool,
    pub cold: bool,
    pub hot: bool,
    pub opt_level: i32,       // optimize(n): the optimizer's level for the function (-1: the program's)
    opt_attr: bool,           // (the attribute optimize gave opt_level, not a pragma)
    target_attr: []u8,        // (what the attribute target gave, not the pragmas)
    pub target: []u8,         // target("a,b"): the extensions its code may use besides the target's (empty: none)
    pub is_const: bool,       // const: a call reads no memory and writes none (ir.FX_NONE)
    pub is_pure: bool,        // pure: a call writes no memory (ir.FX_READS)
    pub ret_nonnull: bool,    // returns_nonnull: the result is not null (ir.Func.ret_nonnull)
    pub malloc: bool,         // malloc: the result points to an object nothing else points into (ir.Func.allocator)
    pub alloc_size: [2]i32,   // alloc_size(i [, j]): the parameters (from 1; 0: none) whose product is the result's size
    pub alloc_align: i32,     // alloc_align(i): the parameter (from 1) that is the result's alignment, or 0
    pub assume_aligned: u64,  // assume_aligned(n): the result's alignment (0: none)
    pub naked: bool,          // a function whose body is basic asm only: no prologue or epilogue (cgen_asm.ax)
    pub ctor: bool,
    pub ctor_prio: i32,  // 65535 without a priority (after those with one)
    pub dtor: bool,
    pub dtor_prio: i32,
    cleanup: ?*mut cast.CSym,  // an automatic object's cleanup function
    pub nonnull: u64,          // bit k: parameter k + 1 must not be a null pointer
    pub nonnull_all: bool,     // nonnull without indexes: every pointer parameter
    error_msg: []u8,           // error("m"): a call is an error
    warning_msg: []u8,         // warning("m"): a call is warned about
    pub packed: bool,
    pub aligned: u64,
    pub layout: i32,                   // a structure's or union's ms_struct or gcc_struct (cty.LAYOUT_)
    transparent: bool,                 // a union: transparent_union
    format_index: i32,                 // format(archetype, index, first): the format string's parameter (from 1), or 0
    format_kind: i32,                  // ... its archetype (FK_)
    format_first: i32,                 // ... the first argument to check (0: a va_list's)
    format_arg: i32,                   // format_arg(n): the parameter (from 1) the result's format comes from, or 0
    pub cleanup_call: *mut cast.Expr,  // the call `cleanup(&object)`, typed
}

fn gnu_note_at(p: usize) ?*mut Note {
    return g_gnu_notes.get(u.addr_key(p));
}

fn ensure_gnu_note(p: usize) *mut Note {
    let k = u.addr_key(p);
    if let .some(n) = g_gnu_notes.get(k) {
        return n;
    }
    let n = u.new.[Note]();
    n.ctor_prio = 65535;
    n.dtor_prio = 65535;
    n.opt_level = -1;
    g_gnu_notes.put(k, .some(n));
    return n;
}

fn gnu_note_if(p: usize) ?*mut Note {
    if g_gnu_notes.len == 0 {
        return .none;
    }
    return gnu_note_at(p);
}

/// What GNU attributes said of symbol s, or nil.
pub fn note_of(s: *cast.CSym) *mut Note {
    return gnu_note_if(@int_from_ptr(s)) ?? u.nil.[Note]();
}

/// Has function s the attribute cold?
pub fn is_cold(s: *cast.CSym) bool {
    let n = gnu_note_if(@int_from_ptr(s)) ?? return false;
    return n.cold;
}

/// What GNU attributes said of a structure, union or enumeration, or .none.
pub fn note_of_tag(ti: *cty.TagInfo) ?*mut Note {
    return gnu_note_if(@int_from_ptr(ti));
}

/// What GNU attributes said of a member, or .none.
pub fn note_of_member(m: *cty.Member) ?*mut Note {
    return gnu_note_if(@int_from_ptr(m));
}

fn is_gnu(a: *cast.Attr) bool {
    // (__axiom_attribute__, the compiler's headers' spelling: in every mode)
    return (u.str_eq(a.prefix, "gnu") and (opts().gnu or cpg.is_system_file(a.span.file))) or
           u.str_eq(a.prefix, "__axiom");
}

// -----------------------------------------------------------------------------
// Where they may appertain, and their arguments
// -----------------------------------------------------------------------------

fn ignored(a: *cast.Attr, why: []u8) void {
    warn(a.span, "C4052", u.f2("the attribute '%s' %s, and is ignored", a.name, why));
}

fn bad_args(a: *cast.Attr, want: []u8) void {
    err(a.span, "C3077", u.f2("the attribute '%s' takes %s", a.name, want));
}

// The string literal that is the attribute's one argument, or .none.
fn string_arg(a: *cast.Attr) ?[]u8 {
    if not a.has_args or (a.args.len == 0) {
        return .none;
    }
    let mut b = u.Buf.init();
    for &t in a.args {
        if (t.kind != ct.T_STRING) or (t.prefix != ct.ENC_NONE) {
            return .none;
        }
        for x in t.units {
            b.c(@truncate(u8, x));
        }
    }
    return .some(b.done());
}

// The identifier that is the attribute's one argument, or .none.
fn ident_arg(a: *cast.Attr) ?[]u8 {
    if not a.has_args or (a.args.len != 1) or (a.args[0].kind != ct.T_IDENT) {
        return .none;
    }
    return .some(a.args[0].text);
}

// The integer constant expression argument k of an attribute (parsed: exprs);
// ok false after an error (reported).
fn int_arg(a: *mut cast.Attr, k: usize, ok: *mut bool) u64 {
    let r = ice(a.exprs.get(k), u.f1("the argument of the attribute '%s'", a.name));
    a.exprs.set(k, r.e);
    if not r.ok {
        ok.* = false;
        return 0;
    }
    return r.v;
}

// The attributes of functions only.
// The level optimize(...) asks for: 0 to 3 (an integer, or "O0" ... "O3",
// "-O2", "Os" and "Oz" as 2, "Og" and "O" as 1), -1 for options it does not
// know (other strings: ignored), -2 when the argument is none of those forms.
fn opt_level_of(a: *cast.Attr) i32 {
    if a.has_args and (a.args.len == 1) and (a.args[0].kind == ct.T_INT) {
        if a.args[0].ival <= 3 {
            return @truncate(i32, @bit_cast(i64, a.args[0].ival));
        }
        return -2;
    }
    let mut s = string_arg(a) ?? return -2;
    if (s.len > 0) and (s[0] == '-') {
        s = s[1..];
    }
    if u.str_eq(s, "O") or u.str_eq(s, "Og") or u.str_eq(s, "O1") {
        return 1;
    }
    if u.str_eq(s, "Os") or u.str_eq(s, "Oz") or u.str_eq(s, "O2") {
        return 2;
    }
    if u.str_eq(s, "O0") {
        return 0;
    }
    if u.str_eq(s, "O3") {
        return 3;
    }
    return -1;
}

/// Checks GNU attribute a, which appertains to `what` (a AP_ constant):
/// its place and its arguments. In a mode that is no GNU dialect, an
/// attribute with the prefix gnu is a vendor's: ignored.
pub fn gnu_check(a: *mut cast.Attr, what: i32) void {
    if not is_gnu(a) {
        return;
    }
    let n = cf.plain(a.name);
    if not cf.gnu_attribute(n) {
        warn(a.span, "C4052", u.f1("'%s' is not a GNU attribute this compiler knows, and is ignored", a.name));
        return;
    }
    if cf.in_list(n, cf.HINT_ATTRS[..]) {
        return;  // (a hint for the GNU compilers' checks: the code is the same)
    }
    let obj = what == AP_OBJECT;
    let func = what == AP_FUNC;
    let ent = obj or func or (what == AP_TYPEDEF) or (what == AP_TAG) or (what == AP_MEMBER) or (what == AP_ENUMERATOR);
    let mut ok = true;
    let mut where: []u8 = "";
    if cf.in_list(n, FUNC_ATTRS[..]) {
        // (and to what points to a function: taken, as for its type)
        ok = func or (g_fn_entity and (obj or (what == AP_MEMBER) or (what == AP_TYPEDEF)));
        where = "applies only to functions";
    } else if u.str_eq(n, "cold") or u.str_eq(n, "hot") {
        ok = func or (what == AP_LABEL);
        where = "applies only to functions and labels";
    } else if u.str_eq(n, "aligned") {
        ok = obj or func or (what == AP_MEMBER) or (what == AP_TAG) or (what == AP_TYPEDEF);
        where = "applies only to objects, members, structures, unions and typedefs";
    } else if u.str_eq(n, "packed") {
        ok = (what == AP_TAG) or (what == AP_MEMBER);
        where = "applies only to structures, unions, enumerations and members";
    } else if u.str_eq(n, "ms_struct") or u.str_eq(n, "gcc_struct") {
        ok = what == AP_TAG;
        where = "applies only to structures and unions";
    } else if u.str_eq(n, "ifunc") {
        ok = func;
        where = "applies only to functions";
    } else if u.str_eq(n, "section") or u.str_eq(n, "used") or u.str_eq(n, "weak") or u.str_eq(n, "alias") or
              u.str_eq(n, "visibility") {
        ok = obj or func;
        where = "applies only to objects and functions";
    } else if u.str_eq(n, "unused") or u.str_eq(n, "maybe_unused") {
        ok = ent or (what == AP_LABEL);
        where = "does not apply here";
    } else if u.str_eq(n, "deprecated") or u.str_eq(n, "unavailable") {
        ok = ent;
        where = "applies only to declarations";
    } else if u.str_eq(n, "fallthrough") {
        ok = what == AP_BLOCK_DECL;
        where = "applies only to a null statement before a case or default label";
    } else if u.str_eq(n, "cleanup") {
        ok = obj;
        where = "applies only to automatic objects";
    } else if u.str_eq(n, "transparent_union") or u.str_eq(n, "may_alias") {
        ok = (what == AP_TAG) or (what == AP_TYPEDEF);
        where = "applies only to types";
    } else if u.str_eq(n, "mode") or u.str_eq(n, "vector_size") {
        ok = obj or (what == AP_TYPEDEF) or (what == AP_MEMBER) or (what == AP_TYPE_NAME);
        where = "applies only to declarations of objects, members and typedefs, and to type names";
    }
    if not ok {
        ignored(a, where);
        return;
    }
    check_args(a, n);
}

fn check_args(a: *mut cast.Attr, n: []u8) void {
    let strs = ["section", "alias", "ifunc", "visibility", "error", "warning"];
    if cf.in_list(n, strs[..]) {
        if let .some(s) = string_arg(a) {
            if u.str_eq(n, "visibility") {
                let vs = ["default", "hidden", "protected", "internal"];
                if not cf.in_list(s, vs[..]) {
                    err(a.span, "C3077", u.f1("the visibility '%s' is none of default, hidden, protected and internal",
                                              s));
                }
            } else if (s.len == 0) and not u.str_eq(n, "error") and not u.str_eq(n, "warning") {
                err(a.span, "C3077", u.f1("the attribute '%s' takes a name that is not empty", a.name));
            }
        } else {
            bad_args(a, "a string literal");
        }
        return;
    }
    if u.str_eq(n, "deprecated") or u.str_eq(n, "unavailable") {
        if a.has_args {
            if let .some(sa) = string_arg(a) {
                _ = sa;
            } else {
                bad_args(a, "a string literal, or nothing");
            }
        }
        return;
    }
    if u.str_eq(n, "aligned") {
        if a.exprs.len > 1 {
            bad_args(a, "one alignment, or nothing");
            return;
        }
        if a.exprs.len == 1 {
            let mut ok = true;
            let v = int_arg(a, 0, &mut ok);
            if ok and ((v == 0) or ((v & (v - 1)) != 0) or (v > MAX_ALIGN)) {
                err(a.span, "C3071", u.f2("the alignment %s is not a power of two up to %s", u.udec(v),
                                          u.udec(MAX_ALIGN)));
            }
        }
        return;
    }
    if u.str_eq(n, "constructor") or u.str_eq(n, "destructor") {
        if a.exprs.len > 1 {
            bad_args(a, "a priority, or nothing");
        } else if a.exprs.len == 1 {
            let mut ok = true;
            let v = int_arg(a, 0, &mut ok);
            if ok and (v > 65535) {
                err(a.span, "C3077", u.f2("the priority of '%s' is %s; it must be at most 65535", a.name, u.udec(v)));
            }
        }
        return;
    }
    if u.str_eq(n, "nonnull") or u.str_eq(n, "alloc_size") or u.str_eq(n, "alloc_align") or
       u.str_eq(n, "assume_aligned") or u.str_eq(n, "format_arg") or u.str_eq(n, "sentinel") {
        let mut ok = true;
        for k in 0..a.exprs.len {
            _ = int_arg(a, k, &mut ok);
        }
        return;
    }
    if u.str_eq(n, "cleanup") {
        if let .some(ia) = ident_arg(a) {
            _ = ia;
        } else {
            bad_args(a, "the name of a function");
        }
        return;
    }
    if u.str_eq(n, "mode") {
        let mut ok_mode = false;
        if let .some(m) = ident_arg(a) {
            ok_mode = mode_of(m).kind != MK_NONE;
        }
        if not ok_mode {
            bad_args(a,
                     "a mode: QI, HI, SI, DI, TI, word, pointer, byte, HF, SF, DF, XF, TF, HC, SC, DC, XC, TC, or a vector mode V<n><mode> (or __QI__ ...)");
        }
        return;
    }
    if u.str_eq(n, "vector_size") {
        let mut ok = a.exprs.len == 1;
        if ok {
            _ = int_arg(a, 0, &mut ok);
        } else {
            bad_args(a, "the vector's size in bytes");
        }
        return;
    }
    if u.str_eq(n, "format") {
        if not a.has_args or (a.args.len != 5) or (a.args[0].kind != ct.T_IDENT) or (a.args[2].kind != ct.T_INT) or
           (a.args[4].kind != ct.T_INT) {
            bad_args(a, "(archetype, format-index, first-to-check)");
        } else if fmt_archetype(a.args[0].text) == FK_NONE {
            warn(a.span, "C4052", u.f1("the format archetype '%s' is not printf, scanf or strftime, and is ignored",
                                       a.args[0].text));
        }
        return;
    }
    if u.str_eq(n, "optimize") {
        if opt_level_of(a) < -1 {
            bad_args(a, "a level 0 to 3, or \"O0\" ... \"O3\", \"Os\", \"Og\"");
        }
        return;
    }
    if u.str_eq(n, "target") {
        if let .some(s) = string_arg(a) {
            let r = tg.parse_features(s);
            if not u.isnos(r.bad) {
                warn(a.span, "C4052", u.f1("the extension '%s' is not one this target has, and is ignored", r.bad));
            }
        } else {
            bad_args(a, "a string literal of extensions");
        }
        return;
    }
    if a.has_args and ((a.args.len > 0) or (a.exprs.len > 0)) {
        bad_args(a, "no arguments");
    }
}

// What a machine mode of mode(m) is (Mode.kind).
const MK_NONE: i32 = 0;
const MK_INT: i32 = 1;      // an integer of `bits` bits
const MK_FLOAT: i32 = 2;    // a real floating type of format `bits` (ctypes.ffmt)
const MK_COMPLEX: i32 = 3;  // a complex type of that real format
struct Mode {
    kind: i32,
    bits: i32,
    lanes: u64,  // a vector mode (V4SI: 4 lanes of SI), or 0
}

// The machine mode m (QI ... TI, word, pointer, byte; HF, SF, DF, XF, TF and
// their complex HC ... TC; V<n><mode> of n lanes of an integer or floating
// mode); kind MK_NONE if it is none.
fn mode_of(m0: []u8) Mode {
    let m = cf.plain(m0);
    let none = Mode.{ kind: MK_NONE, bits: 0, lanes: 0 };
    if (m.len > 3) and (m[0] == 'V') and (m[1] >= '1') and (m[1] <= '9') {
        let mut i: usize = 1;
        let mut n: u64 = 0;
        while (i < m.len) and (m[i] >= '0') and (m[i] <= '9') {
            n = (n * 10) + @as(u64, m[i] - '0');
            i += 1;
            if n > 4096 {
                return none;
            }
        }
        let el = mode_of(m[i..]);
        if ((el.kind != MK_INT) and (el.kind != MK_FLOAT)) or (el.lanes != 0) {
            return none;
        }
        return Mode.{ kind: el.kind, bits: el.bits, lanes: n };
    }
    let fl = ["HF", "SF", "DF", "XF", "TF"];
    let cxs = ["HC", "SC", "DC", "XC", "TC"];
    let fb: [5]i32 = [16, 32, 64, 80, 128];
    for k in 0..fl.len {
        if u.str_eq(m, fl[k]) {
            return Mode.{ kind: MK_FLOAT, bits: fb[k], lanes: 0 };
        }
        if u.str_eq(m, cxs[k]) {
            return Mode.{ kind: MK_COMPLEX, bits: fb[k], lanes: 0 };
        }
    }
    let b = mode_bits(m);
    if b == 0 {
        return none;
    }
    return Mode.{ kind: MK_INT, bits: b, lanes: 0 };
}

// The real floating type of format `bits` (mode HF ... TF), or .none if the
// target has none (XF, the x87's, where long double is not that format).
fn float_of_bits(bits: i32) ?*mut cty.CType {
    if bits == 16 {
        return .some(cty.t_float16);
    }
    if bits == 32 {
        return .some(cty.t_float);
    }
    if bits == 64 {
        return .some(cty.t_double);
    }
    if bits == 80 {
        if cty.ld_bits() == 80 {
            return .some(cty.t_ldouble);
        }
        return .none;
    }
    if cty.ld_bits() == 128 {
        return .some(cty.t_ldouble);  // (TF: long double where it is binary128, as AArch64's)
    }
    return .some(cty.t_float128);
}

// The width in bits of an integer machine mode of mode(m), or 0 if m is none.
fn mode_bits(m0: []u8) i32 {
    let m = cf.plain(m0);
    if u.str_eq(m, "QI") or u.str_eq(m, "byte") {
        return 8;
    }
    if u.str_eq(m, "HI") {
        return 16;
    }
    if u.str_eq(m, "SI") {
        return 32;
    }
    if u.str_eq(m, "DI") {
        return 64;
    }
    if u.str_eq(m, "TI") {
        return 128;
    }
    if u.str_eq(m, "word") or u.str_eq(m, "pointer") or u.str_eq(m, "unwind_word") {
        return @int_cast(i32, cty.ptr_bytes * 8);
    }
    return 0;
}

// -----------------------------------------------------------------------------
// What they say
// -----------------------------------------------------------------------------

/// The type of a declaration with base type t whose attributes are among
/// the lists: mode(m) makes an integer type of m's width with t's
/// signedness (an error, C3077, for a type that is no integer type), a
/// floating or complex type of its format (of a floating or complex type),
/// or a vector (V<n><m>); vector_size(n) makes a vector of n bytes of t
/// (csema_vec.ax).
pub fn mode_type(t: *mut cty.CType, l1: *u.List.[*mut cast.Attr], l2: *u.List.[*mut cast.Attr],
                 l3: *u.List.[*mut cast.Attr]) *mut cty.CType {
    let lists: [3]*u.List.[*mut cast.Attr] = [l1, l2, l3];
    let mut r = t;
    for l in lists {
        for a in l.items() {
            if not is_gnu(a) {
                continue;
            }
            let an = cf.plain(a.name);
            if u.str_eq(an, "vector_size") {
                if a.exprs.len == 1 {
                    let mut ok = true;
                    let n = int_arg(a, 0, &mut ok);
                    if ok {
                        r = vector_type(r, n, a.span, "the attribute 'vector_size'");
                    }
                }
                continue;
            }
            if not u.str_eq(an, "mode") {
                continue;
            }
            let md = mode_of(ident_arg(a) ?? "");
            if md.kind == MK_NONE {
                continue;
            }
            if (md.kind == MK_FLOAT) or (md.kind == MK_COMPLEX) or (md.lanes != 0) {
                r = float_or_vector_mode(r, md, a);
                continue;
            }
            let bits = md.bits;
            if not cty.is_integer(t) or cty.is_bitint(t) or (t.kind == cty.TK_BOOL) {
                if not cty.is_error(t) {
                    err(a.span, "C3077", u.f1("the attribute 'mode' on %s, which is not an integer type", tq(t)));
                }
                continue;
            }
            let sg = t.is_signed;
            let mut x = t;
            if bits == 8 {
                x = cty.t_uchar;
                if sg {
                    x = cty.t_schar;
                }
            } else if bits == 16 {
                x = cty.t_ushort;
                if sg {
                    x = cty.t_short;
                }
            } else if bits == 128 {
                x = cty.int128(sg);
                if u.isnil(x) {
                    not_supported(a.span, "mode(TI) (__int128)");
                    continue;
                }
            } else {
                let cands: [3]*mut cty.CType = [cty.t_int, cty.t_long, cty.t_llong];
                for c in cands {
                    if c.bits == bits {
                        x = c;
                        break;
                    }
                }
                if sg {
                    x = cty.to_signed(x);
                } else {
                    x = cty.to_unsigned(x);
                }
            }
            r = cty.qualify(x, t.quals);
        }
    }
    return r;
}

// mode(m) of a floating, complex or vector mode md on type t: the type of
// that format (t a real floating type for HF ... TF, a complex one for HC
// ... TC), or a vector of md.lanes elements of the mode's integer (of t's
// signedness: t an integer type) or floating type (t a floating type).
fn float_or_vector_mode(t: *mut cty.CType, md: Mode, a: *cast.Attr) *mut cty.CType {
    if cty.is_error(t) {
        return t;
    }
    let mut oel: ?*mut cty.CType = .none;
    if md.kind == MK_INT {
        if not cty.is_integer(t) or cty.is_bitint(t) or (t.kind == cty.TK_BOOL) {
            err(a.span, "C3077", u.f1("the vector mode of the attribute 'mode' on %s, which is not an integer type",
                                      tq(t)));
            return cty.t_error;
        }
        oel = int_of_bits(md.bits, t.is_signed);
    } else {
        let want_cx = md.kind == MK_COMPLEX;
        if (want_cx and not cty.is_complex(t)) or (not want_cx and not cty.is_floating(t)) {
            err(a.span, "C3077",
                u.f2(
                    "the attribute 'mode' on %s, which is not a %s type", tq(t),
                    u.pick(want_cx, "complex", "floating")));
            return cty.t_error;
        }
        oel = float_of_bits(md.bits);
        if let .some(el0) = oel {
            cty.note_float_use(el0);
            if want_cx {
                return cty.qualify(cty.complex_of(el0), t.quals);
            }
        } else {
            err(a.span, "C3077", "mode(XF): the x87's format, which long double does not have on this target");
            return cty.t_error;
        }
    }
    let mut el = cty.t_error;
    if let .some(el1) = oel {
        el = el1;
    } else {
        err(a.span, "C3077", "the attribute 'mode' names no integer type of this target");
        return cty.t_error;
    }
    if md.lanes == 0 {
        return cty.qualify(el, t.quals);
    }
    return vector_type(cty.qualify(el, t.quals), md.lanes * cty.size_of(el), a.span, "the attribute 'mode'");
}

// The integer type of `bits` bits (8 ... 128) and signedness sg, or .none.
fn int_of_bits(bits: i32, sg: bool) ?*mut cty.CType {
    if bits == 128 {
        let t = cty.int128(sg);
        if u.notnil(t) {
            return .some(t);
        }
        return .none;
    }
    let cands: [5]*mut cty.CType = [cty.t_schar, cty.t_short, cty.t_int, cty.t_long, cty.t_llong];
    for c in cands {
        if c.bits == bits {
            if sg {
                return .some(c);
            }
            return .some(cty.to_unsigned(c));
        }
    }
    return .none;
}
