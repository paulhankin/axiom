// =============================================================================
// csema_fp.ax - the builtins of <math.h>, <tgmath.h> and <fenv.h>, which the
// headers in std/c/include/ are written with (csema_builtin.ax dispatches
// the names beginning __builtin_axiom_ here; cgen_fp.ax generates them):
//
//   __builtin_axiom_fpclassify(x)  __builtin_axiom_isfinite(x)  ..._isinf
//   ..._isnan  ..._isnormal  ..._signbit  ..._issubnormal  ..._iszero
//   ..._issignaling  ..._iscanonical
//       7.12.3: x of a real floating type (an integer is converted to
//       double); the result an int, from x's bits: no floating-point
//       exception is raised, x is evaluated once. FP_ values: <math.h>'s.
//   __builtin_axiom_isgreater(x, y)  ..._isgreaterequal  ..._isless
//   ..._islessequal  ..._islessgreater  ..._isunordered
//       7.12.14: x and y real, converted by the usual arithmetic
//       conversions (two integers to double); quiet comparisons (the
//       backends' compares raise nothing for a quiet NaN), each operand
//       evaluated once.
//   __builtin_axiom_tg(n, f, d, l, cf, cd, cl, args...)
//       <tgmath.h> (7.25), in every standard from C99 (where _Generic is
//       not available): a call of one of the six functions named (0 for
//       one that does not exist) with args, chosen by the types of the
//       first n args: complex if any of them is complex, and then long
//       double if any has a long double type, else double if any has
//       double or an integer type, else float (7.25p3). With real
//       arguments and no real function, the complex one of that real type
//       (carg, cproj, creal, ...: 7.25p6). The call is then an ordinary
//       call of that function (csema_expr.ax: call), its arguments
//       converted to its parameters' types.
//   __builtin_axiom_tgn(m, args...)
//       <tgmath.h>'s macros of the functions that round to a narrower type
//       with an fN, fNx, dN or dNx prefix (C23 7.27p11, H.13p5): m is the
//       macro's name (f32add, d64xsqrt ...); the call is that of m with
//       the suffix of the type the rules choose from the arguments' types
//       (tgn_call), an ordinary call then, as __builtin_axiom_tg's.
//   __builtin_axiom_dec(w, hi, lo)  a constant of the decimal floating type
//       of w bits (32, 64, 128) whose encoding (BID) is lo (and hi for 128):
//       for the headers' infinities and NaNs (<float.h>, <math.h>), which
//       no decimal floating constant spells
//   __builtin_axiom_fenv_kind()  the target's floating-point environment,
//       an integer constant: 0 none (WebAssembly), 1 x86-64 (MXCSR),
//       2 AArch64 (FPCR, FPSR)
//   __builtin_axiom_fenv_get()  an unsigned long long: MXCSR, or FPCR in
//       the low 32 bits and FPSR in the high (0 where there is none)
//   __builtin_axiom_fenv_set(v) writes them (nothing where there is none)
//
// Diagnostics: C3082 (an operand of a type the builtin does not take),
// C3023 (the number of arguments).
// =============================================================================
import "../target.ax" as tg;
import "../util.ax" as u;
import "cast.ax" as cast;
import "cconst.ax" as cc;
import "cdec.ax" as cdec;
import "csema.ax" as cs;
import "csema_expr.ax" as cx;
import "ctypes.ax" as cty;
import "std/c/rt/decimal" as dfp;
import "std/c/rt/ldouble" as ld;

// The builtins (a CALL node's op; 400 and up, apart from csema_builtin.ax's,
// csema_atomic.ax's and the GNU dialects').
pub const BI_FP: i32 = 400;
pub const BI_FPCLASSIFY: i32 = 400;
pub const BI_ISFINITE: i32 = 401;
pub const BI_ISINF: i32 = 402;
pub const BI_ISNAN: i32 = 403;
pub const BI_ISNORMAL: i32 = 404;
pub const BI_SIGNBIT: i32 = 405;
pub const BI_ISSUBNORMAL: i32 = 406;
pub const BI_ISZERO: i32 = 407;
pub const BI_ISSIGNALING: i32 = 408;
pub const BI_ISCANONICAL: i32 = 409;
pub const BI_ISGREATER: i32 = 410;
pub const BI_ISGREATEREQUAL: i32 = 411;
pub const BI_ISLESS: i32 = 412;
pub const BI_ISLESSEQUAL: i32 = 413;
pub const BI_ISLESSGREATER: i32 = 414;
pub const BI_ISUNORDERED: i32 = 415;
pub const BI_ISFPCLASS: i32 = 416;  // a GNU dialect's __builtin_isfpclass(x, mask)
pub const BI_FENV_KIND: i32 = 420;
pub const BI_FENV_GET: i32 = 421;
pub const BI_FENV_SET: i32 = 422;
pub const BI_SNAN: i32 = 423;  // __builtin_axiom_snan(x): a signaling NaN of x's (floating) type, a constant
pub const BI_TG: i32 = 430;
pub const BI_TGN: i32 = 431;  // __builtin_axiom_tgn(m, args...): a narrowing macro of fN, fNx, dN, dNx (H.13p5)
pub const BI_DEC: i32 = 440;

// <math.h>'s FP_ classification values
pub const FP_NAN: u64 = 0;
pub const FP_INFINITE: u64 = 1;
pub const FP_ZERO: u64 = 2;
pub const FP_SUBNORMAL: u64 = 3;
pub const FP_NORMAL: u64 = 4;

let names: [23][]u8 = ["fpclassify", "isfinite", "isinf", "isnan", "isnormal", "signbit", "issubnormal", "iszero",
                       "issignaling", "iscanonical", "isgreater", "isgreaterequal", "isless", "islessequal",
                       "islessgreater", "isunordered", "fenv_kind", "fenv_get", "fenv_set", "snan", "tg", "tgn", "dec"];
let ids: [23]i32 = [400, 401, 402, 403, 404, 405, 406, 407, 408, 409, 410, 411, 412, 413, 414, 415, 420, 421, 422, 423,
                    430, 431, 440];

/// The BI_ number of __builtin_axiom_<rest>, or 0.
pub fn builtin_id(rest: []u8) i32 {
    for k in 0..names.len {
        if u.str_eq(rest, names[k]) {
            return ids[k];
        }
    }
    return 0;
}

fn is_err(e: *cast.Expr) bool {
    return u.isnil(e.ty) or (e.ty.kind == cty.TK_ERROR);
}

fn bad(e: *mut cast.Expr) bool {
    e.ty = cty.t_error;
    e.lvalue = false;
    return true;
}

fn arity(e: *mut cast.Expr, lo: usize, hi: usize) bool {
    let n = e.args.len;
    if (n >= lo) and (n <= hi) {
        return true;
    }
    cs.err(e.span, "C3023", u.f3("'%s' takes %s arguments, not %s", e.a.name, u.zdec(lo), u.zdec(n)));
    return false;
}

/// Types the call e of builtin id; false when it became an ordinary call
/// that the caller then types (BI_TG).
pub fn call(e: *mut cast.Expr, id: i32) bool {
    e.op = id;
    if id == BI_TG {
        return tg_call(e);
    }
    if id == BI_TGN {
        return tgn_call(e);
    }
    if id == BI_DEC {
        return dec_call(e);
    }
    if id >= BI_FENV_KIND {
        return fenv_call(e, id);
    }
    if id == BI_ISFPCLASS {
        return fpclass_call(e);
    }
    if id >= BI_ISGREATER {
        return compare_call(e, id);
    }
    return class_call(e, id);
}

// The value of a constant of floating type t as its format would hold it:
// its bits (as a double for double and a long double that is one).
fn class_of_const(v: f64, single: bool) u64 {
    let b = @bit_cast(u64, v) & 0x7fffffffffffffff;
    if b > 0x7ff0000000000000 {
        return FP_NAN;
    }
    if b == 0x7ff0000000000000 {
        return FP_INFINITE;
    }
    if b == 0 {
        return FP_ZERO;
    }
    let mut lim: f64 = 2.2250738585072014e-308;
    if single {
        lim = 1.1754943508222875e-38;
    }
    if @bit_cast(f64, b) < lim {
        return FP_SUBNORMAL;
    }
    return FP_NORMAL;
}

fn bit(c: bool) u64 {
    if c {
        return 1;
    }
    return 0;
}

fn class_call(e: *mut cast.Expr, id: i32) bool {
    if not arity(e, 1, 1) {
        return bad(e);
    }
    let mut x = cx.rv(e.args.get(0));
    if is_err(x) {
        return bad(e);
    }
    if cty.is_integer(x.ty) {
        x = cx.convert(x, cty.t_double);
    }
    if cty.is_decimal(x.ty) {
        // (a decimal floating value: its class from its encoding, C23 7.12.3)
        e.args.set(0, x);
        e.ty = cty.t_int;
        if x.is_const {
            e.is_const = true;
            e.cval = @as(u64, dfp.classify(x.xv, cdec.fmt(x.ty), @bit_cast(u32, id - BI_FPCLASSIFY)));
        } else {
            cty.note_dec();
        }
        return true;
    }
    if not cty.is_floating(x.ty) {
        cs.err(x.span, "C3082", u.f2("the operand of %s has type %s, not a real floating type", e.a.name, cs.tq(x.ty)));
        return bad(e);
    }
    e.args.set(0, x);
    e.ty = cty.t_int;
    if x.is_const and not cty.is_wide(x.ty) {
        // folded: the constant's class (constants are quiet NaNs)
        let c = class_of_const(x.fcval, x.ty.unq.kind == cty.TK_FLOAT);
        let neg = (@bit_cast(u64, x.fcval) >> 63) != 0;
        let mut r: u64 = 0;
        if id == BI_FPCLASSIFY {
            r = c;
        } else if id == BI_ISFINITE {
            r = bit((c != FP_NAN) and (c != FP_INFINITE));
        } else if id == BI_ISINF {
            r = bit(c == FP_INFINITE);
        } else if id == BI_ISNAN {
            r = bit(c == FP_NAN);
        } else if id == BI_ISNORMAL {
            r = bit(c == FP_NORMAL);
        } else if id == BI_SIGNBIT {
            r = bit(neg);
        } else if id == BI_ISSUBNORMAL {
            r = bit(c == FP_SUBNORMAL);
        } else if id == BI_ISZERO {
            r = bit(c == FP_ZERO);
        } else if id == BI_ISCANONICAL {
            r = 1;
        }
        e.is_const = true;
        e.cval = r;
    }
    return true;
}

// __builtin_isfpclass(x, mask) (a GNU dialect): 1 if x is in one of the
// classes of mask, an integer constant expression of these bits, else 0:
// 0x1 a signaling NaN, 0x2 a quiet NaN, 0x4 -infinity, 0x8 a negative
// normal number, 0x10 a negative subnormal one, 0x20 -0, 0x40 +0, 0x80 a
// positive subnormal number, 0x100 a positive normal one, 0x200 +infinity.
// x as for the classification macros (evaluated once, no exception);
// cgen_fp.ax computes it from them.
fn fpclass_call(e: *mut cast.Expr) bool {
    if not arity(e, 2, 2) {
        return bad(e);
    }
    let m = cx.rv(e.args.get(1));
    if is_err(m) {
        return bad(e);
    }
    if not cty.is_integer(m.ty) or not m.is_const {
        cs.err(m.span, "C3082", u.f1("the mask of %s must be an integer constant expression", e.a.name));
        return bad(e);
    }
    e.args.set(1, m);
    let mut x = cx.rv(e.args.get(0));
    if is_err(x) {
        return bad(e);
    }
    if cty.is_integer(x.ty) {
        x = cx.convert(x, cty.t_double);
    }
    if not cty.is_floating(x.ty) {
        cs.err(x.span, "C3082", u.f2("the operand of %s has type %s, not a real floating type", e.a.name, cs.tq(x.ty)));
        return bad(e);
    }
    if cty.is_decimal(x.ty) {
        cty.note_dec();
    }
    e.args.set(0, x);
    e.ty = cty.t_int;
    return true;
}

fn compare_call(e: *mut cast.Expr, id: i32) bool {
    if not arity(e, 2, 2) {
        return bad(e);
    }
    let mut x = cx.rv(e.args.get(0));
    let mut y = cx.rv(e.args.get(1));
    if is_err(x) or is_err(y) {
        return bad(e);
    }
    if not cty.is_real(x.ty) or not cty.is_real(y.ty) {
        cs.err(e.span, "C3082", u.f3("the operands of %s have types %s and %s, not real types", e.a.name, cs.tq(x.ty),
                                     cs.tq(y.ty)));
        return bad(e);
    }
    if cx.mixes_dec(e, x.ty, y.ty) {
        return bad(e);
    }
    let mut t = cty.common_type(cty.unqual(x.ty), cty.unqual(y.ty));
    if cty.is_integer(t) {
        t = cty.t_double;
    }
    x = cx.convert(x, t);
    y = cx.convert(y, t);
    e.args.set(0, x);
    e.args.set(1, y);
    e.ty = cty.t_int;
    if cty.is_decimal(t) {
        // (quiet comparisons of decimal values: -1, 0, 1, 2 unordered)
        if x.is_const and y.is_const {
            let mut c = dfp.ctx(dfp.R_NEAREST);
            let o = dfp.cmp(x.xv, y.xv, false, cdec.fmt(t), &mut c);
            let mut r = false;
            if id == BI_ISGREATER {
                r = o == 1;
            } else if id == BI_ISGREATEREQUAL {
                r = (o == 1) or (o == 0);
            } else if id == BI_ISLESS {
                r = o == -1;
            } else if id == BI_ISLESSEQUAL {
                r = (o == -1) or (o == 0);
            } else if id == BI_ISLESSGREATER {
                r = (o == -1) or (o == 1);
            } else {
                r = o == 2;
            }
            e.is_const = true;
            e.cval = bit(r);
        } else {
            cty.note_dec();
        }
        return true;
    }
    if x.is_const and y.is_const and not cty.is_wide(t) {
        let a = x.fcval;
        let b = y.fcval;
        let mut r = false;
        if id == BI_ISGREATER {
            r = a > b;
        } else if id == BI_ISGREATEREQUAL {
            r = a >= b;
        } else if id == BI_ISLESS {
            r = a < b;
        } else if id == BI_ISLESSEQUAL {
            r = a <= b;
        } else if id == BI_ISLESSGREATER {
            r = (a < b) or (a > b);
        } else {
            r = (a != a) or (b != b);
        }
        e.is_const = true;
        e.cval = bit(r);
    }
    return true;
}

fn dec_call(e: *mut cast.Expr) bool {
    if not arity(e, 3, 3) {
        return bad(e);
    }
    let w = cx.ice(e.args.get(0), "the first argument of __builtin_axiom_dec");
    let hi = cx.ice(e.args.get(1), "the second argument of __builtin_axiom_dec");
    let lo = cx.ice(e.args.get(2), "the third argument of __builtin_axiom_dec");
    if not w.ok or not hi.ok or not lo.ok {
        return bad(e);
    }
    if (w.v != 32) and (w.v != 64) and (w.v != 128) {
        cs.err(e.span, "C3082", "the width of __builtin_axiom_dec is 32, 64 or 128");
        return bad(e);
    }
    e.ty = cty.decimal(@truncate(i32, @bit_cast(i64, w.v)));
    cdec.set(e, ld.W.{ lo: lo.v, hi: hi.v });
    return true;
}

/// The bits of a signaling NaN (quiet bit clear, the next one set) of each
/// format: as a double (float's widened as conversions keep a NaN's bits:
/// ir.f32_bits), binary16's, and the wide formats'.
pub const SNAN_F64: u64 = 0x7FF4_0000_0000_0000;

/// Makes e the constant signaling NaN of binary floating type t (positive).
pub fn snan_const(e: *mut cast.Expr, t: *mut cty.CType) void {
    e.ty = t;
    e.is_const = true;
    e.fcval = @bit_cast(f64, SNAN_F64);
    if cty.is_wide(t) {
        if cc.fmt_t(t) == ld.FMT_X {
            e.xv = ld.W.{ lo: 0xA000_0000_0000_0000, hi: 0x7FFF };
        } else {
            e.xv = ld.W.{ lo: 0, hi: 0x7FFF_4000_0000_0000 };
        }
    }
}

fn fenv_call(e: *mut cast.Expr, id: i32) bool {
    if id == BI_SNAN {
        // (<float.h>'s FLT_SNAN ...: C23 5.2.4.2.2, F.2.1)
        if not arity(e, 1, 1) {
            return bad(e);
        }
        let x = cx.rv(e.args.get(0));
        if is_err(x) {
            return bad(e);
        }
        if not cty.is_real_floating(x.ty) or cty.is_decimal(x.ty) {
            cs.err(x.span, "C3082", u.f1("the operand of __builtin_axiom_snan has type %s, not a binary floating type",
                                         cs.tq(x.ty)));
            return bad(e);
        }
        snan_const(e, cty.unqual(x.ty));
        return true;
    }
    if id == BI_FENV_KIND {
        if not arity(e, 0, 0) {
            return bad(e);
        }
        e.ty = cty.t_int;
        e.is_const = true;
        if tg.g_arch == tg.ARCH_X64 {
            e.cval = 1;
        } else if tg.g_arch == tg.ARCH_A64 {
            e.cval = 2;
        } else {
            e.cval = 0;
        }
        return true;
    }
    if id == BI_FENV_GET {
        if not arity(e, 0, 0) {
            return bad(e);
        }
        e.ty = cty.t_ullong;
        return true;
    }
    if not arity(e, 1, 1) {
        return bad(e);
    }
    let x = cx.rv(e.args.get(0));
    if is_err(x) {
        return bad(e);
    }
    if not cty.is_integer(x.ty) {
        cs.err(x.span, "C3082", u.f1("the operand of __builtin_axiom_fenv_set has type %s, not an integer type",
                                     cs.tq(x.ty)));
        return bad(e);
    }
    e.args.set(0, cx.convert(x, cty.t_ullong));
    e.ty = cty.t_void;
    return true;
}

// The real type that <tgmath.h> chooses for an argument of type t (7.25p3):
// 0 float, 1 double, 2 long double; and whether it is complex.
fn tg_rank(t: *mut cty.CType) i32 {
    let mut r = t.unq;
    if cty.is_complex(r) {
        r = r.elem.unq;
    }
    if r.kind == cty.TK_FLOAT {
        return 0;
    }
    if r.kind == cty.TK_LDOUBLE {
        return 2;
    }
    return 1;  // double, and the integer types
}

// A type-generic macro's call with decimal floating arguments (C23 7.27p3,
// H.13p3): _Decimal128 if any is one; else _Decimal64x if any is one; else
// _Decimal64 if any is one, or one is an integer and another a _Decimal32;
// else _Decimal32. The function is the double one's name with d32, d64,
// d64x or d128 (expd64 for exp), if <math.h> declares it. A standard floating or complex argument among decimal ones
// has no common type (C3230).
fn tg_decimal(e: *mut cast.Expr, drank0: i32, ints: bool, bin: bool) bool {
    if bin {
        cs.err(e.span, "C3230",
               "a type-generic macro's arguments mix decimal floating and standard floating or complex types: they have no common type");
        return bad(e);
    }
    let mut drank = drank0;
    if (drank == 1) and ints {
        drank = 2;
    }
    let base = e.args.get(2);
    let suf = ["d32", "d64", "d64x", "d128"];
    let mut sym = u.nil.[cast.CSym]();
    let mut name: []u8 = "";
    if base.kind == cast.ExprKind.IDENT {
        name = u.intern(u.cat2(base.name, suf[@as(usize, @bit_cast(u32, drank - 1))]));
        sym = cs.lookup(name);
    }
    if u.isnil(sym) {
        cs.err(e.span, "C3082", "this type-generic macro has no function for decimal floating arguments");
        return bad(e);
    }
    let callee = cast.new_expr(cast.ExprKind.IDENT, base.span);
    callee.name = name;
    let mut args = u.List.[*mut cast.Expr].empty();
    for i in @as(usize, 7)..e.args.len {
        args.push(e.args.get(i));
    }
    e.a = callee;
    e.args = args;
    e.op = 0;
    return false;
}

// A type-generic macro's call with an argument of an interchange or
// extended floating type (C23 H.11; real or complex arguments, cplx if a
// complex one): the arguments' common
// real type (an integer one counted as double, 7.27p3). For binary16 and
// binary128 (_Float16, _Float128) and for _Float32 ... _Float64x the
// function is the double one's name with the type's suffix (sqrtf128 for
// sqrt, sqrtf32x), which <math.h> declares with
// __STDC_WANT_IEC_60559_TYPES_EXT__; without it, float's function for
// binary16, long double's where that is binary128, else for binary128 an
// error (no function keeps a binary128 value), and for the others, whose
// formats are float's, double's or long double's, *rank is that type's, and
// the standard function is called (of that format: its result has the
// standard type). 0: not done here (no such argument, or *rank set); 1: the
// call is the function's; 2: an error (reported).
fn tg_xfloat(e: *mut cast.Expr, ngv: usize, rank: *mut i32, cplx: bool) i32 {
    let mut t = u.nil.[cty.CType]();
    let mut ext = false;
    // (H.13p3: an integer argument is regarded as a _Float32x if another
    // has a binary extended type, else as a double)
    let mut int_ty = cty.t_double;
    for i in @as(usize, 7)..(7 + ngv) {
        let k = cty.real_of(e.args.get(i).ty).unq.kind;
        if (k == cty.TK_FLOAT32X) or (k == cty.TK_FLOAT64X) {
            int_ty = cty.t_float32x;
        }
    }
    for i in @as(usize, 7)..(7 + ngv) {
        let a = e.args.get(i);
        let mut at = a.ty;
        if cty.is_integer(at) {
            at = int_ty;
        }
        if cty.is_complex(at) {
            at = cty.real_of(at);  // (H.11: the complex functions of the type)
        }
        let k = at.unq.kind;
        ext = ext or ((k >= cty.TK_FLOAT16) and (k <= cty.TK_FLOAT128));
        if u.isnil(t) {
            t = at;
        } else {
            t = cty.common_type(t, at);
        }
    }
    if not ext {
        return 0;
    }
    let f = cty.ffmt(t);
    let k = t.unq.kind;
    let xk = (k >= cty.TK_FLOAT16) and (k <= cty.TK_FLOAT128);
    if (f == 16) or ((f == 128) and (k != cty.TK_LDOUBLE)) or xk {
        let mut base = e.args.get(2);
        if cplx or (base.kind != cast.ExprKind.IDENT) {
            base = e.args.get(5);  // (the complex function: cexp, cabs for fabs)
        }
        let mut sym = u.nil.[cast.CSym]();
        let mut name: []u8 = "";
        if base.kind == cast.ExprKind.IDENT {
            name = u.intern(u.cat2(base.name, xsuffix(k, f)));
            sym = cs.lookup(name);
        }
        if u.isnil(sym) and (f != 16) and (f != 128) {
            // (not declared: the standard function of the format, below)
            xs_rank(f, rank);
            return 0;
        }
        if u.isnil(sym) and (f == 16) {
            rank.* = 0;  // (not declared: float's function, whose format holds binary16's values)
            return 0;
        }
        if u.isnil(sym) and (cty.ld_bits() == 128) {
            rank.* = 2;  // (not declared: long double's, binary128 too)
            return 0;
        }
        if u.isnil(sym) {
            cs.err(e.span, "C3082",
                   u.f1("this type-generic macro has no function for %s arguments (<math.h> declares those of _Float16 and _Float128 with __STDC_WANT_IEC_60559_TYPES_EXT__)",
                        cs.tq(t)));
            _ = bad(e);
            return 2;
        }
        let callee = cast.new_expr(cast.ExprKind.IDENT, base.span);
        callee.name = name;
        let mut args = u.List.[*mut cast.Expr].empty();
        for i in @as(usize, 7)..e.args.len {
            args.push(e.args.get(i));
        }
        e.a = callee;
        e.args = args;
        e.op = 0;
        return 1;
    }
    xs_rank(f, rank);
    return 0;
}

// The suffix of the functions of binary interchange or extended type t
// (f16 ... f64x), or of decimal type t (d32, d64, d64x, d128); "" for a
// standard floating type, whose functions have none of these.
fn type_suffix(t: *cty.CType) []u8 {
    let k = t.unq.kind;
    if (k >= cty.TK_FLOAT16) and (k <= cty.TK_FLOAT128) {
        return xsuffix(k, cty.ffmt(t));
    }
    let r = cty.dec_rank(t);
    if r > 0 {
        let ds = ["d32", "d64", "d64x", "d128"];
        return ds[@as(usize, @bit_cast(u32, r - 1))];
    }
    return "";
}

// Are the values of floating type a a subset of (or the same as) those of
// type b (H.13p5's a ⊆ b), both binary or both decimal? Binary formats
// nest by width (binary16, 32, 64, the x87's, binary128); decimal ones:
// decimal32, 64, then _Decimal64x and _Decimal128 (one format).
fn values_within(a: *cty.CType, b: *cty.CType) bool {
    if cty.is_decimal(a) {
        return @min(cty.dec_rank(a), 3) <= @min(cty.dec_rank(b), 3);
    }
    return cty.ffmt(a) <= cty.ffmt(b);
}

// A call of the narrowing type-generic macro m (f32add ... d64xsqrt; C23
// 7.27p11, H.13p5) with args e.args[1..]: the generic type P is the
// arguments' common real type (integers regarded as double, or _Decimal64
// with a decimal prefix, when all are integers; else as H.13p3 says); the
// function is m with P's suffix if <math.h> declares it, else with that of
// the first type T, of those the prefix lists in order, whose values
// include P's (fM: _FloatN for N > M, then _FloatNx for N >= M; fMx:
// _FloatNx for N > M, then _FloatN for N > M; dM and dMx likewise). The
// arguments are all real; a decimal one with a binary prefix, or a binary
// one with a decimal prefix, has no function (C3230).
fn tgn_call(e: *mut cast.Expr) bool {
    let n = e.args.len;
    if n < 2 {
        cs.err(e.span, "C3023", u.f1("'__builtin_axiom_tgn' takes at least 2 arguments, not %s", u.zdec(n)));
        return bad(e);
    }
    let m = e.args.get(0);
    if (m.kind != cast.ExprKind.IDENT) or (m.name.len < 5) or ((m.name[0] != 'f') and (m.name[0] != 'd')) {
        cs.err(e.span, "C3082", "the first argument of __builtin_axiom_tgn is the name of a narrowing macro");
        return bad(e);
    }
    let dec = m.name[0] == 'd';
    let mut i: usize = 1;
    let mut mw: i32 = 0;
    while (i < m.name.len) and (m.name[i] >= '0') and (m.name[i] <= '9') {
        mw = (mw * 10) + @as(i32, m.name[i] - '0');
        i += 1;
    }
    let mx = (i < m.name.len) and (m.name[i] == 'x');
    let mut ok = mw > 0;
    let mut dec_arg = false;
    let mut bin_arg = false;
    let mut ext_dec = false;
    let mut ext_bin = false;
    for j in @as(usize, 1)..n {
        let a = cx.rv(e.args.get(j));
        e.args.set(j, a);
        if is_err(a) {
            ok = false;
        } else if not cty.is_integer(a.ty) and not cty.is_real_floating(a.ty) {
            cs.err(a.span, "C3082", u.f2("an argument of '%s' has type %s, not a real type", m.name, cs.tq(a.ty)));
            ok = false;
        } else if not cty.is_integer(a.ty) {
            let k = a.ty.unq.kind;
            dec_arg = dec_arg or cty.is_decimal(a.ty);
            bin_arg = bin_arg or cty.is_floating(a.ty);
            ext_dec = ext_dec or (k == cty.TK_DEC64X);
            ext_bin = ext_bin or (k == cty.TK_FLOAT32X) or (k == cty.TK_FLOAT64X);
        }
    }
    if not ok {
        return bad(e);
    }
    if (dec and bin_arg) or (not dec and dec_arg) {
        cs.err(e.span, "C3230",
               u.f1("an argument of '%s' has a floating type of the other radix than its result's: it has no function",
                    m.name));
        return bad(e);
    }
    // the generic type P
    let mut int_ty = cty.t_double;
    if ext_dec {
        int_ty = cty.t_dec64x;
    } else if ext_bin {
        int_ty = cty.t_float32x;
    } else if dec {
        int_ty = cty.t_dec64;
    }
    let mut p = u.nil.[cty.CType]();
    for j in @as(usize, 1)..n {
        let mut at = e.args.get(j).ty;
        if cty.is_integer(at) {
            at = int_ty;
        }
        if u.isnil(p) {
            p = at;
        } else {
            p = cty.common_type(p, at);
        }
    }
    let mut name = u.intern(u.cat2(m.name, type_suffix(p)));
    if (type_suffix(p).len == 0) or u.isnil(cs.lookup(name)) {
        // (the types the prefix names, in the order H.13p5 tries them)
        let mut cands = u.List.[*mut cty.CType].empty();
        if dec {
            let ws: [3]i32 = [32, 64, 128];
            let ts: [3]*mut cty.CType = [cty.t_dec32, cty.t_dec64, cty.t_dec128];
            if mx and (64 > mw) {
                cands.push(cty.t_dec64x);
            }
            for k in @as(usize, 0)..3 {
                if ws[k] > mw {
                    cands.push(ts[k]);
                }
            }
            if not mx and (64 >= mw) {
                cands.push(cty.t_dec64x);
            }
        } else {
            let ws: [4]i32 = [16, 32, 64, 128];
            let ts: [4]*mut cty.CType = [cty.t_float16, cty.t_float32, cty.t_float64, cty.t_float128];
            let xws: [2]i32 = [32, 64];
            let xts: [2]*mut cty.CType = [cty.t_float32x, cty.t_float64x];
            if mx {
                for k in @as(usize, 0)..2 {
                    if xws[k] > mw {
                        cands.push(xts[k]);
                    }
                }
            }
            for k in @as(usize, 0)..4 {
                if ws[k] > mw {
                    cands.push(ts[k]);
                }
            }
            if not mx {
                for k in @as(usize, 0)..2 {
                    if xws[k] >= mw {
                        cands.push(xts[k]);
                    }
                }
            }
        }
        let mut t = u.nil.[cty.CType]();
        for k in 0..cands.len {
            if u.isnil(t) and values_within(p, cands.get(k)) {
                t = cands.get(k);
            }
        }
        if u.notnil(t) {
            name = u.intern(u.cat2(m.name, type_suffix(t)));
        }
        if u.isnil(t) or u.isnil(cs.lookup(name)) {
            cs.err(e.span, "C3082", u.f2("'%s' has no function for arguments of type %s", m.name, cs.tq(p)));
            return bad(e);
        }
    }
    let callee = cast.new_expr(cast.ExprKind.IDENT, m.span);
    callee.name = name;
    let mut args = u.List.[*mut cast.Expr].empty();
    for j in @as(usize, 1)..n {
        args.push(e.args.get(j));
    }
    e.a = callee;
    e.args = args;
    e.op = 0;
    return false;
}

/// The rank of the standard type of format f (32, 64, or long double's).
fn xs_rank(f: i32, rank: *mut i32) void {
    if f == 32 {
        rank.* = 0;
    } else if f == 64 {
        rank.* = 1;
    } else {
        rank.* = 2;  // (long double's format)
    }
}

/// The suffix of the functions of an interchange or extended floating type
/// of kind k (H.11: f16 ... f64x), or of format f for another kind.
fn xsuffix(k: i32, f: i32) []u8 {
    if k == cty.TK_FLOAT32 {
        return "f32";
    }
    if k == cty.TK_FLOAT64 {
        return "f64";
    }
    if k == cty.TK_FLOAT32X {
        return "f32x";
    }
    if k == cty.TK_FLOAT64X {
        return "f64x";
    }
    return u.pick(f == 16, "f16", "f128");
}

fn tg_call(e: *mut cast.Expr) bool {
    let n = e.args.len;
    if n < 8 {
        cs.err(e.span, "C3023", u.f1("'__builtin_axiom_tg' takes at least 8 arguments, not %s", u.zdec(n)));
        return bad(e);
    }
    let ng = cx.ice(e.args.get(0), "the first argument of __builtin_axiom_tg");
    if not ng.ok or (ng.v == 0) or ((ng.v + 7) > @as(u64, n)) {
        if ng.ok {
            cs.err(e.span, "C3023", "__builtin_axiom_tg has fewer arguments than its first says");
        }
        return bad(e);
    }
    let mut rank: i32 = 0;
    let mut cplx = false;
    let mut ok = true;
    let mut drank: i32 = 0;  // the widest decimal argument's cty.dec_rank
    let mut ints = false;
    let mut bin = false;  // a standard floating or complex argument
    let ngv = @as(usize, @truncate(u32, ng.v));
    for i in @as(usize, 7)..(7 + ngv) {
        let a = cx.rv(e.args.get(i));
        e.args.set(i, a);
        if is_err(a) {
            ok = false;
        } else if not cty.is_arith(a.ty) {
            cs.err(a.span, "C3082", u.f1("an argument of a type-generic macro has type %s, not an arithmetic type",
                                         cs.tq(a.ty)));
            ok = false;
        } else if cty.is_decimal(a.ty) {
            drank = @max(drank, cty.dec_rank(a.ty));
        } else {
            rank = @max(rank, tg_rank(a.ty));
            cplx = cplx or cty.is_complex(a.ty);
            ints = ints or cty.is_integer(a.ty);
            bin = bin or not cty.is_integer(a.ty);
        }
    }
    if not ok {
        return bad(e);
    }
    if drank > 0 {
        return tg_decimal(e, drank, ints, bin);
    }
    let x = tg_xfloat(e, ngv, &mut rank, cplx);
    if x != 0 {
        return x == 2;
    }
    // the function: slot 1 + rank (real) or 4 + rank (complex)
    let real = e.args.get(1 + @as(usize, @bit_cast(u32, rank)));
    let comp = e.args.get(4 + @as(usize, @bit_cast(u32, rank)));
    let mut f = real;
    if cplx or (real.kind != cast.ExprKind.IDENT) {
        f = comp;
    }
    if f.kind != cast.ExprKind.IDENT {
        let what = u.pick(cplx, "complex", "real");
        cs.err(e.span, "C3082", u.f1("this type-generic macro has no function for %s arguments", what));
        return bad(e);
    }
    let callee = cast.new_expr(cast.ExprKind.IDENT, f.span);
    callee.name = f.name;
    let mut args = u.List.[*mut cast.Expr].empty();
    for i in @as(usize, 7)..n {
        args.push(e.args.get(i));
    }
    e.a = callee;
    e.args = args;
    e.op = 0;
    return false;
}
