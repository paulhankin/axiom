// =============================================================================
// csema_marks.ax - what semantic analysis records about functions and
// objects beyond their CSyms: objects declared `register` (whose address
// cannot be taken, 6.5.3.2p1), and the inline functions of 6.7.4.
//
// A function with external linkage all of whose file-scope declarations in
// the unit say `inline` and none `extern` has an inline definition here
// (6.7.4p7): it is no external definition, so IR generation gives it
// internal linkage and a name of its own (calls in the unit use it; the
// external function, if any, is another unit's). Such a definition must not
// define a modifiable object with static storage duration nor refer to an
// identifier with internal linkage (6.7.4p3); whether a definition is an
// inline one is known only at the end of the unit (a later declaration can
// make it an external definition), so what its body does is recorded and
// reported then (finish).
//
// Diagnostics:
//   C3220  main declared inline or _Noreturn
//   C3221  an inline definition that defines a modifiable static object or refers to an internal identifier
//   C3222  the address of an object declared register is taken (or a register array is used as a pointer)
//   C3090  __builtin_va_arg_pack() other than as the last of a call's variable arguments
// =============================================================================
import "../util.ax" as u;
import "cast.ax" as cast;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;

// A function declared inline at file scope with external linkage.
nocopy struct InlineFn {
    sym: *mut cast.CSym,
    plain: bool,    // a file-scope declaration without inline, or with extern
    gnu: bool,      // GNU89's `extern inline` (only for inlining, whatever else declares it)
    va_pack: bool,  // its body uses __builtin_va_arg_pack: not used (marks_end_body)
    problems: u.List.[Problem],
    // a body with va_pack: its __builtin_va_arg_pack() calls, and those a
    // call takes as its last variable argument (pack_argument); at its end
    // (marks_end_body) the definition and its parameters, which each call of the
    // function inlines (cgen_stmt.inline_call)
    packs: u.List.[*mut cast.Expr],
    taken: u.List.[*mut cast.Expr],
    wrapper: ?*mut cast.Decl,
    wparams: []*mut cast.CSym,
}

struct Problem {
    sp: u.Span,
    msg: []u8,
}

nocopy struct Marks {
    fns: u.SymMap.[?*mut InlineFn],
    fn_list: u.List.[*mut InlineFn],
    registers: u.SymMap.[i32],
    body: ?*mut InlineFn,  // the inline function whose body is being analyzed, or .none
}

fn marks() *mut Marks {
    if let .some(m) = g_marks {
        return m;
    }
    let m = u.new.[Marks]();
    m.fns = u.SymMap.[?*mut InlineFn].{ keys: u.nil.[usize](), vals: u.nil.[?*mut InlineFn](), cap: 0, len: 0 };
    m.fn_list = u.List.[*mut InlineFn].empty();
    m.registers = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    g_marks = .some(m);
    return m;
}

fn marks_key(s: *cast.CSym) []u8 {
    return u.addr_key(@int_from_ptr(s));
}

// -----------------------------------------------------------------------------
// register
// -----------------------------------------------------------------------------

/// Object s is declared with the storage-class specifier register.
pub fn set_register(s: *mut cast.CSym) void {
    marks().registers.put(marks_key(s), 1);
}

/// Was object s declared register?
pub fn is_register(s: *cast.CSym) bool {
    return marks().registers.get(marks_key(s)) != 0;
}

/// The object declared register that lvalue e (typed) designates or is a
/// member or element of an array of (x.y, a[i] of an array), or .none.
pub fn register_object(e: *mut cast.Expr) ?*mut cast.CSym {
    let mut x = e;
    loop {
        let k = x.kind;
        if (k == cast.ExprKind.MEMBER) and (x.op == ct.P_DOT) {
            x = x.a;
        } else if (k == cast.ExprKind.CAST) and (x.op == cast.CV_ADECAY) {
            x = x.a;
        } else if (k == cast.ExprKind.INDEX) and (x.a.kind == cast.ExprKind.CAST) and (x.a.op == cast.CV_ADECAY) {
            x = x.a.a;
        } else {
            break;
        }
    }
    let named = (x.kind == cast.ExprKind.IDENT) or (x.kind == cast.ExprKind.COMPOUND);  // (C23: `(register T){...}`)
    if named and u.notnil(x.sym) and (x.sym.kind == cast.SK_OBJECT) and is_register(x.sym) {
        return .some(x.sym);
    }
    return .none;
}

// -----------------------------------------------------------------------------
// inline
// -----------------------------------------------------------------------------

/// A file-scope declaration (or the definition) of function s, with
/// function specifiers `funcs` (cast.FS_ bits) and storage class sc; sp: its name.
/// The declaration given to function_declared has the GNU dialects' inline
/// semantics (gnu89 and gnu90, or the attribute gnu_inline): only `extern
/// inline` makes an inline definition (one that is no external
/// definition); `inline` alone defines the external function.
pub fn function_declared(s: *mut cast.CSym, funcs: i32, sc: i32, sp: u.Span) void {
    if u.str_eq(s.name, "main") and (s.linkage == cast.LK_EXTERNAL) and (funcs != 0) {
        err(sp, "C3220", "main cannot be declared inline or _Noreturn");
    }
    if s.linkage != cast.LK_EXTERNAL {
        return;
    }
    let m = marks();
    let mut inl = (funcs & cast.FS_INLINE) != 0;
    if gnu89_inline {
        // (GNU89: `extern inline` is C99's `inline`, and `inline` is a plain definition)
        inl = inl and (sc == cast.SC_EXTERN);
    }
    let of = m.fns.get(marks_key(s));
    if gnu89_inline and inl {
        // (GNU89's `extern inline` is a definition only for inlining, as the
        // system's headers define their wrappers of the library's functions,
        // which they declare without inline too: never an external
        // definition, whatever the other declarations)
        // (its body is checked as an inline definition's: 6.7.4p3, marks_finish)
        if let .some(f) = of {
            if f.plain and not f.gnu {
                f.problems = u.List.[Problem].empty();
                m.fn_list.push(f);  // (a declaration without inline came first)
            }
            f.plain = false;
            f.gnu = true;
        } else {
            let f = u.new.[InlineFn]();
            f.sym = s;
            f.problems = u.List.[Problem].empty();
            f.plain = false;
            f.gnu = true;
            m.fns.put(marks_key(s), .some(f));
            m.fn_list.push(f);
        }
        return;
    }
    if let .some(f) = of {
        if f.gnu {
            return;
        }
        if not inl or ((sc == cast.SC_EXTERN) and not gnu89_inline) {
            f.plain = true;
        }
        return;
    }
    let f = u.new.[InlineFn]();
    f.sym = s;
    if not inl {
        // (a declaration without inline first: never an inline definition)
        f.plain = true;
        m.fns.put(marks_key(s), .some(f));
        return;
    }
    f.problems = u.List.[Problem].empty();
    m.fns.put(marks_key(s), .some(f));
    m.fn_list.push(f);
    if not inl or ((sc == cast.SC_EXTERN) and not gnu89_inline) {
        f.plain = true;
    }
}

/// Does function s have an inline definition in this unit (one that is no
/// external definition)?
pub fn is_inline_def(s: *cast.CSym) bool {
    if (s.linkage != cast.LK_EXTERNAL) or u.isnil(s.def) {
        return false;
    }
    let f = marks().fns.get(marks_key(s)) ?? return false;
    return not f.plain;
}

/// The body of function s is analyzed from now (until marks_end_body).
pub fn marks_begin_body(s: *mut cast.CSym) void {
    let m = marks();
    m.body = .none;
    if s.linkage != cast.LK_EXTERNAL {
        return;
    }
    if let .some(f) = m.fns.get(marks_key(s)) {
        if not f.plain {
            m.body = .some(f);
        }
    }
}

/// Is the body being analyzed that of a GNU89 `extern inline` definition
/// (only for inlining)?
pub fn in_gnu_inline_body() bool {
    let m = g_marks ?? return false;
    let b = m.body ?? return false;
    return b.gnu;
}

/// The body being analyzed uses __builtin_va_arg_pack or _len (the caller's
/// variable arguments, which an inline definition forwards): false if it
/// is not that of an inline definition. e: the call of
/// __builtin_va_arg_pack (.none for _len), which must be the last of a call's
/// variable arguments (pack_argument).
pub fn va_pack_use(e: ?*mut cast.Expr) bool {
    let f = marks().body ?? return false;
    if not f.va_pack {
        f.packs = u.List.[*mut cast.Expr].empty();
        f.taken = u.List.[*mut cast.Expr].empty();
    }
    f.va_pack = true;
    if let .some(x) = e {
        f.packs.push(x);
    }
    return true;
}

/// Is e (typed) a call of __builtin_va_arg_pack of the body being analyzed?
/// last: it is the last of a call's variable arguments, the place it is
/// replaced by them (taken: not reported at the body's end).
pub fn pack_argument(e: *mut cast.Expr, last: bool) bool {
    let f = marks().body ?? return false;
    if not f.va_pack {
        return false;
    }
    for x in f.packs.items() {
        if x == e {
            if last {
                f.taken.push(e);
            }
            return true;
        }
    }
    return false;
}

/// The definition of function s that its calls inline, an inline
/// definition that forwards its caller's variable arguments
/// (__builtin_va_arg_pack), or nil; params: its parameters.
pub fn va_wrapper(s: *cast.CSym, params: *mut []*mut cast.CSym) *mut cast.Decl {
    let m = g_marks ?? return u.nil.[cast.Decl]();
    if s.linkage != cast.LK_EXTERNAL {
        return u.nil.[cast.Decl]();
    }
    let f = m.fns.get(marks_key(s)) ?? return u.nil.[cast.Decl]();
    let w = f.wrapper ?? return u.nil.[cast.Decl]();
    params.* = f.wparams;
    return w;
}

/// The body analyzed ends. True when the inline definition is not to be
/// generated as a function: it forwards the caller's variable arguments
/// (va_pack_use), which only inlining each call gives it; the function is
/// then the external one (a plain declaration of it from now on), and the
/// definition is kept for the calls to inline (va_wrapper), unless a
/// __builtin_va_arg_pack () in it is not the last of a call's variable
/// arguments (C3090).
pub fn marks_end_body() bool {
    let m = marks();
    let f = m.body ?? return false;
    m.body = .none;
    if not f.va_pack {
        return false;
    }
    let mut bad = false;
    for x in f.packs.items() {
        let mut ok = false;
        for y in f.taken.items() {
            ok = ok or (x == y);
        }
        if not ok {
            err(x.span, "C3090", "'__builtin_va_arg_pack ()' is only the last of a call's variable arguments");
            bad = true;
        }
    }
    if not bad and u.notnil(f.sym.def) {
        f.wrapper = .some(f.sym.def);
        f.wparams = f.sym.params.items();
    }
    f.plain = true;
    f.problems.clear();
    return true;
}

/// The inline definition whose body is being analyzed (around a nested
/// function's body: marks_restore_body).
pub fn marks_save_body() ?*mut InlineFn {
    let m = g_marks ?? return .none;
    return m.body;
}

pub fn marks_restore_body(x: ?*mut InlineFn) void {
    if let .some(m) = g_marks {
        m.body = x;
    }
}

fn problem(sp: u.Span, msg: []u8) void {
    let f = marks().body ?? return;
    f.problems.push(Problem.{ sp: sp, msg: msg });
}

/// Identifier s is referred to at sp (in the body being analyzed, if any).
pub fn referred(s: *cast.CSym, sp: u.Span) void {
    let m = g_marks ?? return;
    let b = m.body ?? return;
    if (s.linkage == cast.LK_INTERNAL) and ((s.kind == cast.SK_OBJECT) or (s.kind == cast.SK_FUNC)) {
        problem(sp, u.f2("the inline definition of '%s' refers to '%s', which has internal linkage", b.sym.name,
                         s.name));
    }
}

/// Object s with static storage duration is defined in a block (of the body
/// being analyzed, if any).
pub fn static_defined(s: *cast.CSym, sp: u.Span) void {
    let m = g_marks ?? return;
    let b = m.body ?? return;
    let mut t = s.ty;
    while t.kind == cty.TK_ARRAY {
        t = t.elem;
    }
    if (t.quals & cty.Q_CONST) == 0 {
        problem(sp, u.f2("the inline definition of '%s' defines '%s', a modifiable object with static storage duration",
                         b.sym.name, s.name));
    }
}

/// At the end of the unit: reports what the bodies of the inline
/// definitions (those still so) do that they must not.
pub fn marks_finish() void {
    let m = g_marks ?? return;
    for f in m.fn_list.items() {
        if f.plain {
            continue;
        }
        for &p in f.problems.items() {
            err(p.sp, "C3221", p.msg);
        }
        // (reported once: the next unit's marks_finish sees this unit's functions too)
        f.problems.clear();
    }
}
