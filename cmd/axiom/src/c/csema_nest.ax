// =============================================================================
// csema_nest.ax - the GNU dialects' nested functions: a function defined in a
// block of another function. It sees the enclosing function's objects (and
// its enclosing functions'), and is called directly or through a pointer to
// it while the enclosing function's call that made the pointer is running.
//
// What semantic analysis records (cast.CSym), for IR generation (cgen_nest.ax):
//   nest_parent  of a nested function, the function it is defined in
//   rec          of a function with nested functions, the automatic objects
//                its nested functions (and theirs) use of it or of its
//                enclosing functions: its frame record holds their addresses
//                (a use in a function nested k deep puts the object in the
//                records of the k functions between its own and the use)
//   tramps       of such a function, those of its nested functions whose
//                addresses are taken: a trampoline each (cgen_nest.ax)
//   lens         (here, by function) the lengths of variable length array
//                types (CType.vexpr) each function evaluates: a function
//                with nested functions keeps their slots' addresses in its
//                frame record, so that its nested functions (and theirs)
//                use its variably modified types (cgen_nest.outer_len)
// An object of variable length array type an enclosing function has is
// in the records as other objects are, its address stored there when it is
// allocated. A nested function jumps to no label of its enclosing function
// but a local one (`__label__`), which is a non-local goto
// (csema_stmt.goto_label, cgen_nest.ax).
// =============================================================================
import "../util.ax" as u;
import "cast.ax" as cast;
import "csema.ax" as cs;
import "ctypes.ax" as cty;

/// Notes that object s (an automatic object, or a parameter) is used at sp
/// in the function being analyzed: if s is another function's, every
/// function from this one up to s's own passes it on (rec).
pub fn use_object(s: *mut cast.CSym, sp: u.Span) void {
    let cur = cs.cur_fn();
    let owner = s.owner;
    if u.isnil(cur) or u.isnil(owner) or (owner == cur) or (s.duration != cast.SD_AUTO) {
        return;
    }
    let mut f = cur;
    while u.notnil(f) and (f != owner) and u.notnil(f.nest_parent) {
        add_once(&mut f.nest_parent.rec, s);
        f = f.nest_parent;
    }
}

fn add_once(l: *mut u.List.[*mut cast.CSym], s: *mut cast.CSym) void {
    for x in l.items() {
        if x == s {
            return;
        }
    }
    l.push(s);
}

/// Notes that the address of function s is taken (dir: -1 when the use was
/// a direct call's, which takes back the use the callee's conversion noted).
pub fn use_address(s: *mut cast.CSym, dir: i32) void {
    if u.notnil(s.nest_parent) {
        s.tramp_refs += dir;
    }
}

/// At the end of function f's body: the nested functions of f whose
/// addresses are taken (tramps).
pub fn finish(f: *mut cast.CSym, nested: []*mut cast.CSym) void {
    for g in nested {
        if (g.nest_parent == f) and (g.tramp_refs > 0) {
            add_once(&mut f.tramps, g);
        }
    }
}

/// The index of object s in function p's frame record (after its first
/// slot, the record of p's enclosing function), or -1.
pub fn rec_index(p: *cast.CSym, s: *mut cast.CSym) i32 {
    for k in 0..p.rec.len {
        if p.rec.get(k) == s {
            return @int_cast(i32, k);
        }
    }
    return -1;
}

// -----------------------------------------------------------------------------
// The lengths of variable length array types
// -----------------------------------------------------------------------------

let mut g_vexpr_fn: u.SymMap.[*mut cast.CSym] = u.SymMap.[*mut cast.CSym].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut *mut cast.CSym, 0), cap: 0, len: 0 };
let mut g_fn_lens: u.SymMap.[*mut u.List.[*mut void]] =
    u.SymMap.[*mut u.List.[*mut void]].{ keys: @ptr_from_int(*mut usize, 0),
                                         vals: @ptr_from_int(*mut *mut u.List.[*mut void], 0), cap: 0, len: 0 };

fn vkey(p: *void) []u8 {
    return u.addr_key(@int_from_ptr(p));
}

fn fkey(f: *cast.CSym) []u8 {
    return u.addr_key(@int_from_ptr(f));
}

// Notes that function f (nil: none) evaluates length n (a CType.vexpr).
fn own(n: *mut void, f: *mut cast.CSym) void {
    let k = vkey(n);
    let had = g_vexpr_fn.get(k);
    if had == f {
        return;
    }
    if u.notnil(had) {
        let l = g_fn_lens.get(fkey(had));
        for i in 0..l.len {
            if l.get(i) == n {
                l.set(i, u.vnil());  // (another function's now: a function definition's parameter)
            }
        }
    }
    g_vexpr_fn.put(k, f);
    if u.isnil(f) {
        return;
    }
    let fk = fkey(f);
    let mut l = g_fn_lens.get(fk);
    if u.isnil(l) {
        l = u.new.[u.List.[*mut void]]();
        g_fn_lens.put(fk, l);
    }
    l.push(n);
}

/// A variable length array type's length n (a CType.vexpr) is made, where
/// the function being analyzed (if any) evaluates it.
pub fn note_length(n: *mut void) void {
    let f = cs.cur_fn();
    if u.notnil(f) {
        own(n, f);
    }
}

/// At the start of function f's body (f the function being analyzed): the
/// lengths in its parameters' types are f's (they were made while its
/// declarator was analyzed, before its body: in the enclosing function, for
/// a nested one), and so are their uses of objects.
pub fn own_params(f: *mut cast.CSym) void {
    for p in f.params.items() {
        let mut t = p.ty;
        while u.notnil(t) and ((t.kind == cty.TK_ARRAY) or (t.kind == cty.TK_POINTER)) {
            if t.vla and not u.isvnil(t.vexpr) {
                own(t.vexpr, f);
                if u.notnil(f.nest_parent) {
                    uses(@ptr_cast(*mut cast.Expr, t.vexpr));
                }
            }
            t = t.elem;
        }
    }
}

// The uses of objects in expression e, in the function being analyzed.
fn uses(e: *mut cast.Expr) void {
    if u.isnil(e) {
        return;
    }
    if (e.kind == cast.ExprKind.IDENT) and u.notnil(e.sym) and (e.sym.kind == cast.SK_OBJECT) {
        use_object(e.sym, e.span);
    }
    uses(e.a);
    uses(e.b);
    uses(e.c);
    for x in e.args.items() {
        uses(x);
    }
}

/// The function that evaluates length n (a CType.vexpr), or nil.
pub fn length_owner(n: *void) *mut cast.CSym {
    return g_vexpr_fn.get(vkey(n));
}

/// The lengths function f evaluates (nil entries: taken by a nested
/// function's definition), in the order of their slots in its record.
pub fn lengths(f: *cast.CSym) []*mut void {
    let l = g_fn_lens.get(fkey(f));
    if u.isnil(l) {
        return u.nil_slice.[*mut void]();
    }
    return l.items();
}

/// The index of length n among function f's (lengths), or -1.
pub fn length_index(f: *cast.CSym, n: *void) i32 {
    let ls = lengths(f);
    for k in 0..ls.len {
        if @ptr_cast(*void, ls[k]) == n {
            return @int_cast(i32, k);
        }
    }
    return -1;
}
