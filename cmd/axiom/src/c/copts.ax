// =============================================================================
// copts.ax - the C front end's options: the language standard and the
// implementation-defined choices a build can make (docs/c.md).
// =============================================================================
import "../util.ax" as u;

// The standards, in order: a feature is on from the one that added it.
pub const C89: i32 = 0;  // ISO/IEC 9899:1990 (and ANSI X3.159-1989)
pub const C95: i32 = 1;  // with Amendment 1 (digraphs, __STDC_VERSION__ 199409L, <iso646.h>)
pub const C99: i32 = 2;
pub const C11: i32 = 3;
pub const C17: i32 = 4;
pub const C23: i32 = 5;

pub struct Define {
    name: []u8,
    body: []u8,   // the replacement list ("1" for -DNAME)
    undef: bool,  // -UNAME
    // -Apred=answer (a GNU dialect's assertion: name pred, body answer),
    // with undef -A-pred=answer (body empty: every answer of pred); -A-
    // (name and body empty, undef) takes back the predefined ones and those
    // before it
    assertion: bool,
}

pub struct COptions {
    std: i32,           // C89 .. C23 (--c-std=, default C17)
    char_signed: bool,  // --c-char=signed|unsigned (default: the target's C ABI)
    int_bits: i32,      // --c-int=16|32|64 (default 32); short is 16, long long 64
    long_bits: i32,     // --c-long=32|64 (default: the target's C ABI)
    ld_bits: i32,       // --c-long-double=64|80|128: long double's format (default: the target's C ABI)
    ptr_bits: i32,      // the target's
    wchar_bits: i32,    // 32, or 16 for Windows targets
    wchar_signed: bool,
    // the platform C library's choices among types of a width (set_platform):
    // each an R_ code, used when that type has the width the role needs
    size_pref: i32,    // size_t (ptrdiff_t, intptr_t: its signed type)
    int64_pref: i32,   // int64_t
    intmax_pref: i32,  // intmax_t
    fast16_pref: i32,  // int_fast16_t
    fast32_pref: i32,  // int_fast32_t
    wint_pref: i32,    // wint_t
    wint_signed: bool,
    max_align: i32,        // the alignment of max_align_t
    bitfields: i32,        // how bit-fields are laid out (BF_)
    bitint_align: i32,     // the alignment of _BitInt(N) for N > 64: 16 on AArch64 (AAPCS64), else 8
    atomic_pad: i32,       // atomic types up to this size are padded to a power of two (ctypes.ax: atomic_size)
    atomic_max: i32,       // and atomic types of a power of two up to this size are aligned to their size
    defines: []Define,     // -D, -U and -A, in order
    include_dirs: [][]u8,  // -I, in order (then the compiler's own headers)
    sys_include: []u8,     // the compiler's own headers (<std>/c/include)
    hosted: bool,          // not --c-freestanding: __STDC_HOSTED__ is 1, the library's headers are found
    gnu: bool,             // a GNU dialect (--c-std=gnu89 ... gnu23): the standard and the extensions (docs/c.md)
    declspec: bool,        // __declspec is a keyword (a GNU dialect, or the target is Windows: docs/c.md)
    warn_pragmas: bool,    // --c-warn-unknown-pragmas: an unknown #pragma is warning C4111 (off by default)
    asm_intel: bool,       // --c-asm-dialect=intel: x86-64 inline and file-scope assembly in the Intel syntax (default att)
    // vector types (a GNU dialect: csema_vec.ax), from the target and its
    // processor extensions (--cpu, --features): the largest alignment of one
    // (0: its size), the widest the target's vector registers hold (16; 32
    // with AVX, 64 with AVX-512F on x86-64), whether the IR's vector types
    // can be used (WebAssembly: with simd128)
    vec_align: i32,
    vec_reg: i32,
    vec_ir: bool,
    warn_format: i32,   // --c-warn-format=0|1|2: the checks of format strings (csema_format.ax; default 1)
    fenv_access: bool,  // --c-fenv-access: every function as if under #pragma STDC FENV_ACCESS ON
    // --c-keep-null-checks: the optimizer is not told that the pointers
    // nonnull, returns_nonnull and [static n] promise are not null
    // (ir.F_NONNULL, ir.Func.ret_nonnull: their tests stay)
    keep_null_checks: bool,
    // --c-lib=system: the system's C library is the program's, and its
    // headers are the hosted headers (docs/c.md, "The system's C library")
    system_lib: bool,
    system_dirs: [][]u8,  // its headers' directories (after -I; the compiler's freestanding headers first)
    // what the predefined macros of the build say (ctarget.ax): the
    // optimizer's level (-O0 .. -O3), whether the code is
    // position-independent (--pic, --emit=shared; macOS) and whether the
    // executable is (macOS)
    opt_level: i32,
    pic: bool,
    pie: bool,
}

/// The value of __STDC_VERSION__ for a standard (0: not defined, C89).
pub fn stdc_version(std: i32) i64 {
    if std == C95 {
        return 199409;
    }
    if std == C99 {
        return 199901;
    }
    if std == C11 {
        return 201112;
    }
    if std == C17 {
        return 201710;
    }
    if std == C23 {
        return 202311;
    }
    return 0;
}

/// The standard a --c-std= value names, or -1. A GNU dialect's name
/// (`gnu99`) names the standard it extends (C99): is_gnu says it is one.
pub fn std_named(s: []u8) i32 {
    let names = ["c89", "c90", "iso9899:1990", "c95", "iso9899:199409", "c99", "iso9899:1999", "c11", "iso9899:2011",
                 "c17", "c18", "iso9899:2017", "iso9899:2018", "c23", "iso9899:2024", "gnu89", "gnu90", "gnu99",
                 "gnu11", "gnu17", "gnu18", "gnu23"];
    let stds: [22]i32 = [C89, C89, C89, C95, C95, C99, C99, C11, C11, C17, C17, C17, C17, C23, C23, C89, C89, C99, C11,
                         C17, C17, C23];
    for k in 0..names.len {
        if names[k].len == s.len {
            let mut same = true;
            for j in 0..s.len {
                if names[k][j] != s[j] {
                    same = false;
                }
            }
            if same {
                return stds[k];
            }
        }
    }
    return -1;
}

// -----------------------------------------------------------------------------
// The types of the headers' typedefs
// -----------------------------------------------------------------------------

// The standard integer types by rank, as the typedefs' choices name them.
pub const R_CHAR: i32 = 1;  // signed char
pub const R_SHORT: i32 = 2;
pub const R_INT: i32 = 3;
pub const R_LONG: i32 = 4;
pub const R_LLONG: i32 = 5;

// The platforms whose C libraries the typedefs follow.
pub const PLAT_LINUX: i32 = 1;    // x86-64 and AArch64 Linux
pub const PLAT_DARWIN: i32 = 2;   // macOS (AArch64 and x86-64)
pub const PLAT_WINDOWS: i32 = 3;  // Windows (x86-64 and AArch64)
pub const PLAT_WASM: i32 = 4;     // WebAssembly (32 and 64 bits)

// How bit-fields are laid out (csema_bits.ax).
pub const BF_SYSV: i32 = 0;     // x86-64 System V (also Apple's arm64 ABI, WebAssembly)
pub const BF_AAPCS64: i32 = 1;  // AAPCS64: as System V, but every bit-field's type adds to the alignment
pub const BF_MS: i32 = 2;       // Windows (x64 and ARM64): in runs of units of one size

/// Sets o's preferred types for the typedefs of <stddef.h> and <stdint.h>
/// on platform plat (a64: an AArch64 one), and its layout of bit-fields:
/// those of the platform's C ABI and C library, so that
/// a declaration that uses them is the same type as the platform's (the
/// x86-64 System V and AAPCS64 ABIs, Apple's arm64 and x86-64 ABIs, Windows
/// x64 and ARM64 and the WebAssembly C ABI; the int_fast types as the
/// platforms' libraries declare them).
pub fn set_platform(o: *mut COptions, plat: i32, a64: bool) void {
    o.bitfields = BF_SYSV;
    o.bitint_align = 8;
    // The layout of _Atomic types (6.2.5p27 lets it differ from the type's;
    // checked against the platforms' compilers): on Linux the psABIs' rule,
    // the size kept and a size of 1, 2, 4, 8 or 16 bytes made the alignment;
    // on macOS and Windows a size up to 16 is also padded to the next of
    // those (_Atomic(struct of 12 bytes) is 16 bytes aligned to 16), and on
    // WebAssembly the same up to 8 bytes (its widest atomic access).
    o.atomic_pad = 16;
    o.atomic_max = 16;
    if plat == PLAT_LINUX {
        o.atomic_pad = 0;
    } else if plat == PLAT_WASM {
        o.atomic_pad = 8;
        o.atomic_max = 8;
    }
    if a64 {
        o.bitint_align = 16;
    }
    if (plat == PLAT_LINUX) and a64 {
        o.bitfields = BF_AAPCS64;
    } else if plat == PLAT_WINDOWS {
        o.bitfields = BF_MS;
    }
    o.size_pref = R_LONG;
    o.int64_pref = R_LONG;
    o.intmax_pref = R_LONG;
    o.fast16_pref = R_INT;
    o.fast32_pref = R_INT;
    o.wint_pref = R_INT;
    o.wint_signed = false;
    o.max_align = 16;
    if plat == PLAT_LINUX {
        o.fast16_pref = R_LONG;
        o.fast32_pref = R_LONG;
    } else if plat == PLAT_DARWIN {
        o.int64_pref = R_LLONG;
        o.fast16_pref = R_SHORT;
        o.wint_signed = true;
        // (max_align_t: long double's 16 bytes on x86-64, double's 8 on arm64)
        if a64 {
            o.max_align = 8;
        }
    } else if plat == PLAT_WINDOWS {
        o.size_pref = R_LLONG;
        o.int64_pref = R_LLONG;
        o.intmax_pref = R_LLONG;
        o.wint_pref = R_SHORT;
        o.max_align = 8;
    } else {
        o.int64_pref = R_LLONG;
        o.intmax_pref = R_LLONG;
        o.wint_signed = true;
    }
}

/// The width in bits of the integer type of rank code r.
pub fn width_of(o: *COptions, r: i32) i32 {
    if r == R_CHAR {
        return 8;
    }
    if r == R_SHORT {
        return 16;
    }
    if r == R_INT {
        return o.int_bits;
    }
    if r == R_LONG {
        return o.long_bits;
    }
    return 64;
}

// The preferred type if it is exactly w bits wide, else the first of int,
// long and long long that is (or, none being, the first wider).
fn exact(o: *COptions, pref: i32, w: i32) i32 {
    if width_of(o, pref) == w {
        return pref;
    }
    for r in R_INT..(R_LLONG + 1) {
        if width_of(o, r) == w {
            return r;
        }
    }
    for r in R_INT..(R_LLONG + 1) {
        if width_of(o, r) >= w {
            return r;
        }
    }
    return R_LLONG;
}

/// size_t's type (unsigned), and ptrdiff_t's and intptr_t's (signed).
pub fn size_type(o: *COptions) i32 {
    return exact(o, o.size_pref, o.ptr_bits);
}

/// int64_t's type.
pub fn int64_type(o: *COptions) i32 {
    return exact(o, o.int64_pref, 64);
}

/// intmax_t's type (64 bits: the widest).
pub fn intmax_type(o: *COptions) i32 {
    return exact(o, o.intmax_pref, 64);
}

// The preferred type if it is at least w bits wide, else the narrowest
// standard type that is.
fn at_least(o: *COptions, pref: i32, w: i32) i32 {
    if width_of(o, pref) >= w {
        return pref;
    }
    for r in R_CHAR..(R_LLONG + 1) {
        if width_of(o, r) >= w {
            return r;
        }
    }
    return R_LLONG;
}

/// The spelling of the type of rank code r (unsigned: its unsigned type)
/// in standard std: long long before C99 is the keyword __axiom_int64.
pub fn spelling(r: i32, unsigned: bool, std: i32) []u8 {
    if (r == R_LLONG) and (std < C99) {
        return u.pick(unsigned, "unsigned __axiom_int64", "__axiom_int64");
    }
    let names = ["signed char", "short", "int", "long", "long long"];
    let unames = ["unsigned char", "unsigned short", "unsigned int", "unsigned long", "unsigned long long"];
    let k = @int_cast(usize, r - R_CHAR);
    if unsigned {
        return unames[k];
    }
    return names[k];
}

// The suffix of an integer constant of the type of rank code r ("" when a
// constant of the type is written without one: int and narrower).
fn suffix(r: i32, unsigned: bool) []u8 {
    return suffix_in(r, unsigned, false);
}

// As suffix; wide: a narrower type that int cannot hold (--c-int=16:
// unsigned short promotes to unsigned int, whose constants have a U).
fn suffix_in(r: i32, unsigned: bool, wide: bool) []u8 {
    if unsigned and wide and (r < R_INT) {
        return "U";
    }
    let mut s = "";
    if r == R_LONG {
        s = "L";
    } else if r == R_LLONG {
        s = "LL";
    }
    if unsigned and (r >= R_INT) {
        return u.cat2("U", s);
    }
    return s;
}

// The largest value of a w-bit type, signed or not, as decimal digits.
fn max_digits(w: i32, signed: bool) []u8 {
    let mut m: u64 = 0xFFFF_FFFF_FFFF_FFFF;
    if w < 64 {
        m = (@as(u64, 1) << @as(u64, @bit_cast(u32, w))) - 1;
    }
    if signed {
        m = m >> 1;
    }
    return u.udec(m);
}

// The definitions of the macros of one typedef's type: NAME_TYPE__ (and
// UNAME_TYPE__ for its unsigned type), NAME_MIN__, NAME_MAX__,
// UNAME_MAX__, NAME_WIDTH__ and the constant macro NAME_C__(c) (UNAME_C__).
fn type_macros(b: *mut u.Buf, o: *COptions, name: []u8, uname: []u8, r: i32) void {
    let w = width_of(o, r);
    let p = "#define __AXIOM_";
    b.s(u.f3("%s%s_TYPE__ %s\n", p, name, spelling(r, false, o.std)));
    b.s(u.f3("%s%s_TYPE__ %s\n", p, uname, spelling(r, true, o.std)));
    b.s(u.f3("%s%s_WIDTH__ %s\n", p, name, u.idec(w)));
    let mx = u.cat2(max_digits(w, true), suffix(r, false));
    b.s(u.f3("%s%s_MAX__ %s\n", p, name, mx));
    b.s(u.f3("%s%s_MIN__ (-%s - 1)\n", p, name, mx));
    let wide = (r < R_INT) and (w >= o.int_bits);
    b.s(u.f3("%s%s_MAX__ %s\n", p, uname, u.cat2(max_digits(w, false), suffix_in(r, true, wide))));
    b.s(u.f4("%s%s_C__(c) c%s%s\n", p, name, u.pick(suffix(r, false).len > 0, "##", ""), suffix(r, false)));
    b.s(u.f4("%s%s_C__(c) c%s%s\n", p, uname, u.pick(suffix(r, true).len > 0, "##", ""), suffix(r, true)));
}

/// The predefined macros that tell the headers the typedefs' types (and
/// their limits): __AXIOM_SIZE_TYPE__, __AXIOM_INT64_TYPE__, ...
pub fn type_macros_text(o: *COptions) []u8 {
    let mut b = u.Buf.init();
    type_macros(&mut b, o, "PTRDIFF", "SIZE", size_type(o));
    type_macros(&mut b, o, "INT64", "UINT64", int64_type(o));
    type_macros(&mut b, o, "INTMAX", "UINTMAX", intmax_type(o));
    type_macros(&mut b, o, "INT_FAST16", "UINT_FAST16", at_least(o, o.fast16_pref, 16));
    type_macros(&mut b, o, "INT_FAST32", "UINT_FAST32", at_least(o, o.fast32_pref, 32));
    // wint_t: at least as wide as wchar_t (7.31.1p2: it holds every value of it)
    let wr = at_least(o, o.wint_pref, o.wchar_bits);
    b.s(u.f1("#define __AXIOM_WINT_TYPE__ %s\n", spelling(wr, not o.wint_signed, o.std)));
    b.s(u.f1("#define __AXIOM_WINT_WIDTH__ %s\n", u.idec(width_of(o, wr))));
    if o.wint_signed {
        let mx = max_digits(width_of(o, wr), true);
        b.s(u.f2("#define __AXIOM_WINT_MIN__ (-%s%s - 1)\n", mx, suffix(wr, false)));
        b.s(u.f2("#define __AXIOM_WINT_MAX__ %s%s\n", mx, suffix(wr, false)));
    } else {
        let wide = (wr < R_INT) and (width_of(o, wr) >= o.int_bits);
        b.s(u.f1("#define __AXIOM_WINT_MIN__ 0%s\n", suffix_in(wr, true, wide)));
        b.s(u.f2("#define __AXIOM_WINT_MAX__ %s%s\n", max_digits(width_of(o, wr), false), suffix_in(wr, true, wide)));
    }
    b.s(u.f1("#define __AXIOM_MAX_ALIGN__ %s\n", u.idec(o.max_align)));
    return b.done();
}

/// Does a --c-std= value name a GNU dialect (gnu89 ... gnu23)?
pub fn is_gnu(s: []u8) bool {
    return (s.len == 5) and (s[0] == 'g') and (s[1] == 'n') and (s[2] == 'u') and (std_named(s) >= 0);
}

// -----------------------------------------------------------------------------
// The conventional predefined macros of the types
// -----------------------------------------------------------------------------

/// The rank code of the type of exactly 32 bits (int, or long when int is
/// not), or 0: none (int is 16 bits and long 64, or int 64).
pub fn int32_rank(o: *COptions) i32 {
    if o.int_bits == 32 {
        return R_INT;
    }
    if o.long_bits == 32 {
        return R_LONG;
    }
    return 0;
}

/// The rank code of wchar_t's type (as ctypes.ax and the headers choose
/// it): short when 16 bits, else int, or long when int is 16 bits and long
/// is 32.
pub fn wchar_rank(o: *COptions) i32 {
    if o.wchar_bits == 16 {
        return R_SHORT;
    }
    if (o.int_bits == 32) or ((o.long_bits != 32) and (o.int_bits >= 32)) {
        return R_INT;
    }
    return R_LONG;
}

// The largest value of the type of rank code r (unsigned: its unsigned
// type) as a constant of the type after the integer promotions (C17
// 7.20.2p2: the limits' types), and its smallest (signed: -max - 1; else 0).
fn max_of(o: *COptions, r: i32, unsigned: bool) []u8 {
    let w = width_of(o, r);
    if unsigned {
        return u.cat2(max_digits(w, false), suffix_in(r, true, (r < R_INT) and (w >= o.int_bits)));
    }
    return u.cat2(max_digits(w, true), suffix(r, false));
}

fn min_of(o: *COptions, r: i32, unsigned: bool) []u8 {
    if unsigned {
        return u.cat2("0", suffix_in(r, true, (r < R_INT) and (width_of(o, r) >= o.int_bits)));
    }
    return u.f1("(-%s - 1)", max_of(o, r, false));
}

// __NAME_TYPE__ and __UNAME_TYPE__, __NAME_MAX__ and __UNAME_MAX__ (and
// __NAME_WIDTH__ if `width`) of the type of rank code r and its unsigned
// type.
fn conv_pair(b: *mut u.Buf, o: *COptions, name: []u8, uname: []u8, r: i32, width: bool) void {
    b.s(u.f2("#define __%s_TYPE__ %s\n", name, spelling(r, false, o.std)));
    b.s(u.f2("#define __%s_TYPE__ %s\n", uname, spelling(r, true, o.std)));
    b.s(u.f2("#define __%s_MAX__ %s\n", name, max_of(o, r, false)));
    b.s(u.f2("#define __%s_MAX__ %s\n", uname, max_of(o, r, true)));
    if width {
        b.s(u.f2("#define __%s_WIDTH__ %s\n", name, u.idec(width_of(o, r))));
    }
}

// __NAME_C(c) and __UNAME_C(c), the constant macros of the type of rank
// code r (as <stdint.h>'s INTN_C and UINTN_C).
fn conv_c(b: *mut u.Buf, o: *COptions, name: []u8, uname: []u8, r: i32) void {
    let s = suffix(r, false);
    let us = suffix_in(r, true, (r < R_INT) and (width_of(o, r) >= o.int_bits));
    b.s(u.f3("#define __%s_C(c) c%s%s\n", name, u.pick(s.len > 0, "##", ""), s));
    b.s(u.f3("#define __%s_C(c) c%s%s\n", uname, u.pick(us.len > 0, "##", ""), us));
}

/// The conventional predefined macros that describe the types (names in
/// the implementation's namespace, C17 7.1.3, that programs test): their
/// sizes (__SIZEOF_INT__ ...), limits (__INT_MAX__ ...), widths, the types
/// of the typedefs of <stddef.h>, <stdint.h>, <wchar.h> and <uchar.h>
/// (__SIZE_TYPE__, __INT64_TYPE__ ...) with their limits and constant
/// macros, the characteristics of the floating types (__FLT_MAX__ ...: as
/// <float.h>), the byte order and the largest alignment. Each says what the
/// compiler's own headers say (the test c/run/predef_types.c checks them
/// against sizeof, <limits.h>, <stdint.h> and <float.h>).
pub fn conventional_type_macros_text(o: *COptions) []u8 {
    let mut b = u.Buf.init();
    let sz = size_type(o);
    let wr = wchar_rank(o);
    let wint = at_least(o, o.wint_pref, o.wchar_bits);
    let i32r = int32_rank(o);
    b.s("#define __CHAR_BIT__ 8\n");
    // sizes in bytes
    b.s(u.f2("#define __SIZEOF_SHORT__ 2\n#define __SIZEOF_INT__ %s\n#define __SIZEOF_LONG__ %s\n",
             u.idec(o.int_bits / 8), u.idec(o.long_bits / 8)));
    b.s("#define __SIZEOF_LONG_LONG__ 8\n#define __SIZEOF_FLOAT__ 4\n#define __SIZEOF_DOUBLE__ 8\n");
    // (long double: binary64's 8 bytes, else 16: the x87 format padded, or binary128)
    b.s(u.f1("#define __SIZEOF_LONG_DOUBLE__ %s\n", u.pick(o.ld_bits == 64, "8", "16")));
    b.s(u.f1("#define __SIZEOF_POINTER__ %s\n", u.idec(o.ptr_bits / 8)));
    b.s(u.f2("#define __SIZEOF_SIZE_T__ %s\n#define __SIZEOF_PTRDIFF_T__ %s\n", u.idec(width_of(o, sz) / 8),
             u.idec(width_of(o, sz) / 8)));
    b.s(u.f2("#define __SIZEOF_WCHAR_T__ %s\n#define __SIZEOF_WINT_T__ %s\n", u.idec(width_of(o, wr) / 8),
             u.idec(width_of(o, wint) / 8)));
    if o.gnu {
        // (__int128 and __float128 are types of the GNU dialects only)
        b.s("#define __SIZEOF_INT128__ 16\n#define __SIZEOF_FLOAT128__ 16\n");
    }
    // the standard integer types' limits and widths (<limits.h>)
    b.s("#define __SCHAR_MAX__ 127\n#define __SHRT_MAX__ 32767\n");
    b.s(u.f1("#define __INT_MAX__ %s\n", max_of(o, R_INT, false)));
    b.s(u.f1("#define __LONG_MAX__ %s\n", max_of(o, R_LONG, false)));
    b.s(u.f1("#define __LONG_LONG_MAX__ %s\n", max_of(o, R_LLONG, false)));
    b.s("#define __SCHAR_WIDTH__ 8\n#define __SHRT_WIDTH__ 16\n");
    b.s(u.f2("#define __INT_WIDTH__ %s\n#define __LONG_WIDTH__ %s\n#define __LONG_LONG_WIDTH__ 64\n",
             u.idec(o.int_bits), u.idec(o.long_bits)));
    // the typedefs' types
    b.s(u.f1("#define __SIZE_TYPE__ %s\n", spelling(sz, true, o.std)));
    b.s(u.f1("#define __PTRDIFF_TYPE__ %s\n", spelling(sz, false, o.std)));
    b.s(u.f2("#define __SIZE_MAX__ %s\n#define __PTRDIFF_MAX__ %s\n", max_of(o, sz, true), max_of(o, sz, false)));
    b.s(
        u.f2(
            "#define __SIZE_WIDTH__ %s\n#define __PTRDIFF_WIDTH__ %s\n", u.idec(width_of(o, sz)),
            u.idec(width_of(o, sz))));
    let wu = not o.wchar_signed;
    b.s(u.f1("#define __WCHAR_TYPE__ %s\n", spelling(wr, wu, o.std)));
    b.s(u.f2("#define __WCHAR_MAX__ %s\n#define __WCHAR_MIN__ %s\n", max_of(o, wr, wu), min_of(o, wr, wu)));
    b.s(u.f1("#define __WCHAR_WIDTH__ %s\n", u.idec(width_of(o, wr))));
    if wu {
        b.s("#define __WCHAR_UNSIGNED__ 1\n");
    }
    let iu = not o.wint_signed;
    b.s(u.f1("#define __WINT_TYPE__ %s\n", spelling(wint, iu, o.std)));
    b.s(u.f2("#define __WINT_MAX__ %s\n#define __WINT_MIN__ %s\n", max_of(o, wint, iu), min_of(o, wint, iu)));
    b.s(u.f1("#define __WINT_WIDTH__ %s\n", u.idec(width_of(o, wint))));
    // (char16_t and char32_t: uint_least16_t's and uint_least32_t's, <uchar.h>)
    let mut c32 = i32r;
    if c32 == 0 {
        c32 = R_LONG;
        if o.int_bits >= 32 {
            c32 = R_INT;
        }
    }
    b.s(u.f1("#define __CHAR16_TYPE__ unsigned short\n#define __CHAR32_TYPE__ %s\n", spelling(c32, true, o.std)));
    // (sig_atomic_t is int: <signal.h>)
    b.s("#define __SIG_ATOMIC_TYPE__ int\n");
    b.s(
        u.f2(
            "#define __SIG_ATOMIC_MAX__ %s\n#define __SIG_ATOMIC_MIN__ %s\n", max_of(o, R_INT, false),
            min_of(o, R_INT, false)));
    b.s(u.f1("#define __SIG_ATOMIC_WIDTH__ %s\n", u.idec(o.int_bits)));
    // <stdint.h>'s types: exact, least and fast widths, pointers, the widest
    let i64r = int64_type(o);
    conv_pair(&mut b, o, "INT8", "UINT8", R_CHAR, false);
    conv_pair(&mut b, o, "INT16", "UINT16", R_SHORT, false);
    if i32r != 0 {
        conv_pair(&mut b, o, "INT32", "UINT32", i32r, false);
    }
    conv_pair(&mut b, o, "INT64", "UINT64", i64r, false);
    let mut l32 = i32r;
    if l32 == 0 {
        l32 = R_LONG;
        if o.int_bits == 64 {
            l32 = R_INT;
        }
    }
    conv_pair(&mut b, o, "INT_LEAST8", "UINT_LEAST8", R_CHAR, true);
    conv_pair(&mut b, o, "INT_LEAST16", "UINT_LEAST16", R_SHORT, true);
    conv_pair(&mut b, o, "INT_LEAST32", "UINT_LEAST32", l32, true);
    conv_pair(&mut b, o, "INT_LEAST64", "UINT_LEAST64", i64r, true);
    conv_pair(&mut b, o, "INT_FAST8", "UINT_FAST8", R_CHAR, true);
    conv_pair(&mut b, o, "INT_FAST16", "UINT_FAST16", at_least(o, o.fast16_pref, 16), true);
    conv_pair(&mut b, o, "INT_FAST32", "UINT_FAST32", at_least(o, o.fast32_pref, 32), true);
    conv_pair(&mut b, o, "INT_FAST64", "UINT_FAST64", i64r, true);
    conv_pair(&mut b, o, "INTPTR", "UINTPTR", sz, true);
    conv_pair(&mut b, o, "INTMAX", "UINTMAX", intmax_type(o), true);
    conv_c(&mut b, o, "INT8", "UINT8", R_CHAR);
    conv_c(&mut b, o, "INT16", "UINT16", R_SHORT);
    if i32r != 0 {
        conv_c(&mut b, o, "INT32", "UINT32", i32r);
    }
    conv_c(&mut b, o, "INT64", "UINT64", i64r);
    conv_c(&mut b, o, "INTMAX", "UINTMAX", intmax_type(o));
    // the floating types (<float.h>'s values: binary32, binary64, and long
    // double's format; FLT_EVAL_METHOD 0)
    b.s("#define __FLT_RADIX__ 2\n#define __FLT_EVAL_METHOD__ 0\n");
    float_macros(&mut b, "FLT", "24", "6", "9", "(-125)", "(-37)", "128", "38", "3.40282347e+38F", "1.19209290e-7F",
                 "1.17549435e-38F", "1.40129846e-45F");
    float_macros(&mut b, "DBL", "53", "15", "17", "(-1021)", "(-307)", "1024", "308", "1.7976931348623157e+308",
                 "2.2204460492503131e-16", "2.2250738585072014e-308", "4.9406564584124654e-324");
    if o.ld_bits == 80 {
        float_macros(&mut b, "LDBL", "64", "18", "21", "(-16381)", "(-4931)", "16384", "4932",
                     "1.18973149535723176502e+4932L", "1.08420217248550443401e-19L", "3.36210314311209350626e-4932L",
                     "3.64519953188247460253e-4951L");
        b.s("#define __DECIMAL_DIG__ 21\n");
    } else if o.ld_bits == 128 {
        float_macros(&mut b, "LDBL", "113", "33", "36", "(-16381)", "(-4931)", "16384", "4932",
                     "1.18973149535723176508575932662800702e+4932L", "1.92592994438723585305597794258492732e-34L",
                     "3.36210314311209350626267781732175260e-4932L", "6.47517511943802511092443895822764655e-4966L");
        b.s("#define __DECIMAL_DIG__ 36\n");
    } else {
        float_macros(&mut b, "LDBL", "53", "15", "17", "(-1021)", "(-307)", "1024", "308", "1.7976931348623157e+308L",
                     "2.2204460492503131e-16L", "2.2250738585072014e-308L", "4.9406564584124654e-324L");
        b.s("#define __DECIMAL_DIG__ 17\n");
    }
    // the byte order (every target is little-endian), and the largest
    // alignment of a type: 16 (long double, __int128, max_align_t), or the
    // vector registers' width on x86-64 with AVX or AVX-512F
    b.s("#define __ORDER_LITTLE_ENDIAN__ 1234\n#define __ORDER_BIG_ENDIAN__ 4321\n#define __ORDER_PDP_ENDIAN__ 3412\n");
    b.s("#define __BYTE_ORDER__ __ORDER_LITTLE_ENDIAN__\n#define __FLOAT_WORD_ORDER__ __ORDER_LITTLE_ENDIAN__\n");
    b.s("#define __LITTLE_ENDIAN__ 1\n");
    let mut big = o.vec_reg;
    if big < 16 {
        big = 16;
    }
    b.s(u.f1("#define __BIGGEST_ALIGNMENT__ %s\n", u.idec(big)));
    return b.done();
}

// The __<T>_*__ macros of a floating type (<float.h>'s <T>_* values).
fn float_macros(b: *mut u.Buf, t: []u8, mant: []u8, dig: []u8, ddig: []u8, minexp: []u8, min10: []u8, maxexp: []u8,
                max10: []u8, max: []u8, eps: []u8, min: []u8, tmin: []u8) void {
    b.s(u.f3("#define __%s_MANT_DIG__ %s\n#define __%s_DIG__ ", t, mant, t));
    b.s(u.f3("%s\n#define __%s_DECIMAL_DIG__ %s\n", dig, t, ddig));
    b.s(u.f4("#define __%s_MIN_EXP__ %s\n#define __%s_MIN_10_EXP__ %s\n", t, minexp, t, min10));
    b.s(u.f4("#define __%s_MAX_EXP__ %s\n#define __%s_MAX_10_EXP__ %s\n", t, maxexp, t, max10));
    b.s(u.f4("#define __%s_MAX__ %s\n#define __%s_NORM_MAX__ %s\n", t, max, t, max));
    b.s(u.f4("#define __%s_EPSILON__ %s\n#define __%s_MIN__ %s\n", t, eps, t, min));
    b.s(u.f2("#define __%s_DENORM_MIN__ %s\n", t, tmin));
    b.s(u.f3("#define __%s_HAS_DENORM__ 1\n#define __%s_HAS_INFINITY__ 1\n#define __%s_HAS_QUIET_NAN__ 1\n", t, t, t));
    b.s(u.f1("#define __%s_IS_IEC_60559__ 1\n", t));
}
