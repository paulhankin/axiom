// =============================================================================
// cpp.ax - the C preprocessor and lexer (translation phases 1 to 6): from a
// source file to the tokens of ctok.ax.
//
// Phases 1 to 3 are cpp_lex.ax, 5 to 7 cpp_conv.ax, #if expressions
// cpp_expr.ax. This module is phase 4: directives, and macro replacement
// (C 6.10.3), done with a stack of contexts. A macro's replacement is read
// from a context pushed for it, and the macro is disabled until the context
// is left; an identifier naming a disabled macro, when read, is marked never
// to be replaced again (it is "painted"). Arguments are fully replaced
// first, in contexts of their own that end with the argument.
//
// Parts: context stack and macro expansion (cpp_expand.ax), #define and
// #undef (cpp_macros.ax), conditionals, assertions and directives
// (cpp_directives.ax), #include, #embed and dependencies (cpp_include.ax),
// #pragma and _Pragma (cpp_pragma.ax), and builtins and predefined macros
// (cpp_builtins.ax).
// =============================================================================
import "../diag.ax" as dg;
import "../target.ax" as tg;
import "../util.ax" as u;
import "copts.ax" as co;
import "cpp_conv.ax" as cv;
import "cpp_lex.ax" as lx;
import "cpp_out.ax" as cout;
import "cpragma.ax" as cp;
import "ctok.ax" as ct;

import part "cpp_builtins.ax";
import part "cpp_directives.ax";
import part "cpp_expand.ax";
import part "cpp_include.ax";
import part "cpp_macros.ax";
import part "cpp_pragma.ax";

// Macros the preprocessor itself replaces.
const B_NONE: i32 = 0;
const B_LINE: i32 = 1;         // __LINE__
const B_FILE: i32 = 2;         // __FILE__
const B_PRAGMA: i32 = 3;       // _Pragma (an operator; C99)
const B_HAS_INCLUDE: i32 = 4;  // __has_include (C23; in #if)
const B_HAS_EMBED: i32 = 5;    // __has_embed
const B_HAS_ATTR: i32 = 6;     // __has_c_attribute
// The compiler's in every mode (reserved identifiers): __has_include above,
// and __has_attribute, __has_builtin; in the GNU dialects only, the rest.
const B_HAS_GNU_ATTR: i32 = 7;      // __has_attribute
const B_HAS_BUILTIN: i32 = 8;       // __has_builtin
const B_HAS_INCLUDE_NEXT: i32 = 9;  // __has_include_next
const B_COUNTER: i32 = 10;          // __COUNTER__: 0, 1, 2 ... at each use
const B_INCLUDE_LEVEL: i32 = 11;    // __INCLUDE_LEVEL__: how deep the current file is included (0: the source)
const B_BASE_FILE: i32 = 12;        // __BASE_FILE__: the source file's name
const B_TIMESTAMP: i32 = 13;        // __TIMESTAMP__: the time the current file was last modified
// __DATE__ and __TIME__ (6.10.10.2), the time of the build (SOURCE_DATE_EPOCH
// if set): replaced by the preprocessor, so that the text of the predefined
// macros (the pseudo-file <built-in>, whose MD5 the line tables have) is
// the same in every build
const B_DATE: i32 = 14;
const B_TIME: i32 = 15;
const B_HAS_FEATURE: i32 = 16;  // __has_feature, __has_extension

const MAX_INCLUDE_DEPTH: usize = 200;
const MAX_ARG_DEPTH: i32 = 400;        // macro invocations nested in arguments
const MAX_EXPANSION: usize = 2000000;  // tokens made by replacing one macro of the text
let MONTHS: [12][]u8 = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

struct Macro {
    name: []u8,
    funclike: bool,
    variadic: bool,
    params: [][]u8,
    body: []lx.PTok,
    builtin: i32,
    disabled: bool,
    protected: bool,  // may not be defined or undefined (C 6.10.8)
    ours: bool,       // defined by one of the compiler's headers with the system's library
    sys: bool,        // defined by one of the system's headers (--c-lib=system)
    span: u.Span,     // where it is defined
}

struct Ctx {
    toks: []lx.PTok,
    pos: usize,
    mac: *mut Macro,  // enabled again when the context is left
}

struct Src {
    L: *mut lx.Lx,
    path: []u8,       // the file's path (its directory is searched for "..." includes)
    dir_index: i32,   // where the include path found it (find_file; -1: not by the path)
    presumed: []u8,   // __FILE__
    line_delta: i64,  // #line: the presumed line less the physical line
    cond_base: usize,
}

struct Cond {
    active: bool,  // this group is processed
    taken: bool,   // a group of this conditional has been
    seen_else: bool,
    dead: bool,  // the conditional is in a skipped group
    span: u.Span,
}

struct Arg {
    raw: []lx.PTok,
    exp: []lx.PTok,
    done: bool,  // exp is computed
}

struct PP {
    mac: bool,   // -g: the macros' definitions and the files recorded (u.g_macros)
    asm_: bool,  // preprocessing assembly (preprocess_asm): `#` and an unknown directive's line are a comment
    o: *co.COptions,
    macros: u.SymMap.[*mut Macro],
    files: u.List.[Src],
    ctx: u.List.[Ctx],
    floor: usize,     // contexts below this are not read
    list_mode: bool,  // reading a list (an argument, a directive's line): it ends at its end
    conds: u.List.[Cond],
    out: u.List.[lx.PTok],
    in_if: bool,  // expanding an #if expression: defined and __has_include are operators
    asserts: u.SymMap.[*mut u.List.[[]u8]],  // a GNU dialect's assertions: each predicate's answers (answer_key)
    collecting: i32,  // reading a macro invocation's arguments
    pend_bol: bool,   // a macro at the start of a line was replaced by nothing
    pend_space: bool,
    expanded: usize,  // tokens made since the last token of the text was read
    arg_depth: i32,
    fatal: bool,
    loaded: u.SymMap.[*mut u.SourceFile],
    inject: []lx.PTok,  // tokens a directive made (#embed), read before the file's
    inject_pos: usize,
    eof_tok: lx.PTok,
    found_index: i32,                    // find_file: where it found the file (-1: not by the include path)
    counter: i64,                        // __COUNTER__'s next value
    base_file: []u8,                     // __BASE_FILE__
    once: u.SymMap.[i32],                // the files of `#pragma once` (real paths)
    pushed: u.SymMap.[*mut MacroStack],  // #pragma push_macro: each name's saved definitions
    poisoned: u.SymMap.[i32],            // #pragma GCC poison
    packs: u.List.[Pack],                // #pragma pack(push): the values saved
    pack: u64,                           // the #pragma pack value in force (0: none)
    vis: u.List.[u64],                   // #pragma GCC visibility push: the values saved
    fnopts: u64,                         // #pragma GCC optimize and target: the options in force (cpragma.fn_options)
    importing: bool,                     // a GNU dialect's #import is being read: its file is read once
    fnopts_saved: u.List.[u64],          // #pragma GCC push_options: those saved
}

// The definitions #pragma push_macro saved for a name (nil: it was not defined).
struct MacroStack {
    defs: u.List.[*mut Macro],
}

struct Pack {
    value: u64,
    id: []u8,  // `push, identifier`: the name of the entry (empty if none)
}

fn nilmac() *mut Macro {
    return u.nil.[Macro]();
}

// -----------------------------------------------------------------------------
// Module state
// -----------------------------------------------------------------------------

/// --c-deps=<file>: the next program unit's dependencies are written there
/// ("-": to standard output) as a make rule, once it is preprocessed: its
/// targets (--c-deps-target, as given: quoted for make already), the
/// source, then each file it includes, once, in the order first read;
/// with g_deps_phony (--c-deps-phony) a rule with no prerequisites for each
/// header too, and with g_deps_no_system (--c-deps-no-system) without the
/// system's headers (the compiler's, those of the system's C library and
/// those found in --c-isystem directories).
pub let mut g_deps_out: []u8 = "";
pub let mut g_deps_targets: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
pub let mut g_deps_phony: bool = false;
pub let mut g_deps_no_system: bool = false;
// (the unit's files so far, and those seen: interned paths)
let mut g_deps: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
let mut g_deps_seen: u.SymMap.[i32] = u.SymMap.[i32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0), cap: 0, len: 0 };
// (recording: the unit is the program's, and dependencies are asked for)
let mut g_deps_on: bool = false;

/// Is the unit preprocessed next a library's (cc.check)? Its macros are
/// not described (-g).
pub let mut g_lib_unit: bool = false;

// The preprocessor of the last unit preprocessed (for macros_text).
let mut g_last: *mut PP = @ptr_from_int(*mut PP, 0);

// The names whose macro of the system's headers the program has used
// (keyword_away: one warning each).
let mut g_away: u.SymMap.[i32] = u.SymMap.[i32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0),
                                                  cap: 0, len: 0 };

// (-g: the #include whose file push_file starts next: its line, 0: none)
let mut INC: u.Span = u.Span.{ file: -1, start: 0, end: 0 };
let mut INC_LINE: i32 = 0;

// The build's date (else time) for __DATE__ and __TIME__: taken once.
let mut g_date: []u8 = "";
let mut g_time: []u8 = "";

// Where in the text of the predefined macros the target's begin
// (predefined_text), and that text's file.
let mut g_target_from: u32 = 0;
let mut g_builtin_file: i32 = -1;

// (preprocess_asm's: the preprocessing tokens, not converted, and the file)
let mut g_asm: bool = false;
let mut g_asm_out: u.List.[lx.PTok] = u.List.[lx.PTok].{ data: @ptr_from_int(*mut lx.PTok, 0), len: 0, cap: 0 };
let mut g_asm_file: i32 = 0;

// -----------------------------------------------------------------------------
// Tokens and lists
// -----------------------------------------------------------------------------
fn tok_list() u.List.[lx.PTok] {
    return u.List.[lx.PTok].empty();
}

// The list's items as an arena slice (the list is emptied).
fn frozen(l: *mut u.List.[lx.PTok]) []mut lx.PTok {
    let s = u.newn.[lx.PTok](l.len);
    @mem_copy(s, l.items());
    l.deinit();
    l.* = tok_list();
    return s;
}

fn with_eof(P: *PP, l: *mut u.List.[lx.PTok], sp: u.Span) []mut lx.PTok {
    let mut e = P.eof_tok;
    e.span = sp;
    l.push(e);
    return frozen(l);
}

fn spelling(ts: []lx.PTok) []u8 {
    let mut b = u.Buf.init();
    for k in 0..ts.len {
        if (k > 0) and ts[k].space {
            b.c(' ');
        }
        b.s(ts[k].text);
    }
    return b.done();
}

fn cur_src(P: *mut PP) *mut Src {
    return P.files.at_mut(P.files.len - 1);
}

fn mklit(kind: i32, id: i32, text: []u8, sp: u.Span) lx.PTok {
    let mut t = lx.mktok(kind, id, text, sp);
    t.exp = true;
    return t;
}

fn number_tok(v: i64, sp: u.Span) lx.PTok {
    return mklit(lx.PK_NUMBER, 0, u.intern(u.dec(v)), sp);
}

// A string literal whose characters are s.
fn string_tok(s: []u8, sp: u.Span) lx.PTok {
    let mut b = u.Buf.init();
    b.c('"');
    for c in s {
        if (c == '"') or (c == '\\') {
            b.c('\\');
        }
        b.c(c);
    }
    b.c('"');
    return mklit(lx.PK_STRING, ct.ENC_NONE, b.done(), sp);
}

// The physical line of a span.
fn line_of(sp: u.Span) i64 {
    return @as(i64, u.span_line(sp));
}

// Tokens after a directive's operands are errors.
fn extra(line: []lx.PTok, k: usize, what: []u8) void {
    if k < line.len {
        _ = dg.err(line[k].span, "C1070", u.f1("extra tokens at the end of #%s", what));
    }
}

fn all_digits(s: []u8) bool {
    for c in s {
        if not lx.is_digit(c) {
            return false;
        }
    }
    return s.len > 0;
}

// A source file of text that is no file's.
fn text_file(name: []u8, text: []u8) *mut u.SourceFile {
    let sf = u.new.[u.SourceFile]();
    sf.path = name;
    sf.display = name;
    sf.text = text;
    sf.id = @int_cast(i32, u.g_files.len);
    u.g_files.push(sf);
    return sf;
}

fn out_tok(P: *mut PP, t0: lx.PTok) void {
    let mut t = t0;
    if (P.poisoned.len > 0) and (t.kind == lx.PK_IDENT) and not t.exp and (P.poisoned.get(t.name) != 0) {
        poisoned(t.span, t.name);
    }
    if P.pend_bol {
        t.bol = true;
        P.pend_bol = false;
    }
    if P.pend_space {
        t.space = true;
        P.pend_space = false;
    }
    if P.ctx.len == 0 {
        P.expanded = 0;
    }
    P.out.push(t);
}

// Reads all of the file on top.
fn run_file(P: *mut PP) void {
    loop {
        let t = next_replaced(P);
        if t.kind == lx.PK_EOF {
            break;
        }
        out_tok(P, t);
    }
}

/// The text of the assembly source at `path` (a `.S` file) preprocessed,
/// with __ASSEMBLER__ defined as 1: its directives done, its macros
/// replaced, the other tokens as written (no C tokens are made of them), on
/// the lines they were on in the file (a line of an included file or of a
/// macro's expansion where it is used), `#` and an unknown directive at a
/// line's start a comment (as the assembler reads them). Errors are
/// reported through diag.ax.
pub fn preprocess_asm(path: []u8, o: *co.COptions) []u8 {
    let mut o2 = o.*;
    let mut ds = u.List.[co.Define].empty();
    ds.push(co.Define.{ name: "__ASSEMBLER__", body: "1", undef: false, assertion: false });
    for d in o.defines {
        ds.push(d);
    }
    o2.defines = ds.items();
    let oo = u.new.[co.COptions]();
    oo.* = o2;
    g_asm = true;
    lx.wasm_comments = tg.is_wasm();
    let toks = preprocess(path, oo);
    lx.wasm_comments = false;
    g_asm = false;
    _ = toks;
    let mut b = u.Buf.init();
    let mut line: i32 = 1;
    let mut first = true;
    for t in g_asm_out.items() {
        if t.kind == lx.PK_EOF {
            break;
        }
        if t.bol and not first {
            let lc = u.span_linecol(t.span);
            if (t.span.file == g_asm_file) and not t.exp and (lc.sl > line) {
                while line < lc.sl {
                    b.c('\n');
                    line += 1;
                }
            } else {
                b.c('\n');
                line += 1;
            }
        } else if t.bol and first {
            let lc = u.span_linecol(t.span);
            while (t.span.file == g_asm_file) and (line < lc.sl) {
                b.c('\n');
                line += 1;
            }
        } else if t.space {
            b.c(' ');
        }
        first = false;
        b.s(t.text);
    }
    b.c('\n');
    g_asm_out.deinit();
    g_asm_out = u.List.[lx.PTok].empty();
    return b.done();
}

/// The file preprocess_asm read last (its id in u.g_files).
pub fn asm_file_id() i32 {
    return g_asm_file;
}

/// The macros defined at the end of the unit preprocessed last, one
/// `#define` line each, sorted by name: the predefined ones and the
/// unit's (not those the preprocessor itself replaces, __LINE__ ...).
pub fn macros_text() []u8 {
    let mut lines = u.List.[[]u8].empty();
    if u.isnil(g_last) {
        return "";
    }
    let P = g_last;
    let ks = @slice_from_ptr(P.macros.keys, P.macros.cap);
    let vs = @slice_from_ptr(P.macros.vals, P.macros.cap);
    for k in 0..P.macros.cap {
        if (ks[k] == 0) or u.isnil(vs[k]) or (vs[k].builtin != 0) {
            continue;
        }
        let m = vs[k];
        let mut b = u.Buf.init();
        b.s("#define ");
        b.s(m.name);
        if m.funclike {
            b.c('(');
            for j in 0..m.params.len {
                if j > 0 {
                    b.s(", ");
                }
                let last = (j + 1) == m.params.len;
                if last and m.variadic and u.str_eq(m.params[j], "__VA_ARGS__") {
                    b.s("...");
                } else {
                    b.s(m.params[j]);
                    if last and m.variadic {
                        b.s("...");
                    }
                }
            }
            b.c(')');
        }
        if m.body.len > 0 {
            b.c(' ');
            b.s(spelling(m.body));
        }
        lines.push(b.done());
    }
    u.sort(lines.items_mut(), u.str_cmp);
    let mut out = u.Buf.init();
    for l in lines.items() {
        out.s(l);
        out.c('\n');
    }
    return out.done();
}

/// The tokens of the translation unit at `path`, preprocessed, ending with a
/// T_EOF token. Errors are reported through diag.ax.
pub fn preprocess(path: []u8, o: *co.COptions) u.List.[ct.Token] {
    let mut toks = u.List.[ct.Token].empty();
    let P = u.new.[PP]();
    P.o = o;
    g_last = P;
    begin_deps();
    g_away = u.SymMap.[i32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0), cap: 0, len: 0 };
    P.asm_ = g_asm;
    // (-g: the program's own units' macros, not the C library's)
    P.mac = (tg.g_debug == tg.DEBUG_FULL) and tg.g_debug_macros and not g_asm and not g_lib_unit;
    INC_LINE = 0;
    let mac0 = u.g_macros.len;
    P.eof_tok = lx.mktok(lx.PK_EOF, 0, "", u.mkspan(0, 0, 0));
    P.eof_tok.bol = true;
    P.inject = u.nil_slice.[lx.PTok]();
    lx.gnu = o.gnu;
    ct.g_no_ext_float = o.system_lib and not tg.is_darwin() and not o.gnu_compat;
    ct.g_declspec = o.declspec;
    ct.g_iso_names = o.iso_names;
    cout.g_line_directive = not o.gnu;
    P.asserts = u.SymMap.[*mut u.List.[[]u8]].{ keys: u.nil.[usize](), vals: u.nil.[*mut u.List.[[]u8]](), cap: 0,
                                                len: 0 };
    if o.gnu {
        target_assertions(P);
    }
    add_builtin(P, "__LINE__", B_LINE);
    add_builtin(P, "__FILE__", B_FILE);
    // (before C99 _Pragma is a reserved identifier: an operator there is reported)
    add_builtin(P, "_Pragma", B_PRAGMA);
    cp.begin_unit();
    P.base_file = path;
    add_builtin(P, "__has_include", B_HAS_INCLUDE);
    add_builtin(P, "__has_attribute", B_HAS_GNU_ATTR);
    add_builtin(P, "__has_builtin", B_HAS_BUILTIN);
    add_builtin(P, "__has_feature", B_HAS_FEATURE);
    add_builtin(P, "__has_extension", B_HAS_FEATURE);
    if o.std >= co.C23 {
        add_builtin(P, "__has_embed", B_HAS_EMBED);
    }
    if (o.std >= co.C23) or o.gnu {
        add_builtin(P, "__has_c_attribute", B_HAS_ATTR);
    }
    if o.gnu {
        add_builtin(P, "__has_include_next", B_HAS_INCLUDE_NEXT);
        add_builtin(P, "__COUNTER__", B_COUNTER);
        add_builtin(P, "__INCLUDE_LEVEL__", B_INCLUDE_LEVEL);
        add_builtin(P, "__BASE_FILE__", B_BASE_FILE);
        add_builtin(P, "__TIMESTAMP__", B_TIMESTAMP);
    }
    add_builtin(P, "__DATE__", B_DATE);
    add_builtin(P, "__TIME__", B_TIME);
    // the predefined macros, then -D and -U
    let bf = text_file("<built-in>", predefined_text(P));
    g_builtin_file = bf.id;
    push_file(P, bf, "<built-in>");
    run_file(P);
    _ = P.files.pop();
    protect_all(P);
    push_file(P, text_file("<command line>", options_text(P)), "<command line>");
    run_file(P);
    _ = P.files.pop();
    P.out.clear();
    let sf = load(P, path);
    if P.mac and u.isnil(sf) {
        u.g_macros.len = mac0;
        P.mac = false;
    }
    if u.isnil(sf) {
        dg.emit_fatal(false, "E0211", u.f1("cannot read '%s'", path));
        cv.convert(P.out.items(), o, &mut toks);
        return toks;
    }
    push_file(P, sf, path);
    note_dep(P, path, true);
    // (--c-include: each file as if included before the source's first
    // line, the first given read first; looked for in the current
    // directory first, then on the include path)
    let mut k = o.includes.len;
    while k > 0 {
        k -= 1;
        let name = o.includes[k];
        let mut ip = u.nosym();
        if u.is_file(name) {
            ip = name;
        } else {
            ip = find_file_from(P, name, 0);
        }
        let isf = load(P, u.pick(u.isnos(ip), name, ip));
        if u.isnos(ip) or u.isnil(isf) {
            _ = dg.err(u.mkspan(sf.id, 0, 0), "C1081",
                       u.f1("cannot find the file \"%s\" to include before the source (--c-include)", name));
            continue;
        }
        push_file(P, isf, ip);
        cur_src(P).dir_index = P.found_index;
        note_dep(P, ip, false);
    }
    run_file(P);
    end_deps();
    if P.mac {
        u.g_macros.push(u.MacroEv.{ kind: 4, at: -1, line: 0, file: -1, text: "" });
    }
    // (the end of the text is the end of the file)
    let mut e = P.eof_tok;
    e.span = u.mkspan(sf.id, @int_cast(u32, sf.text.len), @int_cast(u32, sf.text.len));
    P.out.push(e);
    if P.asm_ {
        // (assembly: its tokens as they are)
        g_asm_out = P.out;
        g_asm_file = sf.id;
        P.out = u.List.[lx.PTok].empty();
        return toks;
    }
    // (as many tokens at most as there are preprocessing tokens: the list is
    // not grown, and theirs is given back once converted)
    toks.reserve(P.out.len);
    cv.convert(P.out.items(), o, &mut toks);
    P.out.deinit();
    P.out = u.List.[lx.PTok].empty();
    return toks;
}

/// The preprocessed text of `toks`, as --emit=c-pp writes it: the tokens'
/// spellings, on the lines and with the spacing they had, and the pragmas
/// later phases read (pack, GCC visibility, weak).
pub fn text_of(toks: []ct.Token) []u8 {
    return cout.text(toks, cp.lines());
}

/// The tokens, one to a line with their values (--emit=c-tokens, for tests).
pub fn tokens_text(toks: []ct.Token) []u8 {
    return cout.dump(toks);
}
