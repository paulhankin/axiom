    "_Decimal128",
    "__builtin_va_list",
    "__axiom_int64",
];
let KW_IDS: [61]i32 = [
    K_AUTO,
    K_BREAK,
    K_CASE,
    K_CHAR,
    K_CONST,
    K_CONTINUE,
    K_DEFAULT,
