    K_VOID,
    K_VOLATILE,
    K_WHILE,
    K_INLINE,
    K_RESTRICT,
    K_BOOL,
    K_COMPLEX,
    K_IMAGINARY,
    K_ALIGNAS,
    K_ALIGNOF,
