/// The keyword `name` is under standard `std` (a copts constant), or 0.
pub fn keyword_id(name: []u8, std: i32) i32 {
    for k in 0..KW_NAMES.len {
        if (KW_SINCE[k] <= std) and u.str_eq(KW_NAMES[k], name) {
            if g_no_ext_float and is_ext_float(KW_IDS[k]) {
                return 0;
            }
            return KW_IDS[k];
        }
    }
    return 0;
}

// _Float16 ... _Float64x, _Float128 and __float128 (g_no_ext_float).
fn is_ext_float(k: i32) bool {
    return (k >= K_FLOAT128) and (k <= K_FLOAT64X);
}

// The GNU dialects' keywords, and what each is.
let GNU_NAMES: [26][]u8 = ["__extension__", "__attribute__", "__attribute", "asm", "__asm", "__asm__", "__auto_type",
                           "__label__", "__int128", "__inline", "__inline__", "__const", "__const__", "__volatile",
                           "__volatile__", "__restrict", "__restrict__", "__signed", "__signed__", "__alignof",
                           "__alignof__", "__typeof", "__typeof__", "typeof", "__thread", "__float128"];
let GNU_IDS: [26]i32 = [K_EXTENSION, K_ATTRIBUTE, K_ATTRIBUTE, K_ASM, K_ASM, K_ASM, K_AUTO_TYPE, K_LABEL, K_INT128,
                        K_INLINE, K_INLINE, K_CONST, K_CONST, K_VOLATILE, K_VOLATILE, K_RESTRICT, K_RESTRICT, K_SIGNED,
                        K_SIGNED, K_ALIGNOF, K_ALIGNOF, K_TYPEOF, K_TYPEOF, K_TYPEOF, K_THREAD_LOCAL, K_FLOAT128];

/// With the system's C library (--c-lib=system) _Float16 ... _Float64x,
/// _Float128 and __float128 are not keywords: its headers, which this front
/// end does not tell of them, define them as types of their own (typedefs
/// of float, double, long double), as for a compiler without them.
pub let mut g_no_ext_float: bool = false;

/// The keyword `name` is under standard `std`, in its GNU dialect if `gnu`
/// (where `inline` is one from gnu89 on), or 0.
pub fn keyword_id_in(name: []u8, std: i32, gnu: bool) i32 {
    let k = keyword_id(name, std);
    if (k != 0) or not gnu or (name.len < 3) {
        return k;
    }
    if u.str_eq(name, "inline") {
        return K_INLINE;
    }
    if (name[0] != '_') and (name[0] != 'a') and (name[0] != 't') {
        return 0;
    }
    for i in 0..GNU_NAMES.len {
        if u.str_eq(GNU_NAMES[i], name) {
            if is_ext_float(GNU_IDS[i]) and g_no_ext_float {
                return 0;
            }
            return GNU_IDS[i];
        }
    }
    return 0;
}
