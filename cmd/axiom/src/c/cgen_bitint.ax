// =============================================================================
// cgen_bitint.ax - IR generation for the bit-precise integer types (C23
// _BitInt(N)): a value lives in an IR integer of its storage width
// (ctypes.storage_bits), sign-extended (signed) or zero-extended (unsigned)
// from N bits. Every operation whose result may leave that form (+, -, *,
// <<, unary - and ~, a conversion to the type) is followed by norm, so that
// unsigned arithmetic wraps at N bits and comparisons, division, right
// shifts and conversions to wider types can use the storage's bits as they
// are.
// =============================================================================
import "../ir.ax" as ir;
import "cgen.ax" as cg;
import "ctypes.ax" as cty;

/// v (an IR integer of t's storage width) in the canonical form of t's
/// values when t is a bit-precise integer type narrower than its storage;
/// otherwise v.
pub fn norm(v: *mut ir.Value, t: *cty.CType) *mut ir.Value {
    let b = t.unq;
    if b.kind != cty.TK_BITINT {
        return v;
    }
    let w = cty.storage_bits(b);
    if b.bits >= w {
        return v;
    }
    if not b.is_signed {
        let mask = (@as(u64, 1) << @as(u32, @bit_cast(u32, b.bits))) - 1;
        return ir.and_(cg.B, v, ir.cint(v.ty, mask));
    }
    let k = ir.cint(v.ty, @as(u64, @bit_cast(u32, w - b.bits)));
    return ir.binop(cg.B, ir.OP_ASHR, ir.binop(cg.B, ir.OP_SHL, v, k), k);
}
