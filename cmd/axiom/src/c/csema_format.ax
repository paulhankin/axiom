// =============================================================================
// csema_format.ax - format string archetype and directive scanning, part of
// csema.ax.
// =============================================================================
import "../util.ax" as u;
import "cast.ax" as cast;
import "ctypes.ax" as cty;

/// The archetypes (the attribute's first argument).
pub const FK_NONE: i32 = 0;
pub const FK_PRINTF: i32 = 1;
pub const FK_SCANF: i32 = 2;
pub const FK_STRFTIME: i32 = 3;

/// The archetype named `name` (printf, __printf__, gnu_printf, scanf,
/// gnu_scanf, strftime, gnu_strftime), or FK_NONE.
pub fn fmt_archetype(name0: []u8) i32 {
    let mut name = name0;
    if (name.len > 4) and u.starts(name, "__") and u.ends(name, "__") {
        name = name[2..name.len - 2];
    }
    if u.starts(name, "gnu_") {
        name = name[4..];
    }
    if u.str_eq(name, "printf") {
        return FK_PRINTF;
    }
    if u.str_eq(name, "scanf") {
        return FK_SCANF;
    }
    if u.str_eq(name, "strftime") {
        return FK_STRFTIME;
    }
    return FK_NONE;
}

fn fmt_level() i32 {
    return opts().warn_format;
}

fn fmt_warn(lv: i32, sp: u.Span, code: []u8, msg: []u8) void {
    if fmt_level() >= lv {
        warn(sp, code, msg);
    }
}

// e without the conversions semantic analysis made (array decay, value conversions).
fn fmt_strip(e: *mut cast.Expr) *mut cast.Expr {
    let mut x = e;
    while (x.kind == cast.ExprKind.CAST) and u.isnil(x.tname) and
          ((x.op == cast.CV_VALUE) or (x.op == cast.CV_ADECAY)) {
        x = x.a;
    }
    return x;
}

/// What the format checker needs of a function's attributes: its format
/// archetype, the format's parameter (from 1), the first variadic one (0:
/// a va_list's), or of a format_arg function the parameter its result
/// comes from.
pub struct FmtSpec {
    pub kind: i32,
    pub index: i32,
    pub first: i32,
}

// The name a program wrote for a function of the library that its header
// renames (C23's scanf family is __axc_scanf_c23, ...: <stdio.h>).
fn public_name(n: []u8) []u8 {
    let pre = "__axc_";
    let suf = "_c23";
    if (n.len > (pre.len + suf.len)) and u.str_eq(n[0..pre.len], pre) and u.str_eq(n[n.len - suf.len..], suf) {
        return n[pre.len..n.len - suf.len];
    }
    return n;
}

/// Checks call e (typed) of function f, declared with format(kind, index,
/// first); fa: how to find a format_arg function's argument (the
/// parameter number of the callee of a call, or 0).
fn fmt_check_call(e: *mut cast.Expr, fname0: []u8, sp: FmtSpec) void {
    let fname = public_name(fname0);
    if (fmt_level() == 0) or (sp.index < 1) or (@as(usize, @bit_cast(u32, sp.index)) > e.args.len) {
        return;
    }
    let fe = e.args.get(@as(usize, @bit_cast(u32, sp.index - 1)));
    let mut x = fmt_strip(fe);
    // (a call of a format_arg function: its argument's format)
    loop {
        if let .some(y) = format_arg_of(x) {
            x = fmt_strip(y);
        } else {
            break;
        }
    }
    if (x.kind != cast.ExprKind.STRING) or (x.tok.prefix != 0) {
        if (sp.first != 0) and (e.args.len <= @as(usize, @bit_cast(u32, sp.index))) {
            fmt_warn(2, fe.span, "C4134", u.f1("the format of '%s' is not a string literal, and no argument follows it",
                                               fname));
        } else {
            fmt_warn(2, fe.span, "C4134", u.f1("the format of '%s' is not a string literal", fname));
        }
        return;
    }
    let us = x.tok.units;
    let mut s: []mut u8 = [];
    if us.len > 0 {
        s = u.newn.[u8](us.len);
        for k in 0..us.len {
            s[k] = @truncate(u8, us[k]);
        }
    }
    let c = u.new.[FmtChecker]();
    c.* = FmtChecker.{ e: e, fname: fname, sp: x.span, kind: sp.kind, first: sp.first, used: 0, max_pos: 0,
                       plain: false, posit: false, bad: false };
    if sp.kind == FK_STRFTIME {
        strftime(c, s);
        return;
    }
    directives(c, s);
    if c.bad or (sp.first == 0) {
        return;
    }
    let nargs = e.args.len - @min(e.args.len, @as(usize, @bit_cast(u32, sp.first - 1)));
    let mut used = c.used;
    if c.posit {
        used = c.max_pos;
    }
    if nargs > used {
        fmt_warn(2, e.args.get(@as(usize, @bit_cast(u32, sp.first - 1)) + used).span, "C4132",
                 u.f2("more arguments than the format of '%s' uses (it uses %s)", fname, u.zdec(used)));
    }
}

nocopy struct FmtChecker {
    e: *mut cast.Expr,
    fname: []u8,
    sp: u.Span,  // the format string's
    kind: i32,
    first: i32,
    used: usize,     // the arguments the plain directives used
    max_pos: usize,  // the largest %n$ position
    plain: bool,     // a directive without a position seen
    posit: bool,     // one with a position seen
    bad: bool,       // a directive that is not one: the arguments are not counted
}

// The argument for the k-th (from 0) value the format uses (.none if there is none: reported).
fn arg_at(c: *mut FmtChecker, k: usize, what: []u8) ?*mut cast.Expr {
    if c.first == 0 {
        return .none;  // (a va_list's: nothing to check)
    }
    let i = @as(usize, @bit_cast(u32, c.first - 1)) + k;
    if i >= c.e.args.len {
        fmt_warn(1, c.sp, "C4131", u.f3("too few arguments for the format of '%s': %s needs argument %s", c.fname, what,
                                        u.zdec(i + 1)));
        c.bad = true;
        return .none;
    }
    return .some(c.e.args.get(i));
}

// What a conversion takes (FmtWant.cat).
const W_INT: i32 = 1;     // an integer (after promotion)
const W_FLOAT: i32 = 2;   // a floating value (double, or long double)
const W_PTR: i32 = 3;     // a pointer (to anything: %p)
const W_STR: i32 = 4;     // a pointer to a character type (or wchar_t: wide)
const W_INTPTR: i32 = 5;  // a pointer to an integer (%n; scanf's integers)
const W_FLTPTR: i32 = 6;  // a pointer to a floating object (scanf)
const W_PTRPTR: i32 = 7;  // a pointer to a void pointer (scanf %p)

struct FmtWant {
    cat: i32,
    bits: i32,              // the width the argument (or pointed-to object) has, 0: any
    signed_: i32,           // 1 signed, 0 unsigned, -1 either
    name: []u8,             // the type it takes, for the message
    wide: bool,             // W_STR: wchar_t
    rank: ?*mut cty.CType,  // the exact type, where one is (the same size but another type: level 2)
}

fn fmt_want(cat: i32, bits: i32, sg: i32, name: []u8, rank: ?*mut cty.CType) FmtWant {
    return FmtWant.{ cat: cat, bits: bits, signed_: sg, name: name, wide: false, rank: rank };
}

fn is_digit(ch: u8) bool {
    return (ch >= '0') and (ch <= '9');
}

// A number at s[i..]: its value and the index after it (value -1: none).
fn number(s: []u8, i0: usize, end: *mut usize) i64 {
    let mut i = i0;
    let mut v: i64 = -1;
    while (i < s.len) and is_digit(s[i]) {
        if v < 0 {
            v = 0;
        }
        if v < 100000000 {
            v = (v * 10) + @as(i64, s[i] - '0');
        }
        i += 1;
    }
    end.* = i;
    return v;
}

// The format's directives, each checked with its arguments.
fn directives(c: *mut FmtChecker, s: []u8) void {
    let mut i: usize = 0;
    while i < s.len {
        if s[i] != '%' {
            i += 1;
            continue;
        }
        let start = i;
        i += 1;
        if i >= s.len {
            fmt_warn(1, c.sp, "C4133", u.f1("the format of '%s' ends in the middle of a conversion specification",
                                            c.fname));
            c.bad = true;
            return;
        }
        if s[i] == '%' {
            i += 1;
            continue;
        }
        let next = fmt_spec(c, s, start);
        if c.bad {
            return;
        }
        i = next;
    }
}

// The position of a %n$ (or *m$) at s[i..], if there is one: its value
// (from 1) and the index after the $; 0 if there is none.
fn position(s: []u8, i: usize, end: *mut usize) usize {
    let mut j: usize = 0;
    let v = number(s, i, &mut j);
    if (v > 0) and (j < s.len) and (s[j] == '$') {
        end.* = j + 1;
        return @truncate(usize, @bit_cast(u64, v));
    }
    end.* = i;
    return 0;
}

// The argument a directive (or its * width or precision) takes: at a %n$
// position, or the next one.
fn take(c: *mut FmtChecker, pos: usize, what: []u8) ?*mut cast.Expr {
    if pos > 0 {
        if c.plain {
            mixed(c);
            return .none;
        }
        c.posit = true;
        if pos > c.max_pos {
            c.max_pos = pos;
        }
        return arg_at(c, pos - 1, what);
    }
    if c.posit {
        mixed(c);
        return .none;
    }
    c.plain = true;
    let k = c.used;
    c.used += 1;
    return arg_at(c, k, what);
}

fn mixed(c: *mut FmtChecker) void {
    fmt_warn(1, c.sp, "C4133", u.f1("the format of '%s' mixes %%n$ argument positions with plain conversions",
                                    c.fname));
    c.bad = true;
}

// The length modifiers (FmtSpec.len).
const L_NONE: i32 = 0;
const L_HH: i32 = 1;
const L_H: i32 = 2;
const L_L: i32 = 3;
const L_LL: i32 = 4;
const L_J: i32 = 5;
const L_Z: i32 = 6;
const L_T: i32 = 7;
const L_BIGL: i32 = 8;
const L_W: i32 = 9;     // wN (C23): an intN_t
const L_WF: i32 = 10;   // wfN (C23): an int_fastN_t
const L_DH: i32 = 11;   // H (C23): a _Decimal32
const L_DD: i32 = 12;   // D: a _Decimal64
const L_DDD: i32 = 13;  // DD: a _Decimal128 (or a _Decimal64x: dd64x)

// Is t _Decimal64x where the format wants a _Decimal128 (rank)? The
// standard gives _Decimal64x no length modifier; this library's printf and
// scanf take it with DD, as the type has _Decimal128's format and is passed
// as it is (docs/c.md).
fn dd64x(rank: *cty.CType, t: *cty.CType) bool {
    return (rank.unq == cty.t_dec128) and (t.unq == cty.t_dec64x);
}

// One conversion specification at s[start] ('%'): checked with its
// argument(s); the index after it.
fn fmt_spec(c: *mut FmtChecker, s: []u8, start: usize) usize {
    let mut i = start + 1;
    let pos = position(s, i, &mut i);
    let scan = c.kind == FK_SCANF;
    let mut flags: []u8 = "";
    let mut suppress = false;
    if scan {
        if (i < s.len) and (s[i] == '*') {
            suppress = true;
            i += 1;
        }
    } else {
        let fs = i;
        while (i < s.len) and
              ((s[i] == '-') or (s[i] == '+') or (s[i] == ' ') or (s[i] == '#') or (s[i] == '0') or (s[i] == '\'')) {
            i += 1;
        }
        flags = s[fs..i];
    }
    // the width, and the precision (printf)
    if not scan and (i < s.len) and (s[i] == '*') {
        i += 1;
        let p = position(s, i, &mut i);
        fmt_star(c, p, "a '*' width");
        if c.bad {
            return i;
        }
    } else {
        let mut j: usize = 0;
        _ = number(s, i, &mut j);
        i = j;
    }
    let mut has_prec = false;
    if not scan and (i < s.len) and (s[i] == '.') {
        has_prec = true;
        i += 1;
        if (i < s.len) and (s[i] == '*') {
            i += 1;
            let p = position(s, i, &mut i);
            fmt_star(c, p, "a '*' precision");
            if c.bad {
                return i;
            }
        } else {
            let mut j: usize = 0;
            _ = number(s, i, &mut j);
            i = j;
        }
    }
    // the length modifier
    let mut len = L_NONE;
    let mut wbits: i32 = 0;
    if i < s.len {
        let ch = s[i];
        if ch == 'h' {
            len = L_H;
            i += 1;
            if (i < s.len) and (s[i] == 'h') {
                len = L_HH;
                i += 1;
            }
        } else if ch == 'l' {
            len = L_L;
            i += 1;
            if (i < s.len) and (s[i] == 'l') {
                len = L_LL;
                i += 1;
            }
        } else if (ch == 'j') or (ch == 'z') or (ch == 't') or (ch == 'L') {
            let ls: [4]i32 = [L_J, L_Z, L_T, L_BIGL];
            let cs_ = "jztL";
            for k in @as(usize, 0)..4 {
                if cs_[k] == ch {
                    len = ls[k];
                }
            }
            i += 1;
        } else if (ch == 'H') or (ch == 'D') {
            // the decimal floating types' (C23 7.23.6.1p7: H, D, DD with a,
            // e, f, g)
            i += 1;
            len = L_DH;
            if ch == 'D' {
                len = L_DD;
                if (i < s.len) and (s[i] == 'D') {
                    len = L_DDD;
                    i += 1;
                }
            }
        } else if ch == 'w' {
            i += 1;
            len = L_W;
            if (i < s.len) and (s[i] == 'f') {
                len = L_WF;
                i += 1;
            }
            let mut j: usize = 0;
            let n = number(s, i, &mut j);
            i = j;
            wbits = @truncate(i32, n);
            if (n != 8) and (n != 16) and (n != 32) and (n != 64) {
                return bad_spec(c, s, start, i, "a length modifier wN or wfN of a width other than 8, 16, 32 or 64");
            }
        }
    }
    if i >= s.len {
        fmt_warn(1, c.sp, "C4133", u.f1("the format of '%s' ends in the middle of a conversion specification",
                                        c.fname));
        c.bad = true;
        return i;
    }
    let spec_conv = s[i];
    i += 1;
    if scan and (spec_conv == '[') {
        // the scanset: up to the next ']' (one first is a member)
        if (i < s.len) and (s[i] == '^') {
            i += 1;
        }
        if (i < s.len) and (s[i] == ']') {
            i += 1;
        }
        while (i < s.len) and (s[i] != ']') {
            i += 1;
        }
        if i >= s.len {
            fmt_warn(1, c.sp, "C4133", u.f1("a scanset of the format of '%s' has no closing ']'", c.fname));
            c.bad = true;
            return i;
        }
        i += 1;
    }
    let text = s[start..i];
    let w = wanted(c, spec_conv, len, wbits, scan);
    if w.cat == 0 {
        return bad_spec(c, s, start, i, "");
    }
    if not scan {
        flag_checks(c, text, spec_conv, flags, has_prec);
    }
    if spec_conv == 'n' {
        fmt_warn(2, c.sp, "C4135", u.f2("'%s' in the format of '%s' writes the count through its argument", text,
                                        c.fname));
    }
    if suppress {
        return i;
    }
    if let .some(a) = take(c, pos, u.f1("'%s'", text)) {
        match_arg(c, a, w, text);
    }
    return i;
}

fn bad_spec(c: *mut FmtChecker, s: []u8, start: usize, i: usize, why: []u8) usize {
    let mut end = i;
    if end > s.len {
        end = s.len;
    }
    let mut w = why;
    if w.len == 0 {
        w = "an unknown conversion, or a length modifier it does not take";
    }
    fmt_warn(1, c.sp, "C4133", u.f3("'%s' in the format of '%s' is no conversion specification: %s", s[start..end],
                                    c.fname, w));
    c.bad = true;
    return end;
}
