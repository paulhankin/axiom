// =============================================================================
// cgen_wint.ax - IR generation for the integer types wider than 64 bits
// (cty.is_wint: __int128 of the GNU dialects, C23's _BitInt(N) for N > 64).
// Part of cgen.ax (see also cgen_wint_ops.ax).
//
// The backends have no integers wider than 64 bits: a value is its limbs
// (cty.limbs of them, 64 bits each, the least significant first) in memory,
// as a structure's value is (cgen.ax): rv gives its address, an object's
// own or a temporary's, never written through; each operation writes its
// result into a new temporary, which scalar replacement takes apart into
// SSA values again (sroa.ax), so that a two-limb value lives in two
// registers.
//
// A value is kept in the form std/c/rt/wideint.ax's wi_norm gives: reduced
// to its type's width and sign- or zero-extended from there through its
// storage (wint_norm, after every operation whose result may leave it; the
// bits beyond the width of a value that arrives as an argument or result
// are unspecified in the ABIs, and are brought to it there: cgen_va.ax).
//
// Two limbs (__int128, _BitInt(65..128)) are computed inline: + and -
// with a carry, * from the 64x64->128 product (IN_UMULH on the native
// targets, four 32-bit products on WebAssembly), shifts by any count with
// selects, comparisons, the bitwise operations; / and % inline when both
// operands are below 2^64, else by wideint.ax's wi_divmod. Wider types call
// wideint.ax's functions for everything but the bitwise operations and
// moves (generated only when called: ld_fn).
// =============================================================================
import "../ir.ax" as ir;
import "../target.ax" as tg;
import "../util.ax" as u;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;

fn wint_c64(v: u64) *mut ir.Value {
    return ir.cint(i64t(), v);
}

fn wint_sg(t: *cty.CType) bool {
    return t.unq.is_signed and (t.unq.kind != cty.TK_BOOL);
}

/// A new temporary for a value of type t (wider than 64 bits).
fn wint_temp(t: *mut cty.CType) *mut ir.Value {
    return alloca(t.unq, "wint");
}

// p + 8k.
fn wint_at(p: *mut ir.Value, k: usize) *mut ir.Value {
    if k == 0 {
        return p;
    }
    return ir.ptradd(B, p, usz(@as(u64, k) * 8));
}

/// Limb k of the value at p.
fn wint_limb(p: *mut ir.Value, k: usize) *mut ir.Value {
    let v = ir.load(B, i64t(), wint_at(p, k));
    v.align = 8;
    return v;
}

fn wint_set_limb(p: *mut ir.Value, k: usize, v: *mut ir.Value) void {
    let s = ir.store(B, v, wint_at(p, k));
    s.align = 8;
}

// The sign of 64-bit x as a limb of 0s or 1s.
fn wint_sign_fill(x: *mut ir.Value) *mut ir.Value {
    return ir.binop(B, ir.OP_ASHR, x, wint_c64(63));
}

// A call of wideint.ax's (or ldouble.ax's) function `name` with arguments
// xs, each integer argument resized to the parameter's IR type.
fn wint_call(name: []u8, xs: []mut *mut ir.Value) *mut ir.Value {
    let f = ld_fn(name);
    let fty = ir.fnp_of(f).ty;
    for i in 0..xs.len {
        let pt = fty.params[i];
        let x = xs[i];
        if (pt.kind == ir.T_INT) and (x.ty.kind == ir.T_INT) and (pt.bits != x.ty.bits) {
            if pt.bits < x.ty.bits {
                xs[i] = ir.trunc(B, x, pt);
            } else {
                xs[i] = ir.zext(B, x, pt);
            }
        }
    }
    return ir.call(B, fty, f, xs);
}

fn wint_cbool(b: bool) *mut ir.Value {
    if b {
        return ir.cint(ir.t_int(8), 1);
    }
    return ir.cint(ir.t_int(8), 0);
}

fn wint_usz(n: usize) *mut ir.Value {
    return usz(@as(u64, n));
}

/// Reduces the value at p (of type t, in a temporary) to t's width: the
/// limb with the top bit sign- or zero-extended from it, and the limbs
/// above it (AArch64's storage in pairs) filled.
fn wint_norm(t: *cty.CType, p: *mut ir.Value) void {
    let b = t.unq;
    let n = cty.limbs(b);
    if b.bits == cty.storage_bits(b) {
        return;
    }
    let top = @int_cast(usize, (b.bits - 1) / 64);
    let used = b.bits - (@int_cast(i32, top) * 64);
    let mut v = wint_limb(p, top);
    if used < 64 {
        v = wint_norm_limb(v, used, wint_sg(b));
        wint_set_limb(p, top, v);
    }
    let mut fill = wint_c64(0);
    if wint_sg(b) {
        fill = wint_sign_fill(v);
    }
    for k in (top + 1)..n {
        wint_set_limb(p, k, fill);
    }
}

// The low `used` bits of limb v, sign- or zero-extended.
fn wint_norm_limb(v: *mut ir.Value, used: i32, sg: bool) *mut ir.Value {
    if used >= 64 {
        return v;
    }
    if not sg {
        let mask = (@as(u64, 1) << @as(u32, @bit_cast(u32, used))) - 1;
        return ir.and_(B, v, wint_c64(mask));
    }
    let k = wint_c64(@as(u64, @bit_cast(u32, 64 - used)));
    return ir.binop(B, ir.OP_ASHR, ir.binop(B, ir.OP_SHL, v, k), k);
}

// A new temporary of type t (two limbs) holding lo and hi, hi reduced to
// t's width.
fn wint_pair(t: *mut cty.CType, lo: *mut ir.Value, hi: *mut ir.Value) *mut ir.Value {
    let r = wint_temp(t);
    wint_set_limb(r, 0, lo);
    wint_set_limb(r, 1, wint_norm_limb(hi, t.unq.bits - 64, wint_sg(t)));
    return r;
}

// The constants made so far (n > 4 limbs: a constant global each).
struct WintConst {
    v: []u64,
    g: *mut ir.Value,
}

/// The value v (t's limbs) of type t: a temporary the limbs are stored
/// into (constants again after scalar replacement), or for a value of more
/// than four limbs a constant global's memory, never written.
fn wint_constant(t: *mut cty.CType, v: []u64) *mut ir.Value {
    let n = v.len;
    if n <= 4 {
        let r = wint_temp(t);
        for k in 0..n {
            wint_set_limb(r, k, wint_c64(v[k]));
        }
        return r;
    }
    if wint_consts_m != M {
        wint_consts.clear();
        wint_consts_m = M;
    }
    for &mut c in wint_consts.items_mut() {
        if c.v.len == n {
            let mut same = true;
            for k in 0..n {
                if c.v[k] != v[k] {
                    same = false;
                    break;
                }
            }
            if same {
                return c.g;
            }
        }
    }
    let xs = u.newn.[*mut ir.Value](n + 1);
    for k in 0..n {
        xs[k] = wint_c64(v[k]);
    }
    let init = ir.carray(i64t(), xs[0..n]);
    let g = ir.add_global(M, init.ty, ".wiconst");
    g.init = init;
    g.linkage = ir.LINK_INTERNAL;
    g.is_const = true;
    g.align = 16;
    wint_consts.push(WintConst.{ v: v, g: g.val });
    return g.val;
}

/// Copies the value of type t at src to dst (volatile: the object at dst or
/// src is volatile, and is accessed as 8-byte volatile loads and stores).
fn wint_copy(t: *cty.CType, dst: *mut ir.Value, src: *mut ir.Value, volatile: bool) void {
    let n = cty.limbs(t);
    if not volatile {
        let m = ir.memop(B, ir.OP_MEMMOVE, dst, src, usz(@as(u64, n) * 8));
        m.cv = ir.MEMMOVE_SAME_OR_APART;
        return;
    }
    for k in 0..n {
        let x = wint_limb(src, k);
        x.flags = x.flags | ir.F_VOLATILE;
        let s = ir.store(B, x, wint_at(dst, k));
        s.align = 8;
        s.flags = s.flags | ir.F_VOLATILE;
    }
}

/// A copy of the value of type t at p in a new temporary (the value an
/// object has now, which stores into the object do not change), reduced to
/// t's width: the bits beyond it in an object are unspecified in the ABIs,
/// and code compiled elsewhere may not store them.
fn wint_snapshot(t: *mut cty.CType, p: *mut ir.Value, volatile: bool) *mut ir.Value {
    let r = wint_temp(t);
    wint_copy(t, r, p, volatile);
    wint_norm(t, r);
    return r;
}

// -----------------------------------------------------------------------------
// Arithmetic
// -----------------------------------------------------------------------------

// The high 64 bits of the unsigned 128-bit product of x and y.
fn wint_umulh(x: *mut ir.Value, y: *mut ir.Value) *mut ir.Value {
    if not is_wasm {
        let mut xs: [2]*mut ir.Value = [x, y];
        return ir.intr(B, ir.IN_UMULH, i64t(), xs[..]);
    }
    // (four 32-bit products)
    let m = wint_c64(0xFFFF_FFFF);
    let k32 = wint_c64(32);
    let x0 = ir.and_(B, x, m);
    let x1 = ir.binop(B, ir.OP_LSHR, x, k32);
    let y0 = ir.and_(B, y, m);
    let y1 = ir.binop(B, ir.OP_LSHR, y, k32);
    let p00 = ir.mul(B, x0, y0);
    let p01 = ir.mul(B, x0, y1);
    let p10 = ir.mul(B, x1, y0);
    let p11 = ir.mul(B, x1, y1);
    let mid = ir.add(B, ir.add(B, ir.binop(B, ir.OP_LSHR, p00, k32), ir.and_(B, p01, m)), ir.and_(B, p10, m));
    let hi = ir.add(B, p11, ir.binop(B, ir.OP_LSHR, p01, k32));
    return ir.add(B, ir.add(B, hi, ir.binop(B, ir.OP_LSHR, p10, k32)), ir.binop(B, ir.OP_LSHR, mid, k32));
}

// The operation of a binary operator for wideint.ax: its function, or for
// the bitwise ones wi_bitop's op.
fn wint_bitop_code(op: i32) i64 {
    if op == ct.P_AMP {
        return 0;
    }
    if op == ct.P_PIPE {
        return 1;
    }
    if op == ct.P_CARET {
        return 2;
    }
    return -1;
}

/// x op y in type t (+ - * / % & | ^; both operands of type t), a new
/// temporary's address.
fn wint_arith(op: i32, t: *mut cty.CType, x: *mut ir.Value, y: *mut ir.Value) *mut ir.Value {
    let n = cty.limbs(t);
    if (op == ct.P_SLASH) or (op == ct.P_PERCENT) {
        return wint_divide(op == ct.P_SLASH, t, x, y);
    }
    let bop = wint_bitop_code(op);
    if (n == 2) or ((bop >= 0) and (n <= 4)) {
        let a0 = wint_limb(x, 0);
        let a1 = wint_limb(x, 1);
        let b0 = wint_limb(y, 0);
        let b1 = wint_limb(y, 1);
        if bop >= 0 {
            let r = wint_temp(t);
            for k in 0..n {
                let mut io = ir.OP_AND;
                if bop == 1 {
                    io = ir.OP_OR;
                } else if bop == 2 {
                    io = ir.OP_XOR;
                }
                wint_set_limb(r, k, ir.binop(B, io, wint_limb(x, k), wint_limb(y, k)));
            }
            return r;
        }
        if op == ct.P_PLUS {
            let lo = ir.add(B, a0, b0);
            let c = ir.zext(B, ir.icmp(B, ir.IntULT, lo, a0), i64t());
            return wint_pair(t, lo, ir.add(B, ir.add(B, a1, b1), c));
        }
        if op == ct.P_MINUS {
            let lo = ir.sub(B, a0, b0);
            let c = ir.zext(B, ir.icmp(B, ir.IntULT, a0, b0), i64t());
            return wint_pair(t, lo, ir.sub(B, ir.sub(B, a1, b1), c));
        }
        // the low 128 bits of the product (the same signed or unsigned)
        let lo = ir.mul(B, a0, b0);
        let hi = ir.add(B, wint_umulh(a0, b0), ir.add(B, ir.mul(B, a0, b1), ir.mul(B, a1, b0)));
        return wint_pair(t, lo, hi);
    }
    let r = wint_temp(t);
    if bop >= 0 {
        let mut xs: [5]*mut ir.Value = [r, x, y, wint_usz(n), ir.cint(ir.t_int(32), @bit_cast(u64, bop))];
        _ = wint_call("wi_bitop", xs[..]);
        return r;
    }
    let mut name: []u8 = "wi_add";
    if op == ct.P_MINUS {
        name = "wi_sub";
    } else if op == ct.P_STAR {
        name = "wi_mul";
    }
    let mut xs: [4]*mut ir.Value = [r, x, y, wint_usz(n)];
    _ = wint_call(name, xs[..]);
    wint_norm(t, r);
    return r;
}

// x / y (quot) or x % y in type t. Two limbs: when both are below 2^64
// (nonnegative and below it, signed), the 64-bit division, else wi_divmod
// (whose result is the same there); a division by zero is undefined.
fn wint_divide(quot: bool, t: *mut cty.CType, x: *mut ir.Value, y: *mut ir.Value) *mut ir.Value {
    let n = cty.limbs(t);
    let sg = wint_sg(t);
    let q = wint_temp(t);
    let r = wint_temp(t);
    let mut done = u.nil.[ir.Block]();
    if n == 2 {
        let small = new_block("wdiv.small");
        let big = new_block("wdiv.big");
        done = new_block("wdiv.done");
        let a1 = wint_limb(x, 1);
        let b1 = wint_limb(y, 1);
        let z = ir.icmp(B, ir.IntEQ, ir.or_(B, a1, b1), wint_c64(0));
        ir.condbr(B, z, small, big);
        at_end(small);
        let a0 = wint_limb(x, 0);
        let b0 = wint_limb(y, 0);
        if quot {
            wint_set_limb(q, 0, ir.binop(B, ir.OP_UDIV, a0, b0));
            wint_set_limb(q, 1, wint_c64(0));
        } else {
            wint_set_limb(r, 0, ir.binop(B, ir.OP_UREM, a0, b0));
            wint_set_limb(r, 1, wint_c64(0));
        }
        ir.br(B, done);
        at_end(big);
    }
    if (n == 2) and wint_hw_div() {
        wint_div2(sg, q, r, x, y);
    } else {
        let s = alloca(cty.array_of(cty.t_ullong, @as(u64, (4 * n) + 4), true), "wdiv");
        let mut xs: [7]*mut ir.Value = [q, r, x, y, wint_usz(n), wint_cbool(sg), s];
        _ = wint_call("wi_divmod", xs[..]);
    }
    if n == 2 {
        ir.br(B, done);
        at_end(done);
    }
    // (the quotient of the least value and -1 is undefined; a remainder has
    // the dividend's width: no reduction needed but for that quotient)
    if quot {
        wint_norm(t, q);
        return q;
    }
    return r;
}

// Does the target divide 128 bits by 64 (x86-64's div: ir.IN_UDIV128)?
fn wint_hw_div() bool {
    return not is_wasm and (tg.g_arch == tg.ARCH_X64);
}

// The pair lo, hi negated if c.
fn wint_neg_if(c: *mut ir.Value, lo: *mut ir.Value, hi: *mut ir.Value) [2]*mut ir.Value {
    let nl = ir.sub(B, wint_c64(0), lo);
    let nh = ir.sub(B, ir.sub(B, wint_c64(0), hi), ir.zext(B, ir.icmp(B, ir.IntNE, lo, wint_c64(0)), i64t()));
    return [ir.select(B, c, nl, lo), ir.select(B, c, nh, hi)];
}

// q = x / y, r = x % y of two limbs (signed: sg), by UDIV_FN on the
// magnitudes (C17 6.5.5p6: the quotient truncated, the remainder with the
// dividend's sign).
fn wint_div2(sg: bool, q: *mut ir.Value, r: *mut ir.Value, x: *mut ir.Value, y: *mut ir.Value) void {
    let mut a0 = wint_limb(x, 0);
    let mut a1 = wint_limb(x, 1);
    let mut b0 = wint_limb(y, 0);
    let mut b1 = wint_limb(y, 1);
    let mut na = ir.cint(T_i1, 0);
    let mut nb = ir.cint(T_i1, 0);
    if sg {
        na = ir.icmp(B, ir.IntSLT, a1, wint_c64(0));
        nb = ir.icmp(B, ir.IntSLT, b1, wint_c64(0));
        let ma = wint_neg_if(na, a0, a1);
        let mb = wint_neg_if(nb, b0, b1);
        a0 = ma[0];
        a1 = ma[1];
        b0 = mb[0];
        b1 = mb[1];
    }
    let f = wint_udiv_fn();
    let mut xs: [6]*mut ir.Value = [q, r, a0, a1, b0, b1];
    _ = ir.call(B, f.ty, f.val, xs[..]);
    if sg {
        let qn = wint_neg_if(ir.xor(B, na, nb), wint_limb(q, 0), wint_limb(q, 1));
        wint_set_limb(q, 0, qn[0]);
        wint_set_limb(q, 1, qn[1]);
        let rn = wint_neg_if(na, wint_limb(r, 0), wint_limb(r, 1));
        wint_set_limb(r, 0, rn[0]);
        wint_set_limb(r, 1, rn[1]);
    }
}

// The function of the unsigned division of two limbs by two (x86-64): q, r
// = (a1:a0) / (b1:b0), (a1:a0) % (b1:b0) (b not 0), stored at its first
// two parameters. A divisor below 2^64: the high limb's 64-bit division,
// then the 128-by-64 division of the remainder and the low limb; else the
// quotient is below 2^64: the dividend halved, divided by the divisor's
// leading 64 bits (normalized), gives it or one more (the estimate of
// Knuth's Algorithm D, 4.3.1), which the remainder corrects. Made once per
// module (linkonce).
fn wint_udiv_fn() *mut ir.Func {
    let f0 = ir.get_function(M, UDIV_FN);
    if u.notnil(f0) and not ir.is_decl(f0) {
        return f0;
    }
    let mut ps: [6]*mut ir.Ty = [T_ptr, T_ptr, i64t(), i64t(), i64t(), i64t()];
    let mut f = f0;
    if u.isnil(f) {
        f = ir.add_function(M, UDIV_FN, ir.t_fn(T_void, ps[..], false));
    }
    f.linkage = ir.LINK_LINKONCE;
    let saved = B;
    let wb = ir.new_builder();
    B = wb;
    let entry = ir.append_block(f, "entry");
    let small = ir.append_block(f, "small");
    let big = ir.append_block(f, "big");
    ir.at_end(wb, entry);
    let qp = f.params[0];
    let rp = f.params[1];
    let a0 = f.params[2];
    let a1 = f.params[3];
    let b0 = f.params[4];
    let b1 = f.params[5];
    ir.condbr(wb, ir.icmp(wb, ir.IntEQ, b1, wint_c64(0)), small, big);
    // b < 2^64
    ir.at_end(wb, small);
    let q1 = ir.binop(wb, ir.OP_UDIV, a1, b0);
    let r1 = ir.sub(wb, a1, ir.mul(wb, q1, b0));
    let q0 = wint_udiv128(r1, a0, b0);
    wint_set_limb(qp, 0, q0);
    wint_set_limb(qp, 1, q1);
    wint_set_limb(rp, 0, ir.sub(wb, a0, ir.mul(wb, q0, b0)));
    wint_set_limb(rp, 1, wint_c64(0));
    ir.ret_void(wb);
    // b >= 2^64: the quotient is below 2^64
    ir.at_end(wb, big);
    let mut one: [1]*mut ir.Value = [b1];
    let nz = ir.intr(wb, ir.IN_CTLZ, i64t(), one[..]);
    let inv = ir.sub(wb, wint_c64(63), nz);
    let v1 = ir.or_(
        wb, ir.binop(wb, ir.OP_SHL, b1, nz), ir.binop(wb, ir.OP_LSHR, ir.binop(wb, ir.OP_LSHR, b0, wint_c64(1)), inv));
    let u1 = ir.binop(wb, ir.OP_LSHR, a1, wint_c64(1));
    let u0 = ir.or_(wb, ir.binop(wb, ir.OP_LSHR, a0, wint_c64(1)), ir.binop(wb, ir.OP_SHL, a1, wint_c64(63)));
    let e = ir.binop(wb, ir.OP_LSHR, wint_udiv128(u1, u0, v1), inv);
    let est = ir.sub(wb, e, ir.zext(wb, ir.icmp(wb, ir.IntNE, e, wint_c64(0)), i64t()));
    // a - est * b, and est + 1 if that is still at least b
    let p0 = ir.mul(wb, est, b0);
    let ph = ir.add(wb, wint_umulh(est, b0), ir.mul(wb, est, b1));
    let l = ir.sub(wb, a0, p0);
    let h = ir.sub(wb, ir.sub(wb, a1, ph), ir.zext(wb, ir.icmp(wb, ir.IntULT, a0, p0), i64t()));
    let gt = ir.icmp(wb, ir.IntUGT, h, b1);
    let eq = ir.and_(wb, ir.icmp(wb, ir.IntEQ, h, b1), ir.icmp(wb, ir.IntUGE, l, b0));
    let ge = ir.or_(wb, gt, eq);
    let l2 = ir.sub(wb, l, b0);
    let h2 = ir.sub(wb, ir.sub(wb, h, b1), ir.zext(wb, ir.icmp(wb, ir.IntULT, l, b0), i64t()));
    wint_set_limb(qp, 0, ir.add(wb, est, ir.zext(wb, ge, i64t())));
    wint_set_limb(qp, 1, wint_c64(0));
    wint_set_limb(rp, 0, ir.select(wb, ge, l2, l));
    wint_set_limb(rp, 1, ir.select(wb, ge, h2, h));
    ir.ret_void(wb);
    B = saved;
    return f;
}

fn wint_udiv128(hi: *mut ir.Value, lo: *mut ir.Value, d: *mut ir.Value) *mut ir.Value {
    let mut xs: [3]*mut ir.Value = [hi, lo, d];
    return ir.intr(B, ir.IN_UDIV128, i64t(), xs[..]);
}

/// x << y or x >> y (op) in type t; y, the count, of type yt (any integer
/// type: the operand's value, a count of t's width or more is undefined).
fn wint_shift(op: i32, t: *mut cty.CType, x: *mut ir.Value, y: *mut ir.Value, yt: *mut cty.CType) *mut ir.Value {
    let n = cty.limbs(t);
    let sg = wint_sg(t);
    let k = wint_count64(y, yt);
    if n == 2 {
        let a0 = wint_limb(x, 0);
        let a1 = wint_limb(x, 1);
        let s = ir.and_(B, k, wint_c64(63));
        let big = ir.icmp(B, ir.IntNE, ir.and_(B, k, wint_c64(64)), wint_c64(0));
        let inv = ir.sub(B, wint_c64(63), s);  // (63 - s: the bits of the other limb, in two shifts)
        if op == ct.P_SHL {
            let lo_s = ir.binop(B, ir.OP_SHL, a0, s);
            let carry = ir.binop(B, ir.OP_LSHR, ir.binop(B, ir.OP_LSHR, a0, wint_c64(1)), inv);
            let hi_s = ir.or_(B, ir.binop(B, ir.OP_SHL, a1, s), carry);
            let lo = ir.select(B, big, wint_c64(0), lo_s);
            let hi = ir.select(B, big, lo_s, hi_s);
            return wint_pair(t, lo, hi);
        }
        let carry = ir.binop(B, ir.OP_SHL, ir.binop(B, ir.OP_SHL, a1, wint_c64(1)), inv);
        let lo_s = ir.or_(B, ir.binop(B, ir.OP_LSHR, a0, s), carry);
        let mut hi_s = ir.vnil();
        let mut fill = wint_c64(0);
        if sg {
            hi_s = ir.binop(B, ir.OP_ASHR, a1, s);
            fill = wint_sign_fill(a1);
        } else {
            hi_s = ir.binop(B, ir.OP_LSHR, a1, s);
        }
        let lo = ir.select(B, big, hi_s, lo_s);
        let hi = ir.select(B, big, fill, hi_s);
        return wint_pair(t, lo, hi);
    }
    let r = wint_temp(t);
    if op == ct.P_SHL {
        let mut xs: [4]*mut ir.Value = [r, x, k, wint_usz(n)];
        _ = wint_call("wi_shl", xs[..]);
        wint_norm(t, r);
    } else {
        let mut xs: [5]*mut ir.Value = [r, x, k, wint_usz(n), wint_cbool(sg)];
        _ = wint_call("wi_shr", xs[..]);
    }
    return r;
}

// Integer value v of type t as a 64-bit count (a wider one's low limb).
fn wint_count64(v: *mut ir.Value, t: *cty.CType) *mut ir.Value {
    if cty.is_wint(t) {
        return wint_limb(v, 0);
    }
    if v.ty.bits < 64 {
        return ir.zext(B, v, i64t());
    }
    return v;
}

/// -x in type t.
fn wint_negate(t: *mut cty.CType, x: *mut ir.Value) *mut ir.Value {
    let n = cty.limbs(t);
    if n == 2 {
        let a0 = wint_limb(x, 0);
        let a1 = wint_limb(x, 1);
        let lo = ir.sub(B, wint_c64(0), a0);
        let c = ir.zext(B, ir.icmp(B, ir.IntNE, a0, wint_c64(0)), i64t());
        return wint_pair(t, lo, ir.sub(B, ir.sub(B, wint_c64(0), a1), c));
    }
    let r = wint_temp(t);
    let mut xs: [3]*mut ir.Value = [r, x, wint_usz(n)];
    _ = wint_call("wi_neg", xs[..]);
    wint_norm(t, r);
    return r;
}

/// ~x in type t.
fn wint_bitnot(t: *mut cty.CType, x: *mut ir.Value) *mut ir.Value {
    let n = cty.limbs(t);
    let r = wint_temp(t);
    if n <= 4 {
        for k in 0..n {
            wint_set_limb(r, k, ir.xor(B, wint_limb(x, k), wint_c64(0xFFFF_FFFF_FFFF_FFFF)));
        }
    } else {
        let mut xs: [3]*mut ir.Value = [r, x, wint_usz(n)];
        _ = wint_call("wi_not", xs[..]);
    }
    wint_norm(t, r);
    return r;
}

/// x != 0 (x of type t), as an i1.
fn wint_truth(t: *cty.CType, x: *mut ir.Value) *mut ir.Value {
    let n = cty.limbs(t);
    if n <= 4 {
        let mut a = wint_limb(x, 0);
        for k in 1..n {
            a = ir.or_(B, a, wint_limb(x, k));
        }
        return ir.icmp(B, ir.IntNE, a, wint_c64(0));
    }
    let mut xs: [2]*mut ir.Value = [x, wint_usz(n)];
    let c = wint_call("wi_nonzero", xs[..]);
    return ir.icmp(B, ir.IntNE, c, ir.cint(c.ty, 0));
}

/// x op y (< > <= >= == !=) of type t, as an i1.
fn wint_compare(op: i32, t: *cty.CType, x: *mut ir.Value, y: *mut ir.Value) *mut ir.Value {
    let n = cty.limbs(t);
    let sg = wint_sg(t);
    if (n <= 4) and ((op == ct.P_EQ) or (op == ct.P_NE)) {
        let mut d = ir.xor(B, wint_limb(x, 0), wint_limb(y, 0));
        for k in 1..n {
            d = ir.or_(B, d, ir.xor(B, wint_limb(x, k), wint_limb(y, k)));
        }
        return ir.icmp(B, ir.pick_pred(op == ct.P_EQ, ir.IntEQ, ir.IntNE), d, wint_c64(0));
    }
    if n == 2 {
        let a0 = wint_limb(x, 0);
        let a1 = wint_limb(x, 1);
        let b0 = wint_limb(y, 0);
        let b1 = wint_limb(y, 1);
        // a < b: the high limbs' order (signed or not), or equal high limbs
        // and the low limbs' unsigned order; > likewise; <= is not >
        let mut swap = false;
        if (op == ct.P_GT) or (op == ct.P_LE) {
            swap = true;
        }
        let mut p0 = a0;
        let mut p1 = a1;
        let mut q0 = b0;
        let mut q1 = b1;
        if swap {
            p0 = b0;
            p1 = b1;
            q0 = a0;
            q1 = a1;
        }
        let hl = ir.icmp(B, ir.pick_pred(sg, ir.IntSLT, ir.IntULT), p1, q1);
        let he = ir.icmp(B, ir.IntEQ, p1, q1);
        let ll = ir.icmp(B, ir.IntULT, p0, q0);
        let lt = ir.or_(B, hl, ir.and_(B, he, ll));
        if (op == ct.P_LT) or (op == ct.P_GT) {
            return lt;
        }
        return ir.not_(B, lt);
    }
    let mut xs: [4]*mut ir.Value = [x, y, wint_usz(n), wint_cbool(sg)];
    let c = wint_call("wi_cmp", xs[..]);
    let z = ir.cint(c.ty, 0);
    let mut p = ir.IntNE;
    if op == ct.P_LT {
        p = ir.IntSLT;
    } else if op == ct.P_GT {
        p = ir.IntSGT;
    } else if op == ct.P_LE {
        p = ir.IntSLE;
    } else if op == ct.P_GE {
        p = ir.IntSGE;
    } else if op == ct.P_EQ {
        p = ir.IntEQ;
    }
    return ir.icmp(B, p, c, z);
}

/// The constant 1 of type t, for ++ and --.
fn wint_one_value(t: *mut cty.CType) *mut ir.Value {
    let n = cty.limbs(t);
    let v = u.newn.[u64](n + 1)[0..n];
    for k in 0..n {
        v[k] = 0;
    }
    v[0] = 1;
    return wint_constant(t, v);
}
