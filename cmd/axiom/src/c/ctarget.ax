// =============================================================================
// ctarget.ax - the conventional predefined macros of the target: the
// processor, the operating system, the data model and the types, the
// processor extensions of --cpu and --features, the optimizer's level and
// position-independent code (docs/c.md, "Predefined macros"). Their names
// are in the implementation's namespace (C17 7.1.3), but for the GNU
// dialects' `unix` and `linux`; programs test them to learn what the
// target is. They are defined in every mode, with the system's C library
// too (whose headers test them), and -D and -U may change them (cpp.ax:
// protect_all leaves them unprotected). No macro names a compiler
// (__GNUC__ and the like): programs test features, and the compiler's own
// macros are __AXIOM_ ones.
// =============================================================================
import "../target.ax" as tg;
import "../util.ax" as u;
import "copts.ax" as co;

// One extension's macro: defined when the target has `bit`.
struct Feat {
    bit: u64,
    name: []u8,
}

// x86-64's extensions, by the macros programs test (SSE and SSE2 are the
// architecture's baseline: always defined)
let X64_FEATURES: [39]Feat = [Feat.{ bit: tg.X_SSE3, name: "__SSE3__" }, Feat.{ bit: tg.X_SSSE3, name: "__SSSE3__" },
                              Feat.{ bit: tg.X_SSE41, name: "__SSE4_1__" },
                              Feat.{ bit: tg.X_SSE42, name: "__SSE4_2__" },
                              Feat.{ bit: tg.X_POPCNT, name: "__POPCNT__" },
                              Feat.{ bit: tg.X_LZCNT, name: "__LZCNT__" }, Feat.{ bit: tg.X_BMI1, name: "__BMI__" },
                              Feat.{ bit: tg.X_BMI2, name: "__BMI2__" }, Feat.{ bit: tg.X_AVX, name: "__AVX__" },
                              Feat.{ bit: tg.X_AVX2, name: "__AVX2__" }, Feat.{ bit: tg.X_FMA, name: "__FMA__" },
                              Feat.{ bit: tg.X_AES, name: "__AES__" }, Feat.{ bit: tg.X_PCLMUL, name: "__PCLMUL__" },
                              Feat.{ bit: tg.X_SHA, name: "__SHA__" }, Feat.{ bit: tg.X_F16C, name: "__F16C__" },
                              Feat.{ bit: tg.X_MOVBE, name: "__MOVBE__" }, Feat.{ bit: tg.X_ADX, name: "__ADX__" },
                              Feat.{ bit: tg.X_AVX512F, name: "__AVX512F__" },
                              Feat.{ bit: tg.X_AVX512CD, name: "__AVX512CD__" },
                              Feat.{ bit: tg.X_AVX512BW, name: "__AVX512BW__" },
                              Feat.{ bit: tg.X_AVX512DQ, name: "__AVX512DQ__" },
                              Feat.{ bit: tg.X_AVX512VL, name: "__AVX512VL__" },
                              Feat.{ bit: tg.X_AVX512IFMA, name: "__AVX512IFMA__" },
                              Feat.{ bit: tg.X_AVX512VBMI, name: "__AVX512VBMI__" },
                              Feat.{ bit: tg.X_AVX512VBMI2, name: "__AVX512VBMI2__" },
                              Feat.{ bit: tg.X_AVX512VNNI, name: "__AVX512VNNI__" },
                              Feat.{ bit: tg.X_AVX512BITALG, name: "__AVX512BITALG__" },
                              Feat.{ bit: tg.X_AVX512VPOPCNTDQ, name: "__AVX512VPOPCNTDQ__" },
                              Feat.{ bit: tg.X_AVX512BF16, name: "__AVX512BF16__" },
                              Feat.{ bit: tg.X_AVX512FP16, name: "__AVX512FP16__" },
                              Feat.{ bit: tg.X_GFNI, name: "__GFNI__" }, Feat.{ bit: tg.X_VAES, name: "__VAES__" },
                              Feat.{ bit: tg.X_VPCLMULQDQ, name: "__VPCLMULQDQ__" },
                              Feat.{ bit: tg.X_AVXVNNI, name: "__AVXVNNI__" },
                              Feat.{ bit: tg.X_SHA512, name: "__SHA512__" }, Feat.{ bit: tg.X_SM3, name: "__SM3__" },
                              Feat.{ bit: tg.X_SM4, name: "__SM4__" }, Feat.{ bit: tg.X_AVX10_1, name: "__AVX10_1__" },
                              Feat.{ bit: tg.X_PRFCHW, name: "__PRFCHW__" }];

// AArch64's extensions, by the Arm C Language Extensions' feature macros
// (__ARM_FEATURE_<name>, each 1 when the extension is there)
let A64_FEATURES: [26]Feat = [Feat.{ bit: tg.A_LSE, name: "ATOMICS" }, Feat.{ bit: tg.A_RCPC, name: "RCPC" },
                              Feat.{ bit: tg.A_DOTPROD, name: "DOTPROD" }, Feat.{ bit: tg.A_AES, name: "AES" },
                              Feat.{ bit: tg.A_SHA2, name: "SHA2" }, Feat.{ bit: tg.A_SHA3, name: "SHA3" },
                              Feat.{ bit: tg.A_SHA512, name: "SHA512" }, Feat.{ bit: tg.A_SM4, name: "SM3" },
                              Feat.{ bit: tg.A_SM4, name: "SM4" }, Feat.{ bit: tg.A_CRC, name: "CRC32" },
                              Feat.{ bit: tg.A_RDM, name: "QRDMX" },
                              Feat.{ bit: tg.A_FP16, name: "FP16_SCALAR_ARITHMETIC" },
                              Feat.{ bit: tg.A_FP16, name: "FP16_VECTOR_ARITHMETIC" },
                              Feat.{ bit: tg.A_FHM, name: "FP16_FML" }, Feat.{ bit: tg.A_BF16, name: "BF16" },
                              Feat.{ bit: tg.A_I8MM, name: "MATMUL_INT8" }, Feat.{ bit: tg.A_SVE, name: "SVE" },
                              Feat.{ bit: tg.A_SVE2, name: "SVE2" }, Feat.{ bit: tg.A_SVE2P1, name: "SVE2p1" },
                              Feat.{ bit: tg.A_SME, name: "SME" }, Feat.{ bit: tg.A_SME2, name: "SME2" },
                              Feat.{ bit: tg.A_SME2P1, name: "SME2p1" },
                              Feat.{ bit: tg.A_SME_F64F64, name: "SME_F64F64" },
                              Feat.{ bit: tg.A_SME_I16I64, name: "SME_I16I64" },
                              Feat.{ bit: tg.A_SME_F16F16, name: "SME_F16F16" },
                              Feat.{ bit: tg.A_B16B16, name: "SVE_B16B16" }];

// WebAssembly's proposals, by their macros (__wasm_<name>__)
let WASM_FEATURES: [10]Feat = [Feat.{ bit: tg.W_SIMD128, name: "simd128" },
                               Feat.{ bit: tg.W_BULK_MEMORY, name: "bulk_memory" },
                               Feat.{ bit: tg.W_NONTRAPPING_FPTOINT, name: "nontrapping_fptoint" },
                               Feat.{ bit: tg.W_SIGN_EXT, name: "sign_ext" },
                               Feat.{ bit: tg.W_MUTABLE_GLOBALS, name: "mutable_globals" },
                               Feat.{ bit: tg.W_ATOMICS, name: "atomics" },
                               Feat.{ bit: tg.W_MULTIVALUE, name: "multivalue" },
                               Feat.{ bit: tg.W_RELAXED_SIMD, name: "relaxed_simd" },
                               Feat.{ bit: tg.W_TAIL_CALL, name: "tail_call" },
                               Feat.{ bit: tg.W_EXCEPTION_HANDLING, name: "exception_handling" }];

fn def(b: *mut u.Buf, name: []u8, value: []u8) void {
    b.s(u.f2("#define %s %s\n", name, value));
}

/// The definitions (#define lines) of the target's conventional macros
/// for the build `o` describes.
pub fn target_macros_text(o: *co.COptions) []u8 {
    let mut b = u.Buf.init();
    let linux = not tg.is_wasm() and (tg.g_os == tg.OS_LINUX);
    let darwin = not tg.is_wasm() and tg.is_darwin();
    let win = not tg.is_wasm() and tg.is_windows();
    // the processor
    if tg.g_arch == tg.ARCH_X64 {
        b.s("#define __x86_64__ 1\n#define __x86_64 1\n#define __amd64__ 1\n#define __amd64 1\n");
        // (the baseline: x87, MMX, SSE, SSE2 and FXSAVE, and floating-point
        // arithmetic in SSE registers)
        b.s("#define __MMX__ 1\n#define __SSE__ 1\n#define __SSE2__ 1\n#define __FXSR__ 1\n");
        b.s("#define __SSE_MATH__ 1\n#define __SSE2_MATH__ 1\n");
        for f in X64_FEATURES {
            if tg.has(f.bit) {
                def(&mut b, f.name, "1");
            }
        }
        if win {
            b.s("#define _M_X64 100\n#define _M_AMD64 100\n");
        }
    } else if tg.g_arch == tg.ARCH_A64 {
        b.s("#define __aarch64__ 1\n#define __AARCH64EL__ 1\n");
        if darwin {
            b.s("#define __arm64__ 1\n#define __arm64 1\n");
        }
        if win {
            b.s("#define _M_ARM64 1\n");
        }
        // (the Arm C Language Extensions' description of the architecture:
        // Armv8-A's A64 state, AAPCS64, Advanced SIMD and the floating-point
        // unit's half, single and double precision, and what every A64
        // processor has)
        b.s("#define __ARM_ARCH 8\n#define __ARM_ARCH_ISA_A64 1\n#define __ARM_ARCH_PROFILE 'A'\n");
        b.s("#define __ARM_64BIT_STATE 1\n#define __ARM_PCS_AAPCS64 1\n#define __ARM_NEON 1\n#define __ARM_FP 0xE\n");
        b.s("#define __ARM_FEATURE_FMA 1\n#define __ARM_FEATURE_CLZ 1\n#define __ARM_FEATURE_IDIV 1\n");
        b.s("#define __ARM_FEATURE_UNALIGNED 1\n#define __ARM_FEATURE_NUMERIC_MAXMIN 1\n");
        b.s("#define __ARM_FEATURE_DIRECTED_ROUNDING 1\n");
        b.s(u.f1("#define __ARM_SIZEOF_WCHAR_T %s\n#define __ARM_SIZEOF_MINIMAL_ENUM 4\n", u.idec(o.wchar_bits / 8)));
        for f in A64_FEATURES {
            if tg.has(f.bit) {
                def(&mut b, u.cat2("__ARM_FEATURE_", f.name), "1");
            }
        }
        if tg.has(tg.A_AES | tg.A_SHA2) {
            b.s("#define __ARM_FEATURE_CRYPTO 1\n");
        }
    } else {
        // (WebAssembly: no system, the module's imports are the host's)
        b.s("#define __wasm 1\n#define __wasm__ 1\n");
        if tg.g_arch == tg.ARCH_WASM64 {
            b.s("#define __wasm64 1\n#define __wasm64__ 1\n");
        } else {
            b.s("#define __wasm32 1\n#define __wasm32__ 1\n");
        }
        for f in WASM_FEATURES {
            if tg.has(f.bit) {
                def(&mut b, u.f1("__wasm_%s__", f.name), "1");
            }
        }
    }
    // the operating system and its object format
    if linux {
        b.s("#define __linux__ 1\n#define __linux 1\n#define __unix__ 1\n#define __unix 1\n#define __ELF__ 1\n");
        if o.gnu {
            // (the GNU dialects' names outside the reserved namespace)
            b.s("#define unix 1\n#define linux 1\n");
        }
    } else if darwin {
        b.s("#define __APPLE__ 1\n#define __MACH__ 1\n");
        // (the oldest macOS the executables run on, 11.0, as the system's
        // headers' availability macros read it: mlink.ax's LC_BUILD_VERSION)
        b.s("#define __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ 110000\n");
        b.s("#define __ENVIRONMENT_OS_VERSION_MIN_REQUIRED__ 110000\n");
    } else if win {
        b.s("#define _WIN32 1\n#define _WIN64 1\n");
    }
    // the symbols' prefix in assembly (Mach-O's underscore), and registers'
    b.s(u.f1("#define __USER_LABEL_PREFIX__ %s\n#define __REGISTER_PREFIX__ \n", u.pick(darwin, "_", "")));
    // the data model
    if (o.int_bits == 32) and (o.long_bits == 64) and (o.ptr_bits == 64) {
        b.s("#define __LP64__ 1\n#define _LP64 1\n");
    } else if (o.int_bits == 32) and (o.long_bits == 32) and (o.ptr_bits == 32) {
        b.s("#define __ILP32__ 1\n#define _ILP32 1\n");
    } else if (o.int_bits == 32) and (o.long_bits == 32) and (o.ptr_bits == 64) {
        b.s("#define __LLP64__ 1\n");  // (Windows' data model)
    }
    if not o.char_signed {
        b.s("#define __CHAR_UNSIGNED__ 1\n");
    }
    b.s(co.conventional_type_macros_text(o));
    // the build: optimized or not, position-independent code (an
    // executable's on macOS, PIE; a shared library's or --pic's on ELF)
    if o.opt_level > 0 {
        b.s("#define __OPTIMIZE__ 1\n");
    } else {
        b.s("#define __NO_INLINE__ 1\n");
    }
    if o.pic {
        b.s("#define __PIC__ 2\n#define __pic__ 2\n");
    }
    if o.pie {
        b.s("#define __PIE__ 2\n#define __pie__ 2\n");
    }
    return b.done();
}
