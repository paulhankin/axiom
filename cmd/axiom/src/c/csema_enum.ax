// =============================================================================
// csema_enum.ax - enumerations and enumerator constants (6.7.2.2), part of
// csema.ax.
// =============================================================================
import "../util.ax" as u;
import "cast.ax" as cast;
import "cgen_debug.ax" as cdbg;
import "copts.ax" as co;
import "ctypes.ax" as cty;
import "cwide.ax" as cw;
import "std/c/rt/wideint" as wi;

// -----------------------------------------------------------------------------
// Enumerations (6.7.2.2)
// -----------------------------------------------------------------------------

// The fixed underlying type of ts (C23), checked; .none if none (or invalid).
fn fixed_type(ts: *mut cast.TagSpec) ?*mut cty.CType {
    if u.isnil(ts.fixed) {
        return .none;
    }
    let t = type_name(ts.fixed);
    if cty.is_error(t) {
        return .none;
    }
    if not cty.is_integer(t) or (t.kind == cty.TK_ENUM) {
        err(ts.fixed.span, "C3075",
            u.f1("the underlying type of an enumeration is %s, not an integer type that is not an enumeration", tq(t)));
        return .none;
    }
    if cty.is_bitint(t.unq) {
        // (C23 6.7.2.2p5)
        err(ts.fixed.span, "C3075", u.f1("the underlying type of an enumeration is %s, a bit-precise integer type",
                                         tq(t)));
        return .none;
    }
    return .some(cty.unqual(t));
}

// A GNU dialect: an enumeration named before its list (6.7.2.3p3 asks for
// the list first), as a structure may be: an incomplete type until its list
// completes it, which its forward declarations and uses then name.
fn forward_enum(ts: *mut cast.TagSpec) void {
    warn(ts.name_span, "C4144", u.f1("'enum %s' is used before its definition (an incomplete type until then)",
                                     ts.name));
}

/// The type an enum specifier names (lone: the whole declaration is the
/// specifier and a ';'), declaring and defining it as it says.
pub fn enum_tag(ts: *mut cast.TagSpec, lone: bool) *mut cty.CType {
    let named = ts.name.len > 0;
    let oft = fixed_type(ts);
    if u.notnil(ts.fixed) and not ts.has_body and not lone {
        err(ts.fixed.span, "C3075",
            "an enumeration's underlying type is given only with its list, or in a declaration of the tag alone");
    }
    let declares = ts.has_body or u.notnil(ts.fixed);
    let mut ot: ?*mut cty.CType = .none;
    if declares {
        if named {
            ot = lookup_tag_here(ts.name);
        }
    } else if named {
        ot = lookup_tag(ts.name);
    }
    let mut t = cty.t_error;
    if let .some(pt) = ot {
        t = pt;
        if t.kind != cty.TK_ENUM {
            err_note(ts.name_span, "C3011",
                     u.f2("'%s' was declared as %s", ts.name, u.cat3("a different kind of tag (", kind_word(t.kind),
                                                                     ")")), t.tag.span, "declared here");
            ts.ty = cty.t_error;
            return ts.ty;
        }
        let ti = t.tag;
        if declares {
            let prev_fixed = u.notnil(ti.fixed);
            if prev_fixed != u.notnil(ts.fixed) {
                err_note(ts.name_span, "C3075",
                         u.f1("'enum %s' is declared with a fixed underlying type and without one", ts.name), ti.span,
                         "declared before here");
            } else if prev_fixed {
                if let .some(ft) = oft {
                    if not cty.compatible_unq(ti.fixed, ft) {
                        err_note(ts.name_span, "C3075", u.f3("'enum %s' has underlying type %s, declared before as %s",
                                                             ts.name, tq(ft), tq(ti.fixed)), ti.span,
                                 "declared before here");
                    }
                }
            }
            if ts.has_body and ti.listed and (std() >= co.C23) {
                // (C23: the same constants again, with the same values, are the same type: 6.7.2.3)
                ts.ty = t;
                if not enumerators(t, ts, true) {
                    err_note(ts.name_span, "C3002", u.f1("redefinition of 'enum %s' with other constants", ts.name),
                             ti.span, "defined before here");
                    ts.ty = cty.t_error;
                }
                return ts.ty;
            }
            if ts.has_body and ti.listed {
                err_note(ts.name_span, "C3002", u.f1("redefinition of 'enum %s'", ts.name), ti.span,
                         "defined before here");
                ts.ty = cty.t_error;
                return ts.ty;
            }
        }
        if not declares and not ti.listed and u.isnil(ti.fixed) {
            forward_enum(ts);
        }
    } else {
        if not declares and not opts().gnu {
            err(ts.name_span, "C3011", u.f1("'enum %s' is not defined", ts.name));
            ts.ty = cty.t_error;
            return ts.ty;
        }
        if not declares {
            forward_enum(ts);
        }
        t = cty.new_tagged(cty.TK_ENUM, ts.name, ts.name_span);
        if not named {
            t.tag.span = ts.span;
        }
        if named {
            declare_tag(ts.name, t);
        }
        if let .some(ft) = oft {
            t.tag.fixed = ft;
            cty.set_enum_base(t, ft);  // (complete from here on: C23 6.7.2.2p?)
        }
    }
    ts.ty = t;
    if ts.has_body {
        t.tag.listed = true;
        _ = enumerators(t, ts, false);
    }
    return t;
}

// The value of an enumeration constant, exact: 192 bits of two's
// complement, more than any type an enumeration can have (so that one more
// than the largest value of unsigned __int128, or a wider _BitInt's value,
// is told apart from them); huge: a value that does not fit even those.
struct Val {
    w: [3]u64,
    huge: bool,
}

const VL: usize = 3;

fn val_neg(x: Val) bool {
    return (x.w[2] >> 63) != 0;
}

// The value of integer constant e.
fn val_of(e: *cast.Expr) Val {
    let mut n: usize = VL;
    if cty.is_wint(e.ty) {
        n = @max(n, cty.limbs(e.ty));
    }
    let v = cw.value(e, n);
    let mut x = Val.{ w: [v[0], v[1], v[2]], huge: false };
    let mut ext: u64 = 0;
    if val_neg(x) {
        ext = 0xFFFF_FFFF_FFFF_FFFF;
    }
    for i in VL..n {
        if v[i] != ext {
            x.huge = true;
        }
    }
    return x;
}

// Does integer type t hold x?
fn fitsv(t: *cty.CType, x: Val) bool {
    if x.huge {
        return false;
    }
    if t.unq.kind == cty.TK_BOOL {
        return (x.w[0] <= 1) and (x.w[1] == 0) and (x.w[2] == 0);
    }
    let mut c: [3]u64 = x.w;
    wi.wi_norm(&mut c[0], VL, @bit_cast(u32, t.unq.bits), t.unq.is_signed);
    return (c[0] == x.w[0]) and (c[1] == x.w[1]) and (c[2] == x.w[2]);
}

// x + 1 (never past the range of Val's 192 bits from an enumeration's values).
fn plus1(x: Val) Val {
    let one: [3]u64 = [1, 0, 0];
    let mut r = Val.{ w: [0, 0, 0], huge: x.huge };
    wi.wi_add(&mut r.w[0], &x.w[0], &one[0], VL);
    return r;
}

fn same_val(a: Val, b: Val) bool {
    return (a.w[0] == b.w[0]) and (a.w[1] == b.w[1]) and (a.w[2] == b.w[2]);
}

// The exact value of enumeration constant s.
fn sym_val(s: *cast.CSym) Val {
    return Val.{ w: [s.wide[0], s.wide[1], s.wide[2]], huge: false };
}

// The first of the types `cands` that holds x; .none if none.
fn first_fit(cands: []mut *mut cty.CType, x: Val) ?*mut cty.CType {
    for c in cands {
        if fitsv(c, x) {
            return .some(c);
        }
    }
    return .none;
}

// The integer types wider than int an enumeration's type (or a constant's
// in its list) may be, of a signedness (C23 6.7.2.2p11-12): long, long long
// and, in a GNU dialect, __int128, which is an extended integer type there.
fn wider_types(signed: bool) []mut *mut cty.CType {
    let mut l = u.List.[*mut cty.CType].empty();
    if signed {
        l.push(cty.t_long);
        l.push(cty.t_llong);
        if opts().gnu {
            l.push(cty.t_int128);
        }
    } else {
        l.push(cty.t_ulong);
        l.push(cty.t_ullong);
        if opts().gnu {
            l.push(cty.t_uint128);
        }
    }
    return l.items_mut();
}

// The constants of the enumeration t that tag specifier ts defines, declared
// (again: the list of a definition of t seen before, C23, whose constants
// must be these: false if they are not).
fn enumerators(t: *mut cty.CType, ts: *mut cast.TagSpec, again: bool) bool {
    let fixed = t.tag.fixed;
    let key = u.addr_key(@int_from_ptr(t.tag));
    let mut old = u.nil.[u.List.[*mut cast.CSym]]();
    let mut same = true;
    if not again {
        old = u.new.[u.List.[*mut cast.CSym]]();
        g_enum_consts.put(key, .some(old));
    } else if let .some(prev_old) = g_enum_consts.get(key) {
        old = prev_old;
    } else {
        return false;
    }
    let mut k: usize = 0;
    // (C23's types of the constants outside int's range, which the GNU
    // dialects have before C23 too: the system's headers define such
    // constants, 1u << 31)
    let c23 = (std() >= co.C23) or opts().gnu;
    let mut syms = u.List.[*mut cast.CSym].empty();
    let zero = Val.{ w: [0, 0, 0], huge: false };
    let mut prev = zero;
    let mut prev_ty = cty.t_int;
    let mut all_int = true;
    let mut min = zero;
    let mut max = zero;
    let mut first = true;
    for en in ts.enumerators.items() {
        attrs(&en.attrs, AP_ENUMERATOR);
        let mut x = zero;
        let mut ety = cty.t_int;
        if u.notnil(en.value) {
            let r = ice_wide(en.value, "an enumeration constant's value");
            en.value = r.e;
            if r.ok {
                x = val_of(r.e);
                if u.notnil(fixed) {
                    if not fitsv(fixed, x) {
                        err(en.span, "C3013", u.f2("the value of '%s' is outside the range of its underlying type %s",
                                                   en.name, tq(fixed)));
                        x = zero;
                    }
                } else if not fitsv(cty.t_int, x) {
                    if not c23 {
                        err(en.span, "C3013", u.f1("the value of '%s' is outside the range of int", en.name));
                        x = zero;
                    } else {
                        // (6.7.2.2p11: the type of the integer constant expression)
                        ety = cty.promote(r.e.ty);
                    }
                }
            }
        } else if not first {
            // the previous value plus one
            x = plus1(prev);
            let mut lim = prev_ty;
            if u.notnil(fixed) {
                lim = fixed;
            }
            if not fitsv(lim, x) {
                if u.notnil(fixed) or not c23 {
                    let mut what: []u8 = "int";
                    if u.notnil(fixed) {
                        what = u.cat2("its underlying type ", tq(fixed));
                    }
                    err(en.span, "C3013", u.f2("the value of '%s' (the previous one plus 1) is outside the range of %s",
                                               en.name, what));
                    x = prev;
                } else {
                    // (6.7.2.2p11: a wider type of the previous constant's
                    // signedness, not a bit-precise one)
                    if let .some(nt) = first_fit(wider_types(prev_ty.is_signed), x) {
                        ety = nt;
                    } else {
                        err(en.span, "C3013",
                            u.f1("the value of '%s' (the previous one plus 1) is outside the range of every integer type",
                                 en.name));
                        x = prev;
                    }
                }
            } else {
                ety = lim;
            }
        }
        if u.isnil(fixed) and not fitsv(cty.t_int, x) {
            all_int = false;
        } else if u.isnil(fixed) and (ety.rank > cty.t_int.rank) {
            ety = cty.t_int;  // (back in int's range)
        }
        if first or less(x, min) {
            min = x;
        }
        if first or less(max, x) {
            max = x;
        }
        first = false;
        prev = x;
        prev_ty = ety;
        if again {
            // (the k-th constant of the earlier list: the same name and value)
            if (k < old.len) and u.same(old.get(k).name, en.name) and same_val(sym_val(old.get(k)), x) {
                en.sym = old.get(k);
            } else {
                same = false;
            }
            k += 1;
            continue;
        }
        if let .some(prior) = lookup_here(en.name) {
            err_note(en.span, "C3002", u.f1("redefinition of '%s'", en.name), prior.span, "declared before here");
        }
        let mut st = ety;
        if u.notnil(fixed) {
            st = t;  // (C23: the constants of an enumeration with a fixed type have the enumerated type)
        }
        let s = new_sym(cast.SK_ENUMCONST, en.name, en.span, st);
        s.wide = u.newn.[u64](VL);
        for i in 0..VL {
            s.wide[i] = x.w[i];
        }
        s.value = cty.wrap(st, x.w[0]);
        en.sym = s;
        attr_mark_sym(s, &en.attrs);
        syms.push(s);
        old.push(s);
        declare(en.name, s);
    }
    cdbg.note_enum(t.tag, syms.items());
    if again {
        return same and (k == old.len);
    }
    if u.notnil(fixed) {
        record_consts(t, &syms);
        return true;
    }
    // the compatible type: unsigned int if no value is negative, else int,
    // or (C23) the first wider type that holds them all
    let mut obase: ?*mut cty.CType = .none;
    let mut cands = u.List.[*mut cty.CType].empty();
    if gnu_packed(&ts.attrs) {
        // (a GNU dialect's packed enumeration: the smallest type, from char on)
        if val_neg(min) {
            cands.push(cty.t_schar);
            cands.push(cty.t_short);
        } else {
            cands.push(cty.t_uchar);
            cands.push(cty.t_ushort);
        }
    }
    if val_neg(min) {
        cands.push(cty.t_int);
    } else {
        cands.push(cty.t_uint);
    }
    for c in wider_types(val_neg(min)) {
        cands.push(c);
    }
    for c in cands.items() {
        if fitsv(c, min) and fitsv(c, max) {
            obase = .some(c);
            break;
        }
    }
    let mut base = cty.t_llong;
    if let .some(b) = obase {
        base = b;
    } else {
        err(ts.span, "C3013", "no integer type can represent all the values of the enumeration's constants");
    }
    cty.set_enum_base(t, base);
    if not all_int {
        // (C23: when some value is outside int, the constants have the enumerated type)
        for s in syms.items() {
            s.ty = t;
            s.value = cty.wrap(base, s.wide[0]);
        }
    }
    record_consts(t, &syms);
    return true;
}

// The constants of enumeration t, in its TagInfo (ctypes.same_enum).
fn record_consts(t: *mut cty.CType, syms: *u.List.[*mut cast.CSym]) void {
    let ti = t.unq.tag;
    for s in syms.items() {
        ti.consts.push(s.name);
        // (as a value of the compatible type: the same bits for the same value)
        let mut c: [3]u64 = [s.wide[0], s.wide[1], s.wide[2]];
        wi.wi_norm(&mut c[0], VL, @bit_cast(u32, ti.base.unq.bits), ti.base.unq.is_signed);
        ti.cvals.push(c[0]);
        ti.chis.push(c[1]);
    }
}

// Is the GNU attribute packed among `list` (a GNU dialect)?
fn gnu_packed(list: *u.List.[*mut cast.Attr]) bool {
    if not opts().gnu {
        return false;
    }
    for a in list.items() {
        if u.str_eq(a.prefix, "gnu") and (u.str_eq(a.name, "packed") or u.str_eq(a.name, "__packed__")) {
            return true;
        }
    }
    return false;
}

// a < b.
fn less(a: Val, b: Val) bool {
    return wi.wi_cmp(&a.w[0], &b.w[0], VL, true) < 0;
}
