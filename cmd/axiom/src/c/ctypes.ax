// =============================================================================
// ctypes.ax - C types: their representation, construction, layout for the
// target, compatibility and composite types, the integer promotions and the
// usual arithmetic conversions (C17 6.2.5, 6.2.7, 6.3.1, 6.7.2.1).
//
// Parts: extended scalar/vector types and classification (ctypes_basic.ax),
// derived construction, layout, size/alignment and members (ctypes_layout.ax),
// value ranges, conversions, compatibility and composite types (ctypes_compat.ax).
//
// A type is a CType. The unqualified basic types are made once (init) and
// shared; a qualified type is another CType with the same contents whose
// `unq` is the unqualified one (each type keeps its qualified versions, so
// that they are made once too); pointer types are made once per pointee.
// Array and function types are made as needed and compared structurally;
// structure, union and enumeration types are identified by their TagInfo
// (each struct-or-union-specifier or enum-specifier that declares a new tag
// makes one). Typedef names are transparent: a typedef's type is the type.
//
// The integer types follow the build's choices (copts.ax): plain char is
// signed or unsigned, int is 16, 32 or 64 bits, long 32 or 64; short is 16
// bits and long long 64. The bit-precise integer types (C23 _BitInt(N),
// TK_BITINT, made once per width and signedness) have N bits, N at most
// BITINT_MAXWIDTH (65535); an object of one is stored in the smallest of 8,
// 16, 32 and 64 bits that holds it, or for N > 64 in 64-bit limbs (as many as
// hold it, an even number on AArch64: storage_bits), its value sign- or
// zero-extended there. The GNU dialects' __int128 and unsigned __int128
// (TK_INT128, TK_UINT128) are 128 bits, an extended integer type ranked
// above long long. An integer type wider than 64 bits (is_wint) is a value
// in memory to cgen (cgen_wint.ax), as a structure is. A complex type (TK_COMPLEX, made once for each real
// floating type: complex_of) is laid out as an array of two elements of its
// corresponding real type (`elem`), the real part first (6.2.5p13). The
// decimal floating types (TK_DEC32, TK_DEC64, TK_DEC128, and Annex H's
// TK_DEC64X in decimal128's format: is_decimal) are
// real floating types too (C23 6.2.5p13), but not is_floating's (the
// standard floating types, binary), with which the usual arithmetic
// conversions do not mix them (6.3.1.8); their sizes are 4, 8 and 16 bytes,
// aligned as their sizes. Integer sizes and alignments are their storage widths in bytes,
// as for every scalar on the targets (wasm32, wasm64, x86-64, AArch64), so a
// structure's layout is the natural one: each member at the next offset
// that is a multiple of its alignment, the structure's alignment the largest
// of its members', its size rounded up to that.
// =============================================================================
import "../util.ax" as u;
import "copts.ax" as co;

import part "ctypes_basic.ax";
import part "ctypes_compat.ax";
import part "ctypes_layout.ax";

// What a CType is (CType.kind). The integer kinds are in order of rank,
// signed before unsigned.
pub const TK_ERROR: i32 = 0;  // the type of an erroneous expression: compatible with anything, never reported
pub const TK_VOID: i32 = 1;
pub const TK_BOOL: i32 = 2;
pub const TK_CHAR: i32 = 3;
pub const TK_SCHAR: i32 = 4;
pub const TK_UCHAR: i32 = 5;
pub const TK_SHORT: i32 = 6;
pub const TK_USHORT: i32 = 7;
pub const TK_INT: i32 = 8;
pub const TK_UINT: i32 = 9;
pub const TK_LONG: i32 = 10;
pub const TK_ULONG: i32 = 11;
pub const TK_LLONG: i32 = 12;
pub const TK_ULLONG: i32 = 13;
pub const TK_ENUM: i32 = 14;  // an integer type (its tag's `base`)
pub const TK_FLOAT: i32 = 15;
pub const TK_DOUBLE: i32 = 16;
pub const TK_LDOUBLE: i32 = 17;  // long double: double's representation, or a wider one (is_wide)
pub const TK_POINTER: i32 = 18;
pub const TK_ARRAY: i32 = 19;
pub const TK_FUNCTION: i32 = 20;
pub const TK_STRUCT: i32 = 21;
pub const TK_UNION: i32 = 22;
pub const TK_BITINT: i32 = 23;   // _BitInt(N), unsigned _BitInt(N) (C23): an integer type of `bits` bits
pub const TK_NULLPTR: i32 = 24;  // nullptr_t (C23): a scalar type whose one value is a null pointer
pub const TK_COMPLEX: i32 = 25;  // float/double/long double _Complex (C99 6.2.5p11): `elem` is the real type
pub const TK_INT128: i32 = 26;   // __int128 (a GNU dialect): an extended integer type of 128 bits
pub const TK_UINT128: i32 = 27;  // unsigned __int128
// The interchange and extended floating types (C23 Annex H; TS 18661-3 before
// C23): real floating types, each distinct from the standard ones and from one
// another (ffmt gives each one's format)
pub const TK_FLOAT16: i32 = 28;   // _Float16: binary16
pub const TK_FLOAT32: i32 = 29;   // _Float32: binary32
pub const TK_FLOAT64: i32 = 30;   // _Float64: binary64
pub const TK_FLOAT32X: i32 = 31;  // _Float32x: binary64
pub const TK_FLOAT64X: i32 = 32;  // _Float64x: long double's format where it is wider than double, else binary128
pub const TK_FLOAT128: i32 = 33;  // _Float128 (and __float128 in a GNU dialect): binary128
// A vector type (a GNU dialect: the attribute vector_size): `len` lanes of
// the arithmetic type `elem`; its size is the attribute's (csema_vec.ax)
pub const TK_VECTOR: i32 = 34;
// An imaginary type (C99 Annex G.2): float, double or long double _Imaginary,
// `elem` its corresponding real type; laid out as that type (G.2p2)
pub const TK_IMAGINARY: i32 = 35;
// the decimal floating types (C23 6.2.5p13): real floating types, in the
// IEEE 754 decimal formats of 32, 64 and 128 bits (BID, as the C ABIs of
// the targets say), computed in software (std/c/rt/decimal.ax: cgen_dec.ax)
pub const TK_DEC32: i32 = 36;   // _Decimal32
pub const TK_DEC64: i32 = 37;   // _Decimal64
pub const TK_DEC128: i32 = 38;  // _Decimal128
// _Decimal64x (C23 Annex H.2.4: the extended type of decimal64), in
// decimal128's format (H.2.4p4 allows it), a type of its own
pub const TK_DEC64X: i32 = 39;
// __bf16 (a GNU dialect): the brain floating format, bfloat16 (1 sign bit,
// 8 exponent bits as binary32's, 7 fraction bits), a real floating type
// stored and passed as binary16 is (is_half), computed in float
// (cgen_half.ax); its format for conversions is FMT_BF16, not ffmt's 16
pub const TK_BF16: i32 = 40;

/// The largest N of _BitInt(N) (<limits.h>'s BITINT_MAXWIDTH).
pub const BITINT_MAXWIDTH: i32 = 65535;

/// cfmt's format of __bf16 (bfloat16): cldbl.BITS_BF16.
pub const FMT_BF16: i32 = -16;

// Qualifiers (CType.quals): as cast.Q_.
pub const Q_CONST: i32 = 1;
pub const Q_VOLATILE: i32 = 2;
pub const Q_RESTRICT: i32 = 4;
pub const Q_ATOMIC: i32 = 8;

const RANK_STEP: i32 = 100;
// The ranks of the integer types wider than 64 bits: WIDE_RANK + 2N for
// _BitInt(N), one more for __int128 (C23 6.3.1.1p1 leaves the order of a
// bit-precise and an extended integer type of one width to the
// implementation).
const WIDE_RANK: i32 = 7 * RANK_STEP;

/// A member of a structure or union.
pub struct Member {
    pub name: []u8,  // empty for an unnamed member (an anonymous structure or union)
    pub span: u.Span,
    pub ty: *mut CType,
    pub offset: u64,  // a bit-field's: the offset of the storage unit (of its type's size) that holds it
    pub index: i32,   // its place among the members
    pub align: u64,   // an alignment specifier's (_Alignas), or 0
    // a bit-field (6.7.2.1p9-12): its width, and its place in its storage
    // unit (bits from the least significant); an unnamed one has an empty
    // name and takes no part in initialization or member access
    pub is_bitfield: bool,
    pub bit_width: i32,
    pub bit_off: i32,
    // a GNU dialect: a member of a packed structure, or under #pragma pack
    // (csema_bits.ax): the alignment it was placed at (0: its type's), and
    // for a bit-field placed at any bit the width of its unit in bits (0:
    // its type's), which is reached with that alignment
    pub packed: bool,  // the attribute packed on the member itself
    pub place_align: u64,
    pub unit_bits: i32,
}

/// What a structure, union or enumeration type is: its tag, members and
/// layout (or, for an enumeration, its compatible integer type).
pub struct TagInfo {
    pub kind: i32,   // TK_STRUCT, TK_UNION or TK_ENUM
    pub name: []u8,  // empty for an untagged one
    pub span: u.Span,
    pub complete: bool,
    pub defining: bool,  // its member list is being read (a member of its own type is incomplete)
    pub members: u.List.[*mut Member],
    pub size: u64,
    pub align: u64,
    pub has_flex: bool,    // a structure that ends with a flexible array member
    pub in_block: bool,    // its member list is in a block (or a prototype), not at file scope
    pub base: *mut CType,  // TK_ENUM: the compatible integer type
    // TK_ENUM: the fixed underlying type (C23 `enum E : T`), or nil; whether its list was seen
    pub fixed: *mut CType,
    pub listed: bool,
    // TK_ENUM: its constants' names and values (C23's compatibility of
    // enumerations with the same tag: same_enum)
    pub consts: u.List.[[]u8],
    pub cvals: u.List.[u64],
    pub chis: u.List.[u64],  // (the bits above the first 64 of each, of a type wider than 64 bits)
    pub id: i32,
    // a GNU dialect: the attribute packed, a #pragma pack value (0: none),
    // the alignment the attribute aligned asks for (0: none)
    pub packed: bool,
    pub pack: u64,
    pub min_align: u64,
    // a GNU dialect on x86-64: the attribute ms_struct or #pragma ms_struct
    // (LAYOUT_MS), or gcc_struct (LAYOUT_GCC); else LAYOUT_TARGET
    pub layout: i32,
    pub transparent: bool,  // a union: the GNU attribute transparent_union
}

/// TagInfo.layout: the target's layout of bit-fields; the Microsoft one
/// (Windows x64's); the System V one (x86-64 Linux's).
pub const LAYOUT_TARGET: i32 = 0;
pub const LAYOUT_MS: i32 = 1;
pub const LAYOUT_GCC: i32 = 2;

pub struct CType {
    pub kind: i32,
    pub quals: i32,       // Q_ bits
    pub unq: *mut CType,  // the unqualified version (itself if quals is 0)
    // integers: their width in bits, signedness and rank (6.3.1.1)
    pub bits: i32,
    pub is_signed: bool,
    pub rank: i32,
    // pointer, array: the referenced or element type
    pub elem: *mut CType,
    // array
    pub len: u64,
    pub has_len: bool,     // complete (a length is known)
    pub vla: bool,         // a variable length array: complete, its length known at run time (len 0, has_len false)
    pub vexpr: *mut void,  // a VLA's length: the expression (cast.Expr, of type size_t) evaluated where its
                           // declarator is reached; nil for `[*]` (csema_vla.ax, cgen_vla.ax)
    // function
    pub ret: *mut CType,
    pub params: []mut *mut CType,  // adjusted parameter types (arrays and functions become pointers), unqualified
    pub proto: bool,               // a prototype (otherwise: an old-style declaration, `()` before C23)
    pub kr: bool,                  // not a prototype: the type of a definition with an identifier list (params: its
                                   // parameters' declared types, adjusted)
    pub variadic: bool,            // ends with `...`
    // structure, union, enumeration
    pub tag: *mut TagInfo,
    // made once: the pointer to it, its qualified versions (by quals)
    ptr: ?*mut CType,
    qv: [16]?*mut CType,
    pub backend: *mut void,  // IR generation's type for it (unqualified types only)
    pub id: i32,
    // a real floating type: its complex and imaginary types (made once: complex_of, imaginary_of)
    cplx: ?*mut CType,
    imag: ?*mut CType,
    // a GNU dialect's typedef with the attribute aligned: the alignment it
    // gives the type (0: the type's own); `unq` is the type without it
    xalign: u64,
}

/// A member found by name: the member, and its offset from the start of the
/// structure or union searched (through unnamed members, C11 6.7.2.1p13).
pub struct Found {
    pub m: *mut Member,
    pub offset: u64,
}

let mut g_opts: *co.COptions = @ptr_from_int(*co.COptions, 0);
let mut g_next_id: i32 = 0;

pub let mut t_error: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_void: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_bool: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_char: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_schar: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_uchar: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_short: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_ushort: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_int: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_uint: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_long: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_ulong: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_llong: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_ullong: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_float: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_double: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_ldouble: *mut CType = @ptr_from_int(*mut CType, 0);
// the implementation's choices among them
pub let mut t_size: *mut CType = @ptr_from_int(*mut CType, 0);     // size_t: sizeof, _Alignof
pub let mut t_ptrdiff: *mut CType = @ptr_from_int(*mut CType, 0);  // ptrdiff_t: pointer differences
pub let mut t_wchar: *mut CType = @ptr_from_int(*mut CType, 0);    // wchar_t: L'x', L"..."
pub let mut t_char16: *mut CType = @ptr_from_int(*mut CType, 0);   // char16_t (uint_least16_t)
pub let mut t_char32: *mut CType = @ptr_from_int(*mut CType, 0);   // char32_t (uint_least32_t)
pub let mut t_int64: *mut CType = @ptr_from_int(*mut CType, 0);    // __axiom_int64: long or long long
pub let mut t_nullptr: *mut CType = @ptr_from_int(*mut CType, 0);  // nullptr_t (C23)
// the complex types (C99): float _Complex, double _Complex, long double _Complex
pub let mut t_cfloat: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_cdouble: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_cldouble: *mut CType = @ptr_from_int(*mut CType, 0);
// the interchange and extended floating types (Annex H)
pub let mut t_float16: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_bf16: *mut CType = @ptr_from_int(*mut CType, 0);  // __bf16 (a GNU dialect)
pub let mut t_float32: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_float64: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_float32x: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_float64x: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_float128: *mut CType = @ptr_from_int(*mut CType, 0);
/// Whether the unit has used a floating type that std/c/rt/ldouble.ax
/// computes (_Float16, or a binary128 or x87 one other than long double).
pub let mut g_used_xfloat: bool = false;
// the vector types made so far (vector_of)
let mut g_vectors: u.List.[*mut CType] = u.List.[*mut CType].{ data: @ptr_from_int(*mut *mut CType, 0), len: 0,
                                                               cap: 0 };
// __int128, unsigned __int128 (a GNU dialect)
pub let mut t_int128: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_uint128: *mut CType = @ptr_from_int(*mut CType, 0);
// _Decimal32, _Decimal64, _Decimal128 (C23)
pub let mut t_dec32: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_dec64: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_dec128: *mut CType = @ptr_from_int(*mut CType, 0);
pub let mut t_dec64x: *mut CType = @ptr_from_int(*mut CType, 0);  // _Decimal64x (Annex H)
pub let mut ptr_bytes: u64 = 8;
// the bit-precise integer types made so far, by width (signed, unsigned)
// [n]: _BitInt(n); [65 + n]: unsigned _BitInt(n), for n <= 64; the wider
// ones in g_wide_bitint
let mut g_bitint: u.List.[?*mut CType] = u.List.[?*mut CType].{ data: @ptr_from_int(*mut ?*mut CType, 0), len: 0,
                                                                cap: 0 };
let mut g_wide_bitint: u.List.[*mut CType] = u.List.[*mut CType].{ data: @ptr_from_int(*mut *mut CType, 0), len: 0,
                                                                   cap: 0 };
/// Whether the unit has used an integer type wider than 64 bits (whose
/// operations may need std/c/rt/wideint.ax).
pub let mut g_used_wint: bool = false;
/// Whether the unit has an operation on decimal floating values (which
/// needs std/c/rt/decimal.ax: note_dec).
pub let mut g_used_dec: bool = false;

// The pairs of structures or unions whose members same_content is comparing
// (a pair met again, through a pointer member, is taken to match).
let mut g_comparing: u.List.[*TagInfo] = u.List.[*TagInfo].{ data: @ptr_from_int(*mut *TagInfo, 0), len: 0, cap: 0 };

fn new_type(k: i32) *mut CType {
    let t = u.new.[CType]();
    t.kind = k;
    t.unq = t;
    g_next_id += 1;
    t.id = g_next_id;
    return t;
}

fn int_type(k: i32, bits: i32, signed_: bool, rank: i32) *mut CType {
    let t = new_type(k);
    t.bits = bits;
    t.is_signed = signed_;
    t.rank = rank;
    return t;
}

// The standard integer type of `bits` bits and signedness `sg`, among
// int, long, long long, short (in that order of preference); .none if none.
fn int_of_width(bits: i32, sg: bool) ?*mut CType {
    let cands: [4]*mut CType = [t_int, t_long, t_llong, t_short];
    for c in cands {
        if c.bits == bits {
            return pick_sign(c, sg);
        }
    }
    return .none;
}

fn pick_sign(t: *mut CType, sg: bool) *mut CType {
    if sg {
        return to_signed(t);
    }
    return to_unsigned(t);
}

/// Makes the basic types for the options `o` (once per translation unit).
pub fn init(o: *co.COptions) void {
    g_opts = o;
    ptr_bytes = @as(u64, @bit_cast(u32, o.ptr_bits / 8));
    t_error = new_type(TK_ERROR);
    t_void = new_type(TK_VOID);
    // (ranks in steps of RANK_STEP, which leaves room for the bit-precise types': bitint)
    t_bool = int_type(TK_BOOL, 8, false, RANK_STEP);
    t_char = int_type(TK_CHAR, 8, o.char_signed, 2 * RANK_STEP);
    t_schar = int_type(TK_SCHAR, 8, true, 2 * RANK_STEP);
    t_uchar = int_type(TK_UCHAR, 8, false, 2 * RANK_STEP);
    t_short = int_type(TK_SHORT, 16, true, 3 * RANK_STEP);
    t_ushort = int_type(TK_USHORT, 16, false, 3 * RANK_STEP);
    t_int = int_type(TK_INT, o.int_bits, true, 4 * RANK_STEP);
    t_uint = int_type(TK_UINT, o.int_bits, false, 4 * RANK_STEP);
    t_long = int_type(TK_LONG, o.long_bits, true, 5 * RANK_STEP);
    t_ulong = int_type(TK_ULONG, o.long_bits, false, 5 * RANK_STEP);
    t_llong = int_type(TK_LLONG, 64, true, 6 * RANK_STEP);
    t_ullong = int_type(TK_ULLONG, 64, false, 6 * RANK_STEP);
    t_float = new_type(TK_FLOAT);
    t_float.bits = 32;
    t_double = new_type(TK_DOUBLE);
    t_double.bits = 64;
    t_ldouble = new_type(TK_LDOUBLE);
    t_ldouble.bits = o.ld_bits;
    t_float16 = new_type(TK_FLOAT16);
    t_float16.bits = 16;
    t_bf16 = new_type(TK_BF16);
    t_bf16.bits = 16;
    t_float32 = new_type(TK_FLOAT32);
    t_float32.bits = 32;
    t_float64 = new_type(TK_FLOAT64);
    t_float64.bits = 64;
    t_float32x = new_type(TK_FLOAT32X);
    t_float32x.bits = 64;
    t_float64x = new_type(TK_FLOAT64X);
    t_float64x.bits = x64_bits(o);
    t_float128 = new_type(TK_FLOAT128);
    t_float128.bits = 128;
    g_vectors = u.List.[*mut CType].empty();
    t_nullptr = new_type(TK_NULLPTR);
    t_nullptr.bits = o.ptr_bits;
    t_cfloat = complex_type(t_float);
    t_cdouble = complex_type(t_double);
    t_cldouble = complex_type(t_ldouble);
    t_dec32 = new_type(TK_DEC32);
    t_dec32.bits = 32;
    t_dec64 = new_type(TK_DEC64);
    t_dec64.bits = 64;
    t_dec128 = new_type(TK_DEC128);
    t_dec128.bits = 128;
    t_dec64x = new_type(TK_DEC64X);
    t_dec64x.bits = 128;
    g_bitint = u.List.[?*mut CType].empty();
    for i in @as(usize, 0)..130 {
        _ = i;
        g_bitint.push(.none);
    }
    g_wide_bitint = u.List.[*mut CType].empty();
    // (above long long, and above _BitInt(128): bitint)
    t_int128 = int_type(TK_INT128, 128, true, WIDE_RANK + (2 * 128) + 1);
    t_uint128 = int_type(TK_UINT128, 128, false, WIDE_RANK + (2 * 128) + 1);
    // size_t and ptrdiff_t: the platform's type as wide as a pointer
    // (copts.size_type, as <stddef.h> has it); wchar_t: (unsigned) short
    // when 16 bits, else int, or long when int is 16 bits (as <stddef.h> says)
    t_size = of_rank(co.size_type(o), false);
    t_ptrdiff = to_signed(t_size);
    if o.wchar_bits == 16 {
        t_wchar = pick_sign(t_short, o.wchar_signed);
    } else if (t_int.bits == 32) or ((t_long.bits != 32) and (t_int.bits >= 32)) {
        t_wchar = pick_sign(t_int, o.wchar_signed);
    } else {
        t_wchar = pick_sign(t_long, o.wchar_signed);
    }
    t_char16 = t_ushort;
    if let .some(tc) = int_of_width(32, false) {
        t_char32 = tc;
    } else {
        // (no 32-bit type: the narrowest wider one, as <stdint.h> says)
        t_char32 = t_ulong;
        if t_uint.bits >= 32 {
            t_char32 = t_uint;
        }
    }
    t_int64 = of_rank(co.int64_type(o), true);
}

// The standard integer type of copts rank code r, signed or unsigned.
fn of_rank(r: i32, signed: bool) *mut CType {
    let ts: [5]*mut CType = [t_schar, t_short, t_int, t_long, t_llong];
    let t = ts[@int_cast(usize, r - co.R_CHAR)];
    if signed {
        return t;
    }
    return to_unsigned(t);
}

/// The standard in force.
pub fn std() i32 {
    return g_opts.std;
}

// -----------------------------------------------------------------------------
// Spelling (for diagnostics)
// -----------------------------------------------------------------------------

fn base_name(t: *CType) []u8 {
    let names = ["<error>", "void", "_Bool", "char", "signed char", "unsigned char", "short", "unsigned short", "int",
                 "unsigned int", "long", "unsigned long", "long long", "unsigned long long", "enum", "float", "double",
                 "long double"];
    let k = t.kind;
    if (k == TK_BOOL) and (g_opts.std >= co.C23) {
        return "bool";
    }
    if k == TK_BITINT {
        return u.f2("%s_BitInt(%s)", u.pick(t.is_signed, "", "unsigned "), u.idec(t.bits));
    }
    if k == TK_INT128 {
        return "__int128";
    }
    if k == TK_UINT128 {
        return "unsigned __int128";
    }
    if k == TK_DEC32 {
        return "_Decimal32";
    }
    if k == TK_DEC64 {
        return "_Decimal64";
    }
    if k == TK_DEC128 {
        return "_Decimal128";
    }
    if k == TK_DEC64X {
        return "_Decimal64x";
    }
    if k == TK_NULLPTR {
        return "nullptr_t";
    }
    if k == TK_COMPLEX {
        return u.cat2(base_name(t.elem), " _Complex");
    }
    if k == TK_IMAGINARY {
        return u.cat2(base_name(t.elem), " _Imaginary");
    }
    if k == TK_VECTOR {
        return u.f2("%s __attribute__((vector_size(%s)))", base_name(t.elem), u.udec(size_of(t)));
    }
    if k == TK_BF16 {
        return "__bf16";
    }
    if (k >= TK_FLOAT16) and (k <= TK_FLOAT128) {
        let xs = ["_Float16", "_Float32", "_Float64", "_Float32x", "_Float64x", "_Float128"];
        return xs[@int_cast(usize, k - TK_FLOAT16)];
    }
    if (k == TK_STRUCT) or (k == TK_UNION) or (k == TK_ENUM) {
        let kw = u.pick(k == TK_STRUCT, "struct", u.pick(k == TK_UNION, "union", "enum"));
        if t.tag.name.len == 0 {
            return u.cat2(kw, " <anonymous>");
        }
        return u.f2("%s %s", kw, t.tag.name);
    }
    return names[@int_cast(usize, k)];
}

fn quals_text(q: i32) []u8 {
    let mut b = u.Buf.init();
    if (q & Q_CONST) != 0 {
        b.s("const ");
    }
    if (q & Q_VOLATILE) != 0 {
        b.s("volatile ");
    }
    if (q & Q_RESTRICT) != 0 {
        b.s("restrict ");
    }
    if (q & Q_ATOMIC) != 0 {
        b.s("_Atomic ");
    }
    return b.done();
}

// t spelled as a declaration of `inner` (a declarator, maybe empty).
fn spell(t: *CType, inner: []u8) []u8 {
    let k = t.kind;
    if k == TK_POINTER {
        let mut q = quals_text(t.quals);
        if q.len > 0 {
            q = q[0..q.len - 1];
            if inner.len > 0 {
                q = u.cat2(q, " ");
            }
        }
        let mut d = u.cat3("*", q, inner);
        let ek = t.elem.kind;
        if (ek == TK_ARRAY) or (ek == TK_FUNCTION) {
            d = u.cat3("(", d, ")");
        }
        return spell(t.elem, d);
    }
    if k == TK_ARRAY {
        let mut n: []u8 = "";
        if t.has_len {
            n = u.udec(t.len);
        } else if t.vla {
            n = "*";
        }
        return spell(t.elem, u.f2("%s[%s]", inner, n));
    }
    if k == TK_FUNCTION {
        let mut b = u.Buf.init();
        let mut n_shown: usize = 0;
        if t.proto {
            n_shown = t.params.len;
        }
        b.s(inner);
        b.s("(");
        // (a type without a prototype shows no parameters, as it is written)
        for i in 0..n_shown {
            if i > 0 {
                b.s(", ");
            }
            b.s(spell(t.params[i], ""));
        }
        if t.variadic {
            b.s(u.pick(t.params.len > 0, ", ...", "..."));
        } else if t.proto and (t.params.len == 0) {
            b.s("void");
        }
        b.s(")");
        return spell(t.ret, b.done());
    }
    let base = u.cat2(quals_text(t.quals), base_name(t));
    if inner.len == 0 {
        return base;
    }
    return u.cat3(base, " ", inner);
}

/// The type as C spells it in a type name: "unsigned long", "char *", "int (*)[3]".
pub fn type_str(t: *CType) []u8 {
    return spell(t, "");
}
