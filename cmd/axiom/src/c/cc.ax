// =============================================================================
// cc.ax - the C front end's driver: what `axiom build file.c` does.
//
//   --emit=c-pp    the preprocessed text
//   --emit=c-ast   the syntax tree, as text
//
// (docs/c.md describes the options; docs/c-frontend.md the design.)
// =============================================================================
import "../diag.ax" as dg;
import "../util.ax" as u;
import "cast_dump.ax" as cdump;
import "copts.ax" as co;
import "cparse.ax" as cparse;
import "cpp.ax" as cpp;

/// Compiles the C source at `path`. `emit` is the --emit kind, `out` the
/// output path (empty: standard output, for the text kinds). The exit status.
pub fn run(path: []u8, o: *co.COptions, emit: []u8, out: []u8, json: bool) i32 {
    let toks = cpp.preprocess(path, o);
    if dg.error_count() > 0 {
        dg.emit(json, json);
        return 1;
    }
    let mut text = u.nosym();
    if u.str_eq(emit, "c-pp") {
        text = cpp.text_of(toks.items());
    } else if u.str_eq(emit, "c-ast") {
        // (dumped after errors too: the tree is safe to walk either way)
        text = cdump.dump(cparse.parse(toks.items(), o));
    } else {
        dg.emit_fatal(json, "E9001", "compiling C is not implemented yet: use --emit=c-pp or --emit=c-ast");
        return 2;
    }
    dg.emit(json, json);
    if dg.error_count() > 0 {
        return 1;
    }
    if out.len == 0 {
        u.print(text);
    } else if not u.write_file(out, text) {
        dg.emit_fatal(json, "E9001", u.f1("cannot write %s", out));
        return 2;
    }
    return 0;
}
