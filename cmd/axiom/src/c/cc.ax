// =============================================================================
// cc.ax - the C front end's driver: what `axiom build file.c...` does.
//
//   --emit=c-pp    the preprocessed text
//   --emit=c-ast   the syntax tree, as text
//   --emit=c-tokens  the tokens and their values, one to a line (for tests)
//   --emit=exe|obj|ir  a program: each translation unit is analyzed here
//                  (check), the units are linked (link_check: one definition
//                  of each external name, and main), and main.ax builds the
//                  start-up module (std/internal/runtime/c_start.ax) as an
//                  Axiom program, whose IR module the units' code joins
//                  (gen_ir, called by codegen.ax) before the optimizer and
//                  backends run
//
// Several units are one IR module: their names with external linkage are
// the same symbols (a reference in one unit to another's definition is to
// it), names with internal linkage are numbered apart (csema.ax: uid).
//
// C beside Axiom (docs/c.md, "C and Axiom in one program"): the units join
// the module of an Axiom program (`axiom build main.ax x.c`), or a C
// program's start-up module with Axiom modules beside it (`axiom build
// main.c rt.ax`). A C declaration of a function that Axiom code defines (an
// `export fn`) calls it; an Axiom `extern "C"` function that a unit defines
// is that definition. boundary_check reports a name both define (C3065).
//
// A library's units (check with lib: a C library's sources) give way: a
// name a program's unit defines is that unit's, and the library's
// definition of it is dropped (as an archive's member would not be linked,
// 7.1.3 leaves the rest to the implementation). So does a weak definition
// (CSym.weak, which only an extension can make) to a definition that is not
// weak; of two weak ones the first is kept. Everything a unit defines that
// the program does not reach is left out of an executable (cstrip.ax).
//
// (docs/c.md describes the options; docs/c-frontend.md the design.)
// =============================================================================
import "../asm/a64.ax" as asm64;
import "../asm/core.ax" as acr;
import "../asm/inline.ax" as ai;
import "../asm/wasm.ax" as aw;
import "../asm/x64.ax" as asm86;
import "../dbginfo.ax" as dbi;
import "../diag.ax" as dg;
import "../ir.ax" as ir;
import "../target.ax" as tg;
import "../util.ax" as u;
import "cast.ax" as cast;
import "cast_dump.ax" as cdump;
import "cgen.ax" as cg;
import "cgen_atomic.ax" as cga;
import "cgen_stmt.ax" as cgs;
import "cgen_tls.ax" as cgt;
import "copts.ax" as co;
import "cparse.ax" as cparse;
import "cpp.ax" as cpp;
import "csema.ax" as cs;
import "csema_gbuiltin.ax" as cgbi;
import "csema_marks.ax" as csm;
import "csema_stmt.ax" as css;
import "ctypes.ax" as cty;

// The checked units, in the order of the command line, and the file each
// is (for diagnostics about the whole program).
let mut g_units: u.List.[*mut cs.CUnit] = u.List.[*mut cs.CUnit].{ data: @ptr_from_int(*mut *mut cs.CUnit, 0), len: 0,
                                                                   cap: 0 };
let mut g_files: u.List.[i32] = u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 };
// Where gen_ir put the library's units: their functions and globals are
// m.funcs[g_lib_funcs..] and m.globals[g_lib_globals..] (to the end of the
// units' part), which codegen.ax strips even when the system's linker
// links the program.
pub let mut g_lib_funcs: usize = 0;
pub let mut g_lib_globals: usize = 0;

// Whether each unit is a library's (check: lib).
let mut g_lib: u.List.[bool] = u.List.[bool].{ data: @ptr_from_int(*mut bool, 0), len: 0, cap: 0 };
// The external names the units define (after link_check): the definition.
let mut g_defs: u.SymMap.[*mut cast.CSym] = u.SymMap.[*mut cast.CSym].{ keys: @ptr_from_int(*mut usize, 0),
                                                                        vals: @ptr_from_int(*mut *mut cast.CSym, 0),
                                                                        cap: 0, len: 0 };

/// Is `emit` one of the C front end's text outputs (run makes them)?
pub fn text_emit(emit: []u8) bool {
    return u.str_eq(emit, "c-pp") or u.str_eq(emit, "c-tokens") or u.str_eq(emit, "c-ast");
}

/// Preprocesses, parses and analyzes the C source at `path`; true if it
/// has no errors (they are reported through diag.ax, not emitted), and
/// then its typed unit is one gen_ir generates. `lib`: the unit is a
/// library's, whose definitions give way to the program's (link_check).
// Each unit's --c-fenv-access (cgen.ax: fenv_all).
let mut g_fenv: u.List.[bool] = u.List.[bool].{ data: @ptr_from_int(*mut bool, 0), len: 0, cap: 0 };

pub fn check(path: []u8, o: *co.COptions, lib: bool) bool {
    cgbi.install();
    dbi.c_version = co.stdc_version(o.std);  // (the debug information's language)
    let before = dg.error_count();
    cpp.g_lib_unit = lib;
    let toks = cpp.preprocess(path, o);
    cpp.g_lib_unit = false;
    if dg.error_count() > before {
        return false;
    }
    // (the syntax tree and what analysis makes of it are needed until the
    // IR is made: they are allocated with the Axiom code's syntax tree, and
    // given back with it, codegen.ax; the files and the diagnostics are not)
    let tree = u.tree_default;
    u.tree_default = true;
    defer u.tree_default = tree;
    let t = cparse.parse(toks.items(), o);
    // (the tree holds copies of the tokens it needs: the list is given back)
    let eof_file = toks.get(toks.len - 1).span.file;
    toks.deinit();
    if dg.error_count() > before {
        return false;
    }
    let cu = css.analyze(t, o);
    if dg.error_count() > before {
        return false;
    }
    g_units.push(cu);
    g_fenv.push(o.fenv_access);
    // (the end of file token's span is in the unit's own file)
    g_files.push(eof_file);
    g_lib.push(lib);
    return true;
}

/// --emit=c-lib-defs (the C library's index, cmd/internal/tools/
/// gen_c_lib_index.mjs): checks `path` as a unit of the library and
/// prints the external names it defines, one to a line.
pub fn lib_defs(path: []u8, o: *co.COptions, json: bool) i32 {
    if not check(path, lib_options(o), true) {
        dg.emit(json, json);
        return 1;
    }
    let cu = g_units.get(g_units.len - 1);
    let mut b = u.Buf.init();
    for f in cu.funcs.items() {
        if (f.linkage == cast.LK_EXTERNAL) and not csm.is_inline_def(f) {
            b.s(f.name);
            b.c('\n');
        }
    }
    for x in cu.objects.items() {
        if x.linkage == cast.LK_EXTERNAL {
            b.s(x.name);
            b.c('\n');
        }
    }
    u.print(b.done());
    return 0;
}

/// The external names the last unit checked uses and does not define.
pub fn last_refs() [][]u8 {
    if g_units.len == 0 {
        return u.nil_slice.[[]u8]();
    }
    return g_units.get(g_units.len - 1).refs.items();
}

/// The external names that the units checked so far define (and the
/// assembly sources' global symbols).
pub fn defined_names(out: *mut u.SymMap.[i32]) void {
    for n in g_asm_def_names.items() {
        out.put(n, 1);
    }
    for cu in g_units.items() {
        for f in cu.funcs.items() {
            if f.linkage == cast.LK_EXTERNAL {
                out.put(u.intern(f.name), 1);
            }
        }
        for x in cu.objects.items() {
            if x.linkage == cast.LK_EXTERNAL {
                out.put(u.intern(x.name), 1);
            }
        }
    }
}

/// The external names the units checked so far use and do not define (and
/// the names the assembly sources refer to).
pub fn all_refs(out: *mut u.List.[[]u8]) void {
    for r in g_asm_refs.items() {
        out.push(r);
    }
    for cu in g_units.items() {
        for r in cu.refs.items() {
            out.push(r);
        }
    }
}

/// The options a library's units are checked with: C17 (the library's
/// sources are), with the build's --c-int, --c-long and --c-char, and no
/// -D or -I of the program's.
pub fn lib_options(o: *co.COptions) *co.COptions {
    let lo = u.new.[co.COptions]();
    lo.* = o.*;
    lo.std = co.C17;
    lo.gnu = false;  // (C17 without extensions: the library's sources are C17)
    lo.warn_pragmas = false;
    lo.asm_intel = false;
    lo.warn_format = 1;  // (its own calls checked for what is wrong, not the level-2 matters)
    lo.defines = u.nil_slice.[co.Define]();
    lo.include_dirs = u.nil_slice.[[]u8]();
    lo.hosted = true;  // (its headers are all found)
    return lo;
}

// The span of the definition of s, a function or object of unit k.
fn def_span(s: *cast.CSym) u.Span {
    if (s.kind == cast.SK_FUNC) and u.notnil(s.def) {
        return s.def.decls.get(0).name_span;
    }
    return s.span;
}

/// After every unit is checked: the program's external names have one
/// definition each (6.9p5: C3064), and (program: an executable whose main
/// is C's, not an object or a program whose main is Axiom's) one unit
/// defines main (C3063). A library unit's definition of a name that a
/// program unit defines is dropped (the header). True if so (else
/// reported).
pub fn link_check(program: bool) bool {
    g_defs = u.SymMap.[*mut cast.CSym].{ keys: u.nil.[usize](), vals: u.nil.[*mut cast.CSym](), cap: 0, len: 0 };
    let mut ok = true;
    // the program's units first, so that a library's definitions find theirs
    g_dropped = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    for pass in @as(usize, 0)..2 {
        for k in 0..g_units.len {
            let lib = g_lib.get(k);
            if lib != (pass == 1) {
                continue;
            }
            ok = define_unit(g_units.get(k), lib) and ok;
        }
    }
    if g_dropped.len > 0 {
        for cu in g_units.items() {
            drop_from(cu);
        }
    }
    if program and ok and u.isnil(main_unit()) and (g_files.len > 0) {
        _ = dg.err(u.mkspan(g_files.get(0), 0, 0), "C3063", "the program has no function main");
        ok = false;
    }
    return ok;
}

// The definitions that give way to others (link_check), by address.
let mut g_dropped: u.SymMap.[i32] = u.SymMap.[i32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0), cap: 0, len: 0 };

// Enters unit cu's external definitions into g_defs (C3064 for a second
// one). False after an error.
fn define_unit(cu: *mut cs.CUnit, lib: bool) bool {
    let mut ok = true;
    for f in cu.funcs.items() {
        if (f.linkage == cast.LK_EXTERNAL) and not csm.is_inline_def(f) {
            define(f, lib, &mut ok);
        }
    }
    for x in cu.objects.items() {
        if x.linkage == cast.LK_EXTERNAL {
            define(x, lib, &mut ok);
        }
    }
    return ok;
}

// Takes the definitions that give way out of unit cu: what refers to them
// refers to the definition that is kept, of the same name.
fn drop_from(cu: *mut cs.CUnit) void {
    let mut funcs = u.List.[*mut cast.CSym].empty();
    for f in cu.funcs.items() {
        if not g_dropped.has(u.addr_key(@int_from_ptr(f))) {
            funcs.push(f);
        }
    }
    let mut objects = u.List.[*mut cast.CSym].empty();
    for x in cu.objects.items() {
        if not g_dropped.has(u.addr_key(@int_from_ptr(x))) {
            objects.push(x);
        }
    }
    cu.funcs = funcs;
    cu.objects = objects;
}

// s (a definition) is not the one linked.
fn drop(s: *mut cast.CSym) void {
    s.def = u.nil.[cast.Decl]();
    s.defined = false;
    g_dropped.put(u.addr_key(@int_from_ptr(s)), 1);
}

// Enters s, an external definition, into g_defs, or drops it or the one
// before it: a library's (s is one: lib) gives way to the program's, a weak
// one to one that is not. A second definition otherwise is C3064 (*ok
// false).
fn define(s: *mut cast.CSym, lib: bool, ok: *mut bool) void {
    let key = u.intern(s.name);
    let prev = g_defs.get(key);
    if u.isnil(prev) {
        g_defs.put(key, s);
        return;
    }
    if lib and not is_lib_sym(prev) {
        drop(s);  // the program defines it: the library's is not linked
        return;
    }
    if s.weak {
        drop(s);  // (of two weak ones, the first)
        return;
    }
    if prev.weak {
        drop(prev);
        g_defs.put(key, s);
        return;
    }
    let d = dg.err(def_span(s), "C3064",
                   u.f1("'%s' is defined in two translation units (an external name has one definition)", s.name));
    dg.note(d, def_span(prev), "the other definition");
    ok.* = false;
}

// Is s (in g_defs) a library unit's definition?
fn is_lib_sym(s: *mut cast.CSym) bool {
    for k in 0..g_units.len {
        if not g_lib.get(k) {
            continue;
        }
        let cu = g_units.get(k);
        for f in cu.funcs.items() {
            if f == s {
                return true;
            }
        }
        for x in cu.objects.items() {
            if x == s {
                return true;
            }
        }
    }
    return false;
}

/// Does a unit define the external name `name` (after link_check)? (An
/// assembly source's global symbol too.)
pub fn defines(name: []u8) bool {
    return u.notnil(g_defs.get(u.intern(name))) or (g_asm_defs.get(u.intern(name)) != 0);
}

// -----------------------------------------------------------------------------
// Assembly sources (axiom build main.c x.s y.S): translation units of
// assembly, assembled into the program's object as file-scope asm is (a
// `.S` source preprocessed first, with __ASSEMBLER__ defined). What they
// define and refer to joins the units' names: a C unit refers to their
// global symbols, and the C library's units they use are linked.
// -----------------------------------------------------------------------------
let mut g_asm_blobs: u.List.[*mut ai.Blob] = u.List.[*mut ai.Blob].{ data: @ptr_from_int(*mut *mut ai.Blob, 0), len: 0,
                                                                     cap: 0 };
let mut g_asm_defs: u.SymMap.[i32] = u.SymMap.[i32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0), cap: 0, len: 0 };
let mut g_asm_refs: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
let mut g_asm_def_names: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };

/// Is `path` an assembly source (.s, or .S to preprocess)?
pub fn is_asm_source(path: []u8) bool {
    return (path.len > 2) and (u.ends(path, ".s") or u.ends(path, ".S"));
}

/// Reads (and for a .S source preprocesses) the assembly source at `path`
/// and assembles it for the target (on WebAssembly, the text format: module
/// fields), to check it and learn its names; true if it has no errors
/// (reported: C3097 at its line).
pub fn check_asm(path: []u8, o: *co.COptions) bool {
    let before = dg.error_count();
    let mut text = u.nosym();
    let mut fid: i32 = -1;
    if u.ends(path, ".S") {
        text = cpp.preprocess_asm(path, o);
        fid = cpp.asm_file_id();
    } else {
        let sf = u.load_file(path, u.nosym());
        if u.isnil(sf) {
            dg.emit_fatal(false, "E0211", u.f1("cannot read '%s'", path));
            return false;
        }
        text = sf.text;
        fid = sf.id;
    }
    if dg.error_count() > before {
        return false;
    }
    let sp = u.mkspan(fid, 0, 0);
    if tg.is_wasm() {
        return check_wasm_asm(text, fid);
    }
    let intel = (tg.g_arch == tg.ARCH_X64) and o.asm_intel;
    let mut A = u.nil.[acr.Asm]();
    if tg.g_arch == tg.ARCH_X64 {
        A = asm86.assemble_file(text, intel);
    } else {
        A = asm64.assemble_file(text);
    }
    if acr.failed(A) {
        // (at its line: the text keeps the source's lines)
        let line = @max(A.err_line, 1);
        let mut at: u32 = 0;
        let sf = u.file_of(fid);
        let mut l: i32 = 1;
        while (@as(usize, at) < sf.text.len) and (l < line) {
            if sf.text[@as(usize, at)] == '\n' {
                l += 1;
            }
            at += 1;
        }
        _ = dg.err(u.mkspan(fid, at, at), "C3097", A.err);
        return false;
    }
    // its names: the global symbols it defines, and those it refers to and does not define
    for d in A.defs.items() {
        if (d.global or d.weak) and (d.sec >= 0) and not d.abs {
            g_asm_defs.put(u.intern(d.name), 1);
            g_asm_def_names.push(u.intern(d.name));
        }
    }
    for r in A.relocs.items() {
        let k = A.names.get(u.intern(r.name));
        if (k == 0) or (A.defs.get(@int_cast(usize, k - 1)).sec < 0) {
            g_asm_refs.push(u.intern(r.name));
        }
    }
    let b = u.perm_new.[ai.Blob]();
    b.arch = tg.g_arch;
    b.basic = true;
    b.text = u.perm_dup(text);
    b.file_id = fid;
    b.intel = intel;
    b.loc = u.perm_dup(u.file_of(fid).display);
    b.memory = true;
    b.volatile_ = true;
    g_asm_blobs.push(b);
    return true;
}

// A WebAssembly assembly source (text format module fields: asm/wasm.ax),
// as check_asm: its functions are the names it defines, the functions it
// imports from "env" those it refers to.
fn check_wasm_asm(text: []u8, fid: i32) bool {
    aw.g_lookup = no_wasm_names;
    aw.g_field = aw.no_field;
    let W = aw.assemble_file(text, tg.g_arch == tg.ARCH_WASM64);
    if aw.failed(W) {
        let line = @max(W.line, 1);
        let mut at: u32 = 0;
        let sf = u.file_of(fid);
        let mut l: i32 = 1;
        while (@as(usize, at) < sf.text.len) and (l < line) {
            if sf.text[@as(usize, at)] == '\n' {
                l += 1;
            }
            at += 1;
        }
        _ = dg.err(u.mkspan(fid, at, at), "C3097", W.err);
        return false;
    }
    for f in W.funcs.items() {
        g_asm_defs.put(u.intern(f.name), 1);
        g_asm_def_names.push(u.intern(f.name));
    }
    for im in W.imports.items() {
        if u.str_eq(im.module, "env") {
            g_asm_refs.push(u.intern(im.name));
        }
    }
    let b = u.perm_new.[ai.Blob]();
    b.arch = tg.g_arch;
    b.basic = true;
    b.text = u.perm_dup(text);
    b.file_id = fid;
    b.loc = u.perm_dup(u.file_of(fid).display);
    b.memory = true;
    b.volatile_ = true;
    g_asm_blobs.push(b);
    return true;
}

// (an assembly source sees no C declarations: it imports what it calls)
fn no_wasm_names(n: []u8) aw.Ref {
    _ = n;
    return aw.Ref.{ kind: aw.RF_NONE, params: "", results: "" };
}

/// An external name of the Axiom program: an `export fn` (span: its name).
pub struct AxName {
    name: []u8,
    span: u.Span,
}

/// After link_check: no external name is defined by a unit and by the
/// Axiom program's `export fn`s (`names`), C3065, and a unit defines no
/// main if the Axiom program has its own (axiom_main), C3066. True if so
/// (else reported).
pub fn boundary_check(names: []AxName, axiom_main: bool) bool {
    let mut ok = true;
    let mut gave_way = false;
    for x in names {
        let key = u.intern(x.name);
        let s = g_defs.get(key);
        if u.isnil(s) {
            continue;
        }
        if is_lib_sym(s) {
            // (the program's Axiom module defines it: the C library's
            // definition is not linked, as for a program's C unit)
            drop(s);
            g_defs.put(key, u.nil.[cast.CSym]());
            gave_way = true;
            continue;
        }
        let d = dg.err(def_span(s), "C3065",
                       u.f1("'%s' is defined in C and in Axiom (an external name has one definition)", s.name));
        dg.note(d, x.span, "the Axiom definition");
        ok = false;
    }
    if gave_way {
        for cu in g_units.items() {
            drop_from(cu);
        }
    }
    let mu = main_unit();
    if axiom_main and u.notnil(mu) {
        _ = dg.err(def_span(mu.main), "C3066",
                   "the program's main is the Axiom module's, and a C translation unit defines main too");
        ok = false;
    }
    return ok;
}

// The unit that defines main, or nil.
fn main_unit() *mut cs.CUnit {
    for cu in g_units.items() {
        if u.notnil(cu.main) {
            return cu;
        }
    }
    return u.nil.[cs.CUnit]();
}

/// Does a unit use an integer type wider than 64 bits (whose operations
/// may call std/c/rt/wideint.ax's functions)?
pub fn uses_wint() bool {
    return cty.g_used_wint;
}

/// Does a unit operate on decimal floating values (which calls
/// std/c/rt/decimal.ax's functions)?
pub fn uses_dec() bool {
    return cty.g_used_dec;
}

/// Do the checked units use _Float16 or a binary128 type that is not long
/// double (whose operations are std/c/rt/ldouble.ax's)?
pub fn uses_xfloat() bool {
    return cty.g_used_xfloat;
}

/// Does a unit define main?
pub fn has_main() bool {
    return u.notnil(main_unit());
}

/// Are there C translation units for gen_ir?
pub fn pending() bool {
    return (g_units.len > 0) or (g_asm_blobs.len > 0);
}

/// Whether the program creates threads on WebAssembly, where the units'
/// thread-locals then have a block per thread (cgen_tls.ax): set before
/// gen_ir, which defines TLS_START for the threads' start to call.
pub fn set_wasm_threads(threads: bool) void {
    cgt.wasm_threads = threads;
}

/// The function a WebAssembly thread's start calls (cgen_tls.ax).
pub fn tls_start_name() []u8 {
    return cgt.TLS_START;
}

/// WebAssembly: how a C call pushes its record on the shadow stack and pops
/// it (codegen.ax: the stack traces of C functions).
pub fn set_shadow_stack(push: fn(*mut ir.Builder, *mut ir.Value) [2]*mut ir.Value,
                        pop: fn(*mut ir.Builder, *mut ir.Value, *mut ir.Value) void,
                        depth: fn(*mut ir.Builder) [2]*mut ir.Value) void {
    cg.ss_push = push;
    cg.ss_pop = pop;
    cg.ss_depth = depth;
}

/// Generates the checked translation units into module m (wasm: for a
/// WebAssembly target), and the start-up's call of main if one defines it;
/// `site` makes the call-site records of native stack traces, `ld_fn` gives
/// the functions of std/c/rt/ldouble.ax and std/c/rt/wideint.ax (codegen.ax).
/// `ax_exit`: an Axiom module defines exit (an `export fn`), which, as a
/// unit's would, the start-up calls when main returns. False after an
/// error (reported).
pub fn gen_ir(m: *mut ir.Module, wasm: bool, site: fn(u.Span, []u8, []u8) *mut ir.Value, ax_exit: bool,
              ld_fn: fn([]u8) *mut ir.Value) bool {
    cg.call_site = site;
    cg.ld_fn = ld_fn;
    cg.defined_here = defines;
    let mut ok = true;
    g_lib_funcs = m.funcs.len;
    g_lib_globals = m.globals.len;
    let mut seen = false;
    for k in 0..g_units.len {
        if not seen and g_lib.get(k) {
            // (the library's units come after the program's: check's order)
            g_lib_funcs = m.funcs.len;
            g_lib_globals = m.globals.len;
            seen = true;
        }
        cg.fenv_all = g_fenv.get(k);
        cg.lib_unit = g_lib.get(k);  // (WebAssembly: its calls push no records on the shadow stack)
        ok = cgs.generate(m, g_units.get(k), wasm) and ok;
        if not g_lib.get(k) and (k == 0) {
            // (with the program's units, so that they are kept as its own)
            cga.define_sized();
        }
    }
    if not seen {
        g_lib_funcs = m.funcs.len;
        g_lib_globals = m.globals.len;
    }
    let mu = main_unit();
    if ok and u.notnil(mu) {
        ok = cg.generate_start(m, mu, wasm, ax_exit or defines("exit"));
    }
    if ok {
        cgt.define_start();  // (a C program's or an Axiom program's: its threads' start calls it)
    }
    // (the assembly sources: file-scope asm of the program)
    for b in g_asm_blobs.items() {
        ai.toplevel.push(b);
    }
    g_asm_blobs.clear();
    g_units.clear();
    return ok;
}

/// Is the program linked with initialization and termination arrays
/// (cgen.ax: g_init_arrays)?
pub fn set_init_arrays(on: bool) void {
    cg.g_init_arrays = on;
}

/// Are the system's C library and headers the program's (--c-lib=system:
/// cgen.ax, g_system_c_lib)?
pub fn set_system_c_lib(on: bool) void {
    cg.g_system_c_lib = on;
}

/// Does the program have the compiler's hosted C library (set_hosted)?
pub fn hosted() bool {
    return g_hosted;
}

let mut g_hosted: bool = false;

/// The program has the compiler's hosted C library (not --c-freestanding
/// nor --c-lib=system).
pub fn set_hosted(on: bool) void {
    g_hosted = on;
}

/// Is the output an object for other links (cgen.ax: g_object_output)?
pub fn set_object_output(on: bool) void {
    cg.g_object_output = on;
}

/// An Axiom program's main (its function in m) runs the C units'
/// constructors and destructors around it (after gen_ir).
pub fn wrap_axiom_main(m: *mut ir.Module, main: *mut ir.Func) void {
    cg.wrap_axiom_main(m, main);
}

/// Compiles the C source at `path`. `emit` is the --emit kind, `out` the
/// output path (empty: standard output, for the text kinds). The exit status.
pub fn run(path: []u8, o: *co.COptions, emit: []u8, out: []u8, json: bool) i32 {
    cgbi.install();
    let toks = cpp.preprocess(path, o);
    if dg.error_count() > 0 {
        dg.emit(json, json);
        return 1;
    }
    let mut text = u.nosym();
    if u.str_eq(emit, "c-pp") {
        text = cpp.text_of(toks.items());
    } else if u.str_eq(emit, "c-tokens") {
        text = cpp.tokens_text(toks.items());
    } else if u.str_eq(emit, "c-ast") {
        // (dumped after errors too: the tree is safe to walk either way)
        text = cdump.dump(cparse.parse(toks.items(), o));
    } else {
        dg.emit_fatal(json, "E9001", "compiling C is not implemented yet: use --emit=c-pp or --emit=c-ast");
        return 2;
    }
    dg.emit(json, json);
    if dg.error_count() > 0 {
        return 1;
    }
    if out.len == 0 {
        u.print(text);
    } else if not u.write_file(out, text) {
        dg.emit_fatal(json, "E9001", u.f1("cannot write %s", out));
        return 2;
    }
    return 0;
}
