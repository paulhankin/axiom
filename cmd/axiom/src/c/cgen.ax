// =============================================================================
// cgen.ax - IR generation for a C translation unit (its typed tree: csema.ax)
// into the compiler's IR module (ir.ax), next to the Axiom program that
// starts it (std/internal/runtime/c_start.ax): the module's functions and
// objects, their symbol names and linkage, the data of objects with static
// storage duration, string literals, the IR types of C types and the
// signatures of C functions. cgen_expr.ax and cgen_stmt.ax generate the
// code of functions; cgen_stmt.generate is the entry point.
//
// Representation: a C scalar is an IR value of the type lty gives (_Bool an
// i8 that is 0 or 1; every integer its width, but those wider than 64 bits,
// which are values in memory: cgen_wint.ax); an object is memory, reached
// by its address; the value of a structure or union is the address of
// memory holding it (an object's own, or a temporary's), and so is the value
// of a complex type (cgen_complex.ax). Functions take and
// return their arguments and results as the platform's C calling
// convention says (cgen_abi.ax plans it, cgen_va.ax generates the code), so
// that C compiled here calls and is called by the platform's C libraries.
//
// C code has none of Axiom's run-time checks: no bounds or overflow checks,
// no shadow-stack records. On native targets its calls have call-site
// records, so a stack trace shows C functions and the lines of their calls.
// =============================================================================
import "../dbginfo.ax" as dbi;
import "../diag.ax" as dg;
import "../ir.ax" as ir;
import "../target.ax" as tg;
import "../util.ax" as u;
import "cast.ax" as cast;
import "cconst.ax" as cc;
import "cdec.ax" as cdec;
import "cgen_abi.ax" as abi;
import "cgen_debug.ax" as cdbg;
import "cldbl.ax" as cl;
import "csema.ax" as cs;
import "csema_attr.ax" as catr;
import "csema_gnu.ax" as cgn;
import "csema_marks.ax" as csm;
import "ctypes.ax" as cty;
import "cwide.ax" as cw;
import "std/c/rt/ldouble" as ld;

/// The symbol C's main is generated under, and the one the start-up calls.
pub let MAIN_SYMBOL: []u8 = "axiom.c.main";
pub let START_SYMBOL: []u8 = "__axiom_c_main";

// -----------------------------------------------------------------------------
// State
// -----------------------------------------------------------------------------

pub let mut M: *mut ir.Module = @ptr_from_int(*mut ir.Module, 0);
pub let mut B: *mut ir.Builder = @ptr_from_int(*mut ir.Builder, 0);
pub let mut is_wasm: bool = false;
// --c-fenv-access: every function's floating point is strict (ir.Func's
// strict_fp), as under #pragma STDC FENV_ACCESS ON
pub let mut fenv_all: bool = false;
pub let mut T_i1: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
pub let mut T_i8: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
pub let mut T_i32: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
pub let mut T_isz: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
pub let mut T_ptr: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);
pub let mut T_void: *mut ir.Ty = @ptr_from_int(*mut ir.Ty, 0);

/// The function being generated.
pub struct FnState {
    sym: *mut cast.CSym,
    f: *mut ir.Func,
    entry: *mut ir.Block,  // the allocas
    sret: *mut ir.Value,   // the result's address or buffer (cgen_abi: R_SRET, R_REGS), or nil
    ret: *mut cty.CType,
    sig: Sig,
    // a GNU dialect's nested functions (cgen_nest.ax): the object holding a
    // nested function's chain, and the frame record of a function with them
    chain: *mut ir.Value,
    rec: *mut ir.Value,
}

pub let mut F: *mut FnState = @ptr_from_int(*mut FnState, 0);

/// The code generation of a function's body (cgen_stmt.ax).
pub struct Hooks {
    body: fn(*mut cast.CSym) void,
    local_init: fn(*mut cast.CSym, *mut ir.Value) void,  // stores an automatic object's initializer at its address
    stmt_expr: fn(*mut cast.Expr) *mut ir.Value,         // a statement expression's value (a GNU dialect)
    trampolines: fn(*mut cast.CSym) void,                // a function's nested functions' trampolines (cgen_nest.ax)
}

fn no_body(s: *mut cast.CSym) void {
    _ = s;
}

fn no_local_init(s: *mut cast.CSym, p: *mut ir.Value) void {
    _ = s;
    _ = p;
}

fn no_stmt_expr(e: *mut cast.Expr) *mut ir.Value {
    _ = e;
    return ir.vnil();
}

fn no_trampolines(s: *mut cast.CSym) void {
    _ = s;
}

pub let mut hooks: Hooks = Hooks.{ body: no_body, local_init: no_local_init, stmt_expr: no_stmt_expr,
                                   trampolines: no_trampolines };

fn no_call_site(sp: u.Span, fname: []u8, callee: []u8) *mut ir.Value {
    _ = sp;
    _ = fname;
    _ = callee;
    return ir.vnil();
}

/// The call-site record of a call at `sp` in function `fname` of `callee`
/// ("": through a pointer), for native stack traces (codegen.ax makes them,
/// with Axiom's), or nil; and the record the next call made (cgen_va.ax:
/// emit_call) is given.
pub let mut call_site: fn(u.Span, []u8, []u8) *mut ir.Value = no_call_site;

fn no_ss_push(b: *mut ir.Builder, site: *mut ir.Value) [2]*mut ir.Value {
    _ = b;
    _ = site;
    return [ir.vnil(), ir.vnil()];
}

fn no_ss_pop(b: *mut ir.Builder, ss: *mut ir.Value, depth: *mut ir.Value) void {
    _ = b;
    _ = ss;
    _ = depth;
}

/// WebAssembly: a call's record pushed on the shadow stack before it (the
/// record and the depth before), and the depth put back after it.
pub let mut ss_push: fn(*mut ir.Builder, *mut ir.Value) [2]*mut ir.Value = no_ss_push;
/// WebAssembly with call records: the shadow stack and its depth now (nil:
/// no records), which setjmp keeps and the code after a longjmp puts back
/// (cgen_sjlj.ax).
pub let mut ss_depth: fn(*mut ir.Builder) [2]*mut ir.Value = no_ss_depth;

fn no_ss_depth(b: *mut ir.Builder) [2]*mut ir.Value {
    _ = b;
    return [ir.vnil(), ir.vnil()];
}
pub let mut ss_pop: fn(*mut ir.Builder, *mut ir.Value, *mut ir.Value) void = no_ss_pop;
/// (in a return's expression with WebAssembly's tail calls: no records)
pub let mut ss_tail: bool = false;
/// Is the unit generated a library's (the C library's: no records)?
pub let mut lib_unit: bool = false;

fn no_ld_fn(name: []u8) *mut ir.Value {
    _ = name;
    return ir.vnil();
}

/// The IR function of std/c/rt/ldouble.ax's function `name` (codegen.ax
/// generates it), which cgen_ld.ax calls for long double arithmetic, or of
/// std/c/rt/wideint.ax's (a name that begins with wi_: cgen_wint.ax).
pub let mut ld_fn: fn([]u8) *mut ir.Value = no_ld_fn;
pub let mut next_site: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);
/// The chain (a frame record) the next call of a nested function passes (cgen_nest.ax).
pub let mut next_chain: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);

/// The alignment of object s: its type's, or an alignment specifier's if stricter.
pub fn object_align(s: *cast.CSym) u64 {
    let a = cty.align_of(s.ty);
    if s.align > a {
        return s.align;
    }
    return a;
}

// The names of the C units' functions in the module (1), which the units
// share.
let mut c_functions: u.SymMap.[i32] = u.SymMap.[i32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0), cap: 0, len: 0 };

let mut strings: u.SymMap.[*mut ir.Value] = u.SymMap.[*mut ir.Value].{ keys: @ptr_from_int(*mut usize, 0),
                                                                       vals: @ptr_from_int(*mut *mut ir.Value, 0),
                                                                       cap: 0, len: 0 };

fn internal_error(msg: []u8) void {
    u.die(u.cat2("internal compiler error (C front end): ", msg));
}

// -----------------------------------------------------------------------------
// Types
// -----------------------------------------------------------------------------

/// The IR type of objects of C type t (and of its scalar values).
pub fn lty(t0: *mut cty.CType) *mut ir.Ty {
    let t = t0.unq;
    let k = t.kind;
    if cty.is_wint(t) {
        return ir.t_array(ir.t_int(64), @as(u64, cty.limbs(t)));  // (memory only: cgen_wint.ax)
    }
    if cty.is_integer(t) {
        return ir.t_int(cty.storage_bits(t));
    }
    if (k == cty.TK_POINTER) or (k == cty.TK_NULLPTR) {
        return T_ptr;
    }
    if cty.is_floating(t) {
        let w = cty.ffmt(t);
        if w == 16 {
            return ir.t_int(16);  // (its bits: cgen_half.ax)
        }
        if w > 64 {
            return ir.t_array(ir.t_int(64), 2);  // (memory only: cgen_ld.ax)
        }
        return ir.t_float(w);
    }
    if cty.is_dec128(t) {
        return ir.t_array(ir.t_int(64), 2);  // (memory only: cgen_dec.ax; _Decimal128, _Decimal64x)
    }
    if (k == cty.TK_DEC32) or (k == cty.TK_DEC64) {
        return ir.t_int(t.bits);  // (its bits: cgen_dec.ax)
    }
    if k == cty.TK_IMAGINARY {
        return lty(t.elem);  // (as its real type: Annex G.2p2)
    }
    if k == cty.TK_VECTOR {
        // (its chunks of the IR's vector type, or an array of its elements: vec_chunk)
        let ch = vec_chunk(t);
        if u.isnil(ch) {
            return ir.t_array(lty(t.elem), t.len);
        }
        let n = cty.size_of(t) / ch.size;
        if n == 1 {
            return ch;
        }
        return ir.t_array(ch, n);
    }
    if k == cty.TK_COMPLEX {
        // (the real part and the imaginary part: 6.2.5p13)
        let r = lty(t.elem);
        let mut fs: [2]*mut ir.Ty = [r, r];
        return ir.t_struct(fs[..]);
    }
    if k == cty.TK_ARRAY {
        let mut n: u64 = 0;
        if t.has_len {
            n = t.len;
        }
        return ir.t_array(lty(t.elem), n);
    }
    if (k == cty.TK_STRUCT) or (k == cty.TK_UNION) {
        return record_ty(t);
    }
    if k == cty.TK_VOID {
        return T_void;
    }
    if k == cty.TK_FUNCTION {
        return T_ptr;
    }
    internal_error(u.cat2("no IR type for ", cty.type_str(t)));
    return T_void;
}

/// The IR type of a chunk of a value of vector type t, when the IR's vector
/// types hold it: a vector of t's lanes (integers of 8 to 64 bits, binary32,
/// binary64, or _Float16's bits) of 16, 32 or 64 bytes (vsplit.ax computes
/// those wider than the target's registers in pieces), t's size or 64 bytes
/// when t is larger, on a target with the IR's vector types (COptions.vec_ir:
/// WebAssembly with simd128). Else nil: t is an array of its elements.
pub fn vec_chunk(t0: *cty.CType) *mut ir.Ty {
    let t = t0.unq;
    let size = cty.size_of(t);
    if not cty.vec_ir() or (size < 16) {
        return u.nil.[ir.Ty]();
    }
    let el = t.elem;
    let mut lt = u.nil.[ir.Ty]();
    if cty.is_integer(el) and not cty.is_wint(el) {
        lt = ir.t_int(cty.storage_bits(el));
    } else if cty.is_half(el) {
        lt = ir.t_int(16);
    } else if (cty.ffmt(el) == 32) or (cty.ffmt(el) == 64) {
        lt = ir.t_float(cty.ffmt(el));
    } else {
        return u.nil.[ir.Ty]();
    }
    let ch = @min(size, 64);
    return ir.t_vec(lt, @truncate(u32, ch / lt.size));
}

fn unit_ty(a: u64) *mut ir.Ty {
    if a >= 8 {
        return ir.t_int(64);
    }
    if a >= 4 {
        return ir.t_int(32);
    }
    if a >= 2 {
        return ir.t_int(16);
    }
    return T_i8;
}

// A structure's IR type: its members in order, which the IR lays out as C
// does; a union's: as many units of its alignment as fill it.
fn record_ty(t: *mut cty.CType) *mut ir.Ty {
    if not u.isvnil(t.backend) {
        return @ptr_cast(*mut ir.Ty, t.backend);
    }
    let ti = t.tag;
    let mut name = ti.name;
    if name.len == 0 {
        name = "anon";
    }
    let r = ir.t_named_struct(u.f3("%s.%s.%s", u.pick(ti.kind == cty.TK_UNION, "union", "struct"), name,
                                   u.idec(ti.id)));
    t.backend = @ptr_cast(*mut void, r);
    if ti.kind == cty.TK_STRUCT {
        let n = ti.members.len;
        let fs = u.newn.[*mut ir.Ty](n + 1);
        for i in 0..n {
            fs[i] = lty(ti.members.get(i).ty);
        }
        ir.struct_set_body(r, fs[0..n]);
        let mut same = (r.size == ti.size) and (r.align == ti.align);
        for i in 0..n {
            if r.offs[i] != ti.members.get(i).offset {
                same = false;
            }
        }
        if same {
            return r;
        }
    }
    // (a union, or a structure the IR would lay out otherwise)
    let unit = unit_ty(ti.align);
    let mut cnt = ti.size / unit.size;
    if cnt == 0 {
        cnt = 1;
    }
    let mut one: [1]*mut ir.Ty = [ir.t_array(unit, cnt)];
    ir.struct_set_body(r, one[..]);
    return r;
}

/// A C function's IR signature, and how its arguments and result travel
/// (the platform's C calling convention: cgen_abi.ax).
pub struct Sig {
    ty: *mut ir.Ty,
    plan: *mut abi.Plan,
}

/// The signature of a call of (define: the definition of) a function
/// returning ret with arguments (parameters) of types ps, of which the
/// first nnamed are its prototype's parameters; variadic: its type ends
/// with `...`.
pub fn sig_of(ret: *mut cty.CType, ps: []mut *mut cty.CType, nnamed: usize, variadic: bool, define: bool) Sig {
    let p = abi.plan(ret, ps, nnamed, variadic, define);
    return Sig.{ ty: p.fty, plan: p };
}

/// The marks of a call's arguments and result, as its plan says.
pub fn mark_call(v: *mut ir.Value, p: *abi.Plan) void {
    let ex = ir.ext_of(v);
    ex[0] = abi.ret_ext(p);
    for k in 0..p.exts.len {
        if (k + 1) < ex.len {
            ex[k + 1] = p.exts.get(k);
        }
    }
}

pub fn mark_func(f: *mut ir.Func, p: *abi.Plan) void {
    f.ret_ext = abi.ret_ext(p);
    for k in 0..p.exts.len {
        if k < f.param_ext.len {
            f.param_ext[k] = p.exts.get(k);
        }
    }
}

// -----------------------------------------------------------------------------
// Symbols
// -----------------------------------------------------------------------------

// The symbol name of an entity: its own with external linkage (main's is
// MAIN_SYMBOL), else made unique.
pub fn symbol_name(s: *cast.CSym) []u8 {
    if (s.linkage == cast.LK_EXTERNAL) and not ((s.kind == cast.SK_FUNC) and csm.is_inline_def(s)) {
        if (s.kind == cast.SK_FUNC) and u.str_eq(s.name, "main") {
            return MAIN_SYMBOL;
        }
        if s.asm_name.len > 0 {
            return s.asm_name;  // (a GNU dialect's asm label)
        }
        return s.name;
    }
    return u.f2("%s.%s", s.name, u.idec(s.uid));
}

/// The parameter types of function s's IR signature: its definition's
/// parameters (promoted, for a definition with an identifier list: the
/// arguments arrive so), or its type's (a declaration with a prototype).
pub fn param_types(s: *cast.CSym) []mut *mut cty.CType {
    if u.notnil(s.def) {
        let dt = s.def.decls.get(0).ty;
        let kr = u.notnil(dt) and (dt.kind == cty.TK_FUNCTION) and dt.kr;
        let n = s.params.len;
        let ts = u.newn.[*mut cty.CType](n + 1);
        for i in 0..n {
            ts[i] = cty.unqual(s.params.get(i).ty);
            if kr {
                ts[i] = cty.arg_promote(ts[i]);
            }
        }
        return ts[0..n];
    }
    return s.ty.params;
}

/// Function s's signature (nil ty: a function without a prototype that is
/// not defined, whose signature comes from its calls).
pub fn func_sig(s: *cast.CSym) Sig {
    if not s.ty.proto and u.isnil(s.def) {
        return Sig.{ ty: u.nil.[ir.Ty](), plan: u.nil.[abi.Plan]() };
    }
    let ps = param_types(s);
    if u.notnil(s.nest_parent) {
        // (a nested function: its chain after its arguments, cgen_nest.ax;
        // a variadic one's IR function takes, before it, the address of its
        // entry's va_list instead of variable arguments)
        let mut sig = sig_of(s.ty.ret, ps, ps.len, false, u.notnil(s.def));
        if s.ty.variadic {
            let ps2 = u.newn.[*mut cty.CType](ps.len + 2);
            for i in 0..ps.len {
                ps2[i] = ps[i];
            }
            ps2[ps.len] = cty.pointer_to(cty.t_void);
            sig = sig_of(s.ty.ret, ps2[0..ps.len + 1], ps.len + 1, false, u.notnil(s.def));
        }
        abi.add_chain(sig.plan);
        return Sig.{ ty: sig.plan.fty, plan: sig.plan };
    }
    return sig_of(s.ty.ret, ps, ps.len, s.ty.variadic, u.notnil(s.def));
}

/// The IR function of C function s; `sig`: the signature to declare it
/// with if it has none of its own (a call's, without a prototype).
pub fn func_of(s: *mut cast.CSym, sig0: Sig) *mut ir.Func {
    if not u.isvnil(s.ir) {
        return @ptr_cast(*mut ir.Func, s.ir);
    }
    let target = alias_target(s);
    if u.notnil(target) {
        let tf = func_of(target, sig0);
        s.ir = @ptr_cast(*mut void, tf);
        return tf;
    }
    let mut sig = func_sig(s);
    if u.isnil(sig.ty) {
        sig = sig0;
    }
    let name = symbol_name(s);
    let mut f = ir.get_function(M, name);
    if u.notnil(f) and not ir.is_decl(f) and (c_functions.get(u.intern(name)) == 0) {
        if u.notnil(s.def) or (s.linkage != cast.LK_EXTERNAL) {
            _ = dg.err(s.span, "C3062", u.f1("the name '%s' is the name of a function of the runtime", s.name));
            f = u.nil.[ir.Func]();
        } else {
            // a function C declares and Axiom code defines (an `export fn`,
            // docs/c.md "C and Axiom in one program"): calls are to it, with
            // the C signature, which the boundary types make the same ABI
            s.ir = @ptr_cast(*mut void, f);
            return f;
        }
    }
    // (another unit's function of the same name is the same: cc.ax has
    // checked that only one unit defines it)
    c_functions.put(u.intern(name), 1);
    if (tg.g_debug != tg.DEBUG_NONE) and not u.str_eq(name, s.name) {
        dbi.note_func_name(name, s.name);
    }
    if u.isnil(f) {
        f = ir.add_function(M, name, sig.ty);
    } else if u.notnil(s.def) and ir.is_decl(f) {
        // a declaration (another unit's, or an Axiom extern "C" one) of the
        // function this unit defines: the definition's signature, whose
        // parameters may differ (a variadic definition's save area)
        ir.retype_decl(f, sig.ty);
        f.import_module = u.nosym();
        f.import_name = u.nosym();
    } else if ir.is_decl(f) {
        // (another declaration: a function already defined keeps its own)
        ir.retype_decl(f, sig.ty);
    }
    cdbg.note_func(f, s);
    if (s.linkage != cast.LK_EXTERNAL) or csm.is_inline_def(s) {
        // (an inline definition is for this unit only: 6.7.4p7)
        f.linkage = ir.LINK_INTERNAL;
    }
    if u.str_eq(name, MAIN_SYMBOL) {
        f.linkage = ir.LINK_INTERNAL;
    } else if s.weak and u.notnil(s.def) and (f.linkage != ir.LINK_INTERNAL) {
        f.linkage = ir.LINK_WEAK;  // (kept: no unit has another definition; an object's users may)
    }
    if u.notnil(sig.plan) and (ir.is_decl(f) or u.notnil(s.def)) {
        mark_func(f, sig.plan);
    }
    if u.isnil(s.def) and is_wasm and (s.linkage == cast.LK_EXTERNAL) and not s.weak {
        // a function the program does not define: the host's (not a weak
        // reference's, which is null when nothing defines it: wlink.ax)
        f.import_module = "env";
        f.import_name = name;
    }
    gnu_func(s, f);
    if u.notnil(sig.plan) {
        alloc_facts(s, f, sig.plan);
    }
    if u.isnil(s.def) and (s.linkage == cast.LK_EXTERNAL) and tg.is_windows() {
        c_library_import(name);
    }
    s.ir = @ptr_cast(*mut void, f);
    return f;
}

/// On Windows, a function C code declares and no unit defines is the C
/// library's (or a system DLL's, by its name): the linker reads a constant
/// axiom.import.<name> holding "c" (cmd/axiom/src/plink.ax). A unit that
/// defines the function makes the constant unused.
pub fn c_library_import(name: []u8) void {
    let gname = u.cat2("axiom.import.", name);
    if u.notnil(ir.get_global(M, gname)) {
        return;
    }
    let g = ir.add_global(M, ir.t_array(T_i8, 2), gname);
    g.init = ir.cstring("c");
    g.linkage = ir.LINK_LINKONCE;
    g.is_const = true;
    g.align = 1;
}

/// Does the program (a unit: cc.ax sets it) define the external name?
pub let mut defined_here: fn([]u8) bool = nothing_defined;

fn nothing_defined(name: []u8) bool {
    _ = name;
    return false;
}

/// Is object s one of a DLL's (Windows): external, and defined by no unit?
/// Code reaches it through its import address table slot, as through a
/// GOT (an external global's address is loaded: x64.ax), which plink.ax
/// fills with the address of the DLL's object; c_library_import names the
/// DLL (the C library's, or a system DLL's by the name's rules).
pub fn dll_object(s: *cast.CSym) bool {
    return tg.is_windows() and (s.linkage == cast.LK_EXTERNAL) and not defined_here(s.name);
}

/// The address of object s (with static storage duration).
pub fn object_addr(s: *mut cast.CSym) *mut ir.Value {
    if not u.isvnil(s.ir) {
        return @ptr_cast(*mut ir.Value, s.ir);
    }
    let target = alias_target(s);
    if u.notnil(target) {
        let tv = object_addr(target);
        s.ir = @ptr_cast(*mut void, tv);
        return tv;
    }
    let name = symbol_name(s);
    let mut g = ir.get_global(M, name);
    if u.isnil(g) {
        g = ir.add_global(M, lty(s.ty), name);
    }
    if dll_object(s) {
        c_library_import(name);
    }
    g.align = object_align(s);
    if s.linkage != cast.LK_EXTERNAL {
        g.linkage = ir.LINK_INTERNAL;
    } else if s.weak and s.defined {
        g.linkage = ir.LINK_WEAK;  // (as a function's: func_of)
    }
    if ((s.flags & cast.CF_THREAD_LOCAL) != 0) and not is_wasm {
        // (thread storage duration: on WebAssembly, cgen_tls.ax)
        g.tls = true;
    }
    let n = cgn.note_of(s);
    if u.notnil(n) {
        if n.weak and (s.linkage == cast.LK_EXTERNAL) and not s.defined and not defined_here(s.name) {
            g.linkage = ir.LINK_EXTWEAK;  // a weak reference: no unit defines it (a weak definition: s.weak)
        }
        if n.section.len > 0 {
            g.section = u.perm_dup(n.section);  // (the syntax tree is given back before code generation)
        }
        g.visibility = @truncate(u8, @bit_cast(u32, n.visibility));  // (for the object writers)
        if n.used and s.defined {
            keep(g.val);
        }
    }
    s.ir = @ptr_cast(*mut void, g.val);
    return g.val;
}

// -----------------------------------------------------------------------------
// The GNU dialects' attributes of functions and objects (csema_gnu.ax)
// -----------------------------------------------------------------------------

// The entities the unit defines, by name, for the targets of aliases.
let mut g_defs: u.SymMap.[*mut cast.CSym] = u.SymMap.[*mut cast.CSym].{ keys: @ptr_from_int(*mut usize, 0),
                                                                        vals: @ptr_from_int(*mut *mut cast.CSym, 0),
                                                                        cap: 0, len: 0 };

// The entity s is another name for (alias("target")), or nil. The target
// is defined in the same unit (else C3090); references to s are to it, and
// s has no symbol of its own.
fn alias_target(s: *mut cast.CSym) *mut cast.CSym {
    let n = cgn.note_of(s);
    if u.isnil(n) or (n.alias.len == 0) {
        return u.nil.[cast.CSym]();
    }
    let t = g_defs.get(n.alias);
    if u.isnil(t) or (t == s) or (t.kind != s.kind) {
        _ = dg.err(n.alias_span, "C3090",
                   u.f1("the target of the alias, '%s', is not a function or object of the same kind defined in this translation unit",
                        n.alias));
        n.alias = "";
        return u.nil.[cast.CSym]();
    }
    return t;
}

// An alias of external linkage (the attribute alias, a GNU dialect) is a
// symbol of its own at its target's place, which other units' references to
// its name are references to (ir.Alias).
fn note_alias(s: *mut cast.CSym) void {
    let n = cgn.note_of(s);
    if u.notnil(n) and (n.ifunc.len > 0) {
        note_ifunc(s, n);
        return;
    }
    if u.isnil(n) or (n.alias.len == 0) or (s.linkage != cast.LK_EXTERNAL) {
        return;
    }
    let mut tv = u.nil.[ir.Value]();
    if s.kind == cast.SK_FUNC {
        tv = func_of(s, func_sig(s)).val;
    } else {
        tv = object_addr(s);
    }
    if n.alias.len > 0 {
        ir.add_alias(M, symbol_name(s), tv, n.weak, @truncate(u8, @bit_cast(u32, n.visibility)));
    }
}

// An indirect function (the attribute ifunc): its name is a symbol of
// type STT_GNU_IFUNC at its resolver, a function the unit defines (else
// C3090), whose result the linker's start-up or the dynamic linker makes
// the function's address (ir.Alias.ifunc); calls and addresses are the
// name's, which the function's declaration stays.
fn note_ifunc(s: *mut cast.CSym, n: *mut cgn.Note) void {
    let t = g_defs.get(n.ifunc);
    if u.isnil(t) or (t == s) or (t.kind != cast.SK_FUNC) or u.isnil(t.def) {
        _ = dg.err(n.alias_span, "C3090",
                   u.f1("the resolver of the indirect function, '%s', is not a function defined in this translation unit",
                        n.ifunc));
        return;
    }
    if u.notnil(s.def) {
        _ = dg.err(n.alias_span, "C3090", u.f1("the indirect function '%s' has a body: its resolver is its definition",
                                               s.name));
        return;
    }
    let tf = func_of(t, func_sig(t));
    ir.add_ifunc(M, symbol_name(s), tf.val, n.weak, @truncate(u8, @bit_cast(u32, n.visibility)));
}

// The IR function f of C function s: what its GNU attributes ask, and
// C23's unsequenced and reproducible (catr.fx_of).
fn gnu_func(s: *mut cast.CSym, f: *mut ir.Func) void {
    let mut fx = catr.fx_of(s);
    let n = cgn.note_of(s);
    // const and pure: ir.Func.fx, the promise of a function that returns
    // (not one declared not to: catr.is_noreturn, which ir.call_fx would
    // see only once the IR's noreturn is set)
    if u.notnil(n) and not catr.is_noreturn(s) {
        if n.is_const {
            fx = ir.FX_NONE;
        } else if n.is_pure and (fx == ir.FX_ANY) {
            fx = ir.FX_READS;
        }
    }
    f.fx = @max(f.fx, fx_by_abi(s.ty, fx));
    if u.isnil(n) {
        return;
    }
    if n.noinline {
        f.noinline = true;
    }
    if n.always_inline {
        f.always_inline = true;
    }
    if n.cold {
        f.cold = true;
    }
    if n.hot {
        f.hot = true;
    }
    if n.opt_level >= 0 {
        f.opt_override = @truncate(u8, @bit_cast(u32, n.opt_level + 1));
    }
    if n.target.len > 0 {
        // (the target's extensions and these: the backends compile it so,
        // and the inliner does not put it into code compiled for less)
        f.features = tg.fn_features(f) | tg.parse_features(n.target).bits;
        f.has_features = true;
    }
    if n.section.len > 0 {
        f.section = u.perm_dup(n.section);  // (for the object writers; the syntax tree is given back first)
    }
    f.visibility = @truncate(u8, @bit_cast(u32, n.visibility));
    if n.weak and (s.linkage == cast.LK_EXTERNAL) and u.isnil(s.def) and ir.is_decl(f) and not defined_here(s.name) {
        f.linkage = ir.LINK_EXTWEAK;  // a weak reference: no unit defines it (a weak definition: s.weak, func_of)
    }
    if n.used and u.notnil(s.def) {
        keep(f.val);
    }
}

// What a call of a function of type t may be said to do (fx, ir.FX_) as the
// platforms' calling conventions pass it: nothing for a result that is not
// a plain scalar (a structure, union, complex or long double result may be
// written to the caller's memory through an address that is an ordinary
// argument in the IR, which ir.call_fx cannot tell from others); FX_READS at
// most when a parameter is not one (it may be passed as the address of a
// copy, which the callee reads).
fn fx_by_abi(t: *cty.CType, fx: u8) u8 {
    if (fx == ir.FX_ANY) or u.isnil(t) or not cty.is_func(t) or not plain_scalar(t.ret) {
        return ir.FX_ANY;
    }
    for p in t.params {
        if not plain_scalar(p) {
            return @min(fx, ir.FX_READS);
        }
    }
    return fx;
}

// An integer (no wider than 64 bits), a pointer, float or double.
fn plain_scalar(t0: *mut cty.CType) bool {
    let t = cty.unqual(t0);
    if cty.is_pointer(t) {
        return true;
    }
    if cty.is_integer(t) {
        return cty.size_of(t) <= 8;
    }
    return (t == cty.t_float) or (t == cty.t_double);
}

// The IR parameter of C parameter k (from 1) of a call by plan, or -1
// (one not passed as one scalar).
fn ir_param(plan: *abi.Plan, k: i32) i32 {
    if (k < 1) or (@int_cast(usize, k) > plan.args.len) {
        return -1;
    }
    let a = plan.args[@int_cast(usize, k - 1)];
    if a.kind != abi.A_SCALAR {
        return -1;
    }
    return a.slot[0];
}

// What returns_nonnull, malloc, alloc_size, alloc_align and assume_aligned
// say of function s's results (ir.Func's ret_nonnull, allocator, size_args,
// align_arg, ret_align), for a result that is a pointer in a register.
fn alloc_facts(s: *mut cast.CSym, f: *mut ir.Func, plan: *abi.Plan) void {
    let n = cgn.note_of(s);
    if u.isnil(n) or (f.ty.ret.kind != ir.T_PTR) or (f.ret_ext != 0) {
        return;
    }
    if n.ret_nonnull and not cs.opts().keep_null_checks {
        f.ret_nonnull = true;
    }
    if n.malloc {
        f.allocator = true;  // (gvn.fresh: an object of its own)
    }
    if n.alloc_size[0] > 0 {
        let a = ir_param(plan, n.alloc_size[0]);
        let mut b: i32 = 0;
        if n.alloc_size[1] > 0 {
            b = ir_param(plan, n.alloc_size[1]);
        }
        if (a >= 0) and (a < 127) and (b >= 0) and (b < 127) {
            let mut second: i32 = 0;
            if n.alloc_size[1] > 0 {
                second = b + 1;
            }
            f.size_args = [@truncate(i8, a + 1), @truncate(i8, second)];
        }
    }
    if n.alloc_align > 0 {
        let a = ir_param(plan, n.alloc_align);
        if (a >= 0) and (a < 127) {
            f.align_arg = @truncate(i8, a + 1);
        }
    }
    if n.assume_aligned > 0 {
        f.ret_align = n.assume_aligned;
    }
}

let mut g_kept: i32 = 0;

// Keeps the function or object at address v though nothing refers to it
// (the attribute used): a constant holding its address refers to it.
/// Keeps v (a function or object) in the program though no code refers to it.
pub fn keep(v: *mut ir.Value) void {
    g_kept += 1;
    let g = ir.add_global(M, T_ptr, u.f1("axiom.c.used.%s", u.idec(g_kept)));
    g.init = v;
    g.linkage = ir.LINK_INTERNAL;
    g.is_const = true;
    g.align = cty.ptr_bytes;
}

/// The address of string literal e (its array, NUL-terminated).
pub fn string_addr(e: *cast.Expr) *mut ir.Value {
    let key = u.addr_key(@int_from_ptr(e));
    let found = strings.get(key);
    if u.notnil(found) {
        return found;
    }
    let el = e.ty.elem;
    let units = e.tok.units;
    let mut init = ir.vnil();
    if cty.size_of(el) == 1 {
        let bs = u.newn.[u8](units.len + 1);
        for i in 0..units.len {
            bs[i] = @truncate(u8, units[i]);
        }
        init = ir.cstring(bs[0..units.len]);
    } else {
        let et = lty(el);
        let xs = u.newn.[*mut ir.Value](units.len + 2);
        for i in 0..units.len {
            xs[i] = ir.cint(et, @as(u64, units[i]));
        }
        xs[units.len] = ir.cint(et, 0);
        init = ir.carray(et, xs[0..units.len + 1]);
    }
    let g = ir.add_global(M, init.ty, ".str");
    g.init = init;
    g.linkage = ir.LINK_INTERNAL;
    g.is_const = true;
    g.align = cty.align_of(el);
    strings.put(key, g.val);
    return g.val;
}

// -----------------------------------------------------------------------------
// Data: the initial values of objects with static storage duration
// -----------------------------------------------------------------------------

// An address in an object's data.
struct Reloc {
    off: u64,
    v: *mut ir.Value,  // a global's or function's address, with its addend
}

struct Image {
    bytes: []mut u8,
    relocs: u.List.[Reloc],
    reloc_end: u64,  // the end of the furthest address so far: an item before it may override one
}

// An item at off of size bytes overrides what was there before it
// (csema_desig.ax keeps a later item for the same subobject after the
// earlier one): the addresses it covers go.
fn drop_relocs(im: *mut Image, off: u64, size: u64) void {
    if off >= im.reloc_end {
        return;
    }
    let ps = cty.size_of(cty.t_size);
    let rs = im.relocs.items();
    let mut j: usize = 0;
    for i in 0..rs.len {
        let r = rs[i];
        if (r.off < off + size) and (off < r.off + ps) {
            continue;
        }
        rs[j] = r;
        j += 1;
    }
    im.relocs.len = j;
}

fn put_le(im: *mut Image, off: u64, v: u64, n: u64) void {
    for i in 0..n {
        let at = @truncate(usize, off + i);
        if at < im.bytes.len {
            im.bytes[at] = @truncate(u8, v >> @truncate(u32, i * 8));
        }
    }
}

// Writes value v of bit-field m into the bytes of its unit at off
// (little-endian), keeping the other bits (bit by bit: a packed
// structure's run may span 9 bytes, csema_bits.is_run).
fn put_bits(im: *mut Image, off: u64, m: *cty.Member, v: u64) void {
    let base = (off * 8) + @as(u64, @bit_cast(u32, m.bit_off));
    for k in @as(u64, 0)..@as(u64, @bit_cast(u32, m.bit_width)) {
        let bit = (v >> @truncate(u32, k)) & 1;
        let at = @truncate(usize, (base + k) / 8);
        if at < im.bytes.len {
            let sh = @truncate(u32, (base + k) % 8);
            im.bytes[at] = (im.bytes[at] & ~(@as(u8, 1) << sh)) | (@truncate(u8, bit) << sh);
        }
    }
}

// The address constant a as an IR constant (a global or function's
// address with an addend), or nil for a plain integer.
fn addr_value(a: cc.Addr) *mut ir.Value {
    let mut base = ir.vnil();
    if u.notnil(a.sym) and (a.sym.kind == cast.SK_LABEL) {
        return label_address(a.sym);
    }
    if u.notnil(a.sym) {
        if a.sym.kind == cast.SK_FUNC {
            base = func_of(a.sym, Sig.{ ty: ir.t_fn(T_void, u.nil_slice.[*mut ir.Ty](), false),
                                        plan: u.nil.[abi.Plan]() }).val;
        } else {
            base = object_addr(a.sym);
        }
    } else if u.notnil(a.str) {
        base = string_addr(a.str);
    } else {
        return ir.vnil();
    }
    if a.off == 0 {
        return base;
    }
    if base.kind == ir.V_FUNC {
        return base;  // (a function's address plus an offset: meaningless; the function)
    }
    return ir.cgaddr(ir.gv_of(base), a.off);
}

// Writes the value f of real floating type t at off.
fn put_float(im: *mut Image, off: u64, t: *cty.CType, f: f64) void {
    let w = cty.ffmt(t);
    if cty.is_bf16(t) {
        put_le(im, off, ld.b_from_f64(@bit_cast(u64, f)), 2);  // (f is a bfloat16 value: exact)
        return;
    }
    if w == 32 {
        put_le(im, off, @as(u64, ir.f32_bits(f)), 4);  // (a NaN's bits kept: FLT_SNAN)
    } else if w == 16 {
        let b = @bit_cast(u64, f);
        if ((((b >> 52) & 0x7FF) == 0x7FF) and ((b << 12) != 0)) and (((b >> 51) & 1) == 0) {
            put_le(im, off, ((b >> 48) & 0x8000) | 0x7D00, 2);  // (a signaling NaN: FLT16_SNAN)
        } else {
            put_le(im, off, ld.h_from_f64(b), 2);  // (f is a binary16 value: exact)
        }
    } else {
        put_le(im, off, @bit_cast(u64, f), 8);
    }
}

// Writes item it's value into the image.
fn put_item(im: *mut Image, it: *cast.InitItem) void {
    let t = it.ty;
    let e = it.e;
    let size = cty.size_of(t);
    drop_relocs(im, it.off, size);
    if u.isnil(e) {
        for i in 0..size {
            put_le(im, it.off + i, 0, 1);
        }
        return;
    }
    if t.kind == cty.TK_ARRAY {
        // a string literal
        let es = cty.size_of(t.elem);
        let us = e.tok.units;
        let mut n = @as(u64, us.len);
        if n > t.len {
            n = t.len;
        }
        for i in 0..n {
            put_le(im, it.off + (i * es), @as(u64, us[@truncate(usize, i)]), es);
        }
        return;
    }
    if cty.is_wide(t) {
        let bs = cl.bytes(e.xv);
        for i in @as(usize, 0)..16 {
            put_le(im, it.off + @as(u64, i), @as(u64, bs[i]), 1);
        }
        return;
    }
    if cty.is_decimal(t) {
        let bs = cdec.bytes(e);
        for i in @as(u64, 0)..size {
            put_le(im, it.off + i, @as(u64, bs[@truncate(usize, i)]), 1);
        }
        return;
    }
    if cty.is_floating(t) {
        put_float(im, it.off, t, e.fcval);
        return;
    }
    if cty.is_imaginary(t) {
        put_float(im, it.off, t.unq.elem, e.fcval);  // (its coefficient)
        return;
    }
    if cty.is_complex(t) and cty.is_wide(t.elem) {
        let bre = cl.bytes(e.xv);
        let bim = cl.bytes(e.xvim);
        for i in @as(usize, 0)..16 {
            put_le(im, it.off + @as(u64, i), @as(u64, bre[i]), 1);
            put_le(im, it.off + 16 + @as(u64, i), @as(u64, bim[i]), 1);
        }
        return;
    }
    if cty.is_complex(t) {
        put_float(im, it.off, t.elem, e.fcval);
        put_float(im, it.off + cty.size_of(t.elem), t.elem, e.fcimag);
        return;
    }
    if cty.is_wint(t) and e.is_const and u.notnil(it.bits) {
        // (a bit-field: its bits, from the unit's bit_off, csema_bits.ax)
        let m = it.bits;
        let v = cw.value(e, cty.limbs(t));
        let base = (it.off * 8) + @as(u64, @bit_cast(u32, m.bit_off));
        for k in @as(u64, 0)..@as(u64, @bit_cast(u32, m.bit_width)) {
            let bit = (v[@truncate(usize, k / 64)] >> @truncate(u32, k % 64)) & 1;
            let at = @truncate(usize, (base + k) / 8);
            if at < im.bytes.len {
                let sh = @truncate(u32, (base + k) % 8);
                im.bytes[at] = (im.bytes[at] & ~(@as(u8, 1) << sh)) | (@truncate(u8, bit) << sh);
            }
        }
        return;
    }
    if cty.is_wint(t) and e.is_const {
        let v = cw.value(e, cty.limbs(t));
        for k in 0..v.len {
            put_le(im, it.off + (@as(u64, k) * 8), v[k], 8);
        }
        return;
    }
    if cty.is_integer(t) and e.is_const {
        if u.notnil(it.bits) {
            put_bits(im, it.off, it.bits, e.cval);
            return;
        }
        put_le(im, it.off, e.cval, size);
        return;
    }
    let a = cc.address(e);
    if u.notnil(a.sym) and (a.sym.kind != cast.SK_FUNC) and dll_object(a.sym) {
        // (code reads its address from the import address table; data
        // cannot hold it, and the image has no relocation for it)
        _ = dg.err(e.span, "C3067",
                   u.f1("the address of '%s', an object of a DLL, is not an address constant (on Windows the program finds it when it runs)",
                        a.sym.name));
    }
    let v = addr_value(a);
    if u.isnil(v) {
        put_le(im, it.off, a.off, size);
        return;
    }
    im.relocs.push(Reloc.{ off: it.off, v: v });
    if it.off + size > im.reloc_end {
        im.reloc_end = it.off + size;
    }
}

fn byte_run(bs: []mut u8) *mut ir.Value {
    let mut zero = true;
    for b in bs {
        if b != 0 {
            zero = false;
        }
    }
    if zero {
        return ir.czero(ir.t_array(T_i8, @as(u64, bs.len)));
    }
    let xs = u.newn.[*mut ir.Value](bs.len + 1);
    for i in 0..bs.len {
        xs[i] = ir.cint(T_i8, @as(u64, bs[i]));
    }
    return ir.carray(T_i8, xs[0..bs.len]);
}

// The IR constant of object s's initial value: runs of bytes and the
// addresses between them.
fn initial_value(s: *mut cast.CSym) *mut ir.Value {
    let mut size = cty.size_of(s.ty);
    if u.notnil(s.init) and (s.init.size > size) {
        size = s.init.size;  // (a GNU dialect: a flexible array member initialized)
    }
    let im = u.new.[Image]();
    im.bytes = u.newn.[u8](@truncate(usize, size) + 1)[0..@truncate(usize, size)];
    @mem_set(im.bytes, 0);
    if u.notnil(s.init) {
        for k in 0..s.init.items.len {
            put_item(im, s.init.items.at(k));
        }
    }
    let rs = im.relocs.items();
    if rs.len == 0 {
        if u.isnil(s.init) or (s.init.items.len == 0) {
            return ir.czero(ir.t_array(T_i8, size));
        }
    }
    // relocations in order of offset
    let n = rs.len;
    for i in 1..n {
        let mut j = i;
        while (j > 0) and (rs[j - 1].off > rs[j].off) {
            let x = rs[j];
            rs[j] = rs[j - 1];
            rs[j - 1] = x;
            j -= 1;
        }
    }
    let mut parts = u.List.[*mut ir.Value].empty();
    let mut at: u64 = 0;
    for r in rs {
        if r.off > at {
            parts.push(byte_run(im.bytes[@truncate(usize, at)..@truncate(usize, r.off)]));
        }
        parts.push(r.v);
        at = r.off + cty.ptr_bytes;
    }
    if at < size {
        parts.push(byte_run(im.bytes[@truncate(usize, at)..@truncate(usize, size)]));
    }
    return ir.cstruct(parts.items());
}

fn define_object(s: *mut cast.CSym) void {
    let n = cgn.note_of(s);
    if u.notnil(n) and (n.alias.len > 0) {
        return;  // (another name for an object defined in the unit)
    }
    let g = ir.gv_of(object_addr(s));
    cdbg.note_static(u.nil.[ir.Func](), s, g);
    let init = initial_value(s);
    g.ty = init.ty;
    g.init = init;
    g.align = object_align(s);
}

// -----------------------------------------------------------------------------
// Functions: helpers for the code of one
// -----------------------------------------------------------------------------

/// Sets the source location of the instructions made next.
pub fn set_span(sp: u.Span) void {
    ir.cur_src = ir.src_loc(sp.file, u.span_line(sp));
}

pub fn at_end(b: *mut ir.Block) void {
    ir.at_end(B, b);
}

pub fn new_block(name: []u8) *mut ir.Block {
    return ir.append_block(F.f, name);
}

/// Has the current block ended (a branch or return)?
pub fn terminated() bool {
    let b = ir.insert_block(B);
    return u.notnil(b.last) and ir.is_term(b.last.op);
}

/// Continues in a new block (no predecessor yet) if the current one has ended.
pub fn continue_after() void {
    if terminated() {
        at_end(new_block("dead"));
    }
}

pub fn br(b: *mut ir.Block) void {
    if not terminated() {
        ir.br(B, b);
    }
}

/// A new object of type t in the function's frame (its entry block).
pub fn alloca(t: *mut cty.CType, name: []u8) *mut ir.Value {
    if cty.align_of(t) > 16 {
        return aligned_alloca(t, name, 0);
    }
    return frame_object(t, name);
}

fn frame_object(t: *mut cty.CType, name: []u8) *mut ir.Value {
    let cur = ir.insert_block(B);
    let term = ir.terminator(F.entry);
    if u.notnil(term) {
        ir.at_before(B, term);
    } else {
        ir.at_end(B, F.entry);
    }
    let mut it = lty(t);
    if it.size == 0 {
        it = T_i8;
    }
    let a = ir.alloca(B, it, name);
    let al = cty.align_of(t);
    if @as(u64, a.align) < al {
        a.align = @truncate(u32, al);
    }
    ir.at_end(B, cur);
    return a;
}

/// A new temporary of type t in the function's frame, aligned to its type's
/// alignment or 16 bytes, the less (a value's memory, accessed with that
/// alignment: cgen_vec.ax).
pub fn temp_object(t: *mut cty.CType, name: []u8) *mut ir.Value {
    let a = frame_object(t, name);
    if a.align > 16 {
        a.align = 16;
    }
    return a;
}

/// A new object of type t in the function's frame aligned to `al` (an
/// alignment specifier's, or 0). Frames are aligned to 16 bytes: a stricter
/// alignment takes room for the object and the padding before it, and the
/// object's address is the first suitably aligned one in it.
pub fn aligned_alloca(t: *mut cty.CType, name: []u8, al0: u64) *mut ir.Value {
    let mut al = al0;
    if cty.align_of(t) > al {
        al = cty.align_of(t);
    }
    if al <= 16 {
        let a = frame_object(t, name);
        if @as(u64, a.align) < al {
            a.align = @truncate(u32, al);
        }
        return a;
    }
    let raw = frame_object(cty.array_of(cty.t_uchar, cty.size_of(t) + al, true), name);
    raw.align = 16;
    let cur = ir.insert_block(B);
    // (in the entry block, after the frame's objects: it dominates every use)
    let term = ir.terminator(F.entry);
    if u.notnil(term) {
        ir.at_before(B, term);
    } else {
        ir.at_end(B, F.entry);
    }
    let pad = ir.and_(B, ir.sub(B, usz(0), ir.ptrtoint(B, raw, T_isz)), usz(al - 1));
    let p = ir.ptradd(B, raw, pad);
    ir.at_end(B, cur);
    return p;
}

/// An integer constant of pointer width.
pub fn usz(v: u64) *mut ir.Value {
    return ir.cint(T_isz, v);
}

// -----------------------------------------------------------------------------
// The unit
// -----------------------------------------------------------------------------

fn init_types() void {
    T_i1 = ir.t_int(1);
    T_i8 = ir.t_int(8);
    T_i32 = ir.t_int(32);
    T_isz = ir.isz();
    T_ptr = ir.t_ptr();
    T_void = ir.t_void();
}

// The labels whose addresses are taken (`&&label`, a GNU dialect): each is
// an address in a table of its function's, a byte for each (constant: it
// is not read), at its index (CSym.value); `goto *` (cgen_stmt.ax) finds
// the label by the distance from the table's start.

/// The table of the labels of function f whose addresses are taken.
pub fn label_table(f: *mut cast.CSym) *mut ir.Value {
    let name = u.f2("%s.labels.%s", f.name, u.idec(f.uid));
    let mut g = ir.get_global(M, name);
    if u.isnil(g) {
        let mut n = f.value;
        if n == 0 {
            n = 1;
        }
        g = ir.add_global(M, ir.t_array(T_i8, n), name);
        g.init = ir.czero(ir.t_array(T_i8, n));
        g.linkage = ir.LINK_INTERNAL;
        g.is_const = true;
        g.align = 1;
    }
    return g.val;
}

/// The address of label l (`&&l`): a constant.
pub fn label_address(l: *mut cast.CSym) *mut ir.Value {
    let t = label_table(l.owner);
    if l.value == 0 {
        return t;
    }
    return ir.cgaddr(ir.gv_of(t), l.value);
}

// The constructors and destructors of the program's units (the attributes
// constructor and destructor, a GNU dialect), in the order they are
// generated: the start-up calls them around main.
let mut g_ctors: u.List.[*mut cast.CSym] = u.List.[*mut cast.CSym].{ data: @ptr_from_int(*mut *mut cast.CSym, 0),
                                                                     len: 0, cap: 0 };

/// Generates unit cu into module m (wasm: for a WebAssembly target): its
/// objects and functions. False after an error (reported). The units of a
/// program are generated in turn, then the start-up (generate_start).
pub fn generate(m: *mut ir.Module, cu: *mut cs.CUnit, wasm: bool) bool {
    M = m;
    B = ir.new_builder();
    is_wasm = wasm;
    init_types();
    g_defs = u.SymMap.[*mut cast.CSym].{ keys: u.nil.[usize](), vals: u.nil.[*mut cast.CSym](), cap: 0, len: 0 };
    for s in cu.objects.items() {
        g_defs.put(s.name, s);
    }
    for s in cu.funcs.items() {
        g_defs.put(s.name, s);
        let n = cgn.note_of(s);
        if u.notnil(n) and (n.ctor or n.dtor) {
            g_ctors.push(s);
        }
    }
    for s in cu.objects.items() {
        define_object(s);
    }
    // the aliases of external linkage: symbols of their own (ir.Alias)
    for s in cu.aliases.items() {
        note_alias(s);
    }
    for s in cu.funcs.items() {
        if unreferenced_inline(s) {
            continue;
        }
        let f = func_of(s, func_sig(s));
        let st = u.new.[FnState]();
        st.sym = s;
        st.f = f;
        st.ret = s.ty.ret;
        st.sig = func_sig(s);
        F = st;
        hooks.body(s);
        F = u.nil.[FnState]();
    }
    for s in cu.funcs.items() {
        if ((s.tramps.len > 0) or (u.notnil(s.nest_parent) and s.ty.variadic)) and not unreferenced_inline(s) {
            hooks.trampolines(s);
        }
    }
    if g_object_output {
        put_in_arrays();
    }
    return dg.error_count() == 0;
}

// A function of internal linkage, always inlined, that nothing names (no
// call, no address: CSym.used) and no attribute keeps: never generated (the
// intrinsics headers' thousands of functions cost nothing unless called).
fn unreferenced_inline(s: *cast.CSym) bool {
    let n = cgn.note_of(s);
    if s.used or (s.linkage != cast.LK_INTERNAL) or u.isnil(n) {
        return false;
    }
    return n.always_inline and not n.used and not n.ctor and not n.dtor and (n.alias.len == 0);
}

/// Generates START_SYMBOL(argc, argv) into module m, after the units: it
/// calls main (the function main of the unit that defines it: cu) and returns
/// its value as an i32; `exit`: the program defines exit (a unit, or an
/// Axiom module), which the start-up calls with main's value.
pub fn generate_start(m: *mut ir.Module, cu: *mut cs.CUnit, wasm: bool, exit: bool) bool {
    M = m;
    program_exit = exit;
    ir.cur_src = 0;  // (the wrapper has no source of its own)
    if u.isnil(B) {
        B = ir.new_builder();
    }
    is_wasm = wasm;
    init_types();
    start(cu);
    return dg.error_count() == 0;
}

// Does the program define exit (generate_start)?
let mut program_exit: bool = false;

// START_SYMBOL(argc, argv): main's value (an i32).
fn start(cu: *mut cs.CUnit) void {
    let mut pi: [2]*mut ir.Ty = [T_i32, T_ptr];
    let fty = ir.t_fn(T_i32, pi[..], false);
    let mut f = ir.get_function(M, START_SYMBOL);
    if u.isnil(f) {
        f = ir.add_function(M, START_SYMBOL, fty);
    }
    if not ir.is_decl(f) {
        return;
    }
    let st = u.new.[FnState]();
    st.f = f;
    F = st;
    st.entry = new_block("entry");
    at_end(st.entry);
    let mf = func_of(cu.main, func_sig(cu.main));
    let mt = cu.main.ty;
    let mut av: [2]*mut ir.Value = [ir.vnil(), ir.vnil()];
    let mut n: usize = 0;
    if cu.main.params.len == 2 {
        av[0] = conv_i32(f.params[0], cty.t_int);
        av[1] = f.params[1];
        n = 2;
    }
    let runners = define_runners();
    if runners {
        call_runner(CTORS_FN);
    }
    let r = ir.call(B, mf.ty, mf.val, av[0..n]);
    mark_call(r, func_sig(cu.main).plan);
    if runners and not program_exit {
        // (a program without exit: the destructors when main returns; else
        // exit runs them, through __axc_at_exit_dtors)
        call_runner(DTORS_FN);
    }
    _ = mt;
    let ib = cty.t_int.bits;
    let mut status = r;
    if ib > 32 {
        status = ir.trunc(B, r, T_i32);
    } else if ib < 32 {
        status = ir.sext(B, r, T_i32);
    }
    if program_exit or (tg.is_windows() and tg.g_system_c_library) {
        // returning from main is calling exit with its value (5.1.2.2.3):
        // the C library's exit flushes its streams and runs the atexit
        // functions (the start-up's return would end the process at once).
        // That is the program's own exit if it has one (a C unit's, or an
        // Axiom module's export: the hosted C library's, docs/c.md), else
        // (tg.g_system_c_library) the system's C library's on Windows.
        let mut pe: [1]*mut ir.Ty = [T_i32];
        let ety = ir.t_fn(T_void, pe[..], false);
        let mut ef = ir.get_function(M, "exit");
        if u.isnil(ef) {
            ef = ir.add_function(M, "exit", ety);
        }
        if not program_exit {
            c_library_import("exit");
        }
        // (a C unit's exit takes an int of the build's width, --c-int)
        let mut arg = status;
        if ef.ty.params.len == 1 {
            let pt = ef.ty.params[0];
            if (pt.kind == ir.T_INT) and (pt.bits > 32) {
                arg = ir.sext(B, status, pt);
            } else if (pt.kind == ir.T_INT) and (pt.bits < 32) {
                arg = ir.trunc(B, status, pt);
            }
        }
        let mut ea: [1]*mut ir.Value = [arg];
        _ = ir.call(B, ef.ty, ef.val, ea[..]);
    }
    ir.ret(B, status);
    F = u.nil.[FnState]();
}

// The runners of the constructors and destructors (define_runners).
pub let CTORS_FN: []u8 = "__axiom_c_ctors";
pub let DTORS_FN: []u8 = "__axiom_c_dtors";
// exit's slot for the destructors (the hosted C library's, std/c/lib/core)
let DTORS_HOOK: []u8 = "__axc_at_exit_dtors";

fn call_runner(name: []u8) void {
    let f = ir.get_function(M, name);
    _ = ir.call(B, f.ty, f.val, u.nil_slice.[*mut ir.Value]());
}

/// The program is linked with objects whose constructors and destructors
/// are in initialization and termination arrays (theirs, or this
/// compiler's objects': --emit=obj): the runners walk the arrays too,
/// between __init_array_start and __init_array_end (and the fini ones),
/// which the linker defines (nlink.ax), the initialization array first,
/// forward, before the units' constructors, and the termination array
/// last, backward, after their destructors (the generic ABI's order). The
/// functions are called with no arguments.
pub let mut g_init_arrays: bool = false;

// A weak reference to the linker's symbol `name` (an address).
fn weak_symbol(name: []u8) *mut ir.Global {
    let g = ir.get_global(M, name);
    if u.notnil(g) {
        return g;
    }
    let n = ir.add_global(M, T_i8, name);
    n.linkage = ir.LINK_EXTWEAK;
    return n;
}

// Calls each function of the array between the weak symbols first_sym
// and end_sym: forward, or from the end backward.
fn walk_array(first_sym: []u8, end_sym: []u8, forward: bool) void {
    let s = weak_symbol(first_sym);
    let e = weak_symbol(end_sym);
    let pre = ir.insert_block(B);
    let head = new_block("array");
    let body = new_block("array_call");
    let out = new_block("array_done");
    ir.br(B, head);
    at_end(head);
    let p = ir.phi(B, T_ptr);
    let mut first = s.val;
    let mut last = e.val;
    if not forward {
        first = e.val;
        last = s.val;
    }
    ir.add_incoming(p, first, pre);
    ir.condbr(B, ir.icmp(B, ir.IntNE, p, last), body, out);
    at_end(body);
    let mut at = p;
    let mut next = ir.gep1(B, T_ptr, p, ir.cint(T_isz, 1));
    if not forward {
        at = ir.gep1(B, T_ptr, p, ir.cint(T_isz, 0xffff_ffff_ffff_ffff));
        next = at;
    }
    let f = ir.load(B, T_ptr, at);
    let fty = ir.t_fn(T_void, u.nil_slice.[*mut ir.Ty](), false);
    _ = ir.call(B, fty, f, u.nil_slice.[*mut ir.Value]());
    ir.add_incoming(p, next, body);
    ir.br(B, head);
    at_end(out);
}

/// An object for other links (--emit=obj): the constructors and
/// destructors are entries of its initialization and termination arrays
/// (put_in_arrays), which the program that links it runs.
pub let mut g_object_output: bool = false;
/// --c-lib=system: the system's C library and headers (cgen_expr.ax: its
/// setjmp's names).
pub let mut g_system_c_lib: bool = false;

// The constructors in .init_array, the destructors in .fini_array: a
// pointer each, in the section of their priority (.init_array.NNNNN, the
// generic ABI's and the platform toolchain's convention, which its linkers
// sort; the default priority: the plain section, after them). Once.
fn put_in_arrays() void {
    for i in 0..g_ctors.len {
        let s = g_ctors.get(i);
        let n = cgn.note_of(s);
        let f = func_of(s, func_sig(s));
        for pass in @as(i32, 0)..2 {
            let ctor = pass == 0;
            if (ctor and not n.ctor) or (not ctor and not n.dtor) {
                continue;
            }
            let mut prio = @as(i64, n.ctor_prio);
            if not ctor {
                prio = @as(i64, n.dtor_prio);
            }
            let mut sec = u.pick(ctor, ".init_array", ".fini_array");
            if (prio >= 0) and (prio < 65535) {
                let d = u.udec(@bit_cast(u64, prio));
                let mut z = u.Buf.init();
                z.s(sec);
                z.c('.');
                for k in d.len..5 {
                    _ = k;
                    z.c('0');
                }
                z.s(d);
                sec = u.dup(z.view());
            }
            let name = u.f2("axiom.c.%s.%s", u.pick(ctor, "ctor", "dtor"), u.zdec(i));
            if u.notnil(ir.get_global(M, name)) {
                continue;
            }
            let mut fv = f.val;
            if is_wasm and not ctor {
                // (WebAssembly objects have constructors only, the tool
                // conventions' INIT_FUNCS: one of the destructor's priority
                // registers it with atexit, which runs it in the reverse
                // order of registration, the higher priorities first)
                fv = atexit_registrar(f, i);
                sec = u.cat2(".init_array", sec[11..]);
            }
            let g = ir.add_global(M, T_ptr, name);
            g.init = fv;
            g.linkage = ir.LINK_INTERNAL;
            g.section = u.perm_dup(sec);
            g.align = 8;
        }
    }
}

// A function that registers destructor f (the i-th of g_ctors) with atexit.
fn atexit_registrar(f: *mut ir.Func, i: usize) *mut ir.Value {
    let saved_b = B;
    let saved_f = F;
    let fty = ir.t_fn(T_void, u.nil_slice.[*mut ir.Ty](), false);
    let rf = ir.add_function(M, u.f1("axiom.c.atexit_dtor.%s", u.zdec(i)), fty);
    rf.linkage = ir.LINK_INTERNAL;
    let mut pa: [1]*mut ir.Ty = [T_ptr];
    let aty = ir.t_fn(lty(cty.t_int), pa[..], false);
    let mut af = ir.get_function(M, "atexit");
    if u.isnil(af) {
        af = ir.add_function(M, "atexit", aty);
    }
    B = ir.new_builder();
    let st = u.new.[FnState]();
    st.f = rf;
    F = st;
    at_end(new_block("entry"));
    let mut args: [1]*mut ir.Value = [f.val];
    _ = ir.call(B, af.ty, af.val, args[..]);
    ir.ret_void(B);
    B = saved_b;
    F = saved_f;
    return rf.val;
}

/// Defines CTORS_FN and DTORS_FN if the program has constructors or
/// destructors (true then). CTORS_FN calls the constructors, and gives exit
/// the destructors where the C library has exit's slot for them
/// (DTORS_HOOK), so that exit, the program's end however it comes, runs
/// them after the atexit functions; DTORS_FN calls them, once.
pub fn define_runners() bool {
    if g_object_output and not is_wasm {
        return false;  // (put_in_arrays)
    }
    if (g_ctors.len == 0) and not g_init_arrays {
        return false;
    }
    if u.notnil(ir.get_function(M, CTORS_FN)) {
        return true;
    }
    let saved_b = B;
    let saved_f = F;
    let fty = ir.t_fn(T_void, u.nil_slice.[*mut ir.Ty](), false);
    let df = ir.add_function(M, DTORS_FN, fty);
    df.linkage = ir.LINK_INTERNAL;
    let cf = ir.add_function(M, CTORS_FN, fty);
    cf.linkage = ir.LINK_INTERNAL;
    B = ir.new_builder();
    // the destructors, once (exit's, or main's return)
    let done = ir.add_global(M, T_i8, "axiom.c.dtors_done");
    done.init = ir.cint(T_i8, 0);
    done.linkage = ir.LINK_INTERNAL;
    let dst = u.new.[FnState]();
    dst.f = df;
    F = dst;
    let entry = new_block("entry");
    let run = new_block("run");
    let out = new_block("done");
    at_end(entry);
    let was = ir.load(B, T_i8, done.val);
    ir.condbr(B, ir.icmp(B, ir.IntEQ, was, ir.cint(T_i8, 0)), run, out);
    at_end(run);
    _ = ir.store(B, ir.cint(T_i8, 1), done.val);
    call_ctors(false);
    if g_init_arrays and not is_wasm {
        // (backward, the generic ABI's order; forward on Windows, as the C
        // runtime runs .CRT$XT*, whose suffixes say the order: coff.ax)
        walk_array("__fini_array_start", "__fini_array_end", tg.is_windows());
    }
    ir.br(B, out);
    at_end(out);
    ir.ret_void(B);
    let cst = u.new.[FnState]();
    cst.f = cf;
    F = cst;
    at_end(new_block("entry"));
    let hook = ir.get_global(M, DTORS_HOOK);
    if u.notnil(hook) {
        _ = ir.store(B, df.val, hook.val);
    }
    if g_init_arrays and is_wasm {
        // (the objects' constructors on WebAssembly: their INIT_FUNCS, which
        // the linker's __wasm_call_ctors calls, the tool conventions' name)
        let mut wf = ir.get_function(M, "__wasm_call_ctors");
        if u.isnil(wf) {
            wf = ir.add_function(M, "__wasm_call_ctors", fty);
        }
        _ = ir.call(B, wf.ty, wf.val, u.nil_slice.[*mut ir.Value]());
    } else if g_init_arrays {
        walk_array("__preinit_array_start", "__preinit_array_end", true);
        walk_array("__init_array_start", "__init_array_end", true);
    }
    call_ctors(true);
    ir.ret_void(B);
    B = saved_b;
    F = saved_f;
    return true;
}

/// For a program whose main is the Axiom module's (main: its function):
/// the C units' constructors before it, their destructors when it returns
/// (and from exit, as for a C program: define_runners).
pub fn wrap_axiom_main(m: *mut ir.Module, main: *mut ir.Func) void {
    M = m;
    if u.isnil(B) {
        B = ir.new_builder();
    }
    init_types();
    if ir.is_decl(main) {
        return;
    }
    let runners = define_runners();
    // with the C library: when main returns, what exit does before the
    // process ends (its atexit functions, the destructors through exit's
    // slot for them, the streams' flushing), as for a C program's main
    let handlers = ir.get_function(M, EXIT_HANDLERS);
    let has_handlers = u.notnil(handlers) and not ir.is_decl(handlers);
    if not runners and not has_handlers {
        return;
    }
    let saved = B;
    B = ir.new_builder();
    let tmp = ir.append_block(main, "tmp");
    if runners {
        // a call before the first instruction
        let cf = ir.get_function(M, CTORS_FN);
        ir.at_end(B, tmp);
        let c0 = ir.call(B, cf.ty, cf.val, u.nil_slice.[*mut ir.Value]());
        unlink_last(tmp);
        ir.insert_before(main.first.first, c0);
    }
    let mut end = handlers;
    if not has_handlers {
        end = ir.get_function(M, DTORS_FN);
    }
    // and one before each return
    let mut b = main.first;
    while u.notnil(b) {
        let mut v = b.first;
        while u.notnil(v) {
            if v.op == ir.OP_RET {
                ir.at_end(B, tmp);
                let c = ir.call(B, end.ty, end.val, u.nil_slice.[*mut ir.Value]());
                unlink_last(tmp);
                ir.insert_before(v, c);
            }
            v = v.next;
        }
        b = b.next;
    }
    ir.remove_block(tmp);
    B = saved;
}

/// The C library's function of exit's handlers (std/c/lib/core): an Axiom
/// program's main calls it when it returns (wrap_axiom_main).
pub let EXIT_HANDLERS: []u8 = "__axc_exit_handlers";

// Takes the last instruction out of block b (to put it elsewhere).
fn unlink_last(b: *mut ir.Block) void {
    let v = b.last;
    b.last = v.prev;
    if u.notnil(v.prev) {
        v.prev.next = ir.vnil();
    } else {
        b.first = ir.vnil();
    }
    v.prev = ir.vnil();
}

fn ctor_key(s: *mut cast.CSym, ctor: bool) i64 {
    let n = cgn.note_of(s);
    if ctor {
        return @as(i64, n.ctor_prio);
    }
    return @as(i64, n.dtor_prio);
}

// The constructors (ctor) before main, by priority, lowest first, and in
// the order they are defined for a priority; or the destructors after it,
// highest priority first, the last defined first for a priority. (A
// program that ends otherwise than by returning from main does not run its
// destructors: docs/c.md.)
fn call_ctors(ctor: bool) void {
    let xs = u.List.[*mut cast.CSym].empty();
    let mut l = xs;
    for s in g_ctors.items() {
        let n = cgn.note_of(s);
        if (ctor and n.ctor) or (not ctor and n.dtor) {
            l.push(s);
        }
    }
    let items = l.items();
    // (a stable insertion sort: few of them)
    for i in 1..items.len {
        let mut j = i;
        while j > 0 {
            let a = ctor_key(items[j - 1], ctor);
            let b = ctor_key(items[j], ctor);
            let before = (ctor and (a <= b)) or (not ctor and (a >= b));
            if before {
                break;
            }
            let x = items[j];
            items[j] = items[j - 1];
            items[j - 1] = x;
            j -= 1;
        }
    }
    if not ctor {
        // (the same priority: the last defined first)
        let mut a: usize = 0;
        while a < items.len {
            let mut b = a + 1;
            while (b < items.len) and (ctor_key(items[b], false) == ctor_key(items[a], false)) {
                b += 1;
            }
            let mut x = a;
            let mut y = b - 1;
            while x < y {
                let t = items[x];
                items[x] = items[y];
                items[y] = t;
                x += 1;
                y -= 1;
            }
            a = b;
        }
    }
    for s in items {
        let f = func_of(s, func_sig(s));
        let sig = func_sig(s);
        let r = ir.call(B, f.ty, f.val, u.nil_slice.[*mut ir.Value]());
        if u.notnil(sig.plan) {
            mark_call(r, sig.plan);
        }
    }
    l.deinit();
}

// i32 v as a value of integer type t.
fn conv_i32(v: *mut ir.Value, t: *mut cty.CType) *mut ir.Value {
    let it = lty(t);
    if it.bits > 32 {
        return ir.sext(B, v, it);
    }
    if it.bits < 32 {
        return ir.trunc(B, v, it);
    }
    return v;
}
