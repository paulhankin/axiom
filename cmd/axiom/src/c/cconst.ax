// =============================================================================
// cconst.ax - C constant expressions (6.6): the evaluation of integer and
// arithmetic constant expressions as semantic analysis types them (fold),
// with the wrap-around of each type, and address constants for the
// initializers of objects with static storage duration (address).
//
// An expression's value is in its Expr: is_const, and cval (an integer's
// bits, sign- or zero-extended from its type's width: ctypes.wrap; of a
// type wider than 64 bits, the low 64, the value in cwide.ax) or
// fcval (a floating value; a float's is rounded to float; a complex value's
// real part, its imaginary part in fcimag), or xv (a long double's wider
// than double: cldbl.ax, in the target's format, which fcval approximates;
// a complex long double's imaginary part in xvim). fold runs on a
// node once its operands are typed and converted, so constness is found
// bottom-up; operations whose result is undefined (division by zero, an
// overflowing conversion of a floating value) are left to run time. A
// signed integer operation that overflows gives the wrapped value, and
// marks the expression (ovf, carried up through the operands evaluated):
// where a constant expression is required that is an error (6.6p4).
// The integers wider than 64 bits (cty.is_wint) are cwide.ax's.
// =============================================================================
import "../util.ax" as u;
import "cast.ax" as cast;
import "ccomplex.ax" as ccx;
import "cdec.ax" as cdec;
import "cldbl.ax" as cl;
import "copts.ax" as co;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;
import "cwide.ax" as cw;
import "std/c/rt/ldouble" as ld;

/// Sets e's value (is_const, cval or fcval) from its operands', if they are
/// constant and e's operation can be done now.
pub fn fold(e: *mut cast.Expr) void {
    let t = e.ty;
    if u.isnil(t) or not cty.is_arith(t) {
        return;
    }
    let k = e.kind;
    if k == cast.ExprKind.CAST {
        if (e.op == cast.CV_VALUE) and e.a.is_const and cty.is_arith(e.a.ty) {
            convert(e, e.a);
            e.ovf = e.a.ovf;
        } else if (e.op == cast.CV_VALUE) and (e.a.kind == cast.ExprKind.NULLPTR) {
            set_int(e, 0);  // nullptr to bool: false
        } else if (e.op == cast.CV_VALUE) and (e.ty.kind == cty.TK_BOOL) and (e.a.ty.kind == cty.TK_POINTER) {
            // an address constant to bool: an object's or function's address is not null
            let ad = address(e.a);
            if ad.ok {
                set_int(e, selu(u.notnil(ad.sym) or u.notnil(ad.str) or (ad.off != 0), 1, 0));
            }
        }
    } else if k == cast.ExprKind.UNARY {
        if e.a.is_const {
            unary(e);
            e.ovf = e.ovf or e.a.ovf;
        }
    } else if k == cast.ExprKind.BINARY {
        binary(e);
    } else if k == cast.ExprKind.COND {
        if e.a.is_const and u.isnil(e.b) {
            // `a ?: c` (a GNU dialect): a's value, converted, if nonzero
            if truth(e.a) {
                if cty.is_arith(e.ty) and cty.is_arith(e.a.ty) {
                    convert(e, e.a);
                    e.ovf = e.a.ovf;
                }
            } else if e.c.is_const {
                set_from(e, e.c);
                e.ovf = e.a.ovf or e.c.ovf;
            }
        } else if e.a.is_const {
            let c = truth(e.a);
            let x = pick(c, e.b, e.c);
            if x.is_const {
                set_from(e, x);
                e.ovf = e.a.ovf or x.ovf;
            }
        }
    }
}

// Whether order c (-1, 0, 1, or 2 when unordered) satisfies comparison op.
fn order_is(op: i32, c: i32) bool {
    if op == ct.P_LT {
        return c == -1;
    }
    if op == ct.P_GT {
        return c == 1;
    }
    if op == ct.P_LE {
        return (c == -1) or (c == 0);
    }
    if op == ct.P_GE {
        return (c == 1) or (c == 0);
    }
    if op == ct.P_EQ {
        return c == 0;
    }
    return c != 0;
}

fn pick(c: bool, a: *mut cast.Expr, b: *mut cast.Expr) *mut cast.Expr {
    if c {
        return a;
    }
    return b;
}

fn set_int(e: *mut cast.Expr, v: u64) void {
    e.is_const = true;
    e.cval = cty.wrap(e.ty, v);
}

fn set_float(e: *mut cast.Expr, f: f64) void {
    e.is_const = true;
    e.fcval = round_to(e.ty, f);
}

// f rounded to the (corresponding real) type of t (an operation's result
// computed in double, then rounded: the same as computing in the narrower
// format, double having more than twice its precision and two bits more),
// in the translation's direction (cldbl.ax's g_dir: a static FENV_ROUND
// direction's).
fn round_to(t: *cty.CType, f: f64) f64 {
    return cl.round_dir(f, cty.cfmt(t));
}

// x op y (+ - * /) of values of real floating type t (float, double or
// _Float16), rounded to it once in the translation's direction.
fn fop(op: i32, t: *cty.CType, x: f64, y: f64) f64 {
    let mut k: u32 = 0;
    if op == ct.P_MINUS {
        k = 1;
    } else if op == ct.P_STAR {
        k = 2;
    } else if op == ct.P_SLASH {
        k = 3;
    }
    return cl.op_dir(k, x, y, cty.cfmt(t));
}

// e (of a complex type) is the constant re + i im (rounded to its type).
fn set_complex(e: *mut cast.Expr, re: f64, im: f64) void {
    e.is_const = true;
    e.fcval = round_to(e.ty, re);
    e.fcimag = round_to(e.ty, im);
}

fn set_from(e: *mut cast.Expr, x: *cast.Expr) void {
    e.is_const = true;
    e.cval = x.cval;
    e.fcval = x.fcval;
    e.fcimag = x.fcimag;
    e.xv = x.xv;
    e.xvim = x.xvim;
}

/// The format of a wide long double (cty.is_wide).
pub fn ld_fmt() u32 {
    return cl.fmt_of(cty.ld_bits());
}

/// The format (ldouble.ax's FMT_) of a wide floating type t (cty.is_wide:
/// long double, _Float64x or _Float128; or a complex type of one).
pub fn fmt_t(t: *cty.CType) u32 {
    return cl.fmt_of(cty.ffmt(t));
}

// Sets e (of a wide floating type) to w.
fn set_wide(e: *mut cast.Expr, w: ld.W) void {
    e.is_const = true;
    e.xv = w;
    e.fcval = cl.to_f64(w, fmt_t(e.ty));
}

// Sets e (of a complex type whose parts are wide floating values) to re + i im.
fn set_cwide(e: *mut cast.Expr, re: ld.W, im: ld.W) void {
    e.is_const = true;
    e.xv = re;
    e.xvim = im;
    e.fcval = cl.to_f64(re, fmt_t(e.ty));
    e.fcimag = cl.to_f64(im, fmt_t(e.ty));
}

/// Is t a complex type whose parts are wide long doubles?
pub fn is_cwide(t: *cty.CType) bool {
    return cty.is_complex(t) and cty.is_wide(t.unq.elem);
}

/// The value of constant x (of arithmetic type) as a wide long double:
/// exact, from an integer, a float or a double (a complex value's real
/// part).
pub fn wide_value(x: *cast.Expr) ld.W {
    return wide_value_in(x, ld_fmt());
}

/// The value of constant x (of arithmetic type) in wide format f: exact from
/// an integer of at most 64 bits, a binary16, float or double (a complex
/// value's real part), or from the x87's format to binary128; else rounded.
pub fn wide_value_in(x: *cast.Expr, f: u32) ld.W {
    if cty.is_wide(x.ty) or is_cwide(x.ty) {
        return cl.convert(x.xv, fmt_t(x.ty), f);
    }
    if cty.is_floating(x.ty) or cty.is_complex(x.ty) {
        return cl.of_f64(x.fcval, f);
    }
    if cty.is_wint(x.ty) {
        return cw.to_ld(x, f);
    }
    if x.ty.is_signed and (x.ty.kind != cty.TK_BOOL) {
        return cl.of_i64(@bit_cast(i64, x.cval), f);
    }
    return cl.of_u64(x.cval, f);
}

/// Is constant x (of arithmetic type) nonzero? (A complex value is when
/// either part is: 6.3.1.2.)
pub fn truth(x: *cast.Expr) bool {
    if cty.is_decimal(x.ty) {
        return cdec.truth(x);
    }
    if cty.is_imaginary(x.ty) {
        return truth(as_real(x, cty.real_of(x.ty)));
    }
    if cty.is_complex(x.ty) and cty.is_wide(x.ty.elem) {
        return cl.nonzero(x.xv, fmt_t(x.ty)) or cl.nonzero(x.xvim, fmt_t(x.ty));
    }
    if cty.is_complex(x.ty) {
        return (x.fcval != 0.0) or (x.fcimag != 0.0);
    }
    if cty.is_wide(x.ty) {
        return cl.nonzero(x.xv, fmt_t(x.ty));
    }
    if cty.is_floating(x.ty) {
        return x.fcval != 0.0;
    }
    if cty.is_wint(x.ty) {
        return cw.truth(x);
    }
    return x.cval != 0;
}

// A constant's value as a double.
fn as_float(x: *cast.Expr) f64 {
    if cty.is_floating(x.ty) {
        return x.fcval;
    }
    if cty.is_wint(x.ty) {
        return cw.to_f64(x);
    }
    return cl.int_dir(x.cval, x.ty.is_signed and (x.ty.kind != cty.TK_BOOL), 64);
}

// The imaginary part of constant x (a complex value, or 0 for a real one)
// in wide format f.
fn wide_imag(x: *cast.Expr, f: u32) ld.W {
    if is_cwide(x.ty) {
        return cl.convert(x.xvim, fmt_t(x.ty), f);
    }
    if cty.is_complex(x.ty) {
        return cl.of_f64(x.fcimag, f);
    }
    return cl.zero();
}

// Wide value w of format f as a value of real floating type t (not wide:
// rounded once).
fn narrow_wide(w: ld.W, f: u32, t: *cty.CType) f64 {
    return cl.wide_to_dir(w, f, cty.cfmt(t));
}

// -----------------------------------------------------------------------------
// Imaginary constants (Annex G): a value of an imaginary type is its
// coefficient, held as a value of the corresponding real type (fcval, xv)
// -----------------------------------------------------------------------------

// A constant of real type t holding x's value (fcval, cval, xv): a copy that
// the real conversions and operations take.
fn as_real(x: *cast.Expr, t: *mut cty.CType) *mut cast.Expr {
    let r = cast.new_expr(cast.ExprKind.FLOAT, x.span);
    r.ty = t;
    r.is_const = true;
    r.cval = x.cval;
    r.fcval = x.fcval;
    r.xv = x.xv;
    return r;
}

// The imaginary part of constant x (of any arithmetic type) as a constant of
// its real type (0 for a real one); the real part (0 for an imaginary one).
fn imag_part(x: *cast.Expr) *mut cast.Expr {
    let rt = cty.real_of(x.ty);
    if cty.is_imaginary(x.ty) {
        return as_real(x, rt);
    }
    let r = as_real(x, rt);
    if cty.is_complex(x.ty) {
        r.fcval = x.fcimag;
        r.xv = x.xvim;
        return r;
    }
    return zero_of(r, rt);
}

fn real_part(x: *cast.Expr) *mut cast.Expr {
    let rt = cty.real_of(x.ty);
    let r = as_real(x, rt);
    if cty.is_imaginary(x.ty) {
        return zero_of(r, rt);
    }
    return r;
}

// r (a constant of real type t) made +0.
fn zero_of(r: *mut cast.Expr, t: *mut cty.CType) *mut cast.Expr {
    r.ty = t;
    r.cval = 0;
    r.fcval = 0.0;
    r.xv = cl.zero();
    return r;
}

// The constant x (real) converted to real type t.
fn real_to(x: *cast.Expr, t: *mut cty.CType) *mut cast.Expr {
    let r = cast.new_expr(cast.ExprKind.CAST, x.span);
    r.op = cast.CV_VALUE;
    r.ty = t;
    convert(r, x);
    return r;
}

// e (of imaginary type t's real type, or complex) set from constant parts re
// and im (of t's real type); re nil for an imaginary result.
fn set_parts(e: *mut cast.Expr, re: *cast.Expr, im: *cast.Expr) void {
    e.is_const = re.is_const and im.is_const;
    if cty.is_imaginary(e.ty) {
        e.fcval = im.fcval;
        e.xv = im.xv;
        e.cval = 0;
        return;
    }
    if cty.is_complex(e.ty) {
        e.fcval = re.fcval;
        e.xv = re.xv;
        e.fcimag = im.fcval;
        e.xvim = im.xv;
        return;
    }
    e.cval = re.cval;
    e.fcval = re.fcval;
    e.xv = re.xv;
}

// e (a conversion from or to an imaginary type) of constant x (G.4: a
// real value to an imaginary type, or an imaginary one to a real type, is
// +0; to and from a complex type, the imaginary part).
fn convert_imag(e: *mut cast.Expr, x: *cast.Expr) void {
    let to = e.ty;
    let rt = cty.real_of(to);
    if to.kind == cty.TK_BOOL {
        set_int(e, selu(truth(x), 1, 0));
        return;
    }
    if cty.is_imaginary(to) {
        let v = real_to(imag_part(x), rt);
        set_parts(e, v, v);
        return;
    }
    if cty.is_complex(to) {
        let re = real_to(real_part(x), rt);
        let im = real_to(imag_part(x), rt);
        set_parts(e, re, im);
        return;
    }
    // (to a real type: the real part, +0)
    let z = real_to(zero_of(as_real(x, cty.real_of(x.ty)), cty.real_of(x.ty)), to);
    e.is_const = true;
    e.cval = z.cval;
    e.fcval = z.fcval;
    e.xv = z.xv;
}

// The real operation x op y (both of real floating type t), folded.
fn real_op(op: i32, t: *mut cty.CType, x: *cast.Expr, y: *cast.Expr) *mut cast.Expr {
    let r = cast.new_expr(cast.ExprKind.BINARY, x.span);
    r.op = op;
    r.ty = t;
    r.a = as_real(x, t);
    r.b = as_real(y, t);
    binary(r);
    return r;
}

fn real_neg(t: *mut cty.CType, x: *cast.Expr) *mut cast.Expr {
    let r = cast.new_expr(cast.ExprKind.UNARY, x.span);
    r.op = ct.P_MINUS;
    r.ty = t;
    r.a = as_real(x, t);
    unary(r);
    return r;
}

// e = a op b (+ - * /) with an imaginary operand, the operands in their own
// domains of real type T (csema_expr.imag_arith): Annex G.5.1 and G.5.2.
fn imag_binary(e: *mut cast.Expr, op: i32, a: *cast.Expr, b: *cast.Expr) void {
    let t = cty.real_of(e.ty);
    let ka = cty.is_imaginary(a.ty);
    let kb = cty.is_imaginary(b.ty);
    let x = real_part(a);
    let y = imag_part(a);
    let u_ = real_part(b);
    let v = imag_part(b);
    let ca = cty.is_complex(a.ty);
    let cb = cty.is_complex(b.ty);
    if (op == ct.P_PLUS) or (op == ct.P_MINUS) {
        // (each part on its own; a part one operand has not is not added)
        let mut re = x;
        if not ka {
            re = x;
        }
        if not kb {
            if ka {
                re = u_;
                if op == ct.P_MINUS {
                    re = real_neg(t, u_);
                }
            } else {
                re = real_op(op, t, x, u_);
            }
        }
        let mut im = y;
        if ka or ca {
            if kb or cb {
                im = real_op(op, t, y, v);
            }
        } else {
            im = v;
            if op == ct.P_MINUS {
                im = real_neg(t, v);
            }
        }
        set_parts(e, re, im);
        return;
    }
    if op == ct.P_STAR {
        if ka and kb {
            set_parts(e, real_neg(t, real_op(op, t, y, v)), y);  // (iy * iv = -yv)
        } else if ka and cb {
            set_parts(e, real_neg(t, real_op(op, t, y, v)), real_op(op, t, y, u_));  // (-yv + i yu)
        } else if ca and kb {
            set_parts(e, real_neg(t, real_op(op, t, y, v)), real_op(op, t, x, v));  // (-yv + i xv)
        } else if ka {
            set_parts(e, x, real_op(op, t, y, u_));  // (iy * u = i yu)
        } else {
            set_parts(e, x, real_op(op, t, x, v));  // (x * iv = i xv)
        }
        return;
    }
    // division
    if ka and kb {
        set_parts(e, real_op(op, t, y, v), y);  // (iy / iv = y/v)
    } else if ka and not cb {
        set_parts(e, x, real_op(op, t, y, u_));  // (iy / u = i y/u)
    } else if not ka and kb and not ca {
        set_parts(e, x, real_neg(t, real_op(op, t, x, v)));  // (x / iv = i (-x/v))
    } else if ca and kb {
        set_parts(e, real_op(op, t, y, v), real_neg(t, real_op(op, t, x, v)));  // (y/v + i (-x/v))
    } else {
        // (iy / (u + iv): the complex quotient of 0 + iy)
        e.is_const = false;
    }
}

/// e (a conversion to an arithmetic type) of constant x: 6.3.1.
fn convert(e: *mut cast.Expr, x: *cast.Expr) void {
    let to = e.ty;
    let from = x.ty;
    if cty.is_decimal(to) or cty.is_decimal(from) {
        cdec.convert(e, x, ld_fmt());
        return;
    }
    if cty.is_imaginary(to) or cty.is_imaginary(from) {
        convert_imag(e, x);
        return;
    }
    if cty.is_wint(to) {
        // (from a floating value: only when it fits, 6.3.1.4p1)
        if cty.is_integer(from) {
            cw.convert_int(e, x);
        } else if cty.is_wide(from) or is_cwide(from) {
            cw.convert_ld(e, x.xv, fmt_t(from));
        } else {
            cw.convert_f64(e, x.fcval);
        }
        return;
    }
    if cty.is_wint(from) and cty.is_integer(to) {
        // (cval is the value's low 64 bits)
        if to.kind == cty.TK_BOOL {
            set_int(e, selu(truth(x), 1, 0));
        } else {
            set_int(e, x.cval);
        }
        return;
    }
    // (the parts of complex values as real ones, where a wide long double is one)
    if is_cwide(to) {
        set_cwide(e, wide_value_in(x, fmt_t(to)), wide_imag(x, fmt_t(to)));
        return;
    }
    if cty.is_complex(to) and (is_cwide(from) or cty.is_wide(from)) {
        let f = fmt_t(from);
        set_complex(e, narrow_wide(wide_value_in(x, f), f, to.elem), narrow_wide(wide_imag(x, f), f, to.elem));
        return;
    }
    if is_cwide(from) {
        if to.kind == cty.TK_BOOL {
            set_int(e, selu(truth(x), 1, 0));
            return;
        }
        convert_wide(e, x);  // (the real part: 6.3.1.7p1)
        return;
    }
    if cty.is_complex(to) {
        // (6.3.1.6, 6.3.1.7: the parts converted as the real types are; a
        // real value's imaginary part is +0)
        if cty.is_complex(from) {
            set_complex(e, x.fcval, x.fcimag);
            return;
        }
        let mut re = x.fcval;
        if cty.is_integer(from) {
            if cty.ffmt(to.elem) == 32 {
                // (rounded once, from the integer)
                re = int_to_f32(x);
            } else {
                re = as_float(x);
            }
        }
        set_complex(e, re, 0.0);
        return;
    }
    if cty.is_wide(from) or cty.is_wide(to) {
        convert_wide(e, x);
        return;
    }
    if cty.is_integer(to) {
        if cty.is_integer(from) {
            set_int(e, x.cval);
            return;
        }
        // (a complex value: its real part, 6.3.1.7p1; to _Bool, its truth)
        let f = x.fcval;
        if to.kind == cty.TK_BOOL {
            set_int(e, selu(truth(x), 1, 0));
            return;
        }
        // the value must fit (6.3.1.4p1); otherwise left to run time
        let tr = trunc_f(f);
        if (f != f) or not (tr >= -9223372036854775808.0) or not (tr < 18446744073709551616.0) {
            return;
        }
        if tr < 0.0 {
            if not to.is_signed {
                return;
            }
            set_int(e, @bit_cast(u64, @int_from_float(i64, tr)));
        } else {
            set_int(e, @int_from_float(u64, tr));
        }
        if cty.wrap(to, e.cval) != e.cval or not value_fits(to, tr) {
            e.is_const = false;
        }
        return;
    }
    // to a real floating type (from a complex one: the real part)
    if cty.is_floating(from) or cty.is_complex(from) {
        set_float(e, x.fcval);
        return;
    }
    if cty.ffmt(to) == 32 {
        // (rounded once, from the integer)
        e.is_const = true;
        e.fcval = int_to_f32(x);
        return;
    }
    if cty.is_bf16(to) and not cty.is_wint(x.ty) {
        // (rounded once, from the integer: double may not hold it)
        e.is_const = true;
        e.fcval = cl.int_dir(x.cval, x.ty.is_signed and (x.ty.kind != cty.TK_BOOL), cty.FMT_BF16);
        return;
    }
    // (to binary16 from double: exact for every integer that does not
    // overflow it)
    set_float(e, as_float(x));
}

// The integer constant x as a float (rounded once).
fn int_to_f32(x: *cast.Expr) f64 {
    if cty.is_wint(x.ty) {
        return @as(f64, cw.to_f32(x));
    }
    return cl.int_dir(x.cval, x.ty.is_signed and (x.ty.kind != cty.TK_BOOL), 32);
}

// convert, from or to a wide long double: correctly rounded (to float
// once, not through double); to an integer only when the value fits.
fn convert_wide(e: *mut cast.Expr, x: *cast.Expr) void {
    let to = e.ty;
    if cty.is_wide(to) {
        set_wide(e, wide_value_in(x, fmt_t(to)));
        return;
    }
    let f = fmt_t(x.ty);
    let w = x.xv;
    if to.kind == cty.TK_BOOL {
        set_int(e, selu(cl.nonzero(w, f), 1, 0));
        return;
    }
    if cty.is_integer(to) {
        if not cl.fits_int(w, to.bits, to.is_signed, f) {
            return;  // (left to run time: 6.3.1.4p1)
        }
        if to.is_signed {
            set_int(e, @bit_cast(u64, cl.to_i64(w, f)));
        } else {
            set_int(e, cl.to_u64(w, f));
        }
        return;
    }
    e.is_const = true;
    e.fcval = narrow_wide(w, f, to);
}

fn trunc_f(f: f64) f64 {
    if f < 0.0 {
        return -@floor(-f);
    }
    return @floor(f);
}

// Does the integral value f fit integer type t?
fn value_fits(t: *cty.CType, f: f64) bool {
    if t.is_signed {
        let lim = @float_from_int(f64, @bit_cast(i64, cty.int_max(t))) + 1.0;
        return (f < lim) and (f >= -lim);
    }
    let ulim = @float_from_int(f64, cty.int_max(t)) + 1.0;
    return (f >= 0.0) and (f < ulim);
}

fn unary(e: *mut cast.Expr) void {
    let x = e.a;
    let op = e.op;
    if op == ct.P_BANG {
        set_int(e, selu(truth(x), 0, 1));
        return;
    }
    if cty.is_decimal(e.ty) {
        cdec.fold_unary(e, x);
        return;
    }
    if cty.is_imaginary(e.ty) {
        let t = cty.real_of(e.ty);
        if op == ct.P_MINUS {
            let v = real_neg(t, as_real(x, t));
            set_parts(e, v, v);
        } else if op == ct.P_PLUS {
            set_parts(e, x, x);
        }
        return;
    }
    if is_cwide(e.ty) {
        let f = fmt_t(e.ty);
        if op == ct.P_MINUS {
            set_cwide(e, cl.negate(x.xv, f), cl.negate(x.xvim, f));
        } else if op == ct.P_PLUS {
            set_cwide(e, x.xv, x.xvim);
        } else if op == ct.P_TILDE {
            set_cwide(e, x.xv, cl.negate(x.xvim, f));
        }
        return;
    }
    if cty.is_complex(e.ty) {
        if op == ct.P_MINUS {
            set_complex(e, -x.fcval, -x.fcimag);
        } else if op == ct.P_PLUS {
            set_complex(e, x.fcval, x.fcimag);
        } else if op == ct.P_TILDE {
            set_complex(e, x.fcval, -x.fcimag);  // (the conjugate: an extension)
        }
        return;
    }
    if cty.is_wide(e.ty) {
        if op == ct.P_MINUS {
            set_wide(e, cl.negate(x.xv, fmt_t(e.ty)));
        } else if op == ct.P_PLUS {
            set_wide(e, x.xv);
        }
        return;
    }
    if cty.is_floating(e.ty) {
        if op == ct.P_MINUS {
            set_float(e, -x.fcval);
        } else if op == ct.P_PLUS {
            set_float(e, x.fcval);
        }
        return;
    }
    if cty.is_wint(e.ty) {
        cw.fold_unary(e, op, x, ct.P_MINUS, ct.P_TILDE);
        return;
    }
    if op == ct.P_MINUS {
        set_int(e, 0 -% x.cval);
        e.ovf = e.ty.is_signed and (x.cval != 0) and (e.cval == x.cval);  // (the most negative value)
    } else if op == ct.P_PLUS {
        set_int(e, x.cval);
    } else if op == ct.P_TILDE {
        set_int(e, ~x.cval);
    }
}

fn binary(e: *mut cast.Expr) void {
    let op = e.op;
    let a = e.a;
    let b = e.b;
    // && and || are constant once the first operand decides them
    if (op == ct.P_ANDAND) or (op == ct.P_OROR) {
        if not a.is_const or not cty.is_scalar(a.ty) or not cty.is_arith(a.ty) {
            return;
        }
        let ta = truth(a);
        if (op == ct.P_ANDAND) and not ta {
            set_int(e, 0);
            e.ovf = a.ovf;
        } else if (op == ct.P_OROR) and ta {
            set_int(e, 1);
            e.ovf = a.ovf;
        } else if b.is_const and cty.is_arith(b.ty) {
            set_int(e, selu(truth(b), 1, 0));
            e.ovf = a.ovf or b.ovf;
        }
        return;
    }
    if not a.is_const or not b.is_const or not cty.is_arith(a.ty) or not cty.is_arith(b.ty) {
        return;
    }
    e.ovf = a.ovf or b.ovf;
    if is_compare(op) and cty.is_imaginary(a.ty) {
        // (== and != of two imaginary values: their coefficients)
        let t = cty.real_of(a.ty);
        let r = cast.new_expr(cast.ExprKind.BINARY, e.span);
        r.op = op;
        r.ty = cty.t_int;
        r.a = as_real(a, t);
        r.b = as_real(b, t);
        binary(r);
        set_int(e, r.cval);
        return;
    }
    if is_compare(op) {
        set_int(e, selu(compare(op, a, b), 1, 0));
        return;
    }
    if cty.is_decimal(e.ty) {
        cdec.fold_binary(e, a, b);
        return;
    }
    if cty.is_imaginary(a.ty) or cty.is_imaginary(b.ty) {
        imag_binary(e, op, a, b);
        return;
    }
    if cty.is_complex(e.ty) {
        complex_op(e, op, a, b);
        return;
    }
    if cty.is_wide(e.ty) {
        let f = fmt_t(e.ty);
        if op == ct.P_PLUS {
            set_wide(e, cl.add(a.xv, b.xv, f));
        } else if op == ct.P_MINUS {
            set_wide(e, cl.sub(a.xv, b.xv, f));
        } else if op == ct.P_STAR {
            set_wide(e, cl.mul(a.xv, b.xv, f));
        } else if op == ct.P_SLASH {
            set_wide(e, cl.div(a.xv, b.xv, f));
        }
        return;
    }
    if cty.is_floating(e.ty) {
        let x = a.fcval;
        let y = b.fcval;
        if (op == ct.P_PLUS) or (op == ct.P_MINUS) or (op == ct.P_STAR) or (op == ct.P_SLASH) {
            set_float(e, fop(op, e.ty, x, y));
        }
        return;
    }
    if cty.is_wint(e.ty) {
        let wo = wide_op(op);
        if wo >= 0 {
            cw.fold_binary(e, wo, a, b);
        }
        return;
    }
    if not cw.fits64(b) {
        return;  // (a shift count of a wider type, out of range)
    }
    let r = int_op(op, e.ty, a.cval, b.cval);
    if r.ok {
        set_int(e, r.v);
        e.ovf = e.ovf or (e.ty.is_signed and overflows(op, e.ty, a.cval, b.cval));
    }
}

// Does signed x op y (sign-extended bits) overflow type t (6.5p5)? For <<,
// from C99 on, a negative x or a result not representable (6.5.7p4).
fn overflows(op: i32, t: *cty.CType, x: u64, y: u64) bool {
    let a = @bit_cast(i64, x);
    let b = @bit_cast(i64, y);
    let lo = @bit_cast(i64, cty.wrap(t, @as(u64, 1) << @truncate(u32, @bit_cast(u32, t.bits) - 1)));
    let hi = @bit_cast(i64, cty.int_max(t));
    if op == ct.P_PLUS {
        if b >= 0 {
            return a > hi - b;
        }
        return a < lo - b;
    }
    if op == ct.P_MINUS {
        if b >= 0 {
            return a < lo + b;
        }
        return a > hi + b;
    }
    if op == ct.P_STAR {
        if (a == 0) or (b == 0) {
            return false;
        }
        if (a == -1) or (b == -1) {
            return (a == lo) or (b == lo);
        }
        let p = a *% b;
        return ((p / b) != a) or (p < lo) or (p > hi);
    }
    if (op == ct.P_SLASH) or (op == ct.P_PERCENT) {
        return (a == lo) and (b == -1);
    }
    if (op == ct.P_SHL) and (cty.std() >= co.C99) {
        if a < 0 {
            return true;
        }
        return a > (hi >> @truncate(u32, y));
    }
    return false;
}

// The cwide.OP_ of operator op, or -1.
fn wide_op(op: i32) i32 {
    let ops: [10]i32 = [ct.P_PLUS, ct.P_MINUS, ct.P_STAR, ct.P_SLASH, ct.P_PERCENT, ct.P_SHL, ct.P_SHR, ct.P_AMP,
                        ct.P_PIPE, ct.P_CARET];
    for k in 0..ops.len {
        if ops[k] == op {
            return @int_cast(i32, k);
        }
    }
    return -1;
}

pub fn is_compare(op: i32) bool {
    return (op == ct.P_LT) or (op == ct.P_GT) or (op == ct.P_LE) or (op == ct.P_GE) or (op == ct.P_EQ) or
           (op == ct.P_NE);
}

fn compare(op: i32, a: *cast.Expr, b: *cast.Expr) bool {
    let t = a.ty;
    if cty.is_decimal(t) {
        return order_is(op, cdec.compare(a, b));
    }
    if is_cwide(t) {
        let f = fmt_t(t);
        let same = (cl.cmp(wide_value_in(a, f), wide_value_in(b, f), f) == 0) and
                   (cl.cmp(wide_imag(a, f), wide_imag(b, f), f) == 0);
        return same == (op == ct.P_EQ);
    }
    if cty.is_complex(t) {
        // (== and != only: both parts equal, 6.5.9p4)
        let same = (a.fcval == b.fcval) and (a.fcimag == b.fcimag);
        return same == (op == ct.P_EQ);
    }
    if cty.is_wide(t) {
        let c = cl.cmp(a.xv, b.xv, fmt_t(t));  // (2: unordered, a NaN)
        if op == ct.P_LT {
            return c == -1;
        }
        if op == ct.P_GT {
            return c == 1;
        }
        if op == ct.P_LE {
            return (c == -1) or (c == 0);
        }
        if op == ct.P_GE {
            return (c == 1) or (c == 0);
        }
        if op == ct.P_EQ {
            return c == 0;
        }
        return c != 0;
    }
    if cty.is_floating(t) {
        let x = a.fcval;
        let y = b.fcval;
        if op == ct.P_LT {
            return x < y;
        }
        if op == ct.P_GT {
            return x > y;
        }
        if op == ct.P_LE {
            return x <= y;
        }
        if op == ct.P_GE {
            return x >= y;
        }
        if op == ct.P_EQ {
            return x == y;
        }
        return x != y;
    }
    if cty.is_wint(t) {
        let c = cw.compare(t, a, b);
        if op == ct.P_LT {
            return c < 0;
        }
        if op == ct.P_GT {
            return c > 0;
        }
        if op == ct.P_LE {
            return c <= 0;
        }
        if op == ct.P_GE {
            return c >= 0;
        }
        if op == ct.P_EQ {
            return c == 0;
        }
        return c != 0;
    }
    if op == ct.P_EQ {
        return a.cval == b.cval;
    }
    if op == ct.P_NE {
        return a.cval != b.cval;
    }
    let mut lt = a.cval < b.cval;
    let mut gt = a.cval > b.cval;
    if t.is_signed {
        lt = @bit_cast(i64, a.cval) < @bit_cast(i64, b.cval);
        gt = @bit_cast(i64, a.cval) > @bit_cast(i64, b.cval);
    }
    if op == ct.P_LT {
        return lt;
    }
    if op == ct.P_GT {
        return gt;
    }
    if op == ct.P_LE {
        return not gt;
    }
    return not lt;
}

// e = a op b in complex type e.ty, where a real operand stays real (G.5):
// the parts as cgen_complex.ax computes them.
// complex_op where the parts are wide long doubles: the same operations
// (G.5: a real operand stays real), in that arithmetic.
fn complex_wide_op(e: *mut cast.Expr, op: i32, a: *cast.Expr, b: *cast.Expr) void {
    let f = fmt_t(e.ty);
    let acx = cty.is_complex(a.ty);
    let bcx = cty.is_complex(b.ty);
    let x = wide_value_in(a, f);
    let y = wide_value_in(b, f);
    let xi = wide_imag(a, f);
    let yi = wide_imag(b, f);
    if (op == ct.P_PLUS) or (op == ct.P_MINUS) {
        let is_add = op == ct.P_PLUS;
        let mut re = cl.sub(x, y, f);
        if is_add {
            re = cl.add(x, y, f);
        }
        let mut im = xi;
        if acx and bcx {
            im = cl.sub(xi, yi, f);
            if is_add {
                im = cl.add(xi, yi, f);
            }
        } else if bcx {
            im = yi;
            if not is_add {
                im = cl.negate(yi, f);
            }
        }
        set_cwide(e, re, im);
        return;
    }
    if op == ct.P_STAR {
        if not acx {
            set_cwide(e, cl.mul(x, y, f), cl.mul(x, yi, f));
        } else if not bcx {
            set_cwide(e, cl.mul(x, y, f), cl.mul(xi, y, f));
        } else {
            let r = cl.cmul(x, xi, y, yi, f);
            set_cwide(e, r[0], r[1]);
        }
        return;
    }
    if op == ct.P_SLASH {
        if not bcx {
            set_cwide(e, cl.div(x, y, f), cl.div(xi, y, f));
        } else {
            let r = cl.cdiv(x, xi, y, yi, f);
            set_cwide(e, r[0], r[1]);
        }
    }
}

fn complex_op(e: *mut cast.Expr, op: i32, a: *cast.Expr, b: *cast.Expr) void {
    if is_cwide(e.ty) {
        complex_wide_op(e, op, a, b);
        return;
    }
    let s = cty.ffmt(e.ty) == 32;
    let acx = cty.is_complex(a.ty);
    let bcx = cty.is_complex(b.ty);
    let x = a.fcval;
    let y = b.fcval;
    let t = e.ty;
    if (op == ct.P_PLUS) or (op == ct.P_MINUS) {
        let is_add = op == ct.P_PLUS;
        let re = fop(op, t, x, y);
        let mut im = a.fcimag;
        if acx and bcx {
            im = fop(op, t, a.fcimag, b.fcimag);
        } else if bcx {
            im = b.fcimag;
            if not is_add {
                im = -b.fcimag;
            }
        }
        set_complex(e, re, im);
        return;
    }
    if op == ct.P_STAR {
        if not acx {
            set_complex(e, fop(op, t, x, y), fop(op, t, x, b.fcimag));
        } else if not bcx {
            set_complex(e, fop(op, t, x, y), fop(op, t, a.fcimag, y));
        } else {
            let r = ccx.cmul(x, a.fcimag, y, b.fcimag, s);
            set_complex(e, r.re, r.im);
        }
        return;
    }
    if op == ct.P_SLASH {
        if not bcx {
            set_complex(e, fop(op, t, x, y), fop(op, t, a.fcimag, y));
        } else {
            let mut ai: f64 = 0.0;
            if acx {
                ai = a.fcimag;
            }
            let r = ccx.cdiv(x, ai, y, b.fcimag, s);
            set_complex(e, r.re, r.im);
        }
    }
}

pub struct IntResult {
    v: u64,
    ok: bool,
}

/// x op y in integer type t (the operands' bits as cval; a shift's right
/// operand is a count): wrapping; not ok for a division by zero or a shift
/// count out of range.
pub fn int_op(op: i32, t: *cty.CType, x: u64, y: u64) IntResult {
    let sg = t.is_signed;
    let mut v: u64 = 0;
    if op == ct.P_PLUS {
        v = x +% y;
    } else if op == ct.P_MINUS {
        v = x -% y;
    } else if op == ct.P_STAR {
        v = x *% y;
    } else if (op == ct.P_SLASH) or (op == ct.P_PERCENT) {
        if y == 0 {
            return IntResult.{ v: 0, ok: false };
        }
        if sg {
            let a = @bit_cast(i64, x);
            let b = @bit_cast(i64, y);
            if (b == -1) and (a == @min_value(i64)) {
                v = selu(op == ct.P_SLASH, x, 0);
            } else if op == ct.P_SLASH {
                v = @bit_cast(u64, a / b);
            } else {
                v = @bit_cast(u64, a % b);
            }
        } else {
            let ux = cty.wrap_bits(x, t.bits, false);
            let uy = cty.wrap_bits(y, t.bits, false);
            if op == ct.P_SLASH {
                v = ux / uy;
            } else {
                v = ux % uy;
            }
        }
    } else if (op == ct.P_SHL) or (op == ct.P_SHR) {
        if y >= @as(u64, @bit_cast(u32, t.bits)) {
            return IntResult.{ v: 0, ok: false };
        }
        let k = @truncate(u32, y);
        if op == ct.P_SHL {
            v = x << k;
        } else if sg {
            v = @bit_cast(u64, @bit_cast(i64, x) >> k);
        } else {
            v = cty.wrap_bits(x, t.bits, false) >> k;
        }
    } else if op == ct.P_AMP {
        v = x & y;
    } else if op == ct.P_PIPE {
        v = x | y;
    } else if op == ct.P_CARET {
        v = x ^ y;
    } else {
        return IntResult.{ v: 0, ok: false };
    }
    return IntResult.{ v: cty.wrap(t, v), ok: true };
}

// -----------------------------------------------------------------------------
// Address constants (6.6p9)
// -----------------------------------------------------------------------------

/// An address constant: the address of `sym` (an object with static storage
/// duration, a function, or a label whose address `&&label` takes) or of the
/// string literal `str`, plus `off` bytes; neither: the integer `off` (a
/// null pointer when 0).
pub struct Addr {
    ok: bool,
    sym: *mut cast.CSym,
    str: *mut cast.Expr,
    off: u64,
}

fn no_addr() Addr {
    return Addr.{ ok: false, sym: u.nil.[cast.CSym](), str: u.nil.[cast.Expr](), off: 0 };
}

fn plus(a: Addr, d: u64) Addr {
    let mut r = a;
    r.off = r.off +% d;
    return r;
}

/// The value of e (a pointer, or an integer as wide as one) as an address
/// constant; ok false if it is not one.
pub fn address(e: *mut cast.Expr) Addr {
    if e.is_const and cty.is_integer(e.ty) {
        return Addr.{ ok: true, sym: u.nil.[cast.CSym](), str: u.nil.[cast.Expr](), off: e.cval };
    }
    let k = e.kind;
    if k == cast.ExprKind.NULLPTR {
        return Addr.{ ok: true, sym: u.nil.[cast.CSym](), str: u.nil.[cast.Expr](), off: 0 };
    }
    if (k == cast.ExprKind.LABEL_ADDR) and u.notnil(e.sym) {
        // (`&&label`, a GNU dialect: sym is the label)
        return Addr.{ ok: true, sym: e.sym, str: u.nil.[cast.Expr](), off: 0 };
    }
    if k == cast.ExprKind.CAST {
        if (e.op == cast.CV_ADECAY) or (e.op == cast.CV_FDECAY) {
            return lv_address(e.a);
        }
        if e.op == cast.CV_VALUE {
            let from = e.a.ty;
            let to = e.ty;
            let wide = cty.size_of(to) == cty.ptr_bytes;
            if (to.kind == cty.TK_POINTER) or (to.kind == cty.TK_NULLPTR) or (cty.is_integer(to) and wide) {
                if (from.kind == cty.TK_POINTER) or (from.kind == cty.TK_NULLPTR) or cty.is_integer(from) {
                    return address(e.a);
                }
            }
        }
        return no_addr();
    }
    if k == cast.ExprKind.UNARY {
        if e.op == ct.P_AMP {
            return lv_address(e.a);
        }
        return no_addr();
    }
    if k == cast.ExprKind.BINARY {
        if (e.op != ct.P_PLUS) and (e.op != ct.P_MINUS) {
            return no_addr();
        }
        if (e.a.ty.kind != cty.TK_POINTER) or not e.b.is_const {
            return no_addr();
        }
        let base = address(e.a);
        if not base.ok {
            return base;
        }
        let d = e.b.cval *% cty.size_of(e.a.ty.elem);
        if e.op == ct.P_MINUS {
            return plus(base, 0 -% d);
        }
        return plus(base, d);
    }
    if k == cast.ExprKind.COND {
        if e.a.is_const {
            if truth(e.a) {
                if u.isnil(e.b) {
                    return address(e.a);  // (`a ?: c`)
                }
                return address(e.b);
            }
            return address(e.c);
        }
        return no_addr();
    }
    return no_addr();
}

/// The address of lvalue (or function designator) e as an address constant.
pub fn lv_address(e: *mut cast.Expr) Addr {
    let k = e.kind;
    if k == cast.ExprKind.IDENT {
        let s = e.sym;
        if u.isnil(s) {
            return no_addr();
        }
        // (an object with thread storage duration has no address constant)
        if (s.kind == cast.SK_FUNC) or
           ((s.kind == cast.SK_OBJECT) and (s.duration == cast.SD_STATIC) and ((s.flags & cast.CF_THREAD_LOCAL) == 0)) {
            return Addr.{ ok: true, sym: s, str: u.nil.[cast.Expr](), off: 0 };
        }
        return no_addr();
    }
    if k == cast.ExprKind.COMPOUND {
        // a compound literal with static storage duration
        let s = e.sym;
        if u.notnil(s) and (s.duration == cast.SD_STATIC) and ((s.flags & cast.CF_THREAD_LOCAL) == 0) {
            return Addr.{ ok: true, sym: s, str: u.nil.[cast.Expr](), off: 0 };
        }
        return no_addr();
    }
    if k == cast.ExprKind.STRING {
        return Addr.{ ok: true, sym: u.nil.[cast.CSym](), str: e, off: 0 };
    }
    if k == cast.ExprKind.UNARY {
        if e.op == ct.P_STAR {
            return address(e.a);
        }
        return no_addr();
    }
    if k == cast.ExprKind.INDEX {
        if not e.b.is_const {
            return no_addr();
        }
        let base = address(e.a);
        if not base.ok {
            return base;
        }
        return plus(base, e.b.cval *% cty.size_of(e.ty));
    }
    if k == cast.ExprKind.MEMBER {
        let mut base = no_addr();
        if e.op == ct.P_DOT {
            base = lv_address(e.a);
        } else {
            base = address(e.a);
        }
        if not base.ok {
            return base;
        }
        return plus(base, e.cval);
    }
    return no_addr();
}

fn selu(c: bool, a: u64, b: u64) u64 {
    if c {
        return a;
    }
    return b;
}
