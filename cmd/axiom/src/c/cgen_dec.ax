// =============================================================================
// cgen_dec.ax - IR generation for the decimal floating types (C23
// _Decimal32, _Decimal64, _Decimal128; Annex H's _Decimal64x, in
// decimal128's format: cty.is_decimal): their arithmetic,
// comparisons and conversions as calls of std/c/rt/decimal.ax's `dec_`
// functions, which codegen.ax generates into the module (ld_fn), so that
// only those a program uses are in it. Each rounds in the thread's decimal
// rounding direction (fe_dec_setround) and raises its exceptions.
// Part of cgen.ax.
//
// A _Decimal32 or _Decimal64 value is an integer of 32 or 64 bits (its BID
// encoding), kept in integer registers; the functions take and return the
// narrow formats' bits in 64. A _Decimal128 (or _Decimal64x) value is 16
// bytes of memory, as a wide long double's is (cgen_ld.ax: rv gives its
// address, never written through; each operation writes its result into a
// new temporary). Negation is exact and changes the sign bit only
// (IEEE 754-2019 5.5.1).
// =============================================================================
import "../ir.ax" as ir;
import "cconst.ax" as cc;
import "cdec.ax" as cdec;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;
import "std/c/rt/decimal" as dfp;
import "std/c/rt/ldouble" as ld;

fn cu32(x: u32) *mut ir.Value {
    return ir.cint(T_i32, @as(u64, x));
}

fn fmt_of(t: *cty.CType) u32 {
    return cdec.fmt(t);
}

fn dec_wide(t: *cty.CType) bool {
    return cty.is_dec128(t);
}

// A null pointer, for the pointer parameters a narrow format does not use.
fn noptr() *mut ir.Value {
    return ir.czero(T_ptr);
}

// A new temporary for a _Decimal128 value.
fn dec_temp() *mut ir.Value {
    return alloca(cty.t_dec128, "dec");
}

// A call of decimal.ax's function `name` with arguments xs.
fn dec_call(name: []u8, xs: []mut *mut ir.Value) *mut ir.Value {
    let f = ld_fn(name);
    let fty = ir.fnp_of(f).ty;
    return ir.call(B, fty, f, xs);
}

// A narrow value v (i32 or i64) as the i64 the functions take.
fn to64(v: *mut ir.Value) *mut ir.Value {
    if v.ty.bits < 64 {
        return ir.zext(B, v, i64t());
    }
    return v;
}

// A function's i64 result as a value of narrow type t.
fn from64(r: *mut ir.Value, t: *cty.CType) *mut ir.Value {
    if t.unq.kind == cty.TK_DEC32 {
        return ir.trunc(B, r, T_i32);
    }
    return r;
}

// The constant value w of decimal type t: its bits, or (_Decimal128) the
// address of the constant.
fn dec_constant_of(t: *cty.CType, w: ld.W) *mut ir.Value {
    if dec_wide(t) {
        return ld_constant(w);
    }
    if t.unq.kind == cty.TK_DEC32 {
        return ir.cint(T_i32, w.lo & 0xFFFF_FFFF);
    }
    return ir.cint(i64t(), w.lo);
}

// The constant 1 of decimal type t (exponent 0), for ++ and --.
fn dec_one(t: *cty.CType) *mut ir.Value {
    return dec_constant_of(t, dfp.pack(false, dfp.u2(0, 1), 0, fmt_of(t)));
}

// x op y (+ - * /) in decimal type t.
fn dec_arith(op: i32, t: *cty.CType, x: *mut ir.Value, y: *mut ir.Value) *mut ir.Value {
    let mut k: u32 = 0;
    if op == ct.P_MINUS {
        k = 1;
    } else if op == ct.P_STAR {
        k = 2;
    } else if op == ct.P_SLASH {
        k = 3;
    }
    if dec_wide(t) {
        let r = dec_temp();
        let mut xs: [4]*mut ir.Value = [cu32(k), r, x, y];
        _ = dec_call("dec_arith_w", xs[..]);
        return r;
    }
    let mut xs: [4]*mut ir.Value = [cu32(k), to64(x), to64(y), cu32(fmt_of(t))];
    return from64(dec_call("dec_arith_n", xs[..]), t);
}

// -x: its sign bit changed.
fn dec_negate(t: *cty.CType, x: *mut ir.Value) *mut ir.Value {
    if dec_wide(t) {
        let r = dec_temp();
        let lo = ir.load(B, i64t(), x);
        lo.align = 8;
        let hi = ir.load(B, i64t(), ir.ptradd(B, x, usz(8)));
        hi.align = 8;
        let s0 = ir.store(B, lo, r);
        s0.align = 8;
        let s1 = ir.store(B, ir.xor(B, hi, ir.cint(i64t(), 0x8000_0000_0000_0000)), ir.ptradd(B, r, usz(8)));
        s1.align = 8;
        return r;
    }
    if t.unq.kind == cty.TK_DEC32 {
        return ir.xor(B, x, ir.cint(T_i32, 0x8000_0000));
    }
    return ir.xor(B, x, ir.cint(i64t(), 0x8000_0000_0000_0000));
}

// x != 0, as an i1 (a NaN is not zero; nor is any value of a cohort of
// zero: every exponent's).
fn dec_truth(x: *mut ir.Value, t: *cty.CType) *mut ir.Value {
    let mut r = ir.vnil();
    if dec_wide(t) {
        let mut xs: [1]*mut ir.Value = [x];
        r = dec_call("dec_truth_w", xs[..]);
    } else {
        let mut xs: [2]*mut ir.Value = [to64(x), cu32(fmt_of(t))];
        r = dec_call("dec_truth_n", xs[..]);
    }
    return ir.icmp(B, ir.IntNE, r, cu32(0));
}

// x op y (< > <= >= == !=), as an i1: false when unordered, but for !=;
// the relational operators are signaling (an "invalid" exception for any
// NaN), == and != quiet (IEEE 754-2019 5.11, C23 F.9.3 for the decimal
// types too).
fn dec_compare(op: i32, t: *cty.CType, x: *mut ir.Value, y: *mut ir.Value) *mut ir.Value {
    return dec_compare_q(op, t, x, y, (op != ct.P_EQ) and (op != ct.P_NE));
}

// The order of x and y: -1, 0, 1, or 2 when unordered (signaling: "invalid"
// for a quiet NaN too).
fn dec_order(t: *cty.CType, x: *mut ir.Value, y: *mut ir.Value, signaling: bool) *mut ir.Value {
    let sig = cu32(@as(u32, signaling));
    if dec_wide(t) {
        let mut xs: [3]*mut ir.Value = [x, y, sig];
        return dec_call("dec_cmp_w", xs[..]);
    }
    let mut xs: [4]*mut ir.Value = [to64(x), to64(y), cu32(fmt_of(t)), sig];
    return dec_call("dec_cmp_n", xs[..]);
}

// Is x or y a NaN (a quiet comparison: <math.h>'s isunordered)?
fn dec_unordered(t: *cty.CType, x: *mut ir.Value, y: *mut ir.Value) *mut ir.Value {
    return ir.icmp(B, ir.IntEQ, dec_order(t, x, y, false), cu32(2));
}

// The class of x (classification builtin k, decimal.ax's classify), an i32.
fn dec_classify(k: i32, t: *cty.CType, x: *mut ir.Value) *mut ir.Value {
    let mut p = noptr();
    let mut v = ir.cint(i64t(), 0);
    if dec_wide(t) {
        p = x;
    } else {
        v = to64(x);
    }
    let mut xs: [4]*mut ir.Value = [p, v, cu32(fmt_of(t)), cu32(@bit_cast(u32, k))];
    return dec_call("dec_classify", xs[..]);
}

// x op y as dec_compare does, quiet (signaling false) or signaling.
fn dec_compare_q(op: i32, t: *cty.CType, x: *mut ir.Value, y: *mut ir.Value, signaling: bool) *mut ir.Value {
    let c = dec_order(t, x, y, signaling);  // -1, 0, 1, or 2 (unordered)
    let m1 = ir.cint(T_i32, 0xFFFF_FFFF);
    let z = ir.cint(T_i32, 0);
    let o = ir.cint(T_i32, 1);
    if op == ct.P_LT {
        return ir.icmp(B, ir.IntEQ, c, m1);
    }
    if op == ct.P_GT {
        return ir.icmp(B, ir.IntEQ, c, o);
    }
    if op == ct.P_LE {
        return ir.icmp(B, ir.IntULE, ir.add(B, c, o), o);
    }
    if op == ct.P_GE {
        return ir.icmp(B, ir.IntULE, c, o);
    }
    if op == ct.P_EQ {
        return ir.icmp(B, ir.IntEQ, c, z);
    }
    return ir.icmp(B, ir.IntNE, c, z);
}

// The binary format of a binary floating type (decimal.ax's B_): _Float16,
// float, double (and long double where it is double), or a wide long
// double's.
fn bin_of(t: *cty.CType) u32 {
    if cty.is_bf16(t) {
        return dfp.B_BF16;  // (its bits, an i16)
    }
    if cty.is_half(t) {
        return dfp.B_F16;  // (its bits, an i16)
    }
    if cty.ffmt(t) == 32 {
        return dfp.B_F32;  // (float, _Float32)
    }
    if cty.is_wide(t) {
        return cc.fmt_t(t);  // (ldouble.ax's FMT_Q and FMT_X are B_Q and B_X)
    }
    return dfp.B_F64;
}

// Scalar value v of real type `from` converted to real type `to`, one of
// them decimal (C23 6.3.1.4, 6.3.1.5): rounded in the decimal rounding
// direction to a decimal type, to a binary one (_Float16 too) in the
// binary direction (to nearest unless strict: ld_env_strict), once;
// to an integer truncated, saturated (undefined when the value does not
// fit).
fn dec_convert(v: *mut ir.Value, from: *mut cty.CType, to: *mut cty.CType) *mut ir.Value {
    let f = from.unq;
    let t = to.unq;
    if cty.is_decimal(f) and cty.is_decimal(t) {
        if fmt_of(f) == fmt_of(t) {
            return v;  // (_Decimal64x and _Decimal128: one format, the same values)
        }
        let mut r = noptr();
        if dec_wide(t) {
            r = dec_temp();
        }
        let mut p = noptr();
        let mut x = ir.cint(i64t(), 0);
        if dec_wide(f) {
            p = v;
        } else {
            x = to64(v);
        }
        let mut xs: [5]*mut ir.Value = [r, p, x, cu32(fmt_of(f)), cu32(fmt_of(t))];
        let res = dec_call("dec_cvt", xs[..]);
        if dec_wide(t) {
            return r;
        }
        return from64(res, t);
    }
    if cty.is_decimal(t) {
        let df = fmt_of(t);
        let mut r = noptr();
        if dec_wide(t) {
            r = dec_temp();
        }
        let mut res = ir.vnil();
        if cty.is_wint(f) {
            let sg = f.is_signed;
            let mut xs: [5]*mut ir.Value = [r, v, usz(@as(u64, cty.limbs(f))), cu32(@as(u32, sg)), cu32(df)];
            res = dec_call("dec_from_wint", xs[..]);
        } else if cty.is_integer(f) {
            let sg = f.is_signed and (f.kind != cty.TK_BOOL);
            let mut x = v;
            if x.ty.bits < 64 {
                if sg {
                    x = ir.sext(B, x, i64t());
                } else {
                    x = ir.zext(B, x, i64t());
                }
            }
            let mut xs: [4]*mut ir.Value = [r, x, cu32(@as(u32, sg)), cu32(df)];
            res = dec_call("dec_from_int", xs[..]);
        } else {
            // a standard floating value: float's or double's bits, or a wide
            // long double's address
            let b = bin_of(f);
            let mut bp = noptr();
            let mut x = ir.cint(i64t(), 0);
            if cty.is_wide(f) {
                bp = v;
            } else if (b == dfp.B_F16) or (b == dfp.B_BF16) {
                x = ir.zext(B, v, i64t());
            } else if b == dfp.B_F32 {
                x = ir.zext(B, ir.bitcast(B, v, T_i32), i64t());
            } else {
                x = ir.bitcast(B, v, i64t());
            }
            let mut xs: [5]*mut ir.Value = [r, bp, x, cu32(b), cu32(df)];
            res = dec_call("dec_from_bin", xs[..]);
        }
        if dec_wide(t) {
            return r;
        }
        return from64(res, t);
    }
    // from a decimal value
    let sf = fmt_of(f);
    let mut p = noptr();
    let mut x = ir.cint(i64t(), 0);
    if dec_wide(f) {
        p = v;
    } else {
        x = to64(v);
    }
    let tt = lty(t);
    if t.kind == cty.TK_BOOL {
        return ir.zext(B, dec_truth(v, f), tt);
    }
    if cty.is_wint(t) {
        let r = alloca(t, "wint");
        let mut xs: [7]*mut ir.Value = [
            r, usz(@as(u64, cty.limbs(t))), cu32(@bit_cast(u32, t.bits)), cu32(@as(u32, t.is_signed)), p, x, cu32(sf)];
        _ = dec_call("dec_to_wint", xs[..]);
        return r;
    }
    if cty.is_integer(t) {
        let mut xs: [5]*mut ir.Value = [p, x, cu32(sf), cu32(@bit_cast(u32, t.bits)), cu32(@as(u32, t.is_signed))];
        let r = dec_call("dec_to_int", xs[..]);
        if tt.bits < 64 {
            return ir.trunc(B, r, tt);
        }
        return r;
    }
    // to a standard floating type
    let b = bin_of(t);
    let mut r = noptr();
    if cty.is_wide(t) {
        r = ld_temp();
    }
    let mut xs: [5]*mut ir.Value = [r, p, x, cu32(sf), cu32(b)];
    let mut res = ir.vnil();
    if ld_env_strict() {
        // (in the binary rounding direction of the environment)
        res = ld_env_call("dec_e_to_bin", xs[..]);
    } else {
        res = dec_call("dec_to_bin", xs[..]);
    }
    if cty.is_wide(t) {
        return r;
    }
    if (b == dfp.B_F16) or (b == dfp.B_BF16) {
        return ir.trunc(B, res, tt);
    }
    if b == dfp.B_F32 {
        return ir.bitcast(B, ir.trunc(B, res, T_i32), tt);
    }
    return ir.bitcast(B, res, tt);
}
