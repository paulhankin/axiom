// =============================================================================
// cgen_stmt.ax - IR generation for C statements and function bodies, and
// the initialization of automatic objects. Part of cgen.ax (see also
// cgen_stmt_ctrl.ax).
//
// Every object of a function is an alloca in its entry block (mem2reg
// promotes those whose address is not taken), but for the variable length
// arrays (cgen_vla.ax), allocated where they are declared and released by
// the jumps out of their scope. A label or case is a block; goto, break,
// continue and switch branch to them (a switch: cgen_flow.ax). A goto into
// a loop makes control flow irreducible: the native backends take it, and
// for WebAssembly cgen_flow.ax makes it reducible.
// =============================================================================
import "../ir.ax" as ir;
import "../util.ax" as u;
import "cast.ax" as cast;
import "cgen_abi.ax" as abi;
import "cgen_debug.ax" as cdbg;
import "cpragma.ax" as cpg;
import "csema.ax" as cs;
import "ctypes.ax" as cty;

struct Jump {
    brk: *mut ir.Block,
    cont: *mut ir.Block,  // nil for a switch
    brk_depth: i32,       // the variable length arrays in scope where they go (vla_depth)
    cont_depth: i32,
}

struct Body {
    jumps: u.List.[Jump],
    cases: u.SymMap.[*mut ir.Block],  // a CASE or DEFAULT statement's block, by its address
    is_main: bool,
    at_labels: u.SymMap.[*mut void],  // what is in scope at each label whose address is taken (vla_snapshot)
    landings: u.List.[Landing],       // the jumps of `goto *` that leave scopes (computed_goto), made at the end
}

// A jump of a `goto *` to a label whose address is taken, from where
// variable length arrays or objects with cleanups are in scope (or to where
// they are): made at the end of the body (landings), when what is in scope
// at the label is known.
struct Landing {
    blk: *mut ir.Block,
    from: *mut void,  // what is in scope at the goto (vla_snapshot)
    to: *mut cast.CSym,
}

// Has f (its unreachable blocks removed) a return?
fn can_return(f: *mut ir.Func) bool {
    let mut b = f.first;
    while u.notnil(b) {
        let t = ir.terminator(b);
        if u.notnil(t) and (t.op == ir.OP_RET) {
            return true;
        }
        b = b.next;
    }
    return false;
}

fn function_body(s: *mut cast.CSym) void {
    let f = F.f;
    let gn = cs.note_of(s);
    if u.notnil(gn) and gn.naked {
        asm_naked(f.name, f, s.ty, s.def.body);  // (its body is its asm)
        return;
    }
    // (C's rules for races and loops, ir.Func: c_progress cleared by the
    // statements that loop otherwise, loop_ends)
    f.c_races = true;
    f.c_progress = true;
    let b = u.new.[Body]();
    b.cases = u.SymMap.[*mut ir.Block].{ keys: u.nil.[usize](), vals: u.nil.[*mut ir.Block](), cap: 0, len: 0 };
    b.is_main = u.str_eq(s.name, "main") and (s.linkage == cast.LK_EXTERNAL);
    b.at_labels = u.SymMap.[*mut void].{ keys: u.nil.[usize](), vals: u.nil.[*mut void](), cap: 0, len: 0 };
    BD = b;
    vla_begin_function();
    sj_begin_function();
    let d = s.def;
    set_span(d.decls.get(0).name_span);
    f.src = ir.cur_src;
    F.entry = new_block("entry");
    let start = new_block("start");
    at_end(start);
    cdbg.begin_function(f);
    let va_nested = s.ty.variadic and u.notnil(s.nest_parent);
    F.sret = enter_function(F.sig.plan, f, s.params.items(), s.ty.variadic and not va_nested);
    if va_nested {
        // (its variable arguments: its entry's va_list, cgen_nest.ax)
        va_from(f.params[@int_cast(usize, F.sig.plan.args[s.params.len].slot[0])]);
    }
    // (a restrict-qualified pointer parameter passed in a register:
    // ir.F_NOALIAS, 6.7.3.1; one the attribute nonnull or `[static n]` says
    // is not null: ir.F_NONNULL, unless --c-keep-null-checks; `[static n]`'s
    // bytes: ir.Func.param_bytes)
    for j in 0..s.params.len {
        let p = s.params.get(j);
        let a = F.sig.plan.args[j];
        if (a.kind == abi.A_SCALAR) and ((p.ty.quals & cty.Q_RESTRICT) != 0) and (p.ty.kind == cty.TK_POINTER) {
            let pv = f.params[@int_cast(usize, a.slot[0])];
            pv.flags = pv.flags | ir.F_NOALIAS;
        }
        if (a.kind == abi.A_SCALAR) and (p.ty.kind == cty.TK_POINTER) {
            let pv = f.params[@int_cast(usize, a.slot[0])];
            let st = cs.static_param(p);
            let nn = u.notnil(gn) and
                     (gn.nonnull_all or ((j < 64) and ((gn.nonnull & (@as(u64, 1) << @truncate(u32, j))) != 0)));
            if (nn or (st >= 0)) and not cs.opts().keep_null_checks {
                pv.flags = pv.flags | ir.F_NONNULL;
            }
            if st > 0 {
                if f.param_bytes.len < f.params.len {
                    f.param_bytes = u.perm_newn.[u64](f.params.len)[0..f.params.len];
                }
                f.param_bytes[@int_cast(usize, a.slot[0])] = @bit_cast(u64, st);
            }
        }
    }
    // (a parameter of a definition with an identifier list arrives promoted)
    let pts = param_types(s);
    for j in 0..s.params.len {
        let p = s.params.get(j);
        let a = F.sig.plan.args[j];
        if (a.kind == abi.A_SCALAR) and (pts[j] != cty.unqual(p.ty)) {
            let pv = f.params[@int_cast(usize, a.slot[0])];
            store(cty.unqual(p.ty), convert(pv, pts[j], p.ty), @ptr_cast(*mut ir.Value, p.ir));
        }
    }
    nest_enter(s);  // (a nested function's chain, the record of a function with them)
    restrict_function(d.body.items.items(), b.is_main);  // (restrict: cgen_restrict.ax)
    param_lengths(d);
    // floating point under FENV_ACCESS ON or FENV_ROUND anywhere in it:
    // strict for the whole function (the passes consult ir.Func's strict_fp)
    f.strict_fp = d.fp_strict or fenv_all;
    for x in d.body.items.items() {
        stmt_item(x);
    }
    if not terminated() {
        // the end of the body: main returns 0 (5.1.2.2.3); the value of
        // any other is undefined (6.9.1p12); the cleanups of its outermost
        // block's objects first
        if vla_has_cleanups() {
            vla_release_to(0);
        }
        nest_leave(s);
        if not terminated() {
            ret_default(F.sig.plan, F.sret);
        }
    }
    landings();
    nest_finish();  // (the non-local gotos' ends)
    if sj_has_sites() {
        sj_end_function(f, start);  // (setjmp on WebAssembly: the dispatch after a longjmp)
    } else {
        at_end(F.entry);
        ir.br(B, start);
    }
    ir.remove_unreachable(f);
    if cs.is_noreturn(s) and can_return(f) {
        cs.warn(d.decls.get(0).name_span, "C4053",
                u.f1("the function '%s' is declared not to return ('noreturn'), but it can return", s.name));
    }
    if is_wasm {
        make_reducible(f);
    }
    restrict_finish(f);  // (restrict: cgen_restrict.ax)
    cdbg.end_function();
    BD = u.nil.[Body]();
}

// The lengths of the variable length arrays in the types of definition d's
// parameters (6.9.1p10), in order.
fn param_lengths(d: *cast.Decl) void {
    let fd = d.decls.get(0).derivs.at(0);
    for p in fd.params.items() {
        if u.notnil(p.decl.ty) and cty.is_vm(p.decl.ty) {
            vla_eval_specs(p.specs);
            vla_eval_declarator(p.decl, p.decl.ty);
        }
    }
    for kd in d.kr_decls.items() {
        for x in kd.decls.items() {
            if u.notnil(x.ty) and cty.is_vm(x.ty) {
                vla_eval_declarator(x, x.ty);
            }
        }
    }
}

// A block item, under its floating-point pragmas' state (cpragma.ax).
fn stmt_item(s: *mut cast.Stmt) void {
    if u.notnil(s) {
        fp_state = s.fp;
        if fenv_all {
            fp_state = fp_state | cpg.FP_ACCESS;
        }
    }
    stmt(s);
}

fn stmt(s: *mut cast.Stmt) void {
    if u.isnil(s) {
        return;
    }
    set_span(s.span);
    let k = s.kind;
    if k == cast.StmtKind.COMPOUND {
        let d = vla_depth();
        let sc = cdbg.open_block(s.items.items());
        let rs = restrict_block(s.items.items(), u.nil.[cast.Stmt]());  // (restrict: cgen_restrict.ax)
        let outer = fp_state;
        for x in s.items.items() {
            stmt_item(x);
        }
        fp_state = outer;
        vla_leave(d);
        restrict_close(rs);
        cdbg.close_scope(sc);
    } else if k == cast.StmtKind.DECL {
        decl(s.decl);
    } else if k == cast.StmtKind.EXPR {
        if u.notnil(s.e) {
            continue_after();
            _ = lv_full(s.e);
        }
    } else if k == cast.StmtKind.IF {
        if_stmt(s);
    } else if k == cast.StmtKind.SWITCH {
        switch_stmt(s);
    } else if k == cast.StmtKind.WHILE {
        while_stmt(s);
    } else if k == cast.StmtKind.DO {
        do_stmt(s);
    } else if k == cast.StmtKind.FOR {
        for_stmt(s);
    } else if (k == cast.StmtKind.GOTO) and u.notnil(s.e) {
        F.f.c_progress = false;  // (a goto may loop: not an iteration statement)
        computed_goto(s);
    } else if (k == cast.StmtKind.GOTO) and u.notnil(s.sym.owner) and (s.sym.owner != F.sym) {
        F.f.c_progress = false;
        nest_goto(s.sym);  // (to a label of an enclosing function)
    } else if k == cast.StmtKind.GOTO {
        F.f.c_progress = false;
        vla_release_to(cs.vla_depth(s.sym));
        br(label_block(s.sym));
    } else if k == cast.StmtKind.CONTINUE {
        let mut i = BD.jumps.len;
        while i > 0 {
            i -= 1;
            if u.notnil(BD.jumps.at(i).cont) {
                vla_release_to(BD.jumps.at(i).cont_depth);
                br(BD.jumps.at_mut(i).cont);
                break;
            }
        }
    } else if k == cast.StmtKind.BREAK {
        vla_release_to(BD.jumps.last().brk_depth);
        br(BD.jumps.last().brk);
    } else if k == cast.StmtKind.RETURN {
        return_stmt(s);
    } else if k == cast.StmtKind.LABEL {
        let b = label_block(s.sym);
        br(b);
        at_end(b);
        nest_label(s.sym);  // (a nested function's non-local goto's target)
        if s.sym.label_addr {
            BD.at_labels.put(u.addr_key(@int_from_ptr(s.sym)), vla_snapshot());  // (a `goto *`'s target)
        }
        stmt(s.body);
    } else if k == cast.StmtKind.ASM {
        F.f.c_progress = false;  // (asm goto may loop)
        asm_stmt(s.asm);
    } else {
        // CASE, DEFAULT
        let b = BD.cases.get(u.addr_key(@int_from_ptr(s)));
        br(b);
        at_end(b);
        stmt(s.body);
    }
}

// An asm statement (a GNU dialect: cgen_asm.ax); for `asm goto`, a switch
// on which label its template jumped to, each case a goto to its label
// (leaving the scopes it leaves as a goto statement does).
fn asm_stmt(a: *mut cast.Asm) void {
    continue_after();
    let r = asm_stmt_gen(a);
    if u.isnil(r) or not a.goto_ {
        return;
    }
    let n = a.labels.len;
    let vs = u.newn.[u64](n + 1);
    let bs = u.newn.[*mut ir.Block](n + 1);
    for i in 0..n {
        vs[i] = @as(u64, i) + 1;
        bs[i] = new_block("asm.goto");
    }
    let next = new_block("asm.next");
    switch_to(r, false, vs[0..n], bs[0..n], next);
    for i in 0..n {
        at_end(bs[i]);
        stmt(a.labels.get(i).stmt);
    }
    at_end(next);
}

// `goto *p` (a GNU dialect): p is the address of one of the function's
// labels (`&&label`: label_address), found by its distance from their
// table's start; any other value is undefined (the switch's default). A
// label in a scope of a variable length array or of an object with a
// cleanup, or a goto in one, goes through a landing (made at the end:
// landings) that leaves the scopes the jump leaves as a goto does, freeing
// the arrays and calling the cleanups; to a label in such a scope the goto
// is not in (6.8.6.1p1: a jump into it, which the label's address makes
// possible at run time), it traps.
fn computed_goto(s: *mut cast.Stmt) void {
    continue_after();
    let p = lv_full(s.e);
    let f = F.sym;
    let ls = cs.addr_labels(f);
    let base = label_table(f);
    let k = ir.sub(B, ir.ptrtoint(B, p, T_isz), ir.ptrtoint(B, base, T_isz));
    let dead = new_block("badgoto");
    let vs = u.newn.[u64](ls.len + 1);
    let bs = u.newn.[*mut ir.Block](ls.len + 1);
    let from = vla_snapshot();
    let scoped = vla_depth() > 0;
    for i in 0..ls.len {
        vs[i] = ls[i].value;
        if scoped or (cs.vla_depth(ls[i]) > 0) {
            bs[i] = new_block("goto.leave");
            BD.landings.push(Landing.{ blk: bs[i], from: from, to: ls[i] });
        } else {
            bs[i] = label_block(ls[i]);
        }
    }
    switch_to(k, false, vs[0..ls.len], bs[0..ls.len], dead);
    at_end(dead);
    ir.unreachable(B);
}

// The landings of the function's `goto *` statements (computed_goto).
fn landings() void {
    if BD.landings.len == 0 {
        return;
    }
    let saved = vla_snapshot();
    for x in BD.landings.items() {
        at_end(x.blk);
        let at = BD.at_labels.get(u.addr_key(@int_from_ptr(x.to)));
        if not u.isvnil(at) and vla_is_prefix(at, x.from) {
            vla_restore(x.from);
            vla_release_to(cs.vla_depth(x.to));
            if not terminated() {
                br(label_block(x.to));
            }
        } else {
            // (into a scope the goto is not in: undefined, 6.8.6.1p1)
            _ = ir.intr(B, ir.IN_TRAP, T_void, no_vals());
            ir.unreachable(B);
        }
    }
    vla_restore(saved);
    BD.landings.clear();
}

// `({ ... })` (a GNU dialect): its block, and the value of its last
// statement, an expression's (or none); the objects of the block with
// cleanups are cleaned up after it is computed (a structure's value
// copied first).
fn stmt_expr(e: *mut cast.Expr) *mut ir.Value {
    let s = e.body;
    let d = vla_depth();
    let xs = s.items.items();
    let sc = cdbg.open_block(xs);
    let mut v = ir.vnil();
    for i in 0..xs.len {
        let x = xs[i];
        if (i + 1 == xs.len) and u.notnil(cs.value_stmt(x)) and not cty.is_void(e.ty) {
            v = last_value(x);
            if (cty.is_record(e.ty) or cty.is_vector(e.ty) or cty.is_wide(e.ty) or cty.is_wint(e.ty)) and
               (vla_depth() > d) {
                let tmp = alloca(e.ty, "stmtexpr");
                copy(e.ty, tmp, v);
                v = tmp;
            }
            continue;
        }
        stmt(x);
    }
    vla_leave(d);
    cdbg.close_scope(sc);
    continue_after();
    if u.isnil(v) and not cty.is_void(e.ty) {
        // (the block ended in a jump: the value is never used)
        if cty.is_record(e.ty) or cty.is_vector(e.ty) or cty.is_wide(e.ty) or cty.is_wint(e.ty) {
            return alloca(e.ty, "stmtexpr");
        }
        return ir.czero(lty(e.ty));
    }
    return v;
}

// The labels of statement s, then the value of its expression statement
// (a statement expression's last: cs.value_stmt).
fn last_value(s: *mut cast.Stmt) *mut ir.Value {
    set_span(s.span);
    if s.kind == cast.StmtKind.LABEL {
        let b = label_block(s.sym);
        br(b);
        at_end(b);
        return last_value(s.body);
    }
    if (s.kind == cast.StmtKind.CASE) or (s.kind == cast.StmtKind.DEFAULT) {
        let b = BD.cases.get(u.addr_key(@int_from_ptr(s)));
        br(b);
        at_end(b);
        return last_value(s.body);
    }
    continue_after();
    return rv(s.e);
}

fn label_block(l: *mut cast.CSym) *mut ir.Block {
    if u.isvnil(l.ir) {
        l.ir = @ptr_cast(*mut void, new_block(l.name));
    }
    return @ptr_cast(*mut ir.Block, l.ir);
}

// Have declaration specifiers ds a typeof of a variably modified type?
fn has_vm_typeof(ds: *cast.DeclSpec) bool {
    for s in ds.items.items() {
        if s.kind == cast.SpecKind.TYPEOF {
            if u.notnil(s.tname) and u.notnil(s.tname.ty) and cty.is_vm(s.tname.ty) {
                return true;
            }
            if u.isnil(s.tname) and u.notnil(s.e) and u.notnil(s.e.ty) and cty.is_vm(s.e.ty) {
                return true;
            }
        }
    }
    return false;
}

fn decl(d: *mut cast.Decl) void {
    if d.kind != cast.DeclKind.DECL {
        return;
    }
    cdbg.note_block_decl(d);
    if (d.decls.len > 0) and has_vm_typeof(d.specs) {
        continue_after();
        vla_eval_specs(d.specs);
    }
    for x in d.decls.items() {
        let s = x.sym;
        if u.notnil(x.ty) and cty.is_vm(x.ty) and not cty.is_func(x.ty) {
            continue_after();
            vla_eval_declarator(x, x.ty);
        }
        if u.isnil(s) or (s.kind != cast.SK_OBJECT) or (s.duration != cast.SD_AUTO) {
            continue;
        }
        if cs.vla_allocates(s) {
            continue_after();
            let p = vla_allocate(s.ty, object_align(s));
            s.ir = @ptr_cast(*mut void, p);
            nest_allocated(s);  // (for its nested functions)
            // (its address in an object of its own: -O0 keeps it there, for debuggers)
            let a = alloca(cty.pointer_to(s.ty.elem), "vla.addr");
            _ = ir.store(B, p, a);
            cdbg.note_indirect(F.f, s, a);
            if u.notnil(s.init) {
                _ = ir.memop(B, ir.OP_MEMSET, p, ir.cint(T_i8, 0), vla_size_value(s.ty));  // (C23: `= {}`)
            }
            push_cleanup(s);
            continue;
        }
        if u.isvnil(s.ir) {
            s.ir = @ptr_cast(*mut void, aligned_alloca(s.ty, s.name, s.align));
            restrict_lifetime(@ptr_cast(*mut ir.Value, s.ir));  // (its block's: cgen_restrict.ax)
            cdbg.note_var(F.f, s, @ptr_cast(*mut ir.Value, s.ir));
        }
        if u.notnil(s.init) {
            continue_after();
            init_local(s, @ptr_cast(*mut ir.Value, s.ir));
        }
        push_cleanup(s);
    }
}

// An automatic object with a cleanup (a GNU dialect) comes in scope.
fn push_cleanup(s: *cast.CSym) void {
    let n = cs.note_of(s);
    if u.notnil(n) and u.notnil(n.cleanup_call) {
        vla_push_cleanup(n.cleanup_call);
    }
}

// Stores automatic object s's initializer at p.
fn init_local(s: *mut cast.CSym, p: *mut ir.Value) void {
    let list = s.init;
    let vol = volatile_of(s.ty);
    for t in list.pre.items() {
        // (a designator range's value, evaluated once: csema_desig.once)
        let tp = alloca(t.ty, t.name);
        t.ir = @ptr_cast(*mut void, tp);
        init_local(t, tp);
    }
    if list.zero {
        zero_mem(p, cty.size_of(s.ty));
    }
    for k in 0..list.items.len {
        let it = list.items.at_mut(k);
        let at = ir.ptradd(B, p, usz(it.off));
        let t = it.ty;
        if u.isnil(it.e) {
            zero_mem(at, cty.size_of(t));
        } else if t.kind == cty.TK_ARRAY {
            // a string literal: its code units, then zeros
            let es = cty.size_of(t.elem);
            let mut n = @as(u64, it.e.tok.units.len) + 1;
            if n > t.len {
                n = t.len;
            }
            if not list.zero and (n < t.len) {
                zero_mem(at, t.len * es);
            }
            _ = ir.memop(B, ir.OP_MEMCPY, at, string_addr(it.e), usz(n * es));
        } else if cty.is_wide(t) or cty.is_dec128(t) {
            ld_copy(at, lv_full(it.e), (vol != 0) or ((t.quals & cty.Q_VOLATILE) != 0));
        } else if cty.is_wint(t) and u.isnil(it.bits) {
            wint_copy(t, at, lv_full(it.e), (vol != 0) or ((t.quals & cty.Q_VOLATILE) != 0));
        } else if cty.is_record(t) {
            copy(t, at, lv_full(it.e));
        } else if cty.is_vector(t) {
            vec_copy(cty.qualify(t, vol), at, lv_full(it.e));
        } else if u.notnil(it.bits) {
            _ = bf_store(it.bits, cty.qualify(t, vol), lv_full(it.e), at);
        } else {
            // (a volatile object's initialization is a volatile access too)
            store(cty.qualify(t, vol), lv_full(it.e), at);
        }
    }
}

// The volatile qualifier of t or of its elements.
fn volatile_of(t: *cty.CType) i32 {
    if t.kind == cty.TK_ARRAY {
        return volatile_of(t.elem);
    }
    return t.quals & cty.Q_VOLATILE;
}
