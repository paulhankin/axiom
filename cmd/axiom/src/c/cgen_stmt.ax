// =============================================================================
// cgen_stmt.ax - IR generation for C statements and function bodies, and
// the initialization of automatic objects; generate is the entry point of
// IR generation (it installs the hook cgen.ax calls for function bodies).
//
// Every object of a function is an alloca in its entry block (mem2reg
// promotes those whose address is not taken), but for the variable length
// arrays (cgen_vla.ax), allocated where they are declared and released by
// the jumps out of their scope. A label or case is a block; goto, break,
// continue and switch branch to them (a switch: cgen_flow.ax). A goto into
// a loop makes control flow irreducible: the native backends take it, and
// for WebAssembly cgen_flow.ax makes it reducible.
// =============================================================================
import "../ir.ax" as ir;
import "../util.ax" as u;
import "cast.ax" as cast;
import "cgen.ax" as cg;
import "cgen_abi.ax" as abi;
import "cgen_asm.ax" as gasm;
import "cgen_bits.ax" as cgb;
import "cgen_debug.ax" as cdbg;
import "cgen_expr.ax" as gx;
import "cgen_flow.ax" as flow;
import "cgen_ld.ax" as gld;
import "cgen_sjlj.ax" as sj;
import "cgen_va.ax" as gva;
import "cgen_vla.ax" as gv;
import "cgen_wint.ax" as cgw;
import "cpragma.ax" as cpg;
import "csema.ax" as cs;
import "csema_attr.ax" as catr;
import "csema_gnu.ax" as cgn;
import "csema_stmt.ax" as css;
import "csema_vla.ax" as svla;
import "ctypes.ax" as cty;
import "cwide.ax" as cw;

struct Jump {
    brk: *mut ir.Block,
    cont: *mut ir.Block,  // nil for a switch
    brk_depth: i32,       // the variable length arrays in scope where they go (cgen_vla.depth)
    cont_depth: i32,
}

struct Body {
    jumps: u.List.[Jump],
    cases: u.SymMap.[*mut ir.Block],  // a CASE or DEFAULT statement's block, by its address
    is_main: bool,
}

let mut BD: *mut Body = @ptr_from_int(*mut Body, 0);

/// Generates unit cu into module m (wasm: for a WebAssembly target).
/// False after an error (reported).
pub fn generate(m: *mut ir.Module, cu: *mut cs.CUnit, wasm: bool) bool {
    cg.hooks.body = function_body;
    cg.hooks.local_init = init_local;
    cg.hooks.stmt_expr = stmt_expr;
    gv.gen_expr = gx.rv;
    cdbg.vla_len_slot = gv.len_slot;
    let ok = cg.generate(m, cu, wasm);
    // (after the unit's functions and objects: the names of internal linkage file-scope asm names are theirs)
    for a in cu.asms.items() {
        gasm.toplevel(a);
    }
    return ok;
}

// Has f (its unreachable blocks removed) a return?
fn can_return(f: *ir.Func) bool {
    let mut b = f.first;
    while u.notnil(b) {
        let t = ir.terminator(b);
        if u.notnil(t) and (t.op == ir.OP_RET) {
            return true;
        }
        b = b.next;
    }
    return false;
}

fn function_body(s: *mut cast.CSym) void {
    let F = cg.F;
    let f = F.f;
    let gn = cgn.note_of(s);
    if u.notnil(gn) and gn.naked {
        gasm.naked(f.name, f, s.def.body);  // (its body is its asm)
        return;
    }
    let b = u.new.[Body]();
    b.cases = u.SymMap.[*mut ir.Block].{ keys: u.nil.[usize](), vals: u.nil.[*mut ir.Block](), cap: 0, len: 0 };
    b.is_main = u.str_eq(s.name, "main") and (s.linkage == cast.LK_EXTERNAL);
    BD = b;
    gv.begin_function();
    sj.begin_function();
    let d = s.def;
    cg.set_span(d.decls.get(0).name_span);
    f.src = ir.cur_src;
    F.entry = cg.new_block("entry");
    let start = cg.new_block("start");
    cg.at_end(start);
    cdbg.begin_function(f);
    F.sret = gva.enter_function(F.sig.plan, f, s.params.items(), s.ty.variadic);
    // (a parameter of a definition with an identifier list arrives promoted)
    let pts = cg.param_types(s);
    for j in 0..s.params.len {
        let p = s.params.get(j);
        let a = F.sig.plan.args[j];
        if (a.kind == abi.A_SCALAR) and (pts[j] != cty.unqual(p.ty)) {
            let pv = f.params[@int_cast(usize, a.slot[0])];
            gx.store(cty.unqual(p.ty), gx.convert(pv, pts[j], p.ty), @ptr_cast(*mut ir.Value, p.ir));
        }
    }
    param_lengths(d);
    // floating point under FENV_ACCESS ON or FENV_ROUND anywhere in it:
    // strict for the whole function (the passes consult ir.Func's strict_fp)
    f.strict_fp = d.fp_strict or cg.fenv_all;
    for x in d.body.items.items() {
        item(x);
    }
    if not cg.terminated() {
        // the end of the body: main returns 0 (5.1.2.2.3); the value of
        // any other is undefined (6.9.1p12); the cleanups of its outermost
        // block's objects first
        if gv.has_cleanups() {
            gv.release_to(0);
        }
        if not cg.terminated() {
            gva.ret_default(F.sig.plan, F.sret);
        }
    }
    if sj.has_sites() {
        sj.end_function(f, start);  // (setjmp on WebAssembly: the dispatch after a longjmp)
    } else {
        cg.at_end(F.entry);
        ir.br(cg.B, start);
    }
    ir.remove_unreachable(f);
    if catr.is_noreturn(s) and can_return(f) {
        cs.warn(d.decls.get(0).name_span, "C4053",
                u.f1("the function '%s' is declared not to return ('noreturn'), but it can return", s.name));
    }
    if cg.is_wasm {
        flow.make_reducible(f);
    }
    cdbg.end_function();
    BD = u.nil.[Body]();
}

// The lengths of the variable length arrays in the types of definition d's
// parameters (6.9.1p10), in order.
fn param_lengths(d: *cast.Decl) void {
    let fd = d.decls.get(0).derivs.at(0);
    for p in fd.params.items() {
        if u.notnil(p.decl.ty) and cty.is_vm(p.decl.ty) {
            gv.eval_specs(p.specs, gx.rv, gx.effects);
            gv.eval_declarator(p.decl, p.decl.ty, gx.rv);
        }
    }
    for kd in d.kr_decls.items() {
        for x in kd.decls.items() {
            if u.notnil(x.ty) and cty.is_vm(x.ty) {
                gv.eval_declarator(x, x.ty, gx.rv);
            }
        }
    }
}

// A block item, under its floating-point pragmas' state (cpragma.ax).
fn item(s: *mut cast.Stmt) void {
    if u.notnil(s) {
        gx.fp_state = s.fp;
        if cg.fenv_all {
            gx.fp_state = gx.fp_state | cpg.FP_ACCESS;
        }
    }
    stmt(s);
}

fn stmt(s: *mut cast.Stmt) void {
    if u.isnil(s) {
        return;
    }
    cg.set_span(s.span);
    let k = s.kind;
    if k == cast.StmtKind.COMPOUND {
        let d = gv.depth();
        let sc = cdbg.open_block(s.items.items());
        let outer = gx.fp_state;
        for x in s.items.items() {
            item(x);
        }
        gx.fp_state = outer;
        gv.leave(d);
        cdbg.close_scope(sc);
    } else if k == cast.StmtKind.DECL {
        decl(s.decl);
    } else if k == cast.StmtKind.EXPR {
        if u.notnil(s.e) {
            cg.continue_after();
            _ = gx.full(s.e);
        }
    } else if k == cast.StmtKind.IF {
        if_stmt(s);
    } else if k == cast.StmtKind.SWITCH {
        switch_stmt(s);
    } else if k == cast.StmtKind.WHILE {
        while_stmt(s);
    } else if k == cast.StmtKind.DO {
        do_stmt(s);
    } else if k == cast.StmtKind.FOR {
        for_stmt(s);
    } else if (k == cast.StmtKind.GOTO) and u.notnil(s.e) {
        computed_goto(s);
    } else if k == cast.StmtKind.GOTO {
        gv.release_to(svla.depth(s.sym));
        cg.br(label_block(s.sym));
    } else if k == cast.StmtKind.CONTINUE {
        let mut i = BD.jumps.len;
        while i > 0 {
            i -= 1;
            if u.notnil(BD.jumps.at(i).cont) {
                gv.release_to(BD.jumps.at(i).cont_depth);
                cg.br(BD.jumps.at(i).cont);
                break;
            }
        }
    } else if k == cast.StmtKind.BREAK {
        gv.release_to(BD.jumps.last().brk_depth);
        cg.br(BD.jumps.last().brk);
    } else if k == cast.StmtKind.RETURN {
        return_stmt(s);
    } else if k == cast.StmtKind.LABEL {
        let b = label_block(s.sym);
        cg.br(b);
        cg.at_end(b);
        stmt(s.body);
    } else if k == cast.StmtKind.ASM {
        asm_stmt(s.asm);
    } else {
        // CASE, DEFAULT
        let b = BD.cases.get(u.addr_key(@int_from_ptr(s)));
        cg.br(b);
        cg.at_end(b);
        stmt(s.body);
    }
}

// An asm statement (a GNU dialect: cgen_asm.ax); for `asm goto`, a switch
// on which label its template jumped to, each case a goto to its label
// (leaving the scopes it leaves as a goto statement does).
fn asm_stmt(a: *mut cast.Asm) void {
    cg.continue_after();
    let r = gasm.stmt(a);
    if u.isnil(r) or not a.goto_ {
        return;
    }
    let n = a.labels.len;
    let vs = u.newn.[u64](n + 1);
    let bs = u.newn.[*mut ir.Block](n + 1);
    for i in 0..n {
        vs[i] = @as(u64, i) + 1;
        bs[i] = cg.new_block("asm.goto");
    }
    let next = cg.new_block("asm.next");
    flow.switch_to(r, false, vs[0..n], bs[0..n], next);
    for i in 0..n {
        cg.at_end(bs[i]);
        stmt(a.labels.get(i).stmt);
    }
    cg.at_end(next);
}

// `goto *p` (a GNU dialect): p is the address of one of the function's
// labels (`&&label`: cgen.label_address), found by its distance from their
// table's start; any other value is undefined (the switch's default).
fn computed_goto(s: *mut cast.Stmt) void {
    cg.continue_after();
    let p = gx.full(s.e);
    let f = cg.F.sym;
    let ls = css.addr_labels(f);
    let base = cg.label_table(f);
    let k = ir.sub(cg.B, ir.ptrtoint(cg.B, p, cg.T_isz), ir.ptrtoint(cg.B, base, cg.T_isz));
    let dead = cg.new_block("badgoto");
    let vs = u.newn.[u64](ls.len + 1);
    let bs = u.newn.[*mut ir.Block](ls.len + 1);
    for i in 0..ls.len {
        vs[i] = ls[i].value;
        bs[i] = label_block(ls[i]);
    }
    flow.switch_to(k, false, vs[0..ls.len], bs[0..ls.len], dead);
    cg.at_end(dead);
    ir.unreachable(cg.B);
}

// `({ ... })` (a GNU dialect): its block, and the value of its last
// statement, an expression's (or none); the objects of the block with
// cleanups are cleaned up after it is computed (a structure's value
// copied first).
fn stmt_expr(e: *mut cast.Expr) *mut ir.Value {
    let s = e.body;
    let d = gv.depth();
    let xs = s.items.items();
    let sc = cdbg.open_block(xs);
    let mut v = ir.vnil();
    for i in 0..xs.len {
        let x = xs[i];
        if (i + 1 == xs.len) and u.notnil(css.value_stmt(x)) and not cty.is_void(e.ty) {
            v = last_value(x);
            if cty.is_record(e.ty) and (gv.depth() > d) {
                let tmp = cg.alloca(e.ty, "stmtexpr");
                gx.copy(e.ty, tmp, v);
                v = tmp;
            }
            continue;
        }
        stmt(x);
    }
    gv.leave(d);
    cdbg.close_scope(sc);
    cg.continue_after();
    if u.isnil(v) and not cty.is_void(e.ty) {
        // (the block ended in a jump: the value is never used)
        if cty.is_record(e.ty) {
            return cg.alloca(e.ty, "stmtexpr");
        }
        return ir.czero(cg.lty(e.ty));
    }
    return v;
}

// The labels of statement s, then the value of its expression statement
// (a statement expression's last: css.value_stmt).
fn last_value(s: *mut cast.Stmt) *mut ir.Value {
    cg.set_span(s.span);
    if s.kind == cast.StmtKind.LABEL {
        let b = label_block(s.sym);
        cg.br(b);
        cg.at_end(b);
        return last_value(s.body);
    }
    if (s.kind == cast.StmtKind.CASE) or (s.kind == cast.StmtKind.DEFAULT) {
        let b = BD.cases.get(u.addr_key(@int_from_ptr(s)));
        cg.br(b);
        cg.at_end(b);
        return last_value(s.body);
    }
    cg.continue_after();
    return gx.rv(s.e);
}

fn label_block(l: *mut cast.CSym) *mut ir.Block {
    if u.isvnil(l.ir) {
        l.ir = @ptr_cast(*mut void, cg.new_block(l.name));
    }
    return @ptr_cast(*mut ir.Block, l.ir);
}

// Have declaration specifiers ds a typeof of a variably modified type?
fn has_vm_typeof(ds: *cast.DeclSpec) bool {
    for s in ds.items.items() {
        if s.kind == cast.SpecKind.TYPEOF {
            if u.notnil(s.tname) and u.notnil(s.tname.ty) and cty.is_vm(s.tname.ty) {
                return true;
            }
            if u.isnil(s.tname) and u.notnil(s.e) and u.notnil(s.e.ty) and cty.is_vm(s.e.ty) {
                return true;
            }
        }
    }
    return false;
}

fn decl(d: *mut cast.Decl) void {
    if d.kind != cast.DeclKind.DECL {
        return;
    }
    cdbg.note_block_decl(d);
    if (d.decls.len > 0) and has_vm_typeof(d.specs) {
        cg.continue_after();
        gv.eval_specs(d.specs, gx.rv, gx.effects);
    }
    for x in d.decls.items() {
        let s = x.sym;
        if u.notnil(x.ty) and cty.is_vm(x.ty) and not cty.is_func(x.ty) {
            cg.continue_after();
            gv.eval_declarator(x, x.ty, gx.rv);
        }
        if u.isnil(s) or (s.kind != cast.SK_OBJECT) or (s.duration != cast.SD_AUTO) {
            continue;
        }
        if svla.allocates(s) {
            cg.continue_after();
            let p = gv.allocate(s.ty, cg.object_align(s));
            s.ir = @ptr_cast(*mut void, p);
            // (its address in an object of its own: -O0 keeps it there, for debuggers)
            let a = cg.alloca(cty.pointer_to(s.ty.elem), "vla.addr");
            _ = ir.store(cg.B, p, a);
            cdbg.note_indirect(cg.F.f, s, a);
            if u.notnil(s.init) {
                _ = ir.memop(cg.B, ir.OP_MEMSET, p, ir.cint(cg.T_i8, 0), gv.size_value(s.ty));  // (C23: `= {}`)
            }
            push_cleanup(s);
            continue;
        }
        if u.isvnil(s.ir) {
            s.ir = @ptr_cast(*mut void, cg.aligned_alloca(s.ty, s.name, s.align));
            cdbg.note_var(cg.F.f, s, @ptr_cast(*mut ir.Value, s.ir));
        }
        if u.notnil(s.init) {
            cg.continue_after();
            init_local(s, @ptr_cast(*mut ir.Value, s.ir));
        }
        push_cleanup(s);
    }
}

// An automatic object with a cleanup (a GNU dialect) comes in scope.
fn push_cleanup(s: *cast.CSym) void {
    let n = cgn.note_of(s);
    if u.notnil(n) and u.notnil(n.cleanup_call) {
        gv.push_cleanup(n.cleanup_call);
    }
}

// Stores automatic object s's initializer at p.
fn init_local(s: *mut cast.CSym, p: *mut ir.Value) void {
    let list = s.init;
    let vol = volatile_of(s.ty);
    if list.zero {
        gx.zero(p, cty.size_of(s.ty));
    }
    for k in 0..list.items.len {
        let it = list.items.at(k);
        let at = ir.ptradd(cg.B, p, cg.usz(it.off));
        let t = it.ty;
        if u.isnil(it.e) {
            gx.zero(at, cty.size_of(t));
        } else if t.kind == cty.TK_ARRAY {
            // a string literal: its code units, then zeros
            let es = cty.size_of(t.elem);
            let mut n = @as(u64, it.e.tok.units.len) + 1;
            if n > t.len {
                n = t.len;
            }
            if not list.zero and (n < t.len) {
                gx.zero(at, t.len * es);
            }
            _ = ir.memop(cg.B, ir.OP_MEMCPY, at, cg.string_addr(it.e), cg.usz(n * es));
        } else if cty.is_wide(t) or cty.is_dec128(t) {
            gld.copy(at, gx.full(it.e), (vol != 0) or ((t.quals & cty.Q_VOLATILE) != 0));
        } else if cty.is_wint(t) and u.isnil(it.bits) {
            cgw.copy(t, at, gx.full(it.e), (vol != 0) or ((t.quals & cty.Q_VOLATILE) != 0));
        } else if cty.is_record(t) {
            gx.copy(t, at, gx.full(it.e));
        } else if u.notnil(it.bits) {
            _ = cgb.store(it.bits, cty.qualify(t, vol), gx.full(it.e), at);
        } else {
            // (a volatile object's initialization is a volatile access too)
            gx.store(cty.qualify(t, vol), gx.full(it.e), at);
        }
    }
}

// The volatile qualifier of t or of its elements.
fn volatile_of(t: *cty.CType) i32 {
    if t.kind == cty.TK_ARRAY {
        return volatile_of(t.elem);
    }
    return t.quals & cty.Q_VOLATILE;
}

fn if_stmt(s: *mut cast.Stmt) void {
    cg.continue_after();
    let yes = cg.new_block("then");
    let done = cg.new_block("endif");
    let mut no = done;
    if u.notnil(s.els) {
        no = cg.new_block("else");
    }
    gx.branch_full(s.e, yes, no);
    cg.at_end(yes);
    stmt(s.body);
    cg.br(done);
    if u.notnil(s.els) {
        cg.at_end(no);
        stmt(s.els);
        cg.br(done);
    }
    cg.at_end(done);
}

fn while_stmt(s: *mut cast.Stmt) void {
    let head = cg.new_block("while");
    let body = cg.new_block("body");
    let done = cg.new_block("endwhile");
    cg.br(head);
    cg.at_end(head);
    gx.branch_full(s.e, body, done);
    cg.at_end(body);
    BD.jumps.push(Jump.{ brk: done, cont: head, brk_depth: gv.depth(), cont_depth: gv.depth() });
    stmt(s.body);
    _ = BD.jumps.pop();
    cg.br(head);
    cg.at_end(done);
}

fn do_stmt(s: *mut cast.Stmt) void {
    let body = cg.new_block("do");
    let cond = cg.new_block("dotest");
    let done = cg.new_block("enddo");
    cg.br(body);
    cg.at_end(body);
    BD.jumps.push(Jump.{ brk: done, cont: cond, brk_depth: gv.depth(), cont_depth: gv.depth() });
    stmt(s.body);
    _ = BD.jumps.pop();
    cg.br(cond);
    cg.at_end(cond);
    gx.branch_full(s.e, body, done);
    cg.at_end(done);
}

fn for_stmt(s: *mut cast.Stmt) void {
    let d0 = gv.depth();
    let sc = cdbg.open_for(s.decl);
    if u.notnil(s.decl) {
        decl(s.decl);
    } else if u.notnil(s.first) {
        cg.continue_after();
        _ = gx.full(s.first);
    }
    let d1 = gv.depth();
    let head = cg.new_block("for");
    let body = cg.new_block("body");
    let step = cg.new_block("step");
    let done = cg.new_block("endfor");
    // (the loop's end leaves the scope of the variable length arrays its
    // first clause declares)
    let mut exit = done;
    if d1 > d0 {
        exit = cg.new_block("forexit");
    }
    cg.br(head);
    cg.at_end(head);
    if u.notnil(s.e) {
        gx.branch_full(s.e, body, exit);
    } else {
        ir.br(cg.B, body);
    }
    cg.at_end(body);
    BD.jumps.push(Jump.{ brk: done, cont: step, brk_depth: d0, cont_depth: d1 });
    stmt(s.body);
    _ = BD.jumps.pop();
    cg.br(step);
    cg.at_end(step);
    if u.notnil(s.step) {
        _ = gx.full(s.step);
    }
    cg.br(head);
    if d1 > d0 {
        cg.at_end(exit);
        gv.leave(d0);
        cg.br(done);
    }
    cdbg.close_scope(sc);
    cg.at_end(done);
}

fn switch_stmt(s: *mut cast.Stmt) void {
    cg.continue_after();
    let v = gx.full(s.e);
    if cty.is_wint(s.e.ty) {
        wide_switch(s, v);
        return;
    }
    let done = cg.new_block("endswitch");
    let mut dflt = done;
    let blocks = u.newn.[*mut ir.Block](s.cases.len + 1);
    for i in 0..s.cases.len {
        let c = s.cases.get(i);
        let b = cg.new_block(u.pick(c.kind == cast.StmtKind.CASE, "case", "default"));
        blocks[i] = b;
        BD.cases.put(u.addr_key(@int_from_ptr(c)), b);
        if c.kind == cast.StmtKind.DEFAULT {
            dflt = b;
        }
    }
    let mut vs = u.List.[u64].empty();
    let mut bs = u.List.[*mut ir.Block].empty();
    let mask = ~@as(u64, 0) >> @int_cast(u32, 64 - v.ty.bits);
    for i in 0..s.cases.len {
        let c = s.cases.get(i);
        if (c.kind == cast.StmtKind.CASE) and u.notnil(c.hi) {
            // a case range (a GNU dialect): its values, if few; else a test first
            let span = (c.cval_hi -% c.cval) & mask;
            if span < 256 {
                for k in 0..span + 1 {
                    vs.push((c.cval +% k) & mask);
                    bs.push(blocks[i]);
                }
            } else {
                let next = cg.new_block("range");
                let d = ir.sub(cg.B, v, ir.cint(v.ty, c.cval & mask));
                ir.condbr(cg.B, ir.icmp(cg.B, ir.IntULE, d, ir.cint(v.ty, span)), blocks[i], next);
                cg.at_end(next);
            }
        } else if c.kind == cast.StmtKind.CASE {
            vs.push(c.cval & mask);
            bs.push(blocks[i]);
        }
    }
    flow.switch_to(v, s.e.ty.is_signed, vs.items(), bs.items(), dflt);
    cg.at_end(cg.new_block("switchbody"));
    BD.jumps.push(Jump.{ brk: done, cont: u.nil.[ir.Block](), brk_depth: gv.depth(), cont_depth: gv.depth() });
    stmt(s.body);
    _ = BD.jumps.pop();
    cg.br(done);
    cg.at_end(done);
}

// A switch on a value v wider than 64 bits (its address): for each value of
// the limbs above the first that some case has, a comparison of those, then
// a switch on the first limb among those cases (csema_stmt.wide_case: no
// ranges).
fn wide_switch(s: *mut cast.Stmt, v: *mut ir.Value) void {
    let t = s.e.ty;
    let n = cty.limbs(t);
    let done = cg.new_block("endswitch");
    let mut dflt = done;
    let nc = s.cases.len;
    let blocks = u.newn.[*mut ir.Block](nc + 1);
    let vals = u.newn.[[]u64](nc + 1);
    for i in 0..nc {
        let c = s.cases.get(i);
        let b = cg.new_block(u.pick(c.kind == cast.StmtKind.CASE, "case", "default"));
        blocks[i] = b;
        BD.cases.put(u.addr_key(@int_from_ptr(c)), b);
        if c.kind == cast.StmtKind.DEFAULT {
            dflt = b;
        } else {
            vals[i] = cw.value(c.e, n);
        }
    }
    let lo = cgw.limb(v, 0);
    let mut seen = u.List.[usize].empty();  // (a case of each group: its first)
    for i in 0..nc {
        if s.cases.get(i).kind != cast.StmtKind.CASE {
            continue;
        }
        let mut grouped = false;
        for j in seen.items() {
            if same_upper(vals[i], vals[j], n) {
                grouped = true;
            }
        }
        if grouped {
            continue;
        }
        seen.push(i);
        // the limbs above the first equal to this group's?
        let mut d = ir.cint(ir.t_int(64), 0);
        for k in 1..n {
            d = ir.or_(cg.B, d, ir.xor(cg.B, cgw.limb(v, k), ir.cint(ir.t_int(64), vals[i][k])));
        }
        let yes = cg.new_block("wcase");
        let no = cg.new_block("wnext");
        ir.condbr(cg.B, ir.icmp(cg.B, ir.IntEQ, d, ir.cint(ir.t_int(64), 0)), yes, no);
        cg.at_end(yes);
        let mut vs = u.List.[u64].empty();
        let mut bs = u.List.[*mut ir.Block].empty();
        for k in i..nc {
            if (s.cases.get(k).kind == cast.StmtKind.CASE) and same_upper(vals[k], vals[i], n) {
                vs.push(vals[k][0]);
                bs.push(blocks[k]);
            }
        }
        flow.switch_to(lo, false, vs.items(), bs.items(), dflt);
        cg.at_end(no);
    }
    cg.br(dflt);
    cg.at_end(cg.new_block("switchbody"));
    BD.jumps.push(Jump.{ brk: done, cont: u.nil.[ir.Block](), brk_depth: gv.depth(), cont_depth: gv.depth() });
    stmt(s.body);
    _ = BD.jumps.pop();
    cg.br(done);
    cg.at_end(done);
}

// Are the limbs of a and b above the first the same?
fn same_upper(a: []u64, b: []u64, n: usize) bool {
    for k in 1..n {
        if a[k] != b[k] {
            return false;
        }
    }
    return true;
}

fn return_stmt(s: *mut cast.Stmt) void {
    let F = cg.F;
    cg.continue_after();
    if u.isnil(s.e) {
        cleanups();
        gva.ret_default(F.sig.plan, F.sret);
        return;
    }
    let mut v = gx.full(s.e);
    if cty.is_void(F.ret) {
        cleanups();
        ir.ret_void(cg.B);
        return;
    }
    if gv.has_cleanups() and (cty.is_record(F.ret) or cty.is_wint(F.ret)) {
        // (the value copied before the cleanups run)
        let tmp = cg.alloca(F.ret, "retval");
        gx.copy(F.ret, tmp, v);
        v = tmp;
    }
    cleanups();
    gva.ret_value(F.sig.plan, F.sret, v);
}

// Before a return: the calls of the cleanups in scope (a GNU dialect).
fn cleanups() void {
    if gv.has_cleanups() {
        gv.release_to(0);
        cg.continue_after();
    }
}
