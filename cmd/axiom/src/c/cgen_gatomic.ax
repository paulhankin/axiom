// =============================================================================
// cgen_gatomic.ax - IR generation for the GNU dialects' atomic builtins
// (`__sync_...`, `__atomic_...`: csema_gbuiltin.ax types them) on the IR's
// atomic operations, all sequentially consistent: a load or store marked
// F_ATOMIC, OP_RMW (exchange, add, sub, and, or, xor), OP_CMPXCHG, OP_FENCE.
// A pointer is operated on as an integer of its width; nand, which the IR
// has no RMW for, is a compare-and-swap loop; the generic forms (of any
// object of 1, 2, 4 or 8 bytes) move the value as an integer of its size.
// =============================================================================
import "../ir.ax" as ir;
import "../util.ax" as u;
import "cast.ax" as cast;
import "cgen.ax" as cg;
import "csema_gbuiltin.ax" as gb;
import "ctypes.ax" as cty;

fn B() *mut ir.Builder {
    return cg.B;
}

// The IR integer type an atomic operation on objects of type t uses.
fn int_ty(t: *cty.CType) *mut ir.Ty {
    return ir.t_int(@truncate(i32, cty.size_of(t) * 8));
}

// v (of C type t: an integer or pointer) as an integer of t's width.
fn as_int(v: *mut ir.Value, t: *cty.CType) *mut ir.Value {
    if cty.is_pointer(t) {
        return ir.ptrtoint(B(), v, int_ty(t));
    }
    return v;
}

// Integer v as a value of C type t.
fn from_int(v: *mut ir.Value, t: *cty.CType) *mut ir.Value {
    if cty.is_pointer(t) {
        return ir.inttoptr(B(), v);
    }
    return v;
}

fn atomic_load(t: *mut ir.Ty, p: *mut ir.Value) *mut ir.Value {
    let v = ir.load(B(), t, p);
    v.align = @truncate(u32, t.size);
    v.flags = v.flags | ir.F_ATOMIC | ir.F_VOLATILE;
    return v;
}

fn atomic_store(v: *mut ir.Value, p: *mut ir.Value) void {
    let s = ir.store(B(), v, p);
    s.align = @truncate(u32, v.ty.size);
    s.flags = s.flags | ir.F_ATOMIC | ir.F_VOLATILE;
}

// The plain operation `op` (an RMW_ number, or gb.OP_NAND) of integers x and y.
fn apply(op: u64, x: *mut ir.Value, y: *mut ir.Value) *mut ir.Value {
    if op == @as(u64, @bit_cast(u32, ir.RMW_ADD)) {
        return ir.add(B(), x, y);
    }
    if op == @as(u64, @bit_cast(u32, ir.RMW_SUB)) {
        return ir.sub(B(), x, y);
    }
    if op == @as(u64, @bit_cast(u32, ir.RMW_AND)) {
        return ir.and_(B(), x, y);
    }
    if op == @as(u64, @bit_cast(u32, ir.RMW_OR)) {
        return ir.or_(B(), x, y);
    }
    if op == @as(u64, @bit_cast(u32, ir.RMW_XOR)) {
        return ir.xor(B(), x, y);
    }
    return ir.xor(B(), ir.and_(B(), x, y), ir.cint(x.ty, 0xFFFF_FFFF_FFFF_FFFF));  // nand
}

// The atomic read-modify-write `op` of the integer at p with v: the old value.
fn rmw(op: u64, p: *mut ir.Value, v: *mut ir.Value) *mut ir.Value {
    if op != gb.OP_NAND {
        return ir.rmw(B(), @truncate(i32, @bit_cast(i64, op)), p, v);
    }
    // nand: a compare-and-swap loop
    let head = cg.new_block("nand");
    let done = cg.new_block("nanddone");
    let start = ir.insert_block(B());
    let first = atomic_load(v.ty, p);
    ir.br(B(), head);
    cg.at_end(head);
    let old = ir.phi(B(), v.ty);
    ir.add_incoming(old, first, start);
    let seen = ir.cmpxchg(B(), p, old, apply(op, old, v));
    ir.add_incoming(old, seen, head);
    ir.condbr(B(), ir.icmp(B(), ir.IntEQ, seen, old), done, head);
    cg.at_end(done);
    return seen;
}

/// The value of atomic builtin call e (e.op: gb.GB_ATOMIC + an A_ kind;
/// e.cval: the RMW operation) with argument values vs.
pub fn gen(e: *mut cast.Expr, vs: []mut *mut ir.Value) *mut ir.Value {
    let k = e.op - gb.GB_ATOMIC;
    if k == gb.A_FENCE {
        ir.fence(B());
        return ir.vnil();
    }
    let p = vs[0];
    let t = cty.unqual(e.args.get(0).ty.elem);
    let it = int_ty(t);
    if (k == gb.A_FETCH_OP) or (k == gb.A_OP_FETCH) {
        let v = resize(vs[1], it);
        let old = rmw(e.cval, p, v);
        if k == gb.A_FETCH_OP {
            return from_int(old, t);
        }
        return from_int(apply(e.cval, old, v), t);
    }
    if k == gb.A_XCHG {
        return from_int(ir.rmw(B(), ir.RMW_XCHG, p, as_int(vs[1], t)), t);
    }
    if (k == gb.A_CAS_BOOL) or (k == gb.A_CAS_VAL) {
        let ex = as_int(vs[1], t);
        let old = ir.cmpxchg(B(), p, ex, as_int(vs[2], t));
        if k == gb.A_CAS_VAL {
            return from_int(old, t);
        }
        return ir.zext(B(), ir.icmp(B(), ir.IntEQ, old, ex), cg.T_i8);
    }
    if k == gb.A_LOAD {
        return from_int(atomic_load(it, p), t);
    }
    if k == gb.A_STORE {
        atomic_store(as_int(vs[1], t), p);
        return ir.vnil();
    }
    if k == gb.A_RELEASE {
        atomic_store(ir.cint(it, 0), p);
        return ir.vnil();
    }
    if k == gb.A_TEST_SET {
        let old = ir.rmw(B(), ir.RMW_XCHG, p, ir.cint(cg.T_i8, 1));
        return ir.zext(B(), ir.icmp(B(), ir.IntNE, old, ir.cint(cg.T_i8, 0)), cg.T_i8);
    }
    if k == gb.A_CLEAR {
        atomic_store(ir.cint(cg.T_i8, 0), p);
        return ir.vnil();
    }
    if k == gb.A_CMPXCHG {
        // (*expected gets the value found: on success, the one it had)
        let ep = vs[1];
        let ex = load_int(it, ep);
        let old = ir.cmpxchg(B(), p, ex, as_int(vs[2], t));
        store_int(old, ep);
        return ir.zext(B(), ir.icmp(B(), ir.IntEQ, old, ex), cg.T_i8);
    }
    // the generic forms
    if k == gb.A_LOAD_G {
        store_int(atomic_load(it, p), vs[1]);
        return ir.vnil();
    }
    if k == gb.A_STORE_G {
        atomic_store(load_int(it, vs[1]), p);
        return ir.vnil();
    }
    if k == gb.A_XCHG_G {
        store_int(ir.rmw(B(), ir.RMW_XCHG, p, load_int(it, vs[1])), vs[2]);
        return ir.vnil();
    }
    // A_CMPXCHG_G (p, expected *, desired *)
    let ex = load_int(it, vs[1]);
    let old = ir.cmpxchg(B(), p, ex, load_int(it, vs[2]));
    store_int(old, vs[1]);
    return ir.zext(B(), ir.icmp(B(), ir.IntEQ, old, ex), cg.T_i8);
}

fn resize(v: *mut ir.Value, t: *mut ir.Ty) *mut ir.Value {
    if v.ty.kind == ir.T_PTR {
        return ir.ptrtoint(B(), v, t);
    }
    if v.ty.bits > t.bits {
        return ir.trunc(B(), v, t);
    }
    if v.ty.bits < t.bits {
        return ir.sext(B(), v, t);
    }
    return v;
}

// The integer of type t at p, a plain load (aligned as its size need not be).
fn load_int(t: *mut ir.Ty, p: *mut ir.Value) *mut ir.Value {
    let v = ir.load(B(), t, p);
    v.align = 1;
    return v;
}

fn store_int(v: *mut ir.Value, p: *mut ir.Value) void {
    let s = ir.store(B(), v, p);
    s.align = 1;
}
