// -----------------------------------------------------------------------------
// Shared internal helpers
// -----------------------------------------------------------------------------

fn is_err(e: *cast.Expr) bool {
    return u.isnil(e.ty) or (e.ty.kind == cty.TK_ERROR);
}

fn bad_expr(e: *mut cast.Expr) *mut cast.Expr {
    e.ty = cty.t_error;
    e.lvalue = false;
    return e;
}

fn bad_true(e: *mut cast.Expr) bool {
    e.ty = cty.t_error;
    e.lvalue = false;
    return true;
}

fn add_once(l: *mut u.List.[*mut cast.CSym], s: *mut cast.CSym) void {
    for x in l.items() {
        if x == s {
            return;
        }
    }
    l.push(s);
}

fn string_value(x: *cast.Expr) ?[]u8 {
    let mut s = x;
    if (s.kind == cast.ExprKind.CAST) and u.notnil(s.a) {
        s = s.a;
    }
    if (s.kind != cast.ExprKind.STRING) or u.isnil(s.tok) or (s.tok.prefix != 0) {
        return .none;
    }
    let mut b = u.Buf.init();
    for c in s.tok.units {
        if (c == 0) or (c > 0x7f) {
            return .none;
        }
        b.c(@truncate(u8, c));
    }
    return .some(b.done());
}

fn u8_pick(c: bool, a: u8, b: u8) u8 {
    if c {
        return a;
    }
    return b;
}

fn kind_word(k: i32) []u8 {
    if k == cty.TK_STRUCT {
        return "struct";
    }
    if k == cty.TK_UNION {
        return "union";
    }
    return "enum";
}
// -----------------------------------------------------------------------------
// State
// -----------------------------------------------------------------------------

// An identifier bound in a scope: an ordinary identifier's CSym, or a tag's type.
struct Bind {
    name: []u8,
    sym: ?*mut cast.CSym,
    tag: ?*mut cty.CType,
    level: i32,
    prev: i32,  // the binding it hides (index + 1), or 0
}

// One name space: its bindings, innermost last, and each name's innermost.
nocopy struct Space {
    binds: u.List.[Bind],
    names: u.SymMap.[i32],
}

fn new_space() Space {
    return Space.{ binds: u.List.[Bind].empty(),
                   names: u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 } };
}

nocopy struct State {
    o: *co.COptions,
    ordinary: Space,
    tags: Space,
    level: i32,  // 0: file scope
    linked: u.SymMap.[?*mut cast.CSym],  // the entities with linkage, by name
    unit: *mut CUnit,
    next_uid: i32,
    cur_fn: ?*mut cast.CSym,      // the function whose body is being analyzed
    internal_uses: u.List.[Use],  // functions with internal linkage used before their definition
    unevaluated: i32,             // inside the operand of sizeof or _Alignof
}

// A function used in an expression (6.9p3), and where.
struct Use {
    sym: *mut cast.CSym,
    span: u.Span,
}

/// Identifier s is used at sp in an expression: one with internal linkage
/// must then be defined in the unit (6.9p3), which is checked at its end.
pub fn used_at(s: *mut cast.CSym, sp: u.Span) void {
    if (s.kind == cast.SK_FUNC) and (s.linkage == cast.LK_INTERNAL) and not s.defined and (S.unevaluated == 0) {
        S.internal_uses.push(Use.{ sym: s, span: sp });
    }
}

/// Enters (+1) or leaves (-1) the operand of sizeof or _Alignof, whose
/// identifiers are not used in the sense of 6.9p3.
pub fn unevaluated(delta: i32) void {
    S.unevaluated += delta;
}

let mut S: *mut State = @ptr_from_int(*mut State, 0);
// The units of a build number their symbols on from the previous unit's
// last (uids are unique in the program: internal names cannot clash).
let mut g_uid_base: i32 = 0;

/// The options of the translation unit.
pub fn opts() *co.COptions {
    return S.o;
}

/// The standard in force.
pub fn std() i32 {
    return S.o.std;
}

/// The unit being analyzed.
pub fn unit() *mut CUnit {
    return S.unit;
}

// -----------------------------------------------------------------------------
// Diagnostics
// -----------------------------------------------------------------------------

/// Reports a constraint violation.
pub fn err(sp: u.Span, code: []u8, msg: []u8) void {
    _ = dg.err(sp, code, msg);
}

/// Reports a constraint violation about a declaration, with a note at the
/// one it conflicts with.
pub fn err_note(sp: u.Span, code: []u8, msg: []u8, other: u.Span, note: []u8) void {
    let d = dg.err(sp, code, msg);
    dg.note(d, other, note);
}

pub fn warn(sp: u.Span, code: []u8, msg: []u8) void {
    _ = dg.warning(sp, code, msg);
}

/// Reports a feature this implementation does not support (C3901).
pub fn not_supported(sp: u.Span, what: []u8) void {
    _ = dg.err(sp, "C3901", u.cat2(what, " is not supported"));
}

/// A type for messages: 'int *'.
pub fn tq(t: *cty.CType) []u8 {
    return u.cat3("'", cty.type_str(t), "'");
}

// -----------------------------------------------------------------------------
// Scopes
// -----------------------------------------------------------------------------

/// The depth of the current scope (0: file scope).
pub fn level() i32 {
    return S.level;
}

pub fn at_file_scope() bool {
    return S.level == 0;
}

pub fn push_scope() void {
    S.level += 1;
}

fn pop_space(sp: *mut Space, lv: i32) void {
    while (sp.binds.len > 0) and (sp.binds.at(sp.binds.len - 1).level >= lv) {
        let b = sp.binds.pop();
        sp.names.put(b.name, b.prev);
    }
}

/// Leaves the current scope: its bindings are forgotten.
pub fn pop_scope() void {
    pop_space(&mut S.ordinary, S.level);
    pop_space(&mut S.tags, S.level);
    S.level -= 1;
}

fn bind(sp: *mut Space, name: []u8, sym: ?*mut cast.CSym, tag: ?*mut cty.CType) void {
    let prev = sp.names.get(name);
    sp.binds.push(Bind.{ name: name, sym: sym, tag: tag, level: S.level, prev: prev });
    sp.names.put(name, @int_cast(i32, sp.binds.len));
}

fn innermost(sp: *mut Space, name: []u8) ?*mut Bind {
    let k = sp.names.get(name);
    if k == 0 {
        return .none;
    }
    return .some(sp.binds.at_mut(@int_cast(usize, k - 1)));
}

/// Notes that asm text a names `n`, if that is a function or object of
/// internal linkage (or a block's static object) visible here: it is used,
/// and the backend resolves the name in the text to its symbol (a.statics).
pub fn asm_static(a: *mut cast.Asm, n: []u8) void {
    let s = lookup(n) ?? return;
    if (s.kind != cast.SK_FUNC) and (s.kind != cast.SK_OBJECT) {
        return;
    }
    let internal = (s.linkage == cast.LK_INTERNAL) or
                   ((s.kind == cast.SK_OBJECT) and (s.duration == cast.SD_STATIC) and (s.linkage != cast.LK_EXTERNAL));
    if not internal {
        return;
    }
    s.used = true;
    for x in a.statics.items() {
        if x == s {
            return;
        }
    }
    a.statics.push(s);
}

/// The ordinary identifier `name` as seen here, or .none.
pub fn lookup(name: []u8) ?*mut cast.CSym {
    let b = innermost(&mut S.ordinary, name) ?? return .none;
    return b.sym;
}

/// The ordinary identifier `name` if declared in the current scope, or .none.
pub fn lookup_here(name: []u8) ?*mut cast.CSym {
    let b = innermost(&mut S.ordinary, name) ?? return .none;
    if b.level != S.level {
        return .none;
    }
    return b.sym;
}

/// Binds ordinary identifier `name` to s in the current scope.
pub fn declare(name: []u8, s: *mut cast.CSym) void {
    bind(&mut S.ordinary, name, .some(s), .none);
}

/// The tag `name` as seen here (its type), or .none.
pub fn lookup_tag(name: []u8) ?*mut cty.CType {
    let b = innermost(&mut S.tags, name) ?? return .none;
    return b.tag;
}

/// The tag `name` if declared in the current scope, or .none.
pub fn lookup_tag_here(name: []u8) ?*mut cty.CType {
    let b = innermost(&mut S.tags, name) ?? return .none;
    if b.level != S.level {
        return .none;
    }
    return b.tag;
}

/// Binds tag `name` to type t in the current scope.
pub fn declare_tag(name: []u8, t: *mut cty.CType) void {
    bind(&mut S.tags, name, .none, .some(t));
}

// -----------------------------------------------------------------------------
// Symbols and linkage
// -----------------------------------------------------------------------------

/// A new symbol.
pub fn new_sym(kind: i32, name: []u8, sp: u.Span, t: *mut cty.CType) *mut cast.CSym {
    let s = u.new.[cast.CSym]();
    s.kind = kind;
    s.name = name;
    s.span = sp;
    s.ty = t;
    S.next_uid += 1;
    s.uid = S.next_uid;
    return s;
}

/// The entity with linkage named `name` declared anywhere in the unit so far, or .none.
pub fn linked(name: []u8) ?*mut cast.CSym {
    return S.linked.get(name);
}

pub fn set_linked(name: []u8, s: *mut cast.CSym) void {
    S.linked.put(name, .some(s));
}

/// The linkage of a declaration of `name` (6.2.2) with storage-class
/// specifier `sc` (a cast.SC_ bit or 0) of a function (is_fn) or object:
/// LK_INTERNAL for `static` at file scope; the linkage of a prior visible
/// declaration for `extern` (and for functions without one); else external
/// at file scope, and none in a block.
pub fn linkage_of(name: []u8, sc: i32, is_fn: bool) i32 {
    if at_file_scope() and (sc == cast.SC_STATIC) {
        return cast.LK_INTERNAL;
    }
    if (sc == cast.SC_EXTERN) or (is_fn and (sc == 0)) {
        if let .some(prior) = lookup(name) {
            if ((prior.kind == cast.SK_OBJECT) or (prior.kind == cast.SK_FUNC)) and (prior.linkage != cast.LK_NONE) {
                return prior.linkage;
            }
        }
        return cast.LK_EXTERNAL;
    }
    if at_file_scope() {
        return cast.LK_EXTERNAL;
    }
    return cast.LK_NONE;
}

/// Declares `name` as C89 does a function called without a declaration:
/// `extern int name();` in the current scope.
pub fn implicit_function(name: []u8, sp: u.Span) void {
    let mut os: ?*mut cast.CSym = .none;
    if let .some(prev) = linked(name) {
        if prev.kind == cast.SK_FUNC {
            os = .some(prev);
        }
    }
    let mut s = u.nil.[cast.CSym]();
    if let .some(prev) = os {
        s = prev;
    } else {
        s = new_sym(cast.SK_FUNC, name, sp, cty.function(cty.t_int, [], false, false));
        s.linkage = cast.LK_EXTERNAL;
        set_linked(name, s);
    }
    declare(name, s);
}

/// The function whose body is being analyzed, or .none.
pub fn cur_fn() ?*mut cast.CSym {
    return S.cur_fn;
}

pub fn set_cur_fn(f: ?*mut cast.CSym) void {
    S.cur_fn = f;
}

// -----------------------------------------------------------------------------
// The walk
// -----------------------------------------------------------------------------

/// Analyzes the translation unit `t` under options `o`. Errors are reported through diag.ax; the
/// unit is complete enough to walk either way, but only one without errors
/// is the typed tree described above.
fn run_unit(t: *mut cast.Unit, o: *co.COptions) *mut CUnit {
    cty.init(o);
    S = u.new.[State]();
    S.o = o;
    S.ordinary = new_space();
    S.tags = new_space();
    S.linked = u.SymMap.[?*mut cast.CSym].{ keys: u.nil.[usize](), vals: u.nil.[?*mut cast.CSym](), cap: 0, len: 0 };
    S.unit = u.new.[CUnit]();
    S.next_uid = g_uid_base;
    for d in t.decls.items() {
        external(d);
    }
    // (6.9p3: a function with internal linkage used is defined; reported at its first use)
    let mut told = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    for &x in S.internal_uses.items() {
        let k = u.addr_key(@int_from_ptr(x.sym));
        if not x.sym.defined and (told.get(k) == 0) {
            told.put(k, 1);
            err_note(x.span, "C3045", u.f1("the function '%s' has internal linkage and is used, but is not defined",
                                           x.sym.name), x.sym.span, "declared here");
        }
    }
    // tentative definitions with no definition are definitions with a zero
    // initializer (6.9.2p2): an array without a length gets one element
    for s in S.unit.objects.items() {
        if s.tentative and not s.defined {
            s.defined = true;
            if (s.ty.kind == cty.TK_ARRAY) and not s.ty.has_len {
                s.ty = cty.qualify(cty.array_of(s.ty.elem, 1, true), s.ty.quals);
            }
            if not cty.is_complete(s.ty) {
                err(s.span, "C3007", u.f2("the definition of '%s' has incomplete type %s", s.name, tq(s.ty)));
            }
        }
    }
    // (file-scope asm may name a static function or object declared after it)
    for a in S.unit.asm_tops.items() {
        let tx = a.tmpl;
        let mut i: usize = 0;
        while i < tx.len {
            if (tx[i] == '_') or (u.is_alnum(tx[i]) and not u.is_digit(tx[i])) {
                let st = i;
                while (i < tx.len) and (u.is_alnum(tx[i]) or (tx[i] == '_') or (tx[i] == '.') or (tx[i] == '$')) {
                    i += 1;
                }
                asm_static(a, u.intern(tx[st..i]));
                continue;
            }
            i += 1;
        }
    }
    // (the names asm text uses: csema_asm.ax)
    for n in S.unit.asm_names.items() {
        if let .some(x) = linked(n) {
            x.used = true;
        }
    }
    // the external names the unit uses and does not define
    let lk = S.linked;
    for i in 0..lk.cap {
        if @slice_from_ptr(lk.keys, lk.cap)[i] == 0 {
            continue;
        }
        if let .some(x) = @slice_from_ptr(lk.vals, lk.cap)[i] {
            if (x.linkage == cast.LK_EXTERNAL) and x.used and not x.defined and
               ((x.kind == cast.SK_FUNC) or (x.kind == cast.SK_OBJECT)) {
                S.unit.refs.push(x.name);
            }
        }
    }
    // (in the order of their names: the map's order is its keys' addresses')
    u.sort.[[]u8](S.unit.refs.items_mut(), u.str_cmp);
    g_uid_base = S.next_uid;
    return S.unit;
}

/// Adds a defined function to the unit.
/// Takes function s out of the unit's definitions (csema_decl: an inline
/// definition that is not used).
pub fn drop_function(s: *mut cast.CSym) void {
    let mut kept = u.List.[*mut cast.CSym].empty();
    for f in S.unit.funcs.items() {
        if f != s {
            kept.push(f);
        }
    }
    S.unit.funcs = kept;
    if S.unit.main == s {
        S.unit.main = u.nil.[cast.CSym]();
    }
}

pub fn add_function(s: *mut cast.CSym) void {
    S.unit.funcs.push(s);
    if u.str_eq(s.name, "main") and (s.linkage == cast.LK_EXTERNAL) {
        S.unit.main = s;
    }
}

/// Adds a function or object declared an alias of another (the attribute
/// alias: csema_gnu.ax) to the unit, once.
pub fn add_alias(s: *mut cast.CSym) void {
    for x in S.unit.aliases.items() {
        if x == s {
            return;
        }
    }
    S.unit.aliases.push(s);
}

/// Adds an object with static storage duration defined (or tentatively
/// defined) here to the unit.
pub fn add_object(s: *mut cast.CSym) void {
    S.unit.objects.push(s);
}

/// The translation's rounding directions for the floating-point pragmas'
/// state st (a block item's or an external declaration's): FENV_ROUND's and
/// FENV_DEC_ROUND's static directions, in which constants are read and
/// folded (C23 7.6.2, 7.6.3, F.8.2); to nearest where they are dynamic.
pub fn fp_dir(st: u32) void {
    let r = cpg.fp_round(st);
    cl.g_dir = ld.RN;
    if r == cpg.FPR_UPWARD {
        cl.g_dir = ld.RU;
    } else if r == cpg.FPR_DOWNWARD {
        cl.g_dir = ld.RD;
    } else if r == cpg.FPR_TOWARDZERO {
        cl.g_dir = ld.RZ;
    }
    let dr = cpg.fp_dec_round(st);
    cdec.g_dir = dfp.R_NEAREST;
    if dr != cpg.FPD_DYNAMIC {
        cdec.g_dir = dr - 1;
    }
}

/// Analyzes the translation unit: the typed tree.
pub fn analyze(t: *mut cast.Unit, o: *co.COptions) *mut CUnit {
    let cu = run_unit(t, o);
    pragma_weaks();
    marks_finish();
    return cu;
}
