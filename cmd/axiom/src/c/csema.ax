/// The translation unit, typed: what IR generation emits.
pub struct CUnit {
    pub funcs: u.List.[*mut cast.CSym],    // the functions defined, in order
    pub objects: u.List.[*mut cast.CSym],  // the objects with static storage duration defined here, in order
    pub main: *mut cast.CSym,              // the function main, if defined
    pub asms: u.List.[*mut cast.Asm],      // the file-scope asm (a GNU dialect), in order
    pub asm_names: u.List.[[]u8],          // the identifiers of asm text (a GNU dialect): what it may refer to
    pub asm_tops: u.List.[*mut cast.Asm],  // its file-scope asm (asm_static: names resolved at the unit's end too)
    pub asm_defs: u.List.[[]u8],           // the global symbols its file-scope asm defines (they keep the C library's out)
    pub refs: u.List.[[]u8],               // the external names used and not defined here (the C library's on demand)
    pub aliases: u.List.[*mut cast.CSym],  // the functions and objects declared as aliases (a GNU dialect), in order
    pub has_init_fini: bool,               // its asm puts pointers into .init_array / .fini_array / .preinit_array
}

