// =============================================================================
// cfeat.ax - the names of what the C front end implements of the GNU
// dialects: the attributes `__attribute__((...))` and `[[gnu::...]]` take,
// and the builtins. The preprocessor's __has_attribute and __has_builtin
// answer from these lists (so that they are 1 exactly for what works), and
// semantic analysis dispatches on them (csema_gnu.ax, csema_gbuiltin.ax).
// =============================================================================
import "../target.ax" as tg;
import "../util.ax" as u;

// The GNU attributes implemented (csema_gnu.ax), by their plain names.
let ATTRS: [48][]u8 = ["aligned", "packed", "section", "used", "unused", "weak", "alias", "visibility", "noreturn",
                       "noinline", "always_inline", "cold", "hot", "const", "pure", "malloc", "format", "format_arg",
                       "nonnull", "returns_nonnull", "warn_unused_result", "deprecated", "unavailable", "fallthrough",
                       "constructor", "destructor", "cleanup", "transparent_union", "mode", "may_alias", "gnu_inline",
                       "artificial", "nothrow", "leaf", "externally_visible", "no_instrument_function", "flatten",
                       "noclone", "noipa", "sentinel", "alloc_size", "alloc_align", "assume_aligned", "error", "naked",
                       "vector_size", "optimize", "target"];

// The GNU attributes that only inform the GNU compilers' warnings, checks
// and code hardening (what a pointer parameter is read or written for, a
// character array without its 0, the sanitizers and stack protector a
// function is left out of, the thread-local model, ...): taken, and
// nothing changes (csema_gnu.ax), as the code is the same without them.
pub let HINT_ATTRS: [14][]u8 = ["access", "nonstring", "no_sanitize", "no_sanitize_address", "no_sanitize_thread",
                                "no_sanitize_undefined", "no_address_safety_analysis", "no_stack_protector",
                                "nocf_check", "zero_call_used_regs", "fd_arg", "fd_arg_read", "fd_arg_write",
                                "tls_model"];

/// The plain name of an attribute (`__x__` is `x`).
pub fn plain(n: []u8) []u8 {
    if (n.len > 4) and u.starts(n, "__") and u.ends(n, "__") {
        return n[2..n.len - 2];
    }
    return n;
}

/// Is `name` (or `__name__`) a GNU attribute this compiler implements?
pub fn gnu_attribute(name: []u8) bool {
    let n = plain(name);
    for a in ATTRS {
        if u.str_eq(a, n) {
            return true;
        }
    }
    for a in HINT_ATTRS {
        if u.str_eq(a, n) {
            return true;
        }
    }
    if u.str_eq(n, "ifunc") {
        return not tg.is_windows() and not tg.is_darwin() and not tg.is_wasm();  // (ELF's: STT_GNU_IFUNC)
    }
    if u.str_eq(n, "ms_struct") or u.str_eq(n, "gcc_struct") {
        return tg.g_arch == tg.ARCH_X64;  // (x86's: the Microsoft or the System V layout)
    }
    return u.str_eq(n, "warning") or u.str_eq(n, "maybe_unused") or u.str_eq(n, "nodiscard");
}

// The builtins of every mode (csema_builtin.ax, csema_expr.ax).
let ISO_BUILTINS: [19][]u8 = ["__builtin_va_start", "__builtin_va_end", "__builtin_va_copy", "__builtin_va_arg",
                              "__builtin_offsetof", "__builtin_unreachable", "__builtin_ckd_add", "__builtin_ckd_sub",
                              "__builtin_ckd_mul", "__builtin_inff", "__builtin_nanf", "__builtin_va_list",
                              "__builtin_stdc_leading_zeros", "__builtin_stdc_bit_ceil", "__builtin_stdc_bit_floor",
                              "__builtin_complex", "__builtin_creal", "__builtin_cimag", "__builtin_conj"];

/// The GNU dialects' builtins: the names implemented (used by __has_builtin
/// and semantic analysis).
pub let BITS: [6][]u8 = ["clz", "ctz", "popcount", "parity", "ffs", "clrsb"];
pub let MATH: [9][]u8 = ["fabs", "sqrt", "floor", "ceil", "trunc", "rint", "nearbyint", "copysign", "fma"];
pub let CLASS: [7][]u8 = ["isnan", "isinf", "isfinite", "signbit", "isnormal", "isinf_sign", "fpclassify"];
pub let TCLASS: [9][]u8 = ["isnanf", "isnanl", "isinff", "isinfl", "signbitf", "signbitl", "finite", "finitef",
                           "finitel"];
pub let CMPS: [6][]u8 = ["isgreater", "isgreaterequal", "isless", "islessequal", "islessgreater", "isunordered"];

let OTHERS: [49][]u8 = ["__builtin_LINE", "__builtin_FILE", "__builtin_FUNCTION", "__builtin___clear_cache",
                        "__builtin_speculation_safe_value", "__builtin_bswap128", "__builtin_cpu_supports",
                        "__builtin_cpu_is", "__builtin_cpu_init", "__builtin_setjmp", "__builtin_longjmp",
                        "__builtin_ia32_pause", "__builtin_ia32_mfence", "__builtin_ia32_lfence",
                        "__builtin_ia32_sfence", "__builtin_expect", "__builtin_expect_with_probability",
                        "__builtin_trap", "__builtin_constant_p", "__builtin_choose_expr",
                        "__builtin_types_compatible_p", "__builtin_object_size", "__builtin_dynamic_object_size",
                        "__builtin_bswap16", "__builtin_bswap32", "__builtin_bswap64", "__builtin_add_overflow",
                        "__builtin_sub_overflow", "__builtin_mul_overflow", "__builtin_add_overflow_p",
                        "__builtin_sub_overflow_p", "__builtin_mul_overflow_p", "__builtin_alloca",
                        "__builtin_alloca_with_align", "__builtin_frame_address", "__builtin_return_address",
                        "__builtin_prefetch", "__builtin_assume_aligned", "__builtin_abs", "__builtin_classify_type",
                        "__builtin_conj", "__builtin_conjf", "__builtin_conjl", "__builtin_creal", "__builtin_crealf",
                        "__builtin_creall", "__builtin_cimag", "__builtin_cimagf", "__builtin_cimagl"];

pub let LIB_NAMES: [108][]u8 = ["memcmp", "strlen", "strcmp", "strncmp", "strcpy", "strncpy", "strcat", "strncat",
                                "strchr", "strrchr", "strstr", "memchr", "printf", "sprintf", "snprintf", "puts",
                                "putchar", "malloc", "calloc", "realloc", "free", "abort", "exit", "labs", "llabs",
                                "sin", "cos", "tan", "asin", "acos", "atan", "sinh", "cosh", "tanh", "exp", "exp2",
                                "expm1", "log", "log2", "log10", "log1p", "cbrt", "erf", "erfc", "tgamma", "lgamma",
                                "round", "sinf", "cosf", "tanf", "expf", "logf", "log2f", "log10f", "roundf", "sinl",
                                "cosl", "expl", "logl", "roundl", "pow", "atan2", "fmod", "hypot", "fmin", "fmax",
                                "fdim", "remainder", "nextafter", "powf", "atan2f", "fmodf", "hypotf", "fminf", "fmaxf",
                                "powl", "fmodl", "fminl", "fmaxl", "ldexp", "ldexpf", "frexp", "frexpf", "modf",
                                "modff", "lround", "llround", "lrint", "llrint", "atanf", "asinf", "acosf", "sinhf",
                                "coshf", "tanhf", "cbrtf", "fprintf", "fputs", "fputc", "putc", "fwrite", "strcspn",
                                "strspn", "strpbrk", "imaxabs", "scanf", "sscanf", "fscanf"];

pub let CHK_NAMES: [16][]u8 = ["__memcpy_chk", "__memmove_chk", "__mempcpy_chk", "__memset_chk", "__strcpy_chk",
                               "__stpcpy_chk", "__strncpy_chk", "__stpncpy_chk", "__strcat_chk", "__strncat_chk",
                               "__sprintf_chk", "__snprintf_chk", "__vsprintf_chk", "__vsnprintf_chk", "__printf_chk",
                               "__fprintf_chk"];

pub let ATOMIC_OPS: [6][]u8 = ["add", "sub", "or", "and", "xor", "nand"];
pub let SYNC_NAMES: [5][]u8 = ["bool_compare_and_swap", "val_compare_and_swap", "lock_test_and_set", "lock_release",
                               "synchronize"];
pub let ATOMIC_NAMES: [12][]u8 = ["load_n", "store_n", "exchange_n", "compare_exchange_n", "thread_fence",
                                  "signal_fence", "test_and_set", "clear", "load", "store", "exchange",
                                  "compare_exchange"];

pub fn in_list(name: []u8, l: [][]u8) bool {
    for x in l {
        if u.str_eq(x, name) {
            return true;
        }
    }
    return false;
}

pub fn is_xsuffix(s: []u8) bool {
    let xs = ["f16", "f32", "f64", "f128", "f32x", "f64x", "q"];
    return in_list(s, xs[..]);
}

pub fn float_const_suffix(name: []u8) ?[]u8 {
    let bases = ["__builtin_inf", "__builtin_huge_val", "__builtin_nans", "__builtin_nan"];
    for b in bases {
        if u.starts(name, b) {
            let sfx = name[b.len..];
            if (sfx.len == 0) or u.str_eq(sfx, "f") or u.str_eq(sfx, "l") or is_xsuffix(sfx) {
                return .some(sfx);
            }
        }
    }
    return .none;
}

pub fn is_float_const(name: []u8) bool {
    if let .some(sfx) = float_const_suffix(name) {
        _ = sfx;
        return true;
    }
    return false;
}

pub fn chk_index(name: []u8) i32 {
    for k in 0..CHK_NAMES.len {
        if u.str_eq(CHK_NAMES[k], name) {
            return @int_cast(i32, k);
        }
    }
    return -1;
}

pub fn lib_index(name: []u8) i32 {
    for k in 0..LIB_NAMES.len {
        if u.str_eq(LIB_NAMES[k], name) {
            return @int_cast(i32, k);
        }
    }
    return -1;
}

pub fn math_index(rest: []u8, suffix: *mut []u8) i32 {
    for k in 0..MATH.len {
        let m = MATH[k];
        if u.str_eq(rest, m) {
            suffix.* = "";
            return @int_cast(i32, k);
        }
        if (rest.len == m.len + 1) and u.starts(rest, m) and ((rest[m.len] == 'f') or (rest[m.len] == 'l')) {
            suffix.* = rest[m.len..];
            return @int_cast(i32, k);
        }
        if u.starts(rest, m) and is_xsuffix(rest[m.len..]) {
            // (the interchange and extended types' suffixes, and q for
            // __float128: only fabs and copysign, which change the sign bit)
            if u.str_eq(m, "fabs") or u.str_eq(m, "copysign") {
                suffix.* = rest[m.len..];
                return @int_cast(i32, k);
            }
        }
    }
    return -1;
}

pub fn bits_index(rest: []u8, longs: *mut i32) i32 {
    for k in 0..BITS.len {
        let b = BITS[k];
        if u.str_eq(rest, b) {
            longs.* = 0;
            return @int_cast(i32, k);
        }
        if (rest.len == b.len + 1) and u.starts(rest, b) and (rest[b.len] == 'l') {
            longs.* = 1;
            return @int_cast(i32, k);
        }
        if (rest.len == b.len + 2) and u.starts(rest, b) and u.ends(rest, "ll") {
            longs.* = 2;
            return @int_cast(i32, k);
        }
    }
    return -1;
}

pub fn atomic_op_index(name: []u8) i32 {
    for k in 0..ATOMIC_OPS.len {
        if u.str_eq(ATOMIC_OPS[k], name) {
            return @int_cast(i32, k);
        }
    }
    return -1;
}

fn has_atomic_builtin(name: []u8) bool {
    if u.starts(name, "__sync_") {
        let r = name[7..];
        if u.starts(r, "fetch_and_") and (atomic_op_index(r[10..]) >= 0) {
            return true;
        }
        if u.ends(r, "_and_fetch") and (atomic_op_index(r[0..r.len - 10]) >= 0) {
            return true;
        }
        return in_list(r, SYNC_NAMES[..]);
    }
    if not u.starts(name, "__atomic_") {
        return false;
    }
    let r = name[9..];
    if u.starts(r, "fetch_") and (atomic_op_index(r[6..]) >= 0) {
        return true;
    }
    if u.ends(r, "_fetch") and (atomic_op_index(r[0..r.len - 6]) >= 0) {
        return true;
    }
    return in_list(r, ATOMIC_NAMES[..]);
}

/// Is `name` a GNU builtin this compiler implements (for __has_builtin)?
pub fn known_gnu_builtin(name: []u8) bool {
    // (those a target cannot have: errors where used)
    if (u.str_eq(name, "__builtin_setjmp") or u.str_eq(name, "__builtin_longjmp")) and tg.is_wasm() and
       not tg.has(tg.W_EXCEPTION_HANDLING) {
        return false;
    }
    if u.str_eq(name, "__builtin_cpu_is") and (tg.g_arch != tg.ARCH_X64) {
        return false;
    }
    if in_list(name, OTHERS[..]) or is_float_const(name) or has_atomic_builtin(name) {
        return true;
    }
    if u.str_eq(name, "__atomic_always_lock_free") or u.str_eq(name, "__atomic_is_lock_free") {
        return true;
    }
    if not u.starts(name, "__builtin_") {
        return false;
    }
    if u.str_eq(name, "__builtin_shuffle") or u.str_eq(name, "__builtin_shufflevector") or
       u.str_eq(name, "__builtin_convertvector") {
        return true;
    }
    let rest = name[10..];
    let mut sfx: []u8 = "";
    let mut longs: i32 = 0;
    if u.str_eq(rest, "issignaling") or u.str_eq(rest, "issubnormal") or u.str_eq(rest, "iszero") or
       u.str_eq(rest, "isfpclass") {
        return true;  // (<math.h>'s builtins)
    }
    if (math_index(rest, &mut sfx) >= 0) or (bits_index(rest, &mut longs) >= 0) or in_list(rest, CLASS[..]) or
       in_list(rest, TCLASS[..]) or in_list(rest, CMPS[..]) or (lib_index(rest) >= 0) or u.str_eq(rest, "memcpy") or
       u.str_eq(rest, "memmove") or u.str_eq(rest, "memset") or (chk_index(rest) >= 0) or
       u.str_eq(rest, "va_arg_pack") or u.str_eq(rest, "va_arg_pack_len") {
        return true;
    }
    let typed = ["sadd", "saddl", "saddll", "uadd", "uaddl", "uaddll", "ssub", "ssubl", "ssubll", "usub", "usubl",
                 "usubll", "smul", "smull", "smulll", "umul", "umull", "umulll"];
    for t in typed {
        if u.str_eq(rest, u.cat2(t, "_overflow")) {
            return true;
        }
    }
    return false;
}

/// Is `name` a builtin that works in the mode (gnu: a GNU dialect)?
pub fn has_builtin(name: []u8, gnu: bool) bool {
    for b in ISO_BUILTINS {
        if u.str_eq(b, name) {
            return true;
        }
    }
    if u.starts(name, "__builtin_stdc_") {
        let rest = name[15..];
        let names = ["leading_zeros", "leading_ones", "trailing_zeros", "trailing_ones", "first_leading_zero",
                     "first_leading_one", "first_trailing_zero", "first_trailing_one", "count_zeros", "count_ones",
                     "has_single_bit", "bit_width", "bit_floor", "bit_ceil"];
        for n in names {
            if u.str_eq(n, rest) {
                return true;
            }
        }
        return false;
    }
    return gnu and known_gnu_builtin(name);
}
