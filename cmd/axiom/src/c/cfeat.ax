// =============================================================================
// cfeat.ax - the names of what the C front end implements of the GNU
// dialects: the attributes `__attribute__((...))` and `[[gnu::...]]` take,
// and the builtins. The preprocessor's __has_attribute and __has_builtin
// answer from these lists (so that they are 1 exactly for what works), and
// semantic analysis dispatches on them (csema_gnu.ax, csema_gbuiltin.ax).
// =============================================================================
import "../util.ax" as u;

// The GNU attributes implemented (csema_gnu.ax), by their plain names.
let ATTRS: [48][]u8 = ["aligned", "packed", "section", "used", "unused", "weak", "alias", "visibility", "noreturn",
                       "noinline", "always_inline", "cold", "hot", "const", "pure", "malloc", "format", "format_arg",
                       "nonnull", "returns_nonnull", "warn_unused_result", "deprecated", "unavailable", "fallthrough",
                       "constructor", "destructor", "cleanup", "transparent_union", "mode", "may_alias", "gnu_inline",
                       "artificial", "nothrow", "leaf", "externally_visible", "no_instrument_function", "flatten",
                       "noclone", "noipa", "sentinel", "alloc_size", "alloc_align", "assume_aligned", "error", "naked",
                       "vector_size", "optimize", "target"];

/// The plain name of an attribute (`__x__` is `x`).
pub fn plain(n: []u8) []u8 {
    if (n.len > 4) and u.starts(n, "__") and u.ends(n, "__") {
        return n[2..n.len - 2];
    }
    return n;
}

/// Is `name` (or `__name__`) a GNU attribute this compiler implements?
pub fn gnu_attribute(name: []u8) bool {
    let n = plain(name);
    for a in ATTRS {
        if u.str_eq(a, n) {
            return true;
        }
    }
    return u.str_eq(n, "warning") or u.str_eq(n, "maybe_unused") or u.str_eq(n, "nodiscard");
}

// The builtins of every mode (csema_builtin.ax, csema_expr.ax).
let ISO_BUILTINS: [19][]u8 = ["__builtin_va_start", "__builtin_va_end", "__builtin_va_copy", "__builtin_va_arg",
                              "__builtin_offsetof", "__builtin_unreachable", "__builtin_ckd_add", "__builtin_ckd_sub",
                              "__builtin_ckd_mul", "__builtin_inff", "__builtin_nanf", "__builtin_va_list",
                              "__builtin_stdc_leading_zeros", "__builtin_stdc_bit_ceil", "__builtin_stdc_bit_floor",
                              "__builtin_complex", "__builtin_creal", "__builtin_cimag", "__builtin_conj"];

/// The GNU dialects' builtins (csema_gbuiltin.ax): set by it (install).
pub let mut gnu_builtin: fn([]u8) bool = no_gnu_builtin;

fn no_gnu_builtin(name: []u8) bool {
    _ = name;
    return false;
}

/// Is `name` a builtin that works in the mode (gnu: a GNU dialect)?
pub fn has_builtin(name: []u8, gnu: bool) bool {
    for b in ISO_BUILTINS {
        if u.str_eq(b, name) {
            return true;
        }
    }
    if u.starts(name, "__builtin_stdc_") {
        let rest = name[15..];
        let names = ["leading_zeros", "leading_ones", "trailing_zeros", "trailing_ones", "first_leading_zero",
                     "first_leading_one", "first_trailing_zero", "first_trailing_one", "count_zeros", "count_ones",
                     "has_single_bit", "bit_width", "bit_floor", "bit_ceil"];
        for n in names {
            if u.str_eq(n, rest) {
                return true;
            }
        }
        return false;
    }
    return gnu and gnu_builtin(name);
}
