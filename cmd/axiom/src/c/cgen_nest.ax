// =============================================================================
// cgen_nest.ax - IR generation for the GNU dialects' nested functions
// (csema_nest.ax).
//
// A function with nested functions makes a frame record when it starts: an
// array of pointers, in its frame, of
//   [0]               its own chain (below), or null
//   [1 .. 1+n)        the addresses of the objects of its rec: its own, or,
//                     for its enclosing functions' objects, those its own
//                     chain gives (its own variable length arrays': stored
//                     when each is allocated, null before)
//   [1+n .. 1+n+l)    the addresses of the slots of the lengths of the
//                     variable length array types it evaluates
//                     (csema_nest.lengths): a nested function reads the
//                     length of such a type there (outer_len), through
//                     record_of
//   [.. +m)           for each of its nested functions whose address is
//                     taken (tramps), the trampoline this call of it holds
//                     (its index plus 1), or 0
// A nested function is an ordinary IR function of the unit, with one IR
// parameter after its C arguments (cgen_abi.add_chain): its chain, the frame
// record of the call of its enclosing function it belongs to. A direct call
// passes it: the caller's own record, if the callee is nested in the caller;
// else the caller's chain, followed up through the [0] slots to the record of
// the callee's enclosing function (a sibling, or a function nested in one).
// So no register is reserved for a static chain: every call of a nested
// function is one the compiler makes, a direct one, or one of its
// trampolines.
//
// Trampolines: a nested function whose address is taken has POOL of them,
// functions of the unit with the nested function's C type (so any caller,
// the platform's C code too, calls them by the platform's C ABI), each with
// a slot in a table of chains; trampoline k calls the nested function with
// the chain in slot k. Taking the address claims a free slot (with an atomic
// compare-and-exchange, so threads may share the pool) for the call of the
// enclosing function the record belongs to, once per such call, and gives
// the trampoline's address; the slot is given back when that call returns.
// No code is made or written at run time, so the stack and the heap stay
// not executable, on every target (WebAssembly included: the trampolines are
// functions of the module's table). A program that holds more than POOL
// addresses of one nested function at once (in POOL live calls of its
// enclosing function) traps. A longjmp out of the enclosing function, which
// unwinds nothing, keeps its slots.
//
// A variadic nested function's IR function takes, after its named
// arguments, the address of a va_list (which its va_start copies:
// cgen_va.va_from) and then its chain. A direct call calls its entry
// (entry_of): a variadic function whose named arguments are the nested
// function's and then the chain, so that the variable arguments come after
// it on every ABI; the entry, and each trampoline, starts a va_list and calls
// the nested function with it.
//
// Non-local gotos: a goto in a nested function to a local label
// (`__label__`) of an enclosing function P (cast.CSym.nonlocal) leaves the
// nested function's call, and those between it and P's call, and goes on
// as a goto in P from the call P is making then. P's record has two more
// slots after the trampolines': the address of a jmp_buf in P's frame,
// and the jump's number (the label's index in nonlocal, plus 1). P is
// compiled as a function that calls setjmp (ir.Func.returns_twice), and
// before each of its calls, setjmp (the linkers' __axc_setjmp; on
// WebAssembly cgen_sjlj.ax's, with the exception-handling extension) arms
// the jmp_buf there (arm): the call P makes when a nested function's goto
// runs is the last one armed. The goto makes its own function's cleanups'
// calls and frees its variable length arrays, as a return does, gives back
// the trampolines its call holds, stores the number in P's record and
// longjmps to the jmp_buf (__axc_longjmp_restore, on WebAssembly longjmp).
// setjmp then returns 1 at the call, and the code after it (finish) is a
// goto from there to the label: the cleanups of the scopes it leaves are
// called and the variable length arrays freed (cgen_vla.ax), or, if the
// label is in a scope the call is not (a jump into the scope of a variable
// length array or of an object with a cleanup, 6.8.6.1p1), a trap. A
// function nested in P that makes a call with cleanups in scope, or with
// trampolines its call holds, hooks the call into the jumps to P (arm): the
// slot gets its own jmp_buf for the call, so that a jump passing through
// calls those cleanups, gives back the trampolines, and goes on to the
// jmp_buf the slot held (finish). The frames of other functions between
// are left as a longjmp leaves them.
// =============================================================================
import "../diag.ax" as dg;
import "../ir.ax" as ir;
import "../target.ax" as tg;
import "../util.ax" as u;
import "cast.ax" as cast;
import "cgen.ax" as cg;
import "cgen_gbuiltin.ax" as ggb;
import "cgen_sjlj.ax" as sj;
import "cgen_va.ax" as gva;
import "cgen_vla.ax" as gv;
import "csema_nest.ax" as cnest;
import "csema_vla.ax" as svla;
import "ctypes.ax" as cty;

/// The trampolines of each nested function whose address is taken.
pub const POOL: u64 = 128;
const NPOOL: usize = 128;  // (POOL, as an index)

fn B() *mut ir.Builder {
    return cg.B;
}

fn psz() u64 {
    return cty.ptr_bytes;
}

fn slot(r: *mut ir.Value, k: u64) *mut ir.Value {
    return ir.ptradd(B(), r, cg.usz(k * psz()));
}

fn ld(p: *mut ir.Value) *mut ir.Value {
    let v = ir.load(B(), cg.T_ptr, p);
    v.align = @truncate(u32, psz());
    return v;
}

fn st(v: *mut ir.Value, p: *mut ir.Value) void {
    let s = ir.store(B(), v, p);
    s.align = @truncate(u32, psz());
}

/// The start of function s (its parameters' objects made): a nested
/// function's chain kept in an object of the frame, and the frame record of
/// a function with nested functions made.
pub fn enter(s: *mut cast.CSym) void {
    let F = cg.F;
    if u.notnil(s.nest_parent) {
        F.chain = cg.alloca(cty.pointer_to(cty.t_void), "chain");
        st(F.f.params[@int_cast(usize, F.sig.plan.chain)], F.chain);
    }
    g_sites.clear();
    g_hooks.clear();
    g_pending.clear();
    g_hook_jb = ir.vnil();
    if not s.has_nested {
        return;
    }
    let ls = cnest.lengths(s);
    let mut n = 1 + @as(u64, s.rec.len) + @as(u64, ls.len) + @as(u64, s.tramps.len);
    if s.nonlocal.len > 0 {
        n += 2;
    }
    let r = cg.alloca(cty.array_of(cty.pointer_to(cty.t_void), n, true), "frame.rec");
    F.rec = r;
    if u.notnil(F.chain) {
        st(ld(F.chain), r);
    } else {
        st(ir.czero(cg.T_ptr), r);
    }
    for k in 0..s.rec.len {
        let x = s.rec.get(k);
        if (x.owner == s) and cty.is_vla(x.ty) {
            st(ir.czero(cg.T_ptr), slot(r, 1 + @as(u64, k)));  // (until it is allocated: allocated)
        } else {
            st(object_addr(x), slot(r, 1 + @as(u64, k)));
        }
    }
    for k in 0..ls.len {
        let mut a = ir.czero(cg.T_ptr);
        if not u.isvnil(ls[k]) {
            a = gv.len_addr(ls[k]);
        }
        st(a, slot(r, lens_field(s) + @as(u64, k)));
    }
    for k in 0..s.tramps.len {
        st(ir.czero(cg.T_ptr), slot(r, lens_field(s) + @as(u64, ls.len) + @as(u64, k)));
    }
    if s.nonlocal.len > 0 {
        if cg.is_wasm and not tg.has(tg.W_EXCEPTION_HANDLING) {
            _ = dg.err(s.nonlocal.get(0).span, "C3300",
                       "a jump from a nested function to its enclosing function needs WebAssembly's exception-handling extension (--features=+exception-handling)");
        }
        F.f.returns_twice = true;
        F.f.noinline = true;
        let jb = cg.alloca(cty.array_of(cty.t_llong, 32, true), "nonlocal.jmpbuf");
        st(jb, slot(r, jb_field(s)));
        st(ir.czero(cg.T_ptr), slot(r, jb_field(s) + 1));
    }
}

// The index of the jmp_buf's address in the record of function s with
// non-local labels (then that of the jump's number).
fn jb_field(s: *cast.CSym) u64 {
    return lens_field(s) + @as(u64, cnest.lengths(s).len) + @as(u64, s.tramps.len);
}

// The index of the first length slot's address in function s's record.
fn lens_field(s: *cast.CSym) u64 {
    return 1 + @as(u64, s.rec.len);
}

/// Variable length array object s of the function being generated is
/// allocated (its address in s.ir): its address in the frame record, if a
/// nested function uses it.
pub fn allocated(s: *mut cast.CSym) void {
    let F = cg.F;
    if u.isnil(F) or u.isnil(F.rec) or u.isnil(F.sym) {
        return;
    }
    let idx = cnest.rec_index(F.sym, s);
    if idx >= 0 {
        st(@ptr_cast(*mut ir.Value, s.ir), slot(F.rec, 1 + @as(u64, @bit_cast(u32, idx))));
    }
}

/// The address of the slot of length n (a CType.vexpr) that an enclosing
/// function of the function being generated evaluates, from its record; nil
/// if the function being generated evaluates it (cgen_vla.slot).
pub fn outer_len(n: *mut void) *mut ir.Value {
    let F = cg.F;
    if u.isnil(F) or u.isnil(F.sym) or u.isnil(F.sym.nest_parent) {
        return ir.vnil();
    }
    let p = cnest.length_owner(n);
    if u.isnil(p) or (p == F.sym) {
        return ir.vnil();
    }
    let mut x = F.sym.nest_parent;
    while u.notnil(x) and (x != p) {
        x = x.nest_parent;
    }
    let idx = cnest.length_index(p, n);
    if u.isnil(x) or (idx < 0) {
        return ir.vnil();  // (not an enclosing function's)
    }
    return ld(slot(record_of(p), lens_field(p) + @as(u64, @bit_cast(u32, idx))));
}

/// The address of automatic object x of the function being generated, or
/// (in a nested function) of an enclosing function: from the chain.
pub fn object_addr(x: *mut cast.CSym) *mut ir.Value {
    let F = cg.F;
    let cur = F.sym;
    if u.notnil(cur) and u.notnil(x.owner) and (x.owner != cur) and u.notnil(cur.nest_parent) and
       (x.duration == cast.SD_AUTO) {
        let idx = cnest.rec_index(cur.nest_parent, x);
        if idx >= 0 {
            return ld(slot(ld(F.chain), 1 + @as(u64, @bit_cast(u32, idx))));
        }
    }
    if u.isvnil(x.ir) {
        x.ir = @ptr_cast(*mut void, cg.aligned_alloca(x.ty, x.name, x.align));
    }
    return @ptr_cast(*mut ir.Value, x.ir);
}

/// Is x an object of an enclosing function, seen from the function being generated?
pub fn is_outer(x: *cast.CSym) bool {
    let F = cg.F;
    return u.notnil(F) and u.notnil(F.sym) and u.notnil(x.owner) and (x.owner != F.sym) and
           (x.duration == cast.SD_AUTO) and u.notnil(F.sym.nest_parent);
}

/// The frame record of the enclosing function of nested function g, seen
/// from the function being generated (g's enclosing function, or a function
/// nested in it).
pub fn chain_for(g: *cast.CSym) *mut ir.Value {
    return record_of(g.nest_parent);
}

// The frame record of the call of function p (the function being generated,
// or one it is nested in) that the function being generated belongs to.
fn record_of(p: *mut cast.CSym) *mut ir.Value {
    let F = cg.F;
    let cur = F.sym;
    if cur == p {
        return F.rec;
    }
    let mut r = ld(F.chain);
    let mut x = cur.nest_parent;
    while u.notnil(x) and (x != p) {
        r = ld(r);  // (slot 0: that function's own chain)
        x = x.nest_parent;
    }
    return r;
}

// The globals of nested function g's trampolines: the table of chains, and
// the table of the trampolines' addresses (and the functions, declared).
struct Pool {
    chains: *mut ir.Value,
    fns: *mut ir.Value,
    get: *mut ir.Func,
    thunks: []mut *mut ir.Func,
}

let mut g_pools: u.SymMap.[*mut Pool] = u.SymMap.[*mut Pool].{ keys: @ptr_from_int(*mut usize, 0),
                                                               vals: @ptr_from_int(*mut *mut Pool, 0), cap: 0, len: 0 };

fn key(g: *cast.CSym) []u8 {
    return u.addr_key(@int_from_ptr(g));
}

/// The trampolines of nested function g (made once: their functions declared).
pub fn pool_of(g: *mut cast.CSym) *mut Pool {
    let k = key(g);
    let had = g_pools.get(k);
    if u.notnil(had) {
        return had;
    }
    let p = u.new.[Pool]();
    let base = u.f2("%s.%s", g.name, u.idec(g.uid));
    let tab = ir.add_global(cg.M, ir.t_array(cg.T_ptr, POOL), u.cat2(base, ".chains"));
    tab.init = ir.czero(tab.ty);
    tab.linkage = ir.LINK_INTERNAL;
    tab.align = 8;
    p.chains = tab.val;
    let sig = cg.sig_of(g.ty.ret, cg.param_types(g), g.ty.params.len, g.ty.variadic, true);
    p.thunks = u.newn.[*mut ir.Func](NPOOL + 1)[0..NPOOL];
    let addrs = u.newn.[*mut ir.Value](NPOOL + 1);
    for i in 0..NPOOL {
        let f = ir.add_function(cg.M, u.f2("%s.tramp.%s", base, u.zdec(i)), sig.ty);
        f.linkage = ir.LINK_INTERNAL;
        cg.mark_func(f, sig.plan);  // (the ABI's marks: a result through x8, in registers ...)
        p.thunks[i] = f;
        addrs[i] = f.val;
    }
    let fns = ir.add_global(cg.M, ir.t_array(cg.T_ptr, POOL), u.cat2(base, ".tramps"));
    fns.init = ir.carray(cg.T_ptr, addrs[0..NPOOL]);
    fns.linkage = ir.LINK_INTERNAL;
    fns.is_const = true;
    fns.align = 8;
    p.fns = fns.val;
    let mut one: [1]*mut ir.Ty = [cg.T_ptr];
    p.get = ir.add_function(cg.M, u.cat2(base, ".trampoline"), ir.t_fn(cg.T_ptr, one[..], false));
    p.get.linkage = ir.LINK_INTERNAL;
    g_pools.put(k, p);
    return p;
}

// The entries of variadic nested functions (entry_of), by function.
let mut g_entries: u.SymMap.[*mut ir.Func] = u.SymMap.[*mut ir.Func].{ keys: @ptr_from_int(*mut usize, 0),
                                                                       vals: @ptr_from_int(*mut *mut ir.Func, 0),
                                                                       cap: 0, len: 0 };

/// The parameter types of variadic nested function g's entry: g's, then
/// its chain.
pub fn entry_params(g: *cast.CSym) []mut *mut cty.CType {
    let ps = cg.param_types(g);
    let r = u.newn.[*mut cty.CType](ps.len + 2);
    for i in 0..ps.len {
        r[i] = ps[i];
    }
    r[ps.len] = cty.pointer_to(cty.t_void);
    return r[0..ps.len + 1];
}

/// The entry of variadic nested function g (declared once; defined with the
/// trampolines, cgen_stmt.trampolines): a variadic function whose named
/// arguments are g's and then its chain (so that va_start in it skips the
/// chain, on every ABI), which calls g with a va_list of its variable
/// arguments. A direct call of g calls it.
pub fn entry_of(g: *mut cast.CSym) *mut ir.Func {
    let k = key(g);
    let had = g_entries.get(k);
    if u.notnil(had) {
        return had;
    }
    let ps = entry_params(g);
    let sig = cg.sig_of(g.ty.ret, ps, ps.len, true, true);
    let f = ir.add_function(cg.M, u.f2("%s.%s.entry", g.name, u.idec(g.uid)), sig.ty);
    f.linkage = ir.LINK_INTERNAL;
    cg.mark_func(f, sig.plan);
    g_entries.put(k, f);
    return f;
}

/// A direct call of variadic nested function g with arguments vs of types
/// ats (nnamed of them named) from the function being generated: a call of
/// its entry, the chain after the named arguments.
pub fn call_variadic(g: *mut cast.CSym, ats: []mut *mut cty.CType, vs: []mut *mut ir.Value,
                     nnamed: usize) *mut ir.Value {
    let n = ats.len;
    let ts = u.newn.[*mut cty.CType](n + 2);
    let xs = u.newn.[*mut ir.Value](n + 2);
    for i in 0..n {
        let mut j = i;
        if i >= nnamed {
            j = i + 1;
        }
        ts[j] = ats[i];
        xs[j] = vs[i];
    }
    ts[nnamed] = cty.pointer_to(cty.t_void);
    xs[nnamed] = chain_for(g);
    let sig = cg.sig_of(g.ty.ret, ts[0..n + 1], nnamed + 1, true, false);
    return gva.emit_call(sig.plan, sig.ty, entry_of(g).val, xs[0..n + 1]);
}

// The index of nested function g's trampoline field in its enclosing function's record.
fn field(g: *mut cast.CSym) u64 {
    let p = g.nest_parent;
    for k in 0..p.tramps.len {
        if p.tramps.get(k) == g {
            return lens_field(p) + @as(u64, cnest.lengths(p).len) + @as(u64, k);
        }
    }
    return 0;
}

/// The address of nested function g (a trampoline's), in the function
/// being generated.
pub fn address(g: *mut cast.CSym) *mut ir.Value {
    let p = pool_of(g);
    let mut xs: [1]*mut ir.Value = [chain_for(g)];
    return ir.call(B(), p.get.ty, p.get.val, xs[..]);
}

/// Before function s returns: the trampolines its call holds, given back.
pub fn leave(s: *cast.CSym) void {
    let F = cg.F;
    if u.isnil(F) or u.isnil(F.rec) or (s.tramps.len == 0) or cg.terminated() {
        return;
    }
    for g in s.tramps.items() {
        let p = pool_of(g);
        let v = ir.ptrtoint(B(), ld(slot(F.rec, field(g))), cg.T_isz);
        let has = ir.icmp(B(), ir.IntNE, v, cg.usz(0));
        let yes = cg.new_block("tramp.free");
        let done = cg.new_block("tramp.done");
        ir.condbr(B(), has, yes, done);
        cg.at_end(yes);
        let at = ir.ptradd(B(), p.chains, ir.mul(B(), ir.sub(B(), v, cg.usz(1)), cg.usz(psz())));
        let s0 = ir.store(B(), ir.czero(cg.T_ptr), at);
        s0.align = @truncate(u32, psz());
        s0.flags = s0.flags | ir.F_VOLATILE;
        ir.br(B(), done);
        cg.at_end(done);
    }
}

/// The function that gives nested function g's trampoline for a record
/// (its parameter): the one the record holds, else the first free slot,
/// claimed with a compare-and-exchange of its chain from null to the
/// record (a trap if none is free). F is set to a state of its own.
pub fn define_get(g: *mut cast.CSym) void {
    let p = pool_of(g);
    let f = p.get;
    let fld = field(g);
    let st0 = u.new.[cg.FnState]();
    st0.f = f;
    cg.F = st0;
    st0.entry = cg.new_block("entry");
    cg.at_end(st0.entry);
    let rec = f.params[0];
    let held = ir.ptrtoint(B(), ld(slot(rec, fld)), cg.T_isz);
    let fresh = cg.new_block("claim");
    let found = cg.new_block("found");
    let have = ir.icmp(B(), ir.IntNE, held, cg.usz(0));
    let from_entry = ir.insert_block(B());
    ir.condbr(B(), have, found, fresh);
    // the claim: slot i from 0, until one is free
    cg.at_end(fresh);
    let loop_b = cg.new_block("try");
    let next = cg.new_block("next");
    let full = cg.new_block("full");
    ir.br(B(), loop_b);
    cg.at_end(loop_b);
    let i = ir.phi(B(), cg.T_isz);
    ir.add_incoming(i, cg.usz(0), fresh);
    let at = ir.ptradd(B(), p.chains, ir.mul(B(), i, cg.usz(psz())));
    let old = ir.cmpxchg(B(), at, ir.czero(cg.T_ptr), rec);
    let got = ir.icmp(B(), ir.IntEQ, ir.ptrtoint(B(), old, cg.T_isz), cg.usz(0));
    let claimed = cg.new_block("claimed");
    ir.condbr(B(), got, claimed, next);
    cg.at_end(next);
    let i1 = ir.add(B(), i, cg.usz(1));
    ir.add_incoming(i, i1, next);
    ir.condbr(B(), ir.icmp(B(), ir.IntULT, i1, cg.usz(POOL)), loop_b, full);
    cg.at_end(full);
    let none = u.newn.[*mut ir.Value](1);
    _ = ir.intr(B(), ir.IN_TRAP, cg.T_void, none[0..0]);
    ir.unreachable(B());
    cg.at_end(claimed);
    let num = ir.add(B(), i, cg.usz(1));
    st(ir.inttoptr(B(), num), slot(rec, fld));
    ir.br(B(), found);
    cg.at_end(found);
    let n = ir.phi(B(), cg.T_isz);
    ir.add_incoming(n, held, from_entry);
    ir.add_incoming(n, num, claimed);
    let fa = ir.ptradd(B(), p.fns, ir.mul(B(), ir.sub(B(), n, cg.usz(1)), cg.usz(psz())));
    ir.ret(B(), ld(fa));
    ir.remove_unreachable(f);
    cg.F = u.nil.[cg.FnState]();
}

// -----------------------------------------------------------------------------
// Non-local gotos (see the header)
// -----------------------------------------------------------------------------

// A call of the function being generated, armed: its block that goes on
// after a non-local goto, and what is in scope there.
struct Site {
    blk: *mut ir.Block,
    vla: *mut void,
}

let mut g_sites: u.List.[Site] = u.List.[Site].{ data: @ptr_from_int(*mut Site, 0), len: 0, cap: 0 };

// What is in scope at each label of the function being generated that a
// nested function jumps to.
let mut g_labels: u.SymMap.[*mut void] = u.SymMap.[*mut void].{ keys: @ptr_from_int(*mut usize, 0),
                                                                vals: @ptr_from_int(*mut *mut void, 0), cap: 0,
                                                                len: 0 };

fn nonlocal_index(p: *cast.CSym, l: *mut cast.CSym) i32 {
    for k in 0..p.nonlocal.len {
        if p.nonlocal.get(k) == l {
            return @int_cast(i32, k);
        }
    }
    return -1;
}

// A call of the function being generated, hooked into the non-local gotos
// to enclosing functions (hook): what each of their records' jmp_buf
// slots held before it.
struct Hook {
    blk: *mut ir.Block,
    vla: *mut void,
    at: []mut *mut ir.Value,     // the slots
    saved: []mut *mut ir.Value,  // what they held
    fns: []mut *mut cast.CSym,   // whose
}

let mut g_hooks: u.List.[Hook] = u.List.[Hook].{ data: @ptr_from_int(*mut Hook, 0), len: 0, cap: 0 };

// The jmp_buf of the function being generated for its hooks (nil: none yet).
let mut g_hook_jb: *mut ir.Value = @ptr_from_int(*mut ir.Value, 0);

// setjmp(jb), the linkers' or (WebAssembly) cgen_sjlj.ax's: nonzero after a
// longjmp to jb; the function being generated is one that calls setjmp.
fn setjmp(jb: *mut ir.Value) *mut ir.Value {
    let F = cg.F;
    F.f.returns_twice = true;
    F.f.noinline = true;
    if cg.is_wasm {
        return sj.setjmp_call(jb);
    }
    let mut ps: [1]*mut ir.Ty = [cg.T_ptr];
    let f = ggb.extern_fn("__axc_setjmp", cg.T_i32, ps[..]);
    let mut a: [1]*mut ir.Value = [jb];
    return ir.call(B(), f.ty, f.val, a[..]);
}

fn longjmp(jb: *mut ir.Value) void {
    let mut ps: [2]*mut ir.Ty = [cg.T_ptr, cg.T_i32];
    let f = ggb.extern_fn(u.pick(cg.is_wasm, "longjmp", "__axc_longjmp_restore"), cg.T_void, ps[..]);
    let mut a: [2]*mut ir.Value = [jb, ir.cint(cg.T_i32, 1)];
    _ = ir.call(B(), f.ty, f.val, a[..]);
    ir.unreachable(B());
}

// Goes on at a new block if r is 0, else at the block returned.
fn split(r: *mut ir.Value, name: []u8) *mut ir.Block {
    let other = cg.new_block(name);
    let cont = cg.new_block("nonlocal.call");
    ir.condbr(B(), ir.icmp(B(), ir.IntNE, r, ir.cint(cg.T_i32, 0)), other, cont);
    cg.at_end(cont);
    return other;
}

/// Before a call in the function being generated: if a nested function
/// jumps to one of its labels, setjmp arms its jmp_buf for the call. And if
/// it is nested in functions that nested functions jump to, and has
/// cleanups in scope or trampolines, the call is hooked into those jumps:
/// their records' jmp_buf slots get its own jmp_buf for the call (unhook
/// gives back what they held), and a jump through it calls the cleanups,
/// gives back the trampolines and goes on to what the slots held (finish).
pub fn arm() void {
    let F = cg.F;
    if u.isnil(F) or u.isnil(F.sym) {
        return;
    }
    if cg.terminated() {
        g_pending.push(NONE);
        return;
    }
    if u.notnil(F.sym.nest_parent) and (gv.has_cleanups() or ((F.sym.tramps.len > 0) and u.notnil(F.rec))) {
        let mut fns = u.List.[*mut cast.CSym].empty();
        let mut a = F.sym.nest_parent;
        while u.notnil(a) {
            if a.nonlocal.len > 0 {
                fns.push(a);
            }
            a = a.nest_parent;
        }
        if fns.len > 0 {
            if u.isnil(g_hook_jb) {
                g_hook_jb = cg.alloca(cty.array_of(cty.t_llong, 32, true), "nonlocal.hook");
            }
            let n = fns.len;
            let h = Hook.{ blk: u.nil.[ir.Block](), vla: gv.snapshot(), at: u.newn.[*mut ir.Value](n + 1)[0..n],
                           saved: u.newn.[*mut ir.Value](n + 1)[0..n], fns: fns.items() };
            for k in 0..n {
                h.at[k] = slot(record_of(fns.get(k)), jb_field(fns.get(k)));
                h.saved[k] = ld(h.at[k]);
                st(g_hook_jb, h.at[k]);
            }
            let mut hh = h;
            hh.blk = split(setjmp(g_hook_jb), "nonlocal.hooked");
            g_hooks.push(hh);
            g_pending.push(g_hooks.len - 1);
        } else {
            g_pending.push(NONE);
        }
    } else {
        g_pending.push(NONE);
    }
    if (F.sym.nonlocal.len == 0) or u.isnil(F.rec) {
        return;
    }
    let jb = ld(slot(F.rec, jb_field(F.sym)));
    let site = split(setjmp(jb), "nonlocal.site");
    g_sites.push(Site.{ blk: site, vla: gv.snapshot() });
}

const NONE: usize = 0xFFFF_FFFF;

// For each armed call being generated (innermost last), its hook in
// g_hooks, or NONE.
let mut g_pending: u.List.[usize] = u.List.[usize].{ data: @ptr_from_int(*mut usize, 0), len: 0, cap: 0 };

/// After a call that arm armed: the slots it hooked given back.
pub fn unhook() void {
    if u.isnil(cg.F) or u.isnil(cg.F.sym) or (g_pending.len == 0) {
        return;
    }
    let k = g_pending.pop();
    if (k == NONE) or cg.terminated() {
        return;
    }
    let h = g_hooks.get(k);
    for i in 0..h.at.len {
        st(h.saved[i], h.at[i]);
    }
}

/// Label l of the function being generated begins here.
pub fn label(l: *mut cast.CSym) void {
    let F = cg.F;
    if u.notnil(F) and u.notnil(F.sym) and (nonlocal_index(F.sym, l) >= 0) {
        g_labels.put(u.addr_key(@int_from_ptr(l)), gv.snapshot());
    }
}

/// A goto to label l of an enclosing function (a non-local goto).
pub fn goto_(l: *mut cast.CSym) void {
    let F = cg.F;
    gv.release_to(0);
    if cg.terminated() {
        return;
    }
    leave(F.sym);
    let p = l.owner;
    let r = record_of(p);
    let k = nonlocal_index(p, l);
    st(ir.inttoptr(B(), cg.usz(@as(u64, @bit_cast(u32, k)) + 1)), slot(r, jb_field(p) + 1));
    longjmp(ld(slot(r, jb_field(p))));
    cg.continue_after();
}

/// After the body of the function being generated: at each armed call, the
/// goto that a nested function's non-local goto goes on as (label_block:
/// a label's block).
pub fn finish(label_block: fn(*mut cast.CSym) *mut ir.Block) void {
    let F = cg.F;
    if u.isnil(F.sym) or ((g_sites.len == 0) and (g_hooks.len == 0)) {
        return;
    }
    let ls = F.sym.nonlocal.items();
    let saved = gv.snapshot();
    let mut i: usize = 0;
    let mut j: usize = 0;
    // (a cleanup's call in one of these is armed too: g_sites and g_hooks grow)
    while (i < g_sites.len) or (j < g_hooks.len) {
        if j < g_hooks.len {
            // a jump to an enclosing function through this call: this
            // function's cleanups, its trampolines given back, the slots
            // as they were, and on to the slot of the function jumped to
            // (whose jump's number is not 0)
            let h = g_hooks.get(j);
            j += 1;
            cg.at_end(h.blk);
            gv.restore(h.vla);
            gv.release_to(0);
            if cg.terminated() {
                continue;
            }
            leave(F.sym);
            for k in 0..h.at.len {
                st(h.saved[k], h.at[k]);
            }
            for k in 0..h.fns.len {
                let num = slot(record_of(h.fns[k]), jb_field(h.fns[k]) + 1);
                let t = ir.ptrtoint(B(), ld(num), cg.T_isz);
                let yes = cg.new_block("nonlocal.on");
                let no = cg.new_block("nonlocal.next");
                ir.condbr(B(), ir.icmp(B(), ir.IntNE, t, cg.usz(0)), yes, no);
                cg.at_end(yes);
                longjmp(h.saved[k]);
                cg.at_end(no);
            }
            ir.unreachable(B());
            continue;
        }
        let site = g_sites.get(i);
        i += 1;
        cg.at_end(site.blk);
        let num = slot(F.rec, jb_field(F.sym) + 1);
        let t = ir.ptrtoint(B(), ld(num), cg.T_isz);
        st(ir.czero(cg.T_ptr), num);  // (arrived: a hook on the way to another jump tells it from this one)
        let none = cg.new_block("nonlocal.none");
        let sw = ir.switch_(B(), t, none);
        for k in 0..ls.len {
            let l = ls[k];
            let b = cg.new_block("nonlocal.goto");
            ir.add_case(sw, cg.usz(@as(u64, k) + 1), b);
            cg.at_end(b);
            let at = g_labels.get(u.addr_key(@int_from_ptr(l)));
            if not u.isvnil(at) and gv.is_prefix(at, site.vla) {
                gv.restore(site.vla);
                gv.release_to(svla.depth(l));
                if not cg.terminated() {
                    ir.br(B(), label_block(l));
                }
            } else {
                // (into a scope the call is not in: undefined, 6.8.6.1p1)
                let no = u.newn.[*mut ir.Value](1);
                _ = ir.intr(B(), ir.IN_TRAP, cg.T_void, no[0..0]);
                ir.unreachable(B());
            }
        }
        cg.at_end(none);
        ir.unreachable(B());
    }
    gv.restore(saved);
}
