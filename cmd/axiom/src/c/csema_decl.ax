// =============================================================================
// csema_decl.ax - C declarations (6.7, 6.9): declaration specifiers to
// types, declarators, storage classes and linkage, structure, union and
// enumeration specifiers, typedefs, function definitions, tentative
// definitions and static assertions.
//
// A declarator's derivations are applied to the specifiers' type from the
// last (the outermost) to the first. Parameter types are adjusted (arrays and
// functions to pointers); a definition's parameters are made into CSyms
// (csema_stmt declares them in the body's scope). Identifiers with linkage
// share one CSym across their declarations, whose type is the composite of
// theirs; an object with static storage duration that is defined (or
// tentatively defined) here is added to the unit once.
// =============================================================================
import "../util.ax" as u;
import "cast.ax" as cast;
import "cconst.ax" as cc;
import "cgen_debug.ax" as cdbg;
import "copts.ax" as co;
import "csema.ax" as cs;
import "csema_asm.ax" as csa;
import "csema_atomic.ax" as catm;
import "csema_attr.ax" as catr;
import "csema_bitint.ax" as csb;
import "csema_bits.ax" as cb;
import "csema_builtin.ax" as csbi;
import "csema_desig.ax" as cdi;
import "csema_dspec.ax" as dsp;
import "csema_expr.ax" as cx;
import "csema_gnu.ax" as cgn;
import "csema_ice.ax" as csi;
import "csema_marks.ax" as csm;
import "csema_vla.ax" as vla;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;
import "cwide.ax" as cw;

// Where declaration specifiers are.
const CTX_FILE: i32 = 0;
const CTX_BLOCK: i32 = 1;
const CTX_PARAM: i32 = 2;
const CTX_MEMBER: i32 = 3;
const CTX_TYPENAME: i32 = 4;
const CTX_FOR: i32 = 5;

// What declaration specifiers say.
struct Specs {
    ty: *mut cty.CType,
    sc: i32,         // the storage-class specifier (a cast.SC_ bit), or 0
    thread: bool,    // _Thread_local (with or without static or extern)
    funcs: i32,      // cast.FS_ bits
    tag_decl: bool,  // a structure, union or enumeration specifier that declares something
    sp: u.Span,
    quals: i32,       // the qualifiers among the specifiers
    align: u64,       // the strictest alignment an alignment specifier asks for, or 0
    has_align: bool,  // an alignment specifier is among them
    align_sp: u.Span,
    constexpr_: bool,      // constexpr (C23)
    infer: bool,           // auto without a type specifier (C23): the type is the initializer's
    tdef: *mut cast.CSym,  // the typedef name among them, or nil (debug information: cgen_debug.ax)
}

// The parameters of the last function declarator at a declarator's
// identifier (derivs[0]): a definition's.
let mut g_params: u.List.[*mut cast.CSym] = u.List.[*mut cast.CSym].{ data: @ptr_from_int(*mut *mut cast.CSym, 0),
                                                                      len: 0, cap: 0 };
let mut g_kr_ids: bool = false;    // ... given as an identifier list
let mut g_defining: bool = false;  // the declarator is a function definition's (not its parameters')

// -----------------------------------------------------------------------------
// Declaration specifiers (6.7.1 - 6.7.4)
// -----------------------------------------------------------------------------

struct Counts {
    void_: i32,
    char_: i32,
    short_: i32,
    int_: i32,
    long_: i32,
    float_: i32,
    double_: i32,
    signed_: i32,
    unsigned_: i32,
    bool_: i32,
    int64: i32,
    valist: i32,
    complex_: i32,   // _Complex
    bitint: i32,     // _BitInt(width)
    int128: i32,     // __int128 (a GNU dialect)
    dec: i32,        // _Decimal32, _Decimal64, _Decimal128 (C23)
    dec_rank: i32,   // the last one's (cty.dec_rank)
    xfloat: i32,     // _Float16 ... _Float64x, __float128 (Annex H)
    xfloat_kw: i32,  // which (the last seen)
    imag: i32,       // _Imaginary (Annex G)
    width: i32,      // its width (0: in error, reported)
    width_sp: u.Span,
    other: i32,  // a tag, typedef name or other type specifier
}

fn specifiers(ds: *mut cast.DeclSpec, ctx: i32, lone: bool) Specs {
    let mut r = Specs.{ ty: cty.t_int, sc: 0, thread: false, funcs: ds.funcs, tag_decl: false, sp: ds.span, quals: 0,
                        align: 0, has_align: false, align_sp: ds.span, constexpr_: false, infer: false,
                        tdef: u.nil.[cast.CSym]() };
    let mut scs: i32 = 0;
    let mut c = Counts.{ void_: 0, char_: 0, short_: 0, int_: 0, long_: 0, float_: 0, double_: 0, signed_: 0,
                         unsigned_: 0, bool_: 0, int64: 0, valist: 0, complex_: 0, bitint: 0, int128: 0, dec: 0,
                         dec_rank: 0, xfloat: 0, xfloat_kw: 0, imag: 0, width: 0, width_sp: ds.span, other: 0 };
    let mut other = cty.t_error;
    let mut td_seen = false;  // a typedef name, at td_span
    let mut td_span = ds.span;
    let mut qual_seen: i32 = 0;
    let mut atomic_sp = ds.span;  // (an _Atomic qualifier's, if qual_seen has it)
    let mut bad = false;
    let mut auto_type = false;
    dsp.attrs(&ds.attrs, dsp.AP_TYPE);
    for si in 0..ds.items.len {
        let s = ds.items.at(si);
        let k = s.kind;
        if k == cast.SpecKind.STORAGE {
            if s.kw == ct.K_THREAD_LOCAL {
                r.thread = true;
                continue;
            }
            let b = storage_bit(s.kw);
            if (scs & b) != 0 {
                cs.err(s.span, "C3006", u.f1("'%s' is repeated", dsp.sc_name(b)));
            }
            scs = scs | b;
        } else if k == cast.SpecKind.TYPE {
            let kw = s.kw;
            if kw == ct.K_VOID {
                c.void_ += 1;
            } else if kw == ct.K_CHAR {
                c.char_ += 1;
            } else if kw == ct.K_SHORT {
                c.short_ += 1;
            } else if kw == ct.K_INT {
                c.int_ += 1;
            } else if kw == ct.K_LONG {
                c.long_ += 1;
            } else if kw == ct.K_FLOAT {
                c.float_ += 1;
            } else if kw == ct.K_DOUBLE {
                c.double_ += 1;
            } else if kw == ct.K_SIGNED {
                c.signed_ += 1;
            } else if kw == ct.K_UNSIGNED {
                c.unsigned_ += 1;
            } else if kw == ct.K_BOOL {
                c.bool_ += 1;
            } else if kw == ct.K_INT64 {
                c.int64 += 1;
            } else if kw == ct.K_BUILTIN_VA_LIST {
                c.valist += 1;
            } else if kw == ct.K_COMPLEX {
                c.complex_ += 1;
            } else if kw == ct.K_IMAGINARY {
                c.imag += 1;  // (the imaginary types: Annex G.2)
            } else if kw == ct.K_AUTO_TYPE {
                auto_type = true;  // (a GNU dialect: the type of the initializer)
            } else if kw == ct.K_INT128 {
                c.int128 += 1;
            } else if (kw == ct.K_DECIMAL32) or (kw == ct.K_DECIMAL64) or (kw == ct.K_DECIMAL128) or
                      (kw == ct.K_DECIMAL64X) {
                c.dec += 1;
                c.dec_rank = 4;
                if kw == ct.K_DECIMAL32 {
                    c.dec_rank = 1;
                } else if kw == ct.K_DECIMAL64 {
                    c.dec_rank = 2;
                } else if kw == ct.K_DECIMAL64X {
                    c.dec_rank = 3;
                }
            } else if ((kw >= ct.K_FLOAT128) and (kw <= ct.K_FLOAT64X)) or (kw == ct.K_BF16) {
                c.xfloat += 1;
                c.xfloat_kw = kw;
            } else {
                cs.not_supported(s.span, u.f1("'%s'", cast.kw_text(kw)));
                bad = true;
            }
        } else if k == cast.SpecKind.QUAL {
            let q = qual_bit(s.kw);
            if q == cty.Q_ATOMIC {
                atomic_sp = s.span;
            } else if ((qual_seen & q) != 0) and (cs.std() < co.C99) and not cs.opts().gnu {
                cs.err(s.span, "C3006", u.f1("'%s' is repeated (allowed from C99)", cast.kw_text(s.kw)));
            }
            qual_seen = qual_seen | q;
        } else if k == cast.SpecKind.FUNC {
            // (checked where the declared identifier's type is known)
        } else if k == cast.SpecKind.ALIGN {
            let a = dsp.alignment(s);
            if (ctx == CTX_TYPENAME) and not dsp.in_compound {
                dsp.misplaced_alignment(s.span, "a type name");
            } else if ctx == CTX_PARAM {
                dsp.misplaced_alignment(s.span, "the declaration of a parameter");
            }
            if not r.has_align {
                r.align_sp = s.span;
            }
            r.has_align = true;
            if a > r.align {
                r.align = a;
            }
            if dsp.in_compound and (a > dsp.compound_align) {
                dsp.compound_align = a;
            }
        } else if k == cast.SpecKind.TAG {
            c.other += 1;
            other = tag_type(s.tag, lone);
            r.tag_decl = s.tag.has_body or lone;
        } else if k == cast.SpecKind.TYPEDEF_NAME {
            c.other += 1;
            let ts = cs.lookup(s.name);
            if u.notnil(ts) and (ts.kind == cast.SK_TYPEDEF) {
                other = ts.ty;
                r.tdef = ts;
                ts.used = true;
                catr.use_sym(ts, s.span);
                td_seen = true;
                td_span = s.span;
            } else {
                cs.err(s.span, "C3001", u.f1("'%s' is not a type name", s.name));
                bad = true;
            }
        } else if k == cast.SpecKind.TYPEOF {
            c.other += 1;
            other = typeof_type(s);
        } else if k == cast.SpecKind.BITINT {
            c.bitint += 1;
            c.width_sp = s.span;
            let w = cx.ice(s.e, "the width of _BitInt");
            s.e = w.e;
            if w.ok {
                c.width = csb.width_value(w.v, w.e.ty.is_signed);
            } else {
                bad = true;
            }
        } else {
            // _Atomic ( type-name ), the atomic type specifier
            c.other += 1;
            other = catm.specifier(type_name(s.tname), s.span);
            if cty.is_error(other) {
                bad = true;
            }
        }
    }
    let mut oq = other;
    while oq.kind == cty.TK_ARRAY {
        oq = oq.elem;  // (an array type's qualifiers are its elements')
    }
    if td_seen and ((oq.quals & qual_seen) != 0) and (cs.std() < co.C99) and not cs.opts().gnu {
        cs.err(td_span, "C3006", "a type qualifier is repeated, through a typedef name (allowed from C99)");
    }
    let st = dsp.storage(scs, ds);
    r.sc = st.sc;
    r.constexpr_ = st.constexpr_;
    r.infer = st.infer;
    if auto_type {
        let kws = c.void_ + c.char_ + c.short_ + c.int_ + c.long_ + c.float_ + c.double_ + c.signed_ + c.unsigned_ +
                  c.bool_ + c.int64 + c.valist + c.bitint + c.other + c.int128 + c.complex_ + c.dec + c.xfloat + c.imag;
        if kws > 0 {
            cs.err(ds.span, "C3005", "'__auto_type' with another type specifier");
            r.ty = cty.t_error;
            return r;
        }
        r.infer = true;
        r.quals = qual_seen & (cty.Q_CONST | cty.Q_VOLATILE | cty.Q_RESTRICT);
        return r;
    }
    if r.thread and (ctx != CTX_MEMBER) and (ctx != CTX_TYPENAME) {
        dsp.thread_local(ds, st, (ctx == CTX_BLOCK) or (ctx == CTX_FOR), ctx == CTX_PARAM);
    }
    if (ctx == CTX_PARAM) and r.constexpr_ {
        cs.err(ds.span, "C3073", "a parameter cannot be declared 'constexpr'");
    }
    if bad {
        r.ty = cty.t_error;
        return r;
    }
    let mut t = base_type(&c, other, ds.span);
    r.quals = qual_seen & (cty.Q_CONST | cty.Q_VOLATILE | cty.Q_RESTRICT);
    if (qual_seen & cty.Q_ATOMIC) != 0 {
        t = catm.qualifier(t, atomic_sp);
    }
    if cty.is_func(t) and (r.quals != 0) {
        // (6.7.3p8: undefined)
        cs.err(ds.span, "C3006", u.f1("type qualifiers on a function type (%s, a typedef name's)", cs.tq(t)));
        r.quals = 0;
    }
    r.ty = cty.qualify(t, r.quals);
    if (ctx == CTX_MEMBER) or (ctx == CTX_TYPENAME) {
        r.sc = 0;  // (the parser reported any)
    }
    return r;
}

// typeof and typeof_unqual (C23 6.7.2.5): the type of a type name, or of an
// expression (not evaluated, not converted: an array stays an array).
fn typeof_type(s: *mut cast.Spec) *mut cty.CType {
    let mut t = cty.t_error;
    if u.notnil(s.tname) {
        t = type_name(s.tname);
    } else {
        let x = cx.check(s.e);
        s.e = x;
        if u.notnil(cb.member(x)) {
            cs.err(x.span, "C3070", u.f1("'%s' of a bit-field", cast.kw_text(s.kw)));
        } else if u.notnil(x.ty) {
            t = x.ty;
        }
    }
    if s.kw == ct.K_TYPEOF_UNQUAL {
        return unqual_array(t);
    }
    return t;
}

// t without qualifiers; an array's are its elements' (C23 6.7.4.1p10: an
// array and its element type are qualified alike), so they go too.
fn unqual_array(t: *mut cty.CType) *mut cty.CType {
    if t.kind == cty.TK_ARRAY {
        if t.vla {
            return cty.vla_of(unqual_array(t.elem), t.vexpr);  // (the same length: evaluated once)
        }
        return cty.array_of(unqual_array(t.elem), t.len, t.has_len);
    }
    return cty.unqual(t);
}

fn storage_bit(kw: i32) i32 {
    if kw == ct.K_TYPEDEF {
        return cast.SC_TYPEDEF;
    }
    if kw == ct.K_EXTERN {
        return cast.SC_EXTERN;
    }
    if kw == ct.K_STATIC {
        return cast.SC_STATIC;
    }
    if kw == ct.K_AUTO {
        return cast.SC_AUTO;
    }
    if kw == ct.K_REGISTER {
        return cast.SC_REGISTER;
    }
    return cast.SC_CONSTEXPR;
}

fn qual_bit(kw: i32) i32 {
    if kw == ct.K_CONST {
        return cty.Q_CONST;
    }
    if kw == ct.K_VOLATILE {
        return cty.Q_VOLATILE;
    }
    if kw == ct.K_RESTRICT {
        return cty.Q_RESTRICT;
    }
    return cty.Q_ATOMIC;
}

// The type the specifiers name that have an interchange or extended floating
// type (_Float32 ... : Annex H.5.1, with _Complex too) or _Imaginary (Annex
// G.2: float, double, long double _Imaginary; and of those of Annex H).
fn float_type(c: *Counts, sp: u.Span) *mut cty.CType {
    let rest = c.void_ + c.char_ + c.short_ + c.int_ + c.signed_ + c.unsigned_ + c.bool_ + c.int64 + c.valist +
               c.other + c.bitint + c.int128 + c.dec;
    if (rest > 0) or (c.xfloat > 1) or (c.imag > 1) or (c.complex_ > 1) or ((c.imag > 0) and (c.complex_ > 0)) {
        return bad_combination(sp);
    }
    let mut r = cty.t_error;
    if c.xfloat == 1 {
        if c.float_ + c.double_ + c.long_ > 0 {
            return bad_combination(sp);
        }
        let k = c.xfloat_kw;
        if k == ct.K_BF16 {
            r = cty.t_bf16;
        } else if k == ct.K_FLOAT16 {
            r = cty.t_float16;
        } else if k == ct.K_FLOAT32 {
            r = cty.t_float32;
        } else if k == ct.K_FLOAT64 {
            r = cty.t_float64;
        } else if k == ct.K_FLOAT32X {
            r = cty.t_float32x;
        } else if k == ct.K_FLOAT64X {
            r = cty.t_float64x;
        } else {
            r = cty.t_float128;
        }
        cty.note_float_use(r);
    } else {
        if (c.float_ + c.double_ != 1) or (c.long_ > c.double_) {
            if c.float_ + c.double_ + c.long_ == 0 {
                cs.err(sp, "C3005", "'_Imaginary' needs a real floating type: float, double or long double _Imaginary");
                return cty.t_error;
            }
            return bad_combination(sp);
        }
        r = cty.t_double;
        if c.float_ == 1 {
            r = cty.t_float;
        } else if c.long_ == 1 {
            r = cty.t_ldouble;
        }
    }
    if c.complex_ == 1 {
        return cty.complex_of(r);
    }
    if c.imag == 1 {
        return cty.imaginary_of(r);
    }
    return r;
}

// The type the type specifiers name (6.7.2p2), or the error type (reported).
fn base_type(c: *Counts, other: *mut cty.CType, sp: u.Span) *mut cty.CType {
    if c.dec > 0 {
        // _Decimal32, _Decimal64, _Decimal128, _Decimal64x: alone (6.7.2p2;
        // no complex decimal types, H.2.6)
        let rest = c.void_ + c.char_ + c.short_ + c.int_ + c.long_ + c.float_ + c.double_ + c.signed_ + c.unsigned_ +
                   c.bool_ + c.int64 + c.valist + c.other + c.bitint + c.int128 + c.complex_ + c.xfloat + c.imag;
        if (c.dec > 1) or (rest > 0) {
            return bad_combination(sp);
        }
        return cty.dec_of_rank(c.dec_rank);
    }
    if (c.imag > 0) or (c.xfloat > 0) {
        return float_type(c, sp);
    }
    if c.complex_ > 0 {
        // float _Complex, double _Complex, long double _Complex, in any
        // order (6.7.2p2)
        let rest = c.void_ + c.char_ + c.short_ + c.int_ + c.signed_ + c.unsigned_ + c.bool_ + c.int64 + c.valist +
                   c.other + c.bitint + c.int128;
        if (c.complex_ > 1) or (rest > 0) or ((c.float_ + c.double_) != 1) or (c.long_ > c.double_) {
            if (c.complex_ == 1) and (rest == 0) and (c.float_ + c.double_ + c.long_ == 0) {
                cs.err(sp, "C3005", "'_Complex' needs a real floating type: float, double or long double _Complex");
                return cty.t_error;
            }
            return bad_combination(sp);
        }
        if c.float_ == 1 {
            return cty.t_cfloat;
        }
        if c.long_ == 1 {
            return cty.t_cldouble;
        }
        return cty.t_cdouble;
    }
    let kws = c.void_ + c.char_ + c.short_ + c.int_ + c.long_ + c.float_ + c.double_ + c.signed_ + c.unsigned_ +
              c.bool_ + c.int64 + c.valist;
    if c.other > 0 {
        if (c.other > 1) or (kws > 0) or (c.bitint > 0) or (c.int128 > 0) {
            return bad_combination(sp);
        }
        return other;
    }
    if c.int128 > 0 {
        // __int128, signed or unsigned (a GNU dialect)
        if (c.int128 > 1) or (kws != c.signed_ + c.unsigned_) or (kws > 1) or (c.bitint > 0) {
            return bad_combination(sp);
        }
        let t = cty.int128(c.unsigned_ == 0);
        if u.isnil(t) {
            cs.not_supported(sp, "'__int128'");
            return cty.t_error;
        }
        return t;
    }
    if c.bitint > 0 {
        if (c.bitint > 1) or (kws != c.signed_ + c.unsigned_) or (kws > 1) {
            return bad_combination(sp);
        }
        return csb.bitint_type(c.width, c.unsigned_ == 0, c.width_sp);
    }
    if kws == 0 {
        return cty.t_int;  // implicit int (C89; the parser reported it later)
    }
    let sign = c.signed_ + c.unsigned_;
    if (sign > 1) or (c.int_ > 1) or (c.short_ > 1) or (c.long_ > 2) or (c.char_ > 1) {
        return bad_combination(sp);
    }
    let alone = (c.void_ + c.float_ + c.double_ + c.bool_ + c.valist) > 0;
    if alone {
        if c.void_ + c.float_ + c.bool_ + c.valist + c.double_ != 1 {
            return bad_combination(sp);
        }
        if c.double_ == 1 {
            if kws - c.long_ != 1 or c.long_ > 1 {
                return bad_combination(sp);
            }
            if c.long_ == 1 {
                return cty.t_ldouble;
            }
            return cty.t_double;
        }
        if kws != 1 {
            return bad_combination(sp);
        }
        if c.void_ == 1 {
            return cty.t_void;
        }
        if c.float_ == 1 {
            return cty.t_float;
        }
        if c.bool_ == 1 {
            return cty.t_bool;
        }
        return csbi.va_list_type();  // __builtin_va_list
    }
    if c.int64 > 0 {
        if (c.int64 > 1) or (kws - sign != 1) {
            return bad_combination(sp);
        }
        return pick_sign(cty.t_int64, c.unsigned_ == 0);
    }
    if c.char_ == 1 {
        if c.short_ + c.int_ + c.long_ > 0 {
            return bad_combination(sp);
        }
        if c.signed_ == 1 {
            return cty.t_schar;
        }
        if c.unsigned_ == 1 {
            return cty.t_uchar;
        }
        return cty.t_char;
    }
    if (c.short_ == 1) and (c.long_ > 0) {
        return bad_combination(sp);
    }
    let sg = c.unsigned_ == 0;
    if c.short_ == 1 {
        return pick_sign(cty.t_short, sg);
    }
    if c.long_ == 2 {
        return pick_sign(cty.t_llong, sg);
    }
    if c.long_ == 1 {
        return pick_sign(cty.t_long, sg);
    }
    return pick_sign(cty.t_int, sg);
}

fn pick_sign(t: *mut cty.CType, sg: bool) *mut cty.CType {
    if sg {
        return cty.to_signed(t);
    }
    return cty.to_unsigned(t);
}

fn bad_combination(sp: u.Span) *mut cty.CType {
    cs.err(sp, "C3005", "an invalid combination of type specifiers");
    return cty.t_error;
}

// -----------------------------------------------------------------------------
// Structures, unions and enumerations (6.7.2.1 - 6.7.2.3)
// -----------------------------------------------------------------------------

fn tag_kind(kw: i32) i32 {
    if kw == ct.K_STRUCT {
        return cty.TK_STRUCT;
    }
    if kw == ct.K_UNION {
        return cty.TK_UNION;
    }
    return cty.TK_ENUM;
}

fn kind_word(k: i32) []u8 {
    if k == cty.TK_STRUCT {
        return "struct";
    }
    if k == cty.TK_UNION {
        return "union";
    }
    return "enum";
}

// The type a struct-or-union or enum specifier names (lone: the whole
// declaration is `struct S;`).
fn tag_type(ts: *mut cast.TagSpec, lone: bool) *mut cty.CType {
    if u.notnil(ts.ty) {
        return ts.ty;
    }
    let kind = tag_kind(ts.kw);
    dsp.attrs(&ts.attrs, dsp.AP_TAG);
    if kind == cty.TK_ENUM {
        let et = dsp.enum_tag(ts, lone);
        tag_attrs(ts, et, ts.has_body or lone or u.notnil(ts.fixed));
        return et;
    }
    let named = ts.name.len > 0;
    let mut t = u.nil.[cty.CType]();
    if ts.has_body or lone {
        if named {
            t = cs.lookup_tag_here(ts.name);
        }
        if u.notnil(t) {
            if t.kind != kind {
                cs.err_note(ts.name_span, "C3011", u.f2("'%s' was declared as %s", ts.name,
                                                        u.cat2(
                                                            "a different kind of tag (",
                                                            u.cat2(kind_word(t.kind), ")"))), t.tag.span,
                            "declared here");
                ts.ty = cty.t_error;
                return ts.ty;
            }
            if ts.has_body and t.tag.complete and (cs.std() >= co.C23) {
                return redefined_record(ts, t, kind);
            }
            if ts.has_body and (t.tag.complete or t.tag.defining) {
                cs.err_note(ts.name_span, "C3002", u.f2("redefinition of '%s %s'", kind_word(kind), ts.name),
                            t.tag.span, "defined before here");
                ts.ty = cty.t_error;
                return ts.ty;
            }
        } else if (kind == cty.TK_ENUM) and not ts.has_body {
            return undefined_enum(ts);
        } else {
            t = cty.new_tagged(kind, ts.name, ts.name_span);
            if not named {
                t.tag.span = ts.span;
            }
            if named {
                cs.declare_tag(ts.name, t);
            }
        }
    } else {
        t = cs.lookup_tag(ts.name);
        if u.notnil(t) {
            if t.kind != kind {
                cs.err_note(ts.name_span, "C3011", u.f2("'%s' is not a %s tag", ts.name, kind_word(kind)), t.tag.span,
                            "declared here");
                ts.ty = cty.t_error;
                return ts.ty;
            }
        } else if kind == cty.TK_ENUM {
            return undefined_enum(ts);
        } else {
            t = cty.new_tagged(kind, ts.name, ts.name_span);
            cs.declare_tag(ts.name, t);
        }
    }
    ts.ty = t;
    tag_attrs(ts, t, ts.has_body or lone);
    if ts.has_body {
        t.tag.in_block = not cs.at_file_scope();
        record_body(t, ts);
    }
    return t;
}

// C23 6.7.2.3: a structure or union defined again in the same scope is
// the same type if the definitions are compatible (6.2.7p1); the second
// is read into a type of its own, then compared.
fn redefined_record(ts: *mut cast.TagSpec, t: *mut cty.CType, kind: i32) *mut cty.CType {
    let nt = cty.new_tagged(kind, ts.name, ts.name_span);
    ts.ty = nt;
    record_body(nt, ts);
    if not cty.compatible(nt, t) {
        cs.err_note(ts.name_span, "C3002", u.f2("redefinition of '%s %s' with other members (or other types of them)",
                                                kind_word(kind), ts.name), t.tag.span, "defined before here");
        ts.ty = cty.t_error;
        return ts.ty;
    }
    ts.ty = t;
    catr.mark_tag(t, &ts.attrs);
    return t;
}

// What the attributes of tag specifier ts say of its type t (declares: it
// defines or declares the tag), or, for a use, a warning if it is deprecated.
fn tag_attrs(ts: *mut cast.TagSpec, t: *mut cty.CType, declares: bool) void {
    if cty.is_error(t) {
        return;
    }
    if declares {
        catr.mark_tag(t, &ts.attrs);
        cgn.mark_tag(t, &ts.attrs);
        return;
    }
    if ts.attrs.len > 0 {
        cs.err(ts.attrs.get(0).span, "C3077",
               u.f1("attributes in '%s' can appear only where it is defined, or in a declaration of the tag alone",
                    u.cat3(kind_word(tag_kind(ts.kw)), " ", ts.name)));
    }
    catr.use_tag(t, ts.name_span);
}

fn undefined_enum(ts: *mut cast.TagSpec) *mut cty.CType {
    cs.err(ts.name_span, "C3011", u.f1("'enum %s' is not defined", ts.name));
    ts.ty = cty.t_error;
    return ts.ty;
}

fn record_body(t: *mut cty.CType, ts: *mut cast.TagSpec) void {
    let ti = t.tag;
    ti.defining = true;
    let mut names = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    let mut flex = u.nil.[cty.Member]();
    let mut named: i32 = 0;
    for md in ts.members.items() {
        if md.kind == cast.DeclKind.STATIC_ASSERT {
            static_assert(md);
            continue;
        }
        if md.kind != cast.DeclKind.DECL {
            continue;
        }
        let sp = specifiers(md.specs, CTX_MEMBER, md.decls.len == 0);
        dsp.attrs(&md.attrs, dsp.AP_MEMBER);
        dsp.attrs(&md.specs.gattrs, dsp.AP_MEMBER);
        if md.decls.len == 0 {
            // an anonymous structure or union (C11)
            let at = sp.ty;
            if cty.is_record(at) and (at.tag.name.len == 0) {
                add_member(ti, "", md.span, at);
                for m in at.tag.members.items() {
                    if m.name.len > 0 {
                        check_dup(&mut names, m.name, m.span);
                    }
                }
            } else if not cty.is_error(at) {
                cs.err(md.span, "C3010", "a member declaration that declares no member");
            }
            continue;
        }
        for d in md.decls.items() {
            dsp.attrs(&d.attrs, dsp.AP_MEMBER);
            let mbase = cgn.mode_type(sp.ty, &md.specs.gattrs, &md.attrs, &d.attrs);
            if u.notnil(d.width) {
                let bt = derive(mbase, d, CTX_MEMBER);
                d.ty = bt;
                let w = dsp.bit_width(bt, d);
                if sp.has_align {
                    dsp.misplaced_alignment(sp.align_sp, u.pick(d.name.len > 0,
                                                                u.f1("the declaration of the bit-field '%s'", d.name),
                                                                "an unnamed bit-field"));
                }
                if w < 0 {
                    continue;
                }
                if u.notnil(flex) {
                    cs.err(flex.span, "C3008", "a flexible array member that is not the last member");
                    flex = u.nil.[cty.Member]();
                }
                if d.name.len > 0 {
                    check_dup(&mut names, d.name, d.name_span);
                    named += 1;
                }
                let mut msp = d.span;
                if d.name.len > 0 {
                    msp = d.name_span;
                }
                add_member(ti, d.name, msp, bt);
                let bm = ti.members.last();
                catr.mark_member(bm, &md.attrs);
                catr.mark_member(bm, &d.attrs);
                gnu_member(bm, md, d);
                bm.is_bitfield = true;
                bm.bit_width = w;
                continue;
            }
            let mt = derive(mbase, d, CTX_MEMBER);
            d.ty = mt;
            if cty.is_error(mt) or not vla.check_member(d, mt) {
                continue;
            }
            if u.notnil(flex) {
                cs.err(flex.span, "C3008", "a flexible array member that is not the last member");
                flex = u.nil.[cty.Member]();
            }
            if cty.is_func(mt) {
                cs.err(d.name_span, "C3008", u.f1("the member '%s' has a function type", d.name));
                continue;
            }
            let is_flex = (mt.kind == cty.TK_ARRAY) and not mt.has_len and not mt.vla and cty.is_complete(mt.elem);
            if is_flex and (cs.std() < co.C99) and not cs.opts().gnu {
                cs.err(d.name_span, "C3007",
                       u.f1("the member '%s' has incomplete type (flexible array members are a C99 feature)", d.name));
                continue;
            }
            if not is_flex and not cty.is_complete(mt) {
                cs.err(d.name_span, "C3007", u.f2("the member '%s' has incomplete type %s", d.name, cs.tq(mt)));
                continue;
            }
            if cty.is_record(mt) and mt.tag.has_flex {
                if ti.kind == cty.TK_STRUCT {
                    cs.err(d.name_span, "C3008", u.f1("the member '%s' has a flexible array member", d.name));
                } else {
                    ti.has_flex = true;  // (a union may hold one: 6.7.2.1p3; it is then as constrained)
                }
            }
            check_dup(&mut names, d.name, d.name_span);
            add_member(ti, d.name, d.name_span, mt);
            catr.mark_member(ti.members.last(), &md.attrs);
            catr.mark_member(ti.members.last(), &d.attrs);
            gnu_member(ti.members.last(), md, d);
            named += 1;
            if sp.has_align and dsp.check_alignment(sp.align, sp.align_sp, mt, d.name) {
                ti.members.last().align = sp.align;
            }
            if is_flex {
                if (ti.kind == cty.TK_UNION) or (named == 1) {
                    cs.err(d.name_span, "C3008",
                           u.f1("the flexible array member '%s' must follow another member of a structure", d.name));
                }
                flex = ti.members.last();
            }
        }
    }
    ti.defining = false;
    if cs.opts().gnu or cs.opts().declspec {
        // (a GNU dialect, or __declspec on Windows: packed, aligned, #pragma
        // pack: csema_bits.ax)
        let n = cgn.note_of_tag(ti);
        if u.notnil(n) {
            ti.packed = n.packed;
            ti.min_align = n.aligned;
        }
        ti.pack = ts.pack;
    } else if ts.pack != 0 {
        ti.pack = ts.pack;
    }
    cb.layout(ti);
}

// What the GNU attributes of member declaration md and its declarator d
// say of member m: packed, aligned (a GNU dialect).
fn gnu_member(m: *mut cty.Member, md: *mut cast.Decl, d: *mut cast.Declarator) void {
    if not cs.opts().gnu and not cs.opts().declspec {
        return;
    }
    cgn.mark_member(m, &md.attrs);
    cgn.mark_member(m, &d.attrs);
    cgn.mark_member(m, &md.specs.gattrs);
    let n = cgn.note_of_member(m);
    if u.isnil(n) {
        return;
    }
    m.packed = n.packed;
    if n.aligned > m.align {
        m.align = n.aligned;
    }
}

fn check_dup(names: *mut u.SymMap.[i32], name: []u8, sp: u.Span) void {
    if names.get(name) != 0 {
        cs.err(sp, "C3002", u.f1("a duplicate member '%s'", name));
        return;
    }
    names.put(name, 1);
}

fn add_member(ti: *mut cty.TagInfo, name: []u8, sp: u.Span, t: *mut cty.CType) void {
    let m = u.new.[cty.Member]();
    m.name = name;
    m.span = sp;
    m.ty = t;
    m.index = @int_cast(i32, ti.members.len);
    ti.members.push(m);
}

// -----------------------------------------------------------------------------
// Declarators (6.7.6)
// -----------------------------------------------------------------------------

// The type declarator d gives the specifiers' type `base`.
fn derive(base: *mut cty.CType, d: *mut cast.Declarator, ctx: i32) *mut cty.CType {
    let mut t = base;
    let n = d.derivs.len;
    let mut k = n;
    while k > 0 {
        k -= 1;
        if cty.is_error(t) {
            return t;
        }
        let dv = d.derivs.at(k);
        if dv.kind == cast.DerivKind.FUNCTION {
            dsp.attrs(&dv.attrs, dsp.AP_FUNCTYPE);
        } else {
            dsp.attrs(&dv.attrs, dsp.AP_TYPE);
        }
        if dv.kind == cast.DerivKind.POINTER {
            if ((dv.quals & cast.Q_RESTRICT) != 0) and cty.is_func(t) {
                cs.err(dv.span, "C3006", "'restrict' qualifies a pointer to a function");
            }
            if dv.dup_quals and (cs.std() < co.C99) and not cs.opts().gnu {
                cs.err(dv.span, "C3006", "a repeated type qualifier (allowed from C99)");
            }
            t = cty.qualify(cty.pointer_to(t), dv.quals & (cty.Q_CONST | cty.Q_VOLATILE | cty.Q_RESTRICT));
            if (dv.quals & cast.Q_ATOMIC) != 0 {
                t = catm.qualifier(t, dv.span);
            }
        } else if dv.kind == cast.DerivKind.ARRAY {
            t = array_deriv(t, dv, (ctx == CTX_PARAM) and (k == 0), ctx == CTX_PARAM);
        } else {
            if cty.is_func(t) or (t.kind == cty.TK_ARRAY) {
                cs.err(dv.span, "C3008",
                       u.f1("a function returning %s", u.pick(cty.is_func(t), "a function", "an array")));
                return cty.t_error;
            }
            t = function_deriv(t, dv, k == 0);
        }
    }
    if ((t.quals & cty.Q_RESTRICT) != 0) and ((t.kind != cty.TK_POINTER) or cty.is_func(t.elem)) {
        cs.err(d.span, "C3006", u.f1("'restrict' qualifies %s, not a pointer to an object type", cs.tq(t)));
    }
    return t;
}

fn array_deriv(t: *mut cty.CType, dv: *mut cast.Deriv, outer_param: bool, in_param: bool) *mut cty.CType {
    if cty.is_func(t) {
        cs.err(dv.span, "C3008", "an array of functions");
        return cty.t_error;
    }
    if not cty.is_complete(t) {
        cs.err(dv.span, "C3007", u.f1("an array of elements of incomplete type %s", cs.tq(t)));
        return cty.t_error;
    }
    if cty.is_record(t) and t.tag.has_flex {
        cs.err(dv.span, "C3008", "an array of structures with a flexible array member");
    }
    if (cty.size_of(t) % cty.align_of(t)) != 0 {
        // (a GNU dialect's typedef aligned beyond its type's size: the
        // elements after the first would not be aligned)
        cs.err(dv.span, "C3008", u.f2("an array of elements of type %s, aligned to %s, more than their size", cs.tq(t),
                                      u.udec(cty.align_of(t))));
        return cty.t_error;
    }
    if ((dv.quals != 0) or dv.is_static) and not outer_param {
        cs.err(dv.span, "C3008",
               "'static' or a type qualifier in an array declarator that is not a parameter's outermost one");
    }
    if dv.is_star {
        return vla.star(t, dv, in_param);
    }
    if u.isnil(dv.size) {
        return cty.array_of(t, 0, false);
    }
    let x = cx.rv(dv.size);
    dv.size = x;
    if u.isnil(x.ty) or cty.is_error(x.ty) {
        return cty.t_error;
    }
    if not cty.is_integer(x.ty) {
        cs.err(x.span, "C3009", u.f1("the size of an array has type %s, not an integer type", cs.tq(x.ty)));
        return cty.t_error;
    }
    if not x.is_const or not csi.is_ice(x) {
        // (a size that is a constant but not an integer constant expression too)
        let a = vla.array(t, x);
        dv.size = @ptr_cast(*mut cast.Expr, a.vexpr);
        return a;
    }
    if not cx.const_in_range(x) {
        return cty.t_error;
    }
    if not cw.fits64(x) {
        cs.err(x.span, "C3009", u.f1("the size of an array is %s, out of range", cw.text(x)));
        return cty.t_error;
    }
    if (x.cval == 0) and cs.opts().gnu {
        return cty.array_of(t, 0, true);  // (a GNU dialect's zero-length array)
    }
    if (x.ty.is_signed and (@bit_cast(i64, x.cval) < 0)) or (x.cval == 0) {
        cs.err(x.span, "C3009",
               u.f1(
                   "the size of an array is %s; it must be greater than zero",
                   u.pick(x.ty.is_signed, u.dec(@bit_cast(i64, x.cval)), u.udec(x.cval))));
        return cty.t_error;
    }
    let es = cty.size_of(t);
    if (es != 0) and (x.cval > (@as(u64, 1) << 47) / es) {
        cs.err(x.span, "C3009", "the array is too large");
        return cty.t_error;
    }
    return cty.array_of(t, x.cval, true);
}

// A function returning ret; at_name: the declarator's innermost derivation,
// whose parameters become g_params.
fn function_deriv(ret: *mut cty.CType, dv: *mut cast.Deriv, at_name: bool) *mut cty.CType {
    let mut syms = u.List.[*mut cast.CSym].empty();
    let mut types = u.List.[*mut cty.CType].empty();
    let mut proto = true;
    if dv.id_list {
        proto = false;
        if (dv.ids.len > 0) and not (at_name and g_defining) {
            // (6.7.5.3p3: an identifier list only in a function definition's declarator)
            cs.err(dv.ids.at(0).span, "C3008", "an identifier list in a function declarator that is not a definition");
        }
        let mut seen = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
        for id in dv.ids.items() {
            if seen.get(id.name) != 0 {
                cs.err(id.span, "C3002", u.f1("a second parameter named '%s'", id.name));
            }
            seen.put(id.name, 1);
            let s = cs.new_sym(cast.SK_OBJECT, id.name, id.span, cty.t_int);
            s.is_param = true;
            syms.push(s);
        }
    } else if dv.empty {
        proto = cs.std() >= co.C23;
    } else {
        let defining = g_defining;
        g_defining = false;
        cs.push_scope();
        let ps = dv.params.items();
        for i in 0..ps.len {
            let p = ps[i];
            let sp = specifiers(p.specs, CTX_PARAM, false);
            if (sp.sc != 0) and (sp.sc != cast.SC_REGISTER) {
                cs.err(p.specs.span, "C3006", "a parameter's only storage-class specifier can be 'register'");
            }
            let pt = derive(cgn.mode_type(sp.ty, &p.specs.gattrs, &p.attrs, &p.decl.attrs), p.decl, CTX_PARAM);
            p.decl.ty = pt;
            if cty.is_void(pt) and (ps.len == 1) and (p.decl.name.len == 0) and (p.decl.derivs.len == 0) and
               (pt.quals == 0) and not dv.variadic {
                break;  // (void)
            }
            if cty.is_void(pt) {
                cs.err(p.span, "C3008", "a parameter of type void");
            }
            let adj = adjust_param(pt, p.decl);
            let s = cs.new_sym(cast.SK_OBJECT, p.decl.name, p.decl.name_span, adj);
            s.is_param = true;
            if (p.decl.derivs.len > 0) and (p.decl.derivs.at(0).kind == cast.DerivKind.ARRAY) and
               p.decl.derivs.at(0).is_static and (pt.kind == cty.TK_ARRAY) {
                // `[static n]` (6.7.6.3p7): at least n elements, so not null
                let mut n: u64 = 0;
                if pt.has_len and not pt.vla {
                    n = cty.size_of(pt);
                }
                catr.set_static_param(s, n);
            }
            cdbg.note_typedef_use(s, sp.tdef);
            if sp.sc == cast.SC_REGISTER {
                csm.set_register(s);
            }
            dsp.attrs(&p.attrs, dsp.AP_OBJECT);
            dsp.attrs(&p.decl.attrs, dsp.AP_OBJECT);
            dsp.attrs(&p.specs.gattrs, dsp.AP_OBJECT);
            p.decl.sym = s;
            catr.mark_sym(s, &p.attrs);
            catr.mark_sym(s, &p.decl.attrs);
            catr.mark_sym(s, &p.specs.gattrs);
            if p.decl.name.len > 0 {
                let prior = cs.lookup_here(p.decl.name);
                if u.notnil(prior) {
                    cs.err_note(p.decl.name_span, "C3002", u.f1("a second parameter named '%s'", p.decl.name),
                                prior.span, "the first");
                }
                cs.declare(p.decl.name, s);
            }
            syms.push(s);
            types.push(cty.unqual_keep_atomic(adj));
        }
        cs.pop_scope();
        g_defining = defining;
    }
    if at_name {
        g_params = syms;
        g_kr_ids = dv.id_list;
    }
    return cty.function(ret, types.items(), proto, dv.variadic);
}

// A parameter's type adjusted (6.7.6.3p7-8): arrays to pointers (with the
// qualifiers of the array declarator), functions to pointers.
fn adjust_param(t: *mut cty.CType, d: *cast.Declarator) *mut cty.CType {
    if t.kind == cty.TK_ARRAY {
        let mut q: i32 = 0;
        if (d.derivs.len > 0) and (d.derivs.at(0).kind == cast.DerivKind.ARRAY) {
            q = d.derivs.at(0).quals & (cty.Q_CONST | cty.Q_VOLATILE | cty.Q_RESTRICT | cty.Q_ATOMIC);
        }
        return cty.qualify(cty.pointer_to(t.elem), q);
    }
    if cty.is_func(t) {
        return cty.pointer_to(t);
    }
    return t;
}

/// The type of a type name (6.7.7).
pub fn type_name(tn: *mut cast.TypeName) *mut cty.CType {
    if u.notnil(tn.ty) {
        return tn.ty;
    }
    dsp.attrs(&tn.specs.gattrs, dsp.AP_TYPE);
    let sp = specifiers(tn.specs, CTX_TYPENAME, false);
    let t = derive(sp.ty, tn.decl, CTX_TYPENAME);
    tn.ty = t;
    return t;
}

// -----------------------------------------------------------------------------
// Declarations
// -----------------------------------------------------------------------------

/// An external declaration (6.9).
pub fn external(d: *mut cast.Decl) void {
    cs.fp_dir(d.fp);
    if d.kind == cast.DeclKind.DECL {
        declaration(d, CTX_FILE);
    } else if d.kind == cast.DeclKind.FUNC_DEF {
        function_def(d);
    } else if d.kind == cast.DeclKind.STATIC_ASSERT {
        static_assert(d);
    } else if d.kind == cast.DeclKind.ATTR {
        dsp.attrs(&d.attrs, dsp.AP_NOTHING);
    } else if d.kind == cast.DeclKind.ASM {
        csa.toplevel(d.asm);
        cs.unit().asms.push(d.asm);
    }
}

/// A declaration in a block.
pub fn block_decl(d: *mut cast.Decl) void {
    if d.kind == cast.DeclKind.DECL {
        declaration(d, CTX_BLOCK);
    } else if d.kind == cast.DeclKind.FUNC_DEF {
        nested_def(d);
    } else if d.kind == cast.DeclKind.STATIC_ASSERT {
        static_assert(d);
    } else if d.kind == cast.DeclKind.ATTR {
        dsp.attrs(&d.attrs, dsp.AP_BLOCK_DECL);
    }
}

/// The declaration in the first clause of a for statement (6.8.5p3: only
/// objects with storage class auto or register).
pub fn for_decl(d: *mut cast.Decl) void {
    if d.kind != cast.DeclKind.DECL {
        block_decl(d);
        return;
    }
    let sc = d.specs.storage & ~(cast.SC_AUTO | cast.SC_REGISTER);
    if sc != 0 {
        cs.err(d.specs.span, "C3006", "a declaration in 'for' can only declare objects that are auto or register");
    }
    declaration(d, CTX_FOR);
    // (6.8.5p3: only objects; not a tag, an enumeration constant or a function)
    for s in d.specs.items.items() {
        if (s.kind != cast.SpecKind.TAG) or u.isnil(s.tag.ty) or cty.is_error(s.tag.ty) {
            continue;
        }
        let ts = s.tag;
        if (ts.name.len > 0) and (cs.lookup_tag_here(ts.name) == ts.ty) {
            cs.err(ts.name_span, "C3006", u.f2("a declaration in 'for' declares the tag '%s %s', not only objects",
                                               cast.kw_text(ts.kw), ts.name));
        } else if (ts.kw == ct.K_ENUM) and ts.has_body and (ts.enumerators.len > 0) {
            cs.err(ts.enumerators.get(0).span, "C3006",
                   "a declaration in 'for' declares enumeration constants, not only objects");
        }
    }
    for dcl in d.decls.items() {
        if u.notnil(dcl.ty) and cty.is_func(dcl.ty) {
            cs.err(dcl.name_span, "C3006", u.f1("a declaration in 'for' declares the function '%s', not an object",
                                                dcl.name));
        }
    }
}

fn declaration(d: *mut cast.Decl, ctx: i32) void {
    let lone = d.decls.len == 0;
    let sp = specifiers(d.specs, ctx, lone);
    if lone {
        if d.attrs.len > 0 {
            cs.err(d.attrs.get(0).span, "C3077",
                   "attributes before a declaration that declares no identifier (a tag's go after its keyword)");
        }
        if sp.infer or sp.constexpr_ {
            cs.err(d.span, u.pick(sp.infer, "C3074", "C3073"), u.f1("a declaration with '%s' that declares no object",
                                                                    u.pick(sp.infer, "auto", "constexpr")));
            return;
        }
        if not sp.tag_decl and not cty.is_error(sp.ty) {
            cs.err(d.span, "C3010", "a declaration that declares nothing");
        }
        return;
    }
    for dcl in d.decls.items() {
        declare_one(&sp, dcl, ctx, d);
    }
}

fn declare_one(sp: *Specs, dcl: *mut cast.Declarator, ctx: i32, d: *mut cast.Decl) void {
    let mut t = cty.t_error;
    if sp.infer {
        t = dsp.inferred(dcl, sp.quals, d.decls.len > 1, dcl == d.decls.get(0));
    } else {
        // (a GNU dialect: mode(m) changes the specifiers' integer type)
        let base = cgn.mode_type(sp.ty, &d.specs.gattrs, &d.attrs, &dcl.attrs);
        t = derive(base, dcl, ctx);
    }
    dcl.ty = t;
    let name = dcl.name;
    let mut what = dsp.AP_OBJECT;
    if sp.sc == cast.SC_TYPEDEF {
        what = dsp.AP_TYPEDEF;
    } else if cty.is_func(t) {
        what = dsp.AP_FUNC;
    }
    dsp.attrs(&d.attrs, what);
    dsp.attrs(&dcl.attrs, what);
    if dcl == d.decls.get(0) {
        dsp.attrs(&d.specs.gattrs, what);  // (GNU attributes among the specifiers: checked once)
    }
    if sp.has_align and ((sp.sc == cast.SC_TYPEDEF) or cty.is_func(t) or (sp.sc == cast.SC_REGISTER)) {
        let kind = u.pick(
            sp.sc == cast.SC_TYPEDEF, "the typedef", u.pick(cty.is_func(t), "the function", "the register object"));
        dsp.misplaced_alignment(sp.align_sp, u.f2("the declaration of %s '%s'", kind, name));
    }
    if sp.constexpr_ and ((sp.sc == cast.SC_TYPEDEF) or cty.is_func(t)) {
        cs.err(dcl.name_span, "C3073", u.f1("'%s' is declared 'constexpr', but is not an object", name));
    }
    if cty.is_vm(t) {
        vla.check_decl(name, dcl.name_span, t, sp.sc);
    }
    if sp.sc == cast.SC_TYPEDEF {
        if u.notnil(dcl.init) {
            cs.err(dcl.init.span, "C3033", u.f1("the typedef '%s' has an initializer", name));
        }
        if sp.funcs != 0 {
            // (6.7.4p1: function specifiers only in the declaration of a function)
            cs.err(dcl.name_span, "C3006", u.f1("'inline' or '_Noreturn' in the declaration of the typedef '%s'",
                                                name));
        }
        let prior = cs.lookup_here(name);
        if u.notnil(prior) {
            let same = (prior.kind == cast.SK_TYPEDEF) and cty.compatible(prior.ty, t) and
                       ((t.kind != cty.TK_ARRAY) or (prior.ty.has_len == t.has_len));
            if not same or (cs.std() < co.C11) or cty.is_vm(t) {
                cs.err_note(dcl.name_span, u.pick(same or (prior.kind == cast.SK_TYPEDEF), "C3002", "C3003"),
                            u.f1("redefinition of '%s'", name), prior.span, "declared before here");
                return;
            }
            dcl.sym = prior;
            mark_decl(d, dcl);
            return;
        }
        let s = cs.new_sym(cast.SK_TYPEDEF, name, dcl.name_span, t);
        cdbg.note_typedef_use(s, sp.tdef);
        dcl.sym = s;
        cs.declare(name, s);
        mark_decl(d, dcl);
        return;
    }
    if (sp.funcs != 0) and not cty.is_func(t) {
        cs.err(dcl.name_span, "C3006", u.f1("'inline' or '_Noreturn' in the declaration of '%s', not a function",
                                            name));
    }
    if cty.is_func(t) {
        if sp.thread {
            cs.err(dcl.name_span, "C3076", u.f2("the function '%s' cannot be declared '%s'", name,
                                                dsp.sc_name(cast.SC_THREAD_LOCAL)));
        }
        func_decl(sp, dcl, t, ctx, d);
        if (sp.funcs & cast.FS_NORETURN) != 0 {
            catr.set_noreturn(dcl.sym);
        }
    } else {
        object_decl(sp, dcl, t, ctx);
    }
    mark_decl(d, dcl);
}

// What the attributes of declaration d and of its declarator dcl say of the entity declared.
fn mark_decl(d: *mut cast.Decl, dcl: *mut cast.Declarator) void {
    catr.mark_sym(dcl.sym, &d.attrs);
    catr.mark_sym(dcl.sym, &dcl.attrs);
    catr.mark_sym(dcl.sym, &d.specs.gattrs);
    catr.mark_functype(dcl.sym, dcl);
    // (the GNU dialects' attributes, and in every mode those of the
    // compiler's headers, __axiom_attribute__: csema_gnu.is_gnu)
    cgn.mark_sym(dcl.sym, &d.attrs);
    cgn.mark_sym(dcl.sym, &dcl.attrs);
    cgn.mark_sym(dcl.sym, &d.specs.gattrs);
    cgn.pragma_visibility(dcl.sym, dcl.vis);
    cgn.pragma_options(dcl.sym, dcl.fnopts);
    if cs.opts().gnu or cs.opts().declspec {
        cgn.entity(dcl.sym, dcl);
    }
}

// The entity a declaration of `name` with linkage `lk` declares: the one of
// an earlier declaration in the same scope or with the same linkage, its
// type made the composite, or a new one, bound in the current scope.
fn entity(name: []u8, sp: u.Span, kind: i32, t: *mut cty.CType, lk: i32) *mut cast.CSym {
    let here = cs.lookup_here(name);
    let mut prior = here;
    if u.isnil(prior) and (lk != cast.LK_NONE) {
        prior = cs.linked(name);
    }
    if u.notnil(prior) {
        if prior.kind != kind {
            cs.err_note(sp, "C3003", u.f1("'%s' is redeclared as a different kind of identifier", name), prior.span,
                        "declared before here");
            return new_entity(name, sp, kind, t, lk, false);
        }
        if (prior.linkage == cast.LK_NONE) or (lk == cast.LK_NONE) {
            cs.err_note(sp, "C3002", u.f1("redefinition of '%s'", name), prior.span, "declared before here");
            return new_entity(name, sp, kind, t, lk, false);
        }
        if prior.linkage != lk {
            cs.err_note(sp, "C3004", u.f3("'%s' is declared with %s linkage after a declaration with %s linkage", name,
                                          u.pick(lk == cast.LK_INTERNAL, "internal", "external"),
                                          u.pick(lk == cast.LK_INTERNAL, "external", "internal")), prior.span,
                        "declared before here");
        }
        if not cty.compatible(prior.ty, t) {
            cs.err_note(sp, "C3003", u.f3("conflicting types for '%s': %s, declared before as %s", name, cs.tq(t),
                                          cs.tq(prior.ty)), prior.span, "declared before here");
        } else {
            prior.ty = cty.composite(prior.ty, t);
        }
        if u.isnil(here) {
            cs.declare(name, prior);
        }
        return prior;
    }
    return new_entity(name, sp, kind, t, lk, true);
}

fn new_entity(name: []u8, sp: u.Span, kind: i32, t: *mut cty.CType, lk: i32, link: bool) *mut cast.CSym {
    let s = cs.new_sym(kind, name, sp, t);
    s.linkage = lk;
    if link and (lk != cast.LK_NONE) {
        cs.set_linked(name, s);
    }
    cs.declare(name, s);
    return s;
}

// Has declaration d of a function (its declarator dcl) the GNU89 inline
// semantics: gnu89 or gnu90, or the attribute gnu_inline (csema_marks.ax)?
fn gnu89_inline(d: *mut cast.Decl, dcl: *mut cast.Declarator) bool {
    if not cs.opts().gnu {
        return false;
    }
    if cs.std() < co.C99 {
        return true;
    }
    return cgn.has(&d.attrs, "gnu_inline") or cgn.has(&dcl.attrs, "gnu_inline") or
           cgn.has(&d.specs.gattrs, "gnu_inline");
}

fn func_decl(sp: *Specs, dcl: *mut cast.Declarator, t: *mut cty.CType, ctx: i32, d: *mut cast.Decl) void {
    let sc = sp.sc;
    if cs.at_file_scope() {
        if (sc != 0) and (sc != cast.SC_EXTERN) and (sc != cast.SC_STATIC) {
            cs.err(dcl.name_span, "C3006", u.f1("the function '%s' has an invalid storage class", dcl.name));
        }
    } else if (sc == cast.SC_AUTO) and cs.opts().gnu {
        // (a GNU dialect: the declaration of a nested function defined later in the block)
        let prior = cs.lookup_here(dcl.name);
        if u.notnil(prior) and (prior.kind == cast.SK_FUNC) and u.notnil(prior.nest_parent) {
            dcl.sym = prior;
            return;
        }
        let s = cs.new_sym(cast.SK_FUNC, dcl.name, dcl.name_span, t);
        s.linkage = cast.LK_NONE;
        s.nest_parent = cs.cur_fn();
        if u.notnil(s.nest_parent) {
            s.nest_parent.has_nested = true;
        }
        cs.declare(dcl.name, s);
        dcl.sym = s;
        return;
    } else if (sc != 0) and (sc != cast.SC_EXTERN) {
        cs.err(dcl.name_span, "C3006", u.f1("the function '%s', declared in a block, can only be extern", dcl.name));
    }
    if u.notnil(dcl.init) {
        cs.err(dcl.init.span, "C3033", u.f1("the function '%s' has an initializer", dcl.name));
    }
    let mut sc2 = sc;
    if (sc != cast.SC_STATIC) and (sc != cast.SC_EXTERN) {
        sc2 = 0;
    }
    if not cs.at_file_scope() and (sc2 == cast.SC_STATIC) {
        sc2 = 0;
    }
    let lk = cs.linkage_of(dcl.name, sc2, true);
    dcl.sym = entity(dcl.name, dcl.name_span, cast.SK_FUNC, t, lk);
    if cs.at_file_scope() and (dcl.sym.kind == cast.SK_FUNC) {
        csm.gnu89_inline = gnu89_inline(d, dcl);
        csm.function_declared(dcl.sym, sp.funcs, sc, dcl.name_span);
        csm.gnu89_inline = false;
    }
}

fn object_decl(sp: *Specs, dcl: *mut cast.Declarator, t0: *mut cty.CType, ctx: i32) void {
    let sc = sp.sc;
    let name = dcl.name;
    let mut t = t0;
    if cty.is_void(t) {
        cs.err(dcl.name_span, "C3007", u.f1("the object '%s' has type void", name));
        return;
    }
    if sp.constexpr_ {
        // (C23 6.7.1: a definition with an initializer, of a const type)
        if u.isnil(dcl.init) {
            cs.err(dcl.name_span, "C3073", u.f1("'%s' is declared 'constexpr' but has no initializer", name));
        }
        _ = dsp.constexpr_type(t, dcl.name_span);
        t = cty.qualify(t, cty.Q_CONST);
    }
    if cs.at_file_scope() {
        if (sc == cast.SC_AUTO) or (sc == cast.SC_REGISTER) {
            cs.err(dcl.name_span, "C3006", u.f1("'%s' at file scope cannot be auto or register", name));
        }
        let mut sc2 = sc;
        if (sc != cast.SC_STATIC) and (sc != cast.SC_EXTERN) {
            sc2 = 0;
        }
        if sp.constexpr_ {
            sc2 = cast.SC_STATIC;  // (internal linkage: C23 6.2.2p3)
        }
        let lk = cs.linkage_of(name, sc2, false);
        let s = entity(name, dcl.name_span, cast.SK_OBJECT, t, lk);
        s.duration = cast.SD_STATIC;
        dcl.sym = s;
        object_flags(sp, s, dcl);
        let listed = s.defined or s.tentative;
        if u.notnil(dcl.init) {
            if s.defined {
                cs.err_note(dcl.name_span, "C3002", u.f1("redefinition of '%s'", name), s.span, "defined before here");
            }
            init_object(s, dcl.init, true);
            s.defined = true;
        } else if sc != cast.SC_EXTERN {
            if (lk == cast.LK_INTERNAL) and not cty.is_complete(s.ty) and not cty.is_error(s.ty) {
                // (6.9.2p3)
                cs.err(dcl.name_span, "C3007",
                       u.f2("the tentative definition of '%s', which has internal linkage, has incomplete type %s",
                            name, cs.tq(s.ty)));
            }
            s.tentative = true;
        }
        if not listed and (s.defined or s.tentative) {
            cs.add_object(s);
        }
        dcl.ty = s.ty;
        return;
    }
    if sc == cast.SC_EXTERN {
        let lk = cs.linkage_of(name, sc, false);
        let s = entity(name, dcl.name_span, cast.SK_OBJECT, t, lk);
        s.duration = cast.SD_STATIC;
        dcl.sym = s;
        object_flags(sp, s, dcl);
        if u.notnil(dcl.init) {
            cs.err(dcl.init.span, "C3033", u.f1("'%s', declared extern in a block, has an initializer", name));
        }
        return;
    }
    let prior = cs.lookup_here(name);
    if u.notnil(prior) {
        cs.err_note(dcl.name_span, "C3002", u.f1("redefinition of '%s'", name), prior.span, "declared before here");
    }
    let s = cs.new_sym(cast.SK_OBJECT, name, dcl.name_span, t);
    s.owner = cs.cur_fn();  // (a nested function may use it: csema_nest.ax)
    if (sc == cast.SC_STATIC) or sp.thread {
        s.duration = cast.SD_STATIC;
    }
    if sc == cast.SC_REGISTER {
        csm.set_register(s);
    }
    dcl.sym = s;
    object_flags(sp, s, dcl);
    cs.declare(name, s);
    if u.notnil(dcl.init) and cty.is_vla(s.ty) {
        vla.init(s, dcl.init);
    } else if u.notnil(dcl.init) {
        init_object(s, dcl.init, s.duration == cast.SD_STATIC);
    }
    if not cty.is_complete(s.ty) and not cty.is_error(s.ty) {
        cs.err(dcl.name_span, "C3007", u.f2("the object '%s' has incomplete type %s", name, cs.tq(s.ty)));
    }
    if s.duration == cast.SD_STATIC {
        s.defined = true;
        cs.add_object(s);
        csm.static_defined(s, dcl.name_span);
    }
    dcl.ty = s.ty;
}

// What the specifiers sp say of object s besides its type: constexpr, thread_local (which every declaration of it says, or none:
// 6.2.4p4), and its alignment (6.7.5p7: every declaration that has an
// alignment specifier asks for the same).
fn object_flags(sp: *Specs, s: *mut cast.CSym, dcl: *mut cast.Declarator) void {
    cdbg.note_typedef_use(s, sp.tdef);
    let had = s.flags;
    if sp.constexpr_ {
        s.flags = s.flags | cast.CF_CONSTEXPR;
    }
    let tl = (had & cast.CF_THREAD_LOCAL) != 0;
    if sp.thread {
        s.flags = s.flags | cast.CF_THREAD_LOCAL;
    }
    let again = (s.span.file != dcl.name_span.file) or (s.span.start != dcl.name_span.start);
    if (s.linkage != cast.LK_NONE) and again and (tl != sp.thread) {
        cs.err_note(dcl.name_span, "C3076", u.f2("'%s' is declared %s, after a declaration that says otherwise",
                                                 dcl.name,
                                                 u.pick(sp.thread, u.cat3("'", dsp.sc_name(cast.SC_THREAD_LOCAL), "'"),
                                                        u.cat2(
                                                            "without '",
                                                            u.cat2(dsp.sc_name(cast.SC_THREAD_LOCAL), "'")))), s.span,
                    "declared before here");
    }
    if sp.has_align {
        if dsp.check_alignment(sp.align, sp.align_sp, s.ty, dcl.name) {
            let a = sp.align;
            if ((s.flags & cast.CF_ALIGNAS) != 0) and (a != s.align) and (a != 0) and (s.align != 0) {
                cs.err_note(sp.align_sp, "C3071", u.f3("'%s' is declared with alignment %s, before with %s", dcl.name,
                                                       u.udec(a), u.udec(s.align)), s.span, "declared before here");
            }
            if a > s.align {
                s.align = a;
            }
        }
        s.flags = s.flags | cast.CF_ALIGNAS;
    }
}

fn init_object(s: *mut cast.CSym, it: *mut cast.Init, is_static: bool) void {
    if cty.is_error(s.ty) {
        return;
    }
    let r = cdi.initializer(s.ty, it, is_static, (s.flags & cast.CF_CONSTEXPR) != 0);
    s.init = r.list;
    s.ty = r.ty;
}

// -----------------------------------------------------------------------------
// Function definitions (6.9.1)
// -----------------------------------------------------------------------------

// The definition of a nested function (a GNU dialect: csema_nest.ax), in a
// block of the function being analyzed: no linkage, no storage class but
// auto; its body is analyzed in the scope of its block, so that it sees
// the enclosing function's objects.
fn nested_def(d: *mut cast.Decl) void {
    let parent = cs.cur_fn();
    let sp = specifiers(d.specs, CTX_BLOCK, false);
    let dcl = d.decls.get(0);
    g_params = u.List.[*mut cast.CSym].empty();
    g_kr_ids = false;
    g_defining = true;
    let mut t = derive(sp.ty, dcl, CTX_BLOCK);
    g_defining = false;
    let params = g_params;
    if cty.is_error(t) or not cty.is_func(t) or u.isnil(parent) {
        return;
    }
    if g_kr_ids {
        t = kr_params(t, d, &params);
    }
    if (sp.sc != 0) and (sp.sc != cast.SC_AUTO) {
        cs.err(dcl.name_span, "C3006", u.f1("the nested function '%s' can only be declared auto", dcl.name));
    }
    let prior = cs.lookup_here(dcl.name);
    let mut s = u.nil.[cast.CSym]();
    if u.notnil(prior) and (prior.kind == cast.SK_FUNC) and (prior.nest_parent == parent) and not prior.defined {
        // (declared auto before in the block: compatible types)
        if not cty.compatible(prior.ty, t) {
            cs.err_note(dcl.name_span, "C3003", u.f1("conflicting types for '%s'", dcl.name), prior.span,
                        "declared before here");
        }
        s = prior;
        s.ty = t;
    } else {
        if u.notnil(prior) {
            cs.err_note(dcl.name_span, "C3002", u.f1("redefinition of '%s'", dcl.name), prior.span,
                        "declared before here");
        }
        s = cs.new_sym(cast.SK_FUNC, dcl.name, dcl.name_span, t);
        s.linkage = cast.LK_NONE;
        s.nest_parent = parent;
        cs.declare(dcl.name, s);
    }
    parent.has_nested = true;
    dcl.sym = s;
    dcl.ty = t;
    dsp.attrs(&d.attrs, dsp.AP_FUNC);
    dsp.attrs(&d.specs.gattrs, dsp.AP_FUNC);
    dsp.attrs(&dcl.attrs, dsp.AP_FUNC);
    mark_decl(d, dcl);
    for p in params.items() {
        if not cty.is_complete(p.ty) and not cty.is_error(p.ty) {
            cs.err(p.span, "C3007", u.f2("the parameter '%s' has incomplete type %s", p.name, cs.tq(p.ty)));
        }
    }
    s.defined = true;
    s.def = d;
    s.params = params;
    cs.add_function(s);
    cs.hooks.body(s, d);
}

fn function_def(d: *mut cast.Decl) void {
    let sp = specifiers(d.specs, CTX_FILE, false);
    dsp.attrs(&d.attrs, dsp.AP_FUNC);
    dsp.attrs(&d.specs.gattrs, dsp.AP_FUNC);
    let dcl = d.decls.get(0);
    g_params = u.List.[*mut cast.CSym].empty();
    g_kr_ids = false;
    g_defining = true;
    let mut t = derive(sp.ty, dcl, CTX_FILE);
    g_defining = false;
    let params = g_params;
    let kr = g_kr_ids;
    if cty.is_error(t) or not cty.is_func(t) {
        return;
    }
    if sp.sc == cast.SC_TYPEDEF {
        cs.err(dcl.name_span, "C3006", "a function definition cannot be a typedef");
        return;
    }
    dsp.attrs(&dcl.attrs, dsp.AP_FUNC);
    if sp.infer {
        cs.err(dcl.name_span, "C3074", u.f1("the function '%s' cannot have its type inferred ('auto')", dcl.name));
    }
    if sp.has_align {
        dsp.misplaced_alignment(sp.align_sp, u.f1("the definition of the function '%s'", dcl.name));
    }
    if sp.constexpr_ or sp.thread {
        cs.err(dcl.name_span, u.pick(sp.constexpr_, "C3073", "C3076"),
               u.f2(
                   "the function '%s' cannot be declared '%s'", dcl.name,
                   u.pick(sp.constexpr_, "constexpr", dsp.sc_name(cast.SC_THREAD_LOCAL))));
    }
    if kr {
        t = kr_params(t, d, &params);
    }
    let mut sc = sp.sc;
    if (sc != 0) and (sc != cast.SC_EXTERN) and (sc != cast.SC_STATIC) {
        cs.err(dcl.name_span, "C3006", u.f1("the function '%s' has an invalid storage class", dcl.name));
        sc = 0;
    }
    if sc == cast.SC_EXTERN {
        sc = 0;
    }
    let lk = cs.linkage_of(dcl.name, sc, true);
    let s = entity(dcl.name, dcl.name_span, cast.SK_FUNC, t, lk);
    dcl.sym = s;
    dcl.ty = t;
    mark_decl(d, dcl);
    if (sp.funcs & cast.FS_NORETURN) != 0 {
        catr.set_noreturn(s);
    }
    if s.defined {
        cs.err_note(dcl.name_span, "C3002", u.f1("redefinition of '%s'", dcl.name), s.span, "defined before here");
        return;
    }
    let rt = t.ret;
    if not cty.is_void(rt) and not cty.is_complete(rt) {
        cs.err(dcl.name_span, "C3007", u.f2("'%s' returns incomplete type %s", dcl.name, cs.tq(rt)));
    }
    for p in params.items() {
        if not cty.is_complete(p.ty) and not cty.is_error(p.ty) {
            cs.err(p.span, "C3007", u.f2("the parameter '%s' has incomplete type %s", p.name, cs.tq(p.ty)));
        }
    }
    vla.check_params(dcl.derivs.at(0));
    s.defined = true;
    s.def = d;
    s.params = params;
    if u.str_eq(dcl.name, "main") and (lk == cast.LK_EXTERNAL) {
        check_main(s, dcl);
    }
    csm.gnu89_inline = gnu89_inline(d, dcl);
    csm.function_declared(s, sp.funcs, sp.sc, dcl.name_span);
    csm.gnu89_inline = false;
    cs.add_function(s);
    csm.begin_body(s);
    cs.hooks.body(s, d);
    csm.end_body();
}

// A K&R definition's parameters get their types from its declaration list
// (int when they have none, before C99); the function's type, which is not a
// prototype, gets them (kr: its compatibility with a prototype is by their
// promoted types, 6.7.6.3p15).
fn kr_params(t: *mut cty.CType, d: *mut cast.Decl, params: *u.List.[*mut cast.CSym]) *mut cty.CType {
    let ps = params.items();
    let mut given = u.SymMap.[*mut cast.CSym].{ keys: u.nil.[usize](), vals: u.nil.[*mut cast.CSym](), cap: 0, len: 0 };
    for p in ps {
        given.put(p.name, p);
    }
    let mut seen = u.SymMap.[i32].{ keys: u.nil.[usize](), vals: u.nil.[i32](), cap: 0, len: 0 };
    // (each parameter is in scope after its declarator, for the sizes of
    // the later ones' variable length arrays: 6.2.1p7)
    cs.push_scope();
    for kd in d.kr_decls.items() {
        if kd.kind != cast.DeclKind.DECL {
            continue;
        }
        let sp = specifiers(kd.specs, CTX_PARAM, false);
        if (sp.sc != 0) and (sp.sc != cast.SC_REGISTER) {
            cs.err(kd.specs.span, "C3006", "a parameter's only storage-class specifier can be 'register'");
        }
        for x in kd.decls.items() {
            let p = given.get(x.name);
            if u.isnil(p) {
                cs.err(x.name_span, "C3010", u.f1("'%s' is declared, but is not a parameter", x.name));
                continue;
            }
            if seen.get(x.name) != 0 {
                cs.err(x.name_span, "C3002", u.f1("the parameter '%s' is declared twice", x.name));
            }
            seen.put(x.name, 1);
            if u.notnil(x.init) {
                cs.err(x.init.span, "C3033", u.f1("the parameter '%s' has an initializer", x.name));
            }
            let pt = derive(sp.ty, x, CTX_PARAM);
            x.ty = pt;
            x.sym = p;
            if sp.sc == cast.SC_REGISTER {
                csm.set_register(p);
            }
            p.ty = adjust_param(pt, x);
            p.span = x.name_span;
            cs.declare(x.name, p);
        }
    }
    cs.pop_scope();
    let types = u.newn.[*mut cty.CType](ps.len + 1);
    for i in 0..ps.len {
        let p = ps[i];
        if (seen.get(p.name) == 0) and (cs.std() >= co.C99) {
            cs.err(p.span, "C3010", u.f1("the parameter '%s' has no declaration (implicit int is not in C99)", p.name));
        }
        types[i] = cty.unqual(p.ty);
    }
    // (callers pass each argument promoted: IR generation receives the
    // parameters in their promoted types and converts them)
    let f = cty.function(t.ret, types[0..ps.len], false, false);
    f.kr = true;
    return f;
}

// main is called by the program's start-up: int main(void) or
// int main(int, char **).
fn check_main(s: *mut cast.CSym, dcl: *cast.Declarator) void {
    let t = s.ty;
    let mut ok = cty.unqual(t.ret) == cty.t_int;
    let n = t.params.len;
    if n == 2 {
        let p1 = t.params[1];
        ok = ok and (cty.unqual(t.params[0]) == cty.t_int) and (p1.kind == cty.TK_POINTER) and
             (p1.elem.kind == cty.TK_POINTER) and (cty.unqual(p1.elem.elem) == cty.t_char);
    } else if n != 0 {
        ok = false;
    }
    if t.variadic {
        ok = false;
    }
    if not ok {
        cs.err(dcl.name_span, "C3061", u.f1("main has type %s; it must be 'int (void)' or 'int (int, char **)'",
                                            cs.tq(t)));
    }
}

// -----------------------------------------------------------------------------
// Static assertions (6.7.10)
// -----------------------------------------------------------------------------

fn static_assert(d: *mut cast.Decl) void {
    let r = cx.ice_wide(d.cond, "the condition of a static assertion");
    d.cond = r.e;
    if r.ok and not cc.truth(r.e) {
        let mut msg: []u8 = "";
        if u.notnil(d.msg) and u.notnil(d.msg.tok) {
            let mut b = u.Buf.init();
            for x in d.msg.tok.units {
                b.c(@truncate(u8, x));
            }
            msg = u.cat2(": ", b.done());
        }
        cs.err(d.cond.span, "C3050", u.cat2("static assertion failed", msg));
    }
}
