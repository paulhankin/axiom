// =============================================================================
// csema_gbuiltin.ax - GNU builtin constants and call dispatch, part of
// csema.ax.
// =============================================================================
import "../target.ax" as tg;
import "../util.ax" as u;
import "cast.ax" as cast;
import "cconst.ax" as cc;
import "cfeat.ax" as cf;
import "ctok.ax" as ct;
import "ctypes.ax" as cty;

// The builtins IR generation makes (a CALL node's op).
pub const GB_EXPECT: i32 = 100;  // (x, c [, p]): x
pub const GB_TRAP: i32 = 101;
pub const GB_CLZ: i32 = 110;  // the bit operations: of the argument's type
pub const GB_CTZ: i32 = 111;
pub const GB_POPCOUNT: i32 = 112;
pub const GB_PARITY: i32 = 113;
pub const GB_FFS: i32 = 114;
pub const GB_CLRSB: i32 = 115;
pub const GB_BSWAP: i32 = 116;
pub const GB_OV_P: i32 = 120;  // add/sub/mul_overflow_p: (op: GB_OV_P + 0, 1, 2)
pub const GB_MEMCPY: i32 = 130;
pub const GB_MEMMOVE: i32 = 131;
pub const GB_MEMSET: i32 = 132;
pub const GB_ABS: i32 = 135;  // integer, wrapping
pub const GB_FABS: i32 = 136;
pub const GB_SQRT: i32 = 137;
pub const GB_FLOOR: i32 = 138;
pub const GB_CEIL: i32 = 139;
pub const GB_TRUNC: i32 = 140;
pub const GB_RINT: i32 = 141;  // rint, nearbyint: to nearest, ties to even
pub const GB_COPYSIGN: i32 = 142;
pub const GB_FMA: i32 = 143;
pub const GB_ALLOCA: i32 = 150;  // (n [, align in bits])
pub const GB_FRAME_ADDR: i32 = 151;
pub const GB_RETURN_ADDR: i32 = 152;
pub const GB_PREFETCH: i32 = 153;
pub const GB_ASSUME_ALIGNED: i32 = 154;
pub const GB_CPU_HAS: i32 = 155;      // cval: the extensions' bits (std/os/cpu.ax)
pub const GB_CPU_VENDOR: i32 = 156;   // cval: 1 Intel, 2 AMD
pub const GB_SETJMP: i32 = 157;       // (buf)
pub const GB_LONGJMP: i32 = 158;      // (buf, 1)
pub const GB_PAUSE: i32 = 159;        // a spin-wait hint: nothing
pub const GB_FENCE: i32 = 167;        // a full memory fence
pub const GB_OBJECT_SIZE: i32 = 182;  // __builtin_(dynamic_)object_size(p, kind) the expression does not decide (ir.IN_OBJSIZE)
pub const GB_CONSTANT_P: i32 = 183;   // __builtin_constant_p(x) of no constant x without side effects: soft 0 (ir.IN_CONSTANT_P)
pub const GB_VA_PACK: i32 = 184;      // __builtin_va_arg_pack(): replaced by the inlined gbi_call's variable arguments
pub const GB_VA_PACK_LEN: i32 = 185;  // __builtin_va_arg_pack_len(): their number
pub const GB_CLEAR_CACHE: i32 = 186;  // __builtin___clear_cache(b, e) where the caches are coherent: nothing
pub const GB_SPEC_SAFE: i32 = 187;    // __builtin_speculation_safe_value(v [, fail]): v
pub const GB_ISNAN: i32 = 160;
pub const GB_ISINF: i32 = 161;
pub const GB_ISFINITE: i32 = 162;
pub const GB_SIGNBIT: i32 = 163;
pub const GB_ISNORMAL: i32 = 164;
pub const GB_ISINF_SIGN: i32 = 165;
pub const GB_FPCLASSIFY: i32 = 166;  // (nan, inf, normal, subnormal, zero, x)
pub const GB_ISGREATER: i32 = 170;   // .. GB_ISUNORDERED: in this order
pub const GB_ISGREATEREQUAL: i32 = 171;
pub const GB_ISLESS: i32 = 172;
pub const GB_ISLESSEQUAL: i32 = 173;
pub const GB_ISLESSGREATER: i32 = 174;
pub const GB_ISUNORDERED: i32 = 175;
// The vector builtins (csema_vec.ax, cgen_vec.ax).
pub const GB_SHUFFLE: i32 = 180;        // (a, mask) or (a, b, mask)
pub const GB_SHUFFLEVECTOR: i32 = 181;  // (a, b, constant indices...)

/// Types a gbi_call of a vector builtin (true if `name` is one): set by csema_vec.ax.
// The atomics (cgen_gatomic.ax): A_ kind, the RMW operation in e.cval.
pub const GB_ATOMIC: i32 = 200;  // + an A_ kind
pub const A_FETCH_OP: i32 = 0;   // old value; op: RMW_ or OP_NAND
pub const A_OP_FETCH: i32 = 1;   // new value
pub const A_CAS_BOOL: i32 = 2;   // __sync_bool_compare_and_swap(p, old, new)
pub const A_CAS_VAL: i32 = 3;    // __sync_val_compare_and_swap(p, old, new)
pub const A_XCHG: i32 = 4;       // (p, v): old
pub const A_LOAD: i32 = 5;       // (p)
pub const A_STORE: i32 = 6;      // (p, v)
pub const A_CMPXCHG: i32 = 7;    // __atomic_compare_exchange_n(p, expected *, desired): bool
pub const A_FENCE: i32 = 8;
pub const A_TEST_SET: i32 = 9;    // (p): bool, the byte at p set
pub const A_CLEAR: i32 = 10;      // (p): the byte at p cleared
pub const A_LOAD_G: i32 = 11;     // __atomic_load(p, ret *)
pub const A_STORE_G: i32 = 12;    // __atomic_store(p, val *)
pub const A_XCHG_G: i32 = 13;     // __atomic_exchange(p, val *, ret *)
pub const A_CMPXCHG_G: i32 = 14;  // __atomic_compare_exchange(p, expected *, desired *): bool
pub const A_RELEASE: i32 = 15;    // __sync_lock_release(p): 0 stored
pub const OP_NAND: u64 = 100;     // (the RMW op of nand: made with a compare-and-swap loop)

/// Installs the GNU builtins (csema_builtin.ax calls `gbi_call` for a name it
/// does not know).
fn pick_n(c: bool, a: usize, b: usize) usize {
    if c {
        return a;
    }
    return b;
}

fn pick_i(c: bool, a: i32, b: i32) i32 {
    if c {
        return a;
    }
    return b;
}

fn pick_u(c: bool, a: u64, b: u64) u64 {
    if c {
        return a;
    }
    return b;
}

fn pick_t(c: bool, a: *mut cty.CType, b: *mut cty.CType) *mut cty.CType {
    if c {
        return a;
    }
    return b;
}

fn gbi_arity(e: *mut cast.Expr, lo: usize, hi: usize) bool {
    let n = e.args.len;
    if (n >= lo) and (n <= hi) {
        return true;
    }
    let mut want = u.zdec(lo);
    if hi > lo {
        want = u.f2("%s to %s", u.zdec(lo), u.zdec(hi));
    }
    err(e.span, "C3023", u.f3("'%s' takes %s arguments, not %s", e.a.name, want, u.zdec(n)));
    return false;
}

// Argument k of e, typed (its value) and converted to t as by assignment.
fn gbi_arg_as(e: *mut cast.Expr, k: usize, t: *mut cty.CType) bool {
    let x = rv(e.args.get(k));
    if is_err(x) {
        e.args.set(k, x);
        return false;
    }
    let what = u.f2("argument %s of '%s'", u.zdec(k + 1), e.a.name);
    let c = assign_convert(x, t, what);
    e.args.set(k, c);
    return not is_err(c) and (cty.unqual(c.ty) == cty.unqual(t));
}

// Argument k of e, typed.
fn gbi_arg(e: *mut cast.Expr, k: usize) *mut cast.Expr {
    let x = rv(e.args.get(k));
    e.args.set(k, x);
    return x;
}

fn gbi_args_ok(e: *mut cast.Expr) bool {
    let mut ok = true;
    for k in 0..e.args.len {
        if is_err(gbi_arg(e, k)) {
            ok = false;
        }
    }
    return ok;
}

// -----------------------------------------------------------------------------
// Typing the calls
// -----------------------------------------------------------------------------

// The integer type of a suffix's l's: unsigned (us) or signed int, long, long long.
fn by_longs(longs: i32, us: bool) *mut cty.CType {
    let mut t = cty.t_int;
    if longs == 1 {
        t = cty.t_long;
    } else if longs == 2 {
        t = cty.t_llong;
    }
    if us {
        return cty.to_unsigned(t);
    }
    return t;
}

fn float_by(sfx: []u8) *mut cty.CType {
    if u.str_eq(sfx, "f") {
        return cty.t_float;
    }
    if u.str_eq(sfx, "l") {
        return cty.t_ldouble;
    }
    let xs = ["f16", "f32", "f64", "f128", "f32x", "f64x", "q"];
    let ts: [7]*mut cty.CType = [cty.t_float16, cty.t_float32, cty.t_float64, cty.t_float128, cty.t_float32x,
                                 cty.t_float64x, cty.t_float128];
    for k in 0..xs.len {
        if u.str_eq(sfx, xs[k]) {
            cty.note_float_use(ts[k]);
            return ts[k];
        }
    }
    return cty.t_double;
}

// The suffix of a constant builtin's name (__builtin_inf ... and their f,
// l, f16 ... f64x and q forms: "" for none), or nil if name is none.
/// Types gbi_call e of a GNU builtin (a GNU dialect), if its callee names one:
/// true then (e is typed, maybe folded into a constant or replaced by the
/// expression it chooses).
pub fn gbi_call(e: *mut cast.Expr) bool {
    let name = e.a.name;
    let axiom_bswap = u.starts(name, "__builtin_axiom_bswap");
    if not opts().gnu and not axiom_bswap {
        return false;
    }
    let at = atomic_of(name);
    if at.kind >= 0 {
        atomic_call(e, at);
        return true;
    }
    if u.str_eq(name, "__atomic_always_lock_free") or u.str_eq(name, "__atomic_is_lock_free") {
        lock_free(e);
        return true;
    }
    if not u.starts(name, "__builtin_") {
        return false;
    }
    if cf.is_float_const(name) {
        float_const(e);
        return true;
    }
    if vec_builtin_call(e, name) {
        return true;
    }
    let rest = name[pick_n(axiom_bswap, 16, 10)..];
    e.ty = cty.t_void;
    if u.str_eq(rest, "expect") or u.str_eq(rest, "expect_with_probability") {
        let n: usize = pick_n(u.str_eq(rest, "expect"), 2, 3);
        if not gbi_arity(e, n, n) or not gbi_arg_as(e, 0, cty.t_long) or not gbi_arg_as(e, 1, cty.t_long) {
            _ = bad_expr(e);
            return true;
        }
        if n == 3 and not gbi_arg_as(e, 2, cty.t_double) {
            _ = bad_expr(e);
            return true;
        }
        e.op = GB_EXPECT;
        e.ty = cty.t_long;
        return true;
    }
    if u.str_eq(rest, "trap") {
        e.op = GB_TRAP;
        if not gbi_arity(e, 0, 0) {
            _ = bad_expr(e);
        }
        return true;
    }
    if u.str_eq(rest, "constant_p") {
        if not gbi_arity(e, 1, 1) {
            _ = bad_expr(e);
            return true;
        }
        unevaluated(1);
        let x = rv(e.args.get(0));
        unevaluated(-1);
        // (an arithmetic constant, a null or integer pointer constant, or
        // the address of a string literal; that of an object or function
        // is not known before the program is linked)
        let mut v: u64 = 0;
        if not is_err(x) and x.is_const and cty.is_arith(x.ty) {
            v = 1;
        } else if not is_err(x) and cty.is_pointer(x.ty) {
            let ad = cc.address(x);
            if ad.ok and u.isnil(ad.sym) {
                v = 1;
            }
        }
        fold_int(e, cty.t_int, v);
        if (v == 0) and not is_err(x) and soft_operand(x) {
            // (0 in a constant expression, as the GNU dialects have it in
            // static initializers; in code the optimizer may find x a
            // constant: ir.IN_CONSTANT_P. Its argument is not evaluated:
            // having no side effects, computing it changes nothing.)
            e.op = GB_CONSTANT_P;
            e.soft = true;
            e.args.set(0, x);
        }
        return true;
    }
    let cpart = complex_part(rest);
    if cpart.op != 0 {
        // __builtin_conj, creal, cimag (with f and l): <complex.h>'s
        // functions as the GNU dialects' operators ~, __real__ and
        // __imag__ on the argument converted to the complex type
        if not gbi_arity(e, 1, 1) or is_err(gbi_arg(e, 0)) or not cty.is_arith(e.args.get(0).ty) {
            if (e.args.len == 1) and not is_err(e.args.get(0)) {
                err(e.span, "C3082", u.f1("the argument of __builtin_%s must have an arithmetic type", rest));
            }
            _ = bad_expr(e);
            return true;
        }
        let x = convert(e.args.get(0), cpart.ty);
        e.kind = cast.ExprKind.UNARY;
        e.op = cpart.op;
        e.a = x;
        e.args.clear();
        e.ty = u.nil.[cty.CType]();
        _ = expr_check(e);
        return true;
    }
    if u.str_eq(rest, "classify_type") {
        // the class of the argument's type (after the conversions of an
        // argument; not evaluated), as the GNU dialects number them: void
        // 0, integer 1, _Bool 4, pointer 5, floating 8, complex 9,
        // structure 12, union 13, bit-precise 18, another -1
        if not gbi_arity(e, 1, 1) {
            _ = bad_expr(e);
            return true;
        }
        unevaluated(1);
        let x = rv(e.args.get(0));
        unevaluated(-1);
        if is_err(x) {
            _ = bad_expr(e);
            return true;
        }
        let t = x.ty.unq;
        let mut v: i64 = -1;
        if t.kind == cty.TK_VOID {
            v = 0;
        } else if t.kind == cty.TK_BOOL {
            v = 4;
        } else if t.kind == cty.TK_BITINT {
            v = 18;
        } else if cty.is_integer(t) {
            v = 1;
        } else if cty.is_pointer(t) {
            v = 5;
        } else if cty.is_complex(t) {
            v = 9;
        } else if cty.is_floating(t) {
            v = 8;
        } else if t.kind == cty.TK_STRUCT {
            v = 12;
        } else if t.kind == cty.TK_UNION {
            v = 13;
        }
        fold_int(e, cty.t_int, @bit_cast(u64, v));
        return true;
    }
    if u.str_eq(rest, "choose_expr") {
        gbi_choose(e);
        return true;
    }
    if u.str_eq(rest, "object_size") or u.str_eq(rest, "dynamic_object_size") {
        if not gbi_arity(e, 2, 2) {
            _ = bad_expr(e);
            return true;
        }
        _ = gbi_arg(e, 0);
        let r = ice(e.args.get(1), "the type of __builtin_object_size");
        if not r.ok or (r.v > 3) {
            if r.ok {
                err(e.span, "C3082", "the second argument of __builtin_object_size must be 0, 1, 2 or 3");
            }
            _ = bad_expr(e);
            return true;
        }
        // (unknown: (size_t)-1 for 0 and 1, 0 for 2 and 3)
        let mut v: u64 = 0;
        if r.v < 2 {
            v = cty.int_max(cty.t_size);
        }
        let mut x = Extent.{ known: false, size: 0, off: 0, sub_size: 0, sub_off: 0 };
        if not is_err(e.args.get(0)) and pointer_extent(e.args.get(0), &mut x) {
            v = remaining(&x, (r.v & 1) != 0);
        } else if not is_err(e.args.get(0)) and gbi_no_effects(e.args.get(0)) {
            // (the optimizer may find the object: ir.IN_OBJSIZE; its
            // second operand the kind, then 1 for the dynamic form)
            e.op = GB_OBJECT_SIZE;
            e.ty = cty.t_size;
            e.cval = r.v;
            if u.str_eq(rest, "dynamic_object_size") {
                e.cval = r.v | 4;
            }
            return true;
        }
        if not is_err(e.args.get(0)) and not gbi_no_effects(e.args.get(0)) {
            return comma_fold(e, cty.t_size, v);
        }
        fold_int(e, cty.t_size, v);
        return true;
    }
    let mut longs: i32 = 0;
    let bk = cf.bits_index(rest, &mut longs);
    if bk >= 0 {
        let signed_ = (bk == 4) or (bk == 5);  // (ffs, clrsb)
        if not gbi_arity(e, 1, 1) or not gbi_arg_as(e, 0, by_longs(longs, not signed_)) {
            _ = bad_expr(e);
            return true;
        }
        e.op = GB_CLZ + bk;
        e.ty = cty.t_int;
        return true;
    }
    if u.starts(rest, "bswap") {
        let ws = ["bswap16", "bswap32", "bswap64", "bswap128"];
        let bits: [4]i32 = [16, 32, 64, 128];
        for k in 0..ws.len {
            if u.str_eq(rest, ws[k]) {
                let mut t = unsigned_of(bits[k]);
                if bits[k] == 128 {
                    t = cty.int128(false);
                }
                if not gbi_arity(e, 1, 1) or not gbi_arg_as(e, 0, t) {
                    _ = bad_expr(e);
                    return true;
                }
                e.op = GB_BSWAP;
                e.ty = t;
                return true;
            }
        }
    }
    if u.ends(rest, "_overflow") or u.ends(rest, "_overflow_p") {
        overflow(e, rest);
        return true;
    }
    if u.str_eq(rest, "memcpy") or u.str_eq(rest, "memmove") or u.str_eq(rest, "memset") {
        let vp = cty.pointer_to(cty.t_void);
        let cvp = cty.pointer_to(cty.qualify(cty.t_void, cty.Q_CONST));
        let set = u.str_eq(rest, "memset");
        let mut ok = gbi_arity(e, 3, 3) and gbi_arg_as(e, 0, vp);
        if ok {
            if set {
                ok = gbi_arg_as(e, 1, cty.t_int);
            } else {
                ok = gbi_arg_as(e, 1, cvp);
            }
        }
        ok = ok and gbi_arg_as(e, 2, cty.t_size);
        if not ok {
            _ = bad_expr(e);
            return true;
        }
        e.op = GB_MEMCPY;
        if set {
            e.op = GB_MEMSET;
        } else if u.str_eq(rest, "memmove") {
            e.op = GB_MEMMOVE;
        }
        e.ty = vp;
        return true;
    }
    if u.str_eq(rest, "abs") {
        if not gbi_arity(e, 1, 1) or not gbi_arg_as(e, 0, cty.t_int) {
            _ = bad_expr(e);
            return true;
        }
        e.op = GB_ABS;
        e.ty = cty.t_int;
        return true;
    }
    let mut sfx: []u8 = "";
    let mk = cf.math_index(rest, &mut sfx);
    if (mk >= 0) and u.str_eq(sfx, "l") and cty.is_wide(cty.t_ldouble) and
       (MATH_IDS[@int_cast(usize, mk)] != GB_FABS) and (MATH_IDS[@int_cast(usize, mk)] != GB_COPYSIGN) {
        // (a long double wider than double has no IR operations: the
        // library's function; fabs and copysign are on its sign bit)
        let codes = ["DD", "DDD", "DDDD"];
        library(e, rest, codes[MATH_N[@int_cast(usize, mk)] - 1]);
        return false;
    }
    if (mk >= 0) and (MATH_IDS[@int_cast(usize, mk)] == GB_FMA) and tg.is_wasm() {
        // (WebAssembly has no fused multiply-add: the library's fma)
        let codes = ["dddd", "ffff", "DDDD"];
        let mut c = codes[0];
        if u.str_eq(sfx, "f") {
            c = codes[1];
        } else if u.str_eq(sfx, "l") {
            c = codes[2];
        }
        library(e, rest, c);
        return false;
    }
    if mk >= 0 {
        let t = float_by(sfx);
        let n = MATH_N[@int_cast(usize, mk)];
        if not gbi_arity(e, n, n) {
            _ = bad_expr(e);
            return true;
        }
        for k in 0..n {
            if not gbi_arg_as(e, k, t) {
                _ = bad_expr(e);
                return true;
            }
        }
        e.op = MATH_IDS[@int_cast(usize, mk)];
        e.ty = t;
        return true;
    }
    if cf.in_list(rest, cf.CLASS[..]) or cf.in_list(rest, cf.CMPS[..]) {
        classify(e, rest);
        return true;
    }
    if cf.in_list(rest, cf.TCLASS[..]) {
        typed_classify(e, rest);
        return true;
    }
    if u.str_eq(rest, "alloca") or u.str_eq(rest, "alloca_with_align") {
        let two = u.str_eq(rest, "alloca_with_align");
        let n: usize = pick_n(two, 2, 1);
        if not gbi_arity(e, n, n) or not gbi_arg_as(e, 0, cty.t_size) {
            _ = bad_expr(e);
            return true;
        }
        if two {
            let r = ice(e.args.get(1), "the alignment of __builtin_alloca_with_align");
            e.args.set(1, r.e);
            if not r.ok or (r.v < 8) or ((r.v & (r.v - 1)) != 0) or (r.v > 32768) {
                if r.ok {
                    err(e.span, "C3082",
                        "the alignment of __builtin_alloca_with_align (in bits) must be a power of two from 8 to 32768");
                }
                _ = bad_expr(e);
                return true;
            }
        }
        e.op = GB_ALLOCA;
        e.ty = cty.pointer_to(cty.t_void);
        return true;
    }
    if u.str_eq(rest, "frame_address") or u.str_eq(rest, "return_address") {
        if not gbi_arity(e, 1, 1) {
            _ = bad_expr(e);
            return true;
        }
        let r = ice(e.args.get(0), u.f1("the level of '%s'", name));
        e.args.set(0, r.e);
        if not r.ok {
            _ = bad_expr(e);
            return true;
        }
        if r.v > 0xffff {
            err(e.span, "C3090", u.f1("'%s' of a level greater than 65535 is not supported", name));
            _ = bad_expr(e);
            return true;
        }
        e.cval = r.v;
        e.op = pick_i(u.str_eq(rest, "frame_address"), GB_FRAME_ADDR, GB_RETURN_ADDR);
        e.ty = cty.pointer_to(cty.t_void);
        return true;
    }
    if u.starts(rest, "cpu_") {
        cpu_builtin(e, name, rest[4..]);
        return true;
    }
    if u.str_eq(rest, "setjmp") or u.str_eq(rest, "longjmp") {
        let lj = u.str_eq(rest, "longjmp");
        if not gbi_arity(e, pick_n(lj, 2, 1), pick_n(lj, 2, 1)) or not gbi_arg_as(e, 0, cty.pointer_to(cty.t_void)) {
            _ = bad_expr(e);
            return true;
        }
        if lj {
            let r = ice(e.args.get(1), "the second argument of '__builtin_longjmp'");
            e.args.set(1, r.e);
            if not r.ok or (r.v != 1) {
                if r.ok {
                    err(e.args.get(1).span, "C3082", "the second argument of '__builtin_longjmp' must be 1");
                }
                _ = bad_expr(e);
                return true;
            }
        }
        e.op = pick_i(lj, GB_LONGJMP, GB_SETJMP);
        e.ty = pick_t(lj, cty.t_void, cty.t_int);
        return true;
    }
    if u.str_eq(rest, "ia32_pause") or u.str_eq(rest, "ia32_mfence") or u.str_eq(rest, "ia32_lfence") or
       u.str_eq(rest, "ia32_sfence") {
        if not gbi_arity(e, 0, 0) {
            _ = bad_expr(e);
            return true;
        }
        e.op = pick_i(u.str_eq(rest, "ia32_pause"), GB_PAUSE, GB_FENCE);
        e.ty = cty.t_void;
        return true;
    }
    if u.str_eq(rest, "LINE") or u.str_eq(rest, "FILE") or u.str_eq(rest, "FUNCTION") {
        // the presumed line and file of the gbi_call (#line's), and the name of
        // the function it is in ("" outside one): an int constant, and
        // pointers to the strings (__func__'s for the function)
        if not gbi_arity(e, 0, 0) {
            _ = bad_expr(e);
            return true;
        }
        let p = u.presumed(e.span);
        if u.str_eq(rest, "LINE") {
            fold_int(e, cty.t_int, @bit_cast(u64, p.line));
            return true;
        }
        let mut x = cast.new_expr(cast.ExprKind.IDENT, e.span);
        x.name = u.intern("__FUNCTION__");
        if u.str_eq(rest, "FILE") {
            let tok = u.new.[ct.Token]();
            tok.kind = ct.T_STRING;
            tok.text = p.name;
            let us = u.newn.[u32](p.name.len + 1);
            for i in 0..p.name.len {
                us[i] = @as(u32, p.name[i]);
            }
            tok.units = us[0..p.name.len];
            x = cast.new_expr(cast.ExprKind.STRING, e.span);
            x.tok = tok;
        }
        let v = convert(rv(x), cty.pointer_to(cty.qualify(cty.t_char, cty.Q_CONST)));
        e.* = v.*;
        return true;
    }
    if u.str_eq(rest, "__clear_cache") {
        // (the instruction cache made to see what was written to [b, e):
        // on AArch64 its lines and the data cache's cleaned, as the
        // processor's cache type register sizes them; elsewhere nothing)
        let vp = cty.pointer_to(cty.t_void);
        if not gbi_arity(e, 2, 2) or not gbi_arg_as(e, 0, vp) or not gbi_arg_as(e, 1, vp) {
            _ = bad_expr(e);
            return true;
        }
        if tg.g_arch == tg.ARCH_A64 {
            e.* = clear_cache_a64(e).*;
            return true;
        }
        e.op = GB_CLEAR_CACHE;
        return true;
    }
    if u.str_eq(rest, "speculation_safe_value") {
        // (no speculation is tracked: the value)
        if not gbi_arity(e, 1, 2) {
            _ = bad_expr(e);
            return true;
        }
        let v = gbi_arg(e, 0);
        if is_err(v) or not (cty.is_integer(v.ty) or cty.is_pointer(v.ty)) or cty.is_wint(v.ty) {
            if not is_err(v) {
                err(v.span, "C3082", u.f1("'__builtin_speculation_safe_value' takes an integer or a pointer, not %s",
                                          tq(v.ty)));
            }
            _ = bad_expr(e);
            return true;
        }
        let t = cty.unqual(cty.promote(v.ty));
        if not gbi_arg_as(e, 0, t) or ((e.args.len == 2) and not gbi_arg_as(e, 1, t)) {
            _ = bad_expr(e);
            return true;
        }
        e.op = GB_SPEC_SAFE;
        e.ty = t;
        return true;
    }
    if u.str_eq(rest, "prefetch") {
        if not gbi_arity(e, 1, 3) or not gbi_args_ok(e) {
            _ = bad_expr(e);
            return true;
        }
        e.op = GB_PREFETCH;
        return true;
    }
    if u.str_eq(rest, "assume_aligned") {
        if not gbi_arity(e, 2, 3) or not gbi_arg_as(e, 0, cty.pointer_to(cty.qualify(cty.t_void, cty.Q_CONST))) or
           not gbi_args_ok(e) {
            _ = bad_expr(e);
            return true;
        }
        e.op = GB_ASSUME_ALIGNED;
        e.ty = cty.pointer_to(cty.t_void);
        return true;
    }
    if u.str_eq(rest, "va_arg_pack") or u.str_eq(rest, "va_arg_pack_len") {
        // the caller's variable arguments (and how many), in an inline
        // definition of a variadic function, as the system's headers'
        // wrappers forward them: each gbi_call of the function inlines the
        // definition (csema_marks.end_body, cgen_stmt.inline_call), the
        // pack replaced by the gbi_call's variable arguments (the last of a
        // gbi_call's variable arguments: csema_expr.call), its length their
        // number
        let pack = u.str_eq(rest, "va_arg_pack");
        let mut me: ?*mut cast.Expr = .none;
        if pack {
            me = .some(e);
        }
        let mut is_va = false;
        if let .some(f) = cur_fn() {
            is_va = f.ty.variadic;
        }
        if not gbi_arity(e, 0, 0) or not is_va or not va_pack_use(me) {
            if e.args.len == 0 {
                err(e.span, "C3090", u.f1("'%s' is only in the inline definition of a function with variable arguments",
                                          name));
            }
            _ = bad_expr(e);
            return true;
        }
        e.op = GB_VA_PACK_LEN;
        if pack {
            e.op = GB_VA_PACK;
        }
        e.ty = cty.t_int;
        return true;
    }
    let ck = cf.chk_index(rest);
    if ck >= 0 {
        return chk_call(e, @int_cast(usize, ck));
    }
    let lk = cf.lib_index(rest);
    if lk >= 0 {
        library(e, rest, LIB_TYPES[@int_cast(usize, lk)]);
        return false;  // (an ordinary gbi_call now: csema_expr.call types it)
    }
    return false;
}
