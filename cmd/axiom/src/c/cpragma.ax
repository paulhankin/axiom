// =============================================================================
// cpragma.ax - what the pragmas of a translation unit say to the phases after
// the preprocessor (cpp.ax reads them: #pragma and _Pragma, in every mode):
//
//   - `#pragma pack` and `#pragma GCC visibility`: a value that changes at
//     points of the token stream. The preprocessor makes a change (event)
//     and a token for it (lx.PK_PRAGMA), which phase 7 (cpp_conv.ax) drops,
//     placing the change at the index of the next token (place); the parser
//     asks for the value where a structure's member list ends (pack_at);
//   - `#pragma weak name` and `#pragma weak name = target`: a list, which
//     semantic analysis applies at the end of the unit;
//   - `#pragma GCC diagnostic` and `#pragma GCC system_header`: rules that
//     change the severity of warnings by where they are (the diagnostics'
//     filter, installed in diag.ax).
//
// Positions are the unit's (begin_unit starts them again); the rules about
// diagnostics are kept by file for the whole build, since diagnostics are
// shown at its end.
// =============================================================================
import "../diag.ax" as dg;
import "../util.ax" as u;

// A value that changes at a token position.
struct Change {
    kind: i32,  // EV_
    value: u64,
    pos: usize,  // it holds from the token at this index on
    placed: bool,
}

/// The values that change at positions.
pub const EV_PACK: i32 = 1;            // #pragma pack: members aligned to at most `value` bytes (0: as their types are)
pub const EV_VISIBILITY: i32 = 2;      // #pragma GCC visibility: a VIS_ value
pub const EV_FENV_ACCESS: i32 = 3;     // #pragma STDC FENV_ACCESS: 1 ON, 0 OFF or DEFAULT
pub const EV_FENV_ROUND: i32 = 4;      // #pragma STDC FENV_ROUND: an FPR_ value
pub const EV_FENV_DEC_ROUND: i32 = 5;  // #pragma STDC FENV_DEC_ROUND: an FPD_ value
pub const EV_FNOPTS: i32 = 6;          // #pragma GCC optimize, target, ..._options: fn_options' number (0: none)
pub const EV_LOOP: i32 = 7;            // #pragma GCC unroll, ivdep, novector: LH_ bits, for the loop at its position

/// What the loop pragmas say of the loop statement after them (cast.Stmt's
/// hints): `GCC unroll n` as n + 1 in the low 16 bits (n at most 65534;
/// 0 and 1 mean no unrolling), `GCC ivdep`, `GCC novector`.
pub const LH_UNROLL_MASK: u32 = 0xFFFF;
pub const LH_IVDEP: u32 = 0x10000;
pub const LH_NOVECTOR: u32 = 0x20000;

// The options `#pragma GCC optimize` and `target` give the functions
// defined after them: the optimizer's level (-1: the program's), and the
// extensions (a comma-separated list, empty for none).
struct FnOpts {
    level: i32,
    target: []u8,
}

let mut g_fnopts: u.List.[FnOpts] = u.List.[FnOpts].{ data: @ptr_from_int(*mut FnOpts, 0), len: 0, cap: 0 };

/// A set of function options; its number (from 1) for EV_FNOPTS.
pub fn fn_options(level: i32, target: []u8) u64 {
    g_fnopts.push(FnOpts.{ level: level, target: target });
    return @as(u64, g_fnopts.len);
}

/// The level of function options number k (-1: none, or k is 0).
pub fn fn_level(k: u64) i32 {
    if (k == 0) or (k > @as(u64, g_fnopts.len)) {
        return -1;
    }
    return g_fnopts.get(@truncate(usize, k - 1)).level;
}

/// The extensions of function options number k ("" if none).
pub fn fn_target(k: u64) []u8 {
    if (k == 0) or (k > @as(u64, g_fnopts.len)) {
        return "";
    }
    return g_fnopts.get(@truncate(usize, k - 1)).target;
}

/// The state of the floating-point pragmas at a point (cast.Stmt's fp,
/// cast.Decl's fp): FP_ACCESS if FENV_ACCESS is ON, the FENV_ROUND
/// direction (FPR_ values) times FP_ROUND, and the FENV_DEC_ROUND
/// direction (FPD_ values) times FP_DEC_ROUND.
pub const FP_ACCESS: u32 = 1;
pub const FP_ROUND: u32 = 2;
pub const FP_DEC_ROUND: u32 = 16;
pub const FPR_DYNAMIC: u32 = 0;
pub const FPR_NEAREST: u32 = 1;
pub const FPR_UPWARD: u32 = 2;
pub const FPR_DOWNWARD: u32 = 3;
pub const FPR_TOWARDZERO: u32 = 4;

/// The FENV_DEC_ROUND directions (C23 7.6.3): dynamic, then decimal.ax's
/// R_ numbers plus one (FE_DEC_TONEAREST, FE_DEC_DOWNWARD, FE_DEC_UPWARD,
/// FE_DEC_TOWARDZERO, FE_DEC_TONEARESTFROMZERO).
pub const FPD_DYNAMIC: u32 = 0;

/// The FENV_ROUND direction of a state.
pub fn fp_round(st: u32) u32 {
    return (st / FP_ROUND) & 7;
}

/// The FENV_DEC_ROUND direction of a state (an FPD_ value).
pub fn fp_dec_round(st: u32) u32 {
    return (st / FP_DEC_ROUND) & 7;
}

/// Whether the floating operations under state st are strict (ir.Func's
/// strict_fp): FENV_ACCESS ON, or a static rounding direction.
pub fn fp_strict(st: u32) bool {
    return st != 0;
}

// The state st with the change c applied.
fn fp_change(st: u32, c: *Change) u32 {
    if c.kind == EV_FENV_ACCESS {
        return (st & ~FP_ACCESS) | @truncate(u32, c.value);
    }
    if c.kind == EV_FENV_DEC_ROUND {
        return (st & ~(7 * FP_DEC_ROUND)) | (@truncate(u32, c.value) * FP_DEC_ROUND);
    }
    return (st & ~(7 * FP_ROUND)) | (@truncate(u32, c.value) * FP_ROUND);
}

/// The state st with the floating-point pragmas placed at the token at
/// index pos applied (the start of a compound statement, a block item or
/// an external declaration: where 6.10.6p2 puts them), each once.
pub fn fp_apply(st: u32, pos: usize) u32 {
    let mut s = st;
    for k in 0..g_changes.len {
        let c = g_changes.at(k);
        if c.placed and (c.pos <= pos) and
           ((c.kind == EV_FENV_ACCESS) or (c.kind == EV_FENV_ROUND) or (c.kind == EV_FENV_DEC_ROUND)) {
            s = fp_change(s, c);
            c.kind = -c.kind;  // (applied: not again)
        }
    }
    return s;
}

/// Visibilities (`#pragma GCC visibility push(...)`, the attribute visibility).
pub const VIS_DEFAULT: u64 = 0;
pub const VIS_HIDDEN: u64 = 1;
pub const VIS_PROTECTED: u64 = 2;
pub const VIS_INTERNAL: u64 = 3;

/// A `#pragma weak`.
pub struct Weak {
    name: []u8,
    target: []u8,  // `name = target`: name is another name for target (empty: none)
    span: u.Span,
}

// A #pragma GCC diagnostic or system_header, in the order read.
struct Rule {
    file: i32,
    off: u32,    // where it is in its file
    kind: i32,   // R_
    code: []u8,  // the warning code it is about (empty: all of them)
}

const R_IGNORED: i32 = 1;
const R_WARNING: i32 = 2;
const R_ERROR: i32 = 3;
const R_PUSH: i32 = 4;
const R_POP: i32 = 5;
const R_SYSTEM: i32 = 6;  // the rest of the file is a system header's: no warnings
const R_ENTER: i32 = 7;   // the file is entered (included) here

let mut g_changes: u.List.[Change] = u.List.[Change].{ data: @ptr_from_int(*mut Change, 0), len: 0, cap: 0 };
let mut g_weak: u.List.[Weak] = u.List.[Weak].{ data: @ptr_from_int(*mut Weak, 0), len: 0, cap: 0 };
let mut g_rules: u.List.[Rule] = u.List.[Rule].{ data: @ptr_from_int(*mut Rule, 0), len: 0, cap: 0 };
let mut g_installed: bool = false;

/// Starts a translation unit's pragmas (the preprocessor calls it).
pub fn begin_unit() void {
    g_changes.clear();
    g_weak.clear();
    g_fnopts.clear();
    if not g_installed {
        g_installed = true;
        dg.filter = filter;
    }
}

// -----------------------------------------------------------------------------
// Values by position
// -----------------------------------------------------------------------------

/// A change of a value (kind: EV_) the preprocessor makes; its number,
/// which the token for it (lx.PK_PRAGMA) carries to `place`.
pub fn event(kind: i32, value: u64) i32 {
    g_changes.push(Change.{ kind: kind, value: value, pos: 0, placed: false });
    return @int_cast(i32, g_changes.len - 1);
}

/// The change numbered id holds from the token at index pos on.
pub fn place(id: i32, pos: usize) void {
    if (id >= 0) and (@int_cast(usize, id) < g_changes.len) {
        let c = g_changes.at(@int_cast(usize, id));
        c.pos = pos;
        c.placed = true;
    }
}

// The value of kind `kind` at the token at index pos: the last change placed
// at or before it (0 if none).
fn value_at(kind: i32, pos: usize) u64 {
    let mut v: u64 = 0;
    let mut best: usize = 0;
    let mut any = false;
    for c in g_changes.items() {
        if (c.kind == kind) and c.placed and (c.pos <= pos) and (not any or (c.pos >= best)) {
            v = c.value;
            best = c.pos;
            any = true;
        }
    }
    return v;
}

/// The `#pragma pack` value at the token at index pos (0: none).
pub fn pack_at(pos: usize) u64 {
    return value_at(EV_PACK, pos);
}

/// The function options (fn_options' number) in force at the token at
/// index pos.
pub fn fn_options_at(pos: usize) u64 {
    return value_at(EV_FNOPTS, pos);
}

/// The loop pragmas (LH_ bits) for a statement that begins at the token at
/// index pos: those placed there.
pub fn loop_hints_at(pos: usize) u32 {
    let mut h: u32 = 0;
    for c in g_changes.items() {
        if (c.kind == EV_LOOP) and c.placed and (c.pos == pos) {
            let v = @truncate(u32, c.value);
            if (v & LH_UNROLL_MASK) != 0 {
                h = h & ~LH_UNROLL_MASK;
            }
            h = h | v;
        }
    }
    return h;
}

/// The `#pragma GCC visibility` value at the token at index pos.
pub fn visibility_at(pos: usize) u64 {
    return value_at(EV_VISIBILITY, pos);
}

/// Tokens were dropped from the stream before the parser saw it: the
/// positions after `from` move back by n.
pub fn shift(from: usize, n: usize) void {
    for k in 0..g_changes.len {
        let c = g_changes.at(k);
        if c.pos >= (from + n) {
            c.pos -= n;
        } else if c.pos > from {
            c.pos = from;
        }
    }
}

/// A pragma's line for the preprocessed text (--emit=c-pp): what it is
/// written as, before the token at index pos.
pub struct Line {
    pos: usize,
    text: []u8,
}

// Adds a line at pos, after those at or before it (in order of position:
// few of them).
fn add_line(l: *mut u.List.[Line], pos: usize, t: []u8) void {
    let mut k = l.len;
    l.push(Line.{ pos: pos, text: t });
    while (k > 0) and (l.get(k - 1).pos > pos) {
        let x = l.get(k - 1);
        l.set(k - 1, l.get(k));
        l.set(k, x);
        k -= 1;
    }
}

/// The pragmas the phases after the preprocessor need, as lines for the
/// preprocessed text, in the order of their positions: each change of the
/// pack value as `pack(n)`, of the visibility as `GCC visibility push(v)`
/// or `pop`, of the functions' options as `GCC reset_options` and the
/// `GCC optimize` and `target` that give them, the loop pragmas as they
/// were, the floating-point ones, then the `weak` ones at the end (pos: max).
pub fn lines() []Line {
    let mut l = u.List.[Line].empty();
    for c in g_changes.items() {
        if not c.placed {
            continue;
        }
        let mut t = "";
        let kind = @max(c.kind, -c.kind);
        if kind == EV_FNOPTS {
            // (the options as they are from here: none, then the level and
            // the extensions)
            add_line(&mut l, c.pos, "GCC reset_options");
            if fn_level(c.value) >= 0 {
                add_line(&mut l, c.pos, u.f1("GCC optimize(%s)", u.idec(fn_level(c.value))));
            }
            if fn_target(c.value).len > 0 {
                add_line(&mut l, c.pos, u.f1("GCC target(\"%s\")", fn_target(c.value)));
            }
            continue;
        }
        if kind == EV_LOOP {
            let v = @truncate(u32, c.value);
            if (v & LH_UNROLL_MASK) != 0 {
                add_line(&mut l, c.pos, u.f1("GCC unroll %s", u.udec(@as(u64, (v & LH_UNROLL_MASK) - 1))));
            }
            if (v & LH_IVDEP) != 0 {
                add_line(&mut l, c.pos, "GCC ivdep");
            }
            if (v & LH_NOVECTOR) != 0 {
                add_line(&mut l, c.pos, "GCC novector");
            }
            continue;
        }
        if kind == EV_PACK {
            t = "pack()";
            if c.value != 0 {
                t = u.f1("pack(%s)", u.udec(c.value));
            }
        } else if kind == EV_FENV_ACCESS {
            t = "STDC FENV_ACCESS OFF";
            if c.value != 0 {
                t = "STDC FENV_ACCESS ON";
            }
        } else if kind == EV_FENV_ROUND {
            let dirs = ["FE_DYNAMIC", "FE_TONEAREST", "FE_UPWARD", "FE_DOWNWARD", "FE_TOWARDZERO"];
            t = u.cat2("STDC FENV_ROUND ", dirs[@truncate(usize, c.value % 5)]);
        } else if kind == EV_FENV_DEC_ROUND {
            let dirs = ["FE_DEC_DYNAMIC", "FE_DEC_TONEAREST", "FE_DEC_DOWNWARD", "FE_DEC_UPWARD", "FE_DEC_TOWARDZERO",
                        "FE_DEC_TONEARESTFROMZERO"];
            t = u.cat2("STDC FENV_DEC_ROUND ", dirs[@truncate(usize, c.value % 6)]);
        } else {
            let names = ["default", "hidden", "protected", "internal"];
            t = "GCC visibility pop";
            if c.value != 0 {
                t = u.f1("GCC visibility push(%s)", names[@truncate(usize, c.value & 3)]);
            }
        }
        add_line(&mut l, c.pos, t);
    }
    for w in g_weak.items() {
        let mut t = u.cat2("weak ", w.name);
        if w.target.len > 0 {
            t = u.f2("weak %s = %s", w.name, w.target);
        }
        l.push(Line.{ pos: 0xFFFF_FFFF, text: t });
    }
    return l.items();
}

/// A `#pragma weak`.
pub fn add_weak(name: []u8, target: []u8, sp: u.Span) void {
    g_weak.push(Weak.{ name: name, target: target, span: sp });
}

/// The unit's `#pragma weak`s.
pub fn weaks() []Weak {
    return g_weak.items();
}

// -----------------------------------------------------------------------------
// Diagnostics
// -----------------------------------------------------------------------------

/// `#pragma GCC diagnostic ignored|warning|error|push|pop` at sp, about the
/// warning `code` (empty: every warning).
pub fn diagnostic(sp: u.Span, kind: []u8, code: []u8) void {
    let mut k = R_IGNORED;
    if u.str_eq(kind, "warning") {
        k = R_WARNING;
    } else if u.str_eq(kind, "error") {
        k = R_ERROR;
    } else if u.str_eq(kind, "push") {
        k = R_PUSH;
    } else if u.str_eq(kind, "pop") {
        k = R_POP;
    }
    g_rules.push(Rule.{ file: sp.file, off: sp.start, kind: k, code: code });
}

/// `#pragma GCC system_header` at sp: the rest of its file gives no warnings.
pub fn system_header(sp: u.Span) void {
    g_rules.push(Rule.{ file: sp.file, off: sp.start, kind: R_SYSTEM, code: "" });
}

// The files that are the system C library's headers (--c-lib=system).
let mut g_system_files: u.SymMap.[u8] = u.SymMap.[u8].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u8, 0), cap: 0, len: 0 };

/// File `file` is a header of the system's C library (--c-lib=system): as
/// the implementation's own, it gives no warnings, nor the errors that say
/// a feature is a later standard's (the system's headers use them, guarded
/// in ways this front end's predefined macros do not tell them of; the
/// program's own code is checked as always).
pub fn system_file(file: i32) void {
    g_system_files.put(u.addr_key(@as(usize, @bit_cast(u32, file)) + 1), 1);
    if not g_installed {
        g_installed = true;
        dg.filter = filter;
    }
}

// The codes of "a feature of a later standard" (docs/c-diagnostics.md),
// and of an empty declaration at file scope, which the system's headers
// have where their macros expand to nothing.
let LATER_STD: [28][]u8 = ["C2004", "C1012", "C1015", "C1017", "C1020", "C1021", "C1051", "C1054", "C1065", "C2003",
                           "C2100", "C2101", "C2106", "C2107", "C2108", "C2109", "C2110", "C2111", "C2112", "C2127",
                           "C2135", "C2136", "C2137", "C2138", "C2139", "C2140", "C2141", "C2134"];

fn in_system_file(sp: u.Span, sev: i32, code: []u8) bool {
    if (g_system_files.len == 0) or (g_system_files.get(u.addr_key(@as(usize, @bit_cast(u32, sp.file)) + 1)) == 0) {
        return false;
    }
    if sev == dg.SEV_WARNING {
        return true;
    }
    for c in LATER_STD {
        if u.str_eq(c, code) {
            return true;
        }
    }
    return false;
}

/// The preprocessor enters file `file` (its first lines are read next).
pub fn enter_file(file: i32) void {
    if g_rules.len > 0 {
        g_rules.push(Rule.{ file: file, off: 0, kind: R_ENTER, code: "" });
    }
}

// The severity a warning `code` at sp has under the rules (-1: it is not
// shown). The rules that count are those read before sp: the last one in
// sp's file before it and all before that one; or, if its file has none
// before sp, those read before the file was first entered.
fn filter(sev: i32, sp: u.Span, code: []u8) i32 {
    if in_system_file(sp, sev, code) {
        return -1;
    }
    if (g_rules.len == 0) or (sev != dg.SEV_WARNING) {
        return sev;
    }
    let rs = g_rules.items();
    let mut last: usize = 0;
    let mut found = false;
    for i in 0..rs.len {
        if (rs[i].file == sp.file) and (rs[i].off <= sp.start) and (rs[i].kind != R_ENTER) {
            last = i;
            found = true;
        }
    }
    if not found {
        for i in 0..rs.len {
            if (rs[i].file == sp.file) and (rs[i].kind == R_ENTER) {
                if i == 0 {
                    return sev;
                }
                last = i - 1;
                found = true;
                break;
            }
        }
    }
    if not found {
        return sev;
    }
    // replayed: the action for the code, with push and pop; system headers
    let mut stack = u.List.[i32].empty();
    let mut act: i32 = 0;
    let mut system = false;
    for i in 0..last + 1 {
        let r = &rs[i];
        if r.kind == R_PUSH {
            stack.push(act);
        } else if r.kind == R_POP {
            if stack.len > 0 {
                act = stack.pop();
            }
        } else if r.kind == R_SYSTEM {
            if r.file == sp.file {
                system = true;
            }
        } else if r.kind != R_ENTER {
            if (r.code.len == 0) or u.str_eq(r.code, code) {
                act = r.kind;
            }
        }
    }
    stack.deinit();
    if system or (act == R_IGNORED) {
        return -1;
    }
    if act == R_ERROR {
        return dg.SEV_ERROR;
    }
    return sev;
}

/// The warning code a `#pragma GCC diagnostic` option names: one of the
/// compiler's codes (written as itself, "C4050"), or an option of the usual
/// spelling that stands for one ("-Wdeprecated-declarations"); empty for
/// "-Wall", "-Wextra" and "-Wpedantic" (every warning); nil for any other.
/// An option of several codes (-Wformat) gives them separated by commas.
pub fn option_code(opt: []u8) []u8 {
    if (opt.len == 5) and (opt[0] == 'C') and (opt[1] == '4') {
        return u.intern(opt);
    }
    if u.str_eq(opt, "-Wall") or u.str_eq(opt, "-Wextra") or u.str_eq(opt, "-Wpedantic") {
        return "";
    }
    let names = ["-Wdeprecated-declarations", "-Wdeprecated", "-Wunused-result", "-Wattributes", "-Wunknown-attributes",
                 "-Winvalid-noreturn", "-Wimplicit-function-declaration", "-Wimplicit", "-Wunused-label", "-Wvarargs",
                 "-Wmultichar", "-Wcpp", "-Wunknown-pragmas", "-Wpragmas", "-Wnonnull", "-Wunused-value",
                 "-Wswitch-outside-range", "-Wattribute-warning"];
    let codes = ["C4050", "C4050", "C4051", "C4052", "C4052", "C4053", "C4001", "C4001", "C4040", "C4080", "C4102",
                 "C4103", "C4111", "C4112", "C4121", "C4051", "C4120", "C4123"];
    for k in 0..names.len {
        if u.str_eq(opt, names[k]) {
            return codes[k];
        }
    }
    // (the format checks, csema_format.ax: several codes, by commas)
    let fnames = ["-Wformat", "-Wformat-extra-args", "-Wformat-nonliteral", "-Wformat-security", "-Wformat-signedness"];
    let fcodes = ["C4130,C4131,C4132,C4133,C4134,C4135", "C4132", "C4134", "C4134", "C4135"];
    for k in 0..fnames.len {
        if u.str_eq(opt, fnames[k]) {
            return fcodes[k];
        }
    }
    return u.nosym();
}
