// =============================================================================
// csema_simd.ax - the intrinsic functions of the processors' vector and
// special instructions (<emmintrin.h>, <immintrin.h>, <arm_neon.h>,
// <wasm_simd128.h> ...): the builtin the headers are written with, its
// table of operations, and the rule that an intrinsic needs its processor
// extension.
//
// The design. The headers (std/c/include/, generated by
// cmd/internal/tools/gen_x86_intrin.py and its kin) define each intrinsic
// as a static inline function or a macro on the vector types of the GNU
// dialects (vector_size, spelled __axiom_attribute__ so that every mode has
// them), in one of three ways:
//   - where C's vector operators say it (add, sub, mul, logic, compares,
//     lane access, initializers for set and broadcast, casts for bit
//     reinterpretation, dereferences of an unaligned type for loads and
//     stores): plain C, which IR generation makes the IR's vector operations
//     of, and the instruction selectors pick the instruction;
//   - where the IR has the operation but C has no operator
//     (__builtin_axiom_shufflevector, __builtin_axiom_convertvector, and
//     __builtin_axiom_simd of a generic operation: saturating arithmetic,
//     integer min and max, abs, sqrt and rounding, fma, widening, shifts with
//     the processors' rule for large counts, the lanes' top bits): the IR's
//     operation (an intrinsic such as IN_UADD_SAT), which every target
//     selects or computes lane by lane, and the optimizer understands;
//   - everything else (pmaddubsw, psadbw, pshufb, packs, horizontal adds,
//     conversions with the processor's own out-of-range result, the AES,
//     CLMUL, SHA, CRC32 and string instructions, gathers, rdtsc ...):
//     __builtin_axiom_simd of a machine operation: one instruction (or a short
//     fixed sequence) named in the table below, which IR generation makes an
//     asm statement of (IN_ASM: c/cgen_simd.ax) with its operands in
//     registers, pure (ir.ASM_PURE: the optimizer removes, merges and moves
//     it as any computation) unless the table says it is volatile or touches
//     memory. The assembler (asm/x64.ax, its table generated from the
//     instruction set's manual) encodes and checks it, as for inline
//     assembly; on x86-64 an operation has a legacy SSE form and a VEX one,
//     and the backend takes the VEX form in code compiled with AVX (Blob.alt).
//
// __builtin_axiom_simd("op", args...) is typed here from the table entry of
// "op" (csimd_tab.ax): its architecture, the extension it needs, its
// operands' kinds and its result's type. Each header function has the
// attributes target("ext") (its body is compiled with the extension, and the
// builtin's check passes) and always_inline; a call of such a function from
// a function compiled without the extension (the build's --cpu/--features
// and its own target attribute) is C3240 at the call (csema_gnu.ax:
// call_check), as is the builtin itself used where its extension is not
// there: never an instruction the processor may lack.
//
// Diagnostics: C3240 (an extension not enabled), C3241 (an operand the
// operation does not take: not a constant where an immediate is, a vector
// of another size, an unknown operation).
// =============================================================================
import "../target.ax" as tg;
import "../util.ax" as u;
import "cast.ax" as cast;
import "csema.ax" as cs;
import "csema_builtin.ax" as csb;
import "csema_expr.ax" as cx;
import "csema_gbuiltin.ax" as gb;
import "csema_gnu.ax" as cgn;
import "csimd_tab.ax" as tab;
import "ctypes.ax" as cty;

/// A call of __builtin_axiom_simd: its op is SB_SIMD + the entry's index.
pub const SB_SIMD: i32 = 5000;

/// An operation of the table, parsed.
pub struct Op {
    name: []u8,
    arch: u8,     // 'x' x86-64, 'a' AArch64, 'w' WebAssembly, '*' any
    ext: []u8,    // the extensions it needs (feature names joined by '+'), or "-"
    sig: []u8,    // its operands' kinds (sig_ok)
    res: u8,      // its result's type (result_type)
    form: []u8,   // "G": a generic operation (c/cgen_simd.ax), else a machine form
    mn: []u8,     // the mnemonic, or a custom form's template ("@@" then its VEX form)
    cons: []u8,   // a custom form's constraints, ';'-separated ("@@" then the VEX form's)
    clob: []u8,   // a custom form's clobbered registers, ';'-separated
    flags: []u8,  // V: volatile (kept where it is), M: reads or writes memory
}

let mut ops: u.List.[Op] = u.List.[Op].{ data: @ptr_from_int(*mut Op, 0), len: 0, cap: 0 };
let mut by_name: u.SymMap.[i32] = u.SymMap.[i32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut i32, 0),
                                                   cap: 0, len: 0 };

fn field(fs: *u.List.[[]u8], k: usize) []u8 {
    if k < fs.len {
        return fs.get(k);
    }
    return "";
}

fn load() void {
    if ops.len > 0 {
        return;
    }
    for line in tab.TABLE {
        let fs = u.split(line, '|', 10);
        let mut o = Op.{ name: u.intern(field(&fs, 0)), arch: 0, ext: field(&fs, 2), sig: field(&fs, 3), res: 'a',
                         form: field(&fs, 5), mn: field(&fs, 6), cons: field(&fs, 7), clob: field(&fs, 8),
                         flags: field(&fs, 9) };
        let a = field(&fs, 1);
        o.arch = u8_at(a, 0);
        let r = field(&fs, 4);
        o.res = u8_at(r, 0);
        ops.push(o);
        by_name.put(o.name, @int_cast(i32, ops.len));
    }
}

fn u8_at(s: []u8, k: usize) u8 {
    if k < s.len {
        return s[k];
    }
    return 0;
}

/// The operation of a call typed here (its op: SB_SIMD + index).
pub fn op_of(e: *cast.Expr) *Op {
    load();
    return ops.at(@int_cast(usize, e.op - SB_SIMD));
}

/// Is this a call's op of __builtin_axiom_simd?
pub fn is_simd(id: i32) bool {
    return id >= SB_SIMD;
}

fn bad(e: *mut cast.Expr) bool {
    e.ty = cty.t_error;
    e.lvalue = false;
    return true;
}

fn is_err(e: *cast.Expr) bool {
    return u.isnil(e.ty) or (e.ty.kind == cty.TK_ERROR);
}

fn arch_ok(a: u8) bool {
    if a == '*' {
        return true;
    }
    if a == 'x' {
        return tg.g_arch == tg.ARCH_X64;
    }
    if a == 'a' {
        return tg.g_arch == tg.ARCH_A64;
    }
    return tg.is_wasm();
}

fn arch_name(a: u8) []u8 {
    if a == 'x' {
        return "x86-64";
    }
    if a == 'a' {
        return "AArch64";
    }
    return "WebAssembly";
}

/// The extensions an operation needs: the feature bits of its names.
pub fn ext_bits(ext: []u8) u64 {
    if (ext.len == 0) or u.str_eq(ext, "-") {
        return 0;
    }
    let mut spec = u.Buf.init();
    for c in ext {
        if c == '+' {
            spec.c(',');
        } else {
            spec.c(c);
        }
    }
    return tg.parse_features(spec.done()).bits;
}

/// The extensions the code being analyzed is compiled with: the build's,
/// and those of the function's attribute target.
pub fn cur_features() u64 {
    return cgn.fn_target_bits(cs.cur_fn());
}

/// Installs the builtin in csema_builtin.ax.
pub fn install() void {
    csb.simd_call = call;
}

/// Types a call of __builtin_axiom_simd, __builtin_axiom_shufflevector
/// (the dialects' __builtin_shufflevector, in every mode): true if the
/// callee is one of them.
pub fn call(e: *mut cast.Expr) bool {
    let name = e.a.name;
    if u.str_eq(name, "__builtin_axiom_shufflevector") {
        return gb.vec_builtin(e, "__builtin_shufflevector");
    }
    if not u.str_eq(name, "__builtin_axiom_simd") {
        return false;
    }
    load();
    if e.args.len == 0 {
        cs.err(e.span, "C3241", "'__builtin_axiom_simd' takes an operation's name and its operands");
        return bad(e);
    }
    e.args.set(0, cx.rv(e.args.get(0)));
    let s = string_value(e.args.get(0));
    let mut k: i32 = 0;
    if not u.isnos(s) {
        k = by_name.get(u.intern(s));
    }
    if k == 0 {
        cs.err(e.args.get(0).span, "C3241",
               "the first argument of '__builtin_axiom_simd' must name one of its operations");
        return bad(e);
    }
    let o = ops.at(@int_cast(usize, k - 1));
    e.op = SB_SIMD + (k - 1);
    if not arch_ok(o.arch) {
        cs.err(e.span, "C3240", u.f2("the operation '%s' is %s's", s, arch_name(o.arch)));
        return bad(e);
    }
    if (e.args.len - 1) != o.sig.len {
        cs.err(e.span, "C3241", u.f3("the operation '%s' takes %s operands, not %s", s, u.zdec(o.sig.len),
                                     u.zdec(e.args.len - 1)));
        return bad(e);
    }
    let mut ok = true;
    for j in 0..o.sig.len {
        let x = cx.rv(e.args.get(j + 1));
        e.args.set(j + 1, x);
        if is_err(x) {
            ok = false;
            continue;
        }
        if not sig_ok(o.sig[j], x, e.args.get(1)) {
            cs.err(x.span, "C3241", u.f3("operand %s of the operation '%s' cannot be of type %s", u.zdec(j + 1), s,
                                         cs.tq(x.ty)));
            ok = false;
        }
    }
    if not ok {
        return bad(e);
    }
    let mut need = ext_bits(o.ext);
    let mut what = o.ext;
    if (o.arch == 'x') and not u.str_eq(o.form, "G") and wide_operand(e) and ((need & tg.X_AVX2) == 0) {
        // (a machine operation on 32-byte vectors: in one ymm register, which
        // the code generator keeps them in only with AVX2)
        need = need | tg.X_AVX2;
        what = u.pick(u.str_eq(o.ext, "-"), "avx2", u.cat2(o.ext, "+avx2"));
    }
    if (need & ~cur_features()) != 0 {
        cs.err(e.span, "C3240",
               u.f2("the operation '%s' needs the processor extension '%s', which this function is not compiled for", s,
                    what));
        return bad(e);
    }
    e.ty = result_type(o.res, e);
    e.lvalue = false;
    return true;
}

// Has call e a vector operand (after the name) or result of 32 or more bytes?
fn wide_operand(e: *cast.Expr) bool {
    for k in 1..e.args.len {
        let t = e.args.get(k).ty;
        if u.notnil(t) and cty.is_vector(t) and (cty.size_of(t) >= 32) {
            return true;
        }
    }
    return false;
}

// Does operand x (first: the operation's first operand) have the kind c?
//   v  a vector             V  a vector of the first operand's size
//   s  an integer           f  a real floating value
//   i  an integer constant  n  an integer (a constant or not)
//   p  a pointer            x  an integer or a real floating value
fn sig_ok(c: u8, x: *cast.Expr, first: *cast.Expr) bool {
    let t = x.ty;
    if c == 'v' {
        return cty.is_vector(t);
    }
    if c == 'V' {
        return cty.is_vector(t) and cty.is_vector(first.ty) and (cty.size_of(t) == cty.size_of(first.ty));
    }
    if (c == 's') or (c == 'n') {
        return cty.is_integer(t);
    }
    if c == 'i' {
        return cty.is_integer(t) and x.is_const;
    }
    if c == 'f' {
        return cty.is_floating(t) and not cty.is_complex(t);
    }
    if c == 'p' {
        return cty.is_pointer(t);
    }
    if c == 'x' {
        return cty.is_integer(t) or (cty.is_floating(t) and not cty.is_complex(t));
    }
    return false;
}

// The type of the result r: a the first operand's (a vector: the result
// has its size, its lanes being the operation's), b the second's, 2 and h a vector of its
// element type of twice and half its size, q four unsigned ints, v void, i int, u
// unsigned int, l long long, L unsigned long long, f float, d double.
fn result_type(r: u8, e: *cast.Expr) *mut cty.CType {
    if r == 'v' {
        return cty.t_void;
    }
    if r == 'i' {
        return cty.t_int;
    }
    if r == 'u' {
        return cty.t_uint;
    }
    if r == 'l' {
        return cty.t_llong;
    }
    if r == 'L' {
        return cty.t_ullong;
    }
    if r == 'f' {
        return cty.t_float;
    }
    if r == 'd' {
        return cty.t_double;
    }
    if r == 'b' {
        return cty.unqual(e.args.get(2).ty);
    }
    let t = cty.unqual(e.args.get(1).ty);
    if (r == '2') or (r == 'h') {
        // (a vector of twice, or half, the first operand's size)
        let n = cty.size_of(t);
        if r == '2' {
            return cty.vector_of(t.unq.elem, n * 2);
        }
        return cty.vector_of(t.unq.elem, n / 2);
    }
    if r == 'q' {
        return cty.vector_of(cty.t_uint, 16);  // (cpuid's eax, ebx, ecx, edx)
    }
    return t;
}

// The text of string literal x (maybe converted), or nil.
fn string_value(x: *cast.Expr) []u8 {
    let mut s = x;
    if (s.kind == cast.ExprKind.CAST) and u.notnil(s.a) {
        s = s.a;
    }
    if (s.kind != cast.ExprKind.STRING) or u.isnil(s.tok) or (s.tok.prefix != 0) {
        return u.nosym();
    }
    let mut b = u.Buf.init();
    for c in s.tok.units {
        if (c == 0) or (c > 0x7f) {
            return u.nosym();
        }
        b.c(@truncate(u8, c));
    }
    return b.done();
}
