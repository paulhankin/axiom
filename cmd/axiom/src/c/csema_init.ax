// =============================================================================
// csema_init.ax - initializers (6.7.9) into their normal form: for each
// scalar subobject that is given a value, its offset, type and the
// expression converted to that type (cast.InitList); a structure or union
// given by an expression, or a character array by a string literal, is one
// item. csema_desig.ax does the work: brace elision, designators, and the
// constraints on the initializers of objects with static storage duration
// and of constexpr objects.
// =============================================================================
import "cast.ax" as cast;
import "csema_desig.ax" as cdi;
import "ctypes.ax" as cty;

/// What initializer returns: the normal form, and the object's type (an
/// array of unknown length completed).
pub struct Result {
    list: *mut cast.InitList,
    ty: *mut cty.CType,
}

/// The initializer `it` of an object of type t (static: of static storage
/// duration) in normal form.
pub fn initializer(t: *mut cty.CType, it: *mut cast.Init, is_static: bool) Result {
    let r = cdi.initializer(t, it, is_static, false);
    return Result.{ list: r.list, ty: r.ty };
}
