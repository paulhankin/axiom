// =============================================================================
// a64.ax - AArch64 code generation (AAPCS64: Linux, macOS, Windows):
// instruction selection from the scalar IR into machine IR (mach.ax),
// register allocation, frame layout and encoding (a64enc.ax) into an ELF
// object (with, for Windows, unwind information: a64unwind.ax, and line
// tables: winlines.ax).
//
// Like the x86-64 backend: integers narrower than 32 bits live in registers
// with unspecified upper bits (i1 is always 0 or 1); every function keeps a
// frame pointer (x29). Stack slots are addressed from sp, which does not
// move after the prologue. x16 and x17 are scratch registers of the
// encoder (large offsets, symbol addresses); x18 is reserved.
//
// Most instructions are "raw": the selector computes the instruction word
// and the encoder fills in the allocated registers.
//
// Parts: scalar arithmetic, casts, and floating point (a64_arith.ax), memory
// and atomics (a64_mem.ax), calls and sibling calls (a64_call.ax), integer,
// instruction, and vector intrinsics (a64_intr.ax), NEON vectors and
// legalization (a64_vec.ax), instruction/terminator selection and IR prep
// (a64_sel.ax), inline assembly (a64_asm.ax), machine encoding (a64_encode.ax),
// frames, unwind tables, and debug locations (a64_frame.ax), and register
// allocation, function compilation, and module compilation (a64_module.ax).
// =============================================================================
import "a64enc.ax" as ae;
import "a64unwind.ax" as uw;
import "bin.ax" as bn;
import "dwarf.ax" as dw;
import "elf.ax" as elf;
import "ftab.ax" as ft;
import "ir.ax" as ir;
import "isel.ax" as is;
import "mach.ax" as mc;
import "macunwind.ax" as mu;
import "util.ax" as u;

import part "a64_arith.ax";
import part "a64_asm.ax";
import part "a64_call.ax";
import part "a64_encode.ax";
import part "a64_frame.ax";
import part "a64_intr.ax";
import part "a64_mem.ax";
import part "a64_module.ax";
import part "a64_sel.ax";
import part "a64_vec.ax";

const GPR: u8 = 0;
const VR: u8 = 1;

// physical registers: x0-x30 are 0-30, sp is 31, v0-v31 are 32-63
const X0: i32 = 0;
const X16: i32 = 16;
const X17: i32 = 17;
const X8: i32 = 8;  // the indirect result register
const FP: i32 = 29;
const LR: i32 = 30;
const SP: i32 = 31;
const V0: i32 = 32;

// machine ops
const MOV: i32 = 1;     // d, s (64-bit register copy)
const FMOV: i32 = 2;    // d, s (128-bit vector register copy)
const MOVI: i32 = 3;    // d, imm (sz 4 / 8)
const LDR: i32 = 4;     // d, mem (sz 1, 2, 4, 8: zero-extending)
const STR: i32 = 5;     // mem, s | imm 0
const FLDR: i32 = 6;    // d, mem (sz 4, 8, 16)
const FSTR: i32 = 7;    // mem, s
const LEA: i32 = 8;     // d, mem
const ADDR: i32 = 9;    // d, sym (adrp + add)
const GOT: i32 = 10;    // d, sym (adrp + ldr from the GOT)
const TLS: i32 = 11;    // d, sym (thread pointer + offset)
const B: i32 = 12;      // label
const BCC: i32 = 13;    // label, fake uses...; cc: condition
const CBZ: i32 = 14;    // r, label, fake uses...; cc: 0 cbz, 1 cbnz; sz
const CALL: i32 = 15;   // sym | reg, uses..., defs...
const RET: i32 = 16;    // uses
const LABEL: i32 = 17;  // aux: local label
const RAW: i32 = 18;    // up to 4 register operands: Rd, Rn, Rm, Ra fields; aux: the instruction word
const PRFM: i32 = 19;   // mem; cc: the operation (0 pldl1keep, 0x10 pstl1keep)
// The stack pointer moved (ir.IN_STACK_ALLOC ...), sp an operand: cc 0: r(UD) bytes allocated (probing each
// page), r(D) <- their address above the outgoing arguments; 1: r(D) <- sp; 2: sp <- r(U)
const DYNSTACK: i32 = 20;
// An asm statement (gen_asm): aux its blob (asm/inline.ax), cc a number unique to it (its template's
// %=); ops its operands, then its clobbers (D, E) and asm goto's result (D, E)
const ASM: i32 = 21;
// An indirect jump through a jump table (gen_jump_table): ops r(U) the index, two scratch r(D, E),
// then the targets' labels; sz 4: a 32-bit index (zero-extended by the load), 8: 64-bit; aux: the
// table's symbol (enc_jtab)
const JTAB: i32 = 64;

const LOCAL_BASE: i32 = 1_000_000;

// condition codes
const EQ: i32 = 0;
const NE: i32 = 1;
const HS: i32 = 2;
const LO: i32 = 3;
const MI: i32 = 4;
const PL: i32 = 5;
const VS: i32 = 6;
const VC: i32 = 7;
const HI: i32 = 8;
const LS: i32 = 9;
const GE: i32 = 10;
const LT: i32 = 11;
const GT: i32 = 12;
const LE: i32 = 13;

// The object being written (compile)
struct Obj {
    obj: *mut elf.Obj,
    text: i32,   // the section of the code being made
    text0: i32,  // .text
    rodata: i32,
    fsym: u.List.[u32],
    gsym: u.List.[u32],
    galign: u.List.[u64],
    consts: u.SymMap.[u32],
    libsyms: u.SymMap.[u32],
    errors: bool,
    lse: bool,  // the target has the LSE atomics
    // Windows on ARM64: its variadic convention, thread-locals through the TEB
    // (x18), the prologue and epilogue its unwind information describes
    // (win_prologue), and line tables for the PDB
    win: bool,
    xdata: i32,
    pdata: i32,
    lines: i32,
    xdata_sym: u32,
    // macOS: the unwind tables (macunwind.ax), whose entries come from the
    // call frame states (recorded for every function there, with or without
    // -g)
    macos: bool,
    mu: mu.Out,
    ft: ft.Tab,    // frame tables (ftab.ax)
    dbg: dw.Unit,  // -g: the debug information of the object (dwarf.ax)
    // The symbol of the slot offset that the Darwin runtime sets (axiom.tls_key,
    // defined by the linker).
    tls_key_si: i32,
    // The symbol of the image's TLS index on Windows (axiom.tls_index, defined
    // by plink.ax; the loader sets it).
    tls_index_si: i32,
    asm_count: i32,  // numbers the inline asm statements (MInst.cc)
}

threadlocal let mut O: Obj = Obj.{ obj: @ptr_from_int(*mut elf.Obj, 0), text: 0, text0: 0, rodata: 0,
                                   fsym: u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 },
                                   gsym: u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 },
                                   galign: u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 },
                                   consts: u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0),
                                                            vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                   libsyms: u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0),
                                                             vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                   errors: false, lse: false, win: false, xdata: -1, pdata: -1, lines: -1, xdata_sym: 0,
                                   macos: false, mu: mu.Out.{ on: false, obj: @ptr_from_int(*mut elf.Obj, 0),
                                                              x64: false, elf: false, cu: -1, eh: -1, cies: [0; 4] },
                                   ft: ft.Tab.{ on: false, obj: @ptr_from_int(*mut elf.Obj, 0), rets: -1, chains: -1,
                                                text_sym: 0, chains_sym: 0, text0: -1, rets0: -1, cur_text: -1,
                                                others: u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0,
                                                                       cap: 0 }, rel32: 0, abs64: 0, empty: 0,
                                                lines: false, ro: -1, ro_sym: 0,
                                                rec_of: u.U64Map.{ keys: @ptr_from_int(*mut u64, 0),
                                                                   vals: @ptr_from_int(*mut u64, 0), cap: 0, len: 0 },
                                                recs: u.U64Map.{ keys: @ptr_from_int(*mut u64, 0),
                                                                 vals: @ptr_from_int(*mut u64, 0), cap: 0, len: 0 },
                                                pairs: u.U64Map.{ keys: @ptr_from_int(*mut u64, 0),
                                                                  vals: @ptr_from_int(*mut u64, 0), cap: 0, len: 0 },
                                                ctxs: u.U64Map.{ keys: @ptr_from_int(*mut u64, 0),
                                                                 vals: @ptr_from_int(*mut u64, 0), cap: 0, len: 0 },
                                                strs: u.SymMap.[u64].{ keys: @ptr_from_int(*mut usize, 0),
                                                                       vals: @ptr_from_int(*mut u64, 0), cap: 0,
                                                                       len: 0 }, last: [0, 0],
                                                split: @ptr_from_int(*mut ft.Split, 0) }, dbg: dw.Unit.{
                                                    on: false, arch: 0, addr_size: 8, full: false, lang: 0,
                                                    parts: [dw.Part.{ b: bn.Bytes.{ b: u.List.[u8].{ data: @ptr_from_int(*mut u8,
                                                                                                                         0),
                                                                                                     len: 0, cap: 0 } },
                                                                      fx: u.List.[dw.Fix].{ data: @ptr_from_int(*mut dw.Fix,
                                                                                                                0),
                                                                                            len: 0, cap: 0 } }; 11],
                                                    strs: u.SymMap.[u32].{
                                                        keys: @ptr_from_int(*mut usize, 0),
                                                        vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                                    lstrs: u.SymMap.[u32].{
                                                        keys: @ptr_from_int(*mut usize, 0),
                                                        vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                                    files: u.List.[u32].{
                                                        data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 },
                                                    fmap: u.SymMap.[u32].{
                                                        keys: @ptr_from_int(*mut usize, 0),
                                                        vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                                    by_id: u.List.[u32].{
                                                        data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 }, nfuncs: 0,
                                                    first_src: 0, text_sym: 0,
                                                    trefs: u.List.[dw.Fix].{
                                                        data: @ptr_from_int(*mut dw.Fix, 0), len: 0, cap: 0 },
                                                    gsyms: u.SymMap.[u32].{
                                                        keys: @ptr_from_int(*mut usize, 0),
                                                        vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                                    toff: u.List.[u64].{
                                                        data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 },
                                                    drefs: u.List.[dw.Fix].{
                                                        data: @ptr_from_int(*mut dw.Fix, 0), len: 0, cap: 0 },
                                                    gdone: u.List.[bool].{
                                                        data: @ptr_from_int(*mut bool, 0), len: 0, cap: 0 },
                                                    voffs: u.List.[u64].{
                                                        data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 }, tls_rel: 0,
                                                    cies: [0; 4], size_fix: false,
                                                    sums: u.List.[[16]u8].{
                                                        data: @ptr_from_int(*mut [16]u8, 0), len: 0, cap: 0 },
                                                    nosum: false,
                                                    names: u.List.[dw.Named].{
                                                        data: @ptr_from_int(*mut dw.Named, 0), len: 0, cap: 0 },
                                                    abs_fns: u.List.[[]u8].{
                                                        data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 },
                                                    abs_map: u.SymMap.[u32].{
                                                        keys: @ptr_from_int(*mut usize, 0),
                                                        vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 },
                                                    arefs: u.List.[dw.Fix].{
                                                        data: @ptr_from_int(*mut dw.Fix, 0), len: 0, cap: 0 },
                                                    ranges: u.List.[u64].{
                                                        data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 },
                                                    lrefs: u.List.[dw.Fix].{
                                                        data: @ptr_from_int(*mut dw.Fix, 0), len: 0, cap: 0 } },
                                   tls_key_si: -1, tls_index_si: -1, asm_count: 0 };

// The function being compiled (compile_func)
struct Func {
    f: *mut ir.Func,
    mf: *mut mc.MFunc,
    // The function's floating point is strict (ir.Func's strict_fp): its
    // floating-point instructions raise exceptions, effects that mc.dce keeps.
    strict_fp: bool,
    cb: *mut mc.MBlock,
    ib: *mut ir.Block,  // (the block whose code cb holds)
    nlocal: i32,
    out_area: u64,            // outgoing stack-argument bytes
    tail_ends: u.List.[u64],  // macOS: the ends of the function's sibling calls' jumps
    dyn_frame: bool,          // sp moves after the prologue (DYNSTACK): the slots are addressed from x29
    vcs: u.List.[VConst],     // the vector constants loaded in the block vc_blk
    vc_blk: *mut mc.MBlock,
    gaddr: u.List.[GAddr],  // the addresses of globals in registers in the block gaddr_blk
    gaddr_blk: *mut mc.MBlock,
    cas_oks: u.List.[CasOk],  // weak compare-exchanges' success flags (IN_CMPXCHG_OK)
    call_results: u.List.[CallResult],
    tail_jumped: bool,  // (gen_term: the block's return was the jump)
    asm_inst: *mc.MInst,
    asm_err: []u8,
    // the encoding: its code, relocations and branch fixups
    code: bn.Bytes,
    rls: u.List.[Rl],
    fxs: u.List.[Fx],
    local_off: u.List.[u64],
    saved: [18]i32,
    nsaved: usize,
    save_off: [18]i64,
    frame: i64,
    // A leaf with nothing on the stack needs no frame (a call that does not
    // return may still clobber the link register; with frame tables, where the
    // walk needs the caller's return address, it does not).
    frameless: bool,
    // the call frame states as the function is encoded (dwarf.cfi_state): its
    // save list is x29 at CFA - 16, x30 at CFA - 8, then the callee-saved
    // registers in their slots
    cfis: u.List.[u64],
    xcfis: u.List.[dw.XCfi],
    // Windows: the unwind codes of the prologue and the epilogue (win_prologue)
    uw_pro: uw.Codes,
    uw_epi: uw.Codes,
    uw_epis: u.List.[u64],
    // Jump tables: the jumps through one encoded so far, whose tables are
    // filled in once the function's place is known (fill_jump_tables), and a
    // local symbol at the start of the function's section for their entries.
    jtabs: u.List.[*mut mc.MInst],
    jt_text: u32,
}

threadlocal let mut FN: Func = Func.{ f: @ptr_from_int(*mut ir.Func, 0), mf: @ptr_from_int(*mut mc.MFunc, 0),
                                      strict_fp: false, cb: @ptr_from_int(*mut mc.MBlock, 0),
                                      ib: @ptr_from_int(*mut ir.Block, 0), nlocal: 0, out_area: 0,
                                      tail_ends: u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 },
                                      dyn_frame: false,
                                      vcs: u.List.[VConst].{ data: @ptr_from_int(*mut VConst, 0), len: 0, cap: 0 },
                                      vc_blk: @ptr_from_int(*mut mc.MBlock, 0),
                                      gaddr: u.List.[GAddr].{ data: @ptr_from_int(*mut GAddr, 0), len: 0, cap: 0 },
                                      gaddr_blk: @ptr_from_int(*mut mc.MBlock, 0),
                                      cas_oks: u.List.[CasOk].{ data: @ptr_from_int(*mut CasOk, 0), len: 0, cap: 0 },
                                      call_results: u.List.[CallResult].{
                                          data: @ptr_from_int(*mut CallResult, 0), len: 0, cap: 0 }, tail_jumped: false,
                                      asm_inst: @ptr_from_int(*mc.MInst, 0), asm_err: "",
                                      code: bn.Bytes.{ b: u.List.[u8].{ data: @ptr_from_int(*mut u8, 0), len: 0,
                                                                        cap: 0 } },
                                      rls: u.List.[Rl].{ data: @ptr_from_int(*mut Rl, 0), len: 0, cap: 0 },
                                      fxs: u.List.[Fx].{ data: @ptr_from_int(*mut Fx, 0), len: 0, cap: 0 },
                                      local_off: u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 },
                                      saved: [0; 18], nsaved: 0, save_off: [0; 18], frame: 0, frameless: false,
                                      cfis: u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 },
                                      xcfis: u.List.[dw.XCfi].{ data: @ptr_from_int(*mut dw.XCfi, 0), len: 0, cap: 0 },
                                      uw_pro: uw.Codes.{
                                          b: bn.Bytes.{
                                              b: u.List.[u8].{ data: @ptr_from_int(*mut u8, 0), len: 0, cap: 0 } },
                                          at: u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 } },
                                      uw_epi: uw.Codes.{
                                          b: bn.Bytes.{
                                              b: u.List.[u8].{ data: @ptr_from_int(*mut u8, 0), len: 0, cap: 0 } },
                                          at: u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 } },
                                      uw_epis: u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 },
                                      jtabs: u.List.[*mut mc.MInst].{ data: @ptr_from_int(*mut *mut mc.MInst, 0),
                                                                      len: 0, cap: 0 }, jt_text: 0 };

fn fail(msg: []u8) void {
    u.eprint(u.f2("axiom: AArch64 code generation: %s (in %s)\n", msg, FN.f.name));
    O.errors = true;
}

// -----------------------------------------------------------------------------
// Emission helpers
// -----------------------------------------------------------------------------
fn emit(op: i32, sz: u8, ops: []mc.MOp) *mut mc.MInst {
    let i = mc.new_inst(op, sz, ops);
    mc.append(FN.cb, i);
    return i;
}

fn e0(op: i32, sz: u8) *mut mc.MInst {
    return emit(op, sz, @slice_from_ptr(u.nil.[mc.MOp](), 0));
}

fn e1(op: i32, sz: u8, a: mc.MOp) *mut mc.MInst {
    let ops: [1]mc.MOp = [a];
    return emit(op, sz, ops[..]);
}

fn e2(op: i32, sz: u8, a: mc.MOp, b: mc.MOp) *mut mc.MInst {
    let ops: [2]mc.MOp = [a, b];
    return emit(op, sz, ops[..]);
}

fn R(r: i32) mc.MOp {
    return mc.reg(r, mc.RU);
}

fn W(r: i32) mc.MOp {
    return mc.reg(r, mc.RD);
}

fn RW(r: i32) mc.MOp {
    return mc.reg(r, mc.RUD);
}

fn I(x: i64) mc.MOp {
    return mc.imm(x);
}

fn NONE() mc.MOp {
    return mc.none();
}

// A raw instruction word with register fields Rd, Rn, Rm, Ra.
fn raw(w: u64, d: mc.MOp, n: mc.MOp, m: mc.MOp, a: mc.MOp) *mut mc.MInst {
    let ops: [4]mc.MOp = [d, n, m, a];
    let i = emit(RAW, 0, ops[..]);
    i.aux = @bit_cast(i64, w);
    return i;
}

fn raw2(w: u64, d: i32, n: i32) void {
    _ = raw(w, W(d), R(n), NONE(), NONE());
}

fn raw3(w: u64, d: i32, n: i32, m: i32) void {
    _ = raw(w, W(d), R(n), R(m), NONE());
}

// Rd and Rm (Rn fixed in the word, usually the zero register)
fn raw_dm(w: u64, d: i32, m: i32) void {
    _ = raw(w, W(d), NONE(), R(m), NONE());
}

fn raw1(w: u64, d: i32) void {
    _ = raw(w, W(d), NONE(), NONE(), NONE());
}

fn vgpr() i32 {
    return mc.new_vreg(FN.mf, GPR);
}

fn vvr() i32 {
    return mc.new_vreg(FN.mf, VR);
}

fn class_of(t: *ir.Ty) u8 {
    if (t.kind == ir.T_FLOAT) or (t.kind == ir.T_VEC) {
        return VR;
    }
    return GPR;
}

fn is64(t: *ir.Ty) bool {
    return (t.kind == ir.T_PTR) or ((t.kind == ir.T_INT) and (t.bits > 32));
}

fn sfv(t: *ir.Ty) u64 {
    if is64(t) {
        return 1;
    }
    return 0;
}

fn copy(d: i32, s: i32, class: u8) void {
    if d == s {
        return;
    }
    if class == GPR {
        let i = e2(MOV, 8, W(d), R(s));
        i.is_move = true;
    } else {
        let i = e2(FMOV, 16, W(d), R(s));
        i.is_move = true;
    }
    mc.hint(FN.mf, d, s);
    mc.hint(FN.mf, s, d);
}

fn movi(d: i32, x: i64, sf: u64) void {
    let mut sz: u8 = 4;
    if sf == 1 {
        sz = 8;
    }
    _ = e2(MOVI, sz, W(d), I(x));
}

fn new_label() i32 {
    FN.nlocal += 1;
    return LOCAL_BASE + FN.nlocal;
}

fn place(l: i32) void {
    let i = e0(LABEL, 0);
    i.aux = @as(i64, l);
}

fn bcc(cc: i32, l: i32) void {
    let i = e1(BCC, 0, mc.label(l));
    i.cc = cc;
}

fn jmp(l: i32) void {
    _ = e1(B, 0, mc.label(l));
}

// -----------------------------------------------------------------------------
// Symbols and constants
// -----------------------------------------------------------------------------
fn func_sym(f: *ir.Func) i32 {
    return @bit_cast(i32, is.fsym_at(O.obj, &mut O.fsym, f));
}

fn global_sym(g: *ir.Global) i32 {
    return @bit_cast(i32, is.gsym_at(O.obj, &mut O.gsym, g));
}

// A C library function (memcpy, ...).
fn lib_sym(name: []u8) i32 {
    let k = u.intern(name);
    let found = O.libsyms.get(k);
    if found != 0 {
        return @bit_cast(i32, found - 1);
    }
    let s = elf.ext_sym(O.obj, name, false);
    O.libsyms.put(k, s + 1);
    return @bit_cast(i32, s);
}

// A memory operand for a symbol: `label` carries the known alignment.
fn mem_sym(sym: i32, disp: i64, align: u64) mc.MOp {
    let mut m = mc.mem_sym(sym, disp);
    m.label = @truncate(i32, @bit_cast(i64, align));
    return m;
}

// A 16-byte constant in the constant pool (rodata).
fn const16(lo: u64, hi: u64) mc.MOp {
    let key = u.intern(u.f2("%s:%s", u.hex16(lo), u.hex16(hi)));
    let found = O.consts.get(key);
    if found != 0 {
        return mem_sym(@bit_cast(i32, found - 1), 0, 16);
    }
    let s = O.obj.secs.get(@int_cast(usize, O.rodata));
    s.data.align(16);
    let off = @as(u64, s.data.len());
    s.data.u64_(lo);
    s.data.u64_(hi);
    let sym = elf.add_sym(O.obj, elf.Sym.{ name: ".LC", sec: O.rodata, value: off, size: 16, bind: elf.B_LOCAL,
                                           ty: elf.T_OBJECT, hidden: false, protected: false });
    O.consts.put(key, sym + 1);
    return mem_sym(@bit_cast(i32, sym), 0, 16);
}

fn vconst(lo: u64, hi: u64) i32 {
    if FN.vc_blk != FN.cb {
        FN.vcs.clear();
        FN.vc_blk = FN.cb;
    }
    for q in 0..FN.vcs.len {
        let c = FN.vcs.get(q);
        if (c.lo == lo) and (c.hi == hi) {
            return c.r;  // (loaded earlier in the block)
        }
    }
    let r = vvr();
    _ = e2(FLDR, 16, W(r), const16(lo, hi));
    FN.vcs.push(VConst.{ lo: lo, hi: hi, r: r });
    return r;
}

// The vector constants vconst loaded in the current block.
struct VConst {
    lo: u64,
    hi: u64,
    r: i32,
}

// -----------------------------------------------------------------------------
// Values
// -----------------------------------------------------------------------------
fn vreg(v: *mut ir.Value) i32 {
    if v.loc < 0 {
        v.loc = mc.new_vreg(FN.mf, class_of(v.ty));
        if v.ty.kind == ir.T_FLOAT {
            // (a scalar: spilled as 8 bytes, spill_store)
            mc.set_bytes(FN.mf, v.loc, @truncate(u8, @max(v.ty.size, 8)));
        }
    }
    return v.loc;
}

// The addresses of globals built in a register in the current block (reg).
struct GAddr {
    g: *mut ir.Value,
    r: i32,
}

// A register holding v (materializing constants and addresses here).
fn reg(v: *mut ir.Value) i32 {
    let k = v.kind;
    if (k == ir.V_INST) and ((v.op == ir.OP_ALLOCA) or ((v.flag & 1) != 0)) {
        let r = vgpr();
        _ = e2(LEA, 8, W(r), addr(v));
        return r;
    }
    if (k == ir.V_INST) or (k == ir.V_PARAM) {
        return vreg(v);
    }
    let t = v.ty;
    if (k == ir.V_GLOBAL) and not ir.gv_of(v).tls and (FN.gaddr_blk == FN.cb) {
        for q in 0..FN.gaddr.len {
            if FN.gaddr.get(q).g == v {
                return FN.gaddr.get(q).r;  // (built earlier in the block)
            }
        }
    }
    if k == ir.V_GLOBAL {
        let r = vgpr();
        let g = ir.gv_of(v);
        if not g.tls {
            if FN.gaddr_blk != FN.cb {
                FN.gaddr.clear();
                FN.gaddr_blk = FN.cb;
            }
            FN.gaddr.push(GAddr.{ g: v, r: r });
        }
        if g.tls {
            _ = e2(TLS, 8, W(r), mc.symop(global_sym(g), 0));
        } else if is.extern_global(g) {
            _ = e2(GOT, 8, W(r), mc.symop(global_sym(g), 0));
        } else {
            _ = e2(ADDR, 8, W(r), mc.symop(global_sym(g), 0));
        }
        return r;
    }
    if k == ir.V_FUNC {
        let r = vgpr();
        let f = ir.fnp_of(v);
        if ir.is_decl(f) or is.preemptible(f.linkage, f.visibility) {
            _ = e2(GOT, 8, W(r), mc.symop(func_sym(f), 0));
        } else {
            _ = e2(ADDR, 8, W(r), mc.symop(func_sym(f), 0));
        }
        return r;
    }
    if class_of(t) == VR {
        let r = vvr();
        if ir.is_zero(v) or (k == ir.V_UNDEF) {
            raw1(ae.movi_zero(0), r);
            return r;
        }
        let mut b = bn.new_bytes();
        is.const_le(v, &mut b, 0);
        while b.len() < 16 {
            b.u8_(0);
        }
        let lo = b.get_u64(0);
        let hi = b.get_u64(8);
        b.free();
        if t.kind == ir.T_VEC {
            _ = e2(FLDR, 16, W(r), const16(lo, hi));
            return r;
        }
        let imm = fp_imm8(lo, t.bits == 32);
        if imm >= 0 {
            // fmov s/d, #imm
            let mut ty: u64 = 0;
            if t.bits == 64 {
                ty = 1;
            }
            raw1((0x1E20_1000 | (ty << 22)) | (@bit_cast(u64, imm) << 13), r);
            return r;
        }
        // a scalar through a general register
        let g = vgpr();
        if t.bits == 32 {
            movi(g, @bit_cast(i64, lo & 0xFFFF_FFFF), 0);
            raw2(ae.fcvt_int(0, 0, 0, 7, 0, 0), r, g);
        } else {
            movi(g, @bit_cast(i64, lo), 1);
            raw2(ae.fcvt_int(1, 1, 0, 7, 0, 0), r, g);
        }
        return r;
    }
    let r = vgpr();
    let x = is.cval(v);
    if (k == ir.V_UNDEF) or (k == ir.V_ZERO) {
        movi(r, 0, 0);
    } else if (x >= 0) and (x <= 0xffff_ffff) {
        movi(r, x, 0);
    } else if not is64(t) {
        movi(r, x & 0xffff_ffff, 0);
    } else {
        movi(r, x, 1);
    }
    return r;
}

// The 8-bit immediate of FMOV for the float with these bits, or -1: a sign,
// a 4-bit fraction and an exponent in -3..4.
fn fp_imm8(bits: u64, single: bool) i64 {
    let mut sign: u64 = 0;
    let mut e: i64 = 0;
    let mut frac: u64 = 0;
    if single {
        sign = (bits >> 31) & 1;
        e = @bit_cast(i64, (bits >> 23) & 0xff) - 127;
        if (bits & 0x7_ffff) != 0 {
            return -1;
        }
        frac = (bits >> 19) & 15;
    } else {
        sign = (bits >> 63) & 1;
        e = @bit_cast(i64, (bits >> 52) & 0x7ff) - 1023;
        if (bits & 0xffff_ffff_ffff) != 0 {
            return -1;
        }
        frac = (bits >> 48) & 15;
    }
    if (e < -3) or (e > 4) {
        return -1;
    }
    // exponent bits NOT(b):b...b:c:d, with b = 1 for -3..0 and 0 for 1..4
    let mut bcd: u64 = 0;
    if e <= 0 {
        bcd = 4 | @bit_cast(u64, e + 3);
    } else {
        bcd = @bit_cast(u64, e - 1);
    }
    return @bit_cast(i64, ((sign << 7) | (bcd << 4)) | frac);
}

// A memory operand for address p.
fn addr(p: *mut ir.Value) mc.MOp {
    if ir.is_op(p, ir.OP_ALLOCA) {
        return mc.mem_slot(@truncate(i32, p.aux), 0);
    }
    if ir.is_op(p, ir.OP_PTRADD) and ((p.flag & 1) != 0) {
        let off = p.b;
        if is.is_c(off) {
            let mut m = addr(p.a);
            let nd = m.disp + is.cval(off);
            if is.fits32(nd) and (m.index < 0) {
                m.disp = nd;
                return m;
            }
        }
        if (p.flag & 1) != 0 {
            let b = reg(p.a);
            if ir.is_op(off, ir.OP_MUL) and is.is_c(off.b) {
                let s = is.cval(off.b);
                if (s == 1) or (s == 2) or (s == 4) or (s == 8) or (s == 16) {
                    return mc.mem(b, reg(off.a), @truncate(u8, @bit_cast(u64, s)), 0);
                }
            }
            return mc.mem(b, reg(off), 1, 0);
        }
    }
    if (p.kind == ir.V_GLOBAL) and not ir.gv_of(p).tls and not is.extern_global(ir.gv_of(p)) {
        return mem_sym(global_sym(ir.gv_of(p)), 0, O.galign.get(@int_cast(usize, ir.gv_of(p).id)));
    }
    return mc.mem(reg(p), -1, 0, 0);
}
