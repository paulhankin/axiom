// =============================================================================
// ir_restrict.ax - restrict scope and alias disambiguation helpers, part of ir.ax.
// =============================================================================
import "util.ax" as u;

/// The number of restrict scope s (IN_RSCOPE; see above), 0 if it has none.
pub fn scope_num(s: *Value) u32 {
    return @truncate(u32, s.cv >> 32);
}

/// Numbers restrict scope s (IN_RSCOPE) n.
pub fn set_scope_num(s: *mut Value, n: u32) void {
    s.cv = (s.cv & 0xffff_ffff) | (@as(u64, n) << 32);
}

/// The number of the scope whose execution the object of alloca a lives in
/// (see IN_RSCOPE), 0 if not known.
pub fn life_of(a: *Value) u32 {
    return @truncate(u32, a.cv);
}

/// Sets alloca a's life (life_of) to n.
pub fn set_life(a: *mut Value, n: u32) void {
    a.cv = @as(u64, n);
}

/// Forgets the lives (life_of) of f's allocas that are n (all of them if n
/// is 0).
pub fn forget_lives(f: *mut Func, n: u32) void {
    if u.isnil(f.first) {
        return;
    }
    let mut i = f.first.first;  // (all allocas are in the entry block)
    while u.notnil(i) {
        if (i.op == OP_ALLOCA) and (i.cv != 0) and ((n == 0) or (life_of(i) == n)) {
            i.cv = 0;
        }
        i = i.next;
    }
}

/// Forgets the lives of f's allocas that are any of ns (all of them if one
/// is 0): forget_lives of each, in one walk of the entry block.
pub fn forget_lives_of(f: *mut Func, ns: *mut u.List.[usize]) void {
    if u.isnil(f.first) or (ns.len == 0) {
        return;
    }
    u.sort_usize(ns.items_mut());
    if ns.get(0) == 0 {
        forget_lives(f, 0);
        return;
    }
    let mut i = f.first.first;  // (all allocas are in the entry block)
    while u.notnil(i) {
        if (i.op == OP_ALLOCA) and (i.cv != 0) {
            let n = @as(usize, life_of(i));
            let mut lo: usize = 0;
            let mut hi = ns.len;
            while lo < hi {
                let mid = (lo + hi) / 2;
                if ns.get(mid) < n {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            if (lo < ns.len) and (ns.get(lo) == n) {
                i.cv = 0;
            }
        }
        i = i.next;
    }
}

/// The parameter p is based on (through ptradds, and the phis and selects
/// whose operands all are based on it, or step from the phi itself), or nil.
pub fn based_param(p0: *mut Value) *mut Value {
    return based_rec(p0, 0, false);
}

/// The IN_RESTRICT that p is based on (as based_param), or nil.
pub fn based_restrict(p0: *mut Value) *mut Value {
    return based_rec(p0, 0, true);
}

fn is_restrict_root(p: *Value) bool {
    return is_op(p, OP_INTR) and (intr_id(p) == IN_RESTRICT);
}

fn based_rec(p0: *mut Value, depth: i32, restr: bool) *mut Value {
    let mut p = resolve(p0);
    let mut n: i32 = 0;
    while is_op(p, OP_PTRADD) and (n < 32) {
        p = p.a;
        n += 1;
    }
    if u.isnil(p) {
        return p;
    }
    if (p.kind == V_PARAM) and not restr {
        return p;
    }
    if is_op(p, OP_EXTRACTVALUE) and (p.cv == 0) and u.notnil(p.a) {
        if not restr and (p.a.kind == V_PARAM) and (p.a.ty.kind == T_STRUCT) and (p.a.ty.fields.len == 2) and
           (p.a.ty.fields[0].kind == T_PTR) {
            return p.a;
        }
        if (depth < 4) and is_op(p.a, OP_INSERTVALUE) and (p.a.cv == 0) {
            return based_rec(p.a.b, depth + 1, restr);
        }
    }
    if is_restrict_root(p) {
        if restr {
            return p;
        }
        if depth < 4 {
            return based_rec(p.xs.get(0), depth + 1, false);  // (what the pointer read is based on)
        }
        return u.nil.[Value]();
    }
    if (depth >= 4) or (p.kind != V_INST) or ((p.op != OP_PHI) and (p.op != OP_SELECT)) {
        return u.nil.[Value]();
    }
    let mut r = u.nil.[Value]();
    let mut k: usize = 0;
    let mut n_ops: usize = 2;
    if p.op == OP_PHI {
        n_ops = p.xs.len;
    }
    while k < n_ops {
        let mut x = u.nil.[Value]();
        if p.op == OP_PHI {
            x = p.xs.get(k);
        } else if k == 0 {
            x = p.b;
        } else {
            x = p.c;
        }
        // (a step from the phi itself: p + k ...)
        let mut y = resolve(x);
        let mut m: i32 = 0;
        while is_op(y, OP_PTRADD) and (m < 32) {
            y = y.a;
            m += 1;
        }
        if y != p {
            let q = based_rec(x, depth + 1, restr);
            if u.isnil(q) or (u.notnil(r) and (q != r)) {
                return u.nil.[Value]();
            }
            r = q;
        }
        k += 1;
    }
    return r;
}

/// Are accesses through pointers based on a and on b apart: two different
/// objects (objects_apart), or by C's restrict (F_NOALIAS: see above), one
/// based on a noalias parameter and the other on another parameter, a
/// global or a stack slot (resolved roots ra and rb, from based_param or the
/// objects under the ptradds)?
pub fn restrict_apart(ra0: *Value, rb0: *Value) bool {
    if u.isnil(ra0) or u.isnil(rb0) or (ra0 == rb0) {
        return false;
    }
    let mut ra = ra0;
    let mut rb = rb0;
    // (what the restricted pointers read are based on: their own rules
    // need the operations' tags, restrict_tagged)
    if is_restrict_root(ra) {
        ra = based_rec(ra.xs.get(0), 1, false);
    }
    if is_restrict_root(rb) {
        rb = based_rec(rb.xs.get(0), 1, false);
    }
    if u.isnil(ra) or u.isnil(rb) or (ra == rb) {
        return false;
    }
    if objects_apart(ra, rb) {
        return true;
    }
    let na = (ra.kind == V_PARAM) and ((ra.flags & F_NOALIAS) != 0);
    let nb = (rb.kind == V_PARAM) and ((rb.flags & F_NOALIAS) != 0);
    if not na and not nb {
        return false;
    }
    return distinct_root(ra) and distinct_root(rb);
}

// Are IN_RESTRICTs a and b two restrict-qualified members' reads of one
// structure object (the same address s, different offsets k), in scope sc?
fn members_apart(a: *Value, b: *Value) bool {
    if (a.xs.len != 4) or (b.xs.len != 4) {
        return false;
    }
    let sa = a.xs.get(1);
    let sb = b.xs.get(1);
    if (sa != sb) or (sa.ty.kind != T_PTR) or not is_cint(a.xs.get(2)) or not is_cint(b.xs.get(2)) {
        return false;
    }
    return cint_val(a.xs.get(2)) != cint_val(b.xs.get(2));
}

// Is r a restrict-qualified member's read (IN_RESTRICT) from a structure
// object that is the stack slot or global o (whose address is based on no
// pointer), which accesses based on o reach without it? Then an access
// through r that writes an object another access reaches without it is
// undefined (6.7.3.1p4), the structure's own bytes too.
fn in_own_struct(r: *Value, o: *Value) bool {
    if not is_restrict_root(r) or (r.xs.len != 4) or u.isnil(o) or not ((o.kind == V_GLOBAL) or is_op(o, OP_ALLOCA)) {
        return false;
    }
    let s = r.xs.get(1);
    if is_op(s, OP_INTR) and (intr_id(s) == IN_RSCOPE) {
        return false;
    }
    return @int_from_ptr(s) == @int_from_ptr(o);
}

// The restrict rules of members (IN_RESTRICT of 4 operands, the last the
// scope of their block, main's): ra and rb the roots of accesses tagged ta
// and tb, in that scope.
fn member_rules(ra: *mut Value, ta: *Value, rb: *mut Value, tb: *Value) bool {
    let mut m = ra;
    if not is_restrict_root(m) or (m.xs.len != 4) {
        m = rb;
    }
    if not is_restrict_root(m) or (m.xs.len != 4) {
        return false;
    }
    let sc = m.xs.get(3);
    if not is_rscope(sc) or not in_rscope(ta, sc) or not in_rscope(tb, sc) {
        return false;
    }
    if is_restrict_root(ra) and is_restrict_root(rb) and members_apart(ra, rb) {
        return true;
    }
    return in_own_struct(ra, rb) or in_own_struct(rb, ra);
}

/// Is v a block's restrict scope (IN_RSCOPE of type i32; not a structure
/// object's)?
pub fn is_rscope(v: *Value) bool {
    return is_op(v, OP_INTR) and (intr_id(v) == IN_RSCOPE) and (v.ty.kind == T_INT);
}

/// The scope that restrict scope s is in (its operand), or nil.
pub fn rscope_parent(s: *Value) *mut Value {
    if s.xs.len == 1 {
        let p = s.xs.get(0);
        if is_rscope(p) {
            return p;
        }
    }
    return u.nil.[Value]();
}

/// Does operation i take a tag, the restrict scope it is executed in (see
/// IN_RSCOPE): a load, store or call as its operand c, a memcpy, memmove or
/// memset as its only xs?
pub fn has_tag_slot(i: *Value) bool {
    return (i.kind == V_INST) and ((i.op == OP_LOAD) or (i.op == OP_STORE) or (i.op == OP_CALL) or is_memop(i.op));
}

fn is_memop(op: i32) bool {
    return (op == OP_MEMCPY) or (op == OP_MEMMOVE) or (op == OP_MEMSET);
}

/// What operation i (has_tag_slot) holds as its tag (maybe no longer a
/// scope: a forwarded one), or nil.
pub fn tag_slot(i: *mut Value) *mut Value {
    if is_memop(i.op) {
        if i.xs.len == 1 {
            return i.xs.get(0);
        }
        return u.nil.[Value]();
    }
    return i.c;
}

/// Tags operation i (has_tag_slot) with restrict scope t (nil: none).
pub fn set_tag(i: *mut Value, t: *mut Value) void {
    if is_memop(i.op) {
        clear_x(i);
        if u.notnil(t) {
            push_x(i, t);
        }
        return;
    }
    set_c(i, t);
}

/// The restrict scope operation i is tagged with (IN_RSCOPE), or nil.
pub fn tag_of(i: *mut Value) *mut Value {
    if u.isnil(i) or not has_tag_slot(i) {
        return u.nil.[Value]();
    }
    let x = tag_slot(i);
    if u.isnil(x) {
        return x;
    }
    let t = resolve(x);
    if is_rscope(t) {
        return t;
    }
    return u.nil.[Value]();
}

/// The C front end's: the restrict scope that the loads, stores and calls
/// made now are tagged with (nil: none). Only for the function it is in.
pub threadlocal let mut rtag: *mut Value = @ptr_from_int(*mut Value, 0);

// Tags operation v (just made by bd) with rtag.
fn tag_new(bd: *Builder, v: *mut Value) void {
    if u.notnil(rtag) and u.notnil(rtag.blk) and (rtag.blk.fnp == bd.blk.fnp) {
        set_tag(v, rtag);
    }
}

// Is t (a tag, or nil) in scope instance s: s or a scope around it?
fn in_rscope(t0: *Value, s: *Value) bool {
    let mut t = t0;
    let mut n: i32 = 0;
    while u.notnil(t) and (n < 64) {
        if t == s {
            return true;
        }
        t = rscope_parent(t);
        n += 1;
    }
    return false;
}

// May integer x (an address's offset) hold the bits of a pointer converted
// to an integer, within a few operations? (Then the address may be based on
// that pointer, not on the one it is offset from.)
fn holds_ptr(x0: *mut Value, depth: i32) bool {
    let x = resolve(x0);
    if u.isnil(x) or (x.kind != V_INST) {
        return false;
    }
    if x.op == OP_PTRTOINT {
        return true;
    }
    if depth >= 4 {
        return false;
    }
    let op = x.op;
    if (op == OP_ADD) or (op == OP_SUB) or (op == OP_MUL) or (op == OP_SHL) or (op == OP_AND) or (op == OP_OR) or
       (op == OP_XOR) or (op == OP_SDIV) or (op == OP_UDIV) or (op == OP_ASHR) or (op == OP_LSHR) {
        return holds_ptr(x.a, depth + 1) or holds_ptr(x.b, depth + 1);
    }
    if (op == OP_SEXT) or (op == OP_ZEXT) or (op == OP_TRUNC) {
        return holds_ptr(x.a, depth + 1);
    }
    return false;
}

// The root of address p for restrict_tagged: the IN_RESTRICT, parameter,
// global or stack slot it is based on through ptradds (whose offsets hold
// no pointer's bits: holds_ptr), and phis and selects whose operands all
// have that root (or step from the phi itself); else nil.
fn rroot(p0: *mut Value, depth: i32) *mut Value {
    let mut p = resolve(p0);
    let mut n: i32 = 0;
    while is_op(p, OP_PTRADD) and (n < 32) {
        if holds_ptr(p.b, 0) {
            return u.nil.[Value]();
        }
        p = p.a;
        n += 1;
    }
    if u.isnil(p) {
        return p;
    }
    if (p.kind == V_PARAM) or (p.kind == V_GLOBAL) or is_op(p, OP_ALLOCA) or is_restrict_root(p) {
        return p;
    }
    if (depth >= 4) or (p.kind != V_INST) or ((p.op != OP_PHI) and (p.op != OP_SELECT)) {
        return u.nil.[Value]();
    }
    let mut r = u.nil.[Value]();
    let mut n_ops: usize = 2;
    if p.op == OP_PHI {
        n_ops = p.xs.len;
    }
    for k in 0..n_ops {
        let mut x = u.nil.[Value]();
        if p.op == OP_PHI {
            x = p.xs.get(k);
        } else if k == 0 {
            x = p.b;
        } else {
            x = p.c;
        }
        let mut y = resolve(x);
        let mut m: i32 = 0;
        while is_op(y, OP_PTRADD) and (m < 32) {
            y = y.a;
            m += 1;
        }
        if y != p {
            let q = rroot(x, depth + 1);
            if u.isnil(q) or (u.notnil(r) and (q != r)) {
                return u.nil.[Value]();
            }
            r = q;
        }
    }
    return r;
}

// Is root r (rroot's) not based on restricted object k of scope s: a
// parameter, a global, a stack slot, or the read of another restricted
// object whose value is not based on it either?
fn not_based(r0: *mut Value, s: *mut Value, k: u64) bool {
    let mut r = r0;
    let mut n: i32 = 0;
    while u.notnil(r) and (n < 8) {
        if (r.kind == V_PARAM) or (r.kind == V_GLOBAL) or is_op(r, OP_ALLOCA) {
            return true;
        }
        if not is_restrict_root(r) or (r.xs.len != 3) {
            return false;
        }
        if (r.xs.get(1) == s) and is_cint(r.xs.get(2)) and (cint_val(r.xs.get(2)) == k) {
            return false;
        }
        r = rroot(r.xs.get(0), 0);
        n += 1;
    }
    return false;
}

// restrict_tagged's rules with the restricted object's read ra (rroot of the
// one access, tagged ta) first, rb (of the other, tagged tb) second.
fn tagged_apart(ra: *mut Value, ta: *Value, rb: *mut Value, tb: *Value) bool {
    if not is_restrict_root(ra) or (ra.xs.len != 3) or not is_cint(ra.xs.get(2)) {
        return false;
    }
    let s = ra.xs.get(1);
    if not is_rscope(s) or not in_rscope(ta, s) or not in_rscope(tb, s) {
        return false;
    }
    let k = cint_val(ra.xs.get(2));
    if is_restrict_root(rb) and (rb.xs.len == 3) and (rb.xs.get(1) == s) {
        // (two objects of the scope: apart; one: not)
        return is_cint(rb.xs.get(2)) and (cint_val(rb.xs.get(2)) != k);
    }
    if (s.flags & F_RCYCLE) != 0 {
        return false;
    }
    return not_based(rb, s, k);
}

/// Are the accesses at addresses pa and pb, by operations tagged ta and tb
/// (tag_of, or nil), apart by C's restrict on block-scope objects (see
/// IN_RESTRICT: both executed in a scope's instance, one through one of its
/// restricted objects, the other through another or through something not
/// based on it)?
pub fn restrict_tagged(pa: *mut Value, ta: *Value, pb: *mut Value, tb: *Value) bool {
    if u.isnil(pa) or u.isnil(pb) or u.isnil(ta) or u.isnil(tb) {
        return false;
    }
    let ra = rroot(pa, 0);
    let rb = rroot(pb, 0);
    if u.isnil(ra) or u.isnil(rb) or (ra == rb) {
        return false;
    }
    return tagged_apart(ra, ta, rb, tb) or tagged_apart(rb, tb, ra, ta) or member_rules(ra, ta, rb, tb);
}

/// Are a and b two different objects: globals (not aliases of one another)
/// or stack slots? Accesses through addresses based on them are apart.
pub fn objects_apart(a: *Value, b: *Value) bool {
    if u.isnil(a) or u.isnil(b) or (a == b) {
        return false;
    }
    let ao = (a.kind == V_GLOBAL) or is_op(a, OP_ALLOCA);
    let bo = (b.kind == V_GLOBAL) or is_op(b, OP_ALLOCA);
    return ao and bo;
}

fn distinct_root(r: *Value) bool {
    return (r.kind == V_PARAM) or (r.kind == V_GLOBAL) or is_op(r, OP_ALLOCA);
}
