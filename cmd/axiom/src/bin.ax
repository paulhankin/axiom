// =============================================================================
// bin.ax - byte buffers for object files: little-endian integers, LEB128,
// and a reader for parsing them back.
// =============================================================================
import "util.ax" as u;

pub struct Bytes {
    b: u.List.[u8],

    pub fn len(self: *Bytes) usize {
        return self.b.len;
    }

    pub fn view(self: *Bytes) []mut u8 {
        return self.b.items();
    }

    pub fn u8_(self: *mut Bytes, x: u8) void {
        self.b.push(x);
    }

    pub fn u16_(self: *mut Bytes, x: u64) void {
        self.b.push(@truncate(u8, x));
        self.b.push(@truncate(u8, x >> 8));
    }

    pub fn u32_(self: *mut Bytes, x: u64) void {
        for i in @as(u32, 0)..4 {
            self.b.push(@truncate(u8, x >> (i * 8)));
        }
    }

    pub fn u64_(self: *mut Bytes, x: u64) void {
        for i in @as(u32, 0)..8 {
            self.b.push(@truncate(u8, x >> (i * 8)));
        }
    }

    pub fn put(self: *mut Bytes, s: []u8) void {
        for c in s {
            self.b.push(c);
        }
    }

    pub fn zeros(self: *mut Bytes, n: usize) void {
        for i in 0..n {
            self.b.push(0);
        }
    }

    // Pads with zeros to a multiple of `a`.
    pub fn align(self: *mut Bytes, a: usize) void {
        while (self.b.len % a) != 0 {
            self.b.push(0);
        }
    }

    pub fn uleb(self: *mut Bytes, x0: u64) void {
        let mut x = x0;
        loop {
            let byte = @truncate(u8, x & 0x7f);
            x = x >> 7;
            if x == 0 {
                self.b.push(byte);
                return;
            }
            self.b.push(byte | 0x80);
        }
    }

    pub fn sleb(self: *mut Bytes, x0: i64) void {
        let mut x = x0;
        loop {
            let byte = @truncate(u8, @bit_cast(u64, x) & 0x7f);
            x = x >> 7;
            if ((x == 0) and ((byte & 0x40) == 0)) or ((x == -1) and ((byte & 0x40) != 0)) {
                self.b.push(byte);
                return;
            }
            self.b.push(byte | 0x80);
        }
    }

    // Fixed-width LEBs (patchable by relocations): 5 bytes for 32 bits, 10 for 64.
    pub fn uleb5(self: *mut Bytes, x: u64) void {
        self.uleb_n(x, 5);
    }

    pub fn sleb5(self: *mut Bytes, x: i64) void {
        self.uleb_n(@bit_cast(u64, x), 5);
    }

    pub fn sleb10(self: *mut Bytes, x: i64) void {
        self.uleb_n(@bit_cast(u64, x), 10);
    }

    // A LEB padded to n bytes.
    pub fn uleb_n(self: *mut Bytes, x: u64, n: usize) void {
        let off = self.b.len;
        self.zeros(n);
        self.set_uleb_n(off, x, n);
    }

    // A length-prefixed name.
    pub fn name(self: *mut Bytes, s: []u8) void {
        self.uleb(@as(u64, s.len));
        self.put(s);
    }

    pub fn set_u8(self: *mut Bytes, off: usize, x: u8) void {
        self.b.set(off, x);
    }

    pub fn set_u32(self: *mut Bytes, off: usize, x: u64) void {
        w32(self.view(), @as(u64, off), x);
    }

    pub fn set_u64(self: *mut Bytes, off: usize, x: u64) void {
        w64(self.view(), @as(u64, off), x);
    }

    pub fn get_u64(self: *Bytes, off: usize) u64 {
        return rd64(self.view(), off);
    }

    // Overwrites a padded LEB (n bytes) at off.
    pub fn set_uleb_n(self: *mut Bytes, off: usize, x: u64, n: usize) void {
        for i in 0..n {
            let mut byte = @truncate(u8, (x >> @int_cast(u32, i * 7)) & 0x7f);
            if (i + 1) < n {
                byte = byte | 0x80;
            }
            self.b.set(off + i, byte);
        }
    }

    pub fn set_sleb_n(self: *mut Bytes, off: usize, x: i64, n: usize) void {
        self.set_uleb_n(off, @bit_cast(u64, x), n);
    }

    pub fn free(self: *mut Bytes) void {
        self.b.deinit();
        self.b.data = u.nil.[u8]();
        self.b.len = 0;
        self.b.cap = 0;
    }
}

pub fn new_bytes() Bytes {
    return Bytes.{ b: u.List.[u8].empty() };
}

// Little-endian integers in a byte slice. (Writers take u64 offsets, like
// the linkers' file offsets.)
pub fn rd16(d: []u8, off: usize) u64 {
    return @as(u64, d[off]) | (@as(u64, d[off + 1]) << 8);
}

pub fn rd32(d: []u8, off: usize) u64 {
    return rd16(d, off) | (rd16(d, off + 2) << 16);
}

pub fn rd64(d: []u8, off: usize) u64 {
    return rd32(d, off) | (rd32(d, off + 4) << 32);
}

pub fn w16(b: []mut u8, off: u64, x: u64) void {
    let o = @truncate(usize, off);
    b[o] = @truncate(u8, x);
    b[o + 1] = @truncate(u8, x >> 8);
}

pub fn w32(b: []mut u8, off: u64, x: u64) void {
    let o = @truncate(usize, off);
    for k in @as(usize, 0)..4 {
        b[o + k] = @truncate(u8, x >> @as(u64, k * 8));
    }
}

pub fn w64(b: []mut u8, off: u64, x: u64) void {
    w32(b, off, x & 0xFFFF_FFFF);
    w32(b, off + 4, x >> 32);
}

// Reading
pub struct Reader {
    d: []u8,
    pos: usize,
    bad: bool,

    pub fn at_end(self: *Reader) bool {
        return self.pos >= self.d.len;
    }

    pub fn u8_(self: *mut Reader) u8 {
        if self.pos >= self.d.len {
            self.bad = true;
            return 0;
        }
        let x = self.d[self.pos];
        self.pos += 1;
        return x;
    }

    pub fn u32_(self: *mut Reader) u64 {
        let mut x: u64 = 0;
        for i in @as(u32, 0)..4 {
            x = x | (@as(u64, self.u8_()) << (i * 8));
        }
        return x;
    }

    pub fn u64_(self: *mut Reader) u64 {
        let mut x: u64 = 0;
        for i in @as(u32, 0)..8 {
            x = x | (@as(u64, self.u8_()) << (i * 8));
        }
        return x;
    }

    pub fn uleb(self: *mut Reader) u64 {
        let mut x: u64 = 0;
        let mut sh: u32 = 0;
        loop {
            let byte = self.u8_();
            if sh < 64 {
                x = x | (@as(u64, byte & 0x7f) << sh);
            }
            sh += 7;
            if ((byte & 0x80) == 0) or self.bad {
                return x;
            }
        }
    }

    pub fn sleb(self: *mut Reader) i64 {
        let mut x: u64 = 0;
        let mut sh: u32 = 0;
        loop {
            let byte = self.u8_();
            if sh < 64 {
                x = x | (@as(u64, byte & 0x7f) << sh);
            }
            sh += 7;
            if ((byte & 0x80) == 0) or self.bad {
                if (sh < 64) and ((byte & 0x40) != 0) {
                    x = x | (~@as(u64, 0) << sh);
                }
                return @bit_cast(i64, x);
            }
        }
    }

    pub fn bytes(self: *mut Reader, n: usize) []u8 {
        if n > (self.d.len - self.pos) {
            self.bad = true;
            return self.d[0..0];
        }
        let s = self.d[self.pos..self.pos + n];
        self.pos += n;
        return s;
    }

    pub fn name(self: *mut Reader) []u8 {
        let n = @truncate(usize, self.uleb());
        return u.dup(self.bytes(n));
    }
}

pub fn reader(d: []u8) Reader {
    return Reader.{ d: d, pos: 0, bad: false };
}
