// =============================================================================
// elf.ax - ELF64 relocatable objects: the in-memory form produced by the
// native code generators, its encoding as a .o file (for our linker, and for
// the system linker when C code is linked in), and decoding of relocatable
// objects: those we write, and those of the platform's toolchain for the
// same target (read keeps what a link needs of them: the allocated
// sections, the initialization and termination arrays, the unwind tables,
// COMDAT groups, common and absolute symbols; the ELF specification's
// generic ABI and the x86-64 and AArch64 processor supplements).
// =============================================================================
import "bin.ax" as bn;
import "util.ax" as u;

pub const EM_X86_64: u32 = 62;
pub const EM_AARCH64: u32 = 183;

// Section kinds
pub const S_TEXT: i32 = 0;
pub const S_RODATA: i32 = 1;
pub const S_DATA: i32 = 2;
pub const S_BSS: i32 = 3;
pub const S_TDATA: i32 = 4;
pub const S_TBSS: i32 = 5;
pub const S_DEBUG: i32 = 6;    // not loaded: information for the linker (.axiom.lines) or debuggers (.debug_*)
pub const S_DISCARD: i32 = 7;  // (a link drops it: a COMDAT group's copy that another object's group gives)

// Sym.sec of an absolute symbol (SHN_ABS: its value is its address); -1 is
// an undefined one.
pub const SEC_ABS: i32 = -2;

// Symbol binding / type
pub const B_LOCAL: u8 = 0;
pub const B_GLOBAL: u8 = 1;
pub const B_WEAK: u8 = 2;
pub const T_NOTYPE: u8 = 0;
pub const T_OBJECT: u8 = 1;
pub const T_FUNC: u8 = 2;
pub const T_TLS: u8 = 6;
pub const T_IFUNC: u8 = 10;  // STT_GNU_IFUNC (not supported by the linkers: they say so)

// x86-64 relocations
pub const R_X86_64_NONE: u32 = 0;
pub const R_X86_64_64: u32 = 1;
pub const R_X86_64_PC32: u32 = 2;
pub const R_X86_64_PLT32: u32 = 4;
pub const R_X86_64_COPY: u32 = 5;
pub const R_X86_64_GLOB_DAT: u32 = 6;
pub const R_X86_64_RELATIVE: u32 = 8;
pub const R_X86_64_GOTPCREL: u32 = 9;
pub const R_X86_64_32: u32 = 10;
pub const R_X86_64_32S: u32 = 11;
pub const R_X86_64_16: u32 = 12;
pub const R_X86_64_PC16: u32 = 13;
pub const R_X86_64_8: u32 = 14;
pub const R_X86_64_PC8: u32 = 15;
pub const R_X86_64_DTPMOD64: u32 = 16;
pub const R_X86_64_DTPOFF64: u32 = 17;  // (debug information: an offset in the module's TLS block)
pub const R_X86_64_TPOFF64: u32 = 18;
pub const R_X86_64_TLSGD: u32 = 19;
pub const R_X86_64_TLSLD: u32 = 20;
pub const R_X86_64_DTPOFF32: u32 = 21;
pub const R_X86_64_GOTTPOFF: u32 = 22;
pub const R_X86_64_TPOFF32: u32 = 23;
pub const R_X86_64_PC64: u32 = 24;
pub const R_X86_64_GOTOFF64: u32 = 25;
pub const R_X86_64_GOTPC32: u32 = 26;
pub const R_X86_64_GOTPC64: u32 = 29;
pub const R_X86_64_SIZE32: u32 = 32;
pub const R_X86_64_SIZE64: u32 = 33;
pub const R_X86_64_GOTPC32_TLSDESC: u32 = 34;
pub const R_X86_64_TLSDESC_CALL: u32 = 35;
pub const R_X86_64_IRELATIVE: u32 = 37;
pub const R_X86_64_GOTPCRELX: u32 = 41;
pub const R_X86_64_REX_GOTPCRELX: u32 = 42;
// Not an ELF type: our own, for objects only plink.ax links. A 32-bit address
// relative to the image's base (a PE RVA: .pdata's function table).
pub const R_X86_64_RVA32: u32 = 251;

// AArch64 relocations
pub const R_AARCH64_NONE: u32 = 0;
pub const R_AARCH64_ABS64: u32 = 257;
pub const R_AARCH64_ABS32: u32 = 258;
pub const R_AARCH64_ABS16: u32 = 259;
pub const R_AARCH64_PREL64: u32 = 260;
pub const R_AARCH64_PREL32: u32 = 261;
pub const R_AARCH64_PREL16: u32 = 262;
pub const R_AARCH64_MOVW_UABS_G0: u32 = 263;
pub const R_AARCH64_MOVW_UABS_G3: u32 = 270;  // (G0, G0_NC, G1, G1_NC, G2, G2_NC, G3: 263..270)
pub const R_AARCH64_LD_PREL_LO19: u32 = 273;
pub const R_AARCH64_ADR_PREL_LO21: u32 = 274;
pub const R_AARCH64_ADR_PREL_PG_HI21: u32 = 275;
pub const R_AARCH64_ADR_PREL_PG_HI21_NC: u32 = 276;
pub const R_AARCH64_TSTBR14: u32 = 279;
pub const R_AARCH64_CONDBR19: u32 = 280;
pub const R_AARCH64_ADD_ABS_LO12_NC: u32 = 277;
pub const R_AARCH64_LDST8_ABS_LO12_NC: u32 = 278;
pub const R_AARCH64_JUMP26: u32 = 282;
pub const R_AARCH64_CALL26: u32 = 283;
pub const R_AARCH64_LDST16_ABS_LO12_NC: u32 = 284;
pub const R_AARCH64_LDST32_ABS_LO12_NC: u32 = 285;
pub const R_AARCH64_LDST64_ABS_LO12_NC: u32 = 286;
pub const R_AARCH64_LDST128_ABS_LO12_NC: u32 = 299;
pub const R_AARCH64_GOTPCREL32: u32 = 309;
pub const R_AARCH64_ADR_GOT_PAGE: u32 = 311;
pub const R_AARCH64_LD64_GOT_LO12_NC: u32 = 312;
pub const R_AARCH64_TLSGD_ADR_PAGE21: u32 = 513;
pub const R_AARCH64_TLSGD_ADD_LO12_NC: u32 = 514;
pub const R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21: u32 = 541;
pub const R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC: u32 = 542;
pub const R_AARCH64_TLSLE_MOVW_TPREL_G2: u32 = 544;
pub const R_AARCH64_TLSLE_MOVW_TPREL_G1: u32 = 545;
pub const R_AARCH64_TLSLE_MOVW_TPREL_G1_NC: u32 = 546;
pub const R_AARCH64_TLSLE_MOVW_TPREL_G0: u32 = 547;
pub const R_AARCH64_TLSLE_MOVW_TPREL_G0_NC: u32 = 548;
pub const R_AARCH64_TLSLE_ADD_TPREL_HI12: u32 = 549;
pub const R_AARCH64_TLSLE_ADD_TPREL_LO12: u32 = 550;
pub const R_AARCH64_TLSLE_ADD_TPREL_LO12_NC: u32 = 551;
pub const R_AARCH64_TLSLE_LDST8_TPREL_LO12: u32 = 552;  // (LDST8..LDST64, each with _NC: 552..559)
pub const R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC: u32 = 559;
pub const R_AARCH64_TLSDESC_ADR_PAGE21: u32 = 562;
pub const R_AARCH64_TLSDESC_LD64_LO12: u32 = 563;
pub const R_AARCH64_TLSDESC_ADD_LO12: u32 = 564;
pub const R_AARCH64_TLSDESC_CALL: u32 = 569;
pub const R_AARCH64_TLSLE_LDST128_TPREL_LO12: u32 = 570;
pub const R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC: u32 = 571;
pub const R_AARCH64_COPY: u32 = 1024;
pub const R_AARCH64_TLS_DTPREL64: u32 = 1028;  // (debug information: an offset in the module's TLS block)
pub const R_AARCH64_TLS_TPREL64: u32 = 1030;
// (more of the ELF for the Arm 64-bit Architecture ABI's static relocations, which
// the assembler makes: the move-wide groups, literals, GOT and TLS)
pub const R_AARCH64_MOVW_SABS_G0: u32 = 270;  // .. 272: G0, G1, G2
pub const R_AARCH64_MOVW_SABS_G2: u32 = 272;
pub const R_AARCH64_MOVW_PREL_G0: u32 = 287;  // .. 293: G0, G0_NC, G1, G1_NC, G2, G2_NC, G3
pub const R_AARCH64_MOVW_PREL_G3: u32 = 293;
pub const R_AARCH64_GOT_LD_PREL19: u32 = 309;
pub const R_AARCH64_TLSLD_MOVW_DTPREL_G2: u32 = 523;  // .. 527: G2, G1, G1_NC, G0, G0_NC
pub const R_AARCH64_TLSLD_MOVW_DTPREL_G0_NC: u32 = 527;
pub const R_AARCH64_TLSLD_ADD_DTPREL_HI12: u32 = 528;
pub const R_AARCH64_TLSLD_ADD_DTPREL_LO12: u32 = 529;
pub const R_AARCH64_TLSLD_ADD_DTPREL_LO12_NC: u32 = 530;
pub const R_AARCH64_TLSLD_LDST8_DTPREL_LO12: u32 = 531;  // .. 538: 8, 16, 32, 64, each then _NC
pub const R_AARCH64_TLSLD_LDST64_DTPREL_LO12_NC: u32 = 538;
pub const R_AARCH64_TLSIE_MOVW_GOTTPREL_G1: u32 = 539;
pub const R_AARCH64_TLSIE_MOVW_GOTTPREL_G0_NC: u32 = 540;
pub const R_AARCH64_TLSIE_LD_GOTTPREL_PREL19: u32 = 543;
pub const R_AARCH64_TLSDESC_LD_PREL19: u32 = 560;
pub const R_AARCH64_TLSDESC_ADR_PREL21: u32 = 561;
pub const R_AARCH64_TLSDESC_OFF_G1: u32 = 565;
pub const R_AARCH64_TLSDESC_OFF_G0_NC: u32 = 566;
pub const R_AARCH64_TLSDESC_LDR: u32 = 567;
pub const R_AARCH64_TLSDESC_ADD: u32 = 568;
pub const R_AARCH64_TLSLD_LDST128_DTPREL_LO12: u32 = 572;
pub const R_AARCH64_TLSLD_LDST128_DTPREL_LO12_NC: u32 = 573;
pub const R_AARCH64_GLOB_DAT: u32 = 1025;
pub const R_AARCH64_RELATIVE: u32 = 1027;
// Not an ELF type: our own, for objects only plink.ax links. A 32-bit address
// relative to the image's base (a PE RVA: .pdata's function table).
pub const R_AARCH64_RVA32: u32 = 1251;

pub struct Rel {
    off: u64,
    ty: u32,
    sym: u32,
    addend: i64,
}

pub struct Sec {
    name: []u8,
    kind: i32,
    data: bn.Bytes,
    size: u64,  // BSS / TBSS size (no data)
    align: u64,
    relocs: u.List.[Rel],
    index: u32,  // section header index when written
    sym1: u32,   // a local symbol at its start (sec_sym) + 1, 0: none yet
    // a COMDAT group it belongs to when written (its signature: the name of
    // a symbol of the object), or empty; read objects' groups are Obj.groups
    group: []u8,
    // the section it describes + 1 (0: none): written as SHF_LINK_ORDER with
    // sh_link (a frame table's for its code: ftab.ax), read likewise; a
    // link's garbage collection keeps it only with that section (nlink.ax)
    link1: i32,
    retain: bool,  // never collected by a link (SHF_GNU_RETAIN: C's attribute used, retain)
}

pub struct Sym {
    name: []u8,
    sec: i32,  // section index in Obj.secs, -1: undefined
    value: u64,
    size: u64,
    bind: u8,
    ty: u8,
    hidden: bool,
}

// A COMDAT group of a read object (SHT_GROUP with GRP_COMDAT): its
// signature and its sections. A link keeps the first object's group of a
// signature and drops the others' (the generic ABI's rule).
pub struct Group {
    sig: []u8,
    secs: u.List.[i32],
    // which copy a link keeps (the PE/COFF specification's COMDAT
    // selections: SEL_*; ELF's groups are SEL_ANY)
    sel: u8,
}

pub const SEL_NODUPLICATES: u8 = 1;  // another copy is an error
pub const SEL_ANY: u8 = 2;           // the first object's
pub const SEL_SAME_SIZE: u8 = 3;     // the first, the others of the same size
pub const SEL_EXACT_MATCH: u8 = 4;   // the first, the others the same
pub const SEL_LARGEST: u8 = 6;       // the largest (the first of those)

pub struct Obj {
    machine: u32,
    secs: u.List.[*mut Sec],
    syms: u.List.[Sym],
    symmap: u.SymMap.[u32],  // non-local name -> symbol index + 1
    groups: u.List.[Group],  // (read objects only)
    name: []u8,              // where it came from, for messages ("" for our own)
}

pub fn new_obj(machine: u32) *mut Obj {
    let o = u.new.[Obj]();
    o.machine = machine;
    return o;
}

// Gives back the memory of the sections and symbols of an object that has
// been written out and is not used again.
pub fn release(o: *mut Obj) void {
    for k in 0..o.secs.len {
        let s = o.secs.get(k);
        s.data.free();
        s.data = bn.new_bytes();
        s.relocs.deinit();
        s.relocs = u.List.[Rel].empty();
    }
    o.syms.deinit();
    o.syms = u.List.[Sym].empty();
}

pub fn add_sec(o: *mut Obj, name: []u8, kind: i32, align: u64) i32 {
    // (not in a scratch scope's memory: a code generator may add one while
    // it compiles a function, x64.ax and a64.ax doing that in such a scope)
    let s = u.perm_new.[Sec]();
    s.name = name;
    s.kind = kind;
    s.align = align;
    o.secs.push(s);
    return @int_cast(i32, o.secs.len - 1);
}

/// A local symbol at the start of section `sec` of `o` (made once), for
/// relocations against the section.
pub fn sec_sym(o: *mut Obj, sec: i32) u32 {
    let s = o.secs.get(@int_cast(usize, sec));
    if s.sym1 == 0 {
        s.sym1 = add_sym(o, Sym.{ name: "", sec: sec, value: 0, size: 0, bind: B_LOCAL, ty: T_NOTYPE,
                                  hidden: false }) + 1;
    }
    return s.sym1 - 1;
}

/// The section of `o` named `name` (the first, if several are), or -1.
pub fn find_sec(o: *Obj, name: []u8) i32 {
    for k in 0..o.secs.len {
        if u.str_eq(o.secs.get(k).name, name) {
            return @int_cast(i32, k);
        }
    }
    return -1;
}

pub fn sec_size(s: *Sec) u64 {
    if (s.kind == S_BSS) or (s.kind == S_TBSS) {
        return s.size;
    }
    return @as(u64, s.data.len());
}

pub fn add_sym(o: *mut Obj, s: Sym) u32 {
    if (s.bind != B_LOCAL) and (s.name.len > 0) {
        let k = u.intern(s.name);
        let prev = o.symmap.get(k);
        if prev != 0 {
            // a declaration seen earlier: now defined
            let p = o.syms.at(@as(usize, prev - 1));
            if (p.sec < 0) and (s.sec >= 0) {
                p.* = s;
            }
            return prev - 1;
        }
        o.syms.push(s);
        o.symmap.put(k, @int_cast(u32, o.syms.len));
        return @int_cast(u32, o.syms.len - 1);
    }
    o.syms.push(s);
    return @int_cast(u32, o.syms.len - 1);
}

// Native frame tables (ftab.ax): the sections named axiom_rets are placed
// together, in the order of the objects (that of their code), between
// __start_axiom_rets and __stop_axiom_rets, as the system's linker does. The
// linkers add rets_bounds' object, whose empty sections hold those symbols:
// rets_rank orders a class's sections (0: the start, 1: the tables, 2: the
// end; -1 for any other section).
pub fn rets_rank(s: *Sec) i32 {
    if u.str_eq(s.name, "axiom_rets") {
        return 1;
    }
    if u.str_eq(s.name, "axiom_rets.start") {
        return 0;
    }
    if u.str_eq(s.name, "axiom_rets.stop") {
        return 2;
    }
    return -1;
}

pub fn rets_bounds(machine: u32) *mut Obj {
    let o = new_obj(machine);
    let a = add_sec(o, "axiom_rets.start", S_RODATA, 4);
    let b = add_sec(o, "axiom_rets.stop", S_RODATA, 4);
    _ = add_sym(o, Sym.{ name: "__start_axiom_rets", sec: a, value: 0, size: 0, bind: B_GLOBAL, ty: T_NOTYPE,
                         hidden: true });
    _ = add_sym(o, Sym.{ name: "__stop_axiom_rets", sec: b, value: 0, size: 0, bind: B_GLOBAL, ty: T_NOTYPE,
                         hidden: true });
    return o;
}

// Adds src's sections and symbols to dst, so that one object holds both:
// what dst only refers to, src's definitions define.
pub fn merge(dst: *mut Obj, src: *mut Obj) void {
    let base = @int_cast(i32, dst.secs.len);
    let mut map = u.List.[u32].empty();
    for i in 0..src.syms.len {
        let mut s = src.syms.get(i);
        if s.sec >= 0 {
            s.sec += base;
        }
        map.push(add_sym(dst, s));
    }
    for i in 0..src.secs.len {
        let s = src.secs.get(i);
        for j in 0..s.relocs.len {
            let r = s.relocs.at(j);
            r.sym = map.get(@as(usize, r.sym));
        }
        if s.sym1 != 0 {
            s.sym1 = map.get(@as(usize, s.sym1 - 1)) + 1;
        }
        if s.link1 != 0 {
            s.link1 += base;
        }
        dst.secs.push(s);
    }
    map.deinit();
}

// An undefined (external) symbol, or the existing one of that name.
// A symbol's name for people (symbol tables, debug information): without
// the ".#f<index>" or ".#g<index>" that makes an internal function's or
// datum's name unique in a module compiled in parts (isel.ax: sym_name).
pub fn display_name(name: []u8) []u8 {
    let mut k = name.len;
    while (k > 0) and u.is_digit(name[k - 1]) {
        k -= 1;
    }
    if (k < name.len) and (k >= 3) and ((name[k - 1] == 'f') or (name[k - 1] == 'g')) and (name[k - 2] == '#') and
       (name[k - 3] == '.') {
        return name[0..k - 3];
    }
    return name;
}

// Is it a name display_name shortens (a symbol that is internal to its module)?
pub fn is_part_name(name: []u8) bool {
    return display_name(name).len != name.len;
}

pub fn ext_sym(o: *mut Obj, name: []u8, weak: bool) u32 {
    let k = u.intern(name);
    let prev = o.symmap.get(k);
    if prev != 0 {
        return prev - 1;
    }
    let mut b = B_GLOBAL;
    if weak {
        b = B_WEAK;
    }
    return add_sym(o, Sym.{ name: name, sec: -1, value: 0, size: 0, bind: b, ty: T_NOTYPE, hidden: false });
}

fn sec_flags(k: i32) u64 {
    // SHF_WRITE 1, SHF_ALLOC 2, SHF_EXECINSTR 4, SHF_TLS 0x400
    if k == S_TEXT {
        return 6;
    }
    if k == S_RODATA {
        return 2;
    }
    if (k == S_DATA) or (k == S_BSS) {
        return 3;
    }
    if k == S_DEBUG {
        return 0;
    }
    return 0x403;
}

fn sec_type(k: i32) u32 {
    // SHT_PROGBITS 1, SHT_NOBITS 8
    if (k == S_BSS) or (k == S_TBSS) {
        return 8;
    }
    return 1;
}

struct Shdr {
    name: u32,
    ty: u32,
    flags: u64,
    off: u64,
    size: u64,
    link: u32,
    info: u32,
    align: u64,
    entsize: u64,
}

fn has_name(names: [][]u8, n: []u8) bool {
    for x in names {
        if u.str_eq(x, n) {
            return true;
        }
    }
    return false;
}

// An object file being written: its bytes, section headers and their names.
struct Writer {
    out: bn.Bytes,
    shstr: bn.Bytes,
    shdrs: u.List.[Shdr],
}

// Adds a section name (prefix, then name) to .shstrtab; returns its offset.
fn sec_name(w: *mut Writer, prefix: []u8, name: []u8) u32 {
    let nm = @int_cast(u32, w.shstr.len());
    w.shstr.put(prefix);
    w.shstr.put(name);
    w.shstr.u8_(0);
    return nm;
}

pub fn write(o: *mut Obj) []u8 {
    let mut w = Writer.{ out: bn.new_bytes(), shstr: bn.new_bytes(), shdrs: u.List.[Shdr].empty() };
    w.out.zeros(64);
    w.shstr.u8_(0);
    w.shdrs.push(Shdr.{ name: 0, ty: 0, flags: 0, off: 0, size: 0, link: 0, info: 0, align: 0, entsize: 0 });
    // COMDAT groups (Sec.group): each a SHT_GROUP section, before its members
    // (the generic ABI wants a group's header before its members' headers),
    // so the content sections are numbered from 1 + the number of groups;
    // each group's signature is a symbol of the object (one is made if none
    // is there)
    let mut gsigs = u.List.[[]u8].empty();
    for i in 0..o.secs.len {
        let g = o.secs.get(i).group;
        if (g.len > 0) and not has_name(gsigs.items(), g) {
            gsigs.push(g);
            if o.symmap.get(u.intern(g)) == 0 {
                let first = @int_cast(i32, i);
                _ = add_sym(o, Sym.{ name: g, sec: first, value: 0, size: 0, bind: B_GLOBAL, ty: T_NOTYPE,
                                     hidden: true });
            }
        }
    }
    let nm_group = sec_name(&mut w, "", ".group");
    for _g in gsigs.items() {
        w.shdrs.push(Shdr.{ name: nm_group, ty: 17, flags: 0, off: 0, size: 0, link: 0, info: 0, align: 4,
                            entsize: 4 });
    }
    let first_content = @int_cast(u32, w.shdrs.len);
    // content sections
    for i in 0..o.secs.len {
        let s = o.secs.get(i);
        let nm = sec_name(&mut w, "", s.name);
        let a = s.align;
        let mut al = a;
        if al == 0 {
            al = 1;
        }
        w.out.align(@truncate(usize, al));
        let off = @as(u64, w.out.len());
        if sec_type(s.kind) == 1 {
            w.out.put(s.data.view());
        }
        s.index = @int_cast(u32, w.shdrs.len);
        let mut sty = sec_type(s.kind);
        if (s.kind == S_DATA) and (u.str_eq(s.name, ".init_array") or u.starts(s.name, ".init_array.")) {
            sty = 14;  // SHT_INIT_ARRAY
        } else if (s.kind == S_DATA) and (u.str_eq(s.name, ".fini_array") or u.starts(s.name, ".fini_array.")) {
            sty = 15;  // SHT_FINI_ARRAY
        }
        let mut fl = sec_flags(s.kind);
        let mut link: u32 = 0;
        if s.group.len > 0 {
            fl = fl | 0x200;  // SHF_GROUP
        }
        if s.link1 > 0 {
            fl = fl | 0x80;  // SHF_LINK_ORDER: sh_link names the section it goes with
            link = first_content + @bit_cast(u32, s.link1 - 1);
        }
        if s.retain {
            fl = fl | 0x20_0000;  // SHF_GNU_RETAIN
        }
        w.shdrs.push(Shdr.{ name: nm, ty: sty, flags: fl, off: off, size: sec_size(s), link: link, info: 0, align: al,
                            entsize: 0 });
    }
    let mut strtab = bn.new_bytes();
    let mut symtab = bn.new_bytes();
    let map = u.newn.[u32](o.syms.len + 1);  // our index -> ELF index
    symbol_table(o, &mut symtab, &mut strtab, map);
    let mut first_global: u32 = 1;
    for i in 0..o.syms.len {
        if o.syms.at(i).bind == B_LOCAL {
            first_global += 1;
        }
    }
    // relocation sections
    let mut nrel: u32 = 0;
    for i in 0..o.secs.len {
        if o.secs.get(i).relocs.len > 0 {
            nrel += 1;
        }
    }
    let symtab_index = @int_cast(u32, w.shdrs.len) + nrel;
    let relidx = u.newn.[u32](o.secs.len + 1);  // each section's relocation section's header (0: none)
    for i in 0..o.secs.len {
        let s = o.secs.get(i);
        if s.relocs.len > 0 {
            relidx[i] = @int_cast(u32, w.shdrs.len);
            rela_section(&mut w, s, map, symtab_index);
        }
    }
    // the groups' contents: GRP_COMDAT, then the members (and their
    // relocation sections, which are members too)
    for gi in 0..gsigs.len {
        w.out.align(4);
        let goff = @as(u64, w.out.len());
        w.out.u32_(1);
        for i in 0..o.secs.len {
            let s = o.secs.get(i);
            if u.str_eq(s.group, gsigs.get(gi)) {
                w.out.u32_(@as(u64, s.index));
                if relidx[i] != 0 {
                    w.out.u32_(@as(u64, relidx[i]));
                }
            }
        }
        let h = w.shdrs.at(gi + 1);
        h.off = goff;
        h.size = @as(u64, w.out.len()) - goff;
        h.link = symtab_index;
        h.info = map[@as(usize, o.symmap.get(u.intern(gsigs.get(gi))) - 1)];
    }
    // .symtab, .strtab, .note.GNU-stack, .shstrtab
    let n_symtab = sec_name(&mut w, "", ".symtab");
    w.out.align(8);
    let so = @as(u64, w.out.len());
    w.out.put(symtab.view());
    w.shdrs.push(Shdr.{ name: n_symtab, ty: 2, flags: 0, off: so, size: @as(u64, symtab.len()), link: symtab_index + 1,
                        info: first_global, align: 8, entsize: 24 });
    let n_strtab = sec_name(&mut w, "", ".strtab");
    let sto = @as(u64, w.out.len());
    w.out.put(strtab.view());
    w.shdrs.push(Shdr.{ name: n_strtab, ty: 3, flags: 0, off: sto, size: @as(u64, strtab.len()), link: 0, info: 0,
                        align: 1, entsize: 0 });
    let n_note = sec_name(&mut w, "", ".note.GNU-stack");
    w.shdrs.push(Shdr.{ name: n_note, ty: 1, flags: 0, off: @as(u64, w.out.len()), size: 0, link: 0, info: 0, align: 1,
                        entsize: 0 });
    let n_shstr = sec_name(&mut w, "", ".shstrtab");
    let sho = @as(u64, w.out.len());
    w.out.put(w.shstr.view());
    w.shdrs.push(Shdr.{ name: n_shstr, ty: 3, flags: 0, off: sho, size: @as(u64, w.shstr.len()), link: 0, info: 0,
                        align: 1, entsize: 0 });
    finish(&mut w, o.machine);
    let r = u.heap_dup(w.out.view());
    w.out.free();
    w.shstr.free();
    strtab.free();
    symtab.free();
    w.shdrs.deinit();
    return r;
}

// The symbol table (null, then the locals, then the globals) and its
// strings; map: each symbol's index in it.
fn symbol_table(o: *Obj, symtab: *mut bn.Bytes, strtab: *mut bn.Bytes, map: []mut u32) void {
    strtab.u8_(0);
    symtab.zeros(24);
    let nsym = o.syms.len;
    let mut k: u32 = 1;
    for pass in @as(i32, 0)..2 {
        for i in 0..nsym {
            let s = o.syms.at(i);
            let local = s.bind == B_LOCAL;
            if (pass == 0) != local {
                continue;
            }
            let nm = @int_cast(u32, strtab.len());
            strtab.put(s.name);
            strtab.u8_(0);
            symtab.u32_(@as(u64, nm));
            let mut st_type = s.ty;
            if (s.sec >= 0) and (st_type == T_NOTYPE) {
                st_type = T_OBJECT;
            }
            symtab.u8_((s.bind << 4) | st_type);
            if s.hidden {
                symtab.u8_(2);
            } else {
                symtab.u8_(0);
            }
            if s.sec >= 0 {
                symtab.u16_(@as(u64, o.secs.get(@int_cast(usize, s.sec)).index));
            } else {
                symtab.u16_(0);
            }
            symtab.u64_(s.value);
            symtab.u64_(s.size);
            map[i] = k;
            k += 1;
        }
    }
}

// A section's relocations (.rela<name>); map: symbols' indexes in the
// symbol table, section symtab_index.
fn rela_section(w: *mut Writer, s: *Sec, map: []u32, symtab_index: u32) void {
    let nm = sec_name(w, ".rela", s.name);
    w.out.align(8);
    let off = @as(u64, w.out.len());
    for j in 0..s.relocs.len {
        let r = s.relocs.get(j);
        w.out.u64_(r.off);
        w.out.u64_((@as(u64, map[@as(usize, r.sym)]) << 32) | @as(u64, r.ty));
        w.out.u64_(@bit_cast(u64, r.addend));
    }
    let mut fl: u64 = 0x40;  // SHF_INFO_LINK
    if s.group.len > 0 {
        fl = fl | 0x200;  // SHF_GROUP: in its section's group
    }
    w.shdrs.push(Shdr.{ name: nm, ty: 4, flags: fl, off: off, size: @as(u64, s.relocs.len) * 24, link: symtab_index,
                        info: s.index, align: 8, entsize: 24 });
}

// The section headers, and the ELF header (in the 64 bytes left for it).
fn finish(w: *mut Writer, machine: u32) void {
    let out = &mut w.out;
    out.align(8);
    let shoff = @as(u64, out.len());
    for i in 0..w.shdrs.len {
        let h = w.shdrs.get(i);
        out.u32_(@as(u64, h.name));
        out.u32_(@as(u64, h.ty));
        out.u64_(h.flags);
        out.u64_(0);
        out.u64_(h.off);
        out.u64_(h.size);
        out.u32_(@as(u64, h.link));
        out.u32_(@as(u64, h.info));
        out.u64_(h.align);
        out.u64_(h.entsize);
    }
    bn.put_at(out.view(), 0, "\x7fELF\x02\x01\x01");
    let n = @as(u64, w.shdrs.len);
    out.set_u32(16, 1 | (@as(u64, machine) << 16));  // e_type REL, e_machine
    out.set_u32(20, 1);  // e_version
    out.set_u64(40, shoff);
    out.set_u32(52, 64);  // e_ehsize = 64, e_phentsize = 0
    out.set_u32(56, 0 | (@as(u64, 64) << 16));  // e_phnum = 0, e_shentsize = 64
    out.set_u32(60, n | ((n - 1) << 16));       // e_shnum, e_shstrndx
}

// -----------------------------------------------------------------------------
// Reading
// -----------------------------------------------------------------------------
pub fn cstr_at(d: []u8, off: usize) []u8 {
    let mut e = off;
    while (e < d.len) and (d[e] != 0) {
        e += 1;
    }
    return d[off..e];
}

// The section header table: where it is and how many entries (e_shnum, or
// for an object of 0xff00 sections or more the first header's sh_size), and
// the index of the section names (e_shstrndx, or the first header's
// sh_link), as the generic ABI says for SHN_LORESERVE and beyond.
struct Shtab {
    off: usize,
    num: usize,
    strndx: usize,
}

fn shtab(d: []u8) Shtab {
    let off = @truncate(usize, bn.rd64(d, 40));
    let mut num = @truncate(usize, bn.rd16(d, 60));
    let mut strndx = @truncate(usize, bn.rd16(d, 62));
    if (off != 0) and (off + 64 <= d.len) {
        if num == 0 {
            num = @truncate(usize, bn.rd64(d, off + 32));
        }
        if strndx == 0xffff {
            strndx = @truncate(usize, bn.rd32(d, off + 40));
        }
    }
    return Shtab.{ off: off, num: num, strndx: strndx };
}

/// Is d an ELF64 relocatable object (ET_REL)? (read takes it.)
pub fn is_object(d: []u8) bool {
    return (d.len >= 64) and u.str_eq(d[0..4], "\x7fELF") and (d[4] == 2) and (bn.rd16(d, 16) == 1);
}

/// Decodes the relocatable object d, or gives nil if it is not an ELF64
/// one or is malformed. The allocated sections are kept (PROGBITS, NOBITS,
/// the initialization and termination arrays, x86-64's unwind tables),
/// and of the others the debug information; notes, groups, relocation and
/// symbol tables are read into the object, not kept as sections. A common
/// symbol (SHN_COMMON) becomes a weak definition in a .bss section of its
/// own (so a definition elsewhere wins, as the generic ABI has it).
pub fn read(d: []u8) *mut Obj {
    if (d.len < 64) or not u.str_eq(d[0..4], "\x7fELF") or (d[4] != 2) or (d[5] != 1) {
        return u.nil.[Obj]();
    }
    let o = new_obj(@truncate(u32, bn.rd16(d, 18)));
    let st = shtab(d);
    let shoff = st.off;
    let shnum = st.num;
    if (shoff == 0) or ((shoff + (shnum * 64)) > d.len) or (st.strndx >= shnum) {
        return u.nil.[Obj]();
    }
    let stroff = @truncate(usize, bn.rd64(d, sh(shoff, st.strndx) + 24));
    // content sections -> our sections
    let secmap = u.newn.[i32](shnum + 1);
    let mut symtab_sh: usize = 0;
    let mut xindex_off: usize = 0;  // SHT_SYMTAB_SHNDX: the symbols' section indexes past 0xff00
    for i in 0..shnum {
        secmap[i] = -1;
        let h = sh(shoff, i);
        let ty = bn.rd32(d, h + 4);
        let flags = bn.rd64(d, h + 8);
        let name = cstr_at(d, stroff + @truncate(usize, bn.rd32(d, h)));
        if ty == 2 {
            symtab_sh = i;
        } else if ty == 18 {
            xindex_off = @truncate(usize, bn.rd64(d, h + 24));
        }
        let debug = (ty == 1) and ((flags & 2) == 0) and
                    ((u.str_eq(name, ".axiom.lines") or u.str_eq(name, ".axiom.cv")) or u.starts(name, ".debug_"));
        // PROGBITS, NOBITS, INIT_ARRAY, FINI_ARRAY, PREINIT_ARRAY, X86_64_UNWIND
        let content = (ty == 1) or (ty == 8) or (ty == 14) or (ty == 15) or (ty == 16) or (ty == 0x7000_0001);
        if (not content or ((flags & 2) == 0)) and not debug {
            continue;
        }
        let mut kind = classify(ty, flags);
        if debug {
            kind = S_DEBUG;
        }
        let mut al = bn.rd64(d, h + 48);
        if al == 0 {
            al = 1;
        }
        let si = add_sec(o, u.dup(name), kind, al);
        let s = o.secs.get(@int_cast(usize, si));
        let off = @truncate(usize, bn.rd64(d, h + 24));
        let size = bn.rd64(d, h + 32);
        if ty == 8 {
            s.size = size;
        } else if (off + @truncate(usize, size)) <= d.len {
            s.data.put(d[off..off + @truncate(usize, size)]);
        } else {
            return u.nil.[Obj]();
        }
        secmap[i] = si;
        s.retain = (flags & 0x20_0000) != 0;  // SHF_GNU_RETAIN
    }
    // SHF_LINK_ORDER: the section each goes with (sh_link)
    for i in 0..shnum {
        let h = sh(shoff, i);
        let ln = @truncate(usize, bn.rd32(d, h + 40));
        if (secmap[i] >= 0) and ((bn.rd64(d, h + 8) & 0x80) != 0) and (ln < shnum) and (secmap[ln] >= 0) {
            o.secs.get(@int_cast(usize, secmap[i])).link1 = secmap[ln] + 1;
        }
    }
    // symbols
    let mut elf2us = u.List.[u32].empty();
    if symtab_sh != 0 {
        let h = sh(shoff, symtab_sh);
        let off = @truncate(usize, bn.rd64(d, h + 24));
        let size = @truncate(usize, bn.rd64(d, h + 32));
        let strsh = sh(shoff, @truncate(usize, bn.rd32(d, h + 40)));
        let soff = @truncate(usize, bn.rd64(d, strsh + 24));
        let n = size / 24;
        for i in 0..n {
            let e = off + (i * 24);
            if i == 0 {
                elf2us.push(0);
                continue;
            }
            let name = cstr_at(d, soff + @truncate(usize, bn.rd32(d, e)));
            let info = d[e + 4];
            let other = d[e + 5];
            let mut shndx = @truncate(usize, bn.rd16(d, e + 6));
            if (shndx == 0xffff) and (xindex_off != 0) {
                shndx = @truncate(usize, bn.rd32(d, xindex_off + (i * 4)));
            }
            let mut sec: i32 = -1;
            let mut value = bn.rd64(d, e + 8);
            let size_v = bn.rd64(d, e + 16);
            let mut bind = info >> 4;
            if bind > B_WEAK {
                bind = B_GLOBAL;  // (STB_GNU_UNIQUE and the like: a global)
            }
            if shndx == 0xfff1 {
                sec = SEC_ABS;
            } else if shndx == 0xfff2 {
                // common: the value is the alignment
                let cs = add_sec(o, u.cat2(".bss.common.", name), S_BSS, @max(value, 1));
                o.secs.get(@int_cast(usize, cs)).size = size_v;
                sec = cs;
                value = 0;
                bind = B_WEAK;
            } else if (shndx != 0) and (shndx < shnum) {
                sec = secmap[shndx];
                if (sec < 0) and (bind != B_LOCAL) {
                    sec = SEC_ABS;  // (defined in a section a link has no use for)
                    value = 0;
                }
            }
            let vis = other & 3;  // STV_INTERNAL and STV_HIDDEN: not seen outside the module
            let s = Sym.{ name: u.dup(name), sec: sec, value: value, size: size_v, bind: bind, ty: info & 15,
                          hidden: (vis == 1) or (vis == 2) };
            o.syms.push(s);
            let idx = @int_cast(u32, o.syms.len - 1);
            if (s.bind != B_LOCAL) and (s.name.len > 0) {
                let k = u.intern(s.name);
                let prev = o.symmap.get(k);
                if (prev == 0) or (s.sec != -1) {
                    o.symmap.put(k, idx + 1);
                }
            }
            elf2us.push(idx);
        }
    }
    // COMDAT groups: the signature (a symbol) and the member sections
    for i in 0..shnum {
        let h = sh(shoff, i);
        if bn.rd32(d, h + 4) != 17 {
            continue;
        }
        let off = @truncate(usize, bn.rd64(d, h + 24));
        let size = @truncate(usize, bn.rd64(d, h + 32));
        if (size < 4) or ((bn.rd32(d, off) & 1) == 0) {
            continue;  // (not GRP_COMDAT: nothing to choose)
        }
        let sym = @truncate(usize, bn.rd32(d, h + 44));
        let mut sig: []u8 = "";
        if sym < elf2us.len {
            let sy = o.syms.get(@as(usize, elf2us.get(sym)));
            sig = sy.name;
            if (sy.ty == 3) and (sy.sec >= 0) {
                sig = o.secs.get(@int_cast(usize, sy.sec)).name;  // (a section symbol: that section's name)
            }
        }
        let mut g = Group.{ sig: u.intern(sig), secs: u.List.[i32].empty(), sel: SEL_ANY };
        let mut k: usize = 4;
        while (k + 4) <= size {
            let m = @truncate(usize, bn.rd32(d, off + k));
            if (m < shnum) and (secmap[m] >= 0) {
                g.secs.push(secmap[m]);
            }
            k += 4;
        }
        o.groups.push(g);
    }
    // relocations
    for i in 0..shnum {
        let h = sh(shoff, i);
        if bn.rd32(d, h + 4) != 4 {
            continue;
        }
        let target = @truncate(usize, bn.rd32(d, h + 44));
        if (target >= shnum) or (secmap[target] < 0) {
            continue;
        }
        let s = o.secs.get(@int_cast(usize, secmap[target]));
        let off = @truncate(usize, bn.rd64(d, h + 24));
        let n = @truncate(usize, bn.rd64(d, h + 32)) / 24;
        for j in 0..n {
            let e = off + (j * 24);
            let info = bn.rd64(d, e + 8);
            let es = @truncate(usize, info >> 32);
            let mut us: u32 = 0;
            if es < elf2us.len {
                us = elf2us.get(es);
            }
            s.relocs.push(
                Rel.{
                    off: bn.rd64(d, e), ty: @truncate(u32, info), sym: us,
                    addend: @bit_cast(i64, bn.rd64(d, e + 16)) });
        }
    }
    return o;
}

fn classify(ty: u64, flags: u64) i32 {
    let tls = (flags & 0x400) != 0;
    if (ty == 14) or (ty == 15) or (ty == 16) {
        return S_DATA;  // (the arrays: by their names, nlink.ax)
    }
    if ty == 8 {
        if tls {
            return S_TBSS;
        }
        return S_BSS;
    }
    if tls {
        return S_TDATA;
    }
    if (flags & 4) != 0 {
        return S_TEXT;
    }
    if (flags & 1) != 0 {
        return S_DATA;
    }
    return S_RODATA;
}

fn sh(shoff: usize, i: usize) usize {
    return shoff + (i * 64);
}
