// =============================================================================
// x64abi.ax - x86-64 calls, as System V and Windows x64 pass arguments and
// return results: the argument and result registers, stack arguments and
// Windows' home area, results in registers (ir.EXT_REGS), the
// caller-saved registers a call clobbers, and sibling calls (jumps to the
// callee in place of a call and a return).
// =============================================================================
import "ftab.ax" as ft;
import "ir.ax" as ir;
import "isel.ax" as is;
import "mach.ax" as mc;
import "util.ax" as u;
import "x64ctx.ax" as xc;
import "x64emit.ax" as em;
import "x64enc.ax" as xe;
import "x64isel.ax" as xis;
import "x64sel.ax" as xsl;

// -----------------------------------------------------------------------------
// Calls
// -----------------------------------------------------------------------------
let arg_gprs: [6]i32 = [7, 6, 2, 1, 8, 9];  // rdi rsi rdx rcx r8 r9
// Windows x64: the first four arguments by position, in rcx rdx r8 r9 or
// xmm0-xmm3; the rest on the stack above 32 bytes of shadow space that the
// caller reserves for the callee
let win_gprs: [4]i32 = [1, 2, 8, 9];
pub const WIN_SHADOW: u64 = 32;

pub fn caller_saved() u64 {
    if xc.O.win {
        // rax rcx rdx r8-r11, xmm0-xmm5 (rsi, rdi and xmm6-xmm15 are callee-saved)
        return (0x0f07 | (@as(u64, 0x3f) << 16)) | (@as(u64, 0xffff) << 48);
    }
    // rax rcx rdx rsi rdi r8-r11, all xmm
    return (0x0fc7 | (@as(u64, 0xffff) << 16)) | (@as(u64, 0xffff) << 48);
}

// The register an argument or parameter arrives in (-1: on the stack),
// counting the integer and floating-point ones seen so far.
pub fn arg_reg(i: usize, c: u8, ng: *mut usize, nx: *mut usize) i32 {
    if xc.O.win {
        if i >= 4 {
            return -1;
        }
        if c == xsl.GPR {
            return win_gprs[i];
        }
        return xe.XMM0 + @int_cast(i32, i);
    }
    if (c == xsl.GPR) and (ng.* < 6) {
        ng.* += 1;
        return arg_gprs[ng.* - 1];
    }
    // (a vector of 32 or 64 bytes: ymm or zmm, the psABI's SSE and SSEUP
    // classes, as the C front end passes it with AVX or AVX-512F:
    // c/cgen_abi.ax, sysv_wide_vec)
    if (c != xsl.GPR) and (nx.* < 8) {
        nx.* += 1;
        return xe.XMM0 + @int_cast(i32, nx.* - 1);
    }
    return -1;
}

// Does call v pass or return a vector of 32 or 64 bytes in a register (the
// upper halves of the vector registers then live across the call)?
fn wide_call(v: *ir.Value) bool {
    let fty = ir.fty_of(v);
    if xsl.vl_of(fty.ret) > 0 {
        return true;
    }
    for x in v.xs.items() {
        if xsl.vl_of(x.ty) > 0 {
            return true;
        }
    }
    return false;
}

pub fn gen_call(v: *mut ir.Value) void {
    let fty = ir.fty_of(v);
    let n = v.xs.len;
    // arguments into registers (extended as the callee expects)
    let regs = is.call_args(v, xsl.reg, xis.ext_reg);
    let mut target: i32 = -1;
    if v.a.kind != ir.V_FUNC {
        target = xsl.reg(v.a);
    }
    // stack arguments
    let mut ng: usize = 0;
    let mut nx: usize = 0;
    let mut off: u64 = 0;
    if xc.O.win {
        off = WIN_SHADOW;
    }
    let mut uses = u.List.[mc.MOp].empty();
    let dest = u.newn.[i32](n + 1);
    for i in 0..n {
        let x = v.xs.get(i);
        let c = xsl.class_of(x.ty);
        dest[i] = arg_reg(i, c, &mut ng, &mut nx);
        if dest[i] < 0 {
            let mut sz: u64 = 8;
            if x.ty.kind == ir.T_VEC {
                sz = 16;
                off = (off + 15) & ~@as(u64, 15);
            }
            let m = mc.mem(xe.RSP, -1, 0, @bit_cast(i64, off));
            if c == xsl.GPR {
                _ = xsl.e2(xe.STORE, 8, m, xsl.R(regs[i]));
            } else if x.ty.kind == ir.T_VEC {
                _ = xsl.sse2(xe.MOVDQU_ST, xsl.R(regs[i]), m);
            } else if x.ty.bits == 32 {
                _ = xsl.sse2(xe.MOVSS_ST, xsl.R(regs[i]), m);
            } else {
                _ = xsl.sse2(xe.MOVSD_ST, xsl.R(regs[i]), m);
            }
            off += sz;
        }
    }
    off = (off + 15) & ~@as(u64, 15);
    if off > xc.FN.out_area {
        xc.FN.out_area = off;
    }
    for i in 0..n {
        if dest[i] >= 0 {
            if dest[i] >= xe.XMM0 {
                let m = xsl.sse2(xe.MOVAPS, xsl.W(dest[i]), xsl.R(regs[i]));
                m.sz = xsl.class_bytes(xsl.class_of(v.xs.get(i).ty));  // (ymm, zmm: the whole register)
                m.is_move = true;
            } else {
                let m = xsl.e2(xe.MOV_RR, 8, xsl.W(dest[i]), xsl.R(regs[i]));
                m.is_move = true;
            }
            mc.hint(xc.FN.mf, regs[i], dest[i]);
            uses.push(xsl.R(dest[i]));
        }
    }
    if fty.vararg {
        _ = xsl.e2(xe.MOV_RI, 4, xsl.W(xe.RAX), xsl.I(@int_cast(i64, nx)));
        uses.push(xsl.R(xe.RAX));
    }
    let rt = fty.ret;
    let mut rreg: i32 = -1;
    if rt.kind != ir.T_VOID {
        rreg = xe.RAX;
        if xsl.class_of(rt) != xsl.GPR {
            rreg = xe.XMM0;
        }
    }
    let mut ops = is.call_ops(v, target, &uses, xsl.func_sym, rreg);
    let rcode = call_regs_code(v);
    if rcode != 0 {
        c_result_regs(rcode, &mut ops);
    }
    let ci = xsl.emit(xe.CALL, 0, ops.items());
    if wide_call(v) {
        ci.sz = 32;  // (no vzeroupper before it, and the upper halves in use after it: x64emit.ax)
    }
    is.finish_call(xc.FN.mf, ci, v, ft.call_aux(v), caller_saved());  // (frame tables)
    if rcode != 0 {
        // the registers, for the IN_CALL_RESULTs
        for k in 0..c_result_count(rcode) {
            let r = c_result_reg(rcode, k);
            if r >= xe.XMM0 {
                xsl.copy(call_result_vreg(v, k, xsl.XMM), r, xsl.XMM);
            } else {
                xsl.copy(call_result_vreg(v, k, xsl.GPR), r, xsl.GPR);
            }
        }
    }
    if rreg == xe.XMM0 {
        xsl.copy(xsl.vreg(v), xe.XMM0, xsl.class_of(rt));
    } else if (rreg >= 0) and is.foreign_bool(v) {
        let t = xsl.vgpr();
        xsl.copy(t, xe.RAX, xsl.GPR);
        xsl.copy(xsl.vreg(v), xis.ext_reg(t, 8, false, false), xsl.GPR);
    } else if rreg >= 0 {
        xsl.copy(xsl.vreg(v), xe.RAX, xsl.GPR);
    }
    uses.deinit();
    ops.deinit();
}

// A result in registers (System V's C convention: the eightbytes of a
// structure or union in rax, rdx, xmm0 and xmm1, in order of each class;
// Axiom's small aggregates the same, lower.ax), as ir.EXT_REGS code says:
// register k of the result, and its class.
fn c_result_reg(code: u8, k: usize) i32 {
    let mut gi: i32 = 0;
    let mut fi: i32 = 0;
    for j in 0..k {
        if (code & (ir.EXT_REGS_FP0 << @truncate(u8, j))) != 0 {
            fi += 1;
        } else {
            gi += 1;
        }
    }
    if (code & (ir.EXT_REGS_FP0 << @truncate(u8, k))) != 0 {
        return xe.XMM0 + fi;
    }
    if gi == 0 {
        return xe.RAX;
    }
    return xe.RDX;
}

fn c_result_count(code: u8) usize {
    return @as(usize, code & 3) + 1;
}

// The call defines the result's registers.
fn c_result_regs(code: u8, ops: *mut u.List.[mc.MOp]) void {
    for k in 0..c_result_count(code) {
        ops.push(mc.reg(c_result_reg(code, k), mc.RD));
    }
}

// The ir.EXT_REGS mark of call v's result, or 0.
fn call_regs_code(v: *ir.Value) u8 {
    let ex = ir.ext_of(v);
    if (ex.len > 0) and (ex[0] >= ir.EXT_REGS) {
        return ex[0];
    }
    return 0;
}

pub fn call_result_vreg(v: *ir.Value, k: usize, c: u8) i32 {
    for x in xsl.S.call_results.items() {
        if (x.call == v) and (x.k == k) {
            return x.r;
        }
    }
    let mut r: i32 = 0;
    if c == xsl.XMM {
        r = xsl.vxmm();
    } else if c == xsl.GPR {
        r = xsl.vgpr();
    } else {
        r = mc.new_vreg(xc.FN.mf, c);
    }
    xsl.S.call_results.push(xsl.CallResult.{ call: v, k: k, r: r });
    return r;
}

// IN_CALL_RESULT(call, k): the copy the call made of register k.
pub fn gen_call_result(v: *mut ir.Value) void {
    let c = ir.resolve(v.xs.get(0));
    if xsl.S.tail_jumped and ((c.flags & ir.F_TAIL) != 0) {
        return;  // (the call left the function: its registers are the callee's result, gen_tail_call)
    }
    let k = @truncate(usize, ir.cint_val(v.xs.get(1)));
    let cl = xsl.class_of(v.ty);
    xsl.copy(xsl.vreg(v), call_result_vreg(c, k, cl), cl);
}

// The return of a function whose result is in registers (ir.EXT_REGS):
// t's xs in them.
pub fn ret_c_result(t: *mut ir.Value) void {
    let code = xc.FN.f.ret_ext;
    let n = c_result_count(code);
    let mut ops = u.List.[mc.MOp].empty();
    for k in 0..n {
        let r = c_result_reg(code, k);
        let x = t.xs.get(k);
        if r >= xe.XMM0 {
            let m = xsl.sse2(xe.MOVAPS, xsl.W(r), xsl.R(xsl.reg(x)));
            m.is_move = true;
        } else {
            let m = xsl.e2(xe.MOV_RR, 8, xsl.W(r), xsl.R(xsl.reg(x)));
            m.is_move = true;
        }
        ops.push(xsl.R(r));
    }
    _ = xsl.emit(xe.RET, 0, ops.items());
    ops.deinit();
}

// -----------------------------------------------------------------------------
// Sibling calls (tailrec.ax: mark_sibling_calls)
//
// A call followed by the return of its result leaves the function first:
// its arguments go where a call puts them, then one instruction (CALL with
// cc em.TAIL) restores the callee-saved registers and the frame as the
// return does and jumps to the callee (em.enc_tail), which returns to this
// function's caller. Arguments on the stack go to the bottom of the stack
// area this function's own stack parameters came in, which its caller made
// for them: only when the callee needs no more of it than the caller took
// (for both System V and Windows, whose 32 bytes of home area its caller
// owns too and the callee may use); else it is an ordinary call. They are
// stored into the outgoing area first and copied up by the jump, after
// everything else has read the incoming ones (stack parameters are loaded
// from there again rather than spilled: compile_func), so the two areas
// never overlap. The callee's address, for a call through a pointer, is in
// r11 (neither an argument register nor one the epilogue restores); a
// variadic callee gets al as a call gives it. A result in registers
// (ir.EXT_REGS) that the caller returns as it is (tailrec.ax: regs_return)
// stays in the callee's registers: neither the call's registers
// (gen_call_result) nor the return are selected.
// -----------------------------------------------------------------------------

// The bytes of stack arguments call v passes, or of stack parameters f
// takes (as gen_call and compile_func place them, past Windows' home area).
fn stack_bytes(f: *ir.Func, v: *ir.Value) u64 {
    let mut ng: usize = 0;
    let mut nx: usize = 0;
    let mut off: u64 = 0;
    let mut n = f.params.len;
    if u.notnil(v) {
        n = v.xs.len;
    }
    for i in 0..n {
        let mut t = u.nil.[ir.Ty]();
        if u.notnil(v) {
            t = v.xs.get(i).ty;
        } else {
            t = f.params[i].ty;
        }
        if arg_reg(i, xsl.class_of(t), &mut ng, &mut nx) < 0 {
            if t.kind == ir.T_VEC {
                off = ((off + 15) & ~@as(u64, 15)) + 16;
            } else {
                off += 8;
            }
        }
    }
    return off;
}

// Call v as a jump to its callee, if its stack arguments fit (see above).
pub fn gen_tail_call(v: *mut ir.Value) bool {
    if wide_call(v) or (xsl.vl_of(xc.FN.f.ty.ret) > 0) {
        return false;  // (ymm and zmm arguments and results: an ordinary call)
    }
    let need = stack_bytes(xc.FN.f, v);
    if need > stack_bytes(xc.FN.f, u.nil.[ir.Value]()) {
        return false;  // (the callee needs more of the stack than the caller was given)
    }
    let fty = ir.fty_of(v);
    let n = v.xs.len;
    let regs = is.call_args(v, xsl.reg, xis.ext_reg);
    let mut target: i32 = -1;
    if v.a.kind != ir.V_FUNC {
        target = xsl.reg(v.a);
    }
    let mut ng: usize = 0;
    let mut nx: usize = 0;
    let mut off: u64 = 0;
    if xc.O.win {
        off = WIN_SHADOW;
    }
    let mut uses = u.List.[mc.MOp].empty();
    let dest = u.newn.[i32](n + 1);
    for i in 0..n {
        let x = v.xs.get(i);
        let c = xsl.class_of(x.ty);
        dest[i] = arg_reg(i, c, &mut ng, &mut nx);
        if dest[i] < 0 {
            if x.ty.kind == ir.T_VEC {
                off = (off + 15) & ~@as(u64, 15);
            }
            let m = mc.mem(xe.RSP, -1, 0, @bit_cast(i64, off));
            if c == xsl.GPR {
                _ = xsl.e2(xe.STORE, 8, m, xsl.R(regs[i]));
                off += 8;
            } else if x.ty.kind == ir.T_VEC {
                _ = xsl.sse2(xe.MOVDQU_ST, xsl.R(regs[i]), m);
                off += 16;
            } else if x.ty.bits == 32 {
                _ = xsl.sse2(xe.MOVSS_ST, xsl.R(regs[i]), m);
                off += 8;
            } else {
                _ = xsl.sse2(xe.MOVSD_ST, xsl.R(regs[i]), m);
                off += 8;
            }
        }
    }
    off = (off + 15) & ~@as(u64, 15);
    if off > xc.FN.out_area {
        xc.FN.out_area = off;
    }
    for i in 0..n {
        if dest[i] >= 0 {
            if dest[i] >= xe.XMM0 {
                let m = xsl.sse2(xe.MOVAPS, xsl.W(dest[i]), xsl.R(regs[i]));
                m.sz = xsl.class_bytes(xsl.class_of(v.xs.get(i).ty));  // (ymm, zmm: the whole register)
                m.is_move = true;
            } else {
                let m = xsl.e2(xe.MOV_RR, 8, xsl.W(dest[i]), xsl.R(regs[i]));
                m.is_move = true;
            }
            mc.hint(xc.FN.mf, regs[i], dest[i]);
            uses.push(xsl.R(dest[i]));
        }
    }
    if fty.vararg {
        _ = xsl.e2(xe.MOV_RI, 4, xsl.W(xe.RAX), xsl.I(@int_cast(i64, nx)));
        uses.push(xsl.R(xe.RAX));
    }
    if target >= 0 {
        let m = xsl.e2(xe.MOV_RR, 8, xsl.W(xe.R11), xsl.R(target));
        m.is_move = true;
        target = xe.R11;
    }
    let mut ops = is.call_ops(v, target, &uses, xsl.func_sym, -1);
    if need > 0 {
        ops.push(mc.mem(xe.RBP, -1, 0, 16));  // (the incoming area it writes: the frame)
    }
    let ci = xsl.emit(xe.CALL, 0, ops.items());
    ci.cc = em.TAIL;
    ci.aux = @bit_cast(i64, need);  // (the bytes copied up)
    ci.clobber = 0;                 // (nothing of the function runs after it)
    xsl.S.tail_jumped = true;
    uses.deinit();
    ops.deinit();
    return true;
}
