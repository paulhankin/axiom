// =============================================================================
// wlink.ax - links wasm compilation units (wobj.ax) into a module.
//
// Symbols resolve by name (a strong definition wins over weak ones; local
// symbols stay within their unit). Only what the exports reach is kept.
// Memory: the stack comes first (so overflowing it traps: the stack pointer
// wraps below 0), then the data segments. Function pointers index table 0,
// whose slot 0 stays empty. Undefined functions, globals and tags with an
// explicit import module (`import host`, file-scope asm's imports) become
// imports; other undefined symbols are errors, but weak ones: a weak
// function nothing defines is null (table slot 0), its calls a trapping
// stub's (null_stubs), weak data nothing defines is at address 0. Globals come after the
// host's and the stack pointer; tags after the host's; file-scope asm's
// passive data and element segments before the module's own.
// =============================================================================
import "bin.ax" as bn;
import "dloc.ax" as dloc;
import "dwarf.ax" as dw;
import "ir.ax" as ir;
import "util.ax" as u;
import "wobj.ax" as wo;

pub struct Options {
    stack_size: u64,
    shared_memory: bool,  // threads: import a shared memory, initialize data once
    max_pages: u64,
    exports: [][]u8,  // extra symbol names to export (by symbol name)
}

// A resolved symbol: unit index and symbol index there.
struct Ref {
    un: i32,
    sym: u32,
}

let mut units_p: *mut *mut wo.Unit = @ptr_from_int(*mut *mut wo.Unit, 0);
let mut nunits: usize = 0;
let mut defs: u.SymMap.[*mut Ref] = u.SymMap.[*mut Ref].{ keys: @ptr_from_int(*mut usize, 0),
                                                          vals: @ptr_from_int(*mut *mut Ref, 0), cap: 0, len: 0 };
let mut failed: bool = false;

fn err(msg: []u8) void {
    u.eprint(u.f1("axiom: link error: %s\n", msg));
    failed = true;
}

// Per unit: final function index of each unit function index (imports and
// definitions), liveness of definitions and segments, segment addresses.
struct UnitMap {
    fidx: []mut i64,    // unit function index -> final index (-1 unknown)
    flive: []mut bool,  // defined functions (by definition number)
    slive: []mut bool,
    saddr: []mut u64,
    gidx: []mut i64,    // unit global index -> final global index
    tlive: []mut bool,  // defined tags (by definition number)
    tidx: []mut i64,    // unit tag index -> final tag index (-1 unknown)
    pidx: []mut i64,    // passive data segment -> its final index
    eidx: []mut i64,    // element segment -> its final index
}

let mut maps_p: *mut UnitMap = @ptr_from_int(*mut UnitMap, 0);

fn U() []mut *mut wo.Unit {
    return @slice_from_ptr(units_p, nunits);
}

fn MP() []mut UnitMap {
    return @slice_from_ptr(maps_p, nunits);
}

fn defined(s: *wo.Sym) bool {
    return (s.flags & wo.F_UNDEFINED) == 0;
}

// The definition a symbol reference resolves to (itself if defined and
// local or no better definition exists). un < 0: unresolved.
fn resolve(ui: usize, si: u32) Ref {
    let un = U()[ui];
    let s = un.syms.at(@as(usize, si));
    if defined(s) and ((s.flags & wo.F_LOCAL) != 0) {
        return Ref.{ un: @int_cast(i32, ui), sym: si };
    }
    if s.name.len > 0 {
        let d = defs.get(u.intern(s.name));
        if u.notnil(d) {
            return d.*;
        }
    }
    if defined(s) {
        return Ref.{ un: @int_cast(i32, ui), sym: si };
    }
    return Ref.{ un: -1, sym: si };
}

fn collect_defs() void {
    for ui in 0..nunits {
        let un = U()[ui];
        for si in 0..un.syms.len {
            let s = un.syms.at(si);
            if not defined(s) or ((s.flags & wo.F_LOCAL) != 0) or (s.name.len == 0) {
                continue;
            }
            let k = u.intern(s.name);
            let prev = defs.get(k);
            let weak = (s.flags & wo.F_WEAK) != 0;
            if u.notnil(prev) {
                let ps = U()[@int_cast(usize, prev.un)].syms.at(@as(usize, prev.sym));
                let pweak = (ps.flags & wo.F_WEAK) != 0;
                if pweak and not weak {
                    prev.un = @int_cast(i32, ui);
                    prev.sym = @int_cast(u32, si);
                } else if not pweak and not weak and (ps.kind == s.kind) {
                    err(u.f1("duplicate symbol '%s'", s.name));
                }
                continue;
            }
            let r = u.new.[Ref]();
            r.un = @int_cast(i32, ui);
            r.sym = @int_cast(u32, si);
            defs.put(k, r);
        }
    }
}

// Liveness: a work list of (unit, symbol) references.
let mut work: u.List.[Ref] = u.List.[Ref].{ data: @ptr_from_int(*mut Ref, 0), len: 0, cap: 0 };

fn mark(ui: usize, si: u32) void {
    let r = resolve(ui, si);
    if r.un < 0 {
        return;
    }
    let un = U()[@int_cast(usize, r.un)];
    let s = un.syms.at(@as(usize, r.sym));
    let mp = &mut MP()[@int_cast(usize, r.un)];
    if s.kind == wo.SYM_FUNC {
        let di = @as(usize, s.index) - un.fimports.len;
        if not mp.flive[di] {
            mp.flive[di] = true;
            work.push(Ref.{ un: r.un, sym: @int_cast(u32, di) });
        }
    } else if s.kind == wo.SYM_TAG {
        let di = @as(usize, s.index) - un.timports.len;
        mp.tlive[di] = true;
    } else if s.kind == wo.SYM_DATA {
        let sg = @as(usize, s.seg);
        if not mp.slive[sg] {
            mp.slive[sg] = true;
            work.push(Ref.{ un: -2 - r.un, sym: @int_cast(u32, sg) });
        }
    }
}

fn mark_relocs(ui: usize, rs: *u.List.[wo.Reloc]) void {
    for i in 0..rs.len {
        let r = rs.get(i);
        if (r.ty != wo.R_TYPE_INDEX_LEB) and (r.ty != wo.R_AXIOM_ELEM_INDEX_LEB) {
            mark(ui, r.sym);
        }
    }
}

fn liveness(o: *Options) void {
    for ui in 0..nunits {
        let un = U()[ui];
        for si in 0..un.syms.len {
            let s = un.syms.at(si);
            if defined(s) and (((s.flags & wo.F_EXPORTED) != 0) or ((s.flags & wo.F_NO_STRIP) != 0)) {
                mark(ui, @int_cast(u32, si));
            }
            if defined(s) and (s.kind == wo.SYM_FUNC) {
                for e in o.exports {
                    if u.str_eq(e, s.name) {
                        mark(ui, @int_cast(u32, si));
                    }
                }
            }
        }
        for x in un.inits.items() {
            mark(ui, @truncate(u32, x & 0xffff_ffff));  // (constructors: called by __wasm_call_ctors)
        }
        // (file-scope asm's element segments and start function)
        for e in un.elems.items() {
            for f in e.funcs.items() {
                mark(ui, f);
            }
        }
        if un.start != 0 {
            mark(ui, un.start - 1);
        }
    }
    while work.len > 0 {
        let w = work.pop();
        if w.un >= 0 {
            let ui = @int_cast(usize, w.un);
            mark_relocs(ui, &U()[ui].funcs.get(@as(usize, w.sym)).relocs);
        } else {
            let ui = @int_cast(usize, -2 - w.un);
            mark_relocs(ui, &U()[ui].segs.get(@as(usize, w.sym)).relocs);
        }
    }
}

// Final module state
let mut types: u.List.[[]u8] = u.List.[[]u8].{ data: @ptr_from_int(*mut []u8, 0), len: 0, cap: 0 };
struct Imp {
    module: []u8,
    name: []u8,
    ty: u32,
}
let mut imports: u.List.[Imp] = u.List.[Imp].{ data: @ptr_from_int(*mut Imp, 0), len: 0, cap: 0 };
let mut table: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };  // slot -> function
let mut table_slot: u.SymMap.[u32] = u.SymMap.[u32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 };

fn final_type(ui: usize, t: u32) u32 {
    return final_type_enc(U()[ui].types.get(@as(usize, t)));
}

// Final function index for a function symbol reference.
fn func_index(ui: usize, si: u32) i64 {
    let r = resolve(ui, si);
    if r.un >= 0 {
        let un = U()[@int_cast(usize, r.un)];
        return MP()[@int_cast(usize, r.un)].fidx[@as(usize, un.syms.at(@as(usize, r.sym)).index)];
    }
    // an import of the referencing unit
    let un = U()[ui];
    return MP()[ui].fidx[@as(usize, un.syms.at(@as(usize, si)).index)];
}

fn table_index(fi: i64) u32 {
    let k = u.addr_key(@int_cast(usize, fi) + 1);
    let found = table_slot.get(k);
    if found != 0 {
        return found;
    }
    table.push(@truncate(u32, @bit_cast(u64, fi)));
    let slot = @int_cast(u32, table.len);  // slot 0 is null
    table_slot.put(k, slot);
    return slot;
}

// Tags (the exception-handling extension): the units' definitions that are
// live, after the imports of the host's (undefined tags of an explicit
// module); longjmp's, __axc_longjmp_tag, is longjmp_unit's. A tag's final
// index.
struct TagImp {
    module: []u8,
    name: []u8,
    ty: u32,
}
let mut tag_imps: u.List.[TagImp] = u.List.[TagImp].{ data: @ptr_from_int(*mut TagImp, 0), len: 0, cap: 0 };
let mut tag_types: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };  // defined: final types

fn tag_index(ui: usize, si: u32) u64 {
    let s = U()[ui].syms.at(@as(usize, si));
    let r = resolve(ui, si);
    if r.un >= 0 {
        let un = U()[@int_cast(usize, r.un)];
        let x = MP()[@int_cast(usize, r.un)].tidx[@as(usize, un.syms.at(@as(usize, r.sym)).index)];
        if x >= 0 {
            return @bit_cast(u64, x);
        }
    } else {
        let x = MP()[ui].tidx[@as(usize, s.index)];
        if x >= 0 {
            return @bit_cast(u64, x);
        }
    }
    err(u.f1("undefined tag '%s'", s.name));
    return 0;
}

// The tags' final indices: the host's imports, then the live definitions;
// a reference's type must be its definition's.
fn add_tags() void {
    tag_imps.clear();
    tag_types.clear();
    for ui in 0..nunits {
        let un = U()[ui];
        for si in 0..un.syms.len {
            let s = un.syms.at(si);
            if (s.kind != wo.SYM_TAG) or defined(s) or (resolve(ui, @int_cast(u32, si)).un >= 0) or
               ((s.flags & wo.F_EXPLICIT_NAME) == 0) {
                continue;
            }
            let im = un.timports.get(@as(usize, s.index));
            let ty = final_type(ui, im.ty);
            let mut found: i64 = -1;
            for k in 0..tag_imps.len {
                let x = tag_imps.get(k);
                if u.str_eq(x.module, im.module) and u.str_eq(x.name, im.name) {
                    found = @int_cast(i64, k);
                    if x.ty != ty {
                        err(u.f1("the host's tag '%s' is imported with two types", im.name));
                    }
                }
            }
            if found < 0 {
                tag_imps.push(TagImp.{ module: im.module, name: im.name, ty: ty });
                found = @int_cast(i64, tag_imps.len - 1);
            }
            MP()[ui].tidx[@as(usize, s.index)] = found;
        }
    }
    for ui in 0..nunits {
        let un = U()[ui];
        for di in 0..un.tags.len {
            if MP()[ui].tlive[di] {
                MP()[ui].tidx[un.timports.len + di] = @int_cast(i64, tag_imps.len + tag_types.len);
                tag_types.push(final_type(ui, un.tags.get(di)));
            }
        }
    }
    // (an import of a tag another unit defines: the same type)
    for ui in 0..nunits {
        let un = U()[ui];
        for si in 0..un.syms.len {
            let s = un.syms.at(si);
            if (s.kind != wo.SYM_TAG) or defined(s) {
                continue;
            }
            let r = resolve(ui, @int_cast(u32, si));
            if r.un < 0 {
                continue;
            }
            let du = U()[@int_cast(usize, r.un)];
            let ds = du.syms.at(@as(usize, r.sym));
            let dt = final_type(@int_cast(usize, r.un), du.tags.get(@as(usize, ds.index) - du.timports.len));
            if final_type(ui, un.timports.get(@as(usize, s.index)).ty) != dt {
                err(u.f1("tag '%s' is declared with another type than its definition's", s.name));
            }
        }
    }
}

/// longjmp for WebAssembly with the exception-handling extension (a unit of
/// its own, weak, kept if referenced, as the native linkers' jstub.ax):
/// stores its value (1 for 0) as the jmp_buf's third word (byte 16) and
/// throws __axc_longjmp_tag with the jmp_buf's address. A function that
/// calls setjmp catches it (wasm.ax). Two entries: longjmp(env, int) for a
/// freestanding program, and __axc_longjmp_restore(env, val: i64), where
/// the hosted C library's longjmp ends (std/c/rt/core_jump.ax).
pub fn longjmp_unit(w64: bool) *mut wo.Unit {
    let un = wo.new_unit(w64);
    let pt = u.pick(w64, "\x7e", "\x7f");
    // (the tag, defined here: kept if something throws or catches it)
    un.tags.push(wo.type_index(un, pt, ""));
    let tag = wo.add_sym(un, wo.Sym.{ kind: wo.SYM_TAG, flags: wo.F_HIDDEN, name: "__axc_longjmp_tag", index: 0, seg: 0,
                                      off: 0, size: 0 });
    jump_func(un, "longjmp", wo.type_index(un, u.cat2(pt, "\x7f"), ""), false, tag);
    jump_func(un, "__axc_longjmp_restore", wo.type_index(un, u.cat2(pt, "\x7e"), ""), true, tag);
    return un;
}

// One of longjmp_unit's functions: (env, val), val an i64 if wide.
fn jump_func(un: *mut wo.Unit, name: []u8, ty: u32, wide: bool, tag: u32) void {
    let f = u.new.[wo.Func]();
    f.ty = ty;
    f.name = name;
    let mut b = bn.new_bytes();
    b.uleb(0);  // no locals
    // env[2] = val != 0 ? val : 1 (i32.store offset=16)
    b.put("\x20\x00\x20\x01");
    if wide {
        b.u8_(0xa7);  // i32.wrap_i64
    }
    b.put("\x41\x01\x20\x01");
    if wide {
        b.u8_(0xa7);
    }
    b.put("\x1b\x36\x02\x10");
    b.put("\x20\x00\x08");  // throw
    f.relocs.push(wo.Reloc.{ ty: wo.R_TAG_INDEX_LEB, off: @int_cast(u32, b.len()), sym: tag, addend: 0 });
    b.uleb5(0);
    b.u8_(0x0b);
    f.body = b;
    let fi = @int_cast(u32, un.funcs.len);
    f.sym = wo.add_sym(un, wo.Sym.{ kind: wo.SYM_FUNC, flags: wo.F_WEAK, name: name, index: fi, seg: 0, off: 0,
                                    size: 0 });
    un.funcs.push(f);
}

// The address of the word __axiom_memory_pages (the memory's size in pages
// as the threads have grown it; wasm.ax, "A thread's view of a growing
// shared memory"), after the data.
let mut pages_addr: u64 = 0;

fn data_addr(ui: usize, si: u32) u64 {
    let r = resolve(ui, si);
    if r.un < 0 {
        let s = U()[ui].syms.at(@as(usize, si));
        if u.str_eq(s.name, "__axiom_memory_pages") {
            return pages_addr;
        }
        if (s.flags & wo.F_WEAK) == 0 {
            err(u.f1("undefined symbol '%s'", s.name));
        }
        return 0;
    }
    let un = U()[@int_cast(usize, r.un)];
    let s = un.syms.at(@as(usize, r.sym));
    return MP()[@int_cast(usize, r.un)].saddr[@as(usize, s.seg)] + s.off;
}

// (the number of the host's globals, before the stack pointer's)
let mut gbase: i64 = 0;

fn global_index(ui: usize, si: u32) i64 {
    let s = U()[ui].syms.at(@as(usize, si));
    if u.str_eq(s.name, "__stack_pointer") {
        return gbase;
    }
    let r = resolve(ui, si);
    if r.un < 0 {
        let x = MP()[ui].gidx[@as(usize, s.index)];
        if (x < 0) or ((s.flags & wo.F_EXPLICIT_NAME) == 0) {
            err(u.f1("undefined global '%s'", s.name));
            return 0;
        }
        return x;  // (the host's)
    }
    let un = U()[@int_cast(usize, r.un)];
    return MP()[@int_cast(usize, r.un)].gidx[@as(usize, un.syms.at(@as(usize, r.sym)).index)];
}

fn apply(ui: usize, d: *mut bn.Bytes, rs: *u.List.[wo.Reloc], w64: bool) void {
    for i in 0..rs.len {
        let r = rs.get(i);
        let off = @as(usize, r.off);
        let t = r.ty;
        if t == wo.R_FUNCTION_INDEX_LEB {
            let fi = func_index(ui, r.sym);
            if fi < 0 {
                err(u.f1("undefined function '%s'", U()[ui].syms.at(@as(usize, r.sym)).name));
                continue;
            }
            d.set_uleb_n(off, @bit_cast(u64, fi), 5);
        } else if (t == wo.R_TABLE_INDEX_SLEB) or (t == wo.R_TABLE_INDEX_I32) or (t == wo.R_TABLE_INDEX_SLEB64) or
                  (t == wo.R_TABLE_INDEX_I64) {
            let fi = func_index(ui, r.sym);
            let mut slot: u64 = 0;
            // a weak reference to a function nothing defines is null, even
            // where it is imported for the calls of it (which the code makes
            // only when its address is not null)
            let fl = U()[ui].syms.at(@as(usize, r.sym)).flags;
            let weak_null = ((fl & F_NULL_STUB) != 0) or ((resolve(ui, r.sym).un < 0) and ((fl & wo.F_WEAK) != 0));
            if (fi >= 0) and not weak_null {
                slot = @as(u64, table_index(fi));
            } else if not weak_null and ((fl & wo.F_WEAK) == 0) {
                err(u.f1("undefined function '%s'", U()[ui].syms.at(@as(usize, r.sym)).name));
            }
            if t == wo.R_TABLE_INDEX_SLEB {
                d.set_sleb_n(off, @bit_cast(i64, slot), 5);
            } else if t == wo.R_TABLE_INDEX_SLEB64 {
                d.set_sleb_n(off, @bit_cast(i64, slot), 10);
            } else if t == wo.R_TABLE_INDEX_I32 {
                d.set_u32(off, slot);
            } else {
                d.set_u64(off, slot);
            }
        } else if (t == wo.R_MEMORY_ADDR_LEB) or (t == wo.R_MEMORY_ADDR_SLEB) or (t == wo.R_MEMORY_ADDR_I32) or
                  (t == wo.R_MEMORY_ADDR_LEB64) or (t == wo.R_MEMORY_ADDR_SLEB64) or (t == wo.R_MEMORY_ADDR_I64) {
            let a = data_addr(ui, r.sym) +% @bit_cast(u64, r.addend);
            if t == wo.R_MEMORY_ADDR_LEB {
                d.set_uleb_n(off, a, 5);
            } else if t == wo.R_MEMORY_ADDR_SLEB {
                d.set_sleb_n(off, @as(i64, @truncate(i32, @bit_cast(i64, a))), 5);
            } else if t == wo.R_MEMORY_ADDR_I32 {
                d.set_u32(off, a);
            } else if t == wo.R_MEMORY_ADDR_LEB64 {
                d.set_uleb_n(off, a, 10);
            } else if t == wo.R_MEMORY_ADDR_SLEB64 {
                d.set_sleb_n(off, @bit_cast(i64, a), 10);
            } else {
                d.set_u64(off, a);
            }
        } else if t == wo.R_TYPE_INDEX_LEB {
            d.set_uleb_n(off, @as(u64, final_type(ui, r.sym)), 5);
        } else if t == wo.R_GLOBAL_INDEX_LEB {
            d.set_uleb_n(off, @bit_cast(u64, global_index(ui, r.sym)), 5);
        } else if t == wo.R_TABLE_NUMBER_LEB {
            d.set_uleb_n(off, 0, 5);
        } else if t == wo.R_TAG_INDEX_LEB {
            d.set_uleb_n(off, tag_index(ui, r.sym), 5);
        } else if t == wo.R_AXIOM_DATA_INDEX_LEB {
            let x = resolve(ui, r.sym);
            let un = U()[@int_cast(usize, x.un)];
            d.set_uleb_n(off,
                         @bit_cast(
                             u64, MP()[@int_cast(usize, x.un)].pidx[@as(usize, un.syms.at(@as(usize, x.sym)).seg)]), 5);
        } else if t == wo.R_AXIOM_ELEM_INDEX_LEB {
            d.set_uleb_n(off, @bit_cast(u64, MP()[ui].eidx[@as(usize, r.sym)]), 5);
        } else {
            err(u.f1("unsupported relocation type %s", u.idec(@as(i32, t))));
        }
    }
}

fn section(out: *mut bn.Bytes, id: u8, c: *mut bn.Bytes) void {
    out.u8_(id);
    out.uleb(@as(u64, c.len()));
    out.put(c.view());
    c.free();
}

// The module being built.
struct Mod {
    w64: bool,
    nimp: usize,          // function imports
    fbody: u.List.[Ref],  // the defined functions: unit, definition
    ftys: u.List.[u32],   // and their types
    bodies: u.List.[bn.Bytes],
    nfunc: i64,  // functions (with the start function)
    stack_top: u64,
    flag_addr: u64,  // shared memories: the data's initialization flag
    pages: u64,
    globals: u.List.[wo.Global],  // the defined globals: the stack pointer's (its value stack_top), the units'
    gimps: u.List.[Imp],          // the host's globals (ty: value type | mutable << 8), before them
    psegs: u.List.[bn.Bytes],     // the passive data segments (file-scope asm's), first
    segs: u.List.[bn.Bytes],      // the data segments (not all zero)
    seg_addr: u.List.[u64],
    elems: u.List.[*mut Elem],  // the element segments (file-scope asm's), first
    starts: u.List.[i64],       // the units' start functions
    ex_names: u.List.[[]u8],    // exports: functions, globals, tags
    ex_funcs: u.List.[i64],
    ex_kinds: u.List.[u8],
    start: i64,  // the start function, -1: none
    init_body: bn.Bytes,
}

pub fn link(us0: []mut *mut wo.Unit, o: *Options) []u8 {
    let us = with_ctors_unit(us0);
    units_p = us.ptr;
    nunits = us.len;
    failed = false;
    collect_defs();
    null_stubs();
    new_maps();
    liveness(o);
    if failed {
        return u.nosym();
    }
    let w64 = (us.len > 0) and us[0].wasm64;
    let mut m = Mod.{ w64: w64, nimp: 0, fbody: u.List.[Ref].empty(), ftys: u.List.[u32].empty(),
                      bodies: u.List.[bn.Bytes].empty(), nfunc: 0, stack_top: 0, flag_addr: 0, pages: 0,
                      globals: u.List.[wo.Global].empty(), gimps: u.List.[Imp].empty(),
                      psegs: u.List.[bn.Bytes].empty(), segs: u.List.[bn.Bytes].empty(), seg_addr: u.List.[u64].empty(),
                      elems: u.List.[*mut Elem].empty(), starts: u.List.[i64].empty(), ex_names: u.List.[[]u8].empty(),
                      ex_funcs: u.List.[i64].empty(), ex_kinds: u.List.[u8].empty(), start: -1,
                      init_body: bn.new_bytes() };
    add_imports();
    m.nimp = imports.len;
    number_funcs(&mut m);
    ctors_body();
    if not lay_out_memory(&mut m, o) {
        return u.nosym();
    }
    add_globals(&mut m);
    add_tags();
    add_elems(&mut m);
    relocate(&mut m);
    add_exports(&mut m);
    if failed {
        return u.nosym();
    }
    if (o.shared_memory and (m.segs.len > 0)) or (m.starts.len > 0) {
        init_function(&mut m, o.shared_memory and (m.segs.len > 0));
    }
    let res = emit(&mut m, o);
    if failed {
        return u.nosym();
    }
    return res;
}

// -----------------------------------------------------------------------------
// Constructors: the units' INIT_FUNCS (the tool conventions' linking
// section: wobj.Unit.inits), called by __wasm_call_ctors, which the linker
// defines when a unit refers to it or has some (the C start-up calls it:
// cgen.ax), in the order of their priorities (of one priority, in the
// order of the units and of their lists). They are kept whatever refers
// to them (liveness).
// -----------------------------------------------------------------------------
let CTORS_NAME: []u8 = "__wasm_call_ctors";
let mut ctors_unit: i64 = -1;  // the unit defining __wasm_call_ctors, -1: none

// The units, and the linker's own defining __wasm_call_ctors when needed.
fn with_ctors_unit(us: []mut *mut wo.Unit) []mut *mut wo.Unit {
    ctors_unit = -1;
    let mut need = false;
    for un in us {
        if un.inits.len > 0 {
            need = true;
        }
        let k = un.symmap.get(u.intern(CTORS_NAME));
        if k != 0 {
            let sy = un.syms.get(@as(usize, k - 1));
            if (sy.kind == wo.SYM_FUNC) and ((sy.flags & wo.F_UNDEFINED) == 0) {
                return us;  // (a unit's own)
            }
            need = true;
        }
    }
    if not need {
        return us;
    }
    let cu = wo.new_unit((us.len > 0) and us[0].wasm64);
    let f = u.new.[wo.Func]();
    f.ty = wo.type_index(cu, "", "");
    f.name = CTORS_NAME;
    f.body.u8_(0);     // no locals (the calls: ctors_body)
    f.body.u8_(0x0b);  // end
    f.sym = wo.add_sym(cu, wo.Sym.{ kind: wo.SYM_FUNC, flags: wo.F_HIDDEN, name: CTORS_NAME, index: 0, seg: 0, off: 0,
                                    size: 0 });
    cu.funcs.push(f);
    let out = u.newn.[*mut wo.Unit](us.len + 1);
    for i in 0..us.len {
        out[i] = us[i];
    }
    out[us.len] = cu;
    ctors_unit = @bit_cast(i64, @as(u64, us.len));
    return out;
}

// __wasm_call_ctors's body, once the functions are numbered: a call of each
// constructor (live: liveness marks them), by priority.
fn ctors_body() void {
    if ctors_unit < 0 {
        return;
    }
    let mut es = u.List.[u64].empty();  // priority << 32 | order
    let mut fs = u.List.[i64].empty();
    for ui in 0..nunits {
        let un = U()[ui];
        for x in un.inits.items() {
            es.push(((x >> 32) << 32) | @as(u64, es.len));
            fs.push(func_index(ui, @truncate(u32, x & 0xffff_ffff)));
        }
    }
    u.sort.[u64](es.items(), cmp_u64);
    let f = U()[@int_cast(usize, ctors_unit)].funcs.get(0);
    f.body.free();
    f.body = bn.new_bytes();
    f.body.u8_(0);
    for e in es.items() {
        f.body.u8_(0x10);  // call
        f.body.uleb(@bit_cast(u64, fs.get(@truncate(usize, e & 0xffff_ffff))));
    }
    f.body.u8_(0x0b);
    es.deinit();
    fs.deinit();
}

fn cmp_u64(a: u64, b: u64) i32 {
    if a < b {
        return -1;
    }
    if a > b {
        return 1;
    }
    return 0;
}

// A symbol made a weak function's null stub (null_stubs): the format's flags
// leave this bit unused, and the linker's units are not written again.
const F_NULL_STUB: u32 = 0x4000_0000;

// The weak references to functions that nothing defines and no import
// names explicitly: the C rule for a weak undefined symbol is that its
// address is null (its table index, 0), and a call of it is undefined;
// such a call reaches a function of its own type, local to the unit, that
// traps (`unreachable`), as the tool conventions' linkers make one. (Weak
// data nothing defines is at address 0: data_addr.)
fn null_stubs() void {
    for ui in 0..nunits {
        let un = U()[ui];
        for si in 0..un.syms.len {
            let s = un.syms.at(si);
            if (s.kind != wo.SYM_FUNC) or defined(s) or ((s.flags & wo.F_WEAK) == 0) or
               ((s.flags & wo.F_EXPLICIT_NAME) != 0) or (resolve(ui, @int_cast(u32, si)).un >= 0) {
                continue;
            }
            let f = u.new.[wo.Func]();
            f.ty = un.fimports.get(@as(usize, s.index)).ty;
            f.name = s.name;
            f.sym = @int_cast(u32, si);
            let mut b = bn.new_bytes();
            b.put("\x00\x00\x0b");  // no locals; unreachable; end
            f.body = b;
            s.index = @int_cast(u32, un.fimports.len + un.funcs.len);
            s.flags = wo.F_LOCAL | F_NULL_STUB;
            un.funcs.push(f);
        }
    }
}

// Each unit's maps, empty.
fn new_maps() void {
    maps_p = u.newn.[UnitMap](nunits + 1).ptr;
    for ui in 0..nunits {
        let un = U()[ui];
        let mp = &mut MP()[ui];
        mp.fidx = u.newn.[i64](un.fimports.len + un.funcs.len + 1);
        for i in 0..mp.fidx.len {
            mp.fidx[i] = -1;
        }
        mp.flive = u.newn.[bool](un.funcs.len + 1);
        mp.slive = u.newn.[bool](un.segs.len + 1);
        mp.saddr = u.newn.[u64](un.segs.len + 1);
        mp.gidx = u.newn.[i64](un.gimports.len + un.globals.len + 1);
        mp.tlive = u.newn.[bool](un.tags.len + 1);
        mp.tidx = u.newn.[i64](un.timports.len + un.tags.len + 1);
        for i in 0..mp.tidx.len {
            mp.tidx[i] = -1;
        }
        mp.pidx = u.newn.[i64](un.segs.len + 1);
        mp.eidx = u.newn.[i64](un.elems.len + 1);
    }
}

// Function imports: unresolved undefined function symbols.
fn add_imports() void {
    for ui in 0..nunits {
        let un = U()[ui];
        for si in 0..un.syms.len {
            let s = un.syms.at(si);
            if (s.kind != wo.SYM_FUNC) or defined(s) {
                continue;
            }
            let r = resolve(ui, @int_cast(u32, si));
            if r.un >= 0 {
                continue;
            }
            let imp = un.fimports.get(@as(usize, s.index));
            if (s.flags & wo.F_EXPLICIT_NAME) == 0 {
                continue;  // reported when referenced
            }
            // one import per (module, name)
            let mut found: i64 = -1;
            for k in 0..imports.len {
                let x = imports.get(k);
                if u.str_eq(x.module, imp.module) and u.str_eq(x.name, imp.name) {
                    found = @int_cast(i64, k);
                }
            }
            if found < 0 {
                imports.push(Imp.{ module: imp.module, name: imp.name, ty: final_type(ui, imp.ty) });
                found = @int_cast(i64, imports.len - 1);
            }
            MP()[ui].fidx[@as(usize, s.index)] = found;
        }
    }
}

// The defined, live functions' indexes (after the imports).
fn number_funcs(m: *mut Mod) void {
    m.nfunc = @int_cast(i64, m.nimp);
    for ui in 0..nunits {
        let un = U()[ui];
        for di in 0..un.funcs.len {
            if MP()[ui].flive[di] {
                MP()[ui].fidx[un.fimports.len + di] = m.nfunc;
                m.nfunc += 1;
                m.fbody.push(Ref.{ un: @int_cast(i32, ui), sym: @int_cast(u32, di) });
            }
        }
    }
}

// Memory: the stack, then the live segments (and a shared memory's
// initialization flag), then the word __axiom_memory_pages. False if it is
// too large (reported).
fn lay_out_memory(m: *mut Mod, o: *Options) bool {
    let mut addr: u64 = (o.stack_size + 15) & ~@as(u64, 15);
    m.stack_top = addr;
    let mut np: i64 = 0;
    for ui in 0..nunits {
        let un = U()[ui];
        for si in 0..un.segs.len {
            if not MP()[ui].slive[si] {
                continue;
            }
            let sg = un.segs.get(si);
            if sg.passive {
                // (not in the image: memory.init writes it where the code says)
                MP()[ui].pidx[si] = np;
                np += 1;
                continue;
            }
            let a = @as(u64, 1) << sg.align;
            addr = (addr + a - 1) & ~(a - 1);
            MP()[ui].saddr[si] = addr;
            addr += @as(u64, sg.data.len());
        }
    }
    m.flag_addr = (addr + 3) & ~@as(u64, 3);
    if o.shared_memory {
        addr = m.flag_addr + 4;
    }
    pages_addr = (addr + 7) & ~@as(u64, 7);
    addr = pages_addr + 8;
    let data_end = (addr + 15) & ~@as(u64, 15);
    if not m.w64 and (data_end > 0x1_0000_0000) {
        // (the globals together fit an object, E0473, but not with a stack this large)
        err("the stack and the globals need more than the 4 GiB a wasm32 memory holds");
        return false;
    }
    m.pages = (data_end + 65535) / 65536;
    if m.pages < 2 {
        m.pages = 2;
    }
    return true;
}

// Globals: the host's (undefined globals of an explicit module), then
// __stack_pointer, then the units' definitions. A global's declaration must
// have its definition's type and mutability; an initial value of
// global.get is the host's global, or an immutable constant global's value.
fn add_globals(m: *mut Mod) void {
    for ui in 0..nunits {
        let un = U()[ui];
        for si in 0..un.syms.len {
            let s = un.syms.at(si);
            if (s.kind != wo.SYM_GLOBAL) or defined(s) or ((s.flags & wo.F_EXPLICIT_NAME) == 0) or
               (resolve(ui, @int_cast(u32, si)).un >= 0) {
                continue;
            }
            let im = un.gimports.get(@as(usize, s.index));
            let ty = im.ty | (@as(u32, im.mutable) << 8);
            let mut found: i64 = -1;
            for k in 0..m.gimps.len {
                let x = m.gimps.get(k);
                if u.str_eq(x.module, im.module) and u.str_eq(x.name, im.name) {
                    found = @int_cast(i64, k);
                    if x.ty != ty {
                        err(u.f1("the host's global '%s' is imported with two types", im.name));
                    }
                }
            }
            if found < 0 {
                m.gimps.push(Imp.{ module: im.module, name: im.name, ty: ty });
                found = @int_cast(i64, m.gimps.len - 1);
            }
            MP()[ui].gidx[@as(usize, s.index)] = found;
        }
    }
    gbase = @int_cast(i64, m.gimps.len);
    m.globals.push(wo.Global.{ vt: u.pick(m.w64, "\x7e", "\x7f")[0], mutable: true, init: 0, ik: wo.GI_CONST, hi: 0 });
    for ui in 0..nunits {
        let un = U()[ui];
        for gi in 0..un.globals.len {
            MP()[ui].gidx[un.gimports.len + gi] = gbase + @int_cast(i64, m.globals.len);
            m.globals.push(un.globals.get(gi));
        }
    }
    // (declarations against definitions)
    for ui in 0..nunits {
        let un = U()[ui];
        for si in 0..un.syms.len {
            let s = un.syms.at(si);
            if (s.kind != wo.SYM_GLOBAL) or defined(s) or u.str_eq(s.name, "__stack_pointer") {
                continue;
            }
            let r = resolve(ui, @int_cast(u32, si));
            if r.un < 0 {
                continue;
            }
            let im = un.gimports.get(@as(usize, s.index));
            let gi = global_index(ui, @int_cast(u32, si)) - gbase;
            let d = m.globals.get(@int_cast(usize, gi));
            if (@as(u32, d.vt) != im.ty) or (d.mutable != im.mutable) {
                err(u.f1("global '%s' is declared with another type or mutability than its definition's", s.name));
            }
        }
    }
    // (initial values of global.get: the unit's import number init)
    let mut k: usize = 1;
    for ui in 0..nunits {
        let un = U()[ui];
        for gi in 0..un.globals.len {
            let g = m.globals.at(k);
            k += 1;
            if g.ik != wo.GI_GET {
                continue;
            }
            let mut si: i64 = -1;
            for j in 0..un.syms.len {
                let s = un.syms.at(j);
                if (s.kind == wo.SYM_GLOBAL) and not defined(s) and (@as(i64, s.index) == g.init) {
                    si = @int_cast(i64, j);
                }
            }
            if si < 0 {
                err("a global's initial value names a global the unit does not import");
                continue;
            }
            let x = global_index(ui, @truncate(u32, @bit_cast(u64, si)));
            if x < gbase {
                g.init = x;
                continue;
            }
            let d = m.globals.get(@int_cast(usize, x - gbase));
            if d.mutable or (d.ik == wo.GI_GET) or (x == gbase) {
                err(u.f1("a global's initial value is global '%s', which is not an immutable constant",
                         un.syms.at(@truncate(usize, @bit_cast(u64, si))).name));
                continue;
            }
            g.ik = d.ik;
            g.init = d.init;
            g.hi = d.hi;
        }
    }
}

// The element segments of the units (file-scope asm's), first among the
// module's: their functions, each given a slot of the function table (as
// a pointer to it would be); and the units' start functions.
struct Elem {
    funcs: u.List.[i64],
    declare: bool,
}

fn add_elems(m: *mut Mod) void {
    for ui in 0..nunits {
        let un = U()[ui];
        for ei in 0..un.elems.len {
            let e = un.elems.get(ei);
            let x = u.new.[Elem]();
            x.declare = e.declare;
            for f in e.funcs.items() {
                let fi = func_index(ui, f);
                if fi < 0 {
                    err(u.f1("undefined function '%s'", un.syms.at(@as(usize, f)).name));
                    continue;
                }
                _ = table_index(fi);
                x.funcs.push(fi);
            }
            MP()[ui].eidx[ei] = @int_cast(i64, m.elems.len);
            m.elems.push(x);
        }
        if un.start != 0 {
            m.starts.push(func_index(ui, un.start - 1));
        }
    }
}

// The function types (all types must be known before the type section),
// then relocated copies of the code and the data (but all-zero segments,
// which need no initializer).
fn relocate(m: *mut Mod) void {
    for k in 0..m.fbody.len {
        let r = m.fbody.get(k);
        let ui = @int_cast(usize, r.un);
        m.ftys.push(final_type(ui, U()[ui].funcs.get(@as(usize, r.sym)).ty));
    }
    for k in 0..m.fbody.len {
        let r = m.fbody.get(k);
        let ui = @int_cast(usize, r.un);
        let f = U()[ui].funcs.get(@as(usize, r.sym));
        let mut b = bn.new_bytes();
        b.put(f.body.view());
        apply(ui, &mut b, &f.relocs, m.w64);
        m.bodies.push(b);
    }
    for ui in 0..nunits {
        let un = U()[ui];
        for si in 0..un.segs.len {
            if not MP()[ui].slive[si] {
                continue;
            }
            let sg = un.segs.get(si);
            let mut b = bn.new_bytes();
            b.put(sg.data.view());
            apply(ui, &mut b, &sg.relocs, m.w64);
            if sg.passive {
                m.psegs.push(b);
                continue;
            }
            let mut zero = true;
            for c in b.view() {
                if c != 0 {
                    zero = false;
                    break;
                }
            }
            if zero {
                b.free();
                continue;
            }
            m.segs.push(b);
            m.seg_addr.push(MP()[ui].saddr[si]);
        }
    }
}

// The units' exports (the first of each name): of live functions, of
// globals, of live tags.
fn add_exports(m: *mut Mod) void {
    for ui in 0..nunits {
        let un = U()[ui];
        for k in 0..un.exports.len {
            let e = un.exports.get(k);
            let mut dup = false;
            for j in 0..m.ex_names.len {
                if u.str_eq(m.ex_names.get(j), e.name) {
                    dup = true;
                }
            }
            let mut fi = MP()[ui].fidx[@as(usize, e.func)];
            if e.kind == wo.EX_GLOBAL {
                fi = MP()[ui].gidx[@as(usize, e.func)];
            } else if e.kind == wo.EX_TAG {
                fi = MP()[ui].tidx[@as(usize, e.func)];
            }
            if dup or (fi < 0) {
                continue;
            }
            m.ex_names.push(e.name);
            m.ex_funcs.push(fi);
            m.ex_kinds.push(e.kind);
        }
    }
}

// The start function: for shared memories (shared) it initializes the data
// once; then it calls the units' start functions (file-scope asm's), when
// the module is instantiated (in a program with threads, in each thread's
// instance, as the specification's start function runs).
fn init_function(m: *mut Mod, shared: bool) void {
    _ = final_type_enc("\x60\x00\x00");
    m.start = m.nfunc;
    m.nfunc += 1;
    let b = &mut m.init_body;
    b.uleb(0);
    if shared {
        init_data(m);
    }
    for f in m.starts.items() {
        b.u8_(0x10);
        b.uleb(@bit_cast(u64, f));
    }
    b.u8_(0x0b);
}

fn init_data(m: *mut Mod) void {
    let b = &mut m.init_body;
    let w64 = m.w64;
    let np = @as(u64, m.psegs.len);  // (the passive segments of file-scope asm come first)
    // if (cmpxchg(flag, 0, 1) == 0) { memory.init...; flag = 2 }
    pconst_b(b, w64, m.flag_addr);
    b.u8_(0x41);
    b.sleb(0);
    b.u8_(0x41);
    b.sleb(1);
    b.u8_(0xfe);
    b.uleb(0x48);
    b.uleb(2);
    b.uleb(0);
    b.u8_(0x45);  // eqz
    b.u8_(0x04);
    b.u8_(0x40);
    for k in 0..m.segs.len {
        pconst_b(b, w64, m.seg_addr.get(k));
        b.u8_(0x41);
        b.sleb(0);
        b.u8_(0x41);
        b.sleb(@bit_cast(i64, @as(u64, m.segs.at(k).len())));
        b.u8_(0xfc);
        b.uleb(8);
        b.uleb(np + @as(u64, k));
        b.u8_(0);
    }
    pconst_b(b, w64, m.flag_addr);
    b.u8_(0x41);
    b.sleb(2);
    b.u8_(0xfe);
    b.uleb(0x17);
    b.uleb(2);
    b.uleb(0);
    b.u8_(0x0b);
    for k in 0..m.segs.len {
        b.u8_(0xfc);
        b.uleb(9);
        b.uleb(np + @as(u64, k));
    }
}

// The module's encoding.
fn emit(m: *mut Mod, o: *Options) []u8 {
    let w64 = m.w64;
    let mut out = bn.new_bytes();
    out.put("\x00asm");
    out.u32_(1);
    // type
    let mut c = bn.new_bytes();
    c.uleb(@as(u64, types.len));
    for i in 0..types.len {
        c.put(types.get(i));
    }
    section(&mut out, 1, &mut c);
    c = import_section(m, o);
    section(&mut out, 2, &mut c);
    // function
    c = bn.new_bytes();
    let mut ndef = m.fbody.len;
    if m.start >= 0 {
        ndef += 1;
    }
    c.uleb(@as(u64, ndef));
    for k in 0..m.fbody.len {
        c.uleb(@as(u64, m.ftys.get(k)));
    }
    if m.start >= 0 {
        c.uleb(@as(u64, final_type_enc("\x60\x00\x00")));
    }
    section(&mut out, 3, &mut c);
    // table
    c = bn.new_bytes();
    c.uleb(1);
    c.u8_(0x70);
    c.u8_(1);
    c.uleb(@as(u64, table.len) + 1);
    c.uleb(@as(u64, table.len) + 1);
    section(&mut out, 4, &mut c);
    // memory
    if not o.shared_memory {
        c = bn.new_bytes();
        c.uleb(1);
        if w64 {
            c.u8_(4);
        } else {
            c.u8_(0);
        }
        c.uleb(m.pages);
        section(&mut out, 5, &mut c);
    }
    // tag
    if tag_types.len > 0 {
        c = bn.new_bytes();
        c.uleb(@as(u64, tag_types.len));
        for t in tag_types.items() {
            c.u8_(0);
            c.uleb(@as(u64, t));
        }
        section(&mut out, 13, &mut c);
    }
    // global
    c = bn.new_bytes();
    c.uleb(@as(u64, m.globals.len));
    for i in 0..m.globals.len {
        let g = m.globals.get(i);
        c.u8_(g.vt);
        c.u8_(@as(u8, g.mutable));
        if i == 0 {
            pconst_b(&mut c, w64, m.stack_top);
            c.u8_(0x0b);
        } else {
            wo.put_init(&mut c, &g);
        }
    }
    section(&mut out, 6, &mut c);
    // export
    c = bn.new_bytes();
    let mut nex = m.ex_names.len;
    if not o.shared_memory {
        nex += 1;
    }
    c.uleb(@as(u64, nex));
    if not o.shared_memory {
        c.name("memory");
        c.u8_(2);
        c.uleb(0);
    }
    for i in 0..m.ex_names.len {
        c.name(m.ex_names.get(i));
        c.u8_(m.ex_kinds.get(i));
        c.uleb(@bit_cast(u64, m.ex_funcs.get(i)));
    }
    section(&mut out, 7, &mut c);
    // start
    if m.start >= 0 {
        c = bn.new_bytes();
        c.uleb(@bit_cast(u64, m.start));
        section(&mut out, 8, &mut c);
    }
    // elem: file-scope asm's segments, then the table's slots 1..n
    let ne = m.elems.len + @as(usize, table.len > 0);
    if ne > 0 {
        c = bn.new_bytes();
        c.uleb(@as(u64, ne));
        for e in m.elems.items() {
            c.u8_(u.pick(e.declare, "\x03", "\x01")[0]);
            c.u8_(0);
            c.uleb(@as(u64, e.funcs.len));
            for f in e.funcs.items() {
                c.uleb(@bit_cast(u64, f));
            }
        }
        if table.len > 0 {
            c.uleb(0);
            c.u8_(0x41);
            c.sleb(1);
            c.u8_(0x0b);
            c.uleb(@as(u64, table.len));
            for i in 0..table.len {
                c.uleb(@as(u64, table.get(i)));
            }
        }
        section(&mut out, 9, &mut c);
    }
    // datacount (for memory.init / data.drop)
    if (m.start >= 0) or (m.psegs.len > 0) {
        c = bn.new_bytes();
        c.uleb(@as(u64, m.psegs.len + m.segs.len));
        section(&mut out, 12, &mut c);
    }
    c = code_section(m, ndef);
    let code_size = @as(u64, c.len());
    section(&mut out, 10, &mut c);
    c = data_section(m, o);
    section(&mut out, 11, &mut c);
    c = name_section(m);
    section(&mut out, 0, &mut c);
    debug_sections(&mut out, m, code_size);
    let res = u.dup(out.view());
    out.free();
    return res;
}

// The function imports, and a shared memory's.
fn import_section(m: *Mod, o: *Options) bn.Bytes {
    let mut c = bn.new_bytes();
    let mut nimports = imports.len + m.gimps.len + tag_imps.len;
    if o.shared_memory {
        nimports += 1;
    }
    c.uleb(@as(u64, nimports));
    for i in 0..imports.len {
        let x = imports.get(i);
        c.name(x.module);
        c.name(x.name);
        c.u8_(0);
        c.uleb(@as(u64, x.ty));
    }
    for x in m.gimps.items() {
        c.name(x.module);
        c.name(x.name);
        c.u8_(3);
        c.u8_(@truncate(u8, x.ty));
        c.u8_(@truncate(u8, x.ty >> 8));
    }
    for x in tag_imps.items() {
        c.name(x.module);
        c.name(x.name);
        c.u8_(4);
        c.u8_(0);
        c.uleb(@as(u64, x.ty));
    }
    if o.shared_memory {
        c.name("env");
        c.name("memory");
        c.u8_(2);
        let mut fl: u8 = 3;
        if m.w64 {
            fl = 7;
        }
        c.u8_(fl);
        c.uleb(m.pages);
        let mut mx = o.max_pages;
        if mx < m.pages {
            mx = m.pages;
        }
        c.uleb(mx);
    }
    return c;
}

// The function bodies (freed), and the start function's.
fn code_section(m: *mut Mod, ndef: usize) bn.Bytes {
    let mut c = bn.new_bytes();
    c.uleb(@as(u64, ndef));
    body_offs.clear();
    body_sizes.clear();
    for k in 0..m.bodies.len {
        let b = m.bodies.at(k);
        c.uleb(@as(u64, b.len()));
        body_offs.push(@as(u64, c.len()));
        body_sizes.push(@as(u64, b.len()));
        c.put(b.view());
        b.free();
    }
    if m.start >= 0 {
        c.uleb(@as(u64, m.init_body.len()));
        body_offs.push(@as(u64, c.len()));  // (the start function's, last: debug_sections)
        body_sizes.push(@as(u64, m.init_body.len()));
        c.put(m.init_body.view());
    }
    return c;
}

// The data segments (freed): passive in a shared memory (the start
// function initializes them), else active at their addresses.
fn data_section(m: *mut Mod, o: *Options) bn.Bytes {
    let mut c = bn.new_bytes();
    c.uleb(@as(u64, m.psegs.len + m.segs.len));
    for k in 0..m.psegs.len {
        let b = m.psegs.at(k);
        c.u8_(1);  // passive
        c.uleb(@as(u64, b.len()));
        c.put(b.view());
        b.free();
    }
    for k in 0..m.segs.len {
        let b = m.segs.at(k);
        if o.shared_memory {
            c.u8_(1);  // passive
        } else {
            c.u8_(0);
            pconst_b(&mut c, m.w64, m.seg_addr.get(k));
            c.u8_(0x0b);
        }
        c.uleb(@as(u64, b.len()));
        c.put(b.view());
        b.free();
    }
    return c;
}

// -----------------------------------------------------------------------------
// Debug information (-g)
//
// The units' line tables (wobj.Func.lines) as DWARF in custom sections
// named for the sections (".debug_info", ".debug_line", ...), as the
// WebAssembly tool conventions say (Debugging.md): a code address is an
// offset in the code section's contents, and a function starts at its
// body (its locals), past the body's size. One compilation unit for the
// module; no call frame information (WebAssembly has no machine stack to
// describe).
// -----------------------------------------------------------------------------
let mut body_offs: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };
let mut body_sizes: u.List.[u64] = u.List.[u64].{ data: @ptr_from_int(*mut u64, 0), len: 0, cap: 0 };

fn body_addr(k: u32) u64 {
    return body_offs.get(@as(usize, k));
}

// The debug sections: each unit's own DWARF (DEBUG_FULL: wobj.ax's
// Unit.dbg), its pieces appended in the units' order and its fixups
// resolved; then, for the units without (their functions' line tables
// only), one compilation unit made here, at the level of lines. A unit none
// of whose functions are kept contributes nothing; a reference to a
// function or datum that is not kept is the tombstone address -1 (the
// tool conventions' for DWARF), and a unit's code is the span of its kept
// functions, which the linker keeps together and in order.
fn debug_sections(out: *mut bn.Bytes, m: *Mod, code_size: u64) void {
    let mut any = false;
    for k in 0..m.fbody.len {
        let r = m.fbody.get(k);
        let un = U()[@int_cast(usize, r.un)];
        any = any or (un.funcs.get(@as(usize, r.sym)).lines.len > 0) or (un.dbg.len > 0);
    }
    if not any {
        return;
    }
    let mut asz: u64 = 4;
    if m.w64 {
        asz = 8;
    }
    for k in 0..dw.NSEC {
        MERGED[k] = bn.new_bytes();
    }
    // the units' own
    for ui in 0..nunits {
        let un = U()[ui];
        if un.dbg.len == 0 {
            continue;
        }
        let mut lo: u64 = 0xffff_ffff_ffff_ffff;
        let mut hi: u64 = 0;
        for di in 0..un.funcs.len {
            let fi = MP()[ui].fidx[un.fimports.len + di];
            if fi >= 0 {
                let k = @int_cast(usize, fi) - m.nimp;
                lo = @min(lo, body_offs.get(k));
                hi = @max(hi, body_offs.get(k) + body_sizes.get(k));
            }
        }
        if hi > 0 {
            merge_dwarf(un.dbg.items(), un.dbg_fx.items(), @int_cast(i64, ui), lo, hi, m);
        }
    }
    // the others' line tables: one unit made here, over their functions (and
    // the start function, a shared memory's segments initialized, which has
    // no source: a subprogram all of whose code is line 0)
    let mut d = dw.begin(dw.ARCH_WASM, asz, 1);
    d.lang = dw.lang();
    let mut lo: u64 = 0xffff_ffff_ffff_ffff;
    let mut hi: u64 = 0;
    for k in 0..body_offs.len {
        let mut name = "axiom.start";
        let mut src: u32 = 0;
        let mut rows = u.nil_slice.[u64]();
        if k < m.fbody.len {
            let r = m.fbody.get(k);
            let un = U()[@int_cast(usize, r.un)];
            if un.dbg.len > 0 {
                continue;
            }
            let f = un.funcs.get(@as(usize, r.sym));
            name = dw.name_of(f.name);
            src = f.src;
            rows = f.lines.items();
        }
        lo = @min(lo, body_offs.get(k));
        hi = @max(hi, body_offs.get(k) + body_sizes.get(k));
        let df = dw.Func.{ xcfi: u.nil_slice.[dw.XCfi](), sym: @int_cast(u32, k), name: name, external: false,
                           size: body_sizes.get(k), src: src, rows: rows, scopes: u.nil_slice.[u64](),
                           cfi: u.nil_slice.[u64](), regs: u.nil_slice.[u64](), irf: u.nil.[ir.Func](),
                           vars: u.nil_slice.[i64](), vlocs: u.nil_slice.[dloc.VLoc](), frame_local: -1,
                           calls: u.nil_slice.[dloc.CallSite]() };
        dw.add_func(&mut d, &df);
    }
    if hi > 0 {
        let parts = dw.finish_parts(&mut d);
        let mut secs = u.List.[wo.DbgSec].empty();
        let mut fxs = u.List.[wo.DbgFix].empty();
        for k in 0..dw.NSEC {
            secs.push(wo.DbgSec.{ name: dw.SEC_NAMES[k], data: parts[k].b });
            for x in parts[k].fx.items() {
                fxs.push(wo.DbgFix.{ sec: @int_cast(u32, k), off: x.off, kind: x.kind, sym: x.sym, addend: x.addend });
            }
        }
        merge_dwarf(secs.items(), fxs.items(), -1, lo, hi, m);
    }
    for k in 0..dw.NSEC {
        if MERGED[k].len() > 0 {
            let mut c = bn.new_bytes();
            c.name(dw.SEC_NAMES[k]);
            c.put(MERGED[k].view());
            section(out, 0, &mut c);
        }
        MERGED[k].free();
    }
    _ = code_size;
}

// The module's debug sections, as debug_sections builds them.
let mut MERGED: [11]bn.Bytes = [bn.Bytes.{ b: u.List.[u8].{ data: @ptr_from_int(*mut u8, 0), len: 0, cap: 0 } }; 11];

// Appends one unit's DWARF (its sections, by name, and its fixups) to the
// module's, its fixups resolved: an address of a symbol of unit ui (ui < 0:
// of function k of the module, the unit made here), of the unit's code
// (lo), its size (hi - lo), offsets in its own sections.
fn merge_dwarf(secs: []wo.DbgSec, fxs: []wo.DbgFix, ui: i64, lo: u64, hi: u64, m: *Mod) void {
    let mut asz: u64 = 4;
    if m.w64 {
        asz = 8;
    }
    let mut base: [11]u64 = [0; 11];
    let mut at: [11]i64 = [-1; 11];  // the unit's sections' kinds (dwarf.ax's D_*), by its numbering
    for j in 0..@min(secs.len, dw.NSEC) {
        for k in 0..dw.NSEC {
            if u.str_eq(dw.SEC_NAMES[k], secs[j].name) {
                at[j] = @int_cast(i64, k);
                base[k] = @as(u64, MERGED[k].len());
                MERGED[k].put(secs[j].data.view());
            }
        }
    }
    for x in fxs {
        if (@as(usize, x.sec) >= dw.NSEC) or (at[@as(usize, x.sec)] < 0) {
            continue;
        }
        let k = @int_cast(usize, at[@as(usize, x.sec)]);
        let off = @truncate(usize, base[k] + x.off);
        if x.kind == wo.DFX_SEC {
            let mut tb: u64 = 0;
            if (@as(usize, x.sym) < dw.NSEC) and (at[@as(usize, x.sym)] >= 0) {
                tb = base[@int_cast(usize, at[@as(usize, x.sym)])];
            }
            MERGED[k].set_u32(off, (tb + @bit_cast(u64, x.addend)) & 0xffff_ffff);
        } else if x.kind == wo.DFX_SIZE {
            put_n(&mut MERGED[k], off, @as(u64, x.sym), hi - lo);
        } else if x.kind == wo.DFX_ADDR {
            let mut a: u64 = 0xffff_ffff_ffff_ffff;
            if x.sym == dw.TEXT_SYM {
                a = lo;
            } else {
                let mut w: u64 = 0xffff_ffff_ffff_ffff;
                if ui < 0 {
                    w = body_offs.get(@as(usize, x.sym));
                } else {
                    w = sym_addr(@int_cast(usize, ui), x.sym, m);
                }
                if w != 0xffff_ffff_ffff_ffff {
                    a = w +% @bit_cast(u64, x.addend);
                }
            }
            put_n(&mut MERGED[k], off, asz, a);
        }
    }
}

// n bytes (4 or 8) of v at offset off.
fn put_n(b: *mut bn.Bytes, off: usize, n: u64, v: u64) void {
    if n == 8 {
        b.set_u64(off, v);
    } else {
        b.set_u32(off, v & 0xffff_ffff);
    }
}

// The address of symbol si of unit ui (a function's code offset, a
// datum's address), or -1 if it is not kept.
fn sym_addr(ui: usize, si: u32, m: *Mod) u64 {
    let un = U()[ui];
    if @as(usize, si) >= un.syms.len {
        return 0xffff_ffff_ffff_ffff;
    }
    let s = un.syms.at(@as(usize, si));
    if s.kind == wo.SYM_FUNC {
        if (s.flags & wo.F_UNDEFINED) != 0 {
            return 0xffff_ffff_ffff_ffff;
        }
        let fi = MP()[ui].fidx[@as(usize, s.index)];
        if fi < 0 {
            return 0xffff_ffff_ffff_ffff;
        }
        return body_offs.get(@int_cast(usize, fi) - m.nimp);
    }
    if (s.kind == wo.SYM_DATA) and ((s.flags & wo.F_UNDEFINED) == 0) and MP()[ui].slive[@as(usize, s.seg)] {
        return MP()[ui].saddr[@as(usize, s.seg)] + s.off;
    }
    return 0xffff_ffff_ffff_ffff;
}

// The function names (for engine stack traces).
fn name_section(m: *Mod) bn.Bytes {
    let mut c = bn.new_bytes();
    c.name("name");
    let mut sub = bn.new_bytes();
    sub.uleb(@as(u64, m.nimp + m.fbody.len));
    for i in 0..imports.len {
        sub.uleb(@as(u64, i));
        sub.name(imports.get(i).name);
    }
    for k in 0..m.fbody.len {
        let r = m.fbody.get(k);
        sub.uleb(@as(u64, m.nimp + k));
        sub.name(U()[@int_cast(usize, r.un)].funcs.get(@as(usize, r.sym)).name);
    }
    c.u8_(1);
    c.uleb(@as(u64, sub.len()));
    c.put(sub.view());
    sub.free();
    return c;
}

fn final_type_enc(enc: []u8) u32 {
    for i in 0..types.len {
        if u.str_eq(types.get(i), enc) {
            return @int_cast(u32, i);
        }
    }
    types.push(enc);
    return @int_cast(u32, types.len - 1);
}

fn pconst_b(b: *mut bn.Bytes, w64: bool, x: u64) void {
    if w64 {
        b.u8_(0x42);
        b.sleb(@bit_cast(i64, x));
    } else {
        b.u8_(0x41);
        b.sleb(@as(i64, @truncate(i32, @bit_cast(i64, x))));
    }
}
