// =============================================================================
// lower.ax - makes the IR scalar: aggregate (struct and array) SSA values
// become memory, and the internal calling convention passes aggregates by
// address.
//
// Every aggregate value gets a *slot*, the address of memory holding it:
//   - a load copies into a fresh stack slot;
//   - insertvalue writes into its operand's slot when it is the operand's
//     only use (the usual chain that builds a struct literal), and into a
//     copy otherwise;
//   - extractvalue of an aggregate field is an address inside the slot, of
//     a scalar field a load from it;
//   - a constant aggregate is a read-only global;
//   - aggregate parameters arrive as addresses, and aggregate results are
//     written through a hidden first parameter (sret).
// Slots are never written after their value is complete, so aliasing a slot
// (a field address, a select of two slots) is safe.
// =============================================================================
import "ir.ax" as ir;
import "util.ax" as u;

let mut M: *mut ir.Module = @ptr_from_int(*mut ir.Module, 0);
let mut B: *mut ir.Builder = @ptr_from_int(*mut ir.Builder, 0);
let mut F: *mut ir.Func = @ptr_from_int(*mut ir.Func, 0);
let mut sret_calls: u.List.[*mut ir.Value] = u.List.[*mut ir.Value].{ data: @ptr_from_int(*mut *mut ir.Value, 0),
                                                                      len: 0, cap: 0 };
let mut const_globals: u.SymMap.[*mut ir.Value] = u.SymMap.[*mut ir.Value].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut *mut ir.Value, 0), cap: 0, len: 0 };

fn vnil() *mut ir.Value {
    return u.nil.[ir.Value]();
}

fn isz(v: u64) *mut ir.Value {
    return ir.cint(ir.isz(), v);
}

// A small aggregate (a slice, a pair) is passed as its scalar leaves: their
// types and offsets, or false when it has more than MAX_LEAVES of them.
const MAX_LEAVES: usize = 4;

struct Leaves {
    tys: [4]*mut ir.Ty,
    offs: [4]u64,
    n: usize,
}

fn leaves_of(t: *mut ir.Ty, off: u64, l: *mut Leaves) bool {
    let k = t.kind;
    if ((k == ir.T_INT) and (t.bits <= 64)) or (k == ir.T_FLOAT) or (k == ir.T_PTR) {
        if l.n >= MAX_LEAVES {
            return false;
        }
        l.tys[l.n] = t;
        l.offs[l.n] = off;
        l.n += 1;
        return true;
    }
    if (k == ir.T_STRUCT) or (k == ir.T_ARRAY) {
        let n = ir.field_count(t);
        if n > MAX_LEAVES {
            return false;
        }
        for i in 0..n {
            if not leaves_of(ir.field_ty(t, i), off + ir.field_off(t, i), l) {
                return false;
            }
        }
        return true;
    }
    return false;
}

fn split(t: *mut ir.Ty, l: *mut Leaves) bool {
    l.n = 0;
    return ir.is_agg(t) and leaves_of(t, 0, l);
}

// The signature with aggregates passed by address (small ones as their
// leaves) and returned through sret.
fn lower_fty(t: *mut ir.Ty) *mut ir.Ty {
    let mut any = ir.is_agg(t.ret);
    let mut n = t.params.len;
    let mut l = Leaves.{ tys: [ir.t_void(); 4], offs: [0; 4], n: 0 };
    for p in t.params {
        if ir.is_agg(p) {
            any = true;
            if split(p, &mut l) {
                n += l.n;
            }
        }
    }
    if not any {
        return t;
    }
    let ps = u.newn.[*mut ir.Ty](n + 2);
    let mut k: usize = 0;
    let mut rt = t.ret;
    if ir.is_agg(t.ret) {
        ps[0] = ir.t_ptr();
        k = 1;
        rt = ir.t_void();
    }
    for p in t.params {
        if split(p, &mut l) {
            for j in 0..l.n {
                ps[k] = l.tys[j];
                k += 1;
            }
        } else if ir.is_agg(p) {
            ps[k] = ir.t_ptr();
            k += 1;
        } else {
            ps[k] = p;
            k += 1;
        }
    }
    return ir.t_fn(rt, ps[0..k], t.vararg);
}

fn lower_sig(f: *mut ir.Func) void {
    let nt = lower_fty(f.ty);
    if nt == f.ty {
        return;
    }
    let sret = ir.is_agg(f.ty.ret);
    let n = nt.params.len;
    let mut k: usize = 0;
    let ps = u.newn.[*mut ir.Value](n + 2);
    let ext = u.newn.[u8](n + 2);
    if sret {
        ps[0] = ir.new_param(f, ir.t_ptr(), 0);
        ext[0] = ir.EXT_SRET;
        k = 1;
    }
    let mut l = Leaves.{ tys: [ir.t_void(); 4], offs: [0; 4], n: 0 };
    for i in 0..f.params.len {
        let p = f.params[i];
        if split(p.ty, &mut l) {
            // the leaves arrive as parameters; the body stores them into a
            // slot (scalar replacement takes it apart again)
            let s = u.newn.[*mut ir.Value](MAX_LEAVES);
            for j in 0..l.n {
                s[j] = ir.new_param(f, l.tys[j], k);
                ps[k] = s[j];
                ext[k] = 0;
                k += 1;
            }
            p.auxp = @ptr_cast(*mut void, s.ptr);  // (the leaves, until lower_body makes the slot)
            f.split.push(p);
        } else if ir.is_agg(p.ty) {
            let np = ir.new_param(f, ir.t_ptr(), k);
            p.auxp = @ptr_cast(*mut void, np);  // the slot of the aggregate parameter
            ps[k] = np;
            ext[k] = ir.EXT_BYVAL;  // (parameters are immutable: nothing writes it)
            k += 1;
        } else {
            p.cv = @as(u64, k);
            ps[k] = p;
            ext[k] = f.param_ext[i];
            k += 1;
        }
    }
    f.params = ps[0..k];
    f.param_ext = ext[0..k];
    f.ty = nt;
    f.sret = sret;
    if sret {
        f.ret_ext = 0;
    }
}

fn entry_alloca(t: *mut ir.Ty) *mut ir.Value {
    let saved_blk = B.blk;
    let saved_before = B.before;
    let e = F.first;
    if u.notnil(e.first) {
        ir.at_before(B, e.first);
    } else {
        ir.at_end(B, e);
    }
    let a = ir.alloca(B, t, "agg");
    B.blk = saved_blk;
    B.before = saved_before;
    return a;
}

fn slot(v: *mut ir.Value) *mut ir.Value {
    return @ptr_cast(*mut ir.Value, v.auxp);
}

fn set_slot(v: *mut ir.Value, s: *mut ir.Value) void {
    v.auxp = @ptr_cast(*mut void, s);
}

// A read-only global holding constant c.
fn const_global(c: *mut ir.Value) *mut ir.Value {
    let k = u.addr_key(@int_from_ptr(c));
    let found = const_globals.get(k);
    if u.notnil(found) {
        return found;
    }
    let g = ir.add_global(M, c.ty, ".const");
    g.init = c;
    g.is_const = true;
    g.linkage = ir.LINK_INTERNAL;
    const_globals.put(k, g.val);
    return g.val;
}

// The address of aggregate value x (at the builder's position).
fn slot_of(x: *mut ir.Value) *mut ir.Value {
    let k = x.kind;
    if (k == ir.V_INST) or (k == ir.V_PARAM) {
        let s = slot(x);
        if u.isnil(s) {
            u.die(u.f1("internal compiler error: aggregate without a slot: %s", ir.val_str(x)));
        }
        return s;
    }
    if k == ir.V_UNDEF {
        return entry_alloca(x.ty);
    }
    return const_global(x);
}

fn memcpy(d: *mut ir.Value, s: *mut ir.Value, n: u64) void {
    if n == 0 {
        return;
    }
    _ = ir.memop(B, ir.OP_MEMCPY, d, s, isz(n));
}

// Stores constant c at address d.
fn store_const(c: *mut ir.Value, d: *mut ir.Value) void {
    let t = c.ty;
    if c.kind == ir.V_UNDEF {
        return;
    }
    if not ir.is_agg(t) {
        let st = ir.store(B, c, d);
        st.align = @int_cast(u32, t.align);
        return;
    }
    if ir.is_zero(c) {
        _ = ir.memop(B, ir.OP_MEMSET, d, ir.cint(ir.t_int(8), 0), isz(t.size));
        return;
    }
    let n = ir.field_count(t);
    if n > 16 {
        memcpy(d, const_global(c), t.size);
        return;
    }
    for i in 0..n {
        store_const(c.xs.get(i), ir.ptradd(B, d, isz(ir.field_off(t, i))));
    }
}

// Stores aggregate value x at address d.
fn store_agg(x: *mut ir.Value, d: *mut ir.Value) void {
    if ir.is_const(x) {
        store_const(x, d);
        return;
    }
    memcpy(d, slot_of(x), x.ty.size);
}

fn field_const(c: *mut ir.Value, i: usize) *mut ir.Value {
    let ft = ir.field_ty(c.ty, i);
    if c.kind == ir.V_CAGG {
        return c.xs.get(i);
    }
    if c.kind == ir.V_ZERO {
        return ir.czero(ft);
    }
    return ir.undef(ft);
}

// Use counts (not ir.count_uses, which counts only the uses of instructions
// and notes the user: this counts every operand that is not nil, constants
// and parameters too, and only instructions are reset).
fn count_uses(f: *mut ir.Func) void {
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            i.uses = 0;
            i = i.next;
        }
        b = b.next;
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let ops: [3]*mut ir.Value = [i.a, i.b, i.c];
            for o in ops {
                if u.notnil(o) {
                    o.uses += 1;
                }
            }
            for k in 0..i.xs.len {
                i.xs.get(k).uses += 1;
            }
            i = i.next;
        }
        b = b.next;
    }
}

fn lower_call(v: *mut ir.Value) void {
    let old = ir.fty_of(v);
    let nt = lower_fty(old);
    if nt == old {
        return;
    }
    let sret = ir.is_agg(old.ret);
    let n = v.xs.len;
    let mut args = u.List.[*mut ir.Value].empty();
    let ext = u.newn.[u8](nt.params.len + 3);
    let mut k: usize = 1;
    if sret {
        let s = entry_alloca(old.ret);
        args.push(s);
        ext[1] = ir.EXT_SRET;
        set_slot(v, s);
        v.aux2 = 1;
        k = 2;
    }
    let mut l = Leaves.{ tys: [ir.t_void(); 4], offs: [0; 4], n: 0 };
    for i in 0..n {
        let x = v.xs.get(i);
        if split(x.ty, &mut l) {
            let s = slot_of(x);
            for j in 0..l.n {
                let ld = ir.load(B, l.tys[j], ir.ptradd(B, s, isz(l.offs[j])));
                ld.align = @int_cast(u32, l.tys[j].align);
                args.push(ld);
                k += 1;
            }
            continue;
        }
        if ir.is_agg(x.ty) {
            args.push(slot_of(x));
            ext[k] = ir.EXT_BYVAL;
        } else {
            args.push(x);
            if (i + 1) < ir.ext_of(v).len {
                ext[k] = ir.ext_of(v)[i + 1];
            }
        }
        k += 1;
    }
    v.xs = args;
    ir.set_ext(v, ext[0..k]);
    ir.set_fty(v, nt);
    if sret {
        sret_calls.push(v);  // typed void once every use is lowered
    }
}

fn lower_body(f: *mut ir.Func) void {
    F = f;
    count_uses(f);
    // aggregate parameters passed as leaves: stored into a slot on entry
    let mut lp = Leaves.{ tys: [ir.t_void(); 4], offs: [0; 4], n: 0 };
    for i in 0..f.split.len {
        let p = f.split.get(i);
        _ = split(p.ty, &mut lp);
        let lv = @slice_from_ptr(@ptr_cast(*mut *mut ir.Value, p.auxp), MAX_LEAVES);
        let s = entry_alloca(p.ty);
        ir.at_before(B, s.next);
        for j in 0..lp.n {
            let st = ir.store(B, lv[j], ir.ptradd(B, s, isz(lp.offs[j])));
            st.align = @int_cast(u32, lp.tys[j].align);
        }
        set_slot(p, s);
    }
    let mut phis = u.List.[*mut ir.Value].empty();
    // aggregate phis get their slots first (their inputs may come later)
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) and (i.op == ir.OP_PHI) {
            if ir.is_agg(i.ty) {
                set_slot(i, entry_alloca(i.ty));
                i.aux2 = 1;
                phis.push(i);
            }
            i = i.next;
        }
        b = b.next;
    }
    let mut sret_p = vnil();
    if f.sret {
        sret_p = f.params[0];
    }
    b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            ir.at_before(B, i);
            let op = i.op;
            if (op == ir.OP_LOAD) and ir.is_agg(i.ty) {
                let s = entry_alloca(i.ty);
                memcpy(s, i.a, i.ty.size);
                set_slot(i, s);
                i.aux2 = 1;
                ir.remove_inst(i);
            } else if (op == ir.OP_STORE) and ir.is_agg(i.a.ty) {
                store_agg(i.a, i.b);
                ir.remove_inst(i);
            } else if op == ir.OP_INSERTVALUE {
                let base = i.a;
                let mut s = vnil();
                if base.kind == ir.V_UNDEF {
                    s = entry_alloca(i.ty);
                } else if (base.kind == ir.V_INST) and (base.uses == 1) and (base.aux2 == 1) {
                    s = slot(base);  // the only use: build in place
                } else if ir.is_const(base) {
                    s = entry_alloca(i.ty);
                    store_const(base, s);
                } else {
                    s = entry_alloca(i.ty);
                    memcpy(s, slot_of(base), i.ty.size);
                }
                let fi = @truncate(usize, i.cv);
                let ft = ir.field_ty(i.ty, fi);
                let d = ir.ptradd(B, s, isz(ir.field_off(i.ty, fi)));
                if ir.is_agg(ft) {
                    store_agg(i.b, d);
                } else {
                    let st = ir.store(B, i.b, d);
                    st.align = @int_cast(u32, ft.align);
                }
                set_slot(i, s);
                i.aux2 = 1;
                ir.remove_inst(i);
            } else if op == ir.OP_EXTRACTVALUE {
                let a = i.a;
                let fi = @truncate(usize, i.cv);
                if ir.is_const(a) {
                    let c = field_const(a, fi);
                    if ir.is_agg(i.ty) {
                        set_slot(i, slot_of(c));
                    } else {
                        ir.forward(i, c);
                    }
                } else {
                    let p = ir.ptradd(B, slot_of(a), isz(ir.field_off(a.ty, fi)));
                    if ir.is_agg(i.ty) {
                        set_slot(i, p);
                    } else {
                        let l = ir.load(B, i.ty, p);
                        ir.forward(i, l);
                    }
                }
                ir.remove_inst(i);
            } else if (op == ir.OP_SELECT) and ir.is_agg(i.ty) {
                set_slot(i, ir.select(B, i.a, slot_of(i.b), slot_of(i.c)));
                ir.remove_inst(i);
            } else if op == ir.OP_CALL {
                lower_call(i);
            } else if (op == ir.OP_RET) and u.notnil(i.a) and ir.is_agg(i.a.ty) {
                store_agg(i.a, sret_p);
                i.a = vnil();
            }
            i = next;
        }
        b = b.next;
    }
    // phi copies at the end of each predecessor
    for k in 0..phis.len {
        let p = phis.get(k);
        for j in 0..p.xs.len {
            let pred = ir.bs_of(p).get(j);
            ir.at_before(B, ir.terminator(pred));
            store_agg(p.xs.get(j), slot(p));
        }
        ir.remove_inst(p);
    }
    phis.deinit();
    for k in 0..sret_calls.len {
        sret_calls.get(k).ty = ir.t_void();
    }
    sret_calls.clear();
    ir.apply_forwarding(f);
}

pub fn lower_module(m: *mut ir.Module) void {
    M = m;
    B = ir.new_builder();
    let nf = m.funcs.len;
    for i in 0..nf {
        lower_sig(m.funcs.get(i));
    }
    for i in 0..nf {
        let f = m.funcs.get(i);
        if not ir.is_decl(f) {
            lower_body(f);
        }
    }
}

// -----------------------------------------------------------------------------
// Vector legalization: vector instructions the target cannot select become
// lane-by-lane scalar code (extract, scalar operation, insert).
// -----------------------------------------------------------------------------
fn lane_of(x: *mut ir.Value, i: u64) *mut ir.Value {
    if ir.is_op(x, ir.OP_SPLAT) {
        return x.a;
    }
    if x.kind == ir.V_CAGG {
        return x.xs.get(@truncate(usize, i));
    }
    if x.kind == ir.V_ZERO {
        return ir.czero(x.ty.elem);
    }
    return ir.extract_elem(B, x, i);
}

fn scalarize_one(v: *mut ir.Value) void {
    ir.at_before(B, v);
    let o = v.op;
    let mut vt = v.ty;
    if (o == ir.OP_INTR) and (vt.kind != ir.T_VEC) {
        vt = v.xs.get(0).ty;
    }
    let n = @as(u64, @bit_cast(u32, vt.lanes));
    let id = ir.intr_id(v);
    if id == ir.IN_ALLTRUE {
        let x = v.xs.get(0);
        let mut acc = ir.cint(ir.t_int(1), 1);
        for i in @as(u64, 0)..n {
            let l = lane_of(x, i);
            acc = ir.and_(B, acc, ir.icmp(B, ir.IntNE, l, ir.czero(l.ty)));
        }
        ir.forward(v, acc);
        ir.remove_inst(v);
        return;
    }
    let mut r = ir.undef(v.ty);
    for i in @as(u64, 0)..n {
        let mut s = vnil();
        if ir.is_binop(o) {
            s = ir.binop(B, o, lane_of(v.a, i), lane_of(v.b, i));
        } else if o == ir.OP_FNEG {
            s = ir.fneg(B, lane_of(v.a, i));
        } else if (o == ir.OP_ICMP) or (o == ir.OP_FCMP) {
            let p = ir.pred_of(v);
            let mut c = vnil();
            if o == ir.OP_ICMP {
                c = ir.icmp(B, p, lane_of(v.a, i), lane_of(v.b, i));
            } else {
                c = ir.fcmp(B, p, lane_of(v.a, i), lane_of(v.b, i));
            }
            s = ir.sext(B, c, v.ty.elem);
        } else if ir.is_cast(o) {
            s = ir.cast(B, o, lane_of(v.a, i), v.ty.elem);
        } else if o == ir.OP_INTR {
            let args = u.newn.[*mut ir.Value](v.xs.len + 1);
            for k in 0..v.xs.len {
                args[k] = lane_of(v.xs.get(k), i);
            }
            s = ir.intr(B, id, v.ty.elem, args[0..v.xs.len]);
        } else if o == ir.OP_SELECT {
            s = ir.select(B, v.a, lane_of(v.b, i), lane_of(v.c, i));
        } else {
            u.die(u.f1("internal compiler error: cannot split vector instruction %s", ir.inst_str(v)));
        }
        r = ir.insert_elem(B, r, s, i);
    }
    ir.forward(v, r);
    ir.remove_inst(v);
}

pub fn scalarize(f: *mut ir.Func, legal: fn(*mut ir.Value) bool) void {
    B = ir.new_builder();
    F = f;
    let mut any = false;
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            let vecish = (i.ty.kind == ir.T_VEC) or
                         ((i.op == ir.OP_INTR) and (i.xs.len > 0) and (i.xs.get(0).ty.kind == ir.T_VEC)) or
                         ((i.op == ir.OP_ICMP) and (i.a.ty.kind == ir.T_VEC));
            if vecish and not legal(i) {
                scalarize_one(i);
                any = true;
            }
            i = next;
        }
        b = b.next;
    }
    if any {
        ir.apply_forwarding(f);
    }
}

// -----------------------------------------------------------------------------
// Multiplication overflow checks for targets without a wide multiply (wasm):
// the product divided back by one operand must give the other.
// -----------------------------------------------------------------------------
pub fn expand_mul_overflow(f: *mut ir.Func) void {
    if u.isnil(B) {
        B = ir.new_builder();
    }
    let mut any = false;
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            let next = i.next;
            if i.op == ir.OP_INTR {
                let id = ir.intr_id(i);
                if (id == ir.IN_UMUL_OV) or (id == ir.IN_SMUL_OV) {
                    ir.at_before(B, i);
                    ir.forward(i, mul_overflow(id == ir.IN_SMUL_OV, i.xs.get(0), i.xs.get(1)));
                    ir.remove_inst(i);
                    any = true;
                }
            }
            i = next;
        }
        b = b.next;
    }
    if any {
        ir.apply_forwarding(f);
    }
}

fn mul_overflow(is_signed: bool, l: *mut ir.Value, r: *mut ir.Value) *mut ir.Value {
    let t = l.ty;
    let zero = ir.czero(t);
    let one = ir.cint(t, 1);
    let prod = ir.mul(B, l, r);
    let lz = ir.icmp(B, ir.IntEQ, l, zero);
    if not is_signed {
        let div = ir.select(B, lz, one, l);
        let back = ir.binop(B, ir.OP_UDIV, prod, div);
        let ne = ir.icmp(B, ir.IntNE, back, r);
        return ir.and_(B, ir.not_(B, lz), ne);
    }
    let lm1 = ir.icmp(B, ir.IntEQ, l, ir.cones(t));
    let safe = ir.or_(B, lz, lm1);
    let div = ir.select(B, safe, one, l);
    let back = ir.binop(B, ir.OP_SDIV, prod, div);
    let ne = ir.icmp(B, ir.IntNE, back, r);
    let general = ir.and_(B, ir.not_(B, safe), ne);
    let min = ir.cint(t, @as(u64, 1) << @int_cast(u32, t.bits - 1));
    let m1case = ir.and_(B, lm1, ir.icmp(B, ir.IntEQ, r, min));
    return ir.or_(B, general, m1case);
}
