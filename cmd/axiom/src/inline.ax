// =============================================================================
// inline.ax - function inlining over the module's call graph.
//
// Functions are visited bottom-up (callees before callers, by strongly
// connected components of the call graph), so a callee is already inlined
// into and simplified when its cost is measured. A direct call is inlined
// when the callee is small, or internal with a single call site. Calls in
// recursion (a callee in the caller's strongly connected component, or one
// that is recursive itself) are inlined under the rules at `want` that keep
// the expansion bounded. Internal functions nothing refers to any more are
// deleted.
//
// The shadow stack records (stack traces) are explicit stores around each
// call in the IR, so inlining keeps traces the same.
// =============================================================================
import "copies.ax" as copies;
import "dbginfo.ax" as dbi;
import "ir.ax" as ir;
import "target.ax" as tg;
import "util.ax" as u;

fn vnil() *mut ir.Value {
    return u.nil.[ir.Value]();
}

// Cost limits (in instructions).
const SMALL: i32 = 30;          // always worth inlining
const ONE_CALLER: i32 = 1200;   // an internal function called once
const CALLER_MAX: i32 = 20000;  // stop growing a caller beyond this
const TAIL_MAX: i32 = 120;      // a callee called in tail position, from one place
const COLD_SMALL: i32 = 8;      // what is inlined into a cold block (about a call's own cost)
// What inlining recursive callees (see `want`) may add to a caller, beyond
// its cost when its inlining began, unless the callee has no other caller.
const RECURSIVE_GROWTH: i32 = 240;
// A callee whose stack slots take more than this is not inlined into a
// recursive function, where every level of the recursion would pay for them
// (as LLVM's limit for recursive callers).
const RECURSIVE_FRAME_MAX: i64 = 1024;
// Nor is one whose stack slots and the caller's would together take more
// than a function's own locals may (1 GiB, codegen.ax: E0473): the backends'
// frames must stay well within 32-bit offsets.
const INLINED_FRAME_MAX: i64 = 0x4000_0000;

pub fn callee_of(i: *ir.Value) *mut ir.Func {
    return ir.direct_callee(i);
}

// The size of f in instructions (phis, branches, constant offsets and constant work are cheap;
// trap paths are out of the way).
pub fn cost(f: *ir.Func) i32 {
    let mut n: i32 = 0;
    let mut b = f.first;
    while u.notnil(b) {
        let t = ir.terminator(b);
        if u.notnil(t) and (t.op == ir.OP_UNREACHABLE) and (b != f.first) {
            n += 1;
            b = b.next;
            continue;
        }
        let mut i = b.first;
        while u.notnil(i) {
            let op = i.op;
            if (op == ir.OP_PHI) or (op == ir.OP_BR) or (op == ir.OP_UNREACHABLE) or (op == ir.OP_ALLOCA) {
                // free
            } else if (op == ir.OP_PTRADD) and ir.is_const(i.b) {
                // free: an address a constant past another, which loads and
                // stores take as their displacement (a struct's fields)
            } else if op == ir.OP_CALL {
                n += 3 + @int_cast(i32, i.xs.len);
            } else {
                n += 1;
            }
            i = i.next;
        }
        b = b.next;
    }
    return n;
}

fn inlinable(g: *mut ir.Func) bool {
    if ir.is_decl(g) or g.noinline or g.cold or g.ty.vararg {
        return false;
    }
    if (g.linkage == ir.LINK_WEAK) or (g.linkage == ir.LINK_EXTWEAK) {
        return false;
    }
    // no branches back to the entry, no thread stack switches
    let mut b = g.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if (ir.intr_id(i) == ir.IN_SET_SP) or ir.is_dyn_stack(ir.intr_id(i)) {
                return false;  // (or dynamic allocations, which would last until the caller returns)
            }
            if not ir.can_copy(i) {
                return false;  // (inline assembly that defines symbols: one copy of it)
            }
            if ir.is_term(i.op) {
                for k in 0..ir.succ_count(i) {
                    if ir.succ(i, k) == g.first {
                        return false;
                    }
                }
            }
            i = i.next;
        }
        b = b.next;
    }
    return true;
}

// -----------------------------------------------------------------------------
// Inlining one call
// -----------------------------------------------------------------------------
fn map_val(g: *mut ir.Func, v: *mut ir.Value, args: *u.List.[*mut ir.Value]) *mut ir.Value {
    if u.isnil(v) {
        return v;
    }
    if v.kind == ir.V_INST {
        return @ptr_cast(*mut ir.Value, v.auxp);
    }
    if (v.kind == ir.V_PARAM) and (ir.fnp_of(v) == g) {
        return args.get(@truncate(usize, v.cv));
    }
    return v;
}

fn map_blk(b: *mut ir.Block) *mut ir.Block {
    if u.isnil(b) {
        return b;
    }
    return @ptr_cast(*mut ir.Block, b.auxp);
}

// The chain (see `want`) inline_call gives the calls it copies, in their
// aux2.
let mut clone_chain: i64 = 0;

// The scopes of the code inline_call copies (with debug information): the
// inline instance's root, the callee's root, and the copies made of the
// callee's other scopes (by scope + 1).
struct InlScopes {
    root: u32,
    groot: u32,
    memo: u.U64Map,  // (by scope + 1: no string is made for it)
}

// The copy of callee scope s in the inline instance (dbginfo.ax: copy_scope).
fn scope_copy(m: *mut InlScopes, s: u32) u32 {
    if (s == 0) or (s == m.groot) or (@as(usize, s) >= dbi.scopes.len) {
        return m.root;
    }
    let k = @as(u64, s) + 1;
    let at = @truncate(u32, m.memo.get(k));
    if at != 0 {
        return at;
    }
    let p = scope_copy(m, dbi.scopes.get(@as(usize, s)).parent);
    let c = dbi.copy_scope(s, p);
    m.memo.put(k, @as(u64, c));
    return c;
}

// C's restrict parameters (ir.F_NOALIAS) hold while g's body runs, which
// its copy in f does not tell: with one or more, the call becomes a scope
// of its own (ir.IN_RSCOPE before it, in the scope the call is tagged
// with), and the arguments for them are the values of restricted pointers
// of it (ir.IN_RESTRICT), numbered as the parameters are: in g every use of
// such a parameter is its value, and the copy's loads, stores and calls are
// tagged with the scope (inline_call). Returns the scope, or nil.
fn restrict_scope(g: *mut ir.Func, c: *mut ir.Value, args: *mut u.List.[*mut ir.Value]) *mut ir.Value {
    let mut n: usize = 0;
    for k in 0..@min(g.params.len, args.len) {
        if ((g.params[k].flags & ir.F_NOALIAS) != 0) and (args.get(k).ty.kind == ir.T_PTR) {
            n += 1;
        }
    }
    if n == 0 {
        return u.nil.[ir.Value]();
    }
    let bd = ir.new_builder();
    ir.at_before(bd, c);
    let none = u.newn.[*mut ir.Value](1);
    let outer = ir.tag_of(c);
    let mut ps = none[0..0];
    if u.notnil(outer) {
        none[0] = outer;
        ps = none[0..1];
    }
    let t = ir.intr(bd, ir.IN_RSCOPE, ir.t_int(32), ps);
    for k in 0..@min(g.params.len, args.len) {
        let a = args.get(k);
        if ((g.params[k].flags & ir.F_NOALIAS) != 0) and (a.ty.kind == ir.T_PTR) {
            let mut xs: [3]*mut ir.Value = [a, t, ir.cint(ir.t_int(64), @as(u64, k))];
            args.set(k, ir.intr(bd, ir.IN_RESTRICT, a.ty, xs[..]));
        }
    }
    return t;
}

// Inlines call c (in f) of g.
pub fn inline_call(f: *mut ir.Func, c: *mut ir.Value) void {
    let g = ir.fnp_of(c.a);
    if g.strict_fp {
        f.strict_fp = true;  // (its floating operations stay strict in f)
    }
    let b = c.blk;
    let mut args = u.List.[*mut ir.Value].empty();
    for k in 0..c.xs.len {
        args.push(ir.resolve(c.xs.get(k)));
    }
    let mut rs = restrict_scope(g, c, &mut args);
    if u.isnil(ir.tag_of(c)) and (g.rscopes or u.notnil(rs)) {
        // (the copy's scopes would not be in scopes of the caller's: its
        // objects alive during the call would not be in them, ir.IN_RSCOPE)
        ir.forget_lives(f, 0);
    }
    if u.isnil(rs) {
        rs = ir.tag_of(c);
    }
    if g.rscopes or u.notnil(rs) {
        f.rscopes = true;
    }
    // the continuation: everything after the call
    let cont = ir.append_block(f, "inl.cont");
    ir.move_block_after(cont, b);
    ir.move_rest(c, cont);
    let t = ir.terminator(cont);
    for k in 0..ir.succ_count(t) {
        ir.replace_phi_block(ir.succ(t, k), b, cont);
    }
    // clone the blocks, placed between b and cont
    let mut after = b;
    let mut gb = g.first;
    while u.notnil(gb) {
        let nb = ir.append_block(f, gb.name);
        ir.move_block_after(nb, after);
        after = nb;
        gb.auxp = @ptr_cast(*mut void, nb);
        gb = gb.next;
    }
    let entry = f.first;
    let mut clones = u.List.[*mut ir.Value].empty();
    let mut origs = u.List.[*mut ir.Value].empty();
    // (debug information: the copied code is an inline instance of g, at c)
    let mut isc = InlScopes.{ root: 0, groot: 0, memo: u.U64Map.empty() };
    if ir.dbg_scopes {
        isc.root = dbi.add_inline(g.name, g.src, c.scope, c.src);
        isc.groot = dbi.scopes_of(g.name)[0];
    }
    gb = g.first;
    while u.notnil(gb) {
        let nb = map_blk(gb);
        let mut x = gb.first;
        while u.notnil(x) {
            let y = ir.copy_inst(f, x);
            if ir.dbg_scopes {
                y.scope = scope_copy(&mut isc, x.scope);
            }
            if x.op == ir.OP_CALL {
                // the inlined call's records follow those of its code's calls
                ir.set_chain(y, ir.chain_cat(ir.chain_of(x), ir.chain_of(c)));
                y.aux2 = clone_chain;
            }
            x.auxp = @ptr_cast(*mut void, y);
            if x.op == ir.OP_ALLOCA {
                // static stack slots: all allocas live in the entry block
                if u.notnil(entry.first) {
                    ir.insert_before(entry.first, y);
                } else {
                    ir.append_inst(entry, y);
                }
            } else {
                ir.append_inst(nb, y);
            }
            clones.push(y);
            origs.push(x);
            x = x.next;
        }
        gb = gb.next;
    }
    if ir.dbg_on {
        inline_marks(f, g, &mut isc, &clones, &origs, &args);
    }
    isc.memo.deinit();
    // operands, and returns become branches to the continuation (a result
    // in registers, ir.EXT_REGS: their values, of each return in turn, in
    // regs, its blocks in regblocks)
    let mut rets = u.List.[*mut ir.Value].empty();
    let mut rblocks = u.List.[*mut ir.Block].empty();
    let mut regs = u.List.[*mut ir.Value].empty();
    let mut regblocks = u.List.[*mut ir.Block].empty();
    let nregs = regs_result(c);
    for k in 0..clones.len {
        let y = clones.get(k);
        ir.set_a(y, map_val(g, y.a, &args));
        ir.set_b(y, map_val(g, y.b, &args));
        ir.set_c(y, map_val(g, y.c, &args));
        for j in 0..y.xs.len {
            ir.set_x(y, j, map_val(g, y.xs.get(j), &args));
        }
        for j in 0..ir.bs_of(y).len {
            ir.bs_of(y).set(j, map_blk(ir.bs_of(y).get(j)));
        }
        y.t1 = map_blk(y.t1);
        y.t2 = map_blk(y.t2);
        if u.notnil(rs) and ir.has_tag_slot(y) and u.isnil(ir.tag_of(y)) {
            ir.set_tag(y, rs);  // (executed in the restrict scope)
        } else if u.notnil(rs) and ir.is_rscope(y) and u.isnil(ir.rscope_parent(y)) {
            ir.clear_x(y);
            ir.push_x(y, rs);
        }
        if y.op == ir.OP_RET {
            if u.notnil(y.a) {
                rets.push(y.a);
                rblocks.push(y.blk);
            }
            if nregs > 0 {
                regblocks.push(y.blk);
                for j in 0..nregs {
                    if j < y.xs.len {
                        regs.push(y.xs.get(j));
                    } else {
                        regs.push(vnil());  // (not reached: the marks differ)
                    }
                }
            }
            y.op = ir.OP_BR;
            ir.set_a(y, vnil());
            ir.clear_x(y);
            y.t1 = cont;
        }
    }
    // b continues into the inlined entry
    let br = ir.new_inst(f, ir.OP_BR, ir.t_void());
    br.t1 = map_blk(g.first);
    ir.remove_inst(c);
    ir.append_inst(b, br);
    if nregs > 0 {
        // the registers' values for the IN_CALL_RESULTs of c, which go
        let mut vals: [4]*mut ir.Value = [vnil(), vnil(), vnil(), vnil()];
        let mut b2 = f.first;
        while u.notnil(b2) {
            let mut x = b2.first;
            while u.notnil(x) {
                let nx = x.next;
                if (ir.intr_id(x) == ir.IN_CALL_RESULT) and (ir.resolve(x.xs.get(0)) == c) {
                    let k = @truncate(usize, ir.cint_val(x.xs.get(1)));
                    if (k < nregs) and u.isnil(vals[k]) {
                        let mut js = u.List.[*mut ir.Value].empty();
                        for r in 0..regblocks.len {
                            let mut y = regs.get((r * nregs) + k);
                            if u.isnil(y) {
                                y = ir.undef(x.ty);
                            }
                            js.push(y);
                        }
                        vals[k] = merge(f, cont, x.ty, &js, &regblocks);
                        js.deinit();
                    }
                    if k < nregs {
                        ir.forward(x, vals[k]);
                    } else {
                        ir.forward(x, ir.undef(x.ty));
                    }
                    ir.remove_inst(x);
                }
                x = nx;
            }
            b2 = b2.next;
        }
    }
    if c.ty.kind != ir.T_VOID {
        ir.forward(c, merge(f, cont, c.ty, &rets, &rblocks));
    }
    // g's locals copied whole into memory the caller gave: built there
    // (copies.forward_inlined: each a fresh object at the inlined entry)
    let mut nbs = u.List.[*mut ir.Block].empty();
    let mut slots = u.List.[*mut ir.Value].empty();
    gb = g.first;
    while u.notnil(gb) {
        nbs.push(map_blk(gb));
        gb = gb.next;
    }
    for y in clones.items() {
        if y.op == ir.OP_ALLOCA {
            slots.push(y);
        }
    }
    if slots.len > 0 {
        // (what g returns is used after it: rets and regs)
        let mut outs = u.List.[*mut ir.Value].empty();
        for x in rets.items() {
            outs.push(x);
        }
        for x in regs.items() {
            if u.notnil(x) {
                outs.push(x);
            }
        }
        _ = copies.forward_inlined(f, g, map_blk(g.first), &nbs, &slots, &outs);
        outs.deinit();
    }
    // (f's code now has g's: C's rules hold of it only if they hold of both)
    f.c_races = f.c_races and g.c_races;
    f.c_progress = f.c_progress and g.c_progress;
    nbs.deinit();
    slots.deinit();
    args.deinit();
    clones.deinit();
    origs.deinit();
    rets.deinit();
    rblocks.deinit();
    regs.deinit();
    regblocks.deinit();
}

// The assignments of variables in the code inline_call copied (clones, of
// origs; -g, optimized): the copies of the marks (ir.copy_inst made kills
// of them) give the copies of the values of g's (a parameter: the call's
// argument), and are of variables of the inline instance (DbgMark.inst):
// g's own of its root, those of functions inlined into g before of the
// copies of their instances. The objects of g's variables (allocas not
// promoted yet) are of the instance too.
fn inline_marks(f: *mut ir.Func, g: *mut ir.Func, isc: *mut InlScopes, clones: *u.List.[*mut ir.Value],
                origs: *u.List.[*mut ir.Value], args: *u.List.[*mut ir.Value]) void {
    for j in 0..clones.len {
        let y = clones.get(j);
        let x = origs.get(j);
        if x.op == ir.OP_ALLOCA {
            let ds = ir.dbg_slot_of(x);
            if ds >= 0 {
                let sl = ir.dbg_slots.get(@int_cast(usize, ds));
                let mut inst = isc.root;
                if sl.inst != 0 {
                    inst = scope_copy(isc, sl.inst);
                } else if sl.owner != g {
                    continue;
                }
                if inst != 0 {
                    ir.dbg_slot_note(y, sl.owner, sl.var, sl.off, sl.size, inst);
                }
            }
        }
        let mut k = ir.dbg_marks_at(y);
        while k >= 0 {
            let src = ir.dbg_mark_src(k);
            let nx = ir.dbg_mark_next(k);
            if src >= 0 {
                let m = ir.dbg_marks.get(@int_cast(usize, src));
                let mut inst = isc.root;
                if m.inst != 0 {
                    inst = scope_copy(isc, m.inst);
                } else if m.owner != g {
                    inst = 0;
                }
                if inst != 0 {
                    ir.dbg_mark_set_inst(k, inst);
                    let v = ir.dbg_mark_value(src);
                    let mut w = vnil();
                    if u.notnil(v) and (v.kind == ir.V_INST) {
                        if u.notnil(v.blk) and (v.blk.fnp == g) {
                            w = map_val(g, v, args);
                        }
                    } else if u.notnil(v) and (v.kind == ir.V_PARAM) {
                        if ir.fnp_of(v) == g {
                            w = map_val(g, v, args);
                        }
                    } else if u.notnil(v) {
                        w = v;  // (a constant, a datum's address)
                    }
                    if u.notnil(w) {
                        ir.dbg_mark_set(k, w, ir.dbg_mark_low(src), ir.dbg_mark_add(src));
                    }
                }
            }
            k = nx;
        }
    }
}

// The number of registers of call c's result, when it is in registers
// (ir.EXT_REGS), else 0.
fn regs_result(c: *ir.Value) usize {
    let ex = ir.ext_of(c);
    if (ex.len == 0) or (ex[0] < ir.EXT_REGS) {
        return 0;
    }
    return @as(usize, ex[0] & 3) + 1;
}

// The value (of type t) that returns vs from blocks bs give at the start of
// cont: the one, a phi of them, or undefined when there is none.
fn merge(f: *mut ir.Func, cont: *mut ir.Block, t: *mut ir.Ty, vs: *u.List.[*mut ir.Value],
         bs: *u.List.[*mut ir.Block]) *mut ir.Value {
    if vs.len == 1 {
        return vs.get(0);
    }
    if vs.len == 0 {
        return ir.undef(t);
    }
    let p = ir.new_inst(f, ir.OP_PHI, t);
    for k in 0..vs.len {
        ir.add_incoming(p, vs.get(k), bs.get(k));
    }
    if u.notnil(cont.first) {
        ir.insert_before(cont.first, p);
    } else {
        ir.append_inst(cont, p);
    }
    return p;
}

// -----------------------------------------------------------------------------
// Call graph
// -----------------------------------------------------------------------------
struct Node {
    f: *mut ir.Func,
    callees: u.List.[i32],
    index: i32,
    low: i32,
    on_stack: bool,
    scc: i32,
    calls: i32,  // direct call sites in the module
    live: i32,   // the same, kept exact as functions change (retire); `calls` is what `want` reckons with
    retired: bool,
    addr_taken: bool,
    cost: i32,         // cost(f), or -1: not known (f changed since)
    inlinable: i8,     // inlinable(f): 1 or 0, or -1: not known
    frame: i64,        // frame_bytes(f), or -1: not known
    recursive: bool,   // calls itself, directly or not
    selfcall: i8,      // its function has a direct call to itself: 1 or 0, or -1: not known
    cycle_calls: i32,  // its direct calls of functions of its component (node_selfcall)
}

let mut nodes: u.List.[*mut Node] = u.List.[*mut Node].{ data: @ptr_from_int(*mut *mut Node, 0), len: 0, cap: 0 };

fn node_of(f: *ir.Func) *mut Node {
    return nodes.get(@int_cast(usize, f.aux));
}

// Could v be or hold a function's address?
fn may_ref(v: *ir.Value) bool {
    return u.notnil(v) and ((v.kind == ir.V_FUNC) or (v.kind == ir.V_CAGG));
}

fn note_ref(v: *mut ir.Value) void {
    if u.notnil(v) and (v.kind == ir.V_FUNC) {
        node_of(ir.fnp_of(v)).addr_taken = true;
    } else if u.notnil(v) and (v.kind == ir.V_CAGG) {
        for k in 0..v.xs.len {
            note_ref(v.xs.get(k));
        }
    }
}

// The functions whose addresses global initializers hold. Initializers do
// not change and globals are only added, so each global is looked at once
// (string literals make for many large constants).
let mut gref_mod: *mut ir.Module = @ptr_from_int(*mut ir.Module, 0);
let mut gref_n: usize = 0;
let mut gref_fns: u.List.[*mut ir.Func] = u.List.[*mut ir.Func].{ data: @ptr_from_int(*mut *mut ir.Func, 0), len: 0,
                                                                  cap: 0 };

fn collect_fns(v: *mut ir.Value) void {
    if v.kind == ir.V_FUNC {
        gref_fns.push(ir.fnp_of(v));
    } else if v.kind == ir.V_CAGG {
        for k in 0..v.xs.len {
            collect_fns(v.xs.get(k));
        }
    }
}

fn global_refs(m: *mut ir.Module) void {
    if gref_mod != m {
        gref_mod = m;
        gref_n = 0;
        gref_fns.clear();
    }
    for i in gref_n..m.globals.len {
        let g = m.globals.get(i);
        if u.notnil(g.init) {
            collect_fns(g.init);
        }
    }
    gref_n = m.globals.len;
    for i in 0..gref_fns.len {
        node_of(gref_fns.get(i)).addr_taken = true;
    }
    // (an alias's target is its symbol too: ir.Alias, kept whatever calls it)
    for a in m.aliases.items() {
        if a.target.kind == ir.V_FUNC {
            node_of(ir.fnp_of(a.target)).addr_taken = true;
        }
    }
}

// The bytes of f's stack slots (allocas).
fn frame_bytes(f: *ir.Func) i64 {
    let mut n: i64 = 0;
    let mut b = f.first;
    while u.notnil(b) {
        let mut i = b.first;
        while u.notnil(i) {
            if i.op == ir.OP_ALLOCA {
                n += @bit_cast(i64, ir.aty_of(i).size);
            }
            i = i.next;
        }
        b = b.next;
    }
    return n;
}

fn node_frame(n: *mut Node) i64 {
    if n.frame < 0 {
        n.frame = frame_bytes(n.f);
    }
    return n.frame;
}

fn node_cost(n: *mut Node) i32 {
    if n.cost < 0 {
        n.cost = cost(n.f);
    }
    return n.cost;
}

fn node_inlinable(n: *mut Node) bool {
    if n.inlinable < 0 {
        n.inlinable = 0;
        if inlinable(n.f) {
            n.inlinable = 1;
        }
    }
    return n.inlinable == 1;
}

// Does n's function call itself directly? (And its calls of functions of
// its own component, in n.cycle_calls.)
fn node_selfcall(n: *mut Node) bool {
    if n.selfcall < 0 {
        n.selfcall = 0;
        n.cycle_calls = 0;
        let mut b = n.f.first;
        while u.notnil(b) {
            let mut x = b.first;
            while u.notnil(x) {
                let h = callee_of(x);
                if u.notnil(h) and (node_of(h).scc == n.scc) {
                    n.cycle_calls += 1;
                    if h == n.f {
                        n.selfcall = 1;
                    }
                }
                x = x.next;
            }
            b = b.next;
        }
    }
    return n.selfcall == 1;
}

// Inlining chains: chain 0 is empty; chain k > 0 is function ch_node[k] (a
// node index) followed by chain ch_parent[k]. A call that inlining brought
// into the caller has in aux2 the chain of the functions whose inlined bodies
// it came from, innermost first (0 for the caller's own calls).
let mut ch_node: u.List.[i32] = u.List.[i32].{ data: @ptr_from_int(*mut i32, 0), len: 0, cap: 0 };
let mut ch_parent: u.List.[i64] = u.List.[i64].{ data: @ptr_from_int(*mut i64, 0), len: 0, cap: 0 };

fn on_chain(chain: i64, g: i32) bool {
    let mut k = chain;
    while k > 0 {
        let i = @truncate(usize, @bit_cast(u64, k));
        if ch_node.get(i) == g {
            return true;
        }
        k = ch_parent.get(i);
    }
    return false;
}

fn build_graph(m: *mut ir.Module) void {
    nodes.clear();
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        f.aux = @int_cast(i64, i);
        let n = u.new.[Node]();
        n.f = f;
        n.index = -1;
        n.cost = -1;
        n.inlinable = -1;
        n.frame = -1;
        n.selfcall = -1;
        nodes.push(n);
    }
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        let n = nodes.get(i);
        let mut b = f.first;
        while u.notnil(b) {
            let mut x = b.first;
            while u.notnil(x) {
                let g = callee_of(x);
                if u.notnil(g) {
                    n.callees.push(@int_cast(i32, g.aux));
                    node_of(g).calls += 1;
                    node_of(g).live += 1;
                } else if may_ref(x.a) {
                    note_ref(x.a);
                }
                if may_ref(x.b) {
                    note_ref(x.b);
                }
                if may_ref(x.c) {
                    note_ref(x.c);
                }
                for k in 0..x.xs.len {
                    let o = x.xs.get(k);
                    if may_ref(o) {
                        note_ref(o);
                    }
                }
                x = x.next;
            }
            b = b.next;
        }
    }
    global_refs(m);
}

// Tarjan's algorithm, iteratively; `order` receives the functions callees
// first, and each node its component number.
fn sccs(order: *mut u.List.[*mut Node]) void {
    let mut index: i32 = 0;
    let mut nscc: i32 = 0;
    let mut stack = u.List.[*mut Node].empty();
    let mut cs = u.List.[*mut Node].empty();  // call stack
    let mut ci = u.List.[usize].empty();
    for r in 0..nodes.len {
        let root = nodes.get(r);
        if root.index >= 0 {
            continue;
        }
        root.index = index;
        root.low = index;
        index += 1;
        stack.push(root);
        root.on_stack = true;
        cs.push(root);
        ci.push(0);
        while cs.len > 0 {
            let v = cs.last();
            let k = ci.last();
            if k < v.callees.len {
                ci.set(ci.len - 1, k + 1);
                let w = nodes.get(@int_cast(usize, v.callees.get(k)));
                if w.index < 0 {
                    w.index = index;
                    w.low = index;
                    index += 1;
                    stack.push(w);
                    w.on_stack = true;
                    cs.push(w);
                    ci.push(0);
                } else if w.on_stack and (w.index < v.low) {
                    v.low = w.index;
                }
            } else {
                _ = cs.pop();
                _ = ci.pop();
                if cs.len > 0 {
                    let p = cs.last();
                    if v.low < p.low {
                        p.low = v.low;
                    }
                }
                if v.low == v.index {
                    loop {
                        let w = stack.pop();
                        w.on_stack = false;
                        w.scc = nscc;
                        order.push(w);
                        if w == v {
                            break;
                        }
                    }
                    nscc += 1;
                }
            }
        }
    }
    stack.deinit();
    cs.deinit();
    ci.deinit();
}

// Is c in tail position: its result (if any) returned straight away? Stores
// that do not involve the result (the shadow stack's pop) may come between.
fn tail_call(c: *mut ir.Value) bool {
    let mut v = c;  // the value that must be returned
    let mut from = c.blk;
    let mut n = c.next;
    let mut hops: i32 = 0;
    loop {
        while u.notnil(n) and (n.op == ir.OP_STORE) and (ir.resolve(n.a) != v) and (ir.resolve(n.b) != v) {
            n = n.next;
        }
        if u.isnil(n) {
            return false;
        }
        if n.op == ir.OP_RET {
            if u.isnil(n.a) {
                return c.ty.kind == ir.T_VOID;
            }
            return ir.resolve(n.a) == v;
        }
        if (n.op != ir.OP_BR) or u.isnil(n.t1) or (hops == 4) {
            return false;
        }
        hops += 1;
        let t = n.t1;
        let mut x = t.first;
        while u.notnil(x) and (x.op == ir.OP_PHI) {
            for j in 0..ir.bs_of(x).len {
                if (ir.bs_of(x).get(j) == from) and (ir.resolve(x.xs.get(j)) == v) {
                    v = x;
                }
            }
            x = x.next;
        }
        from = t;
        n = x;
    }
}

// Should call c (in f, whose current cost is fcost) be inlined? budget is
// what f's cost may grow to by inlining recursive callees.
//
// Recursion. A callee g is recursive for this when it is in f's strongly
// connected component (f reaches g and g reaches f) or recursive itself
// (it reaches itself). Inlining such a g copies calls that lead back to g,
// whose inlining would copy them again: unbounded, without these rules:
//   (1) a call whose chain (the functions whose inlined bodies brought it
//       into f, Node / ch_node) holds g is not inlined; the calls copied from
//       g's body get c's chain plus g;
//   (2) g in f's component is not inlined if it calls itself directly (its
//       copies would bring calls to g again; it is inlined once into the
//       callers outside the component instead), and f is never inlined into
//       itself; nor is g into a caller outside its component if it makes
//       more than one call into its component (a tree walk: a copy saves
//       one call and brings two, measured a loss);
//   (3) g is inlined only while f stays within budget (its cost when its
//       inlining began plus RECURSIVE_GROWTH), unless g is internal with no
//       other call site (no copy then: g dies) and within ONE_CALLER.
// Termination and bound: every inlining in f removes one call and adds g's
// copied calls, each with a chain one function longer than c's that holds g;
// by (1) the functions on a chain are distinct, so no chain is longer than
// the number of functions in the module (a recursive expansion is at most as
// deep as its cycle is long), and the rounds (inline_into) end within three
// anyway. The size is bounded by (3), whatever the fan-out of the
// recursion: the copies of recursive callees add at most RECURSIVE_GROWTH
// plus one callee's cost (each at most SMALL + the bonus), besides the
// bodies of callees with no other call site, which are not copied but
// moved (each exists once, and leaves the module), and of inline functions,
// which (1) inlines at most once per chain and which form no cycle among
// themselves (E0314), so that a chain of them ends. A self-recursive g is so
// expanded one level into an outside caller per inline_module run (the
// chains live only while one caller is inlined into), its own calls to
// itself staying calls: by (1) within the run, and the next run starts from
// a caller whose growth was bounded by (3).
fn want(n: *mut Node, c: *mut ir.Value, fcost: i32, budget: i32) bool {
    let g = callee_of(c);
    if u.isnil(g) or ir.is_decl(g) or (g == n.f) {
        return false;
    }
    let gn = node_of(g);
    if not node_inlinable(gn) {
        return false;
    }
    let same = gn.scc == n.scc;
    let rec = same or gn.recursive;
    if rec and on_chain(c.aux2, @int_cast(i32, g.aux)) {
        return false;  // (1)
    }
    if same and node_selfcall(gn) {
        return false;  // (2)
    }
    if rec and not same {
        _ = node_selfcall(gn);
        if gn.cycle_calls > 1 {
            return false;  // (2)
        }
    }
    // (code compiled for extensions the caller is not compiled for stays in
    // its own function, behind the check that chose it)
    if (tg.fn_features(g) & ~tg.fn_features(n.f)) != 0 {
        return false;
    }
    // (a function with its own level below 2, C's attribute optimize, keeps
    // its calls and is not inlined)
    if ((g.opt_override > 0) and (g.opt_override < 3)) or ((n.f.opt_override > 0) and (n.f.opt_override < 3)) {
        return false;
    }
    // (an inline function is inlined whatever its size, spec §9.5; it
    // cannot call itself, nor be on a cycle of inline functions only, so
    // rule (1) bounds it)
    if g.always_inline {
        return true;
    }
    if n.recursive and (node_frame(gn) > RECURSIVE_FRAME_MAX) {
        return false;
    }
    if (node_frame(n) + node_frame(gn)) > INLINED_FRAME_MAX {
        return false;
    }
    let gc = node_cost(gn);
    let one = (g.linkage == ir.LINK_INTERNAL) and (gn.calls == 1) and not gn.addr_taken and (g.export_name.len == 0);
    if rec and not one and ((fcost + gc) > budget) {
        return false;  // (3)
    }
    // a call on a cold path (a block the front end marked cold: a call of
    // a cold function, the unlikely way of __builtin_expect; or one that
    // ends in `unreachable`, after a call that does not return) is worth
    // inlining only when that makes the code smaller
    let cold = u.notnil(c.blk) and (c.blk.cold or ir.is_op(ir.terminator(c.blk), ir.OP_UNREACHABLE));
    if cold and not one {
        return gc <= COLD_SMALL;
    }
    if gc <= SMALL {
        return true;
    }
    if fcost > CALLER_MAX {
        return false;
    }
    if one {
        // `return slow(x)` after a fast path: inlining saves only the call
        // but makes the caller's fast path pay for the callee's frame
        if tail_call(c) and (gc > TAIL_MAX) {
            return false;
        }
        return gc <= ONE_CALLER;
    }
    // constant arguments and addresses of the caller's stack slots enable
    // further simplification
    let mut bonus: i32 = 0;
    for k in 0..c.xs.len {
        let x = c.xs.get(k);
        if ir.is_const(x) or ir.is_op(x, ir.OP_ALLOCA) {
            bonus += 10;
        }
    }
    // (a caller or callee with the attribute hot: twice the size)
    if n.f.hot or g.hot {
        return gc <= ((2 * SMALL) + bonus);
    }
    return gc <= (SMALL + bonus);
}

// Inlines the chosen calls in f; true if any.
fn inline_into(n: *mut Node) bool {
    let f = n.f;
    let mut calls = u.List.[*mut ir.Value].empty();
    let mut fcost = cost(f);
    let budget = fcost + RECURSIVE_GROWTH;
    let mut any = false;
    ch_node.clear();
    ch_parent.clear();
    ch_node.push(-1);  // chain 0: empty
    ch_parent.push(0);
    // again over the calls that inlining brings in
    for round in @as(i32, 0)..3 {
        calls.clear();
        let mut b = f.first;
        while u.notnil(b) {
            let mut x = b.first;
            while u.notnil(x) {
                if u.notnil(callee_of(x)) {
                    if round == 0 {
                        x.aux2 = 0;  // f's own calls
                    }
                    calls.push(x);
                }
                x = x.next;
            }
            b = b.next;
        }
        let mut did = false;
        for k in 0..calls.len {
            let c = calls.get(k);
            if want(n, c, fcost, budget) {
                let g = callee_of(c);
                fcost += node_cost(node_of(g));
                n.frame = node_frame(n) + node_frame(node_of(g));
                node_of(g).calls -= 1;
                count_calls(g);
                clone_chain = @bit_cast(i64, @as(u64, ch_node.len));
                ch_node.push(@int_cast(i32, g.aux));
                ch_parent.push(c.aux2);
                inline_call(f, c);
                did = true;
            }
        }
        if not did {
            break;
        }
        any = true;
    }
    clone_chain = 0;
    calls.deinit();
    return any;
}

// The calls in g, copied by inlining it, are more calls of their callees.
fn count_calls(g: *mut ir.Func) void {
    let mut b = g.first;
    while u.notnil(b) {
        let mut x = b.first;
        while u.notnil(x) {
            let h = callee_of(x);
            if u.notnil(h) {
                node_of(h).calls += 1;
            }
            x = x.next;
        }
        b = b.next;
    }
}

// A node for function g, added to the module after the graph was built
// (a function's cold part, which is never inlined).
fn add_node(g: *mut ir.Func) void {
    let n = u.new.[Node]();
    n.f = g;
    n.index = -1;
    n.scc = -1 - @int_cast(i32, nodes.len);  // a component of its own
    n.cost = -1;
    n.inlinable = -1;
    n.frame = -1;
    n.selfcall = -1;
    n.calls = 1;
    g.aux = @int_cast(i64, nodes.len);
    nodes.push(n);
}

// Inlines over the module bottom-up; `simplify` runs on every function after
// its calls are inlined (and before its callers look at it). Then, if the
// function is no longer small, `split` may move an uncommon path that makes
// calls into a function of its own (returned, or nil), so that what is left
// is: inlining a lazy initialisation's check brings in the initialisation,
// which then should not make its callers' common path pay for it.
pub fn inline_module(
    m: *mut ir.Module, simplify: fn(*mut ir.Func) void, split: fn(*mut ir.Module, *mut ir.Func) *mut ir.Func) void {
    build_graph(m);
    let mut order = u.List.[*mut Node].empty();
    sccs(&mut order);
    for k in 0..order.len {
        let n = order.get(k);
        for j in 0..n.callees.len {
            if nodes.get(@int_cast(usize, n.callees.get(j))).scc == n.scc {
                n.recursive = true;
            }
        }
    }
    for k in 0..order.len {
        let n = order.get(k);
        if ir.is_decl(n.f) or n.f.returns_twice {
            continue;  // (a function that calls setjmp is not optimized: ir.Func)
        }
        if inline_into(n) {
            simplify(n.f);
            n.cost = -1;
            n.inlinable = -1;
            n.frame = -1;
            n.selfcall = -1;
            let mut g = u.nil.[ir.Func]();
            if node_cost(n) > SMALL {
                g = split(m, n.f);
                if u.notnil(g) {
                    add_node(g);
                    n.cost = -1;
                    n.inlinable = -1;
                    n.frame = -1;
                    n.selfcall = -1;
                }
            }
            retire(n, g);
        }
    }
    order.deinit();
    remove_dead(m);
}

// The functions whose bodies were given back before the end (retire).
let mut retired: u.List.[*mut ir.Func] = u.List.[*mut ir.Func].{ data: @ptr_from_int(*mut *mut ir.Func, 0), len: 0,
                                                                 cap: 0 };

// The direct calls in n's function, counted again (it changed).
fn recount(n: *mut Node) void {
    n.callees.clear();
    let mut b = n.f.first;
    while u.notnil(b) {
        let mut x = b.first;
        while u.notnil(x) {
            let h = callee_of(x);
            if u.notnil(h) {
                n.callees.push(@int_cast(i32, h.aux));
                node_of(h).live += 1;
            }
            x = x.next;
        }
        b = b.next;
    }
}

// Whether nothing can call or name n's function any more: internal, never
// used as a value, and with no direct call left.
fn unreachable(n: *Node) bool {
    let f = n.f;
    return not n.retired and (n.live <= 0) and not n.addr_taken and (f.linkage == ir.LINK_INTERNAL) and
           not ir.is_decl(f) and (f.export_name.len == 0);
}

// After n's function changed (calls inlined, simplified, its cold part g
// split off, or nil): the functions it called that nothing calls now give
// their bodies back at once, and so on down, for the inlining still to come
// to reuse (a function inlined into its only callers is otherwise garbage
// until the end, when remove_dead takes it out of the module). The count of
// each function's direct call sites (Node.live) is kept exact for this: a
// function's are counted again when it changes.
fn retire(n: *mut Node, g: *mut ir.Func) void {
    let mut work = u.List.[i32].empty();
    for k in 0..n.callees.len {
        let c = n.callees.get(k);
        nodes.get(@int_cast(usize, c)).live -= 1;
        work.push(c);
    }
    if u.notnil(g) {
        recount(node_of(g));
    }
    recount(n);
    while work.len > 0 {
        let x = nodes.get(@int_cast(usize, work.pop()));
        if (x == n) or not unreachable(x) {
            continue;
        }
        x.retired = true;
        retired.push(x.f);
        for k in 0..x.callees.len {
            let c = x.callees.get(k);
            nodes.get(@int_cast(usize, c)).live -= 1;
            work.push(c);
        }
        ir.drop_body(x.f);
    }
    work.deinit();
}

// Deletes internal functions that nothing refers to.
fn remove_dead(m: *mut ir.Module) void {
    build_graph(m);
    let mut kept = u.List.[*mut ir.Func].empty();
    let mut any = false;
    // functions only called by dead functions die too: iterate
    let mut dead = u.newn.[bool](m.funcs.len + 1);
    for k in 0..retired.len {
        dead[@int_cast(usize, retired.get(k).aux)] = true;  // (declarations now)
        any = true;
    }
    retired.clear();
    let mut changed = true;
    while changed {
        changed = false;
        for i in 0..m.funcs.len {
            let n = nodes.get(i);
            let f = n.f;
            if dead[i] or (f.linkage != ir.LINK_INTERNAL) or ir.is_decl(f) or n.addr_taken or (n.calls > 0) or
               (f.export_name.len > 0) {
                continue;
            }
            dead[i] = true;
            changed = true;
            for k in 0..n.callees.len {
                nodes.get(@int_cast(usize, n.callees.get(k))).calls -= 1;
            }
        }
    }
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if dead[i] {
            any = true;
            if not ir.is_decl(f) {
                ir.drop_body(f);
            }
            continue;
        }
        f.id = @int_cast(i32, kept.len);
        kept.push(f);
    }
    if any {
        m.funcs = kept;
    }
}

// -----------------------------------------------------------------------------
// Interprocedural constant propagation: a parameter of an internal function
// (not address-taken) that every call passes the same constant for is that
// constant. A function pointer argument (a comparison function passed to a
// sort, say) becomes a direct call, which can then be inlined.
// -----------------------------------------------------------------------------

// One constant: of one kind and type, with the same value (integers, floats
// by their bits; any zeros; globals and functions by what they name), or the
// same Value. Unlike opt.same_const, a zero or an address need not be one
// Value; unlike combine.same_const, a zero is not an integer 0.
fn same_const(a: *ir.Value, b: *ir.Value) bool {
    if a == b {
        return true;
    }
    if (a.kind != b.kind) or (a.ty != b.ty) {
        return false;
    }
    if a.kind == ir.V_CINT {
        return a.cv == b.cv;
    }
    if a.kind == ir.V_ZERO {
        return true;
    }
    if a.kind == ir.V_FUNC {
        return ir.fnp_of(a) == ir.fnp_of(b);
    }
    if a.kind == ir.V_GLOBAL {
        return ir.gv_of(a) == ir.gv_of(b);
    }
    if a.kind == ir.V_CFP {
        return @bit_cast(u64, ir.fv_of(a)) == @bit_cast(u64, ir.fv_of(b));
    }
    return false;
}

fn propagatable(v: *ir.Value) bool {
    let k = v.kind;
    return (k == ir.V_CINT) or (k == ir.V_ZERO) or (k == ir.V_FUNC) or (k == ir.V_GLOBAL) or (k == ir.V_CFP);
}

fn ipcp_eligible(f: *ir.Func, n: *Node) bool {
    if (f.opt_override > 0) and (f.opt_override < 3) {
        return false;  // (its own level below 2: C's attribute optimize)
    }
    return not (ir.is_decl(f) or (f.linkage != ir.LINK_INTERNAL) or n.addr_taken or (n.calls == 0) or
                (f.export_name.len > 0));
}

// Replaces constant parameters; returns the functions it changed.
//
// Each parameter has a lattice value: nil (no call seen yet), a constant, or
// the function's own val (varying). An argument that is the caller's own
// parameter carries that parameter's value, so a constant passed into a
// recursive function, or down a chain of calls (sort -> introsort ->
// heapsort -> sift_down), reaches all of them. Values only go down, so the
// iteration ends.
pub fn ipcp(m: *mut ir.Module) u.List.[*mut ir.Func] {
    let mut changed = u.List.[*mut ir.Func].empty();
    build_graph(m);
    let consts = u.newn.[[]mut *mut ir.Value](m.funcs.len + 1);
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        consts[i] = u.newn.[*mut ir.Value](f.params.len + 1);
        if not ipcp_eligible(f, nodes.get(i)) {
            // called from outside the module, or through a pointer
            for k in 0..f.params.len {
                consts[i][k] = f.val;
            }
        }
    }
    // the direct calls, by caller (the iteration changes no code)
    let mut calls = u.List.[*mut ir.Value].empty();
    let mut callers = u.List.[usize].empty();
    for i in 0..m.funcs.len {
        let mut b = m.funcs.get(i).first;
        while u.notnil(b) {
            let mut x = b.first;
            while u.notnil(x) {
                if u.notnil(callee_of(x)) {
                    calls.push(x);
                    callers.push(i);
                }
                x = x.next;
            }
            b = b.next;
        }
    }
    let mut again = true;
    while again {
        again = false;
        for ci in 0..calls.len {
            let x = calls.get(ci);
            let i = callers.get(ci);
            let h = m.funcs.get(i);
            let hcs = consts[i];
            let g = callee_of(x);
            let cs = consts[@int_cast(usize, g.aux)];
            for k in 0..g.params.len {
                if cs[k] == g.val {
                    continue;
                }
                let mut a = g.val;
                if x.xs.len == g.params.len {
                    a = ir.resolve(x.xs.get(k));
                    // (cv is the parameter's index only for a parameter)
                    let mut pi = h.params.len;
                    if (a.kind == ir.V_PARAM) and (a.cv < @as(u64, h.params.len)) {
                        pi = @int_cast(usize, a.cv);
                    }
                    if (pi < h.params.len) and (h.params[pi] == a) {
                        let pc = hcs[pi];
                        if u.isnil(pc) {
                            continue;  // nothing known yet
                        }
                        a = pc;
                        if pc == h.val {
                            a = g.val;
                        }
                    } else if not propagatable(a) {
                        a = g.val;
                    }
                }
                if a == g.val {
                    cs[k] = g.val;
                    again = true;
                } else if u.isnil(cs[k]) {
                    cs[k] = a;
                    again = true;
                } else if not same_const(cs[k], a) {
                    cs[k] = g.val;
                    again = true;
                }
            }
        }
    }
    calls.deinit();
    callers.deinit();
    for i in 0..m.funcs.len {
        let f = m.funcs.get(i);
        if not ipcp_eligible(f, nodes.get(i)) {
            continue;
        }
        let cs = consts[i];
        let mut any = false;
        for k in 0..f.params.len {
            let c = cs[k];
            if u.notnil(c) and (c != f.val) {
                ir.forward(f.params[k], c);
                any = true;
            }
        }
        if any {
            ir.apply_forwarding(f);
            for k in 0..f.params.len {
                ir.forward(f.params[k], vnil());
            }
            changed.push(f);
        }
    }
    return changed;
}
