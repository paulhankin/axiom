// =============================================================================
// nlink.ax - what the native linkers share: elink.ax (ELF, Linux), mlink.ax
// (Mach-O, macOS) and plink.ax (PE, Windows) all link the ELF relocatable
// objects of x64.ax and a64.ax (read with elf.read).
//
// The state of a link lives here: the objects, their global symbols (resolved
// by name: a strong definition wins over weak ones), each section's class and
// address, and the GOT. A linker starts with begin(), classifies the sections
// with classify(), places each class with place(), and copies them into its
// file with copy_class(). Also here: the AArch64 instruction fields and
// relocations that the ELF and Mach-O linkers both apply.
//
// The objects may be the platform toolchain's too (elf.read): of COMDAT
// groups with one signature only the first object's is kept (the others'
// sections are dropped: S_DISCARD); the initialization and termination
// arrays (.preinit_array, .init_array[.N], .fini_array[.N]) are placed
// together, sorted by priority, between the symbols the generic ABI's
// dynamic linking and the start-up use (__init_array_start, ...); and the
// sections whose names are C identifiers are placed together by name,
// between __start_<name> and __stop_<name> when something refers to those.
// =============================================================================
import "bin.ax" as bn;
import "dwarf.ax" as dw;
import "elf.ax" as elf;
import "util.ax" as u;

// Section classes (each linker's class_of says which sections go where).
pub const C_TEXT: i32 = 0;
pub const C_CONST: i32 = 1;  // read-only data, then the frame tables (elf.rets_rank)
pub const C_DATA: i32 = 2;
pub const C_TDATA: i32 = 3;
pub const C_TBSS: i32 = 4;
pub const C_BSS: i32 = 5;
pub const C_DEBUG: i32 = 6;  // debug information (dwarf.ax): not loaded, merged by debug_sections

// A global (non-local) symbol of the link.
pub struct GSym {
    name: []u8,
    obj: i32,  // defining object, -1: none (from a library, or missing)
    sym: u32,
    weak: bool,  // every reference / the definition is weak
    got: i32,    // GOT slot, -1: none
    stub: i32,   // PLT stub (ELF), stub (Mach-O) or import thunk (PE), -1: none
    // dynamic linking (elink.ax)
    dynamic: bool,  // from a shared library
    dynidx: u32,    // .dynsym index
    is_data: bool,  // a data object in its library
    is_tls: bool,   // a thread-local one
    copy: bool,     // copied into the executable (a copy relocation): defined there
    lib: i32,       // the library defining it
    ver: []u8,      // its version there ("": unversioned)
    vidx: u32,      // .gnu.version index (1: unversioned)
}

/// The main thread's stack, in bytes (--stack-size=); 0: the platform's
/// default (8 MiB on Windows, 1 MiB for WebAssembly, the system's on Linux
/// and macOS). Read by plink.ax (also the threads' default), mlink.ax and
/// the WebAssembly linker.
pub let mut g_stack_size: u64 = 0;

pub let mut objs: u.List.[*mut elf.Obj] = u.List.[*mut elf.Obj].{ data: @ptr_from_int(*mut *mut elf.Obj, 0), len: 0,
                                                                  cap: 0 };
pub let mut gsyms: u.List.[GSym] = u.List.[GSym].{ data: @ptr_from_int(*mut GSym, 0), len: 0, cap: 0 };
pub let mut gmap: u.SymMap.[u32] = u.SymMap.[u32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 };
// per object: each section's class and address, each local symbol's GOT slot + 1
pub let mut sec_cls: u.List.[[]mut i32] = u.List.[[]mut i32].{ data: @ptr_from_int(*mut []mut i32, 0), len: 0, cap: 0 };
pub let mut sec_addr: u.List.[[]mut u64] = u.List.[[]mut u64].{ data: @ptr_from_int(*mut []mut u64, 0), len: 0,
                                                                cap: 0 };
pub let mut local_got: u.List.[[]mut i32] = u.List.[[]mut i32].{ data: @ptr_from_int(*mut []mut i32, 0), len: 0,
                                                                 cap: 0 };
// per GOT slot: its symbol, and the .dynsym index + 1 it is bound to (0: our own)
pub let mut got_obj: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };
pub let mut got_sym: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };
pub let mut got_dyn: u.List.[u32] = u.List.[u32].{ data: @ptr_from_int(*mut u32, 0), len: 0, cap: 0 };
// functions of another system's libraries (extern_fns)
let mut foreign: u.SymMap.[u32] = u.SymMap.[u32].{ keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u32, 0),
                                                   cap: 0, len: 0 };
// per object: each symbol's global (global_of) + 1, once found
let mut gidx: u.List.[[]mut i32] = u.List.[[]mut i32].{ data: @ptr_from_int(*mut []mut i32, 0), len: 0, cap: 0 };
pub let mut errors: u32 = 0;

pub fn err(msg: []u8) void {
    u.eprint(u.f1("axiom: link error: %s\n", msg));
    errors += 1;
}

pub fn align_up(x: u64, a: u64) u64 {
    if a <= 1 {
        return x;
    }
    return (x + a - 1) & ~(a - 1);
}

// A new link of `inputs` (the linker adds its own objects after them).
pub fn begin(inputs: []*mut elf.Obj) void {
    objs = u.List.[*mut elf.Obj].empty();
    tls_got = u.List.[bool].empty();
    lnk = elf.new_obj(0);
    lnk.name = "(the linker)";
    gsyms = u.List.[GSym].empty();
    gmap = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    sec_cls = u.List.[[]mut i32].empty();
    sec_addr = u.List.[[]mut u64].empty();
    local_got = u.List.[[]mut i32].empty();
    got_obj = u.List.[u32].empty();
    got_sym = u.List.[u32].empty();
    got_dyn = u.List.[u32].empty();
    foreign = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    tls_slots = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    gidx = u.List.[[]mut i32].empty();
    errors = 0;
    for i in 0..inputs.len {
        objs.push(inputs[i]);
    }
    drop_comdat_copies();
    for n in ARRAY_SYMS {
        _ = lnk_sym(n);
    }
    // room for the copies of shared libraries' data (elink.ax)
    copy_sec = elf.add_sec(lnk, ".bss.copy", elf.S_BSS, 16);
    objs.push(lnk);
}

// The symbols the linker defines (absolute: their values are set once the
// sections are placed): the arrays' bounds, __start_ and __stop_ symbols.
pub let mut lnk: *mut elf.Obj = @ptr_from_int(*mut elf.Obj, 0);
/// lnk's .bss section for copy relocations' copies.
pub let mut copy_sec: i32 = -1;

/// lnk's index among the objects.
pub fn lnk_index() usize {
    for i in 0..objs.len {
        if objs.get(i) == lnk {
            return i;
        }
    }
    return 0;
}

/// Sets lnk's absolute symbol `name` (if something refers to it).
pub fn set_abs(name: []u8, value: u64) void {
    set_lnk(name, value);
}

let ARRAY_SYMS: [6][]u8 = ["__preinit_array_start", "__preinit_array_end", "__init_array_start", "__init_array_end",
                           "__fini_array_start", "__fini_array_end"];

// A global absolute symbol of lnk (made once); its index there.
pub fn lnk_sym(name: []u8) u32 {
    let k = u.intern(name);
    let prev = lnk.symmap.get(k);
    if prev != 0 {
        return prev - 1;
    }
    return elf.add_sym(lnk, elf.Sym.{ name: k, sec: elf.SEC_ABS, value: 0, size: 0, bind: elf.B_WEAK, ty: elf.T_NOTYPE,
                                      hidden: true });
}

fn set_lnk(name: []u8, value: u64) void {
    let prev = lnk.symmap.get(u.intern(name));
    if prev != 0 {
        lnk.syms.at(@as(usize, prev - 1)).value = value;
    }
}

// COMDAT groups (elf.Group): the first object's group of each signature is
// kept, the sections of the others' are dropped, and their symbols are
// then references to the kept group's.
fn drop_comdat_copies() void {
    let mut seen = u.SymMap.[u32].{ keys: u.nil.[usize](), vals: u.nil.[u32](), cap: 0, len: 0 };
    for oi in 0..objs.len {
        let o = objs.get(oi);
        for gi in 0..o.groups.len {
            let g = o.groups.at(gi);
            if seen.get(g.sig) == 0 {
                seen.put(g.sig, @int_cast(u32, oi) + 1);
                continue;
            }
            for si in g.secs.items() {
                let s = o.secs.get(@int_cast(usize, si));
                s.kind = elf.S_DISCARD;
                s.relocs.deinit();
                s.relocs = u.List.[elf.Rel].empty();
            }
            for k in 0..o.syms.len {
                let sy = o.syms.at(k);
                if (sy.sec >= 0) and (o.secs.get(@int_cast(usize, sy.sec)).kind == elf.S_DISCARD) and
                   (sy.bind != elf.B_LOCAL) {
                    sy.sec = -1;
                }
            }
        }
    }
}

/// Is symbol si of object oi defined in a section the link dropped (a
/// COMDAT copy)? A relocation against it is not applied (only the dropped
/// group's own unwind or debug entries refer to it).
pub fn sym_dropped(oi: usize, si: u32) bool {
    let o = objs.get(oi);
    let s = o.syms.at(@as(usize, si));
    return (s.sec >= 0) and (o.secs.get(@int_cast(usize, s.sec)).kind == elf.S_DISCARD);
}

// A section's place among the initialization and termination arrays: 0 for
// any other section, else the kind (1 .preinit_array, 2 .init_array, 3
// .fini_array) times 0x20000 plus its priority (.init_array.N: N; the plain
// array after every numbered one), the order the arrays run in.
fn array_rank(s: *elf.Sec) u64 {
    let n = s.name;
    let mut kind: u64 = 0;
    let mut rest: []u8 = "";
    if u.starts(n, ".preinit_array") {
        kind = 1;
        rest = n[14..];
    } else if u.starts(n, ".init_array") {
        kind = 2;
        rest = n[11..];
    } else if u.starts(n, ".fini_array") {
        kind = 3;
        rest = n[11..];
    } else {
        return 0;
    }
    let mut prio: u64 = 0x10000;
    if (rest.len > 1) and (rest[0] == '.') {
        prio = 0;
        for c in rest[1..] {
            if not u.is_digit(c) {
                return 0;  // (another section)
            }
            prio = (prio * 10) + @as(u64, c - '0');
        }
        if prio > 0xffff {
            prio = 0xffff;
        }
    } else if rest.len != 0 {
        return 0;
    }
    return (kind * 0x20000) + prio;
}

// Is the name a C identifier (sections so named have __start_ and __stop_
// symbols)?
fn c_ident(n: []u8) bool {
    if n.len == 0 {
        return false;
    }
    for i in 0..n.len {
        let c = n[i];
        let alpha = ((c | 0x20) >= 'a') and ((c | 0x20) <= 'z');
        if not alpha and (c != '_') and not (u.is_digit(c) and (i > 0)) {
            return false;
        }
    }
    return true;
}

// The __start_ and __stop_ symbols referred to and not defined: lnk's,
// for the sections of the name (place sets them).
fn start_stop_syms() void {
    let mut names = u.SymMap.[u8].{ keys: u.nil.[usize](), vals: u.nil.[u8](), cap: 0, len: 0 };
    for oi in 0..objs.len {
        let o = objs.get(oi);
        for k in 0..o.secs.len {
            let s = o.secs.get(k);
            if (s.kind != elf.S_DISCARD) and (s.kind != elf.S_DEBUG) and c_ident(s.name) {
                names.put(u.intern(s.name), 1);
            }
        }
    }
    for oi in 0..objs.len {
        let o = objs.get(oi);
        for si in 0..o.syms.len {
            let sy = o.syms.get(si);
            if (sy.sec != -1) or (sy.bind == elf.B_LOCAL) {
                continue;
            }
            let mut sec: []u8 = "";
            if u.starts(sy.name, "__start_") {
                sec = sy.name[8..];
            } else if u.starts(sy.name, "__stop_") {
                sec = sy.name[7..];
            } else {
                continue;
            }
            if (names.get(u.intern(sec)) != 0) and (lnk.symmap.get(u.intern(sy.name)) == 0) and not rets_section(sec) {
                _ = lnk_sym(sy.name);
            }
        }
    }
}

// (axiom_rets has bounds of its own: elf.rets_bounds)
fn rets_section(n: []u8) bool {
    return u.str_eq(n, "axiom_rets");
}

// Does a __start_/__stop_ pair name section s (so that it is placed with
// the others of its name)?
fn start_stop_named(s: *elf.Sec) bool {
    return c_ident(s.name) and
           ((lnk.symmap.get(u.intern(u.cat2("__start_", s.name))) != 0) or
            (lnk.symmap.get(u.intern(u.cat2("__stop_", s.name))) != 0));
}

// -----------------------------------------------------------------------------
// Symbols
// -----------------------------------------------------------------------------
pub fn gsym_index(name: []u8) u32 {
    let k = u.intern(name);
    let prev = gmap.get(k);
    if prev != 0 {
        return prev - 1;
    }
    gsyms.push(GSym.{ name: k, obj: -1, sym: 0, weak: true, got: -1, stub: -1, dynamic: false, dynidx: 0,
                      is_data: false, is_tls: false, copy: false, lib: -1, ver: "", vidx: 1 });
    gmap.put(k, @int_cast(u32, gsyms.len));
    return @int_cast(u32, gsyms.len - 1);
}

// Every global symbol of the objects, with its definition (if any).
pub fn define_globals() void {
    start_stop_syms();
    for oi in 0..objs.len {
        let o = objs.get(oi);
        for si in 0..o.syms.len {
            let s = o.syms.get(si);
            if (s.bind == elf.B_LOCAL) or (s.name.len == 0) {
                continue;
            }
            let gi = gsym_index(s.name);
            let g = gsyms.at(@as(usize, gi));
            if s.bind != elf.B_WEAK {
                g.weak = false;
            }
            if s.sec == -1 {
                continue;
            }
            if s.ty == elf.T_IFUNC {
                err(u.f2("'%s' (%s) is an indirect function (STT_GNU_IFUNC), which the linker does not support", s.name,
                         obj_name(oi)));
            }
            if g.obj < 0 {
                g.obj = @int_cast(i32, oi);
                g.sym = @int_cast(u32, si);
            } else if s.bind != elf.B_WEAK {
                let prev = objs.get(@as(usize, @bit_cast(u32, g.obj))).syms.get(@as(usize, g.sym));
                if prev.bind == elf.B_WEAK {
                    g.obj = @int_cast(i32, oi);
                    g.sym = @int_cast(u32, si);
                } else {
                    err(u.f3("duplicate symbol '%s' (%s and %s)", s.name, obj_name(@as(usize, @bit_cast(u32, g.obj))),
                             obj_name(oi)));
                }
            }
        }
    }
}

/// An object's name for messages: its file (or archive member), or
/// "the program" for the compiler's own.
pub fn obj_name(oi: usize) []u8 {
    let o = objs.get(oi);
    if u.isnos(o.name) or (o.name.len == 0) {
        return "the program";
    }
    return o.name;
}

// Windows system DLLs (and any name ending in .dll).
let WINDOWS_DLLS: [26][]u8 = ["advapi32", "bcrypt", "d2d1", "d3d11", "d3d12", "d3dcompiler_47", "dbghelp", "dwrite",
                              "dxcompiler", "dxgi", "gdi32", "kernel32", "ntdll", "ole32", "oleaut32", "shell32",
                              "shlwapi", "user32", "uxtheme", "windowscodecs", "winmm", "ws2_32", "xaudio2_9",
                              "xinput1_4", "xinput9_1_0", "comdlg32"];

pub fn is_windows_dll(name: []u8) bool {
    if u.ends(name, ".dll") or u.ends(name, ".DLL") {
        return true;
    }
    for d in WINDOWS_DLLS {
        if u.str_eq(d, name) {
            return true;
        }
    }
    return false;
}

// macOS frameworks and libraries (and any name with a / or ending in
// .dylib or .framework).
let APPLE_LIBS: [24][]u8 = ["AVFAudio", "AppKit", "ApplicationServices", "AudioToolbox", "AudioUnit", "CoreAudio",
                            "CoreFoundation", "CoreGraphics", "CoreHaptics", "CoreServices", "CoreText", "CoreVideo",
                            "Foundation", "GameController", "IOKit", "ImageIO", "Metal", "MetalKit", "QuartzCore",
                            "Security", "System", "UniformTypeIdentifiers", "objc", "Carbon"];

pub fn is_apple_lib(name: []u8) bool {
    if u.ends(name, ".dylib") or u.ends(name, ".framework") or (u.find(name, '/') >= 0) {
        return true;
    }
    for d in APPLE_LIBS {
        if u.str_eq(d, name) {
            return true;
        }
    }
    return false;
}

// A function an extern block names a library for (codegen leaves the
// library's name in a constant axiom.import.<function>).
pub struct ExternFn {
    name: []u8,
    lib: []u8,
}

// The functions extern blocks name libraries for, but those from another
// system's libraries (by is_foreign_lib), which are noted for
// use_unavailable.
pub fn extern_fns(is_foreign_lib: fn([]u8) bool) u.List.[ExternFn] {
    let mut fns = u.List.[ExternFn].empty();
    for oi in 0..objs.len {
        let o = objs.get(oi);
        for si in 0..o.syms.len {
            let s = o.syms.get(si);
            if (s.sec < 0) or not u.starts(s.name, "axiom.import.") {
                continue;
            }
            let d = o.secs.get(@as(usize, @bit_cast(u32, s.sec))).data.view();
            let start = @truncate(usize, s.value);
            let mut e = start;
            while (e < d.len) and (d[e] != 0) {
                e += 1;
            }
            if is_foreign_lib(d[start..e]) {
                foreign.put(u.intern(s.name[13..]), 1);
            } else {
                fns.push(ExternFn.{ name: s.name[13..], lib: d[start..e] });
            }
        }
    }
    return fns;
}

// Is a function from another system's library (by extern_fns)?
pub fn is_foreign(name: []u8) bool {
    return foreign.get(u.intern(name)) != 0;
}

// Functions of another system's libraries (a Windows DLL on macOS, a macOS
// framework on Windows) are the runtime's ax_unavailable, which says so if it
// is ever called: a program can support several systems and choose at run
// time.
pub fn use_unavailable() void {
    let un = gsym_index("ax_unavailable");
    for gi in 0..gsyms.len {
        let g = gsyms.at(gi);
        if (g.obj < 0) and is_foreign(g.name) {
            let target = gsyms.get(@as(usize, un));
            if target.obj < 0 {
                err(u.f1("'%s' is from another system's library, and there is no ax_unavailable", g.name));
            }
            g.obj = target.obj;
            g.sym = target.sym;
            g.weak = false;
        }
    }
}

// The global a symbol of an object stands for, or -1 for local symbols.
pub fn global_of(oi: usize, si: u32) i32 {
    let o = objs.get(oi);
    let s = o.syms.at(@as(usize, si));
    if (s.bind == elf.B_LOCAL) or (s.name.len == 0) {
        return -1;
    }
    // (cached: relocations look up the same symbols again and again)
    while gidx.len <= oi {
        gidx.push(u.nil_slice.[i32]());
    }
    let mut c = gidx.get(oi);
    if c.len < o.syms.len {
        let nc = u.newn.[i32](o.syms.len);
        for k in 0..c.len {
            nc[k] = c[k];
        }
        gidx.set(oi, nc);
        c = nc;
    }
    let at = @as(usize, si);
    if c[at] > 0 {
        return c[at] - 1;
    }
    let g = @int_cast(i32, gmap.get(u.intern(s.name))) - 1;
    if g >= 0 {
        c[at] = g + 1;  // (a symbol not defined yet may be later)
    }
    return g;
}

pub fn sym_addr_in(oi: usize, si: u32) u64 {
    let s = objs.get(oi).syms.at(@as(usize, si));
    if s.sec == elf.SEC_ABS {
        return s.value;
    }
    if s.sec < 0 {
        return 0;
    }
    return sec_addr.get(oi)[@as(usize, @bit_cast(u32, s.sec))] + s.value;
}

// The address of a symbol (0 for one the objects do not define).
pub fn sym_addr(oi: usize, si: u32) u64 {
    let gi = global_of(oi, si);
    if gi < 0 {
        return sym_addr_in(oi, si);
    }
    let g = gsyms.at(@int_cast(usize, gi));
    if g.obj < 0 {
        return 0;
    }
    return sym_addr_in(@as(usize, @bit_cast(u32, g.obj)), g.sym);
}

pub fn global_addr(name: []u8) u64 {
    let g = gsyms.at(@as(usize, gsym_index(name)));
    if g.obj < 0 {
        return 0;
    }
    return sym_addr_in(@as(usize, @bit_cast(u32, g.obj)), g.sym);
}

// -----------------------------------------------------------------------------
// The GOT
// -----------------------------------------------------------------------------
fn new_got(oi: usize, si: u32, dynidx: u32) i32 {
    got_obj.push(@int_cast(u32, oi));
    got_sym.push(si);
    got_dyn.push(dynidx);
    tls_got.push(false);
    return @int_cast(i32, got_dyn.len - 1);
}

// per GOT slot: does it hold the symbol's offset from the thread pointer
// (the initial-exec TLS model) rather than its address?
pub let mut tls_got: u.List.[bool] = u.List.[bool].{ data: @ptr_from_int(*mut bool, 0), len: 0, cap: 0 };
// thread-pointer offset slots by symbol: name (or object and index) -> slot + 1
let mut tls_slots: u.SymMap.[u32] = u.SymMap.[u32].{
    keys: @ptr_from_int(*mut usize, 0), vals: @ptr_from_int(*mut u32, 0), cap: 0, len: 0 };

/// The GOT slot that holds symbol si's (of object oi) offset from the
/// thread pointer (initial-exec TLS references), allocated on first use;
/// dynidx: the .dynsym index + 1 of a symbol from a shared library (0: the
/// program's own).
pub fn got_slot_tls(oi: usize, si: u32, dynidx: u32) i32 {
    let gi = global_of(oi, si);
    let mut key = u.f2("%s:%s", u.zdec(oi), u.udec(@as(u64, si)));
    if gi >= 0 {
        key = gsyms.get(@int_cast(usize, gi)).name;
    }
    let k = u.intern(key);
    let prev = tls_slots.get(k);
    if prev != 0 {
        return @bit_cast(i32, prev - 1);
    }
    let slot = new_got(oi, si, dynidx);
    tls_got.set(@int_cast(usize, slot), true);
    tls_slots.put(k, @bit_cast(u32, slot) + 1);
    return slot;
}

// The GOT slot of global gi (symbol si of object oi), allocated on first use.
pub fn got_slot_g(gi: u32, oi: usize, si: u32) i32 {
    let g = gsyms.at(@as(usize, gi));
    if g.got < 0 {
        let mut d: u32 = 0;
        if g.dynamic {
            d = g.dynidx;
        }
        g.got = new_got(oi, si, d);
    }
    return g.got;
}

// The GOT slot of a symbol, allocated on first use.
pub fn got_slot(oi: usize, si: u32) i32 {
    let gi = global_of(oi, si);
    if gi >= 0 {
        return got_slot_g(@bit_cast(u32, gi), oi, si);
    }
    let lg = local_got.get(oi);
    if lg[@as(usize, si)] == 0 {
        lg[@as(usize, si)] = new_got(oi, si, 0) + 1;
    }
    return lg[@as(usize, si)] - 1;
}

// -----------------------------------------------------------------------------
// Layout
// -----------------------------------------------------------------------------

// Each object's section classes (by class_of), and room for the section
// addresses and local GOT slots.
pub fn classify(class_of: fn(*elf.Sec) i32) void {
    for oi in 0..objs.len {
        let o = objs.get(oi);
        let cls = u.newn.[i32](o.secs.len + 1);
        for k in 0..o.secs.len {
            if o.secs.get(k).kind == elf.S_DISCARD {
                cls[k] = -1;  // (not placed, not copied, not relocated)
            } else {
                cls[k] = class_of(o.secs.get(k));
            }
        }
        sec_cls.push(cls);
        sec_addr.push(u.newn.[u64](o.secs.len + 1));
        local_got.push(u.newn.[i32](o.syms.len + 1));
    }
}

// Places the sections of class `cls` from address `at`; returns the end.
// First the class's ordinary sections (of read-only data, the frame tables
// last, together: elf.rets_rank), then the initialization and termination
// arrays (array_rank, setting their bounds' symbols), then the sections
// with __start_ and __stop_ symbols, by name (setting those).
pub fn place(cls: i32, at: u64) u64 {
    let mut cur = at;
    let mut passes: i32 = 1;
    if cls == C_CONST {
        passes = 4;
    }
    let mut arrays = u.List.[u64].empty();  // rank << 40 | object << 20 | section
    let mut named = u.List.[u64].empty();   // object << 20 | section
    for pass in 0..passes {
        for oi in 0..objs.len {
            let o = objs.get(oi);
            for k in 0..o.secs.len {
                if sec_cls.get(oi)[k] != cls {
                    continue;
                }
                let s = o.secs.get(k);
                if (cls == C_CONST) and (elf.rets_rank(s) != (pass - 1)) {
                    continue;
                }
                if pass == 0 {
                    let r = array_rank(s);
                    if r != 0 {
                        arrays.push((r << 40) | (@as(u64, oi) << 20) | @as(u64, k));
                        continue;
                    }
                    if start_stop_named(s) {
                        named.push((@as(u64, oi) << 20) | @as(u64, k));
                        continue;
                    }
                }
                cur = put_sec(oi, k, cur);
            }
        }
    }
    if arrays.len > 0 {
        sort_u64(arrays.items());
        let mut kind: u64 = 0;
        for x in arrays.items() {
            let kd = (x >> 40) / 0x20000;
            if kd != kind {
                if kind != 0 {
                    set_lnk(ARRAY_SYMS[@truncate(usize, kind - 1) * 2 + 1], cur);
                }
                kind = kd;
                cur = align_up(cur, 8);
                set_lnk(ARRAY_SYMS[@truncate(usize, kind - 1) * 2], cur);
            }
            cur = put_sec(@truncate(usize, (x >> 20) & 0xfffff), @truncate(usize, x & 0xfffff), cur);
        }
        set_lnk(ARRAY_SYMS[@truncate(usize, kind - 1) * 2 + 1], cur);
        // (the arrays absent: empty, at their neighbours' end)
        for kd in @as(u64, 1)..4 {
            let sa = ARRAY_SYMS[@truncate(usize, kd - 1) * 2];
            if lnk.syms.get(@as(usize, lnk.symmap.get(u.intern(sa)) - 1)).value == 0 {
                set_lnk(sa, cur);
                set_lnk(ARRAY_SYMS[@truncate(usize, kd - 1) * 2 + 1], cur);
            }
        }
    }
    let mut i: usize = 0;
    while i < named.len {
        let first = named.get(i);
        let nm = objs.get(@truncate(usize, first >> 20)).secs.get(@truncate(usize, first & 0xfffff)).name;
        let mut start: u64 = 0;
        let mut started = false;
        for j in i..named.len {
            let x = named.get(j);
            let s = objs.get(@truncate(usize, x >> 20)).secs.get(@truncate(usize, x & 0xfffff));
            if (x == 0xffff_ffff_ffff_ffff) or not u.str_eq(s.name, nm) {
                continue;
            }
            cur = align_up(cur, s.align);
            if not started {
                start = cur;
                started = true;
            }
            cur = put_sec(@truncate(usize, x >> 20), @truncate(usize, x & 0xfffff), cur);
            named.set(j, 0xffff_ffff_ffff_ffff);
        }
        set_lnk(u.cat2("__start_", nm), start);
        set_lnk(u.cat2("__stop_", nm), cur);
        while (i < named.len) and (named.get(i) == 0xffff_ffff_ffff_ffff) {
            i += 1;
        }
    }
    return cur;
}

fn put_sec(oi: usize, k: usize, at: u64) u64 {
    let s = objs.get(oi).secs.get(k);
    let cur = align_up(at, s.align);
    sec_addr.get(oi)[k] = cur;
    return cur + elf.sec_size(s);
}

// (insertion sort: the arrays are few)
fn sort_u64(a: []mut u64) void {
    for i in 1..a.len {
        let x = a[i];
        let mut j = i;
        while (j > 0) and (a[j - 1] > x) {
            a[j] = a[j - 1];
            j -= 1;
        }
        a[j] = x;
    }
}

pub fn class_align(cls: i32) u64 {
    let mut a: u64 = 1;
    for oi in 0..objs.len {
        let o = objs.get(oi);
        for k in 0..o.secs.len {
            if (sec_cls.get(oi)[k] == cls) and (o.secs.get(k).align > a) {
                a = o.secs.get(k).align;
            }
        }
    }
    return a;
}

// Copies the sections of class `cls` into the file b (file_of: an address's
// offset in it).
pub fn copy_class(b: []mut u8, cls: i32, file_of: fn(u64) u64) void {
    for oi in 0..objs.len {
        let o = objs.get(oi);
        for k in 0..o.secs.len {
            if sec_cls.get(oi)[k] != cls {
                continue;
            }
            let d = o.secs.get(k).data.view();
            if d.len == 0 {
                continue;
            }
            let fo = @truncate(usize, file_of(sec_addr.get(oi)[k]));
            for i in 0..d.len {
                b[fo + i] = d[i];
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Debug information
// -----------------------------------------------------------------------------
pub struct DebugSec {
    name: []u8,
    data: bn.Bytes,
}

/// The objects' debug sections (C_DEBUG; dwarf.ax), each name's pieces one
/// after the other in the order of the objects, with their relocations
/// applied: a piece's offset in the whole is its section's address
/// (sec_addr), so offsets into another debug section and addresses of
/// code both are the symbol's address plus the addend. A symbol is the
/// object's own (a function's copy that the link did not keep still has its
/// code, which its debug information describes). Empty without -g.
/// Where the executable's TLS template starts (its PT_TLS segment: the
/// linker sets it before debug_sections), for offsets in a thread's block.
pub let mut tls_start: u64 = 0;

pub fn debug_sections() u.List.[DebugSec] {
    let mut out = u.List.[DebugSec].empty();
    for name in dw.SEC_NAMES {
        let mut d = bn.new_bytes();
        for oi in 0..objs.len {
            let o = objs.get(oi);
            for k in 0..o.secs.len {
                if (sec_cls.get(oi)[k] == C_DEBUG) and u.str_eq(o.secs.get(k).name, name) {
                    sec_addr.get(oi)[k] = @as(u64, d.len());
                    d.put(o.secs.get(k).data.view());
                }
            }
        }
        out.push(DebugSec.{ name: name, data: d });
    }
    for oi in 0..objs.len {
        let o = objs.get(oi);
        for k in 0..o.secs.len {
            if sec_cls.get(oi)[k] != C_DEBUG {
                continue;
            }
            let s = o.secs.get(k);
            let mut at: usize = 0;
            while (at < out.len) and not u.str_eq(out.get(at).name, s.name) {
                at += 1;
            }
            if at == out.len {
                continue;
            }
            let b = out.at(at).data.view();
            let base = sec_addr.get(oi)[k];
            for r in s.relocs.items() {
                let v = sym_addr_in(oi, r.sym) + @bit_cast(u64, r.addend);
                let p = @truncate(usize, base + r.off);
                if (r.ty == elf.R_X86_64_64) or (r.ty == elf.R_AARCH64_ABS64) {
                    bn.w64(b, @as(u64, p), v);
                } else if (r.ty == elf.R_X86_64_32) or (r.ty == elf.R_AARCH64_ABS32) {
                    bn.w32(b, @as(u64, p), v & 0xffff_ffff);
                } else if (r.ty == elf.R_X86_64_DTPOFF64) or (r.ty == elf.R_AARCH64_TLS_DTPREL64) {
                    bn.w64(b, @as(u64, p), v -% tls_start);
                }
                // (other types come only from other compilers' objects: their
                // debug information is kept as it is)
            }
        }
    }
    let mut n: usize = 0;
    for k in 0..out.len {
        if out.get(k).data.len() > 0 {
            out.set(n, out.get(k));
            n += 1;
        }
    }
    out.len = n;
    return out;
}

// -----------------------------------------------------------------------------
// Relocation
// -----------------------------------------------------------------------------

// Relocations through the GOT, and calls or jumps (x86-64 or AArch64).
pub fn is_got_reloc(x64: bool, ty: u32) bool {
    if x64 {
        return (ty == elf.R_X86_64_GOTPCREL) or (ty == elf.R_X86_64_GOTPCRELX) or (ty == elf.R_X86_64_REX_GOTPCRELX);
    }
    return (ty == elf.R_AARCH64_ADR_GOT_PAGE) or (ty == elf.R_AARCH64_LD64_GOT_LO12_NC) or
           (ty == elf.R_AARCH64_GOT_LD_PREL19);
}

pub fn is_call_reloc(x64: bool, ty: u32) bool {
    if x64 {
        return (ty == elf.R_X86_64_PLT32) or (ty == elf.R_X86_64_PC32);
    }
    return (ty == elf.R_AARCH64_CALL26) or (ty == elf.R_AARCH64_JUMP26);
}

// x86-64: mov reg, [rip + GOT] -> lea reg, [rip + sym]. Rewrites the
// instruction of a REX_GOTPCRELX at file offset fo, if it is such a mov, and
// says whether it did (the displacement is then the symbol's).
pub fn x64_relax(b: []mut u8, fo: u64, ty: u32) bool {
    if (ty != elf.R_X86_64_REX_GOTPCRELX) or (fo < 2) or (b[@truncate(usize, fo - 2)] != 0x8b) {
        return false;
    }
    b[@truncate(usize, fo - 2)] = 0x8d;
    return true;
}

// AArch64 instruction fields.
pub fn a64_adrp(b: []mut u8, off: u64, p: u64, target: u64) void {
    let pages = (@bit_cast(i64, target & ~@as(u64, 0xfff)) - @bit_cast(i64, p & ~@as(u64, 0xfff))) >> 12;
    if (pages < -0x10_0000) or (pages >= 0x10_0000) {
        err("adrp out of range");
    }
    let v = @bit_cast(u64, pages) & 0x1f_ffff;
    bn.w32(b, off, (rd32(b, off) & 0x9f00_001f) | ((v & 3) << 29) | ((v >> 2) << 5));
}

pub fn a64_imm12(b: []mut u8, off: u64, x: u64) void {
    bn.w32(b, off, (rd32(b, off) & 0xffc0_03ff) | ((x & 0xfff) << 10));
}

pub fn a64_branch(b: []mut u8, off: u64, p: u64, target: u64) void {
    let d = @bit_cast(i64, target -% p);
    if (d < -0x800_0000) or (d >= 0x800_0000) {
        err("branch out of range");
    }
    bn.w32(b, off, (rd32(b, off) & 0xfc00_0000) | ((@bit_cast(u64, d) >> 2) & 0x3ff_ffff));
}

fn rd32(b: []u8, off: u64) u64 {
    return bn.rd32(b, @truncate(usize, off));
}

// An AArch64 load of GOT slot address ga at p (file offset fo).
pub fn a64_got(b: []mut u8, fo: u64, p: u64, ty: u32, ga: u64) void {
    if ty == elf.R_AARCH64_ADR_GOT_PAGE {
        a64_adrp(b, fo, p, ga);
    } else if ty == elf.R_AARCH64_GOT_LD_PREL19 {
        a64_imm19(b, fo, p, ga, "a GOT literal");
    } else {
        a64_imm12(b, fo, (ga & 0xfff) >> 3);
    }
}

// Applies an AArch64 relocation of type ty at p (file offset fo) to target
// sa; false if it is not one of these (absolute, GOT and thread-local
// relocations are the linker's).
pub fn a64_reloc(b: []mut u8, fo: u64, p: u64, ty: u32, sa: u64) bool {
    if ty == elf.R_AARCH64_PREL32 {
        let v = @bit_cast(i64, sa) - @bit_cast(i64, p);
        if (v < -0x8000_0000) or (v > 0x7fff_ffff) {
            err("relocation out of range (prel32)");
        }
        bn.w32(b, fo, @bit_cast(u64, v) & 0xFFFF_FFFF);
    } else if ty == elf.R_AARCH64_ADR_PREL_PG_HI21 {
        a64_adrp(b, fo, p, sa);
    } else if (ty == elf.R_AARCH64_ADD_ABS_LO12_NC) or (ty == elf.R_AARCH64_LDST8_ABS_LO12_NC) {
        a64_imm12(b, fo, sa & 0xfff);
    } else if ty == elf.R_AARCH64_LDST16_ABS_LO12_NC {
        a64_imm12(b, fo, (sa & 0xfff) >> 1);
    } else if ty == elf.R_AARCH64_LDST32_ABS_LO12_NC {
        a64_imm12(b, fo, (sa & 0xfff) >> 2);
    } else if ty == elf.R_AARCH64_LDST64_ABS_LO12_NC {
        a64_imm12(b, fo, (sa & 0xfff) >> 3);
    } else if ty == elf.R_AARCH64_LDST128_ABS_LO12_NC {
        a64_imm12(b, fo, (sa & 0xfff) >> 4);
    } else if (ty == elf.R_AARCH64_CALL26) or (ty == elf.R_AARCH64_JUMP26) {
        a64_branch(b, fo, p, sa);
    } else if ty == elf.R_AARCH64_ADR_PREL_PG_HI21_NC {
        let pages = (@bit_cast(i64, sa & ~@as(u64, 0xfff)) - @bit_cast(i64, p & ~@as(u64, 0xfff))) >> 12;
        let v = @bit_cast(u64, pages) & 0x1f_ffff;
        bn.w32(b, fo, (rd32(b, fo) & 0x9f00_001f) | ((v & 3) << 29) | ((v >> 2) << 5));
    } else if (ty == elf.R_AARCH64_LD_PREL_LO19) or (ty == elf.R_AARCH64_CONDBR19) {
        a64_imm19(b, fo, p, sa, u.pick(ty == elf.R_AARCH64_CONDBR19, "a conditional branch", "a literal load"));
    } else if ty == elf.R_AARCH64_TSTBR14 {
        let d = @bit_cast(i64, sa -% p);
        if ((d & 3) != 0) or (d < -0x8000) or (d >= 0x8000) {
            err("relocation out of range (tbz/tbnz: 32 KiB)");
        }
        bn.w32(b, fo, (rd32(b, fo) & 0xfff8_001f) | (((@bit_cast(u64, d) >> 2) & 0x3fff) << 5));
    } else if ty == elf.R_AARCH64_ADR_PREL_LO21 {
        let d = @bit_cast(i64, sa -% p);
        if (d < -0x10_0000) or (d >= 0x10_0000) {
            err("relocation out of range (adr: 1 MiB)");
        }
        let v = @bit_cast(u64, d) & 0x1f_ffff;
        bn.w32(b, fo, (rd32(b, fo) & 0x9f00_001f) | ((v & 3) << 29) | ((v >> 2) << 5));
    } else if ty == elf.R_AARCH64_PREL64 {
        bn.w64(b, fo, sa -% p);
    } else if ty == elf.R_AARCH64_PREL16 {
        let v = @bit_cast(i64, sa) - @bit_cast(i64, p);
        if (v < -0x8000) or (v > 0xffff) {
            err("relocation out of range (prel16)");
        }
        bn.w16(b, fo, @bit_cast(u64, v) & 0xffff);
    } else if (ty >= elf.R_AARCH64_MOVW_PREL_G0) and (ty <= elf.R_AARCH64_MOVW_PREL_G3) {
        // (G0 G0_NC G1 G1_NC G2 G2_NC G3: the checked ones a movz or movn by the sign)
        let k = ty - elf.R_AARCH64_MOVW_PREL_G0;
        let mut mode = MW_SIGNED;
        if k == 6 {
            mode = MW_SIGNED_NC;
        } else if (k & 1) != 0 {
            mode = MW_NC;
        }
        a64_movw(b, fo, @bit_cast(i64, sa -% p), k / 2, mode, "movw prel");
    } else {
        return false;
    }
    return true;
}

// The ABI's move-wide relocations: an unsigned value checked to fit the
// group's and lower bits, a movk's 16 bits (not checked), a signed value
// that makes the instruction movz (>= 0) or movn (< 0) checked to fit, or not.
pub const MW_UNSIGNED: u32 = 0;
pub const MW_NC: u32 = 1;
pub const MW_SIGNED: u32 = 2;
pub const MW_SIGNED_NC: u32 = 3;

pub fn a64_movw(b: []mut u8, fo: u64, x: i64, group: u32, mode: u32, what: []u8) void {
    let sh = @as(u64, group) * 16;
    let mut w = rd32(b, fo) & 0xffe0_001f;
    let mut v = @bit_cast(u64, x);
    if mode == MW_UNSIGNED {
        if (group < 3) and ((v >> (sh + 16)) != 0) {
            err(u.f1("relocation out of range (%s)", what));
        }
    } else if (mode == MW_SIGNED) or (mode == MW_SIGNED_NC) {
        if (mode == MW_SIGNED) and (group < 3) {
            let lim = @as(i64, 1) << @truncate(u32, sh + 16);
            if (x < -lim) or (x >= lim) {
                err(u.f1("relocation out of range (%s)", what));
            }
        }
        // opc (bits 30:29): movz 10, movn 00
        w = w & ~(@as(u64, 3) << 29);
        if x < 0 {
            v = ~v;
        } else {
            w = w | (@as(u64, 2) << 29);
        }
    }
    bn.w32(b, fo, w | (((v >> sh) & 0xffff) << 5));
}

// A 19-bit pc-relative word offset at bit 5 (literal loads, b.cond, cbz).
pub fn a64_imm19(b: []mut u8, fo: u64, p: u64, target: u64, what: []u8) void {
    let d = @bit_cast(i64, target -% p);
    if ((d & 3) != 0) or (d < -0x10_0000) or (d >= 0x10_0000) {
        err(u.f1("relocation out of range (%s: 1 MiB)", what));
    }
    bn.w32(b, fo, (rd32(b, fo) & 0xff00_001f) | (((@bit_cast(u64, d) >> 2) & 0x7_ffff) << 5));
}

/// The absolute AArch64 relocations of a position-dependent image (ELF
/// executables): .word/.hword of addresses and the move-wide UABS and SABS
/// groups; false if ty is not one of them.
pub fn a64_abs(b: []mut u8, fo: u64, ty: u32, sa: u64) bool {
    if ty == elf.R_AARCH64_ABS32 {
        let v = @bit_cast(i64, sa);
        if (v < -0x8000_0000) or (v > 0xffff_ffff) {
            err("relocation out of range (abs32)");
        }
        bn.w32(b, fo, sa & 0xffff_ffff);
    } else if ty == elf.R_AARCH64_ABS16 {
        let v = @bit_cast(i64, sa);
        if (v < -0x8000) or (v > 0xffff) {
            err("relocation out of range (abs16)");
        }
        bn.w16(b, fo, sa & 0xffff);
    } else if (ty >= elf.R_AARCH64_MOVW_UABS_G0) and (ty <= elf.R_AARCH64_MOVW_UABS_G3) {
        // G0 G0_NC G1 G1_NC G2 G2_NC G3
        let k = ty - elf.R_AARCH64_MOVW_UABS_G0;
        let mut mode = MW_UNSIGNED;
        if ((k & 1) != 0) or (k == 6) {
            mode = MW_NC;
        }
        a64_movw(b, fo, @bit_cast(i64, sa), k / 2, mode, "movw uabs");
    } else if (ty >= elf.R_AARCH64_MOVW_SABS_G0) and (ty <= elf.R_AARCH64_MOVW_SABS_G2) {
        a64_movw(b, fo, @bit_cast(i64, sa), ty - elf.R_AARCH64_MOVW_SABS_G0, MW_SIGNED, "movw sabs");
    } else {
        return false;
    }
    return true;
}

/// Whether ty is one of the AArch64 thread-local relocations a64_tls applies.
pub fn is_a64_tls(ty: u32) bool {
    // the DTPREL ones (523-538), initial exec by adrp, ldr and literal
    // (541-543), local exec (544-559), the descriptor's adrp, ldr, add and
    // call (562-564, 569), the 128-bit loads and stores (570-573)
    if ((ty >= elf.R_AARCH64_TLSLD_MOVW_DTPREL_G2) and (ty <= elf.R_AARCH64_TLSLD_LDST64_DTPREL_LO12_NC)) or
       ((ty >= elf.R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21) and (ty <= elf.R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC)) {
        return true;
    }
    return (ty == elf.R_AARCH64_TLSDESC_ADR_PAGE21) or (ty == elf.R_AARCH64_TLSDESC_LD64_LO12) or
           (ty == elf.R_AARCH64_TLSDESC_ADD_LO12) or (ty == elf.R_AARCH64_TLSDESC_CALL) or
           ((ty >= elf.R_AARCH64_TLSLE_LDST128_TPREL_LO12) and (ty <= elf.R_AARCH64_TLSLD_LDST128_DTPREL_LO12_NC));
}

/// Applies an AArch64 thread-local relocation of an executable's own
/// variable: tp its offset from the thread pointer (local exec), dtp its
/// offset in the module's block (the local-dynamic DTPREL ones). The
/// initial-exec and TLS-descriptor sequences are relaxed to local exec, as
/// the ABI describes: adrp xd, :gottprel:v -> movz xd, #:tprel_g1:v; ldr xt,
/// [xd, :gottprel_lo12:v] -> movk xt, #:tprel_g0_nc:v (xt must be xd);
/// adrp x0, :tlsdesc:v -> movz x0, #:tprel_g1:v; ldr x1, [x0,
/// :tlsdesc_lo12:v] -> movk x0, #:tprel_g0_nc:v; add x0, x0,
/// :tlsdesc_lo12:v and the .tlsdesccall's blr -> nop.
pub fn a64_tls(b: []mut u8, fo: u64, ty: u32, tp: i64, dtp: i64) void {
    let w = rd32(b, fo);
    let mut x = tp;
    let mut t = ty;
    let mut dt = false;
    // the DTPREL kinds are the TPREL ones of dtp (their numbers in the same order)
    if (ty >= elf.R_AARCH64_TLSLD_MOVW_DTPREL_G2) and (ty <= elf.R_AARCH64_TLSLD_MOVW_DTPREL_G0_NC) {
        t = ty + (elf.R_AARCH64_TLSLE_MOVW_TPREL_G2 - elf.R_AARCH64_TLSLD_MOVW_DTPREL_G2);
        dt = true;
    } else if (ty >= elf.R_AARCH64_TLSLD_ADD_DTPREL_HI12) and (ty <= elf.R_AARCH64_TLSLD_ADD_DTPREL_LO12_NC) {
        t = ty + (elf.R_AARCH64_TLSLE_ADD_TPREL_HI12 - elf.R_AARCH64_TLSLD_ADD_DTPREL_HI12);
        dt = true;
    } else if (ty >= elf.R_AARCH64_TLSLD_LDST8_DTPREL_LO12) and (ty <= elf.R_AARCH64_TLSLD_LDST64_DTPREL_LO12_NC) {
        t = ty + (elf.R_AARCH64_TLSLE_LDST8_TPREL_LO12 - elf.R_AARCH64_TLSLD_LDST8_DTPREL_LO12);
        dt = true;
    } else if (ty == elf.R_AARCH64_TLSLD_LDST128_DTPREL_LO12) or (ty == elf.R_AARCH64_TLSLD_LDST128_DTPREL_LO12_NC) {
        t = ty - 2;
        dt = true;
    }
    if dt {
        x = dtp;
    }
    let xu = @bit_cast(u64, x);
    if (t >= elf.R_AARCH64_TLSLE_MOVW_TPREL_G2) and (t <= elf.R_AARCH64_TLSLE_MOVW_TPREL_G0_NC) {
        // G2 G1 G1_NC G0 G0_NC
        let k = t - elf.R_AARCH64_TLSLE_MOVW_TPREL_G2;
        let group: [5]u32 = [2, 1, 1, 0, 0];
        let mut mode = MW_SIGNED;
        if (k == 2) or (k == 4) {
            mode = MW_NC;
        }
        a64_movw(b, fo, x, group[@as(usize, k)], mode, "a thread-local offset");
    } else if t == elf.R_AARCH64_TLSLE_ADD_TPREL_HI12 {
        if (x < 0) or (x >= 0x100_0000) {
            err("thread-local offset out of range");
        }
        bn.w32(b, fo, (w & 0xff80_03ff) | (@as(u64, 1) << 22) | (((xu >> 12) & 0xfff) << 10));
    } else if (t == elf.R_AARCH64_TLSLE_ADD_TPREL_LO12) or (t == elf.R_AARCH64_TLSLE_ADD_TPREL_LO12_NC) {
        if (t == elf.R_AARCH64_TLSLE_ADD_TPREL_LO12) and ((x < 0) or (x >= 0x1000)) {
            err("thread-local offset out of range (lo12)");
        }
        a64_imm12(b, fo, xu & 0xfff);
    } else if ((t >= elf.R_AARCH64_TLSLE_LDST8_TPREL_LO12) and (t <= elf.R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC)) or
              (t == elf.R_AARCH64_TLSLE_LDST128_TPREL_LO12) or (t == elf.R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC) {
        let mut sz: u64 = 4;
        let mut chk = (t & 1) == 0;
        if t <= elf.R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC {
            sz = @as(u64, (t - elf.R_AARCH64_TLSLE_LDST8_TPREL_LO12) / 2);
        } else {
            chk = t == elf.R_AARCH64_TLSLE_LDST128_TPREL_LO12;
        }
        if chk and ((x < 0) or (x >= 0x1000)) {
            err("thread-local offset out of range (lo12)");
        }
        if (xu & ((@as(u64, 1) << sz) - 1)) != 0 {
            err("a thread-local offset not aligned to its access");
        }
        a64_imm12(b, fo, (xu & 0xfff) >> sz);
    } else if (t == elf.R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21) or (t == elf.R_AARCH64_TLSDESC_ADR_PAGE21) {
        tls_relax_check(x);
        bn.w32(b, fo, 0xd2a0_0000 | (((xu >> 16) & 0xffff) << 5) | (w & 31));  // movz xd, #hi, lsl #16
    } else if (t == elf.R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC) or (t == elf.R_AARCH64_TLSDESC_LD64_LO12) {
        // the ldr's base register is the adrp's (now the movz's) destination
        let rn = (w >> 5) & 31;
        if (t == elf.R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC) and (rn != (w & 31)) {
            err("an initial-exec thread-local load whose register is not its base's (it cannot be relaxed)");
        }
        bn.w32(b, fo, 0xf280_0000 | ((xu & 0xffff) << 5) | rn);  // movk xn, #lo
    } else if t == elf.R_AARCH64_TLSIE_LD_GOTTPREL_PREL19 {
        if (x < 0) or (x >= 0x1_0000) {
            err("an initial-exec thread-local literal whose offset needs more than 16 bits (it cannot be relaxed)");
        }
        bn.w32(b, fo, 0xd280_0000 | (xu << 5) | (w & 31));  // movz xt, #tp
    } else if (t == elf.R_AARCH64_TLSDESC_ADD_LO12) or (t == elf.R_AARCH64_TLSDESC_CALL) {
        bn.w32(b, fo, 0xd503_201f);  // nop
    } else {
        err(u.f1("the thread-local relocation %s is not supported", u.udec(@as(u64, ty))));
    }
}

fn tls_relax_check(x: i64) void {
    if (x < 0) or (x >= 0x1_0000_0000) {
        err("thread-local offset out of range (32 bits)");
    }
}
