// An integer reduction: the dot product of two i32 arrays that stay in the
// first-level cache, written with `+` and `*`, which --overflow=trap checks.
// reduce_dot_wrap.ax is the same with `+%` and `*%`, which wrap in every mode.
import "common.ax" as c;
import "std/mem" as mem;

fn dot(a: []i32, b: []i32) i32 {
    let mut s: i32 = 0;
    for i in 0..a.len {
        s += a[i] * b[i];
    }
    return s;
}

export fn main() i32 {
    let n: usize = 4096;
    let a = mem.alloc.[i32](n) catch return 1;
    let b = mem.alloc.[i32](n) catch return 1;
    let mut x: u32 = 777;
    for i in 0..n {
        x = (x *% 1103515245) +% 12345;
        a[i] = @bit_cast(i32, (x >> 16) & 2047) - 1024;
        x = (x *% 1103515245) +% 12345;
        b[i] = @bit_cast(i32, (x >> 16) & 2047) - 1024;
    }
    let mut total: u64 = 0;
    for r in 0..@as(usize, 200_000) {
        a[r & (n - 1)] = @bit_cast(i32, @truncate(u32, r) & 2047) - 1024;
        total = (total *% 31) +% @as(u64, @bit_cast(u32, dot(a, b)));
    }
    c.result("dot", total);
    return 0;
}
