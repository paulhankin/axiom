// The allocator, one thread: small objects of random sizes (16 to 1024 bytes)
// allocated and freed in last-in first-out order and in random order, with a
// few thousand live at a time.
import "common.ax" as c;
import "std/mem" as mem;

fn next(s: *mut u64) u64 {
    s.* ^= s.* << 13;
    s.* ^= s.* >> 7;
    s.* ^= s.* << 17;
    return s.*;
}

fn size_of_rand(r: u64) usize {
    return 16 + @truncate(usize, r % 1009);
}

// Rounds of: allocate `live` objects, free them newest first.
fn lifo(seed: *mut u64, rounds: usize, live: usize, objs: []mut []mut u8) u64 {
    let mut sum: u64 = 0;
    for _r in 0..rounds {
        for i in 0..live {
            let x = mem.alloc.[u8](size_of_rand(next(seed))) catch return 0;
            x[0] = @truncate(u8, i);
            objs[i] = x;
        }
        let mut i = live;
        while i > 0 {
            i -= 1;
            sum +%= @as(u64, objs[i][0]) + @as(u64, objs[i].len);
            mem.free(objs[i]);
        }
    }
    return sum;
}

// Steady state: each step frees a random live object and allocates another.
fn random(seed: *mut u64, steps: usize, live: usize, objs: []mut []mut u8) u64 {
    let mut sum: u64 = 0;
    for i in 0..live {
        objs[i] = mem.alloc.[u8](size_of_rand(next(seed))) catch return 0;
        objs[i][0] = 1;
    }
    for _s in 0..steps {
        let r = next(seed);
        let i = @truncate(usize, (r >> 20) % @as(u64, live));
        sum +%= @as(u64, objs[i][0]) + @as(u64, objs[i].len);
        mem.free(objs[i]);
        let x = mem.alloc.[u8](size_of_rand(r)) catch return 0;
        x[0] = @truncate(u8, r);
        objs[i] = x;
    }
    for i in 0..live {
        mem.free(objs[i]);
    }
    return sum;
}

export fn main() i32 {
    let live: usize = 4000;
    let objs = mem.alloc.[[]mut u8](live) catch return 1;
    let mut seed: u64 = 0x9E37_79B9_7F4A_7C15;
    let mut sum = lifo(&mut seed, 2500, live, objs);
    sum +%= random(&mut seed, 10_000_000, live, objs);
    mem.free(objs);
    c.result("churn", sum);
    return 0;
}
