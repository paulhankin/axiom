// The allocator, one thread: buffers grown by doubling with realloc (from a
// few bytes to a few MiB), and large blocks (16 KiB to 1 MiB) allocated and
// freed in random order.
import "common.ax" as c;
import "std/mem" as mem;

fn next(s: *mut u64) u64 {
    s.* ^= s.* << 13;
    s.* ^= s.* >> 7;
    s.* ^= s.* << 17;
    return s.*;
}

fn grow(rounds: usize) u64 {
    let mut sum: u64 = 0;
    let mut bufs: [8][]mut u8 = [@slice_from_ptr(@ptr_from_int(*mut u8, 1), 0); 8];
    for r in 0..rounds {
        for k in 0..bufs.len {
            bufs[k] = mem.alloc.[u8](8) catch return 0;
            bufs[k][0] = @truncate(u8, k);
        }
        let mut n: usize = 8;
        while n < ((1 << 18) << (r % 4)) {
            n *= 2;
            for k in 0..bufs.len {
                bufs[k] = mem.realloc(bufs[k], n) catch return 0;
                bufs[k][n - 1] = @truncate(u8, n);
            }
        }
        for k in 0..bufs.len {
            sum +%= @as(u64, bufs[k][0]) + @as(u64, bufs[k].len);
            mem.free(bufs[k]);
        }
    }
    return sum;
}

fn large(seed: *mut u64, steps: usize) u64 {
    let live: usize = 64;
    let mut objs: [64][]mut u8 = [@slice_from_ptr(@ptr_from_int(*mut u8, 1), 0); 64];
    let mut sum: u64 = 0;
    for _s in 0..steps {
        let r = next(seed);
        let i = @truncate(usize, r % @as(u64, live));
        if objs[i].len > 0 {
            sum +%= @as(u64, objs[i][0]) + @as(u64, objs[i].len);
            mem.free(objs[i]);
        }
        let size = @as(usize, 16384) << @truncate(u32, (r >> 8) % 7);
        let x = mem.alloc.[u8](size + @truncate(usize, (r >> 16) % 4096)) catch return 0;
        x[0] = @truncate(u8, r);
        x[x.len - 1] = 1;
        objs[i] = x;
    }
    for i in 0..live {
        if objs[i].len > 0 {
            mem.free(objs[i]);
        }
    }
    return sum;
}

export fn main() i32 {
    let mut seed: u64 = 0x2545_F491_4F6C_DD1D;
    let mut sum = grow(400);
    sum +%= large(&mut seed, 400_000);
    c.result("realloc", sum);
    return 0;
}
