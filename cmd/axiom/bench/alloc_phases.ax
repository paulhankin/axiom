// The allocator's memory use (run it under a tool that reports the peak
// resident size): build up 600000 objects of mixed sizes (small and
// large), free four in five of them at random, build up again with other
// sizes, free all, and repeat.
import "common.ax" as c;
import "std/mem" as mem;

fn next(s: *mut u64) u64 {
    s.* ^= s.* << 13;
    s.* ^= s.* >> 7;
    s.* ^= s.* << 17;
    return s.*;
}

fn size_for(r: u64, phase: u64) usize {
    if (r % 64) == 0 {
        return 9000 + @truncate(usize, (r >> 8) % (20000 + (phase * 9000)));  // large
    }
    let base: u64 = 16 + ((phase % 3) * 40);
    return @truncate(usize, base + ((r >> 8) % (200 + (phase * 150))));
}

export fn main() i32 {
    let n: usize = 600_000;
    let objs = mem.alloc.[[]mut u8](n) catch return 1;
    let none = @slice_from_ptr(@ptr_from_int(*mut u8, 1), 0);
    for i in 0..n {
        objs[i] = none;
    }
    let mut seed: u64 = 0x9E37_79B9_7F4A_7C15;
    let mut sum: u64 = 0;
    for phase in @as(u64, 0)..6 {
        for i in 0..n {
            if objs[i].len == 0 {
                let x = mem.alloc.[u8](size_for(next(&mut seed), phase)) catch return 1;
                x[0] = 1;
                x[x.len - 1] = 2;
                objs[i] = x;
            }
        }
        for i in 0..n {
            if (next(&mut seed) % 5) != 0 {
                sum +%= @as(u64, objs[i].len);
                mem.free(objs[i]);
                objs[i] = none;
            }
        }
    }
    for i in 0..n {
        if objs[i].len > 0 {
            mem.free(objs[i]);
        }
    }
    mem.free(objs);
    c.result("phases", sum);
    return 0;
}
