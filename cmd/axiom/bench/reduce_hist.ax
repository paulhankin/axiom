// A histogram-style loop: counts of the bytes of a buffer in 256 buckets,
// each count an integer reduction, written with `+` (checked under --overflow=trap). reduce_hist.ax and
// reduce_hist_wrap.ax differ only in the operator of the counts.
import "common.ax" as c;
import "std/mem" as mem;

fn hist(a: []u8, h: *mut [256]u32) void {
    for i in 0..a.len {
        h[@as(usize, a[i])] += 1;
    }
}

export fn main() i32 {
    let n: usize = 16384;
    let a = mem.alloc.[u8](n) catch return 1;
    let mut x: u32 = 4242;
    for i in 0..n {
        x = (x *% 1103515245) +% 12345;
        a[i] = @truncate(u8, x >> 16) & @truncate(u8, (x >> 8) | 0x3f);
    }
    let mut total: u64 = 0;
    for r in 0..@as(usize, 100_000) {
        let mut h: [256]u32 = [0; 256];
        a[r & (n - 1)] = @truncate(u8, r);
        hist(a, &mut h);
        for k in 0..@as(usize, 256) {
            total = (total *% 31) +% @as(u64, h[k]);
        }
    }
    c.result("hist", total);
    return 0;
}
