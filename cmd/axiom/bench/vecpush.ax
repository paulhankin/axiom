// std/collections/vec: a loop pushing onto a Vec, with the grow path (the
// allocator) inlined into it; the loop's state should stay in registers on
// the push's path.
import "common.ax" as c;
import "std/collections/vec" as vec;

let mut COUNT: u64 = 100_000;

fn fill(v: *mut vec.Vec.[u64], n: u64, seed: u64) void {
    let mut x = seed;
    for i in 0..n {
        x = (x *% 6364136223846793005) +% 1442695040888963407;
        v.push(x ^ i) catch return;
    }
}

export fn main() i32 {
    let mut total: u64 = 0;
    for r in @as(u64, 0)..200 {
        let mut v = vec.Vec.[u64].init();
        fill(&mut v, COUNT, r);
        for k in 0..v.len() {
            total +%= v.get(k);
        }
        v.deinit();
    }
    c.result("vecpush", total);
    return 0;
}
