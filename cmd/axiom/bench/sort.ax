// std/collections/vec heapsort through a comparison function pointer, and a hand
// written insertion + merge sort on slices.
import "common.ax" as c;
import "std/collections/vec" as vec;
import "std/mem" as mem;

fn less(a: u64, b: u64) bool {
    return a < b;
}

fn merge_sort(xs: []mut u64, tmp: []mut u64) void {
    let n = xs.len;
    if n <= 16 {
        for i in 1..n {
            let x = xs[i];
            let mut j = i;
            while (j > 0) and (xs[j - 1] > x) {
                xs[j] = xs[j - 1];
                j -= 1;
            }
            xs[j] = x;
        }
        return;
    }
    let mid = n / 2;
    merge_sort(xs[..mid], tmp[..mid]);
    merge_sort(xs[mid..], tmp[mid..]);
    let mut a: usize = 0;
    let mut b = mid;
    let mut k: usize = 0;
    while k < n {
        if (a < mid) and ((b >= n) or (xs[a] <= xs[b])) {
            tmp[k] = xs[a];
            a += 1;
        } else {
            tmp[k] = xs[b];
            b += 1;
        }
        k += 1;
    }
    for i in 0..n {
        xs[i] = tmp[i];
    }
}

export fn main() i32 {
    let n: usize = 2_000_000;
    let xs = mem.alloc.[u64](n) catch return 1;
    let tmp = mem.alloc.[u64](n) catch return 1;
    let mut s: u64 = 88172645463325252;
    for i in 0..n {
        s ^= s << 13;
        s ^= s >> 7;
        s ^= s << 17;
        xs[i] = s;
    }
    vec.sort(xs, less);
    let mut check: u64 = 0;
    for i in 1..n {
        if xs[i - 1] > xs[i] {
            return 2;
        }
        check +%= xs[i] *% @as(u64, i);
    }
    for i in 0..n {
        s ^= s << 13;
        s ^= s >> 7;
        s ^= s << 17;
        xs[i] = s;
    }
    merge_sort(xs, tmp);
    for i in 1..n {
        if xs[i - 1] > xs[i] {
            return 3;
        }
        check +%= xs[i];
    }
    c.result("sort", check);
    return 0;
}
