// The allocator, one thread: linked structures built and freed whole
// (complete binary trees of 32-byte nodes, and lists of 48-byte nodes
// freed in the order they were built).
import "common.ax" as c;
import "std/mem" as mem;

struct Node {
    left: usize,  // 0: none
    right: usize,
    value: u64,
}

struct Item {
    next: usize,
    a: u64,
    b: u64,
    c: u64,
    d: u64,
}

fn build(depth: u32, v: u64) usize {
    if depth == 0 {
        return 0;
    }
    let l = build(depth - 1, v *% 2);
    let r = build(depth - 1, (v *% 2) +% 1);
    let n = mem.create(Node.{ left: l, right: r, value: v }) catch return 0;
    return @int_from_ptr(n);
}

fn sum_free(t: usize) u64 {
    if t == 0 {
        return 0;
    }
    let n = @ptr_from_int(*mut Node, t);
    let s = (n.value +% sum_free(n.left)) +% sum_free(n.right);
    mem.destroy(n);
    return s;
}

fn list(len: u64) u64 {
    let mut head: usize = 0;
    let mut tail: usize = 0;
    for i in @as(u64, 0)..len {
        let it = mem.create(Item.{ next: 0, a: i, b: i, c: i, d: i }) catch return 0;
        if tail != 0 {
            @ptr_from_int(*mut Item, tail).next = @int_from_ptr(it);
        } else {
            head = @int_from_ptr(it);
        }
        tail = @int_from_ptr(it);
    }
    let mut s: u64 = 0;
    while head != 0 {
        let h = @ptr_from_int(*mut Item, head);
        s +%= h.a;
        head = h.next;
        mem.destroy(h);
    }
    return s;
}

export fn main() i32 {
    let mut sum: u64 = 0;
    for r in @as(u64, 0)..40 {
        sum +%= sum_free(build(18, r));
        sum +%= list(200_000);
    }
    c.result("tree", sum);
    return 0;
}
