// An integer reduction: the sum of a u32 array that stays in the first-level
// cache, written with `+%`, which wraps in every mode. reduce_sum.ax is the
// same with `+`, which --overflow=trap checks.
import "common.ax" as c;
import "std/mem" as mem;

fn sum(a: []u32) u32 {
    let mut s: u32 = 0;
    for i in 0..a.len {
        s +%= a[i];
    }
    return s;
}

export fn main() i32 {
    let n: usize = 4096;
    let a = mem.alloc.[u32](n) catch return 1;
    let mut x: u32 = 12345;
    for i in 0..n {
        x = (x *% 1103515245) +% 12345;
        a[i] = (x >> 16) & 1023;
    }
    let mut total: u64 = 0;
    for r in 0..@as(usize, 2_000_000) {
        a[r & (n - 1)] = @truncate(u32, r) & 1023;
        total = (total *% 31) +% @as(u64, sum(a));
    }
    c.result("sum", total);
    return 0;
}
