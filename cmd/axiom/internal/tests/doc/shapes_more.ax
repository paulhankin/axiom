// Part of shapes.ax: functions with a long signature and with any error.

/// A polygon from its corners, which are copied; any error of the
/// allocator.
pub fn polygon(corners: []Point, closed: bool, scale_by: f64, offset_x: f64, offset_y: f64, tag: u32,
               rotate_by: f64) !Shape {
    _ = closed;
    _ = scale_by;
    _ = offset_x;
    _ = offset_y;
    _ = tag;
    _ = rotate_by;
    if corners.len < 3 {
        return error.Degenerate;
    }
    return Shape.Polygon(corners);
}
