// units.ax - units of length, for shapes.ax (a fixture for axiom doc).

/// A unit that is not known.
pub error UnitError { UnknownUnit }

/// How many of the module's units one `unit` is: "m" (1) or "cm" (0.01).
pub fn scale(unit: []u8) UnitError!f64 {
    if (unit.len == 1) and (unit[0] == 'm') {
        return 1.0;
    }
    if (unit.len == 2) and (unit[0] == 'c') and (unit[1] == 'm') {
        return 0.01;
    }
    return error.UnknownUnit;
}
