// =============================================================================
// shapes.ax - shapes in the plane: a fixture for axiom doc's golden outputs.
//
// The first comment block of a file is its module's summary. This module
// has an item of each kind, a part file and an error set from another
// module.
// =============================================================================
import "units.ax" as units;
import part "shapes_more.ax";

/// Why a shape cannot be made.
pub error ShapeError { Degenerate, TooLarge }

/// Every error the functions here return: ShapeError's and units.UnitError's.
pub error AnyError = ShapeError | units.UnitError;

/// The largest coordinate a shape may have.
pub const LIMIT: f64 = 1.0e9;

/// How many shapes have been made.
pub let mut made: u64 = 0;

/// A point in the plane. Its coordinates are in the module's unit.
pub struct Point {
    pub x: f64,  // to the right
    /// Upwards.
    pub y: f64,
    tag: u32,

    /// The origin, (0, 0).
    pub fn origin() Point {
        return Point.{ x: 0.0, y: 0.0, tag: 0 };
    }

    /// The distance to another point. Never negative.
    pub fn dist(self: *Point, o: *Point) f64 {
        let dx = self.x - o.x;
        let dy = self.y - o.y;
        return @sqrt((dx * dx) + (dy * dy));
    }

    pub fn undocumented(self: *Point) f64 {
        return self.x;
    }

    fn hidden(self: *Point) f64 {
        return self.y;
    }
}

/// A shape: a circle or a polygon.
pub union Shape {
    Circle: f64,  // its radius
    Polygon: []Point,
    Empty,
}

/// The four directions, e.g. for a compass. They are numbered clockwise.
pub enum Dir: u8 {
    North = 0,
    East = 1,
    South,
    West,
}

/// A circle of radius r, or an error if r is not positive or is too large
/// (over LIMIT).
///
///     let c = shapes.circle(2.0)!;
pub fn circle(r: f64) ShapeError!Shape {
    if r <= 0.0 {
        return error.Degenerate;
    }
    if r > LIMIT {
        return error.TooLarge;
    }
    made += 1;
    return Shape.Circle(r);
}

/// A circle of a radius in some unit.
pub fn circle_in(r: f64, unit: []u8) AnyError!Shape {
    let s = units.scale(unit)!;
    return circle(r * s)!;
}

/// The area of a shape, in square units.
pub fn area(s: Shape, pi: f64) f64 {
    match s {
        .Circle(r) => { return pi * r * r; }
        else       => { return 0.0; }
    }
}

pub fn no_doc() void {}

fn private_helper() void {}

test "circle" {
    _ = circle(1.0)!;
}
