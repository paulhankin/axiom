// The types and variables of an Axiom program in its debug information
// (run.mjs, "debug information"; dwarf.mjs reads it): a structure, an
// enumeration, a union (a variant part), a slice, an array, an error union,
// a global, and a block of its own with a variable; optimized (-O2), a
// vector wider than the target's registers in its 128-bit pieces.
import "std/os" as os;

struct Point {
    x: i32,
    y: f64,
}

enum Color: u8 {
    Red,
    Green = 5,
    Blue,
}

union Shape {
    Circle: f64,
    Rect: Point,
    Empty,
}

error { Bad }

let mut COUNT: i64 = 7;

fn area(s: Shape) f64 {
    match s {
        .Circle(r) => { return r * r * 3.0; }
        .Rect(p)   => { return @float_from_int(f64, p.x) * p.y; }
        .Empty     => { return 0.0; }
    }
}

fn check(x: i64) !i64 {
    if x < 0 {
        return error.Bad;
    }
    return x * 2;
}

fn sum(xs: []i32) i64 {
    let mut s: i64 = 0;
    for i in 0..xs.len {
        let v = xs[i];
        s += @as(i64, v);
    }
    return s;
}

let mut WIDE: f32 = 0.0;

// (a 256-bit vector: on x86-64 without AVX and on AArch64, two 128-bit
// halves in registers, its location a piece each)
fn wide(n: i64) f32 {
    let a: f32x8 = @splat(@float_from_int(f32, n));
    let mut w: f32x8 = a * a;
    WIDE = @extract_lane(w, 1);
    w = w + a;
    WIDE = @extract_lane(w, 6);
    return @extract_lane(w, 0) + WIDE;
}

export fn main() i32 {
    let p = Point.{ x: 3, y: 2.5 };
    let c = Color.Green;
    let sh = Shape.Rect(p);
    let arr: [4]i32 = [1, 2, 3, 4];
    let sl = arr[..];
    let e = check(@as(i64, @int_cast(i64, os.arg_count())));
    let total = sum(sl);
    let a = area(sh);
    COUNT += total;
    if c == Color.Green {
        let inner = total + 1;
        COUNT += inner;
    }
    let ev = e catch 0;
    COUNT += ev;
    WIDE = wide(COUNT);
    return @int_cast(i32, total) + @int_from_float(i32, a);
}
