// The debug information of an Axiom program (run.mjs, "debug information";
// dwarf.mjs checks it): a leaf, a loop with calls, a recursion, an error
// path, a call in tail position.
import "std/os" as os;

let mut SINK: i64 = 0;

fn leaf(x: i64) i64 {
    return x * 3 + 1;
}

fn many(a: i64, b: i64, c: i64, d: i64) i64 {
    let mut s: i64 = 0;
    for i in 0..a {
        s += leaf(i) * b + c * d;  // line: many-loop
        SINK = s;
    }
    return s + a * b * c * d;
}

fn fib(n: i64) i64 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

error { Negative }

fn check(x: i64) !i64 {
    if x < 0 {
        return error.Negative;
    }
    return many(x, 2, 3, 4);
}

fn tail(x: i64) i64 {
    if x > 100 {
        return x;
    }
    return fib(x % 10);  // line: tail-call
}

export fn main() i32 {
    let a = check(@as(i64, @int_cast(i64, os.arg_count())) + 4) catch 0;  // (nothing folds away)
    let b = tail(a);
    return @int_cast(i32, (a + b) % 2);
}
