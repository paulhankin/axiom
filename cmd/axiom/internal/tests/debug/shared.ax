// A program whose WebAssembly module has a shared memory (it locks a
// mutex: std/sync), so a start function, last in the code section, sets
// its data up: the debug information has a subprogram for it too (run.mjs,
// "debug information"; dwarf.mjs checks that every function has one).
import "std/os" as os;
import "std/sync" as sync;

let mut M: sync.Mutex = sync.Mutex.{ state: 0 };
let mut TOTAL: i64 = 0;

fn add(x: i64) void {
    M.lock();
    TOTAL += x;
    M.unlock();
}

export fn main() i32 {
    add(@as(i64, @int_cast(i64, os.arg_count())));
    return @int_cast(i32, TOTAL % 2);
}
