// The host's local zone (tz.Zone.from_host: on WebAssembly, the zone the
// node host builds from what its JavaScript engine knows of $TZ) against
// the database's zone of the name given: the offsets every few days from
// 1901 to 2150, and at the database's transitions from 1970 to 2037, and the
// daylight saving flags from 1970. Prints the mismatches; status 3 if
// there is no database (run.mjs, section std/internal/runtime/host.mjs).
import "std/io" as io;
import "std/os" as os;
import "std/time/tz" as tz;

export fn main() i32 {
    let name = os.arg(1) catch return 2;
    let mut db = tz.Zone.load(name) catch return 3;
    let mut h = tz.Zone.from_host() catch return 4;
    let mut bad: u64 = 0;
    let mut t: i64 = -2177452800;  // 1901
    while t < 5680281600 {         // 2150
        let a = db.lookup(t);
        let b = h.lookup(t);
        if (a.offset != b.offset) or ((t >= 0) and (a.is_dst != b.is_dst)) {
            bad += 1;
        }
        t += (86400 * 3) + 3607;
    }
    for x in db.trans {
        if (x >= 0) and (x < 2147483647) {
            for d in [@as(i64, -1), 0] {
                let a = db.lookup(x + d);
                let b = h.lookup(x + d);
                if (a.offset != b.offset) or (a.is_dst != b.is_dst) {
                    bad += 1;
                }
            }
        }
    }
    let mut buf: [24]u8 = [0; 24];
    io.stdout().println(io.fmt_u64(buf[..], bad)) catch return 1;
    return 0;
}
