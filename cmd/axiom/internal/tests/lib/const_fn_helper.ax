// Helper module for tests/run/const_fn_generics.ax and negative visibility checks.
pub inline fn mul_add(a: i32, b: i32) i32 {
    return (a * b) + 1;
}

pub fn eq_i32(a: i32, b: i32) bool {
    return a == b;
}

fn secret(x: i32) i32 {
    return x + 1;
}

pub struct Ops {
    bias: i32,

    pub fn combine(a: i32, b: i32) i32 {
        return (a * 10) + b;
    }

    pub fn id[T](x: T) T {
        return x;
    }
}
