// A module with a public error set, for run/error_sets.ax.
pub error FileError { NotFound, PermissionDenied }

pub fn open(name: []u8) FileError!u32 {
    if name.len == 0 {
        return error.NotFound;
    }
    if name[0] == 'x' {
        return error.PermissionDenied;
    }
    return @int_cast(u32, name.len);
}
