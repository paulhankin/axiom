// cmd/axiom/internal/tests/lib/byte_sums.ax - sums of neighbouring bytes, which the self-hosted
// compiler makes vector sums (psadbw) on x86-64 once the loops are unrolled
// (cmd/axiom/internal/tests/run/byte_sums.ax, byte_sums_sse2.ax): the results must be those of
// the scalar adds, wrapping at the sum's width.
import "io.ax" as io;

let mut BOARD: [2][25]u8 = [[0; 25]; 2];
let mut BYTES: [64]u8 = [0; 64];

// checker counts as bytes (wrapping at 8 bits), both sides interleaved
fn counts() u64 {
    let raw = &BOARD;
    let mut t0: u8 = 0;
    let mut t1: u8 = 0;
    for i in @as(usize, 0)..24 {
        t0 += raw[0][i];
        t1 += raw[1][i];
    }
    return (@as(u64, t0) << 8) | @as(u64, t1);
}

fn sum25(side: *[25]u8) u32 {
    let mut s: u32 = 0;
    for i in @as(usize, 0)..25 {
        s +%= @as(u32, side[i]);
    }
    return s;
}

// 16 bytes into 16 bits, 9 into 64, 40 (two vectors and 8 more), 13 (a tail
// of more than 8)
fn sum16(p: *[64]u8) u16 {
    let mut s: u16 = 0;
    for i in @as(usize, 0)..16 {
        s +%= @as(u16, p[i + 3]);
    }
    return s;
}

fn sum9(p: *[64]u8) u64 {
    let mut s: u64 = 0;
    for i in @as(usize, 0)..9 {
        s += @as(u64, p[i + 50]);
    }
    return s;
}

fn sum40(p: *[64]u8) u32 {
    let mut s: u32 = 0;
    for i in @as(usize, 0)..40 {
        s += @as(u32, p[i + 1]);
    }
    return s;
}

fn sum13(p: *[64]u8) u8 {
    let mut s: u8 = 0;
    for i in @as(usize, 0)..13 {
        s +%= p[i + 51];
    }
    return s;
}

// other terms in the sum, and bytes that are not neighbours
fn mixed(p: *[64]u8, x: u32) u32 {
    let mut s: u32 = x * 3;
    for i in @as(usize, 0)..12 {
        s += @as(u32, p[i]) + @as(u32, p[(2 * i) + 30]);
    }
    return s;
}

// a store between the loads: the sum reads what the loop wrote
fn with_store(p: *mut [64]u8) u32 {
    let mut s: u32 = 0;
    for i in @as(usize, 0)..12 {
        s += @as(u32, p[i]);
        p[i + 1] = 7;
    }
    return s;
}

// the same bytes twice
fn twice(p: *[64]u8) u32 {
    let mut s: u32 = 0;
    for i in @as(usize, 0)..10 {
        s += @as(u32, p[i]) + @as(u32, p[i]);
    }
    return s;
}

pub fn check() void {
    for i in @as(usize, 0)..25 {
        BOARD[0][i] = @truncate(u8, (i * 37) + 11);
        BOARD[1][i] = @truncate(u8, (i * 101) + 200);
    }
    for i in @as(usize, 0)..64 {
        BYTES[i] = @truncate(u8, (i * 73) + 5);
    }
    io.uint(counts());
    io.uint(@as(u64, sum25(&BOARD[0])));
    io.uint(@as(u64, sum25(&BOARD[1])));
    io.uint(@as(u64, sum16(&BYTES)));
    io.uint(sum9(&BYTES));
    io.uint(@as(u64, sum40(&BYTES)));
    io.uint(@as(u64, sum13(&BYTES)));
    io.uint(@as(u64, mixed(&BYTES, 1000)));
    io.uint(@as(u64, twice(&BYTES)));
    io.uint(@as(u64, with_store(&mut BYTES)));
}
