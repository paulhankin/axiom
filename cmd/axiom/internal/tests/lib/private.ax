// A module with private items, for the visibility error tests.
pub fn shown() u32 {
    return 1;
}

fn hidden() u32 {
    return 2;
}

pub struct Counter {
    n: u32,

    pub fn new() Counter {
        return Counter.{ n: 0 };
    }

    fn make() Counter {
        return Counter.{ n: 1 };
    }

    pub fn get(self: *Counter) u32 {
        return self.n;
    }

    fn bump(self: *mut Counter) void {
        self.n += 1;
    }
}
