// Helper module for Phase 3.2 field visibility and struct const tests.

pub struct Pair {
    pub x: u32,
    y: u32,

    pub fn make(x: u32, y: u32) Pair {
        return Pair.{ x: x, y: y };
    }

    pub fn sum(self: *Pair) u32 {
        return self.x + self.y;
    }
}

pub const DEFAULT_PAIR: Pair = Pair.{ x: 10, y: 20 };

pub struct MixedInline {
    pub inline: u32,
    secret: u32,

    pub inline fn get_secret(self: *MixedInline) u32 {
        return self.secret;
    }
}

pub fn make_mixed(a: u32, b: u32) MixedInline {
    return MixedInline.{ inline: a, secret: b };
}

pub fn make_anon() struct { a: i32, b: i32 } {
    return .{ a: 7, b: 8 };
}
