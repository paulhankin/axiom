// Part B of the multipart test module: binds `lib` to "std/math" (independent of part_a.ax)
// and imports a sibling helper via relative "../" path.
import "../answer.ax" as ans;
import "std/math" as lib;

fn is_odd(n: i32) bool {
    if n == 0 {
        return false;
    }
    if n < 0 {
        return is_odd(-n);
    }
    return is_even(n - 1);
}

fn read_and_scale_from_b(s: *Secret, factor: i32) i32 {
    return (s.val * factor) + part_a_helper(s.val);
}

fn b_math_and_answer() i32 {
    let mut score = @int_cast(i32, ans.value());
    if lib.is_finite(lib.PI) and (lib.PI > 3.0) {
        score += 8;
    }
    return score;
}
