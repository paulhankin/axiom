// Multi-file module test entry file (spec §4.1).
import part "part_a.ax";
import part "part_b.ax";
import "std/str" as text;

struct Secret {
    val: i32,
}

let mut module_state: i32 = 10;

fn mod_helper(x: i32) i32 {
    return x + 5;
}

pub fn check_even(n: i32) bool {
    return is_even(n);
}

pub fn check_odd(n: i32) bool {
    return is_odd(n);
}

pub fn run_secret_flow(initial: i32, tag: []u8) i32 {
    let mut s = Secret.{ val: initial };
    bump_from_a(&mut s, 5);
    let b_seen = read_and_scale_from_b(&s, 2);
    let a_val = part_a_helper(3);
    let mut bonus: i32 = 0;
    if text.eq(tag, "boost") {
        bonus = 4;
    }
    return s.val + b_seen + a_val + bonus + module_state;
}

pub fn check_part_imports(s: []u8, prefix: []u8) i32 {
    let ok = a_has_prefix(s, prefix);
    let b_score = b_math_and_answer();
    if ok {
        return b_score + 1;
    }
    return b_score;
}

pub fn call_part_a_err(x: i32) i32 {
    let v = part_a_fallible(x) catch |e| {
        match e {
            error.PartAErr => { return -100; }
        }
    };
    return v;
}
