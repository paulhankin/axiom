// Part A of the multipart test module: binds `lib` to "std/str".
import "std/str" as lib;

fn part_a_helper(x: i32) i32 {
    return x * 2;
}

fn is_even(n: i32) bool {
    if n == 0 {
        return true;
    }
    if n < 0 {
        return is_even(-n);
    }
    return is_odd(n - 1);
}

fn bump_from_a(s: *mut Secret, amount: i32) void {
    s.val += amount;
    module_state += 1;
}

fn a_has_prefix(s: []u8, prefix: []u8) bool {
    return lib.starts_with(s, prefix);
}

pub fn part_a_fallible(x: i32) { PartAErr }!i32 {
    if x < 0 {
        return error.PartAErr;
    }
    return mod_helper(x);
}
