// The main module for the separate-compilation test (cmd/axiom/internal/tests/run.mjs, "units").
import "lib.ax" as lib;
import "std/io" as io;

threadlocal let mut scratch: u64 = 3;

struct Point {
    x: i64,
}

export fn main() i32 {
    let out = io.stdout();
    let p = lib.Pair.[i64].{ a: 20, b: 22 };
    out.print_i64(p.a + p.second()) catch return 1;
    out.println("") catch return 1;
    let q = lib.Pair.[Point].{ a: Point.{ x: 1 }, b: Point.{ x: 2 } };
    out.print_i64(q.a.x + q.second().x) catch return 1;
    out.println("") catch return 1;
    let xs: [3]u32 = [4, 9, 2];
    out.print_u64(@as(u64, lib.largest(xs[..]) catch 0)) catch return 1;
    out.println("") catch return 1;
    let big: [2]u32 = [4, 5000];
    _ = lib.largest(big[..]) catch |e| {
        out.println(lib.describe(e)) catch return 1;
        out.println(@error_name(e)) catch return 1;
        scratch += lib.calls;
        out.print_u64(scratch) catch return 1;
        out.println("") catch return 1;
        return 0;
    };
    return 0;
}
