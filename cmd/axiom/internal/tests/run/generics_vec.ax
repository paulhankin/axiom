// Generics over float vector types: the FloatVector constraint (spec §10.5).
import "../lib/io.ax" as io;

/// a * x + y, then halved, a vector at a time: the same code for any width
/// and lane type.
fn axpy_half[V: FloatVector](a: V, x: []V, y: []mut V) void {
    let half: V = @splat(0.5);
    for i in 0..y.len {
        y[i] = @fma(a, x[i], y[i]) * half;
    }
}

/// The running maximum of |xs[i] - 1|, loaded from a slice of lanes.
fn max_dist[V: FloatVector](xs: []f32) V {
    let one: V = @splat(1);
    let lanes = @size_of(V) / 4;
    let mut best: V = @splat(0.0);
    let mut i: usize = 0;
    while (i + lanes) <= xs.len {
        best = @max(best, @abs(@load(V, xs[i..i + lanes]) - one));
        i += lanes;
    }
    let mut out: [4]f32 = [0.0; 4];
    @store(out[0..lanes], -(-best));
    return best;
}

export fn run() void {
    let x: [2]f32x4 = [@vec(f32x4, 1.0, 2.0, 3.0, 4.0), @splat(10.0)];
    let mut y: [2]f32x4 = [@splat(1.0), @splat(2.0)];
    let two: f32x4 = @splat(2.0);
    axpy_half(two, x[..], y[..]);
    io.float(@as(f64, @extract_lane(y[0], 3)));  // expect: 4.5
    io.float(@as(f64, @reduce_add(y[1])));       // expect: 44
    let xd: [1]f64x2 = [@vec(f64x2, 0.25, 8.0)];
    let mut yd: [1]f64x2 = [@splat(0.0)];
    axpy_half.[f64x2](@splat(4.0), xd[..], yd[..]);
    io.float(@extract_lane(yd[0], 0));  // expect: 0.5
    io.float(@extract_lane(yd[0], 1));  // expect: 16
    let xs: [8]f32 = [1.0, -2.0, 0.5, 1.0, 4.0, 1.0, 1.0, 1.0];
    let m = max_dist.[f32x4](xs[..]);
    io.float(@as(f64, @reduce_add(m)));  // expect: 6.5
}
