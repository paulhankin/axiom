// A sum whose bound does not fit its type keeps its overflow check, at
// every optimization level.
// expect-trap
// flags: --overflow=trap
import "../lib/io.ax" as io;

fn sum(xs: *[2]u8) u8 {
    let mut t: u8 = 0;
    for x in xs.* {
        t += x;
    }
    return t;
}

export fn run() void {
    let xs: [2]u8 = [200, 100];
    io.uint(@as(u64, sum(&xs)));
}
