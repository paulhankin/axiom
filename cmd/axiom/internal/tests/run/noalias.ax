// Contextual `noalias` parameter qualifier on pointers and slices.
import "../lib/io.ax" as io;

struct Accum {
    total: u64,

    pub fn add_slice(self: *mut Accum, noalias xs: []u64) void {
        for x in xs {
            self.total += x;
        }
    }
}

fn copy_u32(noalias dst: []mut u32, src: []u32) void {
    let n = @min(dst.len, src.len);
    for i in 0..n {
        dst[i] = src[i];
    }
}

inline fn scale_add(noalias dst: *mut u64, src: *u64, k: u64) void {
    dst.* += src.* * k;
}

fn copy_generic[T](noalias dst: []mut T, noalias src: []T) void {
    let n = @min(dst.len, src.len);
    for i in 0..n {
        dst[i] = src[i];
    }
}

// `noalias` remains a valid identifier when followed by `:`.
fn shadow_name(noalias: u64) u64 {
    return noalias + 1;
}

export fn run() void {
    let mut dst: [4]u32 = [0; 4];
    let src: [4]u32 = [10, 20, 30, 40];
    copy_u32(dst[..], src[..]);
    io.uint(@as(u64, (dst[0] + dst[1]) + (dst[2] + dst[3])));  // expect: 100

    let mut a: u64 = 5;
    let b: u64 = 7;
    scale_add(&mut a, &b, 3);
    io.uint(a);  // expect: 26

    let mut gdst: [3]u64 = [0; 3];
    let gsrc: [3]u64 = [11, 22, 33];
    copy_generic(gdst[..], gsrc[..]);
    io.uint((gdst[0] + gdst[1]) + gdst[2]);  // expect: 66

    let mut acc = Accum.{ total: 4 };
    acc.add_slice(gsrc[..]);
    io.uint(acc.total);  // expect: 70

    io.uint(shadow_name(9));  // expect: 10
}
