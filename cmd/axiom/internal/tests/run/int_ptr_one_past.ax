// A pointer made from an integer comes from any exposed object (spec §12.1),
// even when the integer is the address of a pointer from another object: one
// just past the end of A is also the address of B when B follows A, and a
// store through it may change B.
// flags: -O1
// selfhost-only
import "../lib/io.ax" as io;

let mut A: [4]u32 = [0, 0, 0, 0];
let mut B: [4]u32 = [0, 0, 0, 0];

fn past_a(n: usize) u64 {
    let p = @ptr_add(@as(*mut u32, &mut A[0]), n);
    B[0] = 1;
    let q = @ptr_from_int(*mut u32, @int_from_ptr(p));
    q.* = 2;
    return @as(u64, B[0]);
}

fn past_b(n: usize) u64 {
    let p = @ptr_add(@as(*mut u32, &mut B[0]), n);
    A[0] = 1;
    let q = @ptr_from_int(*mut u32, @int_from_ptr(p));
    q.* = 2;
    return @as(u64, A[0]);
}

export fn run() void {
    // (through pointers: n is not a constant in the callees)
    let fs = [past_a, past_a];
    let gs = [past_b, past_b];
    let k = @int_cast(usize, A[1] & 1);
    let a = @int_from_ptr(&A);
    let b = @int_from_ptr(&B);
    if b == (a + 16) {
        io.uint(fs[k](4));
    } else if a == (b + 16) {
        io.uint(gs[k](4));
    } else {
        io.str("not adjacent");
    }
}
// expect: 2
