// A loop phi holds the value its back edge had in the previous iteration:
// while a proof assumes the condition of a join's edge (this iteration's
// `i < n`), that fact does not hold for the phi j's back-edge value i
// (gvn deciding `s < n` and `s <= 10` for s = j or 0).
// flags: -O2
import "../lib/io.ax" as io;

fn below_n(xs: []u64, n: u64) u64 {
    if n == 0 {
        return 0;
    }
    let mut j: u64 = 0;
    for k in 0..xs.len {
        let i = xs[k];
        let mut s: u64 = 0;
        if i < n {
            s = j;
        }
        if s < n {
            io.int(1);
        } else {
            io.int(1000);
        }
        j = i;
    }
    return j;
}

fn at_most_10(xs: []u64) u64 {
    let mut j: u64 = 10;
    for k in 0..xs.len {
        let i = xs[k];
        let mut s: u64 = 0;
        if i < 5 {
            s = j;
        }
        if s <= 10 {
            io.int(1);
        } else {
            io.int(1000);
        }
        j = i;
    }
    return j;
}

let mut F: fn([]u64, u64) u64 = below_n;
let mut G: fn([]u64) u64 = at_most_10;
let mut XS: [2]u64 = [100, 3];

export fn run() void {
    io.uint(F(XS[..], 10));
    io.uint(G(XS[..]));
}
// expect: 1
// expect: 1000
// expect: 3
// expect: 1
// expect: 1000
// expect: 3
