// Without the bulk-memory extension, @mem_set and @mem_copy of a length not
// known at compile time are loops (WebAssembly); on wasm64 the byte
// @mem_set stores is still an i32.
// wasm-only
// selfhost-only (the bootstrap compiler links no wasm64 module)
// flags: --target=wasm64 --features=-bulk-memory
import "../lib/io.ax" as io;

// (mutable: the call is not inlined, and the argument not a constant in the
// callee)
let mut FILL: fn(usize) void = fill;

fn fill(n: usize) void {
    let mut a: [64]u8 = [0; 64];
    let mut b: [64]u8 = [0; 64];
    @mem_set(a[0..n], 7);
    @mem_copy(b[0..n], a[0..n]);
    @mem_set(b[0..n / 2], 3);
    @mem_copy(b[1..n + 1], b[0..n]);
    let mut s: u64 = 0;
    for x in a {
        s += @as(u64, x);
    }
    io.uint(s);
    s = 0;
    for x in b {
        s = s * 3 + @as(u64, x);
    }
    io.uint(s);
}

export fn run() void {
    FILL(10);
}

// expect: 70
// expect: 6423640565393083041
