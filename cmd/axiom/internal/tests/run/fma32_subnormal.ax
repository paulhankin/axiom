// @fma of f32 with a subnormal result, where x * y + z lies just off the
// midpoint between two floats: the f64 sum rounds onto the midpoint, so
// the software fma32 (without hardware fused multiply-add: baseline x86-64
// and wasm) must round it to odd first rather than round a second time.
// Scalar and through f32x4 lanes.
// x86-64-flags: --cpu=x86-64
import "../lib/io.ax" as io;

// (x, y, z) bits, each followed by the correctly rounded result's bits
let mut G: [20]u32 = [
    436207624,
    436207600,
    4194305,
    4194305,
    830472176,
    41943048,
    1439007,
    1439007,
    595591169,
    276824062,
    2148574407,
    2148574407,
    780140542,
    92274689,
    7597371,
    7597371,
    612367872,
    260047104,
    2155654739,
    2155654739,
];

fn f(i: usize) f32 {
    return @bit_cast(f32, G[i]);
}

fn bits(x: f32) void {
    io.uint(@as(u64, @bit_cast(u32, x)));
}

export fn run() void {
    let mut i: usize = 0;
    while i < 20 {
        bits(@fma(f(i), f(i + 1), f(i + 2)));
        i += 4;
    }
    let x = @vec(f32x4, f(4), f(8), f(12), f(16));
    let y = @vec(f32x4, f(5), f(9), f(13), f(17));
    let z = @vec(f32x4, f(6), f(10), f(14), f(18));
    let r = @fma(x, y, z);
    bits(@extract_lane(r, 0));
    bits(@extract_lane(r, 1));
    bits(@extract_lane(r, 2));
    bits(@extract_lane(r, 3));
}
// expect: 4194305
// expect: 1439007
// expect: 2148574407
// expect: 7597371
// expect: 2155654739
// expect: 1439007
// expect: 2148574407
// expect: 7597371
// expect: 2155654739
