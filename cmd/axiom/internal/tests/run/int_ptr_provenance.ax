// A pointer made from an integer comes from any exposed object (spec §12.1),
// even when the integer is another object's address plus an offset: the
// address of A plus the distance to B points into B, and a store through it
// may change B.
// flags: -O1
import "../lib/io.ax" as io;

let mut A: [4]u32 = [0, 0, 0, 0];
let mut B: [4]u32 = [0, 0, 0, 0];
let mut D: usize = 0;

fn store_via_int() u64 {
    let ia = @int_from_ptr(&A);
    B[0] = 1;
    let p = @ptr_from_int(*mut u32, ia +% D);
    p.* = 2;
    return @as(u64, B[0]);
}

export fn run() void {
    D = @int_from_ptr(&B) -% @int_from_ptr(&A);
    io.uint(store_via_int());
}
// expect: 2
