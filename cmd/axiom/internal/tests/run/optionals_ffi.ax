// C FFI with ?*T, ?*mut T, and ?fn(...) (spec §14.5).
// link: optionals_ffi.c
// header: optionals_ffi_generated.h
import "../lib/io.ax" as io;

extern "C" {
    fn c_maybe_ptr(want: i32) ?*i32;
    fn c_read_or(p: ?*i32, fallback: i32) i32;
    fn c_inc_if_nonnull(p: ?*mut i32) void;
    fn c_call_cb(cb: ?fn(i32) i32, x: i32) i32;
    fn c_call_exported() i32;
}

export fn ax_opt_sum(p: ?*i32) i32 {
    if let .some(v) = p {
        return v.* * 2;
    }
    return 5;
}

fn triple(x: i32) i32 {
    return x * 3;
}

export fn run() void {
    io.int(@as(i64, c_read_or(c_maybe_ptr(1), -1)));  // expect: 42
    io.int(@as(i64, c_read_or(c_maybe_ptr(0), -1)));  // expect: -1
    io.int(@as(i64, c_read_or(.none, 9)));            // expect: 9

    let mut x: i32 = 100;
    c_inc_if_nonnull(&mut x);
    c_inc_if_nonnull(.none);
    io.int(@as(i64, x));  // expect: 101

    io.int(@as(i64, c_call_cb(triple, 7)));  // expect: 21
    io.int(@as(i64, c_call_cb(.none, 7)));   // expect: -1
    io.int(@as(i64, c_call_exported()));     // expect: 25
}
