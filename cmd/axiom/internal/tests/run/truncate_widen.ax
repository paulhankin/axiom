// @truncate to a type at least as wide extends the value by its own type
// (sign-extended if signed, zero-extended if not) and reads it as the target
// (spec §6.2). The values come from memory so nothing folds.
import "../lib/io.ax" as io;

let mut a: i8 = -2;
let mut b: u8 = 254;
let mut c: i32 = -5;
let mut d: u32 = 0x80000000;
let mut e: i64 = -1;

export fn run() void {
    io.int(@as(i64, @truncate(i32, a)));   // expect: -2
    io.uint(@as(u64, @truncate(u32, a)));  // expect: 4294967294
    io.int(@as(i64, @truncate(i32, b)));   // expect: 254
    io.int(@as(i64, @truncate(i16, b)));   // expect: 254
    io.uint(@truncate(u64, a));            // expect: 18446744073709551614
    io.uint(@truncate(u64, c));            // expect: 18446744073709551611
    io.int(@truncate(i64, d));             // expect: 2147483648
    io.uint(@truncate(u64, e));            // expect: 18446744073709551615
    io.int(@as(i64, @truncate(i8, b)));    // expect: -2
}
