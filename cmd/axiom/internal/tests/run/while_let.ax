// `while let`: the scrutinee is evaluated before each iteration, the loop
// ends when the pattern does not match; `break` and `continue` (also with
// a label) apply to it, and a fallible `next()!` passes its error on.
import "../lib/io.ax" as io;

struct Count {
    n: i32,
    max: i32,

    fn next(self: *mut Count) ?i32 {
        if self.n >= self.max {
            return .none;
        }
        self.n += 1;
        return self.n;
    }

    fn try_next(self: *mut Count) Bad!?i32 {
        if self.n >= self.max {
            return .none;
        }
        self.n += 1;
        if self.n == 7 {
            return error.Odd;
        }
        return self.n;
    }
}

error Bad {
    Odd,
}

union Shape {
    Circle: i32,
    Square: i32,
    Empty: void,
}

fn sum_fallible(c: *mut Count) Bad!i32 {
    let mut t: i32 = 0;
    while let .some(v) = c.try_next()! {
        t += v;
    }
    return t;
}

fn first_over(c: *mut Count, k: i32) i32 {
    while let .some(v) = c.next() {
        if v > k {
            return v;
        }
    }
    return -1;
}

fn shapes(s: []Shape) i32 {
    let mut i: usize = 0;
    let mut t: i32 = 0;
    while let .Circle(r) = s[i] {
        t += r;
        i += 1;
    }
    while let .Square, .Empty = s[i] {
        t += 1000;
        i += 1;
    }
    return t;
}

fn sum_deferred(c: *mut Count, log: *mut i32) i32 {
    let mut t: i32 = 0;
    while let .some(v) = c.next() {
        defer log.* += 1;
        if v == 2 {
            continue;
        }
        t += v;
    }
    return t;
}

export fn run() void {
    let mut c = Count.{ n: 0, max: 4 };
    while let .some(v) = c.next() {
        io.int(@as(i64, v));  // expect: 1
    }  // expect: 2
       // expect: 3
       // expect: 4
    let mut d = Count.{ n: 0, max: 10 };
    let mut out: i64 = 0;
    outer: while let .some(a) = d.next() {
        if a == 2 {
            continue;
        }
        let mut e = Count.{ n: 0, max: 10 };
        while let .some(b) = e.next() {
            if b > a {
                continue outer;
            }
            if a == 5 {
                break outer;
            }
            out = out * 10 + @as(i64, b);
        }
    }
    io.int(out);            // expect: 11231234
    io.int(@as(i64, d.n));  // expect: 5

    let mut f = Count.{ n: 0, max: 5 };
    io.int(@as(i64, sum_fallible(&mut f) catch -1));  // expect: 15
    let mut g = Count.{ n: 0, max: 9 };
    io.int(@as(i64, sum_fallible(&mut g) catch -1));  // expect: -1
    io.int(@as(i64, g.n));  // expect: 7

    let mut h = Count.{ n: 0, max: 9 };
    io.int(@as(i64, first_over(&mut h, 3)));   // expect: 4
    io.int(@as(i64, first_over(&mut h, 30)));  // expect: -1

    let mut none = Count.{ n: 0, max: 0 };
    let mut runs: i32 = 0;
    while let .some(_) = none.next() {
        runs += 1;
    }
    io.int(@as(i64, runs));  // expect: 0

    let ss: [6]Shape = [Shape.Circle(2), Shape.Circle(4), Shape.Square(3), Shape.Empty, Shape.Circle(100),
                        Shape.Square(1)];
    io.int(@as(i64, shapes(ss[0..])));  // expect: 2006

    let mut log: i32 = 0;
    let mut k = Count.{ n: 0, max: 4 };
    io.int(@as(i64, sum_deferred(&mut k, &mut log)));  // expect: 8
    io.int(@as(i64, log));  // expect: 4
}
