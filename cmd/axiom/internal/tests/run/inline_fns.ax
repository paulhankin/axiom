// Inline functions (spec §9.5): always inlined, also as methods, generic,
// nested, and used as values; calls into them have no shadow-stack records.
import "../lib/io.ax" as io;

let mut xs: [4]u32 = [1, 2, 3, 4];

inline fn get(i: usize) u32 {
    return xs[i];
}

inline fn pair(i: usize) u32 {
    return get(i) + get(i + 1);
}

pub inline fn larger[T: Ord](a: T, b: T) T {
    if a > b {
        return a;
    }
    return b;
}

struct Acc {
    n: u64,

    inline fn add(self: *mut Self, x: u32) void {
        self.n += @as(u64, x);
    }

    pub inline fn total(self: Self) u64 {
        return self.n;
    }
}

fn sum(n: usize) u32 {
    let mut s: u32 = 0;
    for i in @as(usize, 0)..n {
        s += pair(i);
    }
    return s;
}

fn apply(f: fn(usize) u32, i: usize) u32 {
    return f(i);
}

// hitting-shot style: a bool counted as 0 or 1 (issue 0035)
inline fn count_if(b: bool) u32 {
    return @as(u32, b);
}

export fn run() void {
    io.uint(@as(u64, sum(3)));                  // expect: 15
    io.uint(@as(u64, apply(get, 2)));           // expect: 3
    io.int(@as(i64, larger(-3, @as(i32, 2))));  // expect: 2
    io.uint(@as(u64, larger.[u8](7, 5)));       // expect: 7
    let mut a = Acc.{ n: 0 };
    for i in @as(usize, 0)..4 {
        a.add(get(i));
    }
    io.uint(a.total());  // expect: 10
    let mut c: u32 = 0;
    for i in @as(usize, 0)..4 {
        c += count_if(xs[i] > 2);
    }
    io.uint(@as(u64, c));  // expect: 2
}
