// An `undefined` local whose type holds anything but plain integers, floats
// and vectors is zeroed, whatever its size (spec §8.1): old bytes on the stack
// never become slices, pointers, bools or unions the program did not make.
import "../lib/io.ax" as io;

union Shape {
    Circle: u64,
    Rect: u64,
}

struct Rec {
    name: []u8,
    ok: bool,
    n: u64,
}

let mut gaddr: usize = 0;

// (address and length pairs left on the stack, as from any input)
fn spray(a: usize) usize {
    let mut junk: [512]usize = undefined;
    for i in @as(usize, 0)..512 {
        if (i & 1) == 0 {
            junk[i] = a;
        } else {
            junk[i] = 1000000;
        }
    }
    let mut t: usize = 0;
    for x in junk[..] {
        t +%= x;
    }
    return t;
}

fn slices(k: usize) u64 {
    let mut ss: [64][]mut u64 = undefined;
    return @as(u64, ss[k].len);
}

fn records(k: usize) u64 {
    let mut rs: [32]Rec = undefined;
    let r = rs[k];
    if r.ok {
        return 1;
    }
    return @as(u64, r.name.len) + r.n;
}

fn shapes(k: usize) u64 {
    let mut xs: [64]Shape = undefined;
    match xs[k] {
        .Circle(r) => { return r; }
        .Rect(w)   => { return w + 100; }
    }
}

export fn run() void {
    let mut target: [4]u64 = [1, 2, 3, 4];
    @atomic_store(&mut gaddr, @int_from_ptr(&mut target));
    let f: fn(usize) usize = spray;
    _ = f(@atomic_load(&gaddr));
    let g: fn(usize) u64 = slices;
    io.uint(g(@atomic_load(&gaddr) & 7));  // expect: 0
    _ = f(@atomic_load(&gaddr));
    let h: fn(usize) u64 = records;
    io.uint(h(@atomic_load(&gaddr) & 7));  // expect: 0
    _ = f(@atomic_load(&gaddr));
    let s: fn(usize) u64 = shapes;
    io.uint(s(@atomic_load(&gaddr) & 7));  // expect: 0
}
