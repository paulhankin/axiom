// Jump threading through several blocks (thread.ax, thread_region_of): a
// branch decided by the edge into a block further up, with diamonds in
// between (whose loads are bounds-checked and so not made selects), is
// threaded by copying the blocks between: a comparison implied by an
// earlier one, a flag (a phi of constants), a value of an inlined call's
// error union tested twice, and the values computed in the copied blocks
// used after them. The bounds checks in the copies stay and trap.
// flags: -O2
// expect-trap
// expect: 37387043650500
// expect: 34689
// expect: 22
// expect: 2
// expect: 19
// expect: -1
import "../lib/io.ax" as io;

error E { Missing }

fn implied(x: i32, p: []mut i32, q: []i32, sel: bool) i32 {
    let mut a: i32 = 0;
    if x > 10 {
        a = p[0];
    }
    let mut b: i32 = 1;
    if sel {
        b = q[0];
    }
    p[1] = a + b;
    if x > 5 {
        return a;
    }
    return b;
}

fn flagged(x: i32, p: []i32, q: []i32, sel: bool, out: []mut i32) i32 {
    let mut f = false;
    let mut a: i32 = 0;
    if x != 0 {
        f = true;
        a = p[0];
    }
    let mut b: i32 = 7;
    if sel {
        b = q[1];
    }
    let w = b * 3 + a;
    if f {
        out[0] = w;
    } else {
        out[1] = w;
    }
    return w + b;
}

fn find(xs: []i32, k: i32) E!usize {
    for i in 0..xs.len {
        if xs[i] == k {
            return i;
        }
    }
    return error.Missing;
}

fn twice(xs: []i32, k: i32, q: []i32, sel: bool) i32 {
    let r = find(xs, k);
    let mut b: i32 = 0;
    if sel {
        b = q[0];
    }
    let i = r catch return b - 1;
    return b + @int_cast(i32, i);
}

let mut IMPLIED: fn(i32, []mut i32, []i32, bool) i32 = implied;
let mut FLAGGED: fn(i32, []i32, []i32, bool, []mut i32) i32 = flagged;
let mut TWICE: fn([]i32, i32, []i32, bool) i32 = twice;
let mut XS: [8]i32 = [-2147483648, -1, 0, 5, 6, 10, 11, 2147483647];

export fn run() void {
    let mut p: [2]i32 = [3, 0];
    let q: [2]i32 = [20, 30];
    let mut sum: i64 = 0;
    for i in @as(usize, 0)..8 {
        for s in @as(i32, 0)..2 {
            sum = sum * 7 + @as(i64, IMPLIED(XS[i], p[..], q[..], s == 1)) + @as(i64, p[1]);
        }
    }
    io.int(sum);
    let mut out: [2]i32 = [0, 0];
    sum = 0;
    for x in @as(i32, 0)..3 {
        for s in @as(i32, 0)..2 {
            sum = sum * 3 + @as(i64, FLAGGED(x - 1, p[..], q[..], s == 1, out[..])) + @as(i64, out[0] - out[1]);
        }
    }
    io.int(sum);
    let ys: [3]i32 = [4, 5, 6];
    io.int(@as(i64, TWICE(ys[..], 6, q[..], true)));
    io.int(@as(i64, TWICE(ys[..], 6, q[..], false)));
    io.int(@as(i64, TWICE(ys[..], 9, q[..], true)));
    io.int(@as(i64, TWICE(ys[..], 9, q[..], false)));
    // an empty q: the copy's bounds check traps
    io.int(@as(i64, IMPLIED(11, p[..], q[0..0], true)));
}
