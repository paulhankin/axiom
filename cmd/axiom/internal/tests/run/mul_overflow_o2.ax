// Checked 64-bit multiplication at -O2, where the overflow intrinsics give
// the check (at -O0 on wasm it divides back), and operands
// extended from 32 bits, whose product needs no check.
// flags: -O2
// flags: --overflow=trap
import "../lib/io.ax" as io;

let mut us: [6]u64 = [0, 1, 2, 3, 0xFFFF_FFFF, 0x5555_5555_5555_5555];
let mut ss: [6]i64 = [0, 1, -1, 2, -2, 0x3FFF_FFFF_FFFF_FFFF];
let mut ws: [3]u32 = [0, 0xFFFF_FFFF, 0x8000_0000];
let mut is: [3]i32 = [-0x7FFF_FFFF - 1, 0x7FFF_FFFF, -1];

fn show(r: !u64) void {
    let v = r catch |e| {
        io.str(@error_name(e));
        return;
    };
    io.uint(v);
}

fn shows(r: !i64) void {
    let v = r catch |e| {
        io.str(@error_name(e));
        return;
    };
    io.int(v);
}

export fn run() void {
    show(@mul_checked(us[4] + 1, us[4]));                       // expect: 18446744069414584320
    show(@mul_checked(us[4] + 1, us[4] + 1));                   // expect: Overflow
    show(@mul_checked(us[5], us[3]));                           // expect: 18446744073709551615
    show(@mul_checked(us[5], us[3] + 1));                       // expect: Overflow
    shows(@mul_checked(ss[5], ss[3]));                          // expect: 9223372036854775806
    shows(@mul_checked(ss[5] + 1, ss[3]));                      // expect: Overflow
    shows(@mul_checked(ss[5] + 1, ss[4]));                      // expect: -9223372036854775808
    shows(@mul_checked(ss[5] + 1, -ss[4]));                     // expect: Overflow
    shows(@mul_checked(ss[2], ss[5] * 2 + 1));                  // expect: -9223372036854775807
    io.uint(@as(u64, ws[1]) * @as(u64, ws[1]));                 // expect: 18446744065119617025
    io.uint(@as(u64, ws[2]) * @as(u64, ws[1]));                 // expect: 9223372034707292160
    io.int(@as(i64, is[0]) * @as(i64, is[0]));                  // expect: 4611686018427387904
    io.int(@as(i64, is[0]) * @as(i64, is[1]));                  // expect: -4611686016279904256
    io.int(@as(i64, ws[1]) * @as(i64, is[2]));                  // expect: -4294967295
    shows(@mul_checked(@as(i64, ws[1]), @as(i64, ws[1] - 1)));  // expect: Overflow
}
