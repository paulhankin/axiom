// The lower bound of a phi (s, from a checked difference or its default)
// asked, through a fact of the branch (t >= a with t = s - 2), for the lower
// bound of s again, without end: each step started a new proof of the
// difference's bound, with its own depth and budget (the compiler ran out of
// stack at -O2).
import "../lib/io.ax" as io;

// flags: -O2

fn f(a: u64, b: u64, d: u64) u64 {
    let s: u64 = @sub_checked(b, a) catch d;
    let t: u64 = s +% 18446744073709551614;
    if t >= a {
        return @sub_checked(s, a) catch 100;
    }
    return 0;
}

let AS: [5]u64 = [1, 9, 3, 2, 5];
let BS: [5]u64 = [9, 1, 1, 9, 5];
let DS: [5]u64 = [5, 5, 10, 0, 0];

// expect: 7
// expect: 0
// expect: 7
// expect: 5
// expect: 100
export fn run() void {
    for i in @as(usize, 0)..5 {
        io.int(@bit_cast(i64, f(AS[i], BS[i], DS[i])));
    }
}
