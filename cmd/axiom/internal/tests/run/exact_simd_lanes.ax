fn swizzle_i8x16() void {
    let mut h0: u64 = 0;
    let mut h1: u64 = 0;
    for i in 0..R_I8X16.len / 16 {
        for j in 0..R_I8X16.len / 16 {
            for k in 0..I_I8X16.len / 16 {
                let a = @load(i8x16, R_I8X16[i * 16..]);
                let b = @load(i8x16, R_I8X16[j * 16..]);
                let x = @load(i8x16, I_I8X16[k * 16..]);
                h0 = hb128(h0, @bit_cast(u64x2, @swizzle(a, x)));
                h1 = hb128(h1, @bit_cast(u64x2, @swizzle2(a, b, x)));
            }
        }
    }
    io.uint(h0);
    io.uint(h1);
}

