// More vectors live through a loop than there are vector registers, all of them read in
// its body (one block), with one register too few at a point: some are spilled. (For
// AArch64, from -O1, the compiler stopped with "register allocation did not converge": each
// round split one more of them at the loop, which left it in a register through the body
// as before.)
import "../lib/io.ax" as io;

let mut K: [124]u32 = [2598312734, 597751855, 3148695148, 3102682213, 3114661226, 2006389387, 3064367000, 2599638049,
                       2968397942, 1210742439, 4153454468, 3814210461, 3360981058, 2705719427, 1215523376, 4123664089,
                       1383499982, 4171648031, 1780818844, 3397188053, 1010732570, 1496692091, 2457274312, 250120337,
                       3304037414, 3894958231, 2703295156, 2521057037, 720469746, 2681737587, 929939552, 3586355529,
                       3646734974, 1549827087, 514239692, 1754334021, 1648800458, 2516251755, 2839540728, 3616258305,
                       1372412886, 3843724935, 4207182308, 2697072253, 635668898, 2890415715, 1652687504, 984498105,
                       1994180654, 2210301951, 888463868, 254953653, 2629395322, 1120259931, 3488893992, 2857624945,
                       1563584390, 1120940151, 3047042324, 2562232813, 1854251090, 3092612947, 1778593984, 836864553,
                       3674315230, 3178196975, 4287808300, 3391605285, 2438045738, 3929359947, 4266070104, 2289569249,
                       764002102, 383264359, 294716484, 3687764317, 1190314754, 595520579, 2835630832, 3430174873,
                       1318467470, 3789698015, 2009288796, 620267413, 3398068442, 2091407675, 4272636040, 2934911569,
                       4194198246, 4169234519, 222300020, 4285254861, 2919625138, 721644851, 1700286752, 255693577,
                       1663410494, 1128649679, 1837730188, 451641605, 1738456458, 3225290795, 2656296120, 108024513,
                       444289686, 4040894023, 370030244, 1085703229, 2405051490, 1507985955, 2140291920, 1658081657,
                       2734348014, 495538111, 3081268924, 117945973, 3431571002, 1087722267, 3711165672, 326266673,
                       933989958, 1790193719, 941527508, 1955985325];

fn lanes(h0: u64, v: u32x4) u64 {
    let mut h = h0;
    h = mix(h, @as(u64, @extract_lane(v, 0)));
    h = mix(h, @as(u64, @extract_lane(v, 1)));
    h = mix(h, @as(u64, @extract_lane(v, 2)));
    h = mix(h, @as(u64, @extract_lane(v, 3)));
    return h;
}

fn mix(h: u64, x: u64) u64 {
    let y = (h ^ x) *% 1099511628211;
    return y ^ (y >> 32);
}

fn pressure(n: usize) u64 {
    let k0 = @load(u32x4, K[0..]);
    let k1 = @load(u32x4, K[4..]);
    let k2 = @load(u32x4, K[8..]);
    let k3 = @load(u32x4, K[12..]);
    let k4 = @load(u32x4, K[16..]);
    let k5 = @load(u32x4, K[20..]);
    let k6 = @load(u32x4, K[24..]);
    let k7 = @load(u32x4, K[28..]);
    let k8 = @load(u32x4, K[32..]);
    let k9 = @load(u32x4, K[36..]);
    let k10 = @load(u32x4, K[40..]);
    let k11 = @load(u32x4, K[44..]);
    let k12 = @load(u32x4, K[48..]);
    let k13 = @load(u32x4, K[52..]);
    let k14 = @load(u32x4, K[56..]);
    let k15 = @load(u32x4, K[60..]);
    let k16 = @load(u32x4, K[64..]);
    let k17 = @load(u32x4, K[68..]);
    let k18 = @load(u32x4, K[72..]);
    let k19 = @load(u32x4, K[76..]);
    let k20 = @load(u32x4, K[80..]);
    let k21 = @load(u32x4, K[84..]);
    let k22 = @load(u32x4, K[88..]);
    let k23 = @load(u32x4, K[92..]);
    let k24 = @load(u32x4, K[96..]);
    let k25 = @load(u32x4, K[100..]);
    let k26 = @load(u32x4, K[104..]);
    let k27 = @load(u32x4, K[108..]);
    let k28 = @load(u32x4, K[112..]);
    let k29 = @load(u32x4, K[116..]);
    let k30 = @load(u32x4, K[120..]);
    let mut a: u32x4 = @vec(u32x4, 1, 2, 3, 4);
    let mut b: u32x4 = @vec(u32x4, 5, 6, 7, 8);
    for _i in 0..n {
        a = (a ^ k0) +% b;
        b = (b *% k1) ^ a;
        a = a +% (k2 *% b);
        a = (a ^ k3) +% b;
        b = (b *% k4) ^ a;
        a = a +% (k5 *% b);
        a = (a ^ k6) +% b;
        b = (b *% k7) ^ a;
        a = a +% (k8 *% b);
        a = (a ^ k9) +% b;
        b = (b *% k10) ^ a;
        a = a +% (k11 *% b);
        a = (a ^ k12) +% b;
        b = (b *% k13) ^ a;
        a = a +% (k14 *% b);
        a = (a ^ k15) +% b;
        b = (b *% k16) ^ a;
        a = a +% (k17 *% b);
        a = (a ^ k18) +% b;
        b = (b *% k19) ^ a;
        a = a +% (k20 *% b);
        a = (a ^ k21) +% b;
        b = (b *% k22) ^ a;
        a = a +% (k23 *% b);
        a = (a ^ k24) +% b;
        b = (b *% k25) ^ a;
        a = a +% (k26 *% b);
        a = (a ^ k27) +% b;
        b = (b *% k28) ^ a;
        a = a +% (k29 *% b);
        a = (a ^ k30) +% b;
    }
    return lanes(lanes(0, a), b);
}

export fn run() void {
    io.uint(pressure(5));  // expect: 18186485570304649667
}
