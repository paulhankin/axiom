// Inline anonymous error sets, error-set generic parameters, and private
// return error inference (spec §11.3).
import "../lib/io.ax" as io;

error FileErr { FileNotFound, PermissionDenied }
error ExactFileErr { FileNotFound }
error NetErr { Timeout, Reset }
error { OpenBoom, HelperA1, HelperA2, Extra }

let mut g_tries: i32 = 0;

fn only_a(x: i32) { A }!i32 {
    if x < 0 {
        return error.A;
    }
    return x;
}

fn make_ab(x: i32) { A, B }!i32 {
    if x == 1 {
        return error.A;
    }
    if x == 2 {
        return error.B;
    }
    return x;
}

fn make_ba(x: i32) { B, A }!i32 {
    if x == 1 {
        return error.A;
    }
    if x == 2 {
        return error.B;
    }
    return x + 10;
}

fn widen_ab(x: i32) { A, B }!i32 {
    if x == 2 {
        return error.B;
    }
    return only_a(x);  // { A }!i32 widens to { A, B }!i32
}

fn only_file_not_found(x: i32) { FileNotFound }!i32 {
    if x == 0 {
        return error.FileNotFound;
    }
    return x;
}

fn exact_file_fn(x: i32) ExactFileErr!i32 {
    if x == 0 {
        return error.FileNotFound;
    }
    return x + 1;
}

fn take_ab_union(r: { A, B }!i32) i32 {
    let v = r catch |e| {
        match e {
            error.A => { return -1; }
            error.B => { return -2; }
        }
    };
    return v;
}

fn take_file_union(r: FileErr!i32) i32 {
    let v = r catch |e| {
        match e {
            error.FileNotFound     => { return -10; }
            error.PermissionDenied => { return -11; }
        }
    };
    return v;
}

fn take_open_union(r: !i32) []u8 {
    let v = r catch |e| {
        return @error_name(e);
    };
    _ = v;
    return "ok";
}

fn unwrap_file_inline(r: { FileNotFound }!i32) []u8 {
    let v = r catch |e| {
        match e {
            error.FileNotFound => { return @error_name(e); }
        }
    };
    _ = v;
    return "ok";
}

fn describe_alpha_beta(e: { Alpha, Beta }) []u8 {
    match e {
        error.Alpha => { return "Alpha"; }
        error.Beta  => { return "Beta"; }
    }
}

fn flip_ab(e: { Beta, Alpha }) { Alpha, Beta } {
    return e;
}

fn make_alpha_beta(x: i32) { Alpha, Beta }!i32 {
    if x == 1 {
        return error.Alpha;
    }
    if x == 2 {
        return error.Beta;
    }
    return x;
}

fn check_alpha_beta(x: i32) []u8 {
    let v = make_alpha_beta(x) catch |e| {
        return describe_alpha_beta(e);
    };
    _ = v;
    return "ok";
}

fn only_inline(fail: bool) { InlineOnlyErr }!void {
    if fail {
        return error.InlineOnlyErr;
    }
}

fn check_inline_only(fail: bool) []u8 {
    only_inline(fail) catch |e| {
        match e {
            error.InlineOnlyErr => { return @error_name(e); }
        }
    };
    return "ok";
}

fn retry[error E, T](attempts: i32, f: fn() E!T) E!T {
    let mut i: i32 = 1;
    while i < attempts {
        let v = f() catch {
            i += 1;
            continue;
        };
        return v;
    }
    return f();
}

fn wrap[T, error E](r: E!T) E!T {
    let v = r!;
    return v;
}

fn step_inline() { Bad }!i32 {
    g_tries += 1;
    if g_tries < 3 {
        return error.Bad;
    }
    return 42;
}

fn step_named() NetErr!i32 {
    g_tries += 1;
    if g_tries == 1 {
        return error.Timeout;
    }
    if g_tries == 2 {
        return error.Reset;
    }
    return 99;
}

fn step_open() !i32 {
    g_tries += 1;
    if g_tries < 2 {
        return error.OpenBoom;
    }
    return 77;
}

fn run_retry_inline(attempts: i32) i32 {
    g_tries = 0;
    let v = retry(attempts, step_inline) catch |e| {
        match e {
            error.Bad => { return -100; }
        }
    };
    return v;
}

fn run_retry_named(attempts: i32) []u8 {
    g_tries = 0;
    let v = retry(attempts, step_named) catch |e| {
        match e {
            error.Timeout => { return "Timeout"; }
            error.Reset   => { return "Reset"; }
        }
    };
    _ = v;
    return "ok";
}

fn run_retry_open(attempts: i32) i32 {
    g_tries = 0;
    let v = retry(attempts, step_open) catch |e| {
        io.str(@error_name(e));
        return -200;
    };
    return v;
}

fn run_wrap_ab(x: i32) i32 {
    let v = wrap(make_ab(x)) catch |e| {
        match e {
            error.A => { return -1; }
            error.B => { return -2; }
        }
    };
    return v;
}

fn helper_a(x: i32) infer!i32 {
    if x == 1 {
        return error.HelperA1;
    }
    if x == 2 {
        return error.HelperA2;
    }
    return x * 10;
}

fn helper_b(x: i32) infer!i32 {
    let v = helper_a(x)!;
    if v == 0 {
        return error.Extra;
    }
    return v + 1;
}

fn check_inferred(x: i32) i32 {
    let v = helper_b(x) catch |e| {
        match e {
            error.HelperA1 => { return -1; }
            error.HelperA2 => { return -2; }
            error.Extra    => { return -3; }
        }
    };
    return v;
}

export fn run() void {
    let v_ab: { A, B }!i32 = make_ba(5);
    let v_ba: { B, A }!i32 = make_ab(2);
    io.int(@as(i64, take_ab_union(v_ab)));  // expect: 15
    io.int(@as(i64, take_ab_union(v_ba)));  // expect: -2

    let fp_ab: fn(i32) { A, B }!i32 = make_ba;
    let fp_ba: fn(i32) { B, A }!i32 = make_ab;
    io.int(@as(i64, take_ab_union(fp_ab(7))));  // expect: 17
    io.int(@as(i64, take_ab_union(fp_ba(1))));  // expect: -1

    io.int(@as(i64, take_ab_union(widen_ab(-1))));  // expect: -1
    io.int(@as(i64, take_ab_union(widen_ab(2))));   // expect: -2
    io.int(@as(i64, take_ab_union(only_a(-3))));    // expect: -1
    let fp_widen_ab: fn(i32) { A, B }!i32 = only_a;
    io.int(@as(i64, take_ab_union(fp_widen_ab(9))));  // expect: 9

    let widened_open: !i32 = make_ab(1);
    io.str(take_open_union(widened_open));  // expect: A
    let fp_widen_open: fn(i32) !i32 = make_ab;
    io.str(take_open_union(fp_widen_open(2)));  // expect: B

    io.int(@as(i64, take_file_union(only_file_not_found(0))));  // expect: -10
    let fp_to_named: fn(i32) FileErr!i32 = only_file_not_found;
    io.int(@as(i64, take_file_union(fp_to_named(3))));  // expect: 3

    let exact_to_inline: { FileNotFound }!i32 = exact_file_fn(0);
    let inline_to_exact: ExactFileErr!i32 = only_file_not_found(0);
    let fp_exact_to_inline: fn(i32) { FileNotFound }!i32 = exact_file_fn;
    let fp_inline_to_exact: fn(i32) ExactFileErr!i32 = only_file_not_found;
    io.str(unwrap_file_inline(exact_to_inline));        // expect: FileNotFound
    io.str(unwrap_file_inline(inline_to_exact));        // expect: FileNotFound
    io.str(unwrap_file_inline(fp_exact_to_inline(4)));  // expect: ok
    io.str(unwrap_file_inline(fp_inline_to_exact(0)));  // expect: FileNotFound

    let ea: { Alpha, Beta } = error.Alpha;
    let eb: { Beta, Alpha } = error.Beta;
    io.str(describe_alpha_beta(ea));           // expect: Alpha
    io.str(describe_alpha_beta(flip_ab(eb)));  // expect: Beta
    io.str(check_alpha_beta(2));               // expect: Beta

    io.str(check_inline_only(false));  // expect: ok
    io.str(check_inline_only(true));   // expect: InlineOnlyErr

    g_tries = 0;
    let r_exp = retry.[{ Bad }, i32](3, step_inline) catch -1;
    io.int(@as(i64, r_exp));                // expect: 42
    io.int(@as(i64, run_retry_inline(3)));  // expect: 42
    io.int(@as(i64, run_retry_inline(2)));  // expect: -100
    io.str(run_retry_named(3));             // expect: ok
    io.str(run_retry_named(2));             // expect: Reset
    io.int(@as(i64, run_retry_open(2)));    // expect: 77
    io.int(@as(i64, run_retry_open(1)));
    // expect: OpenBoom
    // expect: -200

    io.int(@as(i64, run_wrap_ab(5)));  // expect: 5
    io.int(@as(i64, run_wrap_ab(2)));  // expect: -2
    let w_exp = wrap.[i32, ExactFileErr](exact_file_fn(5)) catch -1;
    io.int(@as(i64, w_exp));  // expect: 6
    g_tries = 0;
    io.str(take_open_union(wrap(step_open())));  // expect: OpenBoom

    io.int(@as(i64, check_inferred(0)));  // expect: -3
    io.int(@as(i64, check_inferred(1)));  // expect: -1
    io.int(@as(i64, check_inferred(2)));  // expect: -2
    io.int(@as(i64, check_inferred(3)));  // expect: 31
}
