// @memory_discard gives back only pages that @memory_grow handed out (spec
// Appendix A): a range over the stack or the globals is left alone.
import "../lib/io.ax" as io;

let mut pad: [65536]u64 = [1; 65536];

fn on_stack() u64 {
    let mut local: [16384]u64 = undefined;
    for i in @as(usize, 0)..16384 {
        local[i] = 7;
    }
    @memory_discard(@int_from_ptr(&local[0]), 16384 * 8);
    return local[8192];
}

export fn run() void {
    for i in @as(usize, 0)..65536 {
        pad[i] = 42;
    }
    @memory_discard(@int_from_ptr(&pad[0]), 65536 * 8);
    io.uint(pad[32768]);  // expect: 42
    io.uint(on_stack());  // expect: 7
    // (a range that wraps around the address space)
    @memory_discard(@int_from_ptr(&pad[0]), ~@as(usize, 0));
    io.uint(pad[65535]);  // expect: 42
}
