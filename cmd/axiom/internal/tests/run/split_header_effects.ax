// A loop split at the bound of its checks (gvn.ax try_split: a copy without
// the checks runs while i < min(end, bound), then the loop itself) leaves
// the copy through the loop's header, which runs that iteration's header
// again: a header with effects (a call in the test, a store before the
// exit) is not split.
// flags: -O2
import "../lib/io.ax" as io;

let mut G: [6]i64 = [1, 2, 3, 4, 5, 6];
let mut VISITS: i64 = 0;
let mut ENDS: [2]usize = [3, 2];

fn next_visit() bool {
    VISITS += 1;
    return true;
}

// The header runs end + 1 times (the call in the loop's test; the store
// before the exit below).
fn sum_while(xs: []i64, end: usize) i64 {
    let mut i: usize = 0;
    let mut s: i64 = 0;
    while next_visit() and (i < end) {
        s += xs[i];
        i += 1;
    }
    return s;
}

fn sum_noting(xs: []i64, end: usize) i64 {
    let mut i: usize = 0;
    let mut s: i64 = 0;
    loop {
        VISITS += 1;
        if i >= end {
            break;
        }
        s += xs[i];
        i += 1;
    }
    return s;
}

export fn run() void {
    io.int(sum_while(G[..], ENDS[0]));
    io.int(VISITS);
    io.int(sum_noting(G[..], ENDS[1]));
    io.int(VISITS);
}
// expect: 6
// expect: 4
// expect: 3
// expect: 7
