// A value computed only for a phi in a successor block is computed in the
// phi copy, on the edge to that block (WebAssembly): one that inlines an
// atomic read-modify-write or a call happens on both edges all the same.
// flags: --stack-traces=off
import "../lib/io.ax" as io;

let mut X: u32 = 10;
let mut CALLS: u32 = 0;

// (mutable: the calls are not inlined, and the arguments not constants in
// the callees)
let mut ADD: fn(bool) u32 = add;
let mut CALL: fn(bool) u32 = call;
let mut BUMP: fn() u32 = bump;

fn add(c: bool) u32 {
    let mut r = @atomic_add(&mut X, 1) +% 1;
    if c {
        io.int(@as(i64, X));
        r = 7;
    }
    return r;
}

fn bump() u32 {
    CALLS += 1;
    return CALLS;
}

fn call(c: bool) u32 {
    let mut r = BUMP() +% 1;
    if c {
        io.int(@as(i64, CALLS));
        r = 7;
    }
    return r;
}

export fn run() void {
    io.int(@as(i64, ADD(true)));
    io.int(@as(i64, X));
    io.int(@as(i64, ADD(false)));
    io.int(@as(i64, X));
    io.int(@as(i64, CALL(true)));
    io.int(@as(i64, CALLS));
    io.int(@as(i64, CALL(false)));
    io.int(@as(i64, CALLS));
}

// expect: 11
// expect: 7
// expect: 11
// expect: 12
// expect: 12
// expect: 1
// expect: 7
// expect: 1
// expect: 3
// expect: 2
