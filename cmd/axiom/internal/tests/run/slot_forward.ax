// A local built and then copied whole (cmd/axiom/src/copies.ax:
// forward_into): a result built in a local and returned is built in the
// caller's memory for it; a local copied to a global or through a pointer
// is not (another thread may read it while it is built, which Axiom
// defines), nor where the destination is read while the local is built,
// the local is used after the copy, or a way out has no copy. The values
// are those of the copies made.
import "../lib/io.ax" as io;

struct Big {
    n: u32,
    a: [100]u64,
}

let mut g: Big = Big.{ n: 0, a: [0; 100] };
let mut h: Big = Big.{ n: 0, a: [0; 100] };

// (called through a pointer: not inlined)
let mut mk: fn(u64) Big = make;

fn sum(b: *Big) u64 {
    let mut s: u64 = @as(u64, b.n);
    for i in @as(usize, 0)..100 {
        s = (s *% 31) +% b.a[i];
    }
    return s;
}

fn make(k: u64) Big {
    let mut t = Big.{ n: 7, a: [0; 100] };
    for i in @as(usize, 0)..100 {
        t.a[i] = g.a[99 - i] + k;
    }
    return t;
}

// t built from g into p (which may be g)
fn into(p: *mut Big, k: u64) void {
    let mut t = Big.{ n: 3, a: [0; 100] };
    for i in @as(usize, 0)..100 {
        t.a[i] = g.a[99 - i] *% k;
    }
    p.* = t;
}

fn after(p: *mut Big) u64 {
    let mut t = Big.{ n: 1, a: [5; 100] };
    p.* = t;
    t.a[0] = 9;
    return t.a[0] + p.a[0];
}

fn maybe(p: *mut Big, w: bool) void {
    let mut t = Big.{ n: 2, a: [6; 100] };
    if not w {
        return;
    }
    p.* = t;
}

export fn run() void {
    for i in @as(usize, 0)..100 {
        g.a[i] = @as(u64, i) * 3;
    }
    h = mk(5);
    io.uint(sum(&h));
    g = mk(1);
    io.uint(sum(&g));
    into(&mut h, 3);
    io.uint(sum(&h));
    into(&mut g, 2);
    io.uint(sum(&g));
    io.uint(after(&mut h));
    maybe(&mut h, false);
    io.uint(sum(&h));
    maybe(&mut h, true);
    io.uint(sum(&h));
    // expect: 6600005323953738609
    // expect: 2061971218713156209
    // expect: 6698396108547744517
    // expect: 16979651775675054127
    // expect: 14
    // expect: 16649368328718156481
    // expect: 10313958478486178946
}
