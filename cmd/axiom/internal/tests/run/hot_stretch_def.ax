// A loop pushing onto a Vec at -O2, its grow path inlined (see
// hot_stretch_split.ax), with a value the hot stretch changes on one side of
// a branch only: it is stored where the stretch is left for the grow path
// and the loop's exit, and read after the loop.
// flags: -O2
// expect: 2361360800671217457
import "../lib/io.ax" as io;
import "std/collections/vec" as vec;

let mut N: u64 = 3000;

fn fill(v: *mut vec.Vec.[u64], n: u64, seed: u64) u64 {
    let mut x = seed;
    let mut y: u64 = 7;
    for i in 0..n {
        x = (x *% 6364136223846793005) +% 1442695040888963407;
        if (x & 4) != 0 {
            y = x ^ i;
        }
        v.push(x ^ i ^ y) catch return 0;
    }
    return y;
}

export fn run() void {
    let mut total: u64 = 0;
    for r in @as(u64, 0)..5 {
        let mut v = vec.Vec.[u64].init();
        total +%= fill(&mut v, N, r);
        for k in 0..v.len() {
            total +%= v.get(k);
        }
        v.deinit();
    }
    io.uint(total);
}
