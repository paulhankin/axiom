fn hs_t16(h0: u64, v: S16) u64 {
    let mut h = h0;
    h = hs_u16(h, v.f0);
    h = hs_i8(h, v.f1);
    h = hs_t12(h, v.f2);
    h = hs_u8(h, v.f3);
    h = hs_t6(h, v.f4);
    h = hs_t13(h, v.f5);
    h = hs_t14(h, v.f6);
