                 f4: mk_t6(mix(x, 5)), f5: mk_t13(mix(x, 6)), f6: mk_t14(mix(x, 7)), f7: mk_t15(mix(x, 8)),
                 f8: mk_t2(mix(x, 9)), f9: mk_i32(mix(x, 10)), f10: mk_t8(mix(x, 11)) };
