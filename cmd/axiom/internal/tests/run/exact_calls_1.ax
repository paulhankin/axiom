fn hs_t63(h: u64, v: Errs!E2) u64 {
    let p = v catch |e| {
        return mix(h, 100 + eidx(e));
    };
    return hs_t2(mix(h, 0), p);
}

fn mk_t63(x: u64) Errs!E2 {
    if (x % 5) == 0 {
        match (x >> 8) % 3 {
            0    => { return error.Bad; }
            1    => { return error.Worse; }
            else => { return error.Ugly; }
        }
    }
    return mk_t2(mix(x, 6));
}

fn st_t63(v: Errs!E2) Errs!E2 {
    let p = v catch |e| {
        return e;
    };
    return st_t2(p);
}

