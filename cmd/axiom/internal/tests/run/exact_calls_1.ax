fn hs_t1(h: u64, v: E1) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
    }
}

fn mk_t1(x: u64) E1 {
    match x % 2 {
        0    => { return E1.M0; }
        else => { return E1.M1; }
    }
}

fn st_t1(v: E1) E1 {
    match v {
        .M0 => { return E1.M1; }
        .M1 => { return E1.M0; }
    }
}

fn hs_t2(h: u64, v: E2) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
        .M2 => { return mix(h, 2); }
        .M3 => { return mix(h, 3); }
    }
}

fn mk_t2(x: u64) E2 {
    match x % 4 {
        0    => { return E2.M0; }
        1    => { return E2.M1; }
        2    => { return E2.M2; }
        else => { return E2.M3; }
    }
}

fn st_t2(v: E2) E2 {
    match v {
        .M0 => { return E2.M1; }
        .M1 => { return E2.M2; }
        .M2 => { return E2.M3; }
        .M3 => { return E2.M0; }
    }
}

fn hs_t3(h0: u64, v: S3) u64 {
    let mut h = h0;
    h = hs_t1(h, v.f0);
    return h;
}

fn mk_t3(x: u64) S3 {
    return S3.{ f0: mk_t1(mix(x, 1)) };
}

fn st_t3(v: S3) S3 {
    return S3.{ f0: st_t1(v.f0) };
}

fn hs_t4(h: u64, v: Errs!u8) u64 {
    let p = v catch |e| {
        return mix(h, 100 + eidx(e));
    };
    return hs_u8(mix(h, 0), p);
}

fn mk_t4(x: u64) Errs!u8 {
    if (x % 5) == 0 {
        match (x >> 8) % 3 {
            0    => { return error.Bad; }
            1    => { return error.Worse; }
            else => { return error.Ugly; }
        }
    }
    return mk_u8(mix(x, 6));
}

fn st_t4(v: Errs!u8) Errs!u8 {
    let p = v catch |e| {
        return e;
    };
    return st_u8(p);
}

fn hs_t5(h0: u64, v: S5) u64 {
    let mut h = h0;
    h = hs_u64(h, v.f0);
    h = hs_f64(h, v.f1);
    h = hs_i64(h, v.f2);
    h = hs_t1(h, v.f3);
    h = hs_t1(h, v.f4);
    return h;
}

fn mk_t5(x: u64) S5 {
    return S5.{ f0: mk_u64(mix(x, 1)), f1: mk_f64(mix(x, 2)), f2: mk_i64(mix(x, 3)), f3: mk_t1(mix(x, 4)),
                f4: mk_t1(mix(x, 5)) };
}

fn st_t5(v: S5) S5 {
    return S5.{ f0: st_u64(v.f0), f1: st_f64(v.f1), f2: st_i64(v.f2), f3: st_t1(v.f3), f4: st_t1(v.f4) };
}

fn hs_t6(h0: u64, v: S6) u64 {
    let mut h = h0;
    h = hs_u32(h, v.f0);
    h = hs_bool(h, v.f1);
    h = hs_t3(h, v.f2);
    h = hs_t4(h, v.f3);
    h = hs_f32(h, v.f4);
    h = hs_t5(h, v.f5);
    h = hs_bool(h, v.f6);
    h = hs_u8(h, v.f7);
    h = hs_bool(h, v.f8);
    h = hs_u16(h, v.f9);
    h = hs_i16(h, v.f10);
    return h;
}

fn mk_t6(x: u64) S6 {
    return S6.{ f0: mk_u32(mix(x, 1)), f1: mk_bool(mix(x, 2)), f2: mk_t3(mix(x, 3)), f3: mk_t4(mix(x, 4)),
