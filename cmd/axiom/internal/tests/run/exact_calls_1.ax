fn st_t16(v: S16) S16 {
    return S16.{ f0: st_u16(v.f0), f1: st_i8(v.f1), f2: st_t12(v.f2), f3: st_u8(v.f3), f4: st_t6(v.f4),
                 f5: st_t13(v.f5), f6: st_t14(v.f6), f7: st_t15(v.f7), f8: st_t2(v.f8), f9: st_i32(v.f9),
                 f10: st_t8(v.f10) };
