fn hs_t18(h0: u64, v: S18) u64 {
    let mut h = h0;
    h = hs_t9(h, v.f0);
    h = hs_u8(h, v.f1);
    h = hs_isize(h, v.f2);
    h = hs_t11(h, v.f3);
    return h;
}

fn mk_t18(x: u64) S18 {
    return S18.{ f0: mk_t9(mix(x, 1)), f1: mk_u8(mix(x, 2)), f2: mk_isize(mix(x, 3)), f3: mk_t11(mix(x, 4)) };
}

fn st_t18(v: S18) S18 {
    return S18.{ f0: st_t9(v.f0), f1: st_u8(v.f1), f2: st_isize(v.f2), f3: st_t11(v.f3) };
}

fn hs_t19(h0: u64, v: S19) u64 {
    let mut h = h0;
    h = hs_t18(h, v.f0);
    h = hs_t9(h, v.f1);
    return h;
}

fn mk_t19(x: u64) S19 {
    return S19.{ f0: mk_t18(mix(x, 1)), f1: mk_t9(mix(x, 2)) };
