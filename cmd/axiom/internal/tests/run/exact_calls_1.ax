                mk_u8(mix(x, 6)), mk_u8(mix(x, 7)), mk_u8(mix(x, 8)), mk_u8(mix(x, 9)), mk_u8(mix(x, 10)),
                mk_u8(mix(x, 11)), mk_u8(mix(x, 12)), mk_u8(mix(x, 13)), mk_u8(mix(x, 14)), mk_u8(mix(x, 15)),
                mk_u8(mix(x, 16)));
}

fn st_u8x16(v: u8x16) u8x16 {
    let c: u8x16 = @splat(1);
    return v +% c;
}

fn hs_f64x2(h0: u64, v: f64x2) u64 {
