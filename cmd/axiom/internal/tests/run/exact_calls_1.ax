fn hs_t1(h: u64, v: E1) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
        .M2 => { return mix(h, 2); }
    }
}

fn mk_t1(x: u64) E1 {
    match x % 3 {
        0    => { return E1.M0; }
        1    => { return E1.M1; }
        else => { return E1.M2; }
    }
}

fn st_t1(v: E1) E1 {
    match v {
        .M0 => { return E1.M1; }
        .M1 => { return E1.M2; }
        .M2 => { return E1.M0; }
    }
}

fn hs_t2(h: u64, v: E2) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
        .M2 => { return mix(h, 2); }
        .M3 => { return mix(h, 3); }
        .M4 => { return mix(h, 4); }
        .M5 => { return mix(h, 5); }
    }
}

fn mk_t2(x: u64) E2 {
    match x % 6 {
        0    => { return E2.M0; }
        1    => { return E2.M1; }
        2    => { return E2.M2; }
        3    => { return E2.M3; }
        4    => { return E2.M4; }
        else => { return E2.M5; }
    }
}

fn st_t2(v: E2) E2 {
    match v {
        .M0 => { return E2.M1; }
        .M1 => { return E2.M2; }
        .M2 => { return E2.M3; }
        .M3 => { return E2.M4; }
        .M4 => { return E2.M5; }
        .M5 => { return E2.M0; }
    }
}

fn hs_t3(h0: u64, v: S3) u64 {
    let mut h = h0;
    h = hs_u8(h, v.f0);
    h = hs_isize(h, v.f1);
    return h;
}

fn mk_t3(x: u64) S3 {
    return S3.{ f0: mk_u8(mix(x, 1)), f1: mk_isize(mix(x, 2)) };
}

fn st_t3(v: S3) S3 {
    return S3.{ f0: st_u8(v.f0), f1: st_isize(v.f1) };
}

fn hs_t4(h0: u64, v: Two.[u32, f64]) u64 {
    let mut h = h0;
    h = hs_u32(h, v.a);
    h = hs_f64(h, v.b);
    return h;
}

fn mk_t4(x: u64) Two.[u32, f64] {
    return Two.[u32, f64].{ a: mk_u32(mix(x, 1)), b: mk_f64(mix(x, 2)) };
}

fn st_t4(v: Two.[u32, f64]) Two.[u32, f64] {
    return Two.[u32, f64].{ a: st_u32(v.a), b: st_f64(v.b) };
}

fn hs_t5(h0: u64, v: S5) u64 {
    let mut h = h0;
    h = hs_f32(h, v.f0);
    h = hs_u16(h, v.f1);
    h = hs_i16(h, v.f2);
    h = hs_u8(h, v.f3);
    h = hs_u16(h, v.f4);
    h = hs_i8(h, v.f5);
    return h;
}

fn mk_t5(x: u64) S5 {
    return S5.{ f0: mk_f32(mix(x, 1)), f1: mk_u16(mix(x, 2)), f2: mk_i16(mix(x, 3)), f3: mk_u8(mix(x, 4)),
                f4: mk_u16(mix(x, 5)), f5: mk_i8(mix(x, 6)) };
}

fn st_t5(v: S5) S5 {
    return S5.{ f0: st_f32(v.f0), f1: st_u16(v.f1), f2: st_i16(v.f2), f3: st_u8(v.f3), f4: st_u16(v.f4),
                f5: st_i8(v.f5) };
}

fn hs_t6(h: u64, v: ?f32) u64 {
    if let .some(p) = v {
        return hs_f32(mix(h, 1), p);
    }
    return mix(h, 0);
}

fn mk_t6(x: u64) ?f32 {
    if (x & 3) == 0 {
        return .none;
    }
    return mk_f32(mix(x, 5));
}

fn st_t6(v: ?f32) ?f32 {
    match v {
        .some(p) => { return .some(st_f32(p)); }
        .none    => { return .none; }
    }
}

fn hs_t7(h0: u64, v: [1]f64) u64 {
    let mut h = h0;
    for x in v {
        h = hs_f64(h, x);
    }
    return h;
}

fn mk_t7(x: u64) [1]f64 {
    return [mk_f64(mix(x, 1))];
}

fn st_t7(v: [1]f64) [1]f64 {
    let mut r = v;
    for i in 0..r.len {
        r[i] = st_f64(r[i]);
    }
    return r;
}

fn hs_t8(h: u64, v: ?i64) u64 {
    if let .some(p) = v {
        return hs_i64(mix(h, 1), p);
    }
    return mix(h, 0);
}

fn mk_t8(x: u64) ?i64 {
    if (x & 3) == 0 {
        return .none;
    }
    return mk_i64(mix(x, 5));
}

fn st_t8(v: ?i64) ?i64 {
    match v {
        .some(p) => { return .some(st_i64(p)); }
        .none    => { return .none; }
    }
}

fn hs_t9(h0: u64, v: [2]isize) u64 {
    let mut h = h0;
    for x in v {
        h = hs_isize(h, x);
    }
    return h;
