fn hs_t10(h0: u64, v: S10) u64 {
    let mut h = h0;
    h = hs_f32(h, v.f0);
    h = hs_t9(h, v.f1);
    h = hs_usize(h, v.f2);
    h = hs_t6(h, v.f3);
    return h;
