// Structures by value at the C boundary (spec §14.5.3), both ways, against
// C compiled by the system's C compiler (natively) or for WebAssembly: they
// travel as the target's C ABI passes them (small ones in registers,
// floating-point members in floating-point registers, large ones in
// memory).
// link: ffi_values.c
// selfhost-only: the bootstrap compiler does not pass structures by value to C
import "../lib/io.ax" as io;

pub struct Small {
    a: i32,
    b: i32,
}

pub struct Big {
    v: [5]i64,
    tag: i32,
}

pub struct Fl {
    x: f32,
    y: f32,
}

pub struct Dd {
    x: f64,
    y: f64,
}

pub struct Mix {
    d: f64,
    i: i32,
    c: u8,
}

pub struct Tiny {
    c: u8,
}

extern "C" {
    fn c_make_small(a: i32, b: i32) Small;
    fn c_sum_big(l: Big) i64;
    fn c_make_big(base: i32) Big;
    fn c_scale(f: Fl, k: f32) Fl;
    fn c_swap(d: Dd) Dd;
    fn c_mix(m: Mix, n: i32) Mix;
    fn c_tiny(t: Tiny, u: Tiny) Tiny;
    fn c_many(a: Small, b: Small, c: Small, d: Small, e: Dd, f: Dd, g: Dd, h: Dd, i: Dd) f64;
    fn c_call_back() i64;
}

export fn ax_twice_small(s: Small) Small {
    return Small.{ a: s.a * 2, b: s.b * 2 };
}

export fn ax_big(b: Big, k: i32) Big {
    let mut r = b;
    r.v[4] = b.v[4] * @as(i64, k);
    r.tag = b.tag + k;
    return r;
}

export fn ax_mix(m: Mix) f64 {
    return m.d + @float_from_int(f64, @as(i64, m.i)) + @float_from_int(f64, @as(i64, m.c));
}

export fn run() void {
    let s = c_make_small(3, -4);
    io.int(@as(i64, (s.a * 10) + s.b));  // expect: 26
    let b = c_make_big(5);
    io.int(c_sum_big(b));  // expect: 76
    let f = c_scale(Fl.{ x: 1.5, y: 2.5 }, 2.0);
    io.float(@as(f64, f.x + f.y));  // expect: 8
    let d = c_swap(Dd.{ x: 0.25, y: 4.0 });
    io.float(d.x - d.y);  // expect: 3.75
    let m = c_mix(Mix.{ d: 0.5, i: 3, c: 7 }, 4);
    io.float(m.d + @float_from_int(f64, @as(i64, m.i)) + @float_from_int(f64, @as(i64, m.c)));  // expect: 24.5
    let t = c_tiny(Tiny.{ c: 5 }, Tiny.{ c: 6 });
    io.int(@as(i64, t.c));  // expect: 11
    let one = Small.{ a: 1, b: 2 };
    let dd = Dd.{ x: 0.5, y: 1.5 };
    io.float(c_many(one, one, one, one, dd, dd, dd, dd, dd));  // expect: 22
    io.int(c_call_back());  // expect: 6843
}
