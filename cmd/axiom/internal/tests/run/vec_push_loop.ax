// A loop pushing onto Vecs at -O2, their grow paths (the allocator) inlined:
// the room test (`len == cap`) and the bounds test after it (`len < cap`)
// compare the same registers, and the second goes where the first's flags
// reach it, but not on the way back from growing, which changed the
// capacity.
// flags: -O2
// expect: 16768716558081325714
import "../lib/io.ax" as io;
import "std/collections/vec" as vec;

let mut N: u64 = 5000;

fn fill(a: *mut vec.Vec.[u64], b: *mut vec.Vec.[u32], n: u64, seed: u64) void {
    let mut x = seed;
    for i in 0..n {
        x = (x *% 6364136223846793005) +% 1442695040888963407;
        a.push(x ^ i) catch return;
        if (x >> 61) == 0 {
            b.push(@truncate(u32, x >> 7)) catch return;
        }
    }
}

export fn run() void {
    let mut h: u64 = 0;
    for r in @as(u64, 0)..6 {
        let mut a = vec.Vec.[u64].init();
        let mut b = vec.Vec.[u32].init();
        fill(&mut a, &mut b, N + r, r);
        for k in 0..a.len() {
            h = (h ^ a.get(k)) *% 1099511628211;
        }
        for k in 0..b.len() {
            h = (h ^ @as(u64, b.get(k))) *% 1099511628211;
        }
        h +%= @as(u64, a.len()) + (@as(u64, b.len()) << 32);
        a.deinit();
        b.deinit();
    }
    io.uint(h);
}
