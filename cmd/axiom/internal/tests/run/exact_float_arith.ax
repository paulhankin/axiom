        h2 = h_f32(h2, @sqrt(a));
        h3 = h_f32(h3, @floor(a));
        h4 = h_f32(h4, @ceil(a));
        h5 = h_f32(h5, @trunc(a));
        h6 = h_f32(h6, @nearest(a));
