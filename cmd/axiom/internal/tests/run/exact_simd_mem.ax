fn raw_v128_u64_u64() void {
    let mut h0: u64 = 0;
    let mut h1: u64 = 0;
    let mut h2: u64 = 0;
    let mut h3: u64 = 0;
    for i in 0..R_U64X2.len / 2 {
        for j in 0..R_U64X2.len / 2 {
            let a = @load(u64x2, R_U64X2[i * 2..]);
            let b = @load(u64x2, R_U64X2[j * 2..]);
            h0 = hb128(h0, @bit_cast(u64x2, @bit_cast(u64x2, @bit_cast(v128, a) & @bit_cast(v128, b))));
            h1 = hb128(h1, @bit_cast(u64x2, @bit_cast(u64x2, @bit_cast(v128, a) | ~@bit_cast(v128, b))));
            h2 = hb128(h2, @bit_cast(u64x2, @bit_cast(i16x8, @bit_cast(v128, a) ^ @bit_cast(v128, b))));
            let mut loc: v128 = @bit_cast(v128, b);
            h3 = hb128(h3, @bit_cast(u64x2, @bit_cast(u64x2, rf_v128(@bit_cast(v128, a), @bit_cast(v128, b),
                                                                     &mut loc) ^ loc)));
        }
    }
