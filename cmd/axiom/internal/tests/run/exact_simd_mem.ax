            let a = @load(u8x16, R_U8X16[i * 16..]);
            let b = @load(u8x16, R_U8X16[j * 16..]);
            let pm = @ptr_cast(*mut u8x16, &mut M_U8X16[1]);
            pm.* = a;
            h0 = hb128(h0, @bit_cast(u64x2, @ptr_cast(*u8x16, &M_U8X16[15]).*));
            @store(M_U8X16[2..], b);
            h1 = hb128(h1, @bit_cast(u64x2, @load(u8x16, M_U8X16[17..])));
            let mut av: [3]u8x16 = [a, b, a];
            for &mut x in av[1..] {
                x.* = x.* +% a;
            }
            let q = @ptr_add(&av[0], 2);
