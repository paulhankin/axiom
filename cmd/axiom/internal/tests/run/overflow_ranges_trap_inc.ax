// A step whose limit does not keep it below the maximum (x <= cap, not
// x < cap) keeps its check (lowering/overflow_ranges_kept.ax): at
// x = cap = MAX it traps.
// expect-trap
// expect: 0
import "../lib/io.ax" as io;

let mut ARGS: [2]i64 = [0; 2];

fn inc_le(x: i64, cap: i64) i64 {
    if x <= cap {
        return x + 1;
    }
    return x;
}

export fn run() void {
    ARGS = [@max_value(i64), @max_value(i64)];
    io.int(0);
    io.int(inc_le(ARGS[0], ARGS[1]));
}
