// x86-64 with AVX-512: a masked load is not moved above the kmovq that sets
// the mask register k1 it reads (hoist_reads_of did not see k1, which is
// not an operand), where it would load with the mask of the load before
// (5 lanes, not 2). Run where the processor has AVX-512, compared with the
// same function built without it.
// native-only
// flags: -O1
import "../lib/io.ax" as io;

let mut F: fn(*[8]u32, *[8]u32) u64 = partial_sums;
let mut F512: fn(*[8]u32, *[8]u32) u64 = partial_sums_512;
let mut A: [8]u32 = [1, 2, 3, 4, 5, 6, 7, 8];
let mut B: [8]u32 = [10, 20, 30, 40, 50, 60, 70, 80];

fn partial_sums(p: *[8]u32, t: *[8]u32) u64 {
    let x = @load_partial(u32x8, t[0..5]);
    let q = @int_from_ptr(&p[1]);
    let v = @load_partial(u32x8, p[0..2]);
    return @as(u64, @reduce_add(v)) + (@as(u64, @reduce_add(x)) * 1000) + @as(u64, q >> 60);
}

fn partial_sums_512(p: *[8]u32, t: *[8]u32) u64 @features("avx512f,avx512bw,avx512vl") {
    let x = @load_partial(u32x8, t[0..5]);
    let q = @int_from_ptr(&p[1]);
    let v = @load_partial(u32x8, p[0..2]);
    return @as(u64, @reduce_add(v)) + (@as(u64, @reduce_add(x)) * 1000) + @as(u64, q >> 60);
}

export fn run() void {
    let mut f = F;
    if @cpu_has("avx512f") and @cpu_has("avx512bw") and @cpu_has("avx512vl") {
        f = F512;
    }
    io.uint(f(&A, &B));  // expect: 150003
}
