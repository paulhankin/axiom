// A masked value leaves room below the maximum only for what the mask
// clears: (x & ~0xffff) + 0x10000 keeps its check
// (lowering/overflow_ranges_kept.ax) and traps for the top page.
// expect-trap
// expect: 0
import "../lib/io.ax" as io;

let mut ARGS: [1]u64 = [0; 1];

fn page_after(x: u64) u64 {
    return (x & ~@as(u64, 0xffff)) + 0x10000;
}

export fn run() void {
    ARGS = [@max_value(u64) - 5];
    io.int(0);
    io.uint(page_after(ARGS[0]));
}
