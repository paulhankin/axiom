// A pointer made from an integer comes from any exposed object (spec §12.1),
// also when the integer is an address the allocator returned plus an
// offset: that address plus the distance to G points to G, and a store
// through it may change G.
// flags: -O1
import "../lib/io.ax" as io;
import "std/mem" as mem;

let mut G: u64 = 0;
let mut D: usize = 0;

fn store_via_block() u64 {
    let m = mem.alloc_bytes(64);
    D = @int_from_ptr(&G) -% m;
    let p = @ptr_from_int(*mut u64, m +% D);
    G = 1;
    p.* = 2;
    let r = G;
    mem.free_bytes(m, 64);
    return r;
}

export fn run() void {
    io.uint(store_via_block());
}
// expect: 2
