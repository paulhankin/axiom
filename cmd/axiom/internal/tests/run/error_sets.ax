// Named error sets (spec §11.3): `S!T` returns only the errors of S, `!`
// passes them on into a set that holds them or into any error, `catch`
// binds an S, a match on an S that lists every error needs no else, and
// sets are types of their module.
import "../lib/fileerr.ax" as files;
import "../lib/io.ax" as io;

error ParseError { SyntaxError, TooDeep }
error ConfigError = files.FileError | ParseError | { Empty };

fn parse(n: u32) ParseError!u32 {
    if n > 5 {
        return error.TooDeep;
    }
    return n * 10;
}

fn load(name: []u8) ConfigError!u32 {
    let n = files.open(name)!;
    if n == 1 {
        return error.Empty;
    }
    return parse(n)!;
}

fn describe(e: ConfigError) u64 {
    match e {
        error.NotFound         => { return 1; }
        error.PermissionDenied => { return 2; }
        error.SyntaxError      => { return 3; }
        error.TooDeep          => { return 4; }
        error.Empty            => { return 5; }
    }
}

fn narrow(e: files.FileError) ConfigError {
    return e;  // every FileError is a ConfigError
}

fn anything(name: []u8) !u32 {
    return load(name)!;  // a set into any error
}

export fn run() void {
    let names: [5][]u8 = ["abc", "", "xyz", "q", "toolong"];
    for n in names {
        let v = load(n) catch |e| {
            io.uint(describe(e));
            io.str(@error_name(e));
            continue;
        };
        io.uint(@as(u64, v));
    }
    let f = files.open("") catch |e| {
        io.boolean(narrow(e) == error.NotFound);
        io.boolean(e == error.NotFound);
        return;
    };
    io.uint(@as(u64, f));
}

// expect: 30
// expect: 1
// expect: NotFound
// expect: 2
// expect: PermissionDenied
// expect: 5
// expect: Empty
// expect: 4
// expect: TooDeep
// expect: true
// expect: true
