// In the trap overflow mode, MIN / -1 traps (T0002); the default wraps.
// flags: --overflow=trap
// expect-trap
import "../lib/io.ax" as io;

fn div(a: i32, b: i32) i32 {
    return a / b;
}

export fn run() void {
    io.int(@as(i64, div(-7, -1)));  // expect: 7
    io.str("before");               // expect: before
    io.int(@as(i64, div(@min_value(i32), -1)));
}
