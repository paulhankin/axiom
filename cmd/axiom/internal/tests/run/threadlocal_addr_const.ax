// A thread-local's address is not a constant that data can hold: in a
// literal of constants, which lowering puts in read-only data (an array of
// more than 16 pointers, or an aggregate argument passed by address), it
// would be the address of the variable's initial image, not of the running
// thread's copy.
import "../lib/io.ax" as io;
import "std/thread" as thread;

threadlocal let mut g: u32 = 52;
threadlocal let mut h: u32 = 7;
threadlocal let mut pair: [2]u32 = [52, 33];

fn quarter(a: []mut u32) void {
    a[0] = a[0] / 4;
}

// Adds 1000 to g through a pointer from a constant array, and quarters
// pair[0] through a constant slice.
fn bump(n: usize) void {
    let ps: [20]*mut u32 = [&mut h, &mut g, &mut h, &mut g, &mut h, &mut g, &mut h, &mut g, &mut h, &mut g, &mut h,
                            &mut g, &mut h, &mut g, &mut h, &mut g, &mut h, &mut g, &mut h, &mut g];
    let p = ps[n % 20];
    p.* = p.* + 1000;
    quarter(pair[0..2]);
}

let mut seen: [8]u32 = [0, 0, 0, 0, 0, 0, 0, 0];

// This thread's g, h and pair, into seen from slot k on.
fn note(k: usize) void {
    seen[k] = g;
    seen[k + 1] = h;
    seen[k + 2] = pair[0];
    seen[k + 3] = pair[1];
}

fn show(k: usize) void {
    for i in k..k + 4 {
        io.uint(@as(u64, seen[i]));
    }
}

// (the host prints only from the main thread)
fn child(n: usize) void {
    note(0);
    bump(n);
    note(4);
}

export fn run() void {
    // (through a pointer: the index is not a constant in bump)
    let fs = [bump, bump];
    fs[1](1);
    note(0);
    show(0);
    let t = thread.spawn(child, @as(usize, 3)) catch {
        io.str("spawn failed");
        return;
    };
    t.join();
    show(0);
    show(4);
    note(0);
    show(0);
}
// expect: 1052
// expect: 7
// expect: 13
// expect: 33
// expect: 52
// expect: 7
// expect: 52
// expect: 33
// expect: 1052
// expect: 7
// expect: 13
// expect: 33
// expect: 1052
// expect: 7
// expect: 13
// expect: 33
