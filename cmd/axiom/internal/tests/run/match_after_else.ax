// An arm written after `else` (W0631) is never taken (spec §8.6): on an
// enum, a union, an optional, an integer and a bool (issue #74).
import "../lib/io.ax" as io;

enum Color {
    Red,
    Green,
    Blue,
}

union Shape {
    Circle: i64,
    Square: i64,
}

fn color(c: Color) i64 {
    match c {
        .Red  => { return 1; }
        else  => { return 2; }
        .Blue => { return 3; }
    }
}

fn shape(s: Shape) i64 {
    match s {
        .Circle(r) => { return r; }
        else       => { return 20; }
        .Square(w) => { return w; }
    }
}

fn opt(x: ?i64) i64 {
    match x {
        .none    => { return 0; }
        else     => { return 30; }
        .some(v) => { return v; }
    }
}

fn int(x: i64) i64 {
    match x {
        1    => { return 1; }
        else => { return 40; }
        7    => { return 7; }
    }
}

fn boolean(b: bool) i64 {
    match b {
        false => { return 0; }
        else  => { return 50; }
        true  => { return 1; }
    }
}

export fn run() void {
    io.int(color(Color.Blue));       // expect: 2
    io.int(color(Color.Red));        // expect: 1
    io.int(shape(Shape.Square(9)));  // expect: 20
    io.int(shape(Shape.Circle(4)));  // expect: 4
    io.int(opt(.some(5)));           // expect: 30
    io.int(opt(.none));              // expect: 0
    io.int(int(7));                  // expect: 40
    io.int(int(1));                  // expect: 1
    io.int(boolean(true));           // expect: 50
}
