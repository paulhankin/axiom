fn bin_u32x4() void {
    let mut h0: u64 = 0;
    let mut h1: u64 = 0;
    let mut h2: u64 = 0;
    let mut h3: u64 = 0;
    let mut h4: u64 = 0;
    let mut h5: u64 = 0;
    let mut h6: u64 = 0;
    let mut h7: u64 = 0;
    let mut h8: u64 = 0;
