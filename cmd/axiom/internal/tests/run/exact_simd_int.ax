    let mut h10: u64 = 0;
    let mut h11: u64 = 0;
    let mut h12: u64 = 0;
    let mut h13: u64 = 0;
    let mut h14: u64 = 0;
    let mut h15: u64 = 0;
    let mut h16: u64 = 0;
    let mut h17: u64 = 0;
    let mut h18: u64 = 0;
    let mut h19: u64 = 0;
    let mut h20: u64 = 0;
    let mut h21: u64 = 0;
    let mut h22: u64 = 0;
    for i in 0..R_U32X4.len / 4 {
        for j in 0..R_U32X4.len / 4 {
            let a = @load(u32x4, R_U32X4[i * 4..]);
            let b = @load(u32x4, R_U32X4[j * 4..]);
            h0 = hb128(h0, @bit_cast(u64x2, a + b));
            h1 = hb128(h1, @bit_cast(u64x2, a - b));
            h2 = hb128(h2, @bit_cast(u64x2, a +% b));
            h3 = hb128(h3, @bit_cast(u64x2, a -% b));
            h4 = hb128(h4, @bit_cast(u64x2, a * b));
            h5 = hb128(h5, @bit_cast(u64x2, a *% b));
            h6 = hb128(h6, @bit_cast(u64x2, a & b));
            h7 = hb128(h7, @bit_cast(u64x2, a | b));
            h8 = hb128(h8, @bit_cast(u64x2, a ^ b));
            h9 = hb128(h9, @bit_cast(u64x2, @min(a, b)));
            h10 = hb128(h10, @bit_cast(u64x2, @max(a, b)));
            h11 = hb128(h11, @bit_cast(u64x2, @lanes_eq(a, b)));
            h12 = hb128(h12, @bit_cast(u64x2, @lanes_ne(a, b)));
            h13 = hb128(h13, @bit_cast(u64x2, @lanes_lt(a, b)));
            h14 = hb128(h14, @bit_cast(u64x2, @lanes_le(a, b)));
            h15 = hb128(h15, @bit_cast(u64x2, @lanes_gt(a, b)));
            h16 = hb128(h16, @bit_cast(u64x2, @lanes_ge(a, b)));
            h17 = hb128(h17, @bit_cast(u64x2, @select(@lanes_lt(a, b), a, b)));
            h18 = hb128(h18, @bit_cast(u64x2, @select(a, b, ~b)));
            h19 = hb128(h19, @bit_cast(u64x2, a << @bit_cast(u32x4, b)));
            h20 = hb128(h20, @bit_cast(u64x2, a << (@bit_cast(u32x4, b) & @splat(63))));
            h21 = hb128(h21, @bit_cast(u64x2, a >> @bit_cast(u32x4, b)));
            h22 = hb128(h22, @bit_cast(u64x2, a >> (@bit_cast(u32x4, b) & @splat(63))));
        }
    }
    io.uint(h0);
    io.uint(h1);
    io.uint(h2);
    io.uint(h3);
    io.uint(h4);
    io.uint(h5);
    io.uint(h6);
    io.uint(h7);
    io.uint(h8);
    io.uint(h9);
    io.uint(h10);
    io.uint(h11);
    io.uint(h12);
    io.uint(h13);
    io.uint(h14);
    io.uint(h15);
    io.uint(h16);
    io.uint(h17);
    io.uint(h18);
    io.uint(h19);
    io.uint(h20);
    io.uint(h21);
    io.uint(h22);
}

