    io.uint(h2);
    io.uint(h3);
    io.uint(h4);
    io.uint(h5);
    io.uint(h6);
    io.uint(h7);
}

fn un_i64x8() void {
    let mut h0: u64 = 0;
    let mut h1: u64 = 0;
    let mut h2: u64 = 0;
    let mut h3: u64 = 0;
    let mut h4: u64 = 0;
    let mut h5: u64 = 0;
    let mut h6: u64 = 0;
    for i in 0..R_I64X8.len / 8 {
        let a = @load(i64x8, R_I64X8[i * 8..]);
        h0 = hb512(h0, @bit_cast(u64x8, -%a));
        h1 = hb512(h1, @bit_cast(u64x8, @abs(a)));
        h2 = hb512(h2, @bit_cast(u64x8, @clz(a)));
        h3 = hb512(h3, @bit_cast(u64x8, @popcount(a)));
        h4 = h_i64(h4, @reduce_add(a));
        h5 = h_u32(h5, @bitmask(a));
        h6 = h_bool(h6, @all_true(a));
    }
    io.uint(h0);
    io.uint(h1);
    io.uint(h2);
    io.uint(h3);
    io.uint(h4);
    io.uint(h5);
    io.uint(h6);
}

fn bin_u64x8() void {
    let mut h0: u64 = 0;
    let mut h1: u64 = 0;
    let mut h2: u64 = 0;
    let mut h3: u64 = 0;
    let mut h4: u64 = 0;
    let mut h5: u64 = 0;
    let mut h6: u64 = 0;
    let mut h7: u64 = 0;
    for i in 0..R_U64X8.len / 8 {
        for j in 0..R_U64X8.len / 8 {
            let a = @load(u64x8, R_U64X8[i * 8..]);
            let b = @load(u64x8, R_U64X8[j * 8..]);
            h0 = hb512(h0, @bit_cast(u64x8, a + b));
            h1 = hb512(h1, @bit_cast(u64x8, a - b));
            h2 = hb512(h2, @bit_cast(u64x8, a * b));
            h3 = hb512(h3, @bit_cast(u64x8, a ^ b));
            h4 = hb512(h4, @bit_cast(u64x8, @lanes_lt(a, b)));
            h5 = hb512(h5, @bit_cast(u64x8, @select(@lanes_lt(a, b), a, b)));
            h6 = hb512(h6, @bit_cast(u64x8, a << @bit_cast(u64x8, b)));
            h7 = hb512(h7, @bit_cast(u64x8, a >> (@bit_cast(u64x8, b) & @splat(127))));
        }
    }
    io.uint(h0);
    io.uint(h1);
    io.uint(h2);
    io.uint(h3);
    io.uint(h4);
    io.uint(h5);
    io.uint(h6);
    io.uint(h7);
}

fn un_u64x8() void {
    let mut h0: u64 = 0;
    let mut h1: u64 = 0;
    let mut h2: u64 = 0;
    let mut h3: u64 = 0;
    let mut h4: u64 = 0;
    let mut h5: u64 = 0;
    for i in 0..R_U64X8.len / 8 {
        let a = @load(u64x8, R_U64X8[i * 8..]);
        h0 = hb512(h0, @bit_cast(u64x8, -%a));
        h1 = hb512(h1, @bit_cast(u64x8, @clz(a)));
        h2 = hb512(h2, @bit_cast(u64x8, @popcount(a)));
        h3 = h_u64(h3, @reduce_add(a));
        h4 = h_u32(h4, @bitmask(a));
        h5 = h_bool(h5, @all_true(a));
    }
    io.uint(h0);
    io.uint(h1);
    io.uint(h2);
    io.uint(h3);
    io.uint(h4);
    io.uint(h5);
}

