struct Pf {
    out: []mut u32,
    sum: u64,
}

fn pf_body(ctx: *mut Pf, lo: usize, hi: usize) void {
    for i in lo..hi {
        let x = @truncate(u32, i *% 2654435761);
        ctx.out[i] = x;
        _ = @atomic_add(&mut ctx.sum, @as(u64, x));
    }
}

fn demo() !void {
    let mut sh = Shared.{ bar: sync.Barrier.init(3), lock: sync.Mutex.init(), c3: 11322852004107280004, q0: -1375390204,
                          c8: 232, c1: 4611686018427387903, c5: 32768, k1: 3989449634668016053, c10: -127, q2: 89,
                          c6: 1623845705, q1: 3, c11: 4194303, c9: 1962822907, c7: 10257540989848309540, c2: 408419196,
                          c0: 87, k0: 218, q3: 65534, c4: 2055495534, x0: 24010,
                          s0: sync.Atomic.[i64].init(4611686018427387903), turn: 0, tlog: [0; 18], tn: 0, m_sum: 0,
                          m_b: 0, m_cnt: 0, m_h: 0, slots: [Slot.{ b8: 0, tsum: 0, b16: 0, xsum: 0, b8b: 0, xxor: 0,
                                                                   err: 0, tl: 0 }; 3], bytes: [0; 27],
                          halves: [0; 27] };
    let mut ts: [3]thread.Thread.[Arg] = [thread.spawn(worker, Arg.{ sh: &mut sh, id: 0 })!,
                                          thread.spawn(worker, Arg.{ sh: &mut sh, id: 1 })!,
                                          thread.spawn(worker, Arg.{ sh: &mut sh, id: 2 })!];
    for &mut t in ts {
        t.join();
    }
    let mut h: u64 = 0;
    h = h_u8(h, sh.c0);
    h = h_i64(h, sh.c1);
    h = h_usize(h, sh.c2);
    h = h_u64(h, sh.c3);
    h = h_usize(h, sh.c4);
    h = h_u16(h, sh.c5);
    h = h_i32(h, sh.c6);
    h = h_u64(h, sh.c7);
    h = h_u8(h, sh.c8);
    h = h_i32(h, sh.c9);
    h = h_i8(h, sh.c10);
    h = h_isize(h, sh.c11);
    io.uint(h);  // expect: 11797644036141553406
    h = 0;
    let mut tsum: u64 = 0;
    for &s in sh.slots {
        tsum +%= s.tsum;
    }
    h = h_u8(h, sh.k0);
    h = h_i64(h, sh.k1);
    h = mix(h, tsum);
    io.uint(h);  // expect: 4907379114313499576
    h = 0;
    let mut xsum: u64 = 0;
    let mut xxor: u64 = 0;
    for &s in sh.slots {
        xsum +%= s.xsum;
        xxor ^= s.xxor;
    }
    xsum +%= @as(u64, sh.x0);
    xxor ^= @as(u64, sh.x0);
    h = mix(mix(h, xsum), xxor);
    io.uint(h);  // expect: 12205881076258993106
    h = 0;
    h = h_i32(h, sh.q0);
    h = h_i8(h, sh.q1);
    h = h_u8(h, sh.q2);
    h = h_u16(h, sh.q3);
    io.uint(h);  // expect: 3408507254300240412
    h = 0;
    h = h_i64(h, sh.s0.load());
    h = h_u64(h, sh.m_sum);
    h = h_u8(h, sh.m_b);
    h = h_u32(h, sh.m_cnt);
    h = h_u64(h, sh.m_h);
    io.uint(h);  // expect: 10358790698389425858
    h = 0;
    for &s in sh.slots {
        h = h_u8(h, s.b8);
        h = h_i16(h, s.b16);
        h = h_u8(h, s.b8b);
        h = h_u32(h, s.err);
        h = h_u64(h, s.tl);
    }
    for b in sh.bytes {
        h = h_u8(h, b);
    }
    for x in sh.halves {
        h = h_u16(h, x);
    }
    h = h_u64(h, TL);
    io.uint(h);  // expect: 7405621212367583526
    h = h_usize(0, sh.tn);
    for x in sh.tlog {
        h = h_u64(h, x);
    }
    io.uint(h);  // expect: 6823691303572353274
    let mut pf_out: [34]u32 = [0; 34];
    let mut pf = Pf.{ out: pf_out[..], sum: 0 };
    thread.parallel_for(34, 3, pf_body, &mut pf)!;
    h = h_u64(0, pf.sum);
    for x in pf_out {
        h = h_u32(h, x);
    }
    io.uint(h);  // expect: 6789785242239847925
}

export fn run() void {
    demo() catch @trap();
}
