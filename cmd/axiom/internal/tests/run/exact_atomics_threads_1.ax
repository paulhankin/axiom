fn mix(h: u64, x: u64) u64 {
    let y = (h ^ x) *% 1099511628211;
    return y ^ (y >> 32);
}

fn h_u8(h: u64, r: u8) u64 {
    return mix(h, @as(u64, r));
}

fn h_u16(h: u64, r: u16) u64 {
    return mix(h, @as(u64, r));
}

fn h_u32(h: u64, r: u32) u64 {
    return mix(h, @as(u64, r));
}

fn h_u64(h: u64, r: u64) u64 {
    return mix(h, r);
}

fn h_usize(h: u64, r: usize) u64 {
    return mix(h, @as(u64, r));
}

fn h_i8(h: u64, r: i8) u64 {
    return mix(h, @bit_cast(u64, @as(i64, r)));
}

fn h_i16(h: u64, r: i16) u64 {
    return mix(h, @bit_cast(u64, @as(i64, r)));
}

fn h_i32(h: u64, r: i32) u64 {
    return mix(h, @bit_cast(u64, @as(i64, r)));
}

fn h_i64(h: u64, r: i64) u64 {
    return mix(h, @bit_cast(u64, r));
}

fn h_isize(h: u64, r: isize) u64 {
    return mix(h, @bit_cast(u64, @as(i64, r)));
}

fn h_bool(h: u64, r: bool) u64 {
    return mix(h, @as(u64, r));
}

fn h_f32(h: u64, r: f32) u64 {
    if r != r {
        return mix(h, 0x7fc00000);
    }
    return mix(h, @as(u64, @bit_cast(u32, r)));
}

fn h_f64(h: u64, r: f64) u64 {
    if r != r {
        return mix(h, 0x7ff8000000000000);
    }
    return mix(h, @bit_cast(u64, r));
}

struct Slot {
    b8: u8,
    tsum: u64,
    b16: i16,
    xsum: u64,
    b8b: u8,
    xxor: u64,
    err: u32,
    tl: u64,
}

struct Shared {
    bar: sync.Barrier,
    lock: sync.Mutex,
    c3: u64,
    q0: i32,
    c8: u8,
    c1: i64,
    c5: u16,
    k1: i64,
    c10: i8,
    q2: u8,
    c6: i32,
    q1: i8,
    c11: isize,
    c9: i32,
    c7: u64,
    c2: usize,
    c0: u8,
    k0: u8,
    q3: u16,
    c4: usize,
    x0: u16,
    s0: sync.Atomic.[i64],
    turn: u32,
    tlog: [18]u64,
    tn: usize,
    m_sum: u64,
    m_b: u8,
    m_cnt: u32,
    m_h: u64,
    slots: [3]Slot,
    bytes: [27]u8,
    halves: [27]u16,
}

struct Arg {
    sh: *mut Shared,
    id: usize,
}

fn worker(arg: Arg) void {
    let sh = arg.sh;
    let id = arg.id;
    let slot = &mut sh.slots[id];
    _ = sh.bar.wait();
    for it in @as(usize, 0)..323 {
        let k = it * 3 + id;
        _ = sh.s0.add(V17[k % V17.len]);
        sh.bytes[(it % 9) * 3 + id] = @truncate(u8, it *% 7 +% id *% 13 +% 1);
        sh.halves[(it % 9) * 3 + id] = @truncate(u16, it *% 331 +% id);
        slot.b8 = @truncate(u8, k);
        slot.b16 = @bit_cast(i16, @truncate(u16, k *% 3));
        slot.b8b = @truncate(u8, it +% 5);
        TL = mix(TL, @as(u64, k));
        {
            let v = V13[k % V13.len];
            let mut old = sh.q0;
            loop {
                let seen = @atomic_cas(&mut sh.q0, old, @max(old, v), "acq_rel");
                if seen == old {
                    break;
                }
                old = seen;
            }
        }
        loop {
            let old = @atomic_load(&sh.q2);
            if @atomic_cas(&mut sh.q2, old, old | V15[k % V15.len]) == old {
                break;
            }
        }
        _ = @atomic_min(&mut sh.c11, V11[k % V11.len], "acq_rel");
        {
            let v = V16[k % V16.len];
            let mut old = sh.q3;
            loop {
                let seen = @atomic_cas(&mut sh.q3, old, old +% v, "release");
                if seen == old {
                    break;
                }
                old = seen;
            }
        }
        loop {
            let old = @atomic_load(&sh.q1);
            if @atomic_cas(&mut sh.q1, old, old *% V14[k % V14.len]) == old {
                break;
            }
        }
        slot.tsum +%= @as(u64, @atomic_add(&mut sh.k0, 225, "acquire"));
        slot.tsum +%= @bit_cast(u64, @atomic_add(&mut sh.k1, 1, "relaxed"));
        _ = @atomic_or(&mut sh.c3, V3[k % V3.len], "release");
        {
            let o = @as(u64, @atomic_xchg(&mut sh.x0, V12[k % V12.len]));
            slot.xsum +%= o;
            slot.xxor ^= o;
        }
        {
            let o = @atomic_and(&mut sh.c6, V6[k % V6.len], "relaxed");
            if (o | 1623845705) != 1623845705 {
                slot.err += 1;
            }
        }
        {
            let o = @atomic_min(&mut sh.c10, V10[k % V10.len]);
            if o > -127 {
                slot.err += 1;
            }
        }
        _ = @atomic_and(&mut sh.c8, V8[k % V8.len]);
        _ = @atomic_min(&mut sh.c5, V5[k % V5.len]);
        _ = @atomic_xor(&mut sh.c4, V4[k % V4.len], "release");
        {
            let o = @atomic_or(&mut sh.c1, V1[k % V1.len], "relaxed");
            if (o & 4611686018427387903) != 4611686018427387903 {
                slot.err += 1;
            }
        }
        _ = @atomic_xor(&mut sh.c2, V2[k % V2.len]);
        {
            let o = @atomic_max(&mut sh.c7, V7[k % V7.len], "relaxed");
            if o < 10257540989848309540 {
                slot.err += 1;
            }
        }
        {
            let o = @atomic_min(&mut sh.c9, V9[k % V9.len]);
            if o > 1962822907 {
                slot.err += 1;
            }
        }
        {
            let v = MV[k % MV.len];
            sh.lock.lock();
            sh.m_sum +%= @as(u64, v);
            sh.m_b +%= @truncate(u8, v);
            sh.m_cnt += 1;
            sh.m_h +%= mix(0, @as(u64, v));
            sh.lock.unlock();
        }
        {
            let o = @atomic_and(&mut sh.c0, V0[k % V0.len]);
            if (o | 87) != 87 {
                slot.err += 1;
