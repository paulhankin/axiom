// Programs on which the optimizer's own arithmetic overflowed (and, since
// overflow traps, the compiler stopped with T0002): a bound times a factor
// in gvn's at_least, and a power-of-two test of the constant 0 in opt's
// one_bit. Found by the generated tests of exact results.
import "../lib/io.ax" as io;

let mut A: [1]i8 = [0];
let mut U: [2]u32 = [7, 40];
let mut S: [2]i32 = [3, 0];

fn f(a: u32, b: i32) i32 {
    return @int_cast(i32, a & 31) *% (@sub_checked(@mul_checked(b, -1838285803) catch 2, 5) catch 2);
}

export fn run() void {
    io.int(@as(i64, f(U[0], S[0])));             // expect: -21
    io.int(@as(i64, f(U[1], S[1])));             // expect: -40
    io.int(@as(i64, @int_cast(u32, A[0] & 0)));  // expect: 0
}
