// An instruction that reads a load folded into it (its memory operand) is
// not moved down to its use past a store or a call that changes that
// memory (x86-64 sink_to_use): it would read the new value.
import "../lib/io.ax" as io;

let mut A: [4]u64 = [1, 2, 3, 4];
let mut C: u64 = 1;
let mut I: [4]usize = [1, 0, 0, 0];
let mut T: [8]u64 = [0, 10, 20, 30, 40, 50, 60, 70];

// x + 5, then a store to p
fn add_store(p: *mut u64, q: *mut u64) void {
    let x = p.*;
    let y = x +% 5;
    p.* = 100;
    q.* = y;
}

// x & m with m used later, then a store to p
fn and_store(p: *mut u64, q: *mut u64, m0: u64) u64 {
    let m = m0 ^ 1;
    let x = p.*;
    let y = x & m;
    p.* = 100;
    q.* = y +% m;
    return m;
}

fn set() void {
    C = 100;
}

// x + 5, then a call that changes p's memory
fn add_call(p: *mut u64) u64 {
    let x = p.*;
    let y = x +% 5;
    set();
    return y *% 1;
}

// an index computed from a load, then a store to it
fn index_store(p: *mut usize, t: *mut u64) u64 {
    let x = p.*;
    let y = x +% 1;
    p.* = 3;
    return @ptr_add(t, y).*;
}

// (through pointers: not inlined)
let mut F1: fn(*mut u64, *mut u64) void = add_store;
let mut F2: fn(*mut u64, *mut u64, u64) u64 = and_store;
let mut F3: fn(*mut u64) u64 = add_call;
let mut F4: fn(*mut usize, *mut u64) u64 = index_store;

export fn run() void {
    F1(&mut A[0], &mut A[1]);
    io.uint(A[1]);
    A[2] = 3;
    let m = F2(&mut A[2], &mut A[3], 7);
    io.uint(A[3] -% m);
    io.uint(F3(&mut C));
    io.uint(F4(&mut I[0], &mut T[0]));
}
// expect: 6
// expect: 2
// expect: 6
// expect: 20
