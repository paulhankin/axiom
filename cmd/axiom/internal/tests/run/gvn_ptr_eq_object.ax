// Equal pointers need not point into the same object: one past the end of
// an array may be the address of the next. Below a true `p == q`, gvn does
// not replace q by p, which would lose the object a store through q writes.
// flags: -O1
import "../lib/io.ax" as io;

fn f(k: usize) i32 {
    let mut a: [4]i32 = [1, 1, 1, 1];
    let mut b: [4]i32 = [1, 1, 1, 1];
    let p: *mut i32 = @ptr_add(&mut a[0], 4);
    let p2: *mut i32 = @ptr_add(&mut b[0], 4);
    let q: *mut i32 = @ptr_add(&mut b[0], k);
    let q2: *mut i32 = @ptr_add(&mut a[0], k);
    b[0] = 5;
    a[0] = 5;
    let mut bad: i32 = 0;
    if p == q {
        q.* = 7;
        if b[0] != 7 {
            bad += 1;
        }
    }
    if p2 == q2 {
        q2.* = 9;
        if a[0] != 9 {
            bad += 10;
        }
    }
    return bad;
}

let mut F: fn(usize) i32 = f;

export fn run() void {
    io.int(@as(i64, F(0)));
}
// expect: 0
