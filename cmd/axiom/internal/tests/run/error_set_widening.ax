// A narrower error union converts to a wider one (spec §11.3): S!T to !T,
// and A!T to B!T where B holds every error of A; so does a function whose
// results widen so, as a function pointer.
import "../lib/io.ax" as io;

error Small { NotFound }
error Big = Small | { Busy };

fn find(n: u32) Small!u32 {
    if n == 0 {
        return error.NotFound;
    }
    return n * 2;
}

fn bigger(n: u32) Big!u32 {
    return find(n);  // Small!u32 widens to Big!u32
}

fn anything(n: u32) !u32 {
    return find(n);  // and to !u32
}

fn code(r: !u32) u64 {
    let v = r catch |e| {
        io.str(@error_name(e));
        return 0;
    };
    return @as(u64, v);
}

export fn run() void {
    io.uint(code(find(4)));  // a Small!u32 argument for a !u32 parameter
    io.uint(code(bigger(0)));
    io.uint(code(anything(5)));
    let p: fn(u32) !u32 = find;  // a function pointer whose results widen
    io.uint(code(p(7)));
    let q: fn(u32) Big!u32 = find;
    io.uint(code(q(0)));
    let held: !u32 = find(3);
    io.uint(code(held));
}

// expect: 8
// expect: NotFound
// expect: 0
// expect: 10
// expect: 14
// expect: NotFound
// expect: 0
// expect: 6
