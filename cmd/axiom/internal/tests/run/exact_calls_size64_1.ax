fn hs_t1(h: u64, v: E1) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
        .M2 => { return mix(h, 2); }
        .M3 => { return mix(h, 3); }
        .M4 => { return mix(h, 4); }
        .M5 => { return mix(h, 5); }
    }
}

fn mk_t1(x: u64) E1 {
    match x % 6 {
        0    => { return E1.M0; }
        1    => { return E1.M1; }
        2    => { return E1.M2; }
        3    => { return E1.M3; }
        4    => { return E1.M4; }
        else => { return E1.M5; }
    }
}

