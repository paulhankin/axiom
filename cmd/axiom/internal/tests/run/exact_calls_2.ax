    return hb256(h0, @bit_cast(u64x4, v));
}

fn mk_i32x8(x: u64) i32x8 {
    return @vec(i32x8, mk_i32(mix(x, 1)), mk_i32(mix(x, 2)), mk_i32(mix(x, 3)), mk_i32(mix(x, 4)), mk_i32(mix(x, 5)),
                mk_i32(mix(x, 6)), mk_i32(mix(x, 7)), mk_i32(mix(x, 8)));
}

fn st_i32x8(v: i32x8) i32x8 {
    let c: i32x8 = @splat(-1616501714);
