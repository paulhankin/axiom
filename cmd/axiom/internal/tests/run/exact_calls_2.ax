fn st_f32x4(v: f32x4) f32x4 {
    let a: f32x4 = @splat(2.0);
    let b: f32x4 = @splat(1.0);
    return (v * a) + b;
}

fn hs_u8x16(h0: u64, v: u8x16) u64 {
    return hb128(h0, @bit_cast(u64x2, v));
}

fn mk_u8x16(x: u64) u8x16 {
    return @vec(u8x16, mk_u8(mix(x, 1)), mk_u8(mix(x, 2)), mk_u8(mix(x, 3)), mk_u8(mix(x, 4)), mk_u8(mix(x, 5)),
                mk_u8(mix(x, 6)), mk_u8(mix(x, 7)), mk_u8(mix(x, 8)), mk_u8(mix(x, 9)), mk_u8(mix(x, 10)),
