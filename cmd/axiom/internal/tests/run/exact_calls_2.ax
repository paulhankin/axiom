fn mk_i16x32(x: u64) i16x32 {
    return @vec(i16x32, mk_i16(mix(x, 1)), mk_i16(mix(x, 2)), mk_i16(mix(x, 3)), mk_i16(mix(x, 4)), mk_i16(mix(x, 5)),
                mk_i16(mix(x, 6)), mk_i16(mix(x, 7)), mk_i16(mix(x, 8)), mk_i16(mix(x, 9)), mk_i16(mix(x, 10)),
                mk_i16(mix(x, 11)), mk_i16(mix(x, 12)), mk_i16(mix(x, 13)), mk_i16(mix(x, 14)), mk_i16(mix(x, 15)),
                mk_i16(mix(x, 16)), mk_i16(mix(x, 17)), mk_i16(mix(x, 18)), mk_i16(mix(x, 19)), mk_i16(mix(x, 20)),
                mk_i16(mix(x, 21)), mk_i16(mix(x, 22)), mk_i16(mix(x, 23)), mk_i16(mix(x, 24)), mk_i16(mix(x, 25)),
                mk_i16(mix(x, 26)), mk_i16(mix(x, 27)), mk_i16(mix(x, 28)), mk_i16(mix(x, 29)), mk_i16(mix(x, 30)),
                mk_i16(mix(x, 31)), mk_i16(mix(x, 32)));
}

fn st_i16x32(v: i16x32) i16x32 {
    let c: i16x32 = @splat(32767);
    return v +% c;
}

fn hs_f32x16(h0: u64, v: f32x16) u64 {
    let mut h = h0;
    h = hs_f32(h, @extract_lane(v, 0));
    h = hs_f32(h, @extract_lane(v, 1));
    h = hs_f32(h, @extract_lane(v, 2));
    h = hs_f32(h, @extract_lane(v, 3));
    h = hs_f32(h, @extract_lane(v, 4));
    h = hs_f32(h, @extract_lane(v, 5));
    h = hs_f32(h, @extract_lane(v, 6));
    h = hs_f32(h, @extract_lane(v, 7));
    h = hs_f32(h, @extract_lane(v, 8));
    h = hs_f32(h, @extract_lane(v, 9));
    h = hs_f32(h, @extract_lane(v, 10));
    h = hs_f32(h, @extract_lane(v, 11));
    h = hs_f32(h, @extract_lane(v, 12));
    h = hs_f32(h, @extract_lane(v, 13));
    h = hs_f32(h, @extract_lane(v, 14));
    h = hs_f32(h, @extract_lane(v, 15));
    return h;
}

fn mk_f32x16(x: u64) f32x16 {
    return @vec(f32x16, mk_f32(mix(x, 1)), mk_f32(mix(x, 2)), mk_f32(mix(x, 3)), mk_f32(mix(x, 4)), mk_f32(mix(x, 5)),
                mk_f32(mix(x, 6)), mk_f32(mix(x, 7)), mk_f32(mix(x, 8)), mk_f32(mix(x, 9)), mk_f32(mix(x, 10)),
                mk_f32(mix(x, 11)), mk_f32(mix(x, 12)), mk_f32(mix(x, 13)), mk_f32(mix(x, 14)), mk_f32(mix(x, 15)),
                mk_f32(mix(x, 16)));
}

fn st_f32x16(v: f32x16) f32x16 {
    let a: f32x16 = @splat(1.5);
    let b: f32x16 = @splat(0.0);
    return (v * a) + b;
}

fn hs_t1(h: u64, v: E1) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
        .M2 => { return mix(h, 2); }
        .M3 => { return mix(h, 3); }
        .M4 => { return mix(h, 4); }
        .M5 => { return mix(h, 5); }
    }
}

fn mk_t1(x: u64) E1 {
    match x % 6 {
        0    => { return E1.M0; }
        1    => { return E1.M1; }
        2    => { return E1.M2; }
        3    => { return E1.M3; }
        4    => { return E1.M4; }
        else => { return E1.M5; }
    }
}

fn st_t1(v: E1) E1 {
    match v {
        .M0 => { return E1.M1; }
        .M1 => { return E1.M2; }
        .M2 => { return E1.M3; }
        .M3 => { return E1.M4; }
        .M4 => { return E1.M5; }
        .M5 => { return E1.M0; }
    }
}

fn hs_t2(h: u64, v: E2) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
        .M2 => { return mix(h, 2); }
        .M3 => { return mix(h, 3); }
        .M4 => { return mix(h, 4); }
        .M5 => { return mix(h, 5); }
    }
}

fn mk_t2(x: u64) E2 {
    match x % 6 {
        0    => { return E2.M0; }
        1    => { return E2.M1; }
        2    => { return E2.M2; }
        3    => { return E2.M3; }
        4    => { return E2.M4; }
        else => { return E2.M5; }
    }
}

fn st_t2(v: E2) E2 {
    match v {
        .M0 => { return E2.M1; }
        .M1 => { return E2.M2; }
        .M2 => { return E2.M3; }
        .M3 => { return E2.M4; }
        .M4 => { return E2.M5; }
        .M5 => { return E2.M0; }
    }
}

fn hs_t4(h0: u64, v: S4) u64 {
    let mut h = h0;
    h = hs_u32(h, v.f0);
    h = hs_t2(h, v.f1);
    h = hs_i8(h, v.f2);
    h = hs_i32(h, v.f3);
    h = hs_f32(h, v.f4);
    h = hs_u16(h, v.f5);
    h = hs_f32(h, v.f6);
    h = hs_u16(h, v.f7);
    h = hs_u64(h, v.f8);
    h = hs_f32(h, v.f9);
    h = hs_u64(h, v.f10);
    return h;
}

fn mk_t4(x: u64) S4 {
    return S4.{ f0: mk_u32(mix(x, 1)), f1: mk_t2(mix(x, 2)), f2: mk_i8(mix(x, 3)), f3: mk_i32(mix(x, 4)),
                f4: mk_f32(mix(x, 5)), f5: mk_u16(mix(x, 6)), f6: mk_f32(mix(x, 7)), f7: mk_u16(mix(x, 8)),
                f8: mk_u64(mix(x, 9)), f9: mk_f32(mix(x, 10)), f10: mk_u64(mix(x, 11)) };
}

fn st_t4(v: S4) S4 {
    return S4.{ f0: st_u32(v.f0), f1: st_t2(v.f1), f2: st_i8(v.f2), f3: st_i32(v.f3), f4: st_f32(v.f4),
                f5: st_u16(v.f5), f6: st_f32(v.f6), f7: st_u16(v.f7), f8: st_u64(v.f8), f9: st_f32(v.f9),
                f10: st_u64(v.f10) };
}

fn hs_t5(h: u64, v: U5) u64 {
    match v {
        .V0(p) => { return hs_f64(mix(h, 0), p); }
        .V1(p) => { return hs_u16(mix(h, 1), p); }
        .V2(p) => { return hs_f32(mix(h, 2), p); }
        .V3(p) => { return hs_t2(mix(h, 3), p); }
        .V4(p) => { return hs_bool(mix(h, 4), p); }
    }
}

fn mk_t5(x: u64) U5 {
    match x % 5 {
        0    => { return U5.V0(mk_f64(mix(x, 99))); }
        1    => { return U5.V1(mk_u16(mix(x, 99))); }
        2    => { return U5.V2(mk_f32(mix(x, 99))); }
        3    => { return U5.V3(mk_t2(mix(x, 99))); }
        else => { return U5.V4(mk_bool(mix(x, 99))); }
    }
}

fn st_t5(v: U5) U5 {
    match v {
        .V0(p) => { return U5.V0(st_f64(p)); }
        .V1(p) => { return U5.V1(st_u16(p)); }
        .V2(p) => { return U5.V2(st_f32(p)); }
        .V3(p) => { return U5.V3(st_t2(p)); }
        .V4(p) => { return U5.V4(st_bool(p)); }
    }
}

fn hs_t6(h0: u64, v: S6) u64 {
    let mut h = h0;
    h = hs_u16(h, v.f0);
    h = hs_i32(h, v.f1);
    h = hs_t1(h, v.f2);
    h = hs_t5(h, v.f3);
    return h;
}

fn mk_t6(x: u64) S6 {
    return S6.{ f0: mk_u16(mix(x, 1)), f1: mk_i32(mix(x, 2)), f2: mk_t1(mix(x, 3)), f3: mk_t5(mix(x, 4)) };
}

fn st_t6(v: S6) S6 {
    return S6.{ f0: st_u16(v.f0), f1: st_i32(v.f1), f2: st_t1(v.f2), f3: st_t5(v.f3) };
}

fn hs_t7(h0: u64, v: Two.[f32, f64]) u64 {
    let mut h = h0;
    h = hs_f32(h, v.a);
    h = hs_f64(h, v.b);
    return h;
}

fn mk_t7(x: u64) Two.[f32, f64] {
    return Two.[f32, f64].{ a: mk_f32(mix(x, 1)), b: mk_f64(mix(x, 2)) };
}

fn st_t7(v: Two.[f32, f64]) Two.[f32, f64] {
    return Two.[f32, f64].{ a: st_f32(v.a), b: st_f64(v.b) };
}

fn hs_t8(h0: u64, v: S8) u64 {
    let mut h = h0;
    h = hs_u8(h, v.f0);
    h = hs_u64(h, v.f1);
    h = hs_t5(h, v.f2);
    return h;
}

fn mk_t8(x: u64) S8 {
    return S8.{ f0: mk_u8(mix(x, 1)), f1: mk_u64(mix(x, 2)), f2: mk_t5(mix(x, 3)) };
}

fn st_t8(v: S8) S8 {
    return S8.{ f0: st_u8(v.f0), f1: st_u64(v.f1), f2: st_t5(v.f2) };
}

fn hs_t9(h0: u64, v: S9) u64 {
    let mut h = h0;
    h = hs_usize(h, v.f0);
    return h;
}

fn mk_t9(x: u64) S9 {
    return S9.{ f0: mk_usize(mix(x, 1)) };
}

fn st_t9(v: S9) S9 {
    return S9.{ f0: st_usize(v.f0) };
}

fn hs_t10(h0: u64, v: S10) u64 {
    let mut h = h0;
    h = hs_t9(h, v.f0);
    h = hs_t7(h, v.f1);
    return h;
}

fn mk_t10(x: u64) S10 {
    return S10.{ f0: mk_t9(mix(x, 1)), f1: mk_t7(mix(x, 2)) };
}

fn st_t10(v: S10) S10 {
    return S10.{ f0: st_t9(v.f0), f1: st_t7(v.f1) };
}

fn hs_t11(h0: u64, v: S11) u64 {
    let mut h = h0;
    h = hs_t6(h, v.f0);
    return h;
}

fn mk_t11(x: u64) S11 {
    return S11.{ f0: mk_t6(mix(x, 1)) };
}

fn st_t11(v: S11) S11 {
    return S11.{ f0: st_t6(v.f0) };
}

fn hs_t12(h0: u64, v: [1]E1) u64 {
    let mut h = h0;
    for x in v {
        h = hs_t1(h, x);
    }
    return h;
}

fn mk_t12(x: u64) [1]E1 {
    return [mk_t1(mix(x, 1))];
}

fn st_t12(v: [1]E1) [1]E1 {
    let mut r = v;
    for i in 0..r.len {
        r[i] = st_t1(r[i]);
    }
    return r;
}

fn hs_t13(h0: u64, v: [2]S9) u64 {
    let mut h = h0;
    for x in v {
        h = hs_t9(h, x);
    }
    return h;
}

fn mk_t13(x: u64) [2]S9 {
    return [mk_t9(mix(x, 1)), mk_t9(mix(x, 2))];
}

fn st_t13(v: [2]S9) [2]S9 {
    let mut r = v;
    for i in 0..r.len {
        r[i] = st_t9(r[i]);
    }
    return r;
}

fn hs_t14(h0: u64, v: S14) u64 {
    let mut h = h0;
    h = hs_t2(h, v.f0);
    h = hs_i16(h, v.f1);
    h = hs_isize(h, v.f2);
    h = hs_isize(h, v.f3);
    h = hs_t11(h, v.f4);
    h = hs_u64(h, v.f5);
    h = hs_t12(h, v.f6);
    h = hs_t6(h, v.f7);
    h = hs_t13(h, v.f8);
    h = hs_t7(h, v.f9);
    h = hs_t9(h, v.f10);
    return h;
}

fn mk_t14(x: u64) S14 {
    return S14.{ f0: mk_t2(mix(x, 1)), f1: mk_i16(mix(x, 2)), f2: mk_isize(mix(x, 3)), f3: mk_isize(mix(x, 4)),
                 f4: mk_t11(mix(x, 5)), f5: mk_u64(mix(x, 6)), f6: mk_t12(mix(x, 7)), f7: mk_t6(mix(x, 8)),
                 f8: mk_t13(mix(x, 9)), f9: mk_t7(mix(x, 10)), f10: mk_t9(mix(x, 11)) };
}

fn st_t14(v: S14) S14 {
    return S14.{ f0: st_t2(v.f0), f1: st_i16(v.f1), f2: st_isize(v.f2), f3: st_isize(v.f3), f4: st_t11(v.f4),
                 f5: st_u64(v.f5), f6: st_t12(v.f6), f7: st_t6(v.f7), f8: st_t13(v.f8), f9: st_t7(v.f9),
                 f10: st_t9(v.f10) };
}

fn hs_t15(h0: u64, v: S15) u64 {
    let mut h = h0;
    h = hs_usize(h, v.f0);
    h = hs_i32(h, v.f1);
    h = hs_t14(h, v.f2);
    return h;
}

fn mk_t15(x: u64) S15 {
    return S15.{ f0: mk_usize(mix(x, 1)), f1: mk_i32(mix(x, 2)), f2: mk_t14(mix(x, 3)) };
}

fn st_t15(v: S15) S15 {
    return S15.{ f0: st_usize(v.f0), f1: st_i32(v.f1), f2: st_t14(v.f2) };
}

fn hs_t16(h0: u64, v: [3]usize) u64 {
    let mut h = h0;
    for x in v {
        h = hs_usize(h, x);
    }
    return h;
}

fn mk_t16(x: u64) [3]usize {
    return [mk_usize(mix(x, 1)), mk_usize(mix(x, 2)), mk_usize(mix(x, 3))];
}

fn st_t16(v: [3]usize) [3]usize {
    let mut r = v;
    for i in 0..r.len {
        r[i] = st_usize(r[i]);
    }
    return r;
}

fn hs_t18(h0: u64, v: S18) u64 {
    let mut h = h0;
    h = hs_t16(h, v.f0);
    h = hs_t15(h, v.f1);
    h = hs_t16(h, v.f2);
    return h;
}

fn mk_t18(x: u64) S18 {
    return S18.{ f0: mk_t16(mix(x, 1)), f1: mk_t15(mix(x, 2)), f2: mk_t16(mix(x, 3)) };
}

fn st_t18(v: S18) S18 {
    return S18.{ f0: st_t16(v.f0), f1: st_t15(v.f1), f2: st_t16(v.f2) };
}

fn hs_t17(h: u64, v: U17) u64 {
    match v {
        .V0    => { return mix(h, 0); }
        .V1(p) => { return hs_t6(mix(h, 1), p); }
        .V2    => { return mix(h, 2); }
        .V3(p) => { return hs_t18(mix(h, 3), p); }
    }
}

fn mk_t17(x: u64) U17 {
    match x % 4 {
        0    => { return U17.V0; }
        1    => { return U17.V1(mk_t6(mix(x, 99))); }
        2    => { return U17.V2; }
        else => { return U17.V3(mk_t18(mix(x, 99))); }
    }
}

fn st_t17(v: U17) U17 {
    match v {
        .V0    => { return U17.V0; }
        .V1(p) => { return U17.V1(st_t6(p)); }
        .V2    => { return U17.V2; }
        .V3(p) => { return U17.V3(st_t18(p)); }
    }
}

fn hs_t19(h0: u64, v: S19) u64 {
    let mut h = h0;
    h = hs_u8(h, v.f0);
    h = hs_t14(h, v.f1);
    return h;
}

fn mk_t19(x: u64) S19 {
    return S19.{ f0: mk_u8(mix(x, 1)), f1: mk_t14(mix(x, 2)) };
}

fn st_t19(v: S19) S19 {
    return S19.{ f0: st_u8(v.f0), f1: st_t14(v.f1) };
}

fn hs_t20(h: u64, v: ?E2) u64 {
    if let .some(p) = v {
        return hs_t2(mix(h, 1), p);
    }
    return mix(h, 0);
}

fn mk_t20(x: u64) ?E2 {
    if (x & 3) == 0 {
        return .none;
    }
    return mk_t2(mix(x, 5));
}

fn st_t20(v: ?E2) ?E2 {
    match v {
        .some(p) => { return .some(st_t2(p)); }
        .none    => { return .none; }
    }
}

fn hs_t21(h0: u64, v: [7]i8) u64 {
    let mut h = h0;
    for x in v {
        h = hs_i8(h, x);
    }
    return h;
}

fn mk_t21(x: u64) [7]i8 {
    return [mk_i8(mix(x, 1)), mk_i8(mix(x, 2)), mk_i8(mix(x, 3)), mk_i8(mix(x, 4)), mk_i8(mix(x, 5)), mk_i8(mix(x, 6)),
            mk_i8(mix(x, 7))];
}

fn st_t21(v: [7]i8) [7]i8 {
    let mut r = v;
    for i in 0..r.len {
        r[i] = st_i8(r[i]);
    }
    return r;
}

fn hs_t22(h0: u64, v: Two.[f32, ?E2]) u64 {
    let mut h = h0;
    h = hs_f32(h, v.a);
    h = hs_t20(h, v.b);
    return h;
}

fn mk_t22(x: u64) Two.[f32, ?E2] {
    return Two.[f32, ?E2].{ a: mk_f32(mix(x, 1)), b: mk_t20(mix(x, 2)) };
}

fn st_t22(v: Two.[f32, ?E2]) Two.[f32, ?E2] {
    return Two.[f32, ?E2].{ a: st_f32(v.a), b: st_t20(v.b) };
}

fn hs_t23(h: u64, v: Errs![1]E1) u64 {
    let p = v catch |e| {
        return mix(h, 100 + eidx(e));
    };
    return hs_t12(mix(h, 0), p);
}

fn mk_t23(x: u64) Errs![1]E1 {
    if (x % 5) == 0 {
        match (x >> 8) % 3 {
            0    => { return error.Bad; }
            1    => { return error.Worse; }
            else => { return error.Ugly; }
        }
    }
    return mk_t12(mix(x, 6));
}

fn st_t23(v: Errs![1]E1) Errs![1]E1 {
    let p = v catch |e| {
        return e;
    };
    return st_t12(p);
}

fn hs_t25(h0: u64, v: S25) u64 {
    let mut h = h0;
    h = hs_t7(h, v.f0);
    h = hs_f64(h, v.f1);
    h = hs_t8(h, v.f2);
    h = hs_t20(h, v.f3);
    return h;
}

fn mk_t25(x: u64) S25 {
    return S25.{ f0: mk_t7(mix(x, 1)), f1: mk_f64(mix(x, 2)), f2: mk_t8(mix(x, 3)), f3: mk_t20(mix(x, 4)) };
}

fn st_t25(v: S25) S25 {
    return S25.{ f0: st_t7(v.f0), f1: st_f64(v.f1), f2: st_t8(v.f2), f3: st_t20(v.f3) };
}

fn hs_t24(h0: u64, v: [3]S25) u64 {
    let mut h = h0;
    for x in v {
        h = hs_t25(h, x);
    }
    return h;
}

fn mk_t24(x: u64) [3]S25 {
    return [mk_t25(mix(x, 1)), mk_t25(mix(x, 2)), mk_t25(mix(x, 3))];
}

fn st_t24(v: [3]S25) [3]S25 {
    let mut r = v;
    for i in 0..r.len {
        r[i] = st_t25(r[i]);
    }
    return r;
}

fn hs_t27(h0: u64, v: S27) u64 {
    let mut h = h0;
    h = hs_t6(h, v.f0);
    h = hs_t12(h, v.f1);
    h = hs_t23(h, v.f2);
    h = hs_i64(h, v.f3);
    h = hs_t19(h, v.f4);
    h = hs_t7(h, v.f5);
    h = hs_t16(h, v.f6);
    h = hs_t22(h, v.f7);
    return h;
}

fn mk_t27(x: u64) S27 {
    return S27.{ f0: mk_t6(mix(x, 1)), f1: mk_t12(mix(x, 2)), f2: mk_t23(mix(x, 3)), f3: mk_i64(mix(x, 4)),
                 f4: mk_t19(mix(x, 5)), f5: mk_t7(mix(x, 6)), f6: mk_t16(mix(x, 7)), f7: mk_t22(mix(x, 8)) };
}

fn st_t27(v: S27) S27 {
    return S27.{ f0: st_t6(v.f0), f1: st_t12(v.f1), f2: st_t23(v.f2), f3: st_i64(v.f3), f4: st_t19(v.f4),
                 f5: st_t7(v.f5), f6: st_t16(v.f6), f7: st_t22(v.f7) };
}

fn hs_t26(h: u64, v: U26) u64 {
