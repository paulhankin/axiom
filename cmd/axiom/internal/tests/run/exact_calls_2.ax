fn mix(h: u64, x: u64) u64 {
    let y = (h ^ x) *% 1099511628211;
    return y ^ (y >> 32);
}

fn hb128(h0: u64, v: u64x2) u64 {
    let mut h = h0;
    h = mix(h, @extract_lane(v, 0));
    h = mix(h, @extract_lane(v, 1));
    return h;
}

fn hb256(h0: u64, v: u64x4) u64 {
    let mut h = h0;
    h = mix(h, @extract_lane(v, 0));
    h = mix(h, @extract_lane(v, 1));
    h = mix(h, @extract_lane(v, 2));
    h = mix(h, @extract_lane(v, 3));
    return h;
}

fn hb512(h0: u64, v: u64x8) u64 {
    let mut h = h0;
    h = mix(h, @extract_lane(v, 0));
    h = mix(h, @extract_lane(v, 1));
    h = mix(h, @extract_lane(v, 2));
    h = mix(h, @extract_lane(v, 3));
    h = mix(h, @extract_lane(v, 4));
    h = mix(h, @extract_lane(v, 5));
    h = mix(h, @extract_lane(v, 6));
    h = mix(h, @extract_lane(v, 7));
    return h;
}

fn gpick[T](c: bool, a: T, b: T) T {
    if c {
        return a;
    }
    return b;
}

fn gswap[T](a: *mut T, b: *mut T) void {
    let t = a.*;
    a.* = b.*;
    b.* = t;
}

fn gfold[T, const H: fn(u64, T) u64](h: u64, xs: []T) u64 {
    let mut r = h;
    for x in xs {
        r = H(r, x);
    }
    return r;
}

fn gderef[T, const H: fn(u64, T) u64](h: u64, p: *T) u64 {
    return H(h, p.*);
}

fn gmk[T, const M: fn(u64) T](x: u64) T {
    return M(x);
}

fn gget[T, const N: usize](a: [N]T, i: usize) T {
    return a[i % N];
}

fn gsum[T: Int](a: T, b: T, c: T) T {
    return (a +% b) ^ c;
}

fn gmax[T: Ord](a: T, b: T) T {
    return @max(a, b);
}

struct Two[A, B] {
    a: A,
    b: B,

    fn first(self: Self) A {
        return self.a;
    }

    fn second(self: *Self) B {
        return self.b;
    }
}

fn eidx(e: Errs) u64 {
    match e {
        error.Bad   => { return 1; }
        error.Worse => { return 2; }
        error.Ugly  => { return 3; }
    }
}

fn hs_u8(h: u64, v: u8) u64 {
    return mix(h, @as(u64, v));
}

fn mk_u8(x: u64) u8 {
    return @truncate(u8, x);
}

fn st_u8(v: u8) u8 {
    return (v ^ 255) +% 3;
}

fn hs_i8(h: u64, v: i8) u64 {
    return mix(h, @bit_cast(u64, @as(i64, v)));
}

fn mk_i8(x: u64) i8 {
    return @bit_cast(i8, @truncate(u8, x));
}

fn st_i8(v: i8) i8 {
    return (v ^ -1) +% 71;
}

fn hs_u16(h: u64, v: u16) u64 {
    return mix(h, @as(u64, v));
}

fn mk_u16(x: u64) u16 {
    return @truncate(u16, x);
}

fn st_u16(v: u16) u16 {
    return (v ^ 1) +% 65533;
}

fn hs_i16(h: u64, v: i16) u64 {
    return mix(h, @bit_cast(u64, @as(i64, v)));
}

fn mk_i16(x: u64) i16 {
    return @bit_cast(i16, @truncate(u16, x));
}

fn st_i16(v: i16) i16 {
    return (v ^ 0) +% 32767;
}

fn hs_u32(h: u64, v: u32) u64 {
    return mix(h, @as(u64, v));
}

fn mk_u32(x: u64) u32 {
    return @truncate(u32, x);
}

fn st_u32(v: u32) u32 {
    return (v ^ 4294967295) +% 1;
}

fn hs_i32(h: u64, v: i32) u64 {
    return mix(h, @bit_cast(u64, @as(i64, v)));
}

fn mk_i32(x: u64) i32 {
    return @bit_cast(i32, @truncate(u32, x));
}

fn st_i32(v: i32) i32 {
    return (v ^ 0) +% -1616501714;
}

fn hs_u64(h: u64, v: u64) u64 {
    return mix(h, v);
}

fn mk_u64(x: u64) u64 {
    return x;
}

fn st_u64(v: u64) u64 {
    return (v ^ 0) +% 7875900014212176173;
}

fn hs_i64(h: u64, v: i64) u64 {
    return mix(h, @bit_cast(u64, v));
}

fn mk_i64(x: u64) i64 {
    return @bit_cast(i64, x);
}

fn st_i64(v: i64) i64 {
    return (v ^ 1) +% -9223372036854775807;
}

fn hs_f32(h: u64, v: f32) u64 {
    if v != v {
        return mix(h, 0x7fc00000);
    }
    return mix(h, @as(u64, @bit_cast(u32, v)));
}

fn mk_f32(x: u64) f32 {
    return @float_from_int(f32, @bit_cast(i32, @truncate(u32, x))) * 0.0078125;
}

fn st_f32(v: f32) f32 {
    return (v * 2.0) + 1.0;
}

fn hs_f64(h: u64, v: f64) u64 {
    if v != v {
        return mix(h, 0x7ff8000000000000);
    }
    return mix(h, @bit_cast(u64, v));
}

fn mk_f64(x: u64) f64 {
    return @float_from_int(f64, @bit_cast(i32, @truncate(u32, x))) * 0.0078125;
}

fn st_f64(v: f64) f64 {
    return (v * 3.0) + 0.0;
}

fn hs_bool(h: u64, v: bool) u64 {
    return mix(h, @as(u64, v));
}

fn mk_bool(x: u64) bool {
    return ((x >> 3) & 1) == 1;
}

fn st_bool(v: bool) bool {
    return not v;
}

fn hs_i32x4(h0: u64, v: i32x4) u64 {
    return hb128(h0, @bit_cast(u64x2, v));
}

fn mk_i32x4(x: u64) i32x4 {
    return @vec(i32x4, mk_i32(mix(x, 1)), mk_i32(mix(x, 2)), mk_i32(mix(x, 3)), mk_i32(mix(x, 4)));
}

fn st_i32x4(v: i32x4) i32x4 {
    let c: i32x4 = @splat(-1616501714);
    return v +% c;
}

fn hs_f32x4(h0: u64, v: f32x4) u64 {
    let mut h = h0;
    h = hs_f32(h, @extract_lane(v, 0));
    h = hs_f32(h, @extract_lane(v, 1));
    h = hs_f32(h, @extract_lane(v, 2));
    h = hs_f32(h, @extract_lane(v, 3));
    return h;
}

fn mk_f32x4(x: u64) f32x4 {
    return @vec(f32x4, mk_f32(mix(x, 1)), mk_f32(mix(x, 2)), mk_f32(mix(x, 3)), mk_f32(mix(x, 4)));
