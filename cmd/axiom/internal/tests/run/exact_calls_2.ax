fn mk_t21(x: u64) U21 {
    match x % 4 {
        0    => { return U21.V0; }
        1    => { return U21.V1(mk_t20(mix(x, 99))); }
        2    => { return U21.V2; }
        else => { return U21.V3; }
    }
