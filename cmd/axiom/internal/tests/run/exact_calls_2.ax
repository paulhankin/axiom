fn mk_f32x8(x: u64) f32x8 {
    return @vec(f32x8, mk_f32(mix(x, 1)), mk_f32(mix(x, 2)), mk_f32(mix(x, 3)), mk_f32(mix(x, 4)), mk_f32(mix(x, 5)),
                mk_f32(mix(x, 6)), mk_f32(mix(x, 7)), mk_f32(mix(x, 8)));
