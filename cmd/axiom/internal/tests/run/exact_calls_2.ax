fn mk_f32x16(x: u64) f32x16 {
    return @vec(f32x16, mk_f32(mix(x, 1)), mk_f32(mix(x, 2)), mk_f32(mix(x, 3)), mk_f32(mix(x, 4)), mk_f32(mix(x, 5)),
                mk_f32(mix(x, 6)), mk_f32(mix(x, 7)), mk_f32(mix(x, 8)), mk_f32(mix(x, 9)), mk_f32(mix(x, 10)),
                mk_f32(mix(x, 11)), mk_f32(mix(x, 12)), mk_f32(mix(x, 13)), mk_f32(mix(x, 14)), mk_f32(mix(x, 15)),
                mk_f32(mix(x, 16)));
}

fn st_f32x16(v: f32x16) f32x16 {
    let a: f32x16 = @splat(2.0);
    let b: f32x16 = @splat(1.0);
    return (v * a) + b;
}

fn hs_t1(h: u64, v: E1) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
    }
}

fn mk_t1(x: u64) E1 {
    match x % 2 {
        0    => { return E1.M0; }
        else => { return E1.M1; }
    }
}

fn st_t1(v: E1) E1 {
    match v {
        .M0 => { return E1.M1; }
        .M1 => { return E1.M0; }
    }
}

fn hs_t2(h: u64, v: E2) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
        .M2 => { return mix(h, 2); }
        .M3 => { return mix(h, 3); }
    }
}

fn mk_t2(x: u64) E2 {
    match x % 4 {
        0    => { return E2.M0; }
        1    => { return E2.M1; }
        2    => { return E2.M2; }
        else => { return E2.M3; }
    }
}

fn st_t2(v: E2) E2 {
    match v {
        .M0 => { return E2.M1; }
        .M1 => { return E2.M2; }
        .M2 => { return E2.M3; }
        .M3 => { return E2.M0; }
    }
}

fn hs_t3(h: u64, v: ?f64) u64 {
    if let .some(p) = v {
        return hs_f64(mix(h, 1), p);
    }
    return mix(h, 0);
}

fn mk_t3(x: u64) ?f64 {
    if (x & 3) == 0 {
        return .none;
    }
    return mk_f64(mix(x, 5));
}

fn st_t3(v: ?f64) ?f64 {
    match v {
        .some(p) => { return .some(st_f64(p)); }
        .none    => { return .none; }
    }
}

fn hs_t4(h0: u64, v: S4) u64 {
    let mut h = h0;
    h = hs_u8(h, v.f0);
    h = hs_u64(h, v.f1);
    h = hs_f32(h, v.f2);
    return h;
}

fn mk_t4(x: u64) S4 {
    return S4.{ f0: mk_u8(mix(x, 1)), f1: mk_u64(mix(x, 2)), f2: mk_f32(mix(x, 3)) };
}

fn st_t4(v: S4) S4 {
    return S4.{ f0: st_u8(v.f0), f1: st_u64(v.f1), f2: st_f32(v.f2) };
}

fn hs_t5(h: u64, v: U5) u64 {
    match v {
        .V0(p) => { return hs_f64(mix(h, 0), p); }
        .V1    => { return mix(h, 1); }
        .V2(p) => { return hs_bool(mix(h, 2), p); }
    }
}

fn mk_t5(x: u64) U5 {
    match x % 3 {
        0    => { return U5.V0(mk_f64(mix(x, 99))); }
        1    => { return U5.V1; }
        else => { return U5.V2(mk_bool(mix(x, 99))); }
    }
}

fn st_t5(v: U5) U5 {
    match v {
        .V0(p) => { return U5.V0(st_f64(p)); }
        .V1    => { return U5.V1; }
        .V2(p) => { return U5.V2(st_bool(p)); }
    }
}

fn hs_t6(h0: u64, v: S6) u64 {
    let mut h = h0;
    h = hs_f64(h, v.f0);
    h = hs_u16(h, v.f1);
    h = hs_bool(h, v.f2);
    h = hs_u32(h, v.f3);
    h = hs_i32(h, v.f4);
    h = hs_t3(h, v.f5);
    h = hs_t3(h, v.f6);
    h = hs_i32(h, v.f7);
    h = hs_i64(h, v.f8);
    h = hs_bool(h, v.f9);
    h = hs_u32(h, v.f10);
    return h;
}

fn mk_t6(x: u64) S6 {
    return S6.{ f0: mk_f64(mix(x, 1)), f1: mk_u16(mix(x, 2)), f2: mk_bool(mix(x, 3)), f3: mk_u32(mix(x, 4)),
                f4: mk_i32(mix(x, 5)), f5: mk_t3(mix(x, 6)), f6: mk_t3(mix(x, 7)), f7: mk_i32(mix(x, 8)),
                f8: mk_i64(mix(x, 9)), f9: mk_bool(mix(x, 10)), f10: mk_u32(mix(x, 11)) };
}

fn st_t6(v: S6) S6 {
    return S6.{ f0: st_f64(v.f0), f1: st_u16(v.f1), f2: st_bool(v.f2), f3: st_u32(v.f3), f4: st_i32(v.f4),
                f5: st_t3(v.f5), f6: st_t3(v.f6), f7: st_i32(v.f7), f8: st_i64(v.f8), f9: st_bool(v.f9),
                f10: st_u32(v.f10) };
}

fn hs_t7(h0: u64, v: S7) u64 {
    let mut h = h0;
    h = hs_t3(h, v.f0);
    h = hs_i16(h, v.f1);
    h = hs_u64(h, v.f2);
    return h;
}

fn mk_t7(x: u64) S7 {
    return S7.{ f0: mk_t3(mix(x, 1)), f1: mk_i16(mix(x, 2)), f2: mk_u64(mix(x, 3)) };
}

fn st_t7(v: S7) S7 {
    return S7.{ f0: st_t3(v.f0), f1: st_i16(v.f1), f2: st_u64(v.f2) };
}

fn hs_t8(h0: u64, v: S8) u64 {
    let mut h = h0;
    h = hs_t6(h, v.f0);
    h = hs_t7(h, v.f1);
    h = hs_i8(h, v.f2);
    h = hs_t1(h, v.f3);
    return h;
}

fn mk_t8(x: u64) S8 {
    return S8.{ f0: mk_t6(mix(x, 1)), f1: mk_t7(mix(x, 2)), f2: mk_i8(mix(x, 3)), f3: mk_t1(mix(x, 4)) };
}

fn st_t8(v: S8) S8 {
    return S8.{ f0: st_t6(v.f0), f1: st_t7(v.f1), f2: st_i8(v.f2), f3: st_t1(v.f3) };
}

fn hs_t10(h0: u64, v: S10) u64 {
    let mut h = h0;
    h = hs_t8(h, v.f0);
    h = hs_bool(h, v.f1);
    h = hs_i64(h, v.f2);
    h = hs_t4(h, v.f3);
    h = hs_u16(h, v.f4);
    h = hs_t6(h, v.f5);
    h = hs_t2(h, v.f6);
    h = hs_t4(h, v.f7);
    return h;
}

fn mk_t10(x: u64) S10 {
    return S10.{ f0: mk_t8(mix(x, 1)), f1: mk_bool(mix(x, 2)), f2: mk_i64(mix(x, 3)), f3: mk_t4(mix(x, 4)),
                 f4: mk_u16(mix(x, 5)), f5: mk_t6(mix(x, 6)), f6: mk_t2(mix(x, 7)), f7: mk_t4(mix(x, 8)) };
}

fn st_t10(v: S10) S10 {
    return S10.{ f0: st_t8(v.f0), f1: st_bool(v.f1), f2: st_i64(v.f2), f3: st_t4(v.f3), f4: st_u16(v.f4),
                 f5: st_t6(v.f5), f6: st_t2(v.f6), f7: st_t4(v.f7) };
}

fn hs_t11(h: u64, v: ?E1) u64 {
    if let .some(p) = v {
        return hs_t1(mix(h, 1), p);
    }
    return mix(h, 0);
}

fn mk_t11(x: u64) ?E1 {
    if (x & 3) == 0 {
        return .none;
    }
    return mk_t1(mix(x, 5));
}

fn st_t11(v: ?E1) ?E1 {
    match v {
        .some(p) => { return .some(st_t1(p)); }
        .none    => { return .none; }
    }
}

fn hs_t12(h0: u64, v: S12) u64 {
    let mut h = h0;
    h = hs_i64(h, v.f0);
    h = hs_i32(h, v.f1);
    return h;
}

fn mk_t12(x: u64) S12 {
    return S12.{ f0: mk_i64(mix(x, 1)), f1: mk_i32(mix(x, 2)) };
}

fn st_t12(v: S12) S12 {
    return S12.{ f0: st_i64(v.f0), f1: st_i32(v.f1) };
}

fn hs_t13(h0: u64, v: S13) u64 {
    let mut h = h0;
    h = hs_t10(h, v.f0);
    h = hs_t3(h, v.f1);
    h = hs_t12(h, v.f2);
    return h;
}

fn mk_t13(x: u64) S13 {
    return S13.{ f0: mk_t10(mix(x, 1)), f1: mk_t3(mix(x, 2)), f2: mk_t12(mix(x, 3)) };
}

fn st_t13(v: S13) S13 {
    return S13.{ f0: st_t10(v.f0), f1: st_t3(v.f1), f2: st_t12(v.f2) };
}

fn hs_t14(h0: u64, v: S14) u64 {
    let mut h = h0;
    h = hs_t8(h, v.f0);
    return h;
}

fn mk_t14(x: u64) S14 {
    return S14.{ f0: mk_t8(mix(x, 1)) };
}

fn st_t14(v: S14) S14 {
    return S14.{ f0: st_t8(v.f0) };
}

fn hs_t15(h0: u64, v: S15) u64 {
    let mut h = h0;
    h = hs_t7(h, v.f0);
    return h;
}

fn mk_t15(x: u64) S15 {
    return S15.{ f0: mk_t7(mix(x, 1)) };
}

fn st_t15(v: S15) S15 {
    return S15.{ f0: st_t7(v.f0) };
}

fn hs_t16(h0: u64, v: [1]?f64) u64 {
    let mut h = h0;
    for x in v {
        h = hs_t3(h, x);
    }
    return h;
}

fn mk_t16(x: u64) [1]?f64 {
    return [mk_t3(mix(x, 1))];
}

fn st_t16(v: [1]?f64) [1]?f64 {
    let mut r = v;
    for i in 0..r.len {
        r[i] = st_t3(r[i]);
    }
    return r;
}

fn hs_t17(h0: u64, v: [2]?E1) u64 {
    let mut h = h0;
    for x in v {
        h = hs_t11(h, x);
    }
    return h;
}

fn mk_t17(x: u64) [2]?E1 {
    return [mk_t11(mix(x, 1)), mk_t11(mix(x, 2))];
}

fn st_t17(v: [2]?E1) [2]?E1 {
    let mut r = v;
    for i in 0..r.len {
        r[i] = st_t11(r[i]);
    }
    return r;
}

fn hs_t18(h0: u64, v: S18) u64 {
    let mut h = h0;
    h = hs_t4(h, v.f0);
    h = hs_i16(h, v.f1);
    h = hs_f64(h, v.f2);
    h = hs_f64(h, v.f3);
    h = hs_t15(h, v.f4);
    h = hs_u64(h, v.f5);
    h = hs_t16(h, v.f6);
    h = hs_t7(h, v.f7);
