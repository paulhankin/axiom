// A switch on a 64-bit value whose cases are close together becomes a
// table on WebAssembly: a value out of their range takes the default, not
// the case at the number of cases. Cases far apart (the extremes, whose
// distance doesn't fit an i64) are compared with in turn.
import "../lib/io.ax" as io;

// (mutable: the calls are not inlined, and the arguments not constants in
// the callees)
let mut NEAR: fn(i64) u64 = near;
let mut FAR: fn(i64) u64 = far;
let mut MIN_AND_ONE: fn(i64) u64 = min_and_one;

fn near(x: i64) u64 {
    match x {
        3    => { return 1; }
        5    => { return 2; }
        else => { return 3; }
    }
}

fn far(x: i64) u64 {
    match x {
        9223372036854775807  => { return 1; }
        -9223372036854775808 => { return 2; }
        1                    => { return 3; }
        -1                   => { return 5; }
        else                 => { return 4; }
    }
}

fn min_and_one(x: i64) u64 {
    match x {
        -9223372036854775808 => { return 2; }
        1                    => { return 3; }
        else                 => { return 4; }
    }
}

export fn run() void {
    io.uint(NEAR(64));
    io.uint(NEAR(5));
    io.uint(NEAR(3));
    io.uint(NEAR(4));
    io.uint(NEAR(-9223372036854775807));
    io.uint(FAR(1));
    io.uint(FAR(-9223372036854775807 - 1));
    io.uint(FAR(9223372036854775807));
    io.uint(FAR(-1));
    io.uint(FAR(2));
    io.uint(MIN_AND_ONE(1));
    io.uint(MIN_AND_ONE(-9223372036854775807 - 1));
    io.uint(MIN_AND_ONE(0));
}
// expect: 3
// expect: 2
// expect: 1
// expect: 3
// expect: 3
// expect: 3
// expect: 2
// expect: 1
// expect: 5
// expect: 4
// expect: 3
// expect: 2
// expect: 4
