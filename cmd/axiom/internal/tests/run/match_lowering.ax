    }
}

union Val {
    V0: i64,
    V1: i64,
    V2: i64,
    V3: i64,
    V4: i64,
    V5: i64,
    V6: i64,
    V7: i64,
    V8: i64,
    V9: i64,
    V10: i64,
    V11: i64,
}

fn valsum(v: Val) i64 {
    match v {
        .V0(x)  => { return x * 1 + 0; }
        .V1(x)  => { return x * 2 + 1; }
        .V2(x)  => { return x * 3 + 2; }
        .V3(x)  => { return x * 4 + 3; }
        .V4(x)  => { return x * 5 + 4; }
        .V5(x)  => { return x * 6 + 5; }
        .V6(x)  => { return x * 7 + 6; }
        .V7(x)  => { return x * 8 + 7; }
        .V8(x)  => { return x * 9 + 8; }
        .V9(x)  => { return x * 10 + 9; }
        .V10(x) => { return x * 11 + 10; }
        .V11(x) => { return x * 12 + 11; }
    }
}

fn loopm(n: i32) i64 {
    let mut s: i64 = 0;
    for i in @as(i32, 0)..n {
        match (i * 7) % 11 {
            0 => {
                s += 1;
                continue;
            }
            1 => { s += 3; }
            2 => { s *= 2; }
            3 => { s -= 7; }
            4 => {
                if s > 1000 {
                    break;
                }
                s += 11;
            }
            5    => { s ^= 5; }
            6, 7 => { s += @as(i64, i); }
            else => { s += 100; }
        }
        s += 1;
    }
    return s;
}

