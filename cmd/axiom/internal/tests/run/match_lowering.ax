// Matches on integers and enums of every shape code generation lowers
// differently (switches.ax): jump tables (dense, with holes, thousands of
// entries, crossing zero and the type's limits), bit tests, a search over
// sparse values, ranges, compare chains; signed, unsigned, narrow and
// 64-bit values; one arm and `else` alone; in a loop; enums and unions.
import "../lib/io.ax" as io;

let mut H: u64 = 1469598103934665603;

fn mix(x: u64) void {
    H = (H ^ x) *% 1099511628211;
}

