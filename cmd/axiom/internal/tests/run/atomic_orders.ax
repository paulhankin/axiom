// Optional trailing atomic memory orders on @atomic_* and @fence.
import "../lib/io.ax" as io;

fn generic_inc[T: Int](p: *mut T) T {
    return @atomic_add(p, @as(T, 1), "acq_rel");
}

export fn run() void {
    let mut x: u32 = 10;
    @atomic_store(&mut x, 42, "release");
    io.uint(@as(u64, @atomic_load(&x, "acquire")));  // expect: 42
    io.uint(@as(u64, @atomic_load(&x, "relaxed")));  // expect: 42
    io.uint(@as(u64, @atomic_load(&x, "seq_cst")));  // expect: 42
    io.uint(@as(u64, @atomic_load(&x)));             // expect: 42

    @fence("relaxed");
    @fence("acquire");
    @fence("release");
    @fence("acq_rel");
    @fence("seq_cst");
    @fence();

    io.uint(@as(u64, @atomic_add(&mut x, 8, "relaxed")));     // expect: 42
    io.uint(@as(u64, @atomic_sub(&mut x, 5, "acquire")));     // expect: 50
    io.uint(@as(u64, @atomic_and(&mut x, 0x0f, "release")));  // expect: 45
    io.uint(@as(u64, @atomic_or(&mut x, 0x10, "acq_rel")));   // expect: 13
    io.uint(@as(u64, @atomic_xor(&mut x, 0x01, "seq_cst")));  // expect: 29
    io.uint(@as(u64, @atomic_min(&mut x, 10, "relaxed")));    // expect: 28
    io.uint(@as(u64, @atomic_max(&mut x, 77, "acq_rel")));    // expect: 10
    io.uint(@as(u64, @atomic_xchg(&mut x, 99, "release")));   // expect: 77

    io.uint(@as(u64, @atomic_cas(&mut x, 99, 100, "relaxed")));   // expect: 99
    io.uint(@as(u64, @atomic_cas(&mut x, 100, 101, "acquire")));  // expect: 100
    io.uint(@as(u64, @atomic_cas(&mut x, 101, 102, "release")));  // expect: 101
    io.uint(@as(u64, @atomic_cas(&mut x, 102, 103, "acq_rel")));  // expect: 102
    io.uint(@as(u64, @atomic_cas(&mut x, 999, 0, "seq_cst")));    // expect: 103

    let prev = generic_inc(&mut x);
    io.uint(@as(u64, prev));              // expect: 103
    io.uint(@as(u64, @atomic_load(&x)));  // expect: 104
}
