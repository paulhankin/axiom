// A load in a loop's header runs whenever the loop is entered only if no
// call before it in the header may stop the program: licm does not move it
// to the preheader above such a call (here, one that traps on a bad index
// before the load would read far out of bounds).
// expect-trap
// flags: -O2
import "../lib/io.ax" as io;

let TABLE: [4]i64 = [10, 20, 30, 40];

fn check(k: usize) void {
    if k >= 4 {
        io.str("bad index");
        @trap();
    }
}

fn work(n: usize, k: usize) i64 {
    let mut s: i64 = 0;
    let mut i: usize = 0;
    while true {
        check(k);
        s += @ptr_add(&TABLE[0], k).*;
        if i >= n {
            break;
        }
        i += 1;
    }
    return s;
}

let mut W: fn(usize, usize) i64 = work;

export fn run() void {
    io.int(W(3, 2));
    io.int(W(3, 0x1fff_fff0));
}
// expect: 120
// expect: bad index
