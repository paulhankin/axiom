// A sum of neighbouring bytes is not made vector sums (x86-64 byte_sums) of
// bytes loaded in an earlier block than the sum's: the vector loads are at
// the sum, after stores the scalar loads come before (here in the sum's
// block, past a branch).
// flags: -O1
import "../lib/io.ax" as io;

fn sum(p: *mut [64]u8, c: usize) u32 {
    let z0 = @as(u32, p[0]);
    let z1 = @as(u32, p[1]);
    let z2 = @as(u32, p[2]);
    let z3 = @as(u32, p[3]);
    let z4 = @as(u32, p[4]);
    let z5 = @as(u32, p[5]);
    let z6 = @as(u32, p[6]);
    let z7 = @as(u32, p[7]);
    let z8 = @as(u32, p[8]);
    let z9 = @as(u32, p[9]);
    let z10 = @as(u32, p[10]);
    let z11 = @as(u32, p[11]);
    let z12 = @as(u32, p[12]);
    let z13 = @as(u32, p[13]);
    let z14 = @as(u32, p[14]);
    let z15 = @as(u32, p[15]);
    if c > 1 {
        p[20] = 1;
    }
    p[5] = 200;
    return z0 + z1 + z2 + z3 + z4 + z5 + z6 + z7 + z8 + z9 + z10 + z11 + z12 + z13 + z14 + z15;
}

export fn run() void {
    // (through pointers: the bytes are not constants in the callee)
    let fs = [sum, sum];
    let mut a: [64]u8 = [0; 64];
    for k in @as(usize, 0)..2 {
        for i in @as(usize, 0)..64 {
            a[i] = @truncate(u8, (i * 3) + k);
        }
        io.uint(@as(u64, fs[k](&mut a, k)));
        io.uint(@as(u64, a[5]));
    }
}
// expect: 360
// expect: 200
// expect: 376
// expect: 200
