// Without the atomics extension a compare-and-swap is a load, a compare
// and a store (WebAssembly): its operands are still computed first, in
// order, even when they are computed where it is and have effects.
// wasm-only
// flags: --features=-atomics
import "../lib/io.ax" as io;

let mut X: u32 = 1;
let mut Y: u32 = 0;
let mut B: u8 = 1;
let mut CALLS: u32 = 0;

fn f() u32 {
    CALLS += 1;
    X = 5;
    return 9;
}

export fn run() void {
    // the expected value is the one an exchange leaves behind: X is 5 when
    // the compare-and-swap runs, so it fails and returns 5
    io.int(@as(i64, @atomic_cas(&mut X, @atomic_xchg(&mut X, 5), 9)));
    io.int(@as(i64, X));
    // the new value counts in Y even when the swap does not happen
    io.int(@as(i64, @atomic_cas(&mut X, 0, @atomic_add(&mut Y, 1))));
    io.int(@as(i64, Y));
    // the new value changes X before the load
    X = 1;
    io.int(@as(i64, @atomic_cas(&mut X, 5, f())));
    io.int(@as(i64, X));
    io.int(@as(i64, CALLS));
    io.int(@as(i64, @atomic_cas(&mut B, @atomic_xchg(&mut B, 200), 9)));
    io.int(@as(i64, B));
}

// expect: 5
// expect: 5
// expect: 5
// expect: 1
// expect: 5
// expect: 9
// expect: 1
// expect: 200
// expect: 200
