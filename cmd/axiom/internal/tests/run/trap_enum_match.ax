// A match without 'else' on an enum holding a value that is not a member,
// which only writes through raw pointers can make, traps (spec §5.14).
// expect-trap
// expect: A
import "../lib/io.ax" as io;

enum E: u8 {
    A,
    B,
}

fn name(e: E) []u8 {
    match e {
        .A => { return "A"; }
        .B => { return "B"; }
    }
}

export fn run() void {
    let mut e = E.A;
    io.str(name(e));
    let p = @ptr_cast(*mut u8, &mut e);
    p.* = 7;
    io.str(name(e));
}
