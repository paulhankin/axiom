// x86-64: a load is not moved above a float or vector store that may write
// the same memory (hoist_reads_of took an SSE instruction whose first
// operand is a register to write only that register, but a store's first
// operand is the register it stores). Here a[s] is read after a[j] = x with
// s == j.
// native-only
import "../lib/io.ax" as io;

let mut F: fn(*mut f32, usize, usize, f32) u64 = store_load;
let mut BUF: [16]f32 = [0.0; 16];

fn store_load(a: *mut f32, i: usize, j: usize, x: f32) u64 {
    let s = i ^ 3;
    let t = (s << 3) ^ i;
    @ptr_add(a, j).* = x;
    let v = @ptr_add(a, s).*;
    return @as(u64, @int_from_float(u32, v)) + @as(u64, t);
}

export fn run() void {
    let f = F;
    let n: usize = 1;
    io.uint(f(&mut BUF[0], n, n ^ 3, 100.0));  // expect: 117
}
