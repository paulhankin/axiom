    bad += check_i8(i8_51, 51);
    bad += check_i8(i8_63, 63);
    bad += check_i8(i8_64, 64);
    bad += check_i8(i8_65, 65);
    bad += check_i8(i8_85, 85);
    bad += check_i8(i8_100, 100);
    bad += check_i8(i8_125, 125);
    bad += check_i8(i8_127, 127);
    bad += check_i8(i8_m1, 255);
    bad += check_i8(i8_m3, 253);
    bad += check_i8(i8_m5, 251);
    bad += check_i8(i8_m7, 249);
    bad += check_i8(i8_m9, 247);
    bad += check_i8(i8_m11, 245);
    bad += check_i8(i8_m13, 243);
    bad += check_i8(i8_m15, 241);
    bad += check_i8(i8_m17, 239);
    bad += check_i8(i8_m19, 237);
    bad += check_i8(i8_m25, 231);
    bad += check_i8(i8_m37, 219);
    bad += check_i8(i8_m63, 193);
    bad += check_i8(i8_m65, 191);
    bad += check_i8(i8_m100, 156);
    bad += check_i8(i8_m127, 129);
    bad += check_i8(i8_m128, 128);
    bad += check_i8(i8_m6, 250);
    bad += check_i8(i8_m2, 254);
    bad += check_i8(i8_23, 23);
    return bad;
}

struct R_u16 {
    q: u16,
    r: u16,
    z: bool,
    q4: u16,
    r4: u16,
}

fn check_u16(f: fn(u16, u16) R_u16, d0: u64) u64 {
    let d = @bit_cast(u16, @truncate(u16, opq(d0)));
    let o = @bit_cast(u16, @truncate(u16, opq(0)));
    let mut bad: u64 = 0;
    let mut s: u64 = 0x9E3779B97F4A7C15 ^ d0;
    let mut i: u64 = 0;
    while i < 65536 {
        let x = @bit_cast(u16, @truncate(u16, i));
        let c = f(x, o);
        if c.q != (x / d) {
            bad += 1;
        }
        if c.r != (x % d) {
            bad += 1;
        }
        if c.z != ((x % d) == 0) {
            bad += 1;
        }
        if c.q4 != (x / d) {
            bad += 1;
        }
        if c.r4 != (x % d) {
            bad += 1;
        }
        i += 1;
    }
    return bad;
}

fn u16_1(x: u16, o: u16) R_u16 {
    return R_u16.{
        q: x / 1,
        r: (x +% o) % 1,
        z: ((x -% o) % 1) == 0,
        q4: (x ^ o) / 1,
        r4: (x ^ o) % 1,
    };
}

