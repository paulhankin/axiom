struct R_i8 {
    q: i8,
    r: i8,
    z: bool,
    q4: i8,
    r4: i8,
}

fn check_i8(f: fn(i8, i8) R_i8, d0: u64) u64 {
    let d = @bit_cast(i8, @truncate(u8, opq(d0)));
    let o = @bit_cast(i8, @truncate(u8, opq(0)));
    let mut bad: u64 = 0;
    let mut s: u64 = 0x9E3779B97F4A7C15 ^ d0;
    let mut i: u64 = 0;
    while i < 256 {
        let x = @bit_cast(i8, @truncate(u8, i));
        let c = f(x, o);
        if c.q != (x / d) {
            bad += 1;
        }
        if c.r != (x % d) {
            bad += 1;
        }
        if c.z != ((x % d) == 0) {
            bad += 1;
        }
        if c.q4 != (x / d) {
            bad += 1;
        }
        if c.r4 != (x % d) {
            bad += 1;
        }
        i += 1;
    }
    return bad;
}

