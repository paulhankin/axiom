fn all_u32() u64 {
    let mut bad: u64 = 0;
    bad += check_u32(u32_1, 1);
    bad += check_u32(u32_2, 2);
    bad += check_u32(u32_3, 3);
    bad += check_u32(u32_5, 5);
    bad += check_u32(u32_6, 6);
    bad += check_u32(u32_7, 7);
    bad += check_u32(u32_9, 9);
    bad += check_u32(u32_10, 10);
    bad += check_u32(u32_11, 11);
    bad += check_u32(u32_12, 12);
    bad += check_u32(u32_14, 14);
    bad += check_u32(u32_25, 25);
    bad += check_u32(u32_28, 28);
    bad += check_u32(u32_100, 100);
    bad += check_u32(u32_125, 125);
    bad += check_u32(u32_255, 255);
    bad += check_u32(u32_256, 256);
    bad += check_u32(u32_641, 641);
    bad += check_u32(u32_1000, 1000);
    bad += check_u32(u32_65535, 65535);
    bad += check_u32(u32_65536, 65536);
    bad += check_u32(u32_65537, 65537);
    bad += check_u32(u32_1000000000, 1000000000);
    bad += check_u32(u32_1000000007, 1000000007);
    bad += check_u32(u32_3486784401, 3486784401);
    bad += check_u32(u32_2147483647, 2147483647);
    bad += check_u32(u32_2147483648, 2147483648);
    bad += check_u32(u32_2147483649, 2147483649);
    bad += check_u32(u32_4294967295, 4294967295);
    bad += check_u32(u32_8612, 8612);
    bad += check_u32(u32_145, 145);
    bad += check_u32(u32_368, 368);
    bad += check_u32(u32_698554382, 698554382);
    bad += check_u32(u32_41, 41);
    bad += check_u32(u32_8341912, 8341912);
    return bad;
}

struct R_i32 {
    q: i32,
    r: i32,
    z: bool,
    q4: i32,
    r4: i32,
    q5: i32,
    z5: bool,
    q6: i32,
    r6: i32,
}

// dividend i for the divisor d
fn gen_i32(i: u64, s: *mut u64, d: i32) i32 {
    let base: [12]i32 = [0, 1, 2, 3, -1, -2, -3, @max_value(i32), @max_value(i32) - 1, @min_value(i32),
                         @min_value(i32) + 1, @min_value(i32) + 2];
    if i < 12 {
        return base[@int_cast(usize, i)];
    }
    if i < 48 {
        let k = i - 12;
        let m: [6]i32 = [1, 2, 3, (@max_value(i32) / d) - 1, @max_value(i32) / d, (@max_value(i32) / d) +% 1];
        let off = @bit_cast(i32, @truncate(u32, @bit_cast(u64, @bit_cast(i64, k % 3) - 1)));
        let mut x = (m[@int_cast(usize, (k % 18) / 3)] *% d) +% off;
        if k >= 18 {
            x = 0 -% x;
        }
        return x;
    }
    let r = next(s);
    let mut x = r >> @truncate(u32, (r >> 57) & 63);
    if ((r >> 56) & 1) != 0 {
        x = 0 -% x;
    }
    return @bit_cast(i32, @truncate(u32, x));
}

fn check_i32(f: fn(i32, i32) R_i32, d0: u64) u64 {
    let d = @bit_cast(i32, @truncate(u32, opq(d0)));
    let o = @bit_cast(i32, @truncate(u32, opq(0)));
    let mut bad: u64 = 0;
    let mut s: u64 = 0x9E3779B97F4A7C15 ^ d0;
    let mut i: u64 = 0;
    while i < 548 {
        let x = gen_i32(i, &mut s, d);
        let c = f(x, o);
        if c.q != (x / d) {
            bad += 1;
        }
        if c.r != (x % d) {
            bad += 1;
        }
        if c.z != ((x % d) == 0) {
            bad += 1;
        }
        if c.q4 != (x / d) {
            bad += 1;
        }
        if c.r4 != (x % d) {
            bad += 1;
        }
        if c.q5 != ((x & 0xFFFFF) / d) {
            bad += 1;
        }
        if c.z5 != (((x & 0xFFFFF) % d) != 0) {
            bad += 1;
        }
        if c.q6 != (@bit_cast(i32, @as(u32, @truncate(u16, @bit_cast(u32, x)))) / d) {
            bad += 1;
        }
        if c.r6 != (@bit_cast(i32, @as(u32, @truncate(u16, @bit_cast(u32, x)))) % d) {
            bad += 1;
        }
        i += 1;
    }
    return bad;
}

fn i32_1(x: i32, o: i32) R_i32 {
    return R_i32.{
        q: x / 1,
        r: (x +% o) % 1,
        z: ((x -% o) % 1) == 0,
        q4: (x ^ o) / 1,
        r4: (x ^ o) % 1,
        q5: ((x | o) & 0xFFFFF) / 1,
        z5: (((x +% (o << 1)) & 0xFFFFF) % 1) != 0,
        q6: @bit_cast(i32, @as(u32, @truncate(u16, @bit_cast(u32, (x ^ (o << 1)))))) / 1,
        r6: @bit_cast(i32, @as(u32, @truncate(u16, @bit_cast(u32, (x ^ (o << 1)))))) % 1,
    };
}

