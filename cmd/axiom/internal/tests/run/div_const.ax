struct R_i16 {
    q: i16,
    r: i16,
    z: bool,
    q4: i16,
    r4: i16,
}

fn check_i16(f: fn(i16, i16) R_i16, d0: u64) u64 {
    let d = @bit_cast(i16, @truncate(u16, opq(d0)));
    let o = @bit_cast(i16, @truncate(u16, opq(0)));
    let mut bad: u64 = 0;
    let mut s: u64 = 0x9E3779B97F4A7C15 ^ d0;
    let mut i: u64 = 0;
    while i < 65536 {
        let x = @bit_cast(i16, @truncate(u16, i));
        let c = f(x, o);
        if c.q != (x / d) {
            bad += 1;
        }
        if c.r != (x % d) {
            bad += 1;
        }
        if c.z != ((x % d) == 0) {
            bad += 1;
        }
        if c.q4 != (x / d) {
            bad += 1;
        }
        if c.r4 != (x % d) {
            bad += 1;
        }
        i += 1;
    }
    return bad;
}

