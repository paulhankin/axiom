fn all_i32() u64 {
    let mut bad: u64 = 0;
    bad += check_i32(i32_1, 1);
    bad += check_i32(i32_2, 2);
    bad += check_i32(i32_3, 3);
    bad += check_i32(i32_5, 5);
    bad += check_i32(i32_6, 6);
    bad += check_i32(i32_7, 7);
    bad += check_i32(i32_9, 9);
    bad += check_i32(i32_10, 10);
    bad += check_i32(i32_11, 11);
    bad += check_i32(i32_12, 12);
    bad += check_i32(i32_14, 14);
    bad += check_i32(i32_25, 25);
    bad += check_i32(i32_28, 28);
    bad += check_i32(i32_100, 100);
    bad += check_i32(i32_125, 125);
    bad += check_i32(i32_255, 255);
    bad += check_i32(i32_256, 256);
    bad += check_i32(i32_641, 641);
    bad += check_i32(i32_1000, 1000);
    bad += check_i32(i32_65535, 65535);
    bad += check_i32(i32_65536, 65536);
    bad += check_i32(i32_65537, 65537);
    bad += check_i32(i32_1000000000, 1000000000);
    bad += check_i32(i32_1000000007, 1000000007);
    bad += check_i32(i32_2147483647, 2147483647);
    bad += check_i32(i32_m1, 4294967295);
    bad += check_i32(i32_m3, 4294967293);
    bad += check_i32(i32_m6, 4294967290);
    bad += check_i32(i32_m9, 4294967287);
    bad += check_i32(i32_m11, 4294967285);
    bad += check_i32(i32_m14, 4294967282);
    bad += check_i32(i32_m28, 4294967268);
    bad += check_i32(i32_m125, 4294967171);
    bad += check_i32(i32_m256, 4294967040);
    bad += check_i32(i32_m1000, 4294966296);
    bad += check_i32(i32_m65536, 4294901760);
    bad += check_i32(i32_m1000000000, 3294967296);
    bad += check_i32(i32_m2147483648, 2147483648);
    bad += check_i32(i32_m495323, 4294471973);
    bad += check_i32(i32_m350323863, 3944643433);
    bad += check_i32(i32_m5850885, 4289116411);
    bad += check_i32(i32_18821373, 18821373);
    bad += check_i32(i32_m17051, 4294950245);
    return bad;
}

struct R_u64 {
    q: u64,
    r: u64,
    z: bool,
    q4: u64,
    r4: u64,
    q5: u64,
    z5: bool,
    q6: u64,
    r6: u64,
}

// dividend i for the divisor d
fn gen_u64(i: u64, s: *mut u64, d: u64) u64 {
    let base: [12]u64 = [0, 1, 2, 3, 4, 5, @max_value(u64), @max_value(u64) - 1, @max_value(u64) - 2,
                         @max_value(u64) >> 1, (@max_value(u64) >> 1) + 1, (@max_value(u64) >> 1) + 2];
    if i < 12 {
        return base[@int_cast(usize, i)];
    }
    if i < 48 {
        let k = i - 12;
        let m: [6]u64 = [1, 2, 3, (@max_value(u64) / d) - 1, @max_value(u64) / d, (@max_value(u64) / d) +% 1];
        let off = @bit_cast(u64, @truncate(u64, @bit_cast(u64, @bit_cast(i64, k % 3) - 1)));
        let mut x = (m[@int_cast(usize, (k % 18) / 3)] *% d) +% off;
        if k >= 18 {
            x = 0 -% x;
        }
        return x;
    }
    let r = next(s);
    let mut x = r >> @truncate(u32, (r >> 57) & 63);
    if ((r >> 56) & 1) != 0 {
        x = 0 -% x;
    }
    return @bit_cast(u64, @truncate(u64, x));
}

fn check_u64(f: fn(u64, u64) R_u64, d0: u64) u64 {
    let d = @bit_cast(u64, @truncate(u64, opq(d0)));
    let o = @bit_cast(u64, @truncate(u64, opq(0)));
    let mut bad: u64 = 0;
    let mut s: u64 = 0x9E3779B97F4A7C15 ^ d0;
    let mut i: u64 = 0;
    while i < 548 {
        let x = gen_u64(i, &mut s, d);
        let c = f(x, o);
        if c.q != (x / d) {
            bad += 1;
        }
        if c.r != (x % d) {
            bad += 1;
        }
        if c.z != ((x % d) == 0) {
            bad += 1;
        }
        if c.q4 != (x / d) {
            bad += 1;
        }
        if c.r4 != (x % d) {
            bad += 1;
        }
        if c.q5 != ((x & 0xFFFFF) / d) {
            bad += 1;
        }
        if c.z5 != (((x & 0xFFFFF) % d) != 0) {
            bad += 1;
        }
        if c.q6 != ((x >> 5) / d) {
            bad += 1;
        }
        if c.r6 != ((x >> 5) % d) {
            bad += 1;
        }
        i += 1;
    }
    return bad;
}

fn u64_1(x: u64, o: u64) R_u64 {
    return R_u64.{
        q: x / 1,
        r: (x +% o) % 1,
        z: ((x -% o) % 1) == 0,
        q4: (x ^ o) / 1,
        r4: (x ^ o) % 1,
        q5: ((x | o) & 0xFFFFF) / 1,
        z5: (((x +% (o << 1)) & 0xFFFFF) % 1) != 0,
        q6: ((x ^ (o << 1)) >> 5) / 1,
        r6: ((x ^ (o << 1)) >> 5) % 1,
    };
}

