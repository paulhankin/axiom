struct R_u32 {
    q: u32,
    r: u32,
    z: bool,
    q4: u32,
    r4: u32,
    q5: u32,
    z5: bool,
    q6: u32,
    r6: u32,
}

// dividend i for the divisor d
fn gen_u32(i: u64, s: *mut u64, d: u32) u32 {
    let base: [12]u32 = [0, 1, 2, 3, 4, 5, @max_value(u32), @max_value(u32) - 1, @max_value(u32) - 2,
                         @max_value(u32) >> 1, (@max_value(u32) >> 1) + 1, (@max_value(u32) >> 1) + 2];
    if i < 12 {
        return base[@int_cast(usize, i)];
    }
    if i < 48 {
        let k = i - 12;
        let m: [6]u32 = [1, 2, 3, (@max_value(u32) / d) - 1, @max_value(u32) / d, (@max_value(u32) / d) +% 1];
        let off = @bit_cast(u32, @truncate(u32, @bit_cast(u64, @bit_cast(i64, k % 3) - 1)));
        let mut x = (m[@int_cast(usize, (k % 18) / 3)] *% d) +% off;
        if k >= 18 {
            x = 0 -% x;
        }
        return x;
    }
    let r = next(s);
    let mut x = r >> @truncate(u32, (r >> 57) & 63);
    if ((r >> 56) & 1) != 0 {
        x = 0 -% x;
    }
    return @bit_cast(u32, @truncate(u32, x));
}

fn check_u32(f: fn(u32, u32) R_u32, d0: u64) u64 {
    let d = @bit_cast(u32, @truncate(u32, opq(d0)));
    let o = @bit_cast(u32, @truncate(u32, opq(0)));
    let mut bad: u64 = 0;
    let mut s: u64 = 0x9E3779B97F4A7C15 ^ d0;
    let mut i: u64 = 0;
    while i < 548 {
        let x = gen_u32(i, &mut s, d);
        let c = f(x, o);
        if c.q != (x / d) {
            bad += 1;
        }
        if c.r != (x % d) {
            bad += 1;
        }
        if c.z != ((x % d) == 0) {
            bad += 1;
        }
        if c.q4 != (x / d) {
            bad += 1;
        }
        if c.r4 != (x % d) {
            bad += 1;
        }
        if c.q5 != ((x & 0xFFFFF) / d) {
            bad += 1;
        }
        if c.z5 != (((x & 0xFFFFF) % d) != 0) {
            bad += 1;
        }
        if c.q6 != ((x >> 5) / d) {
            bad += 1;
        }
        if c.r6 != ((x >> 5) % d) {
            bad += 1;
        }
        i += 1;
    }
    return bad;
}

fn u32_1(x: u32, o: u32) R_u32 {
    return R_u32.{
        q: x / 1,
        r: (x +% o) % 1,
        z: ((x -% o) % 1) == 0,
        q4: (x ^ o) / 1,
        r4: (x ^ o) % 1,
        q5: ((x | o) & 0xFFFFF) / 1,
        z5: (((x +% (o << 1)) & 0xFFFFF) % 1) != 0,
        q6: ((x ^ (o << 1)) >> 5) / 1,
        r6: ((x ^ (o << 1)) >> 5) % 1,
    };
}

