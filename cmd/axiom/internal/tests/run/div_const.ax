    bad += check_u64(u64_16774694446133, 16774694446133);
    bad += check_u64(u64_248971406338626, 248971406338626);
    bad += check_u64(u64_22089559803, 22089559803);
    bad += check_u64(u64_20, 20);
    return bad;
}

struct R_i64 {
    q: i64,
    r: i64,
    z: bool,
    q4: i64,
    r4: i64,
    q5: i64,
    z5: bool,
    q6: i64,
    r6: i64,
}

// dividend i for the divisor d
fn gen_i64(i: u64, s: *mut u64, d: i64) i64 {
    let base: [12]i64 = [0, 1, 2, 3, -1, -2, -3, @max_value(i64), @max_value(i64) - 1, @min_value(i64),
                         @min_value(i64) + 1, @min_value(i64) + 2];
    if i < 12 {
        return base[@int_cast(usize, i)];
    }
    if i < 48 {
        let k = i - 12;
        let m: [6]i64 = [1, 2, 3, (@max_value(i64) / d) - 1, @max_value(i64) / d, (@max_value(i64) / d) +% 1];
        let off = @bit_cast(i64, @truncate(u64, @bit_cast(u64, @bit_cast(i64, k % 3) - 1)));
        let mut x = (m[@int_cast(usize, (k % 18) / 3)] *% d) +% off;
        if k >= 18 {
            x = 0 -% x;
        }
        return x;
    }
    let r = next(s);
    let mut x = r >> @truncate(u32, (r >> 57) & 63);
    if ((r >> 56) & 1) != 0 {
        x = 0 -% x;
    }
    return @bit_cast(i64, @truncate(u64, x));
}

fn check_i64(f: fn(i64, i64) R_i64, d0: u64) u64 {
    let d = @bit_cast(i64, @truncate(u64, opq(d0)));
    let o = @bit_cast(i64, @truncate(u64, opq(0)));
    let mut bad: u64 = 0;
    let mut s: u64 = 0x9E3779B97F4A7C15 ^ d0;
    let mut i: u64 = 0;
    while i < 548 {
        let x = gen_i64(i, &mut s, d);
        let c = f(x, o);
        if c.q != (x / d) {
            bad += 1;
        }
        if c.r != (x % d) {
            bad += 1;
        }
        if c.z != ((x % d) == 0) {
            bad += 1;
        }
        if c.q4 != (x / d) {
            bad += 1;
        }
        if c.r4 != (x % d) {
            bad += 1;
        }
        if c.q5 != ((x & 0xFFFFF) / d) {
            bad += 1;
        }
        if c.z5 != (((x & 0xFFFFF) % d) != 0) {
            bad += 1;
        }
        if c.q6 != (@bit_cast(i64, @as(u64, @truncate(u16, @bit_cast(u64, x)))) / d) {
            bad += 1;
        }
        if c.r6 != (@bit_cast(i64, @as(u64, @truncate(u16, @bit_cast(u64, x)))) % d) {
            bad += 1;
        }
        i += 1;
    }
    return bad;
}

