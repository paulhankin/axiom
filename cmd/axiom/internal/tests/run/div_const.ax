        r4: (x ^ o) % 2,
        q5: ((x | o) & 0xFFFFF) / 2,
        z5: (((x +% (o << 1)) & 0xFFFFF) % 2) != 0,
        q6: ((x ^ (o << 1)) >> 5) / 2,
        r6: ((x ^ (o << 1)) >> 5) % 2,
    };
}

fn u64_3(x: u64, o: u64) R_u64 {
    return R_u64.{
        q: x / 3,
        r: (x +% o) % 3,
        z: ((x -% o) % 3) == 0,
        q4: (x ^ o) / 3,
        r4: (x ^ o) % 3,
        q5: ((x | o) & 0xFFFFF) / 3,
        z5: (((x +% (o << 1)) & 0xFFFFF) % 3) != 0,
        q6: ((x ^ (o << 1)) >> 5) / 3,
        r6: ((x ^ (o << 1)) >> 5) % 3,
