    bad += check_u64(u64_100, 100);
    bad += check_u64(u64_125, 125);
    bad += check_u64(u64_255, 255);
    bad += check_u64(u64_256, 256);
    bad += check_u64(u64_641, 641);
    bad += check_u64(u64_1000, 1000);
    bad += check_u64(u64_65535, 65535);
    bad += check_u64(u64_65536, 65536);
    bad += check_u64(u64_65537, 65537);
    bad += check_u64(u64_1000000000, 1000000000);
    bad += check_u64(u64_1000000007, 1000000007);
    bad += check_u64(u64_3486784401, 3486784401);
    bad += check_u64(u64_2147483647, 2147483647);
    bad += check_u64(u64_2147483648, 2147483648);
    bad += check_u64(u64_2147483649, 2147483649);
    bad += check_u64(u64_4294967295, 4294967295);
    bad += check_u64(u64_4294967297, 4294967297);
    bad += check_u64(u64_1000000000000000000, 1000000000000000000);
    bad += check_u64(u64_9223372036854775807, 9223372036854775807);
    bad += check_u64(u64_9223372036854775808, 9223372036854775808);
    bad += check_u64(u64_9223372036854775809, 9223372036854775809);
    bad += check_u64(u64_18446744073709551615, 18446744073709551615);
    bad += check_u64(u64_14757395258967641293, 14757395258967641293);
    bad += check_u64(u64_556995560, 556995560);
