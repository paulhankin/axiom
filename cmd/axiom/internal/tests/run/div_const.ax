        z5: (((x +% (o << 1)) & 0xFFFFF) % 22089559803) != 0,
        q6: ((x ^ (o << 1)) >> 5) / 22089559803,
        r6: ((x ^ (o << 1)) >> 5) % 22089559803,
    };
}

