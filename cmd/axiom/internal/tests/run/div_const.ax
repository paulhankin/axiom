fn all_i8() u64 {
    let mut bad: u64 = 0;
    bad += check_i8(i8_1, 1);
    bad += check_i8(i8_2, 2);
    bad += check_i8(i8_3, 3);
    bad += check_i8(i8_4, 4);
    bad += check_i8(i8_5, 5);
