    };
}

fn all_u64() u64 {
    let mut bad: u64 = 0;
    bad += check_u64(u64_1, 1);
    bad += check_u64(u64_2, 2);
    bad += check_u64(u64_3, 3);
    bad += check_u64(u64_5, 5);
    bad += check_u64(u64_6, 6);
    bad += check_u64(u64_7, 7);
    bad += check_u64(u64_9, 9);
    bad += check_u64(u64_10, 10);
