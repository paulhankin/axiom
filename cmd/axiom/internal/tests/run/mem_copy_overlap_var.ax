// @mem_copy of overlapping slices of lengths known only at run time (up to
// 32 bytes in two overlapping moves, beyond: forwards a string copy,
// backwards on x86-64 a loop of vectors), the destination below, above, on
// or apart from the source, against a byte at a time copy in the right
// direction; the mismatches (none), and a hash of the results.
import "../lib/io.ax" as io;

let mut buf: [1200]u8 = [0; 1200];
let mut want: [1200]u8 = [0; 1200];

fn fill() void {
    for i in 0..buf.len {
        let b = @truncate(u8, (i * 7) + (i >> 5));
        buf[i] = b;
        want[i] = b;
    }
}

// (recursive: not inlined, so n and the offsets are not constants)
fn copy(d: usize, s: usize, n: usize, depth: u32) void {
    if depth > 0 {
        copy(d, s, n, depth - 1);
        return;
    }
    @mem_copy(buf[d..d + n], buf[s..s + n]);
}

fn reference(d: usize, s: usize, n: usize) void {
    if d <= s {
        for k in 0..n {
            want[d + k] = want[s + k];
        }
    } else {
        let mut k = n;
        while k > 0 {
            k -= 1;
            want[d + k] = want[s + k];
        }
    }
}

export fn run() void {
    let mut bad: u64 = 0;
    let mut h: u64 = 0;
    let ns: [16]usize = [0, 1, 3, 16, 31, 32, 33, 47, 48, 49, 64, 100, 255, 257, 300, 1000];
    for n in ns {
        for dd in @as(usize, 0)..81 {
            // d - s from -40 to 40, and n apart
            let d = 120 + dd;
            let s: usize = 160;
            for k in @as(usize, 0)..2 {
                fill();
                let mut dk = d;
                if k == 1 {
                    dk = d + n + 1;
                    if dk + n > buf.len {
                        continue;
                    }
                }
                if (dk + n > buf.len) or (s + n > buf.len) {
                    continue;
                }
                copy(dk, s, n, 2);
                reference(dk, s, n);
                for i in 0..buf.len {
                    bad += @as(u64, buf[i] != want[i]);
                    h = (h *% 31) +% @as(u64, buf[i]);
                }
            }
        }
    }
    io.uint(bad);  // expect: 0
    io.uint(h);    // expect: 16691963396678289963
}
