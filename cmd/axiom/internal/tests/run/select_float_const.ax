// Two float selects in one block reading the same constant (-3.25, built
// outside the loop): the first selects it in its branch around a move,
// within the block, which the second does not take. The constant was built
// once for the block, before its first use, so on the other path the second
// select read a register that did not hold it.
// flags: -O2
// x86-64-flags: --cpu=x86-64-v3
import "std/fmt" as fmt;
fn sel_f64(c: bool, x: f64, y: f64) f64 {
    if c {
        return x;
    }
    return y;
}
fn cf64(x: f64) u64 {
    if x != x {
        return 0x7ff8000000000000;
    }
    return @bit_cast(u64, x);
}
fn tf7(a: u64, b: u64, inp_u64: []u64, out: []mut f64) void {
    let x_i8: i8 = @bit_cast(i8, @truncate(u8, a));
    let x_f64: f64 = @float_from_int(f64, @bit_cast(i64, a) >> 40);
    let b0: i8 = @bit_cast(i8, @truncate(u8, inp_u64[0]));
    out[0] = sel_f64(x_f64 > 1e30, sel_f64(0 == b0, -3.25, x_f64), sel_f64(x_i8 < -1, x_f64, -3.25));
}
let mut V: [36]u64 = [0x0, 0x1, 0x2, 0x3, 0x7, 0x8, 0x1f, 0x20, 0x21, 0x3f, 0x40, 0x41, 0x7f, 0x80, 0xff, 0x100, 0x7fff,
                      0x8000, 0xffff, 0x7fffffff, 0x80000000, 0xffffffff, 0x7fffffffffffffff, 0x8000000000000000,
                      0xffffffffffffffff, 0xfffffffffffffffe, 0x8080808080808080, 0x123456789abcdef0, 0x10000000000000,
                      0xfff0000000000000, 0x8030ae3f86b8246c, 0x3c24c089c8eb26bb, 0xdedc93d7c1117be1,
                      0xcfcbe3e35cefdd1e, 0x646470f144e23271, 0x1c0545ae45e75df0];
fn go() !void {
    let z: usize = 0;
    let nv: usize = 36;
    let mut i: usize = 0;
    while i < 8 {
        let a = V[(i * 7 + z) % nv];
        let b = V[(i * 13 + 3 + z) % nv];
        let mut inp: [80]u64 = [0; 80];
        for j in @as(usize, 0)..80 {
            inp[j] = V[(i * 3 + j * 5 + z) % nv] +% V[(j + i) % nv];
        }
        {
            let mut o: [2]i32 = [0; 2];
            for j in @as(usize, 0)..2 {
                fmt.print("0 {} {} {}\n", [fmt.int(i), fmt.int(j), fmt.int(o[j])])!;
            }
        }
        {
            let mut o: [8]f64 = [0.0; 8];
            tf7(a, b, inp[..], o[..]);
            for j in @as(usize, 0)..8 {
                fmt.print("7 {} {} {}\n", [fmt.int(i), fmt.int(j), fmt.int(cf64(o[j]))])!;
            }
        }
        i += 1;
    }
}
export fn run() void {
    go() catch {};
}
