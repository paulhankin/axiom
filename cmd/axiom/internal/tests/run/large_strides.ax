// Addresses scaled by large powers of two: a slice starting at block * 4096
// (the AArch64 backend once folded the multiplication into an add whose
// shift, kept in a byte, lost every scale above 128).
import "../lib/io.ax" as io;

const BS: u64 = 4096;

fn put(buf: []mut u8, blocks: []u64, data: []u8) void {
    for b in blocks {
        @mem_copy(buf[@truncate(usize, b * BS)..@truncate(usize, b * BS) + data.len], data);
    }
}

fn row(rows: []mut [256]u8, i: usize) *mut u8 {
    return &mut rows[i][0];
}

export fn run() void {
    let mut buf: [16384]u8 = [0; 16384];
    let blocks: [2]u64 = [1, 3];
    let data: [2]u8 = [7, 9];
    put(buf[..], blocks[..], data[..]);
    let mut first: i64 = -1;
    let mut count: i64 = 0;
    for i in 0..buf.len {
        if buf[i] != 0 {
            if first < 0 {
                first = @int_cast(i64, i);
            }
            count += 1;
        }
    }
    io.int(first);                 // expect: 4096
    io.int(count);                 // expect: 4
    io.int(@as(i64, buf[12289]));  // expect: 9
    let mut rows: [4][256]u8 = [[0; 256]; 4];
    row(rows[..], 2).* = 5;
    io.int(@as(i64, rows[2][0]));  // expect: 5
    io.int(@as(i64, rows[0][0]) + @as(i64, rows[1][0]));  // expect: 0
}
