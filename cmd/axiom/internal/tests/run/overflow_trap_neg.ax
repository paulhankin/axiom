// In the trap overflow mode, -MIN traps (T0002); the default wraps.
// flags: --overflow=trap
// expect-trap
import "../lib/io.ax" as io;

fn neg(a: i64) i64 {
    return -a;
}

export fn run() void {
    io.int(neg(5));    // expect: -5
    io.str("before");  // expect: before
    io.int(neg(@min_value(i64)));
}
