// A shuffle of a vector wider than the target's to one narrower than half
// of it, not a part of it (vsplit: split_inst): pieces of the result's
// width, at least one. With 256-bit vectors, a 128-bit result of a 512-bit
// operand was split into pieces of 256 bits, none of it. (The functions
// are compiled with AVX2, and called where the processor has it.)
// native-only
import "../lib/io.ax" as io;

fn pick(x: []i32) i32 @features("avx2") {
    let v = @load(i32x16, x[0..16]);
    let w = @shuffle(v, v, [0, 5, 10, 15]);
    let mut r: [4]i32 = [0; 4];
    @store(r[..], w);
    return (r[0] * 1000000) + (r[1] * 10000) + (r[2] * 100) + r[3];
}

// eight lanes of 16, from both operands
fn pick8(x: []i16) i64 @features("avx2") {
    let v = @load(i16x32, x[0..32]);
    let u = @load(i16x32, x[32..64]);
    let w = @shuffle(v, u, [1, 9, 20, 31, 32, 45, 50, 63]);
    let mut r: [8]i16 = [0; 8];
    @store(r[..], w);
    let mut s: i64 = 0;
    for e in r {
        s = (s * 100) + @as(i64, e);
    }
    return s;
}

// (the same, for processors without AVX2)
fn pick_plain(x: []i32) i32 {
    let v = @load(i32x16, x[0..16]);
    let w = @shuffle(v, v, [0, 5, 10, 15]);
    let mut r: [4]i32 = [0; 4];
    @store(r[..], w);
    return (r[0] * 1000000) + (r[1] * 10000) + (r[2] * 100) + r[3];
}

fn pick8_plain(x: []i16) i64 {
    let v = @load(i16x32, x[0..32]);
    let u = @load(i16x32, x[32..64]);
    let w = @shuffle(v, u, [1, 9, 20, 31, 32, 45, 50, 63]);
    let mut r: [8]i16 = [0; 8];
    @store(r[..], w);
    let mut s: i64 = 0;
    for e in r {
        s = (s * 100) + @as(i64, e);
    }
    return s;
}

export fn run() void {
    // (through pointers: the vectors are not constants in the callees)
    let mut fs = [pick, pick];
    let mut gs = [pick8, pick8];
    if not @cpu_has("avx2") {
        fs = [pick_plain, pick_plain];
        gs = [pick8_plain, pick8_plain];
    }
    let mut d: [64]i32 = [0; 64];
    let mut h: [64]i16 = [0; 64];
    for k in @as(usize, 0)..2 {
        for i in @as(usize, 0)..64 {
            d[i] = @int_cast(i32, i + k);
            h[i] = @int_cast(i16, i + k);
        }
        io.int(@as(i64, fs[k](d[..])));
        io.int(gs[k](h[..]));
    }
}
// expect: 51015
// expect: 109203132455063
// expect: 1061116
// expect: 210213233465164
