// Fills of a constant size above 256 bytes (issue 0069: a loop of vector
// stores four at a time, the whole vectors left, then one overlapping the
// end): each writes exactly its bytes.
import "../lib/io.ax" as io;

fn sum(b: *[2200]u8) u64 {
    let mut s: u64 = 0;
    for i in @as(usize, 0)..2200 {
        s += @as(u64, b[i]) * @as(u64, i + 1);
    }
    return s;
}

fn reset(b: *mut [2200]u8) void {
    for i in @as(usize, 0)..2200 {
        b[i] = 0xAA;
    }
}

export fn run() void {
    let mut b: [2200]u8 = [0; 2200];
    reset(&mut b);
    @mem_set(b[1..258], 0);
    io.uint(sum(&b));  // expect: 405907300
    reset(&mut b);
    @mem_set(b[3..859], 7);
    io.uint(sum(&b));  // expect: 351380668
    reset(&mut b);
    @mem_set(b[0..1024], 0);
    io.uint(sum(&b));  // expect: 322371000
    reset(&mut b);
    @mem_set(b[5..1001], 9);
    io.uint(sum(&b));  // expect: 330847754
    reset(&mut b);
    @mem_set(b[2..2050], 1);
    io.uint(sum(&b));  // expect: 56303032
}
