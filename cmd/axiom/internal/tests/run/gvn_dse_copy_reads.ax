// A copy reads its source before it writes its destination: a store that
// the source overlaps is not dead although the destination covers it (gvn
// dse_block). For a memmove that overlaps itself, and for an aggregate
// assignment through two pointers to the same object.
// flags: -O1
import "../lib/io.ax" as io;

fn sum(a: *[4]u32) u32 {
    return a[0] + a[1] * 10 + a[2] * 100 + a[3] * 1000;
}

let mut S: fn(*[4]u32) u32 = sum;

fn shift(x: u32) u32 {
    let mut a: [4]u32 = [1, 2, 3, 4];
    a[1] = x;
    @mem_copy(a[0..2], a[1..3]);
    return S(&a);
}

struct Big {
    a: [12]u64,
}

fn assign(p: *mut Big, q: *Big, x: u64) void {
    p.a[3] = x;
    p.* = q.*;
}

let mut F: fn(u32) u32 = shift;
let mut G: fn(*mut Big, *Big, u64) void = assign;

export fn run() void {
    io.uint(@as(u64, F(7)));
    let mut b = Big.{ a: [0; 12] };
    G(&mut b, &b, 7);
    io.uint(b.a[3]);
}
// expect: 4337
// expect: 7
