// A fact about a narrow value must not stand for one about a larger
// constant of the same low bits: with `b >= 128` known of a byte b, the
// optimizer asked whether b >= 384 and, making 384 a constant of b's type,
// got the known `b >= 128` back, so it proved n = b - 127 > 256 and folded
// the bound check of weights[..n] into a trap.
import "../lib/io.ax" as io;

fn total(w: []u8) usize {
    let mut t: usize = 0;
    for x in w {
        t += @as(usize, x);
    }
    return t + w.len;
}

fn read(src: []u8) usize {
    let hb = @as(usize, src[0]);
    let mut weights: [256]u8 = [0; 256];
    let mut n: usize = 0;
    if hb >= 128 {
        n = hb - 127;
        for k in @as(usize, 0)..n {
            weights[k] = src[1 + (k / 2)];
        }
        return total(weights[..n]);
    }
    return 1 + hb;
}

export fn run() void {
    let data: [5]u8 = [0x87, 1, 2, 3, 4];
    io.uint(@as(u64, read(data[..])));  // n = 8: 1+1+2+2+3+3+4+4, plus 8
    let small: [2]u8 = [0x7f, 9];
    io.uint(@as(u64, read(small[..])));
    let big: [66]u8 = [0xff; 66];
    io.uint(@as(u64, read(big[..])));  // n = 128 of 255s
}

// expect: 28
// expect: 128
// expect: 32768
