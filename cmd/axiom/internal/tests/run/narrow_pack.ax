    @store(r[..], @narrow(u16x16, @load(u32x8, a[..]), @load(u32x8, b[..])));
    let mut bad: u32 = 0;
    for i in @as(usize, 0)..16 {
        let mut x: i64 = 0;
        if i < 8 {
            x = @as(i64, a[i]);
        } else {
            x = @as(i64, b[i - 8]);
        }
        bad += @as(u32, @as(i64, r[i]) != sat(x, 0, 65535));
    }
    return bad;
}

fn c_u32x16_u16x32(off: usize) u32 {
    let mut a: [16]u32 = [0; 16];
    let mut b: [16]u32 = [0; 16];
    for i in @as(usize, 0)..16 {
        a[i] = @truncate(u32, @bit_cast(u64, EDGE[(i * 7 + off) % 24]));
        b[i] = @truncate(u32, @bit_cast(u64, EDGE[(i * 5 + off + 3) % 24]));
    }
    let mut r: [32]u16 = [0; 32];
    @store(r[..], @narrow(u16x32, @load(u32x16, a[..]), @load(u32x16, b[..])));
    let mut bad: u32 = 0;
    for i in @as(usize, 0)..32 {
        let mut x: i64 = 0;
        if i < 16 {
            x = @as(i64, a[i]);
        } else {
            x = @as(i64, b[i - 16]);
        }
        bad += @as(u32, @as(i64, r[i]) != sat(x, 0, 65535));
    }
    return bad;
}

export fn run() void {
    let mut bad: u32 = 0;
    for off in @as(usize, 0)..24 {
        bad += c_i16x8_i8x16(off);
        bad += c_i16x16_i8x32(off);
        bad += c_i16x32_i8x64(off);
        bad += c_i16x8_u8x16(off);
        bad += c_i16x16_u8x32(off);
        bad += c_i16x32_u8x64(off);
        bad += c_u16x8_i8x16(off);
        bad += c_u16x16_i8x32(off);
        bad += c_u16x32_i8x64(off);
        bad += c_u16x8_u8x16(off);
        bad += c_u16x16_u8x32(off);
        bad += c_u16x32_u8x64(off);
        bad += c_i32x4_i16x8(off);
        bad += c_i32x8_i16x16(off);
        bad += c_i32x16_i16x32(off);
        bad += c_i32x4_u16x8(off);
        bad += c_i32x8_u16x16(off);
        bad += c_i32x16_u16x32(off);
        bad += c_u32x4_i16x8(off);
        bad += c_u32x8_i16x16(off);
        bad += c_u32x16_i16x32(off);
        bad += c_u32x4_u16x8(off);
        bad += c_u32x8_u16x16(off);
        bad += c_u32x16_u16x32(off);
    }
    io.uint(@as(u64, bad));  // expect: 0
}
