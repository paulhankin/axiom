// @narrow of every lane type pair (16- and 32-bit lanes, signed and unsigned, to signed
// and unsigned lanes of half the width: x86-64's packs, with a clamp first for unsigned
// lanes and the 64-bit pieces put in order at 256 and 512 bits) at 128, 256 and 512 bits,
// on edge values and their neighbours, against the scalar saturation.
// flags: -O2
import "../lib/io.ax" as io;

// edge values of 32-bit lanes (read in each lane type by truncation)
let EDGE: [24]i64 = [0, 1, -1, 2, -2, 126, 127, 128, 129, -127, -128, -129, 254, 255, 256, 257, 32766, 32767, 32768,
                     32769, -32767, -32768, -32769, 65535];

fn sat(x: i64, lo: i64, hi: i64) i64 {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

fn c_i16x8_i8x16(off: usize) u32 {
    let mut a: [8]i16 = [0; 8];
    let mut b: [8]i16 = [0; 8];
    for i in @as(usize, 0)..8 {
        a[i] = @truncate(i16, @bit_cast(u64, EDGE[(i * 7 + off) % 24]));
        b[i] = @truncate(i16, @bit_cast(u64, EDGE[(i * 5 + off + 3) % 24]));
    }
    let mut r: [16]i8 = [0; 16];
    @store(r[..], @narrow(i8x16, @load(i16x8, a[..]), @load(i16x8, b[..])));
    let mut bad: u32 = 0;
    for i in @as(usize, 0)..16 {
        let mut x: i64 = 0;
        if i < 8 {
            x = @as(i64, a[i]);
        } else {
            x = @as(i64, b[i - 8]);
        }
        bad += @as(u32, @as(i64, r[i]) != sat(x, -128, 127));
    }
    return bad;
}

