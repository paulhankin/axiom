// Phase 3.1: transitive immutability on *T and []T fields, pointer equality, and stdlib splits.
import "../../../../../std/collections/vec.ax" as vec;
import "../../../../../std/math/matrix.ax" as mat;
import "../lib/io.ax" as io;

struct Holder {
    buf: []mut u8,
    ptr: *mut i64,
    opt: ?*mut i64,

    pub fn view(self: *Self) []u8 {
        return self.buf;
    }

    pub fn ptr_ro(self: *Self) *i64 {
        return self.ptr;
    }

    pub fn opt_ro(self: *Self) ?*i64 {
        return self.opt;
    }

    pub fn mut_buf(self: *mut Self) []mut u8 {
        return self.buf;
    }
}

fn check_eq(a: *mut i64, h: *Holder) bool {
    return a == h.ptr_ro() and (h.ptr_ro() != @ptr_from_int(*mut i64, 0));
}

export fn run() void {
    let mut raw: [3]u8 = [10, 20, 30];
    let mut num: i64 = 77;
    // Direct non-mut value binding keeps interior mutability for owned handles.
    let h_val = Holder.{ buf: raw[..], ptr: &mut num, opt: &mut num };
    h_val.buf[0] = 11;
    h_val.ptr.* = 88;

    let r: *Holder = &h_val;
    io.int(@as(i64, r.view()[0]));  // expect: 11
    io.int(r.ptr_ro().*);           // expect: 88
    if let .some(op) = r.opt_ro() {
        io.int(op.*);  // expect: 88
    }
    io.boolean(check_eq(&mut num, r));  // expect: true

    // []Holder weakens field projection to []u8.
    let hs = [h_val];
    let s: []Holder = hs[..];
    io.int(@as(i64, s[0].buf[1]));  // expect: 20

    // Vec.items (*Self -> []T) vs Vec.items_mut (*mut Self -> []mut T).
    let mut v = vec.Vec.[i64].init();
    defer v.deinit();
    v.push(4) catch @trap();
    v.push(5) catch @trap();
    v.items_mut()[0] = 40;
    let vp: *vec.Vec.[i64] = &v;
    io.int(vp.items()[0] + vp.items()[1]);  // expect: 45

    // Matrix.row (*Self -> []T) vs Matrix.row_mut (*mut Self -> []mut T).
    let mut m = mat.Matrix.[f64].init(2, 2) catch @trap();
    defer m.deinit();
    m.row_mut(1)[0] = 9.0;
    let mp: *mat.Matrix.[f64] = &m;
    io.int(@int_from_float(i64, mp.row(1)[0]));  // expect: 9
}
