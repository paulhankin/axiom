// Range loops over counters narrower than a pointer (i32, u32, i16), whose
// steps cannot overflow: -O2 counts them in a register as wide as a pointer.
// The results must be the same near the ends of the types, from negative
// starts, and where the loop runs no times; the bounds checks stay.
import "../lib/io.ax" as io;

let mut XS: [64]i32 = [0; 64];
let mut ARGS: [8]i32 = [0; 8];

fn near_max(lo: i32, hi: i32) i64 {
    let mut s: i64 = 0;
    for i in lo..hi {
        s += @as(i64, XS[@int_cast(usize, i -% lo) & 63]) * @as(i64, i & 7);
    }
    return s;
}

fn from_negative(n: i32) i64 {
    let mut s: i64 = 0;
    for i in @as(i32, -8)..n {
        s += @as(i64, XS[@int_cast(usize, i + 8)]) * @as(i64, i);
    }
    return s;
}

fn u32_top(lo: u32) u64 {
    let mut s: u64 = 0;
    for i in lo..@as(u32, 4294967295) {
        s +%= @as(u64, @bit_cast(u32, XS[@as(usize, i - lo)])) +% @as(u64, i);
    }
    return s;
}

fn offsets(n: i32, k: i32) i64 {
    let mut s: i64 = 0;
    for i in @as(i32, 0)..n {
        s += @as(i64, XS[@int_cast(usize, i + k)]) - @as(i64, XS[@int_cast(usize, (2 * i) + 1)]);
    }
    return s;
}

fn short_counter(n: i16) i64 {
    let mut s: i64 = 0;
    for i in @as(i16, -20)..n {
        s += @as(i64, XS[@int_cast(usize, i + 20) & 63]) + @as(i64, i);
    }
    return s;
}

// t[i + j], i invariant in the inner loop, over u32 counters
fn mul(t: []mut u32, a: []u32, b: []u32) u32 {
    for i in @as(u32, 0)..@int_cast(u32, a.len) {
        let mut carry: u64 = 0;
        for j in @as(u32, 0)..@int_cast(u32, b.len) {
            let p = (@as(u64, a[@as(usize, i)]) * @as(u64, b[@as(usize, j)])) + @as(
                u64, t[@as(usize, i) + @as(usize, j)]) + carry;
            t[@as(usize, i) + @as(usize, j)] = @truncate(u32, p);
            carry = p >> 32;
        }
        t[@as(usize, i) + b.len] = @truncate(u32, carry);
    }
    let mut h: u32 = 0;
    for x in t {
        h = (h *% 31) +% x;
    }
    return h;
}

export fn run() void {
    for i in @as(usize, 0)..64 {
        XS[i] = (@int_cast(i32, i) * 37 % 101) - 50;
    }
    ARGS = [2147483647, 20, 30, 0, 10, 5, 2, 40];
    io.int(0);  // expect: 0
    // (the arguments read after a call: not constants the optimizer folds)
    let max = ARGS[0];
    io.int(near_max(max - ARGS[1], max));  // expect: -276
    io.int(near_max(-2147483647 - 1, (-2147483647 - 1) + ARGS[2]));  // expect: -398
    io.int(near_max(max, max));          // expect: 0
    io.int(from_negative(ARGS[2]));      // expect: 1168
    io.int(from_negative(ARGS[3] - 8));  // expect: 0
    io.uint(u32_top(@as(u32, 4294967295) - @int_cast(u32, ARGS[1])));  // expect: 128849018620
    io.int(offsets(ARGS[1], ARGS[4]));               // expect: 34
    io.int(short_counter(@int_cast(i16, ARGS[2])));  // expect: 226
    let mut t: [12]u32 = [0; 12];
    let a: [4]u32 = [0xffff_ffff, 2, 0x8000_0000, 7];
    let b: [6]u32 = [0xffff_ffff, 0xffff_fffe, 3, 0, 0x1234_5678, 9];
    io.uint(@as(u64, mul(t[..], a[0..@int_cast(usize, ARGS[6]) + 2], b[0..@int_cast(usize, ARGS[5]) + 1])));  // expect: 3242653802
}
