// A vector shifted by a count loaded from memory: with AVX2 the load,
// read only by the splat of the count, is a broadcast from memory, and the
// count has no register of its own. The shift takes it from the splat.
// flags: -O1
// x86-64-flags: --cpu=x86-64-v3
import "../lib/io.ax" as io;

let NAMES: [3][]u8 = ["abc", "abcde", "abcdefgh"];

// (mutable: the calls are not inlined, and the arguments not constants in
// the callees)
let mut SHL: fn(u16x8) u16x8 = shl;
let mut SHR: fn(u16x8) u16x8 = shr;
let mut SAR: fn(i16x16) i16x16 = sar;

fn shl(v: u16x8) u16x8 {
    return v << @truncate(u32, NAMES[0].len);
}

fn shr(v: u16x8) u16x8 {
    return v >> @truncate(u32, NAMES[1].len);
}

fn sar(v: i16x16) i16x16 {
    return v >> @truncate(u32, NAMES[2].len);
}

export fn run() void {
    io.uint(@as(u64, @extract_lane(SHL(@splat(1)), 0)));
    io.uint(@as(u64, @extract_lane(SHR(@splat(1000)), 7)));
    io.int(@as(i64, @extract_lane(SAR(@splat(-1000)), 15)));
}

// expect: 8
// expect: 31
// expect: -4
