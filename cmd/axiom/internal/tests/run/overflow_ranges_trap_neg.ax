// A negation of a value known only to be below another can be of the
// minimum: it keeps its check (lowering/overflow_ranges_kept.ax) and traps.
// expect-trap
// expect: 0
import "../lib/io.ax" as io;

let mut ARGS: [2]i32 = [0; 2];

fn neg_lt(x: i32, lo: i32) i32 {
    if x < lo {
        return -x;
    }
    return 0;
}

export fn run() void {
    ARGS = [@min_value(i32), 0];
    io.int(0);
    io.int(@as(i64, neg_lt(ARGS[0], ARGS[1])));
}
