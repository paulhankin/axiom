// Regression test: `if let` whose scrutinee contains `catch |e| return e`
// emitting aggregate SSA definitions after match blocks in IR insertion order.
import "../lib/io.ax" as io;

error LookupErr {
    AccessDenied,
    Absent,
}

struct Pair {
    a: u64,
    b: u64,
    c: u64,
}

fn lookup_slice(mode: i32) LookupErr!?[]u8 {
    if mode == 0 {
        return error.AccessDenied;
    }
    if mode == 1 {
        return .none;
    }
    return .some("ok-val");
}

fn get_or_absent(mode: i32) LookupErr![]u8 {
    if let .some(v) = (lookup_slice(mode) catch |e| return e) {
        return v;
    }
    return error.Absent;
}

fn lookup_pair(mode: i32) LookupErr!?Pair {
    if mode == 0 {
        return error.AccessDenied;
    }
    if mode == 1 {
        return .none;
    }
    return .some(Pair.{ a: 10, b: 20, c: 30 });
}

fn pair_sum(mode: i32) LookupErr!u64 {
    if let .some(p) = (lookup_pair(mode) catch |e| return e) {
        return p.a + p.b + p.c;
    }
    return error.Absent;
}

fn err_label(e: LookupErr) []u8 {
    if e == error.Absent {
        return "absent";
    }
    if e == error.AccessDenied {
        return "denied";
    }
    return "other";
}

export fn run() void {
    let s2 = get_or_absent(2) catch "err";
    io.str(s2);  // expect: ok-val

    let s1 = get_or_absent(1) catch |e| err_label(e);
    io.str(s1);  // expect: absent

    let s0 = get_or_absent(0) catch |e| err_label(e);
    io.str(s0);  // expect: denied

    io.uint(pair_sum(2) catch 0);  // expect: 60
    io.uint(pair_sum(1) catch 1);  // expect: 1
    io.uint(pair_sum(0) catch 2);  // expect: 2
}
