// A small function with several calls to itself is not inlined into its
// callers: each copy would bring those calls along, to be inlined in turn,
// and the caller would grow level after level.
import "../lib/io.ax" as io;

struct T {
    kind: i32,
    flag: bool,
    elem: usize,
    ret: usize,
}

fn marked(ts: []T, x: usize) bool {
    let t = ts[x];
    if t.kind == 1 {
        return t.flag or marked(ts, t.elem);
    }
    if t.kind == 2 {
        return marked(ts, t.elem);
    }
    if t.kind == 3 {
        return marked(ts, t.ret);
    }
    return false;
}

fn count(ts: []T) i32 {
    let mut n: i32 = 0;
    for k in 0..ts.len {
        if marked(ts, k) {
            n += 1;
        }
    }
    return n;
}

export fn run() void {
    let ts: [5]T = [
        T.{ kind: 0, flag: false, elem: 0, ret: 0 },
        T.{ kind: 1, flag: true, elem: 0, ret: 0 },
        T.{ kind: 2, flag: false, elem: 1, ret: 0 },
        T.{ kind: 3, flag: false, elem: 0, ret: 2 },
        T.{ kind: 2, flag: false, elem: 0, ret: 0 },
    ];
    io.int(@as(i64, count(ts[0..5])));  // expect: 3
}
