// A shift of a phi of a constant and a variable by a constant moves into
// the phi's inputs, but not when the count is the width or more: the
// constant's shift does not fold (the compiler crashed).
// flags: -O2
import "../lib/io.ax" as io;

let KS: [2]u32 = [40, 3];

fn f(c: bool, y: u32) u32 {
    let mut v: u32 = 5;
    if c {
        v = y;
    }
    return v << KS[0];
}

export fn run() void {
    // (through a pointer: c and y are not constants in the callee)
    let fs = [f, f];
    let k: usize = @int_cast(usize, KS[1] & 1);
    io.uint(@as(u64, fs[k](k == 1, 7)));
    io.uint(@as(u64, fs[k](k == 0, 7)));
}
// expect: 0
// expect: 0
