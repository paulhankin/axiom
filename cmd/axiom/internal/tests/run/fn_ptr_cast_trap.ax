// A call through a function pointer of another type than the function's
// (other parameter types) traps (T0009) also once the pointer's value is
// known, here through a global: it stays a call_indirect.
// flags: -O1
// wasm-only
// expect-trap
// expect: 3
import "../lib/io.ax" as io;

fn add2(x: i32, y: i32) i32 {
    return x + y;
}

let mut TABLE: [2]usize = [0, 0];

export fn run() void {
    io.int(@as(i64, add2(1, 2)));
    TABLE[0] = @bit_cast(usize, @as(fn(i32, i32) i32, add2));
    let g = @bit_cast(fn(i64, i64) i32, TABLE[0]);
    io.int(@as(i64, g(41, 1)));
}
