// Booleans kept as branches (issue 0067): bool locals merged by phis and
// branched on, a phi of constants that an earlier branch decides, a
// comparison tested again in a later block, and @any_true / @all_true of
// vectors as branch conditions.
import "../lib/io.ax" as io;

let mut BOARD: [32]u8 = [0; 32];
let mut LOG: [8]u32 = [0; 8];
let mut V: [16]i32 = [0; 16];

fn note(i: usize) bool {
    LOG[i & 7] += 1;
    return (i & 1) == 0;
}

// The shape of a move generator: `legal` and `off` set in both arms,
// branched on after; `hit` only where `not off`.
fn steps(occ: u32, r: usize, nb: usize) u32 {
    let mut used = false;
    let mut n: u32 = 0;
    let cbo = (occ & 0xFFFFC0) == 0;
    let mut mask = occ;
    while mask != 0 {
        let i = @as(usize, 31 - @clz(mask));
        mask ^= @as(u32, 1) << @truncate(u32, i);
        let mut legal = false;
        let mut off = false;
        let mut dest: usize = 0;
        if i >= r {
            dest = i - r;
            legal = BOARD[dest] < 2;
        } else {
            off = true;
            legal = cbo and ((i == nb) or (i + 1 == r));
        }
        if legal {
            let mut hit = false;
            if not off {
                hit = BOARD[dest] == 1;
                BOARD[dest] += 1;
            }
            if note(i) {
                n += 100;
            }
            if not off {
                BOARD[dest] -= 1;
                if hit {
                    n += 10;
                }
            } else {
                n += 1000;
            }
            n += 1;
            used = true;
        }
    }
    if not used {
        n += 5;
    }
    return n;
}

fn any4(k: usize) i32 {
    let v = @load(i32x4, V[k..k + 4]);
    if @any_true(v) {
        return 1;
    }
    return 0;
}

fn all4(k: usize) i32 {
    let v = @load(i32x4, V[k..k + 4]);
    if @all_true(v) {
        return 1;
    }
    return 0;
}

fn any8(k: usize) i32 {
    let v = @load(i32x8, V[k..k + 8]);
    let mut r: i32 = 20;
    if @any_true(v) {
        r = 10;
    }
    return r;
}

fn all8(k: usize) bool {
    let v = @load(i32x8, V[k..k + 8]);
    return @all_true(v);
}

fn any16() i32 {
    let v = @load(i32x16, V[0..16]);
    if @any_true(v) {
        return 1;
    }
    return 0;
}

fn all16() i32 {
    let v = @load(i32x16, V[0..16]);
    if @all_true(v) and (V[0] != 7) {
        return 1;
    }
    return 0;
}

export fn run() void {
    BOARD[3] = 1;
    BOARD[5] = 2;
    io.uint(@as(u64, steps(0x3A, 2, 5)));       // expect: 1114
    io.uint(@as(u64, steps(0x1000038, 2, 5)));  // expect: 214
    io.uint(@as(u64, steps(0, 2, 5)));          // expect: 5
    io.uint(@as(u64, steps(0x6, 3, 2)));        // expect: 1101
    io.uint(@as(u64, LOG[1] * 10 + LOG[2]));    // expect: 11
    io.int(@as(i64, any4(0) + all4(0)));        // expect: 0
    V[2] = 3;
    io.int(@as(i64, any4(0) + all4(0)));  // expect: 1
    io.int(@as(i64, any8(4)));            // expect: 20
    io.boolean(all8(0));                  // expect: false
    for i in @as(usize, 0)..16 {
        V[i] = @as(i32, @bit_cast(i32, @truncate(u32, i))) + 1;
    }
    io.int(@as(i64, any4(4) + all4(4)));  // expect: 2
    io.boolean(all8(8));                  // expect: true
    io.int(@as(i64, any16() + all16()));  // expect: 2
    V[15] = 0;
    io.int(@as(i64, any16() + all16()));  // expect: 1
    V[15] = -1;
    V[0] = 7;
    io.int(@as(i64, all16()));  // expect: 0
}
