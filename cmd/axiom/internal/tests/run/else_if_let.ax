// Regression test: `if ... else if let ...` must check and generate the
// `else if let` (S_MATCH) branch and any trailing `else` branch.
import "../lib/io.ax" as io;

fn single_ret(flag: bool, opt: ?i32) i32 {
    if flag {
        return 100;
    } else if let .some(v) = opt {
        return v;
    } else {
        return 200;
    }
}

fn chained_fallthrough(flag: bool, o1: ?i32, o2: ?[]u8) []u8 {
    let mut out: []u8 = "init";
    if flag {
        out = "flag";
    } else if let .some(n) = o1 {
        if n > 0 {
            out = "pos";
        } else {
            out = "nonpos";
        }
    } else if let .some(s) = o2 {
        out = s;
    } else {
        out = "none";
    }
    return out;
}

fn mixed_if_let_then_else_if_let(o1: ?i32, flag: bool, o2: ?i32) i32 {
    let mut r: i32 = -1;
    if let .some(a) = o1 {
        r = a + 1;
    } else if flag {
        r = 50;
    } else if let .some(b) = o2 {
        r = b + 2;
    } else {
        r = 99;
    }
    return r;
}

fn target_cond_else_if_let(opt: ?i32) i32 {
    if @target_arch("x86_64") and @target_arch("aarch64") {
        return 0;
    } else if let .some(v) = opt {
        return v + 10;
    } else {
        return -5;
    }
}

export fn run() void {
    io.int(@as(i64, single_ret(true, .some(42))));   // expect: 100
    io.int(@as(i64, single_ret(false, .some(42))));  // expect: 42
    io.int(@as(i64, single_ret(false, .none)));      // expect: 200

    io.str(chained_fallthrough(true, .some(1), .some("s")));   // expect: flag
    io.str(chained_fallthrough(false, .some(5), .some("s")));  // expect: pos
    io.str(chained_fallthrough(false, .some(0), .some("s")));  // expect: nonpos
    io.str(chained_fallthrough(false, .none, .some("ok")));    // expect: ok
    io.str(chained_fallthrough(false, .none, .none));          // expect: none

    io.int(@as(i64, mixed_if_let_then_else_if_let(.some(10), true, .some(20))));  // expect: 11
    io.int(@as(i64, mixed_if_let_then_else_if_let(.none, true, .some(20))));      // expect: 50
    io.int(@as(i64, mixed_if_let_then_else_if_let(.none, false, .some(20))));     // expect: 22
    io.int(@as(i64, mixed_if_let_then_else_if_let(.none, false, .none)));         // expect: 99

    io.int(@as(i64, target_cond_else_if_let(.some(7))));  // expect: 17
    io.int(@as(i64, target_cond_else_if_let(.none)));     // expect: -5
}
