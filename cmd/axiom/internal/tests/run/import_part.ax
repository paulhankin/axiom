// Multi-file module test (spec §4.1, §16.7).
import "../lib/io.ax" as io;
import "../lib/multipart/mod.ax" as mp;

fn describe_part_err(r: { PartAErr }!i32) []u8 {
    let v = r catch |e| {
        match e {
            error.PartAErr => { return @error_name(e); }
        }
    };
    _ = v;
    return "ok";
}

export fn run() void {
    io.boolean(mp.check_even(6));
    // expect: true
    io.boolean(mp.check_even(7));
    // expect: false
    io.boolean(mp.check_odd(7));
    // expect: true
    io.boolean(mp.check_odd(-4));
    // expect: false

    io.int(@as(i64, mp.run_secret_flow(7, "boost")));
    // expect: 81
    io.int(@as(i64, mp.run_secret_flow(7, "plain")));
    // expect: 78

    io.int(@as(i64, mp.check_part_imports("axiom-part", "axiom")));
    // expect: 51
    io.int(@as(i64, mp.check_part_imports("other", "axiom")));
    // expect: 50

    io.int(@as(i64, mp.call_part_a_err(10)));
    // expect: 15
    io.int(@as(i64, mp.call_part_a_err(-1)));
    // expect: -100

    let ok = mp.part_a_fallible(4) catch 0;
    io.int(@as(i64, ok));
    // expect: 9

    io.str(describe_part_err(mp.part_a_fallible(-5)));
    // expect: PartAErr
}
