export fn run() void {
    for i in @as(u32, 0)..256 {
        let b = @truncate(u8, i);
        mix(u8low(b));
        mix(u8all(b));
        mix(i8all(@bit_cast(i8, b)));
        mix(i8mid(@bit_cast(i8, b)));
    }
    io.uint(H);
    for i in @as(u32, 0)..65536 {
        mix(u16high(@truncate(u16, i)));
    }
    io.uint(H);
}
