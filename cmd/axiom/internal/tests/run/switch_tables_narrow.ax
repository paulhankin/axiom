// Matches of narrow values that give constants, as lookup tables at -O2
// (switches.ax: lookup_tables): cases read as unsigned values span fewer
// than read as signed (u8 0..254, whose signed span is 256), every value
// of the type (an `else` never taken, and no range check: x - lo <u 256 would wrap to 0), and signed
// cases across zero; each value of the type is tried.
import "../lib/io.ax" as io;

let mut H: u64 = 1469598103934665603;

fn mix(x: i64) void {
    H = (H ^ @bit_cast(u64, x)) *% 1099511628211;
}

