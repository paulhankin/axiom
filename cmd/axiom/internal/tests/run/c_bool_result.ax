// A bool returned by C code has only its low byte defined (the C calling
// conventions), where the compiler keeps a bool as 0 or 1 in the whole
// register: the caller extends it. Each call here follows one that leaves
// other bits set in the result register.
// link: c_bool_result.c
import "../lib/io.ax" as io;

extern "C" {
    fn c_lt5(x: i32) bool;
    fn c_is_odd(x: u64) bool;
    fn c_times256(x: i64) i64;
}

fn pick(k: i64, x: i32) u64 {
    let j = c_times256(k);
    let b = c_lt5(x);
    let mut r: u64 = @bit_cast(u64, j);
    if b {
        r += 1000;
    }
    return r;
}

fn count(k: i64, n: u64) u64 {
    let mut c: u64 = 0;
    for i in @as(u64, 0)..n {
        let j = c_times256(k);
        let odd = c_is_odd(i);
        let small = c_lt5(@truncate(i32, i));
        if odd and not small {
            c += 1;
        }
        if odd == small {
            c += 100;
        }
        c +%= @bit_cast(u64, j) & 0;
    }
    return c;
}

let mut pp: fn(i64, i32) u64 = pick;
let mut pc: fn(i64, u64) u64 = count;

export fn run() void {
    io.uint(pp(1, 3));
    io.uint(pp(1, 9));
    io.uint(pc(3, 10));
}

// expect: 1512
// expect: 512
// expect: 403
