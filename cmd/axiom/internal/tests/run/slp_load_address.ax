// The stores combined into a vector store are in descending address order,
// each lane's load just before its store: the vector load of the lanes goes
// before the first store, where the address of lane 0's load (computed just
// before that load) is not defined yet. (x86-64 folds the address into the
// load either way; the suite's AXIOM_CHECK_IR sees the order.)
// flags: -O2
import "../lib/io.ax" as io;

fn mv(a: *mut [16]i32) void {
    a[3] = a[11] + 1;
    a[2] = a[10] + 1;
    a[1] = a[9] + 1;
    a[0] = a[8] + 1;
}

export fn run() void {
    // (through a pointer: a is not known in the callee)
    let fs = [mv, mv];
    let mut a: [16]i32 = [0; 16];
    for i in @as(usize, 0)..16 {
        a[i] = @int_cast(i32, i * 7);
    }
    fs[@int_cast(usize, a[1] & 1)](&mut a);
    for i in @as(usize, 0)..4 {
        io.int(@as(i64, a[i]));
    }
}
// expect: 57
// expect: 64
// expect: 71
// expect: 78
