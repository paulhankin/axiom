// Checked arithmetic (@add_checked, @sub_checked, @mul_checked) on every
// integer width, signed and unsigned, at the edges of the ranges: each
// operation of every pair of edge values, tested where it is made (the branch
// on the overflow, which native code takes from the flags of the operation),
// giving the number of overflows and a hash of the results. The values come
// from memory, so that nothing is folded; the same at every optimization level.
// (Generated with the expectations from the exact results.)
import "../lib/io.ax" as io;

let mut V_U8: [12]u8 = [0, 1, 2, 3, 255, 254, 127, 128, 85, 86, 15, 16];
let mut V_I8: [25]i8 = [0, 1, 2, 3, 127, 126, 63, 64, 42, 43, 11, 12, 16, 15, -1, -2, -128, -127, -64, -65, -11, -12,
                        -16, -43, -44];
let mut V_U16: [12]u16 = [0, 1, 2, 3, 65535, 65534, 32767, 32768, 21845, 21846, 255, 256];
let mut V_I16: [25]i16 = [0, 1, 2, 3, 32767, 32766, 16383, 16384, 10922, 10923, 181, 182, 256, 255, -1, -2, -32768,
                          -32767, -16384, -16385, -181, -182, -256, -10923, -10924];
let mut V_U32: [12]u32 = [0, 1, 2, 3, 4294967295, 4294967294, 2147483647, 2147483648, 1431655765, 1431655766, 65535,
