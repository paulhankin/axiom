                          9223372036854775808, 6148914691236517205, 6148914691236517206, 4294967295, 4294967296];
let mut V_I64: [25]i64 = [0, 1, 2, 3, 9223372036854775807, 9223372036854775806, 4611686018427387903,
                          4611686018427387904, 3074457345618258602, 3074457345618258603, 3037000499, 3037000500,
                          4294967296, 4294967295, -1, -2, -9223372036854775808, -9223372036854775807,
                          -4611686018427387904, -4611686018427387905, -3037000499, -3037000500, -4294967296,
                          -3074457345618258603, -3074457345618258604];

fn add_u8() void {
    let mut h: u64 = 0;
    let mut n: u64 = 0;
    for i in 0..V_U8.len {
        for j in 0..V_U8.len {
            let r = @add_checked(V_U8[i], V_U8[j]) catch {
                n += 1;
                h = h *% 31 +% 7;
                continue;
            };
            h = h *% 31 +% @as(u64, r);
        }
    }
    io.uint(n);
    io.uint(h);
}

fn sub_u8() void {
    let mut h: u64 = 0;
    let mut n: u64 = 0;
    for i in 0..V_U8.len {
        for j in 0..V_U8.len {
