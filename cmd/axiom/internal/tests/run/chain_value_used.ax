// A chain of tests of one value folded into its first test leaves the
// later tests' blocks unreachable: their values (the x -% 10 of a range
// test) must not be used beyond the chain.
// flags: -O1
import "../lib/io.ax" as io;

fn either(p: *u32) u32 {
    if p.* == 1 or p.* == 5 or (p.* -% 10) < 3 {
        return 7;
    }
    let y = p.* -% 10;
    return y *% y +% 3;
}

fn both(p: *u32) u32 {
    if (p.* -% 10) < 20 and (p.* -% 12) < 30 {
        let y = p.* -% 12;
        return y *% y +% 3;
    }
    return 7;
}

export fn run() void {
    // (through pointers: the arguments are not constants in the callees)
    let fs = [either, both];
    for k in @as(usize, 0)..2 {
        let mut s: u32 = 0;
        for i in @as(u32, 0)..40 {
            let v = i;
            s = s *% 31 +% fs[k](&v);
        }
        io.uint(@as(u64, s));
    }
}
// expect: 1951825177
// expect: 1331940185
