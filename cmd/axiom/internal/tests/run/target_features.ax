// Processor extensions (spec §13.4): target conditions, @cpu_has,
// @features and @multiversion. The output is the same on every target and
// processor: only which version runs differs.
import "../lib/io.ax" as io;

// Each version computes the same sum; the extensions only change the code.
fn sum(xs: []u32) u32 @multiversion("avx512f,avx512bw", "avx2", "sse4.1", "dotprod", "sve") {
    let mut s: u32 = 0;
    for x in xs {
        s +%= x;
    }
    return s;
}

// Which extensions the version that runs was compiled with: a target
// condition is a constant in each version.
fn level() u32 @multiversion("avx2", "dotprod") {
    if @target_has("avx2") or @target_has("dotprod") {
        return 1;
    }
    return 0;
}

fn with_sse41(a: i32x4, b: i32x4) i32x4 @features("sse4.1") {
    return @min(a, b);
}

fn seven() u32 @features("aes") {
    return 7;
}

// The other architecture's builtins are allowed in a branch the target
// rules out.
fn cpu_vendor_leaf() u32 {
    if @target_arch("x86_64") {
        return @extract_lane(@x86_cpuid(0, 0), 0);
    }
    return 1;
}

export fn run() void {
    let xs: [5]u32 = [1, 2, 3, 4, 5];
    io.uint(@as(u64, sum(xs[..])));  // expect: 15
    // exactly one architecture and one system
    let mut archs: u32 = 0;
    if @target_arch("x86_64") {
        archs += 1;
    }
    if @target_arch("aarch64") {
        archs += 1;
    }
    if @target_arch("wasm32") or @target_arch("wasm64") {
        archs += 1;
    }
    io.uint(@as(u64, archs));  // expect: 1
    let os_named = @target_os("linux") or @target_os("macos") or @target_os("windows") or @target_os("none");
    io.boolean(os_named);  // expect: true
    io.boolean(@target_os("none") == (@target_arch("wasm32") or @target_arch("wasm64")));  // expect: true
    // what the build may use, the processor has
    let mut consistent = true;
    if @target_has("sse4.1") and not @cpu_has("sse4.1") {
        consistent = false;
    }
    if @target_has("simd128") and not @cpu_has("simd128") {
        consistent = false;
    }
    io.boolean(consistent);             // expect: true
    io.boolean(cpu_vendor_leaf() > 0);  // expect: true
    // a version with the extension, if the processor has it
    let lv = level();
    io.boolean((lv == 1) or not (@cpu_has("avx2") or @cpu_has("dotprod")));  // expect: true
    let mut m: i32x4 = @vec(i32x4, 1, 9, -3, 4);
    if @cpu_has("sse4.1") {
        m = with_sse41(m, @splat(2));
    } else {
        m = @min(m, @splat(2));
    }
    io.int(@as(i64, @reduce_add(m)));  // expect: 2
    let mut s: u32 = 7;
    if @cpu_has("aes") {
        s = seven();
    }
    io.uint(@as(u64, s));  // expect: 7
    // not a target condition: an ordinary if
    let mut n: u32 = 0;
    if @cpu_has("avx2") or (n == 0) {
        n = 1;
    }
    io.uint(@as(u64, n));  // expect: 1
}
