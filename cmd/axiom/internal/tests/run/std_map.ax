// std/collections/map
import "../lib/io.ax" as io;
import "std/collections/map" as map;
import "std/hash" as hash;

fn opt_kind[T](r: ?T) []u8 {
    match r {
        .some(x) => {
            _ = x;
            return "ok";
        }
        , .none => { return "none"; }
        ,
    }
}

export fn run() void {
    let mut m = map.Map.[u64, u64, hash.hash_u64, hash.eq_u64].init();
    defer m.deinit();
    for i in @as(u64, 0)..10000 {
        m.put(i, i * i) catch return;
    }
    io.uint(@as(u64, m.len()));     // expect: 10000
    io.uint(m.get(77) ?? 0);        // expect: 5929
    io.boolean(m.contains(9999));   // expect: true
    io.boolean(m.contains(10000));  // expect: false
    for i in @as(u64, 0)..10000 {
        if (i % 2) == 0 {
            _ = m.remove(i);
        }
    }
    io.uint(@as(u64, m.len()));  // expect: 5000
    io.boolean(m.contains(78));  // expect: false
    m.put(3, 1) catch return;
    io.uint(m.get(3) ?? 0);  // expect: 1
    let p = m.get_ptr(5) ?? return;
    p.* += 1;
    io.uint(m.get(5) ?? 0);  // expect: 26
    let mut it = m.iter();
    let mut k: u64 = 0;
    let mut v: u64 = 0;
    let mut n: u64 = 0;
    let mut ksum: u64 = 0;
    while it.next(&mut k, &mut v) {
        n += 1;
        ksum += k;
    }
    io.uint(n);                  // expect: 5000
    io.uint(ksum);               // expect: 25000000
    io.str(opt_kind(m.get(4)));  // expect: none

    // string keys
    let mut words = map.Map.[[]u8, u32, hash.hash_bytes, hash.eq_bytes].init();
    defer words.deinit();
    let text: [7][]u8 = ["the", "cat", "sat", "on", "the", "mat", "the"];
    for w in text {
        let c = words.get(w) ?? 0;
        words.put(w, c + 1) catch return;
    }
    io.uint(@as(u64, words.get("the") ?? 0));  // expect: 3
    io.uint(@as(u64, words.len()));            // expect: 5
    m.clear();
    io.uint(@as(u64, m.len()));  // expect: 0

    // dynamic comparator / hash
    let mut dm = map.MapDyn.[u64, u64].init(hash.hash_u64, hash.eq_u64);
    defer dm.deinit();
    dm.put(10, 100) catch return;
    io.uint(dm.get(10) ?? 0);  // expect: 100
}
