// Sums whose overflow checks the bootstrap compiler leaves out at -O1 and
// above: their results must be the same as with the checks.
// flags: --overflow=trap
import "../lib/io.ax" as io;

fn sum_25(side: *[25]u8) u32 {
    let mut total: u32 = 0;
    for c in side.* {
        total += @as(u32, c);
    }
    return total;
}

fn count_big(xs: *[100]u16) u8 {
    let mut n: u8 = 0;
    for x in xs.* {
        if x > 1000 {
            n += 1;
        }
    }
    return n;
}

fn two_adds(xs: *[64]u8) u16 {
    let mut s: u16 = 7;
    for i in @as(usize, 0)..64 {
        s += @as(u16, xs[i]);
        if (i % 2) == 0 {
            s += 3;
        }
    }
    return s;
}

export fn run() void {
    let side: [25]u8 = [255; 25];
    io.uint(@as(u64, sum_25(&side)));  // expect: 6375
    let mut xs: [100]u16 = [0; 100];
    for i in @as(usize, 0)..100 {
        xs[i] = @truncate(u16, i * 37);
    }
    io.uint(@as(u64, count_big(&xs)));  // expect: 72
    let bs: [64]u8 = [200; 64];
    io.uint(@as(u64, two_adds(&bs)));  // expect: 12903
}
