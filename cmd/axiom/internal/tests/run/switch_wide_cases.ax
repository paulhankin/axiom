// A switch's cases stay constants: a case the target builds in a register
// (wider than an x86-64 immediate, or than an AArch64 compare's) is not
// replaced by a copy made once, by opt.hoist_constants in a loop or by
// opt.share_constants for a constant used again further on. Instruction
// selection compares with the cases as constants, and read a copy as 0.
import "../lib/io.ax" as io;

// (mutable: the calls are not inlined, and the arguments not constants in
// the callees)
let mut WIDE: fn(u64) u64 = wide;
let mut MEDIUM: fn(u64) u64 = medium;
let mut SHARED: fn(u64, u64) u64 = shared;

// In a loop: x64's cases need a 64-bit register, a64's a 32-bit one.
fn wide(n: u64) u64 {
    let mut s: u64 = 0;
    let mut x: u64 = 0;
    for i in @as(u64, 0)..n {
        match x {
            4294967296  => { s = s * 10 + 1; }
            8589934592  => { s = s * 10 + 2; }
            12884901888 => { s = s * 10 + 3; }
            else        => { s = s * 10 + 9; }
        }
        x = x + 4294967296;
    }
    return s;
}

fn medium(n: u64) u64 {
    let mut s: u64 = 0;
    let mut x: u64 = 0;
    for i in @as(u64, 0)..n {
        match x {
            70000  => { s = s * 10 + 1; }
            140000 => { s = s * 10 + 2; }
            else   => { s = s * 10 + 9; }
        }
        x = x + 70000;
    }
    return s;
}

// Not in a loop: the first case is used again in a block it dominates.
fn shared(x: u64, z: u64) u64 {
    let y = z ^ 4294967296;
    match x {
        4294967296 => { return y; }
        8589934592 => { return 2; }
        else       => { return 9; }
    }
}

export fn run() void {
    io.uint(WIDE(6));
    io.uint(MEDIUM(5));
    io.uint(SHARED(4294967296, 1) - 4294967296);
    io.uint(SHARED(0, 1));
    io.uint(SHARED(8589934592, 1));
}
// expect: 912399
// expect: 91299
// expect: 1
// expect: 9
// expect: 2
