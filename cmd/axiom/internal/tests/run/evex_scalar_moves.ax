// With AVX-512, a 128-bit value can live in xmm16-31, which only EVEX
// encodings name. The scalar moves (movss, movsd) had no EVEX form, so
// @int_from_float of an f32x16 to i8x16 and to u16x16 in one function stopped
// the compiler ("xmm16-31 in a VEX instruction"); found by exact_simd_float.ax.
// Run where the processor has AVX-512, compared with the lanes computed one
// at a time.
import "../lib/io.ax" as io;

let mut R: [16]f32 = [1.0, -1.0, 0.0, 300.0, 0.5, 1.5, 2.5, 1.0e30, -1.0e30, 7.0, 8.0, -200.0, 1.0, 2.0, 3.0, 4.0];

fn two() u64 @features("avx512f,avx512bw,avx512vl,avx512dq") {
    let a = @load(f32x16, R[0..]);
    let x = @int_from_float(i8x16, a);
    let y = @int_from_float(u16x16, a);
    return @extract_lane(@bit_cast(u64x2, x), 0) ^ @extract_lane(@bit_cast(u64x4, y), 1);
}

fn two_scalar() u64 {
    let mut h: u64 = 0;
    for i in @as(usize, 0)..8 {
        let x = @bit_cast(u8, @int_from_float(i8, R[i]));
        h = h | (@as(u64, x) << @truncate(u32, 8 * i));
    }
    for i in @as(usize, 0)..4 {
        h = h ^ (@as(u64, @int_from_float(u16, R[i + 4])) << @truncate(u32, 16 * i));
    }
    return h;
}

export fn run() void {
    let mut h = two_scalar();
    if @cpu_has("avx512f") and @cpu_has("avx512bw") and @cpu_has("avx512vl") and @cpu_has("avx512dq") {
        h = two();
    }
    io.uint(h);  // expect: 9294586316194971393
}
