// Non-escaping pointer and slice patterns (spec §12.2): addresses of globals,
// pointers/slices derived from parameters, and storing a local address into a
// local slot via a pointer-to-local are all valid.
import "../lib/io.ax" as io;

struct Pair {
    a: u64,
    b: [4]u64,
}

struct Wrap {
    p: *u64,
}

let mut g: Pair = Pair.{ a: 1, b: [2, 3, 4, 5] };

fn global_field() *mut u64 {
    return &mut g.b[2];
}

fn through_pointer(p: *mut Pair) *mut u64 {
    return &mut p.b[0];
}

fn through_slice(s: []u64) []u64 {
    return s[1..];
}

fn of_slice(s: []u64) *u64 {
    return &s[0];
}

fn self_ptr(p: *Pair) []u64 {
    return p.b[..];
}

fn global_branch(cond: bool) *u64 {
    let mut p: *u64 = &g.a;
    if cond {
        p = &g.b[0];
    }
    return p;
}

fn global_wrap() *u64 {
    let w = Wrap.{ p: &g.b[3] };
    return w.p;
}

fn global_opt(some: bool) ?*u64 {
    if not some {
        return .none;
    }
    let p: ?*u64 = .some(&g.a);
    return p;
}

fn sum_slice(s: []u64) u64 {
    let mut total: u64 = 0;
    for v in s {
        total += v;
    }
    return total;
}

fn pass_local_slice() u64 {
    let xs: [3]u64 = [4, 5, 6];
    return sum_slice(xs[..]);
}

fn write_local_slot() u64 {
    let x: u64 = 42;
    let mut local_ptr_slot: *u64 = &g.a;
    let slot_ptr = &mut local_ptr_slot;
    slot_ptr.* = &x;
    return local_ptr_slot.*;
}

fn write_local_slice_slot() u64 {
    let buf: [3]u64 = [10, 20, 30];
    let mut local_slice_slot: []u64 = g.b[..];
    let slot_ptr = &mut local_slice_slot;
    slot_ptr.* = buf[1..];
    return local_slice_slot[0] + local_slice_slot[1];
}

export fn run() void {
    io.uint(global_field().*);                      // expect: 4
    io.uint(through_pointer(&mut g).*);             // expect: 2
    io.uint(@as(u64, through_slice(g.b[..]).len));  // expect: 3
    io.uint(of_slice(g.b[..]).*);                   // expect: 2
    io.uint(@as(u64, self_ptr(&g).len));            // expect: 4
    io.uint(global_branch(true).*);                 // expect: 2
    io.uint(global_wrap().*);                       // expect: 5
    io.uint((global_opt(true) ?? &g.b[0]).*);       // expect: 1
    io.uint(pass_local_slice());                    // expect: 15
    io.uint(write_local_slot());                    // expect: 42
    io.uint(write_local_slice_slot());              // expect: 50
}
