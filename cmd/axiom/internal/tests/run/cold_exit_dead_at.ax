// x86-64: a register is not taken to be dead at a block that ends in a trap
// when that block reads it first. With n == 0 the loop exits at once to code
// that prints s and traps; dup_exit_tests moved `s = 0` past the copied exit
// test, onto the loop's way only. (The unused fourth argument is in that
// register, rcx, on entry.)
// native-only
// expect-trap
import "../lib/io.ax" as io;

let mut SHOW: fn(u64) void = show;
let mut F: fn(*u64, u64, u64, u64) u64 = sum_then_trap;
let mut BUF: [16]u64 = [0; 16];

fn show(x: u64) void {
    io.uint(x);
}

fn sum_then_trap(p: *u64, b: u64, n: u64, unused: u64) u64 {
    let mut s: u64 = 0;
    let mut i: usize = 0;
    let k = b * 16;
    while @as(u64, i) < n {
        let v = @ptr_add(p, i).*;
        if v == 0 {
            return s;
        }
        s +%= v * k;
        i += 1;
    }
    SHOW(s +% 1000);
    @trap();
}

export fn run() void {
    let f = F;
    BUF[0] = 3;
    io.uint(f(&BUF[0], 5, 0, 77));  // expect: 1000
}
