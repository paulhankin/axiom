// x86-64: the compare that starts the shrink-wrapped block, where the
// prologue goes, is kept even when every jump into it leaves the same flags:
// the prologue's `sub rsp` changes them (reuse_flags_across dropped the
// `test n, n` of `n < 0` after the entry block's `test n, n; je`).
// native-only
import "../lib/io.ax" as io;

let mut F: fn(i64) i64 = pick;
let mut H: fn(*mut [4]i64, i64) i64 = first_plus;

fn first_plus(a: *mut [4]i64, n: i64) i64 {
    return a[0] + n;
}

fn pick(n: i64) i64 {
    if n == 0 {
        return 7;
    }
    if n < 0 {
        let mut a: [4]i64 = [1, 2, 3, 4];
        return H(&mut a, 100);
    }
    let mut b: [4]i64 = [1, 5, 6, 7];
    return H(&mut b, 200);
}

export fn run() void {
    let f = F;
    io.int(f(0));   // expect: 7
    io.int(f(1));   // expect: 201
    io.int(f(-2));  // expect: 101
}
