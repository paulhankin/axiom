// --release is accepted and changes nothing: overflow wraps, as in every
// build (it used to select saturation).
// flags: --release
import "../lib/io.ax" as io;

export fn run() void {
    let x: u8 = 250;
    io.int(@as(i64, x + 10));  // expect: 4
    let m: i32 = @min_value(i32);
    io.int(@as(i64, m / -1));  // expect: -2147483648
}
