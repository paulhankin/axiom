// &expr of a temporary (a call's result, an arithmetic result, a literal)
// materializes it in a hidden local of the function, so builder results
// can be passed by pointer and *Self methods called on them.
import "../lib/io.ax" as io;

struct Config {
    threads: u32,
    name: []u8,
    pad: [40]u8,

    fn init() Config {
        return Config.{ threads: 1, name: "cfg", pad: [0; 40] };
    }

    fn with_threads(self: Config, n: u32) Config {
        let mut c = self;
        c.threads = n;
        return c;
    }

    fn total(self: *Config) u32 {
        return self.threads + @as(u32, self.pad[39]);
    }
}

fn describe(c: *Config) void {
    io.int(@as(i64, c.threads));
    io.str(c.name);
}

fn square(p: *i64) i64 {
    return p.* * p.*;
}

fn keep(p: *[3]u8) *[3]u8 {
    return p;
}

export fn run() void {
    describe(&Config.init().with_threads(2));
    io.int(square(&(3 + 4)));
    io.int(@as(i64, Config.init().with_threads(7).total()));
    // the hidden local lives to the end of the function
    let p = keep(&[1, 2, 3]);
    let q = &Config.init().with_threads(9);
    io.int(@as(i64, p[0] + p[1] + p[2]));
    io.int(@as(i64, q.threads));
}
// expect: 2
// expect: cfg
// expect: 49
// expect: 7
// expect: 6
// expect: 9
