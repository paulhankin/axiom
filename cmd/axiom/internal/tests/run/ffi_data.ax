// Objects shared with C (spec §14.5.6): those C defines, declared in an
// extern "C" block, read and written from Axiom; and those Axiom exports,
// which C reads and writes through the header's declarations.
// link: ffi_data.c
// header: ffi_data_generated.h
import "../lib/io.ax" as io;

pub struct Pair {
    a: i32,
    b: f64,
}

extern "C" {
    let mut c_count: i32;
    let c_limits: [3]i64;
    let mut c_pair: Pair;
    fn c_touch() i32;
}

export let mut ax_total: i64 = 5;
export let ax_scale: f64 = 2.5;
export let mut ax_pair: Pair = Pair.{ a: 7, b: 0.5 };

export fn run() void {
    io.int(@as(i64, c_count));  // expect: 41
    c_count += 1;
    io.int(c_limits[0] + c_limits[2]);  // expect: 303
    c_pair.a = 9;
    io.int(@as(i64, c_touch()));  // expect: 42
    io.int(ax_total);             // expect: 47
    io.float(c_pair.b);           // expect: 6.25
    io.int(@as(i64, ax_pair.a));  // expect: 10
    io.float(ax_pair.b);          // expect: 2.5
}
