// A load at a join whose value one incoming path knows is moved onto the
// other path's edge only if nothing before it in the join may stop the
// program: gvn does not load there above a call that traps on a bad index
// (constant data, which the call cannot write).
// expect-trap
// flags: -O2
import "../lib/io.ax" as io;

let TABLE: [4]i64 = [10, 20, 30, 40];

fn check(k: usize) void {
    if k >= 4 {
        io.str("bad index");
        @trap();
    }
}

fn odd(k: usize) usize {
    return k & 1;
}

fn global(k: usize, c: bool) i64 {
    let p = @ptr_add(&TABLE[0], k);
    let mut s: i64 = 0;
    if c {
        s = p.* * 3;
        check(odd(k));
    }
    check(k);
    s += p.*;
    return s;
}

let mut G: fn(usize, bool) i64 = global;

export fn run() void {
    io.int(G(2, true));
    io.int(G(0x1fff_fff0, false));
}
// expect: 120
// expect: bad index
