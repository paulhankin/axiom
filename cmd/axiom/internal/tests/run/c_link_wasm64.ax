// C code links into a wasm64 module (with wasm-ld, which is told the
// memory is 64-bit).
// wasm-only
// selfhost-only: the bootstrap compiler links no wasm64 module
// link: c_link_wasm64.c
// flags: --target=wasm64
import "../lib/io.ax" as io;

extern "C" {
    fn c_sum(p: *u32, n: usize) u64;
}

export fn run() void {
    let xs: [4]u32 = [1, 20, 300, 4000];
    io.uint(c_sum(&xs[0], 4));
}

// expect: 4321
