// The extra arguments of a C variadic call go in a buffer in the caller's
// frame (WebAssembly); an argument that is itself a variadic call, computed
// where it is used, does not overwrite the arguments stored before it.
// link: c_variadic_nested.c
// flags: --stack-traces=off
import "../lib/io.ax" as io;

extern "C" {
    fn c_digits(n: i32, ...) i32;
}

export fn run() void {
    io.int(@as(i64, c_digits(2, @as(i32, 5), c_digits(1, @as(i32, 7)))));
    io.int(@as(i64, c_digits(3, @as(i32, 1), @as(i32, 2), c_digits(2, @as(i32, 3), @as(i32, 4)))));
}

// expect: 507
// expect: 10504
