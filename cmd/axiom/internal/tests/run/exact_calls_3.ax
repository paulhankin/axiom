fn hs_t1(h: u64, v: E1) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
        .M2 => { return mix(h, 2); }
    }
}

fn mk_t1(x: u64) E1 {
    match x % 3 {
        0    => { return E1.M0; }
        1    => { return E1.M1; }
        else => { return E1.M2; }
    }
}

fn st_t1(v: E1) E1 {
    match v {
        .M0 => { return E1.M1; }
        .M1 => { return E1.M2; }
        .M2 => { return E1.M0; }
    }
}

fn hs_t2(h: u64, v: E2) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
        .M2 => { return mix(h, 2); }
        .M3 => { return mix(h, 3); }
    }
}

fn mk_t2(x: u64) E2 {
    match x % 4 {
        0    => { return E2.M0; }
        1    => { return E2.M1; }
        2    => { return E2.M2; }
        else => { return E2.M3; }
    }
}

fn st_t2(v: E2) E2 {
    match v {
        .M0 => { return E2.M1; }
        .M1 => { return E2.M2; }
        .M2 => { return E2.M3; }
        .M3 => { return E2.M0; }
    }
}

fn hs_t3(h: u64, v: E3) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
        .M2 => { return mix(h, 2); }
    }
}

fn mk_t3(x: u64) E3 {
    match x % 3 {
        0    => { return E3.M0; }
        1    => { return E3.M1; }
        else => { return E3.M2; }
    }
}

fn st_t3(v: E3) E3 {
    match v {
        .M0 => { return E3.M1; }
        .M1 => { return E3.M2; }
        .M2 => { return E3.M0; }
    }
}

fn hs_t4(h: u64, v: E4) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
    }
}

fn mk_t4(x: u64) E4 {
    match x % 2 {
        0    => { return E4.M0; }
        else => { return E4.M1; }
    }
}

fn st_t4(v: E4) E4 {
    match v {
        .M0 => { return E4.M1; }
        .M1 => { return E4.M0; }
    }
}

fn hs_t5(h: u64, v: U5) u64 {
    match v {
        .V0(p) => { return hs_f32(mix(h, 0), p); }
        .V1    => { return mix(h, 1); }
    }
}

fn mk_t5(x: u64) U5 {
    match x % 2 {
        0    => { return U5.V0(mk_f32(mix(x, 99))); }
        else => { return U5.V1; }
    }
}

fn st_t5(v: U5) U5 {
    match v {
        .V0(p) => { return U5.V0(st_f32(p)); }
        .V1    => { return U5.V1; }
    }
}

fn hs_t6(h0: u64, v: S6) u64 {
    let mut h = h0;
    h = hs_u16(h, v.f0);
    h = hs_t4(h, v.f1);
    h = hs_u32(h, v.f2);
    h = hs_bool(h, v.f3);
    h = hs_f32(h, v.f4);
    return h;
}

fn mk_t6(x: u64) S6 {
    return S6.{ f0: mk_u16(mix(x, 1)), f1: mk_t4(mix(x, 2)), f2: mk_u32(mix(x, 3)), f3: mk_bool(mix(x, 4)),
                f4: mk_f32(mix(x, 5)) };
}

fn st_t6(v: S6) S6 {
    return S6.{ f0: st_u16(v.f0), f1: st_t4(v.f1), f2: st_u32(v.f2), f3: st_bool(v.f3), f4: st_f32(v.f4) };
}

fn hs_t7(h: u64, v: ?E3) u64 {
    if let .some(p) = v {
        return hs_t3(mix(h, 1), p);
    }
    return mix(h, 0);
}

fn mk_t7(x: u64) ?E3 {
    if (x & 3) == 0 {
        return .none;
    }
    return mk_t3(mix(x, 5));
}

fn st_t7(v: ?E3) ?E3 {
    match v {
        .some(p) => { return .some(st_t3(p)); }
        .none    => { return .none; }
    }
}

fn hs_t8(h0: u64, v: S8) u64 {
    let mut h = h0;
    h = hs_t7(h, v.f0);
    h = hs_u32(h, v.f1);
    return h;
}

fn mk_t8(x: u64) S8 {
    return S8.{ f0: mk_t7(mix(x, 1)), f1: mk_u32(mix(x, 2)) };
}

fn st_t8(v: S8) S8 {
    return S8.{ f0: st_t7(v.f0), f1: st_u32(v.f1) };
}

fn hs_t9(h0: u64, v: [3]i32) u64 {
    let mut h = h0;
    for x in v {
        h = hs_i32(h, x);
    }
    return h;
}

fn mk_t9(x: u64) [3]i32 {
    return [mk_i32(mix(x, 1)), mk_i32(mix(x, 2)), mk_i32(mix(x, 3))];
}

fn st_t9(v: [3]i32) [3]i32 {
    let mut r = v;
    for i in 0..r.len {
        r[i] = st_i32(r[i]);
    }
    return r;
}

fn hs_t10(h0: u64, v: [3]S6) u64 {
    let mut h = h0;
    for x in v {
        h = hs_t6(h, x);
    }
    return h;
}

fn mk_t10(x: u64) [3]S6 {
    return [mk_t6(mix(x, 1)), mk_t6(mix(x, 2)), mk_t6(mix(x, 3))];
}

fn st_t10(v: [3]S6) [3]S6 {
    let mut r = v;
    for i in 0..r.len {
        r[i] = st_t6(r[i]);
    }
    return r;
}

fn hs_t11(h: u64, v: U11) u64 {
    match v {
        .V0(p) => { return hs_u8(mix(h, 0), p); }
        .V1    => { return mix(h, 1); }
        .V2(p) => { return hs_i32(mix(h, 2), p); }
        .V3    => { return mix(h, 3); }
        .V4(p) => { return hs_i64(mix(h, 4), p); }
    }
}

fn mk_t11(x: u64) U11 {
    match x % 5 {
        0    => { return U11.V0(mk_u8(mix(x, 99))); }
        1    => { return U11.V1; }
        2    => { return U11.V2(mk_i32(mix(x, 99))); }
        3    => { return U11.V3; }
        else => { return U11.V4(mk_i64(mix(x, 99))); }
    }
}

fn st_t11(v: U11) U11 {
    match v {
        .V0(p) => { return U11.V0(st_u8(p)); }
        .V1    => { return U11.V1; }
        .V2(p) => { return U11.V2(st_i32(p)); }
        .V3    => { return U11.V3; }
        .V4(p) => { return U11.V4(st_i64(p)); }
    }
}

fn hs_t12(h0: u64, v: S12) u64 {
    let mut h = h0;
    h = hs_t6(h, v.f0);
    h = hs_t11(h, v.f1);
    h = hs_f32(h, v.f2);
    h = hs_t4(h, v.f3);
    h = hs_t10(h, v.f4);
    h = hs_t2(h, v.f5);
    return h;
}

fn mk_t12(x: u64) S12 {
    return S12.{ f0: mk_t6(mix(x, 1)), f1: mk_t11(mix(x, 2)), f2: mk_f32(mix(x, 3)), f3: mk_t4(mix(x, 4)),
                 f4: mk_t10(mix(x, 5)), f5: mk_t2(mix(x, 6)) };
}

fn st_t12(v: S12) S12 {
    return S12.{ f0: st_t6(v.f0), f1: st_t11(v.f1), f2: st_f32(v.f2), f3: st_t4(v.f3), f4: st_t10(v.f4),
                 f5: st_t2(v.f5) };
}

fn hs_t13(h0: u64, v: S13) u64 {
    let mut h = h0;
    h = hs_bool(h, v.f0);
    return h;
}

fn mk_t13(x: u64) S13 {
    return S13.{ f0: mk_bool(mix(x, 1)) };
