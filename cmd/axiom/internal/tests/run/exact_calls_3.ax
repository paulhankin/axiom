fn hs_t72(h: u64, v: Errs!f64x4) u64 {
    let p = v catch |e| {
        return mix(h, 100 + eidx(e));
    };
    return hs_f64x4(mix(h, 0), p);
}

fn mk_t72(x: u64) Errs!f64x4 {
    if (x % 5) == 0 {
        match (x >> 8) % 3 {
            0    => { return error.Bad; }
            1    => { return error.Worse; }
            else => { return error.Ugly; }
        }
    }
    return mk_f64x4(mix(x, 6));
}

fn st_t72(v: Errs!f64x4) Errs!f64x4 {
    let p = v catch |e| {
        return e;
    };
    return st_f64x4(p);
}

