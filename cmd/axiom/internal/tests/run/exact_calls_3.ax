fn hs_t20(h0: u64, v: Two.[S7, Errs!i64]) u64 {
    let mut h = h0;
    h = hs_t7(h, v.a);
    h = hs_t19(h, v.b);
    return h;
}

fn mk_t20(x: u64) Two.[S7, Errs!i64] {
    return Two.[S7, Errs!i64].{ a: mk_t7(mix(x, 1)), b: mk_t19(mix(x, 2)) };
