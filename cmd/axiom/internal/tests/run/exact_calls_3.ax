}

fn mk_i16x32(x: u64) i16x32 {
    return @vec(i16x32, mk_i16(mix(x, 1)), mk_i16(mix(x, 2)), mk_i16(mix(x, 3)), mk_i16(mix(x, 4)), mk_i16(mix(x, 5)),
