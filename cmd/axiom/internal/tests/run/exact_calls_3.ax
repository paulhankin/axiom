    return S16.{ f0: mk_f64(mix(x, 1)), f1: mk_i64(mix(x, 2)), f2: mk_t2(mix(x, 3)), f3: mk_t15(mix(x, 4)) };
}

fn st_t16(v: S16) S16 {
    return S16.{ f0: st_f64(v.f0), f1: st_i64(v.f1), f2: st_t2(v.f2), f3: st_t15(v.f3) };
}

fn hs_t17(h0: u64, v: Two.[[3]i32, U5]) u64 {
    let mut h = h0;
    h = hs_t9(h, v.a);
    h = hs_t5(h, v.b);
    return h;
}

fn mk_t17(x: u64) Two.[[3]i32, U5] {
    return Two.[[3]i32, U5].{ a: mk_t9(mix(x, 1)), b: mk_t5(mix(x, 2)) };
}

fn st_t17(v: Two.[[3]i32, U5]) Two.[[3]i32, U5] {
    return Two.[[3]i32, U5].{ a: st_t9(v.a), b: st_t5(v.b) };
}

fn hs_t18(h: u64, v: ?i8) u64 {
    if let .some(p) = v {
        return hs_i8(mix(h, 1), p);
    }
    return mix(h, 0);
