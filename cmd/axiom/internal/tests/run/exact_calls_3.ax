    return S14.{ f0: mk_t10(mix(x, 1)), f1: mk_i16(mix(x, 2)), f2: mk_f64(mix(x, 3)), f3: mk_t13(mix(x, 4)) };
}

fn st_t14(v: S14) S14 {
    return S14.{ f0: st_t10(v.f0), f1: st_i16(v.f1), f2: st_f64(v.f2), f3: st_t13(v.f3) };
}

fn hs_t15(h: u64, v: ?S12) u64 {
    if let .some(p) = v {
        return hs_t12(mix(h, 1), p);
    }
    return mix(h, 0);
}

fn mk_t15(x: u64) ?S12 {
    if (x & 3) == 0 {
        return .none;
    }
    return mk_t12(mix(x, 5));
