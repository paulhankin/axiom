fn mix(h: u64, x: u64) u64 {
    let y = (h ^ x) *% 1099511628211;
    return y ^ (y >> 32);
}

fn hb128(h0: u64, v: u64x2) u64 {
    let mut h = h0;
    h = mix(h, @extract_lane(v, 0));
    h = mix(h, @extract_lane(v, 1));
    return h;
}

fn hb256(h0: u64, v: u64x4) u64 {
    let mut h = h0;
    h = mix(h, @extract_lane(v, 0));
    h = mix(h, @extract_lane(v, 1));
    h = mix(h, @extract_lane(v, 2));
    h = mix(h, @extract_lane(v, 3));
    return h;
}

fn hb512(h0: u64, v: u64x8) u64 {
    let mut h = h0;
    h = mix(h, @extract_lane(v, 0));
    h = mix(h, @extract_lane(v, 1));
    h = mix(h, @extract_lane(v, 2));
    h = mix(h, @extract_lane(v, 3));
    h = mix(h, @extract_lane(v, 4));
    h = mix(h, @extract_lane(v, 5));
    h = mix(h, @extract_lane(v, 6));
    h = mix(h, @extract_lane(v, 7));
    return h;
}

fn gpick[T](c: bool, a: T, b: T) T {
    if c {
        return a;
    }
    return b;
}

fn gswap[T](a: *mut T, b: *mut T) void {
    let t = a.*;
    a.* = b.*;
    b.* = t;
}

fn gfold[T, const H: fn(u64, T) u64](h: u64, xs: []T) u64 {
    let mut r = h;
    for x in xs {
        r = H(r, x);
    }
    return r;
}

fn gderef[T, const H: fn(u64, T) u64](h: u64, p: *T) u64 {
    return H(h, p.*);
}

fn gmk[T, const M: fn(u64) T](x: u64) T {
    return M(x);
}

fn gget[T, const N: usize](a: [N]T, i: usize) T {
    return a[i % N];
}

fn gsum[T: Int](a: T, b: T, c: T) T {
    return (a +% b) ^ c;
}

fn gmax[T: Ord](a: T, b: T) T {
    return @max(a, b);
}

struct Two[A, B] {
    a: A,
    b: B,

    fn first(self: Self) A {
        return self.a;
    }

    fn second(self: *Self) B {
        return self.b;
    }
}

fn eidx(e: Errs) u64 {
    match e {
        error.Bad   => { return 1; }
        error.Worse => { return 2; }
        error.Ugly  => { return 3; }
    }
}

fn hs_u8(h: u64, v: u8) u64 {
    return mix(h, @as(u64, v));
}

fn mk_u8(x: u64) u8 {
    return @truncate(u8, x);
}

fn st_u8(v: u8) u8 {
    return (v ^ 0) +% 255;
}

fn hs_i8(h: u64, v: i8) u64 {
    return mix(h, @bit_cast(u64, @as(i64, v)));
}

fn mk_i8(x: u64) i8 {
    return @bit_cast(i8, @truncate(u8, x));
}

fn st_i8(v: i8) i8 {
    return (v ^ -1) +% 127;
}

fn hs_u16(h: u64, v: u16) u64 {
    return mix(h, @as(u64, v));
}

fn mk_u16(x: u64) u16 {
    return @truncate(u16, x);
}

fn st_u16(v: u16) u16 {
    return (v ^ 1) +% 65533;
}

fn hs_i16(h: u64, v: i16) u64 {
    return mix(h, @bit_cast(u64, @as(i64, v)));
}

fn mk_i16(x: u64) i16 {
    return @bit_cast(i16, @truncate(u16, x));
}

fn st_i16(v: i16) i16 {
    return (v ^ 0) +% 1;
}

fn hs_u32(h: u64, v: u32) u64 {
    return mix(h, @as(u64, v));
}

fn mk_u32(x: u64) u32 {
    return @truncate(u32, x);
}

fn st_u32(v: u32) u32 {
    return (v ^ 1) +% 1039361864;
}

fn hs_i32(h: u64, v: i32) u64 {
    return mix(h, @bit_cast(u64, @as(i64, v)));
}

fn mk_i32(x: u64) i32 {
    return @bit_cast(i32, @truncate(u32, x));
}

fn st_i32(v: i32) i32 {
    return (v ^ 1) +% 1;
}

fn hs_u64(h: u64, v: u64) u64 {
    return mix(h, v);
}

fn mk_u64(x: u64) u64 {
    return x;
}

fn st_u64(v: u64) u64 {
    return (v ^ 18446744073709551615) +% 3;
}

fn hs_i64(h: u64, v: i64) u64 {
    return mix(h, @bit_cast(u64, v));
}

fn mk_i64(x: u64) i64 {
    return @bit_cast(i64, x);
}

fn st_i64(v: i64) i64 {
    return (v ^ 5361098383688915225) +% -7150001717115102100;
}

fn hs_usize(h: u64, v: usize) u64 {
    return mix(h, @as(u64, v));
}

fn mk_usize(x: u64) usize {
    return @as(usize, @truncate(u32, x) >> 1);
}

fn st_usize(v: usize) usize {
    return ((v ^ 2147483647) >> 1) +% 680156594;
}

fn hs_isize(h: u64, v: isize) u64 {
    return mix(h, @bit_cast(u64, @as(i64, v)));
}

fn mk_isize(x: u64) isize {
    return @as(isize, @bit_cast(i32, @truncate(u32, x)));
}

fn st_isize(v: isize) isize {
    return ((v ^ 1698899158) >> 1) +% -531085289;
}

fn hs_f32(h: u64, v: f32) u64 {
    if v != v {
        return mix(h, 0x7fc00000);
    }
    return mix(h, @as(u64, @bit_cast(u32, v)));
}

fn mk_f32(x: u64) f32 {
    return @float_from_int(f32, @bit_cast(i32, @truncate(u32, x))) * 0.0078125;
}

fn st_f32(v: f32) f32 {
    return (v * 2.0) + 0.25;
}

fn hs_f64(h: u64, v: f64) u64 {
    if v != v {
        return mix(h, 0x7ff8000000000000);
    }
    return mix(h, @bit_cast(u64, v));
}

fn mk_f64(x: u64) f64 {
    return @float_from_int(f64, @bit_cast(i32, @truncate(u32, x))) * 0.0078125;
}

fn st_f64(v: f64) f64 {
    return (v * 1.5) + 0.0;
}

fn hs_bool(h: u64, v: bool) u64 {
    return mix(h, @as(u64, v));
}

fn mk_bool(x: u64) bool {
    return ((x >> 3) & 1) == 1;
}

fn st_bool(v: bool) bool {
    return not v;
}

fn hs_i32x4(h0: u64, v: i32x4) u64 {
    return hb128(h0, @bit_cast(u64x2, v));
}

fn mk_i32x4(x: u64) i32x4 {
    return @vec(i32x4, mk_i32(mix(x, 1)), mk_i32(mix(x, 2)), mk_i32(mix(x, 3)), mk_i32(mix(x, 4)));
}

fn st_i32x4(v: i32x4) i32x4 {
    let c: i32x4 = @splat(1);
    return v +% c;
}

fn hs_f32x4(h0: u64, v: f32x4) u64 {
    let mut h = h0;
    h = hs_f32(h, @extract_lane(v, 0));
    h = hs_f32(h, @extract_lane(v, 1));
    h = hs_f32(h, @extract_lane(v, 2));
    h = hs_f32(h, @extract_lane(v, 3));
    return h;
}

fn mk_f32x4(x: u64) f32x4 {
    return @vec(f32x4, mk_f32(mix(x, 1)), mk_f32(mix(x, 2)), mk_f32(mix(x, 3)), mk_f32(mix(x, 4)));
}

fn st_f32x4(v: f32x4) f32x4 {
    let a: f32x4 = @splat(2.0);
    let b: f32x4 = @splat(0.25);
    return (v * a) + b;
}

fn hs_u8x16(h0: u64, v: u8x16) u64 {
    return hb128(h0, @bit_cast(u64x2, v));
}

fn mk_u8x16(x: u64) u8x16 {
    return @vec(u8x16, mk_u8(mix(x, 1)), mk_u8(mix(x, 2)), mk_u8(mix(x, 3)), mk_u8(mix(x, 4)), mk_u8(mix(x, 5)),
                mk_u8(mix(x, 6)), mk_u8(mix(x, 7)), mk_u8(mix(x, 8)), mk_u8(mix(x, 9)), mk_u8(mix(x, 10)),
                mk_u8(mix(x, 11)), mk_u8(mix(x, 12)), mk_u8(mix(x, 13)), mk_u8(mix(x, 14)), mk_u8(mix(x, 15)),
                mk_u8(mix(x, 16)));
}

fn st_u8x16(v: u8x16) u8x16 {
    let c: u8x16 = @splat(255);
    return v +% c;
}

fn hs_f64x2(h0: u64, v: f64x2) u64 {
    let mut h = h0;
    h = hs_f64(h, @extract_lane(v, 0));
    h = hs_f64(h, @extract_lane(v, 1));
    return h;
}

fn mk_f64x2(x: u64) f64x2 {
    return @vec(f64x2, mk_f64(mix(x, 1)), mk_f64(mix(x, 2)));
}

fn st_f64x2(v: f64x2) f64x2 {
    let a: f64x2 = @splat(1.5);
    let b: f64x2 = @splat(0.0);
    return (v * a) + b;
}

fn hs_i64x2(h0: u64, v: i64x2) u64 {
    return hb128(h0, @bit_cast(u64x2, v));
}

fn mk_i64x2(x: u64) i64x2 {
    return @vec(i64x2, mk_i64(mix(x, 1)), mk_i64(mix(x, 2)));
}

fn st_i64x2(v: i64x2) i64x2 {
    let c: i64x2 = @splat(-7150001717115102100);
    return v +% c;
}

fn hs_u16x8(h0: u64, v: u16x8) u64 {
    return hb128(h0, @bit_cast(u64x2, v));
}

fn mk_u16x8(x: u64) u16x8 {
    return @vec(u16x8, mk_u16(mix(x, 1)), mk_u16(mix(x, 2)), mk_u16(mix(x, 3)), mk_u16(mix(x, 4)), mk_u16(mix(x, 5)),
                mk_u16(mix(x, 6)), mk_u16(mix(x, 7)), mk_u16(mix(x, 8)));
}

fn st_u16x8(v: u16x8) u16x8 {
    let c: u16x8 = @splat(65533);
    return v +% c;
}

fn hs_i32x8(h0: u64, v: i32x8) u64 {
    return hb256(h0, @bit_cast(u64x4, v));
}

fn mk_i32x8(x: u64) i32x8 {
    return @vec(i32x8, mk_i32(mix(x, 1)), mk_i32(mix(x, 2)), mk_i32(mix(x, 3)), mk_i32(mix(x, 4)), mk_i32(mix(x, 5)),
                mk_i32(mix(x, 6)), mk_i32(mix(x, 7)), mk_i32(mix(x, 8)));
}

fn st_i32x8(v: i32x8) i32x8 {
    let c: i32x8 = @splat(1);
    return v +% c;
}

fn hs_f64x4(h0: u64, v: f64x4) u64 {
    let mut h = h0;
    h = hs_f64(h, @extract_lane(v, 0));
    h = hs_f64(h, @extract_lane(v, 1));
    h = hs_f64(h, @extract_lane(v, 2));
    h = hs_f64(h, @extract_lane(v, 3));
    return h;
}

fn mk_f64x4(x: u64) f64x4 {
    return @vec(f64x4, mk_f64(mix(x, 1)), mk_f64(mix(x, 2)), mk_f64(mix(x, 3)), mk_f64(mix(x, 4)));
}

fn st_f64x4(v: f64x4) f64x4 {
    let a: f64x4 = @splat(1.5);
    let b: f64x4 = @splat(0.0);
    return (v * a) + b;
}

fn hs_f32x8(h0: u64, v: f32x8) u64 {
    let mut h = h0;
    h = hs_f32(h, @extract_lane(v, 0));
    h = hs_f32(h, @extract_lane(v, 1));
    h = hs_f32(h, @extract_lane(v, 2));
    h = hs_f32(h, @extract_lane(v, 3));
    h = hs_f32(h, @extract_lane(v, 4));
    h = hs_f32(h, @extract_lane(v, 5));
    h = hs_f32(h, @extract_lane(v, 6));
    h = hs_f32(h, @extract_lane(v, 7));
    return h;
}

fn mk_f32x8(x: u64) f32x8 {
    return @vec(f32x8, mk_f32(mix(x, 1)), mk_f32(mix(x, 2)), mk_f32(mix(x, 3)), mk_f32(mix(x, 4)), mk_f32(mix(x, 5)),
                mk_f32(mix(x, 6)), mk_f32(mix(x, 7)), mk_f32(mix(x, 8)));
}

fn st_f32x8(v: f32x8) f32x8 {
    let a: f32x8 = @splat(2.0);
    let b: f32x8 = @splat(0.25);
    return (v * a) + b;
}

fn hs_i16x32(h0: u64, v: i16x32) u64 {
    return hb512(h0, @bit_cast(u64x8, v));
}

fn mk_i16x32(x: u64) i16x32 {
    return @vec(i16x32, mk_i16(mix(x, 1)), mk_i16(mix(x, 2)), mk_i16(mix(x, 3)), mk_i16(mix(x, 4)), mk_i16(mix(x, 5)),
                mk_i16(mix(x, 6)), mk_i16(mix(x, 7)), mk_i16(mix(x, 8)), mk_i16(mix(x, 9)), mk_i16(mix(x, 10)),
                mk_i16(mix(x, 11)), mk_i16(mix(x, 12)), mk_i16(mix(x, 13)), mk_i16(mix(x, 14)), mk_i16(mix(x, 15)),
                mk_i16(mix(x, 16)), mk_i16(mix(x, 17)), mk_i16(mix(x, 18)), mk_i16(mix(x, 19)), mk_i16(mix(x, 20)),
                mk_i16(mix(x, 21)), mk_i16(mix(x, 22)), mk_i16(mix(x, 23)), mk_i16(mix(x, 24)), mk_i16(mix(x, 25)),
                mk_i16(mix(x, 26)), mk_i16(mix(x, 27)), mk_i16(mix(x, 28)), mk_i16(mix(x, 29)), mk_i16(mix(x, 30)),
                mk_i16(mix(x, 31)), mk_i16(mix(x, 32)));
}

fn st_i16x32(v: i16x32) i16x32 {
    let c: i16x32 = @splat(1);
    return v +% c;
}

fn hs_f32x16(h0: u64, v: f32x16) u64 {
    let mut h = h0;
    h = hs_f32(h, @extract_lane(v, 0));
    h = hs_f32(h, @extract_lane(v, 1));
    h = hs_f32(h, @extract_lane(v, 2));
    h = hs_f32(h, @extract_lane(v, 3));
    h = hs_f32(h, @extract_lane(v, 4));
    h = hs_f32(h, @extract_lane(v, 5));
    h = hs_f32(h, @extract_lane(v, 6));
    h = hs_f32(h, @extract_lane(v, 7));
    h = hs_f32(h, @extract_lane(v, 8));
    h = hs_f32(h, @extract_lane(v, 9));
    h = hs_f32(h, @extract_lane(v, 10));
    h = hs_f32(h, @extract_lane(v, 11));
    h = hs_f32(h, @extract_lane(v, 12));
    h = hs_f32(h, @extract_lane(v, 13));
    h = hs_f32(h, @extract_lane(v, 14));
    h = hs_f32(h, @extract_lane(v, 15));
    return h;
}

fn mk_f32x16(x: u64) f32x16 {
    return @vec(f32x16, mk_f32(mix(x, 1)), mk_f32(mix(x, 2)), mk_f32(mix(x, 3)), mk_f32(mix(x, 4)), mk_f32(mix(x, 5)),
                mk_f32(mix(x, 6)), mk_f32(mix(x, 7)), mk_f32(mix(x, 8)), mk_f32(mix(x, 9)), mk_f32(mix(x, 10)),
                mk_f32(mix(x, 11)), mk_f32(mix(x, 12)), mk_f32(mix(x, 13)), mk_f32(mix(x, 14)), mk_f32(mix(x, 15)),
                mk_f32(mix(x, 16)));
}

fn st_f32x16(v: f32x16) f32x16 {
    let a: f32x16 = @splat(2.0);
    let b: f32x16 = @splat(0.25);
    return (v * a) + b;
}

fn hs_t1(h: u64, v: E1) u64 {
    match v {
        .M0 => { return mix(h, 0); }
    }
}

fn mk_t1(x: u64) E1 {
    match x % 1 {
        else => { return E1.M0; }
    }
}

fn st_t1(v: E1) E1 {
    match v {
        .M0 => { return E1.M0; }
    }
}

fn hs_t2(h: u64, v: E2) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
    }
}

fn mk_t2(x: u64) E2 {
    match x % 2 {
        0    => { return E2.M0; }
        else => { return E2.M1; }
    }
}

fn st_t2(v: E2) E2 {
    match v {
        .M0 => { return E2.M1; }
        .M1 => { return E2.M0; }
    }
}

fn hs_t3(h: u64, v: E3) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
    }
}

fn mk_t3(x: u64) E3 {
    match x % 2 {
        0    => { return E3.M0; }
        else => { return E3.M1; }
    }
}

fn st_t3(v: E3) E3 {
    match v {
        .M0 => { return E3.M1; }
        .M1 => { return E3.M0; }
    }
}

fn hs_t4(h: u64, v: E4) u64 {
    match v {
        .M0 => { return mix(h, 0); }
        .M1 => { return mix(h, 1); }
        .M2 => { return mix(h, 2); }
        .M3 => { return mix(h, 3); }
        .M4 => { return mix(h, 4); }
        .M5 => { return mix(h, 5); }
    }
}

fn mk_t4(x: u64) E4 {
    match x % 6 {
        0    => { return E4.M0; }
        1    => { return E4.M1; }
        2    => { return E4.M2; }
        3    => { return E4.M3; }
        4    => { return E4.M4; }
        else => { return E4.M5; }
    }
}

fn st_t4(v: E4) E4 {
    match v {
        .M0 => { return E4.M1; }
        .M1 => { return E4.M2; }
        .M2 => { return E4.M3; }
        .M3 => { return E4.M4; }
        .M4 => { return E4.M5; }
        .M5 => { return E4.M0; }
    }
}

fn hs_t5(h0: u64, v: S5) u64 {
    let mut h = h0;
    h = hs_i8(h, v.f0);
    h = hs_f64(h, v.f1);
    h = hs_t1(h, v.f2);
    return h;
}

fn mk_t5(x: u64) S5 {
    return S5.{ f0: mk_i8(mix(x, 1)), f1: mk_f64(mix(x, 2)), f2: mk_t1(mix(x, 3)) };
}

fn st_t5(v: S5) S5 {
    return S5.{ f0: st_i8(v.f0), f1: st_f64(v.f1), f2: st_t1(v.f2) };
}

fn hs_t6(h0: u64, v: S6) u64 {
    let mut h = h0;
    h = hs_f32(h, v.f0);
    h = hs_usize(h, v.f1);
    h = hs_t5(h, v.f2);
    return h;
}

fn mk_t6(x: u64) S6 {
    return S6.{ f0: mk_f32(mix(x, 1)), f1: mk_usize(mix(x, 2)), f2: mk_t5(mix(x, 3)) };
}

fn st_t6(v: S6) S6 {
    return S6.{ f0: st_f32(v.f0), f1: st_usize(v.f1), f2: st_t5(v.f2) };
}

fn hs_t7(h0: u64, v: S7) u64 {
    let mut h = h0;
    h = hs_bool(h, v.f0);
    h = hs_i32(h, v.f1);
    h = hs_f64(h, v.f2);
    h = hs_i64(h, v.f3);
    return h;
}

fn mk_t7(x: u64) S7 {
    return S7.{ f0: mk_bool(mix(x, 1)), f1: mk_i32(mix(x, 2)), f2: mk_f64(mix(x, 3)), f3: mk_i64(mix(x, 4)) };
}

fn st_t7(v: S7) S7 {
    return S7.{ f0: st_bool(v.f0), f1: st_i32(v.f1), f2: st_f64(v.f2), f3: st_i64(v.f3) };
}

fn hs_t8(h: u64, v: Errs!S7) u64 {
    let p = v catch |e| {
        return mix(h, 100 + eidx(e));
    };
    return hs_t7(mix(h, 0), p);
}

fn mk_t8(x: u64) Errs!S7 {
    if (x % 5) == 0 {
        match (x >> 8) % 3 {
            0    => { return error.Bad; }
            1    => { return error.Worse; }
            else => { return error.Ugly; }
        }
    }
    return mk_t7(mix(x, 6));
}

fn st_t8(v: Errs!S7) Errs!S7 {
    let p = v catch |e| {
        return e;
    };
    return st_t7(p);
}

fn hs_t9(h0: u64, v: S9) u64 {
    let mut h = h0;
    h = hs_t5(h, v.f0);
    h = hs_f32(h, v.f1);
    h = hs_bool(h, v.f2);
    h = hs_f64(h, v.f3);
    h = hs_t4(h, v.f4);
    h = hs_u16(h, v.f5);
    return h;
}

fn mk_t9(x: u64) S9 {
    return S9.{ f0: mk_t5(mix(x, 1)), f1: mk_f32(mix(x, 2)), f2: mk_bool(mix(x, 3)), f3: mk_f64(mix(x, 4)),
                f4: mk_t4(mix(x, 5)), f5: mk_u16(mix(x, 6)) };
}

fn st_t9(v: S9) S9 {
    return S9.{ f0: st_t5(v.f0), f1: st_f32(v.f1), f2: st_bool(v.f2), f3: st_f64(v.f3), f4: st_t4(v.f4),
                f5: st_u16(v.f5) };
}

fn hs_t10(h: u64, v: Errs!S9) u64 {
    let p = v catch |e| {
        return mix(h, 100 + eidx(e));
    };
    return hs_t9(mix(h, 0), p);
}

fn mk_t10(x: u64) Errs!S9 {
    if (x % 5) == 0 {
        match (x >> 8) % 3 {
            0    => { return error.Bad; }
            1    => { return error.Worse; }
            else => { return error.Ugly; }
        }
    }
    return mk_t9(mix(x, 6));
}

fn st_t10(v: Errs!S9) Errs!S9 {
    let p = v catch |e| {
        return e;
    };
    return st_t9(p);
}

fn hs_t12(h: u64, v: ?S5) u64 {
    if let .some(p) = v {
        return hs_t5(mix(h, 1), p);
    }
    return mix(h, 0);
}

fn mk_t12(x: u64) ?S5 {
    if (x & 3) == 0 {
        return .none;
    }
    return mk_t5(mix(x, 5));
}

fn st_t12(v: ?S5) ?S5 {
    match v {
        .some(p) => { return .some(st_t5(p)); }
        .none    => { return .none; }
    }
}

fn hs_t11(h: u64, v: U11) u64 {
    match v {
        .V0(p) => { return hs_u8(mix(h, 0), p); }
        .V1(p) => { return hs_t12(mix(h, 1), p); }
        .V2    => { return mix(h, 2); }
        .V3(p) => { return hs_t5(mix(h, 3), p); }
        .V4    => { return mix(h, 4); }
    }
}

fn mk_t11(x: u64) U11 {
    match x % 5 {
        0    => { return U11.V0(mk_u8(mix(x, 99))); }
        1    => { return U11.V1(mk_t12(mix(x, 99))); }
        2    => { return U11.V2; }
        3    => { return U11.V3(mk_t5(mix(x, 99))); }
        else => { return U11.V4; }
    }
}

fn st_t11(v: U11) U11 {
    match v {
        .V0(p) => { return U11.V0(st_u8(p)); }
        .V1(p) => { return U11.V1(st_t12(p)); }
        .V2    => { return U11.V2; }
        .V3(p) => { return U11.V3(st_t5(p)); }
        .V4    => { return U11.V4; }
    }
}

fn hs_t13(h: u64, v: ?bool) u64 {
    if let .some(p) = v {
        return hs_bool(mix(h, 1), p);
    }
    return mix(h, 0);
}

fn mk_t13(x: u64) ?bool {
    if (x & 3) == 0 {
        return .none;
    }
    return mk_bool(mix(x, 5));
}

fn st_t13(v: ?bool) ?bool {
    match v {
        .some(p) => { return .some(st_bool(p)); }
        .none    => { return .none; }
    }
}

fn hs_t14(h0: u64, v: S14) u64 {
    let mut h = h0;
    h = hs_t8(h, v.f0);
    h = hs_i16(h, v.f1);
    h = hs_t11(h, v.f2);
    h = hs_u64(h, v.f3);
    return h;
}

fn mk_t14(x: u64) S14 {
    return S14.{ f0: mk_t8(mix(x, 1)), f1: mk_i16(mix(x, 2)), f2: mk_t11(mix(x, 3)), f3: mk_u64(mix(x, 4)) };
}

fn st_t14(v: S14) S14 {
    return S14.{ f0: st_t8(v.f0), f1: st_i16(v.f1), f2: st_t11(v.f2), f3: st_u64(v.f3) };
