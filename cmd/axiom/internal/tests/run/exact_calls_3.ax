fn hs_t15(h0: u64, v: S15) u64 {
    let mut h = h0;
    h = hs_i8(h, v.f0);
    return h;
}

fn mk_t15(x: u64) S15 {
    return S15.{ f0: mk_i8(mix(x, 1)) };
}

fn st_t15(v: S15) S15 {
    return S15.{ f0: st_i8(v.f0) };
}

fn hs_t16(h0: u64, v: [3]isize) u64 {
    let mut h = h0;
    for x in v {
        h = hs_isize(h, x);
    }
    return h;
}

fn mk_t16(x: u64) [3]isize {
    return [mk_isize(mix(x, 1)), mk_isize(mix(x, 2)), mk_isize(mix(x, 3))];
}

fn st_t16(v: [3]isize) [3]isize {
    let mut r = v;
    for i in 0..r.len {
        r[i] = st_isize(r[i]);
    }
    return r;
}

fn hs_t17(h: u64, v: ?S14) u64 {
    if let .some(p) = v {
        return hs_t14(mix(h, 1), p);
    }
    return mix(h, 0);
}

fn mk_t17(x: u64) ?S14 {
