fn hs_t37(h: u64, v: Errs!u16) u64 {
    let p = v catch |e| {
        return mix(h, 100 + eidx(e));
    };
    return hs_u16(mix(h, 0), p);
}

fn mk_t37(x: u64) Errs!u16 {
    if (x % 5) == 0 {
        match (x >> 8) % 3 {
            0    => { return error.Bad; }
            1    => { return error.Worse; }
            else => { return error.Ugly; }
        }
    }
    return mk_u16(mix(x, 6));
}

fn st_t37(v: Errs!u16) Errs!u16 {
    let p = v catch |e| {
        return e;
