// Several patterns in one match arm, and `if let` (spec §8.3, §8.6).
import "../lib/io.ax" as io;

union Shape {
    Circle: f64,
    Square: f64,
    Rect: struct { w: f64, h: f64 },
    Empty,
}

enum Day {
    MON,
    TUE,
    WED,
    THU,
    FRI,
    SAT,
    SUN,
}

fn weekend(d: Day) bool {
    match d {
        .SAT, .SUN                   => { return true; }
        .MON, .TUE, .WED, .THU, .FRI => { return false; }
    }
}

fn round(s: Shape) bool {
    match s {
        .Circle                => { return true; }
        .Square, .Rect, .Empty => { return false; }
    }
}

fn digit_kind(c: u8) i64 {
    match c {
        '0', '2', '4', '6', '8' => { return 0; }
        '1', '3', '5', '7', '9' => { return 1; }
        else                    => { return -1; }
    }
}

error {
    Busy,
    Gone,
    Late,
}

fn retryable(e: error) bool {
    match e {
        error.Busy, error.Late => { return true; }
        else                   => { return false; }
    }
}

fn side(s: Shape) f64 {
    if let .Square(x) = s {
        return x;
    } else if let .Circle(r) = s {
        return 2.0 * r;
    } else {
        return -1.0;
    }
}

fn count_empty(xs: []Shape) i64 {
    let mut n: i64 = 0;
    for x in xs {
        if let .Empty = x {
            n += 1;
        }
    }
    return n;
}

fn first_rect_area(xs: []Shape) f64 {
    for x in xs {
        if let .Rect(r) = x {
            return r.w * r.h;
        }
    }
    return 0.0;
}

export fn run() void {
    io.boolean(weekend(Day.SAT));          // expect: true
    io.boolean(weekend(Day.WED));          // expect: false
    io.boolean(round(Shape.Circle(1.0)));  // expect: true
    io.boolean(round(Shape.Empty));        // expect: false
    io.int(digit_kind('4'));               // expect: 0
    io.int(digit_kind('7'));               // expect: 1
    io.int(digit_kind('x'));               // expect: -1
    io.boolean(retryable(error.Late));     // expect: true
    io.boolean(retryable(error.Gone));     // expect: false
    io.float(side(Shape.Square(3.0)));     // expect: 3
    io.float(side(Shape.Circle(2.0)));     // expect: 4
    io.float(side(Shape.Empty));           // expect: -1
    let xs = [Shape.Empty, Shape.Rect(.{ w: 2.0, h: 5.0 }), Shape.Empty, Shape.Circle(1.0)];
    io.int(count_empty(xs[0..]));        // expect: 2
    io.float(first_rect_area(xs[0..]));  // expect: 10
}
