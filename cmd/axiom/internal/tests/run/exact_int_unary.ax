                              @as(u8, @as(u64, a) <= @as(u64, b)) << 3) | (
                                  @as(u8, @as(u64, a) > @as(u64, b)) << 4) | (
                                      @as(u8, @as(u64, a) >= @as(u64, b)) << 5));
        }
    }
    for i in 0..V_U64.len {
        for j in 0..V_U16.len {
            let a = V_U64[i];
            let b = V_U16[j];
            h1 = h_u8(h1,
                      @as(u8, @as(u64, a) == @as(u64, b)) | (@as(u8, @as(u64, a) != @as(u64, b)) << 1) | (
                          @as(u8, @as(u64, a) < @as(u64, b)) << 2) | (
                              @as(u8, @as(u64, a) <= @as(u64, b)) << 3) | (
                                  @as(u8, @as(u64, a) > @as(u64, b)) << 4) | (
                                      @as(u8, @as(u64, a) >= @as(u64, b)) << 5));
        }
    }
    for i in 0..V_U64.len {
        for j in 0..V_U32.len {
            let a = V_U64[i];
            let b = V_U32[j];
            h2 = h_u8(h2,
                      @as(u8, @as(u64, a) == @as(u64, b)) | (@as(u8, @as(u64, a) != @as(u64, b)) << 1) | (
                          @as(u8, @as(u64, a) < @as(u64, b)) << 2) | (
                              @as(u8, @as(u64, a) <= @as(u64, b)) << 3) | (
                                  @as(u8, @as(u64, a) > @as(u64, b)) << 4) | (
                                      @as(u8, @as(u64, a) >= @as(u64, b)) << 5));
        }
    }
    io.uint(h0);
    io.uint(h1);
    io.uint(h2);
}

