                                  @as(u8, @as(i64, a) > @as(i64, b)) << 4) | (
                                      @as(u8, @as(i64, a) >= @as(i64, b)) << 5));
        }
    }
    for i in 0..V_I64.len {
        for j in 0..V_I32.len {
            let a = V_I64[i];
            let b = V_I32[j];
            h5 = h_u8(h5,
                      @as(u8, @as(i64, a) == @as(i64, b)) | (@as(u8, @as(i64, a) != @as(i64, b)) << 1) | (
