// Baseline x86-64 (SSE2 only) paths of the self-hosted backend (issues 0106,
// 0108, 0109):
// integers into lanes without SSE4.1's pinsrd / pinsrq (movd / movq, then
// shuffles; into lane 0 of zeros, movd / movq alone), floats chosen between
// two constants as integers (cmov, on integer and float compares, NaN
// included), and integer vector operations of constant lanes (an unrolled
// loop over constant vectors) folded. The results are LLVM's.
// x86-64-flags: --cpu=x86-64
import "../lib/io.ax" as io;

let mut H: u64 = 0;

fn mix(x: u64) void {
    H = (H *% 1099511628211) ^ x;
}

fn mix4(v: u32x4) void {
    mix(@as(u64, @extract_lane(v, 0)));
    mix(@as(u64, @extract_lane(v, 1)));
    mix(@as(u64, @extract_lane(v, 2)));
    mix(@as(u64, @extract_lane(v, 3)));
}

fn mix2(v: u64x2) void {
    mix(@extract_lane(v, 0));
    mix(@extract_lane(v, 1));
}

fn lanes32(base: u32x4, x: u32) void {
    mix4(@replace_lane(base, 0, x));
    mix4(@replace_lane(base, 1, x));
    mix4(@replace_lane(base, 2, x));
    mix4(@replace_lane(base, 3, x));
    mix4(@vec(u32x4, x, 0, 0, 0));
}

fn lanes64(base: u64x2, x: u64) void {
    mix2(@replace_lane(base, 0, x));
    mix2(@replace_lane(base, 1, x));
    mix2(@vec(u64x2, x, 0));
}

fn consts(nc: u8) [4]f32 {
    let mut one: f32 = 0.0;
    let mut two: f32 = -0.0;
    let mut many: f32 = 0.5;
    let mut neg: f32 = 3.0;
    if nc == 1 {
        one = 1.0;
    }
    if nc == 2 {
        two = 1.0;
    }
    if nc >= 3 {
        many = -2.25;
    }
    if nc < 1 {
        neg = -7.0;
    }
    return [one, two, many, neg];
}

fn fconsts(a: f64, b: f64) f64 {
    let mut r: f64 = 0.0;
    if a == b {
        r = 1.0;
    }
    let mut s: f64 = 2.0;
    if a != b {
        s = -0.5;
    }
    let mut t: f64 = 4.0;
    if a < b {
        t = 0.0;
    }
    return ((r * 100.0) + (s * 10.0)) + t;
}

// lane masks of constant vectors against a variable bound, unrolled
fn masks(back: i16) i32 {
    let point: [3]i16x8 = [
        @vec(i16x8, 0, 1, 2, 3, 4, 5, 6, 7),
        @vec(i16x8, 8, 9, 10, 11, 12, 13, 14, 15),
        @vec(i16x8, 16, 17, 18, 19, 20, 21, 22, 23),
    ];
    let one: i16x8 = @splat(1);
    let six: i16x8 = @splat(6);
    let lim: i16x8 = @splat(20);
    let b: i16x8 = @splat(back);
    let mut total: i32x4 = @splat(0);
    for j in @as(usize, 0)..3 {
        let p = point[j];
        let fixed = @lanes_ge(p, six) & @lanes_le(p, lim);
        let w = @lanes_gt(p, b) & ((p +% one) -% b);
        let sel = (fixed & (p +% one)) | (~fixed & w);
        total = total +% @dot(sel, one);
    }
    return @reduce_add(total);
}

export fn run() void {
    let mut h: u32 = 7;
    for _r in @as(usize, 0)..20 {
        h = (h *% 1103515245) +% 12345;
        let base = @vec(u32x4, h, h ^ 0x5555_5555, h +% 17, ~h);
        lanes32(base, h >> 3);
        let base64 = @vec(u64x2, @as(u64, h) << 20, @as(u64, ~h) * 3);
        lanes64(base64, (@as(u64, h) << 32) | @as(u64, h >> 5));
    }
    io.uint(H);
    let mut s: u64 = 0;
    for i in @as(u8, 0)..8 {
        let r = consts(i % 5);
        for k in @as(usize, 0)..4 {
            s = (s *% 31) +% @as(u64, @bit_cast(u32, r[k]));
        }
    }
    io.uint(s);
    let nan: f64 = 0.0 / 0.0;
    let vals: [4]f64 = [1.0, 2.0, nan, -1.0];
    let mut t: f64 = 0.0;
    for i in @as(usize, 0)..4 {
        for j in @as(usize, 0)..4 {
            t = (t * 3.0) + fconsts(vals[i], vals[j]);
        }
    }
    io.float(t);
    let mut m: i64 = 0;
    for b in @as(i16, -2)..26 {
        m = (m * 7) + @as(i64, masks(b));
    }
    io.int(m);
}

// expect: 9090093068045027266
