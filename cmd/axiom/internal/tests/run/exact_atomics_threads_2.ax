fn mix(h: u64, x: u64) u64 {
    let y = (h ^ x) *% 1099511628211;
    return y ^ (y >> 32);
}

fn h_u8(h: u64, r: u8) u64 {
    return mix(h, @as(u64, r));
}

fn h_u16(h: u64, r: u16) u64 {
    return mix(h, @as(u64, r));
}

fn h_u32(h: u64, r: u32) u64 {
    return mix(h, @as(u64, r));
}

fn h_u64(h: u64, r: u64) u64 {
    return mix(h, r);
}

fn h_usize(h: u64, r: usize) u64 {
    return mix(h, @as(u64, r));
}

fn h_i8(h: u64, r: i8) u64 {
    return mix(h, @bit_cast(u64, @as(i64, r)));
}

fn h_i16(h: u64, r: i16) u64 {
    return mix(h, @bit_cast(u64, @as(i64, r)));
}

fn h_i32(h: u64, r: i32) u64 {
    return mix(h, @bit_cast(u64, @as(i64, r)));
}

fn h_i64(h: u64, r: i64) u64 {
    return mix(h, @bit_cast(u64, r));
}

fn h_isize(h: u64, r: isize) u64 {
    return mix(h, @bit_cast(u64, @as(i64, r)));
}

fn h_bool(h: u64, r: bool) u64 {
    return mix(h, @as(u64, r));
}

fn h_f32(h: u64, r: f32) u64 {
    if r != r {
        return mix(h, 0x7fc00000);
    }
    return mix(h, @as(u64, @bit_cast(u32, r)));
}

fn h_f64(h: u64, r: f64) u64 {
    if r != r {
        return mix(h, 0x7ff8000000000000);
    }
    return mix(h, @bit_cast(u64, r));
}

struct Slot {
    b8: u8,
    tsum: u64,
    b16: i16,
    xsum: u64,
    b8b: u8,
    xxor: u64,
    err: u32,
    tl: u64,
}

struct Shared {
    bar: sync.Barrier,
    lock: sync.Mutex,
    c8: i32,
    k0: i32,
    c3: usize,
    q1: usize,
    c1: u16,
    x0: usize,
    q0: i32,
    c5: i8,
    k2: u64,
    c4: i16,
    k1: i16,
    c6: i64,
    x1: i8,
    c2: u32,
    c0: usize,
    c7: u64,
    x2: isize,
    s0: sync.Atomic.[i32],
    s1: sync.Atomic.[i16],
    turn: u32,
    tlog: [32]u64,
    tn: usize,
    m_sum: u64,
    m_b: u8,
    m_cnt: u32,
    m_h: u64,
    slots: [2]Slot,
    bytes: [16]u8,
    halves: [16]u16,
}

struct Arg {
    sh: *mut Shared,
    id: usize,
}

fn worker(arg: Arg) void {
    let sh = arg.sh;
    let id = arg.id;
    let slot = &mut sh.slots[id];
    _ = sh.bar.wait();
    for it in @as(usize, 0)..241 {
        let k = it * 2 + id;
        {
            let o = @atomic_min(&mut sh.c1, V1[k % V1.len], "release");
            if o > 18891 {
                slot.err += 1;
            }
        }
        _ = sh.s0.add(V14[k % V14.len]);
        {
            let o = @atomic_or(&mut sh.c5, V5[k % V5.len], "relaxed");
            if (o & 3) != 3 {
                slot.err += 1;
            }
        }
        _ = @atomic_max(&mut sh.c0, V0[k % V0.len], "release");
        sh.bytes[(it % 8) * 2 + id] = @truncate(u8, it *% 7 +% id *% 13 +% 1);
        sh.halves[(it % 8) * 2 + id] = @truncate(u16, it *% 331 +% id);
        slot.b8 = @truncate(u8, k);
        slot.b16 = @bit_cast(i16, @truncate(u16, k *% 3));
        slot.b8b = @truncate(u8, it +% 5);
        TL = mix(TL, @as(u64, k));
        _ = @atomic_and(&mut sh.c7, V7[k % V7.len], "release");
        {
            let v = V13[k % V13.len];
            let mut old = sh.q1;
            loop {
                let seen = @atomic_cas(&mut sh.q1, old, old ^ v, "seq_cst");
                if seen == old {
                    break;
                }
                old = seen;
            }
        }
        _ = sh.s1.add(V15[k % V15.len]);
        {
            let o = @atomic_min(&mut sh.c6, V6[k % V6.len], "acquire");
            if o > 5017554719615772869 {
                slot.err += 1;
            }
        }
        _ = @atomic_max(&mut sh.c3, V3[k % V3.len]);
        {
            let v = V12[k % V12.len];
            let mut old = sh.q0;
            loop {
                let seen = @atomic_cas(&mut sh.q0, old, old +% v);
                if seen == old {
                    break;
                }
                old = seen;
            }
        }
        {
            let o = @bit_cast(u64, @as(i64, @atomic_xchg(&mut sh.x2, V11[k % V11.len], "release")));
            slot.xsum +%= o;
            slot.xxor ^= o;
        }
        _ = @atomic_xor(&mut sh.c4, V4[k % V4.len]);
        {
            let o = @as(u64, @atomic_xchg(&mut sh.x0, V9[k % V9.len], "acq_rel"));
            slot.xsum +%= o;
            slot.xxor ^= o;
        }
        slot.tsum +%= @bit_cast(u64, @as(i64, @atomic_add(&mut sh.k1, D_K1, "release")));
        slot.tsum +%= @bit_cast(u64, @as(i64, @atomic_add(&mut sh.k0, D_K0, "seq_cst")));
        slot.tsum +%= @atomic_add(&mut sh.k2, 1);
        {
            let o = @bit_cast(u64, @as(i64, @atomic_xchg(&mut sh.x1, V10[k % V10.len])));
            slot.xsum +%= o;
            slot.xxor ^= o;
        }
        _ = @atomic_and(&mut sh.c8, V8[k % V8.len]);
        {
            let o = @atomic_and(&mut sh.c2, V2[k % V2.len]);
            if (o | 2147483648) != 2147483648 {
                slot.err += 1;
            }
        }
        {
            let v = MV[k % MV.len];
            sh.lock.lock();
            sh.m_sum +%= @as(u64, v);
            sh.m_b +%= @truncate(u8, v);
            sh.m_cnt += 1;
            sh.m_h +%= mix(0, @as(u64, v));
            sh.lock.unlock();
        }
    }
    slot.tl = TL;
    for round in @as(u64, 0)..16 {
        loop {
            let t = @atomic_load(&sh.turn, "acquire");
            if t == @truncate(u32, id) {
                break;
            }
            _ = @atomic_wait(&sh.turn, t, -1);
        }
        sh.tlog[sh.tn] = mix(round, @as(u64, id));
        sh.tn += 1;
        @atomic_store(&mut sh.turn, @truncate(u32, (id + 1) % 2), "seq_cst");
        _ = @atomic_notify(&sh.turn, 0xFFFF_FFFF);
