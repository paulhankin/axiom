struct Pf {
    out: []mut u32,
    sum: u64,
}

fn pf_body(ctx: *mut Pf, lo: usize, hi: usize) void {
    for i in lo..hi {
        let x = @truncate(u32, i *% 2654435761);
        ctx.out[i] = x;
        _ = @atomic_add(&mut ctx.sum, @as(u64, x));
    }
}

fn demo() !void {
    let mut sh = Shared.{ bar: sync.Barrier.init(2), lock: sync.Mutex.init(), c8: 2097153, k0: -570449776,
                          c3: 1281574705, q1: 0, c1: 18891, x0: 2147483646, q0: 925464446, c5: 3, k2: 2, c4: 13812,
                          k1: 32767, c6: 5017554719615772869, x1: 68, c2: 2147483648, c0: 1398026084,
                          c7: 2305843009213693952, x2: 32768, s0: sync.Atomic.[i32].init(1073741823),
                          s1: sync.Atomic.[i16].init(16384), turn: 0, tlog: [0; 32], tn: 0, m_sum: 0, m_b: 0, m_cnt: 0,
                          m_h: 0, slots: [Slot.{ b8: 0, tsum: 0, b16: 0, xsum: 0, b8b: 0, xxor: 0, err: 0, tl: 0 }; 2],
                          bytes: [0; 16], halves: [0; 16] };
    let mut ts: [2]thread.Thread.[Arg] = [
        thread.spawn(worker, Arg.{ sh: &mut sh, id: 0 })!, thread.spawn(worker, Arg.{ sh: &mut sh, id: 1 })!];
    for &mut t in ts {
        t.join();
    }
    let mut h: u64 = 0;
    h = h_usize(h, sh.c0);
    h = h_u16(h, sh.c1);
    h = h_u32(h, sh.c2);
    h = h_usize(h, sh.c3);
    h = h_i16(h, sh.c4);
    h = h_i8(h, sh.c5);
    h = h_i64(h, sh.c6);
    h = h_u64(h, sh.c7);
    h = h_i32(h, sh.c8);
    io.uint(h);  // expect: 4583998764582032875
    h = 0;
    let mut tsum: u64 = 0;
    for &s in sh.slots {
        tsum +%= s.tsum;
    }
    h = h_i32(h, sh.k0);
    h = h_i16(h, sh.k1);
    h = h_u64(h, sh.k2);
    h = mix(h, tsum);
    io.uint(h);  // expect: 16491364696159208318
    h = 0;
    let mut xsum: u64 = 0;
    let mut xxor: u64 = 0;
    for &s in sh.slots {
        xsum +%= s.xsum;
        xxor ^= s.xxor;
    }
    xsum +%= @as(u64, sh.x0);
    xxor ^= @as(u64, sh.x0);
    xsum +%= @bit_cast(u64, @as(i64, sh.x1));
    xxor ^= @bit_cast(u64, @as(i64, sh.x1));
    xsum +%= @bit_cast(u64, @as(i64, sh.x2));
    xxor ^= @bit_cast(u64, @as(i64, sh.x2));
    h = mix(mix(h, xsum), xxor);
    io.uint(h);  // expect: 1050342829768729714
    h = 0;
    h = h_i32(h, sh.q0);
    h = h_usize(h, sh.q1);
    io.uint(h);  // expect: 7358388815991883454
    h = 0;
    h = h_i32(h, sh.s0.load());
    h = h_i16(h, sh.s1.load());
    h = h_u64(h, sh.m_sum);
    h = h_u8(h, sh.m_b);
    h = h_u32(h, sh.m_cnt);
    h = h_u64(h, sh.m_h);
    io.uint(h);  // expect: 1057816372515497982
    h = 0;
    for &s in sh.slots {
        h = h_u8(h, s.b8);
        h = h_i16(h, s.b16);
        h = h_u8(h, s.b8b);
        h = h_u32(h, s.err);
        h = h_u64(h, s.tl);
    }
    for b in sh.bytes {
        h = h_u8(h, b);
    }
    for x in sh.halves {
        h = h_u16(h, x);
    }
    h = h_u64(h, TL);
    io.uint(h);  // expect: 7304646740669058860
    h = h_usize(0, sh.tn);
    for x in sh.tlog {
        h = h_u64(h, x);
    }
    io.uint(h);  // expect: 1166899568445779319
    let mut pf_out: [149]u32 = [0; 149];
    let mut pf = Pf.{ out: pf_out[..], sum: 0 };
    thread.parallel_for(149, 2, pf_body, &mut pf)!;
    h = h_u64(0, pf.sum);
    for x in pf_out {
        h = h_u32(h, x);
    }
    io.uint(h);  // expect: 13477969068499243507
}

export fn run() void {
    demo() catch @trap();
}
