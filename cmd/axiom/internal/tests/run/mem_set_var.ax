// @mem_set of lengths known only at run time (up to 32 bytes in overlapping
// stores, up to 256 on x86-64 a loop of vectors, beyond a string fill), at
// every offset in a 16-byte window, against a byte at a time fill; the
// mismatches (none), and a hash of the results.
import "../lib/io.ax" as io;

let mut buf: [800]u8 = [0; 800];
let mut want: [800]u8 = [0; 800];

// (recursive: not inlined, so n and the offset are not constants)
fn fill(d: usize, n: usize, c: u8, depth: u32) void {
    if depth > 0 {
        fill(d, n, c, depth - 1);
        return;
    }
    @mem_set(buf[d..d + n], c);
}

export fn run() void {
    let mut bad: u64 = 0;
    let mut h: u64 = 0;
    let ns: [14]usize = [0, 1, 7, 16, 32, 33, 47, 48, 100, 255, 256, 257, 300, 700];
    for n in ns {
        for d in @as(usize, 0)..16 {
            for i in 0..buf.len {
                buf[i] = @truncate(u8, i);
                want[i] = @truncate(u8, i);
            }
            let c = @truncate(u8, (n * 13) + d + 1);
            fill(40 + d, n, c, 2);
            for k in 0..n {
                want[40 + d + k] = c;
            }
            for i in 0..buf.len {
                bad += @as(u64, buf[i] != want[i]);
                h = (h *% 31) +% @as(u64, buf[i]);
            }
        }
    }
    io.uint(bad);  // expect: 0
    io.uint(h);    // expect: 3109757573429004544
}
