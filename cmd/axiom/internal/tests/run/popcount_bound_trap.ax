// The popcount of a 64-bit value with no known bound can be 64: indexing a
// [64]u8 with it keeps its bounds check.
// flags: -O2
// expect-trap
// expect: 1
import "../lib/io.ax" as io;

let mut X: u64 = 0;
let mut TBL: [64]u8 = [0; 64];

fn put(x: u64) void {
    TBL[@int_cast(usize, @popcount(x))] = 0x41;
}

export fn run() void {
    @atomic_store(&mut X, 0xFFFF_FFFF_FFFF_FFFF);
    io.uint(1);
    put(@atomic_load(&X));
}
