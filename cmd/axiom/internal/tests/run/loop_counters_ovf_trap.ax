// A checked step that overflows traps, though -O2 counts the counter in a
// register as wide as a pointer (loop_counters_ovf.ax): the program stops
// at the overflow, not past it.
// expect-trap
// flags: --overflow=trap
// expect: 0
import "../lib/io.ax" as io;

let mut XS: [64]i32 = [0; 64];
let mut ARGS: [2]i32 = [0; 2];

fn run_past(lo: i32, n: i32) i64 {
    let mut s: i64 = 0;
    let mut i = lo;
    let mut k: i32 = 0;
    while k < n {
        s += @as(i64, XS[@int_cast(usize, i & 63)]);
        i += 1;
        k += 1;
    }
    return s;
}

export fn run() void {
    ARGS = [2147483600, 100];
    io.int(0);
    io.int(run_past(ARGS[0], ARGS[1]));
}
