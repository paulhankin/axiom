// In the trap overflow mode, the wrapping operators and integer vectors
// still wrap; scalar + - * trap only on overflow.
// flags: --overflow=trap
import "../lib/io.ax" as io;

export fn run() void {
    let x: u8 = 250;
    io.int(@as(i64, x +% 10));  // expect: 4
    io.int(@as(i64, x - 200));  // expect: 50
    let m: i32 = @min_value(i32);
    io.int(@as(i64, -%m));      // expect: -2147483648
    io.int(@as(i64, m *% -1));  // expect: -2147483648
    let a = @vec(i32x4, 2147483647, 1, -5, -2147483648);
    let b = @vec(i32x4, 1, 2, 3, -1);
    let s = a + b;
    io.int(@as(i64, @extract_lane(s, 0)));  // expect: -2147483648
    io.int(@as(i64, @extract_lane(s, 3)));  // expect: 2147483647
    let p = a * b;
    io.int(@as(i64, @extract_lane(p, 3)));  // expect: -2147483648
    let n = -a;
    io.int(@as(i64, @extract_lane(n, 3)));  // expect: -2147483648
}
