// Constants of type f32 are rounded as f32 values: a decimal literal once,
// directly (not to f64 and then f32), an integer literal from its exact
// value, and each operation of an untyped expression that becomes f32 as
// an f32 operation, in consts, globals, locals, vectors and generic code.
import "../lib/io.ax" as io;

const K: f32 = 16777217.0;  // 2^24 + 1 is not an f32: 2^24
const D: f32 = K - 16777216.0;
const C: f32 = 16777216.0 + 1.0 + 1.0;  // two f32 additions: 2^24

// 1 + 2^-24 + about 2^-63, nearer 1 + 2^-23 than 1 (and 1 + 2^-24 in f64)
const X: f32 = 1.00000005960464477550;
let mut G: [2]f32 = [-1.00000005960464477550, 16777216.0 + 1.0 + 1.0];

fn scale[T: Float](x: T) T {
    return x * 1.00000005960464477550;
}

fn bits(x: f32) void {
    io.uint(@as(u64, @bit_cast(u32, x)));
}

export fn run() void {
    io.float(@as(f64, D));
    io.float(@as(f64, C));
    bits(X);
    bits(G[0]);
    io.float(@as(f64, G[1]));
    // 2^60 + 2^36 + 1, nearer 2^60 + 2^37 than 2^60 (and 2^60 + 2^36 in f64)
    let y: f32 = 1152921573326323713;
    bits(y);
    let v = @vec(f32x4, 1.00000005960464477550, 16777216.0 + 1.0 + 1.0, 0.0, 0.0);
    bits(@extract_lane(v, 0));
    io.float(@as(f64, @extract_lane(v, 1)));
    bits(scale(@as(f32, 1.0)));
}
