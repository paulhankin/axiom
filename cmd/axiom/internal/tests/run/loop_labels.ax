// Loop labels: `name: while|loop|for`, then `break name` and
// `continue name` (also after `catch`) leave or restart that loop from a
// nested one, running the defers of the loops left on the way.
import "../lib/io.ax" as io;

error { Empty }

fn find(grid: [][]u8, want: u8) i64 {
    let mut found: i64 = -1;
    rows: for r in 0..grid.len {
        for c in 0..grid[r].len {
            if grid[r][c] == want {
                found = @int_cast(i64, r * 10 + c);
                break rows;
            }
        }
    }
    return found;
}

fn first(s: []u8) !u8 {
    if s.len == 0 {
        return error.Empty;
    }
    return s[0];
}

export fn run() void {
    let g: [3][]u8 = ["abc", "def", "ghi"];
    io.int(find(g[..], 'e'));
    io.int(find(g[..], 'z'));
    // continue outer: the rest of the inner loop and of the outer body are skipped
    let mut n: i64 = 0;
    outer: for i in 0..@as(usize, 4) {
        for j in 0..@as(usize, 4) {
            if j > i {
                continue outer;
            }
            n += 1;
        }
        n += 100;
    }
    io.int(n);
    // the defers of every loop body left run, innermost first
    let mut log: i64 = 0;
    a: loop {
        defer log = log * 10 + 1;
        loop {
            defer log = log * 10 + 2;
            loop {
                defer log = log * 10 + 3;
                break a;
            }
        }
    }
    io.int(log);
    // catch break label
    let words: [3][]u8 = ["x", "", "y"];
    let mut seen: i64 = 0;
    scan: for w in words {
        for _k in 0..@as(usize, 2) {
            let c = first(w) catch break scan;
            seen = seen * 10 + @as(i64, c - 'w');
        }
    }
    io.int(seen);
    // an inner loop may reuse a label: the name then means the inner loop
    let mut m: i64 = 0;
    lp: while m < 3 {
        m += 1;
        lp: loop {
            m += 10;
            break lp;
        }
    }
    io.int(m);
}
// expect: 11
// expect: -1
// expect: 110
// expect: 321
// expect: 11
// expect: 11
