// With --overflow=trap a checked step cannot have overflowed where its
// result is used: -O2 counts such an i32 counter in a register as wide as a
// pointer. Near the end of the type, without overflowing, the results are
// the same (loop_counters_ovf_trap.ax: one that does overflow traps).
// flags: --overflow=trap
import "../lib/io.ax" as io;

let mut XS: [64]i32 = [0; 64];
let mut ARGS: [4]i32 = [0; 4];

fn up_to(lo: i32, hi: i32) i64 {
    let mut s: i64 = 0;
    let mut i = lo;
    while i < hi {
        s += @as(i64, XS[@int_cast(usize, i - lo)]) * @as(i64, i & 3);
        i += 1;
    }
    return s;
}

fn down_from(hi: i32, lo: i32) i64 {
    let mut s: i64 = 0;
    let mut i = hi;
    while i > lo {
        s += @as(i64, XS[@int_cast(usize, hi - i)]) + @as(i64, i & 1);
        i -= 2;
    }
    return s;
}

export fn run() void {
    for i in @as(usize, 0)..64 {
        XS[i] = (@int_cast(i32, i) * 37 % 101) - 50;
    }
    ARGS = [2147483647, 40, -2147483647 - 1, 0];
    io.int(0);  // expect: 0
    let max = ARGS[0];
    io.int(up_to(max - ARGS[1], max));              // expect: 25
    io.int(down_from(ARGS[2] + ARGS[1], ARGS[2]));  // expect: 31
    io.int(up_to(ARGS[3], ARGS[3]));                // expect: 0
}
