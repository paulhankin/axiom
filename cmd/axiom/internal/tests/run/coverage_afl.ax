// --coverage=afl (spec §16.9): an instrumented program runs as usual outside
// of a fuzzer, its counters going to the runtime's own map.
// native-only
// linux-only
// selfhost-only: the bootstrap compiler has no --coverage
// flags: --coverage=afl
import "../lib/io.ax" as io;

fn collatz(n0: u64) u64 {
    let mut n = n0;
    let mut steps: u64 = 0;
    while n != 1 {
        if (n % 2) == 0 {
            n /= 2;
        } else {
            n = (3 * n) + 1;
        }
        steps += 1;
    }
    return steps;
}

fn kind(c: u8) i64 {
    if (c >= 'a') and (c <= 'z') {
        return 1;
    }
    match c {
        '0'  => { return 2; }
        ' '  => { return 0; }
        else => { return 3; }
    }
}

export fn run() void {
    io.uint(collatz(27));  // expect: 111
    let mut sum: i64 = 0;
    for c in "ab1 Z" {
        sum += kind(c);
    }
    io.int(sum);  // expect: 8
}
