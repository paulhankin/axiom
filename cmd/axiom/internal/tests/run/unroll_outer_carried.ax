// The trip count of a loop is counted by stepping its counter through
// constants. A value of the enclosing loop that is the counter as it was
// when the inner loop last ended (`p`) is not one of them: the inner loop
// runs once the first time and twice after that, and must not be unrolled to
// the first count.
import "../lib/io.ax" as io;

fn run_loops(outer_n: u32) u64 {
    let mut p: u32 = 0;
    let mut total: u32 = 0;
    let mut o: u32 = 0;
    while o < outer_n {
        let mut i: u32 = 0;
        while i < 2 {
            total += 1;
            i = i + 2 - (p >> 1);
        }
        p = i;
        o += 1;
    }
    return @as(u64, total);
}

let mut fp: fn(u32) u64 = run_loops;

export fn run() void {
    io.uint(run_loops(3));
    io.uint(fp(3));
    io.uint(fp(1));
}

// expect: 5
// expect: 5
// expect: 1
