// A chain of 200 by-value method calls. Each call keeps its receiver in more
// than one place in the tree; a walk that followed all of them took time
// exponential in the chain's length.
import "../lib/io.ax" as io;

struct C {
    n: i32,

    fn inc(self: C) C {
        return C.{ n: self.n + 1 };
    }
}

export fn run() void {
    let c = C.{ n: 0 };
    let d =
        c.inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc();
    io.int(@as(i64, d.n));  // expect: 200
    io.int(@as(i64,
               c.inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().inc().n));  // expect: 30
}
