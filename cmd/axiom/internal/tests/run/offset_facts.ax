// Facts from k - x <= hi about x (x >= k - hi, when x is bounded and the
// subtraction cannot overflow), and comparisons of x - d with a constant
// decided by them: the @int_cast check of 23 - top_bit(m) after
// top_bit(m) <= 23 goes, the comparisons of unbounded or wrapping values
// stay. The results are LLVM's.
import "../lib/io.ax" as io;

inline fn top_bit(mask: u32) i32 {
    return 31 - @int_cast(i32, @clz(mask));
}

fn shots(val: u32, rel: u32, b: u32) i64 {
    if val != 0 {
        let k = top_bit(val);
        if (k <= 23) and (((b >> @int_cast(u32, 23 - k)) & rel) != 0) {
            return @as(i64, k) + 1;
        }
        return @as(i64, k) - 40;
    }
    return 7;
}

// x in [0, 63]: 40 - x < 30 gives x >= 11
fn bounded(y: u32) i64 {
    let x = @bit_cast(i32, y & 63);
    let mut r: i64 = 0;
    if (40 - x) < 30 {
        if (x - 11) >= 0 {
            r += 1;
        }
        if (x - 11) > 0 {
            r += 2;
        }
        if (x - 12) >= 0 {
            r += 4;
        }
        if (x - 5) <= 5 {
            r += 8;
        }
        if (x - 5) < 6 {
            r += 16;
        }
        if (x - 3) >= 9 {
            r += 32;
        }
    }
    return r;
}

// x unbounded (wrapping arithmetic): nothing follows
fn wrapping(y: u32) i64 {
    let x = @bit_cast(i32, y);
    let mut r: i64 = 0;
    if (10 -% x) <= 3 {
        if (x -% 7) >= 0 {
            r += 1;
        }
        if (x -% 7) < 0 {
            r += 2;
        }
    }
    return r;
}

export fn run() void {
    let mut s: i64 = 0;
    let mut h: u32 = 12345;
    for i in @as(u32, 0)..4000 {
        h = (h *% 1103515245) +% 12345;
        let v = (h >> (i % 31)) & 0xff_ffff;
        s = (s *% 31) +% shots(v, h >> 7, h ^ (h >> 13));
    }
    io.int(s);
    s = 0;
    for y in @as(u32, 0)..70 {
        s = (s *% 67) +% bounded(y);
    }
    io.int(s);
    s = 0;
    let probes: [10]u32 = [0, 6, 7, 8, 9, 10, 0x8000_0005, 0x8000_0010, 0x7fff_fffe, 0xffff_fff0];
    for k in @as(usize, 0)..10 {
        s = (s *% 5) +% wrapping(probes[k]);
    }
    io.int(s);
}

// expect: -7371909008685676653
// expect: -3464040785007097119
// expect: 97630
