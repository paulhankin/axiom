// A copy of slot Y into slot X at the same offset lets them share their
// bytes (cmd/axiom/src/slots.ax), but not once Y's address has escaped: a
// call that writes through the kept address would change X too.
// flags: -O1
import "../lib/io.ax" as io;

struct Big {
    a: [12]u64,
    n: u64,
}

let mut kept: *mut Big = @ptr_from_int(*mut Big, 8);

// (recursive: not inlined) Keeps the address it is given.
fn keep(b: *mut Big, d: u32) void {
    if d > 0 {
        keep(b, d - 1);
        return;
    }
    kept = b;
}

// Writes through the kept address.
fn bump(d: u32) void {
    if d > 0 {
        bump(d - 1);
        return;
    }
    kept.n += 100;
}

fn sum(b: Big, d: u32) u64 {
    if d > 0 {
        return sum(b, d - 1);
    }
    return b.n + b.a[3];
}

fn copied(k: u64) u64 {
    let mut y = Big.{ a: [0; 12], n: k };
    kp(&mut y, 1);
    let x = y;  // a copy, then y changes through the kept address
    bp(1);
    return sp(x, 1);
}

let mut kp: fn(*mut Big, u32) void = keep;
let mut bp: fn(u32) void = bump;
let mut sp: fn(Big, u32) u64 = sum;

export fn run() void {
    let fs = [copied, copied];
    io.uint(fs[1](5));  // expect: 5
}
