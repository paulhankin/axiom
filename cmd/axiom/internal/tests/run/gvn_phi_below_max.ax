// A loop phi holds the value its back edge had in the previous iteration:
// the facts known where the phi is used hold for this iteration's values
// (gvn below_max, deciding `i <= MAX - 15` from `v < 100` where the phi i
// is the previous v).
// flags: -O1
import "../lib/io.ax" as io;

fn last_small(xs: []u64) u64 {
    let mut i: u64 = 0;
    for k in 0..xs.len {
        let v = xs[k];
        if v < 100 {
            if i <= 0xFFFF_FFFF_FFFF_FFF0 {
                io.int(1);
            } else {
                io.int(1000);
            }
        }
        i = v;
    }
    return i;
}

let mut F: fn([]u64) u64 = last_small;
let mut XS: [3]u64 = [3, 0xFFFF_FFFF_FFFF_FFFF, 5];

export fn run() void {
    io.uint(F(XS[..]));
}
// expect: 1
// expect: 1000
// expect: 5
