// `(x & m) | (y & ~m)` is a blend, one instruction with AVX-512, which reads
// x, y and m and leaves the two `and`s out. When another instruction reads
// one of the `and`s too they are computed as usual, and the other `and` may
// take its operand, a load, straight from memory: the blend, reading that
// load's register, read one that was never written.
import "../lib/io.ax" as io;

let mut H: u64 = 1469598103934665603;
let mut BUF: [128]u8 = [0; 128];

fn mix(x: u64) void {
    H = (H ^ x) *% 1099511628211;
}

fn g(a: *mut [104]u8, x: u8, y: u8) void {
    let mut mi: u8 = 0;
    if y != x {
        mi = 255;
    }
    let m: u8x16 = @splat(mi);
    let sa = @slice_from_ptr(@ptr_cast(*mut u8, a), 104);
    let v1 = @load(u8x16, sa[44..]);
    let v2 = @load(u8x16, sa[60..]);
    let xm = @as(u8x16, @splat(x)) & m;
    @store(sa[2..], xm | (v1 & ~m));
    @store(sa[20..], xm | (v2 & ~m));
}

let mut GP: fn(*mut [104]u8, u8, u8) void = g;

export fn run() void {
    let mut r: u64 = 5;
    for it in @as(usize, 0)..40 {
        for k in @as(usize, 0)..128 {
            r = (r *% 6364136223846793005) +% 1442695040888963407;
            BUF[k] = @truncate(u8, r >> 33);
        }
        let x = BUF[16];
        let mut y = BUF[14];
        if (it % 2) == 0 {
            y = x;
        }
        GP(@ptr_cast(*mut [104]u8, &mut BUF[1]), x, y);
        for k in @as(usize, 0)..128 {
            mix(@as(u64, BUF[k]));
        }
    }
    io.uint(H);
}

// expect: 14568287874649998768
