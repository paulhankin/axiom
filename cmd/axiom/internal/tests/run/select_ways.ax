// Branches on loaded data whose two ways each store to the same address
// (a merge step), which -O2 turns into selects and one store: the results
// must be those of the branches, and a check on a way that the test before
// does not decide must still trap.
import "../lib/io.ax" as io;
import "std/mem" as mem;

fn merge(xs: []u64, mid: usize, out: []mut u64) void {
    let n = xs.len;
    let mut a: usize = 0;
    let mut b = mid;
    let mut k: usize = 0;
    while k < n {
        if (a < mid) and ((b >= n) or (xs[a] <= xs[b])) {
            out[k] = xs[a];
            a += 1;
        } else {
            out[k] = xs[b];
            b += 1;
        }
        k += 1;
    }
}

// the ways store to different places: kept as branches
fn split(xs: []i32, lo: []mut i32, hi: []mut i32) u64 {
    let mut nl: usize = 0;
    let mut nh: usize = 0;
    for i in 0..xs.len {
        if xs[i] < 0 {
            lo[nl] = xs[i];
            nl += 1;
        } else {
            hi[nh] = xs[i];
            nh += 1;
        }
    }
    return (@as(u64, nl) * 1000) + @as(u64, nh);
}

// a way that loads what the test did not: kept
fn pick(xs: []u32, ys: []u32, out: []mut u32) u64 {
    let mut s: u64 = 0;
    for i in 0..xs.len {
        if xs[i] > 7 {
            out[i] = ys[i];
        } else {
            out[i] = xs[i] *% 3;
        }
        s +%= @as(u64, out[i]);
    }
    return s;
}

// floats compared, doubles stored
fn clamp_into(xs: []f64, lim: []f64, out: []mut f64) f64 {
    let mut s: f64 = 0.0;
    for i in 0..xs.len {
        if xs[i] > lim[i] {
            out[i] = lim[i];
        } else {
            out[i] = xs[i];
        }
        s += out[i];
    }
    return s;
}

// ways computing with @min / @max (intrinsics, whose operands are a list)
fn limits(xs: []i32, out: []mut i32) i64 {
    let mut s: i64 = 0;
    for i in 0..xs.len {
        if xs[i] > 5 {
            out[i] = @max(xs[i] - 9, 1);
        } else {
            out[i] = @min(xs[i] + 2, 4);
        }
        s += @as(i64, out[i]) * @as(i64, @int_cast(i32, i) + 1);
    }
    return s;
}

export fn run() void {
    let n: usize = 1000;
    let xs = mem.alloc.[u64](n) catch return;
    let out = mem.alloc.[u64](n) catch return;
    let mut s: u64 = 88172645463325252;
    for i in 0..n {
        s ^= s << 13;
        s ^= s >> 7;
        s ^= s << 17;
        xs[i] = s % 100000;
    }
    // two sorted halves
    for i in @as(usize, 1)..500 {
        let mut j = i;
        while (j > 0) and (xs[j - 1] > xs[j]) {
            let t = xs[j];
            xs[j] = xs[j - 1];
            xs[j - 1] = t;
            j -= 1;
        }
    }
    for i in 501..n {
        let mut j = i;
        while (j > 500) and (xs[j - 1] > xs[j]) {
            let t = xs[j];
            xs[j] = xs[j - 1];
            xs[j - 1] = t;
            j -= 1;
        }
    }
    merge(xs, 500, out);
    let mut ok = true;
    let mut h: u64 = 0;
    for i in 0..n {
        if (i > 0) and (out[i - 1] > out[i]) {
            ok = false;
        }
        h = (h *% 31) +% out[i];
    }
    io.boolean(ok);  // expect: true
    io.uint(h);      // expect: 8193903687016887151
    let vs = mem.alloc.[i32](64) catch return;
    let lo = mem.alloc.[i32](64) catch return;
    let hi = mem.alloc.[i32](64) catch return;
    for i in 0..vs.len {
        vs[i] = @int_cast(i32, (i *% 37) % 23) - 11;
    }
    io.uint(split(vs, lo, hi));  // expect: 31033
    io.int(limits(vs, lo));      // expect: -1462
    let ua = mem.alloc.[u32](50) catch return;
    let ub = mem.alloc.[u32](50) catch return;
    let uo = mem.alloc.[u32](50) catch return;
    for i in 0..ua.len {
        ua[i] = @as(u32, @truncate(u32, i)) % 13;
        ub[i] = @as(u32, @truncate(u32, i)) *% 1000;
    }
    io.uint(pick(ua, ub, uo));  // expect: 489336
    let fa = mem.alloc.[f64](40) catch return;
    let fl = mem.alloc.[f64](40) catch return;
    let fo = mem.alloc.[f64](40) catch return;
    for i in 0..fa.len {
        fa[i] = @float_from_int(f64, (i * 7) % 11) * 0.5;
        fl[i] = @float_from_int(f64, (i * 3) % 5);
    }
    io.float(clamp_into(fa, fl, fo));  // expect: 56
    // the merge's out too short: its bounds check traps
    // expect-trap
    let short = mem.alloc.[u64](n - 1) catch return;
    merge(xs, 500, short);
}
