// @mem_copy of overlapping slices of constant lengths (copies of up to 256
// bytes, 256 to 2048, beyond), the destination below, above, on or apart
// from the source; a hash of the results.
import "../lib/io.ax" as io;

let mut buf: [6000]u8 = [0; 6000];

fn fill() void {
    for i in 0..buf.len {
        buf[i] = @truncate(u8, (i * 7) + (i >> 5));
    }
}

fn sum() u64 {
    let mut s: u64 = 0;
    for i in 0..buf.len {
        s = (s *% 31) +% @as(u64, buf[i]);
    }
    return s;
}

// the destination d bytes above the source (0: the source itself), or below
fn copy_up(n: usize, d: usize) void {
    if n == 40 {
        @mem_copy(buf[100 + d..100 + d + 40], buf[100..100 + 40]);
    }
    if n == 256 {
        @mem_copy(buf[100 + d..100 + d + 256], buf[100..100 + 256]);
    }
    if n == 300 {
        @mem_copy(buf[100 + d..100 + d + 300], buf[100..100 + 300]);
    }
    if n == 1000 {
        @mem_copy(buf[100 + d..100 + d + 1000], buf[100..100 + 1000]);
    }
    if n == 2048 {
        @mem_copy(buf[100 + d..100 + d + 2048], buf[100..100 + 2048]);
    }
    if n == 2100 {
        @mem_copy(buf[100 + d..100 + d + 2100], buf[100..100 + 2100]);
    }
}

fn copy_down(n: usize, d: usize) void {
    if n == 40 {
        @mem_copy(buf[100..100 + 40], buf[100 + d..100 + d + 40]);
    }
    if n == 256 {
        @mem_copy(buf[100..100 + 256], buf[100 + d..100 + d + 256]);
    }
    if n == 300 {
        @mem_copy(buf[100..100 + 300], buf[100 + d..100 + d + 300]);
    }
    if n == 1000 {
        @mem_copy(buf[100..100 + 1000], buf[100 + d..100 + d + 1000]);
    }
    if n == 2048 {
        @mem_copy(buf[100..100 + 2048], buf[100 + d..100 + d + 2048]);
    }
    if n == 2100 {
        @mem_copy(buf[100..100 + 2100], buf[100 + d..100 + d + 2100]);
    }
}

fn case(n: usize) void {
    let ds: [7]usize = [0, 1, 8, 31, n / 2, n, n + 3];
    let mut h: u64 = 0;
    for d in ds {
        fill();
        copy_up(n, d);
        h = (h *% 1000003) +% sum();
        fill();
        copy_down(n, d);
        h = (h *% 1000003) +% sum();
    }
    io.uint(h);
}

export fn run() void {
    case(40);    // expect: 149856109229945164
    case(256);   // expect: 18101245494924537152
    case(300);   // expect: 13453925664157532972
    case(1000);  // expect: 18012601857312320244
    case(2048);  // expect: 18412811419351709408
    case(2100);  // expect: 6261327924830530992
}
