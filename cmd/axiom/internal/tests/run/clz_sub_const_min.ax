// x86-64: k - @clz(x) of 64 bits, where k is a constant near the bottom of
// i64, is not made bsr(x) + (k - 63) (the difference does not fit 32 bits),
// and the test of that no longer overflows in the compiler, which trapped
// (T0002 in clz_user). Found by exact_size64's random expressions.
import "../lib/io.ax" as io;

let mut X: [3]i64 = [1, -1, 0x123456789];

fn f(x: i64) i64 {
    return -9223372036854775808 -% @clz(x);
}

fn g(x: i32) i32 {
    return 2147483647 +% @clz(x);
}

export fn run() void {
    for i in @as(usize, 0)..3 {
        io.int(f(X[i]));
        io.int(@as(i64, g(@truncate(i32, X[i]))));
    }
}
// expect: 9223372036854775745
// expect: -2147483618
// expect: -9223372036854775808
// expect: 2147483647
// expect: 9223372036854775777
// expect: -2147483647
