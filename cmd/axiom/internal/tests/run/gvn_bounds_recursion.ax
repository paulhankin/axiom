// A loop whose conditions are of the form k - x < c on a loop phi: value
// numbering's bounds of k - x asked for bounds that, through the phi's
// edges, asked for the same again, without end (the compiler ran out of
// stack or memory at -O2).
import "../lib/io.ax" as io;

fn sel_i8(c: bool, a: i8, b: i8) i8 {
    if c {
        return a;
    }
    return b;
}
fn dv_i8(a: i8, b: i8) i8 {
    if b == 0 {
        return a;
    }
    return a / b;
}
fn f9(a: i8, b: i8, c: i8) void {
    let mut x: i8 = a;
    let mut y: i8 = b;
    let mut z: i8 = c;
    let mut arr: [8]i8 = [@as(i8, -90), @as(i8, 32), @as(i8, 63), @as(i8, 31), @as(i8, 3), @as(i8, -3), @as(i8, 0),
                          @as(i8, 31)];
    for i3 in 0..@as(usize, 8) {
        for i2 in 0..@as(usize, 7) {
            if (x ^ (y *% @min_value(i8))) != dv_i8(dv_i8(x, z), (@as(i8, 64) | x)) {
                x = (sel_i8((x & @as(i8, 64)) > (x & x), (x *% @as(i8, 127)), @as(i8, 63)) << @as(u32, 65));
            } else {
                x = y;
            }
            if (-%(@as(i8, 17) & x)) < @bit_cast(i8, @bit_cast(u8, (@as(i8, 0) | @as(i8, 1))) / @as(u8, 7)) {
                y = dv_i8(y, (dv_i8(@as(i8, 126), y) -% (y & x)));
            } else {}
        }
    }
    for e in arr {
        io.int(@as(i64, e));
    }
}
// (the array is never changed)
// expect: -90
// expect: 32
// expect: 63
// expect: 31
// expect: 3
// expect: -3
// expect: 0
// expect: 31
export fn run() void {
    f9(@as(i8, -33), @as(i8, -3), @as(i8, 32));
}
