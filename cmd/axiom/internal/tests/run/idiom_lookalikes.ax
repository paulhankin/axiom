// Valid programs that look like the idioms of other languages the parser
// names (spec §16.3, E0160 ... E0179) mean what they say: two comparisons
// as arguments, not generic arguments in angle brackets; `a - -b`; a label
// at the start of a block after a condition, not a struct literal.
import "../lib/io.ax" as io;

fn both(x: bool, y: bool) i64 {
    if x and y {
        return 1;
    }
    return 0;
}

fn sum_to(n: i64) i64 {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    if n > 0 {
        outer: loop {
            if i >= n {
                break outer;
            }
            i += 1;
            s += i;
        }
    }
    return s;
}

export fn run() void {
    let a: i64 = 1;
    let b: i64 = 2;
    let c: i64 = 4;
    let d: i64 = 3;
    io.int(both(a < b, c > (d)));  // expect: 1
    io.int(a - -b);                // expect: 3
    io.int(sum_to(4));             // expect: 10
}
