// errdefer runs only when the function returns an error: by `!`, by
// `catch return`, or by a `return` whose value is an error (decided at run
// time); not on success, break or continue. It interleaves with defer in
// reverse order of registration.
import "../lib/io.ax" as io;

error { Bad, Worse }

let mut log: i64 = 0;

fn note(d: i64) void {
    log = log * 10 + d;
}

fn step(fail: bool) !i64 {
    if fail {
        return error.Bad;
    }
    return 7;
}

// 1 and 2 are registered, then the second step may fail: on failure the
// errdefer (2) and the defer (1) run, innermost first; on success only 1.
fn two_steps(fail: bool) !i64 {
    defer note(1);
    let a = step(false)!;
    errdefer note(2);
    let b = step(fail)!;
    return a + b;
}

fn via_catch(fail: bool) !i64 {
    errdefer note(3);
    let v = step(fail) catch return error.Worse;
    return v;
}

fn via_return(code: i64) !i64 {
    errdefer note(4);
    if code == 0 {
        return 1;
    }
    if code == 1 {
        return error.Bad;
    }
    let r: !i64 = error.Worse;
    return r;  // an error union value: whether it is an error is decided at run time
}

fn code_of(e: error) i64 {
    if e == error.Worse {
        return -2;
    }
    return -1;
}

fn in_loop() !i64 {
    let mut n: i64 = 0;
    for i in 0..@as(usize, 3) {
        errdefer note(5);  // never: break and continue are not error returns
        if i == 1 {
            continue;
        }
        if i == 2 {
            break;
        }
        n += 1;
    }
    errdefer note(6);
    return n;
}

export fn run() void {
    log = 0;
    io.int(two_steps(false) catch -1);
    io.int(log);
    log = 0;
    io.int(two_steps(true) catch -1);
    io.int(log);
    log = 0;
    io.int(via_catch(true) catch |e| code_of(e));
    io.int(log);
    log = 0;
    io.int(via_return(0) catch -1);
    io.int(via_return(1) catch -1);
    io.int(via_return(2) catch -1);
    io.int(log);
    log = 0;
    io.int(in_loop() catch -1);
    io.int(log);
}
// expect: 14
// expect: 1
// expect: -1
// expect: 21
// expect: -2
// expect: 3
// expect: 1
// expect: -1
// expect: -1
// expect: 44
// expect: 1
// expect: 0
