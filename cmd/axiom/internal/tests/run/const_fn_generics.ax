// const function generic parameters (spec §10.2, §10.3, §10.5, §10.6).
import "../lib/const_fn_helper.ax" as helper;
import "../lib/io.ax" as io;

fn add_i32(a: i32, b: i32) i32 {
    return a + b;
}

inline fn sub_i32(a: i32, b: i32) i32 {
    return a - b;
}

fn scale_n[T: Int, const N: i32](x: T) T {
    return x * @int_cast(T, N);
}

struct LocalOps {
    pub fn max2(a: i32, b: i32) i32 {
        if a > b {
            return a;
        }
        return b;
    }
}

struct Box[T] {
    v: T,

    pub fn pick_left(a: T, _b: T) T {
        return a;
    }
}

struct Fold[T, const STEP: fn(T, T) T] {
    acc: T,

    pub fn init(start: T) Self {
        return Self.{ acc: start };
    }

    pub fn push(self: *mut Self, x: T) void {
        self.acc = STEP(self.acc, x);
    }

    pub fn apply_indirect(self: *Self, x: T) T {
        let f: fn(T, T) T = STEP;
        return f(self.acc, x);
    }

    pub fn forward[const EXTRA: fn(T) T](self: *Self) T {
        return STEP(self.acc, EXTRA(self.acc));
    }
}

fn apply2[T, const F: fn(T, T) T](a: T, b: T) T {
    return F(a, b);
}

fn nested_apply[T: Num, const F: fn(T, T) T](a: T, b: T) T {
    return apply2.[T, F](a, b) + apply2.[T, F](b, a);
}

fn apply_unary[T, const U: fn(T) T](x: T) T {
    return U(x);
}

fn hash_i32_test(x: i32) u64 {
    return @bit_cast(u64, @as(i64, x)) *% 0x9E37_79B9_7F4A_7C15;
}

struct PairSlot[K, V, const HASH: fn(K) u64, const EQ: fn(K, K) bool] {
    key: K,
    val: V,

    pub fn matches(self: *Self, k: K, want_hash: u64) bool {
        return (HASH(self.key) == want_hash) and EQ(self.key, k);
    }
}

export fn run() void {
    io.int(@as(i64, apply2.[i32, add_i32](10, 5)));                // expect: 15
    io.int(@as(i64, apply2.[i32, sub_i32](10, 5)));                // expect: 5
    io.int(@as(i64, apply2.[i32, helper.mul_add](3, 4)));          // expect: 13
    io.int(@as(i64, apply2.[i32, LocalOps.max2](7, 11)));          // expect: 11
    io.int(@as(i64, apply2.[i32, helper.Ops.combine](2, 9)));      // expect: 29
    io.int(@as(i64, apply2.[i32, Box.[i32].pick_left](4, 9)));     // expect: 4
    io.int(@as(i64, nested_apply.[i32, add_i32](6, 8)));           // expect: 28
    io.int(@as(i64, apply_unary.[i32, scale_n.[i32, 3]](9)));      // expect: 27
    io.int(@as(i64, apply_unary.[i32, helper.Ops.id.[i32]](42)));  // expect: 42

    let mut f = Fold.[i32, add_i32].init(10);
    f.push(7);
    io.int(@as(i64, f.acc));                           // expect: 17
    io.int(@as(i64, f.apply_indirect(3)));             // expect: 20
    io.int(@as(i64, f.forward.[scale_n.[i32, 2]]()));  // expect: 51

    let ps = PairSlot.[i32, i32, hash_i32_test, helper.eq_i32].{ key: 77, val: 99 };
    if ps.matches(77, hash_i32_test(77)) {
        io.int(1);  // expect: 1
    } else {
        io.int(0);
    }
    if ps.matches(78, hash_i32_test(77)) {
        io.int(1);
    } else {
        io.int(0);  // expect: 0
    }
}
