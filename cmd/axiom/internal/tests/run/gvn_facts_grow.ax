// Sorting through a function pointer at -O2: proving bounds in the sort's
// loops pushes facts while an earlier one is read, which once read it
// through a pointer the growing table had freed (and crashed the compiler).
// flags: -O2
// expect: 1
// expect: 9
import "../lib/io.ax" as io;
import "std/collections/vec" as vec;

fn less(a: f64, b: f64) bool {
    return a < b;
}

fn sort(xs: []mut f64) void {
    vec.sort(xs, less);
}

export fn run() void {
    let mut xs: [9]f64 = [5.0, 3.0, 9.0, 1.0, 7.0, 2.0, 8.0, 4.0, 6.0];
    sort(xs[..]);
    io.uint(@int_from_float(u64, xs[0]));
    io.uint(@int_from_float(u64, xs[8]));
}
