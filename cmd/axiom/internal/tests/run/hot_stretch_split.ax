// A loop pushing onto a Vec at -O2, its grow path (the allocator, with calls
// and loops of its own) inlined: the register allocator holds the loop's
// values in registers through the hot stretch and in memory on the grow
// path, reloading them where it rejoins and storing those the stretch
// changes where it is left. In one loop (one push, so that it is inlined):
// a value changed on one side of a branch only, a value changed only on a
// seldom-taken path of the loop's own that calls out, exits from the middle
// of the stretch (break and return), and an outer loop whose values live
// through it.
// flags: -O2
// expect: 1545563009757329608
// expect: 18110364525293898617
import "../lib/io.ax" as io;
import "std/collections/vec" as vec;

let mut N: u64 = 3000;
let mut STOP: u64 = 2900;

fn note(a: u64, b: u64) u64 {
    return (a *% 31) ^ b;
}

let mut NOTE: fn(u64, u64) u64 = note;

fn fill(v: *mut vec.Vec.[u64], rounds: u64, n: u64, seed: u64, stop: u64) u64 {
    let mut t: u64 = seed;
    for r in 0..rounds {
        let mut x = t ^ r;
        let mut y: u64 = 7;
        let mut z: u64 = 3;
        for i in 0..n {
            x = (x *% 6364136223846793005) +% 1442695040888963407;
            if (x & 4) != 0 {
                y = x ^ i;
            }
            if (x >> 58) == 0 {
                z = NOTE(z, x);
            }
            if i == stop {
                break;
            }
            if (x >> 52) == 0xabc {
                return y ^ z ^ t;
            }
            v.push(x ^ y ^ z ^ t) catch return 0;
        }
        t = (t *% 1099511628211) ^ y ^ (z << 1) ^ @as(u64, v.len());
    }
    return t;
}

fn hash(v: *vec.Vec.[u64], h0: u64) u64 {
    let mut h = h0;
    for k in 0..v.len() {
        h = (h ^ v.get(k)) *% 1099511628211;
    }
    return h;
}

export fn run() void {
    for s in @as(u64, 1)..3 {
        let mut a = vec.Vec.[u64].init();
        let r = fill(&mut a, 3, N, s, STOP + s);
        io.uint(hash(&a, r));
        a.deinit();
    }
}
