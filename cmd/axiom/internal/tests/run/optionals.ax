// Optional type ?T: niche optimization, .none, .some, ??, match, if let, ??T, globals, generics.
import "../lib/io.ax" as io;

error Fail { Bad }

struct Boxed {
    a: u64,
    b: u64,
}

let g_ptr: ?*i32 = .none;
let g_val: ?i32 = 77;
let g_bool_none: ?bool = .none;
let g_bool_true: ?bool = true;

fn unwrap_or[T](x: ?T, dflt: T) T {
    return x ?? dflt;
}

fn find_pos(xs: []i32, want: i32) ?usize {
    for i in 0..xs.len {
        if xs[i] == want {
            return .some(i);
        }
    }
    return .none;
}

fn ret_check(x: ?i32) i32 {
    let v = x ?? return -1;
    return v + 10;
}

fn may_err_opt(ok: bool) Fail!?i32 {
    if not ok {
        return .none;
    }
    return .some(55);
}

fn helper(x: i32) i32 {
    return x * 2;
}

export fn run() void {
    // Niche sizes
    io.boolean(@size_of(?*i32) == @size_of(usize));             // expect: true
    io.boolean(@size_of(?*mut u8) == @size_of(usize));          // expect: true
    io.boolean(@size_of(?fn(i32) i32) == @size_of(usize));      // expect: true
    io.boolean(@size_of(?bool) == 1);                           // expect: true
    io.boolean(@size_of(?[]u8) == (2 * @size_of(usize)));       // expect: true
    io.boolean(@size_of(?[]mut i32) == (2 * @size_of(usize)));  // expect: true

    // Globals
    io.int(@as(i64, g_val ?? 0));  // expect: 77
    let mut ptr_is_none = false;
    if let .none = g_ptr {
        ptr_is_none = true;
    }
    io.boolean(ptr_is_none);           // expect: true
    io.boolean(g_bool_none ?? false);  // expect: false
    io.boolean(g_bool_true ?? false);  // expect: true

    // ?*T and ?*mut T (with mutability weakening)
    let mut n: i32 = 9;
    let mp: ?*mut i32 = &mut n;
    let ip: ?*i32 = mp;
    if let .some(p) = ip {
        io.int(@as(i64, p.*));  // expect: 9
    }

    // ?fn(...)
    let mf: ?fn(i32) i32 = helper;
    let f = mf ?? return;
    io.int(@as(i64, f(21)));  // expect: 42

    // ?bool three states: false, true, .none
    let bf: ?bool = false;
    let bt: ?bool = true;
    let bn: ?bool = .none;
    io.boolean(bf ?? true);   // expect: false
    io.boolean(bt ?? false);  // expect: true
    io.boolean(bn ?? true);   // expect: true

    // ?Boxed, ?? generics, implicit T -> ?T
    let b1: ?Boxed = Boxed.{ a: 3, b: 4 };
    let b2: ?Boxed = .none;
    let r1 = unwrap_or(b1, Boxed.{ a: 0, b: 0 });
    let r2 = unwrap_or(b2, Boxed.{ a: 5, b: 6 });
    io.uint(r1.a + r1.b + r2.a + r2.b);  // expect: 18

    // ?? with return, break, continue, block
    io.int(@as(i64, ret_check(.none)));  // expect: -1
    io.int(@as(i64, ret_check(15)));     // expect: 25

    let arr: [3]i32 = [4, 8, 12];
    let idx = find_pos(arr[..], 8) ?? {
        @trap();
    };
    io.uint(@as(u64, idx));  // expect: 1

    let opts: [4]?i32 = [.some(1), .none, .some(2), .none];
    let mut sum: i32 = 0;
    for o in opts {
        let v = o ?? continue;
        sum += v;
    }
    io.int(@as(i64, sum));  // expect: 3

    // Nested ??T preserves distinctness between .none and .some(.none)
    let outer_none: ??i32 = .none;
    let outer_some_none: ??i32 = .some(.none);
    let outer_some_val: ??i32 = .some(.some(99));
    match outer_none {
        .none => { io.uint(1); }  // expect: 1
        .some => { io.uint(999); }
    }
    match outer_some_none {
        .none        => { io.uint(999); }
        .some(inner) => { io.int(@as(i64, inner ?? -7)); }  // expect: -7
    }
    match outer_some_val {
        .none        => { io.uint(999); }
        .some(inner) => { io.int(@as(i64, inner ?? -7)); }  // expect: 99
    }

    // !?T interop
    let eo1 = may_err_opt(false) catch .none;
    let eo2 = may_err_opt(true) catch .none;
    io.int(@as(i64, eo1 ?? 11));  // expect: 11
    io.int(@as(i64, eo2 ?? 11));  // expect: 55
}
