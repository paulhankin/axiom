// Reference-binding match/if let on *U/*mut U and by-reference for &x / for &mut x.
import "../lib/io.ax" as io;

struct Big {
    vals: [4]u64,
}

union Shape {
    Empty,
    Box: Big,
}

export fn run() void {
    let mut u = Shape.Box(Big.{ vals: [1, 2, 3, 4] });
    // Mutable pointer match mutates payload in place without copying.
    match &mut u {
        .Empty => {}
        .Box(p) => { p.vals[2] = 300; }
    }
    // Immutable pointer if let reads payload in place.
    if let .Box(p) = &u {
        io.uint(p.vals[0] + p.vals[2]);  // expect: 301
    }

    // Reference match on *mut ?Big and *?bool and *mut ?[]u8
    let mut ob: ?Big = Big.{ vals: [10, 20, 30, 40] };
    if let .some(p) = &mut ob {
        p.vals[1] = 200;
    }
    match &ob {
        .none => {}
        .some(p) => { io.uint(p.vals[1] + p.vals[3]); }  // expect: 240
    }

    let mut flg: ?bool = false;
    if let .some(bp) = &mut flg {
        bp.* = true;
    }
    io.boolean(flg ?? false);  // expect: true

    // for &mut x and for &x over arrays and slices
    let mut arr: [4]u64 = [1, 2, 3, 4];
    for &mut x in arr {
        x.* *= 10;
    }
    let sl: []mut u64 = arr[1..4];
    for &mut x in sl {
        x.* += 1;
    }
    let ro: []u64 = arr[..];
    let mut sum: u64 = 0;
    for &x in ro {
        sum += x.*;
    }
    io.uint(sum);  // expect: 103
}
