// Empty slice literal [] and its ?[]T niche preservation.
import "../lib/io.ax" as io;

error SliceErr { Failed }

struct Holder {
    bytes: []u8,
    nums: []mut i32,
}

let g_empty: []u64 = [];

fn get_opt_slice(want_some: bool) ?[]u8 {
    if not want_some {
        return .none;
    }
    return [];
}

fn get_err_slice() SliceErr![]u8 {
    return [];
}

export fn run() void {
    let a: []u8 = [];
    let b: []mut u64 = [];
    let h = Holder.{ bytes: [], nums: [] };
    io.uint(@as(u64, a.len + b.len + h.bytes.len + h.nums.len + g_empty.len));  // expect: 0
    // Empty slice uses a non-null aligned address so ?[]T distinguishes .some([]) from .none.
    io.boolean(@int_from_ptr(a.ptr) != 0);                     // expect: true
    io.boolean((@int_from_ptr(b.ptr) % @align_of(u64)) == 0);  // expect: true
    io.boolean(@int_from_ptr(g_empty.ptr) != 0);               // expect: true

    match get_opt_slice(false) {
        .none => { io.uint(1); }  // expect: 1
        .some => { io.uint(999); }
    }
    match get_opt_slice(true) {
        .none    => { io.uint(999); }
        .some(s) => { io.uint(@as(u64, s.len)); }  // expect: 0
    }

    let es = get_err_slice() catch return;
    io.uint(@as(u64, es.len));  // expect: 0
}
