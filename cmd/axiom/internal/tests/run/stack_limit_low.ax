// The main thread's stack (WebAssembly) is the lowest MiB of memory, less
// its lowest KiB: a frame that would reach into that KiB traps.
// wasm-only
// expect-trap
// (mutable: the call is not inlined)
let mut DEEP: fn(usize) u32 = deep;

// Recurses until a frame lies in the lowest KiB.
fn deep(d: usize) u32 {
    let mut buf: [256]u8 = [0; 256];
    buf[d % 256] = @truncate(u8, d);
    if @int_from_ptr(&buf[0]) < 1000 {
        return @as(u32, buf[0]);
    }
    return DEEP(d + 1) +% @as(u32, buf[d % 256]);
}

export fn run() void {
    _ = DEEP(0);
}
