            let h: u64 = 0;
            hr = mix(hr, trace(h));
        }
        io.uint(hr);  // expect: 18152256992555429475
    }
    {
        let mut hr: u64 = 0;
        for s in 0..A.len {
            let h = mix(0, f10(A[s], B[s]));
            hr = mix(hr, trace(h));
        }
        io.uint(hr);  // expect: 7074156277406036061
    }
}
