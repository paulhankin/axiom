// Offsets computed in a type narrower than addresses wrap around: their
// range is not that of the arithmetic (a u16 `x *% 4 +% 0x1000` can be
// 0xffc), nor is `x *% 3` in i8 always a multiple of 3 (100 *% 3 is 44). The
// stores through them must not be taken as missing the element read.
// flags: -O2
import "../lib/io.ax" as io;

let mut gx: u16 = 0x3fff;
let mut gy: i8 = 100;
let mut a: [70000]u64 = [0; 70000];
let mut b: [300]u8 = [0; 300];

export fn run() void {
    let x = @atomic_load(&gx);
    a[0xffc] = 1;
    let j: u16 = ((x & 0x3fff) *% 4) +% 0x1000;
    a[@as(usize, j)] = 5;
    io.uint(a[0xffc]);  // expect: 5
    let y = @atomic_load(&gy);
    b[44] = 1;
    let k: i8 = y *% 3;
    b[@int_cast(usize, k)] = 5;
    io.uint(@as(u64, b[44]));  // expect: 5
}
