// A loop -O2 runs two iterations per test (loop_unroll2.ax) keeps the bounds
// check of each: here the one of the second copy fails.
// expect-trap
// expect: 0
import "../lib/io.ax" as io;

let mut XS: [16]i32 = [0; 16];
let mut ARGS: [2]usize = [0; 2];

fn sum(xs: []i32, n: usize) i64 {
    let mut s: i64 = 0;
    let mut i: usize = 0;
    while i < n {
        s += @as(i64, xs[i]);
        i += 1;
    }
    return s;
}

export fn run() void {
    ARGS = [6, 7];
    io.int(0);
    io.int(sum(XS[0..ARGS[0]], ARGS[1]));
}
