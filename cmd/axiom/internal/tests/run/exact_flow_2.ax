        io.uint(hr);  // expect: 14079927719103780336
    }
    {
        let mut hr: u64 = 0;
        for s in 0..A.len {
            let h = mix(0, f11(A[s], B[s]));
            hr = mix(hr, trace(h));
        }
        io.uint(hr);  // expect: 17379779296604620284
    }
    {
        let mut hr: u64 = 0;
        for s in 0..A.len {
            let h = mix(0, f12(A[s], B[s]));
            hr = mix(hr, trace(h));
        }
        io.uint(hr);  // expect: 12777391759589792697
    }
}
