// A phi taking undef on the way into a loop and another phi of the loop's
// header on its back edge holds that phi's value from the previous
// iteration: it is not that phi (prev below is the cur before it).
// flags: -O1
import "../lib/io.ax" as io;

union U {
    None,
    Some: i64,
}

fn digits(n: i64) void {
    let mut prev: U = U.None;
    let mut cur: i64 = 1;
    let mut sum: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        match prev {
            .Some(x) => { sum = sum * 10 + x; }
            .None => {}
        }
        prev = U.Some(cur);
        cur = cur + 1;
        i += 1;
    }
    io.int(sum);
}

export fn run() void {
    // (through a pointer: n is not a constant in digits)
    let fs = [digits, digits];
    for n in @as(usize, 5)..7 {
        fs[n & 1](@int_cast(i64, n));
    }
}
// expect: 1234
// expect: 12345
