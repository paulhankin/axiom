// Calls in recursion are inlined within bounds: a function in a cycle that
// does not call itself is inlined into the other functions of the cycle,
// and a recursive function into its callers outside the cycle once, its
// calls to itself staying calls. These shapes would grow without bound if
// the copies' calls were inlined in turn.
import "../lib/io.ax" as io;

// several calls to itself
fn tri(n: i32) i64 {
    if n <= 0 {
        return 1;
    }
    return tri(n - 1) + tri(n - 2) + tri(n - 3);
}

// mutual recursion, fan-out 2
fn ma(n: i32) i64 {
    if n <= 0 {
        return 1;
    }
    return mb(n - 1) + mb(n - 2);
}

fn mb(n: i32) i64 {
    if n <= 0 {
        return 2;
    }
    return ma(n - 1) + ma(n - 2) + 1;
}

// mutual recursion, fan-out 3
fn pa(n: i32) i64 {
    if n <= 0 {
        return 1;
    }
    return pb(n - 1) + pb(n - 2) + pb(n - 3);
}

fn pb(n: i32) i64 {
    if n <= 0 {
        return 3;
    }
    return pa(n - 1) * 2 + pa(n - 2) + pa(n - 3);
}

// a cycle of five functions, each calling the next three times
fn c1(n: i32) i64 {
    if n <= 0 {
        return 1;
    }
    return c2(n - 1) + c2(n - 2) + c2(n - 3);
}

fn c2(n: i32) i64 {
    if n <= 0 {
        return 2;
    }
    return c3(n - 1) + c3(n - 2) + c3(n - 3);
}

fn c3(n: i32) i64 {
    if n <= 0 {
        return 3;
    }
    return c4(n - 1) + c4(n - 2) + c4(n - 3);
}

fn c4(n: i32) i64 {
    if n <= 0 {
        return 4;
    }
    return c5(n - 1) + c5(n - 2) + c5(n - 3);
}

fn c5(n: i32) i64 {
    if n <= 0 {
        return 5;
    }
    return c1(n - 1) + c1(n - 2) + c1(n - 3);
}

// a small step function between the recursive one and itself (a backtracking
// matcher's continuation); continuations are a stack of nodes, k their count
let mut found: i32 = 0;
let mut conts: [16]i32 = [0; 16];

fn step(s: []u8, i: usize, k: usize) bool {
    if k == 0 {
        found += @int_cast(i32, i);
        return false;
    }
    return walk(s, conts[k - 1], i, k - 1);
}

fn walk(s: []u8, n: i32, i: usize, k: usize) bool {
    if n == 0 {
        return step(s, i, k);
    }
    if (i < s.len) and (s[i] == 'a') {
        conts[k] = n - 1;
        if walk(s, 0, i + 1, k + 1) {
            return true;
        }
    }
    return step(s, i, k);
}

export fn run() void {
    io.int(tri(10));  // expect: 653
    io.int(ma(12));   // expect: 753
    io.int(pa(9));    // expect: 2461
    io.int(c1(9));    // expect: 828
    _ = walk("aaaa", 3, 0, 0);
    io.int(@as(i64, found));  // expect: 6
}
