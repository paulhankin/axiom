// Loops in a row with the same trip count, which -O2 runs as one loop (an
// outer loop unrolled partially leaves them): fused only where the second
// loop reads nothing the code between them writes and uses nothing the
// first computes; the results must be those of the loops one after the other.
import "../lib/io.ax" as io;
import "std/mem" as mem;

const N: usize = 72;

// separate allocations: fused
fn product(a: []f64, b: []f64, r: []mut f64) f64 {
    for i in 0..N {
        for j in 0..N {
            let mut s: f64 = 0.0;
            for k in 0..N {
                s += a[(i * N) + k] * b[(k * N) + j];
            }
            r[(i * N) + j] = s;
        }
    }
    let mut t: f64 = 0.0;
    for i in 0..(N * N) {
        t += r[i] * @float_from_int(f64, (i % 7) + 1);
    }
    return t;
}

// r is b: each sum reads what the one before stored
fn in_place(b: []mut f64) f64 {
    for j in 0..N {
        let mut s: f64 = 1.0;
        for k in 0..N {
            s += b[(k * N) + j + 1] * 0.5;
        }
        b[(j * N) + j + 2] = s;
    }
    let mut t: f64 = 0.0;
    for i in 0..(N * N) {
        t += b[i] * @float_from_int(f64, (i % 5) + 1);
    }
    return t;
}

// the second loop starts from the first's result
fn chained(a: []u64) u64 {
    let mut t: u64 = 0;
    for j in 0..N {
        let mut s: u64 = @as(u64, j);
        for k in 0..N {
            s = (s *% 31) +% a[k + j];
        }
        t = (t *% 7) +% s;
    }
    return t;
}

export fn run() void {
    let a = mem.alloc.[f64](N * N) catch return;
    let b = mem.alloc.[f64](((N + 1) * N) + 4) catch return;
    let r = mem.alloc.[f64](N * N) catch return;
    for i in 0..(N * N) {
        a[i] = @float_from_int(f64, i % 17) * 0.25;
    }
    for i in 0..b.len {
        b[i] = @float_from_int(f64, i % 13) - 3.0;
    }
    io.float(product(a, b, r));  // expect: 8944936.25
    io.float(in_place(b));       // expect: 91251.78335387776
    let u = mem.alloc.[u64](2 * N) catch return;
    for i in 0..u.len {
        u[i] = @as(u64, i) *% 2654435761;
    }
    io.uint(chained(u));  // expect: 11129436765695520804
}
