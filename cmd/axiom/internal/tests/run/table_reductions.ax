// Reductions of table loads under a condition: if-conversion
// loads from a table element where the condition fails, and when that
// element is the reduction's identity the select of the result goes
// (`c ? h ^ T[i] : h` is `h ^ load(c ? &T[i] : &T[k])` with T[k] == 0).
import "../lib/io.ax" as io;

let KEYS: [64]u64 = [
    0,
    0x9E3779B97F4A7C15,
    0x3C6EF372FE94F82A,
    0xDAA66D2C7DDF743F,
    0x78DDE6E5FD29F054,
    0x1715609F7C746C69,
    0xB54CDA58FBBEE87E,
    0x53845412FB096493,
    0,
    0x8FF34781F99E5CBD,
    0x2E2AC13B78E8D8D2,
    0xCC623AF4F83354E7,
    0x6A99B4AE777DD0FC,
    0x08D12E67F6C84D11,
    0xA708A82176128926,
    0x45402DAAF55D453B,
    0,
    0x81AF1A8273F23D65,
    0x1FE6943BF33CB97A,
    0xBE1E0DF57287358F,
    0x5C5587AEF1D1B1A4,
    0xFA8D016871282DB9,
    0x98C47B21F07AA9CE,
    0x36FBF4DB6FC525E3,
    0,
    0x736AEE4E6E5A1E0D,
    0x11A26807EDA49A22,
    0xAFD9E1C16CEF1637,
    0x4E115B7AEC39924C,
    0xEC48D5346B840E61,
    0x8A804EEDEACE8A76,
    0x28B7C8A76A19068B,
    0,
    0x6526C21A68C1FEB5,
    0x035E3BD3E80C7ACA,
    0xA195B58D6756F6DF,
    0x3FCD2F46E6A172F4,
    0xDE04A90065EBEF09,
    0x7C3C22B9E5366B1E,
    0x1A739C736480E733,
    0,
    0x56E295E66329DF5D,
    0xF51A0F9FE2745B72,
    0x93518959E1BED787,
    0x3189031360095379,
    0xCFC07CCCDF53CFB1,
    0x6DF7F6865E9E4BC6,
    0x0C2F703FDDE8C7DB,
    0,
    0x489E69B25D91C005,
    0xE6D5E36BDCDC3C1A,
    0x850D5D255C26B82F,
    0x2344D6DEDB713444,
    0xC17C50985ABBB059,
    0x5FB3CA51DA062C6E,
    0xFDEB440B59509883,
    0,
    0x3A5A3D7E57F9A0AD,
    0xD891B737D7441CC2,
    0x76C930F1568E98D7,
    0x15009AAAD5D914EC,
    0xB33824645523910F,
    0x516F9E1DD46E0D24,
    0xEFA717D753B88939,
];

// No element is zero: the fallback cannot become the identity.
let ODD: [8]u32 = [3, 5, 7, 9, 11, 13, 15, 17];
// The first element is not the identity; another is.
let LATE: [8]u32 = [9, 1, 2, 3, 0, 5, 6, 7];

fn hash(b: *[8]u8) u64 {
    let mut h: u64 = 0;
    for pt in @as(usize, 0)..8 {
        let c = @as(usize, b[pt]);
        if (c > 0) and (c <= 7) {
            h ^= KEYS[(pt * 8) + c];
        }
    }
    return h;
}

fn sum_odd(b: *[8]u8) u32 {
    let mut s: u32 = 0;
    for k in @as(usize, 0)..8 {
        let c = @as(usize, b[k]);
        if c < 8 {
            s += ODD[c];
        }
    }
    return s;
}

fn or_late(b: *[8]u8) u32 {
    let mut s: u32 = 0;
    for k in @as(usize, 0)..8 {
        let c = @as(usize, b[k]);
        if c < 8 {
            s = s | (LATE[c] << @truncate(u32, k));
        }
    }
    return s;
}

fn sub_late(b: *[8]u8) u32 {
    let mut s: u32 = 1000;
    for k in @as(usize, 0)..8 {
        let c = @as(usize, b[k]);
        if (c != 0) and (c < 8) {
            s -= LATE[c];
        }
    }
    return s;
}

fn pick(c: usize) u64 {
    let mut v: u64 = 0;
    if c < 64 {
        v = KEYS[c];
    }
    return v;
}

export fn run() void {
    let mut b: [8]u8 = [0, 1, 7, 8, 255, 3, 2, 0];
    io.uint(hash(&b));                // expect: 14739394724049294019
    io.uint(@as(u64, sum_odd(&b)));   // expect: 44
    io.uint(@as(u64, or_late(&b)));   // expect: 1279
    io.uint(@as(u64, sub_late(&b)));  // expect: 987
    // boards of counts 0..11 (and some 255s)
    let mut r: u32 = 12345;
    let mut h: u64 = 0;
    let mut s: u64 = 0;
    let mut p: u64 = 0;
    for it in @as(usize, 0)..1000 {
        for k in @as(usize, 0)..8 {
            r = (r *% 1103515245) +% 12345;
            let v = (r >> 16) % 13;
            if v == 12 {
                b[k] = 255;
            } else {
                b[k] = @truncate(u8, v);
            }
        }
        h = (h *% 31) ^ hash(&b);
        s = (s *% 31) +% @as(u64, ((sum_odd(&b) ^ or_late(&b)) ^ sub_late(&b)));
        p = p ^ pick(@as(usize, r >> 25) + it);
    }
    io.uint(h);  // expect: 7971573365673228493
    io.uint(s);  // expect: 13451383701558955191
    io.uint(p);  // expect: 6968272116647334295
}
