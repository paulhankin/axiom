// A load from a local array is not folded into the instruction that reads
// it later (x86-64 fold_stack_reads, after register allocation): only a
// spill slot's reload is. In between, a register of the load's address may
// be overwritten (the 0 of a compare's result, in the register of the index
// that died at the load), or the array written through a pointer.
// flags: -O1
import "../lib/io.ax" as io;

// Whether any of the names picked by `order` has the length of `name`. The
// call after the loop leaves the loaded length dead after the compare.
fn any_len(name: []u8, order: []usize) void {
    let names = ["net", "plies", "cache", "eff", "cube-plies"];
    let mut ok = false;
    for o in order {
        let k = names[o & 3];
        ok = ok or (k.len == name.len);
    }
    io.boolean(ok);
}

// a[i] is read before the store through p (to a[j] when j < 8).
fn read_then_store(i: usize, j: usize, k: u64, other: *mut u64) u64 {
    let mut a: [8]u64 = [1, 2, 3, 4, 5, 6, 7, 8];
    let mut p = other;
    if j < 8 {
        p = &mut a[j];
    }
    let old = a[i];
    p.* = 100;
    if old == k {
        return a[(i + 1) % 8];
    }
    return a[(i + 2) % 8];
}

export fn run() void {
    // (through pointers: the arguments are not constants in the callees)
    let fs = [any_len, any_len];
    let order: [2]usize = [1, 2];
    let names = ["net", "plies", "cache"];
    for i in @as(usize, 0)..names.len {
        fs[i & 1](names[i], order[..]);
    }
    let gs = [read_then_store, read_then_store];
    let mut x: u64 = 0;
    for i in @as(usize, 3)..5 {
        io.uint(gs[i & 1](i, i, @as(u64, i) + 1, &mut x));
    }
}
// expect: false
// expect: true
// expect: true
// expect: 5
// expect: 6
