// Arithmetic whose overflow checks the ranges of its operands remove at -O2
// (lowering/overflow_ranges.ax), at the edges of those ranges: the results
// are the same as without the optimizer, and nothing traps.
import "../lib/io.ax" as io;

let mut I64S: [4]i64 = [0; 4];
let mut U64S: [4]u64 = [0; 4];
let mut I32S: [4]i32 = [0; 4];

fn inc_lt_i(x: i64, cap: i64) i64 {
    if x < cap {
        return x + 1;
    }
    return x;
}

fn dec_gt_i(x: i64, lo: i64) i64 {
    if x > lo {
        return x - 1;
    }
    return x;
}

fn neg_gt(x: i64, lo: i64) i64 {
    if x > lo {
        return -x;
    }
    return 0;
}

fn mask_add_hi(x: u64) u64 {
    return (x & ~@as(u64, 0xffff)) + 0xffff;
}

fn shr_add(x: u64) u64 {
    return (x >> 1) + 0x7FFF_FFFF_FFFF_FFFF;
}

fn sext_add(x: i32, y: i32) i64 {
    return @as(i64, x) + @as(i64, y);
}

fn sext_mul(x: i32, y: i32) i64 {
    return @as(i64, x) * @as(i64, y);
}

fn zext_mul(x: u32, y: u32) u64 {
    return @as(u64, x) * @as(u64, y);
}

fn shl_sub(k: u32) u32 {
    return (@as(u32, 1) << (k & 31)) - 1;
}

fn sum_to(lo: i32, n: i32) i64 {
    let mut s: i64 = 0;
    let mut i = lo;
    while i < n {
        s += @as(i64, i & 7);
        i += 1;
    }
    return s;
}

fn sum_down(hi: i32, lo: i32) i64 {
    let mut s: i64 = 0;
    let mut i = hi;
    while i > lo {
        i -= 1;
        s += @as(i64, i & 7);
    }
    return s;
}

export fn run() void {
    let max = @max_value(i64);
    let min = @min_value(i64);
    I64S = [max, min, max - 1, min + 1];
    U64S = [@max_value(u64), 0, 0xFFFF_FFFF_FFFF_0000, 1];
    I32S = [@max_value(i32), @min_value(i32), 0, 0];
    io.int(inc_lt_i(I64S[2], I64S[0]));  // expect: 9223372036854775807
    io.int(inc_lt_i(I64S[0], I64S[0]));  // expect: 9223372036854775807
    io.int(dec_gt_i(I64S[3], I64S[1]));  // expect: -9223372036854775808
    io.int(dec_gt_i(I64S[1], I64S[1]));  // expect: -9223372036854775808
    io.int(neg_gt(I64S[3], I64S[1]));    // expect: 9223372036854775807
    io.int(neg_gt(I64S[1], I64S[1]));    // expect: 0
    io.uint(mask_add_hi(U64S[0]));       // expect: 18446744073709551615
    io.uint(shr_add(U64S[0]));           // expect: 18446744073709551614
    io.int(sext_add(I32S[0], I32S[0]));  // expect: 4294967294
    io.int(sext_add(I32S[1], I32S[1]));  // expect: -4294967296
    io.int(sext_mul(I32S[1], I32S[1]));  // expect: 4611686018427387904
    io.int(sext_mul(I32S[1], I32S[0]));  // expect: -4611686016279904256
    io.uint(zext_mul(@bit_cast(u32, I32S[2] - 1), @bit_cast(u32, I32S[2] - 1)));  // expect: 18446744065119617025
    io.uint(@as(u64, shl_sub(31)));           // expect: 2147483647
    io.uint(@as(u64, shl_sub(0)));            // expect: 0
    io.int(sum_to(I32S[0] - 20, I32S[0]));    // expect: 74
    io.int(sum_down(I32S[1] + 20, I32S[1]));  // expect: 62
}
