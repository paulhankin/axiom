// A call through a function pointer of another type than the function's
// (other parameter types) traps (T0009) also once the pointer's value is
// known, here a parameter given the same function at every call
// (interprocedural constants, then inlining): it stays a call_indirect.
// flags: -O2
// wasm-only
// expect-trap
// expect: 3
import "../lib/io.ax" as io;

fn add2(x: i32, y: i32) i32 {
    return x + y;
}

fn apply(g: fn(i64, i64) i32, k: i32) i32 {
    let mut s: i32 = 0;
    let mut i: i32 = 0;
    while i < k {
        s = s * 3 + g(@as(i64, i), 1);
        i += 1;
    }
    return s;
}

export fn run() void {
    io.int(@as(i64, add2(1, 2)));
    let g = @bit_cast(fn(i64, i64) i32, @bit_cast(usize, @as(fn(i32, i32) i32, add2)));
    io.int(@as(i64, apply(g, 3)));
    io.int(@as(i64, apply(g, 4)));
}
