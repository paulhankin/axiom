// ext(trunc p) == p, for p = (ext x) * c in a wider type, tests whether x * c
// fits x's type only while the wide product cannot wrap. Here it wraps: to a
// value that fits though x * c does not (x = 2 unsigned, x = 4), or to one
// that does not fit.
// flags: -O1
import "../lib/io.ax" as io;

fn u32_in_u64(x: u32) bool {
    let p: u64 = @as(u64, x) *% 0x8000_0000_0000_0001;
    return @as(u64, @truncate(u32, p)) == p;
}

fn u8_in_u16(x: u8) bool {
    let p: u16 = @as(u16, x) *% 0x8001;
    return @as(u16, @truncate(u8, p)) == p;
}

fn i16_in_i32(x: i16) bool {
    let p: i32 = @as(i32, x) *% 0x4000_0003;
    return @as(i32, @truncate(i16, p)) == p;
}

fn i8_in_i16(x: i8) bool {
    let p: i16 = @as(i16, x) *% 0x4003;
    return @as(i16, @truncate(i8, p)) != p;
}

fn i32_in_i64(x: i32) bool {
    let p: i64 = @as(i64, x) *% 0x4000_0000_0000_0003;
    return @as(i64, @truncate(i32, p)) == p;
}

// no wrap: still the range check (x * 0x10 fits a u8 for x < 16)
fn u8_in_u16_small(x: u8) bool {
    let p: u16 = @as(u16, x) *% 0x10;
    return @as(u16, @truncate(u8, p)) == p;
}

export fn run() void {
    // (through pointers: the arguments are not constants in the callees)
    let a = [u32_in_u64, u32_in_u64];
    let b = [u8_in_u16, u8_in_u16_small];
    let c = [i16_in_i32, i16_in_i32];
    let d = [i8_in_i16, i8_in_i16];
    let e = [i32_in_i64, i32_in_i64];
    for k in @as(usize, 2)..5 {
        io.boolean(a[k & 1](@truncate(u32, k)));
        io.boolean(b[0](@truncate(u8, k)));
        io.boolean(c[k & 1](@truncate(i16, @bit_cast(isize, k))));
        io.boolean(d[k & 1](@truncate(i8, @bit_cast(isize, k))));
        io.boolean(e[k & 1](@truncate(i32, @bit_cast(isize, k))));
    }
    io.boolean(b[1](15));
    io.boolean(b[1](16));
}
// expect: true
// expect: true
// expect: false
// expect: true
// expect: false
// expect: false
// expect: false
// expect: false
// expect: true
// expect: false
// expect: true
// expect: true
// expect: true
// expect: false
// expect: true
// expect: true
// expect: false
