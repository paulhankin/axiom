// Phase 3.2: pub fields, module-private fields by default, struct const init, and anonymous structs.
import "../lib/io.ax" as io;
import "../lib/pub_fields.ax" as pf;

struct LocalBox {
    hidden: i32,
}

let mut GLOBAL_PAIR: pf.Pair = pf.DEFAULT_PAIR;

export fn run() void {
    let mut p = pf.Pair.make(3, 4);
    p.x += 1;
    io.uint(@as(u64, p.x));      // expect: 4
    io.uint(@as(u64, p.sum()));  // expect: 8

    // Struct const containing a private field initializes globals cleanly cross-module.
    io.uint(@as(u64, GLOBAL_PAIR.x));      // expect: 10
    io.uint(@as(u64, GLOBAL_PAIR.sum()));  // expect: 30

    // Field named `inline` with `pub` before `pub inline fn`.
    let m = pf.make_mixed(5, 6);
    io.uint(@as(u64, m.inline));        // expect: 5
    io.uint(@as(u64, m.get_secret()));  // expect: 6

    // Anonymous struct fields remain accessible cross-module.
    let an = pf.make_anon();
    io.int(@as(i64, an.a + an.b));  // expect: 15

    // Fields without `pub` remain accessible within their declaring module.
    let mut lb = LocalBox.{ hidden: 41 };
    lb.hidden += 1;
    io.int(@as(i64, lb.hidden));  // expect: 42
}
