            h_and = h_i16(h_and, @atomic_and(&mut GA_I16[IDX[1]], b));
            h_and = h_i16(h_and, @atomic_load(&GA_I16[IDX[1]], "acquire"));
            h_and = mix(h_and, hs_arr_i16(&GA_I16));
            @fence();
            @atomic_store(&mut GN[NIDX[2]].m.f_i16, 32767);
            _ = @atomic_load(&GN[NIDX[2]].m.f_i16);
            h_load = h_i16(h_load, @atomic_load(&GN[NIDX[2]].m.f_i16, "seq_cst"));
            h_load = mix(h_load, hs_outer(&GN[NIDX[2]]));
            @atomic_store(&mut G_I16, a);
            let r77 = ap_min_i16(&mut G_I16, -1);
            h_min = h_i16(h_min, r77);
            h_min = h_i16(h_min, G_I16);
            la_i16[IDX[4]] = a;
            h_add = h_i16(h_add, ap_add_i16(&mut la_i16[IDX[4]], 85));
            h_add = h_i16(h_add, la_i16[IDX[4]]);
            h_add = mix(h_add, hs_arr_i16(&la_i16));
            @atomic_store(&mut GS.f_i16, a, "relaxed");
            h_and = h_i16(h_and, ag_and(&mut GS.f_i16, b));
            h_and = h_i16(h_and, @atomic_load(&GS.f_i16, "relaxed"));
            h_and = mix(h_and, hs_mixed(&GS));
            @atomic_store(&mut l_i16, a, "relaxed");
            let r79 = @atomic_cas(&mut l_i16, a, (a ^ -32767), "seq_cst");
            h_cas = h_i16(h_cas, r79);
            h_cas = h_i16(h_cas, l_i16);
            GA_I16[IDX[0]] = a;
            @atomic_store(&mut GA_I16[IDX[0]], b);
            h_store = h_i16(h_store, @atomic_load(&GA_I16[IDX[0]], "seq_cst"));
            h_store = mix(h_store, hs_arr_i16(&GA_I16));
            la_i16[IDX[1]] = a;
            let r76 = @atomic_xchg(&mut la_i16[IDX[1]], b, "relaxed");
            h_xchg = h_i16(h_xchg, r76);
            h_xchg = h_i16(h_xchg, la_i16[IDX[1]]);
            h_xchg = mix(h_xchg, hs_arr_i16(&la_i16));
            @fence("relaxed");
            la_i16[IDX[3]] = a;
            _ = @atomic_sub(&mut la_i16[IDX[3]], b, "relaxed");
            h_sub = h_i16(h_sub, @atomic_load(&la_i16[IDX[3]]));
            h_sub = mix(h_sub, hs_arr_i16(&la_i16));
            @atomic_store(&mut l_i16, a, "relaxed");
            let r73 = @atomic_sub(&mut l_i16, b, "acquire");
            h_sub = h_i16(h_sub, r73);
            h_sub = h_i16(h_sub, l_i16);
            l_i16 = a;
            _ = @atomic_or(&mut l_i16, 1, "acq_rel");
            h_or = h_i16(h_or, l_i16);
            G_I16 = a;
            _ = @atomic_xor(&mut G_I16, 32767, "acq_rel");
            h_xor = h_i16(h_xor, @atomic_load(&G_I16, "relaxed"));
        }
    }
    io.uint(h_load);
    io.uint(h_store);
    io.uint(h_add);
    io.uint(h_sub);
    io.uint(h_and);
    io.uint(h_or);
    io.uint(h_xor);
    io.uint(h_xchg);
    io.uint(h_min);
    io.uint(h_max);
    io.uint(h_cas);
}

fn globals() void {
    let mut hg: u64 = 0;
    hg = h_u8(hg, G_U8);
    hg = mix(hg, hs_arr_u8(&GA_U8));
    hg = h_i8(hg, G_I8);
    hg = mix(hg, hs_arr_i8(&GA_I8));
    hg = h_u16(hg, G_U16);
    hg = mix(hg, hs_arr_u16(&GA_U16));
    hg = h_i16(hg, G_I16);
    hg = mix(hg, hs_arr_i16(&GA_I16));
    hg = h_u32(hg, G_U32);
    hg = mix(hg, hs_arr_u32(&GA_U32));
    hg = h_i32(hg, G_I32);
    hg = mix(hg, hs_arr_i32(&GA_I32));
    hg = h_u64(hg, G_U64);
    hg = mix(hg, hs_arr_u64(&GA_U64));
    hg = h_i64(hg, G_I64);
    hg = mix(hg, hs_arr_i64(&GA_I64));
    hg = h_usize(hg, G_USIZE);
    hg = mix(hg, hs_arr_usize(&GA_USIZE));
    hg = h_isize(hg, G_ISIZE);
    hg = mix(hg, hs_arr_isize(&GA_ISIZE));
    hg = mix(hg, hs_mixed(&GS));
    hg = mix(hg, hs_outer(&GN[0]));
    hg = mix(hg, hs_outer(&GN[1]));
    hg = mix(hg, hs_outer(&GN[2]));
    io.uint(hg);
}

