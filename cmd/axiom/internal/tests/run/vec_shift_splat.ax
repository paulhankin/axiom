// A vector shift by a splat of a scalar count reads the count from the
// splat (WebAssembly), not from the scalar's own local, which may be reused
// by then: one splat shared by two shifts with a value defined in between,
// or a splat moved out of a loop away from its count.
// flags: -O1
import "../lib/io.ax" as io;

let mut M: u32 = 0;
let mut M2: u32 = 0;

// (mutable: the calls are not inlined, and the arguments not constants in
// the callees)
let mut SHARED: fn(u32x8, u32x8, u32) u32x8 = shared;
let mut IN_LOOP: fn(u16) void = in_loop;

fn shared(v: u32x8, w: u32x8, x: u32) u32x8 {
    let k = x & 7;
    M = k * 5;
    let a = v << k;
    let y = (x *% 1000003) +% 12345;
    M2 = y;
    let b = w << k;
    return (a ^ b) +% @as(u32x8, @splat(y));
}

let G: [5]i64 = [32768, 100, 128, 161, 242];

fn in_loop(n: u16) void {
    let mut l: [5]i32 = [74, -209, @truncate(i32, G[@as(usize, @as(u32, n) % 5)]), -209, 53];
    for k in @as(usize, 0)..1 {
        let v: i32x4 = @load(i32x4, l[k * 4..]);
        @store(l[k * 4..], v >> @as(u32, n));
    }
    for x in l {
        io.int(@as(i64, x));
    }
}

export fn run() void {
    let v = @vec(u32x8, 1, 2, 3, 4, 5, 6, 7, 8);
    let w = @vec(u32x8, 16, 32, 64, 128, 1, 1, 1, 1);
    let r = SHARED(v, w, 2);
    io.int(@as(i64, @extract_lane(r, 0)));
    io.int(@as(i64, @extract_lane(r, 1)));
    io.int(@as(i64, @extract_lane(r, 4)));
    IN_LOOP(0);
    IN_LOOP(7);
}

// expect: 2012419
// expect: 2012487
// expect: 2012367
// expect: 74
// expect: -209
// expect: 32768
// expect: -209
// expect: 53
// expect: 0
// expect: -2
// expect: 1
// expect: -2
// expect: 53
