// A match on a bool takes the arm of `true`: the switch's case is the
// 1-bit constant 1, which read as a signed value is -1, and native code
// compared the register (0 or 1) with that.
import "../lib/io.ax" as io;

// (mutable: the calls are not inlined, and the arguments not constants in
// the callees)
let mut ELSE: fn(bool) i64 = with_else;
let mut BOTH: fn(bool) i64 = both;

fn with_else(b: bool) i64 {
    match b {
        true => { return 7; }
        else => { return 3; }
    }
}

fn both(b: bool) i64 {
    match b {
        true  => { return 5; }
        false => { return 2; }
    }
}

export fn run() void {
    let mut n: i64 = 0;
    for i in @as(u32, 0)..4 {
        n = n * 10 + ELSE(i % 2 == 1);
    }
    io.int(n);
    io.int(BOTH(true) * 10 + BOTH(false));
}

// expect: 3737
// expect: 52
