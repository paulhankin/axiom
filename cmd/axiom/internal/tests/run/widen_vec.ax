// @widen_low and @widen_high on 128-, 256- and 512-bit vectors of every lane type (8 to 16,
// 16 to 32 and 32 to 64 bits, signed and unsigned: pmovsx and pmovzx natively, of the high
// half moved down for @widen_high), lane by lane against the scalar conversions, on edge
// values, at every offset into the data.
import "../lib/io.ax" as io;

let mut d_i8: [96]i8 = [0; 96];
let mut d_u8: [96]u8 = [0; 96];
let mut d_i16: [96]i16 = [0; 96];
let mut d_u16: [96]u16 = [0; 96];
let mut d_i32: [96]i32 = [0; 96];
let mut d_u32: [96]u32 = [0; 96];

fn fill() void {
    let e8: [8]u8 = [0x80, 0xFF, 0x7F, 0x00, 0x01, 0xFE, 0x81, 0x40];
    let e16: [8]u16 = [0x8000, 0xFFFF, 0x7FFF, 0x0000, 0x0001, 0xFFFE, 0x80FF, 0x7F00];
    let e32: [8]u32 = [0x8000_0000, 0xFFFF_FFFF, 0x7FFF_FFFF, 0, 1, 0xFFFF_FFFE, 0x8000_FFFF, 0x7FFF_0000];
    for i in @as(usize, 0)..96 {
        let k = (i * 5 + i / 8) % 8;
        let x8 = e8[k] +% @truncate(u8, (i / 8) * 3);
        let x16 = e16[k] +% @truncate(u16, (i / 8) * 0x101);
        let x32 = e32[k] +% @truncate(u32, (i / 8) * 0x1_0101);
        d_u8[i] = x8;
        d_i8[i] = @bit_cast(i8, x8);
        d_u16[i] = x16;
        d_i16[i] = @bit_cast(i16, x16);
        d_u32[i] = x32;
        d_i32[i] = @bit_cast(i32, x32);
    }
}

fn check_i8x16(x: []i8) u32 {
    let v = @load(i8x16, x[0..16]);
    let mut r: [8]i16 = [0; 8];
    let mut bad: u32 = 0;
    @store(r[..], @widen_low(v));
    for i in @as(usize, 0)..8 {
        bad += @as(u32, r[i] != @as(i16, x[i]));
    }
    @store(r[..], @widen_high(v));
    for i in @as(usize, 0)..8 {
        bad += @as(u32, r[i] != @as(i16, x[8 + i]));
    }
    return bad;
}

