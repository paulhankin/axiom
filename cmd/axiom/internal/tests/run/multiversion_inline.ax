// Inline helpers called from a @multiversion or @features function are
// compiled with the caller's extensions: @target_has inside them answers
// for that version (spec §13.4, §9.5). Natively it is built for baseline
// x86-64, so on a processor with AVX-512 the versions run AVX-512 code.
// x86-64-flags: --cpu=x86-64
import "../lib/io.ax" as io;

inline fn width() u32 {
    if @target_has("avx512f") {
        return 512;
    }
    if @target_has("avx2") {
        return 256;
    }
    return 128;
}

inline fn dot16(a: *[16]f32, b: *[16]f32) f32 {
    let x = @load(f32x16, a[..]);
    let y = @load(f32x16, b[..]);
    return @reduce_add(x * y);
}

fn level() u32 @multiversion("avx512f,avx512bw,avx512cd,avx512dq,avx512vl", "avx2") {
    return width();
}

fn dot(a: *[16]f32, b: *[16]f32) f32 @multiversion("avx512f,avx512bw,avx512cd,avx512dq,avx512vl", "avx2") {
    return dot16(a, b);
}

// A function that is not inline keeps the build's extensions, even when a
// version is the first to call it (outer_b, which any processor runs, calls it too).
fn plain_width() u32 {
    if @target_has("avx512f") {
        return 512;
    }
    return 128;
}

fn plain_level() u32 @multiversion("avx512f") {
    return plain_width();
}

fn outer_b() u32 {
    return plain_width();
}

fn outer_a() u32 {
    return outer_b();
}

fn level512() u32 @features("avx512f,avx512bw") {
    return width();
}

export fn run() void {
    io.boolean(plain_level() == 128);  // expect: true
    io.boolean((outer_a() == 512) == @target_has("avx512f"));  // expect: true
    let lv = level();
    let mut want: u32 = 128;
    if @cpu_has("avx512f") {
        want = 512;
    } else if @cpu_has("avx2") {
        want = 256;
    }
    io.boolean(lv == want);  // expect: true
    io.boolean((width() == 512) == @target_has("avx512f"));  // expect: true
    let mut l5: u32 = 512;
    if @cpu_has("avx512f") and @cpu_has("avx512bw") {
        l5 = level512();
    }
    io.uint(@as(u64, l5));  // expect: 512
    let mut a: [16]f32 = [0.0; 16];
    let mut b: [16]f32 = [0.0; 16];
    let mut x: f32 = 0.0;
    for i in @as(usize, 0)..16 {
        a[i] = x * 0.5;
        b[i] = 2.0;
        x += 1.0;
    }
    io.int(@as(i64, @int_from_float(i32, dot(&a, &b))));  // expect: 120
}
