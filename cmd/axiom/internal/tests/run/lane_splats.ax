// Broadcasts of the lanes of a vector (issue #21): with AVX-512 a lane
// k >= 1 of 32-bit lanes into 512 bits is one vpermd/vpermps by a constant
// index vector (kept in a register through the loop). The results are the
// same everywhere.
import "../lib/io.ax" as io;

fn deltas(xs: []f32, w: []f32, n: usize) f32 {
    let mut acc: f32x16 = @splat(0.0);
    let mut acc2: f32x16 = @splat(0.0);
    for r in @as(usize, 0)..n {
        let d = @load(f32x4, xs[(4 * r)..]) - @load(f32x4, xs[(4 * r) + 4..]);
        acc = @fma(@splat(@extract_lane(d, 0)), @load(f32x16, w[0..16]), acc);
        acc2 = @fma(@splat(@extract_lane(d, 1)), @load(f32x16, w[16..32]), acc2);
        acc = @fma(@splat(@extract_lane(d, 2)), @load(f32x16, w[32..48]), acc);
        acc2 = @fma(@splat(@extract_lane(d, 3)), @load(f32x16, w[48..64]), acc2);
    }
    return @reduce_add(acc + acc2);
}

fn ilanes(xs: []i32, n: usize) i64 {
    let mut acc: i32x16 = @splat(0);
    for r in @as(usize, 0)..n {
        let v = @load(i32x8, xs[(8 * r)..]);
        acc = acc + (@splat(@extract_lane(v, 5)) * @splat(@extract_lane(v, 7)));
        acc = acc ^ @splat(@extract_lane(v, 3));
    }
    return @as(i64, @reduce_add(acc));
}

export fn run() void {
    let mut xs: [64]f32 = [0.0; 64];
    for k in @as(usize, 0)..64 {
        xs[k] = @float_from_int(f32, @as(i32, @int_cast(i32, (k * 7) % 11)) - 5) * 0.25;
    }
    let mut w: [64]f32 = [0.0; 64];
    for k in @as(usize, 0)..64 {
        w[k] = @float_from_int(f32, @as(i32, @int_cast(i32, (k * 5) % 13)) - 6) * 0.125;
    }
    io.float(@as(f64, deltas(xs[..], w[..], 14)));  // expect: 2.15625
    let mut ys: [80]i32 = [0; 80];
    for k in @as(usize, 0)..80 {
        ys[k] = @as(i32, @int_cast(i32, (k * 37) % 101)) - 50;
    }
    io.int(ilanes(ys[..], 10));  // expect: -8224
}
