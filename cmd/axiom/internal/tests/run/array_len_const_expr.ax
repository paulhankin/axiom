// Array lengths can be any constant expression (consts, literals and
// operators, folded by the compiler), as well as a const generic
// parameter by itself; a.len is the folded value.
import "../lib/io.ax" as io;

const MAX_DEPTH: usize = 3;
const BITS: u32 = 10;

struct Stack {
    items: [MAX_DEPTH + 1]u64,
}

fn total[const N: usize](a: [N]u32) u32 {
    let mut t: u32 = 0;
    for x in a {
        t += x;
    }
    return t;
}

export fn run() void {
    let s = Stack.{ items: [0; MAX_DEPTH + 1] };
    io.int(@int_cast(i64, s.items.len));
    let t: [(1 << BITS) / 256]u8 = [7; 4];
    io.int(@int_cast(i64, t.len));
    let m: [2 * MAX_DEPTH - 1]i32 = [1, 2, 3, 4, 5];
    io.int(@int_cast(i64, m.len));
    let w: [@size_of(u64) * 2]u8 = [1; 16];
    io.int(@int_cast(i64, w.len));
    let q: [MAX_DEPTH]u32 = [1, 2, 3];
    io.int(@int_cast(i64, total(q)));
}
// expect: 4
// expect: 4
// expect: 5
// expect: 16
// expect: 6
