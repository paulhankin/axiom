// A frame of most of a GiB (within the limit, E0473) does not fit the
// stack: the check before it is reserved traps, without wrapping around.
// wasm-only
// expect-trap
let mut gk: usize = 0;

fn fill(buf: *mut [1000000000]u8, k: usize) void {
    buf[k] = 1;
}

let mut fillf: fn(*mut [1000000000]u8, usize) void = fill;

fn big(k: usize) u8 {
    let mut buf: [1000000000]u8 = undefined;
    fillf(&mut buf, k);
    return buf[k];
}

export fn run() void {
    let f: fn(usize) u8 = big;
    _ = f(@atomic_load(&gk));
}
