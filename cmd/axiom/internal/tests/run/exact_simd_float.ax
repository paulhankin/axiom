    let mut h4: u64 = 0;
    let mut h5: u64 = 0;
    let mut h6: u64 = 0;
    let mut h7: u64 = 0;
    let mut h8: u64 = 0;
    let mut h9: u64 = 0;
    let mut h10: u64 = 0;
    let mut h11: u64 = 0;
    let mut h12: u64 = 0;
    let mut h13: u64 = 0;
    for i in 0..R_F64X8.len / 8 {
        let a = @bit_cast(f64x8, @load(u64x8, R_F64X8[i * 8..]));
        h0 = hv_f64x8(h0, -a);
        h1 = hv_f64x8(h1, @abs(a));
        h2 = hv_f64x8(h2, @sqrt(a));
        h3 = h_f64(h3, @reduce_add(a));
        h4 = hv_f64x8(h4, @floor(a));
        h5 = hv_f64x8(h5, @ceil(a));
        h6 = hv_f64x8(h6, @trunc(a));
        h7 = hv_f64x8(h7, @nearest(a));
        h8 = hb128(h8, @bit_cast(u64x2, @int_from_float(i16x8, a)));
        h9 = hb128(h9, @bit_cast(u64x2, @int_from_float(u16x8, a)));
        h10 = hb256(h10, @bit_cast(u64x4, @int_from_float(i32x8, a)));
        h11 = hb256(h11, @bit_cast(u64x4, @int_from_float(u32x8, a)));
        h12 = hb512(h12, @bit_cast(u64x8, @int_from_float(i64x8, a)));
        h13 = hb512(h13, @bit_cast(u64x8, @int_from_float(u64x8, a)));
    }
    io.uint(h0);
    io.uint(h1);
    io.uint(h2);
    io.uint(h3);
    io.uint(h4);
    io.uint(h5);
    io.uint(h6);
    io.uint(h7);
    io.uint(h8);
    io.uint(h9);
    io.uint(h10);
    io.uint(h11);
    io.uint(h12);
    io.uint(h13);
}

fn fma_f64x8() void {
    let mut h0: u64 = 0;
    let mut h1: u64 = 0;
    for i in 0..S_F64X8.len / 8 {
        for j in 0..S_F64X8.len / 8 {
            for k in 0..S_F64X8.len / 8 {
                let a = @bit_cast(f64x8, @load(u64x8, S_F64X8[i * 8..]));
                let b = @bit_cast(f64x8, @load(u64x8, S_F64X8[j * 8..]));
                let c = @bit_cast(f64x8, @load(u64x8, S_F64X8[k * 8..]));
                h0 = hv_f64x8(h0, @fma(a, b, c));
                h1 = hv_f64x8(h1, a * b + c);
            }
        }
    }
    io.uint(h0);
    io.uint(h1);
}

