// Small loops whose trip count is not known, which -O2 runs two iterations
// per test, with the one left over on its own: every count, odd and even,
// none, the bounds checks of both copies (loop_unroll2_trap.ax: a failed
// one traps), and a counter used after the loop.
import "../lib/io.ax" as io;

let mut XS: [16]i32 = [0; 16];
let mut ARGS: [4]usize = [0; 4];

fn sum(xs: []i32, n: usize) i64 {
    let mut s: i64 = 0;
    let mut i: usize = 0;
    while i < n {
        s = (s * 3) + @as(i64, xs[i]);
        i += 1;
    }
    return s;
}

fn first_neg(xs: []i32) usize {
    let mut i: usize = 0;
    while i < xs.len {
        if xs[i] < 0 {
            break;
        }
        i += 1;
    }
    return i;
}

fn sum32(xs: []i32, lo: i32, n: i32) i64 {
    let mut s: i64 = 0;
    for i in lo..n {
        s += @as(i64, xs[@int_cast(usize, i - lo)]) * @as(i64, i);
    }
    return s;
}

export fn run() void {
    for i in @as(usize, 0)..16 {
        XS[i] = (@int_cast(i32, i) * 7 % 11) - 2;
    }
    ARGS = [0, 5, 16, 2147483647];
    io.int(0);  // expect: 0
    let mut t: i64 = 0;
    for n in ARGS[0]..(ARGS[2] + 1) {
        t = (t * 31) +% sum(XS[..], n);
    }
    io.int(t);  // expect: 5727492675290634249
    io.uint(@as(u64, first_neg(XS[..])));                // expect: 0
    io.uint(@as(u64, first_neg(XS[4..ARGS[1] + 4])));    // expect: 4
    io.uint(@as(u64, first_neg(XS[ARGS[0]..ARGS[0]])));  // expect: 0
    let top = @int_cast(i32, ARGS[3]);
    io.int(sum32(XS[..], top - 5, top));  // expect: 34359738319
    io.int(sum32(XS[..], top - 4, top));  // expect: 25769803747
    io.int(sum32(XS[..], top, top));      // expect: 0
}
