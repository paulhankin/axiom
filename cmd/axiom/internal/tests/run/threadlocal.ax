// `threadlocal let mut`: every thread gets its own copy of the global,
// starting from the initializer; the main thread's copy is the ordinary one.
import "../lib/io.ax" as io;
import "std/thread" as thread;

threadlocal let mut counter: u64 = 100;
threadlocal let mut pair: [2]u64 = [7, 70];
let mut shared: u64 = 0;

struct Job {
    id: u64,
    result: u64,
}

fn bump(n: u64) void {
    for i in @as(u64, 0)..n {
        counter += 1;
    }
}

fn work(j: *mut Job) void {
    // a fresh thread starts from the initializer, not the main thread's value
    j.result = counter;
    bump(j.id * 1000);
    pair[0] += j.id;
    let p = &mut counter;
    p.* += pair[0];
    j.result = j.result * 1000000 + counter;
}

export fn run() void {
    counter = 5;
    pair[1] = 1;
    let mut jobs: [3]Job = [Job.{ id: 1, result: 0 }, Job.{ id: 2, result: 0 }, Job.{ id: 3, result: 0 }];
    let a = thread.spawn(work, &mut jobs[0]) catch return;
    let b = thread.spawn(work, &mut jobs[1]) catch return;
    let c = thread.spawn(work, &mut jobs[2]) catch return;
    a.join();
    b.join();
    c.join();
    for j in jobs {
        io.uint(j.result);
    }
    // expect: 100001108
    // expect: 100002109
    // expect: 100003110
    io.uint(counter);  // expect: 5
    io.uint(pair[0]);  // expect: 7
    io.uint(pair[1]);  // expect: 1
    shared += 1;
    io.uint(shared);  // expect: 1
}
