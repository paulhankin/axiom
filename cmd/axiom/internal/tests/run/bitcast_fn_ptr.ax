// @bit_cast between a function pointer and usize, both ways (issue 0103).
import "../lib/io.ax" as io;

fn add1(x: i32) i32 {
    return x + 1;
}

fn twice(x: i32) i32 {
    return x * 2;
}

let mut TABLE: [2]usize = [0, 0];

export fn run() void {
    TABLE[0] = @bit_cast(usize, @as(fn(i32) i32, add1));
    TABLE[1] = @bit_cast(usize, @as(fn(i32) i32, twice));
    for i in @as(usize, 0)..2 {
        let g = @bit_cast(fn(i32) i32, TABLE[i]);
        io.int(@as(i64, g(41)));
    }
    // expect: 42
    // expect: 82
}
