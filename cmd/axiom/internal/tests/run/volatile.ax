// @volatile_load, @volatile_store, @volatile_zero, and @black_box.
import "../lib/io.ax" as io;

struct Pair {
    a: u64,
    b: u64,
    c: u32,
}

enum Color: u8 {
    RED = 1,
    BLUE = 2,
}

fn check_generic[T](p: *mut T, v: T) T {
    @volatile_store(p, @black_box(v));
    return @volatile_load(p);
}

export fn run() void {
    let mut x: u64 = 10;
    @volatile_store(&mut x, 42);
    io.uint(@volatile_load(&x));  // expect: 42

    let mut b: bool = false;
    @volatile_store(&mut b, true);
    io.boolean(@volatile_load(&b));  // expect: true

    let mut col = Color.RED;
    @volatile_store(&mut col, Color.BLUE);
    io.uint(@as(u64, @int_from_enum(@volatile_load(&col))));  // expect: 2

    let mut pair = Pair.{ a: 1, b: 2, c: 3 };
    let bb = @black_box(Pair.{ a: 11, b: 22, c: 33 });
    @volatile_store(&mut pair, bb);
    let got = @volatile_load(&pair);
    io.uint((got.a + got.b) + @as(u64, got.c));  // expect: 66

    let g = check_generic(&mut x, @as(u64, 99));
    io.uint(g);  // expect: 99

    let mut secret: [8]u8 = [1, 2, 3, 4, 5, 6, 7, 8];
    @volatile_zero(secret[..]);
    let mut sum: u64 = 0;
    for byte in secret {
        sum += @as(u64, byte);
    }
    io.uint(sum);  // expect: 0

    let mut words: [4]u32 = [100, 200, 300, 400];
    @volatile_zero(words[..]);
    let mut wsum: u64 = 0;
    for w in words {
        wsum += @as(u64, w);
    }
    io.uint(wsum);  // expect: 0

    let bb_int: u32 = @black_box(12345);
    io.uint(@as(u64, bb_int));  // expect: 12345
}
