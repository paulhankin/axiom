// A sum of neighbouring bytes made vector sums (x86-64 byte_sums) keeps the
// leaves it did not vectorize, counted as often as they appear: a byte
// added twice is in the vector sum once, and added again after it.
// flags: -O2
import "../lib/io.ax" as io;

// p[0..16] and p[3] again
fn sum(p: *[64]u8) u32 {
    let mut s: u32 = 0;
    for i in @as(usize, 0)..16 {
        s += @as(u32, p[i]);
    }
    s += @as(u32, p[3]);
    return s;
}

export fn run() void {
    // (through pointers: the bytes are not constants in the callee)
    let fs = [sum, sum];
    let mut a: [64]u8 = [0; 64];
    for k in @as(usize, 0)..2 {
        for i in @as(usize, 0)..64 {
            a[i] = @truncate(u8, (i * 3) + k);
        }
        io.uint(@as(u64, fs[k](&a)));
    }
}
// expect: 369
// expect: 386
