// A call through a function pointer cast to a type with fewer parameters
// than the function's is not inlined once the pointer's value is known
// (through a global, or a parameter given the same function at every
// call): it is not a direct call of the function. The calls are never made.
// flags: -O2
import "../lib/io.ax" as io;

fn add2(x: i32, y: i32) i32 {
    return x + y;
}

fn apply(g: fn(i32) i32, k: i32) i32 {
    let mut s: i32 = 0;
    let mut i: i32 = 0;
    while i < k {
        s = s * 3 + g(i);
        i += 1;
    }
    return s;
}

let mut TABLE: [2]usize = [0, 0];
let mut N: i32 = 0;

export fn run() void {
    TABLE[0] = @bit_cast(usize, @as(fn(i32, i32) i32, add2));
    let n = @atomic_load(&N);
    if n > 5 {
        let g = @bit_cast(fn(i32) i32, TABLE[0]);
        io.int(@as(i64, g(41)));
    }
    let h = @bit_cast(fn(i32) i32, @bit_cast(usize, @as(fn(i32, i32) i32, add2)));
    io.int(@as(i64, apply(h, n)));
    io.int(@as(i64, add2(n, 2)));
    // expect: 0
    // expect: 2
}
