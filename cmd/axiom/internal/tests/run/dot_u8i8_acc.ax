// acc + @dot(x, y) of u8 by i8 lanes, which x86 VNNI computes as one vpdpbusd into the
// accumulator: running sums over many vectors at 128, 256 and 512 bits, on edge values, a
// dot also used on its own (not folded), an accumulator from a parameter, and the sum on
// either side of the add, against the scalar sums.
// flags: -O2
import "../lib/io.ax" as io;

let mut us: [640]u8 = [0; 640];
let mut ys: [640]i8 = [0; 640];

fn fill() void {
    let ue: [8]u8 = [255, 0, 1, 127, 128, 254, 200, 3];
    let se: [8]i8 = [-128, 127, -1, 0, 1, -127, 64, -65];
    for i in @as(usize, 0)..640 {
        us[i] = ue[(i * 5) % 8];
        ys[i] = se[(i / 8 + i * 3) % 8];
    }
}

// lane j of the running sum over n vectors of w bytes: four products of each
fn want(n: usize, w: usize, j: usize) i32 {
    let mut s: i32 = 0;
    for k in @as(usize, 0)..n {
        for t in @as(usize, 0)..4 {
            let i = (k * w) + (4 * j) + t;
            s += @as(i32, us[i]) * @as(i32, ys[i]);
        }
    }
    return s;
}

fn sum16(n: usize, start: i32x4) i32x4 {
    let mut s = start;
    for k in @as(usize, 0)..n {
        s = s + @dot(@load(u8x16, us[(k * 16)..((k + 1) * 16)]), @load(i8x16, ys[(k * 16)..((k + 1) * 16)]));
    }
    return s;
}

fn sum32(n: usize) i32x8 {
    let mut s: i32x8 = @splat(0);
    for k in @as(usize, 0)..n {
        // (the dot on the left of the add)
        s = @dot(@load(u8x32, us[(k * 32)..((k + 1) * 32)]), @load(i8x32, ys[(k * 32)..((k + 1) * 32)])) + s;
    }
    return s;
}

fn sum64(n: usize) i32x16 {
    let mut s: i32x16 = @splat(0);
    for k in @as(usize, 0)..n {
        s = s + @dot(@load(u8x64, us[(k * 64)..((k + 1) * 64)]), @load(i8x64, ys[(k * 64)..((k + 1) * 64)]));
    }
    return s;
}

// the dot used twice: added to the sum and kept as the last one
fn sum64_last(n: usize, last: *mut i32x16) i32x16 {
    let mut s: i32x16 = @splat(0);
    for k in @as(usize, 0)..n {
        let d = @dot(@load(u8x64, us[(k * 64)..((k + 1) * 64)]), @load(i8x64, ys[(k * 64)..((k + 1) * 64)]));
        s = s + d;
        last.* = d;
    }
    return s;
}

export fn run() void {
    fill();
    let mut bad: u32 = 0;
    for n16 in @as(u16, 1)..11 {
        let n = @as(usize, n16);
        let base: i32x4 = @splat(@as(i32, n16) * 1000);
        let a = sum16(n * 4, base);
        let b = sum32(n * 2);
        let c = sum64(n);
        let mut last: i32x16 = @splat(0);
        let e = sum64_last(n, &mut last);
        let mut ra: [4]i32 = [0; 4];
        let mut rb: [8]i32 = [0; 8];
        let mut rc: [16]i32 = [0; 16];
        let mut re: [16]i32 = [0; 16];
        let mut rl: [16]i32 = [0; 16];
        @store(ra[..], a);
        @store(rb[..], b);
        @store(rc[..], c);
        @store(re[..], e);
        @store(rl[..], last);
        for j in @as(usize, 0)..4 {
            bad += @as(u32, ra[j] != (want(n * 4, 16, j) + (@as(i32, n16) * 1000)));
        }
        for j in @as(usize, 0)..8 {
            bad += @as(u32, rb[j] != want(n * 2, 32, j));
        }
        for j in @as(usize, 0)..16 {
            bad += @as(u32, rc[j] != want(n, 64, j));
            bad += @as(u32, re[j] != want(n, 64, j));
            bad += @as(u32, rl[j] != (want(n, 64, j) - want(n - 1, 64, j)));
        }
    }
    io.int(@as(i64, bad));  // expect: 0
}
