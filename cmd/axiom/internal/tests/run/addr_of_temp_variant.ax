// Regression test: taking the address (&) of non-place E_FIELD temporaries
// such as union unit variants, enum variants, and module-qualified constants
// must spill the value instead of treating the qualifier as a struct.
import "../lib/io.ax" as io;

union Action {
    UnitA,
    UnitB,
    Val: i32,
}

enum Color: i32 {
    Red = 1,
    Blue = 7,
}

const MY_CONST: i32 = 42;

fn inspect_action(a: *Action) i32 {
    match a {
        .UnitA  => { return 10; }
        .UnitB  => { return 20; }
        .Val(x) => { return x.*; }
    }
}

fn inspect_color(c: *Color) i32 {
    if c.* == Color.Red {
        return 1;
    }
    return 7;
}

fn inspect_int(p: *i32) i32 {
    return p.*;
}

export fn run() void {
    io.int(@as(i64, inspect_action(&Action.UnitA)));    // expect: 10
    io.int(@as(i64, inspect_action(&Action.UnitB)));    // expect: 20
    io.int(@as(i64, inspect_action(&Action.Val(33))));  // expect: 33
    io.int(@as(i64, inspect_color(&Color.Red)));        // expect: 1
    io.int(@as(i64, inspect_color(&Color.Blue)));       // expect: 7
    io.int(@as(i64, inspect_int(&MY_CONST)));           // expect: 42
}
