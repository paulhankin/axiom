// x86-64 reuse_flags (before allocation) moves an `or` down to the test of
// its result and drops the test; a later test, of an `and` computed before
// the `or`, was then dropped too, as though the flags were still the
// `and`'s, and the `and` removed as dead. `(a or b) and (not c)`, with c an
// earlier `or` of comparisons, read the flags of c: true for a = b = false
// and c = false.
// flags: -O1
import "../lib/io.ax" as io;

struct Shape {
    f: u32,
    scale: f32,
    phases: u32,
    contexts: u32,
    rows: [6]u16,
    key: u32,
    heads: u32,

    fn extended(self: Shape) bool {
        return (self.key != 0) or (self.heads != 0);
    }
}

fn locals(p: u32, q: u32, k: u32, h: u32) bool {
    let c = (k != 0) or (h != 0);
    let v = ((p != 1) or (q != 1)) and (not c);
    return v;
}

fn fields(s: Shape) bool {
    let c = (s.key != 0) or (s.heads != 0);
    let v = ((s.phases != 1) or (s.contexts != 1)) and (not c);
    return v;
}

fn method(s: Shape) bool {
    let c = s.extended();
    let v = ((s.phases != 1) or (s.contexts != 1)) and (not c);
    return v;
}

fn method_inline(s: Shape) bool {
    return ((s.phases != 1) or (s.contexts != 1)) and not s.extended();
}

fn shape(phases: u32, contexts: u32, key: u32, heads: u32) Shape {
    return Shape.{ f: 64, scale: 4.0, phases: phases, contexts: contexts, rows: [0; 6], key: key, heads: heads };
}

export fn run() void {
    // (through pointers: the arguments are not constants in the callees)
    let ls = [locals, locals];
    let ss = [fields, method, method_inline];
    let cases: [5][4]u32 = [[1, 1, 0, 0], [4, 1, 0, 0], [1, 9, 0, 0], [4, 9, 1, 0], [1, 9, 0, 1]];
    for i in @as(usize, 0)..cases.len {
        let c = cases[i];
        io.boolean(ls[i & 1](c[0], c[1], c[2], c[3]));
        for k in @as(usize, 0)..ss.len {
            io.boolean(ss[k](shape(c[0], c[1], c[2], c[3])));
        }
    }
}
// expect: false
// expect: false
// expect: false
// expect: false
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
// expect: false
// expect: false
// expect: false
// expect: false
// expect: false
// expect: false
// expect: false
// expect: false
