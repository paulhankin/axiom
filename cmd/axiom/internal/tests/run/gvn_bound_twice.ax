// `7 - y` becomes `y ^ 7` only when y is known to be at most 7. The bound of
// `w ^ 7` used to ask for w's bound twice: with many values between w and
// the facts about it (the phis and selects here), the proof's budget could
// run out between the two, and the second answer, "not known", passed for a
// small one. w is 8 here: 7 - (7 ^ 8) is -8, not 8.
import "../lib/io.ax" as io;

fn f4(a0: i32, b0: i32, m: u8) i32 {
    let a = a0;
    let b = b0;
    let mut r: i32 = 4;
    let mut w: i32 = @as(i32, m);
    let g0: bool = a > 0;
    match (w & 3) {
        0 => {
            if g0 {
                w = ((w | 3) -% (r *% w));
            }
            match (w & 3) {
                1 => {}
                3 => { w = ((a | a) & (b +% 3)); }
                else => {}
            }
            match (w & 3) {
                0 => {}
                3 => {}
                else => {
                    let v: i32 = ((r & a) ^ (2 *% a));
                    if a > -2 {
                        r = r +% v;
                    } else {
                        w = w ^ v;
                    }
                }
            }
            if g0 {} else {
                let v: i32 = (7 -% (7 ^ w));
                r = r +% v;
            }
        }
        else => {}
    }
    return r +% w;
}

fn drive(gb: i32) i32 {
    let mut t: i32 = 0;
    for ia in @as(i32, -3)..-2 {
        for im in @as(i32, 8)..9 {
            t = (t *% 31) +% f4(ia, gb, @truncate(u8, im));
        }
    }
    return t;
}

let mut gp: fn(i32) i32 = drive;

export fn run() void {
    io.int(@as(i64, gp(-2)));
    let mut sum: i64 = 0;
    for ia in @as(i32, -3)..6 {
        for im in @as(i32, 0)..16 {
            sum += @as(i64, f4(ia, -2, @truncate(u8, im)));
        }
    }
    io.int(sum);
}

// expect: 4
// expect: 1604
