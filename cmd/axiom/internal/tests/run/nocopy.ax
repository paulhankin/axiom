// nocopy structs/unions, definite move, structural propagation, and @swap (spec §5.9, §8.5, §8.6).
import "../lib/io.ax" as io;

nocopy struct Big {
    a: u64,
    b: u64,
    c: u64,
    d: u64,
}

nocopy union Choice {
    num: Big,
    tag: i32,
    nothing,
}

struct Container {
    inner: Big,
    label: i32,
}

error {
    Failed,
}

fn sum_big(x: *Big) u64 {
    return x.a + x.b + x.c + x.d;
}

fn maybe_big(flag: bool) ?Big {
    if flag {
        return Big.{ a: 1, b: 2, c: 3, d: 4 };
    }
    return .none;
}

fn fallible_big(ok: bool) !Big {
    if ok {
        return Big.{ a: 10, b: 20, c: 30, d: 40 };
    }
    return error.Failed;
}

fn read_choice(c: *Choice) i64 {
    match c {
        .num(b)    => { return @int_cast(i64, b.a + b.d); }
        , .tag(t)  => { return @as(i64, t.*); }
        , .nothing => { return -1; }
        ,
    }
}

export fn run() void {
    // Valid scalar @swap
    let mut x: i32 = 10;
    let mut y: i32 = 25;
    @swap(&mut x, &mut y);
    io.int(@as(i64, x));  // expect: 25
    io.int(@as(i64, y));  // expect: 10

    // Valid >16B nocopy struct @swap + self-alias @swap
    let mut p = Big.{ a: 1, b: 2, c: 3, d: 4 };
    let mut q = Big.{ a: 5, b: 6, c: 7, d: 8 };
    @swap(&mut p, &mut q);
    io.uint(p.a + p.d);  // expect: 13
    io.uint(q.a + q.d);  // expect: 5
    @swap(&mut p, &mut p);
    io.uint(p.b + p.c);  // expect: 13

    // Local move into structural wrapper container
    let c = Container.{ inner: p, label: 99 };
    io.int(@as(i64, c.label));   // expect: 99
    io.uint(sum_big(&c.inner));  // expect: 26

    // Move of q in one branch, read in other branch
    let branch = true;
    if branch {
        let wrapped = [q];
        io.uint(sum_big(&wrapped[0]));  // expect: 10
    } else {
        io.uint(q.a);
    }

    // Reassignment restores local after move
    let mut r = Big.{ a: 2, b: 3, c: 4, d: 5 };
    let first = Container.{ inner: r, label: 1 };
    io.uint(sum_big(&first.inner));  // expect: 14
    r = Big.{ a: 7, b: 8, c: 9, d: 10 };
    io.uint(r.a + r.d);  // expect: 17

    // Structural propagation through arrays, optionals, error unions, and by-ref iteration
    let mut arr = [
        Big.{ a: 1, b: 1, c: 1, d: 1 },
        Big.{ a: 2, b: 2, c: 2, d: 2 },
    ];
    for &mut item in arr {
        item.a += 10;
    }
    let mut total: u64 = 0;
    for &item in arr {
        total += item.a;
    }
    io.uint(total);  // expect: 23

    let opt = maybe_big(true) ?? Big.{ a: 0, b: 0, c: 0, d: 0 };
    io.uint(opt.c);  // expect: 3

    let got = fallible_big(true) catch Big.{ a: 0, b: 0, c: 0, d: 0 };
    io.uint(got.b);  // expect: 20

    // nocopy union matched by pointer
    let u = Choice.num(Big.{ a: 11, b: 0, c: 0, d: 22 });
    io.int(read_choice(&u));  // expect: 33
}
