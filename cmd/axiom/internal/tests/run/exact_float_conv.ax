        h2 = h_u16(h2, @int_from_float(u16, x));
    }
    for i in 0..F_F32.len {
        let x = @bit_cast(f32, F_F32[i]);
        h3 = h_i16(h3, @int_from_float(i16, x));
    }
    for i in 0..FI_F32_I16.len {
        let x = @bit_cast(f32, FI_F32_I16[i]);
        h3 = h_i16(h3, @int_from_float(i16, x));
    }
    for i in 0..F_F32.len {
        let x = @bit_cast(f32, F_F32[i]);
        h4 = h_u32(h4, @int_from_float(u32, x));
    }
    for i in 0..FI_F32_U32.len {
        let x = @bit_cast(f32, FI_F32_U32[i]);
        h4 = h_u32(h4, @int_from_float(u32, x));
    }
    for i in 0..F_F32.len {
        let x = @bit_cast(f32, F_F32[i]);
        h5 = h_i32(h5, @int_from_float(i32, x));
    }
    for i in 0..FI_F32_I32.len {
        let x = @bit_cast(f32, FI_F32_I32[i]);
        h5 = h_i32(h5, @int_from_float(i32, x));
    }
    for i in 0..F_F32.len {
        let x = @bit_cast(f32, F_F32[i]);
        h6 = h_u64(h6, @int_from_float(u64, x));
    }
    for i in 0..FI_F32_U64.len {
        let x = @bit_cast(f32, FI_F32_U64[i]);
        h6 = h_u64(h6, @int_from_float(u64, x));
    }
    for i in 0..F_F32.len {
        let x = @bit_cast(f32, F_F32[i]);
        h7 = h_i64(h7, @int_from_float(i64, x));
    }
    for i in 0..FI_F32_I64.len {
        let x = @bit_cast(f32, FI_F32_I64[i]);
        h7 = h_i64(h7, @int_from_float(i64, x));
    }
    for i in 0..F_F32.len {
        let x = @bit_cast(f32, F_F32[i]);
        h8 = h_u32(h8, @bit_cast(u32, x));
        h9 = h_i32(h9, @bit_cast(i32, x));
        h10 = h_f64(h10, @as(f64, x));
