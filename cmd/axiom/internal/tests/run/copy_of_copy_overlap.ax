// A copy of a copy (cmd/axiom/src/copies.ax: copy_of_copy) copies the first
// one's source itself; through two pointers that may point into one object,
// the source and destination may then overlap, so the copy is a memmove.
// flags: -O1
import "../lib/io.ax" as io;

struct S {
    a: [8]u64,
}

struct T {
    a: [40]u64,  // (over 256 bytes: copied in a loop on x86-64)
}

// (recursive: not inlined)
fn mv_small(p: *mut S, q: *S, d: u32) void {
    if d > 0 {
        mv_small(p, q, d - 1);
        return;
    }
    let tmp = q.*;
    p.* = tmp;
}

// (recursive: not inlined)
fn mv(p: *mut T, q: *T, d: u32) void {
    if d > 0 {
        mv(p, q, d - 1);
        return;
    }
    let tmp = q.*;
    p.* = tmp;
}

fn fill(a: *mut [42]u64, d: u32) void {
    if d > 0 {
        fill(a, d - 1);
        return;
    }
    for i in @as(usize, 0)..42 {
        a[i] = @as(u64, i) + 1;
    }
}

let mut g: [42]u64 = [0; 42];
let mut fp: fn(*mut [42]u64, u32) void = fill;
let mut mp: fn(*mut T, *T, u32) void = mv;
let mut sp: fn(*mut S, *S, u32) void = mv_small;

fn show() void {
    let at: [8]usize = [0, 1, 2, 5, 20, 37, 40, 41];
    for i in at {
        io.uint(g[i]);
    }
}

export fn run() void {
    // one element up, then one down
    fp(&mut g, 1);
    sp(@ptr_cast(*mut S, &mut g[1]), @ptr_cast(*S, &g[0]), 1);
    show();
    // expect: 1
    // expect: 1
    // expect: 2
    // expect: 5
    // expect: 21
    // expect: 38
    // expect: 41
    // expect: 42
    fp(&mut g, 1);
    mp(@ptr_cast(*mut T, &mut g[1]), @ptr_cast(*T, &g[0]), 1);
    show();
    // expect: 1
    // expect: 1
    // expect: 2
    // expect: 5
    // expect: 20
    // expect: 37
    // expect: 40
    // expect: 42
    fp(&mut g, 1);
    mp(@ptr_cast(*mut T, &mut g[0]), @ptr_cast(*T, &g[1]), 1);
    show();
    // expect: 2
    // expect: 3
    // expect: 4
    // expect: 7
    // expect: 22
    // expect: 39
    // expect: 41
    // expect: 42
}
