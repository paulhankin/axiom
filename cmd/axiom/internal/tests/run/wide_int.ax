// Wide-integer arithmetic builtins: @mul_wide, @mul_high, @add_carry,
// @sub_borrow, and @div_wide across concrete and generic types.
import "../lib/io.ax" as io;

fn mul_hi_gen[T: Int](a: T, b: T) T {
    return @mul_high(a, b);
}

fn mul_wide_lo_gen[T: Int](a: T, b: T) T {
    return @mul_wide(a, b).lo;
}

fn add_chain[T: UnsignedInt](a: T, b: T, c: u8) u8 {
    let r = @add_carry(a, b, c);
    return r.carry;
}

export fn run() void {
    let mw64 = @mul_wide(@as(u64, 0xFFFF_FFFF_FFFF_FFFF), @as(u64, 0xFFFF_FFFF_FFFF_FFFF));
    io.uint(mw64.lo);  // expect: 1
    io.uint(mw64.hi);  // expect: 18446744073709551614

    let smw64 = @mul_wide(@as(i64, -0x4000_0000_0000_0000), @as(i64, 4));
    io.int(smw64.lo);  // expect: 0
    io.int(smw64.hi);  // expect: -1

    io.uint(@mul_high(@as(u64, 0x1_0000_0000), @as(u64, 0x1_0000_0000)));  // expect: 1
    io.int(@mul_high(@as(i64, -1), @as(i64, 1)));  // expect: -1
    io.uint(@as(u64, mul_hi_gen(@as(u32, 0x10000), @as(u32, 0x20000))));  // expect: 2
    io.uint(mul_wide_lo_gen(@as(u64, 7), @as(u64, 9)));                   // expect: 63

    let ac = @add_carry(@as(u64, 0xFFFF_FFFF_FFFF_FFFF), @as(u64, 0), 1);
    io.uint(ac.value);            // expect: 0
    io.uint(@as(u64, ac.carry));  // expect: 1
    io.uint(@as(u64, add_chain(@as(u32, 0xFFFF_FFFF), @as(u32, 0), 3)));  // expect: 1

    let sb = @sub_borrow(@as(u64, 0), @as(u64, 0), 1);
    io.uint(sb.value);             // expect: 18446744073709551615
    io.uint(@as(u64, sb.borrow));  // expect: 1

    let dw = @div_wide(@as(u64, 1), @as(u64, 0), @as(u64, 3));
    io.uint(dw.quo);  // expect: 6148914691236517205
    io.uint(dw.rem);  // expect: 1

    let dw32 = @div_wide(@as(u32, 2), @as(u32, 5), @as(u32, 3));
    io.uint(@as(u64, dw32.quo));  // expect: 2863311532
    io.uint(@as(u64, dw32.rem));  // expect: 1
}
