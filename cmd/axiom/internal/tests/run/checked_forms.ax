            h = h *% 31 +% 7;
            continue;
        };
        h = h *% 31 +% @bit_cast(u64, @as(i64, r));
    }
    for i in 0..V_I64.len {
        let r = @mul_checked(V_I64[i], 7) catch {
            n += 1;
            h = h *% 31 +% 7;
            continue;
        };
        h = h *% 31 +% @bit_cast(u64, @as(i64, r));
    }
    for i in 0..V_I64.len {
        let r = @mul_checked(V_I64[i], 9223372036854775807) catch {
            n += 1;
            h = h *% 31 +% 7;
            continue;
        };
        h = h *% 31 +% @bit_cast(u64, @as(i64, r));
    }
    io.uint(n);
    io.uint(h);
}

fn mul_sat_i64() void {
    let mut h: u64 = 0;
    for i in 0..V_I64.len {
        for j in 0..V_I64.len {
            let r = @mul_sat(V_I64[i], V_I64[j]);
            h = h *% 31 +% @bit_cast(u64, @as(i64, r));
        }
    }
    io.uint(h);
}

