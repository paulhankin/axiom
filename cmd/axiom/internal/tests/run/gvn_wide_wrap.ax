// A 64-bit product wraps around too: `x *% 3` need not be a multiple of 3
// (0x5555_5555_5555_5556 *% 3 is 2), nor `x *% 3` scaled by an element's
// size a multiple of three elements. The stores through them must not be
// taken as missing the element read (gvn proving offsets apart modulo 3).
// flags: -O1
import "../lib/io.ax" as io;

fn bytes(x: u64) u64 {
    let mut buf: [8]u8 = [0; 8];
    buf[2] = 1;
    buf[@int_cast(usize, x *% 3)] = 9;
    return @as(u64, buf[2]);
}

fn words(x: u64) u64 {
    let mut buf: [8]u32 = [0; 8];
    buf[2] = 1;
    buf[@int_cast(usize, x *% 3)] = 9;
    return @as(u64, buf[2]);
}

let mut B: fn(u64) u64 = bytes;
let mut W: fn(u64) u64 = words;

export fn run() void {
    io.uint(B(0x5555_5555_5555_5556));  // expect: 9
    io.uint(W(0x5555_5555_5555_5556));  // expect: 9
    io.uint(W(1));                      // expect: 1
}
