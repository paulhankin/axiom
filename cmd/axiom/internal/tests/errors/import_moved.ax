// expect-error: E0211
// A module that left the standard library (spec §4.1): the machine fix
// imports it where it is now, in lib/ or, for the digests, in std/hash.
import "lib/encoding/hex" as hex;
import "std/crypto/sha2" as sha2;
import "std/encoding/base64" as base64;

export fn main() i32 {
    let mut d: [32]u8 = [0; 32];
    sha2.sha256("abc", d[..]);
    let mut out: [8]u8 = [0; 8];
    let h = hex.encode(d[..4], out[..]);
    return @int_cast(i32, h.len + base64.encoded_len(3));
}
