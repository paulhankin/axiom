// A function's locals may take at most 1 GiB of stack (spec §12.2), each of
// them fitting, or an instance of a generic function.
// expect-error: E0473
// flags: --units=program
let mut gk: usize = 0;

fn big(k: usize) u8 {
    let mut a: [400000000]u8 = undefined;
    let mut b: [400000000]u8 = undefined;
    let mut c: [400000000]u8 = undefined;
    a[k] = 1;
    b[k] = 2;
    c[k] = 3;
    return a[k] + b[k] + c[k];
}

fn sized[const N: usize](k: usize) u8 {
    let mut a: [N]u8 = undefined;
    a[k] = 4;
    return a[k];
}

export fn main() i32 {
    let k = @atomic_load(&gk);
    return @as(i32, big(k)) + @as(i32, sized.[2000000000](k));
}
