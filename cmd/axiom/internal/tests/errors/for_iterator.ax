// expect-error: E0412
// `for` does not call `next`: the machine fix writes the loop with `while let`
struct Count {
    n: i32,

    pub fn next(self: *mut Count) ?i32 {
        if self.n >= 3 {
            return .none;
        }
        self.n += 1;
        return self.n;
    }
}

fn f() i32 {
    let mut c = Count.{ n: 0 };
    let mut t: i32 = 0;
    outer: for v in c {
        if v == 2 {
            continue outer;
        }
        t += v;
    }
    return t;
}
