// A generic struct whose instance is larger than the target's largest object
// (spec §5.5), made only where a generic function is instantiated: the
// instance is checked as a type written there would be. (On wasm32 its
// size, 2^32 + 8, was taken as 8: the allocation was 8 bytes while checked
// indexing allowed the whole array.)
// expect-error: E0473
// flags: --units=program
// wasm-only
import "std/mem" as mem;

struct G[const N: usize] {
    a: [N]u64,
}

let mut gi: usize = 0;

fn work[const N: usize](i: usize) u64 {
    let p = mem.new.[G.[N]]() catch {
        return 0;
    };
    p.a[i] = 1;
    return p.a[i];
}

export fn main() i32 {
    return @as(i32, @truncate(u8, work.[0x2000_0001](@atomic_load(&gi))));
}
