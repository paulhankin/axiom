fn f(p: *u32, n: u32, s: []u32, a: [4]u32) void {
    @prefetch(n);
    @prefetch(s);
    @prefetch(a);
    @prefetch(p, 1);
    @prefetch();
    let x: u32 = @prefetch(p);
    @prefetch_write(n);
    @prefetch_write(p, 1);
    let y: u32 = @prefetch_write(p);
}
