// expect-error: E0176
// (nested, in an expression: one error, whose fix rewrites both lists)
struct Pair[T] {
    a: T,
    b: T,

    fn of(a: T, b: T) Self {
        return Self.{ a: a, b: b };
    }
}

fn f() i32 {
    let p = Pair<Pair<i32>>.of(Pair.[i32].of(1, 2), Pair.[i32].of(3, 4));
    return p.a.a;
}
