// An error union of a generic type, made by instantiation, larger than a
// wasm32 object (spec §5.5): T fits, but !T does not.
// expect-error: E0473
// flags: --units=program
// wasm-only
fn as_result[T](p: *T) *!T {
    return @ptr_cast(*!T, p);
}

let mut gi: usize = 0;

export fn main() i32 {
    let p = @ptr_from_int(*[0x7fff_fffe]u8, 0x10000 + @atomic_load(&gi));
    let r = as_result.[[0x7fff_fffe]u8](p);
    return @as(i32, @truncate(u8, @int_from_ptr(r)));
}
