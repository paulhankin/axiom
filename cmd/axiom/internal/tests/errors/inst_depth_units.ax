// An error found in code generation, compiling a module in a process of its
// own (--units=module), is reported by the build: in one JSON document, the
// error's own.
// expect-error: E0465
// flags: --units=module
struct Box[T] {
    v: T,
}

fn deep[T](x: T) u32 {
    return deep(Box.[T].{ v: x }) + 1;
}

export fn f() u32 {
    return deep(@as(u32, 1));
}
