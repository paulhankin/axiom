// Dead-error warning W0655 on concrete non-generic inline error sets (spec §11.3).
import "../lib/io.ax" as io;

error NamedSet { NamedUsed, NamedDead }

fn only_used(x: i32) { Used, Unused }!i32 {  // expect-warning: W0655
    if x < 0 {
        return error.Used;
    }
    return x;
}

fn leaf_alpha(x: i32) { Alpha }!i32 {
    if x == 0 {
        return error.Alpha;
    }
    return x + 1;
}

fn dead_via_prop(x: i32) { Alpha, Beta, Gamma }!i32 {  // expect-warning: W0655
    let v = leaf_alpha(x)!;
    return v * 2;
}

fn all_used(x: i32) { Used, Alpha }!i32 {
    if x == 1 {
        return error.Used;
    }
    if x == 2 {
        return error.Alpha;
    }
    return x;
}

fn named_allowed(x: i32) NamedSet!i32 {
    if x == 0 {
        return error.NamedUsed;
    }
    return x;
}

fn generic_inline[T](v: T, fail: bool) { GenUsed, GenUnused }!T {
    if fail {
        return error.GenUsed;
    }
    return v;
}

fn check_only_used(x: i32) i32 {
    let v = only_used(x) catch |e| {
        io.str(@error_name(e));
        return -1;
    };
    return v;
}

fn check_dead_prop(x: i32) i32 {
    let v = dead_via_prop(x) catch |e| {
        io.str(@error_name(e));
        return -2;
    };
    return v;
}

fn check_all_used(x: i32) i32 {
    let v = all_used(x) catch |e| {
        io.str(@error_name(e));
        return -3;
    };
    return v;
}

fn check_named(x: i32) i32 {
    let v = named_allowed(x) catch |e| {
        io.str(@error_name(e));
        return -4;
    };
    return v;
}

fn check_generic(x: i32, fail: bool) i32 {
    let v = generic_inline(x, fail) catch |e| {
        io.str(@error_name(e));
        return -5;
    };
    return v;
}

export fn run() void {
    io.int(@as(i64, check_only_used(-1)));
    // expect: Used
    // expect: -1
    io.int(@as(i64, check_only_used(5)));  // expect: 5
    io.int(@as(i64, check_dead_prop(0)));
    // expect: Alpha
    // expect: -2
    io.int(@as(i64, check_dead_prop(3)));  // expect: 8
    io.int(@as(i64, check_all_used(1)));
    // expect: Used
    // expect: -3
    io.int(@as(i64, check_all_used(2)));
    // expect: Alpha
    // expect: -3
    io.int(@as(i64, check_named(0)));
    // expect: NamedUsed
    // expect: -4
    io.int(@as(i64, check_named(9)));  // expect: 9
    io.int(@as(i64, check_generic(7, true)));
    // expect: GenUsed
    // expect: -5
    io.int(@as(i64, check_generic(7, false)));  // expect: 7
}
