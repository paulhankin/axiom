// W0601: a statement after one that never completes; W0631: a match arm
// after `else`.
import "../lib/io.ax" as io;

enum Color {
    Red,
    Green,
    Blue,
}

fn first(x: i64) i64 {
    return x;
    io.int(x);  // expect-warning: W0601
}

fn name(c: Color) i64 {
    match c {
        .Red  => { return 1; }
        else  => { return 2; }
        .Blue => { return 3; }  // expect-warning: W0631
    }
}

export fn run() void {
    io.int(first(4));           // expect: 4
    io.int(name(Color.Green));  // expect: 2
}
