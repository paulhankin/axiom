// expect-error: E0709
nocopy struct Boxed {
    val: i32,
}

struct Holder {
    inner: Boxed,
}

fn touch(v: i32) void {
    _ = v;
}

fn bad_direct() i32 {
    let b = Boxed.{ val: 7 };
    let h = Holder.{ inner: b };
    return h.inner.val + b.val;
}

fn bad_branch(cond: bool) i32 {
    let b = Boxed.{ val: 9 };
    if cond {
        _ = Holder.{ inner: b };
    }
    return b.val;
}

fn bad_loop(n: i32) i32 {
    let b = Boxed.{ val: 3 };
    let mut i: i32 = 0;
    while i < n {
        _ = Holder.{ inner: b };
        i += 1;
    }
    return i;
}
