// expect-error: E0412
// a temporary iterator: the suggestion declares a variable for it, before
// the loop's label
struct Count {
    n: i32,

    pub fn next(self: *mut Count) ?i32 {
        if self.n >= 3 {
            return .none;
        }
        self.n += 1;
        return self.n;
    }
}

fn count() Count {
    return Count.{ n: 0 };
}

fn f() i32 {
    let mut t: i32 = 0;
    rows: for v in count() {
        t += v;
    }
    return t;
}
