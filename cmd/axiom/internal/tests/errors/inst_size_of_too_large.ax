// @size_of of a generic instance larger than a wasm32 object (spec §5.5):
// its size does not fit in a usize, so it is E0473 rather than a truncated
// size (8 here) next to an unchanged bound, which let checked indexing
// write past the allocation.
// expect-error: E0473
// flags: --units=program
// wasm-only
struct G[const N: usize] {
    a: [N]u64,
}

fn size[const N: usize]() usize {
    return @size_of(G.[N]);
}

export fn main() i32 {
    return @as(i32, @truncate(u8, size.[0x2000_0001]()));
}
