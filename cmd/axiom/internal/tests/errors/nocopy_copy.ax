// expect-error: E0708
nocopy struct Resource {
    id: u64,
}

nocopy union Handle {
    fd: i32,
    empty,
}

struct Wrapper {
    res: Resource,
}

fn copy_via_ptr(p: *Resource) Resource {
    return p.*;
}

fn copy_array_repeat() [2]Resource {
    return [Resource.{ id: 1 }; 2];
}

fn copy_wrapper(p: *Wrapper) Wrapper {
    return p.*;
}

fn copy_field(p: *Wrapper) Resource {
    return p.res;
}

fn copy_union_match(u: *Handle) i32 {
    match u.* {
        .fd(x)   => { return x; }
        , .empty => { return 0; }
        ,
    }
}
