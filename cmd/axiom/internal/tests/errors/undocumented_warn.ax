// W0320 (off by default; --warn=W0320): a public item, or a public method of
// a public type, without documentation; private items need none.
// flags: --warn=W0320
import "../lib/io.ax" as io;

/// Documented.
pub fn documented() i64 {
    return 1;
}

pub fn bare() i64 {  // expect-warning: W0320
    return 2;
}

/// The limit.
pub const LIMIT: i64 = 3;

pub const BARE: i64 = 4;  // expect-warning: W0320 (a comment after it is not documentation)

/// A type.
pub struct Box {
    pub v: i64,

    /// Its value.
    pub fn get(self: *Box) i64 {
        return self.v;
    }

    pub fn twice(self: *Box) i64 {  // expect-warning: W0320
        return self.v * 2;
    }

    fn private_method(self: *Box) i64 {
        return self.v;
    }
}

pub enum Color {  // expect-warning: W0320
    Red,
    Green,
}

fn private_fn() i64 {
    return 5;
}

export fn run() void {
    let b = Box.{ v: 6 };
    io.int(documented() + bare() + LIMIT + BARE + b.get() + b.twice() + b.private_method() + private_fn());
    // expect: 39
    _ = Color.Green;
}
