// Types larger than the target's largest object (spec §5.5): their sizes
// would not fit in an address or an offset.
// expect-error: E0473
struct Huge {
    a: [0x4000_0000_0000]u64,
    b: [0x4000_0000_0000]u64,
}

struct Wrap[const N: usize] {
    xs: [N]u64,
}

fn f(k: usize) u64 {
    let mut w: Wrap.[0x2000_0000_0000_0000] = undefined;
    let mut b: [0x2000_0000_0000_0000]u64 = undefined;
    return w.xs[k] + b[k];
}

export fn main() i32 {
    return @as(i32, @truncate(u8, f(0) + @as(u64, @size_of(Huge))));
}
