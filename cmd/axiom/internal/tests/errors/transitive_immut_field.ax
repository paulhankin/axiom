// expect-error: E0707
struct Buf {
    data: []mut u8,
    ptr: *mut u32,
    opt: ?*mut u32,

    pub fn items(self: *Self) []mut u8 {
        return self.data;
    }

    pub fn ptr_mut(self: *Self) *mut u32 {
        return self.ptr;
    }

    pub fn opt_mut(self: *Self) ?*mut u32 {
        return self.opt;
    }
}

fn from_slice(xs: []Buf) []mut u8 {
    return xs[0].data;
}

fn from_deref(p: *[]mut u8) []mut u8 {
    return p.*;
}
