// Negative tests for inline error sets, error-set generics, and infer!T (spec §11.3).
error { NotInSet }

fn f() { OnlyThis }!i32 {
    return error.NotInSet;  // expect-error: E0652
}

fn ab_source(x: i32) { A, B }!i32 {
    if x == 1 {
        return error.A;
    }
    if x == 2 {
        return error.B;
    }
    return x;
}

fn g(x: i32) { A }!i32 {
    if x == 0 {
        return error.A;
    }
    return ab_source(x)!;  // expect-error: E0653
}

pub fn pub_infer() infer!i32 {  // expect-error: E0654
    return 1;
}

export fn exp_infer() infer!i32 {  // expect-error: E0654
    return 1;
}

fn bad_local() void {
    let x: infer!i32 = 1;  // expect-error: E0654
    _ = x;
}

fn id_err[error E]() E!i32 {
    return 1;
}

fn call_bad_err_arg() !i32 {
    return id_err.[i32]();  // expect-error: E0654
}

fn bad_generic[error E](x: E) { A } {
    return x;  // expect-error: E0653
}

fn bad_generic_union[error E](r: E!i32) { A }!i32 {
    return r;  // expect-error: E0653
}

export fn run() void {}
