// A generic union instance larger than a wasm32 object (spec §5.5): the
// payload fits, but not with the tag.
// expect-error: E0473
// flags: --units=program
// wasm-only
union Maybe[T] {
    Some: T,
    None,
}

fn size_with_tag[T]() usize {
    return @size_of(Maybe.[T]);
}

export fn main() i32 {
    return @as(i32, @truncate(u8, size_with_tag.[[0x7fff_ffff]u8]()));
}
