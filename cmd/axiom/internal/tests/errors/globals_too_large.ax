// The globals together must fit the target's largest object too (spec
// §5.5): each of these does, but not all three in one wasm32 memory.
// expect-error: E0473
// wasm-only
let mut a: [0x6000_0000]u8 = [0; 0x6000_0000];
let mut b: [0x6000_0000]u8 = [0; 0x6000_0000];
let mut c: [0x6000_0000]u8 = [0; 0x6000_0000];

export fn main() i32 {
    return @as(i32, a[0] + b[0] + c[0]);
}
