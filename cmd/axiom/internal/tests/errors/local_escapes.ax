// W0710 (spec §12.2): a returned address of a local, or slice of a local
// array, dangles once the function returns. The program still builds and
// runs; addresses of globals, and of what a pointer or slice reaches, are
// not warned about.
import "../lib/io.ax" as io;

struct Pair {
    a: u64,
    b: [4]u64,
}

let mut g: Pair = Pair.{ a: 1, b: [2, 3, 4, 5] };

fn addr_of_local() *u64 {
    let x: u64 = 5;
    return &x;  // expect-warning: W0710
}

fn addr_of_field() *mut u64 {
    let mut p = Pair.{ a: 1, b: [0; 4] };
    p.a = 2;
    return &mut p.b[1];  // expect-warning: W0710
}

fn slice_of_local() []u64 {
    let xs: [4]u64 = [1, 2, 3, 4];
    return xs[1..3];  // expect-warning: W0710
}

fn slice_of_param(xs: [4]u64) []u64 {
    return xs[..];  // expect-warning: W0710
}

fn maybe(k: u64) !*u64 {
    let x: u64 = k;
    if k == 0 {
        return error.Zero;
    }
    return &x;  // expect-warning: W0710
}

// none of these dangles
fn global_field() *mut u64 {
    return &mut g.b[2];
}

fn through_pointer(p: *mut Pair) *mut u64 {
    return &mut p.b[0];
}

fn through_slice(s: []u64) []u64 {
    return s[1..];
}

fn of_slice(s: []u64) *u64 {
    return &s[0];
}

fn self_ptr(p: *Pair) []u64 {
    return p.b[..];
}

error {
    Zero,
}

export fn run() void {
    _ = addr_of_local();
    _ = addr_of_field();
    _ = slice_of_local();
    _ = slice_of_param([1, 2, 3, 4]);
    _ = maybe(0) catch null_ptr();
    io.uint(global_field().*);                      // expect: 4
    io.uint(through_pointer(&mut g).*);             // expect: 2
    io.uint(@as(u64, through_slice(g.b[..]).len));  // expect: 3
    io.uint(of_slice(g.b[..]).*);                   // expect: 2
    io.uint(@as(u64, self_ptr(&g).len));            // expect: 4
}

fn null_ptr() *u64 {
    return &g.a;
}
