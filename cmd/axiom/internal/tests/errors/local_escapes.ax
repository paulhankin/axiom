// E0710 (spec §12.2): returning, or storing into a global or caller-reachable
// place, a pointer or slice derived from a local variable (including parameters)
// is a compile error. Addresses of globals, and of what a parameter pointer or
// slice reaches, are allowed.

struct Pair {
    a: u64,
    b: [4]u64,
}

struct Wrap {
    p: *u64,
}

struct SliceWrap {
    s: []u64,
}

let mut g: Pair = Pair.{ a: 1, b: [2, 3, 4, 5] };
let mut gp: *u64 = @ptr_from_int(*u64, 0);
let mut gs: []u64 = [];

fn addr_of_local() *u64 {
    let x: u64 = 5;
    return &x;  // expect-error: E0710
}

fn addr_of_field() *mut u64 {
    let mut p = Pair.{ a: 1, b: [0; 4] };
    p.a = 2;
    return &mut p.b[1];  // expect-error: E0710
}

fn slice_of_local() []u64 {
    let xs: [4]u64 = [1, 2, 3, 4];
    return xs[1..3];  // expect-error: E0710
}

fn slice_of_param(xs: [4]u64) []u64 {
    return xs[..];  // expect-error: E0710
}

fn maybe(k: u64) !*u64 {
    let x: u64 = k;
    if k == 0 {
        return error.Zero;
    }
    return &x;  // expect-error: E0710
}

fn opt_local(k: u64) ?*u64 {
    let x: u64 = k;
    if k == 0 {
        return .none;
    }
    let p: ?*u64 = .some(&x);
    return p;  // expect-error: E0710
}

fn let_alias() *u64 {
    let x: u64 = 5;
    let p = &x;
    return p;  // expect-error: E0710
}

fn branch_assign(cond: bool) *u64 {
    let x: u64 = 5;
    let mut p: *u64 = &g.a;
    if cond {
        p = &x;
    }
    return p;  // expect-error: E0710
}

fn slice_of_slice() []u64 {
    let xs: [4]u64 = [1, 2, 3, 4];
    let s = xs[1..];
    return s[..1];  // expect-error: E0710
}

fn struct_field_escape() *u64 {
    let x: u64 = 5;
    let w = Wrap.{ p: &x };
    return w.p;  // expect-error: E0710
}

fn array_elem_escape() *u64 {
    let x: u64 = 5;
    let arr: [2]*u64 = [&g.a, &x];
    return arr[1];  // expect-error: E0710
}

fn store_ptr_global() void {
    let x: u64 = 5;
    gp = &x;  // expect-error: E0710
}

fn store_slice_global() void {
    let buf: [4]u64 = [1, 2, 3, 4];
    gs = buf[..];  // expect-error: E0710
}

fn store_into_out_ptr(out: *mut *u64) void {
    let x: u64 = 5;
    out.* = &x;  // expect-error: E0710
}

fn store_into_out_slice(out_slice: []mut *u64) void {
    let x: u64 = 5;
    out_slice[0] = &x;  // expect-error: E0710
}

fn store_into_out_field(out: *mut SliceWrap) void {
    let buf: [4]u64 = [1, 2, 3, 4];
    out.s = buf[1..3];  // expect-error: E0710
}

// none of these dangles
fn global_field() *mut u64 {
    return &mut g.b[2];
}

fn through_pointer(p: *mut Pair) *mut u64 {
    return &mut p.b[0];
}

fn through_slice(s: []u64) []u64 {
    return s[1..];
}

fn of_slice(s: []u64) *u64 {
    return &s[0];
}

fn self_ptr(p: *Pair) []u64 {
    return p.b[..];
}

error {
    Zero,
}
