fn f(a: f32x4, b: u32x8, c: u16x8, d: i32x4, s: []u8) void {
    _ = @swizzle(a, b);
    _ = @vec(u32x4, 1, 2, 3, 4) << c;
    _ = c >> @vec(i16x8, 1, 1, 1, 1, 1, 1, 1, 1);
    _ = @float_from_int(f32x4, b);
    _ = @load_partial(f32x4, s);
    _ = @int_from_float(i32x8, a);
}
