// An array type made by instantiation ([N][N]u64, each row of which fits)
// larger than the target's largest object (spec §5.5).
// expect-error: E0473
// flags: --units=program
import "std/mem" as mem;

let mut gi: usize = 0;

fn grid[const N: usize](i: usize) u64 {
    let p = mem.new.[[N][N]u64]() catch {
        return 0;
    };
    p[i][i] = 1;
    return p[i][i];
}

export fn run() void {
    _ = grid.[0x100_0000](@atomic_load(&gi));
}
