// expect-error: E0412
// through a pointer to the iterator, and a fallible one (a suggestion: the
// function must be able to pass the error on)
error Bad {
    Odd,
}

struct Count {
    n: i32,

    pub fn next(self: *mut Count) Bad!?i32 {
        if self.n >= 3 {
            return .none;
        }
        self.n += 1;
        return self.n;
    }
}

fn f(c: *mut Count) Bad!i32 {
    let mut t: i32 = 0;
    for v in c {
        t += v;
    }
    return t;
}
