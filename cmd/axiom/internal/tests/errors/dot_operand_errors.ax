// expect-error: E0412
// expect-error: E0202
// expect-error: E0812
// @dot with operands reported already says no more about them (no
// "discarded" error for a statement, no E0812 after a literal that did not
// fit), and both compilers word E0812 alike.
fn f(n: bool, one: i16x32, k: i16x32) void {
    _ = @dot(n, one);
    _ = @dot(n, 1);
    _ = @dot(n, nope);
    @dot(k, nope);
    _ = @dot(n, n);
}
