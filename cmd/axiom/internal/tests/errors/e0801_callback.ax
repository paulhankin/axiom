// A function type at the C boundary is checked like the function itself: C
// calls a callback with its own calling convention, which passes a struct
// (or a slice) differently from Axiom.
// expect-error: E0801
struct P {
    x: f64,
    y: f64,
    z: f64,
}

extern "C" {
    fn sort_points(p: *mut P, n: usize, cmp: fn(P, P) i32) void;  // a struct parameter
}

export fn takes(cb: fn(i32) []u8) void {  // a slice result
    _ = cb;
}

export fn fine(cb: fn(*P, i32) void, n: i32) void {  // pointers and scalars: allowed
    _ = cb;
    _ = n;
}

export fn main() i32 {
    return 0;
}
