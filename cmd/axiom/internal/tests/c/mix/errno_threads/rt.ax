// The threads of errno_threads/main.c.
import "std/collections/vec.ax" as vec;
import "std/thread" as thread;

struct Job {
    id: i32,
    work: fn(i32) void,
}

fn run(j: Job) void {
    j.work(j.id);
}

// Runs work(0) .. work(n - 1), each in a thread of its own, at once.
export fn rt_run_threads(n: i32, work: fn(i32) void) void {
    let mut ts = vec.Vec.[thread.Thread.[Job]].init();
    defer ts.deinit();
    for i in @as(i32, 0)..n {
        let t = thread.spawn(run, Job.{ id: i, work: work }) catch {
            return;
        };
        ts.push(t) catch {
            t.join();
            return;
        };
    }
    for i in 0..ts.len {
        ts.get(i).join();
    }
}
