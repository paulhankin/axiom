// The Axiom side of structs/: the C structures by pointer, laid out as C
// lays them out (spec §5.9, §14.5.3).
struct Small {
    a: i32,
    b: i32,
}

struct Large {
    v: [5]i64,
    tag: i32,
}

struct Mixed {
    d: f64,
    i: i32,
    c: u8,
}

export fn ax_small_sum(s: *Small) i64 {
    return @as(i64, s.a + s.b);
}

export fn ax_large_sum(l: *Large) i64 {
    let mut t: i64 = 0;
    for x in l.v {
        t += x;
    }
    return t;
}

export fn ax_mixed_sum(m: *Mixed) f64 {
    return m.d + @float_from_int(f64, @as(i64, m.i)) + @float_from_int(f64, @as(i64, m.c));
}

export fn ax_mixed_set(m: *mut Mixed) void {
    m.d = -1.5;
    m.i = 77;
    m.c = 66;
}
