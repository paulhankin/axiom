// The Axiom module of c_main/main.c: functions with C names, using the
// runtime's allocator and threads.
import "std/mem" as mem;
import "std/thread" as thread;

extern "C" {
    fn print_i64(x: i64) void;
    fn print_str(p: *u8, n: usize) void;
}

export fn rt_alloc(n: usize) *mut void {
    let s = mem.alloc.[u8](n) catch {
        return @ptr_from_int(*mut void, 0);
    };
    return @ptr_cast(*mut void, s.ptr);
}

export fn rt_free(p: *mut void, n: usize) void {
    mem.free(@slice_from_ptr(@ptr_cast(*mut u8, p), n));
}

export fn rt_apply(f: fn(i32) i32, x: i32) i32 {
    return f(x);
}

export fn rt_sum_list(xs: *i64, n: usize) i64 {
    let mut s: i64 = 0;
    for x in @slice_from_ptr(xs, n) {
        s += x;
    }
    return s;
}

fn hook(x: i64) void {
    let mut buf: [8]u8 = [0; 8];
    buf[0] = 'h';
    buf[1] = 'o';
    buf[2] = 'o';
    buf[3] = 'k';
    print_str(&buf[0], 4);
    print_i64(x);
}

// An Axiom function as a C function pointer.
export fn rt_hook() fn(i64) void {
    return hook;
}

struct Slot {
    v: i64,
    out: *mut i64,
}

fn work(s: Slot) void {
    s.out.* = s.v;
}

// 0 + 1 + ... + (n - 1), each term from a thread of its own (native; one
// thread at a time on WebAssembly, which runs it as a plain call).
export fn rt_sum_threads(n: i32) i64 {
    let mut outs: [8]i64 = [0; 8];
    let k = @as(usize, @bit_cast(u32, n));
    for i in 0..k {
        let t = thread.spawn(work, Slot.{ v: @bit_cast(i64, @as(u64, i)), out: &mut outs[i] }) catch {
            return -1;
        };
        t.join();
    }
    let mut s: i64 = 0;
    for i in 0..k {
        s += outs[i];
    }
    return s;
}
