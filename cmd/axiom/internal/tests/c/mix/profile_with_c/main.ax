// axiom profile of an Axiom program with C units: it runs, its samples
// written as folded stacks.
// axiom-profile
// expect-report: folded stacks:
extern "C" {
    fn c_work(n: i64) i64;
}

export fn main() i32 {
    let r = c_work(3000000);
    if r == 0 {
        return 1;
    }
    return 0;
}
