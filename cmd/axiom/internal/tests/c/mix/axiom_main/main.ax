// An Axiom program with C translation units (docs/c.md, "C and Axiom in one
// program"): Axiom calls C through extern "C" with the C ABI, C calls the
// Axiom program's export fns, both pass each other callbacks, and data is
// shared through pointers (an Axiom struct is a C struct).
import "../print.ax" as p;

// print.ax's exports, by their C names (an Axiom module's export fn is a C
// function for Axiom code too)
extern "C" {
    fn print_i64(x: i64) void;
    fn print_u64(x: u64) void;
    fn print_bool(b: bool) void;
    fn print_f64(x: f64) void;
    fn print_cstr(s: *u8) void;
}

pub struct Pair {
    a: i32,
    b: f64,
    flag: bool,
    small: u16,
}

extern "C" {
    fn c_add(a: i32, b: i32) i32;
    fn c_neg8(x: i8) i8;
    fn c_hi(x: u32) u16;
    fn c_is_odd(x: i64) bool;
    fn c_mix(a: f32, b: f64, c: i64, d: u8) f64;
    fn c_sum(n: i32, ...) i64;
    fn c_apply(f: fn(i32) i32, x: i32) i32;
    fn c_fill(p: *mut Pair) void;
    fn c_counter() *mut i32;
    fn c_greeting() *u8;
    fn c_calls_axiom(x: i32) i32;
    fn c_make_adder() fn(i32) i32;
    fn c_sort3(xs: *mut i32) void;
}

// Called by C, by name.
export fn ax_triple(x: i32) i32 {
    return x * 3;
}

export fn ax_small(x: i8) i8 {
    return x - 1;
}

export fn ax_pair_sum(q: *Pair) f64 {
    return @float_from_int(f64, @as(i64, q.a)) + q.b + @float_from_int(f64, @as(i64, q.small));
}

// A comparison C's sort calls back.
export fn ax_less(a: i32, b: i32) bool {
    return a < b;
}

fn plus_ten(x: i32) i32 {
    return x + 10;
}

export fn main() i32 {
    p.linked();
    print_i64(@as(i64, c_add(40, 2)));      // expect: 42
    print_i64(@as(i64, c_neg8(-128)));      // expect: -128
    print_i64(@as(i64, c_neg8(5)));         // expect: -5
    print_u64(@as(u64, c_hi(0xabcd1234)));  // expect: 43981
    print_bool(c_is_odd(7));                // expect: true
    print_bool(c_is_odd(-4));               // expect: false
    print_f64(c_mix(1.5, 0.25, -3, 250));   // expect: 248.75
    print_i64(c_sum(4, @as(i64, 1), @as(i64, 20), @as(i64, 300), @as(i64, 4000)));  // expect: 4321
    print_i64(@as(i64, c_apply(plus_ten, 5)));  // expect: 15
    let mut q = Pair.{ a: 0, b: 0.0, flag: false, small: 0 };
    c_fill(&mut q);
    print_i64(@as(i64, q.a));      // expect: 7
    print_f64(q.b);                // expect: 0.5
    print_bool(q.flag);            // expect: true
    print_i64(@as(i64, q.small));  // expect: 65535
    let n = c_counter();
    n.* = n.* + 5;
    print_i64(@as(i64, c_counter().*));     // expect: 6
    print_cstr(c_greeting());               // expect: hello from C
    print_i64(@as(i64, c_calls_axiom(4)));  // expect: 13
    let f = c_make_adder();
    print_i64(@as(i64, f(100)));  // expect: 107
    let mut xs: [3]i32 = [30, 10, 20];
    c_sort3(&mut xs[0]);
    print_i64(@as(i64, xs[0] * 100 + xs[1] * 10 + xs[2]));  // expect: 1230
    return 0;
}
