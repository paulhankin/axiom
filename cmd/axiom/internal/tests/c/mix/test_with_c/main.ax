// axiom test of an Axiom program with C units: the tests call C, whose
// output (the C library's streams) is written after each test.
// axiom-test
// expect-report: ok   C doubles
// expect-report: | hello from C
// expect-report: 2 passed, 0 failed
extern "C" {
    fn c_twice(x: i32) i32;
    fn c_greet() void;
}

error { Bad }

test "C doubles" {
    if c_twice(21) != 42 {
        return error.Bad;
    }
}

test "C prints" {
    c_greet();
}

export fn main() i32 {
    return c_twice(0);
}
