// The threads of stdio_threads/main.c.
import "std/collections/vec.ax" as vec;
import "std/thread" as thread;

struct Job {
    id: i32,
    work: fn(i32) void,
}

fn run(j: Job) void {
    j.work(j.id);
}

// Runs work(0) .. work(n - 1), each in a thread of its own, at once.
export fn rt_run_threads(n: i32, work: fn(i32) void) void {
    let mut ts = vec.Vec.[thread.Thread.[Job]].init();
    defer ts.deinit();
    for i in @as(i32, 0)..n {
        ts.reserve(1) catch {
            break;
        };
        ts.push(thread.spawn(run, Job.{ id: i, work: work }) catch {
            break;
        }) catch {
            break;
        };
    }
    for &mut t in ts.items_mut() {
        t.join();
    }
}
