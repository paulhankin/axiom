// Structures by value between Axiom and C units of one program (docs/c.md,
// spec §14.5.3), both ways, on every target: they travel as the target's C
// ABI passes them, through the wrappers the C front end compiles. And
// objects shared both ways (spec §14.5.6).
import "../print.ax" as p;

extern "C" {
    fn print_i64(x: i64) void;
    fn print_f64(x: f64) void;
}

pub struct Small {
    a: i32,
    b: i32,
}

pub struct Big {
    v: [5]i64,
    tag: i32,
}

pub struct Fl {
    x: f32,
    y: f32,
}

pub struct Dd {
    x: f64,
    y: f64,
}

pub struct Mix {
    d: f64,
    i: i32,
    c: u8,
}

pub struct Tiny {
    c: u8,
}

extern "C" {
    fn c_make_small(a: i32, b: i32) Small;
    fn c_sum_big(l: Big) i64;
    fn c_make_big(base: i32) Big;
    fn c_scale(f: Fl, k: f32) Fl;
    fn c_swap(d: Dd) Dd;
    fn c_mix(m: Mix, n: i32) Mix;
    fn c_tiny(t: Tiny, u: Tiny) Tiny;
    fn c_many(a: Small, b: Small, c: Small, d: Small, e: Dd, f: Dd, g: Dd, h: Dd, i: Dd) f64;
    fn c_call_back() i64;
    let mut c_count: i32;
    let c_limits: [3]i64;
    let c_obj: Small;
    fn c_touch() i32;
}

export let mut ax_total: i64 = 5;
export let mut ax_small: Small = Small.{ a: 1, b: 2 };

export fn ax_twice_small(s: Small) Small {
    return Small.{ a: s.a * 2, b: s.b * 2 };
}

export fn ax_big(b: Big, k: i32) Big {
    let mut r = b;
    r.v[4] = b.v[4] * @as(i64, k);
    r.tag = b.tag + k;
    return r;
}

export fn ax_mix(m: Mix) f64 {
    return m.d + @float_from_int(f64, @as(i64, m.i)) + @float_from_int(f64, @as(i64, m.c));
}

export fn main() i32 {
    p.linked();
    let s = c_make_small(3, -4);
    print_i64(@as(i64, (s.a * 10) + s.b));  // expect: 26
    let b = c_make_big(5);
    print_i64(c_sum_big(b));  // expect: 76
    let f = c_scale(Fl.{ x: 1.5, y: 2.5 }, 2.0);
    print_f64(@as(f64, f.x + f.y));  // expect: 8
    let d = c_swap(Dd.{ x: 0.25, y: 4.0 });
    print_f64(d.x - d.y);  // expect: 3.75
    let m = c_mix(Mix.{ d: 0.5, i: 3, c: 7 }, 4);
    print_f64(m.d + @float_from_int(f64, @as(i64, m.i)) + @float_from_int(f64, @as(i64, m.c)));  // expect: 24.5
    let t = c_tiny(Tiny.{ c: 5 }, Tiny.{ c: 6 });
    print_i64(@as(i64, t.c));  // expect: 11
    let one = Small.{ a: 1, b: 2 };
    let dd = Dd.{ x: 0.5, y: 1.5 };
    print_f64(c_many(one, one, one, one, dd, dd, dd, dd, dd));  // expect: 22
    print_i64(c_call_back());  // expect: 6843
    c_count += 1;
    print_i64(c_limits[0] + c_limits[2]);              // expect: 303
    print_i64(@as(i64, c_touch()));                    // expect: 42
    print_i64(ax_total);                               // expect: 47
    print_i64(@as(i64, (ax_small.b * 10) + c_obj.b));  // expect: 76
    return 0;
}
