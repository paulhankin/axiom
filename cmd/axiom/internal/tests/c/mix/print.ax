// cmd/axiom/internal/tests/c/mix/print.ax - the output functions of the
// mixed-language tests (c/mix/*/), in Axiom: C code calls them by their C
// names (print.h), and Axiom code imports them. Each prints its value and a
// newline on standard output, the same on every target (print_f64 as the
// C tests' WebAssembly host prints a double).
import "std/fmt" as fmt;
import "std/io" as io;

/// Nothing: an Axiom program that imports this module for its exports calls
/// it, to use the import.
pub fn linked() void {}

fn line(s: []u8) void {
    io.stdout().println(s) catch return;
}

export fn print_i64(x: i64) void {
    io.stdout().print_i64(x) catch return;
    line("");
}

export fn print_u64(x: u64) void {
    let mut buf: [24]u8 = [0; 24];
    line(fmt.format_uint(buf[..], x, 10, false));
}

export fn print_bool(b: bool) void {
    if b {
        line("true");
    } else {
        line("false");
    }
}

export fn print_str(p: *u8, n: usize) void {
    line(@slice_from_ptr(p, n));
}

// A NUL-terminated string.
export fn print_cstr(p: *u8) void {
    let mut n: usize = 0;
    while @slice_from_ptr(p, n + 1)[n] != 0 {
        n += 1;
    }
    line(@slice_from_ptr(p, n));
}

export fn print_f64(x: f64) void {
    if x != x {
        line("NaN");
        return;
    }
    if x == 0.0 {
        line("0");
        return;
    }
    let mut buf: [64]u8 = [0; 64];
    let s = fmt.format_float(buf[..], x) catch return;
    line(s);
}
