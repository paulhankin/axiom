// cmd/axiom/internal/tests/c/mix/win_walk/walk.ax - an Axiom function in
// the frames main.c walks: it calls back into C (a point of interest)
// with a defer pending and values kept across the call.
extern "C" {
    fn point_c() void;
}

fn twice(n: i64) i64 {
    return n * 2;
}

export fn ax_frames(n: i64) i64 {
    let mut k: i64 = n;
    defer k = 0;
    let a = twice(n) + 1;
    point_c();
    k += a;
    return k + twice(a);
}
