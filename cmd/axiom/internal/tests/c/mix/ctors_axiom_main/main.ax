// An Axiom program with a C unit of the GNU dialect: the unit's
// constructor runs before the Axiom main, its destructor after it.
// flags: --c-std=gnu17
import "../print.ax" as p;

extern "C" {
    fn print_cstr(s: *u8) void;
    fn c_value() i32;
}

export fn main() i32 {
    p.linked();
    print_cstr("axiom main".ptr);
    if c_value() == 42 {
        print_cstr("constructed".ptr);
    }
    return 0;
}
// expect: c constructor
// expect: axiom main
// expect: constructed
// expect: c destructor
