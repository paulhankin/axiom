// Assembly sources as translation units (docs/c.md "Assembly sources"): a
// routine in a preprocessed .S (per architecture and calling convention,
// with __ASSEMBLER__ and the compiler's macros) and a data table in a .s,
// called and read from Axiom and from C; the .S also calls the C library's
// strlen, which is linked for it.
// native-only
import "../print.ax" as p;

extern "C" {
    fn print_i64(x: i64) void;
    fn asm_sum(p: *i64, n: i64) i64;
    fn asm_len(s: *u8) i64;
    fn c_checks() i64;
}

export fn main() i32 {
    let xs: [4]i64 = [1, 20, 300, 4000];
    print_i64(asm_sum(&xs[0], 4));
    print_i64(asm_sum(&xs[0], 0));
    let s = "hello";
    print_i64(asm_len(s.ptr));
    print_i64(c_checks());
    return 0;
}
// expect: 4321
// expect: 0
// expect: 5
// expect: 42
