// The run-time layer of exit_order/main.c: exit, and handlers to run at it.
import "std/os" as os;

extern "C" {
    fn print_i64(x: i64) void;
    fn print_cstr(s: *u8) void;
}

fn nothing() void {}

let mut handlers: [8]fn() void = [nothing; 8];
let mut n_handlers: usize = 0;
let ready: i32 = 1234;

export fn rt_ready() i32 {
    return ready;
}

export fn at_exit(f: fn() void) i32 {
    if n_handlers == handlers.len {
        return 1;
    }
    handlers[n_handlers] = f;
    n_handlers += 1;
    return 0;
}

// The handlers, last registered first, then the runtime's exit.
export fn exit(status: i32) void {
    while n_handlers > 0 {
        n_handlers -= 1;
        handlers[n_handlers]();
    }
    print_cstr("exit".ptr);
    print_i64(@as(i64, status));
    os.exit(status);
}
