// An Axiom program's threads and the process they share (spec §12.8.5,
// "Ending the program"): a thread changes the directory and the
// environment, which the main thread then sees; another thread ends the
// process with os.exit while the main thread computes and never waits, so
// that the end comes from that thread alone (on WebAssembly too, where the
// host ends the program for a worker).
// expect: true
// expect: true
// expect: leaving
// expect-status: 6
import "../print.ax" as p;
import "std/os" as os;
import "std/str" as str;
import "std/thread" as thread;

extern "C" {
    fn print_bool(b: bool) void;
    fn print_cstr(s: *u8) void;
}

let mut changed: u32 = 0;

fn change(x: u32) void {
    _ = x;
    os.chdir("..") catch return;
    os.setenv("AXIOM_EXIT_THREAD_TEST", "set") catch return;
    @atomic_store(&mut changed, 1);
}

fn leave(code: i32) void {
    print_cstr("leaving\x00".ptr);
    os.exit(code);
}

export fn main() i32 {
    p.linked();
    let before = os.cwd() catch return 1;
    let t = thread.spawn(change, @as(u32, 0)) catch return 1;
    t.join();
    let after = os.cwd() catch return 1;
    print_bool((@atomic_load(&mut changed) == 1) and (after.len < before.len));
    let v = os.getenv("AXIOM_EXIT_THREAD_TEST") catch return 1;
    print_bool(str.eq(v, "set"));
    _ = thread.spawn(leave, @as(i32, 6)) catch return 1;
    let mut n: u64 = 0;
    while true {
        n +%= 1;
    }
    return 0;
}
