// cmd/axiom/internal/tests/c/lib/text/wctype_ref.ax - the wide character
// classes of a UTF-8 locale as docs/c-text.md defines them, from
// std/unicode's properties, for wctype_all.c to compare the C library's
// with: a second reading of the definitions, by another route (the class
// predicates of std/unicode rather than the category codes).
import "std/unicode" as uc;

/// The classes of c, as bits in wctype_all.c's order: alnum alpha blank
/// cntrl digit graph lower print punct space upper xdigit.
export fn ref_class(c: u32) u32 {
    let cat = uc.category(c);
    let cntrl = uc.is_control(c) or (cat == uc.Category.CF) or (cat == uc.Category.ZL) or (cat == uc.Category.ZP);
    let print = not cntrl and (cat != uc.Category.CN) and (cat != uc.Category.CS) and (cat != uc.Category.CO);
    let space = uc.is_space(c);
    let digit = (c >= 0x30) and (c <= 0x39);
    let graph = print and not space;
    let upper = graph and uc.is_upper(c);
    let lower = graph and uc.is_lower(c);
    let alpha = graph and not digit and (upper or lower or uc.is_alphabetic(c));
    let alnum = alpha or digit;
    let punct = graph and not alnum;
    let blank = space and ((c == 9) or (cat == uc.Category.ZS));
    let xdigit = digit or ((c >= 0x41) and (c <= 0x46)) or ((c >= 0x61) and (c <= 0x66));
    let bits: [12]bool = [alnum, alpha, blank, cntrl, digit, graph, lower, print, punct, space, upper, xdigit];
    let mut r: u32 = 0;
    for k in @as(usize, 0)..12 {
        if bits[k] {
            r |= @as(u32, 1) << @truncate(u32, k);
        }
    }
    return r;
}

export fn ref_upper(c: u32) u32 {
    return uc.to_upper(c);
}

export fn ref_lower(c: u32) u32 {
    return uc.to_lower(c);
}
