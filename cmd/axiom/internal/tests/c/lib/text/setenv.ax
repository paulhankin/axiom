// setenv.ax - test_setenv for the C library's tests that change the
// environment (ISO C has no function for it): std/os.setenv, or unsetenv
// for a null value.
import "std/os" as os;

fn cstr(p: *u8) []u8 {
    let mut n: usize = 0;
    while @slice_from_ptr(p, n + 1)[n] != 0 {
        n += 1;
    }
    return @slice_from_ptr(p, n);
}

/// Sets the environment variable name to value (a C string), or removes it
/// (value null); 0, or -1.
export fn test_setenv(name: *u8, value: *u8) i64 {
    if @int_from_ptr(value) == 0 {
        os.unsetenv(cstr(name)) catch {
            return -1;
        };
        return 0;
    }
    os.setenv(cstr(name), cstr(value)) catch {
        return -1;
    };
    return 0;
}
