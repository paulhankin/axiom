// The Axiom half of exit_main_axiom.c: a thread of std/thread that sleeps,
// then stores 7 through the pointer it is given (not joined: the C main
// thread's thrd_exit waits for it).
import "std/thread" as thread;

fn work(p: *mut i32) void {
    thread.sleep_ms(50);
    @atomic_store(p, 7);
}

export fn start_axiom_worker(p: *mut i32) void {
    _ = thread.spawn(work, p) catch {
        return;
    };
}
