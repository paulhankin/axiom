#!/bin/sh
# A configure script in the style of the generated ones: it probes the
# compiler ($CC, $CFLAGS) as they do, then writes config.h and config.mk.
: "${CC:=cc}"
: "${CFLAGS:=-g}"
exec 5> config.log
rm -f conftest.c conftest.o conftest conftest.i conftest2.o conftest.d a.out
defs=""
check() { printf 'checking %s... ' "$1"; }
result() { echo "$1"; echo "result: $1" >&5; }
die() { echo "configure: error: $*"; exit 1; }
try_compile() { $CC $CFLAGS -c conftest.c >&5 2>&1 && test -s conftest.o; }
try_link() { rm -f conftest; $CC $CFLAGS -o conftest conftest.c "$@" >&5 2>&1 && test -s conftest; }
try_cpp() { $CC -E conftest.c > conftest.i 2>&5; }

check "whether the C compiler works"
cat > conftest.c <<'X'
int main(void) { return 0; }
X
$CC $CFLAGS conftest.c >&5 2>&1 || die "C compiler cannot create executables"
result yes
check "for C compiler default output file name"
for f in a.out a.exe conftest; do test -f $f && break; done
test -f "$f" || die "no output"
result $f
check "for suffix of object files"
try_compile || die "cannot compile"
result o
check "whether we are cross compiling"
try_link && ./conftest || die "cannot run the programs it makes"
result no
check "whether $CC accepts -g"
if $CC -g -c conftest.c >&5 2>&1; then result yes; else result no; fi
check "whether $CC understands -c and -o together"
$CC -c conftest.c -o conftest2.o >&5 2>&1 && test -f conftest2.o || die "no"
result yes
check "whether the compiler supports GNU C"
cat > conftest.c <<'X'
#ifndef __GNUC__
       choke me
#endif
int x;
X
if try_compile; then result yes; else result no; fi
check "for $CC option to enable C11 features"
cat > conftest.c <<'X'
#include <stdalign.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
_Static_assert(sizeof(int) >= 4, "int");
struct anon { union { int a; float f; }; _Alignas(16) char buf[16]; };
static _Noreturn void stop(void) { for (;;) {} }
int main(void) {
    struct anon s = { .a = 1 };
    bool ok = _Generic(s.a, int: true, default: false);
    long long big = 1LL << 40;
    for (int i = 0; i < 2; i++) big += i;
    (void)stop;
    return !(ok && alignof(max_align_t) >= 8 && big > 0 && sizeof s.buf == 16);
}
X
try_link && ./conftest || die "no C11"
result "none needed"
check "how to run the C preprocessor"
cat > conftest.c <<'X'
#include <limits.h>
		     Syntax error
X
try_cpp || die "$CC -E fails"
cat > conftest.c <<'X'
#include <ac_nonexistent.h>
X
try_cpp && die "$CC -E finds a header that does not exist"
result "$CC -E"
for h in stdio.h stdlib.h string.h unistd.h stdint.h sys/types.h no_such_header.h; do
    check "for $h"
    printf '#include <%s>\n' $h > conftest.c
    if try_compile; then
        result yes
        defs="$defs#define HAVE_$(echo $h | tr 'a-z./' 'A-Z__') 1
"
    else
        result no
    fi
done
check "whether byte ordering is bigendian"
cat > conftest.c <<'X'
int main(void) { unsigned x = 1; return *(unsigned char *)&x == 1; }
X
if try_link && ! ./conftest; then result no; else result yes; fi
check "size of long"
for n in 4 8; do
    printf 'int a[1 - 2 * !(sizeof(long) == %s)];\n' $n > conftest.c
    try_compile && break
done
result $n
defs="$defs#define SIZEOF_LONG $n
"
check "for sqrt in -lm"
cat > conftest.c <<'X'
char sqrt ();
int main (void) { return sqrt (); }
X
try_link -lm || die "no sqrt"
result yes
LIBS="-lm"
check "for strndup"
cat > conftest.c <<'X'
char strndup ();
int main (void) { return strndup (); }
X
if try_link; then
    result yes
    defs="$defs#define HAVE_STRNDUP 1
"
else
    result no
fi
check "for no_such_function_anywhere"
cat > conftest.c <<'X'
char no_such_function_anywhere ();
int main (void) { return no_such_function_anywhere (); }
X
try_link && die "a function that does not exist links"
result no
check "dependency style of $CC"
echo 'int x;' > conftest.c
$CC -MT conftest.o -MD -MP -MF conftest.d -c conftest.c -o conftest.o >&5 2>&1 && grep -q '^conftest.o:' conftest.d \
    || die "no dependency output"
result "make rules"
printf '%s' "$defs" > config.h
{ echo "CC = $CC"; echo "CFLAGS = $CFLAGS"; echo "LIBS = $LIBS"; } > config.mk
rm -f conftest.c conftest.o conftest conftest.i conftest2.o conftest.d a.out
echo "configure: wrote config.h and config.mk"
