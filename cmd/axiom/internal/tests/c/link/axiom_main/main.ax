// An Axiom program linked with an object of the system's C compiler: its
// constructor runs before main, its output (through the compiler's C
// library, the program's) is written when main returns, and its
// thread-local is the program's.
extern "C" {
    fn sys_add(a: i32, b: i32) i32;
    fn sys_print(s: *u8) void;
    fn sys_tls() i32;
}

export fn main() i32 {
    let r = sys_add(2, 3);
    sys_print("from axiom\x00".ptr);  // expect: from the system's compiler: from axiom 10
    return r + sys_tls() - 23;
}
