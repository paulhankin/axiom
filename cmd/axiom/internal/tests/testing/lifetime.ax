// The program of docs/agent-fit-plan.md, section C: no raw pointer, no
// warning by default, and two reads of freed memory, a slice of a Vec's
// buffer kept across pushes that move it and a block used after mem.free.
// Under axiom test (the sanitizer is on by default) the test fails with
// T0012 at the first; with --warn=W0711, the suite checks that the warning
// is at both uses (line 25, columns 13 and 20).
// test-result: a slice kept across pushes, and a block used after free | fail | T0012 | 25
import "std/collections/vec" as vec;
import "std/mem" as mem;

fn first(v: *vec.Vec.[u32]) []u32 {
    return v.items();
}

fn run() u32 {
    let mut v = vec.Vec.[u32].init();
    defer v.deinit();
    v.push(7) catch return 1;
    let s = first(&v);  // a slice of v's buffer
    for i in @as(u32, 0)..1000 {
        v.push(i) catch return 1;  // the buffer moves
    }
    let buf = mem.alloc.[u32](4) catch return 1;
    mem.free(buf);
    let x = s[0] + buf[0];  // both are uses after free
    return x;
}

test "a slice kept across pushes, and a block used after free" {
    _ = run();
}
