// Stack traces and error return traces (spec §16.4), checked by cmd/axiom/internal/tests/run.mjs:
//   // stack: <test> | <function>@<line> ...     innermost first; ~N = a repeat marker
//   // errors: <test> | <function>@<line> ...    oldest first
error { Bad }

fn get(xs: []i32, i: usize) i32 {
    return xs[i];
}

fn check(x: i32) !i32 {
    if x > 3 {
        return error.Bad;
    }
    return x;
}

fn outer(x: i32) !i32 {
    let y = check(x)!;
    return y;
}

fn handled(x: i32) !i32 {
    // the error from check(5) is handled, so it leaves no trace
    let a = check(5) catch 0;
    if x > 0 {
        return error.Bad;
    }
    return a;
}

fn deep(n: u32) u32 {
    if n == 0 {
        let xs: [1]i32 = [0];
        return @bit_cast(u32, get(xs[..], 3));
    }
    return deep(n - 1) + @truncate(u32, leave());
}

fn forever(n: u64) u64 {
    return forever(n + 1) + leave();
}

fn call_through(f: fn([]i32, usize) i32) i32 {
    let xs: [1]i32 = [0];
    return f(xs[..], 1);
}

// stack: bounds | get@7 test "bounds"@51
test "bounds" {
    let xs: [2]i32 = [1, 2];
    _ = get(xs[..], 5);
}

// errors: error | check@12 outer@18 test "error"@56
test "error" {
    _ = outer(9)!;
}

// errors: catch clears the trace | handled@26 test "catch clears the trace"@61
test "catch clears the trace" {
    _ = handled(1)!;
}

// stack: recursion | get@7 deep@34 deep@36 ~99 test "recursion"@66
test "recursion" {
    _ = deep(100);
}

// stack: indirect call | get@7 call_through@45 test "indirect call"@71
test "indirect call" {
    _ = call_through(get);
}

// stack: stack overflow | forever forever@40 ~255
test "stack overflow" {
    _ = forever(0);
}

fn first(xs: []i32) i32 {
    return xs[0];
}

fn mid(xs: []i32, i: usize) i32 {
    let a = first(xs);
    return a + get(xs, i);
}

// stack: nested inlining | get@7 mid@85 test "nested inlining"@91
test "nested inlining" {
    let xs: [2]i32 = [1, 2];
    _ = mid(xs[..], 4);
}

fn note(n: *mut u64) void {
    n.* += 1;
}

// A call on an uncommon path, then a check (inlined into the tests: the
// call's record is written only where something reads it)
fn bump(xs: []u64, n: *mut u64, i: usize) u64 {
    if n.* == 7 {
        note(n);
    }
    return xs[i];
}

// stack: slow path not taken | bump@104 test "slow path not taken"@111
test "slow path not taken" {
    let xs: [2]u64 = [1, 2];
    let mut n: u64 = 0;
    _ = bump(xs[..], &mut n, 5);
}

// stack: slow path taken | bump@104 test "slow path taken"@118
test "slow path taken" {
    let xs: [2]u64 = [1, 2];
    let mut n: u64 = 7;
    _ = bump(xs[..], &mut n, 5);
}

// Inline functions (spec §9.5) keep their frames: the call sites are pushed
// only when a trap or a call that is not inline needs them.
inline fn iget(xs: []i32, i: usize) i32 {
    return xs[i];
}

inline fn icall(xs: []i32, i: usize) i32 {
    return get(xs, i) + iget(xs, 0);
}

inline fn i1(xs: []i32, i: usize) i32 {
    return iget(xs, i);
}

inline fn i2(xs: []i32, i: usize) i32 {
    return i1(xs, i) + 1;
}

inline fn i3(xs: []i32, i: usize) i32 {
    return i2(xs, i) + 1;
}

inline fn i4(xs: []i32, i: usize) i32 {
    return i3(xs, i) + 1;
}

inline fn i5(xs: []i32, i: usize, j: usize) i32 {
    return i4(xs, i) + icall(xs, j);
}

fn not_inline(xs: []i32, i: usize, j: usize) i32 {
    return iget(xs, 0) + i5(xs, i, j);
}

// stack: inline | iget@124 test "inline"@158
test "inline" {
    let xs: [2]i32 = [1, 2];
    _ = iget(xs[..], 3);
}

// stack: inline calling a function | get@7 icall@128 test "inline calling a function"@164
test "inline calling a function" {
    let xs: [2]i32 = [1, 2];
    _ = icall(xs[..], 3);
}

// stack: inline in inline | iget@124 i1@132 i2@136 i3@140 i4@144 i5@148 not_inline@152 test "inline in inline"@170
test "inline in inline" {
    let xs: [2]i32 = [1, 2];
    _ = not_inline(xs[..], 2, 0);
}

// stack: deep inline calling a function | get@7 icall@128 i5@148 not_inline@152 test "deep inline calling a function"@176
test "deep inline calling a function" {
    let xs: [2]i32 = [1, 2];
    _ = not_inline(xs[..], 0, 2);
}

// stack: inline function as a value | iget@124 call_through@45 test "inline function as a value"@181
test "inline function as a value" {
    _ = call_through(iget);
}

// Calls of one function from both branches stay apart (natively they are
// `nomerge`, so each keeps its own entry in the frame tables)
fn twice(xs: []i32, c: bool, i: usize) i32 {
    if c {
        return get(xs, i) * 2;
    }
    return get(xs, i) * 3;
}

// stack: same callee on both branches | get@7 twice@190 test "same callee on both branches"@196
test "same callee on both branches" {
    let xs: [2]i32 = [1, 2];
    _ = twice(xs[..], true, 0) + twice(xs[..], false, 2);
}

// A trap on a path that returns before the function needs its frame
// (natively, the frame is set up only on the way to the calls: x64.ax
// shrink-wrapping)
fn early(xs: []i32, i: usize) u32 {
    if i < 8 {
        return @bit_cast(u32, xs[i]);
    }
    let n = @truncate(u32, i);
    return deep(n) + (deep(n + 1) * deep(n + 2)) + (deep(n + 3) ^ deep(n + 4));
}

// stack: trap before the frame | early@204 test "trap before the frame"@214
test "trap before the frame" {
    let xs: [2]i32 = [1, 2];
    let k = @int_from_ptr(&xs[0]) >> 60;  // (0, but not known to the compiler)
    _ = early(xs[..], k + 1) + early(xs[..], k + 5);
}

// Returns 1 after writing memory: work after a call that keeps a runaway
// recursion from becoming a loop (with wrapping arithmetic, an optimizer may
// otherwise turn `f(n + 1) + 1` into one, and nothing overflows).
let mut RETURNS: u64 = 0;

fn leave() u64 {
    RETURNS +%= 1;
    return 1;
}
