// A program that overflows its stack: run by cmd/axiom/internal/tests/run.mjs, which checks the
// crash report on stderr.
fn forever(n: u64) u64 {
    return forever(n + 1) + leave();
}

fn start() u64 {
    return forever(0);
}

export fn main() i32 {
    _ = start();
    return 0;
}

// Returns 1 after writing memory: work after a call that keeps a runaway
// recursion from becoming a loop (with wrapping arithmetic, an optimizer may
// otherwise turn `f(n + 1) + 1` into one, and nothing overflows: issue 0051).
let mut RETURNS: u64 = 0;

fn leave() u64 {
    RETURNS +%= 1;
    return 1;
}
