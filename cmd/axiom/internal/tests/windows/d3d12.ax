// Direct3D 12 (std/graphics/d3d12), drawn offscreen and read back pixel by
// pixel: textures from images (with mipmaps), multisampled half-float
// targets read by a later pass, compute shaders, vertices a compute shader
// made, and Direct2D on top (D3D11On12). Windows only:
// axiom test cmd/axiom/internal/tests/windows/d3d12.ax --target=x86_64-windows

import "std/graphics/d2d" as d2d;
import "std/graphics/d3d12" as d3d;
import "std/graphics/hlsl" as hlsl;
import "std/graphics/image" as image;

let mut src_buf: [8192]u8 = [0; 8192];

// The lines of a shader, joined.
fn src(lines: [][]u8) []u8 {
    let mut n: usize = 0;
    for l in lines {
        @mem_copy(src_buf[n..n + l.len], l);
        src_buf[n + l.len] = '\n';
        n += l.len + 1;
    }
    return src_buf[0..n];
}

fn px(img: *image.Image, x: usize, y: usize) u32 {
    let at = ((y * img.width) + x) * 4;
    return ((@as(u32, img.data[at]) << 24) | (@as(u32, img.data[at + 1]) << 16)) | (
        (@as(u32, img.data[at + 2]) << 8) | @as(u32, img.data[at + 3]));
}

// A triangle over the whole target from SV_VertexID, showing t0 one texel a
// pixel; or the vertices at POSITION, in a colour.
let SHADER: [14][]u8 = ["Texture2D tex : register(t0);", "SamplerState lin : register(s0);",
                        "struct VSOut { float4 pos : SV_Position; float2 uv : TEXCOORD; };",
                        "VSOut full(uint id : SV_VertexID) {", "    VSOut o;",
                        "    float2 p = float2(id == 2 ? 3.0 : -1.0, id == 1 ? 3.0 : -1.0);",
                        "    o.pos = float4(p, 0.5, 1.0);", "    o.uv = float2(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);",
                        "    return o;", "}", "float4 textured(VSOut i) : SV_Target { return tex.Sample(lin, i.uv); }",
                        "float4 at(float4 p : POSITION) : SV_Position { return p; }",
                        "float4 yellow(float4 p : SV_Position) : SV_Target { return float4(1, 1, 0, 1); }", ""];

test "a texture from an image" {
    let mut gpu = d3d.Device.init()!;
    defer gpu.deinit();
    let s = src(SHADER[..]);
    let mut vc = hlsl.compile(s, "full", "vs_5_0")!;
    defer vc.release();
    let mut pc = hlsl.compile(s, "textured", "ps_5_0")!;
    defer pc.release();
    let mut rs = gpu.root_signature_with(0, 0, 1)!;
    defer rs.release();
    let attrs = [d3d.Attribute.{ semantic: "POSITION", index: 0, format: d3d.R32_FLOAT, offset: 0 }];
    let mut p = gpu.pipeline(&rs, &vc, &pc, attrs[0..0], d3d.TRIANGLE_LIST, false)!;
    defer p.release();
    // 4 × 4 gray and alpha (converted to RGBA on the way): one texel a
    // pixel, so linear filtering changes nothing
    let mut img = image.Image.init(4, 4, 2, image.Depth.U8)!;
    defer img.deinit();
    for i in @as(usize, 0)..16 {
        img.data[i * 2] = @truncate(u8, i * 16);
        img.data[(i * 2) + 1] = 255;
    }
    let mut tex = gpu.texture(&img)!;
    defer tex.release();
    let mut t = gpu.target(4, 4)!;
    defer t.release();
    gpu.begin(&mut t)!;
    gpu.clear(&t, 0.0, 0.0, 0.0, 1.0);
    gpu.set_pipeline(&p);
    gpu.set_image(0, &tex);
    gpu.draw(3, 0);
    gpu.finish()!;
    let mut out = gpu.read_pixels(&mut t)!;
    defer out.deinit();
    for i in @as(usize, 0)..16 {
        let g = @as(u32, @truncate(u8, i * 16));
        @expect_eq(px(&out, i % 4, i / 4), (((g << 24) | (g << 16)) | (g << 8)) | 255);
    }
}

// A half-plane of light beyond 1 (HDR), below the diagonal from the top
// left; then a pass showing it tone-mapped (x / (1 + x)), or a texture's
// level `lod`.
let PASSES: [14][]u8 = ["cbuffer K : register(b0) { float lod; };", "Texture2D tex : register(t0);",
                        "SamplerState lin : register(s0);", "SamplerState clamped : register(s2);",
                        "struct VSOut { float4 pos : SV_Position; float2 uv : TEXCOORD; };",
                        "VSOut full(uint id : SV_VertexID) {", "    VSOut o;",
                        "    float2 p = float2(id == 2 ? 3.0 : -1.0, id == 1 ? 3.0 : -1.0);",
                        "    o.pos = float4(p, 0.5, 1.0); o.uv = float2(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5); return o; }",
                        "float4 corner(uint id : SV_VertexID) : SV_Position { return float4(id == 1 ? 1.0 : -1.0, id == 0 ? 1.0 : -1.0, 0.5, 1.0); }",
                        "float4 bright(float4 p : SV_Position) : SV_Target { return float4(4.0, 1.0, 0.0, 1.0); }",
                        "float4 tone(VSOut i) : SV_Target { float4 c = tex.Sample(clamped, i.uv); return float4(c.rgb / (1.0 + c.rgb), 1.0); }",
                        "float4 level(VSOut i) : SV_Target { return tex.SampleLevel(lin, i.uv, lod); }", ""];

test "a multisampled half-float target, resolved and read by the next pass" {
    let mut gpu = d3d.Device.init()!;
    defer gpu.deinit();
    let s = src(PASSES[..]);
    let mut vc = hlsl.compile(s, "corner", "vs_5_0")!;
    defer vc.release();
    let mut pc = hlsl.compile(s, "bright", "ps_5_0")!;
    defer pc.release();
    let mut fc = hlsl.compile(s, "full", "vs_5_0")!;
    defer fc.release();
    let mut tc = hlsl.compile(s, "tone", "ps_5_0")!;
    defer tc.release();
    let mut rs = gpu.root_signature_with(1, 0, 1)!;
    defer rs.release();
    let none = [d3d.Attribute.{ semantic: "POSITION", index: 0, format: d3d.R32_FLOAT, offset: 0 }];
    let mut o = d3d.PipelineOptions.defaults();
    o.format = d3d.TARGET_RGBA16F;
    o.samples = 4;
    o.depth = d3d.DEPTH_WRITE;
    let mut p = gpu.pipeline_with(&rs, &vc, &pc, none[0..0], o)!;
    defer p.release();
    let mut q = gpu.pipeline(&rs, &fc, &tc, none[0..0], d3d.TRIANGLE_LIST, false)!;
    defer q.release();
    let mut hdr = gpu.target_with(16, 16, d3d.TARGET_RGBA16F, 4)!;
    defer hdr.release();
    let mut z = gpu.depth_buffer_with(16, 16, 4)!;
    defer z.release();
    let mut t = gpu.target(16, 16)!;
    defer t.release();
    gpu.begin_depth(&mut hdr, &mut z)!;
    gpu.clear(&hdr, 0.0, 0.0, 0.0, 1.0);
    gpu.clear_depth(&z);
    gpu.set_pipeline(&p);
    gpu.draw(3, 0);
    gpu.begin(&mut t)!;
    gpu.set_pipeline(&q);
    gpu.set_target_texture(0, &mut hdr);
    gpu.draw(3, 0);
    gpu.finish()!;
    let mut out = gpu.read_pixels(&mut t)!;
    defer out.deinit();
    // inside: 4 / 5 and 1 / 2 (204, 128); outside: black
    let inside = px(&out, 2, 12);
    @expect((inside >> 24) >= 203 and (inside >> 24) <= 205);
    @expect(((inside >> 16) & 255) >= 127 and ((inside >> 16) & 255) <= 128);
    @expect_eq(px(&out, 12, 2), 255);
    // on the diagonal, half its samples covered: 2 / 3
    let edge = px(&out, 7, 7) >> 24;
    @expect(edge > 150 and edge < 190);
}

test "mipmaps" {
    let mut gpu = d3d.Device.init()!;
    defer gpu.deinit();
    let s = src(PASSES[..]);
    let mut fc = hlsl.compile(s, "full", "vs_5_0")!;
    defer fc.release();
    let mut lc = hlsl.compile(s, "level", "ps_5_0")!;
    defer lc.release();
    let mut rs = gpu.root_signature_with(1, 0, 1)!;
    defer rs.release();
    let none = [d3d.Attribute.{ semantic: "POSITION", index: 0, format: d3d.R32_FLOAT, offset: 0 }];
    let mut p = gpu.pipeline(&rs, &fc, &lc, none[0..0], d3d.TRIANGLE_LIST, false)!;
    defer p.release();
    // a checkerboard of 8 × 8 pixels, white and black: its other levels grey
    let mut img = image.Image.init(8, 8, 4, image.Depth.U8)!;
    defer img.deinit();
    for i in @as(usize, 0)..64 {
        let mut v: u8 = 0;
        if (((i % 8) + (i / 8)) % 2) == 0 {
            v = 255;
        }
        img.data[i * 4] = v;
        img.data[(i * 4) + 1] = v;
        img.data[(i * 4) + 2] = 255 - v;
        img.data[(i * 4) + 3] = 255;
    }
    let mut tex = gpu.texture_mipmapped(&img, false)!;
    defer tex.release();
    @expect_eq(tex.levels, 4);
    let mut t = gpu.target(8, 8)!;
    defer t.release();
    let lods: [2]f32 = [0.0, 3.0];
    for lod in lods {
        gpu.begin(&mut t)!;
        gpu.set_pipeline(&p);
        let k: [1]u32 = [@bit_cast(u32, lod)];
        gpu.set_constants(k[..]);
        gpu.set_image(0, &tex);
        gpu.draw(3, 0);
        gpu.finish()!;
        let mut out = gpu.read_pixels(&mut t)!;
        defer out.deinit();
        if lod == 0.0 {
            @expect_eq(px(&out, 0, 0), 0xffff00ff);
            @expect_eq(px(&out, 1, 0), 0x0000ffff);
        } else {
            for i in @as(usize, 0)..64 {
                let c = px(&out, i % 8, i / 8);
                @expect_eq(c, 0x808080ff);
            }
        }
    }
}

test "views are given back" {
    let mut gpu = d3d.Device.init()!;
    defer gpu.deinit();
    // more targets, depth buffers and textures than the heaps hold, made
    // and released one after another
    let mut img = image.Image.init(2, 2, 4, image.Depth.U8)!;
    defer img.deinit();
    for k in @as(u32, 0)..2200 {
        let mut t = gpu.target_with(4, 4, d3d.TARGET_RGBA16F, 1 + ((k & 1) * 3))!;
        t.release();
        if (k % 32) == 0 {
            let mut z = gpu.depth_buffer(4, 4)!;
            z.release();
        }
        let mut x = gpu.texture(&img)!;
        x.release();
    }
}

let CS: [7][]u8 = ["cbuffer K : register(b0) { uint add; };", "RWStructuredBuffer<uint> buf : register(u0);",
                   "RWStructuredBuffer<float4> tri : register(u1);", "[numthreads(64, 1, 1)]",
                   "void main(uint3 id : SV_DispatchThreadID) {", "    buf[id.x] = buf[id.x] * buf[id.x] + add;",
                   "    if (id.x < 3) { tri[id.x] = float4(id.x == 2 ? 0.5 : -0.5, id.x == 1 ? 0.5 : -0.5, 0.5, 1); } }"];

test "a compute shader, and drawing what it made" {
    let mut gpu = d3d.Device.init()!;
    defer gpu.deinit();
    let mut code = hlsl.compile(src(CS[..]), "main", "cs_5_0")!;
    defer code.release();
    let mut rs = gpu.compute_signature(1, 2)!;
    defer rs.release();
    let mut cp = gpu.compute_pipeline(&rs, &code)!;
    defer cp.release();
    let n: usize = 256;
    let mut data: [256]u32 = [0; 256];
    for i in 0..n {
        data[i] = @truncate(u32, i);
    }
    let mut b = gpu.storage_buffer(@slice_from_ptr(@ptr_cast(*u8, &data[0]), n * 4))!;
    defer b.release();
    let zero: [48]u8 = [0; 48];
    let mut tri = gpu.storage_buffer(zero[..])!;
    defer tri.release();
    gpu.set_compute_pipeline(&cp)!;
    let k: [1]u32 = [7];
    gpu.set_compute_constants(k[..]);
    gpu.set_storage(0, &mut b);
    gpu.set_storage(1, &mut tri);
    gpu.dispatch(@truncate(u32, n / 64), 1, 1);
    gpu.dispatch(@truncate(u32, n / 64), 1, 1);  // twice: (i² + 7)² + 7
    gpu.finish()!;
    let mut out: [256]u32 = [0; 256];
    gpu.read_buffer(&mut b, @slice_from_ptr(@ptr_cast(*mut u8, &mut out[0]), n * 4))!;
    for i in 0..n {
        let x = @truncate(u32, i);
        let once = (x * x) + 7;
        @expect_eq(out[i], (once *% once) +% 7);
    }
    // the triangle the shader wrote: (-0.5, -0.5), (-0.5, 0.5), (0.5, -0.5)
    let s = src(SHADER[..]);
    let mut vc = hlsl.compile(s, "at", "vs_5_0")!;
    defer vc.release();
    let mut pc = hlsl.compile(s, "yellow", "ps_5_0")!;
    defer pc.release();
    let mut gs = gpu.root_signature(0)!;
    defer gs.release();
    let attrs = [d3d.Attribute.{ semantic: "POSITION", index: 0, format: d3d.R32G32B32A32_FLOAT, offset: 0 }];
    let mut p = gpu.pipeline(&gs, &vc, &pc, attrs[..], d3d.TRIANGLE_LIST, false)!;
    defer p.release();
    let mut t = gpu.target(8, 8)!;
    defer t.release();
    gpu.begin(&mut t)!;
    gpu.clear(&t, 0.0, 0.0, 0.0, 1.0);
    gpu.set_pipeline(&p);
    gpu.set_storage_vertices(&mut tri, 16);
    gpu.draw(3, 0);
    gpu.finish()!;
    let mut img = gpu.read_pixels(&mut t)!;
    defer img.deinit();
    @expect_eq(px(&img, 2, 5), 0xffff00ff);  // inside, near the right angle
    @expect_eq(px(&img, 5, 2), 0x000000ff);  // across the hypotenuse
    @expect_eq(px(&img, 0, 0), 0x000000ff);
}

test "Direct2D over Direct3D 12" {
    let mut gpu = d3d.Device.init()!;
    defer gpu.deinit();
    let mut ov = gpu.overlay()!;
    defer ov.release();
    let mut t = gpu.target(32, 32)!;
    defer t.release();
    let mut c = d2d.Canvas.for_texture(gpu.overlay_texture(&mut ov, &t)!, 32, 32)!;
    defer c.deinit();
    for frame in @as(u32, 0)..3 {
        gpu.begin(&mut t)!;
        gpu.clear(&t, 0.0, 0.0, 1.0, 1.0);
        gpu.begin_overlay(&mut ov, &mut t)!;
        c.begin();
        c.fill_rect(8.0 + @float_from_int(f32, frame), 8.0, 8.0, 8.0, d2d.rgb(1.0, 1.0, 1.0));
        c.end()!;
        gpu.end_overlay(&mut ov, &mut t);
        gpu.finish()!;
    }
    let mut img = gpu.read_pixels(&mut t)!;
    defer img.deinit();
    @expect_eq(px(&img, 14, 12), 0xffffffff);  // the last frame's square: 10..18
    @expect_eq(px(&img, 9, 12), 0x0000ffff);
    @expect_eq(px(&img, 2, 2), 0x0000ffff);
}

fn fails_with_message(s: []u8, target: []u8) bool {
    let mut c = hlsl.compile(s, "main", target) catch |e| {
        return (e == error.CompileError) and (hlsl.message().len > 0);
    };
    c.release();
    return false;
}

test "DXIL (shader model 6)" {
    let mut code = hlsl.compile(src(CS[..]), "main", "cs_6_0") catch |e| {
        if e == error.Unsupported {
            return;  // no DirectX Shader Compiler here
        }
        return e;
    };
    defer code.release();
    let b = code.bytes();
    @expect(b.len > 4 and b[0] == 'D' and b[1] == 'X' and b[2] == 'B' and b[3] == 'C');  // (the container)
    @expect(fails_with_message("[numthreads(1,1,1)] void main() { undefined(); }", "cs_6_0"));
    let mut gpu = d3d.Device.init()!;
    defer gpu.deinit();
    let mut rs = gpu.compute_signature(1, 2)!;
    defer rs.release();
    let mut cp = gpu.compute_pipeline(&rs, &code)!;
    defer cp.release();
    let mut data: [64]u32 = [0; 64];
    for i in @as(usize, 0)..64 {
        data[i] = @truncate(u32, i);
    }
    let mut b0 = gpu.storage_buffer(@slice_from_ptr(@ptr_cast(*u8, &data[0]), 256))!;
    defer b0.release();
    let zero: [48]u8 = [0; 48];
    let mut tri = gpu.storage_buffer(zero[..])!;
    defer tri.release();
    gpu.set_compute_pipeline(&cp)!;
    let k: [1]u32 = [3];
    gpu.set_compute_constants(k[..]);
    gpu.set_storage(0, &mut b0);
    gpu.set_storage(1, &mut tri);
    gpu.dispatch(1, 1, 1);
    gpu.finish()!;
    let mut out: [64]u32 = [0; 64];
    gpu.read_buffer(&mut b0, @slice_from_ptr(@ptr_cast(*mut u8, &mut out[0]), 256))!;
    for i in @as(usize, 0)..64 {
        @expect_eq(out[i], @truncate(u32, (i * i) + 3));
    }
}
