// cmd/axiom/internal/tests/windows/symbols.ax - an Axiom function among
// those symbols.c probes (run.mjs builds them into one program): its
// parameter, locals and a structure, read back through the system's symbol
// handler where it calls back into C.
extern "C" {
    fn want_c(name: *u8, v: *u8, size: u32, param: i32) void;
    fn probe_c(line: i32) void;
}

struct Pair {
    lo: i32,
    hi: i64,
}

export fn ax_frame(n: i64) i64 {
    let scaled: i64 = n * 7;
    let p = Pair.{ lo: @truncate(i32, n), hi: n + 100 };
    let mut nn = n;
    let mut sc = scaled;
    let mut pp = p;
    want_c("n".ptr, @ptr_cast(*u8, &nn), 8, 1);
    want_c("scaled".ptr, @ptr_cast(*u8, &sc), 8, 0);
    want_c("p".ptr, @ptr_cast(*u8, &pp), 16, 0);
    probe_c(24);  // (its own line)
    return scaled + p.hi + @as(i64, p.lo) + nn + sc + pp.hi;
}
