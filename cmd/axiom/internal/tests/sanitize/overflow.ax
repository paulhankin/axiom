// A write past the end of an allocation through a raw pointer (slices are
// bounds-checked already; pointers made from addresses are not).
// status: trap
// stderr: heap-buffer-overflow: 1-byte access
// stderr: 0 bytes after the end of a 13-byte allocation
import "std/mem" as mem;

export fn main() i32 {
    let xs = mem.alloc.[u8](13) catch return 1;
    let p = @ptr_from_int(*mut u8, @int_from_ptr(xs.ptr) + 13);
    p.* = 1;
    mem.free(xs);
    return 0;
}
