// Non-overlapping, adjacent, and empty noalias slices/pointers pass under ASan.
// status: 0

fn add_disjoint(noalias dst: []mut u32, noalias src: []u32) void {
    for i in 0..dst.len {
        dst[i] += src[i];
    }
}

fn swap_ptrs(noalias a: *mut u64, noalias b: *mut u64) void {
    let t = a.*;
    a.* = b.*;
    b.* = t;
}

export fn main() i32 {
    let mut arr: [8]u32 = [1, 2, 3, 4, 5, 6, 7, 8];
    // Adjacent halves: [0..4) and [4..8) do not overlap.
    add_disjoint(arr[0..4], arr[4..8]);
    // Empty slice with any non-empty slice does not overlap.
    add_disjoint(arr[0..0], arr[0..4]);

    let mut x: u64 = 10;
    let mut y: u64 = 20;
    swap_ptrs(&mut x, &mut y);
    if (arr[0] != 6) or (x != 20) or (y != 10) {
        return 1;
    }
    return 0;
}
