// An indirect slice into a local buffer returned through a helper traps
// under --sanitize=address as stack-use-after-return.
// status: trap
// stderr: stack-use-after-return
fn bounce(s: []u8) []u8 {
    return s[1..8];
}

fn leak_buf() []u8 {
    let mut buf: [32]u8 = [0; 32];
    buf[1] = 42;
    return bounce(buf[..]);
}

export fn main() i32 {
    let s = leak_buf();
    return @as(i32, s[0]);
}
