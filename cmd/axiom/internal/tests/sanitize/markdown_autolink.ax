// Markdown with an extended autolink (www.x.com) in text the parser keeps in
// its buffer: the link's text was copied from that buffer after a push that
// could move it (a use after free, found by fuzzing). Nothing is reported.
// status: 0
import "std/mem" as mem;
import "std/text/markdown" as markdown;

export fn main() i32 {
    let src =
        "# Title >\nhtml\n</div>\n~/u \x22t\x22) ![r](j)\n\n```gox.y>\n\n> quote `code` [link](/u \x22t\x22) ![r](j)\n\n```go\nx\n```\n\n| a | b |\ni---|:-:|\n| 1 | 2 |\n\n[i]: /url\n\n<div*em* **strong**~del~~ www.x.com a@b.co &amp; &#123; \x5c* _x_\n";
    let html = markdown.to_html(src, markdown.Options.init()) catch return 1;
    mem.free(html);
    return 0;
}
