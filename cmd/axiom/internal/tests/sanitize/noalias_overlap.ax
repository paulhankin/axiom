// Overlapping slice arguments passed to noalias parameters trap under ASan.
// status: trap

fn copy_slices(noalias dst: []mut u8, src: []u8) void {
    for i in 0..dst.len {
        dst[i] = src[i];
    }
}

export fn main() i32 {
    let mut buf: [16]u8 = [1; 16];
    copy_slices(buf[2..8], buf[4..10]);
    return @as(i32, buf[0]);
}
