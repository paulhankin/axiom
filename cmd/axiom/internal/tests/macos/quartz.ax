// 2D drawing and text (std/graphics/quartz): shapes, text and its layout,
// read back pixel by pixel. macOS only:
// axiom test cmd/axiom/internal/tests/macos/quartz.ax --target=aarch64-macos (cmd/axiom/internal/tests/run.mjs runs
// it on a Mac).

import "std/graphics/quartz" as quartz;

test "shapes and text into pixels" {
    let mut c = quartz.Canvas.init(64, 32)!;
    defer c.deinit();
    c.begin();
    c.fill_rect(0.0, 0.0, 16.0, 16.0, quartz.rgb(1.0, 0.0, 0.0));
    c.fill_ellipse(48.0, 16.0, 8.0, 8.0, quartz.rgba(0.0, 0.0, 1.0, 0.5));
    let mut f = c.font("Helvetica, Arial", 14.0, quartz.BOLD, false)!;
    defer f.release();
    f.align(quartz.Align.CENTER, quartz.Align.CENTER);
    c.text(&f, "Hi", 16.0, 0.0, 24.0, 32.0, quartz.WHITE)!;
    c.end()!;
    let px = c.pixels();
    // the red square at the top left: B, G, R, A
    @expect((px[0] == 0) and (px[1] == 0) and (px[2] == 255) and (px[3] == 255));
    // the half-transparent blue disc's centre (premultiplied)
    let at: usize = ((16 * 64) + 48) * 4;
    @expect((px[at] >= 126) and (px[at] <= 129) and (px[at + 3] >= 126) and (px[at + 3] <= 129));
    // below the square: nothing
    @expect(px[(((24 * 64) + 4) * 4) + 3] == 0);
    // some of the text's pixels are white
    let mut white: u32 = 0;
    for y in @as(usize, 0)..32 {
        for x in @as(usize, 16)..40 {
            if px[(((y * 64) + x) * 4) + 3] > 200 {
                white += 1;
            }
        }
    }
    @expect(white > 10);
    let sz = c.measure(&f, "Hi there", 1000.0)!;
    @expect((sz.lines == 1) and (sz.width > 30.0) and (sz.height > 10.0));
    let wrapped = c.measure(&f, "Hi there, a longer line", 40.0)!;
    @expect(wrapped.lines >= 2);
    let mut img = c.to_image()!;
    defer img.deinit();
    @expect((img.data[0] == 255) and (img.data[1] == 0) and (img.data[2] == 0));
}
