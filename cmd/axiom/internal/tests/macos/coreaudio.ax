// Sound (std/audio/coreaudio): voices that play, loop, change pitch and
// stop, through the default output device (quietly). macOS only:
// axiom test cmd/axiom/internal/tests/macos/coreaudio.ax --target=aarch64-macos

import "std/audio" as audio;
import "std/audio/coreaudio" as ca;
import "std/thread" as thread;

test "voices play, loop, stop and end" {
    let mut eng = ca.Engine.init() catch |e| {
        // a machine without an output device has no engine: nothing to test
        @expect(e == error.Unsupported);
        return;
    };
    defer eng.deinit();
    // 4800 frames (0.1 s at 48 kHz) of a quiet tone, mono, 16-bit
    let mut snd = audio.Sound.init(4800, 1, 48000, audio.SampleFormat.S16)!;
    defer snd.deinit();
    for i in @as(usize, 0)..4800 {
        let x = @int_cast(i16, (@int_cast(i64, i % 100) - 50) * 20);
        @ptr_cast(*mut i16, &mut snd.data[i * 2]).* = x;
    }
    let mut v = eng.voice(&snd)!;
    defer v.deinit();
    v.set_volume(0.05);
    v.play(&snd, false)!;
    @expect(v.playing());
    var_wait(&v, 2000);
    @expect(not v.playing());
    @expect(v.frames_played() >= 4700);
    // looping goes on until end_loop
    v.play(&snd, true)!;
    thread.sleep_ms(250);
    @expect(v.playing());
    v.end_loop();
    var_wait(&v, 2000);
    @expect(not v.playing());
    // faster: half the time
    v.set_pitch(2.0);
    v.play(&snd, false)!;
    v.stop();
    @expect(not v.playing());
}

fn var_wait(v: *ca.Voice, ms: u32) void {
    for k in @as(u32, 0)..ms {
        _ = k;
        if not v.playing() {
            return;
        }
        thread.sleep_ms(1);
    }
}
