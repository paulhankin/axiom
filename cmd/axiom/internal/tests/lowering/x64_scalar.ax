// Scalar code on x86-64: read-modify-write memory
// operands, unsigned conversions to float in one instruction with
// AVX-512, a division by a power of two as a multiplication by its
// reciprocal, @min of a byte compared with an immediate, and x & ~y as
// andn.
//
// lower: --target=native --cpu=x86-64-v4 -O2 | \b(addb\s+\$0x1,|incb\s+)(0x31|49)\(%rdi\) | 1
// lower: --target=native --cpu=x86-64-v4 -O2 | \b(addb\s+\$0xff,|decb\s+)\(%rdi,%rsi(,1)?\) | 1
// lower: --target=native --cpu=x86-64-v4 -O2 | \baddl?\s+%edx,\s*(0x34|52)\(%rdi\) | 1
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvcvtusi2ss\b | 2
// lower: --target=native --cpu=x86-64-v4 -O2 | \bv?divss\b | 0
// lower: --target=native --cpu=x86-64-v4 -O2 | \bv?mulss\b | 1
// lower: --target=native --cpu=x86-64-v4 -O2 | \bcmpb?\s+\$(0xf|15),\s*%al\b | 1
// lower: --target=native --cpu=x86-64-v4 -O2 | \bandnq?\s+%rdi,\s*%rsi, | 1

struct Board {
    raw: [2][25]u8,
    count: u32,
}

export fn bump(b: *mut Board, i: usize, k: u32) void {
    b.raw[1][24] += 1;
    b.raw[0][i] -= 1;
    b.count += k;
}

export fn half(a: u32, b: u64) f32 {
    return (@float_from_int(f32, a) + @float_from_int(f32, b)) / 2.0;
}

export fn clamp15(p: *u8, i: usize) u64 {
    let b = @slice_from_ptr(p, 64);
    return @as(u64, @min(b[i], 15)) << 4;
}

export fn clear_bits(x: u64, y: u64) u64 {
    return x & ~y;
}
