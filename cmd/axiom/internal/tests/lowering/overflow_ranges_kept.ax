// Overflow checks that must stay (overflow_ranges.ax: the ones the ranges
// remove): each of these 14 functions can overflow, at x = cap = MAX, at a
// value two below a limit, past a mask's or a shift's room, with one operand
// not extended, a 16-bit sum, a shift that may lose its bit, a difference
// the comparison does not order, and a negation of a value that may be the
// minimum. One trap each, and the trap routine's own ud2 (x86-64) or call
// (AArch64). In sieve_marks the check of p * p at the loop's head stays (no
// bound of p is proved there), and that of m + p goes: p <= p * p <= n.
// lower: --target=native --cpu=x86-64 -O2 | \bud2\b | 17
// lower: --target=aarch64 -O2 | \bbl\b | 17

export fn inc_le_i(x: i64, cap: i64) i64 {
    if x <= cap {
        return x + 1;
    }
    return x;
}
export fn inc2_lt_i(x: i64, cap: i64) i64 {
    if x < cap {
        return x + 2;
    }
    return x;
}
export fn dec_ge_i(x: i32, lo: i32) i32 {
    if x >= lo {
        return x - 1;
    }
    return x;
}
export fn sub_gt_i(a: i64, b: i64) i64 {
    if a > b {
        return a - b;
    }
    return 0;
}
export fn inc_le_u(x: u64, cap: u64) u64 {
    if x <= cap {
        return x + 1;
    }
    return x;
}
export fn mask_add_hi(x: u64) u64 {
    return (x & ~@as(u64, 0xffff)) + 0x10000;
}
export fn shr_add(x: u64) u64 {
    return (x >> 1) + 0x8000_0000_0000_0000;
}
export fn sext_add(x: i64, y: i32) i64 {
    return x + @as(i64, y);
}
export fn zext_mul(x: u32, y: u64) u64 {
    return @as(u64, x) * y;
}
export fn sext_mul(x: i32, y: i64) i64 {
    return @as(i64, x) * y;
}
export fn sext_add16(x: i16, y: i16) i16 {
    return x + y;
}
export fn shl_sub(k: u32) u32 {
    let m = (@as(u32, 1) << (k & 31)) << 1;
    return m - 1;
}
export fn sub_lt_wrong(a: u64, b: u64) u64 {
    if a < b {
        return a - b;
    }
    return 0;
}
export fn neg_gt(x: i64, lo: i64) i64 {
    if x < lo {
        return -x;
    }
    return 0;
}
export fn sieve_marks() usize {
    let n: usize = 20_000_000;
    let mut p: usize = 2;
    while (p * p) <= n {
        let mut m = p * p;
        while m <= n {
            m += p;
        }
        p += 1;
    }
    return p;
}
