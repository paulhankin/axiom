// A mask made the same way in both arms of a branch: the arms
// only load, and the compare and the mask come once after the join.
//
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvcmpneqps\s | 1

export fn mask(p: *[16]f32, n: usize) u32 {
    let zero: f32x16 = @splat(0.0);
    let mut m: u32 = 0;
    if n >= 16 {
        m = @bitmask(@lanes_ne(@load(f32x16, p[0..16]), zero));
    } else {
        m = @bitmask(@lanes_ne(@load_partial(f32x16, p[0..n]), zero));
    }
    return m;
}
