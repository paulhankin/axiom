// Layout, copies and constants on x86-64: the stores under
// tests of equality, which are predicted false, out of the straight path;
// a multiplication by a constant into a register of its own; a constant
// that cmovs read built once; a clamped index that needs no checks.
//
// lower: --target=native --cpu=x86-64-v4 -O2 | \bcmp[bl]?\s+\$(0x29|41),\s*%\w+\n[^\n]*\bjne\b | 0
// lower: --target=native --cpu=x86-64-v4 -O2 | \bimull?\s+\$(0x25|37),\s*%(\w+),\s*%\2\b | 0
// lower: --target=native --cpu=x86-64-v4 -O2 | \bmovl?\s+\$(0x1b|27),\s*%\w+ | 1
// lower: --target=native --cpu=x86-64-v4 -O2 | \bcmp[lq]?\s+\$(0x39|57), | 0

export fn points(b: *[24]u8, out: *mut [96]f32) void {
    for i in @as(usize, 0)..24 {
        let n = b[i];
        if n == 41 {
            out[4 * i] = 1.0;
        } else if n == 42 {
            out[(4 * i) + 1] = 1.0;
        } else if n >= 43 {
            out[(4 * i) + 2] = 0.5;
        }
    }
}

export fn scaled(x: u32) u32 {
    return (x *% 37) ^ x;
}

export fn capped(b: *[4]u8) u32 {
    let a = @as(u32, @min(b[0], 27));
    let c = @as(u32, @min(b[1], 27));
    let d = @as(u32, @min(b[2], 27));
    let e = @as(u32, @min(b[3], 27));
    return ((a | (c << 4)) | (d << 8)) | (e << 12);
}

let T: [57]u32 = [7; 57];

export fn clamped(n: i32) u32 {
    return T[@int_cast(usize, @min(@max(60 - n, 0), 56))];
}
