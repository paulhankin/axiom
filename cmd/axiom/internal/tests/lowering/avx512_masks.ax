// AVX-512 compares as mask registers and the shuffles of neural-net kernels:
// a select of a float compare's operands is a
// minimum; other selects of compares pick lanes through k1 or merge the
// operation computing a lane into the other value, never expanding the
// mask into a vector (vpmovm2*); a test of lanes against zero is vptest*,
// also on 128 bits for @bitmask; a shuffle with zero lanes that widens the
// low half is vpmovzx*; interleaves within 128-bit groups are punpck*,
// and 128-bit groups vshufi64x2, not table permutes.
//
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvpmovm2[bwdq]\b | 0
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvminps\b[^\n]*zmm | 1
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvptestn?m[bd]\b | 3
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvpmovzxbw\b | 1
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvperm[it]2[bwd]\b | 0
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvpunpck[lh](dq|qdq)\b | 6

export fn sig(p: *f32, q: *mut f32) void {
    let x = @load(f32x16, @slice_from_ptr(p, 16));
    let one: f32x16 = @splat(1.0);
    let ten: f32x16 = @splat(10.0);
    let zero: f32x16 = @splat(0.0);
    let ax = @abs(x);
    let x1 = @select(@lanes_lt(ax, ten), ax, ten);
    let c = one / (x1 + one);
    let r = @select(@lanes_lt(x, zero), one - c, c);
    @store(@slice_from_ptr(q, 16), @select(@lanes_ge(x, ten), @as(f32x16, @splat(0.5)), r));
}

export fn pick(i: *u32, a: *f32, b: *f32, q: *mut f32) void {
    let idx = @load(u32x16, @slice_from_ptr(i, 16));
    let x = @load(f32x16, @slice_from_ptr(a, 16));
    let y = @load(f32x16, @slice_from_ptr(b, 16));
    let none: u32x16 = @splat(0);
    let m = @lanes_ne(idx & @as(u32x16, @splat(32)), none);
    @store(@slice_from_ptr(q, 16), @select(m, x, y));
}

export fn occupied(p: *u8) u32 {
    let v = @load(u8x16, @slice_from_ptr(p, 16));
    let w = @load(u8x16, @slice_from_ptr(p, 32)[16..]);
    let z: u8x16 = @splat(0);
    return @bitmask(@lanes_gt(v, z)) | (@bitmask(@lanes_gt(w, z)) << 16);
}

export fn widen(p: *u8, q: *mut i16) void {
    let z: u8x64 = @splat(0);
    let bytes = @load(u8x64, @slice_from_ptr(p, 64));
    let n = @bit_cast(i16x32, @shuffle(bytes, z, [0, 64, 1, 64, 2, 64, 3, 64, 4, 64, 5, 64, 6, 64, 7, 64, 8, 64, 9, 64,
                                                  10, 64, 11, 64, 12, 64, 13, 64, 14, 64, 15, 64, 16, 64, 17, 64, 18,
                                                  64, 19, 64, 20, 64, 21, 64, 22, 64, 23, 64, 24, 64, 25, 64, 26, 64,
                                                  27, 64, 28, 64, 29, 64, 30, 64, 31, 64]));
    @store(@slice_from_ptr(q, 32), n);
}

export fn sums(p: *i32, q: *mut i32) void {
    let s = @slice_from_ptr(p, 64);
    let v0 = @load(i32x16, s[0..]);
    let v1 = @load(i32x16, s[16..]);
    let v2 = @load(i32x16, s[32..]);
    let v3 = @load(i32x16, s[48..]);
    let p01 = @shuffle(v0, v1, [0, 16, 1, 17, 4, 20, 5, 21, 8, 24, 9, 25, 12, 28, 13, 29]) +% @shuffle(
        v0, v1, [2, 18, 3, 19, 6, 22, 7, 23, 10, 26, 11, 27, 14, 30, 15, 31]);
    let p23 = @shuffle(v2, v3, [0, 16, 1, 17, 4, 20, 5, 21, 8, 24, 9, 25, 12, 28, 13, 29]) +% @shuffle(
        v2, v3, [2, 18, 3, 19, 6, 22, 7, 23, 10, 26, 11, 27, 14, 30, 15, 31]);
    let q0 = @shuffle(p01, p23, [0, 1, 16, 17, 4, 5, 20, 21, 8, 9, 24, 25, 12, 13, 28, 29]) +% @shuffle(
        p01, p23, [2, 3, 18, 19, 6, 7, 22, 23, 10, 11, 26, 27, 14, 15, 30, 31]);
    let e = @shuffle(q0, q0, [0, 1, 2, 3, 8, 9, 10, 11, 0, 1, 2, 3, 8, 9, 10, 11]) +% @shuffle(
        q0, q0, [4, 5, 6, 7, 12, 13, 14, 15, 4, 5, 6, 7, 12, 13, 14, 15]);
    @store(@slice_from_ptr(q, 16), e);
}
