// Checked arithmetic tested where it is made, on AArch64, branches on the
// flags of the operation itself (mark_overflow, a64_sel.ax), or a select
// reads them: no cset of the overflow and compare of it. A multiply's
// overflow: the high half of 64 bits compared with 0 (umulh) or with the
// sign of the low half (smulh, and the one mul that gives the product), the
// 64-bit product of 32 bits (umull, smull) tested against its low half, the
// product of 8 or 16 bits (from extended operands, in 32 bits) against its
// low half extended; then b.ne. An add or sub and its overflow: adds or
// subs, then b.vs (signed) or b.cs / b.cc (unsigned); of 8 or 16 bits on the
// operands shifted to the top of 32 bits; with a constant, the immediate
// (where combine left a compare with a bound).
// lower: --target=aarch64 -O2 | \bcset\b | 0
// lower: --target=aarch64 -O2 | \bmul\s+w\d+, w\d+, w\d+\n[^\n]*\btst\s+w\d+, #0xffff(ff00|0000)\n[^\n]*\bb\.ne\b | 2
// lower: --target=aarch64 -O2 | \bcmp\s+w(\d+), w\1, sxt[bh]\n[^\n]*\bb\.ne\b | 2
// lower: --target=aarch64 -O2 | \bumull\s+x(\d+), w\d+, w\d+\n[^\n]*\btst\s+x\1, #0xffffffff00000000\n[^\n]*\bb\.ne\b | 1
// lower: --target=aarch64 -O2 | \bsmull\s+x(\d+), w\d+, w\d+\n[^\n]*\bcmp\s+x\1, w\1, sxtw\n[^\n]*\bb\.ne\b | 1
// lower: --target=aarch64 -O2 | \bumulh\s+x(\d+), x\d+, x\d+\n[^\n]*\bcmp\s+x\1, #0x0\n[^\n]*\b(b\.ne|csel\s[^\n]*ne)\b | 2
// lower: --target=aarch64 -O2 | \bsmulh\s+x(\d+), x\d+, x\d+\n[^\n]*\bcmp\s+x\1, x\d+, asr #63\n[^\n]*\b(b\.ne|csel\s[^\n]*ne)\b | 2
// lower: --target=aarch64 -O2 | \bmul\s+x\d+, x[01], x[01]\n | 4
// lower: --target=aarch64 -O2 | \badds\s+w\d+, w\d+, w\d+, lsl #24\n[^\n]*\basr\b[^\n]*\n[^\n]*\bb\.vs\b | 1
// lower: --target=aarch64 -O2 | \bsubs\s+w\d+, w\d+, w\d+, lsl #16\n[^\n]*\blsr\b[^\n]*\n[^\n]*\bb\.cc\b | 1
// lower: --target=aarch64 -O2 | \badds\s+x\d+, x\d+, x\d+\n[^\n]*\bb\.vs\b | 1
// lower: --target=aarch64 -O2 | \bsubs\s+w\d+, w\d+, w\d+\n[^\n]*\bb\.vs\b | 1
// lower: --target=aarch64 -O2 | \badds\s+x\d+, x\d+, x\d+\n[^\n]*\bb\.cs\b | 1
// lower: --target=aarch64 -O2 | \bsubs\s+w\d+, w\d+, w\d+\n[^\n]*\bb\.cc\b | 1
// lower: --target=aarch64 -O2 | \badds\s+x\d+, x\d+, #0xa\n[^\n]*\bb\.cs\b | 1
// lower: --target=aarch64 -O2 | \bsubs\s+w\d+, w\d+, #0xa\n[^\n]*\bb\.cc\b | 1
// lower: --target=aarch64 -O2 | \badds\s+w\d+, w\d+, #0xa\n[^\n]*\bb\.vs\b | 1
// lower: --target=aarch64 -O2 | \beor\b | 1

export fn mul_u8(a: u8, b: u8) u8 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_i8(a: i8, b: i8) i8 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_u16(a: u16, b: u16) u16 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_i16(a: i16, b: i16) i16 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_u32(a: u32, b: u32) u32 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_i32(a: i32, b: i32) i32 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_u64(a: u64, b: u64) u64 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_i64(a: i64, b: i64) i64 {
    return @mul_checked(a, b) catch 1;
}

export fn add_i8(a: i8, b: i8) i8 {
    return @add_checked(a, b) catch 1;
}

export fn sub_u16(a: u16, b: u16) u16 {
    return @sub_checked(a, b) catch 1;
}

export fn add_i64(a: i64, b: i64) i64 {
    return @add_checked(a, b) catch 1;
}

export fn sub_i32(a: i32, b: i32) i32 {
    return @sub_checked(a, b) catch 1;
}

export fn add_u64(a: u64, b: u64) u64 {
    return @add_checked(a, b) catch 1;
}

export fn sub_u32(a: u32, b: u32) u32 {
    return @sub_checked(a, b) catch 1;
}

export fn add_k_u64(a: u64) u64 {
    return @add_checked(a, 10) catch 1;
}

export fn sub_k_u32(a: u32) u32 {
    return @sub_checked(a, 10) catch 1;
}

export fn add_k_i32(a: i32) i32 {
    return @add_checked(a, 10) catch 1;
}

export fn mul_sat_u64(a: u64, b: u64) u64 {
    return @mul_sat(a, b);
}

export fn mul_sat_i64(a: i64, b: i64) i64 {
    return @mul_sat(a, b);
}
