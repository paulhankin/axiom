// A load after an atomic load stays after it (spec §12.8.2), though
// hoist_reads_of would put it first, in front of the step of the loop's
// pointer (the atomic load of *flag, then within three instructions the
// load of p.*).
//
// lower-selfhost: --target=native -O1 | \(%rdi\),%(e[a-z]{2}|r\d+d)\n([^\n]*\n){0,2}[^\n]*\(%r\w+\),%r([a-z]{2}|\d+)\n | 1
// lower-selfhost: --target=native -O2 | \(%rdi\),%(e[a-z]{2}|r\d+d)\n([^\n]*\n){0,2}[^\n]*\(%r\w+\),%r([a-z]{2}|\d+)\n | 1

export fn consume(flag: *u32, data: *u64, n: usize) u64 {
    let mut p = data;
    let mut s: u64 = 0;
    let mut i: usize = 0;
    while i < n {
        let q = @ptr_add(p, 1);
        let f = @atomic_load(flag);
        let v = p.*;
        s = s + (v ^ @as(u64, f)) + (v >> 3);
        p = q;
        i += 1;
    }
    return s;
}
