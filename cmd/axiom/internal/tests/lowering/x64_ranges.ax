// Checks that the ranges of values decide are left out (issue 0060): a
// trailing-zero count of a masked value known not zero, its @min with a
// constant, table loads bounded by the largest element of a constant
// table, indices from them, and the guard of a shift whose count is below
// the width. A shift by any count is one shlx with a cmov for counts of 32
// and more.
//
// lower: --target=native --cpu=x86-64-v4 -O2 | \bcmp[lq]?\s+\$0x19, | 0
// lower: --target=native --cpu=x86-64-v4 -O2 | \bcmp[lq]?\s+\$0xbb9, | 0
// lower: --target=native --cpu=x86-64-v4 -O2 | \bcmp[lq]?\s+\$0x1b, | 0
// lower-selfhost: --target=native --cpu=x86-64-v4 -O2 | \bshlx\s+%esi,%edi,%eax\n[^\n]*\bxor\s+%ecx,%ecx\n[^\n]*\bcmp\s+\$0x20,%esi\n[^\n]*\bcmovae\s+%ecx,%eax | 1

let TABLE: [3001]u32 = [36; 3001];
let MASKS: [13]u32 = [0, 1, 3, 7, 15, 31, 63, 127, 255, 511, 1023, 2047, 2999];

export fn mobility(board: *[25]u8, occupied: u32, blocked: u32) i32 {
    let mut n: i32 = 0;
    let mut m = (occupied >> 6) & 0x7FFFF;
    while m != 0 {
        let idx = 6 + @ctz(m);
        m &= m - 1;
        let k = @as(usize, @min(idx, 12));
        let af = @as(usize, (blocked >> (24 - idx)) & MASKS[k]);
        let e = @int_cast(i32, TABLE[af]);
        n += ((@int_cast(i32, idx) - 5) * @as(i32, board[@as(usize, idx)])) * e;
    }
    return n;
}

export fn top_bits(m: u32, out: *mut [27]u8) void {
    let mut mask = m & 0x7FF_FFFF;
    while mask != 0 {
        let i = 31 - @clz(mask);
        mask ^= @as(u32, 1) << i;
        out[@as(usize, i)] += 1;
    }
}

export fn shift(x: u32, k: u32) u32 {
    return x << k;
}
