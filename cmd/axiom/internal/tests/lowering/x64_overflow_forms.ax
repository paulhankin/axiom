// The forms of checked arithmetic beside two values in registers
// (x64_overflow_flags.ax), on x86-64: an add or sub of a constant, which
// combine turns into a compare with a bound, is the add (of the constant, or
// of its negation for a sub) and a jb / jae on its carry, not a cmp, a jump
// and the add after it; @mul_sat's select on the overflow reads the
// multiply's flags (cmovb, cmovo), not a setcc of them tested again.
// lower: --target=native --cpu=x86-64 -O2 | \bset[a-z]+\s | 0
// lower: --target=native --cpu=x86-64 -O2 | \bcmp\s+\$0x(fffffffffffffff5|a|fc), | 0
// lower: --target=native --cpu=x86-64 -O2 | \badd\s+\$0xa,%rdi\n[^\n]*\bjb\b | 1
// lower: --target=native --cpu=x86-64 -O2 | \badd\s+\$0xfffffff6,%edi\n[^\n]*\bjae\b | 1
// lower: --target=native --cpu=x86-64 -O2 | \badd\s+\$0x3,%dil\n[^\n]*\bjb\b | 1
// lower: --target=native --cpu=x86-64 -O2 | \bmul\s+%[er]si\n[^\n]*\bcmovb\b | 2
// lower: --target=native --cpu=x86-64 -O2 | \bimul\s+%rsi,%rdi\n[^\n]*\bcmovo\b | 1
// lower: --target=native --cpu=x86-64 -O2 | \bimul\s+%si,%di\n[^\n]*\bcmovo\b | 1

export fn add_k_u64(a: u64) u64 {
    return @add_checked(a, 10) catch 1;
}

export fn sub_k_u32(a: u32) u32 {
    return @sub_checked(a, 10) catch 1;
}

export fn add_k_u8(a: u8) u8 {
    return @add_checked(a, 3) catch 1;
}

export fn mul_sat_u64(a: u64, b: u64) u64 {
    return @mul_sat(a, b);
}

export fn mul_sat_i64(a: i64, b: i64) i64 {
    return @mul_sat(a, b);
}

export fn mul_sat_u32(a: u32, b: u32) u32 {
    return @mul_sat(a, b);
}

export fn mul_sat_i16(a: i16, b: i16) i16 {
    return @mul_sat(a, b);
}
