// Division and remainder by constants have no divide instruction
// (divconst.ax): unsigned and signed, 8 to 64 bits, quotients, remainders,
// both of the same dividend (one multiplication), tests of divisibility
// and powers of two; a division by a variable keeps its one. (The lines
// read the disassembly of the functions, which only objdump prints.)
//
// lower-selfhost: --target=native -O2 | <(u7|u10|s40|s8|sm7|b3|q10|q7|sq|sqm|leap|var)>:\n(?:.+\n)*?.*\bi?div[bwlq]?\s | 1
// lower-selfhost: --target=native -O1 | <(u7|u10|s40|s8|sm7|b3|q10|q7|sq|sqm|leap|var)>:\n(?:.+\n)*?.*\bi?div[bwlq]?\s | 1

export fn u7(x: u32) u32 {
    return x / 7;
}

export fn u10(x: u32, r: *mut u32) u32 {
    r.* = x % 10;
    return x / 10;
}

export fn s40(x: i32) i32 {
    return x % 40;
}

export fn s8(x: i32) i32 {
    return (x / 8) + (x % 8);
}

export fn sm7(x: i16) i16 {
    return x / -7;
}

export fn b3(x: u8) u8 {
    return (x / 3) + (x % 3);
}

export fn q10(x: u64) u64 {
    return x / 10;
}

export fn q7(x: u64) u64 {
    return x % 7;
}

export fn sq(x: i64) i64 {
    return x / 1000000000;
}

export fn sqm(x: i64) i64 {
    return x % -3;
}

export fn leap(y: u32) bool {
    return ((y % 4) == 0) and (((y % 100) != 0) or ((y % 400) == 0));
}

export fn var(x: u32, y: u32) u32 {
    return x / y;
}
