// @widen_low and @widen_high of integer lanes are vpmovsx and vpmovzx on x86-64 with SSE4.1
// (of the high half moved down: vextracti128 for 256 bits), one per result register, not
// lane by lane; without SSE4.1, lane by lane. The shape of a small network layer:
// i16x16 lanes widened to i32x8 and multiplied, and u8 lanes widened to u16.
//
// lower: --target=native --cpu=x86-64-v3 -O2 | \bvpmovsxwd\b[^\n]*ymm | 8
// lower: --target=native --cpu=x86-64-v3 -O2 | \bvpmovzxbw\b[^\n]*ymm | 2
// lower-selfhost: --target=native --cpu=x86-64-v3 -O2 | \bvextracti128\b | 5
// lower: --target=native --cpu=x86-64-v3 -O2 | \bvpextrw\b | 0
// lower: --target=native --cpu=x86-64-v2 -O2 | \bpmovsxwd\b | 16
// lower: --target=native --cpu=x86-64-v2 -O2 | \bpextrw\b | 0
// lower: --target=native --cpu=x86-64 -O2 | \bpmovsxwd\b | 0

export fn products(p: *i16, w: *i16, b: *u8, q: *mut i32, r: *mut u16) void {
    let x = @slice_from_ptr(p, 32);
    let y = @slice_from_ptr(w, 32);
    let out = @slice_from_ptr(q, 32);
    for k in @as(usize, 0)..2 {
        let a = @load(i16x16, x[(k * 16)..((k + 1) * 16)]);
        let c = @load(i16x16, y[(k * 16)..((k + 1) * 16)]);
        @store(out[(k * 16)..((k * 16) + 8)], @widen_low(a) * @widen_low(c));
        @store(out[((k * 16) + 8)..((k + 1) * 16)], @widen_high(a) * @widen_high(c));
    }
    let bytes = @load(u8x32, @slice_from_ptr(b, 32)[0..32]);
    let o = @slice_from_ptr(r, 32);
    @store(o[0..16], @widen_low(bytes));
    @store(o[16..32], @widen_high(bytes));
}
