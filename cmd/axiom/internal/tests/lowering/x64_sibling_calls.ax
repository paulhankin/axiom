// Calls in tail position to other functions (cmd/axiom/src/tailrec.ax:
// sibling calls): at -O2, with no call records for stack traces, a jump
// after the epilogue (to a symbol, or through r11 for a pointer); with
// traces (spec §16.4.1), or below -O2, a call that keeps its frame. (At -O2
// the two functions are inlined into each other: each calls itself.)
//
// lower-selfhost: --target=native -O2 --stack-traces=off | add\s+\$0xf+[0-9a-f],%rdi\n\s+\w+:\s+jmp\s+\w+ <is_(even|odd) | 2
// lower-selfhost: --target=native -O2 --stack-traces=off | %rdi\n\s+\w+:\s+call\s+\w+ <is_(even|odd) | 0
// lower-selfhost: --target=native -O2 --stack-traces=off | and\s+\$0x3,%rsi\n(\s+\w+:[^\n]*\n){0,3}?\s+\w+:\s+rex\.WB jmp \*%r11 | 1
// lower-selfhost: --target=native -O2 | %rdi\n\s+\w+:\s+call\s+\w+ <is_(even|odd) | 2
// lower-selfhost: --target=native -O2 | and\s+\$0x3,%rsi\n(\s+\w+:[^\n]*\n){0,4}?\s+\w+:\s+call\s+\* | 1
// lower-selfhost: --target=native -O1 --stack-traces=off | %rdi\n\s+\w+:\s+call\s+\w+ <is_(even|odd) | 2
// lower-selfhost: --target=native -O1 --stack-traces=off | and\s+\$0x3,%rsi\n(\s+\w+:[^\n]*\n){0,4}?\s+\w+:\s+call\s+\* | 1

export fn is_even(n: u64) bool {
    if n == 0 {
        return true;
    }
    return is_odd(n - 1);
}

export fn is_odd(n: u64) bool {
    if n == 0 {
        return false;
    }
    return is_even(n - 1);
}

export fn dispatch(table: *[4]fn(u64) u64, k: usize, x: u64) u64 {
    return table[k & 3](x);
}
