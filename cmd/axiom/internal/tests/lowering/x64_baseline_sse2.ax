// Baseline x86-64 (SSE2 only, issues 0106 and 0111): an integer into lane 0
// of zeros, or into another lane without SSE4.1's pinsrd / pinsrq, is a
// movd / movq and shuffles, never the vector stored to the stack, the lane
// stored over it and the whole loaded back (a load that waits for both
// stores); the trailing zeros of a mask in a loop over its set bits, which
// is never zero there, are a bsf alone (no cmov for a zero mask).
//
// lower: --target=native --cpu=x86-64 -O2 | movdqu\s+%xmm\d+,\s*-0x[0-9a-f]+\(%rbp\)\n(?:[^\n]*\n){0,2}[^\n]*\smov[lq]?\s+%[re]\w+,\s*-0x[0-9a-f]+\(%rbp\)\n(?:[^\n]*\n){0,2}[^\n]*movdqu\s+-0x[0-9a-f]+\(%rbp\),\s*%xmm | 0
// lower: --target=native --cpu=x86-64 -O2 | bsf\s[^\n]*\n[^\n]*cmov | 0

export fn low_zero(x: u64, out: *mut u64x2) void {
    out.* = @vec(u64x2, x, 0);
}

export fn lane32(v: *mut u32x4, x: u32, y: u32) void {
    v.* = @replace_lane(@replace_lane(v.*, 1, x), 3, y);
}

export fn lane64(v: *mut u64x2, x: u64) void {
    v.* = @replace_lane(v.*, 1, x);
}

export fn weights(mask: u32, w: *[32]u32) u32 {
    let mut m = mask;
    let mut s: u32 = 0;
    while m != 0 {
        let i = @ctz(m);
        m &= m - 1;
        s +%= w[@as(usize, i)] *% (i + 1);
    }
    return s;
}
