// acc + @dot(x, y) of u8 by i8 lanes is one vpdpbusd into the accumulator where the CPU has
// VNNI: no zeroed register and no separate add (vpaddd) for each, the accumulator loaded
// from memory included (on AVX-VNNI the 512-bit sums are two ymm halves). With AVX-512 VNNI
// and no AVX-VNNI the 256-bit sums are vpdpbusd too, in its EVEX form.
//
// lower: --target=native --cpu=icelake-server -O2 | \bvpdpbusd\b[^\n]*zmm | 4
// lower: --target=native --cpu=icelake-server -O2 | \bvpaddd\b[^\n]*zmm | 0
// lower: --target=native --cpu=icelake-server -O2 | \bvpdpbusd\b[^\n]*ymm | 4
// lower: --target=native --cpu=icelake-server -O2 | \bimul | 0
// lower: --target=native --cpu=alderlake -O2 | \bvpdpbusd\b[^\n]*ymm | 12
// lower: --target=native --cpu=alderlake -O2 | \bvpaddd\b | 0

export fn sums512(p: *u8, w: *i8, q: *mut i32) void {
    let a = @slice_from_ptr(p, 256);
    let b = @slice_from_ptr(w, 256);
    let out = @slice_from_ptr(q, 16);
    let mut s = @load(i32x16, out[0..16]);
    for k in @as(usize, 0)..4 {
        s = s + @dot(@load(u8x64, a[(k * 64)..((k + 1) * 64)]), @load(i8x64, b[(k * 64)..((k + 1) * 64)]));
    }
    @store(out[0..16], s);
}

export fn sums256(p: *u8, w: *i8, q: *mut i32) void {
    let a = @slice_from_ptr(p, 128);
    let b = @slice_from_ptr(w, 128);
    let out = @slice_from_ptr(q, 8);
    let mut s = @load(i32x8, out[0..8]);
    for k in @as(usize, 0)..4 {
        s = @dot(@load(u8x32, a[(k * 32)..((k + 1) * 32)]), @load(i8x32, b[(k * 32)..((k + 1) * 32)])) + s;
    }
    @store(out[0..8], s);
}
