// Overflow checks that the ranges of the operands show cannot fail are left
// out (gvn.ax): a difference of a value from one known no smaller, a step
// of a counter below a limit (unsigned and signed, up or down), a sum with a
// masked, shifted or extended value, products of extended 32-bit values,
// negation and @abs of a value above the minimum, and a shift's result known
// not 0. Every function here is free of checks: the one ud2 (x86-64) or
// call (AArch64) left in the code is the trap routine's own
// (overflow_ranges_kept.ax: the checks that must stay).
// lower: --target=native --cpu=x86-64 -O2 | \bud2\b | 2
// lower: --target=aarch64 -O2 | \bbl\b | 2

export fn sub_lt(a: u64, b: u64) u64 {
    if a < b {
        return b - a;
    }
    return 0;
}
export fn sub_le(a: u64, b: u64) u64 {
    if a <= b {
        return b - a;
    }
    return 0;
}
export fn sub_ge32(a: u32, b: u32) u32 {
    if b >= a {
        return b - a;
    }
    return 0;
}
export fn inc_lt(x: u64, cap: u64) u64 {
    if x < cap {
        return x + 1;
    }
    return x;
}
export fn inc_lt32(x: u32, cap: u32) u32 {
    if x < cap {
        return x + 1;
    }
    return x;
}
export fn inc_lt_i(x: i64, cap: i64) i64 {
    if x < cap {
        return x + 1;
    }
    return x;
}
export fn dec_gt_i(x: i64, lo: i64) i64 {
    if x > lo {
        return x - 1;
    }
    return x;
}
export fn dec_nz(x: u64) u64 {
    if x == 0 {
        return 0;
    }
    return x - 1;
}
export fn dec_nz32(x: u32) u32 {
    if x != 0 {
        return x - 1;
    }
    return 0;
}
export fn mask_add(x: u64) u64 {
    return (x & 0xfff) + 100;
}
export fn mask_add_hi(x: u64) u64 {
    return (x & ~@as(u64, 0xffff)) + 128;
}
export fn shr_add(x: u64) u64 {
    return (x >> 1) + 5;
}
export fn zext_add(x: u32) u64 {
    return @as(u64, x) + 1000;
}
export fn zext_mul(x: u32, y: u32) u64 {
    return @as(u64, x) * @as(u64, y);
}
export fn zext_add2(x: u32, y: u32) u64 {
    return @as(u64, x) + @as(u64, y);
}
export fn sext_add(x: i32, y: i32) i64 {
    return @as(i64, x) + @as(i64, y);
}
export fn loop_sum(n: usize, p: *[64]u8) u64 {
    let mut s: u64 = 0;
    let mut i: usize = 0;
    while i < n {
        s +%= @as(u64, p[i & 63]);
        i += 1;
    }
    return s;
}
export fn loop_i32(n: i32, p: *[64]u8) i32 {
    let mut s: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        s +%= @as(i32, p[@as(usize, @bit_cast(u32, i)) & 63]);
        i += 1;
    }
    return s;
}
export fn loop_down(n: u64) u64 {
    let mut s: u64 = 0;
    let mut i = n;
    while i > 0 {
        i -= 1;
        s +%= i;
    }
    return s;
}
export fn sub_mask(p: u64) u64 {
    let s = p & ~@as(u64, 0xffff);
    return p - s;
}
export fn sub_mask2(p: u64) u64 {
    let s = p & ~@as(u64, 0xffff);
    if p < s + 128 {
        return 0;
    }
    return p - (s + 128);
}
export fn shl_sub(k: u32) u32 {
    let m = (@as(u32, 1) << (k & 31));
    return m - 1;
}
export fn neg_gt(x: i64, lo: i64) i64 {
    if x > lo {
        return -x;
    }
    return 0;
}
export fn abs_gt(x: i32) i32 {
    if x > -100 {
        return @abs(x);
    }
    return 0;
}
export fn count_down(n: i32) i32 {
    let mut s: i32 = 0;
    let mut i = n;
    while i > 0 {
        i -= 1;
        s +%= i;
    }
    return s;
}
