// Vector @int_from_float on AVX-512: the unsigned conversions
// saturate out-of-range lanes by themselves, so they are the conversion
// zero-masked (or fed a maximum with zero) for NaN and negatives, without
// clamping to the largest float below 2^32; the signed ones fix up only
// the large and NaN lanes. @swizzle2 of f32 lanes is vpermt2ps/vpermi2ps,
// in the floating-point domain, not an integer permute.
//
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvminp[sd]\b | 0
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvcvttps2udq\b | 2
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvcvttps2dq\b | 1
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvcvttpd2qq\b | 1
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvperm[it]2ps\b | 1
// lower: --target=native --cpu=x86-64-v4 -O2 | \bvperm[it]2d\b | 0

export fn to_u32x16(p: *f32, q: *mut u32) void {
    let x = @load(f32x16, @slice_from_ptr(p, 16));
    @store(@slice_from_ptr(q, 16), @int_from_float(u32x16, x));
}

export fn to_u32x4(p: *f32, q: *mut u32) void {
    let x = @load(f32x4, @slice_from_ptr(p, 4));
    @store(@slice_from_ptr(q, 4), @int_from_float(u32x4, x));
}

export fn to_i32x16(p: *f32, q: *mut i32) void {
    let x = @load(f32x16, @slice_from_ptr(p, 16));
    @store(@slice_from_ptr(q, 16), @int_from_float(i32x16, x));
}

export fn to_i64x8(p: *f64, q: *mut i64) void {
    let x = @load(f64x8, @slice_from_ptr(p, 8));
    @store(@slice_from_ptr(q, 8), @int_from_float(i64x8, x));
}

export fn table(i: *u32, a: *f32, b: *f32, q: *mut f32) void {
    let idx = @load(u32x16, @slice_from_ptr(i, 16));
    let x = @load(f32x16, @slice_from_ptr(a, 16));
    let y = @load(f32x16, @slice_from_ptr(b, 16));
    @store(@slice_from_ptr(q, 16), @swizzle2(x, y, idx));
}
