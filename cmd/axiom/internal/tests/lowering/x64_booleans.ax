// @any_true of a 128-bit vector as a branch condition on x86-64 (issue
// 0067): a branch on ptest's flags, not pmovmskb, a compare, setcc and a
// test.
//
// lower: --target=native --cpu=x86-64-v2 -O2 | \bv?ptest\s | 1

export fn any4(p: *[4]i32, q: *[4]i32, out: *mut u32) void {
    if @any_true(@load(i32x4, p[0..4]) ^ @load(i32x4, q[0..4])) {
        out.* += 1;
    }
}
