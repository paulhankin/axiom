// x86-64 floating point operands: a constant read once by a scalar addsd or
// mulsd is its memory operand with legacy SSE as with VEX (and with VEX
// also as the first operand of the commutative ones); @fma(a, b, -c) is a
// vfmsub and @fma(-a, b, c) a vfnmadd, the negation no instruction of its
// own; and a function whose quick path returns before its calls, the
// returns of an inlined callee meeting at one return, sets up its frame
// only on the path that makes the call.
//
// lower-selfhost: --target=native --cpu=x86-64 -O2 | (?:add|mul)sd\s+-?0x[0-9a-f]+\(%rip\),\s*%xmm | 2
// lower-selfhost: --target=native --cpu=x86-64-v3 -O2 | vaddsd\s+-?0x[0-9a-f]+\(%rip\),\s*%xmm\d+,\s*%xmm | 2
// lower-selfhost: --target=native --cpu=x86-64-v3 -O2 | vfmsub231sd | 1
// lower-selfhost: --target=native --cpu=x86-64-v3 -O2 | vfnmadd231sd | 1
// lower-selfhost: --target=native --cpu=x86-64-v3 -O2 | vxorpd | 0
// lower-selfhost: --target=native --cpu=x86-64 -O2 | <quick_or_call>:\n[^\n]*push | 0

extern "C" {
    fn ext_slow(x: f64) f64;
}

export fn affine(x: f64) f64 {
    return (x * 1.25) + 0.375;
}

export fn affine_first(x: f64, y: f64) f64 {
    return 0.625 + (x * y);
}

export fn prod_err(a: f64, b: f64) f64 {
    let p = a * b;
    return @fma(a, b, -p);
}

export fn sub_prod(a: f64, b: f64, c: f64) f64 {
    return @fma(-b, c, a);
}

inline fn quick(x: f64) f64 {
    if x < 0.0 {
        return ext_slow(x);
    }
    return x * x;
}

export fn quick_or_call(x: f64) f64 {
    return quick(x);
}
