// @prefetch and @prefetch_write (issues 0041, 0093): prefetcht0, and
// prefetchw where the extensions include prfchw (Broadwell's: skylake has
// it, haswell and x86-64-v3 do not), else prefetcht0 (on Arm, prfm
// pldl1keep and pstl1keep); nothing on WebAssembly. The address folds into
// the instruction's memory operand.
//
// lower: --target=native --cpu=skylake -O2 | \bprefetchw\s+\S*\(%r\w+,%r\w+,8\) | 1
// lower: --target=native --cpu=skylake -O2 | \bprefetchw\b | 2
// lower: --target=native --cpu=skylake -O2 | \bprefetcht0\b | 1
// lower: --target=native --cpu=haswell -O2 | \bprefetchw\b | 0
// lower: --target=native --cpu=haswell -O2 | \bprefetcht0\b | 3
// lower: --target=native --cpu=x86-64-v3 --features=+prfchw -O2 | \bprefetchw\b | 2
// lower: --target=wasm32 -O2 | \tprefetch | 0

export fn read(p: *u64) void {
    @prefetch(p);
}

export fn write(p: *mut u64) void {
    @prefetch_write(p);
}

export fn write_at(t: *mut [64]u64, i: usize) void {
    @prefetch_write(&mut t[i & 63]);
}
