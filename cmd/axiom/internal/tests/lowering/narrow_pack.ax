// @narrow of 16- and 32-bit lanes is a pack on x86-64 (packsswb, packuswb, packssdw,
// packusdw, which SSE2 has but the last), with a vpermq at 256 and 512 bits to put the
// 128-bit lanes' halves in order, and a clamp (pminuw, SSE4.1) first for unsigned lanes:
// not lane by lane (which unsigned lanes still are without SSE4.1).
//
// lower: --target=native --cpu=x86-64 -O2 | \bpacksswb\b | 1
// lower: --target=native --cpu=x86-64 -O2 | \bpackuswb\b | 4
// lower: --target=native --cpu=x86-64-v2 -O2 | \bpackusdw\b | 1
// lower: --target=native --cpu=x86-64-v3 -O2 | \bvpackuswb\b[^\n]*ymm | 4
// lower: --target=native --cpu=x86-64-v3 -O2 | \bvpermq\b | 4
// lower: --target=native --cpu=icelake-server -O2 | \bvpackuswb\b[^\n]*zmm | 2
// lower: --target=native --cpu=icelake-server -O2 | \bvpminuw\b[^\n]*zmm | 2
// lower: --target=native --cpu=icelake-server -O2 | \bvpermq\b[^\n]*zmm | 2

export fn s8(p: *i16, q: *mut i8) void {
    let a = @slice_from_ptr(p, 16);
    let o = @slice_from_ptr(q, 16);
    @store(o[0..16], @narrow(i8x16, @load(i16x8, a[0..8]), @load(i16x8, a[8..16])));
}

export fn u16_of_i32(p: *i32, q: *mut u16) void {
    let a = @slice_from_ptr(p, 8);
    let o = @slice_from_ptr(q, 8);
    @store(o[0..8], @narrow(u16x8, @load(i32x4, a[0..4]), @load(i32x4, a[4..8])));
}

export fn u8_wide(p: *i16, q: *mut u8) void {
    let a = @slice_from_ptr(p, 64);
    let o = @slice_from_ptr(q, 64);
    @store(o[0..64], @narrow(u8x64, @load(i16x32, a[0..32]), @load(i16x32, a[32..64])));
}

export fn u8_of_u16(p: *u16, q: *mut u8) void {
    let a = @slice_from_ptr(p, 64);
    let o = @slice_from_ptr(q, 64);
    @store(o[0..64], @narrow(u8x64, @load(u16x32, a[0..32]), @load(u16x32, a[32..64])));
}
