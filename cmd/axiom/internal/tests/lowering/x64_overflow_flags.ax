// Checked arithmetic tested where it is made branches on the flags of the
// operation itself (mark_overflow, x64.ax): no setcc of the overflow and
// test of it, and a checked multiply is one multiply, which gives the
// product too. Signed: imul r, r (16 to 64 bits) or the one-operand imul of
// al (8 bits), then jo; unsigned: mul (rdx:rax, 32 and 64 bits; ax, 8 bits)
// then jb; 16 bits unsigned: the product of the zero-extended operands,
// compared with 0xffff. An add or sub and its overflow: add / sub, then jo
// (signed) or jb (unsigned).
// lower: --target=native --cpu=x86-64 -O2 | \bset[a-z]+\s | 0
// lower: --target=native --cpu=x86-64 -O2 | \bi?mul\s | 8
// lower: --target=native --cpu=x86-64 -O2 | \bimul\s+%\w+,%\w+\n[^\n]*\bjo\b | 3
// lower: --target=native --cpu=x86-64 -O2 | \bimul\s+%\w+\n[^\n]*\bjo\b | 1
// lower: --target=native --cpu=x86-64 -O2 | \bmul\s+%\w+\n[^\n]*\bjb\b | 3
// lower: --target=native --cpu=x86-64 -O2 | \bcmp\s+\$0xffff,%\w+\n[^\n]*\bja\b | 1
// lower: --target=native --cpu=x86-64 -O2 | \badd\s+%\w+,%\w+\n[^\n]*\bjo\b | 2
// lower: --target=native --cpu=x86-64 -O2 | \bsub\s+%\w+,%\w+\n[^\n]*\bjo\b | 1
// lower: --target=native --cpu=x86-64 -O2 | \badd\s+%\w+,%\w+\n[^\n]*\bjb\b | 1
// lower: --target=native --cpu=x86-64 -O2 | \bsub\s+%\w+,%\w+\n[^\n]*\bjb\b | 1

export fn mul_u8(a: u8, b: u8) u8 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_i8(a: i8, b: i8) i8 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_u16(a: u16, b: u16) u16 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_i16(a: i16, b: i16) i16 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_u32(a: u32, b: u32) u32 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_i32(a: i32, b: i32) i32 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_u64(a: u64, b: u64) u64 {
    return @mul_checked(a, b) catch 1;
}

export fn mul_i64(a: i64, b: i64) i64 {
    return @mul_checked(a, b) catch 1;
}

export fn add_i8(a: i8, b: i8) i8 {
    return @add_checked(a, b) catch 1;
}

export fn add_i64(a: i64, b: i64) i64 {
    return @add_checked(a, b) catch 1;
}

export fn sub_i32(a: i32, b: i32) i32 {
    return @sub_checked(a, b) catch 1;
}

export fn add_u64(a: u64, b: u64) u64 {
    return @add_checked(a, b) catch 1;
}

export fn sub_u32(a: u32, b: u32) u32 {
    return @sub_checked(a, b) catch 1;
}
