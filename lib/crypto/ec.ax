// =============================================================================
// lib/crypto/ec.ax - the NIST curves P-256 and P-384: ECDH and ECDSA
// (FIPS 186-4, SEC 1).
//
//     let k = ec.P256.generate()!;
//     k.public_key(pub[..]);                    // 65 bytes: 04 || X || Y
//     k.ecdh(their_public, shared[..])!;        // 32 bytes
//     k.sign(digest, sig[..])!;                 // r || s, 64 bytes
//     ec.verify_p256(pub, digest, sig)          // bool
//
// and likewise ec.P384 and ec.verify_p384 (97, 48 and 96 bytes).
//
// Arithmetic modulo the field prime and the group order is Montgomery
// multiplication on 64-bit limbs with masked final subtractions, and points
// are added with the complete formulas of Renes, Costello and Batina
// (2016), so the scalar multiplication (a Montgomery ladder with masked
// swaps) runs in time independent of the scalar. Both curves share the
// code, generic over the number of limbs.
// =============================================================================

import "std/os/random" as random;
import "std/sync" as sync;
import "subtle.ax" as subtle;

pub error EcError { InvalidPoint, InvalidLength, InvalidKey, RandomFailed }

// -----------------------------------------------------------------------------
// Montgomery arithmetic modulo an odd number of N 64-bit limbs
// -----------------------------------------------------------------------------

/// N little-endian 64-bit limbs.
struct U[const N: usize] {
    w: [N]u64,
}

fn u_zero[const N: usize]() U.[N] {
    return U.[N].{ w: [0; N] };
}

fn u_from_be[const N: usize](b: []u8) U.[N] {
    let mut r = u_zero.[N]();
    for i in @as(usize, 0)..N {
        let o = ((8 * N) - 8) - (8 * i);
        r.w[i] = (
            ((((((@as(u64, b[o]) << 56) | (@as(u64, b[o + 1]) << 48)) | (@as(u64, b[o + 2]) << 40)) | (@as(u64,
                                                                                                           b[o + 3]) <<
                                                                                                       32)) | (
                                                                                                           @as(u64,
                                                                                                               b[o +
                                                                                                                 4]) <<
                                                                                                           24)) |
             (@as(u64, b[o + 5]) << 16)) | (@as(u64, b[o + 6]) << 8)) | @as(u64, b[o + 7]);
    }
    return r;
}

fn u_to_be[const N: usize](a: *U.[N], out: []mut u8) void {
    for i in @as(usize, 0)..N {
        let o = ((8 * N) - 8) - (8 * i);
        let v = a.w[i];
        out[o] = @truncate(u8, v >> 56);
        out[o + 1] = @truncate(u8, v >> 48);
        out[o + 2] = @truncate(u8, v >> 40);
        out[o + 3] = @truncate(u8, v >> 32);
        out[o + 4] = @truncate(u8, v >> 24);
        out[o + 5] = @truncate(u8, v >> 16);
        out[o + 6] = @truncate(u8, v >> 8);
        out[o + 7] = @truncate(u8, v);
    }
}

/// a - b and the borrow (1 if a < b).
fn u_sub[const N: usize](a: *U.[N], b: *U.[N], out: *mut U.[N]) u64 {
    let mut borrow: u8 = 0;
    for i in @as(usize, 0)..N {
        let d = @sub_borrow(a.w[i], b.w[i], borrow);
        out.w[i] = d.value;
        borrow = d.borrow;
    }
    return @as(u64, borrow);
}

fn u_add[const N: usize](a: *U.[N], b: *U.[N], out: *mut U.[N]) u64 {
    let mut c: u8 = 0;
    for i in @as(usize, 0)..N {
        let s = @add_carry(a.w[i], b.w[i], c);
        out.w[i] = s.value;
        c = s.carry;
    }
    return @as(u64, c);
}

/// a if mask is all ones, else b.
fn u_select[const N: usize](mask: u64, a: *U.[N], b: *U.[N]) U.[N] {
    let mut r = u_zero.[N]();
    for i in @as(usize, 0)..N {
        r.w[i] = (a.w[i] & mask) | (b.w[i] & ~mask);
    }
    return r;
}

fn u_is_zero[const N: usize](a: *U.[N]) bool {
    let mut x: u64 = 0;
    for v in a.w {
        x = x | v;
    }
    return x == 0;
}

fn u_bit[const N: usize](a: *U.[N], i: usize) u64 {
    return (a.w[i / 64] >> @as(u64, i % 64)) & 1;
}

/// Low 64 bits of x * y + acc + carry.*, storing the high 64 bits in carry.*.
fn mul_add(x: u64, y: u64, acc: u64, carry: *mut u64) u64 {
    let p = @mul_wide(x, y);
    let s1 = @add_carry(p.lo, acc, 0);
    let s2 = @add_carry(s1.value, carry.*, 0);
    carry.* = (p.hi + @as(u64, s1.carry)) + @as(u64, s2.carry);
    return s2.value;
}

/// Arithmetic modulo m in Montgomery form (R = 2^(64N)).
struct Mod[const N: usize] {
    m: U.[N],
    minv: u64,   // -m^-1 mod 2^64
    r2: U.[N],   // R^2 mod m
    one: U.[N],  // R mod m: 1 in Montgomery form

    /// (a + b) mod m for a, b < m.
    fn add(self: *Self, a: *U.[N], b: *U.[N]) U.[N] {
        let mut s = u_zero.[N]();
        let carry = u_add(a, b, &mut s);
        let mut d = u_zero.[N]();
        let borrow = u_sub(&s, &self.m, &mut d);
        // keep s only if it was already below m (a borrow and no carry)
        let keep = borrow & (carry ^ 1);
        return u_select(0 -% keep, &s, &d);
    }

    /// (a - b) mod m for a, b < m.
    fn sub(self: *Self, a: *U.[N], b: *U.[N]) U.[N] {
        let mut d = u_zero.[N]();
        let borrow = u_sub(a, b, &mut d);
        let mut e = u_zero.[N]();
        _ = u_add(&d, &self.m, &mut e);
        return u_select(0 -% borrow, &e, &d);
    }

    /// a * b * R^-1 mod m (CIOS), in constant time.
    fn mul(self: *Self, a: *U.[N], b: *U.[N]) U.[N] {
        let mut t: [8]u64 = [0; 8];  // N + 2 limbs used
        for i in @as(usize, 0)..N {
            let mut c: u64 = 0;
            let bi = b.w[i];
            for j in @as(usize, 0)..N {
                t[j] = mul_add(a.w[j], bi, t[j], &mut c);
            }
            let top1 = @add_carry(t[N], c, 0);
            t[N] = top1.value;
            t[N + 1] = @as(u64, top1.carry);
            let u = t[0] *% self.minv;
            c = 0;
            _ = mul_add(u, self.m.w[0], t[0], &mut c);
            for j in @as(usize, 1)..N {
                t[j - 1] = mul_add(u, self.m.w[j], t[j], &mut c);
            }
            let top2 = @add_carry(t[N], c, 0);
            t[N - 1] = top2.value;
            t[N] = t[N + 1] + @as(u64, top2.carry);
        }
        let mut r = u_zero.[N]();
        for j in @as(usize, 0)..N {
            r.w[j] = t[j];
        }
        let mut d = u_zero.[N]();
        let borrow = u_sub(&r, &self.m, &mut d);
        // r < m exactly when the subtraction borrowed and t[N] is zero
        let keep = borrow & ((~t[N] & (t[N] -% 1)) >> 63);
        return u_select(0 -% keep, &r, &d);
    }

    fn to_mont(self: *Self, a: *U.[N]) U.[N] {
        return self.mul(a, &self.r2);
    }

    fn from_mont(self: *Self, a: *U.[N]) U.[N] {
        let mut one = u_zero.[N]();
        one.w[0] = 1;
        return self.mul(a, &one);
    }

    /// a^(m-2): the inverse for a prime m (0 for 0). The exponent is public,
    /// so the sequence of operations is fixed.
    fn inv(self: *Self, a: *U.[N]) U.[N] {
        let mut e = u_zero.[N]();
        let mut two = u_zero.[N]();
        two.w[0] = 2;
        _ = u_sub(&self.m, &two, &mut e);
        let mut r = self.one;
        let mut i: usize = 64 * N;
        while i > 0 {
            i -= 1;
            r = self.mul(&r, &r);
            let bit = u_bit(&e, i);
            let t = self.mul(&r, a);
            r = u_select(0 -% bit, &t, &r);
        }
        return r;
    }

    /// Reduces a value below 2^(64N) into [0, m) (one conditional
    /// subtraction suffices for the NIST moduli, all above 2^(64N - 1)).
    fn reduce(self: *Self, a: *U.[N]) U.[N] {
        let mut d = u_zero.[N]();
        let borrow = u_sub(a, &self.m, &mut d);
        return u_select(0 -% borrow, a, &d);
    }
}

fn mod_init[const N: usize](m: U.[N]) Mod.[N] {
    let mut x: u64 = 1;
    for i in @as(u32, 0)..6 {
        x = x *% (2 -% (m.w[0] *% x));
    }
    let mut md = Mod.[N].{ m: m, minv: 0 -% x, r2: u_zero.[N](), one: u_zero.[N]() };
    // R mod m and R^2 mod m by doubling 1 (the modulus is public)
    let mut v = u_zero.[N]();
    v.w[0] = 1;
    for i in @as(usize, 0)..(128 * N) {
        v = md.add(&v, &v);
        if i == ((64 * N) - 1) {
            md.one = v;
        }
    }
    md.r2 = v;
    return md;
}

// -----------------------------------------------------------------------------
// The curve y^2 = x^3 - 3x + b over GF(p)
// -----------------------------------------------------------------------------

/// Projective coordinates (X : Y : Z), in Montgomery form; the point at
/// infinity is (0 : 1 : 0).
struct Point[const N: usize] {
    x: U.[N],
    y: U.[N],
    z: U.[N],
}

struct Curve[const N: usize] {
    fp: Mod.[N],
    fn_: Mod.[N],
    b: U.[N],  // Montgomery form
    g: Point.[N],
}

