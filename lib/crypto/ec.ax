fn make_curve[const N: usize](p: []u8, n: []u8, b: []u8, gx: []u8, gy: []u8) Curve.[N] {
    let fp = mod_init(u_from_be.[N](p));
    let fnn = mod_init(u_from_be.[N](n));
    let bb = u_from_be.[N](b);
    let x = u_from_be.[N](gx);
    let y = u_from_be.[N](gy);
    return Curve.[N].{
        fp: fp, fn_: fnn, b: fp.to_mont(&bb), g: Point.[N].{ x: fp.to_mont(&x), y: fp.to_mont(&y), z: fp.one } };
}

// The curves, computed on first use (racing threads store the same values).
let mut CURVE256: Curve.[4] = Curve.[4].{
    fp: Mod.[4].{ m: U.[4].{ w: [0; 4] }, minv: 0, r2: U.[4].{ w: [0; 4] }, one: U.[4].{ w: [0; 4] } },
    fn_: Mod.[4].{ m: U.[4].{ w: [0; 4] }, minv: 0, r2: U.[4].{ w: [0; 4] }, one: U.[4].{ w: [0; 4] } },
    b: U.[4].{ w: [0; 4] },
    g: Point.[4].{ x: U.[4].{ w: [0; 4] }, y: U.[4].{ w: [0; 4] }, z: U.[4].{ w: [0; 4] } },
};
let mut CURVE384: Curve.[6] = Curve.[6].{
    fp: Mod.[6].{ m: U.[6].{ w: [0; 6] }, minv: 0, r2: U.[6].{ w: [0; 6] }, one: U.[6].{ w: [0; 6] } },
    fn_: Mod.[6].{ m: U.[6].{ w: [0; 6] }, minv: 0, r2: U.[6].{ w: [0; 6] }, one: U.[6].{ w: [0; 6] } },
    b: U.[6].{ w: [0; 6] },
    g: Point.[6].{ x: U.[6].{ w: [0; 6] }, y: U.[6].{ w: [0; 6] }, z: U.[6].{ w: [0; 6] } },
};
let mut ONCE256: sync.Once = sync.ONCE_INIT;
let mut ONCE384: sync.Once = sync.ONCE_INIT;

fn build256(_u: u8) void {
    CURVE256 = make_curve.[4](P256_P[..], P256_N[..], P256_B[..], P256_GX[..], P256_GY[..]);
}

fn build384(_u: u8) void {
    CURVE384 = make_curve.[6](P384_P[..], P384_N[..], P384_B[..], P384_GX[..], P384_GY[..]);
}

fn p256() *Curve.[4] {
    ONCE256.call(build256, @as(u8, 0));
    return &CURVE256;
}

fn p384() *Curve.[6] {
    ONCE384.call(build384, @as(u8, 0));
    return &CURVE384;
}

fn infinity[const N: usize](c: *Curve.[N]) Point.[N] {
    return Point.[N].{ x: u_zero.[N](), y: c.fp.one, z: u_zero.[N]() };
}

/// P + Q by Algorithm 4 of Renes, Costello and Batina: complete (right for
/// doubling and the point at infinity too) on curves with a = -3.
fn point_add[const N: usize](c: *Curve.[N], p: *Point.[N], q: *Point.[N]) Point.[N] {
    let f = &c.fp;
    let mut t0 = f.mul(&p.x, &q.x);
    let mut t1 = f.mul(&p.y, &q.y);
    let mut t2 = f.mul(&p.z, &q.z);
    let mut t3 = f.add(&p.x, &p.y);
    let mut t4 = f.add(&q.x, &q.y);
    t3 = f.mul(&t3, &t4);
    t4 = f.add(&t0, &t1);
    t3 = f.sub(&t3, &t4);
    t4 = f.add(&p.y, &p.z);
    let mut x3 = f.add(&q.y, &q.z);
    t4 = f.mul(&t4, &x3);
    x3 = f.add(&t1, &t2);
    t4 = f.sub(&t4, &x3);
    x3 = f.add(&p.x, &p.z);
    let mut y3 = f.add(&q.x, &q.z);
    x3 = f.mul(&x3, &y3);
    y3 = f.add(&t0, &t2);
    y3 = f.sub(&x3, &y3);
    let mut z3 = f.mul(&c.b, &t2);
    x3 = f.sub(&y3, &z3);
    z3 = f.add(&x3, &x3);
    x3 = f.add(&x3, &z3);
    z3 = f.sub(&t1, &x3);
    x3 = f.add(&t1, &x3);
    y3 = f.mul(&c.b, &y3);
    t1 = f.add(&t2, &t2);
    t2 = f.add(&t1, &t2);
    y3 = f.sub(&y3, &t2);
    y3 = f.sub(&y3, &t0);
    t1 = f.add(&y3, &y3);
    y3 = f.add(&t1, &y3);
    t1 = f.add(&t0, &t0);
    t0 = f.add(&t1, &t0);
    t0 = f.sub(&t0, &t2);
    t1 = f.mul(&t4, &y3);
    t2 = f.mul(&t0, &y3);
    y3 = f.mul(&x3, &z3);
    y3 = f.add(&y3, &t2);
    x3 = f.mul(&t3, &x3);
    x3 = f.sub(&x3, &t1);
    z3 = f.mul(&t4, &z3);
    t1 = f.mul(&t3, &t0);
    z3 = f.add(&z3, &t1);
    return Point.[N].{ x: x3, y: y3, z: z3 };
}

fn point_cswap[const N: usize](a: *mut Point.[N], b: *mut Point.[N], bit: u64) void {
    let mask = 0 -% bit;
    let na = Point.[N].{ x: u_select(mask, &b.x, &a.x), y: u_select(mask, &b.y, &a.y), z: u_select(mask, &b.z, &a.z) };
    let nb = Point.[N].{ x: u_select(mask, &a.x, &b.x), y: u_select(mask, &a.y, &b.y), z: u_select(mask, &a.z, &b.z) };
    a.* = na;
    b.* = nb;
}

/// [k]P for a scalar (not in Montgomery form), as a constant-time ladder.
fn scalar_mul[const N: usize](c: *Curve.[N], k: *U.[N], p: *Point.[N]) Point.[N] {
    let mut r0 = infinity(c);
    let mut r1 = p.*;
    let mut i: usize = 64 * N;
    while i > 0 {
        i -= 1;
        let bit = u_bit(k, i);
        point_cswap(&mut r0, &mut r1, bit);
        r1 = point_add(c, &r0, &r1);
        r0 = point_add(c, &r0, &r0);
        point_cswap(&mut r0, &mut r1, bit);
    }
    return r0;
}

/// The affine x and y (normal form), or InvalidPoint for infinity.
fn to_affine[const N: usize](c: *Curve.[N], p: *Point.[N], x: *mut U.[N], y: *mut U.[N]) EcError!void {
    if u_is_zero(&p.z) {
        return error.InvalidPoint;
    }
    let zi = c.fp.inv(&p.z);
    let ax = c.fp.mul(&p.x, &zi);
    let ay = c.fp.mul(&p.y, &zi);
    x.* = c.fp.from_mont(&ax);
    y.* = c.fp.from_mont(&ay);
}

/// Parses an uncompressed point (04 || X || Y) and checks it is on the curve.
fn decode_point[const N: usize](c: *Curve.[N], b: []u8) EcError!Point.[N] {
    if (b.len != (1 + (16 * N))) or (b[0] != 4) {
        return error.InvalidPoint;
    }
    let x = u_from_be.[N](b[1..1 + (8 * N)]);
    let y = u_from_be.[N](b[1 + (8 * N)..1 + (16 * N)]);
    let mut t = u_zero.[N]();
    if (u_sub(&x, &c.fp.m, &mut t) == 0) or (u_sub(&y, &c.fp.m, &mut t) == 0) {
        return error.InvalidPoint;  // not below p
    }
    let f = &c.fp;
    let mx = f.to_mont(&x);
    let my = f.to_mont(&y);
    // y^2 == x^3 - 3x + b
    let y2 = f.mul(&my, &my);
    let x2 = f.mul(&mx, &mx);
    let x3 = f.mul(&x2, &mx);
    let tx = f.add(&mx, &mx);
    let three_x = f.add(&tx, &mx);
    let r0 = f.sub(&x3, &three_x);
    let rhs = f.add(&r0, &c.b);
    let mut d = u_zero.[N]();
    _ = u_sub(&y2, &rhs, &mut d);
    if not u_is_zero(&d) {
        return error.InvalidPoint;
    }
    return Point.[N].{ x: mx, y: my, z: f.one };
}

fn encode_point[const N: usize](c: *Curve.[N], p: *Point.[N], out: []mut u8) EcError!void {
    let mut x = u_zero.[N]();
    let mut y = u_zero.[N]();
    to_affine(c, p, &mut x, &mut y)!;
    out[0] = 4;
    u_to_be(&x, out[1..1 + (8 * N)]);
    u_to_be(&y, out[1 + (8 * N)..1 + (16 * N)]);
}

// -----------------------------------------------------------------------------
// Keys, ECDH and ECDSA (generic over the curve)
// -----------------------------------------------------------------------------

/// Whether 0 < k < n.
fn scalar_ok[const N: usize](c: *Curve.[N], k: *U.[N]) bool {
    let mut t = u_zero.[N]();
    return (not u_is_zero(k)) and (u_sub(k, &c.fn_.m, &mut t) == 1);
}

/// A random scalar in [1, n).
fn random_scalar[const N: usize](c: *Curve.[N]) EcError!U.[N] {
    loop {
        let mut b: [48]u8 = [0; 48];
        random.fill(b[..8 * N]) catch return error.RandomFailed;
        let k = u_from_be.[N](b[..8 * N]);
        if scalar_ok(c, &k) {
            return k;
        }
    }
}

fn scalar_from_bytes[const N: usize](c: *Curve.[N], b: []u8) EcError!U.[N] {
    if b.len != (8 * N) {
        return error.InvalidLength;
    }
    let d = u_from_be.[N](b);
    if not scalar_ok(c, &d) {
        return error.InvalidKey;
    }
    return d;
}

fn public_of[const N: usize](c: *Curve.[N], d: *U.[N], out: []mut u8) void {
    let q = scalar_mul(c, d, &c.g);
    encode_point(c, &q, out[..1 + (16 * N)]) catch @trap();
}

fn ecdh_of[const N: usize](c: *Curve.[N], d: *U.[N], public: []u8, out: []mut u8) EcError!void {
    let q = decode_point(c, public)!;
    let s = scalar_mul(c, d, &q);
    let mut x = u_zero.[N]();
    let mut y = u_zero.[N]();
    to_affine(c, &s, &mut x, &mut y)!;
    u_to_be(&x, out[..8 * N]);
}

/// The digest as a scalar: its leftmost 64N bits, reduced mod n.
fn digest_scalar[const N: usize](c: *Curve.[N], digest: []u8) U.[N] {
    let mut b: [48]u8 = [0; 48];
    let len = 8 * N;
    if digest.len >= len {
        @mem_copy(b[..len], digest[..len]);
    } else {
        @mem_copy(b[len - digest.len..len], digest);
    }
    let e = u_from_be.[N](b[..len]);
    return c.fn_.reduce(&e);
}

fn sign_with[const N: usize](c: *Curve.[N], d: *U.[N], digest: []u8, sig: []mut u8) EcError!void {
    let n = &c.fn_;
    let e = digest_scalar(c, digest);
    loop {
        let k = random_scalar(c)!;
        let kg = scalar_mul(c, &k, &c.g);
        let mut x = u_zero.[N]();
        let mut y = u_zero.[N]();
        to_affine(c, &kg, &mut x, &mut y)!;
        let r = n.reduce(&x);
        if u_is_zero(&r) {
            continue;
        }
        // s = k^-1 (e + r d) mod n, in Montgomery form throughout
        let km = n.to_mont(&k);
        let kinv = n.inv(&km);
        let rm = n.to_mont(&r);
        let dm = n.to_mont(d);
        let em = n.to_mont(&e);
        let rd = n.mul(&rm, &dm);
        let sum = n.add(&em, &rd);
        let sm = n.mul(&kinv, &sum);
        let s = n.from_mont(&sm);
        if u_is_zero(&s) {
            continue;
        }
        u_to_be(&r, sig[0..8 * N]);
        u_to_be(&s, sig[8 * N..16 * N]);
        return;
    }
}

fn verify_with[const N: usize](c: *Curve.[N], public: []u8, digest: []u8, sig: []u8) bool {
    if sig.len != (16 * N) {
        return false;
    }
    let q = decode_point(c, public) catch return false;
    let r = u_from_be.[N](sig[0..8 * N]);
    let s = u_from_be.[N](sig[8 * N..16 * N]);
    if (not scalar_ok(c, &r)) or not scalar_ok(c, &s) {
        return false;
    }
    let n = &c.fn_;
    let e = digest_scalar(c, digest);
    let sm = n.to_mont(&s);
    let w = n.inv(&sm);
    let em = n.to_mont(&e);
    let rm = n.to_mont(&r);
    let u1m = n.mul(&em, &w);
    let u2m = n.mul(&rm, &w);
    let u1 = n.from_mont(&u1m);
    let u2 = n.from_mont(&u2m);
    let a = scalar_mul(c, &u1, &c.g);
    let b = scalar_mul(c, &u2, &q);
    let sum = point_add(c, &a, &b);
    let mut x = u_zero.[N]();
    let mut y = u_zero.[N]();
    to_affine(c, &sum, &mut x, &mut y) catch return false;
    let xr = n.reduce(&x);
    let mut rb: [48]u8 = [0; 48];
    let mut xb: [48]u8 = [0; 48];
    u_to_be(&r, rb[..8 * N]);
    u_to_be(&xr, xb[..8 * N]);
    return subtle.equal(rb[..8 * N], xb[..8 * N]);
}

// -----------------------------------------------------------------------------
// P-256 and P-384
// -----------------------------------------------------------------------------

/// A P-256 private key. Public keys are uncompressed points (65 bytes:
/// 04 || X || Y), shared secrets 32 bytes, signatures r || s (64 bytes).
pub struct P256 {
    d: U.[4],

    /// The key with this 32-byte big-endian scalar (1 <= d < n).
    pub fn from_bytes(b: []u8) EcError!P256 {
        return P256.{ d: scalar_from_bytes(p256(), b)! };
    }

    pub fn generate() EcError!P256 {
        return P256.{ d: random_scalar(p256())! };
    }

    pub fn to_bytes(self: *P256, out: []mut u8) void {
        u_to_be(&self.d, out[..32]);
    }

    pub fn public_key(self: *P256, out: []mut u8) void {
        public_of(p256(), &self.d, out);
    }

    /// The x coordinate of d * Q for an uncompressed public key Q.
    pub fn ecdh(self: *P256, public: []u8, out: []mut u8) EcError!void {
        ecdh_of(p256(), &self.d, public, out)!;
    }

    /// Signs a digest (its leftmost 256 bits) with a fresh random nonce.
    pub fn sign(self: *P256, digest: []u8, sig: []mut u8) EcError!void {
        sign_with(p256(), &self.d, digest, sig)!;
    }
}

/// A P-384 private key: public keys are 97 bytes, shared secrets 48 bytes,
/// signatures 96 bytes.
pub struct P384 {
    d: U.[6],

    pub fn from_bytes(b: []u8) EcError!P384 {
        return P384.{ d: scalar_from_bytes(p384(), b)! };
    }

    pub fn generate() EcError!P384 {
        return P384.{ d: random_scalar(p384())! };
    }

    pub fn to_bytes(self: *P384, out: []mut u8) void {
        u_to_be(&self.d, out[..48]);
    }

    pub fn public_key(self: *P384, out: []mut u8) void {
        public_of(p384(), &self.d, out);
    }

    pub fn ecdh(self: *P384, public: []u8, out: []mut u8) EcError!void {
        ecdh_of(p384(), &self.d, public, out)!;
    }

    pub fn sign(self: *P384, digest: []u8, sig: []mut u8) EcError!void {
        sign_with(p384(), &self.d, digest, sig)!;
    }
}

/// Whether sig (r || s, 64 bytes) is a P-256 signature of digest by the
/// uncompressed public key.
pub fn verify_p256(public: []u8, digest: []u8, sig: []u8) bool {
    return verify_with(p256(), public, digest, sig);
}

/// The same for P-384 (97-byte keys, 96-byte signatures).
pub fn verify_p384(public: []u8, digest: []u8, sig: []u8) bool {
    return verify_with(p384(), public, digest, sig);
}

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn unhex(s: []u8, out: []mut u8) []mut u8 {
    for i in 0..s.len / 2 {
        out[i] = (hexv(s[2 * i]) << 4) | hexv(s[(2 * i) + 1]);
    }
    return out[..s.len / 2];
}

fn hexv(c: u8) u8 {
    if c <= '9' {
        return c - '0';
    }
    return ((c | 0x20) - 'a') + 10;
}

test "public key and ecdh (RFC 5903 8.1)" {
    let mut b: [65]u8 = [0; 65];
    let mut w: [65]u8 = [0; 65];
    let i = P256.from_bytes(unhex("c88f01f510d9ac3f70a292daa2316de544e9aab8afe84049c62a9c57862d1433", b[..]))!;
    let mut gi: [65]u8 = [0; 65];
    i.public_key(gi[..]);
    @expect_eq(gi[..],
               unhex("04dad0b65394221cf9b051e1feca5787d098dfe637fc90b9ef945d0c37725811805271a0461cdb8252d61f1c456fa3e59ab1f45b33accf5f58389e0577b8990bb3",
                     w[..]));
    let r = P256.from_bytes(unhex("c6ef9c5d78ae012a011164acb397ce2088685d8f06bf9be0b283ab46476bee53", b[..]))!;
    let mut gr: [65]u8 = [0; 65];
    r.public_key(gr[..]);
    let mut s1: [32]u8 = [0; 32];
    let mut s2: [32]u8 = [0; 32];
    i.ecdh(gr[..], s1[..])!;
    r.ecdh(gi[..], s2[..])!;
    @expect_eq(s1[..], unhex("d6840f6b42f6edafd13116e0e12565202fef8e9ece7dce03812464d04b9442de", w[..]));
    @expect_eq(s2[..], s1[..]);
    gr[40] ^= 1;
    i.ecdh(gr[..], s1[..]) catch |e| {
        @expect_eq(e, error.InvalidPoint);
        return;
    };
    @trap();
}

test "ecdsa" {
    let k = P256.generate()!;
    let mut pubk: [65]u8 = [0; 65];
    k.public_key(pubk[..]);
    let digest: [32]u8 = [0x42; 32];
    let mut sig: [64]u8 = [0; 64];
    k.sign(digest[..], sig[..])!;
    @expect(verify_p256(pubk[..], digest[..], sig[..]));
    let other: [32]u8 = [0x43; 32];
    @expect(not verify_p256(pubk[..], other[..], sig[..]));
    // RFC 6979 A.2.5 (P-256, SHA-256, "sample"): a fixed signature verifies
    let mut pb: [65]u8 = [0; 65];
    let mut db: [32]u8 = [0; 32];
    let mut sb: [64]u8 = [0; 64];
    let q =
        unhex("0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299",
              pb[..]);
    let d = unhex("af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf", db[..]);
    let s =
        unhex("efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8",
              sb[..]);
    @expect(verify_p256(q, d, s));
    s[10] ^= 1;
    @expect(not verify_p256(q, d, s));
}

test "p384 public key and ecdh (RFC 5903 8.2)" {
    let mut b: [97]u8 = [0; 97];
    let mut w: [97]u8 = [0; 97];
    let i_bytes =
        unhex("099f3c7034d4a2c699884d73a375a67f7624ef7c6b3c0f160647b67414dce655e35b538041e649ee3faef896783ab194",
              b[..]);
    let i = P384.from_bytes(i_bytes)!;
    let mut rt: [48]u8 = [0; 48];
    i.to_bytes(rt[..]);
    @expect_eq(rt[..], i_bytes);
    let mut gi: [97]u8 = [0; 97];
    i.public_key(gi[..]);
    @expect_eq(gi[..],
               unhex("04667842d7d180ac2cde6f74f37551f55755c7645c20ef73e31634fe72b4c55ee6de3ac808acb4bdb4c88732aee95f41aa9482ed1fc0eeb9cafc4984625ccfc23f65032149e0e144ada024181535a0f38eeb9fcff3c2c947dae69b4c634573a81c",
                     w[..]));
    let r =
        P384.from_bytes(unhex("41cb0779b4bdb85d47846725fbec3c9430fab46cc8dc5060855cc9bda0aa2942e0308312916b8ed2960e4bd55a7448fc",
                              b[..]))!;
    let mut gr: [97]u8 = [0; 97];
    r.public_key(gr[..]);
    @expect_eq(gr[..],
               unhex("04e558dbef53eecde3d3fccfc1aea08a89a987475d12fd950d83cfa41732bc509d0d1ac43a0336def96fda41d0774a3571dcfbec7aacf3196472169e838430367f66eebe3c6e70c416dd5f0c68759dd1fff83fa40142209dff5eaad96db9e6386c",
                     w[..]));
    let mut s1: [48]u8 = [0; 48];
    let mut s2: [48]u8 = [0; 48];
    i.ecdh(gr[..], s1[..])!;
    r.ecdh(gi[..], s2[..])!;
    @expect_eq(s1[..],
               unhex("11187331c279962d93d604243fd592cb9d0a926f422e47187521287e7156c5c4d603135569b9e9d09cf5d4a270f59746",
                     w[..]));
    @expect_eq(s2[..], s1[..]);
    gr[50] ^= 1;
    i.ecdh(gr[..], s1[..]) catch |e| {
        @expect_eq(e, error.InvalidPoint);
        return;
    };
    @trap();
}

fn expect_p384_err(b: []u8, want: EcError) void {
    _ = P384.from_bytes(b) catch |e| {
        @expect_eq(e, want);
        return;
    };
    @trap();
}

fn u_eq[const N: usize](a: *U.[N], b: *U.[N]) bool {
    for i in @as(usize, 0)..N {
        if a.w[i] != b.w[i] {
            return false;
        }
    }
    return true;
}

test "p384 ecdsa and key validation" {
    let k = P384.generate()!;
    let mut pubk: [97]u8 = [0; 97];
    k.public_key(pubk[..]);
    let digest: [48]u8 = [0x42; 48];
    let mut sig: [96]u8 = [0; 96];
    k.sign(digest[..], sig[..])!;
    @expect(verify_p384(pubk[..], digest[..], sig[..]));
    let other: [48]u8 = [0x43; 48];
    @expect(not verify_p384(pubk[..], other[..], sig[..]));
    // Fixed P-384 public key and signature verification
    let mut pb: [97]u8 = [0; 97];
    let mut db: [48]u8 = [0; 48];
    let mut sb: [96]u8 = [0; 96];
    let q =
        unhex("04667842d7d180ac2cde6f74f37551f55755c7645c20ef73e31634fe72b4c55ee6de3ac808acb4bdb4c88732aee95f41aa9482ed1fc0eeb9cafc4984625ccfc23f65032149e0e144ada024181535a0f38eeb9fcff3c2c947dae69b4c634573a81c",
              pb[..]);
    let d = unhex("9a9083505bc92276aec4be312696ef7bf3bf603f4bbd381196a029f340585312313bca4a9b5b890efee42c77b1ee25fe",
                  db[..]);
    let s =
        unhex("5c86a47f40f6edcd68ca1e3d112522dc8ac91ce4c10b743ad3e8e2538f30be488d50037a01b940ddc6df8d7465ae16265be8b67f6245ae5f0941bdeeca74ffa1788dda0ceeb08ea5e253db8587c743412c391fa1f2d76e3da001bbf2f32b252e",
              sb[..]);
    @expect(verify_p384(q, d, s));
    s[20] ^= 1;
    @expect(not verify_p384(q, d, s));
    @expect(not verify_p384(q, d, s[..95]));
    // Scalar bounds: zero and group order n are rejected; wrong length is rejected
    let zero: [48]u8 = [0; 48];
    expect_p384_err(zero[..], error.InvalidKey);
    expect_p384_err(P384_N[..], error.InvalidKey);
    expect_p384_err(zero[..47], error.InvalidLength);
}

test "u64 limb and montgomery arithmetic" {
    // Full-limb carry and borrow propagation
    let max4 = U.[4].{ w: [0xFFFF_FFFF_FFFF_FFFF; 4] };
    let mut one4 = u_zero.[4]();
    one4.w[0] = 1;
    let mut sum4 = u_zero.[4]();
    @expect_eq(u_add(&max4, &one4, &mut sum4), 1);
    @expect(u_is_zero(&sum4));
    let mut diff4 = u_zero.[4]();
    @expect_eq(u_sub(&sum4, &one4, &mut diff4), 1);
    @expect(u_eq(&diff4, &max4));
    @expect_eq(u_sub(&max4, &max4, &mut diff4), 0);
    @expect(u_is_zero(&diff4));

    // P-256 Montgomery CIOS edge cases (including t[4] == 1 final subtraction)
    let fp256 = &p256().fp;
    let mut ba: [32]u8 = [0; 32];
    let mut bb: [32]u8 = [0; 32];
    let mut be: [32]u8 = [0; 32];
    let a256 = u_from_be.[4](unhex("ffffffff00000001000000000000000000000000fffffffffffffffffffffffd", ba[..]));
    let b256 = u_from_be.[4](unhex("ffffffff00000001000000000000000000000000fffffffffffffffffffffff7", bb[..]));
    let exp256 = u_from_be.[4](unhex("ffffffef00000030ffffffd00000002000000010ffffffe0000000300000000f", be[..]));
    let got256 = fp256.mul(&a256, &b256);
    @expect(u_eq(&got256, &exp256));

    // (m - 1) + (m - 1) mod m == m - 2, (0 - 1) mod m == m - 1, (m - 1)^2 == 1 in Mont
    let pm1_256 = fp256.sub(&u_zero.[4](), &one4);
    let m1m = fp256.to_mont(&pm1_256);
    let sq256 = fp256.from_mont(&fp256.mul(&m1m, &m1m));
    @expect(u_eq(&sq256, &one4));
    let two_m256 = fp256.add(&pm1_256, &pm1_256);
    let mut two4 = u_zero.[4]();
    two4.w[0] = 2;
    let want_two256 = fp256.sub(&u_zero.[4](), &two4);
    @expect(u_eq(&two_m256, &want_two256));
    let red256 = fp256.reduce(&max4);
    let mut want_red256 = u_zero.[4]();
    _ = u_sub(&max4, &fp256.m, &mut want_red256);
    @expect(u_eq(&red256, &want_red256));

    // P-384 Montgomery CIOS edge cases (including t[6] == 1 final subtraction) and inv
    let fp384 = &p384().fp;
    let mut one6 = u_zero.[6]();
    one6.w[0] = 1;
    let pm1_384 = fp384.sub(&u_zero.[6](), &one6);
    let mut be6: [48]u8 = [0; 48];
    let exp384 =
        u_from_be.[6](unhex("00000014000000140000000c00000002fffffffcfffffffafffffffbfffffffdffffffebffffffd8ffffffe100000006",
                            be6[..]));
    let got384 = fp384.mul(&pm1_384, &pm1_384);
    @expect(u_eq(&got384, &exp384));
    let m1m_384 = fp384.to_mont(&pm1_384);
    let sq384 = fp384.from_mont(&fp384.mul(&m1m_384, &m1m_384));
    @expect(u_eq(&sq384, &one6));
    let mut sample6 = u_zero.[6]();
    sample6.w[0] = 0x1234_5678_9abc_def0;
    sample6.w[5] = 0x0fed_cba9_8765_4321;
    let sm6 = fp384.to_mont(&sample6);
    let inv6 = fp384.inv(&sm6);
    let prod384 = fp384.from_mont(&fp384.mul(&sm6, &inv6));
    @expect(u_eq(&prod384, &one6));
    @expect(u_is_zero(&fp384.inv(&u_zero.[6]())));
}
