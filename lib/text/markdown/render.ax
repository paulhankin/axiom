// =============================================================================
// lib/text/markdown/render.ax - HTML and plain-text rendering, part of lib/text/markdown.
// =============================================================================

import "../math.ax" as tmath;
import "std/io" as io;
import "std/str" as strs;

// -----------------------------------------------------------------------------
// HTML
// -----------------------------------------------------------------------------

fn escape_html(out: *mut strs.String, s: []u8) MarkdownError!void {
    let mut run: usize = 0;
    for i in 0..s.len {
        let c = s[i];
        if (c == '&') or (c == '<') or (c == '>') or (c == '"') {
            out.push_str(s[run..i])!;
            if c == '&' {
                out.push_str("&amp;")!;
            } else if c == '<' {
                out.push_str("&lt;")!;
            } else if c == '>' {
                out.push_str("&gt;")!;
            } else {
                out.push_str("&quot;")!;
            }
            run = i + 1;
        }
    }
    out.push_str(s[run..])!;
}

fn href_safe(c: u8) bool {
    return strs.is_alnum(c) or ((c != 0) and (strs.index_of_byte("-_.+!*(),%#@?=;:/$~", c) ?? 99) != 99);
}

/// A URL for an attribute: percent-encodes what is not allowed, escapes & and '.
fn escape_href(out: *mut strs.String, s: []u8) MarkdownError!void {
    let hex = "0123456789ABCDEF";
    for c in s {
        if href_safe(c) {
            out.push(c)!;
        } else if c == '&' {
            out.push_str("&amp;")!;
        } else if c == '\'' {
            out.push_str("&#x27;")!;
        } else {
            out.push('%')!;
            out.push(hex[@as(usize, c >> 4)])!;
            out.push(hex[@as(usize, c & 15)])!;
        }
    }
}

/// javascript:, vbscript:, file: and data: (except for images).
pub fn is_dangerous_url(url: []u8) bool {
    if has_prefix_ci(url, 0, "data:") {
        return not (has_prefix_ci(url, 5, "image/png") or has_prefix_ci(url, 5, "image/gif") or
                    has_prefix_ci(url, 5, "image/jpeg") or has_prefix_ci(url, 5, "image/webp"));
    }
    return has_prefix_ci(url, 0, "javascript:") or has_prefix_ci(url, 0, "vbscript:") or has_prefix_ci(url, 0, "file:");
}

pub let FILTERED_TAGS: [9][]u8 = ["title", "textarea", "style", "xmp", "iframe", "noembed", "noframes", "script",
                                  "plaintext"];

/// Raw HTML, with the GFM tag filter: "<script" becomes "&lt;script".
fn raw_html(out: *mut strs.String, s: []u8, filter: bool) MarkdownError!void {
    if not filter {
        out.push_str(s)!;
        return;
    }
    let mut run: usize = 0;
    let mut i: usize = 0;
    while i < s.len {
        if s[i] == '<' {
            let mut j = i + 1;
            if at(s, j) == '/' {
                j += 1;
            }
            let ns = j;
            while strs.is_alpha(at(s, j)) {
                j += 1;
            }
            let name = s[ns..j];
            let after = at(s, j);
            if (name.len > 0) and tag_in(name, FILTERED_TAGS[..]) and
               (is_tag_space(after) or (after == '>') or (after == 0) or ((after == '/') and (at(s, j + 1) == '>'))) {
                out.push_str(s[run..i])!;
                out.push_str("&lt;")!;
                run = i + 1;
            }
        }
        i += 1;
    }
    out.push_str(s[run..])!;
}

fn cr(out: *mut strs.String) MarkdownError!void {
    if (out.len() > 0) and (out.bytes()[out.len() - 1] != '\n') {
        out.push('\n')!;
    }
}

fn put_uint(out: *mut strs.String, v: u32) MarkdownError!void {
    let mut tmp: [10]u8 = [0; 10];
    let mut n: usize = 0;
    let mut x = v;
    while true {
        tmp[n] = @truncate(u8, x % 10) + '0';
        n += 1;
        x /= 10;
        if x == 0 {
            break;
        }
    }
    while n > 0 {
        n -= 1;
        out.push(tmp[n])!;
    }
}

fn in_tight_list(doc: *Document, id: u32) bool {
    let parent = doc.node(id).parent;
    if parent == NONE {
        return false;
    }
    let gp = doc.node(parent).parent;
    if gp == NONE {
        return false;
    }
    let g = doc.node(gp);
    return (g.kind == Kind.LIST) and g.tight;
}

/// The plain text of a node's descendants (for alt text).
fn plain_into(doc: *Document, id: u32, out: *mut strs.String) MarkdownError!void {
    let mut w = Walker.{ doc: doc, id: id, entering: true, started: true };
    // walk the subtree of id only
    let n0 = doc.node(id);
    if n0.first == NONE {
        return;
    }
    w.id = n0.first;
    w.entering = true;
    while true {
        let n = doc.node(w.id);
        if w.entering {
            if is_plain_text(n.kind) {
                out.push_str(doc.text(w.id))!;
            } else if (n.kind == Kind.SOFT_BREAK) or (n.kind == Kind.HARD_BREAK) {
                out.push(' ')!;
            }
        }
        // next, without leaving the subtree
        if w.entering and has_exit(n.kind) and (n.first != NONE) {
            w.id = n.first;
            continue;
        }
        let mut cur = w.id;
        while (cur != id) and (doc.node(cur).next == NONE) {
            cur = doc.node(cur).parent;
        }
        if cur == id {
            return;
        }
        w.id = doc.node(cur).next;
        w.entering = true;
    }
}

// Whether a code block's info string starts with the word "math".
fn is_math_info(info: []u8) bool {
    return strs.starts_with(info, "math") and ((info.len == 4) or is_ascii_space(info[4]));
}

// TeX as MathML onto out; false (and nothing written) if it does not parse.
fn math_html(opts: *Options, out: *mut strs.String, tex: []u8, display: tmath.Display) !bool {
    if opts.math_html.render(opts.math_html.ctx, tex, display == tmath.Display.BLOCK, out)! {
        return true;
    }
    let mut f = tmath.parse(tex) catch |e| {
        if e == error.OutOfMemory {
            return e;
        }
        return false;
    };
    defer f.deinit();
    f.write_mathml(out.writer(), display)!;
    return true;
}

// Renders into out; with `stream`, whatever piles up there goes on to sink
// every 4 KB or so (all but the last byte, which cr() looks at).
fn render_html(doc: *Document, out: *mut strs.String, sink: io.Writer, stream: bool) !void {
    let mut w = doc.walk();
    // inside an image: children render as plain text (alt), up to this node
    let mut plain: u32 = NONE;
    while w.advance() {
        if stream and (out.len() >= 4096) {
            let last = out.bytes()[out.len() - 1];
            sink.write_all(out.bytes()[..out.len() - 1])!;
            out.clear();
            out.push(last)!;
        }
        let id = w.id;
        let n = doc.node(id);
        let entering = w.entering;
        if plain != NONE {
            if (id == plain) and not entering {
                plain = NONE;
                // falls through to close the image
            } else {
                if entering {
                    if is_plain_text(n.kind) {
                        escape_html(out, doc.text(id))!;
                    } else if (n.kind == Kind.SOFT_BREAK) or (n.kind == Kind.HARD_BREAK) {
                        out.push(' ')!;
                    }
                }
                continue;
            }
        }
        if n.kind == Kind.IMAGE {
            if render_image(doc, out, id, &n, entering)! {
                plain = id;
            }
        } else if n.kind.is_inline() {
            render_inline(doc, out, id, &n, entering)!;
        } else {
            render_block(doc, out, id, &n, entering)!;
        }
    }
}

// Whether a node's text is what it reads as in plain text (alt text and the like).
fn is_plain_text(k: Kind) bool {
    return (k == Kind.TEXT) or (k == Kind.CODE) or (k == Kind.HTML_INLINE) or (k == Kind.MATH) or
           (k == Kind.DISPLAY_MATH);
}

// A block node's tags (on entering or leaving it), or a code or HTML block.
inline fn render_block(doc: *Document, out: *mut strs.String, id: u32, n: *Node, entering: bool) !void {
    let opts = &doc.opts;
    let k = n.kind;
    if k == Kind.DOCUMENT {
        // nothing
    } else if k == Kind.BLOCK_QUOTE {
        cr(out)!;
        if entering {
            out.push_str("<blockquote>\n")!;
        } else {
            out.push_str("</blockquote>\n")!;
        }
    } else if k == Kind.LIST {
        cr(out)!;
        if entering {
            if n.ordered {
                if n.start != 1 {
                    out.push_str("<ol start=\"")!;
                    put_uint(out, n.start)!;
                    out.push_str("\">\n")!;
                } else {
                    out.push_str("<ol>\n")!;
                }
            } else {
                out.push_str("<ul>\n")!;
            }
        } else if n.ordered {
            out.push_str("</ol>\n")!;
        } else {
            out.push_str("</ul>\n")!;
        }
    } else if k == Kind.ITEM {
        if entering {
            cr(out)!;
            out.push_str("<li>")!;
            if n.task == Task.OPEN {
                out.push_str("<input disabled=\"\" type=\"checkbox\"> ")!;
            } else if n.task == Task.DONE {
                out.push_str("<input checked=\"\" disabled=\"\" type=\"checkbox\"> ")!;
            }
        } else {
            out.push_str("</li>\n")!;
        }
    } else if k == Kind.HEADING {
        if entering {
            cr(out)!;
            out.push_str("<h")!;
            out.push('0' + n.level)!;
            out.push('>')!;
        } else {
            out.push_str("</h")!;
            out.push('0' + n.level)!;
            out.push_str(">\n")!;
        }
    } else if (k == Kind.CODE_BLOCK) and opts.math and is_math_info(doc.info(id)) and
              math_html(opts, out, strs.trim(doc.text(id)), tmath.Display.BLOCK)! {
        cr(out)!;
    } else if k == Kind.CODE_BLOCK {
        cr(out)!;
        let info = doc.info(id);
        if info.len == 0 {
            out.push_str("<pre><code>")!;
        } else {
            let mut e: usize = 0;
            while (e < info.len) and not is_ascii_space(info[e]) {
                e += 1;
            }
            out.push_str("<pre><code class=\"language-")!;
            escape_html(out, info[..e])!;
            out.push_str("\">")!;
        }
        escape_html(out, doc.text(id))!;
        out.push_str("</code></pre>\n")!;
    } else if k == Kind.HTML_BLOCK {
        cr(out)!;
        put_raw_html(out, opts, doc.text(id))!;
        cr(out)!;
    } else if k == Kind.THEMATIC_BREAK {
        cr(out)!;
        out.push_str("<hr />\n")!;
    } else if k == Kind.PARAGRAPH {
        if not in_tight_list(doc, id) {
            if entering {
                cr(out)!;
                out.push_str("<p>")!;
            } else {
                out.push_str("</p>\n")!;
            }
        }
    } else if k == Kind.TABLE {
        if entering {
            cr(out)!;
            out.push_str("<table>\n")!;
        } else {
            // close the body if there was one
            let last = doc.node(n.last);
            if not last.header {
                out.push_str("</tbody>\n")!;
            }
            out.push_str("</table>\n")!;
        }
    } else if k == Kind.TABLE_ROW {
        if entering {
            if n.header {
                out.push_str("<thead>\n")!;
            } else if (n.prev != NONE) and doc.node(n.prev).header {
                out.push_str("<tbody>\n")!;
            }
            out.push_str("<tr>\n")!;
        } else {
            out.push_str("</tr>\n")!;
            if n.header {
                out.push_str("</thead>\n")!;
            }
        }
    } else if k == Kind.TABLE_CELL {
        let header = doc.node(n.parent).header;
        if entering {
            if header {
                out.push_str("<th")!;
            } else {
                out.push_str("<td")!;
            }
            if n.align == Align.LEFT {
                out.push_str(" align=\"left\"")!;
            } else if n.align == Align.CENTER {
                out.push_str(" align=\"center\"")!;
            } else if n.align == Align.RIGHT {
                out.push_str(" align=\"right\"")!;
            }
            out.push('>')!;
        } else if header {
            out.push_str("</th>\n")!;
        } else {
            out.push_str("</td>\n")!;
        }
    }
}

// An inline node's tags (on entering or leaving it), or its text.
inline fn render_inline(doc: *Document, out: *mut strs.String, id: u32, n: *Node, entering: bool) !void {
    let opts = &doc.opts;
    let k = n.kind;
    if k == Kind.TEXT {
        escape_html(out, doc.text(id))!;
    } else if k == Kind.SOFT_BREAK {
        if opts.hard_breaks {
            out.push_str("<br />\n")!;
        } else {
            out.push('\n')!;
        }
    } else if k == Kind.HARD_BREAK {
        out.push_str("<br />\n")!;
    } else if k == Kind.MATH {
        if not math_html(opts, out, doc.text(id), tmath.Display.INLINE)! {
            out.push('$')!;
            escape_html(out, doc.text(id))!;
            out.push('$')!;
        }
    } else if k == Kind.DISPLAY_MATH {
        if not math_html(opts, out, doc.text(id), tmath.Display.BLOCK)! {
            out.push_str("$$")!;
            escape_html(out, doc.text(id))!;
            out.push_str("$$")!;
        }
    } else if k == Kind.CODE {
        out.push_str("<code>")!;
        escape_html(out, doc.text(id))!;
        out.push_str("</code>")!;
    } else if k == Kind.HTML_INLINE {
        put_raw_html(out, opts, doc.text(id))!;
    } else if k == Kind.EMPH {
        if entering {
            out.push_str("<em>")!;
        } else {
            out.push_str("</em>")!;
        }
    } else if k == Kind.STRONG {
        if entering {
            out.push_str("<strong>")!;
        } else {
            out.push_str("</strong>")!;
        }
    } else if k == Kind.STRIKETHROUGH {
        if entering {
            out.push_str("<del>")!;
        } else {
            out.push_str("</del>")!;
        }
    } else if k == Kind.LINK {
        if entering {
            out.push_str("<a href=\"")!;
            put_url(out, opts, doc.url(id))!;
            out.push('"')!;
            put_title(out, doc.title(id))!;
            out.push('>')!;
        } else {
            out.push_str("</a>")!;
        }
    }
}

// An image: entering one, its start up to the alt text, which its children
// (if it has any) give: returns whether they do. Then, on leaving it (or
// at once without children), the rest.
fn render_image(doc: *Document, out: *mut strs.String, id: u32, n: *Node, entering: bool) !bool {
    if entering {
        out.push_str("<img src=\"")!;
        put_url(out, &doc.opts, doc.url(id))!;
        out.push_str("\" alt=\"")!;
        if n.first != NONE {
            return true;
        }
    }
    if entering or (n.first != NONE) {
        out.push('"')!;
        put_title(out, doc.title(id))!;
        out.push_str(" />")!;
    }
    return false;
}

// A link's or image's destination (left out if it is dangerous, unless raw
// HTML is allowed).
fn put_url(out: *mut strs.String, opts: *Options, url: []u8) !void {
    if opts.unsafe_html or not is_dangerous_url(url) {
        escape_href(out, url)!;
    }
}

// A title attribute, unless the title is empty.
fn put_title(out: *mut strs.String, t: []u8) !void {
    if t.len > 0 {
        out.push_str(" title=\"")!;
        escape_html(out, t)!;
        out.push('"')!;
    }
}

// Raw HTML, if it is allowed, else a comment saying it was left out.
fn put_raw_html(out: *mut strs.String, opts: *Options, html: []u8) !void {
    if opts.unsafe_html {
        raw_html(out, html, opts.tagfilter)!;
    } else {
        out.push_str("<!-- raw HTML omitted -->")!;
    }
}
