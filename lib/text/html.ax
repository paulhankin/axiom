// =============================================================================
// lib/text/html.ax - HTML: the WHATWG parsing algorithm, a tree, CSS selectors
// and serialization.
//
//     let mut doc = html.parse(text)!;
//     defer doc.deinit();
//     let links = doc.query_all("article a[href]")!;      // CSS selectors
//     defer mem.free(links);
//     for id in links { let href = doc.attr(id, "href")!; ... }
//     let title = doc.title()!;                           // (the caller frees
//     let text = doc.text_content(doc.body())!;           //  these three)
//     let out = doc.to_html(0)!;                          // serialization
//
//     let mut frag = html.parse_fragment("<td>x", "tr", html.Options.default())!;
//
//     let mut t = html.Tokenizer.init(text)!;             // just the tokens
//     defer t.deinit();
//     while let .some(tok) = t.next()! { ... }
//
// parse() implements the HTML Living Standard's parser: the tokenizer with
// every character reference, and tree construction with all its insertion
// modes, the adoption agency algorithm for misnested formatting, foster
// parenting out of tables, templates, the relaxed <select> content model,
// and SVG and MathML (foreign content). Every input yields a document, as
// in browsers; there are no parse errors to fail on. The trees match what
// browsers build: the parser passes all 1,792 tree construction tests of
// html5lib-tests (with scripting both off and on) and all 7,028 of its
// tokenizer tests (lib/text/html/testdata, from cmd/axiom/internal/tests/tools/gen_html_tests.py).
// Scripts never run; Options.scripting only changes how <noscript> parses.
// Processing instructions are read as bogus comments, as browsers have
// always done.
//
// Nodes are numbered: node 0 is the document, and each node has parent,
// first/last child and previous/next sibling links (NONE when absent);
// template contents hang off `contents`. Input to parse() is UTF-8
// (invalid bytes become U+FFFD; a byte-order mark is dropped);
// parse_bytes() sniffs UTF-16 byte-order marks and windows-1252.
//
// Untrusted input: nothing recurses, and the work per token is bounded, so
// time grows linearly with the input whatever its shape. That takes two
// departures from the standard, which only very unusual documents notice:
// elements nested more than MAX_DEPTH deep are not opened (later content
// goes to their parent), and at most MAX_ACTIVE_FORMATTING formatting
// elements stay active at once.
// =============================================================================

import "internal/html/tags.ax" as tags;
import "std/collections/vec" as vec;
import "std/diag" as diag;
import "std/mem" as mem;
import "std/str" as strs;

import part "html/dom.ax";
import part "html/selector.ax";
import part "html/tests.ax";
import part "html/tokenizer.ax";
import part "html/tokenizer_markup.ax";
import part "html/tokenizer_states.ax";
import part "html/tree_builder.ax";
import part "html/tree_in_body.ax";
import part "html/tree_modes.ax";
import part "html/tree_tables.ax";

pub error HtmlError { OutOfMemory, NotFound, SyntaxError, Done, Empty, IoError, InvalidUtf8 }

pub const NONE: u32 = 0xffffffff;

const NONE_USIZE: usize = 0xffffffff;

/// Elements nested deeper than this are not opened: later content goes to
/// their parent.
pub const MAX_DEPTH: usize = 512;

/// Node kinds.
pub enum Kind: u8 {
    DOCUMENT,
    DOCTYPE,
    ELEMENT,
    TEXT,
    COMMENT,
    FRAGMENT,  // template contents; the result of parse_fragment
}

/// Element namespaces.
pub enum Namespace: u8 {
    HTML,
    SVG,
    MATHML,

    /// The namespace's URI (NAMESPACE_URIS).
    pub fn uri(self: Namespace) []u8 {
        return NAMESPACE_URIS[@as(usize, @int_from_enum(self))];
    }
}

/// Attribute namespaces (from SVG and MathML: xlink:href, xml:lang, xmlns).
pub enum AttrNamespace: u8 {
    NONE,
    XLINK,
    XML,
    XMLNS,
}

/// Document modes.
pub enum QuirksMode: u8 {
    NO_QUIRKS,
    QUIRKS,
    LIMITED_QUIRKS,
}

pub let NAMESPACE_URIS: [3][]u8 = ["http://www.w3.org/1999/xhtml", "http://www.w3.org/2000/svg",
                                   "http://www.w3.org/1998/Math/MathML"];

pub struct Options {
    pub scripting: bool,  // parse as if scripts ran: <noscript> holds raw text

    pub fn default() Options {
        return Options.{ scripting: false };
    }
}

fn is_ws(c: u8) bool {
    return (c == ' ') or (c == '\t') or (c == '\n') or (c == 12) or (c == '\r');
}

fn is_alpha(c: i32) bool {
    return ((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z'));
}

fn is_alnum(c: i32) bool {
    return is_alpha(c) or ((c >= '0') and (c <= '9'));
}

fn lower(c: i32) u8 {
    if (c >= 'A') and (c <= 'Z') {
        return @truncate(u8, c + 32);
    }
    return @truncate(u8, c);
}

// -----------------------------------------------------------------------------
// Input
// -----------------------------------------------------------------------------

/// The input stream: s with CR and CRLF made LF and invalid UTF-8 replaced
/// by U+FFFD. Returns s itself when it needs no change, else a copy (also
/// stored in owned) that the caller frees.
fn preprocess(s: []u8, owned: *mut []mut u8) infer![]u8 {
    let mut clean = true;
    let mut i: usize = 0;
    while i < s.len {
        let c = s[i];
        if c == '\r' {
            clean = false;
            break;
        }
        if c < 0x80 {
            i += 1;
            continue;
        }
        let r = strs.decode_rune(s[i..]);
        if (r.value == strs.REPLACEMENT) and (r.len == 1) {
            clean = false;
            break;
        }
        i += r.len;
    }
    if clean {
        return s;
    }
    let mut out = strs.String.init();
    normalize(s, i, &mut out) catch |e| {
        out.deinit();
        return e;
    };
    let b = out.take()!;
    owned.* = b;
    return b;
}

fn normalize(s: []u8, i0: usize, out: *mut strs.String) infer!void {
    let mut i = i0;
    out.reserve(s.len + 16)!;
    out.push_str(s[..i])!;
    while i < s.len {
        let c = s[i];
        if c == '\r' {
            out.push('\n')!;
            i += 1;
            if (i < s.len) and (s[i] == '\n') {
                i += 1;
            }
            continue;
        }
        if c < 0x80 {
            out.push(c)!;
            i += 1;
            continue;
        }
        let r = strs.decode_rune(s[i..]);
        if (r.value == strs.REPLACEMENT) and (r.len == 1) {
            out.push_str("\xef\xbf\xbd")!;
        } else {
            out.push_str(s[i..i + r.len])!;
        }
        i += r.len;
    }
}

// Replacements for numeric references to C1 controls (0x80-0x9f), or 0.
let C1: [32]u32 = [
    0x20ac,
    0,
    0x201a,
    0x0192,
    0x201e,
    0x2026,
    0x2020,
    0x2021,
    0x02c6,
    0x2030,
    0x0160,
    0x2039,
    0x0152,
    0,
    0x017d,
    0,
    0,
    0x2018,
    0x2019,
    0x201c,
    0x201d,
    0x2022,
    0x2013,
    0x2014,
    0x02dc,
    0x2122,
    0x0161,
    0x203a,
    0x0153,
    0,
    0x017e,
    0x0178,
];

// -----------------------------------------------------------------------------
// Parsing
// -----------------------------------------------------------------------------

fn new_parser(doc: *mut Document, tz: *mut Tokenizer, opts: Options) Parser {
    return Parser.{ doc: doc, tz: tz, stack: vec.Vec.[u32].init(), open: [0; 124], afe: vec.Vec.[u32].init(),
                    tmodes: vec.Vec.[Mode].init(), mode: Mode.INITIAL, orig: Mode.INITIAL, head: NONE, form: NONE,
                    context: NONE, frameset_ok: true, foster: false, scripting: opts.scripting, skip_lf: false,
                    text_elem: NONE, pend: strs.String.init(), pend_text: false, sbuf: strs.String.init(),
                    abuf: vec.Vec.[Attr].init() };
}

fn run_parser(p: *mut Parser) infer!void {
    loop {
        let a = p.adjusted_current();
        p.tz.cdata_ok = (a != NONE) and (p.nd(a).ns != Namespace.HTML);
        let mut t = p.tz.next_token()!;
        if p.skip_lf {
            p.skip_lf = false;
            if (t.kind == TokenKind.CHARS) and (t.data[0] == '\n') {
                t.data = t.data[1..];
                if t.data.len == 0 {
                    continue;
                }
            }
        }
        dispatch(p, t)!;
        if t.kind == TokenKind.EOF {
            return;
        }
    }
}

/// Parses an HTML document (UTF-8).
pub fn parse(text: []u8) HtmlError!Document {
    return parse_with(text, Options.default());
}

pub fn parse_with(text: []u8, opts: Options) HtmlError!Document {
    let mut doc = Document.init();
    build(&mut doc, text, opts, "", Namespace.HTML) catch |e| {
        doc.deinit();
        return e;
    };
    return doc;
}

/// Parses an HTML document (UTF-8), clearing `info` on success and filling
/// `info` with byte offset, 1-based line and column, and detail on failure.
pub fn parse_diag(text: []u8, info: *mut diag.ErrorInfo) HtmlError!Document {
    return parse_with_diag(text, Options.default(), info);
}

/// Like parse_diag, with explicit Options.
pub fn parse_with_diag(text: []u8, opts: Options, info: *mut diag.ErrorInfo) HtmlError!Document {
    info.* = diag.ErrorInfo.init();
    let mut doc = Document.init();
    build_diag(&mut doc, text, opts, "", Namespace.HTML, info) catch |e| {
        doc.deinit();
        return e;
    };
    return doc;
}

/// Parses a fragment as the children of an element named context (for
/// example "div" or "tr"; "svg path" and "math mi" name SVG and MathML
/// elements), as innerHTML does. Node 0 of the result is a FRAGMENT that
/// holds the parsed nodes.
pub fn parse_fragment(text: []u8, context: []u8, opts: Options) HtmlError!Document {
    let mut doc = Document.init();
    let mut ns = Namespace.HTML;
    let mut name = context;
    if strs.starts_with(context, "svg ") {
        ns = Namespace.SVG;
        name = context[4..];
    } else if strs.starts_with(context, "math ") {
        ns = Namespace.MATHML;
        name = context[5..];
    }
    build(&mut doc, text, opts, name, ns) catch |e| {
        doc.deinit();
        return e;
    };
    return doc;
}

/// Parses bytes in an unknown encoding: a byte-order mark (UTF-8, UTF-16LE
/// or UTF-16BE) decides, else a <meta charset> (or http-equiv
/// Content-Type) in the first 1024 bytes naming windows-1252 or one of its
/// aliases (ISO-8859-1, ASCII, ...), else UTF-8 if the bytes are valid
/// UTF-8, else windows-1252.
pub fn parse_bytes(bytes: []u8, opts: Options) HtmlError!Document {
    let mut s = strs.String.init();
    defer s.deinit();
    let text = decode(bytes, &mut s)!;
    return parse_with(text, opts);
}

/// Decodes bytes as parse_bytes does, into out if they are not already
/// UTF-8: returns the UTF-8 text.
pub fn decode(b: []u8, out: *mut strs.String) HtmlError![]u8 {
    if (b.len >= 2) and (((b[0] == 0xff) and (b[1] == 0xfe)) or ((b[0] == 0xfe) and (b[1] == 0xff))) {
        let le = b[0] == 0xff;
        let mut i: usize = 2;
        while (i + 1) < b.len {
            let mut u = (@as(u32, b[i + 1]) << 8) | @as(u32, b[i]);
            if not le {
                u = (@as(u32, b[i]) << 8) | @as(u32, b[i + 1]);
            }
            i += 2;
            if (u >= 0xd800) and (u < 0xdc00) and ((i + 1) < b.len) {
                let mut v = (@as(u32, b[i + 1]) << 8) | @as(u32, b[i]);
                if not le {
                    v = (@as(u32, b[i]) << 8) | @as(u32, b[i + 1]);
                }
                if (v >= 0xdc00) and (v < 0xe000) {
                    u = 0x10000 + ((u - 0xd800) << 10) + (v - 0xdc00);
                    i += 2;
                }
            }
            out.push_rune(u)!;  // (lone surrogates become U+FFFD)
        }
        if i < b.len {
            out.push_rune(0xfffd)!;
        }
        return out.bytes();
    }
    if (b.len >= 3) and (b[0] == 0xef) and (b[1] == 0xbb) and (b[2] == 0xbf) {
        return b;
    }
    let cs = prescan_charset(b[..@min(b.len, 1024)]);
    let mut latin = is_windows_1252(cs);
    if (cs.len == 0) and not strs.valid_utf8(b) {
        latin = true;
    }
    if not latin {
        return b;
    }
    out.reserve(b.len + (b.len / 4))!;
    for c in b {
        if c < 0x80 {
            out.push(c)!;
        } else if (c < 0xa0) and (C1[@as(usize, c - 0x80)] != 0) {
            out.push_rune(C1[@as(usize, c - 0x80)])!;
        } else {
            out.push_rune(@as(u32, c))!;
        }
    }
    return out.bytes();
}

fn is_windows_1252(cs: []u8) bool {
    for x in ["windows-1252", "cp1252", "x-cp1252", "iso-8859-1", "iso8859-1", "iso_8859-1", "latin1", "l1", "us-ascii",
              "ascii", "iso-ir-100", "csisolatin1", "cp819", "ibm819", "ansi_x3.4-1968"] {
        if strs.eq_ignore_case(cs, x) {
            return true;
        }
    }
    return false;
}

// The charset a <meta> near the start declares, or "".
fn prescan_charset(b: []u8) []u8 {
    let mut i: usize = 0;
    while i < b.len {
        let lt = strs.index_of_from(b, "<", i) ?? return "";
        i = lt + 1;
        if (i + 4) > b.len {
            return "";
        }
        if strs.starts_with(b[i..], "!--") {
            i = (strs.index_of_from(b, "-->", i) ?? return "") + 3;
            continue;
        }
        if not (strs.eq_ignore_case(b[i..i + 4], "meta") and ((i + 4) < b.len) and
                (is_ws(b[i + 4]) or (b[i + 4] == '/'))) {
            continue;
        }
        let end = strs.index_of_from(b, ">", i) ?? b.len;
        let tag = b[i + 4..end];
        let cs = charset_in(tag);
        if cs.len > 0 {
            return cs;
        }
        i = end;
    }
    return "";
}

// charset=... in a meta tag's text (as an attribute or inside content=).
fn charset_in(tag: []u8) []u8 {
    let mut i: usize = 0;
    while (i + 8) <= tag.len {
        if strs.eq_ignore_case(tag[i..i + 7], "charset") {
            let mut j = i + 7;
            while (j < tag.len) and is_ws(tag[j]) {
                j += 1;
            }
            if (j < tag.len) and (tag[j] == '=') {
                j += 1;
                while (j < tag.len) and (is_ws(tag[j]) or (tag[j] == '"') or (tag[j] == '\'')) {
                    j += 1;
                }
                let st = j;
                while (j < tag.len) and not is_ws(tag[j]) and (tag[j] != '"') and (tag[j] != '\'') and
                      (tag[j] != ';') and (tag[j] != '/') {
                    j += 1;
                }
                return tag[st..j];
            }
        }
        i += 1;
    }
    return "";
}

fn diag_detail_for(e: HtmlError) []u8 {
    match e {
        error.OutOfMemory => { return "out of memory"; }
        error.InvalidUtf8 => { return "invalid UTF-8"; }
        error.SyntaxError => { return "syntax error"; }
        error.NotFound    => { return "not found"; }
        error.Empty       => { return "empty input"; }
        error.Done        => { return "done"; }
        error.IoError     => { return "I/O error"; }
    }
}

fn record_diag_at(text: []u8, pos: usize, e: HtmlError, info: *mut diag.ErrorInfo) void {
    let off = @min(pos, text.len);
    let mut line: u32 = 1;
    let mut col: u32 = 1;
    for i in @as(usize, 0)..off {
        if text[i] == '\n' {
            line += 1;
            col = 1;
        } else {
            col += 1;
        }
    }
    info.* = diag.ErrorInfo.at(off, line, col, diag_detail_for(e));
}

fn build(doc: *mut Document, text0: []u8, opts: Options, context: []u8, cns: Namespace) infer!void {
    let mut info = diag.ErrorInfo.init();
    build_diag(doc, text0, opts, context, cns, &mut info)!;
}

fn build_diag(doc: *mut Document, text0: []u8, opts: Options, context: []u8, cns: Namespace,
              info: *mut diag.ErrorInfo) infer!void {
    _ = doc.new_node(Kind.DOCUMENT) catch |e| {
        record_diag_at(text0, 0, e, info);
        return e;
    };
    let mut text = text0;
    let mut bom: usize = 0;
    if (text.len >= 3) and (text[0] == 0xef) and (text[1] == 0xbb) and (text[2] == 0xbf) {
        text = text[3..];  // a byte-order mark
        bom = 3;
    }
    let mut tz = Tokenizer.init(text) catch |e| {
        record_diag_at(text0, bom, e, info);
        return e;
    };
    defer tz.deinit();
    build_with_tokenizer(doc, &mut tz, opts, context, cns) catch |e| {
        record_diag_at(tz.s, tz.i, e, info);
        if tz.owned.len == 0 {
            info.offset += bom;
        }
        return e;
    };
}

fn build_with_tokenizer(doc: *mut Document, tz: *mut Tokenizer, opts: Options, context: []u8,
                        cns: Namespace) infer!void {
    let mut p = new_parser(doc, tz, opts);
    defer p.deinit();
    let mut root = NONE;
    if context.len > 0 {
        let lname = strs.to_lower(context)!;
        defer mem.free(lname);
        let mut ct = fake_token(tags.T_HTML);
        ct.name = lname;
        ct.tag = tags.tag_of(lname);
        p.context = p.create_element(&mut ct, cns)!;
        if cns == Namespace.HTML {
            let g = ct.tag;
            if (g == tags.T_TITLE) or (g == tags.T_TEXTAREA) {
                tz.state = State.RCDATA;
            } else if (g == tags.T_STYLE) or (g == tags.T_XMP) or (g == tags.T_IFRAME) or (g == tags.T_NOEMBED) or
                      (g == tags.T_NOFRAMES) or ((g == tags.T_NOSCRIPT) and opts.scripting) {
                tz.state = State.RAWTEXT;
            } else if g == tags.T_SCRIPT {
                tz.state = State.SCRIPT;
            } else if g == tags.T_PLAINTEXT {
                tz.state = State.PLAINTEXT;
            }
        }
        let mut h = fake_token(tags.T_HTML);
        root = p.create_element(&mut h, Namespace.HTML)!;
        doc.append_child(0, root);
        _ = p.push(root)!;
        if p.is(p.context, tags.T_TEMPLATE) {
            p.tmodes.push(Mode.IN_TEMPLATE)!;
        }
        p.reset_mode();
        if p.is(p.context, tags.T_FORM) {
            p.form = p.context;
        }
    }
    run_parser(&mut p)!;
    if root != NONE {
        // the fragment: the root element's children, under node 0
        doc.remove(root);
        doc.nm(0).kind = Kind.FRAGMENT;
        loop {
            let c = doc.node(root).first;
            if c == NONE {
                break;
            }
            doc.remove(c);
            doc.append_child(0, c);
        }
    }
    doc.finish_text();
    for id in p.stack.items() {
        doc.nm(id).flags &= ~FL_OPEN;
    }
    for id in p.afe.items() {
        if id != MARKER {
            doc.nm(id).flags &= ~FL_AFE;
        }
    }
    fill_selectedcontent(doc)!;
}

// A <select>'s <selectedcontent> shows a copy of the selected <option>'s
// content (the last option marked selected, else the first).
fn fill_selectedcontent(doc: *mut Document) infer!void {
    let n = @truncate(u32, doc.nodes.len());
    for sel in @as(u32, 0)..n {
        let s = doc.node(sel);
        if (s.kind != Kind.ELEMENT) or (s.ns != Namespace.HTML) or (s.tag != tags.T_SELECT) or
           has_attr_named(s, "multiple") {
            continue;
        }
        let mut sc = NONE;
        let mut first = NONE;
        let mut chosen = NONE;
        let mut w = doc.walk(sel);
        _ = w.advance();
        while w.advance() {
            if not w.entering {
                continue;
            }
            let e = doc.node(w.id);
            if (e.kind != Kind.ELEMENT) or (e.ns != Namespace.HTML) {
                continue;
            }
            if (e.tag == tags.T_SELECTEDCONTENT) and (sc == NONE) {
                sc = w.id;
            } else if e.tag == tags.T_OPTION {
                if first == NONE {
                    first = w.id;
                }
                if has_attr_named(e, "selected") {
                    chosen = w.id;
                }
            }
        }
        if chosen == NONE {
            chosen = first;
        }
        if (sc == NONE) or (chosen == NONE) or (doc.node(sc).first != NONE) {
            continue;
        }
        let mut c = doc.node(chosen).first;
        while c != NONE {
            let k = doc.clone_tree(c)!;
            doc.append_child(sc, k);
            c = doc.node(c).next;
        }
    }
}

fn has_attr_named(n: *Node, name: []u8) bool {
    for a in n.attrs {
        if (a.ns == AttrNamespace.NONE) and strs.eq(a.name, name) {
            return true;
        }
    }
    return false;
}
