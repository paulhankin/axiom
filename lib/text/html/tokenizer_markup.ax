// =============================================================================
// lib/text/html/tokenizer_markup.ax - HTML tokenizer comment, CDATA and DOCTYPE states, part of lib/text/html.
// =============================================================================

// -----------------------------------------------------------------------------
// Tokenizer comment, CDATA and DOCTYPE states
// -----------------------------------------------------------------------------

// The markup declaration open, bogus comment and comment start states.
fn tok_comment_open(tz: *mut Tokenizer, st: State) HtmlError!TokenKind {
    let s = tz.s;
    let n = s.len;
    let c = tz.at();
    if st == State.MARKUP_DECL {
        if tz.lookahead("--") {
            tz.i += 2;
            tz.comment.clear();
            tz.state = State.COMMENT_START;
        } else if tz.lookahead_ci("doctype") {
            tz.i += 7;
            tz.state = State.DOCTYPE;
        } else if tz.lookahead("[CDATA[") {
            tz.i += 7;
            if tz.cdata_ok {
                tz.state = State.CDATA;
            } else {
                tz.err();
                tz.comment.clear();
                tz.comment.push_str("[CDATA[")!;
                tz.state = State.BOGUS_COMMENT;
            }
        } else {
            tz.err();
            tz.comment.clear();
            tz.state = State.BOGUS_COMMENT;
        }
    } else if st == State.BOGUS_COMMENT {
        let b = tz.i;
        let mut i = b;
        while (i < n) and (s[i] != '>') and (s[i] != 0) {
            i += 1;
        }
        tz.comment.push_str(s[b..i])!;
        tz.i = i;
        if i >= n {
            return TokenKind.COMMENT;  // (then EOF)
        }
        tz.i = i + 1;
        if s[i] == '>' {
            tz.state = State.DATA;
            return TokenKind.COMMENT;
        }
        tz.err();
        tz.comment.push_str("\xef\xbf\xbd")!;
    } else if (st == State.COMMENT_START) or (st == State.COMMENT_START_DASH) {
        if c == '-' {
            tz.i += 1;
            if st == State.COMMENT_START {
                tz.state = State.COMMENT_START_DASH;
            } else {
                tz.state = State.COMMENT_END;
            }
        } else if c == '>' {
            tz.err();
            tz.i += 1;
            tz.state = State.DATA;
            return TokenKind.COMMENT;
        } else if (c < 0) and (st == State.COMMENT_START_DASH) {
            tz.err();
            return TokenKind.COMMENT;
        } else {
            if st == State.COMMENT_START_DASH {
                tz.comment.push('-')!;
            }
            tz.state = State.COMMENT;
        }
    }
    return TokenKind.NONE;
}

// The comment state and those after a less-than sign in a comment.
fn tok_comment_body(tz: *mut Tokenizer, st: State) HtmlError!TokenKind {
    let s = tz.s;
    let n = s.len;
    let c = tz.at();
    if st == State.COMMENT {
        let b = tz.i;
        let mut i = b;
        while (i < n) and (s[i] != '<') and (s[i] != '-') and (s[i] != 0) {
            i += 1;
        }
        tz.comment.push_str(s[b..i])!;
        tz.i = i;
        if i >= n {
            tz.err();
            return TokenKind.COMMENT;
        }
        tz.i = i + 1;
        if s[i] == '<' {
            tz.comment.push('<')!;
            tz.state = State.COMMENT_LT;
        } else if s[i] == '-' {
            tz.state = State.COMMENT_END_DASH;
        } else {
            tz.err();
            tz.comment.push_str("\xef\xbf\xbd")!;
        }
    } else if st == State.COMMENT_LT {
        if c == '!' {
            tz.i += 1;
            tz.comment.push('!')!;
            tz.state = State.COMMENT_LT_BANG;
        } else if c == '<' {
            tz.i += 1;
            tz.comment.push('<')!;
        } else {
            tz.state = State.COMMENT;
        }
    } else if st == State.COMMENT_LT_BANG {
        if c == '-' {
            tz.i += 1;
            tz.state = State.COMMENT_LT_BANG_DASH;
        } else {
            tz.state = State.COMMENT;
        }
    } else if st == State.COMMENT_LT_BANG_DASH {
        if c == '-' {
            tz.i += 1;
            tz.state = State.COMMENT_LT_BANG_DASH_DASH;
        } else {
            tz.state = State.COMMENT_END_DASH;
        }
    } else if st == State.COMMENT_LT_BANG_DASH_DASH {
        if (c != '>') and (c >= 0) {
            tz.err();
        }
        tz.state = State.COMMENT_END;
    }
    return TokenKind.NONE;
}

// The comment end dash, comment end and comment end bang states.
fn tok_comment_end(tz: *mut Tokenizer, st: State) HtmlError!TokenKind {
    let c = tz.at();
    if st == State.COMMENT_END_DASH {
        if c == '-' {
            tz.i += 1;
            tz.state = State.COMMENT_END;
        } else if c < 0 {
            tz.err();
            return TokenKind.COMMENT;
        } else {
            tz.comment.push('-')!;
            tz.state = State.COMMENT;
        }
    } else if st == State.COMMENT_END {
        if c == '>' {
            tz.i += 1;
            tz.state = State.DATA;
            return TokenKind.COMMENT;
        } else if c == '!' {
            tz.i += 1;
            tz.state = State.COMMENT_END_BANG;
        } else if c == '-' {
            tz.i += 1;
            tz.comment.push('-')!;
        } else if c < 0 {
            tz.err();
            return TokenKind.COMMENT;
        } else {
            tz.comment.push_str("--")!;
            tz.state = State.COMMENT;
        }
    } else if st == State.COMMENT_END_BANG {
        if c == '-' {
            tz.i += 1;
            tz.comment.push_str("--!")!;
            tz.state = State.COMMENT_END_DASH;
        } else if c == '>' {
            tz.err();
            tz.i += 1;
            tz.state = State.DATA;
            return TokenKind.COMMENT;
        } else if c < 0 {
            tz.err();
            return TokenKind.COMMENT;
        } else {
            tz.comment.push_str("--!")!;
            tz.state = State.COMMENT;
        }
    }
    return TokenKind.NONE;
}

// CDATA sections (in foreign content).
fn tok_cdata(tz: *mut Tokenizer, st: State) HtmlError!TokenKind {
    let s = tz.s;
    let n = s.len;
    let c = tz.at();
    if st == State.CDATA {
        let b = tz.i;
        let mut i = b;
        while (i < n) and (s[i] != ']') {
            i += 1;
        }
        tz.chars.push_str(s[b..i])!;
        tz.i = i;
        if i >= n {
            tz.err();
            return TokenKind.EOF;
        }
        tz.i = i + 1;
        tz.state = State.CDATA_BRACKET;
    } else if st == State.CDATA_BRACKET {
        if c == ']' {
            tz.i += 1;
            tz.state = State.CDATA_END;
        } else {
            tz.chars.push(']')!;
            tz.state = State.CDATA;
        }
    } else if st == State.CDATA_END {
        if c == ']' {
            tz.i += 1;
            tz.chars.push(']')!;
        } else if c == '>' {
            tz.i += 1;
            tz.state = State.DATA;
        } else {
            tz.chars.push_str("]]")!;
            tz.state = State.CDATA;
        }
    }
    return TokenKind.NONE;
}

// The DOCTYPE states up to and after its name.
fn tok_doctype_name(tz: *mut Tokenizer, st: State) HtmlError!TokenKind {
    let c = tz.at();
    if st == State.DOCTYPE {
        tz.new_doctype();
        if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
            tz.i += 1;
        } else if c < 0 {
            tz.err();
            tz.force_quirks = true;
            return TokenKind.DOCTYPE;
        } else if c != '>' {
            tz.err();
        }
        tz.state = State.BEFORE_DOCTYPE_NAME;
    } else if st == State.BEFORE_DOCTYPE_NAME {
        if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
            tz.i += 1;
        } else if c == '>' {
            tz.err();
            tz.i += 1;
            tz.force_quirks = true;
            tz.state = State.DATA;
            return TokenKind.DOCTYPE;
        } else if c < 0 {
            tz.err();
            tz.force_quirks = true;
            return TokenKind.DOCTYPE;
        } else {
            tz.has_name = true;
            tz.state = State.DOCTYPE_NAME;
        }
    } else if st == State.DOCTYPE_NAME {
        if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
            tz.i += 1;
            tz.state = State.AFTER_DOCTYPE_NAME;
        } else if c == '>' {
            tz.i += 1;
            tz.state = State.DATA;
            return TokenKind.DOCTYPE;
        } else if c < 0 {
            tz.err();
            tz.force_quirks = true;
            return TokenKind.DOCTYPE;
        } else {
            tz.i += 1;
            if c == 0 {
                tz.err();
                tz.name.push_str("\xef\xbf\xbd")!;
            } else {
                tz.name.push(lower(c))!;
            }
        }
    } else if st == State.AFTER_DOCTYPE_NAME {
        if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
            tz.i += 1;
        } else if c == '>' {
            tz.i += 1;
            tz.state = State.DATA;
            return TokenKind.DOCTYPE;
        } else if c < 0 {
            tz.err();
            tz.force_quirks = true;
            return TokenKind.DOCTYPE;
        } else if tz.lookahead_ci("public") {
            tz.i += 6;
            tz.state = State.AFTER_DOCTYPE_PUBLIC_KW;
        } else if tz.lookahead_ci("system") {
            tz.i += 6;
            tz.state = State.AFTER_DOCTYPE_SYSTEM_KW;
        } else {
            tz.err();
            tz.force_quirks = true;
            tz.state = State.BOGUS_DOCTYPE;
        }
    }
    return TokenKind.NONE;
}

// The DOCTYPE states after a PUBLIC or SYSTEM keyword and in an identifier.
fn tok_doctype_id(tz: *mut Tokenizer, st: State) HtmlError!TokenKind {
    let c = tz.at();
    if (st == State.AFTER_DOCTYPE_PUBLIC_KW) or (st == State.BEFORE_DOCTYPE_PUBLIC_ID) or
       (st == State.AFTER_DOCTYPE_SYSTEM_KW) or (st == State.BEFORE_DOCTYPE_SYSTEM_ID) {
        let public = (st == State.AFTER_DOCTYPE_PUBLIC_KW) or (st == State.BEFORE_DOCTYPE_PUBLIC_ID);
        let kw = (st == State.AFTER_DOCTYPE_PUBLIC_KW) or (st == State.AFTER_DOCTYPE_SYSTEM_KW);
        if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
            tz.i += 1;
            if kw and public {
                tz.state = State.BEFORE_DOCTYPE_PUBLIC_ID;
            } else if kw {
                tz.state = State.BEFORE_DOCTYPE_SYSTEM_ID;
            }
        } else if (c == '"') or (c == '\'') {
            if kw {
                tz.err();
            }
            tz.i += 1;
            if public {
                tz.has_public = true;
                tz.state = State.DOCTYPE_PUBLIC_ID_DQ;
                if c == '\'' {
                    tz.state = State.DOCTYPE_PUBLIC_ID_SQ;
                }
            } else {
                tz.has_system = true;
                tz.state = State.DOCTYPE_SYSTEM_ID_DQ;
                if c == '\'' {
                    tz.state = State.DOCTYPE_SYSTEM_ID_SQ;
                }
            }
        } else if c == '>' {
            tz.err();
            tz.i += 1;
            tz.force_quirks = true;
            tz.state = State.DATA;
            return TokenKind.DOCTYPE;
        } else if c < 0 {
            tz.err();
            tz.force_quirks = true;
            return TokenKind.DOCTYPE;
        } else {
            tz.err();
            tz.force_quirks = true;
            tz.state = State.BOGUS_DOCTYPE;
        }
    } else if (st == State.DOCTYPE_PUBLIC_ID_DQ) or (st == State.DOCTYPE_PUBLIC_ID_SQ) or
              (st == State.DOCTYPE_SYSTEM_ID_DQ) or (st == State.DOCTYPE_SYSTEM_ID_SQ) {
        let mut q: i32 = '"';
        if (st == State.DOCTYPE_PUBLIC_ID_SQ) or (st == State.DOCTYPE_SYSTEM_ID_SQ) {
            q = '\'';
        }
        let public = (st == State.DOCTYPE_PUBLIC_ID_DQ) or (st == State.DOCTYPE_PUBLIC_ID_SQ);
        if c == q {
            tz.i += 1;
            if public {
                tz.state = State.AFTER_DOCTYPE_PUBLIC_ID;
            } else {
                tz.state = State.AFTER_DOCTYPE_SYSTEM_ID;
            }
        } else if c == '>' {
            tz.err();
            tz.i += 1;
            tz.force_quirks = true;
            tz.state = State.DATA;
            return TokenKind.DOCTYPE;
        } else if c < 0 {
            tz.err();
            tz.force_quirks = true;
            return TokenKind.DOCTYPE;
        } else {
            tz.i += 1;
            let mut out = &mut tz.system_id;
            if public {
                out = &mut tz.public_id;
            }
            if c == 0 {
                tz.err();
                out.push_str("\xef\xbf\xbd")!;
            } else {
                out.push(@truncate(u8, c))!;
            }
        }
    }
    return TokenKind.NONE;
}

// The DOCTYPE states after an identifier, and the bogus DOCTYPE state.
fn tok_doctype_after_id(tz: *mut Tokenizer, st: State) HtmlError!TokenKind {
    let c = tz.at();
    if (st == State.AFTER_DOCTYPE_PUBLIC_ID) or (st == State.BETWEEN_DOCTYPE_IDS) {
        if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
            tz.i += 1;
            tz.state = State.BETWEEN_DOCTYPE_IDS;
        } else if c == '>' {
            tz.i += 1;
            tz.state = State.DATA;
            return TokenKind.DOCTYPE;
        } else if (c == '"') or (c == '\'') {
            if st == State.AFTER_DOCTYPE_PUBLIC_ID {
                tz.err();
            }
            tz.i += 1;
            tz.has_system = true;
            tz.state = State.DOCTYPE_SYSTEM_ID_DQ;
            if c == '\'' {
                tz.state = State.DOCTYPE_SYSTEM_ID_SQ;
            }
        } else if c < 0 {
            tz.err();
            tz.force_quirks = true;
            return TokenKind.DOCTYPE;
        } else {
            tz.err();
            tz.force_quirks = true;
            tz.state = State.BOGUS_DOCTYPE;
        }
    } else if st == State.AFTER_DOCTYPE_SYSTEM_ID {
        if (c == '\t') or (c == '\n') or (c == 12) or (c == ' ') {
            tz.i += 1;
        } else if c == '>' {
            tz.i += 1;
            tz.state = State.DATA;
            return TokenKind.DOCTYPE;
        } else if c < 0 {
            tz.err();
            tz.force_quirks = true;
            return TokenKind.DOCTYPE;
        } else {
            tz.err();
            tz.state = State.BOGUS_DOCTYPE;
        }
    } else if st == State.BOGUS_DOCTYPE {
        if c < 0 {
            return TokenKind.DOCTYPE;
        }
        tz.i += 1;
        if c == '>' {
            tz.state = State.DATA;
            return TokenKind.DOCTYPE;
        }
    }
    return TokenKind.NONE;
}
