// =============================================================================
// lib/text/html/tree_in_body.ax - HTML tree construction in-body mode and adoption agency, part of lib/text/html.
// =============================================================================

import "../internal/html/tags.ax" as tags;
import "std/str" as strs;

// -----------------------------------------------------------------------------
// Tree construction: in body and adoption agency
// -----------------------------------------------------------------------------

let CLOSES_P: [25]u16 = [
    tags.T_ADDRESS,
    tags.T_ARTICLE,
    tags.T_ASIDE,
    tags.T_BLOCKQUOTE,
    tags.T_CENTER,
    tags.T_DETAILS,
    tags.T_DIALOG,
    tags.T_DIR,
    tags.T_DIV,
    tags.T_DL,
    tags.T_FIELDSET,
    tags.T_FIGCAPTION,
    tags.T_FIGURE,
    tags.T_FOOTER,
    tags.T_HEADER,
    tags.T_HGROUP,
    tags.T_MAIN,
    tags.T_MENU,
    tags.T_NAV,
    tags.T_OL,
    tags.T_P,
    tags.T_SEARCH,
    tags.T_SECTION,
    tags.T_SUMMARY,
    tags.T_UL,
];

let BLOCK_ENDS: [28]u16 = [
    tags.T_ADDRESS,
    tags.T_ARTICLE,
    tags.T_ASIDE,
    tags.T_BLOCKQUOTE,
    tags.T_BUTTON,
    tags.T_CENTER,
    tags.T_DETAILS,
    tags.T_DIALOG,
    tags.T_DIR,
    tags.T_DIV,
    tags.T_DL,
    tags.T_FIELDSET,
    tags.T_FIGCAPTION,
    tags.T_FIGURE,
    tags.T_FOOTER,
    tags.T_HEADER,
    tags.T_HGROUP,
    tags.T_LISTING,
    tags.T_MAIN,
    tags.T_MENU,
    tags.T_NAV,
    tags.T_OL,
    tags.T_PRE,
    tags.T_SEARCH,
    tags.T_SECTION,
    tags.T_SELECT,
    tags.T_SUMMARY,
    tags.T_UL,
];

let FORMATTING: [12]u16 = [tags.T_B, tags.T_BIG, tags.T_CODE, tags.T_EM, tags.T_FONT, tags.T_I, tags.T_S, tags.T_SMALL,
                           tags.T_STRIKE, tags.T_STRONG, tags.T_TT, tags.T_U];

let FORMATTING_ENDS: [14]u16 = [
    tags.T_A,
    tags.T_B,
    tags.T_BIG,
    tags.T_CODE,
    tags.T_EM,
    tags.T_FONT,
    tags.T_I,
    tags.T_NOBR,
    tags.T_S,
    tags.T_SMALL,
    tags.T_STRIKE,
    tags.T_STRONG,
    tags.T_TT,
    tags.T_U,
];

let HEAD_TAGS: [10]u16 = [tags.T_BASE, tags.T_BASEFONT, tags.T_BGSOUND, tags.T_LINK, tags.T_META, tags.T_NOFRAMES,
                          tags.T_SCRIPT, tags.T_STYLE, tags.T_TEMPLATE, tags.T_TITLE];

let TABLE_PARTS: [11]u16 = [tags.T_CAPTION, tags.T_COL, tags.T_COLGROUP, tags.T_FRAME, tags.T_HEAD, tags.T_TBODY,
                            tags.T_TD, tags.T_TFOOT, tags.T_TH, tags.T_THEAD, tags.T_TR];

fn in_body_chars(p: *mut Parser, data: []u8) HtmlError!void {
    let mut s = data;
    if (strs.index_of_byte(data, 0) ?? NONE_USIZE) != NONE_USIZE {
        p.sbuf.clear();
        for c in data {
            if c != 0 {
                p.sbuf.push(c)!;
            }
        }
        s = p.sbuf.bytes();
    }
    if s.len == 0 {
        return;
    }
    p.reconstruct()!;
    p.insert_text(s)!;
    if not all_ws(s) {
        p.frameset_ok = false;
    }
}

fn in_body(p: *mut Parser, t: *mut Token) HtmlError!bool {
    let k = t.kind;
    if k == TokenKind.CHARS {
        in_body_chars(p, t.data)!;
        return false;
    }
    if k == TokenKind.START {
        return in_body_start(p, t);
    }
    if k == TokenKind.END {
        return in_body_end(p, t);
    }
    if k == TokenKind.COMMENT {
        p.insert_comment(t, p.place(NONE))!;
        return false;
    }
    if k == TokenKind.EOF {
        if p.tmodes.len() > 0 {
            return in_template(p, t);
        }
    }
    return false;
}

fn in_body_start(p: *mut Parser, t: *mut Token) HtmlError!bool {
    let g = t.tag;
    if g == 0 {
        p.reconstruct()!;
        _ = p.insert(t, Namespace.HTML)!;
        return false;
    }
    if tag_in(t, FORMATTING[..]) {
        p.reconstruct()!;
        let id = p.insert(t, Namespace.HTML)!;
        p.afe_push(id)!;
        return false;
    }
    if tag_in(t, CLOSES_P[..]) {
        p.close_p_in_button_scope();
        _ = p.insert(t, Namespace.HTML)!;
        return false;
    }
    if g == tags.T_HTML {
        if not p.has_template() {
            p.add_missing_attrs(p.stack.items()[0], t)!;
        }
        return false;
    }
    if tag_in(t, HEAD_TAGS[..]) {
        return in_head(p, t);
    }
    if g == tags.T_BODY {
        return start_body(p, t);
    }
    if g == tags.T_FRAMESET {
        return start_frameset(p, t);
    }
    if (g >= tags.T_H1) and (g <= tags.T_H6) {
        p.close_p_in_button_scope();
        let c = p.nd(p.cur());
        if (c.ns == Namespace.HTML) and (c.tag >= tags.T_H1) and (c.tag <= tags.T_H6) {
            p.pop();
        }
        _ = p.insert(t, Namespace.HTML)!;
        return false;
    }
    if (g == tags.T_PRE) or (g == tags.T_LISTING) {
        p.close_p_in_button_scope();
        _ = p.insert(t, Namespace.HTML)!;
        p.skip_lf = true;
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_FORM {
        return start_form(p, t);
    }
    if (g == tags.T_LI) or (g == tags.T_DD) or (g == tags.T_DT) {
        return start_list_item(p, t);
    }
    if g == tags.T_PLAINTEXT {
        p.close_p_in_button_scope();
        _ = p.insert(t, Namespace.HTML)!;
        p.tz.state = State.PLAINTEXT;
        return false;
    }
    if g == tags.T_BUTTON {
        if p.in_scope(tags.T_BUTTON, Scope.DEFAULT) {
            p.gen_implied(0);
            p.pop_until(tags.T_BUTTON);
        }
        p.reconstruct()!;
        _ = p.insert(t, Namespace.HTML)!;
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_A {
        return start_a(p, t);
    }
    if g == tags.T_NOBR {
        return start_nobr(p, t);
    }
    if (g == tags.T_APPLET) or (g == tags.T_MARQUEE) or (g == tags.T_OBJECT) {
        p.reconstruct()!;
        let id = p.insert(t, Namespace.HTML)!;
        if p.opened(id) {
            p.afe.push(MARKER)!;
        }
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_TABLE {
        if p.doc.mode != QuirksMode.QUIRKS {
            p.close_p_in_button_scope();
        }
        _ = p.insert(t, Namespace.HTML)!;
        p.frameset_ok = false;
        p.mode = Mode.IN_TABLE;
        return false;
    }
    if (g == tags.T_AREA) or (g == tags.T_BR) or (g == tags.T_EMBED) or (g == tags.T_IMG) or (g == tags.T_KEYGEN) or
       (g == tags.T_WBR) {
        p.reconstruct()!;
        _ = p.insert_void(t)!;
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_INPUT {
        return start_input(p, t);
    }
    if (g == tags.T_PARAM) or (g == tags.T_SOURCE) or (g == tags.T_TRACK) {
        _ = p.insert_void(t)!;
        return false;
    }
    if g == tags.T_HR {
        p.close_p_in_button_scope();
        if p.in_scope(tags.T_SELECT, Scope.DEFAULT) {
            p.gen_implied(0);
        }
        _ = p.insert_void(t)!;
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_IMAGE {
        t.name = "img";
        t.tag = tags.T_IMG;
        return true;
    }
    if g == tags.T_TEXTAREA {
        p.raw_text(t, State.RCDATA)!;
        p.skip_lf = true;
        p.frameset_ok = false;
        return false;
    }
    if g == tags.T_XMP {
        p.close_p_in_button_scope();
        p.reconstruct()!;
        p.frameset_ok = false;
        p.raw_text(t, State.RAWTEXT)!;
        return false;
    }
    if g == tags.T_IFRAME {
        p.frameset_ok = false;
        p.raw_text(t, State.RAWTEXT)!;
        return false;
    }
    if (g == tags.T_NOEMBED) or ((g == tags.T_NOSCRIPT) and p.scripting) {
        p.raw_text(t, State.RAWTEXT)!;
        return false;
    }
    if g == tags.T_SELECT {
        return start_select(p, t);
    }
    if g == tags.T_OPTION {
        return start_option(p, t, tags.T_OPTGROUP);
    }
    if g == tags.T_OPTGROUP {
        return start_option(p, t, 0);
    }
    if (g == tags.T_RB) or (g == tags.T_RTC) {
        return start_ruby_text(p, t, 0);
    }
    if (g == tags.T_RP) or (g == tags.T_RT) {
        return start_ruby_text(p, t, tags.T_RTC);
    }
    if (g == tags.T_MATH) or (g == tags.T_SVG) {
        return start_foreign(p, t);
    }
    if tag_in(t, TABLE_PARTS[..]) {
        return false;
    }
    p.reconstruct()!;
    _ = p.insert(t, Namespace.HTML)!;
    return false;
}

// <body> in body: its attributes go to the body element, if there is one.
fn start_body(p: *mut Parser, t: *mut Token) HtmlError!bool {
    if (p.stack.len() == 1) or not p.is(p.stack.items()[1], tags.T_BODY) or p.has_template() {
        return false;
    }
    p.frameset_ok = false;
    p.add_missing_attrs(p.stack.items()[1], t)!;
    return false;
}

// <frameset> in body: replaces the body while that is still allowed.
fn start_frameset(p: *mut Parser, t: *mut Token) HtmlError!bool {
    if (p.stack.len() == 1) or not p.is(p.stack.items()[1], tags.T_BODY) or not p.frameset_ok {
        return false;
    }
    p.doc.remove(p.stack.items()[1]);
    p.pop_to(1);
    _ = p.insert(t, Namespace.HTML)!;
    p.mode = Mode.IN_FRAMESET;
    return false;
}

// <form>: one at a time, outside templates.
fn start_form(p: *mut Parser, t: *mut Token) HtmlError!bool {
    let tpl = p.has_template();
    if (p.form != NONE) and not tpl {
        return false;
    }
    p.close_p_in_button_scope();
    let id = p.insert(t, Namespace.HTML)!;
    if not tpl {
        p.form = id;
    }
    return false;
}

// <li>, <dd> and <dt>: each closes an open item of its kind first.
fn start_list_item(p: *mut Parser, t: *mut Token) HtmlError!bool {
    let g = t.tag;
    p.frameset_ok = false;
    let mut i = p.stack.len();
    while i > 0 {
        i -= 1;
        let id = p.stack.items()[i];
        let n = p.nd(id);
        let mut hit: u16 = 0;
        if (g == tags.T_LI) and p.is(id, tags.T_LI) {
            hit = tags.T_LI;
        } else if (g != tags.T_LI) and (p.is(id, tags.T_DD) or p.is(id, tags.T_DT)) {
            hit = n.tag;
        }
        if hit != 0 {
            p.gen_implied(hit);
            p.pop_until(hit);
            break;
        }
        if p.special(id) and not p.is(id, tags.T_ADDRESS) and not p.is(id, tags.T_DIV) and not p.is(id, tags.T_P) {
            break;
        }
    }
    p.close_p_in_button_scope();
    _ = p.insert(t, Namespace.HTML)!;
    return false;
}

// <a>: an <a> still among the active formatting elements is closed first.
fn start_a(p: *mut Parser, t: *mut Token) HtmlError!bool {
    let items = p.afe.items();
    let mut i = items.len;
    let mut old = NONE;
    while i > 0 {
        i -= 1;
        if items[i] == MARKER {
            break;
        }
        if p.is(items[i], tags.T_A) {
            old = items[i];
            break;
        }
    }
    if old != NONE {
        if not adoption(p, t)! {
            any_other_end(p, t);
        }
        p.afe_remove(old);
        p.stack_remove(old);
    }
    p.reconstruct()!;
    let id = p.insert(t, Namespace.HTML)!;
    p.afe_push(id)!;
    return false;
}

// <nobr>: an open <nobr> in scope is closed first.
fn start_nobr(p: *mut Parser, t: *mut Token) HtmlError!bool {
    p.reconstruct()!;
    if p.in_scope(tags.T_NOBR, Scope.DEFAULT) {
        if not adoption(p, t)! {
            any_other_end(p, t);
        }
        p.reconstruct()!;
    }
    let id = p.insert(t, Namespace.HTML)!;
    p.afe_push(id)!;
    return false;
}

// <input>: ignored in a <select> context, else closes an open <select>.
fn start_input(p: *mut Parser, t: *mut Token) HtmlError!bool {
    if p.is(p.context, tags.T_SELECT) {
        return false;
    }
    if p.in_scope(tags.T_SELECT, Scope.DEFAULT) {
        p.pop_until(tags.T_SELECT);
    }
    p.reconstruct()!;
    _ = p.insert_void(t)!;
    if not is_hidden_input(t) {
        p.frameset_ok = false;
    }
    return false;
}

// <select>: ignored in a <select> context; one in scope is closed instead.
fn start_select(p: *mut Parser, t: *mut Token) HtmlError!bool {
    if p.is(p.context, tags.T_SELECT) {
        return false;
    }
    if p.in_scope(tags.T_SELECT, Scope.DEFAULT) {
        p.pop_until(tags.T_SELECT);
        return false;
    }
    p.reconstruct()!;
    _ = p.insert(t, Namespace.HTML)!;
    p.frameset_ok = false;
    return false;
}

// <math> and <svg>: elements in their own namespaces.
fn start_foreign(p: *mut Parser, t: *mut Token) HtmlError!bool {
    let g = t.tag;
    p.reconstruct()!;
    let mut ns = Namespace.MATHML;
    if g == tags.T_SVG {
        ns = Namespace.SVG;
    }
    let id = p.insert(t, ns)!;
    if t.self_closing and p.opened(id) {
        p.pop();
    }
    return false;
}

// <option> and <optgroup>: implied end tags (but for the one excepted) close
// what is open in a <select>; else an open <option> is closed.
fn start_option(p: *mut Parser, t: *mut Token, except: u16) HtmlError!bool {
    if p.in_scope(tags.T_SELECT, Scope.DEFAULT) {
        p.gen_implied(except);
    } else if p.cur_is(tags.T_OPTION) {
        p.pop();
    }
    p.reconstruct()!;
    _ = p.insert(t, Namespace.HTML)!;
    return false;
}

// <rb>, <rtc>, <rp> and <rt>: implied end tags (but for the one excepted)
// close what is open in a <ruby>.
fn start_ruby_text(p: *mut Parser, t: *mut Token, except: u16) HtmlError!bool {
    if p.in_scope(tags.T_RUBY, Scope.DEFAULT) {
        p.gen_implied(except);
    }
    _ = p.insert(t, Namespace.HTML)!;
    return false;
}

fn is_hidden_input(t: *Token) bool {
    for a in t.attrs {
        if strs.eq(a.name, "type") {
            return strs.eq_ignore_case(a.value, "hidden");
        }
    }
    return false;
}

fn in_body_end(p: *mut Parser, t: *mut Token) HtmlError!bool {
    let g = t.tag;
    if g == 0 {
        any_other_end(p, t);
        return false;
    }
    if tag_in(t, FORMATTING_ENDS[..]) {
        if not adoption(p, t)! {
            any_other_end(p, t);
        }
        return false;
    }
    if tag_in(t, BLOCK_ENDS[..]) {
        if not p.in_scope(g, Scope.DEFAULT) {
            return false;
        }
        p.gen_implied(0);
        p.pop_until(g);
        return false;
    }
    if g == tags.T_TEMPLATE {
        return in_head(p, t);
    }
    if (g == tags.T_BODY) or (g == tags.T_HTML) {
        if not p.in_scope(tags.T_BODY, Scope.DEFAULT) {
            return false;
        }
        p.mode = Mode.AFTER_BODY;
        return g == tags.T_HTML;
    }
    if g == tags.T_FORM {
        if not p.has_template() {
            let node = p.form;
            p.form = NONE;
            if (node == NONE) or not p.node_in_scope(node) {
                return false;
            }
            p.gen_implied(0);
            p.stack_remove(node);
        } else {
            if not p.in_scope(tags.T_FORM, Scope.DEFAULT) {
                return false;
            }
            p.gen_implied(0);
            p.pop_until(tags.T_FORM);
        }
        return false;
    }
    if g == tags.T_P {
        if not p.in_scope(tags.T_P, Scope.BUTTON) {
            _ = p.insert_fake(tags.T_P)!;
        }
        p.close_p();
        return false;
    }
    if g == tags.T_LI {
        if not p.in_scope(tags.T_LI, Scope.LIST) {
            return false;
        }
        p.gen_implied(tags.T_LI);
        p.pop_until(tags.T_LI);
        return false;
    }
    if (g == tags.T_DD) or (g == tags.T_DT) {
        if not p.in_scope(g, Scope.DEFAULT) {
            return false;
        }
        p.gen_implied(g);
        p.pop_until(g);
        return false;
    }
    if (g >= tags.T_H1) and (g <= tags.T_H6) {
        if not p.heading_in_scope() {
            return false;
        }
        p.gen_implied(0);
        while p.stack.len() > 1 {
            let n = p.nd(p.cur());
            let h = (n.ns == Namespace.HTML) and (n.tag >= tags.T_H1) and (n.tag <= tags.T_H6);
            p.pop();
            if h {
                break;
            }
        }
        return false;
    }
    if (g == tags.T_APPLET) or (g == tags.T_MARQUEE) or (g == tags.T_OBJECT) {
        if not p.in_scope(g, Scope.DEFAULT) {
            return false;
        }
        p.gen_implied(0);
        p.pop_until(g);
        p.afe_clear_to_marker();
        return false;
    }
    if g == tags.T_BR {
        let mut b = fake_token(tags.T_BR);
        p.reconstruct()!;
        _ = p.insert_void(&mut b)!;
        p.frameset_ok = false;
        return false;
    }
    any_other_end(p, t);
    return false;
}

fn same_name(n: *Node, t: *Token) bool {
    return (n.kind == Kind.ELEMENT) and (n.ns == Namespace.HTML) and (n.tag == t.tag) and
           ((t.tag != 0) or strs.eq(n.name, t.name));
}

fn any_other_end(p: *mut Parser, t: *Token) void {
    let mut i = p.stack.len();
    while i > 1 {
        i -= 1;
        let id = p.stack.items()[i];
        if same_name(p.nd(id), t) {
            p.gen_implied(t.tag);
            p.pop_until_node(id);
            return;
        }
        if p.special(id) {
            return;
        }
    }
}

// The adoption agency algorithm: false when the caller should act as for
// "any other end tag".
fn adoption(p: *mut Parser, t: *Token) HtmlError!bool {
    let subject = t.tag;
    let c = p.cur();
    if p.is(c, subject) and ((p.nd(c).flags & FL_AFE) == 0) {
        p.pop();
        return true;
    }
    let mut outer: u32 = 0;
    while outer < 8 {
        outer += 1;
        // the formatting element
        let mut fi = p.afe.len();
        let mut fe = NONE;
        while fi > 0 {
            fi -= 1;
            let e = p.afe.items()[fi];
            if e == MARKER {
                break;
            }
            if p.is(e, subject) {
                fe = e;
                break;
            }
        }
        if fe == NONE {
            return false;
        }
        if not p.opened(fe) {
            p.afe_remove_at(fi);
            return true;
        }
        if not p.node_in_scope(fe) {
            return true;
        }
        // the furthest block
        let si = p.stack_index(fe);
        let mut fb = NONE;
        let mut fbi = si + 1;
        while fbi < p.stack.len() {
            if p.special(p.stack.items()[fbi]) {
                fb = p.stack.items()[fbi];
                break;
            }
            fbi += 1;
        }
        if fb == NONE {
            p.pop_to(si);
            p.afe_remove(fe);
            return true;
        }
        let ca = p.stack.items()[si - 1];
        let mut bookmark = fi;
        let mut ni = fbi;
        let mut last = fb;
        let mut inner: u32 = 0;
        loop {
            inner += 1;
            ni -= 1;
            let node = p.stack.items()[ni];
            if node == fe {
                break;
            }
            let mut ai = p.afe_index(node);
            if (inner > 3) and (ai != NONE_USIZE) {
                p.afe_remove_at(ai);
                if ai < bookmark {
                    bookmark -= 1;
                }
                ai = NONE_USIZE;
            }
            if ai == NONE_USIZE {
                _ = p.stack.remove(ni);
                p.closed_at(node);
                continue;
            }
            let e = p.clone_element(node)!;
            p.afe.items_mut()[ai] = e;
            p.stack.items_mut()[ni] = e;
            p.closed_at(node);
            p.ndm(node).flags &= ~FL_AFE;
            p.opened_at(e);
            p.ndm(e).flags |= FL_AFE;
            if last == fb {
                bookmark = ai + 1;
            }
            p.doc.remove(last);
            p.doc.append_child(e, last);
            last = e;
        }
        p.doc.remove(last);
        p.insert_node(p.place(ca), last);
        let e = p.clone_element(fe)!;
        // the furthest block's children move into the new element
        loop {
            let ch = p.nd(fb).first;
            if ch == NONE {
                break;
            }
            p.doc.remove(ch);
            p.doc.append_child(e, ch);
        }
        p.doc.append_child(fb, e);
        let fi2 = p.afe_index(fe);
        p.afe_remove_at(fi2);
        if fi2 < bookmark {
            bookmark -= 1;
        }
        p.afe.insert(@min(bookmark, p.afe.len()), e)!;
        p.ndm(e).flags |= FL_AFE;
        p.stack_remove(fe);
        let at = p.stack_index(fb);
        p.stack.insert(at + 1, e)!;
        p.opened_at(e);
    }
    return true;
}
