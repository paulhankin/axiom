fn serve_once_with(cfg: *ServerConfig, port_out: *mut u16) TlsError!TestServer {
    let ts = TestServer.{ listener: net.listen("127.0.0.1", 0)!, cfg: cfg, failures: 0 };
    port_out.* = ts.listener.port();
    return ts;
}

fn key_update_fails(c: *mut Conn) bool {
    c.key_update() catch return true;
    return false;
}

fn exchange_12(port: u16, ccfg: *ClientConfig) !void {
    let c = connect("localhost", port, ccfg)!;
    defer c.close();
    @expect_eq(c.version(), VERSION_1_2);
    @expect(c.suite.v12);
    c.write_all("hello")!;
    let mut buf: [8]u8 = [0; 8];
    c.reader().read_exact(buf[..5])!;
    @expect_eq(buf[..5], "hello");
    let big = mem.alloc.[u8](70000)!;
    defer mem.free(big);
    for i in 0..big.len {
        big[i] = @truncate(u8, i * 13);
    }
    c.write_all(big)!;
    let back = mem.alloc.[u8](70000)!;
    defer mem.free(back);
    c.reader().read_exact(back)!;
    @expect(@mem_eq(back, big));
    @expect(key_update_fails(c));
}

test "TLS 1.2" {
    let protos: [2][]u8 = ["h2", "http/1.1"];
    for kind in @as(u32, 0)..2 {
        let mut cert = join(TEST_CERT[..])!;
        let mut key = join(TEST_KEY[..])!;
        if kind == 1 {
            mem.free(cert);
            mem.free(key);
            cert = join(TEST_RSA_CERT[..])!;
            key = join(TEST_RSA_KEY[..])!;
        }
        defer mem.free(cert);
        defer mem.free(key);
        let mut scfg = ServerConfig.from_pem(cert, key)!;
        defer scfg.deinit();
        scfg.alpn = protos[1..];
        let mut port: u16 = 0;
        let mut ts = serve_once_with(&scfg, &mut port)!;
        let mut th = thread.spawn(test_serve, &mut ts)!;
        let mut ccfg = ClientConfig.with_roots_pem(cert)!;
        defer ccfg.deinit();
        ccfg.max_version = VERSION_1_2;
        ccfg.alpn = protos[..];
        exchange_12(port, &ccfg)!;
        let c = connect("localhost", port, &ccfg)!;
        @expect_eq(c.protocol(), "http/1.1");
        c.close();
        // by default the same pair speaks 1.3
        ccfg.max_version = VERSION_1_3;
        let c3 = connect("localhost", port, &ccfg)!;
        @expect_eq(c3.version(), VERSION_1_3);
        c3.close();
        // a 1.3-only client and a 1.2-only one meet a server that wants 1.3
        scfg.min_version = VERSION_1_3;
        ccfg.max_version = VERSION_1_2;
        @expect(fails(connect("localhost", port, &ccfg)));
        scfg.min_version = VERSION_1_2;
        ccfg.max_version = VERSION_1_3;
        ccfg.min_version = VERSION_1_3;
        let c4 = connect("localhost", port, &ccfg)!;
        @expect_eq(c4.version(), VERSION_1_3);
        c4.close();
        // the wrong name is still refused over 1.2
        ccfg.min_version = VERSION_1_2;
        ccfg.max_version = VERSION_1_2;
        let s5 = net.connect("127.0.0.1", port)!;
        @expect(fails(client(s5, "other.test", &ccfg)));
        ts.listener.close();
        th.join();
        @expect_eq(ts.failures, 2);
    }
}

test "TLS 1.2 PRF" {
    // the TLS 1.2 PRF test vector for SHA-256 (from the IETF TLS mailing
    // list, used by Go and others)
    let secret: [16]u8 = [0x9b, 0xbe, 0x43, 0x6b, 0xa9, 0x40, 0xf0, 0x17, 0xb1, 0x76, 0x52, 0x84, 0x9a, 0x71, 0xdb,
                          0x35];
    let seed: [16]u8 = [0xa0, 0xba, 0x9f, 0x93, 0x6c, 0xda, 0x31, 0x18, 0x27, 0xa6, 0xf7, 0x96, 0xff, 0xd5, 0x19, 0x8c];
    let mut o: [100]u8 = [0; 100];
    prf12(sha2.Algorithm.SHA256, secret[..], "test label", seed[..], o[..]);
    let want: [16]u8 = [0xe3, 0xf2, 0x29, 0xba, 0x72, 0x7b, 0xe1, 0x7b, 0x8d, 0x12, 0x26, 0x20, 0x55, 0x7c, 0xd4, 0x53];
    @expect_eq(o[..16], want[..]);
    let tail: [4]u8 = [0x87, 0x34, 0x7b, 0x66];  // (computed with Python's hmac)
    @expect_eq(o[96..], tail[..]);
}

// A ClientHello offering one suite, with server_name `name`.
fn hello_with_name(name: []u8) TlsError!Out {
    let mut o = out();
    o.put8(HS_CLIENT_HELLO)!;
    let body = o.open(3)!;
    o.put16(0x0303)!;
    let rnd: [32]u8 = [7; 32];
    o.put(rnd[..])!;
    o.put8(0)!;
    o.put16(2)!;
    o.put16(TLS_AES_128_GCM_SHA256)!;
    o.put8(1)!;
    o.put8(0)!;
    let exts = o.open(2)!;
    o.put16(EXT_SERVER_NAME)!;
    let e = o.open(2)!;
    let l = o.open(2)!;
    o.put8(0)!;
    o.put16(@truncate(u16, name.len))!;
    o.put(name)!;
    o.close(l, 2);
    o.close(e, 2);
    o.close(exts, 2);
    o.close(body, 3);
    return o;
}

fn name_refused(name: []u8) bool {
    let mut o = hello_with_name(name) catch return false;
    defer o.s.deinit();
    parse_hello(o.s.bytes()) catch |e| return e == error.IllegalParameter;
    return false;
}

test "server names" {
    let long = mem.alloc.[u8](300)!;
    defer mem.free(long);
    @mem_set(long, 'a');
    // control bytes, slashes, spaces, a NUL, an empty name, and one past 255 bytes
    let bad: [6][]u8 = ["../../etc/passwd", "a\r\nX-Injected: 1", "a\x00b", "a b", "", long];
    for k in @as(usize, 0)..bad.len {
        if not name_refused(bad[k]) {
            @expect_eq(k, 99);
        }
    }
    let mut ok = hello_with_name("_a-b.example.com")!;
    defer ok.s.deinit();
    parse_hello(ok.s.bytes())!;
    @expect(not name_refused(long[..255]));
    // and the client does not send one
    let l = net.listen("127.0.0.1", 0)!;
    defer l.close();
    let mut insecure = ClientConfig.insecure();
    defer insecure.deinit();
    let st = net.connect("127.0.0.1", l.port())!;
    let r = client(st, "a\r\nb", &insecure);
    _ = r catch |e| {
        @expect(e == error.InvalidArgument);
        return;
    };
    @expect(false);
}

// A server that answers the ClientHello with one ServerHello (or retry).
nocopy struct FakeServer {
    listener: net.TcpListener,
    suite: u16,
    hrr: bool,
    group: u16,
}

fn fake_serve(f: *mut FakeServer) void {
    let s = f.listener.accept() catch return;
    defer s.close();
    let mut hdr: [5]u8 = [0; 5];
    s.reader().read_exact(hdr[..]) catch return;
    let n = (@as(usize, hdr[3]) << 8) | @as(usize, hdr[4]);
    let mut body: [4096]u8 = [0; 4096];
    if (n > body.len) or (n < 40) {
        return;
    }
    s.reader().read_exact(body[..n]) catch return;
    let sl = @as(usize, body[38]);
    let share: [32]u8 = [9; 32];
    let mut sh = server_hello(body[39..39 + sl], f.suite, f.hrr, f.group, share[..]) catch return;
    defer sh.s.deinit();
    let rec: [5]u8 = [CT_HANDSHAKE, 3, 3, @truncate(u8, sh.s.len() >> 8), @truncate(u8, sh.s.len())];
    s.write_all(rec[..]) catch return;
    s.write_all(sh.s.bytes()) catch return;
    // (until the client's alert and close)
    let mut buf: [256]u8 = [0; 256];
    loop {
        let got = s.read(buf[..]) catch return;
        if got == 0 {
            return;
        }
    }
}

fn against_server_hello(suite: u16, hrr: bool, group: u16) error {
    let mut f = FakeServer.{ listener: net.listen("127.0.0.1", 0) catch |e| return e, suite: suite, hrr: hrr,
                             group: group };
    defer f.listener.close();
    let mut th = thread.spawn(fake_serve, &mut f) catch |e| return e;
    defer th.join();
    let mut insecure = ClientConfig.insecure();
    defer insecure.deinit();
    let st = net.connect("127.0.0.1", f.listener.port()) catch |e| return e;
    let c = client(st, "localhost", &insecure) catch |e| return e;
    c.close();
    return error.Closed;
}

test "a TLS 1.3 client checks the ServerHello" {
    // a TLS 1.2 suite in a 1.3 ServerHello, and one never offered
    @expect(against_server_hello(ECDHE_RSA_AES_128_GCM_SHA256, false, GROUP_X25519) == error.IllegalParameter);
    @expect(against_server_hello(0x1304, false, GROUP_X25519) == error.HandshakeFailure);
    // a retry asking for a group the first hello already had a share for
    @expect(against_server_hello(TLS_AES_128_GCM_SHA256, true, GROUP_X25519) == error.IllegalParameter);
    @expect(against_server_hello(TLS_AES_128_GCM_SHA256, true, GROUP_P256) == error.IllegalParameter);
}
