// =============================================================================
// lib/net/tls/tests.ax - test certificates/keys and TLS 1.3 / 1.2 unit and
// loopback tests (part of lib/net/tls).
// =============================================================================

import "std/hash/sha2" as sha2;
import "std/mem" as mem;
import "std/net" as net;
import "std/str" as strs;
import "std/thread" as thread;

// -----------------------------------------------------------------------------
// Tests: a client and a server in one process, over loopback. The server
// has a self-signed P-256 certificate for localhost and 127.0.0.1.
// -----------------------------------------------------------------------------

