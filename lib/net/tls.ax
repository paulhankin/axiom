// -----------------------------------------------------------------------------
// Reading and writing message fields
// -----------------------------------------------------------------------------

/// A cursor over received bytes; every read fails with DecodeError when
/// the data runs out.
struct Cur {
    b: []u8,
    i: usize,

    fn get8(self: *mut Cur) TlsError!u8 {
        if self.i >= self.b.len {
            return error.DecodeError;
        }
        self.i += 1;
        return self.b[self.i - 1];
    }

    fn get16(self: *mut Cur) TlsError!u16 {
        let hi = self.get8()!;
        let lo = self.get8()!;
        return (@as(u16, hi) << 8) | @as(u16, lo);
    }

    fn get24(self: *mut Cur) TlsError!usize {
        let a = self.get8()!;
        let b = self.get16()!;
        return (@as(usize, a) << 16) | @as(usize, b);
    }

    fn bytes(self: *mut Cur, n: usize) TlsError![]u8 {
        if n > (self.b.len - self.i) {
            return error.DecodeError;
        }
        self.i += n;
        return self.b[self.i - n..self.i];
    }

    fn vec8(self: *mut Cur) TlsError![]u8 {
        let n = @as(usize, self.get8()!);
        return self.bytes(n);
    }

    fn vec16(self: *mut Cur) TlsError![]u8 {
        let n = @as(usize, self.get16()!);
        return self.bytes(n);
    }

    fn vec24(self: *mut Cur) TlsError![]u8 {
        let n = self.get24()!;
        return self.bytes(n);
    }

    fn done(self: *Cur) bool {
        return self.i >= self.b.len;
    }
}

fn cur(b: []u8) Cur {
    return Cur.{ b: b, i: 0 };
}

/// Appends big-endian integers and length-prefixed vectors.
nocopy struct Out {
    s: strs.String,

    fn put8(self: *mut Out, v: u8) TlsError!void {
        self.s.push(v)!;
    }

    fn put16(self: *mut Out, v: u16) TlsError!void {
        self.s.push(@truncate(u8, v >> 8))!;
        self.s.push(@truncate(u8, v))!;
    }

    fn put24(self: *mut Out, v: usize) TlsError!void {
        self.s.push(@truncate(u8, v >> 16))!;
        self.s.push(@truncate(u8, v >> 8))!;
        self.s.push(@truncate(u8, v))!;
    }

    fn put(self: *mut Out, b: []u8) TlsError!void {
        self.s.push_str(b)!;
    }

    /// Starts a vector with an n-byte length; finish it with close.
    fn open(self: *mut Out, n: usize) TlsError!usize {
        let at = self.s.len();
        for i in 0..n {
            self.s.push(0)!;
        }
        return at;
    }

    fn close(self: *mut Out, at: usize, n: usize) void {
        let len = (self.s.len() - at) - n;
        let b = self.s.bytes_mut();
        for i in 0..n {
            b[at + i] = @truncate(u8, len >> @truncate(u32, 8 * ((n - 1) - i)));
        }
    }

    fn bytes(self: *Out) []u8 {
        return self.s.bytes();
    }
}

fn out() Out {
    return Out.{ s: strs.String.init() };
}

// -----------------------------------------------------------------------------
// Configuration and server name checks
// -----------------------------------------------------------------------------

/// Settings for clients.
pub nocopy struct ClientConfig {
    roots: x509.CertPool,
    verify: bool,      // check the server's certificate (keep this on)
    pub alpn: [][]u8,  // protocols to offer, e.g. ["h2", "http/1.1"]
    min_version: u16,  // VERSION_1_2 (the default) or VERSION_1_3
    max_version: u16,  // VERSION_1_3 (the default) or VERSION_1_2

    /// Trusts the operating system's root certificates.
    pub fn system() TlsError!ClientConfig {
        let mut c = ClientConfig.{ roots: x509.CertPool.init(), verify: true, alpn: [], min_version: VERSION_1_2,
                                   max_version: VERSION_1_3 };
        _ = c.roots.load_system() catch |e| {
            c.roots.deinit();
            return e;
        };
        return c;
    }

    /// Trusts the certificates of a PEM text only.
    pub fn with_roots_pem(pem: []u8) TlsError!ClientConfig {
        let mut c = ClientConfig.{ roots: x509.CertPool.init(), verify: true, alpn: [], min_version: VERSION_1_2,
                                   max_version: VERSION_1_3 };
        _ = c.roots.add_pem(pem) catch |e| {
            c.roots.deinit();
            return e;
        };
        return c;
    }

    /// Accepts any server certificate: for testing only, as it allows
    /// anyone in the middle to read and change the traffic.
    pub fn insecure() ClientConfig {
        return ClientConfig.{ roots: x509.CertPool.init(), verify: false, alpn: [], min_version: VERSION_1_2,
                              max_version: VERSION_1_3 };
    }

    pub fn deinit(self: *mut ClientConfig) void {
        self.roots.deinit();
    }
}

/// Settings for servers: the certificate chain (leaf first) and its key.
pub nocopy struct ServerConfig {
    chain: vec.Vec.[[]mut u8],  // DER certificates
    key: x509.PrivateKey,
    key_kind: x509.KeyKind,
    pub alpn: [][]u8,  // protocols accepted, in order of preference
    min_version: u16,  // VERSION_1_2 (the default): TLS 1.2 clients are served too; or VERSION_1_3

    /// From PEM texts: the certificates (leaf first) and the private key.
    pub fn from_pem(cert_pem: []u8, key_pem: []u8) TlsError!ServerConfig {
        let mut chain = vec.Vec.[[]mut u8].init();
        let mut it = x509.pem_blocks(cert_pem);
        while let .some(b) = (it.next() catch .none) {
            if @mem_eq(b.label, "CERTIFICATE") {
                let d = x509.pem_decode(b) catch |e| {
                    free_chain(&mut chain);
                    return e;
                };
                chain.push(d) catch |e| {
                    mem.free(d);
                    free_chain(&mut chain);
                    return e;
                };
            }
        }
        if chain.len() == 0 {
            free_chain(&mut chain);
            return error.NoCertificate;
        }
        let key = x509.parse_private_key_pem(key_pem) catch |e| {
            free_chain(&mut chain);
            return e;
        };
        let mut kind = x509.KeyKind.UNSUPPORTED;
        match &key {
            .Rsa(k) => {
                _ = k;
                kind = x509.KeyKind.RSA;
            }
            .P256(k) => {
                _ = k;
                kind = x509.KeyKind.P256;
            }
            .P384(k) => {
                _ = k;
                kind = x509.KeyKind.P384;
            }
            .Ed25519(k) => {
                _ = k;
                kind = x509.KeyKind.ED25519;
            }
        }
        return ServerConfig.{ chain: chain, key: key, key_kind: kind, alpn: [], min_version: VERSION_1_2 };
    }

    pub fn deinit(self: *mut ServerConfig) void {
        free_chain(&mut self.chain);
        self.key.deinit();
    }
}

fn free_chain(c: *mut vec.Vec.[[]mut u8]) void {
    for d in c.items() {
        mem.free(d);
    }
    c.deinit();
}

fn is_ip(sni: []u8) bool {
    if strs.contains(sni, ":") {
        _ = net.Addr.parse(sni) catch return false;
        return true;
    }
    _ = net.parse_ipv4(sni) catch return false;
    return true;
}

// A name that may go in (or come from) server_name: 1 to 255 letters,
// digits, '-', '.' and '_'.
fn is_host_name(n: []u8) bool {
    if (n.len == 0) or (n.len > 255) {
        return false;
    }
    for ch in n {
        if not strs.is_alnum(ch) and (ch != '-') and (ch != '.') and (ch != '_') {
            return false;
        }
    }
    return true;
}
