// =============================================================================
// lib/net/http/tests_slow.ax - tests for slow and idle clients, timeouts,
// connection limits, and memory budgets (part of lib/net/http).
// =============================================================================

import "../http2.ax" as http2;
import "../tls.ax" as tls;
import "std/fmt" as fmt;
import "std/mem" as mem;
import "std/net" as net;
import "std/str" as strs;
import "std/thread" as thread;
import "std/time" as time;

// --- slow and idle clients -------------------------------------------------

/// Sockets that a thread drips a request head into, a byte at a time, never
/// finishing it (or a body, after a whole head).
struct Drip {
    socks: [16]net.TcpStream,
    n: usize,
    stop: u32,
    sent: u32,  // bytes dripped, all sockets together
}

fn drip_run(d: *mut Drip) void {
    while @atomic_load(&d.stop) == 0 {
        for k in @as(usize, 0)..d.n {
            _ = d.socks[k].write("x") catch 0;
            _ = @atomic_add(&mut d.sent, 1);
        }
        thread.sleep_ms(10);
    }
}

/// A connection to the test server, its reads bounded (a test must not
/// hang on a server that never answers).
fn dial(port: u16) !net.TcpStream {
    let st = net.connect("127.0.0.1", port)!;
    st.set_timeout(10000)!;
    return st;
}

/// Reads one response with a Content-Length body into buf; returns it.
fn read_reply(st: net.TcpStream, buf: []mut u8) ![]u8 {
    let mut n: usize = 0;
    loop {
        let got = st.read(buf[n..])!;
        if got == 0 {
            return error.Closed;
        }
        n += got;
        let end = strs.index_of(buf[..n], "\r\n\r\n") ?? continue;
        let at = strs.index_of(buf[..end], "Content-Length: ") ?? return error.BadResponse;
        let digits = buf[at + 16..];
        let nl = strs.index_of_byte(digits, '\r') ?? return error.BadResponse;
        let len = fmt.parse_int.[usize](digits[..nl])!;
        if n >= (end + 4 + len) {
            return buf[..end + 4 + len];
        }
    }
}

/// Reads until what was read ends with `suffix`; returns it.
fn read_until(st: net.TcpStream, buf: []mut u8, suffix: []u8) ![]u8 {
    let mut n: usize = 0;
    while not strs.ends_with(buf[..n], suffix) {
        let got = st.read(buf[n..])!;
        if got == 0 {
            return error.Closed;
        }
        n += got;
    }
    return buf[..n];
}

/// Whether the server closes the connection (rather than answer) within
/// the socket's timeout; what it sent before closing goes to buf.
fn closed_by_server(st: net.TcpStream, buf: []mut u8) bool {
    let mut n: usize = 0;
    loop {
        let got = st.read(buf[n..]) catch |e| {
            return e != error.TimedOut;  // (reset)
        };
        if got == 0 {
            return true;
        }
        n = @min(n + got, buf.len - 1);
    }
}

fn ms_since(t: time.Instant) i64 {
    return t.elapsed().ns / 1000000;
}

test "idle and slow clients do not hold the workers" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    r.post("/echo", t_echo)!;
    let mut opts = Options.default();
    opts.threads = 2;
    opts.head_timeout_ms = 20000;  // (the slow ones must last the test)
    opts.min_body_rate = 1;
    let mut srv = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    // 4 idle connections, 4 dripping a head, 4 dripping a body: each
    // group more than there are workers
    let mut idle: [4]net.TcpStream = [net.TcpStream.{ handle: -1 }; 4];
    for k in @as(usize, 0)..4 {
        idle[k] = dial(port)!;
    }
    let mut d = Drip.{ socks: [net.TcpStream.{ handle: -1 }; 16], n: 8, stop: 0, sent: 0 };
    for k in @as(usize, 0)..8 {
        d.socks[k] = dial(port)!;
        if k < 4 {
            d.socks[k].write_all("GET /hello HTTP/1.1\r\nHost: x\r\nX-Slow: ")!;
        } else {
            d.socks[k].write_all("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 100000\r\n\r\n")!;
        }
    }
    let mut dt = thread.spawn(drip_run, &mut d)!;
    while @atomic_load(&d.sent) < 40 {
        thread.sleep_ms(5);
    }
    // a client like any other is answered at once, several times over
    let mut url: [128]u8 = [0; 128];
    let u = fmt.bufprint(url[..], "http://127.0.0.1:{}/hello?name=you", [fmt.int(port)])!;
    let mut slowest: i64 = 0;
    for k in @as(usize, 0)..5 {
        let t0 = time.Instant.now();
        let mut a = get(u)!;
        slowest = @max(slowest, ms_since(t0));
        @expect_eq(a.status, 200);
        @expect_eq(a.body, "hello, you");
        a.deinit();
        _ = k;
    }
    @expect(slowest < 1000);
    // and one on a connection that idled first
    let mut buf: [1024]u8 = [0; 1024];
    let t0 = time.Instant.now();
    idle[0].write_all("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")!;
    @expect(strs.ends_with(read_reply(idle[0], buf[..])!, "hello, world"));
    @expect(ms_since(t0) < 1000);
    @atomic_store(&mut d.stop, 1);
    dt.join();
    for k in @as(usize, 0)..8 {
        d.socks[k].close();
    }
    for k in @as(usize, 0)..4 {
        idle[k].close();
    }
    srv.stop();
    th.join();
}

test "idle and slow TLS clients do not hold the workers" {
    let cert = tls.test_certificate_pem()!;
    defer mem.free(cert);
    let key = tls.test_key_pem()!;
    defer mem.free(key);
    let mut scfg = tls.ServerConfig.from_pem(cert, key)!;
    defer scfg.deinit();
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    let mut opts = Options.default();
    opts.threads = 2;
    opts.handshake_timeout_ms = 20000;
    let mut srv = server_tls("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts, &scfg)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    // 4 that never start a handshake, 4 dripping a ClientHello
    let mut idle: [4]net.TcpStream = [net.TcpStream.{ handle: -1 }; 4];
    for k in @as(usize, 0)..4 {
        idle[k] = dial(port)!;
    }
    let mut d = Drip.{ socks: [net.TcpStream.{ handle: -1 }; 16], n: 4, stop: 0, sent: 0 };
    for k in @as(usize, 0)..4 {
        d.socks[k] = dial(port)!;
        let hdr: [5]u8 = [22, 3, 1, 0x40, 0];  // a handshake record of 16 KiB
        d.socks[k].write_all(hdr[..])!;
    }
    let mut dt = thread.spawn(drip_run, &mut d)!;
    while @atomic_load(&d.sent) < 20 {
        thread.sleep_ms(5);
    }
    let mut ccfg = tls.ClientConfig.with_roots_pem(cert)!;
    defer ccfg.deinit();
    let copts = ClientOptions.default().with_tls(&ccfg);
    let mut url: [128]u8 = [0; 128];
    let u = fmt.bufprint(url[..], "https://localhost:{}/hello?name=tls", [fmt.int(port)])!;
    let mut slowest: i64 = 0;
    for k in @as(usize, 0)..3 {
        let t0 = time.Instant.now();
        let mut a = request("GET", u, no_headers(), "", copts)!;
        slowest = @max(slowest, ms_since(t0));
        @expect_eq(a.body, "hello, tls");
        a.deinit();
        _ = k;
    }
    @expect(slowest < 1000);
    @atomic_store(&mut d.stop, 1);
    dt.join();
    for k in @as(usize, 0)..4 {
        d.socks[k].close();
        idle[k].close();
    }
    srv.stop();
    th.join();
}

test "deadlines for heads, bodies, handshakes and idle connections" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    r.post("/echo", t_echo)!;
    let mut opts = Options.default();
    opts.threads = 1;
    opts.head_timeout_ms = 200;
    opts.idle_timeout_ms = 700;
    opts.min_body_rate = 1000;
    let mut srv = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let mut buf: [1024]u8 = [0; 1024];
    // a head that stalls: 408, then closed
    let a = dial(port)!;
    a.write_all("GET /hello HTTP/1.1\r\nHost: x\r\n")!;
    let t0 = time.Instant.now();
    @expect(closed_by_server(a, buf[..]));
    @expect(strs.starts_with(buf[..], "HTTP/1.1 408 "));
    @expect(ms_since(t0) < 5000);
    a.close();
    // a new connection that sends nothing: closed after the head's time
    let b = dial(port)!;
    @expect(closed_by_server(b, buf[..]));
    b.close();
    // a body far slower than min_body_rate: 408
    let c = dial(port)!;
    c.write_all("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 100000\r\n\r\nsome")!;
    @mem_set(buf[..], 0);
    @expect(closed_by_server(c, buf[..]));
    @expect(strs.starts_with(buf[..], "HTTP/1.1 408 "));
    c.close();
    // keep-alive: requests one after another, waiting longer than a head
    // may take between them, then pipelined; idle too long, it is closed
    let k = dial(port)!;
    for i in @as(usize, 0)..2 {
        k.write_all("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")!;
        @expect(strs.ends_with(read_reply(k, buf[..])!, "hello, world"));
        thread.sleep_ms(300);
        _ = i;
    }
    k.write_all("GET /hello?name=1 HTTP/1.1\r\nHost: x\r\n\r\nGET /hello?name=2 HTTP/1.1\r\nHost: x\r\n\r\n")!;
    let both = read_until(k, buf[..], "hello, 2")!;
    let first = must(strs.index_of(both, "hello, 1"));
    @expect(strs.starts_with(both[first + 8..], "HTTP/1.1 200 OK\r\n"));
    // a body sent in pieces, fast enough
    k.write_all("POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc")!;
    thread.sleep_ms(10);
    k.write_all("\r\n4\r\ndefg\r")!;
    thread.sleep_ms(10);
    k.write_all("\n0\r\n\r\n")!;
    @expect(strs.ends_with(read_reply(k, buf[..])!, "\r\n\r\nabcdefg"));
    let t1 = time.Instant.now();
    @expect(closed_by_server(k, buf[..]));
    @expect(ms_since(t1) >= 500);
    k.close();
    srv.stop();
    th.join();
    // a TLS handshake that never starts
    let cert = tls.test_certificate_pem()!;
    defer mem.free(cert);
    let key = tls.test_key_pem()!;
    defer mem.free(key);
    let mut scfg = tls.ServerConfig.from_pem(cert, key)!;
    defer scfg.deinit();
    opts.handshake_timeout_ms = 200;
    let mut srv2 = server_tls("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts, &scfg)!;
    let port2 = srv2.port();
    let mut th2 = thread.spawn(t_run, &mut srv2)!;
    let h = dial(port2)!;
    let t2 = time.Instant.now();
    @expect(closed_by_server(h, buf[..]));
    @expect(ms_since(t2) < 5000);
    h.close();
    srv2.stop();
    th2.join();
}

test "connection limits" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    let mut opts = Options.default();
    opts.threads = 1;
    opts.max_connections_per_addr = 3;
    let mut srv = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let mut buf: [1024]u8 = [0; 1024];
    // three from one address are served; a fourth is closed unanswered
    let mut cs: [5]net.TcpStream = [net.TcpStream.{ handle: -1 }; 5];
    for k in @as(usize, 0)..3 {
        cs[k] = dial(port)!;
        cs[k].write_all("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")!;
        @expect(strs.ends_with(read_reply(cs[k], buf[..])!, "hello, world"));
    }
    let extra = dial(port)!;
    _ = extra.write("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n") catch 0;
    @mem_set(buf[..], 0);
    @expect(closed_by_server(extra, buf[..]));
    @expect(buf[0] == 0);
    extra.close();
    // one closed, room for another (once the server has seen it close)
    cs[0].close();
    let mut served = false;
    for tries in @as(usize, 0)..100 {
        thread.sleep_ms(20);
        cs[0] = dial(port)!;
        _ = cs[0].write("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n") catch 0;
        let got = read_reply(cs[0], buf[..]) catch {
            cs[0].close();
            continue;
        };
        served = strs.ends_with(got, "hello, world");
        _ = tries;
        break;
    }
    @expect(served);
    for k in @as(usize, 0)..3 {
        cs[k].close();
    }
    srv.stop();
    th.join();

    // at max_connections, the connection idle longest makes room
    opts.max_connections_per_addr = 0;
    opts.max_connections = 4;
    let mut srv2 = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port2 = srv2.port();
    let mut th2 = thread.spawn(t_run, &mut srv2)!;
    for k in @as(usize, 0)..4 {
        cs[k] = dial(port2)!;
        cs[k].write_all("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")!;
        @expect(strs.ends_with(read_reply(cs[k], buf[..])!, "hello, world"));
        thread.sleep_ms(50);
    }
    cs[4] = dial(port2)!;
    cs[4].write_all("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")!;
    @expect(strs.ends_with(read_reply(cs[4], buf[..])!, "hello, world"));
    @expect(closed_by_server(cs[0], buf[..]));
    cs[1].write_all("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")!;
    @expect(strs.ends_with(read_reply(cs[1], buf[..])!, "hello, world"));
    for k in @as(usize, 0)..5 {
        cs[k].close();
    }
    srv2.stop();
    th2.join();
}

test "memory held by requests still arriving is bounded" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    r.post("/echo", t_echo)!;
    let mut opts = Options.default();
    opts.threads = 2;
    opts.min_body_rate = 0;
    opts.head_timeout_ms = 20000;
    opts.max_buffered_bytes = 3145728;
    let mut srv = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    // bodies of 1 MiB of a promised 2 MiB, then nothing: more than the
    // budget together
    let chunk = mem.alloc.[u8](1048576)!;
    defer mem.free(chunk);
    @mem_set(chunk, 'a');
    let mut cs: [6]net.TcpStream = [net.TcpStream.{ handle: -1 }; 6];
    for k in @as(usize, 0)..6 {
        cs[k] = dial(port)!;
        // (the server may refuse one while it is being sent)
        cs[k].write_all("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 2097152\r\n\r\n") catch {};
        cs[k].write_all(chunk) catch {};
    }
    // some are answered 503 and closed; not all of them
    let mut buf: [1024]u8 = [0; 1024];
    let mut refused: usize = 0;
    for k in @as(usize, 0)..6 {
        cs[k].set_timeout(800)!;
        @mem_set(buf[..], 0);
        if closed_by_server(cs[k], buf[..]) {
            @expect(strs.starts_with(buf[..], "HTTP/1.1 503 "));
            refused += 1;
        }
    }
    @expect((refused >= 2) and (refused < 6));
    // others are still served, bodies included
    let mut url: [128]u8 = [0; 128];
    let mut a = post(fmt.bufprint(url[..], "http://127.0.0.1:{}/echo", [fmt.int(port)])!, "text/plain", "small")!;
    @expect_eq(a.body, "small");
    a.deinit();
    for k in @as(usize, 0)..6 {
        cs[k].close();
    }
    srv.stop();
    th.join();
}

test "a body that stops after a burst is too slow" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.post("/echo", t_echo)!;
    let mut opts = Options.default();
    opts.threads = 1;
    opts.head_timeout_ms = 200;
    opts.min_body_rate = 10000;
    let mut srv = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let chunk = mem.alloc.[u8](200000)!;
    defer mem.free(chunk);
    @mem_set(chunk, 'a');
    let c = dial(port)!;
    c.write_all("POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 1000000\r\n\r\n")!;
    c.write_all(chunk)!;  // (enough for 20 s at the rate, on average)
    let t0 = time.Instant.now();
    let mut buf: [1024]u8 = [0; 1024];
    @expect(closed_by_server(c, buf[..]));
    @expect(strs.starts_with(buf[..], "HTTP/1.1 408 "));
    @expect(ms_since(t0) < 3000);
    c.close();
    srv.stop();
    th.join();
}

test "bytes between requests do not keep a connection open" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    let mut opts = Options.default();
    opts.threads = 1;
    opts.idle_timeout_ms = 600;
    let mut srv = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let c = dial(port)!;
    let mut buf: [1024]u8 = [0; 1024];
    c.write_all("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")!;
    @expect(strs.ends_with(read_reply(c, buf[..])!, "hello, world"));
    // blank lines (ignored before a request) every 150 ms
    let t0 = time.Instant.now();
    let mut gone = false;
    while ms_since(t0) < 3000 {
        thread.sleep_ms(150);
        _ = c.write("\r\n") catch {
            gone = true;
            break;
        };
        if (net.poll_one(c.handle, net.READABLE, 0) catch 0) != 0 {
            gone = (c.read(buf[..]) catch 0) == 0;
            break;
        }
    }
    @expect(gone);
    @expect(ms_since(t0) < 2000);
    c.close();
    srv.stop();
    th.join();
}

test "room is made by closing connections that have not finished a request" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    let mut opts = Options.default();
    opts.threads = 1;
    opts.max_connections = 4;
    opts.max_connections_per_addr = 0;
    opts.head_timeout_ms = 20000;
    let mut srv = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let mut buf: [1024]u8 = [0; 1024];
    // two clients served and idle, then two that send nothing
    let mut cs: [5]net.TcpStream = [net.TcpStream.{ handle: -1 }; 5];
    for k in @as(usize, 0)..2 {
        cs[k] = dial(port)!;
        cs[k].write_all("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")!;
        @expect(strs.ends_with(read_reply(cs[k], buf[..])!, "hello, world"));
    }
    cs[2] = dial(port)!;
    cs[3] = dial(port)!;
    thread.sleep_ms(100);
    // a fifth closes a silent one, not one that was served
    cs[4] = dial(port)!;
    cs[4].write_all("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")!;
    @expect(strs.ends_with(read_reply(cs[4], buf[..])!, "hello, world"));
    cs[2].set_timeout(1000)!;
    cs[3].set_timeout(1000)!;
    let a = closed_by_server(cs[2], buf[..]);
    let b = closed_by_server(cs[3], buf[..]);
    @expect(a != b);
    for k in @as(usize, 0)..2 {
        cs[k].write_all("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")!;
        @expect(strs.ends_with(read_reply(cs[k], buf[..])!, "hello, world"));
    }
    for k in @as(usize, 0)..5 {
        cs[k].close();
    }
    srv.stop();
    th.join();
}

test "HTTP/2's preface and first request have the head's deadline" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    let mut opts = Options.default();
    opts.threads = 1;
    opts.head_timeout_ms = 200;
    let mut srv = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let mut buf: [1024]u8 = [0; 1024];
    // the preface, then nothing
    let c = dial(port)!;
    c.write_all("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")!;
    let t0 = time.Instant.now();
    @expect(closed_by_server(c, buf[..]));
    @expect(ms_since(t0) < 3000);
    c.close();
    // part of the preface
    let d = dial(port)!;
    d.write_all("PRI * HTTP/2.0\r\n\r\nS")!;
    @expect(closed_by_server(d, buf[..]));
    @expect(ms_since(t0) < 6000);
    d.close();
    srv.stop();
    th.join();
}

test "many pipelined requests on one connection" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    let mut opts = Options.default();
    opts.threads = 1;
    let mut srv = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    // more than a worker serves at a turn, with another client meanwhile
    let mut many = strs.String.init();
    defer many.deinit();
    for k in @as(usize, 0)..50 {
        many.push_str("GET /hello HTTP/1.1\r\nHost: x\r\n\r\n")!;
        _ = k;
    }
    many.push_str("GET /hello?name=last HTTP/1.1\r\nHost: x\r\n\r\n")!;
    let c = dial(port)!;
    c.write_all(many.bytes())!;
    let mut url: [128]u8 = [0; 128];
    let mut a = get(fmt.bufprint(url[..], "http://127.0.0.1:{}/hello?name=other", [fmt.int(port)])!)!;
    @expect_eq(a.body, "hello, other");
    a.deinit();
    let big = mem.alloc.[u8](65536)!;
    defer mem.free(big);
    let got = read_until(c, big, "hello, last")!;
    let mut n: usize = 0;
    let mut rest = got;
    while true {
        let at = strs.index_of(rest, "HTTP/1.1 200 OK") ?? break;
        n += 1;
        rest = rest[at + 15..];
    }
    @expect_eq(n, 51);
    c.close();
    srv.stop();
    th.join();
}

fn t_size(app: *mut TestApp, req: *Request, res: *mut Response) !void {
    fmt.write(res.writer(), "{}", [fmt.int(req.body.len)])!;
}

/// A server for the tests below: t_size at /size, t_hello at /hello.
fn sized_server(r: *mut Router.[TestApp], opts: Options) !Server.[Router.[TestApp]] {
    r.post("/size", t_size)!;
    r.get("/hello", t_hello)!;
    return server("127.0.0.1", 0, Router.[TestApp].handle, r, opts);
}

/// Sends a POST of n bytes to /size on a new connection; its response.
fn post_size(port: u16, n: usize, buf: []mut u8) ![]u8 {
    let c = dial(port)!;
    defer c.close();
    let mut hb: [128]u8 = [0; 128];
    c.write_all(fmt.bufprint(hb[..], "POST /size HTTP/1.1\r\nHost: x\r\nContent-Length: {}\r\n\r\n", [fmt.int(n)])!)!;
    let chunk: [4096]u8 = [0x61; 4096];
    let mut left = n;
    while left > 0 {
        let m = @min(left, chunk.len);
        c.write_all(chunk[..m]) catch break;  // (refused early)
        left -= m;
    }
    return read_reply(c, buf);
}

test "bodies the server could never hold are refused at once" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    let mut opts = Options.default();
    opts.threads = 1;
    opts.max_body_bytes = 33554432;
    opts.max_buffered_bytes = 1048576;
    let mut srv = sized_server(&mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let mut buf: [1024]u8 = [0; 1024];
    // just under the room the budget leaves: served, on an idle server
    let n: usize = 1048576 - 65536;
    @expect(strs.ends_with(post_size(port, n, buf[..])!, "\r\n\r\n983040"));
    // more: 413 at the head, which the client gets though it sends the
    // body anyway (the server drains it before closing: a close with bytes
    // unread could reset the connection, answer and all)
    for k in @as(usize, 0)..3 {
        @expect(strs.starts_with(post_size(port, n + 1, buf[..])!, "HTTP/1.1 413 "));
        _ = k;
    }
    let c = dial(port)!;
    c.write_all("POST /size HTTP/1.1\r\nHost: x\r\nContent-Length: 16777216\r\n\r\n")!;
    @expect(strs.starts_with(read_reply(c, buf[..])!, "HTTP/1.1 413 "));
    c.close();
    srv.stop();
    th.join();
}

/// Stalled uploads, from several threads' worth of sockets.
struct Stall {
    port: u16,
    socks: [40]net.TcpStream,
    n: usize,
}

fn stall_run(st: *mut Stall) void {
    let chunk: [65536]u8 = [0x61; 65536];
    for k in @as(usize, 0)..st.n {
        st.socks[k] = dial(st.port) catch {
            st.n = k;
            return;
        };
        _ = st.socks[k].write("POST /size HTTP/1.1\r\nHost: x\r\nContent-Length: 1048576\r\n\r\n") catch 0;
        for i in @as(usize, 0)..3 {
            st.socks[k].write_all(chunk[..]) catch break;
            _ = i;
        }
    }
}

test "a fast upload is not the one that gives its memory back" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    let mut opts = Options.default();
    opts.threads = 2;
    opts.max_body_bytes = 33554432;
    opts.max_buffered_bytes = 4194304;
    opts.max_connections_per_addr = 0;
    opts.head_timeout_ms = 20000;
    opts.min_body_rate = 0;
    let mut srv = sized_server(&mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    // 30 uploads of 192 KiB each that then stall: more than the budget
    let mut st = mem.new.[Stall]()!;
    defer mem.destroy(st);
    st.port = port;
    st.n = 30;
    stall_run(st);
    thread.sleep_ms(1200);  // (long enough to count as stalled)
    // a 2 MiB upload sent at full speed still gets through
    let mut buf: [1024]u8 = [0; 1024];
    for k in @as(usize, 0)..3 {
        @expect(strs.ends_with(post_size(port, 2097152, buf[..])!, "\r\n\r\n2097152"));
        _ = k;
    }
    for k in @as(usize, 0)..st.n {
        st.socks[k].close();
    }
    srv.stop();
    th.join();
}

/// Appends an HTTP/2 frame to out.
fn h2_frame(out: *mut strs.String, ty: u8, flags: u8, id: u32, payload: []u8) !void {
    let hdr: [9]u8 = [@truncate(u8, payload.len >> 16), @truncate(u8, payload.len >> 8), @truncate(u8, payload.len), ty,
                      flags, @truncate(u8, id >> 24), @truncate(u8, id >> 16), @truncate(u8, id >> 8),
                      @truncate(u8, id)];
    out.push_str(hdr[..])!;
    out.push_str(payload)!;
}

/// A POST /size request's header block (literals, not indexed).
fn h2_post_block(out: *mut strs.String) !void {
    let fields: [8][]u8 = [":method", "POST", ":scheme", "http", ":path", "/size", ":authority", "x"];
    let mut k: usize = 0;
    while k < fields.len {
        let lens: [1]u8 = [0];
        out.push_str(lens[..])!;
        let nl: [1]u8 = [@truncate(u8, fields[k].len)];
        out.push_str(nl[..])!;
        out.push_str(fields[k])!;
        let vl: [1]u8 = [@truncate(u8, fields[k + 1].len)];
        out.push_str(vl[..])!;
        out.push_str(fields[k + 1])!;
        k += 2;
    }
}

test "HTTP/2: a reset stream does not count against the others' rate" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    let mut opts = Options.default();
    opts.threads = 1;
    opts.head_timeout_ms = 300;
    opts.min_body_rate = 1000;
    let mut srv = sized_server(&mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let c = dial(port)!;
    let mut block = strs.String.init();
    defer block.deinit();
    h2_post_block(&mut block)!;
    let mut out = strs.String.init();
    defer out.deinit();
    out.push_str("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")!;
    h2_frame(&mut out, http2.SETTINGS, 0, 0, "")!;
    // stream 1: a body, reset once the server waits for more; stream 3: a
    // body at a steady 4000 bytes per second, well over the rate
    h2_frame(&mut out, http2.HEADERS, 4, 1, block.bytes())!;  // END_HEADERS
    let big: [16000]u8 = [0x61; 16000];
    h2_frame(&mut out, http2.DATA, 0, 1, big[..])!;
    h2_frame(&mut out, http2.HEADERS, 4, 3, block.bytes())!;
    c.write_all(out.bytes())!;
    thread.sleep_ms(100);  // (the server waits: its window starts)
    out.clear();
    let cancel: [4]u8 = [0, 0, 0, 8];
    h2_frame(&mut out, http2.RST_STREAM, 0, 1, cancel[..])!;
    c.write_all(out.bytes())!;
    let piece: [200]u8 = [0x62; 200];
    for k in @as(usize, 0)..20 {
        thread.sleep_ms(50);
        out.clear();
        h2_frame(&mut out, http2.DATA, 0, 3, piece[..])!;
        c.write_all(out.bytes())!;
        _ = k;
    }
    out.clear();
    h2_frame(&mut out, http2.DATA, 1, 3, piece[..])!;  // END_STREAM
    c.write_all(out.bytes())!;
    // the answer to stream 3 (HEADERS), not a GOAWAY
    let mut buf = mem.alloc.[u8](65536)!;
    defer mem.free(buf);
    let mut n: usize = 0;
    let mut answered = false;
    let mut goaway = false;
    while not answered and not goaway {
        let got = c.read(buf[n..]) catch break;
        if got == 0 {
            break;
        }
        n += got;
        let mut at: usize = 0;
        while (n - at) >= 9 {
            let len = ((@as(usize, buf[at]) << 16) | (@as(usize, buf[at + 1]) << 8)) | @as(usize, buf[at + 2]);
            if (n - at) < (9 + len) {
                break;
            }
            let id = @as(u32, buf[at + 8]) | (@as(u32, buf[at + 7]) << 8);
            if (buf[at + 3] == http2.HEADERS) and (id == 3) {
                answered = true;
            }
            if buf[at + 3] == http2.GOAWAY {
                goaway = true;
            }
            at += 9 + len;
        }
    }
    @expect(answered and not goaway);
    c.close();
    srv.stop();
    th.join();
}
