import "../cookie.ax" as cookie;
import "../http2.ax" as http2;
import "../tls.ax" as tls;
import "std/fmt" as fmt;
import "std/io" as io;
import "std/mem" as mem;
import "std/net" as net;
import "std/os/process" as process;
import "std/str" as strs;
import "std/thread" as thread;

// -----------------------------------------------------------------------------
// Tests (axiom test lib/net/http.ax)
// -----------------------------------------------------------------------------

fn must[T](v: ?T) T {
    return v ?? {
        @trap();
    };
}

fn is_none[T](v: ?T) bool {
    if let .none = v {
        return true;
    }
    return false;
}

test "urls and encoding" {
    let u = parse_url("http://example.com:8080/a/b?x=1#frag")!;
    @expect_eq(u.hostname, "example.com");
    @expect_eq(u.port, 8080);
    @expect_eq(u.target, "/a/b?x=1");
    @expect_eq(parse_url("http://h")!.target, "/");
    @expect_eq(parse_url("http://h#frag")!.target, "/");
    @expect_eq(parse_url("http://h/p?q=1#frag")!.target, "/p?q=1");
    @expect_eq(parse_url("http://h")!.port, 80);
    @expect(not parse_url("http://h")!.secure);
    let v = parse_url("https://h.example/x")!;
    @expect(v.secure);
    @expect_eq(v.port, 443);
    @expect_eq(v.hostname, "h.example");
    @expect_eq(parse_url("https://h:8443")!.port, 8443);
    _ = parse_url("ftp://h/") catch |e| {
        @expect_eq(e, error.BadUrl);
        let mut out: [32]u8 = [0; 32];
        @expect_eq(percent_decode("a%20b+c%2F", out[..], true)!, "a b c/");
        @expect_eq(percent_decode("a+b", out[..], false)!, "a+b");
        @expect_eq(query_raw("a=1&bb=x%20y&c", "bb") ?? @trap(), "x%20y");
        @expect_eq(query_raw("a=1&bb=x%20y&c", "c") ?? @trap(), "");
        let mut s = strs.String.init();
        defer s.deinit();
        percent_encode(s.writer(), "a b/\u{e9}")!;
        @expect_eq(s.bytes(), "a%20b%2F%C3%A9");
        return;
    };
    @trap();
}

test "patterns" {
    let mut sc = new_scratch();
    defer sc.blocks.deinit();
    defer sc.clear();
    let req = Request.{
        method: "GET",
        target: "",
        path: "",
        query: "",
        version: Version.HTTP_1_1,
        headers: no_headers(),
        body: "",
        scratch: &mut sc,
    };
    @expect(match_pattern("/", "/", &mut sc)!);
    @expect(not match_pattern("/", "/x", &mut sc)!);
    @expect(match_pattern("/users/{id}", "/users/4%202", &mut sc)!);
    @expect_eq(req.param("id")!, "4 2");
    @expect(not match_pattern("/users/{id}", "/users/", &mut sc)!);
    @expect(not match_pattern("/users/{id}", "/users/1/x", &mut sc)!);
    @expect(match_pattern("/static/*", "/static/css/a.css", &mut sc)!);
    @expect_eq(req.param("*")!, "css/a.css");
    @expect(match_pattern("/a/{x}/b/{y}", "/a/1/b/2", &mut sc)!);
    @expect_eq(req.param("y")!, "2");
}

struct TestApp {
    hits: u32,
}

fn t_hello(app: *mut TestApp, req: *Request, res: *mut Response) !void {
    _ = @atomic_add(&mut app.hits, 1);
    let name = req.query_param("name") catch "world";
    fmt.write(res.writer(), "hello, {}", [fmt.str(name)])!;
}

fn t_user(app: *mut TestApp, req: *Request, res: *mut Response) !void {
    res.header("Content-Type", "application/json")!;
    fmt.write(res.writer(), "{{\"id\":\"{}\"}}", [fmt.str(req.param("id")!)])!;
}

fn t_echo(app: *mut TestApp, req: *Request, res: *mut Response) !void {
    res.set_status(201);
    res.header("X-Length", fmt.bufprint(req.scratch_mut().alloc(20)!, "{}", [fmt.int(req.body.len)])!)!;
    res.write(req.body)!;
}

fn t_big(app: *mut TestApp, req: *Request, res: *mut Response) !void {
    for i in @as(u32, 0)..10000 {
        fmt.write(res.writer(), "line {:05}\n", [fmt.int(i)])!;
    }
}

// a status without a body, and a body written and flushed anyway
fn t_no_content(app: *mut TestApp, req: *Request, res: *mut Response) !void {
    res.set_status(204);
    res.write("dropped")!;
    res.flush()!;
    res.write("dropped")!;
}

fn t_not_modified(app: *mut TestApp, req: *Request, res: *mut Response) !void {
    res.set_status(304);
    for i in @as(u32, 0)..10000 {
        fmt.write(res.writer(), "line {:05}\n", [fmt.int(i)])!;
    }
}

fn t_fail(app: *mut TestApp, req: *Request, res: *mut Response) !void {
    res.write("partial")!;
    return error.NotFound;
}

fn t_run(s: *mut Server.[Router.[TestApp]]) void {
    s.run() catch @trap();
}

/// Sends raw bytes and reads until the server closes the connection.
fn raw_exchange(port: u16, text: []u8) ![]mut u8 {
    let st = net.connect("127.0.0.1", port)!;
    defer st.close();
    st.write_all(text)!;
    return st.reader().read_all();
}

test "server and client" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    r.get("/users/{id}", t_user)!;
    r.post("/echo", t_echo)!;
    r.get("/big", t_big)!;
    r.get("/fail", t_fail)!;
    r.get("/nocontent", t_no_content)!;
    r.get("/notmodified", t_not_modified)!;
    let mut opts = Options.default();
    opts.threads = 2;
    opts.max_head_bytes = 4096;
    let mut srv = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let mut ub: [64]u8 = [0; 64];
    let base = fmt.bufprint(ub[..], "http://127.0.0.1:{}", [fmt.int(port)])!;
    let mut url: [128]u8 = [0; 128];

    let mut a = get(fmt.bufprint(url[..], "{}/hello?name=A%20B", [fmt.str(base)])!)!;
    @expect_eq(a.status, 200);
    @expect_eq(a.reason, "OK");
    @expect_eq(a.body, "hello, A B");
    @expect_eq(must(a.header("content-type")), "text/plain; charset=utf-8");
    @expect(is_none(a.header("x-missing")));
    @expect(is_none(find_header(no_headers(), "Host")));
    a.deinit();

    let mut b = get(fmt.bufprint(url[..], "{}/users/42", [fmt.str(base)])!)!;
    @expect_eq(b.body, "{\"id\":\"42\"}");
    @expect_eq(must(b.header("Content-Type")), "application/json");
    b.deinit();

    let mut c = post(fmt.bufprint(url[..], "{}/echo", [fmt.str(base)])!, "text/plain", "some data")!;
    @expect_eq(c.status, 201);
    @expect_eq(c.body, "some data");
    @expect_eq(must(c.header("x-length")), "9");
    c.deinit();

    let mut d = get(fmt.bufprint(url[..], "{}/nope", [fmt.str(base)])!)!;
    @expect_eq(d.status, 404);
    d.deinit();
    let mut e = post(fmt.bufprint(url[..], "{}/hello", [fmt.str(base)])!, "text/plain", "")!;
    @expect_eq(e.status, 405);
    @expect_eq(must(e.header("Allow")), "GET");
    e.deinit();

    // streamed (chunked) response
    let mut f = get(fmt.bufprint(url[..], "{}/big", [fmt.str(base)])!)!;
    @expect_eq(f.body.len, 110000);
    @expect_eq(must(f.header("Transfer-Encoding")), "chunked");
    @expect(strs.ends_with(f.body, "line 09999\n"));
    f.deinit();

    let mut g = get(fmt.bufprint(url[..], "{}/fail", [fmt.str(base)])!)!;
    @expect_eq(g.status, 500);
    @expect_eq(g.body, "Internal Server Error\n");
    g.deinit();

    // pipelining and keep-alive on one connection, HEAD, a chunked upload
    let out = raw_exchange(port,
                           "GET /hello HTTP/1.1\r\nHost: x\r\n\r\nHEAD /hello?name=z HTTP/1.1\r\nHost: x\r\n\r\nPOST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nabc\r\n2;ext=1\r\nde\r\n0\r\n\r\n")!;
    defer mem.free(out);
    @expect_eq(strs.count(out, "HTTP/1.1 200 OK"), 2);
    @expect_eq(strs.count(out, "hello, world"), 1);
    @expect(strs.contains(out, "Content-Length: 8\r\n"));
    @expect(strs.contains(out, "HTTP/1.1 201 Created"));
    @expect(strs.ends_with(out, "\r\n\r\nabcde"));
    @expect(strs.contains(out, "Connection: close"));

    // a status without a body, flushed or streamed, and HEAD of a streamed
    // body: heads alone, so keep-alive stays in step
    let o13 = raw_exchange(port,
                           "GET /nocontent HTTP/1.1\r\nHost: x\r\n\r\nGET /notmodified HTTP/1.1\r\nHost: x\r\n\r\nHEAD /big HTTP/1.1\r\nHost: x\r\n\r\nGET /users/9 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")!;
    defer mem.free(o13);
    @expect(strs.starts_with(o13, "HTTP/1.1 204 No Content\r\n"));
    @expect(strs.contains(o13, "\r\n\r\nHTTP/1.1 304 "));
    @expect(strs.contains(o13, "\r\n\r\nHTTP/1.1 200 OK\r\n"));
    @expect_eq(strs.count(o13, "HTTP/1.1 "), 4);
    @expect_eq(strs.count(o13, "Transfer-Encoding"), 1);
    @expect(not strs.contains(o13, "dropped") and not strs.contains(o13, "line ") and
            not strs.contains(o13, "0\r\n\r\n"));
    @expect(strs.ends_with(o13, "\r\n\r\n{\"id\":\"9\"}"));

    // HTTP/1.0 closes by default
    let o2 = raw_exchange(port, "GET /users/7 HTTP/1.0\r\n\r\n")!;
    defer mem.free(o2);
    @expect(strs.starts_with(o2, "HTTP/1.0 200 OK\r\n"));
    @expect(strs.ends_with(o2, "{\"id\":\"7\"}"));

    // malformed and oversized requests
    let o3 = raw_exchange(port, "GARBAGE\r\n\r\n")!;
    defer mem.free(o3);
    @expect(strs.starts_with(o3, "HTTP/1.1 400 Bad Request"));
    let o4 = raw_exchange(port, "GET / HTTP/1.1\r\n\r\n")!;
    defer mem.free(o4);
    @expect(strs.starts_with(o4, "HTTP/1.1 400 "));
    let huge = strs.repeat("X-Filler: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n", 100)!;
    defer mem.free(huge);
    let req_text = strs.concat("GET / HTTP/1.1\r\nHost: x\r\n", huge)!;
    defer mem.free(req_text);
    let o5 = raw_exchange(port, req_text)!;
    defer mem.free(o5);
    @expect(strs.starts_with(o5, "HTTP/1.1 431 "));
    let o6 = raw_exchange(port, "GET / HTTP/2.0\r\nHost: x\r\n\r\n")!;
    defer mem.free(o6);
    @expect(strs.starts_with(o6, "HTTP/1.1 505 "));
    let o7 = raw_exchange(port,
                          "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n")!;
    defer mem.free(o7);
    @expect(strs.starts_with(o7, "HTTP/1.1 400 "));

    // framing that a proxy could read differently is refused (request smuggling)
    let smuggles: [16][]u8 = [
        "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: +3\r\n\r\nabc",
        "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 3 3\r\n\r\nabc",
        "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: \x0bchunked\r\n\r\n0\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n 3\r\nabc\r\n0\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\nFFFFFFFFFFFFFFFFFF\r\n",
        "POST /echo HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n",
        "GET /hello HTTP/1.1\r\nHost: x\r\nHost: y\r\n\r\n",
        "GET /hello HTTP/1.1\r\nHost: x\r\nX-A: a\rb\r\n\r\n",
        "GET /hello HTTP/1.1\r\nHost: x\r\nX-A: a\x00b\r\n\r\n",
        // chunked lines without their CR, control bytes or bad syntax in a
        // chunk extension, a trailer that is not a header
        "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\nabc\r\n0\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\n0\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3;x=\x00\rq\r\nabc\r\n0\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3;x=\"a\x01\"\r\nabc\r\n0\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3;=1\r\nabc\r\n0\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\nX-T: \x01\x7f\r\n\r\n",
        "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\nnot a header\r\n\r\n",
    ];
    for sm in smuggles {
        let o = raw_exchange(port, sm)!;
        defer mem.free(o);
        @expect(strs.starts_with(o, "HTTP/1.1 4") or strs.starts_with(o, "HTTP/1.1 501"));
    }
    let o12 = raw_exchange(port,
                           "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3 ; a=\"b \\\" c\";d\r\nabc\r\n0\r\nX-T: v\r\n\r\n")!;
    defer mem.free(o12);
    @expect(strs.starts_with(o12, "HTTP/1.1 201 ") and strs.ends_with(o12, "abc"));
    // route parameters cannot climb out of their place
    let o8 = raw_exchange(port, "GET /users/..%2Fetc HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")!;
    defer mem.free(o8);
    @expect(strs.starts_with(o8, "HTTP/1.1 404 "));
    let o9 = raw_exchange(port, "GET /users/%2E%2E HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")!;
    defer mem.free(o9);
    @expect(strs.starts_with(o9, "HTTP/1.1 404 "));
    let o10 = raw_exchange(port, "GET /users/..%5C..%5Cetc HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")!;
    defer mem.free(o10);
    @expect(strs.starts_with(o10, "HTTP/1.1 404 "));
    let o11 = raw_exchange(port, "GET /users/C%3Asecret HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")!;
    defer mem.free(o11);
    @expect(strs.starts_with(o11, "HTTP/1.1 404 "));
    // the client will not send requests its caller could have split
    let bad_url = fmt.bufprint(url[..], "{}/a HTTP/1.1\r\nX: 1\r\n\r\nGET /b", [fmt.str(base)])!;
    @expect(failed_get(bad_url));
    let hdrs: [1]Header = [Header.{ name: "X-Evil", value: "1\r\nContent-Length: 0" }];
    @expect(failed_req("GET", fmt.bufprint(url[..], "{}/hello", [fmt.str(base)])!, hdrs[..], "",
                       ClientOptions.default()));
    let hdrs2: [1]Header = [Header.{ name: "Transfer-Encoding", value: "chunked" }];
    @expect(failed_req("GET", fmt.bufprint(url[..], "{}/hello", [fmt.str(base)])!, hdrs2[..], "",
                       ClientOptions.default()));
    @expect(failed_get("http://internal\x00.example.com/"));

    @expect_eq(@atomic_load(&app.hits), 3);
    srv.stop();
    th.join();
}

fn failed_get(url: []u8) bool {
    let mut v = get(url) catch return true;
    v.deinit();
    return false;
}

fn failed_req(method: []u8, url: []u8, headers: []Header, body: []u8, opts: ClientOptions) bool {
    let mut v = request(method, url, headers, body, opts) catch return true;
    v.deinit();
    return false;
}

test "https" {
    let cert = tls.test_certificate_pem()!;
    defer mem.free(cert);
    let key = tls.test_key_pem()!;
    defer mem.free(key);
    let mut scfg = tls.ServerConfig.from_pem(cert, key)!;
    defer scfg.deinit();
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    r.post("/echo", t_echo)!;
    r.get("/big", t_big)!;
    let mut opts = Options.default();
    opts.threads = 2;
    let mut srv = server_tls("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts, &scfg)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let mut ccfg = tls.ClientConfig.with_roots_pem(cert)!;
    defer ccfg.deinit();
    let copts = ClientOptions.default().with_tls(&ccfg);
    let mut url: [128]u8 = [0; 128];

    let mut a = request("GET", fmt.bufprint(url[..], "https://localhost:{}/hello?name=tls", [fmt.int(port)])!,
                        no_headers(), "", copts)!;
    @expect_eq(a.status, 200);
    @expect_eq(a.body, "hello, tls");
    a.deinit();

    let mut b = request("POST", fmt.bufprint(url[..], "https://127.0.0.1:{}/echo", [fmt.int(port)])!, no_headers(),
                        "over tls", copts)!;
    @expect_eq(b.status, 201);
    @expect_eq(b.body, "over tls");
    b.deinit();

    let mut c = request("GET", fmt.bufprint(url[..], "https://localhost:{}/big", [fmt.int(port)])!, no_headers(), "",
                        copts)!;
    @expect_eq(c.body.len, 110000);
    c.deinit();

    // a client that doesn't trust the certificate; plain HTTP to a TLS port
    let mut other = tls.ClientConfig.with_roots_pem("")!;
    defer other.deinit();
    @expect(fails(request("GET", fmt.bufprint(url[..], "https://localhost:{}/hello", [fmt.int(port)])!, no_headers(),
                          "", ClientOptions.default().with_tls(&other))));
    // the system's roots don't include it either
    @expect(fails(get(fmt.bufprint(url[..], "https://localhost:{}/hello", [fmt.int(port)])!)));
    let mut plain_opts = ClientOptions.default();
    plain_opts.timeout_ms = 5000;
    @expect(fails(request("GET", fmt.bufprint(url[..], "http://localhost:{}/hello", [fmt.int(port)])!, no_headers(), "",
                          plain_opts)));

    srv.stop();
    th.join();
}

fn fails[T](r: !T) bool {
    _ = r catch return true;
    return false;
}

fn stream_read(ctx: *mut void, buf: []mut u8) HttpError!usize {
    let t = @ptr_cast(*mut net.TcpStream, ctx);
    return t.read(buf)!;
}

fn stream_write(ctx: *mut void, bytes: []u8) HttpError!usize {
    let t = @ptr_cast(*mut net.TcpStream, ctx);
    return t.write(bytes)!;
}

test "HTTP/2" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    r.post("/echo", t_echo)!;
    r.get("/big", t_big)!;
    let mut opts = Options.default();
    opts.threads = 2;
    opts.max_body_bytes = 8388608;
    let mut srv = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let mut url: [128]u8 = [0; 128];
    let h2 = ClientOptions.default().with_http2();
    // prior knowledge, on a plain connection
    let mut a = request("GET", fmt.bufprint(url[..], "http://127.0.0.1:{}/hello?name=h2", [fmt.int(port)])!,
                        no_headers(), "", h2)!;
    @expect_eq(a.status, 200);
    @expect_eq(a.body, "hello, h2");
    @expect_eq(must(a.header("content-type")), "text/plain; charset=utf-8");
    a.deinit();
    let mut c = request("GET", fmt.bufprint(url[..], "http://127.0.0.1:{}/big", [fmt.int(port)])!, no_headers(), "",
                        h2)!;
    @expect_eq(c.body.len, 110000);
    c.deinit();
    // a body bigger than the windows: flow control has to open them
    let big = mem.alloc.[u8](3000000)!;
    defer mem.free(big);
    for k in @as(usize, 0)..big.len {
        big[k] = @truncate(u8, k * 13);
    }
    let mut e = request("POST", fmt.bufprint(url[..], "http://127.0.0.1:{}/echo", [fmt.int(port)])!, no_headers(), big,
                        h2)!;
    @expect(e.status == 201);
    @expect(@mem_eq(e.body, big));
    @expect_eq(must(e.header("x-length")), "3000000");
    e.deinit();
    // several requests on one connection
    let mut tcp = net.connect("127.0.0.1", port)!;
    let rd = io.Reader.{ ctx: @ptr_cast(*mut void, &mut tcp), read_fn: stream_read };
    let wr = io.Writer.{ ctx: @ptr_cast(*mut void, &mut tcp), write_fn: stream_write };
    let mut cl = http2.Client.init(rd, wr, "127.0.0.1", "http")!;
    for k in @as(usize, 0)..5 {
        let mut resp = cl.request("GET", "/hello?name=again", [], "")!;
        @expect((resp.status == 200) and strs.eq(resp.body, "hello, again"));
        resp.deinit();
        _ = k;
    }
    let mut nf = cl.request("GET", "/nowhere", [], "")!;
    @expect(nf.status == 404);
    nf.deinit();
    cl.deinit();
    tcp.close();
    // curl, where it is installed (nghttp2's HTTP/2)
    let cargs: [6][]u8 = ["curl", "-s", "--http2-prior-knowledge", "-w", " %{http_version}",
                          fmt.bufprint(url[..], "http://127.0.0.1:{}/hello?name=curl", [fmt.int(port)])!];
    let mut out = process.run(cargs[..]) catch process.Output.{ status: process.Status.{ code: -1, signal: 0 },
                                                                stdout: mem.alloc.[u8](0)!,
                                                                stderr: mem.alloc.[u8](0)! };
    if out.status.success() {
        @expect_eq(out.stdout, "hello, curl 2");
    }
    out.deinit();
    srv.stop();
    th.join();
}

let H2_SERVER_ALPN: [2][]u8 = ["h2", "http/1.1"];

test "HTTP/2 over TLS" {
    let cert = tls.test_certificate_pem()!;
    defer mem.free(cert);
    let key = tls.test_key_pem()!;
    defer mem.free(key);
    let mut scfg = tls.ServerConfig.from_pem(cert, key)!;
    defer scfg.deinit();
    scfg.alpn = H2_SERVER_ALPN[..];
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/hello", t_hello)!;
    let mut opts = Options.default();
    opts.threads = 2;
    let mut srv = server_tls("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts, &scfg)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let mut ccfg = tls.ClientConfig.with_roots_pem(cert)!;
    defer ccfg.deinit();
    let mut url: [128]u8 = [0; 128];
    // with and without h2 offered
    let mut a = request("GET", fmt.bufprint(url[..], "https://localhost:{}/hello?name=alpn", [fmt.int(port)])!,
                        no_headers(), "", ClientOptions.default().with_tls(&ccfg).with_http2())!;
    @expect_eq(a.body, "hello, alpn");
    a.deinit();
    let mut b = request("GET", fmt.bufprint(url[..], "https://localhost:{}/hello?name=h1", [fmt.int(port)])!,
                        no_headers(), "", ClientOptions.default().with_tls(&ccfg))!;
    @expect_eq(b.body, "hello, h1");
    b.deinit();
    let cargs2: [6][]u8 = ["curl", "-sk", "--http2", "-w", " %{http_version}",
                           fmt.bufprint(url[..], "https://localhost:{}/hello?name=curl", [fmt.int(port)])!];
    let mut out = process.run(cargs2[..]) catch process.Output.{ status: process.Status.{ code: -1, signal: 0 },
                                                                 stdout: mem.alloc.[u8](0)!,
                                                                 stderr: mem.alloc.[u8](0)! };
    if out.status.success() {
        @expect_eq(out.stdout, "hello, curl 2");
    }
    out.deinit();
    srv.stop();
    th.join();
}

fn t_login(app: *mut TestApp, req: *Request, res: *mut Response) HttpError!void {
    res.set_status(302);
    res.header("Location", "/home?x=1")!;
    res.header("Set-Cookie", "sid=xyz; Path=/; HttpOnly")!;
    res.header("Set-Cookie", "theme=dark")!;  // path /, from "/login"
}

fn t_home(app: *mut TestApp, req: *Request, res: *mut Response) !void {
    fmt.write(res.writer(), "cookie={}", [fmt.str(req.header("Cookie") ?? "none")])!;
}

fn t_see_other(app: *mut TestApp, req: *Request, res: *mut Response) HttpError!void {
    res.set_status(303);
    res.header("Location", "method")!;
}

fn t_method(app: *mut TestApp, req: *Request, res: *mut Response) !void {
    fmt.write(res.writer(), "{} {}", [fmt.str(req.method), fmt.int(req.body.len)])!;
}

fn t_loop(app: *mut TestApp, req: *Request, res: *mut Response) HttpError!void {
    res.set_status(302);
    res.header("Location", "/loop")!;
}

fn t_temporary(app: *mut TestApp, req: *Request, res: *mut Response) !void {
    res.set_status(307);
    let loc = fmt.bufprint(req.scratch_mut().alloc(300)!, "http://{}/method", [fmt.str(must(req.header("Host")))])!;
    res.header("Location", loc)!;
}

test "redirects and cookies" {
    let mut app = TestApp.{ hits: 0 };
    let mut r = Router.[TestApp].init(&mut app);
    defer r.deinit();
    r.get("/login", t_login)!;
    r.get("/home", t_home)!;
    r.post("/see", t_see_other)!;
    r.get("/method", t_method)!;
    r.post("/method", t_method)!;
    r.get("/loop", t_loop)!;
    r.post("/temporary", t_temporary)!;
    let mut opts = Options.default();
    opts.threads = 2;
    let mut srv = server("127.0.0.1", 0, Router.[TestApp].handle, &mut r, opts)!;
    let port = srv.port();
    let mut th = thread.spawn(t_run, &mut srv)!;
    let mut url: [128]u8 = [0; 128];

    let mut jar = cookie.Jar.init();
    defer jar.deinit();
    let copts = ClientOptions.default().with_cookies(&mut jar);
    let mut a = request("GET", fmt.bufprint(url[..], "http://127.0.0.1:{}/login", [fmt.int(port)])!, no_headers(), "",
                        copts)!;
    @expect_eq(a.status, 200);
    @expect_eq(a.body, "cookie=sid=xyz; theme=dark");
    a.deinit();
    @expect_eq(jar.len(), 2);
    // a Cookie header of the caller's goes first
    let hs: [1]Header = [Header.{ name: "Cookie", value: "mine=1" }];
    let mut a2 = request("GET", fmt.bufprint(url[..], "http://127.0.0.1:{}/home", [fmt.int(port)])!, hs[..], "",
                         copts)!;
    @expect_eq(a2.body, "cookie=mine=1; sid=xyz; theme=dark");
    a2.deinit();
    // without following
    let mut b = request("GET", fmt.bufprint(url[..], "http://127.0.0.1:{}/login", [fmt.int(port)])!, no_headers(), "",
                        ClientOptions.default().with_redirects(0))!;
    @expect_eq(b.status, 302);
    @expect_eq(must(b.header("Location")), "/home?x=1");
    b.deinit();
    // 303 turns a POST into a GET; 307 keeps it
    let mut c = request("POST", fmt.bufprint(url[..], "http://127.0.0.1:{}/see", [fmt.int(port)])!, no_headers(),
                        "body", ClientOptions.default())!;
    @expect_eq(c.body, "GET 0");
    c.deinit();
    let mut d = request("POST", fmt.bufprint(url[..], "http://127.0.0.1:{}/temporary", [fmt.int(port)])!, no_headers(),
                        "body", ClientOptions.default())!;
    @expect_eq(d.body, "POST 4");
    d.deinit();
    // a loop ends with the last redirect
    let mut e = request("GET", fmt.bufprint(url[..], "http://127.0.0.1:{}/loop", [fmt.int(port)])!, no_headers(), "",
                        ClientOptions.default().with_redirects(3))!;
    @expect_eq(e.status, 302);
    e.deinit();
    srv.stop();
    th.join();
}

struct FakeProxy {
    l: net.TcpListener,
    tls_cfg: *tls.ServerConfig,
    tunnel: bool,
    head: [2048]u8,
    head_len: usize,
}

fn read_head_bytes(r: io.Reader, buf: []mut u8) usize {
    let mut n: usize = 0;
    while n < buf.len {
        let k = r.read(buf[n..n + 1]) catch return n;
        if k == 0 {
            return n;
        }
        n += 1;
        if (n >= 4) and strs.eq(buf[n - 4..n], "\r\n\r\n") {
            return n;
        }
    }
    return n;
}

fn fake_proxy_run(p: *mut FakeProxy) void {
    let mut s = p.l.accept() catch @trap();
    p.head_len = read_head_bytes(s.reader(), p.head[..]);
    if p.tunnel {
        s.write_all("HTTP/1.1 200 Connection established\r\n\r\n") catch @trap();
        let c = tls.server(s, p.tls_cfg) catch @trap();
        let mut inner: [2048]u8 = [0; 2048];
        let r = io.Reader.{ ctx: @ptr_cast(*mut void, c), read_fn: tls_conn_read };
        _ = read_head_bytes(r, inner[..]);
        c.write_all("HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\ntunnel") catch @trap();
        c.close();
        return;
    }
    let mut out = strs.String.init();
    defer out.deinit();
    fmt.write(out.writer(), "HTTP/1.1 200 OK\r\nContent-Length: {}\r\n\r\n{}",
              [fmt.int(p.head_len), fmt.str(p.head[..p.head_len])]) catch @trap();
    s.write_all(out.bytes()) catch @trap();
    s.close();
}

fn tls_conn_read(ctx: *mut void, buf: []mut u8) !usize {
    let c = @ptr_cast(*mut tls.Conn, ctx);
    return c.read(buf);
}

test "proxy credentials too long for the header are refused" {
    let mut long: [300]u8 = [0; 300];
    @mem_set(long[..], 'u');
    let mut buf: [600]u8 = [0; 600];
    let pa = ProxyAddr.{ hostname: "proxy", port: 8080, user: long[..], password: "pw", has_auth: true };
    _ = proxy_basic_auth(pa, buf[..]) catch |e| {
        @expect_eq(e, error.BadUrl);
        return;
    };
    @expect(false);
}

test "proxies" {
    // which requests go through which proxy
    let mut p = Proxy.init("http://px:3128", "px2:8080", "internal.example, .corp.test,  b.test:8443")!;
    defer p.deinit();
    @expect_eq(p.url_for(parse_url("http://example.com/")!), "http://px:3128");
    @expect_eq(p.url_for(parse_url("https://example.com/")!), "px2:8080");
    @expect_eq(p.url_for(parse_url("http://internal.example/")!), "");
    @expect_eq(p.url_for(parse_url("http://a.internal.example/")!), "");
    @expect_eq(p.url_for(parse_url("http://notinternal.example/")!), "http://px:3128");
    @expect_eq(p.url_for(parse_url("http://x.corp.test/")!), "");
    @expect_eq(p.url_for(parse_url("https://b.test:8443/")!), "");
    @expect_eq(p.url_for(parse_url("https://b.test/")!), "px2:8080");
    @expect_eq(p.url_for(parse_url("http://localhost:8080/")!), "");
    @expect_eq(p.url_for(parse_url("http://127.0.0.1/")!), "");
    let mut all = Proxy.init("http://px", "", "*")!;
    defer all.deinit();
    @expect_eq(all.url_for(parse_url("http://example.com/")!), "");
    @expect(fails(Proxy.to("https://secure-proxy:443")));
    @expect(fails(Proxy.to("http://")));
    @expect(fails(Proxy.to("bad host:1")));
    let a = parse_proxy_url("http://us%40er:p%3Ass@px:3128")!;
    @expect_eq(a.port, 3128);
    let mut ab: [128]u8 = [0; 128];
    @expect_eq(proxy_basic_auth(a, ab[..])!, "Basic dXNAZXI6cDpzcw==");  // base64("us@er:p:ss")
    let b = parse_proxy_url("user:pass@px")!;
    @expect(b.has_auth and (b.port == 80));
    @expect_eq(proxy_basic_auth(b, ab[..])!, "Basic dXNlcjpwYXNz");

    // http:// through a proxy: the absolute form, with credentials
    let mut fp = FakeProxy.{ l: net.listen("127.0.0.1", 0)!, tls_cfg: @ptr_from_int(*tls.ServerConfig, 8),
                             tunnel: false, head: [0; 2048], head_len: 0 };
    let mut pu: [64]u8 = [0; 64];
    let mut px = Proxy.to(fmt.bufprint(pu[..], "http://user:pass@127.0.0.1:{}", [fmt.int(fp.l.port())])!)!;
    defer px.deinit();
    let mut th = thread.spawn(fake_proxy_run, &mut fp)!;
    let mut r = request("GET", "http://example.test:81/x?y=1", no_headers(), "",
                        ClientOptions.default().with_proxy(&px))!;
    th.join();
    fp.l.close();
    @expect(strs.starts_with(r.body, "GET http://example.test:81/x?y=1 HTTP/1.1\r\nHost: example.test:81\r\n"));
    @expect(strs.contains(r.body, "\r\nProxy-Authorization: Basic dXNlcjpwYXNz\r\n"));
    r.deinit();

    // https:// through a tunnel (the fake proxy is the TLS server too)
    let cert = tls.test_certificate_pem()!;
    defer mem.free(cert);
    let key = tls.test_key_pem()!;
    defer mem.free(key);
    let mut scfg = tls.ServerConfig.from_pem(cert, key)!;
    defer scfg.deinit();
    let mut fp2 = FakeProxy.{ l: net.listen("127.0.0.1", 0)!, tls_cfg: &scfg, tunnel: true, head: [0; 2048],
                              head_len: 0 };
    let mut px2 = Proxy.to(fmt.bufprint(pu[..], "127.0.0.1:{}", [fmt.int(fp2.l.port())])!)!;
    defer px2.deinit();
    let mut ccfg = tls.ClientConfig.insecure();
    defer ccfg.deinit();
    let mut th2 = thread.spawn(fake_proxy_run, &mut fp2)!;
    let mut t = request("GET", "https://tunnelled.test/", no_headers(), "",
                        ClientOptions.default().with_proxy(&px2).with_tls(&ccfg))!;
    th2.join();
    fp2.l.close();
    @expect_eq(t.body, "tunnel");
    @expect(strs.starts_with(fp2.head[..fp2.head_len],
                             "CONNECT tunnelled.test:443 HTTP/1.1\r\nHost: tunnelled.test:443\r\n"));
    t.deinit();
}
