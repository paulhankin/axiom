// =============================================================================
// lib/encoding/yaml/writer.ax - Writing json.Value trees as block-style YAML, part of lib/encoding/yaml.
// =============================================================================

import "std/encoding/json" as json;
import "std/fmt" as fmt;
import "std/io" as io;
import "std/str" as strs;

// -----------------------------------------------------------------------------
// Writing
// -----------------------------------------------------------------------------

fn to_yaml_write_error(e: error) YamlError {
    if e == error.TooDeep {
        return error.TooDeep;
    }
    if e == error.OutOfMemory {
        return error.OutOfMemory;
    }
    if e == error.NoSpaceLeft {
        return error.NoSpaceLeft;
    }
    if e == error.BadFormat {
        return error.BadFormat;
    }
    return error.IoError;
}

fn nonempty_collection(v: json.Value) bool {
    match v {
        .Array(xs)  => { return xs.len > 0; }
        .Object(ms) => { return ms.len > 0; }
        else        => { return false; }
    }
}

fn indent_to(w: io.Writer, n: usize) !void {
    for _k in @as(usize, 0)..n {
        w.write_all(" ")!;
    }
}

// v, starting where a block node may begin, at column ind.
fn write_block(w: io.Writer, v: json.Value, ind: usize, depth: usize) !void {
    if depth > MAX_DEPTH {
        return error.TooDeep;
    }
    match v {
        .Object(ms) => {
            if ms.len == 0 {
                w.write_all("{}\n")!;
                return;
            }
            for k in @as(usize, 0)..ms.len {
                if k > 0 {
                    indent_to(w, ind)!;
                }
                write_key(w, ms[k].key, ind)!;
                let x = ms[k].value;
                if nonempty_collection(x) {
                    w.write_all("\n")!;
                    indent_to(w, ind + 2)!;
                    write_block(w, x, ind + 2, depth + 1)!;
                } else {
                    w.write_all(" ")!;
                    write_block(w, x, ind + 2, depth + 1)!;
                }
            }
        }
        .Array(xs) => {
            if xs.len == 0 {
                w.write_all("[]\n")!;
                return;
            }
            for k in @as(usize, 0)..xs.len {
                if k > 0 {
                    indent_to(w, ind)!;
                }
                w.write_all("- ")!;
                write_block(w, xs[k], ind + 2, depth + 1)!;
            }
        }
        .Null => { w.write_all("null\n")!; }
        .Bool(b) => {
            if b {
                w.write_all("true\n")!;
            } else {
                w.write_all("false\n")!;
            }
        }
        .Int(i) => {
            let mut buf: [32]u8 = [0; 32];
            w.write_all(fmt.format_int(buf[..], i))!;
            w.write_all("\n")!;
        }
        .Float(x) => {
            if x != x {
                w.write_all(".nan\n")!;
            } else if x == (1.0 / 0.0) {
                w.write_all(".inf\n")!;
            } else if x == (-1.0 / 0.0) {
                w.write_all("-.inf\n")!;
            } else {
                let mut buf: [40]u8 = [0; 40];
                let t = fmt.format_float(buf[..], x) catch return error.NoSpaceLeft;
                w.write_all(t)!;
                if (strs.index_of_any(t, ".eE") ?? 999) == 999 {
                    w.write_all(".0")!;
                }
                w.write_all("\n")!;
            }
        }
        .String(t) => {
            write_scalar_text(w, t)!;
            w.write_all("\n")!;
        }
    }
}

// A mapping's key and its ":", at column ind: an implicit key ("key:") when
// it is short enough to be one, an explicit one ("? key" and ":" on the
// next line) otherwise.
fn write_key(w: io.Writer, key: []u8, ind: usize) !void {
    // the text is at most 4 bytes for each of the key's, and 2 quotes
    if key.len <= ((MAX_IMPLICIT_KEY - 2) / 4) {
        write_scalar_text(w, key)!;
        w.write_all(":")!;
        return;
    }
    let mut text = strs.String.init();
    defer text.deinit();
    write_scalar_text(text.writer(), key)!;
    if text.len() <= MAX_IMPLICIT_KEY {
        w.write_all(text.bytes())!;
        w.write_all(":")!;
        return;
    }
    w.write_all("? ")!;
    w.write_all(text.bytes())!;
    w.write_all("\n")!;
    indent_to(w, ind)!;
    w.write_all(":")!;
}

// Whether t can be written plain and read back as the same string.
fn plain_ok(t: []u8) bool {
    if (t.len == 0) or is_blank(t[0]) or is_blank(t[t.len - 1]) {
        return false;
    }
    match plain_value(t) {
        .String(_x) => {}
        else => { return false; }
    }
    let c0 = t[0];
    if (strs.index_of_byte("-?:,[]{}#&*!|>'\"%@`", c0) ?? 99) != 99 {
        return false;
    }
    for k in @as(usize, 0)..t.len {
        let c = t[k];
        if (c < 0x20) or (c == 0x7f) {
            return false;
        }
        // U+FEFF (a byte order mark, dropped when read) and the C1 controls
        // other than U+0085 are not printable
        if (c == 0xc2) and ((k + 1) < t.len) and (t[k + 1] >= 0x80) and (t[k + 1] <= 0x9f) and (t[k + 1] != 0x85) {
            return false;
        }
        if (c == 0xef) and ((k + 2) < t.len) and (t[k + 1] == 0xbb) and (t[k + 2] == 0xbf) {
            return false;
        }
        if ((c == ':') and (((k + 1) == t.len) or (t[k + 1] == ' '))) or ((c == '#') and (t[k - 1] == ' ')) {
            return false;
        }
    }
    return strs.valid_utf8(t) and not strs.eq(t, "---") and not strs.eq(t, "...");
}

fn write_scalar_text(w: io.Writer, t: []u8) !void {
    if plain_ok(t) {
        w.write_all(t)!;
        return;
    }
    let digits = "0123456789ABCDEF";
    w.write_all("\"")!;
    let mut i: usize = 0;
    while i < t.len {
        let c = t[i];
        i += 1;
        if (c == 0xc2) and (i < t.len) and (t[i] >= 0x80) and (t[i] <= 0x9f) and (t[i] != 0x85) {
            // a C1 control, U+0080 to U+009F
            let e: [4]u8 = ['\\', 'x', digits[@as(usize, t[i] >> 4)], digits[@as(usize, t[i] & 15)]];
            w.write_all(e[..])!;
            i += 1;
        } else if (c == 0xef) and ((i + 1) < t.len) and (t[i] == 0xbb) and (t[i + 1] == 0xbf) {
            w.write_all("\\uFEFF")!;
            i += 2;
        } else if c == '"' {
            w.write_all("\\\"")!;
        } else if c == '\\' {
            w.write_all("\\\\")!;
        } else if c == '\n' {
            w.write_all("\\n")!;
        } else if c == '\t' {
            w.write_all("\\t")!;
        } else if (c < 0x20) or (c == 0x7f) {
            let e: [4]u8 = ['\\', 'x', digits[@as(usize, c >> 4)], digits[@as(usize, c & 15)]];
            w.write_all(e[..])!;
        } else {
            let b: [1]u8 = [c];
            w.write_all(b[..])!;
        }
    }
    w.write_all("\"")!;
}
