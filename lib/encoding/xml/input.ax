// =============================================================================
// lib/encoding/xml/input.ax - Character classes, input encoding decoding,
// line-end normalization, and XML declaration parsing, part of lib/encoding/xml.
// =============================================================================

import "std/collections/arena" as arena;
import "std/diag" as diag;
import "std/str" as strs;

// -----------------------------------------------------------------------------
// Characters and names
// -----------------------------------------------------------------------------

fn is_char(c: u32) bool {
    return (c == 0x9) or (c == 0xa) or (c == 0xd) or ((c >= 0x20) and (c <= 0xd7ff)) or
           ((c >= 0xe000) and (c <= 0xfffd)) or ((c >= 0x10000) and (c <= 0x10ffff));
}

fn is_name_start(c: u32) bool {
    if c < 0x80 {
        return ((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z')) or (c == '_') or (c == ':');
    }
    return ((c >= 0xc0) and (c <= 0xd6)) or ((c >= 0xd8) and (c <= 0xf6)) or ((c >= 0xf8) and (c <= 0x2ff)) or
           ((c >= 0x370) and (c <= 0x37d)) or ((c >= 0x37f) and (c <= 0x1fff)) or ((c >= 0x200c) and (c <= 0x200d)) or
           ((c >= 0x2070) and (c <= 0x218f)) or ((c >= 0x2c00) and (c <= 0x2fef)) or
           ((c >= 0x3001) and (c <= 0xd7ff)) or ((c >= 0xf900) and (c <= 0xfdcf)) or
           ((c >= 0xfdf0) and (c <= 0xfffd)) or ((c >= 0x10000) and (c <= 0xeffff));
}

fn is_name_char(c: u32) bool {
    return is_name_start(c) or ((c >= '0') and (c <= '9')) or (c == '-') or (c == '.') or (c == 0xb7) or
           ((c >= 0x300) and (c <= 0x36f)) or ((c >= 0x203f) and (c <= 0x2040));
}

fn is_space(c: u8) bool {
    return (c == ' ') or (c == '\t') or (c == '\n') or (c == '\r');
}

/// Whether s is an XML Name.
pub fn is_name(s: []u8) bool {
    if s.len == 0 {
        return false;
    }
    let mut i: usize = 0;
    let mut first = true;
    while i < s.len {
        let r = strs.decode_rune(s[i..]);
        if first {
            if not is_name_start(r.value) {
                return false;
            }
        } else if not is_name_char(r.value) {
            return false;
        }
        first = false;
        i += r.len;
    }
    return true;
}

fn is_nmtoken(s: []u8) bool {
    if s.len == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < s.len {
        let r = strs.decode_rune(s[i..]);
        if not is_name_char(r.value) {
            return false;
        }
        i += r.len;
    }
    return true;
}

// -----------------------------------------------------------------------------
// Input: encodings and line ends
// -----------------------------------------------------------------------------

fn set_diag_from_text(text: []u8, at: usize, msg: []u8, info: *mut diag.ErrorInfo) void {
    let pos = @min(at, text.len);
    let mut line: u32 = 1;
    let mut col: u32 = 1;
    for i in @as(usize, 0)..pos {
        if text[i] == '\n' {
            line += 1;
            col = 1;
        } else {
            col += 1;
        }
    }
    info.* = diag.ErrorInfo.at(pos, line, col, msg);
}

fn map_input_offset(text: []u8, norm_pos: usize) usize {
    if (text.len >= 2) and (((text[0] == 0xfe) and (text[1] == 0xff)) or ((text[0] == 0xff) and (text[1] == 0xfe))) {
        return norm_pos;
    }
    let mut ti: usize = 0;
    if (text.len >= 3) and (text[0] == 0xef) and (text[1] == 0xbb) and (text[2] == 0xbf) {
        ti = 3;
    }
    if declares_latin1(text[ti..]) {
        return norm_pos;
    }
    let mut ni: usize = 0;
    while (ti < text.len) and (ni < norm_pos) {
        if text[ti] == '\r' {
            ti += 1;
            if (ti < text.len) and (text[ti] == '\n') {
                ti += 1;
            }
            ni += 1;
        } else {
            ti += 1;
            ni += 1;
        }
    }
    return ti;
}

// The document as UTF-8 with normalized line ends, in the arena.
fn decode_input_diag(text: []u8, a: *mut arena.Arena, info: *mut diag.ErrorInfo) infer![]u8 {
    let mut s = strs.String.init();
    defer s.deinit();
    if (text.len >= 2) and (((text[0] == 0xfe) and (text[1] == 0xff)) or ((text[0] == 0xff) and (text[1] == 0xfe))) {
        // UTF-16 with a byte-order mark
        let be = text[0] == 0xfe;
        let mut i: usize = 2;
        let mut line: u32 = 1;
        let mut col: u32 = 1;
        let mut b: [4]u8 = [0; 4];
        while (i + 1) < text.len {
            let start_i = i;
            let mut u = @as(u32, text[i + 1]) | (@as(u32, text[i]) << 8);
            if not be {
                u = @as(u32, text[i]) | (@as(u32, text[i + 1]) << 8);
            }
            i += 2;
            if (u >= 0xd800) and (u <= 0xdbff) {
                if (i + 1) >= text.len {
                    info.* = diag.ErrorInfo.at(start_i, line, col, "truncated UTF-16");
                    return error.SyntaxError;
                }
                let mut l = @as(u32, text[i + 1]) | (@as(u32, text[i]) << 8);
                if not be {
                    l = @as(u32, text[i]) | (@as(u32, text[i + 1]) << 8);
                }
                if (l < 0xdc00) or (l > 0xdfff) {
                    info.* = diag.ErrorInfo.at(i, line, col + 1, "invalid UTF-16");
                    return error.SyntaxError;
                }
                i += 2;
                u = 0x10000 + (((u - 0xd800) << 10) | (l - 0xdc00));
            } else if (u >= 0xdc00) and (u <= 0xdfff) {
                info.* = diag.ErrorInfo.at(start_i, line, col, "invalid UTF-16");
                return error.SyntaxError;
            }
            if u == '\n' {
                line += 1;
                col = 1;
            } else if u == '\r' {
                let mut next_lf = false;
                if (i + 1) < text.len {
                    let mut nu = @as(u32, text[i + 1]) | (@as(u32, text[i]) << 8);
                    if not be {
                        nu = @as(u32, text[i]) | (@as(u32, text[i + 1]) << 8);
                    }
                    next_lf = nu == '\n';
                }
                if not next_lf {
                    line += 1;
                    col = 1;
                }
            } else {
                col += 1;
            }
            s.push_str(strs.encode_rune(b[..], u)) catch |e| {
                info.* = diag.ErrorInfo.at(start_i, line, col, "out of memory");
                return e;
            };
        }
        if i < text.len {
            info.* = diag.ErrorInfo.at(i, line, col, "truncated UTF-16");
            return error.SyntaxError;
        }
    } else {
        let mut t = text;
        let mut bom: usize = 0;
        if (t.len >= 3) and (t[0] == 0xef) and (t[1] == 0xbb) and (t[2] == 0xbf) {
            t = t[3..];
            bom = 3;
        }
        if declares_latin1(t) {
            let mut b: [4]u8 = [0; 4];
            for c in t {
                s.push_str(strs.encode_rune(b[..], @as(u32, c))) catch |e| {
                    info.* = diag.ErrorInfo.at(0, 1, 1, "out of memory");
                    return e;
                };
            }
        } else {
            if not strs.valid_utf8(t) {
                let mut bad_at: usize = 0;
                while bad_at < t.len {
                    let q = strs.decode_rune(t[bad_at..]);
                    if (q.value == strs.REPLACEMENT) and not ((q.len == 3) and (t[bad_at] == 0xef)) {
                        break;
                    }
                    bad_at += q.len;
                }
                set_diag_from_text(text, bom + bad_at, "invalid UTF-8", info);
                return error.SyntaxError;
            }
            s.push_str(t) catch |e| {
                info.* = diag.ErrorInfo.at(0, 1, 1, "out of memory");
                return e;
            };
        }
    }
    // line ends: CR LF and lone CR become LF
    let src = s.bytes();
    let out = a.bytes(src.len) catch |e| {
        info.* = diag.ErrorInfo.at(0, 1, 1, "out of memory");
        return e;
    };
    let mut n: usize = 0;
    let mut i: usize = 0;
    while i < src.len {
        let c = src[i];
        if c == '\r' {
            out[n] = '\n';
            n += 1;
            i += 1;
            if (i < src.len) and (src[i] == '\n') {
                i += 1;
            }
            continue;
        }
        out[n] = c;
        n += 1;
        i += 1;
    }
    // every character must be allowed
    let r = out[..n];
    let mut k: usize = 0;
    while k < r.len {
        let q = strs.decode_rune(r[k..]);
        if not is_char(q.value) {
            set_diag_from_text(r, k, "a character that XML does not allow", info);
            info.offset = map_input_offset(text, k);
            return error.SyntaxError;
        }
        k += q.len;
    }
    return r;
}

fn declares_latin1(t: []u8) bool {
    if not strs.starts_with(t, "<?xml") {
        return false;
    }
    let end = strs.index_of(t, "?>") ?? return false;
    let decl = t[..end];
    let at = strs.index_of(decl, "encoding") ?? return false;
    let rest = decl[at + 8..];
    for enc in ["ISO-8859-1", "iso-8859-1", "latin1", "Latin1", "ISO_8859-1", "ISO-Latin-1"] {
        if strs.contains(rest, enc) {
            return true;
        }
    }
    return false;
}

// -----------------------------------------------------------------------------
// XML declaration and low-level character/entity helpers
// -----------------------------------------------------------------------------

fn reader_xml_decl(r: *mut Reader) XmlError!void {
    if not (r.looking_at("<?xml") and is_space(r.at(5))) {
        return;
    }
    r.advance(5);
    _ = r.skip_space();
    let mut seen_version = false;
    let mut seen_encoding = false;
    let mut seen_standalone = false;
    let mut order: u32 = 0;
    loop {
        if r.looking_at("?>") {
            r.advance(2);
            break;
        }
        let n = r.name()!;
        _ = r.skip_space();
        r.expect("=", "expected = in the XML declaration")!;
        _ = r.skip_space();
        let q = r.at(0);
        if (q != '"') and (q != '\'') {
            return r.fail("expected a quoted value in the XML declaration");
        }
        r.advance(1);
        let st = r.cur().pos;
        while not r.eof() and (r.at(0) != q) {
            r.advance(1);
        }
        if r.eof() {
            return r.fail("unterminated XML declaration");
        }
        let v = r.cur().text[st..r.cur().pos];
        r.advance(1);
        if strs.eq(n, "version") and (order == 0) {
            if not (strs.starts_with(v, "1.") and (v.len > 2) and all_digits(v[2..])) {
                return r.fail("bad version in the XML declaration");
            }
            seen_version = true;
            order = 1;
        } else if strs.eq(n, "encoding") and (order == 1) and not seen_encoding {
            if (v.len == 0) or not (((v[0] >= 'a') and (v[0] <= 'z')) or ((v[0] >= 'A') and (v[0] <= 'Z'))) {
                return r.fail("bad encoding name");
            }
            seen_encoding = true;
            order = 2;
        } else if strs.eq(n, "standalone") and (order >= 1) and not seen_standalone {
            if strs.eq(v, "yes") {
                r.standalone = true;
            } else if not strs.eq(v, "no") {
                return r.fail("standalone must be yes or no");
            }
            seen_standalone = true;
            order = 3;
        } else {
            return r.fail("bad XML declaration");
        }
        let sp = r.skip_space();
        if not sp and not r.looking_at("?>") {
            return r.fail("expected white space in the XML declaration");
        }
    }
    if not seen_version {
        return r.fail("the XML declaration needs a version");
    }
}

fn hexv(c: u8) u32 {
    if (c >= '0') and (c <= '9') {
        return @as(u32, c - '0');
    }
    if (c >= 'a') and (c <= 'f') {
        return @as(u32, c - 'a') + 10;
    }
    if (c >= 'A') and (c <= 'F') {
        return @as(u32, c - 'A') + 10;
    }
    return 99;
}

fn all_digits(s: []u8) bool {
    for c in s {
        if (c < '0') or (c > '9') {
            return false;
        }
    }
    return true;
}

fn predefined(n: []u8) []u8 {
    if strs.eq(n, "lt") {
        return "<";
    }
    if strs.eq(n, "gt") {
        return ">";
    }
    if strs.eq(n, "amp") {
        return "&";
    }
    if strs.eq(n, "apos") {
        return "'";
    }
    if strs.eq(n, "quot") {
        return "\"";
    }
    return "";
}
