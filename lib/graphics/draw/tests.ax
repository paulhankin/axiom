// =============================================================================
// lib/graphics/draw/tests.ax - Tests for coverage, strokes, compositing, and
// dashing, part of lib/graphics/draw.
// =============================================================================

import "../color.ax" as color;
import "../image.ax" as image;
import "std/math" as math;
import "std/mem" as mem;

// -----------------------------------------------------------------------------
// Tests
// -----------------------------------------------------------------------------

fn coverage_sum(img: *image.Image) f64 {
    let mut s: f64 = 0.0;
    for y in @as(usize, 0)..img.height {
        for x in @as(usize, 0)..img.width {
            s += @as(f64, img.get(x, y).a);
        }
    }
    return s;
}

test "exact coverage" {
    let mut img = image.Image.init(40, 30, 4, image.Depth.F32)!;
    defer img.deinit();
    let mut cv = Canvas.init(&mut img);
    defer cv.deinit();
    let white = Paint.solid(color.Color.rgb(1.0, 1.0, 1.0));
    // a rectangle with fractional edges: its area, and partial pixels
    cv.fill_rect(2.25, 3.5, 10.5, 4.0, white)!;
    @expect(@abs(coverage_sum(&img) - 42.0) < 1.0e-3);
    @expect(@abs(img.get(2, 5).a - 0.75) < 1.0e-5);
    @expect(@abs(img.get(12, 3).a - 0.375) < 1.0e-5);
    @expect_eq(img.get(5, 5).a, 1.0);
    // a circle: area pi r^2
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    let mut p: Path = Path.init();
    defer p.deinit();
    p.circle(20.0, 15.0, 10.0)!;
    cv.fill(&p, white, FillRule.NONZERO)!;
    @expect(@abs(coverage_sum(&img) - (math.PI * 100.0)) < 2.2);  // chords: 2/3 tolerance x circumference
    // even-odd: a ring
    p.circle(20.0, 15.0, 5.0)!;
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    cv.fill(&p, white, FillRule.EVEN_ODD)!;
    @expect(@abs(coverage_sum(&img) - (math.PI * 75.0)) < 3.3);
    @expect_eq(img.get(20, 15).a, 0.0);
    // nonzero with the inner circle the same way round: a disc
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    cv.fill(&p, white, FillRule.NONZERO)!;
    @expect(@abs(coverage_sum(&img) - (math.PI * 100.0)) < 2.2);
}

test "strokes" {
    let mut img = image.Image.init(60, 40, 4, image.Depth.F32)!;
    defer img.deinit();
    let mut cv = Canvas.init(&mut img);
    defer cv.deinit();
    let white = Paint.solid(color.Color.rgb(1.0, 1.0, 1.0));
    // a horizontal line 4 wide and 30 long, butt caps: area 120
    cv.line(10.0, 20.0, 40.0, 20.0, white, Stroke.width(4.0))!;
    @expect(@abs(coverage_sum(&img) - 120.0) < 1.0e-3);
    // square caps add 2 at each end
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    let mut st = Stroke.width(4.0);
    st.cap = Cap.SQUARE;
    cv.line(10.0, 20.0, 40.0, 20.0, white, st)!;
    @expect(@abs(coverage_sum(&img) - 136.0) < 1.0e-3);
    // a closed square outline, miter joins: 20x20 outer ring of width 2
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    let mut p: Path = Path.init();
    defer p.deinit();
    p.rect(10.0, 10.0, 18.0, 18.0)!;
    cv.stroke(&p, white, Stroke.width(2.0))!;
    @expect(@abs(coverage_sum(&img) - ((20.0 * 20.0) - (16.0 * 16.0))) < 1.0e-3);
    @expect_eq(img.get(9, 9).a, 1.0);  // the mitred corner
    // dashes: 30 long, 5 on 5 off: 15 of line, width 2
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    let dashes: [2]f64 = [5.0, 5.0];
    let mut ds = Stroke.width(2.0);
    ds.dash = dashes[..];
    cv.line(10.0, 5.0, 40.0, 5.0, white, ds)!;
    @expect(@abs(coverage_sum(&img) - 30.0) < 1.0e-3);
    @expect_eq(img.get(16, 5).a, 0.0);
}

test "paint and compositing" {
    let mut img = image.Image.init(20, 10, 3, image.Depth.U8)!;
    defer img.deinit();
    let mut cv = Canvas.init(&mut img);
    defer cv.deinit();
    cv.clear(color.Color.rgb(0.0, 0.0, 1.0));
    // half-transparent red over blue: linear-light mix
    cv.fill_rect(0.0, 0.0, 10.0, 10.0, Paint.solid(color.Color.rgba(1.0, 0.0, 0.0, 0.5)))!;
    let c = img.get(5, 5);
    @expect(@abs(c.r - 0.5) < 0.01);
    @expect(@abs(c.b - 0.5) < 0.01);
    // a gradient from black to white across 20 pixels, in linear light
    let stops: [2]Stop = [
        Stop.{ offset: 0.0, color: color.Color.rgb(0.0, 0.0, 0.0) },
        Stop.{ offset: 1.0, color: color.Color.rgb(1.0, 1.0, 1.0) },
    ];
    cv.fill_rect(0.0, 0.0, 20.0, 10.0, Paint.linear(0.0, 0.0, 20.0, 0.0, stops[..]))!;
    @expect(@abs(img.get(9, 0).r - 0.475) < 0.01);
    // multiply by grey 0.5 halves it
    cv.op = Op.MULTIPLY;
    cv.fill_rect(0.0, 0.0, 20.0, 10.0, Paint.solid(color.Color.rgb(0.5, 0.5, 0.5)))!;
    @expect(@abs(img.get(19, 0).r - 0.4875) < 0.01);
    // a clip limits drawing
    cv.op = Op.OVER;
    let mut p: Path = Path.init();
    defer p.deinit();
    p.rect(0.0, 0.0, 5.0, 10.0)!;
    cv.save()!;
    cv.clip_to(&p, FillRule.NONZERO)!;
    cv.fill_rect(0.0, 0.0, 20.0, 10.0, Paint.solid(color.Color.rgb(0.0, 1.0, 0.0)))!;
    cv.restore();
    @expect_eq(img.get(2, 2).to_rgba8().to_u32(), 0x00ff00ff);
    @expect(img.get(12, 2).g < 0.9);
    // transforms: a unit square scaled by 4 and moved
    cv.clear(color.Color.rgb(0.0, 0.0, 0.0));
    cv.translate(10.0, 2.0);
    cv.scale(4.0, 4.0);
    cv.fill_rect(0.0, 0.0, 1.0, 1.0, Paint.solid(color.Color.rgb(1.0, 1.0, 1.0)))!;
    @expect_eq(img.get(11, 3).to_rgba8().to_u32(), 0xffffffff);
    @expect_eq(img.get(14, 6).to_rgba8().to_u32(), 0x000000ff);
}

test "many crossings in a row" {
    // a zigzag whose edges all cross each other within one row, and tiny
    // squares at the top of a row and then at its bottom: the crossings'
    // order changes wholesale from line to line, which must not take
    // quadratic time
    let mut img = image.Image.init(1000, 1, 4, image.Depth.F32)!;
    defer img.deinit();
    let mut cv = Canvas.init(&mut img);
    defer cv.deinit();
    let white = Paint.solid(color.Color.rgb(1.0, 1.0, 1.0));
    let n: usize = 32000;
    let nf = @float_from_int(f64, n);
    let mut p: Path = Path.init();
    defer p.deinit();
    for i in @as(usize, 0)..n {
        let x = (@float_from_int(f64, i) * 1000.0) / nf;
        if i == 0 {
            p.move_to(0.0, 0.0)!;
        } else {
            p.line_to(x, 0.0)!;
        }
        p.line_to(1000.0 - x, 1.0)!;
    }
    p.close()!;
    cv.fill(&p, white, FillRule.NONZERO)!;
    @expect(@abs(coverage_sum(&img) - 418.0) < 1.0);
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    p.clear();
    for k in @as(usize, 0)..2 {
        let y = 0.1 + (0.5 * @float_from_int(f64, k));
        for i in @as(usize, 0)..n / 2 {
            p.rect((@float_from_int(f64, i) * 2000.0) / nf, y, 1000.0 / nf, 0.1)!;
        }
    }
    cv.fill(&p, white, FillRule.NONZERO)!;
    @expect(@abs(coverage_sum(&img) - 62.5) < 0.5);  // 2 bands, each on 1 of the 16 sample lines, half covered
}

test "dashes and round pieces off the canvas" {
    let mut img = image.Image.init(64, 64, 4, image.Depth.F32)!;
    defer img.deinit();
    let mut cv = Canvas.init(&mut img);
    defer cv.deinit();
    let white = Paint.solid(color.Color.rgb(1.0, 1.0, 1.0));
    let mut p: Path = Path.init();
    defer p.deinit();
    // lines a million long, finely dashed: dashed where the canvas shows
    // them, without making the dashes beyond it
    for i in @as(usize, 0)..40 {
        let y = @float_from_int(f64, i) + 0.5;
        p.move_to(-1.0e6, y)!;
        p.line_to(1.0e6, y)!;
    }
    let dashes: [2]f64 = [1.0, 1.0];
    let mut st = Stroke.width(1.0);
    st.dash = dashes[..];
    cv.stroke(&p, white, st)!;
    @expect(@abs(coverage_sum(&img) - (40.0 * 32.0)) < 1.0e-3);
    @expect_eq(img.get(0, 3).a, 1.0);
    @expect_eq(img.get(1, 3).a, 0.0);
    // one far too fine for its length is drawn solid
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    let fine: [2]f64 = [1.0e-4, 1.0e-4];
    st.dash = fine[..];
    cv.stroke(&p, white, st)!;
    @expect(@abs(coverage_sum(&img) - (40.0 * 64.0)) < 1.0e-3);
    // curves a million wide with round joins (each flattened into many
    // segments): the stroke covers the canvas
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    p.clear();
    p.move_to(0.0, 0.0)!;
    for i in @as(usize, 0)..64 {
        p.cubic_to(0.0, 1.0e6, 1.0e6, -1.0e6, 1.0e6, 0.0)!;
    }
    let mut wide = Stroke.width(1.0e6);
    wide.join = Join.ROUND;
    wide.cap = Cap.ROUND;
    cv.stroke(&p, white, wide)!;
    @expect_eq(coverage_sum(&img), 64.0 * 64.0);
    // a dash turning at a corner off the canvas: its miter still shows
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    p.clear();
    p.move_to(20.0, -200.0)!;
    p.line_to(30.0, -20.0)!;
    p.line_to(42.0, -200.0)!;
    let long: [2]f64 = [30.0, 5.0];
    let mut miter = Stroke.width(10.0);
    miter.miter_limit = 40.0;
    miter.dash = long[..];
    cv.stroke(&p, white, miter)!;
    @expect(coverage_sum(&img) > 200.0);
    // round caps a hundred wide on dashes along the canvas's edge
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    p.clear();
    p.move_to(-1.0e4, 0.0)!;
    p.line_to(1.0e4, 0.0)!;
    let mut caps = Stroke.width(100.0);
    caps.cap = Cap.ROUND;
    caps.dash = dashes[..];
    cv.stroke(&p, white, caps)!;
    @expect(coverage_sum(&img) > (64.0 * 49.0));
}

test "dashes across a large canvas" {
    // a full-width line dashed a pixel on and off along every fourth row:
    // dashed throughout, however many dashes that is
    let mut img = image.Image.init(2048, 256, 4, image.Depth.F32)!;
    defer img.deinit();
    let mut cv = Canvas.init(&mut img);
    defer cv.deinit();
    let white = Paint.solid(color.Color.rgb(1.0, 1.0, 1.0));
    let mut p: Path = Path.init();
    defer p.deinit();
    for i in @as(usize, 0)..64 {
        let y = (@float_from_int(f64, i) * 4.0) + 0.5;
        p.move_to(0.0, y)!;
        p.line_to(2048.0, y)!;
    }
    let dashes: [2]f64 = [1.0, 1.0];
    let mut st = Stroke.width(1.0);
    st.dash = dashes[..];
    cv.stroke(&p, white, st)!;
    @expect(@abs(coverage_sum(&img) - (64.0 * 1024.0)) < 1.0e-3);
    for i in @as(usize, 0)..64 {
        @expect_eq(img.get(2046, i * 4).a, 1.0);
        @expect_eq(img.get(2047, i * 4).a, 0.0);
    }
}

test "long dash patterns along hidden segments" {
    // many segments off the canvas, each a little shorter than a pattern
    // of many entries, then down across it: the pattern is moved on over
    // each without walking its entries
    let mut img = image.Image.init(64, 64, 4, image.Depth.F32)!;
    defer img.deinit();
    let mut cv = Canvas.init(&mut img);
    defer cv.deinit();
    let white = Paint.solid(color.Color.rgb(1.0, 1.0, 1.0));
    let m: usize = 20000;
    let dash = mem.alloc.[f64](m)!;
    defer mem.free(dash);
    for i in @as(usize, 0)..m {
        dash[i] = 1.0;
    }
    let len = @float_from_int(f64, m) - 0.5;
    let mut p: Path = Path.init();
    defer p.deinit();
    p.move_to(10.5, -1.0e5)!;
    for i in @as(usize, 0)..20000 {
        p.line_to(10.5, -1.0e5 + (len * @float_from_int(f64, (i + 1) % 2)))!;
    }
    p.line_to(10.5, 64.0)!;
    // (400,090,000 along at the top: a dash starts there)
    let mut st = Stroke.width(1.0);
    st.dash = dash;
    cv.stroke(&p, white, st)!;
    @expect(@abs(coverage_sum(&img) - 32.0) < 1.0e-3);
    @expect_eq(img.get(10, 0).a, 1.0);
    @expect_eq(img.get(10, 1).a, 0.0);
    // and an offset far into the pattern, on each of many short subpaths
    // off the canvas and one across it
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    p.clear();
    for i in @as(usize, 0)..20000 {
        p.move_to(-100.0, 0.5)!;
        p.line_to(-99.9, 0.5)!;
    }
    p.move_to(0.0, 5.5)!;
    p.line_to(64.0, 5.5)!;
    st.dash_offset = 12345.0;  // (a gap)
    cv.stroke(&p, white, st)!;
    @expect(@abs(coverage_sum(&img) - 32.0) < 1.0e-3);
    @expect_eq(img.get(0, 5).a, 0.0);
    @expect_eq(img.get(1, 5).a, 1.0);
}

test "round joins" {
    let mut img = image.Image.init(60, 50, 4, image.Depth.F32)!;
    defer img.deinit();
    let mut cv = Canvas.init(&mut img);
    defer cv.deinit();
    let white = Paint.solid(color.Color.rgb(1.0, 1.0, 1.0));
    let mut p: Path = Path.init();
    defer p.deinit();
    // a right angle 8 wide: two rectangles and a quarter disc outside the corner
    p.move_to(10.0, 30.0)!;
    p.line_to(40.0, 30.0)!;
    p.line_to(40.0, 10.0)!;
    let mut st = Stroke.width(8.0);
    st.join = Join.ROUND;
    cv.stroke(&p, white, st)!;
    @expect(@abs(coverage_sum(&img) - (384.0 + (math.PI * 4.0))) < 0.3);  // (chords: within the tolerance)
    @expect_eq(img.get(9, 30).a, 0.0);  // the butt end
    // a curve 20 wide with a short first segment: its first join's disc
    // reaches past the butt end, as it always has
    cv.clear(color.Color.rgba(0.0, 0.0, 0.0, 0.0));
    p.clear();
    p.move_to(20.0, 25.0)!;
    p.line_to(21.0, 25.0)!;
    p.line_to(40.0, 40.0)!;
    st.width = 20.0;
    cv.stroke(&p, white, st)!;
    @expect(img.get(12, 25).a > 0.9);
}
