{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Axiom",
  "scopeName": "source.axiom",
  "fileTypes": ["ax"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#builtins" },
    { "include": "#errors" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.axiom",
          "begin": "///",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.axiom" } },
          "end": "$",
          "patterns": [
            { "name": "markup.inline.raw.axiom", "match": "`[^`]*`" }
          ]
        },
        {
          "name": "comment.line.double-slash.axiom",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.axiom" } },
          "end": "$",
          "patterns": [
            { "name": "keyword.other.todo.axiom", "match": "\\b(TODO|FIXME|XXX|NOTE)\\b" }
          ]
        }
      ]
    },
    "escapes": {
      "patterns": [
        { "name": "constant.character.escape.axiom", "match": "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|[nrt0\\\\\"'])" },
        { "name": "invalid.illegal.escape.axiom", "match": "\\\\." }
      ]
    },
    "strings": {
      "name": "string.quoted.double.axiom",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.axiom" } },
      "end": "\"|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.axiom" } },
      "patterns": [
        { "include": "#escapes" },
        { "name": "constant.other.placeholder.axiom", "match": "\\{[^{}\"]*\\}" }
      ]
    },
    "chars": {
      "name": "string.quoted.single.axiom",
      "match": "'(\\\\(?:x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|[nrt0\\\\\"'])|[^\\\\'])'",
      "captures": {
        "1": { "patterns": [ { "include": "#escapes" } ] }
      }
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.axiom", "match": "\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?\\b" },
        { "name": "constant.numeric.float.axiom", "match": "\\b[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*\\b" },
        { "name": "constant.numeric.hex.axiom", "match": "\\b0x[0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.binary.axiom", "match": "\\b0b[01_]+\\b" },
        { "name": "constant.numeric.octal.axiom", "match": "\\b0o[0-7_]+\\b" },
        { "name": "constant.numeric.decimal.axiom", "match": "\\b[0-9](?:_?[0-9])*\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.axiom" },
            "2": { "name": "entity.name.function.axiom" }
          }
        },
        {
          "match": "\\b(struct|union|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.$1.axiom" },
            "2": { "name": "entity.name.type.axiom" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.const.axiom" },
            "2": { "name": "variable.other.constant.axiom" }
          }
        },
        {
          "match": "\\b(let)\\s+(?:(mut)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.let.axiom" },
            "2": { "name": "storage.modifier.mut.axiom" },
            "3": { "name": "variable.other.declaration.axiom" }
          }
        },
        {
          "match": "\\b(threadlocal)\\s+(?=let\\b)",
          "captures": { "1": { "name": "storage.modifier.threadlocal.axiom" } }
        },
        {
          "match": "\\b(test)\\s+(?=\")",
          "captures": { "1": { "name": "keyword.other.test.axiom" } }
        },
        {
          "match": "\\b(expect)\\s+(trap)\\b",
          "captures": {
            "1": { "name": "keyword.other.test.axiom" },
            "2": { "name": "keyword.other.test.axiom" }
          }
        },
        {
          "match": "\\b(import)\\s+(host)\\b",
          "captures": {
            "1": { "name": "keyword.control.import.axiom" },
            "2": { "name": "storage.modifier.host.axiom" }
          }
        },
        {
          "match": "\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=;)",
          "captures": {
            "1": { "name": "keyword.control.import.axiom" },
            "2": { "name": "entity.name.namespace.axiom" }
          }
        }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.axiom",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    "errors": {
      "patterns": [
        {
          "match": "\\b(error)\\s*(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.error.axiom" },
            "2": { "name": "punctuation.accessor.axiom" },
            "3": { "name": "constant.other.error.axiom" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.conditional.axiom", "match": "\\b(if|else|match)\\b" },
        { "name": "keyword.control.loop.axiom", "match": "\\b(while|loop|for|in|break|continue)\\b" },
        { "name": "keyword.control.flow.axiom", "match": "\\b(return|defer|errdefer|catch)\\b" },
        { "name": "keyword.control.import.axiom", "match": "\\b(import|as)\\b" },
        { "name": "keyword.operator.logical.axiom", "match": "\\b(and|or|not)\\b" },
        { "name": "storage.type.axiom", "match": "\\b(fn|struct|union|enum|error|const|let)\\b" },
        { "name": "storage.modifier.axiom", "match": "\\b(pub|export|extern|mut|host)\\b" },
        { "name": "keyword.other.test.axiom", "match": "\\btest\\b" },
        { "name": "constant.language.boolean.axiom", "match": "\\b(true|false)\\b" },
        { "name": "variable.language.self.axiom", "match": "\\b(Self|self)\\b" },
        { "name": "variable.language.discard.axiom", "match": "\\b_\\b" },
        { "name": "invalid.illegal.reserved.axiom", "match": "\\b(async|await|comptime|impl|interface|null|trait|type|unsafe|yield)\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.axiom",
          "match": "\\b(u8|u16|u32|u64|usize|i8|i16|i32|i64|isize|f32|f64|bool|void|i8x16|u8x16|i16x8|u16x8|i32x4|u32x4|i64x2|u64x2|f32x4|f64x2|v128)\\b"
        },
        {
          "name": "support.type.constraint.axiom",
          "match": "\\b(Eq|Ord|Num|Int|SignedInt|UnsignedInt|Float)\\b"
        },
        {
          "name": "variable.other.constant.axiom",
          "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?!\\s*\\()"
        },
        {
          "name": "entity.name.type.axiom",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\(|\\.\\[)",
          "captures": { "1": { "name": "entity.name.function.call.axiom" } }
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.axiom", "match": "=>" },
        { "name": "keyword.operator.range.axiom", "match": "\\.\\.\\.?" },
        { "name": "keyword.operator.deref.axiom", "match": "\\.\\*" },
        { "name": "keyword.operator.comparison.axiom", "match": "==|!=|<=|>=|<(?!<)|(?<!>)>(?!>)" },
        { "name": "keyword.operator.assignment.compound.axiom", "match": "(\\+%|-%|\\*%|<<|>>|[+\\-*/%&|^])=" },
        { "name": "keyword.operator.assignment.axiom", "match": "=" },
        { "name": "keyword.operator.arithmetic.wrapping.axiom", "match": "\\+%|-%|\\*%" },
        { "name": "keyword.operator.bitwise.axiom", "match": "<<|>>|[&|^~]" },
        { "name": "keyword.operator.arithmetic.axiom", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.error.axiom", "match": "!" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.axiom", "match": "," },
        { "name": "punctuation.terminator.statement.axiom", "match": ";" },
        { "name": "punctuation.separator.colon.axiom", "match": ":" },
        { "name": "punctuation.accessor.axiom", "match": "\\." }
      ]
    }
  }
}
