{
  "name": "axiom",
  "displayName": "Axiom",
  "description": "Axiom language support: syntax highlighting, and diagnostics, hover, go to definition, references, completion, outline and formatting from the Axiom language server (axiom lsp).",
  "version": "0.1.0",
  "publisher": "paulhankin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulhankin/axiom.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/*.ax"
  ],
  "contributes": {
    "languages": [
      {
        "id": "axiom",
        "aliases": ["Axiom", "axiom"],
        "extensions": [".ax"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "axiom",
        "scopeName": "source.axiom",
        "path": "./syntaxes/axiom.tmLanguage.json"
      },
      {
        "scopeName": "markdown.axiom.codeblock",
        "path": "./syntaxes/axiom.markdown.tmLanguage.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.axiom": "axiom"
        }
      }
    ],
    "configuration": {
      "title": "Axiom",
      "properties": {
        "axiom.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `axiom` compiler. When empty, the extension uses `selfhost/build/axiom` in a workspace folder if there is one, and otherwise `axiom` on the `PATH`."
        },
        "axiom.serverArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["--target=native"],
          "markdownDescription": "Extra options for `axiom lsp`, passed on to every check (for example `--target=wasm32` or `--std=<dir>`)."
        },
        "axiom.enableLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Run the Axiom language server. Without it you still get syntax highlighting."
        },
        "axiom.trace.server": {
          "type": "boolean",
          "default": false,
          "description": "Log every message to and from the language server in the Axiom output channel."
        }
      }
    },
    "commands": [
      {
        "command": "axiom.restartServer",
        "title": "Axiom: Restart Language Server"
      },
      {
        "command": "axiom.showOutput",
        "title": "Axiom: Show Language Server Output"
      }
    ]
  }
}
